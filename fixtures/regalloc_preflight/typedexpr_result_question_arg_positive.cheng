type IntResult = Ok(value: int32) | Err(code: int32)

fn need(flag: bool): IntResult =
    if flag:
        return Ok(40)
    return Err(7)

fn addTwo(value: int32): int32 =
    return value + 2

fn use(flag: bool): IntResult =
    let value = addTwo(need(flag)?)
    return Ok(value)

fn main(): int32 =
    let result = use(true)
    match result:
        Ok(value) =>
            return value == 42 ? 0 : 1
        Err(code) =>
            return code
