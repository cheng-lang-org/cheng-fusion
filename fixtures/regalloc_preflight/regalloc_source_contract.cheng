import std/strings as strings
import std/strutils as strutil
import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_cfg as cfg
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_aarch64_adapter as adapter
import cheng/core/backend/aarch64_encode as a64
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend2/backend2_emit_ops as b2ops
import cheng/core/backend2/backend2_emit as b2emit
import cheng/core/backend2/backend2_frame as b2frame

fn makeSlot(id: int32,
            typeKind: int32,
            stackOffset: int32,
            sizeBytes: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "fusion_regalloc_contract"
    slot.typeKind = typeKind
    slot.stackOffset = stackOffset
    slot.sizeBytes = sizeBytes
    slot.alignBytes = sizeBytes >= 8 ? 8 : 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makeGlobalSlot(id: int32,
                  name: str,
                  typeKind: int32,
                  sizeBytes: int32): ir.LocalSlot =
    var slot = makeSlot(id, typeKind, 16 + id * 32, sizeBytes)
    slot.name = name
    slot.placeKind = ir.BodyPlaceGlobalAddressTag
    return slot

fn appendVoidReturn(body: var ir.BodyIR): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    return ir.BodyIRAppendTerm(body, term)

fn appendI32Return(body: var ir.BodyIR, slotIndex: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, ir.LocalI32Tag)
    return ir.BodyIRAppendTerm(body, term)

fn buildCompositeBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeSlot(0, ir.LocalAggregateTag, -1, 64))
    add(body.localSlots, makeSlot(1, ir.LocalI32Tag, 16, 4))
    add(body.localSlots, makeSlot(2, ir.LocalStrTag, 24, 24))
    var isOk: ir.BodyOp
    isOk.kind = ir.BodyOpResultProjectTag
    isOk.target = 1
    add(isOk.operands, ir.BodyResultProjectIsOkTag)
    add(isOk.operands, 0)
    add(body.ops, isOk)
    var message: ir.BodyOp
    message.kind = ir.BodyOpResultProjectTag
    message.target = 2
    add(message.operands, ir.BodyResultProjectErrorStrTag)
    add(message.operands, 0)
    add(message.operands, ir.ResultStrErrMsgOffset)
    add(message.operands, 24)
    add(body.ops, message)
    var panicCall: ir.CallOp
    panicCall.targetSymbol = "Panic"
    panicCall.resultSlot = -1
    panicCall.resultPassKind = ir.BodyCallPassStackValueTag
    panicCall.relocWordOffset = -1
    add(panicCall.argSlots, 2)
    add(panicCall.argPassKinds, ir.BodyCallPassStackValueTag)
    add(body.callSequence, panicCall)
    var guard: ir.BodyOp
    guard.kind = ir.BodyOpResultPanicGuardTag
    guard.target = -1
    add(guard.operands, 1)
    add(guard.operands, 0)
    add(body.ops, guard)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 3, termIndex)
    return body

fn actionFragmentEffect(prepared: var adapter.RegallocAarch64FunctionRecipes,
                        actionIndex: int32): int32 =
    var found: int32 = -1
    for fragmentIndex in 0..<prepared.machineFragments.len:
        let fragment = prepared.machineFragments[fragmentIndex]
        if fragment.ownerKind != adapter.RegallocAarch64FragmentOwnerAction ||
           fragment.actionConsumerOrdinal != actionIndex:
            continue
        if found >= 0:
            return -2
        found = fragment.effectMask
    return found

fn checkCompositeAddressChannel(): int32 =
    var body = buildCompositeBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid || table.opFactCounts.len != 3 ||
       table.opFactCounts[2] != 5 || table.callFactCounts.len != 1:
        return 10
    let start = table.opFactStarts[2]
    let address = table.facts[start + 1]
    let argument = table.facts[start + 2]
    if address.kind != access.BodyIrAccessFactAddress ||
       address.slotIndex != 2 ||
       address.passKind != ir.BodyCallPassStackValueTag ||
       !address.addressEscapes || address.addressOwnerSlot != 2 ||
       address.addressByteLength != 24 || address.abiSizeBytes != 8 ||
       address.abiSizeExplicit ||
       !access.BodyIrAccessAddressFactIsValid(body, address) ||
       argument.kind != access.BodyIrAccessFactUse ||
       !argument.addressEscapes || argument.abiSizeBytes != 8:
        return 11
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = alloc.RegallocTargetConstraintsAarch64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    if !analysis.valid || !plan.valid || !plan.frozen ||
       !alloc.RegallocSinglePassValuePlanValidate(plan):
        return 12
    var projectAction: int32 = -1
    var addressAction: int32 = -1
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.opIndex == 1 &&
           action.kind == alloc.RegallocValueActionStoreHome:
            projectAction = actionIndex
        if action.opIndex == 2 &&
           action.kind == alloc.RegallocValueActionAddressFixed:
            addressAction = actionIndex
    if projectAction < 0 || addressAction < 0 ||
       plan.actions[addressAction].passKind !=
           ir.BodyCallPassStackValueTag ||
       plan.actions[addressAction].abiSizeBytes != 8:
        return 13
    var prepared = adapter.RegallocAarch64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid ||
       prepared.recipes[projectAction].words.len != 7 ||
       actionFragmentEffect(prepared, projectAction) !=
           prepared.recipes[projectAction].effectMask:
        return 14
    var wrongWidth = buildCompositeBody()
    add(wrongWidth.callSequence[0].argAbiSizes, 24)
    if access.BodyIrAccessDecode(wrongWidth).valid:
        return 15
    var wrongPass = buildCompositeBody()
    wrongPass.callSequence[0].argPassKinds[0] = 99
    if access.BodyIrAccessDecode(wrongPass).valid:
        return 16
    return 0

fn appendFieldStore(body: var ir.BodyIR,
                    baseSlot: int32,
                    valueSlot: int32,
                    byteOffset: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpFieldStoreTag
    op.target = baseSlot
    add(op.operands, baseSlot)
    add(op.operands, valueSlot)
    add(op.operands, byteOffset)
    add(op.operands, 4)
    add(body.ops, op)

fn appendFieldLoad(body: var ir.BodyIR,
                   baseSlot: int32,
                   targetSlot: int32,
                   byteOffset: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpFieldLoadTag
    op.target = targetSlot
    add(op.operands, baseSlot)
    add(op.operands, targetSlot)
    add(op.operands, byteOffset)
    add(op.operands, 4)
    add(body.ops, op)

fn appendIndexedStore(body: var ir.BodyIR,
                      baseSlot: int32,
                      valueSlot: int32,
                      indexSlot: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpIndexedStoreTag
    op.target = baseSlot
    add(op.operands, baseSlot)
    add(op.operands, valueSlot)
    add(op.operands, indexSlot)
    add(op.operands, 4)
    add(body.ops, op)

fn appendIndexedLoad(body: var ir.BodyIR,
                     baseSlot: int32,
                     targetSlot: int32,
                     indexSlot: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpIndexedLoadTag
    op.target = targetSlot
    add(op.operands, baseSlot)
    add(op.operands, targetSlot)
    add(op.operands, indexSlot)
    add(op.operands, 4)
    add(body.ops, op)

fn buildGlobalBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots,
        makeGlobalSlot(0, "fusion/contract::aggregate",
                       ir.LocalAggregateTag, 24))
    add(body.localSlots, makeSlot(1, ir.LocalI32Tag, -1, 4))
    add(body.localSlots, makeSlot(2, ir.LocalI32Tag, -2, 4))
    for slotIndex in 3..<8:
        add(body.localSlots,
            makeSlot(slotIndex, ir.LocalI32Tag,
                     16 + slotIndex * 8, 4))
    appendFieldStore(body, 0, 1, 0)
    appendIndexedStore(body, 0, 1, 2)
    appendFieldLoad(body, 0, 3, 4)
    appendIndexedLoad(body, 0, 4, 2)
    appendFieldLoad(body, 0, 5, 8)
    let termIndex = appendI32Return(body, 4)
    let _ = ir.BodyIRAppendBlock(body, 0, 4, termIndex)
    return body

fn isAdrp(word: int32): bool =
    return word == a64.A64EncAdrp(word & 31)

fn checkGlobalRelocTwins(): int32 =
    var primaryBody = buildGlobalBody()
    pobj.PrimaryBodyIrPrepareFrameMetricsInPlace(primaryBody)
    let primaryCount = pobj.PrimaryBodyIrWordCount(primaryBody)
    var primaryWords: int32[]
    for _ in 0..<primaryCount:
        add(primaryWords, 0)
    if primaryCount <= 0 || pobj.PrimaryBodyIRFillWords(
           primaryWords, 0, primaryCount, primaryBody) != primaryCount:
        return 20
    var sourceIds: int32[]
    var offsets: int32[]
    var keys: int32[]
    var opIndexes: int32[]
    var subIndexes: int32[]
    var targets: str[]
    var symbols: str[]
    pobj.PrimaryBodyIrAppendGlobalOpRelocs(
        primaryBody, 7001, 0, "arm64-apple-darwin", symbols, true,
        sourceIds, offsets, keys, opIndexes, subIndexes, targets)
    if offsets.len != 4:
        return 21
    for rowIndex in 0..<offsets.len:
        let offset = offsets[rowIndex]
        if sourceIds[rowIndex] != 7001 || offset != keys[rowIndex] ||
           opIndexes[rowIndex] != rowIndex || subIndexes[rowIndex] != 0 ||
           offset < 0 || offset + 1 >= primaryWords.len ||
           !isAdrp(primaryWords[offset]) || primaryWords[offset + 1] == 0:
            return 22
    var backendBody = buildGlobalBody()
    b2frame.PrimaryBodyIrPrepareFrameMetricsInPlace(backendBody)
    let fragment = b2emit.Backend2EmitFunction(
        backendBody, "fusion_global_contract", "arm64-apple-darwin")
    if fragment.wordCount != fragment.words.len ||
       fragment.dataRelocFnRelWordOffsets.len != 4 ||
       fragment.dataRelocTargetLabels.len != 4:
        return 23
    let target = b2ops.PrimaryGlobalDataLabelRaw(
        "fusion/contract::aggregate")
    for rowIndex in 0..<fragment.dataRelocFnRelWordOffsets.len:
        let offset = fragment.dataRelocFnRelWordOffsets[rowIndex]
        if offset < 0 || offset + 1 >= fragment.words.len ||
           !isAdrp(fragment.words[offset]) ||
           fragment.words[offset + 1] == 0 ||
           fragment.dataRelocTargetLabels[rowIndex] != target:
            return 24
    return 0

fn buildLargeGlobalBody(byteCount: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots,
        makeGlobalSlot(0, "fusion/contract::large",
                       ir.LocalAggregateTag, 4008))
    add(body.localSlots,
        makeSlot(1, ir.LocalAggregateTag, 16, 4008))
    var load: ir.BodyOp
    load.kind = ir.BodyOpFieldLoadTag
    load.target = 1
    add(load.operands, 0)
    add(load.operands, 1)
    add(load.operands, 0)
    add(load.operands, byteCount)
    add(body.ops, load)
    var store: ir.BodyOp
    store.kind = ir.BodyOpFieldStoreTag
    store.target = 0
    add(store.operands, 0)
    add(store.operands, 1)
    add(store.operands, 0)
    add(store.operands, byteCount)
    add(body.ops, store)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    return body

fn checkLargeRelocBoundary(): int32 =
    var primary = buildLargeGlobalBody(4008)
    pobj.PrimaryBodyIrPrepareFrameMetricsInPlace(primary)
    if pobj.PrimaryBodyIROpSizeAt(primary, 0) <= 2 ||
       pobj.PrimaryBodyIROpSizeAt(primary, 1) <= 2:
        return 30
    let wordCount = pobj.PrimaryBodyIrWordCount(primary)
    var words: int32[]
    for _ in 0..<wordCount:
        add(words, 0)
    if pobj.PrimaryBodyIRFillWords(words, 0, wordCount, primary) !=
       wordCount:
        return 31
    var backend = buildLargeGlobalBody(4008)
    b2frame.PrimaryBodyIrPrepareFrameMetricsInPlace(backend)
    let fragment = b2emit.Backend2EmitFunction(
        backend, "fusion_large_contract", "arm64-apple-darwin")
    if fragment.wordCount != fragment.words.len ||
       fragment.dataRelocFnRelWordOffsets.len != 2:
        return 32
    var invalidPrimary = buildLargeGlobalBody(4016)
    pobj.PrimaryBodyIrPrepareFrameMetricsInPlace(invalidPrimary)
    if pobj.PrimaryBodyIROpSizeAt(invalidPrimary, 0) != 0 ||
       pobj.PrimaryBodyIROpSizeAt(invalidPrimary, 1) != 0:
        return 33
    var invalidBackend = buildLargeGlobalBody(4016)
    b2frame.PrimaryBodyIrPrepareFrameMetricsInPlace(invalidBackend)
    if b2ops.PrimaryBodyIROpSizeAt(invalidBackend, 0) != 0 ||
       b2ops.PrimaryBodyIROpSizeAt(invalidBackend, 1) != 0:
        return 34
    return 0

# Module B calls module C, binds C's return value, then passes that binding to
# a second qualified C call.  This locks TypedExpr facts rebuild to the shared,
# sealed cross-module buildIndex; a local call-declaration index cannot type it.
fn checkTypedExprSharedBuildIndex(): int32 =
    let rendered = strings.IntToStr(12345)
    if strings.Len(rendered) != 5:
        return 40
    let recursiveSeq = strutil.Join(
        [strings.IntToStr(12345), "suffix"], "")
    if recursiveSeq != "12345suffix":
        return 41
    return 0

fn main(): int32 =
    let addressCode = checkCompositeAddressChannel()
    if addressCode != 0:
        return addressCode
    let relocCode = checkGlobalRelocTwins()
    if relocCode != 0:
        return relocCode
    let boundaryCode = checkLargeRelocBoundary()
    if boundaryCode != 0:
        return boundaryCode
    return checkTypedExprSharedBuildIndex()
