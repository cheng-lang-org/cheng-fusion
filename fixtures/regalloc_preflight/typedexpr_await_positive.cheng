import std/async_rt

var completionCount: int32

async fn makeValue(): int32 =
    completionCount = completionCount + 1
    return 42

fn accept(value: int32): int32 =
    return value

fn main(): int32 =
    let resolved: int32 = accept(await makeValue())
    if resolved != 42:
        return 1
    if completionCount != 1:
        return 2
    return 0
