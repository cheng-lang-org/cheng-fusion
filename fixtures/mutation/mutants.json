{
  "schema": "cheng_mutation_net.v1",
  "purpose": "变异证明网算子台账: 每个破坏性算子绑定精确 kill 契约(门禁 id + 必中信号); 杀不死的登记为门缺口并给加固规格, 不硬凑 100%。生成器 tools/mutation_net_gen.ts, 实跑 test/item27_mutation_net.ts。",
  "gates": {
    "span_validator": "tools/grammar_span_receipt.ts preflightParserSpanReceipts — 逐项诊断, 信号=issue.code(GSR01..GSR07)",
    "m9024_coverage": "src/cheng_semantic_pipeline_matrix_m9024.ts buildGrammarSourceCoverageReceipt — 唯一权威门禁, 信号=抛错消息子串",
    "m9024_contract": "m9024 validateChengGrammarObligationContract — spec 字节 ↔ 义务合同绑定",
    "m9024_bundle_base": "m9024 validateBaseSemanticSourceBundle",
    "m9024_bundle_profile": "m9024 validatePipelineProfileSourceBundle",
    "m9023_ledger": "src/cheng_semantic_matrix_m9023.ts validateSemanticContractLedger — 计划快照(阶段合同台账)校验",
    "corpus_gate": "item26[A] 同口径语料谓词组(buildCorpus 重建 ↔ manifest ↔ lint ↔ token 平价 ↔ map status), item27 内对变异副本执行",
    "oracle_selftest": "TREE tools/flagship_gen2_oracle.sh --self-test(自带 17 类变异矩阵的 oracle 门)",
    "evidence_verify": "tools/evidence_verify.py — 入库后复核门(GAP-1 闭合), 信号=FAIL 行子串, 全量 rc=1",
    "provenance_anchor": "tools/grammar_span_receipt.ts verifyProvenanceAnchors — GAP-2 锚定门, 信号=GSR08 detail 子串(driverBytes/toolchainManifest 未锚定)"
  },
  "gapRegistry": {
    "GAP-1": {
      "title": "evidence receipt 无入库 verifier 门",
      "detail": "evidence_deposit.py 只在 deposit 时校验 run workDir; 已入库 evidence/<runId>/ 的 receipt.json/manifest.json/index.json 事后被改无任何工具复核。",
      "hardening": "新增 tools/evidence_verify.py: 逐文件重算 sha256 对 manifest.json; done.json==completion.claim.json 逐字节; journal 尾记录 verdict==done.json verdict; index.json 条目与 receipt.json 哈希块一致; receipt.json schema/runId/verdict 枚举形状校验; 任一不符 exit 1。",
      "status": "closed",
      "closedBy": "tools/evidence_verify.py(item27 实跑 kill 双算子)"
    },
    "GAP-2": {
      "title": "parser span receipt 的 provenance 四哈希只验形状不验锚",
      "detail": "parserNodeIdentitySha256/parserTraceRootSha256/driverBytesSha256/toolchainManifestSha256 仅查 64-hex 形状; 全自洽伪造(含过期 toolchain 盐)可过 span_validator 与 m9024_coverage。",
      "hardening": "provenance 锚定: driverBytesSha256 必须等于当次 pinned driver 真实字节 sha(对照 driver manifest); toolchainManifestSha256 必须等于 checked-in toolchain manifest sha; parserTraceRootSha256 由 driver 端 trace 根回执交叉核对; 三者任一不锚即拒。makeSyntheticReceipt 的 synthetic:* 派生值仅允许出现在测试夹具白名单路径。",
      "status": "closed",
      "closedBy": "grammar_span_receipt.verifyProvenanceAnchors + fixtures/semantic/toolchain_anchor.json(item27 实跑 kill 双算子)"
    }
  },
  "operators": [
    {
      "id": "M-DROP-FIELD",
      "class": "destructive",
      "operator": "drop_field",
      "target": "parser_span_receipt",
      "detail": "删除 receipt.tokenSha256 字段(不重算 receiptSha256); 权威门先于 identity 检查在 witness token 校验拒绝",
      "killContract": {
        "gate": "span_validator",
        "signal": "GSR02_RECEIPT_HASH",
        "authorityGate": "m9024_coverage",
        "authoritySignal": "token bytes changed"
      }
    },
    {
      "id": "M-SPAN-SHIFT-REHASH",
      "class": "destructive",
      "operator": "span_shift",
      "target": "parser_span_receipt",
      "detail": "tokenStart+1, receiptSha256 重算(隔离变量, 纯 span 错位)",
      "killContract": {
        "gate": "span_validator",
        "signal": "GSR06_TOKEN_HASH",
        "authorityGate": "m9024_coverage",
        "authoritySignal": "token bytes changed"
      }
    },
    {
