fn main(): int32 =
    var r = 0
    if r > 0:
        r = 1
    elif r > 1:
        r = 2
    else:
        r = 3
    if r < 0:
        r = 9
    while r > 0:
        r = r - 1
        if r == 2:
            break
        continue
    for i in 0..<10:
        r = r + i
    defer:
        r = 0
    block:
        r = 1
    block b:
        r = 2
    when r > 0:
        r = 5
    elif r > 1:
        r = 6
    else:
        r = 7
    when r < 0:
        r = 8
    match r:
        1 => r = 10
        _ => r = 11
    case r:
        of 1: r = 1
        else: r = 3
    r = r + 1
    r + 1
    return r
