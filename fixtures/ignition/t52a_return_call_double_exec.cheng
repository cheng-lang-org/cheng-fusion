# T52 family: `return <call>` with a preceding if-return guard duplicates the
# call's typed-ir fact (return's own useExpr registration + unconsumed fact
# table entry -> two physical `bl` to helper()). Expect rc=1 (single exec).
# Source: diag_T52/README.md v3 (repro1.cheng); rescued at
# diag_T52/repro_rescue/t52_repro1.cheng.
var gLast: int32 = -1
var gCallCount: int32 = 0

fn helper(pid: int64, outv: var int32): int32 =
    gCallCount = gCallCount + 1
    outv = -1
    if pid <= 0:
        return -1
    outv = 7
    return 1

fn bridge(pid: int64): int32 =
    gLast = -1
    if pid <= 0:
        return -1
    return helper(pid, gLast)

fn main(): int32 =
    let r = bridge(int64(42))
    return gCallCount
