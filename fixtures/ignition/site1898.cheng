import std/result
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# site1898 高保真等价形: 对应 src/core/backend/lowering_plan.cheng:1898-1908
# 真实站点的构造形态 —— 经两层字段路径 (plan.typedIr.XXX) 访问 SoA 列,
# 而非裸局部数组 (对照 repro46/q1.cheng 是裸局部数组的浅形态)。
# 5 个调用值字段: sourcePath/functionName (Value(LookupIntern) 嵌套) +
# lineNumber/columnNumber (ArenaArrayInt32Get) + kind (枚举字段直读)。
type
    MiniTypedIr =
        internPool: langintern.InternPool
        arena: arenamod.Arena
        statements2_sourcePathIds: langintern.InternId[]
        statements2_functionNameIds: langintern.InternId[]
        statements2_lineNumbers: arenamod.ArenaArrayInt32
        statements2_columnNumbers: arenamod.ArenaArrayInt32
        statements2_kinds: texpr.TypedExprIrStatementKind[]

    MiniPlan =
        typedIr: MiniTypedIr

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid0 = langintern.Intern(pool, "unused.cheng")
    let sid1 = langintern.Intern(pool, "site1898.cheng")
    let fid0 = langintern.Intern(pool, "unusedFn")
    let fid1 = langintern.Intern(pool, "LoweringOrderStatementsBuild")

    var sourcePathIds: langintern.InternId[]
    add(sourcePathIds, sid0)
    add(sourcePathIds, sid1)
    var functionNameIds: langintern.InternId[]
    add(functionNameIds, fid0)
    add(functionNameIds, fid1)

    var arena = arenamod.ArenaCreate(4096)
    var lineArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, lineArr, 99)
    arenamod.ArenaArrayInt32Add(arena, lineArr, 1898)
    var colArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, colArr, 99)
    arenamod.ArenaArrayInt32Add(arena, colArr, 9)

    var kinds: texpr.TypedExprIrStatementKind[]
    # add() 直接接字面量枚举实参会触发一个与本任务无关的独立 bail=631
    # (已用最小 probe 确认: /tmp/f23/adv_review/enumadd_probe.cheng);
    # 生产代码 (typed_expr.cheng:1346 `add(ir.statements2_kinds, stmt.kind)`)
    # 传的是变量读取而非字面量, 这里先绑定局部变量再 add() 与生产形态同款,
    # 绕开的是该独立 bug 而非本任务待验证的 form45 构造器路径。
    let k0: texpr.TypedExprIrStatementKind = texpr.TypedExprIrStmtReturn
    let k1: texpr.TypedExprIrStatementKind = texpr.TypedExprIrStmtLetCall
    add(kinds, k0)
    add(kinds, k1)

    var plan: MiniPlan
    plan.typedIr.internPool = pool
    plan.typedIr.arena = arena
    plan.typedIr.statements2_sourcePathIds = sourcePathIds
    plan.typedIr.statements2_functionNameIds = functionNameIds
    plan.typedIr.statements2_lineNumbers = lineArr
    plan.typedIr.statements2_columnNumbers = colArr
    plan.typedIr.statements2_kinds = kinds

    let stmtIndex: int32 = 1
    let s = texpr.TypedExprIrStatement(
        sourcePath: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_sourcePathIds[stmtIndex])),
        functionName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_functionNameIds[stmtIndex])),
        lineNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lineNumbers, stmtIndex),
        columnNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_columnNumbers, stmtIndex),
        kind: plan.typedIr.statements2_kinds[stmtIndex]
    )
    if s.sourcePath != "site1898.cheng":
        return 1
    if s.functionName != "LoweringOrderStatementsBuild":
        return 2
    if s.lineNumber != 1898:
        return 3
    if s.columnNumber != 9:
        return 4
    if s.kind != texpr.TypedExprIrStmtLetCall:
        return 5
    return 7
