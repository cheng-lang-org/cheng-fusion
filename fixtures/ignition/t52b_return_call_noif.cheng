# T52 family: same double-exec fact-duplication bug as t52a, but with a
# single-statement function body (no if branch) -- proves the trigger is
# purely "return's root call fact left unconsumed", independent of body
# shape/branching. Expect rc=1 (single exec).
# Source: diag_T52/README.md v3 (repro3_noif.cheng); rescued at
# diag_T52/repro_rescue/t52_repro3_noif.cheng.
var gLast: int32 = -1
var gCallCount: int32 = 0

fn helper(pid: int64, outv: var int32): int32 =
    gCallCount = gCallCount + 1
    outv = 7
    return 1

fn bridge(pid: int64): int32 =
    return helper(pid, gLast)

fn main(): int32 =
    let r = bridge(int64(42))
    return gCallCount
