import std/result

type CasLockEnsurer = fn(channelHex: str, modulePath: str, storeRoot: str): Result[bool]

fn realEnsurer(channelHex: str, modulePath: str, storeRoot: str): Result[bool] =
    if channelHex == "":
        return Err[bool]("no channel")
    return Ok[bool](true)

# CSG 可达性哨兵(见 g45.cheng/form44_repro_call.cheng 同款注释): realEnsurer
# 只被当 fn-value 引用(从未被按名直接调用), 需要保活才能进
# lowering.functionSymbolTexts(函数地址物化的符号表)——与本 form46 sret 桥
# arity 扩展无关的独立、既有 CSG 剪枝边界(form43 案卷)。
fn keepRealEnsurerReachable(): int32 =
    let r = realEnsurer("x", "y", "z")
    if IsErr(r):
        return -1
    return 0

fn callViaParam(ensurer: CasLockEnsurer, a: str, b: str, c: str): int32 =
    let r: Result[bool] = ensurer(a, b, c)
    if IsErr(r):
        return -1
    if !Value(r):
        return -2
    return 1

fn main(): int32 =
    let anchor = keepRealEnsurerReachable()
    if anchor != 0:
        return 10
    let x = callViaParam(realEnsurer, "chan", "mod", "store")
    if x != 1:
        return 1
    return 7
