import std/os as os
import std/rawbytes as rawbytes
import std/strings as strings

fn main(): int32 =
    let path: str = "/tmp/wipv11/probe.txt"
    os.WriteFile(path, "hello")
    var br: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if IsErr(br):
        let e: str = Error(br)
        os.WriteFile("/tmp/wipv11/err_text.txt", e)
        return strings.Len(e)
    return 0
