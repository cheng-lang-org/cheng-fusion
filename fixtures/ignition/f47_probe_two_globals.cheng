import std/result

# form47 派发正确性探针1: 两个不同函数分别存进两个不同的模块级全局, 各自经
# 全局读回间接调用, 断言两者结果不同且各自正确(防"解析到同一个/错误的函数")。

type
    IntFn = fn(x: int32): Result[bool]

fn fnA(x: int32): Result[bool] =
    if x == 1:
        return Ok[bool](true)
    return Err[bool]("fnA-reject")

fn fnB(x: int32): Result[bool] =
    if x == 2:
        return Ok[bool](true)
    return Err[bool]("fnB-reject")

fn keepReachable(): int32 =
    let ra = fnA(1)
    let rb = fnB(2)
    if IsErr(ra) || IsErr(rb):
        return -1
    return 0

var globalA: IntFn
var globalB: IntFn

fn setGlobals(a: IntFn, b: IntFn) =
    globalA = a
    globalB = b

fn callA(x: int32): int32 =
    var r: Result[bool] = globalA(x)
    if IsErr(r):
        return -1
    return 1

fn callB(x: int32): int32 =
    var r: Result[bool] = globalB(x)
    if IsErr(r):
        return -1
    return 1

fn main(): int32 =
    let anchor = keepReachable()
    if anchor != 0:
        return 90
    setGlobals(fnA, fnB)
    # globalA is fnA: accepts x==1, rejects x==2
    if callA(1) != 1:
        return 1
    if callA(2) != -1:
        return 2
    # globalB is fnB: accepts x==2, rejects x==1
    if callB(2) != 1:
        return 3
    if callB(1) != -1:
        return 4
    # same global read back twice -> consistent result
    if callA(1) != 1:
        return 5
    if callA(1) != 1:
        return 6
    # direct call to same underlying function must match global-readback result
    let direct = fnA(1)
    if IsErr(direct):
        return 8
    return 7
