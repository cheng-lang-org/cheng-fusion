import std/result
import cheng/core/lang/intern as langintern

# 对照: 去掉 ctor 消费, 只测「局部 str 拼接」这个 LocalDecl RHS 本身是否可编译
fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid1 = langintern.Intern(pool, "site3387")
    let retBase = Value(langintern.LookupIntern(pool, sid1))
    let retSourcePath = retBase + ".cheng"
    if retSourcePath != "site3387.cheng":
        return 1
    return 7
