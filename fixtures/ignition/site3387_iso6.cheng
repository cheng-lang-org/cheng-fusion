import std/result
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

type
    MiniTypedIr =
        internPool: langintern.InternPool
        nodes2_sourcePathIds: langintern.InternId[]
        nodes2_opKinds: texpr.TypedExprIrOpKind[]

    MiniPlan =
        typedIr: MiniTypedIr

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid0 = langintern.Intern(pool, "unused.cheng")
    let sid1 = langintern.Intern(pool, "site3387.cheng")

    var sourcePathIds: langintern.InternId[]
    add(sourcePathIds, sid0)
    add(sourcePathIds, sid1)

    var opKinds: texpr.TypedExprIrOpKind[]
    let k0: texpr.TypedExprIrOpKind = texpr.TypedExprIrOpUnsupported
    let k1: texpr.TypedExprIrOpKind = texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31
    add(opKinds, k0)
    add(opKinds, k1)

    var plan: MiniPlan
    plan.typedIr.internPool = pool
    plan.typedIr.nodes2_sourcePathIds = sourcePathIds
    plan.typedIr.nodes2_opKinds = opKinds

    let retNodeIdx: int32 = 1
    let retSourcePath = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_sourcePathIds[retNodeIdx]))
    let retOpKind = plan.typedIr.nodes2_opKinds[retNodeIdx]

    let returnNode = texpr.TypedExprIrNode(
        sourcePath: retSourcePath,
        opKind: retOpKind,
    )
    if returnNode.sourcePath != "site3387.cheng":
        return 1
    if returnNode.opKind != texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31:
        return 3
    return 7
