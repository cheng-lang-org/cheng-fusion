import std/result

# 复核员自写对抗变体 (不复用 f47_probe_two_globals.cheng): 用 form47 真实目标
# 签名 (3 参 sret 桥, CasLockEnsurer 同款) 造两个不同模块级全局, 各自存不同
# 函数, 交叉调用断言派发不串, 防"读回全局但值被物化成同一个/错误函数"的
# 上上轮 form43 翻车模式。
type
    CasLockEnsurer = fn(channelHex: str, modulePath: str, storeRoot: str): Result[bool]

fn ensurerAcceptsChan1(channelHex: str, modulePath: str, storeRoot: str): Result[bool] =
    if channelHex == "chan1":
        return Ok[bool](true)
    return Err[bool]("ensurerA-reject")

fn ensurerAcceptsChan2(channelHex: str, modulePath: str, storeRoot: str): Result[bool] =
    if channelHex == "chan2":
        return Ok[bool](true)
    return Err[bool]("ensurerB-reject")

fn keepReachable(): int32 =
    let ra = ensurerAcceptsChan1("chan1", "m", "s")
    let rb = ensurerAcceptsChan2("chan2", "m", "s")
    if IsErr(ra) || IsErr(rb):
        return -1
    return 0

var ensurerSlotA: CasLockEnsurer
var ensurerSlotB: CasLockEnsurer

fn setSlots(a: CasLockEnsurer, b: CasLockEnsurer) =
    ensurerSlotA = a
    ensurerSlotB = b

fn invokeA(channelHex: str, modulePath: str, storeRoot: str): int32 =
    var r: Result[bool] = ensurerSlotA(channelHex, modulePath, storeRoot)
    if IsErr(r):
        return -1
    return 1

fn invokeB(channelHex: str, modulePath: str, storeRoot: str): int32 =
    var r: Result[bool] = ensurerSlotB(channelHex, modulePath, storeRoot)
    if IsErr(r):
        return -1
    return 1

fn main(): int32 =
    let anchor = keepReachable()
    if anchor != 0:
        return 90
    setSlots(ensurerAcceptsChan1, ensurerAcceptsChan2)
    # slotA is ensurerAcceptsChan1: accepts "chan1", rejects "chan2"
    if invokeA("chan1", "mod1", "root1") != 1:
        return 1
    if invokeA("chan2", "mod1", "root1") != -1:
        return 2
    # slotB is ensurerAcceptsChan2: accepts "chan2", rejects "chan1"
    if invokeB("chan2", "mod2", "root2") != 1:
        return 3
    if invokeB("chan1", "mod2", "root2") != -1:
        return 4
    # re-read slotA repeatedly -> deterministic, must not drift to slotB's function
    if invokeA("chan1", "mod1", "root1") != 1:
        return 5
    if invokeA("chan2", "mod1", "root1") != -1:
        return 6
    return 7
