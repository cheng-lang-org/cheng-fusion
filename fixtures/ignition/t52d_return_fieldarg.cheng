# T52 family, coverage-lock: `return <call>` where the call's own arguments
# are struct-field accesses (p.a, p.b), no side-effect counter available so
# this does not distinguish double-exec (add2 is pure) -- kept as a
# regression lock for the return-call-with-field-args shape. Expect rc=7.
# Source: rescued at diag_T52/repro_rescue/repro_fieldarg.cheng.
type
    Pair =
        a: int32
        b: int32
fn add2(x: int32, y: int32): int32 =
    return x + y
fn viaPair(p: Pair): int32 =
    return add2(p.a, p.b)
fn main(): int32 =
    let p: Pair = Pair(a: 3, b: 4)
    return viaPair(p)
