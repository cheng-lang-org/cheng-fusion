import std/result

# parser.cheng:8633 真实站点等价形: 三形参 ensurer fn-value, 模块级全局
# fn-value 变量, 经裸函数名实参注入 (ParserSetCasLockEnsurer(realEnsurer))
# 后, 调用点内部通过全局 fn-value 发起间接调用返回 Result[bool] + IsErr 分支。

type
    CasLockEnsurer = fn(channelHex: str, modulePath: str, storeRoot: str): Result[bool]

fn realEnsurer(channelHex: str, modulePath: str, storeRoot: str): Result[bool] =
    if channelHex == "":
        return Err[bool]("no channel")
    return Ok[bool](true)

# CSG 可达性哨兵(见 g45.cheng 同款注释): realEnsurer 只被当 fn-value 引用,
# 从未被按名直接调用, 需要保活才能进 lowering.functionSymbolTexts。
fn keepRealEnsurerReachable(): int32 =
    let r = realEnsurer("x", "y", "z")
    if IsErr(r):
        return -1
    return 0

var parserCasLockEnsurerSet: bool
var parserCasLockEnsurerImpl: CasLockEnsurer

fn ParserSetCasLockEnsurer(ensurer: CasLockEnsurer) =
    parserCasLockEnsurerSet = true
    parserCasLockEnsurerImpl = ensurer

fn originalMain_renamed_unused_placeholder_never_called(): int32 =
    let anchor = keepRealEnsurerReachable()
    if anchor != 0:
        return 10
    # 危险形a 真实站点等价: 裸函数名 realEnsurer 直接作实参传给
    # ParserSetCasLockEnsurer(ensurer: CasLockEnsurer) —— 与
    # parser.cheng:8633 上游 compiler_main.cheng:8859
    # `parser.ParserSetCasLockEnsurer(compilerMainCasEnsureLock)` 同形态。
    ParserSetCasLockEnsurer(realEnsurer)
    if !parserCasLockEnsurerSet:
        return 1
    return 7

# 对抗复核第4项-变体2: 两别名+全局直调——第二个 fn 类型别名也有自己的
# 模块级全局变量+setter+直接调用, 与第一个别名(CasLockEnsurer/parserCasLockEnsurerImpl)
# 共存, 验证两条独立全局 fn-value 通道是否互相干扰。
type SecondEnsurer = fn(tag: str): Result[bool]

fn secondRealImpl(tag: str): Result[bool] =
    if tag == "":
        return Err[bool]("no tag")
    return Ok[bool](true)

fn keepSecondRealImplReachable(): int32 =
    let r = secondRealImpl("x")
    if IsErr(r):
        return -1
    return 0

var secondEnsurerSet: bool
var secondEnsurerImpl: SecondEnsurer

fn SetSecondEnsurer(e: SecondEnsurer) =
    secondEnsurerSet = true
    secondEnsurerImpl = e

fn main(): int32 =
    let anchor0 = keepSecondRealImplReachable()
    if anchor0 != 0:
        return 20
    let anchor = keepRealEnsurerReachable()
    if anchor != 0:
        return 10
    ParserSetCasLockEnsurer(realEnsurer)
    if !parserCasLockEnsurerSet:
        return 1
    SetSecondEnsurer(secondRealImpl)
    if !secondEnsurerSet:
        return 2
    return 7
