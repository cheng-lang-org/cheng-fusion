import std/system as system
import std/strings as strings

fn scanByte(data: ptr, n: int32, want: int32): int32 =
    for i in 0..<n:
        if *(UInt8Ptr(cheng_ptr_plus(data, i))) == uint8(want):
            return i
    return -1

fn main(): int32 =
    let s: str = "abcXdef"
    let d: ptr = StrDataPtr(s)
    let hit: int32 = scanByte(d, strings.Len(s), int32('X'))
    if hit == 3:
        return 0
    return 10 + hit
