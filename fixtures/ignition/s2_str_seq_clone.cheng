import std/seqs

fn cloneRoots(xs: str[]): str[] =
    var out: str[]
    for x in xs:
        seqs.Add(out, x)
    return out

fn main(): int32 =
    var src: str[]
    seqs.Add(src, "root-alpha")
    seqs.Add(src, "root-beta")
    seqs.Add(src, "root-gamma")

    let cloned = cloneRoots(src)

    if cloned.len != 3:
        return 1
    if cloned[0] != "root-alpha":
        return 2
    if cloned[1] != "root-beta":
        return 3
    if cloned[2] != "root-gamma":
        return 4
    if src.len != 3:
        return 5
    if src[0] != "root-alpha":
        return 6
    return 0
