# T52 family, coverage-lock: `return <call>` chains through cstring/nil-guard
# shapes (mirrors cheng_str_param_to_cstring_compat's family) -- pure calls,
# no side-effect counter, does not distinguish double-exec. Kept as a
# regression lock for the return-call-with-nested-nil-guard shape.
# Expect rc=7. Source: rescued at diag_T52/repro_rescue/repro_cstr2.cheng.
fn inner(d: ptr, n: int32): cstring =
    if d == nil || n <= 0:
        return cstring(nil)
    return cstring(d)
fn outer(s: str): cstring =
    let n: int32 = s.len
    if n <= 0:
        return inner(nil, 0)
    return inner(s.data, n)
fn main(): int32 =
    let c: cstring = outer("hey")
    if c == nil:
        return 1
    return 7
