import std/result
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/parser as parser

# site4596 高保真等价形: 对应 src/core/backend/lowering_plan.cheng:4596-4608
# (LoweringExpandReachableFunctionFlags 一带) 真实站点的构造形态 —— 与
# site1898 同款"两层字段路径+索引内联在构造器实参列表"形态, 但字段数不同:
# 真实站点在同一个 `let stmt = TypedExprIrStatement(...)` 里一次性内联索引了
# 3 个不同枚举类型的字段 (kind: TypedExprIrStatementKind / callKind:
# TypedExprCallKind / detailKind: parser.NormalizedExprDetailKind), site1898
# 只验证了 1 个 (kind)。这里补齐 3 个枚举字段同时内联索引, 确认 form45b 的
# elemKind 匹配对三种不同枚举类型 (而不仅是 site1898 验过的那一种) 都成立。
type
    MiniTypedIr =
        internPool: langintern.InternPool
        arena: arenamod.Arena
        statements2_sourcePathIds: langintern.InternId[]
        statements2_lineNumbers: arenamod.ArenaArrayInt32
        statements2_kinds: texpr.TypedExprIrStatementKind[]
        statements2_callKinds: texpr.TypedExprCallKind[]
        statements2_detailKinds: parser.NormalizedExprDetailKind[]

    MiniPlan =
        typedIr: MiniTypedIr

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid0 = langintern.Intern(pool, "unused.cheng")
    let sid1 = langintern.Intern(pool, "site4596.cheng")

    var sourcePathIds: langintern.InternId[]
    add(sourcePathIds, sid0)
    add(sourcePathIds, sid1)

    var arena = arenamod.ArenaCreate(4096)
    var lineArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, lineArr, 11)
    arenamod.ArenaArrayInt32Add(arena, lineArr, 4606)

    var kinds: texpr.TypedExprIrStatementKind[]
    let k0: texpr.TypedExprIrStatementKind = texpr.TypedExprIrStmtUnsupported
    let k1: texpr.TypedExprIrStatementKind = texpr.TypedExprIrStmtCall
    add(kinds, k0)
    add(kinds, k1)

    var callKinds: texpr.TypedExprCallKind[]
    let ck0: texpr.TypedExprCallKind = texpr.TypedExprCallNone
    let ck1: texpr.TypedExprCallKind = texpr.TypedExprCallProjection
    add(callKinds, ck0)
    add(callKinds, ck1)

    var detailKinds: parser.NormalizedExprDetailKind[]
    let dk0: parser.NormalizedExprDetailKind = parser.NormalizedExprDetailNone
    let dk1: parser.NormalizedExprDetailKind = parser.NormalizedExprDetailResultOk
    add(detailKinds, dk0)
    add(detailKinds, dk1)

    var plan: MiniPlan
    plan.typedIr.internPool = pool
    plan.typedIr.arena = arena
    plan.typedIr.statements2_sourcePathIds = sourcePathIds
    plan.typedIr.statements2_lineNumbers = lineArr
    plan.typedIr.statements2_kinds = kinds
    plan.typedIr.statements2_callKinds = callKinds
    plan.typedIr.statements2_detailKinds = detailKinds

    let stmtIndex: int32 = 1
    let stmt = texpr.TypedExprIrStatement(
        sourcePath: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_sourcePathIds[stmtIndex])),
        lineNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lineNumbers, stmtIndex),
        kind: plan.typedIr.statements2_kinds[stmtIndex],
        callKind: plan.typedIr.statements2_callKinds[stmtIndex],
        detailKind: plan.typedIr.statements2_detailKinds[stmtIndex],
    )
    if stmt.sourcePath != "site4596.cheng":
        return 1
    if stmt.lineNumber != 4606:
        return 2
    if stmt.kind != texpr.TypedExprIrStmtCall:
        return 3
    if stmt.callKind != texpr.TypedExprCallProjection:
        return 4
    if stmt.detailKind != parser.NormalizedExprDetailResultOk:
        return 5
    return 7
