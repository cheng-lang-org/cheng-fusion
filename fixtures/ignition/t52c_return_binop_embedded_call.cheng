# T52 family, v3.1 regression lock: `return <binop expr containing a call>`
# (e.g. real-world backend2FragCodecStrSize's `return 4 + 4 + strings.Len(s)`)
# must NOT have its embedded call's fact wrongly consumed by the t52a/b fix --
# the call is a sub-expression of the return value, not the return value
# itself. Re-derived from diag_T52/README.md v3.1 case1_binop description
# (no rescued .cheng source file existed for this shape; helper() with a
# side-effect counter substitutes for strings.Len so the exec count is
# observable via exit code, since strings.Len itself is pure and a
# double-call would be silently unobservable). Expect rc=1 (single exec);
# as-measured this fixture did NOT distinguish oracle/defective/fixed (all
# three gave rc=1) -- kept as a coverage/regression-lock fixture for the
# binop-embedded-call shape, not a red->green repro.
var gCallCount: int32 = 0

fn helper(): int32 =
    gCallCount = gCallCount + 1
    return 3

fn f(): int32 =
    return 4 + 4 + helper()

fn main(): int32 =
    let r = f()
    return gCallCount
