import std/os as os

fn GetVal(): str =
    return "abc"

fn LocalReassign(): int32 =
    var x: str = "start"
    x = GetVal()
    x = GetVal()
    if x != "abc":
        return 1
    return 0

var gPlainStr: str

fn AssignPlainGlobal(): int32 =
    gPlainStr = GetVal()
    if gPlainStr != "abc":
        return 2
    gPlainStr = "second"
    if gPlainStr != "second":
        return 3
    return 0

fn main(): int32 =
    let r1 = LocalReassign()
    if r1 != 0:
        return r1
    let r2 = AssignPlainGlobal()
    if r2 != 0:
        return r2
    os.WriteLine(os.Get_stderr(), "regress_ok")
    return 0
