import std/result
import cheng/core/lang/typed_expr as texpr

# 进一步隔离: 构造器里 opKind 字段值是"裸局部变量"(非任何字段路径来源),
# 定位 bail 是否来自"具名构造器 + 枚举字段 = 裸局部变量"这一形态本身,
# 而与 site3387 的字段路径索引無关。
fn main(): int32 =
    let retOpKind: texpr.TypedExprIrOpKind = texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31
    let node = texpr.TypedExprIrNode(
        opKind: retOpKind,
    )
    if node.opKind != texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31:
        return 1
    return 7
