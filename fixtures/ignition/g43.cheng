import cheng/core/lang/typed_expr as texpr

fn convert(t: texpr.TypedExprIrStatement): int32 =
    return t.lineNumber

fn main(): int32 =
    let typedStmt = texpr.TypedExprIrStatement(
        sourcePath: "s.cheng",
        lineNumber: 7,
        surfaceText: "return 7",
    )
    if len(typedStmt.sourcePath) != 7:
        return 1
    if convert(typedStmt) != 7:
        return 2
    return 7
