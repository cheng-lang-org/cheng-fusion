import std/result

# form47 防错值门: 未覆盖子形态(全局 fn-value 存进 seq, 经索引读回直接调用)
# 必须仍诚实 bail(6641/6650/631 等既有 poison 码), 绝不静默落穿跑垃圾值。

type
    IntFn = fn(x: int32): Result[bool]

fn fnC(x: int32): Result[bool] =
    if x == 3:
        return Ok[bool](true)
    return Err[bool]("fnC-reject")

fn keepReachable(): int32 =
    let r = fnC(3)
    if IsErr(r):
        return -1
    return 0

var fnSeq: IntFn[]

fn setSeq(f: IntFn) =
    add(fnSeq, f)

fn callIndexed(x: int32): int32 =
    var r: Result[bool] = fnSeq[0](x)
    if IsErr(r):
        return -1
    return 1

fn main(): int32 =
    let anchor = keepReachable()
    if anchor != 0:
        return 90
    setSeq(fnC)
    let out = callIndexed(3)
    return out
