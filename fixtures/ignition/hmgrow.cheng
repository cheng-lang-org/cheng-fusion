import std/hashmaps
import std/strings
import std/os

fn main(): int32 =
    var m = hashmaps.HashMapStrIntInit(64)
    var i: int32
    while i < 500:
        let key = strings.ConcatStr("key_", strings.IntToStr(i))
        hashmaps.HashMapStrIntPut(m, key, i * 3)
        i = i + 1
    var j: int32
    var misses: int32
    var wrong: int32
    while j < 500:
        let key = strings.ConcatStr("key_", strings.IntToStr(j))
        var found: bool
        let v = hashmaps.HashMapStrIntGetEx(m, key, found)
        if !found:
            misses = misses + 1
        elif v != j * 3:
            wrong = wrong + 1
        j = j + 1
    if misses > 0:
        os.WriteLine(os.GetStderr(), strings.ConcatStr("misses=", strings.IntToStr(misses)))
        return 1
    if wrong > 0:
        return 2
    return 7
