import std/result
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# site3387 高保真等价形: 对应 src/core/backend/lowering_plan.cheng:3387 附近
# (LoweringNodesAheadOfReturn 一带) 真实站点的构造形态 —— 与 site1898/site4596
# 不同: 枚举字段值 (opKind) 不是在构造器实参列表里内联索引表达式, 而是先
# `let retOpKind = plan.typedIr.nodes2_opKinds[retNodeIdx]` 把索引结果提到一个
# 局部变量, 之后构造器只引用裸局部名 `opKind: retOpKind`。这条路径若真值也
# 走 PrimaryBodyIrContextScalarValueSlotForTextImpl (LocalDecl 语句的标量 RHS
# 解析入口), form45b 补丁应当同样覆盖 (因为补丁挂在 Impl 共享层, 不只挂
# ctor 专用调用点); 若挂在了 ctor-only 分支上, 这条独立 LocalDecl 形态就会
# 露出未覆盖的第二根。
type
    MiniTypedIr =
        internPool: langintern.InternPool
        arena: arenamod.Arena
        nodes2_sourcePathIds: langintern.InternId[]
        nodes2_functionNameIds: langintern.InternId[]
        nodes2_nodeIndexs: arenamod.ArenaArrayInt32
        nodes2_lineNumbers: arenamod.ArenaArrayInt32
        nodes2_opKinds: texpr.TypedExprIrOpKind[]
        nodes2_resultTypeIds: langintern.InternId[]

    MiniPlan =
        typedIr: MiniTypedIr

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid0 = langintern.Intern(pool, "unused.cheng")
    let sid1 = langintern.Intern(pool, "site3387.cheng")
    let fid0 = langintern.Intern(pool, "unusedFn")
    let fid1 = langintern.Intern(pool, "LoweringNodesAheadOfReturn")
    let rtid0 = langintern.Intern(pool, "unusedType")
    let rtid1 = langintern.Intern(pool, "bool")

    var sourcePathIds: langintern.InternId[]
    add(sourcePathIds, sid0)
    add(sourcePathIds, sid1)
    var functionNameIds: langintern.InternId[]
    add(functionNameIds, fid0)
    add(functionNameIds, fid1)
    var resultTypeIds: langintern.InternId[]
    add(resultTypeIds, rtid0)
    add(resultTypeIds, rtid1)

    var arena = arenamod.ArenaCreate(4096)
    var nodeIdxArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, nodeIdxArr, 77)
    arenamod.ArenaArrayInt32Add(arena, nodeIdxArr, 3387)
    var lineArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, lineArr, 55)
    arenamod.ArenaArrayInt32Add(arena, lineArr, 3390)

    var opKinds: texpr.TypedExprIrOpKind[]
    let k0: texpr.TypedExprIrOpKind = texpr.TypedExprIrOpUnsupported
    let k1: texpr.TypedExprIrOpKind = texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31
    add(opKinds, k0)
    add(opKinds, k1)

    var plan: MiniPlan
    plan.typedIr.internPool = pool
    plan.typedIr.arena = arena
    plan.typedIr.nodes2_sourcePathIds = sourcePathIds
    plan.typedIr.nodes2_functionNameIds = functionNameIds
    plan.typedIr.nodes2_nodeIndexs = nodeIdxArr
    plan.typedIr.nodes2_lineNumbers = lineArr
    plan.typedIr.nodes2_opKinds = opKinds
    plan.typedIr.nodes2_resultTypeIds = resultTypeIds

    let retNodeIdx: int32 = 1
    # 真实站点形态: 先各字段单独 let 出局部变量(含枚举字段 retOpKind 经两级
    # 字段路径 + 索引), 再在构造器里引用裸局部名 —— 不是内联索引表达式。
    let retSourcePath = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_sourcePathIds[retNodeIdx]))
    let retFunctionName = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_functionNameIds[retNodeIdx]))
    let retNodeIndex = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_nodeIndexs, retNodeIdx)
    let retLineNumber = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_lineNumbers, retNodeIdx)
    let retOpKind = plan.typedIr.nodes2_opKinds[retNodeIdx]
    let retResultType = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_resultTypeIds[retNodeIdx]))

    let returnNode = texpr.TypedExprIrNode(
        sourcePath: retSourcePath,
        functionName: retFunctionName,
        nodeIndex: retNodeIndex,
        lineNumber: retLineNumber,
        opKind: retOpKind,
        resultType: retResultType,
    )
    if returnNode.sourcePath != "site3387.cheng":
        return 1
    if returnNode.functionName != "LoweringNodesAheadOfReturn":
        return 2
    if returnNode.nodeIndex != 3387:
        return 3
    if returnNode.lineNumber != 3390:
        return 4
    if returnNode.opKind != texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31:
        return 5
    if returnNode.resultType != "bool":
        return 6
    return 7
