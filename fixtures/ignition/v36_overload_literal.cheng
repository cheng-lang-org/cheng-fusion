import std/os as os
import std/strings as strconv

type
    Widget =
        capacityBytes: int32
        alignmentBytes: int32
        generation: int32

fn makeWidget(capacityBytes: int32, alignmentBytes: int32): Widget =
    var out: Widget
    out.capacityBytes = capacityBytes
    out.alignmentBytes = alignmentBytes
    out.generation = 1
    return out

fn makeWidget(capacityBytes: int32): Widget =
    return makeWidget(capacityBytes, 8)

fn main(): int32 =
    var w: Widget = makeWidget(1048576)
    os.WriteLine(os.Get_stdout(), strconv.IntToStr(w.capacityBytes))
    os.WriteLine(os.Get_stdout(), strconv.IntToStr(w.alignmentBytes))
    os.WriteLine(os.Get_stdout(), strconv.IntToStr(w.generation))
    return 0
