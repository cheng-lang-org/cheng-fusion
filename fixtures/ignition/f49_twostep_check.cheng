import std/result
import cheng/core/lang/intern as langintern

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid1 = langintern.Intern(pool, "site3387.cheng")
    let r = langintern.LookupIntern(pool, sid1)
    let retSourcePath = Value(r)
    if retSourcePath != "site3387.cheng":
        return 1
    return 7
