import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod

type
    TypedExprFactTable = texpr.TypedExprFactTable
    Wrap =
        table: TypedExprFactTable
        tag: int32

fn main(): int32 =
    var a: TypedExprFactTable
    a.arena = arenamod.ArenaInit(1048576)
    var w: Wrap
    w.tag = 7
    texpr.TypedExprFactTableMoveInto(w.table, a)
    if w.tag != 7:
        return 1
    if w.table.arena.capacityBytes != 1048576:
        return 2
    return 7
