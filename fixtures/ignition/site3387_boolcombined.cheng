import std/result
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

fn MakeBoolResult(): Result[bool] =
    return Ok(true)

# 变体C': bool 字段来自「组合形」局部变量 (let x = Value(inlineCall()) 直接内联,
# 非两步形), 检查 form49 只覆盖 str/aggregate payload 时是否漏了 bool payload 宽度族。
fn main(): int32 =
    let sid1 = langintern.InternPoolNew()
    let flag = Value(MakeBoolResult())
    let stmt = texpr.TypedExprIrStatement(
        assignRootGlobalFlag: flag,
    )
    if stmt.assignRootGlobalFlag != true:
        return 1
    return 7
