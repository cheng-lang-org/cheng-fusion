import std/result
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# 防串位探针: 两个不同值的局部 str 变量填两个不同 str 字段, 断言值不串位
fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sidA = langintern.Intern(pool, "AAAA_source_path.cheng")
    let sidB = langintern.Intern(pool, "BBBB_function_name")
    let retSourcePath = Value(langintern.LookupIntern(pool, sidA))
    let retFunctionName = Value(langintern.LookupIntern(pool, sidB))
    let returnNode = texpr.TypedExprIrNode(
        sourcePath: retSourcePath,
        functionName: retFunctionName,
    )
    if returnNode.sourcePath != "AAAA_source_path.cheng":
        return 1
    if returnNode.functionName != "BBBB_function_name":
        return 2
    if returnNode.sourcePath == returnNode.functionName:
        return 3
    # 逐字节比较 (StrEq 语义): 长度与内容都要精确匹配, 防止部分串位/截断
    if returnNode.sourcePath.len != 22:
        return 4
    if returnNode.functionName.len != 18:
        return 5
    return 7
