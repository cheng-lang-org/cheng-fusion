import std/os as os
import cheng/core/lang/typed_expr as texpr

fn main(): int32 =
    let f1: str = texpr.TypedExprFilterDebugEnvName()
    let s1: str = texpr.TypedExprScopeDebugEnvName()
    os.WriteLine(os.Get_stderr(), Fmt"f1=[{f1}] s1=[{s1}]")
    let f2: str = texpr.TypedExprFilterDebugEnvName()
    let s2: str = texpr.TypedExprScopeDebugEnvName()
    os.WriteLine(os.Get_stderr(), Fmt"f2=[{f2}] s2=[{s2}]")
    let f3: str = texpr.TypedExprFilterDebugEnvName()
    let s3: str = texpr.TypedExprScopeDebugEnvName()
    os.WriteLine(os.Get_stderr(), Fmt"f3=[{f3}] s3=[{s3}]")
    if f1 != f2 || f2 != f3 || s1 != s2 || s2 != s3:
        return 1
    return 0
