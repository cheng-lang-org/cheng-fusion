import cheng/core/lang/intern as langintern
import std/os

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let idA = langintern.Intern(pool, "hello_world")
    let idB = langintern.Intern(pool, "second_string")
    let idA2 = langintern.Intern(pool, "hello_world")
    if idA != idA2:
        return 1
    let resA: Result[str] = langintern.LookupIntern(pool, idA)
    if !IsOk(resA):
        os.WriteLine(os.GetStderr(), "lookup_A_miss")
        return 2
    if Value(resA) != "hello_world":
        return 3
    let resB: Result[str] = langintern.LookupIntern(pool, idB)
    if !IsOk(resB):
        return 4
    if Value(resB) != "second_string":
        return 5
    return 7
