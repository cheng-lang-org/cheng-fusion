import std/os as os
import cheng/core/lang/typed_expr as texpr

fn main(): int32 =
    let v1: str = texpr.TypedExprFilterDebugEnvName()
    os.WriteLine(os.Get_stderr(), Fmt"call1_len={len(v1)} val=[{v1}]")
    let v2: str = texpr.TypedExprFilterDebugEnvName()
    os.WriteLine(os.Get_stderr(), Fmt"call2_len={len(v2)} val=[{v2}]")
    let v3: str = texpr.TypedExprFilterDebugEnvName()
    os.WriteLine(os.Get_stderr(), Fmt"call3_len={len(v3)} val=[{v3}]")
    return 0
