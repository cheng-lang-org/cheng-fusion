import std/result
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# 变体D: 仅 kind 字段经嵌套字段路径 (plan.typedIr.statements2_kinds[idx]) 索引,
# 其余字段全部裸局部数组/变量, 精确定位"嵌套路径+枚举数组索引"是否单独触发。
type
    MiniTypedIr =
        statements2_kinds: texpr.TypedExprIrStatementKind[]

    MiniPlan =
        typedIr: MiniTypedIr

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid0 = langintern.Intern(pool, "unused.cheng")
    let sid1 = langintern.Intern(pool, "site1898.cheng")
    var sourcePathIds: langintern.InternId[]
    add(sourcePathIds, sid0)
    add(sourcePathIds, sid1)

    var arena = arenamod.ArenaCreate(4096)
    var lineArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, lineArr, 99)
    arenamod.ArenaArrayInt32Add(arena, lineArr, 1898)
    var colArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, colArr, 99)
    arenamod.ArenaArrayInt32Add(arena, colArr, 9)

    var kinds: texpr.TypedExprIrStatementKind[]
    let k0: texpr.TypedExprIrStatementKind = texpr.TypedExprIrStmtReturn
    let k1: texpr.TypedExprIrStatementKind = texpr.TypedExprIrStmtLetCall
    add(kinds, k0)
    add(kinds, k1)

    var plan: MiniPlan
    plan.typedIr.statements2_kinds = kinds

    let stmtIndex: int32 = 1
    let s = texpr.TypedExprIrStatement(
        sourcePath: Value(langintern.LookupIntern(pool, sourcePathIds[stmtIndex])),
        lineNumber: arenamod.ArenaArrayInt32Get(arena, lineArr, stmtIndex),
        columnNumber: arenamod.ArenaArrayInt32Get(arena, colArr, stmtIndex),
        kind: plan.typedIr.statements2_kinds[stmtIndex]
    )
    if s.sourcePath != "site1898.cheng":
        return 1
    if s.lineNumber != 1898:
        return 2
    if s.columnNumber != 9:
        return 3
    if s.kind != texpr.TypedExprIrStmtLetCall:
        return 4
    return 7
