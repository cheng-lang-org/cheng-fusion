import std/result
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# 变体A: str 局部变量经 if 分支重新赋值后入构造器 (不是一次性 let, 是 var + 条件改写)
fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sidA = langintern.Intern(pool, "path_a.cheng")
    let sidB = langintern.Intern(pool, "path_b_reassigned.cheng")
    var retSourcePath = Value(langintern.LookupIntern(pool, sidA))
    let flag = true
    if flag:
        retSourcePath = Value(langintern.LookupIntern(pool, sidB))
    let returnNode = texpr.TypedExprIrNode(
        sourcePath: retSourcePath,
    )
    if returnNode.sourcePath != "path_b_reassigned.cheng":
        return 1
    return 7
