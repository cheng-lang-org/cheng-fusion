import std/result
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid0 = langintern.Intern(pool, "unused.cheng")
    let sid1 = langintern.Intern(pool, "site.cheng")
    var sourcePathIds: langintern.InternId[]
    add(sourcePathIds, sid0)
    add(sourcePathIds, sid1)
    let fid0 = langintern.Intern(pool, "unused_fn")
    let fid1 = langintern.Intern(pool, "mainFn")
    var functionNameIds: langintern.InternId[]
    add(functionNameIds, fid0)
    add(functionNameIds, fid1)

    var arena = arenamod.ArenaCreate(4096)
    var lineArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, lineArr, 99)
    arenamod.ArenaArrayInt32Add(arena, lineArr, 42)
    var indentArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, indentArr, 9)
    arenamod.ArenaArrayInt32Add(arena, indentArr, 4)

    let stmtIndex: int32 = 1
    let s = texpr.TypedExprIrStatement(
        sourcePath: Value(langintern.LookupIntern(pool, sourcePathIds[stmtIndex])),
        functionName: Value(langintern.LookupIntern(pool, functionNameIds[stmtIndex])),
        lineNumber: arenamod.ArenaArrayInt32Get(arena, lineArr, stmtIndex),
        lineIndent: arenamod.ArenaArrayInt32Get(arena, indentArr, stmtIndex),
        kind: texpr.TypedExprIrStmtLocalDecl,
        callKind: texpr.TypedExprCallBuiltin,
        detailKind: parser.NormalizedExprDetailNone,
        assignPlaceKind: texpr.TypedExprPlaceLocal,
        rhsBailReason: texpr.RhsBailNone,
        callSurfaceKind: texpr.CallSurfaceWholeCall,
        loweringMode: texpr.TypedExprLowerReg,
        returnKind: texpr.TypedExprReturnReg,
        returnRoot: true
    )
    if s.sourcePath != "site.cheng":
        return 1
    if s.functionName != "mainFn":
        return 2
    if s.lineNumber != 42:
        return 3
    if s.lineIndent != 4:
        return 4
    if s.kind != texpr.TypedExprIrStmtLocalDecl:
        return 5
    if s.callKind != texpr.TypedExprCallBuiltin:
        return 6
    if s.detailKind != parser.NormalizedExprDetailNone:
        return 7
    if s.assignPlaceKind != texpr.TypedExprPlaceLocal:
        return 8
    if s.rhsBailReason != texpr.RhsBailNone:
        return 9
    if s.callSurfaceKind != texpr.CallSurfaceWholeCall:
        return 10
    if s.loweringMode != texpr.TypedExprLowerReg:
        return 11
    if s.returnKind != texpr.TypedExprReturnReg:
        return 12
    if !s.returnRoot:
        return 13
    return 7
