import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import std/os as os
import std/strings as strconv

fn main(): int32 =
    var table: texpr.TypedExprFactTable
    if table.internPool == nil:
        table.internPool = langintern.InternPoolNew()
    if table.arena.capacityBytes <= 0:
        table.arena = arenamod.ArenaInit(1048576)
    arenamod.ArenaArrayInt32Add(table.arena, table.exprIdIds, 777)
    let v = arenamod.ArenaArrayInt32Get(table.arena, table.exprIdIds, 0)
    os.WriteLine(os.Get_stdout(), strconv.IntToStr(v))
    return 0
