import std/result

# site8633 高保真等价形: 对应 src/core/lang/parser.cheng:8630-8635 真实字节形态——
# 模块级全局 3 参 fn-value ensurer, 经裸函数名注入 (与
# compiler_main.cheng:8859 `parser.ParserSetCasLockEnsurer(compilerMainCasEnsureLock)`
# 同形), 随后在另一函数体内直接读回该全局变量并发起间接调用, 用
# `var ensureRes: Result[bool] = <globalFnValue>(a, b, c)` 声明+调用合一同一行
# (与 parser.cheng:8633 字节级一致), 再 IsErr 消费。
type
    CasLockEnsurer = fn(channelHex: str, modulePath: str, storeRoot: str): Result[bool]

fn realEnsurer(channelHex: str, modulePath: str, storeRoot: str): Result[bool] =
    if channelHex == "":
        return Err[bool]("no channel")
    return Ok[bool](true)

# CSG 可达性哨兵 (同 g45.cheng/g45_parser_site.cheng 款式)
fn keepRealEnsurerReachable(): int32 =
    let r = realEnsurer("x", "y", "z")
    if IsErr(r):
        return -1
    return 0

var parserCasLockEnsurerSet: bool
var parserCasLockEnsurerImpl: CasLockEnsurer

fn ParserSetCasLockEnsurer(ensurer: CasLockEnsurer) =
    parserCasLockEnsurerSet = true
    parserCasLockEnsurerImpl = ensurer

# 真实字节形态: 读回模块级全局 fn-value 并直接调用 + IsErr 消费
# (parser.cheng:8632-8635 同款: if 判定 + var 声明合并调用 + IsErr 分支)。
fn invokeEnsurerFromGlobal(channelHex: str, modulePath: str, storeRoot: str): int32 =
    if parserCasLockEnsurerSet:
        var ensureRes: Result[bool] = parserCasLockEnsurerImpl(channelHex, modulePath, storeRoot)
        if IsErr(ensureRes):
            return -2
        return 0
    return -3

fn main(): int32 =
    let anchor = keepRealEnsurerReachable()
    if anchor != 0:
        return 10
    ParserSetCasLockEnsurer(realEnsurer)
    if !parserCasLockEnsurerSet:
        return 1
    let okCase = invokeEnsurerFromGlobal("chan1", "mod1", "root1")
    if okCase != 0:
        return 2
    let errCase = invokeEnsurerFromGlobal("", "mod1", "root1")
    if errCase != -2:
        return 3
    return 7
