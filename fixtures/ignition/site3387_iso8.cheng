import std/result
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid1 = langintern.Intern(pool, "site3387.cheng")
    let retSourcePath = Value(langintern.LookupIntern(pool, sid1))
    let returnNode = texpr.TypedExprIrNode(
        sourcePath: retSourcePath,
    )
    if returnNode.sourcePath != "site3387.cheng":
        return 1
    return 7
