import std/result
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# 隔离最小化: 只保留 "let x: EnumType = root.field[idx]" 局部声明形态,
# 去掉后面的构造器, 定位 bail 是否就来自这一句 LocalDecl RHS 解析
# (而非 site3387_repro.cheng 里其它字段/构造器的干扰)。
type
    MiniTypedIr =
        arena: arenamod.Arena
        nodes2_opKinds: texpr.TypedExprIrOpKind[]

    MiniPlan =
        typedIr: MiniTypedIr

fn main(): int32 =
    var arena = arenamod.ArenaCreate(4096)
    var opKinds: texpr.TypedExprIrOpKind[]
    let k0: texpr.TypedExprIrOpKind = texpr.TypedExprIrOpUnsupported
    let k1: texpr.TypedExprIrOpKind = texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31
    add(opKinds, k0)
    add(opKinds, k1)

    var plan: MiniPlan
    plan.typedIr.arena = arena
    plan.typedIr.nodes2_opKinds = opKinds

    let retNodeIdx: int32 = 1
    let retOpKind = plan.typedIr.nodes2_opKinds[retNodeIdx]
    if retOpKind != texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31:
        return 1
    return 7
