import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern

type
    Wrap =
        table: ccsg.TypedExprFactTable
        tag: int32

fn main(): int32 =
    var w: Wrap
    w.tag = 7
    if w.table.internPool == nil:
        w.table.internPool = langintern.InternPoolNew()
    if w.table.arena.capacityBytes <= 0:
        w.table.arena = arenamod.ArenaInit(1048576)
    var fact: texpr.TypedExprFact
    texpr.TypedExprFactTableAppend(w.table, fact)
    texpr.TypedExprFactTableAppend(w.table, fact)
    if w.table.count != 2:
        return 1
    if w.tag != 7:
        return 2
    return 7
