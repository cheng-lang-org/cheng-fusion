import std/result
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# site3387 完整 16 字段镜像 —— 既有 site3387_repro 只镜像了 6 个字段
# (sourcePath/functionName/nodeIndex/lineNumber/opKind/resultType), 真实站点
# (lowering_plan.cheng:3387 LoweringNodesAheadOfReturn) 的 ctor 实际填了 16 个
# 字段, 其中 surfaceText/paramName/literalText 三个额外 str 字段同样走
# `Value(langintern.LookupIntern(...))` 组合形裸局部, 从未被 site3387_repro
# 验证过 —— 补全覆盖, 检查 form49 是否遗漏这三个字段的物化。
type
    MiniTypedIr =
        internPool: langintern.InternPool
        arena: arenamod.Arena
        nodes2_sourcePathIds: langintern.InternId[]
        nodes2_functionNameIds: langintern.InternId[]
        nodes2_nodeIndexs: arenamod.ArenaArrayInt32
        nodes2_lineNumbers: arenamod.ArenaArrayInt32
        nodes2_opKinds: texpr.TypedExprIrOpKind[]
        nodes2_resultTypeIds: langintern.InternId[]
        nodes2_surfaceTextIds: langintern.InternId[]
        nodes2_paramSlots: arenamod.ArenaArrayInt32
        nodes2_paramNameIds: langintern.InternId[]
        nodes2_operand0NodeIndexs: arenamod.ArenaArrayInt32
        nodes2_operand1NodeIndexs: arenamod.ArenaArrayInt32
        nodes2_operand2NodeIndexs: arenamod.ArenaArrayInt32
        nodes2_literalTextIds: langintern.InternId[]
        nodes2_fieldOffsetBytes: arenamod.ArenaArrayInt32
        nodes2_fieldSizeBytes: arenamod.ArenaArrayInt32
        nodes2_elemSizeBytes: arenamod.ArenaArrayInt32

    MiniPlan =
        typedIr: MiniTypedIr

fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid1 = langintern.Intern(pool, "site3387full.cheng")
    let fid1 = langintern.Intern(pool, "LoweringNodesAheadOfReturn")
    let rtid1 = langintern.Intern(pool, "bool")
    let stid1 = langintern.Intern(pool, "SURFACE_TEXT_VALUE")
    let pnid1 = langintern.Intern(pool, "PARAM_NAME_VALUE")
    let ltid1 = langintern.Intern(pool, "LITERAL_TEXT_VALUE")

    var sourcePathIds: langintern.InternId[]
    add(sourcePathIds, sid1)
    var functionNameIds: langintern.InternId[]
    add(functionNameIds, fid1)
    var resultTypeIds: langintern.InternId[]
    add(resultTypeIds, rtid1)
    var surfaceTextIds: langintern.InternId[]
    add(surfaceTextIds, stid1)
    var paramNameIds: langintern.InternId[]
    add(paramNameIds, pnid1)
    var literalTextIds: langintern.InternId[]
    add(literalTextIds, ltid1)

    var arena = arenamod.ArenaCreate(4096)
    var nodeIdxArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, nodeIdxArr, 3387)
    var lineArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, lineArr, 3390)
    var paramSlotArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, paramSlotArr, 2)
    var op0Arr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, op0Arr, 11)
    var op1Arr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, op1Arr, 22)
    var op2Arr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, op2Arr, 33)
    var fieldOffArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, fieldOffArr, 44)
    var fieldSizeArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, fieldSizeArr, 8)
    var elemSizeArr = arenamod.ArenaArrayInt32Init()
    arenamod.ArenaArrayInt32Add(arena, elemSizeArr, 4)

    var opKinds: texpr.TypedExprIrOpKind[]
    let k1: texpr.TypedExprIrOpKind = texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31
    add(opKinds, k1)

    var plan: MiniPlan
    plan.typedIr.internPool = pool
    plan.typedIr.arena = arena
    plan.typedIr.nodes2_sourcePathIds = sourcePathIds
    plan.typedIr.nodes2_functionNameIds = functionNameIds
    plan.typedIr.nodes2_nodeIndexs = nodeIdxArr
    plan.typedIr.nodes2_lineNumbers = lineArr
    plan.typedIr.nodes2_opKinds = opKinds
    plan.typedIr.nodes2_resultTypeIds = resultTypeIds
    plan.typedIr.nodes2_surfaceTextIds = surfaceTextIds
    plan.typedIr.nodes2_paramSlots = paramSlotArr
    plan.typedIr.nodes2_paramNameIds = paramNameIds
    plan.typedIr.nodes2_operand0NodeIndexs = op0Arr
    plan.typedIr.nodes2_operand1NodeIndexs = op1Arr
    plan.typedIr.nodes2_operand2NodeIndexs = op2Arr
    plan.typedIr.nodes2_literalTextIds = literalTextIds
    plan.typedIr.nodes2_fieldOffsetBytes = fieldOffArr
    plan.typedIr.nodes2_fieldSizeBytes = fieldSizeArr
    plan.typedIr.nodes2_elemSizeBytes = elemSizeArr

    let retNodeIdx = 0
    let retSourcePath = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_sourcePathIds[retNodeIdx]))
    let retFunctionName = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_functionNameIds[retNodeIdx]))
    let retNodeIndex = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_nodeIndexs, retNodeIdx)
    let retLineNumber = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_lineNumbers, retNodeIdx)
    let retOpKind = plan.typedIr.nodes2_opKinds[retNodeIdx]
    let retResultType = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_resultTypeIds[retNodeIdx]))
    let retSurfaceText = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_surfaceTextIds[retNodeIdx]))
    let retParamSlot = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_paramSlots, retNodeIdx)
    let retParamName = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_paramNameIds[retNodeIdx]))
    let retOperand0 = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_operand0NodeIndexs, retNodeIdx)
    let retOperand1 = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_operand1NodeIndexs, retNodeIdx)
    let retOperand2 = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_operand2NodeIndexs, retNodeIdx)
    let retLiteralText = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_literalTextIds[retNodeIdx]))
    let retFieldOffset = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_fieldOffsetBytes, retNodeIdx)
    let retFieldSize = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_fieldSizeBytes, retNodeIdx)
    let retElemSize = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_elemSizeBytes, retNodeIdx)

    let returnNode = texpr.TypedExprIrNode(
        sourcePath: retSourcePath,
        functionName: retFunctionName,
        nodeIndex: retNodeIndex,
        lineNumber: retLineNumber,
        opKind: retOpKind,
        resultType: retResultType,
        surfaceText: retSurfaceText,
        paramSlot: retParamSlot,
        paramName: retParamName,
        operand0NodeIndex: retOperand0,
        operand1NodeIndex: retOperand1,
        operand2NodeIndex: retOperand2,
        literalText: retLiteralText,
        fieldOffsetBytes: retFieldOffset,
        fieldSizeBytes: retFieldSize,
        elemSizeBytes: retElemSize,
    )
    if returnNode.sourcePath != "site3387full.cheng":
        return 1
    if returnNode.functionName != "LoweringNodesAheadOfReturn":
        return 2
    if returnNode.nodeIndex != 3387:
        return 3
    if returnNode.lineNumber != 3390:
        return 4
    if returnNode.opKind != texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31:
        return 5
    if returnNode.resultType != "bool":
        return 6
    if returnNode.surfaceText != "SURFACE_TEXT_VALUE":
        return 10
    if returnNode.paramSlot != 2:
        return 11
    if returnNode.paramName != "PARAM_NAME_VALUE":
        return 12
    if returnNode.operand0NodeIndex != 11:
        return 13
    if returnNode.operand1NodeIndex != 22:
        return 14
    if returnNode.operand2NodeIndex != 33:
        return 15
    if returnNode.literalText != "LITERAL_TEXT_VALUE":
        return 16
    if returnNode.fieldOffsetBytes != 44:
        return 17
    if returnNode.fieldSizeBytes != 8:
        return 18
    if returnNode.elemSizeBytes != 4:
        return 19
    return 7
