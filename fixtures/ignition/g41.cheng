type
    Big =
        a: str
        b: str
        c: str
        d: str
        e: str
        f: str
        g: str
        h: str
        i2: str
        j: str
        k: str
        l: str
        m: str
        n2: str
        o: str
        p: str
        q: str
        r: str
        s: str
        t: str
        u: str
        v: str
        w: str
        x: str
        n: int32
        k2: int32
        flag: bool

fn makeBig(v: int32): Big =
    var out: Big
    out.n = v
    out.a = "alpha"
    out.w = "omega"
    return out

fn main(): int32 =
    var rows: Big[]
    var one = makeBig(7)
    add(rows, one)
    if rows.len != 1:
        return 1
    if rows[0].n != 7:
        return 2
    if len(rows[0].a) != 5:
        return 3
    return 7
