import std/os as os
import std/rawbytes as rawbytes
import std/strings as strings

fn main(): int32 =
    let path: str = "/tmp/rbytes_probe_ignition.txt"
    os.WriteFile(path, "hello")
    var br: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if IsErr(br):
        return 90
    let b: rawbytes.Bytes = Value(br)
    let n: int32 = rawbytes.BytesLen(b)
    if n != 5:
        return 80 + n
    let s: str = rawbytes.BytesToString(b)
    return strings.Len(s)
