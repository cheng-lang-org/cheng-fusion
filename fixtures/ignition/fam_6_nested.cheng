type
    Loc =
        name: str
        num: int32

    Outer =
        inner: Loc
        tag: int32

fn main(): int32 =
    var o = Outer(inner: Loc(name: "s.cheng", num: 7), tag: 3)
    if len(o.inner.name) != 7:
        return 1
    if o.inner.num != 7:
        return 2
    if o.tag != 3:
        return 4
    return 7
