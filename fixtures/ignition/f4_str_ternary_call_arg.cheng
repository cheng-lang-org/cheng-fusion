import std/system
import std/result

fn giveStrResult(ok: bool): Result[str] =
    if ok:
        return Ok[str]("hello_world_probe")
    return Err[str]("no")

fn stripIt(x: str): str =
    return x

fn main(): int32 =
    let pdBaseRes: Result[str] = giveStrResult(true)
    let baseType = if IsOk(pdBaseRes): stripIt(Value(pdBaseRes)) else: ""
    if baseType == "hello_world_probe":
        return 0
    return 1
