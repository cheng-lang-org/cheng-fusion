import std/result

type
    Pair =
        a: int32
        b: int32

    Holder =
        p: Pair

fn MakePair(x: int32): Result[Pair] =
    var p: Pair
    p.a = x
    p.b = x + 1
    if x < 0:
        return Err("negative")
    return Ok(p)

fn main(): int32 =
    let retPair = Value(MakePair(41))
    let h = Holder(
        p: retPair,
    )
    if h.p.a != 41:
        return 1
    if h.p.b != 42:
        return 2
    return 7
