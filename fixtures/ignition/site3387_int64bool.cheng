import std/result
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# 变体C: int64/bool 字段来自局部变量 (非 str, 检查 form49 只修 str/aggregate 时是否漏了标量宽度族)
fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid1 = langintern.Intern(pool, "site3387.cheng")
    let retSourcePath = Value(langintern.LookupIntern(pool, sid1))
    let retLineNumber64: int64 = 9223372036854775
    let retIsUnsupported: bool = true
    let stmt = texpr.TypedExprIrStatement(
        sourcePath: retSourcePath,
    )
    let returnNode = texpr.TypedExprIrNode(
        sourcePath: retSourcePath,
    )
    if returnNode.sourcePath != "site3387.cheng":
        return 1
    if retLineNumber64 != 9223372036854775:
        return 2
    if retIsUnsupported != true:
        return 3
    if stmt.sourcePath != "site3387.cheng":
        return 4
    return 7
