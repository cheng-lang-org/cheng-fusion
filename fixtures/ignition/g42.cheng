import cheng/core/lang/typed_expr as texpr

type
    Big =
        sourcePath: str
        functionName: str
        lineNumber: int32
        lineIndent: int32
        kind: texpr.TypedExprIrStatementKind
        callKind: texpr.TypedExprCallKind
        surfaceText: str
        bindingName: str
        n: int32

    FnIr =
        name: str
        paramTypes: str[]
        statements: Big[]
        statementCount: int32

fn makeBig(v: int32): Big =
    var out: Big
    out.n = v
    out.lineNumber = v
    out.sourcePath = "alpha"
    out.surfaceText = "return 7"
    return out

fn appendOne(fnIr: var FnIr, v: int32) =
    var one = makeBig(v)
    if len(one.sourcePath) > 0:
        one.bindingName = "bound"
    add(fnIr.statements, one)
    fnIr.statementCount = fnIr.statements.len

fn main(): int32 =
    var fnIr: FnIr
    appendOne(fnIr, 7)
    if fnIr.statementCount != 1:
        return 1
    if fnIr.statements[0].lineNumber != 7:
        return 2
    if len(fnIr.statements[0].surfaceText) != 8:
        return 3
    return 7
