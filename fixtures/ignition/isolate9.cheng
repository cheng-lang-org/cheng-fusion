import cheng/core/tooling/path as chengpath
import cheng/core/lang/parser as parser

fn declCheck(lines: str[],
             lineIndex: int32,
             declName: str): bool =
    if lines.len <= 0:
        return false
    var headerIndex: int32 = -1
    if lineIndex > 0 && lineIndex <= lines.len:
        headerIndex = lineIndex - 1
        if chengpath.PathTrim(lines[headerIndex]) == "" && lineIndex < lines.len:
            headerIndex = lineIndex
        while headerIndex < lines.len:
            let trimmed = chengpath.PathTrim(lines[headerIndex])
            if parser.ParserStartsWithExact(trimmed, "fn ") ||
               parser.ParserStartsWithExact(trimmed, "async fn ") ||
               parser.ParserStartsWithExact(trimmed, "importc fn "):
                break
            if trimmed == "":
                headerIndex = -1
                break
            headerIndex = headerIndex + 1
        if headerIndex >= lines.len:
            headerIndex = -1
    if headerIndex < 0 && declName != "":
        for scan in 0..<lines.len:
            headerIndex = scan
    if headerIndex < 0:
        return false
    var start = headerIndex
    while start > 0:
        let prev = chengpath.PathTrim(lines[start - 1])
        if prev == "":
            break
        if !parser.ParserStartsWithExact(prev, "@"):
            break
        start = start - 1
    var i = start
    while i < headerIndex:
        let trimmed = chengpath.PathTrim(lines[i])
        if trimmed == "":
            break
        if !parser.ParserStartsWithExact(trimmed, "@"):
            break
        if parser.ParserExportcNameFromAnnotationExact(trimmed) != "":
            return true
        i = i + 1
    return false

fn main(): int32 =
    var lines: str[]
    add(lines, "fn foo():")
    add(lines, "    return 1")
    let r = declCheck(lines, 1, "foo")
    if r:
        return 1
    return 0
