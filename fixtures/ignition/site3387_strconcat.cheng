import std/result
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

# 变体B: 局部 str 拼接后入构造器 (先 Value(LookupIntern) 拿到局部 str, 再字符串拼接, 拼接结果入 ctor)
fn main(): int32 =
    var pool = langintern.InternPoolNew()
    let sid1 = langintern.Intern(pool, "site3387")
    let retBase = Value(langintern.LookupIntern(pool, sid1))
    let retSourcePath = retBase + ".cheng"
    let returnNode = texpr.TypedExprIrNode(
        sourcePath: retSourcePath,
    )
    if returnNode.sourcePath != "site3387.cheng":
        return 1
    return 7
