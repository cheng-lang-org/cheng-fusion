import std/os as os

var g12Init: bool
var g12Enabled: bool

fn G12DebugStage(stage: str) =
    if !g12Init:
        g12Init = true
        g12Enabled = os.GetEnv("CHENG_G12_DEBUG") == "1"
    if g12Enabled:
        os.WriteLine(os.Get_stderr(), Fmt"debug_g12={stage}")

fn dirtyStack(): int32 =
    var a1: int32 = 2139062143
    var a2: int32 = 2139062143
    var a3: int32 = 2139062143
    var a4: int32 = 2139062143
    var a5: int32 = 2139062143
    var a6: int32 = 2139062143
    var a7: int32 = 2139062143
    var a8: int32 = 2139062143
    var a9: int32 = 2139062143
    var a10: int32 = 2139062143
    var a11: int32 = 2139062143
    var a12: int32 = 2139062143
    var a13: int32 = 2139062143
    var a14: int32 = 2139062143
    var a15: int32 = 2139062143
    var a16: int32 = 2139062143
    var a17: int32 = 2139062143
    var a18: int32 = 2139062143
    var a19: int32 = 2139062143
    var a20: int32 = 2139062143
    var a21: int32 = 2139062143
    var a22: int32 = 2139062143
    var a23: int32 = 2139062143
    var a24: int32 = 2139062143
    if a1 + a24 > 0:
        return a2 - a23
    return a3 + a22 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21
fn main(): int32 =
    let d0 = dirtyStack()
    G12DebugStage("alpha")
    let d1 = dirtyStack()
    G12DebugStage("beta")
    let d2 = dirtyStack()
    G12DebugStage("gamma")
    if d0 + d1 + d2 > 999:
        return 0
    return 0
