import std/result

# form44 repro: parser.cheng:8633 真实站点等价形的"完整调用+消费"版本——
# g45_parser_site.cheng 只验证了参数物化注入(从未真正调用
# parserCasLockEnsurerImpl), 本文件把调用点补全为真正经模块级全局 fn-value
# 发起间接调用, 直接命中 __cheng_call_indirect_sret_agg1 桥。

type
    CasLockEnsurer = fn(channelHex: str, modulePath: str, storeRoot: str): Result[bool]

fn realEnsurer(channelHex: str, modulePath: str, storeRoot: str): Result[bool] =
    if channelHex == "":
        return Err[bool]("no channel")
    return Ok[bool](true)

fn keepRealEnsurerReachable(): int32 =
    let r = realEnsurer("x", "y", "z")
    if IsErr(r):
        return -1
    return 0

var parserCasLockEnsurerSet: bool
var parserCasLockEnsurerImpl: CasLockEnsurer

fn ParserSetCasLockEnsurer(ensurer: CasLockEnsurer) =
    parserCasLockEnsurerSet = true
    parserCasLockEnsurerImpl = ensurer

fn ensureViaGlobal(): int32 =
    let ch: str = "chan"
    let mp: str = "mod"
    let sr: str = "store"
    let r: Result[bool] = parserCasLockEnsurerImpl(ch, mp, sr)
    if IsErr(r):
        return -1
    return 1

fn main(): int32 =
    let anchor = keepRealEnsurerReachable()
    if anchor != 0:
        return 10
    ParserSetCasLockEnsurer(realEnsurer)
    if !parserCasLockEnsurerSet:
        return 1
    let b = ensureViaGlobal()
    if b != 1:
        return 2
    return 7
