import std/hashmaps
import std/os

fn main(): int32 =
    var m = hashmaps.HashMapStrIntInit(64)
    hashmaps.HashMapStrIntPut(m, "hello_world", 42)
    var found: bool
    let v = hashmaps.HashMapStrIntGetEx(m, "hello_world", found)
    if !found:
        os.WriteLine(os.GetStderr(), "get_after_put_miss")
        return 1
    if v != 42:
        return 2
    hashmaps.HashMapStrIntPut(m, "second_key", 99)
    var found2: bool
    let v2 = hashmaps.HashMapStrIntGetEx(m, "second_key", found2)
    if !found2:
        return 3
    if v2 != 99:
        return 4
    var found3: bool
    let _v3 = hashmaps.HashMapStrIntGetEx(m, "absent_key", found3)
    if found3:
        return 5
    return 7
