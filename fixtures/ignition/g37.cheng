var gReport: str

fn appendLine(out: var str, line: str) =
    if len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{line}"

fn appendReport(out: var str) =
    appendLine(out, "alpha=1")
    appendLine(out, "beta=2")

fn main(): int32 =
    gReport = ""
    appendReport(gReport)
    if len(gReport) != 14:
        return 1
    return 7
