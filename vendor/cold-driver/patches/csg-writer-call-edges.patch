 }
 
+/* Record kind 9: intra-object call/address-ref edge (source_item_id ->
+   target_symbol), informational only. No relocation is performed for these
+   (the branch/ADR immediate is already baked into the kind-5 words), so this
+   carries no word_offset — it exists purely so CSG facts expose the full
+   caller/callee graph, matching kind-6 reloc facts for cross-object calls. */
+static void cold_csg_write_call_edge_record(FILE *f,
+                                              uint32_t source_item_id,
+                                              Span target_symbol) {
+    uint32_t payload_bytes = 4u + 4u + (uint32_t)target_symbol.len;
+    cold_csg_write_record_header(f, 9, payload_bytes);
+    cold_csg_write_payload_u32le(f, source_item_id);
+    cold_csg_write_payload_span(f, target_symbol);
+    fputc('\n', f);
+}
+
 static int32_t cold_csg_source_item_for_word(bool *emit_function,
                                                 int32_t *symbol_offset,
                                                 int32_t *symbol_end,
@@ -49387,6 +49412,18 @@ static bool cold_emit_canonical_csg_facts_from_bodyir(const char *path,
     int32_t *reloc_word = arena_alloc(arena, (size_t)reloc_cap * sizeof(int32_t));
     int32_t *reloc_target = arena_alloc(arena, (size_t)reloc_cap * sizeof(int32_t));
     int32_t reloc_count = 0;
+    /* Call-edge facts (record kind 9): informational caller->callee edges for
+       calls/address-refs the codegen above resolved and baked as a direct
+       intra-object branch/ADR immediate (target_off >= 0 below). Those calls
+       need no Mach-O relocation (the immediate is already correct), so the
+       kind-6 reloc table below never sees them and CSG facts silently lost
+       every intra-file call edge. Track them separately so facts stay a
+       faithful call graph without changing the kind-6 relocation semantics
+       any consumer (including this same reader) depends on. */
+    int32_t edge_cap = function_patches.count > 0 ? function_patches.count : 1;
+    int32_t *edge_source = arena_alloc(arena, (size_t)edge_cap * sizeof(int32_t));
+    int32_t *edge_target = arena_alloc(arena, (size_t)edge_cap * sizeof(int32_t));
+    int32_t edge_count = 0;
     for (int32_t pi = 0; pi < function_patches.count; pi++) {
         FunctionPatch patch = function_patches.items[pi];
         if (patch.target_function < 0 || patch.target_function >= func_count) return false;
@@ -49405,6 +49442,14 @@ static bool cold_emit_canonical_csg_facts_from_bodyir(const char *path,
             } else {
                 die("cold csg unknown function patch kind");
             }
+            int32_t edge_source_item = cold_csg_source_item_for_word(emit_function, symbol_offset,
+                                                                        symbol_end, func_count,
+                                                                        patch.pos);
+            if (edge_source_item >= 0 && edge_count < edge_cap) {
+                edge_source[edge_count] = edge_source_item;
+                edge_target[edge_count] = patch.target_function;
+                edge_count++;
+            }
             continue;
         }
         if (patch.kind == FUNCTION_PATCH_ADDR)
@@ -49468,6 +49513,11 @@ static bool cold_emit_canonical_csg_facts_from_bodyir(const char *path,
                                        (uint32_t)reloc_word[i],
                                        target_name);
     }
+    for (int32_t i = 0; i < edge_count; i++) {
+        Span target_name = cold_fn_object_symbol_span(&symbols->functions[edge_target[i]], true);
+        if (target_name.len <= 0) { fclose(f); return false; }
+        cold_csg_write_call_edge_record(f, (uint32_t)edge_source[i], target_name);
+    }
     bool ok = ferror(f) == 0 &&
               cold_csg_patch_plan_hash(f, (int32_t)sizeof(magic) - 1);
     fclose(f);
