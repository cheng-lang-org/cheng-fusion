+/* Fusion cheng_symbols_v1 contract: lowering_symbols/primary_symbols must be
+   the exact comma-separated function-name list (not a summary line), so the
+   consumer can diff and count symbols deterministically.  The scan below
+   reuses cold_parse_function_symbol_at so the collected name count always
+   matches scan.function_symbol_count (same acceptance predicate, same line
+   walk). */
+static void cold_collect_function_names(Span source, char *out, size_t out_size) {
+    size_t used = 0;
+    out[0] = '\0';
+    int32_t pos = 0;
+    int32_t line_no = 0;
+    bool in_triple = false;
+    while (pos < source.len) {
+        int32_t start = pos;
+        while (pos < source.len && source.ptr[pos] != '\n') pos++;
+        int32_t end = pos;
+        if (pos < source.len) pos++;
+        line_no++;
+        Span line = span_sub(source, start, end);
+        if (in_triple) {
+            if (cold_line_has_triple_quote(line)) in_triple = false;
+            continue;
+        }
+        if (!cold_line_top_level(line) && cold_line_has_triple_quote(line)) {
+            in_triple = true;
+            continue;
+        }
+        if (!cold_line_top_level(line)) continue;
+        ColdFunctionSymbol symbol;
+        if (!cold_parse_function_symbol_at(source, start, line_no, &symbol, NULL)) continue;
+        if (symbol.name.len <= 0) continue;
+        if (used + (size_t)symbol.name.len + 2 >= out_size) break;
+        memcpy(out + used, symbol.name.ptr, (size_t)symbol.name.len);
+        used += (size_t)symbol.name.len;
+        out[used++] = ',';
+        out[used] = '\0';
+    }
+    if (used > 0) out[used - 1] = '\0';
+}
