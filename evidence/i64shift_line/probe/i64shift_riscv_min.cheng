# riscv64 臂判最小形状: 参数提供 uint64 标记槽（免跨函数返回捕获）。
# 判据仅看 obj 反汇编方向: caseB2 应为 ashr（刀后）, 预刀 lsr 泄漏同型。
fn caseB2(u: uint64, m: int32): int64 =
    let vb: int64 = u
    return vb >> m

fn caseA2(v: int64, m: int32): int64 =
    let va: int64 = v
    return va >> m

fn caseD2(u: uint64, m: int32): int64 =
    let vd = u
    return vd >> m

fn main(): int32 =
    return 0
