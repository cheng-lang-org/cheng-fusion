# i64shift_disc.cheng — signed/unsigned `>>` lowering 五臂判别（kd2_abv_1 零烤归因）。
# 规范 docs/cheng-formal-spec.md 1.3.2: 有符号 >> = ashr（int32(-1)>>1==int32(-1)），无符号 = lshr。
# 值全部走运行期（变量计数 m），杜绝常量折叠干扰；期望值只用 << 和 | 构造（不经 >> 判决路径）。
# 判据: OK 行 + run_rc=0。RED_x 行即 x 臂实锤。
import std/system

fn mkNegI(): int64 =
    return 0 - 9223372036854775807 - 1

fn mkNegU(): uint64 =
    return 9223372036854775808

# 0xFF80000000000000 = ashr(0x8000000000000000, 8)
fn expAsr8(): int64 =
    return (int64(255) << 56) | (int64(128) << 48)

# 0x0080000000000000 = lshr(0x8000000000000000, 8)
fn expLsr8(): int64 =
    return int64(128) << 48

# A: 纯 int64 世界（let 标注 + int64 初始化器）→ 规范 ashr
fn caseA(m: int32): int64 =
    let va: int64 = mkNegI()
    return va >> m

# B: int64 标注 let 吃 uint64 初始化器（探针 sha384U64FromBytes 同型）→ 规范仍 ashr；泄漏则 lsr
fn caseB(m: int32): int64 =
    let vb: int64 = mkNegU()
    return vb >> m

# C: var 标注吃 uint64 → var 预分配槽按标注重标，规范 ashr
fn caseC(m: int32): int64 =
    var vc: int64 = mkNegU()
    return vc >> m

# D: 推断 let 吃 uint64（无标注，槽型应保持 uint64）→ 规范 lshr
fn caseD(m: int32): int64 =
    let vd = mkNegU()
    return vd >> m

# E: 无 let，int64 调用结果直接 >> → 规范 ashr
fn caseE(m: int32): int64 =
    return mkNegI() >> m

fn main(): int32 =
    let m: int32 = 8
    if caseA(m) != expAsr8():
        echo("RED_A")
        return 1
    if caseB(m) != expAsr8():
        echo("RED_B")
        return 1
    if caseC(m) != expAsr8():
        echo("RED_C")
        return 1
    if caseD(m) != expLsr8():
        echo("RED_D")
        return 1
    if caseE(m) != expAsr8():
        echo("RED_E")
        return 1
    echo("OK i64shift disc green")
    return 0
