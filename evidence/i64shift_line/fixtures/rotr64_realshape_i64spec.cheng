# rotr64 真形状夹具 v3: int64 形 + 规范正确期望（ashr 符号填充）。
# 与归档 v1（abverdict_line realshape, 逐字取自 sha384@50d1ffeeb）同形状，唯 case2
# 期望改按规范 docs/cheng-formal-spec.md 1.3.2 计算: 有符号 >> 是算术移位。
#   case1: x=0x0180000000000001 (正数) ashr/ashr 同物理结果 → 0x80c0000000000000 不变
#   case2: v=0x8000000000000000 (int64 最小值, 负), v>>8 = 0xff80000000000000 (符号填充)
#          v<<56 = 0x0080000000000000, OR = 0xff80000000000000
# 即规范下该 int64 rotr 形状本就不是循环移位——这正是 sha384 生产改用 uint64 的根因。
# 判据: OK 行 + run_rc=0（修复刀前后都应绿; 刀只改「标注权威」, 纯 int64 世界不受影响）。
import std/system

@borrows
fn u64Mask(): int64 =
    return 0 - 1

@borrows
fn u64(x: int64): int64 =
    return x & u64Mask()

fn u64FromBytes(b0: int32, b1: int32, b2: int32, b3: int32,
                b4: int32, b5: int32, b6: int32, b7: int32): int64 =
    return (int64(b0) << 56) | (int64(b1) << 48) | (int64(b2) << 40) |
           (int64(b3) << 32) | (int64(b4) << 24) | (int64(b5) << 16) |
           (int64(b6) << 8) | int64(b7)

fn rotr64(x: int64, n: int32): int64 =
    let v: int64 = u64(x)
    return u64((v >> n) | (v << (64 - n)))

fn main(): int32 =
    let x1: int64 = u64FromBytes(0x01, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01)
    let e1: int64 = u64FromBytes(0x80, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00)
    let g1: int64 = rotr64(x1, 1)
    let x2: int64 = u64FromBytes(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00)
    let e2: int64 = u64FromBytes(0xff, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00)
    let g2: int64 = rotr64(x2, 8)
    if g1 != e1:
        echo("RED rotr1 got wrong")
        return 1
    if g2 != e2:
        echo("RED rotr8 got wrong")
        return 1
    echo("OK rotr64 realshape i64 spec green")
    return 0
