# rotr64 真形状夹具 v2: uint64 生产形（与 src/std/crypto/sha384.cheng 现行 5c41e41d4
# 旁路后形状同构: int32 移位计数 + (64-n) 减法 + @borrows 掩码 helper 链 + byte 常量构造）。
# v1（.rebuild/abverdict_line/realshape/rotr64_realshape.cheng, int64 形）的 RED 判词
# 已被 i64shift_line 反汇编证伪归因: << 项从未丢失（asr+lsl+orr 全在），红因 = 有符号
# >> 的规范语义是 ashr（spec 1.3.2: int32(-1)>>1==int32(-1)），v1 期望值按逻辑移位
# 计算且作用在负输入上，规范下永不可满足，属坏仪器。v2 改用生产现行 uint64 形，
# 期望 = 真循环移位值，规范可满足。判据: OK 行 + run_rc=0。
import std/system

@borrows
fn u64Mask(): uint64 =
    return 0xffffffffffffffff

@borrows
fn u64(x: uint64): uint64 =
    return x & u64Mask()

fn u64FromBytes(b0: int32, b1: int32, b2: int32, b3: int32,
                b4: int32, b5: int32, b6: int32, b7: int32): uint64 =
    return (uint64(b0) << 56) | (uint64(b1) << 48) | (uint64(b2) << 40) |
           (uint64(b3) << 32) | (uint64(b4) << 24) | (uint64(b5) << 16) |
           (uint64(b6) << 8) | uint64(b7)

fn rotr64(x: uint64, n: int32): uint64 =
    let v: uint64 = u64(x)
    return u64((v >> n) | (v << (64 - n)))

fn main(): int32 =
    # case1: x=0x0180000000000001 rotr 1 = 0x80c0000000000000
    let x1: uint64 = u64FromBytes(0x01, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01)
    let e1: uint64 = u64FromBytes(0x80, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00)
    let g1: uint64 = rotr64(x1, 1)
    # case2: x=0x8000000000000000 rotr 8 = 0x0080000000000000 (<< 项独撑)
    let x2: uint64 = u64FromBytes(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00)
    let e2: uint64 = u64FromBytes(0x00, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00)
    let g2: uint64 = rotr64(x2, 8)
    if g1 != e1:
        echo("RED rotr1 got wrong")
        return 1
    if g2 != e2:
        echo("RED rotr8 got wrong")
        return 1
    echo("OK rotr64 realshape u64 green")
    return 0
