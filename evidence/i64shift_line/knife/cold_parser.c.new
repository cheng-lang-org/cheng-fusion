        int32_t arg_kind = body->slot_kind[arg_slot];
        if (arg_kind == SLOT_STR) {
            if (kind_out) *kind_out = SLOT_STR;
            *slot_out = arg_slot;
            return true;
        }
        if (arg_kind == SLOT_STR_REF) {
            int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
            body_slot_set_type(body, slot, cold_cstr_span("str"));
            int32_t read_op = body_op3(
                body, BODY_OP_PAYLOAD_LOAD, slot,
                arg_slot, 0, COLD_STR_SLOT_SIZE);
            if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=43230\n");
            cold_publish_exact_managed_read_or_sentinel(
                body, read_op,
                COLD_EXACT_READ_OPERAND_A,
                arg_results ? &arg_results[0] : 0);
            if (kind_out) *kind_out = SLOT_STR;
            *slot_out = slot;
            return true;
        }
        /* cstring bridge for ptr/opaque args: borrow as a str view.
           Borrow keeps the caller's buffer (data = raw pointer) but MUST still
           compute the real length via cheng_cstrlen — mirroring std/system
           strViewUnsafe (data, len = c_strlen(raw), store_id = 0, flags = 0).
           Hardcoding len = 0 here folded every borrowed cstring to an empty
           str (StrFromCStringBorrow / os.GetEnv returned length 0). */
        {
            int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
            body_slot_set_type(body, slot, cold_cstr_span("str"));
            int32_t zero = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, zero, 0, 0);

            Span len_param_types[1] = {
                cold_cstr_span("cstring")};
            int32_t len_fn =
                symbols_ensure_exact_external_runtime_signature(
                    parser->symbols,
                    cold_cstr_span("cheng_cstrlen"),
                    1, len_param_types,
                    cold_cstr_span("int32"));
            if (len_fn < 0) die("failed to register cheng_cstrlen intrinsic");
            int32_t len_arg_start = body->call_arg_count;
            body_call_arg(body, arg_slot);
            int32_t len_slot = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_CALL_I32, len_slot, len_fn, len_arg_start);

            body_op3(body, BODY_OP_SLOT_STORE_I64, slot, arg_slot, COLD_STR_DATA_OFFSET, 0);
            body_op3(body, BODY_OP_SLOT_STORE_I32, slot, len_slot, COLD_STR_LEN_OFFSET, 0);
            body_op3(body, BODY_OP_SLOT_STORE_I32, slot, zero, COLD_STR_STORE_ID_OFFSET, 0);
            body_op3(body, BODY_OP_SLOT_STORE_I32, slot, zero, COLD_STR_FLAGS_OFFSET, 0);
            body_op3(body, BODY_OP_SLOT_STORE_I32, slot, zero, COLD_STR_FLAGS_OFFSET + 4, 0);
            if (kind_out) *kind_out = SLOT_STR;
            *slot_out = slot;
            return true;
        }
    }

    if (span_eq(name, "system.strFromCStringCopy") ||
        span_eq(name, "system.StrFromCStringCopy") ||
        span_eq(name, "strFromCStringCopy")) {
        if (arg_count != 1) {
            if (parser->import_mode) {
