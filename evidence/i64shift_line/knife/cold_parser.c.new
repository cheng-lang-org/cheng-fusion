        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_ATOMIC_CAS_I32, slot, ptr, desired, expect);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    if (cold_try_backend_intrinsic(parser, body, intrinsic_name, arg_start, arg_count,
                                   &intrinsic_slot, kind_out)) {
        return intrinsic_slot;
    }
    if (cold_try_assert_intrinsic(body, intrinsic_name, arg_start, arg_count,
                                  arg_results,
                                  &intrinsic_slot, kind_out)) {
        return intrinsic_slot;
    }
    if (cold_try_bootstrap_intrinsic(body, intrinsic_name, arg_start, arg_count,
                                     &intrinsic_slot, kind_out,
                                     result_out)) {
        return intrinsic_slot;
    }
    /* closure_new(fn_ptr, env_ptr) → closure (16 bytes: fn_ptr + env_ptr) */
    if (span_eq(name, "closure_new") || span_eq(name, "closureNew")) {
        if (arg_count != 2) die("closure_new arity mismatch");
        int32_t fn_slot = body->call_arg_slot[arg_start];
        int32_t env_slot = body->call_arg_slot[arg_start + 1];
        int32_t slot = body_slot(body, SLOT_OPAQUE, 16);
        body_op(body, BODY_OP_CLOSURE_NEW, slot, fn_slot, env_slot);
        if (kind_out) *kind_out = SLOT_OPAQUE;
        return slot;
    }
    /* closure_call(closure, arg1, ...) → calls closure */
    if (span_eq(name, "closure_call") || span_eq(name, "closureCall")) {
        if (arg_count < 1) die("closure_call arity mismatch");
        int32_t closure_slot = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_CLOSURE_CALL, slot, closure_slot,
                 arg_start + 1, arg_count - 1);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    if (span_eq(name, "cheng_call_ptr_void_raw")) {
        if (arg_count != 2) die("cheng_call_ptr_void_raw arity mismatch");
        int32_t fn_slot = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_CALL_PTR, slot, fn_slot, arg_start + 1, 1);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    if (span_eq(name, "cheng_call_ptr_i32_raw")) {
        if (arg_count != 4) die("cheng_call_ptr_i32_raw arity mismatch");
        int32_t fn_slot = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_CALL_PTR, slot, fn_slot, arg_start + 1, 3);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    /* closure_env(closure) → extract env pointer from closure */
    if (span_eq(name, "closure_env") || span_eq(name, "closureEnv")) {
        if (arg_count != 1) die("closure_env arity mismatch");
        int32_t closure_slot = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_PTR, 8);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, slot, closure_slot, 8, 8);
        if (kind_out) *kind_out = SLOT_PTR;
        return slot;
    }
    /* Ok[T]/Err[T] constructors must use the concrete Result[T] layout. */
    { Span ctor_base = {0};
      Span result_type = {0};
      if (cold_result_constructor_type(parser, name, &ctor_base, &result_type)) {
          if (span_eq(ctor_base, "ErrCode")) {
              if (arg_count != 2) die("ErrCode constructor arity mismatch");
              int32_t slot = cold_make_error_result_slot_from_code_msg(parser, body, result_type,
                                                                       body->call_arg_slot[arg_start],
                                                                       body->call_arg_slot[arg_start + 1],
                                                                       &arg_results[1],
                                                                       result_out);
              if (kind_out) *kind_out = SLOT_OBJECT;
              return slot;
          }
          if (arg_count != 1) die("Result constructor arity mismatch");
          if (span_eq(ctor_base, "Err")) {
              int32_t slot = cold_make_error_result_slot_from_msg(parser, body, result_type,
                                                                  body->call_arg_slot[arg_start],
                                                                  &arg_results[0],
                                                                  result_out);
              if (kind_out) *kind_out = SLOT_OBJECT;
              return slot;
          }
          int32_t val = body->call_arg_slot[arg_start];
          return cold_make_ok_result_slot(
              parser, body, result_type, val,
              &arg_results[0], kind_out, result_out);
      }
    }
    /* ptr(x) intrinsic: type conversion to ptr (generic pointer) */
    if (span_eq(intrinsic_name, "ptr")) {
        if (arg_count != 1) die("ptr() expects 1 arg");
        int32_t src = body->call_arg_slot[arg_start];
        int32_t src_kind = body->slot_kind[src];
        int32_t slot = cold_materialize_ptr_value(body, src, &src_kind);
        if (kind_out) *kind_out = SLOT_PTR;
        return cold_stamp_generic_ptr_value(body, slot);
    }
    Span lookup_name = parser_can_scope_bare_name(parser, stripped_name)
                           ? parser_scoped_bare_name(parser, stripped_name)
                           : stripped_name;
    int32_t fn_index = symbols_find_fn_for_call(parser->symbols, lookup_name, body, arg_start, arg_count,
                                                arg_exprs, explicit_type_count > 0 ? explicit_type_args : 0,
                                                explicit_type_count);
    /* `panic(msg)` is a language-level termination builtin (the formal spec
       defines panic as unstructured process termination with no defer), and
       Cheng sources use the bare form pervasively.  Resolve it to std/system's
       panic when nothing closer binds the bare name -- the same place where
       `assert` already gets intrinsic treatment.  A module-local `panic`
       definition still wins because the plain lookup runs first. */
    if (fn_index < 0 && (span_eq(lookup_name, "panic") || span_eq(lookup_name, "Panic"))) {
        lookup_name = cold_cstr_span("system.panic");
        fn_index = symbols_find_fn_for_call(parser->symbols, lookup_name, body, arg_start, arg_count,
                                            arg_exprs, explicit_type_count > 0 ? explicit_type_args : 0,
                                            explicit_type_count);
    }
    Span final_arg_exprs[COLD_MAX_I32_PARAMS];
    for (int32_t i = 0; i < arg_count; i++) final_arg_exprs[i] = arg_exprs[i];
    int32_t final_arg_start = arg_start;
    int32_t final_arg_count = arg_count;
    if (fn_index < 0) {
        /* Check for indirect call via local variable (function pointer) */
        Local *indirect_local = locals_find(locals, name);
        if (indirect_local &&
            (indirect_local->kind == SLOT_PTR || indirect_local->kind == SLOT_OPAQUE)) {
            Span fn_ret = {0};
            int32_t ptr_ret_kind = SLOT_I32;
            int32_t ptr_ret_size = 4;
            if (cold_fn_value_signature(parser->symbols,
                                        body->slot_type[indirect_local->slot], &fn_ret)) {
                ptr_ret_kind =
                    parser_slot_kind_from_type(
                        parser, fn_ret);
                ptr_ret_size =
                    parser_slot_size_from_type(
                        parser, fn_ret,
                        ptr_ret_kind);
            }
            int32_t slot = body_slot(body, ptr_ret_kind, ptr_ret_size);
            if (ptr_ret_kind != SLOT_I32)
                cold_call_result_slot_set_type(
                    body, parser->symbols, slot,
                    ptr_ret_kind, fn_ret);
            /* A fn-value call through a Cheng fn-typed signature (e.g.
               cas.CasSourceFetcher) follows the spec's default for
               unannotated Cheng returns: the result is OWNED.  Publish it
               exactly instead of rejecting the managed result. */
            int32_t call_op = body_op3(body, BODY_OP_CALL_PTR,
                                       slot, indirect_local->slot,
                                       arg_start, arg_count);
            cold_bind_call_ptr_arg_authorities(
                body, arg_start, arg_count, arg_results);
            if (cold_exact_storage_authority_for_slot(
                    parser->symbols, body, slot, ptr_ret_kind) !=
                    COLD_MANAGED_STORAGE_UNKNOWN) {
                cold_publish_exact_managed_definition(
                    body, parser->symbols, slot,
                    ptr_ret_kind, call_op, COLD_EXPR_OWN_MOVE, 0);
            }
            if (kind_out) *kind_out = ptr_ret_kind;
            return slot;
        }
        int32_t field_call_slot = -1;
        if (cold_try_field_function_pointer_call(parser, body, locals, name,
                                                 arg_start, arg_count,
                                                 &field_call_slot, kind_out)) {
            return field_call_slot;
        }
        int32_t receiver_dot = cold_span_find_char(stripped_name, '.');
        if (receiver_dot > 0 && receiver_dot + 1 < stripped_name.len &&
            cold_span_find_char(span_sub(stripped_name, receiver_dot + 1, stripped_name.len), '.') < 0 &&
            arg_count + 1 <= COLD_MAX_I32_PARAMS) {
            Span receiver_name = span_sub(stripped_name, 0, receiver_dot);
            Span method_name = span_sub(stripped_name, receiver_dot + 1, stripped_name.len);
            Local *receiver = locals_find(locals, receiver_name);
            if (receiver) {
                Span receiver_type = span_trim(body->slot_type[receiver->slot]);
                bool receiver_is_var = false;
                receiver_type = span_trim(cold_type_strip_var(receiver_type, &receiver_is_var));
                int32_t type_dot = cold_span_find_char(receiver_type, '.');
                if (type_dot > 0) {
                    Span module_alias = span_sub(receiver_type, 0, type_dot);
                    Span receiver_lookup = cold_arena_join3(parser->arena, module_alias,
                                                            ".", method_name);
                    int32_t recv_arg_start = body->call_arg_count;
                    body_call_arg(body, receiver->slot);
                    for (int32_t ai = 0; ai < arg_count; ai++) {
                        body_call_arg(body, body->call_arg_slot[arg_start + ai]);
                    }
                    Span recv_arg_exprs[COLD_MAX_I32_PARAMS];
                    recv_arg_exprs[0] = receiver_name;
                    for (int32_t ai = 0; ai < arg_count; ai++)
                        recv_arg_exprs[ai + 1] = arg_exprs[ai];
                    int32_t resolved = symbols_find_fn_for_call(parser->symbols, receiver_lookup,
                                                                body, recv_arg_start,
                                                                arg_count + 1, recv_arg_exprs,
                                                                explicit_type_count > 0 ? explicit_type_args : 0,
                                                                explicit_type_count);
                    if (resolved >= 0) {
                        fn_index = resolved;
                        lookup_name = receiver_lookup;
                        final_arg_start = recv_arg_start;
                        final_arg_count = arg_count + 1;
                        for (int32_t ai = 0; ai <= arg_count; ai++)
                            final_arg_exprs[ai] = recv_arg_exprs[ai];
                    }
                }
            }
        }
    }
    if (fn_index < 0) {
        /* External function, will be registered below */
        { Span ctor_base = {0};
          Span result_type = {0};
          if (cold_result_constructor_type(parser, name, &ctor_base, &result_type)) {
              if (arg_count != 1) die("Result constructor arity mismatch");
              if (span_eq(ctor_base, "Err")) {
                  int32_t slot = cold_make_error_result_slot_from_msg(parser, body, result_type,
                                                                      body->call_arg_slot[arg_start],
                                                                      &arg_results[0],
                                                                      result_out);
                  if (kind_out) *kind_out = SLOT_OBJECT;
                  return slot;
              }
              int32_t val = body->call_arg_slot[arg_start];
              return cold_make_ok_result_slot(
                  parser, body, result_type, val,
                  &arg_results[0], kind_out, result_out);
          }
          Span base_name = cold_span_strip_generic_suffix(name);
          Variant *vc = symbols_find_variant(parser->symbols, base_name);
          if (!vc) vc = symbols_find_variant(parser->symbols, name);
          if (!vc) {
              /* qualified name: Type.Variant — split and scan all types */
              int32_t dot = -1;
              for (int32_t i = name.len - 1; i > 0; i--) {
                  if (name.ptr[i] == '.') { dot = i; break; }
              }
              if (dot > 0) {
                  Span tn = span_sub(name, 0, dot);
                  Span vn = span_sub(name, dot + 1, name.len);
                  for (int32_t ti = 0; ti < parser->symbols->type_count; ti++) {
                      TypeDef *ty = &parser->symbols->types[ti];
                      if (span_same(ty->name, tn)) {
                          vc = type_find_variant(ty, vn);
                          if (vc) break;
                      }
                  }
              }
          }
          if (!vc) {
              /* const-based lookup: Type.Variant registered as const = tag */
              ConstDef *cst = symbols_find_const(parser->symbols, name);
              if (cst) {
                  int32_t tag = 0;
                  if (!cold_const_i32_value(cst, &tag))
                      die("cold variant tag const must be int32");
                  for (int32_t ti = 0; ti < parser->symbols->type_count; ti++) {
                      TypeDef *ty = &parser->symbols->types[ti];
                      for (int32_t vi = 0; vi < ty->variant_count; vi++) {
                          if (ty->variants[vi].tag == tag &&
                              ty->variants[vi].field_count == arg_count) {
                              vc = &ty->variants[vi];
                              break;
                          }
                      }
                      if (vc) break;
                  }
              }
          }
          if (vc) {
              *kind_out = SLOT_VARIANT;
              /* args already consumed; fill offsets from variant layout */
              for (int32_t ai = 0; ai < arg_count && ai < vc->field_count; ai++) {
                  body->call_arg_offset[arg_start + ai] = vc->field_offset[ai];
              }
              int32_t vz = symbols_variant_slot_size(parser->symbols, vc);
              int32_t sl = body_slot(body, SLOT_VARIANT, vz);
              body_op3(body, BODY_OP_MAKE_VARIANT, sl, vc->tag, arg_start, arg_count);
              return sl;
          }
        }
        /* Resolve against modules explicitly imported by the current source.
           #124 r2 root fix: Tier 1 -- this specific module's own direct
           import list only, tried FIRST via the exact-first union-scan
           resolver (cold_resolve_call_tier_exact_first above), exactly
           mirroring the established two-tier bare-TYPE-name idiom
           (parser_scope_import_bare_type_name, #109/#118/#120). Falls
           through unchanged to Tier 2 (whole-program transitive closure)
           when Tier 1 contributes zero candidates. */
        if (parser->own_import_source_count > 0 && parser->own_import_sources) {
            Span resolved_name = {0};
            int32_t resolved = cold_resolve_call_tier_exact_first(parser->symbols, parser->arena,
                parser->own_import_sources, parser->own_import_source_count, stripped_name,
                body, arg_start, arg_count, arg_exprs,
                explicit_type_count > 0 ? explicit_type_args : 0, explicit_type_count, &resolved_name);
            if (resolved >= 0) {
                fn_index = resolved;
                lookup_name = resolved_name;
            }
        }
        /* Tier 2: whole-program transitive closure (pre-existing scope,
           unchanged) -- covers names reached only via a deeper transitive
           import chain that the current file does not declare directly. */
        if (fn_index < 0 && parser->import_source_count > 0 && parser->import_sources) {
            Span resolved_name = {0};
            int32_t resolved = cold_resolve_call_tier_exact_first(parser->symbols, parser->arena,
                parser->import_sources, parser->import_source_count, stripped_name,
                body, arg_start, arg_count, arg_exprs,
                explicit_type_count > 0 ? explicit_type_args : 0, explicit_type_count, &resolved_name);
            if (resolved >= 0) {
                fn_index = resolved;
                lookup_name = resolved_name;
            }
        }
    }
    if (fn_index < 0) {
        /* Last chance: enum type constructor like PathComponent(n) */
        {
            TypeDef *enum_ty = symbols_find_type(parser->symbols, stripped_name);
            /* In import mode, stripped_name is the bare name (e.g. "PathComponent")
               but the type is registered under the scoped name (e.g. "os.PathComponent").
               Try lookup_name which was scoped by parser_scoped_bare_name. */
            if (!enum_ty && !span_same(stripped_name, lookup_name))
                enum_ty = symbols_find_type(parser->symbols, lookup_name);
            if (!enum_ty) {
                int32_t dot = -1;
                for (int32_t ci = stripped_name.len - 1; ci > 0; ci--)
                    if (stripped_name.ptr[ci] == '.') { dot = ci; break; }
                if (dot > 0) {
                    Span bare = span_sub(stripped_name, dot + 1, stripped_name.len);
                    enum_ty = symbols_find_type(parser->symbols, bare);
                }
            }
            if (enum_ty && enum_ty->is_enum && arg_count == 1) {
                int32_t arg_slot = body->call_arg_slot[arg_start];
                int32_t arg_kind = body->slot_kind[arg_slot];
                if (arg_kind == SLOT_I32 || arg_kind == SLOT_I32_REF) {
                    int32_t slot = body_slot(body, SLOT_I32, 4);
                    body_op(body, BODY_OP_COPY_I32, slot, arg_slot, 0);
                    if (kind_out) *kind_out = SLOT_I32;
                    return slot;
                }
                /* #125 root fix: an enum constructor called with an int64
                   tag (e.g. RelayMessageType(msgTypeVal) where msgTypeVal
                   was decoded from a protobuf varint field as int64) fell
                   through this arg-kind guard untouched -- it only ever
                   matched SLOT_I32/SLOT_I32_REF -- landing back in the
                   caller with fn_index still < 0 and no other resolver
                   claiming the name, so it died as "unresolved function
                   call" even though the enum type itself resolved cleanly.
                   Narrow the same way the general `int32(x)` scalar-identity
                   cast already narrows an int64 source (BODY_OP_I32_FROM_I64,
                   see parse_scalar_identity_cast), reusing
                   cold_materialize_i64_value -- already forward-declared and
                   already called twice more within this same function body
                   -- to ref-load SLOT_I64_REF first. */
                if (arg_kind == SLOT_I64 || arg_kind == SLOT_I64_REF) {
                    int32_t i64_slot = cold_materialize_i64_value(body, arg_slot, &arg_kind);
                    int32_t slot = body_slot(body, SLOT_I32, 4);
                    body_op(body, BODY_OP_I32_FROM_I64, slot, i64_slot, 0);
                    if (kind_out) *kind_out = SLOT_I32;
                    return slot;
                }
            }
        }
        if (fn_index < 0) {
            if (parser->import_mode && ColdStrictImportBodyUnresolvedCalls) {
                ColdStrictImportBodyUnresolvedHit = true;
            }
            fprintf(stderr, "cheng_cold: ");
            cold_error_loc(parser, lookup_name);
            fprintf(stderr, " unresolved function call '%.*s'\n",
                    (int)lookup_name.len, lookup_name.ptr);
            cold_print_context(parser, lookup_name);
            cold_print_same_name_call_candidates(parser->symbols, body, lookup_name,
                                                 arg_start, arg_count);
            die("unresolved function call");
        }
    }
	FnDef *fn = &parser->symbols->functions[fn_index];
    if (final_arg_start == arg_start) {
        for (int32_t i = 0; i < arg_count; i++) {
            cold_bind_parsed_call_arg_authority(
                body, final_arg_start + i,
                &arg_results[i]);
        }
    } else {
        if (final_arg_count != arg_count + 1) {
            die("resolved receiver call argument mapping is invalid");
        }
        Local *receiver_local =
            locals_find(locals, final_arg_exprs[0]);
        ColdExprResult receiver_authority;
        cold_expr_result_reset(&receiver_authority);
        if (receiver_local &&
            receiver_local->value_def_op_id >= 0) {
            (void)cold_exact_result_from_definition(
                body, receiver_local->slot,
                receiver_local->value_def_op_id,
                &receiver_authority);
        }
        cold_bind_parsed_call_arg_authority(
            body, final_arg_start,
            &receiver_authority);
        for (int32_t i = 0; i < arg_count; i++) {
            cold_bind_parsed_call_arg_authority(
                body, final_arg_start + i + 1,
                &arg_results[i]);
        }
    }
    int32_t var_out_local_indices[COLD_MAX_I32_PARAMS];
    int32_t var_out_carrier_ops[COLD_MAX_I32_PARAMS];
    int32_t var_out_root_place_ids[COLD_MAX_I32_PARAMS];
    ColdVarPlaceTable var_place_table;
    memset(&var_place_table, 0, sizeof(var_place_table));
    for (int32_t i = 0; i < COLD_MAX_I32_PARAMS; i++) {
        var_out_local_indices[i] = -1;
        var_out_carrier_ops[i] = -1;
        var_out_root_place_ids[i] = -1;
    }
	cold_validate_explicit_generic_call(parser, fn, explicit_generic_args);
	cold_materialize_specialized_body_if_needed(parser, fn_index);
    fn = &parser->symbols->functions[fn_index];
    if (any_borrowed_conditional_arg) {
        cold_verify_borrowed_conditional_call_args(
            fn, arg_borrowed_conditional, arg_count,
            final_arg_start == arg_start ? 0 : 1);
    }
    cold_materialize_exact_scalar_ref_value_call_args(
        body, parser->symbols, fn,
        final_arg_start, final_arg_count);
    cold_materialize_exact_plain_borrow_value_call_args(
        parser, body, parser->symbols, fn,
        final_arg_start, final_arg_count);
    cold_reject_borrowed_actuals_at_resolved_call_boundary(
        body, parser->symbols, fn_index, fn,
        final_arg_start, final_arg_count);
	cold_reparse_field_call_args_as_refs(
        parser, body, locals, fn,
        final_arg_start, final_arg_count, final_arg_exprs,
        var_out_local_indices, var_out_carrier_ops,
        &var_place_table, var_out_root_place_ids);
    cold_require_resolved_call_args_admitted(
        parser, body, locals,
        final_arg_start, final_arg_count,
        var_out_local_indices);
		cold_apply_contextual_empty_sequence_args(body, parser->symbols, fn, final_arg_start, final_arg_count, false);
		cold_restage_fixed_array_literal_call_args(parser, body, fn, final_arg_start, final_arg_count);
		cold_materialize_global_ref_call_args(body, fn, final_arg_start, final_arg_count);
		cold_materialize_exact_abi_pointer_ref_object_call_args(
		    body, parser->symbols, fn,
		    final_arg_start, final_arg_count);
		cold_materialize_exact_abi_pointer_ref_object_move_call_args(
		    body, parser->symbols, fn,
		    final_arg_start, final_arg_count);
		cold_materialize_exact_abi_pointer_string_call_args(
		    body, parser->symbols, fn,
		    final_arg_start, final_arg_count);
		cold_coerce_jsonnode_args(parser, body, fn, final_arg_start, final_arg_count);
	if (!cold_validate_call_args(parser->symbols, body, fn, final_arg_start, final_arg_count, parser->import_mode)) {
		cold_die_call_arg_mismatch(parser, lookup_name, body, fn, final_arg_start, final_arg_count);
	    }
    if (cold_fn_is_rawbytes_bytes_alloc(fn, lookup_name)) {
        return cold_emit_bytes_alloc_call(
            parser, body, fn, final_arg_start, final_arg_count,
            kind_out, result_out);
    }
    /* Fill in default values for missing trailing params */
    if (final_arg_count < fn->arity) {
        for (int32_t pi = final_arg_count; pi < fn->arity; pi++) {
            if (fn->param_has_default[pi]) {
                int32_t def_slot = cold_make_i32_const_slot(body, fn->param_default_value[pi]);
                body_call_arg(body, def_slot);
            }
        }
        final_arg_count = fn->arity;
    }
    cold_apply_deferred_i32_sequence_args(
        body, parser->symbols, fn,
        final_arg_start, final_arg_count);
    cold_materialize_exact_borrow_call_args(
        body, parser->symbols, fn,
        final_arg_start, final_arg_count);
    int32_t ret_kind =
        cold_function_return_kind(
            parser->symbols, fn);
    int32_t slot = body_slot(
        body, ret_kind,
        cold_function_return_slot_size(
            parser->symbols, fn, ret_kind));
    cold_call_result_slot_set_type(
        body, parser->symbols, slot, ret_kind, fn->ret);
    if (ret_kind == SLOT_STR && cold_fn_returns_writable_str_buffer(fn, lookup_name)) {
        body->slot_no_alias[slot] = 1;
    }
    bool has_composite = (ret_kind != SLOT_I32 && ret_kind != SLOT_I64 &&
                          ret_kind != SLOT_F32 && ret_kind != SLOT_F64 &&
                          ret_kind != SLOT_PTR && ret_kind != SLOT_OPAQUE);
    for (int32_t pi = 0; !has_composite && pi < fn->arity; pi++) {
        if (fn->param_exact_type_id[pi] >= 0) {
            has_composite = true;
            continue;
        }
        if (fn->param_kind[pi] != SLOT_I32 && fn->param_kind[pi] != SLOT_I64 &&
            fn->param_kind[pi] != SLOT_F32 && fn->param_kind[pi] != SLOT_F64 &&
            fn->param_kind[pi] != SLOT_PTR && fn->param_kind[pi] != SLOT_OPAQUE) has_composite = true;
    }
    int32_t call_op = !has_composite
        ? body_op(body, BODY_OP_CALL_I32, slot, fn_index, final_arg_start)
        : body_op3(body, BODY_OP_CALL_COMPOSITE, slot, fn_index,
                   final_arg_start, final_arg_count);
    int32_t temporary_cleanup_sources[
        COLD_MAX_I32_PARAMS];
    int32_t temporary_cleanup_count =
        cold_prepare_exact_call_arg_transfers(
        parser, body, parser->symbols, fn, call_op,
        final_arg_start, final_arg_count,
        temporary_cleanup_sources,
        COLD_MAX_I32_PARAMS);
    cold_finish_exact_call_postlude(
        parser, body, parser->symbols,
        locals, fn, call_op,
        final_arg_start, final_arg_count,
        slot, ret_kind, result_out,
        var_out_local_indices,
        var_out_carrier_ops,
        &var_place_table,
        var_out_root_place_ids,
        temporary_cleanup_sources,
        temporary_cleanup_count);
    if (kind_out) *kind_out = ret_kind;
    return slot;
}

int32_t parse_call_after_name(Parser *parser, BodyIR *body, Locals *locals,
                              Span name, int32_t *kind_out) {
    return cold_parse_call_after_name_exact(
        parser, body, locals, name, kind_out, 0);
}

static int32_t cold_parse_call_from_args_span_exact(
        Parser *owner, BodyIR *body, Locals *locals, Span name, Span args,
        int32_t *kind_out, ColdExprResult *result_out) {
    cold_expr_result_reset(result_out);
    Span stripped_name = name;
    Span explicit_generic_args = {0};
    bool has_explicit_generic = cold_call_name_generic_suffix(name, &stripped_name,
                                                             &explicit_generic_args);
    Span intrinsic_name = has_explicit_generic ? name : stripped_name;
    Span explicit_type_args[COLD_MAX_VARIANT_FIELDS];
    int32_t explicit_type_count = has_explicit_generic
        ? cold_split_top_level_commas(explicit_generic_args, explicit_type_args,
                                      COLD_MAX_VARIANT_FIELDS)
        : 0;
    /* Same call-site canonicalization as parse_call_after_name -- see that
       comment. */
    for (int32_t exi = 0; exi < explicit_type_count; exi++) {
        explicit_type_args[exi] = cold_qualify_explicit_generic_type(owner, explicit_type_args[exi]);
    }
    Span object_slot_type = {0};
    ObjectDef *object = parser_resolve_object_constructor(owner, name,
                                                          &object_slot_type);
    if (object && !object->is_ref) {
        if (!owner->arena) die("object constructor call requires parser arena");
        int32_t synthetic_len = args.len + 2;
        char *synthetic = arena_alloc(owner->arena, (size_t)synthetic_len + 1);
        synthetic[0] = '(';
        if (args.len > 0) memcpy(synthetic + 1, args.ptr, (size_t)args.len);
        synthetic[synthetic_len - 1] = ')';
        synthetic[synthetic_len] = '\0';
        Parser ctor_parser = owner->symbols
            ? cold_parser_issue_legacy_span(
                owner->symbols,
                (Span){(const uint8_t *)synthetic, synthetic_len})
            : cold_parser_issue_lexical_span(
                owner->arena,
                (Span){(const uint8_t *)synthetic, synthetic_len});
        ctor_parser.import_mode = owner->import_mode;
        ctor_parser.import_alias = owner->import_alias;
        if (parser_next_is_object_constructor(&ctor_parser)) {
            int32_t slot = parse_object_constructor_typed(&ctor_parser, body,
                                                          locals, object,
                                                          object_slot_type);
            parser_ws(&ctor_parser);
            if (ctor_parser.pos != ctor_parser.source.len)
                die("object constructor call has trailing tokens");
            if (kind_out) *kind_out = SLOT_OBJECT;
            return slot;
        }
    }
    Parser arg_parser = parser_child(owner, args);
    int32_t arg_slots[COLD_MAX_I32_PARAMS];
    Span arg_exprs[COLD_MAX_I32_PARAMS];
    ColdExprResult arg_results[COLD_MAX_I32_PARAMS];
    int32_t arg_count = 0;
    parser_ws(&arg_parser);
    while (arg_parser.pos < arg_parser.source.len) {
        if (arg_count >= COLD_MAX_I32_PARAMS) die("too many cold call args");
        parser_ws(&arg_parser);
        int32_t arg_expr_start = arg_parser.pos;
        int32_t arg_kind = SLOT_I32;
        cold_expr_result_reset(&arg_results[arg_count]);
        bool saved_provisional_call_arg =
            arg_parser.provisional_uninitialized_call_arg;
        int32_t saved_provisional_call_arg_start =
            arg_parser.provisional_uninitialized_call_arg_start;
        arg_parser.provisional_uninitialized_call_arg = true;
        arg_parser.provisional_uninitialized_call_arg_start =
            arg_expr_start;
        int32_t arg_slot = cold_parse_expr_with_result(
            &arg_parser, body, locals, &arg_kind,
            &arg_results[arg_count]);
        arg_parser.provisional_uninitialized_call_arg =
            saved_provisional_call_arg;
        arg_parser.provisional_uninitialized_call_arg_start =
            saved_provisional_call_arg_start;
        int32_t arg_expr_end = arg_parser.pos;
        parser_adopt_expr_resume(owner, &arg_parser);
        if (arg_kind != SLOT_I32 && arg_kind != SLOT_I64 &&
            arg_kind != SLOT_F32 && arg_kind != SLOT_F64 &&
            arg_kind != SLOT_I32_REF && arg_kind != SLOT_I64_REF &&
            arg_kind != SLOT_STR && arg_kind != SLOT_STR_REF &&
            arg_kind != SLOT_VARIANT &&
            arg_kind != SLOT_OBJECT && arg_kind != SLOT_ARRAY_I32 &&
            arg_kind != SLOT_SEQ_I32 && arg_kind != SLOT_SEQ_I32_REF &&
            arg_kind != SLOT_SEQ_STR && arg_kind != SLOT_SEQ_STR_REF &&
            arg_kind != SLOT_SEQ_OPAQUE && arg_kind != SLOT_SEQ_OPAQUE_REF &&
            arg_kind != SLOT_OBJECT_REF &&
            arg_kind != SLOT_PTR &&
            arg_kind != SLOT_OPAQUE && arg_kind != SLOT_OPAQUE_REF) die("unsupported cold function call arg kind");
        arg_exprs[arg_count] = span_trim(span_sub(arg_parser.source, arg_expr_start, arg_expr_end));
        arg_slots[arg_count++] = arg_slot;
        if (span_eq(parser_peek(&arg_parser), ",")) (void)parser_token(&arg_parser);
        else break;
        parser_ws(&arg_parser);
    }
    parser_ws(&arg_parser);
    if (arg_parser.pos != arg_parser.source.len) die("unsupported call arg tokens");
    int32_t arg_start = body->call_arg_count;
    for (int32_t i = 0; i < arg_count; i++) {
        int32_t row = body_call_arg(body, arg_slots[i]);
        cold_bind_parsed_call_arg_authority(
            body, row, &arg_results[i]);
    }
    int32_t intrinsic_slot = -1;
    if (cold_try_elemsize_intrinsic(owner, body, stripped_name, has_explicit_generic,
                                    explicit_generic_args, arg_count,
                                    &intrinsic_slot, kind_out)) {
        return intrinsic_slot;
    }
    { Span ctor_base = {0};
      Span result_type = {0};
      if (cold_result_constructor_type(owner, name, &ctor_base, &result_type)) {
          if (span_eq(ctor_base, "ErrCode")) {
              if (arg_count != 2) die("ErrCode constructor arity mismatch");
              int32_t slot = cold_make_error_result_slot_from_code_msg(owner, body, result_type,
                                                                       body->call_arg_slot[arg_start],
                                                                       body->call_arg_slot[arg_start + 1],
                                                                       &arg_results[1],
                                                                       result_out);
              if (kind_out) *kind_out = SLOT_OBJECT;
              return slot;
          }
          if (arg_count != 1) die("Result constructor arity mismatch");
          if (span_eq(ctor_base, "Err")) {
              int32_t slot = cold_make_error_result_slot_from_msg(owner, body, result_type,
                                                                  body->call_arg_slot[arg_start],
                                                                  &arg_results[0],
                                                                  result_out);
              if (kind_out) *kind_out = SLOT_OBJECT;
              return slot;
          }
          int32_t val = body->call_arg_slot[arg_start];
          return cold_make_ok_result_slot(
              owner, body, result_type, val,
              &arg_results[0], kind_out, result_out);
      }
    }
    if (cold_try_ref_object_cast(owner, body, intrinsic_name, arg_start, arg_count,
                                 &intrinsic_slot, kind_out, result_out)) {
        return intrinsic_slot;
    }
    if (cold_try_type_alias_scalar_cast(
            owner, body, intrinsic_name,
            arg_start, arg_count,
            &intrinsic_slot, kind_out)) {
        return intrinsic_slot;
    }
    if (cold_try_type_alias_pointer_cast(owner, body, intrinsic_name, arg_start, arg_count,
                                         &intrinsic_slot, kind_out)) {
        return intrinsic_slot;
    }
    if (cold_try_type_alias_seq_constructor(owner, body, intrinsic_name, arg_start, arg_count,
                                            &intrinsic_slot, kind_out)) {
        return intrinsic_slot;
    }
    if (cold_try_str_len_intrinsic(body, intrinsic_name, arg_start, arg_count,
                                   arg_results,
                                   &intrinsic_slot, kind_out)) {
        cold_drop_exact_readonly_intrinsic_temporary_args(
            owner, body, arg_results, arg_count);
        return intrinsic_slot;
    }
    if (cold_try_str_slice_intrinsic(body, owner->symbols, intrinsic_name, arg_start, arg_count,
                                     arg_results,
                                     &intrinsic_slot, kind_out, result_out)) {
        cold_drop_exact_readonly_intrinsic_temporary_args(
            owner, body, arg_results, arg_count);
        return intrinsic_slot;
    }
    if (cold_is_i32_to_str_intrinsic(intrinsic_name)) {
        if (arg_count != 1) die("int to str intrinsic arity mismatch");
        int32_t arg_slot = body->call_arg_slot[arg_start];
        if (body->slot_kind[arg_slot] != SLOT_I32) {
            if (ColdErrorRecoveryEnabled) {
                int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
                if (kind_out) *kind_out = SLOT_STR;
                return slot;
            }
            die("int to str intrinsic expects int32");
        }
        int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
        int32_t producer =
            body_op(body, BODY_OP_I32_TO_STR, slot, arg_slot, 0);
        cold_publish_owned_managed_producer(
            body, owner->symbols, slot, SLOT_STR, producer, result_out);
        if (kind_out) *kind_out = SLOT_STR;
        return slot;
    }
    if (cold_try_parse_int_intrinsic(body, intrinsic_name, arg_start, arg_count,
                                     arg_results,
                                     &intrinsic_slot, kind_out)) {
        cold_drop_exact_readonly_intrinsic_temporary_args(
            owner, body, arg_results, arg_count);
        return intrinsic_slot;
    }
    if (cold_try_str_concat_intrinsic(body, owner->symbols, intrinsic_name, arg_start, arg_count,
                                      arg_results,
                                      &intrinsic_slot, kind_out, result_out)) {
        cold_drop_exact_readonly_intrinsic_temporary_args(
            owner, body, arg_results, arg_count);
        return intrinsic_slot;
    }
    if (cold_try_str_join_intrinsic(body, owner->symbols, intrinsic_name, arg_start, arg_count,
                                    arg_results,
                                    &intrinsic_slot, kind_out, result_out)) {
        cold_drop_exact_readonly_intrinsic_temporary_args(
            owner, body, arg_results, arg_count);
        return intrinsic_slot;
    }
    if (cold_try_str_split_intrinsic(body, owner->symbols, intrinsic_name, arg_start, arg_count,
                                     arg_results,
                                     &intrinsic_slot, kind_out, result_out)) {
        cold_drop_exact_readonly_intrinsic_temporary_args(
            owner, body, arg_results, arg_count);
        return intrinsic_slot;
    }
    if (cold_try_str_strip_intrinsic(body, owner->symbols, intrinsic_name, arg_start, arg_count,
                                     arg_results,
                                     &intrinsic_slot, kind_out, result_out)) {
        cold_drop_exact_readonly_intrinsic_temporary_args(
            owner, body, arg_results, arg_count);
        return intrinsic_slot;
    }
    if (cold_try_result_intrinsic(
            owner, body, intrinsic_name, arg_start, arg_count,
            arg_results, &intrinsic_slot, kind_out, result_out)) {
        return intrinsic_slot;
    }
    if (cold_try_os_intrinsic(owner, body, locals, intrinsic_name, arg_start, arg_count,
                              arg_results,
                              &intrinsic_slot, kind_out, result_out)) {
        return intrinsic_slot;
    }
    if (cold_try_path_intrinsic(owner, body, intrinsic_name, arg_start, arg_count,
                                arg_results,
                                &intrinsic_slot, kind_out, result_out)) {
        return intrinsic_slot;
    }
    if (cold_try_csg_intrinsic(owner, body, intrinsic_name, arg_start, arg_count,
                               &intrinsic_slot, kind_out, result_out)) {
        return intrinsic_slot;
    }
    if (cold_try_slplan_intrinsic(owner, body, intrinsic_name, arg_start, arg_count,
                                  &intrinsic_slot, kind_out, result_out)) {
        return intrinsic_slot;
    }
    if (span_eq(intrinsic_name, "atomicLoadI32")) {
        if (arg_count != 1) die("atomicLoadI32 expects 1 arg");
        int32_t ptr = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_ATOMIC_LOAD_I32, slot, ptr, 0);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    if (span_eq(intrinsic_name, "atomicStoreI32")) {
        if (arg_count != 2) die("atomicStoreI32 expects 2 args");
        int32_t ptr = body->call_arg_slot[arg_start];
        int32_t val = body->call_arg_slot[arg_start + 1];
        body_op(body, BODY_OP_ATOMIC_STORE_I32, ptr, val, 0);
        if (kind_out) *kind_out = SLOT_I32;
        return cold_make_i32_const_slot(body, 0);
    }
    if (span_eq(intrinsic_name, "atomicCasI32")) {
        if (arg_count != 3) die("atomicCasI32 arity mismatch");
        int32_t ptr = body->call_arg_slot[arg_start];
        int32_t expect = body->call_arg_slot[arg_start + 1];
        int32_t desired = body->call_arg_slot[arg_start + 2];
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_ATOMIC_CAS_I32, slot, ptr, desired, expect);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    if (span_eq(intrinsic_name, "ptr")) {
        if (arg_count != 1) die("ptr() expects 1 arg");
        int32_t src = body->call_arg_slot[arg_start];
        int32_t src_kind = body->slot_kind[src];
        int32_t slot = cold_materialize_ptr_value(body, src, &src_kind);
        if (kind_out) *kind_out = SLOT_PTR;
        return cold_stamp_generic_ptr_value(body, slot);
    }
    if (cold_try_backend_intrinsic(owner, body, intrinsic_name, arg_start, arg_count,
                                   &intrinsic_slot, kind_out)) {
        return intrinsic_slot;
    }
    if (cold_try_assert_intrinsic(body, intrinsic_name, arg_start, arg_count,
                                  arg_results,
                                  &intrinsic_slot, kind_out)) {
        return intrinsic_slot;
    }
    if (cold_try_bootstrap_intrinsic(body, intrinsic_name, arg_start, arg_count,
                                     &intrinsic_slot, kind_out,
                                     result_out)) {
        return intrinsic_slot;
    }
    /* closure_new / closure_call intrinsics */
    if (span_eq(name, "closure_new") || span_eq(name, "closureNew")) {
        if (arg_count != 2) die("closure_new arity mismatch");
        int32_t fn_slot = body->call_arg_slot[arg_start];
        int32_t env_slot = body->call_arg_slot[arg_start + 1];
        int32_t slot = body_slot(body, SLOT_OPAQUE, 16);
        body_op(body, BODY_OP_CLOSURE_NEW, slot, fn_slot, env_slot);
        if (kind_out) *kind_out = SLOT_OPAQUE;
        return slot;
    }
    if (span_eq(name, "closure_call") || span_eq(name, "closureCall")) {
        if (arg_count < 1) die("closure_call arity mismatch");
        int32_t closure_slot = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_CLOSURE_CALL, slot, closure_slot,
                 arg_start + 1, arg_count - 1);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    if (span_eq(name, "cheng_call_ptr_void_raw")) {
        if (arg_count != 2) die("cheng_call_ptr_void_raw arity mismatch");
        int32_t fn_slot = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_CALL_PTR, slot, fn_slot, arg_start + 1, 1);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    if (span_eq(name, "cheng_call_ptr_i32_raw")) {
        if (arg_count != 4) die("cheng_call_ptr_i32_raw arity mismatch");
        int32_t fn_slot = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_CALL_PTR, slot, fn_slot, arg_start + 1, 3);
        if (kind_out) *kind_out = SLOT_I32;
        return slot;
    }
    if (span_eq(name, "closure_env") || span_eq(name, "closureEnv")) {
        if (arg_count != 1) die("closure_env arity mismatch");
        int32_t closure_slot = body->call_arg_slot[arg_start];
        int32_t slot = body_slot(body, SLOT_PTR, 8);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, slot, closure_slot, 8, 8);
        if (kind_out) *kind_out = SLOT_PTR;
        return slot;
    }
    Span lookup_name = parser_can_scope_bare_name(owner, stripped_name)
                           ? parser_scoped_bare_name(owner, stripped_name)
                           : stripped_name;
    int32_t fn_index = symbols_find_fn_for_call(owner->symbols, lookup_name, body, arg_start, arg_count,
                                                arg_exprs, explicit_type_count > 0 ? explicit_type_args : 0,
                                                explicit_type_count);
    if (fn_index < 0) {
        /* Check for indirect call via local variable (function pointer) */
        Local *indirect_local = locals_find(locals, name);
        if (indirect_local &&
            (indirect_local->kind == SLOT_PTR || indirect_local->kind == SLOT_OPAQUE)) {
            Span fn_ret = {0};
            int32_t ptr_ret_kind = SLOT_I32;
            int32_t ptr_ret_size = 4;
            if (cold_fn_value_signature(owner->symbols,
                                        body->slot_type[indirect_local->slot], &fn_ret)) {
                ptr_ret_kind =
                    parser_slot_kind_from_type(
                        owner, fn_ret);
                ptr_ret_size =
                    parser_slot_size_from_type(
                        owner, fn_ret,
                        ptr_ret_kind);
            }
            int32_t slot = body_slot(body, ptr_ret_kind, ptr_ret_size);
            if (ptr_ret_kind != SLOT_I32)
                cold_call_result_slot_set_type(
                    body, owner->symbols, slot,
                    ptr_ret_kind, fn_ret);
            int32_t call_op = body_op3(body, BODY_OP_CALL_PTR,
                                       slot, indirect_local->slot,
                                       arg_start, arg_count);
            cold_bind_call_ptr_arg_authorities(
                body, arg_start, arg_count, arg_results);
            if (cold_exact_storage_authority_for_slot(
                    owner->symbols, body, slot, ptr_ret_kind) !=
                    COLD_MANAGED_STORAGE_UNKNOWN) {
                cold_publish_exact_managed_definition(
                    body, owner->symbols, slot,
                    ptr_ret_kind, call_op, COLD_EXPR_OWN_MOVE, 0);
            }
            if (kind_out) *kind_out = ptr_ret_kind;
            return slot;
        }
        int32_t field_call_slot = -1;
        if (cold_try_field_function_pointer_call(owner, body, locals, name,
                                                 arg_start, arg_count,
                                                 &field_call_slot, kind_out)) {
            return field_call_slot;
        }
    }
    if (fn_index < 0) {
        /* Resolve against modules explicitly imported by the current source.
           #124 r2 root fix: Tier 1 own-imports-first via the exact-first
           union-scan resolver, mirroring parse_call_after_name's identical
           fix above -- see cold_resolve_call_tier_exact_first's header
           comment for the full rationale. */
        if (owner->own_import_source_count > 0 && owner->own_import_sources) {
            Span resolved_name = {0};
            int32_t resolved = cold_resolve_call_tier_exact_first(owner->symbols, owner->arena,
                owner->own_import_sources, owner->own_import_source_count, stripped_name,
                body, arg_start, arg_count, arg_exprs,
                explicit_type_count > 0 ? explicit_type_args : 0, explicit_type_count, &resolved_name);
            if (resolved >= 0) {
                fn_index = resolved;
                lookup_name = resolved_name;
            }
        }
        /* Tier 2: whole-program transitive closure (pre-existing scope,
           unchanged). */
        if (fn_index < 0 && owner->import_source_count > 0 && owner->import_sources) {
            Span resolved_name = {0};
            int32_t resolved = cold_resolve_call_tier_exact_first(owner->symbols, owner->arena,
                owner->import_sources, owner->import_source_count, stripped_name,
                body, arg_start, arg_count, arg_exprs,
                explicit_type_count > 0 ? explicit_type_args : 0, explicit_type_count, &resolved_name);
            if (resolved >= 0) {
                fn_index = resolved;
                lookup_name = resolved_name;
            }
        }
    }
    if (fn_index < 0) {
        if (fn_index < 0) {
            if (owner->import_mode && ColdStrictImportBodyUnresolvedCalls) {
                ColdStrictImportBodyUnresolvedHit = true;
            }
            fprintf(stderr, "cheng_cold: ");
            cold_error_loc(owner, lookup_name);
            fprintf(stderr, " unresolved function call '%.*s'\n",
                    (int)lookup_name.len, lookup_name.ptr);
            cold_print_context(owner, lookup_name);
            cold_print_same_name_call_candidates(owner->symbols, body, lookup_name,
                                                 arg_start, arg_count);
            die("unresolved function call");
        }
    }
	FnDef *fn = &owner->symbols->functions[fn_index];
    for (int32_t i = 0;
         i < arg_count; i++) {
        cold_bind_parsed_call_arg_authority(
            body, arg_start + i,
            &arg_results[i]);
    }
    int32_t var_out_local_indices[COLD_MAX_I32_PARAMS];
    int32_t var_out_carrier_ops[COLD_MAX_I32_PARAMS];
    int32_t var_out_root_place_ids[COLD_MAX_I32_PARAMS];
    ColdVarPlaceTable var_place_table;
    memset(&var_place_table, 0, sizeof(var_place_table));
    for (int32_t i = 0; i < COLD_MAX_I32_PARAMS; i++) {
        var_out_local_indices[i] = -1;
        var_out_carrier_ops[i] = -1;
        var_out_root_place_ids[i] = -1;
    }
	cold_validate_explicit_generic_call(owner, fn, explicit_generic_args);
	cold_materialize_specialized_body_if_needed(owner, fn_index);
    fn = &owner->symbols->functions[fn_index];
    cold_materialize_exact_scalar_ref_value_call_args(
        body, owner->symbols, fn,
        arg_start, arg_count);
    cold_materialize_exact_plain_borrow_value_call_args(
        owner, body, owner->symbols, fn,
        arg_start, arg_count);
    cold_reject_borrowed_actuals_at_resolved_call_boundary(
        body, owner->symbols, fn_index, fn,
        arg_start, arg_count);
	cold_reparse_field_call_args_as_refs(
        owner, body, locals, fn,
        arg_start, arg_count, arg_exprs,
        var_out_local_indices, var_out_carrier_ops,
        &var_place_table, var_out_root_place_ids);
    cold_require_resolved_call_args_admitted(
        owner, body, locals,
        arg_start, arg_count,
        var_out_local_indices);
		cold_apply_contextual_empty_sequence_args(body, owner->symbols, fn, arg_start, arg_count, false);
		cold_restage_fixed_array_literal_call_args(owner, body, fn, arg_start, arg_count);
		cold_materialize_global_ref_call_args(body, fn, arg_start, arg_count);
		cold_materialize_exact_abi_pointer_ref_object_call_args(
		    body, owner->symbols, fn, arg_start, arg_count);
		cold_materialize_exact_abi_pointer_ref_object_move_call_args(
		    body, owner->symbols, fn, arg_start, arg_count);
		cold_materialize_exact_abi_pointer_string_call_args(
		    body, owner->symbols, fn, arg_start, arg_count);
		if (!cold_validate_call_args(owner->symbols, body, fn, arg_start, arg_count, owner->import_mode)) {
		cold_die_call_arg_mismatch(owner, lookup_name, body, fn, arg_start, arg_count);
	    }
    if (cold_fn_is_rawbytes_bytes_alloc(fn, lookup_name)) {
        return cold_emit_bytes_alloc_call(
            owner, body, fn, arg_start, arg_count,
            kind_out, result_out);
    }
    /* Fill in default values for missing trailing params */
    if (arg_count < fn->arity) {
        for (int32_t pi = arg_count; pi < fn->arity; pi++) {
            if (fn->param_has_default[pi]) {
                int32_t def_slot = cold_make_i32_const_slot(body, fn->param_default_value[pi]);
                body_call_arg(body, def_slot);
            }
        }
        arg_count = fn->arity;
    }
    cold_apply_deferred_i32_sequence_args(
        body, owner->symbols, fn,
        arg_start, arg_count);
    cold_materialize_exact_borrow_call_args(
        body, owner->symbols, fn,
        arg_start, arg_count);
    int32_t ret_kind =
        cold_function_return_kind(
            owner->symbols, fn);
    int32_t slot = body_slot(
        body, ret_kind,
        cold_function_return_slot_size(
            owner->symbols, fn, ret_kind));
    cold_call_result_slot_set_type(
        body, owner->symbols, slot, ret_kind, fn->ret);
    bool has_composite = (ret_kind != SLOT_I32 && ret_kind != SLOT_I64 &&
                          ret_kind != SLOT_F32 && ret_kind != SLOT_F64 &&
                          ret_kind != SLOT_PTR && ret_kind != SLOT_OPAQUE);
    for (int32_t pi = 0; !has_composite && pi < fn->arity; pi++) {
        if (fn->param_exact_type_id[pi] >= 0) {
            has_composite = true;
            continue;
        }
        if (fn->param_kind[pi] != SLOT_I32 && fn->param_kind[pi] != SLOT_I64 &&
            fn->param_kind[pi] != SLOT_F32 && fn->param_kind[pi] != SLOT_F64 &&
            fn->param_kind[pi] != SLOT_PTR && fn->param_kind[pi] != SLOT_OPAQUE) has_composite = true;
    }
    int32_t call_op = !has_composite
        ? body_op(body, BODY_OP_CALL_I32, slot, fn_index, arg_start)
        : body_op3(body, BODY_OP_CALL_COMPOSITE, slot, fn_index, arg_start,
                   arg_count);
    int32_t temporary_cleanup_sources[
        COLD_MAX_I32_PARAMS];
    int32_t temporary_cleanup_count =
        cold_prepare_exact_call_arg_transfers(
        owner, body, owner->symbols, fn, call_op,
        arg_start, arg_count,
        temporary_cleanup_sources,
        COLD_MAX_I32_PARAMS);
    cold_finish_exact_call_postlude(
        owner, body, owner->symbols,
        locals, fn, call_op,
        arg_start, arg_count,
        slot, ret_kind, result_out,
        var_out_local_indices,
        var_out_carrier_ops,
        &var_place_table,
        var_out_root_place_ids,
        temporary_cleanup_sources,
        temporary_cleanup_count);
    if (kind_out) *kind_out = ret_kind;
    return slot;
}

int32_t parse_call_from_args_span(Parser *owner, BodyIR *body, Locals *locals,
                                  Span name, Span args,
                                  int32_t *kind_out) {
    return cold_parse_call_from_args_span_exact(
        owner, body, locals, name, args, kind_out, 0);
}

int32_t parse_constructor(Parser *parser, BodyIR *body, Locals *locals,
                                 Variant *variant) {
    int32_t payload_count = 0;
    int32_t payload_slots[COLD_MAX_VARIANT_FIELDS];
    int32_t payload_offsets[COLD_MAX_VARIANT_FIELDS];
    ColdExprResult payload_results[COLD_MAX_VARIANT_FIELDS];
    if (span_eq(parser_peek(parser), "(")) {
        parser_take(parser, "(");
        while (!span_eq(parser_peek(parser), ")")) {
            if (payload_count >= COLD_MAX_VARIANT_FIELDS) die("too many cold variant payload fields");
            if (payload_count >= variant->field_count) break; /* too many args */
            int32_t payload_kind = SLOT_I32;
            cold_expr_result_reset(&payload_results[payload_count]);
            int32_t payload_slot = cold_parse_expr_with_result(
                parser, body, locals, &payload_kind,
                &payload_results[payload_count]);
            if (payload_kind != variant->field_kind[payload_count]) {
                int32_t fk = variant->field_kind[payload_count];
                if (!((fk == SLOT_VARIANT && (payload_kind == SLOT_VARIANT || payload_kind == SLOT_I32 || payload_kind == SLOT_STR)) ||
                      (fk == SLOT_I32 && (payload_kind == SLOT_VARIANT || payload_kind == SLOT_I32 || payload_kind == SLOT_STR)) ||
                      (fk == SLOT_STR && (payload_kind == SLOT_VARIANT || payload_kind == SLOT_I32)))) {
                    die("variant constructor payload kind mismatch");
                }
            }
            if (body->slot_size[payload_slot] != variant->field_size[payload_count]) {
                if (payload_kind == variant->field_kind[payload_count])
                    die("variant constructor payload size mismatch");
            }
            payload_slots[payload_count] = payload_slot;
            payload_offsets[payload_count] = variant->field_offset[payload_count];
            payload_count++;
            if (span_eq(parser_peek(parser), ",")) {
                (void)parser_token(parser);
                continue;
            }
            break;
        }
        if (!parser_take(parser, ")")) return 0; /* skip malformed constructor */
    }
    if (payload_count != variant->field_count) {
        if (variant->field_count > 0) {
            die("variant constructor payload count mismatch");
        } else if (payload_count > 0) {
            die("empty variant cannot take constructor arguments");
        }
    }
    int32_t payload_start = payload_count > 0 ? body->call_arg_count : -1;
    for (int32_t i = 0; i < payload_count; i++) {
        int32_t row = body_call_arg_with_offset(
            body, payload_slots[i], payload_offsets[i]);
        cold_bind_parsed_call_arg_authority(
            body, row, &payload_results[i]);
    }
    int32_t slot = body_slot(body, SLOT_VARIANT, symbols_variant_slot_size(parser->symbols, variant));
    TypeDef *variant_type = symbols_find_variant_type(parser->symbols, variant);
    if (!variant_type) die("variant constructor has no parent type");
    body_slot_set_type(body, slot, variant_type->name);
    body_op3(body, BODY_OP_MAKE_VARIANT, slot, variant->tag, payload_start, payload_count);
    return slot;
}

int32_t body_slot_for_object_field(BodyIR *body, ObjectField *field) {
    int32_t slot = body_slot(body, field->kind, cold_value_slot_size_for_payload_field(field));
    body_slot_set_type(body, slot, field->type_name);
    if (field->kind == SLOT_ARRAY_I32) body_slot_set_array_len(body, slot, field->array_len);
    return slot;
}

bool parser_next_is_object_constructor(Parser *parser) {
    Span open_tok = parser_peek(parser);
    if (span_eq(open_tok, "{")) return true;
    if (!span_eq(open_tok, "(")) return false;

    Parser probe = *parser;
    (void)parser_token(&probe);
    Span first = parser_peek(&probe);
    if (span_eq(first, ")")) return true;
    if (first.len <= 0) return false;
    (void)parser_token(&probe);
    return span_eq(parser_peek(&probe), ":");
}

/* `nil` has no nominal identity until its assignment target is known.  A
   declared `ref object` field is represented by one pointer-width payload,
   but its ObjectDef TypeId—not the physical `ptr` spelling—is the authority.
   Contextualize only the parser-owned canonical zero producer before the
   common field-layout check; arbitrary pointers never enter this path. */
static bool cold_contextualize_exact_ref_object_field_nil(
        BodyIR *body, Symbols *symbols, ObjectField *field,
        ColdExprResult *source) {
    if (!body || !symbols || !field || !source ||
        field->kind != SLOT_PTR || field->size != 8 ||
        source->slot < 0 || source->slot >= body->slot_count ||
        source->kind != SLOT_PTR ||
        source->value_def_op_id < 0 ||
        source->value_def_op_id >= body->op_count ||
        source->exact_type_id != -1 ||
        source->producer_function_row != body->producer_function_row ||
        source->place_kind != COLD_EXPR_PLACE_TEMPORARY ||
        source->ownership != COLD_EXPR_OWN_INVALID ||
        source->origin_id != source->value_def_op_id) {
        return false;
    }
    int32_t producer = source->value_def_op_id;
    if (body->op_kind[producer] != BODY_OP_PTR_CONST ||
        body->op_dst[producer] != source->slot ||
        body->op_a[producer] != 0 ||
        body->slot_kind[source->slot] != SLOT_PTR ||
        body->slot_size[source->slot] != 8 ||
        !cold_exact_op_tuple_is_sentinel(body, producer) ||
        !cold_exact_slot_authority_is_sentinel(body, source->slot)) {
        return false;
    }
    Span field_type = span_trim(cold_type_strip_var(
        field->type_name, 0));
    ObjectDef *field_object =
        field_type.len > 0
            ? symbols_resolve_object(symbols, field_type)
            : 0;
    if (!field_object || !field_object->is_ref ||
        field_object < symbols->objects ||
        field_object >= symbols->objects + symbols->object_count) {
        return false;
    }
    body_slot_set_type(body, source->slot, field_object->name);
    ColdExprResult typed_nil;
    cold_expr_result_reset(&typed_nil);
    cold_publish_exact_managed_definition(
        body, symbols, source->slot, SLOT_PTR,
        producer, COLD_EXPR_OWN_MOVE, &typed_nil);
    int32_t expected_type_id = cold_exact_managed_type_id(
        symbols, body, source->slot, SLOT_PTR);
    if (expected_type_id < 0 ||
        typed_nil.exact_type_id != expected_type_id ||
        typed_nil.origin_id != producer) {
        die("ref object field nil TypeId is not exact");
    }
    *source = typed_nil;
    return true;
}

int32_t cold_coerce_object_field_value(Parser *parser, BodyIR *body,
                                       ObjectField *field,
                                       int32_t value_slot,
                                       int32_t *value_kind,
                                       ColdExprResult *value_result) {
    if (value_result &&
        cold_contextualize_exact_ref_object_field_nil(
            body, parser->symbols, field, value_result)) {
        value_slot = value_result->slot;
        *value_kind = value_result->kind;
    }
    (void)cold_contextualize_empty_sequence_for_field(
        body, parser->symbols, field, value_slot, value_kind,
        value_result);
    if ((field->kind == SLOT_SEQ_I32 || field->kind == SLOT_SEQ_I32_REF) &&
        *value_kind == SLOT_ARRAY_I32) {
        value_slot =
            cold_materialize_exact_i32_sequence_literal(
                body, parser->symbols, value_slot,
                field->type_name.len > 0
                    ? field->type_name
                    : cold_cstr_span("int32[]"),
                value_kind, value_result);
    }
    if (field->kind == SLOT_ARRAY_I32 &&
        *value_kind == SLOT_ARRAY_I32 &&
        field->type_name.len > 0) {
        /* Fixed-array field: re-stage a plain int32-element literal onto
           the field's declared element width/identity before the layout
           and type-identity checks below run. */
        value_slot =
            cold_restage_fixed_array_literal_for_declared_element(
                parser, body, value_slot, field->type_name,
                value_kind, value_result);
    }
    if (field->kind == SLOT_SEQ_OPAQUE &&
        field->type_name.len > 0 &&
        (*value_kind == SLOT_ARRAY_I32 ||
         *value_kind == SLOT_SEQ_OPAQUE)) {
        /* Opaque-sequence field: contextualize the provisional literal
           staging onto the field's declared sequence identity
           (station-2 contextual typing family). */
        int32_t converted =
            cold_contextualize_opaque_seq_literal_for_declared(
                parser, body, parser->symbols, value_slot,
                *value_kind, field->type_name, value_kind,
                value_result);
        if (converted != value_slot) value_slot = converted;
    }
    if (field->kind == SLOT_SEQ_I32 && *value_kind == SLOT_SEQ_I32_REF) {
        int32_t dst = body_slot(body, SLOT_SEQ_I32, 16);
        body_slot_set_type(body, dst,
                           field->type_name.len > 0
                               ? field->type_name
                               : body->slot_type[value_slot]);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, dst, value_slot, 0, 16);
        value_slot = dst;
        *value_kind = SLOT_SEQ_I32;
    }
    if (field->kind == SLOT_SEQ_STR && *value_kind == SLOT_SEQ_STR_REF) {
        int32_t dst = body_slot(body, SLOT_SEQ_STR, 16);
        body_slot_set_type(body, dst,
                           field->type_name.len > 0
                               ? field->type_name
                               : body->slot_type[value_slot]);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, dst, value_slot, 0, 16);
        value_slot = dst;
        *value_kind = SLOT_SEQ_STR;
    }
    if (field->kind == SLOT_SEQ_OPAQUE && *value_kind == SLOT_SEQ_OPAQUE_REF) {
        int32_t dst = body_slot(body, SLOT_SEQ_OPAQUE, 16);
        body_slot_set_seq_opaque_type(body, parser->symbols, dst,
                                      field->type_name.len > 0
                                          ? field->type_name
                                          : body->slot_type[value_slot]);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, dst, value_slot, 0, 16);
        value_slot = dst;
        *value_kind = SLOT_SEQ_OPAQUE;
    }
    if (field->kind == SLOT_ARRAY_I32 && *value_kind == SLOT_OBJECT_REF) {
        int32_t dst = body_slot(body, SLOT_ARRAY_I32, field->size);
        body_slot_set_type(body, dst, field->type_name);
        body_slot_set_array_len(body, dst, field->array_len);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, dst, value_slot, 0, field->size);
        value_slot = dst;
        *value_kind = SLOT_ARRAY_I32;
    }
    if (field->kind == SLOT_VARIANT && *value_kind == SLOT_OBJECT_REF) {
        int32_t dst = body_slot(body, SLOT_VARIANT, field->size);
        body_slot_set_type(body, dst, field->type_name);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, dst, value_slot, 0, field->size);
        value_slot = dst;
        *value_kind = SLOT_VARIANT;
    }
    if (field->kind == SLOT_SEQ_OPAQUE && *value_kind == SLOT_OBJECT) {
        int32_t payload_start = body->call_arg_count;
        body_call_arg(body, value_slot);
        int32_t dst = body_slot(body, SLOT_SEQ_OPAQUE, 16);
        body_slot_set_seq_opaque_type(body, parser->symbols, dst, field->type_name);
        int32_t element_size = body->slot_aux[dst];
        if (element_size <= 0) element_size = body->slot_size[value_slot];
        body_op3(body, BODY_OP_MAKE_SEQ_OPAQUE, dst,
                 payload_start, element_size, 1);
        value_slot = dst;
        *value_kind = SLOT_SEQ_OPAQUE;
    }
    if (*value_kind == SLOT_VARIANT && field->kind == SLOT_I32) {
        int32_t tag_slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_TAG_LOAD, tag_slot, value_slot, 0);
        value_slot = tag_slot;
        *value_kind = SLOT_I32;
    }
    if (field->kind == SLOT_I32) {
        value_slot = cold_materialize_i32_ref(body, value_slot, value_kind);
    }
    if (field->kind == SLOT_I64 &&
        (*value_kind == SLOT_I32 || *value_kind == SLOT_I64_REF)) {
        value_slot = cold_materialize_i64_value(body, value_slot, value_kind);
    }
    if (*value_kind == SLOT_I64 && field->kind == SLOT_I32) {
        value_slot = cold_materialize_i32_ref(body, value_slot, value_kind);
    }
    if (field->kind == SLOT_STR && *value_kind == SLOT_STR_REF) {
        value_slot = cold_materialize_fmt_str(body, value_slot, *value_kind);
        *value_kind = SLOT_STR;
    }
    return value_slot;
}

static int32_t cold_find_object_type_identity(Symbols *symbols, Span type_name) {
    if (!symbols) return -1;
    type_name = span_trim(type_name);
    for (int32_t object_index = 0; object_index < symbols->object_count; object_index++) {
        if (span_same(symbols->objects[object_index].name, type_name)) return object_index;
    }
    return -1;
}

/* Object identity comes from the physical declaration, never from coincident
   layout. Diamond-import aliases have the same decl_path and tail name; two
   different modules may deliberately declare the same tail name and layout
   and must remain distinct. Locally-created/synthetic entries without a
   decl_path can only alias when their complete registered names are equal.
   Layout is checked after identity solely to detect metadata drift. */
static bool cold_generic_application_owner_same(
        Symbols *symbols, int32_t binder_kind,
        int32_t left_id, int32_t right_id) {
    if (!symbols || left_id < 0 || right_id < 0)
        return false;
    if (binder_kind ==
            COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN) {
        return left_id == right_id &&
               left_id <
                   symbols->declaration_origin_count;
    }
    if (binder_kind ==
            COLD_GENERIC_BINDER_TYPE_ROW) {
        if (left_id >= symbols->type_count ||
            right_id >= symbols->type_count) {
            return false;
        }
        int32_t left_origin =
            symbols->types[left_id].
                declaration_origin_row;
        int32_t right_origin =
            symbols->types[right_id].
                declaration_origin_row;
        return left_origin >= 0 &&
               left_origin == right_origin;
    }
    if (binder_kind ==
            COLD_GENERIC_BINDER_OBJECT_ROW) {
        if (left_id >= symbols->object_count ||
            right_id >= symbols->object_count) {
            return false;
        }
        int32_t left_origin =
            symbols->objects[left_id].
                declaration_origin_row;
        int32_t right_origin =
            symbols->objects[right_id].
                declaration_origin_row;
        return left_origin >= 0 &&
               left_origin == right_origin;
    }
    return false;
}

static bool cold_generic_application_template_same(
        Symbols *symbols, int32_t left_row,
        int32_t right_row) {
    if (!symbols || left_row < 0 || right_row < 0 ||
        left_row >= symbols->object_count ||
        right_row >= symbols->object_count) {
        return false;
    }
    if (left_row == right_row) return true;
    int32_t left_origin =
        symbols->objects[left_row].
            declaration_origin_row;
    int32_t right_origin =
        symbols->objects[right_row].
            declaration_origin_row;
    return left_origin >= 0 &&
           left_origin == right_origin;
}

static bool cold_object_alias_identity_equal(
        Symbols *symbols, ObjectDef *a, ObjectDef *b) {
    if (a == b) return true;
    if (!symbols || !a || !b) return false;
    uint8_t left_cid[32];
    uint8_t right_cid[32];
    if (!cold_object_semantic_owner_cid(
            symbols, a, left_cid) ||
        !cold_object_semantic_owner_cid(
            symbols, b, right_cid) ||
        memcmp(left_cid, right_cid, 32) != 0) {
        return false;
    }
    if (a->field_count != b->field_count ||
        a->slot_size != b->slot_size ||
        a->generic_count != b->generic_count ||
        a->is_ref != b->is_ref ||
        a->inherited_field_count !=
            b->inherited_field_count) {
        die("canonical object identity layout drift");
    }
    for (int32_t fi = 0; fi < a->field_count; fi++) {
        ObjectField *fa = &a->fields[fi];
        ObjectField *fb = &b->fields[fi];
        if (fa->kind != fb->kind ||
            fa->size != fb->size ||
            fa->offset != fb->offset ||
            fa->array_len != fb->array_len ||
            !span_same(fa->name, fb->name)) {
            die("canonical object identity field layout drift");
        }
    }
    return true;
}

/* Collapse duplicate registrations of one physical declaration onto the
   lowest index. Physical identity is established by
   cold_object_alias_identity_equal; equal byte layout alone is insufficient
   because Cheng aggregate assignment is nominally typed. */
/* Exact field-layout equality for two ObjectDef rows of the SAME
   declaration origin row: field count, slot size and every field's
   name/type/kind/size/offset/array_len must match.  Used as the merge
   authority when the semantic-owner CID cannot compare like-for-like
   (intrinsic stand-in vs claiming parser declaration). */
static bool cold_object_fields_layout_equal(
        Symbols *symbols, ObjectDef *a, ObjectDef *b) {
    (void)symbols;
    if (!a || !b) return false;
    if (a == b) return true;
    if (a->field_count != b->field_count ||
        a->slot_size != b->slot_size ||
        a->generic_count != b->generic_count ||
        a->is_ref != b->is_ref ||
        a->inherited_field_count != b->inherited_field_count) {
        return false;
    }
    for (int32_t fi = 0; fi < a->field_count; fi++) {
        ObjectField *fa = &a->fields[fi];
        ObjectField *fb = &b->fields[fi];
        if (fa->kind != fb->kind ||
            fa->size != fb->size ||
            fa->offset != fb->offset ||
            fa->array_len != fb->array_len ||
            !span_same(fa->name, fb->name) ||
            !span_same(fa->type_name, fb->type_name)) {
            return false;
        }
    }
    return true;
}

static int32_t cold_canonical_object_identity(Symbols *symbols, int32_t index) {
    if (!symbols || index < 0 ||
        index >= symbols->object_count) return index;
    ObjectDef *target = &symbols->objects[index];
    if (target->is_parser_declaration) {
        int32_t origin =
            target->declaration_origin_row;
        if (origin < 0 ||
            origin >= symbols->declaration_origin_count ||
            !symbols->declaration_origin_object_rows) {
            die("canonical ObjectDef origin index is invalid");
        }
        int32_t canonical =
            symbols->declaration_origin_object_rows[origin];
        if (canonical < 0 || canonical > index ||
            canonical >= symbols->object_count ||
            symbols->objects[canonical].
                    declaration_origin_row != origin) {
            die("canonical ObjectDef origin row is invalid");
        }
        if (canonical != index &&
            !cold_object_alias_identity_equal(
                symbols, &symbols->objects[canonical],
                target)) {
            /* Same declaration_origin_row is the physical-declaration
               authority.  The semantic-owner CID disagrees when one
               registration is the intrinsic stand-in (Bytes/Result/
               ErrorInfo ensure path) and the other is the parser
               declaration that claims it: the CID inputs differ by the
               intrinsic kind, not by source.  Fall back to an exact
               field-layout comparison -- same origin row means the same
               source line, so equal layout proves the same declaration
               and merging stays nominally safe. */
            if (!cold_object_fields_layout_equal(
                    symbols, &symbols->objects[canonical],
                    target)) {
                die("canonical ObjectDef origin layout drift");
            }
        }
        return canonical;
    }
    if (target->canonical_mirror_object_row >= 0) {
        int32_t mirror =
            target->canonical_mirror_object_row;
        if (mirror >= index ||
            !cold_object_alias_identity_equal(
                symbols, &symbols->objects[mirror],
                target)) {
            die("canonical ObjectDef mirror drift");
        }
        return cold_canonical_object_identity(
            symbols, mirror);
    }
    /* Synthetic/intrinsic rows have no source declaration origin.  Preserve
       their small legacy equivalence scan; all parser-owned nominal rows,
       which dominate imported signatures, use the exact O(1) index above. */
    for (int32_t i = 0; i < index; i++) {
        if (cold_object_alias_identity_equal(
                symbols, &symbols->objects[i],
                target)) {
            return i;
        }
    }
    return index;
}

static int32_t cold_resolve_object_type_identity(Symbols *symbols, Span type_name) {
    if (!symbols) return -1;
    Span current = span_trim(cold_type_strip_var(type_name, 0));
    for (int32_t depth = 0; depth <= symbols->type_count; depth++) {
        if (current.len <= 0) return -1;
        ObjectDef *resolved_object = symbols_resolve_object(symbols, current);
        if (resolved_object) {
            for (int32_t object_index = 0;
                 object_index < symbols->object_count;
                 object_index++) {
                if (&symbols->objects[object_index] == resolved_object) {
                    return cold_canonical_object_identity(symbols, object_index);
                }
            }
            die("aggregate field store resolved object identity missing");
        }
        TypeDef *alias = symbols_find_type(symbols, current);
        if (alias && alias->alias_type.len > 0) {
            current = span_trim(cold_type_strip_var(alias->alias_type, 0));
            continue;
        }
        Span generic_base = {0};
        Span generic_args = {0};
        if (cold_type_parse_generic_instance(current, &generic_base, &generic_args)) {
            (void)symbols_resolve_object(symbols, current);
            return cold_canonical_object_identity(symbols,
                       cold_find_object_type_identity(symbols, current));
        }
        return -1;
    }
    die("aggregate field store type alias cycle");
    return -1;
}

/* Generic-scope twin of cold_resolve_object_type_identity: the same
   bounded alias chase, but generic applications resolve through the
   producer function's own generic binder (the
   COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN convention), so a
   template body's scoped application spelling (`tables.Table[V]`) reaches
   one canonical ObjectDef instead of an unscoped TypeNode rejection. */
static int32_t cold_resolve_object_type_identity_in_generic_scope(
        Symbols *symbols, Span type_name,
        Span *generic_names, int32_t generic_count,
        int32_t generic_binder_kind,
        int32_t generic_binder_id) {
    if (!symbols) return -1;
    Span current = span_trim(cold_type_strip_var(type_name, 0));
    for (int32_t depth = 0; depth <= symbols->type_count; depth++) {
        if (current.len <= 0) return -1;
        ObjectDef *resolved_object =
            generic_count > 0 &&
                    cold_type_references_generic_names(
                        current, generic_names, generic_count)
                ? symbols_resolve_object_in_generic_scope(
                      symbols, current, generic_names,
                      generic_count, generic_binder_kind,
                      generic_binder_id)
                : symbols_resolve_object(symbols, current);
        if (resolved_object) {
            for (int32_t object_index = 0;
                 object_index < symbols->object_count;
                 object_index++) {
                if (&symbols->objects[object_index] == resolved_object) {
                    return cold_canonical_object_identity(symbols, object_index);
                }
            }
            die("aggregate field store resolved object identity missing");
        }
        TypeDef *alias = symbols_find_type(symbols, current);
        if (alias && alias->alias_type.len > 0) {
            current = span_trim(cold_type_strip_var(alias->alias_type, 0));
            continue;
        }
        Span generic_base = {0};
        Span generic_args = {0};
        if (cold_type_parse_generic_instance(current, &generic_base, &generic_args)) {
            if (generic_count > 0) {
                (void)symbols_resolve_object_in_generic_scope(
                    symbols, current, generic_names,
                    generic_count, generic_binder_kind,
                    generic_binder_id);
            } else {
                (void)symbols_resolve_object(symbols, current);
            }
            return cold_canonical_object_identity(symbols,
                       cold_find_object_type_identity(symbols, current));
        }
        return -1;
    }
    die("aggregate field store type alias cycle");
    return -1;
}

/* #121 root fix: non-object composite kinds (str/variant/array/seq) have no
   registered canonical-identity index the way ObjectDef/generic-instances do
   (cold_canonical_object_identity) -- for these, structural byte layout *is*
   the type, so "same type" reduces to "same terminal type spelling after
   alias expansion". Mirrors cold_resolve_object_type_identity()'s bounded
   alias-chase idiom (depth <= symbols->type_count, die() on a cycle) one
   step removed: instead of resolving to a numeric identity, resolve to the
   final non-alias type span so callers can span_same() it. Used to let a
   composite return type spelled through an alias (`type MyStr = str`) match
   an actual value whose slot_type is the unaliased spelling (`str`), the
   same class of bug #119 r3 fixed for SLOT_OBJECT via canonical identity. */
static Span cold_resolve_alias_terminal_span(Symbols *symbols, Span type) {
    if (!symbols) return type;
    Span current = span_trim(cold_type_strip_var(type, 0));
    for (int32_t depth = 0; depth <= symbols->type_count; depth++) {
        TypeDef *alias = symbols_find_type(symbols, current);
        if (!alias || alias->alias_type.len <= 0) return current;
        current = span_trim(cold_type_strip_var(alias->alias_type, 0));
    }
    die("cold type alias cycle");
    return current;
}

static bool cold_field_store_kind_compatible(int32_t field_kind,
                                             int32_t value_kind) {
    if (field_kind == SLOT_OBJECT) {
        return value_kind == SLOT_OBJECT || value_kind == SLOT_OBJECT_REF;
    }
    if (field_kind == SLOT_OBJECT_REF) return value_kind == SLOT_OBJECT_REF;
    if (field_kind == SLOT_OPAQUE) {
        return value_kind == SLOT_OPAQUE || value_kind == SLOT_PTR;
    }
    if (field_kind == SLOT_PTR) {
        return value_kind == SLOT_PTR || value_kind == SLOT_OPAQUE ||
               value_kind == SLOT_OPAQUE_REF;
    }
    return field_kind == value_kind;
}

static bool cold_field_store_requires_exact_value_layout(int32_t field_kind) {
    return field_kind == SLOT_STR || field_kind == SLOT_SEQ_I32 ||
           field_kind == SLOT_SEQ_STR || field_kind == SLOT_SEQ_OPAQUE ||
           field_kind == SLOT_ARRAY_I32 || field_kind == SLOT_VARIANT;
}

static bool cold_field_store_requires_type_identity(int32_t field_kind) {
    return field_kind == SLOT_SEQ_OPAQUE ||
           field_kind == SLOT_ARRAY_I32 || field_kind == SLOT_VARIANT ||
           field_kind == SLOT_PTR || field_kind == SLOT_OPAQUE;
}

static int32_t cold_require_field_store_layout(Symbols *symbols,
                                               BodyIR *body,
                                               ObjectDef *owner,
                                               ObjectField *field,
                                               int32_t value_slot,
                                               int32_t value_kind,
                                               const char *context) {
    if (!field) die("aggregate field store metadata missing");
    if (!body || value_slot < 0 || value_slot >= body->slot_count)
        die("aggregate field store value slot invalid");
    bool field_is_object = field->kind == SLOT_OBJECT;
    bool field_is_object_ref = field->kind == SLOT_OBJECT_REF;
    if (!field_is_object && !field_is_object_ref) {
        if (field->size <= 0) die("field store layout missing");
        if (!cold_field_store_kind_compatible(field->kind, value_kind)) {
            fprintf(stderr,
                    "cheng_cold: field store kind mismatch context=%s owner_type=%.*s field=%.*s expected_type=%.*s expected_kind=%d actual_type=%.*s actual_kind=%d\n",
                    context ? context : "",
                    owner ? (int)owner->name.len : 0,
                    owner ? owner->name.ptr : (const uint8_t *)"",
                    (int)field->name.len, field->name.ptr,
                    (int)field->type_name.len, field->type_name.ptr,
                    field->kind,
                    (int)body->slot_type[value_slot].len,
                    body->slot_type[value_slot].ptr,
                    value_kind);
            die("field store kind mismatch");
        }
        int32_t value_slot_size = body->slot_size[value_slot];
        bool exact_composite_layout =
            cold_field_store_requires_exact_value_layout(field->kind);
        bool exact_subword_scalar_layout =
            field->kind == SLOT_I32 && field->size > 0 && field->size < 4;
        int32_t required_value_slot_size = field->size;
        if (exact_composite_layout) {
            required_value_slot_size =
                cold_value_slot_size_for_payload_field(field);
        }
        if (required_value_slot_size <= 0 ||
            value_slot_size < required_value_slot_size ||
            (exact_composite_layout &&
             value_slot_size != required_value_slot_size)) {
            fprintf(stderr,
                    "cheng_cold: field store value layout mismatch context=%s field=%.*s expected_kind=%d field_size=%d required_slot_size=%d actual_kind=%d actual_slot_size=%d\n",
                    context ? context : "",
                    (int)field->name.len, field->name.ptr,
                    field->kind, field->size, required_value_slot_size,
                    value_kind, value_slot_size);
            die("field store value layout mismatch");
        }
        if (field->kind == SLOT_ARRAY_I32 &&
            body->slot_aux[value_slot] != field->array_len) {
            die("field store array length mismatch");
        }
        if (cold_field_store_requires_type_identity(field->kind) ||
            exact_subword_scalar_layout) {
            Span expected_type = cold_resolve_alias_terminal_span(
                symbols, field->type_name);
            Span actual_type = cold_resolve_alias_terminal_span(
                symbols, body->slot_type[value_slot]);
            if (field->kind == SLOT_SEQ_OPAQUE) {
                expected_type = cold_resolve_alias_terminal_span(
                    symbols, cold_seq_opaque_element_type(expected_type));
                actual_type = cold_resolve_alias_terminal_span(
                    symbols, cold_seq_opaque_element_type(actual_type));
            }
            if (exact_subword_scalar_layout &&
                (expected_type.len <= 0 || actual_type.len <= 0)) {
                fprintf(stderr,
                        "cheng_cold: field store subword scalar type identity missing context=%s owner_type=%.*s field=%.*s expected_type=%.*s expected_kind=%d field_size=%d actual_type=%.*s actual_kind=%d actual_slot_size=%d\n",
                        context ? context : "",
                        owner ? (int)owner->name.len : 0,
                        owner ? owner->name.ptr : (const uint8_t *)"",
                        (int)field->name.len, field->name.ptr,
                        (int)expected_type.len, expected_type.ptr,
                        field->kind, field->size,
                        (int)actual_type.len, actual_type.ptr,
                        value_kind, value_slot_size);
                die("field store subword scalar type identity missing");
            }
            if (expected_type.len > 0 && actual_type.len > 0 &&
                !span_same(expected_type, actual_type)) {
                fprintf(stderr,
                        "cheng_cold: field store type mismatch context=%s field=%.*s expected_type=%.*s actual_type=%.*s\n",
                        context ? context : "",
                        (int)field->name.len, field->name.ptr,
                        (int)expected_type.len, expected_type.ptr,
                        (int)actual_type.len, actual_type.ptr);
                die("field store type mismatch");
            }
        }
        if (owner) {
            int32_t owner_size = symbols_object_slot_size(owner);
            if (field->offset < 0 || field->size > owner_size ||
                field->offset > owner_size - field->size) {
                die("field store exceeds owner layout");
            }
        }
        return field->size;
    }
    if ((field_is_object && value_kind != SLOT_OBJECT && value_kind != SLOT_OBJECT_REF) ||
        (field_is_object_ref && value_kind != SLOT_OBJECT_REF)) {
        fprintf(stderr,
                "cheng_cold: aggregate field store kind mismatch context=%s owner_type=%.*s field=%.*s expected_type=%.*s expected_kind=%d actual_kind=%d\n",
                context ? context : "",
                owner ? (int)owner->name.len : 0,
                owner ? owner->name.ptr : (const uint8_t *)"",
                (int)field->name.len, field->name.ptr,
                (int)field->type_name.len, field->type_name.ptr,
                field->kind, value_kind);
        die("aggregate field store kind mismatch");
    }
    int32_t owner_index = -1;
    if (owner) {
        owner_index = cold_find_object_type_identity(symbols, owner->name);
        if (owner_index < 0) die("aggregate field store owner identity missing");
    }
    int32_t expected_index = cold_resolve_object_type_identity(symbols, field->type_name);
    int32_t actual_index = cold_resolve_object_type_identity(symbols,
                                                             body->slot_type[value_slot]);
    ObjectDef *resolved_owner = owner_index >= 0 ? &symbols->objects[owner_index] : 0;
    if (expected_index < 0 || actual_index < 0) {
        fprintf(stderr,
                "cheng_cold: aggregate field store type unresolved context=%s owner_type=%.*s field=%.*s expected_type=%.*s actual_type=%.*s\n",
                context ? context : "",
                resolved_owner ? (int)resolved_owner->name.len : 0,
                resolved_owner ? resolved_owner->name.ptr : (const uint8_t *)"",
                (int)field->name.len, field->name.ptr,
                (int)field->type_name.len, field->type_name.ptr,
                (int)body->slot_type[value_slot].len,
                body->slot_type[value_slot].ptr);
        die("aggregate field store type unresolved");
    }
    ObjectDef *expected = &symbols->objects[expected_index];
    ObjectDef *actual = &symbols->objects[actual_index];
    int32_t expected_size = symbols_object_slot_size(expected);
    int32_t actual_size = symbols_object_slot_size(actual);
    if (expected_index != actual_index) {
        fprintf(stderr,
                "cheng_cold: aggregate field store type mismatch context=%s owner_type=%.*s field=%.*s expected_type=%.*s expected_size=%d actual_type=%.*s actual_size=%d\n",
                context ? context : "",
                resolved_owner ? (int)resolved_owner->name.len : 0,
                resolved_owner ? resolved_owner->name.ptr : (const uint8_t *)"",
                (int)field->name.len, field->name.ptr,
                (int)expected->name.len, expected->name.ptr, expected_size,
                (int)actual->name.len, actual->name.ptr, actual_size);
        die("aggregate field store type mismatch");
    }
    int32_t store_size = field_is_object_ref ? 8 : expected_size;
    int32_t resolved_owner_size = resolved_owner ? symbols_object_slot_size(resolved_owner) : 0;
    if (field->size != store_size || actual_size != expected_size ||
        (resolved_owner && (field->offset < 0 || store_size > resolved_owner_size ||
                            field->offset > resolved_owner_size - store_size)) ||
        (value_kind == SLOT_OBJECT && body->slot_size[value_slot] != actual_size) ||
        (value_kind == SLOT_OBJECT_REF && body->slot_size[value_slot] != 8)) {
        fprintf(stderr,
                "cheng_cold: aggregate field store layout mismatch context=%s owner_type=%.*s owner_size=%d field=%.*s field_offset=%d field_size=%d resolved_type=%.*s resolved_size=%d value_kind=%d value_slot_size=%d\n",
                context ? context : "",
                resolved_owner ? (int)resolved_owner->name.len : 0,
                resolved_owner ? resolved_owner->name.ptr : (const uint8_t *)"",
                resolved_owner_size,
                (int)field->name.len, field->name.ptr,
                field->offset, field->size,
                (int)expected->name.len, expected->name.ptr, expected_size,
                value_kind, body->slot_size[value_slot]);
        die("aggregate field store layout mismatch");
    }
    bool emitter_dereferences_source =
        cold_payload_store_should_deref_source(body, value_slot, store_size);
    if ((field_is_object && value_kind == SLOT_OBJECT_REF &&
         !emitter_dereferences_source) ||
        (field_is_object_ref && emitter_dereferences_source)) {
        die("aggregate field store reference lowering contract mismatch");
    }
    return store_size;
}

int32_t cold_default_slot_for_object_field(Parser *parser, BodyIR *body,
                                           Locals *locals, ObjectField *field,
                                           int32_t *kind_out,
                                           ColdExprResult *result_out) {
    cold_expr_result_reset(result_out);
    ColdExprResult exact_result;
    cold_expr_result_reset(&exact_result);
    int32_t value_kind = field->kind;
    int32_t value_slot = -1;
    if (field->has_default) {
        Span default_expr = span_trim(field->default_expr);
        TypeDef *enum_type =
            symbols_resolve_type(parser->symbols, field->type_name);
        Variant *enum_variant = 0;
        if (enum_type && enum_type->is_enum &&
            cold_span_is_simple_ident(default_expr)) {
            for (int32_t vi = 0; vi < enum_type->variant_count; vi++) {
                if (span_same(
                        cold_span_tail_name(
                            enum_type->variants[vi].name),
                              default_expr)) {
                    if (enum_variant)
                        die("object field enum default variant ambiguous");
                    enum_variant = &enum_type->variants[vi];
                }
            }
        }
        if (enum_variant) {
            value_slot = body_slot(body, SLOT_I32, 4);
            body_slot_set_type(body, value_slot, enum_type->name);
            body_op(body, BODY_OP_I32_CONST, value_slot,
                    enum_variant->tag, 0);
            value_kind = SLOT_I32;
        } else {
            value_slot = cold_parse_expr_from_span_with_result(
                parser, body, locals, field->default_expr,
                &value_kind,
                "unsupported object field default expression",
                &exact_result);
        }
    } else if (field->kind == SLOT_OBJECT) {
        value_slot = cold_parser_default_slot(parser, body, locals, field->type_name,
                                              &value_kind, &exact_result);
    } else {
        value_slot = cold_zero_slot_for_field_exact(
            body, field, &exact_result);
        value_kind = field->kind;
    }
    value_slot = cold_coerce_object_field_value(
        parser, body, field, value_slot, &value_kind,
        &exact_result);
    if (value_kind != field->kind) {
        die("object field default type mismatch");
    }
    if (field->kind == SLOT_ARRAY_I32 && body->slot_aux[value_slot] != field->array_len) {
        die("object field default array length mismatch");
    }
    int32_t storage =
        cold_exact_storage_authority_for_slot(
            parser->symbols, body, value_slot, value_kind);
    if (storage != COLD_MANAGED_STORAGE_UNKNOWN &&
        cold_exact_slot_authority_is_sentinel(
            body, value_slot)) {
        int32_t producer = body->op_count - 1;
        if (producer < 0 ||
            body->op_dst[producer] != value_slot ||
            !cold_exact_op_tuple_is_sentinel(body, producer)) {
            die("object field default lacks canonical producer row");
        }
        cold_publish_owned_managed_producer(
            body, parser->symbols, value_slot,
            value_kind, producer, &exact_result);
    }
    (void)cold_require_field_store_layout(parser->symbols, body, 0, field,
                                          value_slot, value_kind,
                                          "object_field_default");
    if (result_out &&
        exact_result.slot == value_slot &&
        exact_result.kind == value_kind &&
        exact_result.value_def_op_id >= 0 &&
        cold_exact_op_tuple_matches_result(
            body, &exact_result)) {
        *result_out = exact_result;
    }
    if (kind_out) *kind_out = value_kind;
    return value_slot;
}

/* A composite may consume a field value only from the immutable parsed
   value-definition tuple that is copied into its payload CSR.  Slot
   ownership is mutable parser state and therefore cannot decide this edge;
   the slot is used here only to resolve the exact TypeId-backed storage
   layout after the tuple proves it is the same value. */
static bool cold_exact_object_constructor_managed_source(
        Parser *parser, BodyIR *body,
        int32_t value_slot, int32_t value_kind,
        const ColdExprResult *value_result) {
    if (!parser || !body || !value_result ||
        value_result->slot != value_slot ||
        value_result->kind != value_kind ||
        value_result->value_def_op_id < 0 ||
        (value_result->ownership != COLD_EXPR_OWN_MOVE &&
         value_result->ownership != COLD_EXPR_OWN_PLAIN) ||
        (value_result->place_kind != COLD_EXPR_PLACE_TEMPORARY &&
         value_result->place_kind != COLD_EXPR_PLACE_STACK_LOCAL &&
         value_result->place_kind != COLD_EXPR_PLACE_PARAM &&
         value_result->place_kind != COLD_EXPR_PLACE_CFG_MERGE &&
         value_result->place_kind != COLD_EXPR_PLACE_SHARED_COPY &&
         value_result->place_kind != COLD_EXPR_PLACE_MEMORY_VERSION) ||
        (value_result->place_kind == COLD_EXPR_PLACE_MEMORY_VERSION &&
         !cold_exact_slot_current_definition_replace_valid(
             body, parser->symbols, value_slot,
             value_result->value_def_op_id)) ||
        !cold_exact_op_tuple_matches_result(body, value_result)) {
        return false;
    }
    int32_t source_storage =
        cold_exact_storage_authority_for_slot(
            parser->symbols, body, value_slot, value_kind);
    return source_storage != COLD_MANAGED_STORAGE_UNKNOWN &&
           source_storage != COLD_MANAGED_STORAGE_PLAIN;
}

int32_t parse_object_constructor_typed(Parser *parser, BodyIR *body, Locals *locals,
                                       ObjectDef *object, Span slot_type) {
    bool curly = false;
    Span open_tok = parser_peek(parser);
    if (span_eq(open_tok, "{")) {
        (void)parser_token(parser);
        curly = true;
    } else if (span_eq(open_tok, "(")) {
        (void)parser_token(parser);
    } else {
        die("expected ( or { after object constructor");
    }
    int32_t payload_count = 0;
    int32_t payload_slots[COLD_MAX_OBJECT_FIELDS];
    int32_t payload_offsets[COLD_MAX_OBJECT_FIELDS];
    /* Exact owned managed field sources the completed MAKE_COMPOSITE
       consumes (one parsed result per payload row; the flag marks rows
       that are exact owned managed sources).  Without this the
       constructor left a local seq/str/object source alive, so function
       exit dropped it AND the bound object's cold-drop-object released
       the same field buffers -- the double release behind
       cheng_orc_release_failure registry_miss.  The flag also binds the
       payload call_arg authority so the consume edge is visible to the
       exact identity freeze audit. */
    ColdExprResult payload_results[COLD_MAX_OBJECT_FIELDS];
    bool payload_managed_source[COLD_MAX_OBJECT_FIELDS];
    bool seen[COLD_MAX_OBJECT_FIELDS];
    memset(seen, 0, sizeof(seen));
    memset(payload_managed_source, 0, sizeof(payload_managed_source));
    while (!span_eq(parser_peek(parser), curly ? "}" : ")")) {
        Span field_name = parser_token(parser);
        if (field_name.len <= 0) die("empty object constructor field name");
        ObjectField *field = object_find_field(object, field_name);
        if (!field) die("unknown object constructor field");
        int32_t field_index = (int32_t)(field - object->fields);
        if (field_index < 0 || field_index >= object->field_count) die("object field index out of range");
        if (seen[field_index]) die("duplicate object constructor field");
        seen[field_index] = true;
        if (!parser_take(parser, ":")) die("expected : in object constructor field");
        ColdExprResult value_result;
        cold_expr_result_reset(&value_result);
        int32_t value_kind = SLOT_I32;
        int32_t value_slot = cold_parse_expr_with_result(
            parser, body, locals, &value_kind, &value_result);
        value_slot = cold_coerce_object_field_value(
            parser, body, field, value_slot, &value_kind, 0);
        /* #128-r12 root fix (re-landed #128-r13 with the field-width
           materialization root fix below): this early kind-equality gate
           didn't know the SLOT_OBJECT_REF -> SLOT_OBJECT physical-identity
           tolerance that cold_require_field_store_layout (below) already
           implements and relies on `value_kind` staying honest
           (SLOT_OBJECT_REF) to decide whether the store needs a
           deref-copy. A cross-module `var T` global read bare into an
           owned object field (e.g. `Cid(codec: codecDagPb, ...)` where
           `codecDagPb` is `var MultiCodec`) is a legal instance of exactly
           that tolerance -- gate it through to the real check instead of
           dying here on a coarser kind mismatch. */
        bool object_ref_to_owned_ok = field->kind == SLOT_OBJECT &&
                                       value_kind == SLOT_OBJECT_REF;
        if (value_kind != field->kind && !object_ref_to_owned_ok) {
            cold_error_loc(parser, field_name);
            die("object constructor field type mismatch");
        }
        if (field->kind == SLOT_ARRAY_I32 && body->slot_aux[value_slot] != field->array_len) {
            die("object constructor array length mismatch");
        }
        if (object_ref_to_owned_ok) {
            /* #128-r13 root fix, part 1 (type safety): before materializing
               the ref below, confirm it is actually a `field->type_name`
               instance and not some other physical object type that merely
               also happens to be SLOT_OBJECT_REF-kinded (the kind-only gate
               above cannot tell them apart). Reuses the exact resolver
               cold_require_field_store_layout's own object/object_ref
               branch uses for this same purpose -- same architectural
               identity, not a new check invented here. Must run on the
               *original* ref slot (whose body->slot_type is the ref's own
               honest declared type) and *before* materializing: once
               materialized, body->slot_type is stamped with the expected
               type name (see below), which would make a post-hoc identity
               check against that same expected name vacuous. */
            int32_t expected_type_index =
                cold_resolve_object_type_identity(parser->symbols, field->type_name);
            int32_t actual_type_index =
                cold_resolve_object_type_identity(parser->symbols, body->slot_type[value_slot]);
            if (expected_type_index < 0 || actual_type_index < 0 ||
                expected_type_index != actual_type_index) {
                cold_error_loc(parser, field_name);
                die("object constructor field type mismatch");
            }
            /* #128-r13 root fix, part 2 (width): BODY_OP_MAKE_COMPOSITE's
               per-field store (the composite-build codegen below this
               parse) passes payload_width=0 for every field, which
               auto-derives the store width from body->slot_size[src_slot]
               -- correct for every other source kind, but for a
               SLOT_OBJECT_REF source that's just the pointer's own 8
               bytes, not the field's real width, so the deref-copy this
               tolerance branch exists for never actually fires and the
               store silently degenerates to a raw 8-byte pointer write
               (>8-byte fields truncated to garbage or, for a <=8-byte
               owned struct, the pointer bits themselves instead of the
               pointee's bytes). field->size here is the exact width
               cold_require_field_store_layout below independently derives
               as this field's store_size (same architectural truth, not a
               new special case). Materialize the ref into a correctly-
               sized owned slot right here via BODY_OP_PAYLOAD_LOAD, which
               treats a SLOT_OBJECT_REF source as an always-dereference
               pointer with an explicit width (its own op_c field) --
               unlike BODY_OP_PAYLOAD_STORE's codegen, which shares a
               width-vs-source-size deref heuristic with the object_ref-
               into-object_ref (no-deref-wanted) case and picks the wrong
               answer whenever a small owned struct's size coincides with a
               bare pointer's 8 bytes, LOAD's ref branch
               (codegen_copy_slot_from_offset) has no such ambiguity: it
               always dereferences a *_REF source and copies exactly the
               requested width, independent of any size coincidence.
               cold_require_field_store_layout below then sees an ordinary
               owned SLOT_OBJECT source slot whose body->slot_size and
               body->slot_type already agree with field, so every one of
               its checks (layout, identity, and its own internal
               reference-lowering self-consistency check) passes on their
               own existing, unmodified terms -- no change needed there. */
            int32_t owned_slot = body_slot(body, SLOT_OBJECT, field->size);
            body_slot_set_type(body, owned_slot, field->type_name);
            int32_t payload_load_op = body_op3(
                body, BODY_OP_PAYLOAD_LOAD, owned_slot, value_slot, 0,
                field->size);
            /* Root fix for the `parsed call argument lacks exact result
               authority` wall: the #128-r13 deref-copy replaced value_slot
               with a fresh owned carrier but left value_result pointing at
               the OBJECT_REF borrow view, so the payload-row bind below saw
               result->slot != call_arg_slot and died.  The deref-copy is a
               newly owned temporary (share of an immortal global); publish
               its exact definition so the MAKE_COMPOSITE consumes and owns
               it through the ordinary managed-source path. */
            ColdExprResult materialized_result;
            cold_expr_result_reset(&materialized_result);
            cold_publish_exact_managed_definition(
                body, parser->symbols, owned_slot, SLOT_OBJECT,
                payload_load_op, COLD_EXPR_OWN_MOVE,
                &materialized_result);
            value_result = materialized_result;
            value_slot = owned_slot;
            value_kind = SLOT_OBJECT;
        }
        (void)cold_require_field_store_layout(parser->symbols, body, object, field,
                                              value_slot, value_kind,
                                              "object_constructor");
        /* A generic constructor may parse a bare owned local through its
           nonformal payload surface before the enclosing ObjectDef is known.
           If that expression snapshot is sentinel, recover only the unique
           Locals-table entry for the exact physical slot and then re-prove
           its immutable owned definition graph.  This is numeric DOD
           identity, not a name/type heuristic, and it never resurrects a
           consumed or borrowed source. */
        if (value_result.value_def_op_id < 0 &&
            cold_exact_storage_authority_for_slot(
                parser->symbols, body,
                value_slot, value_kind) !=
                COLD_MANAGED_STORAGE_UNKNOWN) {
            int32_t recovered_definition = -1;
            ColdExprResult recovered_result;
            cold_expr_result_reset(&recovered_result);
            for (int32_t local_index = 0;
                 local_index < locals->count;
                 local_index++) {
                Local *candidate =
                    &locals->items[local_index];
                if (candidate->is_global ||
                    candidate->slot != value_slot ||
                    candidate->kind != value_kind ||
                    candidate->value_def_op_id < 0 ||
                    candidate->value_def_op_id >=
                        body->op_count ||
                    body->op_value_def_consume_op_index_plus_one[
                        candidate->value_def_op_id] != 0 ||
                    !cold_exact_owned_local_authority_valid(
                        body, parser->symbols,
                        candidate->value_def_op_id, 0)) {
                    continue;
                }
                ColdExprResult exact;
                cold_expr_result_reset(&exact);
                if (!cold_exact_result_from_definition(
                        body, value_slot,
                        candidate->value_def_op_id,
                        &exact) ||
                    !cold_exact_op_tuple_matches_result(
                        body, &exact)) {
                    continue;
                }
                if (recovered_definition >= 0 &&
                    recovered_definition !=
                        candidate->value_def_op_id) {
                    die("object constructor local source authority is ambiguous");
                }
                recovered_definition =
                    candidate->value_def_op_id;
                recovered_result = exact;
            }
            if (recovered_definition >= 0) {
                value_result = recovered_result;
            }
        }
        int32_t constructor_value_storage =
            cold_exact_storage_authority_for_slot(
                parser->symbols, body,
                value_slot, value_kind);
        if (constructor_value_storage !=
                COLD_MANAGED_STORAGE_UNKNOWN &&
            constructor_value_storage !=
                COLD_MANAGED_STORAGE_PLAIN &&
            value_result.value_def_op_id < 0) {
            fprintf(
                stderr,
                "cheng_cold: object constructor managed source missing"
                " body=%.*s object=%.*s field=%.*s slot=%d kind=%d"
                " type=%.*s storage=%d locals=%d\n",
                (int)body->debug_name.len,
                body->debug_name.ptr
                    ? body->debug_name.ptr
                    : (const uint8_t *)"",
                (int)object->name.len,
                object->name.ptr
                    ? object->name.ptr
                    : (const uint8_t *)"",
                (int)field->name.len,
                field->name.ptr
                    ? field->name.ptr
                    : (const uint8_t *)"",
                value_slot, value_kind,
                (int)body->slot_type[value_slot].len,
                body->slot_type[value_slot].ptr
                    ? body->slot_type[value_slot].ptr
                    : (const uint8_t *)"",
                constructor_value_storage,
                locals->count);
            for (int32_t local_index = 0;
                 local_index < locals->count;
                 local_index++) {
                Local *candidate =
                    &locals->items[local_index];
                if (candidate->slot != value_slot) {
                    continue;
                }
                fprintf(
                    stderr,
                    "cheng_cold: object constructor local candidate"
                    " local=%.*s kind=%d global=%d definition=%d\n",
                    (int)candidate->name.len,
                    candidate->name.ptr
                        ? candidate->name.ptr
                        : (const uint8_t *)"",
                    candidate->kind,
                    candidate->is_global ? 1 : 0,
                    candidate->value_def_op_id);
            }
            die("object constructor managed field source lacks exact authority");
        }
        /* The completed object consumes an exact owned managed field source
           (marked on make_op below) -- the same move the field-assignment
           path cold_emit_exact_managed_field_replace performs.  Coerced or
           materialized values (slot/kind changed in flight), borrowed
           views, and POD/PLAIN sources are not consumed: they either own no
           managed storage or the value reaching the field is no longer the
           parsed definition. */
        payload_results[payload_count] = value_result;
        payload_managed_source[payload_count] =
            cold_exact_object_constructor_managed_source(
                parser, body, value_slot, value_kind,
                &value_result);
        payload_slots[payload_count] = value_slot;
        payload_offsets[payload_count] = field->offset;
        payload_count++;
        if (span_eq(parser_peek(parser), ",")) {
            (void)parser_token(parser);
            continue;
        }
        break;
    }
    if (!parser_take(parser, curly ? "}" : ")")) {
        cold_error_loc(parser, parser_peek(parser));
        die("malformed object constructor");
    }
    for (int32_t fi = 0; fi < object->field_count; fi++) {
        if (seen[fi]) continue;
        ObjectField *field = &object->fields[fi];
        int32_t value_kind = field->kind;
        ColdExprResult value_result;
        int32_t value_slot = cold_default_slot_for_object_field(
            parser, body, locals, field, &value_kind,
            &value_result);
        payload_results[payload_count] = value_result;
        payload_managed_source[payload_count] =
            cold_exact_object_constructor_managed_source(
                parser, body, value_slot, value_kind,
                &value_result);
        payload_slots[payload_count] = value_slot;
        payload_offsets[payload_count] = field->offset;
        payload_count++;
    }
    int32_t payload_start = payload_count > 0 ? body->call_arg_count : -1;
    for (int32_t i = 0; i < payload_count; i++) {
        int32_t payload_row = body_call_arg_with_offset(
            body, payload_slots[i], payload_offsets[i]);
        if (payload_results[i].value_def_op_id >= 0 &&
            cold_exact_op_tuple_matches_result(
                body, &payload_results[i])) {
            cold_bind_parsed_call_arg_authority(
                body, payload_row, &payload_results[i]);
        }
    }
    int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(object));
    body_slot_set_type(body, slot, slot_type.len > 0 ? slot_type : object->name);
    int32_t make_op = body_op3(
        body, BODY_OP_MAKE_COMPOSITE, slot, 0,
        payload_start, payload_count);
    /* Move the exact owned managed field sources into the completed
       object: the object is now their unique owner (cold-drop-object
       releases the fields), so the source definitions must not be dropped
       again at function exit.  Same consume marking MAKE_SEQ_OPAQUE applies
       to its payload definitions. */
    for (int32_t i = 0; i < payload_count; i++) {
        if (!payload_managed_source[i]) continue;
        int32_t source_definition =
            payload_results[i].value_def_op_id;
        if (source_definition < 0) continue;
        /* Follow CFG-merge copy chains: a merge COPY_COMPOSITE consumes the
           branch-input definition and re-defines the same value at the join,
           so the constructor's true movable source is the merge output row,
           not the pre-merge row the expression snapshot captured. */
        for (int32_t hops = 0; hops < body->op_count; hops++) {
            int32_t consumer =
                body->op_value_def_consume_op_index_plus_one[
                    source_definition] - 1;
            if (consumer < 0 || consumer >= make_op) break;
            if (body->op_kind[consumer] != BODY_OP_COPY_COMPOSITE ||
                body->op_value_def_place_kind[consumer] !=
                    COLD_EXPR_PLACE_CFG_MERGE) {
                break;
            }
            source_definition = consumer;
        }
        /* A scope-exit drop on a mutually-exclusive branch (early return)
           also records a consume row for the definition, but that row can
           never reach this constructor: it lives on the branch's cleanup
           edge.  Only a consumer that dominates the constructor's block (or
           precedes it in the same block) actually moves the value away. */
        int32_t consume_row =
            body->op_value_def_consume_op_index_plus_one[
                source_definition] - 1;
        bool consumed_before_make = false;
        if (consume_row >= 0) {
            int32_t make_block =
                cold_block_index_for_op(body, make_op);
            int32_t consume_block =
                cold_block_index_for_op(body, consume_row);
            if (consume_block == make_block && make_block >= 0) {
                consumed_before_make = consume_row < make_op;
            } else if (make_block >= 0) {
                ColdDominatorCache *dominators =
                    cold_exact_body_dominators(body);
                consumed_before_make =
                    cold_exact_op_dominates_predecessor(
                        body, dominators, consume_row, make_block);
            }
        }
        if (source_definition >= make_op ||
            consumed_before_make ||
            !cold_exact_definition_is_live_before_op(
                body, source_definition, make_op)) {
            die("object constructor managed field source is not movable");
        }
        body->op_value_def_consume_op_index_plus_one[
            source_definition] = make_op + 1;
    }
    cold_publish_owned_managed_producer(
        body, parser->symbols, slot, SLOT_OBJECT, make_op, 0);
    return slot;
}

int32_t parse_object_constructor(Parser *parser, BodyIR *body, Locals *locals,
                                        ObjectDef *object) {
    return parse_object_constructor_typed(parser, body, locals, object, object->name);
}

static int32_t cold_copy_slot_for_var_binding(
    Parser *parser, BodyIR *body, Symbols *symbols,
    int32_t slot, int32_t *kind_inout);

int32_t parse_i32_array_literal(Parser *parser, BodyIR *body, Locals *locals,
                                       int32_t *kind) {
    int32_t count = 0;
    int32_t element_slots[1024];
    int32_t element_kinds[1024];
    ColdExprResult element_results[1024];
    int32_t first_kind = SLOT_I32;
    while (!span_eq(parser_peek(parser), "]")) {
        if (count >= 1024) die("cold array literal too large");
        ColdExprResult value_result;
        cold_expr_result_reset(&value_result);
        int32_t value_kind = SLOT_I32;
        int32_t value_slot = cold_parse_expr_with_result(
            parser, body, locals, &value_kind, &value_result);
        bool value_exact =
            value_result.slot == value_slot &&
                    value_result.kind == value_kind &&
                    value_result.value_def_op_id >= 0 &&
                    cold_exact_op_tuple_matches_result(
                        body, &value_result);
        if ((value_kind == SLOT_STR_REF ||
             value_kind == SLOT_OBJECT_REF) && value_exact) {
            value_result =
                cold_exact_managed_ref_value_borrow(
                    body, parser->symbols,
                    &value_result);
            value_slot = value_result.slot;
            value_kind = value_result.kind;
        }
        /* A sequence literal stores values.  A bare `var T` expression is a
           reference slot, so using its physical slot size here would turn
           `[value]` into an eight-byte-element sequence even when T is a wide
           object.  Materialize every reference kind before element type/size
           inference and before MAKE_SEQ_OPAQUE copies bytes from stack slots. */
        if (value_kind == SLOT_I32_REF || value_kind == SLOT_I64_REF ||
            value_kind == SLOT_STR_REF || value_kind == SLOT_OBJECT_REF ||
            value_kind == SLOT_SEQ_I32_REF || value_kind == SLOT_SEQ_STR_REF ||
            value_kind == SLOT_SEQ_OPAQUE_REF || value_kind == SLOT_OPAQUE_REF) {
            value_slot = cold_copy_slot_for_var_binding(
                parser, body, parser->symbols,
                value_slot, &value_kind);
        }
        if (count == 0) first_kind = value_kind;
        element_slots[count] = value_slot;
        element_kinds[count] = value_kind;
        element_results[count] = value_result;
        count++;
        if (span_eq(parser_peek(parser), ",")) {
            (void)parser_token(parser);
            continue;
        }
        break;
    }
    if (!parser_take(parser, "]")) return 0; /* unterminated array literal */
    if (count <= 0) {
        int32_t slot = body_slot(body, SLOT_SEQ_I32, 16);
        body_slot_set_type(body, slot, cold_cstr_span("int32[]"));
        int32_t make_op = body_op3(
            body, BODY_OP_MAKE_COMPOSITE, slot, 0, -1, 0);
        /* A sequence literal is an owned managed producer exactly like an
           object constructor (parse_object_constructor_typed above): publish
           its exact value definition on the op that completes the slot, or
           every position that demands one (return, container store, managed
           binding) sees a temporary with no definition at all. */
        cold_publish_owned_managed_producer(
            body, parser->symbols, slot, SLOT_SEQ_I32, make_op, 0);
        *kind = SLOT_SEQ_I32;
        return slot;
    }
    if (first_kind == SLOT_STR || first_kind == SLOT_STR_REF) {
        int32_t slot = body_slot(body, SLOT_SEQ_STR, 16);
        body_slot_set_type(body, slot, cold_cstr_span("str[]"));
        int32_t empty_op = body_op3(
            body, BODY_OP_MAKE_COMPOSITE, slot, 0, -1, 0);
        int32_t first_append = -1;
        for (int32_t i = 0; i < count; i++) {
            ColdExprResult source = element_results[i];
            if (element_kinds[i] != SLOT_STR ||
                source.slot != element_slots[i] ||
                source.kind != SLOT_STR ||
                source.value_def_op_id < 0 ||
                !cold_exact_op_tuple_matches_result(body, &source)) {
                die("cold str seq literal element type mismatch");
            }
            /* A str[] stores each complete 24-byte record.  An owning value
               crosses as MOVE.  A canonical STR_LITERAL or its exact local
               COPY_COMPOSITE is a resource-free PLAIN record whose
               store_id/flags make release a no-op; copying it is an exact
               read, not an ownership transfer.  Retaining a borrowed
               expression here would silently invent a source-level share
               and violate Cheng's ownership contract. */
            bool plain_static_string =
                source.ownership == COLD_EXPR_OWN_PLAIN &&
                cold_exact_plain_static_string_definition_valid(
                    body, parser->symbols,
                    source.value_def_op_id);
            if (source.ownership != COLD_EXPR_OWN_MOVE &&
                !plain_static_string) {
                fprintf(
                    stderr,
                    "cheng_cold: str[] literal ownership"
                    " body=%.*s element=%d def=%d ownership=%d"
                    " place=%d origin=%d kind=%d slot=%d source=%d"
                    " op_a=%d op_b=%d op_c=%d\n",
                    (int)body->debug_name.len,
                    body->debug_name.ptr
                        ? body->debug_name.ptr
                        : (const uint8_t *)"",
                    i, source.value_def_op_id,
                    source.ownership, source.place_kind,
                    source.origin_id,
                    body->op_kind[source.value_def_op_id],
                    source.slot,
                    body->op_source_value_def_op_id[
                        source.value_def_op_id],
                    body->op_a[source.value_def_op_id],
                    body->op_b[source.value_def_op_id],
                    body->op_c[source.value_def_op_id]);
                die("str[] literal borrowed element requires an explicit owned value");
            }
            ColdExprResult payload = source;
            if (payload.kind != SLOT_STR ||
                (payload.ownership != COLD_EXPR_OWN_MOVE &&
                 !plain_static_string) ||
                payload.value_def_op_id < 0 ||
                !cold_exact_op_tuple_matches_result(body, &payload) ||
                body->slot_managed_storage_kind[payload.slot] !=
                    COLD_MANAGED_STORAGE_STR) {
                die("cold str seq literal payload ownership mismatch");
            }
            int32_t append = body_op(
                body, BODY_OP_SEQ_STR_ADD, slot, payload.slot, 0);
            cold_publish_exact_managed_read(
                body, append, COLD_EXACT_READ_OPERAND_A,
                &payload);
            if (first_append < 0) first_append = append;
            if (plain_static_string) {
                /* Publish the immutable semantic source edge without a
                   consume marker.  The physical A-read above and the frozen
                   literal tuple jointly prove this byte copy; no retain,
                   release, or second owner is created, so the same static
                   definition remains valid for a later element/call/use. */
                if (body->op_source_value_def_op_id[append] != -1 ||
                    body->op_value_def_consume_op_index_plus_one[
                        payload.value_def_op_id] == append + 1) {
                    die("static str[] element read was published as a consume");
                }
                body->op_source_value_def_op_id[append] =
                    payload.value_def_op_id;
                cold_exact_consumer_index_publish_completed_op(
                    body, append);
            } else {
                cold_attach_exact_managed_consume(
                    body, parser->symbols, &payload, append);
            }
        }
        int32_t producer_op = body_op3(
            body, BODY_OP_MAKE_SEQ_STR, slot,
            empty_op, first_append, count);
        cold_publish_owned_managed_producer(
            body, parser->symbols, slot, SLOT_SEQ_STR, producer_op, 0);
        *kind = SLOT_SEQ_STR;
        return slot;
    }
    Span first_type = span_trim(body->slot_type[element_slots[0]]);
    Span first_terminal_type = cold_resolve_alias_terminal_span(
        parser->symbols, first_type);
    bool scalar_opaque_sequence =
        first_kind == SLOT_I64 || first_kind == SLOT_F32 ||
        first_kind == SLOT_F64 ||
        (first_kind == SLOT_I32 &&
         !span_eq(first_terminal_type, "int32") &&
         !span_eq(first_terminal_type, "int"));
    if (first_kind == SLOT_OBJECT || first_kind == SLOT_OBJECT_REF ||
        first_kind == SLOT_OPAQUE || first_kind == SLOT_OPAQUE_REF ||
        first_kind == SLOT_PTR || first_kind == SLOT_ARRAY_I32 ||
        first_kind == SLOT_VARIANT || first_kind == SLOT_SEQ_I32 ||
        first_kind == SLOT_SEQ_I32_REF || first_kind == SLOT_SEQ_STR ||
        first_kind == SLOT_SEQ_STR_REF || first_kind == SLOT_SEQ_OPAQUE ||
        first_kind == SLOT_SEQ_OPAQUE_REF || scalar_opaque_sequence) {
        if (first_type.len <= 0)
            die("cold opaque seq literal exact element type missing");
        int32_t element_size = cold_payload_size_from_type_with_symbols(
            parser->symbols, first_type, first_kind);
        if (element_size <= 0) die("cold opaque seq literal missing element size");
        Span seq_type = cold_arena_join3(parser->arena, first_type, "",
                                         cold_cstr_span("[]"));
        for (int32_t i = 0; i < count; i++) {
            int32_t item_slot = element_slots[i];
            Span item_type = span_trim(body->slot_type[item_slot]);
            if (element_kinds[i] != first_kind || item_type.len <= 0 ||
                !cold_var_ref_types_same_physical(
                    parser->symbols, first_type, item_type,
                    parser->symbols->type_count +
                        parser->symbols->object_count + 4) ||
                cold_payload_size_from_type_with_symbols(
                    parser->symbols, item_type, element_kinds[i]) !=
                    element_size) {
                die("cold opaque seq literal element type or layout mismatch");
            }
        }
        bool exact_managed_payload[1024] = {false};
        if (first_kind == SLOT_OBJECT) {
            ColdExprResult first_source =
                element_results[0];
            int32_t first_source_type_id =
                first_source.exact_type_id;
            int32_t first_source_identity_kind =
                first_source_type_id >= 0
                    ? first_source_type_id / 1048576
                    : -1;
            ObjectDef *object =
                (first_source_identity_kind == SLOT_OBJECT ||
                 first_source_identity_kind == SLOT_OBJECT_REF)
                    ? cold_exact_object_layout_from_type_id(
                          parser->symbols,
                          first_source_type_id,
                          first_source_identity_kind)
                    : 0;
            int32_t exact_type_id =
                object && !object->is_ref
                    ? cold_exact_object_definition_type_id(
                          parser->symbols, object,
                          SLOT_OBJECT)
                    : -1;
            int32_t storage = object
                ? cold_exact_object_storage_from_definition(
                      parser->symbols, object, 0)
                : COLD_MANAGED_STORAGE_UNKNOWN;
            if (!cold_exact_op_tuple_matches_result(
                    body, &first_source) ||
                first_source.slot != element_slots[0] ||
                first_source.kind != SLOT_OBJECT ||
                !object || object->is_ref ||
                exact_type_id < 0 ||
                symbols_object_slot_size(object) != element_size ||
                storage == COLD_MANAGED_STORAGE_UNKNOWN) {
                die("cold opaque seq literal exact object layout missing");
            }
            if (storage != COLD_MANAGED_STORAGE_PLAIN) {
                /* A named/local value remains live, so the sequence owns an
                   exact shared copy.  A fresh temporary moves directly into
                   the sequence.  Both paths publish immutable payload-row
                   authority before MAKE_SEQ_OPAQUE consumes the value. */
                for (int32_t i = 0; i < count; i++) {
                    ColdExprResult source =
                        element_results[i];
                    int32_t source_type_id =
                        source.exact_type_id;
                    int32_t source_identity_kind =
                        source_type_id >= 0
                            ? source_type_id / 1048576
                            : -1;
                    ObjectDef *source_object =
                        (source_identity_kind == SLOT_OBJECT ||
                         source_identity_kind == SLOT_OBJECT_REF)
                            ? cold_exact_object_layout_from_type_id(
                                  parser->symbols,
                                  source_type_id,
                                  source_identity_kind)
                            : 0;
                    if (!cold_exact_op_tuple_matches_result(
                            body, &source) ||
                        source.slot != element_slots[i] ||
                        source.kind != SLOT_OBJECT ||
                        !source_object ||
                        source_object != object ||
                        source_object->is_ref) {
                        die("cold opaque seq literal source TypeId mismatch");
                    }
                    ColdExprResult payload = source;
                    bool direct_move =
                        source.place_kind ==
                            COLD_EXPR_PLACE_TEMPORARY &&
                        source.ownership == COLD_EXPR_OWN_MOVE;
                    if (!direct_move) {
                        payload =
                            cold_emit_exact_shared_local_copy(
                                parser, body,
                                parser->symbols, &source);
                    }
                    if (!cold_exact_op_tuple_matches_result(
                            body, &payload) ||
                        payload.kind != SLOT_OBJECT ||
                        payload.exact_type_id != exact_type_id ||
                        payload.ownership != COLD_EXPR_OWN_MOVE ||
                        body->slot_managed_storage_kind[
                            payload.slot] !=
                            COLD_MANAGED_STORAGE_OBJECT) {
                        die("cold opaque seq literal payload ownership mismatch");
                    }
                    element_slots[i] = payload.slot;
                    element_kinds[i] = payload.kind;
                    element_results[i] = payload;
                    exact_managed_payload[i] = true;
                }
            }
        } else {
            for (int32_t i = 0; i < count; i++) {
                int32_t storage =
                    cold_exact_storage_authority_for_slot(
                        parser->symbols, body,
                        element_slots[i], element_kinds[i]);
                if (storage != COLD_MANAGED_STORAGE_UNKNOWN &&
                    storage != COLD_MANAGED_STORAGE_PLAIN) {
                    die("cold opaque seq managed element kind unsupported");
                }
            }
        }
        int32_t payload_start = body->call_arg_count;
        for (int32_t i = 0; i < count; i++) {
            int32_t payload_row =
                body_call_arg(body, element_slots[i]);
            if (exact_managed_payload[i]) {
                cold_bind_parsed_call_arg_authority(
                    body, payload_row,
                    &element_results[i]);
            }
        }
        int32_t slot = body_slot(body, SLOT_SEQ_OPAQUE, 16);
        body_slot_set_type(body, slot, seq_type);
        /* slot_aux caches the per-element byte size for later s[i] reads
           (cold_seq_opaque_element_size_for_slot); body_slot_set_array_len
           would instead stomp it with the element COUNT, which every other
           SLOT_SEQ_OPAQUE construction site avoids (they use
           body_slot_set_seq_opaque_type or leave slot_aux unset). */
        body->slot_aux[slot] = element_size;
        int32_t make_op = body_op3(
            body, BODY_OP_MAKE_SEQ_OPAQUE, slot, payload_start,
            element_size, count);
        for (int32_t i = 0; i < count; i++) {
            if (!exact_managed_payload[i]) continue;
            int32_t source_definition =
                element_results[i].value_def_op_id;
            if (source_definition < 0 ||
                source_definition >= make_op ||
                body->op_value_def_consume_op_index_plus_one[
                    source_definition] != 0 ||
                !cold_exact_definition_is_live_before_op(
                    body, source_definition, make_op)) {
                die("cold opaque seq literal source is not movable");
            }
            body->op_value_def_consume_op_index_plus_one[
                source_definition] = make_op + 1;
        }
        cold_publish_owned_managed_producer(
            body, parser->symbols, slot, SLOT_SEQ_OPAQUE, make_op, 0);
        *kind = SLOT_SEQ_OPAQUE;
        return slot;
    }
    /* A plain int32 literal keeps the fixed-array staging representation used
       by the established int32[] materializer.  Preserve its exact element
       type/count so a surrounding array literal can prove the nested array
       layout instead of treating the inner aggregate as an untyped i32 blob. */
    if (first_kind != SLOT_I32 || first_type.len <= 0 ||
        (!span_eq(first_terminal_type, "int32") &&
         !span_eq(first_terminal_type, "int"))) {
        die("cold fixed int32 array literal type mismatch");
    }
    int32_t payload_start = body->call_arg_count;
    for (int32_t i = 0; i < count; i++) {
        Span item_type = span_trim(body->slot_type[element_slots[i]]);
        if (element_kinds[i] != SLOT_I32 || item_type.len <= 0 ||
            !cold_var_ref_types_same_physical(
                parser->symbols, first_type, item_type,
                parser->symbols->type_count +
                    parser->symbols->object_count + 4) ||
            cold_payload_size_from_type_with_symbols(
                parser->symbols, item_type, element_kinds[i]) != 4) {
            die("cold fixed int32 array literal element type mismatch");
        }
        body_call_arg_with_offset(body, element_slots[i], i * 4);
    }
    int32_t slot = body_slot(body, SLOT_ARRAY_I32, align_i32(count * 4, 8));
    body_slot_set_type(body, slot, cold_arena_fixed_array_type(
        parser->arena, first_type, count));
    body_slot_set_array_len(body, slot, count);
    body_op3(body, BODY_OP_MAKE_COMPOSITE, slot, 0, payload_start, count);
    *kind = SLOT_ARRAY_I32;
    return slot;
}

static int32_t cold_parse_i32_seq_literal_exact(
        Parser *parser, BodyIR *body, Locals *locals,
        Span exact_sequence_type, int32_t *kind,
        ColdExprResult *result_out) {
    ColdExprResult discarded;
    ColdExprResult *result =
        result_out ? result_out : &discarded;
    cold_expr_result_reset(result);
    exact_sequence_type = span_trim(exact_sequence_type);
    if (!cold_parse_i32_seq_type(exact_sequence_type))
        die("typed int32[] literal target is invalid");
    if (!parser_take(parser, "[")) die("expected [ before int32[] literal");
    int32_t literal_kind = SLOT_I32;
    int32_t literal_slot =
        parse_i32_array_literal(
            parser, body, locals, &literal_kind);
    if (literal_kind == SLOT_ARRAY_I32) {
        return cold_materialize_exact_i32_sequence_literal(
            body, parser->symbols, literal_slot,
            exact_sequence_type, kind, result);
    }
    if (literal_kind != SLOT_SEQ_I32 ||
        !cold_slot_is_empty_sequence_literal(
            body, literal_slot) ||
        !cold_exact_result_from_definition(
            body, literal_slot,
            body->slot_origin_id[literal_slot],
            result)) {
        die("typed int32[] literal producer is invalid");
    }
    int32_t producer = result->value_def_op_id;
    if (!span_same(
            span_trim(body->slot_type[literal_slot]),
            exact_sequence_type)) {
        cold_revoke_exact_managed_producer(
            body, literal_slot, producer);
        body_slot_set_type(
            body, literal_slot, exact_sequence_type);
        cold_publish_owned_managed_producer(
            body, parser->symbols, literal_slot,
            SLOT_SEQ_I32, producer, result);
    }
    cold_expr_result_publish(body, result);
    *kind = SLOT_SEQ_I32;
    return literal_slot;
}

int32_t parse_i32_seq_literal(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t *kind) {
    return cold_parse_i32_seq_literal_exact(
        parser, body, locals,
        cold_cstr_span("int32[]"), kind, 0);
}

int32_t parse_match_bindings(Parser *parser, Span *bind_names, int32_t cap) {
    int32_t bind_count = 0;
    if (!span_eq(parser_peek(parser), "(")) return 0;
    parser_take(parser, "(");
    while (!span_eq(parser_peek(parser), ")")) {
        if (bind_count >= cap) die("too many cold match payload bindings");
        Span bind = parser_token(parser);
        if (bind.len <= 0) die("expected payload binding name");
        bind_names[bind_count++] = bind;
        if (span_eq(parser_peek(parser), ",")) {
            (void)parser_token(parser);
            continue;
        }
        break;
    }
    if (!parser_take(parser, ")")) return 0; /* skip malformed match arm */;
    return bind_count;
}

static int32_t parser_line_indent_at(Parser *parser, int32_t pos);
static int32_t parser_visual_column_at(Parser *parser, int32_t pos);
static int32_t parser_next_nonblank_line_start(Parser *parser, int32_t pos);
bool cold_condition_allows_newline(Span source, int32_t line_start,
                                   int32_t newline_pos, int32_t depth);

static void parser_delimiter_push(Parser *parser, int32_t *depth,
                                  uint8_t opener) {
    if (!parser || !parser->arena || !depth || *depth < 0)
        die("invalid expression delimiter state");
    if (*depth >= parser->delimiter_stack_cap) {
        if (parser->delimiter_stack_cap > INT32_MAX / 2)
            die("expression delimiter depth overflow");
        int32_t next_cap = parser->delimiter_stack_cap > 0
                               ? parser->delimiter_stack_cap * 2
                               : 16;
        uint8_t *next = arena_alloc(parser->arena, (size_t)next_cap);
        if (*depth > 0) {
            if (!parser->delimiter_stack)
                die("expression delimiter stack missing storage");
            memcpy(next, parser->delimiter_stack, (size_t)*depth);
        }
        parser->delimiter_stack = next;
        parser->delimiter_stack_cap = next_cap;
    }
    parser->delimiter_stack[*depth] = opener;
    (*depth)++;
}

static void parser_delimiter_pop(Parser *parser, int32_t *depth,
                                 uint8_t closer) {
    uint8_t expected = closer == ')' ? '(' : closer == ']' ? '[' : '{';
    if (!parser || !depth || *depth <= 0 || !parser->delimiter_stack ||
        parser->delimiter_stack[*depth - 1] != expected) {
        if (parser && parser->source.ptr && parser->pos >= 0 &&
            parser->pos < parser->source.len) {
            int32_t diag_from = parser->pos > 96
                ? parser->pos - 96 : 0;
            int32_t diag_to = parser->pos + 96 < parser->source.len
                ? parser->pos + 96 : parser->source.len;
            fprintf(stderr,
                    "cheng_cold: mismatched expression delimiter pos=%d closer='%c' text=%.*s\n",
                    parser->pos, (char)closer,
                    diag_to - diag_from,
                    parser->source.ptr + diag_from);
        }
        die("mismatched expression delimiter");
    }
    (*depth)--;
}

Span parser_take_until_top_level_char(Parser *parser, uint8_t delimiter,
                                      const char *missing_message) {
    parser_inline_ws(parser);
    int32_t start = parser->pos;
    int32_t line_start = start;
    while (line_start > 0 && parser->source.ptr[line_start - 1] != '\n')
        line_start--;
    int32_t base_indent = parser_line_indent_at(parser, line_start);
    int32_t depth = 0;
    bool has_outer_delimiter = delimiter == ')' || delimiter == ']' ||
                               delimiter == '}';
    if (has_outer_delimiter) {
        uint8_t opener = delimiter == ')' ? '(' : delimiter == ']' ? '[' : '{';
        parser_delimiter_push(parser, &depth, opener);
    }
    bool in_string = false;
    bool in_char = false;
    bool in_triple_string = false;
    while (parser->pos < parser->source.len) {
        uint8_t c = parser->source.ptr[parser->pos];
        if (in_triple_string) {
            if (c == '"' && parser->pos + 2 < parser->source.len &&
                parser->source.ptr[parser->pos + 1] == '"' &&
                parser->source.ptr[parser->pos + 2] == '"') {
                parser->pos += 3;
                in_triple_string = false;
                continue;
            }
            parser->pos++;
            continue;
        }
        if (in_string) {
            if (c == '\\' && parser->pos + 1 < parser->source.len) {
                parser->pos += 2;
                continue;
            }
            if (c == '"') in_string = false;
            parser->pos++;
            continue;
        }
        if (in_char) {
            if (c == '\\' && parser->pos + 1 < parser->source.len) {
                parser->pos += 2;
                continue;
            }
            if (c == '\'') in_char = false;
            parser->pos++;
            continue;
        }
        if (c == '\n' || c == '\r') {
            int32_t next = parser_next_nonblank_line_start(parser,
                                                            parser->pos + 1);
            Span consumed = span_trim(span_sub(parser->source, start,
                                               parser->pos));
            bool continuation = false;
            if (next < parser->source.len) {
                int32_t next_indent = parser_line_indent_at(parser, next);
                if (depth > 0) {
                    continuation = true;
                } else if (next_indent > base_indent &&
                           (consumed.len == 0 ||
                            cold_condition_allows_newline(parser->source,
                                                          line_start,
                                                          parser->pos,
                                                          depth))) {
                    continuation = true;
                }
            }
            if (continuation) {
                parser->pos++;
                if (c == '\r' && parser->pos < parser->source.len &&
                    parser->source.ptr[parser->pos] == '\n') {
                    parser->pos++;
                }
                line_start = parser->pos;
                continue;
            }
            Span at = span_sub(parser->source, parser->pos,
                               parser->pos < parser->source.len ? parser->pos + 1
                                                                : parser->pos);
            fprintf(stderr, "cheng_cold: ");
            cold_error_loc(parser, at);
            fprintf(stderr,
                    " missing delimiter '%c' before newline depth=%d expression=%.*s\n",
                    delimiter, depth, (int)consumed.len, consumed.ptr);
            cold_print_context(parser, at);
            die(missing_message);
            return (Span){0};
        }
        if (c == '"') {
            if (parser->pos + 2 < parser->source.len &&
                parser->source.ptr[parser->pos + 1] == '"' &&
                parser->source.ptr[parser->pos + 2] == '"') {
                parser->pos += 3;
                in_triple_string = true;
                continue;
            }
            in_string = true;
            parser->pos++;
            continue;
        }
        if (c == '\'') {
            in_char = true;
            parser->pos++;
            continue;
        }
        if (c == '#') {
            while (parser->pos < parser->source.len &&
                   parser->source.ptr[parser->pos] != '\n' &&
                   parser->source.ptr[parser->pos] != '\r') {
                parser->pos++;
            }
            continue;
        }
        if ((!has_outer_delimiter && depth == 0 && c == delimiter) ||
            (has_outer_delimiter && depth == 1 && c == delimiter)) {
            break;
        }
        if (c == '(' || c == '[' || c == '{') {
            parser_delimiter_push(parser, &depth, c);
        }
        else if (c == ')' || c == ']' || c == '}') {
            parser_delimiter_pop(parser, &depth, c);
        }
        parser->pos++;
    }
    if (parser->pos >= parser->source.len) die(missing_message);
    Span expr = span_trim(span_sub(parser->source, start, parser->pos));
    if (expr.len <= 0) die(missing_message);
    return expr;
}

Span parser_take_balanced_statement_expr_span_with_base(Parser *parser, const char *missing_message, int32_t base_indent_override) {
    parser_inline_ws(parser);
    int32_t start = parser->pos;
    int32_t line_start = start;
    while (line_start > 0 && parser->source.ptr[line_start - 1] != '\n') line_start--;
    int32_t base_indent =
        base_indent_override >= 0
            ? base_indent_override
            : parser_line_indent_at(parser, line_start);
    int32_t depth = 0;
    bool in_string = false;
    bool in_char = false;
    bool in_triple_string = false;
    while (parser->pos < parser->source.len) {
        uint8_t c = parser->source.ptr[parser->pos];
        if (in_triple_string) {
            if (c == '"' && parser->pos + 2 < parser->source.len &&
                parser->source.ptr[parser->pos + 1] == '"' &&
                parser->source.ptr[parser->pos + 2] == '"') {
                parser->pos += 3;
                in_triple_string = false;
                continue;
            }
            parser->pos++;
            continue;
        }
        if (in_string) {
            if (c == '\\' && parser->pos + 1 < parser->source.len) {
                parser->pos += 2;
                continue;
            }
            if (c == '"') in_string = false;
            parser->pos++;
            continue;
        }
        if (in_char) {
            if (c == '\\' && parser->pos + 1 < parser->source.len) {
                parser->pos += 2;
                continue;
            }
            if (c == '\'') in_char = false;
            parser->pos++;
            continue;
        }
        if (c == '#') {
            while (parser->pos < parser->source.len &&
                   parser->source.ptr[parser->pos] != '\n' &&
                   parser->source.ptr[parser->pos] != '\r') {
                parser->pos++;
            }
            continue;
        }
        if (depth == 0 && c == ';') break;
        if (depth == 0 && (c == '\n' || c == '\r')) {
            int32_t next = parser_next_nonblank_line_start(parser, parser->pos + 1);
            if (cold_condition_allows_newline(parser->source, line_start, parser->pos, depth) &&
                next < parser->source.len &&
                parser_line_indent_at(parser, next) > base_indent) {
                parser->pos++;
                if (c == '\r' && parser->pos < parser->source.len &&
                    parser->source.ptr[parser->pos] == '\n') {
                    parser->pos++;
                }
                line_start = parser->pos;
                continue;
            }
            break;
        }
        if (c == '"') {
            if (parser->pos + 2 < parser->source.len &&
                parser->source.ptr[parser->pos + 1] == '"' &&
                parser->source.ptr[parser->pos + 2] == '"') {
                parser->pos += 3;
                in_triple_string = true;
                continue;
            }
            in_string = true;
            parser->pos++;
            continue;
        }
        if (c == '\'') {
            in_char = true;
            parser->pos++;
            continue;
        }
        if (c == '(' || c == '[' || c == '{') {
            depth++;
            parser->pos++;
            continue;
        }
        if (c == ')' || c == ']' || c == '}') {
            if (depth <= 0) die("unbalanced statement expression");
            depth--;
            parser->pos++;
            continue;
        }
        parser->pos++;
    }
    if (depth != 0 || in_string || in_char || in_triple_string) {
        int32_t at_pos = parser->pos;
        if (at_pos < 0) at_pos = 0;
        if (at_pos > parser->source.len) at_pos = parser->source.len;
        int32_t ctx_start = start;
        if (ctx_start < 0) ctx_start = 0;
        int32_t ctx_end = parser->pos + 80;
        if (ctx_end > parser->source.len) ctx_end = parser->source.len;
        fprintf(stderr, "cheng_cold: unterminated statement expression depth=%d string=%d char=%d triple=%d start=%d pos=%d expr:\n%.*s\n",
                (int)depth, (int)in_string, (int)in_char, (int)in_triple_string,
                (int)start, (int)parser->pos,
                (int)(ctx_end - ctx_start), parser->source.ptr + ctx_start);
        die("unterminated statement expression");
    }
    Span expr = span_trim(span_sub(parser->source, start, parser->pos));
    if (expr.len <= 0) {
        int32_t empty_ctx_start = start - 60;
        if (empty_ctx_start < 0) empty_ctx_start = 0;
        int32_t empty_ctx_end = parser->pos + 60;
        if (empty_ctx_end > parser->source.len) empty_ctx_end = parser->source.len;
        fprintf(stderr,
                "cheng_cold: empty statement expr start=%d pos=%d context:\n%.*s\n",
                (int)start, (int)parser->pos,
                (int)(empty_ctx_end - empty_ctx_start),
                parser->source.ptr + empty_ctx_start);
        die(missing_message);
    }
    return expr;
}

Span parser_take_balanced_statement_expr_span(Parser *parser, const char *missing_message) {
    return parser_take_balanced_statement_expr_span_with_base(
        parser, missing_message, -1);
}

static int32_t parser_line_indent_at(Parser *parser, int32_t pos) {
    int32_t line = pos;
    while (line > 0 && parser->source.ptr[line - 1] != '\n') line--;
    int32_t indent = 0;
    while (line < parser->source.len) {
        uint8_t c = parser->source.ptr[line];
        if (c == ' ') indent++;
        else if (c == '\t') indent += 4;
        else break;
        line++;
    }
    return indent;
}

static int32_t parser_visual_column_at(Parser *parser, int32_t pos) {
    if (pos < 0) pos = 0;
    if (pos > parser->source.len) pos = parser->source.len;
    int32_t line_start = pos;
    while (line_start > 0 && parser->source.ptr[line_start - 1] != '\n') line_start--;
    int32_t column = 0;
    for (int32_t i = line_start; i < pos; i++) {
        column += parser->source.ptr[i] == '\t' ? 4 : 1;
    }
    return column;
}

static int32_t parser_next_nonblank_line_start(Parser *parser, int32_t pos) {
    while (pos < parser->source.len) {
        int32_t line_start = pos;
        while (line_start < parser->source.len &&
               (parser->source.ptr[line_start] == ' ' ||
                parser->source.ptr[line_start] == '\t' ||
                parser->source.ptr[line_start] == '\r')) {
            line_start++;
        }
        if (line_start >= parser->source.len) return parser->source.len;
        if (parser->source.ptr[line_start] != '\n') return line_start;
        pos = line_start + 1;
    }
    return parser->source.len;
}

Span parser_take_let_initializer_span(Parser *parser, int32_t stmt_indent,
                                      const char *missing_message) {
    parser_inline_ws(parser);
    int32_t start;
    if (parser->pos < parser->source.len &&
        parser->source.ptr[parser->pos] != '\n' &&
        parser->source.ptr[parser->pos] != '\r') {
        /* Initializer on the same line as let — capture start, then
           fall through to the continuation-aware scan loop below. */
        start = parser->pos;
    } else {
        /* Initializer on continuation line(s) only. */
        start = parser_next_nonblank_line_start(parser, parser->pos);
        if (start >= parser->source.len ||
            parser_line_indent_at(parser, start) <= stmt_indent) {
            int32_t context_start = parser->pos - 48;
            if (context_start < 0) context_start = 0;
            int32_t context_end = parser->pos + 96;
            if (context_end > parser->source.len)
                context_end = parser->source.len;
            fprintf(stderr,
                    "cheng_cold: initializer continuation missing "
                    "offset=%d statement_indent=%d next_offset=%d "
                    "next_indent=%d context:\n%.*s\n",
                    (int)parser->pos, (int)stmt_indent, (int)start,
                    start < parser->source.len
                        ? (int)parser_line_indent_at(parser, start) : -1,
                    (int)(context_end - context_start),
                    parser->source.ptr + context_start);
            die(missing_message);
        }
    }
    parser->pos = start;
    int32_t scan = start;
    int32_t depth = 0;
    bool in_string = false;
    bool in_char = false;
    bool in_triple_string = false;
    while (scan < parser->source.len) {
        uint8_t c = parser->source.ptr[scan];
        if (in_triple_string) {
            if (c == '"' && scan + 2 < parser->source.len &&
                parser->source.ptr[scan + 1] == '"' &&
                parser->source.ptr[scan + 2] == '"') {
                scan += 3;
                in_triple_string = false;
                continue;
            }
            scan++;
            continue;
        }
        if (in_string) {
            if (c == '\\' && scan + 1 < parser->source.len) {
                scan += 2;
                continue;
            }
            if (c == '"') in_string = false;
            scan++;
            continue;
        }
        if (in_char) {
            if (c == '\\' && scan + 1 < parser->source.len) {
                scan += 2;
                continue;
            }
            if (c == '\'') in_char = false;
            scan++;
            continue;
        }
        if (c == '#') {
            while (scan < parser->source.len &&
                   parser->source.ptr[scan] != '\n' &&
                   parser->source.ptr[scan] != '\r') {
                scan++;
            }
            continue;
        }
        if (c == '"') {
            if (scan + 2 < parser->source.len &&
                parser->source.ptr[scan + 1] == '"' &&
                parser->source.ptr[scan + 2] == '"') {
                scan += 3;
                in_triple_string = true;
                continue;
            }
            in_string = true; scan++; continue;
        }
        if (c == '\'') { in_char = true; scan++; continue; }
        if (c == '(' || c == '[' || c == '{') { depth++; scan++; continue; }
        if (c == ')' || c == ']' || c == '}') {
            if (depth <= 0) die("unbalanced let initializer");
            depth--;
            scan++;
            continue;
        }
        if ((c == '\n' || c == '\r') && depth == 0) {
            int32_t next = parser_next_nonblank_line_start(parser, scan + 1);
            if (next >= parser->source.len ||
                parser_line_indent_at(parser, next) <= stmt_indent) {
                break;
            }
        }
        scan++;
    }
    if (depth != 0 || in_string || in_char || in_triple_string) die("unterminated let initializer");
    parser->pos = scan;
    Span expr = span_trim(span_sub(parser->source, start, parser->pos));
    if (expr.len <= 0) {
        fprintf(stderr,
                "cheng_cold: empty initializer offset=%d end=%d "
                "statement_indent=%d\n",
                (int)start, (int)parser->pos, (int)stmt_indent);
        die(missing_message);
    }
    return expr;
}

static Span parser_take_ternary_else_span(Parser *parser,
                                          int32_t ternary_base_indent) {
    parser_inline_ws(parser);
    if (parser->pos < parser->source.len &&
        (parser->source.ptr[parser->pos] == '\n' ||
         parser->source.ptr[parser->pos] == '\r')) {
        int32_t next = parser_next_nonblank_line_start(parser, parser->pos + 1);
        int32_t next_indent = next < parser->source.len
            ? parser_line_indent_at(parser, next) : -1;
        if (next >= parser->source.len || next_indent < ternary_base_indent) {
            fprintf(stderr,
                    "cheng_cold: ternary else continuation base_indent=%d next_indent=%d offset=%d source_bytes=%d\n",
                    ternary_base_indent, next_indent, parser->pos,
                    parser->source.len);
            die("ternary else continuation indentation invalid");
        }
        parser->pos = next;
    }
    int32_t start = parser->pos;
    int32_t depth = 0;
    bool in_string = false;
    bool in_char = false;
    bool in_triple_string = false;
    while (parser->pos < parser->source.len) {
        uint8_t c = parser->source.ptr[parser->pos];
        if (in_triple_string) {
            if (c == '"' && parser->pos + 2 < parser->source.len &&
                parser->source.ptr[parser->pos + 1] == '"' &&
                parser->source.ptr[parser->pos + 2] == '"') {
                parser->pos += 3;
                in_triple_string = false;
                continue;
            }
            parser->pos++;
            continue;
        }
        if (in_string) {
            if (c == '\\' && parser->pos + 1 < parser->source.len) {
                parser->pos += 2;
                continue;
            }
            if (c == '"') in_string = false;
            parser->pos++;
            continue;
        }
        if (in_char) {
            if (c == '\\' && parser->pos + 1 < parser->source.len) {
                parser->pos += 2;
                continue;
            }
            if (c == '\'') in_char = false;
            parser->pos++;
            continue;
        }
        if (c == '#') {
            while (parser->pos < parser->source.len &&
                   parser->source.ptr[parser->pos] != '\n' &&
                   parser->source.ptr[parser->pos] != '\r') {
                parser->pos++;
            }
            continue;
        }
        if (c == '"') {
            if (parser->pos + 2 < parser->source.len &&
                parser->source.ptr[parser->pos + 1] == '"' &&
                parser->source.ptr[parser->pos + 2] == '"') {
                parser->pos += 3;
                in_triple_string = true;
                continue;
            }
            in_string = true;
            parser->pos++;
            continue;
        }
        if (c == '\'') {
            in_char = true;
            parser->pos++;
            continue;
        }
        if ((c == ',' || c == ')' || c == ']' || c == '}') && depth == 0)
            break;
        if (c == '(' || c == '[' || c == '{') {
            depth++;
            parser->pos++;
            continue;
        }
        if (c == ')' || c == ']' || c == '}') {
            depth--;
            if (depth < 0) die("unbalanced ternary else expression");
            parser->pos++;
            continue;
        }
        if (c == '\n' || c == '\r') {
            int32_t next = parser_next_nonblank_line_start(parser,
                                                           parser->pos + 1);
            if (next < parser->source.len &&
                (depth > 0 ||
                 parser_line_indent_at(parser, next) > ternary_base_indent)) {
                parser->pos = next;
                continue;
            }
            break;
        }
        parser->pos++;
    }
    if (depth != 0 || in_string || in_char || in_triple_string)
        die("unterminated ternary else expression");
    Span result = span_trim(span_sub(parser->source, start, parser->pos));
    if (result.len <= 0) die("ternary else expression missing");
    return result;
}

static bool parser_token_begins_expression(Span token) {
    if (token.len <= 0) return false;
    uint8_t first = token.ptr[0];
    if ((first >= 'A' && first <= 'Z') ||
        (first >= 'a' && first <= 'z') || first == '_' ||
        (first >= '0' && first <= '9') ||
        first == '"' || first == '\'') {
        return true;
    }
    return span_eq(token, "(") || span_eq(token, "[") ||
           span_eq(token, "{") || span_eq(token, "+") ||
           span_eq(token, "-") || span_eq(token, "!") ||
           span_eq(token, "~") || span_eq(token, "$") ||
           span_eq(token, "^") || span_eq(token, "%");
}

/* Return the exact byte offset of the ':' paired with the current '?' token,
   or -1 when the current token is a postfix question.

   conditionalExpr is the only owner of ternary parsing.  The scan starts from
   parser_token()'s exact '?' extent, not parser->pos: parser_peek() restores
   pos before whitespace, so a continued-line '?' would otherwise be hidden
   behind the preceding newline.  The continuation floor is the start of the
   whole conditional expression, not the line containing '?'; this admits
   a same-indent then/else continuation after a multi-line condition while
   still stopping at the next statement. */
static int32_t parser_question_matching_colon(Parser *parser,
                                              int32_t expression_start) {
    if (!parser || expression_start < 0 ||
        expression_start >= parser->source.len) {
        die("invalid conditional expression start");
    }
    Parser probe = *parser;
    Span question = parser_token(&probe);
    if (!span_eq(question, "?")) return -1;
    int32_t question_offset = cold_span_offset(parser->source, question);
    if (question_offset < 0) die("conditional question token is not source-owned");

    int32_t expression_line_start = expression_start;
    while (expression_line_start > 0 &&
           parser->source.ptr[expression_line_start - 1] != '\n') {
        expression_line_start--;
    }
    int32_t expression_base_indent =
        parser_line_indent_at(parser, expression_line_start);
    int32_t previous_end = question_offset + question.len;
    int32_t delimiter_depth = 0;
    int32_t conditional_depth = 1;

    for (;;) {
        Span token = parser_token(&probe);
        if (token.len <= 0) break;
        int32_t token_offset = cold_span_offset(parser->source, token);
        if (token_offset < previous_end)
            die("conditional token order drift");

        bool crossed_line = false;
        for (int32_t i = previous_end; i < token_offset; i++) {
            if (parser->source.ptr[i] == '\n' ||
                parser->source.ptr[i] == '\r') {
                crossed_line = true;
                break;
            }
        }
        if (crossed_line && delimiter_depth == 0 &&
            parser_line_indent_at(parser, token_offset) <=
                expression_base_indent) {
            break;
        }

        if (span_eq(token, "(") || span_eq(token, "[") ||
            span_eq(token, "{")) {
            parser_delimiter_push(parser, &delimiter_depth, token.ptr[0]);
        } else if (span_eq(token, ")") || span_eq(token, "]") ||
                   span_eq(token, "}")) {
            if (delimiter_depth == 0) break;
            parser_delimiter_pop(parser, &delimiter_depth, token.ptr[0]);
        } else if (delimiter_depth == 0 && span_eq(token, "?")) {
            Parser after_question = probe;
            Span then_first = parser_token(&after_question);
            if (parser_token_begins_expression(then_first))
                conditional_depth++;
        } else if (delimiter_depth == 0 && span_eq(token, ":")) {
            conditional_depth--;
            if (conditional_depth == 0) return token_offset;
        } else if (delimiter_depth == 0 &&
                   (span_eq(token, ",") || span_eq(token, ";"))) {
            break;
        }
        previous_end = token_offset + token.len;
    }
    return -1;
}

/* Find top-level (depth-0) "..<" or ".." range separator in a span.
   Returns index of the first '.' of the separator, or -1 if none.
   *exclusive_out = true for "..<", false for "..". */
static int32_t cold_span_find_range_dots(Span span, bool *exclusive_out) {
    int32_t depth = 0;
    bool in_string = false;
    bool in_char = false;
    for (int32_t i = 0; i < span.len; i++) {
        uint8_t c = span.ptr[i];
        if (in_string) {
            if (c == '\\' && i + 1 < span.len) { i++; continue; }
            if (c == '"') in_string = false;
            continue;
        }
        if (in_char) {
            if (c == '\\' && i + 1 < span.len) { i++; continue; }
            if (c == '\'') in_char = false;
            continue;
        }
        if (c == '"') { in_string = true; continue; }
        if (c == '\'') { in_char = true; continue; }
        if (c == '(' || c == '[') { depth++; continue; }
        if (c == ')' || c == ']') { if (depth > 0) depth--; continue; }
        if (depth == 0 && c == '.' && i + 1 < span.len && span.ptr[i + 1] == '.') {
            if (i + 3 < span.len &&
                ((span.ptr[i + 2] == '<' &&
                  span.ptr[i + 3] == '=') ||
                 (span.ptr[i + 2] == '>' &&
                  span.ptr[i + 3] == '='))) {
                fprintf(stderr,
                        "CHENG_RANGE_OPERATOR_REMOVED_USE_DOTDOT_OR_DOTDOT_LT: "
                        "`..<=`/`..>=` were removed; use `..` for inclusive "
                        "or `..<` for exclusive range\n");
                die("removed range operator");
            }
            if (i + 2 < span.len && span.ptr[i + 2] == '<') {
                if (exclusive_out) *exclusive_out = true;
                return i;
            }
            if (exclusive_out) *exclusive_out = false;
            return i;
        }
    }
    return -1;
}

bool cold_token_is_triple_string(Span token) {
    return token.len >= 6 &&
           token.ptr[0] == '"' && token.ptr[1] == '"' && token.ptr[2] == '"' &&
           token.ptr[token.len - 3] == '"' &&
           token.ptr[token.len - 2] == '"' &&
           token.ptr[token.len - 1] == '"';
}

Span cold_triple_string_content(Arena *arena, Span token) {
    if (!cold_token_is_triple_string(token)) {
        return span_sub(token, 1, token.len - 1);
    }
    Span raw = span_sub(token, 3, token.len - 3);
    int32_t start = 0;
    int32_t end = raw.len;
    if (start < end && raw.ptr[start] == '\r' &&
        start + 1 < end && raw.ptr[start + 1] == '\n') {
        start += 2;
    } else if (start < end && raw.ptr[start] == '\n') {
        start++;
    }
    int32_t trim = end;
    while (trim > start &&
           (raw.ptr[trim - 1] == ' ' ||
            raw.ptr[trim - 1] == '\t' ||
            raw.ptr[trim - 1] == '\r')) {
        trim--;
    }
    if (trim > start && raw.ptr[trim - 1] == '\n') {
        end = trim - 1;
    }
    int32_t min_indent = -1;
    int32_t scan = start;
    while (scan < end) {
        int32_t indent = 0;
        int32_t line = scan;
        while (line < end && (raw.ptr[line] == ' ' || raw.ptr[line] == '\t')) {
            indent++;
            line++;
        }
        int32_t text = line;
        while (text < end && raw.ptr[text] != '\n' && raw.ptr[text] != '\r') text++;
        if (line < text) {
            if (min_indent < 0 || indent < min_indent) min_indent = indent;
        }
        scan = text;
        if (scan < end && raw.ptr[scan] == '\r') scan++;
        if (scan < end && raw.ptr[scan] == '\n') scan++;
    }
    if (min_indent < 0) min_indent = 0;
    uint8_t *out = arena_alloc(arena, (size_t)(end - start + 1));
    int32_t count = 0;
    scan = start;
    while (scan < end) {
        int32_t drop = min_indent;
        while (drop > 0 && scan < end &&
               (raw.ptr[scan] == ' ' || raw.ptr[scan] == '\t')) {
            scan++;
            drop--;
        }
        while (scan < end && raw.ptr[scan] != '\n' && raw.ptr[scan] != '\r') {
            out[count++] = raw.ptr[scan++];
        }
        if (scan < end && raw.ptr[scan] == '\r') scan++;
        if (scan < end && raw.ptr[scan] == '\n') {
            out[count++] = '\n';
            scan++;
        }
    }
    return (Span){out, count};
}

Span parser_take_dotted_after_first(Parser *parser, Span first) {
    Span qualified = first;
    while (span_eq(parser_peek(parser), ".")) {
        (void)parser_token(parser);
        Span part = parser_token(parser);
        if (part.len <= 0) die("expected qualified name segment");
        qualified = cold_arena_join3(parser->arena, qualified, ".", part);
    }
    return qualified;
}

Span parser_take_qualified_after_first(Parser *parser, Span first) {
    Span qualified = parser_take_dotted_after_first(parser, first);
    if (span_eq(parser_peek(parser), "[")) {
        Span open = parser_peek(parser);
        int32_t generic_start = cold_span_offset(parser->source, open);
        if (generic_start < 0) die("qualified generic span outside source");
        parser_skip_balanced(parser, "[", "]");
        Span generic = span_sub(parser->source, generic_start, parser->pos);
        qualified = cold_arena_join3(parser->arena, qualified, "", generic);
    }
    return qualified;
}

bool parser_next_is_qualified_call(Parser *parser) {
    int32_t saved = parser->pos;
    if (!span_eq(parser_peek(parser), ".")) return false;
    (void)parser_token(parser);
    Span part = parser_token(parser);
    if (part.len <= 0) { parser->pos = saved; return false; }
    /* Skip generic [T] args after segment name before checking for ( */
    if (span_eq(parser_peek(parser), "[")) parser_skip_balanced(parser, "[", "]");
    bool ok = span_eq(parser_peek(parser), "(");
    parser->pos = saved;
    return ok;
}

bool parser_next_is_generic_call(Parser *parser) {
    if (!span_eq(parser_peek(parser), "[")) return false;
    Parser probe = *parser;
    parser_skip_balanced(&probe, "[", "]");
    return span_eq(parser_peek(&probe), "(");
}

Span cold_decode_string_content_mode(Arena *arena, Span raw, bool fmt_literal, bool raw_backslash) {
    if (!raw_backslash) return cold_decode_string_content(arena, raw, fmt_literal);
    uint8_t *out = arena_alloc(arena, (size_t)raw.len + 1);
    int32_t count = 0;
    for (int32_t i = 0; i < raw.len; i++) {
        uint8_t c = raw.ptr[i];
        if (fmt_literal && c == '{' && i + 1 < raw.len && raw.ptr[i + 1] == '{') {
            out[count++] = '{';
            i++;
            continue;
        }
        if (fmt_literal && c == '}' && i + 1 < raw.len && raw.ptr[i + 1] == '}') {
            out[count++] = '}';
            i++;
            continue;
        }
        out[count++] = c;
    }
    out[count] = 0;
    return (Span){out, count};
}

int32_t cold_make_str_literal_slot_mode(Parser *parser, BodyIR *body, Span raw,
                                               bool fmt_literal, bool raw_backslash) {
    Span literal = cold_decode_string_content_mode(parser->arena, raw, fmt_literal, raw_backslash);
    int32_t literal_index = body_string_literal(body, literal);
    int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
    body_slot_set_type(body, slot, cold_cstr_span("str"));
    int32_t producer =
        body_op(body, BODY_OP_STR_LITERAL, slot, literal_index, 0);
    cold_publish_plain_string_literal_producer(
        body, slot, producer, 0);
    return slot;
}

int32_t cold_make_str_literal_slot(Parser *parser, BodyIR *body, Span raw, bool fmt_literal) {
    return cold_make_str_literal_slot_mode(parser, body, raw, fmt_literal, false);
}

int32_t cold_materialize_fmt_str(BodyIR *body, int32_t slot, int32_t kind) {
    if (kind == SLOT_STR) return slot;
    if (kind == SLOT_STR_REF) {
        int32_t dst = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, dst, slot, 0, COLD_STR_SLOT_SIZE);
        return dst;
    }
    if (kind == SLOT_I32_REF) {
        int32_t value = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, value, slot, 0, 4);
        int32_t dst = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
        body_slot_set_type(body, dst, cold_cstr_span("str"));
        int32_t producer =
            body_op(body, BODY_OP_I32_TO_STR, dst, value, 0);
        cold_publish_owned_managed_producer(
            body, 0, dst, SLOT_STR, producer, 0);
        return dst;
    }
    if (kind == SLOT_I64_REF) {
        int32_t value = body_slot(body, SLOT_I64, 8);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, value, slot, 0, 8);
        int32_t dst = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
        body_slot_set_type(body, dst, cold_cstr_span("str"));
        int32_t producer =
            body_op(body, BODY_OP_I64_TO_STR, dst, value, 0);
        cold_publish_owned_managed_producer(
            body, 0, dst, SLOT_STR, producer, 0);
        return dst;
    }
    if (kind == SLOT_I32) {
        int32_t dst = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
        body_slot_set_type(body, dst, cold_cstr_span("str"));
        int32_t producer =
            body_op(body, BODY_OP_I32_TO_STR, dst, slot, 0);
        cold_publish_owned_managed_producer(
            body, 0, dst, SLOT_STR, producer, 0);
        return dst;
    }
    if (kind == SLOT_I64) {
        int32_t dst = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
        body_slot_set_type(body, dst, cold_cstr_span("str"));
        int32_t producer =
            body_op(body, BODY_OP_I64_TO_STR, dst, slot, 0);
        cold_publish_owned_managed_producer(
            body, 0, dst, SLOT_STR, producer, 0);
        return dst;
    }
    die("Fmt interpolation: unsupported type in expression");
    return 0; /* unreachable */
}

bool cold_slot_kind_is_str_like(int32_t kind) {
    return kind == SLOT_STR || kind == SLOT_STR_REF;
}

/* string_abi_contract.nil_compare.cstring_only=1 (docs/cheng-formal-spec.md
   str-nil 语义稳定口径): `str` 的 = nil / == nil / != nil 一律编译期硬错误;
   `cstring` (SLOT_OPAQUE/SLOT_OPAQUE_REF) 不受影响,仍保留 nil 比较。
   nil 字面量在 primary 层恒产出 SLOT_PTR (parse_primary "nil" 分支),没有其它
   合法路径会让一个 str-like 目标/操作数在这里看到 SLOT_PTR 值,故用
   kind==SLOT_PTR 即可精确判定"这是 nil 落到了 str 位置",无需额外的字面量
   来源追踪。单一共享 gate,供 str 的比较/赋值/元素赋值各站调用。*/
static void cold_reject_str_nil(Parser *parser, Span site_token, int32_t value_kind) {
    if (value_kind != SLOT_PTR) return;
    fprintf(stderr, "cheng_cold: ");
    cold_error_loc(parser, site_token);
    fprintf(stderr,
            " str nil is forbidden; use empty string \"\" or Len()==0\n");
    die("str nil is forbidden");
}

int32_t cold_materialize_str_data_ptr(
        BodyIR *body, int32_t slot, int32_t kind,
        const ColdExprResult *source) {
    if (!cold_slot_kind_is_str_like(kind)) die("str data ptr expects str slot");
    int32_t dst = body_slot(body, SLOT_PTR, 8);
    body_slot_set_type(body, dst, cold_cstr_span("cstring"));
    int32_t read_op = body_op3(
        body, BODY_OP_PAYLOAD_LOAD, dst, slot,
        COLD_STR_DATA_OFFSET, 8);
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=40632\n");
    cold_publish_exact_managed_read_or_sentinel(
        body, read_op, COLD_EXACT_READ_OPERAND_A,
        source);
    return dst;
}

int32_t cold_concat_str_slots(BodyIR *body, int32_t left, int32_t right) {
    int32_t dst = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
    body_slot_set_type(body, dst, cold_cstr_span("str"));
    int32_t producer =
        body_op(body, BODY_OP_STR_CONCAT, dst, left, right);
    cold_publish_owned_managed_producer(
        body, 0, dst, SLOT_STR, producer, 0);
    return dst;
}

typedef enum ColdFmtInterpolationScanState {
    COLD_FMT_INTERPOLATION_CODE = 0,
    COLD_FMT_INTERPOLATION_STRING = 1,
    COLD_FMT_INTERPOLATION_CHAR = 2,
    COLD_FMT_INTERPOLATION_LINE_COMMENT = 3,
    COLD_FMT_INTERPOLATION_BLOCK_COMMENT = 4
} ColdFmtInterpolationScanState;

static uint8_t cold_fmt_decode_outer_byte(Span content,
                                          int32_t *cursor,
                                          bool decode_outer_escapes,
                                          bool *from_escape_out) {
    if (!cursor || *cursor < 0 || *cursor >= content.len)
        die("Fmt interpolation decoder cursor invalid");
    if (from_escape_out) *from_escape_out = false;
    uint8_t current = content.ptr[(*cursor)++];
    if (!decode_outer_escapes || current != '\\') return current;
    if (from_escape_out) *from_escape_out = true;
    if (*cursor >= content.len) die("unterminated Fmt interpolation escape");
    uint8_t next = content.ptr[(*cursor)++];
    if (next == 'n') return '\n';
    if (next == 'r') return '\r';
    if (next == 't') return '\t';
    if (next == '0') return '\0';
    if (next == '\\' || next == '"' || next == '{' || next == '}')
        return next;
    if (next == 'x') {
        if (*cursor + 1 >= content.len)
            die("unterminated Fmt interpolation hex escape");
        int32_t hi = cold_hex_nibble(content.ptr[*cursor]);
        int32_t lo = cold_hex_nibble(content.ptr[*cursor + 1]);
        if (hi < 0 || lo < 0)
            die("invalid Fmt interpolation hex escape");
        *cursor += 2;
        return (uint8_t)((hi << 4) | lo);
    }
    die("unsupported Fmt interpolation escape");
    return 0;
}

static bool cold_fmt_source_utf8_valid(Span source) {
    for (int32_t i = 0; i < source.len;) {
        uint8_t first = source.ptr[i++];
        if (first < 0x80) {
            if (first == 0) return false;
            continue;
        }
        int32_t continuation_count = 0;
        uint8_t second_min = 0x80;
        uint8_t second_max = 0xbf;
        if (first >= 0xc2 && first <= 0xdf) {
            continuation_count = 1;
        } else if (first >= 0xe0 && first <= 0xef) {
            continuation_count = 2;
            if (first == 0xe0) second_min = 0xa0;
            if (first == 0xed) second_max = 0x9f;
        } else if (first >= 0xf0 && first <= 0xf4) {
            continuation_count = 3;
            if (first == 0xf0) second_min = 0x90;
            if (first == 0xf4) second_max = 0x8f;
        } else {
            return false;
        }
        if (i + continuation_count > source.len) return false;
        uint8_t second = source.ptr[i];
        if (second < second_min || second > second_max) return false;
        for (int32_t tail = 1; tail < continuation_count; tail++) {
            uint8_t byte = source.ptr[i + tail];
            if (byte < 0x80 || byte > 0xbf) return false;
        }
        i += continuation_count;
    }
    return true;
}

static Span cold_fmt_decode_interpolation(Parser *parser,
                                          Span content,
                                          int32_t expression_start,
                                          bool decode_outer_escapes,
                                          int32_t *close_offset_out,
                                          int32_t **origin_offsets_out) {
    if (!parser || expression_start < 0 ||
        expression_start > content.len || !close_offset_out ||
        !origin_offsets_out)
        die("Fmt interpolation decoder input invalid");
    int32_t max_length = content.len - expression_start;
    uint8_t *decoded = arena_alloc(
        parser->arena, (size_t)max_length + 1);
    int32_t content_source_start =
        cold_parser_source_view_offset(parser->source, content);
    int32_t *origin_offsets = 0;
    if (content_source_start >= 0) {
        origin_offsets = arena_alloc(
            parser->arena,
            ((size_t)max_length + 1) * sizeof(int32_t));
    }
    int32_t cursor = expression_start;
    int32_t write = 0;
    int32_t brace_depth = 0;
    ColdFmtInterpolationScanState state =
        COLD_FMT_INTERPOLATION_CODE;
    bool quoted_escape = false;
    bool code_slash = false;
    bool block_star = false;
    while (cursor < content.len) {
        int32_t raw_start = cursor;
        bool from_outer_escape = false;
        uint8_t current = cold_fmt_decode_outer_byte(
            content, &cursor, decode_outer_escapes,
            &from_outer_escape);
        int32_t raw_end = cursor;
        bool closes_interpolation = false;
        if (state == COLD_FMT_INTERPOLATION_STRING ||
            state == COLD_FMT_INTERPOLATION_CHAR) {
            uint8_t quote = state == COLD_FMT_INTERPOLATION_STRING
                ? '"'
                : '\'';
            if (quoted_escape) {
                quoted_escape = false;
            } else if (current == '\\') {
                quoted_escape = true;
            } else if (current == quote) {
                state = COLD_FMT_INTERPOLATION_CODE;
            } else if (current == '\n' || current == '\r') {
                die("unterminated Fmt interpolation quoted literal");
            }
        } else if (state == COLD_FMT_INTERPOLATION_LINE_COMMENT) {
            if (current == '\n')
                state = COLD_FMT_INTERPOLATION_CODE;
        } else if (state == COLD_FMT_INTERPOLATION_BLOCK_COMMENT) {
            if (block_star && current == '/') {
                state = COLD_FMT_INTERPOLATION_CODE;
                block_star = false;
            } else {
                block_star = current == '*';
            }
        } else {
            if (code_slash) {
                code_slash = false;
                if (current == '/') {
                    state = COLD_FMT_INTERPOLATION_LINE_COMMENT;
                } else if (current == '*') {
                    state = COLD_FMT_INTERPOLATION_BLOCK_COMMENT;
                    block_star = false;
                }
            }
            if (state == COLD_FMT_INTERPOLATION_CODE) {
                if (current == '"') {
                    state = COLD_FMT_INTERPOLATION_STRING;
                    quoted_escape = false;
                } else if (current == '\'') {
                    state = COLD_FMT_INTERPOLATION_CHAR;
                    quoted_escape = false;
                } else if (current == '#') {
                    state = COLD_FMT_INTERPOLATION_LINE_COMMENT;
                } else if (current == '/') {
                    code_slash = true;
                } else if (current == '{') {
                    brace_depth++;
                } else if (current == '}') {
                    if (brace_depth == 0 && !from_outer_escape)
                        closes_interpolation = true;
                    else if (brace_depth > 0)
                        brace_depth--;
                }
            }
        }
        if (closes_interpolation) {
            if (origin_offsets) {
                origin_offsets[write] = cold_parser_origin_offset(
                    parser, content_source_start + raw_start);
            }
            decoded[write] = 0;
            Span decoded_source = {decoded, write};
            if (!cold_fmt_source_utf8_valid(decoded_source))
                die("Fmt interpolation decoded source is not valid UTF-8");
            *close_offset_out = raw_start;
            *origin_offsets_out = origin_offsets;
            return decoded_source;
        }
        if (origin_offsets) {
            int32_t origin_start = cold_parser_origin_offset(
                parser, content_source_start + raw_start);
            int32_t origin_end = cold_parser_origin_offset(
                parser, content_source_start + raw_end);
            if (write > 0 && origin_offsets[write] != origin_start)
                die("Fmt interpolation source map is discontinuous");
            origin_offsets[write] = origin_start;
            origin_offsets[write + 1] = origin_end;
        }
        decoded[write++] = current;
    }
    if (state == COLD_FMT_INTERPOLATION_STRING ||
        state == COLD_FMT_INTERPOLATION_CHAR || quoted_escape)
        die("unterminated Fmt interpolation quoted literal");
    if (state == COLD_FMT_INTERPOLATION_BLOCK_COMMENT)
        die("unterminated Fmt interpolation comment");
    die("unterminated Fmt interpolation");
    return (Span){0};
}

int32_t parse_fmt_literal(Parser *parser, BodyIR *body, Locals *locals, int32_t *kind) {
    Span token = parser_token(parser);
    if (!(token.len >= 2 && token.ptr[0] == '"' && token.ptr[token.len - 1] == '"')) {
        die("Fmt expects a string literal");
    }
    Span content = cold_triple_string_content(parser->arena, token);
    bool raw_backslash = cold_token_is_triple_string(token);
    int32_t current = -1;
    ColdExprResult current_result;
    cold_expr_result_reset(&current_result);
    int32_t chunk_start = 0;
    for (int32_t i = 0; i < content.len;) {
        uint8_t c = content.ptr[i];
        if (c == '\\') {
            if (i + 1 >= content.len) die("unterminated Fmt escape");
            i += 2;
            continue;
        }
        if (c == '{') {
            if (i + 1 < content.len && content.ptr[i + 1] == '{') {
                i += 2;
                continue;
            }
            if (i > chunk_start) {
                int32_t chunk = cold_make_str_literal_slot_mode(parser, body,
                                                                span_sub(content, chunk_start, i),
                                                                true,
                                                                raw_backslash);
                current = current < 0 ? chunk : cold_concat_str_slots(body, current, chunk);
            }
            int32_t expr_start = i + 1;
            int32_t *origin_offsets = 0;
            Span decoded_expr = cold_fmt_decode_interpolation(
                parser, content, expr_start, !raw_backslash,
                &i, &origin_offsets);
            Span expr = span_trim(decoded_expr);
            if (expr.len <= 0) die("empty Fmt interpolation");
            Parser expr_parser = parser_child(parser, expr);
            if (origin_offsets) {
                int32_t trim_start =
                    (int32_t)(expr.ptr - decoded_expr.ptr);
                expr_parser.source_origin =
                    cold_parser_origin_source(parser);
                expr_parser.source_origin_base = 0;
                expr_parser.source_origin_offsets =
                    origin_offsets + trim_start;
            }
            int32_t expr_kind = SLOT_I32;
            ColdExprResult expr_result;
            cold_expr_result_reset(&expr_result);
            int32_t expr_slot = cold_parse_expr_with_result(
                &expr_parser, body, locals, &expr_kind,
                &expr_result);
            parser_ws(&expr_parser);
            if (expr_parser.pos != expr_parser.source.len) {
                die("Fmt interpolation: cannot fully parse expression");
            }
            parser_adopt_expr_resume(parser, &expr_parser);
            ColdExprResult segment_result;
            cold_expr_result_reset(&segment_result);
            if (expr_kind == SLOT_STR ||
                expr_kind == SLOT_STR_REF) {
                if (expr_result.slot != expr_slot ||
                    expr_result.kind != expr_kind ||
                    expr_result.value_def_op_id < 0 ||
                    !cold_exact_op_tuple_matches_result(
                        body, &expr_result)) {
                    fprintf(
                        stderr,
                        "cheng_cold: Fmt managed interpolation rejected function=%.*s expr=%.*s expr_slot=%d expr_kind=%d result_slot=%d result_kind=%d result_def=%d result_type_id=%d result_function=%d result_place=%d result_ownership=%d result_origin=%d\n",
                        (int)body->debug_name.len,
                        body->debug_name.ptr
                            ? body->debug_name.ptr
                            : (const uint8_t *)"",
                        (int)expr.len, expr.ptr,
                        expr_slot, expr_kind,
                        expr_result.slot, expr_result.kind,
                        expr_result.value_def_op_id,
                        expr_result.exact_type_id,
                        expr_result.producer_function_row,
                        expr_result.place_kind,
                        expr_result.ownership,
                        expr_result.origin_id);
                    fprintf(stderr, "cheng_cold: ");
                    cold_error_loc(&expr_parser, expr);
                    fprintf(stderr,
                            " Fmt managed interpolation source location\n");
                    cold_print_context(&expr_parser, expr);
                    die("Fmt managed interpolation lacks exact value definition");
                }
                if (expr_kind == SLOT_STR_REF) {
                    int32_t projected =
                        body_slot(
                            body, SLOT_STR,
                            COLD_STR_SLOT_SIZE);
                    body_slot_set_type(
                        body, projected,
                        cold_cstr_span("str"));
                    int32_t projection_op = body_op3(
                        body, BODY_OP_PAYLOAD_LOAD,
                        projected, expr_slot, 0,
                        COLD_STR_SLOT_SIZE);
                    expr_result =
                        cold_exact_managed_field_borrow(
                            body, parser->symbols,
                            &expr_result, projected,
                            SLOT_STR, projection_op);
                    expr_slot = projected;
                    expr_kind = SLOT_STR;
                }
                if (expr_result.place_kind ==
                        COLD_EXPR_PLACE_TEMPORARY &&
                    (expr_result.ownership ==
                         COLD_EXPR_OWN_PLAIN ||
                     expr_result.ownership ==
                         COLD_EXPR_OWN_MOVE)) {
                    segment_result = expr_result;
                } else {
                    /* Fmt reads interpolation bytes and STR_CONCAT creates a
                       fresh owner.  Retaining a borrowed projection here
                       would silently turn `var str` into an owner, which the
                       language ownership model forbids.  Keep the exact
                       borrowed/local definition as a read-only operand; the
                       single-segment case is materialized below. */
                    segment_result = expr_result;
                }
            } else {
                expr_slot = cold_materialize_fmt_str(
                    body, expr_slot, expr_kind);
            }
            if (current < 0) {
                current = expr_slot;
                current_result = segment_result;
            } else {
                current = cold_concat_str_slots(
                    body, current, expr_slot);
                cold_expr_result_reset(&current_result);
            }
            i++;
            chunk_start = i;
            continue;
        }
        if (c == '}') {
            if (i + 1 < content.len && content.ptr[i + 1] == '}') {
                i += 2;
                continue;
            }
            die("unmatched } in Fmt literal");
        }
        i++;
    }
    if (chunk_start < content.len) {
        int32_t chunk = cold_make_str_literal_slot_mode(parser, body,
                                                        span_sub(content, chunk_start, content.len),
                                                        true,
                                                        raw_backslash);
        current = current < 0 ? chunk : cold_concat_str_slots(body, current, chunk);
    }
    if (current < 0) {
        current = cold_make_str_literal_slot_mode(parser, body, (Span){0}, true, raw_backslash);
    }
    if (current_result.slot == current &&
        current_result.kind == SLOT_STR &&
        current_result.value_def_op_id >= 0) {
        if (current_result.place_kind ==
                COLD_EXPR_PLACE_TEMPORARY &&
            (current_result.ownership ==
                 COLD_EXPR_OWN_PLAIN ||
             current_result.ownership ==
                 COLD_EXPR_OWN_MOVE)) {
            cold_expr_result_publish(
                body, &current_result);
        } else {
            int32_t empty =
                cold_make_str_literal_slot_mode(
                    parser, body, (Span){0},
                    true, raw_backslash);
            current =
                cold_concat_str_slots(
                    body, empty, current);
        }
    }
    *kind = SLOT_STR;
    return current;
}

bool cold_is_scalar_identity_cast(Span token) {
    return span_eq(token, "int32") || span_eq(token, "int") ||
           span_eq(token, "Int32") || span_eq(token, "Int") ||
           span_eq(token, "bool") || span_eq(token, "Bool") ||
           span_eq(token, "uint8") || span_eq(token, "Uint8") ||
           span_eq(token, "int8") || span_eq(token, "Int8") ||
           span_eq(token, "char") || span_eq(token, "Char") ||
           span_eq(token, "int16") || span_eq(token, "Int16") ||
           span_eq(token, "uint16") || span_eq(token, "Uint16") ||
           span_eq(token, "UInt16") ||
           span_eq(token, "uint32") || span_eq(token, "Uint32") ||
           span_eq(token, "uint64") || span_eq(token, "Uint64") ||
           span_eq(token, "UInt64") ||
           span_eq(token, "int64") || span_eq(token, "Int64") ||
           span_eq(token, "float64") || span_eq(token, "Float64") ||
           span_eq(token, "float32") || span_eq(token, "Float32");
}

bool cold_is_i32_to_str_intrinsic(Span name) {
    return span_eq(name, "int64ToStr") || span_eq(name, "uint64ToStr") ||
           span_eq(name, "Int64ToStr") || span_eq(name, "Uint64ToStr") ||
           span_eq(name, "IntToStr") || span_eq(name, "Uint64ToStr") ||
           span_eq(name, "strings.int64ToStr") || span_eq(name, "strings.uint64ToStr") ||
           span_eq(name, "strings.Int64ToStr") || span_eq(name, "strings.Uint64ToStr") ||
           span_eq(name, "strings.IntToStr") || span_eq(name, "strings.Uint64ToStr");
}

bool cold_try_parse_int_intrinsic(BodyIR *body, Span name,
                                         int32_t arg_start, int32_t arg_count,
                                         const ColdExprResult *arg_results,
                                         int32_t *slot_out, int32_t *kind_out) {
    if (!(span_eq(name, "strutil.ParseInt") || span_eq(name, "strutils.ParseInt") ||
          span_eq(name, "strings.ParseInt") || span_eq(name, "ParseInt"))) {
        return false;
    }
    if (arg_count != 1) die("ParseInt intrinsic arity mismatch");
    int32_t arg = body->call_arg_slot[arg_start];
    if (body->slot_kind[arg] != SLOT_STR && body->slot_kind[arg] != SLOT_STR_REF) {
        die("ParseInt expects str");
    }
    int32_t slot = body_slot(body, SLOT_I32, 4);
    int32_t read_op =
        body_op(body, BODY_OP_PARSE_INT, slot, arg, 0);
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=41078\n");
    cold_publish_exact_managed_read_or_sentinel(
        body, read_op, COLD_EXACT_READ_OPERAND_A,
        arg_results ? &arg_results[0] : 0);
    if (kind_out) *kind_out = SLOT_I32;
    *slot_out = slot;
    return true;
}

bool cold_try_str_concat_intrinsic(BodyIR *body, Symbols *symbols, Span name,
                                          int32_t arg_start, int32_t arg_count,
                                          const ColdExprResult *arg_results,
                                          int32_t *slot_out, int32_t *kind_out,
                                          ColdExprResult *result_out) {
    if (!(span_eq(name, "strings.ConcatStr") || span_eq(name, "strings.concatStr") ||
          span_eq(name, "ConcatStr") || span_eq(name, "concatStr"))) {
        return false;
    }
    if (arg_count != 2) die("ConcatStr intrinsic arity mismatch");
    int32_t left = body->call_arg_slot[arg_start];
    int32_t right = body->call_arg_slot[arg_start + 1];
    if (!cold_slot_kind_is_str_like(body->slot_kind[left]) ||
        !cold_slot_kind_is_str_like(body->slot_kind[right])) {
        die("ConcatStr expects str operands");
    }
    if (!arg_results)
        die("ConcatStr lacks exact argument authority");
    ColdExprResult left_source = arg_results[0];
    ColdExprResult right_source = arg_results[1];
    if (!cold_exact_op_tuple_matches_result(body, &left_source) ||
        !cold_exact_op_tuple_matches_result(body, &right_source)) {
        die("ConcatStr exact argument authority is invalid");
    }
    if (body->slot_kind[left] == SLOT_STR_REF) {
        left_source = cold_exact_managed_ref_value_borrow(
            body, symbols, &left_source);
        left = left_source.slot;
    }
    if (body->slot_kind[right] == SLOT_STR_REF) {
        right_source = cold_exact_managed_ref_value_borrow(
            body, symbols, &right_source);
        right = right_source.slot;
    }
    int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
    body_slot_set_type(body, slot, cold_cstr_span("str"));
    int32_t producer = body_op(body, BODY_OP_STR_CONCAT, slot, left, right);
    cold_publish_exact_managed_read(
        body, producer, COLD_EXACT_READ_OPERAND_A,
        &left_source);
    cold_publish_exact_managed_read(
        body, producer, COLD_EXACT_READ_OPERAND_B,
        &right_source);
    cold_publish_owned_managed_producer(
        body, symbols, slot, SLOT_STR, producer, result_out);
    /* STR_CONCAT allocates a new buffer and only reads both operands.
       Operand lifetime therefore remains independent; cleanup, not concat,
       releases an owned temporary after its last use. */
    if (kind_out) *kind_out = SLOT_STR;
    *slot_out = slot;
    return true;
}

bool cold_try_str_join_intrinsic(BodyIR *body, Symbols *symbols, Span name,
                                        int32_t arg_start, int32_t arg_count,
                                        const ColdExprResult *arg_results,
                                        int32_t *slot_out, int32_t *kind_out,
                                        ColdExprResult *result_out) {
    if (!(span_eq(name, "strutil.Join") || span_eq(name, "strutils.Join") ||
          span_eq(name, "Join"))) {
        return false;
    }
    if (arg_count != 2) return 0; /* skip Join arity mismatch */;
    int32_t items = body->call_arg_slot[arg_start];
    int32_t sep = body->call_arg_slot[arg_start + 1];
    if (body->slot_kind[items] != SLOT_SEQ_STR && body->slot_kind[items] != SLOT_SEQ_STR_REF) {
        return 0; /* skip non-str join */;
    }
    if (body->slot_kind[sep] != SLOT_STR && body->slot_kind[sep] != SLOT_STR_REF) {
        die("Join separator must be str");
    }
    int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
    body_slot_set_type(body, slot, cold_cstr_span("str"));
    int32_t producer =
        body_op(body, BODY_OP_STR_JOIN, slot, items, sep);
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=41161\n");
    cold_publish_exact_managed_read_or_sentinel(
        body, producer, COLD_EXACT_READ_OPERAND_A,
        arg_results ? &arg_results[0] : 0);
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=41164\n");
    cold_publish_exact_managed_read_or_sentinel(
        body, producer, COLD_EXACT_READ_OPERAND_B,
        arg_results ? &arg_results[1] : 0);
    cold_publish_owned_managed_producer(
        body, symbols, slot, SLOT_STR, producer, result_out);
    if (kind_out) *kind_out = SLOT_STR;
    *slot_out = slot;
    return true;
}

bool cold_try_str_split_intrinsic(BodyIR *body, Symbols *symbols, Span name,
                                         int32_t arg_start, int32_t arg_count,
                                         const ColdExprResult *arg_results,
                                         int32_t *slot_out, int32_t *kind_out,
                                         ColdExprResult *result_out) {
    if (!(span_eq(name, "strutil.Split") || span_eq(name, "strutils.Split") ||
          span_eq(name, "Split"))) {
        return false;
    }
    if (arg_count != 2) die("Split intrinsic arity mismatch");
    int32_t text = body->call_arg_slot[arg_start];
    int32_t sep = body->call_arg_slot[arg_start + 1];
    if (body->slot_kind[text] != SLOT_STR && body->slot_kind[text] != SLOT_STR_REF) {
        die("Split text must be str");
    }
    if (body->slot_kind[sep] != SLOT_I32) die("Split separator must be char/int32");
    int32_t slot = body_slot(body, SLOT_SEQ_STR, 16);
    body_slot_set_type(body, slot, cold_cstr_span("str[]"));
    int32_t producer = body_op(body, BODY_OP_STR_SPLIT_CHAR, slot, text, sep);
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=41193\n");
    cold_publish_exact_managed_read_or_sentinel(
        body, producer, COLD_EXACT_READ_OPERAND_A,
        arg_results ? &arg_results[0] : 0);
    cold_publish_owned_managed_producer(
        body, symbols, slot, SLOT_SEQ_STR, producer, result_out);
    if (kind_out) *kind_out = SLOT_SEQ_STR;
    *slot_out = slot;
    return true;
}

bool cold_try_str_strip_intrinsic(BodyIR *body, Symbols *symbols, Span name,
                                         int32_t arg_start, int32_t arg_count,
                                         const ColdExprResult *arg_results,
                                         int32_t *slot_out, int32_t *kind_out,
                                         ColdExprResult *result_out) {
    if (!(span_eq(name, "strutil.Strip") || span_eq(name, "strutils.Strip") ||
          span_eq(name, "Strip"))) {
        return false;
    }
    if (arg_count != 1) die("Strip intrinsic arity mismatch");
    int32_t text = body->call_arg_slot[arg_start];
    if (body->slot_kind[text] != SLOT_STR && body->slot_kind[text] != SLOT_STR_REF) {
        /* Non-str Strip: return 0 */
        return 0;
    }
    int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
    body_slot_set_type(body, slot, cold_cstr_span("str"));
    int32_t producer = body_op(body, BODY_OP_STR_STRIP, slot, text, 0);
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=41221\n");
    cold_publish_exact_managed_read_or_sentinel(
        body, producer, COLD_EXACT_READ_OPERAND_A,
        arg_results ? &arg_results[0] : 0);
    cold_publish_owned_managed_producer(
        body, symbols, slot, SLOT_STR, producer, result_out);
    if (kind_out) *kind_out = SLOT_STR;
    *slot_out = slot;
    return true;
}

bool cold_try_str_len_intrinsic(BodyIR *body, Span name,
                                       int32_t arg_start, int32_t arg_count,
                                       const ColdExprResult *arg_results,
                                       int32_t *slot_out, int32_t *kind_out) {
    if (!(span_eq(name, "strings.Len") || span_eq(name, "strutil.Len") ||
          span_eq(name, "strutils.Len") || span_eq(name, "Len") ||
          span_eq(name, "StrLenFast") || span_eq(name, "strLenFast") ||
          span_eq(name, "system.StrLenFast") || span_eq(name, "system.strLenFast"))) {
        return false;
    }
    if (arg_count != 1) die("Len intrinsic arity mismatch");
    int32_t text = body->call_arg_slot[arg_start];
    if (body->slot_kind[text] != SLOT_STR && body->slot_kind[text] != SLOT_STR_REF) {
        /* Non-str Len: return 0 */
        *kind_out = SLOT_I32;
        return 0;
    }
    int32_t slot = body_slot(body, SLOT_I32, 4);
    int32_t read_op =
        body_op(body, BODY_OP_STR_LEN, slot, text, 0);
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=41251\n");
    cold_publish_exact_managed_read_or_sentinel(
        body, read_op, COLD_EXACT_READ_OPERAND_A,
        arg_results ? &arg_results[0] : 0);
    if (kind_out) *kind_out = SLOT_I32;
    *slot_out = slot;
    return true;
}

bool cold_try_str_slice_intrinsic(BodyIR *body, Symbols *symbols, Span name,
                                         int32_t arg_start, int32_t arg_count,
                                         const ColdExprResult *arg_results,
                                         int32_t *slot_out, int32_t *kind_out,
                                         ColdExprResult *result_out) {
    /* Only count-based slice helpers may map onto BODY_OP_STR_SLICE(text,
       start, len). strutil.SliceStr takes an INCLUSIVE STOP index — its
       library body must run instead (treating stop as a count fired the
       offset+count<=len bounds brk on perfectly valid calls). */
    if (!(span_eq(name, "strings.SliceBytes") ||
          span_eq(name, "SliceBytes") ||
          span_eq(name, "sliceBytes") || span_eq(name, "strutil.SliceBytes") ||
          span_eq(name, "strutils.SliceBytes"))) {
        return false;
    }
    if (arg_count != 3) {
        if (ColdImportBodyCompilationActive) {
            *slot_out = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE); if (kind_out) *kind_out = SLOT_STR; return true;
        }
        die("SliceBytes intrinsic arity mismatch");
    }
    int32_t text = body->call_arg_slot[arg_start];
    int32_t start = body->call_arg_slot[arg_start + 1];
    int32_t len = body->call_arg_slot[arg_start + 2];
    if (body->slot_kind[text] != SLOT_STR && body->slot_kind[text] != SLOT_STR_REF) {
        /* Non-str SliceBytes: return empty */
        *kind_out = SLOT_STR;
        return 0;
    }
    if (body->slot_kind[start] != SLOT_I32 || body->slot_kind[len] != SLOT_I32) {
        if (ColdImportBodyCompilationActive) {
            *slot_out = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE); if (kind_out) *kind_out = SLOT_STR; return true;
        }
        die("SliceBytes start/len must be int32");
    }
    int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
    body_slot_set_type(body, slot, cold_cstr_span("str"));
    int32_t producer = body_op3(body, BODY_OP_STR_SLICE, slot, text, start, len);
    if (!arg_results ||
        arg_results[0].slot != text ||
        arg_results[0].kind !=
            body->slot_kind[text] ||
        arg_results[0].value_def_op_id < 0 ||
        arg_results[0].value_def_op_id >= producer ||
        (arg_results[0].ownership !=
             COLD_EXPR_OWN_BORROW_SHARED &&
         arg_results[0].ownership !=
             COLD_EXPR_OWN_BORROW_UNIQUE &&
         arg_results[0].ownership !=
             COLD_EXPR_OWN_PLAIN &&
         arg_results[0].ownership !=
             COLD_EXPR_OWN_MOVE) ||
        !cold_exact_op_tuple_matches_result(
            body, &arg_results[0]) ||
        !cold_exact_definition_reaches_consumer(
            body,
            arg_results[0].value_def_op_id,
            producer)) {
        die("STR_SLICE view lacks exact source authority");
    }
    cold_publish_exact_managed_read(
        body, producer, COLD_EXACT_READ_OPERAND_A,
        &arg_results[0]);
    cold_publish_exact_managed_definition(
        body, symbols, slot, SLOT_STR,
        producer, COLD_EXPR_OWN_BORROW_SHARED,
        result_out);
    body->op_source_value_def_op_id[
        producer] =
        arg_results[0].value_def_op_id;
    if (kind_out) *kind_out = SLOT_STR;
    *slot_out = slot;
    return true;
}

bool cold_name_is_any_result_intrinsic(Span name) {
    return span_eq(name, "IsOk") || span_eq(name, "result.IsOk") ||
           span_eq(name, "IsErr") || span_eq(name, "result.IsErr") ||
           span_eq(name, "Value") || span_eq(name, "result.Value") ||
           span_eq(name, "Error") || span_eq(name, "result.Error") ||
           span_eq(name, "ErrorText") || span_eq(name, "result.ErrorText") ||
           span_eq(name, "ErrorInfoOf") || span_eq(name, "result.ErrorInfoOf") ||
           span_eq(name, "ErrorMessage") || span_eq(name, "result.ErrorMessage") ||
           span_eq(name, "ErrorFormat") || span_eq(name, "result.ErrorFormat");
}

int32_t cold_load_object_field_slot(BodyIR *body, Symbols *symbols,
                                    int32_t src_slot, ObjectField *field,
                                    int32_t *producer_out) {
    int32_t dst = body_slot(body, field->kind, cold_value_slot_size_for_payload_field(field));
    if (field->kind == SLOT_SEQ_OPAQUE ||
        field->kind == SLOT_SEQ_OPAQUE_REF) {
        body_slot_set_seq_opaque_type(
            body, symbols, dst, field->type_name);
    } else {
        body_slot_set_type(body, dst, field->type_name);
    }
    if (field->kind == SLOT_ARRAY_I32) body_slot_set_array_len(body, dst, field->array_len);
    /* Publish the projected carrier's storage lane at creation: every
       later read edge through this slot proves against it. */
    { int32_t dst_storage = cold_exact_storage_authority_for_slot(
          symbols, body, dst, field->kind);
      if (dst_storage != COLD_MANAGED_STORAGE_UNKNOWN)
          body->slot_managed_storage_kind[dst] = dst_storage; }
    int32_t producer = body_op3(
        body, BODY_OP_PAYLOAD_LOAD, dst, src_slot,
        field->offset, field->size);
    if (producer_out) *producer_out = producer;
    return dst;
}

static ColdExprResult cold_exact_managed_field_borrow(
        BodyIR *body, Symbols *symbols,
        const ColdExprResult *source,
        int32_t field_slot, int32_t field_kind,
        int32_t projection_op) {
    ColdExprResult result;
    cold_expr_result_reset(&result);
    bool projection_kind =
        body && projection_op >= 0 &&
        projection_op < body->op_count &&
        (body->op_kind[projection_op] == BODY_OP_PAYLOAD_LOAD ||
         body->op_kind[projection_op] == BODY_OP_FIELD_REF ||
         body->op_kind[projection_op] ==
             BODY_OP_SEQ_STR_INDEX_DYNAMIC ||
         body->op_kind[projection_op] ==
             BODY_OP_SEQ_OPAQUE_INDEX_DYNAMIC ||
         body->op_kind[projection_op] ==
             BODY_OP_SEQ_OPAQUE_INDEX_REF_DYNAMIC ||
         body->op_kind[projection_op] ==
             BODY_OP_ARRAY_OPAQUE_INDEX_DYNAMIC ||
         body->op_kind[projection_op] ==
             BODY_OP_ARRAY_OPAQUE_INDEX_REF_DYNAMIC);
    bool existing_projection_authority =
        body && symbols && source &&
        source->slot >= 0 &&
        source->slot < body->slot_count &&
        source->value_def_op_id >= 0 &&
        source->value_def_op_id < projection_op &&
        cold_exact_op_tuple_matches_result(body, source) &&
        field_slot >= 0 && field_slot < body->slot_count &&
        projection_op >= 0 &&
        projection_op < body->op_count &&
        projection_kind &&
        body->op_dst[projection_op] == field_slot &&
        body->op_a[projection_op] == source->slot &&
        body->op_value_def_slot[projection_op] == field_slot &&
        body->op_value_def_origin_id[projection_op] ==
            source->value_def_op_id &&
        cold_exact_read_source(
            body, projection_op,
            COLD_EXACT_READ_OPERAND_A) ==
            source->value_def_op_id &&
        ((body->op_value_def_ownership[projection_op] ==
              COLD_EXPR_OWN_BORROW_SHARED &&
          cold_exact_shared_projection_edge_valid(
              body, symbols, projection_op)) ||
         (body->op_value_def_ownership[projection_op] ==
              COLD_EXPR_OWN_BORROW_UNIQUE &&
          cold_exact_var_projection_definition_valid(
              body, symbols, projection_op)));
    if (!body || !source ||
        source->slot < 0 || source->slot >= body->slot_count ||
        source->value_def_op_id < 0 ||
        source->value_def_op_id >= projection_op ||
        source->kind != body->slot_kind[source->slot] ||
        !cold_exact_op_tuple_matches_result(body, source) ||
        (source->ownership != COLD_EXPR_OWN_PLAIN &&
         source->ownership != COLD_EXPR_OWN_MOVE &&
         source->ownership != COLD_EXPR_OWN_BORROW_SHARED &&
         source->ownership != COLD_EXPR_OWN_BORROW_UNIQUE) ||
        field_slot < 0 || field_slot >= body->slot_count ||
        body->slot_kind[field_slot] != field_kind ||
        projection_op < 0 || projection_op >= body->op_count ||
        !projection_kind ||
        body->op_dst[projection_op] != field_slot ||
        body->op_a[projection_op] != source->slot ||
        (!existing_projection_authority &&
         (!cold_exact_op_tuple_is_sentinel(body, projection_op) ||
          (!cold_exact_slot_authority_is_sentinel(body, field_slot) &&
           body->slot_managed_storage_kind[field_slot] ==
               COLD_MANAGED_STORAGE_UNKNOWN)))) {
        bool have_body = body != NULL;
        bool src_slot_ok =
            have_body && source && source->slot >= 0 &&
            source->slot < body->slot_count;
        bool proj_ok =
            have_body && projection_op >= 0 &&
            projection_op < body->op_count;
        fprintf(
            stderr,
            "cheng_cold: managed field projection source missing"
            " function=%.*s source_slot=%d source_kind=%d"
            " source_type=%.*s source_own=%d source_def=%d"
            " field_slot=%d field_kind=%d field_type=%.*s"
            " projection=%d projection_kind=%d proj_kind_ok=%d"
            " tuple_ok=%d proj_dst=%d proj_a=%d"
            " proj_tuple_sentinel=%d field_authority_sentinel=%d\n",
            have_body ? (int)body->debug_name.len : 0,
            (have_body && body->debug_name.ptr)
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            source ? source->slot : -1,
            source ? source->kind : -1,
            src_slot_ok ? (int)body->slot_type[source->slot].len : 0,
            (src_slot_ok && body->slot_type[source->slot].ptr)
                ? body->slot_type[source->slot].ptr
                : (const uint8_t *)"",
            source ? source->ownership : -1,
            source ? source->value_def_op_id : -1,
            field_slot, field_kind,
            (have_body && field_slot >= 0 && field_slot < body->slot_count)
                ? (int)body->slot_type[field_slot].len
                : 0,
            (have_body && field_slot >= 0 &&
             field_slot < body->slot_count &&
             body->slot_type[field_slot].ptr)
                ? body->slot_type[field_slot].ptr
                : (const uint8_t *)"",
            projection_op,
            proj_ok ? body->op_kind[projection_op] : -1,
            projection_kind ? 1 : 0,
            (have_body && source &&
             cold_exact_op_tuple_matches_result(body, source)) ? 1 : 0,
            proj_ok ? body->op_dst[projection_op] : -1,
            proj_ok ? body->op_a[projection_op] : -1,
            (proj_ok &&
             cold_exact_op_tuple_is_sentinel(body, projection_op)) ? 1 : 0,
            (have_body && field_slot >= 0 &&
             field_slot < body->slot_count &&
             cold_exact_slot_authority_is_sentinel(body, field_slot)) ? 1 : 0);
        die("managed field projection lacks exact source definition");
    }
    int32_t storage =
        cold_exact_storage_authority_for_slot(
            symbols, body, field_slot, field_kind);
    int32_t exact_type_id =
        cold_exact_managed_type_id(
            symbols, body, field_slot, field_kind);
    if (storage == COLD_MANAGED_STORAGE_UNKNOWN) {
        fprintf(
            stderr,
            "cheng_cold: managed field projection unsupported "
            "body=%.*s source_slot=%d source_kind=%d "
            "source_type=%.*s field_slot=%d field_kind=%d "
            "field_size=%d field_type=%.*s exact_type_id=%d\n",
            (int)body->debug_name.len,
            body->debug_name.ptr
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            source->slot,
            source->kind,
            (int)body->slot_type[source->slot].len,
            body->slot_type[source->slot].ptr
                ? body->slot_type[source->slot].ptr
                : (const uint8_t *)"",
            field_slot,
            field_kind,
            body->slot_size[field_slot],
            (int)body->slot_type[field_slot].len,
            body->slot_type[field_slot].ptr
                ? body->slot_type[field_slot].ptr
                : (const uint8_t *)"",
            exact_type_id);
        die("managed field projection kind is unsupported");
    }
    if (body->op_kind[projection_op] ==
            BODY_OP_SEQ_OPAQUE_INDEX_DYNAMIC &&
        field_kind == SLOT_OBJECT &&
        !cold_exact_opaque_sequence_object_projection_matches(
            symbols, body, source, field_slot,
            exact_type_id, storage, projection_op)) {
        die("managed sequence index TypeId/layout mismatch");
    }
    if (exact_type_id < 0 || body->producer_function_row < 0) {
        fprintf(
            stderr,
            "cheng_cold: managed field projection identity missing"
            " function=%.*s source_slot=%d source_kind=%d"
            " field_slot=%d field_kind=%d field_type=%.*s"
            " source_def=%d projection=%d\n",
            (int)body->debug_name.len,
            body->debug_name.ptr
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            source->slot, source->kind,
            field_slot, field_kind,
            (int)body->slot_type[field_slot].len,
            body->slot_type[field_slot].ptr
                ? body->slot_type[field_slot].ptr
                : (const uint8_t *)"",
            source->value_def_op_id, projection_op);
        die("managed field projection TypeId/function row is missing");
    }

    if (existing_projection_authority) {
        if (body->op_value_def_exact_type_id[projection_op] !=
                exact_type_id ||
            body->slot_exact_type_id[field_slot] !=
                exact_type_id ||
            body->slot_managed_storage_kind[field_slot] !=
                storage ||
            !cold_exact_result_from_definition(
                body, field_slot, projection_op,
                &result)) {
            die("managed field projection existing authority drifted");
        }
        return result;
    }

    if (cold_exact_managed_read_operand_allowed(
            body->op_kind[projection_op],
            COLD_EXACT_READ_OPERAND_A)) {
        int32_t published = cold_exact_read_source(
            body, projection_op,
            COLD_EXACT_READ_OPERAND_A);
        if (published == -1) {
            cold_publish_exact_managed_read(
                body, projection_op,
                COLD_EXACT_READ_OPERAND_A, source);
        } else if (published != source->value_def_op_id) {
            die("managed field projection read authority drifted");
        }
    }

    body->op_value_def_slot[projection_op] = field_slot;
    body->op_value_def_exact_type_id[projection_op] = exact_type_id;
    body->op_value_def_producer_function_row[projection_op] =
        body->producer_function_row;
    body->op_value_def_place_kind[projection_op] =
        COLD_EXPR_PLACE_BORROW_PROJECTION;
    body->op_value_def_ownership[projection_op] =
        COLD_EXPR_OWN_BORROW_SHARED;
    body->op_value_def_origin_id[projection_op] =
        source->value_def_op_id;
    body->slot_place_kind[field_slot] =
        COLD_EXPR_PLACE_BORROW_PROJECTION;
    body->slot_exact_type_id[field_slot] = exact_type_id;
    body->slot_origin_id[field_slot] =
        source->value_def_op_id;
    /* The re-binding drift check above requires the stamped lane to equal
       the proven authority; publish it with the rest of the slot identity so
       a nominal (OBJECT) field carrier does not stay UNKNOWN past the
       projection that classified it. */
    body->slot_managed_storage_kind[field_slot] = storage;

    result.slot = field_slot;
    result.kind = field_kind;
    result.value_def_op_id = projection_op;
    result.exact_type_id = exact_type_id;
    result.producer_function_row = body->producer_function_row;
    result.place_kind = COLD_EXPR_PLACE_BORROW_PROJECTION;
    result.ownership = COLD_EXPR_OWN_BORROW_SHARED;
    result.origin_id = source->value_def_op_id;
    cold_expr_borrow_root_publish(
        body, symbols, &result);
    return result;
}

/* Publish one physical field transfer while constructing a complete owned
   object decomposition.  The caller commits the parent consume only after
   every managed field has been emitted; this row owns the transferred child
   immediately, but cannot by itself claim that the aggregate is closed. */
static ColdExprResult cold_exact_managed_drop_field_move(
        BodyIR *body, Symbols *symbols,
        const ColdExprResult *source,
        int32_t field_slot, int32_t field_kind,
        int32_t projection_op) {
    ColdExprResult result;
    cold_expr_result_reset(&result);
    if (!body || !symbols || !source ||
        source->slot < 0 ||
        source->slot >= body->slot_count ||
        source->value_def_op_id < 0 ||
        source->value_def_op_id >= projection_op ||
        source->kind != body->slot_kind[source->slot] ||
        (source->ownership != COLD_EXPR_OWN_PLAIN &&
         source->ownership != COLD_EXPR_OWN_MOVE) ||
        !cold_exact_op_tuple_matches_result(body, source) ||
        !cold_exact_definition_is_live_before_op(
            body, source->value_def_op_id,
            projection_op) ||
        field_slot < 0 || field_slot >= body->slot_count ||
        body->slot_kind[field_slot] != field_kind ||
        projection_op < 0 ||
        projection_op >= body->op_count ||
        body->op_kind[projection_op] !=
            BODY_OP_PAYLOAD_LOAD ||
        body->op_dst[projection_op] != field_slot ||
        body->op_a[projection_op] != source->slot ||
        !cold_exact_op_tuple_is_sentinel(
            body, projection_op) ||
        !cold_exact_slot_authority_is_sentinel(
            body, field_slot)) {
        fprintf(
            stderr,
            "cheng_cold: field move rejected body=%.*s source_slot=%d source_kind=%d source_type=%.*s source_def=%d source_place=%d source_ownership=%d source_consume=%d source_tuple=%d source_live=%d field_slot=%d field_kind=%d field_type=%.*s field_slot_kind=%d projection=%d projection_kind=%d projection_a=%d projection_dst=%d projection_sentinel=%d field_sentinel=%d\n",
            body ? (int)body->debug_name.len : 0,
            body && body->debug_name.ptr
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            source ? source->slot : -1,
            source ? source->kind : -1,
            body && source && source->slot >= 0 &&
                    source->slot < body->slot_count
                ? (int)body->slot_type[source->slot].len : 0,
            body && source && source->slot >= 0 &&
                    source->slot < body->slot_count &&
                    body->slot_type[source->slot].ptr
                ? body->slot_type[source->slot].ptr
                : (const uint8_t *)"",
            source ? source->value_def_op_id : -1,
            source ? source->place_kind
                   : COLD_EXPR_PLACE_INVALID,
            source ? source->ownership
                   : COLD_EXPR_OWN_INVALID,
            body && source &&
                    source->value_def_op_id >= 0 &&
                    source->value_def_op_id <
                        body->op_count
                ? body->op_value_def_consume_op_index_plus_one[
                      source->value_def_op_id]
                : -1,
            body && source
                ? (cold_exact_op_tuple_matches_result(
                       body, source) ? 1 : 0)
                : 0,
            body && source && projection_op >= 0
                ? (cold_exact_definition_is_live_before_op(
                       body, source->value_def_op_id,
                       projection_op) ? 1 : 0)
                : 0,
            field_slot, field_kind,
            body && field_slot >= 0 && field_slot < body->slot_count
                ? (int)body->slot_type[field_slot].len : 0,
            body && field_slot >= 0 && field_slot < body->slot_count &&
                    body->slot_type[field_slot].ptr
                ? body->slot_type[field_slot].ptr
                : (const uint8_t *)"",
            body && field_slot >= 0 && field_slot < body->slot_count
                ? body->slot_kind[field_slot] : -1,
            projection_op,
            body && projection_op >= 0 &&
                    projection_op < body->op_count
                ? body->op_kind[projection_op]
                : -1,
            body && projection_op >= 0 &&
                    projection_op < body->op_count
                ? body->op_a[projection_op]
                : -1,
            body && projection_op >= 0 &&
                    projection_op < body->op_count
                ? body->op_dst[projection_op]
                : -1,
            body && projection_op >= 0 &&
                    projection_op < body->op_count
                ? (cold_exact_op_tuple_is_sentinel(
                       body, projection_op) ? 1 : 0)
                : 0,
            body && field_slot >= 0 && field_slot < body->slot_count
                ? (cold_exact_slot_authority_is_sentinel(
                       body, field_slot) ? 1 : 0)
                : 0);
        die("managed field move lacks exact owned source");
    }
    int32_t storage =
        cold_exact_managed_storage_for_slot(
            symbols, body, field_slot, field_kind);
    int32_t exact_type_id =
        cold_exact_managed_type_id(
            symbols, body, field_slot, field_kind);
    if (storage == COLD_MANAGED_STORAGE_UNKNOWN ||
        exact_type_id < 0 ||
        body->producer_function_row < 0) {
        fprintf(
            stderr,
            "cheng_cold: managed field move authority missing"
            " function=%.*s source_slot=%d source_kind=%d"
            " source_type=%.*s source_def=%d"
            " field_slot=%d field_kind=%d field_size=%d"
            " field_type=%.*s storage=%d exact_type_id=%d"
            " projection=%d producer_row=%d\n",
            (int)body->debug_name.len,
            body->debug_name.ptr
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            source->slot, source->kind,
            (int)body->slot_type[source->slot].len,
            body->slot_type[source->slot].ptr
                ? body->slot_type[source->slot].ptr
                : (const uint8_t *)"",
            source->value_def_op_id,
            field_slot, field_kind,
            body->slot_size[field_slot],
            (int)body->slot_type[field_slot].len,
            body->slot_type[field_slot].ptr
                ? body->slot_type[field_slot].ptr
                : (const uint8_t *)"",
            storage, exact_type_id,
            projection_op,
            body->producer_function_row);
        die("managed field move type authority is missing");
    }
    cold_publish_exact_managed_read(
        body, projection_op,
        COLD_EXACT_READ_OPERAND_A, source);
    body->op_value_def_slot[projection_op] =
        field_slot;
    body->op_value_def_exact_type_id[projection_op] =
        exact_type_id;
    body->op_value_def_producer_function_row[
        projection_op] = body->producer_function_row;
    body->op_value_def_place_kind[projection_op] =
        COLD_EXPR_PLACE_TEMPORARY;
    body->op_value_def_ownership[projection_op] =
        COLD_EXPR_OWN_MOVE;
    body->op_value_def_origin_id[projection_op] =
        projection_op;
    body->slot_place_kind[field_slot] =
        COLD_EXPR_PLACE_TEMPORARY;
    body->slot_exact_type_id[field_slot] =
        exact_type_id;
    body->slot_origin_id[field_slot] =
        projection_op;
    result.slot = field_slot;
    result.kind = field_kind;
    result.value_def_op_id = projection_op;
    result.exact_type_id = exact_type_id;
    result.producer_function_row =
        body->producer_function_row;
    result.place_kind = COLD_EXPR_PLACE_TEMPORARY;
    result.ownership = COLD_EXPR_OWN_MOVE;
    result.origin_id = projection_op;
    return result;
}

static ColdExprResult cold_exact_owned_root_for_projection(
        BodyIR *body, Symbols *symbols,
        const ColdExprResult *source) {
    ColdExprResult current;
    cold_expr_result_reset(&current);
    if (!body || !source ||
        source->value_def_op_id < 0 ||
        source->value_def_op_id >= body->op_count ||
        !cold_exact_op_tuple_matches_result(
            body, source)) {
        die("managed projection root source is invalid");
    }
    current = *source;
    for (int32_t depth = 0;
         depth < body->op_count; depth++) {
        if (current.ownership ==
                COLD_EXPR_OWN_PLAIN ||
            current.ownership ==
                COLD_EXPR_OWN_MOVE) {
            int32_t current_block =
                cold_current_open_block(body);
            int32_t consume_plus_one =
                body->op_value_def_consume_op_index_plus_one[
                    current.value_def_op_id];
            if (current_block < 0 ||
                (consume_plus_one != 0 &&
                 !cold_exact_definition_is_live_at_current_point(
                     body, current.value_def_op_id,
                     current_block)) ||
                !cold_exact_op_tuple_matches_result(
                    body, &current)) {
                die("managed projection owned root is not live");
            }
            return current;
        }
        if ((current.ownership !=
                 COLD_EXPR_OWN_BORROW_SHARED &&
             current.ownership !=
                 COLD_EXPR_OWN_BORROW_UNIQUE) ||
            current.place_kind !=
                COLD_EXPR_PLACE_BORROW_PROJECTION) {
            die("managed projection has no owned root");
        }
        int32_t projection =
            current.value_def_op_id;
        int32_t parent =
            body->op_value_def_origin_id[projection];
        bool projection_kind =
            body->op_kind[projection] ==
                BODY_OP_PAYLOAD_LOAD ||
            body->op_kind[projection] ==
                BODY_OP_SEQ_STR_INDEX_DYNAMIC ||
            body->op_kind[projection] ==
                BODY_OP_SEQ_OPAQUE_INDEX_DYNAMIC ||
            body->op_kind[projection] ==
                BODY_OP_SEQ_OPAQUE_INDEX_REF_DYNAMIC ||
            body->op_kind[projection] ==
                BODY_OP_ARRAY_OPAQUE_INDEX_DYNAMIC ||
            body->op_kind[projection] ==
                BODY_OP_ARRAY_OPAQUE_INDEX_REF_DYNAMIC;
        int32_t parent_slot =
            parent >= 0 && parent < projection
                ? body->op_value_def_slot[parent]
                : -1;
        if (!projection_kind ||
            body->op_dst[projection] !=
                current.slot ||
            parent < 0 || parent >= projection ||
            parent_slot < 0 ||
            parent_slot >= body->slot_count ||
            parent_slot != body->op_a[projection]) {
            die("managed projection parent edge is broken");
        }
        int32_t parent_kind =
            body->slot_kind[parent_slot];
        bool seq_projection =
            body->op_kind[projection] ==
                BODY_OP_SEQ_STR_INDEX_DYNAMIC ||
            body->op_kind[projection] ==
                BODY_OP_SEQ_OPAQUE_INDEX_DYNAMIC ||
            body->op_kind[projection] ==
                BODY_OP_SEQ_OPAQUE_INDEX_REF_DYNAMIC ||
            body->op_kind[projection] ==
                BODY_OP_ARRAY_OPAQUE_INDEX_DYNAMIC ||
            body->op_kind[projection] ==
                BODY_OP_ARRAY_OPAQUE_INDEX_REF_DYNAMIC;
        if (seq_projection) {
            /* Sequence/array index projection: the parent is the sequence,
               not an object — element layout was proven at borrow
               construction; walk straight to the parent definition. */
            bool parent_is_seq =
                parent_kind == SLOT_SEQ_STR ||
                parent_kind == SLOT_SEQ_STR_REF ||
                parent_kind == SLOT_SEQ_OPAQUE ||
                parent_kind == SLOT_SEQ_OPAQUE_REF ||
                parent_kind == SLOT_ARRAY_I32;
            if (!parent_is_seq)
                die("managed projection parent layout is unknown");
        } else {
        Span parent_type =
            span_trim(cold_type_strip_var(
                body->slot_type[parent_slot], 0));
        ObjectDef *parent_object =
            symbols && parent_type.len > 0
                ? symbols_resolve_object(
                      symbols, parent_type)
                : 0;
        if ((parent_kind != SLOT_OBJECT &&
             parent_kind != SLOT_OBJECT_REF) ||
            !parent_object ||
            parent_object < symbols->objects ||
            parent_object >=
                symbols->objects +
                    symbols->object_count) {
            die("managed projection parent layout is unknown");
        }
        int32_t projection_offset =
            body->op_b[projection];
        int32_t projection_size =
            body->op_c[projection];
        ObjectField *matched_field = 0;
        for (int32_t field_index = 0;
             field_index <
             parent_object->field_count;
             field_index++) {
            ObjectField *candidate =
                &parent_object->fields[field_index];
            if (candidate->offset ==
                    projection_offset &&
                candidate->size ==
                    projection_size) {
                if (matched_field)
                    die("managed projection field layout is ambiguous");
                matched_field = candidate;
            }
        }
        Span projected_type =
            span_trim(cold_type_strip_var(
                body->slot_type[current.slot],
                0));
        Span field_type =
            matched_field
                ? span_trim(cold_type_strip_var(
                      matched_field->type_name,
                      0))
                : (Span){0};
        int32_t field_kind =
            field_type.len > 0
                ? cold_slot_kind_from_type_with_symbols(
                      symbols, field_type)
                : -1;
        int32_t projected_type_id =
            cold_exact_managed_type_id(
                symbols, body, current.slot,
                current.kind);
        if (!matched_field ||
            projection_offset < 0 ||
            projection_size <= 0 ||
            projection_size !=
                body->slot_size[current.slot] ||
            field_kind != current.kind ||
            field_type.len <= 0 ||
            projected_type.len <= 0 ||
            !span_same(field_type,
                       projected_type) ||
            projected_type_id < 0 ||
            projected_type_id !=
                current.exact_type_id) {
            die("managed projection field identity is invalid");
        }
        }
        cold_expr_result_reset(&current);
        current.slot = parent_slot;
        current.kind = parent_kind;
        current.value_def_op_id = parent;
        current.exact_type_id =
            body->op_value_def_exact_type_id[parent];
        current.producer_function_row =
            body->op_value_def_producer_function_row[parent];
        current.place_kind =
            body->op_value_def_place_kind[parent];
        current.ownership =
            body->op_value_def_ownership[parent];
        current.origin_id =
            body->op_value_def_origin_id[parent];
        if (!cold_exact_op_tuple_matches_result(
                body, &current)) {
            die("managed projection parent definition is invalid");
        }
    }
    die("recursive managed projection identity");
    return current;
}

static ColdExprResult cold_materialize_borrowed_str_move(
        Parser *parser, BodyIR *body, Symbols *symbols,
        const ColdExprResult *source) {
    if (!parser || !body || !symbols || !source ||
        source->slot < 0 ||
        source->slot >= body->slot_count ||
        source->kind != SLOT_STR ||
        body->slot_kind[source->slot] != SLOT_STR ||
        source->ownership !=
            COLD_EXPR_OWN_BORROW_SHARED ||
        !cold_exact_op_tuple_matches_result(
            body, source)) {
        die("borrowed str move source is invalid");
    }
    ColdExprResult root =
        cold_exact_owned_root_for_projection(
            body, symbols, source);
    int32_t empty =
        cold_make_str_literal_slot_mode(
            parser, body, (Span){0}, true, false);
    int32_t destination =
        body_slot(body, SLOT_STR,
                  COLD_STR_SLOT_SIZE);
    body_slot_set_type(
        body, destination,
        cold_cstr_span("str"));
    int32_t producer = body_op(
        body, BODY_OP_STR_CONCAT,
        destination, empty, source->slot);
    ColdExprResult result;
    cold_expr_result_reset(&result);
    cold_publish_owned_managed_producer(
        body, symbols, destination,
        SLOT_STR, producer, &result);
    (void)root;
    return result;
}

/* Taking an address-bearing PLAIN field from an owned aggregate cannot be a
   byte-copy: that would manufacture a second authority over the same address.
   Publish the canonical field load as one exact MOVE, then consume/drop the
   parent root so its remaining managed fields are released.  The immutable
   A-read plus canonical ObjectDef field identity is the whole transfer proof;
   Result.Value and direct owned-field returns use this same rule. */
static ColdExprResult cold_exact_owned_plain_field_take(
        Parser *parser, BodyIR *body,
        const ColdExprResult *source,
        int32_t field_slot, int32_t field_kind,
        int32_t projection_op) {
    ColdExprResult result;
    cold_expr_result_reset(&result);
    if (!parser || !parser->symbols || !body || !source ||
        source->slot < 0 || source->slot >= body->slot_count ||
        source->value_def_op_id < 0 ||
        source->value_def_op_id >= projection_op ||
        source->kind != SLOT_OBJECT ||
        body->slot_kind[source->slot] != SLOT_OBJECT ||
        source->ownership != COLD_EXPR_OWN_MOVE ||
        !cold_exact_op_tuple_matches_result(body, source) ||
        !cold_exact_definition_is_live_before_op(
            body, source->value_def_op_id,
            projection_op) ||
        field_slot < 0 || field_slot >= body->slot_count ||
        body->slot_kind[field_slot] != field_kind ||
        projection_op < 0 || projection_op >= body->op_count ||
        body->op_kind[projection_op] != BODY_OP_PAYLOAD_LOAD ||
        body->op_dst[projection_op] != field_slot ||
        body->op_a[projection_op] != source->slot ||
        !cold_exact_op_tuple_is_sentinel(body, projection_op) ||
        /* Identity claim = TypeId, place binding, or origin.  A
           creation-time static storage tag on an OBJECT/OBJECT_REF
           field carrier is declaration, not a claim. */
        (body->slot_exact_type_id[field_slot] >= 0 ||
         body->slot_place_kind[field_slot] !=
             COLD_EXPR_PLACE_INVALID ||
         body->slot_origin_id[field_slot] != -1) ||
        cold_exact_storage_authority_for_slot(
            parser->symbols, body, field_slot, field_kind) !=
                COLD_MANAGED_STORAGE_PLAIN ||
        cold_plain_value_copy_is_independent(
            parser->symbols, body, field_slot, field_kind)) {
        if (cold_env_flag("CHENG_OXA_DIAG"))
            fprintf(stderr,
                    "([oxa30]) src=%d sdef=%d sown=%d skk=%d slkk=%d fs=%d fkk=%d pok=%d pdst=%d pa=%d tup=%d sent=%d auth=%d indep=%d live=%d\n",
                    source->slot,
                    source->value_def_op_id,
                    source->ownership,
                    source->kind,
                    body->slot_kind[source->slot],
                    field_slot, field_kind,
                    body->op_kind[projection_op],
                    body->op_dst[projection_op],
                    body->op_a[projection_op],
                    cold_exact_op_tuple_matches_result(body, source) ? 1 : 0,
                    cold_exact_slot_authority_is_sentinel(body, field_slot) ? 1 : 0,
                    cold_exact_storage_authority_for_slot(parser->symbols, body, field_slot, field_kind),
                    cold_plain_value_copy_is_independent(parser->symbols, body, field_slot, field_kind) ? 1 : 0,
                    cold_exact_definition_is_live_before_op(body, source->value_def_op_id, projection_op) ? 1 : 0);
        if (cold_env_flag("CHENG_OXA_DIAG"))
            fprintf(stderr,
                    "([oxa31]) fs=%d etid=%d pl=%d org=%d stg=%d cre=%d\n",
                    field_slot,
                    body->slot_exact_type_id[field_slot],
                    body->slot_place_kind[field_slot],
                    body->slot_origin_id[field_slot],
                    body->slot_managed_storage_kind[field_slot],
                    body->slot_kind[field_slot] != SLOT_OBJECT && body->slot_kind[field_slot] != SLOT_OBJECT_REF ? cold_managed_storage_kind_for_slot_kind(body->slot_kind[field_slot]) : -1);
        die("plain field take lacks exact owned source");
    }
    int32_t exact_type_id = cold_exact_managed_type_id(
        parser->symbols, body, field_slot, field_kind);
    if (exact_type_id < 0 || body->producer_function_row < 0)
        die("plain field take lacks exact type identity");

    int32_t object_row = -1;
    int32_t field_ordinal = -1;
    if (!cold_exact_field_projection_layout_identity(
            body, parser->symbols, projection_op,
            source->value_def_op_id,
            &object_row, &field_ordinal) ||
        object_row < 0 ||
        object_row >= parser->symbols->object_count ||
        field_ordinal < 0 ||
        field_ordinal >=
            parser->symbols->objects[object_row].field_count) {
        die("plain field take identity is invalid");
    }

    cold_publish_exact_managed_read(
        body, projection_op,
        COLD_EXACT_READ_OPERAND_A, source);
    body->op_value_def_slot[projection_op] = field_slot;
    body->op_value_def_exact_type_id[projection_op] =
        exact_type_id;
    body->op_value_def_producer_function_row[projection_op] =
        body->producer_function_row;
    body->op_value_def_place_kind[projection_op] =
        COLD_EXPR_PLACE_TEMPORARY;
    body->op_value_def_ownership[projection_op] =
        COLD_EXPR_OWN_MOVE;
    body->op_value_def_origin_id[projection_op] = projection_op;
    body->slot_place_kind[field_slot] =
        COLD_EXPR_PLACE_TEMPORARY;
    body->slot_exact_type_id[field_slot] = exact_type_id;
    body->slot_origin_id[field_slot] = projection_op;
    body->slot_managed_storage_kind[field_slot] = COLD_MANAGED_STORAGE_PLAIN;

    result.slot = field_slot;
    result.kind = field_kind;
    result.value_def_op_id = projection_op;
    result.exact_type_id = exact_type_id;
    result.producer_function_row =
        body->producer_function_row;
    result.place_kind = COLD_EXPR_PLACE_TEMPORARY;
    result.ownership = COLD_EXPR_OWN_MOVE;
    result.origin_id = projection_op;

    /* The payload bytes are already in their result slot.  Dropping the
       Result now consumes the root and releases only its managed fields;
       PLAIN fields are deliberately skipped by exact object decomposition. */
    cold_emit_exact_owned_drop(
        parser, body, parser->symbols, source);
    if (body->op_value_def_consume_op_index_plus_one[
            source->value_def_op_id] == 0 ||
        !cold_exact_op_tuple_matches_result(body, &result)) {
        die("plain field take did not close its owner");
    }
    return result;
}

static int32_t cold_result_project_value(
        Parser *parser, BodyIR *body,
        const ColdExprResult *source, int32_t source_slot,
        ObjectField *field, int32_t *kind_out,
        ColdExprResult *result_out) {
    int32_t projection_op = -1;
    int32_t slot = cold_load_object_field_slot(
        body, parser->symbols, source_slot, field,
        &projection_op);
    if (kind_out) *kind_out = field->kind;
    if (cold_exact_managed_storage_for_slot(
            parser->symbols, body, slot, field->kind) ==
        COLD_MANAGED_STORAGE_UNKNOWN) {
        if (!source || source->slot != source_slot)
            die("scalar Result projection source authority missing");
        if (field->kind == SLOT_OBJECT &&
            cold_exact_storage_authority_for_slot(
                parser->symbols, body, slot, field->kind) ==
                COLD_MANAGED_STORAGE_PLAIN) {
            /* A resource-free payload (e.g. a BigInt inside Result): the
               "non-destructive accessor" shortcut below would hand out a raw
               field projection carrying NO exact definition, so a later
               `var x = Value(r)` bound an empty authority (-1) and any
               conditional var-call on x merged -1 against the call's
               write-back definition ("CFG merge is ambiguous").  A POD byte
               copy is the complete independent value, so route it through
               the same shared-copy path managed payloads take; the copy
               carries an exact PLAIN definition. */
            if (!cold_plain_value_copy_is_independent(
                    parser->symbols, body, slot, field->kind)) {
                ColdExprResult taken =
                    cold_exact_owned_plain_field_take(
                        parser, body, source, slot,
                        field->kind, projection_op);
                if (result_out) *result_out = taken;
                return taken.slot;
            }
            ColdExprResult borrowed_plain =
                cold_exact_managed_field_borrow(
                    body, parser->symbols, source, slot,
                    field->kind, projection_op);
            ColdExprResult shared_plain =
                cold_emit_exact_shared_local_copy(
                    parser, body, parser->symbols, &borrowed_plain);
            if (result_out) *result_out = shared_plain;
            return shared_plain.slot;
        }
        /* Non-destructive accessor: the Result keeps ownership of
           everything; its own scope-end drop releases it once. */
        return slot;
    }
    if (!source || source->slot != source_slot)
        die("managed Result projection source authority missing");
    /* Value/ErrorText are accessors, not takes: retain an independent owned
       copy of the payload field. Repeated reads (the dominant codebase
       idiom) each get their own owned value, and the copy escapes through
       returns where a borrow would dangle. */
    ColdExprResult borrowed = cold_exact_managed_field_borrow(
        body, parser->symbols, source, slot,
        field->kind, projection_op);
    ColdExprResult shared = cold_emit_exact_shared_local_copy(
        parser, body, parser->symbols, &borrowed);
    if (result_out) *result_out = shared;
    return shared.slot;
}

ObjectDef *cold_result_object_for_arg(Symbols *symbols, BodyIR *body,
                                             int32_t arg_slot) {
    int32_t kind = body->slot_kind[arg_slot];
    if (kind != SLOT_OBJECT && kind != SLOT_OBJECT_REF && kind != SLOT_VARIANT)
        return 0;
    Span type_name = body->slot_type[arg_slot];
    if (type_name.len <= 0) {
        /* try extracting type from the Result variant definition */
        type_name = body->slot_type[arg_slot];
    }
    if (type_name.len <= 0) die("Result intrinsic target type is unknown");
    ObjectDef *object = symbols_resolve_object(symbols, type_name);
    if (!object) die("Result intrinsic target is not an object");
    if (!object_find_field(object, cold_cstr_span("ok")) ||
        !object_find_field(object, cold_cstr_span("value")) ||
        !object_find_field(object, cold_cstr_span("err"))) {
        die("Result intrinsic target has no Result layout");
    }
    return object;
}

int32_t cold_lower_error_info_message(Symbols *symbols, BodyIR *body,
                                             int32_t error_info_slot) {
    int32_t kind = body->slot_kind[error_info_slot];
    if (kind != SLOT_OBJECT && kind != SLOT_OBJECT_REF) {
        die("ErrorMessage target must be ErrorInfo object");
    }
    ObjectDef *error_info = symbols_resolve_object(symbols, body->slot_type[error_info_slot]);
    if (!error_info) die("ErrorInfo object layout missing");
    ObjectField *msg = object_find_field(error_info, cold_cstr_span("msg"));
    if (!msg || msg->kind != SLOT_STR) die("ErrorInfo.msg must be str");
    return cold_load_object_field_slot(
        body, symbols, error_info_slot, msg, 0);
}

bool cold_try_result_intrinsic(Parser *parser, BodyIR *body, Span name,
                               int32_t arg_start, int32_t arg_count,
                               const ColdExprResult *arg_results,
                               int32_t *slot_out, int32_t *kind_out,
                               ColdExprResult *result_out) {
    /* Explicit-[T] spellings (ErrorInfoOf[bool](r), IsOk[T](r), Value[T](r),
       ...) must hit the same projection intrinsics as their bare spellings:
       T is always derivable from the Result arg, and the generic-template
       fallback these otherwise resolve to keeps the unresolved Result[T]
       phantom layout (value field sized 8 → err at +16 instead of +8), so it
       projects err/value from the wrong offsets of the caller's concrete
       Result. Strip the suffix only when the single arg really is a
       Result-shaped object, so user functions that merely share a name keep
       resolving normally. */
    Span bare = cold_span_strip_generic_suffix(name);
    if (bare.len != name.len && cold_name_is_any_result_intrinsic(bare) &&
        arg_count == 1) {
        int32_t probe = body->call_arg_slot[arg_start];
        int32_t pk = body->slot_kind[probe];
        if ((pk == SLOT_OBJECT || pk == SLOT_OBJECT_REF || pk == SLOT_VARIANT) &&
            body->slot_type[probe].len > 0) {
            ObjectDef *obj = symbols_resolve_object(parser->symbols,
                                                    body->slot_type[probe]);
            if (obj && object_find_field(obj, cold_cstr_span("ok")) &&
                object_find_field(obj, cold_cstr_span("value")) &&
                object_find_field(obj, cold_cstr_span("err"))) {
                name = bare;
            }
        }
    }
    if (!cold_name_is_any_result_intrinsic(name)) return false;
    if (arg_count != 1) die("Result intrinsic arity mismatch");
    int32_t arg_slot = body->call_arg_slot[arg_start];
    const ColdExprResult *arg_result =
        arg_results ? &arg_results[0] : 0;

    if (span_eq(name, "ErrorMessage") || span_eq(name, "result.ErrorMessage") ||
        span_eq(name, "ErrorFormat") || span_eq(name, "result.ErrorFormat")) {
        ObjectDef *error_info = symbols_resolve_object(
            parser->symbols, body->slot_type[arg_slot]);
        if (!error_info) die("ErrorInfo object layout missing");
        ObjectField *msg = object_find_field(
            error_info, cold_cstr_span("msg"));
        if (!msg || msg->kind != SLOT_STR)
            die("ErrorInfo.msg must be str");
        int32_t slot = cold_result_project_value(
            parser, body, arg_result, arg_slot, msg,
            kind_out, result_out);
        *slot_out = slot;
        return true;
    }

    ObjectDef *result = cold_result_object_for_arg(parser->symbols, body, arg_slot);
    if (!result) die("Result intrinsic target is not Result object");
    ObjectField *ok = object_find_field(result, cold_cstr_span("ok"));
    ObjectField *value = object_find_field(result, cold_cstr_span("value"));
    ObjectField *err = object_find_field(result, cold_cstr_span("err"));
    if (!ok || ok->kind != SLOT_I32 || !value || !err || err->kind != SLOT_OBJECT) {
        die("Result intrinsic target has invalid Result layout");
    }

    if (span_eq(name, "IsOk") || span_eq(name, "result.IsOk")) {
        int32_t slot = cold_load_object_field_slot(
            body, parser->symbols, arg_slot, ok, 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "IsErr") || span_eq(name, "result.IsErr")) {
        int32_t ok_slot = cold_load_object_field_slot(
            body, parser->symbols, arg_slot, ok, 0);
        int32_t zero_slot = body_slot(body, SLOT_I32, 4);
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero_slot, 0, 0);
        body_op3(body, BODY_OP_I32_CMP, slot, ok_slot, zero_slot, COND_EQ);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "Value") || span_eq(name, "result.Value")) {
        int32_t slot = cold_result_project_value(
            parser, body, arg_result, arg_slot, value,
            kind_out, result_out);
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "ErrorInfoOf") || span_eq(name, "result.ErrorInfoOf")) {
        int32_t slot = cold_result_project_value(
            parser, body, arg_result, arg_slot, err,
            kind_out, result_out);
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "Error") || span_eq(name, "result.Error") ||
        span_eq(name, "ErrorText") || span_eq(name, "result.ErrorText")) {
        ObjectDef *error_info = symbols_resolve_object(
            parser->symbols, err->type_name);
        if (!error_info) die("ErrorInfo object layout missing");
        ObjectField *msg = object_find_field(
            error_info, cold_cstr_span("msg"));
        if (!msg || msg->kind != SLOT_STR)
            die("ErrorInfo.msg must be str");
        if (err->offset < 0 || msg->offset < 0 ||
            err->offset > INT32_MAX - msg->offset) {
            die("Result error message projection offset is invalid");
        }
        ObjectField nested_msg = *msg;
        nested_msg.offset = err->offset + msg->offset;
        int32_t slot = cold_result_project_value(
            parser, body, arg_result, arg_slot,
            &nested_msg,
            kind_out, result_out);
        *slot_out = slot;
        return true;
    }

    die("unknown Result intrinsic");
    return true;
}

bool cold_name_is_stdout(Span name) {
    return span_eq(name, "os.Get_stdout") || span_eq(name, "os.GetStdout") ||
           span_eq(name, "os.get_stdout") || span_eq(name, "Get_stdout") ||
           span_eq(name, "GetStdout") || span_eq(name, "get_stdout") ||
           span_eq(name, "getStdout");
}

bool cold_name_is_stderr(Span name) {
    return span_eq(name, "os.GetStderr") || span_eq(name, "os.Get_stderr") ||
           span_eq(name, "os.get_stderr") || span_eq(name, "GetStderr") ||
           span_eq(name, "Get_stderr") || span_eq(name, "get_stderr") ||
           span_eq(name, "getStderr");
}

bool cold_name_is_stdin(Span name) {
    return span_eq(name, "os.Get_stdin") || span_eq(name, "os.GetStdin") ||
           span_eq(name, "os.get_stdin") || span_eq(name, "Get_stdin") ||
           span_eq(name, "GetStdin") || span_eq(name, "get_stdin") ||
           span_eq(name, "getStdin");
}

bool cold_name_is_write_line(Span name) {
    return span_eq(name, "os.WriteLine") || span_eq(name, "WriteLine") ||
           span_eq(name, "os.writeLine") || span_eq(name, "writeLine");
}

bool cold_name_is_write(Span name) {
    return span_eq(name, "os.Write") || span_eq(name, "Write") ||
           span_eq(name, "os.write") || span_eq(name, "write");
}

bool cold_name_is_c_fgetc(Span name) {
    return span_eq(name, "os.C_fgetc") || span_eq(name, "C_fgetc") ||
           span_eq(name, "os.c_fgetc") || span_eq(name, "c_fgetc");
}

bool cold_name_is_param_count(Span name) {
    return span_eq(name, "BackendDriverDispatchMinParamCountBridge") ||
           span_eq(name, "CompilerParamCountBridge") ||
           span_eq(name, "paramCount") ||
           span_eq(name, "ParamCount") ||
           span_eq(name, "cmdline.paramCount") ||
           span_eq(name, "cmdline.ParamCount") ||
           span_eq(name, "__cheng_rt_paramCount") ||
           span_eq(name, "cmdline.__cheng_rt_paramCount");
}

bool cold_name_is_param_str(Span name) {
    return span_eq(name, "BackendDriverDispatchMinParamStrRawBridge") ||
           span_eq(name, "__cheng_rt_paramStrCopyBridge") ||
           span_eq(name, "ParamStr") ||
           span_eq(name, "paramStr") ||
           span_eq(name, "cmdline.ParamStr") ||
           span_eq(name, "cmdline.paramStr") ||
           span_eq(name, "cmdline.__cheng_rt_paramStrCopyBridge");
}

bool cold_name_is_raw_param_str(Span name) {
    return span_eq(name, "__cheng_rt_paramStr") ||
           span_eq(name, "cmdline.__cheng_rt_paramStr");
}

bool cold_name_is_read_flag_or_default(Span name) {
    return span_eq(name, "BackendDriverDispatchMinReadFlagOrDefaultBridge") ||
           span_eq(name, "driverReadFlagOrDefault") ||
           span_eq(name, "cmdline.driverReadFlagOrDefault") ||
           span_eq(name, "ReadFlagOrDefault") ||
           span_eq(name, "readFlagOrDefault") ||
           span_eq(name, "cmdline.ReadFlagOrDefault") ||
           span_eq(name, "cmdline.readFlagOrDefault");
}

int32_t cold_make_i32_const_slot(BodyIR *body, int32_t value);
int32_t cold_make_str_literal_cstr_slot(BodyIR *body, const char *text);
static int32_t cold_make_str_literal_cstr_slot_exact(
        BodyIR *body, const char *text,
        ColdExprResult *result_out);
int32_t cold_require_str_value(BodyIR *body, int32_t slot, const char *context);
ObjectField *cold_required_object_field(ObjectDef *object, const char *name);

static ColdExprResult cold_require_exact_str_result_value(
        BodyIR *body, Symbols *symbols,
        const ColdExprResult *source_result,
        const char *context) {
    ColdExprResult source;
    cold_expr_result_reset(&source);
    if (!body || !symbols || !source_result) {
        die("exact str result argument is invalid");
    }
    int32_t slot = source_result->slot;
    int32_t definition = source_result->value_def_op_id;
    if ((body->slot_kind[slot] != SLOT_STR &&
         body->slot_kind[slot] != SLOT_STR_REF) ||
        !cold_exact_result_from_definition(
            body, slot, definition, &source) ||
        source_result->kind != source.kind ||
        source_result->exact_type_id != source.exact_type_id ||
        source_result->producer_function_row !=
            source.producer_function_row ||
        source_result->place_kind != source.place_kind ||
        source_result->ownership != source.ownership ||
        source_result->origin_id != source.origin_id) {
        (void)context;
        die("str intrinsic lacks exact call argument authority");
    }
    if (source.kind == SLOT_STR)
        return source;
    return cold_exact_managed_ref_value_borrow(
        body, symbols, &source);
}

bool cold_parser_imports_rawbytes(Parser *parser) {
    if (!parser || !parser->import_sources || parser->import_source_count <= 0) return false;
    for (int32_t i = 0; i < parser->import_source_count; i++) {
        if (!span_eq(parser->import_sources[i].alias, "rawbytes")) continue;
        if (strcmp(parser->import_sources[i].path, "src/std/rawbytes.cheng") == 0) return true;
    }
    return false;
}

bool cold_try_os_intrinsic(Parser *parser, BodyIR *body, Locals *locals, Span name,
                                  int32_t arg_start, int32_t arg_count,
                                  const ColdExprResult *arg_results,
                                  int32_t *slot_out, int32_t *kind_out,
                                  ColdExprResult *result_out) {
    if (!cold_target_external_libc &&
        (cold_name_is_stdin(name) || cold_name_is_stdout(name) || cold_name_is_stderr(name))) {
        if (arg_count != 0) die("os fd intrinsic arity mismatch");
        int32_t slot = body_slot(body, SLOT_OPAQUE, 8);
        body_slot_set_type(body, slot, cold_cstr_span("ptr"));
        body_op(body, BODY_OP_PTR_CONST, slot, cold_name_is_stdin(name) ? 0 : (cold_name_is_stdout(name) ? 1 : 2), 0);
        if (kind_out) *kind_out = SLOT_OPAQUE;
        *slot_out = slot;
        return true;
    }
    if ((!cold_target_external_libc && cold_name_is_write_line(name)) ||
        span_eq(name, "echo")) {
        bool is_echo = span_eq(name, "echo");
        if ((is_echo && arg_count != 1) || (!is_echo && arg_count != 2))
            die("os.WriteLine/echo arity mismatch");
        int32_t fd_slot, text_slot;
        if (is_echo) {
            fd_slot = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, fd_slot, 1, 0);
            text_slot = body->call_arg_slot[arg_start];
        } else {
            fd_slot = body->call_arg_slot[arg_start];
            text_slot = body->call_arg_slot[arg_start + 1];
        }
        int32_t fd_kind = body->slot_kind[fd_slot];
        int32_t text_kind = body->slot_kind[text_slot];
        if (fd_kind != SLOT_OPAQUE && fd_kind != SLOT_I32) return 0;
        if (text_kind != SLOT_STR && text_kind != SLOT_STR_REF) return 0;
        int32_t slot = body_slot(body, SLOT_I32, 4);
        int32_t read_op = body_op(
            body, BODY_OP_WRITE_LINE, slot,
            fd_slot, text_slot);
        if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=42501\n");
        cold_publish_exact_managed_read_or_sentinel(
            body, read_op, COLD_EXACT_READ_OPERAND_B,
            arg_results
                ? &arg_results[is_echo ? 0 : 1]
                : 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (!cold_target_external_libc && cold_name_is_write(name)) {
        if (arg_count != 2) die("os.Write arity mismatch");
        int32_t fd_slot = body->call_arg_slot[arg_start];
        int32_t text_slot = body->call_arg_slot[arg_start + 1];
        int32_t fd_kind = body->slot_kind[fd_slot];
        int32_t text_kind = body->slot_kind[text_slot];
        if (fd_kind != SLOT_OPAQUE && fd_kind != SLOT_I32) return 0;
        if (text_kind != SLOT_STR && text_kind != SLOT_STR_REF) return 0;
        int32_t slot = body_slot(body, SLOT_I32, 4);
        int32_t read_op = body_op(
            body, BODY_OP_WRITE_TEXT, slot,
            fd_slot, text_slot);
        if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=42522\n");
        cold_publish_exact_managed_read_or_sentinel(
            body, read_op, COLD_EXACT_READ_OPERAND_B,
            arg_results ? &arg_results[1] : 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (!cold_target_external_libc && cold_name_is_c_fgetc(name)) {
        if (arg_count != 1) die("os.C_fgetc arity mismatch");
        int32_t fd_slot = body->call_arg_slot[arg_start];
        int32_t fd_kind = body->slot_kind[fd_slot];
        if (fd_kind != SLOT_OPAQUE && fd_kind != SLOT_I32) {
            return 0;
        }
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_FGETC, slot, fd_slot, 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (cold_name_is_param_count(name)) {
        if (arg_count != 0) die("paramCount intrinsic arity mismatch");
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_ARGC_LOAD, slot, 0, 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    /* Bug F: BODY_OP_TIME_NS is a misnamed wall-clock op (arm64/x86_64 use
       SYS_gettimeofday = epoch nanoseconds; Windows bridge uses FILETIME wall
       clock). Hijacking every call spelled cheng_monotime_ns /
       BackendDriverDispatchMinMonoTimeNsBridge into it makes a "monotime" call
       silently return wall-clock time. On Darwin the real symbol resolves to
       the provider export cheng_monotime_ns (core_runtime_provider_darwin ->
       clock_gettime(CLOCK_MONOTONIC)); skip the intercept so std/times,
       std/monotimes and the driver bridge all share that one canonical source
       (matches the backend driver path, which never intercepts). Darwin has no
       clock_gettime syscall, so a self-contained monotonic BODY_OP is not an
       option here. Non-Darwin targets keep the builtin: Windows has no
       cheng_monotime_ns provider and would otherwise fail to link. */
    if (!cold_abi_darwin_arg_packing &&
        (span_eq(name, "BackendDriverDispatchMinMonoTimeNsBridge") ||
         span_eq(name, "cheng_monotime_ns"))) {
        if (arg_count != 0) die("monotime intrinsic arity mismatch");
        int32_t slot = body_slot(body, SLOT_I64, 8);
        body_op(body, BODY_OP_TIME_NS, slot, 0, 0);
        if (kind_out) *kind_out = SLOT_I64;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "BackendDriverDispatchMinGetrusageBridge") ||
        span_eq(name, "os.os_getrusage_bridge") ||
        span_eq(name, "os_getrusage_bridge") ||
        span_eq(name, "getrusage")) {
        if (arg_count != 2) die("getrusage intrinsic arity mismatch");
        int32_t who = body->call_arg_slot[arg_start];
        int32_t usage = body->call_arg_slot[arg_start + 1];
        if (body->slot_kind[who] != SLOT_I32) die("getrusage who must be int32");
        if (body->slot_kind[usage] != SLOT_OBJECT && body->slot_kind[usage] != SLOT_OBJECT_REF &&
            body->slot_kind[usage] != SLOT_OPAQUE && body->slot_kind[usage] != SLOT_OPAQUE_REF) {
            die("getrusage usage must be object");
        }
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_GETRUSAGE, slot, who, usage);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "BackendDriverDispatchMinExitBridge") ||
        span_eq(name, "os.os_exit_bridge") ||
        span_eq(name, "os_exit_bridge") ||
        span_eq(name, "exit")) {
        if (arg_count != 1) die("exit intrinsic arity mismatch");
        int32_t code_slot = body->call_arg_slot[arg_start];
        if (body->slot_kind[code_slot] != SLOT_I32) die("exit code must be int32");
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_EXIT, slot, code_slot, 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "system.HeapNewCompat") ||
        span_eq(name, "system.heapNewLegacy") ||
        span_eq(name, "system.heapAllocLegacy") ||
        span_eq(name, "system.alloc") ||
        span_eq(name, "HeapNewCompat") ||
        span_eq(name, "heapNewLegacy") ||
        span_eq(name, "heapAllocLegacy") ||
        span_eq(name, "alloc") ||
        span_eq(name, "heapNewCompat")) {
        if (arg_count != 1) die("heap allocation intrinsic arity mismatch");
        int32_t len = body->call_arg_slot[arg_start];
        if (body->slot_kind[len] != SLOT_I32 && body->slot_kind[len] != SLOT_I64)
            die("heap allocation len must be int");
        int32_t slot = body_slot(body, SLOT_PTR, 8);
        body_slot_set_type(body, slot, cold_cstr_span("ptr"));
        body_op3(body, BODY_OP_MMAP, slot, len, 0, COLD_MMAP_MODE_MANAGED_REF);
        if (kind_out) *kind_out = SLOT_PTR;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "rawbytes.BytesAlloc") ||
        span_eq(name, "rawbytes.bytesAlloc") ||
        ((span_eq(name, "BytesAlloc") || span_eq(name, "bytesAlloc")) &&
         cold_parser_imports_rawbytes(parser))) {
        if (arg_count != 1) die("BytesAlloc intrinsic arity mismatch");
        int32_t len = body->call_arg_slot[arg_start];
        if (body->slot_kind[len] != SLOT_I32) die("BytesAlloc length must be int32");
        ObjectDef *bytes = symbols_resolve_object(parser->symbols, cold_cstr_span("rawbytes.Bytes"));
        if (!bytes) bytes = symbols_resolve_object(parser->symbols, cold_cstr_span("Bytes"));
        if (!bytes) die("BytesAlloc requires Bytes object layout");
        int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(bytes));
        body_slot_set_type(body, slot, bytes->name);
        int32_t producer =
            body_op(body, BODY_OP_BYTES_ALLOC, slot, len, 0);
        if (cold_exact_storage_authority_for_slot(
                parser->symbols, body, slot, SLOT_OBJECT) !=
                COLD_MANAGED_STORAGE_PLAIN ||
            cold_plain_value_copy_is_independent(
                parser->symbols, body, slot, SLOT_OBJECT)) {
            die("BytesAlloc result layout is not an address-bearing plain aggregate");
        }
        cold_publish_exact_managed_definition(
            body, parser->symbols, slot, SLOT_OBJECT,
            producer, COLD_EXPR_OWN_MOVE, result_out);
        if (kind_out) *kind_out = SLOT_OBJECT;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "rawbytes.BytesLen") ||
        span_eq(name, "rawbytes.bytesLen") ||
        ((span_eq(name, "BytesLen") || span_eq(name, "bytesLen")) &&
         cold_parser_imports_rawbytes(parser))) {
        if (arg_count != 1) die("BytesLen intrinsic arity mismatch");
        int32_t bytes = body->call_arg_slot[arg_start];
        if (body->slot_kind[bytes] != SLOT_OBJECT && body->slot_kind[bytes] != SLOT_OBJECT_REF)
            die("BytesLen expects Bytes object");
        int32_t slot = body_slot(body, SLOT_I32, 4);
        int32_t read_op = body_op3(
            body, BODY_OP_PAYLOAD_LOAD, slot,
            bytes, 8, 4);
        if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=42663\n");
        cold_publish_exact_managed_read_or_sentinel(
            body, read_op, COLD_EXACT_READ_OPERAND_A,
            arg_results ? &arg_results[0] : 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "rawbytes.BytesGet") ||
        span_eq(name, "rawbytes.bytesGet") ||
        ((span_eq(name, "BytesGet") || span_eq(name, "bytesGet")) &&
         cold_parser_imports_rawbytes(parser))) {
        if (arg_count != 2) die("BytesGet intrinsic arity mismatch");
        int32_t bytes = body->call_arg_slot[arg_start];
        int32_t idx = body->call_arg_slot[arg_start + 1];
        if (body->slot_kind[bytes] != SLOT_OBJECT && body->slot_kind[bytes] != SLOT_OBJECT_REF)
            die("BytesGet expects Bytes object");
        if (body->slot_kind[idx] == SLOT_I32_REF) {
            int32_t loaded = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_REF_LOAD, loaded, idx, 0);
            idx = loaded;
        }
        if (body->slot_kind[idx] != SLOT_I32) die("BytesGet index must be int32");
        int32_t slot = body_slot(body, SLOT_I32, 4);
        int32_t read_op = body_op(
            body, BODY_OP_BYTES_GET, slot, bytes, idx);
        if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=42688\n");
        cold_publish_exact_managed_read_or_sentinel(
            body, read_op, COLD_EXACT_READ_OPERAND_A,
            arg_results ? &arg_results[0] : 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "rawbytes.BytesSet") ||
        span_eq(name, "rawbytes.bytesSet") ||
        ((span_eq(name, "BytesSet") || span_eq(name, "bytesSet")) &&
         cold_parser_imports_rawbytes(parser))) {
        if (arg_count != 3) die("BytesSet intrinsic arity mismatch");
        int32_t bytes = body->call_arg_slot[arg_start];
        int32_t idx = body->call_arg_slot[arg_start + 1];
        int32_t value = body->call_arg_slot[arg_start + 2];
        if (body->slot_kind[bytes] != SLOT_OBJECT && body->slot_kind[bytes] != SLOT_OBJECT_REF)
            die("BytesSet expects Bytes object");
        if (body->slot_kind[idx] == SLOT_I32_REF) {
            int32_t loaded = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_REF_LOAD, loaded, idx, 0);
            idx = loaded;
        }
        if (body->slot_kind[value] == SLOT_I32_REF) {
            int32_t loaded = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_REF_LOAD, loaded, value, 0);
            value = loaded;
        }
        if (body->slot_kind[idx] != SLOT_I32) {
            /* Skip BytesSet with non-int32 index — return current slot. */
            *kind_out = body->slot_kind[bytes];
            return bytes;
        }
        if (body->slot_kind[value] != SLOT_I32) die("BytesSet value must be int32");
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op3(body, BODY_OP_BYTES_SET, slot, bytes, idx, value);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "rawbytes.BytesToHex") ||
        span_eq(name, "rawbytes.bytesToHex") ||
        ((span_eq(name, "BytesToHex") || span_eq(name, "bytesToHex")) &&
         cold_parser_imports_rawbytes(parser))) {
        if (arg_count != 1) die("BytesToHex intrinsic arity mismatch");
        int32_t bytes = body->call_arg_slot[arg_start];
        if (body->slot_kind[bytes] != SLOT_OBJECT && body->slot_kind[bytes] != SLOT_OBJECT_REF)
            die("BytesToHex expects Bytes object");
        int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
        body_slot_set_type(body, slot, cold_cstr_span("str"));
        int32_t producer =
            body_op(body, BODY_OP_BYTES_TO_HEX, slot, bytes, 0);
        if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=42739\n");
        cold_publish_exact_managed_read_or_sentinel(
            body, producer, COLD_EXACT_READ_OPERAND_A,
            arg_results ? &arg_results[0] : 0);
        cold_publish_owned_managed_producer(
            body, parser->symbols, slot, SLOT_STR,
            producer, result_out);
        if (kind_out) *kind_out = SLOT_STR;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "rawmem_support.rawmemPtrAdd") ||
        span_eq(name, "rawmem_support.RawmemPtrAdd") ||
        span_eq(name, "system.system_ptr_add") ||
        span_eq(name, "system.SystemPtrAdd") ||
        span_eq(name, "system_ptr_add") ||
        span_eq(name, "SystemPtrAdd") ||
        span_eq(name, "ptr_add") ||
        span_eq(name, "rawmemPtrAdd") ||
        span_eq(name, "RawmemPtrAdd")) {
        if (arg_count != 2) die("RawmemPtrAdd intrinsic arity mismatch");
        int32_t ptr_slot = body->call_arg_slot[arg_start];
        int32_t off_slot = body->call_arg_slot[arg_start + 1];
        int32_t ptr_kind = body->slot_kind[ptr_slot];
        int32_t off_kind = body->slot_kind[off_slot];
        if (ptr_kind != SLOT_PTR && ptr_kind != SLOT_OPAQUE) {
            ptr_slot = cold_materialize_ptr_value(body, ptr_slot, &ptr_kind);
        }
        if (off_kind == SLOT_I32_REF) {
            int32_t loaded = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_REF_LOAD, loaded, off_slot, 0);
            off_slot = loaded;
            off_kind = SLOT_I32;
        }
        if (off_kind != SLOT_I32 && off_kind != SLOT_I64) die("RawmemPtrAdd offset must be int");
        int32_t slot = body_slot(body, SLOT_PTR, 8);
        body_slot_set_type(body, slot, cold_cstr_span("ptr"));
        int32_t producer =
