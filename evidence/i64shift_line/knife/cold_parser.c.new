int32_t cold_make_i32_const_slot(BodyIR *body, int32_t value) {
    int32_t slot = body_slot(body, SLOT_I32, 4);
    body_op(body, BODY_OP_I32_CONST, slot, value, 0);
    return slot;
}

/* Subword scalar fields share the I32 execution lane but retain their
   declared type and byte width as layout authority.  Constructors must bind
   that exact declared type to their widened constant slot; an untyped I32
   constant cannot distinguish bool/uint8/int8 and is not a valid field
   producer. */
static int32_t cold_make_i32_const_slot_for_field(
        BodyIR *body, ObjectField *field, int32_t value) {
    if (!field || field->kind != SLOT_I32 || field->size <= 0 ||
        field->size > 4 || field->type_name.len <= 0) {
        die("scalar field constant layout is invalid");
    }
    int32_t slot = cold_make_i32_const_slot(body, value);
    body_slot_set_type(body, slot, field->type_name);
    return slot;
}

static int32_t cold_make_str_literal_cstr_slot_exact(
        BodyIR *body, const char *text,
        ColdExprResult *result_out) {
    Span literal = cold_cstr_span(text);
    int32_t literal_index = body_string_literal(body, literal);
    int32_t slot = cold_make_str_result_slot(body);
    int32_t producer =
        body_op(body, BODY_OP_STR_LITERAL, slot, literal_index, 0);
    cold_publish_plain_string_literal_producer(
        body, slot, producer, result_out);
    return slot;
}

int32_t cold_make_str_literal_cstr_slot(
        BodyIR *body, const char *text) {
    return cold_make_str_literal_cstr_slot_exact(
        body, text, 0);
}

bool cold_try_assert_intrinsic(BodyIR *body, Span name,
                                      int32_t arg_start, int32_t arg_count,
                                      const ColdExprResult *arg_results,
                                      int32_t *slot_out, int32_t *kind_out) {
    if (!span_eq(name, "assert") && !span_eq(name, "Assert") &&
        !span_eq(name, "system.assert") && !span_eq(name, "system.Assert")) {
        return false;
    }
    if (arg_count != 2) die("assert intrinsic arity mismatch");
    int32_t cond = body->call_arg_slot[arg_start];
    int32_t msg = body->call_arg_slot[arg_start + 1];
    int32_t cond_kind = body->slot_kind[cond];
    int32_t msg_kind = body->slot_kind[msg];
    if (cond_kind != SLOT_I32 && cond_kind != SLOT_I32_REF)
        die("assert condition must be bool/i32");
    if (msg_kind != SLOT_STR && msg_kind != SLOT_STR_REF)
        die("assert message must be str");
    int32_t slot = body_slot(body, SLOT_I32, 4);
    int32_t read_op =
        body_op(body, BODY_OP_ASSERT, slot, cond, msg);
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=44175\n");
    cold_publish_exact_managed_read_or_sentinel(
        body, read_op, COLD_EXACT_READ_OPERAND_B,
        arg_results ? &arg_results[1] : 0);
    if (kind_out) *kind_out = SLOT_I32;
    *slot_out = slot;
    return true;
}

const char *cold_host_target_text(void) {
#if defined(__APPLE__) && defined(__aarch64__)
    return "arm64-apple-darwin";
#elif defined(__APPLE__) && defined(__x86_64__)
    return "x86_64-apple-darwin";
#elif defined(__linux__) && defined(__aarch64__)
    return "aarch64-unknown-linux-gnu";
#elif defined(__linux__) && defined(__x86_64__)
    return "x86_64-unknown-linux-gnu";
#else
    return "";
#endif
}

bool cold_try_bootstrap_intrinsic(BodyIR *body, Span name,
                                         int32_t arg_start, int32_t arg_count,
                                         int32_t *slot_out, int32_t *kind_out,
                                         ColdExprResult *result_out) {
    (void)arg_start;
    if (!span_eq(name, "BootstrapDetectHostTarget") &&
        !span_eq(name, "contracts.BootstrapDetectHostTarget") &&
        !span_eq(name, "bootstrap_contracts.BootstrapDetectHostTarget")) {
        return false;
    }
    if (arg_count != 0) die("BootstrapDetectHostTarget arity mismatch");
    int32_t slot =
        cold_make_str_literal_cstr_slot_exact(
            body, cold_host_target_text(), result_out);
    if (kind_out) *kind_out = SLOT_STR;
    *slot_out = slot;
    return true;
}

void cold_store_str_out_slot(BodyIR *body, int32_t dst, int32_t src, const char *context) {
    if (body->slot_kind[src] != SLOT_STR) die("str out source must be str");
    if (body->slot_kind[dst] == SLOT_STR_REF) {
        body_op(body, BODY_OP_STR_REF_STORE, dst, src, 0);
    } else if (body->slot_kind[dst] == SLOT_STR) {
        body_op3(body, BODY_OP_COPY_COMPOSITE, dst, src, 0, 0);
    } else {
        fprintf(stderr, "cheng_cold: %s str out kind mismatch got=%d\n", context, body->slot_kind[dst]);
        die("str out kind mismatch");
    }
}

ObjectField *cold_required_object_field(ObjectDef *object, const char *name) {
    ObjectField *field = object_find_field(object, cold_cstr_span(name));
    if (!field) {
        /* if this is a synthetic object (import failed), find an empty field slot */
        for (int32_t fi = 0; fi < object->field_count; fi++) {
            if (object->fields[fi].name.len == 0) {
                object->fields[fi].name = cold_cstr_span(name);
                return &object->fields[fi];
            }
        }
        fprintf(stderr, "cheng_cold: object field missing object=%.*s field=%s\n",
                object->name.len, object->name.ptr, name);
        die("required object field missing");
    }
    return field;
}

ObjectField *cold_required_existing_object_field(ObjectDef *object, const char *name) {
    ObjectField *field = object_find_field(object, cold_cstr_span(name));
    if (!field) {
        fprintf(stderr, "cheng_cold: object field missing object=%.*s field=%s\n",
                object->name.len, object->name.ptr, name);
        die("required object field missing");
    }
    return field;
}

static int32_t cold_zero_slot_for_field_exact(
        BodyIR *body, ObjectField *field,
        ColdExprResult *result_out) {
    cold_expr_result_reset(result_out);
    if (field->kind == SLOT_I32) {
        int32_t slot = cold_make_i32_const_slot(body, 0);
        body_slot_set_type(body, slot, field->type_name);
        return slot;
    }
    if (field->kind == SLOT_STR) {
        return cold_make_str_literal_cstr_slot_exact(
            body, "", result_out);
    }
    int32_t slot = body_slot_for_object_field(body, field);
    body_op3(body, BODY_OP_MAKE_COMPOSITE, slot, 0, -1, 0);
    return slot;
}

int32_t cold_zero_slot_for_field(BodyIR *body, ObjectField *field) {
    return cold_zero_slot_for_field_exact(body, field, 0);
}

static int32_t cold_exact_zero_slot_for_error_field(
        Parser *parser, BodyIR *body, ObjectField *field,
        ColdExprResult *result_out) {
    int32_t slot = cold_zero_slot_for_field_exact(
        body, field, result_out);
    if (result_out->value_def_op_id < 0) {
        int32_t kind = body->slot_kind[slot];
        int32_t storage = cold_exact_storage_authority_for_slot(
            parser->symbols, body, slot, kind);
        if (storage != COLD_MANAGED_STORAGE_UNKNOWN) {
            int32_t producer = body->op_count - 1;
            if (producer < 0 ||
                body->op_dst[producer] != slot ||
                !cold_exact_op_tuple_is_sentinel(
                    body, producer)) {
                die("Err zero value lacks canonical producer");
            }
            cold_publish_owned_managed_producer(
                body, parser->symbols, slot, kind,
                producer, result_out);
        }
    }
    return slot;
}

void cold_store_object_field_slot(BodyIR *body, int32_t object_slot,
                                         ObjectField *field, int32_t value_slot) {
    if (body->slot_kind[object_slot] == SLOT_OBJECT &&
        field->offset + field->size > body->slot_size[object_slot]) {
        fprintf(stderr,
                "cheng_cold: object field store overflow field=%.*s offset=%d size=%d object_slot_size=%d object_type=%.*s\n",
                field->name.len, field->name.ptr,
                field->offset, field->size, body->slot_size[object_slot],
                body->slot_type[object_slot].len, body->slot_type[object_slot].ptr);
        die("object field store overflow");
    }
    int32_t value_kind = body->slot_kind[value_slot];
    if (!cold_field_store_kind_compatible(field->kind, value_kind)) {
        fprintf(stderr,
                "cheng_cold: synthetic object field kind mismatch field=%.*s expected_kind=%d actual_kind=%d\n",
                (int)field->name.len, field->name.ptr,
                field->kind, value_kind);
        die("synthetic object field kind mismatch");
    }
    int32_t required_slot_size = cold_value_slot_size_for_payload_field(field);
    if (body->slot_size[value_slot] < required_slot_size ||
        (cold_field_store_requires_exact_value_layout(field->kind) &&
         body->slot_size[value_slot] != required_slot_size)) {
        die("synthetic object field layout mismatch");
    }
    if (field->kind == SLOT_ARRAY_I32 && body->slot_aux[value_slot] != field->array_len) {
        die("object field store array length mismatch");
    }
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([PFS]) fn=%.*s obj=%d val=%d off=%d sz=%d\n",
            (int)body->debug_name.len, body->debug_name.ptr,
            object_slot, value_slot, field->offset, field->size);
    body_op3(body, BODY_OP_PAYLOAD_STORE, object_slot, value_slot, field->offset, field->size);
}

void cold_store_object_field_zero(BodyIR *body, int32_t object_slot,
                                         ObjectField *field) {
    int32_t value_slot = cold_zero_slot_for_field(body, field);
    cold_store_object_field_slot(body, object_slot, field, value_slot);
}

int32_t cold_make_empty_str_seq_slot(BodyIR *body, Span type_name) {
    int32_t slot = body_slot(body, SLOT_SEQ_STR, 16);
    body_slot_set_type(body, slot, type_name.len > 0 ? type_name : cold_cstr_span("str[]"));
    body_op3(body, BODY_OP_MAKE_COMPOSITE, slot, 0, -1, 0);
    return slot;
}

int32_t cold_make_str_seq_from_slots(BodyIR *body, Span type_name,
                                     const int32_t *items,
                                     int32_t item_count) {
    if (item_count < 0) die("invalid str seq materializer");
    int32_t slot = cold_make_empty_str_seq_slot(body, type_name);
    for (int32_t i = 0; i < item_count; i++) {
        if (body->slot_kind[items[i]] != SLOT_STR &&
            body->slot_kind[items[i]] != SLOT_STR_REF) {
            die("str seq materializer item must be str");
        }
        body_op(body, BODY_OP_SEQ_STR_ADD, slot, items[i], 0);
    }
    return slot;
}

int32_t cold_make_str_seq_from_cstrs(BodyIR *body, Span type_name,
                                     const char **items,
                                     int32_t item_count) {
    if (item_count < 0) die("invalid str seq materializer");
    int32_t slots[16];
    if (item_count > (int32_t)(sizeof(slots) / sizeof(slots[0]))) {
        die("str seq materializer too large");
    }
    for (int32_t i = 0; i < item_count; i++) {
        slots[i] = cold_make_str_literal_cstr_slot(body, items[i]);
    }
    return cold_make_str_seq_from_slots(body, type_name, slots, item_count);
}

int32_t cold_make_i32_seq_from_values(BodyIR *body, Span type_name,
                                      const int32_t *items,
                                      int32_t item_count) {
    if (item_count < 0) die("invalid int32 seq materializer");
    int32_t data_slot = -1;
    if (item_count > 0) {
        int32_t payload_start = body->call_arg_count;
        for (int32_t i = 0; i < item_count; i++) {
            body_call_arg_with_offset(body, cold_make_i32_const_slot(body, items[i]), i * 4);
        }
        data_slot = body_slot(body, SLOT_ARRAY_I32, align_i32(item_count * 4, 8));
        body_slot_set_array_len(body, data_slot, item_count);
        body_op3(body, BODY_OP_MAKE_COMPOSITE, data_slot, 0, payload_start, item_count);
    }
    int32_t slot = body_slot(body, SLOT_SEQ_I32, 16);
    body_slot_set_type(body, slot, type_name.len > 0 ? type_name : cold_cstr_span("int32[]"));
    body_slot_set_array_len(body, slot, item_count);
    body_op3(body, BODY_OP_MAKE_SEQ_I32, slot, data_slot, -1, item_count);
    return slot;
}

__attribute__((unused))
int32_t cold_make_empty_seq_slot_for_field(BodyIR *body, ObjectField *field) {
    if (field->kind != SLOT_SEQ_I32 && field->kind != SLOT_SEQ_STR &&
        field->kind != SLOT_SEQ_OPAQUE) {
        die("field is not a sequence");
    }
    int32_t slot = body_slot(body, field->kind, 16);
    body_slot_set_type(body, slot, field->type_name);
    body_op3(body, BODY_OP_MAKE_COMPOSITE, slot, 0, -1, 0);
    return slot;
}

int32_t cold_make_opaque_seq_from_slots(BodyIR *body, Span type_name,
                                               int32_t *items,
                                               int32_t item_count,
                                               int32_t element_size) {
    if (item_count < 0 || element_size <= 0) die("invalid opaque seq materializer");
    int32_t payload_start = body->call_arg_count;
    for (int32_t i = 0; i < item_count; i++) {
        body_call_arg(body, items[i]);
    }
    int32_t slot = body_slot(body, SLOT_SEQ_OPAQUE, 16);
    body_slot_set_type(body, slot, type_name);
    body_op3(body, BODY_OP_MAKE_SEQ_OPAQUE, slot, payload_start, element_size, item_count);
    return slot;
}

void object_finalize_layout(ObjectDef *object);

ObjectDef *cold_slplan_object_from_slot(Parser *parser, BodyIR *body,
                                               int32_t plan_slot) {
    int32_t kind = body->slot_kind[plan_slot];
    if (kind != SLOT_OBJECT && kind != SLOT_OBJECT_REF &&
        kind != SLOT_OPAQUE && kind != SLOT_OPAQUE_REF) die("SystemLinkPlanStub expects object");
    Span object_type = cold_type_strip_var(body->slot_type[plan_slot], 0);
    ObjectDef *object = symbols_resolve_object(parser->symbols, object_type);
    if (!object) {
        /* type not loaded (import failed): return a synthetic object with dynamic fields */
        object = symbols_add_object(parser->symbols, object_type, 8);
        if (object->field_count == 8 && object->fields[0].name.len == 0) {
            for (int32_t fi = 0; fi < 8; fi++) {
                object->fields[fi].name = (Span){0};
                object->fields[fi].kind = SLOT_I32;
                object->fields[fi].size = 4;
            }
            object_finalize_layout(object);
        }
    }
    return object;
}

int32_t cold_load_slplan_field(Parser *parser, BodyIR *body,
                                      int32_t plan_slot, const char *field_name,
                                      int32_t *kind_out) {
    ObjectDef *object = cold_slplan_object_from_slot(parser, body, plan_slot);
    ObjectField *field = cold_required_object_field(object, field_name);
    int32_t slot = cold_load_object_field_slot(
        body, parser->symbols, plan_slot, field, 0);
    if (kind_out) *kind_out = field->kind;
    return slot;
}

bool cold_slplan_name_is_build(Span name) {
    (void)name;
    return false;
}

bool cold_try_slplan_intrinsic(Parser *parser, BodyIR *body, Span name,
                                      int32_t arg_start, int32_t arg_count,
                                      int32_t *slot_out, int32_t *kind_out,
                                      ColdExprResult *result_out) {
    if (cold_slplan_name_is_build(name)) {
        if (arg_count != 10) die("BuildSystemLinkPlanStubWithFields arity mismatch");
        int32_t root_dir = cold_require_str_value(body, body->call_arg_slot[arg_start], "link plan root");
        int32_t package_root = cold_require_str_value(body, body->call_arg_slot[arg_start + 1], "link plan package root");
        int32_t source_raw = cold_require_str_value(body, body->call_arg_slot[arg_start + 2], "link plan source");
        int32_t output_path = cold_require_str_value(body, body->call_arg_slot[arg_start + 3], "link plan output");
        int32_t target_triple = cold_require_str_value(body, body->call_arg_slot[arg_start + 4], "link plan target");
        int32_t emit_kind = body->call_arg_slot[arg_start + 5];
        int32_t symbol_visibility = cold_require_str_value(body, body->call_arg_slot[arg_start + 6], "link plan visibility");
        int32_t browser_bridge_object = cold_require_str_value(body, body->call_arg_slot[arg_start + 7], "link plan browser bridge");
        int32_t plan_slot = body->call_arg_slot[arg_start + 8];
        int32_t err_slot = body->call_arg_slot[arg_start + 9];
        if (body->slot_kind[emit_kind] != SLOT_I32 &&
            body->slot_kind[emit_kind] != SLOT_VARIANT) {
            fprintf(stderr, "cheng_cold: link plan emit kind must be int32, got kind=%d type=%.*s\n",
                    body->slot_kind[emit_kind],
                    body->slot_type[emit_kind].len, body->slot_type[emit_kind].ptr);
            die("link plan emit kind must be int32");
        }
        /* if variant, extract its tag as int32 */
        if (body->slot_kind[emit_kind] == SLOT_VARIANT) {
            int32_t tag_slot = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_TAG_LOAD, tag_slot, emit_kind, 0);
            emit_kind = tag_slot;
        }
        if (body->slot_kind[err_slot] != SLOT_STR_REF && body->slot_kind[err_slot] != SLOT_STR) {
            die("link plan error out must be str");
        }
        ObjectDef *plan = cold_slplan_object_from_slot(parser, body, plan_slot);

        int32_t entry_abs = cold_make_str_result_slot(body);
        body_op(body, BODY_OP_PATH_ABSOLUTE, entry_abs, root_dir, source_raw);

        ObjectField *entry_path_f = cold_required_object_field(plan, "entryPath");
        cold_store_object_field_slot(body, plan_slot, entry_path_f, entry_abs);
        cold_store_object_field_slot(body, plan_slot, cold_required_object_field(plan, "outputPath"), output_path);
        cold_store_object_field_slot(body, plan_slot, cold_required_object_field(plan, "targetTriple"), target_triple);
        cold_store_object_field_slot(body, plan_slot, cold_required_object_field(plan, "emitKind"), emit_kind);
        cold_store_object_field_slot(body, plan_slot, cold_required_object_field(plan, "symbolVisibility"), symbol_visibility);
        cold_store_object_field_slot(body, plan_slot, cold_required_object_field(plan, "browserBridgeObjectPath"), browser_bridge_object);
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "exportRootSymbols"),
                                     cold_make_empty_str_seq_slot(body, cold_cstr_span("str[]")));
        cold_store_object_field_slot(body, plan_slot, cold_required_object_field(plan, "packageRoot"), package_root);
        cold_store_object_field_zero(body, plan_slot, cold_required_object_field(plan, "externalPackageRoots"));
        cold_store_object_field_slot(body, plan_slot, cold_required_object_field(plan, "workspaceRoot"), package_root);
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "packageId"),
                                     cold_make_str_literal_cstr_slot(body, "pkg://cheng"));
        cold_store_object_field_slot(body, plan_slot, cold_required_object_field(plan, "moduleStem"), source_raw);
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "moduleKind"),
                                     cold_make_i32_const_slot(body, 0));
        cold_store_object_field_zero(body, plan_slot, cold_required_object_field(plan, "sourceBundleCid"));
        cold_store_object_field_zero(body, plan_slot, cold_required_object_field(plan, "sourceBundleCidValue"));

        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "sourceClosurePaths"),
                                     cold_make_empty_str_seq_slot(body, cold_cstr_span("str[]")));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "ownerModulePaths"),
                                     cold_make_empty_str_seq_slot(body, cold_cstr_span("str[]")));

        cold_store_object_field_zero(body, plan_slot, cold_required_object_field(plan, "importEdges"));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "importEdgeCount"),
                                     cold_make_i32_const_slot(body, 0));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "unresolvedImportCount"),
                                     cold_make_i32_const_slot(body, 0));
        cold_store_object_field_zero(body, plan_slot, cold_required_object_field(plan, "exprLayer"));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "hasCompilerTopLevel"),
                                     cold_make_i32_const_slot(body, 1));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "mainFunctionPresent"),
                                     cold_make_i32_const_slot(body, 1));

        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "runtimeTargets"),
                                     cold_make_empty_str_seq_slot(body, cold_cstr_span("str[]")));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "providerModules"),
                                     cold_make_empty_str_seq_slot(body, cold_cstr_span("str[]")));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "entrySymbol"),
                                     cold_make_str_literal_cstr_slot(body, "main"));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "missingReasons"),
                                     cold_make_empty_str_seq_slot(body, cold_cstr_span("str[]")));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "parserSyntaxTag"),
                                     cold_make_str_literal_cstr_slot(body, "cold_direct"));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "parserSourceKind"),
                                     cold_make_i32_const_slot(body, 0));

        int32_t build_entry_leaf = cold_make_str_literal_cstr_slot(body, "src/core/tooling/compiler_main.cheng");
        int32_t build_entry = cold_make_str_result_slot(body);
        body_op(body, BODY_OP_PATH_JOIN, build_entry, package_root, build_entry_leaf);
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "buildEntryPath"),
                                     build_entry);
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "buildSourceUnitCount"),
                                     cold_make_i32_const_slot(body, 1));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "linkMode"),
                                     cold_make_str_literal_cstr_slot(body, "system_link"));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "pipelineStage"),
                                     cold_make_str_literal_cstr_slot(body, "cold_system_link_plan"));
        cold_store_object_field_slot(body, plan_slot,
                                     cold_required_object_field(plan, "jobCount"),
                                     cold_make_i32_const_slot(body, 1));

        int32_t empty = cold_make_str_literal_cstr_slot(body, "");
        cold_store_str_out_slot(body, err_slot, empty, "BuildSystemLinkPlanStubWithFields err");

        int32_t ok = cold_make_i32_const_slot(body, 1);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = ok;
        return true;
    }

    if (span_eq(name, "slplan.SystemLinkPlanListText") ||
        span_eq(name, "SystemLinkPlanListText")) {
        if (arg_count != 1) die("SystemLinkPlanListText arity mismatch");
        int32_t items = body->call_arg_slot[arg_start];
        if (body->slot_kind[items] != SLOT_SEQ_STR && body->slot_kind[items] != SLOT_SEQ_STR_REF) {
            if (parser->import_mode) {
                int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
                if (kind_out) *kind_out = SLOT_STR;
                *slot_out = slot;
                return true;
            }
            die("SystemLinkPlanListText expects str[]");
        }
        int32_t sep = cold_make_str_literal_cstr_slot(body, ",");
        int32_t slot = cold_make_str_result_slot(body);
        int32_t producer =
            body_op(body, BODY_OP_STR_JOIN, slot, items, sep);
        cold_publish_owned_managed_producer(
            body, parser->symbols, slot, SLOT_STR, producer,
            result_out);
        if (kind_out) *kind_out = SLOT_STR;
        *slot_out = slot;
        return true;
    }
    return false;
}

int32_t cold_make_error_info_slot(Parser *parser, BodyIR *body,
                                  Span error_info_type,
                                  const char *message,
                                  ColdExprResult *result_out) {
    ObjectDef *error_info = symbols_resolve_object(
        parser->symbols, error_info_type);
    if (!error_info) die("ErrorInfo layout missing");
    ObjectField *code = cold_required_object_field(error_info, "code");
    ObjectField *msg = cold_required_object_field(error_info, "msg");
    ColdExprResult msg_result;
    cold_expr_result_reset(&msg_result);
    int32_t payload_start = body->call_arg_count;
    body_call_arg_with_offset(body, cold_make_i32_const_slot(body, 1), code->offset);
    int32_t msg_slot = cold_make_str_literal_cstr_slot_exact(
        body, message, &msg_result);
    int32_t msg_row = body_call_arg_with_offset(
        body, msg_slot, msg->offset);
    cold_bind_parsed_call_arg_authority(
        body, msg_row, &msg_result);
    int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(error_info));
    body_slot_set_type(body, slot, error_info_type);
    int32_t producer = body_op3(
        body, BODY_OP_MAKE_COMPOSITE,
        slot, 0, payload_start, 2);
    cold_publish_owned_managed_producer(
        body, parser->symbols, slot,
        SLOT_OBJECT, producer, result_out);
    return slot;
}

int32_t cold_make_error_info_slot_from_msg(Parser *parser, BodyIR *body,
                                           Span error_info_type,
                                           int32_t msg_slot,
                                           const ColdExprResult *msg_result,
                                           ColdExprResult *result_out) {
    ObjectDef *error_info = symbols_resolve_object(
        parser->symbols, error_info_type);
    if (!error_info) die("ErrorInfo layout missing");
    ObjectField *code = cold_required_object_field(error_info, "code");
    ObjectField *msg = cold_required_object_field(error_info, "msg");
    if (!cold_slot_kind_is_str_like(body->slot_kind[msg_slot])) {
        die("Err message must be str");
    }
    bool msg_was_ref = body->slot_kind[msg_slot] == SLOT_STR_REF;
    msg_slot = cold_materialize_fmt_str(body, msg_slot, body->slot_kind[msg_slot]);
    if (msg_was_ref && msg_result &&
        msg_result->value_def_op_id >= 0 &&
        msg_result->value_def_op_id < body->op_count &&
        cold_exact_op_tuple_matches_result(body, msg_result)) {
        /* The dereferenced value slot is a read-only view of the exact
           source (e.g. an immortal global shadow): publish the borrow
           projection so the aggregate payload row carries authority. */
        int32_t load = body->op_count - 1;
        if (load < 0 || body->op_kind[load] != BODY_OP_PAYLOAD_LOAD ||
            body->op_dst[load] != msg_slot ||
            body->op_a[load] != msg_result->slot) {
            die("Err message dereference carrier is invalid");
        }
        int32_t msg_type_id =
            cold_exact_managed_type_id(
                parser->symbols, body, msg_slot, SLOT_STR);
        if (msg_type_id < 0)
            die("Err message view TypeId is missing");
        body->op_value_def_slot[load] = msg_slot;
        body->op_value_def_exact_type_id[load] = msg_type_id;
        body->op_value_def_producer_function_row[load] =
            body->producer_function_row;
        body->op_value_def_place_kind[load] =
            COLD_EXPR_PLACE_BORROW_PROJECTION;
        body->op_value_def_ownership[load] =
            COLD_EXPR_OWN_BORROW_SHARED;
        body->op_value_def_origin_id[load] =
            msg_result->value_def_op_id;
        body->slot_place_kind[msg_slot] =
            COLD_EXPR_PLACE_BORROW_PROJECTION;
        body->slot_exact_type_id[msg_slot] = msg_type_id;
        body->slot_origin_id[msg_slot] =
            msg_result->value_def_op_id;
        body->slot_managed_storage_kind[msg_slot] = COLD_MANAGED_STORAGE_STR;
    }
    int32_t payload_start = body->call_arg_count;
    body_call_arg_with_offset(body, cold_make_i32_const_slot(body, 1), code->offset);
    int32_t msg_row = body_call_arg_with_offset(
        body, msg_slot, msg->offset);
    bool exact_msg = msg_result &&
        msg_result->slot == msg_slot &&
        msg_result->kind == SLOT_STR &&
        msg_result->value_def_op_id >= 0 &&
        cold_exact_op_tuple_matches_result(body, msg_result);
    if (exact_msg) {
        cold_bind_parsed_call_arg_authority(
            body, msg_row, msg_result);
    }
    int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(error_info));
    body_slot_set_type(body, slot, error_info_type);
    int32_t producer = body_op3(
        body, BODY_OP_MAKE_COMPOSITE,
        slot, 0, payload_start, 2);
    if (exact_msg &&
        msg_result->ownership == COLD_EXPR_OWN_MOVE) {
        int32_t definition = msg_result->value_def_op_id;
        if (body->op_value_def_consume_op_index_plus_one[
                definition] != 0 ||
            !cold_exact_definition_is_live_before_op(
                body, definition, producer)) {
            die("Err message source is not movable");
        }
        body->op_value_def_consume_op_index_plus_one[
            definition] = producer + 1;
    } else if (exact_msg &&
               (msg_result->ownership ==
                    COLD_EXPR_OWN_BORROW_SHARED ||
                msg_result->ownership ==
                    COLD_EXPR_OWN_BORROW_UNIQUE)) {
        /* ORC fix (registry_miss): a borrowed message bound into an owned
           ErrorInfo composite must become an independent owner before the
           composite is moved to the caller. Without the retain the source
           owner and the composite each drop the same payload once. */
        cold_emit_str_owned_retain(
            parser, body, parser->symbols, msg_slot, msg_result);
    }
    cold_publish_owned_managed_producer(
        body, parser->symbols, slot,
        SLOT_OBJECT, producer, result_out);
    return slot;
}

int32_t cold_make_error_result_slot(Parser *parser, BodyIR *body,
                                           Span result_type,
                                           const char *message) {
    ObjectDef *result = symbols_resolve_object(parser->symbols, result_type);
    if (!result) die("Result layout missing");
    if (!cold_result_layout_exact_identity_matches(
            parser->symbols, result, result_type)) {
        die("Result layout exact type mismatch");
    }
    ObjectField *ok = cold_required_existing_object_field(result, "ok");
    ObjectField *value = cold_required_existing_object_field(result, "value");
    ObjectField *err = cold_required_existing_object_field(result, "err");
    if (ok->kind != SLOT_I32 || err->kind != SLOT_OBJECT) die("Result layout kind mismatch");
    ColdExprResult err_info_result;
    cold_expr_result_reset(&err_info_result);
    int32_t err_info_slot = cold_make_error_info_slot(
        parser, body, err->type_name,
        message, &err_info_result);
    int32_t payload_start = body->call_arg_count;
    body_call_arg_with_offset(
        body,
        cold_make_i32_const_slot_for_field(body, ok, 0),
        ok->offset);
    ColdExprResult value_result;
    cold_expr_result_reset(&value_result);
    int32_t value_slot = cold_exact_zero_slot_for_error_field(
        parser, body, value, &value_result);
    int32_t value_row = body_call_arg_with_offset(
        body, value_slot, value->offset);
    if (value_result.value_def_op_id >= 0) {
        cold_bind_parsed_call_arg_authority(
            body, value_row, &value_result);
    }
    int32_t err_row = body_call_arg_with_offset(
        body, err_info_slot, err->offset);
    cold_bind_parsed_call_arg_authority(
        body, err_row, &err_info_result);
    int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(result));
    body_slot_set_type(body, slot, result->name);
    int32_t producer = body_op3(
        body, BODY_OP_MAKE_COMPOSITE,
        slot, 0, payload_start, 3);
    if (value_result.value_def_op_id >= 0 &&
        value_result.ownership == COLD_EXPR_OWN_MOVE) {
        body->op_value_def_consume_op_index_plus_one[
            value_result.value_def_op_id] = producer + 1;
    }
    body->op_value_def_consume_op_index_plus_one[
        err_info_result.value_def_op_id] = producer + 1;
    cold_publish_owned_managed_producer(
        body, parser->symbols, slot,
        SLOT_OBJECT, producer, 0);
    return slot;
}

int32_t cold_make_error_result_slot_from_msg(Parser *parser, BodyIR *body,
                                             Span result_type,
                                             int32_t msg_slot,
                                             const ColdExprResult *msg_result,
                                             ColdExprResult *result_out) {
    ObjectDef *result = symbols_resolve_object(parser->symbols, result_type);
    if (!result) die("Result layout missing");
    if (!cold_result_layout_exact_identity_matches(
            parser->symbols, result, result_type)) {
        die("Result layout exact type mismatch");
    }
    ObjectField *ok = cold_required_existing_object_field(result, "ok");
    ObjectField *value = cold_required_existing_object_field(result, "value");
    ObjectField *err = cold_required_existing_object_field(result, "err");
    if (ok->kind != SLOT_I32 || err->kind != SLOT_OBJECT) die("Result layout kind mismatch");
    ColdExprResult err_info_result;
    cold_expr_result_reset(&err_info_result);
    int32_t err_info_slot = cold_make_error_info_slot_from_msg(
        parser, body, err->type_name,
        msg_slot, msg_result,
        &err_info_result);
    int32_t payload_start = body->call_arg_count;
    body_call_arg_with_offset(
        body,
        cold_make_i32_const_slot_for_field(body, ok, 0),
        ok->offset);
    ColdExprResult value_result;
    cold_expr_result_reset(&value_result);
    int32_t value_slot = cold_exact_zero_slot_for_error_field(
        parser, body, value, &value_result);
    int32_t value_row = body_call_arg_with_offset(
        body, value_slot, value->offset);
    if (value_result.value_def_op_id >= 0) {
        cold_bind_parsed_call_arg_authority(
            body, value_row, &value_result);
    }
    int32_t err_row = body_call_arg_with_offset(
        body, err_info_slot, err->offset);
    cold_bind_parsed_call_arg_authority(
        body, err_row, &err_info_result);
    int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(result));
    body_slot_set_type(body, slot, result->name);
    int32_t producer = body_op3(
        body, BODY_OP_MAKE_COMPOSITE,
        slot, 0, payload_start, 3);
    if (value_result.value_def_op_id >= 0 &&
        value_result.ownership == COLD_EXPR_OWN_MOVE) {
        body->op_value_def_consume_op_index_plus_one[
            value_result.value_def_op_id] = producer + 1;
    }
    body->op_value_def_consume_op_index_plus_one[
        err_info_result.value_def_op_id] = producer + 1;
    cold_publish_result_aggregate(
        body, parser->symbols, slot,
        producer, msg_result, result_out);
    return slot;
}

/* ErrCode[T](code, msg) inline construction with the concrete Result[T]
   layout — mirrors cold_make_error_result_slot_from_msg but takes an explicit
   error code instead of the fixed code=1. */
int32_t cold_make_error_result_slot_from_code_msg(Parser *parser, BodyIR *body,
                                                  Span result_type,
                                                  int32_t code_slot,
                                                  int32_t msg_slot,
                                                  const ColdExprResult *msg_result,
                                                  ColdExprResult *result_out) {
    ObjectDef *result = symbols_resolve_object(parser->symbols, result_type);
    if (!result) die("Result layout missing");
    if (!cold_result_layout_exact_identity_matches(
            parser->symbols, result, result_type)) {
        die("Result layout exact type mismatch");
    }
    ObjectField *ok = cold_required_existing_object_field(result, "ok");
    ObjectField *value = cold_required_existing_object_field(result, "value");
    ObjectField *err = cold_required_existing_object_field(result, "err");
    if (ok->kind != SLOT_I32 || err->kind != SLOT_OBJECT) die("Result layout kind mismatch");
    ObjectDef *error_info = symbols_resolve_object(
        parser->symbols, err->type_name);
    if (!error_info) die("ErrorInfo layout missing");
    ObjectField *code = cold_required_object_field(error_info, "code");
    ObjectField *msg = cold_required_object_field(error_info, "msg");
    int32_t code_kind = body->slot_kind[code_slot];
    code_slot = cold_materialize_i32_ref(body, code_slot, &code_kind);
    if (code_kind != SLOT_I32) die("ErrCode code must be int32");
    if (!cold_slot_kind_is_str_like(body->slot_kind[msg_slot])) die("ErrCode message must be str");
    msg_slot = cold_materialize_fmt_str(body, msg_slot, body->slot_kind[msg_slot]);
    int32_t err_payload_start = body->call_arg_count;
    body_call_arg_with_offset(body, code_slot, code->offset);
    int32_t msg_row = body_call_arg_with_offset(
        body, msg_slot, msg->offset);
    bool exact_msg = msg_result &&
        msg_result->slot == msg_slot &&
        msg_result->kind == SLOT_STR &&
        msg_result->value_def_op_id >= 0 &&
        cold_exact_op_tuple_matches_result(body, msg_result);
    if (exact_msg) {
        cold_bind_parsed_call_arg_authority(
            body, msg_row, msg_result);
    }
    int32_t err_info_slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(error_info));
    body_slot_set_type(body, err_info_slot, err->type_name);
    int32_t err_info_producer = body_op3(
        body, BODY_OP_MAKE_COMPOSITE,
        err_info_slot, 0, err_payload_start, 2);
    if (exact_msg &&
        msg_result->ownership == COLD_EXPR_OWN_MOVE) {
        int32_t definition = msg_result->value_def_op_id;
        if (body->op_value_def_consume_op_index_plus_one[
                definition] != 0 ||
            !cold_exact_definition_is_live_before_op(
                body, definition, err_info_producer)) {
            die("ErrCode message source is not movable");
        }
        body->op_value_def_consume_op_index_plus_one[
            definition] = err_info_producer + 1;
    }
    ColdExprResult err_info_result;
    cold_expr_result_reset(&err_info_result);
    cold_publish_owned_managed_producer(
        body, parser->symbols, err_info_slot,
        SLOT_OBJECT, err_info_producer,
        &err_info_result);
    int32_t payload_start = body->call_arg_count;
    body_call_arg_with_offset(
        body,
        cold_make_i32_const_slot_for_field(body, ok, 0),
        ok->offset);
    ColdExprResult value_result;
    cold_expr_result_reset(&value_result);
    int32_t value_slot = cold_exact_zero_slot_for_error_field(
        parser, body, value, &value_result);
    int32_t value_row = body_call_arg_with_offset(
        body, value_slot, value->offset);
    if (value_result.value_def_op_id >= 0) {
        cold_bind_parsed_call_arg_authority(
            body, value_row, &value_result);
    }
    int32_t err_row = body_call_arg_with_offset(
        body, err_info_slot, err->offset);
    cold_bind_parsed_call_arg_authority(
        body, err_row, &err_info_result);
    int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(result));
    body_slot_set_type(body, slot, result->name);
    int32_t producer = body_op3(
        body, BODY_OP_MAKE_COMPOSITE,
        slot, 0, payload_start, 3);
    if (value_result.value_def_op_id >= 0 &&
        value_result.ownership == COLD_EXPR_OWN_MOVE) {
        body->op_value_def_consume_op_index_plus_one[
            value_result.value_def_op_id] = producer + 1;
    }
    body->op_value_def_consume_op_index_plus_one[
        err_info_result.value_def_op_id] = producer + 1;
    cold_publish_result_aggregate(
        body, parser->symbols, slot,
        producer, msg_result, result_out);
    return slot;
}

ObjectDef *cold_resolve_object_any(Symbols *symbols, Span actual_type,
                                   const char *qualified,
                                   const char *unqualified);
void cold_store_required_field(BodyIR *body, int32_t object_slot,
                               ObjectDef *object,
                               const char *field_name,
                               int32_t value_slot);

bool cold_try_backend_intrinsic(Parser *parser, BodyIR *body, Span name,
                                       int32_t arg_start, int32_t arg_count,
                                       int32_t *slot_out, int32_t *kind_out) {
    const char *target_needle = 0;
    if (span_eq(name, "tmat.TargetIsWasm") || span_eq(name, "TargetIsWasm")) {
        target_needle = "wasm";
    } else if (span_eq(name, "tmat.TargetIsDarwinArm64") || span_eq(name, "TargetIsDarwinArm64")) {
        target_needle = "darwin";
    } else if (span_eq(name, "tmat.TargetIsLinuxX8664") || span_eq(name, "TargetIsLinuxX8664")) {
        target_needle = "x86_64-unknown-linux-gnu";
    } else if (span_eq(name, "tmat.TargetIsWindows") || span_eq(name, "TargetIsWindows")) {
        target_needle = "windows";
    } else if (span_eq(name, "tmat.TargetIsWindowsAarch64") || span_eq(name, "TargetIsWindowsAarch64")) {
        target_needle = "windows-aarch64";
    } else if (span_eq(name, "tmat.TargetIsWindowsX8664") || span_eq(name, "TargetIsWindowsX8664")) {
        target_needle = "x86_64-pc-windows-msvc";
    }
    if (target_needle) {
        if (arg_count != 1) die("target predicate arity mismatch");
        int32_t triple = cold_require_str_value(body, body->call_arg_slot[arg_start], "target predicate");
        int32_t needle = cold_make_str_literal_cstr_slot(body, target_needle);
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_TEXT_CONTAINS, slot, triple, needle);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "BackendDriverDispatchMinIsColdCompilerProbe") ||
        span_eq(name, "BackendDriverDispatchMinIsColdCompilerProbe")) {
        if (arg_count != 0) die("IsColdCompilerProbe arity mismatch");
        int32_t slot = cold_make_i32_const_slot(body, 1);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "direct.DirectObjectEmitCanStandaloneMain") ||
        span_eq(name, "DirectObjectEmitCanStandaloneMain")) {
        if (arg_count != 1) die("DirectObjectEmitCanStandaloneMain arity mismatch");
        int32_t plan = body->call_arg_slot[arg_start];
        if (body->slot_kind[plan] != SLOT_OBJECT && body->slot_kind[plan] != SLOT_OBJECT_REF &&
            body->slot_kind[plan] != SLOT_OPAQUE && body->slot_kind[plan] != SLOT_OPAQUE_REF) {
            die("DirectObjectEmitCanStandaloneMain plan must be object");
        }
        int32_t slot = cold_make_i32_const_slot(body, 0);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "direct.DirectObjectEmitCompileFromSource") ||
        span_eq(name, "DirectObjectEmitCompileFromSource")) {
        if (arg_count != 3) die("DirectObjectEmitCompileFromSource arity mismatch");
        (void)cold_require_str_value(body, body->call_arg_slot[arg_start], "compile root");
        int32_t src_slot = cold_require_str_value(body, body->call_arg_slot[arg_start + 1], "compile source");
        int32_t out_slot = cold_require_str_value(body, body->call_arg_slot[arg_start + 2], "compile output");
        const char *src_path = body_strdup_from_slot(parser->arena, body, src_slot);
        const char *out_path = body_strdup_from_slot(parser->arena, body, out_slot);
        int32_t result = 1;
        if (src_path && out_path) {
            result = cold_compile_source_to_object(
                out_path, src_path, 0, 0, 0, "public", false, 0)
                ? 0
                : 1;
        }
        int32_t slot = cold_make_i32_const_slot(body, result);
        if (kind_out) *kind_out = SLOT_I32;
        *slot_out = slot;
        return true;
    }
    return false;
}

ObjectDef *cold_resolve_object_any(Symbols *symbols, Span actual_type,
                                          const char *qualified,
                                          const char *unqualified) {
    ObjectDef *object = 0;
    if (actual_type.len > 0) object = symbols_resolve_object(symbols, cold_type_strip_var(actual_type, 0));
    if (!object && qualified) object = symbols_resolve_object(symbols, cold_cstr_span(qualified));
    if (!object && unqualified) object = symbols_resolve_object(symbols, cold_cstr_span(unqualified));
    return object;
}

void cold_store_required_field(BodyIR *body, int32_t object_slot,
                                      ObjectDef *object,
                                      const char *field_name,
                                      int32_t value_slot) {
    ObjectField *field = cold_required_object_field(object, field_name);
    cold_store_object_field_slot(body, object_slot, field, value_slot);
}

void cold_store_required_field_zero(BodyIR *body, int32_t object_slot,
                                           ObjectDef *object,
                                           const char *field_name) {
    cold_store_object_field_zero(body, object_slot,
                                 cold_required_object_field(object, field_name));
}

bool cold_object_field_fits_slot(BodyIR *body, int32_t object_slot,
                                        ObjectField *field) {
    if (body->slot_kind[object_slot] != SLOT_OBJECT) return true;
    return field->offset >= 0 &&
           field->size >= 0 &&
           field->offset + field->size <= body->slot_size[object_slot];
}

void cold_store_required_field_if_fits(BodyIR *body, int32_t object_slot,
                                              ObjectDef *object,
                                              const char *field_name,
                                              int32_t value_slot) {
    ObjectField *field = cold_required_object_field(object, field_name);
    if (!cold_object_field_fits_slot(body, object_slot, field)) return;
    cold_store_object_field_slot(body, object_slot, field, value_slot);
}

int32_t cold_make_csg_node_slot(BodyIR *body, ObjectDef *node_obj,
                                       int32_t node_id,
                                       int32_t node_kind,
                                       int32_t owner_node_id,
                                       int32_t module_path,
                                       int32_t symbol_text,
                                       int32_t fact_text,
                                       int32_t result_layout_kind,
                                       int32_t effect_kind,
                                       int32_t capability_kind,
                                       int32_t call_conv,
                                       int32_t entry_flag,
                                       int32_t exported_flag,
                                       int32_t export_symbol_name) {
    int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(node_obj));
    body_slot_set_type(body, slot, node_obj->name);
    body_op3(body, BODY_OP_MAKE_COMPOSITE, slot, 0, -1, 0);
    cold_store_required_field(body, slot, node_obj, "nodeId", cold_make_i32_const_slot(body, node_id));
    cold_store_required_field(body, slot, node_obj, "nodeKind", cold_make_i32_const_slot(body, node_kind));
    cold_store_required_field(body, slot, node_obj, "ownerNodeId", cold_make_i32_const_slot(body, owner_node_id));
    cold_store_required_field(body, slot, node_obj, "modulePath", module_path);
    cold_store_required_field(body, slot, node_obj, "symbolText", symbol_text);
    cold_store_required_field(body, slot, node_obj, "factText", fact_text);
    cold_store_required_field(body, slot, node_obj, "resultLayoutKind", cold_make_i32_const_slot(body, result_layout_kind));
    cold_store_required_field(body, slot, node_obj, "effectKind", cold_make_i32_const_slot(body, effect_kind));
    cold_store_required_field(body, slot, node_obj, "capabilityKind", cold_make_i32_const_slot(body, capability_kind));
    cold_store_required_field(body, slot, node_obj, "callConv", cold_make_i32_const_slot(body, call_conv));
    cold_store_required_field(body, slot, node_obj, "entryFlag", cold_make_i32_const_slot(body, entry_flag));
    cold_store_required_field(body, slot, node_obj, "exportedFlag", cold_make_i32_const_slot(body, exported_flag));
    cold_store_required_field(body, slot, node_obj, "exportSymbolName", export_symbol_name);
    cold_store_required_field_zero(body, slot, node_obj, "factCid");
    return slot;
}

int32_t cold_make_csg_edge_slot(BodyIR *body, ObjectDef *edge_obj,
                                       int32_t edge_id,
                                       int32_t from_node_id,
                                       int32_t to_node_id,
                                       int32_t edge_kind) {
    int32_t slot = body_slot(body, SLOT_OBJECT, symbols_object_slot_size(edge_obj));
    body_slot_set_type(body, slot, edge_obj->name);
    body_op3(body, BODY_OP_MAKE_COMPOSITE, slot, 0, -1, 0);
    cold_store_required_field(body, slot, edge_obj, "edgeId", cold_make_i32_const_slot(body, edge_id));
    cold_store_required_field(body, slot, edge_obj, "fromNodeId", cold_make_i32_const_slot(body, from_node_id));
    cold_store_required_field(body, slot, edge_obj, "toNodeId", cold_make_i32_const_slot(body, to_node_id));
    cold_store_required_field(body, slot, edge_obj, "edgeKind", cold_make_i32_const_slot(body, edge_kind));
    cold_store_required_field_zero(body, slot, edge_obj, "edgeCid");
    return slot;
}

bool cold_try_csg_intrinsic(Parser *parser, BodyIR *body, Span name,
                                   int32_t arg_start, int32_t arg_count,
                                   int32_t *slot_out, int32_t *kind_out,
                                   ColdExprResult *result_out) {
    (void)parser;
    (void)body;
    (void)name;
    (void)arg_start;
    (void)arg_count;
    (void)slot_out;
    (void)kind_out;
    (void)result_out;
    return false;
}

bool cold_is_i64_cast_token(Span token) {
    return span_eq(token, "int64") || span_eq(token, "Int64") ||
           span_eq(token, "uint64") || span_eq(token, "Uint64") ||
           span_eq(token, "UInt64");
}

static Span cold_primitive_pointer_cast_type(Span token) {
    if (span_eq(token, "Int8Ptr") || span_eq(token, "int8Ptr"))
        return cold_cstr_span("int8*");
    if (span_eq(token, "UInt8Ptr") || span_eq(token, "uint8Ptr"))
        return cold_cstr_span("uint8*");
    if (span_eq(token, "Int16Ptr") || span_eq(token, "int16Ptr"))
        return cold_cstr_span("int16*");
    if (span_eq(token, "UInt16Ptr") || span_eq(token, "uint16Ptr"))
        return cold_cstr_span("uint16*");
    if (span_eq(token, "Int32Ptr") || span_eq(token, "int32Ptr"))
        return cold_cstr_span("int32*");
    if (span_eq(token, "UInt32Ptr") || span_eq(token, "uint32Ptr"))
        return cold_cstr_span("uint32*");
    if (span_eq(token, "Int64Ptr") || span_eq(token, "int64Ptr"))
        return cold_cstr_span("int64*");
    if (span_eq(token, "UInt64Ptr") || span_eq(token, "uint64Ptr"))
        return cold_cstr_span("uint64*");
    if (span_eq(token, "BoolPtr") || span_eq(token, "boolPtr"))
        return cold_cstr_span("bool*");
    if (span_eq(token, "VoidPtrPtr") || span_eq(token, "voidPtrPtr"))
        return cold_cstr_span("void**");
    return (Span){0};
}

static int32_t parse_primitive_pointer_cast(Parser *parser, BodyIR *body,
                                            Locals *locals, Span cast_token,
                                            int32_t *kind) {
    Span pointer_type = cold_primitive_pointer_cast_type(cast_token);
    if (pointer_type.len <= 0) die("unknown primitive pointer cast");
    if (!parser_take(parser, "(")) die("expected ( after primitive pointer cast");
    int32_t value_kind = SLOT_PTR;
    int32_t value_slot = parse_expr(
        parser, body, locals, &value_kind);
    if (!parser_take(parser, ")")) die("expected ) after primitive pointer cast");
    value_slot = cold_materialize_global_ref_value(body, value_slot, &value_kind);
    if (!cold_kind_is_pointer_like(value_kind)) {
        value_slot = cold_materialize_ptr_value(body, value_slot, &value_kind);
    }
    int32_t slot = body_slot(body, SLOT_PTR, 8);
    body_slot_set_type(body, slot, pointer_type);
    body_op(body, BODY_OP_COPY_I64, slot, value_slot, 0);
    *kind = SLOT_PTR;
    return slot;
}

int32_t parse_cstring_cast(Parser *parser, BodyIR *body,
                           Locals *locals, int32_t *kind) {
    if (!parser_take(parser, "(")) die("expected ( after cstring cast");
    int32_t value_start = parser->pos;
    int32_t value_kind = SLOT_I32;
    ColdExprResult value_result;
    cold_expr_result_reset(&value_result);
    int32_t value_slot = cold_parse_expr_with_result(
        parser, body, locals, &value_kind, &value_result);
    if (!parser_take(parser, ")")) die("expected ) after cstring cast");
    if (value_kind == SLOT_STR && body_slot_is_str_literal(body, value_slot)) {
        Span literal = body_get_str_literal_span(body, value_slot);
        for (int32_t i = 0; i < literal.len; i++) {
            if (literal.ptr[i] == 0) {
                Span expr_loc = span_sub(parser->source, value_start, parser->pos);
                fprintf(stderr, "ZRPC/SABI violation: ");
                cold_error_loc(parser, expr_loc);
                fprintf(stderr, ": str -> cstring contains embedded NUL.\n");
                ColdErrorRecoveryEnabled = false;
                die("ZRPC/SABI violation");
            }
        }
    }
    int32_t slot = value_slot;
    if (value_kind == SLOT_STR || value_kind == SLOT_STR_REF) {
        slot = cold_materialize_str_data_ptr(
            body, value_slot, value_kind, &value_result);
    } else if (value_kind == SLOT_OPAQUE || value_kind == SLOT_OPAQUE_REF ||
               value_kind == SLOT_PTR) {
        if (value_kind == SLOT_OPAQUE_REF) {
            int32_t loaded = body_slot(body, SLOT_OPAQUE, 8);
            body_op(body, BODY_OP_PTR_LOAD_I64, loaded, value_slot, 0);
            slot = loaded;
        }
    } else {
        Span expr_loc = span_sub(parser->source, value_start, parser->pos);
        fprintf(stderr, "cheng_cold: ");
        cold_error_loc(parser, expr_loc);
        fprintf(stderr, " cstring cast expects str or pointer value_kind=%d\n", value_kind);
        cold_print_context(parser, expr_loc);
        die("cstring cast expects str or pointer");
    }
    body_slot_set_type(body, slot, cold_cstr_span("cstring"));
    *kind = SLOT_OPAQUE;
    return slot;
}

int32_t cold_make_i64_const_slot(BodyIR *body, int64_t value) {
    uint64_t bits = (uint64_t)value;
    int32_t slot = body_slot(body, SLOT_I64, 8);
    body_op(body, BODY_OP_I64_CONST, slot,
            (int32_t)(uint32_t)(bits & 0xFFFFFFFFu),
            (int32_t)(uint32_t)(bits >> 32));
    body_slot_set_type(body, slot, cold_cstr_span("int64"));
    return slot;
}

static int32_t cold_materialize_numeric_ref_value(BodyIR *body, int32_t slot,
                                                  int32_t *kind) {
    slot = cold_materialize_i32_ref(body, slot, kind);
    if (*kind == SLOT_I64_REF) {
        slot = cold_materialize_i64_value(body, slot, kind);
    }
    return slot;
}

static bool cold_slot_type_is_uint32(BodyIR *body, int32_t slot);

static Span cold_i32_scalar_cast_type(Span cast_token) {
    if (span_eq(cast_token, "int32") || span_eq(cast_token, "Int32") ||
        span_eq(cast_token, "int") || span_eq(cast_token, "Int")) {
        return cold_cstr_span("int32");
    }
    if (span_eq(cast_token, "bool") || span_eq(cast_token, "Bool"))
        return cold_cstr_span("bool");
    if (span_eq(cast_token, "uint8") || span_eq(cast_token, "Uint8"))
        return cold_cstr_span("uint8");
    if (span_eq(cast_token, "int8") || span_eq(cast_token, "Int8"))
        return cold_cstr_span("int8");
    if (span_eq(cast_token, "char") || span_eq(cast_token, "Char"))
        return cold_cstr_span("char");
    if (span_eq(cast_token, "int16") || span_eq(cast_token, "Int16"))
        return cold_cstr_span("int16");
    if (span_eq(cast_token, "uint16") || span_eq(cast_token, "Uint16") ||
        span_eq(cast_token, "UInt16"))
        return cold_cstr_span("uint16");
    if (span_eq(cast_token, "uint32") || span_eq(cast_token, "Uint32"))
        return cold_cstr_span("uint32");
    return (Span){0};
}

int32_t parse_scalar_identity_cast(Parser *parser, BodyIR *body,
                                          Locals *locals, Span cast_token,
                                          int32_t *kind) {
    if (!parser_take(parser, "(")) die("expected ( after scalar cast");
    /* float64 cast: float64(expr) */
    if (span_eq(cast_token, "float64") || span_eq(cast_token, "Float64")) {
        int32_t value_kind = SLOT_I32;
        int32_t value_slot = parse_expr(parser, body, locals, &value_kind);
        if (!parser_take(parser, ")")) return 0;
        value_slot = cold_materialize_numeric_ref_value(body, value_slot, &value_kind);
        if (value_kind == SLOT_F64) {
            *kind = SLOT_F64;
            return value_slot;
        }
        if (value_kind == SLOT_I64) {
            int32_t dst = body_slot(body, SLOT_F64, 8);
            body_op(body, BODY_OP_F64_FROM_I64, dst, value_slot, 0);
            *kind = SLOT_F64;
            return dst;
        }
        if (value_kind == SLOT_I32) {
            int32_t dst = body_slot(body, SLOT_F64, 8);
            body_op(body, BODY_OP_F64_FROM_I32, dst, value_slot, 0);
            *kind = SLOT_F64;
            return dst;
        }
        if (ColdErrorRecoveryEnabled) {
            int32_t zero = body_slot(body, SLOT_F64, 8);
            body_op3(body, BODY_OP_F64_CONST, zero, 0, 0, 0);
            *kind = SLOT_F64;
            return zero;
        }
        die("float64 cast source unsupported");
    }
    /* float32 cast: float32(expr) */
    if (span_eq(cast_token, "float32") || span_eq(cast_token, "Float32")) {
        int32_t value_kind = SLOT_I32;
        int32_t value_slot = parse_expr(parser, body, locals, &value_kind);
        if (!parser_take(parser, ")")) return 0;
        value_slot = cold_materialize_numeric_ref_value(body, value_slot, &value_kind);
        if (value_kind == SLOT_F32) {
            *kind = SLOT_F32;
            return value_slot;
        }
        if (value_kind == SLOT_I32) {
            int32_t dst = body_slot(body, SLOT_F32, 4);
            body_op(body, BODY_OP_F32_FROM_I32, dst, value_slot, 0);
            *kind = SLOT_F32;
            return dst;
        }
        if (ColdErrorRecoveryEnabled) {
            int32_t zero = body_slot(body, SLOT_F32, 4);
            body_op(body, BODY_OP_F32_CONST, zero, 0, 0);
            *kind = SLOT_F32;
            return zero;
        }
        die("float32 cast source unsupported");
    }
    if (cold_is_i64_cast_token(cast_token)) {
        bool cast_unsigned = span_eq(cast_token, "uint64") ||
                             span_eq(cast_token, "Uint64") ||
                             span_eq(cast_token, "UInt64");
        Span arg_span = parser_take_until_top_level_char(parser, ')', "expected ) after scalar cast");
        if (!parser_take(parser, ")")) return 0; /* skip malformed cast */;
        arg_span = span_trim(arg_span);
        if (span_is_i32(arg_span)) {
            int32_t slot = cold_make_i64_const_slot(body, span_i64(arg_span));
            if (cast_unsigned) body_slot_set_type(body, slot, cold_cstr_span("uint64"));
            *kind = SLOT_I64;
            return slot;
        }
        Parser arg_parser = parser_child(parser, arg_span);
        int32_t value_kind = SLOT_I32;
        int32_t value_slot = parse_expr(&arg_parser, body, locals, &value_kind);
        parser_ws(&arg_parser);
        if (arg_parser.pos != arg_parser.source.len) return 0; /* skip unsupported cast */;
        value_slot = cold_materialize_numeric_ref_value(body, value_slot, &value_kind);
        if (value_kind == SLOT_I64) {
            if (cast_unsigned) {
                int32_t dst = body_slot(body, SLOT_I64, 8);
                body_op(body, BODY_OP_COPY_I64, dst, value_slot, 0);
                body_slot_set_type(body, dst, cold_cstr_span("uint64"));
                *kind = SLOT_I64;
                return dst;
            }
            *kind = SLOT_I64;
            return value_slot;
        }
        if (value_kind == SLOT_F64) {
            int32_t dst = body_slot(body, SLOT_I64, 8);
            body_op(body, BODY_OP_I64_FROM_F64, dst, value_slot, 0);
            if (cast_unsigned) body_slot_set_type(body, dst, cold_cstr_span("uint64"));
            *kind = SLOT_I64;
            return dst;
        }
        if (cold_kind_is_pointer_like(value_kind)) {
            int32_t ptr_kind = value_kind;
            int32_t ptr_slot = cold_materialize_ptr_value(body, value_slot, &ptr_kind);
            int32_t dst = body_slot(body, SLOT_I64, 8);
            body_op(body, BODY_OP_COPY_I64, dst, ptr_slot, 0);
            if (cast_unsigned) body_slot_set_type(body, dst, cold_cstr_span("uint64"));
            *kind = SLOT_I64;
            return dst;
        }
        if (value_kind != SLOT_I32) {
            if (ColdErrorRecoveryEnabled) {
                int32_t zero = cold_make_i64_const_slot(body, 0);
                *kind = SLOT_I64;
                return zero;
            }
            die("int64/uint64 cast source unsupported");
        }
        int32_t dst = body_slot(body, SLOT_I64, 8);
        /* uint32 sources (uint32 vars, bit31-set hex literals) must zero-extend
           into i64; signed int32 sign-extends. Mirrors the implicit-promotion
           path so `uint64(uint32val)` no longer loses the top bit. */
        body_op(body,
                cold_slot_type_is_uint32(body, value_slot) ? BODY_OP_I64_FROM_U32
                                                           : BODY_OP_I64_FROM_I32,
                dst, value_slot, 0);
        if (cast_unsigned) body_slot_set_type(body, dst, cold_cstr_span("uint64"));
        *kind = SLOT_I64;
        return dst;
    }
    int32_t value_kind = SLOT_I32;
    int32_t value_slot = parse_expr(parser, body, locals, &value_kind);
    value_slot = cold_materialize_numeric_ref_value(body, value_slot, &value_kind);
    /* Every I32-domain cast produces a distinct typed value. Repainting the
       source slot would mutate an existing local's semantic type, while
       returning it unchanged loses the explicit target type for bool/byte
       field and sequence stores. */
    Span cast_type = cold_i32_scalar_cast_type(cast_token);
    if (cast_type.len <= 0) die("unsupported int32-domain scalar cast");
    if (value_kind == SLOT_VARIANT) {
        int32_t tag_slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_TAG_LOAD, tag_slot, value_slot, 0);
        value_slot = tag_slot;
        value_kind = SLOT_I32;
    }
    if (value_kind != SLOT_I32) {
        if (value_kind == SLOT_I64) {
            int32_t dst = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_FROM_I64, dst, value_slot, 0);
            *kind = SLOT_I32;
            body_slot_set_type(body, dst, cast_type);
            if (!parser_take(parser, ")")) return 0;
            return dst;
        }
        if (value_kind == SLOT_F64) {
            int32_t dst = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_FROM_F64, dst, value_slot, 0);
            *kind = SLOT_I32;
            body_slot_set_type(body, dst, cast_type);
            if (!parser_take(parser, ")")) return 0;
            return dst;
        }
        if (value_kind == SLOT_F32) {
            int32_t dst = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_FROM_F32, dst, value_slot, 0);
            *kind = SLOT_I32;
            body_slot_set_type(body, dst, cast_type);
            if (!parser_take(parser, ")")) return 0;
            return dst;
        }
        /* Non-int32 scalar cast: consume ) and return 0 */
        if (!parser_take(parser, ")")) return 0;
        int32_t zero = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
        body_slot_set_type(body, zero, cast_type);
        *kind = SLOT_I32;
        return zero;
    }
    if (!parser_take(parser, ")")) return 0; /* skip malformed cast */;
    *kind = SLOT_I32;
    int32_t dst = body_slot(body, SLOT_I32, 4);
    body_op(body, BODY_OP_COPY_I32, dst, value_slot, 0);
    body_slot_set_type(body, dst, cast_type);
    return dst;
}

bool parser_take_until_top_level_else(Parser *parser, Span *then_out);
Span parser_take_inline_rest_of_line(Parser *parser);
Span parser_take_balanced_rest_of_line(Parser *parser);
Span condition_strip_outer(Span condition);
int32_t condition_find_top_binary(Span condition, const char *op);
int32_t condition_find_top_keyword(Span condition, const char *op);
void cold_store_value_into_slot(BodyIR *body, int32_t dst, int32_t dst_kind,
                                int32_t src, int32_t src_kind);
int32_t parse_expr_from_span(Parser *owner, BodyIR *body, Locals *locals,
                                    Span expr, int32_t *kind,
                                    const char *trailing_message);
void parse_condition_span(Parser *owner, BodyIR *body, Locals *locals,
                                 Span condition, int32_t block,
                                 int32_t true_block, int32_t false_block);
static bool parser_take_logical_expr_span(Parser *parser, Span *out);
static ColdLocalValueState *cold_snapshot_local_value_defs(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t count);
static void cold_restore_local_value_defs(
        BodyIR *body, Locals *locals, int32_t count,
        const ColdLocalValueState *states);
/* A global shadow is an address carrier for one immutable GlobalDef row, not
   a branch-local value.  Each source use deliberately emits a fresh
   GLOBAL_ADDR so that the carrier dominates that use.  At a CFG join neither
   arm's fresh carrier dominates the continuation, and manufacturing a phi
   would incorrectly turn the immortal global place into a local owner.  Prove
   every available arm definition all the way back to the same int32 global
   row.  An arm may carry the exact unavailable state (-1, no consume) after
   an earlier join already discarded its transient address.  Then discard all
   transient carriers; the next source use rematerializes the canonical
   address from Local.global_index.

   Fixed-array globals may intentionally have exact_type_id == -1: their exact
   identity is the GlobalDef row plus the declared fixed-array shape.  This is
   the only type-less case admitted here.  No name, source line, pointer, or
   callee identity participates. */
static bool cold_exact_same_global_shadow_join_inputs(
        Parser *parser, const BodyIR *body, const Local *local,
        const ColdLocalValueState *first,
        const ColdLocalValueState *second) {
    if (!parser || !parser->symbols || !body || !local ||
        !local->is_global ||
        local->global_index < 0 ||
        local->global_index >= parser->symbols->global_count ||
        !first || !second ||
        first->slot < 0 || first->slot >= body->slot_count ||
        second->slot < 0 || second->slot >= body->slot_count ||
        first->value_def_op_id < -1 ||
        first->value_def_op_id >= body->op_count ||
        second->value_def_op_id < -1 ||
        second->value_def_op_id >= body->op_count ||
        (first->value_def_op_id < 0 &&
         second->value_def_op_id < 0) ||
        (first->value_def_op_id >= 0 &&
         first->value_def_op_id == second->value_def_op_id)) {
        return false;
    }
    const GlobalDef *global =
        &parser->symbols->globals[local->global_index];
    int32_t expected_kind = cold_global_ref_kind(global->kind);
    int32_t first_slot = first->slot;
    int32_t second_slot = second->slot;
    int32_t first_definition = first->value_def_op_id;
    int32_t second_definition = second->value_def_op_id;
    int32_t first_type = body->slot_exact_type_id[first_slot];
    int32_t second_type = body->slot_exact_type_id[second_slot];
    int32_t first_storage =
        body->slot_managed_storage_kind[first_slot];
    int32_t second_storage =
        body->slot_managed_storage_kind[second_slot];
    bool fixed_array_global =
        expected_kind == SLOT_OBJECT_REF &&
        cold_parse_any_fixed_array_type(
            parser->symbols, global->type_name, 0, 0);
    bool exact_global_domain =
        first_type == second_type &&
        first_storage == second_storage &&
        ((first_type >= 0 &&
          first_storage != COLD_MANAGED_STORAGE_UNKNOWN) ||
         fixed_array_global);
    if (!exact_global_domain) {
        return false;
    }
    const int32_t definitions[2] = {
        first_definition, second_definition};
    const int32_t slots[2] = {first_slot, second_slot};
    const int32_t consumes[2] = {
        first->consume_op_index_plus_one,
        second->consume_op_index_plus_one};
    for (int32_t edge = 0; edge < 2; edge++) {
        int32_t definition = definitions[edge];
        int32_t slot = slots[edge];
        if (body->slot_kind[slot] != expected_kind ||
            body->slot_size[slot] != 8 ||
            body->slot_managed_storage_kind[slot] !=
                (edge == 0 ? first_storage : second_storage) ||
            consumes[edge] != 0) {
            return false;
        }
        if (definition < 0) {
            if (body->slot_place_kind[slot] !=
                    COLD_EXPR_PLACE_GLOBAL ||
                body->slot_origin_id[slot] !=
                    local->global_index) {
                return false;
            }
            continue;
        }
        if (body->op_kind[definition] != BODY_OP_GLOBAL_ADDR ||
            body->op_dst[definition] != slot ||
            body->op_a[definition] != local->global_index ||
            body->op_b[definition] != 0 ||
            body->op_c[definition] != 0 ||
            body->op_value_def_slot[definition] != slot ||
            body->op_value_def_producer_function_row[definition] !=
                body->producer_function_row ||
            body->op_value_def_place_kind[definition] !=
                COLD_EXPR_PLACE_GLOBAL ||
            body->op_value_def_ownership[definition] !=
                COLD_EXPR_OWN_BORROW_SHARED ||
            body->op_value_def_origin_id[definition] !=
                local->global_index ||
            body->op_value_def_consume_op_index_plus_one[definition] != 0 ||
            body->op_source_value_def_op_id[definition] != -1 ||
            body->slot_exact_type_id[slot] !=
                body->op_value_def_exact_type_id[definition]) {
            return false;
        }
        bool pristine_global_head =
            body->slot_place_kind[slot] ==
                COLD_EXPR_PLACE_GLOBAL &&
            body->slot_origin_id[slot] ==
                local->global_index;
        bool exact_historical_head =
            cold_exact_historical_definition_reaches_slot_head(
                body, parser->symbols, slot, definition);
        if (!pristine_global_head && !exact_historical_head) {
            return false;
        }
    }
    return true;
}

/* Branch snapshots may retain the immutable GLOBAL_ADDR row after a call
   through that global place publishes a newer MEMORY_VERSION in the same
   physical carrier slot.  The stored definition remains the global identity;
   the current-head proof establishes that no unrelated write replaced it on
   the concrete predecessor.  Direct pristine arms are proven by dominance,
   while advanced arms must name a fully validated historical-definition
   graph and its exact current head. */
static bool cold_exact_same_global_shadow_join_inputs_at_cfg(
        Parser *parser, const BodyIR *body, const Local *local,
        const ColdLocalValueState *first,
        int32_t first_predecessor,
        const ColdLocalValueState *second,
        int32_t second_predecessor,
        int32_t join_block) {
    if (!cold_exact_same_global_shadow_join_inputs(
            parser, body, local, first, second) ||
        !body || join_block < 0 ||
        join_block >= body->block_count ||
        first_predecessor < 0 ||
        first_predecessor >= body->block_count ||
        second_predecessor < 0 ||
        second_predecessor >= body->block_count ||
        first_predecessor == second_predecessor) {
        return false;
    }
    const ColdLocalValueState *states[2] = {first, second};
    int32_t predecessors[2] = {
        first_predecessor, second_predecessor};
    for (int32_t edge = 0; edge < 2; edge++) {
        int32_t predecessor = predecessors[edge];
        int32_t term = body->block_term[predecessor];
        if (term < 0 || term >= body->term_count ||
            body->term_kind[term] != BODY_TERM_BR ||
            body->term_true_block[term] != join_block) {
            return false;
        }
        int32_t definition = states[edge]->value_def_op_id;
        if (definition < 0) continue;
        int32_t slot = states[edge]->slot;
        if (cold_exact_definition_is_current_at_predecessor(
                body, definition, predecessor,
                body->op_count)) {
            continue;
        }
        int32_t slot_place = body->slot_place_kind[slot];
        if (slot_place == COLD_EXPR_PLACE_MEMORY_VERSION ||
            slot_place == COLD_EXPR_PLACE_CFG_MERGE) {
            int32_t head = body->slot_origin_id[slot];
            if (head < 0 || head >= body->op_count ||
                !cold_exact_definition_is_current_at_predecessor(
                    body, head, predecessor,
                    body->op_count)) {
                return false;
            }
            continue;
        }
        if (slot_place != COLD_EXPR_PLACE_GLOBAL ||
            body->slot_origin_id[slot] !=
                local->global_index) {
            return false;
        }
    }
    return true;
}

