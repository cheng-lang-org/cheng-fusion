/* parse_expr owns this sink with save/restore nesting. Producers publish an
   exact result directly; no op scan, source text, name, or "last op" lookup
   participates. The sink is ephemeral and never becomes ownership authority. */
static BodyIR *ColdActiveExprResultBody = 0;
static ColdExprResult *ColdActiveExprResult = 0;
static ColdExprResult *ColdActiveExprBorrowRoot = 0;
static int32_t *ColdActiveExprScalarBorrowCarrierOp = 0;

/* docs/cheng-formal-spec.md:49 -- `panic` is unstructured process
   termination: control never returns and defers do not run. Resolve that
   property from the exact std/system declaration row. A user function whose
   tail name happens to be `panic` is ordinary and must not acquire
   language-level control-flow semantics from its spelling. */
static bool cold_fn_is_panic_termination(
        const Symbols *symbols, const FnDef *fn) {
    if (!symbols || !fn ||
        !cold_return_span_is_void(fn->ret)) {
        return false;
    }
    Span panic_name;
    panic_name.ptr = (const uint8_t *)"system.panic";
    panic_name.len = 12;
    for (int32_t row = symbols_function_name_first(symbols, panic_name);
         row >= 0;
         row = symbols_function_name_next(symbols, row)) {
        const FnDef *canonical =
            &symbols->functions[row];
        if (!cold_return_span_is_void(canonical->ret)) {
            continue;
        }
        if (canonical == fn) return true;
        if (canonical->declaration_origin_row >= 0 &&
            canonical->declaration_origin_row ==
                fn->declaration_origin_row) {
            return true;
        }
    }
    return false;
}

static void cold_end_exact_panic_call(
        BodyIR *body, const Symbols *symbols,
        const FnDef *fn, int32_t call_op) {
    if (!cold_fn_is_panic_termination(
            symbols, fn)) {
        return;
    }
    if (!body || !body_cur_block_valid(body)) {
        die("panic call has no live CFG block");
    }
    int32_t block = body->cur_open_block;
    if (call_op < body->block_op_start[block] ||
        call_op >= body->op_count) {
        die("panic call is outside its exact CFG block");
    }
    int32_t term = body_term(
        body, BODY_TERM_UNREACHABLE,
        -1, -1, 0, -1, -1);
    body_end_block(body, block, term);
}

static void cold_expr_result_reset(ColdExprResult *result) {
    if (!result) return;
    result->slot = -1;
    result->kind = -1;
    result->value_def_op_id = -1;
    result->exact_type_id = -1;
    result->producer_function_row = -1;
    result->place_kind = COLD_EXPR_PLACE_INVALID;
    result->ownership = COLD_EXPR_OWN_INVALID;
    result->origin_id = -1;
}

static bool cold_exact_result_from_definition(
        const BodyIR *body, int32_t slot, int32_t definition,
        ColdExprResult *result) {
    cold_expr_result_reset(result);
    if (!body || !result ||
        slot < 0 || slot >= body->slot_count ||
        definition < 0 || definition >= body->op_count ||
        body->op_value_def_slot[definition] != slot ||
        (body->op_value_def_exact_type_id[definition] < 0 &&
         !(body->op_kind[definition] == BODY_OP_GLOBAL_ADDR &&
           body->op_value_def_place_kind[definition] ==
               COLD_EXPR_PLACE_GLOBAL)) ||
        body->op_value_def_producer_function_row[definition] !=
            body->producer_function_row ||
        body->op_value_def_place_kind[definition] ==
            COLD_EXPR_PLACE_INVALID ||
        body->op_value_def_ownership[definition] ==
            COLD_EXPR_OWN_INVALID) {
        return false;
    }
    result->slot = slot;
    result->kind = body->slot_kind[slot];
    result->value_def_op_id = definition;
    result->exact_type_id =
        body->op_value_def_exact_type_id[definition];
    result->producer_function_row =
        body->op_value_def_producer_function_row[definition];
    result->place_kind =
        body->op_value_def_place_kind[definition];
    result->ownership =
        body->op_value_def_ownership[definition];
    result->origin_id =
        body->op_value_def_origin_id[definition];
    return cold_exact_op_tuple_matches_result(
        body, result);
}

static void cold_expr_result_publish(BodyIR *body,
                                     const ColdExprResult *result);

/* Publish the read of a managed global shadow whose GLOBAL_ADDR row already
   carries the exact PLACE_GLOBAL borrowed source (locals_add_global_shadow
   publishes it): reuse that definition directly instead of minting a
   duplicate borrow copy. */
static int32_t cold_publish_global_shadow_result(
        BodyIR *body, const Local *local, int32_t *kind_out);

/* Resolve an opaque sequence's element to an int32 semantic row.  Builtins
   occupy fixed language rows; declared types and objects use their canonical
   Symbols SoA rows.  Source spelling is only admission input for resolving
   that row and is never retained as identity. */
static int32_t cold_exact_canonical_type_def_row(
        Symbols *symbols, TypeDef *target) {
    if (!symbols || !target ||
        target < symbols->types ||
        target >= symbols->types + symbols->type_count) {
        return -1;
    }
    int32_t target_row =
        (int32_t)(target - symbols->types);
    int32_t origin = target->declaration_origin_row;
    if (origin < 0) {
        return target_row;
    }
    if (origin >= symbols->declaration_origin_count ||
        !symbols->declaration_origin_type_rows) {
        die("canonical TypeDef origin index is invalid");
    }
    int32_t canonical_row =
        symbols->declaration_origin_type_rows[origin];
    if (canonical_row < 0 ||
        canonical_row >= symbols->type_count) {
        die("canonical TypeDef origin row is absent");
    }
    TypeDef *candidate = &symbols->types[canonical_row];
    if (candidate->declaration_origin_row != origin ||
        candidate->is_enum != target->is_enum ||
        candidate->variant_count != target->variant_count ||
        candidate->generic_count != target->generic_count) {
        fprintf(stderr,
                "cheng_cold: TypeDef metadata drift "
                "target=%.*s origin=%d row=%d enum=%d vars=%d gens=%d alias=%d "
                "canon=%.*s crow=%d enum=%d vars=%d gens=%d alias=%d\n",
                target->name.len, target->name.ptr, origin, target_row,
                (int)target->is_enum, target->variant_count,
                target->generic_count, target->alias_type.len > 0,
                candidate->name.len, candidate->name.ptr, canonical_row,
                (int)candidate->is_enum, candidate->variant_count,
                candidate->generic_count, candidate->alias_type.len > 0);
        die("canonical TypeDef row metadata drift");
    }
    return canonical_row;
}

static int32_t cold_exact_builtin_type_row(Span type) {
    type = span_trim(type);
    if (span_eq(type, "bool")) return 1;
    if (span_eq(type, "char")) return 2;
    if (span_eq(type, "int8")) return 3;
    if (span_eq(type, "uint8")) return 4;
    if (span_eq(type, "int16")) return 5;
    if (span_eq(type, "uint16")) return 6;
    if (span_eq(type, "int32")) return 7;
    if (span_eq(type, "uint32")) return 8;
    if (span_eq(type, "int64")) return 9;
    if (span_eq(type, "uint64")) return 10;
    if (span_eq(type, "int")) return 11;
    if (span_eq(type, "uint")) return 12;
    if (span_eq(type, "float32")) return 13;
    if (span_eq(type, "float64")) return 14;
    if (span_eq(type, "str")) return 15;
    if (span_eq(type, "ptr")) return 16;
    return -1;
}

static int32_t cold_exact_opaque_sequence_element_type_row_for_function(
        Symbols *symbols, const FnDef *function,
        Span sequence_type) {
    if (!symbols) return -1;
    Span current =
        span_trim(cold_type_strip_var(sequence_type, 0));
    for (int32_t depth = 0;
         depth <= symbols->type_count; depth++) {
        TypeDef *alias = symbols_find_type(symbols, current);
        if (!alias || alias->alias_type.len <= 0) break;
        current = span_trim(
            cold_type_strip_var(alias->alias_type, 0));
    }
    /* Opaque sequence slots deliberately store their canonical element type
       in slot_type (body_slot_set_seq_opaque_type); producer-facing paths may
       still arrive with the surface T[] spelling.  Both resolve to the same
       row before any identity is recorded. */
    Span element = current;
    if (current.len >= 3 &&
        current.ptr[current.len - 2] == '[' &&
        current.ptr[current.len - 1] == ']') {
        Span inner = span_trim(
            span_sub(current, 0, current.len - 2));
        if (inner.len >= 3 &&
            inner.ptr[inner.len - 2] == '[' &&
            inner.ptr[inner.len - 1] == ']') {
            /* Surface `T[][]`: the element is the inner sequence. */
            element = inner;
        } else if (cold_parse_str_seq_type(current) ||
                   cold_parse_i32_seq_type(current)) {
            /* Stored canonical nested-seq element (`str[]`).  Do not
               strip to the scalar builtin or Foo[] and `str[]` would
               share no row. */
            element = current;
        } else {
            element = inner;
        }
    }
    if (element.len <= 0) return -1;
    for (int32_t depth = 0;
         depth <= symbols->type_count; depth++) {
        int32_t builtin =
            cold_exact_builtin_type_row(element);
        if (builtin > 0) return builtin;
        ObjectDef *object =
            symbols_resolve_object(symbols, element);
        if (object) {
            int32_t object_row =
                (int32_t)(object - symbols->objects);
            if (object_row < 0 ||
                object_row >= symbols->object_count) {
                die("opaque sequence object row is invalid");
            }
            object_row = cold_canonical_object_identity(
                symbols, object_row);
            if (object_row < 0 || object_row >= 262143)
                die("opaque sequence object row exceeds TypeId payload");
            return 262144 + object_row + 1;
        }
        TypeDef *type = symbols_resolve_type(
            symbols, element);
        if (!type) {
            if (function) {
                for (int32_t generic_row = 0;
                     generic_row <
                         function->generic_count;
                     generic_row++) {
                    if (span_same(
                            element,
                            function->generic_names[
                                generic_row])) {
                        return 786432 +
                               generic_row + 1;
                    }
                }
            }
            /* Nested sequence elements (`str[]` of `str[][]`) are not a
               builtin, object, or TypeDef row.  Intern the structural
               TypeNode so helper/formal TypeIds have an exact payload. */
            int32_t structural_row =
                cold_intern_opaque_sequence_structural_element_row(
                    symbols, function, element);
            if (structural_row > 0) return structural_row;
            return -1;
        }
        if (type->alias_type.len > 0) {
            element = span_trim(
                cold_type_strip_var(type->alias_type, 0));
            continue;
        }
        int32_t type_row =
            cold_exact_canonical_type_def_row(
                symbols, type);
        if (type_row < 0 || type_row >= 262143)
            die("opaque sequence TypeDef row exceeds TypeId payload");
        return 65536 + type_row + 1;
    }
    die("opaque sequence element type alias cycle");
    return -1;
}

static int32_t cold_exact_opaque_sequence_element_type_row(
        Symbols *symbols, const BodyIR *body,
        Span sequence_type) {
    if (!symbols || !body) return -1;
    int32_t function_row =
        body->producer_function_row;
    const FnDef *function =
        function_row >= 0 &&
                function_row <
                    symbols->function_count
            ? &symbols->functions[function_row]
            : 0;
    return cold_exact_opaque_sequence_element_type_row_for_function(
        symbols, function, sequence_type);
}

/* Cold TypeId is a snapshot-local int32 identity. Managed scalar/sequence
   families occupy disjoint kind domains; nominal objects add their exact
   ObjectDef row. The text is used only to resolve that row at production and
   is never retained as value-definition authority. */
static int32_t cold_exact_nominal_type_projection_id(
        Symbols *symbols, Span raw_type,
        int32_t slot_kind);

/* ABI builtins own a snapshot-independent TypeId whose domain is the exact
   lowered carrier kind.  They must not acquire a TypeDef-row payload merely
   because a source module also publishes the builtin's structural spelling
   later in the declaration pass (std/system does this for str/cstring).
   Declaration publication and frozen contract recomputation both call this
   kernel, so signature collection cannot observe a different identity from
   the sealed type table.  TypeNode still records any exact alias edge; this
   function defines only the ABI/value identity carried by FnDef and BodyIR. */
static int32_t cold_exact_abi_builtin_type_id(
        Span raw_type, int32_t slot_kind) {
    const int32_t domain_size = 1048576;
    Span type = span_trim(cold_type_strip_var(
        raw_type, 0));
    bool builtin =
        cold_exact_builtin_type_row(type) > 0 ||
        span_eq(type, "void") ||
        span_eq(type, "f32") ||
        span_eq(type, "f64") ||
        span_eq(type, "cstring") ||
        span_eq(type, "bytes_view") ||
        span_eq(type, "utf8_view") ||
        span_eq(type, "typedesc");
    if (!builtin || slot_kind <= 0)
        return -1;
    int32_t identity_kind =
        slot_kind == SLOT_PTR ||
                slot_kind == SLOT_OPAQUE_REF
            ? SLOT_OBJECT_REF
            : slot_kind;
    return identity_kind * domain_size;
}

/* A typed ABI pointer alias such as `Int32Ptr = int32 *` is still one
   pointer carrier, not a nominal object.  Resolve aliases to their terminal
   scalar pointee before publishing the reserved ABI pointer TypeId.  The
   pointee remains the exact layout input for pointer load/store admission;
   object pointees are excluded so canonical ObjectDef identity is never
   collapsed into the builtin carrier. */
static bool cold_exact_abi_pointer_alias_pointee(
        Symbols *symbols, Span raw_type, Span *pointee_out) {
    if (pointee_out) *pointee_out = (Span){0};
    if (!symbols || !pointee_out) return false;
    Span current = span_trim(
        cold_type_strip_var(raw_type, NULL));
    for (int32_t depth = 0;
         depth <= symbols->type_count; depth++) {
        TypeDef *alias = symbols_find_type(symbols, current);
        if (!alias || alias->alias_type.len <= 0) break;
        Span next = span_trim(
            cold_type_strip_var(alias->alias_type, NULL));
        if (next.len <= 0 || span_same(next, current))
            return false;
        current = next;
        if (depth == symbols->type_count)
            return false;
    }
    if (!cold_type_has_pointer_suffix(current))
        return false;
    Span pointee = span_trim(
        span_sub(current, 0, current.len - 1));
    for (int32_t depth = 0;
         depth <= symbols->type_count; depth++) {
        TypeDef *alias = symbols_find_type(symbols, pointee);
        if (!alias || alias->alias_type.len <= 0) break;
        Span next = span_trim(
            cold_type_strip_var(alias->alias_type, NULL));
        if (next.len <= 0 || span_same(next, pointee))
            return false;
        pointee = next;
        if (depth == symbols->type_count)
            return false;
    }
    if (cold_exact_builtin_type_row(pointee) <= 0 &&
         !span_eq(pointee, "void") &&
         !span_eq(pointee, "f32") &&
         !span_eq(pointee, "f64") &&
         !span_eq(pointee, "cstring") &&
         !span_eq(pointee, "ptr")) {
        return false;
    }
    *pointee_out = pointee;
    return true;
}

static int32_t cold_exact_abi_pointer_alias_type_id(
        Symbols *symbols, Span raw_type, int32_t slot_kind) {
    const int32_t domain_size = 1048576;
    int32_t direct = cold_exact_abi_builtin_type_id(
        raw_type, slot_kind);
    if (direct >= 0) return direct;
    if (!symbols ||
        (slot_kind != SLOT_PTR &&
         slot_kind != SLOT_OPAQUE_REF)) {
        return -1;
    }
    Span pointee = {0};
    if (!cold_exact_abi_pointer_alias_pointee(
            symbols, raw_type, &pointee)) {
        return -1;
    }
    return SLOT_OBJECT_REF * domain_size;
}

/* Derive both immutable TypeIds for one scalar value and its `var` carrier
   from the same declared type.  Builtins reserve payload zero; nominal
   aliases/enums retain the same canonical TypeDef payload while changing
   only the physical value/ref kind domain.  Width alone is never identity. */
static bool cold_exact_scalar_value_ref_type_ids(
        Symbols *symbols, Span raw_type,
        int32_t value_kind,
        int32_t *value_type_id_out,
        int32_t *ref_type_id_out) {
    const int32_t domain_size = 1048576;
    if (value_type_id_out) *value_type_id_out = -1;
    if (ref_type_id_out) *ref_type_id_out = -1;
    if (!symbols || !value_type_id_out || !ref_type_id_out ||
        (value_kind != SLOT_I32 && value_kind != SLOT_I64)) {
        return false;
    }
    int32_t ref_kind =
        value_kind == SLOT_I32
            ? SLOT_I32_REF : SLOT_I64_REF;
    int32_t value_type_id =
        cold_exact_abi_builtin_type_id(
            raw_type, value_kind);
    int32_t ref_type_id =
        cold_exact_abi_builtin_type_id(
            raw_type, ref_kind);
    if (value_type_id >= 0 || ref_type_id >= 0) {
        if (value_type_id != value_kind * domain_size ||
            ref_type_id != ref_kind * domain_size) {
            return false;
        }
    } else {
        value_type_id =
            cold_exact_nominal_type_projection_id(
                symbols, raw_type, value_kind);
        ref_type_id =
            cold_exact_nominal_type_projection_id(
                symbols, raw_type, ref_kind);
        if (value_type_id < 0 || ref_type_id < 0 ||
            value_type_id / domain_size != value_kind ||
            ref_type_id / domain_size != ref_kind ||
            value_type_id % domain_size <= 0 ||
            value_type_id % domain_size !=
                ref_type_id % domain_size) {
            return false;
        }
    }
    *value_type_id_out = value_type_id;
    *ref_type_id_out = ref_type_id;
    return true;
}

static int32_t cold_exact_managed_type_id(
        Symbols *symbols, const BodyIR *body, int32_t slot, int32_t kind) {
    if (!body || slot < 0 || slot >= body->slot_count ||
        body->slot_kind[slot] != kind) {
        return -1;
    }
    int32_t function_row =
        body->producer_function_row;
    const FnDef *function =
        symbols && function_row >= 0 &&
                function_row <
                    symbols->function_count
            ? &symbols->functions[function_row]
            : NULL;
    Span slot_value_type = span_trim(cold_type_strip_var(
        body->slot_type[slot], 0));
    if (function &&
        kind != SLOT_SEQ_OPAQUE &&
        kind != SLOT_SEQ_OPAQUE_REF &&
        cold_type_matches_generic_names(
            slot_value_type, function->generic_names,
            function->generic_count, 0)) {
        /* A template BodyIR value slot that directly names its generic
           binder has the same unresolved identity as the FnDef formal.  Its
           physical carrier kind is only layout, never a concrete TypeId.
           Opaque sequence slots are different: their canonical slot_type is
           the element spelling (`T` for surface `T[]`), and the reserved
           sequence payload records the exact binder ordinal until
           specialization replaces it with the concrete element identity. */
        return -1;
    }
    int32_t identity_kind = kind;
    int32_t base = kind * 1048576;
    if (kind == SLOT_SEQ_OPAQUE ||
        kind == SLOT_SEQ_OPAQUE_REF) {
        int32_t element_row =
            cold_exact_opaque_sequence_element_type_row(
                symbols, body,
                body->slot_type[slot]);
        return element_row > 0
                   ? base + element_row
                   : -1;
    }
    int32_t abi_builtin_type_id =
        cold_exact_abi_pointer_alias_type_id(
            symbols, body->slot_type[slot], kind);
    if (abi_builtin_type_id >= 0) {
        return abi_builtin_type_id;
    }
    if (kind == SLOT_OBJECT || kind == SLOT_OBJECT_REF ||
        kind == SLOT_OPAQUE_REF || kind == SLOT_PTR) {
        Span type = span_trim(cold_type_strip_var(
            body->slot_type[slot], 0));
        /* Resolve the complete nominal type first.  A generic application
           such as Result[T] owns a materialized ObjectDef row and that row,
           not the generic Result template, is the exact layout identity.
           In particular, a one-letter generic argument is also ALL-CAPS and
           therefore cannot be distinguished from an array-size constant by
           spelling alone. */
        ObjectDef *object =
            symbols && type.len > 0
                ? symbols_resolve_object_in_generic_scope(
                      symbols, type,
                      function
                          ? function->generic_names
                          : NULL,
                      function
                          ? function->generic_count
                          : 0,
                      function &&
                              function->generic_count > 0
                          ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                          : COLD_GENERIC_BINDER_NONE,
                      function &&
                              function->generic_count > 0
                          ? function->declaration_origin_row
                          : -1)
                : 0;
        /* A pointer-spelled slot type (`RecA*`) names the same pointee
           object as its alias form (`RecAPtr`): resolve through one
           trailing `*` when the complete spelling has no ObjectDef row.
           The identity domain for a pointer carrier is OBJECT_REF (the
           same domain cold_exact_storage_for_body_slot admits for
           SLOT_PTR/SLOT_OBJECT_REF/SLOT_OPAQUE_REF kinds). */
        if (!object && kind != SLOT_OBJECT &&
            cold_type_has_pointer_suffix(type)) {
            Span pointee = span_trim(
                span_sub(type, 0, type.len - 1));
            if (pointee.len > 0) {
                object =
                    symbols
                        ? symbols_resolve_object_in_generic_scope(
                              symbols, pointee,
                              function
                                  ? function->generic_names
                                  : NULL,
                              function
                                  ? function->generic_count
                                  : 0,
                              function &&
                                      function->generic_count > 0
                                  ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                                  : COLD_GENERIC_BINDER_NONE,
                              function &&
                                      function->generic_count > 0
                                  ? function->declaration_origin_row
                                  : -1)
                        : 0;
                if (object) {
                    identity_kind = SLOT_OBJECT_REF;
                    base = identity_kind * 1048576;
                }
            }
        }
        /* Fixed-array element slots carry the DECLARATION type text
           (`ChengAsyncFrame[8]`, `MsQuicNativeSession[native_runtime.N_SLOTS]`)
           instead of the element type: object identity resolution needs the
           element name.  Only if the complete nominal type has no ObjectDef
           row may a trailing numeric/constant suffix be interpreted as an
           array count and removed. */
        if (!object && type.len > 2 &&
            type.ptr[type.len - 1] == ']') {
            int32_t open = type.len - 2;
            while (open >= 0 && type.ptr[open] != '[') {
                uint8_t ch = (uint8_t)type.ptr[open];
                bool ok = (ch >= '0' && ch <= '9') ||
                          (ch >= 'A' && ch <= 'Z') || ch == '_' ||
                          ch == '.' ||
                          (ch >= 'a' && ch <= 'z');
                if (!ok) break;
                open--;
            }
            if (open >= 0 && type.ptr[open] == '[' &&
                open < type.len - 2) {
                int32_t content_start = open + 1;
                int32_t content_len = type.len - 1 - content_start;
                bool all_digits = content_len > 0;
                int32_t last_segment_start = content_start;
                for (int32_t ci = content_start;
                     ci < content_start + content_len; ci++) {
                    uint8_t ch = (uint8_t)type.ptr[ci];
                    if (ch < '0' || ch > '9') all_digits = false;
                    if (ch == '.') last_segment_start = ci + 1;
                }
                bool caps_const = false;
                if (last_segment_start < content_start + content_len) {
                    caps_const = true;
                    bool has_alpha = false;
                    for (int32_t ci = last_segment_start;
                         ci < content_start + content_len; ci++) {
                        uint8_t ch = (uint8_t)type.ptr[ci];
                        if (ch >= 'A' && ch <= 'Z') has_alpha = true;
                        else if (!((ch >= '0' && ch <= '9') || ch == '_')) {
                            caps_const = false;
                            break;
                        }
                    }
                    caps_const = caps_const && has_alpha;
                }
                /* [T] naming this template own binder is a generic
                   application argument, never an array count.  A named
                   constant count in any casing
                   (datapath_runtime.maxMsQuicDatapaths) names the same
                   fixed-array carrier as [4]/[N_SLOTS] -- but ONLY when
                   the element is a drop-requiring ObjectDef row: plain
                   builtin element arrays (bool[N], int32[N]) keep the
                   complete spelling and stay on the unmanaged path. */
                bool references_generic_binder = false;
                if (function && function->generic_count > 0 &&
                    cold_type_matches_generic_names(
                        (Span){type.ptr + content_start,
                               content_len},
                        function->generic_names,
                        function->generic_count, 0)) {
                    references_generic_binder = true;
                }
                Span element_candidate = span_trim(
                    (Span){type.ptr, open});
                bool element_is_managed_object = false;
                if (element_candidate.len > 0 &&
                    !references_generic_binder) {
                    ObjectDef *element_object =
                        symbols_resolve_object_in_generic_scope(
                            symbols, element_candidate,
                            function
                                ? function->generic_names
                                : NULL,
                            function
                                ? function->generic_count
                                : 0,
                            function &&
                                    function->generic_count > 0
                                ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                                : COLD_GENERIC_BINDER_NONE,
                            function &&
                                    function->generic_count > 0
                                ? function->declaration_origin_row
                                : -1);
                    element_is_managed_object =
                        element_object != 0 &&
                        (element_object->is_ref ||
                         cold_type_requires_managed_drop(
                             symbols, element_candidate, 0));
                }
                if (!references_generic_binder &&
                    content_len > 0 &&
                    (all_digits || caps_const ||
                     element_is_managed_object)) {
                    type = span_trim(
                        (Span){type.ptr, open});
                }
            }
        }
        if (!object && symbols && type.len > 0) {
            object =
                symbols_resolve_object_in_generic_scope(
                    symbols, type,
                    function
                        ? function->generic_names
                        : NULL,
                    function
                        ? function->generic_count
                        : 0,
                    function &&
                            function->generic_count > 0
                        ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                        : COLD_GENERIC_BINDER_NONE,
                    function &&
                            function->generic_count > 0
                        ? function->declaration_origin_row
                        : -1);
        }
        /* An unqualified nominal spelling inside an imported scope
           names exactly one row by its dotted tail (Bytes ->
           rawbytes.Bytes): resolve through a unique tail match so the
           exact identity survives scope-qualified use sites. */
        if (!object && symbols && type.len > 0 && !function) {
            int32_t matches = 0;
            ObjectDef *hit = 0;
            for (int32_t oi = 0; oi < symbols->object_count; oi++) {
                Span oname = symbols->objects[oi].name;
                if (oname.len <= type.len) continue;
                if (oname.ptr[oname.len - type.len - 1] != '.') continue;
                if (memcmp(oname.ptr + oname.len - type.len,
                           type.ptr, type.len) != 0) continue;
                matches++;
                hit = &symbols->objects[oi];
            }
            if (matches == 1)
                object = hit;
        }
        if (kind == SLOT_PTR) {
            if (!object) {
                /* Fn-value aliases (CasLockEnsurer / CasSourceFetcher) are
                   SLOT_PTR with a TypeDef row and no ObjectDef.  Use the
                   same nominal projection FnDef formals already carry. */
                return cold_exact_nominal_type_projection_id(
                    symbols, type, kind);
            }
            if (!object->is_ref) return -1;
            identity_kind = SLOT_OBJECT_REF;
            base = identity_kind * 1048576;
        } else if (kind == SLOT_OPAQUE_REF) {
            if (!object) return -1;
            identity_kind = SLOT_OBJECT_REF;
            base = identity_kind * 1048576;
        }
        if ((kind == SLOT_OBJECT || kind == SLOT_OBJECT_REF ||
             kind == SLOT_OPAQUE_REF) &&
            (!object || object < symbols->objects ||
             object >= symbols->objects + symbols->object_count)) {
            return -1;
        }
        if (object) {
            int32_t object_row =
                (int32_t)(object - symbols->objects);
            object_row = cold_canonical_object_identity(
                symbols, object_row);
            if (object_row < 0 ||
                object_row >= symbols->object_count ||
                object_row >= 1048575) {
                return -1;
            }
            return base + object_row + 1;
        }
    }
    /* Mirror the signature-side fallback: a formal whose kind carries no
       object identity (e.g. a SLOT_OPAQUE nominal alias such as os.File)
       still owns an exact nominal TypeDef projection.  The formal
       resolver computes that projection for the same spelling, so the
       body side must agree instead of collapsing to the bare kind base
       (or -1 when the storage class is unknown). */
    int32_t nominal_type_id =
        cold_exact_nominal_type_projection_id(
            symbols, body->slot_type[slot], kind);
    if (nominal_type_id >= 0) {
        return nominal_type_id;
    }
    return cold_exact_managed_storage_kind_for_slot_kind(kind) ==
                   COLD_MANAGED_STORAGE_UNKNOWN
               ? -1
               : base;
}

static int32_t cold_exact_nominal_type_projection_id(
        Symbols *symbols, Span raw_type,
        int32_t slot_kind) {
    const int32_t domain_size = 1048576;
    if (!symbols || slot_kind <= 0)
        return -1;
    TypeDef *nominal_type =
        symbols_find_type(
            symbols,
            span_trim(cold_type_strip_var(
                raw_type, 0)));
    if (!nominal_type ||
        nominal_type->declaration_origin_row < 0) {
        return -1;
    }
    int32_t type_row =
        cold_exact_canonical_type_def_row(
            symbols, nominal_type);
    if (type_row < 0 ||
        type_row >= symbols->type_count ||
        type_row >= domain_size) {
        return -1;
    }
    return slot_kind * domain_size +
           type_row + 1;
}

static int32_t cold_exact_object_definition_type_id(
        Symbols *symbols, ObjectDef *object,
        int32_t identity_kind) {
    const int32_t domain_size = 1048576;
    if (!symbols || !object ||
        object < symbols->objects ||
        object >=
            symbols->objects + symbols->object_count ||
        (identity_kind != SLOT_OBJECT &&
         identity_kind != SLOT_OBJECT_REF) ||
        (object->is_ref &&
         identity_kind != SLOT_OBJECT_REF) ||
        (!object->is_ref &&
         identity_kind != SLOT_OBJECT)) {
        return -1;
    }
    int32_t object_row =
        cold_canonical_object_identity(
            symbols,
            (int32_t)(object - symbols->objects));
    if (object_row < 0 ||
        object_row >= symbols->object_count ||
        object_row >= domain_size - 1) {
        return -1;
    }
    return identity_kind * domain_size +
           object_row + 1;
}

static ObjectDef *cold_exact_object_layout_from_type_id(
        Symbols *symbols, int32_t exact_type_id,
        int32_t expected_identity_kind) {
    const int32_t domain_size = 1048576;
    if (!symbols || exact_type_id < 0 ||
        exact_type_id / domain_size != expected_identity_kind) {
        return 0;
    }
    int32_t payload = exact_type_id % domain_size;
    int32_t object_row = payload - 1;
    if (expected_identity_kind == SLOT_SEQ_OPAQUE ||
        expected_identity_kind == SLOT_SEQ_OPAQUE_REF) {
        /* Opaque-sequence payloads are tagged within the kind domain:
           1..65535 builtins, 65537..262143 TypeDef rows, and
           262145..524287 ObjectDef rows.  The REF carrier shares the
           same payload tag inside its own kind domain. */
        if (payload <= 262144 || payload > 524287)
            return 0;
        object_row = payload - 262144 - 1;
    }
    if (object_row < 0 ||
        object_row >= symbols->object_count ||
        cold_canonical_object_identity(
            symbols, object_row) != object_row) {
        return 0;
    }
    return &symbols->objects[object_row];
}

static bool cold_exact_opaque_sequence_object_projection_matches(
        Symbols *symbols, const BodyIR *body,
        const ColdExprResult *source,
        int32_t object_slot, int32_t object_type_id,
        int32_t object_storage, int32_t projection_op) {
    const int32_t domain_size = 1048576;
    if (!symbols || !body || !source ||
        source->slot < 0 || source->slot >= body->slot_count ||
        (source->kind != SLOT_SEQ_OPAQUE &&
         source->kind != SLOT_SEQ_OPAQUE_REF) ||
        body->slot_kind[source->slot] != source->kind ||
        source->exact_type_id < 0 ||
        source->exact_type_id / domain_size != source->kind ||
        object_slot < 0 || object_slot >= body->slot_count ||
        body->slot_kind[object_slot] != SLOT_OBJECT ||
        object_type_id < 0 ||
        object_type_id / domain_size != SLOT_OBJECT ||
        projection_op < 0 || projection_op >= body->op_count ||
        body->op_kind[projection_op] !=
            BODY_OP_SEQ_OPAQUE_INDEX_DYNAMIC ||
        body->op_dst[projection_op] != object_slot ||
        body->op_a[projection_op] != source->slot) {
        return false;
    }
    int32_t object_payload = object_type_id % domain_size;
    int32_t sequence_payload =
        source->exact_type_id % domain_size;
    int32_t object_row = object_payload - 1;
    if (object_payload <= 0 ||
        sequence_payload != 262144 + object_payload ||
        object_row < 0 || object_row >= symbols->object_count ||
        cold_canonical_object_identity(symbols, object_row) !=
            object_row) {
        return false;
    }
    ObjectDef *object = &symbols->objects[object_row];
    Span object_type = span_trim(cold_type_strip_var(
        body->slot_type[object_slot], 0));
    Span sequence_element_type =
        cold_seq_opaque_element_type(
            body->slot_type[source->slot]);
    ObjectDef *resolved_object =
        object_type.len > 0
            ? symbols_resolve_object(symbols, object_type)
            : 0;
    ObjectDef *resolved_sequence_object =
        sequence_element_type.len > 0
            ? symbols_resolve_object(
                  symbols, sequence_element_type)
            : 0;
    int32_t resolved_object_row =
        resolved_object
            ? symbols_object_index(symbols, resolved_object)
            : -1;
    int32_t resolved_sequence_object_row =
        resolved_sequence_object
            ? symbols_object_index(
                  symbols, resolved_sequence_object)
            : -1;
    if (resolved_object_row >= 0) {
        resolved_object_row = cold_canonical_object_identity(
            symbols, resolved_object_row);
    }
    if (resolved_sequence_object_row >= 0) {
        resolved_sequence_object_row =
            cold_canonical_object_identity(
                symbols, resolved_sequence_object_row);
    }
    int32_t object_size = symbols_object_slot_size(object);
    int32_t expected_storage =
        cold_type_requires_managed_drop(
            symbols, body->slot_type[object_slot], 0)
            ? COLD_MANAGED_STORAGE_OBJECT
            : COLD_MANAGED_STORAGE_PLAIN;
    int32_t expected_sequence_size =
        source->kind == SLOT_SEQ_OPAQUE ? 16 : 8;
    int32_t recomputed_sequence_type_id =
        cold_exact_managed_type_id(
            symbols, body, source->slot,
            source->kind);
    return !object->is_ref &&
           resolved_object_row == object_row &&
           resolved_sequence_object_row == object_row &&
           object_size > 0 &&
           recomputed_sequence_type_id ==
               source->exact_type_id &&
           cold_exact_object_layout_from_type_id(
               symbols, object_type_id, SLOT_OBJECT) == object &&
           body->slot_size[source->slot] ==
               expected_sequence_size &&
           body->slot_managed_storage_kind[source->slot] !=
               COLD_MANAGED_STORAGE_UNKNOWN &&
           body->slot_size[object_slot] == object_size &&
           body->slot_aux[source->slot] == object_size &&
           body->op_c[projection_op] == object_size &&
           object_storage == expected_storage;
}

static void cold_publish_exact_object_formal_type_id(
        Symbols *symbols, int32_t function_row,
        int32_t param_index, ObjectDef *object) {
    if (!symbols || function_row < 0 ||
        function_row >= symbols->function_count ||
        !object) {
        die("object formal TypeId producer is invalid");
    }
    FnDef *function =
        &symbols->functions[function_row];
    if (param_index < 0 ||
        param_index >= function->arity) {
        die("object formal TypeId ordinal is invalid");
    }
    int32_t param_kind =
        function->param_kind[param_index];
    int32_t param_size =
        function->param_size[param_index];
    if ((object->is_ref &&
         param_kind != SLOT_PTR &&
         param_kind != SLOT_OBJECT_REF &&
         param_kind != SLOT_OPAQUE_REF) ||
        (!object->is_ref &&
         param_kind != SLOT_OBJECT) ||
        (object->is_ref && param_size != 8) ||
        (!object->is_ref &&
         param_size !=
             symbols_object_slot_size(object))) {
        die("object formal TypeId layout is invalid");
    }
    int32_t identity_kind =
        object->is_ref
            ? SLOT_OBJECT_REF
            : SLOT_OBJECT;
    int32_t exact_type_id =
        cold_exact_object_definition_type_id(
            symbols, object, identity_kind);
    if (exact_type_id < 0) {
        die("object formal TypeId identity is invalid");
    }
    bool changed = false;
    if (function->param_exact_type_id[
            param_index] == -1) {
        function->param_exact_type_id[
            param_index] = exact_type_id;
        changed = true;
    } else if (
        function->param_exact_type_id[
            param_index] != exact_type_id) {
        die("object formal TypeId drifted");
    }
    int32_t object_is_ref =
        object->is_ref ? 1 : 0;
    if (function->param_exact_object_is_ref[
            param_index] == -1) {
        function->param_exact_object_is_ref[
            param_index] = object_is_ref;
        changed = true;
    } else if (
        function->param_exact_object_is_ref[
            param_index] != object_is_ref) {
        die("object formal ref identity drifted");
    }
    if (changed) symbols->symbol_generation++;
}

/* Publish formal TypeId while the parser-owned signature is collected so a
   forward call observes the same immutable identity as the callee body.
   Builtin managed types use their sealed TypedExpr/BodyIR kind domain.
   Nominal types resolve once to the canonical ObjectDef row at this producer
   boundary; call consumers never reconstruct identity from type text or a
   callee name. Opaque sequences carry the canonical structural element row
   in the same snapshot-local TypeId payload. */
static int32_t cold_exact_formal_type_id_from_signature(
        Symbols *symbols, const FnDef *function,
        int32_t param_index, int32_t *object_is_ref_out) {
    const int32_t domain_size = 1048576;
    if (object_is_ref_out) *object_is_ref_out = -1;
    if (!symbols || !function ||
        param_index < 0 ||
        param_index >= function->arity) {
        return -1;
    }
    int32_t kind = function->param_kind[param_index];
    if (kind == SLOT_I32_REF || kind == SLOT_I64_REF) {
        Span value_type = span_trim(cold_type_strip_var(
            function->param_type[param_index], 0));
        /* A direct generic binder such as `var T` owns no concrete scalar
           TypeId in the template.  Keep its formal marker unresolved until
           specialization substitutes T; physical ref kind/width alone is
           never an identity.  Concrete builtin and nominal scalar refs are
           published by the same value/ref kernel used by frozen BodyIR
           admission, so aliases retain their TypeDef payload. */
        if (cold_type_matches_generic_names(
                value_type, function->generic_names,
                function->generic_count, 0)) {
            return -1;
        }
        int32_t value_kind =
            kind == SLOT_I32_REF ? SLOT_I32 : SLOT_I64;
        int32_t value_type_id = -1;
        int32_t ref_type_id = -1;
        return cold_exact_scalar_value_ref_type_ids(
                   symbols, value_type, value_kind,
                   &value_type_id, &ref_type_id) &&
                       value_type_id >= 0
                   ? ref_type_id
                   : -1;
    }
    if (kind == SLOT_SEQ_OPAQUE ||
        kind == SLOT_SEQ_OPAQUE_REF) {
        int32_t element_row =
            cold_exact_opaque_sequence_element_type_row_for_function(
                symbols, function,
                function->param_type[param_index]);
        return element_row > 0
            ? kind * domain_size + element_row
            : -1;
    }
    bool formal_is_var = false;
    (void)cold_type_strip_var(
        function->param_type[param_index],
        &formal_is_var);
    int32_t abi_builtin_type_id =
        cold_exact_abi_builtin_type_id(
            function->param_type[param_index], kind);
    if (abi_builtin_type_id < 0 &&
        (formal_is_var || function->borrows_args)) {
        abi_builtin_type_id =
            cold_exact_abi_pointer_alias_type_id(
                symbols,
                function->param_type[param_index],
                kind);
    }
    if (abi_builtin_type_id >= 0)
        return abi_builtin_type_id;
    if (kind == SLOT_OBJECT ||
        kind == SLOT_OBJECT_REF ||
        kind == SLOT_PTR ||
        kind == SLOT_OPAQUE_REF) {
        Span type = span_trim(cold_type_strip_var(
            function->param_type[param_index], 0));
        ObjectDef *object =
            type.len > 0
                ? symbols_resolve_object_in_generic_scope(
                      symbols, type,
                      function->generic_names,
                      function->generic_count,
                      function->generic_count > 0
                          ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                          : COLD_GENERIC_BINDER_NONE,
                      function->generic_count > 0
                          ? function->declaration_origin_row
                          : -1)
                : 0;
        if (!object) {
            return cold_exact_nominal_type_projection_id(
                symbols, type, kind);
        }
        if (object < symbols->objects ||
            object >=
                symbols->objects + symbols->object_count) {
            return -1;
        }
        int32_t object_row =
            (int32_t)(object - symbols->objects);
        object_row = cold_canonical_object_identity(
            symbols, object_row);
        if (object_row < 0 ||
            object_row >= symbols->object_count ||
            object_row >= domain_size - 1) {
            return -1;
        }
        object = &symbols->objects[object_row];
        if (object_is_ref_out) {
            *object_is_ref_out =
                object->is_ref ? 1 : 0;
        }
        int32_t identity_kind =
            kind == SLOT_PTR ||
                    kind == SLOT_OPAQUE_REF
                ? SLOT_OBJECT_REF
                : kind;
        return identity_kind * domain_size +
               object_row + 1;
    }
    int32_t nominal_type_id =
        cold_exact_nominal_type_projection_id(
            symbols,
            function->param_type[param_index],
            kind);
    if (nominal_type_id >= 0)
        return nominal_type_id;
    if (cold_exact_managed_storage_kind_for_slot_kind(kind) ==
            COLD_MANAGED_STORAGE_UNKNOWN) {
        return -1;
    }
    return kind * domain_size;
}

static int32_t cold_exact_return_type_id_from_signature(
        Symbols *symbols, const FnDef *function) {
    const int32_t domain_size = 1048576;
    if (!symbols || !function ||
        function->ret.len <= 0) {
        return -1;
    }
    int32_t kind =
        cold_parser_slot_kind_from_type_in_generic_scope(
            symbols, function->ret,
            function->generic_names,
            function->generic_count,
            function->generic_count > 0
                ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                : COLD_GENERIC_BINDER_NONE,
            function->generic_count > 0
                ? function->declaration_origin_row
                : -1);
    if (kind == SLOT_SEQ_OPAQUE ||
        kind == SLOT_SEQ_OPAQUE_REF) {
        int32_t element_row =
            cold_exact_opaque_sequence_element_type_row_for_function(
                symbols, function, function->ret);
        return element_row > 0
            ? kind * domain_size + element_row
            : -1;
    }
    int32_t abi_builtin_type_id =
        cold_exact_abi_builtin_type_id(
            function->ret, kind);
    if (abi_builtin_type_id >= 0)
        return abi_builtin_type_id;
    if (kind == SLOT_OBJECT ||
        kind == SLOT_OBJECT_REF ||
        kind == SLOT_PTR ||
        kind == SLOT_OPAQUE_REF) {
        Span type = span_trim(cold_type_strip_var(
            function->ret, 0));
        ObjectDef *object =
            type.len > 0
                ? symbols_resolve_object_in_generic_scope(
                      symbols, type,
                      function->generic_names,
                      function->generic_count,
                      function->generic_count > 0
                          ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                          : COLD_GENERIC_BINDER_NONE,
                      function->generic_count > 0
                          ? function->declaration_origin_row
                          : -1)
                : 0;
        if (!object) {
            return cold_exact_nominal_type_projection_id(
                symbols, type, kind);
        }
        if (object < symbols->objects ||
            object >=
                symbols->objects + symbols->object_count) {
            return -1;
        }
        int32_t object_row =
            cold_canonical_object_identity(
                symbols,
                (int32_t)(object -
                          symbols->objects));
        if (object_row < 0 ||
            object_row >= symbols->object_count ||
            object_row >= domain_size - 1) {
            return -1;
        }
        int32_t identity_kind =
            kind == SLOT_PTR ||
                    kind == SLOT_OPAQUE_REF
                ? SLOT_OBJECT_REF
                : kind;
        return identity_kind * domain_size +
               object_row + 1;
    }
    int32_t nominal_type_id =
        cold_exact_nominal_type_projection_id(
            symbols, function->ret, kind);
    if (nominal_type_id >= 0)
        return nominal_type_id;
    return cold_exact_managed_storage_kind_for_slot_kind(
               kind) ==
               COLD_MANAGED_STORAGE_UNKNOWN
           ? -1
           : kind * domain_size;
}

static void cold_publish_exact_formal_type_ids(
        Symbols *symbols, int32_t function_row) {
    if (!symbols || function_row < 0 ||
        function_row >= symbols->function_count) {
        die("function formal TypeId producer row is invalid");
    }
    FnDef *function = &symbols->functions[function_row];
    bool changed = false;
    for (int32_t param_index = 0;
         param_index < function->arity; param_index++) {
        int32_t object_is_ref = -1;
        int32_t exact_type_id =
            cold_exact_formal_type_id_from_signature(
                symbols, function, param_index,
                &object_is_ref);
        if (exact_type_id < 0) continue;
        int32_t current =
            function->param_exact_type_id[param_index];
        if (current == -1) {
            function->param_exact_type_id[param_index] =
                exact_type_id;
            changed = true;
        } else if (current != exact_type_id) {
            die("function formal TypeId drifted");
        }
        int32_t current_object_is_ref =
            function->param_exact_object_is_ref[
                param_index];
        if (object_is_ref >= 0) {
            if (current_object_is_ref == -1) {
                function->param_exact_object_is_ref[
                    param_index] =
                    object_is_ref;
                changed = true;
            } else if (current_object_is_ref !=
                       object_is_ref) {
                die("function formal object identity drifted");
            }
        } else if (current_object_is_ref != -1) {
            die("function non-object formal carries object identity");
        }
    }
    int32_t return_exact_type_id =
        cold_exact_return_type_id_from_signature(
            symbols, function);
    if (return_exact_type_id >= 0) {
        if (function->return_exact_type_id == -1) {
            function->return_exact_type_id =
                return_exact_type_id;
            changed = true;
        } else if (function->return_exact_type_id !=
                       return_exact_type_id) {
            die("function return TypeId drifted");
        }
    } else if (function->result_ownership_summary ==
                   COLD_RESULT_OWNERSHIP_BORROW_SHARED &&
               function->generic_count == 0 &&
               !span_eq(
                   span_trim(cold_type_strip_var(
                       function->ret, 0)),
                   "ptr")) {
        die("@borrow_result return TypeId unresolved");
    }
    if (changed) symbols->symbol_generation++;
}

static int32_t cold_exact_managed_storage_for_slot(
        Symbols *symbols, const BodyIR *body,
        int32_t slot, int32_t kind) {
    if (kind == SLOT_OPAQUE && body &&
        slot >= 0 && slot < body->slot_count &&
        body->slot_kind[slot] == kind &&
        body->slot_size[slot] == 8) {
        int32_t exact_type_id =
            cold_exact_abi_builtin_type_id(
                body->slot_type[slot], kind);
        if (exact_type_id == kind * 1048576 &&
            body->slot_exact_type_id[slot] == exact_type_id &&
            body->slot_managed_storage_kind[slot] == COLD_MANAGED_STORAGE_PLAIN) { return COLD_MANAGED_STORAGE_PLAIN;
        }
    }
    if (kind == SLOT_OBJECT ||
        kind == SLOT_OBJECT_REF) {
        if (cold_exact_managed_type_id(
                symbols, body, slot, kind) < 0) {
            return COLD_MANAGED_STORAGE_UNKNOWN;
        }
        if (!body || slot < 0 ||
            slot >= body->slot_count ||
            body->slot_kind[slot] != kind) {
            return COLD_MANAGED_STORAGE_UNKNOWN;
        }
        Span object_type = span_trim(cold_type_strip_var(
            body->slot_type[slot], 0));
        if (object_type.len <= 0)
            die("managed value object type identity is missing");
        if (cold_type_has_pointer_suffix(object_type))
            return COLD_MANAGED_STORAGE_UNKNOWN;
        /* A slot inside a generic template body may carry a scoped
           application spelling (`tables.Table[V]`): resolve it through the
           producer function's own generic binder -- the same scope
           cold_exact_managed_type_id already uses -- instead of minting an
           unscoped application whose TypeNode cannot bind the generic
           argument. */
        FnDef *producer =
            symbols &&
                    body->producer_function_row >= 0 &&
                    body->producer_function_row <
                        symbols->function_count
                ? &symbols->functions[body->producer_function_row]
                : 0;
        if (producer && producer->generic_count > 0 &&
            cold_type_references_generic_names(
                object_type, producer->generic_names,
                producer->generic_count)) {
            return cold_exact_type_storage_in_generic_scope(
                symbols, object_type,
                producer->generic_names,
                producer->generic_count,
                COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN,
                producer->declaration_origin_row, 0);
        }
        if (cold_type_requires_managed_drop(
                symbols, object_type, 0)) {
            return COLD_MANAGED_STORAGE_OBJECT;
        }
        /* Fixed-array carrier (Elem[N], count inline or a named
           constant): classify by the element own drop discipline --
           the same rule the PTR/OPAQUE_REF carrier path applies.  An
           array of drop-requiring elements is itself a managed
           aggregate; an array of POD elements is not. */
        if (object_type.len > 2 &&
            object_type.ptr[object_type.len - 1] == ']') {
            int32_t open = object_type.len - 2;
            while (open >= 0 && object_type.ptr[open] != '[') {
                uint8_t ch = (uint8_t)object_type.ptr[open];
                bool ok = (ch >= '0' && ch <= '9') ||
                          (ch >= 'A' && ch <= 'Z') || ch == '_' ||
                          ch == '.' ||
                          (ch >= 'a' && ch <= 'z');
                if (!ok) break;
                open--;
            }
            if (open >= 0 && object_type.ptr[open] == '[' &&
                open < object_type.len - 2) {
                Span element = span_trim(
                    (Span){object_type.ptr, open});
                if (element.len > 0 &&
                    (symbols_resolve_object(symbols, element) ||
                     cold_simple_builtin_type_name(element)) &&
                    cold_type_requires_managed_drop(
                        symbols, element, 0)) {
                    return COLD_MANAGED_STORAGE_OBJECT;
                }
            }
        }
        return cold_type_requires_managed_drop(
                   symbols, object_type, 0)
                   ? COLD_MANAGED_STORAGE_OBJECT
                   : COLD_MANAGED_STORAGE_UNKNOWN;
    }
    int32_t storage =
        cold_exact_managed_storage_kind_for_slot_kind(kind);
    if (storage != COLD_MANAGED_STORAGE_UNKNOWN) {
        if (kind == SLOT_I32_REF || kind == SLOT_I64_REF) {
            int32_t value_kind =
                kind == SLOT_I32_REF ? SLOT_I32 : SLOT_I64;
            int32_t value_type_id = -1;
            int32_t ref_type_id = -1;
            if (!body || slot < 0 || slot >= body->slot_count ||
                body->slot_kind[slot] != kind ||
                body->slot_size[slot] != 8 ||
                !cold_exact_scalar_value_ref_type_ids(
                    symbols, body->slot_type[slot], value_kind,
                    &value_type_id, &ref_type_id) ||
                value_type_id < 0 ||
                ref_type_id / 1048576 != kind ||
                (body->slot_exact_type_id[slot] != -1 &&
                 body->slot_exact_type_id[slot] != ref_type_id)) {
                return COLD_MANAGED_STORAGE_UNKNOWN;
            }
        }
        return storage;
    }
    if (!symbols || !body || slot < 0 ||
        slot >= body->slot_count ||
        body->slot_kind[slot] != kind ||
        (kind != SLOT_PTR && kind != SLOT_OPAQUE_REF) ||
        body->slot_size[slot] != 8) {
        return COLD_MANAGED_STORAGE_UNKNOWN;
    }
    Span type = span_trim(cold_type_strip_var(
        body->slot_type[slot], 0));
    ObjectDef *object =
        type.len > 0
            ? symbols_resolve_object(symbols, type)
            : 0;
    if (!object && type.len > 2 &&
        type.ptr[type.len - 1] == ']') {
        /* Fixed-array carrier (`MsQuicConnImpl[4]`): no ObjectDef row exists
           for the array spelling itself, so the plain resolve above always
           misses.  Peel the `[N]` count (same shape as the
           cold_exact_managed_type_id fallback) and classify by the element
           object: an array of drop-requiring elements is itself managed. */
        int32_t open = type.len - 2;
        while (open >= 0 && type.ptr[open] != '[') {
            uint8_t ch = (uint8_t)type.ptr[open];
            bool ok = (ch >= '0' && ch <= '9') ||
                      (ch >= 'A' && ch <= 'Z') || ch == '_' ||
                      ch == '.' ||
                      (ch >= 'a' && ch <= 'z');
            if (!ok) break;
            open--;
        }
        if (open >= 0 && type.ptr[open] == '[' &&
            open < type.len - 2) {
            Span element = span_trim((Span){type.ptr, open});
            ObjectDef *element_object =
                element.len > 0
                    ? symbols_resolve_object(symbols, element)
                    : 0;
            if (element_object) {
                type = element;
                object = element_object;
            } else if (element.len > 0 &&
                       cold_simple_builtin_type_name(element) &&
                       cold_type_requires_managed_drop(
                           symbols, element, 0)) {
                /* Managed builtin element (`str[4]`): no ObjectDef row
                   exists for the element either, but the array place still
                   owns drop-requiring cells.  Classify the carrier as a
                   managed aggregate so the GLOBAL definition stamp agrees
                   with freeze-time canonical obligation.  POD element
                   arrays (`int32[]`) stay unmanaged here. */
                return COLD_MANAGED_STORAGE_OBJECT;
            }
        }
    }
    if (cold_type_has_pointer_suffix(span_trim(cold_type_strip_var(
            body->slot_type[slot], 0)))) {
        /* The cell stores an address. Overwriting `gNodePtr: Node*` does
           not drop a Node. */
        return COLD_MANAGED_STORAGE_UNKNOWN;
    }
    if (!object && cold_type_has_pointer_suffix(type)) {
        /* A pointer-spelled slot type (`RecA*`) names the pointee object,
           same as its alias form (`RecAPtr`): strip one trailing `*` and
           resolve again (mirrors the cold_exact_managed_type_id fallback). */
        type = span_trim(span_sub(type, 0, type.len - 1));
        object =
            type.len > 0
                ? symbols_resolve_object(symbols, type)
                : 0;
    }
    /* A pointer carrier follows the pointee's own drop discipline: a
       pointer to a POD object is an unmanaged raw address (no exact
       definition can or must exist for it), while a pointer to an
       RC/drop-requiring object is managed.  Resolving ANY object here
       unconditionally classified even raw pointers to plain data as
       managed, demanding definitions the identity system deliberately
       never mints for them. */
    return (object &&
            (object->is_ref ||
             cold_type_requires_managed_drop(
                 symbols, type, 0)))
               ? COLD_MANAGED_STORAGE_OBJECT
               : COLD_MANAGED_STORAGE_UNKNOWN;
}

static bool cold_exact_temp_diag_enabled(void) {
    static int8_t cached = -1;
    if (cached < 0)
        cached = cold_env_flag("CHENG_COLD_DUMP_VAR_FORWARD")
                     ? 1 : 0;
    return cached != 0;
}

static int32_t cold_exact_storage_authority_for_slot(
        Symbols *symbols, const BodyIR *body,
        int32_t slot, int32_t kind) {
    int32_t managed = cold_exact_managed_storage_for_slot(
        symbols, body, slot, kind);
    if (managed != COLD_MANAGED_STORAGE_UNKNOWN)
        return managed;
    if (kind == SLOT_OBJECT || kind == SLOT_OBJECT_REF)
        if (cold_exact_temp_diag_enabled())
            if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([mtid]) slot=%d kind=%d type=%.*s etid=%d\n",
            slot, kind,
            (int)body->slot_type[slot].len,
            body->slot_type[slot].ptr ? (const char*)body->slot_type[slot].ptr : "",
            body->slot_exact_type_id[slot]);
    if (!symbols || !body || slot < 0 ||
        slot >= body->slot_count ||
        (kind != SLOT_OBJECT &&
         kind != SLOT_OBJECT_REF &&
         kind != SLOT_OPAQUE_REF &&
         kind != SLOT_PTR) ||
        body->slot_kind[slot] != kind ||
        body->slot_size[slot] <= 0 ||
        cold_exact_managed_type_id(
            symbols, body, slot, kind) < 0) {
        return COLD_MANAGED_STORAGE_UNKNOWN;
    }
    int32_t exact_type_id =
        cold_exact_managed_type_id(
            symbols, body, slot, kind);
    int32_t identity_kind =
        kind == SLOT_OBJECT
            ? SLOT_OBJECT
            : SLOT_OBJECT_REF;
    ObjectDef *object =
        cold_exact_object_layout_from_type_id(
            symbols, exact_type_id,
            identity_kind);
    if (!object)
        return COLD_MANAGED_STORAGE_UNKNOWN;
    return cold_exact_object_storage_from_definition(
        symbols, object, 0);
}

/* Conditional lowering must preserve exact identity for every value whose
   physical carrier is nominal, not only for values that require an ORC
   drop.  A POD object such as FixedBytes32 has PLAIN storage, but copying
   both arms into one unversioned slot still loses the immutable branch
   definition.  The storage-authority classifier is the single source of
   truth for that wider identity domain: managed values keep their existing
   behavior and plain nominal aggregates now take the exact CFG-merge path. */
static bool cold_exact_conditional_requires_identity_merge(
        Symbols *symbols, const BodyIR *body,
        int32_t slot, int32_t kind) {
    return cold_exact_storage_authority_for_slot(
               symbols, body, slot, kind) !=
           COLD_MANAGED_STORAGE_UNKNOWN;
}

static void cold_publish_exact_managed_definition(
        BodyIR *body, Symbols *symbols, int32_t slot, int32_t kind,
        int32_t producer_op, int32_t ownership,
        ColdExprResult *result_out) {
    int32_t exact_type_id =
        cold_exact_managed_type_id(symbols, body, slot, kind);
    int32_t storage = cold_exact_storage_authority_for_slot(
        symbols, body, slot, kind);
    if (!body || producer_op < 0 || producer_op >= body->op_count ||
        slot < 0 || slot >= body->slot_count ||
        body->op_dst[producer_op] != slot ||
        body->producer_function_row < 0 ||
        exact_type_id < 0 ||
        storage == COLD_MANAGED_STORAGE_UNKNOWN ||
        (ownership != COLD_EXPR_OWN_MOVE &&
         ownership != COLD_EXPR_OWN_BORROW_SHARED &&
         ownership != COLD_EXPR_OWN_BORROW_UNIQUE) ||
        !cold_exact_op_tuple_is_sentinel(body, producer_op) ||
        /* A static kind-lane does not claim the carrier: only an
           identity (place/origin/TypeId) counts as prior authority. */
        body->slot_place_kind[slot] !=
            COLD_EXPR_PLACE_INVALID ||
        body->slot_origin_id[slot] != -1 ||
        body->slot_exact_type_id[slot] != -1) {
        die("managed producer lacks exact TypeId/function/value definition");
    }
    body->op_value_def_slot[producer_op] = slot;
    body->op_value_def_exact_type_id[producer_op] = exact_type_id;
    body->op_value_def_producer_function_row[producer_op] =
        body->producer_function_row;
    body->op_value_def_place_kind[producer_op] =
        COLD_EXPR_PLACE_TEMPORARY;
    body->op_value_def_ownership[producer_op] = ownership;
    body->op_value_def_origin_id[producer_op] = producer_op;
    body->slot_exact_type_id[slot] = exact_type_id;
    body->slot_place_kind[slot] = COLD_EXPR_PLACE_TEMPORARY;
    body->slot_origin_id[slot] = producer_op;
    /* The PLAIN publisher twin records the storage authority's classification
       on the slot (cold_publish_owned_managed_producer); every downstream
       reader that classifies by the stamped lane -- opaque-sequence
       append/take element validation, decomposition shape checks, consume
       classifiers -- must observe the same fact here.  body_slot keeps
       OBJECT/OBJECT_REF carriers UNKNOWN precisely until this proven
       authority lands, so the stamp is the landing, not a second authority. */
    body->slot_managed_storage_kind[slot] = storage;
    ColdExprResult result;
    cold_expr_result_reset(&result);
    result.slot = slot;
    result.kind = kind;
    result.value_def_op_id = producer_op;
    result.exact_type_id = exact_type_id;
    result.producer_function_row = body->producer_function_row;
    result.place_kind = COLD_EXPR_PLACE_TEMPORARY;
    result.ownership = ownership;
    result.origin_id = producer_op;
    if (result_out) *result_out = result;
    cold_expr_result_publish(body, &result);
}

static void cold_expr_result_publish(BodyIR *body,
                                     const ColdExprResult *result) {
    if (!result || !ColdActiveExprResult ||
        ColdActiveExprResultBody != body) {
        return;
    }
    *ColdActiveExprResult = *result;
}

static void cold_expr_borrow_root_publish(
        BodyIR *body, Symbols *symbols,
        const ColdExprResult *root) {
    if (!ColdActiveExprBorrowRoot ||
        ColdActiveExprResultBody != body) {
        return;
    }
    bool exact_plain_param_root =
        body && symbols && root &&
        root->ownership == COLD_EXPR_OWN_PLAIN &&
        root->place_kind == COLD_EXPR_PLACE_PARAM &&
        cold_borrow_result_root_valid(
            body, symbols, root->value_def_op_id, 0);
    if (!body || !symbols || !root ||
        root->slot < 0 ||
        root->slot >= body->slot_count ||
        root->value_def_op_id < 0 ||
        root->value_def_op_id >= body->op_count ||
        (root->ownership !=
             COLD_EXPR_OWN_BORROW_SHARED &&
         root->ownership !=
             COLD_EXPR_OWN_BORROW_UNIQUE &&
         !exact_plain_param_root) ||
        !cold_exact_op_tuple_matches_result(
            body, root)) {
        die("expression borrow root is not exact");
    }
    *ColdActiveExprBorrowRoot = *root;
}

static void cold_publish_exact_scalar_borrow_projection(
        BodyIR *body, Symbols *symbols,
        int32_t producer_op, int32_t root_definition) {
    bool publish_borrow_root =
        ColdActiveExprBorrowRoot &&
        ColdActiveExprResultBody == body;
    /* The isolated contract probe exists only to recover FunctionRow call
       edges for the dependency DAG.  A later-row callee has intentionally
       not sealed its root yet, so no scalar/root fact from this disposable
       body may be published or validated as production authority. */
    if (ColdBorrowResultContractProbe)
        return;
    if (!body || !symbols ||
        producer_op < 0 ||
        producer_op >= body->op_count ||
        root_definition < 0 ||
        root_definition >= producer_op ||
        !cold_exact_op_tuple_is_sentinel(
            body, producer_op)) {
        die("scalar borrow projection producer is not sentinel");
    }
    ColdExprResult root;
    cold_expr_result_reset(&root);
    int32_t root_slot =
        body->op_value_def_slot[root_definition];
    if (root_slot < 0 ||
        root_slot >= body->slot_count ||
        !cold_exact_result_from_definition(
            body, root_slot,
            root_definition, &root) ||
        (root.ownership !=
             COLD_EXPR_OWN_BORROW_SHARED &&
         root.ownership !=
             COLD_EXPR_OWN_BORROW_UNIQUE &&
         root.ownership !=
             COLD_EXPR_OWN_PLAIN &&
         root.ownership !=
             COLD_EXPR_OWN_MOVE) ||
        !cold_exact_definition_reaches_consumer(
            body, root_definition,
            producer_op)) {
        die("scalar borrow projection root is not exact");
    }
    body->op_source_value_def_op_id[
        producer_op] = root_definition;
    if (cold_exact_scalar_borrow_projection_root(
            body, symbols, producer_op) !=
        root_definition) {
        fprintf(
            stderr,
            "cheng_cold: scalar projection detail body=%.*s"
            " producer=%d kind=%d dst=%d a=%d b=%d c=%d"
            " root=%d root_kind=%d root_slot=%d root_type=%d"
            " root_place=%d root_ownership=%d root_origin=%d"
            " root_source=%d terminal=%d terminal_borrow=%d"
            " terminal_kind=%d terminal_slot=%d terminal_type=%d"
            " terminal_place=%d terminal_ownership=%d terminal_origin=%d"
            " terminal_owner=%d terminal_owned=%d"
            " borrow_root=%d owner_root=%d owned_local=%d exact=%d\n",
            (int)body->debug_name.len,
            body->debug_name.ptr
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            producer_op, body->op_kind[producer_op],
            body->op_dst[producer_op],
            body->op_a[producer_op],
            body->op_b[producer_op],
            body->op_c[producer_op],
            root_definition,
            body->op_kind[root_definition],
            body->op_value_def_slot[root_definition],
            body->op_value_def_exact_type_id[root_definition],
            body->op_value_def_place_kind[root_definition],
            body->op_value_def_ownership[root_definition],
            body->op_value_def_origin_id[root_definition],
            body->op_source_value_def_op_id[root_definition],
            cold_exact_projection_terminal_authority_root_definition(
                body, symbols, root_definition),
            body->op_kind[
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition)],
            body->op_value_def_slot[
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition)],
            body->op_value_def_exact_type_id[
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition)],
            body->op_value_def_place_kind[
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition)],
            body->op_value_def_ownership[
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition)],
            body->op_value_def_origin_id[
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition)],
            cold_borrow_result_root_valid(
                body, symbols,
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition), 1) ? 1 : 0,
            cold_borrow_result_owner_root_valid(
                body, symbols,
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition)) ? 1 : 0,
            cold_exact_owned_local_authority_valid(
                body, symbols,
                cold_exact_projection_terminal_authority_root_definition(
                    body, symbols, root_definition), 1) ? 1 : 0,
            cold_borrow_result_root_valid(
                body, symbols, root_definition, 1) ? 1 : 0,
            cold_borrow_result_owner_root_valid(
                body, symbols, root_definition) ? 1 : 0,
            cold_exact_owned_local_authority_valid(
                body, symbols, root_definition, 1) ? 1 : 0,
            cold_exact_scalar_borrow_projection_root(
                body, symbols, producer_op));
        cold_dump_bodyir_if_requested(body);
        die("scalar borrow projection producer/root chain is invalid");
    }
    bool stable_borrow_root =
        root.ownership == COLD_EXPR_OWN_BORROW_SHARED ||
        root.ownership == COLD_EXPR_OWN_BORROW_UNIQUE ||
        (root.ownership == COLD_EXPR_OWN_PLAIN &&
         root.place_kind == COLD_EXPR_PLACE_PARAM &&
         cold_borrow_result_root_valid(
             body, symbols, root.value_def_op_id, 0));
    /* An owned local can be the exact lifetime root of an immediate raw
       scalar projection, but it cannot become a borrow-result authority:
       the local dies with this function.  Keep the immutable source edge on
       the carrier for liveness validation and publish only roots that are
       already borrowed from a caller/global authority. */
    if (publish_borrow_root && stable_borrow_root)
        cold_expr_borrow_root_publish(
            body, symbols, &root);
    if (publish_borrow_root && stable_borrow_root &&
        ColdActiveExprScalarBorrowCarrierOp)
        *ColdActiveExprScalarBorrowCarrierOp =
            producer_op;
}

static void cold_publish_scalar_borrow_projection_from_operand(
        BodyIR *body, Symbols *symbols,
        int32_t producer_op, int32_t operand_slot) {
    if (!body || !symbols ||
        producer_op < 0 ||
        producer_op >= body->op_count ||
        operand_slot < 0 ||
        operand_slot >= body->slot_count ||
        body->op_a[producer_op] != operand_slot) {
        die("scalar borrow projection operand is invalid");
    }
    int32_t source_producer = -1;
    int32_t root_definition = -1;
    for (int32_t op = 0;
         op < producer_op; op++) {
        if (body->op_dst[op] != operand_slot ||
            !cold_exact_definition_reaches_consumer(
                body, op, producer_op)) {
            continue;
        }
        int32_t candidate =
            cold_exact_scalar_borrow_projection_root(
                body, symbols, op);
        if (candidate < 0) continue;
        if (source_producer >= 0)
            die("scalar borrow projection operand has multiple producers");
        source_producer = op;
        root_definition = candidate;
    }
    if (source_producer < 0)
        return;
    cold_publish_exact_scalar_borrow_projection(
        body, symbols, producer_op,
        root_definition);
}

static void cold_publish_scalar_borrow_call_result(
        BodyIR *body, Symbols *symbols,
        int32_t call_op) {
    if (!ColdActiveExprBorrowRoot ||
        ColdActiveExprResultBody != body) {
        return;
    }
    int32_t root =
        cold_exact_scalar_borrow_call_arg_root(
            body, symbols, call_op);
    if (root < 0)
        return;
    cold_publish_exact_scalar_borrow_projection(
        body, symbols, call_op, root);
}

/* A shared managed formal is immutable for the entire call.  Its canonical
   PARAM entry row is therefore an O(1) lifetime authority across CFG joins:
   consuming calls reject BORROW_SHARED and var formals require unique
   authority.  Keep this proof structural so managed reads and scalar field
   projections consume the identical ABI tuple. */
static bool cold_exact_shared_borrow_param_definition_valid(
        const BodyIR *body, int32_t definition,
        int32_t slot) {
    if (!body || definition < 0 || definition >= body->op_count ||
        slot < 0 || slot >= body->slot_count ||
        body->op_value_def_place_kind[definition] !=
            COLD_EXPR_PLACE_PARAM ||
        body->op_value_def_ownership[definition] !=
            COLD_EXPR_OWN_BORROW_SHARED) {
        return false;
    }
    int32_t parameter =
        body->op_value_def_origin_id[definition];
    if (body->op_value_def_place_kind[definition] ==
            COLD_EXPR_PLACE_BORROW_PROJECTION)
        if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([pbv]) d=%d slot=%d org=%d dst=%d a=%d c=%d vs=%d et=%d set=%d pr=%d br=%d spl=%d sor=%d smg=%d\n",
            definition, slot, parameter,
            body->op_dst[definition],
            body->op_a[definition],
            body->op_c[definition],
            body->op_value_def_slot[definition],
            body->op_value_def_exact_type_id[definition],
            slot >= 0 ? body->slot_exact_type_id[slot] : -9,
            body->op_value_def_producer_function_row[definition],
            body->producer_function_row,
            slot >= 0 ? body->slot_place_kind[slot] : -9,
            slot >= 0 ? body->slot_origin_id[slot] : -9,
            slot >= 0 ? body->slot_managed_storage_kind[slot] : -9);
    if (parameter < 0 || parameter >= body->param_count)
        return false;
    int32_t raw_slot = body->param_slot[parameter];
    if (raw_slot < 0 || raw_slot >= body->slot_count)
        return false;
    int32_t entry_copy =
        body->slot_size[raw_slot] == 8
            ? BODY_OP_COPY_I64
            : BODY_OP_COPY_COMPOSITE;
    return body->op_kind[definition] == entry_copy &&
           body->op_dst[definition] == slot &&
           body->op_a[definition] == raw_slot &&
           /* op_b is an emitter-local staging flag, not part of the
              formal-materialization identity: both entry-copy
              emitters (function prologue and managed borrowed
              assignment from a raw formal slot) produce the same
              semantic row. Accept either staging value. */
           (body->op_b[definition] == 0 ||
            body->op_b[definition] == 1) &&
           body->op_c[definition] == 0 &&
           body->op_source_value_def_op_id[definition] == -1 &&
           body->op_value_def_slot[definition] == slot &&
           body->op_value_def_exact_type_id[definition] >= 0 &&
           body->op_value_def_exact_type_id[definition] ==
               body->slot_exact_type_id[slot] &&
           body->op_value_def_producer_function_row[definition] ==
               body->producer_function_row &&
           body->slot_place_kind[slot] == COLD_EXPR_PLACE_PARAM &&
           body->slot_origin_id[slot] == parameter &&
           body->slot_managed_storage_kind[slot] !=
               COLD_MANAGED_STORAGE_UNKNOWN;
}

static void cold_expr_scalar_projection_borrow_root_publish(
        Parser *parser, BodyIR *body, Symbols *symbols,
        const ColdExprResult *root,
        int32_t projection_op) {
    bool publish_borrow_root =
        ColdActiveExprBorrowRoot &&
        ColdActiveExprResultBody == body;
    bool borrowed_root_live =
        body && root &&
        (root->ownership == COLD_EXPR_OWN_BORROW_SHARED ||
         root->ownership == COLD_EXPR_OWN_BORROW_UNIQUE) &&
        (cold_exact_shared_borrow_param_definition_valid(
             body, root->value_def_op_id, root->slot) ||
         cold_exact_definition_is_live_before_op(
             body, root->value_def_op_id, projection_op));
    bool owned_root_current =
        body && root &&
        (root->ownership == COLD_EXPR_OWN_PLAIN ||
         root->ownership == COLD_EXPR_OWN_MOVE) &&
        cold_exact_definition_is_current_at_consumer(
            body, root->value_def_op_id, projection_op);
    if (!body || !root ||
        projection_op < 0 ||
        projection_op >= body->op_count ||
        root->slot < 0 ||
        root->slot >= body->slot_count ||
        root->value_def_op_id < 0 ||
        root->value_def_op_id >= projection_op ||
        body->op_a[projection_op] != root->slot ||
        body->op_dst[projection_op] < 0 ||
        body->op_dst[projection_op] >=
            body->slot_count ||
        (body->op_kind[projection_op] !=
             BODY_OP_PAYLOAD_LOAD &&
         body->op_kind[projection_op] !=
             BODY_OP_FIELD_REF) ||
        !cold_exact_op_tuple_matches_result(
            body, root) ||
        (!borrowed_root_live && !owned_root_current)) {
        if (cold_env_flag("CHENG_COLD_DUMP_BODYIR")) {
            if (parser) cold_error_loc(parser, parser_peek(parser));
            if (parser && parser->source.ptr && parser->source.len >= 0) {
                int32_t diag_from = parser->pos > 96
                    ? parser->pos - 96 : 0;
                int32_t diag_to = parser->pos + 96 < parser->source.len
                    ? parser->pos + 96 : parser->source.len;
                fprintf(stderr,
                        "cheng_cold: scalar_projection_source pos=%d text=%.*s\n",
                        parser->pos, diag_to - diag_from,
                        parser->source.ptr + diag_from);
            }
            fprintf(stderr,
                    "cheng_cold: scalar_projection root_slot=%d root_def=%d root_own=%d root_place=%d root_origin=%d projection=%d kind=%d dst=%d op_a=%d borrowed_live=%d owned_current=%d tuple=%d producer_function=%d current_block=%d blocks=%d indexed_ops=%d\n",
                    root ? root->slot : -1,
                    root ? root->value_def_op_id : -1,
                    root ? root->ownership : -1,
                    root ? root->place_kind : -1,
                    root ? root->origin_id : -1,
                    projection_op,
                    body && projection_op >= 0 && projection_op < body->op_count
                        ? body->op_kind[projection_op] : -1,
                    body && projection_op >= 0 && projection_op < body->op_count
                        ? body->op_dst[projection_op] : -1,
                    body && projection_op >= 0 && projection_op < body->op_count
                        ? body->op_a[projection_op] : -1,
                    borrowed_root_live,
                    owned_root_current,
                    body && root ? cold_exact_op_tuple_matches_result(body, root) : 0,
                    body ? body->producer_function_row : -1,
                    body ? body->cur_open_block : -1,
                    body ? body->block_count : -1,
                    body ? body->op_block_indexed_op_count : -1);
            if (body) {
                int32_t diag_start = projection_op > 12
                    ? projection_op - 12 : 0;
                for (int32_t diag_op = diag_start;
                     diag_op <= projection_op; diag_op++) {
                    int32_t diag_callee =
                        (body->op_kind[diag_op] == BODY_OP_CALL_COMPOSITE ||
                         body->op_kind[diag_op] == BODY_OP_CALL_I32)
                            ? body->op_a[diag_op] : -1;
                    fprintf(stderr,
                            "cheng_cold: scalar_projection_tail op=%d kind=%d dst=%d a=%d b=%d c=%d def=%d place=%d own=%d origin=%d source=%d block=%d callee=%.*s\n",
                            diag_op, body->op_kind[diag_op],
                            body->op_dst[diag_op], body->op_a[diag_op],
                            body->op_b[diag_op], body->op_c[diag_op],
                            body->op_value_def_slot[diag_op],
                            body->op_value_def_place_kind[diag_op],
                            body->op_value_def_ownership[diag_op],
                            body->op_value_def_origin_id[diag_op],
                            body->op_source_value_def_op_id[diag_op],
                            body->op_block_index[diag_op],
                            diag_callee >= 0 && symbols &&
                                    diag_callee < symbols->function_count
                                ? (int)symbols->functions[diag_callee].name.len
                                : 0,
                            diag_callee >= 0 && symbols &&
                                    diag_callee < symbols->function_count &&
                                    symbols->functions[diag_callee].name.ptr
                                ? symbols->functions[diag_callee].name.ptr
                                : (const uint8_t *)"");
                }
            }
            cold_dump_bodyir_if_requested(body);
        }
        die("scalar field projection borrow root is not exact");
    }
    if (cold_exact_managed_read_operand_allowed(
            body->op_kind[projection_op],
            COLD_EXACT_READ_OPERAND_A)) {
        cold_publish_exact_managed_read(
            body, projection_op,
            COLD_EXACT_READ_OPERAND_A, root);
    }
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([hop]) fn=%.*s proj=%d dst=%d base=%d\n",
        (int)body->debug_name.len,
        body->debug_name.ptr ? (const char*)body->debug_name.ptr : 0,
        projection_op, body->op_dst[projection_op],
        body->op_a[projection_op]);
    int32_t destination =
        body->op_dst[projection_op];
    /* Publish the projection carrier's storage lane eagerly: every
       later read edge through this slot proves against it, and an
       UNKNOWN stamp would make the same bytes unprovable. */
    if (body->slot_managed_storage_kind[destination] ==
            COLD_MANAGED_STORAGE_UNKNOWN) {
        int32_t projection_storage =
            cold_exact_storage_authority_for_slot(
                symbols, body, destination,
                body->slot_kind[destination]);
        if (projection_storage !=
                COLD_MANAGED_STORAGE_UNKNOWN)
            body->slot_managed_storage_kind[destination] =
                projection_storage;
    }
    if (body->slot_kind[destination] == SLOT_PTR ||
        body->slot_kind[destination] == SLOT_OPAQUE) {
        if (publish_borrow_root) {
            cold_publish_exact_scalar_borrow_projection(
                body, symbols,
                projection_op,
                root->value_def_op_id);
        } else if (!ColdBorrowResultContractProbe) {
            body->op_source_value_def_op_id[
                projection_op] = root->value_def_op_id;
            int32_t fx_resolved =
                cold_exact_scalar_borrow_projection_root(
                    body, symbols, projection_op);
            if (fx_resolved !=
                root->value_def_op_id) {
                if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([fxs]) proj=%d k=%d dst=%d a=%d b=%d c=%d rootdef=%d resolved=%d rk=%d rslot=%d rpl=%d rown=%d rorg=%d rsrc=%d psent=%d brv=%d borv=%d olav=%d term=%d pvcv=%d pvsv=%d\n",
                    projection_op, body->op_kind[projection_op], body->op_dst[projection_op], body->op_a[projection_op], body->op_b[projection_op], body->op_c[projection_op],
                    root->value_def_op_id, fx_resolved,
                    body->op_kind[root->value_def_op_id], body->op_value_def_slot[root->value_def_op_id], body->op_value_def_place_kind[root->value_def_op_id], body->op_value_def_ownership[root->value_def_op_id], body->op_value_def_origin_id[root->value_def_op_id], body->op_source_value_def_op_id[root->value_def_op_id],
                    cold_exact_op_tuple_is_sentinel(body, projection_op)?1:0,
                    cold_borrow_result_root_valid(body, symbols, root->value_def_op_id, 1)?1:0,
                    cold_borrow_result_owner_root_valid(body, symbols, root->value_def_op_id)?1:0,
                    cold_exact_owned_local_authority_valid(body, symbols, root->value_def_op_id, 1)?1:0,
                    cold_exact_projection_terminal_authority_root_definition(body, symbols, root->value_def_op_id),
                    cold_exact_var_projection_carrier_valid(body, symbols, root->value_def_op_id)?1:0,
                    cold_exact_var_projection_definition_valid(body, symbols, root->value_def_op_id)?1:0);
            { int32_t t = cold_exact_projection_terminal_authority_root_definition(body, symbols, root->value_def_op_id);
              if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([fxt]) terminal=%d k=%d vds=%d pl=%d ow=%d org=%d src=%d et=%d pfr=%d cons=%d brv=%d borv=%d olav=%d cvo=%d\n", t,
                  t>=0?body->op_kind[t]:-9, t>=0?body->op_value_def_slot[t]:-9, t>=0?body->op_value_def_place_kind[t]:-9, t>=0?body->op_value_def_ownership[t]:-9, t>=0?body->op_value_def_origin_id[t]:-9, t>=0?body->op_source_value_def_op_id[t]:-9, t>=0?body->op_value_def_exact_type_id[t]:-9, t>=0?body->op_value_def_producer_function_row[t]:-9, t>=0?body->op_value_def_consume_op_index_plus_one[t]:-9,
                  t>=0?(cold_borrow_result_root_valid(body, symbols, t, 1)?1:0):-9, t>=0?(cold_borrow_result_owner_root_valid(body, symbols, t)?1:0):-9, t>=0?(cold_exact_owned_local_authority_valid(body, symbols, t, 1)?1:0):-9, t>=0?(cold_exact_call_var_out_definition_valid(body, symbols, t)?1:0):-9); }
                die("scalar pointer read source is not exact");
            }
        }
        return;
    }
    if (root->ownership ==
            COLD_EXPR_OWN_BORROW_SHARED ||
        root->ownership ==
            COLD_EXPR_OWN_BORROW_UNIQUE) {
        if (body->op_source_value_def_op_id[
                projection_op] != -1) {
            die("scalar field read source is already published");
        }
        body->op_source_value_def_op_id[
            projection_op] = root->value_def_op_id;
        if (publish_borrow_root)
            cold_expr_borrow_root_publish(
                body, symbols, root);
        return;
    }
    if (root->ownership == COLD_EXPR_OWN_PLAIN ||
        root->ownership == COLD_EXPR_OWN_MOVE) {
        /* The exact direct-read edge above remains authoritative, but a
           numeric field is a value and must not manufacture a borrow root. */
        return;
    }
    die("scalar field projection parent ownership is invalid");
}

static void cold_expr_result_invalidate_active(BodyIR *body) {
    if (ColdActiveExprResult && ColdActiveExprResultBody == body)
        cold_expr_result_reset(ColdActiveExprResult);
}

static int32_t cold_publish_global_shadow_result(
        BodyIR *body, const Local *local, int32_t *kind_out) {
    ColdExprResult result;
    cold_expr_result_reset(&result);
    int32_t def = local->value_def_op_id;
    result.slot = local->slot;
    result.kind = local->kind;
    result.value_def_op_id = def;
    result.exact_type_id =
        def >= 0 ? body->op_value_def_exact_type_id[def] : -1;
    result.producer_function_row =
        def >= 0 ? body->op_value_def_producer_function_row[def] : -1;
    result.place_kind = COLD_EXPR_PLACE_GLOBAL;
    result.ownership = COLD_EXPR_OWN_BORROW_SHARED;
    result.origin_id =
        def >= 0 ? body->op_value_def_origin_id[def] : -1;
    cold_expr_result_publish(body, &result);
    if (kind_out) *kind_out = result.kind;
    return result.slot;
}

static int32_t cold_materialize_exact_global_scalar_value(
        BodyIR *body, Symbols *symbols,
        const Local *local, int32_t *kind_out) {
    if (!body || !symbols || !local || !local->is_global ||
        local->value_def_op_id < 0 ||
        local->value_def_op_id >= body->op_count ||
        (local->kind != SLOT_I32_REF &&
         local->kind != SLOT_I64_REF)) {
        die("global scalar value materialization lacks exact place");
    }
    ColdExprResult global_root;
    cold_expr_result_reset(&global_root);
    bool fxr_ok = cold_exact_result_from_definition(
            body, local->slot,
            local->value_def_op_id, &global_root);
    if (cold_env_flag("CHENG_COLD_DUMP_VAR_FORWARD"))
        if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([fxg]) slot=%d kind=%d def=%d rok=%d gk=%d gpl=%d gown=%d gdef=%d gdk=%d get=%d abiet=%d stor=%d\n",
            local->slot, local->kind, local->value_def_op_id, fxr_ok?1:0,
            fxr_ok?global_root.kind:-9, fxr_ok?global_root.place_kind:-9,
            fxr_ok?global_root.ownership:-9,
            fxr_ok?global_root.value_def_op_id:-9,
            fxr_ok&&global_root.value_def_op_id>=0&&global_root.value_def_op_id<body->op_count?body->op_kind[global_root.value_def_op_id]:-9,
            fxr_ok?global_root.exact_type_id:-9,
            cold_exact_abi_builtin_type_id(body->slot_type[local->slot], local->kind),
            body->slot_managed_storage_kind[local->slot]);
    if (!fxr_ok ||
        global_root.kind != local->kind ||
        global_root.place_kind != COLD_EXPR_PLACE_GLOBAL ||
        global_root.ownership != COLD_EXPR_OWN_BORROW_SHARED ||
        body->op_kind[global_root.value_def_op_id] !=
            BODY_OP_GLOBAL_ADDR ||
        global_root.exact_type_id !=
            cold_exact_abi_builtin_type_id(
                body->slot_type[local->slot], local->kind) ||
        body->slot_managed_storage_kind[local->slot] !=
            COLD_MANAGED_STORAGE_PLAIN) {
        die("global scalar value root is not exact");
    }
    int32_t value_kind =
        local->kind == SLOT_I32_REF
            ? SLOT_I32 : SLOT_I64;
    int32_t value_size =
        value_kind == SLOT_I32 ? 4 : 8;
    int32_t value_slot =
        body_slot(body, value_kind, value_size);
    body_slot_set_type(
        body, value_slot,
        body->slot_type[local->slot]);
    int32_t definition = body_op(
        body,
        value_kind == SLOT_I32
            ? BODY_OP_I32_REF_LOAD
            : BODY_OP_PTR_LOAD_I64,
        value_slot, local->slot, 0);
    cold_publish_exact_managed_read(
        body, definition,
        COLD_EXACT_READ_OPERAND_A,
        &global_root);
    int32_t value_type_id =
        cold_exact_abi_builtin_type_id(
            body->slot_type[value_slot], value_kind);
    if (value_type_id < 0 ||
        value_type_id != value_kind * 1048576) {
        die("global scalar value TypeId is not exact");
    }
    body->op_value_def_slot[definition] = value_slot;
    body->op_value_def_exact_type_id[definition] =
        value_type_id;
    body->op_value_def_producer_function_row[definition] =
        body->producer_function_row;
    body->op_value_def_place_kind[definition] =
        COLD_EXPR_PLACE_TEMPORARY;
    body->op_value_def_ownership[definition] =
        COLD_EXPR_OWN_PLAIN;
    body->op_value_def_origin_id[definition] = definition;
    body->slot_exact_type_id[value_slot] = value_type_id;
    body->slot_place_kind[value_slot] =
        COLD_EXPR_PLACE_TEMPORARY;
    body->slot_origin_id[value_slot] = definition;
    body->slot_managed_storage_kind[value_slot] = COLD_MANAGED_STORAGE_PLAIN;
    if (!cold_exact_global_scalar_read_value_tuple_valid(
            body, symbols, definition)) {
        die("global scalar value publication is not exact");
    }
    ColdExprResult result;
    cold_expr_result_reset(&result);
    result.slot = value_slot;
    result.kind = value_kind;
    result.value_def_op_id = definition;
    result.exact_type_id = value_type_id;
    result.producer_function_row =
        body->producer_function_row;
    result.place_kind = COLD_EXPR_PLACE_TEMPORARY;
    result.ownership = COLD_EXPR_OWN_PLAIN;
    result.origin_id = definition;
    cold_expr_result_publish(body, &result);
    if (kind_out) *kind_out = value_kind;
    return value_slot;
}

static void cold_publish_owned_managed_producer(
        BodyIR *body, Symbols *symbols, int32_t slot, int32_t kind,
        int32_t producer_op, ColdExprResult *result_out);

static int32_t cold_body_result_ownership_summary(
        const BodyIR *body, const Symbols *symbols) {
    if (!body || !symbols ||
        body->producer_function_row < 0 ||
        body->producer_function_row >=
            symbols->function_count) {
        return COLD_RESULT_OWNERSHIP_UNKNOWN;
    }
    return symbols->functions[
        body->producer_function_row].
            result_ownership_summary;
}

static int32_t cold_borrow_result_canonical_root_definition(
        const BodyIR *body, const Symbols *symbols,
        int32_t definition, int32_t depth);
static int32_t cold_borrow_result_seal_root_definition(
        const BodyIR *body, const Symbols *symbols,
        int32_t definition, int32_t depth);

static void cold_publish_result_aggregate(
        BodyIR *body, Symbols *symbols,
        int32_t slot, int32_t producer_op,
        const ColdExprResult *borrow_root,
        ColdExprResult *result_out) {
    /* Plain-payload results (e.g. ByteSpan = Bytes{ptr,len}): the whole
       borrow/owned managed ceremony is spurious for a payload with no
       managed storage anywhere -- the value is tracked manually like every
       other plain value.  The @borrow_result annotation on such a function
       is caller metadata; no managed definition exists to publish. */
    {
        int32_t st = cold_exact_storage_authority_for_slot(
            symbols, body, slot, body->slot_kind[slot]);
        if (st == COLD_MANAGED_STORAGE_UNKNOWN) {
            return;
        }
    }
    int32_t summary =
        cold_body_result_ownership_summary(
            body, symbols);
    if (summary == COLD_RESULT_OWNERSHIP_BORROW_SHARED) {
        if (!borrow_root ||
            borrow_root->value_def_op_id < 0 ||
            !cold_exact_op_tuple_matches_result(
                body, borrow_root) ||
            (borrow_root->ownership !=
                 COLD_EXPR_OWN_BORROW_SHARED &&
             borrow_root->ownership !=
                 COLD_EXPR_OWN_BORROW_UNIQUE &&
             borrow_root->ownership !=
                 COLD_EXPR_OWN_PLAIN)) {
            die("@borrow_result aggregate lacks exact stable borrow root");
        }
        cold_publish_exact_managed_definition(
            body, symbols, slot, SLOT_OBJECT,
            producer_op,
            COLD_EXPR_OWN_BORROW_SHARED,
            result_out);
        body->op_source_value_def_op_id[
            producer_op] =
            borrow_root->value_def_op_id;
        return;
    }
    if (summary != COLD_RESULT_OWNERSHIP_OWNED)
        die("function result ownership summary missing");
    cold_publish_owned_managed_producer(
        body, symbols, slot, SLOT_OBJECT,
        producer_op, result_out);
}

/* Resolve one @borrow_result FORMAL root against one exact call_arg row.
   This body is the pre-mask implementation verbatim; it is the whole of the
   single-root path, so extracting it keeps singleton contracts byte-identical
   while letting a multi-root contract run it once per set member. */
static bool cold_exact_call_arg_carries_managed_storage(
        const BodyIR *body, Symbols *symbols, int32_t row);

static int32_t cold_exact_borrow_result_call_root_for_formal(
        BodyIR *body, Symbols *symbols,
        const FnDef *callee, int32_t call_op,
        int32_t arg_start, int32_t arg_count,
        int32_t index) {
    (void)symbols;
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([ff0]) idx=%d ar=%d gr=%d petid=%d\n",
        index, callee->arity, callee->borrow_result_root_global_row,
        index >= 0 && index < callee->arity
            ? callee->param_exact_type_id[index] : -99);
    if (index < 0 || index >= callee->arity ||
        index >= arg_count ||
        callee->borrow_result_root_global_row != -1 ||
        callee->param_exact_type_id[index] < 0) {
        return -1;
    }
    int32_t call_arg_row = arg_start + index;
    int32_t definition =
        body->call_arg_value_def_op_id[
            call_arg_row];
    int32_t slot =
        body->call_arg_slot[call_arg_row];
    int32_t ownership =
        body->call_arg_ownership[call_arg_row];
    /* Plain-payload formal (e.g. rawbytes.Bytes = ptr+len): there is no
       managed storage to track, so the borrow-result root contract is
       vacuous for it -- the PLAIN-owned definition is the exact root. */
    bool plain_vacuous_root =
        ownership == COLD_EXPR_OWN_PLAIN &&
        !cold_exact_call_arg_carries_managed_storage(
            body, symbols, call_arg_row);
    if (definition < 0 ||
        definition >= call_op ||
        slot < 0 || slot >= body->slot_count ||
        ((ownership !=
             COLD_EXPR_OWN_BORROW_SHARED &&
         ownership !=
             COLD_EXPR_OWN_BORROW_UNIQUE &&
         !plain_vacuous_root &&
         !(ownership == COLD_EXPR_OWN_PLAIN &&
           body->op_value_def_place_kind[definition] ==
               COLD_EXPR_PLACE_PARAM))) ||
        body->op_value_def_slot[definition] !=
            slot ||
        body->op_value_def_exact_type_id[
            definition] !=
            callee->param_exact_type_id[index] ||
        body->op_value_def_producer_function_row[
            definition] !=
            body->producer_function_row ||
        body->op_value_def_place_kind[
            definition] !=
            body->call_arg_place_kind[
                call_arg_row] ||
        body->op_value_def_ownership[
            definition] != ownership ||
        body->op_value_def_origin_id[
            definition] !=
            body->call_arg_origin_id[
                call_arg_row] ||
        !cold_exact_definition_reaches_consumer(
            body, definition, call_op)) {
    {
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([ff]) def=%d slot=%d own=%d plk=%d caplk=%d etid=%d petid=%d pfrow=%d bfrow=%d org=%d cargorg=%d reaches=%d ar=%d\n",
        definition, slot, ownership,
        body->op_value_def_place_kind[definition],
        body->call_arg_place_kind[call_arg_row],
        body->op_value_def_exact_type_id[definition],
        callee->param_exact_type_id[index],
        body->op_value_def_producer_function_row[definition],
        body->producer_function_row,
        body->op_value_def_origin_id[definition],
        body->call_arg_origin_id[call_arg_row],
        cold_exact_definition_reaches_consumer(
            body, definition, call_op),
        call_arg_row);
    }
        return -1;
    }
    return definition;
}

static int32_t cold_exact_borrow_result_call_root(
        BodyIR *body, Symbols *symbols,
        const FnDef *callee, int32_t call_op) {
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([crx]) row=%d kind=%d sum=%d rk=%d idx=%d mask=%d ar=%d\n",
        body->op_a[call_op], body->op_kind[call_op],
        callee ? callee->result_ownership_summary : -1,
        callee ? callee->borrow_result_root_kind : -1,
        callee ? callee->borrow_result_root_formal_index : -1,
        callee ? callee->borrow_result_root_formal_mask : -1,
        callee ? callee->arity : -1);
    if (!body || !symbols || !callee ||
        call_op < 0 || call_op >= body->op_count ||
        (body->op_kind[call_op] != BODY_OP_CALL_I32 &&
         body->op_kind[call_op] != BODY_OP_CALL_COMPOSITE &&
         body->op_kind[call_op] != BODY_OP_CALL_PTR) ||
        callee->result_ownership_summary !=
            COLD_RESULT_OWNERSHIP_BORROW_SHARED) {
        return -1;
    }
    int32_t callee_row = -1;
    for (int32_t row = 0;
         row < symbols->function_count; row++) {
        if (&symbols->functions[row] == callee) {
            callee_row = row;
            break;
        }
    }
    int32_t arg_start = body->op_b[call_op];
    int32_t arg_count =
        body->op_kind[call_op] ==
                BODY_OP_CALL_COMPOSITE
            ? body->op_c[call_op]
            : callee->arity;
    if (callee_row < 0 ||
        body->op_a[call_op] != callee_row ||
        arg_start < 0 || arg_count < 0 ||
        arg_start > body->call_arg_count ||
        arg_count > body->call_arg_count - arg_start ||
        callee->return_exact_type_id < 0 ||
        body->op_dst[call_op] < 0 ||
        body->op_dst[call_op] >= body->slot_count ||
        cold_exact_managed_type_id(
            symbols, body, body->op_dst[call_op],
            body->slot_kind[
                body->op_dst[call_op]]) !=
            callee->return_exact_type_id) {
    {
        if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([cr2]) crow=%d a=%d as=%d ac=%d cac=%d ret=%d dst=%d sk=%d mtid=%d\n",
            callee_row, body->op_a[call_op], arg_start, arg_count,
            body->call_arg_count, callee->return_exact_type_id,
            body->op_dst[call_op],
            body->slot_kind[body->op_dst[call_op]],
            cold_exact_managed_type_id(symbols, body,
                body->op_dst[call_op],
                body->slot_kind[body->op_dst[call_op]]));
    }
        return -1;
    }
    if (callee->borrow_result_root_kind ==
            COLD_BORROW_RESULT_ROOT_FORMAL) {
        int32_t index =
            callee->borrow_result_root_formal_index;
        int32_t mask =
            callee->borrow_result_root_formal_mask;
        int32_t singleton =
            index >= 0 && index < 32
                ? (int32_t)(1u << index)
                : 0;
        /* Singleton (and any contract sealed without a mask) takes exactly the
           pre-existing path and returns exactly the pre-existing definition --
           see cold_exact_borrow_result_call_root_for_formal, which is the old
           body verbatim. Only a genuine multi-root contract reaches the loop
           below, so single-root behaviour is unchanged by construction. */
        if (mask == 0 || mask == singleton) {
            return cold_exact_borrow_result_call_root_for_formal(
                body, symbols, callee, call_op,
                arg_start, arg_count, index);
        }
        if (callee->borrow_result_root_global_row != -1)
            return -1;
        /* Multi-root: the result may alias any member of the set, so every
           member must resolve to a proven borrowed argument at this call, and
           they must all bottom out at ONE canonical root. That common root is
           what bounds the result's lifetime; if the members root at different
           storage the caller cannot name a single owner and we refuse. */
        int32_t common_root = -1;
        for (int32_t formal = 0; formal < 32; formal++) {
            if (!(mask & (int32_t)(1u << formal))) continue;
            int32_t member =
                cold_exact_borrow_result_call_root_for_formal(
                    body, symbols, callee, call_op,
                    arg_start, arg_count, formal);
            if (member < 0) return -1;
            int32_t canonical =
                cold_borrow_result_canonical_root_definition(
                    body, symbols, member, 0);
            if (canonical < 0) return -1;
            if (common_root < 0) common_root = canonical;
            else if (common_root != canonical) return -1;
        }
        if (common_root < 0 ||
            !cold_exact_definition_reaches_consumer(
                body, common_root, call_op)) {
            return -1;
        }
        return common_root;
    }
    if (callee->borrow_result_root_kind ==
            COLD_BORROW_RESULT_ROOT_GLOBAL) {
        int32_t global_row =
            callee->borrow_result_root_global_row;
        if (callee->borrow_result_root_formal_index != -1 ||
            global_row < 0 ||
            global_row >= symbols->global_count) {
            return -1;
        }
        int32_t definition = -1;
        for (int32_t op = 0; op < call_op; op++) {
            if (body->op_value_def_place_kind[op] !=
                    COLD_EXPR_PLACE_GLOBAL ||
                body->op_value_def_origin_id[op] !=
                    global_row ||
                body->op_value_def_ownership[op] !=
                    COLD_EXPR_OWN_BORROW_SHARED ||
                !cold_exact_definition_reaches_consumer(
                    body, op, call_op)) {
                continue;
            }
            if (definition >= 0) return -1;
            definition = op;
        }
        return definition;
    }
    return -1;
}

static void cold_managed_call_result(BodyIR *body, Symbols *symbols,
                                     const FnDef *callee,
                                     int32_t slot, int32_t kind, int32_t call_op,
                                     ColdExprResult *result_out) {
    cold_expr_result_reset(result_out);
    if (!body || call_op < 0 || call_op >= body->op_count ||
        slot < 0 || slot >= body->slot_count ||
        body->op_dst[call_op] != slot) {
        return;
    }
    int32_t storage =
        cold_exact_storage_authority_for_slot(
            symbols, body, slot, kind);
    if (storage == COLD_MANAGED_STORAGE_UNKNOWN)
        storage = cold_managed_storage_kind_for_slot_kind(kind);
    if (storage == COLD_MANAGED_STORAGE_UNKNOWN)
        return;
    /* A resource-free nominal object still needs one exact value definition
       for local binding and CFG joins.  Its PLAIN storage authority makes the
       canonical publisher emit no retain/release/drop.  PLAIN is an ORC
       fact, not a provenance fact: when the callee is @borrow_result with a
       dynamic root, the result is a view whose lifetime that root bounds,
       and a caller that re-aggregates fields of this result into its own
       borrowed return aggregate can only prove its root if this definition
       keeps the borrow edge.  STATIC contracts proved there is no dynamic
       root; those keep the owned-plain publish. */
    if (storage == COLD_MANAGED_STORAGE_PLAIN) {
        if (callee &&
            callee->result_ownership_summary ==
                COLD_RESULT_OWNERSHIP_BORROW_SHARED &&
            callee->borrow_result_root_kind !=
                COLD_BORROW_RESULT_ROOT_STATIC) {
            int32_t borrow_root =
                cold_exact_borrow_result_call_root(
                    body, symbols, callee, call_op);
            if (borrow_root < 0 &&
                !ColdBorrowResultContractProbe) {
                die("@borrow_result call lacks exact borrowed argument root");
            }
            cold_publish_exact_managed_definition(
                body, symbols, slot, kind, call_op,
                COLD_EXPR_OWN_BORROW_SHARED, result_out);
            if (borrow_root >= 0) {
                body->op_source_value_def_op_id[
                    call_op] = borrow_root;
            }
            return;
        }
        /* A PLAIN storage obligation means ORC has no retain/release work;
           it does not make an address-bearing aggregate independently
           copyable.  An owned call result such as rawbytes.Bytes must still
           cross the caller as one exact MOVE definition so later binding and
           free operations cannot duplicate its pointer payload. */
        if (callee &&
            callee->result_ownership_summary ==
                COLD_RESULT_OWNERSHIP_OWNED &&
            !cold_plain_value_copy_is_independent(
                symbols, body, slot, kind)) {
            cold_publish_exact_managed_definition(
                body, symbols, slot, kind, call_op,
                COLD_EXPR_OWN_MOVE, result_out);
            return;
        }
        cold_publish_owned_managed_producer(
            body, symbols, slot, kind, call_op, result_out);
        return;
    }
    if (kind == SLOT_PTR ||
        cold_managed_storage_kind_for_slot_kind(kind) ==
            COLD_MANAGED_STORAGE_UNKNOWN) {
        Span type = span_trim(cold_type_strip_var(
            body->slot_type[slot], 0));
        ObjectDef *object =
            symbols && type.len > 0
                ? symbols_resolve_object(symbols, type)
                : 0;
        if ((kind != SLOT_OBJECT_REF && kind != SLOT_PTR) ||
            !object || !object->is_ref ||
            body->slot_size[slot] != 8) {
            return;
        }
    }
    if (!callee ||
        callee->result_ownership_summary ==
            COLD_RESULT_OWNERSHIP_UNKNOWN) {
        die("managed call target result ownership summary missing");
    }
    if (callee->result_ownership_summary ==
            COLD_RESULT_OWNERSHIP_BORROW_SHARED &&
        callee->borrow_result_root_kind ==
            COLD_BORROW_RESULT_ROOT_STATIC) {
        /* Vacuously discharged contract (see
           cold_seal_borrow_result_static_contract): the callee proved no
           dynamic root because its return payload carries no managed storage.
           Reaching here means this call site does treat the result as managed
           storage, so callee and caller disagree about the payload -- report
           that directly instead of inventing a root or an ownership. */
        die("@borrow_result callee has no dynamic root for a managed call result");
    }
    if (callee->result_ownership_summary ==
            COLD_RESULT_OWNERSHIP_BORROW_SHARED) {
        int32_t borrow_root =
            cold_exact_borrow_result_call_root(
                body, symbols, callee, call_op);
        if (borrow_root < 0 &&
            ColdBorrowResultContractProbe) {
            cold_publish_exact_managed_definition(
                body, symbols, slot, kind, call_op,
                COLD_EXPR_OWN_BORROW_SHARED,
                result_out);
            return;
        }
        if (borrow_root < 0) {
            int32_t arg_start = body->op_b[call_op];
            int32_t arg_count =
                body->op_kind[call_op] ==
                        BODY_OP_CALL_COMPOSITE
                    ? body->op_c[call_op]
                    : callee->arity;
            fprintf(
                stderr,
                "cheng_cold: @borrow_result call root"
                " caller=%.*s callee=%.*s call=%d"
                " args=%d:%d borrows=%d\n",
                (int)body->debug_name.len,
                body->debug_name.ptr
                    ? body->debug_name.ptr
                    : (const uint8_t *)"",
                (int)callee->name.len,
                callee->name.ptr
                    ? callee->name.ptr
                    : (const uint8_t *)"",
                call_op, arg_start, arg_count,
                callee->borrows_args ? 1 : 0);
            for (int32_t index = 0;
                 index < arg_count &&
                 index < callee->arity;
                 index++) {
                int32_t row = arg_start + index;
                fprintf(
                    stderr,
                    "cheng_cold: @borrow_result call arg"
                    " formal=%d type=%d slot=%d def=%d"
                    " place=%d ownership=%d origin=%d\n",
                    index,
                    callee->param_exact_type_id[index],
                    row >= 0 &&
                            row < body->call_arg_count
                        ? body->call_arg_slot[row] : -1,
                    row >= 0 &&
                            row < body->call_arg_count
                        ? body->call_arg_value_def_op_id[row] : -1,
                    row >= 0 &&
                            row < body->call_arg_count
                        ? body->call_arg_place_kind[row]
                        : COLD_EXPR_PLACE_INVALID,
                    row >= 0 &&
                            row < body->call_arg_count
                        ? body->call_arg_ownership[row]
                        : COLD_EXPR_OWN_INVALID,
                    row >= 0 &&
                            row < body->call_arg_count
                        ? body->call_arg_origin_id[row] : -1);
            }
            die("@borrow_result call lacks exact borrowed argument root");
        }
        cold_publish_exact_managed_definition(
            body, symbols, slot, kind, call_op,
            COLD_EXPR_OWN_BORROW_SHARED, result_out);
        body->op_source_value_def_op_id[
            call_op] = borrow_root;
        return;
    }
    if (callee->result_ownership_summary !=
            COLD_RESULT_OWNERSHIP_OWNED) {
        die("managed call target result ownership summary invalid");
    }
    cold_publish_owned_managed_producer(
        body, symbols, slot, kind, call_op, result_out);
}

static void cold_publish_owned_managed_producer(
        BodyIR *body, Symbols *symbols, int32_t slot, int32_t kind,
        int32_t producer_op, ColdExprResult *result_out) {
    if (!body || slot < 0 || slot >= body->slot_count ||
        producer_op < 0 || producer_op >= body->op_count ||
        body->op_dst[producer_op] != slot ||
        body->slot_kind[slot] != kind ||
        cold_exact_storage_authority_for_slot(
            symbols, body, slot, kind) ==
            COLD_MANAGED_STORAGE_UNKNOWN ||
        !cold_exact_op_tuple_is_sentinel(body, producer_op)) {
        bool have_body = body != NULL;
        bool slot_ok =
            have_body && slot >= 0 && slot < body->slot_count;
        bool op_ok =
            have_body && producer_op >= 0 &&
            producer_op < body->op_count;
        fprintf(
            stderr,
            "cheng_cold: managed producer authority missing"
            " function=%.*s slot=%d kind=%d slot_kind=%d"
            " slot_type=%.*s slot_size=%d producer_op=%d"
            " op_count=%d op_kind=%d op_dst=%d op_a=%d"
            " storage_for_kind=%d tuple_sentinel=%d"
            " def_slot=%d def_type=%d def_row=%d def_place=%d"
            " def_own=%d def_origin=%d def_consume=%d"
            " def_source=%d\n",
            have_body ? (int)body->debug_name.len : 0,
            (have_body && body->debug_name.ptr)
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            slot, kind,
            slot_ok ? body->slot_kind[slot] : -1,
            slot_ok ? (int)body->slot_type[slot].len : 0,
            (slot_ok && body->slot_type[slot].ptr)
                ? body->slot_type[slot].ptr
                : (const uint8_t *)"",
            slot_ok ? body->slot_size[slot] : -1,
            producer_op,
            have_body ? body->op_count : -1,
            op_ok ? body->op_kind[producer_op] : -1,
            op_ok ? body->op_dst[producer_op] : -1,
            op_ok ? body->op_a[producer_op] : -1,
            cold_managed_storage_kind_for_slot_kind(kind),
            (op_ok &&
             cold_exact_op_tuple_is_sentinel(body, producer_op))
                ? 1
                : 0,
            op_ok ? body->op_value_def_slot[producer_op] : -1,
            op_ok ? body->op_value_def_exact_type_id[producer_op] : -1,
            op_ok
                ? body->op_value_def_producer_function_row[producer_op]
                : -1,
            op_ok ? body->op_value_def_place_kind[producer_op] : -1,
            op_ok ? body->op_value_def_ownership[producer_op] : -1,
            op_ok ? body->op_value_def_origin_id[producer_op] : -1,
            op_ok
                ? body->op_value_def_consume_op_index_plus_one[producer_op]
                : -1,
            op_ok ? body->op_source_value_def_op_id[producer_op] : -1);
        die("managed producer lacks exact result authority");
    }
    int32_t storage = cold_exact_managed_storage_for_slot(
        symbols, body, slot, kind);
    if (storage == COLD_MANAGED_STORAGE_UNKNOWN ||
        storage == COLD_MANAGED_STORAGE_PLAIN) {
        int32_t exact_type_id =
            cold_exact_managed_type_id(
                symbols, body, slot, kind);
        int32_t storage_authority =
            cold_exact_storage_authority_for_slot(
                symbols, body, slot, kind);
        bool exact_neutral_plain_producer =
            (kind == SLOT_OBJECT || kind == SLOT_ARRAY_I32) &&
            cold_exact_borrow_result_neutral_producer_valid(
                body, symbols, slot, producer_op,
                -1, 0);
        bool independent_plain_copy =
            cold_plain_value_copy_is_independent(
                symbols, body, slot, kind);
        /* A byte copy of an exact owned plain source and an OWNED call
           result are both well-defined plain values: neither is arbitrary
           uninitialized storage.  Return copies of address-bearing POD
           aggregates (`return slot` of a struct with Bytes fields) and
           calls returning such aggregates publish PLAIN authority through
           these lanes instead of demanding the zero-fill neutrality that
           only var-initializers carry. */
        bool exact_plain_copy_producer = false;
        if ((kind == SLOT_OBJECT || kind == SLOT_ARRAY_I32) &&
            body->op_kind[producer_op] == BODY_OP_COPY_COMPOSITE) {
            int32_t copy_source =
                body->op_source_value_def_op_id[producer_op];
            if (copy_source >= 0 && copy_source < producer_op) {
                int32_t copy_source_slot =
                    body->op_value_def_slot[copy_source];
                ColdExprResult copy_source_result;
                cold_expr_result_reset(&copy_source_result);
                exact_plain_copy_producer =
                    copy_source_slot >= 0 &&
                    copy_source_slot < body->slot_count &&
                    body->slot_kind[copy_source_slot] == kind &&
                    cold_exact_result_from_definition(
                        body, copy_source_slot, copy_source,
                        &copy_source_result) &&
                    (copy_source_result.ownership ==
                         COLD_EXPR_OWN_PLAIN ||
                     copy_source_result.ownership ==
                         COLD_EXPR_OWN_MOVE) &&
                    cold_exact_definition_is_live_before_op(
                        body, copy_source, producer_op);
            }
        }
        bool plain_call_result_type = false;
        if ((kind == SLOT_OBJECT || kind == SLOT_ARRAY_I32) &&
            body->op_kind[producer_op] == BODY_OP_CALL_COMPOSITE &&
            body->op_a[producer_op] >= 0 &&
            body->op_a[producer_op] < symbols->function_count &&
            symbols->functions[body->op_a[producer_op]].
                    return_exact_type_id >= 0) {
            int32_t rt_domain =
                symbols->functions[body->op_a[producer_op]].
                    return_exact_type_id / 1048576;
            int32_t rt_row =
                symbols->functions[body->op_a[producer_op]].
                    return_exact_type_id % 1048576 - 1;
            if ((rt_domain == SLOT_OBJECT ||
                 rt_domain == SLOT_OBJECT_REF) &&
                rt_row >= 0 && rt_row < symbols->object_count) {
                int32_t rt_storage = COLD_MANAGED_STORAGE_UNKNOWN;
                if (cold_exact_object_storage_obligation_readonly(
                        symbols, &symbols->objects[rt_row], 0,
                        &rt_storage))
                    plain_call_result_type =
                        rt_storage == COLD_MANAGED_STORAGE_PLAIN;
            }
        }
        bool exact_plain_call_producer =
            (kind == SLOT_OBJECT || kind == SLOT_ARRAY_I32) &&
            body->op_kind[producer_op] == BODY_OP_CALL_COMPOSITE &&
            body->op_a[producer_op] >= 0 &&
            body->op_a[producer_op] < symbols->function_count &&
            (symbols->functions[body->op_a[producer_op]].
                    result_ownership_summary ==
                COLD_RESULT_OWNERSHIP_OWNED ||
             plain_call_result_type);
        /* A field-bound constructor of a resource-free nominal aggregate is
           an exact plain value: every payload edge was proven owned/exact
           by the canonical object-constructor tuple validator. */
        bool exact_plain_constructor_producer =
            kind == SLOT_OBJECT &&
            body->op_kind[producer_op] == BODY_OP_MAKE_COMPOSITE &&
            body->op_a[producer_op] == 0 &&
            cold_exact_object_constructor_tuple_valid(
                body, symbols, producer_op);
        /* An indexed read of a PLAIN element out of an identity-less fixed
           array base (obj.items[idx] whose FIELD_REF carries no TypeId)
           byte-copies the complete element value into a fresh slot: an exact
           independent temporary, exactly like the COPY_COMPOSITE plain lane.
           Managed (ORC) elements never reach this lane: their storage
           authority is not PLAIN, so plain_authority_invalid still rejects
           them. */
        bool exact_plain_index_read_producer =
            (kind == SLOT_OBJECT || kind == SLOT_ARRAY_I32) &&
            (body->op_kind[producer_op] ==
                 BODY_OP_ARRAY_OPAQUE_INDEX_DYNAMIC ||
             body->op_kind[producer_op] ==
                 BODY_OP_PAYLOAD_LOAD);
        bool plain_slot_claimable =
            cold_exact_slot_authority_is_sentinel(body, slot) ||
            /* The canonical scalar-projection publisher may have landed
               the nominal PLAIN storage authority eagerly.  That is a
               storage-lane classification only: while no exact TypeId,
               place binding, or origin has been claimed, this publisher
               still owns the value-definition claim. */
            (body->slot_exact_type_id[slot] < 0 &&
             body->slot_place_kind[slot] ==
                 COLD_EXPR_PLACE_INVALID &&
             body->slot_origin_id[slot] < 0 &&
             body->slot_managed_storage_kind[slot] ==
                 COLD_MANAGED_STORAGE_PLAIN);
        bool plain_authority_invalid =
            (kind != SLOT_OBJECT && kind != SLOT_ARRAY_I32) ||
            exact_type_id < 0 ||
            storage_authority != COLD_MANAGED_STORAGE_PLAIN ||
            (!independent_plain_copy &&
             !exact_neutral_plain_producer &&
             !exact_plain_copy_producer &&
             !exact_plain_call_producer &&
             !exact_plain_constructor_producer &&
             !exact_plain_index_read_producer) ||
            body->producer_function_row < 0 ||
            !plain_slot_claimable;
        if (plain_authority_invalid) {
            fprintf(stderr, "plainprobe body=%.*s pop=%d pk=%d k=%d etid=%d st=%d sz=%d et=%d pl=%d og=%d smg=%d\n",
                (int)body->debug_name.len,
                body->debug_name.ptr ? (const char*)body->debug_name.ptr : "",
                producer_op, body->op_kind[producer_op], kind,
                exact_type_id, storage_authority,
                slot >= 0 ? body->slot_size[slot] : -9,
                slot >= 0 ? body->slot_exact_type_id[slot] : -9,
                slot >= 0 ? body->slot_place_kind[slot] : -9,
                slot >= 0 ? body->slot_origin_id[slot] : -9,
                slot >= 0 ? body->slot_managed_storage_kind[slot] : -9);
            die("plain object producer lacks exact result authority");
        }
        body->op_value_def_slot[producer_op] = slot;
        body->op_value_def_exact_type_id[producer_op] =
            exact_type_id;
        body->op_value_def_producer_function_row[producer_op] =
            body->producer_function_row;
        body->op_value_def_place_kind[producer_op] =
            COLD_EXPR_PLACE_TEMPORARY;
        body->op_value_def_ownership[producer_op] =
            COLD_EXPR_OWN_PLAIN;
        body->op_value_def_origin_id[producer_op] =
            producer_op;
        body->slot_exact_type_id[slot] = exact_type_id;
        body->slot_place_kind[slot] =
            COLD_EXPR_PLACE_TEMPORARY;
        body->slot_origin_id[slot] = producer_op;
        /* UNKNOWN means the producer did not classify the slot; PLAIN means
           the exact nominal object was classified and requires no
           retain/release/drop.  Keep managed-drop decisions on
           cold_exact_managed_storage_for_slot so PLAIN never acquires ORC
           behavior. */
        body->slot_managed_storage_kind[slot] = storage_authority;
        ColdExprResult result;
        cold_expr_result_reset(&result);
        result.slot = slot;
        result.kind = kind;
        result.value_def_op_id = producer_op;
        result.exact_type_id = exact_type_id;
        result.producer_function_row =
            body->producer_function_row;
        result.place_kind = COLD_EXPR_PLACE_TEMPORARY;
        result.ownership = COLD_EXPR_OWN_PLAIN;
        result.origin_id = producer_op;
        if (result_out) *result_out = result;
        cold_expr_result_publish(body, &result);
        return;
    }
    cold_publish_exact_managed_definition(
        body, symbols, slot, kind, producer_op, COLD_EXPR_OWN_MOVE,
        result_out);
}

/* An empty `[]` literal must be published as soon as it is parsed, but at that
   point its only possible element type is the provisional int32[] the literal
   parser mints.  When a contextualizer later retypes the slot to the target's
   exact sequence type, that first definition describes a type the slot no
   longer has, so it is withdrawn here and re-derived by a full publication.
   Only a temporary this parser defined on exactly this (slot, op) pair and
   that nothing has consumed yet may be withdrawn -- anything else means a
   downstream consumer already depends on the definition. */
static void cold_revoke_exact_managed_producer(
        BodyIR *body, int32_t slot, int32_t producer_op) {
    if (!body || slot < 0 || slot >= body->slot_count ||
        producer_op < 0 || producer_op >= body->op_count ||
        body->op_dst[producer_op] != slot ||
        body->op_value_def_slot[producer_op] != slot ||
        body->op_value_def_place_kind[producer_op] !=
            COLD_EXPR_PLACE_TEMPORARY ||
        body->op_value_def_origin_id[producer_op] != producer_op ||
        body->op_value_def_consume_op_index_plus_one[producer_op] != 0 ||
        body->op_source_value_def_op_id[producer_op] != -1 ||
        body->slot_place_kind[slot] != COLD_EXPR_PLACE_TEMPORARY ||
        body->slot_origin_id[slot] != producer_op) {
        fprintf(
            stderr,
            "cheng_cold: managed producer revocation target mismatch"
            " function=%.*s slot=%d producer_op=%d op_count=%d"
            " op_dst=%d def_slot=%d def_place=%d def_origin=%d"
            " def_consume=%d def_source=%d slot_place=%d"
            " slot_origin=%d\n",
            body ? (int)body->debug_name.len : 0,
            (body && body->debug_name.ptr)
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            slot, producer_op, body ? body->op_count : -1,
            (body && producer_op >= 0 && producer_op < body->op_count)
                ? body->op_dst[producer_op]
                : -1,
            (body && producer_op >= 0 && producer_op < body->op_count)
                ? body->op_value_def_slot[producer_op]
                : -1,
            (body && producer_op >= 0 && producer_op < body->op_count)
                ? body->op_value_def_place_kind[producer_op]
                : -1,
            (body && producer_op >= 0 && producer_op < body->op_count)
                ? body->op_value_def_origin_id[producer_op]
                : -1,
            (body && producer_op >= 0 && producer_op < body->op_count)
                ? body->op_value_def_consume_op_index_plus_one[producer_op]
                : -1,
            (body && producer_op >= 0 && producer_op < body->op_count)
                ? body->op_source_value_def_op_id[producer_op]
                : -1,
            (body && slot >= 0 && slot < body->slot_count)
                ? body->slot_place_kind[slot]
                : -1,
            (body && slot >= 0 && slot < body->slot_count)
                ? body->slot_origin_id[slot]
                : -1);
        die("managed producer revocation target is not its own definition");
    }
    body->op_value_def_slot[producer_op] = -1;
    body->op_value_def_exact_type_id[producer_op] = -1;
    body->op_value_def_producer_function_row[producer_op] = -1;
    body->op_value_def_place_kind[producer_op] = COLD_EXPR_PLACE_INVALID;
    body->op_value_def_ownership[producer_op] = COLD_EXPR_OWN_INVALID;
    body->op_value_def_origin_id[producer_op] = -1;
    body->slot_exact_type_id[slot] = -1;
    body->slot_place_kind[slot] = COLD_EXPR_PLACE_INVALID;
    body->slot_origin_id[slot] = -1;
    body->slot_managed_storage_kind[slot] = COLD_MANAGED_STORAGE_UNKNOWN;
}

static void cold_publish_plain_string_literal_producer(
        BodyIR *body, int32_t slot, int32_t producer_op,
        ColdExprResult *result_out) {
    int32_t exact_type_id =
        cold_exact_managed_type_id(0, body, slot, SLOT_STR);
    if (!body || slot < 0 || slot >= body->slot_count ||
        producer_op < 0 || producer_op >= body->op_count ||
        body->op_kind[producer_op] != BODY_OP_STR_LITERAL ||
        body->op_dst[producer_op] != slot ||
        body->op_a[producer_op] < 0 ||
        body->op_a[producer_op] >= body->string_literal_count ||
        body->slot_kind[slot] != SLOT_STR ||
        body->slot_size[slot] != COLD_STR_SLOT_SIZE ||
        body->producer_function_row < 0 ||
        exact_type_id < 0 ||
        !cold_exact_op_tuple_is_sentinel(body, producer_op) ||
        body->slot_place_kind[slot] != COLD_EXPR_PLACE_INVALID ||
        body->slot_origin_id[slot] != -1 ||
        (body->slot_managed_storage_kind[slot] !=
             COLD_MANAGED_STORAGE_UNKNOWN &&
         body->slot_managed_storage_kind[slot] !=
             COLD_MANAGED_STORAGE_STR)) {
        die("string literal lacks exact producer authority");
    }
    body->op_value_def_slot[producer_op] = slot;
    body->op_value_def_exact_type_id[producer_op] = exact_type_id;
    body->op_value_def_producer_function_row[producer_op] =
        body->producer_function_row;
    body->op_value_def_place_kind[producer_op] =
        COLD_EXPR_PLACE_STACK_LOCAL;
    body->op_value_def_ownership[producer_op] = COLD_EXPR_OWN_PLAIN;
    body->op_value_def_origin_id[producer_op] = slot;
    body->slot_place_kind[slot] = COLD_EXPR_PLACE_STACK_LOCAL;
    body->slot_exact_type_id[slot] = exact_type_id;
    body->slot_origin_id[slot] = slot;
    body->slot_managed_storage_kind[slot] = COLD_MANAGED_STORAGE_STR;
    ColdExprResult result;
    cold_expr_result_reset(&result);
    result.slot = slot;
    result.kind = SLOT_STR;
    result.value_def_op_id = producer_op;
    result.exact_type_id = exact_type_id;
    result.producer_function_row = body->producer_function_row;
    result.place_kind = COLD_EXPR_PLACE_STACK_LOCAL;
    result.ownership = COLD_EXPR_OWN_PLAIN;
    result.origin_id = slot;
    if (result_out) *result_out = result;
    cold_expr_result_publish(body, &result);
}

static bool cold_managed_or_borrowed_kind(int32_t kind) {
    return cold_managed_storage_kind_for_slot_kind(kind) !=
               COLD_MANAGED_STORAGE_UNKNOWN ||
           kind == SLOT_STR_REF || kind == SLOT_OBJECT_REF ||
           kind == SLOT_SEQ_I32_REF || kind == SLOT_SEQ_STR_REF ||
           kind == SLOT_SEQ_OPAQUE_REF;
}

static void cold_publish_local_expr_result(BodyIR *body, const Local *local,
                                           int32_t slot, int32_t kind) {
    if (!body || !local || local->is_global ||
        slot != local->slot || kind != local->kind) {
        return;
    }
    if (local->value_def_op_id < 0 &&
        cold_exact_managed_storage_kind_for_slot_kind(kind) ==
            COLD_MANAGED_STORAGE_UNKNOWN &&
        body->slot_managed_storage_kind[slot] == COLD_MANAGED_STORAGE_UNKNOWN) { return;
    }
    ColdExprResult result;
    cold_expr_result_reset(&result);
    result.slot = slot;
    result.kind = kind;
    result.place_kind = COLD_EXPR_PLACE_STACK_LOCAL;
    result.origin_id = slot;
    int32_t def = local->value_def_op_id;
    if (def >= 0) {
        if (def >= body->op_count ||
            body->op_value_def_slot[def] != slot ||
            body->op_value_def_place_kind[def] ==
                COLD_EXPR_PLACE_INVALID ||
            body->op_value_def_ownership[def] ==
                COLD_EXPR_OWN_INVALID) {
            die("local exact value-definition edge is corrupt");
        }
        result.value_def_op_id = def;
        result.exact_type_id =
            body->op_value_def_exact_type_id[def];
        result.producer_function_row =
            body->op_value_def_producer_function_row[def];
        result.place_kind = body->op_value_def_place_kind[def];
        result.ownership = body->op_value_def_ownership[def];
        result.origin_id = body->op_value_def_origin_id[def];
    }
    cold_expr_result_publish(body, &result);
}

static bool cold_exact_definition_is_live_at_current_point(
        const BodyIR *body, int32_t definition,
        int32_t block);
static bool cold_exact_definition_is_live_before_op(
        const BodyIR *body, int32_t definition,
        int32_t consumer);
static bool cold_exact_definition_consumption_dataflow_query(
        const BodyIR *body, int32_t definition,
        int32_t query_block, int32_t query_op_exclusive,
        uint8_t *query_exit_state);
static bool cold_exact_definition_is_current_at_predecessor(
        const BodyIR *body, int32_t definition,
        int32_t predecessor, int32_t merge_op);
static bool cold_exact_op_consumes_definition(
        const BodyIR *body, int32_t definition,
        int32_t consumer);
static bool cold_exact_memory_version_cfg_merge_valid(
        const BodyIR *body, Symbols *symbols,
        int32_t definition);
static bool cold_exact_definition_replace_state_at_current_point(
    const BodyIR *body, int32_t definition,
    int32_t block, bool *old_owner_live);
static void cold_retarget_exact_merge_predecessor(
        BodyIR *body, int32_t merge_block,
        int32_t previous_predecessor, int32_t replacement);
static void cold_body_insert_op_at(
    BodyIR *body, int32_t at);
static void cold_body_insert_op_after_in_block(
    BodyIR *body, int32_t predecessor_op);
static void cold_recompute_exact_op_consume_representative(
    BodyIR *body, int32_t definition);
static int32_t cold_exact_edge_to_block_count(
    const BodyIR *body, int32_t predecessor,
    int32_t target);
static int32_t cold_specialized_cfg_current_definition(
    const BodyIR *body, int32_t slot,
    int32_t block, int32_t boundary_op);
static int32_t cold_emit_exact_managed_param_replace(
    Parser *parser, BodyIR *body, Symbols *symbols,
    Local *target, const ColdExprResult *source,
    Span source_surface);

static int32_t cold_sequence_logical_element_kind(
        Symbols *symbols, Span element_type,
        ObjectDef **object_out);
static int32_t cold_ensure_seq_mutation_drop_helper(
        Parser *parser, Symbols *symbols, int32_t mutation_kind,
        int32_t container_kind, Span sequence_type,
        Span element_type, int32_t element_kind, int32_t element_size,
        ObjectDef *element_object, int32_t declaration_origin_row,
        bool element_borrowed);
static void cold_specialized_rewrite_mutation_to_drop_call(
    Parser *parser, BodyIR *dst, Locals *locals, int32_t oi,
    int32_t helper_row, int32_t op_kind);
static int32_t cold_ensure_managed_var_replace_helper(
    Parser *parser, Symbols *symbols,
    int32_t declaration_origin_row,
    bool source_borrowed);
static void cold_specialized_rewrite_managed_var_stores(
    Parser *parser, BodyIR *body,
    int32_t declaration_origin_row);
static void cold_repair_specialized_mutation_cfg(
    Parser *parser, BodyIR *body);
static ColdExprResult cold_require_opaque_index_store_sequence_authority(
        Parser *parser, BodyIR *body,
        int32_t sequence_slot,
        const ColdExprResult *supplied_authority,
        int32_t consumer_op);

static void cold_rewrite_exact_str_sequence_mutation(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t mutation_op, int32_t sequence_kind) {
    if (!parser || !body ||
        mutation_op < 0 ||
        mutation_op >= body->op_count ||
        (sequence_kind != SLOT_SEQ_STR &&
         sequence_kind != SLOT_SEQ_STR_REF) ||
        body->declaration_origin_row < 0 ||
        body->declaration_origin_row >=
            parser->symbols->declaration_origin_count) {
        die("str sequence mutation lacks exact declaration owner");
    }
    int32_t helper_row =
        cold_ensure_seq_mutation_drop_helper(
            parser, parser->symbols,
            body->op_kind[mutation_op],
            sequence_kind,
            body->slot_type[
                body->op_kind[mutation_op] ==
                        BODY_OP_SEQ_OPAQUE_INDEX_STORE
                    ? body->op_a[mutation_op]
                    : body->op_dst[mutation_op]],
            cold_cstr_span("str"), SLOT_STR,
            COLD_STR_SLOT_SIZE, 0,
            body->declaration_origin_row,
            body->op_kind[mutation_op] ==
                    BODY_OP_SEQ_OPAQUE_INDEX_STORE &&
                body->op_source_value_def_op_id[mutation_op] >= 0 &&
                body->op_source_value_def_op_id[mutation_op] <
                    body->op_count &&
                (body->op_value_def_ownership[
                     body->op_source_value_def_op_id[mutation_op]] ==
                     COLD_EXPR_OWN_BORROW_SHARED ||
                 body->op_value_def_ownership[
                     body->op_source_value_def_op_id[mutation_op]] ==
                     COLD_EXPR_OWN_BORROW_UNIQUE));
    cold_specialized_rewrite_mutation_to_drop_call(
        parser, body, locals, mutation_op, helper_row,
        body->op_kind[mutation_op]);
}

/* Object-element analogue of cold_rewrite_exact_str_sequence_mutation:
   route a managed object-element raw mutation emitted in a non-generic
   body through the same per-(mutation, element) drop helper so the raw
   op only ever lives inside its exact compiler helper owner. */
static void cold_rewrite_exact_object_sequence_mutation(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t mutation_op, int32_t sequence_kind,
        Span element_type, int32_t element_kind,
        int32_t element_size, ObjectDef *element_object) {
    if (!parser || !body ||
        mutation_op < 0 ||
        mutation_op >= body->op_count ||
        (sequence_kind != SLOT_SEQ_OPAQUE &&
         sequence_kind != SLOT_SEQ_OPAQUE_REF) ||
        !element_object ||
        element_type.len <= 0 || element_size <= 0) {
        die("object sequence mutation lacks exact declaration owner");
    }
    int32_t origin_row = body->declaration_origin_row;
    if (element_object->declaration_origin_row >= 0) {
        origin_row = element_object->declaration_origin_row;
    }
    if (origin_row < 0 ||
        origin_row >= parser->symbols->declaration_origin_count) {
        die("object sequence mutation lacks exact declaration owner");
    }
    int32_t helper_row =
        cold_ensure_seq_mutation_drop_helper(
            parser, parser->symbols,
            body->op_kind[mutation_op],
            sequence_kind,
            body->slot_type[
                body->op_kind[mutation_op] ==
                        BODY_OP_SEQ_OPAQUE_INDEX_STORE
                    ? body->op_a[mutation_op]
                    : body->op_dst[mutation_op]],
            element_type, element_kind, element_size,
            element_object, origin_row,
            body->op_kind[mutation_op] ==
                    BODY_OP_SEQ_OPAQUE_INDEX_STORE &&
                body->op_source_value_def_op_id[mutation_op] >= 0 &&
                body->op_source_value_def_op_id[mutation_op] <
                    body->op_count &&
                (body->op_value_def_ownership[
                     body->op_source_value_def_op_id[mutation_op]] ==
                     COLD_EXPR_OWN_BORROW_SHARED ||
                 body->op_value_def_ownership[
                     body->op_source_value_def_op_id[mutation_op]] ==
                     COLD_EXPR_OWN_BORROW_UNIQUE));
    cold_specialized_rewrite_mutation_to_drop_call(
        parser, body, locals, mutation_op, helper_row,
        body->op_kind[mutation_op]);
}

/* Opaque-slot mutations store the canonical ELEMENT type in slot_type
   (`str[]` for a `str[][]` container).  The str-container rewrite only
   accepts SEQ_STR; the object rewrite requires an ObjectDef.  Route
   remaining managed elements through the same per-(mutation, element)
   drop helper so the raw op only lives inside its compiler owner. */
static void cold_rewrite_exact_opaque_mutation_if_managed(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t mutation_op, int32_t sequence_kind, int32_t seq_slot,
        int32_t element_size) {
    if (!parser || !body ||
        mutation_op < 0 || mutation_op >= body->op_count ||
        seq_slot < 0 || seq_slot >= body->slot_count ||
        (sequence_kind != SLOT_SEQ_OPAQUE &&
         sequence_kind != SLOT_SEQ_OPAQUE_REF)) {
        return;
    }
    int32_t mutation_kind = body->op_kind[mutation_op];
    if (mutation_kind != BODY_OP_SEQ_SET_LEN &&
        mutation_kind != BODY_OP_SEQ_OPAQUE_INDEX_STORE &&
        mutation_kind != BODY_OP_SEQ_OPAQUE_REMOVE) {
        return;
    }
    int32_t mutation_seq =
        mutation_kind == BODY_OP_SEQ_OPAQUE_INDEX_STORE
            ? body->op_a[mutation_op]
            : body->op_dst[mutation_op];
    if (mutation_seq != seq_slot) return;
    /* slot_type now keeps the full spelling for nested sequences: extract
       the element with the single-strip helper (flat text is unchanged). */
    Span element_type = cold_seq_opaque_element_type(
        body->slot_type[seq_slot]);
    element_type = span_trim(cold_type_strip_var(element_type, 0));
    if (element_type.len <= 0) return;
    ObjectDef *element_object = 0;
    int32_t element_kind = cold_sequence_logical_element_kind(
        parser->symbols, element_type, &element_object);
    if (element_object &&
        cold_exact_object_storage_from_definition(
            parser->symbols, element_object, 0) ==
            COLD_MANAGED_STORAGE_OBJECT) {
        cold_rewrite_exact_object_sequence_mutation(
            parser, body, locals, mutation_op, sequence_kind,
            element_type, element_kind, element_size,
            element_object);
        return;
    }
    bool str_element =
        element_kind == SLOT_STR || span_eq(element_type, "str");
    bool seq_element =
        element_kind == SLOT_SEQ_STR ||
        element_kind == SLOT_SEQ_STR_REF ||
        element_kind == SLOT_SEQ_I32 ||
        element_kind == SLOT_SEQ_I32_REF ||
        element_kind == SLOT_SEQ_OPAQUE ||
        element_kind == SLOT_SEQ_OPAQUE_REF;
    if (!str_element && !seq_element) return;
    if (str_element) {
        element_kind = SLOT_STR;
        element_type = cold_cstr_span("str");
        element_size = COLD_STR_SLOT_SIZE;
        if (mutation_kind != BODY_OP_SEQ_OPAQUE_REMOVE)
            body->op_c[mutation_op] = COLD_STR_SLOT_SIZE;
        body->slot_aux[seq_slot] = COLD_STR_SLOT_SIZE;
    } else if (element_kind == SLOT_SEQ_STR_REF) {
        element_kind = SLOT_SEQ_STR;
    } else if (element_kind == SLOT_SEQ_I32_REF) {
        element_kind = SLOT_SEQ_I32;
    } else if (element_kind == SLOT_SEQ_OPAQUE_REF) {
        element_kind = SLOT_SEQ_OPAQUE;
    }
    if (element_size <= 0) return;
    bool element_borrowed =
        mutation_kind == BODY_OP_SEQ_OPAQUE_INDEX_STORE &&
        body->op_source_value_def_op_id[mutation_op] >= 0 &&
        body->op_source_value_def_op_id[mutation_op] <
            body->op_count &&
        (body->op_value_def_ownership[
             body->op_source_value_def_op_id[mutation_op]] ==
             COLD_EXPR_OWN_BORROW_SHARED ||
         body->op_value_def_ownership[
             body->op_source_value_def_op_id[mutation_op]] ==
             COLD_EXPR_OWN_BORROW_UNIQUE);
    int32_t helper_row = cold_ensure_seq_mutation_drop_helper(
        parser, parser->symbols, mutation_kind,
        sequence_kind, body->slot_type[seq_slot],
        element_type, element_kind, element_size, 0,
        body->declaration_origin_row, element_borrowed);
    cold_specialized_rewrite_mutation_to_drop_call(
        parser, body, locals, mutation_op, helper_row,
        mutation_kind);
}

static void cold_rewrite_exact_opaque_set_len_if_managed(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t set_len, int32_t sequence_kind, int32_t seq_slot,
        int32_t element_size) {
    cold_rewrite_exact_opaque_mutation_if_managed(
        parser, body, locals, set_len, sequence_kind,
        seq_slot, element_size);
}

static void cold_specialized_rewrite_deferred_object_drops(
        Parser *parser, const BodyIR *src, BodyIR *dst);
static bool cold_deferred_object_drop_marker_valid(
        const BodyIR *body, Symbols *symbols,
        int32_t op, int32_t *object_row_out);

/* Local stores only the exact current value-definition row. Availability,
   place, ownership, and origin are re-read from that immutable row on every
   managed local use; no slot/name side table participates. */
static bool cold_local_is_template_param_sentinel(
        BodyIR *body, const Local *local) {
    /* cold_bind_exact_managed_parameters emits the template parameter's
       raw-param -> local-copy edge with op_c = -(param_index + 1); the
       local keeps value_def_op_id = -1 by design (all-sentinel authority).
       That marker distinguishes a template formal from an uninitialized
       local var, which must still fail the availability check. */
    if (!body || !local || local->is_global ||
        local->value_def_op_id >= 0) {
        return false;
    }
    for (int32_t oi = 0; oi < body->op_count; oi++) {
        if (body->op_dst[oi] == local->slot &&
            body->op_c[oi] < 0 &&
            (body->op_kind[oi] == BODY_OP_COPY_I64 ||
             body->op_kind[oi] == BODY_OP_COPY_COMPOSITE)) {
            return true;
        }
    }
    return false;
}

static void cold_require_local_exact_value_available(
        Parser *parser, BodyIR *body, const Local *local, Span surface) {
    if (!body || !local || local->is_global ||
        cold_exact_managed_storage_for_slot(
            parser ? parser->symbols : 0,
            body, local->slot, local->kind) ==
            COLD_MANAGED_STORAGE_UNKNOWN) {
        return;
    }
    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([avail]) body=%p slot=%d snap=%d opcount=%d\n", (void*)body, local->slot, local->value_def_op_id, body->op_count);
    int32_t def = local->value_def_op_id;
    if (def >= 0 && def < body->op_count) {
        /* Parse-time snapshots can lag behind root-cell var-out
           publications.  Trust the body's latest version row. */
        int32_t best = -1;
        for (int32_t oi = body->op_count - 1; oi >= 0; --oi) {
            if (body->op_value_def_slot[oi] == local->slot &&
                body->op_value_def_producer_function_row[oi] ==
                    body->producer_function_row) {
                best = oi;
                break;
            }
        }
        if (best > def) {
            /* Stream recency is not path currency: the latest version row
               may belong to an earlier branch that already returned, so
               overriding a live parse-time snapshot with it would read a
               definition that never flowed here.  Override only when the
               snapshot itself is no longer live at the current point, or
               when the newer row genuinely is. */
            int32_t scan_block = cold_current_open_block(body);
            bool def_live =
                scan_block >= 0 &&
                cold_exact_definition_is_live_at_current_point(
                    body, def, scan_block);
            bool best_live =
                scan_block >= 0 &&
                cold_exact_definition_is_live_at_current_point(
                    body, best, scan_block);
            if (!def_live || best_live)
                def = best;
        }
    }
    if (def < 0 && cold_local_is_template_param_sentinel(body, local)) {
        return;
    }
    if (def < 0) {
        bool exact_bare_provisional_arg = false;
        if (parser &&
            parser->provisional_uninitialized_call_arg &&
            parser->provisional_uninitialized_call_arg_start >= 0 &&
            parser->provisional_uninitialized_call_arg_start <=
                parser->source.len &&
            surface.ptr ==
                parser->source.ptr +
                parser->provisional_uninitialized_call_arg_start) {
            int32_t end =
                parser->provisional_uninitialized_call_arg_start +
                surface.len;
            while (end < parser->source.len &&
                   (parser->source.ptr[end] == ' ' ||
                    parser->source.ptr[end] == '\t' ||
                    parser->source.ptr[end] == '\r' ||
                    parser->source.ptr[end] == '\n')) {
                end++;
            }
            exact_bare_provisional_arg =
                end == parser->source.len ||
                parser->source.ptr[end] == ',' ||
                parser->source.ptr[end] == ')';
        }
        if (exact_bare_provisional_arg &&
            local->is_mutable_place && !local->is_global) {
            return;
        }
        fprintf(stderr, "cheng_cold: ");
        cold_error_loc(parser, surface);
        cold_dump_bodyir_if_requested(body);
        fprintf(stderr,
                " managed local lacks exact current definition slot=%d expression=%.*s\n",
                local->slot, (int)surface.len, surface.ptr);
        die("managed local lacks exact current definition");
    }
    if (def >= body->op_count ||
        body->op_value_def_slot[def] != local->slot ||
        body->op_value_def_exact_type_id[def] < 0 ||
        body->op_value_def_exact_type_id[def] !=
            body->slot_exact_type_id[local->slot] ||
        body->op_value_def_producer_function_row[def] !=
            body->producer_function_row ||
        body->op_value_def_place_kind[def] ==
            COLD_EXPR_PLACE_INVALID ||
        body->op_value_def_ownership[def] ==
            COLD_EXPR_OWN_INVALID ||
        (body->slot_managed_storage_kind[local->slot] !=
             COLD_MANAGED_STORAGE_UNKNOWN &&
         body->slot_managed_storage_kind[local->slot] !=
             cold_exact_managed_storage_for_slot(
                 parser ? parser->symbols : 0,
                 body, local->slot, local->kind))) {
        fprintf(
            stderr,
            "cheng_cold: managed local authority mismatch function=%.*s local=%.*s kind=%d slot=%d def=%d op_slot=%d op_type_id=%d slot_type_id=%d op_function=%d body_function=%d op_place=%d slot_place=%d op_ownership=%d op_origin=%d slot_origin=%d slot_storage=%d expected_storage=%d\n",
            (int)body->debug_name.len,
            body->debug_name.ptr
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            (int)local->name.len,
            local->name.ptr
                ? local->name.ptr
                : (const uint8_t *)"",
            local->kind, local->slot, def,
            def >= 0 && def < body->op_count
                ? body->op_value_def_slot[def] : -1,
            def >= 0 && def < body->op_count
                ? body->op_value_def_exact_type_id[def] : -1,
            local->slot >= 0 && local->slot < body->slot_count
                ? body->slot_exact_type_id[local->slot] : -1,
            def >= 0 && def < body->op_count
                ? body->op_value_def_producer_function_row[def] : -1,
            body->producer_function_row,
            def >= 0 && def < body->op_count
                ? body->op_value_def_place_kind[def] : -1,
            local->slot >= 0 && local->slot < body->slot_count
                ? body->slot_place_kind[local->slot] : -1,
            def >= 0 && def < body->op_count
                ? body->op_value_def_ownership[def] : -1,
            def >= 0 && def < body->op_count
                ? body->op_value_def_origin_id[def] : -1,
            local->slot >= 0 && local->slot < body->slot_count
                ? body->slot_origin_id[local->slot] : -1,
            local->slot >= 0 && local->slot < body->slot_count
                ? body->slot_managed_storage_kind[local->slot] : -1,
            cold_exact_managed_storage_for_slot(
                parser ? parser->symbols : 0,
                body, local->slot, local->kind));
        die("managed local exact current definition is corrupt");
    }
    int32_t consume_plus_one =
        body->op_value_def_consume_op_index_plus_one[def];
    if (cold_env_flag("CHENG_COLD_DUMP_VAR_FORWARD")) { fprintf(stderr, "([fxv]) slot=%d def=%d cons=%d blk=%d\n", local->slot, def, consume_plus_one, cold_current_open_block(body));
        for (int32_t oi = 0; oi < body->op_count; ++oi) if (body->op_value_def_slot[oi] == local->slot && body->op_value_def_place_kind[oi] != COLD_EXPR_PLACE_INVALID) fprintf(stderr, "([fxv]) row=%d k=%d pl=%d own=%d src=%d org=%d cs=%d blk=%d a=%d b=%d c=%d\n", oi, body->op_kind[oi], body->op_value_def_place_kind[oi], body->op_value_def_ownership[oi], body->op_source_value_def_op_id[oi], body->op_value_def_origin_id[oi], body->op_value_def_consume_op_index_plus_one[oi], cold_block_index_for_op(body, oi), body->op_a[oi], body->op_b[oi], body->op_c[oi]); }
    if (consume_plus_one == 0) return;
    if (consume_plus_one < 1 || consume_plus_one > body->op_count)
        die("managed local exact consume edge is corrupt");
    int32_t current_block = cold_current_open_block(body);
    if (current_block >= 0 &&
        (cold_exact_definition_is_live_at_current_point(
             body, def, current_block) ||
         /* A freshly sealed loop-carried CFG_MERGE / MEMORY_VERSION head
            has no point-liveness interval for its post-materialized row.
            When the row is still the exact slot head by the immutable
            identity schema and no superseding definition lies between it
            and this use on the idom path, the cell is alive by the same
            dominance dataflow the table approximates. */
         (cold_exact_slot_current_definition_replace_valid(
              body, parser ? parser->symbols : 0,
              local->slot, def) &&
          cold_exact_definition_is_current_at_predecessor(
              body, def, current_block,
              body->op_count)))) {
        return;
    }
    {
        /* A consume representative recorded on a control-flow path that
           cannot reach this use (e.g. a ref-object decomposition drop
           living in a dedicated release block while the mainline keeps
           flowing) does not end the value's life on the current path.
           The value stays available exactly when EVERY exact consumer
           of the cell is path-disjoint from the open block. */
        ColdDominatorCache *oxa_cfg =
            current_block >= 0
                ? cold_exact_body_dominators(body) : 0;
        const int32_t *oxa_rel = oxa_cfg && current_block >= 0
            ? cold_exact_query_relevant_blocks(
                  oxa_cfg, 0, body->block_count,
                  current_block)
            : 0;
        ColdExactConsumerIndex *oxa_index =
            oxa_rel ? cold_exact_consumer_index_sync(body) : 0;
        bool oxa_any_consumer = false;
        bool oxa_all_disjoint = true;
        if (oxa_index && def >= 0 &&
            def < oxa_index->definition_cap) {
            for (int32_t oxa_edge = oxa_index->heads[def];
                 oxa_edge >= 0 &&
                 oxa_edge < oxa_index->edge_count;
                 oxa_edge = oxa_index->edge_next[oxa_edge]) {
                int32_t oxa_consumer =
                    oxa_index->edge_consumers[oxa_edge];
                if (!cold_exact_op_consumes_definition(
                        body, def, oxa_consumer))
                    continue;
                oxa_any_consumer = true;
                int32_t oxa_cblk =
                    cold_exact_consumer_effective_block(
                        body, def, oxa_consumer);
                if (oxa_cblk < 0 ||
                    oxa_cblk >= body->block_count ||
                    oxa_rel[oxa_cblk] != 0) {
                    oxa_all_disjoint = false;
                    break;
                }
            }
        }
        if (oxa_any_consumer && oxa_all_disjoint)
            return;
    }
    fprintf(stderr, "cheng_cold: ");
    cold_error_loc(parser, surface);
    int32_t consume_op = consume_plus_one - 1;
    fprintf(stderr,
            " use of consumed managed value function=%.*s local=%.*s slot=%d kind=%d def=%d current_block=%d consume_op=%d consume_block=%d consume_kind=%d consume_dst=%d consume_a=%d consume_b=%d consume_source_def=%d expression=%.*s\n",
            (int)body->debug_name.len,
            body->debug_name.ptr
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            (int)local->name.len,
            local->name.ptr
                ? local->name.ptr
                : (const uint8_t *)"",
            local->slot, local->kind,
            def, current_block, consume_op,
            cold_block_index_for_op(body, consume_op),
            body->op_kind[consume_op],
            body->op_dst[consume_op], body->op_a[consume_op],
            body->op_b[consume_op],
            body->op_source_value_def_op_id[consume_op],
            (int)surface.len, surface.ptr);
    cold_print_context(parser, surface);
    {
        int32_t cc = (body->op_kind[consume_op] == 6 ||
                      body->op_kind[consume_op] == 12)
            ? body->op_a[consume_op] : -1;
        if (cc >= 0 && cc < parser->symbols->function_count) {
            fprintf(stderr,
                "cheng_cold:   consume callee=%.*s borrows=%d summary=%d\n",
                (int)parser->symbols->functions[cc].name.len,
                parser->symbols->functions[cc].name.ptr
                    ? parser->symbols->functions[cc].name.ptr
                    : (const uint8_t *)"",
                parser->symbols->functions[cc].borrows_args ? 1 : 0,
                parser->symbols->functions[cc].result_ownership_summary);
        }
        if (body->op_kind[consume_op] == BODY_OP_COPY_COMPOSITE &&
            consume_op + 1 < body->op_count &&
            (body->op_kind[consume_op + 1] == BODY_OP_CALL_COMPOSITE ||
             body->op_kind[consume_op + 1] == BODY_OP_CALL_I32)) {
            int32_t next_cc = body->op_a[consume_op + 1];
            if (next_cc >= 0 && next_cc < parser->symbols->function_count) {
                fprintf(stderr,
                    "cheng_cold:   consume copy callee=%.*s borrows=%d summary=%d\n",
                    (int)parser->symbols->functions[next_cc].name.len,
                    parser->symbols->functions[next_cc].name.ptr
                        ? parser->symbols->functions[next_cc].name.ptr
                        : (const uint8_t *)"",
                    parser->symbols->functions[next_cc].borrows_args ? 1 : 0,
                parser->symbols->functions[next_cc].result_ownership_summary);
            }
        }
        if (body->op_kind[consume_op] == BODY_OP_COPY_COMPOSITE &&
            consume_op + 1 < body->op_count &&
            (body->op_kind[consume_op + 1] == BODY_OP_CALL_COMPOSITE ||
             body->op_kind[consume_op + 1] == BODY_OP_CALL_I32)) {
            int32_t next_cc = body->op_a[consume_op + 1];
            if (next_cc >= 0 && next_cc < parser->symbols->function_count) {
                fprintf(stderr,
                    "cheng_cold:   consume copy callee=%.*s borrows=%d summary=%d\n",
                    (int)parser->symbols->functions[next_cc].name.len,
                    parser->symbols->functions[next_cc].name.ptr
                        ? parser->symbols->functions[next_cc].name.ptr
                        : (const uint8_t *)"",
                    parser->symbols->functions[next_cc].borrows_args ? 1 : 0,
                parser->symbols->functions[next_cc].result_ownership_summary);
            }
        }
        if (body->op_kind[consume_op] == BODY_OP_COPY_COMPOSITE) {
            int32_t copied_slot = body->op_dst[consume_op];
            int32_t dump_start = consume_op > 8 ? consume_op - 8 : 0;
            int32_t dump_end = consume_op + 16 < body->op_count
                ? consume_op + 16 : body->op_count;
            for (int32_t dump_op = dump_start; dump_op < dump_end; dump_op++) {
                fprintf(stderr,
                    "cheng_cold:   nearby op=%d block=%d kind=%d dst=%d a=%d b=%d c=%d source=%d callee=%.*s\n",
                    dump_op, cold_block_index_for_op(body, dump_op),
                    body->op_kind[dump_op], body->op_dst[dump_op],
                    body->op_a[dump_op], body->op_b[dump_op],
                    body->op_c[dump_op],
                    body->op_source_value_def_op_id[dump_op],
                    (body->op_kind[dump_op] == BODY_OP_CALL_COMPOSITE ||
                     body->op_kind[dump_op] == BODY_OP_CALL_I32) &&
                            body->op_a[dump_op] >= 0 &&
                            body->op_a[dump_op] < parser->symbols->function_count
                        ? (int)parser->symbols->functions[body->op_a[dump_op]].name.len : 0,
                    (body->op_kind[dump_op] == BODY_OP_CALL_COMPOSITE ||
                     body->op_kind[dump_op] == BODY_OP_CALL_I32) &&
                            body->op_a[dump_op] >= 0 &&
                            body->op_a[dump_op] < parser->symbols->function_count &&
                            parser->symbols->functions[body->op_a[dump_op]].name.ptr
                        ? parser->symbols->functions[body->op_a[dump_op]].name.ptr
                        : (const uint8_t *)"");
            }
            for (int32_t call_op = 0; call_op < body->op_count; call_op++) {
                if (body->op_kind[call_op] != BODY_OP_CALL_COMPOSITE &&
                    body->op_kind[call_op] != BODY_OP_CALL_I32) continue;
                int32_t arg_start = body->op_b[call_op];
                int32_t arg_count = body->op_c[call_op];
                for (int32_t arg = 0; arg < arg_count; arg++) {
                    int32_t arg_row = arg_start + arg;
                    if (arg_row < 0 || arg_row >= body->call_arg_count ||
                        body->call_arg_slot[arg_row] != copied_slot) continue;
                    int32_t fn_row = body->op_a[call_op];
                    fprintf(stderr,
                        "cheng_cold:   consume copy reaches call_op=%d arg=%d callee=%.*s borrows=%d\n",
                        call_op, arg,
                        fn_row >= 0 && fn_row < parser->symbols->function_count
                            ? (int)parser->symbols->functions[fn_row].name.len : 0,
                        fn_row >= 0 && fn_row < parser->symbols->function_count &&
                                parser->symbols->functions[fn_row].name.ptr
                            ? parser->symbols->functions[fn_row].name.ptr
                            : (const uint8_t *)"",
                        fn_row >= 0 && fn_row < parser->symbols->function_count &&
                            parser->symbols->functions[fn_row].borrows_args ? 1 : 0);
                }
            }
        }
    }
    if (getenv("CHENG_COLD_DUMP_CONSUMED") != NULL) {
        ColdDominatorCache *diag_cfg =
            cold_exact_body_dominators(body);
        const int32_t *diag_relevant = diag_cfg
            ? cold_exact_query_relevant_blocks(
                  diag_cfg, 0, body->block_count,
                  current_block)
            : 0;
        fprintf(stderr,
                "cheng_cold: consumed-body cfg=%d relevant_entry=%d relevant_consume=%d relevant_current=%d pending=%d->%d cache_blocks=%d\n",
                diag_cfg ? 1 : 0,
                diag_relevant ? diag_relevant[0] : -1,
                diag_relevant
                    ? diag_relevant[cold_block_index_for_op(
                          body, consume_op)]
                    : -1,
                diag_relevant
                    ? diag_relevant[current_block] : -1,
                body->pending_dominator_edge_from,
                body->pending_dominator_edge_to,
                diag_cfg ? diag_cfg->block_count : -1);
        ColdExactConsumerIndex *diag_index =
            cold_exact_consumer_index_sync(body);
        if (diag_index && def >= 0 &&
            def < diag_index->definition_cap) {
            for (int32_t edge = diag_index->heads[def];
                 edge >= 0 && edge < diag_index->edge_count;
                 edge = diag_index->edge_next[edge]) {
                int32_t consumer =
                    diag_index->edge_consumers[edge];
                int32_t consumer_block =
                    cold_exact_consumer_effective_block(
                        body, def, consumer);
                fprintf(stderr,
                        "cheng_cold: consumed-body edge=%d consumer=%d block=%d relevant=%d exact=%d kind=%d callee=%.*s place=%d source=%d\n",
                        edge, consumer, consumer_block,
                        diag_relevant && consumer_block >= 0 &&
                                consumer_block < body->block_count
                            ? diag_relevant[consumer_block] : -1,
                        cold_exact_op_consumes_definition(
                            body, def, consumer) ? 1 : 0,
                        consumer >= 0 && consumer < body->op_count
                            ? body->op_kind[consumer] : -1,
                        consumer >= 0 && consumer < body->op_count &&
                                (body->op_kind[consumer] ==
                                     BODY_OP_CALL_COMPOSITE ||
                                 body->op_kind[consumer] ==
                                     BODY_OP_CALL_I32) &&
                                body->op_a[consumer] >= 0 &&
                                body->op_a[consumer] <
                                    parser->symbols->function_count
                            ? (int)parser->symbols->functions[
                                  body->op_a[consumer]].name.len
                            : 0,
                        consumer >= 0 && consumer < body->op_count &&
                                (body->op_kind[consumer] ==
                                     BODY_OP_CALL_COMPOSITE ||
                                 body->op_kind[consumer] ==
                                     BODY_OP_CALL_I32) &&
                                body->op_a[consumer] >= 0 &&
                                body->op_a[consumer] <
                                    parser->symbols->function_count &&
                                parser->symbols->functions[
                                    body->op_a[consumer]].name.ptr
                            ? parser->symbols->functions[
                                  body->op_a[consumer]].name.ptr
                            : (const uint8_t *)"",
                        consumer >= 0 && consumer < body->op_count
                            ? body->op_value_def_place_kind[consumer]
                            : -1,
                        consumer >= 0 && consumer < body->op_count
                            ? body->op_source_value_def_op_id[consumer]
                            : -1);
            }
        }
        for (int32_t block = 0; block < body->block_count; block++) {
            int32_t term = body->block_term[block];
            fprintf(stderr,
                    "cheng_cold: consumed-body block=%d start=%d count=%d term=%d kind=%d true=%d false=%d\n",
                    block, body->block_op_start[block],
                    body->block_op_count[block], term,
                    term >= 0 && term < body->term_count
                        ? body->term_kind[term] : -1,
                    term >= 0 && term < body->term_count
                        ? body->term_true_block[term] : -1,
                    term >= 0 && term < body->term_count
                        ? body->term_false_block[term] : -1);
        }
        for (int32_t op = 0; op < body->op_count; op++) {
            fprintf(stderr,
                    "cheng_cold: consumed-body op=%d block=%d kind=%d dst=%d a=%d b=%d c=%d slot=%d place=%d own=%d origin=%d consume=%d source=%d\n",
                    op, cold_block_index_for_op(body, op),
                    body->op_kind[op], body->op_dst[op],
                    body->op_a[op], body->op_b[op], body->op_c[op],
                    body->op_value_def_slot[op],
                    body->op_value_def_place_kind[op],
                    body->op_value_def_ownership[op],
                    body->op_value_def_origin_id[op],
                    body->op_value_def_consume_op_index_plus_one[op],
                    body->op_source_value_def_op_id[op]);
        }
    }
    if (cold_env_flag("CHENG_COLD_DUMP_VAR_FORWARD")) {
        int32_t cb2 = current_block;
        int32_t head = local->slot >= 0 &&
                local->slot < body->slot_count
            ? body->slot_origin_id[local->slot] : -9;
        fprintf(stderr,
            "([cvx]) body=%p slot=%d def=%d blk=%d opc=%d head=%d "
            "rvs=%d curpred=%d chain=%d revchain=%d consrep=%d "
            "creach=%d dblk=%d dplace=%d down=%d dsrc=%d dorg=%d\n",
            (const void *)body,
            (int)local->slot,
            def, cb2,
            body->op_count,
            head,
            def >= 0 ? (cold_exact_slot_current_definition_replace_valid(
                            body, parser ? parser->symbols : 0,
                            local->slot, def) ? 1 : 0) : -9,
            cb2 >= 0 && def >= 0
                ? (cold_exact_definition_is_current_at_predecessor(
                       body, def, cb2, body->op_count) ? 1 : 0) : -9,
            head >= 0 && def >= 0
                ? (cold_exact_version_chain_reaches_definition(
                       body, head, def) ? 1 : 0) : -9,
            def >= 0 && head >= 0 && head < body->op_count
                ? (cold_exact_version_chain_reaches_definition(
                       body, def, head) ? 1 : 0) : -9,
            consume_plus_one,
            consume_plus_one > 0 &&
                    consume_plus_one <= body->op_count &&
                    def >= 0
                ? (cold_exact_op_consumes_definition(
                       body, def,
                       consume_plus_one - 1) ? 1 : 0) : -9,
            def >= 0 ? cold_block_index_for_op(body, def) : -9,
            def >= 0 ? body->op_value_def_place_kind[def] : -9,
            def >= 0 ? body->op_value_def_ownership[def] : -9,
            def >= 0 ? body->op_source_value_def_op_id[def] : -9,
            def >= 0 ? body->op_value_def_origin_id[def] : -9);
    }
    cold_dump_bodyir_if_requested(body);
    die("use of consumed managed value");
}

static ColdDeferContext *cold_defer_context_create(Parser *parser,
                                                   BodyIR *body,
                                                   Locals *locals) {
    if (!parser || !parser->arena || !parser->symbols || !body ||
        !locals)
        die("cold defer context owner is invalid");
    ColdDeferContext *ctx = arena_alloc(parser->arena, sizeof(ColdDeferContext));
    memset(ctx, 0, sizeof(*ctx));
    ctx->parser = parser;
    ctx->body = body;
    ctx->locals = locals;
    ctx->function_indent = -1;
    ctx->return_block = -1;
    ctx->return_slot = -1;
    ctx->activation_term_start = -1;
    ctx->parsing_entry_block = -1;
    ctx->parsing_activation_block = -1;
    ColdActiveDeferContext = ctx;
    return ctx;
}

static ColdDeferContext *cold_defer_context_for(BodyIR *body) {
    ColdDeferContext *ctx = ColdActiveDeferContext;
    return ctx && ctx->body == body ? ctx : 0;
}

static bool cold_defer_activation_identity_valid(
        const BodyIR *body, const ColdDeferContext *ctx) {
    if (!body || !ctx || ctx->body != body ||
        ctx->parsing_activation_block < 0 ||
        ctx->parsing_entry_block >= body->block_count ||
        ctx->parsing_entry_block <=
            ctx->parsing_activation_block) {
        return false;
    }
    int32_t activation_term =
        body->block_term[ctx->parsing_activation_block];
    if (activation_term < 0 ||
        activation_term >= body->term_count ||
        body->term_kind[activation_term] != BODY_TERM_BR ||
        body->term_false_block[activation_term] != -1 ||
        body->term_source_value_def_op_id[activation_term] != -1) {
        return false;
    }
    int32_t continuation =
        body->term_true_block[activation_term];
    if (continuation <= ctx->parsing_activation_block ||
        ctx->parsing_entry_block <= continuation ||
        continuation >= body->block_count ||
        body->block_term[continuation] >= 0 ||
        body->block_op_count[continuation] != 0) {
        return false;
    }
    return true;
}

/* The cleanup component is detached while its source is parsed.  This walk
   visits the entire currently reachable component, not only one path to the
   query, so a sibling edge cannot smuggle construction back into normal CFG. */
static bool cold_defer_construction_block_reachable(
        const BodyIR *body, int32_t entry_block,
        int32_t query_block) {
    if (!body || entry_block < 0 ||
        entry_block >= body->block_count ||
        query_block < entry_block ||
        query_block >= body->block_count) {
        return false;
    }
    bool *reachable = calloc(
        (size_t)body->block_count, sizeof(bool));
    int32_t *queue = malloc(
        (size_t)body->block_count * sizeof(int32_t));
    if (!reachable || !queue) {
        free(reachable);
        free(queue);
        die("out of memory proving defer construction reachability");
    }
    int32_t read = 0;
    int32_t write = 0;
    bool valid = true;
    reachable[entry_block] = true;
    queue[write++] = entry_block;
    while (read < write) {
        int32_t block = queue[read++];
        int32_t term = body->block_term[block];
        if (term < 0) continue;
        if (term >= body->term_count) {
            valid = false;
            break;
        }
        int32_t kind = body->term_kind[term];
        int32_t targets[2] = {-1, -1};
        int32_t target_count = 0;
        if (kind == BODY_TERM_BR) {
            targets[target_count++] =
                body->term_true_block[term];
        } else if (kind == BODY_TERM_CBR) {
            targets[target_count++] =
                body->term_true_block[term];
            targets[target_count++] =
                body->term_false_block[term];
        } else if (kind == BODY_TERM_SWITCH) {
            for (int32_t edge = 0;
                 edge < body->switch_count; edge++) {
                if (body->switch_term[edge] != term)
                    continue;
                int32_t target =
                    body->switch_block[edge];
                if (target < entry_block ||
                    target >= body->block_count) {
                    valid = false;
                    break;
                }
                if (!reachable[target]) {
                    reachable[target] = true;
                    queue[write++] = target;
                }
            }
            continue;
        } else if (kind == BODY_TERM_UNREACHABLE) {
            continue;
        } else if (kind == BODY_TERM_RET) {
            valid = false;
            break;
        } else {
            valid = false;
            break;
        }
        for (int32_t edge = 0;
             edge < target_count; edge++) {
            int32_t target = targets[edge];
            if (target == -1) continue;
            if (target < entry_block ||
                target >= body->block_count) {
                valid = false;
                break;
            }
            if (!reachable[target]) {
                reachable[target] = true;
                queue[write++] = target;
            }
        }
    }
    bool result = valid && reachable[query_block];
    free(queue);
    free(reachable);
    return result;
}

static bool cold_defer_definition_consumption_dataflow_query(
        const BodyIR *body, int32_t definition,
        int32_t query_block, int32_t query_op_exclusive,
        uint8_t *query_exit_state, bool *handled) {
    if (handled) *handled = false;
    ColdDeferContext *ctx = ColdActiveDeferContext;
    if (!ctx || ctx->body != body || !ctx->emitting_defer ||
        ctx->parsing_entry_block < 0)
        return false;
    if (!handled)
        die("cold defer dataflow dispatch is invalid");
    *handled = true;
    bool construction_reachable =
        cold_defer_construction_block_reachable(
            body, ctx->parsing_entry_block,
            query_block);
    int32_t activation_term =
        ctx->parsing_activation_block >= 0 &&
        ctx->parsing_activation_block < body->block_count
            ? body->block_term[
                  ctx->parsing_activation_block]
            : -1;
    int32_t continuation =
        activation_term >= 0 &&
        activation_term < body->term_count
            ? body->term_true_block[activation_term]
            : -1;
    if (!construction_reachable ||
        !cold_defer_activation_identity_valid(body, ctx)) {
        fprintf(
            stderr,
            "cheng_cold: defer construction liveness mismatch"
            " function=%.*s query_block=%d entry_block=%d"
            " activation_block=%d continuation_block=%d"
            " block_count=%d activation_term=%d"
            " construction_reachable=%d\n",
            (int)body->debug_name.len,
            body->debug_name.ptr
                ? body->debug_name.ptr
                : (const uint8_t *)"",
            query_block,
            ctx->parsing_entry_block,
            ctx->parsing_activation_block,
            continuation,
            body->block_count,
            activation_term,
            construction_reachable ? 1 : 0);
        cold_dump_bodyir_if_requested((BodyIR *)body);
        die("cold defer liveness construction edge is invalid");
    }
    int32_t definition_block =
        cold_block_index_for_op(
            (BodyIR *)body, definition);
    if (definition_block < 0) {
        die("cold defer definition has no exact block identity");
    }
    uint8_t entry_state = COLD_VALUE_UNDEFINED;
    if (definition_block < ctx->parsing_entry_block) {
        uint8_t activation_state = 0;
        if (!cold_exact_definition_consumption_dataflow_query_from(
                body, definition, 0,
                ctx->parsing_entry_block,
                COLD_VALUE_UNDEFINED,
                ctx->parsing_activation_block, -1,
                &activation_state) ||
            activation_state == 0) {
            return false;
        }
        entry_state = activation_state;
    } else if (!cold_defer_construction_block_reachable(
                   body, ctx->parsing_entry_block,
                   definition_block)) {
        die("cold defer-local definition is outside detached CFG");
    }
    return cold_exact_definition_consumption_dataflow_query_from(
        body, definition, ctx->parsing_entry_block,
        body->block_count, entry_state, query_block,
        query_op_exclusive, query_exit_state);
}

static bool cold_defer_construction_domain_valid(
        const BodyIR *body, const ColdDeferContext *ctx,
        int32_t fallthrough_block) {
    if (!cold_defer_activation_identity_valid(body, ctx) ||
        fallthrough_block < ctx->parsing_entry_block ||
        fallthrough_block >= body->block_count ||
        body->cur_open_block != fallthrough_block ||
        body->block_term[fallthrough_block] >= 0) {
        return false;
    }
    bool *reachable = calloc(
        (size_t)body->block_count, sizeof(bool));
    int32_t *queue = malloc(
        (size_t)body->block_count * sizeof(int32_t));
    if (!reachable || !queue) {
        free(reachable);
        free(queue);
        die("out of memory validating defer construction domain");
    }
    int32_t read = 0;
    int32_t write = 0;
    int32_t open_count = 0;
    bool valid = true;
    reachable[ctx->parsing_entry_block] = true;
    queue[write++] = ctx->parsing_entry_block;
    while (read < write && valid) {
        int32_t block = queue[read++];
        int32_t term = body->block_term[block];
        if (term < 0) {
            if (block != fallthrough_block)
                valid = false;
            open_count++;
            continue;
        }
        if (term >= body->term_count) {
            valid = false;
            break;
        }
        int32_t kind = body->term_kind[term];
        int32_t targets[2] = {-1, -1};
        int32_t target_count = 0;
        if (kind == BODY_TERM_BR) {
            targets[target_count++] =
                body->term_true_block[term];
        } else if (kind == BODY_TERM_CBR) {
            targets[target_count++] =
                body->term_true_block[term];
            targets[target_count++] =
                body->term_false_block[term];
        } else if (kind == BODY_TERM_SWITCH) {
            int32_t found = 0;
            int32_t case_start =
                body->term_case_start[term];
            int32_t case_count =
                body->term_case_count[term];
            if (case_start < 0 || case_count < 0 ||
                (case_count > 0 &&
                 (case_start >= body->switch_count ||
                  body->switch_term[case_start] != term))) {
                valid = false;
                break;
            }
            for (int32_t edge = 0;
                 edge < body->switch_count; edge++) {
                if (body->switch_term[edge] != term)
                    continue;
                found++;
                int32_t target =
                    body->switch_block[edge];
                if (target < ctx->parsing_entry_block ||
                    target >= body->block_count) {
                    valid = false;
                    break;
                }
                if (!reachable[target]) {
                    reachable[target] = true;
                    queue[write++] = target;
                }
            }
            if (!valid || found != case_count)
                valid = false;
            continue;
        } else if (kind == BODY_TERM_UNREACHABLE) {
            continue;
        } else {
            valid = false;
            break;
        }
        for (int32_t edge = 0;
             edge < target_count; edge++) {
            int32_t target = targets[edge];
            if (target < ctx->parsing_entry_block ||
                target >= body->block_count) {
                valid = false;
                break;
            }
            if (!reachable[target]) {
                reachable[target] = true;
                queue[write++] = target;
            }
        }
    }
    bool result =
        valid && open_count == 1 &&
        reachable[fallthrough_block];
    free(queue);
    free(reachable);
    return result;
}

/* Forward decl: primitive pointer-cast type table (Int32Ptr/.../VoidPtrPtr),
   defined later in this file.  Consulted by cold_parser_slot_kind_from_type so a
   `let ep: Int32Ptr = Int32Ptr(raw)` declared-type annotation classifies as
   SLOT_PTR (matching the cast result) even in files that do not declare a local
   `Int32Ptr = int32 *` alias. */
static Span cold_primitive_pointer_cast_type(Span token);

static int32_t cold_parser_source_view_offset(Span source, Span view) {
    if (!source.ptr || !view.ptr || source.len < 0 || view.len < 0)
        return -1;
    uintptr_t source_start = (uintptr_t)source.ptr;
    uintptr_t view_start = (uintptr_t)view.ptr;
    if ((uintptr_t)source.len > UINTPTR_MAX - source_start ||
        (uintptr_t)view.len > UINTPTR_MAX - view_start)
        die("parser source view range overflow");
    uintptr_t source_end = source_start + (uintptr_t)source.len;
    uintptr_t view_end = view_start + (uintptr_t)view.len;
    if (view_start < source_start || view_end > source_end)
        return -1;
    uintptr_t offset = view_start - source_start;
    if (offset > INT32_MAX)
        die("parser source view offset overflow");
    return (int32_t)offset;
}

#ifndef COLD_CHENG_INCLUDE
static void cold_parser_validate_symbol_authority(Symbols *symbols) {
    if (!symbols || !symbols->compilation_context)
        die("parser issuer requires symbol authority");
    ColdCompilationContext *context = symbols->compilation_context;
    int32_t context_row = symbols->compilation_context_row;
    int32_t scope_row = symbols->symbol_scope_row;
    if (!context->initialized || !context->claim_held ||
        context_row != context->context_row || context_row < 0 ||
        context_row >= context->contexts.count ||
        context->contexts.states[context_row] !=
            COLD_COMPILATION_CONTEXT_ACTIVE ||
        symbols->compilation_context_id == 0 ||
        symbols->compilation_context_id !=
            context->contexts.context_ids[context_row] ||
        scope_row < 0 || scope_row >= context->symbol_scopes.count ||
        context->symbol_scopes.context_rows[scope_row] != context_row ||
        context->symbol_scopes.context_ids[scope_row] !=
            symbols->compilation_context_id ||
        symbols->symbol_scope_epoch == 0 ||
        symbols->symbol_scope_epoch !=
            context->symbol_scopes.symbol_scope_epochs[scope_row] ||
        symbols->source_seal_epoch !=
            context->symbol_scopes.bound_source_seal_epochs[scope_row] ||
        (context->symbol_scopes.states[scope_row] ==
             COLD_SYMBOL_SCOPE_LIVE_PRESEAL &&
         symbols->source_seal_epoch != 0) ||
        (context->symbol_scopes.states[scope_row] ==
             COLD_SYMBOL_SCOPE_SOURCE_BOUND &&
         (symbols->source_seal_epoch == 0 ||
          symbols->source_seal_epoch !=
              context->contexts.active_source_epochs[context_row])) ||
        (context->symbol_scopes.states[scope_row] !=
             COLD_SYMBOL_SCOPE_LIVE_PRESEAL &&
         context->symbol_scopes.states[scope_row] !=
             COLD_SYMBOL_SCOPE_SOURCE_BOUND)) {
        die("parser issuer symbol authority drifted");
    }
}

Parser cold_parser_issue_legacy_span(Symbols *symbols, Span source) {
    if (source.len < 0 || (source.len > 0 && !source.ptr))
        die("parser issuer source span invalid");
    cold_parser_validate_symbol_authority(symbols);
    Parser parser;
    memset(&parser, 0, sizeof(parser));
    parser.source = source;
    parser.arena = symbols->arena;
    parser.symbols = symbols;
    parser.compilation_context = symbols->compilation_context;
    parser.compilation_context_row = symbols->compilation_context_row;
    parser.compilation_context_id = symbols->compilation_context_id;
    parser.symbol_scope_row = symbols->symbol_scope_row;
    parser.symbol_scope_epoch = symbols->symbol_scope_epoch;
    parser.source_seal_epoch = symbols->source_seal_epoch;
    parser.expr_resume_block = -1;
    parser.active_generic_binder_id = -1;
    parser.stmt_tail_expr_slot = -1;
    parser.stmt_tail_expr_value_def_op_id = -1;
    parser.conditional_expression_start = -1;
    parser.source_identity_row = -1;
    return parser;
}

Parser cold_parser_issue_lexical_span(Arena *arena, Span source) {
    if (source.len < 0 || (source.len > 0 && !source.ptr))
        die("lexical parser source span invalid");
    Parser parser;
    memset(&parser, 0, sizeof(parser));
    parser.source = source;
    parser.arena = arena;
    parser.compilation_context_row = -1;
    parser.symbol_scope_row = -1;
    parser.expr_resume_block = -1;
    parser.active_generic_binder_id = -1;
    parser.stmt_tail_expr_slot = -1;
    parser.stmt_tail_expr_value_def_op_id = -1;
    parser.conditional_expression_start = -1;
    parser.source_identity_row = -1;
    return parser;
}
#endif

void cold_parser_bind_source_identity_row(Parser *parser,
                                          int32_t source_identity_row) {
    if (!parser || !parser->symbols ||
        !parser->symbols->source_identity_attached ||
        source_identity_row < 0 ||
        source_identity_row >= parser->symbols->source_identity_count ||
        !parser->symbols->source_identity_diagnostic_paths ||
        !parser->symbols->source_identity_diagnostic_paths[
             source_identity_row].ptr ||
        parser->symbols->source_identity_diagnostic_paths[
             source_identity_row].len <= 0) {
        die("parser source identity row is invalid");
    }
    parser->source_identity_row = source_identity_row;
}

Parser parser_child(Parser *owner, Span source) {
    if (!owner || !owner->arena) die("parser child requires owner arena");
    Parser child = owner->symbols
        ? cold_parser_issue_legacy_span(owner->symbols, source)
        : cold_parser_issue_lexical_span(owner->arena, source);
    if (owner->symbols &&
        (owner->compilation_context != child.compilation_context ||
         owner->compilation_context_row != child.compilation_context_row ||
         owner->compilation_context_id != child.compilation_context_id ||
         owner->symbol_scope_row != child.symbol_scope_row ||
         owner->symbol_scope_epoch != child.symbol_scope_epoch ||
         owner->source_seal_epoch != child.source_seal_epoch)) {
        die("parser child authority drifted");
    }
    /* The symbol-backed issuer starts at symbols->arena, but a child view
       created while parsing a function belongs to that function's exact
       scratch transaction.  Keep allocation ownership with the parent;
       otherwise a child can publish a persistent-arena BodyIR into the
       scratch shadow store and make atomic commit observe an unowned
       replacement.  This changes only the allocation domain: context,
       source and symbol authority remain the issuer-validated rows above. */
    child.arena = owner->arena;
    child.import_mode = owner->import_mode;
    child.import_alias = owner->import_alias;
    child.import_sources = owner->import_sources;
    child.import_source_count = owner->import_source_count;
    child.own_import_sources = owner->own_import_sources;
    child.own_import_source_count = owner->own_import_source_count;
    child.function_bodies = owner->function_bodies;
    child.function_body_cap = owner->function_body_cap;
    child.function_body_store = owner->function_body_store;
    if (child.function_body_store) {
        if (child.function_body_store->arena != child.arena)
            die("parser child body store arena drifted");
        child.function_body_cap = child.function_body_store->cap;
    }
    child.source_path = owner->source_path;
    child.source_identity_row = owner->source_identity_row;
    child.active_generic_count = owner->active_generic_count;
    child.active_generic_binder_kind =
        owner->active_generic_count > 0
            ? owner->active_generic_binder_kind
            : COLD_GENERIC_BINDER_NONE;
    child.active_generic_binder_id =
        owner->active_generic_count > 0
            ? owner->active_generic_binder_id
            : -1;
    for (int32_t i = 0; i < owner->active_generic_count && i < 4; i++) {
        child.active_generic_names[i] = owner->active_generic_names[i];
    }
    child.delimiter_stack = owner->delimiter_stack;
    child.delimiter_stack_cap = owner->delimiter_stack_cap;
    child.reject_postfix_question = owner->reject_postfix_question;
    child.has_conditional_expression_start = false;
    child.conditional_expression_start = -1;
    child.expr_has_resume_block = false;
    child.expr_resume_block = -1;
    /* #128-r7: a fresh function/closure body starts its own top-level scope
       for implicit-tail-return purposes. */
    child.stmt_scope_depth = 0;
    child.stmt_tail_expr_has = false;
    child.stmt_tail_expr_slot = -1;
    child.stmt_tail_expr_value_def_op_id = -1;
    int32_t source_start = cold_parser_source_view_offset(
        owner->source, source);
    if (source_start >= 0) {
        child.source_origin = owner->source_origin.ptr
            ? owner->source_origin
            : owner->source;
        if (owner->source_origin_offsets) {
            child.source_origin_offsets =
                owner->source_origin_offsets + source_start;
        } else {
            child.source_origin_base =
                (owner->source_origin.ptr
                    ? owner->source_origin_base
                    : 0) + source_start;
        }
    }
    return child;
}

static void parser_record_expr_resume(Parser *parser, int32_t block) {
    if (!parser || block < 0) return;
    parser->expr_has_resume_block = true;
    parser->expr_resume_block = block;
}

static void parser_adopt_expr_resume(Parser *parser, Parser *child) {
    if (!parser || !child || !child->expr_has_resume_block) return;
    parser_record_expr_resume(parser, child->expr_resume_block);
}

static Span cold_parser_origin_source(Parser *parser) {
    if (!parser) return (Span){0};
    if (parser->source_origin.ptr) return parser->source_origin;
    return parser->source;
}

static int32_t cold_parser_origin_offset(Parser *parser,
                                         int32_t local_offset) {
    if (!parser || local_offset < 0 || local_offset > parser->source.len)
        return -1;
    int32_t origin_offset = parser->source_origin_offsets
        ? parser->source_origin_offsets[local_offset]
        : parser->source_origin_base + local_offset;
    Span origin = cold_parser_origin_source(parser);
    if (origin_offset < 0 || origin_offset > origin.len)
        die("parser source origin offset out of bounds");
    return origin_offset;
}

static int32_t cold_parser_origin_visual_column_at(
        Parser *parser, int32_t local_offset) {
    Span origin = cold_parser_origin_source(parser);
    int32_t origin_offset =
        cold_parser_origin_offset(parser, local_offset);
    int32_t line_start = origin_offset;
    while (line_start > 0 &&
           origin.ptr[line_start - 1] != '\n') {
        line_start--;
    }
    int32_t column = 0;
    for (int32_t i = line_start; i < origin_offset; i++) {
        column += origin.ptr[i] == '\t' ? 4 : 1;
    }
    return column;
}

static Span cold_parser_origin_span(Parser *parser, Span token) {
    if (!parser || !token.ptr || token.len < 0) return (Span){0};
    int32_t local_start = cold_parser_source_view_offset(
        parser->source, token);
    if (local_start < 0) return (Span){0};
    int32_t origin_start = cold_parser_origin_offset(parser, local_start);
    int32_t origin_end =
        cold_parser_origin_offset(parser, local_start + token.len);
    Span origin = cold_parser_origin_source(parser);
    if (origin_start < 0 || origin_end < origin_start ||
        origin_end > origin.len)
        die("parser source origin span is invalid");
    return span_sub(origin, origin_start, origin_end);
}

/* Return 1-based line number for token in parser source */
static int32_t cold_token_line(Parser *parser, Span token) {
    Span origin = cold_parser_origin_source(parser);
    Span origin_token = cold_parser_origin_span(parser, token);
    int32_t offset = cold_span_offset(origin, origin_token);
    if (offset < 0) return 1;
    int32_t line = 1;
    for (int32_t i = 0; i < offset && i < origin.len; i++) {
        if (origin.ptr[i] == '\n') line++;
    }
    return line;
}

/* Print source context line containing token, with caret underline */
static void cold_print_context(Parser *parser, Span token) {
    Span source = cold_parser_origin_source(parser);
    Span source_token = cold_parser_origin_span(parser, token);
    int32_t offset = cold_span_offset(source, source_token);
    if (offset < 0) return;
    int32_t line_start = offset;
    while (line_start > 0 && source.ptr[line_start - 1] != '\n') line_start--;
    int32_t line_end = offset;
    while (line_end < source.len && source.ptr[line_end] != '\n') line_end++;
    if (line_end <= line_start) return;
    fprintf(stderr, "  |\n  | %.*s\n  |", (int)(line_end - line_start), source.ptr + line_start);
    for (int32_t i = line_start; i < line_end; i++) {
        if (i >= offset && i < offset + source_token.len) fprintf(stderr, "^");
        else if (i < offset) fprintf(stderr, " ");
    }
    fprintf(stderr, "\n");
}

/* Print file:line: offset for error messages */
static void cold_error_loc(Parser *parser, Span token) {
    Span origin = cold_parser_origin_source(parser);
    Span origin_token = cold_parser_origin_span(parser, token);
    int32_t offset = cold_span_offset(origin, origin_token);
    int32_t line = cold_token_line(parser, token);
    if (offset < 0) { fprintf(stderr, "???"); return; }
    fprintf(stderr, "%s:%d (offset %d)",
            parser->source_path ? parser->source_path : "?", line, offset);
}

static bool cold_parser_declaration_origin_from_token(
        Parser *parser, Span token,
        int32_t *module_source_row,
        int32_t *token_byte_offset) {
    if (module_source_row) *module_source_row = -1;
    if (token_byte_offset) *token_byte_offset = -1;
    if (!parser || !token.ptr || token.len <= 0) return false;
    Span origin = cold_parser_origin_source(parser);
    Span origin_token = cold_parser_origin_span(parser, token);
    int32_t offset = cold_span_offset(origin, origin_token);
    if (offset < 0) return false;
    return cold_source_snapshot_origin_from_view(
        origin, offset,
        module_source_row, token_byte_offset);
}

static void cold_require_declaration_origin_pair(
        Symbols *symbols, int32_t declaration_origin_row,
        int32_t *module_source_row,
        int32_t *token_byte_offset) {
    if (!symbols || declaration_origin_row < 0 ||
        declaration_origin_row >= symbols->declaration_origin_count) {
        die("declaration origin row is out of range");
    }
    int32_t source_row =
        symbols->declaration_origin_module_source_rows[
            declaration_origin_row];
    int32_t byte_offset =
        symbols->declaration_origin_token_byte_offsets[
            declaration_origin_row];
    if (source_row < 0 || byte_offset < 0)
        die("declaration origin pair is invalid");
    if (module_source_row) *module_source_row = source_row;
    if (token_byte_offset) *token_byte_offset = byte_offset;
}

static void cold_require_parser_object_canonical_mirror_exact(
        Symbols *symbols, ObjectDef *object) {
    if (!symbols || !object || !object->is_parser_declaration ||
        object->declaration_origin_row < 0 ||
        object->declaration_origin_row >=
            symbols->declaration_origin_count) {
        die("parser object provenance is invalid");
    }
    int32_t mirror_row =
        object->canonical_mirror_object_row;
    if (mirror_row < 0) return;
    int32_t object_row = symbols_object_index(symbols, object);
    if (object_row < 0 || mirror_row >= object_row ||
        mirror_row >= symbols->object_count) {
        die("parser object canonical mirror row is invalid");
    }
    ObjectDef *mirror = &symbols->objects[mirror_row];
    if (mirror->is_parser_declaration ||
        mirror->declaration_origin_row >= 0 ||
        mirror->canonical_mirror_object_row >= 0 ||
        !span_same(mirror->name, object->name) ||
        mirror->field_count != object->field_count ||
        mirror->slot_size != object->slot_size ||
        mirror->base_object_index != object->base_object_index ||
        mirror->inherited_field_count !=
            object->inherited_field_count ||
        mirror->generic_count != object->generic_count ||
        mirror->is_ref != object->is_ref) {
        die("parser object canonical mirror schema drift");
    }
    for (int32_t generic_index = 0;
         generic_index < object->generic_count;
         generic_index++) {
        if (!span_same(
                mirror->generic_names[generic_index],
                object->generic_names[generic_index])) {
            die("parser object canonical mirror generic drift");
        }
    }
    for (int32_t field_index = 0;
         field_index < object->field_count;
         field_index++) {
        ObjectField *expected =
            &mirror->fields[field_index];
        ObjectField *actual =
            &object->fields[field_index];
        if (!span_same(expected->name, actual->name) ||
            expected->kind != actual->kind ||
            expected->offset != actual->offset ||
            expected->size != actual->size ||
            expected->array_len != actual->array_len ||
            !span_same(
                span_trim(expected->type_name),
                span_trim(actual->type_name)) ||
            expected->has_default != actual->has_default ||
            !span_same(
                span_trim(expected->default_expr),
                span_trim(actual->default_expr))) {
            fprintf(
                stderr,
                "cheng_cold: parser object canonical mirror "
                "field drift object=%.*s field=%d "
                "expected_name=%.*s actual_name=%.*s "
                "expected_type=%.*s actual_type=%.*s "
                "expected_kind=%d actual_kind=%d "
                "expected_offset=%d actual_offset=%d "
                "expected_size=%d actual_size=%d "
                "expected_array_len=%d actual_array_len=%d "
                "expected_default=%d actual_default=%d\n",
                object->name.len, object->name.ptr,
                field_index,
                expected->name.len, expected->name.ptr,
                actual->name.len, actual->name.ptr,
                expected->type_name.len,
                expected->type_name.ptr,
                actual->type_name.len,
                actual->type_name.ptr,
                expected->kind, actual->kind,
                expected->offset, actual->offset,
                expected->size, actual->size,
                expected->array_len,
                actual->array_len,
                expected->has_default ? 1 : 0,
                actual->has_default ? 1 : 0);
            die("parser object canonical mirror field drift");
        }
    }
}

void parser_ws(Parser *parser) {
    for (;;) {
        while (parser->pos < parser->source.len) {
            uint8_t c = parser->source.ptr[parser->pos];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') break;
            parser->pos++;
        }
        if (parser->pos + 1 < parser->source.len &&
            parser->source.ptr[parser->pos] == '/' &&
            parser->source.ptr[parser->pos + 1] == '*') {
            parser->pos += 2;
            while (parser->pos + 1 < parser->source.len) {
                if (parser->source.ptr[parser->pos] == '*' &&
                    parser->source.ptr[parser->pos + 1] == '/') {
                    parser->pos += 2;
                    break;
                }
                parser->pos++;
            }
            continue;
        }
        if (parser->pos + 1 < parser->source.len &&
            parser->source.ptr[parser->pos] == '/' &&
            parser->source.ptr[parser->pos + 1] == '/') {
            while (parser->pos < parser->source.len && parser->source.ptr[parser->pos] != '\n') parser->pos++;
            continue;
        }
        if (parser->pos < parser->source.len && parser->source.ptr[parser->pos] == '#') {
            while (parser->pos < parser->source.len && parser->source.ptr[parser->pos] != '\n') parser->pos++;
            continue;
        }
        break;
    }
}

void parser_line(Parser *parser) {
    while (parser->pos < parser->source.len && parser->source.ptr[parser->pos] != '\n') parser->pos++;
    if (parser->pos < parser->source.len) parser->pos++;
}

Span parser_token(Parser *parser) {
    parser_ws(parser);
    if (parser->pos >= parser->source.len) return (Span){0};
    uint8_t c = parser->source.ptr[parser->pos];
    if (c == '"') {
        if (parser->pos + 2 < parser->source.len &&
            parser->source.ptr[parser->pos + 1] == '"' &&
            parser->source.ptr[parser->pos + 2] == '"') {
            int32_t start = parser->pos;
            parser->pos += 3;
            while (parser->pos < parser->source.len) {
                if (parser->pos + 2 < parser->source.len &&
                    parser->source.ptr[parser->pos] == '"' &&
                    parser->source.ptr[parser->pos + 1] == '"' &&
                    parser->source.ptr[parser->pos + 2] == '"') {
                    parser->pos += 3;
                    return span_sub(parser->source, start, parser->pos);
                }
                parser->pos++;
            }
            die("unterminated triple-quoted string");
        }
        int32_t start = parser->pos++;
        while (parser->pos < parser->source.len) {
            c = parser->source.ptr[parser->pos++];
            if (c == '\n' || c == '\r') return (Span){0}; /* unterminated string */
            if (c == '\\') {
                if (parser->pos >= parser->source.len) die("unterminated string escape");
                parser->pos++;
                continue;
            }
            if (c == '"') return span_sub(parser->source, start, parser->pos);
        }
        return (Span){0}; /* unterminated string */
    }
    if (c == '\'') {
        int32_t start = parser->pos++;
        while (parser->pos < parser->source.len) {
            c = parser->source.ptr[parser->pos++];
            if (c == '\n' || c == '\r') die("unterminated char literal");
            if (c == '\\') {
                if (parser->pos >= parser->source.len) die("unterminated char escape");
                parser->pos++;
                continue;
            }
            if (c == '\'') return span_sub(parser->source, start, parser->pos);
        }
        die("unterminated char literal");
    }
    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_') {
        int32_t start = parser->pos++;
        while (parser->pos < parser->source.len) {
            c = parser->source.ptr[parser->pos];
            if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
                  (c >= '0' && c <= '9') || c == '_')) break;
            parser->pos++;
        }
        return span_sub(parser->source, start, parser->pos);
    }
    if (c == '0' && parser->pos + 1 < parser->source.len &&
        (parser->source.ptr[parser->pos + 1] == 'x' || parser->source.ptr[parser->pos + 1] == 'X')) {
        int32_t start = parser->pos;
        parser->pos += 2;
        while (parser->pos < parser->source.len) {
            uint8_t h = parser->source.ptr[parser->pos];
            if ((h >= '0' && h <= '9') || (h >= 'a' && h <= 'f') || (h >= 'A' && h <= 'F')) {
                parser->pos++;
                continue;
            }
            /* digit separator: '_' only between hex digits (next char must be a hex digit),
               so a hex literal immediately followed by `_ident` still terminates cleanly. */
            if (h == '_' && parser->pos + 1 < parser->source.len) {
                uint8_t n = parser->source.ptr[parser->pos + 1];
                if ((n >= '0' && n <= '9') || (n >= 'a' && n <= 'f') || (n >= 'A' && n <= 'F')) {
                    parser->pos++;
                    continue;
                }
            }
            break;
        }
        return span_sub(parser->source, start, parser->pos);
    }
    if ((c >= '0' && c <= '9') ||
        (c == '-' && parser->pos + 1 < parser->source.len &&
         parser->source.ptr[parser->pos + 1] >= '0' &&
         parser->source.ptr[parser->pos + 1] <= '9' &&
         /* Don't absorb a leading '-' when it precedes a hex literal (`-0x...`):
            the hex token path below handles `0x...`, and leaving '-' as its own
            token lets parse_primary apply unary negation to the full hex value.
            Absorbing it as `-0` drops the hex part and yields 0. */
         !(parser->source.ptr[parser->pos + 1] == '0' &&
           parser->pos + 2 < parser->source.len &&
           (parser->source.ptr[parser->pos + 2] == 'x' ||
            parser->source.ptr[parser->pos + 2] == 'X')))) {
        int32_t start = parser->pos++;
        while (parser->pos < parser->source.len) {
            uint8_t d = parser->source.ptr[parser->pos];
            if (d >= '0' && d <= '9') { parser->pos++; continue; }
            /* digit separator: '_' only between decimal digits */
            if (d == '_' && parser->pos + 1 < parser->source.len &&
                parser->source.ptr[parser->pos + 1] >= '0' &&
                parser->source.ptr[parser->pos + 1] <= '9') {
                parser->pos++;
                continue;
            }
            break;
        }
        /* include decimal point and fractional digits for float literals */
        if (parser->pos < parser->source.len &&
            parser->source.ptr[parser->pos] == '.' &&
            parser->pos + 1 < parser->source.len &&
            parser->source.ptr[parser->pos + 1] >= '0' &&
            parser->source.ptr[parser->pos + 1] <= '9') {
            parser->pos++; /* consume '.' */
            while (parser->pos < parser->source.len) {
                uint8_t d = parser->source.ptr[parser->pos];
                if (d >= '0' && d <= '9') { parser->pos++; continue; }
                if (d == '_' && parser->pos + 1 < parser->source.len &&
                    parser->source.ptr[parser->pos + 1] >= '0' &&
                    parser->source.ptr[parser->pos + 1] <= '9') {
                    parser->pos++;
                    continue;
                }
                break;
            }
        }
        return span_sub(parser->source, start, parser->pos);
    }
    if (c == '=' && parser->pos + 1 < parser->source.len && parser->source.ptr[parser->pos + 1] == '>') {
        int32_t start = parser->pos;
        parser->pos += 2;
        return span_sub(parser->source, start, parser->pos);
    }
    if ((c == '&' || c == '|') &&
        parser->pos + 1 < parser->source.len &&
        parser->source.ptr[parser->pos + 1] == c) {
        int32_t start = parser->pos;
        parser->pos += 2;
        return span_sub(parser->source, start, parser->pos);
    }
    if (c == '<' && parser->pos + 1 < parser->source.len &&
        parser->source.ptr[parser->pos + 1] == '<') {
        int32_t start = parser->pos;
        parser->pos += 2;
        return span_sub(parser->source, start, parser->pos);
    }
    if (c == '>' && parser->pos + 1 < parser->source.len &&
        parser->source.ptr[parser->pos + 1] == '>') {
        int32_t start = parser->pos;
        parser->pos += 2;
        return span_sub(parser->source, start, parser->pos);
    }
    if ((c == '=' || c == '!' || c == '<' || c == '>') &&
        parser->pos + 1 < parser->source.len &&
        parser->source.ptr[parser->pos + 1] == '=') {
        int32_t start = parser->pos;
        parser->pos += 2;
        return span_sub(parser->source, start, parser->pos);
    }
    int32_t start = parser->pos++;
    return span_sub(parser->source, start, parser->pos);
}

Span parser_peek(Parser *parser) {
    int32_t saved = parser->pos;
    Span token = parser_token(parser);
    parser->pos = saved;
    return token;
}

void parser_inline_ws(Parser *parser) {
    while (parser->pos < parser->source.len) {
        uint8_t c = parser->source.ptr[parser->pos];
        if (c != ' ' && c != '\t') break;
        parser->pos++;
    }
}

bool parser_take(Parser *parser, const char *text) {
    Span token = parser_token(parser);
    return span_eq(token, text);
}

void parser_skip_balanced(Parser *parser, const char *open, const char *close) {
    if (!parser_take(parser, open)) return;
    int32_t depth = 1;
    while (depth > 0 && parser->pos < parser->source.len) {
        Span token = parser_token(parser);
        if (span_eq(token, open)) depth++;
        else if (span_eq(token, close)) depth--;
        else if (token.len == 0) break;
    }
}

Span cold_type_strip_optional(Span type) {
    type = span_trim(type);
    if (type.len > 0 && type.ptr[type.len - 1] == '?') {
        return span_sub(type, 0, type.len - 1);
    }
    return type;
}

Span parser_take_type_span(Parser *parser) {
    parser_ws(parser);
    int32_t type_start = parser->pos;
    Span first = parser_token(parser);
    if (first.len <= 0) die("expected type");
    Span after_var = first; /* track the base type after stripping var */
    if (span_eq(first, "var")) {
        Span inner = parser_token(parser);
        if (inner.len <= 0) die("expected type after var");
        after_var = inner;
    }
    for (;;) {
        if (span_eq(parser_peek(parser), "[")) {
            parser_skip_balanced(parser, "[", "]");
            continue;
        }
        if (span_eq(parser_peek(parser), "<")) {
            parser_skip_balanced(parser, "<", ">");
            continue;
        }
        if (span_eq(parser_peek(parser), ".")) {
            (void)parser_token(parser);
            Span part = parser_token(parser);
            if (part.len <= 0) die("expected qualified type segment");
            continue;
        }
        if (span_eq(parser_peek(parser), "*")) {
            (void)parser_token(parser);
            continue;
        }
        if (span_eq(parser_peek(parser), "?")) {
            (void)parser_token(parser);
            continue;
        }
        /* typeof(expr): consume the parenthesized expression verbatim so the
           full typeof(...) text becomes the type span for downstream resolution. */
        if (span_eq(after_var, "typeof") && span_eq(parser_peek(parser), "(")) {
            parser_skip_balanced(parser, "(", ")");
            continue;
        }
        /* function type: fn(params): ret_type */
        if (span_eq(after_var, "fn") && span_eq(parser_peek(parser), "(")) {
            parser_skip_balanced(parser, "(", ")");
            parser_ws(parser);
            if (span_eq(parser_peek(parser), ":")) {
                (void)parser_token(parser);
                parser_ws(parser);
                after_var = parser_token(parser); /* return type's first token */
                continue; /* continue loop for [bracketed] and .qualified suffixes on return type */
            }
            break; /* fn type without return type (unusual but valid) */
        }
        break;
    }
    return span_trim(span_sub(parser->source, type_start, parser->pos));
}

int32_t cold_param_kind_from_type(Span type) {
    bool is_var = false;
    type = cold_type_strip_var(type, &is_var);
    type = cold_type_strip_optional(type);
    /* #105 root fix: a `fn(...)` signature is an unambiguous PREFIX marker
       (no other declared type spells it -- every other call site in this
       file uses cold_span_starts_with(type, "fn(") as the sole discriminator
       for "this is a function type"), so it must be classified before any
       SUFFIX-based heuristic below gets a chance to misfire on the tail of
       its own parameter list or return type text (e.g. an array-returning
       signature `fn(items: T[]): T[]` ending in "[]" was being caught by the
       opaque-seq suffix check a few lines down and misclassified as
       SLOT_SEQ_OPAQUE instead of SLOT_PTR, desyncing the formal param's kind
       from the SLOT_PTR every fn-value argument always carries and making
       the call unresolvable). Moving the check first, ahead of every
       suffix-based rule, removes the ordering hazard structurally instead of
       chasing individual suffix collisions. */
    if (cold_fn_sig_is_type(type))
        return is_var ? SLOT_OBJECT_REF : SLOT_PTR;
    if (is_var && (span_eq(type, "int64") || span_eq(type, "uint64") ||
                   span_eq(type, "uint"))) return SLOT_I64_REF;
    if (is_var && (span_eq(type, "int32") || span_eq(type, "int") ||
                   span_eq(type, "bool") || span_eq(type, "uint8") ||
                   span_eq(type, "int8") ||
                   span_eq(type, "char") || span_eq(type, "uint16") ||
                   span_eq(type, "int16") || span_eq(type, "uint32"))) return SLOT_I32_REF;
    if (is_var && span_eq(type, "str")) return SLOT_STR_REF;
    if (is_var && (span_eq(type, "utf8_view") || span_eq(type, "bytes_view"))) return SLOT_STR_REF;
    if (is_var && span_eq(type, "cstring")) return SLOT_OPAQUE_REF;
    if (is_var && cold_parse_i32_seq_type(type)) return SLOT_SEQ_I32_REF;
    if (is_var && cold_parse_str_seq_type(type)) return SLOT_SEQ_STR_REF;
    if (cold_type_has_pointer_suffix(type))
        return is_var ? SLOT_OPAQUE_REF : SLOT_OPAQUE;
    if (is_var && cold_type_has_qualified_name(type)) return SLOT_OPAQUE_REF;
    if (is_var) return SLOT_OBJECT_REF;
    if (type.len == 0 || span_eq(type, "i") || span_eq(type, "int32") ||
        span_eq(type, "int") || span_eq(type, "bool") ||
        span_eq(type, "uint8") || span_eq(type, "int8") ||
        span_eq(type, "char") || span_eq(type, "uint16") ||
        span_eq(type, "int16") ||
        span_eq(type, "uint32") || span_eq(type, "void")) {
        return SLOT_I32;
    }
    if (span_eq(type, "int64") || span_eq(type, "uint64") ||
        span_eq(type, "uint")) return SLOT_I64;
    if (span_eq(type, "float32") || span_eq(type, "Float32")) return SLOT_F32;
    if (span_eq(type, "float64") || span_eq(type, "Float64")) return SLOT_F64;
    if (span_eq(type, "s") || span_eq(type, "str")) {
        return SLOT_STR;
    }
    if (span_eq(type, "utf8_view") || span_eq(type, "bytes_view")) {
        return SLOT_STR;
    }
    if (span_eq(type, "owned_cstring")) {
        return SLOT_STR;
    }
    if (span_eq(type, "cstring")) return SLOT_OPAQUE;
    if (span_eq(type, "v")) return SLOT_VARIANT;
    if (cold_parse_i32_seq_type(type)) return SLOT_SEQ_I32;
    if (cold_parse_str_seq_type(type)) return SLOT_SEQ_STR;
    if (cold_parse_opaque_seq_type(type)) return SLOT_SEQ_OPAQUE;
    if (cold_parse_any_fixed_array_type(0, type, 0, 0)) return SLOT_ARRAY_I32;
    if (span_eq(type, "ptr")) return SLOT_OPAQUE;
    /* fn(...) is handled unconditionally at the top of this function now
       (see #105 root-fix comment above); unreachable here by construction. */
    if (span_eq(type, "o") || cold_type_has_qualified_name(type)) return SLOT_OPAQUE;
    if (type.len > 1 && type.ptr[0] >= 'A' && type.ptr[0] <= 'Z') return SLOT_VARIANT;
    if (cold_parse_i32_array_type(type, 0)) return SLOT_ARRAY_I32;
    return 'i'; /* default to int32 */
    return SLOT_I32;
}

bool cold_parse_uint8_fixed_array_type(Symbols *symbols, Span type, int32_t *len_out) {
    type = span_trim(cold_type_strip_var(type, 0));
    if (!cold_span_starts_with(type, "uint8[")) return false;
    if (span_eq(type, "uint8[]")) return false;
    if (type.len < 8 || type.ptr[type.len - 1] != ']') return false;
    Span count = span_trim(span_sub(type, 6, type.len - 1));
    int32_t len = 0;
    if (span_is_i32(count)) {
        len = span_i32(count);
    } else if (symbols) {
        ConstDef *constant = symbols_find_const(symbols, count);
        if (constant && !cold_const_i32_value(constant, &len))
            die("cold fixed array length const must be int32");
    }
    if (len <= 0) die("cold uint8 fixed array length must be positive");
    if (len_out) *len_out = len;
    return true;
}

bool cold_parse_fixed_array_type(Symbols *symbols, Span type, int32_t *len_out) {
    if (cold_parse_i32_array_type(type, len_out)) return true;
    if (cold_parse_uint8_fixed_array_type(symbols, type, len_out)) return true;
    return cold_parse_any_fixed_array_type(symbols, type, 0, len_out);
}

#ifndef COLD_CHENG_INCLUDE
bool cold_parse_any_fixed_array_type(Symbols *symbols, Span type,
                                     Span *element_type_out,
                                     int32_t *len_out) {
    type = span_trim(cold_type_strip_var(type, 0));
    if (type.len < 4 || type.ptr[type.len - 1] != ']') return false;
    if (type.len >= 2 && type.ptr[type.len - 2] == '[') return false;
    int32_t lb = -1;
    for (int32_t i = type.len - 2; i >= 0; i--) {
        if (type.ptr[i] == '[') {
            lb = i;
            break;
        }
    }
    if (lb <= 0) return false;
    Span element_type = span_trim(span_sub(type, 0, lb));
    Span count = span_trim(span_sub(type, lb + 1, type.len - 1));
    if (element_type.len <= 0 || count.len <= 0) return false;
    int32_t len = 0;
    if (span_is_i32(count)) {
        len = span_i32(count);
    } else if (symbols) {
        ConstDef *constant = symbols_find_const(symbols, count);
        if (constant) {
            if (!cold_const_i32_value(constant, &len))
                die("cold fixed array length const must be int32");
        } else {
            /* inline arithmetic count, e.g. Slot[N*16] without a named const */
            int32_t v = 0;
            if (cold_eval_i32_const_expr(symbols, count, &v)) len = v;
        }
    }
    if (len <= 0) return false;
    if (element_type_out) *element_type_out = element_type;
    if (len_out) *len_out = len;
    return true;
}

int32_t cold_fixed_array_element_size(Symbols *symbols, Span type) {
    Span element_type = {0};
    int32_t len = 0;
    if (!cold_parse_any_fixed_array_type(symbols, type, &element_type, &len)) return 0;
    if (span_eq(element_type, "uint8") || span_eq(element_type, "int8") ||
        span_eq(element_type, "char") || span_eq(element_type, "bool")) {
        return 1;
    }
    if (span_eq(element_type, "uint16") || span_eq(element_type, "int16")) {
        return 2;
    }
    int32_t element_kind = cold_slot_kind_from_type_with_symbols(symbols, element_type);
    return cold_slot_size_from_type_with_symbols(symbols, element_type, element_kind);
}
#endif

int32_t cold_parser_slot_kind_from_type(Symbols *symbols, Span type) {
    bool is_var = false;
    Span stripped = span_trim(cold_type_strip_var(type, &is_var));
    stripped = cold_type_strip_optional(stripped);
    /* #105 root fix: same ordering hazard as cold_param_kind_from_type /
       cold_slot_kind_from_type_with_symbols -- this wrapper's own opaque-seq
       shortcut must not fire ahead of the unambiguous `fn(` prefix check, or
       an array-returning/array-typed-param signature (e.g.
       `fn(items: T[]): T[]`) gets misclassified as SLOT_SEQ_OPAQUE here
       before ever reaching either (now-fixed) delegate below. */
    if (cold_fn_sig_is_type(stripped))
        return is_var ? SLOT_OBJECT_REF : SLOT_PTR;
    if (cold_parse_opaque_seq_type(stripped)) {
        /* A transparent element alias is the builtin sequence type, not a
           second opaque-sequence identity domain.  Resolve the element at
           the parser-owned type boundary before a BodyIR slot or TypeId is
           published; call matching already treats these aliases as the
           builtin ABI, so delaying the collapse until a call would leave
           field projections with a conflicting immutable definition. */
        if (cold_dynamic_seq_element_alias_resolves_to(
                symbols, stripped, "int32", "int")) {
            return is_var ? SLOT_SEQ_I32_REF : SLOT_SEQ_I32;
        }
        if (cold_dynamic_seq_element_alias_resolves_to(
                symbols, stripped, "str", "cstring")) {
            return is_var ? SLOT_SEQ_STR_REF : SLOT_SEQ_STR;
        }
        return is_var ? SLOT_SEQ_OPAQUE_REF : SLOT_SEQ_OPAQUE;
    }
    /* Primitive pointer-cast type names (Int32Ptr/UInt32Ptr/VoidPtrPtr/Int8Ptr..
       BoolPtr) used directly as a declared type annotation: classify as SLOT_PTR
       so `let ep: Int32Ptr = Int32Ptr(raw)` matches the cast's SLOT_PTR result
       (parse_primitive_pointer_cast).  Only intercept when the name is NOT a
       known local alias — files that declare `Int32Ptr = int32 *` keep their
       existing alias→SLOT_OPAQUE classification (byte-identical old path). */
    if (symbols && !symbols_resolve_type(symbols, stripped) &&
        cold_primitive_pointer_cast_type(stripped).len > 0) {
        return SLOT_PTR;
    }
    if (symbols) return cold_slot_kind_from_type_with_symbols(symbols, type);
    return cold_param_kind_from_type(type);
}

/* Sequence element semantics are nominal even when a ref object is carried
   by one machine pointer.  Keep that logical identity separate from the
   physical slot kind so ownership/drop decisions never classify a ref
   object as an unmanaged pointer. */
static int32_t cold_sequence_logical_element_kind(
        Symbols *symbols, Span element_type,
        ObjectDef **object_out) {
    if (object_out) *object_out = 0;
    int32_t carrier_kind =
        cold_parser_slot_kind_from_type(symbols, element_type);
    /* Builtin scalar/str/sequence carriers are never object elements.
       std/system.cheng declares a layout object literally named `str`;
       resolving the builtin str type must not be captured by that
       declaration (its carrier stays SLOT_STR). */
    if (carrier_kind != SLOT_OBJECT &&
        carrier_kind != SLOT_OBJECT_REF &&
        carrier_kind != SLOT_PTR &&
        carrier_kind != SLOT_OPAQUE_REF) {
        return carrier_kind;
    }
    ObjectDef *object =
        symbols && element_type.len > 0
            ? symbols_resolve_object(symbols, element_type)
            : 0;
    if (!object) return carrier_kind;
    int32_t object_row = symbols_object_index(symbols, object);
    if (object_row < 0 ||
        object_row >= symbols->object_count) {
        die("sequence element object identity is invalid");
    }
    object_row = cold_canonical_object_identity(
        symbols, object_row);
    if (object_row < 0 ||
        object_row >= symbols->object_count) {
        die("sequence element canonical object identity is invalid");
    }
    object = &symbols->objects[object_row];
    if (object->is_ref) {
        if (carrier_kind != SLOT_PTR &&
            carrier_kind != SLOT_OBJECT_REF &&
            carrier_kind != SLOT_OPAQUE_REF) {
            die("ref object sequence element carrier is invalid");
        }
        if (object_out) *object_out = object;
        return SLOT_OBJECT_REF;
    }
    if (carrier_kind != SLOT_OBJECT) {
        fprintf(stderr,
                "cheng_cold: value object element carrier rejected "
                "carrier_kind=%d element_type=%.*s\n",
                carrier_kind,
                (int)element_type.len,
                element_type.ptr
                    ? (const char *)element_type.ptr : "");
        die("value object sequence element carrier is invalid");
    }
    if (object_out) *object_out = object;
    return SLOT_OBJECT;
}

static int32_t cold_sequence_element_carrier_kind(
        int32_t logical_kind) {
    return logical_kind == SLOT_OBJECT_REF
               ? SLOT_PTR
               : logical_kind;
}

static bool cold_sequence_element_carrier_matches(
        int32_t logical_kind, int32_t carrier_kind) {
    if (logical_kind == SLOT_OBJECT_REF) {
        return carrier_kind == SLOT_PTR ||
               carrier_kind == SLOT_OBJECT_REF ||
               carrier_kind == SLOT_OPAQUE_REF;
    }
    return carrier_kind == logical_kind;
}

static int32_t cold_parser_slot_kind_from_type_in_generic_scope(
        Symbols *symbols, Span type,
        const Span *generic_names,
        int32_t generic_count,
        int32_t generic_binder_kind,
        int32_t generic_binder_id) {
    if (generic_count < 0 ||
        generic_count > COLD_MAX_VARIANT_FIELDS ||
        (generic_count > 0 && !generic_names) ||
        !cold_generic_scope_owner_valid(
            symbols, generic_names, generic_count,
            generic_binder_kind,
            generic_binder_id)) {
        die("cold parser generic type scope is invalid");
    }
    bool generic_is_var = false;
    if (cold_type_matches_generic_names(
            type, generic_names,
            generic_count, &generic_is_var)) {
        return generic_is_var
            ? SLOT_I32_REF : SLOT_I32;
    }
    bool is_var = false;
    Span stripped =
        span_trim(cold_type_strip_var(type, &is_var));
    if (cold_fn_sig_is_type(stripped)) {
        return is_var
            ? SLOT_OBJECT_REF : SLOT_PTR;
    }
    if (cold_parse_opaque_seq_type(stripped)) {
        if (cold_dynamic_seq_element_alias_resolves_to(
                symbols, stripped, "int32", "int")) {
            return is_var
                ? SLOT_SEQ_I32_REF
                : SLOT_SEQ_I32;
        }
        if (cold_dynamic_seq_element_alias_resolves_to(
                symbols, stripped, "str", "cstring")) {
            return is_var
                ? SLOT_SEQ_STR_REF
                : SLOT_SEQ_STR;
        }
        return is_var
            ? SLOT_SEQ_OPAQUE_REF
            : SLOT_SEQ_OPAQUE;
    }
    if (symbols &&
        !symbols_resolve_type(symbols, stripped) &&
        cold_primitive_pointer_cast_type(
            stripped).len > 0) {
        return SLOT_PTR;
    }
    if (!symbols)
        return cold_param_kind_from_type(type);
    ColdAliasChaseVisit scope = {0};
    if (generic_count > 0) {
        scope.generic_names = generic_names;
        scope.generic_count = generic_count;
        scope.generic_binder_kind =
            generic_binder_kind;
        scope.generic_binder_id =
            generic_binder_id;
    }
    return cold_slot_kind_from_type_with_symbols_visit(
        symbols, type,
        generic_count > 0 ? &scope : NULL);
}

int32_t cold_parser_slot_size_from_type(Symbols *symbols, Span type, int32_t kind) {
    bool is_var = false;
    Span stripped = span_trim(cold_type_strip_var(type, &is_var));
    if (cold_parse_opaque_seq_type(stripped)) {
        if (kind == SLOT_SEQ_OPAQUE_REF) return 8;
        if (kind == SLOT_SEQ_OPAQUE) return 16;
    }
    return cold_slot_size_from_type_with_symbols(symbols, type, kind);
}

static int32_t cold_parser_slot_size_from_type_in_generic_scope(
        Symbols *symbols, Span type, int32_t kind,
        const Span *generic_names, int32_t generic_count,
        int32_t generic_binder_kind,
        int32_t generic_binder_id) {
    if (generic_count < 0 ||
        generic_count > COLD_MAX_VARIANT_FIELDS ||
        (generic_count > 0 && !generic_names) ||
        !cold_generic_scope_owner_valid(
            symbols, generic_names, generic_count,
            generic_binder_kind,
            generic_binder_id)) {
        die("cold slot size generic scope is invalid");
    }
    bool is_var = false;
    Span stripped =
        span_trim(cold_type_strip_var(type, &is_var));
    if (cold_parse_opaque_seq_type(stripped)) {
        if (kind == SLOT_SEQ_OPAQUE_REF) return 8;
        if (kind == SLOT_SEQ_OPAQUE) return 16;
    }
    ColdAliasChaseVisit scope = {0};
    if (generic_count > 0) {
        scope.generic_names = generic_names;
        scope.generic_count = generic_count;
        scope.generic_binder_kind =
            generic_binder_kind;
        scope.generic_binder_id =
            generic_binder_id;
    }
    return cold_slot_size_from_type_with_symbols_visit(
        symbols, type, kind,
        generic_count > 0 ? &scope : NULL);
}

static int32_t cold_payload_size_from_type_in_generic_scope(
        Symbols *symbols, Span type, int32_t kind,
        const Span *generic_names, int32_t generic_count,
        int32_t generic_binder_kind,
        int32_t generic_binder_id) {
    if (generic_count < 0 ||
        generic_count > COLD_MAX_VARIANT_FIELDS ||
        (generic_count > 0 && !generic_names) ||
        !cold_generic_scope_owner_valid(
            symbols, generic_names, generic_count,
            generic_binder_kind,
            generic_binder_id)) {
        die("cold payload size generic scope is invalid");
    }
    ColdAliasChaseVisit scope = {0};
    if (generic_count > 0) {
        scope.generic_names = generic_names;
        scope.generic_count = generic_count;
        scope.generic_binder_kind =
            generic_binder_kind;
        scope.generic_binder_id =
            generic_binder_id;
    }
    return cold_payload_size_from_type_with_symbols_visit(
        symbols, type, kind,
        generic_count > 0 ? &scope : NULL);
}

static int32_t cold_param_size_from_type_visit(
        Symbols *symbols, Span type, int32_t kind,
        ColdAliasChaseVisit *visiting) {
    bool is_var = false;
    type = cold_type_strip_var(type, &is_var);
    /* bool params carry their 1-byte ABI size so Darwin arm64 packed stack
       placement (cold_abi_arg_storage_bytes) sees the natural size.  The
       frame slot still reserves 4 bytes (body_slot aligns to 4). */
    if (kind == SLOT_I32) return span_eq(span_trim(type), "bool") ? 1 : 4;
    if (kind == SLOT_I64) return 8;
    if (kind == SLOT_F32) return 4;
    if (kind == SLOT_F64) return 8;
    if (kind == SLOT_STR) return COLD_STR_SLOT_SIZE;
    if (kind == SLOT_I32_REF || kind == SLOT_I64_REF ||
        kind == SLOT_SEQ_I32_REF || kind == SLOT_OBJECT_REF ||
        kind == SLOT_STR_REF || kind == SLOT_SEQ_STR_REF ||
        kind == SLOT_SEQ_OPAQUE_REF ||
        kind == SLOT_OPAQUE || kind == SLOT_OPAQUE_REF) return 8;
    if (kind == SLOT_OBJECT) {
        return symbols
            ? symbols_object_slot_size(
                  symbols_resolve_object_visit(
                      symbols, type, visiting))
            : 0;
    }
    if (kind == SLOT_ARRAY_I32) {
        return cold_slot_size_from_type_with_symbols_visit(
            symbols, type, kind, visiting);
    }
    if (kind == SLOT_SEQ_I32) return 16;
    if (kind == SLOT_SEQ_STR) return 16;
    if (kind == SLOT_SEQ_OPAQUE) return 16;
    if (kind == SLOT_VARIANT) {
        if (symbols && !span_eq(type, "v")) {
            TypeDef *def = symbols_resolve_type(symbols, type);
            if (!def) return 64; /* unknown variant, use default size */
            return symbols_type_slot_size(def);
        }
        return type.len > 0 && !span_eq(type, "v") ? 0 : cold_slot_size_for_kind(SLOT_VARIANT);
    }
    return 8; /* default to pointer-sized */
    return 4;
}

int32_t cold_param_size_from_type(
        Symbols *symbols, Span type, int32_t kind) {
    return cold_param_size_from_type_visit(
        symbols, type, kind, NULL);
}

static int32_t cold_param_size_from_type_in_generic_scope(
        Symbols *symbols, Span type, int32_t kind,
        const Span *generic_names, int32_t generic_count,
        int32_t generic_binder_kind,
        int32_t generic_binder_id) {
    if (generic_count < 0 ||
        generic_count > COLD_MAX_VARIANT_FIELDS ||
        (generic_count > 0 && !generic_names) ||
        !cold_generic_scope_owner_valid(
            symbols, generic_names, generic_count,
            generic_binder_kind,
            generic_binder_id)) {
        die("cold parameter size generic scope is invalid");
    }
    ColdAliasChaseVisit scope = {0};
    if (generic_count > 0) {
        scope.generic_names = generic_names;
        scope.generic_count = generic_count;
        scope.generic_binder_kind =
            generic_binder_kind;
        scope.generic_binder_id =
            generic_binder_id;
    }
    return cold_param_size_from_type_visit(
        symbols, type, kind,
        generic_count > 0 ? &scope : NULL);
}


int32_t cold_arg_reg_count(int32_t kind, int32_t size) {
    if (kind == SLOT_I32 || kind == SLOT_I64 || kind == SLOT_I32_REF || kind == SLOT_I64_REF) return 1;
    if (kind == SLOT_F32 || kind == SLOT_F64) return 1;
    if (kind == SLOT_PTR) return 1;
    if (kind == SLOT_STR) return 2;
    if (kind == SLOT_VARIANT) return size > 16 ? 1 : 2;
    if (kind == SLOT_OBJECT || kind == SLOT_ARRAY_I32) return size > 16 ? 1 : 2;
    if (kind == SLOT_SEQ_I32) return 2;
    if (kind == SLOT_SEQ_STR) return 2;
    if (kind == SLOT_SEQ_OPAQUE) return 2;
    if (kind == SLOT_I32_REF ||
        kind == SLOT_SEQ_I32_REF || kind == SLOT_OBJECT_REF ||
        kind == SLOT_STR_REF || kind == SLOT_SEQ_STR_REF ||
        kind == SLOT_SEQ_OPAQUE_REF ||
        kind == SLOT_OPAQUE || kind == SLOT_OPAQUE_REF) return 1;
    fprintf(stderr,
            "cheng_cold: unsupported cold call ABI kind=%d size=%d\n",
            kind, size);
    die("unsupported cold call ABI kind");
    return 1;
}

static bool cold_type_matches_generic_names(Span type, const Span *generic_names,
                                             int32_t generic_count,
                                            bool *is_var_out) {
    bool is_var = false;
    Span stripped = span_trim(cold_type_strip_var(type, &is_var));
    if (is_var_out) *is_var_out = is_var;
    for (int32_t gi = 0; gi < generic_count; gi++) {
        if (span_same(stripped, generic_names[gi])) return true;
    }
    return false;
}

Span cold_arena_join3(Arena *arena, Span a, const char *mid, Span b);

int32_t parse_param_specs_with_generics(Symbols *symbols, Span params,
                                               Span *generic_names,
                                               int32_t generic_count,
                                               int32_t generic_binder_kind,
                                               int32_t generic_binder_id,
                                               Span *names,
                                               int32_t *kinds,
                                               int32_t *sizes, Span *types,
                                               int32_t cap) {
    Parser parser = symbols
        ? cold_parser_issue_legacy_span(symbols, params)
        : cold_parser_issue_lexical_span(0, params);
    int32_t count = 0;
    int32_t group_start = 0;
    while (parser.pos < parser.source.len) {
        Span name = parser_token(&parser);
        if (name.len == 0) break;
        if (span_eq(name, ",")) continue;
        if (count >= cap) die("cold prototype supports at most 32 params");
        int32_t kind = SLOT_I32;
        Span type = cold_cstr_span("int32");
        bool has_explicit_type = false;
        if (span_eq(parser_peek(&parser), ":")) {
            (void)parser_token(&parser);
            type = parser_take_type_span(&parser);
            if (symbols && span_eq(parser_peek(&parser), "*")) {
                (void)parser_token(&parser);
                type = cold_arena_join3(symbols->arena, type, "", cold_cstr_span("*"));
            }
            bool generic_is_var = false;
            if (cold_type_matches_generic_names(type, generic_names,
                                                generic_count, &generic_is_var)) {
                kind = generic_is_var ? SLOT_I32_REF : SLOT_I32;
            } else {
                kind = cold_param_kind_from_type(type);
                if (symbols) {
                    kind =
                        cold_parser_slot_kind_from_type_in_generic_scope(
                            symbols, type,
                            generic_names,
                            generic_count,
                            generic_binder_kind,
                            generic_binder_id);
                }
            }
            has_explicit_type = true;
        }
        names[count] = name;
        if (kinds) kinds[count] = kind;
        if (sizes) sizes[count] = cold_type_matches_generic_names(type, generic_names,
                                                                  generic_count, 0)
            ? (kind == SLOT_I32_REF ? 8 : 4)
            : cold_param_size_from_type_in_generic_scope(
                  symbols, type, kind,
                  generic_names, generic_count,
                  generic_binder_kind,
                  generic_binder_id);
        if (types) types[count] = span_trim(type);
        count++;
        if (has_explicit_type) {
            int32_t explicit_size = cold_type_matches_generic_names(type, generic_names,
                                                                    generic_count, 0)
                ? (kind == SLOT_I32_REF ? 8 : 4)
                : cold_param_size_from_type_in_generic_scope(
                      symbols, type, kind,
                      generic_names, generic_count,
                      generic_binder_kind,
                      generic_binder_id);
            for (int32_t pi = group_start; pi < count; pi++) {
                if (kinds) kinds[pi] = kind;
                if (sizes) sizes[pi] = explicit_size;
                if (types) types[pi] = span_trim(type);
            }
            group_start = count;
        }
        while (parser.pos < parser.source.len &&
               !span_eq(parser_peek(&parser), ",") &&
               !span_eq(parser_peek(&parser), ")")) {
            (void)parser_token(&parser);
        }
        if (span_eq(parser_peek(&parser), ",")) (void)parser_token(&parser);
    }
    return count;
}

int32_t parse_param_specs(Symbols *symbols, Span params, Span *names,
                                 int32_t *kinds, int32_t *sizes, Span *types,
                                 int32_t cap) {
    return parse_param_specs_with_generics(
        symbols, params, 0, 0,
        COLD_GENERIC_BINDER_NONE, -1,
        names, kinds, sizes, types, cap);
}

Span cold_arena_span_copy(Arena *arena, Span text) {
    uint8_t *ptr = arena_alloc(arena, (size_t)(text.len + 1));
    if (text.len > 0) memcpy(ptr, text.ptr, (size_t)text.len);
    ptr[text.len] = 0;
    return (Span){ptr, text.len};
}

Span cold_arena_join3(Arena *arena, Span a, const char *mid, Span b) {
    int32_t mid_len = (int32_t)strlen(mid);
    int32_t len = a.len + mid_len + b.len;
    uint8_t *ptr = arena_alloc(arena, (size_t)(len + 1));
    int32_t pos = 0;
    if (a.len > 0) {
        memcpy(ptr + pos, a.ptr, (size_t)a.len);
        pos += a.len;
    }
    if (mid_len > 0) {
        memcpy(ptr + pos, mid, (size_t)mid_len);
        pos += mid_len;
    }
    if (b.len > 0) {
        memcpy(ptr + pos, b.ptr, (size_t)b.len);
        pos += b.len;
    }
    ptr[len] = 0;
    return (Span){ptr, len};
}

static Span cold_arena_fixed_array_type(Arena *arena, Span element_type,
                                        int32_t count) {
    if (!arena || element_type.len <= 0 || count <= 0)
        die("fixed array literal type requires element and count");
    char count_text[16];
    int count_len = snprintf(count_text, sizeof(count_text), "%d", count);
    if (count_len <= 0 || count_len >= (int)sizeof(count_text))
        die("fixed array literal count text overflow");
    int32_t len = element_type.len + count_len + 2;
    uint8_t *ptr = arena_alloc(arena, (size_t)(len + 1));
    memcpy(ptr, element_type.ptr, (size_t)element_type.len);
    ptr[element_type.len] = '[';
    memcpy(ptr + element_type.len + 1, count_text, (size_t)count_len);
    ptr[len - 1] = ']';
    ptr[len] = 0;
    return (Span){ptr, len};
}

bool cold_type_is_builtin_surface(Span type) {
    bool is_var = false;
    type = cold_type_strip_var(type, &is_var);
    if (type.len > 2 && type.ptr[type.len - 2] == '[' &&
        type.ptr[type.len - 1] == ']') {
        Span elem = span_trim(span_sub(type, 0, type.len - 2));
        if (elem.len > 0 && !cold_type_is_dynamic_seq_type(elem)) {
            return cold_type_is_builtin_surface(elem);
        }
    }
    return type.len == 0 ||
           span_eq(type, "int32") || span_eq(type, "int") ||
           span_eq(type, "bool") || span_eq(type, "uint8") ||
           span_eq(type, "int8") ||
           span_eq(type, "char") || span_eq(type, "uint16") ||
           span_eq(type, "int16") || span_eq(type, "uint32") ||
           span_eq(type, "uint64") || span_eq(type, "int64") ||
           span_eq(type, "uint") ||
           /* float32/float64 are surface builtins (slot kinds F32/F64);
              omitting them made import type collection qualify alias
              targets like `Frac = float32` into alias.float32, which can
              never resolve and degraded such params to SLOT_OPAQUE. */
           span_eq(type, "float32") || span_eq(type, "Float32") ||
           span_eq(type, "float64") || span_eq(type, "Float64") ||
           span_eq(type, "void") || span_eq(type, "str") ||
           span_eq(type, "cstring") || span_eq(type, "utf8_view") ||
           span_eq(type, "bytes_view") || span_eq(type, "owned_cstring") ||
           span_eq(type, "ptr") ||
           cold_type_has_pointer_suffix(type) ||
           span_eq(type, "Bytes") ||
           cold_fn_sig_is_type(type) ||
           cold_parse_i32_seq_type(type) || cold_parse_str_seq_type(type);
}

bool cold_import_type_keeps_unqualified_base(Span base) {
    return span_eq(base, "Result") || span_eq(base, "ErrorInfo");
}

Span cold_join_generic_instance(Arena *arena, Span base, Span *args, int32_t arg_count) {
    int32_t len = base.len + 2;
    for (int32_t i = 0; i < arg_count; i++) {
        len += args[i].len;
        if (i + 1 < arg_count) len++;
    }
    uint8_t *ptr = arena_alloc(arena, (size_t)len + 1);
    int32_t pos = 0;
    memcpy(ptr + pos, base.ptr, (size_t)base.len);
    pos += base.len;
    ptr[pos++] = '[';
    for (int32_t i = 0; i < arg_count; i++) {
        memcpy(ptr + pos, args[i].ptr, (size_t)args[i].len);
        pos += args[i].len;
        if (i + 1 < arg_count) ptr[pos++] = ',';
    }
    ptr[pos++] = ']';
    ptr[pos] = 0;
    return (Span){ptr, pos};
}

static Span cold_join_fixed_array_type(Arena *arena, Span element_type, Span count_expr) {
    int32_t len = element_type.len + 2 + count_expr.len;
    uint8_t *ptr = arena_alloc(arena, (size_t)len + 1);
    int32_t pos = 0;
    memcpy(ptr + pos, element_type.ptr, (size_t)element_type.len);
    pos += element_type.len;
    ptr[pos++] = '[';
    memcpy(ptr + pos, count_expr.ptr, (size_t)count_expr.len);
    pos += count_expr.len;
    ptr[pos++] = ']';
    ptr[pos] = 0;
    return (Span){ptr, pos};
}

static bool cold_type_split_bracket_suffix(Span type, Span *base_out, Span *inside_out) {
    type = span_trim(cold_type_strip_var(type, 0));
    if (type.len < 4 || type.ptr[type.len - 1] != ']') return false;
    int32_t depth = 0;
    int32_t bracket = -1;
    for (int32_t i = type.len - 1; i >= 0; i--) {
        uint8_t c = type.ptr[i];
        if (c == ']') {
            depth++;
        } else if (c == '[') {
            depth--;
            if (depth == 0) {
                bracket = i;
                break;
            }
            if (depth < 0) return false;
        }
    }
    if (bracket <= 0 || depth != 0) return false;
    Span base = span_trim(span_sub(type, 0, bracket));
    Span inside = span_trim(span_sub(type, bracket + 1, type.len - 1));
    if (base.len <= 0 || inside.len <= 0) return false;
    if (base_out) *base_out = base;
    if (inside_out) *inside_out = inside;
    return true;
}

static bool cold_span_is_unqualified_value_const_name(Span name) {
    name = span_trim(name);
    if (name.len <= 0 || cold_type_has_qualified_name(name)) return false;
    if (cold_type_is_builtin_surface(name)) return false;
    uint8_t c = name.ptr[0];
    return (c >= 'a' && c <= 'z') || c == '_';
}

static bool cold_type_is_fixed_array_surface(Span type, Span *element_out,
                                             Span *count_out) {
    Span element = {0};
    Span count = {0};
    if (!cold_type_split_bracket_suffix(type, &element, &count)) return false;
    if (span_eq(count, "")) return false;
    if (span_is_i32(count) ||
        cold_span_is_unqualified_value_const_name(count) ||
        cold_type_has_qualified_name(count)) {
        if (element_out) *element_out = element;
        if (count_out) *count_out = count;
        return true;
    }
    return false;
}

/* Strip [T, ...] suffix from a generic-instantiated name, e.g. "Some[int32]" -> "Some" */
static Span cold_span_strip_generic_suffix(Span name) {
    if (name.len <= 0) return name;
    if (name.ptr[name.len - 1] != ']') return name;
    int32_t br = -1;
    for (int32_t i = 0; i < name.len; i++) {
        if (name.ptr[i] == '[') { br = i; break; }
    }
    if (br > 0) return span_sub(name, 0, br);
    return name;
}

static bool cold_call_name_generic_suffix(Span name, Span *base_out,
                                          Span *args_out) {
    if (base_out) *base_out = name;
    if (args_out) *args_out = (Span){0};
    if (name.len <= 2 || name.ptr[name.len - 1] != ']') return false;
    int32_t depth = 0;
    int32_t bracket = -1;
    for (int32_t i = 0; i < name.len; i++) {
        uint8_t c = name.ptr[i];
        if (c == '[') {
            if (depth == 0) bracket = i;
            depth++;
        } else if (c == ']') {
            depth--;
            if (depth < 0) die("malformed explicit generic call");
        }
    }
    if (depth != 0) die("malformed explicit generic call");
    if (bracket <= 0) return false;
    Span args = span_trim(span_sub(name, bracket + 1, name.len - 1));
    if (args.len <= 0) die("explicit generic call has no type arguments");
    if (base_out) *base_out = span_sub(name, 0, bracket);
    if (args_out) *args_out = args;
    return true;
}

/* Forward decl: cold_scope_import_const_symbols is defined further below in
   this file (ambiguity-checked, whole-symbol-table fallback scan for
   cross-module unqualified consts, matched by qualified name's last dotted
   component). Reused here -- see the fixed-array-count branch below -- so
   this function's const resolution is not a second, weaker, independent
   implementation of the same lookup. */
static Span cold_scope_import_const_symbols(Symbols *symbols, Span alias, Span name);
static Span cold_scope_qualified_base_array_count(Symbols *symbols, Span alias,
                                                  Span type);

Span cold_qualify_import_type(Symbols *symbols, Span alias, Span type) {
    Arena *arena = symbols->arena;
    bool is_var = false;
    Span stripped = cold_type_strip_var(type, &is_var);
    Span fn_params = {0};
    Span fn_return = {0};
    if (cold_fn_sig_split(
            stripped, &fn_params, &fn_return)) {
        Span items[COLD_MAX_VARIANT_FIELDS];
        Span names[COLD_MAX_VARIANT_FIELDS];
        Span qualified_types[
            COLD_MAX_VARIANT_FIELDS];
        int32_t param_count =
            cold_split_top_level_commas(
                fn_params, items,
                COLD_MAX_VARIANT_FIELDS);
        if (param_count < 0)
            die("import function type parameter list is invalid");
        for (int32_t index = 0;
             index < param_count; index++) {
            Span param_type = {0};
            cold_fn_sig_param_split(
                items[index], &names[index],
                &param_type);
            if (param_type.len <= 0)
                die("import function type parameter is invalid");
            qualified_types[index] =
                cold_qualify_import_type(
                    symbols, alias, param_type);
        }
        Span qualified_return =
            fn_return.len > 0
                ? cold_qualify_import_type(
                      symbols, alias, fn_return)
                : (Span){0};
        Span qualified =
            cold_fn_sig_join(
                arena, names, qualified_types,
                param_count, qualified_return);
        if (!is_var) return qualified;
        return cold_arena_join3(
            arena, cold_cstr_span("var "),
            "", qualified);
    }
    Span optional_base =
        cold_type_strip_optional(stripped);
    if (optional_base.len != stripped.len) {
        Span qualified_optional_base =
            cold_qualify_import_type(
                symbols, alias, optional_base);
        Span qualified = cold_arena_join3(
            arena, qualified_optional_base,
            "", cold_cstr_span("?"));
        if (!is_var) return qualified;
        return cold_arena_join3(
            arena, cold_cstr_span("var "),
            "", qualified);
    }
    /* Pointer-to-user-object types (e.g. `NodeRuntime*`) must be qualified on
       their pointee base, not treated as an opaque builtin surface -- see the
       matching branch in parser_scope_import_type() below for the full
       rationale. This is the global-var-declaration-scan counterpart of that
       fix (symbols_add_global() callers, cheng_cold.c): without it, a global
       `var node: NodeRuntime*` registered its type as bare "NodeRuntime*"
       here while any local/param use of the same pointer type got qualified
       to "alias.NodeRuntime*" by parser_scope_import_type(), producing two
       different qualified spellings for what must be the same type and
       tripping "cold duplicate global type mismatch". */
    if (cold_type_has_pointer_suffix(stripped) && !cold_type_has_qualified_name(stripped)) {
        Span pointee = span_trim(span_sub(stripped, 0, stripped.len - 1));
        if (pointee.len > 0 && !cold_type_is_builtin_surface(pointee)) {
            Span qualified_pointee = cold_qualify_import_type(symbols, alias, pointee);
            Span qualified_ptr = cold_arena_join3(arena, qualified_pointee, "", cold_cstr_span("*"));
            if (!is_var) return qualified_ptr;
            return cold_arena_join3(arena, cold_cstr_span("var "), "", qualified_ptr);
        }
    }
    Span array_element = {0};
    Span array_count = {0};
    if (cold_type_is_fixed_array_surface(stripped, &array_element, &array_count)) {
        Span qualified_element = cold_qualify_import_type(symbols, alias, array_element);
        Span qualified_count = span_trim(array_count);
        if (!span_is_i32(qualified_count) &&
            !cold_type_has_qualified_name(qualified_count)) {
            /* #90 root fix: a bare fixed-array-count identifier (e.g.
               `int32[idLength]`) used to be qualified as `alias + "." +
               name` unconditionally -- the CURRENT file's own module alias,
               not necessarily the alias of the module that actually
               declares the const. For a global var array whose size const
               is declared in a DIFFERENT module the file imports (the
               common case: `import .../consts` then `var arr:
               int32[idLength]`), that join produced a qualified name no
               const table entry matches (e.g. "xordistance.idLength" when
               the real entry is "consts.idLength"). symbols_find_const then
               silently missed, and downstream array-length resolution
               (cold_slot_size_from_type_with_symbols /
               cold_parse_any_fixed_array_type) treated the array as
               zero-length with no diagnostic -- writes to any index were
               silently dropped and reads came back zero (a scoped instance
               of the cheng_const_crossmodule_miscompile family, alongside
               the #51 call-arg/expression fix in parser_find_const: this
               position never went through parser_find_const at all, since
               global-var-block type text is scanned by
               cold_collect_global_vars_from_source() before per-file
               bodies are parsed). Fixed by reusing
               cold_scope_import_const_symbols's proven ambiguity-checked
               whole-table fallback scan (already relied on by the sibling
               cold_scope_import_type_symbols's identical array-count
               branch) instead of the single blind join, and dying loudly
               if even that scan cannot find a unique match rather than
               silently carrying an unresolved name forward. */
            qualified_count = cold_scope_import_const_symbols(symbols, alias, qualified_count);
            if (!symbols_find_const(symbols, qualified_count)) {
                fprintf(stderr,
                        "cheng_cold: unresolved imported const '%.*s' used as fixed array size (module alias '%.*s')\n",
                        (int)array_count.len, array_count.ptr, (int)alias.len, alias.ptr);
                die("unresolved imported const in fixed array size");
            }
        } else {
            qualified_count = cold_arena_span_copy(arena, qualified_count);
        }
        Span qualified = cold_join_fixed_array_type(arena, qualified_element,
                                                   qualified_count);
        if (!is_var) return qualified;
        return cold_arena_join3(arena, cold_cstr_span("var "), "", qualified);
    }
    Span base = {0};
    Span args_span = {0};
    if (cold_type_parse_generic_instance(stripped, &base, &args_span)) {
        Span qualified_base;
        if (cold_type_is_builtin_surface(base) ||
            cold_type_has_qualified_name(base) ||
            cold_import_type_keeps_unqualified_base(base)) {
            qualified_base = cold_arena_span_copy(arena, base);
        } else {
            qualified_base = cold_arena_join3(arena, alias, ".", base);
        }
        Span args[COLD_MAX_VARIANT_FIELDS];
        Span qualified_args[COLD_MAX_VARIANT_FIELDS];
        int32_t arg_count = cold_split_top_level_commas(args_span, args, COLD_MAX_VARIANT_FIELDS);
        if (arg_count <= 0) die("generic import type has no arguments");
        for (int32_t i = 0; i < arg_count; i++) {
            qualified_args[i] = cold_qualify_import_type(symbols, alias, args[i]);
        }
        Span qualified = cold_join_generic_instance(arena, qualified_base,
                                                   qualified_args, arg_count);
        if (!is_var) return qualified;
        return cold_arena_join3(arena, cold_cstr_span("var "), "", qualified);
    }
    if (cold_type_is_builtin_surface(type) || cold_type_has_qualified_name(stripped)) {
        Span array_scoped = cold_scope_qualified_base_array_count(symbols, alias,
                                                                  type);
        if (array_scoped.len > 0) return array_scoped;
        return cold_arena_span_copy(arena, type);
    }
    Span qualified = cold_arena_join3(arena, alias, ".", stripped);
    if (!is_var) return qualified;
    return cold_arena_join3(arena, cold_cstr_span("var "), "", qualified);
}

static bool cold_qualified_type_last_component_eq(Span qualified, Span bare) {
    qualified = span_trim(qualified);
    bare = span_trim(bare);
    if (qualified.len <= bare.len || bare.len <= 0) return false;
    int32_t start = qualified.len - bare.len;
    if (start <= 0 || qualified.ptr[start - 1] != '.') return false;
    return memcmp(qualified.ptr + start, bare.ptr, (size_t)bare.len) == 0;
}

static bool cold_symbols_have_type_or_object(Symbols *symbols, Span qualified) {
    if (!symbols || qualified.len <= 0) return false;
    if (symbols_find_type(symbols, qualified)) return true;
    if (symbols_find_object(symbols, qualified)) return true;
    return false;
}

/* #114: true when `a` and `b` are both populated and textually identical,
   meaning the two alias-qualified TypeDef/ObjectDef entries they were read
   from (e.g. "diaA.SharedCfg" and "diaB.SharedCfg") are alias-qualified
   copies of the SAME physical declaration -- the same module imported under
   two different aliases in one file (a "diamond" import), not two distinct
   declarations that happen to share a bare name. An empty decl_path (either
   side) never counts as a match: only the import-merge sites in
   cold_collect_import_module_types/cold_register_import_enum stamp this
   field (see TypeDef.decl_path), so an entry reaching this comparison
   without ever having been stamped falls through to the pre-existing
   name-based distinctness check below exactly as before this change, never
   silently collapsed by an accidental empty==empty pairing. */
static bool cold_type_decl_path_same_physical(Span a, Span b) {
    return a.len > 0 && b.len > 0 && span_same(a, b);
}

static Span cold_scope_import_bare_type_symbols(Symbols *symbols, Span alias,
                                                Span name, Span *generic_names,
                                                int32_t generic_count) {
    /* Structural guard: a bare name that is itself one of the enclosing
       declaration's own generic type parameters (e.g. `T` in `Box[T]`'s
       field `inner: Wrap[T]`) is not a real type name to resolve/qualify --
       it is a placeholder that must stay bare so cold_bind_generic_type /
       cold_specialize_fn_type can match it later. Checked against the
       actual registered generic parameter list (structural), never by name
       heuristic (e.g. "single uppercase letter"). Must run before any
       self-qualification attempt below, otherwise an unresolvable `T`
       silently falls through to the `return current` self-alias fallback
       and gets baked in as `<alias>.T`, a type name that can never resolve. */
    for (int32_t gi = 0; gi < generic_count; gi++) {
        if (span_same(name, generic_names[gi])) {
            return cold_arena_span_copy(symbols->arena, name);
        }
    }
    Span current = cold_arena_join3(symbols->arena, alias, ".", name);
    TypeDef *current_type = symbols_find_type(symbols, current);
    ObjectDef *current_object = symbols_find_object(symbols, current);
    if (current_type || (current_object && current_object->field_count > 0)) return current;

    Span imported_found = {0};
    Span imported_found_decl_path = {0};
    int32_t imported_found_count = 0;
    bool imported_found_concrete = false;
    for (int32_t ii = 0; ii < ColdScopeDirectImportCount; ii++) {
        Span import_alias = ColdScopeDirectImports[ii].alias;
        if (import_alias.len <= 0 || span_same(import_alias, alias)) continue;
        Span candidate = cold_arena_join3(symbols->arena, import_alias, ".", name);
        TypeDef *candidate_type = symbols_find_type(symbols, candidate);
        ObjectDef *candidate_object = symbols_find_object(symbols, candidate);
        if (!candidate_type && !candidate_object) continue;
        bool concrete = candidate_type || (candidate_object && candidate_object->field_count > 0);
        Span candidate_decl_path = candidate_type ? candidate_type->decl_path
                                   : (candidate_object ? candidate_object->decl_path : (Span){0});
        if (!concrete && imported_found_concrete) continue;
        if (imported_found_count == 0 || (concrete && !imported_found_concrete)) {
            imported_found = candidate;
            imported_found_decl_path = candidate_decl_path;
            imported_found_count = 1;
            imported_found_concrete = concrete;
        } else if (concrete == imported_found_concrete && !span_same(imported_found, candidate) &&
                   !cold_type_decl_path_same_physical(imported_found_decl_path, candidate_decl_path)) {
            imported_found_count++;
        }
    }
    if (imported_found_count > 1) die("ambiguous imported type name");
    if (imported_found_count == 1) return imported_found;

    Span found = {0};
    Span found_decl_path = {0};
    int32_t found_count = 0;
    bool found_concrete = false;
    for (int32_t ti = 0; ti < symbols->type_count; ti++) {
        Span candidate = symbols->types[ti].name;
        if (span_same(candidate, current)) continue;
        if (!cold_qualified_type_last_component_eq(candidate, name)) continue;
        bool concrete = true;
        Span candidate_decl_path = symbols->types[ti].decl_path;
        if (found_count == 0 || (concrete && !found_concrete)) {
            found = candidate;
            found_decl_path = candidate_decl_path;
            found_count = 1;
            found_concrete = concrete;
        } else if (concrete == found_concrete && !span_same(found, candidate) &&
                   !cold_type_decl_path_same_physical(found_decl_path, candidate_decl_path)) {
            found_count++;
        }
    }
    for (int32_t oi = 0; oi < symbols->object_count; oi++) {
        Span candidate = symbols->objects[oi].name;
        if (span_same(candidate, current)) continue;
        if (!cold_qualified_type_last_component_eq(candidate, name)) continue;
        bool concrete = symbols->objects[oi].field_count > 0;
        Span candidate_decl_path = symbols->objects[oi].decl_path;
        if (!concrete && found_concrete) continue;
        if (found_count == 0 || (concrete && !found_concrete)) {
            found = candidate;
            found_decl_path = candidate_decl_path;
            found_count = 1;
            found_concrete = concrete;
        } else if (concrete == found_concrete && !span_same(found, candidate) &&
                   !cold_type_decl_path_same_physical(found_decl_path, candidate_decl_path)) {
            found_count++;
        }
    }
    if (found_count > 1) die("ambiguous imported type name");
    if (found_count == 1) return found;
    return current;
}

static Span cold_scope_import_const_symbols(Symbols *symbols, Span alias,
                                            Span name) {
    Span current = cold_arena_join3(symbols->arena, alias, ".", name);
    if (symbols_find_const(symbols, current)) return current;

    /* #129: same physical const reached through two different import-alias
       spellings (diamond import) must collapse to one candidate here, not
       count as two -- mirrors cold_scope_import_bare_type_symbols's own
       decl_path fold (this file, above) via the same
       cold_type_decl_path_same_physical comparator. An empty decl_path
       (either side) never counts as a match, so entries that never had a
       decl_path threaded to them (e.g. enum variant tags) fall through to
       the pre-existing name-based distinctness check unchanged. */
    Span found = {0};
    Span found_decl_path = {0};
    int32_t found_count = 0;
    for (int32_t ci = 0; ci < symbols->const_count; ci++) {
        Span candidate = symbols->consts[ci].name;
        if (span_same(candidate, current)) continue;
        if (!cold_qualified_type_last_component_eq(candidate, name)) continue;
        Span candidate_decl_path = symbols->consts[ci].decl_path;
        if (found_count == 0) {
            found = candidate;
            found_decl_path = candidate_decl_path;
            found_count = 1;
        } else if (!span_same(found, candidate) &&
                   !cold_type_decl_path_same_physical(found_decl_path, candidate_decl_path)) {
            found_count++;
        }
    }
    if (found_count > 1) {
        fprintf(stderr,
                "cheng_cold: ambiguous imported const name site=scope_symbols alias=%.*s name=%.*s\n",
                (int)alias.len, alias.ptr, (int)name.len, name.ptr);
        die("ambiguous imported const name");
    }
    if (found_count == 1) return found;
    return current;
}

/* Qualified-base bracket form `probe.Base[count]`: every scoper's
   cold_type_has_qualified_name early-exit treats the whole text as already
   scoped and copies it verbatim, so an unqualified fixed-array count inside
   the brackets (e.g. `connection_impl.MsQuicConnImpl[N_SLOTS]`) stays raw
   while the const table only holds the alias-qualified entry
   (`native_runtime.N_SLOTS`).  When the bracketed base provably resolves to a
   NON-generic type/object the bracket content can only be a fixed-array
   count (a non-generic base takes no type arguments), so scope it through the
   canonical ambiguity-checked const path.  Generic bases, unresolved bases
   and non-identifier count expressions keep the verbatim text and stay on
   their owning diagnostics.  Returns an empty span when not applicable. */
static Span cold_scope_qualified_base_array_count(Symbols *symbols, Span alias,
                                                  Span type) {
    Span empty = {0};
    bool is_var = false;
    Span stripped = cold_type_strip_var(type, &is_var);
    Span base = {0};
    Span count = {0};
    if (!cold_type_split_bracket_suffix(stripped, &base, &count)) return empty;
    if (base.len <= 0 || !cold_type_has_qualified_name(base)) return empty;
    if (count.len <= 0 || span_is_i32(count)) return empty;
    if (cold_type_has_qualified_name(count)) return empty;
    for (int32_t i = 0; i < count.len; i++) {
        uint8_t c = count.ptr[i];
        if (!(c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
              (c >= '0' && c <= '9')))
            return empty;
    }
    TypeDef *td = symbols_find_type(symbols, base);
    ObjectDef *od = td ? (ObjectDef *)0 : symbols_find_object(symbols, base);
    if (td) {
        if (td->generic_count > 0) return empty;
    } else if (od) {
        if (od->generic_count > 0) return empty;
    } else {
        return empty;
    }
    Span scoped_count = cold_scope_import_const_symbols(symbols, alias, count);
    if (!symbols_find_const(symbols, scoped_count)) {
        fprintf(stderr,
                "cheng_cold: unresolved imported const '%.*s' used as fixed array size (module alias '%.*s')\n",
                (int)count.len, count.ptr, (int)alias.len, alias.ptr);
        die("unresolved imported const in fixed array size");
    }
    Span scoped = cold_join_fixed_array_type(symbols->arena, base, scoped_count);
    if (!is_var) return scoped;
    return cold_arena_join3(symbols->arena, cold_cstr_span("var "), "", scoped);
}

Span cold_scope_import_type_symbols(Symbols *symbols, Span alias,
                                    Span type, Span *generic_names,
                                    int32_t generic_count) {
    bool is_var = false;
    Span stripped = cold_type_strip_var(type, &is_var);
    Span scoped = stripped;

    Span fn_params = {0};
    Span fn_return = {0};
    if (cold_fn_sig_split(
            stripped, &fn_params, &fn_return)) {
        Span items[COLD_MAX_VARIANT_FIELDS];
        Span names[COLD_MAX_VARIANT_FIELDS];
        Span scoped_types[
            COLD_MAX_VARIANT_FIELDS];
        int32_t param_count =
            cold_split_top_level_commas(
                fn_params, items,
                COLD_MAX_VARIANT_FIELDS);
        if (param_count < 0)
            die("symbol function type parameter list is invalid");
        for (int32_t index = 0;
             index < param_count; index++) {
            Span param_type = {0};
            cold_fn_sig_param_split(
                items[index], &names[index],
                &param_type);
            if (param_type.len <= 0)
                die("symbol function type parameter is invalid");
            scoped_types[index] =
                cold_scope_import_type_symbols(
                    symbols, alias, param_type,
                    generic_names, generic_count);
        }
        Span scoped_return =
            fn_return.len > 0
                ? cold_scope_import_type_symbols(
                      symbols, alias, fn_return,
                      generic_names, generic_count)
                : (Span){0};
        scoped = cold_fn_sig_join(
            symbols->arena, names, scoped_types,
            param_count, scoped_return);
    } else {
        Span optional_base =
            cold_type_strip_optional(stripped);
        if (optional_base.len != stripped.len) {
            Span scoped_optional_base =
                cold_scope_import_type_symbols(
                    symbols, alias, optional_base,
                    generic_names, generic_count);
            scoped = cold_arena_join3(
                symbols->arena, scoped_optional_base,
                "", cold_cstr_span("?"));
        } else if (cold_type_has_pointer_suffix(stripped) &&
               !cold_type_has_qualified_name(stripped)) {
        /* Mirror cold_qualify_import_type's pointer branch, and keep it
           ahead of the builtin-surface branch below: that branch treats
           every `*`-suffixed spelling as builtin, so a pointer to a
           module-owned type (`Table[V]*`) would otherwise be copied
           through unqualified while value/seq formals of the same type
           are qualified -- two spellings for one formal. */
        Span pointee = span_trim(span_sub(stripped, 0, stripped.len - 1));
        if (pointee.len > 0 &&
            !cold_type_is_builtin_surface(pointee)) {
            Span scoped_pointee =
                cold_scope_import_type_symbols(
                    symbols, alias, pointee,
                    generic_names, generic_count);
            scoped = cold_arena_join3(
                symbols->arena, scoped_pointee, "",
                cold_cstr_span("*"));
        } else {
            /* Same ownership rule as the builtin-surface branch below:
               callers may hand in spans into reusable scan buffers, so the
               result must own its bytes. */
            scoped = cold_arena_span_copy(symbols->arena, stripped);
        }
    } else if (cold_type_is_builtin_surface(stripped) ||
               cold_type_has_qualified_name(stripped)) {
        Span array_scoped = cold_scope_qualified_base_array_count(symbols, alias,
                                                                  stripped);
        scoped = array_scoped.len > 0
                     ? array_scoped
                     : cold_arena_span_copy(symbols->arena, stripped);
    } else if (cold_type_is_dynamic_seq_type(stripped)) {
        Span element = span_trim(span_sub(stripped, 0, stripped.len - 2));
        Span scoped_element = cold_scope_import_type_symbols(symbols, alias, element,
                                                             generic_names, generic_count);
        scoped = cold_arena_join3(symbols->arena, scoped_element, "", cold_cstr_span("[]"));
    } else {
        Span array_element = {0};
        Span array_count = {0};
        if (cold_type_is_fixed_array_surface(stripped, &array_element, &array_count)) {
            Span scoped_element = cold_scope_import_type_symbols(symbols, alias, array_element,
                                                                 generic_names, generic_count);
            Span scoped_count = span_trim(array_count);
            if (span_is_i32(scoped_count) || cold_type_has_qualified_name(scoped_count)) {
                scoped_count = cold_arena_span_copy(symbols->arena, scoped_count);
            } else {
                /* #98 follow-up: mirror cold_qualify_import_type's #90
                   poison-on-miss for this sibling's identical array-count
                   branch. Structural guard first, same as
                   cold_scope_import_bare_type_symbols above -- a bare count
                   identifier that is one of the caller's own generic type
                   parameters (e.g. a not-yet-specialized `type Box[T] = {
                   buf: T[N] }` declaration scanned before N is bound) is a
                   placeholder, not a const reference, and must stay bare.
                   Only a genuinely non-generic bare identifier goes through
                   the ambiguity-checked whole-table fallback scan; when even
                   that scan cannot find a unique match, die loudly instead of
                   silently carrying the unresolved name forward. Before #120
                   (a5ffef8ae) rerouted cold_collect_global_vars_from_source's
                   global-var type scoping from cold_qualify_import_type to
                   this function, module-level `var arr: T[importedConst]`
                   went through the die()-protected sibling; after the
                   reroute it silently fell back to this function's older,
                   unprotected miss path, quietly reopening the exact
                   cheng_const_crossmodule_miscompile class #90 closed for the
                   fixed-array-size position (#98). */
                bool is_generic_param = false;
                for (int32_t r98gi = 0; r98gi < generic_count; r98gi++) {
                    if (span_same(scoped_count, generic_names[r98gi])) { is_generic_param = true; break; }
                }
                if (is_generic_param) {
                    scoped_count = cold_arena_span_copy(symbols->arena, scoped_count);
                } else {
                    scoped_count = cold_scope_import_const_symbols(symbols, alias, scoped_count);
                    if (!symbols_find_const(symbols, scoped_count)) {
                        fprintf(stderr,
                                "cheng_cold: unresolved imported const '%.*s' used as fixed array size (module alias '%.*s')\n",
                                (int)array_count.len, array_count.ptr, (int)alias.len, alias.ptr);
                        die("unresolved imported const in fixed array size");
                    }
                }
            }
            scoped = cold_join_fixed_array_type(symbols->arena, scoped_element, scoped_count);
        } else {
            Span base = {0};
            Span args_span = {0};
            if (cold_type_parse_generic_instance(stripped, &base, &args_span)) {
                Span scoped_base;
                if (cold_type_is_builtin_surface(base) ||
                    cold_type_has_qualified_name(base) ||
                    cold_import_type_keeps_unqualified_base(base)) {
                    scoped_base = cold_arena_span_copy(symbols->arena, base);
                } else {
                    scoped_base = cold_scope_import_bare_type_symbols(symbols, alias, base,
                                                                     generic_names, generic_count);
                }
                Span args[COLD_MAX_VARIANT_FIELDS];
                Span scoped_args[COLD_MAX_VARIANT_FIELDS];
                int32_t arg_count = cold_split_top_level_commas(args_span, args, COLD_MAX_VARIANT_FIELDS);
                if (arg_count <= 0) die("generic import type has no arguments");
                for (int32_t i = 0; i < arg_count; i++) {
                    scoped_args[i] = cold_scope_import_type_symbols(symbols, alias, args[i],
                                                                    generic_names, generic_count);
                }
                scoped = cold_join_generic_instance(symbols->arena, scoped_base,
                                                   scoped_args, arg_count);
            } else {
                scoped = cold_scope_import_bare_type_symbols(symbols, alias, stripped,
                                                             generic_names, generic_count);
            }
        }
    }
    }
    if (!is_var) return scoped;
    return cold_arena_join3(symbols->arena, cold_cstr_span("var "), "", scoped);
}

static bool parser_symbol_has_type_or_object(Parser *parser, Span qualified) {
    if (!parser || !parser->symbols || qualified.len <= 0) return false;
    if (symbols_find_type(parser->symbols, qualified)) return true;
    if (symbols_find_object(parser->symbols, qualified)) return true;
    return false;
}

static int32_t parser_import_alias_source_position(
        ColdImportSource *sources, int32_t count, Span alias) {
    if (!sources || count <= 0 || alias.len <= 0) return -1;
    ColdImportAliasIndex *index = sources[0].list_alias_index;
    if (!index) {
        /* Read-only diagnostic/scanner callers may provide a short stack
           list.  Production closure/direct-import lists are indexed before
           any parser is issued. */
        for (int32_t row = 0; row < count; row++) {
            if (span_same(sources[row].alias, alias)) return row;
        }
        return -1;
    }
    if (!index->hash_rows || index->source_count != count ||
        index->hash_cap <= 0 ||
        (index->hash_cap & (index->hash_cap - 1)) != 0) {
        die("cold parser import alias index shape is invalid");
    }
    uint32_t mask = (uint32_t)index->hash_cap - 1u;
    uint32_t first = cold_symbol_name_index_hash(alias) & mask;
    for (int32_t step = 0; step < index->hash_cap; step++) {
        int32_t bucket = (int32_t)(
            (first + (uint32_t)step) & mask);
        int32_t row_plus_one = index->hash_rows[bucket];
        if (row_plus_one == 0) return -1;
        int32_t row = row_plus_one - 1;
        if (row < 0 || row >= count)
            die("cold parser import alias index row drifted");
        if (span_same(sources[row].alias, alias)) return row;
    }
    die("cold parser import alias index is full");
    return -1;
}

static bool cold_ident_exported_by_case(Span name) {
    if (name.len <= 0) return false;
    unsigned char ch = (unsigned char)name.ptr[0];
    if (ch >= 'A' && ch <= 'Z') return true;
    if (span_eq(name, "assert") || span_eq(name, "panic") ||
        span_eq(name, "echo") || span_eq(name, "typeof") ||
        span_eq(name, "len") || span_eq(name, "Len") ||
        span_eq(name, "IntToStr") || span_eq(name, "Int64ToStr")) {
        return true;
    }
    return false;
}

static Span cold_span_first_qualifier(Span name) {
    for (int32_t i = 0; i < name.len; i++) {
        if (name.ptr[i] == '.') return span_sub(name, 0, i);
    }
    return (Span){0};
}

static Span cold_span_last_ident(Span name) {
    int32_t last = -1;
    for (int32_t i = 0; i < name.len; i++) {
        if (name.ptr[i] == '.') last = i;
    }
    if (last < 0) return name;
    return span_sub(name, last + 1, name.len);
}

static bool cold_file_package_key(const char *file_path, char *out, size_t cap) {
    if (!file_path || !file_path[0] || !out || cap < 2) return false;
    const char *rel = strstr(file_path, "/src/");
    if (rel) rel += 5;
    else if (strncmp(file_path, "src/", 4) == 0) rel = file_path + 4;
    else return false;
    char module[PATH_MAX];
    size_t n = 0;
    while (rel[n] && rel[n] != '.' && n + 1 < sizeof(module)) {
        module[n] = rel[n];
        n++;
    }
    module[n] = 0;
    if (n == 0) return false;
    char full[PATH_MAX];
    if (strncmp(module, "std/", 4) == 0 || strcmp(module, "std") == 0) {
        snprintf(full, sizeof(full), "%s", module);
    } else if (strncmp(module, "cheng/", 6) == 0) {
        snprintf(full, sizeof(full), "%s", module);
    } else {
        snprintf(full, sizeof(full), "cheng/%s", module);
    }
    if (strcmp(full, "cheng") == 0) {
        snprintf(out, cap, "cheng");
        return true;
    }
    int32_t cut = -1;
    int32_t slashes = 0;
    bool cheng_pkg = strncmp(full, "cheng/", 6) == 0;
    for (int32_t i = 0; full[i]; i++) {
        if (full[i] != '/') continue;
        slashes++;
        if (cheng_pkg && slashes == 2) {
            cut = i;
            break;
        }
        if (!cheng_pkg && slashes == 1) {
            cut = i;
            break;
        }
    }
    if (cut > 0) snprintf(out, cap, "%.*s", cut, full);
    else snprintf(out, cap, "%s", full);
    return out[0] != '\0';
}

static bool cold_files_share_package(const char *left_file, const char *right_file) {
    char left_key[PATH_MAX];
    char right_key[PATH_MAX];
    if (!cold_file_package_key(left_file, left_key, sizeof(left_key))) return false;
    if (!cold_file_package_key(right_file, right_key, sizeof(right_key))) return false;
    return strcmp(left_key, right_key) == 0;
}

static ColdImportSource *cold_parser_find_import_alias(Parser *parser, Span alias) {
    if (!parser || alias.len <= 0) return NULL;
    if (parser->own_import_sources && parser->own_import_source_count > 0) {
        for (int32_t i = 0; i < parser->own_import_source_count; i++) {
            if (span_same(parser->own_import_sources[i].alias, alias))
                return &parser->own_import_sources[i];
        }
    }
    if (parser->import_sources && parser->import_source_count > 0) {
        for (int32_t i = 0; i < parser->import_source_count; i++) {
            if (span_same(parser->import_sources[i].alias, alias))
                return &parser->import_sources[i];
        }
    }
    return NULL;
}

static void cold_reject_imported_private_call(Parser *parser, Span lookup_name,
                                              FnDef *fn) {
    Span name = lookup_name;
    if (cold_span_first_qualifier(name).len <= 0 && fn && fn->name.len > 0)
        name = fn->name;
    Span qualifier = cold_span_first_qualifier(name);
    Span leaf = cold_span_last_ident(name);
    if (qualifier.len <= 0 || leaf.len <= 0) return;
    if (parser && parser->import_alias.len > 0 &&
        span_same(qualifier, parser->import_alias)) {
        return;
    }
    if (cold_ident_exported_by_case(leaf)) return;
    ColdImportSource *imported = cold_parser_find_import_alias(parser, qualifier);
    if (!imported) return;
    if (parser && parser->source_path && imported->path[0] &&
        cold_files_share_package(parser->source_path, imported->path)) {
        return;
    }
    char msg[512];
    snprintf(msg, sizeof(msg),
             "imported private symbol '%.*s' is not exported (module %.*s)",
             (int)leaf.len, leaf.ptr,
             (int)qualifier.len, qualifier.ptr);
    die(msg);
}

static bool parser_import_candidate_alias(
        Span qualified, Span local_name, Span *alias_out) {
    if (!alias_out || !qualified.ptr || !local_name.ptr ||
        local_name.len <= 0 ||
        qualified.len <= local_name.len + 1) {
        return false;
    }
    int32_t split = qualified.len - local_name.len - 1;
    if (split <= 0 || qualified.ptr[split] != '.' ||
        memcmp(qualified.ptr + split + 1,
               local_name.ptr, (size_t)local_name.len) != 0) {
        return false;
    }
    *alias_out = span_sub(qualified, 0, split);
    return true;
}

typedef struct ParserImportTypeCandidate {
    Span qualified;
    Span declaration_path;
    int32_t source_position;
    int32_t count;
    bool concrete;
} ParserImportTypeCandidate;

static bool parser_verify_import_type_index_enabled(void) {
    static int32_t enabled = -1;
    if (enabled < 0) {
        enabled = cold_truthy_env(
            "CHENG_COLD_VERIFY_IMPORT_TYPE_INDEX") ? 1 : 0;
    }
    return enabled == 1;
}

static void parser_scan_import_sources_for_bare_type_legacy(
        Parser *parser, ColdImportSource *sources,
        int32_t count, Span name,
        Span *out_found, int32_t *out_count) {
    Span found = {0};
    Span found_decl_path = {0};
    int32_t found_count = 0;
    bool found_concrete = false;
    for (int32_t source = 0; source < count; source++) {
        Span alias = sources[source].alias;
        if (alias.len <= 0 ||
            span_same(alias, parser->import_alias)) {
            continue;
        }
        TypeDef *candidate_type =
            symbols_find_type_qualified(
                parser->symbols, alias, name);
        ObjectDef *candidate_object =
            symbols_find_object_qualified(
                parser->symbols, alias, name);
        if (!candidate_type && !candidate_object) continue;
        Span qualified = candidate_type
            ? candidate_type->name : candidate_object->name;
        bool concrete = candidate_type ||
            (candidate_object && candidate_object->field_count > 0);
        Span declaration_path = candidate_type
            ? candidate_type->decl_path
            : candidate_object->decl_path;
        if (!concrete && found_concrete) continue;
        if (found_count == 0 ||
            (concrete && !found_concrete)) {
            found = qualified;
            found_decl_path = declaration_path;
            found_count = 1;
            found_concrete = concrete;
        } else if (concrete == found_concrete &&
                   !span_same(found, qualified) &&
                   !cold_type_decl_path_same_physical(
                       found_decl_path, declaration_path)) {
            found_count++;
        }
    }
    *out_found = found;
    *out_count = found_count;
}

static void parser_import_type_candidate_consider(
        ParserImportTypeCandidate *found,
        Span qualified, Span declaration_path,
        int32_t source_position, bool concrete) {
    if (!found || source_position < 0) return;
    if (!concrete && found->count > 0 && found->concrete) return;
    if (found->count == 0 || (concrete && !found->concrete)) {
        found->qualified = qualified;
        found->declaration_path = declaration_path;
        found->source_position = source_position;
        found->count = 1;
        found->concrete = concrete;
        return;
    }
    if (concrete != found->concrete) return;
    bool same_physical =
        span_same(found->qualified, qualified) ||
        cold_type_decl_path_same_physical(
            found->declaration_path, declaration_path);
    if (!same_physical) found->count = 2;
    if (source_position < found->source_position) {
        found->qualified = qualified;
        found->declaration_path = declaration_path;
        found->source_position = source_position;
    }
}

/* Scan `sources[0..count)` for a type/object whose last path component is
   `name`, skipping the alias the caller is already scoped to. Returns the
   sole match count in *out_count (0/1/2+); *out_found holds the qualified
   name when *out_count == 1. Shared by the file-scoped and whole-program
   tiers of parser_scope_import_bare_type_name so both apply identical
   disambiguation rules. */
static void parser_scan_import_sources_for_bare_type(Parser *parser,
                                                     ColdImportSource *sources,
                                                     int32_t count,
                                                     Span name,
                                                     Span *out_found,
                                                     int32_t *out_count) {
    if (!parser || !parser->symbols || count < 0 ||
        (count > 0 && !sources)) {
        die("cold parser import type scan input is invalid");
    }
    ParserImportTypeCandidate found = {0};
    for (int32_t row =
             symbols_type_local_name_head(parser->symbols, name);
         row >= 0;
         row = parser->symbols->type_local_name_next_rows[row]) {
        if (row >= parser->symbols->type_count)
            die("cold parser type local-name row drifted");
        TypeDef *candidate = &parser->symbols->types[row];
        Span alias = {0};
        if (!parser_import_candidate_alias(
                candidate->name, name, &alias) ||
            span_same(alias, parser->import_alias)) {
            continue;
        }
        int32_t source_position =
            parser_import_alias_source_position(
                sources, count, alias);
        parser_import_type_candidate_consider(
            &found, candidate->name, candidate->decl_path,
            source_position, true);
    }
    for (int32_t row =
             symbols_object_local_name_head(parser->symbols, name);
         row >= 0;
         row = parser->symbols->object_local_name_next_rows[row]) {
        if (row >= parser->symbols->object_count)
            die("cold parser object local-name row drifted");
        ObjectDef *candidate = &parser->symbols->objects[row];
        Span alias = {0};
        if (!parser_import_candidate_alias(
                candidate->name, name, &alias) ||
            span_same(alias, parser->import_alias)) {
            continue;
        }
        int32_t source_position =
            parser_import_alias_source_position(
                sources, count, alias);
        if (source_position < 0) continue;
        /* The historical source-order scan preferred a type registered at
           the same qualified name over an object row. */
        if (symbols_find_type_qualified(
                parser->symbols, alias, name)) {
            continue;
        }
        parser_import_type_candidate_consider(
            &found, candidate->name, candidate->decl_path,
            source_position, candidate->field_count > 0);
    }
    *out_found = found.qualified;
    *out_count = found.count;
    if (parser_verify_import_type_index_enabled()) {
        Span legacy_found = {0};
        int32_t legacy_count = 0;
        parser_scan_import_sources_for_bare_type_legacy(
            parser, sources, count, name,
            &legacy_found, &legacy_count);
        bool indexed_ambiguous = found.count > 1;
        bool legacy_ambiguous = legacy_count > 1;
        if ((found.count == 0) != (legacy_count == 0) ||
            indexed_ambiguous != legacy_ambiguous ||
            (found.count == 1 &&
             !span_same(found.qualified, legacy_found))) {
            fprintf(stderr,
                    "cheng_cold: import type index mismatch name=%.*s "
                    "indexed_count=%d indexed=%.*s "
                    "legacy_count=%d legacy=%.*s\n",
                    (int)name.len, name.ptr,
                    found.count,
                    (int)found.qualified.len,
                    found.qualified.ptr
                        ? (const char *)found.qualified.ptr : "",
                    legacy_count,
                    (int)legacy_found.len,
                    legacy_found.ptr
                        ? (const char *)legacy_found.ptr : "");
            die("cold import type index changed resolution");
        }
    }
}

static Span parser_scope_import_bare_type_name(Parser *parser, Span name) {
    Span current = cold_arena_join3(parser->arena, parser->import_alias, ".", name);
    if (!parser || !parser->symbols) return current;
    TypeDef *current_type = symbols_find_type(parser->symbols, current);
    ObjectDef *current_object = symbols_find_object(parser->symbols, current);
    if (current_type || (current_object && current_object->field_count > 0)) return current;

    /* Tier 1: this specific module's own direct imports only. A bare type
       name inside a module's own declarations must first disambiguate
       against what *that file* actually imports (docs/cheng-formal-spec.md
       :633, import 仅导入导出符号 -- visibility is per-module). An unrelated
       module reached elsewhere in the whole-program transitive closure that
       happens to export a same-named type (e.g. two distinct modules both
       declaring a type literally named `MultiAddress`) must not manufacture
       a false ambiguity here. Only engaged when the caller populated the
       file-scoped list; every pre-existing Parser literal leaves this at
       0/NULL and falls straight through to tier 2 unchanged. */
    if (parser->own_import_source_count > 0) {
        Span own_found = {0};
        int32_t own_count = 0;
        parser_scan_import_sources_for_bare_type(parser, parser->own_import_sources,
                                                 parser->own_import_source_count,
                                                 name, &own_found, &own_count);
        if (own_count > 1) die("ambiguous imported type name");
        if (own_count == 1) return own_found;
    }

    /* Tier 2: whole-program transitive closure (pre-existing behavior,
       unchanged) -- covers names reached only via a deeper transitive import
       chain that the current file does not declare directly. */
    Span found = {0};
    int32_t found_count = 0;
    parser_scan_import_sources_for_bare_type(parser, parser->import_sources,
                                             parser->import_source_count,
                                             name, &found, &found_count);
    if (found_count > 1) die("ambiguous imported type name");
    if (found_count == 1) return found;
    return current;
}

static Span parser_scope_import_value_const(Parser *parser, Span name) {
    if (!parser || !parser->symbols || name.len <= 0) {
        return cold_arena_join3(parser->arena, parser->import_alias, ".", name);
    }
    Span current = cold_arena_join3(parser->arena, parser->import_alias, ".", name);
    if (symbols_find_const(parser->symbols, current)) return current;

    /* #129: same physical const reached through two different import-alias
       spellings (diamond import) must collapse to one candidate here, not
       count as two -- see cold_scope_import_const_symbols's sibling
       comment above for the full rationale. */
    Span found = {0};
    Span found_decl_path = {0};
    int32_t found_count = 0;
    for (int32_t si = 0; si < parser->import_source_count; si++) {
        Span alias = parser->import_sources[si].alias;
        if (alias.len <= 0 || span_same(alias, parser->import_alias)) continue;
        Span qualified = cold_arena_join3(parser->arena, alias, ".", name);
        ConstDef *candidate = symbols_find_const(parser->symbols, qualified);
        if (!candidate) continue;
        if (found_count == 0) {
            found = qualified;
            found_decl_path = candidate->decl_path;
            found_count = 1;
        } else if (!span_same(found, qualified) &&
                   !cold_type_decl_path_same_physical(found_decl_path, candidate->decl_path)) {
            found_count++;
        }
    }
    if (found_count > 1) {
        fprintf(stderr,
                "cheng_cold: ambiguous imported const name site=scope_value name=%.*s\n",
                (int)name.len, name.ptr);
        die("ambiguous imported const name");
    }
    if (found_count == 1) return found;
    return current;
}

static Span parser_scope_import_type(Parser *parser, Span type) {
    bool is_var = false;
    Span stripped = cold_type_strip_var(type, &is_var);
    Span scoped = stripped;

    for (int32_t i = 0; i < parser->active_generic_count && i < 4; i++) {
        if (!span_same(stripped, parser->active_generic_names[i])) continue;
        scoped = cold_arena_span_copy(parser->arena, stripped);
        if (!is_var) return scoped;
        return cold_arena_join3(parser->arena, cold_cstr_span("var "), "", scoped);
    }

    Span fn_params = {0};
    Span fn_return = {0};
    if (cold_fn_sig_split(
            stripped, &fn_params, &fn_return)) {
        Span items[COLD_MAX_VARIANT_FIELDS];
        Span names[COLD_MAX_VARIANT_FIELDS];
        Span scoped_types[
            COLD_MAX_VARIANT_FIELDS];
        int32_t param_count =
            cold_split_top_level_commas(
                fn_params, items,
                COLD_MAX_VARIANT_FIELDS);
        if (param_count < 0)
            die("scoped function type parameter list is invalid");
        for (int32_t index = 0;
             index < param_count; index++) {
            Span param_type = {0};
            cold_fn_sig_param_split(
                items[index], &names[index],
                &param_type);
            if (param_type.len <= 0)
                die("scoped function type parameter is invalid");
            scoped_types[index] =
                parser_scope_import_type(
                    parser, param_type);
        }
        Span scoped_return =
            fn_return.len > 0
                ? parser_scope_import_type(
                      parser, fn_return)
                : (Span){0};
        scoped = cold_fn_sig_join(
            parser->arena, names, scoped_types,
            param_count, scoped_return);
        if (!is_var) return scoped;
        return cold_arena_join3(
            parser->arena,
            cold_cstr_span("var "), "", scoped);
    }

    /* cold_type_is_builtin_surface() treats every `T*` as a builtin/opaque
       surface (see cold_type_has_pointer_suffix inside it), so pointer-to
       -user-object types never get import-alias qualified below and the
       later arrow (`->`) resolver looks up the bare unqualified base name
       against a symbol table that only has the qualified entry -> "arrow
       target type unresolved". Qualify the pointee base first when it is
       not itself a primitive/builtin type. Mirrored in
       cold_qualify_import_type() (the global-var-decl-scan counterpart)
       so both paths produce the same qualified spelling for `T*`. */
    if (cold_type_has_pointer_suffix(stripped) && !cold_type_has_qualified_name(stripped)) {
        Span base = span_trim(span_sub(stripped, 0, stripped.len - 1));
        if (base.len > 0 && !cold_type_is_builtin_surface(base)) {
            Span scoped_base = parser_scope_import_type(parser, base);
            Span ptr_scoped = cold_arena_join3(parser->arena, scoped_base, "", cold_cstr_span("*"));
            if (!is_var) return ptr_scoped;
            return cold_arena_join3(parser->arena, cold_cstr_span("var "), "", ptr_scoped);
        }
    }

    if (cold_type_is_builtin_surface(stripped) || cold_type_has_qualified_name(stripped)) {
        Span array_scoped = cold_scope_qualified_base_array_count(
            parser->symbols, parser->import_alias, stripped);
        scoped = array_scoped.len > 0
                     ? array_scoped
                     : cold_arena_span_copy(parser->arena, stripped);
    } else if (cold_type_is_dynamic_seq_type(stripped)) {
        Span element = span_trim(span_sub(stripped, 0, stripped.len - 2));
        Span scoped_element = parser_scope_import_type(parser, element);
        scoped = cold_arena_join3(parser->arena, scoped_element, "", cold_cstr_span("[]"));
    } else {
        Span array_element = {0};
        Span array_count = {0};
        if (cold_type_is_fixed_array_surface(stripped, &array_element, &array_count)) {
            Span scoped_element = parser_scope_import_type(parser, array_element);
            Span scoped_count = span_trim(array_count);
            if (span_is_i32(scoped_count) || cold_type_has_qualified_name(scoped_count)) {
                scoped_count = cold_arena_span_copy(parser->arena, scoped_count);
            } else {
                scoped_count = parser_scope_import_value_const(parser, scoped_count);
            }
            scoped = cold_join_fixed_array_type(parser->arena, scoped_element, scoped_count);
        } else {
            Span base = {0};
            Span args_span = {0};
            if (cold_type_parse_generic_instance(stripped, &base, &args_span)) {
                Span scoped_base;
                if (cold_type_is_builtin_surface(base) ||
                    cold_type_has_qualified_name(base) ||
                    cold_import_type_keeps_unqualified_base(base)) {
                    scoped_base = cold_arena_span_copy(parser->arena, base);
                } else {
                    scoped_base = parser_scope_import_bare_type_name(parser, base);
                }
                Span args[COLD_MAX_VARIANT_FIELDS];
                Span scoped_args[COLD_MAX_VARIANT_FIELDS];
                int32_t arg_count = cold_split_top_level_commas(args_span, args, COLD_MAX_VARIANT_FIELDS);
                if (arg_count <= 0) die("generic import type has no arguments");
                for (int32_t i = 0; i < arg_count; i++) {
                    scoped_args[i] = parser_scope_import_type(parser, args[i]);
                }
                scoped = cold_join_generic_instance(parser->arena, scoped_base,
                                                   scoped_args, arg_count);
            } else {
                scoped = parser_scope_import_bare_type_name(parser, stripped);
            }
        }
    }
    if (!is_var) return scoped;
    return cold_arena_join3(parser->arena, cold_cstr_span("var "), "", scoped);
}

Span parser_scope_type(Parser *parser, Span type) {
    type = span_trim(type);
    if (parser && parser->import_mode && parser->import_alias.len > 0) {
        return parser_scope_import_type(parser, type);
    }
    return type;
}

bool parser_can_scope_bare_name(Parser *parser, Span name) {
    return parser && parser->import_mode && parser->import_alias.len > 0 &&
           name.len > 0 && cold_span_find_char(name, '.') < 0;
}

Span parser_scoped_bare_name(Parser *parser, Span name) {
    return cold_arena_join3(parser->arena, parser->import_alias, ".", name);
}

ObjectDef *parser_find_object(Parser *parser, Span name) {
    if (parser_can_scope_bare_name(parser, name)) {
        Span scoped = parser_scoped_bare_name(parser, name);
        ObjectDef *object = symbols_find_object(parser->symbols, scoped);
        if (object) return object;
    }
    return symbols_find_object(parser->symbols, name);
}

ObjectDef *parser_resolve_object(Parser *parser, Span name) {
    int32_t binder_kind =
        parser->active_generic_count > 0
            ? parser->active_generic_binder_kind
            : COLD_GENERIC_BINDER_NONE;
    int32_t binder_id =
        parser->active_generic_count > 0
            ? parser->active_generic_binder_id
            : -1;
    if (parser_can_scope_bare_name(parser, name)) {
        Span scoped = parser_scoped_bare_name(parser, name);
        ObjectDef *object =
            symbols_resolve_object_in_generic_scope(
                parser->symbols, scoped,
                parser->active_generic_names,
                parser->active_generic_count,
                binder_kind, binder_id);
        if (object) return object;
    }
    return symbols_resolve_object_in_generic_scope(
        parser->symbols, name,
        parser->active_generic_names,
        parser->active_generic_count,
        binder_kind, binder_id);
}

static int32_t parser_slot_kind_from_type(
        Parser *parser, Span type) {
    if (!parser || !parser->symbols)
        return cold_parser_slot_kind_from_type(NULL, type);
    int32_t binder_kind =
        parser->active_generic_count > 0
            ? parser->active_generic_binder_kind
            : COLD_GENERIC_BINDER_NONE;
    int32_t binder_id =
        parser->active_generic_count > 0
            ? parser->active_generic_binder_id
            : -1;
    return
        cold_parser_slot_kind_from_type_in_generic_scope(
            parser->symbols, type,
            parser->active_generic_names,
            parser->active_generic_count,
            binder_kind, binder_id);
}

static int32_t parser_slot_size_from_type(
        Parser *parser, Span type, int32_t kind) {
    if (!parser || !parser->symbols)
        return cold_parser_slot_size_from_type(
            NULL, type, kind);
    int32_t binder_kind =
        parser->active_generic_count > 0
            ? parser->active_generic_binder_kind
            : COLD_GENERIC_BINDER_NONE;
    int32_t binder_id =
        parser->active_generic_count > 0
            ? parser->active_generic_binder_id
            : -1;
    return
        cold_parser_slot_size_from_type_in_generic_scope(
            parser->symbols, type, kind,
            parser->active_generic_names,
            parser->active_generic_count,
        binder_kind, binder_id);
}

static int32_t parser_param_size_from_type(
        Parser *parser, Span type, int32_t kind) {
    if (!parser || !parser->symbols)
        return cold_param_size_from_type(
            NULL, type, kind);
    int32_t binder_kind =
        parser->active_generic_count > 0
            ? parser->active_generic_binder_kind
            : COLD_GENERIC_BINDER_NONE;
    int32_t binder_id =
        parser->active_generic_count > 0
            ? parser->active_generic_binder_id
            : -1;
    return cold_param_size_from_type_in_generic_scope(
        parser->symbols, type, kind,
        parser->active_generic_names,
        parser->active_generic_count,
        binder_kind, binder_id);
}

ObjectDef *parser_resolve_object_constructor(Parser *parser, Span name,
                                             Span *slot_type_out) {
    ObjectDef *object = parser_resolve_object(parser, name);
    if (object) {
        if (slot_type_out) *slot_type_out = name;
        return object;
    }
    Span stripped = cold_span_strip_generic_suffix(name);
    if (!span_same(stripped, name)) {
        object = parser_resolve_object(parser, stripped);
        if (object && slot_type_out) *slot_type_out = name;
        return object;
    }
    if (slot_type_out) *slot_type_out = name;
    return 0;
}

bool parser_next_is_object_constructor(Parser *parser);
int32_t parse_object_constructor_typed(Parser *parser, BodyIR *body,
                                       Locals *locals, ObjectDef *object,
                                       Span slot_type);

Variant *parser_find_variant(Parser *parser, Span name) {
    if (parser_can_scope_bare_name(parser, name)) {
        Span scoped = parser_scoped_bare_name(parser, name);
        Variant *variant = symbols_find_variant(parser->symbols, scoped);
        if (variant) return variant;
    }
    return symbols_find_variant(parser->symbols, name);
}

ConstDef *parser_find_const(Parser *parser,
                            const BodyIR *body,
                            Span name) {
    if (parser_can_scope_bare_name(parser, name)) {
        Span scoped = parser_scoped_bare_name(parser, name);
        ConstDef *constant = symbols_find_const(parser->symbols, scoped);
        if (constant) return constant;
    }
    ConstDef *constant = symbols_find_const(parser->symbols, name);
    if (constant) return constant;
    /* Cross-module unqualified const, call-arg/expression position: a bare
       name inside a *materialized imported function body* (import_mode=1,
       e.g. publishBootstrapAnnounce pulled in from unimaker_compat_ffi.cheng)
       that refers to a const declared in some OTHER module *that file itself
       imports* (e.g. bootstrapTopicV1 from bootstrap_gossip.cheng) was never
       looked up here: the old guard below skipped this entire loop whenever
       import_mode was set, so the only lookups attempted were the
       self-scope join above (parser->import_alias + "." + name -- wrong
       scope, since bootstrapTopicV1 isn't declared in the *importing*
       module) and the exact bare name (also absent, since it's only
       registered under its declaring module's qualified name). Both miss
       silently and parse_primary's caller falls through to the "bare
       function name reference" branch, which also misses and used to leave
       the call-arg slot built from whatever came next -- observed as a
       phantom kind=1/int32/size=4 zero slot at the call site, causing a
       hard-to-diagnose "unresolved function call" (or worse, a silent
       wrong-kind arg if the callee's signature happened to accept int32).
       Fixed by reusing the exact same ambiguity-checked, alias-table scan
       already proven correct for cross-module *type-level* const lookups
       (parser_scope_import_value_const, used to resolve named consts as
       fixed-array sizes in import_mode type parsing) instead of the
       first-match/import_mode-gated loop this function had: scan every
       import alias visible from the current translation (regardless of
       import_mode -- the whole point is this fires *inside* import_mode
       bodies), skip the alias already tried above via self-scope, and die
       on genuine ambiguity (two distinct modules defining the same bare
       const name) rather than silently picking the first hit. */
    if (name.len > 0 && cold_span_find_char(name, '.') < 0) {
        /* Tier 1: the declaring module's own direct imports only
           (parser->own_import_sources, threaded in by
           cold_try_compile_import_function_from_source from
           import_source->path -- the file this body is *materialized from*,
           e.g. upgrade.cheng -- not the calling translation unit's full
           transitive closure below). A bare const inside a module's own
           declarations must first disambiguate against what *that file*
           actually imports (docs/cheng-formal-spec.md:633, import 仅导入
           导出符号). Mirrors parser_scope_import_bare_type_name's #109
           own_import_source_count Tier 1 -- the const-lookup counterpart of
           that same collapse, missing from this site until now: without it,
           a bare const reference inside upgrade.negotiateMuxerKind (which
           only sees `Outbound` via upgrade.cheng's own `connection` alias
           to src/libp2p/stream/connection.cheng) could be manufactured
           ambiguous by an alias private to whichever *caller* file happened
           to materialize this body (e.g. dial.cheng's `qconn` alias to the
           unrelated src/quic/connection.cheng, which also declares a same-
           named `Outbound` const but which upgrade.cheng itself never
           imports). Only engaged when the caller populated the file-scoped
           list; every pre-existing Parser literal leaves this at 0/NULL and
           falls straight through to tier 2 unchanged. */
        if (parser->own_import_source_count > 0) {
            Span own_found = {0};
            Span own_decl_path = {0};
            int32_t own_count = 0;
            ConstDef *own_constant = 0;
            for (int32_t si = 0; si < parser->own_import_source_count; si++) {
                Span alias = parser->own_import_sources[si].alias;
                if (alias.len <= 0) continue;
                if (parser->import_mode && parser->import_alias.len > 0 &&
                    span_same(alias, parser->import_alias)) continue;
                ConstDef *candidate = symbols_find_const_qualified(
                    parser->symbols, alias, name);
                if (!candidate) continue;
                Span scoped = candidate->name;
                if (own_count == 0) {
                    own_found = scoped;
                    own_constant = candidate;
                    own_decl_path = candidate->decl_path;
                    own_count = 1;
                } else if (!span_same(own_found, scoped) &&
                           !cold_type_decl_path_same_physical(own_decl_path, candidate->decl_path)) {
                    own_count++;
                }
            }
            if (own_count > 1) {
                fprintf(stderr,
                        "cheng_cold: ambiguous imported const name site=find_const_direct name=%.*s import_alias=%.*s body=%.*s\n",
                        (int)name.len, name.ptr,
                        (int)parser->import_alias.len,
                        parser->import_alias.ptr,
                        body && body->debug_name.len > 0
                            ? (int)body->debug_name.len : 0,
                        body && body->debug_name.len > 0
                            ? body->debug_name.ptr
                            : (const uint8_t *)"");
                for (int32_t si = 0;
                     si < parser->own_import_source_count;
                     si++) {
                    Span alias =
                        parser->own_import_sources[si].alias;
                    if (alias.len <= 0) continue;
                    ConstDef *candidate =
                        symbols_find_const_qualified(
                            parser->symbols, alias, name);
                    if (!candidate) continue;
                    fprintf(stderr,
                            "cheng_cold: ambiguous imported const candidate alias=%.*s source=%s decl=%.*s\n",
                            (int)alias.len, alias.ptr,
                            parser->own_import_sources[si].path,
                            (int)candidate->decl_path.len,
                            candidate->decl_path.ptr);
                }
                cold_error_loc(parser, name);
                die("ambiguous imported const name");
            }
            if (own_count == 1) return own_constant;
        }

        /* Tier 2: whole-program transitive closure (pre-existing behavior,
           unchanged) -- covers a bare const reached only via a deeper
           transitive import chain that the declaring module does not import
           directly. #129: same physical const reached through two different
           import-alias spellings (diamond import) must collapse to one
           candidate here, not count as two -- see
           cold_scope_import_const_symbols's sibling comment above for the
           full rationale. This is the site that actually fires for a bare
           cross-module const reference inside a materialized imported
           function body (e.g. src/libp2p/stream/connection.cheng's
           `Outbound` const, reached via both the default alias `connection`
           and the explicit alias `streamconn`). */
        Span found = {0};
        Span found_decl_path = {0};
        int32_t found_count = 0;
        ConstDef *found_constant = 0;
        for (int32_t si = 0; si < parser->import_source_count; si++) {
            Span alias = parser->import_sources[si].alias;
            if (alias.len <= 0) continue;
            if (parser->import_mode && parser->import_alias.len > 0 &&
                span_same(alias, parser->import_alias)) continue;
            ConstDef *candidate = symbols_find_const_qualified(
                parser->symbols, alias, name);
            if (!candidate) continue;
            Span scoped = candidate->name;
            if (found_count == 0) {
                found = scoped;
                found_constant = candidate;
                found_decl_path = candidate->decl_path;
                found_count = 1;
            } else if (!span_same(found, scoped) &&
                       !cold_type_decl_path_same_physical(found_decl_path, candidate->decl_path)) {
                found_count++;
            }
        }
        if (found_count > 1) {
            fprintf(stderr,
                    "cheng_cold: ambiguous imported const name site=find_const_transitive name=%.*s\n",
                    (int)name.len, name.ptr);
            die("ambiguous imported const name");
        }
        if (found_count == 1) return found_constant;
    }
    return 0;
}

/* Absolute path of the module bound to import alias `alias` in this parser's
   own import list ((Span){0} if not found). Mirrors the decl_path computed
   at global-registration time (cold_collect_transitive_imports_rec), so a
   qualified-import global desync fallback lookup compares apples to apples. */
static Span cold_parser_import_alias_decl_path(Parser *parser, Span alias) {
    int32_t si = parser_import_alias_source_position(
        parser->import_sources, parser->import_source_count, alias);
    if (si < 0) return (Span){0};
    int32_t source_row = parser->import_sources[si].source_row;
    if (!parser->symbols ||
        !parser->symbols->source_identity_attached ||
        source_row < 0 ||
        source_row >= parser->symbols->source_identity_count ||
        !parser->symbols->source_identity_diagnostic_paths) {
        die("import alias source identity row is invalid");
    }
    Span declaration_path =
        parser->symbols->source_identity_diagnostic_paths[source_row];
    if (!declaration_path.ptr || declaration_path.len <= 0)
        die("import alias declaration path is invalid");
    return declaration_path;
}

GlobalDef *parser_find_global(Parser *parser, Span name) {
    if (parser_can_scope_bare_name(parser, name)) {
        Span scoped = parser_scoped_bare_name(parser, name);
        GlobalDef *global = symbols_find_global(parser->symbols, scoped);
        if (global) return global;
        /* Same physical global, reached bare from within its own declaring
           module, but registered under a different import-alias spelling
           than the one this particular compilation of the body used
           (qualified-import global desync). parser->source_path is the
           declaring module's own path regardless of which alias reached it,
           so it lines up with the decl_path stored at registration time. */
        if (parser->source_identity_row >= 0) {
            if (!parser->symbols->source_identity_attached ||
                parser->source_identity_row >=
                    parser->symbols->source_identity_count ||
                !parser->symbols->source_identity_diagnostic_paths) {
                die("parser source identity row drifted");
            }
            Span declaration_path =
                parser->symbols->source_identity_diagnostic_paths[
                    parser->source_identity_row];
            if (!declaration_path.ptr || declaration_path.len <= 0)
                die("parser source declaration path is invalid");
            global = symbols_find_global_by_decl(parser->symbols, scoped,
                                                 declaration_path);
            if (global) return global;
        } else if (parser->source_path) {
            /* Diagnostic/scanner parsers that predate sealed source identity
               retain the legacy path. Production body parsers bind a row. */
            if (parser->symbols->source_identity_attached)
                die("sealed parser source identity row is missing");
            char abs_path[PATH_MAX];
            cold_absolute_path(parser->source_path, abs_path,
                               sizeof(abs_path));
            global = symbols_find_global_by_decl(
                parser->symbols, scoped, cold_cstr_span(abs_path));
            if (global) return global;
        }
    }
    GlobalDef *global = symbols_find_global(parser->symbols, name);
    if (global) return global;
    int32_t qualified_dot = cold_span_find_char(name, '.');
    if (qualified_dot > 0) {
        Span alias_prefix = span_sub(name, 0, qualified_dot);
        Span alias_decl_path = cold_parser_import_alias_decl_path(parser, alias_prefix);
        global = symbols_find_global_by_decl(parser->symbols, name, alias_decl_path);
        if (global) return global;
    }
    if (name.len > 0 && cold_span_find_char(name, '.') < 0) {
        /* #128-r11: bare cross-module GLOBAL VAR fallback, mirroring
           parser_find_const's Tier1 (own_import_sources) + Tier2
           (import_sources) ambiguity-checked alias scan directly above.
           The old guard here was `!parser->import_mode`, which shut this
           whole-closure loop off entirely whenever the current body was a
           materialized imported function (import_mode=1) -- e.g.
           cid.isCidContentCodec's bare `codecRaw` reference into
           multicodec.cheng's module-level `var codecRaw` (30+ entries,
           registered fine by the whole-program prescan; only the *lookup*
           side was starved). parser_find_const never had that blanket gate
           in the first place, only the narrower "skip the alias already
           tried via self-scope" per-entry check -- so this brings
           parser_find_global's bare cross-module resolution up to the same
           shape: Tier1 scans the declaring file's own direct imports
           first (disambiguates against what *that file* imports, not the
           calling translation unit's transitive closure), Tier2 falls
           back to the whole-program closure, and both dedupe same physical
           global reached via two alias spellings before declaring genuine
           ambiguity. */
        if (parser->own_import_source_count > 0) {
            Span own_found = {0};
            Span own_decl_path = {0};
            int32_t own_count = 0;
            GlobalDef *own_global = 0;
            for (int32_t si = 0; si < parser->own_import_source_count; si++) {
                Span alias = parser->own_import_sources[si].alias;
                if (alias.len <= 0) continue;
                if (parser->import_mode && parser->import_alias.len > 0 &&
                    span_same(alias, parser->import_alias)) continue;
                GlobalDef *candidate = symbols_find_global_qualified(parser->symbols, alias, name);
                if (!candidate) continue;
                Span scoped = candidate->name;
                if (own_count == 0) {
                    own_found = scoped;
                    own_global = candidate;
                    own_decl_path = candidate->decl_path;
                    own_count = 1;
                } else if (!span_same(own_found, scoped) &&
                           !cold_type_decl_path_same_physical(own_decl_path, candidate->decl_path)) {
                    own_count++;
                }
            }
            if (own_count > 1) die("ambiguous imported global name");
            if (own_count == 1) return own_global;
        }
        Span found = {0};
        Span found_decl_path = {0};
        int32_t found_count = 0;
        GlobalDef *found_global = 0;
        for (int32_t si = 0; si < parser->import_source_count; si++) {
            Span alias = parser->import_sources[si].alias;
            if (alias.len <= 0) continue;
            if (parser->import_mode && parser->import_alias.len > 0 &&
                span_same(alias, parser->import_alias)) continue;
            GlobalDef *candidate = symbols_find_global_qualified(parser->symbols, alias, name);
            if (!candidate) continue;
            Span scoped = candidate->name;
            if (found_count == 0) {
                found = scoped;
                found_global = candidate;
                found_decl_path = candidate->decl_path;
                found_count = 1;
            } else if (!span_same(found, scoped) &&
                       !cold_type_decl_path_same_physical(found_decl_path, candidate->decl_path)) {
                found_count++;
            }
        }
        if (found_count > 1) die("ambiguous imported global name");
        if (found_count == 1) return found_global;
    }
    return 0;
}

int32_t cold_global_ref_kind(int32_t kind) {
    if (kind == SLOT_I32) return SLOT_I32_REF;
    if (kind == SLOT_I64) return SLOT_I64_REF;
    if (kind == SLOT_STR) return SLOT_STR_REF;
    if (kind == SLOT_SEQ_I32) return SLOT_SEQ_I32_REF;
    if (kind == SLOT_SEQ_STR) return SLOT_SEQ_STR_REF;
    if (kind == SLOT_SEQ_OPAQUE) return SLOT_SEQ_OPAQUE_REF;
    if (kind == SLOT_OBJECT || kind == SLOT_VARIANT || kind == SLOT_ARRAY_I32) return SLOT_OBJECT_REF;
    return SLOT_OPAQUE_REF;
}

/* A fixed-array global's GLOBAL_ADDR slot carries the array place.  Derive
   its recorded storage lane from the exact ObjectDef row encoded by the
   producer's TypeId -- the same row freeze validation later folds.  The
   general ref-slot classifier may see an early synthesized array spelling;
   using it as the final authority can mark a POD array OBJECT even though
   its frozen field closure proves PLAIN. */
static bool cold_exact_fixed_array_global_object_storage(
        Symbols *symbols, Span array_type,
        int32_t exact_type_id, int32_t *storage_out) {
    if (storage_out)
        *storage_out = COLD_MANAGED_STORAGE_UNKNOWN;
    if (!symbols || !storage_out) return false;
    Span element_type = {0};
    int32_t element_count = 0;
    if (!cold_parse_any_fixed_array_type(
            symbols, array_type,
            &element_type, &element_count)) {
        return false;
    }
    if (element_count <= 0 || element_type.len <= 0) {
        die("fixed array global object identity drifted");
    }
    /* A fixed array has no independent ObjectDef row: its TypeId names
       the element layout, so the array's own storage lane derives from
       the element drop class -- the same rule the freeze-side field
       closure applies when it folds the array place. */
    int32_t storage = cold_type_requires_managed_drop(
        symbols, element_type, 0)
           ? COLD_MANAGED_STORAGE_OBJECT
           : COLD_MANAGED_STORAGE_PLAIN;
    *storage_out = storage;
    return true;
}

/* A bare array global's count const can be textually forward of the fn
   that references the global: at shadow-publish time the array shape is
   visible but the count does not resolve yet, so the fixed-array arm
   above stays cold and the carrier would fall out of the publisher with
   an unclassified (UNKNOWN) storage lane.  The freeze-side schema
   recomputes this slot's obligation from the element drop class once the
   count resolves, so the publisher must stamp that same element-drop
   value here.  Returns the element type span for that derivation. */
static bool cold_bare_array_global_element(
        Span type, Span *element_out) {
    if (element_out)
        *element_out = span_sub(type, 0, 0);
    type = span_trim(cold_type_strip_var(type, 0));
    if (type.len < 4 || type.ptr[type.len - 1] != ']') return false;
    if (type.len >= 2 && type.ptr[type.len - 2] == '[') return false;
    int32_t lb = -1;
    for (int32_t i = type.len - 2; i >= 0; i--) {
        if (type.ptr[i] == '[') {
            lb = i;
            break;
        }
    }
    if (lb <= 0) return false;
    Span count = span_trim(span_sub(type, lb + 1, type.len - 1));
    Span element_type = span_trim(span_sub(type, 0, lb));
    if (count.len <= 0 || element_type.len <= 0) return false;
    if (element_out) *element_out = element_type;
    return true;
}

Local *locals_add_global_shadow(Parser *parser, BodyIR *body, Locals *locals,
                                Span local_name, GlobalDef *global) {
    Local *existing = locals_find(locals, local_name);
    int32_t ref_kind = cold_global_ref_kind(global->kind);
    int32_t ref_slot = body_slot(body, ref_kind, 8);
    body_slot_set_type(body, ref_slot, global->type_name);
    int32_t global_index = (int32_t)(global - parser->symbols->globals);
    int32_t def =
        body_op3(body, BODY_OP_GLOBAL_ADDR, ref_slot, global_index, 0, 0);
    /* Publish the exact source of every nominal aggregate/reference global
       at the GLOBAL_ADDR row.  Pristine global storage IS the definition
       (PLACE_GLOBAL), borrowed shared by every reader.  PLAIN means that ORC
       has no retain/release work; it does not erase the TypeId or place
       identity of an address-bearing aggregate such as Bytes. */
    int32_t exact_type_id = cold_exact_managed_type_id(
        parser->symbols, body, ref_slot, ref_kind);
    /* A fixed array global (e.g. `gServerAppStream: T[N]`) carries a REF
       identity but no managed element storage: still publish its immortal
       GLOBAL definition so indexed reads AND stores both resolve the same
       exact physical source. */
    bool fixed_array_global =
        ref_kind == SLOT_OBJECT_REF &&
        cold_parse_any_fixed_array_type(
            parser->symbols, global->type_name, 0, 0);
    if (fixed_array_global) {
        int32_t declared_len = 0;
        cold_parse_any_fixed_array_type(
            parser->symbols, global->type_name, 0, &declared_len);
        body_slot_set_array_len(body, ref_slot, declared_len);
    }
    Span bare_array_element = {0};
    bool bare_array_global =
        !fixed_array_global &&
        exact_type_id < 0 &&
        ref_kind == SLOT_OBJECT_REF &&
        cold_bare_array_global_element(
            global->type_name, &bare_array_element);
    int32_t storage = cold_exact_storage_authority_for_slot(
        parser->symbols, body, ref_slot, ref_kind);
    int32_t fixed_array_object_storage =
        COLD_MANAGED_STORAGE_UNKNOWN;
    if (fixed_array_global &&
        cold_exact_fixed_array_global_object_storage(
            parser->symbols, global->type_name,
            exact_type_id,
            &fixed_array_object_storage)) {
        storage = fixed_array_object_storage;
    }
    if (bare_array_global) {
        /* Same element-drop kernel the freeze-side obligation folds for
           this carrier once the count const resolves. */
        storage = cold_type_requires_managed_drop(
            parser->symbols, bare_array_element, 0)
           ? COLD_MANAGED_STORAGE_OBJECT
           : COLD_MANAGED_STORAGE_PLAIN;
    }
    /* Named-length T[ident] / identity-less OBJECT_REF global: both
       array parsers above stay cold (count const not a ConstDef yet,
       or the peel misses the published spelling).  Freeze-side
       cold_canonical_storage_obligation_for_body_slot still assigns
       an obligation; for this form it is PLAIN.  Stamp that same
       value so the slot head matches the auditor. */
    bool identity_less_object_ref_global =
        ref_kind == SLOT_OBJECT_REF &&
        exact_type_id < 0;
    if (identity_less_object_ref_global &&
        storage == COLD_MANAGED_STORAGE_UNKNOWN) {
        Span peeled = {0};
        if (cold_bare_array_global_element(
                body->slot_type[ref_slot], &peeled) ||
            cold_bare_array_global_element(
                global->type_name, &peeled)) {
            storage = cold_type_requires_managed_drop(
                parser->symbols, peeled, 0)
               ? COLD_MANAGED_STORAGE_OBJECT
               : COLD_MANAGED_STORAGE_PLAIN;
        } else {
            storage = COLD_MANAGED_STORAGE_PLAIN;
        }
    }
    bool exact_global_authority =
        (exact_type_id >= 0 &&
         storage != COLD_MANAGED_STORAGE_UNKNOWN) ||
        fixed_array_global ||
        bare_array_global ||
        identity_less_object_ref_global;
    if (exact_global_authority) {
        body->op_value_def_slot[def] = ref_slot;
        body->op_value_def_exact_type_id[def] = exact_type_id;
        body->op_value_def_producer_function_row[def] =
            body->producer_function_row;
        body->op_value_def_place_kind[def] = COLD_EXPR_PLACE_GLOBAL;
        body->op_value_def_ownership[def] =
            COLD_EXPR_OWN_BORROW_SHARED;
        body->op_value_def_origin_id[def] = global_index;
        body->slot_place_kind[ref_slot] = COLD_EXPR_PLACE_GLOBAL;
        body->slot_exact_type_id[ref_slot] = exact_type_id;
        body->slot_origin_id[ref_slot] = global_index;
        /* Publish the derived storage class on the slot lane too: an
           unclassified (UNKNOWN) cache row would contradict the exact
           definition this publisher just proved. */
        body->slot_managed_storage_kind[ref_slot] = storage;
        if (existing) existing->value_def_op_id = def;
    }
    if (existing) {
        if (!existing->is_global || existing->global_index != global_index) return existing;
        existing->slot = ref_slot;
        existing->kind = ref_kind;
        return existing;
    }
    locals_add(locals, local_name, ref_slot, ref_kind);
    Local *added = locals_find(locals, local_name);
    if (!added) die("global local shadow creation failed");
    added->is_global = true;
    /* A Cheng top-level `var` IS a mutable place: the var-actual gate
       (call var-out actual is not a mutable stack local) must not reject a
       global passed to a var formal -- the GLOBAL_ADDR carrier writes
       straight through to immortal global storage. */
    added->is_mutable_place = true;
    added->global_index = global_index;
    if (exact_global_authority &&
        body->op_value_def_place_kind[def] == COLD_EXPR_PLACE_GLOBAL) {
        added->value_def_op_id = def;
    }
    return added;
}

Span cold_import_default_alias(Span module_path) {
    int32_t start = 0;
    for (int32_t i = 0; i < module_path.len; i++) {
        if (module_path.ptr[i] == '/') start = i + 1;
    }
    Span alias = span_sub(module_path, start, module_path.len);
    /* Strip .cheng extension from alias if present */
    if (alias.len > 6 &&
        alias.ptr[alias.len - 6] == '.' &&
        alias.ptr[alias.len - 5] == 'c' &&
        alias.ptr[alias.len - 4] == 'h' &&
        alias.ptr[alias.len - 3] == 'e' &&
        alias.ptr[alias.len - 2] == 'n' &&
        alias.ptr[alias.len - 1] == 'g') {
        alias.len -= 6;
    }
    return alias;
}

bool cold_parse_import_line(Span trimmed, Span *module_out, Span *alias_out) {
    if (!cold_span_starts_with(trimmed, "import ")) return false;
    int32_t pos = 6;
    while (pos < trimmed.len && (trimmed.ptr[pos] == ' ' || trimmed.ptr[pos] == '\t')) pos++;
    if (pos >= trimmed.len) return false;
    /* check for group import: import pkg/[a, b, c] -- return first path, caller handles expansion */
    int32_t module_start = pos;
    while (pos < trimmed.len && trimmed.ptr[pos] != ' ' && trimmed.ptr[pos] != '\t' && trimmed.ptr[pos] != '/') pos++;
    /* if followed by /[, it's a group import */
    if (pos + 1 < trimmed.len && trimmed.ptr[pos] == '/' && trimmed.ptr[pos + 1] == '[') {
        /* extract module path before /[ */
        Span prefix = span_sub(trimmed, module_start, pos);
        /* skip /[ */
        pos += 2;
        while (pos < trimmed.len && trimmed.ptr[pos] == ' ') pos++;
        int32_t item_start = pos;
        /* find ], then extract each comma-separated item */
        int32_t bracket_end = pos;
        while (bracket_end < trimmed.len && trimmed.ptr[bracket_end] != ']') bracket_end++;
        if (bracket_end >= trimmed.len) return false;
        /* return first item as module_out (caller will re-call for each item) */
        while (pos < bracket_end && trimmed.ptr[pos] != ',') pos++;
        Span item = span_trim(span_sub(trimmed, item_start, pos));
        char full_path[256];
        int32_t plen = snprintf(full_path, sizeof(full_path), "%.*s/%.*s", prefix.len, prefix.ptr, item.len, item.ptr);
        if (plen <= 0 || plen >= (int32_t)sizeof(full_path)) return false;
        *module_out = (Span){(const uint8_t *)full_path, plen};
        *alias_out = cold_import_default_alias(item);
        /* TODO: group expansion - currently only returns first item; full expansion needs caller loop */
        return true;
    }
    while (pos < trimmed.len && trimmed.ptr[pos] != ' ' && trimmed.ptr[pos] != '\t') pos++;
    if (pos <= module_start) return false;
    Span module_path = span_sub(trimmed, module_start, pos);
    Span alias_path = module_path;
    if (alias_path.len >= 2 && alias_path.ptr[0] == '"' && alias_path.ptr[alias_path.len - 1] == '"') {
        alias_path = span_sub(alias_path, 1, alias_path.len - 1);
    }
    Span alias = cold_import_default_alias(alias_path);
    while (pos < trimmed.len && (trimmed.ptr[pos] == ' ' || trimmed.ptr[pos] == '\t')) pos++;
    /* forward scan for "as" keyword (more robust than backward scan) */
    if (pos + 2 <= trimmed.len && memcmp(trimmed.ptr + pos, "as", 2) == 0 &&
        (pos + 2 == trimmed.len || trimmed.ptr[pos + 2] == ' ' || trimmed.ptr[pos + 2] == '\t')) {
        pos += 2;
        while (pos < trimmed.len && (trimmed.ptr[pos] == ' ' || trimmed.ptr[pos] == '\t')) pos++;
        int32_t alias_start = pos;
        while (pos < trimmed.len && cold_ident_char(trimmed.ptr[pos])) pos++;
        if (pos <= alias_start) die("cold import alias missing name");
        alias = span_sub(trimmed, alias_start, pos);
    }
    *module_out = module_path;
    *alias_out = alias;
    return true;
}

bool cold_import_source_path(Span module_path, char *out, size_t out_cap) {
    if (module_path.len <= 0 || module_path.len >= PATH_MAX) return false;
    /* strip quotes if present */
    if (module_path.len >= 2 && module_path.ptr[0] == '"' && module_path.ptr[module_path.len - 1] == '"') {
        module_path = span_sub(module_path, 1, module_path.len - 1);
    }
    if (module_path.len <= 0) return false;
    /* strip module_prefix from cheng-package.toml if present (default: "cheng/") */
    if (cold_span_starts_with(module_path, "cheng/")) {
        module_path = span_sub(module_path, 6, module_path.len);
    } else if (cold_span_starts_with(module_path, "std/")) {
        /* std/ prefix maps directly to src/std/ */
    }
    if (module_path.len <= 0) return false;
    /* Check if path already has prefix and suffix */
    bool has_src_prefix = cold_span_starts_with(module_path, "src/");
    bool has_cheng_suffix = module_path.len > 6 &&
        module_path.ptr[module_path.len - 6] == '.' &&
        module_path.ptr[module_path.len - 5] == 'c' &&
        module_path.ptr[module_path.len - 4] == 'h' &&
        module_path.ptr[module_path.len - 3] == 'e' &&
        module_path.ptr[module_path.len - 2] == 'n' &&
        module_path.ptr[module_path.len - 1] == 'g';
    if (has_src_prefix && has_cheng_suffix) {
        /* Path is already a full relative path like src/tests/foo.cheng */
        int written = snprintf(out, out_cap, "%.*s", module_path.len, module_path.ptr);
        return written > 0 && (size_t)written < out_cap;
    }
    {
        char direct[PATH_MAX];
        int written = has_cheng_suffix
            ? snprintf(direct, sizeof(direct), "%.*s", module_path.len, module_path.ptr)
            : snprintf(direct, sizeof(direct), "%.*s.cheng", module_path.len, module_path.ptr);
        if (written > 0 && (size_t)written < sizeof(direct)) {
            struct stat st;
            if (stat(direct, &st) == 0 && S_ISREG(st.st_mode)) {
                int copied = snprintf(out, out_cap, "%s", direct);
                return copied > 0 && (size_t)copied < out_cap;
            }
        }
    }
    if (!cold_span_starts_with(module_path, "std/")) {
        int32_t slash = -1;
        for (int32_t i = 0; i < module_path.len; i++) {
            if (module_path.ptr[i] == '/') {
                slash = i;
                break;
            }
        }
        if (slash > 0 && slash + 1 < module_path.len) {
            char manifest[PATH_MAX];
            int manifest_len = snprintf(manifest, sizeof(manifest),
                                        "%.*s/cheng-package.toml",
                                        slash, module_path.ptr);
            if (manifest_len > 0 && (size_t)manifest_len < sizeof(manifest)) {
                struct stat st;
                if (stat(manifest, &st) == 0 && S_ISREG(st.st_mode)) {
                    /* Try src/ layout first (common convention: package/src/path.cheng) */
                    int written = snprintf(out, out_cap,
                                           "%.*s/src/%.*s.cheng",
                                           slash, module_path.ptr,
                                           module_path.len - slash - 1,
                                           module_path.ptr + slash + 1);
                    if (written > 0 && (size_t)written < out_cap) {
                        struct stat fst;
                        if (stat(out, &fst) == 0 && S_ISREG(fst.st_mode)) {
                            return true;
                        }
                        /* Some packages have directories (e.g. crates/) at root
                           level alongside src/.  Try without src/ insertion. */
                        written = snprintf(out, out_cap,
                                           "%.*s/%.*s.cheng",
                                           slash, module_path.ptr,
                                           module_path.len - slash - 1,
                                           module_path.ptr + slash + 1);
                        return written > 0 && (size_t)written < out_cap;
                    }
                    return false;
                }
            }
        }
    }
    int written = snprintf(out, out_cap, "src/%.*s.cheng", module_path.len, module_path.ptr);
    return written > 0 && (size_t)written < out_cap;
}

bool cold_default_literal_i32(Span val, int32_t *out) {
    if (span_eq(val, "true")) { if (out) *out = 1; return true; }
    if (span_eq(val, "false")) { if (out) *out = 0; return true; }
    if (span_is_i32(val)) { if (out) *out = span_i32(val); return true; }
    return false;
}

int32_t cold_imported_param_specs(Symbols *symbols, Span alias, Span params,
                                         Span *names, int32_t *kinds,
                                         int32_t *sizes, Span *types,
                                         int32_t cap,
                                         bool *has_defaults, int32_t *default_values,
                                         Span *generic_names, int32_t generic_count,
                                         int32_t generic_binder_kind,
                                         int32_t generic_binder_id) {
    Parser parser = cold_parser_issue_legacy_span(symbols, params);
    int32_t count = 0;
    int32_t group_start = 0;
    while (parser.pos < parser.source.len) {
        Span name = parser_token(&parser);
        if (name.len == 0) break;
        if (span_eq(name, ",")) continue;
        if (count >= cap) die("cold imported prototype supports at most sixteen params");
        if (has_defaults) has_defaults[count] = false;
        if (default_values) default_values[count] = 0;
        Span type = cold_cstr_span("int32");
        bool has_explicit_type = false;
        if (span_eq(parser_peek(&parser), ":")) {
            (void)parser_token(&parser);
            /* Manual type span: skip balanced brackets (child parser peek limitation).
               Must stop at top-level '=' so a default clause never leaks into the
               type text (a wrong type breaks the cross-module call ABI). */
            int32_t ts = parser.pos;
            while (parser.pos < parser.source.len) {
                if (parser.source.ptr[parser.pos] == '[') {
                    int32_t d = 1;
                    parser.pos++;
                    while (parser.pos < parser.source.len && d > 0) {
                        if (parser.source.ptr[parser.pos] == '[') d++;
                        else if (parser.source.ptr[parser.pos] == ']') d--;
                        parser.pos++;
                    }
                    continue;
                }
                if (parser.source.ptr[parser.pos] == '(') {
                    /* A nested '(' belongs to a function-typed parameter
                       (e.g. `handler: fn(req: T): T`) -- its own closing ')'
                       is not the outer param list's terminator. Skip the
                       whole balanced group like the '[' case above so the
                       stop-char scan below never mistakes it for the outer
                       close-paren and truncates the type text mid-signature. */
                    int32_t d = 1;
                    parser.pos++;
                    while (parser.pos < parser.source.len && d > 0) {
                        if (parser.source.ptr[parser.pos] == '(') d++;
                        else if (parser.source.ptr[parser.pos] == ')') d--;
                        parser.pos++;
                    }
                    continue;
                }
                if (parser.source.ptr[parser.pos] == ',' || parser.source.ptr[parser.pos] == ')' ||
                    parser.source.ptr[parser.pos] == '=')
                    break;
                parser.pos++;
            }
            Span raw_type = span_trim(span_sub(parser.source, ts, parser.pos));
            /* Skip qualification for generic parameter names (e.g. T, V) to
               keep them matchable in cold_bind_generic_type / cold_specialize_fn_type */
            bool is_generic_name = false;
            for (int32_t gi = 0; gi < generic_count; gi++) {
                if (span_same(raw_type, generic_names[gi])) {
                    is_generic_name = true;
                    break;
                }
            }
            if (is_generic_name) {
                type = cold_arena_span_copy(symbols->arena, raw_type);
            } else {
                type = cold_scope_import_type_symbols(symbols, alias, raw_type,
                                                     generic_names, generic_count);
            }
            has_explicit_type = true;
        }
        int32_t kind =
            cold_parser_slot_kind_from_type_in_generic_scope(
                symbols, type,
                generic_names, generic_count,
                generic_binder_kind,
                generic_binder_id);
        names[count] = name;
        kinds[count] = kind;
        sizes[count] =
            cold_param_size_from_type_in_generic_scope(
                symbols, type, kind,
                generic_names, generic_count,
                generic_binder_kind,
                generic_binder_id);
        if (types) types[count] = type;
        count++;
        if (has_explicit_type) {
            int32_t explicit_size =
                cold_param_size_from_type_in_generic_scope(
                    symbols, type, kind,
                    generic_names, generic_count,
                    generic_binder_kind,
                    generic_binder_id);
            for (int32_t pi = group_start; pi < count; pi++) {
                kinds[pi] = kind;
                sizes[pi] = explicit_size;
                if (types) types[pi] = type;
            }
            group_start = count;
        }
        if (span_eq(parser_peek(&parser), "=")) {
            (void)parser_token(&parser);
            Span def_val = parser_token(&parser);
            int32_t def_i32 = 0;
            if (has_defaults && cold_default_literal_i32(def_val, &def_i32)) {
                has_defaults[count - 1] = true;
                if (default_values) default_values[count - 1] = def_i32;
            }
        }
        while (parser.pos < parser.source.len &&
               !span_eq(parser_peek(&parser), ",") &&
               !span_eq(parser_peek(&parser), ")")) {
            (void)parser_token(&parser);
        }
        if (span_eq(parser_peek(&parser), ",")) (void)parser_token(&parser);
    }
    return count;
}

void parse_type(Parser *parser);
Span cold_strip_inline_comment(Span line);
void cold_collect_import_module_consts(Symbols *symbols, Span alias, Span source,
                                       Span decl_path);
int32_t cold_register_const_binding(Symbols *symbols, Span alias, Span declaration,
                                    Span decl_path);
bool cold_eval_i32_const_expr(Symbols *symbols, Span text, int32_t *out);
void symbols_refine_object_layouts(Symbols *symbols);
Span parser_take_let_initializer_span(Parser *parser, int32_t stmt_indent,
                                      const char *missing_message);
static bool ColdImportDeclarationBatchActive = false;

/* Register the direct-import declaration closure before consuming any
   declaration owned by the importing module.  Constants, types and enums
   share one dependency order: a legal qualified constant or field type must
   never depend on which unrelated module happened to be visited first. */
static bool cold_register_direct_import_declaration_dependencies(
        Symbols *symbols, ColdImportSource *direct_imports,
        int32_t direct_import_count) {
    if (ColdImportDeclarationBatchActive)
        return false;
    bool registered = false;
    for (int32_t i = 0; i < direct_import_count; i++) {
        if (direct_imports[i].alias.len <= 0) continue;
        if (cold_collect_import_module_types_once(symbols, direct_imports[i].alias,
                                                   direct_imports[i].path)) {
            registered = true;
        }
    }
    if (registered && !ColdImportDeclarationBatchActive)
        symbols_refine_object_layouts(symbols);
    return registered;
}

/* Type declarations are parsed in an isolated Symbols table so their bare
   names cannot collide with declarations from other modules. Copy only the
   constants exposed through this module's direct aliases: fixed-array sizes
   and other type-level expressions must see the dependency facts already
   proven in the global table. */
static void cold_seed_type_scan_direct_import_consts(
        Symbols *global_symbols, Symbols *local_symbols,
        ColdImportSource *direct_imports, int32_t direct_import_count) {
    for (int32_t ci = 0; ci < global_symbols->const_count; ci++) {
        ConstDef *constant = &global_symbols->consts[ci];
        bool direct = false;
        for (int32_t ii = 0; ii < direct_import_count; ii++) {
            Span import_alias = direct_imports[ii].alias;
            if (import_alias.len <= 0 ||
                constant->name.len <= import_alias.len + 1) continue;
            if (memcmp(constant->name.ptr, import_alias.ptr,
                       (size_t)import_alias.len) == 0 &&
                constant->name.ptr[import_alias.len] == '.') {
                direct = true;
                break;
            }
        }
        if (!direct) continue;
        if (constant->kind == SLOT_STR) {
            symbols_add_str_const(local_symbols, constant->name,
                                  constant->str_val, constant->decl_path);
        } else {
            symbols_add_tagged_const(local_symbols, constant->name,
                                     constant->kind, constant->scalar_tag,
                                     constant->scalar_bits,
                                     constant->decl_path);
        }
    }
}

static bool cold_type_scan_name_import_binding(
        Symbols *symbols, Span name,
        int32_t *source_row_out) {
    if (!symbols || !name.ptr || name.len <= 0 ||
        !symbols->type_scan_import_parent ||
        !symbols->type_scan_import_aliases ||
        !symbols->type_scan_import_source_rows ||
        symbols->type_scan_import_alias_count <= 0) {
        return false;
    }
    int32_t source_row = -1;
    for (int32_t ii = 0;
         ii < symbols->type_scan_import_alias_count; ii++) {
        Span alias =
            symbols->type_scan_import_aliases[ii];
        if (!alias.ptr || alias.len <= 0 ||
            name.len <= alias.len + 1) {
            continue;
        }
        if (memcmp(name.ptr, alias.ptr,
                   (size_t)alias.len) == 0 &&
            name.ptr[alias.len] == '.') {
            int32_t candidate =
                symbols->
                    type_scan_import_source_rows[ii];
            if (candidate < 0)
                die("cold type scan direct import source row is missing");
            if (source_row >= 0 &&
                source_row != candidate) {
                die("cold type scan direct import alias binding is ambiguous");
            }
            source_row = candidate;
        }
    }
    if (source_row < 0) return false;
    if (source_row_out)
        *source_row_out = source_row;
    return true;
}

static TypeDef *cold_type_scan_materialize_import_type(
        Symbols *symbols, Span name) {
    int32_t binding_source_row = -1;
    if (!cold_type_scan_name_import_binding(
            symbols, name,
            &binding_source_row)) {
        return 0;
    }
    Symbols *parent =
        symbols->type_scan_import_parent;
    TypeDef *src =
        symbols_find_type_local(parent, name);
    if (!src) return 0;
    if (src->declaration_origin_row < 0 ||
        src->is_type_scan_import_projection ||
        src->generic_count < 0 ||
        src->generic_count >
            COLD_MAX_VARIANT_FIELDS) {
        die("cold type scan imported type lacks source authority");
    }
    int32_t module_source_row = -1;
    int32_t token_byte_offset = -1;
    cold_require_declaration_origin_pair(
        parent, src->declaration_origin_row,
        &module_source_row, &token_byte_offset);
    if (module_source_row != binding_source_row)
        die("cold type scan imported type source binding drift");
    symbols->type_scan_import_materializing = true;
    TypeDef *dst = symbols_add_type_at_origin(
        symbols, src->name, src->variant_count,
        module_source_row, token_byte_offset);
    symbols->type_scan_import_materializing = false;
    dst->decl_path = src->decl_path;
    symbols_set_type_generic_names(
        symbols, dst, src->generic_names,
        src->generic_count);
    dst->max_field_count = src->max_field_count;
    dst->max_slot_size = src->max_slot_size;
    dst->is_enum = src->is_enum;
    dst->is_type_scan_import_projection = true;
    dst->alias_type = src->alias_type;
    for (int32_t vi = 0; vi < src->variant_count; vi++) {
        Variant *src_variant = &src->variants[vi];
        Variant *dst_variant = &dst->variants[vi];
        if (src_variant->field_count < 0 ||
            src_variant->field_count >
                COLD_MAX_VARIANT_FIELDS) {
            die("cold type scan variant field count is invalid");
        }
        dst_variant->name = src_variant->name;
        dst_variant->tag = src_variant->tag;
        cold_variant_fields_allocate(
            symbols, dst_variant,
            src_variant->field_count);
        for (int32_t field = 0;
             field < src_variant->field_count; field++) {
            dst_variant->field_kind[field] =
                src_variant->field_kind[field];
            dst_variant->field_size[field] =
                src_variant->field_size[field];
            dst_variant->field_offset[field] =
                src_variant->field_offset[field];
            dst_variant->field_type[field] =
                src_variant->field_type[field];
        }
    }
    uint8_t parent_owner_cid[32];
    uint8_t local_owner_cid[32];
    if (!cold_type_identity_declaration_owner_cid(
            parent, src->declaration_origin_row,
            COLD_TYPE_IDENTITY_DECLARATION_KIND_TYPE,
            parent_owner_cid) ||
        !cold_type_identity_declaration_owner_cid(
            symbols, dst->declaration_origin_row,
            COLD_TYPE_IDENTITY_DECLARATION_KIND_TYPE,
            local_owner_cid) ||
        memcmp(parent_owner_cid,
               local_owner_cid, 32) != 0) {
        die("cold type scan imported type owner CID drift");
    }
    return dst;
}

static ObjectDef *cold_type_scan_materialize_parent_object_visit(
        Symbols *symbols, ObjectDef *src,
        int32_t required_source_row,
        uint8_t *visit_state,
        int32_t visit_state_count);

/* A specialized generic instance (e.g. a field typed `tables.Table[int32]`)
   is not a parser declaration, so the declaration visit must reject it --
   but the name is still a legal cross-module field type and the dependent
   module's scan dies without it.  Import the instance's template through
   the declaration visit, mint the local instance row with the parent's own
   application scope/binder identity, and copy the already-specialized
   concrete fields verbatim (their type spellings were canonicalized by the
   parent's specialization).  The instance row is a type-scan import
   projection, so the registration pass never re-exports it. */
static ObjectDef *cold_type_scan_materialize_import_instance_visit(
        Symbols *symbols, ObjectDef *src,
        int32_t required_source_row,
        uint8_t *visit_state,
        int32_t visit_state_count) {
    Symbols *parent =
        symbols ? symbols->type_scan_import_parent : 0;
    if (!symbols || !src || !parent ||
        src->is_parser_declaration ||
        src->generic_application_template_object_row < 0 ||
        src->generic_application_template_object_row >=
            parent->object_count ||
        src->field_count < 0 ||
        src->inherited_field_count < 0 ||
        src->inherited_field_count > src->field_count) {
        die("cold type scan imported object lacks source authority");
    }
    ObjectDef *existing =
        symbols_find_object_local(symbols, src->name);
    if (existing) return existing;
    ObjectDef *template_src =
        &parent->objects[
            src->generic_application_template_object_row];
    ObjectDef *local_template =
        cold_type_scan_materialize_parent_object_visit(
            symbols, template_src, required_source_row,
            visit_state, visit_state_count);
    int32_t local_template_row =
        symbols_object_index(symbols, local_template);
    if (!local_template || local_template_row < 0)
        die("cold type scan imported instance template is missing");
    const Span *import_scope_names =
        src->generic_application_scope_names;
    int32_t import_scope_count =
        src->generic_application_scope_count;
    int32_t import_binder_kind =
        src->generic_application_binder_kind;
    int32_t import_binder_id =
        src->generic_application_binder_id;
    cold_generic_application_scope_canonicalize(
        symbols, local_template_row,
        &import_scope_names, &import_scope_count,
        &import_binder_kind, &import_binder_id);
    ObjectDef *inst =
        symbols_add_generic_application_object(
            symbols, src->name, src->field_count,
            local_template_row,
            import_scope_names, import_scope_count,
            import_binder_kind, import_binder_id);
    if (!inst)
        die("cold type scan imported instance is missing");
    inst->is_type_scan_import_projection = true;
    inst->is_ref = src->is_ref;
    inst->inherited_field_count = src->inherited_field_count;
    for (int32_t fi = 0; fi < src->field_count; fi++) {
        ObjectField *sf = &src->fields[fi];
        inst->fields[fi].name =
            cold_arena_span_copy(symbols->arena, sf->name);
        inst->fields[fi].type_name =
            cold_arena_span_copy(symbols->arena, sf->type_name);
        inst->fields[fi].kind = sf->kind;
        inst->fields[fi].size = sf->size;
        inst->fields[fi].offset = sf->offset;
        inst->fields[fi].array_len = sf->array_len;
        inst->fields[fi].has_default = sf->has_default;
        inst->fields[fi].default_expr =
            cold_arena_span_copy(symbols->arena, sf->default_expr);
    }
    return inst;
}

static ObjectDef *cold_type_scan_materialize_parent_object_visit(
        Symbols *symbols, ObjectDef *src,
        int32_t required_source_row,
        uint8_t *visit_state,
        int32_t visit_state_count) {
    if (!symbols || !src ||
        !symbols->type_scan_import_parent) {
        die("cold type scan imported object lacks source authority");
    }
    if (!src->is_parser_declaration) {
        return cold_type_scan_materialize_import_instance_visit(
            symbols, src, required_source_row,
            visit_state, visit_state_count);
    }
    if (src->declaration_origin_row < 0 ||
        src->is_type_scan_import_projection ||
        src->generic_count < 0 ||
        src->generic_count >
            COLD_MAX_VARIANT_FIELDS ||
        src->inherited_field_count < 0 ||
        src->inherited_field_count >
            src->field_count) {
        die("cold type scan imported object lacks source authority");
    }
    Symbols *parent =
        symbols->type_scan_import_parent;
    int32_t parent_row =
        symbols_object_index(parent, src);
    if (!visit_state || parent_row < 0 ||
        parent_row >= visit_state_count) {
        die("cold type scan imported object parent row is invalid");
    }
    if (visit_state[parent_row] == 1)
        die("cold type scan imported object base cycle");
    visit_state[parent_row] = 1;
    ObjectDef *existing =
        symbols_find_object_local(symbols, src->name);
    if (existing &&
        existing->is_parser_declaration) {
        int32_t src_source_row = -1;
        int32_t src_offset = -1;
        int32_t dst_source_row = -1;
        int32_t dst_offset = -1;
        cold_require_declaration_origin_pair(
            symbols->type_scan_import_parent,
            src->declaration_origin_row,
            &src_source_row, &src_offset);
        if (required_source_row >= 0 &&
            src_source_row != required_source_row) {
            die("cold type scan imported object source binding drift");
        }
        cold_require_declaration_origin_pair(
            symbols, existing->declaration_origin_row,
            &dst_source_row, &dst_offset);
        if (!existing->is_type_scan_import_projection ||
            src_source_row != dst_source_row ||
            src_offset != dst_offset) {
            die("cold type scan imported object identity drift");
        }
        visit_state[parent_row] = 2;
        return existing;
    }
    if (src->generic_application_type_node >= 0 ||
        src->generic_application_template_object_row >= 0 ||
        src->generic_application_scope_count != 0 ||
        src->generic_application_open) {
        die("cold type scan parser declaration contains application identity");
    }
    if (src->intrinsic_owner_kind !=
            COLD_INTRINSIC_OBJECT_NONE &&
        src->canonical_mirror_object_row < 0) {
        die("cold type scan imported intrinsic source mirror is missing");
    }
    cold_require_parser_object_canonical_mirror_exact(
        parent, src);
    int32_t base_row = -1;
    if (src->base_object_index >= 0) {
        if (src->base_object_index >=
                parent->object_count) {
            die("cold type scan imported object base row is invalid");
        }
        ObjectDef *parent_base =
            &parent->objects[
                src->base_object_index];
        if (parent_base->is_ref ||
            src->inherited_field_count !=
                parent_base->field_count) {
            die("cold type scan imported object base prefix is invalid");
        }
        for (int32_t fi = 0;
             fi < src->inherited_field_count; fi++) {
            ObjectField *expected =
                &parent_base->fields[fi];
            ObjectField *actual =
                &src->fields[fi];
            if (!span_same(expected->name,
                           actual->name) ||
                expected->kind != actual->kind ||
                expected->offset != actual->offset ||
                expected->size != actual->size ||
                expected->array_len !=
                    actual->array_len ||
                !span_same(
                    span_trim(expected->type_name),
                    span_trim(actual->type_name)) ||
                expected->has_default !=
                    actual->has_default ||
                !span_same(
                    span_trim(expected->default_expr),
                    span_trim(actual->default_expr))) {
                die("cold type scan imported object inherited prefix drift");
            }
        }
        ObjectDef *base =
            cold_type_scan_materialize_parent_object_visit(
            symbols,
            parent_base, -1,
            visit_state, visit_state_count);
        base_row = symbols_object_index(
            symbols, base);
        if (!base || base_row < 0)
            die("cold type scan imported object base projection is missing");
    } else if (src->inherited_field_count != 0) {
        die("cold type scan object inherited prefix has no base");
    }
    int32_t module_source_row = -1;
    int32_t token_byte_offset = -1;
    cold_require_declaration_origin_pair(
        symbols->type_scan_import_parent,
        src->declaration_origin_row,
        &module_source_row, &token_byte_offset);
    if (required_source_row >= 0 &&
        module_source_row != required_source_row) {
        die("cold type scan imported object source binding drift");
    }
    ObjectDef *canonical = 0;
    symbols->type_scan_import_materializing = true;
    if (src->intrinsic_owner_kind ==
            COLD_INTRINSIC_OBJECT_ERROR_INFO) {
        canonical =
            symbols_ensure_std_error_info(symbols);
    } else if (src->intrinsic_owner_kind ==
                   COLD_INTRINSIC_OBJECT_RESULT) {
        canonical =
            symbols_ensure_std_result_base(symbols);
    } else if (src->intrinsic_owner_kind ==
                   COLD_INTRINSIC_OBJECT_BYTES) {
        canonical =
            symbols_ensure_std_bytes_named(
                symbols, src->name);
    } else if (src->intrinsic_owner_kind !=
                   COLD_INTRINSIC_OBJECT_NONE) {
        die("cold type scan imported object intrinsic owner is invalid");
    }
    symbols->type_scan_import_materializing = false;
    if (canonical &&
        !span_same(canonical->name, src->name)) {
        die("cold type scan imported intrinsic name drift");
    }
    symbols->type_scan_import_materializing = true;
    ObjectDef *dst = symbols_add_object_at_origin(
        symbols, src->name, src->field_count,
        module_source_row, token_byte_offset);
    symbols->type_scan_import_materializing = false;
    dst->decl_path = src->decl_path;
    symbols_set_object_generic_names(
        symbols, dst, src->generic_names,
        src->generic_count);
    dst->is_ref = src->is_ref;
    dst->is_type_scan_import_projection = true;
    if (dst->intrinsic_owner_kind !=
            src->intrinsic_owner_kind ||
        (src->intrinsic_owner_kind !=
             COLD_INTRINSIC_OBJECT_NONE &&
         dst->canonical_mirror_object_row < 0)) {
        die("cold type scan imported intrinsic mirror drift");
    }
    dst->base_object_index = base_row;
    dst->inherited_field_count =
        src->inherited_field_count;
    dst->slot_size = src->slot_size;
    for (int32_t fi = 0; fi < src->field_count; fi++) {
        dst->fields[fi] = src->fields[fi];
    }
    if (base_row >= 0) {
        object_finalize_fields_with_base(
            dst,
            &symbols->objects[base_row]);
    } else {
        object_finalize_fields(dst);
    }
    if (dst->slot_size != src->slot_size) {
        die("cold type scan imported object slot layout drift");
    }
    for (int32_t fi = 0; fi < src->field_count; fi++) {
        if (dst->fields[fi].offset !=
                src->fields[fi].offset) {
            die("cold type scan imported object field layout drift");
        }
    }
    uint8_t parent_owner_cid[32];
    uint8_t local_owner_cid[32];
    if (!cold_type_identity_declaration_owner_cid(
            symbols->type_scan_import_parent,
            src->declaration_origin_row,
            COLD_TYPE_IDENTITY_DECLARATION_KIND_OBJECT,
            parent_owner_cid) ||
        !cold_type_identity_declaration_owner_cid(
            symbols, dst->declaration_origin_row,
            COLD_TYPE_IDENTITY_DECLARATION_KIND_OBJECT,
            local_owner_cid) ||
        memcmp(parent_owner_cid,
               local_owner_cid, 32) != 0) {
        die("cold type scan imported object owner CID drift");
    }
    if (src->intrinsic_owner_kind !=
            COLD_INTRINSIC_OBJECT_NONE) {
        uint8_t parent_intrinsic_cid[32];
        uint8_t local_intrinsic_cid[32];
        if (!cold_object_semantic_owner_cid(
                parent, src,
                parent_intrinsic_cid) ||
            !cold_object_semantic_owner_cid(
                symbols, dst,
                local_intrinsic_cid) ||
            memcmp(parent_intrinsic_cid,
                   local_intrinsic_cid,
                   32) != 0) {
            die("cold type scan imported intrinsic owner CID drift");
        }
    }
    cold_require_parser_object_canonical_mirror_exact(
        symbols, dst);
    visit_state[parent_row] = 2;
    return dst;
}

static ObjectDef *cold_type_scan_materialize_parent_object(
        Symbols *symbols, ObjectDef *src,
        int32_t required_source_row) {
    if (!symbols || !symbols->type_scan_import_parent)
        return 0;
    int32_t parent_count =
        symbols->type_scan_import_parent->
            object_count;
    size_t state_count =
        (size_t)(parent_count > 0
                     ? parent_count : 1);
    uint8_t *visit_state =
        calloc(state_count,
               sizeof(*visit_state));
    if (!visit_state)
        die("cold type scan imported object visit allocation failed");
    ObjectDef *result =
        cold_type_scan_materialize_parent_object_visit(
            symbols, src, required_source_row,
            visit_state, parent_count);
    free(visit_state);
    return result;
}

static ObjectDef *cold_type_scan_materialize_import_object(
        Symbols *symbols, Span name) {
    int32_t binding_source_row = -1;
    if (!cold_type_scan_name_import_binding(
            symbols, name,
            &binding_source_row)) {
        return 0;
    }
    ObjectDef *src = symbols_find_object_local(
        symbols->type_scan_import_parent, name);
    if (!src) return 0;
    return cold_type_scan_materialize_parent_object(
        symbols, src, binding_source_row);
}

bool cold_line_has_odd_triple_quote(Span line) {
    bool odd = false;
    for (int32_t i = 0; i + 2 < line.len; i++) {
        if (line.ptr[i] == '"' && line.ptr[i + 1] == '"' && line.ptr[i + 2] == '"') {
            odd = !odd;
            i += 2;
        }
    }
    return odd;
}

bool cold_collect_import_module_types(Symbols *symbols, Span alias, Span source,
                                      const char *decl_path) {
    ColdImportSource *prev_direct_imports = ColdScopeDirectImports;
    int32_t prev_direct_import_count = ColdScopeDirectImportCount;
    ColdImportSource *direct_imports = (ColdImportSource *)calloc(
        (size_t)COLD_IMPORT_SOURCE_CAP, sizeof(ColdImportSource));
    if (!direct_imports) die("cold import type scan allocation failed");
    Arena *type_scan_arena = mmap(
        0, sizeof(Arena), PROT_READ | PROT_WRITE,
        MAP_PRIVATE | MAP_ANON, -1, 0);
    if (type_scan_arena == MAP_FAILED) {
        free(direct_imports);
        die("cold import type scan arena allocation failed");
    }
    volatile int32_t type_scan_scope_row = -1;
    /* Save/restore (not force-false) so a caller's own already-active
       recovery scope survives this call's return -- mirroring parse_fn's
       saved_recovery_enabled idiom (this file, ~line 19686). Forcing false
       unconditionally on every exit path used to strand this scan's own
       caller's remaining work (and cold_collect_import_module_enum_blocks,
       the sibling step cold_collect_import_module_types_from_resolved runs
       right after this function returns) without recovery: a die() there
       always went straight to exit(2) instead of being caught, regardless
       of how many valid setjmp frames were still logically on the stack. */
    bool prev_recovery_enabled = ColdErrorRecoveryEnabled;
    ColdErrorRecoveryEnabled = true;
    if (ColdErrorJumpDepth < COLD_JMP_STACK_MAX) ColdErrorJumpDepth++;
    if (setjmp(ColdErrorJumpStack[ColdErrorJumpDepth - 1]) != 0) {
        if (ColdErrorJumpDepth > 0) ColdErrorJumpDepth--;
        ColdErrorRecoveryEnabled = prev_recovery_enabled;
        ColdScopeDirectImports = prev_direct_imports;
        ColdScopeDirectImportCount = prev_direct_import_count;
        if (type_scan_scope_row >= 0) {
            cold_symbol_scope_close_type_scan(
                symbols->compilation_context,
                type_scan_scope_row);
        }
        arena_release(type_scan_arena);
        free(direct_imports);
        return false; /* recovered our own die(): this pair's own type scan did not finish */
    }
    int32_t direct_import_count = cold_collect_direct_import_sources(source, direct_imports,
                                                                     COLD_IMPORT_SOURCE_CAP);
    ColdScopeDirectImports = direct_imports;
    ColdScopeDirectImportCount = direct_import_count;
    (void)cold_register_direct_import_declaration_dependencies(
        symbols, direct_imports, direct_import_count);
    for (int32_t ii = 0;
         ii < direct_import_count; ii++) {
        int32_t source_row =
            ColdActiveSourceSnapshots
                ? cold_source_snapshot_lookup_path(
                      ColdActiveSourceSnapshots,
                      direct_imports[ii].path)
                : -1;
        if (source_row < 0)
            die("cold type scan direct import source authority is missing");
        direct_imports[ii].source_row =
            source_row;
    }
    Symbols *local_symbols = symbols_new_type_scan(
        symbols, type_scan_arena);
    type_scan_scope_row = local_symbols->symbol_scope_row;
    cold_seed_type_scan_direct_import_consts(symbols, local_symbols,
                                             direct_imports,
                                             direct_import_count);
    if (direct_import_count > 0) {
        local_symbols->type_scan_import_aliases =
            arena_alloc(
                local_symbols->arena,
                (size_t)direct_import_count *
                    sizeof(
                        *local_symbols->
                            type_scan_import_aliases));
        local_symbols->type_scan_import_source_rows =
            arena_alloc(
                local_symbols->arena,
                (size_t)direct_import_count *
                    sizeof(
                        *local_symbols->
                            type_scan_import_source_rows));
        local_symbols->type_scan_import_alias_count =
            direct_import_count;
        local_symbols->type_scan_import_parent =
            symbols;
        for (int32_t ii = 0;
             ii < direct_import_count; ii++) {
            local_symbols->type_scan_import_aliases[ii] =
                cold_arena_span_copy(
                    local_symbols->arena,
                    direct_imports[ii].alias);
            local_symbols->
                type_scan_import_source_rows[ii] =
                    direct_imports[ii].source_row;
        }
    }
    cold_collect_import_module_consts(local_symbols, (Span){0}, source,
                                      cold_cstr_span(decl_path));
    Parser parser = cold_parser_issue_legacy_span(local_symbols, source);
    while (parser.pos < source.len) {
        int32_t line_start = parser.pos;
        while (line_start < source.len &&
               (source.ptr[line_start] == '\n' || source.ptr[line_start] == '\r')) {
            line_start++;
        }
        if (line_start >= source.len) break;
        int32_t line_end = line_start;
        while (line_end < source.len && source.ptr[line_end] != '\n') line_end++;
        Span line = span_sub(source, line_start, line_end);
        Span trimmed = cold_strip_inline_comment(line);
        if (cold_line_top_level(line) &&
            cold_span_is_exact_or_prefix_space(trimmed, "type")) {
            parser.pos = line_start;
            parse_type(&parser);
        } else {
            parser.pos = line_end < source.len ? line_end + 1 : line_end;
            if (!cold_line_top_level(line) &&
                cold_line_has_odd_triple_quote(trimmed)) {
                while (parser.pos < source.len) {
                    int32_t nested_start = parser.pos;
                    while (parser.pos < source.len && source.ptr[parser.pos] != '\n') {
                        parser.pos++;
                    }
                    Span nested = span_sub(source, nested_start, parser.pos);
                    if (parser.pos < source.len) parser.pos++;
                    if (cold_line_has_odd_triple_quote(nested)) break;
                }
            }
        }
    }

    /* #114: this invocation's own physical decl_path, arena-copied once so
       every dst stamped below shares one stable Span (decl_path's char*
       argument may point into a heap buffer the caller frees after this
       function returns -- see cold_collect_import_module_types_once). */
    Span module_decl_path = cold_arena_span_copy(symbols->arena, cold_cstr_span(decl_path));
    int32_t scanned_module_source_row =
        ColdActiveSourceSnapshots
            ? cold_source_snapshot_lookup_path(
                  ColdActiveSourceSnapshots,
                  decl_path)
            : -1;
    if (scanned_module_source_row < 0) {
        die("cold type scan module source authority is missing");
    }

    int32_t source_type_count = local_symbols->type_count;
    for (int32_t ti = 0; ti < source_type_count; ti++) {
        TypeDef *src = &local_symbols->types[ti];
        if (src->is_type_scan_import_projection)
            continue;
        if (src->alias_type.len <= 0) continue;
        Span qualified_type = cold_arena_join3(symbols->arena, alias, ".", src->name);
        int32_t module_source_row = -1;
        int32_t token_byte_offset = -1;
        cold_require_declaration_origin_pair(
            local_symbols, src->declaration_origin_row,
            &module_source_row, &token_byte_offset);
        if (module_source_row != scanned_module_source_row)
            die("cold type scan attempted to re-export imported type");
        TypeDef *dst = symbols_find_type(symbols, qualified_type);
        bool dst_is_new = !dst;
        if (!dst) {
            dst = symbols_add_type_at_origin(
                symbols, qualified_type, 0,
                module_source_row, token_byte_offset);
        } else {
            int32_t dst_module_source_row = -1;
            int32_t dst_token_byte_offset = -1;
            cold_require_declaration_origin_pair(
                symbols, dst->declaration_origin_row,
                &dst_module_source_row, &dst_token_byte_offset);
            if (dst_module_source_row != module_source_row ||
                dst_token_byte_offset != token_byte_offset) {
                die("imported type alias declaration origin conflict");
            }
        }
        if (dst->variant_count != 0 || dst->is_enum) die("imported type alias conflicts with concrete type");
        if (!dst_is_new) {
            /* The exact origin check above proves this is the same source
               declaration observed by a repeated import scan. */
            continue;
        }
        dst->decl_path = module_decl_path;
        symbols_set_type_generic_names(
            symbols, dst, src->generic_names,
            src->generic_count);
        Span qualified_alias = cold_scope_import_type_symbols(symbols, alias, src->alias_type,
                                                              src->generic_names, src->generic_count);
        symbols_set_type_alias(dst, qualified_alias);
    }
    for (int32_t ti = 0; ti < source_type_count; ti++) {
        TypeDef *src = &local_symbols->types[ti];
        if (src->is_type_scan_import_projection)
            continue;
        if (!src->is_enum) continue;
        Span qualified_type = cold_arena_join3(symbols->arena, alias, ".", src->name);
        int32_t module_source_row = -1;
        int32_t token_byte_offset = -1;
        cold_require_declaration_origin_pair(
            local_symbols, src->declaration_origin_row,
            &module_source_row, &token_byte_offset);
        if (module_source_row != scanned_module_source_row)
            die("cold type scan attempted to re-export imported enum");
        TypeDef *dst = symbols_find_type(symbols, qualified_type);
        bool dst_is_new = !dst;
        if (!dst) {
            dst = symbols_add_type_at_origin(
                symbols, qualified_type, src->variant_count,
                module_source_row, token_byte_offset);
        } else {
            int32_t dst_module_source_row = -1;
            int32_t dst_token_byte_offset = -1;
            cold_require_declaration_origin_pair(
                symbols, dst->declaration_origin_row,
                &dst_module_source_row, &dst_token_byte_offset);
            if (dst_module_source_row != module_source_row ||
                dst_token_byte_offset != token_byte_offset) {
                die("imported enum declaration origin conflict");
            }
        }
        if (!dst_is_new) {
            /* The exact origin check above proves this is the same source
               declaration observed by a repeated import scan. */
            continue;
        }
        dst->decl_path = module_decl_path;
        dst->is_enum = true;
        for (int32_t vi = 0; vi < src->variant_count; vi++) {
            Variant *src_variant = &src->variants[vi];
            Variant *dst_variant = &dst->variants[vi];
            Span qualified_variant = cold_arena_join3(symbols->arena, alias, ".", src_variant->name);
            dst_variant->name = qualified_variant;
            dst_variant->tag = src_variant->tag;
            dst_variant->field_count = 0;
            variant_finalize_layout(dst, dst_variant);
            if (!symbols_find_const(symbols, qualified_variant)) {
                symbols_add_const(symbols, qualified_variant, src_variant->tag, dst->decl_path);
            }
        }
    }

    int32_t source_object_count = local_symbols->object_count;
    for (int32_t oi = 0; oi < source_object_count; oi++) {
        ObjectDef *src = &local_symbols->objects[oi];
        if (src->is_type_scan_import_projection)
            continue;
        if (!src->is_parser_declaration) {
            if (src->declaration_origin_row >= 0) {
                cold_require_declaration_origin_pair(
                    local_symbols,
                    src->declaration_origin_row,
                    0, 0);
            }
            continue;
        }
        Span qualified_name = cold_arena_join3(symbols->arena, alias, ".", src->name);
        int32_t module_source_row = -1;
        int32_t token_byte_offset = -1;
        cold_require_declaration_origin_pair(
            local_symbols, src->declaration_origin_row,
            &module_source_row, &token_byte_offset);
        if (module_source_row != scanned_module_source_row)
            die("cold type scan attempted to re-export imported object");
        ObjectDef *prior =
            symbols_find_object(symbols, qualified_name);
        bool parser_declaration_is_new =
            !prior || !prior->is_parser_declaration;
        ObjectDef *dst = symbols_add_object_at_origin(
            symbols, qualified_name, src->field_count,
            module_source_row, token_byte_offset);
        if (parser_declaration_is_new) {
            dst->decl_path = module_decl_path;
            symbols_set_object_generic_names(
                symbols, dst, src->generic_names,
                src->generic_count);
            dst->is_ref = src->is_ref;
        }
    }
    for (int32_t oi = 0; oi < source_object_count; oi++) {
        ObjectDef *src = &local_symbols->objects[oi];
        if (src->is_type_scan_import_projection)
            continue;
        if (!src->is_parser_declaration) {
            if (src->declaration_origin_row >= 0) {
                cold_require_declaration_origin_pair(
                    local_symbols,
                    src->declaration_origin_row,
                    0, 0);
            }
            continue;
        }
        int32_t src_module_source_row = -1;
        cold_require_declaration_origin_pair(
            local_symbols, src->declaration_origin_row,
            &src_module_source_row, 0);
        if (src_module_source_row !=
                scanned_module_source_row) {
            die("cold type scan attempted to materialize imported object");
        }
        Span qualified_name = cold_arena_join3(symbols->arena, alias, ".", src->name);
        ObjectDef *dst = symbols_find_object(symbols, qualified_name);
        if (!dst || dst->field_count != src->field_count ||
            dst->is_ref != src->is_ref ||
            !dst->is_parser_declaration)
            die("imported object alias drift");
        int32_t dst_index = symbols_object_index(symbols, dst);
        if (dst_index < 0)
            die("imported object destination row missing");
        int32_t dst_base_index = -1;
        if (src->base_object_index >= 0) {
            if (src->base_object_index >= source_object_count)
                die("imported object source base row invalid");
            ObjectDef *src_base =
                &local_symbols->objects[src->base_object_index];
            if (!src_base->is_parser_declaration ||
                src->inherited_field_count != src_base->field_count)
                die("imported object source inherited prefix drift");
            Span qualified_base_name =
                src_base->is_type_scan_import_projection
                    ? src_base->name
                    : cold_arena_join3(
                          symbols->arena, alias, ".",
                          src_base->name);
            ObjectDef *dst_base =
                symbols_find_object(symbols, qualified_base_name);
            dst_base_index = symbols_object_index(symbols, dst_base);
            if (!dst_base || dst_base_index < 0 ||
                dst_base->is_ref) {
                die("imported object destination base row missing");
            }
            int32_t src_base_source_row = -1;
            int32_t src_base_offset = -1;
            int32_t dst_base_source_row = -1;
            int32_t dst_base_offset = -1;
            cold_require_declaration_origin_pair(
                local_symbols,
                src_base->declaration_origin_row,
                &src_base_source_row,
                &src_base_offset);
            cold_require_declaration_origin_pair(
                symbols,
                dst_base->declaration_origin_row,
                &dst_base_source_row,
                &dst_base_offset);
            if (src_base_source_row !=
                    dst_base_source_row ||
                src_base_offset !=
                    dst_base_offset) {
                die("imported object base declaration identity drift");
            }
            object_materialize_inherited_prefix(
                symbols, dst, dst_base_index);
        } else if (src->inherited_field_count != 0) {
            die("imported object prefix exists without source base");
        }
        dst = &symbols->objects[dst_index];
        if (dst->base_object_index != dst_base_index ||
            dst->inherited_field_count !=
                src->inherited_field_count) {
            die("imported object base identity drift");
        }
        symbols_set_object_generic_names(
            symbols, dst, src->generic_names,
            src->generic_count);
        for (int32_t fi = src->inherited_field_count;
             fi < src->field_count; fi++) {
            bool generic_field =
                cold_type_is_direct_generic_placeholder(
                    src->fields[fi].type_name,
                    src->generic_names,
                    src->generic_count);
            Span field_type = generic_field
                                  ? cold_arena_span_copy(symbols->arena, src->fields[fi].type_name)
                                  : cold_scope_import_type_symbols(symbols, alias,
                                                                  src->fields[fi].type_name,
                                                                  src->generic_names,
                                                                  src->generic_count);
            int32_t fk =
                generic_field
                    ? SLOT_I32
                    : cold_parser_slot_kind_from_type_in_generic_scope(
                          symbols, field_type,
                          src->generic_names,
                          src->generic_count,
                          src->generic_count > 0
                              ? COLD_GENERIC_BINDER_OBJECT_ROW
                              : COLD_GENERIC_BINDER_NONE,
                          src->generic_count > 0
                              ? dst_index : -1);
            int32_t field_size = generic_field ? 4
                : cold_payload_size_from_type_in_generic_scope(
                      symbols, field_type, fk,
                      src->generic_names,
                      src->generic_count,
                      src->generic_count > 0
                          ? COLD_GENERIC_BINDER_OBJECT_ROW
                          : COLD_GENERIC_BINDER_NONE,
                      src->generic_count > 0
                          ? dst_index : -1);
            int32_t array_len = 0;
            if (fk == SLOT_ARRAY_I32 &&
                !cold_parse_fixed_array_type(
                    symbols, field_type, &array_len)) {
                die("imported object fixed array identity is unresolved");
            }
            dst = &symbols->objects[dst_index];
            dst->fields[fi].name = cold_arena_span_copy(symbols->arena, src->fields[fi].name);
            dst->fields[fi].type_name = field_type;
            dst->fields[fi].kind = fk;
            /* #44 root fix: struct FIELD byte size must use the byte-precise
               payload sizer (narrows int8/uint8/int16/uint16 to 1/2 bytes),
               not the generic register-slot sizer -- see the twin fix below
               (~line 3665) for the full explanation. */
            dst->fields[fi].size = field_size;
            dst->fields[fi].array_len = array_len;
            dst->fields[fi].has_default =
                src->fields[fi].has_default;
            dst->fields[fi].default_expr = cold_arena_span_copy(
                symbols->arena, src->fields[fi].default_expr);
        }
        dst = &symbols->objects[dst_index];
        dst->is_ref = src->is_ref;
        if (dst_base_index >= 0) {
            object_finalize_fields_with_base(
                dst, &symbols->objects[dst_base_index]);
        } else {
            object_finalize_fields(dst);
        }
    }
    if (ColdErrorJumpDepth > 0) ColdErrorJumpDepth--;
    ColdErrorRecoveryEnabled = prev_recovery_enabled;
    ColdScopeDirectImports = prev_direct_imports;
    ColdScopeDirectImportCount = prev_direct_import_count;
    cold_symbol_scope_close_type_scan(
        symbols->compilation_context,
        type_scan_scope_row);
    arena_release(type_scan_arena);
    free(direct_imports);
    return true; /* reached our own normal end: this pair's own type scan finished */
}

void cold_register_import_enum(Symbols *symbols, Span alias, Span type_name,
                                      Span *variant_names, int32_t variant_count,
                                      const char *decl_path) {
    if (variant_count <= 0) return;
    Span qualified_type = cold_arena_join3(symbols->arena, alias, ".", type_name);
    TypeDef *type = symbols_find_type(symbols, qualified_type);
    bool type_is_new = !type;
    if (!type) {
        type = symbols_add_type(symbols, qualified_type, variant_count);
    }
    if (!type_is_new) {
        /* #114 r3: qualified_type was already registered by an earlier
           accepted import -- skip the ENTIRE merge body (decl_path /
           is_enum / variant array copy), symmetric with the type-alias
           branch and the mirrored gate in cold_collect_import_module_types's
           enum branch above, regardless of whether this call's
           variant_count happens to match or mismatch the survivor's (see
           that gate's comment for the reject-then-match desync this closes).
           Keep the first registration -- decl_path AND all its data --
           untouched. */
        return;
    }
    type->decl_path = cold_arena_span_copy(symbols->arena, cold_cstr_span(decl_path));
    type->is_enum = true;
    for (int32_t vi = 0; vi < variant_count; vi++) {
        Span qualified_variant = cold_arena_join3(symbols->arena, alias, ".",
                                                  variant_names[vi]);
        Variant *variant = &type->variants[vi];
        variant->name = qualified_variant;
        variant->tag = vi;
        variant->field_count = 0;
        variant_finalize_layout(type, variant);
        if (!symbols_find_const(symbols, qualified_variant)) {
            symbols_add_const(symbols, qualified_variant, vi, type->decl_path);
        }
        Span qualified_type_variant = cold_arena_join3(symbols->arena,
                                                       qualified_type, ".",
                                                       variant_names[vi]);
        if (!symbols_find_const(symbols, qualified_type_variant)) {
            symbols_add_const(symbols, qualified_type_variant, vi, type->decl_path);
        }
    }
}

bool cold_parse_enum_member_line(Span trimmed, Span *type_name,
                                        Span *inline_variants) {
    int32_t eq = cold_span_find_char(trimmed, '=');
    if (eq <= 0) return false;
    Span left = span_trim(span_sub(trimmed, 0, eq));
    Span right = span_trim(span_sub(trimmed, eq + 1, trimmed.len));
    if (!cold_span_starts_with(right, "enum")) return false;
    if (cold_span_starts_with(left, "type ")) {
        left = span_trim(span_sub(left, 5, left.len));
    }
    if (!cold_span_is_simple_ident(left)) return false;
    *type_name = left;
    *inline_variants = span_trim(span_sub(right, 4, right.len));
    return true;
}

int32_t cold_collect_enum_variants_from_span(Span text, Span *variants,
                                                    int32_t cap) {
    Parser parser = cold_parser_issue_lexical_span(0, text);
    int32_t count = 0;
    while (parser.pos < parser.source.len) {
        Span name = parser_token(&parser);
        if (name.len <= 0) break;
        if (span_eq(name, ",") || !cold_span_is_simple_ident(name)) continue;
        if (count >= cap) die("too many cold enum variants");
        variants[count++] = name;
    }
    return count;
}

void cold_collect_import_module_enum_blocks(Symbols *symbols, Span alias,
                                                   Span source, const char *decl_path) {
    int32_t line_cap = 1;
    for (int32_t i = 0; i < source.len; i++) {
        if (source.ptr[i] == '\n') line_cap++;
    }
    int32_t *line_starts = arena_alloc(symbols->arena, (size_t)line_cap * sizeof(int32_t));
    int32_t *line_ends = arena_alloc(symbols->arena, (size_t)line_cap * sizeof(int32_t));
    int32_t line_count = 0;
    int32_t pos = 0;
    while (pos < source.len) {
        if (line_count >= line_cap) die("cold enum line accounting drift");
        int32_t start = pos;
        while (pos < source.len && source.ptr[pos] != '\n') pos++;
        line_starts[line_count] = start;
        line_ends[line_count] = pos;
        line_count++;
        if (pos < source.len) pos++;
    }
    bool in_type_group = false;
    int32_t group_indent = -1;
    for (int32_t li = 0; li < line_count; li++) {
        Span line = span_sub(source, line_starts[li], line_ends[li]);
        Span trimmed = cold_strip_inline_comment(line);
        if (trimmed.len <= 0) continue;
        int32_t indent = cold_line_indent_width(line);
        if (indent == 0) {
            in_type_group = span_eq(trimmed, "type");
            group_indent = -1;
            if (!in_type_group && !cold_span_starts_with(trimmed, "type ")) {
                continue;
            }
        } else if (!in_type_group) {
            continue;
        }
        if (in_type_group) {
            if (indent <= 0) continue;
            if (group_indent < 0) group_indent = indent;
            if (indent < group_indent) {
                in_type_group = false;
                group_indent = -1;
                continue;
            }
            if (indent != group_indent) continue;
        }
        Span type_name = {0};
        Span inline_variants = {0};
        if (!cold_parse_enum_member_line(trimmed, &type_name, &inline_variants)) {
            continue;
        }
        Span variants[COLD_MAX_TYPE_VARIANTS];
        int32_t variant_count = cold_collect_enum_variants_from_span(inline_variants,
                                                                     variants,
                                                                     COLD_MAX_TYPE_VARIANTS);
        if (variant_count == 0) {
            int32_t body_indent = -1;
            for (int32_t vi_line = li + 1; vi_line < line_count; vi_line++) {
                Span vline = span_sub(source, line_starts[vi_line], line_ends[vi_line]);
                Span vt = span_trim(vline);
                if (vt.len <= 0) continue;
                int32_t vindent = cold_line_indent_width(vline);
                if (vindent <= indent) break;
                if (body_indent < 0) body_indent = vindent;
                if (vindent < body_indent) break;
                if (vindent != body_indent) continue;
                if (!cold_span_is_simple_ident(vt)) break;
                if (variant_count >= COLD_MAX_TYPE_VARIANTS) die("too many cold enum variants");
                variants[variant_count++] = vt;
            }
        }
        cold_register_import_enum(symbols, alias, type_name, variants, variant_count, decl_path);
    }
}

/* Capture one complete declaration through the parser's canonical
   continuation-aware initializer scanner. The returned span keeps the
   declaration head and the exact initializer bytes; statement indentation,
   balanced delimiters and strings decide the boundary, never RHS kind. */
static Span cold_take_import_const_statement(
        Span source, int32_t declaration_start,
        int32_t equals_offset, int32_t statement_indent,
        int32_t *statement_end_out) {
    if (declaration_start < 0 ||
        equals_offset <= declaration_start ||
        equals_offset >= source.len ||
        source.ptr[equals_offset] != '=' ||
        statement_indent < 0 ||
        !statement_end_out) {
        die("cold imported const statement boundary invalid");
    }
    Parser parser;
    memset(&parser, 0, sizeof(parser));
    parser.source = source;
    parser.pos = equals_offset + 1;
    Span initializer =
        parser_take_let_initializer_span(
            &parser, statement_indent,
            "cold imported const initializer missing");
    if (initializer.len <= 0 ||
        parser.pos <= equals_offset ||
        parser.pos > source.len) {
        die("cold imported const initializer span invalid");
    }
    *statement_end_out = parser.pos;
    Span statement =
        span_trim(span_sub(
            source, declaration_start,
            parser.pos));
    if (statement.len <= 0)
        die("cold imported const statement empty");
    return statement;
}

void cold_collect_import_module_consts(Symbols *symbols, Span alias, Span source,
                                       Span decl_path) {
    /* scan source for top-level "const" blocks and add constants with alias */
    Span prev_const_eval_alias = ColdConstEvalAlias;
    ColdConstEvalAlias = alias;
    int32_t pos = 0;
    while (pos < source.len) {
        /* find next top-level line */
        int32_t ls = pos;
        while (ls < source.len && source.ptr[ls] != '\n') ls++;
        int32_t le = ls;
        if (ls < source.len) ls++;
        Span line = span_sub(source, pos, le);
        pos = ls;
        Span trimmed = cold_strip_inline_comment(line);
        if (trimmed.len <= 0 || !cold_line_top_level(line)) continue;
        if (!span_eq(trimmed, "const")) {
            /* Single-line "const Name: Type = Value" format */
            if (cold_span_starts_with(trimmed, "const ") ||
                cold_span_starts_with(trimmed, "const\t")) {
                Span rest = span_trim(span_sub(trimmed, 5, trimmed.len));
                int32_t ceq = cold_span_find_char(rest, '=');
                if (ceq > 0) {
                    int32_t statement_end = 0;
                    int32_t declaration_start =
                        (int32_t)(rest.ptr - source.ptr);
                    Span statement =
                        cold_take_import_const_statement(
                            source, declaration_start,
                            declaration_start + ceq, 0,
                            &statement_end);
                    pos = statement_end;
                    if (cold_register_const_binding(
                            symbols, alias, statement,
                            decl_path) < 0) {
                        fprintf(stderr,
                                "cheng_cold: unsupported imported const in '%.*s' "
                                "(alias '%.*s'): '%.*s'\n",
                                (int)decl_path.len, decl_path.ptr,
                                (int)alias.len, alias.ptr,
                                (int)statement.len,
                                statement.ptr);
                        /* die() longjmps straight past this function's tail
                           restore of ColdConstEvalAlias below; without
                           restoring here the static keeps this module's alias
                           span -- which can dangle into this scan's soon-to-
                           be-munmap'd source (cold_collect_import_module_
                           types_from_resolved's recovery path) -- and turns
                           the next bare-identifier const-expression
                           evaluation into a wild read. */
                        ColdConstEvalAlias = prev_const_eval_alias;
                        die("cold imported const declaration unsupported");
                    }
                }
            }
            continue;
        }
        /* found const block: scan indented name=value lines */
        while (pos < source.len) {
            int32_t cs = pos;
            while (pos < source.len && source.ptr[pos] != '\n') pos++;
            int32_t ce = pos;
            if (pos < source.len) pos++;
            Span cline = span_sub(source, cs, ce);
            Span ct = cold_strip_inline_comment(cline);
            if (ct.len <= 0) continue;
            if (cold_line_top_level(cline)) { pos = cs; break; }
            int32_t ceq = cold_span_find_char(ct, '=');
            if (ceq <= 0) continue;
            int32_t statement_end = 0;
            int32_t declaration_start =
                (int32_t)(ct.ptr - source.ptr);
            Span statement =
                cold_take_import_const_statement(
                    source, declaration_start,
                    declaration_start + ceq,
                    cold_line_indent_width(cline),
                    &statement_end);
            pos = statement_end;
            if (cold_register_const_binding(
                    symbols, alias, statement,
                    decl_path) < 0) {
                fprintf(stderr,
                        "cheng_cold: unsupported imported const in '%.*s' "
                        "(alias '%.*s'): '%.*s'\n",
                        (int)decl_path.len, decl_path.ptr,
                        (int)alias.len, alias.ptr,
                        (int)statement.len,
                        statement.ptr);
                /* See the single-line site above: die() must not strand a
                   stale ColdConstEvalAlias past its skipped tail restore. */
                ColdConstEvalAlias = prev_const_eval_alias;
                die("cold imported const declaration unsupported");
            }
        }
    }
    ColdConstEvalAlias = prev_const_eval_alias;
}

/* Returns true iff the consts+types+enum sequence below reached its normal
   end for (alias, path); returns false if it instead recovered from its own
   die() (see the setjmp domain below). The caller,
   cold_collect_import_module_types_once, uses this to decide whether the
   pair may be marked done in ColdImportTypesOnce -- see that function's
   comment at its call to cold_import_types_once_record. */
static bool cold_collect_import_module_types_from_resolved(Symbols *symbols, Span alias,
                                                           const char *path) {
    Span source = source_open(path);
    if (source.len <= 0) return true; /* skip empty import: nothing to scan, nothing failed */
    ColdImportSource *volatile direct_imports = 0;
    /* cold_collect_import_module_consts and cold_collect_import_module_enum_blocks
       run outside cold_collect_import_module_types's own setjmp scope (that
       inner scope only wraps the middle "types" step) and can die() on their
       own (e.g. "cold duplicate const value mismatch", "too many cold enum
       variants"). Such a die() used to longjmp straight past this whole
       function -- skipping cold_collect_import_module_types_once's grey-stack
       pop for THIS (alias, path) pair, since that pop sits right after this
       function returns -- and permanently orphan the pair as "in progress"
       for cold_type_scan_in_progress. Every later legitimate attempt to
       register the same pair then reads a false cycle and silently skips
       registration for the rest of the compile, with no diagnostic tying
       that failure back to this die(). Establish our own recovery frame
       around the whole consts+types+enum sequence so any of the three steps
       dying is caught right here and this function always returns normally
       to its caller -- the existing pop is then symmetric on every path,
       mirroring cold_collect_import_module_types's own setjmp/catch idiom
       one level in (and parse_fn's saved_recovery_enabled save/restore, this
       file ~line 19686, rather than forcing the flag). */
    bool prev_recovery_enabled = ColdErrorRecoveryEnabled;
    ColdErrorRecoveryEnabled = true;
    if (ColdErrorJumpDepth < COLD_JMP_STACK_MAX) ColdErrorJumpDepth++;
    if (setjmp(ColdErrorJumpStack[ColdErrorJumpDepth - 1]) != 0) {
        if (ColdErrorJumpDepth > 0) ColdErrorJumpDepth--;
        ColdErrorRecoveryEnabled = prev_recovery_enabled;
        free((void *)direct_imports);
        source_close(source);
        return false; /* recovered our own die(): this pair's scan did not finish */
    }
    direct_imports = (ColdImportSource *)calloc(
        (size_t)COLD_IMPORT_SOURCE_CAP, sizeof(ColdImportSource));
    if (!direct_imports) die("cold import dependency scan allocation failed");
    int32_t direct_import_count = cold_collect_direct_import_sources(
        source, (ColdImportSource *)direct_imports, COLD_IMPORT_SOURCE_CAP);
    (void)cold_register_direct_import_declaration_dependencies(
        symbols, (ColdImportSource *)direct_imports, direct_import_count);
    cold_collect_import_module_consts(symbols, alias, source, cold_cstr_span(path));
    /* cold_collect_import_module_types has its own, pre-existing inner setjmp
       domain (one level in from this function's own domain established
       above) that silently catches two of its own die()s ("imported type
       alias conflicts with concrete type", "imported object alias drift")
       and returns normally -- without this bool, that recovery was
       invisible here and completed_clean below stayed true even though this
       pair's types step never actually finished, so a second, independent
       importer of the same (alias, path) would be wrongly short-circuited
       by cold_import_types_once_seen instead of retrying. Fold that result
       into completed_clean the same way the consts/enum steps already are
       (their own die()s longjmp straight to this function's own catch
       above, at line ~2441) so all three steps are symmetric. */
    bool types_ok = cold_collect_import_module_types(symbols, alias, source, path);
    cold_collect_import_module_enum_blocks(symbols, alias, source, path);
    if (ColdErrorJumpDepth > 0) ColdErrorJumpDepth--;
    ColdErrorRecoveryEnabled = prev_recovery_enabled;
    free((void *)direct_imports);
    source_close(source);
    return types_ok;
}

void cold_collect_import_module_types_from_path(Symbols *symbols, Span alias,
                                                       Span module_path) {
    char path[PATH_MAX];
    if (!cold_import_source_path(module_path, path, sizeof(path))) {
        die("cold import path is not resolvable");
    }
    (void)cold_collect_import_module_types_once(symbols, alias, path);
}

/* Per-compile registry of (alias, resolved path) pairs whose type/const/enum
   declarations were already registered into the current Symbols table. The
   signature collection pass registers each scanned module's own direct
   imports (so cross-module qualified types in signatures resolve on the
   first pass); without the registry that work would repeat once per import
   edge. Reset at every cold_collect_imported_function_signatures entry —
   the single per-compile entry point that precedes every transitive walk.
   Single-threaded by design (the parallel signature worker is disabled);
   guard with a mutex before re-enabling cold_import_sig_worker. */
typedef struct {
    char *alias;
    char *path;
} ColdImportTypesOnceEntry;
static ColdImportTypesOnceEntry *ColdImportTypesOnce = 0;
static int32_t ColdImportTypesOnceCount = 0;
static int32_t ColdImportTypesOnceCap = 0;
void cold_import_types_once_reset(void) {
    for (int32_t i = 0; i < ColdImportTypesOnceCount; i++) {
        free(ColdImportTypesOnce[i].alias);
        free(ColdImportTypesOnce[i].path);
    }
    ColdImportTypesOnceCount = 0;
    ColdImportDeclarationBatchActive = false;
}

void cold_import_declaration_batch_begin(void) {
    cold_import_types_once_reset();
    ColdImportDeclarationBatchActive = true;
}

void cold_import_declaration_batch_end(void) {
    if (!ColdImportDeclarationBatchActive)
        die("cold import declaration batch is not active");
    ColdImportDeclarationBatchActive = false;
}

static bool cold_import_types_once_seen(Span alias, const char *path) {
    for (int32_t i = 0; i < ColdImportTypesOnceCount; i++) {
        if (strcmp(ColdImportTypesOnce[i].path, path) != 0) continue;
        Span seen = cold_cstr_span(ColdImportTypesOnce[i].alias);
        if (span_same(seen, alias)) return true;
    }
    return false;
}

static void cold_import_types_once_record(Span alias, const char *path) {
    if (ColdImportTypesOnceCount >= ColdImportTypesOnceCap) {
        int32_t next = ColdImportTypesOnceCap > 0 ? ColdImportTypesOnceCap * 2 : 64;
        ColdImportTypesOnceEntry *fresh = (ColdImportTypesOnceEntry *)realloc(
            ColdImportTypesOnce, (size_t)next * sizeof(ColdImportTypesOnceEntry));
        if (!fresh) die("cold import type registry allocation failed");
        ColdImportTypesOnce = fresh;
        ColdImportTypesOnceCap = next;
    }
    char *alias_copy = (char *)malloc((size_t)alias.len + 1);
    char *path_copy = (char *)malloc(strlen(path) + 1);
    if (!alias_copy || !path_copy) die("cold import type registry allocation failed");
    memcpy(alias_copy, alias.ptr, (size_t)alias.len);
    alias_copy[alias.len] = 0;
    strcpy(path_copy, path);
    ColdImportTypesOnce[ColdImportTypesOnceCount].alias = alias_copy;
    ColdImportTypesOnce[ColdImportTypesOnceCount].path = path_copy;
    ColdImportTypesOnceCount++;
}

/* (alias, path) pairs whose type scan is currently on the call stack --
   separate from ColdImportTypesOnce (which only records *completed* scans).
   Cheng's own stdlib has genuine mutual-import cycles (std/result.cheng
   `import std/system as system`, std/system.cheng `import std/result`), and
   cold_collect_import_module_types now pre-registers its own direct
   imports' types before scanning its own declarations (see the comment at
   its call site) so a later-encountered target isn't missed just because
   the whole-program walk happened to reach the referencer before the
   referent. Without this in-progress guard, a real import cycle sends that
   pre-registration into unbounded mutual recursion (result -> system ->
   result -> ...) and overflows the C call stack. Skipping only the recursive
   re-entry breaks that cycle; any outer declaration that truly requires a
   fact the cycle has not completed still hard-fails during its own scan. */
#define COLD_TYPE_SCAN_STACK_CAP 512
static Span ColdTypeScanStackAlias[COLD_TYPE_SCAN_STACK_CAP];
static char ColdTypeScanStackPath[COLD_TYPE_SCAN_STACK_CAP][PATH_MAX];
static int32_t ColdTypeScanStackCount = 0;

static bool cold_type_scan_in_progress(Span alias, const char *path) {
    for (int32_t i = 0; i < ColdTypeScanStackCount; i++) {
        if (strcmp(ColdTypeScanStackPath[i], path) != 0) continue;
        if (span_same(ColdTypeScanStackAlias[i], alias)) return true;
    }
    return false;
}

bool cold_collect_import_module_types_once(Symbols *symbols, Span alias,
                                           const char *path) {
    if (cold_import_types_once_seen(alias, path)) return false;
    if (cold_type_scan_in_progress(alias, path)) return false;
    if (ColdTypeScanStackCount >= COLD_TYPE_SCAN_STACK_CAP) {
        die("cold import declaration dependency depth exceeds 512");
    }
    ColdTypeScanStackAlias[ColdTypeScanStackCount] = alias;
    strncpy(ColdTypeScanStackPath[ColdTypeScanStackCount], path, PATH_MAX - 1);
    ColdTypeScanStackPath[ColdTypeScanStackCount][PATH_MAX - 1] = 0;
    ColdTypeScanStackCount++;
    bool completed_clean = cold_collect_import_module_types_from_resolved(symbols, alias, path);
    ColdTypeScanStackCount--;
    /* A failed scan is never recorded as done. Re-raise only after popping
       this pair so every enclosing import frame gets symmetric cleanup and
       the original declaration diagnostic cannot be swallowed. */
    if (!completed_clean) {
        fprintf(stderr,
                "cheng_cold: import declaration dependency source path '%s' "
                "(alias '%.*s')\n",
                path, (int)alias.len, alias.ptr);
        die("cold import declaration dependency scan failed");
    }
    cold_import_types_once_record(alias, path);
    return true;
}

void symbols_refine_object_layouts(Symbols *symbols) {
    /* A single linear pass over symbols->objects[] is not sufficient to
       reach a fixpoint: when object A embeds object B as a field and A's
       array index precedes B's (A was registered, e.g. via an earlier
       import alias, before B's own registration/refinement settled), A's
       field size is (re)computed from B's *current* symbols_object_slot_size
       -- which, within this same pass, still reflects whatever stale value
       B had *before* this pass reaches and re-finalizes B later in the
       same oi loop. That freezes A's embedded-object field size one
       refinement generation behind B's true size (observed concretely:
       qtransport.MsQuicTransport.tlsPolicy stuck at a stale 344-byte
       policy.MsQuicTlsPolicy size after policy.MsQuicTlsPolicy itself
       settles to the correct 328, because MsQuicTransport was refined
       earlier in the same array-order pass than MsQuicTlsPolicy converged
       -- "aggregate field store layout mismatch" at codegen time). Repeat
       the full pass until no object's slot_size changes, so nested-object
       field sizes always converge to their dependency's final value before
       this function returns. Bounded by object_count+1 passes: a DAG of N
       objects converges in at most N passes (one pass per dependency-chain
       hop); the +1 is margin, not a load-bearing heuristic -- a genuine
       cycle cannot grow unboundedly here (sizes are recomputed from field
       type text, not accumulated), so it can only oscillate among a few
       values and the pass cap simply stops that oscillation deterministically
       rather than looping forever. */
    bool changed = true;
    int32_t pass_cap = symbols->object_count + 1;
    for (int32_t pass = 0; changed && pass < pass_cap; pass++) {
        changed = false;
        for (int32_t oi = 0; oi < symbols->object_count; oi++) {
            ObjectDef *object = &symbols->objects[oi];
            int32_t prev_slot_size = object->slot_size;
            Span *field_generic_names = NULL;
            int32_t field_generic_count = 0;
            int32_t field_generic_binder_kind =
                COLD_GENERIC_BINDER_NONE;
            int32_t field_generic_binder_id = -1;
            bool open_application = false;
            if (!cold_object_generic_scope_readonly(
                    symbols, oi, &field_generic_names,
                    &field_generic_count,
                    &field_generic_binder_kind,
                    &field_generic_binder_id,
                    &open_application)) {
                die("object layout generic scope identity is invalid");
            }
            int32_t local_field_start = 0;
            if (object->base_object_index >= 0) {
                if (object->base_object_index >= symbols->object_count ||
                    object->base_object_index == oi) {
                    die("object inheritance refinement base row invalid");
                }
                object_materialize_inherited_prefix(
                    symbols, object, object->base_object_index);
                local_field_start = object->inherited_field_count;
            } else if (object->inherited_field_count != 0) {
                die("object inheritance refinement prefix without base");
            }
            for (int32_t fi = local_field_start;
                 fi < object->field_count; fi++) {
                ObjectField *field = &object->fields[fi];
                bool generic_field =
                    cold_type_is_direct_generic_placeholder(
                        field->type_name,
                        field_generic_names,
                        field_generic_count);
                if (generic_field) {
                    if (!open_application)
                        die("closed object layout contains generic field");
                    field->kind = SLOT_I32;
                    field->size = 4;
                    field->array_len = 0;
                    continue;
                }
                int32_t kind =
                    cold_parser_slot_kind_from_type_in_generic_scope(
                        symbols, field->type_name,
                        field_generic_names,
                        field_generic_count,
                        field_generic_binder_kind,
                        field_generic_binder_id);
                if (kind == SLOT_VARIANT && !symbols_resolve_type(symbols, field->type_name)) kind = SLOT_I32;
                field->kind = kind;
                field->size =
                    cold_payload_size_from_type_in_generic_scope(
                        symbols, field->type_name, kind,
                        field_generic_names,
                        field_generic_count,
                        field_generic_binder_kind,
                        field_generic_binder_id);
                field->array_len = 0;
                if (kind == SLOT_ARRAY_I32 &&
                    !cold_parse_fixed_array_type(symbols, field->type_name, &field->array_len)) {
                    die("object layout fixed array identity is unresolved");
                }
            }
            if (object->base_object_index >= 0) {
                object_finalize_fields_with_base(
                    object,
                    &symbols->objects[object->base_object_index]);
            } else {
                object_finalize_fields(object);
            }
            if (object->slot_size != prev_slot_size) changed = true;
        }
    }
}

/* Post-collection repair for re-exported field types. A struct field declared
   with a bare type that the owning module imported from elsewhere (e.g.
   policy.cheng's `certLeafKeyKind: X509PublicKeyKind` after `import x509`)
   gets its type baked by cold_scope_import_bare_type_symbols, which can only
   reach the owning alias (x509.) if that owner's type was already registered
   when the field was first scanned. When import-collection order leaves the
   owner unregistered, the field bakes to the wrong self-alias
   (policy.X509PublicKeyKind) that never resolves, so the layout pass treats
   the enum as OPAQUE (8 bytes) instead of i32 (4) and downstream payload
   stores corrupt the frame. Once every module's types are registered, rewrite
   any simple field type that still fails to resolve to the unique registered
   type/object sharing its last component. */
void cold_rescope_unresolved_object_field_types(Symbols *symbols) {
    for (int32_t oi = 0; oi < symbols->object_count; oi++) {
        ObjectDef *object = &symbols->objects[oi];
        Span *field_generic_names = NULL;
        int32_t field_generic_count = 0;
        int32_t field_generic_binder_kind =
            COLD_GENERIC_BINDER_NONE;
        int32_t field_generic_binder_id = -1;
        bool open_application = false;
        if (!cold_object_generic_scope_readonly(
                symbols, oi, &field_generic_names,
                &field_generic_count,
                &field_generic_binder_kind,
                &field_generic_binder_id,
                &open_application)) {
            die("object field rescope generic identity is invalid");
        }
        for (int32_t fi = 0; fi < object->field_count; fi++) {
            ObjectField *field = &object->fields[fi];
            bool is_var = false;
            Span stripped = span_trim(cold_type_strip_var(field->type_name, &is_var));
            if (stripped.len <= 0) continue;
            if (cold_type_is_builtin_surface(stripped)) continue;
            if (cold_type_is_generic_placeholder(
                    field->type_name, field_generic_names,
                    field_generic_count)) {
                if (!open_application)
                    die("closed object rescope contains generic field");
                continue;
            }
            /* Only simple qualified names: skip generics, arrays, sequences,
               pointer suffixes — their components are scoped recursively at
               registration time and a compound rewrite here would be unsafe. */
            if (!cold_type_has_qualified_name(stripped)) continue;
            int32_t dot = cold_span_find_char(stripped, '.');
            if (dot <= 0 || dot + 1 >= stripped.len) continue;
            Span bare = span_sub(stripped, dot + 1, stripped.len);
            if (cold_span_find_char(bare, '.') >= 0) continue; /* multi-level */
            if (cold_span_find_char(bare, '[') >= 0 ||
                cold_span_find_char(bare, ']') >= 0 ||
                cold_span_find_char(bare, '(') >= 0) continue;
            if (symbols_resolve_type(symbols, stripped) ||
                symbols_resolve_object(symbols, stripped)) continue;
            Span found = {0};
            int32_t found_count = 0;
            for (int32_t ti = 0; ti < symbols->type_count; ti++) {
                Span candidate = symbols->types[ti].name;
                if (span_same(candidate, stripped)) continue;
                if (!cold_qualified_type_last_component_eq(candidate, bare)) continue;
                if (found_count == 0 || !span_same(found, candidate)) {
                    found = candidate;
                    found_count++;
                }
            }
            for (int32_t ooi = 0; ooi < symbols->object_count; ooi++) {
                if (symbols->objects[ooi].field_count <= 0) continue;
                Span candidate = symbols->objects[ooi].name;
                if (span_same(candidate, stripped)) continue;
                if (!cold_qualified_type_last_component_eq(candidate, bare)) continue;
                if (found_count == 0 || !span_same(found, candidate)) {
                    found = candidate;
                    found_count++;
                }
            }
            if (found_count != 1) continue; /* unresolved or ambiguous: leave as-is */
            field->type_name = is_var
                ? cold_arena_join3(symbols->arena, cold_cstr_span("var "), "", found)
                : cold_arena_span_copy(symbols->arena, found);
        }
    }
    /* Same self-alias-baking defect as above, but for fixed-array element
       types (e.g. rpc/messages.cheng's `msgs: PubsubMessage[maxPubsubMessages]`,
       whose element type PubsubMessage is actually declared in the
       differently-named rpc/message.cheng). cold_scope_import_type_symbols
       bakes bare array element types through the identical
       cold_scope_import_bare_type_symbols self-alias fallback the loop above
       repairs for plain fields -- but that loop explicitly excludes anything
       containing '[' as an unsafe compound rewrite. A fixed-array field type
       is always exactly `<qualified-element>[<qualified-or-bare-count>]`; the
       count half is already correctly self-qualified (fixed-array length
       consts live in the same file as the struct that embeds the array), so
       repairing only the element half before the first '[' is exactly as
       safe as the plain-field rewrite above, just applied to a substring.
       Left unrepaired, cold_fixed_array_element_size can't resolve the baked
       self-alias, falls back to an opaque 8-byte placeholder, and later
       mismatches the correctly-qualified real struct size wherever the
       element type is referenced directly (e.g. a local `var msg:
       PubsubMessage`) -- surfacing as "fixed array element store value too
       large for element" deep inside switch.gossipsubPublish's lazy
       cross-module body materialization (task #53). */
    for (int32_t oi = 0; oi < symbols->object_count; oi++) {
        ObjectDef *object = &symbols->objects[oi];
        for (int32_t fi = 0; fi < object->field_count; fi++) {
            ObjectField *field = &object->fields[fi];
            bool is_var = false;
            Span stripped = span_trim(cold_type_strip_var(field->type_name, &is_var));
            int32_t bracket = cold_span_find_char(stripped, '[');
            if (bracket <= 0) continue; /* not a fixed-array field */
            Span element = span_trim(span_sub(stripped, 0, bracket));
            if (element.len <= 0) continue;
            if (cold_type_is_builtin_surface(element)) continue;
            if (!cold_type_has_qualified_name(element)) continue;
            int32_t dot = cold_span_find_char(element, '.');
            if (dot <= 0 || dot + 1 >= element.len) continue;
            Span bare = span_sub(element, dot + 1, element.len);
            if (cold_span_find_char(bare, '.') >= 0) continue; /* multi-level */
            if (symbols_resolve_type(symbols, element) ||
                symbols_resolve_object(symbols, element)) continue;
            Span found = {0};
            int32_t found_count = 0;
            for (int32_t ti = 0; ti < symbols->type_count; ti++) {
                Span candidate = symbols->types[ti].name;
                if (span_same(candidate, element)) continue;
                if (!cold_qualified_type_last_component_eq(candidate, bare)) continue;
                if (found_count == 0 || !span_same(found, candidate)) {
                    found = candidate;
                    found_count++;
                }
            }
            for (int32_t ooi = 0; ooi < symbols->object_count; ooi++) {
                if (symbols->objects[ooi].field_count <= 0) continue;
                Span candidate = symbols->objects[ooi].name;
                if (span_same(candidate, element)) continue;
                if (!cold_qualified_type_last_component_eq(candidate, bare)) continue;
                if (found_count == 0 || !span_same(found, candidate)) {
                    found = candidate;
                    found_count++;
                }
            }
            if (found_count != 1) continue; /* unresolved or ambiguous: leave as-is */
            Span suffix = span_sub(stripped, bracket, stripped.len); /* "[...]" */
            Span rebuilt = cold_arena_join3(symbols->arena, found, "", suffix);
            field->type_name = is_var
                ? cold_arena_join3(symbols->arena, cold_cstr_span("var "), "", rebuilt)
                : rebuilt;
        }
    }
}

static bool cold_signature_param_kind_can_refine(int32_t existing, int32_t fresh) {
    if (existing == fresh) return true;
    if (existing == SLOT_VARIANT &&
        (fresh == SLOT_I32 || fresh == SLOT_OBJECT || fresh == SLOT_SEQ_OPAQUE)) return true;
    if (existing == SLOT_OPAQUE &&
        (fresh == SLOT_OBJECT || fresh == SLOT_VARIANT || fresh == SLOT_SEQ_OPAQUE ||
         fresh == SLOT_PTR ||
         /* Mirror of cold_fn_param_kind_can_refine: let the final signature
            refinement pass precise-ify OPAQUE params whose type became
            resolvable only after later import registrations. */
         fresh == SLOT_I32 || fresh == SLOT_I64 ||
         fresh == SLOT_F32 || fresh == SLOT_F64)) return true;
    if (existing == SLOT_OPAQUE_REF &&
        (fresh == SLOT_OBJECT_REF || fresh == SLOT_SEQ_I32_REF ||
         fresh == SLOT_SEQ_STR_REF || fresh == SLOT_I32_REF || fresh == SLOT_STR_REF ||
         fresh == SLOT_SEQ_OPAQUE_REF)) return true;
    return false;
}

static int32_t cold_signature_param_resolved_size(
        Symbols *symbols, Span type, int32_t kind,
        const Span *generic_names, int32_t generic_count,
        int32_t generic_binder_kind,
        int32_t generic_binder_id) {
    bool is_var = false;
    Span stripped = span_trim(cold_type_strip_var(type, &is_var));
    /* keep in sync with cold_param_size_from_type: bool params keep their
       1-byte ABI size for Darwin arm64 packed stack placement */
    if (kind == SLOT_I32) return span_eq(stripped, "bool") ? 1 : 4;
    if (kind == SLOT_I64 || kind == SLOT_PTR) return 8;
    if (kind == SLOT_STR) return COLD_STR_SLOT_SIZE;
    if (kind == SLOT_I32_REF || kind == SLOT_I64_REF ||
        kind == SLOT_SEQ_I32_REF || kind == SLOT_OBJECT_REF ||
        kind == SLOT_STR_REF || kind == SLOT_SEQ_STR_REF ||
        kind == SLOT_SEQ_OPAQUE_REF || kind == SLOT_OPAQUE_REF ||
        kind == SLOT_OPAQUE) return 8;
    if (kind == SLOT_SEQ_I32) {
        if (!cold_parse_i32_seq_type(stripped) &&
            !cold_dynamic_seq_element_alias_resolves_to(symbols, stripped, "int32", "int")) return 0;
        return 16;
    }
    if (kind == SLOT_SEQ_STR) {
        if (!cold_parse_str_seq_type(stripped) &&
            !cold_dynamic_seq_element_alias_resolves_to(symbols, stripped, "str", "cstring")) return 0;
        return 16;
    }
    if (kind == SLOT_SEQ_OPAQUE) {
        if (!cold_parse_opaque_seq_type(stripped)) return 0;
        return 16;
    }
    if (kind == SLOT_OBJECT) {
        ObjectDef *object =
            symbols_resolve_object_in_generic_scope(
                symbols, stripped,
                generic_names, generic_count,
                generic_binder_kind,
                generic_binder_id);
        if (!object) return 0;
        return symbols_object_slot_size(object);
    }
    if (kind == SLOT_VARIANT) {
        TypeDef *def = symbols_resolve_type(symbols, stripped);
        if (!def) return 0;
        return symbols_type_slot_size(def);
    }
    if (kind == SLOT_ARRAY_I32) {
        if (!cold_parse_any_fixed_array_type(symbols, stripped, 0, 0)) return 0;
        return cold_parser_slot_size_from_type_in_generic_scope(
            symbols, stripped, kind,
            generic_names, generic_count,
            generic_binder_kind,
            generic_binder_id);
    }
    return 0;
}

void symbols_refine_function_signature_layouts(Symbols *symbols) {
    if (!symbols) return;
    for (int32_t fi = 0; fi < symbols->function_count; fi++) {
        FnDef *fn = &symbols->functions[fi];
        for (int32_t pi = 0; pi < fn->arity; pi++) {
            Span type = span_trim(fn->param_type[pi]);
            if (type.len <= 0) continue;
            int32_t kind =
                cold_parser_slot_kind_from_type_in_generic_scope(
                    symbols, type,
                    fn->generic_names,
                    fn->generic_count,
                    fn->generic_count > 0
                        ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                        : COLD_GENERIC_BINDER_NONE,
                    fn->generic_count > 0
                        ? fn->declaration_origin_row
                        : -1);
            int32_t size =
                cold_signature_param_resolved_size(
                    symbols, type, kind,
                    fn->generic_names,
                    fn->generic_count,
                    fn->generic_count > 0
                        ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                        : COLD_GENERIC_BINDER_NONE,
                    fn->generic_count > 0
                        ? fn->declaration_origin_row
                        : -1);
            if (size <= 0) continue;
            if (cold_signature_param_kind_can_refine(fn->param_kind[pi], kind)) {
                fn->param_kind[pi] = kind;
                fn->param_size[pi] = size;
            }
        }
    }
    /* Second pass: propagate refined signatures to duplicate declaration
       rows so every lookup observes one physical formal table. */
    for (int32_t ai = 0; ai < symbols->function_count; ai++) {
        FnDef *dst = &symbols->functions[ai];
        bool dst_has_zero = false;
        for (int32_t pi = 0; pi < dst->arity && dst->param_kind; pi++)
            if (dst->param_kind[pi] == 0) dst_has_zero = true;
        if (!dst_has_zero) continue;
        Span dlast = cold_span_first_qualifier(dst->name).len > 0
            ? dst->name : dst->name;
        for (int32_t bi = 0; bi < symbols->function_count; bi++) {
            FnDef *src = &symbols->functions[bi];
            if (src == dst || src->arity != dst->arity || !src->param_kind)
                continue;
            bool src_ok = false;
            for (int32_t pi = 0; pi < src->arity; pi++)
                if (src->param_kind[pi] != 0) src_ok = true;
            if (!src_ok) continue;
            if (src->name.len == 0 || dst->name.len == 0 ||
                src->name.len != dst->name.len ||
                memcmp(src->name.ptr, dst->name.ptr, src->name.len) != 0)
                continue;
            if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([bfill]) ai=%d bi=%d ar=%d\n", ai, bi, dst->arity);
            for (int32_t pi = 0; pi < dst->arity; pi++) {
                if (dst->param_kind[pi] == 0)
                    dst->param_kind[pi] = src->param_kind[pi];
                if (dst->param_size && src->param_size && dst->param_size[pi] == 0)
                    dst->param_size[pi] = src->param_size[pi];
                if (dst->param_type && src->param_type && dst->param_type[pi].len == 0)
                    dst->param_type[pi] = src->param_type[pi];
                if (dst->param_exact_type_id && src->param_exact_type_id &&
                    dst->param_exact_type_id[pi] <= 0)
                    dst->param_exact_type_id[pi] = src->param_exact_type_id[pi];
            }
            break;
        }
    }
}

/* Walk a type span recursively and revert qualification (alias.T -> T) for
   any component matching a generic parameter name. This is needed because
   cold_qualify_import_type qualifies ALL type names during import, including
   generic parameter names like T inside compound types like Result[T]. */
static Span cold_unqualify_generic_params_in_type(Arena *arena, Span alias, Span type,
                                                  Span *generic_names, int32_t generic_count) {
    if (generic_count <= 0 || !generic_names) return type;
    bool is_var = false;
    Span stripped = cold_type_strip_var(type, &is_var);
    Span base = {0}, args_span = {0};
    if (cold_type_parse_generic_instance(stripped, &base, &args_span)) {
        Span args[COLD_MAX_VARIANT_FIELDS];
        int32_t arg_count = cold_split_top_level_commas(args_span, args, COLD_MAX_VARIANT_FIELDS);
        bool changed = false;
        Span processed_args[COLD_MAX_VARIANT_FIELDS];
        for (int32_t i = 0; i < arg_count; i++) {
            processed_args[i] = cold_unqualify_generic_params_in_type(arena, alias, args[i],
                                                                      generic_names, generic_count);
            if (!span_same(processed_args[i], args[i])) changed = true;
        }
        if (!changed) return type;
        Span joined = cold_join_generic_instance(arena, base, processed_args, arg_count);
        if (!is_var) return joined;
        return cold_arena_join3(arena, cold_cstr_span("var "), "", joined);
    }
    /* Simple (non-compound) type: check for alias.<generic_name> pattern */
    for (int32_t gi = 0; gi < generic_count; gi++) {
        int32_t qlen = alias.len + 1 + generic_names[gi].len;
        if (stripped.len == qlen &&
            memcmp(stripped.ptr, alias.ptr, (size_t)alias.len) == 0 &&
            stripped.ptr[alias.len] == '.' &&
            memcmp(stripped.ptr + alias.len + 1, generic_names[gi].ptr, (size_t)generic_names[gi].len) == 0) {
            if (!is_var) return cold_arena_span_copy(arena, generic_names[gi]);
            return cold_arena_join3(arena, cold_cstr_span("var "), "", generic_names[gi]);
        }
    }
    return type;
}

void cold_collect_import_module_signatures(Symbols *symbols, Span alias,
                                                  Span module_path) {
    char path[PATH_MAX];
    if (!cold_import_source_path(module_path, path, sizeof(path))) {
        die("cold import path is not resolvable");
    }
    Span source = source_open(path);
    if (source.len <= 0) return; /* skip empty import */
    ColdImportSource *prev_direct_imports = ColdScopeDirectImports;
    int32_t prev_direct_import_count = ColdScopeDirectImportCount;
    ColdImportSource *direct_imports = (ColdImportSource *)calloc(
        (size_t)COLD_IMPORT_SOURCE_CAP, sizeof(ColdImportSource));
    if (!direct_imports) die("cold import signature scan allocation failed");
    int32_t direct_import_count = cold_collect_direct_import_sources(source, direct_imports,
                                                                     COLD_IMPORT_SOURCE_CAP);
    ColdScopeDirectImports = direct_imports;
    ColdScopeDirectImportCount = direct_import_count;
    (void)cold_register_direct_import_declaration_dependencies(
        symbols, direct_imports, direct_import_count);
    int32_t pos = 0;
    int32_t line_no = 0;
    bool in_triple = false;
    while (pos < source.len) {
        int32_t start = pos;
        while (pos < source.len && source.ptr[pos] != '\n') pos++;
        int32_t end = pos;
        if (pos < source.len) pos++;
        line_no++;
        Span line = span_sub(source, start, end);
        if (in_triple) {
            if (cold_line_has_triple_quote(line)) in_triple = false;
            continue;
        }
        if (!cold_line_top_level(line)) {
            if (cold_line_has_triple_quote(line)) in_triple = true;
            continue;
        }
        Span trimmed = span_trim(line);
        if (!cold_span_starts_with(trimmed, "fn ") &&
            !cold_span_starts_with(trimmed, "importc fn ")) continue;
        ColdFunctionSymbol symbol;
        if (!cold_parse_function_symbol_at(source, start, line_no, &symbol, symbols)) {
            if (trimmed.len > 3 && trimmed.ptr[3] == '`') continue;
            fprintf(stderr, "cheng_cold: cannot parse imported signature path=%s line=%d\n",
                    path, line_no);
            continue;
        }
        Span names[COLD_MAX_I32_PARAMS];
        Span types[COLD_MAX_I32_PARAMS];
        int32_t kinds[COLD_MAX_I32_PARAMS];
        int32_t sizes[COLD_MAX_I32_PARAMS];
        bool defaults[COLD_MAX_I32_PARAMS];
        int32_t default_values[COLD_MAX_I32_PARAMS];
        int32_t generic_binder_id =
            symbol.generic_count > 0
                ? symbols_declaration_origin_intern(
                      symbols,
                      symbol.module_source_row,
                      symbol.token_byte_offset)
                : -1;
        int32_t arity = cold_imported_param_specs(symbols, alias, symbol.params,
                                                  names, kinds, sizes, types,
                                                  COLD_MAX_I32_PARAMS,
                                                  defaults, default_values,
                                                  symbol.generic_names,
                                                  symbol.generic_count,
                                                  symbol.generic_count > 0
                                                      ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                                                      : COLD_GENERIC_BINDER_NONE,
                                                  generic_binder_id);
        Span qualified_name = cold_arena_join3(symbols->arena, alias, ".", symbol.name);
        Span qualified_ret = cold_scope_import_type_symbols(symbols, alias,
                                                            symbol.return_type,
                                                            symbol.generic_names,
                                                            symbol.generic_count);
        /* Post-process: unqualify generic param names inside compound types */
        if (symbol.generic_count > 0) {
            qualified_ret = cold_unqualify_generic_params_in_type(symbols->arena, alias,
                                                                  qualified_ret,
                                                                  symbol.generic_names,
                                                                  symbol.generic_count);
            for (int32_t ti = 0; ti < arity; ti++) {
                types[ti] = cold_unqualify_generic_params_in_type(symbols->arena, alias,
                                                                  types[ti],
                                                                  symbol.generic_names,
                                                                  symbol.generic_count);
            }
        }
        int32_t fi = symbols_add_fn_at_origin(
            symbols, qualified_name, arity, kinds, sizes, types,
            qualified_ret, symbol.module_source_row,
            symbol.token_byte_offset);
        symbols_set_fn_param_types(symbols, fi, types, arity);
        if (fi >= 0 && fi < symbols->function_count) {
            FnDef *def_fn = &symbols->functions[fi];
            /* Path and line are diagnostic projections only. Exact merge
               authority was already decided by declarationOriginRow. */
            if (def_fn->decl_path.len <= 0) {
                def_fn->decl_path = cold_arena_span_copy(symbols->arena, cold_cstr_span(path));
                def_fn->decl_line = line_no;
            }
            def_fn->borrows_args =
                symbol.borrows_args;
            def_fn->thread_boundary =
                symbol.thread_boundary;
            if (def_fn->decl_has_body &&
                def_fn->result_ownership_summary !=
                    symbol.result_ownership_summary) {
                die("imported function result ownership summary drift");
            }
            def_fn->result_ownership_summary =
                symbol.result_ownership_summary;
            if (symbol.has_body) def_fn->decl_has_body = true;
            for (int32_t di = 0; di < arity && di < COLD_MAX_I32_PARAMS; di++) {
                if (defaults[di]) {
                    def_fn->param_has_default[di] = true;
                    def_fn->param_default_value[di] = default_values[di];
                }
            }
        }
        if (getenv("CHENG_COLD_DUMP_IMPORT_SIG") != NULL) {
            fprintf(stderr, "IMPORT_SIG %.*s arity=%d kind0=%d size0=%d type0=%.*s ret=%.*s fi=%d\n",
                    (int)qualified_name.len, qualified_name.ptr,
                    arity, arity > 0 ? kinds[0] : 0, arity > 0 ? sizes[0] : 0,
                    arity > 0 ? (int)types[0].len : 0,
                    arity > 0 ? types[0].ptr : (const uint8_t *)"",
                    (int)qualified_ret.len, qualified_ret.ptr, fi);
        }
        if (fi >= 0 && fi < symbols->function_cap) {
            /* @importc/external functions are FFI bodies with no Cheng source to
               specialize: force generic_count=0 so they never enter the generic
               specialization path (would mint a dangling name$g<hash>). */
            int32_t gn = (symbol.import_name.len > 0) ? 0
                         : (symbol.generic_count < 4 ? symbol.generic_count : 4);
            if (gn > 0) {
                cold_function_generic_names_set(
                    symbols, &symbols->functions[fi],
                    symbol.generic_names, gn);
            } else if (symbols->functions[fi].generic_count != 0 ||
                       symbols->functions[fi].generic_names) {
                die("imported external function generic binder drift");
            }
        }
        cold_publish_exact_formal_type_ids(
            symbols, fi);
        if (symbol.import_name.len > 0) symbols_set_fn_link_name(symbols, fi, symbol.import_name);
        if (symbol.export_name.len > 0) symbols_set_fn_link_name(symbols, fi, symbol.export_name);
        if (symbol.ffi_owned_result_free.len > 0)
            symbols_set_fn_owned_result_free(symbols, fi, symbol.ffi_owned_result_free);
        if (fi >= 0 && fi < symbols->function_cap &&
            !symbol.has_body && symbol.import_name.len > 0)
            symbols->functions[fi].is_external = true;
    }
    ColdScopeDirectImports = prev_direct_imports;
    ColdScopeDirectImportCount = prev_direct_import_count;
    free(direct_imports);
    source_close(source);
}

void cold_collect_imported_function_signatures(Symbols *symbols, Span source) {
    /* Fresh compile epoch: the (alias, path) type registration registry must
       not carry over across Symbols instances. Every compile pipeline calls
       this collector exactly once before its transitive import walk. */
    cold_import_types_once_reset();
    /* De-duplication: track visited module paths to avoid re-parsing
       the same source file when multiple imports reference it (e.g.
       different aliases for the same module, or transitive re-imports). */
    char visited_paths[64][PATH_MAX];
    Span visited_aliases[64];
    int32_t visited_count = 0;

    int32_t pos = 0;
    bool in_triple = false;
    while (pos < source.len) {
        int32_t start = pos;
        while (pos < source.len && source.ptr[pos] != '\n') pos++;
        int32_t end = pos;
        if (pos < source.len) pos++;
        Span line = span_sub(source, start, end);
        if (in_triple) {
            if (cold_line_has_triple_quote(line)) in_triple = false;
            continue;
        }
        if (!cold_line_top_level(line)) {
            if (cold_line_has_triple_quote(line)) in_triple = true;
            continue;
        }
        Span module_path = {0};
        Span alias = {0};
        if (!cold_parse_import_line(span_trim(line), &module_path, &alias)) continue;
        char path_buf[PATH_MAX];
        if (!cold_import_source_path(module_path, path_buf, sizeof(path_buf))) continue;
        bool seen = false;
        for (int32_t vi = 0; vi < visited_count; vi++) {
            if (strcmp(visited_paths[vi], path_buf) == 0 &&
                span_same(visited_aliases[vi], alias)) { seen = true; break; }
        }
        if (seen) continue;
        if (visited_count < 64) {
            strncpy(visited_paths[visited_count++], path_buf, PATH_MAX - 1);
            visited_aliases[visited_count - 1] = alias;
        }
        (void)cold_collect_import_module_types_once(symbols, alias, path_buf);
    }
    symbols_refine_object_layouts(symbols);

    /* Reset visited for pass 2 (function signatures) */
    visited_count = 0;
    pos = 0;
    in_triple = false;
    while (pos < source.len) {
        int32_t start = pos;
        while (pos < source.len && source.ptr[pos] != '\n') pos++;
        int32_t end = pos;
        if (pos < source.len) pos++;
        Span line = span_sub(source, start, end);
        if (in_triple) {
            if (cold_line_has_triple_quote(line)) in_triple = false;
            continue;
        }
        if (!cold_line_top_level(line)) {
            if (cold_line_has_triple_quote(line)) in_triple = true;
            continue;
        }
        Span module_path = {0};
        Span alias = {0};
        if (!cold_parse_import_line(span_trim(line), &module_path, &alias)) continue;
        char path_buf[PATH_MAX];
        if (!cold_import_source_path(module_path, path_buf, sizeof(path_buf))) continue;
        bool seen = false;
        for (int32_t vi = 0; vi < visited_count; vi++) {
            if (strcmp(visited_paths[vi], path_buf) == 0 &&
                span_same(visited_aliases[vi], alias)) { seen = true; break; }
        }
        if (seen) continue;
        if (visited_count < 64) {
            strncpy(visited_paths[visited_count++], path_buf, PATH_MAX - 1);
            visited_aliases[visited_count - 1] = alias;
        }
        cold_collect_import_module_signatures(symbols, alias, module_path);
    }
    symbols_refine_function_signature_layouts(symbols);
}

void cold_collect_function_signatures(Symbols *symbols, Span source) {
    Parser type_parser = symbols
        ? cold_parser_issue_legacy_span(symbols, source)
        : cold_parser_issue_lexical_span(0, source);
    while (type_parser.pos < source.len) {
        int32_t line_start = type_parser.pos;
        while (line_start < source.len &&
               (source.ptr[line_start] == '\n' || source.ptr[line_start] == '\r')) {
            line_start++;
        }
        if (line_start >= source.len) break;
        int32_t line_end = line_start;
        while (line_end < source.len && source.ptr[line_end] != '\n') line_end++;
        Span line = span_sub(source, line_start, line_end);
        Span trimmed = span_trim(line);
        if (cold_line_top_level(line) &&
            cold_span_is_exact_or_prefix_space(trimmed, "type")) {
            type_parser.pos = line_start;
            parse_type(&type_parser);
        } else {
            type_parser.pos = line_end < source.len ? line_end + 1 : line_end;
            if (!cold_line_top_level(line) &&
                cold_line_has_odd_triple_quote(trimmed)) {
                while (type_parser.pos < source.len) {
                    int32_t nested_start = type_parser.pos;
                    while (type_parser.pos < source.len &&
                           source.ptr[type_parser.pos] != '\n') {
                        type_parser.pos++;
                    }
                    Span nested = span_sub(source, nested_start, type_parser.pos);
                    if (type_parser.pos < source.len) type_parser.pos++;
                    if (cold_line_has_odd_triple_quote(nested)) break;
                }
            }
        }
    }

    int32_t pos = 0;
    int32_t line_no = 0;
    bool in_triple = false;
    while (pos < source.len) {
        int32_t start = pos;
        while (pos < source.len && source.ptr[pos] != '\n') pos++;
        int32_t end = pos;
        if (pos < source.len) pos++;
        line_no++;
        Span line = span_sub(source, start, end);
        if (in_triple) {
            if (cold_line_has_triple_quote(line)) in_triple = false;
            continue;
        }
        if (!cold_line_top_level(line)) {
            if (cold_line_has_triple_quote(line)) in_triple = true;
            continue;
        }
        Span trimmed = span_trim(line);
        if (!cold_span_starts_with(trimmed, "fn ") &&
            !cold_span_starts_with(trimmed, "importc fn ")) continue;
        ColdFunctionSymbol symbol;
        if (!cold_parse_function_symbol_at(source, start, line_no, &symbol, symbols)) {
            continue; /* skip unparseable signature */
        }
        Span param_names[COLD_MAX_I32_PARAMS];
        Span param_types[COLD_MAX_I32_PARAMS];
        int32_t param_kinds[COLD_MAX_I32_PARAMS];
        int32_t param_sizes[COLD_MAX_I32_PARAMS];
        int32_t generic_binder_id =
            symbol.generic_count > 0
                ? symbols_declaration_origin_intern(
                      symbols,
                      symbol.module_source_row,
                      symbol.token_byte_offset)
                : -1;
        int32_t arity = parse_param_specs_with_generics(symbols, symbol.params,
                                                        symbol.generic_names,
                                                        symbol.generic_count,
                                                        symbol.generic_count > 0
                                                            ? COLD_GENERIC_BINDER_FUNCTION_DECLARATION_ORIGIN
                                                            : COLD_GENERIC_BINDER_NONE,
                                                        generic_binder_id,
                                                        param_names, param_kinds,
                                                        param_sizes, param_types,
                                                        COLD_MAX_I32_PARAMS);
        int32_t fi = symbols_add_fn_at_origin(
            symbols, symbol.name, arity, param_kinds, param_sizes,
            param_types, symbol.return_type, symbol.module_source_row,
            symbol.token_byte_offset);
        symbols_set_fn_param_types(symbols, fi, param_types, arity);
        if (symbol.import_name.len > 0) symbols_set_fn_link_name(symbols, fi, symbol.import_name);
        if (symbol.export_name.len > 0) symbols_set_fn_link_name(symbols, fi, symbol.export_name);
        if (symbol.ffi_owned_result_free.len > 0)
            symbols_set_fn_owned_result_free(symbols, fi, symbol.ffi_owned_result_free);
        if (fi >= 0 && fi < symbols->function_cap) {
            FnDef *fn = &symbols->functions[fi];
            fn->borrows_args =
                symbol.borrows_args;
            fn->thread_boundary =
                symbol.thread_boundary;
            if (fn->decl_has_body &&
                fn->result_ownership_summary !=
                    symbol.result_ownership_summary) {
                die("function result ownership summary drift");
            }
            fn->result_ownership_summary =
                symbol.result_ownership_summary;
            if (symbol.has_body) fn->decl_has_body = true;
            if (symbol.import_name.len > 0 && !symbol.has_body)
                fn->is_external = true;
            /* @importc/external functions never carry generics (no Cheng body to
               specialize); guard against implicit-generic mis-inference. */
            int32_t entry_gc = (symbol.import_name.len > 0) ? 0 : symbol.generic_count;
            if (entry_gc > 0) {
                if (entry_gc > 4)
                    die("function generic binder capacity exceeded");
                cold_function_generic_names_set(
                    symbols, fn, symbol.generic_names,
                    entry_gc);
            } else if (fn->generic_count != 0 ||
                       fn->generic_names) {
                die("external function generic binder drift");
            }
            cold_publish_exact_formal_type_ids(
                symbols, fi);
            /* Re-parse params to find default values (= <int32> after type) */
            Parser pp = cold_parser_issue_lexical_span(0, symbol.params);
            int32_t pi = 0;
            while (pp.pos < pp.source.len && pi < arity) {
                (void)parser_token(&pp); /* param name */
                if (span_eq(parser_peek(&pp), ":")) {
                    (void)parser_token(&pp);
                    (void)parser_take_type_span(&pp); /* skip type */
                }
                if (span_eq(parser_peek(&pp), "=")) {
                    (void)parser_token(&pp);
                    Span val = parser_token(&pp);
                    int32_t def_i32 = 0;
                    if (cold_default_literal_i32(val, &def_i32)) {
                        fn->param_has_default[pi] = true;
                        fn->param_default_value[pi] = def_i32;
                    }
                }
                while (pp.pos < pp.source.len &&
                       !span_eq(parser_peek(&pp), ",") &&
                       !span_eq(parser_peek(&pp), ")")) (void)parser_token(&pp);
                if (span_eq(parser_peek(&pp), ",")) (void)parser_token(&pp);
                pi++;
            }
        }
    }
}

void parse_type(Parser *parser);

static bool cold_line_is_comment_only(Span line) {
    Span trimmed = span_trim(line);
    return trimmed.len > 0 &&
           (trimmed.ptr[0] == '#' ||
           (trimmed.len >= 2 &&
             trimmed.ptr[0] == '/' &&
             trimmed.ptr[1] == '/'));
}

/* Iterate one indentation-owned object field declaration. A field with text
   after ':' ends on its physical line. An empty RHS owns only strictly deeper
   continuation lines, so the next same-indent field can never be swallowed.
   The returned span is an immutable source view tokenized by
   parser_take_type_span. */
static int32_t cold_object_field_statement_next(
        Span fields, int32_t *cursor,
        Span *statement_out) {
    if (!cursor || !statement_out ||
        *cursor < 0 || *cursor > fields.len) {
        return -1;
    }
    int32_t pos = *cursor;
    while (pos < fields.len) {
        int32_t line_start = pos;
        while (pos < fields.len &&
               fields.ptr[pos] != '\n' &&
               fields.ptr[pos] != '\r') {
            pos++;
        }
        int32_t line_end = pos;
        if (pos < fields.len &&
            fields.ptr[pos] == '\r') {
            pos++;
        }
        if (pos < fields.len &&
            fields.ptr[pos] == '\n') {
            pos++;
        }
        Span raw_line =
            span_sub(fields, line_start, line_end);
        Span trimmed = span_trim(raw_line);
        if (trimmed.len <= 0 ||
            cold_line_is_comment_only(trimmed)) {
            continue;
        }
        int32_t statement_indent =
            cold_line_indent_width(raw_line);
        int32_t colon =
            cold_span_find_top_level_char(
                trimmed, ':');
        if (colon <= 0) return -1;
        Span field_name =
            span_trim(span_sub(trimmed, 0, colon));
        if (!cold_span_is_simple_ident(field_name))
            return -1;
        Span same_line_type =
            span_trim(span_sub(
                trimmed, colon + 1,
                trimmed.len));
        int32_t statement_end = line_end;
        if (same_line_type.len <= 0) {
            int32_t continuation = pos;
            bool found_type_line = false;
            while (continuation < fields.len) {
                int32_t nested_start = continuation;
                int32_t nested_end = nested_start;
                while (nested_end < fields.len &&
                       fields.ptr[nested_end] != '\n' &&
                       fields.ptr[nested_end] != '\r') {
                    nested_end++;
                }
                int32_t nested_next = nested_end;
                if (nested_next < fields.len &&
                    fields.ptr[nested_next] == '\r') {
                    nested_next++;
                }
                if (nested_next < fields.len &&
                    fields.ptr[nested_next] == '\n') {
                    nested_next++;
                }
                Span nested_line =
                    span_sub(fields, nested_start,
                             nested_end);
                Span nested_trimmed =
                    span_trim(nested_line);
                if (nested_trimmed.len <= 0 ||
                    cold_line_is_comment_only(
                        nested_trimmed)) {
                    continuation = nested_next;
                    statement_end = nested_end;
                    continue;
                }
                int32_t nested_indent =
                    cold_line_indent_width(
                        nested_line);
                if (nested_indent <=
                        statement_indent) {
                    break;
                }
                found_type_line = true;
                statement_end = nested_end;
                continuation = nested_next;
            }
            if (!found_type_line) return -1;
            pos = continuation;
        }
        *statement_out =
            span_trim(span_sub(
                fields, line_start,
                statement_end));
        if (statement_out->len <= 0)
            return -1;
        *cursor = pos;
        return 1;
    }
    *cursor = pos;
    return 0;
}

bool cold_type_block_looks_like_object(Span fields) {
    int32_t cursor = 0;
    int32_t count = 0;
    for (;;) {
        Span statement = {0};
        int32_t status =
            cold_object_field_statement_next(
                fields, &cursor, &statement);
        if (status == 0) break;
        if (status < 0) return false;
        Parser parser;
        memset(&parser, 0, sizeof(parser));
        parser.source = statement;
        Span field_name = parser_token(&parser);
        if (!cold_span_is_simple_ident(field_name) ||
            !parser_take(&parser, ":")) {
            return false;
        }
        Span field_type =
            parser_take_type_span(&parser);
        if (field_type.len <= 0)
            return false;
        if (span_eq(parser_peek(&parser), "=")) {
            (void)parser_token(&parser);
            parser_ws(&parser);
            if (parser.pos >= parser.source.len)
                return false;
            parser.pos = parser.source.len;
        }
        if (parser_peek(&parser).len != 0)
            return false;
        count++;
    }
    return count > 0;
}

void parse_grouped_type_block(Parser *parser, int32_t block_start, int32_t block_end) {
    int32_t pos = block_start;
    while (pos < block_end && parser->source.ptr[pos] != '\n') pos++;
    if (pos < block_end) pos++;
    int32_t group_indent = -1;
    int32_t real_member_count = 0;
    while (pos < block_end) {
        int32_t line_start = pos;
        int32_t indent = 0;
        while (pos < block_end && parser->source.ptr[pos] == ' ') {
            indent++;
            pos++;
        }
        if (pos >= block_end) break;
        if (parser->source.ptr[pos] == '\n') {
            pos++;
            continue;
        }
        int32_t first_line_end = pos;
        while (first_line_end < block_end &&
               parser->source.ptr[first_line_end] != '\n') {
            first_line_end++;
        }
        if (cold_line_is_comment_only(
                span_sub(parser->source, pos, first_line_end))) {
            pos = first_line_end;
            if (pos < block_end) pos++;
            continue;
        }
        if (group_indent < 0) group_indent = indent;
        if (indent < group_indent || indent == 0) break;
        int32_t member_start = line_start;
        pos = first_line_end;
        if (pos < block_end) pos++;
        int32_t member_end = pos;
        while (pos < block_end) {
            int32_t next_line = pos;
            int32_t next_indent = 0;
            while (pos < block_end && parser->source.ptr[pos] == ' ') {
                next_indent++;
                pos++;
            }
            if (pos >= block_end) break;
            if (parser->source.ptr[pos] == '\n') {
                pos++;
                continue;
            }
            int32_t next_content_start = pos;
            int32_t next_line_end = pos;
            while (next_line_end < block_end &&
                   parser->source.ptr[next_line_end] != '\n') {
                next_line_end++;
            }
            if (cold_line_is_comment_only(
                    span_sub(parser->source,
                             next_content_start,
                             next_line_end)) &&
                next_indent == group_indent) {
                pos = next_line_end;
                if (pos < block_end) pos++;
                continue;
            }
            if (next_indent == group_indent) {
                pos = next_line;
                break;
            }
            if (next_indent < group_indent || next_indent == 0) {
                pos = next_line;
                break;
            }
            pos = next_line_end;
            if (pos < block_end) pos++;
            member_end = pos;
        }
        /* Parse the immutable source view itself.  Prefixing a copied
           "type " buffer here destroys the member-name token's exact
           (moduleSourceRow, tokenByteOffset) identity.  parse_type already
           accepts the grouped member grammar `Name = ...`; retaining the
           original indented subview also lets snapshot-origin lookup recover
           the physical member-name token independent of declaration order. */
        Parser member_parser = parser_child(
            parser,
            span_sub(parser->source, member_start, member_end));
        parse_type(&member_parser);
        real_member_count++;
    }
    if (real_member_count <= 0)
        die("grouped type block has no declarations");
    parser->pos = block_end;
}

static void cold_type_rhs_split_header_fields(
        Span rhs, Span *header_out, Span *fields_out) {
    int32_t line_end = 0;
    while (line_end < rhs.len && rhs.ptr[line_end] != '\n' &&
           rhs.ptr[line_end] != '\r') {
        line_end++;
    }
    Span header = span_trim(span_sub(rhs, 0, line_end));
    if (header.len > 0 && header.ptr[header.len - 1] == ':')
        header = span_trim(span_sub(header, 0, header.len - 1));
    int32_t body_start = line_end;
    while (body_start < rhs.len &&
           (rhs.ptr[body_start] == '\n' ||
            rhs.ptr[body_start] == '\r')) {
        body_start++;
    }
    if (header_out) *header_out = header;
    if (fields_out)
        *fields_out = span_sub(rhs, body_start, rhs.len);
}

static bool cold_object_header_base_type(
        Parser *owner, Span header, bool ref_object,
        bool implicit_object, Span *base_type_out) {
    Parser header_parser = parser_child(owner, header);
    if (ref_object) {
        if (!parser_take(&header_parser, "ref") ||
            !parser_take(&header_parser, "object")) {
            die("expected exact ref object declaration header");
        }
    } else if (!implicit_object) {
        if (!parser_take(&header_parser, "object"))
            die("expected object declaration header");
    }
    Span base_type = {0};
    if (span_eq(parser_peek(&header_parser), "of")) {
        (void)parser_token(&header_parser);
        base_type = parser_take_type_span(&header_parser);
        if (base_type.len <= 0) die("object inheritance base type missing");
    }
    if (parser_peek(&header_parser).len != 0)
        die("object declaration header has trailing tokens");
    if (base_type_out) *base_type_out = base_type;
    return base_type.len > 0;
}

static int32_t cold_object_base_resolve_exact(
        Parser *parser, Span raw_base_type) {
    if (!parser || !parser->symbols || raw_base_type.len <= 0)
        die("object inheritance base authority missing");
    Span base_type = parser_scope_type(parser, raw_base_type);
    ObjectDef *base = symbols_resolve_object(parser->symbols, base_type);
    if (!base) die("object inheritance base object unresolved");
    int32_t base_index = symbols_object_index(parser->symbols, base);
    if (base_index < 0 || base_index >= parser->symbols->object_count)
        die("object inheritance base row invalid");
    base = &parser->symbols->objects[base_index];
    if (base->is_ref)
        die("object inheritance base cannot be ref object");
    if (base->generic_count > 0)
        die("object inheritance base generic is not instantiated");
    int32_t cursor = base_index;
    int32_t depth = 0;
    while (cursor >= 0) {
        if (cursor >= parser->symbols->object_count ||
            depth > parser->symbols->object_count) {
            die("object inheritance graph cycle or row drift");
        }
        ObjectDef *row = &parser->symbols->objects[cursor];
        if (row->is_ref)
            die("object inheritance chain contains ref object");
        cursor = row->base_object_index;
        depth++;
    }
    return base_index;
}

void parse_type(Parser *parser) {
    int32_t line_start = parser->pos;
    int32_t first_line_end = line_start;
    while (first_line_end < parser->source.len && parser->source.ptr[first_line_end] != '\n') first_line_end++;
    Span first_line = span_trim(span_sub(parser->source, line_start, first_line_end));
    if (span_eq(first_line, "type")) {
        int32_t group_end = first_line_end;
        if (group_end < parser->source.len) group_end++;
        while (group_end < parser->source.len) {
            int32_t pos = group_end;
            int32_t indent = 0;
            while (pos < parser->source.len && parser->source.ptr[pos] == ' ') {
                indent++;
                pos++;
            }
            if (pos >= parser->source.len) break;
            if (parser->source.ptr[pos] == '\n') {
                group_end = pos + 1;
                continue;
            }
            if (indent == 0) break;
            while (group_end < parser->source.len && parser->source.ptr[group_end] != '\n') group_end++;
            if (group_end < parser->source.len) group_end++;
        }
        parse_grouped_type_block(parser, line_start, group_end);
        return;
    }

    int32_t line_end = first_line_end;
    int32_t type_body_indent = -1;
    if (line_end < parser->source.len) line_end++;
    while (line_end < parser->source.len) {
        int32_t indent = 0;
        int32_t pos = line_end;
        while (pos < parser->source.len && parser->source.ptr[pos] == ' ') { indent++; pos++; }
        if (pos >= parser->source.len) break;
        if (parser->source.ptr[pos] == '\n') { line_end = pos + 1; continue; }
        if (type_body_indent < 0) type_body_indent = indent;
        if (indent < type_body_indent) break;
        if (indent == 0) break;
        while (line_end < parser->source.len && parser->source.ptr[line_end] != '\n') line_end++;
        if (line_end < parser->source.len) line_end++;
    }

    Parser line = parser_child(parser, span_sub(parser->source, line_start, line_end));
    Span first_token = parser_token(&line);
    bool saw_type_keyword = span_eq(first_token, "type");
    Span type_name;
    if (saw_type_keyword) {
        type_name = parser_token(&line);
    } else {
        type_name = first_token;
        if (!cold_span_is_simple_ident(type_name)) die("expected type declaration");
    }
    int32_t declaration_module_source_row = -1;
    int32_t declaration_token_byte_offset = -1;
    if (!cold_parser_declaration_origin_from_token(
            &line, type_name,
            &declaration_module_source_row,
            &declaration_token_byte_offset)) {
        fprintf(
            stderr,
            "cheng_cold: type declaration origin lookup failed "
            "source=%s name=%.*s token_offset=%d "
            "source_length=%d snapshot_active=%d "
            "snapshot_sources=%d snapshot_views=%d\n",
            line.source_path ? line.source_path : "<unknown>",
            type_name.len,
            type_name.ptr
                ? type_name.ptr
                : (const uint8_t *)"",
            cold_span_offset(line.source, type_name),
            line.source.len,
            ColdActiveSourceSnapshots ? 1 : 0,
            ColdActiveSourceSnapshots
                ? ColdActiveSourceSnapshots->count : 0,
            ColdActiveSourceSnapshots
                ? ColdActiveSourceSnapshots->view_count : 0);
        die("type declaration lacks exact immutable declaration origin");
    }
    Span generic_names[COLD_MAX_VARIANT_FIELDS];
    int32_t generic_count = 0;
    if (span_eq(parser_peek(&line), "[")) {
        (void)parser_token(&line);
        while (!span_eq(parser_peek(&line), "]")) {
            if (generic_count >= COLD_MAX_VARIANT_FIELDS) die("too many cold generic params");
            Span generic = parser_token(&line);
            if (!cold_span_is_simple_ident(generic)) die("expected generic param name");
            generic_names[generic_count++] = generic;
            if (span_eq(parser_peek(&line), ",")) {
                (void)parser_token(&line);
                continue;
            }
            break;
        }
        if (!parser_take(&line, "]")) die("expected ] after generic params");
    }
    if (!parser_take(&line, "=")) {
        if (!saw_type_keyword) {
            Span next = parser_peek(&line);
            fprintf(
                stderr,
                "cheng_cold: grouped type member is not a declaration "
                "name=%.*s next=%.*s source=%.*s\n",
                type_name.len, type_name.ptr,
                next.len, next.ptr,
                first_line.len, first_line.ptr);
            die("expected grouped type member =");
        }
        parser->pos = line_end;
        return;
    }

    Span rhs_check = span_trim(span_sub(line.source, line.pos, line.source.len));
    Span rhs_header = {0};
    Span rhs_fields = {0};
    cold_type_rhs_split_header_fields(
        rhs_check, &rhs_header, &rhs_fields);
    if (cold_span_starts_with(rhs_check, "enum")) {
        if (generic_count > 0) die("cold enum cannot be generic");
        Parser enum_parser = parser_child(parser, rhs_check);
        if (!parser_take(&enum_parser, "enum")) die("expected enum");
        Span variant_names[COLD_MAX_TYPE_VARIANTS];
        int32_t variant_values[COLD_MAX_TYPE_VARIANTS];
        int32_t enum_variant_count = 0;
        int32_t next_enum_value = 0; /* running counter: explicit `= N` resets it */
        while (enum_parser.pos < enum_parser.source.len) {
            Span variant_name = parser_token(&enum_parser);
            if (variant_name.len <= 0) break;
            if (span_eq(variant_name, ",")) continue;
            if (!cold_span_is_simple_ident(variant_name)) continue; /* skip non-ident variant */
            if (enum_variant_count >= COLD_MAX_TYPE_VARIANTS)
                die("too many cold enum variants");
            variant_names[enum_variant_count] = variant_name;
            int32_t value = next_enum_value;
            /* parse explicit `Member = <int>` value; resets the running counter */
            if (span_eq(parser_peek(&enum_parser), "=")) {
                (void)parser_token(&enum_parser); /* consume '=' */
                Span val_tok = parser_token(&enum_parser);
                if (span_is_i32(val_tok)) value = span_i32(val_tok);
            }
            variant_values[enum_variant_count] = value;
            next_enum_value = value + 1;
            enum_variant_count++;
        }
        if (enum_variant_count <= 0) die("cold enum has no variants");
        TypeDef *type = symbols_add_type_at_origin(
            parser->symbols, type_name, enum_variant_count,
            declaration_module_source_row,
            declaration_token_byte_offset);
        type->is_enum = true;
        for (int32_t vi = 0; vi < enum_variant_count; vi++) {
            Variant *variant = &type->variants[vi];
            variant->name = cold_arena_span_copy(parser->arena, variant_names[vi]);
            int32_t tag = variant_values[vi];
            variant->tag = tag;
            variant->field_count = 0;
            variant_finalize_layout(type, variant);
            symbols_add_const(parser->symbols, variant->name, tag, (Span){0});
            /* also register qualified name: Type.Variant */
            int32_t qn_len = type_name.len + 1 + variant->name.len;
            char *qn_ptr = arena_alloc(parser->arena, (size_t)qn_len + 1);
            memcpy(qn_ptr, type_name.ptr, (size_t)type_name.len);
            qn_ptr[type_name.len] = '.';
            memcpy(qn_ptr + type_name.len + 1, variant->name.ptr, (size_t)variant->name.len);
            qn_ptr[qn_len] = '\0';
            Span qn = {(const uint8_t *)qn_ptr, qn_len};
            symbols_add_const(parser->symbols, qn, tag, (Span){0});
        }
        parser->pos = line_end;
        return;
    }
    if (cold_fn_sig_is_type(rhs_check) ||
        cold_type_is_builtin_surface(rhs_check)) {
        Span scoped_alias =
            parser_scope_type(parser, rhs_check);
        TypeDef *type = symbols_add_type_at_origin(
            parser->symbols, type_name, 0,
            declaration_module_source_row,
            declaration_token_byte_offset);
        symbols_set_type_generic_names(
            parser->symbols, type, generic_names,
            generic_count);
        symbols_set_type_alias(type, scoped_alias);
        parser->pos = line_end;
        return;
    }
    Parser rhs_header_parser = parser_child(parser, rhs_header);
    Span rhs_header_first = parser_peek(&rhs_header_parser);
    Parser ref_header = parser_child(parser, rhs_header);
    Span ref_first = parser_token(&ref_header);
    Span ref_second = parser_peek(&ref_header);
    if (span_eq(ref_first, "ref") && span_eq(ref_second, "object")) {
        Span raw_base_type = {0};
        bool has_base = cold_object_header_base_type(
            parser, rhs_header, true, false, &raw_base_type);
        int32_t base_index = has_base ?
            cold_object_base_resolve_exact(parser, raw_base_type) : -1;
        int32_t inherited_field_count = base_index >= 0 ?
            parser->symbols->objects[base_index].field_count : 0;
        int32_t rfc = 0;
        Span rfn[COLD_MAX_OBJECT_FIELDS];
        Span rft[COLD_MAX_OBJECT_FIELDS];
        bool rfd[COLD_MAX_OBJECT_FIELDS];
        Span rfv[COLD_MAX_OBJECT_FIELDS];
        if (rhs_fields.len > 0) {
            int32_t fp = 0;
            for (;;) {
                Span tr = {0};
                int32_t field_status =
                    cold_object_field_statement_next(
                        rhs_fields, &fp, &tr);
                if (field_status == 0) break;
                if (field_status < 0)
                    die("malformed ref object field statement");
                if (rfc >= COLD_MAX_OBJECT_FIELDS)
                    die("too many ref object fields");
                Parser rp = parser_child(parser, tr);
                Span fn2 = parser_token(&rp);
                if (fn2.len <= 0) continue;
                if (!parser_take(&rp, ":"))
                    die("expected : in ref object field");
                Span ft = parser_take_type_span(&rp);
                if (ft.len <= 0)
                    die("expected ref object field type");
                if (cold_type_contains_sabi_boundary(ft)) {
                    fprintf(stderr, "ZRPC/SABI violation: ");
                    cold_error_loc(parser, ft);
                    fprintf(stderr,
                            ": SABI boundary type `%.*s` cannot be used as a ref object field.\n",
                            (int)ft.len, ft.ptr);
                    ColdErrorRecoveryEnabled = false;
                    die("ZRPC/SABI violation");
                }
                rfn[rfc] = fn2;
                rft[rfc] = ft;
                rfd[rfc] = false;
                rfv[rfc] = (Span){0};
                if (span_eq(parser_peek(&rp), "=")) {
                    (void)parser_token(&rp);
                    Span default_expr =
                        span_trim(span_sub(tr, rp.pos, tr.len));
                    if (default_expr.len <= 0)
                        die("expected ref object field default expression");
                    rfd[rfc] = true;
                    rfv[rfc] = default_expr;
                    rp.pos = rp.source.len;
                }
                if (parser_peek(&rp).len != 0)
                    die("ref object field has trailing tokens");
                rfc++;
            }
        }
        ObjectDef *existing = symbols_find_object(parser->symbols,
                                                  type_name);
        int32_t total_field_count = inherited_field_count + rfc;
        if (existing &&
            (existing->field_count != total_field_count ||
             !existing->is_ref ||
             existing->base_object_index != base_index ||
             existing->inherited_field_count !=
                 inherited_field_count))
            die("ref object schema drift");
        ObjectDef *robj = symbols_add_object_at_origin(
            parser->symbols, type_name, total_field_count,
            declaration_module_source_row,
            declaration_token_byte_offset);
        if (robj->field_count != total_field_count)
            die("ref object field count drift");
        int32_t robj_index =
            symbols_object_index(parser->symbols, robj);
        if (robj_index < 0)
            die("ref object declaration row missing");
        if (base_index >= 0)
            object_materialize_inherited_prefix(
                parser->symbols, robj, base_index);
        symbols_set_object_generic_names(
            parser->symbols, robj, generic_names,
            generic_count);
        for (int32_t fi = 0; fi < rfc; fi++) {
            int32_t dst_index = inherited_field_count + fi;
            robj = &parser->symbols->objects[robj_index];
            for (int32_t previous = 0;
                 previous < dst_index; previous++) {
                if (span_same(robj->fields[previous].name, rfn[fi]))
                    die("duplicate ref object field");
            }
            bool generic_field =
                cold_type_is_direct_generic_placeholder(
                    rft[fi], generic_names,
                    generic_count);
            int32_t fk =
                generic_field
                    ? SLOT_I32
                    : cold_parser_slot_kind_from_type_in_generic_scope(
                          parser->symbols, rft[fi],
                          generic_names, generic_count,
                          generic_count > 0
                              ? COLD_GENERIC_BINDER_OBJECT_ROW
                              : COLD_GENERIC_BINDER_NONE,
                          generic_count > 0
                              ? robj_index : -1);
            if (fk == SLOT_VARIANT &&
                !symbols_resolve_type(parser->symbols, rft[fi]))
                fk = SLOT_I32;
            int32_t field_size =
                generic_field
                    ? 4
                    : cold_payload_size_from_type_in_generic_scope(
                          parser->symbols, rft[fi], fk,
                          generic_names, generic_count,
                          generic_count > 0
                              ? COLD_GENERIC_BINDER_OBJECT_ROW
                              : COLD_GENERIC_BINDER_NONE,
                          generic_count > 0
                              ? robj_index : -1);
            int32_t array_len = 0;
            if (fk == SLOT_ARRAY_I32 &&
                !cold_parse_fixed_array_type(
                    parser->symbols, rft[fi], &array_len)) {
                die("ref object fixed array identity is unresolved");
            }
            robj = &parser->symbols->objects[robj_index];
            robj->fields[dst_index].name = rfn[fi];
            robj->fields[dst_index].kind = fk;
            robj->fields[dst_index].size = field_size;
            robj->fields[dst_index].type_name = rft[fi];
            robj->fields[dst_index].array_len = array_len;
            robj->fields[dst_index].has_default = rfd[fi];
            robj->fields[dst_index].default_expr = rfv[fi];
        }
        robj = &parser->symbols->objects[robj_index];
        robj->is_ref = true;
        if (base_index >= 0) {
            object_finalize_fields_with_base(
                robj, &parser->symbols->objects[base_index]);
        } else {
            object_finalize_fields(robj);
        }
        cold_require_parser_object_canonical_mirror_exact(
            parser->symbols, robj);
        parser->pos = line_end;
        return;
    }
    /* Allow inline paren (field: Type, ...) for generic objects.
       Skip the complex early-return check for parenthesized RHS. */
    bool is_paren_rhs = rhs_check.len > 0 && rhs_check.ptr[0] == '(';
    if (!is_paren_rhs &&
        cold_span_find_top_level_char(rhs_check, ':') < 0 &&
        cold_span_find_top_level_char(rhs_check, '|') < 0 &&
        cold_span_find_top_level_char(rhs_check, '(') < 0 &&
        !span_eq(rhs_header_first, "object") &&
        !span_eq(rhs_header_first, "of") &&
        !cold_span_starts_with(rhs_check, "tuple")) {
        Span scoped_alias =
            parser_scope_type(parser, rhs_check);
        TypeDef *type = symbols_add_type_at_origin(
            parser->symbols, type_name, 0,
            declaration_module_source_row,
            declaration_token_byte_offset);
        symbols_set_type_generic_names(
            parser->symbols, type, generic_names,
            generic_count);
        symbols_set_type_alias(type, scoped_alias);
        parser->pos = line_end;
        return;
    }
    int32_t paren_find = cold_span_find_top_level_char(rhs_check, '|');
    bool is_inline_paren = rhs_check.len > 2 && rhs_check.ptr[0] == '(' &&
                           rhs_check.ptr[rhs_check.len - 1] == ')' &&
                           paren_find < 0;
    bool is_tuple_inline = cold_span_starts_with(rhs_check, "tuple[");
    bool explicit_object = span_eq(rhs_header_first, "object");
    bool implicit_inheritance = span_eq(rhs_header_first, "of");
    Span rhs_source =
        span_sub(line.source, line.pos,
                 line.source.len);
    bool implicit_object =
        cold_type_block_looks_like_object(rhs_source) ||
        implicit_inheritance;
    if (implicit_object || explicit_object ||
        is_tuple_inline || is_inline_paren) {
        Span raw_base_type = {0};
        bool has_base = false;
        if (explicit_object || implicit_inheritance) {
            has_base = cold_object_header_base_type(
                parser,
                rhs_header,
                false,
                implicit_inheritance,
                &raw_base_type);
            if (implicit_inheritance && !has_base)
                die("implicit object inheritance base type missing");
        }
        int32_t base_index = has_base ?
            cold_object_base_resolve_exact(parser, raw_base_type) : -1;
        int32_t inherited_field_count = base_index >= 0 ?
            parser->symbols->objects[base_index].field_count : 0;
        int32_t field_count = 0;
        Span field_names[COLD_MAX_OBJECT_FIELDS];
        Span field_types[COLD_MAX_OBJECT_FIELDS];
        bool field_has_defaults[COLD_MAX_OBJECT_FIELDS];
        Span field_defaults[COLD_MAX_OBJECT_FIELDS];
        Span fields_span = {0};
        if (is_inline_paren) {
            Span inner = span_trim(span_sub(rhs_check, 1, rhs_check.len - 1));
            fields_span = inner;
        } else if (is_tuple_inline) {
            Span inner = span_trim(span_sub(rhs_check, 6, rhs_check.len));
            if (inner.len > 0 && inner.ptr[inner.len - 1] == ']')
                inner = span_sub(inner, 0, inner.len - 1);
            fields_span = inner;
        } else {
            int32_t body_start = line.pos;
            while (body_start < line_end && line.source.ptr[body_start] != '\n') body_start++;
            if (body_start < line_end) body_start++;
            int32_t body_indent = -1;
            int32_t body_finish = body_start;
            while (body_finish < line_end) {
                int32_t indent = 0;
                int32_t p = body_finish;
                while (p < line_end && line.source.ptr[p] == ' ') { indent++; p++; }
                if (p >= line_end || line.source.ptr[p] == '\n') { body_finish++; continue; }
                if (body_indent < 0) body_indent = indent;
                if (indent < body_indent || indent == 0) break;
                while (body_finish < line_end && line.source.ptr[body_finish] != '\n') body_finish++;
                if (body_finish < line_end) body_finish++;
            }
            fields_span =
                span_sub(line.source,
                         body_start, body_finish);
        }
        if (fields_span.len <= 0 && implicit_object) {
            fields_span = rhs_check;
        }
        int32_t fp_pos = 0;
        for (;;) {
            Span trimmed = {0};
            if (is_tuple_inline || is_inline_paren) {
                if (fp_pos >= fields_span.len)
                    break;
                int32_t ln_start = fp_pos;
                int32_t bracket_depth = 0;
                while (fp_pos < fields_span.len) {
                    uint8_t ch = fields_span.ptr[fp_pos];
                    if (ch == '[' || ch == '(' || ch == '{') bracket_depth++;
                    if (ch == ']' || ch == ')' || ch == '}') bracket_depth--;
                    if (bracket_depth == 0 && (ch == ',' || ch == ';')) break;
                    fp_pos++;
                }
                trimmed = span_trim(
                    span_sub(fields_span,
                             ln_start, fp_pos));
                if (fp_pos < fields_span.len)
                    fp_pos++;
            } else {
                int32_t field_status =
                    cold_object_field_statement_next(
                        fields_span, &fp_pos,
                        &trimmed);
                if (field_status == 0) break;
                if (field_status < 0)
                    die("malformed object field statement");
            }
            if (trimmed.len <= 0) continue;
            if (cold_line_is_comment_only(trimmed)) continue;
            if (field_count >= COLD_MAX_OBJECT_FIELDS) die("too many object fields");
            Parser fp = parser_child(parser, trimmed);
            Span field_name = parser_token(&fp);
            if (field_name.len <= 0) return; /* skip empty field name */
            if (!parser_take(&fp, ":")) die("expected : in object field");
            Span field_type = parser_take_type_span(&fp);
            if (field_type.len <= 0) die("expected object field type");
            if (cold_type_contains_sabi_boundary(field_type)) {
                fprintf(stderr, "ZRPC/SABI violation: ");
                cold_error_loc(parser, field_type);
                fprintf(stderr,
                        ": SABI boundary type `%.*s` cannot be used as an object field.\n",
                        (int)field_type.len, field_type.ptr);
                ColdErrorRecoveryEnabled = false;
                die("ZRPC/SABI violation");
            }
            bool has_default = false;
            Span default_expr = {0};
            if (span_eq(parser_peek(&fp), "=")) {
                (void)parser_token(&fp);
                default_expr = span_trim(span_sub(trimmed, fp.pos, trimmed.len));
                if (default_expr.len <= 0) die("expected object field default expression");
                has_default = true;
                fp.pos = fp.source.len;
            }
            if (parser_peek(&fp).len != 0)
                die("object field has trailing tokens");
            field_names[field_count] = field_name;
            field_types[field_count] = field_type;
            field_has_defaults[field_count] = has_default;
            field_defaults[field_count] = default_expr;
            field_count++;
        }
        int32_t total_field_count =
            inherited_field_count + field_count;
        ObjectDef *existing =
            symbols_find_object(parser->symbols, type_name);
        if (existing &&
            (existing->field_count != total_field_count ||
             existing->is_ref ||
             existing->base_object_index != base_index ||
             existing->inherited_field_count !=
                 inherited_field_count)) {
            die("object inheritance schema drift");
        }
        ObjectDef *object = symbols_add_object_at_origin(
            parser->symbols, type_name, total_field_count,
            declaration_module_source_row,
            declaration_token_byte_offset);
        int32_t object_index =
            symbols_object_index(parser->symbols, object);
        if (object_index < 0)
            die("object declaration row missing");
        if (base_index >= 0)
            object_materialize_inherited_prefix(
                parser->symbols, object, base_index);
        symbols_set_object_generic_names(
            parser->symbols, object, generic_names,
            generic_count);
        for (int32_t fi = 0; fi < field_count; fi++) {
            int32_t dst_index = inherited_field_count + fi;
            object = &parser->symbols->objects[object_index];
            for (int32_t previous = 0;
                 previous < dst_index; previous++) {
                if (span_same(
                        object->fields[previous].name,
                        field_names[fi])) {
                    fprintf(
                        stderr,
                        "cheng_cold: inherited field collision "
                        "source=%s object=%.*s field=%.*s "
                        "previous_index=%d inherited_count=%d "
                        "local_field_index=%d\n",
                        parser->source_path
                            ? parser->source_path
                            : "<unknown>",
                        type_name.len, type_name.ptr,
                        field_names[fi].len,
                        field_names[fi].ptr,
                        previous, inherited_field_count, fi);
                    die("derived object field shadows inherited field");
                }
            }
            bool generic_field =
                cold_type_is_direct_generic_placeholder(
                    field_types[fi],
                    generic_names,
                    generic_count);
            int32_t fk =
                generic_field
                    ? SLOT_I32
                    : cold_parser_slot_kind_from_type_in_generic_scope(
                          parser->symbols, field_types[fi],
                          generic_names, generic_count,
                          generic_count > 0
                              ? COLD_GENERIC_BINDER_OBJECT_ROW
                              : COLD_GENERIC_BINDER_NONE,
                          generic_count > 0
                              ? object_index : -1);
            if (fk == SLOT_VARIANT && !symbols_resolve_type(parser->symbols, field_types[fi])) {
                fk = SLOT_I32;
            }
            /* #44 root fix: named `type X = \n field: T` object/struct field
               byte layout must use the byte-precise payload sizer, mirroring
               the anon-tuple (cold_ensure_anon_tuple_object) and enum-variant
               (symbols_resolve_type / cold_csg_add_variant) field-size paths,
               which already call cold_payload_size_from_type_with_symbols and
               so already size int8/uint8/int16/uint16 fields correctly at
               1/2 bytes. This third sibling path used the generic
               register-slot sizer instead (cold_parser_slot_size_from_type ->
               cold_slot_size_from_type_with_symbols), which collapses every
               SLOT_I32-classified scalar (bool/int8/uint8/int16/uint16/int32)
               to a uniform 4-byte slot width. For a struct embedding two
               uint16 fields ahead of an 8-byte-aligned field (DarwinStat:
               st_mode/st_nlink before st_ino), the +2/+2 byte widening plus
               the resulting 8-byte alignment round-up compounds to a fixed
               +8 offset for every field from st_ino onward, incl. st_size
               (#44: `st.st_size` read back what should be `st_blocks`'s
               value) -- not a defect in embedded-struct-field handling
               itself (InnerTs/DarwinTimespec-typed fields size and align
               correctly; verified via ptr(&o.field) offset probes with a
               local repro, cross-checked field-by-field against hand-derived
               natural-C-alignment offsets for the exact DarwinStat field
               list). Local (register) slot sizing for scalars intentionally
               keeps the generic width (frame slots are word-sized regardless
               of declared type, mirroring cold_param_size_from_type's
               documented bool-param precedent) -- do not widen this fix to
               cold_parser_slot_size_from_type's other (non-struct-field)
               call sites. */
            int32_t field_size = generic_field ? 4 :
                cold_payload_size_from_type_in_generic_scope(
                    parser->symbols, field_types[fi], fk,
                    generic_names, generic_count,
                    generic_count > 0
                        ? COLD_GENERIC_BINDER_OBJECT_ROW
                        : COLD_GENERIC_BINDER_NONE,
                    generic_count > 0
                        ? object_index : -1);
            int32_t array_len = 0;
            if (fk == SLOT_ARRAY_I32 &&
                !cold_parse_fixed_array_type(
                    parser->symbols, field_types[fi], &array_len)) {
                die("object fixed array identity is unresolved");
            }
            object = &parser->symbols->objects[object_index];
            object->fields[dst_index].name = field_names[fi];
            object->fields[dst_index].kind = fk;
            object->fields[dst_index].size = field_size;
            object->fields[dst_index].type_name = field_types[fi];
            object->fields[dst_index].array_len = array_len;
            object->fields[dst_index].has_default =
                field_has_defaults[fi];
            object->fields[dst_index].default_expr =
                field_defaults[fi];
        }
        object = &parser->symbols->objects[object_index];
        if (base_index >= 0) {
            object_finalize_fields_with_base(
                object, &parser->symbols->objects[base_index]);
        } else {
            object_finalize_fields(object);
        }
        cold_require_parser_object_canonical_mirror_exact(
            parser->symbols, object);
        parser->pos = line_end;
        return;
    }

    int32_t saved = line.pos;
    int32_t variant_count = 0;
    if (span_eq(parser_peek(&line), "|")) {
        parser->pos = line_end;
        die("leading | in algebraic type is invalid");
    }
    while (line.pos < line.source.len) {
        Span token = parser_token(&line);
        if (token.len == 0) break;
        if (span_eq(token, "|")) continue;
        variant_count++;
        if (span_eq(parser_peek(&line), "(")) parser_skip_balanced(&line, "(", ")");
    }
    if (variant_count <= 0) die("type has no variants");

    line.pos = saved;
    TypeDef *type = symbols_add_type_at_origin(
        parser->symbols, type_name, variant_count,
        declaration_module_source_row,
        declaration_token_byte_offset);
    int32_t type_row =
        (int32_t)(type - parser->symbols->types);
    if (type_row < 0 ||
        type_row >= parser->symbols->type_count) {
        die("algebraic type declaration row is invalid");
    }
    symbols_set_type_generic_names(
        parser->symbols, type, generic_names,
        generic_count);
    for (int32_t vi = 0; vi < variant_count; vi++) {
        if (vi > 0 && !parser_take(&line, "|")) {
            Span actual = parser_peek(&line);
            fprintf(
                stderr,
                "cheng_cold: algebraic variant separator drift "
                "source=%s type=%.*s variant_index=%d "
                "variant_count=%d next=%.*s rhs=%.*s\n",
                parser->source_path
                    ? parser->source_path
                    : "<unknown>",
                type_name.len, type_name.ptr,
                vi, variant_count,
                actual.len, actual.ptr
                    ? actual.ptr : (const uint8_t *)"",
                rhs_check.len, rhs_check.ptr
                    ? rhs_check.ptr : (const uint8_t *)"");
            parser->pos = line_end;
            die("malformed algebraic type variant separator");
        }
        Span variant_name = parser_token(&line);
        if (span_eq(variant_name, "|")) {
            parser->pos = line_end;
            die("leading | in algebraic type is invalid");
        }
        int32_t field_count = 0;
        int32_t field_kinds[COLD_MAX_VARIANT_FIELDS];
        int32_t field_sizes[COLD_MAX_VARIANT_FIELDS];
        Span field_types[COLD_MAX_VARIANT_FIELDS];
        if (span_eq(parser_peek(&line), "(")) {
            parser_take(&line, "(");
            while (!span_eq(parser_peek(&line), ")")) {
                if (field_count >= COLD_MAX_VARIANT_FIELDS) die("too many variant fields");
                Span field = parser_token(&line);
                if (field.len == 0) die("unterminated variant fields");
                if (!parser_take(&line, ":")) die("expected : in variant field");
                Span field_type = parser_take_type_span(&line);
                if (field_type.len <= 0) die("expected variant field type");
                if (cold_type_contains_sabi_boundary(field_type)) {
                    fprintf(stderr, "ZRPC/SABI violation: ");
                    cold_error_loc(parser, field_type);
                    fprintf(stderr,
                            ": SABI boundary type `%.*s` cannot be used as a variant field.\n",
                            (int)field_type.len, field_type.ptr);
                    ColdErrorRecoveryEnabled = false;
                    die("ZRPC/SABI violation");
                }
                bool is_generic_field = false;
                for (int32_t gi = 0; gi < generic_count; gi++) {
                    if (span_same(field_type, generic_names[gi])) is_generic_field = true;
                }
                if (is_generic_field) {
                    field_kinds[field_count] = SLOT_I32;
                    field_sizes[field_count] = 4;
                    field_types[field_count] = field_type;
                    field_count++;
                } else {
                    int32_t fk =
                        cold_parser_slot_kind_from_type_in_generic_scope(
                            parser->symbols, field_type,
                            generic_names, generic_count,
                            generic_count > 0
                                ? COLD_GENERIC_BINDER_TYPE_ROW
                                : COLD_GENERIC_BINDER_NONE,
                            generic_count > 0
                                ? type_row : -1);
                    field_kinds[field_count] = fk;
                    field_sizes[field_count] =
                        cold_payload_size_from_type_in_generic_scope(
                            parser->symbols, field_type, fk,
                            generic_names, generic_count,
                            generic_count > 0
                                ? COLD_GENERIC_BINDER_TYPE_ROW
                                : COLD_GENERIC_BINDER_NONE,
                            generic_count > 0
                                ? type_row : -1);
                    field_types[field_count] = field_type;
                    field_count++;
                }
                if (span_eq(parser_peek(&line), ",")) (void)parser_token(&line);
            }
            parser_take(&line, ")");
        }
        type = &parser->symbols->types[type_row];
        Variant *variant = &type->variants[vi];
        variant->name = cold_arena_span_copy(parser->arena, variant_name);
        variant->tag = vi;
        cold_variant_fields_allocate(
            parser->symbols, variant, field_count);
        for (int32_t i = 0; i < field_count; i++) {
            variant->field_kind[i] = field_kinds[i];
            variant->field_size[i] = field_sizes[i];
            variant->field_type[i] = field_types[i];
        }
        variant_finalize_layout(type, variant);
        /* register qualified name as constant: Type.Variant → variant tag */
        int32_t qn_len = type_name.len + 1 + variant->name.len;
        char *qn_ptr = arena_alloc(parser->arena, (size_t)qn_len + 1);
        memcpy(qn_ptr, type_name.ptr, (size_t)type_name.len);
        qn_ptr[type_name.len] = '.';
        memcpy(qn_ptr + type_name.len + 1, variant->name.ptr, (size_t)variant->name.len);
        qn_ptr[qn_len] = '\0';
        Span qn = {(const uint8_t *)qn_ptr, qn_len};
        symbols_add_const(parser->symbols, qn, variant->tag, (Span){0});
    }
    parser->pos = line_end;
    parser_line(parser);
}

Span cold_strip_inline_comment(Span line) {
    bool in_string = false;
    uint8_t quote = 0;
    for (int32_t i = 0; i < line.len; i++) {
        uint8_t c = line.ptr[i];
        if (in_string) {
            if (c == '\\' && i + 1 < line.len) {
                i++;
                continue;
            }
            if (c == quote) in_string = false;
            continue;
        }
        if (c == '"' || c == '\'') {
            in_string = true;
            quote = c;
            continue;
        }
        if (c == '#') return span_trim(span_sub(line, 0, i));
        if (c == '/' && i + 1 < line.len && line.ptr[i + 1] == '/') {
            return span_trim(span_sub(line, 0, i));
        }
    }
    return span_trim(line);
}

static bool cold_const_scalar_type_from_type(Span type, int32_t *kind_out,
                                             int32_t *tag_out) {
    type = span_trim(type);
    int32_t kind = 0;
    int32_t tag = COLD_CONST_SCALAR_NONE;
    if (span_eq(type, "bool")) {
        kind = SLOT_I32;
        tag = COLD_CONST_SCALAR_BOOL;
    } else if (span_eq(type, "int8")) {
        kind = SLOT_I32;
        tag = COLD_CONST_SCALAR_I8;
    } else if (span_eq(type, "uint8")) {
        kind = SLOT_I32;
        tag = COLD_CONST_SCALAR_U8;
    } else if (span_eq(type, "int16")) {
        kind = SLOT_I32;
        tag = COLD_CONST_SCALAR_I16;
    } else if (span_eq(type, "uint16")) {
        kind = SLOT_I32;
        tag = COLD_CONST_SCALAR_U16;
    } else if (span_eq(type, "int32") || span_eq(type, "int")) {
        kind = SLOT_I32;
        tag = COLD_CONST_SCALAR_I32;
    } else if (span_eq(type, "uint32")) {
        kind = SLOT_I32;
        tag = COLD_CONST_SCALAR_U32;
    } else if (span_eq(type, "char")) {
        kind = SLOT_I32;
        tag = COLD_CONST_SCALAR_CHAR;
    } else if (span_eq(type, "int64") || span_eq(type, "Int64")) {
        kind = SLOT_I64;
        tag = COLD_CONST_SCALAR_I64;
    } else if (span_eq(type, "uint64") || span_eq(type, "Uint64") ||
               span_eq(type, "UInt64") || span_eq(type, "uint")) {
        kind = SLOT_I64;
        tag = COLD_CONST_SCALAR_U64;
    } else if (span_eq(type, "float32") || span_eq(type, "Float32")) {
        kind = SLOT_F32;
        tag = COLD_CONST_SCALAR_F32;
    } else if (span_eq(type, "float64") || span_eq(type, "Float64")) {
        kind = SLOT_F64;
        tag = COLD_CONST_SCALAR_F64;
    } else {
        return false;
    }
    if (kind_out) *kind_out = kind;
    if (tag_out) *tag_out = tag;
    return true;
}

bool cold_parse_i32_const_literal(Span text, int32_t *out) {
    text = span_trim(text);
    if (text.len <= 0) return false;
    int32_t pos = 0;
    int32_t sign = 1;
    if (text.ptr[pos] == '-') {
        sign = -1;
        pos++;
    }
    if (pos >= text.len) return false;
    int32_t base = 10;
    if (pos + 1 < text.len && text.ptr[pos] == '0' &&
        (text.ptr[pos + 1] == 'x' || text.ptr[pos + 1] == 'X')) {
        base = 16;
        pos += 2;
        if (pos >= text.len) return false;
    }
    uint64_t value = 0;
    for (; pos < text.len; pos++) {
        uint8_t c = text.ptr[pos];
        int32_t digit = -1;
        if (c >= '0' && c <= '9') digit = (int32_t)(c - '0');
        else if (base == 16 && c >= 'a' && c <= 'f') digit = 10 + (int32_t)(c - 'a');
        else if (base == 16 && c >= 'A' && c <= 'F') digit = 10 + (int32_t)(c - 'A');
        else return false;
        if (digit >= base) return false;
        value = value * (uint64_t)base + (uint64_t)digit;
        if (value > 0xFFFFFFFFull) return false;
    }
    if (sign < 0) {
        if (value > 0x80000000ull) return false;
        *out = value == 0x80000000ull ? (int32_t)0x80000000u : -(int32_t)value;
    } else {
        *out = (int32_t)(uint32_t)value;
    }
    return true;
}

/* Evaluate a constant integer expression supporting * / + - over int32
 * literals and previously-registered i32 consts. Lowest-precedence (+ -)
 * split first at top level, then (* /), then a leaf is parsed as a literal
 * or resolved through symbols_find_const. Returns false if any leaf is
 * neither a literal nor a known const (let-it-crash at call site, no 0
 * fallback that would silently miscompile). */
bool cold_eval_i32_const_expr(Symbols *symbols, Span text, int32_t *out) {
    text = span_trim(text);
    if (text.len <= 0) return false;
    /* strip one layer of surrounding parens */
    while (text.len >= 2 && text.ptr[0] == '(' && text.ptr[text.len - 1] == ')') {
        Span inner = span_trim(span_sub(text, 1, text.len - 1));
        /* only strip if the matching close is the final char (balanced) */
        int32_t depth = 0;
        bool balanced = true;
        for (int32_t i = 0; i < text.len; i++) {
            if (text.ptr[i] == '(') depth++;
            else if (text.ptr[i] == ')') {
                depth--;
                if (depth == 0 && i != text.len - 1) { balanced = false; break; }
            }
        }
        if (!balanced) break;
        text = inner;
        if (text.len <= 0) return false;
    }
    /* top-level + / - (lowest precedence). Scan right-to-left for left-assoc;
     * skip a leading sign at pos 0. */
    int32_t depth = 0;
    for (int32_t i = text.len - 1; i >= 1; i--) {
        char c = text.ptr[i];
        if (c == ')') depth++;
        else if (c == '(') depth--;
        else if (depth == 0 && (c == '+' || c == '-')) {
            /* not a sign: previous non-space char must not itself be an operator */
            int32_t p = i - 1;
            while (p >= 0 && (text.ptr[p] == ' ' || text.ptr[p] == '\t')) p--;
            if (p < 0) continue;
            char pc = text.ptr[p];
            if (pc == '+' || pc == '-' || pc == '*' || pc == '/') continue;
            int32_t lv = 0, rv = 0;
            if (!cold_eval_i32_const_expr(symbols, span_sub(text, 0, i), &lv)) return false;
            if (!cold_eval_i32_const_expr(symbols, span_sub(text, i + 1, text.len), &rv)) return false;
            *out = (c == '+') ? (lv + rv) : (lv - rv);
            return true;
        }
    }
    /* top-level * / (higher precedence) */
    depth = 0;
    for (int32_t i = text.len - 1; i >= 1; i--) {
        char c = text.ptr[i];
        if (c == ')') depth++;
        else if (c == '(') depth--;
        else if (depth == 0 && (c == '*' || c == '/')) {
            int32_t lv = 0, rv = 0;
            if (!cold_eval_i32_const_expr(symbols, span_sub(text, 0, i), &lv)) return false;
            if (!cold_eval_i32_const_expr(symbols, span_sub(text, i + 1, text.len), &rv)) return false;
            if (c == '/') {
                if (rv == 0) return false;
                *out = lv / rv;
            } else {
                *out = lv * rv;
            }
            return true;
        }
    }
    /* leaf: literal or known const name */
    int32_t lit = 0;
    if (cold_parse_i32_const_literal(text, &lit)) {
        *out = lit;
        return true;
    }
    if (symbols && cold_span_is_simple_ident(text)) {
        ConstDef *constant = symbols_find_const(symbols, text);
        if (!constant && ColdConstEvalAlias.len > 0) {
            /* operand stored qualified under the active import alias */
            Span scoped = cold_arena_join3(symbols->arena, ColdConstEvalAlias,
                                           ".", text);
            constant = symbols_find_const(symbols, scoped);
        }
        if (constant) {
            if (!cold_const_i32_value(constant, out)) return false;
            return true;
        }
    }
    return false;
}

static bool cold_parse_integer_const_bits(Span text, uint64_t *bits_out,
                                          bool *fits_i32_out) {
    text = span_trim(text);
    if (text.len <= 0) return false;
    int32_t pos = 0;
    bool negative = false;
    if (text.ptr[pos] == '-') {
        negative = true;
        pos++;
    }
    if (pos >= text.len) return false;
    int32_t base = 10;
    if (pos + 1 < text.len && text.ptr[pos] == '0' &&
        (text.ptr[pos + 1] == 'x' || text.ptr[pos + 1] == 'X')) {
        base = 16;
        pos += 2;
    }
    if (pos >= text.len) return false;
    uint64_t magnitude = 0;
    bool saw_digit = false;
    for (; pos < text.len; pos++) {
        uint8_t c = text.ptr[pos];
        if (c == '_') continue;
        int32_t digit = -1;
        if (c >= '0' && c <= '9') digit = (int32_t)(c - '0');
        else if (base == 16 && c >= 'a' && c <= 'f') digit = 10 + (int32_t)(c - 'a');
        else if (base == 16 && c >= 'A' && c <= 'F') digit = 10 + (int32_t)(c - 'A');
        else return false;
        if (digit >= base) return false;
        saw_digit = true;
        if (magnitude > (UINT64_MAX - (uint64_t)digit) / (uint64_t)base)
            return false;
        magnitude = magnitude * (uint64_t)base + (uint64_t)digit;
    }
    if (!saw_digit) return false;
    if (negative && magnitude > 0x8000000000000000ULL) return false;
    uint64_t bits = negative ? (uint64_t)(0ULL - magnitude) : magnitude;
    bool fits_i32 = negative
        ? magnitude <= 0x80000000ULL
        : magnitude <= 0x7FFFFFFFULL;
    if (base == 16 && !negative && magnitude <= 0xFFFFFFFFULL) fits_i32 = true;
    if (bits_out) *bits_out = bits;
    if (fits_i32_out) *fits_i32_out = fits_i32;
    return true;
}

static ConstDef *cold_find_const_with_alias(Symbols *symbols, Span alias, Span name) {
    ConstDef *constant = symbols_find_const(symbols, name);
    if (!constant && alias.len > 0 && cold_span_find_char(name, '.') < 0) {
        Span scoped = cold_arena_join3(symbols->arena, alias, ".", name);
        constant = symbols_find_const(symbols, scoped);
    }
    return constant;
}

static int32_t cold_scalar_tag_kind(int32_t tag) {
    if (tag == COLD_CONST_SCALAR_F32) return SLOT_F32;
    if (tag == COLD_CONST_SCALAR_F64) return SLOT_F64;
    if (tag == COLD_CONST_SCALAR_I64 || tag == COLD_CONST_SCALAR_U64)
        return SLOT_I64;
    if (tag >= COLD_CONST_SCALAR_BOOL && tag <= COLD_CONST_SCALAR_U32)
        return SLOT_I32;
    if (tag == COLD_CONST_SCALAR_CHAR) return SLOT_I32;
    return 0;
}

static Span cold_scalar_tag_type(int32_t tag) {
    if (tag == COLD_CONST_SCALAR_BOOL) return cold_cstr_span("bool");
    if (tag == COLD_CONST_SCALAR_I8) return cold_cstr_span("int8");
    if (tag == COLD_CONST_SCALAR_U8) return cold_cstr_span("uint8");
    if (tag == COLD_CONST_SCALAR_I16) return cold_cstr_span("int16");
    if (tag == COLD_CONST_SCALAR_U16) return cold_cstr_span("uint16");
    if (tag == COLD_CONST_SCALAR_I32) return cold_cstr_span("int32");
    if (tag == COLD_CONST_SCALAR_U32) return cold_cstr_span("uint32");
    if (tag == COLD_CONST_SCALAR_I64) return cold_cstr_span("int64");
    if (tag == COLD_CONST_SCALAR_U64) return cold_cstr_span("uint64");
    if (tag == COLD_CONST_SCALAR_F32) return cold_cstr_span("float32");
    if (tag == COLD_CONST_SCALAR_F64) return cold_cstr_span("float64");
    if (tag == COLD_CONST_SCALAR_CHAR) return cold_cstr_span("char");
    return (Span){0};
}

static int32_t cold_scalar_tag_width(int32_t tag) {
    if (tag == COLD_CONST_SCALAR_I8 || tag == COLD_CONST_SCALAR_U8) return 8;
    if (tag == COLD_CONST_SCALAR_I16 || tag == COLD_CONST_SCALAR_U16) return 16;
    if (tag == COLD_CONST_SCALAR_I64 || tag == COLD_CONST_SCALAR_U64 ||
        tag == COLD_CONST_SCALAR_F64) return 64;
    return 32;
}

static bool cold_scalar_tag_is_float(int32_t tag) {
    return tag == COLD_CONST_SCALAR_F32 || tag == COLD_CONST_SCALAR_F64;
}

static bool cold_scalar_tag_is_signed(int32_t tag) {
    return tag == COLD_CONST_SCALAR_I8 || tag == COLD_CONST_SCALAR_I16 ||
           tag == COLD_CONST_SCALAR_I32 || tag == COLD_CONST_SCALAR_I64;
}

static bool cold_scalar_tag_is_integer(int32_t tag) {
    return (tag >= COLD_CONST_SCALAR_BOOL && tag <= COLD_CONST_SCALAR_U64) ||
           tag == COLD_CONST_SCALAR_CHAR;
}

static uint64_t cold_scalar_width_mask(int32_t width) {
    return width >= 64 ? UINT64_MAX : ((1ULL << width) - 1ULL);
}

static int64_t cold_scalar_signed_value(int32_t tag, uint64_t bits) {
    int32_t width = cold_scalar_tag_width(tag);
    bits &= cold_scalar_width_mask(width);
    if (width == 64) return (int64_t)bits;
    uint64_t sign = 1ULL << (width - 1);
    return (int64_t)((bits ^ sign) - sign);
}

static bool cold_convert_scalar_const(int32_t source_tag, uint64_t source_bits,
                                      int32_t target_tag, uint64_t *target_bits) {
    if (source_tag == target_tag) {
        *target_bits = source_bits;
        return true;
    }
    if (cold_scalar_tag_is_float(target_tag) &&
        cold_scalar_tag_is_integer(source_tag)) {
        long double numeric = cold_scalar_tag_is_signed(source_tag)
            ? (long double)cold_scalar_signed_value(source_tag, source_bits)
            : (long double)(source_bits &
                            cold_scalar_width_mask(cold_scalar_tag_width(source_tag)));
        if (target_tag == COLD_CONST_SCALAR_F32) {
            float value = (float)numeric;
            uint32_t bits = 0;
            memcpy(&bits, &value, sizeof(bits));
            *target_bits = (uint64_t)bits;
        } else {
            double value = (double)numeric;
            uint64_t bits = 0;
            memcpy(&bits, &value, sizeof(bits));
            *target_bits = bits;
        }
        return true;
    }
    if (cold_scalar_tag_is_float(source_tag) &&
        cold_scalar_tag_is_float(target_tag)) {
        if (source_tag == COLD_CONST_SCALAR_F32) {
            uint32_t raw = (uint32_t)source_bits;
            float source = 0.0f;
            memcpy(&source, &raw, sizeof(source));
            double target = (double)source;
            memcpy(target_bits, &target, sizeof(target));
        } else {
            double source = 0.0;
            memcpy(&source, &source_bits, sizeof(source));
            float target = (float)source;
            uint32_t raw = 0;
            memcpy(&raw, &target, sizeof(raw));
            *target_bits = (uint64_t)raw;
        }
        return true;
    }
    if (cold_scalar_tag_is_integer(source_tag) &&
        cold_scalar_tag_is_integer(target_tag)) {
        int32_t target_width = cold_scalar_tag_width(target_tag);
        uint64_t target_mask = cold_scalar_width_mask(target_width);
        if (target_tag == COLD_CONST_SCALAR_BOOL) {
            uint64_t numeric = source_bits &
                cold_scalar_width_mask(cold_scalar_tag_width(source_tag));
            if (numeric > 1) return false;
            *target_bits = numeric;
            return true;
        }
        if (cold_scalar_tag_is_signed(source_tag)) {
            int64_t numeric = cold_scalar_signed_value(source_tag, source_bits);
            if (cold_scalar_tag_is_signed(target_tag)) {
                int64_t minimum = target_width == 64
                    ? INT64_MIN : -(1LL << (target_width - 1));
                int64_t maximum = target_width == 64
                    ? INT64_MAX : ((1LL << (target_width - 1)) - 1);
                if (numeric < minimum || numeric > maximum) return false;
            } else {
                /* Full-width unsigned target (uint64): every 64-bit signed
                   bit pattern is exactly representable as unsigned -- there
                   is no out-of-range value at this width, so a negative
                   `numeric` (e.g. a hex literal like 0xFFFFFFFFFFFFFFFF that
                   auto-tagged as i64) is a bit-pattern reinterpretation, not
                   a value-domain violation. Narrower unsigned targets keep
                   the strict negative/overflow rejection. */
                if (target_width < 64 &&
                    (numeric < 0 || (uint64_t)numeric > target_mask)) return false;
            }
            *target_bits = (uint64_t)numeric & target_mask;
            return true;
        }
        uint64_t numeric = source_bits &
            cold_scalar_width_mask(cold_scalar_tag_width(source_tag));
        if (cold_scalar_tag_is_signed(target_tag)) {
            uint64_t maximum = target_width == 64
                ? (uint64_t)INT64_MAX : ((1ULL << (target_width - 1)) - 1ULL);
            if (numeric > maximum) {
                if (cold_scalar_tag_width(source_tag) != target_width)
                    return false;
            }
        } else if (numeric > target_mask) {
            return false;
        }
        *target_bits = numeric & target_mask;
        return true;
    }
    return false;
}

typedef enum ColdConstTokenKind {
    COLD_CT_END = 0,
    COLD_CT_INTEGER,
    COLD_CT_IDENT,
    COLD_CT_CHAR,
    COLD_CT_LPAREN,
    COLD_CT_RPAREN,
    COLD_CT_QUESTION,
    COLD_CT_COLON,
    COLD_CT_PLUS,
    COLD_CT_MINUS,
    COLD_CT_STAR,
    COLD_CT_SLASH,
    COLD_CT_PERCENT,
    COLD_CT_SHL,
    COLD_CT_SHR,
    COLD_CT_LT,
    COLD_CT_LE,
    COLD_CT_GT,
    COLD_CT_GE,
    COLD_CT_EQ,
    COLD_CT_NE,
    COLD_CT_BIT_AND,
    COLD_CT_BIT_XOR,
    COLD_CT_BIT_OR,
    COLD_CT_LOGICAL_AND,
    COLD_CT_LOGICAL_OR,
    COLD_CT_NOT,
    COLD_CT_BIT_NOT,
    COLD_CT_INVALID
} ColdConstTokenKind;

typedef struct ColdConstToken {
    int32_t kind;
    Span text;
} ColdConstToken;

typedef struct ColdConstExprParser {
    Span source;
    int32_t pos;
    ColdConstToken token;
    Symbols *symbols;
    Span alias;
} ColdConstExprParser;

typedef struct ColdConstScalarValue {
    int32_t tag;
    uint64_t bits;
} ColdConstScalarValue;

static void cold_const_expr_next(ColdConstExprParser *parser) {
    while (parser->pos < parser->source.len &&
           (parser->source.ptr[parser->pos] == ' ' ||
            parser->source.ptr[parser->pos] == '\t')) {
        parser->pos++;
    }
    int32_t start = parser->pos;
    if (start >= parser->source.len) {
        parser->token = (ColdConstToken){COLD_CT_END, (Span){0}};
        return;
    }
    uint8_t c = parser->source.ptr[parser->pos++];
    if (c >= '0' && c <= '9') {
        while (parser->pos < parser->source.len) {
            uint8_t d = parser->source.ptr[parser->pos];
            if ((d >= '0' && d <= '9') || (d >= 'a' && d <= 'f') ||
                (d >= 'A' && d <= 'F') || d == 'x' || d == 'X' || d == '_') {
                parser->pos++;
            } else {
                break;
            }
        }
        parser->token = (ColdConstToken){
            COLD_CT_INTEGER, span_sub(parser->source, start, parser->pos)};
        return;
    }
    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_') {
        while (parser->pos < parser->source.len) {
            uint8_t d = parser->source.ptr[parser->pos];
            if ((d >= 'A' && d <= 'Z') || (d >= 'a' && d <= 'z') ||
                (d >= '0' && d <= '9') || d == '_' || d == '.') {
                parser->pos++;
            } else {
                break;
            }
        }
        parser->token = (ColdConstToken){
            COLD_CT_IDENT, span_sub(parser->source, start, parser->pos)};
        return;
    }
    if (c == '\'') {
        bool escaped = false;
        while (parser->pos < parser->source.len) {
            uint8_t d = parser->source.ptr[parser->pos++];
            if (escaped) {
                escaped = false;
                continue;
            }
            if (d == '\\') {
                escaped = true;
                continue;
            }
            if (d == '\'') break;
        }
        if (parser->source.ptr[parser->pos - 1] != '\'') {
            parser->token = (ColdConstToken){COLD_CT_INVALID, (Span){0}};
            return;
        }
        parser->token = (ColdConstToken){
            COLD_CT_CHAR, span_sub(parser->source, start, parser->pos)};
        return;
    }
    int32_t kind = COLD_CT_INVALID;
    uint8_t next = parser->pos < parser->source.len
        ? parser->source.ptr[parser->pos] : 0;
    if (c == '<' && next == '<') { kind = COLD_CT_SHL; parser->pos++; }
    else if (c == '>' && next == '>') { kind = COLD_CT_SHR; parser->pos++; }
    else if (c == '<' && next == '=') { kind = COLD_CT_LE; parser->pos++; }
    else if (c == '>' && next == '=') { kind = COLD_CT_GE; parser->pos++; }
    else if (c == '=' && next == '=') { kind = COLD_CT_EQ; parser->pos++; }
    else if (c == '!' && next == '=') { kind = COLD_CT_NE; parser->pos++; }
    else if (c == '&' && next == '&') { kind = COLD_CT_LOGICAL_AND; parser->pos++; }
    else if (c == '|' && next == '|') { kind = COLD_CT_LOGICAL_OR; parser->pos++; }
    else if (c == '(') kind = COLD_CT_LPAREN;
    else if (c == ')') kind = COLD_CT_RPAREN;
    else if (c == '?') kind = COLD_CT_QUESTION;
    else if (c == ':') kind = COLD_CT_COLON;
    else if (c == '+') kind = COLD_CT_PLUS;
    else if (c == '-') kind = COLD_CT_MINUS;
    else if (c == '*') kind = COLD_CT_STAR;
    else if (c == '/') kind = COLD_CT_SLASH;
    else if (c == '%') kind = COLD_CT_PERCENT;
    else if (c == '<') kind = COLD_CT_LT;
    else if (c == '>') kind = COLD_CT_GT;
    else if (c == '&') kind = COLD_CT_BIT_AND;
    else if (c == '^') kind = COLD_CT_BIT_XOR;
    else if (c == '|') kind = COLD_CT_BIT_OR;
    else if (c == '!') kind = COLD_CT_NOT;
    else if (c == '~') kind = COLD_CT_BIT_NOT;
    parser->token = (ColdConstToken){
        kind, span_sub(parser->source, start, parser->pos)};
}

static int32_t cold_const_binary_precedence(int32_t kind) {
    if (kind == COLD_CT_LOGICAL_OR) return 20;
    if (kind == COLD_CT_LOGICAL_AND) return 30;
    if (kind == COLD_CT_BIT_OR) return 40;
    if (kind == COLD_CT_BIT_XOR) return 45;
    if (kind == COLD_CT_BIT_AND) return 50;
    if (kind == COLD_CT_EQ || kind == COLD_CT_NE) return 60;
    if (kind == COLD_CT_LT || kind == COLD_CT_LE ||
        kind == COLD_CT_GT || kind == COLD_CT_GE) return 65;
    if (kind == COLD_CT_SHL || kind == COLD_CT_SHR) return 77;
    if (kind == COLD_CT_PLUS || kind == COLD_CT_MINUS) return 80;
    if (kind == COLD_CT_STAR || kind == COLD_CT_SLASH ||
        kind == COLD_CT_PERCENT) return 90;
    return 0;
}

static int32_t cold_const_common_integer_tag(int32_t left, int32_t right) {
    int32_t width = cold_scalar_tag_width(left);
    int32_t right_width = cold_scalar_tag_width(right);
    if (right_width > width) width = right_width;
    bool unsigned_value = !cold_scalar_tag_is_signed(left) ||
                          !cold_scalar_tag_is_signed(right);
    if (width > 32)
        return unsigned_value ? COLD_CONST_SCALAR_U64 : COLD_CONST_SCALAR_I64;
    return unsigned_value ? COLD_CONST_SCALAR_U32 : COLD_CONST_SCALAR_I32;
}

static bool cold_const_value_as_tag(ColdConstScalarValue value, int32_t tag,
                                    ColdConstScalarValue *out) {
    uint64_t bits = 0;
    if (!cold_convert_scalar_const(value.tag, value.bits, tag, &bits))
        return false;
    *out = (ColdConstScalarValue){tag, bits};
    return true;
}

static bool cold_const_signed_result_fits(int32_t tag, int64_t value) {
    int32_t width = cold_scalar_tag_width(tag);
    if (width >= 64) return true;
    int64_t minimum = -(1LL << (width - 1));
    int64_t maximum = (1LL << (width - 1)) - 1;
    return value >= minimum && value <= maximum;
}

static bool cold_const_apply_binary(int32_t op, ColdConstScalarValue left,
                                    ColdConstScalarValue right,
                                    ColdConstScalarValue *out) {
    if (!cold_scalar_tag_is_integer(left.tag) ||
        !cold_scalar_tag_is_integer(right.tag)) return false;
    if (op == COLD_CT_LOGICAL_AND || op == COLD_CT_LOGICAL_OR) {
        bool lv = (left.bits & cold_scalar_width_mask(
            cold_scalar_tag_width(left.tag))) != 0;
        bool rv = (right.bits & cold_scalar_width_mask(
            cold_scalar_tag_width(right.tag))) != 0;
        out->tag = COLD_CONST_SCALAR_BOOL;
        out->bits = op == COLD_CT_LOGICAL_AND ? (lv && rv) : (lv || rv);
        return true;
    }
    if (op == COLD_CT_SHL || op == COLD_CT_SHR) {
        int32_t width = cold_scalar_tag_width(left.tag);
        uint64_t mask = cold_scalar_width_mask(width);
        uint32_t shift = (uint32_t)(right.bits & (uint64_t)(width - 1));
        uint64_t bits = left.bits & mask;
        if (op == COLD_CT_SHL) {
            bits = (bits << shift) & mask;
        } else if (cold_scalar_tag_is_signed(left.tag) && shift > 0 &&
                   (bits & (1ULL << (width - 1))) != 0) {
            uint64_t fill = mask ^ (mask >> shift);
            bits = (bits >> shift) | fill;
        } else {
            bits >>= shift;
        }
        *out = (ColdConstScalarValue){left.tag, bits};
        return true;
    }
    int32_t common_tag = cold_const_common_integer_tag(left.tag, right.tag);
    ColdConstScalarValue lv = {0}, rv = {0};
    if (!cold_const_value_as_tag(left, common_tag, &lv) ||
        !cold_const_value_as_tag(right, common_tag, &rv)) return false;
    int32_t width = cold_scalar_tag_width(common_tag);
    uint64_t mask = cold_scalar_width_mask(width);
    if (op == COLD_CT_EQ || op == COLD_CT_NE || op == COLD_CT_LT ||
        op == COLD_CT_LE || op == COLD_CT_GT || op == COLD_CT_GE) {
        bool result = false;
        if (cold_scalar_tag_is_signed(common_tag)) {
            int64_t a = cold_scalar_signed_value(common_tag, lv.bits);
            int64_t b = cold_scalar_signed_value(common_tag, rv.bits);
            if (op == COLD_CT_EQ) result = a == b;
            else if (op == COLD_CT_NE) result = a != b;
            else if (op == COLD_CT_LT) result = a < b;
            else if (op == COLD_CT_LE) result = a <= b;
            else if (op == COLD_CT_GT) result = a > b;
            else result = a >= b;
        } else {
            uint64_t a = lv.bits & mask;
            uint64_t b = rv.bits & mask;
            if (op == COLD_CT_EQ) result = a == b;
            else if (op == COLD_CT_NE) result = a != b;
            else if (op == COLD_CT_LT) result = a < b;
            else if (op == COLD_CT_LE) result = a <= b;
            else if (op == COLD_CT_GT) result = a > b;
            else result = a >= b;
        }
        *out = (ColdConstScalarValue){COLD_CONST_SCALAR_BOOL, result ? 1 : 0};
        return true;
    }
    if (op == COLD_CT_BIT_AND || op == COLD_CT_BIT_XOR ||
        op == COLD_CT_BIT_OR) {
        uint64_t bits = op == COLD_CT_BIT_AND ? (lv.bits & rv.bits)
            : op == COLD_CT_BIT_XOR ? (lv.bits ^ rv.bits)
            : (lv.bits | rv.bits);
        *out = (ColdConstScalarValue){common_tag, bits & mask};
        return true;
    }
    if (cold_scalar_tag_is_signed(common_tag)) {
        int64_t a = cold_scalar_signed_value(common_tag, lv.bits);
        int64_t b = cold_scalar_signed_value(common_tag, rv.bits);
        int64_t result = 0;
        bool overflow = false;
        if (op == COLD_CT_PLUS) overflow = __builtin_add_overflow(a, b, &result);
        else if (op == COLD_CT_MINUS) overflow = __builtin_sub_overflow(a, b, &result);
        else if (op == COLD_CT_STAR) overflow = __builtin_mul_overflow(a, b, &result);
        else if (op == COLD_CT_SLASH || op == COLD_CT_PERCENT) {
            if (b == 0 || (a == INT64_MIN && b == -1)) return false;
            result = op == COLD_CT_SLASH ? a / b : a % b;
        } else return false;
        if (overflow || !cold_const_signed_result_fits(common_tag, result))
            return false;
        *out = (ColdConstScalarValue){common_tag, (uint64_t)result & mask};
        return true;
    }
    uint64_t a = lv.bits & mask;
    uint64_t b = rv.bits & mask;
    uint64_t result = 0;
    bool overflow = false;
    if (op == COLD_CT_PLUS) overflow = __builtin_add_overflow(a, b, &result);
    else if (op == COLD_CT_MINUS) {
        if (a < b) return false;
        result = a - b;
    } else if (op == COLD_CT_STAR) overflow = __builtin_mul_overflow(a, b, &result);
    else if (op == COLD_CT_SLASH || op == COLD_CT_PERCENT) {
        if (b == 0) return false;
        result = op == COLD_CT_SLASH ? a / b : a % b;
    } else return false;
    if (overflow || result > mask) return false;
    *out = (ColdConstScalarValue){common_tag, result};
    return true;
}

static bool cold_const_parse_expression(ColdConstExprParser *parser,
                                        int32_t minimum_precedence,
                                        ColdConstScalarValue *out);

static bool cold_const_parse_char(Span text, uint64_t *bits_out) {
    if (text.len == 3 && text.ptr[0] == '\'' && text.ptr[2] == '\'') {
        *bits_out = text.ptr[1];
        return true;
    }
    if (text.len == 4 && text.ptr[0] == '\'' && text.ptr[1] == '\\' &&
        text.ptr[3] == '\'') {
        uint8_t escaped = text.ptr[2];
        if (escaped == 'n') *bits_out = '\n';
        else if (escaped == 'r') *bits_out = '\r';
        else if (escaped == 't') *bits_out = '\t';
        else if (escaped == '0') *bits_out = 0;
        else if (escaped == '\\' || escaped == '\'') *bits_out = escaped;
        else return false;
        return true;
    }
    return false;
}

static bool cold_const_parse_prefix(ColdConstExprParser *parser,
                                    ColdConstScalarValue *out) {
    int32_t token_kind = parser->token.kind;
    if (token_kind == COLD_CT_PLUS || token_kind == COLD_CT_MINUS ||
        token_kind == COLD_CT_NOT || token_kind == COLD_CT_BIT_NOT) {
        cold_const_expr_next(parser);
        ColdConstScalarValue value = {0};
        if (!cold_const_parse_prefix(parser, &value) ||
            !cold_scalar_tag_is_integer(value.tag)) return false;
        int32_t width = cold_scalar_tag_width(value.tag);
        uint64_t mask = cold_scalar_width_mask(width);
        if (token_kind == COLD_CT_PLUS) {
            *out = value;
        } else if (token_kind == COLD_CT_NOT) {
            *out = (ColdConstScalarValue){
                COLD_CONST_SCALAR_BOOL, (value.bits & mask) == 0 ? 1 : 0};
        } else if (token_kind == COLD_CT_BIT_NOT) {
            *out = (ColdConstScalarValue){value.tag, (~value.bits) & mask};
        } else {
            int64_t numeric = cold_scalar_tag_is_signed(value.tag)
                ? cold_scalar_signed_value(value.tag, value.bits)
                : (int64_t)(value.bits & mask);
            if (!cold_scalar_tag_is_signed(value.tag)) {
                value.tag = width > 32 ? COLD_CONST_SCALAR_I64
                                       : COLD_CONST_SCALAR_I32;
            }
            if (numeric == INT64_MIN) return false;
            numeric = -numeric;
            if (!cold_const_signed_result_fits(value.tag, numeric)) return false;
            *out = (ColdConstScalarValue){value.tag, (uint64_t)numeric & mask};
        }
        return true;
    }
    if (token_kind == COLD_CT_LPAREN) {
        cold_const_expr_next(parser);
        if (!cold_const_parse_expression(parser, 1, out) ||
            parser->token.kind != COLD_CT_RPAREN) return false;
        cold_const_expr_next(parser);
        return true;
    }
    if (token_kind == COLD_CT_INTEGER) {
        Span literal = parser->token.text;
        uint64_t bits = 0;
        bool fits_i32 = false;
        if (!cold_parse_integer_const_bits(literal, &bits, &fits_i32)) return false;
        bool hexadecimal = literal.len >= 2 && literal.ptr[0] == '0' &&
                           (literal.ptr[1] == 'x' || literal.ptr[1] == 'X');
        int32_t tag = bits <= 0x7FFFFFFFULL ? COLD_CONST_SCALAR_I32
            : hexadecimal && bits <= 0xFFFFFFFFULL ? COLD_CONST_SCALAR_U32
            : bits <= (uint64_t)INT64_MAX ? COLD_CONST_SCALAR_I64
            : COLD_CONST_SCALAR_U64;
        *out = (ColdConstScalarValue){tag, bits};
        cold_const_expr_next(parser);
        return true;
    }
    if (token_kind == COLD_CT_CHAR) {
        uint64_t bits = 0;
        if (!cold_const_parse_char(parser->token.text, &bits)) return false;
        *out = (ColdConstScalarValue){COLD_CONST_SCALAR_CHAR, bits};
        cold_const_expr_next(parser);
        return true;
    }
    if (token_kind != COLD_CT_IDENT) return false;
    Span name = parser->token.text;
    cold_const_expr_next(parser);
    if (span_eq(name, "true") || span_eq(name, "false")) {
        *out = (ColdConstScalarValue){
            COLD_CONST_SCALAR_BOOL, span_eq(name, "true") ? 1 : 0};
        return true;
    }
    if (parser->token.kind == COLD_CT_LPAREN) {
        int32_t cast_kind = 0;
        int32_t cast_tag = COLD_CONST_SCALAR_NONE;
        if (!cold_const_scalar_type_from_type(name, &cast_kind, &cast_tag) ||
            cold_scalar_tag_is_float(cast_tag)) return false;
        cold_const_expr_next(parser);
        ColdConstScalarValue inner = {0};
        if (!cold_const_parse_expression(parser, 1, &inner) ||
            parser->token.kind != COLD_CT_RPAREN ||
            !cold_const_value_as_tag(inner, cast_tag, out)) return false;
        cold_const_expr_next(parser);
        return true;
    }
    ConstDef *constant = cold_find_const_with_alias(
        parser->symbols, parser->alias, name);
    if (!constant || constant->kind == SLOT_STR ||
        cold_scalar_tag_is_float(constant->scalar_tag)) return false;
    int32_t tag = constant->scalar_tag == COLD_CONST_SCALAR_NONE
        ? (constant->kind == SLOT_I64 ? COLD_CONST_SCALAR_I64
                                      : COLD_CONST_SCALAR_I32)
        : constant->scalar_tag;
    *out = (ColdConstScalarValue){tag, constant->scalar_bits};
    return true;
}

static bool cold_const_parse_expression(ColdConstExprParser *parser,
                                        int32_t minimum_precedence,
                                        ColdConstScalarValue *out) {
    ColdConstScalarValue left = {0};
    if (!cold_const_parse_prefix(parser, &left)) return false;
    while (true) {
        int32_t precedence = cold_const_binary_precedence(parser->token.kind);
        if (precedence < minimum_precedence) break;
        int32_t op = parser->token.kind;
        cold_const_expr_next(parser);
        ColdConstScalarValue right = {0};
        if (!cold_const_parse_expression(parser, precedence + 1, &right) ||
            !cold_const_apply_binary(op, left, right, &left)) return false;
    }
    if (minimum_precedence <= 1 && parser->token.kind == COLD_CT_QUESTION) {
        cold_const_expr_next(parser);
        ColdConstScalarValue when_true = {0}, when_false = {0};
        if (!cold_const_parse_expression(parser, 1, &when_true) ||
            parser->token.kind != COLD_CT_COLON) return false;
        cold_const_expr_next(parser);
        if (!cold_const_parse_expression(parser, 1, &when_false)) return false;
        bool condition = (left.bits & cold_scalar_width_mask(
            cold_scalar_tag_width(left.tag))) != 0;
        left = condition ? when_true : when_false;
    }
    *out = left;
    return true;
}

static bool cold_parse_integer_const_expression(Symbols *symbols, Span alias,
                                                Span text, int32_t expected_tag,
                                                int32_t *tag_out,
                                                uint64_t *bits_out) {
    ColdConstExprParser parser = {text, 0, {0}, symbols, alias};
    cold_const_expr_next(&parser);
    ColdConstScalarValue value = {0};
    if (!cold_const_parse_expression(&parser, 1, &value) ||
        parser.token.kind != COLD_CT_END) return false;
    if (expected_tag != COLD_CONST_SCALAR_NONE && value.tag != expected_tag) {
        if (!cold_const_value_as_tag(value, expected_tag, &value)) return false;
    }
    *tag_out = value.tag;
    *bits_out = value.bits;
    return true;
}

static bool cold_parse_scalar_const_value(Symbols *symbols, Span alias,
                                          int32_t expected_tag, Span rhs,
                                          int32_t *tag_out, uint64_t *bits_out) {
    rhs = span_trim(rhs);
    if (rhs.len <= 0) return false;

    int32_t wrapper_open = cold_span_find_char(rhs, '(');
    if (wrapper_open > 0 && rhs.ptr[rhs.len - 1] == ')') {
        Span wrapper = span_trim(span_sub(rhs, 0, wrapper_open));
        int32_t wrapper_kind = 0;
        int32_t wrapper_tag = COLD_CONST_SCALAR_NONE;
        if (cold_const_scalar_type_from_type(wrapper, &wrapper_kind, &wrapper_tag)) {
            Span inner = span_trim(span_sub(rhs, wrapper_open + 1, rhs.len - 1));
            if (!cold_parse_scalar_const_value(symbols, alias, wrapper_tag,
                                               inner, tag_out, bits_out))
                return false;
            if (expected_tag != COLD_CONST_SCALAR_NONE &&
                *tag_out != expected_tag) {
                if (!cold_convert_scalar_const(*tag_out, *bits_out,
                                               expected_tag, bits_out))
                    return false;
                *tag_out = expected_tag;
            }
            return true;
        }
    }

    if (cold_span_is_simple_ident(rhs) || cold_span_find_char(rhs, '.') > 0) {
        ConstDef *constant = cold_find_const_with_alias(symbols, alias, rhs);
        if (constant && constant->kind != SLOT_STR) {
            int32_t result_tag = constant->scalar_tag;
            if (result_tag == COLD_CONST_SCALAR_NONE) {
                if (constant->kind == SLOT_I32) result_tag = COLD_CONST_SCALAR_I32;
                else if (constant->kind == SLOT_I64) result_tag = COLD_CONST_SCALAR_I64;
                else if (constant->kind == SLOT_F32) result_tag = COLD_CONST_SCALAR_F32;
                else if (constant->kind == SLOT_F64) result_tag = COLD_CONST_SCALAR_F64;
            }
            uint64_t result_bits = constant->scalar_bits;
            if (expected_tag != COLD_CONST_SCALAR_NONE &&
                expected_tag != result_tag) {
                if (!cold_convert_scalar_const(result_tag, result_bits,
                                               expected_tag, &result_bits))
                    return false;
                result_tag = expected_tag;
            }
            *tag_out = result_tag;
            *bits_out = result_bits;
            return true;
        }
    }

    if (span_eq(rhs, "true") || span_eq(rhs, "false")) {
        int32_t result_tag = COLD_CONST_SCALAR_BOOL;
        uint64_t result_bits = span_eq(rhs, "true") ? 1 : 0;
        if (expected_tag != COLD_CONST_SCALAR_NONE &&
            expected_tag != result_tag) {
            if (!cold_convert_scalar_const(result_tag, result_bits,
                                           expected_tag, &result_bits))
                return false;
            result_tag = expected_tag;
        }
        *tag_out = result_tag;
        *bits_out = result_bits;
        return true;
    }

    if (cold_span_is_float(rhs)) {
        int32_t result_tag = expected_tag == COLD_CONST_SCALAR_F32
            ? COLD_CONST_SCALAR_F32 : COLD_CONST_SCALAR_F64;
        if (expected_tag != COLD_CONST_SCALAR_NONE &&
            !cold_scalar_tag_is_float(expected_tag))
            return false;
        double parsed = cold_span_f64(rhs);
        if (result_tag == COLD_CONST_SCALAR_F32) {
            float value = (float)parsed;
            uint32_t bits = 0;
            memcpy(&bits, &value, sizeof(bits));
            *bits_out = (uint64_t)bits;
        } else {
            uint64_t bits = 0;
            memcpy(&bits, &parsed, sizeof(bits));
            *bits_out = bits;
        }
        *tag_out = result_tag;
        return true;
    }

    uint64_t integer_bits = 0;
    bool fits_i32 = false;
    if (cold_parse_integer_const_bits(rhs, &integer_bits, &fits_i32)) {
        bool negative = rhs.ptr[0] == '-';
        bool hexadecimal = !negative && rhs.len >= 2 && rhs.ptr[0] == '0' &&
                           (rhs.ptr[1] == 'x' || rhs.ptr[1] == 'X');
        bool numeric_fits_i32 = negative
            ? fits_i32
            : integer_bits <= 0x7FFFFFFFULL;
        int32_t source_tag = numeric_fits_i32
            ? COLD_CONST_SCALAR_I32
            : (hexadecimal && integer_bits <= 0xFFFFFFFFULL
               ? COLD_CONST_SCALAR_U32 : COLD_CONST_SCALAR_I64);
        int32_t result_tag = expected_tag != COLD_CONST_SCALAR_NONE
            ? expected_tag : source_tag;
        uint64_t result_bits = integer_bits;
        if (result_tag != source_tag &&
            !cold_convert_scalar_const(source_tag, integer_bits,
                                       result_tag, &result_bits)) {
            return false;
        }
        *tag_out = result_tag;
        *bits_out = result_bits;
        return true;
    }

    if (expected_tag != COLD_CONST_SCALAR_NONE &&
        cold_scalar_tag_is_float(expected_tag)) return false;
    return cold_parse_integer_const_expression(symbols, alias, rhs,
                                               expected_tag, tag_out, bits_out);
}

/* Returns 1 when a scalar/string binding was registered, 0 when the
   declaration belongs to a non-scalar const domain, and -1 for a malformed
   scalar declaration. */
int32_t cold_register_const_binding(Symbols *symbols, Span alias, Span declaration,
                                    Span decl_path) {
    declaration = cold_strip_inline_comment(declaration);
    if (cold_span_starts_with(declaration, "const ") ||
        cold_span_starts_with(declaration, "const\t")) {
        declaration = span_trim(span_sub(declaration, 5, declaration.len));
    }
    int32_t eq = cold_span_find_top_level_char(declaration, '=');
    Span head = eq >= 0 ? span_trim(span_sub(declaration, 0, eq)) : declaration;
    Span rhs = eq >= 0 ? span_trim(span_sub(declaration, eq + 1, declaration.len))
                       : (Span){0};
    int32_t colon = cold_span_find_top_level_char(head, ':');
    Span type = {0};
    if (colon >= 0) {
        type = span_trim(span_sub(head, colon + 1, head.len));
        head = span_trim(span_sub(head, 0, colon));
    }
    if (!cold_span_is_simple_ident(head)) return -1;
    Span name = alias.len > 0
        ? cold_arena_join3(symbols->arena, alias, ".", head)
        : cold_arena_span_copy(symbols->arena, head);

    bool string_type = span_eq(type, "str");
    bool string_literal = rhs.len >= 2 && rhs.ptr[0] == '"' &&
                          rhs.ptr[rhs.len - 1] == '"';
    /* #128-r13 root fix: a bare-identifier RHS with no type annotation that
       names an already-registered str const (e.g. `rendezvousCodec =
       rendezvousCodecV1` right after `rendezvousCodecV1 = "/rendezvous/
       1.0.0"` in the same const block) previously fell through every
       branch below -- it isn't a string literal (no quotes) so it never
       entered this str-const path, and the scalar path further down
       (cold_parse_scalar_const_value) deliberately excludes SLOT_STR
       constants from its own bare-identifier lookup
       (`constant->kind != SLOT_STR`), so parsing failed and this function
       returned 0 ("declaration not applicable here"), which every caller
       treats as a silent skip -- the const alias was simply never written
       to the symbol table, and any later reference to it read as an
       unknown identifier. Reuse the same rhs-is-a-const-reference lookup
       the scalar path already relies on (cold_find_const_with_alias),
       scoped to the one outcome that lookup deliberately declines: the
       referenced const being a string. */
    ConstDef *rhs_str_const = (type.len == 0 && cold_span_is_simple_ident(rhs))
        ? cold_find_const_with_alias(symbols, alias, rhs) : NULL;
    if (rhs_str_const && rhs_str_const->kind != SLOT_STR) rhs_str_const = NULL;
    if (string_type || (type.len == 0 && string_literal) || rhs_str_const) {
        if (eq < 0) {
            symbols_add_str_const(symbols, name, (Span){0}, decl_path);
            return 1;
        }
        if (rhs_str_const) {
            symbols_add_str_const(symbols, name, rhs_str_const->str_val, decl_path);
            return 1;
        }
        if (!string_literal) return -1;
        Span inner = span_sub(rhs, 1, rhs.len - 1);
        symbols_add_str_const(symbols, name,
            cold_decode_string_content(symbols->arena, inner, false), decl_path);
        return 1;
    }

    int32_t expected_kind = 0;
    int32_t expected_tag = COLD_CONST_SCALAR_NONE;
    if (type.len > 0 &&
        !cold_const_scalar_type_from_type(type, &expected_kind, &expected_tag))
        return 0;
    if (eq < 0) {
        if (expected_kind == 0) return -1;
        symbols_add_tagged_const(symbols, name, expected_kind, expected_tag, 0, decl_path);
        return 1;
    }
    int32_t actual_tag = COLD_CONST_SCALAR_NONE;
    uint64_t bits = 0;
    if (!cold_parse_scalar_const_value(symbols, alias, expected_tag, rhs,
                                       &actual_tag, &bits)) {
        return expected_kind == 0 ? 0 : -1;
    }
    int32_t actual_kind = cold_scalar_tag_kind(actual_tag);
    if (actual_kind == 0) return -1;
    symbols_add_tagged_const(symbols, name, actual_kind, actual_tag, bits, decl_path);
    return 1;
}

bool cold_parse_scalar_global_initializer(Symbols *symbols, Span alias,
                                          int32_t kind, int32_t size, Span rhs,
                                          uint8_t out_bytes[8]) {
    if (kind != SLOT_I32 && kind != SLOT_I64 &&
        kind != SLOT_F32 && kind != SLOT_F64) {
        return false;
    }
    int32_t expected_size = (kind == SLOT_I32 || kind == SLOT_F32) ? 4 : 8;
    if (size != expected_size) return false;
    int32_t expected_tag = kind == SLOT_I32 ? COLD_CONST_SCALAR_I32
        : kind == SLOT_I64 ? COLD_CONST_SCALAR_I64
        : kind == SLOT_F32 ? COLD_CONST_SCALAR_F32
        : COLD_CONST_SCALAR_F64;
    int32_t actual_tag = COLD_CONST_SCALAR_NONE;
    uint64_t bits = 0;
    if (!cold_parse_scalar_const_value(symbols, alias, expected_tag, rhs,
                                       &actual_tag, &bits)) {
        if (kind != SLOT_I32) return false;
        Span scoped = alias.len > 0 && cold_span_find_char(rhs, '.') < 0
            ? cold_arena_join3(symbols->arena, alias, ".", rhs)
            : rhs;
        Variant *variant = symbols_find_variant(symbols, scoped);
        if (!variant) variant = symbols_find_variant(symbols, rhs);
        if (!variant || variant->field_count != 0) return false;
        bits = (uint64_t)(uint32_t)variant->tag;
        actual_tag = COLD_CONST_SCALAR_I32;
    }
    if (cold_scalar_tag_kind(actual_tag) != kind) return false;
    for (int32_t i = 0; i < expected_size; i++)
        out_bytes[i] = (uint8_t)(bits >> (i * 8));
    return true;
}

/* #156 root fix: `var x: T = T(field: expr, ...)` global initializers were
   silently dropped for struct/object-kind globals -- cold_collect_global_
   vars_from_source (cheng_cold.c) only evaluated SLOT_I32/I64/F32/F64 RHS
   text into static init_data bytes; for SLOT_OBJECT it fell straight
   through with init_data left {0}, and symbols_add_global/cold_copy_global_
   init zero-pad that to the struct's full size with no diagnostic --
   producing a silently all-zero global no matter what the source wrote
   (e.g. `bitswapContext.hasLedger && bitswapContext.config.enableLedger`
   always reading false-derived garbage regardless of the literal values in
   the constructor call). This recursively evaluates a constant struct-
   constructor-call RHS (`TypeName(field: expr, field: expr, ...)`, fields
   may themselves be nested struct-constructor calls) into the struct's
   real static byte layout, using each field's already-registered
   ObjectField offset/size/kind (the same layout field access and stack-
   allocated struct construction already rely on) so field order in source
   doesn't have to match declaration order. Leaf (non-nested) fields go
   through cold_parse_scalar_const_value with an expected_tag derived from
   the field's own kind/size (bool is SLOT_I32 sized 1 byte -- a narrow
   width, not the fixed 4/8 that cold_parse_scalar_global_initializer
   requires for top-level scalar globals, so that helper can't be reused
   here). Any field/shape it can't evaluate (unknown field name, non-
   constant RHS, unsupported field kind such as str/seq) returns false and
   the caller falls back to zero-filled init_data -- byte-identical to the
   pre-#156 behavior for those shapes. Folding is scoped to shapes proven
   correct (bool/int named fields incl. nested); widening it to str/seq/ref
   needs a data-segment relocation subsystem (see #156 honest residual). */
bool cold_parse_object_global_initializer(Symbols *symbols, Span alias,
                                          ObjectDef *obj, Span rhs,
                                          uint8_t *out_bytes, int32_t out_size) {
    if (!obj || !out_bytes || out_size <= 0) return false;
    rhs = span_trim(rhs);
    if (rhs.len <= 0 || rhs.ptr[rhs.len - 1] != ')') return false;
    int32_t open = cold_span_find_char(rhs, '(');
    if (open <= 0) return false;
    Span head = span_trim(span_sub(rhs, 0, open));
    if (!cold_span_is_simple_ident(head)) return false;
    Span inner = span_trim(span_sub(rhs, open + 1, rhs.len - 1));
    memset(out_bytes, 0, (size_t)out_size);
    Span remaining = inner;
    while (remaining.len > 0) {
        int32_t comma = cold_span_find_top_level_char(remaining, ',');
        Span item = span_trim(comma >= 0 ? span_sub(remaining, 0, comma)
                                          : remaining);
        remaining = comma >= 0 ? span_sub(remaining, comma + 1, remaining.len)
                               : (Span){0};
        if (item.len <= 0) continue;
        int32_t colon = cold_span_find_top_level_char(item, ':');
        if (colon <= 0) return false;
        Span field_name = span_trim(span_sub(item, 0, colon));
        Span field_expr = span_trim(span_sub(item, colon + 1, item.len));
        if (field_name.len <= 0 || field_expr.len <= 0) return false;
        ObjectField *field = NULL;
        for (int32_t fi = 0; fi < obj->field_count; fi++) {
            if (span_same(obj->fields[fi].name, field_name)) {
                field = &obj->fields[fi];
                break;
            }
        }
        if (!field) return false;
        if (field->offset < 0 || field->size <= 0 ||
            field->offset + field->size > out_size) return false;
        if (field->kind == SLOT_OBJECT) {
            ObjectDef *nested = symbols_resolve_object(symbols, field->type_name);
            if (!nested) return false;
            if (!cold_parse_object_global_initializer(symbols, alias, nested,
                                                       field_expr,
                                                       out_bytes + field->offset,
                                                       field->size))
                return false;
            continue;
        }
        if (field->kind != SLOT_I32 && field->kind != SLOT_I64 &&
            field->kind != SLOT_F32 && field->kind != SLOT_F64) {
            /* Field kind not yet constant-foldable into static global bytes
               here (str/seq/ref/ptr/variant/...). Leave it at the zero this
               function already memset -- byte-identical to this struct's
               storage before #156 (the entire struct silently defaulted to
               zero for every field), so kinds outside this fix's scope are
               neither corrected nor newly broken; only die() on genuinely
               malformed struct-literal syntax (unmatched parens, unknown
               field name, missing ':'), not on an unsupported-but-well-
               formed field. */
            continue;
        }
        int32_t expected_tag = field->kind == SLOT_F32 ? COLD_CONST_SCALAR_F32
            : field->kind == SLOT_F64 ? COLD_CONST_SCALAR_F64
            : field->size > 4 ? COLD_CONST_SCALAR_I64
            : COLD_CONST_SCALAR_I32;
        int32_t actual_tag = COLD_CONST_SCALAR_NONE;
        uint64_t bits = 0;
        if (!cold_parse_scalar_const_value(symbols, alias, expected_tag,
                                           field_expr, &actual_tag, &bits))
            return false;
        for (int32_t bi = 0; bi < field->size; bi++)
            out_bytes[field->offset + bi] = (uint8_t)(bits >> (bi * 8));
    }
    return true;
}

void parse_const_member_line(Parser *parser, Span line) {
    Span trimmed = cold_strip_inline_comment(line);
    if (trimmed.len <= 0) return;
    int32_t binding_status = cold_register_const_binding(
        parser->symbols, (Span){0}, trimmed, (Span){0});
    if (binding_status >= 0) return;
    fprintf(stderr, "cheng_cold: ");
    cold_error_loc(parser, trimmed);
    fprintf(stderr, " unsupported const declaration: '%.*s'\n",
            trimmed.len, trimmed.ptr);
    cold_print_context(parser, trimmed);
    die("unsupported const declaration");
}

void parse_const(Parser *parser) {
    int32_t line_start = parser->pos;
    int32_t first_line_end = cold_line_end_from(parser->source, line_start);
    Span first_line = span_trim(span_sub(parser->source, line_start, first_line_end));
    if (span_eq(first_line, "const")) {
        int32_t pos = first_line_end;
        if (pos < parser->source.len) pos++;
        int32_t group_indent = -1;
        while (pos < parser->source.len) {
            int32_t member_start = pos;
            int32_t member_end = cold_line_end_from(parser->source, member_start);
            Span line = span_sub(parser->source, member_start, member_end);
            Span trimmed = cold_strip_inline_comment(line);
            if (trimmed.len == 0) {
                pos = member_end;
                if (pos < parser->source.len) pos++;
                continue;
            }
            int32_t indent = cold_line_indent_width(line);
            if (indent == 0) break;
            if (group_indent < 0) group_indent = indent;
            if (indent < group_indent) break;
            int32_t equals = cold_span_find_char(trimmed, '=');
            if (indent != group_indent || equals <= 0) {
                parse_const_member_line(parser, line);
                pos = member_end;
                if (pos < parser->source.len) pos++;
                continue;
            }
            int32_t statement_end = 0;
            int32_t declaration_start =
                (int32_t)(trimmed.ptr - parser->source.ptr);
            Span statement = cold_take_import_const_statement(
                parser->source, declaration_start,
                declaration_start + equals, indent,
                &statement_end);
            parse_const_member_line(parser, statement);
            pos = statement_end;
        }
        parser->pos = pos;
        return;
    }
    if (!cold_span_starts_with(first_line, "const ")) die("expected const");
    int32_t equals = cold_span_find_char(first_line, '=');
    if (equals <= 0) {
        parse_const_member_line(parser, first_line);
        parser->pos = first_line_end;
        if (parser->pos < parser->source.len) parser->pos++;
        return;
    }
    int32_t statement_end = 0;
    int32_t declaration_start =
        (int32_t)(first_line.ptr - parser->source.ptr);
    Span statement = cold_take_import_const_statement(
        parser->source, declaration_start,
        declaration_start + equals, 0,
        &statement_end);
    parse_const_member_line(parser, statement);
    parser->pos = statement_end;
}

