        body_op(body, BODY_OP_F32_FROM_I32, slot, a, 0);
        if (kind_out) *kind_out = SLOT_F32;
        *slot_out = slot;
        return true;
    }
    return false;
}

int32_t cold_make_str_result_slot(BodyIR *body) {
    int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
    body_slot_set_type(body, slot, cold_cstr_span("str"));
    return slot;
}

Span body_get_str_literal_span(BodyIR *body, int32_t slot) {
    for (int32_t i = 0; i < body->op_count; i++) {
        if (body->op_kind[i] == BODY_OP_STR_LITERAL && body->op_dst[i] == slot) {
            int32_t li = body->op_a[i];
            if (li >= 0 && li < body->string_literal_count)
                return body->string_literal[li];
        }
    }
    return (Span){0};
}

bool body_slot_is_str_literal(BodyIR *body, int32_t slot) {
    for (int32_t i = 0; i < body->op_count; i++) {
        if (body->op_kind[i] == BODY_OP_STR_LITERAL && body->op_dst[i] == slot) {
            return true;
        }
    }
    return false;
}

const char *body_strdup_from_slot(Arena *arena, BodyIR *body, int32_t slot) {
    Span lit = body_get_str_literal_span(body, slot);
    if (lit.ptr == 0 || lit.len <= 0) return 0;
    char *out = arena_alloc(arena, (size_t)lit.len + 1);
    memcpy(out, lit.ptr, (size_t)lit.len);
    out[lit.len] = '\0';
    return out;
}

int32_t cold_require_str_value(BodyIR *body, int32_t slot, const char *context) {
    if (body->slot_kind[slot] == SLOT_STR) return slot;
    if (body->slot_kind[slot] == SLOT_STR_REF) {
        int32_t dst = cold_make_str_result_slot(body);
        body_op3(body, BODY_OP_PAYLOAD_LOAD, dst, slot, 0, COLD_STR_SLOT_SIZE);
        return dst;
    }
    fprintf(stderr, "cheng_cold: %s requires str slot kind=%d slot=%d\n",
            context ? context : "intrinsic", body->slot_kind[slot], slot);
    die("cold intrinsic requires exact str value");
    return -1;
}

bool cold_try_path_intrinsic(Parser *parser, BodyIR *body, Span name,
                                    int32_t arg_start, int32_t arg_count,
                                    const ColdExprResult *arg_results,
                                    int32_t *slot_out, int32_t *kind_out,
                                    ColdExprResult *result_out) {
    (void)arg_start;
    if (ColdPathIntrinsicsForceSource) return false;
    if (span_eq(name, "chengpath.PathCurrentDir") ||
        span_eq(name, "PathCurrentDir") ||
        span_eq(name, "os.GetCurrentDir") ||
        span_eq(name, "os.GetCurrentDirectory")) {
        if (arg_count != 0) die("PathCurrentDir arity mismatch");
        int32_t slot = cold_make_str_result_slot(body);
        int32_t producer =
            body_op(body, BODY_OP_CWD_STR, slot, 0, 0);
        cold_publish_owned_managed_producer(
            body, parser->symbols, slot, SLOT_STR,
            producer, result_out);
        if (kind_out) *kind_out = SLOT_STR;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "chengpath.PathJoin") ||
        span_eq(name, "chengpath.PathJoinBridge") ||
        span_eq(name, "PathJoin") ||
        span_eq(name, "PathJoinBridge")) {
        if (arg_count != 2) die("PathJoin arity mismatch");
        ColdExprResult left_source =
            cold_require_exact_str_result_value(
                body, parser->symbols,
                arg_results ? &arg_results[0] : 0,
                "PathJoin left");
        ColdExprResult right_source =
            cold_require_exact_str_result_value(
                body, parser->symbols,
                arg_results ? &arg_results[1] : 0,
                "PathJoin right");
        int32_t slot = cold_make_str_result_slot(body);
        int32_t producer =
            body_op(body, BODY_OP_PATH_JOIN, slot,
                    left_source.slot, right_source.slot);
        cold_publish_exact_managed_read(
            body, producer, COLD_EXACT_READ_OPERAND_A,
            &left_source);
        cold_publish_exact_managed_read(
            body, producer, COLD_EXACT_READ_OPERAND_B,
            &right_source);
        cold_publish_owned_managed_producer(
            body, parser->symbols, slot, SLOT_STR, producer,
            result_out);
        if (kind_out) *kind_out = SLOT_STR;
        *slot_out = slot;
        return true;
    }
    if (span_eq(name, "provroot.RuntimeProviderPath") ||
        span_eq(name, "RuntimeProviderPath")) {
        if (arg_count != 2) die("RuntimeProviderPath arity mismatch");
        ColdExprResult root_source =
            cold_require_exact_str_result_value(
                body, parser->symbols,
                arg_results ? &arg_results[0] : 0,
                "RuntimeProviderPath root");
        ColdExprResult raw_source =
            cold_require_exact_str_result_value(
                body, parser->symbols,
                arg_results ? &arg_results[1] : 0,
                "RuntimeProviderPath rel");
        ColdExprResult key_source;
        int32_t key = cold_make_str_literal_cstr_slot_exact(
            body, "CHENG_ROOT", &key_source);
        int32_t env_root = cold_make_str_result_slot(body);
        int32_t env_op = body_op(
            body, BODY_OP_GETENV_STR, env_root, key, 0);
        cold_publish_exact_managed_read(
            body, env_op, COLD_EXACT_READ_OPERAND_A,
            &key_source);
        ColdExprResult env_source;
        cold_publish_owned_managed_producer(
            body, parser->symbols, env_root, SLOT_STR,
            env_op, &env_source);
        int32_t selected_root = cold_make_str_result_slot(body);
        int32_t select_op = body_op(
            body, BODY_OP_STR_SELECT_NONEMPTY,
            selected_root, env_root, root_source.slot);
        cold_publish_exact_managed_read(
            body, select_op, COLD_EXACT_READ_OPERAND_A,
            &env_source);
        cold_publish_exact_managed_read(
            body, select_op, COLD_EXACT_READ_OPERAND_B,
            &root_source);
        ColdExprResult selected_source;
        /* STR_SELECT_NONEMPTY writes selected_root; publish as owned
           producer (not BORROW_SHARED) so PATH_ABSOLUTE result authority
           stays exact — BORROW_SHARED here broke call-site temporaries. */
        cold_publish_owned_managed_producer(
            body, parser->symbols, selected_root, SLOT_STR,
            select_op, &selected_source);
        int32_t slot = cold_make_str_result_slot(body);
        int32_t producer =
            body_op(body, BODY_OP_PATH_ABSOLUTE, slot,
                    selected_root, raw_source.slot);
        cold_publish_exact_managed_read(
            body, producer, COLD_EXACT_READ_OPERAND_A,
            &selected_source);
        cold_publish_exact_managed_read(
            body, producer, COLD_EXACT_READ_OPERAND_B,
            &raw_source);
        cold_publish_owned_managed_producer(
            body, parser->symbols, slot, SLOT_STR,
            producer, result_out);
        if (kind_out) *kind_out = SLOT_STR;
        *slot_out = slot;
