        Parser *parser, BodyIR *body, Locals *locals,
        Span condition);
static int32_t cold_materialize_conditional_global_shadow(
        BodyIR *body, int32_t slot, int32_t *kind);
static int32_t parse_logical_expr_cfg(Parser *parser, BodyIR *body,
                                      Locals *locals, Span expr, int32_t *kind);
static int32_t cold_parse_expr_with_result(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t *kind, ColdExprResult *result_out);
static int32_t cold_merge_exact_managed_conditional_result(
        Parser *parser, BodyIR *body, int32_t kind,
        const ColdExprResult *first,
        const ColdExprResult *second,
        int32_t first_predecessor,
        int32_t second_predecessor);
static int32_t cold_parser_origin_visual_column_at(
        Parser *parser, int32_t local_offset);
static int32_t cold_parse_multiline_value_if_expr(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t if_indent, int32_t *kind);

static int32_t cold_current_open_block(BodyIR *body) {
    /* Expression-level CFG (ternary / if-expr / logical materialization)
       must attach its CBR to the block that is actually receiving ops.
       Scanning for "first open block by index" picked dormant pre-created
       blocks (a loop's after-block, an if's join-block) in nested
       constructs: the CBR landed on the wrong block, its op range got
       inflated over every inner block (duplicated codegen), and the stolen
       terminator was later wiped by body_reopen_block.  Use the explicit
       currency tracked by body_block/body_reopen_block/body_end_block. */
    int32_t cur = body->cur_open_block;
    if (cur >= 0 && cur < body->block_count && body->block_term[cur] < 0) return cur;
    /* No live emission block (e.g. unreachable code after a return):
       open a fresh block so dead ops cannot corrupt a dormant block's
       range.  Nothing branches to it, so it is laid out but never run. */
    return body_block(body);
}

/* Conservative signedness-marker join for a two-arm value-merge point
   (if-expr, ternary, inline-if-let). A fresh body_slot() unconditionally
   zeroes the new slot's type marker; re-propagating a source marker onto it
   is only safe when every arm that can actually reach the merge slot at
   runtime carries the identical marker. Propagating the then-arm's marker
   unconditionally (the previous behaviour) is wrong whenever the runtime
   value actually comes from an else/elif arm with a different or absent
   marker -- a uint32/64 high-bit value then gets silently reinterpreted as
   signed. When the two arms disagree (or either is unmarked) this leaves
   result_slot untyped, i.e. it falls back to the pre-existing signed
   default rather than guessing which arm's marker should win. See #151 for
   the open question of whether the type checker should reject mixed-
   signedness conditional expressions outright. */
static void cold_join_marker_arm(BodyIR *body, int32_t slot, Span *joined, bool *conflict) {
    if (*conflict) return;
    Span m = body->slot_type[slot];
    if (m.len <= 0) { *conflict = true; return; }
    if (joined->len <= 0) { *joined = m; return; }
    if (!span_same(*joined, m)) *conflict = true;
}

static void cold_result_slot_join_marker(BodyIR *body, int32_t result_slot,
                                         int32_t a_slot, int32_t b_slot) {
    Span joined = {0};
    bool conflict = false;
    cold_join_marker_arm(body, a_slot, &joined, &conflict);
    cold_join_marker_arm(body, b_slot, &joined, &conflict);
    if (!conflict && joined.len > 0)
        body_slot_set_type(body, result_slot, joined);
}

static int32_t cold_parse_if_expr_with_result(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t *kind, ColdExprResult *result_out) {
    if (result_out) cold_expr_result_reset(result_out);
    int32_t expression_start = parser->pos;
    int32_t if_start = expression_start >= 2
        ? expression_start - 2
        : 0;
    (void)parser_take_until_top_level_char(
        parser, ':', "expected : in if");
    int32_t after_colon = parser->pos + 1;
    while (after_colon < parser->source.len &&
           (parser->source.ptr[after_colon] == ' ' ||
            parser->source.ptr[after_colon] == '\t')) {
        after_colon++;
    }
    bool multiline =
        after_colon < parser->source.len &&
        (parser->source.ptr[after_colon] == '\n' ||
         parser->source.ptr[after_colon] == '\r');
    parser->pos = expression_start;
    if (multiline) {
        return cold_parse_multiline_value_if_expr(
            parser, body, locals,
            cold_parser_origin_visual_column_at(
                parser, if_start), kind);
    }
    Span condition = parser_take_until_top_level_char(parser, ':', "expected : in if");
    if (!parser_take(parser, ":")) {
        int32_t zero = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
        if (kind) *kind = SLOT_I32;
        return zero;
    }
    Span then_span = {0};
    if (!parser_take_until_top_level_else(parser, &then_span)) {
        int32_t zero = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
        if (kind) *kind = SLOT_I32;
        return zero;
    }
    if (!parser_take(parser, "else")) {
        int32_t zero = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
        if (kind) *kind = SLOT_I32;
        return zero;
    }
    if (span_eq(parser_peek(parser), "elif")) {
        (void)parser_token(parser);
        /* Attach the CBR to the currently open block, then converge through
         * the join block so later expression ops execute only after the branch. */
        int32_t cond_block = cold_current_open_block(body);
        int32_t true_block = body_block(body);
        int32_t else_block = body_block(body);
        int32_t join_block = body_block(body);
        int32_t local_count = locals->count;
        parse_condition_span(parser, body, locals, condition, cond_block, true_block, else_block);
        ColdLocalValueState *branch_baseline =
            cold_snapshot_local_value_defs(
                parser, body, locals, local_count);
        body_reopen_block(body, true_block);
        Parser then_parser = parser_child(parser, then_span);
        int32_t then_kind = SLOT_I32;
        ColdExprResult then_result;
        cold_expr_result_reset(&then_result);
        int32_t then_slot = cold_parse_expr_with_result(
            &then_parser, body, locals, &then_kind, &then_result);
        parser_ws(&then_parser);
        if (then_parser.pos != then_parser.source.len)
            die("unsupported if then expression");
        then_slot = cold_materialize_conditional_global_shadow(
            body, then_slot, &then_kind);
        int32_t result_kind = then_kind;
        /* A managed result cannot ride the shared-slot COPY below: a bare
           COPY_COMPOSITE carries no exact source authority and
           body-store-freeze categorically rejects it.  Keep each arm's
           exact value definition in its own block and converge through the
           exact conditional merge -- the same path the ternary operator and
           the multi-line value if already use. */
        bool managed_result =
            cold_exact_conditional_requires_identity_merge(
                parser->symbols, body, then_slot, result_kind);
        int32_t result_slot = -1;
        if (!managed_result) {
            result_slot = body_slot(body, result_kind, body->slot_size[then_slot]);
            cold_store_value_into_slot(body, result_slot, result_kind, then_slot, then_kind);
        }
        /* Branch the block that actually ends the arm: a nested expression
           CFG (ternary / inner if-expr) leaves emission in its join block,
           not in the arm block we opened. */
        int32_t true_end = cold_current_open_block(body);
        ColdLocalValueState *true_states =
            cold_snapshot_local_value_defs(
                parser, body, locals, local_count);
        if (body->block_term[true_end] < 0) body_branch_to(body, true_end, join_block);
        body_reopen_block(body, else_block);
        cold_restore_local_value_defs(
            body, locals, local_count, branch_baseline);
        int32_t elif_kind = SLOT_I32;
        ColdExprResult elif_result;
        cold_expr_result_reset(&elif_result);
        int32_t elif_slot = cold_parse_if_expr_with_result(
            parser, body, locals, &elif_kind, &elif_result);
        if (managed_result) {
            if (elif_kind != result_kind &&
                (elif_kind == SLOT_STR_REF || elif_kind == SLOT_SEQ_I32_REF ||
                 elif_kind == SLOT_SEQ_STR_REF ||
                 elif_kind == SLOT_SEQ_OPAQUE_REF ||
                 elif_kind == SLOT_OBJECT_REF)) {
                elif_result = cold_exact_managed_ref_value_borrow(
                    body, parser->symbols, &elif_result);
                elif_kind = elif_result.kind;
                elif_slot = elif_result.slot;
            }
            if (elif_kind != result_kind)
                die("managed if expression result kinds differ");
        } else {
            cold_store_value_into_slot(body, result_slot, result_kind, elif_slot, elif_kind);
            /* elif_slot is itself a merge result from the recursive call above, so
               it already carries the conservatively-joined marker of every deeper
               arm in the elif chain -- joining then_slot against it here makes the
               whole chain agree-or-nothing. */
            cold_result_slot_join_marker(body, result_slot, then_slot, elif_slot);
        }
        int32_t else_end = cold_current_open_block(body);
        ColdLocalValueState *false_states =
            cold_snapshot_local_value_defs(
                parser, body, locals, local_count);
        if (body->block_term[else_end] < 0) body_branch_to(body, else_end, join_block);
        body_reopen_block(body, join_block);
        cold_join_local_value_defs(
            parser, body, locals, local_count,
            branch_baseline,
            true_states, true, true_end,
            false_states, true, else_end,
            managed_result ? &then_result : 0,
            managed_result ? &elif_result : 0,
            managed_result ? result_kind : -1,
            managed_result ? &result_slot : 0,
            0, 0);
        if (managed_result) {
            if (result_out) {
                /* The merge committed a CFG_MERGE definition; the slot head
                   now names it (the CFG_MERGE slot contract), so rebuild the
                   outgoing exact result from that row. */
                int32_t merge_def = body->slot_origin_id[result_slot];
                if (merge_def < 0 ||
                    !cold_exact_result_from_definition(
                        body, result_slot, merge_def, result_out)) {
                    die("managed if expression merge result is not exact");
                }
            }
        }
        parser_record_expr_resume(parser, join_block);
        if (kind) *kind = result_kind;
        return result_slot;
    }
    if (!parser_take(parser, ":")) {
        int32_t zero = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
        if (kind) *kind = SLOT_I32;
        return zero;
    }
    Span else_span = parser_take_balanced_rest_of_line(parser);
    if (else_span.len <= 0) {
        int32_t zero = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
        if (kind) *kind = SLOT_I32;
        return zero;
    }
    /* Attach the CBR to the currently open block, then converge through
     * the join block so later expression ops execute only after the branch. */
    int32_t cond_block = cold_current_open_block(body);
    int32_t true_block = body_block(body);
    int32_t false_block = body_block(body);
    int32_t join_block = body_block(body);
    int32_t local_count = locals->count;
    parse_condition_span(parser, body, locals, condition, cond_block, true_block, false_block);
    ColdLocalValueState *branch_baseline =
        cold_snapshot_local_value_defs(
            parser, body, locals, local_count);
    body_reopen_block(body, true_block);
    Parser then_parser = parser_child(parser, then_span);
    int32_t then_kind = SLOT_I32;
    ColdExprResult then_result;
    cold_expr_result_reset(&then_result);
    int32_t then_slot = cold_parse_expr_with_result(
        &then_parser, body, locals, &then_kind, &then_result);
    parser_ws(&then_parser);
    if (then_parser.pos != then_parser.source.len)
        die("unsupported if then expression");
    then_slot = cold_materialize_conditional_global_shadow(
        body, then_slot, &then_kind);
    int32_t result_kind = then_kind;
    /* Same split as the elif variant above: managed results converge
       through the exact conditional merge; the shared-slot COPY has no
       exact source authority and body-store-freeze rejects it. */
    bool managed_result =
        cold_exact_conditional_requires_identity_merge(
            parser->symbols, body, then_slot, result_kind);
    int32_t result_slot = -1;
    if (!managed_result) {
        result_slot = body_slot(body, result_kind, body->slot_size[then_slot]);
        cold_store_value_into_slot(body, result_slot, result_kind, then_slot, then_kind);
    }
    /* See elif variant: branch the real end-of-arm block (nested expression
       CFG moves emission into its own join block). */
    int32_t true_end = cold_current_open_block(body);
    ColdLocalValueState *true_states =
        cold_snapshot_local_value_defs(
            parser, body, locals, local_count);
    if (body->block_term[true_end] < 0) body_branch_to(body, true_end, join_block);
    body_reopen_block(body, false_block);
    cold_restore_local_value_defs(
        body, locals, local_count, branch_baseline);
    Parser else_parser = parser_child(parser, else_span);
    int32_t else_kind = SLOT_I32;
    ColdExprResult else_result;
    cold_expr_result_reset(&else_result);
    int32_t else_slot = cold_parse_expr_with_result(
        &else_parser, body, locals, &else_kind, &else_result);
    parser_ws(&else_parser);
    if (else_parser.pos != else_parser.source.len)
        die("unsupported if else expression");
    else_slot = cold_materialize_conditional_global_shadow(
        body, else_slot, &else_kind);
    if (managed_result) {
        if (else_kind != result_kind &&
            (else_kind == SLOT_STR_REF || else_kind == SLOT_SEQ_I32_REF ||
             else_kind == SLOT_SEQ_STR_REF ||
             else_kind == SLOT_SEQ_OPAQUE_REF ||
             else_kind == SLOT_OBJECT_REF)) {
            else_result = cold_exact_managed_ref_value_borrow(
                body, parser->symbols, &else_result);
            else_kind = else_result.kind;
            else_slot = else_result.slot;
        }
        if (else_kind != result_kind)
            die("managed if expression result kinds differ");
    } else {
        cold_store_value_into_slot(body, result_slot, result_kind, else_slot, else_kind);
        cold_result_slot_join_marker(body, result_slot, then_slot, else_slot);
    }
    int32_t false_end = cold_current_open_block(body);
    ColdLocalValueState *false_states =
        cold_snapshot_local_value_defs(
            parser, body, locals, local_count);
    if (body->block_term[false_end] < 0) body_branch_to(body, false_end, join_block);
    body_reopen_block(body, join_block);
    cold_join_local_value_defs(
        parser, body, locals, local_count,
        branch_baseline,
        true_states, true, true_end,
        false_states, true, false_end,
        managed_result ? &then_result : 0,
        managed_result ? &else_result : 0,
        managed_result ? result_kind : -1,
        managed_result ? &result_slot : 0,
        0, 0);
    if (managed_result) {
        if (result_out) {
            int32_t merge_def = body->slot_origin_id[result_slot];
            if (merge_def < 0 ||
                !cold_exact_result_from_definition(
                    body, result_slot, merge_def, result_out)) {
                die("managed if expression merge result is not exact");
            }
        }
    }
    parser_record_expr_resume(parser, join_block);
    if (kind) *kind = result_kind;
    return result_slot;
}

int32_t parse_if_expr(Parser *parser, BodyIR *body, Locals *locals, int32_t *kind) {
    ColdExprResult discarded;
    return cold_parse_if_expr_with_result(
        parser, body, locals, kind, &discarded);
}

int32_t parse_postfix(Parser *parser, BodyIR *body, Locals *locals,
                             int32_t slot, int32_t *kind);
static int32_t cold_lower_question_expression(Parser *parser, BodyIR *body,
                                              Locals *locals,
                                              int32_t variant_slot,
                                              int32_t *kind);
Span parse_index_bracket(Parser *parser);
static int32_t parse_closure_expr(
    Parser *parser, BodyIR *body, Locals *locals,
    int32_t *kind, Span declaration_token);
int32_t parse_if_expr(Parser *parser, BodyIR *body, Locals *locals, int32_t *kind);
int32_t cold_materialize_i32_ref(BodyIR *body, int32_t slot, int32_t *kind);
int32_t cold_materialize_i64_value(BodyIR *body, int32_t slot, int32_t *kind);
int32_t cold_materialize_ptr_value(BodyIR *body, int32_t slot, int32_t *kind);
static bool cold_slot_type_is_uint64(BodyIR *body, int32_t slot);
static bool cold_slot_type_is_uint32(BodyIR *body, int32_t slot);
static int32_t cold_parse_pointer_deref_expr(Parser *parser, BodyIR *body,
                                             Locals *locals, Span ptr_expr,
                                             int32_t *kind);
static int32_t cold_emit_pointer_load(Parser *parser, BodyIR *body,
                                      int32_t ptr_slot, int32_t *kind);

static ObjectDef *cold_resolve_pointer_object(Symbols *symbols, Span type) {
    Span current = span_trim(type);
    for (int32_t i = 0; i < 8; i++) {
        TypeDef *alias = symbols ? symbols_find_type(symbols, current) : 0;
        if (!alias || alias->alias_type.len <= 0) break;
        current = span_trim(alias->alias_type);
    }
    if (cold_type_has_pointer_suffix(current)) {
        current = span_trim(span_sub(current, 0, current.len - 1));
    }
    if (current.len <= 0) return 0;
    return symbols_resolve_object(symbols, current);
}

/* FIELD_REF consumes an address value, not the address of the carrier's
   frame cell.  A by-value raw `T*` parameter/local is represented as
   SLOT_OPAQUE, so materialize one canonical SLOT_PTR carrier before a field
   projection.  This helper is deliberately limited to a sentinel-authority
   pointer to a plain object: managed/ref pointees must arrive through the
   exact projection path and may never be relabelled into an unmanaged raw
   address.  Keeping the declared pointer spelling on the destination also
   makes the resulting sentinel authority structurally provable; stamping the
   pointee object name on a SLOT_OBJECT_REF would falsely claim a managed
   object-reference value. */
static ObjectDef *cold_plain_object_pointer_field_pointee(
        Symbols *symbols, const BodyIR *body, int32_t source_slot) {
    return cold_body_plain_pointer_pointee_object(
        body, symbols, source_slot);
}

static bool cold_plain_object_pointer_field_source_is_canonical(
        Symbols *symbols, BodyIR *body, int32_t source_slot,
        const ObjectDef *expected_object) {
    if (!symbols || !body || !expected_object ||
        source_slot < 0 || source_slot >= body->slot_count) {
        return false;
    }
    int32_t source_kind = body->slot_kind[source_slot];
    if ((source_kind != SLOT_OPAQUE &&
         source_kind != SLOT_OPAQUE_REF) ||
        body->slot_size[source_slot] != 8 ||
        !cold_exact_slot_authority_is_sentinel(body, source_slot)) {
        return false;
    }
    ObjectDef *resolved =
        cold_plain_object_pointer_field_pointee(
            symbols, body, source_slot);
    if (!resolved) return false;
    int32_t resolved_row =
        (int32_t)(resolved - symbols->objects);
    int32_t expected_row =
        (int32_t)(expected_object - symbols->objects);
    return resolved_row >= 0 &&
           resolved_row < symbols->object_count &&
           expected_row >= 0 &&
           expected_row < symbols->object_count &&
           cold_canonical_object_identity(
               symbols, resolved_row) ==
               cold_canonical_object_identity(
                   symbols, expected_row);
}

static int32_t cold_materialize_plain_object_pointer_field_base(
        Symbols *symbols, BodyIR *body, int32_t source_slot,
        const ObjectDef *expected_object) {
    if (!symbols || !body || !expected_object ||
        source_slot < 0 || source_slot >= body->slot_count) {
        die("plain object pointer field base is invalid");
    }
    int32_t source_kind = body->slot_kind[source_slot];
    if (source_kind == SLOT_OBJECT ||
        source_kind == SLOT_OBJECT_REF ||
        source_kind == SLOT_PTR) {
        return source_slot;
    }
    if (!cold_plain_object_pointer_field_source_is_canonical(
            symbols, body, source_slot, expected_object)) {
        die("plain object pointer field base identity is not canonical");
    }
    int32_t destination = body_slot(body, SLOT_PTR, 8);
    body_slot_set_type(
        body, destination, body->slot_type[source_slot]);
    body_op(
        body, BODY_OP_COPY_I64,
        destination, source_slot, 0);
    if (!cold_exact_slot_authority_is_sentinel(body, destination)) {
        die("plain object pointer field base acquired managed authority");
    }
    return destination;
}

/* `$` prefix stringify operator (spec 1.3.1): `$x` calls the (possibly
   overloaded) unary operator function `$` on x -- reuses the same
   arg-coercion passes and CALL_I32/CALL_COMPOSITE emission an ordinary 1-arg
   call uses, so it stays correct for scalar, generic (Table[V]) and object
   ($ operand) overloads alike.
   Without a dedicated `$` case, parse_primary's bare-token fallback resolved
   the backtick fn `$` as a plain FN_ADDR *pointer value* (the generic "bare
   function name reference" path) instead of calling it, leaving the operand
   unconsumed as trailing garbage in the caller's statement-expression span:
   "trailing tokens in return value" (hard die, dropped function body) in
   `return` context, or a silently-continued "trailing tokens in let
   initializer" in `let` context that kept compiling with a wrong partial
   value (real_backend_codegen=1, RC=0, wrong runtime result).
   Lookup is a global scan by name-suffix match (cold_span_ends_with(name,
   "$")), mirroring the existing `[]=`/`[]` backtick-operator convention
   (cold_emit_idxop_assign) rather than an exact-name symbols_find_fn_for_call:
   every function pulled in from an imported file is registered under an
   `<import alias>.<name>` scoped name (e.g. `lib.$`, symmetric with `lib.f`),
   so an exact match on the bare "$" misses any `$` overload declared outside
   the current file -- exactly the file this repro's own operand type's `$`
   overload lives in. `$` can never appear inside an ordinary identifier
   (cold_ident_char excludes it), so a name-suffix match is unambiguous. */
static void cold_die_ambiguous_dollar_call(Parser *parser, Span operand_expr,
                                           const char *detail) {
    fprintf(stderr, "cheng_cold: ");
    cold_error_loc(parser, operand_expr);
    fprintf(stderr, " ambiguous `$` stringify operator overload for operand '%.*s' (%s)\n",
            (int)operand_expr.len, operand_expr.ptr, detail);
    cold_print_context(parser, operand_expr);
    die("ambiguous $ stringify operator");
}

/* True when two overload candidates are registrations of the SAME physical
   declaration reached through different import aliases.  The immutable
   declarationOriginRow is the authority; path/line remain diagnostics.
   Synthetic registrations carry -1 and never merge through this predicate. */
static bool cold_fn_decl_same_physical_origin(FnDef *a, FnDef *b) {
    return a && b &&
           a->declaration_origin_row >= 0 &&
           a->declaration_origin_row ==
               b->declaration_origin_row;
}

static int32_t cold_emit_dollar_call(Parser *parser, BodyIR *body, Locals *locals,
                                     int32_t operand_slot, Span operand_expr,
                                     int32_t *kind_out) {
    int32_t arg_start = body->call_arg_count;
    body_call_arg(body, operand_slot);
    if (ColdActiveExprResult &&
        ColdActiveExprResultBody == body &&
        ColdActiveExprResult->slot == operand_slot &&
        ColdActiveExprResult->value_def_op_id >= 0 &&
        cold_exact_op_tuple_matches_result(
            body, ColdActiveExprResult)) {
        cold_bind_parsed_call_arg_authority(
            body, arg_start, ColdActiveExprResult);
    }
    Span arg_exprs[1];
    arg_exprs[0] = operand_expr;
    Span dollar_name = cold_cstr_span("$");
    Span operand_type = span_trim(body->slot_type[operand_slot]);
    int32_t fn_index = -1;
    /* Pass 1: exact operand-declared-type match, narrowed within the
       kind-compatible candidate set. This is required because
       cold_call_args_match only compares coarse SLOT_* kinds -- bool, char,
       int8/16/32 (and the "int"/"int32" spelling pair) all collapse to the
       same SLOT_I32 kind, so a kind-only scan cannot tell `$(x: bool)` from
       `$(x: int32)` apart and would silently bind to whichever overload sits
       at the lowest function-table index (declaration order), regardless of
       the operand's actual declared type. Comparing the raw declared-type
       text against param_type[0] disambiguates these exactly. */
    if (operand_type.len > 0) {
        int32_t exact_matches = 0;
        for (int32_t i = 0; i < parser->symbols->function_count; i++) {
            FnDef *cand = &parser->symbols->functions[i];
            if (cand->arity != 1 || !cold_span_ends_with(cand->name, "$")) continue;
            if (!cold_call_args_match(parser->symbols, body, cand, arg_start, 1)) continue;
            if (!span_same(span_trim(cand->param_type[0]), operand_type)) continue;
            if (fn_index >= 0 &&
                cold_fn_decl_same_physical_origin(&parser->symbols->functions[fn_index], cand)) {
                /* Same physical `fn $` reopened under a different import
                   alias (diamond import) -- not a second candidate. */
                continue;
            }
            exact_matches++;
            if (exact_matches > 1) {
                cold_die_ambiguous_dollar_call(parser, operand_expr,
                    "multiple `$` overloads declare the identical operand type");
            }
            fn_index = i;
        }
    }
    if (fn_index < 0) {
        /* No exact declared-type-text candidate (operand slot has no type
           span, e.g. an anonymous intermediate expression, or the matching
           overload's param type is spelled differently from the operand's
           declared type though still kind-compatible). Fall back to the
           loose SLOT-kind scan, but only commit if it is unambiguous --
           first-match-wins here would reintroduce the exact bug this
           disambiguation closes. */
        int32_t loose_matches = 0;
        for (int32_t i = 0; i < parser->symbols->function_count; i++) {
            FnDef *cand = &parser->symbols->functions[i];
            if (cand->arity != 1 || !cold_span_ends_with(cand->name, "$")) continue;
            if (!cold_call_args_match(parser->symbols, body, cand, arg_start, 1)) continue;
            if (fn_index >= 0 &&
                cold_fn_decl_same_physical_origin(&parser->symbols->functions[fn_index], cand)) {
                continue;
            }
            loose_matches++;
            if (loose_matches > 1) {
                cold_die_ambiguous_dollar_call(parser, operand_expr,
                    "no exact declared-type match and multiple SLOT-kind-compatible overloads");
            }
            fn_index = i;
        }
    }
    if (fn_index < 0) {
        fprintf(stderr, "cheng_cold: ");
        cold_error_loc(parser, operand_expr);
        fprintf(stderr, " no `$` stringify operator overload for operand '%.*s'\n",
                (int)operand_expr.len, operand_expr.ptr);
        cold_print_context(parser, operand_expr);
        die("unresolved $ stringify operator");
    }
    fn_index = cold_ensure_specialized_unifying_i32_seq_literals(parser->symbols, fn_index, body, arg_start, 1, 0, 0);
    FnDef *fn = &parser->symbols->functions[fn_index];
    cold_materialize_specialized_body_if_needed(parser, fn_index);
    fn = &parser->symbols->functions[fn_index];
    cold_materialize_exact_scalar_ref_value_call_args(
        body, parser->symbols, fn, arg_start, 1);
    cold_materialize_exact_plain_borrow_value_call_args(
        parser, body, parser->symbols, fn, arg_start, 1);
    cold_reject_borrowed_actuals_at_resolved_call_boundary(
        body, parser->symbols, fn_index, fn, arg_start, 1);
    int32_t var_out_local_indices[COLD_MAX_I32_PARAMS];
    int32_t var_out_carrier_ops[COLD_MAX_I32_PARAMS];
    int32_t var_out_root_place_ids[COLD_MAX_I32_PARAMS];
    ColdVarPlaceTable var_place_table;
    memset(&var_place_table, 0, sizeof(var_place_table));
    for (int32_t i = 0; i < COLD_MAX_I32_PARAMS; i++) {
        var_out_local_indices[i] = -1;
        var_out_carrier_ops[i] = -1;
        var_out_root_place_ids[i] = -1;
    }
    cold_reparse_field_call_args_as_refs(
        parser, body, locals, fn,
        arg_start, 1, arg_exprs,
        var_out_local_indices, var_out_carrier_ops,
        &var_place_table, var_out_root_place_ids);
    cold_apply_contextual_empty_sequence_args(body, parser->symbols, fn, arg_start, 1, true);
    cold_materialize_global_ref_call_args(body, fn, arg_start, 1);
    cold_materialize_exact_abi_pointer_ref_object_call_args(
        body, parser->symbols, fn, arg_start, 1);
    cold_materialize_exact_abi_pointer_ref_object_move_call_args(
        body, parser->symbols, fn, arg_start, 1);
    cold_materialize_exact_abi_pointer_string_call_args(
        body, parser->symbols, fn, arg_start, 1);
    cold_coerce_jsonnode_args(parser, body, fn, arg_start, 1);
    if (!cold_validate_call_args(parser->symbols, body, fn, arg_start, 1, parser->import_mode)) {
        cold_die_call_arg_mismatch(parser, dollar_name, body, fn, arg_start, 1);
    }
    int32_t ret_kind =
        cold_function_return_kind(
            parser->symbols, fn);
    int32_t slot = body_slot(
        body, ret_kind,
        cold_function_return_slot_size(
            parser->symbols, fn, ret_kind));
    cold_call_result_slot_set_type(
        body, parser->symbols, slot, ret_kind, fn->ret);
    bool has_composite = (ret_kind != SLOT_I32 && ret_kind != SLOT_I64 &&
                          ret_kind != SLOT_F32 && ret_kind != SLOT_F64 &&
                          ret_kind != SLOT_PTR && ret_kind != SLOT_OPAQUE) ||
                         (fn->param_kind[0] != SLOT_I32 && fn->param_kind[0] != SLOT_I64 &&
                          fn->param_kind[0] != SLOT_F32 && fn->param_kind[0] != SLOT_F64 &&
                          fn->param_kind[0] != SLOT_PTR && fn->param_kind[0] != SLOT_OPAQUE);
    if (fn->param_exact_type_id[0] >= 0) {
        has_composite = true;
    }
    cold_materialize_exact_borrow_call_args(
        body, parser->symbols, fn, arg_start, 1);
    int32_t call_op = !has_composite
        ? body_op(
              body, BODY_OP_CALL_I32,
              slot, fn_index, arg_start)
        : body_op3(
              body, BODY_OP_CALL_COMPOSITE,
              slot, fn_index, arg_start, 1);
    int32_t temporary_cleanup_sources[
        COLD_MAX_I32_PARAMS];
    int32_t temporary_cleanup_count =
        cold_prepare_exact_call_arg_transfers(
        parser, body, parser->symbols, fn,
        call_op, arg_start, 1,
        temporary_cleanup_sources,
        COLD_MAX_I32_PARAMS);
    ColdExprResult call_result;
    cold_finish_exact_call_postlude(
        parser, body, parser->symbols,
        locals, fn, call_op, arg_start, 1,
        slot, ret_kind, &call_result,
        var_out_local_indices,
        var_out_carrier_ops,
        &var_place_table,
        var_out_root_place_ids,
        temporary_cleanup_sources,
        temporary_cleanup_count);
    *kind_out = ret_kind;
    return slot;
}

static int32_t cold_materialize_const_value(Parser *parser, BodyIR *body,
                                            const ConstDef *constant,
                                            int32_t *kind_out) {
    (void)parser;
    if (!constant) die("cold const materialization requires definition");
    if (constant->kind == SLOT_STR) {
        int32_t literal_index = body_string_literal(body, constant->str_val);
        int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
        body_slot_set_type(body, slot, cold_cstr_span("str"));
        int32_t producer =
            body_op(body, BODY_OP_STR_LITERAL, slot, literal_index, 0);
        cold_publish_plain_string_literal_producer(
            body, slot, producer, 0);
        *kind_out = SLOT_STR;
        return slot;
    }
    Span scalar_type = {0};
    if (constant->kind == SLOT_I32 || constant->kind == SLOT_I64 ||
        constant->kind == SLOT_F32 || constant->kind == SLOT_F64) {
        scalar_type = cold_scalar_tag_type(constant->scalar_tag);
        if (scalar_type.len <= 0 ||
            cold_scalar_tag_kind(constant->scalar_tag) != constant->kind)
            die("cold const scalar tag/kind mismatch");
    }
    if (constant->kind == SLOT_I32) {
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_slot_set_type(body, slot, scalar_type);
        body_op(body, BODY_OP_I32_CONST, slot,
                (int32_t)(uint32_t)constant->scalar_bits, 0);
        *kind_out = SLOT_I32;
        return slot;
    }
    if (constant->kind == SLOT_I64) {
        int32_t slot = cold_make_i64_const_slot(body,
                                                (int64_t)constant->scalar_bits);
        body_slot_set_type(body, slot, scalar_type);
        *kind_out = SLOT_I64;
        return slot;
    }
    if (constant->kind == SLOT_F32) {
        int32_t slot = body_slot(body, SLOT_F32, 4);
        body_slot_set_type(body, slot, scalar_type);
        body_op(body, BODY_OP_F32_CONST, slot,
                (int32_t)(uint32_t)constant->scalar_bits, 0);
        *kind_out = SLOT_F32;
        return slot;
    }
    if (constant->kind == SLOT_F64) {
        int32_t slot = body_slot(body, SLOT_F64, 8);
        body_slot_set_type(body, slot, scalar_type);
        body_op3(body, BODY_OP_F64_CONST, slot,
                 (int32_t)(uint32_t)constant->scalar_bits,
                 (int32_t)(uint32_t)(constant->scalar_bits >> 32), 0);
        *kind_out = SLOT_F64;
        return slot;
    }
    die("cold const kind unsupported");
    return -1;
}

int32_t parse_primary(Parser *parser, BodyIR *body, Locals *locals, int32_t *kind) {
    Span token = parser_token(parser);
    if (token.len == 0) {
        /* Empty expression: return 0 */
        int32_t zero = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
        *kind = SLOT_I32;
        return zero;
    }
    if (span_eq(token, "(")) {
        ColdExprResult inner_result;
        int32_t inner_slot = cold_parse_expr_with_result(
            parser, body, locals, kind, &inner_result);
        if (!parser_take(parser, ")")) return 0; /* skip malformed expr */;
        cold_expr_result_publish(body, &inner_result);
        return inner_slot;
    }
    if (span_eq(token, "*")) {
        if (span_eq(parser_peek(parser), "(")) {
            (void)parser_token(parser);
            Span ptr_expr = parser_take_until_top_level_char(parser, ')',
                                                            "expected ) in pointer deref");
            if (!parser_take(parser, ")")) die("expected ) in pointer deref");
            return cold_parse_pointer_deref_expr(parser, body, locals, ptr_expr, kind);
        }
        int32_t ptr_kind = SLOT_PTR;
        int32_t ptr_slot = parse_primary(parser, body, locals, &ptr_kind);
        ptr_slot = parse_postfix(parser, body, locals, ptr_slot, &ptr_kind);
        /* #136-v3 root fix (base-address consumption channel, third gate):
           the bare `*ptr` primary form (as opposed to the explicit-paren
           `*(ptr)` form a few lines above, which already goes through
           cold_parse_pointer_deref_expr's own materialize) fed ptr_slot
           straight into cold_emit_pointer_load below with no dereference
           hop at all -- for a bare global `T*` (e.g. `*gBoxPtr` inside
           `(*gBoxPtr).n`) ptr_slot/ptr_kind coming out of parse_primary+
           parse_postfix is still the raw BODY_OP_GLOBAL_ADDR shadow
           (&gBoxPtr, kind SLOT_OPAQUE_REF -- itself pointer-like per
           cold_kind_is_pointer_like, so the guard below never caught it),
           so cold_emit_pointer_load read/wrote through the pointer
           variable's own storage address instead of its target. Mirrors
           cold_parse_pointer_deref_expr's existing materialize call
           (cold_parser.c, a few hundred lines below) so both spellings of
           an explicit dereference behave identically; a no-op for local/
           param pointers and genuine ABI-view SLOT_OPAQUE_REF values via
           cold_parser_slot_is_global_addr's guard inside
           cold_materialize_global_ref_value. */
        ptr_slot = cold_materialize_global_ref_value(body, ptr_slot, &ptr_kind);
        if (!cold_kind_is_pointer_like(ptr_kind)) {
            fprintf(stderr,
                    "cheng_cold: pointer deref non-pointer kind=%d type=%.*s body=%.*s\n",
                    ptr_kind,
                    ptr_slot >= 0 && ptr_slot < body->slot_count
                        ? (int)body->slot_type[ptr_slot].len : 0,
                    ptr_slot >= 0 && ptr_slot < body->slot_count
                        ? body->slot_type[ptr_slot].ptr : (const uint8_t *)"",
                    body && body->debug_name.len > 0 ? (int)body->debug_name.len : 0,
                    body && body->debug_name.len > 0 ? body->debug_name.ptr : (const uint8_t *)"");
            /* Skip — non-pointer deref, return zero instead of dying. */
            int32_t zero = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
            *kind = SLOT_I32;
            return zero;
        }
        return cold_emit_pointer_load(parser, body, ptr_slot, kind);
    }
    if (span_eq(token, "if")) {
        return parse_if_expr(parser, body, locals, kind);
    }
    if (span_eq(token, "!")) {
        int32_t value_kind = SLOT_I32;
        int32_t value_slot = parse_primary(parser, body, locals, &value_kind);
        value_slot = parse_postfix(parser, body, locals, value_slot, &value_kind);
        if (value_kind == SLOT_I32_REF) {
            int32_t loaded = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_REF_LOAD, loaded, value_slot, 0);
            value_slot = loaded;
            value_kind = SLOT_I32;
        }
        if (value_kind != SLOT_I32) die("! expects bool/int32");
        int32_t zero = body_slot(body, SLOT_I32, 4);
        int32_t dst = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
        body_op3(body, BODY_OP_I32_CMP, dst, value_slot, zero, COND_EQ);
        body_slot_set_type(body, dst, cold_cstr_span("bool"));
        *kind = SLOT_I32;
        return dst;
    }
    if (span_eq(token, "-")) {
        int32_t vk = SLOT_I32, vs = parse_primary(parser, body, locals, &vk);
        vs = parse_postfix(parser, body, locals, vs, &vk);
        /* body_slot() unconditionally zeroes a new slot's type marker
           (cheng_cold.c body_slot()); the two REF materializations below and
           the two SUB results further down all allocate fresh slots, so
           without re-propagating the uint8/16/32/64 marker from the
           pre-negation operand, `-n` for a `var uint32`/`var uint64` (or a
           uint64(...) cast) silently takes the signed path in any downstream
           cold_slot_type_is_uint32/64 consumer (float64 mix, compare) --
           same family as #143/#144, mirrors cold_materialize_i32_ref /
           cold_materialize_i64_value's body_slot_set_type(dst,
           body->slot_type[slot]) idiom. */
        if (vk == SLOT_I32_REF) { int32_t l = body_slot(body, SLOT_I32, 4); body_op(body, BODY_OP_I32_REF_LOAD, l, vs, 0); body_slot_set_type(body, l, body->slot_type[vs]); vs = l; vk = SLOT_I32; }
        if (vk == SLOT_I32 || vk == SLOT_OPAQUE || vk == SLOT_OPAQUE_REF) {
            int32_t z = body_slot(body, SLOT_I32, 4), d = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, z, 0, 0); body_op3(body, BODY_OP_I32_SUB, d, z, vs, 0);
            if (cold_slot_type_is_uint32(body, vs)) body_slot_set_type(body, d, body->slot_type[vs]);
            *kind = SLOT_I32; return d;
        }
        if (vk == SLOT_I64 || vk == SLOT_I64_REF) {
            if (vk == SLOT_I64_REF) { int32_t l = body_slot(body, SLOT_I64, 8); body_op(body, BODY_OP_PTR_LOAD_I64, l, vs, 0); body_slot_set_type(body, l, body->slot_type[vs]); vs = l; }
            int32_t z = body_slot(body, SLOT_I64, 8), d = body_slot(body, SLOT_I64, 8);
            body_op(body, BODY_OP_I64_CONST, z, 0, 0); body_op3(body, BODY_OP_I64_SUB, d, z, vs, 0);
            if (cold_slot_type_is_uint64(body, vs)) body_slot_set_type(body, d, body->slot_type[vs]);
            *kind = SLOT_I64; return d;
        }
        if (vk == SLOT_F64) {
            int32_t zero = body_slot(body, SLOT_F64, 8);
            body_op3(body, BODY_OP_F64_CONST, zero, 0, 0, 0);
            int32_t d = body_slot(body, SLOT_F64, 8);
            body_op(body, BODY_OP_F64_SUB, d, zero, vs);
            *kind = SLOT_F64; return d;
        }
        die("- expects int32 or int64");
    }
    if (span_eq(token, "$")) {
        int32_t operand_start = parser->pos;
        int32_t vk = SLOT_I32;
        int32_t vs = parse_primary(parser, body, locals, &vk);
        vs = parse_postfix(parser, body, locals, vs, &vk);
        Span operand_expr = span_trim(span_sub(parser->source, operand_start, parser->pos));
        int32_t ret_kind = SLOT_STR;
        int32_t result = cold_emit_dollar_call(parser, body, locals, vs, operand_expr, &ret_kind);
        *kind = ret_kind;
        return result;
    }
    if (span_eq(token, "&")) {
        /* address-of: parse base local, then handle .field chain with FIELD_REF.
           Also handles &fnName (function pointer). */
        Span base_name = parser_token(parser);
        Local *alocal = locals_find(locals, base_name);
        int32_t addr_slot;
        bool addr_is_global = false;
        if (alocal) {
            if (alocal->is_global) {
                GlobalDef *global = parser_find_global(parser, base_name);
                if (!global) die("global address shadow missing");
                alocal = locals_add_global_shadow(parser, body, locals, base_name, global);
                addr_is_global = true;
            }
            cold_require_local_exact_value_available(
                parser, body, alocal, base_name);
            addr_slot = alocal->slot;
            *kind = alocal->kind;
        } else {
            GlobalDef *global = parser_find_global(parser, base_name);
            if (global) {
                alocal = locals_add_global_shadow(parser, body, locals, base_name, global);
                if (!alocal) die("global address shadow creation failed");
                addr_slot = alocal->slot;
                *kind = alocal->kind;
                addr_is_global = true;
            } else {
            /* Check if it's a function name: &fnName → function pointer */
            Span lookup_fn_name = parser_can_scope_bare_name(parser, base_name)
                                      ? parser_scoped_bare_name(parser, base_name)
                                      : base_name;
            int32_t fn_idx = -1;
            for (int32_t si = 0; si < parser->symbols->function_count; si++) {
                FnDef *sfn = &parser->symbols->functions[si];
                if (span_same(sfn->name, lookup_fn_name)) { fn_idx = si; break; }
            }
            if (fn_idx >= 0) {
                addr_slot = body_slot(body, SLOT_PTR, 8);
                body_op(body, BODY_OP_FN_ADDR, addr_slot, fn_idx, 0);
                /* #105 root fix: carry the referenced function's own real
                   signature as this slot's declared type, so a wrong-
                   signature callback passed via &fnName is caught by
                   cold_fn_typed_arg_matches instead of only matching on
                   the coarse SLOT_PTR kind. */
                body_slot_set_type(body, addr_slot,
                                   cold_fn_own_signature_text(parser->symbols,
                                                              &parser->symbols->functions[fn_idx]));
                *kind = SLOT_PTR;
                return addr_slot;
            }
            /* Not a local or function: parse as expression and compute SP-relative address */
            int32_t ek = SLOT_I32;
            int32_t es = parse_primary(parser, body, locals, &ek);
            if (ek != SLOT_PTR && ek != SLOT_OBJECT_REF) ek = SLOT_PTR;
            addr_slot = body_slot(body, SLOT_PTR, 8);
            body_op3(body, BODY_OP_FIELD_REF, addr_slot, es, 0, 0);
            *kind = SLOT_PTR;
            return addr_slot;
            }
        }
        /* &a[k] : address of a fixed-array element. The .field chain below only
           consumes `.field`/`->`; a following `[index]` subscript was silently
           dropped, degrading &a[k] to &a (base) and losing k (both the address-of
           and the index). Compute the element address base + k*elemSize via
           ARRAY_OPAQUE_INDEX_REF_DYNAMIC (which handles a SLOT_ARRAY_I32 local's
           stack base and a SLOT_OBJECT_REF global pointer alike), mirroring the
           read path and ARRAY_I32_INDEX_STORE's OBJECT_REF base. */
        if (span_eq(parser_peek(parser), "[") &&
            (*kind == SLOT_ARRAY_I32 ||
             (*kind == SLOT_OBJECT_REF &&
              cold_parse_any_fixed_array_type(parser->symbols,
                                              body->slot_type[addr_slot], 0, 0)))) {
            Span aidx = parse_index_bracket(parser);
            Span element_type = {0};
            int32_t array_len = 0;
            if (!cold_parse_any_fixed_array_type(parser->symbols, body->slot_type[addr_slot],
                                                 &element_type, &array_len))
                die("address-of fixed array element type missing");
            int32_t element_size = cold_fixed_array_element_size(parser->symbols,
                                                                 body->slot_type[addr_slot]);
            if (element_size <= 0) die("address-of fixed array element size missing");
            if (body->slot_aux[addr_slot] <= 0)
                body_slot_set_array_len(body, addr_slot, array_len);
            int32_t aik = SLOT_I32, ais;
            if (span_is_i32(aidx)) {
                ais = body_slot(body, SLOT_I32, 4);
                body_op(body, BODY_OP_I32_CONST, ais, span_i32(aidx), 0);
            } else {
                Parser aip = parser_child(parser, aidx);
                ais = parse_expr(&aip, body, locals, &aik);
                ais = cold_materialize_i32_ref(body, ais, &aik);
                if (aik != SLOT_I32) die("address-of fixed array index must be int32");
            }
            int32_t elem_ref = body_slot(body, SLOT_PTR, 8);
            body_slot_set_type(
                body, elem_ref,
                cold_arena_join3(
                    body->arena, element_type, "",
                    cold_cstr_span("*")));
            body_op3(body, BODY_OP_ARRAY_OPAQUE_INDEX_REF_DYNAMIC, elem_ref,
                     addr_slot, ais, element_size);
            *kind = SLOT_PTR;
            return elem_ref;
        }
        /* Process .field chain manually with FIELD_REF */
        bool saw_field = false;
        Span prev_hop_field_type = {0};
        ColdExprResult address_base_authority;
        cold_expr_result_reset(&address_base_authority);
        while (true) {
            bool field_arrow = false;
            if (span_eq(parser_peek(parser), ".")) {
                (void)parser_token(parser);
            } else if (span_eq(parser_peek(parser), "-")) {
                int32_t saved = parser->pos;
                (void)parser_token(parser);
                if (!span_eq(parser_peek(parser), ">")) {
                    parser->pos = saved;
                    break;
                }
                (void)parser_token(parser);
                field_arrow = true;
            } else {
                break;
            }
            Span fname = parser_token(parser);
            if (fname.len <= 0) die("expected field name after &");
            ObjectDef *aobj = 0;
            if (body->slot_type[addr_slot].len > 0) {
                aobj = symbols_resolve_object(parser->symbols, body->slot_type[addr_slot]);
                if (!aobj || field_arrow)
                    aobj = cold_resolve_pointer_object(parser->symbols, body->slot_type[addr_slot]);
            }
            if (!aobj) {
                /* Try finding object by field name */
                for (int32_t oi = 0; oi < parser->symbols->object_count; oi++) {
                    ObjectDef *cand = &parser->symbols->objects[oi];
                    if (object_find_field(cand, fname)) { aobj = cand; break; }
                }
            }
            if (!aobj) die("unknown object for address-of field access");
            ObjectField *afield = object_find_field(aobj, fname);
            if (!afield) die("unknown field in address-of");
            if (!saw_field) {
                /* `a: var RefObject` is an address carrier for the caller's
                   handle.  `&a.field` must first load that exact handle and
                   then add the field offset; adding the offset to the carrier
                   itself addresses the caller's handle cell and makes atomic
                   field operations read pointer bits.  The materializer
                   performs this load only for an exact var ref-object
                   parameter and preserves ordinary local/global behavior. */
                ColdExprResult materialized_base;
                cold_expr_result_reset(&materialized_base);
                cold_expr_result_reset(&address_base_authority);
                if (alocal && alocal->value_def_op_id >= 0 &&
                    !cold_exact_result_from_definition(
                        body, addr_slot,
                        alocal->value_def_op_id,
                        &address_base_authority)) {
                    die("address-of base definition is not exact");
                }
                addr_slot = cold_materialize_var_param_place_base(
                    parser, body, addr_slot, kind,
                    address_base_authority.value_def_op_id >= 0
                        ? &address_base_authority : 0,
                    &materialized_base);
                if (materialized_base.value_def_op_id >= 0)
                    address_base_authority = materialized_base;
                /* #142 root fix: on the *first* hop only, addr_slot still
                   carries whatever kind the base variable itself has, which
                   for a raw T* (global shadow, or a plain by-value local/param
                   pointer) is SLOT_OPAQUE_REF or SLOT_OPAQUE -- never
                   SLOT_OBJECT_REF/SLOT_PTR/SLOT_OBJECT, the only three kinds
                   BODY_OP_FIELD_REF's codegen (both arm64 and x64) actually
                   knows how to consume as a base. Left as-is, FIELD_REF fell
                   into the "else" branch, which computes &(addr_slot's own
                   stack cell) instead of the address addr_slot's value points
                   to -- for a global shadow that's the address of the shadow
                   local itself (stack-relative, hence non-deterministic
                   across runs under ASLR); for a plain pointer param/local
                   it's a deterministic but still-wrong fixed offset from the
                   real target. Two distinct sub-cases, two distinct fixes,
                   same first-hop site:
                   1) SLOT_OPAQUE_REF sourced from BODY_OP_GLOBAL_ADDR (a raw
                      global T*): the slot holds &globalVar (the storage
                      cell's own address), not the pointer value stored in
                      it -- a real second load is required. Reuse the existing
                      cold_materialize_global_ref_value primitive (the same
                      one #136 v1-v3 already applies at the `->` postfix read,
                      the `*ptr` bare-deref read, and the field-assign write
                      dispatch points) instead of inventing new dereference
                      logic; its cold_parser_slot_is_global_addr guard is a
                      structural no-op for every other origin, so it cannot
                      double-materialize an already-correct value.
                   2) SLOT_OPAQUE (a by-value T* param/local, e.g.
                      `p: Thing8*`): the slot's value already *is* the real
                      pointer -- no load needed, only a kind mislabel. Relabel
                      it into a fresh SLOT_PTR-kind slot via BODY_OP_COPY_I64
                      (a plain value copy, mirrors the `base_slot`
                      re-kind-to-SLOT_OBJECT_REF idiom parse_field_assign uses
                      for the very same reason) so FIELD_REF's existing,
                      unmodified dispatch recognizes it. */
                addr_slot = cold_materialize_global_ref_value(body, addr_slot, kind);
                if (*kind == SLOT_OPAQUE) {
                    int32_t xslot = body_slot(body, SLOT_PTR, 8);
                    body_slot_set_type(body, xslot, body->slot_type[addr_slot]);
                    body_op(body, BODY_OP_COPY_I64, xslot, addr_slot, 0);
                    addr_slot = xslot;
                    *kind = SLOT_PTR;
                }
            } else if (cold_type_has_pointer_suffix(prev_hop_field_type)) {
                /* #142-v2 root fix: this is not the first hop, and the field
                   consumed by the *previous* hop (prev_hop_field_type) is
                   itself a pointer type -- e.g. `leaf: Leaf142*` in the
                   two-arrow chain `gMid142Ptr->leaf->v`. addr_slot right now
                   is `ref_slot` from that previous hop's FIELD_REF: &(prev
                   Struct.prevField), the address of the pointer FIELD'S OWN
                   storage cell, not the pointer VALUE stored in it. The
                   `if (!saw_field)` guard above only ever materializes the
                   *first* hop's base variable; every hop after that was fed
                   straight into FIELD_REF as-is, an assumption that only
                   holds when the field just consumed is a value-type nested
                   struct (embedded storage, so its own address already *is*
                   the correct next base -- no load needed; this is why the
                   already-verified `->`+`.` mixed chain in pv5_chain.cheng
                   was never affected). For a genuine `->`-into-`->` chain
                   (two consecutive real pointer hops) the missing load
                   produced a confirmed silent wrong value: FIELD_REF(
                   addr_slot, next_offset) computed &(prevStruct.prevField)
                   + next_offset -- still inside the *previous* struct,
                   never touching the pointee the second `->` was meant to
                   reach (136v3/v_a.md REFUTED finding:
                   `&gMid142Ptr->leaf->v` returned `&gMid142` itself, not
                   the leaf's address). A real second load is required here,
                   mirroring parse_postfix's read-path `->` handling
                   (this file, the arrow branch inside its postfix loop):
                   that path never has this bug because every hop is a full
                   PAYLOAD_LOAD of the field's actual value, never a bare
                   address computation deferred to the next hop. This branch
                   performs that same load, but only *between* hops -- never
                   on the terminal hop, since the loop simply does not run
                   another iteration after the last field, correctly leaving
                   &lastField as the field's own address rather than
                   dereferencing into whatever it points to.
                   BODY_OP_PTR_LOAD_I64 is the same primitive
                   cold_materialize_global_ref_value uses for its own
                   pointer-value load; it is not reused directly here
                   because that helper's no-op guard
                   (cold_parser_slot_is_global_addr) only recognizes a
                   BODY_OP_GLOBAL_ADDR-defined slot, never the
                   BODY_OP_FIELD_REF-defined addr_slot in play here. */
                int32_t loaded = body_slot(body, SLOT_PTR, 8);
                body_slot_set_type(body, loaded, prev_hop_field_type);
                body_op(body, BODY_OP_PTR_LOAD_I64, loaded, addr_slot, 0);
                addr_slot = loaded;
                *kind = SLOT_PTR;
            }
            int32_t ref_slot = body_slot(body, SLOT_PTR, 8);
            body_slot_set_type(
                body, ref_slot,
                cold_arena_join3(
                    body->arena,
                    span_trim(afield->type_name), "",
                    cold_cstr_span("*")));
            int32_t field_projection = body_op3(
                body, BODY_OP_FIELD_REF,
                ref_slot, addr_slot, afield->offset, 0);
            if (!saw_field &&
                address_base_authority.value_def_op_id >= 0 &&
                address_base_authority.slot == addr_slot) {
                cold_expr_scalar_projection_borrow_root_publish(
                    parser, body, parser->symbols,
                    &address_base_authority,
                    field_projection);
            } else {
                cold_publish_scalar_borrow_projection_from_operand(
                    body, parser->symbols,
                    field_projection, addr_slot);
            }
            addr_slot = ref_slot;
            *kind = SLOT_PTR;
            saw_field = true;
            prev_hop_field_type = afield->type_name;
        }
        /* `&p->field[k]` / `&a.field[k]`: a trailing subscript after the
           arrow/dot chain.  The chain above only consumes `.field`/`->field`
           hops and leaves addr_slot as the address of the terminal field;
           when that field is an embedded fixed array (prev_hop_field_type),
           the subscript must produce the element address (array field
           address + k*elemSize), mirroring the no-hop `&a[k]` case above --
           dropping the subscript degrades the result to the array's base
           address and loses k entirely. */
        while (saw_field && span_eq(parser_peek(parser), "[")) {
            Span aidx = parse_index_bracket(parser);
            Span element_type = {0};
            int32_t array_len = 0;
            if (!cold_parse_any_fixed_array_type(
                    parser->symbols, prev_hop_field_type,
                    &element_type, &array_len) ||
                element_type.len <= 0 || array_len <= 0)
                die("address-of field array layout missing");
            int32_t element_size = cold_fixed_array_element_size(
                parser->symbols, prev_hop_field_type);
            if (element_size <= 0)
                die("address-of field array element size missing");
            if (body->slot_aux[addr_slot] <= 0)
                body_slot_set_array_len(body, addr_slot, array_len);
            int32_t aik = SLOT_I32, ais;
            if (span_is_i32(aidx)) {
                ais = body_slot(body, SLOT_I32, 4);
                body_op(body, BODY_OP_I32_CONST, ais, span_i32(aidx), 0);
            } else {
                Parser aip = parser_child(parser, aidx);
                ais = parse_expr(&aip, body, locals, &aik);
                ais = cold_materialize_i32_ref(body, ais, &aik);
                if (aik != SLOT_I32)
                    die("address-of field array index must be int32");
            }
            ObjectDef *element_object =
                symbols_resolve_object(
                    parser->symbols, element_type);
            /* The result is physically a pointer, so retain the `*` in its
               canonical type spelling even for scalar elements.  A pointer
               into a POD aggregate still has UNKNOWN managed storage, but it
               is a lifetime projection of the aggregate's exact definition;
               that root lives on the producer source edge below.  Only a
               managed element keeps the separate nominal alias-carrier
               definition used by managed local binding. */
            bool element_managed =
                element_object &&
                (element_object->is_ref ||
                 cold_type_requires_managed_drop(
                     parser->symbols, element_type, 0));
            int32_t elem_ref = body_slot(body, SLOT_PTR, 8);
            body_slot_set_type(
                body, elem_ref,
                cold_arena_join3(
                    parser->arena, element_type, "",
                    cold_cstr_span("*")));
            int32_t elem_op =
                body_op3(body, BODY_OP_ARRAY_OPAQUE_INDEX_REF_DYNAMIC,
                         elem_ref, addr_slot, ais, element_size);
            if (element_managed) {
                /* Publish the raw-address PLAIN temporary -- the same
                   shape an alias-pointer constructor result carries, so a
                   following `let` can bind it through the ordinary managed
                   move path.  cold_exact_managed_type_id cannot derive the
                   id from the element spelling itself, so compute the
                   canonical object-row projection directly (mirrors its
                   object branch formula). */
                int32_t object_row =
                    cold_canonical_object_identity(
                        parser->symbols,
                        (int32_t)(element_object -
                                  parser->symbols->objects));
                if (object_row < 0 ||
                    object_row >= parser->symbols->object_count ||
                    object_row >= 1048575)
                    die("address-of object array element identity invalid");
                int32_t exact_type_id =
                    SLOT_OBJECT_REF * 1048576 + object_row + 1;
                body->op_value_def_slot[elem_op] = elem_ref;
                body->op_value_def_exact_type_id[elem_op] =
                    exact_type_id;
                body->op_value_def_producer_function_row[elem_op] =
                    body->producer_function_row;
                body->op_value_def_place_kind[elem_op] =
                    COLD_EXPR_PLACE_TEMPORARY;
                body->op_value_def_ownership[elem_op] =
                    COLD_EXPR_OWN_PLAIN;
                body->op_value_def_origin_id[elem_op] = elem_op;
                body->slot_exact_type_id[elem_ref] = exact_type_id;
                body->slot_place_kind[elem_ref] =
                    COLD_EXPR_PLACE_TEMPORARY;
                body->slot_origin_id[elem_ref] = elem_op;
                body->slot_managed_storage_kind[elem_ref] = COLD_MANAGED_STORAGE_PLAIN;
                ColdExprResult elem_result;
                cold_expr_result_reset(&elem_result);
                elem_result.slot = elem_ref;
                elem_result.kind = SLOT_PTR;
                elem_result.value_def_op_id = elem_op;
                elem_result.exact_type_id = exact_type_id;
                elem_result.producer_function_row =
                    body->producer_function_row;
                elem_result.place_kind = COLD_EXPR_PLACE_TEMPORARY;
                elem_result.ownership = COLD_EXPR_OWN_PLAIN;
                elem_result.origin_id = elem_op;
                cold_expr_result_publish(body, &elem_result);
            } else {
                cold_publish_scalar_borrow_projection_from_operand(
                    body, parser->symbols,
                    elem_op, addr_slot);
            }
            addr_slot = elem_ref;
            *kind = SLOT_PTR;
            prev_hop_field_type = element_type;
        }
        if (!saw_field && !addr_is_global) {
            int32_t ref_slot = body_slot(body, SLOT_PTR, 8);
            Span source_type =
                addr_slot >= 0 && addr_slot < body->slot_count
                    ? span_trim(body->slot_type[addr_slot])
                    : (Span){0};
            body_slot_set_type(
                body, ref_slot,
                source_type.len > 0
                    ? cold_arena_join3(
                          body->arena, source_type, "",
                          cold_cstr_span("*"))
                    : cold_cstr_span("ptr"));
            body_op(body, BODY_OP_LOCAL_ADDR, ref_slot, addr_slot, 0);
            *kind = SLOT_PTR;
            return ref_slot;
        }
        if (!saw_field && addr_is_global) {
            /* `&global` is an address VALUE, not a pending value-load: the
               bare global shadow slot keeps its *_REF (deferred-load) kind,
               which is the exact same shape a plain global rvalue read
               carries into consumers like ptr().  Copy the address into a
               fresh SLOT_PTR slot so the two intents stay distinguishable
               (ptr(&g) = address passthrough, ptr(g) = load the stored
               value). */
            int32_t ref_slot = body_slot(body, SLOT_PTR, 8);
            if (addr_slot >= 0 && addr_slot < body->slot_count &&
                body->slot_type[addr_slot].len > 0) {
                body_slot_set_type(
                    body, ref_slot,
                    cold_arena_join3(
                        body->arena,
                        span_trim(body->slot_type[addr_slot]),
                        "",
                        cold_cstr_span("*")));
            }
            body_op(body, BODY_OP_COPY_I64, ref_slot, addr_slot, 0);
            *kind = SLOT_PTR;
            return ref_slot;
        }
        return addr_slot;
    }
    if (span_eq(token, "[")) {
        return parse_i32_array_literal(parser, body, locals, kind);
    }
    if (token.len >= 2 && token.ptr[0] == '"' && token.ptr[token.len - 1] == '"') {
        Span content = cold_triple_string_content(parser->arena, token);
        int32_t slot = cold_make_str_literal_slot_mode(parser, body,
                                                       content,
                                                       false,
                                                       cold_token_is_triple_string(token));
        *kind = SLOT_STR;
        return slot;
    }
    if (token.len >= 3 && token.ptr[0] == '\'' && token.ptr[token.len - 1] == '\'') {
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, slot, cold_decode_char_literal(token), 0);
        *kind = SLOT_I32;
        return slot;
    }
    if (span_eq(token, "Fmt")) {
        return parse_fmt_literal(parser, body, locals, kind);
    }
    if (span_eq(token, "share") && span_eq(parser_peek(parser), "(")) {
        (void)parser_token(parser);
        ColdExprResult source_result;
        int32_t source_kind = SLOT_I32;
        int32_t source_slot = cold_parse_expr_with_result(
            parser, body, locals, &source_kind, &source_result);
        if (!parser_take(parser, ")")) {
            die("share(value) requires one exact managed value expression");
        }
        int32_t source_storage =
            COLD_MANAGED_STORAGE_UNKNOWN;
        bool owner_source =
            source_result.ownership == COLD_EXPR_OWN_PLAIN ||
            source_result.ownership == COLD_EXPR_OWN_MOVE;
        /* Spec 0.2.1 escape rule: share(x) never accepts a unique `var`
           borrow.  A var formal reaches this surface in two physical
           shapes: the borrow cell itself (ownership BORROW_UNIQUE, e.g.
           a `var str` formal) and the proven whole-cell handle projection
           of a `var` ref-object formal (BORROW_SHARED view whose root is
           the unique PARAM cell).  Reject both here with the semantic
           diagnostic instead of letting the ref-cell kind leak into the
           shared-copy emitter, whose kind/projection dies are misleading
           for this surface error. */
        if (source_result.ownership ==
                COLD_EXPR_OWN_BORROW_UNIQUE ||
            cold_exact_managed_param_ref_object_value_projection(
                body, parser->symbols, &source_result)) {
            die("share(value) rejects a var-borrowed source: a unique "
                "`var` borrow cannot be shared; share the owned value "
                "outside the borrow or copy it explicitly");
        }
        bool borrowed_source =
            source_result.ownership ==
                COLD_EXPR_OWN_BORROW_SHARED;
        bool exact_source =
            source_result.slot == source_slot &&
            source_result.kind == source_kind &&
            source_result.value_def_op_id >= 0 &&
            source_result.value_def_op_id < body->op_count &&
            cold_exact_op_tuple_matches_result(
                body, &source_result);
        if (exact_source && owner_source) {
            exact_source =
                cold_exact_owned_value_definition_valid_at(
                    body, parser->symbols,
                    &source_result, -1,
                    &source_storage);
        } else if (exact_source && borrowed_source) {
            source_storage = cold_exact_owned_storage_for_slot(
                parser->symbols, body,
                source_slot, source_kind);
            int32_t current_block =
                cold_current_open_block(body);
            exact_source =
                source_storage != COLD_MANAGED_STORAGE_UNKNOWN &&
                current_block >= 0 &&
                cold_exact_definition_is_live_at_current_point(
                    body, source_result.value_def_op_id,
                    current_block);
        } else {
            exact_source = false;
        }
        /* A shared borrow may still be carried by the physical `var T`
           cell kind.  The shared-copy emitter retains/copies VALUES, never
           reference cells, so project the exact pointee value before the
           retain.  The unique-var rejection above remains the authority:
           this path only admits an already-proven BORROW_SHARED source. */
        bool shared_managed_ref_value =
            exact_source && borrowed_source &&
            (source_kind == SLOT_STR_REF ||
             source_kind == SLOT_SEQ_I32_REF ||
             source_kind == SLOT_SEQ_STR_REF ||
             source_kind == SLOT_SEQ_OPAQUE_REF ||
             source_kind == SLOT_OBJECT_REF ||
             (source_kind == SLOT_OPAQUE_REF &&
              source_result.exact_type_id >= 0 &&
              source_result.exact_type_id / 1048576 ==
                  SLOT_OBJECT_REF));
        if (shared_managed_ref_value) {
            source_result = cold_exact_managed_ref_value_borrow(
                body, parser->symbols, &source_result);
            source_slot = source_result.slot;
            source_kind = source_result.kind;
            source_storage = cold_exact_owned_storage_for_slot(
                parser->symbols, body,
                source_slot, source_kind);
            int32_t current_block =
                cold_current_open_block(body);
            exact_source =
                source_result.ownership ==
                    COLD_EXPR_OWN_BORROW_SHARED &&
                source_result.slot == source_slot &&
                source_result.kind == source_kind &&
                source_result.value_def_op_id >= 0 &&
                source_result.value_def_op_id < body->op_count &&
                source_storage != COLD_MANAGED_STORAGE_UNKNOWN &&
                current_block >= 0 &&
                cold_exact_definition_is_live_at_current_point(
                    body, source_result.value_def_op_id,
                    current_block) &&
                cold_exact_op_tuple_matches_result(
                    body, &source_result);
        }
        if (!exact_source) {
            die("share(value) requires an exact owned source");
        }
        if (source_storage == COLD_MANAGED_STORAGE_PLAIN &&
            !cold_plain_value_copy_is_independent(
                parser->symbols, body,
                source_slot, source_kind)) {
            die("share(value) rejects an address-bearing plain value");
        }
        ColdExprResult shared = cold_emit_exact_shared_local_copy(
            parser, body, parser->symbols, &source_result);
        cold_expr_result_publish(body, &shared);
        *kind = shared.kind;
        return shared.slot;
    }
    if (span_eq(token, "cstring") && span_eq(parser_peek(parser), "(")) {
        return parse_cstring_cast(parser, body, locals, kind);
    }
    if (cold_primitive_pointer_cast_type(token).len > 0 &&
        span_eq(parser_peek(parser), "(")) {
        return parse_primitive_pointer_cast(parser, body, locals, token, kind);
    }
    if (cold_is_scalar_identity_cast(token) && span_eq(parser_peek(parser), "(")) {
        return parse_scalar_identity_cast(parser, body, locals, token, kind);
    }
    if (span_eq(token, "nil")) {
        int32_t slot = body_slot(body, SLOT_PTR, 8);
        body_slot_set_type(body, slot, cold_cstr_span("ptr"));
        int32_t producer =
            body_op(body, BODY_OP_PTR_CONST, slot, 0, 0);
        /* nil has no nominal managed TypeId until the assignment/call
           context supplies one. Keep its exact producer op in the
           ephemeral expression carrier without claiming BodyIR ownership
           authority yet. */
        ColdExprResult nil_result;
        cold_expr_result_reset(&nil_result);
        nil_result.slot = slot;
        nil_result.kind = SLOT_PTR;
        nil_result.value_def_op_id = producer;
        nil_result.producer_function_row =
            body->producer_function_row;
        nil_result.place_kind = COLD_EXPR_PLACE_TEMPORARY;
        nil_result.origin_id = producer;
        cold_expr_result_publish(body, &nil_result);
        *kind = SLOT_PTR;
        return slot;
    }
    if (token.len > 2 && token.ptr[0] == '0' &&
        (token.ptr[1] == 'x' || token.ptr[1] == 'X')) {
        uint64_t val = 0;
        for (int32_t i = 2; i < token.len; i++) {
            uint8_t h = token.ptr[i];
            if (h == '_') continue; /* digit separator */
            val = (val << 4) | (uint64_t)(h >= 'a' ? h - 'a' + 10 :
                                          h >= 'A' ? h - 'A' + 10 : h - '0');
        }
        if (val > 0xFFFFFFFFull) {
            int32_t slot = cold_make_i64_const_slot(body, (int64_t)val);
            *kind = SLOT_I64;
            return slot;
        }
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, slot, (int32_t)(uint32_t)val, 0);
        /* Hex literals with bit31 set keep their i32 bit pattern (mask
           usage) but are value-wise unsigned: tag them so promotion to
           int64 zero-extends instead of sign-extending. */
        if (val > 0x7FFFFFFFull)
            body_slot_set_type(body, slot, cold_cstr_span("uint32"));
        else
            body_slot_set_type(body, slot, cold_cstr_span("int32"));
        *kind = SLOT_I32;
        return slot;
    }
    if (span_is_i32(token)) {
        int64_t value = span_i64(token);
        if (value < (int64_t)INT32_MIN || value > (int64_t)INT32_MAX) {
            int32_t slot = cold_make_i64_const_slot(body, value);
            *kind = SLOT_I64;
            return slot;
        }
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, slot, (int32_t)value, 0);
        body_slot_set_type(body, slot, cold_cstr_span("int32"));
        *kind = SLOT_I32;
        return slot;
    }
    if (cold_span_is_float(token)) {
        double val = cold_span_f64(token);
        uint64_t bits = 0;
        memcpy(&bits, &val, sizeof(bits));
        int32_t slot = body_slot(body, SLOT_F64, 8);
        body_op3(body, BODY_OP_F64_CONST, slot,
                 (int32_t)(uint32_t)bits,
                 (int32_t)(uint32_t)(bits >> 32), 0);
        body_slot_set_type(body, slot, cold_cstr_span("float64"));
        *kind = SLOT_F64;
        return slot;
    }
    if (span_eq(token, "true") || span_eq(token, "false")) {
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_I32_CONST, slot, span_eq(token, "true") ? 1 : 0, 0);
        body_slot_set_type(body, slot, cold_cstr_span("bool"));
        *kind = SLOT_I32;
        return slot;
    }
    if (span_eq(token, "new") && span_eq(parser_peek(parser), "(")) {
        (void)parser_token(parser);
        Span tn = parser_token(parser);
        if (span_eq(parser_peek(parser), "[")) { (void)parser_token(parser); while (parser->pos < parser->source.len && parser->source.ptr[parser->pos] != ']') parser->pos++; if (parser->pos < parser->source.len) parser->pos++; } if (span_eq(parser_peek(parser), "[")) { (void)parser_token(parser); while (parser->pos < parser->source.len && parser->source.ptr[parser->pos] != ']') parser->pos++; if (parser->pos < parser->source.len) parser->pos++; } if (!parser_take(parser, ")")) die("new(Type): missing )");
        ObjectDef *nobj = parser_find_object(parser, tn);
        if (nobj && nobj->slot_size > 0) {
            int32_t nobj_index =
                symbols_object_index(parser->symbols, nobj);
            if (nobj_index < 0)
                die("new(Type): exact object row missing");
            int32_t nobj_field_count = nobj->field_count;
            int32_t len = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, len, nobj->slot_size, 0);
            int32_t new_kind = nobj->is_ref ? SLOT_PTR : SLOT_OBJECT_REF;
            int32_t ns = body_slot(body, new_kind, 8);
            body_slot_set_type(body, ns, nobj->name);
            /* `new(Type)` always returns a zero-initialized ref value. Keep
               that ownership contract distinct from raw mmap/heap buffers so
               hosted codegen can register the allocation with Cheng ORC. */
            int32_t allocation = body_op3(
                body, BODY_OP_MMAP, ns, len, 0,
                COLD_MMAP_MODE_MANAGED_REF);
            for (int32_t field_index = 0;
                 field_index < nobj_field_count; field_index++) {
                nobj = &parser->symbols->objects[nobj_index];
                ObjectField *field = &nobj->fields[field_index];
                int32_t value_kind = field->kind;
                int32_t value_slot = cold_default_slot_for_object_field(
                    parser, body, locals, field, &value_kind, 0);
                cold_store_object_field_slot(
                    body, ns, field, value_slot);
            }
            if (nobj->is_ref) {
                cold_publish_exact_managed_definition(
                    body, parser->symbols, ns, SLOT_PTR,
                    allocation, COLD_EXPR_OWN_MOVE, 0);
            } else {
                /* new(T) on a plain object materializes the same managed-ref
                   allocation as the ref arm; its OBJECT_REF carrier feeds
                   PAYLOAD_STORE chains and return roots that the exact
                   identity gates can only prove through a published owned
                   definition.  Skipping the publication here left every
                   non-ref heap construction carrier def-less (W-G9'). */
                cold_publish_exact_managed_definition(
                    body, parser->symbols, ns, new_kind,
                    allocation, COLD_EXPR_OWN_MOVE, 0);
            }
            *kind = new_kind;
            return ns;
        }
        die("new(Type): type missing or invalid");
    }
    Variant *variant = parser_find_variant(parser, token);
    if (variant) {
        /* Consume generic parameters [T, ...] before constructor args */
        while (span_eq(parser_peek(parser), "[")) {
            (void)parser_token(parser);
            while (parser->pos < parser->source.len &&
                   parser->source.ptr[parser->pos] != ']') parser->pos++;
            if (parser->pos < parser->source.len) parser->pos++;
        }
        /* Payloadless enum variant: produce I32 tag directly instead of VARIANT */
        if (variant->field_count == 0) {
            TypeDef *parenum = symbols_find_variant_type(parser->symbols, variant);
            if (parenum && parenum->is_enum) {
                int32_t slot = body_slot(body, SLOT_I32, 4);
                body_slot_set_type(body, slot, parenum->name);
                body_op(body, BODY_OP_I32_CONST, slot, variant->tag, 0);
                *kind = SLOT_I32;
                return slot;
            }
        }
        *kind = SLOT_VARIANT;
        return parse_constructor(parser, body, locals, variant);
    }
    ObjectDef *object = parser_find_object(parser, token);
    if (object && !object->is_ref && (token.ptr[0] >= 'A' && token.ptr[0] <= 'Z') &&
        parser_next_is_object_constructor(parser)) {
        *kind = SLOT_OBJECT;
        return parse_object_constructor(parser, body, locals, object);
    }
    if (span_eq(token, "len") && span_eq(parser_peek(parser), "(")) {
        parser_take(parser, "(");
        int32_t inner_kind = SLOT_I32;
        int32_t inner_slot = parse_expr(parser, body, locals, &inner_kind);
        if (inner_kind == SLOT_SEQ_I32 || inner_kind == SLOT_SEQ_I32_REF ||
            inner_kind == SLOT_SEQ_STR || inner_kind == SLOT_SEQ_STR_REF ||
            inner_kind == SLOT_SEQ_OPAQUE || inner_kind == SLOT_SEQ_OPAQUE_REF) {
            /* Sequence len: read the element count from the header (offset 4),
               matching the `.len` field access path. */
            if (!parser_take(parser, ")")) return 0; /* skip malformed len */;
            int32_t seq_len_slot = body_slot(body, SLOT_I32, 4);
            body_op3(body, BODY_OP_PAYLOAD_LOAD, seq_len_slot, inner_slot, 0, 4);
            *kind = SLOT_I32;
            /* Stamp the declared-type text the same way an ordinary function
               call stamps its return slot with fn->ret: len() has a fixed,
               unambiguous logical return type (int32), but without this the
               slot's type span stays empty and `$len(...)` used directly as
               a `$` operand falls through cold_emit_dollar_call's exact
               declared-type Pass 1 (operand_type.len == 0) straight into the
               loose SLOT-kind Pass 2, which is ambiguous whenever more than
               one of the bool/char/int8/uint8/int16/uint16/int32/int/uint32
               `$` overloads is in scope (they all collapse to SLOT_I32) --
               a false "ambiguous $ operator" die for a value whose type was
               never actually in question. */
            body_slot_set_type(body, seq_len_slot, cold_cstr_span("int32"));
            return seq_len_slot;
        }
        if (inner_kind == SLOT_ARRAY_I32) {
            /* Fixed-size array len is the static element count (slot_aux). */
            if (!parser_take(parser, ")")) return 0; /* skip malformed len */;
            int32_t arr_len_slot = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, arr_len_slot, body->slot_aux[inner_slot], 0);
            *kind = SLOT_I32;
            body_slot_set_type(body, arr_len_slot, cold_cstr_span("int32"));
            return arr_len_slot;
        }
        if (inner_kind != SLOT_STR && inner_kind != SLOT_STR_REF) {
            /* len() is only defined for sequences (T[]), fixed-size arrays
               (T[N]), and str (docs/cheng-formal-spec.md 1.2.1: `len(xs: T[])`
               / `len(s)` for str). Every other operand kind (scalars,
               objects, pointers, ...) has no legal len() meaning -- die with
               an exact diagnostic at the call site instead of silently
               returning 0 while leaving the call's `)` unconsumed, which
               desyncs the token stream and produces confusing cascading
               parse errors at unrelated downstream locations (#107). */
            die("len() expects a sequence, fixed-size array, or str value");
        }
        if (!parser_take(parser, ")")) return 0; /* skip malformed len */;
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_STR_LEN, slot, inner_slot, 0);
        *kind = SLOT_I32;
        body_slot_set_type(body, slot, cold_cstr_span("int32"));
        return slot;
    }
    if ((span_eq(token, "strings.Len") || span_eq(token, "strutil.Len") ||
         span_eq(token, "strutils.Len")) && span_eq(parser_peek(parser), "(")) {
        parser_take(parser, "(");
        int32_t inner_kind = SLOT_I32;
        int32_t inner_slot = parse_expr(parser, body, locals, &inner_kind);
        if (inner_kind != SLOT_STR && inner_kind != SLOT_STR_REF) die("strings.Len expects str");
        if (!parser_take(parser, ")")) return 0; /* skip malformed strings.Len */;
        int32_t slot = body_slot(body, SLOT_I32, 4);
        body_op(body, BODY_OP_STR_LEN, slot, inner_slot, 0);
        *kind = SLOT_I32;
        return slot;
    }
    /* sizeof(type) intrinsic */
    if (span_eq(token, "sizeof") && span_eq(parser_peek(parser), "(")) {
        (void)parser_token(parser); /* consume ( */
        Span type_name = parser_token(parser);
        if (span_eq(parser_peek(parser), ".")) {
            type_name = parser_take_qualified_after_first(parser, type_name);
        }
        if (type_name.len <= 0) die("sizeof expects type name");
        Span resolved_name = parser_scope_type(parser, type_name);
        if (!parser_take(parser, ")")) return 0;
        int32_t slot = body_slot(body, SLOT_I32, 4);
        if (cold_type_references_generic_names(
                resolved_name, parser->active_generic_names,
                parser->active_generic_count)) {
            int32_t type_index = body_string_literal(body, resolved_name);
            body_op3(body, BODY_OP_TYPE_SIZE, slot, type_index,
                     COLD_TYPE_SIZE_MODE_SIZEOF, 0);
        } else {
            int32_t size = cold_concrete_type_size(
                parser->symbols, resolved_name, COLD_TYPE_SIZE_MODE_SIZEOF);
            if (size <= 0 && !span_same(resolved_name, type_name)) {
                size = cold_concrete_type_size(
                    parser->symbols, type_name, COLD_TYPE_SIZE_MODE_SIZEOF);
            }
            if (size <= 0) die("sizeof unresolved type");
            body_op(body, BODY_OP_I32_CONST, slot, size, 0);
        }
        body_slot_set_type(body, slot, cold_cstr_span("int32"));
        *kind = SLOT_I32;
        return slot;
    }
    /* Anonymous function / closure expression: fn(params): ret = body */
    if (span_eq(token, "fn") && span_eq(parser_peek(parser), "(")) {
        return parse_closure_expr(
            parser, body, locals, kind, token);
    }
    /* Bare fn keyword in expression context: treat as function pointer value */
    if (span_eq(token, "fn")) {
        int32_t addr_slot = body_slot(body, SLOT_PTR, 8);
        body_op(body, BODY_OP_I32_CONST, addr_slot, 0, 0);
        *kind = SLOT_PTR;
        return addr_slot;
    }
    /* check if token is a local variable FIRST -- field access on locals is handled by parse_postfix */
    Local *local = locals_find(locals, token);
    if (local) {
        if (local->is_global) {
            GlobalDef *global = parser_find_global(parser, token);
            if (!global) die("global local shadow missing");
            local = locals_add_global_shadow(parser, body, locals, token, global);
            if ((local->kind == SLOT_I32_REF ||
                 local->kind == SLOT_I64_REF) &&
                local->value_def_op_id >= 0 &&
                body->op_value_def_place_kind[
                    local->value_def_op_id] ==
                    COLD_EXPR_PLACE_GLOBAL) {
                return cold_materialize_exact_global_scalar_value(
                    body, parser->symbols,
                    local, kind);
            }
            if (local->value_def_op_id >= 0 &&
                local->value_def_op_id < body->op_count &&
                body->op_value_def_place_kind[
                    local->value_def_op_id] ==
                    COLD_EXPR_PLACE_GLOBAL &&
                body->op_value_def_exact_type_id[
                    local->value_def_op_id] < 0) {
                /* Type-less fixed-array global definition (arrays carry no
                   object TypeId): publish the exact GLOBAL shadow result. */
                *kind = local->kind;
                return cold_publish_global_shadow_result(
                    body, local, kind);
            }
            if (cold_exact_storage_authority_for_slot(
                    parser->symbols, body, local->slot,
                    local->kind) != COLD_MANAGED_STORAGE_UNKNOWN &&
                cold_exact_managed_type_id(
                    parser->symbols, body, local->slot,
                    local->kind) >= 0) {
                if (local->value_def_op_id >= 0 &&
                    local->value_def_op_id < body->op_count &&
                    body->op_value_def_place_kind[
                        local->value_def_op_id] == COLD_EXPR_PLACE_GLOBAL) {
                    *kind = local->kind;
                    return cold_publish_global_shadow_result(
                        body, local, kind);
                }
                ColdExprResult global_borrow =
                    cold_emit_exact_root_borrow_copy(
                        body, parser->symbols,
                        local->slot, local->kind);
                cold_expr_result_publish(body, &global_borrow);
                *kind = global_borrow.kind;
                return global_borrow.slot;
            }
        }
        cold_require_local_exact_value_available(parser, body, local, token);
        int32_t local_kind = local->kind;
        ColdExprResult local_authority;
        ColdExprResult materialized_result;
        cold_expr_result_reset(&local_authority);
        if (local->value_def_op_id >= 0 &&
            !cold_exact_result_from_definition(
                body, local->slot,
                local->value_def_op_id,
                &local_authority)) {
            die("local expression definition is not exact");
        }
        /* A dotted postfix consumes the local as a place base, not as a
           standalone value.  For `var ValueObject`, eagerly projecting the
           complete pointee here creates one object-sized temporary before
           every field hop; parse_postfix then reads only the named field and
           leaves that whole-value definition otherwise unused.  Preserve
           the exact PARAM/MEMORY_VERSION carrier for `base.field` so the
           field PAYLOAD_LOAD is rooted directly in its immutable value-def.
           A bare `base` (including a by-value call argument or return) still
           takes the value materializer below and therefore keeps the required
           full-width load.  This decision is the parsed postfix token, not a
           type/name/use heuristic. */
        bool dotted_place_projection =
            span_eq(parser_peek(parser), ".");
        int32_t slot =
            dotted_place_projection
                ? cold_materialize_var_param_place_base(
                      parser, body, local->slot, &local_kind,
                      local_authority.value_def_op_id >= 0
                          ? &local_authority : 0,
                      &materialized_result)
                : cold_materialize_var_param_value(
                      parser, body, local->slot, &local_kind,
                      local_authority.value_def_op_id >= 0
                          ? &local_authority : 0,
                      &materialized_result);
        if (materialized_result.value_def_op_id >= 0) {
            if (materialized_result.slot != slot ||
                materialized_result.kind != local_kind ||
                !cold_exact_op_tuple_matches_result(
                    body, &materialized_result)) {
                die("materialized local expression result is not exact");
            }
            cold_expr_result_publish(body, &materialized_result);
        } else {
            cold_publish_local_expr_result(
                body, local, slot, local_kind);
        }
        *kind = local_kind;
        return slot;
    }
    GlobalDef *global = parser_find_global(parser, token);
    if (global) {
        local = locals_add_global_shadow(parser, body, locals, token, global);
        if (!local) die("global local shadow creation failed");
        if ((local->kind == SLOT_I32_REF ||
             local->kind == SLOT_I64_REF) &&
            local->value_def_op_id >= 0 &&
            body->op_value_def_place_kind[
                local->value_def_op_id] ==
                COLD_EXPR_PLACE_GLOBAL) {
            return cold_materialize_exact_global_scalar_value(
                body, parser->symbols,
                local, kind);
        }
        if (local->value_def_op_id >= 0 &&
            local->value_def_op_id < body->op_count &&
            body->op_value_def_place_kind[
                local->value_def_op_id] ==
                COLD_EXPR_PLACE_GLOBAL &&
            body->op_value_def_exact_type_id[
                local->value_def_op_id] < 0) {
            /* Type-less fixed-array global definition (arrays carry no
               object TypeId): publish the exact GLOBAL shadow result. */
            *kind = local->kind;
            return cold_publish_global_shadow_result(
                body, local, kind);
        }
        if (cold_exact_storage_authority_for_slot(
                parser->symbols, body, local->slot,
                local->kind) != COLD_MANAGED_STORAGE_UNKNOWN &&
            cold_exact_managed_type_id(
                parser->symbols, body, local->slot,
                local->kind) >= 0) {
            if (local->value_def_op_id >= 0 &&
                local->value_def_op_id < body->op_count &&
                body->op_value_def_place_kind[
                    local->value_def_op_id] == COLD_EXPR_PLACE_GLOBAL) {
                *kind = local->kind;
                return cold_publish_global_shadow_result(
                    body, local, kind);
            }
            ColdExprResult global_borrow =
                cold_emit_exact_root_borrow_copy(
                    body, parser->symbols,
                    local->slot, local->kind);
            cold_expr_result_publish(body, &global_borrow);
            *kind = global_borrow.kind;
            return global_borrow.slot;
        }
        *kind = local->kind;
        return local->slot;
    }
    if (span_eq(parser_peek(parser), "{") &&
        token.len > 0 && token.ptr[0] >= 'A' && token.ptr[0] <= 'Z') {
        /* object constructor with curly braces */
        ObjectDef *obj = parser_resolve_object(parser, token);
        if (!obj || obj->is_ref) die("object type missing for constructor");
        *kind = SLOT_OBJECT;
        return parse_object_constructor(parser, body, locals, obj);
    }
    if (span_eq(parser_peek(parser), "[")) {
        Parser probe = *parser;
        if (parser_take(&probe, "[") && parser_take(&probe, "]")) {
            Span seq_type = cold_arena_join3(parser->arena, token, "", cold_cstr_span("[]"));
            int32_t seq_kind = cold_parser_slot_kind_from_type(parser->symbols, seq_type);
            if (seq_kind == SLOT_SEQ_I32 || seq_kind == SLOT_SEQ_STR || seq_kind == SLOT_SEQ_OPAQUE) {
                (void)parser_token(parser);
                (void)parser_token(parser);
                int32_t slot = body_slot(body, seq_kind, 16);
                if (seq_kind == SLOT_SEQ_OPAQUE) {
                    ObjectDef *seq_elem = parser_resolve_object(parser, token);
                    if (seq_elem)
                        seq_type = cold_arena_join3(parser->arena, seq_elem->name, "", cold_cstr_span("[]"));
                    body_slot_set_seq_opaque_type(body, parser->symbols, slot, seq_type);
                } else {
                    body_slot_set_type(body, slot, seq_type);
                }
                body_op3(body, BODY_OP_MAKE_COMPOSITE, slot, 0, -1, 0);
                *kind = seq_kind;
                return slot;
            }
        }
    }
    if (span_eq(parser_peek(parser), "[")) {
        Parser index_probe = *parser;
        (void)parser_token(&index_probe);
        if (!span_eq(parser_peek(&index_probe), "]")) {
            ConstDef *indexed_constant =
                parser_find_const(parser, body, token);
            if (indexed_constant) {
                return cold_materialize_const_value(
                    parser, body, indexed_constant, kind);
            }
        }
    }
    bool generic_call = parser_next_is_generic_call(parser);
    if (parser_next_is_qualified_call(parser) ||
        span_eq(parser_peek(parser), "(") || generic_call) {
        Span call_name = token;
        if (parser_next_is_qualified_call(parser)) {
            call_name = parser_take_qualified_after_first(parser, token);
        } else if (generic_call) {
            call_name = parser_take_qualified_after_first(parser, token);
        }
        /* Try variant constructor first (handles both payloaded and payloadless) */
        Span stripped_name = cold_span_strip_generic_suffix(call_name);
        Variant *vc = symbols_find_variant(parser->symbols, stripped_name);
        if (!vc) {
            int32_t dot = -1;
            for (int32_t i = call_name.len - 1; i > 0; i--) {
                if (call_name.ptr[i] == '.') { dot = i; break; }
            }
            if (dot > 0) {
                Span bare = span_sub(call_name, dot + 1, call_name.len);
                bare = cold_span_strip_generic_suffix(bare);
                vc = symbols_find_variant(parser->symbols, bare);
            }
        }
        if (vc) {
            /* Payloadless enum variant: produce I32 tag directly */
            if (vc->field_count == 0) {
                TypeDef *parenum = symbols_find_variant_type(parser->symbols, vc);
                if (parenum && parenum->is_enum) {
                    int32_t slot = body_slot(body, SLOT_I32, 4);
                    body_slot_set_type(body, slot, parenum->name);
                    body_op(body, BODY_OP_I32_CONST, slot, vc->tag, 0);
                    *kind = SLOT_I32;
                    return slot;
                }
            }
            *kind = SLOT_VARIANT;
            if (vc->field_count > 0) {
                return parse_constructor(parser, body, locals, vc);
            }
            int32_t vz = symbols_variant_slot_size(parser->symbols, vc);
            int32_t sl = body_slot(body, SLOT_VARIANT, vz);
            body_op3(body, BODY_OP_MAKE_VARIANT, sl, vc->tag, -1, 0);
            return sl;
        }
        if (!vc) {
            /* Try object constructor for qualified name (e.g. hostops.LoggedRun(label: ...)) */
            Span object_slot_type = {0};
            ObjectDef *obj = parser_resolve_object_constructor(parser, call_name,
                                                               &object_slot_type);
            if (obj && !obj->is_ref && parser_next_is_object_constructor(parser)) {
                *kind = SLOT_OBJECT;
                return parse_object_constructor_typed(parser, body, locals, obj,
                                                      object_slot_type);
            }
        }
        if (!span_eq(parser_peek(parser), "(")) {
            /* The branch is admitted only when the non-mutating lookahead
               proved a call.  Any disagreement after consuming the exact
               qualified/generic name is parser-state drift, never a value
               expression that can be replaced with a synthetic zero. */
            fprintf(stderr, "cheng_cold: ");
            cold_error_loc(parser, call_name);
            fprintf(stderr, " unsupported qualified expression '%.*s'\n",
                    (int)call_name.len, call_name.ptr);
            cold_print_context(parser, call_name);
            die("unsupported qualified expression");
        }
        ColdExprResult call_result;
        int32_t call_slot = cold_parse_call_after_name_exact(
            parser, body, locals, call_name, kind, &call_result);
        cold_expr_result_publish(body, &call_result);
        return call_slot;
    }
    /* token is not a local; try qualified constant/variant lookup, then bare constant */
    if (span_eq(parser_peek(parser), ".")) {
        Span qualified = parser_take_dotted_after_first(parser, token);
        /* Try Type.Variant lookup before const lookup (const may be stale synthetic) */
        Variant *qualified_variant = 0;
        {
            int32_t dot = -1;
            for (int32_t i = qualified.len - 1; i > 0; i--) {
                if (qualified.ptr[i] == '.') { dot = i; break; }
            }
            if (dot > 0) {
                Span type_name = span_sub(qualified, 0, dot);
                Span variant_name = span_sub(qualified, dot + 1, qualified.len);
                variant_name = cold_span_strip_generic_suffix(variant_name);
                TypeDef *ty = symbols_find_type(parser->symbols, type_name);
                if (ty) qualified_variant = type_find_variant(ty, variant_name);
                /* Import alias resolution: type_name might be an import alias */
                if (!qualified_variant && parser->import_source_count > 0 && parser->import_sources) {
                    for (int32_t isi = 0; isi < parser->import_source_count; isi++) {
                        if (!span_same(parser->import_sources[isi].alias, type_name)) continue;
                        Span aliased = cold_arena_join3(parser->arena,
                            parser->import_sources[isi].alias, ".", variant_name);
                        qualified_variant = symbols_find_variant(parser->symbols, aliased);
                        if (!qualified_variant)
                            qualified_variant = symbols_find_variant(parser->symbols, variant_name);
                        if (qualified_variant) break;
                    }
                }
            }
            if (!qualified_variant) {
                qualified_variant = symbols_find_variant(parser->symbols, qualified);
                if (!qualified_variant) {
                    int32_t br = cold_span_find_char(qualified, '[');
                    if (br > 0) {
                        qualified_variant = symbols_find_variant(parser->symbols, span_sub(qualified, 0, br));
                    }
                }
                if (!qualified_variant && dot > 0) {
                    Span qv = span_sub(qualified, dot + 1, qualified.len);
                    qv = cold_span_strip_generic_suffix(qv);
                    qualified_variant = symbols_find_variant(parser->symbols, qv);
                }
            }
        }
        if (qualified_variant) {
            if (qualified_variant->field_count == 0) {
                TypeDef *parenum = symbols_find_variant_type(parser->symbols, qualified_variant);
                if (parenum && parenum->is_enum) {
                    int32_t slot = body_slot(body, SLOT_I32, 4);
                    body_slot_set_type(body, slot, parenum->name);
                    body_op(body, BODY_OP_I32_CONST, slot, qualified_variant->tag, 0);
                    *kind = SLOT_I32;
                    return slot;
                }
            }
            *kind = SLOT_VARIANT;
            if (qualified_variant->field_count > 0) {
                return parse_constructor(parser, body, locals, qualified_variant);
            }
            /* payloadless variant: create directly */
            int32_t variant_ty = symbols_variant_slot_size(parser->symbols, qualified_variant);
            int32_t slot = body_slot(body, SLOT_VARIANT, variant_ty);
            body_op3(body, BODY_OP_MAKE_VARIANT, slot, qualified_variant->tag, -1, 0);
            return slot;
        }
        ConstDef *constant = symbols_find_const(parser->symbols, qualified);
        if (constant) {
            return cold_materialize_const_value(
                parser, body, constant, kind);
        }
        GlobalDef *qualified_global = parser_find_global(parser, qualified);
        if (qualified_global) {
            Local *global_shadow = locals_add_global_shadow(parser, body, locals,
                                                            qualified, qualified_global);
            if (!global_shadow) die("qualified global shadow creation failed");
            *kind = global_shadow->kind;
            return global_shadow->slot;
        }
        /* last-chance: Type.Variant or import alias constant/variant qualified name */
        {
            int32_t dot = -1;
            for (int32_t i = qualified.len - 1; i > 0; i--) {
                if (qualified.ptr[i] == '.') { dot = i; break; }
            }
            if (dot > 0) {
                Span tn = span_sub(qualified, 0, dot);
                Span vn = span_sub(qualified, dot + 1, qualified.len);
                vn = cold_span_strip_generic_suffix(vn);
                TypeDef *ty = symbols_find_type(parser->symbols, tn);
                if (ty) {
                    Variant *vc = type_find_variant(ty, vn);
                    if (vc) {
                        if (vc->field_count == 0 && ty->is_enum) {
                            int32_t slot = body_slot(body, SLOT_I32, 4);
                            body_slot_set_type(body, slot, ty->name);
                            body_op(body, BODY_OP_I32_CONST, slot, vc->tag, 0);
                            *kind = SLOT_I32;
                            return slot;
                        }
                        *kind = SLOT_VARIANT;
                        if (vc->field_count > 0) {
                            return parse_constructor(parser, body, locals, vc);
                        }
                        int32_t vz = symbols_variant_slot_size(parser->symbols, vc);
                        int32_t sl = body_slot(body, SLOT_VARIANT, vz);
                        body_op3(body, BODY_OP_MAKE_VARIANT, sl, vc->tag, -1, 0);
                        return sl;
                    }
                }
                /* Import alias resolution: tn might be an import alias for a module.
                   Search for vn as a constant or variant in the imported module. */
                if (parser->import_source_count > 0 && parser->import_sources) {
                    for (int32_t isi = 0; isi < parser->import_source_count; isi++) {
                        if (!span_same(parser->import_sources[isi].alias, tn)) continue;
                        Span aliased = cold_arena_join3(parser->arena,
                            parser->import_sources[isi].alias, ".", vn);
                        ConstDef *qc = symbols_find_const(parser->symbols, aliased);
                        if (qc) {
                            return cold_materialize_const_value(
                                parser, body, qc, kind);
                        }
                        Variant *qv = symbols_find_variant(parser->symbols, aliased);
                        if (!qv) qv = symbols_find_variant(parser->symbols, vn);
                        if (qv) {
                            if (qv->field_count == 0) {
                                TypeDef *qpenum = symbols_find_variant_type(parser->symbols, qv);
                                if (qpenum && qpenum->is_enum) {
                                    int32_t slot = body_slot(body, SLOT_I32, 4);
                                    body_slot_set_type(body, slot, qpenum->name);
                                    body_op(body, BODY_OP_I32_CONST, slot, qv->tag, 0);
                                    *kind = SLOT_I32;
                                    return slot;
                                }
                            }
                            *kind = SLOT_VARIANT;
                            if (qv->field_count > 0) {
                                return parse_constructor(parser, body, locals, qv);
                            }
                            int32_t vz = symbols_variant_slot_size(parser->symbols, qv);
                            int32_t sl = body_slot(body, SLOT_VARIANT, vz);
                            body_op3(body, BODY_OP_MAKE_VARIANT, sl, qv->tag, -1, 0);
                            return sl;
                        }
                        break;
                    }
                }
            }
        }
        /* Named parameter in function call: name: value -> parse value */
        if (span_eq(parser_peek(parser), ":")) {
            (void)parser_token(parser);
            int32_t val_kind = SLOT_I32;
            int32_t val_slot = parse_expr(parser, body, locals, &val_kind);
            *kind = val_kind;
            return val_slot;
        }
        /* Terminal fallback: token matched no const, function name, variant,
           import-aliased constant/variant, or named-param colon under a
           qualified (module.name) prefix -- it is genuinely unresolved. This
           must always die (never silently substitute I32_CONST(0) even under
           ColdErrorRecoveryEnabled): a typo'd member name reached through an
           otherwise-valid module alias is not a recoverable parse error, and
           swallowing it here made typo'd qualified names (e.g. a real import
           alias with a nonexistent member, `mod.notReal`) compile+run
           silently to zero -- the same class of bug as the bare unresolved
           identifier fallback above. die() still unwinds through the
           caller's setjmp/longjmp recovery so this surfaces as a top-level
           diagnosed failure, not a process crash. */
        fprintf(stderr, "cheng_cold: ");
        cold_error_loc(parser, token);
        fprintf(stderr, " unknown qualified identifier '%.*s' in '%.*s'\n",
                (int)token.len, token.ptr, qualified.len, qualified.ptr);
        cold_print_context(parser, token);
        die("unknown qualified identifier");
    }
    ConstDef *constant = parser_find_const(parser, body, token);
    if (constant) {
        return cold_materialize_const_value(
            parser, body, constant, kind);
    }
    /* Bare function name reference (used as value, e.g. passed as function pointer) */
    {
        Span lookup_fn_name = parser_can_scope_bare_name(parser, token)
                                  ? parser_scoped_bare_name(parser, token)
                                  : token;
        int32_t fn_idx = symbols_find_fn(parser->symbols, lookup_fn_name, 0, 0, 0, 0, (Span){0});
        if (fn_idx < 0) {
            /* Try arity-insensitive lookup -- just check if name matches any function */
            for (int32_t si = 0; si < parser->symbols->function_count; si++) {
                if (span_same(parser->symbols->functions[si].name, lookup_fn_name)) {
                    fn_idx = si;
                    break;
                }
            }
        }
        if (fn_idx >= 0) {
            int32_t addr_slot = body_slot(body, SLOT_PTR, 8);
            body_op(body, BODY_OP_FN_ADDR, addr_slot, fn_idx, 0);
            /* #105 root fix: see the &fnName sibling above -- carry the
               referenced function's own real signature as this slot's
               declared type so a wrong-signature callback passed by bare
               name is caught structurally, not just by coarse PTR kind. */
            body_slot_set_type(body, addr_slot,
                               cold_fn_own_signature_text(parser->symbols,
                                                          &parser->symbols->functions[fn_idx]));
            *kind = SLOT_PTR;
            return addr_slot;
        }
    }
    /* Named parameter in function call: name: value -> parse value */
    if (span_eq(parser_peek(parser), ":")) {
        (void)parser_token(parser);
        int32_t val_kind = SLOT_I32;
        int32_t val_slot = parse_expr(parser, body, locals, &val_kind);
        *kind = val_kind;
        return val_slot;
    }
    /* Last-chance: token might be a known type name used as an expression
       (e.g. a struct/ADT type name, builtin type, or generic parameter).
       Return a type-descriptor slot. */
    {
        TypeDef *ty = symbols_find_type(parser->symbols, token);
        if (ty) {
            int32_t sz = ty->max_slot_size > 0 ? ty->max_slot_size : 4;
            int32_t slot = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, slot, sz, 0);
            *kind = SLOT_I32;
            return slot;
        }
        /* Check builtin type names: str, int32, bool, int64, etc. */
        int32_t builtin_kind = cold_parser_slot_kind_from_type(parser->symbols, token);
        int32_t builtin_size =
            parser_slot_size_from_type(
                parser, token, builtin_kind);
        if (builtin_size > 0 && cold_type_is_builtin_surface(token)) {
            /* Recognized builtin type name, not an expression value. */
            if (builtin_size > 0) {
                if (cold_type_is_builtin_surface(token) || cold_span_is_simple_ident(token)) {
                    int32_t slot = body_slot(body, builtin_kind, builtin_size);
                    body_slot_set_type(body, slot, token);
                    /* Create a zero-init slot for type-descriptor use */
                    if (builtin_kind == SLOT_STR) {
                        body_op(body, BODY_OP_STR_LITERAL, slot, 0, 0);
                    } else if (builtin_kind == SLOT_I32 || builtin_kind == SLOT_F32) {
                        body_op(body, BODY_OP_I32_CONST, slot, 0, 0);
                    } else if (builtin_kind == SLOT_I64 || builtin_kind == SLOT_F64) {
                        body_op(body, BODY_OP_I64_CONST, slot, 0, 0);
                    }
                    *kind = builtin_kind;
                    return slot;
                }
            }
        }
    }
    /* Terminal fallback: token matched no const, function name, named-param
       colon, type name, or builtin type — it is genuinely unresolved. This
       must always die (never silently substitute I32_CONST(0) even under
       ColdErrorRecoveryEnabled): a bare unresolved identifier is not a
       recoverable parse error, and swallowing it here made typo'd names in
       deferred-materialized import function bodies compile+run silently to
       zero. die() still unwinds through the caller's setjmp/longjmp recovery
       (cold_die_missing_reachable_body etc.) so this surfaces as a top-level
       diagnosed failure, not a process crash. */
    fprintf(stderr, "cheng_cold: ");
    cold_error_loc(parser, token);
    fprintf(stderr, " unknown identifier '%.*s' fn=%.*s\n",
            (int)token.len, token.ptr,
            (int)body->debug_name.len,
            body->debug_name.ptr ? body->debug_name.ptr : (const uint8_t *)"");
    cold_print_context(parser, token);
    die("unknown identifier");
    return -1;
}

/* Parse anonymous function/closure expression: fn(params): ret = body
   The token "fn" has already been consumed; parser is at (params)... */
static int32_t parse_closure_expr(
        Parser *parser, BodyIR *body, Locals *locals,
        int32_t *kind, Span declaration_token) {
    (void)locals;
    int32_t declaration_module_source_row = -1;
    int32_t declaration_token_byte_offset = -1;
    if (!cold_parser_declaration_origin_from_token(
            parser, declaration_token,
            &declaration_module_source_row,
            &declaration_token_byte_offset)) {
        die("closure lacks exact immutable declaration origin");
    }
    if (!parser_take(parser, "(")) die("expected ( in closure");
    int32_t arity = 0;
    Span param_names[COLD_MAX_I32_PARAMS];
    Span param_types[COLD_MAX_I32_PARAMS];
    int32_t param_kinds[COLD_MAX_I32_PARAMS];
    int32_t param_sizes[COLD_MAX_I32_PARAMS];
    int32_t group_start = 0;

    while (!span_eq(parser_peek(parser), ")")) {
        Span param = parser_token(parser);
        if (param.len == 0) die("unterminated closure params");
        if (arity >= COLD_MAX_I32_PARAMS) die("too many closure params");
        param_names[arity] = param;
        param_types[arity] = (Span){0};
        param_kinds[arity] = SLOT_I32;
        param_sizes[arity] = 4;
        bool has_explicit_type = false;
        Span explicit_param_type = {0};
        if (span_eq(parser_peek(parser), ":")) {
            (void)parser_token(parser);
            Span param_type = parser_scope_type(parser, parser_take_type_span(parser));
            explicit_param_type = param_type;
            param_types[arity] = param_type;
            param_kinds[arity] =
                parser_slot_kind_from_type(
                    parser, param_type);
            param_sizes[arity] =
                parser_param_size_from_type(
                    parser, param_type,
                    param_kinds[arity]);
            has_explicit_type = true;
        }
        arity++;
        if (has_explicit_type) {
            int32_t explicit_kind =
                parser_slot_kind_from_type(
                    parser, explicit_param_type);
            int32_t explicit_size =
                parser_param_size_from_type(
                    parser, explicit_param_type,
                    explicit_kind);
            for (int32_t pi = group_start; pi < arity; pi++) {
                param_types[pi] = explicit_param_type;
                param_kinds[pi] = explicit_kind;
                param_sizes[pi] = explicit_size;
            }
            group_start = arity;
        }
        if (span_eq(parser_peek(parser), ",")) (void)parser_token(parser);
    }
    if (!parser_take(parser, ")")) die("expected ) in closure");

    Span ret = {0};
    if (span_eq(parser_peek(parser), ":")) {
        (void)parser_token(parser);
        ret = parser_scope_type(parser, parser_take_type_span(parser));
    }
    if (!parser_take(parser, "=")) die("expected = in closure expression");

    /* Generate synthetic function name: __anon_N */
    int32_t closure_id = parser->closure_count++;
    char anon_name[64];
    int32_t anon_len = snprintf(anon_name, sizeof(anon_name), "__anon_%d", closure_id);
    uint8_t *name_copy = arena_alloc(parser->arena, (size_t)anon_len + 1);
    memcpy(name_copy, anon_name, (size_t)anon_len);
    name_copy[anon_len] = 0;
    Span fn_name = (Span){name_copy, anon_len};

    /* Register function symbol */
    int32_t symbol_index = symbols_add_fn_at_origin(
        parser->symbols, fn_name, arity,
        param_kinds, param_sizes, param_types, ret,
        declaration_module_source_row,
        declaration_token_byte_offset);
    symbols_set_fn_param_types(
        parser->symbols, symbol_index, param_types, arity);
    cold_publish_exact_formal_type_ids(
        parser->symbols, symbol_index);
    if (symbol_index < 0 ||
        symbol_index >= parser->symbols->function_count ||
        parser->symbols->functions[
            symbol_index].declaration_origin_row < 0) {
        die("closure function symbol lacks exact declaration origin");
    }
    parser->symbols->functions[symbol_index].decl_has_body = true;

    /* Create closure BodyIR */
    BodyIR *closure_body = body_new(parser->arena);
    cold_body_bind_declaration_origin(
        closure_body, parser->symbols,
        parser->symbols->functions[
            symbol_index].declaration_origin_row);
    closure_body->producer_function_row = symbol_index;
    closure_body->return_kind =
        parser_slot_kind_from_type(parser, ret);
    closure_body->return_size =
        parser_slot_size_from_type(
            parser, ret,
            closure_body->return_kind);
    closure_body->return_type = span_trim(ret);
    closure_body->debug_name = fn_name;

    Locals closure_locals;
    locals_init(&closure_locals, parser->arena);
    if (cold_kind_is_composite(closure_body->return_kind)) {
        closure_body->sret_slot = body_slot(closure_body, SLOT_PTR, 8);
        body_slot_set_type(
            closure_body, closure_body->sret_slot,
            cold_cstr_span("ptr"));
    }
    closure_body->param_count = arity;
    for (int32_t i = 0; i < arity; i++) {
        int32_t slot = body_slot(closure_body, param_kinds[i], param_sizes[i]);
        if (param_kinds[i] == SLOT_ARRAY_I32 && param_sizes[i] > 0) {
            closure_body->slot_aux[slot] = param_sizes[i] / 4;
        }
        Span st = cold_type_strip_var(param_types[i], 0);
        if (st.len > 0) {
            uint8_t *copy = arena_alloc(parser->arena, (size_t)(st.len + 1));
            memcpy(copy, st.ptr, (size_t)st.len);
            copy[st.len] = 0;
            st = (Span){copy, st.len};
        }
        if (param_kinds[i] == SLOT_SEQ_OPAQUE ||
            param_kinds[i] == SLOT_SEQ_OPAQUE_REF) {
            body_slot_set_seq_opaque_type(
                closure_body, parser->symbols,
                slot, st);
        } else {
            body_slot_set_type(
                closure_body, slot, st);
        }
        closure_body->param_slot[i] = slot;
        if (param_names[i].len > 0) {
            uint8_t *cn = arena_alloc(parser->arena, (size_t)(param_names[i].len + 1));
            memcpy(cn, param_names[i].ptr, (size_t)param_names[i].len);
            cn[param_names[i].len] = 0;
            closure_body->param_name[i] = (Span){cn, param_names[i].len};
        }
        locals_add(&closure_locals, param_names[i], slot, param_kinds[i]);
    }
    int32_t closure_block = body_block(closure_body);
    cold_bind_exact_managed_parameters(
        closure_body, parser->symbols, &closure_locals,
        param_types);

    /* Parse body using same approach as parse_fn */
    int32_t body_indent = parser_next_indent(parser);
    int32_t end_block = parse_statements_until(parser, closure_body, &closure_locals,
                                               closure_block, body_indent, 0, 0, 0);
    if (closure_body->block_term[end_block] < 0) {
        if (cold_return_span_is_void(ret)) {
            cold_finish_exact_function_return(
                parser, closure_body, &closure_locals,
                -1, SLOT_I32, 0, true);
        } else {
            die("non-void closure block unterminated");
        }
    }

    /* Store in function_bodies for codegen */
    if (parser->function_body_store && symbol_index >= 0) {
        cold_function_body_store_set(parser->function_body_store,
                                     symbol_index, closure_body);
        parser->function_body_cap = parser->function_body_store->cap;
    } else if (parser->function_bodies && symbol_index >= 0 &&
               symbol_index < parser->function_body_cap) {
        parser->function_bodies[symbol_index] = closure_body;
    }

    /* Emit function pointer in current body */
    int32_t addr_slot = body_slot(body, SLOT_PTR, 8);
    body_op(body, BODY_OP_FN_ADDR, addr_slot, symbol_index, 0);
    /* #105 root fix: an inline closure literal passed directly as a
       callback argument needs the same declared-signature signal as a
       bare function-name reference, or a wrong-signature lambda literal
       would silently pass cold_fn_typed_arg_matches too. */
    body_slot_set_type(body, addr_slot,
                       cold_fn_own_signature_text(parser->symbols,
                                                  &parser->symbols->functions[symbol_index]));
    *kind = SLOT_PTR;
    return addr_slot;
}

static Span cold_i32_container_element_type(Symbols *symbols, BodyIR *body,
                                            int32_t slot, int32_t kind) {
    if (!body || slot < 0 || slot >= body->slot_count) return (Span){0};
    Span type = span_trim(body->slot_type[slot]);
    if (kind == SLOT_ARRAY_I32) {
        Span element = {0};
        if (cold_parse_any_fixed_array_type(symbols, type, &element, 0))
            return span_trim(element);
        return (Span){0};
    }
    if (kind != SLOT_SEQ_I32 && kind != SLOT_SEQ_I32_REF)
        return (Span){0};
    Span resolved = cold_resolve_alias_terminal_span(symbols, type);
    resolved = span_trim(cold_type_strip_var(resolved, 0));
    if (cold_type_is_dynamic_seq_type(resolved)) {
        return span_trim(span_sub(resolved, 0, resolved.len - 2));
    }
    if (resolved.len > 0) return resolved;
    return cold_cstr_span("int32");
}

static bool cold_projected_value_requires_exact_definition(
        Symbols *symbols, BodyIR *body, int32_t slot,
        int32_t kind) {
    if (!body || slot < 0 || slot >= body->slot_count ||
        body->slot_kind[slot] != kind) {
        return false;
    }
    /* POD/PLAIN only means no ORC retain/drop.  A nominal object place still
       needs an immutable TypeId and projection chain before an indexed or
       field write; otherwise `var PlainRecord[]` loses its sequence root and
       the backend would authorize the store from a mutable slot guess. */
    if (cold_exact_storage_authority_for_slot(
            symbols, body, slot, kind) !=
        COLD_MANAGED_STORAGE_UNKNOWN) {
        return true;
    }
    return false;
}

/* Field access inside a generic function body must resolve the owner type
   with the function's active generic scope: `fn f[V](b: Box[V])` reading
   `b.val` resolves `Box[V]`, whose instantiation requires the function's
   [V] scope frame.  Without it the instantiation lands on a NULL visiting
   chain (scope_count=0) and the TypeNode producer rejects the application.
   Non-generic bodies fall through to the plain resolver unchanged. */
static ObjectDef *cold_postfix_resolve_object_scoped(
        Parser *parser, Span type_name) {
    if (parser && type_name.len > 0 &&
        parser->active_generic_count > 0) {
        return symbols_resolve_object_in_generic_scope(
            parser->symbols, type_name,
            parser->active_generic_names,
            parser->active_generic_count,
            parser->active_generic_binder_kind,
            parser->active_generic_binder_id);
    }
    return symbols_resolve_object(parser->symbols, type_name);
}

/* True for the destination of cold_bind_exact_managed_parameters'
   template-sentinel raw-param copy (op_c = -(formal+1)): that slot is the
   generic formal's own value incarnation, so the `param->field` arrow
   relabel must not rewrite its slot_type to the pointee name -- it is
   signature identity, exactly like the raw formal's. */
static bool cold_slot_is_generic_param_incarnation(
        BodyIR *body, int32_t slot) {
    if (!body || slot < 0 || slot >= body->slot_count) return false;
    /* An open generic formal has no concrete TypeId yet.  The parameter
       binder publishes one immutable raw-param -> working-carrier marker;
       its negative c lane is the exact formal ordinal.  Parser projections
       may refine their local semantic view but must not rewrite this
       carrier's declared slot_type.  Final BodyIR admission rejoins the same
       tuple to the producer FnDef's generic binder/declaration row. */
    for (int32_t op = 0; op < body->op_count; op++) {
        if (body->op_dst[op] != slot || body->op_c[op] >= 0 ||
            (body->op_kind[op] != BODY_OP_COPY_I64 &&
             body->op_kind[op] != BODY_OP_COPY_COMPOSITE)) {
            continue;
        }
        int32_t formal = -body->op_c[op] - 1;
        int32_t raw_slot =
            formal >= 0 && formal < body->param_count
                ? body->param_slot[formal] : -1;
        if (formal < 0 || formal >= body->param_count ||
            raw_slot < 0 || raw_slot >= body->slot_count ||
            raw_slot == slot || body->op_a[op] != raw_slot ||
            body->op_b[op] < 0 || body->op_b[op] > 1 ||
            body->op_kind[op] !=
                (body->slot_size[raw_slot] == 8
                     ? BODY_OP_COPY_I64
                     : BODY_OP_COPY_COMPOSITE) ||
            body->op_value_def_slot[op] != -1 ||
            body->op_value_def_exact_type_id[op] != -1 ||
            body->op_value_def_producer_function_row[op] != -1 ||
            body->op_value_def_place_kind[op] !=
                COLD_EXPR_PLACE_INVALID ||
            body->op_value_def_ownership[op] !=
                COLD_EXPR_OWN_INVALID ||
            body->op_value_def_origin_id[op] != -1 ||
            body->op_value_def_consume_op_index_plus_one[op] != 0 ||
            body->op_source_value_def_op_id[op] != -1 ||
            !cold_exact_slot_authority_is_sentinel(body, raw_slot) ||
            !cold_exact_slot_authority_is_sentinel(body, slot) ||
            body->slot_kind[slot] != body->slot_kind[raw_slot] ||
            body->slot_size[slot] != body->slot_size[raw_slot] ||
            !span_same(body->slot_type[slot],
                       body->slot_type[raw_slot]) ||
            body->slot_aux[slot] != body->slot_aux[raw_slot] ||
            body->slot_no_alias[slot] !=
                body->slot_no_alias[raw_slot]) {
            continue;
        }
        return true;
    }
    return false;
}

int32_t parse_postfix(Parser *parser, BodyIR *body, Locals *locals,
                      int32_t slot, int32_t *kind) {
    for (;;) {
        if (parser->pos < parser->source.len && parser->source.ptr[parser->pos] == '[') {
            ColdExprResult index_source;
            cold_expr_result_reset(&index_source);
            if (ColdActiveExprResult &&
                ColdActiveExprResultBody == body &&
                ColdActiveExprResult->slot == slot &&
                ColdActiveExprResult->kind == *kind) {
                index_source = *ColdActiveExprResult;
            }
            cold_expr_result_invalidate_active(body);
            Span idx = parse_index_bracket(parser);
            /* Global / address-shadowed fixed arrays (incl. array-of-struct) get
               upgraded to SLOT_OBJECT_REF by cold_global_ref_kind(); normalize back
               to SLOT_ARRAY_I32 at the index point so the existing struct-element /
               scalar-element branches consume arr[idx] and the loop continues onto
               .field[idx2]. Mirrors the store side (parse_seq_index_ref_from_spans). */
            if (*kind == SLOT_OBJECT_REF && slot >= 0 &&
                cold_parse_any_fixed_array_type(parser->symbols, body->slot_type[slot], 0, 0)) {
                *kind = SLOT_ARRAY_I32;
            }
            if (*kind == SLOT_STR || *kind == SLOT_STR_REF) {
                bool slice_exclusive = false;
                int32_t dots_pos = cold_span_find_range_dots(idx, &slice_exclusive);
                if (dots_pos >= 0) {
                    Span lo_span = span_trim(span_sub(idx, 0, dots_pos));
                    int32_t sep_len = slice_exclusive ? 3 : 2;
                    Span hi_span = span_trim(span_sub(idx, dots_pos + sep_len, idx.len));
                    if (lo_span.len <= 0) die("str slice start empty");
                    if (hi_span.len <= 0) die("str slice end empty");
                    int32_t lo_k = SLOT_I32, hi_k = SLOT_I32;
                    int32_t lo_s = parse_expr_from_span(parser, body, locals, lo_span, &lo_k,
                                                        "unsupported str slice start expression");
                    int32_t hi_s = parse_expr_from_span(parser, body, locals, hi_span, &hi_k,
                                                        "unsupported str slice end expression");
                    lo_s = cold_materialize_i32_ref(body, lo_s, &lo_k); if (lo_k != SLOT_I32) die("str slice start must be int32");
                    hi_s = cold_materialize_i32_ref(body, hi_s, &hi_k); if (hi_k != SLOT_I32) die("str slice end must be int32");
                    int32_t len_s = body_slot(body, SLOT_I32, 4);
                    body_op(body, BODY_OP_I32_SUB, len_s, hi_s, lo_s);
                    if (!slice_exclusive) {
                        int32_t one_s = body_slot(body, SLOT_I32, 4);
                        body_op(body, BODY_OP_I32_CONST, one_s, 1, 0);
                        body_op(body, BODY_OP_I32_ADD, len_s, len_s, one_s);
                    }
                    int32_t d = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
                    body_slot_set_type(body, d, cold_cstr_span("str"));
                    int32_t read_op = body_op3(
                        body, BODY_OP_STR_SLICE,
                        d, slot, lo_s, len_s);
                    if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=48326\n");
                    cold_publish_exact_managed_read_or_sentinel(
                        body, read_op,
                        COLD_EXACT_READ_OPERAND_A,
                        &index_source);
                    slot = d; *kind = SLOT_STR; continue;
                }
                int32_t ik = SLOT_I32, is = -1;
