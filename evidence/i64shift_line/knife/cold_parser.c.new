/* `defer` is lowered on each real function-exit CFG path, never at the
   declaration.  The parser records the exact suite source while the binding
   is activated; after the return value is stable, that suite is parsed into
   the current exit path in reverse registration order.  Therefore every
   managed read/var-out definition binds the final int32 value-def reaching
   that exit, rather than a detached declaration-time memory version. */
#define COLD_DEFER_CAP 64

typedef struct ColdDeferEntry {
    Span suite_source;
    int32_t suite_indent;
    int32_t local_count;
} ColdDeferEntry;

typedef struct ColdDeferContext {
    Parser *parser;
    BodyIR *body;
    Locals *locals;
    int32_t function_indent;
    int32_t suite_depth;
    int32_t return_block;
    int32_t return_slot;
    int32_t activation_term_start;
    int32_t parsing_entry_block;
    int32_t parsing_activation_block;
    int32_t defer_count;
    bool emitting_defer;
    bool finalized;
    ColdDeferEntry *entries;
} ColdDeferContext;

/* parse_fn is sequential and non-recursive.  The active context is arena
   owned, so recovery longjmp cannot dangle it; the next parse_fn overwrites
   it before parsing any statement, and every successful exit clears it. */
static ColdDeferContext *ColdActiveDeferContext = 0;
