            int32_t read_op = body_op3(
                body, BODY_OP_PAYLOAD_LOAD, slot,
                arg_slot, 0, COLD_STR_SLOT_SIZE);
            if (cold_exact_temp_diag_enabled()) fprintf(stderr, "([prc]) line=43300\n");
            cold_publish_exact_managed_read_or_sentinel(
                body, read_op,
                COLD_EXACT_READ_OPERAND_A,
                arg_results ? &arg_results[0] : 0);
            if (kind_out) *kind_out = SLOT_STR;
            *slot_out = slot;
            return true;
        }
        /* cstring bridge for cstring/ptr args: copy bytes into an owned str */
        {
            int32_t slot = body_slot(body, SLOT_STR, COLD_STR_SLOT_SIZE);
            body_slot_set_type(body, slot, cold_cstr_span("str"));
            int32_t zero = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, zero, 0, 0);
            int32_t one = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_I32_CONST, one, 1, 0);

            Span len_param_types[1] = {
                cold_cstr_span("cstring")};
            int32_t len_fn =
                symbols_ensure_exact_external_runtime_signature(
                    parser->symbols,
                    cold_cstr_span("cheng_cstrlen"),
                    1, len_param_types,
                    cold_cstr_span("int32"));
            if (len_fn < 0) die("failed to register cheng_cstrlen intrinsic");
            int32_t len_arg_start = body->call_arg_count;
            body_call_arg(body, arg_slot);
            int32_t len_slot = body_slot(body, SLOT_I32, 4);
            body_op(body, BODY_OP_CALL_I32, len_slot, len_fn, len_arg_start);

            Span copy_param_types[2] = {
                cold_cstr_span("ptr"),
                cold_cstr_span("int32")};
            int32_t copy_fn =
                symbols_ensure_exact_external_runtime_signature(
                    parser->symbols,
                    cold_cstr_span("driver_c_new_string_copy_n"),
                    2, copy_param_types,
                    cold_cstr_span("cstring"));
            if (copy_fn < 0) die("failed to register driver_c_new_string_copy_n intrinsic");
            int32_t copy_arg_start = body->call_arg_count;
            body_call_arg(body, arg_slot);
            body_call_arg(body, len_slot);
            int32_t copied_slot = body_slot(body, SLOT_OPAQUE, 8);
            body_slot_set_type(body, copied_slot, cold_cstr_span("cstring"));
            body_op(body, BODY_OP_CALL_I32, copied_slot, copy_fn, copy_arg_start);

            int32_t str_copy_producer =
                body_op3(body, BODY_OP_SLOT_STORE_I64, slot, copied_slot, COLD_STR_DATA_OFFSET, 0);
            body_op3(body, BODY_OP_SLOT_STORE_I32, slot, len_slot, COLD_STR_LEN_OFFSET, 0);
            body_op3(body, BODY_OP_SLOT_STORE_I32, slot, zero, COLD_STR_STORE_ID_OFFSET, 0);
            body_op3(body, BODY_OP_SLOT_STORE_I32, slot, one, COLD_STR_FLAGS_OFFSET, 0);
            body_op3(body, BODY_OP_SLOT_STORE_I32, slot, zero, COLD_STR_FLAGS_OFFSET + 4, 0);
            /* The freshly copied bytes are owned by the new str (flags=owned
               above).  Without an exact owned producer the constructed slot
               carries no authority and every downstream composite copy
               degrades to BORROW_SHARED, which any owned `return` of the
               result then rejects.  Publish at the FIRST header store: the
               slot's authority is established by the fresh copy allocation
               itself, and the read-edge completion requires the producer to
               precede every store of the header sequence. */
