# P1 bail_711 写路 repro — 镜像 #60 读路 (let tk=arr[i].key) 的对称写路。
#
# 触发点: root.seqfield[computedIdx].elemfield = scalarLit
#   即 setLast 内  s.items[s.items.len - 1].flag = true
# root=S 是 struct, seq 是其字段 items (不是 root 自身是 seq, 后者走既有
# LhsRootIsIndexed 分支); 索引为计算表达式 (len-1, 非字面常量); RHS 标量字面量。
# 跨函数 + var 借用形参, 匹配真实 bail_711 trigger (RasterGlyphSetLastEndContour)。
#
# 前端 patch (typed_expr.cheng):
#   - TypedExprAssignLhsFieldPathIndexedRoot: bracket-aware 拆 seqfield[idx] + elemfield
#   - PopulateAssignLhsMeta chained-dot 分支: ResolveFieldPathMeta(root,seqfield)
#     → SeqArrayElementType 剥元素类型 → ResolveFieldPathMeta(elemType, elemfield)
# 后端: PrimaryBodyIrAppendFieldArrayIndexedSubFieldStore 重算 seqField 偏移 +
#   元素地址, assignFieldName 保持 `items[idx].flag` 不变。
#
# 期望: 退出码 0 (flag 真被设为 true, 末元素 flag 初值 false)。

type
    T =
        flag: bool
        x: int32

    S =
        items: T[]

# P1 trigger: 写末元素的 elemfield (bool 标量字面量 true)。
fn setLast(s: var S): bool =
    if s.items.len <= 0:
        return false
    s.items[s.items.len - 1].flag = true
    return true

# 对称读路校验 (#60 族): 写后跨函数读回末元素 flag, 防 miscompile 静默。
fn readLastFlag(s: S): bool =
    if s.items.len <= 0:
        return false
    let f = s.items[s.items.len - 1].flag
    return f

fn main(): int32 =
    var s: S
    s.items = []
    # 填两个元素, 末元素 flag 初值 false, x 标记位置。
    var a: T
    a.flag = false
    a.x = 100
    add(s.items, a)
    var b: T
    b.flag = false
    b.x = 200
    add(s.items, b)
    # 触发 P1 写路。
    let ok = setLast(s)
    if !ok:
        return 7
    # 写后立即在同一函数读回 (本地可见性)。
    if !s.items[s.items.len - 1].flag:
        return 11
    # 跨函数读回 (防 node 路径跨函数丢失 store)。
    let back = readLastFlag(s)
    if !back:
        return 12
    # 前一个元素 flag 必须保持 false (防越界/误写相邻元素)。
    if s.items[0].flag:
        return 13
    # 末元素 x 不应被写破坏。
    if s.items[s.items.len - 1].x != 200:
        return 14
    return 0
