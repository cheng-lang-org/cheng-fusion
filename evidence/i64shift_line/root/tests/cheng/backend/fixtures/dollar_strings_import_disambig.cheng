# Regression for #52 (import-path variant): std/strings declares nine `$`
# overloads sharing the coarse SLOT_I32 kind (bool, char, int8, uint8,
# int16, uint16, int32, int, uint32) plus two sharing SLOT_I64 (int64,
# uint64). Before the fix, symbols_add_fn's kind-only dedup collapsed all
# nine SLOT_I32 forms into a single FnDef (survivor: whichever was declared
# last, `uint32`) and both SLOT_I64 forms into one (`uint64`) -- turning
# `$boolVar`/`$int32Var`/`$int64Var` into loud "ambiguous $ stringify
# operator" dies (ee9d45958's own honest boundary note) once the `$`
# call-site disambiguation had more than one real candidate to reason
# about, since only one candidate per kind group actually existed.
#
# A second, independent defect at the reachable-import-body scan
# (cold_import_function_symbol_matches in cheng_cold.c) also matched
# overloads by coarse kind only, so even after registration correctly
# split into nine distinct FnDefs, the WRONG overload's body (bool's, the
# first `$` line in strings.cheng) got attached to every other SLOT_I32
# sibling's function_bodies[] slot. Both must be fixed for this to pass.
import std/strings

fn main(): int32 =
    let int32Var: int32 = 42
    let int64Var: int64 = 999
    let boolVar: bool = true
    let s1: str = $int32Var
    let s2: str = $int64Var
    let s3: str = $boolVar
    if s1 != "42":
        return 1
    if s2 != "999":
        return 2
    if s3 != "true":
        return 3
    return 0
