import tests/cheng/backend/fixtures/fnsig105_r3_nestpos_base as p1

type
    Fnsig105R3NPCtx =
        hasHandler: bool
        handler: fn(b: p1.Box): int32

var gFnsig105R3NPCtx: Fnsig105R3NPCtx = Fnsig105R3NPCtx(hasHandler: false)

fn fnsig105R3NPSetHandler(handler: fn(b: p1.Box): int32) =
    gFnsig105R3NPCtx.handler = handler
    gFnsig105R3NPCtx.hasHandler = true

fn fnsig105R3NPInvoke(b: p1.Box): int32 =
    if gFnsig105R3NPCtx.hasHandler:
        return gFnsig105R3NPCtx.handler(b)
    return -1
