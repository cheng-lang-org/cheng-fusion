# #105 r4b regression lock, positive control: a nested var-field
# (SLOT_OBJECT_REF) reached through two different import aliases on each
# side of a fn(...) signature comparison must still be recognized as the
# same identity after the var-strip + recursion fix -- recursion must not
# introduce a false rejection of the same physical type.
type
    VPt =
        x: int32
        y: int32
    VBox =
        origin: var VPt
