# Hard gate ③ for #52 v2, order A: foo(bool) declared BEFORE foo(int32).
# 4 call shapes (declared-var arg x2, bare-literal arg x2) must all resolve
# to the correct overload regardless of declaration order -- this is the
# A/B half of the 8-cell matrix (mustFix-B: v1's fallback loop picked the
# FIRST-declared candidate for bare literals, so swapping declaration order
# flipped which literal-arg call got the right answer).
fn foo(x: bool): str =
    if x:
        return "bool:true"
    return "bool:false"

fn foo(x: int32): str =
    return "int32:" + IntToStr(x)

fn main(): int32 =
    let b: bool = true
    let n: int32 = 42
    if foo(b) != "bool:true":
        return 1
    if foo(n) != "int32:42":
        return 2
    if foo(true) != "bool:true":
        return 3
    if foo(42) != "int32:42":
        return 4
    return 0
