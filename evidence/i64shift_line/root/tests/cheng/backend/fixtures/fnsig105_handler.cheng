import tests/cheng/backend/fixtures/fnsig105_cbtype

fn fnsig105MyHandler(req: fnsig105_cbtype.Fnsig105CbReq): fnsig105_cbtype.Fnsig105CbReq =
    return fnsig105_cbtype.Fnsig105CbReq(id: req.id + 1, text: req.text)

fn fnsig105RegisterHandler(): int32 =
    fnsig105SetHandler(fnsig105MyHandler)
    return 0
