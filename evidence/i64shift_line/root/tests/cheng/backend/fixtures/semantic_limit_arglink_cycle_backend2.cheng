import cheng/core/backend2/backend2_lower_slots as slots
import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod

fn main(): int32 =
    var ir: texpr.TypedExprIr
    ir.arena = arenamod.ArenaInit(256, 8)
    for i in 0..<4:
        arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_nodeIndexs, i)
        arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_operand0NodeIndexs, -1)
        arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_operand1NodeIndexs, -1)
        arenamod.ArenaArrayInt32Add(ir.arena, ir.nodes2_operand2NodeIndexs, -1)
    add(ir.nodes2_opKinds, texpr.TypedExprIrOpI32Const)
    add(ir.nodes2_opKinds, texpr.TypedExprIrOpArgLink)
    add(ir.nodes2_opKinds, texpr.TypedExprIrOpArgLink)
    add(ir.nodes2_opKinds, texpr.TypedExprIrOpCallExpr)
    arenamod.ArenaArrayInt32Set(ir.arena, ir.nodes2_operand0NodeIndexs, 1, 0)
    arenamod.ArenaArrayInt32Set(ir.arena, ir.nodes2_operand1NodeIndexs, 1, 2)
    arenamod.ArenaArrayInt32Set(ir.arena, ir.nodes2_operand0NodeIndexs, 2, 0)
    arenamod.ArenaArrayInt32Set(ir.arena, ir.nodes2_operand0NodeIndexs, 3, 1)
    var values: int32[]
    if !slots.PrimaryBodyIrCollectArgLinkValueNodes(ir, 1, values):
        return 1
    if values.len != 2 || values[0] != 0 || values[1] != 0:
        return 2
    if !slots.PrimaryBodyIrCtorFieldNodeTreeResolvable(ir, 1):
        return 3
    if slots.PrimaryBodyIrArgLinkValueNodeIndexAt(ir, 1, 2, 1) != 0 ||
       slots.PrimaryBodyIrCallArgNodeIndexAt(ir, 3, 1) != 0:
        return 4
    arenamod.ArenaArrayInt32Set(ir.arena, ir.nodes2_operand1NodeIndexs, 2, 1)
    if slots.PrimaryBodyIrCollectArgLinkValueNodes(ir, 1, values):
        return 5
    if slots.PrimaryBodyIrCtorFieldNodeTreeResolvable(ir, 1):
        return 6
    if slots.PrimaryBodyIrArgLinkValueNodeIndexAt(ir, 1, 2, 1) >= 0 ||
       slots.PrimaryBodyIrCallArgNodeIndexAt(ir, 3, 1) >= 0:
        return 7
    var dag: texpr.TypedExprIr
    dag.arena = arenamod.ArenaInit(16384, 8)
    for i in 0..<300:
        arenamod.ArenaArrayInt32Add(dag.arena, dag.nodes2_nodeIndexs, i)
        var child: int32 = -1
        if i > 0:
            child = i - 1
        arenamod.ArenaArrayInt32Add(dag.arena,
                                    dag.nodes2_operand0NodeIndexs,
                                    child)
        arenamod.ArenaArrayInt32Add(dag.arena,
                                    dag.nodes2_operand1NodeIndexs,
                                    child)
        arenamod.ArenaArrayInt32Add(dag.arena,
                                    dag.nodes2_operand2NodeIndexs,
                                    -1)
        add(dag.nodes2_opKinds, texpr.TypedExprIrOpI32Const)
    if !slots.PrimaryBodyIrCtorFieldNodeTreeResolvable(dag, 299):
        return 8
    return 0
