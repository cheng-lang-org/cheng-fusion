import cheng/core/backend/regalloc_single_pass as regalloc

fn expectAction(state: var regalloc.RegallocSinglePassState,
                actionIndex: int32,
                kind: int32,
                placement: int32,
                slotIndex: int32,
                sourceReg: int32,
                targetReg: int32): bool =
    if actionIndex < 0 || actionIndex >= regalloc.RegallocSinglePassActionCount(state):
        return false
    var action: regalloc.RegallocSinglePassAction
    if !regalloc.RegallocSinglePassActionAt(state, actionIndex, action):
        return false
    return action.kind == kind &&
           action.placement == placement &&
           action.slotIndex == slotIndex &&
           action.sourceReg == sourceReg &&
           action.targetReg == targetReg

fn runContract(): int32 =
    # Linear SSA trace:
    #   slot0 input: use 0,7
    #   slot1 def 1: use 2,6
    #   slot2 def 2: use 5
    #   slot3 def 3: use 8
    #   call at 4
    # Caller pool is x13,x14; callee pool is x19.
    var facts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(4, facts): return 1
    if !regalloc.RegallocSinglePassRecordInput(facts, 0): return 2
    if !regalloc.RegallocSinglePassRecordUse(facts, 0, 0): return 3
    if !regalloc.RegallocSinglePassRecordDef(facts, 1, 1): return 4
    if !regalloc.RegallocSinglePassRecordUse(facts, 1, 2): return 5
    if !regalloc.RegallocSinglePassRecordDef(facts, 2, 2): return 6
    if !regalloc.RegallocSinglePassRecordDef(facts, 3, 3): return 7
    if !regalloc.RegallocSinglePassRecordCall(facts, 4): return 8
    if !regalloc.RegallocSinglePassRecordUse(facts, 2, 5): return 9
    if !regalloc.RegallocSinglePassRecordUse(facts, 1, 6): return 10
    if !regalloc.RegallocSinglePassRecordUse(facts, 0, 7): return 11
    if !regalloc.RegallocSinglePassRecordUse(facts, 3, 8): return 12
    if !regalloc.RegallocSinglePassFactsSealLinear(facts, 1, 0): return 13

    var callerRegs: int32[] = [13, 14]
    var calleeRegs: int32[] = [19]
    var state: regalloc.RegallocSinglePassState
    if !regalloc.RegallocSinglePassStateInit(facts, callerRegs, calleeRegs, state): return 14
    if !regalloc.RegallocSinglePassSeedInput(state, facts, 0): return 15

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 0): return 16
    if regalloc.RegallocSinglePassRead(state, facts, 0) != 19: return 17
    if regalloc.RegallocSinglePassActionCount(state) != 1: return 18
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionReload,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 0, -1, 19): return 19
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 203

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 1): return 20
    if !regalloc.RegallocSinglePassDefine(state, facts, 1): return 21
    if regalloc.RegallocSinglePassValueReg(state, 1) != 13: return 22
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionBindDef,
                     regalloc.RegallocSinglePassPlacementResultAfterOp, 1, -1, 13): return 23
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 204

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 2): return 24
    if regalloc.RegallocSinglePassRead(state, facts, 1) != 13: return 25
    if !regalloc.RegallocSinglePassDefine(state, facts, 2): return 26
    # Exact farthest-next-use: slot2(next=5) evicts clean slot0(next=7)
    # from x19.  No guessed last-use or source-order tie-break is involved.
    if regalloc.RegallocSinglePassActionCount(state) != 2: return 27
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionDrop,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 0, 19, -1): return 28
    if !expectAction(state, 1, regalloc.RegallocSinglePassActionBindDef,
                     regalloc.RegallocSinglePassPlacementResultAfterOp, 2, -1, 19): return 29
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 205

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 3): return 30
    if !regalloc.RegallocSinglePassDefine(state, facts, 3): return 31
    if regalloc.RegallocSinglePassValueReg(state, 3) != 14: return 32
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 206

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 4): return 33
    if !regalloc.RegallocSinglePassCall(state, facts): return 34
    # Call clobber is deterministic in physical-register order: x13 then x14.
    if regalloc.RegallocSinglePassActionCount(state) != 2: return 35
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionSpill,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 1, 13, -1): return 36
    if !expectAction(state, 1, regalloc.RegallocSinglePassActionSpill,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 3, 14, -1): return 37
    if regalloc.RegallocSinglePassValueReg(state, 2) != 19: return 38
    if regalloc.RegallocSinglePassValueReg(state, 1) != -1: return 201
    if regalloc.RegallocSinglePassValueReg(state, 3) != -1: return 202
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 207

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 5): return 39
    if regalloc.RegallocSinglePassRead(state, facts, 2) != 19: return 40
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 208
    if !regalloc.RegallocSinglePassBeginOp(state, facts, 6): return 41
    let slot1FinalRead = regalloc.RegallocSinglePassRead(state, facts, 1)
    if slot1FinalRead != 13: return 142
    if regalloc.RegallocSinglePassActionCount(state) != 1: return 143
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionReload,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 1, -1, 13): return 144
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 209
    if !regalloc.RegallocSinglePassBeginOp(state, facts, 7): return 43
    if regalloc.RegallocSinglePassRead(state, facts, 0) != 13: return 44
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionReload,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 0, -1, 13): return 145
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 210
    if !regalloc.RegallocSinglePassBeginOp(state, facts, 8): return 45
    if regalloc.RegallocSinglePassRead(state, facts, 3) != 13: return 46
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionReload,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 3, -1, 13): return 146
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 211

    if !regalloc.RegallocSinglePassFinish(state, facts): return 47
    if state.bindCount != 3: return 48
    if state.reloadCount != 4: return 49
    if state.spillCount != 2: return 50
    if state.dropCount != 1: return 51
    if !regalloc.RegallocSinglePassCalleeEverUsed(state, 19): return 52
    return 0

fn runPinnedOperandsContract(): int32 =
    # slot0 is final-used at op1. slot2 needs a register at the same op.
    # x13 must stay pinned for slot0, so slot2 must evict x14 instead.
    var facts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(3, facts): return 300
    if !regalloc.RegallocSinglePassRecordInput(facts, 0): return 301
    if !regalloc.RegallocSinglePassRecordInput(facts, 1): return 302
    if !regalloc.RegallocSinglePassRecordInput(facts, 2): return 303
    if !regalloc.RegallocSinglePassRecordUse(facts, 0, 0): return 304
    if !regalloc.RegallocSinglePassRecordUse(facts, 1, 0): return 305
    if !regalloc.RegallocSinglePassRecordUse(facts, 0, 1): return 306
    if !regalloc.RegallocSinglePassRecordUse(facts, 2, 1): return 307
    if !regalloc.RegallocSinglePassRecordUse(facts, 2, 2): return 308
    if !regalloc.RegallocSinglePassRecordUse(facts, 1, 3): return 309
    if !regalloc.RegallocSinglePassFactsSealLinear(facts, 1, 0): return 310

    var callerRegs: int32[] = [13, 14]
    var calleeRegs: int32[]
    var state: regalloc.RegallocSinglePassState
    if !regalloc.RegallocSinglePassStateInit(facts, callerRegs, calleeRegs, state): return 311
    if !regalloc.RegallocSinglePassSeedInput(state, facts, 0): return 312
    if !regalloc.RegallocSinglePassSeedInput(state, facts, 1): return 313
    if !regalloc.RegallocSinglePassSeedInput(state, facts, 2): return 314

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 0): return 315
    if regalloc.RegallocSinglePassRead(state, facts, 0) != 13: return 316
    if regalloc.RegallocSinglePassRead(state, facts, 1) != 14: return 317
    if regalloc.RegallocSinglePassEndOp(state): return 339
    regalloc.RegallocSinglePassClearActions(state)
    if regalloc.RegallocSinglePassBeginOp(state, facts, 1): return 318
    if !regalloc.RegallocSinglePassEndOp(state): return 319

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 1): return 320
    let firstOperandReg = regalloc.RegallocSinglePassRead(state, facts, 0)
    let secondOperandReg = regalloc.RegallocSinglePassRead(state, facts, 2)
    if firstOperandReg != 13: return 321
    if secondOperandReg != 14: return 322
    if firstOperandReg == secondOperandReg: return 323
    if regalloc.RegallocSinglePassValueReg(state, 0) != 13: return 324
    if regalloc.RegallocSinglePassValueReg(state, 2) != 14: return 325
    if regalloc.RegallocSinglePassActionCount(state) != 2: return 326
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionDrop,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 1, 14, -1): return 327
    if !expectAction(state, 1, regalloc.RegallocSinglePassActionReload,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 2, -1, 14): return 328
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 329
    if regalloc.RegallocSinglePassValueReg(state, 0) != -1: return 330

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 2): return 331
    if regalloc.RegallocSinglePassRead(state, facts, 2) != 14: return 332
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 333
    if !regalloc.RegallocSinglePassBeginOp(state, facts, 3): return 334
    if regalloc.RegallocSinglePassRead(state, facts, 1) != 13: return 335
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionReload,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 1, -1, 13): return 336
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 337
    if !regalloc.RegallocSinglePassFinish(state, facts): return 338
    return 0

fn runStoreDefContract(): int32 =
    # The only register is pinned by an operand through EndOp. A live result must
    # therefore emit StoreDef; stackValid cannot become true silently.
    var facts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(2, facts): return 400
    if !regalloc.RegallocSinglePassRecordInput(facts, 0): return 401
    if !regalloc.RegallocSinglePassRecordDef(facts, 1, 1): return 402
    if !regalloc.RegallocSinglePassRecordUse(facts, 0, 1): return 403
    if !regalloc.RegallocSinglePassRecordUse(facts, 1, 2): return 404
    if !regalloc.RegallocSinglePassFactsSealLinear(facts, 1, 0): return 405

    var callerRegs: int32[] = [13]
    var calleeRegs: int32[]
    var state: regalloc.RegallocSinglePassState
    if !regalloc.RegallocSinglePassStateInit(facts, callerRegs, calleeRegs, state): return 406
    if !regalloc.RegallocSinglePassSeedInput(state, facts, 0): return 407
    if !regalloc.RegallocSinglePassBeginOp(state, facts, 1): return 408
    if regalloc.RegallocSinglePassRead(state, facts, 0) != 13: return 409
    if !regalloc.RegallocSinglePassDefine(state, facts, 1): return 410
    if regalloc.RegallocSinglePassValueReg(state, 1) != -1: return 411
    if regalloc.RegallocSinglePassActionCount(state) != 2: return 412
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionReload,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 0, -1, 13): return 413
    if !expectAction(state, 1, regalloc.RegallocSinglePassActionStoreDef,
                     regalloc.RegallocSinglePassPlacementResultAfterOp, 1, -1, -1): return 414
    if state.storeDefCount != 1: return 415
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 416

    if !regalloc.RegallocSinglePassBeginOp(state, facts, 2): return 417
    if regalloc.RegallocSinglePassRead(state, facts, 1) != 13: return 418
    if !expectAction(state, 0, regalloc.RegallocSinglePassActionReload,
                     regalloc.RegallocSinglePassPlacementBeforeOp, 1, -1, 13): return 419
    regalloc.RegallocSinglePassClearActions(state)
    if !regalloc.RegallocSinglePassEndOp(state): return 420
    if !regalloc.RegallocSinglePassFinish(state, facts): return 421
    return 0

fn runIncompleteOperandPhaseContract(): int32 =
    # Call must not advance clobber state before every current-op use is read.
    var callFacts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(1, callFacts): return 500
    if !regalloc.RegallocSinglePassRecordInput(callFacts, 0): return 501
    if !regalloc.RegallocSinglePassRecordUse(callFacts, 0, 0): return 502
    if !regalloc.RegallocSinglePassRecordCall(callFacts, 0): return 503
    if !regalloc.RegallocSinglePassFactsSealLinear(callFacts, 1, 0): return 504
    var callCaller: int32[] = [13]
    var callCallee: int32[]
    var callState: regalloc.RegallocSinglePassState
    if !regalloc.RegallocSinglePassStateInit(callFacts,
                                             callCaller,
                                             callCallee,
                                             callState): return 505
    if !regalloc.RegallocSinglePassSeedInput(callState, callFacts, 0): return 506
    if !regalloc.RegallocSinglePassBeginOp(callState, callFacts, 0): return 507
    if regalloc.RegallocSinglePassCall(callState, callFacts): return 508
    if !callState.valid: return 509
    if callState.nextUseEventCursor != 0: return 510
    if callState.nextCallCursor != 0: return 511
    if callState.currentOpPhase != regalloc.RegallocSinglePassPhaseReads: return 512
    if regalloc.RegallocSinglePassActionCount(callState) != 0: return 513
    if regalloc.RegallocSinglePassRead(callState, callFacts, 0) != 13: return 514
    if !regalloc.RegallocSinglePassCall(callState, callFacts): return 515
    regalloc.RegallocSinglePassClearActions(callState)
    if !regalloc.RegallocSinglePassEndOp(callState): return 516
    if !regalloc.RegallocSinglePassFinish(callState, callFacts): return 517

    # Define must not bind or store a result before every operand is read.
    var defFacts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(2, defFacts): return 550
    if !regalloc.RegallocSinglePassRecordInput(defFacts, 0): return 551
    if !regalloc.RegallocSinglePassRecordUse(defFacts, 0, 0): return 552
    if !regalloc.RegallocSinglePassRecordDef(defFacts, 1, 0): return 553
    if !regalloc.RegallocSinglePassFactsSealLinear(defFacts, 1, 0): return 554
    var defCaller: int32[] = [13]
    var defCallee: int32[]
    var defState: regalloc.RegallocSinglePassState
    if !regalloc.RegallocSinglePassStateInit(defFacts,
                                             defCaller,
                                             defCallee,
                                             defState): return 555
    if !regalloc.RegallocSinglePassSeedInput(defState, defFacts, 0): return 556
    if !regalloc.RegallocSinglePassBeginOp(defState, defFacts, 0): return 557
    if regalloc.RegallocSinglePassDefine(defState, defFacts, 1): return 558
    if !defState.valid: return 559
    if defState.nextUseEventCursor != 0: return 560
    if defState.currentOpPhase != regalloc.RegallocSinglePassPhaseReads: return 561
    if defState.valueDefined[1]: return 562
    if regalloc.RegallocSinglePassActionCount(defState) != 0: return 563
    if regalloc.RegallocSinglePassRead(defState, defFacts, 0) != 13: return 564
    if !regalloc.RegallocSinglePassDefine(defState, defFacts, 1): return 565
    regalloc.RegallocSinglePassClearActions(defState)
    if !regalloc.RegallocSinglePassEndOp(defState): return 566
    if !regalloc.RegallocSinglePassFinish(defState, defFacts): return 567
    return 0

fn main(): int32 =
    # Future use is mandatory: a use-before-def fact must hard-fail admission.
    var invalidFacts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(1, invalidFacts): return 90
    if regalloc.RegallocSinglePassRecordUse(invalidFacts, 0, 0): return 91

    # Linear mode is executable contract, not a comment-only restriction.
    var cfgFacts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(0, cfgFacts): return 92
    if regalloc.RegallocSinglePassFactsSealLinear(cfgFacts, 2, 1): return 93

    # Finish rejects a declared input whose use chain was never seeded/consumed.
    var unfinishedFacts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(1, unfinishedFacts): return 94
    if !regalloc.RegallocSinglePassRecordInput(unfinishedFacts, 0): return 95
    if !regalloc.RegallocSinglePassRecordUse(unfinishedFacts, 0, 0): return 96
    if !regalloc.RegallocSinglePassFactsSealLinear(unfinishedFacts, 1, 0): return 97
    var unfinishedCaller: int32[] = [13]
    var unfinishedCallee: int32[] = [19]
    var unfinishedState: regalloc.RegallocSinglePassState
    if !regalloc.RegallocSinglePassStateInit(unfinishedFacts,
                                             unfinishedCaller,
                                             unfinishedCallee,
                                             unfinishedState): return 98
    if regalloc.RegallocSinglePassFinish(unfinishedState, unfinishedFacts): return 99

    # A call result cannot be defined before current-call clobber processing.
    var callFacts: regalloc.RegallocSinglePassFacts
    if !regalloc.RegallocSinglePassFactsInit(1, callFacts): return 100
    if !regalloc.RegallocSinglePassRecordCall(callFacts, 0): return 101
    if !regalloc.RegallocSinglePassRecordDef(callFacts, 0, 0): return 102
    if !regalloc.RegallocSinglePassFactsSealLinear(callFacts, 1, 0): return 103
    var callCaller: int32[] = [13]
    var callCallee: int32[] = [19]
    var callState: regalloc.RegallocSinglePassState
    if !regalloc.RegallocSinglePassStateInit(callFacts,
                                             callCaller,
                                             callCallee,
                                             callState): return 104
    if !regalloc.RegallocSinglePassBeginOp(callState, callFacts, 0): return 105
    if regalloc.RegallocSinglePassDefine(callState, callFacts, 0): return 106
    let baseRc = runContract()
    if baseRc != 0: return baseRc
    let pinRc = runPinnedOperandsContract()
    if pinRc != 0: return pinRc
    let storeRc = runStoreDefContract()
    if storeRc != 0: return storeRc
    return runIncompleteOperandPhaseContract()
