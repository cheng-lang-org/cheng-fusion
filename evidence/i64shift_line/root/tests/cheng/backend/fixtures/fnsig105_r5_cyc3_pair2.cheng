# period-3 mutual cycle, physical decl #2: A2 -> B2 -> C2 -> A2, structurally
# identical to pair1's A1/B1 at the shallow (0-hop, 1-hop) nodes -- ONLY
# C2's `leaf` field differs: BY-VALUE (non-var) embed of the SAME leaf type
# ZzR5Cyc3Leaf (SLOT_OBJECT instead of pair1's SLOT_OBJECT_REF) -- a pure
# "kind" mismatch two recursion hops deep into the cycle, with the leaf
# type name itself, tag field, and everything else held identical.
import tests/cheng/backend/fixtures/fnsig105_r5_cyc3_leaf

type
    ZzR5Cyc3A2 =
        val: int32
        nb: var ZzR5Cyc3B2

    ZzR5Cyc3B2 =
        val: int32
        nc: var ZzR5Cyc3C2

    ZzR5Cyc3C2 =
        val: int32
        na: var ZzR5Cyc3A2
        leaf: fnsig105_r5_cyc3_leaf.ZzR5Cyc3Leaf
