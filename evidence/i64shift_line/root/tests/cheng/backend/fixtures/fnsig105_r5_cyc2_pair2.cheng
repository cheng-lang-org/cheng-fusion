# Structurally identical mutual-recursive pair to fnsig105_r5_cyc2_pair1, but a
# DIFFERENT physical declaration (disjoint field names one hop into the
# cycle: "val" here vs "val" there is same, but let's make it genuinely
# different at the leaf so the mismatch is real and only visible after
# walking the 2-hop cycle at least once).
type
    ZzR5Cyc2A2 =
        tag: int32
        nb: var ZzR5Cyc2B2
    ZzR5Cyc2B2 =
        tag: int32
        na: var ZzR5Cyc2A2
