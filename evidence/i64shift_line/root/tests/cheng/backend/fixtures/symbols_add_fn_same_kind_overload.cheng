# Regression for #52: symbols_add_fn (bootstrap/cheng_cold.c) registered a
# fresh FnDef only when a same-name/same-arity candidate's coarse SLOT_*
# kind differed from the incoming one. bool and int32 (and every other
# scalar <= 32 bits) all lower to the same coarse SLOT_I32 kind, so two
# genuinely distinct user overloads --
#
#     fn foo(x: bool): str
#     fn foo(x: int32): str
#
# -- were treated as the SAME registration slot ("refine in place"), and
# the second declaration's body/param_type text silently clobbered the
# first's under one shared FnDef index. Every prior call to `foo` (by any
# type) then resolved to whichever overload happened to be registered/
# declared LAST, not the one the argument's own type actually named.
#
# The fix distinguishes by declared-type TEXT (not just coarse kind) at
# registration time, and closes the matching call-resolution gap so a
# same-kind call argument backed by a KNOWN declared type (a local/param,
# not a bare literal) picks its exact overload instead of the first
# kind-compatible one in declaration order.
fn foo(x: bool): str =
    if x:
        return "bool:true"
    return "bool:false"

fn foo(x: int32): str =
    return "int32:" + IntToStr(x)

fn main(): int32 =
    let b1: bool = true
    let b2: bool = false
    let n: int32 = 42
    if foo(b1) != "bool:true":
        return 1
    if foo(b2) != "bool:false":
        return 2
    if foo(n) != "int32:42":
        return 3
    return 0
