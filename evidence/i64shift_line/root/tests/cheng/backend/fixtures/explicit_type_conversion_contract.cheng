import tests/cheng/backend/fixtures/explicit_type_conversion_support as conv

type
    ExplicitTypeConversionBox = object
        value: int32
        label: str
        items: str[]

    ExplicitTypeConversionNested = object
        boxes: ExplicitTypeConversionBox[]

    ExplicitTypeConversionLocalValue = int32
    ExplicitTypeConversionLocalBox = ExplicitTypeConversionBox

var explicitTypeConversionEvaluationCount: int32

fn explicitTypeConversionBump(value: var int32) =
    value = value + 1

fn explicitTypeConversionTouch(box: var ExplicitTypeConversionBox): int32 =
    explicitTypeConversionBump(
        var ExplicitTypeConversionLocalValue(box.value))
    explicitTypeConversionBump(
        var conv.CrossValueAlias(box.value))
    let objectValue = ExplicitTypeConversionBox(box).value
    let aliasObjectValue = ExplicitTypeConversionLocalBox(box).value
    let itemCount = len(str[](box.items))
    return objectValue + aliasObjectValue + itemCount

fn explicitTypeConversionMakeBox(): ExplicitTypeConversionBox =
    explicitTypeConversionEvaluationCount =
        explicitTypeConversionEvaluationCount + 1
    return ExplicitTypeConversionBox(value: 7,
                                     label: "once",
                                     items: ["one"])

fn main(): int32 =
    var box = ExplicitTypeConversionBox(value: 40,
                                        label: "identity",
                                        items: ["one"])
    let actual = explicitTypeConversionTouch(box)
    if actual != 85:
        return 1
    if box.value != 42:
        return 2
    var values: int32[] = [10]
    explicitTypeConversionBump(var int32(values[0]))
    if values[0] != 11:
        return 3
    var nested = ExplicitTypeConversionNested(
        boxes: [ExplicitTypeConversionBox(value: 20,
                                          label: "nested",
                                          items: [])])
    explicitTypeConversionBump(var int32(nested.boxes[0].value))
    if nested.boxes[0].value != 21:
        return 4
    var cross = conv.CrossBox(value: 30)
    explicitTypeConversionBump(var conv.CrossValueAlias(cross.value))
    let qualifiedValue = conv.CrossBox(cross).value
    let qualifiedAliasValue = conv.CrossBoxAlias(cross).value
    if qualifiedValue != 31 || qualifiedAliasValue != 31:
        return 5
    let evaluatedValue =
        ExplicitTypeConversionBox(explicitTypeConversionMakeBox()).value
    if evaluatedValue != 7 || explicitTypeConversionEvaluationCount != 1:
        return 6
    return 0
