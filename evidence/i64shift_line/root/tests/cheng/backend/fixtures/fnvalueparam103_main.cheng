# Regression lock for #103, module 3 of 3 (entry module) -- see
# fnvalueparam103_cbtype.cheng for the defect this locks.
#
# main()'s own exit code carries a real runtime assertion, not just a
# compile-success check: fnvalueparam103RegisterHandler() must resolve and
# call the cross-module `fnvalueparam103SetHandler(fn(req: T): T)` (the
# call this defect made "unresolved function call" / "no same-name
# candidates"), storing fnvalueparam103MyHandler into the shared context.
# invokeHandler() then dereferences that stored fn(req: T): T slot and calls
# it for real -- return 0 only if the returned id is req.id + 1, i.e. the
# actual registered callback body ran (not a bypass/pass-through). 1 means
# the handler was registered but never actually invoked (dead slot); 2 is
# any other mismatch; 90 means registration itself failed.

import tests/cheng/backend/fixtures/fnvalueparam103_handler
import tests/cheng/backend/fixtures/fnvalueparam103_cbtype

fn main(): int32 =
    let rc: int32 = fnvalueparam103_handler.fnvalueparam103RegisterHandler()
    if rc != 0:
        return 90
    let req: fnvalueparam103_cbtype.Fnvalueparam103CbReq = fnvalueparam103_cbtype.Fnvalueparam103CbReq(id: 41, text: "x")
    let resp: fnvalueparam103_cbtype.Fnvalueparam103CbReq = fnvalueparam103_cbtype.fnvalueparam103InvokeHandler(req)
    if resp.id == 42:
        return 0
    if resp.id == 41:
        return 1
    return 2
