import tests/cheng/backend/fixtures/fnsig105_handler
import tests/cheng/backend/fixtures/fnsig105_cbtype

fn main(): int32 =
    let rc: int32 = fnsig105_handler.fnsig105RegisterHandler()
    if rc != 0:
        return 90
    let req: fnsig105_cbtype.Fnsig105CbReq = fnsig105_cbtype.Fnsig105CbReq(id: 41, text: "x")
    let resp: fnsig105_cbtype.Fnsig105CbReq = fnsig105_cbtype.fnsig105InvokeHandler(req)
    if resp.id == 42:
        return 0
    if resp.id == 41:
        return 1
    return 2
