# Hard gate ① for #52 v2: reproduces json.cheng's real `[]=(bool)/(int)/(int32)`
# overload family (all coarse SLOT_I32) with the exact three call shapes
# lsp_server.cheng uses in practice: a bare bool literal, a bare int literal,
# and a declared int32 local. Each write must land in the CORRECT overload's
# JsonNode kind (JBool vs JInt), not whichever overload happened to be
# registered/declared last (or first) in json.cheng.
import std/json as json

fn main(): int32 =
    var caps: json.JsonNode = json.newJObject()
    caps["a"] = true
    caps["b"] = 1
    let someInt32Var: int32 = 42
    caps["c"] = someInt32Var

    if json.getBool(caps["a"]) != true:
        return 1
    if json.getInt64(caps["b"]) != 1:
        return 2
    if json.getInt64(caps["c"]) != 42:
        return 3
    return 0
