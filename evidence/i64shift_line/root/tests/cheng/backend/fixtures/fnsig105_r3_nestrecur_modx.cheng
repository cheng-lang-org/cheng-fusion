# #105 r3 regression lock, isolated recursion probe: the OUTER struct uses
# the SAME bare name ("Wrap") as fnsig105_r3_nestrecur_mody.cheng's outer
# struct -- so the outer-level tail-name identity check alone treats them
# as "the same declaration" (field_count/slot_size/generic_count/tail-name
# all coincide). Only recursing into the nested `payload` field's OWN
# object identity can tell RInnerX apart from RInnerY below.
type
    RInnerX =
        a: int32
        b: int32
    Wrap =
        payload: RInnerX
