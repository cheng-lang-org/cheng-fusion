fn poolsValid(callerRegs: int32[], calleeRegs: int32[]): bool =
    if callerRegs.len != 2 || calleeRegs.len != 1:
        return false
    if callerRegs[0] != 13 || callerRegs[1] != 14:
        return false
    if calleeRegs[0] != 19:
        return false
    return true

fn main(): int32 =
    var callerRegs: int32[] = [13, 14]
    var calleeRegs: int32[] = [19]
    if !poolsValid(callerRegs, calleeRegs):
        return 1
    return 0
