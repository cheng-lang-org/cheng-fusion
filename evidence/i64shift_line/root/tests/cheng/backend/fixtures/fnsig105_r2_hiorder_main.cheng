# Regression lock for #105 r2 review-REFUTED defect 2 (high-order signature
# false rejection): a formal parameter itself typed `fn(cb: fn(x:int32):
# int32, v:int32): int32` must accept a callback whose OWN declared
# signature is 100% structurally identical. cold_fn_own_signature_text
# (which stamps a bare-function-value's own callee-side signature text)
# deliberately omits parameter NAMES, so the callee's first fn(...)-typed
# parameter shows up here as a NAMELESS `fn(x: int32): int32` item --
# structurally indistinguishable, by a naive first-depth-0-colon scan, from
# a NAMED `name: fn(...)` item (the anonymous item's own return-type colon
# sits at the same depth). Real, runnable program: baseline (no #105 check)
# already runs this correctly (exec=21); the fix must keep it running, not
# just keep it compiling.
fn fnsig105R2HiDouble(x: int32): int32 =
    return x * 2

fn fnsig105R2HiRun(cb: fn(x: int32): int32, v: int32): int32 =
    return cb(v) + 1

fn fnsig105R2HiApply(entry: fn(cb: fn(x: int32): int32, v: int32): int32, v: int32): int32 =
    return entry(fnsig105R2HiDouble, v)

fn main(): int32 =
    return fnsig105R2HiApply(fnsig105R2HiRun, 10)
