# Hard gate ③ for #52 v2, order B: foo(int32) declared BEFORE foo(bool)
# (declaration order reversed vs _gate3_a.cheng). Same 4-cell matrix must
# still resolve every call to the correct overload -- the reversed order is
# the adversarial half that falsified v1's "no regression" claim for bare
# literal args (declaration-order first-match-wins flips answers).
fn foo(x: int32): str =
    return "int32:" + IntToStr(x)

fn foo(x: bool): str =
    if x:
        return "bool:true"
    return "bool:false"

fn main(): int32 =
    let b: bool = true
    let n: int32 = 42
    if foo(b) != "bool:true":
        return 1
    if foo(n) != "int32:42":
        return 2
    if foo(true) != "bool:true":
        return 3
    if foo(42) != "int32:42":
        return 4
    return 0
