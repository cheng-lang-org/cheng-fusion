# #97 minimal repro: nested indexed object store must end after the index.
# Mirrors src/libp2p/switch.cheng closeAllConnections() field/field/index/field
# store chain: sw.connManager.items[i].open = false (object -> object -> fixed
# array -> object element -> field).

const
    maxItems = 4

type
    Conn =
        open: bool
        tag: int32

    ConnManager =
        count: int32
        items: Conn[maxItems]
        guard: int32

    Switch =
        connManager: ConnManager
        id: int32

fn initSwitch(): Switch =
    Switch(id: 42)

fn closeAllConnections(sw: var Switch): int32 =
    var closed: int32
    for i in 0..<sw.connManager.count:
        if sw.connManager.items[i].open:
            sw.connManager.items[i].open = false
            closed = closed + 1
    return closed

fn main(): int32 =
    var sw: Switch = initSwitch()
    sw.connManager.guard = 777
    sw.connManager.count = 2
    sw.connManager.items[0].open = true
    sw.connManager.items[0].tag = 1
    sw.connManager.items[1].open = true
    sw.connManager.items[1].tag = 2
    let closed: int32 = closeAllConnections(sw)
    if closed != 2:
        return 1
    if sw.connManager.items[0].open:
        return 2
    if sw.connManager.items[1].open:
        return 3
    if sw.connManager.items[0].tag != 1:
        return 4
    if sw.connManager.items[1].tag != 2:
        return 5
    if sw.connManager.guard != 777:
        return 6
    if sw.id != 42:
        return 7
    return 0
