# mustFix regression (dollarv2): cold_emit_dollar_call must resolve `$`
# overloads by the operand's exact DECLARED type text, not by a first-match
# linear scan over cold_call_args_match's loose SLOT_* kind compatibility.
#
# `int64` is declared BEFORE `int32` here on purpose: cold_call_args_match
# accepts an int32 argument for an int64 parameter (implicit widening), so a
# int32-typed operand loosely matches BOTH overloads. The pre-mustFix code
# took the first loose match in function-table order and would silently call
# the `int64` overload for an `int32` value (order-dependent miscompile,
# RC=0). The fix narrows to the candidate whose declared param type text
# equals the operand's declared type text first, independent of declaration
# order.
fn `$`(x: int64): str =
    return "I64"

fn `$`(x: int32): str =
    return "I32:" + IntToStr(x)

fn main(): int32 =
    let a: int32 = 42
    let s: str = $a
    if s != "I32:42":
        return 1
    return 0
