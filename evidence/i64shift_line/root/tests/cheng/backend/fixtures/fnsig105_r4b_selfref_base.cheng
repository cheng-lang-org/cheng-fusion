# #105 r4b regression lock, self-reference positive control: verifies the
# r4b NULL==NULL fast-path seal does NOT break real self-reference
# termination -- next: var RecSh resolves both recursion sides to the exact
# same (non-NULL) RecSh ObjectDef*, which must still hit the oa==ob fast
# path and terminate in one recursion step, never touching the depth
# budget and never reaching the new die() (that only fires when BOTH sides
# fail to resolve).
type
    RecSh =
        val: int32
        next: var RecSh
