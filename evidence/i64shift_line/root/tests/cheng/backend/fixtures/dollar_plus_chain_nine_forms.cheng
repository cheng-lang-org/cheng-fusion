# Regression for dollar_chain_parser_fix.patch's base fix (task #48): a
# `return`/`let` expression built from string-literal + `$`-unary-stringify
# + string-literal concatenation must not desync the parser after the first
# `$operand` (which used to treat the following ` + "..."` as trailing
# garbage). Covers `$` at the head/middle/tail of a `+` chain, multiple `$`
# operands in one chain, `$` nested inside a call argument, both `return`
# and `let` initializer contexts, and an object-type `$` overload (composite
# call path, not just scalar CALL_I32).
type
    Box =
        title: str
        count: int32

fn `$`(x: int32): str =
    if x == 1:
        return "N1"
    if x == 2:
        return "N2"
    if x == 3:
        return "N3"
    return "N?"

fn `$`(b: Box): str =
    return b.title

fn dupStr(s: str): str =
    return s + s

# $ at HEAD of chain
fn headChain(): str =
    let a: int32 = 1
    return $a + "-tail"

# $ at MIDDLE of chain
fn midChain(): str =
    let a: int32 = 2
    return "head-" + $a + "-tail"

# $ at TAIL of chain
fn tailChain(): str =
    let a: int32 = 3
    return "head-" + $a

# multiple $ operands in one chain
fn multiDollar(): str =
    let a: int32 = 1
    let b: int32 = 2
    return $a + "|" + $b

# $ nested inside a function-call argument
fn nestedCall(): str =
    let a: int32 = 1
    return dupStr($a + "s")

# let-context variant (not return)
fn letHead(): str =
    let a: int32 = 1
    let r: str = $a + "-tail"
    return r

fn letMid(): str =
    let a: int32 = 2
    let r: str = "head-" + $a + "-tail"
    return r

fn letTail(): str =
    let a: int32 = 3
    let r: str = "head-" + $a
    return r

# object-type $ overload (composite call path)
fn objDollar(): str =
    var b: Box = Box(title: "boxy", count: 5)
    return $b

fn main(): int32 =
    if headChain() != "N1-tail":
        return 1
    if midChain() != "head-N2-tail":
        return 2
    if tailChain() != "head-N3":
        return 3
    if multiDollar() != "N1|N2":
        return 4
    if nestedCall() != "N1sN1s":
        return 5
    if letHead() != "N1-tail":
        return 6
    if letMid() != "head-N2-tail":
        return 7
    if letTail() != "head-N3":
        return 8
    if objDollar() != "boxy":
        return 9
    return 0
