# period-3 mutual cycle, physical decl #1: A1 -> B1 -> C1 -> A1, three
# distinct nodes. C1's extra `leaf` field is a BY-REFERENCE (var) embed of
# ZzR5Cyc3Leaf (SLOT_OBJECT_REF) -- this is the ONLY difference from
# fnsig105_r5_cyc3_pair2.cheng's C2, and it is at the DEEPEST node of the
# 3-cycle (reached only after two recursion hops past A1 and B1).
import tests/cheng/backend/fixtures/fnsig105_r5_cyc3_leaf

type
    ZzR5Cyc3A1 =
        val: int32
        nb: var ZzR5Cyc3B1

    ZzR5Cyc3B1 =
        val: int32
        nc: var ZzR5Cyc3C1

    ZzR5Cyc3C1 =
        val: int32
        na: var ZzR5Cyc3A1
        leaf: var fnsig105_r5_cyc3_leaf.ZzR5Cyc3Leaf
