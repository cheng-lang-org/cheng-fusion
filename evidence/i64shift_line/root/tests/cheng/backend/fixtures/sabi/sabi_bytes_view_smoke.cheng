import std/rawbytes

@importc("SabiAcceptBytes")
fn acceptBytes(data: bytes_view): int64

@exportc("TestBytesViewSmoke")
fn testBytesViewSmoke(): int32 =
    let payload: rawbytes.Bytes = rawbytes.BytesFromString("sabi bytes\n")
    let n: int64 = acceptBytes(payload)
    if n == int64(11):
        return 0
    return 1

fn main(): int32 =
    return testBytesViewSmoke()
