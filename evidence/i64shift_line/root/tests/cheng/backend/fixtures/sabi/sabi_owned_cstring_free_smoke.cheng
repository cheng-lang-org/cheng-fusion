@ffi_owned_result(free = SabiFree)
@importc("SabiDupCString")
fn rawStrdup(text: cstring): owned_cstring

@exportc("TestOwnedCStringSmoke")
fn testOwnedCStringSmoke(): int32 =
    let text: str = rawStrdup("owned-ok")
    if text == "owned-ok":
        return 0
    return 1

fn main(): int32 =
    return testOwnedCStringSmoke()
