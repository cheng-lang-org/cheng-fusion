# #93 regression lock: assigning a 0-arity generic constructor call with an
# explicit bracket type argument (e.g. `None[T]()`, T only appears in the
# return type, never in a parameter) into an aggregate field.
#
# Root cause (fixed in this commit): `cold_ensure_specialized` /
# `cold_specialize_fn_type` only ever derived a generic function's concrete
# type argument by inferring it from the ACTUAL call args' slot types. For a
# 0-arity constructor whose type parameter appears only in the return type,
# there is nothing to infer from, so the substitution silently fell back to
# the coarse "o" kind-marker placeholder meant for a completely different
# purpose (spec-name mangling) -- baking a literal, bogus field type "o"
# into the specialized return type. The call site's own explicit bracket
# syntax (`None[MuxLike]()`) was parsed but never threaded into the
# specialization pipeline, so it was simply discarded. This also meant every
# distinct explicit instantiation of the same 0-arity generic (`None[A]()`,
# `None[B]()`, ...) mangled to the identical spec name and silently shared
# one (wrong, for all but the first) specialization.
#
# #99 addition (closes the original zero-executable-regression-lock gap on
# the mangled-name-collision half of the #93 fix): `a = wrapA()` / `return
# None[T]()` above never touch `cold_require_field_store_layout` -- that
# checker only gates AGGREGATE FIELD-STORE assignment (`obj.field = expr`),
# so it was structurally impossible for wrapA/wrapB's plain local
# reassignment to observe a collision even when one existed (confirmed by
# ablation: reverting just the mangled-name-collision branch leaves this
# file's original checks all still green). `setHolderB` below feeds a
# SECOND, differently-sized 0-arity explicit instantiation through a real
# `obj.field = None[T]()` aggregate store, the one context this codebase can
# actually observe the collision in: with the collision-avoidance branch
# reverted, MuxB's specialization reuses MuxA's (16-byte `Option[MuxA]`)
# body, and `h.slotB = None[MuxB]()` dies with `aggregate field store type
# mismatch expected_type=Option[MuxB] ... actual_type=Option[MuxA]` --
# verified red on the ablated build, green on this fix.
import cheng/libp2p/utils/option

type
    MuxA =
        id: int32
        tag: int32

    MuxB =
        code: int32

    SwLike =
        activeMuxer: Option[MuxA]

    HolderB =
        slotB: Option[MuxB]

fn stopLike(sw: var SwLike): int32 =
    sw.activeMuxer = None[MuxA]()
    return 0

fn wrapA(): Option[MuxA] =
    return None[MuxA]()

fn wrapB(): Option[MuxB] =
    return None[MuxB]()

fn setHolderB(h: var HolderB): int32 =
    h.slotB = None[MuxB]()
    return 0

fn main(): int32 =
    var sw: SwLike
    sw.activeMuxer.has = true
    sw.activeMuxer.value = MuxA(id: 99, tag: 1)
    if !sw.activeMuxer.has:
        return 1
    let _ = stopLike(sw)
    if sw.activeMuxer.has:
        return 2

    # Two distinct explicit instantiations of the same 0-arity generic
    # constructor in the same program must not collide onto one shared
    # specialization.
    var a: Option[MuxA]
    var b: Option[MuxB]
    a.has = true
    a.value = MuxA(id: 1, tag: 2)
    b.has = true
    b.value = MuxB(code: 3)
    a = wrapA()
    b = wrapB()
    if a.has:
        return 3
    if b.has:
        return 4

    # Real teeth: an aggregate FIELD-STORE assignment of the second,
    # differently-sized T -- the one context that actually routes through
    # cold_require_field_store_layout and dies on a mangled-name collision.
    var hb: HolderB
    hb.slotB.has = true
    hb.slotB.value = MuxB(code: 7)
    let _ = setHolderB(hb)
    if hb.slotB.has:
        return 5
    return 0
