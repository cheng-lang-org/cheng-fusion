# #105 r4b regression lock (absorbed from review A's fnsig105_review_a_r3
# zzvcyc_modx.cheng, independent adversarial counter-example): outer type
# uses a bare SLOT_OBJECT_REF (`var`) field so the outer identity check
# alone (same tail name "VWrap" on both sides) cannot reject the mismatch --
# only recursing into the resolved inner ObjectDef can.
type
    VRInnerX =
        a: int32
        b: int32
    VWrap =
        payload: var VRInnerX
