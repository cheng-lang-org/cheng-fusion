# NEGATIVE control (review B §4 CONFIRMED defect): registers a callback
# declared against DogShape into a slot declared for CatShape. Field shape
# coincides (both one int32 field) but the two types are unrelated physical
# declarations -- must be rejected at compile time. Pre-r3, r2's
# field-shape-only cold_object_layout_eq silently accepted this and a real
# call dispatched through the mismatched slot (exec_rc=88 proof in review).
import tests/cheng/backend/fixtures/fnsig105_r3_nma_reg
import tests/cheng/backend/fixtures/fnsig105_r3_nma_dog

fn fnsig105R3NmaDogHandler(req: fnsig105_r3_nma_dog.DogShape): int32 =
    return req.legs * 1000

fn fnsig105R3NmaRegister(): int32 =
    fnsig105_r3_nma_reg.fnsig105R3NmaSetHandler(fnsig105R3NmaDogHandler)
    return 0
