# Regression lock for #105 r2 (review §11.4 row 4 / §12.4): a fn(...)-typed
# formal parameter declared against a type reached through import alias "m1"
# must still accept a callback declared against the SAME physical type
# reached through a DIFFERENT alias "m2" in another module -- pointer
# identity of the two independently-registered ObjectDef entries is not
# the right notion of "same type" (see fnsig105_r2_aliasdiff_impl.cheng);
# field-layout equality is.
import tests/cheng/backend/fixtures/fnsig105_r2_collision_modx as m1

type
    Fnsig105R2AliasCtx =
        hasHandler: bool
        handler: fn(req: m1.Payload): int32

var gFnsig105R2AliasCtx: Fnsig105R2AliasCtx = Fnsig105R2AliasCtx(hasHandler: false)

fn fnsig105R2AliasSetHandler(handler: fn(req: m1.Payload): int32) =
    gFnsig105R2AliasCtx.handler = handler
    gFnsig105R2AliasCtx.hasHandler = true

fn fnsig105R2AliasInvoke(r: m1.Payload): int32 =
    if gFnsig105R2AliasCtx.hasHandler:
        return gFnsig105R2AliasCtx.handler(r)
    return -1
