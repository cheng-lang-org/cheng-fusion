var gFnsig105R2CollCtx: Fnsig105R2CollCtx = Fnsig105R2CollCtx(hasHandler: false)

fn fnsig105R2CollSetHandler(handler: fn(req: fnsig105_r2_collision_modx.Payload): int32) =
    gFnsig105R2CollCtx.handler = handler
    gFnsig105R2CollCtx.hasHandler = true

fn fnsig105R2CollInvoke(r: fnsig105_r2_collision_modx.Payload): int32 =
    if gFnsig105R2CollCtx.hasHandler:
