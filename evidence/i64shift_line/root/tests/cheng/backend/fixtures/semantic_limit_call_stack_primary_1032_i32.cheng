import cheng/core/backend/primary_object_plan as emit
import cheng/core/ir/core_types as coreir

fn main(): int32 =
    var call: coreir.CallOp
    for i in 0..<1033:
        add(call.argSlots, coreir.CallArgSlotConstTrue())
        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    call.targetSymbol = "semantic_limit_sink"
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    emit.PrimaryObjectPlanSetPackedStackArgsForTriple("arm64-apple-darwin")
    let stackBytes = emit.PrimaryCallOpStackArgBytes(call)
    if stackBytes != 4112:
        return 1
    if emit.PrimaryBodyIrStackAdjustWordCount(stackBytes) != 2:
        return 2
    var words: int32[]
    setLen(words, 4)
    let subEnd = emit.PrimaryBodyIRFillStackAdjustExact(words,
                                                        0,
                                                        stackBytes,
                                                        true)
    if subEnd != 2:
        return 3
    let addEnd = emit.PrimaryBodyIRFillStackAdjustExact(words,
                                                        subEnd,
                                                        stackBytes,
                                                        false)
    if addEnd != 4:
        return 4
    var bodyIR = coreir.BodyIRNew()
    add(bodyIR.callSequence, call)
    var callOp: coreir.BodyOp
    callOp.kind = coreir.BodyOpCallTag
    callOp.target = -1
    add(callOp.operands, 0)
    let callWordCount = emit.PrimaryBodyIRCallWordCount(bodyIR, callOp)
    if callWordCount != 2063:
        return 5
    var callWords: int32[]
    setLen(callWords, callWordCount)
    let callEnd = emit.PrimaryBodyIRFillCallOp(callWords,
                                               0,
                                               bodyIR,
                                               callOp,
                                               0,
                                               0,
                                               0,
                                               0)
    if callEnd != callWordCount:
        return 6
    return 0
