import std/rawbytes

fn main(): int32 =
    var a: Bytes = BytesAlloc 2
    var b: Bytes = BytesAlloc 2
    BytesSet(a, 0, 1)
    BytesSet(a, 1, 2)
    BytesSet(b, 0, 1)
    BytesSet(b, 1, 3)
    if a == b:
        return 1
    BytesSet(b, 1, 2)
    if a != b:
        return 2
    let s: str = $a
    if len(s) != 4:
        return 3
    return 0

