import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/ir/core_types as coreir
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr_type_arena as typearena

fn bindExactTypeArena(body: var coreir.BodyIR) =
    let source = "type Backend2CanonicalScalar = int32\n"
    var tree: parser.ParserValueExprTree
    var authority: typearena.TypedExprTypeResolutionAuthority
    var arena: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err) &&
           typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaComplete(arena) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "semantic limit exact TypeArena fixture")
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               body, arena.artifactRaw32),
           "semantic limit TypeArena bind")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)

fn main(): int32 =
    var body = coreir.BodyIRNew()
    bindExactTypeArena(body)
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "semantic_limit_sink"
    call.targetSourcePath =
        "tests/cheng/backend/fixtures/semantic_limit_call_stack_1032_i32.cheng"
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    for _ in 0..<1033:
        add(call.argSlots, coreir.CallArgSlotConstTrue())
        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var callOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = coreir.BodyOpCallTag
    callOp.target = -1
    add(callOp.operands, 0)
    add(body.ops, callOp)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(body, 0, 1, termIndex)
    var callTargets: str[]
    add(callTargets, "_semantic_limit_sink")
    var dataTargets: str[]
    let emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin", body, "SemanticLimitCallStack1032I32",
        0, callTargets, dataTargets, 0,
        artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid || !emission.receipt.valid ||
       emission.words.len <= 0 ||
       emission.recipes.outgoingStackBytes != 4112:
        return 1
    var stackActionCount: int32
    var sawLastStackAction = false
    for actionIndex in 0..<emission.plan.actions.len:
        let action = emission.plan.actions[actionIndex]
        if action.kind != alloc.RegallocValueActionStoreStackArg:
            continue
        stackActionCount = stackActionCount + 1
        if action.callOrdinal != 0 ||
           action.outgoingStackFrameBytes != 4112 ||
           action.outgoingStackByteWidth != 4:
            return 2
        if action.outgoingStackArgIndex == 1024 &&
           action.outgoingStackByteOffset == 4096 &&
           action.fixedOrdinal == 1032:
            sawLastStackAction = true
        if action.consumerOrdinal < 0 ||
           action.consumerOrdinal >=
               emission.receipt.actionEmissions.len ||
           emission.receipt.actionEmissions[
               action.consumerOrdinal].emittedByteLength <= 0:
            return 3
    if stackActionCount != 1025 || !sawLastStackAction:
        return 4
    return 0
