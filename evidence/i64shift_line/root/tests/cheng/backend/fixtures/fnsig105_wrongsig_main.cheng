# Negative control (expected-to-fail fixture): a callback whose own
# declared signature does NOT match the formal fn(...)-typed parameter it
# is passed to must be rejected at compile time.

type
    Fnsig105WrongReq =
        x: int32
        y: int32

    Fnsig105WrongCtx =
        hasHandler: bool
        handler: fn(req: Fnsig105WrongReq): int32

var gFnsig105WrongCtx: Fnsig105WrongCtx = Fnsig105WrongCtx(hasHandler: false)

fn fnsig105WrongSetHandler(handler: fn(req: Fnsig105WrongReq): int32) =
    gFnsig105WrongCtx.handler = handler
    gFnsig105WrongCtx.hasHandler = true

fn fnsig105WrongHandler(label: str): str =
    return label

fn main(): int32 =
    fnsig105WrongSetHandler(fnsig105WrongHandler)
    if gFnsig105WrongCtx.hasHandler:
        return 0
    return 1
