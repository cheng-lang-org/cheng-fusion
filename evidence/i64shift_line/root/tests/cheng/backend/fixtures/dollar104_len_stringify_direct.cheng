# mustFix regression (#104): the `len(x)` intrinsic must stamp its computed
# result slot with a declared-type text ("int32"), the same way an ordinary
# function call stamps its result slot with fn->ret (body_slot_set_type).
#
# Before the fix, `len(...)`'s four SLOT_I32-producing branches in
# cold_parser.c (sequence len / fixed-array len / non-str len / str len) all
# called body_slot(body, SLOT_I32, 4) but never body_slot_set_type -- the
# slot's declared-type text span stayed empty ((Span){0}). When such a
# value is used directly as a `$` stringify operand (no intervening
# `let x: int32 = len(...)` binding to carry a declared type), cold_emit_
# dollar_call's exact declared-type Pass 1 sees operand_type.len == 0 and
# skips straight to the loose SLOT-kind Pass 2 -- which is ambiguous the
# moment more than one of std/strings.cheng's bool/char/int8/uint8/int16/
# uint16/int32/int/uint32 `$` overloads is in scope, because all nine
# collapse to the same coarse SLOT_I32 kind. This produced a FALSE
# ambiguity die (len()'s return type int32 was never actually in question,
# only its type-text stamp was missing):
#   cheng_cold: ambiguous `$` stringify operator overload for operand
#   'len(s)' (no exact declared-type match and multiple SLOT-kind-compatible
#   overloads)
#
# This is the exact wall hit compiling src/libp2p/tests/
# bootstrap_wan_two_process_smoke.cheng, at unimaker_compat_ffi.cheng:4206
# (`debugNodeStep("...len=" + $len(hostPeerId))`).
import std/strings

fn main(): int32 =
    let s: str = "hello"
    let msg: str = "len=" + $len(s)
    if msg != "len=5":
        return 1
    return 0
