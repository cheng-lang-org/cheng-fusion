# Defect group (review A §11.4(b), CONFIRMED): SAME outer field name
# ("payload"), nested object is a completely different physical declaration
# that happens to share field count/size (two int32 fields) with
# Fnsig105R3NCInnerA. Must be rejected -- pre-r3 this passed silently
# because cold_object_layout_eq never recursed past the outer object's own
# field kind/size/name triple.
type
    Fnsig105R3NCInnerB2 =
        x: int32
        y: int32
    Fnsig105R3NCOuterB2 =
        payload: Fnsig105R3NCInnerB2
