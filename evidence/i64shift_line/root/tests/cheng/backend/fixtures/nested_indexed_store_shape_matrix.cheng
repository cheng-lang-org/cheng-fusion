# #97 shape matrix: store lvalue postfix chain (field/index arbitrary
# alternation) after a nested indexed object store. The bug is specifically
# in the MULTI-hop walker (>=2 field hops before the indexed array field,
# mirroring production's sw.connManager.items[i].open = false), so every
# shape below routes through r.c.<array-field>[i]... (2 hops: r -> c ->
# array field) not just r.<array-field>[i]... (1 hop, a separate branch
# that already worked before this fix and is kept here only as a regression
# check). Every write is bracketed by sentinel fields (pad / neighbor
# element / container guard / root guard) that must survive untouched so a
# wrong offset or a silently-dropped store shows up as a wrong return code,
# not just a compile success.

const
    N = 3

type
    Leaf =
        k: int32
        m: int32

    ElemPlain =
        g: int32
        pad: int32

    ElemObj =
        h: Leaf
        pad: int32

    ElemArr =
        subs: int32[N]
        pad: int32

    ElemObjArr =
        subs: Leaf[N]
        pad: int32

    Container =
        innerGuard: int32
        plainItems: ElemPlain[N]
        objItems: ElemObj[N]
        arrItems: ElemArr[N]
        objArrItems: ElemObjArr[N]
        innerTailGuard: int32

    Root =
        guard: int32
        c: Container
        topItems: ElemPlain[N]
        tailGuard: int32

fn nextIndex(base: int32): int32 =
    return base + 1

fn main(): int32 =
    var r: Root = Root()
    r.guard = 111
    r.tailGuard = 222
    r.c.innerGuard = 333
    r.c.innerTailGuard = 444

    # shape: a.b.f[i].g = v (2-hop root, single field after index)
    r.c.plainItems[0].pad = 999
    r.c.plainItems[1].pad = 888
    r.c.plainItems[0].g = 5
    if r.c.plainItems[0].g != 5:
        return 1
    if r.c.plainItems[0].pad != 999:
        return 2
    if r.c.plainItems[1].pad != 888:
        return 3
    if r.c.plainItems[1].g != 0:
        return 4

    # shape: a.b.f[i].g.h = v (index element field is itself an object)
    r.c.objItems[0].pad = 777
    r.c.objItems[0].h.m = 42
    r.c.objItems[0].h.k = 5
    if r.c.objItems[0].h.k != 5:
        return 5
    if r.c.objItems[0].h.m != 42:
        return 6
    if r.c.objItems[0].pad != 777:
        return 7

    # shape: a.b.f[i].g[j] = v (index element field is a fixed scalar array)
    r.c.arrItems[0].pad = 555
    r.c.arrItems[0].subs[0] = 11
    r.c.arrItems[0].subs[1] = 22
    r.c.arrItems[0].subs[2] = 33
    if r.c.arrItems[0].subs[0] != 11:
        return 8
    if r.c.arrItems[0].subs[1] != 22:
        return 9
    if r.c.arrItems[0].subs[2] != 33:
        return 10
    if r.c.arrItems[0].pad != 555:
        return 11

    # shape: a.b.f[i].g[j].k = v (index element field is a fixed array of objects)
    r.c.objArrItems[0].pad = 444
    r.c.objArrItems[0].subs[0].m = 61
    r.c.objArrItems[0].subs[0].k = 7
    r.c.objArrItems[0].subs[1].k = 8
    if r.c.objArrItems[0].subs[0].k != 7:
        return 12
    if r.c.objArrItems[0].subs[0].m != 61:
        return 13
    if r.c.objArrItems[0].subs[1].k != 8:
        return 14
    if r.c.objArrItems[0].pad != 444:
        return 15

    # shape: complex index expression (i+1, function return) through the
    # same multi-hop chain
    var idx: int32 = 0
    r.c.plainItems[idx + 1].g = 66
    if r.c.plainItems[1].g != 66:
        return 16
    if r.c.plainItems[0].g != 5:
        return 17
    r.c.plainItems[nextIndex(1)].g = 77
    if r.c.plainItems[2].g != 77:
        return 18

    # shape: read side and write side share the same multi-hop chain shape
    r.c.plainItems[0].g = r.c.plainItems[2].g
    if r.c.plainItems[0].g != 77:
        return 19

    # regression: pre-existing 1-hop indexed store path (root -> array
    # field directly, no intermediate object hop) must still work.
    r.topItems[0].pad = 123
    r.topItems[0].g = 9
    if r.topItems[0].g != 9:
        return 20
    if r.topItems[0].pad != 123:
        return 21
    if r.topItems[1].g != 0:
        return 22

    # sentinels at every layer: no nested write ever touched a container
    # header field it should not have touched.
    if r.guard != 111:
        return 23
    if r.tailGuard != 222:
        return 24
    if r.c.innerGuard != 333:
        return 25
    if r.c.innerTailGuard != 444:
        return 26

    return 0
