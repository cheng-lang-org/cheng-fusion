# POSITIVE control: registers a callback declared against the SAME physical
# struct (fnsig105_r2_collision_modx.Payload) reached through a DIFFERENT
# import alias ("m2" here vs "m1" in the registering module). Must compile
# and, once actually invoked, run the real registered body.
import tests/cheng/backend/fixtures/fnsig105_r2_aliasdiff_reg
import tests/cheng/backend/fixtures/fnsig105_r2_collision_modx as m2

fn fnsig105R2AliasHandler(req: m2.Payload): int32 =
    return req.a + req.b

fn fnsig105R2AliasRegister(): int32 =
    fnsig105_r2_aliasdiff_reg.fnsig105R2AliasSetHandler(fnsig105R2AliasHandler)
    return 0
