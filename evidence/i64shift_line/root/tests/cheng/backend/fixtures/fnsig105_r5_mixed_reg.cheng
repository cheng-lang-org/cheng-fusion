import tests/cheng/backend/fixtures/fnsig105_r5_mixed_outera as p1

type
    ZzR5MixRegCtx =
        hasHandler: bool
        handler: fn(o: p1.ZzR5MixOuterA): int32

var gZzR5MixRegCtx: ZzR5MixRegCtx = ZzR5MixRegCtx(hasHandler: false)

fn zzR5MixSetHandler(h: fn(o: p1.ZzR5MixOuterA): int32) =
    gZzR5MixRegCtx.handler = h
    gZzR5MixRegCtx.hasHandler = true

fn zzR5MixInvoke(o: p1.ZzR5MixOuterA): int32 =
    if gZzR5MixRegCtx.hasHandler:
        return gZzR5MixRegCtx.handler(o)
