# period-2 mutual cycle, module B: see fnsig105_r5_p2tail_moda.cheng --
# ZzR5P2A here has the SAME bare name and SAME outer field shape as modA's
# ZzR5P2A, but its nested B field resolves to ZzR5P2By (disjoint tail name
# from modA's ZzR5P2Bx, otherwise identical field shape) -- the mismatch is
# only visible one recursion hop past the outer A-vs-A comparison.
type
    ZzR5P2By =
        val: int32
        na: var ZzR5P2A

    ZzR5P2A =
        val: int32
        nb: var ZzR5P2By
