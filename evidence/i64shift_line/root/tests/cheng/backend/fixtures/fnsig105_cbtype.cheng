# Regression lock for #105: symbols_find_fn_for_call (and the shared
# matching primitives that feed it, cold_call_args_match /
# cold_validate_call_args) compared a fn(...)-typed call argument only by
# its coarse SLOT_PTR "is a function pointer" kind -- never the passed
# callback's own declared parameter/return types against the formal
# parameter's declared fn(...) signature text.

type
    Fnsig105CbReq =
        id: int32
        text: str

    Fnsig105CbCtx =
        hasHandler: bool
        handler: fn(req: Fnsig105CbReq): Fnsig105CbReq

var gFnsig105CbCtx: Fnsig105CbCtx = Fnsig105CbCtx(hasHandler: false)

fn fnsig105SetHandler(handler: fn(req: Fnsig105CbReq): Fnsig105CbReq) =
    gFnsig105CbCtx.handler = handler
    gFnsig105CbCtx.hasHandler = true

fn fnsig105InvokeHandler(r: Fnsig105CbReq): Fnsig105CbReq =
    if gFnsig105CbCtx.hasHandler:
        return gFnsig105CbCtx.handler(r)
    return r
