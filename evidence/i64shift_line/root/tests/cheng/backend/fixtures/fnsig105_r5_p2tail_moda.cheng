# period-2 mutual cycle, module A: outer type ZzR5P2A shares its BARE name
# with the independently-declared ZzR5P2A in fnsig105_r5_p2tail_modb.cheng
# (same idiom as r1-r4 same-bare-name-different-module collision fixtures)
# -- same outer shape (val: int32, nb: var <B>) so the top-level identity
# check passes; only the nested B type's own tail name differs from modb's
# (Bx here vs By there), one hop deeper.
type
    ZzR5P2Bx =
        val: int32
        na: var ZzR5P2A

    ZzR5P2A =
        val: int32
        nb: var ZzR5P2Bx
