# Regression lock for #100: symbols_resolve_object bare (unqualified)
# non-generic object type name never resolved when the ONLY registered
# ObjectDef for it carries a cross-module-qualified name.
#
# Mirrors the real production shape (unimaker_compat_ffi.cheng): a struct
# type declared and referenced by its bare, unqualified spelling from WITHIN
# the same module (as it always is, from that module's own point of view),
# while the compiling unit registers the ObjectDef under an import-qualified
# name because this file itself gets pulled in as an import elsewhere (see
# the sibling _main fixture). `fooPtrAt()` returns `Objresolve100BareptrTarget*`;
# `*p` dereferenced at a `clearFoo(f: var Objresolve100BareptrTarget)` call
# site must resolve to SLOT_OBJECT_REF (pass the same address through) via
# cold_resolve_pointer_object -> symbols_resolve_object("Objresolve100BareptrTarget")
# finding the sole `<alias>.Objresolve100BareptrTarget` ObjectDef by
# last-component match -- not silently fall back to a raw SLOT_PTR load
# (BODY_OP_PTR_LOAD_I64) which reads the object's first 8 bytes as if it
# were "another pointer" and fails call resolution downstream.
#
# Type name is deliberately unique (not a generic "Foo") -- this repo's
# whole-tree symbol scan means a common bare name colliding with some other
# file's unrelated same-named type would make the last-component match
# ambiguous (found_count>1), which the fix conservatively refuses to guess
# through (by design, matching the existing same-function fallbacks) --
# that is a scale property of the technique itself, not something this lock
# should paper over with a distinctive-enough name to test the fix in
# isolation.

type
    Objresolve100BareptrTarget =
        x: int32
        guard: int32

var
    gObjresolve100BareptrTarget0: Objresolve100BareptrTarget

fn fooPtrAt(): Objresolve100BareptrTarget* =
    return &gObjresolve100BareptrTarget0

fn clearFoo(f: var Objresolve100BareptrTarget) =
    f.x = 0

fn initFoo(): int32 =
    let p: Objresolve100BareptrTarget* = fooPtrAt()
    p->guard = 424242
    p->x = 99
    clearFoo(*p)
    if p->x != 0:
        return 1
    if p->guard != 424242:
        return 2
    return 0
