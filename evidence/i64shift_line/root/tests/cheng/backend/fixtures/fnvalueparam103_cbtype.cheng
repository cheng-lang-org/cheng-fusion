# Regression lock for #103: cold_imported_param_specs' manual type-span
# scanner (bootstrap/cold_parser.c, inside cold_imported_param_specs) tracked
# bracket depth for `[...]` (generic args) but not paren depth for `(...)`.
# A parameter whose own type is itself a function type containing nested
# parens -- `handler: fn(req: T): T` -- made the scanner stop at the nested
# closing ')' (the one that closes `fn(req: T)`), truncating the type text
# mid-signature and leaving the trailing `): T` tail to be misparsed as a
# spurious SECOND parameter (name="`)`", type="T"). The cross-module
# registered signature ended up with arity=2 instead of the true arity=1,
# so any real call site passing exactly one argument could never match by
# arity and fell through to "unresolved function call" / "no same-name
# candidates" -- this is what production hit at
# unimaker_compat_ffi.cheng:4199 (`setDmEnvelopeHandler(mobileDmEnvelopeHandler)`,
# callee declared in the independent module dmenvelope.cheng).
#
# This lock isolates the shape: a struct type, a context holding a
# `fn(req: T): T` handler slot, a setter taking that function-typed
# parameter, and a getter that actually invokes the stored handler (so the
# sibling _main fixture can assert a real runtime callback invocation, not
# just that compilation succeeds).

type
    Fnvalueparam103CbReq =
        id: int32
        text: str

    Fnvalueparam103CbCtx =
        hasHandler: bool
        handler: fn(req: Fnvalueparam103CbReq): Fnvalueparam103CbReq

var
    gFnvalueparam103CbCtx: Fnvalueparam103CbCtx = Fnvalueparam103CbCtx(hasHandler: false)

fn fnvalueparam103SetHandler(handler: fn(req: Fnvalueparam103CbReq): Fnvalueparam103CbReq) =
    gFnvalueparam103CbCtx.handler = handler
    gFnvalueparam103CbCtx.hasHandler = true

fn fnvalueparam103InvokeHandler(r: Fnvalueparam103CbReq): Fnvalueparam103CbReq =
    if gFnvalueparam103CbCtx.hasHandler:
        return gFnvalueparam103CbCtx.handler(r)
    return r
