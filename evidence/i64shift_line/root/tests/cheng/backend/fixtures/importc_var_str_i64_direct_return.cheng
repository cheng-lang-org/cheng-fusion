import std/system

@importc("cheng_exec_cmd_ex")
fn cheng_exec_cmd_ex_raw(command: cstring, workingDir: cstring, mergeStderr: int32, exitCode: var int64): cstring

fn main(): int32 =
    var exitCode64: int64 = -1
    let raw: cstring = cheng_exec_cmd_ex_raw("", "", 0, exitCode64)
    let _output1: str = system.StrFromCStringBorrow(raw)
    return int32(exitCode64)
