# NEGATIVE control: registers a callback declared against the OTHER
# (structurally unrelated) same-bare-name Payload. Must be rejected at
# compile time -- pre-r2, this silently compiled and, if actually invoked,
# read the wrong struct layout through the mismatched fn(...) slot.
import tests/cheng/backend/fixtures/fnsig105_r2_collision_reg
import tests/cheng/backend/fixtures/fnsig105_r2_collision_mody

fn fnsig105R2CollHandler(req: fnsig105_r2_collision_mody.Payload): int32 =
    return 999

fn fnsig105R2CollRegister(): int32 =
    fnsig105_r2_collision_reg.fnsig105R2CollSetHandler(fnsig105R2CollHandler)
    return 0
