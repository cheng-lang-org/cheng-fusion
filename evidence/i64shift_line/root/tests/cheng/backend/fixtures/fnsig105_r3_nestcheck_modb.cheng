# Control group (review A §11.4(a)): different outer field NAME ("other" vs
# "payload") -- must still reject regardless of nested recursion, confirms
# the comparator is actually inspecting fields, not short-circuiting earlier.
type
    Fnsig105R3NCInnerB =
        x: int32
        y: int32
    Fnsig105R3NCOuterB =
        other: Fnsig105R3NCInnerB
