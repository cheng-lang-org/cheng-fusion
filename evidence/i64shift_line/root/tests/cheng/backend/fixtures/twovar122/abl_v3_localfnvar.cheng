# ablation V3: same two-var-field struct (>16B), but dispatch through a LOCAL fn variable instead of a struct field
type
    ProbeB3 =
        v: int32
        selfB: var ProbeB3
    ProbeA3 =
        val: int32
        selfA: var ProbeA3
        toB: var ProbeB3

fn myHandler(o: ProbeA3): int32 =
    return 555

fn invoke(o: ProbeA3): int32 =
    var h: fn(o: ProbeA3): int32 = myHandler
    return h(o)

fn main(): int32 =
    var o: ProbeA3
    return invoke(o)
