# ablation V4: same struct shape as probe2 (2 var fields, 24B) but invoke calls handler directly stored
# in a plain global fn variable (not nested inside another struct field) -- isolates "struct-field fn"
# vs "top-level fn var" as the indirection carrier
type
    ProbeB4 =
        v: int32
        selfB: var ProbeB4
    ProbeA4 =
        val: int32
        selfA: var ProbeA4
        toB: var ProbeB4

var gHandler: fn(o: ProbeA4): int32

fn setHandler(h: fn(o: ProbeA4): int32) =
    gHandler = h

fn invoke(o: ProbeA4): int32 =
    return gHandler(o)

fn myHandler(o: ProbeA4): int32 =
    return 555

fn main(): int32 =
    setHandler(myHandler)
    var o: ProbeA4
    return invoke(o)
