# isolation probe #2: same as probe1 but through the SetHandler/Invoke
# indirect fn-field dispatch pattern (matches zzr5x's structure), still
# single-module (no cross-alias).
type
    ProbeB2 =
        v: int32
        selfB: var ProbeB2
    ProbeA2 =
        val: int32
        selfA: var ProbeA2
        toB: var ProbeB2
    RegCtx2 =
        hasHandler: bool
        handler: fn(o: ProbeA2): int32

var gCtx: RegCtx2 = RegCtx2(hasHandler: false)

fn setHandler(h: fn(o: ProbeA2): int32) =
    gCtx.handler = h
    gCtx.hasHandler = true

fn invoke(o: ProbeA2): int32 =
    if gCtx.hasHandler:
        return gCtx.handler(o)
    return -1

fn myHandler(o: ProbeA2): int32 =
    return 555

fn main(): int32 =
    setHandler(myHandler)
    var o: ProbeA2
    return invoke(o)
