# isolation probe: does a struct with TWO var(ref) fields crash on plain
# uninitialized local decl + pass-by-value, with ZERO cross-module alias
# involvement (i.e. completely unrelated to #105's equality check)?
type
    ProbeB =
        v: int32
        selfB: var ProbeB
    ProbeA =
        val: int32
        selfA: var ProbeA
        toB: var ProbeB

fn handle(o: ProbeA): int32 =
    return 555

fn main(): int32 =
    var o: ProbeA
    return handle(o)
