# ablation V2: struct >16 bytes with NO var/self-ref fields at all (3 plain int64), through same fn-field dispatch pattern
type
    PlainBig =
        a: int64
        b: int64
        c: int64
    RegCtxP =
        hasHandler: bool
        handler: fn(o: PlainBig): int32

var gCtx: RegCtxP = RegCtxP(hasHandler: false)

fn setHandler(h: fn(o: PlainBig): int32) =
    gCtx.handler = h
    gCtx.hasHandler = true

fn invoke(o: PlainBig): int32 =
    if gCtx.hasHandler:
        return gCtx.handler(o)
    return -1

fn myHandler(o: PlainBig): int32 =
    return 555

fn main(): int32 =
    setHandler(myHandler)
    var o: PlainBig
    return invoke(o)
