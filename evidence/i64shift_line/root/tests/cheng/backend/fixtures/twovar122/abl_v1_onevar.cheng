# ablation V1: ONE var field only (struct = val:int32 + selfA:var ProbeA = 16 bytes), through fn-field indirect dispatch
type
    ProbeA1 =
        val: int32
        selfA: var ProbeA1
    RegCtx1 =
        hasHandler: bool
        handler: fn(o: ProbeA1): int32

var gCtx: RegCtx1 = RegCtx1(hasHandler: false)

fn setHandler(h: fn(o: ProbeA1): int32) =
    gCtx.handler = h
    gCtx.hasHandler = true

fn invoke(o: ProbeA1): int32 =
    if gCtx.hasHandler:
        return gCtx.handler(o)
    return -1

fn myHandler(o: ProbeA1): int32 =
    return 555

fn main(): int32 =
    setHandler(myHandler)
    var o: ProbeA1
    return invoke(o)
