# See fnsig105_r3_nestrecur_modx.cheng. Same outer bare name "Wrap", same
# outer field layout (one SLOT_OBJECT field named "payload", same byte
# size) -- but the nested object is a totally different physical
# declaration (RInnerY, disjoint field names from RInnerX).
type
    RInnerY =
        x: int32
        y: int32
    Wrap =
        payload: RInnerY
