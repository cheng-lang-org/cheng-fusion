type
    ExplicitVarConversionConstructorBox = object
        value: int32

fn explicitVarTypeConversionConstructorReject(
        value: var ExplicitVarConversionConstructorBox) =
    value.value = value.value + 1

fn main(): int32 =
    explicitVarTypeConversionConstructorReject(
        var ExplicitVarConversionConstructorBox(
            ExplicitVarConversionConstructorBox(value: 1)))
    return 0
