# #105 r4b regression lock, negative: a var-field (SLOT_OBJECT_REF)
# parameter type mismatch that r3's cold_object_layout_eq_at recursion
# silently accepted (dead code: symbols_resolve_object never strips the
# `var ` prefix, both sides resolve to NULL, the oa==ob fast path then
# treats NULL==NULL as "same identity"). r4b strips `var` before resolving
# and turns "both sides fail to resolve" into a loud die(), so registering
# fnsig105R4bVwHandlerY(o: t2.VWrap) [payload: var VRInnerY] into a slot
# declared fn(o: t1.VWrap): int32 [payload: var VRInnerX] must be rejected
# at compile time (rc=2), never silently linked and run.
import tests/cheng/backend/fixtures/fnsig105_r4b_varref_reg
import tests/cheng/backend/fixtures/fnsig105_r4b_varref_impl
import tests/cheng/backend/fixtures/fnsig105_r4b_varref_modx as t3

fn main(): int32 =
    let rc: int32 = fnsig105_r4b_varref_impl.fnsig105R4bVwRegisterY()
    var o: t3.VWrap
    return fnsig105_r4b_varref_reg.fnsig105R4bVwInvoke(o)
