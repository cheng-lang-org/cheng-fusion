fn main(): int32 =
    var sum: int32
    for outer in 0..<1:
        let selectedStart = outer + 2
        let selectedEnd = selectedStart + 2
        if selectedEnd < selectedStart:
            return 1
        for lineNumber in selectedStart..selectedEnd:
            sum = sum + lineNumber
    if sum == 9:
        return 0
    return 1
