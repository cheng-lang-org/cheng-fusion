# turn_ops_load_client: concurrent-allocation load smoke for the standalone exe.
#
# Drives N=10 Allocate round-trips from ONE client UDP socket (same source IP).
# With --max-per-ip implicit cap (turnMaxPerIp=8 in turn_server_main), the first
# 8 should succeed and the 9th+ should be rejected with a 508 error response
# (TurnAllocCreate returns -2 -> "Rate Limited"). Prints the success/reject tally
# so the load smoke verifies rate limiting + metrics counters end-to-end.

import std/system
import std/result
import std/rawbytes
import std/os
import std/net/transports/udp_syscall as udp
import std/stun/turn_protocol as turn
import std/stun/turn_auth as auth

const
    solSocket = 65535
    soRcvTimeo = 4102
    recvTimeoutSec = 5
    serverHost = "127.0.0.1"
    serverPort = 13478
    realmStr = "unimaker.fun"
    restSecretStr = "test"
    peerId = "loadA"
    expiry = 1735689600
    totalAllocs = 10

var
    txidCounter: int32
    gFamily: int32

fn nextTxid(): rawbytes.Bytes =
    txidCounter = txidCounter + 1
    let out: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(out, i, (txidCounter * 7 + i) & 255)
    return out

fn setRecvTimeout(fd: int32): int32 =
    let tv: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    rawbytes.BytesSet(tv, 0, recvTimeoutSec)
    return os.UdpSetSockOptIntFd(fd, solSocket, soRcvTimeo, tv)

fn openClient(outFd: var int32): int32 =
    let sockRes = udp.UdpSocketOpenDgram(false)
    if IsErr(sockRes):
        return 1
    let sock = Value(sockRes)
    outFd = sock.fd
    gFamily = sock.family
    let _ = setRecvTimeout(sock.fd)
    return 0

fn buildDst(out: var udp.UdpSockAddr): int32 =
    let addrRes = udp.UdpSockAddrFromHostPort(serverHost, serverPort, false, gFamily, false, out)
    if IsErr(addrRes):
        return 1
    return 0

fn clientRecv(fd: int32, out: var rawbytes.Bytes): int32 =
    let ready: int32 = os.UdpFdWaitReadable(fd, 5000)
    if ready <= 0:
        return 1
    var recv: udp.UdpRecvResult
    let recvRes = udp.UdpRecvFromNonblock(fd, 1500, recv)
    if IsErr(recvRes):
        return 1
    out = recv.data
    return 0

# One Allocate attempt. Returns 0 success, 1 rate-limited (508), 2 other error.
# `outPort` receives the relayed port on success (ignored by the caller here).
# One Allocate attempt from a FRESH source port (distinct 5-tuple) so the per-IP
# rate limit is exercised rather than the 437 allocation-mismatch path. Opens its
# own UDP socket, runs the 401->auth retry, closes it. Returns 0 success,
# 1 rate-limited (allocate error), 2 other error. `outPort` gets the relayed port.
fn runOneAlloc(software: rawbytes.Bytes, outPort: var int32): int32 =
    var fd: int32
    if openClient(fd) != 0:
        return 2
    let realmBytes: rawbytes.Bytes = rawbytes.BytesFromString(realmStr)
    let secret: rawbytes.Bytes = rawbytes.BytesFromString(restSecretStr)
    let username: str = auth.TurnRestUsername(int64(expiry), peerId)
    let userBytes: rawbytes.Bytes = rawbytes.BytesFromString(username)
    let key: rawbytes.Bytes = auth.TurnRestLongTermKey(username, realmStr, secret)
    var dst: udp.UdpSockAddr
    if buildDst(dst) != 0:
        let _ = os.UdpCloseFd(fd)
        return 2
    let txid1: rawbytes.Bytes = nextTxid()
    let req1: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid1, turn.TurnProtoUdp(), 600, false, software)
    let s1 = udp.UdpSendTo(fd, req1, dst)
    if IsErr(s1):
        let _ = os.UdpCloseFd(fd)
        return 2
    var ch401: rawbytes.Bytes
    if clientRecv(fd, ch401) != 0:
        let _ = os.UdpCloseFd(fd)
        return 2
    if !turn.TurnIsAllocateError(ch401):
        let _ = os.UdpCloseFd(fd)
        return 2
    let nonceBytes: rawbytes.Bytes = turn.TurnDecodeNonce(ch401)
    let txid2: rawbytes.Bytes = nextTxid()
    let req2: rawbytes.Bytes = turn.TurnEncodeAllocateRequestAuth(txid2, turn.TurnProtoUdp(), 600, false, software, userBytes, realmBytes, nonceBytes, key)
    let s2 = udp.UdpSendTo(fd, req2, dst)
    if IsErr(s2):
        let _ = os.UdpCloseFd(fd)
        return 2
    var resp: rawbytes.Bytes
    if clientRecv(fd, resp) != 0:
        let _ = os.UdpCloseFd(fd)
        return 2
    let _ = os.UdpCloseFd(fd)
    if turn.TurnIsAllocateSuccess(resp):
        let dec: turn.TurnAllocateResp = turn.TurnDecodeAllocateResponse(resp, txid2)
        outPort = dec.relayedPort
        return 0
    let mt: int32 = turn.TurnMessageType(resp)
    if mt == turn.TurnAllocateErrorType():
        return 1
    return 2

fn main(): int32 =
    let software: rawbytes.Bytes = rawbytes.BytesFromString("load-client")
    var ok: int32 = 0
    var limited: int32 = 0
    var other: int32 = 0
    var k: int32
    for k in k..<totalAllocs:
        var rp: int32
        let r: int32 = runOneAlloc(software, rp)
        if r == 0:
            ok = ok + 1
        elif r == 1:
            limited = limited + 1
        else:
            other = other + 1
    echo(Fmt"load tally ok={ok} rate_limited={limited} other={other}")
    if ok > 0 && limited > 0 && other == 0:
        echo("turn_ops_load_client ok")
        return 0
    echo("turn_ops_load_client FAIL")
    return 1
