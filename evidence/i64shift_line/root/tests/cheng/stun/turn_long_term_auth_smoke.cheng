# turn_long_term_auth_smoke: RFC 5389 long-term credential challenge/retry.
#
# 1. Client sends an Allocate Request with no credentials.
# 2. Server rejects with a 401 Allocate Error Response carrying REALM + NONCE.
# 3. Client extracts REALM/NONCE, builds the long-term key
#    MD5(username ":" realm ":" password), and resends the Allocate Request
#    with USERNAME + REALM + NONCE + MESSAGE-INTEGRITY + FINGERPRINT.
# 4. Server verifies MI and replies with an Allocate Success Response.
# 5. Client decodes XOR-RELAYED-ADDRESS + LIFETIME and verifies MI/FP.

import std/system
import std/rawbytes
import std/stun/turn_protocol as turn
import std/stun/turn_auth as auth

fn makeTxid(): rawbytes.Bytes =
    let txid: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(txid, i, i + 11)
    return txid

fn makeIpv4(a: int32, b: int32, c: int32, d: int32): rawbytes.Bytes =
    let ip: rawbytes.Bytes = rawbytes.BytesAlloc(4)
    rawbytes.BytesSet(ip, 0, a)
    rawbytes.BytesSet(ip, 1, b)
    rawbytes.BytesSet(ip, 2, c)
    rawbytes.BytesSet(ip, 3, d)
    return ip

fn checkLongTermAuth(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage1")
    let realm: str = "example.org"
    let realmBytes: rawbytes.Bytes = rawbytes.BytesFromString(realm)
    let nonce: rawbytes.Bytes = rawbytes.BytesFromString("bd8as92Kdf02Jd72vMaPwcBNds7i40tn")
    let user: str = "alice"
    let userBytes: rawbytes.Bytes = rawbytes.BytesFromString(user)
    let pass: str = "secret"
    # 1. unauthenticated Allocate Request
    let req1: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid, turn.TurnProtoUdp(), 600, false, software)
    assert(turn.TurnIsAllocateRequest(req1), "step1 allocate request type")
    # 2. server 401 challenge with REALM + NONCE
    let ch401: rawbytes.Bytes = turn.TurnEncodeAllocate401(txid, realmBytes, nonce, software, rawbytes.EmptyBytes())
    assert(turn.TurnIsAllocateError(ch401), "401 is allocate error type")
    assert(auth.TurnVerifyFingerprint(ch401), "401 fingerprint")
    assert(rawbytes.BytesEqual(turn.TurnDecodeRealm(ch401), realmBytes), "401 realm")
    assert(rawbytes.BytesEqual(turn.TurnDecodeNonce(ch401), nonce), "401 nonce")
    # 3. client resends with USERNAME + REALM + NONCE + MI
    let key: rawbytes.Bytes = auth.TurnLongTermKey(user, realm, pass)
    let req2: rawbytes.Bytes = turn.TurnEncodeAllocateRequestAuth(txid, turn.TurnProtoUdp(), 600, false, software, userBytes, realmBytes, nonce, key)
    assert(turn.TurnIsAllocateRequest(req2), "step3 allocate request type")
    assert(auth.TurnVerifyMessageIntegrity(req2, key), "step3 MI verified")
    assert(auth.TurnVerifyFingerprint(req2), "step3 fingerprint")
    let wrongKey: rawbytes.Bytes = auth.TurnLongTermKey(user, realm, "wrong")
    assert(!auth.TurnVerifyMessageIntegrity(req2, wrongKey), "step3 MI rejects wrong password")
    # 4. server success response
    let relayedIp: rawbytes.Bytes = makeIpv4(192, 0, 2, 99)
    let relayedPort: int32 = 7000
    let resp: rawbytes.Bytes = turn.TurnEncodeAllocateResponse(txid, relayedIp, relayedPort, 600, rawbytes.EmptyBytes(), false, key, software)
    assert(turn.TurnIsAllocateSuccess(resp), "step4 allocate success type")
    assert(auth.TurnVerifyMessageIntegrity(resp, key), "step4 MI verified")
    # 5. client decode
    let dec: turn.TurnAllocateResp = turn.TurnDecodeAllocateResponse(resp, txid)
    assert(dec.hasRelayed, "step5 has relayed")
    assert(dec.relayedPort == relayedPort, "step5 relayed port")
    assert(rawbytes.BytesEqual(dec.relayedIp, relayedIp), "step5 relayed ip")
    assert(dec.lifetime == 600, "step5 lifetime")
    echo("turn_long_term_auth_smoke: challenge/retry ok")
    return 0

fn main(): int32 =
    let r1: int32 = checkLongTermAuth()
    if r1 != 0:
        return r1
    echo("turn_long_term_auth_smoke ok")
    return 0
