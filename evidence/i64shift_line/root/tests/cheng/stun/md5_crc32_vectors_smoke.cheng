import std/system
import std/rawbytes
import std/crypto/md5
import std/crypto/crc32

fn checkMd5(): int32 =
    let emptyHex: str = md5.Md5StringHex("")
    assert(emptyHex == "d41d8cd98f00b204e9800998ecf8427e", "md5 empty vector")
    let abcHex: str = md5.Md5StringHex("abc")
    assert(abcHex == "900150983cd24fb0d6963f7d28e17f72", "md5 abc vector")
    let foxHex: str = md5.Md5StringHex("The quick brown fox jumps over the lazy dog")
    assert(foxHex == "9e107d9d372bb6826bd81d3542a419d6", "md5 fox vector")
    let digestHex: str = rawbytes.BytesToHex(md5.Md5Digest(rawbytes.BytesFromString("abc")))
    assert(digestHex == "900150983cd24fb0d6963f7d28e17f72", "md5 digest bytes vector")
    echo("md5 vectors ok")
    return 0

fn checkCrc32(): int32 =
    let empty: int64 = crc32.Crc32(rawbytes.BytesFromString(""))
    assert(empty == 0, "crc32 empty vector")
    let nine: int64 = crc32.Crc32(rawbytes.BytesFromString("123456789"))
    assert(nine == int64(0xCBF43926), "crc32 123456789 vector")
    echo("crc32 vectors ok")
    return 0

fn main(): int32 =
    let r1: int32 = checkMd5()
    if r1 != 0:
        return r1
    let r2: int32 = checkCrc32()
    if r2 != 0:
        return r2
    echo("md5_crc32_vectors_smoke ok")
    return 0
