# turn_relay_smoke: real-UDP end-to-end TURN relay (RFC 5766).
#
# One process hosts the TURN server (listen 127.0.0.1:ephemeral) and two UDP
# clients A and B. The test drives the server synchronously:
#   1. A Allocate (401 challenge -> REST-auth retry) -> relayA
#   2. B Allocate -> relayB
#   3. A CreatePermission(peer=relayB)  [authenticated: USERNAME+REALM+NONCE+MI]
#   4. A SendIndication(peer=relayB, DATA="hello from A")
#      server relays relayA -> relayB; pump wraps Data Indication -> B
#   5. B receives Data Indication, verifies DATA + peer=relayA
#   6. Reverse: B CreatePermission(peer=relayA) + SendIndication(DATA="hello from B")
#      -> A receives Data Indication, verifies DATA + peer=relayB
# All forwarding is real UDP on the loopback relay sockets.
#
# The dst sockaddr is built fresh inside each helper (into a local var) rather
# than passed in by value: passing a UdpSockAddr (which holds a Bytes field)
# across a function boundary tripped cheng ORC codegen and freed the raw
# sockaddr before sendto. Building+using it in one scope matches the
# probe_turn_listen pattern that works reliably.

import std/system
import std/result
import std/rawbytes
import std/os
import std/net/transports/udp_syscall as udp
import std/stun/protocol as stun
import std/stun/turn_protocol as turn
import std/stun/turn_auth as auth
import std/stun/turn_relay as relay
import std/stun/turn_server as tsrv

const
    solSocket = 65535
    soRcvTimeo = 4102
    recvTimeoutSec = 2
    realmStr = "example.org"
    nonceStr = "bd8as92Kdf02Jd72vMaPwcBNds7i40tn"
    restSecretStr = "coturn-static-secret"

var
    txidCounter: int32

fn nextTxid(): rawbytes.Bytes =
    txidCounter = txidCounter + 1
    let out: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(out, i, (txidCounter * 7 + i) & 255)
    return out

fn setRecvTimeout(fd: int32): int32 =
    let tv: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    rawbytes.BytesSet(tv, 0, recvTimeoutSec)
    return os.UdpSetSockOptIntFd(fd, solSocket, soRcvTimeo, tv)

fn openClient(varFd: var int32): int32 =
    let sockRes = udp.UdpSocketOpenDgram(false)
    if IsErr(sockRes):
        return 1
    let sock = Value(sockRes)
    varFd = sock.fd
    let _ = setRecvTimeout(sock.fd)
    return 0

fn buildDst(server: relay.TurnServer, out: var udp.UdpSockAddr): int32 =
    let addrRes = udp.UdpSockAddrFromHostPort(server.listenHost, server.listenPort, false, server.family, server.useLenField, out)
    if IsErr(addrRes):
        return 1
    return 0

fn serverProcess(server: var relay.TurnServer, label: str): int32 =
    let rc: int32 = tsrv.TurnServerProcessOne(server)
    if rc != 0:
        echo(Fmt"turn_relay_smoke: server process failed at {label} rc={rc}")
    return rc

fn serverPump(server: var relay.TurnServer, label: str): int32 =
    let rc: int32 = tsrv.TurnServerPumpAllRelays(server)
    if rc < 0:
        echo(Fmt"turn_relay_smoke: server pump failed at {label} rc={rc}")
    return rc

fn clientRecv(fd: int32, label: str, out: var rawbytes.Bytes): int32 =
    let ready: int32 = os.UdpFdWaitReadable(fd, 2000)
    if ready <= 0:
        echo(Fmt"turn_relay_smoke: client recv timeout at {label}")
        return 1
    var recv: udp.UdpRecvResult
    let recvRes = udp.UdpRecvFromNonblock(fd, 1500, recv)
    if IsErr(recvRes):
        echo(Fmt"turn_relay_smoke: client recv failed at {label}")
        return 1
    out = recv.data
    return 0

fn doAllocate(fd: int32, server: var relay.TurnServer, peerId: str, software: rawbytes.Bytes, outRelayPort: var int32): int32 =
    let realmBytes: rawbytes.Bytes = rawbytes.BytesFromString(realmStr)
    let nonceBytes: rawbytes.Bytes = rawbytes.BytesFromString(nonceStr)
    let secret: rawbytes.Bytes = rawbytes.BytesFromString(restSecretStr)
    let expiry: int64 = int64(1735689600)
    let username: str = auth.TurnRestUsername(expiry, peerId)
    let userBytes: rawbytes.Bytes = rawbytes.BytesFromString(username)
    let key: rawbytes.Bytes = auth.TurnRestLongTermKey(username, realmStr, secret)
    var dst: udp.UdpSockAddr
    if buildDst(server, dst) != 0:
        return 9
    # 1. no-auth Allocate
    let txid1: rawbytes.Bytes = nextTxid()
    let req1: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid1, turn.TurnProtoUdp(), 600, false, software)
    let sendRes1 = udp.UdpSendTo(fd, req1, dst)
    if IsErr(sendRes1):
        return 10
    if serverProcess(server, "alloc-noauth") != 0:
        return 11
    var ch401: rawbytes.Bytes
    if clientRecv(fd, "alloc-401", ch401) != 0:
        return 12
    if !turn.TurnIsAllocateError(ch401):
        return 13
    # 2. auth Allocate (retry with USERNAME+REALM+NONCE+MI)
    let txid2: rawbytes.Bytes = nextTxid()
    let req2: rawbytes.Bytes = turn.TurnEncodeAllocateRequestAuth(txid2, turn.TurnProtoUdp(), 600, false, software, userBytes, realmBytes, nonceBytes, key)
    let sendRes2 = udp.UdpSendTo(fd, req2, dst)
    if IsErr(sendRes2):
        return 14
    if serverProcess(server, "alloc-auth") != 0:
        return 15
    var resp: rawbytes.Bytes
    if clientRecv(fd, "alloc-success", resp) != 0:
        return 16
    if !turn.TurnIsAllocateSuccess(resp):
        echo("turn_relay_smoke: allocate response not success")
        return 17
    if !auth.TurnVerifyMessageIntegrity(resp, key):
        echo("turn_relay_smoke: allocate response MI bad")
        return 18
    let dec: turn.TurnAllocateResp = turn.TurnDecodeAllocateResponse(resp, txid2)
    if !dec.hasRelayed:
        echo("turn_relay_smoke: allocate response missing relayed addr")
        return 19
    outRelayPort = dec.relayedPort
    return 0

fn doCreatePermission(fd: int32, server: var relay.TurnServer, peerId: str, peerPort: int32): int32 =
    let secret: rawbytes.Bytes = rawbytes.BytesFromString(restSecretStr)
    let realmBytes: rawbytes.Bytes = rawbytes.BytesFromString(realmStr)
    let nonceBytes: rawbytes.Bytes = rawbytes.BytesFromString(nonceStr)
    let username: str = auth.TurnRestUsername(int64(1735689600), peerId)
    let userBytes: rawbytes.Bytes = rawbytes.BytesFromString(username)
    let key: rawbytes.Bytes = auth.TurnRestLongTermKey(username, realmStr, secret)
    let peerIp: rawbytes.Bytes = relay.TurnIpv4FromHost("127.0.0.1")
    let txid: rawbytes.Bytes = nextTxid()
    let req: rawbytes.Bytes = turn.TurnEncodeCreatePermissionRequestAuth(txid, peerIp, peerPort, userBytes, realmBytes, nonceBytes, key)
    var dst: udp.UdpSockAddr
    if buildDst(server, dst) != 0:
        return 5
    let sendRes = udp.UdpSendTo(fd, req, dst)
    if IsErr(sendRes):
        return 1
    if serverProcess(server, "createperm") != 0:
        return 2
    var resp: rawbytes.Bytes
    if clientRecv(fd, "createperm-resp", resp) != 0:
        return 3
    let mt: int32 = turn.TurnMessageType(resp)
    if mt != 0x0108:
        echo(Fmt"turn_relay_smoke: createperm response type=0x{mt} not 0x0108 hex={rawbytes.BytesToHex(resp)}")
        return 4
    return 0

fn doSendIndication(fd: int32, server: var relay.TurnServer, peerPort: int32, data: rawbytes.Bytes): int32 =
    let peerIp: rawbytes.Bytes = relay.TurnIpv4FromHost("127.0.0.1")
    let txid: rawbytes.Bytes = nextTxid()
    let ind: rawbytes.Bytes = turn.TurnEncodeSendIndication(txid, peerIp, peerPort, data, false)
    var dst: udp.UdpSockAddr
    if buildDst(server, dst) != 0:
        return 5
    let sendRes = udp.UdpSendTo(fd, ind, dst)
    if IsErr(sendRes):
        return 1
    return 0

fn recvDataIndication(fd: int32, label: str, outData: var rawbytes.Bytes, outPeerPort: var int32): int32 =
    var resp: rawbytes.Bytes
    if clientRecv(fd, label, resp) != 0:
        return 1
    if !turn.TurnIsDataIndication(resp):
        echo(Fmt"turn_relay_smoke: {label} not a Data Indication (type=0x{turn.TurnMessageType(resp)})")
        return 2
    if !auth.TurnVerifyFingerprint(resp):
        echo(Fmt"turn_relay_smoke: {label} fingerprint bad")
        return 3
    let txid: rawbytes.Bytes = turn.TurnMessageTxid(resp)
    let peer: stun.StunXorMappedAddress = turn.TurnDecodeXorPeerAddress(resp, txid)
    outPeerPort = peer.port
    outData = turn.TurnDecodeData(resp)
    return 0

fn main(): int32 =
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage1")
    let realmBytes: rawbytes.Bytes = rawbytes.BytesFromString(realmStr)
    let nonceBytes: rawbytes.Bytes = rawbytes.BytesFromString(nonceStr)
    let secret: rawbytes.Bytes = rawbytes.BytesFromString(restSecretStr)
    var server: relay.TurnServer = relay.TurnServerNew("127.0.0.1", 0, software, realmBytes, nonceBytes, secret)
    let bindRc: int32 = tsrv.TurnServerBind(server)
    if bindRc != 0:
        echo(Fmt"turn_relay_smoke: server bind failed rc={bindRc}")
        return 100
    echo(Fmt"turn_relay_smoke: server listen 127.0.0.1:{server.listenPort}")
    var fdA: int32
    var fdB: int32
    if openClient(fdA) != 0:
        echo("turn_relay_smoke: open client A failed")
        return 102
    if openClient(fdB) != 0:
        echo("turn_relay_smoke: open client B failed")
        return 103
    # 1. A allocate
    var relayPortA: int32
    let rcA: int32 = doAllocate(fdA, server, "clientA", software, relayPortA)
    if rcA != 0:
        echo(Fmt"turn_relay_smoke: A allocate failed rc={rcA}")
        return 200
    echo(Fmt"turn_relay_smoke: A relayed 127.0.0.1:{relayPortA}")
    # 2. B allocate
    var relayPortB: int32
    let rcB: int32 = doAllocate(fdB, server, "clientB", software, relayPortB)
    if rcB != 0:
        echo(Fmt"turn_relay_smoke: B allocate failed rc={rcB}")
        return 201
    echo(Fmt"turn_relay_smoke: B relayed 127.0.0.1:{relayPortB}")
    # 3. A CreatePermission(peer=relayB)
    let rcP1: int32 = doCreatePermission(fdA, server, "clientA", relayPortB)
    if rcP1 != 0:
        echo(Fmt"turn_relay_smoke: A createperm failed rc={rcP1}")
        return 202
    # 4. A SendIndication(peer=relayB, DATA)
    let dataA: rawbytes.Bytes = rawbytes.BytesFromString("hello from A")
    let rcS1: int32 = doSendIndication(fdA, server, relayPortB, dataA)
    if rcS1 != 0:
        echo(Fmt"turn_relay_smoke: A sendind failed rc={rcS1}")
        return 203
    if serverProcess(server, "a-sendind") != 0:
        return 204
    let _ = serverPump(server, "a-forward")
    # 5. B receives Data Indication
    var dataToB: rawbytes.Bytes
    var peerPortToB: int32
    let rcR1: int32 = recvDataIndication(fdB, "B-recv", dataToB, peerPortToB)
    if rcR1 != 0:
        echo(Fmt"turn_relay_smoke: B recv data ind failed rc={rcR1}")
        return 205
    if rawbytes.BytesToString(dataToB) != "hello from A":
        echo(Fmt"turn_relay_smoke: B got wrong data: {rawbytes.BytesToString(dataToB)}")
        return 206
    if peerPortToB != relayPortA:
        echo(Fmt"turn_relay_smoke: B peer port {peerPortToB} != relayPortA {relayPortA}")
        return 207
    echo("turn_relay_smoke: A->B relay ok")
    # 6. reverse: B CreatePermission(peer=relayA) + SendIndication
    let rcP2: int32 = doCreatePermission(fdB, server, "clientB", relayPortA)
    if rcP2 != 0:
        echo(Fmt"turn_relay_smoke: B createperm failed rc={rcP2}")
        return 208
    let dataB: rawbytes.Bytes = rawbytes.BytesFromString("hello from B")
    let rcS2: int32 = doSendIndication(fdB, server, relayPortA, dataB)
    if rcS2 != 0:
        echo(Fmt"turn_relay_smoke: B sendind failed rc={rcS2}")
        return 209
    if serverProcess(server, "b-sendind") != 0:
        return 210
    let _ = serverPump(server, "b-forward")
    var dataToA: rawbytes.Bytes
    var peerPortToA: int32
    let rcR2: int32 = recvDataIndication(fdA, "A-recv", dataToA, peerPortToA)
    if rcR2 != 0:
        echo(Fmt"turn_relay_smoke: A recv data ind failed rc={rcR2}")
        return 211
    if rawbytes.BytesToString(dataToA) != "hello from B":
        echo(Fmt"turn_relay_smoke: A got wrong data: {rawbytes.BytesToString(dataToA)}")
        return 212
    if peerPortToA != relayPortB:
        echo(Fmt"turn_relay_smoke: A peer port {peerPortToA} != relayPortB {relayPortB}")
        return 213
    echo("turn_relay_smoke: B->A relay ok")
    let _ = os.UdpCloseFd(fdA)
    let _ = os.UdpCloseFd(fdB)
    echo("turn_relay_smoke ok")
    return 0
