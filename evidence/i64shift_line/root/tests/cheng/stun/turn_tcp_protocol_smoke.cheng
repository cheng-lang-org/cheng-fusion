# turn_tcp_protocol_smoke: TURN-over-TCP protocol machine over a real loopback
# TCP connection (synchronous one-shot, no connection thread).
#
# Drives one Allocate round-trip through the TCP transport + the per-connection
# handler reused by the threaded server:
#   1. client sends a framed no-auth Allocate Request
#   2. server (TurnTcpConnProcessOneRequest) recvs the frame, handles it, sends
#      a framed 401 challenge
#   3. client recvs the 401, re-sends a framed authenticated Allocate Request
#   4. server handles it, sends a framed Allocate Success (XOR-RELAYED-ADDRESS +
#      LIFETIME + MI + FP)
#   5. client decodes + verifies every field
# This exercises the TCP framing codec + the stage-1 TURN codec + REST auth
# integration over a real TCP socket, without concurrency.

import std/system
import std/result
import std/rawbytes
import std/os as os
import std/net/transports/tcp_syscall as tcp
import std/stun/turn_protocol as turn
import std/stun/turn_auth as auth
import std/stun/turn_tcp_transport as tr
import std/stun/turn_tcp_server as tsrv

const
    realmStr = "example.org"
    nonceStr = "bd8as92Kdf02Jd72vMaPwcBNds7i40tn"
    restSecretStr = "coturn-static-secret"
    peerId = "alice"
    timeoutMs = 5000

fn makeTxid(seed: int32): rawbytes.Bytes =
    let txid: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(txid, i, (seed * 7 + i + 1) & 255)
    return txid

fn clientSendFrame(fd: int32, msg: rawbytes.Bytes): int32 =
    return tr.TurnTcpSendFrame(fd, msg)

fn clientRecvFrame(fd: int32, buf: var rawbytes.Bytes, bufLen: var int32, tmo: int32, out: var rawbytes.Bytes): int32 =
    var tries: int32 = 0
    while tries < 16:
        tries = tries + 1
        let ex: int32 = tr.TurnTcpFrameTryExtract(buf, bufLen, out)
        if ex == 0:
            return 0
        if ex == 2:
            return 3
        let rc: int32 = os.fdWaitReadable(fd, tmo)
        if rc <= 0:
            return 1
        var h: tcp.TcpConnectionHandle
        h.fd = fd
        h.open = true
        let recvRes = tcp.TcpRecvNonblocking(h, tr.TurnTcpRecvChunk())
        if IsErr(recvRes):
            continue
        let data: rawbytes.Bytes = Value(recvRes)
        if rawbytes.BytesLen(data) <= 0:
            return 2
        let arc: int32 = tr.TurnTcpFrameAppend(buf, bufLen, data)
        if arc != 0:
            return 3
    return 1

fn main(): int32 =
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage2")
    let realmBytes: rawbytes.Bytes = rawbytes.BytesFromString(realmStr)
    let nonceBytes: rawbytes.Bytes = rawbytes.BytesFromString(nonceStr)
    let secret: rawbytes.Bytes = rawbytes.BytesFromString(restSecretStr)
    var server: tsrv.TurnTcpServer = tsrv.TurnTcpServerNew("127.0.0.1", 0, software, realmBytes, nonceBytes, secret)
    let bc: int32 = tsrv.TurnTcpServerBind(server)
    if bc != 0:
        echo(Fmt"turn_tcp_protocol_smoke: server bind failed rc={bc}")
        return 100
    let listenPort: int32 = tsrv.TurnTcpServerBoundPort(server)
    echo(Fmt"turn_tcp_protocol_smoke: server listen 127.0.0.1:{listenPort}")
    # client connect
    let cres = tcp.TcpConnect4("127.0.0.1", listenPort)
    if IsErr(cres):
        echo("turn_tcp_protocol_smoke: client connect failed")
        return 101
    let clientConn: tcp.TcpConnectionHandle = Value(cres)
    let clientFd: int32 = clientConn.fd
    # server accept one (synchronous, no thread)
    var sraw: tcp.TcpConnectionHandle
    let ok: bool = tcp.TcpAcceptFdInto(server.listenFd, sraw)
    if !ok:
        echo("turn_tcp_protocol_smoke: server accept failed")
        return 102
    let serverFd: int32 = sraw.fd
    let ctx = tsrv.TurnTcpConnCtxNew(serverFd, server.stopFlag, server.realm, server.nonce, server.secret, server.software)
    var sconn: tsrv.TurnTcpConn = tsrv.TurnTcpConnNew(ctx)
    var sbuf: rawbytes.Bytes = rawbytes.BytesAlloc(tr.TurnTcpRecvBufCap())
    var slen: int32 = 0
    var cbuf: rawbytes.Bytes = rawbytes.BytesAlloc(tr.TurnTcpRecvBufCap())
    var clen: int32 = 0
    # 1. no-auth Allocate
    let txid1: rawbytes.Bytes = makeTxid(1)
    let req1: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid1, turn.TurnProtoUdp(), 600, false, software)
    if clientSendFrame(clientFd, req1) != 0:
        echo("turn_tcp_protocol_smoke: client send noauth failed")
        return 200
    let p1: int32 = tsrv.TurnTcpConnProcessOneRequest(sconn, sbuf, slen, timeoutMs)
    if p1 != 0:
        echo(Fmt"turn_tcp_protocol_smoke: server process noauth failed rc={p1}")
        return 201
    # 2. recv 401
    var resp1: rawbytes.Bytes
    if clientRecvFrame(clientFd, cbuf, clen, timeoutMs, resp1) != 0:
        echo("turn_tcp_protocol_smoke: client recv 401 failed")
        return 202
    if !turn.TurnIsAllocateError(resp1):
        echo("turn_tcp_protocol_smoke: expected 401 allocate error")
        return 203
    echo("turn_tcp_protocol_smoke: 401 challenge ok")
    # 3. auth Allocate
    let username: str = auth.TurnRestUsername(int64(1735689600), peerId)
    let userBytes: rawbytes.Bytes = rawbytes.BytesFromString(username)
    let key: rawbytes.Bytes = auth.TurnRestLongTermKey(username, realmStr, secret)
    let txid2: rawbytes.Bytes = makeTxid(2)
    let req2: rawbytes.Bytes = turn.TurnEncodeAllocateRequestAuth(txid2, turn.TurnProtoUdp(), 600, false, software, userBytes, realmBytes, nonceBytes, key)
    if clientSendFrame(clientFd, req2) != 0:
        echo("turn_tcp_protocol_smoke: client send auth failed")
        return 204
    let p2: int32 = tsrv.TurnTcpConnProcessOneRequest(sconn, sbuf, slen, timeoutMs)
    if p2 != 0:
        echo(Fmt"turn_tcp_protocol_smoke: server process auth failed rc={p2}")
        return 205
    # 4. recv success
    var resp2: rawbytes.Bytes
    if clientRecvFrame(clientFd, cbuf, clen, timeoutMs, resp2) != 0:
        echo("turn_tcp_protocol_smoke: client recv success failed")
        return 206
    if !turn.TurnIsAllocateSuccess(resp2):
        echo("turn_tcp_protocol_smoke: expected allocate success")
        return 207
    if !auth.TurnVerifyMessageIntegrity(resp2, key):
        echo("turn_tcp_protocol_smoke: allocate success MI bad")
        return 208
    let dec: turn.TurnAllocateResp = turn.TurnDecodeAllocateResponse(resp2, txid2)
    if !dec.hasRelayed:
        echo("turn_tcp_protocol_smoke: allocate success missing relayed addr")
        return 209
    if dec.relayedPort <= 0:
        echo("turn_tcp_protocol_smoke: bad relayed port")
        return 210
    echo(Fmt"turn_tcp_protocol_smoke: allocate success relayed 127.0.0.1:{dec.relayedPort}")
    # cleanup
    let _ = os.TcpShutdownFd(clientFd, 2)
    let _ = os.UdpCloseFd(clientFd)
    let _ = os.UdpCloseFd(serverFd)
    if sconn.relayFd >= 0:
        let _ = os.UdpCloseFd(sconn.relayFd)
    let _ = os.UdpCloseFd(server.listenFd)
    echo("turn_tcp_protocol_smoke ok")
    return 0
