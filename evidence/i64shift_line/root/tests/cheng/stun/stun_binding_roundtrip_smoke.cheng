import std/system
import std/rawbytes
import std/crypto/md5
import std/crypto/crc32
import std/stun/protocol as stun

fn makeTxid(): rawbytes.Bytes =
    let txid: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(txid, i, i + 1)
    return txid

fn makeIpV4(): rawbytes.Bytes =
    let ip: rawbytes.Bytes = rawbytes.BytesAlloc(4)
    rawbytes.BytesSet(ip, 0, 192)
    rawbytes.BytesSet(ip, 1, 168)
    rawbytes.BytesSet(ip, 2, 1)
    rawbytes.BytesSet(ip, 3, 10)
    return ip

fn checkBindingRequest(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let req: rawbytes.Bytes = stun.StunEncodeBindingRequest(txid)
    assert(rawbytes.BytesLen(req) == 20, "binding request len")
    let h: stun.StunHeader = stun.StunDecodeHeader(req)
    assert(h.msgType == 0x0001, "binding request type")
    assert(h.msgLen == 0, "binding request body len")
    assert(h.magic == int64(0x2112A442), "binding request magic")
    assert(rawbytes.BytesEqual(h.txid, txid), "binding request txid")
    echo("stun binding request ok")
    return 0

fn checkBindingResponse(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let ip: rawbytes.Bytes = makeIpV4()
    let port: int32 = 32853
    let key: rawbytes.Bytes = rawbytes.BytesFromString("test-key")
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-stun-stage0")
    let resp: rawbytes.Bytes = stun.StunEncodeBindingResponse(txid, ip, port, key, software)
    let h: stun.StunHeader = stun.StunDecodeHeader(resp)
    assert(h.msgType == 0x0101, "binding response type")
    assert(h.magic == int64(0x2112A442), "binding response magic")
    assert(rawbytes.BytesEqual(h.txid, txid), "binding response txid")
    assert(stun.StunVerifyMessageIntegrity(resp, key), "binding response MI verify")
    assert(stun.StunVerifyFingerprint(resp), "binding response FP verify")
    let attrs: stun.StunAttributes = stun.StunDecodeAttributes(resp, h.magic, txid)
    assert(attrs.hasXorMapped, "binding response has xor-mapped")
    assert(attrs.hasMessageIntegrity, "binding response has MI")
    assert(attrs.hasFingerprint, "binding response has FP")
    assert(attrs.xorMapped.family == 0x01, "xor-mapped family")
    assert(attrs.xorMapped.port == port, "xor-mapped port")
    assert(rawbytes.BytesEqual(attrs.xorMapped.ip, ip), "xor-mapped ip")
    let sw: rawbytes.Bytes = stun.StunFindAttribute(resp, 0x8022)
    assert(rawbytes.BytesToString(sw) == "cheng-stun-stage0", "software attr")
    echo("stun binding response ok")
    return 0

fn checkErrorResponse(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let key: rawbytes.Bytes = rawbytes.BytesFromString("test-key")
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-stun-stage0")
    let resp: rawbytes.Bytes = stun.StunEncodeBindingErrorResponse(txid, 401, "Unauthorized", key, software)
    let h: stun.StunHeader = stun.StunDecodeHeader(resp)
    assert(h.msgType == 0x0111, "binding error response type")
    assert(stun.StunVerifyMessageIntegrity(resp, key), "error response MI verify")
    assert(stun.StunVerifyFingerprint(resp), "error response FP verify")
    let attrs: stun.StunAttributes = stun.StunDecodeAttributes(resp, h.magic, txid)
    assert(attrs.hasErrorCode, "error response has error-code")
    assert(attrs.errorCode == 401, "error response code")
    assert(rawbytes.BytesToString(attrs.errorReason) == "Unauthorized", "error response reason")
    echo("stun binding error response ok")
    return 0

fn checkLongTermKey(): int32 =
    let key: rawbytes.Bytes = stun.StunLongTermKey("alice", "example.org", "secret")
    let hex: str = rawbytes.BytesToHex(key)
    assert(hex == md5.Md5StringHex("alice:example.org:secret"), "long-term key = md5(user:realm:pass)")
    echo("stun long-term key ok")
    return 0

fn checkNegativeKeyFails(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let ip: rawbytes.Bytes = makeIpV4()
    let port: int32 = 32853
    let key: rawbytes.Bytes = rawbytes.BytesFromString("test-key")
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-stun-stage0")
    let resp: rawbytes.Bytes = stun.StunEncodeBindingResponse(txid, ip, port, key, software)
    let wrongKey: rawbytes.Bytes = rawbytes.BytesFromString("wrong-key")
    assert(!stun.StunVerifyMessageIntegrity(resp, wrongKey), "MI verify rejects wrong key")
    echo("stun negative MI ok")
    return 0

fn main(): int32 =
    let r1: int32 = checkBindingRequest()
    if r1 != 0:
        return r1
    let r2: int32 = checkBindingResponse()
    if r2 != 0:
        return r2
    let r3: int32 = checkErrorResponse()
    if r3 != 0:
        return r3
    let r4: int32 = checkLongTermKey()
    if r4 != 0:
        return r4
    let r5: int32 = checkNegativeKeyFails()
    if r5 != 0:
        return r5
    echo("stun_binding_roundtrip_smoke ok")
    return 0
