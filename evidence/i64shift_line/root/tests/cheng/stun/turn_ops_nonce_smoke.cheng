# turn_ops_nonce_smoke: stage 4 nonce TTL + replay cache (unit).
#
# Generates a time-stamped HMAC nonce and checks:
#  - fresh nonce validates (rc=0)
#  - nonce older than TTL is rejected (rc=2 expired)
#  - nonce with the wrong HMAC key is rejected (rc=3)
#  - replay cache: Contains is false before Add, true after Add

import std/system
import std/rawbytes
import std/stun/turn_nonce as nonce

const
    ttlSec = 300
    nowSec = 1782603026

fn main(): int32 =
    let secret: rawbytes.Bytes = rawbytes.BytesFromString("test")
    let n: rawbytes.Bytes = nonce.TurnNonceGenerate(secret, int64(nowSec))
    if rawbytes.BytesLen(n) <= 0:
        echo("nonce: generated nonce empty")
        return 1
    let v1: int32 = nonce.TurnNonceValidate(secret, n, int64(nowSec), ttlSec)
    if v1 != 0:
        echo(Fmt"nonce: fresh validate expected 0 got {v1}")
        return 2
    let v2: int32 = nonce.TurnNonceValidate(secret, n, int64(nowSec + ttlSec + 1), ttlSec)
    if v2 != 2:
        echo(Fmt"nonce: expired expected 2 got {v2}")
        return 3
    let wrongSecret: rawbytes.Bytes = rawbytes.BytesFromString("wrong")
    let v3: int32 = nonce.TurnNonceValidate(wrongSecret, n, int64(nowSec), ttlSec)
    if v3 != 3:
        echo(Fmt"nonce: bad hmac expected 3 got {v3}")
        return 4
    let cache: nonce.TurnNonceCache = nonce.TurnNonceCacheNew()
    if nonce.TurnNonceCacheContains(cache, n):
        echo("nonce: cache should be empty before Add")
        return 5
    nonce.TurnNonceCacheAdd(cache, n)
    if !nonce.TurnNonceCacheContains(cache, n):
        echo("nonce: cache missing nonce after Add")
        return 6
    let other: rawbytes.Bytes = nonce.TurnNonceGenerate(secret, int64(nowSec + 1))
    if nonce.TurnNonceCacheContains(cache, other):
        echo("nonce: cache false-positive on different nonce")
        return 7
    echo("turn_ops_nonce_smoke ok")
    return 0
