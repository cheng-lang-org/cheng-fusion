# turn_ops_standalone_client: real-UDP TURN client for the standalone exe smoke.
#
# Talks to a separately-running turn_server process over UDP. Drives a full
# long-term-credential Allocate round-trip:
#   1. no-auth Allocate -> 401 (REALM + NONCE)
#   2. retry with USERNAME + REALM + NONCE + MESSAGE-INTEGRITY -> Allocate Success
#   3. decode XOR-RELAYED-ADDRESS + verify MI
# The server processes asynchronously in its own UDP thread, so this client just
# sends and recvs (no in-process server drive). Realm/nonce/secret must match the
# server's cmdline flags.

import std/system
import std/result
import std/rawbytes
import std/os
import std/net/transports/udp_syscall as udp
import std/stun/turn_protocol as turn
import std/stun/turn_auth as auth

const
    solSocket = 65535
    soRcvTimeo = 4102
    recvTimeoutSec = 5
    serverHost = "127.0.0.1"
    serverPort = 13478
    realmStr = "unimaker.fun"
    restSecretStr = "test"
    peerId = "clientA"
    expiry = 1735689600

var
    txidCounter: int32
    gFamily: int32

fn nextTxid(): rawbytes.Bytes =
    txidCounter = txidCounter + 1
    let out: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(out, i, (txidCounter * 7 + i) & 255)
    return out

fn setRecvTimeout(fd: int32): int32 =
    let tv: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    rawbytes.BytesSet(tv, 0, recvTimeoutSec)
    return os.UdpSetSockOptIntFd(fd, solSocket, soRcvTimeo, tv)

fn openClient(outFd: var int32): int32 =
    let sockRes = udp.UdpSocketOpenDgram(false)
    if IsErr(sockRes):
        return 1
    let sock = Value(sockRes)
    outFd = sock.fd
    gFamily = sock.family
    let _ = setRecvTimeout(sock.fd)
    return 0

fn buildDst(out: var udp.UdpSockAddr): int32 =
    let addrRes = udp.UdpSockAddrFromHostPort(serverHost, serverPort, false, gFamily, false, out)
    if IsErr(addrRes):
        return 1
    return 0

fn clientRecv(fd: int32, label: str, out: var rawbytes.Bytes): int32 =
    let ready: int32 = os.UdpFdWaitReadable(fd, 5000)
    if ready <= 0:
        echo(Fmt"client: recv timeout at {label}")
        return 1
    var recv: udp.UdpRecvResult
    let recvRes = udp.UdpRecvFromNonblock(fd, 1500, recv)
    if IsErr(recvRes):
        echo(Fmt"client: recv failed at {label}")
        return 1
    out = recv.data
    return 0

fn doAllocate(fd: int32, software: rawbytes.Bytes, outRelayPort: var int32): int32 =
    let realmBytes: rawbytes.Bytes = rawbytes.BytesFromString(realmStr)
    let secret: rawbytes.Bytes = rawbytes.BytesFromString(restSecretStr)
    let username: str = auth.TurnRestUsername(int64(expiry), peerId)
    let userBytes: rawbytes.Bytes = rawbytes.BytesFromString(username)
    let key: rawbytes.Bytes = auth.TurnRestLongTermKey(username, realmStr, secret)
    var dst: udp.UdpSockAddr
    if buildDst(dst) != 0:
        return 9
    # 1. no-auth Allocate
    let txid1: rawbytes.Bytes = nextTxid()
    let req1: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid1, turn.TurnProtoUdp(), 600, false, software)
    let sendRes1 = udp.UdpSendTo(fd, req1, dst)
    if IsErr(sendRes1):
        return 10
    var ch401: rawbytes.Bytes
    if clientRecv(fd, "alloc-401", ch401) != 0:
        return 12
    if !turn.TurnIsAllocateError(ch401):
        echo("client: expected 401 allocate error")
        return 13
    let nonceBytes: rawbytes.Bytes = turn.TurnDecodeNonce(ch401)
    if rawbytes.BytesLen(nonceBytes) <= 0:
        echo("client: 401 missing nonce")
        return 14
    let realmEcho: rawbytes.Bytes = turn.TurnDecodeRealm(ch401)
    if !rawbytes.BytesEqual(realmEcho, realmBytes):
        echo("client: 401 realm mismatch")
        return 15
    # 2. auth Allocate retry with the server-issued nonce
    let txid2: rawbytes.Bytes = nextTxid()
    let req2: rawbytes.Bytes = turn.TurnEncodeAllocateRequestAuth(txid2, turn.TurnProtoUdp(), 600, false, software, userBytes, realmBytes, nonceBytes, key)
    let sendRes2 = udp.UdpSendTo(fd, req2, dst)
    if IsErr(sendRes2):
        return 16
    var resp: rawbytes.Bytes
    if clientRecv(fd, "alloc-success", resp) != 0:
        return 17
    if !turn.TurnIsAllocateSuccess(resp):
        let mt: int32 = turn.TurnMessageType(resp)
        echo(Fmt"client: allocate not success type=0x{mt}")
        return 18
    if !auth.TurnVerifyMessageIntegrity(resp, key):
        echo("client: allocate response MI bad")
        return 19
    let dec: turn.TurnAllocateResp = turn.TurnDecodeAllocateResponse(resp, txid2)
    if !dec.hasRelayed:
        echo("client: allocate response missing relayed addr")
        return 20
    outRelayPort = dec.relayedPort
    return 0

fn main(): int32 =
    let software: rawbytes.Bytes = rawbytes.BytesFromString("standalone-client")
    var fd: int32
    if openClient(fd) != 0:
        echo("client: open socket failed")
        return 1
    var relayPort: int32
    let rc: int32 = doAllocate(fd, software, relayPort)
    if rc != 0:
        echo(Fmt"client: allocate failed rc={rc}")
        let _ = os.UdpCloseFd(fd)
        return 2
    echo(Fmt"standalone alloc ok relayed=127.0.0.1:{relayPort}")
    let _ = os.UdpCloseFd(fd)
    return 0
