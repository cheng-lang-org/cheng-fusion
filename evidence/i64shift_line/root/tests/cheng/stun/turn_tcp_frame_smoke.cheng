# turn_tcp_frame_smoke: RFC 5766 section 7 TCP framing codec + ChannelData.
#
# Verifies the frame buffer parser end-to-end without a live socket:
#   1. encode/decode round-trip of a STUN message wrapped in a 4B length prefix
#   2. fragmentation: a frame split across two chunks must assemble correctly
#   3. coalescing (sticky): two frames in one chunk must both extract
#   4. ChannelData encode/decode + TurnIsChannelData discrimination
#   5. a regular STUN message is NOT misclassified as ChannelData

import std/system
import std/rawbytes
import std/stun/turn_protocol as turn
import std/stun/turn_tcp_transport as tr

fn makeTxid(): rawbytes.Bytes =
    let txid: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(txid, i, i + 3)
    return txid

fn newBuf(buf: var rawbytes.Bytes, bufLen: var int32) =
    buf = rawbytes.BytesAlloc(tr.TurnTcpRecvBufCap())
    bufLen = 0

fn checkRoundtrip(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage2")
    let msg: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid, turn.TurnProtoUdp(), 600, false, software)
    let frame: rawbytes.Bytes = tr.TurnTcpEncodeFrame(msg)
    assert(rawbytes.BytesLen(frame) == rawbytes.BytesLen(msg) + 4, "frame = 4B prefix + msg")
    var buf: rawbytes.Bytes
    var bufLen: int32
    newBuf(buf, bufLen)
    let arc: int32 = tr.TurnTcpFrameAppend(buf, bufLen, frame)
    assert(arc == 0, "append full frame")
    var out: rawbytes.Bytes
    let ex: int32 = tr.TurnTcpFrameTryExtract(buf, bufLen, out)
    assert(ex == 0, "extract one frame")
    assert(rawbytes.BytesEqual(out, msg), "decoded frame == original msg")
    assert(bufLen == 0, "buffer drained after extract")
    echo("turn_tcp_frame_smoke: roundtrip ok")
    return 0

fn checkFragmentation(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage2")
    let msg: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid, turn.TurnProtoUdp(), 300, false, software)
    let frame: rawbytes.Bytes = tr.TurnTcpEncodeFrame(msg)
    let total: int32 = rawbytes.BytesLen(frame)
    let splitAt: int32 = 5
    let chunk1: rawbytes.Bytes = rawbytes.BytesSlice(frame, 0, splitAt)
    let chunk2: rawbytes.Bytes = rawbytes.BytesSlice(frame, splitAt, total - splitAt)
    var buf: rawbytes.Bytes
    var bufLen: int32
    newBuf(buf, bufLen)
    let _ = tr.TurnTcpFrameAppend(buf, bufLen, chunk1)
    var out: rawbytes.Bytes
    let ex1: int32 = tr.TurnTcpFrameTryExtract(buf, bufLen, out)
    assert(ex1 == 1, "partial frame needs more bytes")
    let _ = tr.TurnTcpFrameAppend(buf, bufLen, chunk2)
    let ex2: int32 = tr.TurnTcpFrameTryExtract(buf, bufLen, out)
    assert(ex2 == 0, "complete after second chunk")
    assert(rawbytes.BytesEqual(out, msg), "fragmented frame == original")
    echo("turn_tcp_frame_smoke: fragmentation ok")
    return 0

fn checkCoalescing(): int32 =
    let txid1: rawbytes.Bytes = makeTxid()
    let txid2: rawbytes.Bytes = makeTxid()
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage2")
    let msg1: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid1, turn.TurnProtoUdp(), 100, false, software)
    let msg2: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid2, turn.TurnProtoUdp(), 200, false, software)
    let frame1: rawbytes.Bytes = tr.TurnTcpEncodeFrame(msg1)
    let frame2: rawbytes.Bytes = tr.TurnTcpEncodeFrame(msg2)
    let combined: rawbytes.Bytes = rawbytes.BytesConcat(frame1, frame2)
    var buf: rawbytes.Bytes
    var bufLen: int32
    newBuf(buf, bufLen)
    let _ = tr.TurnTcpFrameAppend(buf, bufLen, combined)
    var out1: rawbytes.Bytes
    let ex1: int32 = tr.TurnTcpFrameTryExtract(buf, bufLen, out1)
    assert(ex1 == 0, "extract first sticky frame")
    assert(rawbytes.BytesEqual(out1, msg1), "first sticky frame == msg1")
    var out2: rawbytes.Bytes
    let ex2: int32 = tr.TurnTcpFrameTryExtract(buf, bufLen, out2)
    assert(ex2 == 0, "extract second sticky frame")
    assert(rawbytes.BytesEqual(out2, msg2), "second sticky frame == msg2")
    var out3: rawbytes.Bytes
    let ex3: int32 = tr.TurnTcpFrameTryExtract(buf, bufLen, out3)
    assert(ex3 == 1, "no third frame")
    echo("turn_tcp_frame_smoke: coalescing ok")
    return 0

fn checkChannelData(): int32 =
    let channel: int32 = 0x4001
    let data: rawbytes.Bytes = rawbytes.BytesFromString("hello over channel")
    let cd: rawbytes.Bytes = tr.TurnEncodeChannelData(channel, data)
    assert(rawbytes.BytesLen(cd) == 4 + rawbytes.BytesLen(data), "channeldata = 4B hdr + data")
    assert(tr.TurnIsChannelData(cd), "channeldata recognized")
    var outChannel: int32
    var outData: rawbytes.Bytes
    let rc: int32 = tr.TurnDecodeChannelData(cd, outChannel, outData)
    assert(rc == 0, "channeldata decode ok")
    assert(outChannel == channel, "channel number echo")
    assert(rawbytes.BytesEqual(outData, data), "channeldata payload echo")
    # a STUN Allocate request must NOT be misclassified as ChannelData
    let txid: rawbytes.Bytes = makeTxid()
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage2")
    let stunMsg: rawbytes.Bytes = turn.TurnEncodeAllocateRequestNoAuth(txid, turn.TurnProtoUdp(), 600, false, software)
    assert(!tr.TurnIsChannelData(stunMsg), "STUN message not channeldata")
    echo("turn_tcp_frame_smoke: channeldata ok")
    return 0

fn main(): int32 =
    let r1: int32 = checkRoundtrip()
    if r1 != 0:
        return r1
    let r2: int32 = checkFragmentation()
    if r2 != 0:
        return r2
    let r3: int32 = checkCoalescing()
    if r3 != 0:
        return r3
    let r4: int32 = checkChannelData()
    if r4 != 0:
        return r4
    echo("turn_tcp_frame_smoke ok")
    return 0
