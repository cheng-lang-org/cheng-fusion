# turn_ops_config_smoke: stage 4 cmdline config validation (unit).
#
# Builds configs by hand and checks TurnValidateConfig rejects/gates each field:
# secret required, port range, relay port range ordering, max-connections >= 1.

import std/system
import std/stun/turn_config as cfg

fn newConfig(): cfg.TurnConfig =
    return cfg.TurnConfigNew()

fn expectInvalid(c: var cfg.TurnConfig, expectRc: int32, label: str): int32 =
    let rc: int32 = cfg.TurnValidateConfig(c)
    if rc != expectRc:
        echo(Fmt"config: {label} expected rc={expectRc} got rc={rc}")
        return 1
    if cfg.TurnConfigIsValid(c):
        echo(Fmt"config: {label} expected invalid but valid=true")
        return 2
    return 0

fn expectValid(c: var cfg.TurnConfig, label: str): int32 =
    let rc: int32 = cfg.TurnValidateConfig(c)
    if rc != 0:
        echo(Fmt"config: {label} expected valid rc=0 got rc={rc} err={cfg.TurnConfigError(c)}")
        return 1
    if !cfg.TurnConfigIsValid(c):
        echo(Fmt"config: {label} expected valid but valid=false")
        return 2
    return 0

fn checkSecretRequired(): int32 =
    var c: cfg.TurnConfig = newConfig()
    return expectInvalid(c, 1, "secret required")

fn checkValidBaseline(): int32 =
    var c: cfg.TurnConfig = newConfig()
    c.secret = "test"
    return expectValid(c, "valid baseline")

fn checkPortRange(): int32 =
    var c: cfg.TurnConfig = newConfig()
    c.secret = "x"
    c.port = 99999
    return expectInvalid(c, 2, "port out of range")

fn checkRelayRange(): int32 =
    var c: cfg.TurnConfig = newConfig()
    c.secret = "x"
    c.port = 3478
    c.minPort = 49260
    c.maxPort = 49160
    return expectInvalid(c, 3, "relay min>max")

fn checkMaxConns(): int32 =
    var c: cfg.TurnConfig = newConfig()
    c.secret = "x"
    c.port = 3478
    c.minPort = 49160
    c.maxPort = 49260
    c.maxConnections = 0
    return expectInvalid(c, 4, "max-connections zero")

fn main(): int32 =
    let r1: int32 = checkSecretRequired()
    if r1 != 0:
        return r1
    let r2: int32 = checkValidBaseline()
    if r2 != 0:
        return r2
    let r3: int32 = checkPortRange()
    if r3 != 0:
        return r3
    let r4: int32 = checkRelayRange()
    if r4 != 0:
        return r4
    let r5: int32 = checkMaxConns()
    if r5 != 0:
        return r5
    echo("turn_ops_config_smoke ok")
    return 0
