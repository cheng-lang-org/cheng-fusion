# turn_rest_auth_smoke: coturn REST auth + MESSAGE-INTEGRITY.
#
# Generates a time-limited REST username ("expiry:peerId"), derives the
# password as HMAC-SHA1(static-secret, username), builds the long-term
# credential key, encodes an authenticated Allocate Request (USERNAME + REALM
# + NONCE + MESSAGE-INTEGRITY + FINGERPRINT), and verifies MI/FP. Also checks
# MI rejects a key derived from the wrong secret.

import std/system
import std/rawbytes
import std/stun/turn_protocol as turn
import std/stun/turn_auth as auth

fn checkRestAuth(): int32 =
    let secret: rawbytes.Bytes = rawbytes.BytesFromString("coturn-static-secret")
    let expiry: int64 = int64(1735689600)
    let peerId: str = "alice"
    let username: str = auth.TurnRestUsername(expiry, peerId)
    assert(username == "1735689600:alice", "REST username format")
    let password: rawbytes.Bytes = auth.TurnRestPassword(username, secret)
    assert(rawbytes.BytesLen(password) == 20, "REST password is 20-byte HMAC-SHA1")
    let realm: str = "example.org"
    let nonce: rawbytes.Bytes = rawbytes.BytesFromString("adl7W7PeDU4hKE72jdaQvbAMcr6h39sm")
    let key: rawbytes.Bytes = auth.TurnRestLongTermKey(username, realm, secret)
    let userBytes: rawbytes.Bytes = rawbytes.BytesFromString(username)
    let realmBytes: rawbytes.Bytes = rawbytes.BytesFromString(realm)
    let txid: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(txid, i, i + 7)
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage1")
    let req: rawbytes.Bytes = turn.TurnEncodeAllocateRequestAuth(txid, turn.TurnProtoUdp(), 600, false, software, userBytes, realmBytes, nonce, key)
    assert(turn.TurnIsAllocateRequest(req), "REST allocate request type")
    assert(auth.TurnVerifyMessageIntegrity(req, key), "REST allocate request MI")
    assert(auth.TurnVerifyFingerprint(req), "REST allocate request FP")
    assert(rawbytes.BytesEqual(turn.TurnDecodeUsername(req), userBytes), "REST request username echo")
    assert(rawbytes.BytesEqual(turn.TurnDecodeRealm(req), realmBytes), "REST request realm echo")
    let wrongSecret: rawbytes.Bytes = rawbytes.BytesFromString("wrong-secret")
    let wrongKey: rawbytes.Bytes = auth.TurnRestLongTermKey(username, realm, wrongSecret)
    assert(!auth.TurnVerifyMessageIntegrity(req, wrongKey), "REST MI rejects wrong secret")
    echo("turn_rest_auth_smoke: REST auth + MI ok")
    return 0

fn main(): int32 =
    let r1: int32 = checkRestAuth()
    if r1 != 0:
        return r1
    echo("turn_rest_auth_smoke ok")
    return 0
