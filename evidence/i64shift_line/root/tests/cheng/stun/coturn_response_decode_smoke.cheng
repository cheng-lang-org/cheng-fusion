# Stage-0 interop (protocol-level): decode a REAL coturn Binding Response.
#
# coturn on vultr (64.176.84.12:3478) responds to the exact Binding Request
# cheng produces (verified: a Python client on vultr using bytes
# 000100002112a4420102030405060708090a0b0c -- which is StunEncodeBindingRequest
# for txid 1..12 -- got the response captured below). Live UDP from this Mac to
# coturn:3478 is network-blocked (both Python and cheng time out; vultr-local
# works), so the full live round-trip cannot run from this host. Instead we feed
# the real captured coturn response bytes into the cheng STUN decoder and verify
# header, XOR-MAPPED-ADDRESS, SOFTWARE and FINGERPRINT.

import std/system
import std/rawbytes
import std/stun/protocol as stun

const
    coturnRespHex = "010100442112a4420102030405060708090a0b0c002000080001f02f61a2f04e000100080001d13d40b0540c802b000800010d9640b0540c80220014436f7475726e2d342e362e312027476f727374278028000490d17f0e"

fn hexVal(c: int32): int32 =
    if c >= Int32('0') && c <= Int32('9'):
        return c - Int32('0')
    if c >= Int32('a') && c <= Int32('f'):
        return c - Int32('a') + 10
    if c >= Int32('A') && c <= Int32('F'):
        return c - Int32('A') + 10
    return 0

fn hexToBytes(hex: str): rawbytes.Bytes =
    let hb: rawbytes.Bytes = rawbytes.BytesFromString(hex)
    let n: int32 = rawbytes.BytesLen(hb)
    let out: rawbytes.Bytes = rawbytes.BytesAlloc(n / 2)
    var i: int32
    for i in i..<(n / 2):
        let hi: int32 = hexVal(rawbytes.BytesGet(hb, i * 2))
        let lo: int32 = hexVal(rawbytes.BytesGet(hb, i * 2 + 1))
        rawbytes.BytesSet(out, i, (hi << 4) | lo)
    return out

fn main(): int32 =
    let resp: rawbytes.Bytes = hexToBytes(coturnRespHex)
    assert(rawbytes.BytesLen(resp) == 88, "coturn resp len")
    let h: stun.StunHeader = stun.StunDecodeHeader(resp)
    assert(h.msgType == 0x0101, "coturn resp type")
    assert(h.msgLen == 68, "coturn resp body len")
    assert(h.magic == int64(0x2112A442), "coturn resp magic")
    let wantTxid: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(wantTxid, i, i + 1)
    assert(rawbytes.BytesEqual(h.txid, wantTxid), "coturn resp txid echo")
    let attrs: stun.StunAttributes = stun.StunDecodeAttributes(resp, h.magic, wantTxid)
    assert(attrs.hasXorMapped, "coturn resp has xor-mapped")
    assert(attrs.xorMapped.family == 0x01, "coturn resp xor-mapped family")
    assert(attrs.xorMapped.port == 53565, "coturn resp xor-mapped port")
    assert(rawbytes.BytesGet(attrs.xorMapped.ip, 0) == 64, "coturn resp ip0")
    assert(rawbytes.BytesGet(attrs.xorMapped.ip, 1) == 176, "coturn resp ip1")
    assert(rawbytes.BytesGet(attrs.xorMapped.ip, 2) == 84, "coturn resp ip2")
    assert(rawbytes.BytesGet(attrs.xorMapped.ip, 3) == 12, "coturn resp ip3")
    assert(rawbytes.BytesToString(attrs.software) == "Coturn-4.6.1 'Gorst'", "coturn resp software")
    assert(stun.StunVerifyFingerprint(resp), "coturn resp fingerprint")
    echo("coturn_response_decode_smoke ok")
    return 0
