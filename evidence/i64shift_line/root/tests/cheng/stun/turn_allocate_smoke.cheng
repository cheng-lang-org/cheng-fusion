# turn_allocate_smoke: in-process Allocate round-trip (no UDP).
#
# Client encodes an Allocate Request (REQUESTED-TRANSPORT=UDP, LIFETIME,
# SOFTWARE, long-term-cred MESSAGE-INTEGRITY + FINGERPRINT); an in-process
# server validates it and builds an Allocate Success Response (XOR-RELAYED-
# ADDRESS + LIFETIME + MI + FP); the client decodes and verifies every field.
# Also checks MI rejects a wrong key.

import std/system
import std/rawbytes
import std/stun/turn_protocol as turn
import std/stun/turn_auth as auth

fn makeTxid(): rawbytes.Bytes =
    let txid: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(txid, i, i + 1)
    return txid

fn makeIpv4(a: int32, b: int32, c: int32, d: int32): rawbytes.Bytes =
    let ip: rawbytes.Bytes = rawbytes.BytesAlloc(4)
    rawbytes.BytesSet(ip, 0, a)
    rawbytes.BytesSet(ip, 1, b)
    rawbytes.BytesSet(ip, 2, c)
    rawbytes.BytesSet(ip, 3, d)
    return ip

fn checkAllocateRoundtrip(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let relayedIp: rawbytes.Bytes = makeIpv4(192, 0, 2, 15)
    let relayedPort: int32 = 9000
    let lifetime: int32 = 600
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage1")
    let key: rawbytes.Bytes = auth.TurnLongTermKey("alice", "example.org", "secret")
    let req: rawbytes.Bytes = turn.TurnEncodeAllocateRequest(txid, turn.TurnProtoUdp(), lifetime, false, software, key)
    assert(turn.TurnIsAllocateRequest(req), "allocate request type")
    assert(turn.TurnDecodeRequestedTransport(req) == 17, "requested-transport UDP")
    assert(turn.TurnDecodeLifetime(req) == lifetime, "lifetime echo")
    assert(auth.TurnVerifyMessageIntegrity(req, key), "allocate request MI")
    assert(auth.TurnVerifyFingerprint(req), "allocate request FP")
    assert(rawbytes.BytesEqual(turn.TurnMessageTxid(req), txid), "allocate request txid")
    let resp: rawbytes.Bytes = turn.TurnEncodeAllocateResponse(txid, relayedIp, relayedPort, lifetime, rawbytes.EmptyBytes(), false, key, software)
    assert(turn.TurnIsAllocateSuccess(resp), "allocate success type")
    assert(auth.TurnVerifyMessageIntegrity(resp, key), "allocate response MI")
    assert(auth.TurnVerifyFingerprint(resp), "allocate response FP")
    let dec: turn.TurnAllocateResp = turn.TurnDecodeAllocateResponse(resp, txid)
    assert(dec.hasRelayed, "decoded has relayed")
    assert(dec.relayedPort == relayedPort, "decoded relayed port")
    assert(rawbytes.BytesEqual(dec.relayedIp, relayedIp), "decoded relayed ip")
    assert(dec.relayedFamily == 0x01, "decoded relayed family IPv4")
    assert(dec.hasLifetime, "decoded has lifetime")
    assert(dec.lifetime == lifetime, "decoded lifetime")
    echo("turn_allocate_smoke: roundtrip ok")
    return 0

fn checkNegativeMi(): int32 =
    let txid: rawbytes.Bytes = makeTxid()
    let software: rawbytes.Bytes = rawbytes.BytesFromString("cheng-turn-stage1")
    let key: rawbytes.Bytes = auth.TurnLongTermKey("alice", "example.org", "secret")
    let wrongKey: rawbytes.Bytes = auth.TurnLongTermKey("alice", "example.org", "wrong")
    let req: rawbytes.Bytes = turn.TurnEncodeAllocateRequest(txid, turn.TurnProtoUdp(), 600, false, software, key)
    assert(!auth.TurnVerifyMessageIntegrity(req, wrongKey), "MI rejects wrong key")
    echo("turn_allocate_smoke: negative MI ok")
    return 0

fn main(): int32 =
    let r1: int32 = checkAllocateRoundtrip()
    if r1 != 0:
        return r1
    let r2: int32 = checkNegativeMi()
    if r2 != 0:
        return r2
    echo("turn_allocate_smoke ok")
    return 0
