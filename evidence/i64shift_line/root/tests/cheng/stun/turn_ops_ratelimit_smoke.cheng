# turn_ops_ratelimit_smoke: stage 4 per-IP allocation rate limit (unit).
#
# maxPerIp=3: three allocations from the same host are admitted (rc=0); the
# fourth is rejected (rc=1). A different host is admitted independently. After a
# Dec, a slot frees and the original host is admitted again.

import std/system
import std/stun/turn_ratelimit as ratelimit

const
    maxPerIp = 3
    hostA = "10.0.0.1"
    hostB = "10.0.0.2"

fn checkAdmit(a: var ratelimit.TurnRateLimit, host: str, expectRc: int32, label: str): int32 =
    let rc: int32 = ratelimit.TurnRateLimitCheckInc(a, host)
    if rc != expectRc:
        echo(Fmt"ratelimit: {label} expected rc={expectRc} got rc={rc}")
        return 1
    return 0

fn main(): int32 =
    let a: ratelimit.TurnRateLimit = ratelimit.TurnRateLimitNew(maxPerIp)
    let r1: int32 = checkAdmit(a, hostA, 0, "A#1")
    if r1 != 0:
        return r1
    let r2: int32 = checkAdmit(a, hostA, 0, "A#2")
    if r2 != 0:
        return r2
    let r3: int32 = checkAdmit(a, hostA, 0, "A#3")
    if r3 != 0:
        return r3
    let r4: int32 = checkAdmit(a, hostA, 1, "A#4 over limit")
    if r4 != 0:
        return r4
    let cnt: int32 = ratelimit.TurnRateLimitCount(a, hostA)
    if cnt != maxPerIp:
        echo(Fmt"ratelimit: A count expected {maxPerIp} got {cnt}")
        return 5
    let r5: int32 = checkAdmit(a, hostB, 0, "B#1 independent")
    if r5 != 0:
        return r5
    ratelimit.TurnRateLimitDec(a, hostA)
    let r6: int32 = checkAdmit(a, hostA, 0, "A#5 after dec")
    if r6 != 0:
        return r6
    echo("turn_ops_ratelimit_smoke ok")
    return 0
