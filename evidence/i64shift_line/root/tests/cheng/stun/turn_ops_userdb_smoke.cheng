# turn_ops_userdb_smoke: stage 4 flat-file userdb load + lookup (unit).
#
# Writes a temp userdb with a REST secret line and a long-term-credential row
# (ha1 = MD5(user:realm:pass) as hex), then verifies TurnLoadUserDb loads it and
# TurnLookupRestSecret / TurnLookupLongTermKey return the right bytes.

import std/system
import std/rawbytes
import std/os
import std/stun/turn_auth as auth
import std/stun/turn_userdb as userdb

const
    tmpPath = "/tmp/turn_ops_userdb.txt"
    realmStr = "unimaker.fun"
    userStr = "bob"
    passStr = "pass123"
    restSecretStr = "restsecretxyz"

fn writeFile(path: str, content: str): int32 =
    os.WriteFile(path, content)
    let check: str = os.ReadFile(path)
    if check != content:
        return 1
    return 0

fn buildUserdbContent(ha1Hex: str): str =
    let line1: str = "secret " + restSecretStr
    let line2: str = "lt " + userStr + " " + realmStr + " " + ha1Hex
    return line1 + "\n" + line2 + "\n"

fn checkRestSecret(db: userdb.TurnUserDb): int32 =
    if !userdb.TurnUserDbHasRestSecret(db):
        echo("userdb: rest secret not set")
        return 1
    let got: rawbytes.Bytes = userdb.TurnLookupRestSecret(db)
    let want: rawbytes.Bytes = rawbytes.BytesFromString(restSecretStr)
    if !rawbytes.BytesEqual(got, want):
        echo("userdb: rest secret mismatch")
        return 2
    return 0

fn checkLongTermKey(db: userdb.TurnUserDb): int32 =
    let want: rawbytes.Bytes = auth.TurnLongTermKey(userStr, realmStr, passStr)
    let got: rawbytes.Bytes = userdb.TurnLookupLongTermKey(db, userStr, realmStr)
    if rawbytes.BytesLen(got) <= 0:
        echo("userdb: long-term key missing")
        return 1
    if !rawbytes.BytesEqual(got, want):
        echo("userdb: long-term key mismatch")
        return 2
    let miss: rawbytes.Bytes = userdb.TurnLookupLongTermKey(db, "nobody", realmStr)
    if rawbytes.BytesLen(miss) > 0:
        echo("userdb: unknown user should return empty key")
        return 3
    return 0

fn main(): int32 =
    let key: rawbytes.Bytes = auth.TurnLongTermKey(userStr, realmStr, passStr)
    let ha1Hex: str = rawbytes.BytesToHex(key)
    let content: str = buildUserdbContent(ha1Hex)
    let wrc: int32 = writeFile(tmpPath, content)
    if wrc != 0:
        echo("userdb: write temp file failed")
        return 1
    let db: userdb.TurnUserDb = userdb.TurnLoadUserDb(tmpPath)
    if !userdb.TurnUserDbLoaded(db):
        echo(Fmt"userdb: load failed err={userdb.TurnUserDbError(db)}")
        return 2
    if userdb.TurnUserDbLtCount(db) != 1:
        echo(Fmt"userdb: lt count expected 1 got={userdb.TurnUserDbLtCount(db)}")
        return 3
    let r1: int32 = checkRestSecret(db)
    if r1 != 0:
        return r1
    let r2: int32 = checkLongTermKey(db)
    if r2 != 0:
        return r2
    echo("turn_ops_userdb_smoke ok")
    return 0
