# Stage-0 optional interop: cheng STUN client <-> coturn on vultr.
# Sends a Binding Request over UDP to 64.176.84.12:3478, decodes the Binding
# Response, and verifies magic cookie, echoed transaction id, XOR-MAPPED-ADDRESS
# and FINGERPRINT. A 2s SO_RCVTIMEO guards the recv so it cannot hang.

import std/result
import std/rawbytes
import std/system
import std/os
import std/net/transports/udp_syscall as udp
import std/stun/protocol as stun

const
    coturnHost = "64.176.84.12"
    coturnPort = 3478
    solSocket = 65535
    soRcvTimeo = 4102

fn makeTxid(): rawbytes.Bytes =
    let txid: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    var i: int32
    for i in i..<12:
        rawbytes.BytesSet(txid, i, i + 41)
    return txid

fn setRecvTimeout(fd: int32, seconds: int32): int32 =
    let tv: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    rawbytes.BytesSet(tv, 0, seconds)
    return os.UdpSetSockOptIntFd(fd, solSocket, soRcvTimeo, tv)

fn main(): int32 =
    let socketRes = udp.UdpSocketOpenDgram(false)
    if IsErr(socketRes):
        echo("coturn_interop: socket open failed")
        return 101
    let socket = Value(socketRes)
    var dst: udp.UdpSockAddr
    let useLen: bool = os.UdpPlatformUseLenFieldBridge() != 0
    let addrRes = udp.UdpSockAddrFromHostPort(coturnHost, coturnPort, false, socket.family, useLen, dst)
    if IsErr(addrRes):
        echo("coturn_interop: addr build failed")
        let _ = os.UdpCloseFd(socket.fd)
        return 102
    let toRc: int32 = setRecvTimeout(socket.fd, 2)
    if toRc != 0:
        echo("coturn_interop: setsockopt SO_RCVTIMEO failed")
        let _ = os.UdpCloseFd(socket.fd)
        return 103
    let txid: rawbytes.Bytes = makeTxid()
    let req: rawbytes.Bytes = stun.StunEncodeBindingRequest(txid)
    let sendRes: Result[int32] = udp.UdpSendTo(socket.fd, req, dst)
    if IsErr(sendRes):
        echo("coturn_interop: send failed")
        let _ = os.UdpCloseFd(socket.fd)
        return 104
    let sent: int32 = Value(sendRes)
    if sent != rawbytes.BytesLen(req):
        echo("coturn_interop: short send")
        let _ = os.UdpCloseFd(socket.fd)
        return 105
    var recv: udp.UdpRecvResult
    let recvRes: Result[bool] = udp.UdpRecvFromBlocking(socket.fd, 1500, recv)
    let _ = os.UdpCloseFd(socket.fd)
    if IsErr(recvRes):
        echo("coturn_interop: recv failed or timed out")
        return 106
    let resp: rawbytes.Bytes = recv.data
    echo(Fmt"coturn_interop: resp len={rawbytes.BytesLen(resp)} hex={rawbytes.BytesToHex(resp)}")
    if rawbytes.BytesLen(resp) < 20:
        echo("coturn_interop: response too short")
        return 107
    let h: stun.StunHeader = stun.StunDecodeHeader(resp)
    if h.msgType != 0x0101:
        echo("coturn_interop: response not Binding Response")
        return 108
    if h.magic != int64(0x2112A442):
        echo("coturn_interop: magic cookie mismatch")
        return 109
    if !rawbytes.BytesEqual(h.txid, txid):
        echo("coturn_interop: transaction id mismatch")
        return 110
    let attrs: stun.StunAttributes = stun.StunDecodeAttributes(resp, h.magic, txid)
    if !attrs.hasXorMapped:
        echo("coturn_interop: no XOR-MAPPED-ADDRESS")
        return 111
    if attrs.xorMapped.family != 0x01:
        echo("coturn_interop: xor-mapped family not IPv4")
        return 112
    let hasFp: bool = stun.StunVerifyFingerprint(resp)
    echo(Fmt"coturn_interop: xor-mapped port={attrs.xorMapped.port} ip={rawbytes.BytesToHex(attrs.xorMapped.ip)}")
    echo(Fmt"coturn_interop: fingerprint verified={hasFp}")
    if !hasFp:
        echo("coturn_interop: FINGERPRINT missing or invalid (coturn may omit it; non-fatal)")
    echo("coturn_interop_smoke ok")
    return 0
