fn MediaIngestReceiptStamp(receipt: var MediaIngestReceipt,
                           startedAtMs: int64,
                           completedAtMs: int64) =
    receipt.startedAtMs = startedAtMs
    receipt.completedAtMs = completedAtMs
    receipt.elapsedMs = MediaLifecycleElapsedMs(startedAtMs, completedAtMs)

fn MediaOpenReceiptStamp(receipt: var MediaOpenReceipt,
                         startedAtMs: int64,
                         completedAtMs: int64) =
    receipt.startedAtMs = startedAtMs
    receipt.completedAtMs = completedAtMs
    receipt.elapsedMs = MediaLifecycleElapsedMs(startedAtMs, completedAtMs)

fn MediaPlaybackSessionStampOpen(session: var MediaPlaybackSession,
                                 startedAtMs: int64,
                                 completedAtMs: int64) =
    session.openedAtMs = completedAtMs
    session.openElapsedMs = MediaLifecycleElapsedMs(startedAtMs, completedAtMs)

fn MediaFrameReceiptStamp(receipt: var MediaFrameReceipt,
                          startedAtMs: int64,
                          completedAtMs: int64,
                          sessionOpenedAtMs: int64) =
    if len(receipt.receiptCid) <= 0:
        receipt.receiptCid = MediaFrameReceiptCid(receipt)
    receipt.startedAtMs = startedAtMs
    receipt.completedAtMs = completedAtMs
    receipt.elapsedMs = MediaLifecycleElapsedMs(startedAtMs, completedAtMs)
    receipt.sessionOpenedAtMs = sessionOpenedAtMs
    receipt.openToFrameMs = MediaLifecycleElapsedMs(sessionOpenedAtMs, completedAtMs)

fn MediaImageReceiptStamp(receipt: var MediaImageReceipt,
                          startedAtMs: int64,
                          completedAtMs: int64,
                          sessionOpenedAtMs: int64) =
    if len(receipt.receiptCid) <= 0:
        receipt.receiptCid = MediaImageReceiptCid(receipt)
    receipt.startedAtMs = startedAtMs
    receipt.completedAtMs = completedAtMs
    receipt.elapsedMs = MediaLifecycleElapsedMs(startedAtMs, completedAtMs)
    receipt.sessionOpenedAtMs = sessionOpenedAtMs
    receipt.openToImageMs = MediaLifecycleElapsedMs(sessionOpenedAtMs, completedAtMs)

fn MediaAudioReceiptStamp(receipt: var MediaAudioReceipt,
                          startedAtMs: int64,
                          completedAtMs: int64,
                          sessionOpenedAtMs: int64) =
    if len(receipt.receiptCid) <= 0:
        receipt.receiptCid = MediaAudioReceiptCid(receipt)
    receipt.startedAtMs = startedAtMs
    receipt.completedAtMs = completedAtMs
    receipt.elapsedMs = MediaLifecycleElapsedMs(startedAtMs, completedAtMs)
    receipt.sessionOpenedAtMs = sessionOpenedAtMs
    receipt.openToAudioMs = MediaLifecycleElapsedMs(sessionOpenedAtMs, completedAtMs)

fn MediaAssetAppendLine(lines: var str[], key: str, value: str) =
    add(lines, strutil.Join([key, "=", value], ""))

fn MediaAssetAppendIntLine(lines: var str[], key: str, value: int32) =
    MediaAssetAppendLine(lines, key, IntToStr(value))

fn MediaAssetAppendInt64Line(lines: var str[], key: str, value: int64) =
    MediaAssetAppendLine(lines, key, strings.Int64ToStr(value))

fn MediaAssetJoinIntCsv(values: int32[]): str =
    var parts: str[]
    parts = []
    var i: int32
    for i in i..<values.len:
        add(parts, IntToStr(values[i]))
    return strutil.Join(parts, ",")

fn MediaAssetKindFromMime(mime: str): Result[int32] =
    if strutil.StartsWith(mime, "video/"):
        return Ok[int32](MediaAssetKindVideo)
    if strutil.StartsWith(mime, "image/"):
        return Ok[int32](MediaAssetKindImage)
    if strutil.StartsWith(mime, "audio/"):
        return Ok[int32](MediaAssetKindAudio)
    return Err[int32]("media asset: unsupported mime kind")

fn MediaAssetNormalizeKind(kindCode: int32, mime: str): Result[int32] =
    if kindCode == MediaAssetKindVideo || kindCode == MediaAssetKindImage || kindCode == MediaAssetKindAudio:
        return Ok[int32](kindCode)
    return MediaAssetKindFromMime(mime)

@borrows
fn MediaAssetValidateBuildRequest(request: MediaAssetBuildRequest): Result[int32] =
    if rawbytes.BytesLen(request.blob) <= 0:
        return Err[int32]("media asset: empty blob")
    if len(request.ownerPeerId) <= 0:
        return Err[int32]("media asset: missing owner peer")
    if len(request.remotePeersCsv) <= 0:
        return Err[int32]("media asset: missing remote peers")
    if len(request.mime) <= 0:
        return Err[int32]("media asset: missing mime")
    if len(request.codec) <= 0:
        return Err[int32]("media asset: missing codec")
    if len(request.contentSignature) <= 0:
        return Err[int32]("media asset: missing content signature")
    if request.initSegmentByteLength <= 0:
        return Err[int32]("media asset: missing init segment byte length")
    if request.initSegmentByteLength > rawbytes.BytesLen(request.blob):
        return Err[int32]("media asset: init segment exceeds blob")
    if request.objectTargetBytes > 0 && request.objectTargetBytes < request.initSegmentByteLength:
        return Err[int32]("media asset: object target smaller than init segment")
    let kindRes = MediaAssetNormalizeKind(request.kindCode, request.mime)
    if IsErr(kindRes):
        return Err[int32](Error(kindRes))
    let kindCode = Value(kindRes)
    let mimeKindRes = MediaAssetKindFromMime(request.mime)
    if IsErr(mimeKindRes):
        return Err[int32](Error(mimeKindRes))
    if Value(mimeKindRes) != kindCode:
        return Err[int32]("media asset: kind/mime mismatch")
    if kindCode == MediaAssetKindVideo:
        if request.durationMs <= int64(0):
            return Err[int32]("media asset: missing video duration")
        if len(request.posterCid) <= 0:
            return Err[int32]("media asset: missing video poster cid")
        if len(request.initSegmentCid) <= 0:
            return Err[int32]("media asset: missing video init segment cid")
        if len(request.keyframeIndex) <= 0:
            return Err[int32]("media asset: missing video keyframe index")
    elif kindCode == MediaAssetKindImage:
        if len(request.posterCid) <= 0:
            return Err[int32]("media asset: missing image preview cid")
        if len(request.initSegmentCid) <= 0:
            return Err[int32]("media asset: missing image metadata cid")
        if len(request.keyframeIndex) <= 0:
            return Err[int32]("media asset: missing image frame index")
    elif kindCode == MediaAssetKindAudio:
        if request.durationMs <= int64(0):
            return Err[int32]("media asset: missing audio duration")
        if len(request.posterCid) <= 0:
            return Err[int32]("media asset: missing audio cover cid")
        if len(request.initSegmentCid) <= 0:
            return Err[int32]("media asset: missing audio init segment cid")
        if len(request.keyframeIndex) <= 0:
            return Err[int32]("media asset: missing audio seek index")
    return Ok[int32](kindCode)

@borrows
fn MediaAssetObjectFromMoq(input: fountain.MoqFountainObject): MediaObjectDescriptor =
    return MediaObjectDescriptor(
        objectIndex: input.objectIndex,
        objectId: strings.CloneStr(input.objectId),
        objectCid: strings.CloneStr(input.objectCid),
        byteOffset: input.byteOffset,
        byteLength: input.byteLength,
        sourceBlockBytes: input.sourceBlockBytes,
        sourceBlockCount: input.sourceBlockCount,
        priority: input.priority
    )

@borrows
fn MediaAssetDropletFromMoq(input: fountain.MoqFountainDroplet): MediaDropletDescriptor =
    var blockIndexesOwned: int32[]
    var bi: int32
    for bi in bi..<input.blockIndexes.len:
        add(blockIndexesOwned, input.blockIndexes[bi])
    return MediaDropletDescriptor(
        objectIndex: input.objectIndex,
        dropletIndex: input.dropletIndex,
        kindCode: input.kindCode,
        key: strings.CloneStr(input.key),
        peerId: strings.CloneStr(input.peerId),
        cid: strings.CloneStr(input.cid),
        degree: input.degree,
        blockIndexes: blockIndexesOwned,
        payload: rawbytes.BytesSlice(input.payload, 0, rawbytes.BytesLen(input.payload))
    )

@borrows
fn MediaAssetManifestValidate(manifest: MediaAssetManifest): Result[bool] =
    if len(manifest.assetCid) <= 0:
        return Err[bool]("media asset: missing asset cid")
    if len(manifest.bundleCid) <= 0:
        return Err[bool]("media asset: missing bundle cid")
    if len(manifest.mime) <= 0:
        return Err[bool]("media asset: missing mime")
    if len(manifest.codec) <= 0:
        return Err[bool]("media asset: missing codec")
    if len(manifest.contentSignature) <= 0:
        return Err[bool]("media asset: missing content signature")
    if manifest.transport != MediaAssetTransportMoq:
        return Err[bool]("media asset: unsupported transport")
    if manifest.fecScheme != MediaAssetFecLtXorV1Experimental:
        return Err[bool]("media asset: unsupported fec scheme")
    if manifest.objects.len <= 0:
        return Err[bool]("media asset: empty object list")
    if manifest.droplets.len <= 0:
        return Err[bool]("media asset: empty droplet list")
    if manifest.initSegmentByteLength <= 0:
        return Err[bool]("media asset: missing init segment byte length")
    if manifest.objects[0].byteOffset != 0:
        return Err[bool]("media asset: init segment must start in first object")
    if manifest.objects[0].byteLength < manifest.initSegmentByteLength:
        return Err[bool]("media asset: init segment exceeds first object")
    let mimeKindRes = MediaAssetKindFromMime(manifest.mime)
    if IsErr(mimeKindRes):
        return Err[bool](Error(mimeKindRes))
    if Value(mimeKindRes) != manifest.kindCode:
        return Err[bool]("media asset: kind/mime mismatch")
    if manifest.kindCode == MediaAssetKindVideo:
        if manifest.durationMs <= int64(0):
            return Err[bool]("media asset: missing video duration")
        if len(manifest.posterCid) <= 0:
            return Err[bool]("media asset: missing video poster cid")
        if len(manifest.initSegmentCid) <= 0:
            return Err[bool]("media asset: missing video init segment cid")
        if len(manifest.keyframeIndex) <= 0:
            return Err[bool]("media asset: missing video keyframe index")
    elif manifest.kindCode == MediaAssetKindImage:
        if len(manifest.posterCid) <= 0:
            return Err[bool]("media asset: missing image preview cid")
        if len(manifest.initSegmentCid) <= 0:
            return Err[bool]("media asset: missing image metadata cid")
        if len(manifest.keyframeIndex) <= 0:
            return Err[bool]("media asset: missing image frame index")
    elif manifest.kindCode == MediaAssetKindAudio:
        if manifest.durationMs <= int64(0):
            return Err[bool]("media asset: missing audio duration")
        if len(manifest.posterCid) <= 0:
            return Err[bool]("media asset: missing audio cover cid")
        if len(manifest.initSegmentCid) <= 0:
            return Err[bool]("media asset: missing audio init segment cid")
        if len(manifest.keyframeIndex) <= 0:
            return Err[bool]("media asset: missing audio seek index")
    else:
        return Err[bool]("media asset: invalid kind")
    return Ok[bool](true)

fn MediaAssetManifestContentByteLength(manifest: var MediaAssetManifest): Result[int32] =
    let validateRes = MediaAssetManifestValidate(manifest)
    if IsErr(validateRes):
        return Err[int32](Error(validateRes))
    var maxEnd: int32
    var i: int32
    for i in i..<manifest.objects.len:
        let item = manifest.objects[i]
        if item.byteOffset < 0 || item.byteLength <= 0:
            return Err[int32]("media asset: invalid object byte range")
        let itemEnd = item.byteOffset + item.byteLength
        if itemEnd < item.byteOffset:
            return Err[int32]("media asset: object byte range overflow")
        if itemEnd > maxEnd:
            maxEnd = itemEnd
    if maxEnd <= 0:
        return Err[int32]("media asset: empty content byte length")
    return Ok[int32](maxEnd)

fn MediaAssetBuildManifest(request: MediaAssetBuildRequest): Result[MediaAssetManifest] =
    let kindRes = MediaAssetValidateBuildRequest(request)
    if IsErr(kindRes):
        return Err[MediaAssetManifest](Error(kindRes))
    let buildRes = fountain.MoqFountainBuild(request.blob,
                                             request.ownerPeerId,
                                             request.remotePeersCsv,
                                             request.mime,
                                             request.objectTargetBytes,
                                             request.sourceBlockBytes,
                                             request.repairDropletCount)
    if IsErr(buildRes):
        return Err[MediaAssetManifest](Error(buildRes))
    fountain.MoqFountainProfileMark("ingest:fountain_build_done")
    let built = Value(buildRes)
    var objects: MediaObjectDescriptor[]
    objects = []
    var oi: int32
    for oi in oi..<built.objects.len:
        add(objects, MediaAssetObjectFromMoq(built.objects[oi]))
    fountain.MoqFountainProfileMark("ingest:objects_descriptor_copy_done")
    var droplets: MediaDropletDescriptor[]
    droplets = []
    var di: int32
    for di in di..<built.droplets.len:
        add(droplets, MediaAssetDropletFromMoq(built.droplets[di]))
    fountain.MoqFountainProfileMark("ingest:droplets_descriptor_copy_done")
    let manifest = MediaAssetManifest(
        assetCid: strings.CloneStr(built.blobCid),
        bundleCid: strings.CloneStr(built.bundleCid),
        mime: strings.CloneStr(built.mimeType),
        kindCode: Value(kindRes),
        durationMs: request.durationMs,
        codec: strings.CloneStr(request.codec),
        posterCid: strings.CloneStr(request.posterCid),
        initSegmentCid: strings.CloneStr(request.initSegmentCid),
        initSegmentByteLength: request.initSegmentByteLength,
        keyframeIndex: strings.CloneStr(request.keyframeIndex),
        transport: MediaAssetTransportMoq,
        fecScheme: MediaAssetFecLtXorV1Experimental,
        contentSignature: strings.CloneStr(request.contentSignature),
        catalogCid: strings.CloneStr(built.catalogCid),
        catalogKey: strings.CloneStr(built.catalogKey),
        rebuildTemplateCid: strings.CloneStr(built.rebuildTemplateCid),
        rebuildTemplateKey: strings.CloneStr(built.rebuildTemplateKey),
        objectTargetBytes: built.objectTargetBytes,
        sourceBlockBytes: built.sourceBlockBytes,
        objects: objects,
        droplets: droplets
    )
    let validateRes = MediaAssetManifestValidate(manifest)
    if IsErr(validateRes):
        return Err[MediaAssetManifest](Error(validateRes))
    fountain.MoqFountainProfileMark("ingest:build_manifest_validate_done")
    return Ok[MediaAssetManifest](manifest)

# Collapsed line builder for MediaAssetManifestWire's object/droplet rows (a
# single 5.9MB asset has ~90 objects and ~5930 droplets, so this runs tens of
# thousands of times). The old body allocated the composite key first (one
# strutil.Join([ share(prefix), share(field)], "")) and only then handed it to
# MediaAssetAppendLine, which allocated a *second* time for "key=value" — two
# small allocations per field. This builds "prefix+field=value" with one Join
# call instead of two, halving the allocation count while staying on the
# small-allocation path (measured faster on this backend than materializing a
# single large pre-sized buffer via cheng/std/bytes_layout.ByteBuf and copying
# it out at the end — that path benchmarked 10-15x *slower* here for a ~2MB
# manifest, so it is deliberately not used despite lower Big-O allocation
# count: see bytebuf_call_depth_bench_main.cheng for the isolated A/B).
# Wire text is built straight into one growable ByteBuf (mirrors the
# rebuild_template optimization in moq_fountain): the previous form built
# ~47k intermediate line strings (each an allocate+join round trip) then
# joined them into a ~2MB text. Direct appends emit the exact same bytes —
# Join(lines, "\n") semantics: a separator between lines, none trailing.
fn MediaAssetWireAppendStr(buf: var layout.ByteBuf, text: str) =
    if len(text) > 0:
        layout.ByteBufAppendBytes(buf, rawbytes.BytesFromString(text))

fn MediaAssetWireAppendSep(buf: var layout.ByteBuf, first: var bool) =
    if first:
        first = false
    else:
        layout.ByteBufAppendByte(buf, int32('\n'))

fn MediaAssetWireLineInto(buf: var layout.ByteBuf, first: var bool, key: str, value: str) =
    MediaAssetWireAppendSep(buf, first)
    MediaAssetWireAppendStr(buf, key)
    layout.ByteBufAppendByte(buf, int32('='))
    MediaAssetWireAppendStr(buf, value)

fn MediaAssetWireIntLineInto(buf: var layout.ByteBuf, first: var bool, key: str, value: int32) =
    MediaAssetWireAppendSep(buf, first)
    MediaAssetWireAppendStr(buf, key)
    layout.ByteBufAppendByte(buf, int32('='))
    fountain.MoqFountainByteBufAppendInt(buf, value)

fn MediaAssetWireInt64LineInto(buf: var layout.ByteBuf, first: var bool, key: str, value: int64) =
    MediaAssetWireLineInto(buf, first, key, strings.Int64ToStr(value))

fn MediaAssetWireItemLineInto(buf: var layout.ByteBuf, first: var bool, groupWord: str, index: int32, field: str, value: str) =
    MediaAssetWireAppendSep(buf, first)
    MediaAssetWireAppendStr(buf, groupWord)
    fountain.MoqFountainByteBufAppendInt(buf, index)
    layout.ByteBufAppendByte(buf, int32('.'))
    MediaAssetWireAppendStr(buf, field)
    layout.ByteBufAppendByte(buf, int32('='))
    MediaAssetWireAppendStr(buf, value)

fn MediaAssetWireItemIntLineInto(buf: var layout.ByteBuf, first: var bool, groupWord: str, index: int32, field: str, value: int32) =
    MediaAssetWireAppendSep(buf, first)
    MediaAssetWireAppendStr(buf, groupWord)
    fountain.MoqFountainByteBufAppendInt(buf, index)
    layout.ByteBufAppendByte(buf, int32('.'))
    MediaAssetWireAppendStr(buf, field)
    layout.ByteBufAppendByte(buf, int32('='))
    fountain.MoqFountainByteBufAppendInt(buf, value)

# Same bytes as MediaAssetWireItemLineInto(..., MediaAssetJoinIntCsv(values))
# (empty -> nothing after '=', "," between values, none trailing) without
# materializing the per-droplet joined string.
fn MediaAssetWireItemCsvLineInto(buf: var layout.ByteBuf, first: var bool, groupWord: str, index: int32, field: str, values: int32[]) =
    MediaAssetWireAppendSep(buf, first)
    MediaAssetWireAppendStr(buf, groupWord)
    fountain.MoqFountainByteBufAppendInt(buf, index)
    layout.ByteBufAppendByte(buf, int32('.'))
    MediaAssetWireAppendStr(buf, field)
    layout.ByteBufAppendByte(buf, int32('='))
    fountain.MoqFountainByteBufAppendIntCsv(buf, values)

@borrows
fn MediaAssetManifestWireInto(manifest: MediaAssetManifest, buf: var layout.ByteBuf): Result[bool] =
    let validateRes = MediaAssetManifestValidate(manifest)
    if IsErr(validateRes):
        return Err[bool](Error(validateRes))
    var first = true
    MediaAssetWireLineInto(buf, first, "magic", MediaAssetManifestMagic)
    MediaAssetWireLineInto(buf, first, "asset_cid", manifest.assetCid)
    MediaAssetWireLineInto(buf, first, "bundle_cid", manifest.bundleCid)
    MediaAssetWireLineInto(buf, first, "mime", manifest.mime)
    MediaAssetWireIntLineInto(buf, first, "kind_code", manifest.kindCode)
    MediaAssetWireInt64LineInto(buf, first, "duration_ms", manifest.durationMs)
    MediaAssetWireLineInto(buf, first, "codec", manifest.codec)
    MediaAssetWireLineInto(buf, first, "poster_cid", manifest.posterCid)
    MediaAssetWireLineInto(buf, first, "init_segment_cid", manifest.initSegmentCid)
    MediaAssetWireIntLineInto(buf, first, "init_segment_byte_length", manifest.initSegmentByteLength)
    MediaAssetWireLineInto(buf, first, "keyframe_index", manifest.keyframeIndex)
    MediaAssetWireLineInto(buf, first, "transport", manifest.transport)
    MediaAssetWireLineInto(buf, first, "fec_scheme", manifest.fecScheme)
    MediaAssetWireLineInto(buf, first, "content_signature", manifest.contentSignature)
    MediaAssetWireLineInto(buf, first, "catalog_cid", manifest.catalogCid)
    MediaAssetWireLineInto(buf, first, "catalog_key", manifest.catalogKey)
    MediaAssetWireLineInto(buf, first, "rebuild_template_cid", manifest.rebuildTemplateCid)
    MediaAssetWireLineInto(buf, first, "rebuild_template_key", manifest.rebuildTemplateKey)
    MediaAssetWireIntLineInto(buf, first, "object_target_bytes", manifest.objectTargetBytes)
    MediaAssetWireIntLineInto(buf, first, "source_block_bytes", manifest.sourceBlockBytes)
    MediaAssetWireIntLineInto(buf, first, "object_count", manifest.objects.len)
    MediaAssetWireIntLineInto(buf, first, "droplet_count", manifest.droplets.len)
    var oi: int32
    for oi in oi..<manifest.objects.len:
        let item = manifest.objects[oi]
        MediaAssetWireItemIntLineInto(buf, first, "object.", oi, "object_index", item.objectIndex)
        MediaAssetWireItemLineInto(buf, first, "object.", oi, "object_id", item.objectId)
        MediaAssetWireItemLineInto(buf, first, "object.", oi, "object_cid", item.objectCid)
        MediaAssetWireItemIntLineInto(buf, first, "object.", oi, "byte_offset", item.byteOffset)
        MediaAssetWireItemIntLineInto(buf, first, "object.", oi, "byte_length", item.byteLength)
        MediaAssetWireItemIntLineInto(buf, first, "object.", oi, "source_block_bytes", item.sourceBlockBytes)
        MediaAssetWireItemIntLineInto(buf, first, "object.", oi, "source_block_count", item.sourceBlockCount)
        MediaAssetWireItemIntLineInto(buf, first, "object.", oi, "priority", item.priority)
    var di: int32
    for di in di..<manifest.droplets.len:
        let item = manifest.droplets[di]
        MediaAssetWireItemIntLineInto(buf, first, "droplet.", di, "object_index", item.objectIndex)
        MediaAssetWireItemIntLineInto(buf, first, "droplet.", di, "droplet_index", item.dropletIndex)
        MediaAssetWireItemIntLineInto(buf, first, "droplet.", di, "kind_code", item.kindCode)
        MediaAssetWireItemLineInto(buf, first, "droplet.", di, "key", item.key)
        MediaAssetWireItemLineInto(buf, first, "droplet.", di, "peer_id", item.peerId)
        MediaAssetWireItemLineInto(buf, first, "droplet.", di, "cid", item.cid)
        MediaAssetWireItemIntLineInto(buf, first, "droplet.", di, "degree", item.degree)
        MediaAssetWireItemCsvLineInto(buf, first, "droplet.", di, "block_indexes", item.blockIndexes)
    return Ok[bool](true)

@borrows
fn MediaAssetManifestWireBufInit(manifest: MediaAssetManifest): layout.ByteBuf =
    let estimate = manifest.droplets.len * 384 + manifest.objects.len * 384 + 4096
    return layout.ByteBufInit(fountain.MoqFountainMaxInt32(4096, estimate))

@borrows
fn MediaAssetManifestWire(manifest: MediaAssetManifest): Result[str] =
    var buf = MediaAssetManifestWireBufInit(manifest)
    let okRes = MediaAssetManifestWireInto(manifest, buf)
    if IsErr(okRes):
        return Err[str](Error(okRes))
    return Ok[str](rawbytes.BytesToString(layout.ByteBufToBytes(buf)))

@borrows
fn MediaAssetManifestCid(manifest: MediaAssetManifest): Result[str] =
    var buf = MediaAssetManifestWireBufInit(manifest)
    let okRes = MediaAssetManifestWireInto(manifest, buf)
    if IsErr(okRes):
        return Err[str](Error(okRes))
    return Ok[str](MediaAssetSha256Hex(layout.ByteBufToBytes(buf)))

# One wire serialization feeding both the cid hash and the wire length: the
# exact same bytes MediaAssetManifestCid hashes, with the byte count the
# receipt's manifestBytes field reports (len of the identical wire text).
@borrows
fn MediaAssetManifestCidWithWireLen(manifest: MediaAssetManifest): Result[MediaAssetManifestCidInfo] =
    var buf = MediaAssetManifestWireBufInit(manifest)
    let okRes = MediaAssetManifestWireInto(manifest, buf)
    if IsErr(okRes):
        return Err[MediaAssetManifestCidInfo](Error(okRes))
    let wireBytes = layout.ByteBufToBytes(buf)
    var info: MediaAssetManifestCidInfo
    info.cid = MediaAssetSha256Hex(wireBytes)
    info.wireBytes = rawbytes.BytesLen(wireBytes)
    return Ok[MediaAssetManifestCidInfo](info)

fn MediaAssetIdentity(assetCid: str, bundleCid: str, manifestCid: str): str =
    return strutil.Join([assetCid, "|", bundleCid, "|", manifestCid], "")

fn MediaLocalIndexInit(): MediaLocalIndex =
    var manifests: MediaAssetManifest[]
    manifests = []
    var manifestCids: str[]
    manifestCids = []
    var assetRecords: MediaLocalAssetRecord[]
    assetRecords = []
    return MediaLocalIndex(manifests: manifests, manifestCids: manifestCids, assetRecords: assetRecords)

# Pin steps after the cid is known: duplicate detection + index append, shared
# by MediaLocalIndexPinManifest (which computes the cid itself) and the ingest
# hot path (which computed the same cid one serialization earlier).
fn mediaLocalIndexPinManifestWithCid(index: var MediaLocalIndex, manifest: var MediaAssetManifest, manifestCid: str): Result[str] =
    var i: int32
    for i in i..<index.manifestCids.len:
        if index.manifestCids[i] == manifestCid:
            return Ok[str](manifestCid)
        if index.manifests[i].assetCid == manifest.assetCid:
            return Err[str]("media runtime: duplicate asset cid with different manifest")
    add(index.manifests, share(manifest))
    add(index.manifestCids, share(manifestCid))
    var record: MediaLocalAssetRecord
    record.assetCid = manifest.assetCid
    record.manifestCid = share(manifestCid)
    record.assetBytes = rawbytes.EmptyBytes()
    record.posterBytes = rawbytes.EmptyBytes()
    record.initSegmentBytes = rawbytes.EmptyBytes()
    add(index.assetRecords, record)
    return Ok[str](manifestCid)

fn MediaLocalIndexPinManifest(index: var MediaLocalIndex, manifest: var MediaAssetManifest): Result[str] =
    let validateRes = MediaAssetManifestValidate(manifest)
    if IsErr(validateRes):
        return Err[str](Error(validateRes))
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[str](Error(manifestCidRes))
    return mediaLocalIndexPinManifestWithCid(index, manifest, Value(manifestCidRes))

@borrows
fn MediaLocalIndexFind(index: var MediaLocalIndex, assetCid: str): Result[MediaAssetManifest] =
    if len(assetCid) <= 0:
        return Err[MediaAssetManifest]("media runtime: missing asset cid")
    var i: int32
    for i in i..<index.manifests.len:
        if index.manifests[i].assetCid == assetCid:
            var owned: MediaAssetManifest
            owned = index.manifests[i]
            return Ok[MediaAssetManifest](owned)
    return Err[MediaAssetManifest]("media runtime: asset not pinned")

# Shared pinned-bytes validation (empty checks + cid re-hash guards) for both
# PinAssetBytes entry points; profile marks and error texts unchanged.
fn mediaLocalIndexCheckPinnedBytes(manifest: var MediaAssetManifest,
                                   assetBytes: rawbytes.Bytes,
                                   posterBytes: rawbytes.Bytes,
                                   initSegmentBytes: rawbytes.Bytes,
                                   trustedInMemory: bool): Result[bool] =
    if rawbytes.BytesLen(assetBytes) <= 0:
        return Err[bool]("media runtime: empty pinned asset bytes")
    if rawbytes.BytesLen(posterBytes) <= 0:
        return Err[bool]("media runtime: empty pinned poster bytes")
    if rawbytes.BytesLen(initSegmentBytes) <= 0:
        return Err[bool]("media runtime: empty pinned init segment bytes")
    if !trustedInMemory:
        fountain.MoqFountainProfileMark("ingest:pin_asset_sha256_untrusted_begin")
        if MediaAssetSha256Hex(assetBytes) != manifest.assetCid:
            return Err[bool]("media runtime: pinned asset cid mismatch")
        fountain.MoqFountainProfileMark("ingest:pin_asset_sha256_untrusted_done")
    fountain.MoqFountainProfileMark("ingest:pin_poster_sha256_begin")
    if MediaAssetSha256Hex(posterBytes) != manifest.posterCid:
        return Err[bool]("media runtime: pinned poster cid mismatch")
    fountain.MoqFountainProfileMark("ingest:pin_poster_sha256_done")
    if MediaAssetSha256Hex(initSegmentBytes) != manifest.initSegmentCid:
        return Err[bool]("media runtime: pinned init segment cid mismatch")
    fountain.MoqFountainProfileMark("ingest:pin_initseg_sha256_done")
    return Ok[bool](true)

# Shared tail of PinAssetBytes: move the verified bytes into the asset record
# the pin step just created.
fn mediaLocalIndexFillAssetRecord(index: var MediaLocalIndex,
                                  assetCid: str,
                                  manifestCid: str,
                                  assetBytes: rawbytes.Bytes,
                                  posterBytes: rawbytes.Bytes,
                                  initSegmentBytes: rawbytes.Bytes): Result[str] =
    var i: int32
    for i in i..<index.assetRecords.len:
        if index.assetRecords[i].assetCid == assetCid:
            if index.assetRecords[i].manifestCid != manifestCid:
                return Err[str]("media runtime: pinned record manifest cid mismatch")
            index.assetRecords[i].assetBytes = assetBytes
            index.assetRecords[i].posterBytes = posterBytes
            index.assetRecords[i].initSegmentBytes = initSegmentBytes
            return Ok[str](manifestCid)
    return Err[str]("media runtime: pinned asset record missing")

fn MediaLocalIndexPinAssetBytes(index: var MediaLocalIndex,
                                manifest: var MediaAssetManifest,
                                assetBytes: rawbytes.Bytes,
                                posterBytes: rawbytes.Bytes,
                                initSegmentBytes: rawbytes.Bytes,
                                trustedInMemory: bool): Result[str] =
    let checkRes = mediaLocalIndexCheckPinnedBytes(manifest, assetBytes, posterBytes, initSegmentBytes, trustedInMemory)
    if IsErr(checkRes):
        return Err[str](Error(checkRes))
    let pinRes = MediaLocalIndexPinManifest(index, manifest)
    if IsErr(pinRes):
        return Err[str](Error(pinRes))
    fountain.MoqFountainProfileMark("ingest:pin_manifest_wire_cid_done")
    return mediaLocalIndexFillAssetRecord(index, manifest.assetCid, Value(pinRes), assetBytes, posterBytes, initSegmentBytes)

# Same as MediaLocalIndexPinAssetBytes but the caller already computed this
# exact unmutated manifest's cid moments earlier (ingest hot path): skips the
# redundant second wire-serialize+hash inside MediaLocalIndexPinManifest. The
# manifest validate that PinManifest would run still runs here, in the same
# position (after the pinned-bytes checks, before the pin).
fn mediaLocalIndexPinAssetBytesWithCid(index: var MediaLocalIndex,
                                       manifest: var MediaAssetManifest,
                                       manifestCid: str,
                                       assetBytes: rawbytes.Bytes,
                                       posterBytes: rawbytes.Bytes,
                                       initSegmentBytes: rawbytes.Bytes,
                                       trustedInMemory: bool): Result[str] =
    let checkRes = mediaLocalIndexCheckPinnedBytes(manifest, assetBytes, posterBytes, initSegmentBytes, trustedInMemory)
    if IsErr(checkRes):
        return Err[str](Error(checkRes))
    let validateRes = MediaAssetManifestValidate(manifest)
    if IsErr(validateRes):
        return Err[str](Error(validateRes))
    let pinRes = mediaLocalIndexPinManifestWithCid(index, manifest, manifestCid)
    if IsErr(pinRes):
        return Err[str](Error(pinRes))
    fountain.MoqFountainProfileMark("ingest:pin_manifest_wire_cid_done")
    return mediaLocalIndexFillAssetRecord(index, manifest.assetCid, Value(pinRes), assetBytes, posterBytes, initSegmentBytes)

fn MediaLocalIndexFindAssetRecord(index: var MediaLocalIndex,
                                  assetCid: str): Result[MediaLocalAssetRecord] =
    if len(assetCid) <= 0:
        return Err[MediaLocalAssetRecord]("media runtime: missing asset cid")
    var i: int32
    for i in i..<index.assetRecords.len:
        if index.assetRecords[i].assetCid == assetCid:
            if rawbytes.BytesLen(index.assetRecords[i].assetBytes) <= 0:
                return Err[MediaLocalAssetRecord]("media runtime: asset bytes not pinned")
            var ownedRecord: MediaLocalAssetRecord
            ownedRecord = index.assetRecords[i]
            return Ok[MediaLocalAssetRecord](ownedRecord)
    return Err[MediaLocalAssetRecord]("media runtime: asset bytes not pinned")

fn mediaPinBundleEnsureDir(path: str): Result[bool] =
    if len(path) <= 0:
        return Err[bool]("media pin bundle: empty directory")
    os.MkdirAll(path, 493)
    if !os.DirExists(path):
        return Err[bool]("media pin bundle: mkdir failed")
    return Ok[bool](true)

fn mediaPinBundleWriteBytes(path: str, data: rawbytes.Bytes, expectedCid: str): Result[int32] =
    if len(path) <= 0:
        return Err[int32]("media pin bundle: empty file path")
    if rawbytes.BytesLen(data) <= 0:
        return Err[int32]("media pin bundle: empty blob")
    if len(expectedCid) <= 0:
        return Err[int32]("media pin bundle: missing expected cid")
    let actualCid = MediaAssetSha256Hex(data)
    if actualCid != expectedCid:
        return Err[int32]("media pin bundle: source cid mismatch")
    var payload = data
    let writeRes = os.WriteFileBytesResult(path, payload)
    if IsErr(writeRes):
        return Err[int32](Error(writeRes))
    if !os.FileExists(path):
        return Err[int32]("media pin bundle: write missing file")
    var readRes: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if IsErr(readRes):
        return Err[int32](Error(readRes))
    let readBack = Value(readRes)
    if rawbytes.BytesLen(readBack) != rawbytes.BytesLen(data):
        return Err[int32]("media pin bundle: readback length mismatch")
    if MediaAssetSha256Hex(readBack) != expectedCid:
        return Err[int32]("media pin bundle: readback cid mismatch")
    return Ok[int32](rawbytes.BytesLen(data))

fn mediaPinBundleIndexText(receipt: MediaPinBundleReceipt): str =
    var lines: str[]
    lines = []
    MediaAssetAppendLine(lines, "schema", receipt.schema)
    MediaAssetAppendLine(lines, "asset_cid", receipt.assetCid)
    MediaAssetAppendLine(lines, "bundle_cid", receipt.bundleCid)
    MediaAssetAppendLine(lines, "manifest_cid", receipt.manifestCid)
    MediaAssetAppendLine(lines, "poster_cid", receipt.posterCid)
    MediaAssetAppendLine(lines, "init_segment_cid", receipt.initSegmentCid)
    MediaAssetAppendIntLine(lines, "init_segment_byte_length", receipt.initSegmentByteLength)
    MediaAssetAppendLine(lines, "manifest_path", receipt.manifestPath)
    MediaAssetAppendLine(lines, "asset_path", receipt.assetPath)
    MediaAssetAppendLine(lines, "poster_path", receipt.posterPath)
    MediaAssetAppendLine(lines, "init_segment_path", receipt.initSegmentPath)
    MediaAssetAppendLine(lines, "objects_dir", receipt.objectsDir)
    MediaAssetAppendLine(lines, "droplets_dir", receipt.dropletsDir)
    MediaAssetAppendIntLine(lines, "object_count", receipt.objectCount)
    MediaAssetAppendIntLine(lines, "droplet_count", receipt.dropletCount)
    MediaAssetAppendLine(lines, "trace", receipt.trace)
    return strutil.Join(lines, "\n")

fn MediaPinBundleWrite(rootPath: str,
                       manifest: var MediaAssetManifest,
                       assetBytes: rawbytes.Bytes,
                       posterBytes: rawbytes.Bytes,
                       initSegmentBytes: rawbytes.Bytes): Result[MediaPinBundleReceipt] =
    if len(rootPath) <= 0:
        return Err[MediaPinBundleReceipt]("media pin bundle: missing root path")
    let validateRes = MediaAssetManifestValidate(manifest)
    if IsErr(validateRes):
        return Err[MediaPinBundleReceipt](Error(validateRes))
    if MediaAssetSha256Hex(assetBytes) != manifest.assetCid:
        return Err[MediaPinBundleReceipt]("media pin bundle: asset cid mismatch")
    if MediaAssetSha256Hex(posterBytes) != manifest.posterCid:
        return Err[MediaPinBundleReceipt]("media pin bundle: poster cid mismatch")
    if MediaAssetSha256Hex(initSegmentBytes) != manifest.initSegmentCid:
        return Err[MediaPinBundleReceipt]("media pin bundle: init segment cid mismatch")
    if rawbytes.BytesLen(initSegmentBytes) != manifest.initSegmentByteLength:
        return Err[MediaPinBundleReceipt]("media pin bundle: init segment length mismatch")
    let manifestWireRes = MediaAssetManifestWire(manifest)
    if IsErr(manifestWireRes):
        return Err[MediaPinBundleReceipt](Error(manifestWireRes))
    let manifestWire = Value(manifestWireRes)
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[MediaPinBundleReceipt](Error(manifestCidRes))
    let manifestCid = Value(manifestCidRes)

    let bundlePath = os.JoinPath(rootPath, manifestCid)
    let objectsDir = os.JoinPath(bundlePath, "objects")
    let dropletsDir = os.JoinPath(bundlePath, "droplets")
    let mediaDir = os.JoinPath(bundlePath, "media")
    let ensureRoot = mediaPinBundleEnsureDir(rootPath)
    if IsErr(ensureRoot):
        return Err[MediaPinBundleReceipt](Error(ensureRoot))
    let ensureBundle = mediaPinBundleEnsureDir(bundlePath)
    if IsErr(ensureBundle):
        return Err[MediaPinBundleReceipt](Error(ensureBundle))
    let ensureObjects = mediaPinBundleEnsureDir(objectsDir)
    if IsErr(ensureObjects):
        return Err[MediaPinBundleReceipt](Error(ensureObjects))
    let ensureDroplets = mediaPinBundleEnsureDir(dropletsDir)
    if IsErr(ensureDroplets):
        return Err[MediaPinBundleReceipt](Error(ensureDroplets))
    let ensureMedia = mediaPinBundleEnsureDir(mediaDir)
    if IsErr(ensureMedia):
        return Err[MediaPinBundleReceipt](Error(ensureMedia))

    let manifestPath = os.JoinPath(bundlePath, "manifest.txt")
    let assetPath = os.JoinPath(mediaDir, strutil.Join([ share(manifest.assetCid), ".bin"], ""))
    let posterPath = os.JoinPath(mediaDir, strutil.Join([ share(manifest.posterCid), ".poster.bin"], ""))
    let initSegmentPath = os.JoinPath(mediaDir, strutil.Join([ share(manifest.initSegmentCid), ".init.bin"], ""))
    let indexPath = os.JoinPath(bundlePath, "bundle.index")

    var bytesWritten: int32
    let manifestWrite = mediaPinBundleWriteBytes(manifestPath,
                                                 rawbytes.BytesFromString(manifestWire),
                                                 manifestCid)
    if IsErr(manifestWrite):
        return Err[MediaPinBundleReceipt](Error(manifestWrite))
    bytesWritten = bytesWritten + Value(manifestWrite)

    let assetWrite = mediaPinBundleWriteBytes(assetPath, assetBytes, manifest.assetCid)
    if IsErr(assetWrite):
        return Err[MediaPinBundleReceipt](Error(assetWrite))
    bytesWritten = bytesWritten + Value(assetWrite)

    let posterWrite = mediaPinBundleWriteBytes(posterPath, posterBytes, manifest.posterCid)
    if IsErr(posterWrite):
        return Err[MediaPinBundleReceipt](Error(posterWrite))
    bytesWritten = bytesWritten + Value(posterWrite)

    let initWrite = mediaPinBundleWriteBytes(initSegmentPath, initSegmentBytes, manifest.initSegmentCid)
    if IsErr(initWrite):
        return Err[MediaPinBundleReceipt](Error(initWrite))
    bytesWritten = bytesWritten + Value(initWrite)

    var oi: int32
    for oi in oi..<manifest.objects.len:
        let item = manifest.objects[oi]
        let objectBytes = rawbytes.BytesSlice(assetBytes, item.byteOffset, item.byteLength)
        if rawbytes.BytesLen(objectBytes) != item.byteLength:
            return Err[MediaPinBundleReceipt]("media pin bundle: object slice length mismatch")
        let objectPath = os.JoinPath(objectsDir,
                                     strutil.Join([IntToStr(item.objectIndex), "-", share(item.objectCid), ".bin"], ""))
        let objectWrite = mediaPinBundleWriteBytes(objectPath, objectBytes, item.objectCid)
        if IsErr(objectWrite):
            return Err[MediaPinBundleReceipt](Error(objectWrite))
        bytesWritten = bytesWritten + Value(objectWrite)

    var di: int32
    for di in di..<manifest.droplets.len:
        let item = manifest.droplets[di]
        if rawbytes.BytesLen(item.payload) <= 0:
            return Err[MediaPinBundleReceipt]("media pin bundle: empty droplet payload")
        let dropletPath = os.JoinPath(dropletsDir,
                                      strutil.Join([IntToStr(item.dropletIndex), "-", share(item.cid), ".bin"], ""))
        let dropletWrite = mediaPinBundleWriteBytes(dropletPath, item.payload, item.cid)
        if IsErr(dropletWrite):
            return Err[MediaPinBundleReceipt](Error(dropletWrite))
        bytesWritten = bytesWritten + Value(dropletWrite)

    var receipt = MediaPinBundleReceipt(
        schema: MediaPinBundleSchema,
        rootPath: rootPath,
        bundlePath: bundlePath,
        manifestPath: manifestPath,
        assetPath: assetPath,
        posterPath: posterPath,
        initSegmentPath: initSegmentPath,
        objectsDir: objectsDir,
        dropletsDir: dropletsDir,
        indexPath: indexPath,
        assetCid: strings.CloneStr(manifest.assetCid),
        bundleCid: strings.CloneStr(manifest.bundleCid),
        manifestCid: manifestCid,
        posterCid: strings.CloneStr(manifest.posterCid),
        initSegmentCid: strings.CloneStr(manifest.initSegmentCid),
        initSegmentByteLength: manifest.initSegmentByteLength,
        objectCount: manifest.objects.len,
        dropletCount: manifest.droplets.len,
        bytesWritten: bytesWritten,
        trace: "pin-bundle->write->cid-verify"
    )
    let indexText = mediaPinBundleIndexText(receipt)
    let indexWrite = mediaPinBundleWriteBytes(indexPath,
                                              rawbytes.BytesFromString(indexText),
                                              MediaAssetSha256HexText(indexText))
    if IsErr(indexWrite):
        return Err[MediaPinBundleReceipt](Error(indexWrite))
    receipt.bytesWritten = receipt.bytesWritten + Value(indexWrite)
    return Ok[MediaPinBundleReceipt](receipt)

fn MediaPinBundleVerifyCore(receipt: MediaPinBundleReceipt): Result[bool] =
    if receipt.schema != MediaPinBundleSchema:
        return Err[bool]("media pin bundle: schema mismatch")
    let manifestRead = os.ReadFileBytesResult(receipt.manifestPath)
    if IsErr(manifestRead):
        return Err[bool](Error(manifestRead))
    if MediaAssetSha256Hex(Value(manifestRead)) != receipt.manifestCid:
        return Err[bool]("media pin bundle: manifest cid mismatch")
    let assetRead = os.ReadFileBytesResult(receipt.assetPath)
    if IsErr(assetRead):
        return Err[bool](Error(assetRead))
    if MediaAssetSha256Hex(Value(assetRead)) != receipt.assetCid:
        return Err[bool]("media pin bundle: asset cid mismatch")
    let posterRead = os.ReadFileBytesResult(receipt.posterPath)
    if IsErr(posterRead):
        return Err[bool](Error(posterRead))
    if MediaAssetSha256Hex(Value(posterRead)) != receipt.posterCid:
        return Err[bool]("media pin bundle: poster cid mismatch")
    let initRead = os.ReadFileBytesResult(receipt.initSegmentPath)
    if IsErr(initRead):
        return Err[bool](Error(initRead))
    if MediaAssetSha256Hex(Value(initRead)) != receipt.initSegmentCid:
        return Err[bool]("media pin bundle: init segment cid mismatch")
    if !os.FileExists(receipt.indexPath):
        return Err[bool]("media pin bundle: missing index")
    return Ok[bool](true)

fn mediaBuildManifestFromIngest(request: var MediaIngestRequest): Result[MediaAssetManifest] =
    if len(request.sourcePath) <= 0:
        return Err[MediaAssetManifest]("media runtime: missing source path")
    if rawbytes.BytesLen(request.posterBytes) <= 0:
        return Err[MediaAssetManifest]("media runtime: missing poster bytes")
    if rawbytes.BytesLen(request.initSegmentBytes) <= 0:
        return Err[MediaAssetManifest]("media runtime: missing init segment bytes")
    var buildRequest: MediaAssetBuildRequest
    buildRequest.blob = rawbytes.BytesSlice(request.blob, 0, rawbytes.BytesLen(request.blob))
    buildRequest.ownerPeerId = request.ownerPeerId
    buildRequest.remotePeersCsv = request.remotePeersCsv
    buildRequest.mime = request.mime
    buildRequest.kindCode = request.kindCode
    buildRequest.durationMs = request.durationMs
    buildRequest.codec = request.codec
    fountain.MoqFountainProfileMark("ingest:build_manifest_poster_sha256_begin")
    buildRequest.posterCid = MediaAssetSha256Hex(request.posterBytes)
    fountain.MoqFountainProfileMark("ingest:build_manifest_poster_sha256_done")
    buildRequest.initSegmentCid = MediaAssetSha256Hex(request.initSegmentBytes)
    fountain.MoqFountainProfileMark("ingest:build_manifest_initseg_sha256_done")
    buildRequest.initSegmentByteLength = rawbytes.BytesLen(request.initSegmentBytes)
    buildRequest.keyframeIndex = request.keyframeIndex
    buildRequest.contentSignature = request.contentSignature
    buildRequest.objectTargetBytes = request.objectTargetBytes
    buildRequest.sourceBlockBytes = request.sourceBlockBytes
    buildRequest.repairDropletCount = request.repairDropletCount
    return MediaAssetBuildManifest(buildRequest)

fn mediaAssetReadU32BE(data: rawbytes.Bytes, offset: int32): Result[int32] =
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return Err[int32]("media video file: u32 out of range")
    let b0 = rawbytes.BytesGet(data, offset) & 255
    let b1 = rawbytes.BytesGet(data, offset + 1) & 255
    let b2 = rawbytes.BytesGet(data, offset + 2) & 255
    let b3 = rawbytes.BytesGet(data, offset + 3) & 255
    return Ok[int32]((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)

fn mediaImageReadU32BE(data: rawbytes.Bytes, offset: int32): Result[int32] =
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return Err[int32]("media image file: u32 out of range")
    let b0 = rawbytes.BytesGet(data, offset) & 255
    let b1 = rawbytes.BytesGet(data, offset + 1) & 255
    let b2 = rawbytes.BytesGet(data, offset + 2) & 255
    let b3 = rawbytes.BytesGet(data, offset + 3) & 255
    return Ok[int32]((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)

fn mediaAudioReadU16LE(data: rawbytes.Bytes, offset: int32): Result[int32] =
    if offset < 0 || offset + 2 > rawbytes.BytesLen(data):
        return Err[int32]("media audio file: u16 out of range")
    let b0 = rawbytes.BytesGet(data, offset) & 255
    let b1 = rawbytes.BytesGet(data, offset + 1) & 255
    return Ok[int32](b0 | (b1 << 8))

fn mediaAudioReadU32LE(data: rawbytes.Bytes, offset: int32): Result[int32] =
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return Err[int32]("media audio file: u32 out of range")
    let b0 = rawbytes.BytesGet(data, offset) & 255
    let b1 = rawbytes.BytesGet(data, offset + 1) & 255
    let b2 = rawbytes.BytesGet(data, offset + 2) & 255
    let b3 = rawbytes.BytesGet(data, offset + 3) & 255
    return Ok[int32](b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

fn mediaAudioBytesMatch4(data: rawbytes.Bytes,
                         offset: int32,
                         b0: int32,
                         b1: int32,
                         b2: int32,
                         b3: int32): bool =
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return false
    if (rawbytes.BytesGet(data, offset) & 255) != b0:
        return false
    if (rawbytes.BytesGet(data, offset + 1) & 255) != b1:
        return false
    if (rawbytes.BytesGet(data, offset + 2) & 255) != b2:
        return false
    if (rawbytes.BytesGet(data, offset + 3) & 255) != b3:
        return false
    return true

fn MediaProbeWavAudioBytes(data: rawbytes.Bytes): Result[MediaAudioProbe] =
    let total = rawbytes.BytesLen(data)
    if total < 44:
        return Err[MediaAudioProbe]("media audio file: too small for wav")
    if !mediaAudioBytesMatch4(data, 0, 82, 73, 70, 70):
        return Err[MediaAudioProbe]("media audio file: invalid riff header")
    if !mediaAudioBytesMatch4(data, 8, 87, 65, 86, 69):
        return Err[MediaAudioProbe]("media audio file: invalid wave header")
    let riffSizeRes = mediaAudioReadU32LE(data, 4)
    if IsErr(riffSizeRes):
        return Err[MediaAudioProbe](Error(riffSizeRes))
    if Value(riffSizeRes) + 8 != total:
        return Err[MediaAudioProbe]("media audio file: riff size mismatch")
    var probe: MediaAudioProbe
    probe.byteLength = total
    var hasFmt: bool
    var hasData: bool
    var offset: int32
    offset = 12
    while offset < total:
        if offset + 8 > total:
            return Err[MediaAudioProbe]("media audio file: truncated wav chunk")
        let chunkSizeRes = mediaAudioReadU32LE(data, offset + 4)
        if IsErr(chunkSizeRes):
            return Err[MediaAudioProbe](Error(chunkSizeRes))
        let chunkSize = Value(chunkSizeRes)
        if chunkSize < 0:
            return Err[MediaAudioProbe]("media audio file: negative wav chunk size")
        let chunkDataStart = offset + 8
        let chunkEnd = chunkDataStart + chunkSize
        if chunkEnd < chunkDataStart || chunkEnd > total:
            return Err[MediaAudioProbe]("media audio file: wav chunk exceeds file")
        if mediaAudioBytesMatch4(data, offset, 102, 109, 116, 32):
            if hasFmt:
                return Err[MediaAudioProbe]("media audio file: duplicate fmt chunk")
            if chunkSize < 16:
                return Err[MediaAudioProbe]("media audio file: invalid fmt chunk size")
            let audioFormatRes = mediaAudioReadU16LE(data, chunkDataStart)
            let channelRes = mediaAudioReadU16LE(data, chunkDataStart + 2)
            let sampleRateRes = mediaAudioReadU32LE(data, chunkDataStart + 4)
            let blockAlignRes = mediaAudioReadU16LE(data, chunkDataStart + 12)
            let bitsRes = mediaAudioReadU16LE(data, chunkDataStart + 14)
            if IsErr(audioFormatRes):
                return Err[MediaAudioProbe](Error(audioFormatRes))
            if IsErr(channelRes):
                return Err[MediaAudioProbe](Error(channelRes))
            if IsErr(sampleRateRes):
                return Err[MediaAudioProbe](Error(sampleRateRes))
            if IsErr(blockAlignRes):
                return Err[MediaAudioProbe](Error(blockAlignRes))
            if IsErr(bitsRes):
                return Err[MediaAudioProbe](Error(bitsRes))
            if Value(audioFormatRes) != 1:
                return Err[MediaAudioProbe]("media audio file: only pcm wav is supported in v0.1")
            probe.channelCount = Value(channelRes)
            probe.sampleRateHz = Value(sampleRateRes)
            probe.blockAlign = Value(blockAlignRes)
            probe.bitsPerSample = Value(bitsRes)
            if probe.channelCount <= 0 || probe.channelCount > 8:
                return Err[MediaAudioProbe]("media audio file: invalid channel count")
            if probe.sampleRateHz <= 0 || probe.sampleRateHz > 384000:
                return Err[MediaAudioProbe]("media audio file: invalid sample rate")
            if probe.bitsPerSample != 16:
                return Err[MediaAudioProbe]("media audio file: only pcm_s16le wav is supported in v0.1")
            if probe.blockAlign != probe.channelCount * 2:
                return Err[MediaAudioProbe]("media audio file: invalid block align")
            hasFmt = true
        elif mediaAudioBytesMatch4(data, offset, 100, 97, 116, 97):
            if !hasFmt:
                return Err[MediaAudioProbe]("media audio file: data before fmt")
            if hasData:
                return Err[MediaAudioProbe]("media audio file: duplicate data chunk")
            if chunkSize <= 0:
                return Err[MediaAudioProbe]("media audio file: empty pcm data")
            if probe.blockAlign <= 0 || chunkSize < probe.blockAlign:
                return Err[MediaAudioProbe]("media audio file: pcm data shorter than one sample frame")
            if chunkSize % probe.blockAlign != 0:
                return Err[MediaAudioProbe]("media audio file: pcm data is not block aligned")
            probe.pcmDataOffset = chunkDataStart
            probe.pcmDataBytes = chunkSize
            probe.initSegmentBytes = chunkDataStart
            hasData = true
        var nextOffset = chunkEnd
        if chunkSize % 2 != 0:
            nextOffset = nextOffset + 1
        if nextOffset < offset || nextOffset > total:
            return Err[MediaAudioProbe]("media audio file: invalid wav chunk padding")
        offset = nextOffset
    if !hasFmt:
        return Err[MediaAudioProbe]("media audio file: missing fmt chunk")
    if !hasData:
        return Err[MediaAudioProbe]("media audio file: missing data chunk")
    if offset != total:
        return Err[MediaAudioProbe]("media audio file: trailing bytes outside wav chunks")
    return Ok[MediaAudioProbe](probe)

fn mediaImagePngHasSignature(data: rawbytes.Bytes): bool =
    if rawbytes.BytesLen(data) < 8:
        return false
    if (rawbytes.BytesGet(data, 0) & 255) != 137:
        return false
    if (rawbytes.BytesGet(data, 1) & 255) != 80:
        return false
    if (rawbytes.BytesGet(data, 2) & 255) != 78:
        return false
    if (rawbytes.BytesGet(data, 3) & 255) != 71:
        return false
    if (rawbytes.BytesGet(data, 4) & 255) != 13:
        return false
    if (rawbytes.BytesGet(data, 5) & 255) != 10:
        return false
    if (rawbytes.BytesGet(data, 6) & 255) != 26:
        return false
    if (rawbytes.BytesGet(data, 7) & 255) != 10:
        return false
    return true

fn mediaImagePngColorTypeValid(colorType: int32): bool =
    if colorType == 0:
        return true
    if colorType == 2:
        return true
    if colorType == 3:
        return true
    if colorType == 4:
        return true
    if colorType == 6:
        return true
    return false

fn MediaProbePngImageBytes(data: rawbytes.Bytes): Result[MediaImageProbe] =
    let total = rawbytes.BytesLen(data)
    if total < 45:
        return Err[MediaImageProbe]("media image file: too small for png")
    if !mediaImagePngHasSignature(data):
        return Err[MediaImageProbe]("media image file: invalid png signature")
    var probe: MediaImageProbe
    probe.byteLength = total
    var seenIhdr = false
    var seenIdat = false
    var seenIend = false
    var offset: int32 = 8
    while offset + 12 <= total:
        let chunkLenRes = mediaImageReadU32BE(data, offset)
        if IsErr(chunkLenRes):
            return Err[MediaImageProbe](Error(chunkLenRes))
        let chunkLen = Value(chunkLenRes)
        if chunkLen < 0:
            return Err[MediaImageProbe]("media image file: png chunk too large for v0.1")
        let chunkTypeRes = mediaImageReadU32BE(data, offset + 4)
        if IsErr(chunkTypeRes):
            return Err[MediaImageProbe](Error(chunkTypeRes))
        let chunkType = Value(chunkTypeRes)
        let chunkDataStart = offset + 8
        let chunkEnd = chunkDataStart + chunkLen
        let crcEnd = chunkEnd + 4
        if chunkEnd < chunkDataStart || crcEnd < chunkEnd || crcEnd > total:
            return Err[MediaImageProbe]("media image file: png chunk exceeds file")
        if chunkType == 1229472850:
            if seenIhdr:
                return Err[MediaImageProbe]("media image file: duplicate png ihdr")
            if offset != 8:
                return Err[MediaImageProbe]("media image file: png ihdr must be first chunk")
            if chunkLen != 13:
                return Err[MediaImageProbe]("media image file: invalid png ihdr length")
            let widthRes = mediaImageReadU32BE(data, chunkDataStart)
            if IsErr(widthRes):
                return Err[MediaImageProbe](Error(widthRes))
            let heightRes = mediaImageReadU32BE(data, chunkDataStart + 4)
            if IsErr(heightRes):
                return Err[MediaImageProbe](Error(heightRes))
            probe.decodedWidth = Value(widthRes)
            probe.decodedHeight = Value(heightRes)
            if probe.decodedWidth <= 0 || probe.decodedHeight <= 0:
                return Err[MediaImageProbe]("media image file: invalid png dimensions")
            probe.bitDepth = rawbytes.BytesGet(data, chunkDataStart + 8) & 255
            probe.colorType = rawbytes.BytesGet(data, chunkDataStart + 9) & 255
            let compressionMethod = rawbytes.BytesGet(data, chunkDataStart + 10) & 255
            let filterMethod = rawbytes.BytesGet(data, chunkDataStart + 11) & 255
            probe.interlaceMethod = rawbytes.BytesGet(data, chunkDataStart + 12) & 255
            if probe.bitDepth <= 0:
                return Err[MediaImageProbe]("media image file: invalid png bit depth")
            if !mediaImagePngColorTypeValid(probe.colorType):
                return Err[MediaImageProbe]("media image file: invalid png color type")
            if compressionMethod != 0:
                return Err[MediaImageProbe]("media image file: unsupported png compression method")
            if filterMethod != 0:
                return Err[MediaImageProbe]("media image file: unsupported png filter method")
            if probe.interlaceMethod != 0 && probe.interlaceMethod != 1:
                return Err[MediaImageProbe]("media image file: unsupported png interlace method")
            seenIhdr = true
        elif chunkType == 1229209940:
            if !seenIhdr:
                return Err[MediaImageProbe]("media image file: png idat before ihdr")
            if seenIend:
                return Err[MediaImageProbe]("media image file: png idat after iend")
            if chunkLen <= 0:
                return Err[MediaImageProbe]("media image file: empty png idat")
            seenIdat = true
        elif chunkType == 1229278788:
            if !seenIhdr:
                return Err[MediaImageProbe]("media image file: png iend before ihdr")
            if !seenIdat:
                return Err[MediaImageProbe]("media image file: png iend before idat")
            if chunkLen != 0:
                return Err[MediaImageProbe]("media image file: invalid png iend length")
            if crcEnd != total:
                return Err[MediaImageProbe]("media image file: trailing bytes after png iend")
            seenIend = true
            offset = crcEnd
            break
        offset = crcEnd
    if !seenIhdr:
        return Err[MediaImageProbe]("media image file: missing png ihdr")
    if !seenIdat:
        return Err[MediaImageProbe]("media image file: missing png idat")
    if !seenIend:
        return Err[MediaImageProbe]("media image file: missing png iend")
    if offset != total:
        return Err[MediaImageProbe]("media image file: trailing bytes outside png chunks")
    return Ok[MediaImageProbe](probe)

fn mediaAssetMp4ChildStart(boxType: int32, offset: int32, boxSize: int32): int32 =
    if boxType == 1836019574:
        return offset + 8
    if boxType == 1953653099:
        return offset + 8
    if boxType == 1835297121:
        return offset + 8
    if boxType == 1835626086:
        return offset + 8
    if boxType == 1937007212:
        return offset + 8
    if boxType == 1937011556:
        return offset + 16
    if boxType == 1635148593:
        return offset + 86
    return -1

fn mediaAssetMp4ScanAvcC(data: rawbytes.Bytes,
                         start: int32,
                         endOffset: int32,
                         depth: int32,
                         probe: var MediaVideoFileProbe): Result[bool] =
    if depth > 8:
        return Err[bool]("media video file: mp4 box nesting too deep")
    if start < 0 || endOffset < start || endOffset > rawbytes.BytesLen(data):
        return Err[bool]("media video file: invalid mp4 child range")
    var offset: int32 = start
    while offset + 8 <= endOffset:
        let sizeRes = mediaAssetReadU32BE(data, offset)
        if IsErr(sizeRes):
            return Err[bool](Error(sizeRes))
        let boxSize = Value(sizeRes)
        if boxSize == 1:
            return Err[bool]("media video file: large mp4 child boxes are not supported in v0.1")
        if boxSize < 8:
            return Err[bool]("media video file: invalid mp4 child box size")
        let boxEnd = offset + boxSize
        if boxEnd > endOffset:
            return Err[bool]("media video file: mp4 child box exceeds parent")
        let typeRes = mediaAssetReadU32BE(data, offset + 4)
        if IsErr(typeRes):
            return Err[bool](Error(typeRes))
        let boxType = Value(typeRes)
        if boxType == 1635148611:
            probe.hasAvcC = true
            probe.avcCOffset = offset
            probe.avcCSize = boxSize
        let childStart = mediaAssetMp4ChildStart(boxType, offset, boxSize)
        if childStart >= 0:
            if childStart > boxEnd:
                return Err[bool]("media video file: invalid mp4 child payload range")
            let scanRes = mediaAssetMp4ScanAvcC(data, childStart, boxEnd, depth + 1, probe)
            if IsErr(scanRes):
                return Err[bool](Error(scanRes))
        offset = boxEnd
    if offset != endOffset:
        return Err[bool]("media video file: trailing bytes inside mp4 container")
    return Ok[bool](probe.hasAvcC)

@borrows
fn mediaVideoCodecUsesAvcC(codec: str): bool =
    if strutil.Contains(codec, "h264"):
        return true
    if strutil.Contains(codec, "avc1"):
        return true
    return false

@borrows
fn MediaProbeMp4FileBytes(sourcePath: str, data: rawbytes.Bytes): Result[MediaVideoFileProbe] =
    if len(sourcePath) <= 0:
        return Err[MediaVideoFileProbe]("media video file: missing source path")
    let total = rawbytes.BytesLen(data)
    if total <= 0:
        return Err[MediaVideoFileProbe]("media video file: empty file")
    if total < 32:
        return Err[MediaVideoFileProbe]("media video file: too small for mp4")

    var probe: MediaVideoFileProbe
    probe.sourcePath = sourcePath
    probe.byteLength = total
    probe.ftypOffset = -1
    probe.moovOffset = -1
    probe.mdatOffset = -1
    probe.avcCOffset = -1

    var offset: int32
    while offset + 8 <= total:
        let sizeRes = mediaAssetReadU32BE(data, offset)
        if IsErr(sizeRes):
            return Err[MediaVideoFileProbe](Error(sizeRes))
        let boxSize = Value(sizeRes)
        if boxSize == 1:
            return Err[MediaVideoFileProbe]("media video file: large mp4 boxes are not supported in v0.1")
        if boxSize < 8:
            return Err[MediaVideoFileProbe]("media video file: invalid mp4 box size")
        if offset + boxSize > total:
            return Err[MediaVideoFileProbe]("media video file: mp4 box exceeds file")

        let typeRes = mediaAssetReadU32BE(data, offset + 4)
        if IsErr(typeRes):
            return Err[MediaVideoFileProbe](Error(typeRes))
        let boxType = Value(typeRes)
        if boxType == 1718909296:
            probe.hasFtyp = true
            probe.ftypOffset = offset
            probe.ftypSize = boxSize
        elif boxType == 1836019574:
            probe.hasMoov = true
            probe.moovOffset = offset
            probe.moovSize = boxSize
        elif boxType == 1835295092:
            probe.hasMdat = true
            probe.mdatOffset = offset
            probe.mdatSize = boxSize
        offset = offset + boxSize

    if offset != total:
        return Err[MediaVideoFileProbe]("media video file: trailing bytes outside mp4 boxes")
    if !probe.hasFtyp:
        return Err[MediaVideoFileProbe]("media video file: missing ftyp box")
    if probe.ftypOffset != 0:
        return Err[MediaVideoFileProbe]("media video file: ftyp must be the first box")
    if !probe.hasMoov:
        return Err[MediaVideoFileProbe]("media video file: missing moov box")
    if !probe.hasMdat:
        return Err[MediaVideoFileProbe]("media video file: missing mdat box")
    if probe.mdatSize <= 8:
        return Err[MediaVideoFileProbe]("media video file: empty mdat payload")
    if probe.moovOffset > probe.mdatOffset:
        return Err[MediaVideoFileProbe]("media video file: moov after mdat requires relocation before v0.1 ingest")
    let avcCScanRes = mediaAssetMp4ScanAvcC(data,
                                            probe.moovOffset + 8,
                                            probe.moovOffset + probe.moovSize,
                                            0,
                                            probe)
    if IsErr(avcCScanRes):
        return Err[MediaVideoFileProbe](Error(avcCScanRes))
    if !probe.hasAvcC:
        return Err[MediaVideoFileProbe]("media video file: missing h264 avcC codec config")
    if probe.avcCSize <= 8:
        return Err[MediaVideoFileProbe]("media video file: empty h264 avcC codec config")

    probe.initSegmentLength = probe.moovOffset + probe.moovSize
    if probe.initSegmentLength <= 8 || probe.initSegmentLength > probe.mdatOffset:
        return Err[MediaVideoFileProbe]("media video file: invalid init segment range")
    probe.keyframeIndex = strutil.Join(["mp4:mdat=", IntToStr(probe.mdatOffset),
                                        ":first=", IntToStr(probe.mdatOffset + 8)], "")
    return Ok[MediaVideoFileProbe](probe)

fn MediaIngestVideoFilePin(index: var MediaLocalIndex,
                           request: MediaVideoFileIngestRequest): Result[MediaIngestReceipt] =
    if len(request.sourcePath) <= 0:
        return Err[MediaIngestReceipt]("media video file: missing source path")
    if len(request.mime) > 0 && request.mime != "video/mp4":
        return Err[MediaIngestReceipt]("media video file: only video/mp4 is supported in v0.1")
    if request.durationMs <= int64(0):
        return Err[MediaIngestReceipt]("media video file: missing duration")
    if len(request.codec) <= 0:
        return Err[MediaIngestReceipt]("media video file: missing codec")
    if !mediaVideoCodecUsesAvcC(request.codec):
        return Err[MediaIngestReceipt]("media video file: only h264/avc1 mp4 is supported in v0.1")
    if rawbytes.BytesLen(request.posterBytes) <= 0:
        return Err[MediaIngestReceipt]("media video file: missing platform first-frame poster")
    if len(request.contentSignature) <= 0:
        return Err[MediaIngestReceipt]("media video file: missing content signature")

    fountain.MoqFountainProfileMark("ingest:file_read_begin")
    var fileRes: Result[rawbytes.Bytes] = os.ReadFileBytesResult(request.sourcePath)
    if IsErr(fileRes):
        return Err[MediaIngestReceipt](Error(fileRes))
    let fileBytes = Value(fileRes)
    fountain.MoqFountainProfileMark("ingest:file_read_done")
    let probeRes = MediaProbeMp4FileBytes(request.sourcePath, fileBytes)
    if IsErr(probeRes):
        return Err[MediaIngestReceipt](Error(probeRes))
    let probe = Value(probeRes)
    fountain.MoqFountainProfileMark("ingest:mp4_probe_done")
    let initSegmentBytes = rawbytes.BytesSlice(fileBytes, 0, probe.initSegmentLength)
    if rawbytes.BytesLen(initSegmentBytes) != probe.initSegmentLength:
        return Err[MediaIngestReceipt]("media video file: init segment slice failed")
    fountain.MoqFountainProfileMark("ingest:init_segment_slice_done")

    var mime = request.mime
    if len(mime) <= 0:
        mime = "video/mp4"

    var ingest: MediaIngestRequest
    ingest.sourcePath = request.sourcePath
    ingest.blob = fileBytes
    ingest.ownerPeerId = request.ownerPeerId
    ingest.remotePeersCsv = request.remotePeersCsv
    ingest.mime = mime
    ingest.kindCode = MediaAssetKindVideo
    ingest.durationMs = request.durationMs
    ingest.codec = request.codec
    ingest.posterBytes = request.posterBytes
    ingest.initSegmentBytes = initSegmentBytes
    ingest.keyframeIndex = probe.keyframeIndex
    ingest.contentSignature = request.contentSignature
    ingest.objectTargetBytes = request.objectTargetBytes
    ingest.sourceBlockBytes = request.sourceBlockBytes
    ingest.repairDropletCount = request.repairDropletCount

    fountain.MoqFountainProfileMark("ingest:pin_begin")
    let ingestRes = MediaIngestPin(index, ingest)
    if IsErr(ingestRes):
        return Err[MediaIngestReceipt](Error(ingestRes))
    var receipt = Value(ingestRes)
    fountain.MoqFountainProfileMark("ingest:pin_done")
    receipt.trace = "file-read->mp4-probe->manifest->pin"
    return Ok[MediaIngestReceipt](receipt)

fn mediaIngestReceiptFromManifest(request: MediaIngestRequest,
                                  manifest: var MediaAssetManifest): Result[MediaIngestReceipt] =
    # One wire serialization feeds both cid and manifestBytes (was: serialize
    # for the length, then serialize+hash again for the cid).
    let cidInfoRes = MediaAssetManifestCidWithWireLen(manifest)
    if IsErr(cidInfoRes):
        return Err[MediaIngestReceipt](Error(cidInfoRes))
    fountain.MoqFountainProfileMark("ingest:receipt_wire_2nd_done")
    let cidInfo = Value(cidInfoRes)
    fountain.MoqFountainProfileMark("ingest:receipt_cid_2nd_done")
    let manifestCid = cidInfo.cid
    return Ok[MediaIngestReceipt](MediaIngestReceipt(
        schema: MediaAssetLifecycleSchema,
        sourcePathHash: MediaAssetSha256HexText(request.sourcePath),
        assetCid: strings.CloneStr(manifest.assetCid),
        bundleCid: strings.CloneStr(manifest.bundleCid),
        manifestCid: strings.CloneStr(manifestCid),
        kindCode: manifest.kindCode,
        manifestBytes: cidInfo.wireBytes,
        objectCount: manifest.objects.len,
        dropletCount: manifest.droplets.len,
        posterCid: strings.CloneStr(manifest.posterCid),
        initSegmentCid: strings.CloneStr(manifest.initSegmentCid),
        initSegmentByteLength: manifest.initSegmentByteLength,
        immutableIdentity: MediaAssetIdentity(manifest.assetCid, manifest.bundleCid, manifestCid),
        trace: "ingest->manifest->cid"
    ))

# Same receipt shape as mediaIngestReceiptFromManifest, for the case where the
# caller (MediaIngestPin) already serialized this exact unmutated manifest a
# moment earlier and passes in both the cid and the wire byte length from that
# one serialization — nothing is re-serialized or re-hashed here at all
# (MediaIngestPin's total wire-serialize count is 1, its SHA256-over-wire
# count is 1).
fn mediaIngestReceiptFromManifestWithCid(request: MediaIngestRequest,
                                         manifest: var MediaAssetManifest,
                                         manifestCid: str,
                                         wireBytesLen: int32): Result[MediaIngestReceipt] =
    fountain.MoqFountainProfileMark("ingest:receipt_wire_2nd_done")
    return Ok[MediaIngestReceipt](MediaIngestReceipt(
        schema: MediaAssetLifecycleSchema,
        sourcePathHash: MediaAssetSha256HexText(request.sourcePath),
        assetCid: strings.CloneStr(manifest.assetCid),
        bundleCid: strings.CloneStr(manifest.bundleCid),
        manifestCid: strings.CloneStr(manifestCid),
        kindCode: manifest.kindCode,
        manifestBytes: wireBytesLen,
        objectCount: manifest.objects.len,
        dropletCount: manifest.droplets.len,
        posterCid: strings.CloneStr(manifest.posterCid),
        initSegmentCid: strings.CloneStr(manifest.initSegmentCid),
        initSegmentByteLength: manifest.initSegmentByteLength,
        immutableIdentity: MediaAssetIdentity(manifest.assetCid, manifest.bundleCid, manifestCid),
        trace: "ingest->manifest->cid"
    ))

fn MediaIngest(request: MediaIngestRequest): Result[MediaIngestReceipt] =
    let manifestRes = mediaBuildManifestFromIngest(request)
    if IsErr(manifestRes):
        return Err[MediaIngestReceipt](Error(manifestRes))
    var manifest = Value(manifestRes)
    let receiptRes = mediaIngestReceiptFromManifest(request, manifest)
    if IsErr(receiptRes):
        return Err[MediaIngestReceipt](Error(receiptRes))
    return receiptRes

fn MediaIngestPin(index: var MediaLocalIndex, request: MediaIngestRequest): Result[MediaIngestReceipt] =
    let manifestRes = mediaBuildManifestFromIngest(request)
    if IsErr(manifestRes):
        return Err[MediaIngestReceipt](Error(manifestRes))
    fountain.MoqFountainProfileMark("ingest:build_manifest_from_ingest_done")
    var manifest = Value(manifestRes)
    # Serialize the manifest wire exactly once: the same bytes give the pin cid
    # (sha256) and the receipt's manifestBytes length. The manifest is not
    # mutated between here and the receipt, so the length stays exact.
    fountain.MoqFountainProfileMark("ingest:manifest_wire_cid_begin")
    let cidInfoRes = MediaAssetManifestCidWithWireLen(manifest)
    if IsErr(cidInfoRes):
        return Err[MediaIngestReceipt](Error(cidInfoRes))
    let cidInfo = Value(cidInfoRes)
    fountain.MoqFountainProfileMark("ingest:manifest_wire_cid_done")
    let pinRes = mediaLocalIndexPinAssetBytesWithCid(index,
                                                     manifest,
                                                     cidInfo.cid,
                                                     request.blob,
                                                     request.posterBytes,
                                                     request.initSegmentBytes,
                                                     true)
    if IsErr(pinRes):
        return Err[MediaIngestReceipt](Error(pinRes))
    fountain.MoqFountainProfileMark("ingest:pin_asset_bytes_done")
    let receiptRes = mediaIngestReceiptFromManifestWithCid(request, manifest, Value(pinRes), cidInfo.wireBytes)
    if IsErr(receiptRes):
        return Err[MediaIngestReceipt](Error(receiptRes))
    fountain.MoqFountainProfileMark("ingest:receipt_from_manifest_done")
    return receiptRes

@borrows
fn MediaAssetOpenReceiptFromManifest(manifest: MediaAssetManifest): Result[MediaOpenReceipt] =
    let wireRes = MediaAssetManifestWire(manifest)
    if IsErr(wireRes):
        return Err[MediaOpenReceipt](Error(wireRes))
    let cidRes = MediaAssetManifestCid(manifest)
    if IsErr(cidRes):
        return Err[MediaOpenReceipt](Error(cidRes))
    return Ok[MediaOpenReceipt](MediaOpenReceipt(
        assetCid: strings.CloneStr(manifest.assetCid),
        bundleCid: strings.CloneStr(manifest.bundleCid),
        manifestCid: Value(cidRes),
        announcedBytes: len(Value(wireRes)),
        initSegmentByteLength: manifest.initSegmentByteLength,
        statusCode: MediaAssetOpenStatusManifestAnnounced,
        transport: manifest.transport
    ))

fn MediaPublish(index: var MediaLocalIndex, assetCid: str): Result[MediaOpenReceipt] =
    let manifestRes = MediaLocalIndexFind(index, assetCid)
    if IsErr(manifestRes):
        return Err[MediaOpenReceipt](Error(manifestRes))
    let openRes = MediaAssetOpenReceiptFromManifest(Value(manifestRes))
    if IsErr(openRes):
        return Err[MediaOpenReceipt](Error(openRes))
    return openRes

fn MediaAssetProviderNeedsDarwinProbe(decodeProvider: str, textureProvider: str): bool =
    if decodeProvider == media_platform.MediaPlatformDarwinVideoToolboxProvider:
        return true
    if textureProvider == media_platform.MediaPlatformDarwinMetalTextureProvider:
        return true
    return false

fn MediaAssetValidatePlatformProviders(decodeProvider: str,
                                       textureProvider: str): Result[bool] =
    if decodeProvider == media_platform.MediaPlatformDarwinVideoToolboxProvider:
        if textureProvider != media_platform.MediaPlatformDarwinMetalTextureProvider:
            return Err[bool]("media runtime: macos decode provider requires metal texture provider")
    if textureProvider == media_platform.MediaPlatformDarwinMetalTextureProvider:
        if decodeProvider != media_platform.MediaPlatformDarwinVideoToolboxProvider:
            return Err[bool]("media runtime: metal texture provider requires macos videotoolbox decode provider")
    if MediaAssetProviderNeedsDarwinProbe(decodeProvider, textureProvider):
        let probeRes = media_platform.MediaPlatformDarwinProbeStrict()
        if IsErr(probeRes):
            return Err[bool](Error(probeRes))
    return Ok[bool](true)

fn MediaOpen(manifest: var MediaAssetManifest,
             slotId: str,
             decodeProvider: str,
             textureProvider: str,
             audioProvider: str): Result[MediaPlaybackSession] =
    if len(slotId) <= 0:
        return Err[MediaPlaybackSession]("media runtime: missing playback slot")
    if len(decodeProvider) <= 0:
        return Err[MediaPlaybackSession]("media runtime: missing decode provider")
    if len(textureProvider) <= 0:
        return Err[MediaPlaybackSession]("media runtime: missing texture provider")
    if len(audioProvider) <= 0:
        return Err[MediaPlaybackSession]("media runtime: missing audio provider")
    let providerRes = MediaAssetValidatePlatformProviders(decodeProvider, textureProvider)
    if IsErr(providerRes):
        return Err[MediaPlaybackSession](Error(providerRes))
    let openRes = MediaAssetOpenReceiptFromManifest(manifest)
    if IsErr(openRes):
        return Err[MediaPlaybackSession](Error(openRes))
    let openReceipt = Value(openRes)
    return Ok[MediaPlaybackSession](MediaPlaybackSession(
        schema: MediaAssetLifecycleSchema,
        slotId: slotId,
        assetCid: openReceipt.assetCid,
        bundleCid: openReceipt.bundleCid,
        manifestCid: openReceipt.manifestCid,
        kindCode: manifest.kindCode,
        stateCode: MediaPlaybackStateOpened,
        providerKind: "media-decode-provider",
        decodeProvider: decodeProvider,
        textureProvider: textureProvider,
        audioProvider: audioProvider,
        eventQueue: "cheng-media-event-queue",
        trace: "open->playback-slot"
    ))

fn MediaOpenPinned(index: var MediaLocalIndex,
                   assetCid: str,
                   slotId: str,
                   decodeProvider: str,
                   textureProvider: str,
                   audioProvider: str): Result[MediaPlaybackSession] =
    let manifestRes = MediaLocalIndexFind(index, assetCid)
    if IsErr(manifestRes):
        return Err[MediaPlaybackSession](Error(manifestRes))
    var manifest = Value(manifestRes)
    return MediaOpen(manifest, slotId, decodeProvider, textureProvider, audioProvider)

fn MediaOpenAnnouncedManifest(index: var MediaLocalIndex,
                              manifest: var MediaAssetManifest,
                              slotId: str,
                              decodeProvider: str,
                              textureProvider: str,
                              audioProvider: str): Result[MediaPlaybackSession] =
    let manifestCidRes = MediaLocalIndexPinManifest(index, manifest)
    if IsErr(manifestCidRes):
        return Err[MediaPlaybackSession](Error(manifestCidRes))
    return MediaOpenPinned(index,
                           manifest.assetCid,
                           slotId,
                           decodeProvider,
                           textureProvider,
                           audioProvider)

fn MediaAssetFirstFrameReceipt(manifest: MediaAssetManifest,
                               firstFrameBytes: rawbytes.Bytes,
                               sourceCode: int32): Result[MediaFirstFrameReceipt] =
    let validateRes = MediaAssetManifestValidate(manifest)
    if IsErr(validateRes):
        return Err[MediaFirstFrameReceipt](Error(validateRes))
    if rawbytes.BytesLen(firstFrameBytes) <= 0:
        return Err[MediaFirstFrameReceipt]("media asset: empty first frame bytes")
    let frameCid = MediaAssetSha256Hex(firstFrameBytes)
    var expectedCid = ""
    if sourceCode == MediaAssetFirstFrameSourcePoster:
        expectedCid = manifest.posterCid
    elif sourceCode == MediaAssetFirstFrameSourceInitSegment:
        expectedCid = manifest.initSegmentCid
        if rawbytes.BytesLen(firstFrameBytes) != manifest.initSegmentByteLength:
            return Err[MediaFirstFrameReceipt]("media asset: init segment length mismatch")
    elif sourceCode == MediaAssetFirstFrameSourceAsset:
        if manifest.kindCode != MediaAssetKindImage:
            return Err[MediaFirstFrameReceipt]("media asset: asset frame source is image-only")
        expectedCid = manifest.assetCid
    else:
        return Err[MediaFirstFrameReceipt]("media asset: invalid first frame source")
    if len(expectedCid) <= 0:
        return Err[MediaFirstFrameReceipt]("media asset: missing first frame cid")
    if frameCid != expectedCid:
        return Err[MediaFirstFrameReceipt]("media asset: first frame cid mismatch")
    return Ok[MediaFirstFrameReceipt](MediaFirstFrameReceipt(
        assetCid: strings.CloneStr(manifest.assetCid),
        bundleCid: strings.CloneStr(manifest.bundleCid),
        firstFrameCid: frameCid,
        bytesReady: rawbytes.BytesLen(firstFrameBytes),
        sourceCode: sourceCode,
        verified: true
    ))

fn MediaFirstFrame(session: var MediaPlaybackSession,
                   manifest: var MediaAssetManifest,
                   firstFrameBytes: rawbytes.Bytes,
                   sourceCode: int32): Result[MediaFrameReceipt] =
    if session.assetCid != manifest.assetCid:
        return Err[MediaFrameReceipt]("media runtime: session asset mismatch")
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[MediaFrameReceipt](Error(manifestCidRes))
    if session.manifestCid != Value(manifestCidRes):
        return Err[MediaFrameReceipt]("media runtime: session manifest mismatch")
    let firstRes = MediaAssetFirstFrameReceipt(manifest, firstFrameBytes, sourceCode)
    if IsErr(firstRes):
        return Err[MediaFrameReceipt](Error(firstRes))
    let first = Value(firstRes)
    var receipt = MediaFrameReceipt(
        slotId: session.slotId,
        assetCid: session.assetCid,
        manifestCid: session.manifestCid,
        firstFrameCid: first.firstFrameCid,
        bytesReady: first.bytesReady,
        sourceCode: first.sourceCode,
        verified: first.verified,
        textureProvider: session.textureProvider,
        decodedWidth: 0,
        decodedHeight: 0,
        pixelFormat: 0,
        pixelBufferHandle: uint64(0),
        textureHandle: uint64(0),
        textureReady: false,
        platformStatusCode: 0,
        platformInfoFlags: 0,
        trace: "first-frame->surface-frame-receipt"
    )
    receipt.receiptCid = MediaFrameReceiptCid(receipt)
    return Ok[MediaFrameReceipt](receipt)

fn MediaFirstFramePlatformDecode(session: var MediaPlaybackSession,
                                 manifest: var MediaAssetManifest,
                                 assetBytes: rawbytes.Bytes): Result[MediaFrameReceipt] =
    if session.assetCid != manifest.assetCid:
        return Err[MediaFrameReceipt]("media runtime: session asset mismatch")
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[MediaFrameReceipt](Error(manifestCidRes))
    if session.manifestCid != Value(manifestCidRes):
        return Err[MediaFrameReceipt]("media runtime: session manifest mismatch")
    if MediaAssetSha256Hex(assetBytes) != manifest.assetCid:
        return Err[MediaFrameReceipt]("media runtime: platform decode asset cid mismatch")
    if session.decodeProvider != media_platform.MediaPlatformDarwinVideoToolboxProvider:
        return Err[MediaFrameReceipt]("media runtime: platform first frame requires videotoolbox decode provider")
    if session.textureProvider != media_platform.MediaPlatformDarwinMetalTextureProvider:
        return Err[MediaFrameReceipt]("media runtime: platform first frame requires metal texture provider")
    let decodeRes = media_platform.MediaPlatformDarwinDecodeFirstFrame(assetBytes)
    if IsErr(decodeRes):
        return Err[MediaFrameReceipt](Error(decodeRes))
    let decoded = Value(decodeRes)
    let frameCid = MediaAssetSha256HexText(strutil.Join([
        "platform:first-frame|",
        manifest.assetCid,
        "|",
        IntToStr(decoded.decodedWidth),
        "x",
        IntToStr(decoded.decodedHeight),
        "|",
        IntToStr(decoded.pixelFormat),
        "|",
        IntToStr(decoded.bytesReady)
    ], ""))
    var receipt = MediaFrameReceipt(
        slotId: session.slotId,
        assetCid: session.assetCid,
        manifestCid: session.manifestCid,
        firstFrameCid: frameCid,
        bytesReady: decoded.bytesReady,
        sourceCode: MediaAssetFirstFrameSourcePlatformDecode,
        verified: true,
        textureProvider: session.textureProvider,
        decodedWidth: decoded.decodedWidth,
        decodedHeight: decoded.decodedHeight,
        pixelFormat: decoded.pixelFormat,
        pixelBufferHandle: decoded.pixelBufferHandle,
        textureHandle: decoded.textureHandle,
        textureReady: decoded.textureReady,
        platformStatusCode: decoded.statusCode,
        platformInfoFlags: decoded.infoFlags,
        trace: "platform-decode->cvpixelbuffer->surface-frame-receipt"
    )
    receipt.receiptCid = MediaFrameReceiptCid(receipt)
    return Ok[MediaFrameReceipt](receipt)

fn MediaFirstImage(session: var MediaPlaybackSession,
                   manifest: var MediaAssetManifest,
                   assetBytes: rawbytes.Bytes): Result[MediaImageReceipt] =
    if session.assetCid != manifest.assetCid:
        return Err[MediaImageReceipt]("media runtime: image session asset mismatch")
    if session.kindCode != MediaAssetKindImage || manifest.kindCode != MediaAssetKindImage:
        return Err[MediaImageReceipt]("media runtime: first image requires image asset")
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[MediaImageReceipt](Error(manifestCidRes))
    if session.manifestCid != Value(manifestCidRes):
        return Err[MediaImageReceipt]("media runtime: image session manifest mismatch")
    if len(session.textureProvider) <= 0 || session.textureProvider == "none":
        return Err[MediaImageReceipt]("media runtime: missing image texture provider")
    if rawbytes.BytesLen(assetBytes) <= 0:
        return Err[MediaImageReceipt]("media runtime: empty image asset bytes")
    if MediaAssetSha256Hex(assetBytes) != manifest.assetCid:
        return Err[MediaImageReceipt]("media runtime: image asset cid mismatch")
    if manifest.mime != "image/png":
        return Err[MediaImageReceipt]("media runtime: first image only supports image/png in v0.1")
    if manifest.codec != "png":
        return Err[MediaImageReceipt]("media runtime: first image only supports png codec in v0.1")
    if !strutil.StartsWith(manifest.keyframeIndex, "image:"):
        return Err[MediaImageReceipt]("media runtime: image frame index missing")
    let probeRes = MediaProbePngImageBytes(assetBytes)
    if IsErr(probeRes):
        return Err[MediaImageReceipt](Error(probeRes))
    let probe = Value(probeRes)
    var receipt = MediaImageReceipt(
        slotId: session.slotId,
        assetCid: session.assetCid,
        manifestCid: session.manifestCid,
        firstImageCid: manifest.assetCid,
        bytesReady: rawbytes.BytesLen(assetBytes),
        codec: manifest.codec,
        keyframeIndex: manifest.keyframeIndex,
        mime: manifest.mime,
        textureProvider: session.textureProvider,
        decodedWidth: probe.decodedWidth,
        decodedHeight: probe.decodedHeight,
        bitDepth: probe.bitDepth,
        colorType: probe.colorType,
        interlaceMethod: probe.interlaceMethod,
        textureHandle: uint64(0),
        textureReady: false,
        verified: true,
        sessionOpenedAtMs: session.openedAtMs,
        trace: strutil.Join(["first-image->", share(session.textureProvider), "->image-receipt"], "")
    )
    receipt.receiptCid = MediaImageReceiptCid(receipt)
    return Ok[MediaImageReceipt](receipt)

fn MediaSurfaceTextureReceiptFromHost(session: var MediaPlaybackSession,
                                      manifest: var MediaAssetManifest,
                                      kindCode: int32,
                                      textureProvider: str,
                                      posterCid: str,
                                      textureHandle: uint64,
                                      decodedWidth: int32,
                                      decodedHeight: int32,
                                      pixelFormat: int32,
                                      textureTargetCode: int32,
                                      textureStatusCode: int32,
                                      trace: str): Result[MediaSurfaceTextureReceipt] =
    if session.assetCid != manifest.assetCid:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt asset mismatch")
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[MediaSurfaceTextureReceipt](Error(manifestCidRes))
    if session.manifestCid != Value(manifestCidRes):
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt manifest mismatch")
    if session.kindCode != manifest.kindCode:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt kind mismatch")
    if kindCode != manifest.kindCode:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt kind mismatch")
    if len(textureProvider) <= 0:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt missing provider")
    if textureProvider == "none":
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt missing provider")
    if textureProvider != session.textureProvider:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt provider mismatch")
    if len(posterCid) <= 0:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt missing poster cid")
    if posterCid != manifest.posterCid:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt poster cid mismatch")
    if textureStatusCode != MediaSurfaceTextureStatusReady:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt status not ready")
    if textureHandle == uint64(0):
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt missing texture handle")
    if decodedWidth <= 0:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt invalid size")
    if decodedHeight <= 0:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt invalid size")
    if pixelFormat <= 0:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt missing pixel format")
    if textureTargetCode <= 0:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt missing texture target")
    if len(trace) <= 0:
        return Err[MediaSurfaceTextureReceipt]("media runtime: surface texture receipt missing trace")
    var receipt = MediaSurfaceTextureReceipt(
        slotId: session.slotId,
        assetCid: session.assetCid,
        manifestCid: session.manifestCid,
        posterCid: posterCid,
        kindCode: kindCode,
        textureProvider: textureProvider,
        textureHandle: textureHandle,
        decodedWidth: decodedWidth,
        decodedHeight: decodedHeight,
        pixelFormat: pixelFormat,
        textureTargetCode: textureTargetCode,
        statusCode: textureStatusCode,
        ready: true,
        trace: trace
    )
    receipt.receiptCid = MediaSurfaceTextureReceiptCid(receipt)
    return Ok[MediaSurfaceTextureReceipt](receipt)

fn MediaImageReceiptAttachTexture(receipt: var MediaImageReceipt,
                                  session: var MediaPlaybackSession,
                                  textureProvider: str,
                                  textureHandle: uint64,
                                  decodedWidth: int32,
                                  decodedHeight: int32,
                                  textureStatusCode: int32,
                                  trace: str): Result[MediaImageReceipt] =
    if !receipt.verified:
        return Err[MediaImageReceipt]("media runtime: image texture attach requires verified image receipt")
    if session.kindCode != MediaAssetKindImage:
        return Err[MediaImageReceipt]("media runtime: image texture attach requires image session")
    if receipt.slotId != session.slotId:
        return Err[MediaImageReceipt]("media runtime: image texture attach session mismatch")
    if receipt.assetCid != session.assetCid:
        return Err[MediaImageReceipt]("media runtime: image texture attach session mismatch")
    if receipt.manifestCid != session.manifestCid:
        return Err[MediaImageReceipt]("media runtime: image texture attach session mismatch")
    if len(textureProvider) <= 0:
        return Err[MediaImageReceipt]("media runtime: image texture attach missing provider")
    if textureProvider == "none":
        return Err[MediaImageReceipt]("media runtime: image texture attach missing provider")
    if textureProvider != session.textureProvider:
        return Err[MediaImageReceipt]("media runtime: image texture attach provider mismatch")
    if textureProvider != receipt.textureProvider:
        return Err[MediaImageReceipt]("media runtime: image texture attach provider mismatch")
    if textureStatusCode != MediaSurfaceTextureStatusReady:
        return Err[MediaImageReceipt]("media runtime: image texture attach status not ready")
    if textureHandle == uint64(0):
        return Err[MediaImageReceipt]("media runtime: image texture attach missing texture handle")
    if decodedWidth <= 0:
        return Err[MediaImageReceipt]("media runtime: image texture attach invalid size")
    if decodedHeight <= 0:
        return Err[MediaImageReceipt]("media runtime: image texture attach invalid size")
    if decodedWidth != receipt.decodedWidth:
        return Err[MediaImageReceipt]("media runtime: image texture attach size mismatch")
    if decodedHeight != receipt.decodedHeight:
        return Err[MediaImageReceipt]("media runtime: image texture attach size mismatch")
    if len(trace) <= 0:
        return Err[MediaImageReceipt]("media runtime: image texture attach missing trace")
    var ready = MediaImageReceipt(
        slotId: receipt.slotId,
        assetCid: receipt.assetCid,
        manifestCid: receipt.manifestCid,
        firstImageCid: receipt.firstImageCid,
        bytesReady: receipt.bytesReady,
        codec: receipt.codec,
        keyframeIndex: receipt.keyframeIndex,
        mime: receipt.mime,
        textureProvider: receipt.textureProvider,
        decodedWidth: receipt.decodedWidth,
        decodedHeight: receipt.decodedHeight,
        bitDepth: receipt.bitDepth,
        colorType: receipt.colorType,
        interlaceMethod: receipt.interlaceMethod,
        textureHandle: textureHandle,
        textureReady: true,
        verified: receipt.verified,
        startedAtMs: receipt.startedAtMs,
        completedAtMs: receipt.completedAtMs,
        elapsedMs: receipt.elapsedMs,
        sessionOpenedAtMs: receipt.sessionOpenedAtMs,
        openToImageMs: receipt.openToImageMs,
        trace: strutil.Join([ share(receipt.trace), "->texture-ready:", trace], "")
    )
    ready.receiptCid = MediaImageReceiptCid(ready)
    return Ok[MediaImageReceipt](ready)

fn MediaImageReceiptAttachTextureReceipt(receipt: var MediaImageReceipt,
                                         session: var MediaPlaybackSession,
                                         manifest: var MediaAssetManifest,
                                         texture: var MediaSurfaceTextureReceipt): Result[MediaImageReceipt] =
    if texture.kindCode != MediaAssetKindImage:
        return Err[MediaImageReceipt]("media runtime: image texture receipt kind mismatch")
    if texture.slotId != receipt.slotId:
        return Err[MediaImageReceipt]("media runtime: image texture receipt identity mismatch")
    if texture.assetCid != receipt.assetCid:
        return Err[MediaImageReceipt]("media runtime: image texture receipt identity mismatch")
    if texture.manifestCid != receipt.manifestCid:
        return Err[MediaImageReceipt]("media runtime: image texture receipt identity mismatch")
    if texture.posterCid != manifest.posterCid:
        return Err[MediaImageReceipt]("media runtime: image texture receipt poster cid mismatch")
    if !texture.ready:
        return Err[MediaImageReceipt]("media runtime: image texture receipt not ready")
    return MediaImageReceiptAttachTexture(receipt,
                                          session,
                                          texture.textureProvider,
                                          texture.textureHandle,
                                          texture.decodedWidth,
                                          texture.decodedHeight,
                                          texture.statusCode,
                                          texture.trace)

fn MediaFrameReceiptAttachTexture(receipt: var MediaFrameReceipt,
                                  session: var MediaPlaybackSession,
                                  textureProvider: str,
                                  textureHandle: uint64,
                                  decodedWidth: int32,
                                  decodedHeight: int32,
                                  textureStatusCode: int32,
                                  trace: str): Result[MediaFrameReceipt] =
    if !receipt.verified:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach requires verified frame receipt")
    if receipt.slotId != session.slotId:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach session mismatch")
    if receipt.assetCid != session.assetCid:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach session mismatch")
    if receipt.manifestCid != session.manifestCid:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach session mismatch")
    if len(textureProvider) <= 0:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach missing provider")
    if textureProvider == "none":
        return Err[MediaFrameReceipt]("media runtime: frame texture attach missing provider")
    if textureProvider != session.textureProvider:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach provider mismatch")
    if textureProvider != receipt.textureProvider:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach provider mismatch")
    if textureStatusCode != MediaSurfaceTextureStatusReady:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach status not ready")
    if textureHandle == uint64(0):
        return Err[MediaFrameReceipt]("media runtime: frame texture attach missing texture handle")
    if decodedWidth <= 0:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach invalid size")
    if decodedHeight <= 0:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach invalid size")
    if decodedWidth != receipt.decodedWidth:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach size mismatch")
    if decodedHeight != receipt.decodedHeight:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach size mismatch")
    if len(trace) <= 0:
        return Err[MediaFrameReceipt]("media runtime: frame texture attach missing trace")
    var ready = MediaFrameReceipt(
        slotId: receipt.slotId,
        assetCid: receipt.assetCid,
        manifestCid: receipt.manifestCid,
        firstFrameCid: receipt.firstFrameCid,
        bytesReady: receipt.bytesReady,
        sourceCode: receipt.sourceCode,
        verified: receipt.verified,
        textureProvider: receipt.textureProvider,
        decodedWidth: receipt.decodedWidth,
        decodedHeight: receipt.decodedHeight,
        pixelFormat: receipt.pixelFormat,
        pixelBufferHandle: receipt.pixelBufferHandle,
        textureHandle: textureHandle,
        textureReady: true,
        platformStatusCode: textureStatusCode,
        platformInfoFlags: receipt.platformInfoFlags,
        startedAtMs: receipt.startedAtMs,
        completedAtMs: receipt.completedAtMs,
        elapsedMs: receipt.elapsedMs,
        sessionOpenedAtMs: receipt.sessionOpenedAtMs,
        openToFrameMs: receipt.openToFrameMs,
        trace: strutil.Join([ share(receipt.trace), "->texture-ready:", trace], "")
    )
    ready.receiptCid = MediaFrameReceiptCid(ready)
    return Ok[MediaFrameReceipt](ready)

fn MediaFrameReceiptAttachTextureReceipt(receipt: var MediaFrameReceipt,
                                         session: var MediaPlaybackSession,
                                         manifest: var MediaAssetManifest,
                                         texture: var MediaSurfaceTextureReceipt): Result[MediaFrameReceipt] =
    if texture.kindCode != manifest.kindCode:
        return Err[MediaFrameReceipt]("media runtime: frame texture receipt kind mismatch")
    if texture.slotId != receipt.slotId:
        return Err[MediaFrameReceipt]("media runtime: frame texture receipt identity mismatch")
    if texture.assetCid != receipt.assetCid:
        return Err[MediaFrameReceipt]("media runtime: frame texture receipt identity mismatch")
    if texture.manifestCid != receipt.manifestCid:
        return Err[MediaFrameReceipt]("media runtime: frame texture receipt identity mismatch")
    if texture.posterCid != manifest.posterCid:
        return Err[MediaFrameReceipt]("media runtime: frame texture receipt poster cid mismatch")
    if !texture.ready:
        return Err[MediaFrameReceipt]("media runtime: frame texture receipt not ready")
    return MediaFrameReceiptAttachTexture(receipt,
                                          session,
                                          texture.textureProvider,
                                          texture.textureHandle,
                                          texture.decodedWidth,
                                          texture.decodedHeight,
                                          texture.statusCode,
                                          texture.trace)

fn MediaFirstFrameFromPinnedSession(index: var MediaLocalIndex,
                                    session: var MediaPlaybackSession): Result[MediaFrameReceipt] =
    let manifestRes = MediaLocalIndexFind(index, session.assetCid)
    if IsErr(manifestRes):
        return Err[MediaFrameReceipt](Error(manifestRes))
    var manifest = Value(manifestRes)
    if manifest.kindCode != session.kindCode:
        return Err[MediaFrameReceipt]("media runtime: session kind mismatch")
    let recordRes = MediaLocalIndexFindAssetRecord(index, session.assetCid)
    if IsErr(recordRes):
        return Err[MediaFrameReceipt](Error(recordRes))
    let record = Value(recordRes)
    if record.manifestCid != session.manifestCid:
        return Err[MediaFrameReceipt]("media runtime: session pinned record mismatch")
    if manifest.kindCode == MediaAssetKindVideo:
        if session.decodeProvider != media_platform.MediaPlatformDarwinVideoToolboxProvider ||
           session.textureProvider != media_platform.MediaPlatformDarwinMetalTextureProvider:
            return Err[MediaFrameReceipt]("media runtime: video first frame requires platform texture provider")
        return MediaFirstFramePlatformDecode(session, manifest, record.assetBytes)
    if manifest.kindCode == MediaAssetKindImage:
        let imageRes = MediaFirstImage(session, manifest, record.assetBytes)
        if IsErr(imageRes):
            return Err[MediaFrameReceipt](Error(imageRes))
        let image = Value(imageRes)
        var receipt = MediaFrameReceipt(
            slotId: session.slotId,
            assetCid: session.assetCid,
            manifestCid: session.manifestCid,
            firstFrameCid: image.firstImageCid,
            bytesReady: image.bytesReady,
            sourceCode: MediaAssetFirstFrameSourceAsset,
            verified: image.verified,
            textureProvider: session.textureProvider,
            decodedWidth: image.decodedWidth,
            decodedHeight: image.decodedHeight,
            pixelFormat: image.colorType,
            pixelBufferHandle: uint64(0),
            textureHandle: image.textureHandle,
            textureReady: image.textureReady,
            platformStatusCode: 0,
            platformInfoFlags: 0,
            sessionOpenedAtMs: session.openedAtMs,
            trace: "first-image->surface-frame-receipt"
        )
        receipt.receiptCid = MediaFrameReceiptCid(receipt)
        return Ok[MediaFrameReceipt](receipt)
    if manifest.kindCode == MediaAssetKindAudio:
        return MediaFirstFrame(session,
                               manifest,
                               record.posterBytes,
                               MediaAssetFirstFrameSourcePoster)
    return Err[MediaFrameReceipt]("media runtime: unsupported first frame kind")

fn MediaFirstImageFromPinnedSession(index: var MediaLocalIndex,
                                    session: var MediaPlaybackSession): Result[MediaImageReceipt] =
    let manifestRes = MediaLocalIndexFind(index, session.assetCid)
    if IsErr(manifestRes):
        return Err[MediaImageReceipt](Error(manifestRes))
    var manifest = Value(manifestRes)
    if manifest.kindCode != session.kindCode:
        return Err[MediaImageReceipt]("media runtime: image session kind mismatch")
    let recordRes = MediaLocalIndexFindAssetRecord(index, session.assetCid)
    if IsErr(recordRes):
        return Err[MediaImageReceipt](Error(recordRes))
    let record = Value(recordRes)
    if record.manifestCid != session.manifestCid:
        return Err[MediaImageReceipt]("media runtime: image pinned record mismatch")
    return MediaFirstImage(session, manifest, record.assetBytes)

fn MediaFirstAudio(session: var MediaPlaybackSession,
                   manifest: var MediaAssetManifest,
                   assetBytes: rawbytes.Bytes,
                   initSegmentBytes: rawbytes.Bytes): Result[MediaAudioReceipt] =
    if session.assetCid != manifest.assetCid:
        return Err[MediaAudioReceipt]("media runtime: audio session asset mismatch")
    if session.kindCode != MediaAssetKindAudio || manifest.kindCode != MediaAssetKindAudio:
        return Err[MediaAudioReceipt]("media runtime: first audio requires audio asset")
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[MediaAudioReceipt](Error(manifestCidRes))
    if session.manifestCid != Value(manifestCidRes):
        return Err[MediaAudioReceipt]("media runtime: audio session manifest mismatch")
    if len(session.audioProvider) <= 0 || session.audioProvider == "none":
        return Err[MediaAudioReceipt]("media runtime: missing audio output provider")
    if rawbytes.BytesLen(assetBytes) <= 0:
        return Err[MediaAudioReceipt]("media runtime: empty audio asset bytes")
    if rawbytes.BytesLen(initSegmentBytes) <= 0:
        return Err[MediaAudioReceipt]("media runtime: empty audio init segment bytes")
    if MediaAssetSha256Hex(assetBytes) != manifest.assetCid:
        return Err[MediaAudioReceipt]("media runtime: audio asset cid mismatch")
    if MediaAssetSha256Hex(initSegmentBytes) != manifest.initSegmentCid:
        return Err[MediaAudioReceipt]("media runtime: audio init segment cid mismatch")
    if !strutil.StartsWith(manifest.keyframeIndex, "audio:"):
        return Err[MediaAudioReceipt]("media runtime: audio seek index missing")
    if manifest.mime != "audio/wav":
        return Err[MediaAudioReceipt]("media runtime: first audio only supports audio/wav in v0.1")
    if manifest.codec != "pcm_s16le":
        return Err[MediaAudioReceipt]("media runtime: first audio only supports pcm_s16le in v0.1")
    let probeRes = MediaProbeWavAudioBytes(assetBytes)
    if IsErr(probeRes):
        return Err[MediaAudioReceipt](Error(probeRes))
    let probe = Value(probeRes)
    if rawbytes.BytesLen(initSegmentBytes) != probe.initSegmentBytes:
        return Err[MediaAudioReceipt]("media runtime: audio init segment length mismatch")
    if manifest.initSegmentByteLength != probe.initSegmentBytes:
        return Err[MediaAudioReceipt]("media runtime: audio manifest init segment length mismatch")
    let probedInitBytes = rawbytes.BytesSlice(assetBytes, 0, probe.initSegmentBytes)
    if !rawbytes.BytesEqual(probedInitBytes, initSegmentBytes):
        return Err[MediaAudioReceipt]("media runtime: audio init segment bytes mismatch")
    let audioDataBytes = rawbytes.BytesSlice(assetBytes, probe.pcmDataOffset, probe.pcmDataBytes)
    if rawbytes.BytesLen(audioDataBytes) != probe.pcmDataBytes:
        return Err[MediaAudioReceipt]("media runtime: audio data slice mismatch")
    var receipt = MediaAudioReceipt(
        slotId: session.slotId,
        assetCid: session.assetCid,
        manifestCid: session.manifestCid,
        firstAudioCid: manifest.initSegmentCid,
        audioDataCid: MediaAssetSha256Hex(audioDataBytes),
        bytesReady: rawbytes.BytesLen(assetBytes),
        initSegmentCid: strings.CloneStr(manifest.initSegmentCid),
        initBytesReady: rawbytes.BytesLen(initSegmentBytes),
        codec: manifest.codec,
        keyframeIndex: manifest.keyframeIndex,
        audioProvider: session.audioProvider,
        sampleRateHz: probe.sampleRateHz,
        channelCount: probe.channelCount,
        bitsPerSample: probe.bitsPerSample,
        pcmDataOffset: probe.pcmDataOffset,
        pcmDataBytes: probe.pcmDataBytes,
        outputReady: false,
        outputStatusCode: 0,
        outputStateCode: 0,
        outputPcmBytes: 0,
        verified: true,
        sessionOpenedAtMs: session.openedAtMs,
        trace: strutil.Join(["first-audio->", share(session.audioProvider), "->audio-receipt"], "")
    )
    receipt.receiptCid = MediaAudioReceiptCid(receipt)
    return Ok[MediaAudioReceipt](receipt)

fn MediaAudioReceiptAttachOutput(receipt: var MediaAudioReceipt,
                                 session: var MediaPlaybackSession,
                                 audioProvider: str,
                                 outputStatusCode: int32,
                                 outputStateCode: int32,
                                 sampleRateHz: int32,
                                 channelCount: int32,
                                 bitsPerSample: int32,
                                 pcmDataOffset: int32,
                                 pcmDataBytes: int32,
                                 trace: str): Result[MediaAudioReceipt] =
    if !receipt.verified:
        return Err[MediaAudioReceipt]("media runtime: audio output attach requires verified audio receipt")
    if session.kindCode != MediaAssetKindAudio:
        return Err[MediaAudioReceipt]("media runtime: audio output attach requires audio session")
    if receipt.slotId != session.slotId:
        return Err[MediaAudioReceipt]("media runtime: audio output attach session mismatch")
    if receipt.assetCid != session.assetCid:
        return Err[MediaAudioReceipt]("media runtime: audio output attach session mismatch")
    if receipt.manifestCid != session.manifestCid:
        return Err[MediaAudioReceipt]("media runtime: audio output attach session mismatch")
    if len(audioProvider) <= 0:
        return Err[MediaAudioReceipt]("media runtime: audio output attach missing provider")
    if audioProvider == "none":
        return Err[MediaAudioReceipt]("media runtime: audio output attach missing provider")
    if audioProvider != session.audioProvider:
        return Err[MediaAudioReceipt]("media runtime: audio output attach provider mismatch")
    if audioProvider != receipt.audioProvider:
        return Err[MediaAudioReceipt]("media runtime: audio output attach provider mismatch")
    if outputStatusCode != MediaAudioOutputStatusReady:
        return Err[MediaAudioReceipt]("media runtime: audio output attach status not ready")
    if outputStateCode != MediaPlaybackStatePlaying:
        return Err[MediaAudioReceipt]("media runtime: audio output attach state not playing")
    if sampleRateHz != receipt.sampleRateHz:
        return Err[MediaAudioReceipt]("media runtime: audio output attach sample rate mismatch")
    if channelCount != receipt.channelCount:
        return Err[MediaAudioReceipt]("media runtime: audio output attach channel count mismatch")
    if bitsPerSample != receipt.bitsPerSample:
        return Err[MediaAudioReceipt]("media runtime: audio output attach bits mismatch")
    if pcmDataOffset != receipt.pcmDataOffset:
        return Err[MediaAudioReceipt]("media runtime: audio output attach pcm offset mismatch")
    if pcmDataBytes != receipt.pcmDataBytes:
        return Err[MediaAudioReceipt]("media runtime: audio output attach pcm bytes mismatch")
    if pcmDataBytes <= 0:
        return Err[MediaAudioReceipt]("media runtime: audio output attach empty pcm")
    if len(trace) <= 0:
        return Err[MediaAudioReceipt]("media runtime: audio output attach missing trace")
    var ready = MediaAudioReceipt(
        slotId: receipt.slotId,
        assetCid: receipt.assetCid,
        manifestCid: receipt.manifestCid,
        firstAudioCid: receipt.firstAudioCid,
        audioDataCid: receipt.audioDataCid,
        bytesReady: receipt.bytesReady,
        initSegmentCid: receipt.initSegmentCid,
        initBytesReady: receipt.initBytesReady,
        codec: receipt.codec,
        keyframeIndex: receipt.keyframeIndex,
        audioProvider: receipt.audioProvider,
        sampleRateHz: receipt.sampleRateHz,
        channelCount: receipt.channelCount,
        bitsPerSample: receipt.bitsPerSample,
        pcmDataOffset: receipt.pcmDataOffset,
        pcmDataBytes: receipt.pcmDataBytes,
        outputReady: true,
        outputStatusCode: outputStatusCode,
        outputStateCode: outputStateCode,
        outputPcmBytes: pcmDataBytes,
        verified: receipt.verified,
        startedAtMs: receipt.startedAtMs,
        completedAtMs: receipt.completedAtMs,
        elapsedMs: receipt.elapsedMs,
        sessionOpenedAtMs: receipt.sessionOpenedAtMs,
        openToAudioMs: receipt.openToAudioMs,
        trace: strutil.Join([ share(receipt.trace), "->audio-output-ready:", trace], "")
    )
    ready.receiptCid = MediaAudioReceiptCid(ready)
    return Ok[MediaAudioReceipt](ready)

fn MediaFirstAudioFromPinnedSession(index: var MediaLocalIndex,
                                    session: var MediaPlaybackSession): Result[MediaAudioReceipt] =
    let manifestRes = MediaLocalIndexFind(index, session.assetCid)
    if IsErr(manifestRes):
        return Err[MediaAudioReceipt](Error(manifestRes))
    var manifest = Value(manifestRes)
    if manifest.kindCode != session.kindCode:
        return Err[MediaAudioReceipt]("media runtime: audio session kind mismatch")
    let recordRes = MediaLocalIndexFindAssetRecord(index, session.assetCid)
    if IsErr(recordRes):
        return Err[MediaAudioReceipt](Error(recordRes))
    let record = Value(recordRes)
    if record.manifestCid != session.manifestCid:
        return Err[MediaAudioReceipt]("media runtime: audio pinned record mismatch")
    return MediaFirstAudio(session, manifest, record.assetBytes, record.initSegmentBytes)

fn MediaAssetControlActionAllowed(action: str): bool =
    if action == "Play":
        return true
    if action == "Pause":
        return true
    if action == "Seek":
        return true
    if action == "OpenAsset":
        return true
    if action == "ShareAsset":
        return true
    if action == "EditAsset":
        return true
    if action == "PublishAsset":
        return true
    return false

fn MediaAssetControlActionAllowedForKind(kindCode: int32, action: str): bool =
    if !MediaAssetControlActionAllowed(action):
        return false
    if action == "OpenAsset" || action == "ShareAsset":
        return true
    if action == "EditAsset" || action == "PublishAsset":
        return true
    if kindCode == MediaAssetKindVideo || kindCode == MediaAssetKindAudio:
        if action == "Play" || action == "Pause" || action == "Seek":
            return true
    return false

fn MediaEditPayloadAllowedForKind(kindCode: int32, payload: str): bool =
    if len(payload) <= 0:
        return false
    if kindCode == MediaAssetKindVideo:
        return strutil.StartsWith(payload, "trim=") && strutil.Contains(payload, "..")
    if kindCode == MediaAssetKindImage:
        return strutil.StartsWith(payload, "crop=") && strutil.Contains(payload, ",")
    if kindCode == MediaAssetKindAudio:
        if strutil.StartsWith(payload, "gain="):
            return true
        return strutil.StartsWith(payload, "trim=") && strutil.Contains(payload, "..")
    return false

fn MediaEditKindFromPayload(kindCode: int32, payload: str): Result[str] =
    if !MediaEditPayloadAllowedForKind(kindCode, payload):
        return Err[str]("media runtime: unsupported edit payload")
    if strutil.StartsWith(payload, "trim="):
        return Ok[str]("trim")
    if strutil.StartsWith(payload, "crop="):
        return Ok[str]("crop")
    if strutil.StartsWith(payload, "gain="):
        return Ok[str]("gain")
    return Err[str]("media runtime: unsupported edit payload")

fn MediaControlDecimalPayloadFrom(payload: str, offset: int32): bool =
    if offset >= len(payload):
        return false
    var i: int32
    for i in offset..<len(payload):
        let ch = payload[i]
        if ch < '0' || ch > '9':
            return false
    return true

fn MediaControlPayloadAllowed(session: var MediaPlaybackSession,
                              request: var MediaControlRequest): Result[int32] =
    if request.actionKind == "Play" || request.actionKind == "Pause":
        if len(request.payload) != 0:
            return Err[int32]("media runtime: playback control payload must be empty")
        return Ok[int32](1)
    if request.actionKind == "Seek":
        if !strutil.StartsWith(request.payload, "ms="):
            return Err[int32]("media runtime: seek payload must start with ms=")
        if !MediaControlDecimalPayloadFrom(request.payload, 3):
            return Err[int32]("media runtime: seek payload ms must be decimal")
        return Ok[int32](1)
    if request.actionKind == "EditAsset":
        if !MediaEditPayloadAllowedForKind(session.kindCode, request.payload):
            return Err[int32]("media runtime: edit payload rejected")
        return Ok[int32](1)
    if request.actionKind == "PublishAsset" || request.actionKind == "ShareAsset":
        if request.payload != session.assetCid:
            return Err[int32]("media runtime: asset action payload must equal asset cid")
        return Ok[int32](1)
    if request.actionKind == "OpenAsset":
        if request.payload != session.manifestCid:
            return Err[int32]("media runtime: open payload must equal manifest cid")
        return Ok[int32](1)
    return Err[int32]("media runtime: unsupported control payload")

fn MediaLifecycleEventQueueInit(): MediaLifecycleEventQueue =
    var queue: MediaLifecycleEventQueue
    queue.schema = MediaAssetLifecycleSchema
    queue.openEvents = []
    queue.controlReceipts = []
    queue.editTransactions = []
    queue.publishEvents = []
    queue.deliveryReceipts = []
    return queue

fn MediaOpenEventPreimageFields(slotId: str,
                                assetCid: str,
                                bundleCid: str,
                                manifestCid: str,
                                kindCode: int32,
                                transport: str,
                                payloadSchema: str,
                                guard: str,
                                dispatch: str,
                                announcedBytes: int32,
                                objectCount: int32,
                                dropletCount: int32,
                                sourceStateCode: int32,
                                resultStateCode: int32,
                                statusCode: int32): str =
    return strutil.Join([
        MediaAssetLifecycleSchema,
        "|open|",
        slotId,
        "|",
        assetCid,
        "|",
        bundleCid,
        "|",
        manifestCid,
        "|",
        IntToStr(kindCode),
        "|",
        transport,
        "|",
        payloadSchema,
        "|",
        guard,
        "|",
        dispatch,
        "|",
        IntToStr(announcedBytes),
        "|",
        IntToStr(objectCount),
        "|",
        IntToStr(dropletCount),
        "|",
        IntToStr(sourceStateCode),
        "|",
        IntToStr(resultStateCode),
        "|",
        IntToStr(statusCode)
    ], "")

fn MediaOpenEventCanonicalCid(event: var MediaOpenEvent): str =
    let preimage = MediaOpenEventPreimageFields(event.slotId,
                                                event.assetCid,
                                                event.bundleCid,
                                                event.manifestCid,
                                                event.kindCode,
                                                event.transport,
                                                event.payloadSchema,
                                                event.guard,
                                                event.dispatch,
                                                event.announcedBytes,
                                                event.objectCount,
                                                event.dropletCount,
                                                event.sourceStateCode,
                                                event.resultStateCode,
                                                event.statusCode)
    return MediaAssetSha256HexText(preimage)

fn MediaControlReceiptPreimage(receipt: var MediaControlReceipt): str =
    return strutil.Join([
        MediaAssetLifecycleSchema,
        "|control|",
        receipt.slotId,
        "|",
        receipt.assetCid,
        "|",
        IntToStr(receipt.kindCode),
        "|",
        receipt.actionKind,
        "|",
        receipt.payload,
        "|",
        IntToStr(receipt.statusCode),
        "|",
        receipt.dispatch,
        "|",
        IntToStr(receipt.previousStateCode),
        "|",
        IntToStr(receipt.stateCode),
        "|",
        receipt.guard,
        "|",
        receipt.trace
    ], "")

fn MediaControlReceiptCid(receipt: var MediaControlReceipt): str =
    return MediaAssetSha256HexText(MediaControlReceiptPreimage(receipt))

fn MediaEditTransactionPreimage(session: var MediaPlaybackSession,
                                receipt: var MediaControlReceipt,
                                editKind: str,
                                payloadSchema: str): str =
    return strutil.Join([
        MediaAssetLifecycleSchema,
        "|edit|",
        session.slotId,
        "|",
        session.assetCid,
        "|",
        session.manifestCid,
        "|",
        IntToStr(session.kindCode),
        "|",
        editKind,
        "|",
        receipt.payload,
        "|",
        payloadSchema,
        "|",
        receipt.guard,
        "|",
        receipt.dispatch
    ], "")

fn MediaPublishEventPreimageFields(slotId: str,
                                   assetCid: str,
                                   bundleCid: str,
                                   manifestCid: str,
                                   kindCode: int32,
                                   transport: str,
                                   payloadSchema: str,
                                   guard: str,
                                   dispatch: str,
                                   announcedBytes: int32,
                                   objectCount: int32,
                                   dropletCount: int32,
                                   sourceStateCode: int32,
                                   resultStateCode: int32,
                                   statusCode: int32): str =
    return strutil.Join([
        MediaAssetLifecycleSchema,
        "|publish|",
        slotId,
        "|",
        assetCid,
        "|",
        bundleCid,
        "|",
        manifestCid,
        "|",
        IntToStr(kindCode),
        "|",
        transport,
        "|",
        payloadSchema,
        "|",
        guard,
        "|",
        dispatch,
        "|",
        IntToStr(announcedBytes),
        "|",
        IntToStr(objectCount),
        "|",
        IntToStr(dropletCount),
        "|",
        IntToStr(sourceStateCode),
        "|",
        IntToStr(resultStateCode),
        "|",
        IntToStr(statusCode)
    ], "")

fn MediaPublishEventCanonicalCid(event: var MediaPublishEvent): str =
    let preimage = MediaPublishEventPreimageFields(event.slotId,
                                                   event.assetCid,
                                                   event.bundleCid,
                                                   event.manifestCid,
                                                   event.kindCode,
                                                   event.transport,
                                                   event.payloadSchema,
                                                   event.guard,
                                                   event.dispatch,
                                                   event.announcedBytes,
                                                   event.objectCount,
                                                   event.dropletCount,
                                                   event.sourceStateCode,
                                                   event.resultStateCode,
                                                   event.statusCode)
    return MediaAssetSha256HexText(preimage)

fn MediaDeliveryReceiptPreimage(publishEvent: var MediaPublishEvent,
                                openEvent: var MediaOpenEvent,
                                firstMediaCid: str,
                                sourceCode: int32,
                                transferredBytes: int32,
                                mediaBytesReady: int32,
                                remoteFetchMs: int64,
                                openToMediaMs: int64): str =
    return strutil.Join([
        MediaAssetLifecycleSchema,
        "|delivery|",
        publishEvent.eventCid,
        "|",
        openEvent.eventCid,
        "|",
        openEvent.slotId,
        "|",
        openEvent.assetCid,
        "|",
        openEvent.bundleCid,
        "|",
        openEvent.manifestCid,
        "|",
        IntToStr(openEvent.kindCode),
        "|",
        openEvent.transport,
        "|",
        firstMediaCid,
        "|",
        IntToStr(sourceCode),
        "|",
        IntToStr(openEvent.announcedBytes),
        "|",
        IntToStr(openEvent.objectCount),
        "|",
        IntToStr(openEvent.dropletCount),
        "|",
        IntToStr(transferredBytes),
        "|",
        IntToStr(mediaBytesReady),
        "|",
        strings.Int64ToStr(remoteFetchMs),
        "|",
        strings.Int64ToStr(openToMediaMs)
    ], "")

fn MediaDeliveryReceiptCanonicalCid(receipt: var MediaDeliveryReceipt): str =
    let preimage = strutil.Join([
        MediaAssetLifecycleSchema,
        "|delivery|",
        receipt.publishEventCid,
        "|",
        receipt.openEventCid,
        "|",
        receipt.slotId,
        "|",
        receipt.assetCid,
        "|",
        receipt.bundleCid,
        "|",
        receipt.manifestCid,
        "|",
        IntToStr(receipt.kindCode),
        "|",
        receipt.transport,
        "|",
        receipt.firstMediaCid,
        "|",
        IntToStr(receipt.sourceCode),
        "|",
        IntToStr(receipt.announcedBytes),
        "|",
        IntToStr(receipt.objectCount),
        "|",
        IntToStr(receipt.dropletCount),
        "|",
        IntToStr(receipt.transferredBytes),
        "|",
        IntToStr(receipt.mediaBytesReady),
        "|",
        strings.Int64ToStr(receipt.remoteFetchMs),
        "|",
        strings.Int64ToStr(receipt.openToMediaMs)
    ], "")
    return MediaAssetSha256HexText(preimage)

fn MediaDeliveryValidateManifestForEvents(publishEvent: var MediaPublishEvent,
                                          openEvent: var MediaOpenEvent,
                                          manifest: var MediaAssetManifest): Result[int32] =
    let contentBytesRes = MediaAssetManifestContentByteLength(manifest)
    if IsErr(contentBytesRes):
        return Err[int32](Error(contentBytesRes))
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[int32](Error(manifestCidRes))
    let manifestCid = Value(manifestCidRes)
    if manifestCid != openEvent.manifestCid || manifestCid != publishEvent.manifestCid:
        return Err[int32]("media runtime: delivery manifest cid mismatch")
    if manifest.assetCid != openEvent.assetCid || manifest.assetCid != publishEvent.assetCid:
        return Err[int32]("media runtime: delivery manifest asset mismatch")
    if manifest.bundleCid != openEvent.bundleCid || manifest.bundleCid != publishEvent.bundleCid:
        return Err[int32]("media runtime: delivery manifest bundle mismatch")
    if manifest.kindCode != openEvent.kindCode || manifest.kindCode != publishEvent.kindCode:
        return Err[int32]("media runtime: delivery manifest kind mismatch")
    if manifest.transport != openEvent.transport || manifest.transport != publishEvent.transport:
        return Err[int32]("media runtime: delivery manifest transport mismatch")
    if manifest.objects.len != openEvent.objectCount || manifest.objects.len != publishEvent.objectCount:
        return Err[int32]("media runtime: delivery manifest object count mismatch")
    if manifest.droplets.len != openEvent.dropletCount || manifest.droplets.len != publishEvent.dropletCount:
        return Err[int32]("media runtime: delivery manifest droplet count mismatch")
    return contentBytesRes

fn MediaOpenEventFromSession(manifest: var MediaAssetManifest,
                             session: var MediaPlaybackSession,
                             payloadSchema: str,
                             guard: str): Result[MediaOpenEvent] =
    if len(payloadSchema) <= 0:
        return Err[MediaOpenEvent]("media runtime: missing open payload schema")
    if len(guard) <= 0:
        return Err[MediaOpenEvent]("media runtime: missing open guard")
    if session.assetCid != manifest.assetCid || session.kindCode != manifest.kindCode:
        return Err[MediaOpenEvent]("media runtime: open session/manifest mismatch")
    if session.stateCode != MediaPlaybackStateOpened:
        return Err[MediaOpenEvent]("media runtime: open event requires opened session")
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[MediaOpenEvent](Error(manifestCidRes))
    if Value(manifestCidRes) != session.manifestCid:
        return Err[MediaOpenEvent]("media runtime: open event manifest cid mismatch")
    let openRes = MediaAssetOpenReceiptFromManifest(manifest)
    if IsErr(openRes):
        return Err[MediaOpenEvent](Error(openRes))
    let openReceipt = Value(openRes)
    let sourceStateCode = 0
    let resultStateCode = session.stateCode
    let statusCode = MediaOpenEventStatusOpened
    let objectCount = manifest.objects.len
    let dropletCount = manifest.droplets.len
    let preimage = MediaOpenEventPreimageFields(session.slotId,
                                                manifest.assetCid,
                                                manifest.bundleCid,
                                                session.manifestCid,
                                                manifest.kindCode,
                                                manifest.transport,
                                                payloadSchema,
                                                guard,
                                                session.eventQueue,
                                                openReceipt.announcedBytes,
                                                objectCount,
                                                dropletCount,
                                                sourceStateCode,
                                                resultStateCode,
                                                statusCode)
    return Ok[MediaOpenEvent](MediaOpenEvent(
        schema: MediaAssetLifecycleSchema,
        eventCid: MediaAssetSha256HexText(preimage),
        slotId: session.slotId,
        assetCid: strings.CloneStr(manifest.assetCid),
        bundleCid: strings.CloneStr(manifest.bundleCid),
        manifestCid: session.manifestCid,
        kindCode: manifest.kindCode,
        transport: manifest.transport,
        payloadSchema: payloadSchema,
        guard: guard,
        dispatch: session.eventQueue,
        announcedBytes: openReceipt.announcedBytes,
        objectCount: objectCount,
        dropletCount: dropletCount,
        sourceStateCode: sourceStateCode,
        resultStateCode: resultStateCode,
        statusCode: statusCode,
        trace: strutil.Join([ share(session.trace), "->open-event"], "")
    ))

fn MediaRemoteFrameDeliveryReceiptFromPublishOpen(publishEvent: var MediaPublishEvent,
                                                  openEvent: var MediaOpenEvent,
                                                  manifest: var MediaAssetManifest,
                                                  frame: var MediaFrameReceipt,
                                                  transferredBytes: int32,
                                                  remoteFetchMs: int64): Result[MediaDeliveryReceipt] =
    if publishEvent.schema != MediaAssetLifecycleSchema || openEvent.schema != MediaAssetLifecycleSchema:
        return Err[MediaDeliveryReceipt]("media runtime: delivery event schema mismatch")
    if publishEvent.statusCode != MediaPublishEventStatusQueued:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires queued publish event")
    if openEvent.statusCode != MediaOpenEventStatusOpened:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires opened remote event")
    if publishEvent.transport != MediaAssetTransportMoq || openEvent.transport != MediaAssetTransportMoq:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires moq transport")
    if publishEvent.eventCid != MediaPublishEventCanonicalCid(publishEvent):
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish event cid mismatch")
    if openEvent.eventCid != MediaOpenEventCanonicalCid(openEvent):
        return Err[MediaDeliveryReceipt]("media runtime: delivery open event cid mismatch")
    if publishEvent.assetCid != openEvent.assetCid ||
       publishEvent.bundleCid != openEvent.bundleCid ||
       publishEvent.manifestCid != openEvent.manifestCid ||
       publishEvent.kindCode != openEvent.kindCode:
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish/open mismatch")
    if publishEvent.objectCount != openEvent.objectCount || publishEvent.dropletCount != openEvent.dropletCount:
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish/open object metadata mismatch")
    let manifestBytesRes = MediaDeliveryValidateManifestForEvents(publishEvent, openEvent, manifest)
    if IsErr(manifestBytesRes):
        return Err[MediaDeliveryReceipt](Error(manifestBytesRes))
    if openEvent.slotId != frame.slotId ||
       openEvent.assetCid != frame.assetCid ||
       openEvent.manifestCid != frame.manifestCid:
        return Err[MediaDeliveryReceipt]("media runtime: delivery open/frame mismatch")
    if openEvent.kindCode != MediaAssetKindVideo:
        return Err[MediaDeliveryReceipt]("media runtime: delivery frame receipt currently requires video")
    if frame.sourceCode != MediaAssetFirstFrameSourceInitSegment:
        return Err[MediaDeliveryReceipt]("media runtime: remote frame delivery requires init segment source")
    if !frame.verified:
        return Err[MediaDeliveryReceipt]("media runtime: delivery frame must be verified")
    if len(frame.firstFrameCid) <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery missing first frame cid")
    if frame.bytesReady <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery media bytes must be positive")
    if frame.firstFrameCid != manifest.initSegmentCid:
        return Err[MediaDeliveryReceipt]("media runtime: delivery first frame cid must match manifest init segment")
    if frame.bytesReady != manifest.initSegmentByteLength:
        return Err[MediaDeliveryReceipt]("media runtime: delivery first frame bytes must match manifest init segment length")
    if transferredBytes != frame.bytesReady:
        return Err[MediaDeliveryReceipt]("media runtime: delivery transferred bytes must equal media bytes ready")
    if remoteFetchMs < int64(0):
        return Err[MediaDeliveryReceipt]("media runtime: delivery remote fetch ms must be non-negative")
    if frame.openToFrameMs < int64(0):
        return Err[MediaDeliveryReceipt]("media runtime: delivery open-to-frame ms must be non-negative")
    if remoteFetchMs > int64(MediaDeliverySecondsOpenBudgetMs):
        return Err[MediaDeliveryReceipt]("media runtime: delivery remote fetch exceeded seconds-open budget")
    if frame.openToFrameMs > int64(MediaDeliverySecondsOpenBudgetMs):
        return Err[MediaDeliveryReceipt]("media runtime: delivery first frame exceeded seconds-open budget")
    if openEvent.objectCount <= 0 || openEvent.dropletCount <= 0 || openEvent.announcedBytes <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery missing moq announcement metadata")
    let preimage = MediaDeliveryReceiptPreimage(publishEvent,
                                                openEvent,
                                                frame.firstFrameCid,
                                                frame.sourceCode,
                                                transferredBytes,
                                                frame.bytesReady,
                                                remoteFetchMs,
                                                frame.openToFrameMs)
    return Ok[MediaDeliveryReceipt](MediaDeliveryReceipt(
        schema: MediaAssetLifecycleSchema,
        receiptCid: MediaAssetSha256HexText(preimage),
        receiptKind: "RemoteFrame",
        slotId: openEvent.slotId,
        assetCid: openEvent.assetCid,
        bundleCid: openEvent.bundleCid,
        manifestCid: openEvent.manifestCid,
        kindCode: openEvent.kindCode,
        transport: openEvent.transport,
        publishEventCid: publishEvent.eventCid,
        openEventCid: openEvent.eventCid,
        firstMediaCid: frame.firstFrameCid,
        sourceCode: frame.sourceCode,
        announcedBytes: openEvent.announcedBytes,
        transferredBytes: transferredBytes,
        mediaBytesReady: frame.bytesReady,
        objectCount: openEvent.objectCount,
        dropletCount: openEvent.dropletCount,
        remoteFetchMs: remoteFetchMs,
        openToMediaMs: frame.openToFrameMs,
        budgetMs: int64(MediaDeliverySecondsOpenBudgetMs),
        statusCode: MediaDeliveryStatusRemoteMediaReady,
        verified: true,
        guard: openEvent.guard,
        trace: strutil.Join([ share(openEvent.trace), "->remote-frame-delivery"], "")
    ))

fn MediaRemoteImageDeliveryReceiptFromPublishOpen(publishEvent: var MediaPublishEvent,
                                                  openEvent: var MediaOpenEvent,
                                                  manifest: var MediaAssetManifest,
                                                  image: var MediaImageReceipt,
                                                  transferredBytes: int32,
                                                  remoteFetchMs: int64): Result[MediaDeliveryReceipt] =
    if publishEvent.schema != MediaAssetLifecycleSchema || openEvent.schema != MediaAssetLifecycleSchema:
        return Err[MediaDeliveryReceipt]("media runtime: delivery event schema mismatch")
    if publishEvent.statusCode != MediaPublishEventStatusQueued:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires queued publish event")
    if openEvent.statusCode != MediaOpenEventStatusOpened:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires opened remote event")
    if publishEvent.transport != MediaAssetTransportMoq || openEvent.transport != MediaAssetTransportMoq:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires moq transport")
    if publishEvent.eventCid != MediaPublishEventCanonicalCid(publishEvent):
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish event cid mismatch")
    if openEvent.eventCid != MediaOpenEventCanonicalCid(openEvent):
        return Err[MediaDeliveryReceipt]("media runtime: delivery open event cid mismatch")
    if publishEvent.assetCid != openEvent.assetCid ||
       publishEvent.bundleCid != openEvent.bundleCid ||
       publishEvent.manifestCid != openEvent.manifestCid ||
       publishEvent.kindCode != openEvent.kindCode:
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish/open mismatch")
    if publishEvent.objectCount != openEvent.objectCount || publishEvent.dropletCount != openEvent.dropletCount:
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish/open object metadata mismatch")
    let manifestBytesRes = MediaDeliveryValidateManifestForEvents(publishEvent, openEvent, manifest)
    if IsErr(manifestBytesRes):
        return Err[MediaDeliveryReceipt](Error(manifestBytesRes))
    if openEvent.slotId != image.slotId ||
       openEvent.assetCid != image.assetCid ||
       openEvent.manifestCid != image.manifestCid:
        return Err[MediaDeliveryReceipt]("media runtime: delivery open/image mismatch")
    if openEvent.kindCode != MediaAssetKindImage:
        return Err[MediaDeliveryReceipt]("media runtime: delivery image receipt requires image")
    if !image.verified:
        return Err[MediaDeliveryReceipt]("media runtime: delivery image must be verified")
    if len(image.firstImageCid) <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery missing first image cid")
    if image.bytesReady <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery media bytes must be positive")
    if image.firstImageCid != manifest.assetCid:
        return Err[MediaDeliveryReceipt]("media runtime: delivery first image cid must match manifest asset cid")
    if image.bytesReady != Value(manifestBytesRes):
        return Err[MediaDeliveryReceipt]("media runtime: delivery image bytes must match manifest content length")
    if transferredBytes != image.bytesReady:
        return Err[MediaDeliveryReceipt]("media runtime: delivery transferred bytes must equal media bytes ready")
    if remoteFetchMs < int64(0):
        return Err[MediaDeliveryReceipt]("media runtime: delivery remote fetch ms must be non-negative")
    if image.openToImageMs < int64(0):
        return Err[MediaDeliveryReceipt]("media runtime: delivery open-to-image ms must be non-negative")
    if remoteFetchMs > int64(MediaDeliverySecondsOpenBudgetMs):
        return Err[MediaDeliveryReceipt]("media runtime: delivery remote fetch exceeded seconds-open budget")
    if image.openToImageMs > int64(MediaDeliverySecondsOpenBudgetMs):
        return Err[MediaDeliveryReceipt]("media runtime: delivery first image exceeded seconds-open budget")
    if openEvent.objectCount <= 0 || openEvent.dropletCount <= 0 || openEvent.announcedBytes <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery missing moq announcement metadata")
    let sourceCode = MediaAssetFirstFrameSourceAsset
    let preimage = MediaDeliveryReceiptPreimage(publishEvent,
                                                openEvent,
                                                image.firstImageCid,
                                                sourceCode,
                                                transferredBytes,
                                                image.bytesReady,
                                                remoteFetchMs,
                                                image.openToImageMs)
    return Ok[MediaDeliveryReceipt](MediaDeliveryReceipt(
        schema: MediaAssetLifecycleSchema,
        receiptCid: MediaAssetSha256HexText(preimage),
        receiptKind: "RemoteImage",
        slotId: openEvent.slotId,
        assetCid: openEvent.assetCid,
        bundleCid: openEvent.bundleCid,
        manifestCid: openEvent.manifestCid,
        kindCode: openEvent.kindCode,
        transport: openEvent.transport,
        publishEventCid: publishEvent.eventCid,
        openEventCid: openEvent.eventCid,
        firstMediaCid: image.firstImageCid,
        sourceCode: sourceCode,
        announcedBytes: openEvent.announcedBytes,
        transferredBytes: transferredBytes,
        mediaBytesReady: image.bytesReady,
        objectCount: openEvent.objectCount,
        dropletCount: openEvent.dropletCount,
        remoteFetchMs: remoteFetchMs,
        openToMediaMs: image.openToImageMs,
        budgetMs: int64(MediaDeliverySecondsOpenBudgetMs),
        statusCode: MediaDeliveryStatusRemoteMediaReady,
        verified: true,
        guard: openEvent.guard,
        trace: strutil.Join([ share(openEvent.trace), "->remote-image-delivery"], "")
    ))

fn MediaRemoteAudioDeliveryReceiptFromPublishOpen(publishEvent: var MediaPublishEvent,
                                                  openEvent: var MediaOpenEvent,
                                                  manifest: var MediaAssetManifest,
                                                  audio: var MediaAudioReceipt,
                                                  transferredBytes: int32,
                                                  remoteFetchMs: int64): Result[MediaDeliveryReceipt] =
    if publishEvent.schema != MediaAssetLifecycleSchema || openEvent.schema != MediaAssetLifecycleSchema:
        return Err[MediaDeliveryReceipt]("media runtime: delivery event schema mismatch")
    if publishEvent.statusCode != MediaPublishEventStatusQueued:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires queued publish event")
    if openEvent.statusCode != MediaOpenEventStatusOpened:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires opened remote event")
    if publishEvent.transport != MediaAssetTransportMoq || openEvent.transport != MediaAssetTransportMoq:
        return Err[MediaDeliveryReceipt]("media runtime: delivery requires moq transport")
    if publishEvent.eventCid != MediaPublishEventCanonicalCid(publishEvent):
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish event cid mismatch")
    if openEvent.eventCid != MediaOpenEventCanonicalCid(openEvent):
        return Err[MediaDeliveryReceipt]("media runtime: delivery open event cid mismatch")
    if publishEvent.assetCid != openEvent.assetCid ||
       publishEvent.bundleCid != openEvent.bundleCid ||
       publishEvent.manifestCid != openEvent.manifestCid ||
       publishEvent.kindCode != openEvent.kindCode:
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish/open mismatch")
    if publishEvent.objectCount != openEvent.objectCount || publishEvent.dropletCount != openEvent.dropletCount:
        return Err[MediaDeliveryReceipt]("media runtime: delivery publish/open object metadata mismatch")
    let manifestBytesRes = MediaDeliveryValidateManifestForEvents(publishEvent, openEvent, manifest)
    if IsErr(manifestBytesRes):
        return Err[MediaDeliveryReceipt](Error(manifestBytesRes))
    if openEvent.slotId != audio.slotId ||
       openEvent.assetCid != audio.assetCid ||
       openEvent.manifestCid != audio.manifestCid:
        return Err[MediaDeliveryReceipt]("media runtime: delivery open/audio mismatch")
    if openEvent.kindCode != MediaAssetKindAudio:
        return Err[MediaDeliveryReceipt]("media runtime: delivery audio receipt requires audio")
    if !audio.verified:
        return Err[MediaDeliveryReceipt]("media runtime: delivery audio must be verified")
    if len(audio.firstAudioCid) <= 0 || len(audio.audioDataCid) <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery missing first audio cid")
    if audio.bytesReady <= 0 || audio.pcmDataBytes <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery audio bytes must be positive")
    if audio.firstAudioCid != manifest.initSegmentCid || audio.initSegmentCid != manifest.initSegmentCid:
        return Err[MediaDeliveryReceipt]("media runtime: delivery first audio cid must match manifest init segment")
    if audio.initBytesReady != manifest.initSegmentByteLength:
        return Err[MediaDeliveryReceipt]("media runtime: delivery audio init bytes must match manifest init segment length")
    if audio.bytesReady != Value(manifestBytesRes):
        return Err[MediaDeliveryReceipt]("media runtime: delivery audio bytes must match manifest content length")
    if transferredBytes != audio.bytesReady:
        return Err[MediaDeliveryReceipt]("media runtime: delivery transferred bytes must equal media bytes ready")
    if remoteFetchMs < int64(0):
        return Err[MediaDeliveryReceipt]("media runtime: delivery remote fetch ms must be non-negative")
    if audio.openToAudioMs < int64(0):
        return Err[MediaDeliveryReceipt]("media runtime: delivery open-to-audio ms must be non-negative")
    if remoteFetchMs > int64(MediaDeliverySecondsOpenBudgetMs):
        return Err[MediaDeliveryReceipt]("media runtime: delivery remote fetch exceeded seconds-open budget")
    if audio.openToAudioMs > int64(MediaDeliverySecondsOpenBudgetMs):
        return Err[MediaDeliveryReceipt]("media runtime: delivery first audio exceeded seconds-open budget")
    if openEvent.objectCount <= 0 || openEvent.dropletCount <= 0 || openEvent.announcedBytes <= 0:
        return Err[MediaDeliveryReceipt]("media runtime: delivery missing moq announcement metadata")
    let sourceCode = MediaAssetFirstFrameSourceAsset
    let preimage = MediaDeliveryReceiptPreimage(publishEvent,
                                                openEvent,
                                                audio.firstAudioCid,
                                                sourceCode,
                                                transferredBytes,
                                                audio.bytesReady,
                                                remoteFetchMs,
                                                audio.openToAudioMs)
    return Ok[MediaDeliveryReceipt](MediaDeliveryReceipt(
        schema: MediaAssetLifecycleSchema,
        receiptCid: MediaAssetSha256HexText(preimage),
        receiptKind: "RemoteAudio",
        slotId: openEvent.slotId,
        assetCid: openEvent.assetCid,
        bundleCid: openEvent.bundleCid,
        manifestCid: openEvent.manifestCid,
        kindCode: openEvent.kindCode,
        transport: openEvent.transport,
        publishEventCid: publishEvent.eventCid,
        openEventCid: openEvent.eventCid,
        firstMediaCid: audio.firstAudioCid,
        sourceCode: sourceCode,
        announcedBytes: openEvent.announcedBytes,
        transferredBytes: transferredBytes,
        mediaBytesReady: audio.bytesReady,
        objectCount: openEvent.objectCount,
        dropletCount: openEvent.dropletCount,
        remoteFetchMs: remoteFetchMs,
        openToMediaMs: audio.openToAudioMs,
        budgetMs: int64(MediaDeliverySecondsOpenBudgetMs),
        statusCode: MediaDeliveryStatusRemoteMediaReady,
        verified: true,
        guard: openEvent.guard,
        trace: strutil.Join([ share(openEvent.trace), "->remote-audio-delivery"], "")
    ))

fn MediaEditTransactionFromControl(session: var MediaPlaybackSession,
                                   receipt: var MediaControlReceipt,
                                   payloadSchema: str): Result[MediaEditTransaction] =
    if receipt.actionKind != "EditAsset":
        return Err[MediaEditTransaction]("media runtime: edit transaction requires EditAsset receipt")
    if len(payloadSchema) <= 0:
        return Err[MediaEditTransaction]("media runtime: missing edit payload schema")
    if session.slotId != receipt.slotId || session.assetCid != receipt.assetCid || session.kindCode != receipt.kindCode:
        return Err[MediaEditTransaction]("media runtime: edit receipt/session mismatch")
    if receipt.stateCode != MediaPlaybackStateEdited:
        return Err[MediaEditTransaction]("media runtime: edit receipt state mismatch")
    if len(receipt.guard) <= 0 || len(receipt.dispatch) <= 0:
        return Err[MediaEditTransaction]("media runtime: edit receipt missing queue metadata")
    let editKindRes = MediaEditKindFromPayload(receipt.kindCode, receipt.payload)
    if IsErr(editKindRes):
        return Err[MediaEditTransaction](Error(editKindRes))
    let editKind = Value(editKindRes)
    let preimage = MediaEditTransactionPreimage(session, receipt, editKind, payloadSchema)
    return Ok[MediaEditTransaction](MediaEditTransaction(
        schema: MediaAssetLifecycleSchema,
        transactionCid: MediaAssetSha256HexText(preimage),
        slotId: receipt.slotId,
        assetCid: receipt.assetCid,
        manifestCid: session.manifestCid,
        kindCode: receipt.kindCode,
        editKind: editKind,
        editPayload: receipt.payload,
        payloadSchema: payloadSchema,
        guard: receipt.guard,
        dispatch: receipt.dispatch,
        sourceStateCode: receipt.previousStateCode,
        resultStateCode: receipt.stateCode,
        statusCode: MediaEditTransactionStatusValidated,
        trace: strutil.Join([ share(receipt.trace), "->edit-transaction"], "")
    ))

fn MediaPublishEventFromControl(index: var MediaLocalIndex,
                                session: var MediaPlaybackSession,
                                receipt: var MediaControlReceipt,
                                payloadSchema: str): Result[MediaPublishEvent] =
    if receipt.actionKind != "PublishAsset":
        return Err[MediaPublishEvent]("media runtime: publish event requires PublishAsset receipt")
    if len(payloadSchema) <= 0:
        return Err[MediaPublishEvent]("media runtime: missing publish payload schema")
    if session.slotId != receipt.slotId || session.assetCid != receipt.assetCid || session.kindCode != receipt.kindCode:
        return Err[MediaPublishEvent]("media runtime: publish receipt/session mismatch")
    if receipt.stateCode != MediaPlaybackStatePublished:
        return Err[MediaPublishEvent]("media runtime: publish receipt state mismatch")
    if receipt.payload != session.assetCid:
        return Err[MediaPublishEvent]("media runtime: publish payload must equal asset cid")
    if len(receipt.guard) <= 0 || len(receipt.dispatch) <= 0:
        return Err[MediaPublishEvent]("media runtime: publish receipt missing queue metadata")
    let manifestRes = MediaLocalIndexFind(index, session.assetCid)
    if IsErr(manifestRes):
        return Err[MediaPublishEvent](Error(manifestRes))
    var manifest = Value(manifestRes)
    if manifest.kindCode != session.kindCode:
        return Err[MediaPublishEvent]("media runtime: publish manifest kind mismatch")
    let manifestCidRes = MediaAssetManifestCid(manifest)
    if IsErr(manifestCidRes):
        return Err[MediaPublishEvent](Error(manifestCidRes))
    if Value(manifestCidRes) != session.manifestCid:
        return Err[MediaPublishEvent]("media runtime: publish manifest cid mismatch")
    let openRes = MediaAssetOpenReceiptFromManifest(manifest)
    if IsErr(openRes):
        return Err[MediaPublishEvent](Error(openRes))
    let openReceipt = Value(openRes)
    let sourceStateCode = receipt.previousStateCode
    let resultStateCode = receipt.stateCode
    let statusCode = MediaPublishEventStatusQueued
    let objectCount = manifest.objects.len
    let dropletCount = manifest.droplets.len
    let preimage = MediaPublishEventPreimageFields(receipt.slotId,
                                                   manifest.assetCid,
                                                   manifest.bundleCid,
                                                   session.manifestCid,
                                                   manifest.kindCode,
                                                   manifest.transport,
                                                   payloadSchema,
                                                   receipt.guard,
                                                   receipt.dispatch,
                                                   openReceipt.announcedBytes,
                                                   objectCount,
                                                   dropletCount,
                                                   sourceStateCode,
                                                   resultStateCode,
                                                   statusCode)
    return Ok[MediaPublishEvent](MediaPublishEvent(
        schema: MediaAssetLifecycleSchema,
        eventCid: MediaAssetSha256HexText(preimage),
        slotId: receipt.slotId,
        assetCid: strings.CloneStr(manifest.assetCid),
        bundleCid: strings.CloneStr(manifest.bundleCid),
        manifestCid: session.manifestCid,
        kindCode: manifest.kindCode,
        transport: manifest.transport,
        payloadSchema: payloadSchema,
        guard: receipt.guard,
        dispatch: receipt.dispatch,
        announcedBytes: openReceipt.announcedBytes,
        objectCount: objectCount,
        dropletCount: dropletCount,
        sourceStateCode: sourceStateCode,
        resultStateCode: resultStateCode,
        statusCode: statusCode,
        trace: strutil.Join([ share(receipt.trace), "->publish-event"], "")
    ))

fn MediaLifecycleEventQueueFindOpen(queue: var MediaLifecycleEventQueue, eventCid: str): int32 =
    var i: int32
    for i in i..<queue.openEvents.len:
        if queue.openEvents[i].eventCid == eventCid:
            return i
    return -1

fn MediaLifecycleEventQueueFindControl(queue: var MediaLifecycleEventQueue, receiptCid: str): int32 =
    var i: int32
    for i in i..<queue.controlReceipts.len:
        if queue.controlReceipts[i].receiptCid == receiptCid:
            return i
    return -1

fn MediaLifecycleEventQueueFindEdit(queue: var MediaLifecycleEventQueue, transactionCid: str): int32 =
    var i: int32
    for i in i..<queue.editTransactions.len:
        if queue.editTransactions[i].transactionCid == transactionCid:
            return i
    return -1

fn MediaLifecycleEventQueueFindPublish(queue: var MediaLifecycleEventQueue, eventCid: str): int32 =
    var i: int32
    for i in i..<queue.publishEvents.len:
        if queue.publishEvents[i].eventCid == eventCid:
            return i
    return -1

fn MediaLifecycleEventQueueFindDelivery(queue: var MediaLifecycleEventQueue, receiptCid: str): int32 =
    var i: int32
    for i in i..<queue.deliveryReceipts.len:
        if queue.deliveryReceipts[i].receiptCid == receiptCid:
            return i
    return -1

fn MediaLifecycleEventQueueEnqueueOpen(queue: var MediaLifecycleEventQueue,
                                       event: MediaOpenEvent): Result[int32] =
    if event.schema != MediaAssetLifecycleSchema:
        return Err[int32]("media runtime: open event schema mismatch")
    if len(event.eventCid) <= 0:
        return Err[int32]("media runtime: missing open event cid")
    if len(event.trace) <= 0:
        return Err[int32]("media runtime: missing open event trace")
    var canonicalEvent = event
    if event.eventCid != MediaOpenEventCanonicalCid(canonicalEvent):
        return Err[int32]("media runtime: open event cid mismatch")
    if MediaLifecycleEventQueueFindOpen(queue, event.eventCid) >= 0:
        return Err[int32]("media runtime: duplicate open event")
    add(queue.openEvents, event)
    return Ok[int32](queue.openEvents.len)

fn MediaLifecycleEventQueueEnqueueControl(queue: var MediaLifecycleEventQueue,
                                          receipt: MediaControlReceipt): Result[int32] =
    if len(receipt.receiptCid) <= 0:
        return Err[int32]("media runtime: missing control receipt cid")
    if len(receipt.trace) <= 0:
        return Err[int32]("media runtime: missing control receipt trace")
    if !MediaAssetControlActionAllowed(receipt.actionKind):
        return Err[int32]("media runtime: control receipt unsupported action")
    if !MediaAssetControlActionAllowedForKind(receipt.kindCode, receipt.actionKind):
        return Err[int32]("media runtime: control receipt unsupported action for kind")
    if receipt.statusCode != MediaControlStatusQueued:
        return Err[int32]("media runtime: control receipt status mismatch")
    if len(receipt.dispatch) <= 0:
        return Err[int32]("media runtime: control receipt missing dispatch")
    var canonicalReceipt = receipt
    if receipt.receiptCid != MediaControlReceiptCid(canonicalReceipt):
        return Err[int32]("media runtime: control receipt cid mismatch")
    if MediaLifecycleEventQueueFindControl(queue, receipt.receiptCid) >= 0:
        return Err[int32]("media runtime: duplicate control receipt")
    add(queue.controlReceipts, receipt)
    return Ok[int32](queue.controlReceipts.len)

fn MediaLifecycleEventQueueEnqueueEdit(queue: var MediaLifecycleEventQueue,
                                       transaction: MediaEditTransaction): Result[int32] =
    if transaction.schema != MediaAssetLifecycleSchema:
        return Err[int32]("media runtime: edit transaction schema mismatch")
    if len(transaction.transactionCid) <= 0:
        return Err[int32]("media runtime: missing edit transaction cid")
    if len(transaction.trace) <= 0:
        return Err[int32]("media runtime: missing edit transaction trace")
    if MediaLifecycleEventQueueFindEdit(queue, transaction.transactionCid) >= 0:
        return Err[int32]("media runtime: duplicate edit transaction")
    add(queue.editTransactions, transaction)
    return Ok[int32](queue.editTransactions.len)

fn MediaLifecycleEventQueueEnqueuePublish(queue: var MediaLifecycleEventQueue,
                                          event: MediaPublishEvent): Result[int32] =
    if event.schema != MediaAssetLifecycleSchema:
        return Err[int32]("media runtime: publish event schema mismatch")
    if len(event.eventCid) <= 0:
        return Err[int32]("media runtime: missing publish event cid")
    if len(event.trace) <= 0:
        return Err[int32]("media runtime: missing publish event trace")
    var canonicalEvent = event
    if event.eventCid != MediaPublishEventCanonicalCid(canonicalEvent):
        return Err[int32]("media runtime: publish event cid mismatch")
    if MediaLifecycleEventQueueFindPublish(queue, event.eventCid) >= 0:
        return Err[int32]("media runtime: duplicate publish event")
    add(queue.publishEvents, event)
    return Ok[int32](queue.publishEvents.len)

fn MediaLifecycleEventQueueEnqueueDelivery(queue: var MediaLifecycleEventQueue,
                                           receipt: MediaDeliveryReceipt): Result[int32] =
    if receipt.schema != MediaAssetLifecycleSchema:
        return Err[int32]("media runtime: delivery receipt schema mismatch")
    if len(receipt.receiptCid) <= 0:
        return Err[int32]("media runtime: missing delivery receipt cid")
    if len(receipt.trace) <= 0:
        return Err[int32]("media runtime: missing delivery receipt trace")
    if !receipt.verified:
        return Err[int32]("media runtime: delivery receipt not verified")
    if receipt.statusCode != MediaDeliveryStatusRemoteMediaReady:
        return Err[int32]("media runtime: delivery receipt status mismatch")
    if receipt.transferredBytes != receipt.mediaBytesReady:
        return Err[int32]("media runtime: delivery receipt transferred bytes mismatch")
    if receipt.announcedBytes <= 0 || receipt.objectCount <= 0 || receipt.dropletCount <= 0:
        return Err[int32]("media runtime: delivery receipt missing announcement metadata")
    if receipt.remoteFetchMs < int64(0) || receipt.openToMediaMs < int64(0):
        return Err[int32]("media runtime: delivery receipt negative timing")
    var canonicalReceipt = receipt
    if receipt.receiptCid != MediaDeliveryReceiptCanonicalCid(canonicalReceipt):
        return Err[int32]("media runtime: delivery receipt cid mismatch")
    if MediaLifecycleEventQueueFindDelivery(queue, receipt.receiptCid) >= 0:
        return Err[int32]("media runtime: duplicate delivery receipt")
    add(queue.deliveryReceipts, receipt)
    return Ok[int32](queue.deliveryReceipts.len)

fn MediaControl(session: var MediaPlaybackSession, request: var MediaControlRequest): Result[MediaControlReceipt] =
    if request.slotId != session.slotId:
        return Err[MediaControlReceipt]("media runtime: control slot mismatch")
    if !MediaAssetControlActionAllowed(request.actionKind):
        return Err[MediaControlReceipt]("media runtime: unsupported control action")
    if !MediaAssetControlActionAllowedForKind(session.kindCode, request.actionKind):
        return Err[MediaControlReceipt]("media runtime: unsupported control action for kind")
    if len(request.guard) <= 0:
        return Err[MediaControlReceipt]("media runtime: missing control guard")
    if len(request.trace) <= 0:
        return Err[MediaControlReceipt]("media runtime: missing control trace")
    let payloadAllowedRes = MediaControlPayloadAllowed(session, request)
    if IsErr(payloadAllowedRes):
        return Err[MediaControlReceipt](Error(payloadAllowedRes))
    let previousState = session.stateCode
    var nextState = session.stateCode
    if request.actionKind == "Play":
        nextState = MediaPlaybackStatePlaying
    elif request.actionKind == "Pause":
        nextState = MediaPlaybackStatePaused
    elif request.actionKind == "Seek":
        nextState = MediaPlaybackStateSeeked
    elif request.actionKind == "EditAsset":
        nextState = MediaPlaybackStateEdited
    elif request.actionKind == "PublishAsset":
        nextState = MediaPlaybackStatePublished
    elif request.actionKind == "OpenAsset":
        nextState = MediaPlaybackStateOpened
    session.stateCode = nextState
    var receipt: MediaControlReceipt
    receipt.slotId = session.slotId
    receipt.assetCid = session.assetCid
    receipt.kindCode = session.kindCode
    receipt.actionKind = request.actionKind
    receipt.payload = request.payload
    receipt.statusCode = MediaControlStatusQueued
    receipt.dispatch = session.eventQueue
    receipt.stateCode = nextState
    receipt.previousStateCode = previousState
    receipt.guard = request.guard
    receipt.trace = strutil.Join([ share(session.trace), "->", share(request.trace)], "")
    receipt.receiptCid = MediaControlReceiptCid(receipt)
    return Ok[MediaControlReceipt](receipt)
