fn MediaAssetSha256Hex(data: rawbytes.Bytes): str =
    let digest = sha256.Sha256Digest(data)
    return rawbytes.BytesToHex(digest)

fn MediaAssetSha256HexText(text: str): str =
    return MediaAssetSha256Hex(rawbytes.BytesFromString(text))

fn MediaLifecycleElapsedMs(startedAtMs: int64, completedAtMs: int64): int64 =
    return completedAtMs - startedAtMs

fn MediaBoolBit(value: bool): str =
    if value:
        return "1"
    return "0"

fn MediaFrameReceiptPreimage(receipt: var MediaFrameReceipt): str =
    return strutil.Join([
        MediaAssetLifecycleSchema,
        "|receipt|Frame|",
        receipt.slotId,
        "|",
        receipt.assetCid,
        "|",
        receipt.manifestCid,
        "|",
        receipt.firstFrameCid,
        "|",
        IntToStr(receipt.bytesReady),
        "|",
        IntToStr(receipt.sourceCode),
        "|",
        MediaBoolBit(receipt.verified),
        "|",
        receipt.textureProvider,
        "|",
        strings.Uint64ToStr(receipt.textureHandle),
        "|",
        MediaBoolBit(receipt.textureReady),
        "|",
        IntToStr(receipt.decodedWidth),
        "x",
        IntToStr(receipt.decodedHeight),
        "|",
        IntToStr(receipt.pixelFormat),
        "|",
        strings.Uint64ToStr(receipt.pixelBufferHandle),
        "|",
        IntToStr(receipt.platformStatusCode),
        "|",
        IntToStr(receipt.platformInfoFlags),
        "|",
        receipt.trace
    ], "")

fn MediaFrameReceiptCid(receipt: var MediaFrameReceipt): str =
    return MediaAssetSha256HexText(MediaFrameReceiptPreimage(receipt))

