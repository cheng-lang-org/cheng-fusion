fn MediaDeliveryReceiptToCsgWebDeliveryReceiptFact(receipt: var media.MediaDeliveryReceipt,
                                                   factId: str): Result[facts.CsgWebMediaDeliveryReceiptFact] =
    if len(factId) <= 0:
        return Err[facts.CsgWebMediaDeliveryReceiptFact]("media csg: missing delivery receipt fact id")
    if receipt.schema != media.MediaAssetLifecycleSchema:
        return Err[facts.CsgWebMediaDeliveryReceiptFact]("media csg: delivery receipt schema mismatch")
    if receipt.receiptKind != "RemoteFrame" &&
       receipt.receiptKind != "RemoteImage" &&
       receipt.receiptKind != "RemoteAudio":
        return Err[facts.CsgWebMediaDeliveryReceiptFact]("media csg: delivery receipt kind must be RemoteFrame, RemoteImage, or RemoteAudio")
    if !receipt.verified:
        return Err[facts.CsgWebMediaDeliveryReceiptFact]("media csg: delivery receipt must be verified")
    return Ok[facts.CsgWebMediaDeliveryReceiptFact](facts.CsgWebMediaDeliveryReceiptFact(
        kind: facts.CsgWebMediaDeliveryReceipt,
        id: factId,
        receiptCid: receipt.receiptCid,
        receiptKind: receipt.receiptKind,
        slotId: receipt.slotId,
        assetCid: receipt.assetCid,
        bundleCid: receipt.bundleCid,
        manifestCid: receipt.manifestCid,
        kindCode: receipt.kindCode,
        transport: receipt.transport,
        publishEventCid: receipt.publishEventCid,
        openEventCid: receipt.openEventCid,
        firstMediaCid: receipt.firstMediaCid,
        sourceCode: receipt.sourceCode,
        announcedBytes: receipt.announcedBytes,
        transferredBytes: receipt.transferredBytes,
        bytesReady: receipt.mediaBytesReady,
        objectCount: receipt.objectCount,
        dropletCount: receipt.dropletCount,
        remoteFetchMs: strings.Int64ToStr(receipt.remoteFetchMs),
        openToMediaMs: strings.Int64ToStr(receipt.openToMediaMs),
        budgetMs: strings.Int64ToStr(receipt.budgetMs),
        statusCode: receipt.statusCode,
        verified: receipt.verified,
        guard: receipt.guard,
        trace: receipt.trace
    ))

fn MediaOpenEventToCsgWebLifecycleEventFact(event: var media.MediaOpenEvent,
                                            factId: str): Result[facts.CsgWebMediaLifecycleEventFact] =
    if len(factId) <= 0:
        return Err[facts.CsgWebMediaLifecycleEventFact]("media csg: missing lifecycle event fact id")
    if event.schema != media.MediaAssetLifecycleSchema:
        return Err[facts.CsgWebMediaLifecycleEventFact]("media csg: open event schema mismatch")
    if len(event.eventCid) <= 0:
        return Err[facts.CsgWebMediaLifecycleEventFact]("media csg: missing open event cid")
    if len(event.payloadSchema) <= 0:
        return Err[facts.CsgWebMediaLifecycleEventFact]("media csg: missing open payload schema")
    return Ok[facts.CsgWebMediaLifecycleEventFact](facts.CsgWebMediaLifecycleEventFact(
        kind: facts.CsgWebMediaLifecycleEvent,
        id: factId,
        eventKind: "OpenAsset",
        eventCid: event.eventCid,
        slotId: event.slotId,
        assetCid: event.assetCid,
        bundleCid: event.bundleCid,
        manifestCid: event.manifestCid,
        kindCode: event.kindCode,
        payloadSchema: event.payloadSchema,
        payload: event.manifestCid,
        transport: event.transport,
        dispatch: event.dispatch,
        guard: event.guard,
        sourceStateCode: event.sourceStateCode,
        resultStateCode: event.resultStateCode,
        statusCode: event.statusCode,
        objectCount: event.objectCount,
        dropletCount: event.dropletCount,
        trace: event.trace
    ))

