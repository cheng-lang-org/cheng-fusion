import std/result
import std/strings
import cheng/core/ir/csg_web_facts as facts
import cheng/moq/media_asset_manifest as media

fn MediaManifestToCsgWebAssetFact(manifest: var media.MediaAssetManifest,
                                  factId: str): Result[facts.CsgWebMediaAssetFact] =
    if len(factId) <= 0:
        return Err[facts.CsgWebMediaAssetFact]("media csg: missing asset fact id")
    let validateRes = media.MediaAssetManifestValidate(manifest)
    if IsErr(validateRes):
        return Err[facts.CsgWebMediaAssetFact](Error(validateRes))

    var objects: facts.CsgWebMediaObjectDescriptor[]
    objects = []
    var i: int32
    for i in i..<manifest.objects.len:
        let item = manifest.objects[i]
        add(objects, facts.CsgWebMediaObjectDescriptor(
            objectIndex: item.objectIndex,
            objectId: item.objectId,
            objectCid: item.objectCid,
            byteOffset: item.byteOffset,
            byteLength: item.byteLength,
            sourceBlockBytes: item.sourceBlockBytes,
            sourceBlockCount: item.sourceBlockCount,
            priority: item.priority
        ))

    var droplets: facts.CsgWebMediaDropletDescriptor[]
    droplets = []
    var d: int32
    for d in d..<manifest.droplets.len:
        let item = manifest.droplets[d]
        var blockIndexes: int32[]
        blockIndexes = []
        var b: int32
        for b in b..<item.blockIndexes.len:
            add(blockIndexes, item.blockIndexes[b])
        add(droplets, facts.CsgWebMediaDropletDescriptor(
            objectIndex: item.objectIndex,
            dropletIndex: item.dropletIndex,
            kindCode: item.kindCode,
            key: item.key,
            peerId: item.peerId,
            cid: item.cid,
            degree: item.degree,
            blockIndexes: blockIndexes
        ))

    return Ok[facts.CsgWebMediaAssetFact](facts.CsgWebMediaAssetFact(
        kind: facts.CsgWebMediaAsset,
        id: factId,
        assetCid: manifest.assetCid,
        bundleCid: manifest.bundleCid,
        mime: manifest.mime,
        kindCode: manifest.kindCode,
        durationMs: strings.Int64ToStr(manifest.durationMs),
        codec: manifest.codec,
        posterCid: manifest.posterCid,
        initSegmentCid: manifest.initSegmentCid,
        initSegmentByteLength: manifest.initSegmentByteLength,
        keyframeIndex: manifest.keyframeIndex,
        transport: manifest.transport,
        fecScheme: manifest.fecScheme,
        contentSignature: manifest.contentSignature,
        catalogCid: manifest.catalogCid,
        catalogKey: manifest.catalogKey,
        rebuildTemplateCid: manifest.rebuildTemplateCid,
        rebuildTemplateKey: manifest.rebuildTemplateKey,
        objectTargetBytes: manifest.objectTargetBytes,
        sourceBlockBytes: manifest.sourceBlockBytes,
        objectCount: manifest.objects.len,
        dropletCount: manifest.droplets.len,
        objects: objects,
        droplets: droplets
    ))

fn MediaSessionToCsgWebPlaybackSlotFact(session: var media.MediaPlaybackSession,
                                       assetFactId: str,
                                       nodeTemplate: str,
                                       stateRef: str): Result[facts.CsgWebMediaPlaybackSlotFact] =
    if len(assetFactId) <= 0:
        return Err[facts.CsgWebMediaPlaybackSlotFact]("media csg: missing asset fact id")
    if len(nodeTemplate) <= 0:
        return Err[facts.CsgWebMediaPlaybackSlotFact]("media csg: missing node template")
    if len(stateRef) <= 0:
        return Err[facts.CsgWebMediaPlaybackSlotFact]("media csg: missing state ref")
    return Ok[facts.CsgWebMediaPlaybackSlotFact](facts.CsgWebMediaPlaybackSlotFact(
        kind: facts.CsgWebMediaPlaybackSlot,
        id: session.slotId,
        slotId: session.slotId,
        assetFact: assetFactId,
        assetCid: session.assetCid,
        manifestCid: session.manifestCid,
        nodeTemplate: nodeTemplate,
        providerKind: session.providerKind,
        stateRef: stateRef,
        decodeProvider: session.decodeProvider,
        textureProvider: session.textureProvider,
        audioProvider: session.audioProvider,
        objectFit: "cover"
    ))

fn MediaControlToCsgWebActionFact(receipt: var media.MediaControlReceipt,
                                  factId: str,
                                  payloadSchema: str): Result[facts.CsgWebMediaControlActionFact] =
    if len(factId) <= 0:
        return Err[facts.CsgWebMediaControlActionFact]("media csg: missing action fact id")
    if len(payloadSchema) <= 0:
        return Err[facts.CsgWebMediaControlActionFact]("media csg: missing payload schema")
    return Ok[facts.CsgWebMediaControlActionFact](facts.CsgWebMediaControlActionFact(
        kind: facts.CsgWebMediaControlAction,
        id: factId,
        slotId: receipt.slotId,
        actionKind: receipt.actionKind,
        payloadSchema: payloadSchema,
        dispatch: "event-queue",
        guard: receipt.guard,
        trace: receipt.trace
    ))

fn MediaControlReceiptToCsgWebControlReceiptFact(receipt: var media.MediaControlReceipt,
                                                 factId: str,
                                                 payloadSchema: str): Result[facts.CsgWebMediaControlReceiptFact] =
    if len(factId) <= 0:
        return Err[facts.CsgWebMediaControlReceiptFact]("media csg: missing control receipt fact id")
    if len(payloadSchema) <= 0:
        return Err[facts.CsgWebMediaControlReceiptFact]("media csg: missing control receipt payload schema")
    if len(receipt.receiptCid) <= 0:
        return Err[facts.CsgWebMediaControlReceiptFact]("media csg: missing control receipt cid")
    return Ok[facts.CsgWebMediaControlReceiptFact](facts.CsgWebMediaControlReceiptFact(
        kind: facts.CsgWebMediaControlReceipt,
        id: factId,
        receiptCid: receipt.receiptCid,
        slotId: receipt.slotId,
        assetCid: receipt.assetCid,
        kindCode: receipt.kindCode,
        actionKind: receipt.actionKind,
        payloadSchema: payloadSchema,
        payload: receipt.payload,
        dispatch: receipt.dispatch,
        sourceStateCode: receipt.previousStateCode,
        resultStateCode: receipt.stateCode,
        statusCode: receipt.statusCode,
        guard: receipt.guard,
        trace: receipt.trace
    ))

fn MediaFrameReceiptToCsgWebFrameReceiptFact(receipt: var media.MediaFrameReceipt,
                                             factId: str,
                                             kindCode: int32): Result[facts.CsgWebMediaFrameReceiptFact] =
    if len(factId) <= 0:
        return Err[facts.CsgWebMediaFrameReceiptFact]("media csg: missing frame receipt fact id")
    if kindCode != media.MediaAssetKindVideo && kindCode != media.MediaAssetKindImage:
        return Err[facts.CsgWebMediaFrameReceiptFact]("media csg: frame receipt kind must be video or image")
    return Ok[facts.CsgWebMediaFrameReceiptFact](facts.CsgWebMediaFrameReceiptFact(
        kind: facts.CsgWebMediaFrameReceipt,
        id: factId,
        receiptKind: "Frame",
        slotId: receipt.slotId,
        assetCid: receipt.assetCid,
        manifestCid: receipt.manifestCid,
        kindCode: kindCode,
        firstFrameCid: receipt.firstFrameCid,
        firstImageCid: "",
        firstAudioCid: "",
        audioDataCid: "",
        bytesReady: receipt.bytesReady,
        initSegmentCid: "",
        initBytesReady: 0,
        sourceCode: receipt.sourceCode,
        verified: receipt.verified,
        textureProvider: receipt.textureProvider,
        textureHandle: strings.Uint64ToStr(receipt.textureHandle),
        textureReady: receipt.textureReady,
        decodedWidth: receipt.decodedWidth,
        decodedHeight: receipt.decodedHeight,
        pixelFormat: receipt.pixelFormat,
        pixelBufferHandle: strings.Uint64ToStr(receipt.pixelBufferHandle),
        audioProvider: "",
        sampleRateHz: 0,
        channelCount: 0,
        bitsPerSample: 0,
        pcmDataOffset: 0,
        pcmDataBytes: 0,
        startedAtMs: strings.Int64ToStr(receipt.startedAtMs),
        elapsedMs: strings.Int64ToStr(receipt.elapsedMs),
        openToMediaMs: strings.Int64ToStr(receipt.openToFrameMs),
        trace: receipt.trace
    ))

