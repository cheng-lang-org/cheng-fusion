fn MediaFrameReceiptToCsgWebReceiptIdentityFact(receipt: var media.MediaFrameReceipt,
                                                receiptFactId: str,
                                                identityFactId: str): Result[facts.CsgWebMediaReceiptIdentityFact] =
    if len(receiptFactId) <= 0:
        return Err[facts.CsgWebMediaReceiptIdentityFact]("media csg: missing frame receipt fact id")
    if len(identityFactId) <= 0:
        return Err[facts.CsgWebMediaReceiptIdentityFact]("media csg: missing frame receipt identity fact id")
    if len(receipt.receiptCid) <= 0:
        return Err[facts.CsgWebMediaReceiptIdentityFact]("media csg: missing frame receipt cid")
    return Ok[facts.CsgWebMediaReceiptIdentityFact](facts.CsgWebMediaReceiptIdentityFact(
        kind: facts.CsgWebMediaReceiptIdentity,
        id: identityFactId,
        receiptFactId: receiptFactId,
        receiptCid: receipt.receiptCid,
        receiptKind: "Frame",
        slotId: receipt.slotId,
        assetCid: receipt.assetCid,
        manifestCid: receipt.manifestCid,
        trace: receipt.trace
    ))

