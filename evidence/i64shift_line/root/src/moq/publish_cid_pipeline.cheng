# P2P distribution architecture, slice 1 — publish-side CID pipeline.
#
# Root cause this closes: on the Android publish path (chengPublishRun ->
# socialPublishEnqueue, mobile_shell_codegen.cheng), the selected video is packed
# straight into a post JSON and handed to the local task store — no ingest ever runs,
# so assetCid/manifestCid/posterCid are never computed. Any remote slot keyed on those
# CIDs then stays a permanent placeholder because the content behind it was never
# content-addressed. materializer's sha256 (materializer.cheng:10815) only ever served
# the static fixture path, never the real publish action.
#
# This module wires the SAME production chunker media_moq_publisher_main.cheng already
# uses for MoQ own-serve (media.MediaIngestVideoFilePin -> fountain.MoqFountainBuild) into
# a standalone, network-free entry point: ingest the selected video + its poster, get back
# real content-addressed identifiers (assetCid=sha256(video bytes), posterCid=sha256(poster
# bytes), manifestCid=sha256(manifest wire) — same sha256 content-addressing scheme the
# static fixture path already uses), and persist them as a JSONL record in the exact
# "taskId\tcontentId\tjson" shape the Android published-task store already writes
# (ts-csg/scripts/unimaker-apk-build.mjs persistPublishedTasksLocked), so the two stores
# stay format-compatible for slice 2's wiring. No network I/O, no serve loop — this is
# strictly the publish-time compute step; MoQ own-serve remains the transport-time step.
import std/result
import std/system
import std/rawbytes
import std/os as os
import std/strutils as strutil
import std/strings
import cheng/moq/media_asset_manifest as media

# Runs the real ingest/chunker against the selected video + its poster. Every field on
# the returned receipt is produced by production code already exercised by
# media_moq_publisher_main.cheng (mediaMoqPublisherIngest) — this function only supplies
# the request from publish-time inputs instead of a hardcoded test fixture.
fn PublishCidPipelineIngest(mp4Path: str, posterPath: str, ownerPeerId: str,
                            remotePeersCsv: str, contentSignature: str,
                            durationMs: int64, codec: str): Result[media.MediaIngestReceipt] =
    if len(mp4Path) <= 0:
        return Err[media.MediaIngestReceipt]("publish cid pipeline: missing video path")
    if len(posterPath) <= 0:
        return Err[media.MediaIngestReceipt]("publish cid pipeline: missing poster path")
    let posterRes = os.ReadFileBytesResult(posterPath)
    if IsErr(posterRes):
        return Err[media.MediaIngestReceipt](strutil.Join(["publish cid pipeline: poster read: ", Error(posterRes)], ""))
    var fileReq: media.MediaVideoFileIngestRequest
    fileReq.sourcePath = mp4Path
    fileReq.ownerPeerId = ownerPeerId
    fileReq.remotePeersCsv = remotePeersCsv
    fileReq.mime = "video/mp4"
    fileReq.durationMs = durationMs
    fileReq.codec = codec
    fileReq.posterBytes = Value(posterRes)
    fileReq.contentSignature = contentSignature
    fileReq.objectTargetBytes = 65536
    fileReq.sourceBlockBytes = 1024
    fileReq.repairDropletCount = 2
    var index = media.MediaLocalIndexInit()
    return media.MediaIngestVideoFilePin(index, fileReq)

# Announce-metadata line: same key=value shape mediaMoqPublisherRun already writes to
# stdout/the network "moq-announce" segment, trimmed to the CID fields a publish action
# needs to hand off. A later publish_serve call reuses these exact CIDs (no re-hash).
fn PublishCidPipelineAnnounceLine(receipt: media.MediaIngestReceipt): str =
    var announce: str = "publish_cid_pipeline announce"
    announce = strutil.Join([ share(announce), " asset_cid=", share(receipt.assetCid)], "")
    announce = strutil.Join([ share(announce), " manifest_cid=", share(receipt.manifestCid)], "")
    announce = strutil.Join([ share(announce), " poster_cid=", share(receipt.posterCid)], "")
    announce = strutil.Join([ share(announce), " object_count=", IntToStr(receipt.objectCount)], "")
    announce = strutil.Join([ share(announce), " droplet_count=", IntToStr(receipt.dropletCount)], "")
    return announce

# cstring -> owned trimmed str. Trim is inlined (same whitespace set as
# strutil.isStripDefaultChar): strutils.strip's cross-module by-value chain
# currently miscompiles heap-backed strings under the in-flight cold backend
# (repro: Strip(CloneStr("  x  ")) returns NUL bytes), so this helper keeps the
# whole chain module-local and owns every copy.
fn PublishCidCStringText(raw: cstring): str =
    if raw == nil:
        return ""
    var owned: str
    owned = system.strFromCStringCopy(raw)
    let n: int32 = len(owned)
    if n <= 0:
        return owned
    var start: int32 = 0
    while start < n:
        let ch: int32 = Int32(owned[start])
        if ch != 32 && ch != 9 && ch != 10 && ch != 13:
            break
        start = start + 1
    if start >= n:
        return ""
    var stop: int32 = n - 1
    while stop >= start:
        let ch2: int32 = Int32(owned[stop])
        if ch2 != 32 && ch2 != 9 && ch2 != 10 && ch2 != 13:
            break
        stop = stop - 1
    if start == 0 && stop == n - 1:
        return owned
    return strings.CloneStrRange(owned, start, stop - start + 1)

@borrows
fn PublishCidPipelineTaskJson(taskId: str, contentId: str, receipt: media.MediaIngestReceipt): str =
    var out: str = "{"
    out = strutil.Join([ share(out), "\"taskId\":\"", strings.CloneStr(taskId), "\","], "")
    out = strutil.Join([ share(out), "\"contentId\":\"", strings.CloneStr(contentId), "\","], "")
    out = strutil.Join([ share(out), "\"assetCid\":\"", share(receipt.assetCid), "\","], "")
    out = strutil.Join([ share(out), "\"manifestCid\":\"", share(receipt.manifestCid), "\","], "")
    out = strutil.Join([ share(out), "\"posterCid\":\"", share(receipt.posterCid), "\","], "")
    out = strutil.Join([ share(out), "\"objectCount\":", IntToStr(receipt.objectCount), ","], "")
    out = strutil.Join([ share(out), "\"dropletCount\":", IntToStr(receipt.dropletCount)], "")
    out = strutil.Join([ share(out), "}"], "")
    return out

# Appends one line to storePath in the exact tab-delimited "taskId\tcontentId\tjson" shape
# persistPublishedTasksLocked (unimaker-apk-build.mjs) already reads/writes, so this store
# is drop-in compatible with the Android published-task file once slice 2 wires the caller.
@borrows
fn PublishCidPipelinePersist(storePath: str, taskId: str, contentId: str,
                             receipt: media.MediaIngestReceipt): Result[bool] =
    if len(storePath) <= 0:
        return Err[bool]("publish cid pipeline: missing store path")
    let json: str = PublishCidPipelineTaskJson(taskId, contentId, receipt)
    let line: str = strutil.Join([strings.CloneStr(taskId), "\t", strings.CloneStr(contentId), "\t", share(json), "\n"], "")
    let openRes = os.OpenAppendResult(storePath)
    if IsErr(openRes):
        return Err[bool](Error(openRes))
    let handle = Value(openRes)
    var lineBytes = rawbytes.BytesFromString(line)
    let writeRes = os.WriteAllBytesResult(handle, lineBytes)
    let closeRes = os.CloseFileResult(handle)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if IsErr(closeRes):
        return Err[bool](Error(closeRes))
    return Ok[bool](true)

# Orchestrator: ingest (real chunker + real CIDs) then persist (real append, no buffering
# that a crash could silently drop). Returns the same receipt the caller would embed into
# the post JSON's assetCid/manifestCid/posterCid fields.
fn PublishCidPipelineRun(storePath: str, taskId: str, contentId: str, mp4Path: str,
                         posterPath: str, ownerPeerId: str, remotePeersCsv: str,
                         contentSignature: str, durationMs: int64,
                         codec: str): Result[media.MediaIngestReceipt] =
    let ingestRes = PublishCidPipelineIngest(mp4Path, posterPath, ownerPeerId, remotePeersCsv,
                                             contentSignature, durationMs, codec)
    if IsErr(ingestRes):
        return Err[media.MediaIngestReceipt](Error(ingestRes))
    let receipt = Value(ingestRes)
    let persistRes = PublishCidPipelinePersist(storePath, taskId, contentId, receipt)
    if IsErr(persistRes):
        return Err[media.MediaIngestReceipt](Error(persistRes))
    return Ok[media.MediaIngestReceipt](receipt)

# @exportc ABI entry: the stable C symbol the Android/Harmony host adapters dlsym to run
# this pipeline synchronously (no network, so no listener/serve thread involved) — mirrors
# the cstring-path convention chengAndroidPublishServeFile/chengMoqHarmonyPublishServeFile
# already use (media_moq_publisher_main.cheng). Result channel is the persisted storePath
# record itself (write-then-verify, same pattern as mediaMoqPublisherWriteReadyCid), so no
# owned-string return/free protocol is needed across the JNI/NAPI boundary. Returns 0 on
# success, a distinct negative rc per failure stage otherwise (never silently swallowed).
@exportc("cheng_publish_cid_pipeline_run")
fn ChengPublishCidPipelineRun(mp4PathRaw: cstring, posterPathRaw: cstring,
                              storePathRaw: cstring, taskIdRaw: cstring,
                              contentIdRaw: cstring, ownerPeerIdRaw: cstring,
                              durationMs: int64, codecRaw: cstring): int32 =
    if mp4PathRaw == nil || posterPathRaw == nil || storePathRaw == nil ||
       taskIdRaw == nil || contentIdRaw == nil || ownerPeerIdRaw == nil || codecRaw == nil:
        return -1
    var mp4Path: str = PublishCidCStringText(mp4PathRaw)
    var posterPath: str = PublishCidCStringText(posterPathRaw)
    var storePath: str = PublishCidCStringText(storePathRaw)
    var taskId: str = PublishCidCStringText(taskIdRaw)
    var contentId: str = PublishCidCStringText(contentIdRaw)
    var ownerPeerId: str = PublishCidCStringText(ownerPeerIdRaw)
    var codec: str = PublishCidCStringText(codecRaw)
    if len(mp4Path) <= 0 || len(posterPath) <= 0 || len(storePath) <= 0 ||
       len(taskId) <= 0 || len(contentId) <= 0:
        return -2
    let runRes = PublishCidPipelineRun(storePath, taskId, strings.CloneStr(contentId), mp4Path, posterPath,
                                       ownerPeerId, "", contentId, durationMs, codec)
    if IsErr(runRes):
        return -3
    return 0
