# #128 root-fix regression lock: bare global-object identifier as the
# sole/last statement of a non-void function, used as an implicit return
# (no field access, no constructor call) -- same shape as the real-world
# blocker src/libp2p/protocols/connectivity/relay/relay.cheng:15-16
# (`fn getRelayConfig(): RelayConfig = relayConfig`).
type
    Cfg =
        x: int32
        y: int64

var gCfg: Cfg = Cfg(x: 0, y: 0)

fn setCfg(c: Cfg) =
    gCfg = c

fn getCfg(): Cfg =
    gCfg
