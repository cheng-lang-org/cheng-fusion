import src/repro_wanfront128/lib

fn main(): int32 =
    var c: lib.Cfg = lib.Cfg(x: 5, y: 7)
    lib.setCfg(c)
    var got: lib.Cfg = lib.getCfg()
    if got.x != 5:
        echo("FAIL x")
        return 1
    if got.y != 7:
        echo("FAIL y")
        return 1
    echo("wanfront128 ok")
    return 0
