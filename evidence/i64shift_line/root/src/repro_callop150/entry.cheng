# #150 root fix regression lock: `name(args) <op> expr` as a statement (used for
# its value as the function's implicit-return tail, mirroring the real
# production shape src/libp2p/crypto/ed25519/ed25519.cheng validateSignatureBytes:
#   fn validateSignatureBytes(data: Bytes): bool = BytesLen(data) == ed25519SignatureSize
# Before the fix parse_statement's call-statement branch consumed only
# `name(args)`, silently dropped the trailing `<op> expr`, and the implicit-
# return backward scan then died "non-void function block unterminated"
# (WAN smoke's ed25519.validateSignatureBytes frontier). Covers ==, !=, <
# and operand-order independence (literal-first already worked pre-fix).

import std/rawbytes

const
    sizeA: int32 = 32
    sizeB: int32 = 64

fn validateEq(data: Bytes): bool =
    BytesLen(data) == sizeA

fn validateNe(data: Bytes): bool =
    BytesLen(data) != sizeB

fn validateLt(data: Bytes): bool =
    BytesLen(data) < sizeB

fn validateLiteralFirst(data: Bytes): bool =
    sizeA == BytesLen(data)

fn main(): int32 =
    let d32: Bytes = BytesAlloc(32)
    let d64: Bytes = BytesAlloc(64)
    if ! validateEq(d32): return 1
    if validateEq(d64): return 2
    if ! validateNe(d32): return 3
    if validateNe(d64): return 4
    if ! validateLt(d32): return 5
    if validateLt(d64): return 6
    if ! validateLiteralFirst(d32): return 7
    echo("callop150 ok")
    return 0
