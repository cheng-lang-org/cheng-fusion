const
    floorThreshold = -10.0
    intFloor = -10

var gThreshold: float64 = 0.0

fn resetViaAssign() =
    gThreshold = floorThreshold

fn getThreshold(): float64 =
    return gThreshold

fn declViaLet(): float64 =
    let x: float64 = floorThreshold
    return x

fn intControlViaAssign(): int32 =
    var y: int32 = 0
    y = intFloor
    return y
