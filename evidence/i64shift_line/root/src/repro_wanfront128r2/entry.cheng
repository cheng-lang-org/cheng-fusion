import src/repro_wanfront128r2/lib

fn main(): int32 =
    lib.resetViaAssign()
    var gotAssign: float64 = lib.getThreshold()
    var gotDecl: float64 = lib.declViaLet()
    var gotInt: int32 = lib.intControlViaAssign()
    if gotAssign != -10.0:
        echo("FAIL assign path float value wrong")
        return 1
    if gotDecl != -10.0:
        echo("FAIL decl path float value wrong")
        return 1
    if gotInt != -10:
        echo("FAIL int control value wrong")
        return 1
    echo("wanfront128r2 ok")
    return 0
