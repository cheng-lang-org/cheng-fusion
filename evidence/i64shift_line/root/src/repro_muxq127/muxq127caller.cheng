import std/result
import repro_muxq127/muxq127lib

fn main(): int32 =
    var q: Queue = initQueue()
    if !queueIsEmpty(q):
        echo("unexpected: fresh queue not empty")
        return 1
    if queueIsFull(q):
        echo("unexpected: fresh queue full")
        return 1

    var i: int32 = 0
    while i < 4:
        var r: Result[bool] = enqueue(q, i)
        if IsErr(r):
            echo(Fmt"unexpected enqueue err at i={i}")
            return 1
        i = i + 1

    if queueIsEmpty(q):
        echo("unexpected: filled queue reports empty")
        return 1
    if !queueIsFull(q):
        echo("unexpected: filled queue does not report full")
        return 1

    var overflow: Result[bool] = enqueue(q, 999)
    if !IsErr(overflow):
        echo("unexpected: enqueue past capacity did not err")
        return 1

    var j: int32 = 0
    while j < 4:
        var d: Result[int32] = dequeue(q)
        if IsErr(d):
            echo(Fmt"unexpected dequeue err at j={j}")
            return 1
        if Value(d) != j:
            echo(Fmt"unexpected dequeue value={Value(d)} want={j}")
            return 1
        j = j + 1

    if !queueIsEmpty(q):
        echo("unexpected: drained queue not empty")
        return 1

    echo("muxq127 ok")
    return 0
