import std/result
module muxq127lib

const
    maxQ = 4

type
    Queue =
        count: int32
        head: int32
        tail: int32
        items: int32[maxQ]

fn initQueue(): Queue =
    Queue(count: 0, head: 0, tail: 0)

# #127 repro shape: bare dot-field comparison as a function's SOLE statement
# (implicit tail return, multi-line body). Before the fix, parse_postfix
# stopped right after `.count` (postfix chains don't span binary operators),
# the leftover `<=`/`>=` token was then swallowed by the unrelated
# "infix operator at statement level: skip rest of line" recovery, and the
# comparison was silently dropped -- leaving parse_fn's implicit-return scan
# with nothing to find (die("non-void function block unterminated")).
fn queueIsEmpty(q: var Queue): bool =
    q.count <= 0

fn queueIsFull(q: var Queue): bool =
    q.count >= maxQ

fn enqueue(q: var Queue, v: int32): Result[bool] =
    if queueIsFull(q):
        return Err[bool]("muxq127lib: queue full")
    q.items[q.tail] = v
    q.tail = (q.tail + 1) % maxQ
    q.count = q.count + 1
    return Ok[bool](true)

fn dequeue(q: var Queue): Result[int32] =
    if queueIsEmpty(q):
        return Err[int32]("muxq127lib: queue empty")
    let v: int32 = q.items[q.head]
    q.head = (q.head + 1) % maxQ
    q.count = q.count - 1
    return Ok[int32](v)
