# #150 sibling-branch guard: the same call-statement dispatch arm also handles
# a bare void call statement with nothing else on the line -- must NOT be
# reparsed (cold_same_line_has_content must correctly report false right
# after the call, at the newline), byte-identical to pre-#150 behavior. The
# neighboring `?` Result-unwrap postfix sub-branch is covered for free by the
# pre-existing tracked fixture src/tests/cold_csg_result_call_q_fixture.cheng
# (bare `Check(1)?` call statements), unchanged rc=2/2 head vs fixed.

fn bump(counter: var int32) =
    counter = counter + 1

fn main(): int32 =
    var counter: int32 = 0
    bump(counter)
    bump(counter)
    if counter != 2: return 1
    echo("callop150 guard ok")
    return 0
