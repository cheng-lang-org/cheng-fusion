import repro_tr119_adv/tr119adv_lib

fn helperI32(b: var Box, v: int32): int32 =
    return b.n + v

fn trapFnI32(b: var Box, v: int32): int32 =
    var wrong: int32 = helperI32(b, v)
    sideEffect(b)

fn main(): int32 =
    var box: Box
    box.n = 10
    var r: int32 = trapFnI32(box, 5)
    echo(Fmt"trap i32 result: box.n={box.n} r={r}")
    return 0
