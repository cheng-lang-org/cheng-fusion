import std/result
import repro_tr119_adv/tr119adv_lib

fn makeBox(n: int32): Box =
    var b: Box
    b.n = n
    return b

fn trapConfusion(v: int32): Result[bool] =
    var stray: Box = makeBox(424242)
    echo("about to fall off the end without a return")

fn main(): int32 =
    var r: Result[bool] = trapConfusion(7)
    echo("about to read err text off confused result")
    echo(Fmt"err text={Error(r)}")
    echo("did not crash")
    return 0
