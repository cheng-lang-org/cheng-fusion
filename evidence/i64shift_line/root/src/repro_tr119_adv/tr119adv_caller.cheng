import std/result
import repro_tr119_adv/tr119adv_lib

fn trapFn(b: var Box, v: int32): Result[bool] =
    var wrong: Result[bool] = addOne(b, v)
    sideEffect(b)

fn main(): int32 =
    var box: Box
    box.n = 10
    var r: Result[bool] = trapFn(box, 5)
    echo(Fmt"trap result: box.n={box.n} ok={Value(r)}")
    return 0
