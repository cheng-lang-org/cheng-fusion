import std/strings

fn main(): int32 =
    var i: int32 = 0
    var total: int32 = 0
    while i < 1000000:
        var s: str = strings.ConcatStr("0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789", "9876543210987654321098765432109876543210987654321098765432109876543210987654321098765432109876543210")
        total = total + s.len
        i = i + 1
    echo(strings.IntToStr(total))
    return 0
