import std/strings

@exportc("leak_fn")
fn leak_fn(n: int32): int32 =
    var acc: str = ""
    var i: int32 = 0
    while i < n:
        acc = strings.ConcatStr(acc, "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789")
        i = i + 1
    return acc.len

fn main(): int32 =
    return 0
