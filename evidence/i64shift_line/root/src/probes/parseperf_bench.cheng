# [PARSE-PERF4] K/F2 重放免窗 A/B 形状计费探针（测量件，不进编译闭包）。
# 9 形状内存生成（e_empty/d_comments/a_fill/f_strings/b_decls/t5000/
# v10000/u_complex/u_dense），逐形状预热 1 次+R rep 计
# ParserBuildExprCallProfileWithExternalPackageRoots 全解析墙钟；
# A/B=双态二进制交错跑+逐形状 min。重建参照：VERIFY_parseperf_bench_append.md
# §三测量件描述（形状生成版原件随克隆灭失）。
import std/os
import std/monotimes
import std/strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/core/lang/parser as parser

@borrows
fn ShapeGenEmpty(parts: var str[], count: int32) =
    for i in 0..<count:
        add(parts, "")

@borrows
fn ShapeGenComments(parts: var str[], count: int32) =
    for i in 0..<count:
        add(parts,
            Fmt"# comment line {i} with filler words for comment shape bench")

@borrows
fn ShapeGenFill(parts: var str[], count: int32) =
    for i in 0..<count:
        add(parts,
            Fmt"let v{i} = value{i} + delta{i} * scale{i} - base{i}")

@borrows
fn ShapeGenStrings(parts: var str[], count: int32) =
    for i in 0..<count:
        if i % 3 == 0:
            add(parts,
                Fmt"let s{i} = \"head {i} mid \\ tail end\"")
        else:
            add(parts,
                Fmt"let q{i} = \"a{i}\\\"b{i}\\\"c\"")

@borrows
fn ShapeGenDecls(parts: var str[], declCount: int32, fillCount: int32) =
    for i in 0..<declCount:
        add(parts, Fmt"fn helper{i}(x: int32, y: int32): int32 =")
        add(parts, Fmt"    let z{i} = x * {i} + y")
        add(parts, Fmt"    z{i}")
    for i in 0..<fillCount:
        add(parts,
            Fmt"let v{i} = value{i} + delta{i} * scale{i} - base{i}")

@borrows
fn ShapeGenAtUnits(parts: var str[], unitCount: int32) =
    for i in 0..<unitCount:
        add(parts, "@borrows")
        add(parts, Fmt"fn unit{i}(x: int32): int32 =")
        add(parts, Fmt"    let y{i} = x + {i}")
        add(parts, Fmt"    y{i}")

@borrows
fn ShapeGenComplex(parts: var str[], unitCount: int32) =
    for i in 0..<unitCount:
        add(parts, Fmt"type Shape{i} = object")
        add(parts, "    fieldA: int32")
        add(parts, "    fieldB: str")
        add(parts, "type")
        add(parts, Fmt"    Cfg{i} = ref object")
        add(parts,
            Fmt"let complex{i} = module{i}.sub{i}.compute{i}(arg{i}, \"txt \\\" q\", other{i})")
        add(parts, Fmt"# note comment {i} inside complex")
        add(parts, Fmt"fn make{i}(src: str): int32 =")
        add(parts,
            Fmt"    let depth{i} = a{i}.b{i}.c{i}.d{i}(x{i})")
        add(parts, Fmt"    depth{i}")

@borrows
fn ShapeGenDense(parts: var str[], count: int32) =
    for i in 0..<count:
        add(parts,
            Fmt"let v{i} = a{i} + b{i} * (c{i} - d{i}) / e{i} % f{i} & g{i} | h{i} ^ j{i}")

@borrows
fn ShapeBuild(kind: str): str =
    var parts: str[]
    if kind == "e_empty":
        ShapeGenEmpty(parts, 10000)
    elif kind == "d_comments":
        ShapeGenComments(parts, 10000)
    elif kind == "a_fill":
        ShapeGenFill(parts, 10000)
    elif kind == "f_strings":
        ShapeGenStrings(parts, 10000)
    elif kind == "b_decls":
        ShapeGenDecls(parts, 1000, 9000)
    elif kind == "t5000":
        ShapeGenAtUnits(parts, 1250)
    elif kind == "v10000":
        ShapeGenAtUnits(parts, 2500)
    elif kind == "u_complex":
        ShapeGenComplex(parts, 1250)
    elif kind == "u_dense":
        ShapeGenDense(parts, 8000)
    else:
        return ""
    return strutil.Join(parts, "\n")

@borrows
fn ShapeRunOnce(worldRoot: str, sourcePath: str, text: str): int64 =
    var externalRoots: parser.ParserExternalPackageRoot[]
    var profile = parser.NormalizedExprCallProfile()
    var err: str = ""
    let beginNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let ok = parser.ParserBuildExprCallProfileWithExternalPackageRoots(
        worldRoot,
        worldRoot,
        externalRoots,
        sourcePath,
        text,
        profile,
        err)
    let endNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let elapsedMs = (endNs - beginNs) / int64(1000000)
    os.WriteLine(os.Get_stderr(),
        Fmt"shape_detail ok={ok} decls={profile.decls.len} lines={profile.lines.len} typeDecls={profile.typeDecls.len} maxDepth={profile.maxQualifiedCallDepth} err={err}")
    return elapsedMs

@borrows
fn ShapeBench(worldRoot: str, kind: str, reps: int32) =
    let text = ShapeBuild(kind)
    if text == "":
        os.WriteLine(os.Get_stderr(), Fmt"shape={kind} unknown")
        return
    let sourcePath = chengpath.PathJoin(worldRoot,
                                        Fmt"src/probes/bench_gen/{kind}.cheng")
    # 预热 1 次（分配/页故障出账），R rep 计费取 min。
    ShapeRunOnce(worldRoot, sourcePath, text)
    var bestMs: int64 = int64(-1)
    for rep in 0..<reps:
        let ms = ShapeRunOnce(worldRoot, sourcePath, text)
        os.WriteLine(os.Get_stderr(), Fmt"shape={kind} rep={rep} ms={ms}")
        if bestMs < int64(0) || ms < bestMs:
            bestMs = ms
    os.WriteLine(os.Get_stderr(), Fmt"shape_min shape={kind} min_ms={bestMs}")

@borrows
fn ShapeKindSelected(subset: str, kind: str): bool =
    if subset == "":
        return true
    var i: int32
    while i + kind.len <= subset.len:
        var j: int32
        var hit = true
        while j < kind.len:
            if subset[i + j] != kind[j]:
                hit = false
                break
            j = j + 1
        if hit:
            return true
        i = i + 1
    return false

fn main(): int32 =
    let argv = os.commandLineParams()
    if argv.len < 2:
        os.WriteLine(os.Get_stderr(),
            "usage: parseperf_bench <world_root> <reps> [shape_subset]")
        return 2
    let worldRoot = strings.CloneStr(argv[0])
    var reps: int32 = 5
    if argv[1].len > 0:
        var argIndex = 0
        reps = 0
        while argIndex < argv[1].len:
            let digitCode = Int32(argv[1][argIndex])
            if digitCode < 48 || digitCode > 57:
                reps = 5
                break
            reps = reps * 10 + (digitCode - 48)
            argIndex = argIndex + 1
    var subset: str = ""
    if argv.len >= 3:
        subset = strings.CloneStr(argv[2])
    var kinds: str[]
    add(kinds, "e_empty")
    add(kinds, "d_comments")
    add(kinds, "a_fill")
    add(kinds, "f_strings")
    add(kinds, "b_decls")
    add(kinds, "t5000")
    add(kinds, "v10000")
    add(kinds, "u_complex")
    add(kinds, "u_dense")
    for kindIndex in 0..<kinds.len:
        let kind = kinds[kindIndex]
        if !ShapeKindSelected(subset, kind):
            continue
        ShapeBench(worldRoot, kind, reps)
    return 0
