import std/result
import std/strings
import std/strutils as strutil

const
    IpPurityDatasetSchema = "cheng.ip_purity.dataset.v1"
    IpPurityScoreSchema = "cheng.ip_purity.score.v1"

type IpPurityNetworkClass = enum
    IpNetworkUnknown
    IpNetworkResidential
    IpNetworkMobile
    IpNetworkDatacenter
    IpNetworkHosting

type IpPurityOrigin = enum
    IpOriginUnknown
    IpOriginNative
    IpOriginBroadcast

type IpPurityEventKind = enum
    IpEventProxy
    IpEventVpn
    IpEventSpam
    IpEventFraud
    IpEventHoneypot
    IpEventBot

type IpPurityEventScope = enum
    IpEventScopeRange
    IpEventScopeAsn

type
    IpPurityPrefixRecord =
        startIpv4: int64
        stopIpv4: int64
        prefixBits: int32
        asn: int32
        countryCode: str
        humanPermille: int32
        botPermille: int32
        prefixRiskPermille: int32
        riskPrior: int32
        source: str
        evidenceHash: str

    IpPurityAsnRecord =
        asn: int32
        organization: str
        networkClass: IpPurityNetworkClass
        origin: IpPurityOrigin
        riskPrior: int32
        source: str
        evidenceHash: str

    IpPurityEventRecord =
        scope: IpPurityEventScope
        startIpv4: int64
        stopIpv4: int64
        asn: int32
        kind: IpPurityEventKind
        severity: int32
        observedDay: int32
        source: str
        evidenceHash: str

    IpPurityDataset =
        schema: str
        generatedDay: int32
        maxEventAgeDays: int32
        eventHalfLifeDays: int32
        sourceSnapshotHash: str
        prefixes: IpPurityPrefixRecord[]
        asns: IpPurityAsnRecord[]
        events: IpPurityEventRecord[]
        datasetHash: str

    IpPurityScoreResult =
        schema: str
        ipText: str
        ipv4: int64
        asn: int32
        riskScore: int32
        purityScore: int32
        band: str
        prefixEvidenceHash: str
        asnEvidenceHash: str
        datasetHash: str
        reasonHash: str
        facts: str[]

fn IpPurityNetworkClassText(value: IpPurityNetworkClass): str =
    if value == IpNetworkResidential:
        return "residential"
    if value == IpNetworkMobile:
        return "mobile"
    if value == IpNetworkDatacenter:
        return "datacenter"
    if value == IpNetworkHosting:
        return "hosting"
    return "unknown"

fn IpPurityOriginText(value: IpPurityOrigin): str =
    if value == IpOriginNative:
        return "native"
    if value == IpOriginBroadcast:
        return "broadcast"
    return "unknown"

fn IpPurityEventKindText(value: IpPurityEventKind): str =
    if value == IpEventVpn:
        return "vpn"
    if value == IpEventSpam:
        return "spam"
    if value == IpEventFraud:
        return "fraud"
    if value == IpEventHoneypot:
        return "honeypot"
    if value == IpEventBot:
        return "bot"
    return "proxy"

fn ipPurityScopeText(value: IpPurityEventScope): str =
    if value == IpEventScopeAsn:
        return "asn"
    return "range"

fn ipPurityAddFact(lines: var str[], key: str, value: str) =
    add(lines, strutil.Join([key, "=", value], ""))

fn ipPurityAddFactI32(lines: var str[], key: str, value: int32) =
    ipPurityAddFact(lines, key, strings.Int64ToStr(int64(value)))

fn ipPurityAddFactI64(lines: var str[], key: str, value: int64) =
    ipPurityAddFact(lines, key, strings.Int64ToStr(value))

fn ipPurityRequirePermille(name: str, value: int32): Result[bool] =
    if value < 0 || value > 1000:
        return Err[bool](strutil.Join(["ip purity: invalid permille: ", name], ""))
    return Ok[bool](true)

fn ipPurityRequireRiskPrior(name: str, value: int32): Result[bool] =
    if value < -100 || value > 100:
        return Err[bool](strutil.Join(["ip purity: invalid risk prior: ", name], ""))
    return Ok[bool](true)

fn ipPurityParseUIntRange(text: str, start: int32, count: int32): Result[int32] =
    if count <= 0:
        return Err[int32]("ip purity: empty ipv4 octet")
    if count > 1 && text[start] == '0':
        return Err[int32]("ip purity: ipv4 octet has leading zero")
    var value: int32
    for i in 0..<count:
        let c: char = text[start + i]
        if c < '0' || c > '9':
            return Err[int32]("ip purity: invalid ipv4 octet")
        value = value * 10 + (int32(c) - int32('0'))
    if value > 255:
        return Err[int32]("ip purity: ipv4 octet out of range")
    return Ok[int32](value)

fn IpPurityParseIPv4(text: str): Result[int64] =
    if len(text) <= 0:
        return Err[int64]("ip purity: empty ip")
    if strings.StrContains(text, ":"):
        return Err[int64]("ip purity: ipv6 scoring is unsupported")
    var start: int32
    var parts: int32
    var out: int64
    for i in 0..len(text):
        var partEnd: bool
        if i == len(text):
            partEnd = true
        elif text[i] == '.':
            partEnd = true
        if partEnd:
            let partRes: Result[int32] = ipPurityParseUIntRange(text, start, i - start)
            if IsErr(partRes):
                return Err[int64](Error(partRes))
            if parts >= 4:
                return Err[int64]("ip purity: too many ipv4 octets")
            out = out * int64(256) + int64(Value(partRes))
            parts = parts + 1
            start = i + 1
    if parts != 4:
        return Err[int64]("ip purity: ipv4 must have four octets")
    return Ok[int64](out)

fn IpPurityFormatIPv4(value: int64): Result[str] =
    if value < int64(0) || value > int64(4294967295):
        return Err[str]("ip purity: ipv4 integer out of range")
    let a: int64 = value / int64(16777216)
    let b: int64 = (value / int64(65536)) % int64(256)
    let c: int64 = (value / int64(256)) % int64(256)
    let d: int64 = value % int64(256)
    return Ok[str](strutil.Join([
        strings.Int64ToStr(a), ".",
        strings.Int64ToStr(b), ".",
        strings.Int64ToStr(c), ".",
        strings.Int64ToStr(d)
    ], ""))

fn ipPurityPow2(exp: int32): int64 =
    if exp < 0 || exp > 32:
        return int64(0)
    var out: int64 = int64(1)
    for _ in 0..<exp:
        out = out * int64(2)
    return out

fn IpPurityMakeCidrPrefix(baseIpv4Text: str,
                          prefixBits: int32,
                          asn: int32,
                          countryCode: str,
                          humanPermille: int32,
                          botPermille: int32,
                          prefixRiskPermille: int32,
                          riskPrior: int32,
                          source: str,
                          evidenceHash: str): Result[IpPurityPrefixRecord] =
    if prefixBits < 0 || prefixBits > 32:
        return Err[IpPurityPrefixRecord]("ip purity: invalid prefix bits")
    let baseRes: Result[int64] = IpPurityParseIPv4(baseIpv4Text)
    if IsErr(baseRes):
        return Err[IpPurityPrefixRecord](Error(baseRes))
    let blockSize: int64 = ipPurityPow2(32 - prefixBits)
    let startValue: int64 = (Value(baseRes) / blockSize) * blockSize
    if startValue != Value(baseRes):
        return Err[IpPurityPrefixRecord]("ip purity: cidr base has host bits")
    var record: IpPurityPrefixRecord
    record.startIpv4 = startValue
    record.stopIpv4 = startValue + blockSize - int64(1)
    record.prefixBits = prefixBits
    record.asn = asn
    record.countryCode = countryCode
    record.humanPermille = humanPermille
    record.botPermille = botPermille
    record.prefixRiskPermille = prefixRiskPermille
    record.riskPrior = riskPrior
    record.source = source
    record.evidenceHash = evidenceHash
    return Ok[IpPurityPrefixRecord](record)

fn ipPurityClassPrior(value: IpPurityNetworkClass): int32 =
    if value == IpNetworkResidential:
        return -18
    if value == IpNetworkMobile:
        return -10
    if value == IpNetworkDatacenter:
        return 26
    if value == IpNetworkHosting:
        return 32
    return 4

fn ipPurityOriginPrior(value: IpPurityOrigin): int32 =
    if value == IpOriginNative:
        return -8
    if value == IpOriginBroadcast:
        return 18
    return 4

fn ipPurityEventBaseWeight(kind: IpPurityEventKind): int32 =
    if kind == IpEventVpn:
        return 24
    if kind == IpEventSpam:
        return 18
    if kind == IpEventFraud:
        return 34
    if kind == IpEventHoneypot:
        return 38
    if kind == IpEventBot:
        return 20
    return 30

fn ipPurityClamp(value: int32, low: int32, high: int32): int32 =
    if value < low:
        return low
    if value > high:
        return high
    return value

fn ipPurityDecayHalfLife(weight: int32, ageDays: int32, halfLifeDays: int32): int32 =
    if weight <= 0:
        return 0
    if ageDays <= 0:
        return weight
    var current: int32 = weight
    let fullHalves: int32 = ageDays / halfLifeDays
    for _ in 0..<fullHalves:
        current = current / 2
    let restDays: int32 = ageDays % halfLifeDays
    let restLoss: int32 = (current * restDays) / (halfLifeDays * 2)
    return current - restLoss

fn ipPurityPrefixPreimage(record: IpPurityPrefixRecord, index: int32): str =
    var lines: str[]
    ipPurityAddFactI32(lines, "prefix_index", index)
    ipPurityAddFactI64(lines, "start_ipv4", record.startIpv4)
    ipPurityAddFactI64(lines, "stop_ipv4", record.stopIpv4)
    ipPurityAddFactI32(lines, "prefix_bits", record.prefixBits)
    ipPurityAddFactI32(lines, "asn", record.asn)
    ipPurityAddFact(lines, "country_code", record.countryCode)
    ipPurityAddFactI32(lines, "human_permille", record.humanPermille)
    ipPurityAddFactI32(lines, "bot_permille", record.botPermille)
    ipPurityAddFactI32(lines, "prefix_risk_permille", record.prefixRiskPermille)
    ipPurityAddFactI32(lines, "risk_prior", record.riskPrior)
    ipPurityAddFact(lines, "source", record.source)
    ipPurityAddFact(lines, "evidence_hash", record.evidenceHash)
    return strutil.Join(lines, "\n")

fn ipPurityAsnPreimage(record: IpPurityAsnRecord, index: int32): str =
    var lines: str[]
    ipPurityAddFactI32(lines, "asn_index", index)
    ipPurityAddFactI32(lines, "asn", record.asn)
    ipPurityAddFact(lines, "organization", record.organization)
    ipPurityAddFact(lines, "network_class", IpPurityNetworkClassText(record.networkClass))
    ipPurityAddFact(lines, "origin", IpPurityOriginText(record.origin))
    ipPurityAddFactI32(lines, "risk_prior", record.riskPrior)
    ipPurityAddFact(lines, "source", record.source)
    ipPurityAddFact(lines, "evidence_hash", record.evidenceHash)
    return strutil.Join(lines, "\n")

fn ipPurityEventPreimage(record: IpPurityEventRecord, index: int32): str =
    var lines: str[]
    ipPurityAddFactI32(lines, "event_index", index)
    ipPurityAddFact(lines, "scope", ipPurityScopeText(record.scope))
    ipPurityAddFactI64(lines, "start_ipv4", record.startIpv4)
    ipPurityAddFactI64(lines, "stop_ipv4", record.stopIpv4)
    ipPurityAddFactI32(lines, "asn", record.asn)
    ipPurityAddFact(lines, "kind", IpPurityEventKindText(record.kind))
    ipPurityAddFactI32(lines, "severity", record.severity)
    ipPurityAddFactI32(lines, "observed_day", record.observedDay)
    ipPurityAddFact(lines, "source", record.source)
    ipPurityAddFact(lines, "evidence_hash", record.evidenceHash)
    return strutil.Join(lines, "\n")

fn IpPurityDatasetPreimage(dataset: IpPurityDataset): str =
    var lines: str[]
    ipPurityAddFact(lines, "schema", dataset.schema)
    ipPurityAddFactI32(lines, "generated_day", dataset.generatedDay)
    ipPurityAddFactI32(lines, "max_event_age_days", dataset.maxEventAgeDays)
    ipPurityAddFactI32(lines, "event_half_life_days", dataset.eventHalfLifeDays)
    ipPurityAddFact(lines, "source_snapshot_hash", dataset.sourceSnapshotHash)
    ipPurityAddFactI32(lines, "prefix_count", int32(dataset.prefixes.len))
    for i in 0..<dataset.prefixes.len:
        add(lines, ipPurityPrefixPreimage(dataset.prefixes[i], int32(i)))
    ipPurityAddFactI32(lines, "asn_count", int32(dataset.asns.len))
    for i in 0..<dataset.asns.len:
        add(lines, ipPurityAsnPreimage(dataset.asns[i], int32(i)))
    ipPurityAddFactI32(lines, "event_count", int32(dataset.events.len))
    for i in 0..<dataset.events.len:
        add(lines, ipPurityEventPreimage(dataset.events[i], int32(i)))
    return strutil.Join(lines, "\n")

fn IpPurityDatasetHash(dataset: IpPurityDataset): str =
    return strings.Sha256(IpPurityDatasetPreimage(dataset))

fn ipPurityValidatePrefix(record: IpPurityPrefixRecord): Result[bool] =
    if record.startIpv4 < int64(0) || record.stopIpv4 > int64(4294967295) || record.startIpv4 > record.stopIpv4:
        return Err[bool]("ip purity: invalid prefix range")
    if record.prefixBits < 0 || record.prefixBits > 32:
        return Err[bool]("ip purity: invalid prefix bits")
    let blockSize: int64 = ipPurityPow2(32 - record.prefixBits)
    if record.stopIpv4 - record.startIpv4 + int64(1) != blockSize:
        return Err[bool]("ip purity: prefix range does not match prefix bits")
    if (record.startIpv4 / blockSize) * blockSize != record.startIpv4:
        return Err[bool]("ip purity: prefix range is not cidr aligned")
    if record.asn <= 0:
        return Err[bool]("ip purity: invalid prefix asn")
    if len(record.countryCode) != 2:
        return Err[bool]("ip purity: invalid country code")
    let humanRes = ipPurityRequirePermille("prefix.human", record.humanPermille)
    if IsErr(humanRes): return humanRes
    let botRes = ipPurityRequirePermille("prefix.bot", record.botPermille)
    if IsErr(botRes): return botRes
    let riskRes = ipPurityRequirePermille("prefix.risk", record.prefixRiskPermille)
    if IsErr(riskRes): return riskRes
    if record.humanPermille + record.botPermille != 1000:
        return Err[bool]("ip purity: prefix human and bot permille must add up to 1000")
    let priorRes = ipPurityRequireRiskPrior("prefix.riskPrior", record.riskPrior)
    if IsErr(priorRes): return priorRes
    if len(record.source) <= 0 || len(record.evidenceHash) <= 0:
        return Err[bool]("ip purity: prefix evidence is required")
    return Ok[bool](true)

fn ipPurityValidateAsn(record: IpPurityAsnRecord): Result[bool] =
    if record.asn <= 0:
        return Err[bool]("ip purity: invalid asn")
    if len(record.organization) <= 0:
        return Err[bool]("ip purity: asn organization is required")
    let priorRes = ipPurityRequireRiskPrior("asn.riskPrior", record.riskPrior)
    if IsErr(priorRes): return priorRes
    if len(record.source) <= 0 || len(record.evidenceHash) <= 0:
        return Err[bool]("ip purity: asn evidence is required")
    return Ok[bool](true)

fn ipPurityValidateEvent(record: IpPurityEventRecord, generatedDay: int32): Result[bool] =
    if record.scope == IpEventScopeRange:
        if record.startIpv4 < int64(0) || record.stopIpv4 > int64(4294967295) || record.startIpv4 > record.stopIpv4:
            return Err[bool]("ip purity: invalid event range")
    else:
        if record.asn <= 0:
            return Err[bool]("ip purity: invalid event asn")
    if record.severity < 1 || record.severity > 100:
        return Err[bool]("ip purity: invalid event severity")
    if record.observedDay <= 0:
        return Err[bool]("ip purity: invalid event day")
    if record.observedDay > generatedDay:
        return Err[bool]("ip purity: future event in dataset")
    if len(record.source) <= 0 || len(record.evidenceHash) <= 0:
        return Err[bool]("ip purity: event evidence is required")
    return Ok[bool](true)

fn IpPurityValidateDataset(dataset: IpPurityDataset): Result[bool] =
    if dataset.schema != IpPurityDatasetSchema:
        return Err[bool]("ip purity: invalid dataset schema")
    if dataset.generatedDay <= 0:
        return Err[bool]("ip purity: invalid generated day")
    if dataset.maxEventAgeDays <= 0:
        return Err[bool]("ip purity: invalid max event age")
    if dataset.eventHalfLifeDays <= 0:
        return Err[bool]("ip purity: invalid event half life")
    if len(dataset.sourceSnapshotHash) < 32:
        return Err[bool]("ip purity: source snapshot hash is required")
    if dataset.prefixes.len <= 0:
        return Err[bool]("ip purity: empty prefix dataset")
    if dataset.asns.len <= 0:
        return Err[bool]("ip purity: empty asn dataset")
    if len(dataset.datasetHash) != 64:
        return Err[bool]("ip purity: dataset hash is required")
    let computedHash = IpPurityDatasetHash(dataset)
    if computedHash != dataset.datasetHash:
        return Err[bool]("ip purity: dataset hash mismatch")
    for i in 0..<dataset.prefixes.len:
        let prefixRes = ipPurityValidatePrefix(dataset.prefixes[i])
        if IsErr(prefixRes):
            return prefixRes
    for i in 0..<dataset.asns.len:
        let asnRes = ipPurityValidateAsn(dataset.asns[i])
        if IsErr(asnRes):
            return asnRes
    for i in 0..<dataset.events.len:
        let eventRes = ipPurityValidateEvent(dataset.events[i], dataset.generatedDay)
        if IsErr(eventRes):
            return eventRes
    return Ok[bool](true)

fn IpPurityFinalizeDataset(dataset: IpPurityDataset): Result[IpPurityDataset] =
    var out = dataset
    out.schema = IpPurityDatasetSchema
    out.datasetHash = IpPurityDatasetHash(out)
    let validRes = IpPurityValidateDataset(out)
    if IsErr(validRes):
        return Err[IpPurityDataset](Error(validRes))
    return Ok[IpPurityDataset](out)

fn ipPurityFindPrefix(dataset: IpPurityDataset, ipv4: int64): Result[IpPurityPrefixRecord] =
    var found: bool
    var best: IpPurityPrefixRecord
    for i in 0..<dataset.prefixes.len:
        let record = dataset.prefixes[i]
        if ipv4 >= record.startIpv4 && ipv4 <= record.stopIpv4:
            if !found || record.prefixBits > best.prefixBits:
                best = record
                found = true
    if !found:
        return Err[IpPurityPrefixRecord]("ip purity: no prefix record for ip")
    return Ok[IpPurityPrefixRecord](best)

fn ipPurityFindAsn(dataset: IpPurityDataset, queryAsn: int32): Result[IpPurityAsnRecord] =
    for i in 0..<dataset.asns.len:
        let record = dataset.asns[i]
        if record.asn == queryAsn:
            return Ok[IpPurityAsnRecord](record)
    return Err[IpPurityAsnRecord]("ip purity: no asn record")

fn ipPurityEventMatches(record: IpPurityEventRecord, ipv4: int64, queryAsn: int32): bool =
    if record.scope == IpEventScopeAsn:
        return record.asn == queryAsn
    return ipv4 >= record.startIpv4 && ipv4 <= record.stopIpv4

fn ipPurityEventContribution(record: IpPurityEventRecord,
                             nowDay: int32,
                             maxAgeDays: int32,
                             halfLifeDays: int32): int32 =
    let ageDays: int32 = nowDay - record.observedDay
    if ageDays < 0:
        return -1
    if ageDays > maxAgeDays:
        return 0
    let raw: int32 = (record.severity * ipPurityEventBaseWeight(record.kind)) / 100
    return ipPurityDecayHalfLife(raw, ageDays, halfLifeDays)

fn IpPurityRiskBand(score: int32): str =
    if score <= 5:
        return "extremely_clean"
    if score <= 25:
        return "clean"
    if score <= 50:
        return "mixed"
    if score <= 75:
        return "risky"
    return "high_risk"

fn IpPurityScoreIPv4(dataset: IpPurityDataset,
                     ipv4: int64,
                     queryAsn: int32,
                     nowDay: int32): Result[IpPurityScoreResult] =
    if ipv4 < int64(0) || ipv4 > int64(4294967295):
        return Err[IpPurityScoreResult]("ip purity: ipv4 integer out of range")
    if queryAsn <= 0:
        return Err[IpPurityScoreResult]("ip purity: invalid query asn")
    if nowDay < dataset.generatedDay:
        return Err[IpPurityScoreResult]("ip purity: score time is before dataset generation")
    let validRes = IpPurityValidateDataset(dataset)
    if IsErr(validRes):
        return Err[IpPurityScoreResult](Error(validRes))
    let prefixRes = ipPurityFindPrefix(dataset, ipv4)
    if IsErr(prefixRes):
        return Err[IpPurityScoreResult](Error(prefixRes))
    let prefix = Value(prefixRes)
    if prefix.asn != queryAsn:
        return Err[IpPurityScoreResult]("ip purity: query asn does not match longest prefix")
    let asnRes = ipPurityFindAsn(dataset, queryAsn)
    if IsErr(asnRes):
        return Err[IpPurityScoreResult](Error(asnRes))
    let asn = Value(asnRes)

    var facts: str[]
    ipPurityAddFact(facts, "schema", IpPurityScoreSchema)
    ipPurityAddFactI64(facts, "ipv4", ipv4)
    ipPurityAddFactI32(facts, "asn", queryAsn)
    ipPurityAddFact(facts, "dataset_hash", dataset.datasetHash)
    ipPurityAddFact(facts, "prefix_evidence_hash", prefix.evidenceHash)
    ipPurityAddFact(facts, "asn_evidence_hash", asn.evidenceHash)
    ipPurityAddFact(facts, "network_class", IpPurityNetworkClassText(asn.networkClass))
    ipPurityAddFact(facts, "origin", IpPurityOriginText(asn.origin))

    var risk: int32 = 14
    risk = risk + prefix.riskPrior
    risk = risk + asn.riskPrior
    risk = risk + ipPurityClassPrior(asn.networkClass)
    risk = risk + ipPurityOriginPrior(asn.origin)
    risk = risk + (prefix.botPermille / 25)
    risk = risk + (prefix.prefixRiskPermille / 25)

    ipPurityAddFactI32(facts, "base_risk", 14)
    ipPurityAddFactI32(facts, "prefix_risk_prior", prefix.riskPrior)
    ipPurityAddFactI32(facts, "asn_risk_prior", asn.riskPrior)
    ipPurityAddFactI32(facts, "bot_permille", prefix.botPermille)
    ipPurityAddFactI32(facts, "prefix_risk_permille", prefix.prefixRiskPermille)

    var matchedEventCount: int32
    var eventScore: int32
    for i in 0..<dataset.events.len:
        let event = dataset.events[i]
        if ipPurityEventMatches(event, ipv4, queryAsn):
            let contribution = ipPurityEventContribution(event,
                                                         nowDay,
                                                         dataset.maxEventAgeDays,
                                                         dataset.eventHalfLifeDays)
            if contribution < 0:
                return Err[IpPurityScoreResult]("ip purity: future event at score time")
            if contribution > 0:
                matchedEventCount = matchedEventCount + 1
                eventScore = eventScore + contribution
                add(facts, strutil.Join([
                    "event=",
                    IpPurityEventKindText(event.kind),
                    ":",
                    event.source,
                    ":",
                    strings.Int64ToStr(int64(contribution)),
                    ":",
                    event.evidenceHash
                ], ""))
    eventScore = ipPurityClamp(eventScore, 0, 80)
    risk = risk + eventScore
    let clampedRisk = ipPurityClamp(risk, 0, 100)

    ipPurityAddFactI32(facts, "matched_event_count", matchedEventCount)
    ipPurityAddFactI32(facts, "event_score", eventScore)
    ipPurityAddFactI32(facts, "risk_score", clampedRisk)
    ipPurityAddFactI32(facts, "purity_score", 100 - clampedRisk)

    let ipTextRes = IpPurityFormatIPv4(ipv4)
    if IsErr(ipTextRes):
        return Err[IpPurityScoreResult](Error(ipTextRes))
    var out: IpPurityScoreResult
    out.schema = IpPurityScoreSchema
    out.ipText = Value(ipTextRes)
    out.ipv4 = ipv4
    out.asn = queryAsn
    out.riskScore = clampedRisk
    out.purityScore = 100 - clampedRisk
    out.band = IpPurityRiskBand(clampedRisk)
    out.prefixEvidenceHash = prefix.evidenceHash
    out.asnEvidenceHash = asn.evidenceHash
    out.datasetHash = dataset.datasetHash
    out.facts = facts
    out.reasonHash = strings.Sha256(strutil.Join(facts, "\n"))
    return Ok[IpPurityScoreResult](out)

fn IpPurityScoreIpText(dataset: IpPurityDataset,
                       ipText: str,
                       queryAsn: int32,
                       nowDay: int32): Result[IpPurityScoreResult] =
    let ipRes = IpPurityParseIPv4(ipText)
    if IsErr(ipRes):
        return Err[IpPurityScoreResult](Error(ipRes))
    return IpPurityScoreIPv4(dataset, Value(ipRes), queryAsn, nowDay)

fn IpPurityScoreResultFacts(result: IpPurityScoreResult): str[] =
    var out = result.facts
    ipPurityAddFact(out, "ip_text", result.ipText)
    ipPurityAddFact(out, "band", result.band)
    ipPurityAddFact(out, "reason_hash", result.reasonHash)
    return out
