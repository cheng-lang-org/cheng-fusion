    appId
    pointerId
    if __csg_mobile_handle_touch_milli(action, xMilli, yMilli):
        __csgMobileRendered = false

@exportc("cheng_app_pause")
fn cheng_app_pause(appId: uint64) =
    appId

@exportc("cheng_app_resume")
fn cheng_app_resume(appId: uint64) =
    appId
