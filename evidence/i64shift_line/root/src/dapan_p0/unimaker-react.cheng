fn __csg_mobile_rebuild_route_targets(document: var web.WebDocument): bool =
    __csgMobileRouteTargetNodeIds = []
    __csgMobileRouteTargetRouteIds = []
    var nodeIndex: int32
    while nodeIndex < document.nodes.len:
        let nodeId = document.nodes[nodeIndex].nodeId
        var routeId: str
        if web.WebDocumentGetAttribute(document, nodeId, "data-csg-route", routeId):
            if !__csg_mobile_register_route_target(nodeId, routeId):
                return false
        nodeIndex = nodeIndex + 1
    return true

