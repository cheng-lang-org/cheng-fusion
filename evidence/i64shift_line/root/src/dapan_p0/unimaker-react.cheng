    __csgMobileLastGpuPresentWidth = width
    __csgMobileLastGpuPresentHeight = height
    if __csgMobileSuppressPresent:
        return true
    __csg_mobile_host_present_gpu_commands(__csgMobileGpuCommandBytes.data, commandCount, scene.WebSceneGpuHostBatchStrideI32, width, height)
    return true

