fn __csg_mobile_prewarm_next_route(): bool =
    __csgMobilePrewarmLastStatus = 0
    return false

@exportc("cheng_app_init")
fn cheng_app_init(): uint64 =
    __csgMobileRendered = false
    __csgMobileRouteIndex = 0
    __csgMobileWindowWidth = 390
    __csgMobileWindowHeight = 844
    __csg_mobile_reset_route_caches()
    return uint64(1)

@exportc("cheng_app_set_window")
fn cheng_app_set_window(appId: uint64, windowId: uint64, physicalW: int32, physicalH: int32, scale: f64) =
    appId
    windowId
    physicalW
    physicalH
    __csgMobileWindowWidth = 390
    __csgMobileWindowHeight = 844
    scale
    __csg_mobile_reset_route_caches()
    __csgMobileRendered = false

@exportc("cheng_app_tick")
fn cheng_app_tick(appId: uint64, deltaTime: f64) =
    appId
    deltaTime
    if __csgMobileRendered:
        return
    let rc: int32 = main()
    __csgMobileLastMainStatus = rc
    if rc == 0:
        __csgMobileRendered = true

@exportc("cheng_app_needs_frame")
fn cheng_app_needs_frame(appId: uint64): int32 =
    appId
    if !__csgMobileRendered:
        return 1
    if __csgMobilePrewarmLastStatus != 0:
        return 0
    if __csg_mobile_has_pending_route_prewarm():
        return 1
    return 0

