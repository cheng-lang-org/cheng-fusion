    if rawbytes.BytesLen(__csgMobileRouteFrameBytes) != totalBytes || rawbytes.BytesLen(__csgMobileRouteFrameReadyBytes) != 1 || __csgMobileRouteCacheFrameBytes != frameBytes:
        rawbytes.BytesFree(__csgMobileRouteFrameBytes)
