                    return __csg_mobile_apply_route(routeId)
                currentNode = layout.WebLayoutParentOf(__csgLayoutTree, currentNode)
        boxIndex = boxIndex - 1
    return false

fn __csg_mobile_handle_touch_milli(action: int32, xMilli: int32, yMilli: int32): bool =
    if action != 1:
        return false
    if __csgMobileWindowWidth <= 0 || __csgMobileWindowHeight <= 0:
        return false
    let xPx: int32 = xMilli
    let yPx: int32 = yMilli
    if yPx >= 759600:
        if xPx < 78000:
            return __csg_mobile_apply_route("home_default")
        if xPx < 156000:
            return __csg_mobile_apply_route("tab_messages")
        if xPx < 234000:
            return __csg_mobile_apply_route("publish_selector")
        if xPx < 312000:
            return __csg_mobile_apply_route("tab_nodes")
        return __csg_mobile_apply_route("tab_profile")
    if yPx >= 33760 && yPx <= 135040:
        if xPx <= 85800:
            return __csg_mobile_apply_route("home_channel_manager_open")
        if xPx >= 273000 && xPx <= 335400:
            return __csg_mobile_apply_route("home_search_open")
        if xPx >= 335400:
            return __csg_mobile_apply_route("home_sort_open")
    if yPx >= 295400 && yPx <= 472640 && xPx >= 140400 && xPx <= 249600:
        return __csg_mobile_apply_route("home_content_detail_open")
    if __csg_mobile_apply_hit_route(xMilli, yMilli):
        return true
    return false

