        __csgMobileRouteFrameBytes = rawbytes.BytesAlloc(totalBytes)
        __csgMobileRouteFrameReadyBytes = rawbytes.BytesAlloc(1)
        __csgMobileRouteCacheFrameBytes = frameBytes
    return rawbytes.BytesLen(__csgMobileRouteFrameBytes) == totalBytes && rawbytes.BytesLen(__csgMobileRouteFrameReadyBytes) == 1

