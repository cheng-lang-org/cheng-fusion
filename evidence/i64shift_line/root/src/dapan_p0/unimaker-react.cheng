fn __csg_mobile_apply_cached_hit_route(xMilli: int32, yMilli: int32): bool =
    var i: int32 = __csgMobileRouteHitMapRouteIndices.len - 1
    while i >= 0:
        if __csgMobileRouteHitMapRouteIndices[i] == __csgMobileRouteIndex:
            let left = __csgMobileRouteHitMapXs[i] * 1000
            let top = __csgMobileRouteHitMapYs[i] * 1000
            let right = (__csgMobileRouteHitMapXs[i] + __csgMobileRouteHitMapWs[i]) * 1000
            let bottom = (__csgMobileRouteHitMapYs[i] + __csgMobileRouteHitMapHs[i]) * 1000
            if xMilli >= left && xMilli < right && yMilli >= top && yMilli < bottom:
                return __csg_mobile_set_route_index(__csgMobileRouteHitMapTargetRouteIndices[i])
