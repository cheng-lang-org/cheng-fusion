fn __csg_mobile_apply_hit_route(xMilli: int32, yMilli: int32): bool =
    if __csg_mobile_apply_cached_hit_route(xMilli, yMilli):
        return true
    var boxIndex: int32 = __csgLayoutTree.boxes.len - 1
    while boxIndex >= 0:
        let box = __csgLayoutTree.boxes[boxIndex]
        let left = box.x * 1000
        let top = box.y * 1000
        let right = (box.x + box.width) * 1000
        let bottom = (box.y + box.height) * 1000
        if box.width > 0 && box.height > 0 && xMilli >= left && xMilli < right && yMilli >= top && yMilli < bottom:
            var currentNode = box.nodeId
            while currentNode != 0:
                var routeId: str
