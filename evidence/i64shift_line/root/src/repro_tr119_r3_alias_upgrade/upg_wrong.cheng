import std/result
import repro_tr119_r3_alias_upgrade/upg_lib

type BoolAlias = Result[bool]
type IntAlias = Result[int32]

fn trapWrongAlias(v: int32): BoolAlias =
    var stray: IntAlias = makeIntResult(v)
    echo("about to fall off the end without a return (alias vs alias wrong type)")

fn main(): int32 =
    var r: BoolAlias = trapWrongAlias(7)
    echo(Fmt"should not reach here ok={Value(r)}")
    return 0
