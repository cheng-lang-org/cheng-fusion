# 观测缓存语义探针 v4 (2026-09-13): 定位到嫌疑人 —— 把**调用结果直接喂给 @borrows 形参**
# (strutil.Split(os.ReadFile(...), '\n')) 在 C 链二进制里拿到的是空串; 先落局部就好。
# 本探针做三件事: A2 复现(内联形态) / A3 对照(落局部) / C1 修好后的 store->lookup 往返。
import std/os as os
import std/strings as strings
import std/strutils as strutil

fn cacheFileFor(cacheDir: str, entryName: str): str =
    return Fmt"{cacheDir}/{entryName}.obs"

@borrows
fn obsCacheLookupInto(cacheDir: str, cacheKey: str, entryName: str, srcSha: str,
                      outCrc: var int32, outRrc: var int32, outScore: var int64,
                      outGolden: var str, outCorrect: var int32, outFp: var str,
                      outHit: var int32) =
    outHit = 0
    outCrc = 0
    outRrc = 0
    outScore = 0
    outGolden = ""
    outCorrect = 0
    outFp = ""
    if len(cacheKey) <= 0:
        return
    let path = cacheFileFor(Fmt"{cacheDir}", Fmt"{entryName}")
    if !os.FileExists(Fmt"{path}"):
        return
    let text = os.ReadFile(Fmt"{path}")
    let lines: str[] = strutil.Split(Fmt"{text}", '\n')
    if len(lines) < 5:
        return
    if Fmt"{lines[0]}" != "cache_v1":
        return
    if Fmt"{lines[1]}" != Fmt"key {cacheKey} {srcSha} {entryName}":
        return
    if Fmt"{lines[2]}" != "obs 0 0":
        return
    let fpLine: str[] = strutil.Split(Fmt"{lines[3]}", ' ')
    let gLine: str[] = strutil.Split(Fmt"{lines[4]}", ' ')
    if len(fpLine) < 2 || len(gLine) < 4:
        return
    outFp = strings.CloneStr(Fmt"{fpLine[1]}")
    outGolden = strings.CloneStr(Fmt"{gLine[1]}")
    outScore = int64(strutil.ParseInt(Fmt"{gLine[2]}"))
    outCorrect = int32(strutil.ParseInt(Fmt"{gLine[3]}"))
    outHit = 1

@borrows
fn obsCacheStore(cacheDir: str, cacheKey: str, entryName: str, srcSha: str,
                 fp: str, golden: str, score: int64, correct: int32) =
    if len(cacheKey) <= 0:
        return
    os.MkdirAll(Fmt"{cacheDir}", 493)
    var parts: str[]
    add(parts, "cache_v1")
    add(parts, Fmt"key {cacheKey} {srcSha} {entryName}")
    add(parts, "obs 0 0")
    add(parts, Fmt"fp {fp}")
    add(parts, Fmt"golden {golden} {strings.Int64ToStr(score)} {correct}")
    os.WriteFile(cacheFileFor(Fmt"{cacheDir}", Fmt"{entryName}"),
                 strutil.Join(parts, "\n"))

fn main(): int32 =
    let dir = "/Users/lbcheng/cheng-lang/.rebuild/patchwork/probe"
    os.MkdirAll(dir, 493)
    let ap = Fmt"{dir}/a.txt"
    os.WriteFile(Fmt"{ap}", "L0\nL1\nL2\nL3\nL4")
    let atext = os.ReadFile(Fmt"{ap}")
    echo(Fmt"A1 hoisted_read_len={len(atext)}")
    let a1: str[] = strutil.Split(Fmt"{atext}", '\n')
    echo(Fmt"A1 hoisted_split_count={len(a1)}")
    let a2: str[] = strutil.Split(os.ReadFile(Fmt"{ap}"), '\n')
    echo(Fmt"A2 inline_split_count={len(a2)}")
    let inlineText = os.ReadFile(Fmt"{ap}")
    let a2b: str[] = strutil.Split(inlineText, '\n')
    echo(Fmt"A2b no_fmt_split_count={len(a2b)}")
    obsCacheStore(Fmt"{dir}", "CARRIER:TOOL", "cell_x", "SRCSHA", "0:deadbeef",
                  "match", int64(10640), 1)
    var hCrc: int32 = 0
    var hRrc: int32 = 0
    var hScore: int64 = 0
    var hGolden: str
    var hCorrect: int32 = 0
    var hFp: str
    var hit: int32 = 0
    obsCacheLookupInto(Fmt"{dir}", "CARRIER:TOOL", "cell_x", "SRCSHA", hCrc,
                       hRrc, hScore, hGolden, hCorrect, hFp, hit)
    echo(Fmt"C1 hit={hit} crc={hCrc} rrc={hRrc}")
    echo(Fmt"C1 fp=[{hFp}] golden=[{hGolden}] score={hScore} correct={hCorrect}")
    return 0
