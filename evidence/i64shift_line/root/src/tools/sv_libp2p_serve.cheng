# F-D feasibility slice: minimal libp2p serve half for the compressed f-loop
# snapshot closure (f1_ball.svblock + ck-{1200,2400,3600}.payload +
# ballbalance.csgworld = 28,897 bytes total).
#
# Same production transport face as the device-verified two-process MoQ smoke
# (media_moq_publisher_main.cheng): quic_transport listener + moq_segment_stream
# negotiate/request/range-serve over ONE stream. The whole closure blob is one
# segment ("sv-closure"); a fetcher requests [0, total) and re-splits by layout.
# No h3/WebTransport plumbing: Libp2pQuicStartListenerNamed pins the localhost
# test-PKI TLS policy internally.

import std/result
import std/strings
import std/rawbytes
import std/os as os
import std/strutils as strutil
import std/cmdline as cmdline
import std/crypto/sha256 as sha256
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream

const svServeSegmentKey = "sv-closure"

fn svServeLog(text: str) =
    os.WriteLine(os.Get_stderr(), text)

# Read one closure part file; loud failure with the path in the error.
fn svServeLoadPart(path: str): Result[rawbytes.Bytes] =
    let readRes = os.ReadFileBytesResult(path)
    if IsErr(readRes):
        return Err[rawbytes.Bytes]("read " + path + ": " + Error(readRes))
    return Ok[rawbytes.Bytes](Value(readRes))

# One accepted connection: discover readable client streams, negotiate, read ONE
# request per stream, serve the requested closure range (WriteRequestedRange FINs
# the write side). Derived handles share acceptConn.pipeIdx — never ConnClose them.
fn svServeConnection(listener: var qtransport.MsQuicTransport,
                     acceptConn: var qconn.Connection,
                     closureBlob: rawbytes.Bytes,
                     segmentKey: str): int32 =
    var servedHere: int32
    var moreStreams = true
    while moreStreams:
        let readableRes = qconn.nativeReadableStreamId(acceptConn, 0)
        if IsErr(readableRes):
            moreStreams = false
            continue
        let streamId: int64 = Value(readableRes)
        svServeLog(strutil.Join([" sv_libp2p_serve: readable stream id=", IntToStr(int32(streamId))], ""))
        var conn = qconn.ConnDeriveStream(acceptConn, streamId, streamId)
        let negotiateRes = moqstream.Libp2pMoqSegmentStreamServerNegotiate(listener, conn)
        if IsErr(negotiateRes):
            svServeLog(" sv_libp2p_serve: negotiate: " + ErrorText(negotiateRes))
            moreStreams = false
            continue
        let requestRes = moqstream.Libp2pMoqSegmentStreamServerReadRequest(conn)
        if IsErr(requestRes):
            svServeLog(" sv_libp2p_serve: request: " + ErrorText(requestRes))
            moreStreams = false
            continue
        let request = Value(requestRes)
        if strings.CloneStr(request.segmentKey) != segmentKey:
            svServeLog(" sv_libp2p_serve: segment key mismatch key=" + share(request.segmentKey))
            moreStreams = false
            continue
        let serveRes = moqstream.Libp2pMoqSegmentStreamServerWriteRequestedRange(conn,
                                                                                 closureBlob,
                                                                                 request)
        if IsErr(serveRes):
            svServeLog(" sv_libp2p_serve: serve: " + ErrorText(serveRes))
            moreStreams = false
            continue
        servedHere = servedHere + 1
        svServeLog(strutil.Join([" sv_libp2p_serve: served key=", share(segmentKey),
                                 " offset=", IntToStr(request.offsetBytes),
                                 " length=", IntToStr(request.lengthBytes)], ""))
    return servedHere

fn main(): int32 =
    var bindHostRaw: str
    let hasBindHost: bool = cmdline.ReadFirstFlagValue("--bind-host", bindHostRaw)
    let bindHost: str = if hasBindHost: bindHostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 0)
    var readyPathRaw: str
    let hasReady: bool = cmdline.ReadFirstFlagValue("--ready-path", readyPathRaw)
    let readyPath: str = if hasReady: readyPathRaw else: ""
    let maxServe: int32 = cmdline.ReadInt32FlagOrDefault("--max-serve", 8)
    let waitMs: int32 = cmdline.ReadInt32FlagOrDefault("--wait-ms", 60000)
    var segmentKeyRaw: str
    let hasKey: bool = cmdline.ReadFirstFlagValue("--segment-key", segmentKeyRaw)
    let segmentKey: str = if hasKey: segmentKeyRaw else: svServeSegmentKey

    # Closure parts in fixed layout order: svblock, ck-1200, ck-2400, ck-3600, world.
    var pathFlags: str[] = ["--svblock", "--ck1200", "--ck2400", "--ck3600", "--world"]
    var partBytes: int32[] = [0, 0, 0, 0, 0]
    var partHashes: str[] = ["", "", "", "", ""]
    var closureBlob = rawbytes.EmptyBytes()
    var totalBytes: int32 = 0
    var i: int32
    while i < 5:
        var pathVar: str
        if !cmdline.ReadFirstFlagValue(pathFlags[i], pathVar):
            svServeLog(" sv_libp2p_serve: missing " + share(pathFlags[i]))
            return 2
        let partRes = svServeLoadPart(pathVar)
        if IsErr(partRes):
            svServeLog(" sv_libp2p_serve: " + ErrorText(partRes))
            return 2
        let part = Value(partRes)
        partBytes[i] = rawbytes.BytesLen(part)
        partHashes[i] = rawbytes.BytesToHex(sha256.Sha256Digest(part))
        closureBlob = rawbytes.BytesConcat(closureBlob, part)
        totalBytes = totalBytes + partBytes[i]
        i = i + 1

    var listener = qtransport.InitMsQuicTransport()
    let startRes = quic_transport.Libp2pQuicStartListenerNamed(listener,
                                                               strings.CloneStr(bindHost),
                                                               port, "localhost")
    if IsErr(startRes):
        svServeLog(" sv_libp2p_serve: listener start: " + ErrorText(startRes))
        return 4
    let boundPort: int32 = Value(startRes)
    if !quic_transport.Libp2pQuicWriteReadyPort(strings.CloneStr(readyPath), boundPort):
        qtransport.Stop(listener)
        svServeLog(" sv_libp2p_serve: ready path write failed")
        return 4

    os.WriteLine(os.Get_stdout(), strutil.Join(["SV_SERVE_READY port=", IntToStr(boundPort),
                                                " bytes=", IntToStr(totalBytes),
                                                " segment_key=", share(segmentKey)], ""))
    i = 0
    while i < 5:
        os.WriteLine(os.Get_stdout(), strutil.Join(["SV_SERVE_PART i=", IntToStr(i),
                                                    " bytes=", IntToStr(partBytes[i]),
                                                    " sha256=", share(partHashes[i])], ""))
        i = i + 1

    var served: int32
    var lastRc: int32 = 0
    while served < maxServe:
        let acceptRes = qtransport.AcceptTimed(listener, waitMs)
        if IsErr(acceptRes):
            let acceptErrText = ErrorText(acceptRes)
            if acceptErrText == "msquic: accept timeout":
                break
            if quic_transport.Libp2pQuicRetryableAcceptError(strings.CloneStr(acceptErrText)):
                os.SleepMs(10)
                continue
            svServeLog(" sv_libp2p_serve: accept: " + strings.CloneStr(acceptErrText))
            lastRc = 5
            break
        var acceptConn = Value(acceptRes)
        let servedHere = svServeConnection(listener, acceptConn, closureBlob,
                                           strings.CloneStr(segmentKey))
        qconn.ConnClose(acceptConn)
        served = served + servedHere
    qtransport.Stop(listener)
    os.WriteLine(os.Get_stdout(), strutil.Join(["SV_SERVE_DONE served=", IntToStr(served),
                                                " bytes=", IntToStr(totalBytes)], ""))
    return lastRc
