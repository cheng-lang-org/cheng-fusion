import std/strings
import std/os
import std/rawbytes
import std/result
import std/cmdline
import cheng/game/assets/semantic_video/reader
import cheng/game/assets/semantic_video/validator
import cheng/game/assets/semantic_video/writer
import cheng/game/assets/semantic_video/source_index

# semantic_pack_report <svblock> <source.mp4>
# E1-lite 存量视频 CSG 语义化「压缩与包体积对比」纯计量 CLI（无编码优化）。
# 验证链: SvValidate → SvResourceCid(源文件字节)==manifest.resCid[0] →
# SvSourceIndexBuild ok → EncodeResource 的 SvResourceCid==manifest.resCid[1];
# resLength[0]/[1] 与实测字节同步核对; 任一不等拒绝 rc=1。
# 计量口径（全实测, 无估计）:
# - duration_sec = totalTicks/timescale, 截断 6 位小数去尾零, 手工拼字符串,
#   禁浮点 (如 22500000/1000000 → "22.5", 14336/12288 → "1.166666")。
# - bitrate_kbps = floor(source_bytes*8*timescale/(totalTicks*1000)), 整数除法向下取整。
# - cold_package_bytes = source_bytes + svblock_bytes (冷包=全部必需依赖)。
# - hot_transfer_bytes = svblock_bytes (源视频已缓存场景的实际新增字节)。
# - overhead_bp_hot = floor(svblock_bytes*10000/source_bytes), bp 基点整数。
# - recovery@pct: T=totalTicks*pct/100; 定位 ≤T 的最近关键帧, 累计该关键帧
#   样本到 T 所在样本的 size 总和 = 需重读字节下界 (无像素解码)。
#   多关键帧跑 25%/50%/75% 三点; 单关键帧三点同值, 结构性只跑 50%。

# 小数字符串: 整数部分 + '.' + 6 位截断小数(去尾零); 全程 int64, 禁浮点。
fn SvPrFormatDuration(totalTicks: int64, timescale: int64): str =
    var whole: int64 = totalTicks / timescale
    var frac: int64 = (totalTicks - whole * timescale) * int64(1000000) /
        timescale
    var fracText: str = strings.Int64ToStr(frac)
    while fracText.len < 6:
        fracText = strings.ConcatStr("0", fracText)
    var keep: int32 = fracText.len
    while keep > 0 && fracText[keep - 1] == '0':
        keep = keep - 1
    var outText: str = strings.Int64ToStr(whole)
    if keep > 0:
        outText = strings.ConcatStr(outText, ".")
        outText = strings.ConcatStr(outText,
            strings.SliceBytes(fracText, 0, keep))
    return outText

fn main(): int32 =
    if cmdline.ParamCount() < 3:
        echo("semantic_pack_report error: usage semantic_pack_report <svblock> <source.mp4>")
        return 1
    let svPath = cmdline.ParamStr(1)
    let srcPath = cmdline.ParamStr(2)
    let svResult = os.ReadFileBytesResult(svPath)
    if result.IsErr(svResult):
        echo("semantic_pack_report error: read svblock failed")
        return 1
    var svBytes = result.Value(svResult)
    let srcResult = os.ReadFileBytesResult(srcPath)
    if result.IsErr(srcResult):
        echo("semantic_pack_report error: read source failed")
        return 1
    var srcBytes = result.Value(srcResult)

    # ---- 验证链 1: svblock validator ok
    var validation = validator.SvValidate(svBytes)
    if !validation.ok:
        echo(strings.ConcatStr("semantic_pack_report error: validate ",
            validation.error))
        return 1
    echo("section=verification")
    echo("validator=ok")

    var decoded = reader.SvReaderDecode(svBytes)
    if !decoded.ok:
        echo(strings.ConcatStr("semantic_pack_report error: decode ",
            decoded.error))
        return 1
    var parsed = reader.SvParseRecords(decoded.lines)
    if !parsed.ok:
        echo(strings.ConcatStr("semantic_pack_report error: parse ",
            parsed.error))
        return 1
    if parsed.records.manifests.len != 1:
        echo("semantic_pack_report error: manifest_count_invalid")
        return 1
    var manifest = parsed.records.manifests[0]
    if manifest.resCid.len < 2 || manifest.resLength.len < 2:
        echo("semantic_pack_report error: manifest_res_arrays_invalid")
        return 1

    # ---- 验证链 2: SvResourceCid(源文件字节) == manifest.resCid[0]
    let srcCid = writer.SvResourceCid(srcBytes)
    if srcCid != manifest.resCid[0]:
        echo("semantic_pack_report error: source_cid_mismatch")
        return 1
    echo("source_cid_match=ok")

    # ---- 验证链 3: SvSourceIndexBuild ok 且 EncodeResource cid == resCid[1]
    var idx = source_index.SvSourceIndexBuild(srcBytes)
    if !idx.ok:
        echo(strings.ConcatStr("semantic_pack_report error: index_build ",
            idx.error))
        return 1
    echo("source_index_build=ok")
    var indexBytes = source_index.SvSourceIndexEncodeResource(idx)
    let idxCid = writer.SvResourceCid(indexBytes)
    if idxCid != manifest.resCid[1]:
        echo("semantic_pack_report error: index_cid_mismatch")
        return 1
    echo("index_cid_match=ok")

    # resLength 平行数组与实测字节核对 (resLength[0]=源文件, [1]=索引资源)。
    let srcLen = int64(rawbytes.BytesLen(srcBytes))
    let idxLen = int64(rawbytes.BytesLen(indexBytes))
    if manifest.resLength[0] != srcLen || manifest.resLength[1] != idxLen:
        echo("semantic_pack_report error: reslength_mismatch")
        return 1
    echo("reslength_match=ok")
    echo(strings.ConcatStr("sourceCid=", srcCid))
    echo(strings.ConcatStr("indexCid=", idxCid))
    echo(strings.ConcatStr("contentId=", manifest.contentId))

    # ---- 计量 (全实测)
    if manifest.tbDen <= 0:
        echo("semantic_pack_report error: timescale_invalid")
        return 1
    if manifest.timeEnd <= 0:
        echo("semantic_pack_report error: total_ticks_invalid")
        return 1
    let svLen = int64(rawbytes.BytesLen(svBytes))
    let timescale = manifest.tbDen
    let totalTicks = manifest.timeEnd
    echo("section=measurement")
    echo(strings.ConcatStr("source_bytes=", strings.Int64ToStr(srcLen)))
    echo(strings.ConcatStr("svblock_bytes=", strings.Int64ToStr(svLen)))
    echo(strings.ConcatStr("index_resource_bytes=", strings.Int64ToStr(idxLen)))
    echo(strings.ConcatStr("timescale=", strings.IntToStr(timescale)))
    echo(strings.ConcatStr("total_ticks=", strings.Int64ToStr(totalTicks)))
    echo(strings.ConcatStr("duration_sec=",
        SvPrFormatDuration(totalTicks, int64(timescale))))
    # 口径: floor(bytes*8*timescale/(ticks*1000)), 纯整数除法, 向下取整。
    let kbps = srcLen * int64(8) * int64(timescale) /
        (totalTicks * int64(1000))
    echo(strings.ConcatStr("bitrate_kbps=", strings.Int64ToStr(kbps)))
    echo(strings.ConcatStr("cold_package_bytes=",
        strings.Int64ToStr(srcLen + svLen)))
    echo(strings.ConcatStr("hot_transfer_bytes=", strings.Int64ToStr(svLen)))
    # 口径: floor(svblock*10000/source), bp 基点整数 (1bp=0.01%)。
    let overheadBp = svLen * int64(10000) / srcLen
    echo(strings.ConcatStr("overhead_bp_hot=", strings.Int64ToStr(overheadBp)))
    echo(strings.ConcatStr("index_timescale=", strings.IntToStr(idx.timescale)))
    echo(strings.ConcatStr("sample_count=", strings.IntToStr(idx.sampleCount)))
    echo(strings.ConcatStr("keyframe_count=",
        strings.IntToStr(idx.keyframeCount)))

    # ---- recovery 单元: seek 重读字节下界 (无像素解码)
    var pcts: int32[]
    if idx.keyframeCount > 1:
        add(pcts, 25)
        add(pcts, 50)
        add(pcts, 75)
    else:
        add(pcts, 50)
    for p in 0..<pcts.len:
        let pct = pcts[p]
        let targetTick = totalTicks * int64(pct) / int64(100)
        var endIdx: int32 = 0
        while endIdx + 1 < idx.sampleCount &&
              idx.pts[endIdx + 1] <= targetTick:
            endIdx = endIdx + 1
        var kfIdx: int32 = -1
        var scan: int32 = 0
        while scan <= endIdx:
            if idx.key[scan] == 1:
                kfIdx = scan
            scan = scan + 1
        if kfIdx < 0:
            echo("semantic_pack_report error: no_keyframe_before_target")
            return 1
        var byteSum: int64 = int64(0)
        var n: int32 = kfIdx
        while n <= endIdx:
            byteSum = byteSum + int64(idx.size[n])
            n = n + 1
        var line: str = strings.ConcatStr("recovery@", strings.IntToStr(pct))
        line = strings.ConcatStr(line, " kf_pts=")
        line = strings.ConcatStr(line, strings.Int64ToStr(idx.pts[kfIdx]))
        line = strings.ConcatStr(line, " samples=")
        line = strings.ConcatStr(line, strings.IntToStr(endIdx - kfIdx + 1))
        line = strings.ConcatStr(line, " bytes=")
        line = strings.ConcatStr(line, strings.Int64ToStr(byteSum))
        echo(line)

    # ---- 固定结论三行 (原样)
    echo("section=conclusion")
    echo("conclusion=playback_no_gain")
    echo("conclusion=hot_increment_is_semantic_only")
    echo("conclusion=fair_ratio_not_claimed")
    return 0
