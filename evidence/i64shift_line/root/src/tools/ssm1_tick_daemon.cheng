# CSG 场景流壳-核接线 daemon (shell-core wiring v1)。
#
# 合同 (campaigns/2026-09-06-csg-asset-pipeline/task_shell_core_wire.md):
# 纯 Cheng 常驻子进程, 由 Swift 宿主壳 (player_proto/PlayerShell.swift) spawn。
# stdin 逐行命令 / stdout 逐行应答, 每条命令恰一行应答。命令集:
#   init <ssm1路径> <bufWindowMs>  StreamManifestLoadFileEmbedded 载包
#                                  + PlayerInit(duration=包总时长)
#   play / pause / rate <x10> / seek <ms>  直调 Player API
#   tick <dtMs>                    PlayerTick, 应答 STATE 状态行
#   quit                           立即退出 rc=0
# 应答: 成功 = OK ...; tick = STATE posMs=<p> playing=<0|1> rate=<r> eof=<0|1>
#       fetch=<i> bufferedTo=<b> pre=<i1,i2,...> (pre 逗号序列可为空);
#       非法命令/参数 = ERR <原因>, 不退出。stdin EOF 退出 rc=0。
# 取舍: 逐行读 stdin 走 os.C_fgetc(os.Get_stdin()) — 仓库现役先例
#       (src/tests/_tmp_reader.cheng, src/core/tooling/lsp_server.cheng
#       LspReadLine), 故选交互 stdin 模式, 不退化为 argv 脚本模式。
import std/os
import std/parseutils
import std/strings
import std/strutils
import std/system
import cheng/game/assets/stream/manifest
import cheng/game/assets/stream/player

# stdout 逐行写 + 立即 flush: 宿主壳逐行阻塞消费, 不能等进程缓冲。
fn DaemonEmit(line: str) =
    os.Write(os.Get_stdout(), line)
    os.Write(os.Get_stdout(), "\n")
    var flushed: int32
    flushed = os.C_fflush(os.Get_stdout())
    if flushed != 0:
        panic("daemon_stdout_flush_failed")

# 读一行 stdin (不含行尾 \n, 剥 \r)。一个字节都没读到 (EOF) 回 false。
fn DaemonReadLine(out: var str): bool =
    var line: str
    line = ""
    var gotAny: bool
    gotAny = false
    for step in 0..<2147483647:
        var ch: int32
        ch = os.C_fgetc(os.Get_stdin())
        if ch < 0:
            break
        gotAny = true
        if ch == 10:
            break
        if ch != 13:
            let temp = strings.CharToStr(system.Char(ch))
            if len(temp) > 0:
                line = strutils.Join([line, temp], "")
    out = line
    return gotAny

# 严格十进制整数: 可带一个前导 '-', 其余必须全数字, 值域 int32。
fn DaemonParseI32(s: str, out: var int32): bool =
    out = 0
    let n = len(s)
    if n <= 0:
        return false
    var start: int32
    start = 0
    if s[0] == '-':
        start = 1
    if start >= n:
        return false
    for i in start..<n:
        if s[i] < '0' || s[i] > '9':
            return false
    return parseutils.ParseInt32(s, out) > 0

# STATE 状态行; pre 逐元素拷贝本地后再格式化 (托管 seq 元素不绑定)。
fn DaemonStateLine(p: player.StreamPlayerQ, fetch: int32, pre: int32[]): str =
    var play01: str
    play01 = "0"
    if p.playing:
        play01 = "1"
    var eof01: str
    eof01 = "0"
    if p.eofLatched:
        eof01 = "1"
    var preParts: str[]
    for i in 0..<pre.len:
        let v = pre[i]
        add(preParts, strings.IntToStr(v))
    let preStr = strutils.Join(preParts, ",")
    return Fmt"STATE posMs={p.posMs} playing={play01} rate={p.rateX10} eof={eof01} fetch={fetch} bufferedTo={p.bufferedToMs} pre={preStr}"

# 执行一条命令; 回 false = quit 退出。m/p 归 main 持有, 经 var 转发
# (先例: manifest.StreamManifestLoadFileEmbedded 把 var 形参转发给
# StreamManifestParseEx)。未 init (p.ok=false) 时一切播放命令显式 ERR。
fn DaemonDispatch(line: str, m: var manifest.StreamManifest,
                  p: var player.StreamPlayerQ): bool =
    let toks = strutils.SplitWhitespace(strutils.Strip(line))
    if toks.len == 0:
        return true
    let cmd = toks[0]
    if cmd == "quit":
        return false
    if cmd == "init":
        if toks.len != 3:
            DaemonEmit("ERR init_needs_path_and_bufwindow")
            return true
        var bufWindowMs: int32
        var bufArg: str
        bufArg = toks[2]
        if !DaemonParseI32(bufArg, bufWindowMs) || bufWindowMs < 0:
            DaemonEmit("ERR bad_bufwindow")
            return true
        var freshM: manifest.StreamManifest
        if !manifest.StreamManifestLoadFileEmbedded(toks[1], freshM):
            DaemonEmit("ERR manifest_load_failed")
            return true
        var freshP: player.StreamPlayerQ
        if !player.PlayerInit(freshP, freshM.totalDurationMs,
                              int64(bufWindowMs)):
            DaemonEmit("ERR player_init_failed")
            return true
        m = freshM
        p = freshP
        let chunks = freshM.chunkCount
        let durMs = freshM.totalDurationMs
        DaemonEmit(Fmt"OK init chunks={chunks} durationMs={durMs} bufWindowMs={bufWindowMs}")
        return true
    if cmd == "play":
        if !p.ok:
            DaemonEmit("ERR not_inited")
            return true
        if !player.PlayerPlay(p):
            DaemonEmit("ERR play_rejected_eof_latched")
            return true
        DaemonEmit("OK play")
        return true
    if cmd == "pause":
        if !p.ok:
            DaemonEmit("ERR not_inited")
            return true
        if !player.PlayerPause(p):
            DaemonEmit("ERR pause_rejected")
            return true
        DaemonEmit("OK pause")
        return true
    if cmd == "rate":
        if !p.ok:
            DaemonEmit("ERR not_inited")
            return true
        if toks.len != 2:
            DaemonEmit("ERR rate_needs_x10")
            return true
        var rateX10: int32
        var rateArg: str
        rateArg = toks[1]
        if !DaemonParseI32(rateArg, rateX10):
            DaemonEmit("ERR bad_rate")
            return true
        if !player.PlayerSetRate(p, rateX10):
            DaemonEmit("ERR rate_out_of_domain")
            return true
        DaemonEmit(Fmt"OK rate={p.rateX10}")
        return true
    if cmd == "seek":
        if !p.ok:
            DaemonEmit("ERR not_inited")
            return true
        if toks.len != 2:
            DaemonEmit("ERR seek_needs_ms")
            return true
        var targetMs: int32
        var seekArg: str
        seekArg = toks[1]
        if !DaemonParseI32(seekArg, targetMs):
            DaemonEmit("ERR bad_seek_ms")
            return true
        if !player.PlayerSeek(p, int64(targetMs)):
            DaemonEmit("ERR seek_out_of_range")
            return true
        DaemonEmit(Fmt"OK seek posMs={p.posMs}")
        return true
    if cmd == "tick":
        if !p.ok:
            DaemonEmit("ERR not_inited")
            return true
        if toks.len != 2:
            DaemonEmit("ERR tick_needs_dtms")
            return true
        var dtMs: int32
        var tickArg: str
        tickArg = toks[1]
        if !DaemonParseI32(tickArg, dtMs):
            DaemonEmit("ERR bad_tick_dtms")
            return true
        var fetch: int32
        var pre: int32[]
        if !player.PlayerTick(p, int64(dtMs), m, fetch, pre):
            DaemonEmit("ERR tick_rejected")
            return true
        DaemonEmit(DaemonStateLine(p, fetch, pre))
        return true
    DaemonEmit(Fmt"ERR unknown_command cmd={cmd}")
    return true

fn main(): int32 =
    var m: manifest.StreamManifest
    var p: player.StreamPlayerQ
    for step in 0..<2147483647:
        var line: str
        if !DaemonReadLine(line):
            break
        if !DaemonDispatch(line, m, p):
            break
    return 0
