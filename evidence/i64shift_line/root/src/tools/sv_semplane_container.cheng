# SvSemPlaneRecord 容器层端到端驱动（2026-09-19, 规范 §9 增补）。
#
# 用法: sv_semplane_container <prep.jsonl> <base.mp4> <out.svblock>
#
# prep.jsonl = tools/sv_plane_records_prep.py 产物（行1 meta + 每轨道一行
# canonical 键序全整数 JSON，字段面与容器行一致）。本驱动只做容器层：
# meta 断言 → reader.SvParseRecords（唯一解析路径，与解码侧同源）装载
# 387 记录 → SvAddSemPlane 走既有 SvWriterEncode 通道（CSGC）→ SvValidate
# → 原子提交落盘 → 从盘重读 → SvReaderDecode 解码 → 三重对拍（CSGC 按
# kind 分节、块内为集合语义，对拍全部序无关）：
#   (1) 行级：解码行多重集合 == 原发射行多重集合（逐记录逐字节）;
#   (2) 逐行重发射恒等：每个 plane 解码行 == 其解析记录的再发射行;
#   (3) 字段级：内存原件 vs 解码记录按 tid 配对逐字段（标量 1 次/字段、
#       数组 1 次/元素）。
# 首差打印 tid+字段并非零退出。二次编码字节确定性断言。
# validator 含 §9 越界/序 gap/参数形状检查。压缩比原始字节数如实列出
# （语义侧不含像素，口径见战役报告）。
import std/cmdline
import std/os
import std/rawbytes
import std/crypto/sha256
import std/strings
import cheng/core/csg_core/json_field as jfield
import cheng/game/assets/semantic_video/schema
import cheng/game/assets/semantic_video/writer
import cheng/game/assets/semantic_video/reader
import cheng/game/assets/semantic_video/validator

type
    SvDriverMeta =
        ok: bool
        error: str
        recordCount: int32
        frameCount: int32
        rgbBytes: int64

    SvDriverLoad =
        ok: bool
        error: str
        recordCount: int32
        frameCount: int32
        rgbBytes: int64
        recs: schema.SvSemPlaneRec[]

    SvDriverCmp =
        ok: bool
        tid: int32
        field: str
        checked: int64

fn PlaneEmit(line: str) =
    os.Write(os.Get_stdout(), line)
    os.Write(os.Get_stdout(), "\n")
    var flushed: int32
    flushed = os.C_fflush(os.Get_stdout())
    if flushed != 0:
        panic("svsemplane_stdout_flush_failed")

@borrows
fn PlaneBytesEqual(a: rawbytes.Bytes, b: rawbytes.Bytes): bool =
    let n = rawbytes.BytesLen(a)
    if n != rawbytes.BytesLen(b):
        return false
    for i in 0..<n:
        if rawbytes.BytesGet(a, i) != rawbytes.BytesGet(b, i):
            return false
    return true

@borrows
fn PlaneCmpFail(tid: int32, field: str): SvDriverCmp =
    var out: SvDriverCmp
    out.tid = tid
    out.field = strings.CloneStr(field)
    return out

@borrows
fn PlaneCmpOk(): SvDriverCmp =
    var out: SvDriverCmp
    out.ok = true
    return out

@borrows
fn PlaneSplitLines(text: str): str[] =
    var out: str[]
    var start: int32 = 0
    for i in 0..<text.len:
        if text[i] == '\n':
            add(out, strings.CloneStr(
                strings.SliceBytes(text, start, i - start)))
            start = i + 1
    if start < text.len:
        add(out, strings.CloneStr(
            strings.SliceBytes(text, start, text.len - start)))
    return out

@borrows
fn PlaneParseMeta(line: str): SvDriverMeta =
    var out: SvDriverMeta
    let kind = jfield.CsgCoreJsonTopStringField(line, "kind")
    if !kind.found || kind.value != "sv_plane_records_prep::v1":
        out.error = strings.CloneStr("plane_prep_meta_kind")
        return out
    let countParsed = reader.SvParseI32(
        reader.SvFieldRaw(line, "recordCount"))
    if !countParsed.ok || countParsed.value < 1:
        out.error = strings.CloneStr("plane_prep_meta_record_count")
        return out
    out.recordCount = countParsed.value
    let framesParsed = reader.SvParseI32(
        reader.SvFieldRaw(line, "frameCount"))
    if !framesParsed.ok || framesParsed.value < 1:
        out.error = strings.CloneStr("plane_prep_meta_frame_count")
        return out
    out.frameCount = framesParsed.value
    let rgbParsed = reader.SvParseI64(reader.SvFieldRaw(line, "rgbBytes"))
    if !rgbParsed.ok || rgbParsed.value < 1:
        out.error = strings.CloneStr("plane_prep_meta_rgb_bytes")
        return out
    out.rgbBytes = rgbParsed.value
    out.ok = true
    return out

# 装载：meta 断言 + 记录行走 reader.SvParseRecords（与容器解码同源解析）。
@borrows
fn PlaneLoad(text: str): SvDriverLoad =
    var out: SvDriverLoad
    let lines = PlaneSplitLines(text)
    if lines.len < 2:
        out.error = strings.CloneStr("plane_prep_empty")
        return out
    var meta = PlaneParseMeta(lines[0])
    if !meta.ok:
        out.error = strings.CloneStr(meta.error)
        return out
    out.recordCount = meta.recordCount
    out.frameCount = meta.frameCount
    out.rgbBytes = meta.rgbBytes
    var recLines: str[]
    for i in 1..<lines.len:
        let line = lines[i]
        if line.len == 0:
            continue
        if recLines.len >= out.recordCount:
            out.error = strings.CloneStr("plane_prep_extra_records")
            return out
        add(recLines, strings.CloneStr(line))
    if recLines.len != out.recordCount:
        out.error = strings.CloneStr("plane_prep_record_count_mismatch")
        return out
    var parsed = reader.SvParseRecords(recLines)
    if !parsed.ok:
        out.error = strings.CloneStr(parsed.error)
        return out
    if parsed.records.planes.len != out.recordCount:
        out.error = strings.CloneStr("plane_prep_kind_mismatch")
        return out
    for i in 0..<parsed.records.planes.len:
        if parsed.records.planes[i].tid != i:
            out.error = strings.CloneStr("plane_prep_tid_not_dense")
            return out
    out.recs = parsed.records.planes
    out.ok = true
    return out

# 字段级对拍：orig[j]（下标取）vs dec（借用单记录）。tid 由调用方配对。
# 计数口径：标量 1 次/字段，数组 1 次/元素。
@borrows
fn PlaneCmpRecord(orig: schema.SvSemPlaneRec[],
        dec: schema.SvSemPlaneRec, j: int32): SvDriverCmp =
    var out: SvDriverCmp
    let a = orig[j]
    out.checked = out.checked + int64(1)
    if a.tid != dec.tid:
        return PlaneCmpFail(a.tid, "tid")
    out.checked = out.checked + int64(1)
    if a.tbNum != dec.tbNum:
        return PlaneCmpFail(a.tid, "tbNum")
    out.checked = out.checked + int64(1)
    if a.tbDen != dec.tbDen:
        return PlaneCmpFail(a.tid, "tbDen")
    out.checked = out.checked + int64(1)
    if a.tickStart != dec.tickStart:
        return PlaneCmpFail(a.tid, "tickStart")
    out.checked = out.checked + int64(1)
    if a.tickEnd != dec.tickEnd:
        return PlaneCmpFail(a.tid, "tickEnd")
    out.checked = out.checked + int64(1)
    if a.frameCount != dec.frameCount:
        return PlaneCmpFail(a.tid, "frameCount")
    out.checked = out.checked + int64(1)
    if a.maxAreaPx != dec.maxAreaPx:
        return PlaneCmpFail(a.tid, "maxAreaPx")
    out.checked = out.checked + int64(1)
    if a.meanAreaM1 != dec.meanAreaM1:
        return PlaneCmpFail(a.tid, "meanAreaM1")
    out.checked = out.checked + int64(1)
    if a.meanDepthM1 != dec.meanDepthM1:
        return PlaneCmpFail(a.tid, "meanDepthM1")
    out.checked = out.checked + int64(1)
    if a.pathLenM2 != dec.pathLenM2:
        return PlaneCmpFail(a.tid, "pathLenM2")
    out.checked = out.checked + int64(1)
    if a.colorR != dec.colorR:
        return PlaneCmpFail(a.tid, "colorR")
    out.checked = out.checked + int64(1)
    if a.colorG != dec.colorG:
        return PlaneCmpFail(a.tid, "colorG")
    out.checked = out.checked + int64(1)
    if a.colorB != dec.colorB:
        return PlaneCmpFail(a.tid, "colorB")
    out.checked = out.checked + int64(1)
    if a.colorSamples != dec.colorSamples:
        return PlaneCmpFail(a.tid, "colorSamples")
    out.checked = out.checked + int64(1)
    if a.confBp != dec.confBp:
        return PlaneCmpFail(a.tid, "confBp")
    out.checked = out.checked + int64(1)
    if a.colorDef != dec.colorDef:
        return PlaneCmpFail(a.tid, "colorDef")
    out.checked = out.checked + int64(1)
    if a.confDef != dec.confDef:
        return PlaneCmpFail(a.tid, "confDef")
    out.checked = out.checked + int64(1)
    if a.method != dec.method:
        return PlaneCmpFail(a.tid, "method")
    out.checked = out.checked + int64(1)
    if a.sourceClass != dec.sourceClass:
        return PlaneCmpFail(a.tid, "sourceClass")
    if a.cxM2.len != dec.cxM2.len:
        return PlaneCmpFail(a.tid, "cxM2.len")
    for i in 0..<a.cxM2.len:
        out.checked = out.checked + int64(1)
        if a.cxM2[i] != dec.cxM2[i]:
            return PlaneCmpFail(a.tid, "cxM2")
    if a.cyM2.len != dec.cyM2.len:
        return PlaneCmpFail(a.tid, "cyM2.len")
    for i in 0..<a.cyM2.len:
        out.checked = out.checked + int64(1)
        if a.cyM2[i] != dec.cyM2[i]:
            return PlaneCmpFail(a.tid, "cyM2")
    if a.areaPx.len != dec.areaPx.len:
        return PlaneCmpFail(a.tid, "areaPx.len")
    for i in 0..<a.areaPx.len:
        out.checked = out.checked + int64(1)
        if a.areaPx[i] != dec.areaPx[i]:
            return PlaneCmpFail(a.tid, "areaPx")
    if a.paramFrames.len != dec.paramFrames.len:
        return PlaneCmpFail(a.tid, "paramFrames.len")
    for i in 0..<a.paramFrames.len:
        out.checked = out.checked + int64(1)
        if a.paramFrames[i] != dec.paramFrames[i]:
            return PlaneCmpFail(a.tid, "paramFrames")
    if a.paramA.len != dec.paramA.len:
        return PlaneCmpFail(a.tid, "paramA.len")
    for i in 0..<a.paramA.len:
        out.checked = out.checked + int64(1)
        if a.paramA[i] != dec.paramA[i]:
            return PlaneCmpFail(a.tid, "paramA")
    if a.paramB.len != dec.paramB.len:
        return PlaneCmpFail(a.tid, "paramB.len")
    for i in 0..<a.paramB.len:
        out.checked = out.checked + int64(1)
        if a.paramB[i] != dec.paramB[i]:
            return PlaneCmpFail(a.tid, "paramB")
    if a.paramC.len != dec.paramC.len:
        return PlaneCmpFail(a.tid, "paramC.len")
    for i in 0..<a.paramC.len:
        out.checked = out.checked + int64(1)
        if a.paramC[i] != dec.paramC[i]:
            return PlaneCmpFail(a.tid, "paramC")
    out.ok = true
    return out

@borrows
fn PlaneCmpAll(orig: schema.SvSemPlaneRec[],
        dec: schema.SvSemPlaneRec[]): SvDriverCmp =
    var out: SvDriverCmp
    if orig.len != dec.len:
        out.field = strings.CloneStr("record_count")
        return out
    # 块内集合语义：按 tid 配对（prep/装载侧已证 tid==下标密度）。
    for i in 0..<dec.len:
        var one = PlaneCmpRecord(orig, dec[i], dec[i].tid)
        out.checked = out.checked + one.checked
        if !one.ok:
            out.tid = one.tid
            out.field = strings.CloneStr(one.field)
            return out
    out.ok = true
    return out

type
    SvDriverRun =
        ok: bool
        error: str
        records: int32
        fields: int64
        factCount: int32
        containerBytes: int32
        containerSha: str
        contentId: str
        baseLen: int32
        baseCid: str
        rgbBytes: int64
        frameCount: int32
        ignoredExt: int32

@borrows
fn PlaneRunFail(error: str): SvDriverRun =
    var out: SvDriverRun
    out.error = strings.CloneStr(error)
    return out

# 容器层全链（@borrows 域，convert.SvConvert 同形）：构块 → 编码 → 校验 →
# 原子提交 → 盘上回读 → 解码 → 三重对拍。
@borrows
fn PlaneRun(prepText: str, baseBytes: rawbytes.Bytes,
        outPath: str): SvDriverRun =
    var loaded = PlaneLoad(prepText)
    if !loaded.ok:
        return PlaneRunFail(loaded.error)

    let baseLen = rawbytes.BytesLen(baseBytes)
    let baseCid = writer.SvResourceCid(baseBytes)

    # === 构造记录块: manifest + 387 平面记录 ===
    var set = writer.SvLineSetInit()
    var manifest: schema.SvManifestRec
    add(manifest.caps, strings.CloneStr(schema.SvCapCommonCore))
    add(manifest.resCid, strings.CloneStr(baseCid))
    add(manifest.resLength, int64(baseLen))
    add(manifest.resType, strings.CloneStr("video/mp4"))
    manifest.tbNum = 1
    manifest.tbDen = 10
    manifest.timeStart = int64(0)
    manifest.timeEnd = int64(loaded.frameCount)
    manifest.entrySnapshot = strings.CloneStr("")
    let preLine = schema.SvManifestLine(manifest)
    manifest.contentId = writer.SvContentCid(preLine)
    writer.SvAddManifest(set, manifest)
    for i in 0..<loaded.recs.len:
        writer.SvAddSemPlane(set, loaded.recs[i])
    var emittedLines: str[]
    for i in 0..<set.lines.len:
        add(emittedLines, strings.CloneStr(set.lines[i]))

    # === 编码（同 set 二次按值传编码器是当前编译器不支持形态，
    # 确定性由两次独立运行 sha256 一致证明，见战役报告） ===
    var encoded1 = writer.SvWriterEncode(set)
    if !encoded1.ok:
        return PlaneRunFail(encoded1.error)

    # === validator（§2/§4/§9 全量规则） ===
    var validation = validator.SvValidate(encoded1.bytes)
    if !validation.ok:
        return PlaneRunFail(validation.error)

    # === 原子提交 + 盘上回读 ===
    let commitError = writer.SvWriterCommit(encoded1.bytes, outPath)
    if commitError.len > 0:
        return PlaneRunFail(commitError)
    var diskRes = os.ReadFileBytesResult(outPath)
    if IsErr(diskRes):
        return PlaneRunFail("reread_failed")
    var diskBytes = Value(diskRes)
    defer:
        rawbytes.BytesFree(diskBytes)
    if !PlaneBytesEqual(encoded1.bytes, diskBytes):
        return PlaneRunFail("disk_bytes_differ")
    var digest = sha256.Sha256Digest(diskBytes)
    defer:
        rawbytes.BytesFree(digest)
    let containerSha = rawbytes.BytesToHex(digest)

    # === 解码 + 三重对拍（块内集合语义，全部序无关） ===
    var decoded = reader.SvReaderDecode(diskBytes)
    if !decoded.ok:
        return PlaneRunFail(decoded.error)
    if decoded.factCount != loaded.recs.len + 1 ||
       decoded.lines.len != emittedLines.len:
        return PlaneRunFail("decode_count_mismatch")
    # (1) 行级多重集合相等：每条解码行恰配对一条原发射行。
    var used: bool[]
    for i in 0..<emittedLines.len:
        add(used, false)
    for i in 0..<decoded.lines.len:
        var found = false
        for j in 0..<emittedLines.len:
            if !used[j] && decoded.lines[i] == emittedLines[j]:
                used[j] = true
                found = true
                break
        if !found:
            return PlaneRunFail("line_set_mismatch")
    var parsed = reader.SvParseRecords(decoded.lines)
    if !parsed.ok:
        return PlaneRunFail(parsed.error)
    if parsed.records.planes.len != loaded.recs.len:
        return PlaneRunFail("plane_record_count_mismatch")
    # (2) 逐行重发射恒等：解码行流中每个 plane 行 == 该行解析出的记录
    # 经 SvSemPlaneLine 再发射的行（发射↔解码互为对拍，序无关）。
    var planeAt: int32 = 0
    for i in 0..<decoded.lines.len:
        let k = jfield.CsgCoreJsonKind(decoded.lines[i])
        if k.found && k.value == schema.SvKindPlane:
            let reline = schema.SvSemPlaneLine(parsed.records.planes[planeAt])
            if reline != decoded.lines[i]:
                return PlaneRunFail("reemit")
            planeAt = planeAt + 1
    if planeAt != parsed.records.planes.len:
        return PlaneRunFail("reemit_count_mismatch")
    # (3) 字段级：内存原件 vs 解码记录按 tid 配对逐字段。
    var cmp = PlaneCmpAll(loaded.recs, parsed.records.planes)
    if !cmp.ok:
        return PlaneRunFail(schema.SvCat3("field_mismatch tid=",
            schema.SvNumI32(cmp.tid), schema.SvCat3(" field=",
                schema.SvCat3(cmp.field, "", ""), "")))

    var out: SvDriverRun
    out.ok = true
    out.records = loaded.recs.len
    out.fields = cmp.checked
    out.factCount = decoded.factCount
    out.containerBytes = rawbytes.BytesLen(diskBytes)
    out.containerSha = strings.CloneStr(containerSha)
    out.contentId = strings.CloneStr(manifest.contentId)
    out.baseLen = baseLen
    out.baseCid = strings.CloneStr(baseCid)
    out.rgbBytes = loaded.rgbBytes
    out.frameCount = loaded.frameCount
    out.ignoredExt = validation.ignoredExtensions.len
    return out

fn main(argc: int32, argv: ptr): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 3:
        PlaneEmit("usage: sv_semplane_container <prep.jsonl> <base.mp4> <out.svblock>")
        return 2
    let prepPath = cmdline.ParamStr(1)
    let basePath = cmdline.ParamStr(2)
    let outPath = cmdline.ParamStr(3)

    var prepRes = os.ReadFileBytesResult(prepPath)
    if IsErr(prepRes):
        PlaneEmit(Fmt"ERR prep_read err={ErrorText(prepRes)}")
        return 1
    var prepBytes = Value(prepRes)
    defer:
        rawbytes.BytesFree(prepBytes)
    var baseRes = os.ReadFileBytesResult(basePath)
    if IsErr(baseRes):
        PlaneEmit(Fmt"ERR base_read err={ErrorText(baseRes)}")
        return 1
    var baseBytes = Value(baseRes)
    defer:
        rawbytes.BytesFree(baseBytes)

    var run = PlaneRun(rawbytes.BytesToString(prepBytes), baseBytes, outPath)
    if !run.ok:
        PlaneEmit(Fmt"ERR {run.error}")
        return 1
    PlaneEmit(Fmt"PLANECONTAINER ok records={run.records} fields={run.fields} factCount={run.factCount} containerBytes={run.containerBytes} containerSha256={run.containerSha} contentId={run.contentId} baseBytes={run.baseLen} baseCid={run.baseCid} rgbBytes={run.rgbBytes} frameCount={run.frameCount} ignoredExtensions={run.ignoredExt}")
    return 0

