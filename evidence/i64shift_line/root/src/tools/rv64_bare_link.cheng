# rv64barelink: standalone bare-metal RISC-V64 exe linker tool.
#
# Wraps ElfRv64LinkExeBare (the pure-Cheng in-compiler bare linker) as a
# host CLI so an obj emitted for riscv64-unknown-none-elf can be linked into
# a QEMU-bootable ET_EXEC image without going through the full driver exe
# pipeline. Usage:
#   rv64barelink <input.obj> <output.exe>
import std/cmdline
import cheng/core/backend/elf_riscv64_linker

fn main(): int32 =
    let argc = cmdline.paramCount()
    echo(Fmt"argc={argc}")
    # paramCount semantics vary by runtime (with/without program name);
    # accept both and read the last two args.
    if argc < 2:
        echo("usage: rv64barelink <input.obj> <output.exe>")
        return 2
    var objs: str[]
    let objPath = Fmt"{cmdline.paramStr(argc - 2)}"
    add(objs, objPath)
    let outPath = Fmt"{cmdline.paramStr(argc - 1)}"
    echo(Fmt"obj={objPath}")
    echo(Fmt"out={outPath}")
    let res = elf_riscv64_linker.ElfRv64LinkExeBare(objs, outPath, "riscv64-unknown-none-elf")
    if !res.ok:
        echo(Fmt"barelink failed: {res.err.msg}")
        return 1
    echo(Fmt"barelink ok: {outPath}")
    return 0
