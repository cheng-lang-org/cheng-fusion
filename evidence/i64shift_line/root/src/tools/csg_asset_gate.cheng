# CSG 资产管线统一门禁 (G2, 纯 Cheng)。
#
# 用法:
#   csg_asset_gate baseline --root:<repoRoot> --compiler:<compilerPath> [--target:<triple>] [--scratch:<dir>]
#
# baseline 判定契约:
#   - 三个冒烟 (A2 统一核心 / B1 媒体 / C1 GLB) 编译 rc=0 且运行 rc=0 才 PASS;
#   - D2 入口 (csg_world_asset_main) 对四类真实样例逐一消费并 rc=0;
#   - 夹具哈希与 capabilities.json 冻结值一致 (shasum 独立计算);
#   - 任一 FAIL 使 baseline 退出码非零, 报告逐项列出, 缺项不得折算为通过。
# 契约注记: str 形参助手一律 @borrows; 借用值入容器先 Fmt 拷贝 owned 值。
import std/cmdline
import std/os
import std/strings
import std/strutils
import std/os_host_process as hostos

fn GateSchema(): str =
    return "cheng.csg.asset.gate.v1"

@borrows
fn appendCheck(name: str, status: str, detail: str) =
    echo(Fmt"check={name} status={status} detail={detail}")

@borrows
fn fileSha256(path: str): str =
    let res = hostos.ExecFileCapture("/usr/bin/shasum",
        ["-a", "256", Fmt"{path}"], [], "", true, 120)
    let out = os.ExecCmdResultOutput(res)
    # shasum 输出: <64hex> <path>; 只取首个空格前的 hex 段。
    var hexLen: int32 = 0
    for i in 0..<out.len:
        if out[i] == " " or out[i] == '\n':
            break
        hexLen = hexLen + 1
    if hexLen < 64:
        return "sha256-unavailable"
    return strings.CloneStrRange(out, 0, 64)

@borrows
fn argValue(args: str[], flag: str): str =
    let prefix = Fmt"--{flag}:"
    for i in 0..<args.len:
        if strings.HasPrefix(args[i], prefix):
            return strings.CloneStrRange(args[i], prefix.len, args[i].len - prefix.len)
    return ""

@borrows
fn runCompile(compiler: str, root: str, target: str, source: str,
              outPath: str, logPath: str): int32 =
    let res = hostos.ExecFileCapture(Fmt"{compiler}",
        ["system-link-exec",
         Fmt"--root:{root}",
         Fmt"--in:{source}",
         "--emit:exe",
         Fmt"--target:{target}",
         Fmt"--out:{outPath}"],
        [], "", true, 600)
    let _childOut = os.WriteFile(Fmt"{logPath}.err", os.ExecCmdResultOutput(res))
    return os.ExecCmdResultExitCode(res)

@borrows
fn runBinary(path: str, args: str[]): int32 =
    # ExecFileCapture 的 args 不含程序名 (与 runCompile 一致)。
    let res = hostos.ExecFileCapture(Fmt"{path}", args, [], "", true, 120)
    return os.ExecCmdResultExitCode(res)

@borrows
fn checkFixtureHash(fixturesDir: str, rel: str, expectSha: str): bool =
    let path = Fmt"{fixturesDir}/{rel}"
    if !os.FileExists(path):
        appendCheck(Fmt"fixture:{rel}", "FAIL", "missing")
        return false
    if expectSha.len != 64:
        appendCheck(Fmt"fixture:{rel}", "INFO", "sha not frozen (capabilities.json)")
        return true
    let got = fileSha256(path)
    if got != expectSha:
        appendCheck(Fmt"fixture:{rel}", "FAIL", Fmt"sha mismatch got={got}")
        return false
    appendCheck(Fmt"fixture:{rel}", "PASS", Fmt"sha256={got}")
    return true

@borrows
fn baselineStage(rootRaw: str, compiler: str, target: str,
                 fixturesDir: str, scratchDir: str): int32 =
    os.MkdirAll(Fmt"{scratchDir}", 493)
    let srcPrefix = Fmt"{rootRaw}/src/tests/"
    var passCount: int32
    var failCount: int32

    let compilerSha = fileSha256(compiler)
    appendCheck("compiler_sha256", "INFO", compilerSha)

    # 冻结夹具哈希核对 (capabilities.json 同源)。
    var hashOk: bool = true
    if !checkFixtureHash(fixturesDir, "glb/static_box.glb",
        "7971b22a8a6707c54bd859cd2d130a61ccca8bd669a0c806dabbc7b6a11e4bef"):
        hashOk = false
    if !checkFixtureHash(fixturesDir, "glb/skin_anim.glb",
        "abee0d0eaa5a8fa27411375f26c2e8b2727bc247edf046ef4493ae9b1f956411"):
        hashOk = false
    if !checkFixtureHash(fixturesDir, "media/sample_440hz_2s.wav",
        "d1a6253c2949075c7f9c0b48818fb40cc4ae8fe3ccd0741ce488e619c688b571"):
        hashOk = false
    if !checkFixtureHash(fixturesDir, "media/sample_cfr_1s.mp4",
        "55c6e702ff45eb285a5704de87415601c913c536b56c972fff1cebc652584e5b"):
        hashOk = false
    if !checkFixtureHash(fixturesDir, "media/sample_vfr_bframes.mp4",
        "9f44a218ee222f24696b8154514f7baf4fc21089164fab634a03b69fb5dc2c3b"):
        hashOk = false
    if hashOk:
        passCount = passCount + 1
    else:
        failCount = failCount + 1

    # 冒烟正例: 编译 rc=0 且运行 rc=0。
    var smokes: str[]
    add(smokes, "csg_asset_a2_smoke.cheng")
    add(smokes, "csg_asset_b1_smoke.cheng")
    add(smokes, "csg_asset_c1_smoke.cheng")
    add(smokes, "csg_asset_b2_smoke.cheng")
    var smokeArgs: str[]
    add(smokeArgs, Fmt"{fixturesDir}")
    add(smokeArgs, Fmt"{scratchDir}/store")

    for i in 0..<smokes.len:
        let name = Fmt"{smokes[i]}"
        let stem = strings.CloneStrRange(name, 0, name.len - 6)
        let source = Fmt"{srcPrefix}{name}"
        let outPath = Fmt"{scratchDir}/{stem}"
        let logPath = Fmt"{scratchDir}/{stem}.compile.log"
        let crc = runCompile(compiler, rootRaw, target, source, outPath, logPath)
        if crc != 0:
            appendCheck(name, "FAIL", Fmt"compile_rc={crc} log={logPath}")
            failCount = failCount + 1
            continue
        var args: str[]
        if stem == "csg_asset_a2_smoke":
            os.MkdirAll(Fmt"{scratchDir}/store", 493)
            add(args, Fmt"{fixturesDir}")
            add(args, Fmt"{scratchDir}/store")
        elif stem == "csg_asset_b2_smoke":
            os.MkdirAll(Fmt"{scratchDir}/b2_store", 493)
            add(args, Fmt"{fixturesDir}")
            add(args, Fmt"{scratchDir}/b2_store")
        else:
            add(args, Fmt"{fixturesDir}")
        let rrc = runBinary(outPath, args)
        if rrc != 0:
            appendCheck(name, "FAIL", Fmt"run_rc={rrc}")
            failCount = failCount + 1
            continue
        appendCheck(name, "PASS", "compile_rc=0 run_rc=0")
        passCount = passCount + 1

    # D2 入口: 对真实样例逐一消费。
    let mainSource = Fmt"{rootRaw}/src/tools/csg_world_asset_main.cheng"
    let mainOut = Fmt"{scratchDir}/csg_world_asset_main"
    let mainLog = Fmt"{scratchDir}/csg_world_asset_main.compile.log"
    let mrc = runCompile(compiler, rootRaw, target, mainSource, mainOut, mainLog)
    if mrc != 0:
        appendCheck("csg_world_asset_main", "FAIL", Fmt"compile_rc={mrc}")
        failCount = failCount + 1
    else:
        var samples: str[]
        add(samples, "glb glb/static_box.glb")
        add(samples, "glb glb/skin_anim.glb")
        add(samples, "wav media/sample_440hz_2s.wav")
        add(samples, "mp4 media/sample_cfr_1s.mp4")
        add(samples, "mp4 media/sample_vfr_bframes.mp4")
        add(samples, "mp4 media/sample_offset_start.mp4")
        add(samples, "observe media/sample_vfr_bframes.mp4")
        add(samples, "observe media/sample_cfr_1s.mp4")
        var mainOk: bool = true
        for i in 0..<samples.len:
            let row = Fmt"{samples[i]}"
            var sp: int32 = -1
            for k in 0..<row.len:
                if row[k] == " "[0]:
                    sp = k
                    break
            let format = strings.CloneStrRange(row, 0, sp)
            let file = strings.CloneStrRange(row, sp + 1, row.len - sp - 1)
            var args: str[]
            add(args, Fmt"{format}")
            add(args, Fmt"{fixturesDir}/{file}")
            if format == "observe":
                os.MkdirAll(Fmt"{scratchDir}/obs_store", 493)
                add(args, Fmt"{scratchDir}/obs_store")
            let rrc = runBinary(mainOut, args)
            if rrc != 0:
                appendCheck(Fmt"consume:{file}", "FAIL", Fmt"run_rc={rrc}")
                mainOk = false
            else:
                appendCheck(Fmt"consume:{file}", "PASS", "run_rc=0")
        if mainOk:
            passCount = passCount + 1
        else:
            failCount = failCount + 1

    echo(Fmt"{GateSchema()} baseline target={target} compiler={compiler}")
    echo(Fmt"checks_pass={passCount} checks_fail={failCount}")
    if failCount > 0:
        echo("baseline: FAIL (缺项不得折算为通过)")
        return 1
    echo("baseline: PASS")
    return 0

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 1:
        echo("usage: csg_asset_gate <stage> [--root:<path>] [--compiler:<path>] [--target:<triple>] [--fixtures:<dir>] [--scratch:<dir>]")
        return 2
    var args: str[]
    let stage = Fmt"{cmdline.paramStr(1)}"
    for i in 2..<(argc + 1):
        add(args, Fmt"{cmdline.paramStr(i)}")
    let root = argValue(args, "root")
    let compiler = argValue(args, "compiler")
    let target = argValue(args, "target")
    let fixtures = argValue(args, "fixtures")
    let scratch = argValue(args, "scratch")
    if stage == "baseline":
        if strutil.Strip(root).len <= 0 || strutil.Strip(compiler).len <= 0:
            echo("baseline requires --root:<repoRoot> and --compiler:<compilerPath>")
            return 2
        let t = if strutil.Strip(target).len > 0: Fmt"{target}" else: "arm64-apple-darwin"
        let f = if strutil.Strip(fixtures).len > 0: Fmt"{fixtures}" else: Fmt"{root}/docs/campaigns/2026-09-06-csg-asset-pipeline/fixtures"
        let s = if strutil.Strip(scratch).len > 0: Fmt"{scratch}" else: Fmt"{root}/artifacts/csg_asset_gate"
        return baselineStage(root, compiler, t, f, s)
    echo(Fmt"stage={stage} status=NOT_IMPLEMENTED (未落地门不得调用或填PASS)")
    return 3
