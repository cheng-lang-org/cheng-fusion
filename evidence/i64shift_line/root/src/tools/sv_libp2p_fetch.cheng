# F-D feasibility slice: minimal libp2p fetch half for the compressed f-loop
# snapshot closure (28,897 bytes). Counterpart of sv_libp2p_serve.cheng.
#
# Dial (quic_transport one-shot client) + moq_segment_stream negotiate + ONE
# length-prefixed request for [0, total) of segment "sv-closure", ReadExact the
# whole closure, re-split by --layout, write each part to --out-dir, and
# hard-assert each part's SHA-256 against --hashes (per-file compare, the same
# hash==identity assertion the moq PWA player uses). Timed: dial ms and
# request->all-bytes ms.
#
# Cheng shape notes (kept at device-verified reference shapes): the request
# goes out via Libp2pMoqSegmentStreamWriteFrame + Libp2pMoqSegmentStreamReadExact
# (the wt_moq client shape) — Libp2pMoqSegmentStreamClientOpen's `var reader`
# var-out definition currently fails cold exact validation against this
# compiler generation; csv entries are cloned to locals before call args.

import std/result
import std/strings
import std/rawbytes
import std/os as os
import std/times as times
import std/strutils as strutil
import std/cmdline as cmdline
import std/crypto/sha256 as sha256
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream

fn svFetchLog(text: str) =
    os.WriteLine(os.Get_stderr(), text)

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 0)
    if port <= 0:
        svFetchLog(" sv_libp2p_fetch: missing --port")
        return 2
    var outDirRaw: str
    let hasOutDir: bool = cmdline.ReadFirstFlagValue("--out-dir", outDirRaw)
    if !hasOutDir:
        svFetchLog(" sv_libp2p_fetch: missing --out-dir")
        return 2
    var layoutRaw: str
    let hasLayout: bool = cmdline.ReadFirstFlagValue("--layout", layoutRaw)
    if !hasLayout:
        svFetchLog(" sv_libp2p_fetch: missing --layout")
        return 2
    var hashesRaw: str
    let hasHashes: bool = cmdline.ReadFirstFlagValue("--hashes", hashesRaw)
    if !hasHashes:
        svFetchLog(" sv_libp2p_fetch: missing --hashes")
        return 2
    var namesRaw: str
    let hasNames: bool = cmdline.ReadFirstFlagValue("--names", namesRaw)
    let namesCsv: str = if hasNames: namesRaw else: "f1_ball.svblock,ck-1200.payload,ck-2400.payload,ck-3600.payload,ballbalance.csgworld"
    let readChunk: int32 = cmdline.ReadInt32FlagOrDefault("--chunk", 8192)

    # Parse the three 5-way csv flags inline (local arrays only; no array out-params).
    var partSizes: int32[] = [0, 0, 0, 0, 0]
    var expectedHashes: str[] = ["", "", "", "", ""]
    var partNames: str[] = ["", "", "", "", ""]
    var totalBytes: int32 = 0
    var badCsv: bool = false

    # Keep the Split source strings owned-and-bound for the whole scope: Split
    # returns views into its source, so a CloneStr temporary released at
    # statement end leaves every part dangling (observed: right lengths, garbage
    # bytes -> ParseInt32 fails).
    let layoutOwned: str = strings.CloneStr(layoutRaw)
    let hashesOwned: str = strings.CloneStr(hashesRaw)
    let namesOwned: str = strings.CloneStr(namesCsv)
    let layoutParts = strutil.Split(layoutOwned, ',')
    let hashParts = strutil.Split(hashesOwned, ',')
    let nameParts = strutil.Split(namesOwned, ',')
    if layoutParts.len != 5:
        badCsv = true
    var i: int32
    while !badCsv && i < 5:
        let sizeText: str = strings.ConcatStr(layoutParts[i], "")
        var sizeVal: int32
        if !cmdline.ParseInt32(sizeText, sizeVal):
            badCsv = true
        else:
            if sizeVal <= 0:
                badCsv = true
            else:
                partSizes[i] = sizeVal
                totalBytes = totalBytes + sizeVal
        i = i + 1

    i = 0
    while !badCsv && i < 5:
        expectedHashes[i] = strings.ConcatStr(hashParts[i], "")
        i = i + 1

    if nameParts.len != 5:
        badCsv = true
    i = 0
    while !badCsv && i < 5:
        partNames[i] = strings.ConcatStr(nameParts[i], "")
        i = i + 1

    if badCsv:
        svFetchLog(" sv_libp2p_fetch: --layout/--hashes/--names must each have 5 valid entries")
        return 2

    # --- dial + negotiate (timed separately from the data request) ---
    let t0: int64 = times.MonotimeMs()
    var client = qtransport.InitMsQuicTransport()
    var conn: qconn.Connection
    let dialRes = quic_transport.Libp2pQuicDialOneShotClientNamed(client, conn,
                                                                  strings.CloneStr(host),
                                                                  port, "localhost")
    if IsErr(dialRes):
        svFetchLog(" sv_libp2p_fetch: dial: " + ErrorText(dialRes))
        return 4
    let dialDoneMs: int64 = times.MonotimeMs()
    # Derive onto the symmetric stream 4 BEFORE negotiating: the bare dial pair is
    # asymmetric (send=0/recv=1), so the server's echo lands on the wrong stream
    # (deterministic deadlock on loopback) — web_scene_media_network_bridge.cheng
    # WebSceneMediaFetchRemoteObject, same serve loop as sv_libp2p_serve.
    var conn4: qconn.Connection = qconn.ConnDeriveStream(conn, 4, 4)
    let negRes = moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, conn4)
    if IsErr(negRes):
        svFetchLog(" sv_libp2p_fetch: negotiate: " + ErrorText(negRes))
        qconn.ConnClose(conn)
        return 4
    let ackRes = moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, conn4)
    if IsErr(ackRes):
        svFetchLog(" sv_libp2p_fetch: negotiate ack: " + ErrorText(ackRes))
        qconn.ConnClose(conn)
        return 4

    # --- ONE request for the whole closure: write frame + exact-length read ---
    var dataConn: qconn.Connection = qconn.ConnDup(conn4)
    var request: moqstream.Libp2pMoqSegmentStreamRequest
    request.streamId = "sv-libp2p-fetch-1"
    request.segmentKey = "sv-closure"
    request.offsetBytes = 0
    request.lengthBytes = totalBytes
    request.readChunkBytes = readChunk
    let payloadRes: Result[rawbytes.Bytes] = moqstream.Libp2pMoqSegmentStreamRequestPayloadBytes(request)
    if IsErr(payloadRes):
        svFetchLog(" sv_libp2p_fetch: encode request: " + ErrorText(payloadRes))
        qconn.ConnClose(conn)
        return 4
    let payloadBytes: rawbytes.Bytes = Value(payloadRes)
    let frameWriteRes: Result[int32] = moqstream.Libp2pMoqSegmentStreamWriteFrame(dataConn, payloadBytes)
    if IsErr(frameWriteRes):
        svFetchLog(" sv_libp2p_fetch: write request frame: " + ErrorText(frameWriteRes))
        qconn.ConnClose(conn)
        return 4
    let replyRes: Result[rawbytes.Bytes] = moqstream.Libp2pMoqSegmentStreamReadExact(dataConn, totalBytes)
    if IsErr(replyRes):
        svFetchLog(" sv_libp2p_fetch: read: " + ErrorText(replyRes))
        qconn.ConnClose(conn)
        return 5
    let blob: rawbytes.Bytes = Value(replyRes)
    let fetchMs: int64 = times.MonotimeMs() - t0
    let gotBytes: int32 = rawbytes.BytesLen(blob)
    if gotBytes != totalBytes:
        os.WriteLine(os.Get_stdout(), strutil.Join(["SV_FETCH_LEN_MISMATCH expected=", IntToStr(totalBytes),
                                                    " got=", IntToStr(gotBytes)], ""))
        qconn.ConnClose(conn)
        qtransport.Stop(client)
        return 6
    os.WriteLine(os.Get_stdout(), strutil.Join(["SV_FETCH_BYTES=", IntToStr(gotBytes)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["SV_FETCH_MS=", IntToStr(int32(fetchMs))], ""))

    # --- re-split by layout, hard SHA-256 assert, write each part out ---
    if !os.DirExists(outDirRaw):
        os.CreateDir(outDirRaw)
    var allOk: bool = true
    var offset: int32 = 0
    i = 0
    while i < 5:
        let sliceRes = moqstream.Libp2pMoqSegmentStreamCopyRange(blob, offset, partSizes[i])
        if IsErr(sliceRes):
            svFetchLog(" sv_libp2p_fetch: split: " + ErrorText(sliceRes))
            qconn.ConnClose(conn)
            qtransport.Stop(client)
            return 7
        let part = Value(sliceRes)
        let actualHash: str = rawbytes.BytesToHex(sha256.Sha256Digest(part))
        let ok: bool = actualHash == expectedHashes[i]
        if !ok:
            allOk = false
        let partNameOwned: str = strings.ConcatStr(partNames[i], "")
        let partPath: str = strutil.Join([strings.CloneStr(outDirRaw), "/", partNameOwned], "")
        let writeRes = os.WriteFileBytesResult(partPath, part)
        if IsErr(writeRes):
            svFetchLog(" sv_libp2p_fetch: write " + partPath + ": " + ErrorText(writeRes))
            allOk = false
        os.WriteLine(os.Get_stdout(), strutil.Join(["SV_FETCH_FILE i=", IntToStr(i),
                                                    " name=", share(partNames[i]),
                                                    " bytes=", IntToStr(partSizes[i]),
                                                    " sha256=", actualHash,
                                                    " ok=", (if ok: "1" else: "0")], ""))
        offset = offset + partSizes[i]
        i = i + 1

    os.WriteLine(os.Get_stdout(), strutil.Join(["SV_FETCH_DIAL_MS=", IntToStr(int32(dialDoneMs - t0))], ""))
    if allOk:
        os.WriteLine(os.Get_stdout(), "SV_FETCH_OK=1")
    else:
        os.WriteLine(os.Get_stdout(), "SV_FETCH_OK=0")
    qconn.ConnClose(conn)
    qtransport.Stop(client)
    if !allOk:
        return 10
    return 0
