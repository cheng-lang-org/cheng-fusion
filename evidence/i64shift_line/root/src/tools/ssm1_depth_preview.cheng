# SSM1 chunk DPD1 深度帧 → PGM P5 灰度预览。
#
# 用法: ssm1_depth_preview.exe <stream.ssm1> <chunkIndex> <out.pgm>
#
# 流程 (task_ssm1_pack.md §2): AssetReaderLoadBounded 载包 (256MiB 配额) →
# StreamManifestParseEx 内嵌形态解析 → ChunkAt(idx) 校验 → 从 payloadOffset
# 切 DPD1 头 (36B, 全小端, 结构校验 magic/version/bits=16/reserved=0/
# 尺寸自洽/ptsMs==chunk.startMs) → 读 w*h 个 uint16 小端深度 → 实域 min/max
# (值/scale, scale>0 时与 raw 域序一致) → 逐像素灰度 → 写 PGM P5 二进制。
#
# 灰度公式: g = (v - minV) * 255 / (maxV - minV), 定点整数式 (向下取整)。
# 与实域公式 (v/scale 线性映射) 数学等价: 两侧同乘正 scale 不改变商;
# Python 对拍同式逐字节一致。平场 (max==min) 显式拒绝, 无兜底。
# 头/越界/坏参数一律显式 ERR 退出非 0。
import std/cmdline
import std/os
import std/result
import std/rawbytes
import std/strings
import cheng/game/assets/import/reader
import cheng/game/assets/stream/manifest

# DPD1 v1 冻结常量 (task_ssm1_pack.md §2)。
fn Dpd1HdrBytes(): int32 =
    return 36

fn Dpd1DepthBitsV1(): int32 =
    return 16

# v1 形态配额: 单边 <= 65536, 保证 int64 域 w*h 乘法不溢出
# (实际尺寸另受 payloadLen <= 256MiB 的精确等式二次约束)。
fn Dpd1MaxDim(): int64 =
    return int64(65536)

type
    Dpd1Header =
        frameIndex: int64
        ptsMs: int64
        width: int64
        height: int64
        depthScale: int64
        payloadCrc32: int64

# 严格 int32 解析: 全串必须为可选负号 + 数字, 溢出显式拒绝, 不静默截断。
@borrows
fn PreviewParseStrictIndex(s: str, outIdx: var int32): bool =
    outIdx = 0
    let n = strings.Len(s)
    if n <= 0:
        return false
    var i: int32
    i = 0
    var negative: bool
    negative = false
    if s[0] == '-':
        negative = true
        i = 1
    if i >= n:
        return false
    # 允许幅值: 正侧 <= int32 最大, 负侧 <= -int32 最小。
    var limit: int64
    limit = int64(2147483647)
    if negative:
        limit = int64(2147483648)
    var value: int64
    value = int64(0)
    for k in range(i, n):
        let ch: char = s[k]
        if ch < '0' || ch > '9':
            return false
        let digit = int64(int32(ch) - int32('0'))
        if value > (limit - digit) / int64(10):
            return false
        value = value * int64(10) + digit
    if negative:
        value = int64(0) - value
    outIdx = int32(value)
    return true

# 解析并结构校验 DPD1 头。view 为 chunk payload 零拷贝视图, expectLen 为
# 容器条目 payloadLen (已被 manifest parse 宽域证明 <= 文件长 <= 256MiB)。
# 任何字段非法显式 false, outHdr 复位零值。
@borrows
fn Dpd1ParseHeader(view: rawbytes.Bytes, expectLen: int64,
                   outHdr: var Dpd1Header): bool =
    var fresh: Dpd1Header
    outHdr = fresh
    if int64(rawbytes.BytesLen(view)) != expectLen:
        return false
    if expectLen < int64(Dpd1HdrBytes()):
        return false
    if rawbytes.BytesGet(view, 0) != Int32('D'):
        return false
    if rawbytes.BytesGet(view, 1) != Int32('P'):
        return false
    if rawbytes.BytesGet(view, 2) != Int32('D'):
        return false
    if rawbytes.BytesGet(view, 3) != Int32('1'):
        return false
    if rawbytes.BytesGet(view, 4) != 1:
        return false
    if rawbytes.BytesGet(view, 5) != Dpd1DepthBitsV1():
        return false
    var rsv: int32
    if !reader.AssetReaderU16At(view, 6, rsv):
        return false
    if rsv != 0:
        return false
    var frameIndex: int64
    if !reader.AssetReaderU32At(view, 8, frameIndex):
        return false
    var ptsMs: int64
    if !manifest.StreamManifestI64At(view, 12, ptsMs):
        return false
    var width: int64
    if !reader.AssetReaderU32At(view, 20, width):
        return false
    var height: int64
    if !reader.AssetReaderU32At(view, 24, height):
        return false
    var scale: int64
    if !reader.AssetReaderU32At(view, 28, scale):
        return false
    # i32 定点分母: >= 1 且在正 int32 域 (负 i32 以大 u32 形态被上界拒绝)。
    if scale < int64(1) || scale > int64(2147483647):
        return false
    var crc: int64
    if !reader.AssetReaderU32At(view, 32, crc):
        return false
    if width < int64(1) || height < int64(1):
        return false
    if width > Dpd1MaxDim() || height > Dpd1MaxDim():
        return false
    # 尺寸自洽: 36 + w*h*2 == payloadLen (宽域 int64, w,h <= 65536 无溢出)。
    let px64 = width * height
    if int64(Dpd1HdrBytes()) + px64 * int64(2) != expectLen:
        return false
    outHdr.frameIndex = frameIndex
    outHdr.ptsMs = ptsMs
    outHdr.width = width
    outHdr.height = height
    outHdr.depthScale = scale
    outHdr.payloadCrc32 = crc
    return true

# 深度 → PGM P5 二进制落盘。求实域 min/max (raw 域同序, scale > 0),
# 逐像素 g = (v - minV) * 255 / (maxV - minV) 定点整数式。平场显式拒绝。
# 经 outMin/outMax 回报 raw 域极值 (实域 = raw/depthScale)。
@borrows
fn Dpd1WritePgm(view: rawbytes.Bytes, hdr: Dpd1Header, path: str,
                outMin: var int32, outMax: var int32): bool =
    outMin = 0
    outMax = 0
    let pxCount = int32(hdr.width * hdr.height)
    var v0: int32
    if !reader.AssetReaderU16At(view, Dpd1HdrBytes(), v0):
        return false
    var minV: int32
    var maxV: int32
    minV = v0
    maxV = v0
    for i in 1..<pxCount:
        var v: int32
        if !reader.AssetReaderU16At(view, Dpd1HdrBytes() + i * 2, v):
            return false
        if v < minV:
            minV = v
        if v > maxV:
            maxV = v
    if maxV == minV:
        return false
    let headerStr = "P5\n" + strings.IntToStr(int32(hdr.width)) + " " +
        strings.IntToStr(int32(hdr.height)) + "\n255\n"
    let headerLen = strings.Len(headerStr)
    var out = rawbytes.BytesAlloc(headerLen + pxCount)
    defer:
        rawbytes.BytesFree(out)
    for k in 0..<headerLen:
        rawbytes.BytesSet(out, k, int32(headerStr[k]))
    let span = maxV - minV
    for i in 0..<pxCount:
        var v: int32
        if !reader.AssetReaderU16At(view, Dpd1HdrBytes() + i * 2, v):
            return false
        let g = ((v - minV) * 255) / span
        rawbytes.BytesSet(out, headerLen + i, g)
    var writeRes = os.WriteFileBytesResult(path, out)
    if result.IsErr(writeRes):
        return false
    outMin = minV
    outMax = maxV
    return true

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 4:
        echo("usage: ssm1_depth_preview <stream.ssm1> <chunkIndex> <out.pgm>")
        return 2
    let path = cmdline.paramStr(1)
    var chunkIdx: int32
    if !PreviewParseStrictIndex(cmdline.paramStr(2), chunkIdx):
        echo("ERR chunkIndex is not a valid int32")
        return 1
    let outPath = cmdline.paramStr(3)
    var bounds = reader.AssetReaderBoundsFor("manifest")
    bounds.maxBytes = manifest.StreamManifestQuotaMaxBytes()
    var data = rawbytes.EmptyBytes()
    if !reader.AssetReaderLoadBounded(path, bounds, data):
        echo(Fmt"ERR load failed (missing or over quota): {path}")
        return 1
    defer:
        rawbytes.BytesFree(data)
    var m: manifest.StreamManifest
    if !manifest.StreamManifestParseEx(data, m, true):
        echo("ERR StreamManifest embedded parse failed")
        return 1
    var chunk: manifest.StreamChunk
    if !manifest.StreamManifestChunkAt(m, chunkIdx, chunk):
        echo(Fmt"ERR chunk index out of range: {chunkIdx} (count={m.chunkCount})")
        return 1
    # 宽域证明后收窄 int32: 文件 <= 256MiB (parse 配额), 范围已宽域校验。
    let n64 = int64(rawbytes.BytesLen(data))
    if chunk.payloadOffset < int64(0) || chunk.payloadLen < int64(Dpd1HdrBytes()):
        echo("ERR chunk payload range invalid")
        return 1
    if chunk.payloadOffset > n64 || chunk.payloadLen > n64 - chunk.payloadOffset:
        echo("ERR chunk payload out of file bounds")
        return 1
    let view = rawbytes.BytesSliceView(data, int32(chunk.payloadOffset),
        int32(chunk.payloadLen))
    var hdr: Dpd1Header
    if !Dpd1ParseHeader(view, chunk.payloadLen, hdr):
        echo(Fmt"ERR DPD1 header invalid: chunk={chunkIdx}")
        return 1
    # spec §2: ptsMs == 容器 chunk startMs。
    if hdr.ptsMs != chunk.startMs:
        echo(Fmt"ERR DPD1 ptsMs={hdr.ptsMs} != chunk startMs={chunk.startMs}")
        return 1
    var minV: int32
    var maxV: int32
    if !Dpd1WritePgm(view, hdr, outPath, minV, maxV):
        echo(Fmt"ERR write PGM failed or flat depth field: {outPath}")
        return 1
    echo(Fmt"OK chunk={chunkIdx} frameIndex={hdr.frameIndex} ptsMs={hdr.ptsMs} w={hdr.width} h={hdr.height} scale={hdr.depthScale} minRaw={minV} maxRaw={maxV} bytes={chunk.payloadLen} -> {outPath}")
    return 0
