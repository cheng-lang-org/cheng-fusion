# CSG 世界资产入口 (D2): 从真实资产文件加载、验证、逐项输出能力与回执。
#
# 合同 (计划 §5 D2 行): 不启动源应用; 缺资源/缺消费者明确失败 (非零退出);
# 输出逐项能力回执; 影片/截图/状态绑定资产版本由上位世界渲染接线后启用
# (渲染属世界 D2 owner, 本入口不越权)。
# 用法:
#   csg_world_asset_main glb <glbPath>
#   csg_world_asset_main wav <wavPath>
#   csg_world_asset_main mp4 <mp4Path>
import std/cmdline
import std/json
import std/strings
import std/crypto/sha256
import std/rawbytes
import cheng/game/assets/import/reader
import cheng/game/assets/import/gltf/glb
import cheng/game/assets/import/gltf/accessor
import cheng/game/assets/import/gltf/scene
import cheng/game/assets/import/gltf/skin
import cheng/game/assets/import/gltf/anim
import cheng/game/assets/media
import cheng/game/assets/import/mp4
import cheng/game/assets/skeleton
import cheng/game/assets/animation
import cheng/game/assets/import/normalize
import cheng/game/assets/reconstruction/observation
import cheng/game/assets/import/commit
import cheng/game/assets/import/reader

@borrows
fn emit(check: str, status: str, detail: str) =
    echo(Fmt"check={check} status={status} detail={detail}")

@borrows
fn loadFrozen(path: str, format: str): rawbytes.Bytes =
    var empty = rawbytes.EmptyBytes()
    var bounds = reader.AssetReaderBoundsFor(format)
    var data = rawbytes.EmptyBytes()
    if !reader.AssetReaderLoadBounded(path, bounds, data):
        emit("bounded_load", "FAIL", Fmt"path={path}")
        return empty
    emit("bounded_load", "PASS", Fmt"bytes={strings.Int64ToStr(int64(rawbytes.BytesLen(data)))}")
    return data

fn fmtMilli(v: float64): str =
    var x = v * 1000.0
    if x < 0.0:
        x = x - 0.5
    else:
        x = x + 0.5
    return strings.Int64ToStr(int64(x))

@borrows
fn runGlb(path: str): int32 =
    emit("format", "INFO", "glb")
    var data = loadFrozen(path, "glb")
    if rawbytes.BytesLen(data) == 0:
        return 1

    var container: glb.AssetGlbContainer
    var err: str
    if !glb.AssetGlbParse(data, container, err):
        emit("glb_container", "FAIL", Fmt"{err}")
        return 1
    emit("glb_container", "PASS", Fmt"binBytes={strings.Int64ToStr(container.binLength)}")
    # accessor 偏移是 BIN 相对: 切出 BIN 载荷再读。
    var binData = rawbytes.BytesSlice(data, int32(container.binOffset), int32(container.binLength))

    let root = glb.AssetGltfParseJson(container, err)
    if root.kind != json.JObject:
        emit("gltf_json", "FAIL", Fmt"{err}")
        return 1
    emit("gltf_json", "PASS", "parsed")
    if !glb.AssetGltfAssetVersionOk(root, err) ||
       !glb.AssetGltfCheckRequiredExtensions(root, err):
        emit("gltf_contract", "FAIL", Fmt"{err}")
        return 1
    emit("gltf_contract", "PASS", "version=2.0")

    var sc: scene.AssetGltfScene
    if !scene.AssetGltfParseMeshes(root, sc, err):
        emit("meshes", "FAIL", Fmt"{err}")
        return 1
    emit("meshes", "PASS", Fmt"count={strings.IntToStr(int32(sc.meshes.len))}")
    if !scene.AssetGltfParseMaterials(root, sc, err):
        emit("materials", "FAIL", Fmt"{err}")
        return 1
    emit("materials", "PASS", Fmt"count={strings.IntToStr(int32(sc.materials.len))}")
    if !scene.AssetGltfParseCameras(root, sc, err):
        emit("cameras", "FAIL", Fmt"{err}")
        return 1
    emit("cameras", "PASS", Fmt"count={strings.IntToStr(int32(sc.cameras.len))}")
    if !scene.AssetGltfParseNodes(root, sc, err):
        emit("nodes", "FAIL", Fmt"{err}")
        return 1
    if !scene.AssetGltfAssembleScene(root, sc, err):
        emit("scene", "FAIL", Fmt"{err}")
        return 1
    emit("scene", "PASS", Fmt"nodes={strings.IntToStr(int32(sc.nodes.len))} roots={strings.IntToStr(int32(sc.rootNodes.len))}")

    # 几何消费证明: POSITION 读取 + 索引界内 (缺消费者不标通过)。
    var geoOk: bool = true
    for i in 0..<sc.meshes.len:
        var pos = accessor.AssetGltfReadF64(root, binData, container.binLength,
                                            sc.meshes[i].positionAccessor, err)
        if err != "":
            emit("geometry", "FAIL", Fmt"mesh={strings.IntToStr(i)} {err}")
            geoOk = false
        else:
            let vertexCount = int32(pos.len / 3.0 + 0.5)
            emit("geometry", "PASS", Fmt"mesh={strings.IntToStr(i)} vertices={strings.IntToStr(vertexCount)}")
            if sc.meshes[i].indicesAccessor >= 0:
                var idx = accessor.AssetGltfReadIndices(root, binData,
                                                        container.binLength,
                                                        sc.meshes[i].indicesAccessor,
                                                        err)
                if err == "" && accessor.AssetGltfIndicesInRangeF(idx, vertexCount):
                    emit("indices", "PASS", Fmt"mesh={strings.IntToStr(i)} indices={strings.IntToStr(int32(idx.len))}")
                else:
                    emit("indices", "FAIL", Fmt"mesh={strings.IntToStr(i)} {err}")
                    geoOk = false
    if !geoOk:
        return 1

    # skin 回执 (存在时)。
    let skinsNode = json.jsonGetField(root, "skins")
    if skinsNode.kind == json.JArray && skinsNode.a.len > 0:
        var skel: skeleton.AssetSkeleton
        if !skin.AssetGltfParseSkin(root, binData, container.binLength, sc, 0,
                                    skel, err):
            emit("skin", "FAIL", Fmt"{err}")
            return 1
        emit("skin", "PASS", Fmt"joints={strings.IntToStr(skel.jointCount)}")

    # 动画回执 (存在时): 求值于区间端点, 应用到目标 TRS。
    let animsNode = json.jsonGetField(root, "animations")
    if animsNode.kind == json.JArray && animsNode.a.len > 0:
        var animdata: animation.AssetAnimation
        if !anim.AssetGltfParseAnimation(root, binData, container.binLength, 0,
                                         animdata, err):
            emit("animation", "FAIL", Fmt"{err}")
            return 1
        var lo = 0.0
        var hi = 0.0
        let hasRange = animation.AssetAnimTimeRange(animdata, lo, hi)
        if !hasRange:
            emit("animation", "FAIL", "empty samplers")
            return 1
        var trs: normalize.AssetNodeTrs
        trs.rw = 1.0
        trs.sx = 1.0
        trs.sy = 1.0
        trs.sz = 1.0
        for i in 0..<animdata.channels.len:
            if animdata.channels[i].targetPath != 3:
                if !animation.AssetAnimApplyChannel(animdata, animdata.channels[i], lo,
                                                    trs):
                    emit("animation_eval", "FAIL", Fmt"channel={strings.IntToStr(i)}")
                    return 1
        emit("animation", "PASS", Fmt"samplers={strings.IntToStr(int32(animdata.samplers.len))} channels={strings.IntToStr(int32(animdata.channels.len))} rangeMilli=[{fmtMilli(lo)},{fmtMilli(hi)}]")

    rawbytes.BytesFree(binData)
    rawbytes.BytesFree(data)
    emit("summary", "PASS", "glb consumed end-to-end")
    return 0

@borrows
fn runWav(path: str): int32 =
    emit("format", "INFO", "wav")
    var data = loadFrozen(path, "wav")
    if rawbytes.BytesLen(data) == 0:
        return 1
    var info: media.AssetWavInfo
    var err: str
    if !media.AssetMediaParseWav(data, info, err):
        emit("wav_parse", "FAIL", Fmt"{err}")
        return 1
    emit("wav_parse", "PASS", Fmt"rate={strings.IntToStr(info.sampleRate)} channels={strings.IntToStr(info.channels)} bits={strings.IntToStr(info.bitsPerSample)} durationMs={strings.Int64ToStr(info.durationMs)} extraChunks={strings.IntToStr(info.extraChunks)}")
    rawbytes.BytesFree(data)
    emit("summary", "PASS", "wav consumed end-to-end")
    return 0

@borrows
fn runMp4(path: str): int32 =
    emit("format", "INFO", "mp4")
    var data = loadFrozen(path, "mp4")
    if rawbytes.BytesLen(data) == 0:
        return 1
    var info: mp4.AssetMp4Info
    var err: str
    if !mp4.AssetMediaParseMp4(data, info, err):
        emit("mp4_parse", "FAIL", Fmt"{err}")
        return 1
    emit("mp4_parse", "PASS", Fmt"timescale={strings.IntToStr(info.timescale)} duration={strings.Int64ToStr(info.duration)} tracks={strings.IntToStr(info.trackCount)}")
    for i in 0..<info.tracks.len:
        let t = info.tracks[i]
        var kind = "other"
        if t.handler == mp4.AssetMediaHandlerVide():
            kind = "vide"
        if t.handler == mp4.AssetMediaHandlerSoun():
            kind = "soun"
        var flags: str
        if mp4.AssetMp4TrackVariableFps(t):
            flags = flags + "+vfr"
        if mp4.AssetMp4TrackHasInterFrames(t):
            flags = flags + "+interframes"
        if mp4.AssetMp4TrackNonZeroStart(t):
            flags = flags + "+nonzero_start"
        emit("track", "PASS", Fmt"index={strings.IntToStr(i)} kind={kind} samples={strings.IntToStr(t.sampleCount)} timebase={strings.IntToStr(t.timebase)}{flags}")
    rawbytes.BytesFree(data)
    emit("summary", "PASS", "mp4 consumed end-to-end")
    return 0

# 存量视频 -> CSG 世界观测对象: 解析 vide 轨道时序真值, 观测落库激活。
fn runObserve(path: str, storeDir: str): int32 =
    emit("format", "INFO", "video-observation")
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = rawbytes.EmptyBytes()
    if !reader.AssetReaderLoadBounded(path, bounds, data):
        emit("bounded_load", "FAIL", Fmt"path={path}")
        return 1
    # 源字节 CID (观测绑定冻结输入)
    var digest = sha256.Sha256Digest(data)
    defer:
        rawbytes.BytesFree(digest)
    let sourceCid = rawbytes.BytesToHex(digest)
    emit("source_cid", "PASS", Fmt"cid={sourceCid}")

    var info: mp4.AssetMp4Info
    var err: str
    if !mp4.AssetMediaParseMp4(data, info, err):
        emit("mp4_parse", "FAIL", Fmt"{err}")
        return 1
    var vi = -1
    for i in 0..<info.tracks.len:
        if info.tracks[i].handler == mp4.AssetMediaHandlerVide():
            vi = i
            break
    if vi < 0:
        emit("vide_track", "FAIL", "no vide track")
        return 1

    var obs = observation.AssetVideoObserveFromTrack(info.tracks[vi].handler,
        info.tracks[vi].timebase, info.tracks[vi].sampleCount,
        info.tracks[vi].mediaDuration, info.tracks[vi].sttsCounts,
        info.tracks[vi].sttsDeltas, info.tracks[vi].stssSamples,
        path, sourceCid)
    if !observation.AssetVideoObservationValid(obs):
        emit("observation", "FAIL", "invalid observation (handler/timescale/keyframes)")
        return 1
    emit("observation", "PASS", Fmt"timescale={strings.IntToStr(obs.timescale)} samples={strings.IntToStr(obs.sampleCount)} totalTicks={strings.Int64ToStr(obs.totalTicks)} durationMs={strings.Int64ToStr(obs.durationMs)} keyframes={strings.IntToStr(obs.keyframeCount)} gop={strings.IntToStr(obs.gopCount)}")
    var kfi: int32
    while kfi < obs.keyframeCount:
        emit("keyframe", "PASS", Fmt"index={strings.IntToStr(kfi)} tick={strings.Int64ToStr(obs.keyframeTicks[kfi])} ms={strings.Int64ToStr(obs.keyframeMs[kfi])}")
        kfi = kfi + 1

    # 观测对象按内容 CID 落库: 准入 -> 激活 (head 指向观测对象)
    if !observation.AssetVideoObservationCommit(storeDir, obs):
        emit("commit", "FAIL", Fmt"store={storeDir}")
        return 1
    emit("commit", "PASS", Fmt"cid={observation.AssetVideoObservationCid(obs)}")
    emit("summary", "PASS", "video observed into csg world store")
    return 0

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 2:
        echo("usage: csg_world_asset_main <glb|wav|mp4|observe> <path> [storeDir]")
        return 2
    let format = Fmt"{cmdline.paramStr(1)}"
    let path = Fmt"{cmdline.paramStr(2)}"
    if format == "glb":
        return runGlb(path)
    if format == "wav":
        return runWav(path)
    if format == "mp4":
        return runMp4(path)
    if format == "observe":
        if argc < 3:
            echo("usage: csg_world_asset_main observe <mp4Path> <storeDir>")
            return 2
        return runObserve(path, Fmt"{cmdline.paramStr(3)}")
    echo(Fmt"unsupported format={format}")
    return 2
