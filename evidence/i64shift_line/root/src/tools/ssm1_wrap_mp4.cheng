# SSM1 单 chunk mp4 包装工具 (base_ssm1_transfer 任务)。
#
# 用法: ssm1_wrap_mp4 <mp4路径> <输出.ssm1路径> [durationMs=22500]
#
# 把整个 mp4 文件包装为 SSM1 v1 embedded 容器 (冻结合同
# src/game/assets/stream/manifest.cheng): 恰 1 个 chunk, isKeyframe=1,
# 载荷 = mp4 全量字节, cid = payload sha256 hex (SSM1 v1 内容 CID)。
# q3_serve serve 语义下: stream4 = header 段 [0,117), stream8 = 首关键帧
# chunk 段 = [117, 117+mp4Len) = mp4 全量字节; fetch 端 sha256==cid 双断言
# 即 mp4 字节级完整性证明。
#
# 布局 (全小端): "SSM1" + ver u32=1 + chunkCount u32=1
#   + chunk{startMs i64=0, durationMs i64, kf u8=1, cidLen u32=64,
#           cid 64B hex, payloadLen i64, payloadOffset i64=117}
#   + audioRef u32=0 (无音轨引用, mp4 自带音轨在载荷内)
#   + 载荷区 (mp4 字节, 按序无缝覆盖至 EOF)
# 写出后用 StreamManifestParseEmbedded 回读自证, 失败即非零退出。
import std/cmdline
import std/os
import std/parseutils
import std/rawbytes
import std/crypto/sha256
import std/strings
import cheng/game/assets/stream/manifest

const WrapHeaderLen = 117
const WrapChunkEntryBytes = 101  # 8+8+1+4+64+8+8
const WrapAudioRefBytes = 4

fn WrapEmit(line: str) =
    os.Write(os.Get_stdout(), line)
    os.Write(os.Get_stdout(), "\n")
    var flushed: int32
    flushed = os.C_fflush(os.Get_stdout())
    if flushed != 0:
        panic("wrap_stdout_flush_failed")

# 严格十进制时长参数 (int32 域, ms 值实测远小; 结果以 int64 承载)。
fn WrapParseI64(s: str, out: var int64): bool =
    out = 0
    let n = len(s)
    if n <= 0:
        return false
    var start: int32
    start = 0
    if s[0] == '-':
        start = 1
    if start >= n:
        return false
    for i in start..<n:
        if s[i] < '0' || s[i] > '9':
            return false
    var v32: int32
    if parseutils.ParseInt32(s, v32) <= 0:
        return false
    out = int64(v32)
    return true

fn WrapU32le(b: var rawbytes.Bytes, off: int32, v: int64) =
    var x: int64
    x = v
    for k in 0..<4:
        rawbytes.BytesSet(b, off + k, int32(x % 256))
        x = x / 256

fn WrapI64le(b: var rawbytes.Bytes, off: int32, v: int64) =
    var x: int64
    x = v
    for k in 0..<8:
        rawbytes.BytesSet(b, off + k, int32(x % 256))
        x = x / 256

fn main(argc: int32, argv: ptr): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 2:
        WrapEmit("usage: ssm1_wrap_mp4 <mp4路径> <输出.ssm1路径> [durationMs=22500]")
        return 2
    let inPath = cmdline.ParamStr(1)
    let outPath = cmdline.ParamStr(2)
    var durationMs: int64
    durationMs = int64(22500)
    if cmdline.ParamCount() >= 3:
        var durArg: str
        durArg = cmdline.ParamStr(3)
        if !WrapParseI64(durArg, durationMs) || durationMs < int64(0):
            WrapEmit("ERR bad_duration")
            return 2

    # === 读 mp4 (本工具为本地 Mac 工具, 读入后仍显式套容器配额) ===
    var mp4Res = os.ReadFileBytesResult(inPath)
    if IsErr(mp4Res):
        WrapEmit(Fmt"ERR mp4_read path={inPath} err={ErrorText(mp4Res)}")
        return 1
    var mp4 = Value(mp4Res)
    defer:
        rawbytes.BytesFree(mp4)
    let mp4Len = rawbytes.BytesLen(mp4)
    if mp4Len <= 0:
        WrapEmit("ERR mp4_empty")
        return 1
    if int64(mp4Len) > manifest.StreamManifestQuotaMaxBytes():
        WrapEmit("ERR mp4_past_quota")
        return 1
    if int64(WrapHeaderLen) > int64(2147483647) - int64(mp4Len):
        WrapEmit("ERR total_past_i32")
        return 1

    # === cid = payload sha256 hex (SSM1 v1 内容 CID, 64 小写 hex) ===
    var digest = sha256.Sha256Digest(mp4)
    defer:
        rawbytes.BytesFree(digest)
    let cid = rawbytes.BytesToHex(digest)
    if len(cid) != manifest.StreamManifestCidLenV1():
        WrapEmit(Fmt"ERR cid_len got={len(cid)}")
        return 1

    # === 组装容器 ===
    let total = WrapHeaderLen + mp4Len
    var out = rawbytes.BytesAlloc(total)
    defer:
        rawbytes.BytesFree(out)
    rawbytes.BytesSet(out, 0, Int32('S'))
    rawbytes.BytesSet(out, 1, Int32('S'))
    rawbytes.BytesSet(out, 2, Int32('M'))
    rawbytes.BytesSet(out, 3, Int32('1'))
    WrapU32le(out, 4, int64(1))                # version
    WrapU32le(out, 8, int64(1))                # chunkCount
    WrapI64le(out, 12, int64(0))               # startMs
    WrapI64le(out, 20, durationMs)             # durationMs
    rawbytes.BytesSet(out, 28, 1)              # isKeyframe
    WrapU32le(out, 29, int64(manifest.StreamManifestCidLenV1()))  # cidLen
    for k in 0..<manifest.StreamManifestCidLenV1():
        rawbytes.BytesSet(out, 33 + k, Int32(cid[k]))
    WrapI64le(out, 97, int64(mp4Len))          # payloadLen
    WrapI64le(out, 105, int64(WrapHeaderLen))  # payloadOffset
    WrapU32le(out, 113, int64(0))              # audioRef = 无音轨引用
    for i in 0..<mp4Len:
        rawbytes.BytesSet(out, WrapHeaderLen + i, rawbytes.BytesGet(mp4, i))

    # === 写出 ===
    let wres = os.WriteFileBytesResult(outPath, out)
    if IsErr(wres):
        WrapEmit(Fmt"ERR write path={outPath} err={ErrorText(wres)}")
        return 1

    # === 回读自证: embedded 解析 + 首关键帧定位 ===
    var m: manifest.StreamManifest
    if !manifest.StreamManifestParseEmbedded(out, m):
        WrapEmit("ERR self_parse")
        return 1
    let kfIdx = manifest.StreamManifestNearestKeyframeIndexForTime(m, int64(0))
    if kfIdx < 0:
        WrapEmit("ERR self_no_keyframe")
        return 1
    var kf: manifest.StreamChunk
    if !manifest.StreamManifestChunkAt(m, kfIdx, kf):
        WrapEmit("ERR self_kf_chunk_at")
        return 1
    if !kf.isKeyframe || kf.payloadLen != int64(mp4Len) || kf.payloadOffset != int64(WrapHeaderLen):
        WrapEmit("ERR self_kf_mismatch")
        return 1
    WrapEmit(Fmt"wrap ok in={inPath} out={outPath} mp4Len={mp4Len} fileLen={total} headerLen={WrapHeaderLen} chunks={m.chunkCount} kfChunk={kfIdx} kfRange=[{kf.payloadOffset},{kf.payloadOffset + kf.payloadLen}) durationMs={durationMs} cid={cid}")
    return 0
