# SSM1 daemon 同进程导出面变体 (M4 ohos 真机冒烟)。
#
# 复制 src/tools/ssm1_tick_daemon.cheng 的协议逻辑 (manifest/player 调用与
# 应答格式逐行同源), 差异只有进程模型: ohos 真机不走 stdin/stdout 子进程管道,
# 由 C shim (src/tools/ssm1_ohos_shim.c) 读行后同进程直调导出。
#
# 导出面 (唯一入口, init/play/tick/seek/quit 全部经 cmd 行协议):
#   ssm1d_cmd(line, out, cap) -> int32
#     line: NUL 结尾命令行 (同 daemon stdin 行语义)
#     out:  调用方缓冲区, 写入 NUL 结尾应答行 (不含行尾换行)
#     返回: >0 应答字节数 (不含 NUL); 0 = 无应答 (空行/quit);
#           -1 = out 为 nil; -2 = cap 不足以容纳应答+NUL
# 状态持有: 模块级 m/p 与 daemon main 等价 (init 整体覆盖, 无需 reset 入口)。
# stdio 归 C shim 全权持有, 本模块不 import std/os、不碰任何流, 规避
# program_support_backend get_std* 的 /dev/std* 重开路径 (M1 安卓真机已证
# SELinux 拒此路径)。
import std/parseutils
import std/strings
import std/strutils
import std/system
import std/rawbytes
import cheng/game/assets/stream/manifest
import cheng/game/assets/stream/player

type
    Ssm1dBytePtr = uint8 *

var
    ssm1d_m: manifest.StreamManifest
    ssm1d_p: player.StreamPlayerQ

fn ssm1d_ptr_plus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(base) + uint64(off))

# 应答 str -> 调用方缓冲区 (字节拷贝 + NUL)。str.data/.len 是托管 str 的
# 既有源级字段 (先例: std/system.StrFromCStringBorrow)。
fn ssm1d_copy_out(resp: str, out: ptr, cap: int32): int32 =
    if out == nil:
        return -1
    if resp.len < 0 || resp.len + 1 > cap:
        return -2
    var i: int32
    for i in 0..<resp.len:
        *(Ssm1dBytePtr(ssm1d_ptr_plus(out, i))) =
            *(Ssm1dBytePtr(ssm1d_ptr_plus(resp.data, i)))
    *(Ssm1dBytePtr(ssm1d_ptr_plus(out, resp.len))) = uint8(0)
    return resp.len

# 严格十进制整数: 可带一个前导 '-', 其余必须全数字, 值域 int32。
# (逐行同源 ssm1_tick_daemon.DaemonParseI32)
fn Ssm1dParseI32(s: str, out: var int32): bool =
    out = 0
    let n = len(s)
    if n <= 0:
        return false
    var start: int32
    start = 0
    if s[0] == '-':
        start = 1
    if start >= n:
        return false
    for i in start..<n:
        if s[i] < '0' || s[i] > '9':
            return false
    return parseutils.ParseInt32(s, out) > 0

# STATE 状态行; pre 逐元素拷贝本地后再格式化 (托管 seq 元素不绑定)。
# (逐行同源 ssm1_tick_daemon.DaemonStateLine)
fn Ssm1dStateLine(p: player.StreamPlayerQ, fetch: int32, pre: int32[]): str =
    var play01: str
    play01 = "0"
    if p.playing:
        play01 = "1"
    var eof01: str
    eof01 = "0"
    if p.eofLatched:
        eof01 = "1"
    var preParts: str[]
    for i in 0..<pre.len:
        let v = pre[i]
        add(preParts, strings.IntToStr(v))
    let preStr = strutils.Join(preParts, ",")
    return Fmt"STATE posMs={p.posMs} playing={play01} rate={p.rateX10} eof={eof01} fetch={fetch} bufferedTo={p.bufferedToMs} pre={preStr}"

# 执行一条命令; 回应答行, 空串 = 无应答 (空行输入/quit)。
# m/p 归模块全局持有, 经 var 转发 (先例: daemon 经 var 转发给 Player API)。
# 未 init (p.ok=false) 时一切播放命令显式 ERR。
# (协议分支逐行同源 ssm1_tick_daemon.DaemonDispatch, 仅应答通道改为返回值)
fn Ssm1dDispatch(line: str): str =
    var resp: str
    resp = ""
    let toks = strutils.SplitWhitespace(strutils.Strip(line))
    if toks.len == 0:
        return resp
    let cmd = toks[0]
    if cmd == "quit":
        return resp
    if cmd == "init":
        if toks.len != 3:
            resp = "ERR init_needs_path_and_bufwindow"
            return resp
        var bufWindowMs: int32
        var bufArg: str
        bufArg = toks[2]
        if !Ssm1dParseI32(bufArg, bufWindowMs) || bufWindowMs < 0:
            resp = "ERR bad_bufwindow"
            return resp
        var freshM: manifest.StreamManifest
        if !manifest.StreamManifestLoadFileEmbedded(toks[1], freshM):
            resp = "ERR manifest_load_failed"
            return resp
        var freshP: player.StreamPlayerQ
        if !player.PlayerInit(freshP, freshM.totalDurationMs,
                              int64(bufWindowMs)):
            resp = "ERR player_init_failed"
            return resp
        ssm1d_m = freshM
        ssm1d_p = freshP
        let chunks = freshM.chunkCount
        let durMs = freshM.totalDurationMs
        resp = Fmt"OK init chunks={chunks} durationMs={durMs} bufWindowMs={bufWindowMs}"
        return resp
    if cmd == "play":
        if !ssm1d_p.ok:
            resp = "ERR not_inited"
            return resp
        if !player.PlayerPlay(ssm1d_p):
            resp = "ERR play_rejected_eof_latched"
            return resp
        resp = "OK play"
        return resp
    if cmd == "pause":
        if !ssm1d_p.ok:
            resp = "ERR not_inited"
            return resp
        if !player.PlayerPause(ssm1d_p):
            resp = "ERR pause_rejected"
            return resp
        resp = "OK pause"
        return resp
    if cmd == "rate":
        if !ssm1d_p.ok:
            resp = "ERR not_inited"
            return resp
        if toks.len != 2:
            resp = "ERR rate_needs_x10"
            return resp
        var rateX10: int32
        var rateArg: str
        rateArg = toks[1]
        if !Ssm1dParseI32(rateArg, rateX10):
            resp = "ERR bad_rate"
            return resp
        if !player.PlayerSetRate(ssm1d_p, rateX10):
            resp = "ERR rate_out_of_domain"
            return resp
        resp = Fmt"OK rate={ssm1d_p.rateX10}"
        return resp
    if cmd == "seek":
        if !ssm1d_p.ok:
            resp = "ERR not_inited"
            return resp
        if toks.len != 2:
            resp = "ERR seek_needs_ms"
            return resp
        var targetMs: int32
        var seekArg: str
        seekArg = toks[1]
        if !Ssm1dParseI32(seekArg, targetMs):
            resp = "ERR bad_seek_ms"
            return resp
        if !player.PlayerSeek(ssm1d_p, int64(targetMs)):
            resp = "ERR seek_out_of_range"
            return resp
        resp = Fmt"OK seek posMs={ssm1d_p.posMs}"
        return resp
    if cmd == "tick":
        if !ssm1d_p.ok:
            resp = "ERR not_inited"
            return resp
        if toks.len != 2:
            resp = "ERR tick_needs_dtms"
            return resp
        var dtMs: int32
        var tickArg: str
        tickArg = toks[1]
        if !Ssm1dParseI32(tickArg, dtMs):
            resp = "ERR bad_tick_dtms"
            return resp
        var fetch: int32
        var pre: int32[]
        if !player.PlayerTick(ssm1d_p, int64(dtMs), ssm1d_m, fetch, pre):
            resp = "ERR tick_rejected"
            return resp
        resp = Ssm1dStateLine(ssm1d_p, fetch, pre)
        return resp
    resp = Fmt"ERR unknown_command cmd={cmd}"
    return resp

@exportc("ssm1d_cmd")
fn ssm1d_cmd(line: cstring, out: ptr, cap: int32): int32 =
    var req: str
    req = strFromCStringCopy(line)
    let resp = Ssm1dDispatch(req)
    if len(resp) == 0:
        return 0
    return ssm1d_copy_out(resp, out, cap)

# 内存装载 (ohos 应用沙箱 fileIo 对 el2 haps 路径异常 ENOTDIR 的根治):
# 宿主把 rawfile 字节经指针直传, 逐字节入 BytesBuilder -> ParseEx embedded
# -> PlayerInit, 一步完成 load+init。应答同 init 行协议。
@exportc("ssm1d_load")
fn ssm1d_load(data: ptr, len: int32, bufWindowMs: int32, out: ptr,
              cap: int32): int32 =
    if data == nil:
        return ssm1d_copy_out("ERR load_nil_data", out, cap)
    if len <= 0 || bufWindowMs < 0:
        return ssm1d_copy_out("ERR load_bad_args", out, cap)
    var b = rawbytes.BytesBuilderNew(len)
    for i in 0..<len:
        rawbytes.BytesBuilderAppendByte(b,
            *(Ssm1dBytePtr(ssm1d_ptr_plus(data, i))))
    var bytesData = rawbytes.BytesBuilderFinish(b)
    var freshM: manifest.StreamManifest
    var loadOk = manifest.StreamManifestParseEx(bytesData, freshM, true)
    rawbytes.BytesFree(bytesData)
    if !loadOk:
        return ssm1d_copy_out("ERR manifest_load_failed", out, cap)
    var freshP: player.StreamPlayerQ
    if !player.PlayerInit(freshP, freshM.totalDurationMs,
                          int64(bufWindowMs)):
        return ssm1d_copy_out("ERR player_init_failed", out, cap)
    ssm1d_m = freshM
    ssm1d_p = freshP
    let chunks = freshM.chunkCount
    let durMs = freshM.totalDurationMs
    let resp = Fmt"OK init chunks={chunks} durationMs={durMs} bufWindowMs={bufWindowMs} src=memory"
    return ssm1d_copy_out(resp, out, cap)
