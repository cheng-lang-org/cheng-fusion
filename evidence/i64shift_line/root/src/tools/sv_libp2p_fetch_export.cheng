# sv_libp2p_fetch_export.cheng — sv_libp2p_fetch.cheng 的 NAPI 导出变体
# (任务 F-E: 安卓 libp2p serve → 鸿蒙 HAP fetch 双真机端到端)。
#
# 语义与 src/tools/sv_libp2p_fetch.cheng (F-D 设备验证形) 逐跳同源:
#   dial (Libp2pQuicDialOneShotClientNamed, 内部阻塞泵环) → derive(4,4)
#   → SendNegotiate → ReadNegotiateAck → 单请求 [0,total) of "sv-closure"
#   → WriteFrame + ReadExact 原字节 → 按 layout 切分 → 逐文件 SHA-256 断言
#   → 落盘 outDir。差异只有进程模型: 无 cmdline/stdout, host/port/outDir
#   由宿主 (NAPI shim worker 线程) 传入, 结果 = 单行 k=v 应答经 out/cap
#   返回 (ssm1q_loopback_export.q_copy_out 同款纪律)。
#
# 闭包描述 (f1 闭环快照, F-D 冻结): 5 文件 28,897B, layout=3035,8444,8444,
# 8444,530; 名称与期望 SHA-256 为模块常量 (压缩闭包身份即协议常量)。
#
# F-D 三条源码级陷阱照抄修法: Split 源串先 CloneStr 绑住; negotiate 前
# derive(4,4) (拨号默认流非对称, 否则 ack 落错流必死); str[] 字面量元素
# 一律 ConcatStr owned。
#
# 本文件无 fn main: 驱动 --emit:obj 的 exe 包装 main 只对含程序入口的源
# 注入 (fd_libp2p_slice §G2 缺陷), 纯 @exportc 闭包 obj 无 main 符号
# (ssm1q_loopback_export_ohos.o 实测 0 个), fd_patch_obj_main.py 不适用
# 也不需要。
import std/result
import std/strings
import std/rawbytes
import std/os as os
import std/times as times
import std/strutils as strutil
import std/cmdline as cmdline
import std/system
import std/crypto/sha256 as sha256
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream

const
    SvPartCount = 5
    SvLayout = "3035,8444,8444,8444,530"
    SvNamesCsv = "f1_ball.svblock,ck-1200.payload,ck-2400.payload,ck-3600.payload,ballbalance.csgworld"
    SvHashesCsv = "0175b22ce2fd5b3af16f27f466004f5c467c19e6fda2628409427b938b2fb19e,fed24d6f1962e76cce598120fcab3ba22719e9217692ca8fc63db7d286ad27cb,16c89b3749c0e89639bd3cac4aca74fa83ae2e087619dca267022a3a770b03f5,647213325cab9acb84a03dd8fd65c5c2ad097a0a1c54c9c6fa7a571e35fb9be3,b444f023e8708342b5c78abf08729d73aa610e44049c8be8bb425fad5a2ff026"

# F-E': 阶段标记直写 stderr → shim 落盘 svfetch_diag.log (hilog APP 通道死)。
fn svStage(text: str) =
    os.WriteLine(os.Get_stderr(), text)

type SvBytePtr = uint8 *

fn sv_ptr_plus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(base) + uint64(off))

# 应答 str -> 调用方缓冲区 (字节拷贝 + NUL, 同 ssm1q_loopback_export.q_copy_out)。
fn sv_copy_out(resp: str, out: ptr, cap: int32): int32 =
    if out == nil:
        return -1
    if resp.len < 0 || resp.len + 1 > cap:
        return -2
    var i: int32
    for i in 0..<resp.len:
        *(SvBytePtr(sv_ptr_plus(out, i))) = *(SvBytePtr(sv_ptr_plus(resp.data, i)))
    *(SvBytePtr(sv_ptr_plus(out, resp.len))) = uint8(0)
    return resp.len

@exportc("sv_libp2p_fetch_run")
fn sv_libp2p_fetch_run(hostCstr: cstring, port: int32, outDirCstr: cstring,
                       out: ptr, cap: int32): int32 =
    if port <= 0 || port > 65535:
        return sv_copy_out("FAIL bad_port", out, cap)
    let host = strFromCStringCopy(hostCstr)
    let outDirRaw = strFromCStringCopy(outDirCstr)

    # Split 源串先 owned 绑定 (F-D 陷阱 1)。
    let layoutOwned: str = strings.CloneStr(SvLayout)
    let hashesOwned: str = strings.CloneStr(SvHashesCsv)
    let namesOwned: str = strings.CloneStr(SvNamesCsv)
    let layoutParts = strutil.Split(layoutOwned, ',')
    let hashParts = strutil.Split(hashesOwned, ',')
    let nameParts = strutil.Split(namesOwned, ',')
    var partSizes: int32[] = [0, 0, 0, 0, 0]
    var expectedHashes: str[] = ["", "", "", "", ""]
    var partNames: str[] = ["", "", "", "", ""]
    var totalBytes: int32 = 0
    var badCsv: bool = false
    if layoutParts.len != SvPartCount:
        badCsv = true
    if hashParts.len != SvPartCount:
        badCsv = true
    if nameParts.len != SvPartCount:
        badCsv = true
    var i: int32
    while !badCsv && i < SvPartCount:
        let sizeText: str = strings.ConcatStr(layoutParts[i], "")
        var sizeVal: int32
        if !cmdline.ParseInt32(sizeText, sizeVal):
            badCsv = true
        else:
            if sizeVal <= 0:
                badCsv = true
            else:
                partSizes[i] = sizeVal
                totalBytes = totalBytes + sizeVal
        i = i + 1
    i = 0
    while !badCsv && i < SvPartCount:
        expectedHashes[i] = strings.ConcatStr(hashParts[i], "")
        partNames[i] = strings.ConcatStr(nameParts[i], "")
        i = i + 1
    if badCsv:
        return sv_copy_out("FAIL bad_closure_constants", out, cap)

    # --- dial + negotiate (计时与数据请求分开) ---
    let t0: int64 = times.MonotimeMs()
    var client = qtransport.InitMsQuicTransport()
    # F-E' ohos orc_miss 隔离 (2026-09-17): 不走 Libp2pQuicDialOneShotClientNamed
    # 包装——其 `client = InitMsQuicTransport()` var 参数整构赋值 + 大栈临时在
    # ohos 目标确定性触发 registry_miss (ORCMISS p=0x20, 符号化栈:
    # cold-drop-object:217 → mem_release_checked → ORCMISS → autopsy SEGV,
    # 同源 android obj 3/3 绿), 与 task_x §3.3 / ma_reconnect 登记的 ohos
    # 大结构拷贝 orc_miss 同族 (上游后端欠账, 另案)。此处按 ssm1q_loopback_
    # export 在鸿蒙真机已验证的形状直调同原语, 语义逐句等价 (同 configure
    # settings/tls, 同 dial, 同 addr)。
    let addrRes = quic_transport.Libp2pQuicAddrFromHostPort(host, port)
    if IsErr(addrRes):
        return sv_copy_out(strings.ConcatStr("FAIL addr ", ErrorText(addrRes)), out, cap)
    # F-E' 跨机实测 (2026-09-17): OneShot 常量握手超时 2000ms 在 harmony→android
    # WLAN (rtt ~89ms, 省电突发) 上不够, dial rc=42 handshake ! ready @2257ms。
    # 直接字段写 (borrow 语义) 而非 setMsQuicTransportSettings 整构拷贝——
    # 1000010 轮传输完成后 fetch_run 尾部 drop 再现 ORCMISS p=0x20, 疑点收敛
    # 到 settings 拷贝路径, 此写法隔离之。
    client.settings.handshakeIdleTimeoutMs = int64(15000)
    client.settings.idleTimeoutMs = int64(20000)
    client.settings.disconnectTimeoutMs = 1000
    let tlsRes = quic_transport.Libp2pQuicConfigureTlsWithServerName(client, "localhost")
    if IsErr(tlsRes):
        return sv_copy_out(strings.ConcatStr("FAIL tls ", ErrorText(tlsRes)), out, cap)
    var dialRes = qtransport.dial(client, Value(addrRes))
    if IsErr(dialRes):
        return sv_copy_out(strings.ConcatStr("FAIL dial ", ErrorText(dialRes)), out, cap)
    var conn: qconn.Connection = Value(dialRes)
    svStage("STAGE2 dial_ok")
    let dialDoneMs: int64 = times.MonotimeMs()
    # negotiate 前 derive(4,4): 拨号默认流非对称 (F-D 陷阱 2, 环回必死面)。
    var conn4: qconn.Connection = qconn.ConnDeriveStream(conn, 4, 4)
    let negRes = moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, conn4)
    if IsErr(negRes):
        qconn.ConnClose(conn)
        return sv_copy_out(strings.ConcatStr("FAIL negotiate ", ErrorText(negRes)), out, cap)
    let ackRes = moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, conn4)
    if IsErr(ackRes):
        qconn.ConnClose(conn)
        return sv_copy_out(strings.ConcatStr("FAIL negotiate_ack ", ErrorText(ackRes)), out, cap)
    svStage("STAGE2 negotiate_ok")

    # --- 单请求整闭包: 写帧 + 定长读 ---
    var dataConn: qconn.Connection = qconn.ConnDup(conn4)
    var request: moqstream.Libp2pMoqSegmentStreamRequest
    request.streamId = "sv-libp2p-fetch-1"
    request.segmentKey = "sv-closure"
    request.offsetBytes = 0
    request.lengthBytes = totalBytes
    request.readChunkBytes = 8192
    let payloadRes: Result[rawbytes.Bytes] = moqstream.Libp2pMoqSegmentStreamRequestPayloadBytes(request)
    if IsErr(payloadRes):
        qconn.ConnClose(conn)
        return sv_copy_out(strings.ConcatStr("FAIL encode_request ", ErrorText(payloadRes)), out, cap)
    let payloadBytes: rawbytes.Bytes = Value(payloadRes)
    let frameWriteRes: Result[int32] = moqstream.Libp2pMoqSegmentStreamWriteFrame(dataConn, payloadBytes)
    if IsErr(frameWriteRes):
        qconn.ConnClose(conn)
        return sv_copy_out(strings.ConcatStr("FAIL write_request ", ErrorText(frameWriteRes)), out, cap)
    let replyRes: Result[rawbytes.Bytes] = moqstream.Libp2pMoqSegmentStreamReadExact(dataConn, totalBytes)
    if IsErr(replyRes):
        qconn.ConnClose(conn)
        return sv_copy_out(strings.ConcatStr("FAIL read ", ErrorText(replyRes)), out, cap)
    let blob: rawbytes.Bytes = Value(replyRes)
    svStage("STAGE2 read_ok")
    let fetchMs: int64 = times.MonotimeMs() - t0
    let gotBytes: int32 = rawbytes.BytesLen(blob)
    if gotBytes != totalBytes:
        qconn.ConnClose(conn)
        qtransport.Stop(client)
        return sv_copy_out(strings.ConcatStr(strings.ConcatStr("FAIL len_mismatch expected=", IntToStr(totalBytes)), strings.ConcatStr(" got=", IntToStr(gotBytes))), out, cap)

    # --- 切分 + SHA 断言 + 落盘 ---
    if !os.DirExists(outDirRaw):
        os.CreateDir(outDirRaw)
    var allOk: bool = true
    var offset: int32 = 0
    var reply: str = strings.ConcatStr(strings.ConcatStr(strings.ConcatStr("SV_FETCH_BYTES=", IntToStr(gotBytes)), strings.ConcatStr(" SV_FETCH_MS=", IntToStr(int32(fetchMs)))), strings.ConcatStr(" SV_FETCH_DIAL_MS=", IntToStr(int32(dialDoneMs - t0))))
    i = 0
    while i < SvPartCount:
        let sliceRes = moqstream.Libp2pMoqSegmentStreamCopyRange(blob, offset, partSizes[i])
        if IsErr(sliceRes):
            qconn.ConnClose(conn)
            qtransport.Stop(client)
            return sv_copy_out(strings.ConcatStr(strings.ConcatStr("FAIL split i=", IntToStr(i)), strings.ConcatStr(" ", ErrorText(sliceRes))), out, cap)
        let part = Value(sliceRes)
        let actualHash: str = rawbytes.BytesToHex(sha256.Sha256Digest(part))
        let ok: bool = actualHash == expectedHashes[i]
        if !ok:
            allOk = false
        let partNameOwned: str = strings.ConcatStr(partNames[i], "")
        let partPath: str = strutil.Join([strings.CloneStr(outDirRaw), "/", partNameOwned], "")
        svStage(strings.ConcatStr(strings.ConcatStr("STAGE2 part i=", IntToStr(i)), strings.ConcatStr(" shaOk=", IntToStr(int32(ok)))))
        let writeRes = os.WriteFileBytesResult(partPath, part)
        var writeOk: bool = true
        if IsErr(writeRes):
            writeOk = false
            allOk = false
        let fileOk: int32 = if ok && writeOk: 1 else: 0
        var seg: str = strings.ConcatStr(" F", IntToStr(i))
        seg = strings.ConcatStr(seg, "=")
        seg = strings.ConcatStr(seg, partNameOwned)
        seg = strings.ConcatStr(seg, ",")
        seg = strings.ConcatStr(seg, IntToStr(partSizes[i]))
        seg = strings.ConcatStr(seg, ",")
        seg = strings.ConcatStr(seg, actualHash)
        seg = strings.ConcatStr(seg, ",")
        seg = strings.ConcatStr(seg, IntToStr(fileOk))
        reply = strings.ConcatStr(reply, seg)
        offset = offset + partSizes[i]
        i = i + 1
    svStage("STAGE2 parts_done")
    qconn.ConnClose(conn)
    qtransport.Stop(client)
    svStage("STAGE2 conn_closed")
    if allOk:
        reply = strings.ConcatStr(reply, " SV_FETCH_OK=1")
        let rc = sv_copy_out(reply, out, cap)
        if rc < 0:
            return rc
        return 0
    reply = strings.ConcatStr(reply, " SV_FETCH_OK=0")
    let rcFail = sv_copy_out(reply, out, cap)
    if rcFail < 0:
        return rcFail
    return 10
