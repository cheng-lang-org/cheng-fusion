# SSM1 本地播放核 → UniMaker 场景壳 C ABI provider (M3)。
#
# 合同 (campaigns/2026-09-06-csg-asset-pipeline/task_m3_unimaker_integration.md):
# 把 B/F 线已真机验证的 SSM1 播放核 (manifest.cheng + player.cheng, M1 安卓
# daemon 同闭包) 包成最小 C 导出面, 供 UniMaker 场景壳 (org.cheng.unimaker.scene)
# 进程内 dlopen/直接消费。纯数据面: 不接 GUI、不接网络传输 (归 M2 MoQ 线)、
# 不持 stdout/stdin (daemon 协议面留在 ssm1_tick_daemon.cheng)。
#
# 导出面 (C ABI, 全部显式错误, 无兜底):
#   ssm1_open(path) -> handle      载包 + PlayerInit(bufWindow=2000) + 立即
#                                  play; 失败回 0。handle = 槽位号+1。
#   ssm1_tick(h, dtMs) -> 状态串   复用 daemon 的 STATE 行格式
#                                  (posMs/playing/rate/eof/fetch/bufferedTo/pre);
#                                  错误回 "ERR <原因>"。
#   ssm1_seek(h, ms) -> 状态串     PlayerSeek 关键帧吸附语义; 回
#                                  "OK seek posMs=N" / "ERR seek_out_of_range"。
#   ssm1_close(h) -> int32         释放槽位 (0=ok, 1=invalid_handle)。
#   ssm1_string_free(p)            消费方释放 tick/seek 返回串 (libc heap,
#                                  先例: libp2p_string_free)。
#
# 返回串所有权 (先例 unimaker_compat_ffi.dupCString): strToCStringTemp 的
# cheng-heap 临时串立即 strdup 到 libc heap 返回, cheng 临时串随即用
# cheng_free 归还 — 分配器对称, 高频 tick 零泄漏零跨分配器 free。
#
# 槽位状态: 模块级 var 定长表 (先例: 场景壳 scene-runtime .so 同为 obj emit
# + 模块级 var 状态, 经 cheng_app_* 导出面跨 tick 存活)。链接纪律: 本 .so
# 以 -Bsymbolic + version script (除 ssm1_* 导出外全 local) 绑定, cheng_global_*
# 槽不跨 .so 抢占; cheng 运行时原语 (cheng_malloc/cheng_free/file bridges)
# 一律 undefined import, 经 DT_NEEDED libcheng_scene_runtime_provider.so
# BIND_NOW 解析 — 双分配器禁令同 unimaker-apk-build.mjs L148-150。
import std/system
import std/strings
import std/strutils
import cheng/game/assets/stream/manifest
import cheng/game/assets/stream/player

@importc("strdup")
fn ssm1LibcStrdup(s: cstring): cstring

@importc("free")
fn ssm1LibcFree(p: ptr)

@importc("cheng_free")
fn ssm1ChengFree(p: ptr)

# 固定槽数; 单壳内并发放不超过 4 条本地流 (M3 数据面足够, 拒绝动态表)。
fn Ssm1SlotCount(): int32 =
    return 4

# 预取窗口: 与 M1 真机 daemon 冒烟口径一致 (bufWindow=2000)。
fn Ssm1DefaultBufWindowMs(): int64 =
    return int64(2000)

type
    Ssm1Slot =
        used: bool
        m: manifest.StreamManifest
        p: player.StreamPlayerQ

var ssm1Slots: Ssm1Slot[4]

fn Ssm1AllocSlot(): int32 =
    for i in 0..<Ssm1SlotCount():
        if !ssm1Slots[i].used:
            return i
    return -1

fn Ssm1SlotIndex(handle: int64): int32 =
    if handle <= int64(0):
        return -1
    if handle > int64(Ssm1SlotCount()):
        return -1
    let idx: int32 = int32(handle - int64(1))
    if !ssm1Slots[idx].used:
        return -1
    return idx

# STATE 行格式逐字符对齐 ssm1_tick_daemon.cheng DaemonStateLine:
# pre 逐元素拷贝本地后再格式化 (托管 seq 元素不绑定)。
fn Ssm1StateLine(p: player.StreamPlayerQ, fetch: int32, pre: int32[]): str =
    var play01: str
    play01 = "0"
    if p.playing:
        play01 = "1"
    var eof01: str
    eof01 = "0"
    if p.eofLatched:
        eof01 = "1"
    var preParts: str[]
    for i in 0..<pre.len:
        let v = pre[i]
        add(preParts, strings.IntToStr(v))
    let preStr = strutils.Join(preParts, ",")
    return Fmt"STATE posMs={p.posMs} playing={play01} rate={p.rateX10} eof={eof01} fetch={fetch} bufferedTo={p.bufferedToMs} pre={preStr}"

# 见文件头所有权注释: cheng 临时串 strdup 后立即归还, 返回 libc heap 串。
fn Ssm1ReturnCString(text: str): cstring =
    var temp: cstring
    temp = system.strToCStringTemp(text)
    if temp == nil:
        return nil
    let copy: cstring = ssm1LibcStrdup(temp)
    ssm1ChengFree(ptr(temp))
    return copy

@exportc("ssm1_open")
fn ssm1_open(path: cstring): int64 =
    if path == nil:
        return int64(0)
    let pathText: str = StrFromCStringBorrow(path)
    if len(pathText) <= 0:
        return int64(0)
    let idx: int32 = Ssm1AllocSlot()
    if idx < 0:
        return int64(0)
    var freshM: manifest.StreamManifest
    if !manifest.StreamManifestLoadFileEmbedded(pathText, freshM):
        return int64(0)
    var freshP: player.StreamPlayerQ
    if !player.PlayerInit(freshP, freshM.totalDurationMs,
                          Ssm1DefaultBufWindowMs()):
        return int64(0)
    if !player.PlayerPlay(freshP):
        return int64(0)
    var slot: Ssm1Slot
    slot.used = true
    slot.m = freshM
    slot.p = freshP
    ssm1Slots[idx] = slot
    return int64(idx + 1)

@exportc("ssm1_tick")
fn ssm1_tick(handle: int64, dtMs: int32): cstring =
    let idx: int32 = Ssm1SlotIndex(handle)
    if idx < 0:
        return Ssm1ReturnCString("ERR invalid_handle")
    if dtMs < 0:
        return Ssm1ReturnCString("ERR bad_tick_dtms")
    # player 经本地副本过 var 形参, 成功后写回槽位 (避免全局字段直投 var)。
    var p: player.StreamPlayerQ
    p = ssm1Slots[idx].p
    var fetch: int32
    var pre: int32[]
    if !player.PlayerTick(p, int64(dtMs), ssm1Slots[idx].m, fetch, pre):
        return Ssm1ReturnCString("ERR tick_rejected")
    ssm1Slots[idx].p = p
    return Ssm1ReturnCString(Ssm1StateLine(p, fetch, pre))

@exportc("ssm1_seek")
fn ssm1_seek(handle: int64, targetMs: int32): cstring =
    let idx: int32 = Ssm1SlotIndex(handle)
    if idx < 0:
        return Ssm1ReturnCString("ERR invalid_handle")
    var p: player.StreamPlayerQ
    p = ssm1Slots[idx].p
    if !player.PlayerSeek(p, int64(targetMs)):
        return Ssm1ReturnCString("ERR seek_out_of_range")
    ssm1Slots[idx].p = p
    return Ssm1ReturnCString(Fmt"OK seek posMs={p.posMs}")

@exportc("ssm1_close")
fn ssm1_close(handle: int64): int32 =
    let idx: int32 = Ssm1SlotIndex(handle)
    if idx < 0:
        return 1
    var fresh: Ssm1Slot
    ssm1Slots[idx] = fresh
    return 0

@exportc("ssm1_string_free")
fn ssm1_string_free(value: void*) =
    if value != nil:
        ssm1LibcFree(value)
