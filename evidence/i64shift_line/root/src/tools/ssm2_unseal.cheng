# SSM2 v1 复合容器解封验证工具 (ssm2_hybrid_container 任务)。
#
# 用法: ssm2_unseal <container.ssm2> <outdir> [expectedSha256...]
#
# SSM2 v1 布局 (全小端, 与 tools/ssm2_pack.py 构建器同一冻结合同):
#   u8[4] magic = "SSM2"
#   u32   version = 1
#   u32   payloadCount = N (1..64)
#   N 条目 (每条 kindLen+84 字节):
#     u32    kindLen (1..128) + kind (ASCII, MIME 形)
#     i64    byteLen (>=1)
#     u8[64] sha256 (载荷字节 sha256, 64 小写 hex)
#     i64    offset (载荷绝对偏移)
#   载荷区按条目顺序无缝拼接: offset[0]=条目区末, offset[i+1]=offset[i]+byteLen[i],
#   末条终点 == EOF。容器 <= 256MiB (与 SSM1 manifest 配额同源)。
#
# 行为: 严格解析 (任何非法: magic/版本/计数/kind/截断/不连续/越界/尾部垃圾
# 显式失败非零退出, 无兜底无部分结果) → 逐载荷 sha256 计算, 与容器内 cid
# 逐字节对拍; 给了 expected 参数时逐条再对拍 (个数必须==payloadCount) →
# kind=application/x-csg-svblock 的载荷喂 SvValidate (全量规则) →
# 载荷落盘 <outdir>/payload_<i>.bin。任一断言失败即非零退出。
import std/cmdline
import std/os
import std/rawbytes
import std/crypto/sha256
import std/strings
import cheng/game/assets/import/reader
import cheng/game/assets/semantic_video/validator

const UnsealQuotaMaxBytes = 268435456      # 256MiB, 与 SSM1 manifest 配额同源
const UnsealMaxPayloads = 64
const UnsealMaxKindLen = 128
const UnsealCidLen = 64
const UnsealEntryFixedBytes = 84           # kindLen u32 + byteLen i64 + cid 64 + offset i64
const UnsealSvblockKind = "application/x-csg-svblock"

fn UnsealEmit(line: str) =
    os.Write(os.Get_stdout(), line)
    os.Write(os.Get_stdout(), "\n")
    var flushed: int32
    flushed = os.C_fflush(os.Get_stdout())
    if flushed != 0:
        panic("unseal_stdout_flush_failed")

# i64 小端读取: 两次 u32 组合, hi>=2^31 按补码重建 (随后由范围契约拒绝)。
@borrows
fn UnsealI64At(data: rawbytes.Bytes, offset: int32, out: var int64): bool =
    var lo: int64
    var hi: int64
    if !reader.AssetReaderU32At(data, offset, lo):
        return false
    if !reader.AssetReaderU32At(data, offset + 4, hi):
        return false
    if hi >= int64(2147483648):
        out = lo + ((hi - int64(4294967296)) * int64(4294967296))
    else:
        out = lo + (hi * int64(4294967296))
    return true

# 小写 hex 字节 ([0-9a-f])。
fn UnsealHexByte(c: int32): bool =
    if c >= Int32('0') && c <= Int32('9'):
        return true
    if c >= Int32('a') && c <= Int32('f'):
        return true
    return false

# 单载荷全链: kind 提取 → 载荷视图 → sha256 对拍 (容器 cid + 可选 expected)
# → svblock kind 喂 validator → 落盘 → 回执行。返回本载荷是否全过。
@borrows
fn UnsealOnePayload(data: rawbytes.Bytes, index: int32, kindOff: int32,
                    kindLen: int32, cidOff: int32, payOff: int64,
                    payLen: int64, outDir: str, expect: str,
                    expectGiven: bool): bool =
    var kind = rawbytes.BytesToString(
        rawbytes.BytesSliceView(data, kindOff, kindLen))
    var view = rawbytes.BytesSliceView(data, int32(payOff), int32(payLen))
    var digest = sha256.Sha256Digest(view)
    var hex = rawbytes.BytesToHex(digest)

    # 容器内 cid 逐字节对拍 (不建 str, 直接比字节)。
    var cidMatch = true
    for k in 0..<UnsealCidLen:
        if Int32(hex[k]) != rawbytes.BytesGet(data, cidOff + k):
            cidMatch = false
    var expectMatch = true
    if expectGiven:
        if hex != expect:
            expectMatch = false

    var valOk = true
    var valNote = "n/a"
    if kind == UnsealSvblockKind:
        var validation = validator.SvValidate(view)
        if validation.ok:
            valNote = "ok"
        else:
            valOk = false
            valNote = validation.error

    let outPath = Fmt"{outDir}/payload_{index}.bin"
    let wres = os.WriteFileBytesResult(outPath, view)
    if IsErr(wres):
        UnsealEmit(Fmt"ERR payload_write idx={index} err={ErrorText(wres)}")
        return false

    UnsealEmit(Fmt"payload[{index}] kind={kind} bytes={payLen} offset={payOff} sha256={hex} cidMatch={cidMatch} expectedMatch={expectMatch} svblockValidator={valNote} extracted={outPath}")
    return cidMatch && expectMatch && valOk

fn main(argc: int32, argv: ptr): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 2:
        UnsealEmit("usage: ssm2_unseal <container.ssm2> <outdir> [expectedSha256...]")
        return 2
    let inPath = cmdline.ParamStr(1)
    let outDir = cmdline.ParamStr(2)
    # ParamCount() = argc (含 argv[0]); 容器=ParamStr(1), 目录=ParamStr(2),
    # 期望哈希从 ParamStr(3) 起, 个数 = ParamCount() - 3。
    let expectCount = cmdline.ParamCount() - 3

    # === 读容器 (显式配额, 拒绝超限) ===
    var fileRes = os.ReadFileBytesResult(inPath)
    if IsErr(fileRes):
        UnsealEmit(Fmt"ERR container_read path={inPath} err={ErrorText(fileRes)}")
        return 1
    var data = Value(fileRes)
    defer:
        rawbytes.BytesFree(data)
    let n64 = int64(rawbytes.BytesLen(data))
    if n64 <= 0 || n64 > UnsealQuotaMaxBytes:
        UnsealEmit("ERR container_quota")
        return 1
    if n64 < int64(12):
        UnsealEmit("ERR container_truncated_header")
        return 1

    # === 头: magic/version/count ===
    if rawbytes.BytesGet(data, 0) != Int32('S'):
        UnsealEmit("ERR magic")
        return 1
    if rawbytes.BytesGet(data, 1) != Int32('S'):
        UnsealEmit("ERR magic")
        return 1
    if rawbytes.BytesGet(data, 2) != Int32('M'):
        UnsealEmit("ERR magic")
        return 1
    if rawbytes.BytesGet(data, 3) != Int32('2'):
        UnsealEmit("ERR magic")
        return 1
    var version: int64
    if !reader.AssetReaderU32At(data, 4, version):
        UnsealEmit("ERR version_read")
        return 1
    if version != int64(1):
        UnsealEmit("ERR version")
        return 1
    var count64: int64
    if !reader.AssetReaderU32At(data, 8, count64):
        UnsealEmit("ERR count_read")
        return 1
    if count64 < int64(1) || count64 > int64(UnsealMaxPayloads):
        UnsealEmit("ERR count_range")
        return 1
    let count = int32(count64)
    if int64(expectCount) != int64(0) && int64(expectCount) != count64:
        UnsealEmit(Fmt"ERR expect_count got={expectCount} payloads={count}")
        return 1

    # === 条目区结构校验 (纯字节面, 不建托管量): kindLen/ASCII/hex/byteLen/偏移连续 ===
    var cursor: int64
    cursor = int64(12)
    var payOff: int64
    var payLen: int64
    var firstOff: int64
    payOff = int64(0)
    payLen = int64(0)
    firstOff = int64(-1)
    for i in 0..<count:
        var kindLen: int64
        if !reader.AssetReaderU32At(data, int32(cursor), kindLen):
            UnsealEmit(Fmt"ERR kindlen_read idx={i}")
            return 1
        if kindLen < int64(1) || kindLen > int64(UnsealMaxKindLen):
            UnsealEmit(Fmt"ERR kindlen_range idx={i}")
            return 1
        var k: int32
        k = 0
        while k < int32(kindLen):
            let c = rawbytes.BytesGet(data, int32(cursor) + 4 + k)
            if c < Int32(' ') || c > Int32('~'):
                UnsealEmit(Fmt"ERR kind_ascii idx={i}")
                return 1
            k = k + 1
        var byteLen: int64
        if !UnsealI64At(data, int32(cursor) + 4 + int32(kindLen), byteLen):
            UnsealEmit(Fmt"ERR bytelen_read idx={i}")
            return 1
        if byteLen < int64(1):
            UnsealEmit(Fmt"ERR bytelen_range idx={i}")
            return 1
        let cidOff = int32(cursor) + 4 + int32(kindLen) + 8
        for h in 0..<UnsealCidLen:
            if !UnsealHexByte(rawbytes.BytesGet(data, cidOff + h)):
                UnsealEmit(Fmt"ERR cid_hex idx={i}")
                return 1
        var off: int64
        if !UnsealI64At(data, cidOff + UnsealCidLen, off):
            UnsealEmit(Fmt"ERR offset_read idx={i}")
            return 1
        if off < int64(0) || byteLen > n64 - off:
            UnsealEmit(Fmt"ERR payload_range idx={i}")
            return 1
        # 无缝拼接: 首条 offset == 全部条目区末 (循环后判定), 后续依次相接。
        if i == 0:
            firstOff = off
            payOff = off
        else:
            if off != payOff + payLen:
                UnsealEmit(Fmt"ERR gap idx={i}")
                return 1
        payOff = off
        payLen = byteLen
        cursor = cursor + int64(UnsealEntryFixedBytes) + kindLen
    let headerLen = cursor
    if firstOff != headerLen:
        UnsealEmit("ERR first_offset")
        return 1
    if payOff + payLen != n64:
        UnsealEmit("ERR eof_garbage")
        return 1

    # === 落盘目录 ===
    if !os.DirExists(outDir):
        os.MkdirAll(outDir, 493)
        if !os.DirExists(outDir):
            UnsealEmit(Fmt"ERR outdir path={outDir}")
            return 1

    # === 逐载荷解封验证 (重走条目区取精确字段) ===
    var ecur: int64
    ecur = int64(12)
    var allOk = true
    for i in 0..<count:
        var kindLen: int64
        if !reader.AssetReaderU32At(data, int32(ecur), kindLen):
            UnsealEmit(Fmt"ERR reparse idx={i}")
            return 1
        let kindOff = int32(ecur) + 4
        let lenOff = kindOff + int32(kindLen)      # byteLen i64
        let cidOff = lenOff + 8                    # cid 64B
        var off: int64
        var byteLen: int64
        if !UnsealI64At(data, cidOff + UnsealCidLen, off):
            UnsealEmit(Fmt"ERR reparse_off idx={i}")
            return 1
        if !UnsealI64At(data, lenOff, byteLen):
            UnsealEmit(Fmt"ERR reparse_len idx={i}")
            return 1
        var expect: str
        var expectGiven = false
        if expectCount > 0:
            var e: str
            e = cmdline.ParamStr(3 + i)
            expect = e
            expectGiven = true
        if !UnsealOnePayload(data, i, kindOff, int32(kindLen), cidOff,
                             off, byteLen, outDir, expect, expectGiven):
            allOk = false
        ecur = ecur + int64(UnsealEntryFixedBytes) + kindLen

    # === 容器整体 sha256 (自证回执) ===
    var wholeDigest = sha256.Sha256Digest(data)
    var wholeHex = rawbytes.BytesToHex(wholeDigest)
    if allOk:
        UnsealEmit(Fmt"ssm2 ok payloads={count} headerLen={headerLen} fileLen={n64} containerSha256={wholeHex}")
        return 0
    UnsealEmit(Fmt"ssm2 FAIL payloads={count} headerLen={headerLen} fileLen={n64} containerSha256={wholeHex}")
    return 1
