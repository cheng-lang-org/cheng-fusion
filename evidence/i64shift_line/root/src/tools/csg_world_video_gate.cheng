# csg_world_video_gate (E3): consolidated acceptance gate for the CSG
# semantic-physical-world video line. Real-entry checks only:
#   1. time contract probe            (src/tests/csg_world_time_probe.cheng)
#   2. analytic physics cases         (src/tests/csg_world_physics_cases.cheng)
#   3. B-chain execution smoke        (src/tests/csg_world_execution_smoke.cheng)
#   4. film pipeline determinism: the world_cinema app runs twice and the
#      execution chain CIDs must match byte-for-byte
#   5. manifest truth: frame counts, causal metrics, rejection counts and
#      a frame hash are read from the produced manifest and files
# Any FAIL exits non-zero; nothing is credited without a live run.
import std/cmdline
import std/os
import std/strings as strings
import std/strutils as strutil
import std/os_host_process as hostos

const
    GateSchema = "cheng.tools.csg_world_video_gate.v1"
    FilmSource = "src/apps/world_cinema/main.cheng"
    FilmOutDir = "artifacts/csg_world_video"

@borrows
fn appendCheck(name: str, status: str, detail: str) =
    echo(Fmt"check={name} status={status} detail={detail}")

@borrows
fn argValue(args: str[], flag: str): str =
    let prefix = Fmt"--{flag}:"
    var i: int32 = 0
    while i < args.len:
        if strings.HasPrefix(args[i], prefix):
            return strings.CloneStrRange(args[i], prefix.len, args[i].len - prefix.len)
        i = i + 1
    return ""

@borrows
fn runCompile(compiler: str, root: str, source: str, outPath: str): int32 =
    let res = hostos.ExecFileCapture(compiler,
        ["system-link-exec",
         Fmt"--root:{root}",
         Fmt"--in:{root}/{source}",
         "--emit:exe",
         "--target:arm64-apple-darwin",
         Fmt"--out:{outPath}"],
        [], "", true, 900)
    let _errOut = os.WriteFile(Fmt"{outPath}.err", os.ExecCmdResultOutput(res))
    return os.ExecCmdResultExitCode(res)

@borrows
fn runBinary(path: str): int32 =
    let res = hostos.ExecFileCapture(path, [], [], "", true, 900)
    return os.ExecCmdResultExitCode(res)

@borrows
fn fileSha256(path: str): str =
    let res = hostos.ExecFileCapture("/usr/bin/shasum",
        ["-a", "256", Fmt"{path}"], [], "", true, 120)
    let out = os.ExecCmdResultOutput(res)
    let head = strutil.Strip(out)
    if head.len < 64:
        return "sha256-unavailable"
    return strings.CloneStrRange(head, 0, 64)

@borrows
fn manifestValue(text: str, key: str): str =
    var i: int32 = 0
    var start: int32 = 0
    while i <= text.len:
        if i == text.len:
            let line = strings.CloneStrRange(text, start, i - start)
            if strings.HasPrefix(line, key + "="):
                return strings.CloneStrRange(line, key.len + 1, line.len - key.len - 1)
            return ""
        if text[i] == char(10):
            let line = strings.CloneStrRange(text, start, i - start)
            if strings.HasPrefix(line, key + "="):
                return strings.CloneStrRange(line, key.len + 1, line.len - key.len - 1)
            start = i + 1
        i = i + 1
    return ""

fn main(): int32 =
    var args: str[]
    var ai: int32 = 0
    while ai < cmdline.paramCount():
        add(args, cmdline.paramStr(ai))
        ai = ai + 1
    let root = argValue(args, "root")
    let compiler = argValue(args, "compiler")
    let work = argValue(args, "work")
    if root == "" || compiler == "" || work == "":
        echo("usage: csg_world_video_gate --root:<repoRoot> --compiler:<path> --work:<dir>")
        return 2
    os.MkdirAll(work, 493)
    var fails: int32 = 0

    # 1-5: probe, analytic cases, execution smoke, D1 render, F-a walk
    var probeNames: str[] = ["csg_world_time_probe", "csg_world_physics_cases", "csg_world_execution_smoke", "d1_character_render_probe", "csg_world_walk_smoke", "prompt_parse_probe"]
    var pi: int32 = 0
    while pi < probeNames.len:
        let name = probeNames[pi]
        let src = "src/tests/" + name + ".cheng"
        let bin = work + "/" + name
        let crc = runCompile(compiler, root, src, bin)
        if crc != 0:
            appendCheck(name, "FAIL", "compile rc!=0")
            fails = fails + 1
        else:
            let rrc = runBinary(bin)
            if rrc != 0:
                appendCheck(name, "FAIL", Fmt"run rc={rrc}")
                fails = fails + 1
            else:
                appendCheck(name, "PASS", "compiled and ran green")
        pi = pi + 1

    # 4: film pipeline, twice, chain CIDs must match
    var chainA: str = ""
    var chainB: str = ""
    var run: int32 = 0
    while run < 2:
        let bin = work + "/world_cinema_run" + strings.IntToStr(run)
        let crc = runCompile(compiler, root, FilmSource, bin)
        if crc != 0:
            appendCheck("film_compile", "FAIL", "compile rc!=0")
            fails = fails + 1
            run = run + 1
            continue
        # the film app writes to its repo-relative output dir: run it from root
        let shRes = hostos.ExecFileCapture("/bin/sh",
            ["-c", Fmt"cd '{root}' && '{bin}'"],
            [], "", true, 900)
        let rrc = os.ExecCmdResultExitCode(shRes)
        if rrc != 0:
            appendCheck("film_run", "FAIL", Fmt"run rc={rrc}")
            fails = fails + 1
        let manText = os.ReadFile(FilmOutDir + "/manifest.txt")
        let chain = manifestValue(manText, "chainCid")
        if run == 0:
            chainA = chain
        else:
            chainB = chain
        run = run + 1
    if chainA == "":
        appendCheck("film_chain", "FAIL", "chainCid missing")
        fails = fails + 1
    else:
        if chainA == chainB:
            appendCheck("film_chain", "PASS", "deterministic across runs")
        else:
            appendCheck("film_chain", "FAIL", "chain CIDs diverged")
            fails = fails + 1

    # 5: manifest truth
    let manText = os.ReadFile(root + "/" + FilmOutDir + "/manifest.txt")
    let frames = manifestValue(manText, "normalFrames")
    let ivFrames = manifestValue(manText, "interventionFrames")
    let comErrMm = manifestValue(manText, "interventionComErrMm")
    let noContact = manifestValue(manText, "interventionNoContact")
    let rejections = manifestValue(manText, "rejections")
    let charCid = manifestValue(manText, "characterCid")
    if charCid.len == 64:
        appendCheck("character_asset", "PASS", "skeleton table bound")
    else:
        appendCheck("character_asset", "FAIL", "characterCid invalid")
        fails = fails + 1
    if frames == "240":
        appendCheck("normal_frames", "PASS", "240 frames")
    else:
        appendCheck("normal_frames", "FAIL", Fmt"frames={frames}")
        fails = fails + 1
    let ivOk: bool = ivFrames != "" && ivFrames != "0"
    if ivOk:
        appendCheck("intervention_frames", "PASS", Fmt"frames={ivFrames}")
    else:
        appendCheck("intervention_frames", "FAIL", Fmt"frames={ivFrames}")
        fails = fails + 1
    if rejections == "0":
        appendCheck("physics_rejections", "PASS", "0 rejected steps")
    else:
        appendCheck("physics_rejections", "FAIL", Fmt"rejections={rejections}")
        fails = fails + 1
    if noContact == "1":
        appendCheck("removal_no_contact", "PASS", "250ms window contact-free")
    else:
        appendCheck("removal_no_contact", "FAIL", "contact inside window")
        fails = fails + 1
    let firstFrame = root + "/" + FilmOutDir + "/normal/f0000.ppm"
    let frameHash = fileSha256(firstFrame)
    if frameHash.len == 64:
        appendCheck("frame_hash", "PASS", frameHash)
    else:
        appendCheck("frame_hash", "FAIL", "missing first frame")
        fails = fails + 1

    echo(Fmt"{GateSchema} fails={fails}")
    if fails > 0:
        return 1
    echo("PASS csg_world_video_gate")
    return 0
