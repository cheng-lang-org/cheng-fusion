# fishing 统一验收器 (纯 Cheng)。
#
# 用法:
#   fishing_gate baseline --root:<repoRoot> --compiler:<compilerPath> [--target:<triple>] [--fixtures:<dir>]
#   fishing_gate <device|assets|simulation|network|recovery|performance|release> ...
#
# A1 落地范围: baseline 阶段。其余阶段为显式 NOT_IMPLEMENTED, 一律非零退出,
# 不产出 PASS。判定契约:
#   - 六个既有 smoke + fishing_platform_contract 编译 rc=0 且运行 rc=0 才算 PASS;
#   - 三个负例夹具必须编译被拒 (rc!=0) 才算 PASS;
#   - 任一 FAIL 使 baseline 退出码非零, 报告逐项列出, 缺项不得折算为通过。
# 夹具 (探针/负例) 存于战役 fixtures/ 目录, baseline 运行时暂存进 src/tests/
# (cold 链要求输入在包根 src/ 下), 结束即删除, 不留任务外残物。
# 契约注记: str 形参助手一律 @borrows (规范 §0.2 非 var 托管形参默认 move);
# 借用值入容器/外呼一律先 Fmt 拷贝产出 owned 值。
import std/cmdline
import std/os
import std/strings as strings
import std/strutils as strutil
import std/os_host_process as hostos

const
    GateSchema = "cheng.fishing.gate.v1"
    FixturesDefault = "docs/campaigns/2026-09-05-pure-cheng-fishing/fixtures"

# 流式报告: 每项判定立即落 stdout (含 str 字段的结构体入 seq 是已知崩溃
# 禁区: src/game/ecs.cheng 卷首警示; 本轮 baseline 实测 SIGBUS, W-A1-8)。
@borrows
fn appendCheck(name: str, status: str, detail: str) =
    echo(Fmt"check={name} status={status} detail={detail}")

@borrows
fn fileSha256(path: str): str =
    let res = hostos.ExecFileCapture("/usr/bin/shasum",
        ["-a", "256", Fmt"{path}"], [], "", true, 120)
    let out = os.ExecCmdResultOutput(res)
    let head = strutil.Strip(out)
    if head.len < 64:
        return "sha256-unavailable"
    return strings.CloneStrRange(head, 0, 64)

@borrows
fn argValue(args: str[], flag: str): str =
    let prefix = Fmt"--{flag}:"
    for i in 0..<args.len:
        if strings.HasPrefix(args[i], prefix):
            # 精确长度切片: MAX count 在 start>0 时触发 strings.CloneStrRange
            # 钳制条件 int32 溢出(safeStart+safeCount<0), 绕过钳制成 2GB 拷贝。
            return strings.CloneStrRange(args[i], prefix.len, args[i].len - prefix.len)
    return ""

@borrows
fn runCompile(compiler: str, root: str, target: str, source: str,
              outPath: str, logPath: str): int32 =
    # /usr/bin/time -l 包裹, 峰值 RSS 落日志; 编译只读源文件。
    let res = hostos.ExecFileCapture("/usr/bin/time",
        ["-l", "-o", Fmt"{logPath}", Fmt"{compiler}",
         "system-link-exec",
         Fmt"--root:{root}",
         Fmt"--in:{source}",
         "--emit:exe",
         Fmt"--target:{target}",
         Fmt"--out:{outPath}"],
        [], "", true, 600)
    # 子进程 stderr 不经 time -o, 单独落盘供失败诊断。
    let _childOut = os.WriteFile(Fmt"{logPath}.err", os.ExecCmdResultOutput(res))
    return os.ExecCmdResultExitCode(res)

@borrows
fn runBinary(path: str): int32 =
    let res = hostos.ExecFileCapture(Fmt"{path}", [], [], "", true, 120)
    return os.ExecCmdResultExitCode(res)

@borrows
fn stageFixtures(fixturesDir: str, srcTestsDir: str, staged: var str[]): int32 =
    # 注意: 不得 import cheng/core/tooling/path —— ★重案 631 触发身份即该真实
    # 文件, 其函数在导入闭包内假阴/失灵; 门禁全程只用 os 原语。
    let listing = os.ListDir(Fmt"{fixturesDir}")
    for i in 0..<listing.len:
        # ListDir 项可能是名字或全路径(实现相关), ExtractFilename 归一。
        # ExtractFilename 形参为 move: 先 Fmt 拷贝出 owned 项再传入。
        let entry = Fmt"{listing[i]}"
        let name = Fmt"{os.ExtractFilename(entry)}"
        if !strings.HasSuffix(name, ".cheng"):
            continue
        let source = Fmt"{fixturesDir}/{name}"
        let text = os.ReadFile(source)
        if len(text) <= 0:
            return 2
        let target = Fmt"{srcTestsDir}/{name}"
        # os.WriteFile 返回 void: 写后回读比对作为成功判据。
        os.WriteFile(target, text)
        if os.ReadFile(target) != text:
            return 3
        add(staged, Fmt"{name}")
    return 0

@borrows
fn unstageFixtures(srcTestsDir: str, staged: str[]) =
    for i in 0..<staged.len:
        let _removed = os.RemoveFile(Fmt"{srcTestsDir}/{staged[i]}")

@borrows
fn baselineStage(rootRaw: str, compiler: str, target: str, fixturesDir: str): int32 =
    let srcPrefix = Fmt"{rootRaw}/src/tests/"
    let srcTestsDir = Fmt"{rootRaw}/src/tests"
    let outDir = Fmt"{rootRaw}/artifacts/fishing_gate/baseline"
    os.MkdirAll(outDir, 493)
    let compilerSha = fileSha256(compiler)
    var passCount: int32
    var failCount: int32
    appendCheck("compiler_sha256", "INFO", compilerSha)

    var staged: str[]
    let stageRc = stageFixtures(fixturesDir, srcTestsDir, staged)
    if stageRc != 0:
        appendCheck("stage_fixtures", "FAIL", Fmt"rc={stageRc} dir={fixturesDir}")
        echo(Fmt"{GateSchema} baseline: stage_fixtures failed rc={stageRc}")
        return 1
    appendCheck("stage_fixtures", "INFO", Fmt"staged={staged.len}")

    var positive: str[]
    add(positive, "ecs_capacity_smoke.cheng")
    add(positive, "ecs_world_hash_smoke.cheng")
    add(positive, "physics2d_collision_smoke.cheng")
    add(positive, "physics2d_determinism_smoke.cheng")
    add(positive, "physics2d_forces_determinism_smoke.cheng")
    add(positive, "game_tick_replay_smoke.cheng")
    add(positive, "fishing_platform_contract.cheng")

    for i in 0..<positive.len:
        let name = Fmt"{positive[i]}"
        let stem = strings.CloneStrRange(name, 0, name.len - 6)
        let source = Fmt"{srcPrefix}{name}"
        let outPath = Fmt"{outDir}/{stem}"
        let logPath = Fmt"{outDir}/{stem}.compile.log"
        let crc = runCompile(compiler, rootRaw, target, source, outPath, logPath)
        if crc != 0:
            appendCheck(name, "FAIL", Fmt"compile_rc={crc} log={logPath}")
            failCount = failCount + 1
            continue
        let rrc = runBinary(outPath)
        if rrc != 0:
            appendCheck(name, "FAIL", Fmt"run_rc={rrc}")
            failCount = failCount + 1
            continue
        appendCheck(name, "PASS", "compile_rc=0 run_rc=0")
        passCount = passCount + 1
        # 计数留在调用点: @borrows+var int32 计数形在 C 车头 codegen 下双执行

    # 负例: 必须编译被拒。
    var negatives: str[]
    # neg1_ptr 留档不断言: ptr 拒绝属 no-pointer 策略门禁层, 本编译入口不拒
    # (capabilities.json W-A1-7)。
    add(negatives, "fishing_a1_neg2_use_after_move.cheng")
    add(negatives, "fishing_a1_neg3_borrowed_add.cheng")
    add(negatives, "fishing_a1_neg4_redundant_init.cheng")
    for i in 0..<negatives.len:
        let name = Fmt"{negatives[i]}"
        let stem = strings.CloneStrRange(name, 0, name.len - 6)
        let source = Fmt"{srcPrefix}{name}"
        let outPath = Fmt"{outDir}/{stem}"
        let logPath = Fmt"{outDir}/{stem}.compile.log"
        let crc = runCompile(compiler, rootRaw, target, source, outPath, logPath)
        if crc == 0:
            appendCheck(name, "FAIL", "negative compiled but must be rejected")
            failCount = failCount + 1
            continue
        appendCheck(name, "PASS", Fmt"rejected compile_rc={crc}")
        passCount = passCount + 1

    unstageFixtures(srcTestsDir, staged)

    echo(Fmt"{GateSchema} baseline target={target} compiler={compiler}")
    echo(Fmt"checks_pass={passCount} checks_fail={failCount}")
    if failCount > 0:
        echo("baseline: FAIL (缺项不得折算为通过)")
        return 1
    echo("baseline: PASS")
    return 0

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 1:
        echo("usage: fishing_gate <stage> [--root:<path>] [--compiler:<path>] [--target:<triple>] [--fixtures:<dir>]")
        return 2
    var args: str[]
    let stage = Fmt"{cmdline.paramStr(1)}"
    for i in 2..<(argc + 1):
        add(args, Fmt"{cmdline.paramStr(i)}")
    let root = argValue(args, "root")
    let compiler = argValue(args, "compiler")
    let target = argValue(args, "target")
    let fixtures = argValue(args, "fixtures")
    if stage == "baseline":
        if strutil.Strip(root).len <= 0 || strutil.Strip(compiler).len <= 0:
            echo("baseline requires --root:<repoRoot> and --compiler:<compilerPath>")
            return 2
        let t = if strutil.Strip(target).len > 0: Fmt"{target}" else: "arm64-apple-darwin"
        let f = if strutil.Strip(fixtures).len > 0: Fmt"{fixtures}" else: Fmt"{root}/{FixturesDefault}"
        return baselineStage(root, compiler, t, f)
    echo(Fmt"stage={stage} status=NOT_IMPLEMENTED (拟新增门在落地前不得调用或填PASS)")
    return 3
