import std/strings
import std/os
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

# CSG语义视频独立参考解码器（纯 Cheng 第二实现）。
# 独立性合同（主方案 §9.1 一）：不复用生产解析器 src/core/csg_core/csgc.cheng
# 的任何解码函数——本文件按 docs/csg-core-standard.md 字节合同独立实现
# LEB128、header/directory/字典/事实节解析与 section digest/claimed
# directory CID 重算；对冻结夹具 b1_sample.svblock 做结构对拍。
# 仅依赖 std 原语（sha256/bytes），与 Python hashlib 同类。

const
    SvRefMagic: int32 = 0x43475343
    SvRefSectionDomain: str = "csg_core.csgc.section"
    SvRefDirClaimDomain: str = "csg_core.csgc.directory.claim"
    SvRefSchemaValue: str = "csg_semantic_video::v0.1"
    SvRefExpectedFactCount: int32 = 12
    SvRefExpectedSections: int32 = 11
    SvRefExpectedDirCid: str = "sha256:3d40a52b198d228d6ca38bce35feb83e20f0769e9783b44e9723b4ae99f3315c"
    SvRefExpectedContentId: str = "sha256:ab06b69acf38ebbc362a25cda790fa3b34c31eba15e708705e6b8614160f8882"

@borrows
fn refFail(reason: str): int32 =
    echo(strings.ConcatStr("sv_ref_decoder FAIL: ", reason))
    return 1

fn refU16le(b: rawbytes.Bytes, off: int32): int32 =
    return (rawbytes.BytesGet(b, off) & 255) |
        ((rawbytes.BytesGet(b, off + 1) & 255) << 8)

fn refU32le(b: rawbytes.Bytes, off: int32): int32 =
    return (rawbytes.BytesGet(b, off) & 255) |
        ((rawbytes.BytesGet(b, off + 1) & 255) << 8) |
        ((rawbytes.BytesGet(b, off + 2) & 255) << 16) |
        ((rawbytes.BytesGet(b, off + 3) & 255) << 24)

fn refVaruint(b: rawbytes.Bytes, off: var int32,
        outVal: var int64): bool =
    var value: int64 = 0
    var shift: int32 = 0
    while true:
        if off >= rawbytes.BytesLen(b) || shift > 42:
            return false
        let byte = rawbytes.BytesGet(b, off) & 255
        off = off + 1
        value = value + int64(byte & 127) * refPow2(shift)
        if (byte & 128) == 0:
            outVal = value
            return true
        shift = shift + 7

fn refPow2(shift: int32): int64 =
    var out: int64 = 1
    var i: int32 = 0
    while i < shift:
        out = out * int64(2)
        i = i + 1
    return out

@borrows
fn refAppendText(buf: var layout.ByteBuf, text: str) =
    layout.ByteBufAppendByte(buf, text.len & 255)
    layout.ByteBufAppendByte(buf, (text.len >> 8) & 255)
    layout.ByteBufAppendByte(buf, (text.len >> 16) & 255)
    layout.ByteBufAppendByte(buf, (text.len >> 24) & 255)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, text[i])

fn refAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

fn refAppendBytes(buf: var layout.ByteBuf, data: rawbytes.Bytes) =
    for i in 0..<rawbytes.BytesLen(data):
        layout.ByteBufAppendByte(buf, rawbytes.BytesGet(data, i) & 255)

@borrows
fn refSha256HexFramed(domain: str, tail: var layout.ByteBuf): str =
    var full = layout.ByteBufInit(domain.len + layout.ByteBufLen(tail) + 16)
    refAppendText(full, domain)
    refAppendBytes(full, layout.ByteBufToBytes(tail))
    let digest = hash256.Sha256Fixed(layout.ByteBufView(full))
    layout.ByteBufFree(full)
    return strings.ConcatStr("sha256:", layout.FixedBytes32Hex(digest))

fn refDigestHex(b: rawbytes.Bytes, off: int32): str =
    var hex: str = ""
    for i in 0..<32:
        let byte = rawbytes.BytesGet(b, off + i) & 255
        let hi = byte >> 4
        let lo = byte & 15
        hex = strings.ConcatStr(hex, refHexDigit(hi))
        hex = strings.ConcatStr(hex, refHexDigit(lo))
    return hex

@borrows
fn refHexDigit(value: int32): str =
    let hexDigits: str = "0123456789abcdef"
    return strings.SliceBytes(hexDigits, value, 1)

# 节目录项的独立表示（值字段平铺，digest 以 32 字节 hex 记录）。
type
    RefSection =
        tag: int32
        kind: str
        payloadOffset: int32
        payloadLength: int32
        itemCount: int32
        digestHex: str

@borrows
fn refSectionDigestHex(fileBytes: rawbytes.Bytes,
        section: RefSection): str =
    var buf = layout.ByteBufInit(64)
    refAppendText(buf, SvRefSectionDomain)
    layout.ByteBufAppendByte(buf, section.tag & 255)
    refAppendText(buf, section.kind)
    refAppendU32(buf, section.itemCount)
    refAppendU32(buf, section.payloadLength)
    var payload: rawbytes.Bytes = rawbytes.BytesSlice(fileBytes,
        section.payloadOffset + 64, section.payloadLength)
    refAppendBytes(buf, payload)
    rawbytes.BytesFree(payload)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return layout.FixedBytes32Hex(digest)

# 顶层键扫描 + 升序（canonical 键序）检查：独立文本实现。
@borrows
fn refKeysAscending(line: str): bool =
    if line.len < 2 || line[0] != '{':
        return false
    var prev: str = ""
    var at: int32 = 1
    while at < line.len:
        if line[at] == '}':
            return true
        if line[at] != '"':
            return false
        var keyEnd: int32 = at + 1
        var escaped = false
        while keyEnd < line.len:
            let ch = line[keyEnd]
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                break
            keyEnd = keyEnd + 1
        if keyEnd >= line.len:
            return false
        let key = strings.SliceBytes(line, at + 1, keyEnd - at - 1)
        if prev.len > 0 && !refStrLess(prev, key):
            return false
        prev = strings.CloneStr(key)
        var valueAt: int32 = keyEnd + 1
        if valueAt >= line.len || line[valueAt] != ':':
            return false
        valueAt = valueAt + 1
        if valueAt >= line.len:
            return false
        if line[valueAt] == '"':
            var strEnd: int32 = valueAt + 1
            var strEscaped = false
            while strEnd < line.len:
                let ch = line[strEnd]
                if strEscaped:
                    strEscaped = false
                elif ch == '\\':
                    strEscaped = true
                elif ch == '"':
                    break
                strEnd = strEnd + 1
            if strEnd >= line.len:
                return false
            at = strEnd + 1
        elif line[valueAt] == '{' || line[valueAt] == '[':
            var depth: int32 = 0
            var scan: int32 = valueAt
            while scan < line.len:
                let ch = line[scan]
                if ch == '"':
                    var inner: int32 = scan + 1
                    var innerEscaped = false
                    while inner < line.len:
                        let ich = line[inner]
                        if innerEscaped:
                            innerEscaped = false
                        elif ich == '\\':
                            innerEscaped = true
                        elif ich == '"':
                            break
                        inner = inner + 1
                    if inner >= line.len:
                        return false
                    scan = inner
                elif ch == '{' || ch == '[':
                    depth = depth + 1
                elif ch == '}' || ch == ']':
                    depth = depth - 1
                    if depth == 0:
                        break
                scan = scan + 1
            if scan >= line.len:
                return false
            at = scan + 1
        else:
            while at < line.len && line[at] != ',' && line[at] != '}':
                at = at + 1
            if at >= line.len:
                return false
        if at < line.len && line[at] == ',':
            at = at + 1
    return false

@borrows
fn refStrLess(left: str, right: str): bool =
    let common = left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let a = int32(left[i]) & 255
        let b = int32(right[i]) & 255
        if a != b:
            return a < b
    return left.len < right.len

@borrows
fn refLineKind(line: str): str =
    let marker = "\"kind\":\""
    let found = strings.StrContains(line, marker)
    if !found:
        return ""
    var at: int32 = 0
    var start: int32 = -1
    while at + marker.len <= line.len:
        var matched = true
        for j in 0..<marker.len:
            if line[at + j] != marker[j]:
                matched = false
                break
        if matched:
            start = at + marker.len
            break
        at = at + 1
    if start < 0:
        return ""
    var end: int32 = start
    while end < line.len && line[end] != '"':
        end = end + 1
    return strings.SliceBytes(line, start, end - start)

@borrows
fn refContains(line: str, needle: str): bool =
    return strings.StrContains(line, needle)

@borrows
fn refKindIndex(kind: str, kinds: str[]): int32 =
    for i in 0..<kinds.len:
        if kinds[i] == kind:
            return i
    return -1

@borrows
@borrows
fn refRun(fileBytes: rawbytes.Bytes): int32 =
    let totalLen = rawbytes.BytesLen(fileBytes)
    if totalLen < 64:
        return refFail("truncated_header")
    if refU32le(fileBytes, 0) != SvRefMagic:
        return refFail("bad_magic")
    if refU16le(fileBytes, 4) != 64:
        return refFail("bad_header_size")
    if refU16le(fileBytes, 6) != 0:
        return refFail("nonzero_flags")
    let factCount = refU32le(fileBytes, 8)
    if refU32le(fileBytes, 12) != 0:
        return refFail("nonzero_compressed")
    let bodySize = refU32le(fileBytes, 16)
    if bodySize != totalLen - 64:
        return refFail("body_size_mismatch")
    for i in 20..<64:
        if (rawbytes.BytesGet(fileBytes, i) & 255) != 0:
            return refFail("nonzero_reserved")
    let directorySize = refU32le(fileBytes, 64)
    let sectionCount = refU32le(fileBytes, 68)
    if sectionCount < 1 || directorySize < 8:
        return refFail("bad_directory_shape")

    # 目录项独立解析
    var sections: RefSection[]
    var cursor: int32 = 72
    let directoryEnd = 64 + directorySize
    for s in 0..<sectionCount:
        if cursor >= directoryEnd:
            return refFail("directory_truncated")
        var section: RefSection
        section.tag = rawbytes.BytesGet(fileBytes, cursor) & 255
        cursor = cursor + 1
        var kindLen: int64 = 0
        if !refVaruint(fileBytes, cursor, kindLen):
            return refFail("bad_kind_len")
        if kindLen < 0 || cursor + int32(kindLen) > directoryEnd:
            return refFail("kind_out_of_range")
        section.kind = rawbytes.BytesToString(
            rawbytes.BytesSlice(fileBytes, cursor, int32(kindLen)))
        cursor = cursor + int32(kindLen)
        section.payloadOffset = refU32le(fileBytes, cursor)
        cursor = cursor + 4
        section.payloadLength = refU32le(fileBytes, cursor)
        cursor = cursor + 4
        section.itemCount = refU32le(fileBytes, cursor)
        cursor = cursor + 4
        section.digestHex = refDigestHex(fileBytes, cursor)
        cursor = cursor + 32
        add(sections, section)
    if cursor != directoryEnd:
        return refFail("directory_tail_gap")
    if sections.len != SvRefExpectedSections:
        return refFail("section_count_mismatch")

    # payload 紧邻无 gap/overlap；首节=字典；其余=事实节
    var dictCount: int32 = 0
    var dictionary: str[]
    var expectedPayload: int32 = directorySize
    var factTotal: int32 = 0
    if sections[0].tag != 1 || sections[0].kind.len != 0:
        return refFail("dictionary_not_first")
    for i in 0..<sections.len:
        let section = sections[i]
        if section.payloadOffset != expectedPayload:
            return refFail("payload_gap_or_overlap")
        expectedPayload = expectedPayload + section.payloadLength
        if section.tag != 1 && section.tag != 2:
            return refFail("unknown_section_tag")
        if section.tag == 2 && section.kind.len == 0:
            return refFail("fact_section_empty_kind")
        let computed = refSectionDigestHex(fileBytes, section)
        if computed != section.digestHex:
            return refFail(strings.ConcatStr(
                "section_digest_mismatch ", section.kind))
        if section.tag == 1:
            var at: int32 = section.payloadOffset + 64
            let end: int32 = at + section.payloadLength
            if at + 4 > end:
                return refFail("bad_dict_count")
            var count32: int32 = refU32le(fileBytes, at)
            at = at + 4
            if count32 < 0 || count32 > 1048576:
                return refFail("dict_count_out_of_range")
            for d in 0..<count32:
                var entryLen: int64 = 0
                if !refVaruint(fileBytes, at, entryLen):
                    return refFail("bad_dict_entry_len")
                if entryLen < 0 || at + int32(entryLen) > end:
                    return refFail("dict_entry_out_of_range")
                add(dictionary, rawbytes.BytesToString(
                    rawbytes.BytesSlice(fileBytes, at, int32(entryLen))))
                at = at + int32(entryLen)
            if at != end:
                return refFail("dictionary_tail")
            dictCount = count32
    if expectedPayload != bodySize:
        return refFail("payload_end_mismatch")

    # 事实节 token 流还原 canonical 行
    var lines: str[]
    for i in 0..<sections.len:
        let section = sections[i]
        if section.tag != 2:
            continue
        factTotal = factTotal + section.itemCount
        var at: int32 = section.payloadOffset + 64
        let end: int32 = at + section.payloadLength
        if at + 4 > end:
            return refFail("bad_fact_count")
        let payloadFactCount: int32 = refU32le(fileBytes, at)
        at = at + 4
        if payloadFactCount != section.itemCount:
            return refFail("fact_count_header_mismatch")
        for f in 0..<section.itemCount:
            var tokenCount: int64 = 0
            if !refVaruint(fileBytes, at, tokenCount):
                return refFail("bad_token_count")
            var line: str = ""
            for t in 0..<int32(tokenCount):
                if at >= end:
                    return refFail("token_truncated")
                let tokenTag = rawbytes.BytesGet(fileBytes, at) & 255
                at = at + 1
                var tokenLen: int64 = 0
                if tokenTag == 1:
                    var dictIndex: int64 = 0
                    if !refVaruint(fileBytes, at, dictIndex):
                        return refFail("bad_dict_index")
                    if dictIndex < 0 || dictIndex >= int64(dictCount):
                        return refFail("dict_index_out_of_range")
                    line = strings.ConcatStr(line, dictionary[int32(dictIndex)])
                elif tokenTag == 2:
                    if !refVaruint(fileBytes, at, tokenLen):
                        return refFail("bad_inline_len")
                    if tokenLen < 0 || at + int32(tokenLen) > end:
                        return refFail("inline_out_of_range")
                    line = strings.ConcatStr(line, rawbytes.BytesToString(
                        rawbytes.BytesSlice(fileBytes, at, int32(tokenLen))))
                    at = at + int32(tokenLen)
                else:
                    return refFail("unknown_token_tag")
            add(lines, line)
        if at != end:
            return refFail("fact_section_tail")
    if factTotal != factCount:
        return refFail("fact_total_mismatch")
    if factCount != SvRefExpectedFactCount:
        return refFail("fact_count_expectation")

    # claimed directory CID 重算：绑定 header 有效字段 + 完整目录区
    var dirBuf = layout.ByteBufInit(directorySize + 64)
    refAppendU32(dirBuf, refU32le(fileBytes, 0))
    refAppendU32(dirBuf, refU16le(fileBytes, 4))
    refAppendU32(dirBuf, refU16le(fileBytes, 6))
    refAppendU32(dirBuf, refU32le(fileBytes, 8))
    refAppendU32(dirBuf, refU32le(fileBytes, 12))
    refAppendU32(dirBuf, refU32le(fileBytes, 16))
    var dirBytes: rawbytes.Bytes = rawbytes.BytesSlice(fileBytes, 64, directorySize)
    refAppendBytes(dirBuf, dirBytes)
    rawbytes.BytesFree(dirBytes)
    let dirCid = refSha256HexFramed(SvRefDirClaimDomain, dirBuf)
    layout.ByteBufFree(dirBuf)
    if dirCid != SvRefExpectedDirCid:
        echo(strings.ConcatStr("computed: ", dirCid))
        return refFail("directory_cid_mismatch")

    # 行级结构对拍：kind 分布 / schema / 键序 / contentId
    var kinds: str[]
    add(kinds, "csg_semantic_video::manifest")
    add(kinds, "csg_semantic_video::entity")
    add(kinds, "csg_semantic_video::observation")
    add(kinds, "csg_semantic_video::assertion")
    add(kinds, "csg_semantic_video::snapshot")
    add(kinds, "csg_semantic_video::delta")
    add(kinds, "csg_semantic_video::correction")
    add(kinds, "csg_semantic_video::dependency")
    add(kinds, "csg_semantic_video::revision")
    add(kinds, "csg_semantic_video::receipt")
    var counts: int32[]
    for i in 0..<kinds.len:
        add(counts, 0)
    var manifestContentIdSeen = false
    for i in 0..<lines.len:
        let line = lines[i]
        if !refContains(line,
                strings.ConcatStr("\"schema\":\"", SvRefSchemaValue)):
            return refFail("schema_field_missing")
        if !refKeysAscending(line):
            return refFail("key_order_noncanonical")
        let kind = refLineKind(line)
        let idx = refKindIndex(kind, kinds)
        if idx < 0:
            return refFail(strings.ConcatStr("unknown_kind ", kind))
        counts[idx] = counts[idx] + 1
        if kind == "csg_semantic_video::manifest":
            if refContains(line, strings.ConcatStr(
                    "\"contentId\":\"", SvRefExpectedContentId)):
                manifestContentIdSeen = true
    let expectedCounts: int32[] = [1, 1, 1, 2, 1, 2, 1, 1, 1, 1]
    for i in 0..<kinds.len:
        if counts[i] != expectedCounts[i]:
            echo(strings.ConcatStr("kind ", kinds[i]))
            return refFail("kind_count_mismatch")
    if !manifestContentIdSeen:
        return refFail("contentid_expectation")

    # 负对照：翻转最后一个非零字节，末节 digest 必须失配（判别力自检）
    var corrupted: rawbytes.Bytes = rawbytes.BytesSlice(fileBytes, 0, totalLen)
    var flipAt: int32 = totalLen - 1
    while flipAt >= 0 && (rawbytes.BytesGet(corrupted, flipAt) & 255) == 0:
        flipAt = flipAt - 1
    if flipAt >= 0:
        rawbytes.BytesSet(corrupted, flipAt,
            (rawbytes.BytesGet(corrupted, flipAt) & 255) ^ 255)
        let last = sections[sections.len - 1]
        let stillMatches = refSectionDigestHex(corrupted, last) ==
            last.digestHex
        rawbytes.BytesFree(corrupted)
        if stillMatches:
            return refFail("negative_control_not_detecting")

    echo(strings.ConcatStr("facts=", strings.IntToStr(factCount)))
    echo(strings.ConcatStr("sections=", strings.IntToStr(sections.len)))
    echo(strings.ConcatStr("dictionary=", strings.IntToStr(dictCount)))
    echo(strings.ConcatStr("directory_cid=", dirCid))
    echo(strings.ConcatStr("content_id=", SvRefExpectedContentId))
    echo(" sv_ref_decoder ok")
    return 0

fn main(): int32 =
    let fileResult = os.ReadFileBytesResult(
        "docs/campaigns/2026-09-16-csg-semantic-video-standard/fixtures/b1_sample.svblock")
    if result.IsErr(fileResult):
        return refFail("fixture_read_failed")
    var fileBytes = result.Value(fileResult)
    return refRun(fileBytes)
