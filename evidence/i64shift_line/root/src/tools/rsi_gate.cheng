# RSI 门禁 (纯 Cheng, 学 fishing_gate 模式; 提案第7步)。
# 判定契约 (缺项不得折算为通过):
#   1) rsi_contract 冒烟编译 rc=0 且运行 rc=0;
#   2) rsi CLI 编译 rc=0, 清场后空账本可跑通 run/verify/status;
#   3) 一轮 A-试验 run rc=0 且账本出现 version_accepted (真实严格降分);
#   4) 一轮 M-元评价 run rc=0 且账本出现 meta_accepted (真实两代改进器);
#   5) 链 verify rc=0; 篡改一字节后 verify 必拒;
#   6) status 反映推进后的版本。
#   7) 两 run 腿经 beat_c 进程树守卫, C2 判定 = 三合一 (enforced peak =
#      guard 执行口径 max(resident, footprint); 缺该键不回落 resident <=
#      硬门 (单点派生自 tools/memory_model_limits.sh, 门禁侧无门值字面量)
#      AND <= 回归帽 (冻结基线 × 3/2, 工作集回归检测, 不是理论边界) AND
#      rc=0) AND 逐相读数在位; 越门/缺读数/病态基线一律 FAIL, 不得折算。
#   8) exhausted 终态审计腿: CLI rsi exhausted 可运行且结论如实 ——
#      EXHAUSTED (rc=0) = 空间穷尽且在位最优可证; PARTIAL (rc=1) =
#      如实部分覆盖 (gate 两轮 run 覆盖不足 22 格是事实); 审计不可运行才 FAIL。
#   9) 抬门轮隔离: 抬门信号 (env 覆写 CHENG_PARENT_RSS_GUARD /
#      BEAT_C_GUARD_RSS_LIMIT_BYTES != 权威门, 或守卫实测内存限 != 权威门)
#      => 该轮 check 判 DIAGNOSTIC 且整体 rc=3, 不写基线, 其运行状态本身即
#      病态证据, 不得进入任何"通过/更优"判词。--quick 轮缺 meta 腿读数,
#      同判 DIAGNOSTIC (不得折算为通过)。
# 幂等性: 门禁使用私有账本 artifacts/rsi_gate_store, 每次清场重建,
# 不触碰 artifacts/rsi (生产谱系) 与他线产物。候选/改进器落
# src/rsi_work (引擎自清理)。门禁结束保留私有账本作为本轮证据。
# C 车头坑规避: call-result 局部 str 每次外呼 Fmt 再拷贝; var-out 无返回值。
# 用法: rsi_gate <repoRoot> <compilerPath> [--quick]  (位置参数, 非旗标)
# 退出码: 0 = PASS (全判据在位); 1 = FAIL (缺项/判据不成立);
#         2 = 用法错; 3 = DIAGNOSTIC 轮 (抬门或口径不完整, 非验收结论)。
import std/cmdline as cmdline
import std/os as os
import std/strings as strings
import std/strutils as strutil
import std/os_host_process as hostos
import cheng/rsi/compiler as compiler
import cheng/rsi/execution as execution
import cheng/rsi/compiler_domain as cd

# C2 基线口径标: 判据 metric = guard process_tree_enforced_peak_bytes
# (= guard 执行口径 max(resident_total, footprint_total), runtime:5426);
# 缺该标或缺 peak_m 的基线不得按本口径复用 (旧 resident 口径基线一律重标)。
const
    RsiGateRssCaliber = "enforced_peak_bytes_v1"

@borrows
fn appendCheck(name: str, status: str, detail: str) =
    echo(Fmt"check={name} status={status} detail={detail}")

fn buildAndRun(root: str, compilerPath: str, sourceRel: str, binPath: str,
               timeoutSec: int32, compileTimeoutSec: int32,
               name: str, passCount: var int32, failCount: var int32) =
    let source = Fmt"{root}/{sourceRel}"
    let crc = compiler.RsiCompileCheng(Fmt"{compilerPath}", Fmt"{root}",
                                       Fmt"{source}", Fmt"{binPath}",
                                       compileTimeoutSec,
                                       ["CHENG_ENTRY_CACHE=0",
                                        "CHENG_NO_CACHE=1",
                                        "CHENG_STRICT_NO_CACHE=1"])
    if crc != 0:
        appendCheck(name, "FAIL", Fmt"compile_rc={crc}")
        failCount = failCount + 1
        return
    var output: str
    var rrc: int32 = 0
    execution.RsiRunCapture(Fmt"{binPath}", [], [], Fmt"{root}", timeoutSec,
                            output, rrc)
    let outLines = strutil.CountLines(Fmt"{output}")
    let detail = Fmt"run_rc={rrc} out_lines={outLines}"
    if rrc == 0:
        appendCheck(name, "PASS", detail)
        passCount = passCount + 1
    else:
        appendCheck(name, "FAIL", detail)
        failCount = failCount + 1

# 从 guard 报告文本提取 <key><int> (key 含 '='; 判据键由调用方给)。
# 手工扫描: while+go 标志定位键 (CloneStrRange 等长片段比较), 再扫数字段
# (char 范围 '0'..'9', 上限 18 位防溢出); 无键/无数字 -> outOk=0。
fn extractUintInto(reportText: str, key: str, outVal: var int64,
                   outOk: var int32) =
    let keyLen = len(key)
    let textLen = len(reportText)
    outVal = 0
    outOk = 0
    var scanPos: int32 = 0
    var keyState: int32 = 0
    var valueStart: int32 = 0
    while keyState == 0:
        if scanPos + keyLen > textLen:
            keyState = 2
        else:
            let slice = strings.CloneStrRange(Fmt"{reportText}", scanPos,
                                              keyLen)
            if slice == key:
                keyState = 1
                valueStart = scanPos + keyLen
            else:
                scanPos = scanPos + 1
    if keyState == 1:
        var digitEnd: int32 = valueStart
        var digitState: int32 = 0
        while digitState == 0:
            if digitEnd >= textLen:
                digitState = 1
            else:
                let ch = reportText[digitEnd]
                if ch < '0' || ch > '9':
                    digitState = 1
                else:
                    digitEnd = digitEnd + 1
        let digitCount = digitEnd - valueStart
        if digitCount > 0 && digitCount <= 18:
            let digits = strings.CloneStrRange(Fmt"{reportText}", valueStart,
                                               digitCount)
            let parsed = strutil.ParseInt(Fmt"{digits}")
            outVal = int64(parsed)
            outOk = 1

# 数逐相读数行: guard phase-trace 行 = <t> TAB <kib> TAB <子进程 stderr 行>,
# 相位行 = 子进程 stderr 的 "phase=" 行。0 行 = 逐相读数缺失 (不得折算)。
fn countPhaseRowsInto(traceText: str, outRows: var int32) =
    outRows = 0
    let lines = strutil.Split(Fmt"{traceText}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if len(line) > 0 && strutil.Contains(line, "phase="):
            outRows = outRows + 1

# 抬门信号 (env 覆写路径): CHENG_PARENT_RSS_GUARD 非空非 0, 或
# BEAT_C_GUARD_RSS_LIMIT_BYTES 被设成 != 权威门值。返回逗号连接信号
# ("" = 无)。抬门轮一律 diagnostic (2026-09-13 裁定 ③)。
fn gateDiagSignals(gateText: str): str =
    var sigs: str[]
    let parentGuard = strutil.Strip(os.GetEnv("CHENG_PARENT_RSS_GUARD"))
    if len(parentGuard) > 0 && parentGuard != "0":
        add(sigs, Fmt"CHENG_PARENT_RSS_GUARD={parentGuard}")
    let envLimit = strutil.Strip(os.GetEnv("BEAT_C_GUARD_RSS_LIMIT_BYTES"))
    if len(envLimit) > 0 && envLimit != gateText:
        add(sigs, Fmt"BEAT_C_GUARD_RSS_LIMIT_BYTES={envLimit}")
    return strutil.Join(sigs, ",")

# C2 判定落点: 判据单点在 compiler_domain.RsiCdC2Verdict (门禁侧不得另立
# 常数/另写判据), 本函数只取证据、落判词并计数。forcedDiag=1 = 抬门轮:
# 一律 DIAGNOSTIC, 不计 PASS/FAIL, 且不得进入任何"通过/更优"判词。
fn gateJudgeC2(checkName: str, leg: str, peakBytes: int64, peakOk: int32,
               limitBytes: int64, phaseRows: int32, basePeak: int64,
               baseOk: int32, rc: int32, gateBytes: int64, forcedDiag: int32,
               passCount: var int32, failCount: var int32,
               diagCount: var int32): str =
    let reason = cd.RsiCdC2Verdict(peakBytes, peakOk, limitBytes, gateBytes,
                                   basePeak, baseOk, phaseRows, rc)
    let gateText = strings.Int64ToStr(gateBytes)
    let detail = Fmt"leg={leg} reason={reason} peak={peakBytes} gate={gateText} base={basePeak} regression_cap=x1.5 rc={rc} phase_rows={phaseRows} effective_limit={limitBytes}"
    if forcedDiag == 1 || cd.RsiCdReasonIsDiagnostic(Fmt"{reason}"):
        appendCheck(Fmt"{checkName}", "DIAGNOSTIC",
                    Fmt"raised_cap state=pathological_evidence {detail}")
        diagCount = diagCount + 1
    else:
        if reason == "pass":
            appendCheck(Fmt"{checkName}", "PASS", Fmt"{detail}")
            passCount = passCount + 1
        else:
            appendCheck(Fmt"{checkName}", "FAIL", Fmt"{detail}")
            failCount = failCount + 1
    return Fmt"{reason}"

# 从 exhausted 审计输出提取 "covered=" 起至空格/换行的片段 (N/18 或 N/22),
# 供 PASS detail 如实携带覆盖数。手工扫描: while+go 标志定位键
# (CloneStrRange 等长片段比较), 再扫到段尾; 无键 -> outOk=0。
fn extractCoveredInto(reportText: str, outFrag: var str, outOk: var int32) =
    let key = "covered="
    let keyLen = len(key)
    let textLen = len(reportText)
    outFrag = ""
    outOk = 0
    var scanPos: int32 = 0
    var keyState: int32 = 0
    var valueStart: int32 = 0
    while keyState == 0:
        if scanPos + keyLen > textLen:
            keyState = 2
        else:
            let slice = strings.CloneStrRange(Fmt"{reportText}", scanPos,
                                              keyLen)
            if slice == key:
                keyState = 1
                valueStart = scanPos + keyLen
            else:
                scanPos = scanPos + 1
    if keyState == 1:
        var fragEnd: int32 = valueStart
        var fragState: int32 = 0
        while fragState == 0:
            if fragEnd >= textLen:
                fragState = 1
            else:
                let ch = reportText[fragEnd]
                if ch == ' ' || ch == '\n':
                    fragState = 1
                else:
                    fragEnd = fragEnd + 1
        let fragLen = fragEnd - valueStart
        if fragLen > 0:
            outFrag = strings.CloneStrRange(Fmt"{reportText}", valueStart,
                                            fragLen)
            outOk = 1

# 载具身份 (编译器 sha256); 失败返回空串。确定性系统的峰值模型参数。
fn gateCarrierSha(compilerPath: str): str =
    let res = hostos.ExecFileCapture("/usr/bin/shasum",
        ["-a", "256", Fmt"{compilerPath}"], [], "", true, 120)
    let outText = os.ExecCmdResultOutput(res)
    let head = strutil.Strip(Fmt"{outText}")
    if len(head) < 64:
        return ""
    return strings.CloneStrRange(head, 0, 64)

# 行级 key 数字段提取 (单次 Split, 行内手工扫描; 缺键/空值 -> outOk=0)。
fn rssFieldInto(text: str, key: str, outVal: var int64, outOk: var int32) =
    outOk = 0
    let prefix = strutil.Join([Fmt"{key}", " "], "")
    let lines = strutil.Split(Fmt"{text}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if strings.HasPrefix(line, prefix):
            let digits = strings.CloneStrRange(line, len(prefix), len(line) - len(prefix))
            if len(digits) <= 0:
                return
            outVal = int64(strutil.ParseInt(digits))
            outOk = 1
            return

# 基线文件: caliber <名义> / carrier <64hex> / peak_a <int> / peak_m <int>。
# caliber 不符或缺 peak_m = 本口径未标 (旧格式/旧 metric 基线不得复用,
# 一律走重标路径且越门即拒) -> outOk=0。
fn loadRssBaselineInto(path: str, outCarrier: var str, outA: var int64,
                       outM: var int64, outOk: var int32) =
    outOk = 0
    outCarrier = ""
    outA = 0
    outM = 0
    let text = os.ReadFile(Fmt"{path}")
    if len(text) <= 0:
        return
    var caliber: str
    let lines = strutil.Split(Fmt"{text}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if strings.HasPrefix(line, "caliber "):
            caliber = strings.CloneStrRange(line, 8, len(line) - 8)
        if strings.HasPrefix(line, "carrier "):
            outCarrier = strings.CloneStrRange(line, 8, len(line) - 8)
    var aOk: int32 = 0
    var mOk: int32 = 0
    rssFieldInto(Fmt"{text}", "peak_a", outA, aOk)
    rssFieldInto(Fmt"{text}", "peak_m", outM, mOk)
    if aOk == 1 && mOk == 1 && outM > 0 && caliber == RsiGateRssCaliber && len(outCarrier) == 64:
        outOk = 1

fn writeRssBaseline(path: str, carrier: str, peakA: int64, peakM: int64): bool =
    var parts: str[]
    add(parts, Fmt"caliber {RsiGateRssCaliber}")
    add(parts, Fmt"carrier {carrier}")
    add(parts, Fmt"peak_a {peakA}")
    add(parts, Fmt"peak_m {peakM}")
    let text = strutil.Join(parts, "\n")
    let tmpPath = strutil.Join([Fmt"{path}", ".tmp"], "")
    os.WriteFile(Fmt"{tmpPath}", text)
    if os.ReadFile(Fmt"{tmpPath}") != text:
        return false
    return os.RenameFile(Fmt"{tmpPath}", Fmt"{path}")

fn gateMain(root: str, compilerPath: str, quick: bool): int32 =
    let workDir = Fmt"{root}/artifacts/rsi_gate"
    os.MkdirAll(Fmt"{workDir}", 493)
    let storeDir = Fmt"{root}/artifacts/rsi_gate_store"
    os.MkdirAll(Fmt"{storeDir}", 493)
    let _e1 = os.RemoveFile(Fmt"{storeDir}/events.log")
    let _e2 = os.RemoveFile(Fmt"{storeDir}/current.txt")
    let _e3 = os.RemoveFile(Fmt"{storeDir}/current.txt.tmp")
    # v3 布局: CSG 事实文件也是账本状态 (判词 50: 残留会撞禁 genesis 分叉守卫)
    let _e4 = os.RemoveFile(Fmt"{storeDir}/rsi.facts.jsonl")
    # 守卫产物 O_EXCL 独占创建: 上一轮封存的只读存量会令守卫拒启动 (判词 50)
    let _g1 = os.RemoveFile(Fmt"{workDir}/guard_a.out.txt")
    let _g2 = os.RemoveFile(Fmt"{workDir}/guard_a.err.txt")
    let _g3 = os.RemoveFile(Fmt"{workDir}/guard_a.report.txt")
    let _g4 = os.RemoveFile(Fmt"{workDir}/guard_meta.out.txt")
    let _g5 = os.RemoveFile(Fmt"{workDir}/guard_meta.err.txt")
    let _g6 = os.RemoveFile(Fmt"{workDir}/guard_meta.report.txt")
    # phase-trace 同属 O_EXCL 独占产物: 上一轮封存存量会令守卫拒启动。
    let _g7 = os.RemoveFile(Fmt"{workDir}/guard_a.phase.tsv")
    let _g8 = os.RemoveFile(Fmt"{workDir}/guard_meta.phase.tsv")
    let ev1 = os.ReadFile(Fmt"{storeDir}/events.log")
    let ev2 = os.ReadFile(Fmt"{storeDir}/current.txt")
    let ev3 = os.ReadFile(Fmt"{storeDir}/rsi.facts.jsonl")
    if len(ev1) > 0 || len(ev2) > 0 || len(ev3) > 0:
        appendCheck("gate_store_clean", "FAIL", "leftover after clean")
        return 1
    appendCheck("gate_store_clean", "PASS", "private ledger reset")
    var passCount: int32 = 0
    var failCount: int32 = 0
    var diagCount: int32 = 0
    let storeFlag = Fmt"--store-dir:{storeDir}"
    var peakA: int64 = 0
    var peakM: int64 = 0
    var peakOkA: int32 = 0
    var peakOkM: int32 = 0
    var limitA: int64 = 0
    var limitM: int64 = 0
    # 归因副字段 (只记账, 不参与判定): 判据峰值轮的 resident/footprint 同轮值。
    var resA: int64 = 0
    var fpA: int64 = 0
    var resM: int64 = 0
    var fpM: int64 = 0
    var metaRc: int32 = 0
    var scratchOk: int32 = 0
    # monitor runtime sha 绑定 (runtime 由守卫线权威更新, gate 绑实际字节;
    # 文件须无写位 —— file_contract 由 guard 自检)。
    # runtime py 被并行门禁线反复写回带写位 (mtime 实证), guard file_contract
    # 要求无写位 —— 用时确保 (尽力恢复, 权威判定仍归 guard 自检)。
    let _cw = hostos.ExecFileCapture("/bin/chmod",
        ["a-w", Fmt"{root}/tools/beat_c_process_group_guard_runtime.py"],
        [], "", true, 30)
    let monitorSha = gateCarrierSha(Fmt"{root}/tools/beat_c_process_group_guard_runtime.py")
    let guardEnv = Fmt"BEAT_C_GUARD_EXPECTED_MONITOR_RUNTIME_SHA256={monitorSha}"
    # C2 硬门单点派生 (唯一权威件 tools/memory_model_limits.sh): 门禁侧无门值
    # 字面量; 读不到 = 硬失败 (不得折算, 不得回落默认值)。
    var gateBytes: int64 = 0
    var gateOk: int32 = 0
    cd.RsiCdAuthorityLimitInto(Fmt"{root}", gateBytes, gateOk)
    if gateOk != 1:
        appendCheck("rsi_c2_authority", "FAIL",
                    "tools/memory_model_limits.sh CHENG_MEMORY_MODEL_LIMIT_BYTES unreadable")
        failCount = failCount + 1
        echo("rsi_gate: FAIL (C2 硬门权威件不可读, 不得折算)")
        return 1
    let gateText = strings.Int64ToStr(gateBytes)
    appendCheck("rsi_c2_authority", "PASS",
                Fmt"hard_gate_bytes={gateText} source=tools/memory_model_limits.sh")
    passCount = passCount + 1
    # 抬门轮隔离: env 覆写信号 -> 整轮 diagnostic, 不入任何通过/更优判词。
    var diagForced: int32 = 0
    let diagEnvRaw = gateDiagSignals(Fmt"{gateText}")
    if len(diagEnvRaw) > 0:
        diagForced = 1
        appendCheck("rsi_c2_diagnostic", "DIAGNOSTIC",
                    Fmt"raised_cap_env={diagEnvRaw} state=pathological_evidence")
        diagCount = diagCount + 1

    # 1) 合同冒烟 (cwd=root, smoke 内相对临时目录成立)。
    let contractBin = Fmt"{root}/artifacts/rsi_gate/rsi_contract"
    buildAndRun(root, compilerPath, "src/tests/rsi_contract.cheng",
                Fmt"{contractBin}", 120, 900, "rsi_contract", passCount,
                failCount)

    # 2) CLI 编译。
    let cliBin = Fmt"{root}/artifacts/rsi_gate/rsi_cli"
    let cliSrc = Fmt"{root}/src/apps/rsi/main.cheng"
    let crc = compiler.RsiCompileCheng(Fmt"{compilerPath}", Fmt"{root}",
                                       Fmt"{cliSrc}", Fmt"{cliBin}", 900,
                                       ["CHENG_ENTRY_CACHE=0",
                                        "CHENG_NO_CACHE=1",
                                        "CHENG_STRICT_NO_CACHE=1"])
    if crc != 0:
        appendCheck("rsi_cli_compile", "FAIL", Fmt"compile_rc={crc}")
        failCount = failCount + 1
    else:
        appendCheck("rsi_cli_compile", "PASS", "compile_rc=0")
        passCount = passCount + 1

    if failCount == 0:


        # 3) 一轮 A-试验: 冒泡种子 -> 严格降分推进 (beat_c 进程树守卫,
        #    硬门 = 权威件派生值; --phase-trace 取逐相读数)。

        var output: str
        var rrc: int32 = 0
        execution.RsiRunCapture("/bin/bash",
            [Fmt"{root}/tools/beat_c_process_group_guard.sh",
             Fmt"--rss-limit:{gateText}",
             "--timeout:2400",
             "--expected-exit-code:0",
             Fmt"--report-out:{root}/artifacts/rsi_gate/guard_a.report.txt",
             Fmt"--stdout:{root}/artifacts/rsi_gate/guard_a.out.txt",
             Fmt"--stderr:{root}/artifacts/rsi_gate/guard_a.err.txt",
             Fmt"--phase-trace:{root}/artifacts/rsi_gate/guard_a.phase.tsv",
             "--",
             Fmt"{cliBin}",
             "run",
             Fmt"--root:{root}",
             Fmt"--compiler:{compilerPath}",
             Fmt"{storeFlag}",
             "--max-generations:1",
             "--max-candidates:3"], [Fmt"{guardEnv}", "CHENG_PROGRESS=1"], "", 2400, output, rrc)
        let runOut = os.ReadFile(Fmt"{root}/artifacts/rsi_gate/guard_a.out.txt")
        let reportA = os.ReadFile(
            Fmt"{root}/artifacts/rsi_gate/guard_a.report.txt")
        # C2 判据口径 = guard 执行口径 enforced (= max(resident, footprint));
        # 缺键 => peakOkA=0 => missing_peak_reading, 不回落 resident (A5d)。
        extractUintInto(Fmt"{reportA}", "process_tree_enforced_peak_bytes=",
                        peakA, peakOkA)
        extractUintInto(Fmt"{reportA}", "memory_limit_bytes=", limitA,
                        scratchOk)
        extractUintInto(Fmt"{reportA}", "process_tree_resident_peak_bytes=",
                        resA, scratchOk)
        extractUintInto(Fmt"{reportA}",
                        "process_tree_phys_footprint_peak_bytes=", fpA,
                        scratchOk)
        let events1 = os.ReadFile(Fmt"{storeDir}/events.log")
        if rrc == 0 && strutil.Contains(Fmt"{runOut}", "rsi_engine") && strutil.Contains(Fmt"{events1}", "event=version_accepted"):
            appendCheck("rsi_run_a_trial", "PASS", "version accepted with strict improvement")
            passCount = passCount + 1
        else:
            appendCheck("rsi_run_a_trial", "FAIL", Fmt"run_rc={rrc} accepted_missing")
            failCount = failCount + 1

        if !quick:
            # 4) 一轮 M-元评价: 真实两代改进器 (M0 -> M1, 守卫硬门=派生值)。
            # v3 三域空间下 A 腿已提交强在位 (归并 13450), 续跑轨迹 M 后继
            # 不合格 (aQualified=false, 合同正例) meta 永不触发 —— meta 腿
            # 改用独立新账本走完整 genesis→A-accept→meta 轨迹 (判词 51,
            # G=2 C=3 实证 meta_accepted; C=8 反而平分拒, 勿加大候选预算)。
            let metaStoreDir = Fmt"{root}/artifacts/rsi_gate_store_meta"
            os.MkdirAll(Fmt"{metaStoreDir}", 493)
            let _ms1 = os.RemoveFile(Fmt"{metaStoreDir}/events.log")
            let _ms2 = os.RemoveFile(Fmt"{metaStoreDir}/current.txt")
            let _ms3 = os.RemoveFile(Fmt"{metaStoreDir}/current.txt.tmp")
            let _ms4 = os.RemoveFile(Fmt"{metaStoreDir}/rsi.facts.jsonl")

            var metaOut: str
            execution.RsiRunCapture("/bin/bash",
                [Fmt"{root}/tools/beat_c_process_group_guard.sh",
                 Fmt"--rss-limit:{gateText}",
                 "--timeout:4800",
                 "--expected-exit-code:0",
                 Fmt"--report-out:{root}/artifacts/rsi_gate/guard_meta.report.txt",
                 Fmt"--stdout:{root}/artifacts/rsi_gate/guard_meta.out.txt",
                 Fmt"--stderr:{root}/artifacts/rsi_gate/guard_meta.err.txt",
                 Fmt"--phase-trace:{root}/artifacts/rsi_gate/guard_meta.phase.tsv",
                 "--",
                 Fmt"{cliBin}",
                 "run",
                 Fmt"--root:{root}",
                 Fmt"--compiler:{compilerPath}",
                 Fmt"--store-dir:{metaStoreDir}",
                 # v4 31 格空间实测: meta 窗=G2 C4 (C=4 全 G 档出 meta_accepted,
                 # C=3/C=6 轨迹平分拒; 扫窗回执 findings 判词 55 附注)
                 "--max-generations:2",
                 "--max-candidates:4",
                 "--meta:1"], [Fmt"{guardEnv}", "CHENG_PROGRESS=1"], "", 4800, metaOut, metaRc)
            let metaEcho = os.ReadFile(
                Fmt"{root}/artifacts/rsi_gate/guard_meta.out.txt")
            let reportM = os.ReadFile(
                Fmt"{root}/artifacts/rsi_gate/guard_meta.report.txt")
            extractUintInto(Fmt"{reportM}",
                            "process_tree_enforced_peak_bytes=", peakM,
                            peakOkM)
            extractUintInto(Fmt"{reportM}", "memory_limit_bytes=", limitM,
                            scratchOk)
            extractUintInto(Fmt"{reportM}",
                            "process_tree_resident_peak_bytes=", resM,
                            scratchOk)
            extractUintInto(Fmt"{reportM}",
                            "process_tree_phys_footprint_peak_bytes=", fpM,
                            scratchOk)
            let events2 = os.ReadFile(Fmt"{metaStoreDir}/events.log")
            if metaRc == 0 && strutil.Contains(Fmt"{metaEcho}", "rsi_engine") && strutil.Contains(Fmt"{events2}", "event=meta_accepted"):
                appendCheck("rsi_run_meta_trial", "PASS", "improver M0->M1 accepted via one-step lookahead")
                passCount = passCount + 1
            else:
                appendCheck("rsi_run_meta_trial", "FAIL", Fmt"run_rc={metaRc} meta_missing")
                failCount = failCount + 1

        # 5) 链 verify + 篡改必拒。
        var verifyOut: str
        var verifyRc: int32 = 0
        execution.RsiRunCapture(Fmt"{cliBin}",
                                ["verify",
                                 Fmt"--root:{root}",
                                 Fmt"{storeFlag}"], [], "", 60, verifyOut,
                                verifyRc)
        if verifyRc == 0:
            appendCheck("rsi_verify_chain", "PASS", "chain verifies")
            passCount = passCount + 1
        else:
            appendCheck("rsi_verify_chain", "FAIL", Fmt"run_rc={verifyRc}")
            failCount = failCount + 1

        # CSG 事实篡改必拒: 改 rsi.facts.jsonl 首行 schema 一字节, verify
        # 的重放链 (R2/R3) 必拒, 还原后恢复。
        let factsPath = Fmt"{storeDir}/rsi.facts.jsonl"
        let factsOriginal = os.ReadFile(Fmt"{factsPath}")
        if len(factsOriginal) > 40:
            let factsTampered = strutil.Replace(Fmt"{factsOriginal}",
                                                "csg_core", "csg_cor3")
            os.WriteFile(Fmt"{factsPath}", Fmt"{factsTampered}")
            var ftOut: str
            var ftRc: int32 = 0
            execution.RsiRunCapture(Fmt"{cliBin}",
                                    ["verify",
                                     Fmt"--root:{root}",
                                     Fmt"{storeFlag}"], [], "", 60, ftOut,
                                    ftRc)
            if ftRc != 0:
                appendCheck("rsi_csg_tamper_rejected", "PASS", "tampered csg facts rejected by replay")
                passCount = passCount + 1
            else:
                appendCheck("rsi_csg_tamper_rejected", "FAIL", "tampered csg facts accepted")
                failCount = failCount + 1
            os.WriteFile(Fmt"{factsPath}", factsOriginal)

        let original = os.ReadFile(Fmt"{storeDir}/events.log")
        if len(original) > 20:
            let replacedText = strutil.Replace(Fmt"{original}", "gen=", "GEN=")
            os.WriteFile(Fmt"{storeDir}/events.log", Fmt"{replacedText}")
            var tamperOut: str
            var tamperRc: int32 = 0
            execution.RsiRunCapture(Fmt"{cliBin}",
                                    ["verify",
                                     Fmt"--root:{root}",
                                     Fmt"{storeFlag}"], [], "", 60,
                                    tamperOut, tamperRc)
            if tamperRc != 0:
                appendCheck("rsi_verify_tamper_rejected", "PASS", "tampered chain rejected")
                passCount = passCount + 1
            else:
                appendCheck("rsi_verify_tamper_rejected", "FAIL", "tampered chain accepted")
                failCount = failCount + 1
            os.WriteFile(Fmt"{storeDir}/events.log", original)

        # 8) exhausted 终态审计腿: 审计可运行且结论如实即 PASS ——
        # 本 gate 场景两轮 run 覆盖不足 22 格, 如实终态就是 PARTIAL。
        var exhOut: str
        var exhRc: int32 = 0
        execution.RsiRunCapture(Fmt"{cliBin}",
                                ["exhausted",
                                 Fmt"--root:{root}",
                                 Fmt"{storeFlag}"], [Fmt"{guardEnv}"], "",
                                60, exhOut, exhRc)
        var covFrag: str
        var covFragOk: int32 = 0
        extractCoveredInto(Fmt"{exhOut}", covFrag, covFragOk)
        if exhRc == 0 && strutil.Contains(Fmt"{exhOut}", "EXHAUSTED"):
            appendCheck("rsi_exhausted_audit", "PASS",
                        "space exhausted incumbent proven")
            passCount = passCount + 1
        else:
            if exhRc == 1 && strutil.Contains(Fmt"{exhOut}", "PARTIAL") && covFragOk == 1:
                appendCheck("rsi_exhausted_audit", "PASS",
                            Fmt"audit honest terminal covered={covFrag}")
                passCount = passCount + 1
            else:
                appendCheck("rsi_exhausted_audit", "FAIL",
                            "exhausted audit broken")
                failCount = failCount + 1

        # 7.5) 编译器域 C1 A/B 腿 (C 链解锁口径): gate 私账本上跑一轮
        # cdomain (genesis 配对基线 + jobs 档候选), 判据 = 流程真实性与
        # 语义锚正确性 —— genesis 入账 且 候选判决 (accept/reject) 如实
        # 记录即 PASS; 拒收须带锚理由 (sha_mismatch/no_strict_gain)。
        # 独立 compiler store: cdomain 的 current.txt 是 compiler schema,
        # 与引擎 store (cheng.rsi.version.v1) 异 schema, 严禁同目录互踩。
        let cdStoreDir = Fmt"{root}/artifacts/rsi_gate_store_compiler"
        os.MkdirAll(Fmt"{cdStoreDir}", 493)
        let _cdr = os.RemoveFile(Fmt"{cdStoreDir}/events.log")
        let _cdv = os.RemoveFile(Fmt"{cdStoreDir}/current.txt")
        let _cdt = os.RemoveFile(Fmt"{cdStoreDir}/current.txt.tmp")
        # cversion 事实同属账本状态, 残留会重复 tag 撞 DAG (判词 50)
        let _cdf = os.RemoveFile(Fmt"{cdStoreDir}/rsi.facts.jsonl")
        var cdOut: str
        var cdRc: int32 = 0
        execution.RsiRunCapture(Fmt"{cliBin}",
            ["cdomain",
             Fmt"--root:{root}",
             Fmt"--compiler:{compilerPath}",
             Fmt"--store-dir:{cdStoreDir}"], [], "", 1200, cdOut, cdRc)
        let cdEvents = os.ReadFile(Fmt"{cdStoreDir}/events.log")
        let cdHasGenesis = strutil.Contains(Fmt"{cdEvents}", "event=cdomain_genesis")
        let cdHasVerdict = strutil.Contains(Fmt"{cdEvents}", "event=cdomain_accepted") ||
                           strutil.Contains(Fmt"{cdEvents}", "event=cdomain_rejected")
        var cdvOut: str
        var cdvRc: int32 = 0
        execution.RsiRunCapture(Fmt"{cliBin}",
            ["verify",
             Fmt"--root:{root}",
             Fmt"--store-dir:{cdStoreDir}"], [], "", 120, cdvOut, cdvRc)
        if cdRc == 0 && cdvRc == 0 && cdHasGenesis && cdHasVerdict:
            appendCheck("rsi_compiler_ab", "PASS",
                        Fmt"cdomain A/B recorded honestly rc={cdRc} verify_rc={cdvRc}")
            passCount = passCount + 1
        else:
            appendCheck("rsi_compiler_ab", "FAIL",
                        Fmt"cdomain rc={cdRc} genesis={cdHasGenesis} verdict={cdHasVerdict} verify_rc={cdvRc}")
            failCount = failCount + 1

        # 7) C2 判定: 三合一 (硬门 AND 回归帽 AND rc=0) + 逐相读数在位 +
        # 基线非病态。判据单点在 compiler_domain.RsiCdC2Verdict (门禁侧不得
        # 另立常数/另写判据); 判据峰值 = guard 执行口径 enforced =
        # max(resident, footprint) (缺键不回落 resident); 回归帽 = 冻结基线
        # x 3/2 = 工作集回归检测, 不是理论边界。越门/缺读数/病态基线一律
        # FAIL, 不得折算; 抬门轮 (env 覆写或守卫实测限 != 权威门) 一律
        # DIAGNOSTIC, 不入通过判词。
        let peakAText = strings.Int64ToStr(peakA)
        let peakMText = strings.Int64ToStr(peakM)
        let resAText = strings.Int64ToStr(resA)
        let fpAText = strings.Int64ToStr(fpA)
        let resMText = strings.Int64ToStr(resM)
        let fpMText = strings.Int64ToStr(fpM)
        var phaseRowsA: int32 = 0
        var phaseRowsM: int32 = 0
        var traceA: str
        traceA = os.ReadFile(Fmt"{root}/artifacts/rsi_gate/guard_a.phase.tsv")
        countPhaseRowsInto(Fmt"{traceA}", phaseRowsA)
        var traceM: str
        traceM = os.ReadFile(Fmt"{root}/artifacts/rsi_gate/guard_meta.phase.tsv")
        countPhaseRowsInto(Fmt"{traceM}", phaseRowsM)
        # 归因记账 (只记账, 不参与判定): 判据峰值的同轮 resident/footprint,
        # 用于分辨真增长 vs resident/footprint 相对关系翻转。
        echo(Fmt"check=rsi_c2_attribution status=RECORD detail=leg=a peak_enforced={peakAText} peak_resident={resAText} peak_footprint={fpAText} gate={gateText}")
        if !quick:
            echo(Fmt"check=rsi_c2_attribution status=RECORD detail=leg=m peak_enforced={peakMText} peak_resident={resMText} peak_footprint={fpMText} gate={gateText}")
        let carrierSha = gateCarrierSha(Fmt"{compilerPath}")
        let baselinePath = Fmt"{storeDir}/rss_baseline.txt"
        var baseCarrier: str
        var baseA: int64 = 0
        var baseM: int64 = 0
        var baseLoaded: int32 = 0
        loadRssBaselineInto(Fmt"{baselinePath}", baseCarrier, baseA, baseM,
                            baseLoaded)
        var sameCarrier: int32 = 0
        if baseLoaded == 1 && baseCarrier == carrierSha && len(carrierSha) == 64:
            sameCarrier = 1
        var reasonA: str
        var reasonM: str
        if sameCarrier == 1:
            # 对照轮: 判据 = 三合一 + 逐相 + 冻结基线非病态。基线自身越门
            # 判 pathological_baseline 且拒绝就地重标 (本分支不写基线)。
            reasonA = gateJudgeC2("rsi_rss_guard", "a", peakA, peakOkA, limitA,
                                  phaseRowsA, baseA, 1, rrc, gateBytes,
                                  diagForced, passCount, failCount, diagCount)
            if quick:
                appendCheck("rsi_rss_guard_meta", "DIAGNOSTIC",
                            Fmt"quick_round_missing_meta_leg state=caliber_incomplete gate={gateText}")
                diagCount = diagCount + 1
                reasonM = "diagnostic_quick_incomplete"
            else:
                reasonM = gateJudgeC2("rsi_rss_guard_meta", "m", peakM, peakOkM,
                                      limitM, phaseRowsM, baseM, 1, metaRc,
                                      gateBytes, diagForced, passCount,
                                      failCount, diagCount)
        else:
            # 标定轮: basePeak = 本轮实测 = 待冻结基线自身, 越门即病态基线。
            # 既有基线 (含旧 caliber/旧 metric) 自身越门 = 拒收不重标。
            var priorA: int64 = 0
            var priorM: int64 = 0
            var priorOkA: int32 = 0
            var priorOkM: int32 = 0
            let baseText = os.ReadFile(Fmt"{baselinePath}")
            if len(baseText) > 0:
                rssFieldInto(Fmt"{baseText}", "peak_a", priorA, priorOkA)
                rssFieldInto(Fmt"{baseText}", "peak_m", priorM, priorOkM)
            var priorPathological: int32 = 0
            if priorOkA == 1 && priorA > gateBytes:
                priorPathological = 1
            if priorOkM == 1 && priorM > gateBytes:
                priorPathological = 1
            reasonA = gateJudgeC2("rsi_rss_guard", "a_baseline", peakA, peakOkA,
                                  limitA, phaseRowsA, peakA, 1, rrc, gateBytes,
                                  diagForced, passCount, failCount, diagCount)
            if quick:
                appendCheck("rsi_rss_guard_meta", "DIAGNOSTIC",
                            Fmt"quick_round_missing_meta_leg state=caliber_incomplete gate={gateText}")
                diagCount = diagCount + 1
                reasonM = "diagnostic_quick_incomplete"
            else:
                reasonM = gateJudgeC2("rsi_rss_guard_meta", "m_baseline", peakM,
                                      peakOkM, limitM, phaseRowsM, peakM, 1,
                                      metaRc, gateBytes, diagForced, passCount,
                                      failCount, diagCount)
            if len(carrierSha) != 64:
                appendCheck("rsi_rss_baseline", "FAIL",
                            "carrier sha unavailable (判据缺失, 不得折算)")
                failCount = failCount + 1
            else:
                if priorPathological == 1:
                    appendCheck("rsi_rss_baseline", "FAIL",
                                Fmt"pathological_baseline prior_over_gate carrier={carrierSha} prior_a={priorA} prior_m={priorM} gate={gateText} state=not_rewritten")
                    failCount = failCount + 1
                else:
                    if reasonA == "pass" && reasonM == "pass" && diagForced == 0 && !quick:
                        if writeRssBaseline(Fmt"{baselinePath}", Fmt"{carrierSha}", peakA, peakM):
                            echo(Fmt"check=rsi_rss_baseline status=WRITTEN detail=in_gate carrier={carrierSha} peak_a={peakAText} peak_m={peakMText} gate={gateText}")
                        else:
                            appendCheck("rsi_rss_baseline", "FAIL",
                                        "baseline write failed")
                            failCount = failCount + 1
                    else:
                        echo(Fmt"check=rsi_rss_baseline status=NOT_WRITTEN detail=reason_a={reasonA} reason_m={reasonM} diag={diagForced} quick={quick}")

        # 6) status 反映推进后的版本。

        var statusOut: str
        var statusRc: int32 = 0
        execution.RsiRunCapture(Fmt"{cliBin}",
                                ["status",
                                 Fmt"--root:{root}",
                                 Fmt"{storeFlag}"], [], "", 60, statusOut,
                                statusRc)
        let versionNow = os.ReadFile(Fmt"{storeDir}/current.txt")
        if statusRc == 0 && len(versionNow) > 0 && strutil.Contains(Fmt"{statusOut}", "rsi_status: gen="):
            appendCheck("rsi_status_progressed", "PASS", "status reflects committed version")
            passCount = passCount + 1
        else:
            appendCheck("rsi_status_progressed", "FAIL", Fmt"run_rc={statusRc}")
            failCount = failCount + 1

    # 收尾: 清 artifacts/rsi_gate 下大对象 (exe/map), 证据只留文本账本
    # (artifacts/rsi_gate_store)。
    let gateListing = os.ListDir(Fmt"{root}/artifacts/rsi_gate")
    for i in 0..<gateListing.len:
        let entry = Fmt"{gateListing[i]}"
        let fname = Fmt"{os.ExtractFilename(entry)}"
        if len(fname) > 0:
            # guard_* 文本诊断保留 (小文本台账); 只清大对象 exe/map。
            if strings.HasPrefix(fname, "guard_"):
                continue
            let _del = os.RemoveFile(Fmt"{root}/artifacts/rsi_gate/{fname}")
    echo(Fmt"cheng.rsi.gate.v1 checks_pass={passCount} checks_fail={failCount} checks_diagnostic={diagCount}")
    if failCount > 0:
        echo("rsi_gate: FAIL (缺项不得折算为通过)")
        return 1
    if diagCount > 0:
        echo("rsi_gate: DIAGNOSTIC (抬门/口径不完整轮: 不得计入任何通过/更优判词)")
        return 3
    echo("rsi_gate: PASS")
    return 0

fn main(): int32 =
    # 位置参数: rsi_gate <root> <compiler> [--quick]
    let argc = cmdline.paramCount()
    if argc < 2:
        echo("usage: rsi_gate <repoRoot> <compilerPath> [--quick]")
        return 2
    let root = Fmt"{cmdline.paramStr(1)}"
    let compilerPath = Fmt"{cmdline.paramStr(2)}"
    if strutil.Strip(root).len <= 0 || strutil.Strip(compilerPath).len <= 0:
        echo("rsi_gate requires root and compiler")
        return 2
    var quick = false
    for i in 3..<(argc + 1):
        let item = Fmt"{cmdline.paramStr(i)}"
        if item == "--quick":
            quick = true
    return gateMain(Fmt"{root}", Fmt"{compilerPath}", quick)
