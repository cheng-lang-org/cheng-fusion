# 纯 Cheng RSI 语义回归 oracle (双线融合计划车道 L4; 提案 §2.1 语义锚合并落地)。
#
# 定位: 给定编译器可执行体 -> 语义等价判决。作为内核战役每次内存/时间改动的
# 语义回归 oracle, 并与 docs/cheng-plan.md §6.3 B4 (四夹具 + 2 源对 + 8 源闭包)
# 合并为唯一语义锚。
#
# 唯一语义锚 = 产物真实运行的 (rc, stdout sha256), 锚串形如 "0:01a5d548..."。
# 否定链 (实测, 见 compiler_domain_c1c2_contract.md §正确性锚): Mach-O 产物含
# 每进程随机 uuid => 产物字节 sha 不可用; 链接 map 受 jobs 布局影响 => map sha
# 仅记账。本文件不引入第二个锚, 锚串算式与 C1/C2 账本逐字同构
# (compiler_domain.cheng:287-288: runSha=strings.Sha256(stdout); fp=rc+":"+runSha;
# 产物落账见 artifacts/rsi_compiler/current.txt 的 product_sha)。
#
# 三条语料腿 (缺项一律硬失败, 不静默不折算):
#   A) 任务域三域 31 格: 源 = generator.RsiGeneratorTaskProgram 生成 (逐格),
#      金标 = generator.RsiGeneratorGoldenAnswer 独立重算 (金标不消费候选输出),
#      逐格判 = 指纹对拍 + 金标对拍 + 域分 (compares) 重算;
#   B) 内核 B4 语料: 四夹具 (ordinary / call_fixture / cold_nested / v6)
#      + 2 源对 (msp2) + 8 源闭包 (multisource);
#   C) 编译器域 C1/C2 语料档 0 (types.RsiCompilerCorpusRel / CorpusOpen)。
#   incumbent 腿: 账本在位聚合分 <= 本工具实测重算的 best_correct
#   (判据与 main.cheng:198 逐字同构: covered==totalCells && incumbent<=bestCorrect)。
#
# 口径:
#   judge (默认) = 逐条 (src_sha, compile_rc, fp) 与冻结基线逐字节对拍;
#                  基线缺条 => missing (fail-closed, 缺判据不折算通过);
#                  源 sha 漂移 => drift (A/B 前提被破坏, 不是编译器判决);
#                  任一不等 => SEMANTIC_DIVERGENT (非零退出 + 点名条目)。
#   --record     = 金标/空间/指纹全部通过才写基线 (基线不得含坏读数);
#                  金标不符则该轮 FAIL 且拒绝写基线。
#   --self-test  = 纯比较器负例控制 (不碰编译器/不落盘): 证明本门能判 FAIL。
#
# 资源复用 (不另造第二套): 子进程超时语义 = execution.RsiRunCapture ->
#   hostos.ExecFileCapture (单调钟到限 SIGTERM, +500ms SIGKILL, timedOut 唯一
#   判词 rc=124; 机制锚见 src/tests/rsi_execution_negatives.cheng:136-138);
#   进程树 RSS 腿 = 外层 tools/beat_c_process_group_guard.sh (与 rsi_gate 的
#   rsi_rss_guard 同一脚本同一门), 本工具不自造守卫; 调用面见设计件
#   docs/campaigns/2026-09-07-pure-cheng-rsi/design_semantic_regression.md 的
#   「待槽位验证清单」。
#
# 零 @importc; argv 直发不拼 shell; 夹具平铺 (子目录会被 RsiCleanWorkDir 漏清,
# 批次十教训): 本工具临时件全部落 <root>/src/rsi_sem_work 直接子文件并自清回查;
# 2 源对/8 源闭包两条 B4 源的 import 路径固定为 cheng/tests/..., 故按 B4 原始
# 路径落 <root>/src/tests/ug_s1a_*.cheng (路径占用且内容不同 => 硬拒, 不覆盖他线文件)。
# 不调用 RsiCleanWorkDir: 它与并发 lane 可能共享工作目录, 整目录清空会删他线夹具;
# 本工具按显式清单删除 + 回查残留=0 判词。
#
# 用法:
#   rsi_semantic_regression <repoRoot> <compilerPath> <baselinePath>
#       [--record] [--ledger:<dir>] [--fixtures:<dir>]
#       [--compile-timeout:<sec>] [--run-timeout:<sec>]
#   rsi_semantic_regression --self-test
import std/cmdline as cmdline
import std/os as os
import std/strings as strings
import std/strutils as strutil
import cheng/rsi/types as types
import cheng/rsi/store as store
import cheng/rsi/compiler as compiler
import cheng/rsi/execution as execution
import cheng/rsi/generator as generator
import cheng/rsi/evaluator as evaluator

# 判词通道: 流式, 每项判定立即落 stdout (缺项不得折算为通过)。
@borrows
fn appendCheck(name: str, status: str, detail: str) =
    echo(Fmt"check={name} status={status} detail={detail}")

# 文件身份: /usr/bin/shasum argv 直发 (rsi_gate.gateCarrierSha / cdFileSha 同构);
# 文件缺失或输出不足 64 hex -> 空串 (调用方硬失败, 不猜)。
@borrows
fn fileSha256(path: str): str =
    var out: str
    var rc: int32 = 0
    execution.RsiRunCapture("/usr/bin/shasum", ["-a", "256", Fmt"{path}"], [],
                            "", 120, out, rc)
    if rc != 0:
        return ""
    let head = strutil.Strip(Fmt"{out}")
    if len(head) < 64:
        return ""
    return strings.CloneStrRange(Fmt"{head}", 0, 64)

# 内存文本 sha256 (纯 Cheng, 不落盘): 源 sha / stdout sha 同一原语。
# strings.Sha256 与 C1/C2 语义锚算式逐字同源 (compiler_domain.cheng:287)。
@borrows
fn textSha256(text: str): str =
    let digest = strings.Sha256(Fmt"{text}")
    return strings.CloneStr(Fmt"{digest}")

# 行内按空格切第 tokenIndex 个 token (0-based)。手工扫描, 不做二次 Split ——
# "连续两次 Split 产物损坏" 是既有实录 (generator.cheng:889), 故只允许
# 对原始全文 Split 一次, 行内一律字符扫描。
@borrows
fn lineTokenInto(line: str, tokenIndex: int32, outTok: var str,
                 outOk: var int32) =
    outTok = ""
    outOk = 0
    let n = len(line)
    var i: int32 = 0
    var idx: int32 = 0
    var state: int32 = 0
    while state == 0:
        while i < n && line[i] == ' ':
            i = i + 1
        if i >= n:
            state = 1
        else:
            let start = i
            while i < n && line[i] != ' ':
                i = i + 1
            if idx == tokenIndex:
                outTok = strings.CloneStrRange(Fmt"{line}", start, i - start)
                outOk = 1
                return
            idx = idx + 1

# 严格十进制整数解析 (2026-09-15 修 F6): strutil.ParseInt 对非数字/空串**静默**返回 0
# (src/std/strutils.cheng:435), 且 int 结果赋给 int32 会回绕 (--run-timeout:4294967326 -> 30)。
# 本原语先做 IntToStr 往返校验 (拒绝 "abc"/"1abc"/"+1"/"01"/"4294967326"), 再显式判 [lo, hi]。
fn strictIntInto(text: str, outVal: var int32, outOk: var int32) =
    outVal = 0
    outOk = 0
    let t = strutil.Strip(Fmt"{text}")
    if len(Fmt"{t}") <= 0:
        return
    let v = strutil.ParseInt(Fmt"{t}")
    if Fmt"{strings.IntToStr(v)}" != Fmt"{t}":
        return
    outVal = int32(v)
    outOk = 1

# 带界选项值解析 (F6): 在严格整数之上加 [lo, hi] 门 (超时合法域 [1, 86400])。
fn strictBoundedIntInto(text: str, lo: int32, hi: int32, outVal: var int32,
                        outOk: var int32) =
    outVal = 0
    outOk = 0
    var v: int32 = 0
    var ok: int32 = 0
    strictIntInto(Fmt"{text}", v, ok)
    if ok != 1:
        return
    if v < lo || v > hi:
        return
    outVal = v
    outOk = 1

# 冻结基线逐条查找。行格式 (本文件唯一写者):
#   entry <name> src_sha <64hex> compile_rc <int> fp <rc>:<64hex>|-
# 命中 => found=1; 未命中/格式坏 => found=0 (调用方判 missing, 不静默)。
@borrows
fn baselineLookupInto(baseText: str, entryName: str, outSrcSha: var str,
                      outCompileRc: var int32, outFp: var str,
                      outFound: var int32) =
    outSrcSha = ""
    outCompileRc = 0
    outFp = ""
    outFound = 0
    let lines = strutil.Split(Fmt"{baseText}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if !strings.HasPrefix(line, "entry "):
            continue
        var t1: str
        var o1: int32 = 0
        lineTokenInto(Fmt"{line}", 1, t1, o1)
        if o1 != 1:
            return
        if t1 != entryName:
            continue
        var t2: str
        var t3: str
        var t4: str
        var t5: str
        var t6: str
        var t7: str
        var o2: int32 = 0
        var o3: int32 = 0
        var o4: int32 = 0
        var o5: int32 = 0
        var o6: int32 = 0
        var o7: int32 = 0
        lineTokenInto(Fmt"{line}", 2, t2, o2)
        lineTokenInto(Fmt"{line}", 3, t3, o3)
        lineTokenInto(Fmt"{line}", 4, t4, o4)
        lineTokenInto(Fmt"{line}", 5, t5, o5)
        lineTokenInto(Fmt"{line}", 6, t6, o6)
        lineTokenInto(Fmt"{line}", 7, t7, o7)
        if o2 != 1 || o3 != 1 || o4 != 1 || o5 != 1 || o6 != 1 || o7 != 1:
            return
        if t2 != "src_sha" || t4 != "compile_rc" || t6 != "fp":
            return
        # F6: compile_rc 必须逐字是十进制整数; 非数字 (手改坏基线) found=0 => missing,
        # 不再被 ParseInt 静默当 0 参与判定。
        var crcVal: int32 = 0
        var crcOk: int32 = 0
        strictIntInto(Fmt"{t5}", crcVal, crcOk)
        if crcOk != 1:
            return
        outSrcSha = strings.CloneStr(Fmt"{t3}")
        outCompileRc = crcVal
        outFp = strings.CloneStr(Fmt"{t7}")
        outFound = 1
        return

# 指纹对拍 (纯函数, --self-test 直接复用): 逐字段比较, 任一不等即 differ;
# 基线缺条 = missing; 源 sha 漂移 = drift (A/B 前提被破坏, 不是编译器判决)。
@borrows
fn judgeFingerprintInto(recordMode: bool, baseText: str, entryName: str,
                        srcSha: str, compileRc: int32, fp: str,
                        outVerdict: var str, outDetail: var str) =
    outVerdict = "pass"
    outDetail = "record_mode"
    if recordMode:
        # record 准入硬门 (2026-09-14 修, 子代理审查 F1): 原实现 record 恒 pass ⇒ 编译失败/
        # 超时(rc=124) 会被当成"读数"冻进基线, 与设计 §四「基线不得含坏读数」直接冲突。
        # 现在只有"编译成功且指纹成立"的读数才准入库; 编译失败一律硬拒(整体 rc!=0), 操作者
        # 必须查因后重录。运行期 rc!=0 仍合法 —— 它被 <rc> 前缀锚进 fp, 是可复现的确定性读数。
        if compileRc != 0:
            outVerdict = "record_reject"
            outDetail = Fmt"bad_reading compile_rc={compileRc} 编译失败/超时不得入基线"
            return
        if len(Fmt"{fp}") <= 2:
            outVerdict = "record_reject"
            outDetail = "bad_reading fp_absent"
            return
        # 残余① (2026-09-14 二轮审查, 子代理 F2): 运行超时 rc=124 是**负载相关**读数(非确定性),
        # 不得入基线。编译期超时已被上面的 compileRc!=0 挡掉, 这里补挡运行期超时。
        if strings.HasPrefix(Fmt"{fp}", "124:"):
            outVerdict = "record_reject"
            outDetail = "bad_reading run_timeout rc=124 (负载相关, 非确定性)"
            return
        outDetail = Fmt"record_mode compile_rc=0 fp={fp}"
        return
    outDetail = ""
    var bSrc: str
    var bCompile: int32 = 0
    var bFp: str
    var found: int32 = 0
    baselineLookupInto(Fmt"{baseText}", Fmt"{entryName}", bSrc, bCompile, bFp,
                       found)
    if found != 1:
        outVerdict = "missing"
        outDetail = "baseline_entry_absent"
        return
    if Fmt"{bSrc}" != Fmt"{srcSha}":
        outVerdict = "drift"
        outDetail = Fmt"corpus_src_sha baseline={bSrc} current={srcSha}"
        return
    if bCompile != compileRc:
        outVerdict = "differ"
        outDetail = Fmt"compile_rc baseline={bCompile} current={compileRc}"
        return
    if Fmt"{bFp}" != Fmt"{fp}":
        outVerdict = "differ"
        outDetail = Fmt"fp baseline={bFp} current={fp}"
        return
    outDetail = Fmt"baseline=equal fp={fp}"

# 观测缓存 (2026-09-13 加, 车道 L4 对"调度饥荒"的结构应对):
# 单轮 V2/V3 需**连续 3-5 分钟**窗口, 而现势实测窗口 = 内核线两轮之间的 1-2 秒缝隙,
# 最长一次也只有 26 秒 (那一轮跑了 8 格就被外来编译抢槽)。不缓存 => 每轮从零开始,
# 不是慢, 是**永远跑不完**。
# 口径 (硬约束, 不得放宽): **只缓存全绿观测** (crc=0 && rrc=0 && judge=pass &&
# 格子 golden=match)。任何非绿一律不落缓存 => 缓存只能确认绿, 不能掩盖红。
# 键 = (载体 sha256) : (工具 sha256, 由调用方经 --cache-key 传入) + 条目名 + 条目 src sha;
# 任一变化必然 miss。不传 --cache-key => 缓存整体禁用 (fail-safe: 缺键只会全量重跑)。
# 命中条目在判词里带 cached=obs_v1 标记, 回执按 `grep -c cached=obs_v1` 数 hit 数。
# fp 的 rc 前缀解析 (2026-09-14 修, 子代理审查 F2): "0:<sha>" -> 0; 非法 -> -1。
# 回合制往返校验 (IntToStr(ParseInt(h)) == h) 保证"非数字一律 -1", 绝不把非法前缀当 0。
@borrows
fn fpRcPrefixOf(fp: str): int32 =
    let parts: str[] = strutil.Split(Fmt"{fp}", ':')
    if len(parts) < 2:
        return -1
    let head = Fmt"{parts[0]}"
    if len(Fmt"{head}") <= 0:
        return -1
    let v = strutil.ParseInt(Fmt"{head}")
    if Fmt"{strings.IntToStr(v)}" != Fmt"{head}":
        return -1
    return v

fn cacheFileFor(cacheDir: str, entryName: str): str =
    return Fmt"{cacheDir}/{entryName}.obs"

@borrows
fn obsCacheLookupInto(cacheDir: str, cacheKey: str, entryName: str, srcSha: str,
                      outCrc: var int32, outRrc: var int32, outScore: var int64,
                      outGolden: var str, outCorrect: var int32, outFp: var str,
                      outHit: var int32) =
    outHit = 0
    outCrc = 0
    outRrc = 0
    outScore = 0
    outGolden = ""
    outCorrect = 0
    outFp = ""
    if len(cacheKey) <= 0:
        return
    let path = cacheFileFor(Fmt"{cacheDir}", Fmt"{entryName}")
    if !os.FileExists(Fmt"{path}"):
        return
    # 铁律 (2026-09-13 探针实测, 见 .rebuild/patchwork/probe4.log): 在 @borrows 函数内把
    # **调用结果**直接当另一个 @borrows 形参的实参 (Split(ReadFile(...), ...)) 会拿到空串,
    # 表现为"写进得去、读永远 miss"(同进程 store->lookup 实测 hit=0); 先落局部后 hit=1。
    let text = os.ReadFile(Fmt"{path}")
    let lines: str[] = strutil.Split(Fmt"{text}", '\n')
    if len(lines) < 5:
        return
    if Fmt"{lines[0]}" != "cache_v1":
        return
    if Fmt"{lines[1]}" != Fmt"key {cacheKey} {srcSha} {entryName}":
        return
    # 只认全绿 (obs 0 0); 非绿记录一律当 miss 重跑, 绝不复用。
    if Fmt"{lines[2]}" != "obs 0 0":
        return
    let fpLine: str[] = strutil.Split(Fmt"{lines[3]}", ' ')
    let gLine: str[] = strutil.Split(Fmt"{lines[4]}", ' ')
    if len(fpLine) < 2 || len(gLine) < 4:
        return
    # 一致性硬校验 (2026-09-14 修, F2): 只有 fp 自证 rc 前缀 = 0 的观测才可重放。旧格式把
    # "obs 0 0" 写成常量, 于是 run rc=1 的观测也带 "obs 0 0" 被当全绿重放 (物证
    # .rebuild/semantic/obs_cache/fixture_call_fixture.obs)。坏条目一律 miss ⇒ 冷跑重写(自愈)。
    if fpRcPrefixOf(Fmt"{fpLine[1]}") != 0:
        return
    outFp = strings.CloneStr(Fmt"{fpLine[1]}")
    outGolden = strings.CloneStr(Fmt"{gLine[1]}")
    outScore = int64(strutil.ParseInt(Fmt"{gLine[2]}"))
    outCorrect = int32(strutil.ParseInt(Fmt"{gLine[3]}"))
    outHit = 1

@borrows
fn obsCacheStore(cacheDir: str, cacheKey: str, entryName: str, srcSha: str,
                 crc: int32, rrc: int32, fp: str, golden: str, score: int64,
                 correct: int32) =
    # 只缓存全绿读数 (2026-09-14 修, 子代理审查 F2): 原实现把 "obs 0 0" 写成**常量**,
    # 既不收 rc 也不校验 ⇒ 任何观测都被标成全绿。现在非全绿一律不落缓存, 落盘值即真值。
    if crc != 0 || rrc != 0:
        return
    if len(cacheKey) <= 0:
        return
    os.MkdirAll(Fmt"{cacheDir}", 493)
    var parts: str[]
    add(parts, "cache_v1")
    add(parts, Fmt"key {cacheKey} {srcSha} {entryName}")
    add(parts, Fmt"obs {crc} {rrc}")
    add(parts, Fmt"fp {fp}")
    add(parts, Fmt"golden {golden} {strings.Int64ToStr(score)} {correct}")
    os.WriteFile(cacheFileFor(Fmt"{cacheDir}", Fmt"{entryName}"),
                 strutil.Join(parts, "\n"))
# 平铺落源 (不建子目录): 已存在且内容逐字节相同 => 复用 (上一轮崩溃残留);
# 已存在且内容不同 => 硬拒不覆盖 (他线文件); 写入后必须回读逐字节相等
# (不信任吞掉错误的写返回值)。
@borrows
fn stageSourceInto(path: str, content: str, outOk: var int32,
                   outWhy: var str) =
    outOk = 0
    outWhy = ""
    if os.FileExists(Fmt"{path}"):
        let existing = os.ReadFile(Fmt"{path}")
        if Fmt"{existing}" == Fmt"{content}":
            outOk = 1
            outWhy = "reused"
            return
        outWhy = "path_occupied_by_other_content"
        return
    os.WriteFile(Fmt"{path}", Fmt"{content}")
    let back = os.ReadFile(Fmt"{path}")
    if Fmt"{back}" != Fmt"{content}":
        outWhy = "write_readback_mismatch"
        return
    outOk = 1
    outWhy = "written"

# 单条语料探针: 编译 (冻结通道 compiler.RsiCompileCheng, argv 直发) -> 运行。
# 编译失败不运行 (rc=-1, output 空串 => 调用方记 fp="-")。运行 workingDir 用
# 空串 = 继承, 与 C1/C2 语义锚实测口径一致 (compiler_domain.cheng:284)。
@borrows
fn probeProgramInto(compilerPath: str, root: str, srcPath: str, binPath: str,
                    env: str[], compileTimeoutSec: int32, runTimeoutSec: int32,
                    outCompileRc: var int32, outRunRc: var int32,
                    outOutput: var str) =
    outRunRc = -1
    outOutput = ""
    outCompileRc = compiler.RsiCompileCheng(Fmt"{compilerPath}", Fmt"{root}",
                                            Fmt"{srcPath}", Fmt"{binPath}",
                                            compileTimeoutSec, env)
    if outCompileRc != 0:
        return
    var output: str
    var rc: int32 = 0
    execution.RsiRunCapture(Fmt"{binPath}", [], [], "", runTimeoutSec, output,
                            rc)
    outRunRc = rc
    outOutput = strings.CloneStr(Fmt"{output}")

# known-red 平价白名单 (设计 §八 解 B / §十 V5; 2026-09-15 修 anchor=rc_only): 8 源闭包
# 回归 compile_rc=2 (原子租约不可用) 时允许经 --anchor:rc_only 显式标注后按 compile_rc
# 平价记录 —— 弱化已知、不冒充; 白名单只含 2, 其余 rc (尤其 124) 仍硬拒。
fn isKnownRedCompileRc(rc: int32): int32 =
    if rc == 2:
        return 1
    return 0

# record 准入的 anchor 覆盖判据 (纯函数, --self-test 直接复用): 仅 "record 轮 +
# 显式 --anchor:rc_only + known-red rc" 三者同时成立才放行。
fn anchorAdmissionIsPass(recordMode: bool, anchorRcOnly: bool,
                         compileRc: int32): int32 =
    if recordMode && anchorRcOnly && isKnownRedCompileRc(compileRc) == 1:
        return 1
    return 0

# 单条语料判定 + 基线行累积 (夹具/源对/闭包/语料档共用同一条判据)。
@borrows
fn corpusEntryRun(recordMode: bool, anchorRcOnly: bool, baseText: str,
                  compilerPath: str, root: str,
                  entryName: str, srcPath: str, binPath: str, srcSha: str,
                  env: str[], compileTimeoutSec: int32, runTimeoutSec: int32,
                  cacheDir: str, cacheKey: str,
                  parts: var str[], outPass: var int32, outFail: var int32) =
    var hCrc: int32 = 0
    var hRrc: int32 = 0
    var hScore: int64 = 0
    var hGolden: str
    var hCorrect: int32 = 0
    var hFp: str
    var hit: int32 = 0
    obsCacheLookupInto(Fmt"{cacheDir}", Fmt"{cacheKey}", Fmt"{entryName}",
                       Fmt"{srcSha}", hCrc, hRrc, hScore, hGolden, hCorrect,
                       hFp, hit)
    if hit == 1:
        # 命中 = 该 (载体, 工具, 源) 三元组此前实测全绿; judge 判据仍逐轮重算
        # (基线缺条/源漂移照旧判 missing/drift), 省掉的只有"编译+运行"这一步。
        var jv: str
        var jd: str
        judgeFingerprintInto(recordMode, Fmt"{baseText}", Fmt"{entryName}",
                             Fmt"{srcSha}", hCrc, Fmt"{hFp}", jv, jd)
        add(parts, Fmt"entry {entryName} src_sha {srcSha} compile_rc {hCrc} fp {hFp}")
        if jv == "pass":
            appendCheck(Fmt"{entryName}", "PASS",
                        Fmt"compile_rc={hCrc} fp={hFp} {jd} cached=obs_v1")
            outPass = outPass + 1
        else:
            appendCheck(Fmt"{entryName}", "FAIL",
                        Fmt"verdict={jv} compile_rc={hCrc} fp={hFp} {jd} cached=obs_v1")
            outFail = outFail + 1
        return
    var crc: int32 = 0
    var rrc: int32 = 0
    var output: str
    probeProgramInto(Fmt"{compilerPath}", Fmt"{root}", Fmt"{srcPath}",
                     Fmt"{binPath}", env, compileTimeoutSec, runTimeoutSec,
                     crc, rrc, output)
    var fp: str = "-"
    if crc == 0:
        let runSha = textSha256(Fmt"{output}")
        fp = Fmt"{rrc}:{runSha}"
    var verdict: str
    var detail: str
    judgeFingerprintInto(recordMode, Fmt"{baseText}", Fmt"{entryName}",
                         Fmt"{srcSha}", crc, Fmt"{fp}", verdict, detail)
    # anchor=rc_only: 仅显式标注 + known-red rc 的 record 轮放行; 基线行尾追加
    # anchor rc_only 作披露 (judge 侧只读 token 1..7, 向后兼容)。
    let anchorPass = anchorAdmissionIsPass(recordMode, anchorRcOnly, crc)
    if anchorPass == 1:
        verdict = "pass"
        detail = Fmt"anchor=rc_only compile_rc={crc} (known-red 平价, 显式标注)"
    var entryLine: str = Fmt"entry {entryName} src_sha {srcSha} compile_rc {crc} fp {fp}"
    if anchorPass == 1:
        entryLine = Fmt"{entryLine} anchor rc_only"
    add(parts, Fmt"{entryLine}")
    if verdict == "pass":
        appendCheck(Fmt"{entryName}", "PASS",
                    Fmt"compile_rc={crc} fp={fp} {detail}")
        outPass = outPass + 1
        obsCacheStore(Fmt"{cacheDir}", Fmt"{cacheKey}", Fmt"{entryName}",
                      Fmt"{srcSha}", crc, rrc, Fmt"{fp}", "-", int64(0), 0)
    else:
        appendCheck(Fmt"{entryName}", "FAIL",
                    Fmt"verdict={verdict} compile_rc={crc} fp={fp} {detail}")
        outFail = outFail + 1

# 任务域单格判定: 生成源 -> 编译 -> 运行 -> 指纹对拍 + 金标对拍 + 域分重算。
# 金标不符 = 硬失败 (miscompile/错输出), record 模式同样拒绝入基线。
@borrows
fn taskCellRun(recordMode: bool, baseText: str, compilerPath: str, root: str,
               workDir: str, env: str[], d: int32, s: int32, p: int32,
               compileTimeoutSec: int32, runTimeoutSec: int32,
               cacheDir: str, cacheKey: str,
               parts: var str[], outPass: var int32, outFail: var int32,
               outCorrect: var int32, outScore: var int64) =
    outCorrect = 0
    outScore = 0
    let name = Fmt"cell_d{d}_s{s}_p{p}"
    let program = generator.RsiGeneratorTaskProgram(d, s, p)
    if len(program) <= 0:
        appendCheck(Fmt"{name}", "FAIL", "generator_empty_program")
        outFail = outFail + 1
        return
    let srcPath = Fmt"{workDir}/sem_{name}.cheng"
    let binPath = Fmt"{workDir}/sem_{name}"
    let srcSha = textSha256(Fmt"{program}")
    var hCrc: int32 = 0
    var hRrc: int32 = 0
    var hScore: int64 = 0
    var hGolden: str
    var hCorrect: int32 = 0
    var hFp: str
    var hit: int32 = 0
    obsCacheLookupInto(Fmt"{cacheDir}", Fmt"{cacheKey}", Fmt"{name}",
                       Fmt"{srcSha}", hCrc, hRrc, hScore, hGolden, hCorrect,
                       hFp, hit)
    if hit == 1:
        # 命中条目: 金标/域分由缓存回放 (只可能来自此前实测 golden=match 的全绿轮),
        # judge 判据逐轮重算 => 基线比对照旧生效。
        var jv: str
        var jd: str
        judgeFingerprintInto(recordMode, Fmt"{baseText}", Fmt"{name}",
                             Fmt"{srcSha}", hCrc, Fmt"{hFp}", jv, jd)
        add(parts, Fmt"entry {name} src_sha {srcSha} compile_rc {hCrc} fp {hFp}")
        outCorrect = hCorrect
        outScore = hScore
        let hScoreText = strings.Int64ToStr(hScore)
        if jv == "pass" && Fmt"{hGolden}" == "match":
            appendCheck(Fmt"{name}", "PASS",
                        Fmt"compile_rc={hCrc} fp={hFp} golden=match score={hScoreText} {jd} cached=obs_v1")
            outPass = outPass + 1
        else:
            appendCheck(Fmt"{name}", "FAIL",
                        Fmt"verdict={jv} compile_rc={hCrc} fp={hFp} golden={hGolden} score={hScoreText} {jd} cached=obs_v1")
            outFail = outFail + 1
        return
    var stageOk: int32 = 0
    var stageWhy: str
    stageSourceInto(Fmt"{srcPath}", Fmt"{program}", stageOk, stageWhy)
    if stageOk != 1:
        appendCheck(Fmt"{name}", "FAIL", Fmt"stage_failed why={stageWhy}")
        outFail = outFail + 1
        return
    var crc: int32 = 0
    var rrc: int32 = 0
    var output: str
    probeProgramInto(Fmt"{compilerPath}", Fmt"{root}", Fmt"{srcPath}",
                     Fmt"{binPath}", env, compileTimeoutSec, runTimeoutSec,
                     crc, rrc, output)
    var fp: str = "-"
    if crc == 0:
        let runSha = textSha256(Fmt"{output}")
        fp = Fmt"{rrc}:{runSha}"
    # 金标对拍: 正确性由本工具对照 generator 金标重算, 候选输出不作自证。
    var goldenVerdict: str = "not_run"
    if crc == 0 && rrc == 0:
        var parsedOk: int32 = 0
        var answer: str
        var compares: int64 = 0
        evaluator.RsiParseTaskOutputInto(Fmt"{output}", parsedOk, answer,
                                         compares)
        if parsedOk != 1:
            goldenVerdict = "output_format_invalid"
        elif evaluator.RsiTaskCandidateCorrect(d, Fmt"{answer}"):
            goldenVerdict = "match"
            outCorrect = 1
            outScore = compares
        else:
            goldenVerdict = "mismatch"
    var verdict: str
    var detail: str
    judgeFingerprintInto(recordMode, Fmt"{baseText}", Fmt"{name}",
                         Fmt"{srcSha}", crc, Fmt"{fp}", verdict, detail)
    add(parts, Fmt"entry {name} src_sha {srcSha} compile_rc {crc} fp {fp}")
    let scoreText = strings.Int64ToStr(outScore)
    if verdict == "pass" && goldenVerdict == "match":
        appendCheck(Fmt"{name}", "PASS",
                    Fmt"compile_rc={crc} fp={fp} golden=match score={scoreText} {detail}")
        outPass = outPass + 1
        obsCacheStore(Fmt"{cacheDir}", Fmt"{cacheKey}", Fmt"{name}",
                      Fmt"{srcSha}", crc, rrc, Fmt"{fp}", "match", outScore,
                      outCorrect)
    else:
        appendCheck(Fmt"{name}", "FAIL",
                    Fmt"verdict={verdict} compile_rc={crc} fp={fp} golden={goldenVerdict} score={scoreText} {detail}")
        outFail = outFail + 1

# B4 四夹具单条: 从 fixtures 目录读原始字节 -> 平铺暂编 -> 判定 (源 sha 入基线,
# 夹具字节漂移同样判 drift, 不是静默换语料)。
@borrows
fn corpusFileRun(recordMode: bool, anchorRcOnly: bool, baseText: str,
                 compilerPath: str, root: str,
                 workDir: str, fixturesDir: str, env: str[], entryName: str,
                 masterRel: str, compileTimeoutSec: int32,
                 runTimeoutSec: int32, cacheDir: str, cacheKey: str,
                 parts: var str[], outPass: var int32,
                 outFail: var int32) =
    let masterPath = Fmt"{fixturesDir}/{masterRel}"
    if !os.FileExists(Fmt"{masterPath}"):
        appendCheck(Fmt"{entryName}", "FAIL",
                    Fmt"fixture_master_missing path={masterPath}")
        outFail = outFail + 1
        return
    let content = os.ReadFile(Fmt"{masterPath}")
    if len(content) <= 0:
        appendCheck(Fmt"{entryName}", "FAIL",
                    Fmt"fixture_master_empty path={masterPath}")
        outFail = outFail + 1
        return
    let srcPath = Fmt"{workDir}/sem_{entryName}.cheng"
    let binPath = Fmt"{workDir}/sem_{entryName}.bin"
    let srcSha = textSha256(Fmt"{content}")
    var stageOk: int32 = 0
    var stageWhy: str
    stageSourceInto(Fmt"{srcPath}", Fmt"{content}", stageOk, stageWhy)
    if stageOk != 1:
        appendCheck(Fmt"{entryName}", "FAIL", Fmt"stage_failed why={stageWhy}")
        outFail = outFail + 1
        return
    corpusEntryRun(recordMode, anchorRcOnly, Fmt"{baseText}",
                   Fmt"{compilerPath}",
                   Fmt"{root}", Fmt"{entryName}", Fmt"{srcPath}",
                   Fmt"{binPath}", Fmt"{srcSha}", env, compileTimeoutSec,
                   runTimeoutSec, Fmt"{cacheDir}", Fmt"{cacheKey}", parts,
                   outPass, outFail)

# B4 2 源对源文本 (msp2; 逐字取自 s1b_impl_progress.md §10.1 的原脚本 printf 引文)。
# 尾部换行口径未钉 (原脚本 .rebuild/run_s1a/run_ms_pair2.sh 已不在盘上) —— 见设计件
# 「未钉项」; src_sha 入基线, 字节漂移会判 drift 而不是静默换语料。
fn inlinePairLibText(): str =
    var parts: str[]
    add(parts, "# src/tests/ug_s1a_ms_lib.cheng")
    add(parts, "type")
    add(parts, "    S1aLibCell = object")
    add(parts, "        value: int32")
    add(parts, "")
    add(parts, "fn S1aLibProbe(): int32 =")
    add(parts, "    return 7")
    return strutil.Join(parts, "\n")

fn inlinePairMainText(): str =
    var parts: str[]
    add(parts, "# src/tests/ug_s1a_ms_main.cheng")
    add(parts, "import cheng/tests/ug_s1a_ms_lib")
    add(parts, "")
    add(parts, "type")
    add(parts, "    S1aHolder = object")
    add(parts, "        cell: S1aLibCell")
    add(parts, "        tag: int32")
    add(parts, "")
    add(parts, "fn main(): int32 =")
    add(parts, "    return S1aLibProbe() - 7")
    return strutil.Join(parts, "\n")

# B4 8 源闭包入口源 (multisource; 逐字取自 s1b_impl_progress.md §10.1)。
fn inlineClosureText(): str =
    var parts: str[]
    add(parts, "# src/tests/ug_s1a_multisource.cheng")
    add(parts, "import std/buffer")
    add(parts, "")
    add(parts, "type")
    add(parts, "    S1aImported = object")
    add(parts, "        buf: GrowByteBuffer")
    add(parts, "        tag: int32")
    add(parts, "")
    add(parts, "type")
    add(parts, "    S1aLocal = object")
    add(parts, "        imported: S1aImported")
    add(parts, "        ordinal: int32")
    add(parts, "")
    add(parts, "fn main(): int32 =")
    add(parts, "    return 0")
    return strutil.Join(parts, "\n")

# 基线头 compiler_sha 读取 (provenance; judge 模式不作判据 —— 被测编译器
# 换二进制正是本门的用途, 基线绑的是语料与锚, 不是被测体身份)。
@borrows
fn baselineCompilerShaInto(baseText: str, outSha: var str, outOk: var int32) =
    outSha = ""
    outOk = 0
    let lines = strutil.Split(Fmt"{baseText}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if !strings.HasPrefix(line, "compiler_sha "):
            continue
        let digits = strings.CloneStrRange(Fmt"{line}", 13, len(line) - 13)
        if len(digits) != 64:
            return
        outSha = strings.CloneStr(Fmt"{digits}")
        outOk = 1
        return

# 基线原子落盘: 写 .tmp -> 回读逐字节相等 -> rename; 任一步不成立即 false。
@borrows
fn writeBaselineVerify(path: str, text: str): bool =
    let tmpPath = strutil.Join([Fmt"{path}", ".tmp"], "")
    os.WriteFile(Fmt"{tmpPath}", Fmt"{text}")
    let back = os.ReadFile(Fmt"{tmpPath}")
    if Fmt"{back}" != Fmt"{text}":
        return false
    let renamed = os.RenameFile(Fmt"{tmpPath}", Fmt"{path}")
    return renamed

# 自检负例控制 (纯比较器, 不需要编译器/不落盘): 证明判据能把不等判成 FAIL,
# 且缺条/漂移 fail-closed。合成基线用运行时 sha, 不含任何未实测常数。
fn selfTestCheck(caseName: str, got: str, want: str, outPass: var int32,
                 outFail: var int32) =
    if Fmt"{got}" == Fmt"{want}":
        appendCheck(Fmt"self_test_{caseName}", "PASS", Fmt"verdict={got}")
        outPass = outPass + 1
    else:
        appendCheck(Fmt"self_test_{caseName}", "FAIL",
                    Fmt"verdict={got} want={want}")
        outFail = outFail + 1

fn selfTest(): int32 =
    var passCount: int32 = 0
    var failCount: int32 = 0
    let srcA = textSha256("self-test-source-a")
    let outA = textSha256("self-test-output-a")
    let outB = textSha256("self-test-output-b")
    var lines: str[]
    add(lines, "# cheng.rsi.semantic_regression.v1")
    add(lines, Fmt"compiler_sha {srcA}")
    add(lines, Fmt"entry self_a src_sha {srcA} compile_rc 0 fp 0:{outA}")
    let baseText = strutil.Join(lines, "\n")
    let fpA = Fmt"0:{outA}"
    let fpB = Fmt"0:{outB}"
    var verdict: str
    var detail: str
    judgeFingerprintInto(false, Fmt"{baseText}", "self_a", Fmt"{srcA}", 0,
                         Fmt"{fpA}", verdict, detail)
    selfTestCheck("identical", Fmt"{verdict}", "pass", passCount, failCount)
    judgeFingerprintInto(false, Fmt"{baseText}", "self_a", Fmt"{srcA}", 0,
                         Fmt"{fpB}", verdict, detail)
    selfTestCheck("stdout_sha_changed", Fmt"{verdict}", "differ", passCount,
                  failCount)
    judgeFingerprintInto(false, Fmt"{baseText}", "self_a", Fmt"{srcA}", 1,
                         Fmt"{fpA}", verdict, detail)
    selfTestCheck("compile_rc_changed", Fmt"{verdict}", "differ", passCount,
                  failCount)
    judgeFingerprintInto(false, Fmt"{baseText}", "self_a", Fmt"{outB}", 0,
                         Fmt"{fpA}", verdict, detail)
    selfTestCheck("src_sha_drift", Fmt"{verdict}", "drift", passCount,
                  failCount)
    judgeFingerprintInto(false, Fmt"{baseText}", "self_absent", Fmt"{srcA}", 0,
                         Fmt"{fpA}", verdict, detail)
    selfTestCheck("baseline_entry_absent", Fmt"{verdict}", "missing",
                  passCount, failCount)
    judgeFingerprintInto(false, Fmt"{baseText}", "self_a", Fmt"{srcA}", 0, "-",
                         verdict, detail)
    selfTestCheck("no_artifact", Fmt"{verdict}", "differ", passCount, failCount)
    judgeFingerprintInto(true, Fmt"{baseText}", "self_a", Fmt"{srcA}", 0,
                         Fmt"{fpB}", verdict, detail)
    selfTestCheck("record_mode_pass", Fmt"{verdict}", "pass", passCount,
                  failCount)
    # F1 回归护栏 (2026-09-14): record 模式对坏读数必须硬拒, 不得再"恒 pass"。
    judgeFingerprintInto(true, Fmt"{baseText}", "self_a", Fmt"{srcA}", 124, "-",
                         verdict, detail)
    selfTestCheck("record_mode_reject_timeout", Fmt"{verdict}", "record_reject",
                  passCount, failCount)
    judgeFingerprintInto(true, Fmt"{baseText}", "self_a", Fmt"{srcA}", 3,
                         Fmt"{fpB}", verdict, detail)
    selfTestCheck("record_mode_reject_compile_fail", Fmt"{verdict}",
                  "record_reject", passCount, failCount)
    judgeFingerprintInto(true, Fmt"{baseText}", "self_a", Fmt"{srcA}", 0,
                         Fmt"124:{outB}", verdict, detail)
    selfTestCheck("record_mode_reject_run_timeout", Fmt"{verdict}",
                  "record_reject", passCount, failCount)
    judgeFingerprintInto(true, Fmt"{baseText}", "self_a", Fmt"{srcA}", 0, "-",
                         verdict, detail)
    selfTestCheck("record_mode_reject_fp_absent", Fmt"{verdict}",
                  "record_reject", passCount, failCount)
    # ---- T04 残余修复回归护栏 (2026-09-15) ----
    # F4: 账本归因 —— bestCorrect<0 必须归因 oracle_best_correct_missing, 不得写 "越界"。
    let attrMissing = ledgerAttribution(1, int64(10), int64(-1))
    selfTestCheck("ledger_oracle_missing", Fmt"{attrMissing}",
                  "oracle_best_correct_missing", passCount, failCount)
    let attrPass = ledgerAttribution(1, int64(5), int64(7))
    selfTestCheck("ledger_pass", Fmt"{attrPass}", "pass", passCount, failCount)
    let attrOver = ledgerAttribution(1, int64(9), int64(7))
    selfTestCheck("ledger_over", Fmt"{attrOver}",
                  "incumbent_over_oracle_best_correct", passCount, failCount)
    # F5: 空选项目志 —— 空/纯空白必须判缺失, 非空放行。
    let optEmpty = optionValueMissing("")
    selfTestCheck("option_empty", Fmt"{optEmpty}", "1", passCount, failCount)
    let optBlank = optionValueMissing("   ")
    selfTestCheck("option_blank", Fmt"{optBlank}", "1", passCount, failCount)
    let optPresent = optionValueMissing("/tmp/cache")
    selfTestCheck("option_present", Fmt"{optPresent}", "0", passCount,
                  failCount)
    # F6: 超时 int32 回绕与非数字 —— 必须拒; 合法值必须放行。
    var tv: int32 = 0
    var tok: int32 = 0
    strictBoundedIntInto("30", 1, 86400, tv, tok)
    selfTestCheck("timeout_ok", Fmt"{tok}:{tv}", "1:30", passCount, failCount)
    strictBoundedIntInto("4294967326", 1, 86400, tv, tok)
    selfTestCheck("timeout_wrap_reject", Fmt"{tok}", "0", passCount, failCount)
    strictBoundedIntInto("abc", 1, 86400, tv, tok)
    selfTestCheck("timeout_nonnumeric_reject", Fmt"{tok}", "0", passCount,
                  failCount)
    # F6: 基线 compile_rc 非数字不得被 ParseInt 静默当 0 (端到端: 走 judge 判定)。
    var badLines: str[]
    add(badLines, Fmt"entry self_bad src_sha {srcA} compile_rc x fp 0:{outA}")
    let badBase = strutil.Join(badLines, "\n")
    judgeFingerprintInto(false, Fmt"{badBase}", "self_bad", Fmt"{srcA}", 0,
                         Fmt"{fpA}", verdict, detail)
    selfTestCheck("baseline_compile_rc_nonnumeric", Fmt"{verdict}", "missing",
                  passCount, failCount)
    # 残余②: 共享 workDir 清场只认 sem_ 前缀, 他线文件不碰。
    let semMatch = isSemTempName("sem_a.cheng")
    selfTestCheck("sem_prefix_match", Fmt"{semMatch}", "1", passCount,
                  failCount)
    let semOther = isSemTempName("cd_cand1.bin")
    selfTestCheck("sem_prefix_other_lane", Fmt"{semOther}", "0", passCount,
                  failCount)
    let semNear = isSemTempName("semtex")
    selfTestCheck("sem_prefix_near_miss", Fmt"{semNear}", "0", passCount,
                  failCount)
    # anchor=rc_only: 仅 record + 显式标注 + known-red rc 三者齐备才放行。
    let ancKnownRed = anchorAdmissionIsPass(true, true, 2)
    selfTestCheck("anchor_rc_only_known_red", Fmt"{ancKnownRed}", "1",
                  passCount, failCount)
    let ancNoFlag = anchorAdmissionIsPass(true, false, 2)
    selfTestCheck("anchor_without_flag_reject", Fmt"{ancNoFlag}", "0",
                  passCount, failCount)
    let ancTimeout = anchorAdmissionIsPass(true, true, 124)
    selfTestCheck("anchor_timeout_reject", Fmt"{ancTimeout}", "0", passCount,
                  failCount)
    let passText = strings.IntToStr(passCount)
    let failText = strings.IntToStr(failCount)
    echo(Fmt"cheng.rsi.semantic.v1 self_test_pass={passText} self_test_fail={failText}")
    if failCount > 0:
        echo("rsi_semantic: FAIL (self-test: 判据不能判 FAIL = 门无效)")
        return 1
    echo("rsi_semantic: SELF_TEST_PASS")
    return 0

# 账本归因 (2026-09-15 修 F4): 旧实现把 "bestCorrect<0 (某域无 correct 观测)" 也打印成
# "incumbent 越 oracle 重算最优", 同一根因被记成 3 条 FAIL 且判词误导。本纯函数给出
# 唯一归因词, 判词分支逐字消费。
fn ledgerAttribution(ledgerOk: int32, incumbent: int64, bestCorrect: int64): str =
    if ledgerOk != 1:
        return "ledger_unreadable"
    if bestCorrect < 0:
        return "oracle_best_correct_missing"
    if incumbent <= bestCorrect:
        return "pass"
    return "incumbent_over_oracle_best_correct"

# 共享 workDir 清场判据 (2026-09-15 修 残余②): 只回收本工具平铺前缀 sem_ 下的临时件;
# <root>/src/rsi_sem_work 可能与并发 lane 共用, 非 sem_ 前缀一律不碰。
fn isSemTempName(name: str): int32 =
    if strings.HasPrefix(Fmt"{name}", "sem_"):
        return 1
    return 0

fn semanticMain(root: str, compilerPath: str, baselinePath: str,
                recordMode: bool, anchorRcOnly: bool, ledgerDir: str,
                fixturesDir: str, compileTimeoutSec: int32,
                runTimeoutSec: int32, cacheDir: str, toolKey: str): int32 =
    var passCount: int32 = 0
    var failCount: int32 = 0
    let env = ["CHENG_ENTRY_CACHE=0", "CHENG_NO_CACHE=1",
               "CHENG_STRICT_NO_CACHE=1"]
    # 0) 编译器体在位 + sha256 (证据绑定; judge 模式只记 provenance)。
    if !os.FileExists(Fmt"{compilerPath}"):
        appendCheck("compiler_present", "FAIL",
                    Fmt"missing path={compilerPath}")
        return 1
    let compilerSha = fileSha256(Fmt"{compilerPath}")
    if len(compilerSha) != 64:
        appendCheck("compiler_sha256", "FAIL",
                    Fmt"unavailable path={compilerPath}")
        return 1
    appendCheck("compiler_sha256", "PASS", Fmt"sha256={compilerSha}")
    passCount = passCount + 1
    # 观测缓存键 = (载体 sha256) : (工具 sha256, 由 --cache-key 传入);
    # 工具键为空 => 缓存整体禁用 (缺键只全量重跑, 不会命中错键)。
    var cacheKey: str = ""
    if len(toolKey) > 0:
        cacheKey = Fmt"{compilerSha}:{toolKey}"
    # 1) 基线 (judge 必读; record 只记 provenance)。
    var baseText: str
    if recordMode:
        appendCheck("baseline_mode", "PASS",
                    Fmt"record path={baselinePath}")
        passCount = passCount + 1
    else:
        baseText = os.ReadFile(Fmt"{baselinePath}")
        if len(baseText) <= 0:
            appendCheck("baseline_present", "FAIL",
                        Fmt"missing_or_empty path={baselinePath}")
            return 1
        if !strutil.Contains(Fmt"{baseText}", "cheng.rsi.semantic_regression.v1"):
            appendCheck("baseline_schema", "FAIL",
                        Fmt"schema_header_absent path={baselinePath}")
            return 1
        var bCarrier: str
        var bCarrierOk: int32 = 0
        baselineCompilerShaInto(Fmt"{baseText}", bCarrier, bCarrierOk)
        if bCarrierOk != 1:
            appendCheck("baseline_schema", "FAIL", "compiler_sha_line_absent")
            return 1
        let sameCarrier = Fmt"{bCarrier}" == Fmt"{compilerSha}"
        appendCheck("baseline_present", "PASS",
                    Fmt"path={baselinePath} compiler_sha_baseline={bCarrier} same_carrier={sameCarrier}")
        passCount = passCount + 1
    # 2) 平铺工作目录 (直接子文件; 不调用 RsiCleanWorkDir, 见卷首)。
    let workDir = Fmt"{root}/src/rsi_sem_work"
    os.MkdirAll(Fmt"{workDir}", 493)
    var parts: str[]
    # 3) 腿 A: 任务域 31 格 (白名单全空间, 分母从 types 派生不硬编码)。
    var min0: int64 = -1
    var min1: int64 = -1
    var min3: int64 = -1
    var cellTotal: int32 = 0
    var cellCorrect: int32 = 0
    for s in 0..<(types.RsiDomain0StrategyMax + 1):
        for p in 0..<(types.RsiDomain0ParamMax + 1):
            var cPass: int32 = 0
            var cFail: int32 = 0
            var cOk: int32 = 0
            var cScore: int64 = 0
            taskCellRun(recordMode, Fmt"{baseText}", Fmt"{compilerPath}",
                        Fmt"{root}", Fmt"{workDir}", env, 0, s, p,
                        compileTimeoutSec, runTimeoutSec, Fmt"{cacheDir}",
                        Fmt"{cacheKey}", parts, cPass, cFail,
                        cOk, cScore)
            passCount = passCount + cPass
            failCount = failCount + cFail
            cellTotal = cellTotal + 1
            if cOk == 1:
                cellCorrect = cellCorrect + 1
                if min0 < 0 || cScore < min0:
                    min0 = cScore
    for s in 0..<(types.RsiDomain1StrategyMax + 1):
        var cPass: int32 = 0
        var cFail: int32 = 0
        var cOk: int32 = 0
        var cScore: int64 = 0
        taskCellRun(recordMode, Fmt"{baseText}", Fmt"{compilerPath}",
                    Fmt"{root}", Fmt"{workDir}", env, 1, s, 0,
                    compileTimeoutSec, runTimeoutSec, Fmt"{cacheDir}",
                    Fmt"{cacheKey}", parts, cPass, cFail, cOk,
                    cScore)
        passCount = passCount + cPass
        failCount = failCount + cFail
        cellTotal = cellTotal + 1
        if cOk == 1:
            cellCorrect = cellCorrect + 1
            if min1 < 0 || cScore < min1:
                min1 = cScore
    for s in 0..<(types.RsiDomain3StrategyMax + 1):
        var cPass: int32 = 0
        var cFail: int32 = 0
        var cOk: int32 = 0
        var cScore: int64 = 0
        taskCellRun(recordMode, Fmt"{baseText}", Fmt"{compilerPath}",
                    Fmt"{root}", Fmt"{workDir}", env,
                    types.RsiTaskDomainGcd, s, 0, compileTimeoutSec,
                    runTimeoutSec, Fmt"{cacheDir}", Fmt"{cacheKey}",
                    parts, cPass, cFail, cOk, cScore)
        passCount = passCount + cPass
        failCount = failCount + cFail
        cellTotal = cellTotal + 1
        if cOk == 1:
            cellCorrect = cellCorrect + 1
            if min3 < 0 || cScore < min3:
                min3 = cScore
    var spaceTotal: int32 = 0
    spaceTotal = spaceTotal + types.RsiTaskDomainCellCount(0)
    spaceTotal = spaceTotal + types.RsiTaskDomainCellCount(1)
    spaceTotal = spaceTotal + types.RsiTaskDomainCellCount(types.RsiTaskDomainGcd)
    let cellTotalText = strings.IntToStr(cellTotal)
    let cellCorrectText = strings.IntToStr(cellCorrect)
    let spaceTotalText = strings.IntToStr(spaceTotal)
    if cellTotal != spaceTotal:
        appendCheck("task_space_enumerated", "FAIL",
                    Fmt"enumerated={cellTotalText}/{spaceTotalText} (白名单与枚举漂移)")
        failCount = failCount + 1
    else:
        appendCheck("task_space_enumerated", "PASS",
                    Fmt"enumerated={cellTotalText}/{spaceTotalText}")
        passCount = passCount + 1
    if cellCorrect != spaceTotal:
        appendCheck("task_space_correct", "FAIL",
                    Fmt"correct={cellCorrectText}/{spaceTotalText} (EXHAUSTED 不成立)")
        failCount = failCount + 1
    else:
        appendCheck("task_space_correct", "PASS",
                    Fmt"correct={cellCorrectText}/{spaceTotalText}")
        passCount = passCount + 1
    var bestCorrect: int64 = -1
    if min0 < 0 || min1 < 0 || min3 < 0:
        appendCheck("task_best_correct", "FAIL",
                    "domain_min_missing (某域无 correct 观测)")
        failCount = failCount + 1
    else:
        bestCorrect = min0 + min1 + min3
        let bestText = strings.Int64ToStr(bestCorrect)
        appendCheck("task_best_correct", "PASS",
                    Fmt"best_correct_aggregate={bestText} d0={min0} d1={min1} d3={min3}")
        passCount = passCount + 1
    # 4) 腿 B1: B4 四夹具 (原始字节 -> 平铺暂编)。
    var fPass: int32 = 0
    var fFail: int32 = 0
    corpusFileRun(recordMode, anchorRcOnly, Fmt"{baseText}",
                  Fmt"{compilerPath}",
                  Fmt"{root}", Fmt"{workDir}", Fmt"{fixturesDir}", env,
                  "fixture_ordinary", "ordinary_zero_exit_fixture.cheng",
                  compileTimeoutSec, runTimeoutSec, Fmt"{cacheDir}",
                  Fmt"{cacheKey}", parts, fPass, fFail)
    corpusFileRun(recordMode, anchorRcOnly, Fmt"{baseText}",
                  Fmt"{compilerPath}",
                  Fmt"{root}", Fmt"{workDir}", Fmt"{fixturesDir}", env,
                  "fixture_call_fixture", "call_fixture.cheng",
                  compileTimeoutSec, runTimeoutSec, Fmt"{cacheDir}",
                  Fmt"{cacheKey}", parts, fPass, fFail)
    corpusFileRun(recordMode, anchorRcOnly, Fmt"{baseText}",
                  Fmt"{compilerPath}",
                  Fmt"{root}", Fmt"{workDir}", Fmt"{fixturesDir}", env,
                  "fixture_cold_nested",
                  "cold_nested_fmt_interpolation_smoke.cheng",
                  compileTimeoutSec, runTimeoutSec, Fmt"{cacheDir}",
                  Fmt"{cacheKey}", parts, fPass, fFail)
    corpusFileRun(recordMode, anchorRcOnly, Fmt"{baseText}",
                  Fmt"{compilerPath}",
                  Fmt"{root}", Fmt"{workDir}", Fmt"{fixturesDir}", env,
                  "fixture_v6", "v6_direct1_repro.cheng",
                  compileTimeoutSec, runTimeoutSec, Fmt"{cacheDir}",
                  Fmt"{cacheKey}", parts, fPass, fFail)
    passCount = passCount + fPass
    failCount = failCount + fFail
    # 5) 腿 B2: 2 源对 (import 路径固定 cheng/tests/..., 按 B4 原始路径落 src/tests)。
    let pairLibPath = Fmt"{root}/src/tests/ug_s1a_ms_lib.cheng"
    let pairMainPath = Fmt"{root}/src/tests/ug_s1a_ms_main.cheng"
    let closurePath = Fmt"{root}/src/tests/ug_s1a_multisource.cheng"
    let pairLibText = inlinePairLibText()
    let pairMainText = inlinePairMainText()
    let closureText = inlineClosureText()
    # 三条 B4 源的目标路径属共享命名空间 (src/tests): 已存在 => 硬拒不猜归属
    # (不覆盖、不删他线文件); 只有本轮真实写入过才在收尾回收。
    var sharedOccupied: int32 = 0
    if os.FileExists(Fmt"{pairLibPath}") || os.FileExists(Fmt"{pairMainPath}") || os.FileExists(Fmt"{closurePath}"):
        sharedOccupied = 1
    var pairPass: int32 = 0
    var pairFail: int32 = 0
    var c8Pass: int32 = 0
    var c8Fail: int32 = 0
    if sharedOccupied == 1:
        appendCheck("pair2_ms", "FAIL",
                    "shared_stage_path_occupied (src/tests/ug_s1a_* 已存在, 拒绝覆盖)")
        appendCheck("closure8_multisource", "FAIL",
                    "shared_stage_path_occupied (src/tests/ug_s1a_* 已存在, 拒绝覆盖)")
        pairFail = pairFail + 1
        c8Fail = c8Fail + 1
    else:
        var p1Ok: int32 = 0
        var p1Why: str
        var p2Ok: int32 = 0
        var p2Why: str
        var c8Ok: int32 = 0
        var c8Why: str
        stageSourceInto(Fmt"{pairLibPath}", Fmt"{pairLibText}", p1Ok, p1Why)
        stageSourceInto(Fmt"{pairMainPath}", Fmt"{pairMainText}", p2Ok, p2Why)
        stageSourceInto(Fmt"{closurePath}", Fmt"{closureText}", c8Ok, c8Why)
        if p1Ok != 1 || p2Ok != 1:
            appendCheck("pair2_ms", "FAIL",
                        Fmt"stage_failed lib={p1Why} main={p2Why}")
            pairFail = pairFail + 1
        else:
            let pairSha = textSha256(Fmt"{pairMainText}")
            corpusEntryRun(recordMode, anchorRcOnly, Fmt"{baseText}",
                           Fmt"{compilerPath}",
                           Fmt"{root}", "pair2_ms", Fmt"{pairMainPath}",
                           Fmt"{workDir}/sem_pair2_ms.bin", Fmt"{pairSha}",
                           env, compileTimeoutSec, runTimeoutSec,
                           Fmt"{cacheDir}", Fmt"{cacheKey}", parts,
                           pairPass, pairFail)
        if c8Ok != 1:
            appendCheck("closure8_multisource", "FAIL",
                        Fmt"stage_failed why={c8Why}")
            c8Fail = c8Fail + 1
        else:
            let closureSha = textSha256(Fmt"{closureText}")
            corpusEntryRun(recordMode, anchorRcOnly, Fmt"{baseText}",
                           Fmt"{compilerPath}",
                           Fmt"{root}", "closure8_multisource",
                           Fmt"{closurePath}",
                           Fmt"{workDir}/sem_closure8_multisource.bin",
                           Fmt"{closureSha}", env, compileTimeoutSec,
                           runTimeoutSec, Fmt"{cacheDir}", Fmt"{cacheKey}",
                           parts, c8Pass, c8Fail)
    passCount = passCount + pairPass
    failCount = failCount + pairFail
    passCount = passCount + c8Pass
    failCount = failCount + c8Fail
    # 7) 腿 C: 编译器域 C1/C2 语料档 0 (开放门从 types 派生; 关档 => 硬失败)。
    if !types.RsiCompilerCorpusOpen(0):
        appendCheck("corpus0_minimal_smoke", "FAIL",
                    "corpus tier 0 closed (判据缺失, 不折算)")
        failCount = failCount + 1
    else:
        let corpusRel = Fmt"{types.RsiCompilerCorpusRel(0)}"
        let corpusPath = Fmt"{root}/{corpusRel}"
        if !os.FileExists(Fmt"{corpusPath}"):
            appendCheck("corpus0_minimal_smoke", "FAIL",
                        Fmt"corpus_source_missing path={corpusPath}")
            failCount = failCount + 1
        else:
            let corpusText = os.ReadFile(Fmt"{corpusPath}")
            let corpusSha = textSha256(Fmt"{corpusText}")
            var c0Pass: int32 = 0
            var c0Fail: int32 = 0
            corpusEntryRun(recordMode, anchorRcOnly, Fmt"{baseText}",
                           Fmt"{compilerPath}",
                           Fmt"{root}", "corpus0_minimal_smoke",
                           Fmt"{corpusPath}",
                           Fmt"{workDir}/sem_corpus0_minimal_smoke.bin",
                           Fmt"{corpusSha}", env, compileTimeoutSec,
                           runTimeoutSec, Fmt"{cacheDir}", Fmt"{cacheKey}",
                           parts, c0Pass, c0Fail)
            passCount = passCount + c0Pass
            failCount = failCount + c0Fail
    # 8) incumbent 腿: 账本在位聚合分 <= 本门实测重算 best_correct。
    var vOk: int32 = 0
    var vGen: int32 = 0
    var vA: int32 = 0
    var vP: int32 = 0
    var vM: int32 = 0
    var vScore: int64 = 0
    var vRoot: str
    store.RsiStoreLoadVersionInto(Fmt"{ledgerDir}", vOk, vGen, vA, vP, vM,
                                  vScore, vRoot)
    if vOk != 1:
        appendCheck("ledger_incumbent", "FAIL",
                    Fmt"ledger_unreadable dir={ledgerDir}")
        failCount = failCount + 1
    else:
        let vScoreText = strings.Int64ToStr(vScore)
        let bestText = strings.Int64ToStr(bestCorrect)
        let equalsBest = vScore == bestCorrect
        let ledgerAttr = ledgerAttribution(vOk, vScore, bestCorrect)
        if ledgerAttr == "pass":
            appendCheck("ledger_incumbent", "PASS",
                        Fmt"incumbent={vScoreText} oracle_best_correct={bestText} equals_best={equalsBest} gen={vGen}")
            passCount = passCount + 1
        elif ledgerAttr == "oracle_best_correct_missing":
            appendCheck("ledger_incumbent", "FAIL",
                        Fmt"oracle_best_correct_missing incumbent={vScoreText} oracle_best_correct={bestText} gen={vGen} (某域无 correct 观测, 非越界)")
            failCount = failCount + 1
        else:
            appendCheck("ledger_incumbent", "FAIL",
                        Fmt"incumbent_over_oracle_best_correct incumbent={vScoreText} oracle_best_correct={bestText} gen={vGen}")
            failCount = failCount + 1
    # 10) 自清场: 本工具临时件共用一个平铺前缀 sem_ (编译器 sidecar 名不逐一枚举:
    # 实测产出 .map/.primary.o.map/.provider*.map/.link.log); 按前缀删除后回查
    # 残留=0 —— 不信任删除返回值, 也不调用会整目录清空、可能删他线夹具的
    # RsiCleanWorkDir。三条共享路径仅在"本轮真实写入过"时回收。
    let beforeClean = os.ListDir(Fmt"{workDir}")
    for i in 0..<beforeClean.len:
        # 不得把 Fmt 字面量嵌进插值 (2026-09-13 实测判词 'unterminated Fmt interpolation':
        # 编译器的 Fmt 扫描在第一个未转义 " 处截断, 不按花括号配平) ⇒ 先物化再取文件名。
        let beforeEntry = Fmt"{beforeClean[i]}"
        let fname = Fmt"{os.ExtractFilename(beforeEntry)}"
        if isSemTempName(Fmt"{fname}") == 1:
            let _removed = os.RemoveFile(Fmt"{workDir}/{fname}")
    if sharedOccupied == 0:
        let _rmLib = os.RemoveFile(Fmt"{pairLibPath}")
        let _rmMain = os.RemoveFile(Fmt"{pairMainPath}")
        let _rmClosure = os.RemoveFile(Fmt"{closurePath}")
    var leftover: int32 = 0
    let after = os.ListDir(Fmt"{workDir}")
    for i in 0..<after.len:
        let afterEntry = Fmt"{after[i]}"
        let fname2 = Fmt"{os.ExtractFilename(afterEntry)}"
        if isSemTempName(Fmt"{fname2}") == 1:
            appendCheck("workdir_leftover", "FAIL",
                        Fmt"residual={fname2} dir={workDir}")
            leftover = leftover + 1
    var sharedLeftover: int32 = 0
    if sharedOccupied == 0:
        if os.FileExists(Fmt"{pairLibPath}"):
            sharedLeftover = 1
        if os.FileExists(Fmt"{pairMainPath}"):
            sharedLeftover = 1
        if os.FileExists(Fmt"{closurePath}"):
            sharedLeftover = 1
    if sharedLeftover == 1:
        appendCheck("workdir_leftover", "FAIL",
                    "src/tests 下的 B4 两条语料源未回收")
        leftover = leftover + 1
    if leftover != 0:
        failCount = failCount + 1
    else:
        appendCheck("workdir_clean", "PASS",
                    Fmt"dir={workDir} residue=0")
        passCount = passCount + 1
    # 9) 基线落盘 (record): 只允许在无失败时写 (基线不得含坏读数); 2026-09-15 修残余②:
    # 本段原在清场判据之前 => 清场失败时 rc=1 但基线已被更新; 现移到清场之后, 残留=0
    # 才允许落盘 (写盘后回读逐字节相等仍在 writeBaselineVerify 内)。
    if recordMode:
        if failCount > 0:
            appendCheck("baseline_write", "FAIL",
                        "record_refused fail_count>0 (拒绝写含坏读数的基线)")
            failCount = failCount + 1
        else:
            var all: str[]
            add(all, "# cheng.rsi.semantic_regression.v1")
            add(all, "# 唯一语义锚 = 产物真实运行 (rc, stdout sha256) = fp 字段;")
            add(all, "# 产物字节 sha 不可用 (Mach-O 每进程随机 uuid), map sha 仅记账。")
            add(all, Fmt"compiler_sha {compilerSha}")
            for i in 0..<parts.len:
                add(all, Fmt"{parts[i]}")
            let baseOut = strutil.Join(all, "\n")
            if writeBaselineVerify(Fmt"{baselinePath}", Fmt"{baseOut}"):
                appendCheck("baseline_write", "PASS",
                            Fmt"path={baselinePath} entries={cellTotalText}")
                passCount = passCount + 1
            else:
                appendCheck("baseline_write", "FAIL",
                            Fmt"write_or_readback_failed path={baselinePath}")
                failCount = failCount + 1
    # 11) 总判词。
    let passCountText = strings.IntToStr(passCount)
    let failCountText = strings.IntToStr(failCount)
    let bestFinalText = strings.Int64ToStr(bestCorrect)
    echo(Fmt"cheng.rsi.semantic.v1 checks_pass={passCountText} checks_fail={failCountText} entries={cellTotalText}+7 covered={cellCorrectText}/{spaceTotalText} best_correct={bestFinalText} compiler_sha={compilerSha} mode={recordMode}")
    if failCount > 0:
        echo("rsi_semantic: FAIL SEMANTIC_DIVERGENT_OR_INCOMPLETE (缺项不得折算为通过)")
        return 1
    echo("rsi_semantic: PASS SEMANTIC_EQUIVALENT")
    return 0

# 空选项目志门 (2026-09-15 修 F5): --cache: 传空串会让 cacheFileFor 生成
# /<entry>.obs, 落盘失败且静默。带值选项统一过此门 (去空白后必须非空)。
fn optionValueMissing(value: str): int32 =
    if len(strutil.Strip(Fmt"{value}")) <= 0:
        return 1
    return 0

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc >= 1:
        let first = Fmt"{cmdline.paramStr(1)}"
        if first == "--self-test":
            return selfTest()
    # argc 口径 (2026-09-13 实测钉死): cmdline.paramCount() **含程序名** (index 0),
    # 用户参数从 paramStr(1) 起 (同 src/tools/csg_semantic_coverage.cheng:460 的记载)。
    # 故 3 个位置参数 => argc=4; 选项目志遍历 4..<argc (末位 = argc-1)。
    if argc < 4:
        echo("usage: rsi_semantic_regression <repoRoot> <compilerPath> <baselinePath> [--record] [--anchor:rc_only] [--ledger:<dir>] [--fixtures:<dir>] [--compile-timeout:<sec>] [--run-timeout:<sec>]")
        echo("       [--cache:<dir>] [--cache-key:<opaque>] (缺 --cache-key => 观测缓存禁用)")
        echo("       rsi_semantic_regression --self-test")
        return 2
    let root = Fmt"{cmdline.paramStr(1)}"
    let compilerPath = Fmt"{cmdline.paramStr(2)}"
    let baselinePath = Fmt"{cmdline.paramStr(3)}"
    if strutil.Strip(Fmt"{root}").len <= 0 || strutil.Strip(Fmt"{compilerPath}").len <= 0 || strutil.Strip(Fmt"{baselinePath}").len <= 0:
        echo("rsi_semantic: FAIL empty positional argument")
        return 2
    var recordMode = false
    var anchorRcOnly = false
    var ledgerDir = Fmt"{root}/artifacts/rsi"
    var fixturesDir = Fmt"{root}/docs/campaigns/2026-08-31-kernel-userpath/fixtures"
    var compileTimeoutSec: int32 = 300
    var runTimeoutSec: int32 = 30
    var cacheDir = Fmt"{root}/.rebuild/rsi_semantic_cache"
    var cacheKey = ""
    for i in 4..<argc:
        let item = Fmt"{cmdline.paramStr(i)}"
        if item == "--record":
            recordMode = true
        elif strings.HasPrefix(item, "--ledger:"):
            ledgerDir = strings.CloneStrRange(Fmt"{item}", 9, len(item) - 9)
        elif strings.HasPrefix(item, "--fixtures:"):
            fixturesDir = strings.CloneStrRange(Fmt"{item}", 11, len(item) - 11)
        elif strings.HasPrefix(item, "--compile-timeout:"):
            let ctText = strings.CloneStrRange(Fmt"{item}", 18, len(item) - 18)
            var ctVal: int32 = 0
            var ctOk: int32 = 0
            strictBoundedIntInto(Fmt"{ctText}", 1, 86400, ctVal, ctOk)
            if ctOk != 1:
                echo(Fmt"rsi_semantic: FAIL invalid --compile-timeout (需要 [1,86400] 十进制整数): {item}")
                return 2
            compileTimeoutSec = ctVal
        elif strings.HasPrefix(item, "--run-timeout:"):
            let rtText = strings.CloneStrRange(Fmt"{item}", 14, len(item) - 14)
            var rtVal: int32 = 0
            var rtOk: int32 = 0
            strictBoundedIntInto(Fmt"{rtText}", 1, 86400, rtVal, rtOk)
            if rtOk != 1:
                echo(Fmt"rsi_semantic: FAIL invalid --run-timeout (需要 [1,86400] 十进制整数): {item}")
                return 2
            runTimeoutSec = rtVal
        elif item == "--anchor:rc_only":
            anchorRcOnly = true
        elif strings.HasPrefix(item, "--cache:"):
            cacheDir = strings.CloneStrRange(Fmt"{item}", 8, len(item) - 8)
        elif strings.HasPrefix(item, "--cache-key:"):
            cacheKey = strings.CloneStrRange(Fmt"{item}", 12, len(item) - 12)
        else:
            echo(Fmt"rsi_semantic: FAIL unknown argument {item}")
            return 2
    if optionValueMissing(Fmt"{ledgerDir}") == 1:
        echo("rsi_semantic: FAIL empty option value --ledger:")
        return 2
    if optionValueMissing(Fmt"{fixturesDir}") == 1:
        echo("rsi_semantic: FAIL empty option value --fixtures:")
        return 2
    if optionValueMissing(Fmt"{cacheDir}") == 1:
        echo("rsi_semantic: FAIL empty option value --cache:")
        return 2
    if compileTimeoutSec <= 0 || runTimeoutSec <= 0:
        echo("rsi_semantic: FAIL non-positive timeout")
        return 2
    return semanticMain(Fmt"{root}", Fmt"{compilerPath}", Fmt"{baselinePath}",
                        recordMode, anchorRcOnly, Fmt"{ledgerDir}",
                        Fmt"{fixturesDir}", compileTimeoutSec, runTimeoutSec,
                        Fmt"{cacheDir}", Fmt"{cacheKey}")
