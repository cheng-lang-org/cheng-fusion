# csg_ascent_gate (F): acceptance gate for the edited film. Runs the
# build_ascent entry fresh, then asserts the manifest bindings (shot
# count, frame count, chain CID identical to the climb film manifest),
# per-shot caption pixels on each shot's first frame, and the MP4 stream
# (sample count and duration via ffprobe). Any FAIL exits non-zero.
import std/cmdline
import std/os
import std/strings as strings
import std/strutils as strutil
import std/os_host_process as hostos

const
    AscentGateSchema = "cheng.tools.csg_ascent_gate.v1"
    AscentOutDir = "artifacts/csg_world_video/ascent"

@borrows
fn argValue(args: str[], flag: str): str =
    let prefix = Fmt"--{flag}:"
    var i: int32 = 0
    while i < args.len:
        if strings.HasPrefix(args[i], prefix):
            return strings.CloneStrRange(args[i], prefix.len, args[i].len - prefix.len)
        i = i + 1
    return ""

@borrows
fn appendCheck(name: str, status: str, detail: str) =
    echo(Fmt"check={name} status={status} detail={detail}")

@borrows
fn manifestValue(text: str, key: str): str =
    var i: int32 = 0
    var start: int32 = 0
    while i <= text.len:
        if i == text.len:
            let line = strings.CloneStrRange(text, start, i - start)
            if strings.HasPrefix(line, key + "="):
                return strings.CloneStrRange(line, key.len + 1, line.len - key.len - 1)
            return ""
        if text[i] == char(10):
            let line = strings.CloneStrRange(text, start, i - start)
            if strings.HasPrefix(line, key + "="):
                return strings.CloneStrRange(line, key.len + 1, line.len - key.len - 1)
            start = i + 1
        i = i + 1
    return ""

# count near-white pixels (caption ink) inside a screen region
@borrows
fn countWhiteIn(rgb: uint8[], x0: int32, y0: int32, x1: int32, y1: int32, w: int32): int32 =
    var n: int32 = 0
    var y: int32 = y0
    while y < y1:
        var x: int32 = x0
        while x < x1:
            let idx = y * w + x
            let r: int32 = int32(rgb[idx * 3])
            let g: int32 = int32(rgb[idx * 3 + 1])
            let b: int32 = int32(rgb[idx * 3 + 2])
            if r >= 200:
                if g >= 200:
                    if b >= 200:
                        n = n + 1
            x = x + 1
        y = y + 1
    return n

@borrows
fn loadFramePixels(path: str): uint8[] =
    let ppm: str = os.ReadFile(path)
    var rgb: uint8[]
    setLen(rgb, ppm.len - 16)
    var ci: int32 = 0
    while ci < ppm.len - 16:
        rgb[ci] = uint8(int32(ppm[16 + ci]) & 255)
        ci = ci + 1
    return rgb

fn main(): int32 =
    var args: str[]
    var ai: int32 = 0
    while ai < cmdline.paramCount():
        add(args, cmdline.paramStr(ai))
        ai = ai + 1
    let root = argValue(args, "root")
    let compiler = argValue(args, "compiler")
    let work = argValue(args, "work")
    if root == "" || compiler == "" || work == "":
        echo("usage: csg_ascent_gate --root:<repoRoot> --compiler:<path> --work:<dir>")
        return 2
    os.MkdirAll(work, 493)
    var fails: int32 = 0

    # 1. fresh build + run of the edit entry
    let bin = work + "/ascent_build"
    let res = hostos.ExecFileCapture(compiler,
        ["system-link-exec",
         Fmt"--root:{root}",
         Fmt"--in:{root}/src/apps/build_ascent/main.cheng",
         "--emit:exe",
         "--target:arm64-apple-darwin",
         Fmt"--out:{bin}"],
        [], "", true, 900)
    let crc = os.ExecCmdResultExitCode(res)
    if crc != 0:
        appendCheck("ascent_compile", "FAIL", "compile rc!=0")
        echo(Fmt"{AscentGateSchema} fails=1")
        return 1
    appendCheck("ascent_compile", "PASS", "compiled")
    let runRes = hostos.ExecFileCapture("/bin/sh",
        ["-c", Fmt"cd '{root}' && '{bin}'"],
        [], "", true, 900)
    let rrc = os.ExecCmdResultExitCode(runRes)
    if rrc != 0:
        appendCheck("ascent_run", "FAIL", Fmt"run rc={rrc}")
        fails = fails + 1
    else:
        appendCheck("ascent_run", "PASS", "ran green")

    # 2. manifest truth
    let manText: str = os.ReadFile(root + "/" + AscentOutDir + "/manifest.txt")
    let shots = manifestValue(manText, "shots")
    let frames = manifestValue(manText, "frames")
    let chainCid = manifestValue(manText, "chainCid")
    if shots == "6":
        appendCheck("ascent_shots", "PASS", "6 shots")
    else:
        appendCheck("ascent_shots", "FAIL", Fmt"shots={shots}")
        fails = fails + 1
    if frames == "240":
        appendCheck("ascent_frames", "PASS", "240 frames")
    else:
        appendCheck("ascent_frames", "FAIL", Fmt"frames={frames}")
        fails = fails + 1
    # chain CID binding: the edited film must be the climb world
    let climbMan: str = os.ReadFile(root + "/artifacts/csg_world_video/manifest.txt")
    let climbChain = manifestValue(climbMan, "chainCid")
    if chainCid == climbChain && chainCid.len == 64:
        appendCheck("ascent_chain_binding", "PASS", "chainCid bound to climb world")
    else:
        appendCheck("ascent_chain_binding", "FAIL", "chainCid mismatch")
        fails = fails + 1

    # 3. per-shot caption pixels: check 5 frames into each shot so both
    # the label and an active subtitle window are on screen
    var shotFirst: int32[] = [5, 45, 85, 125, 165, 205]
    var s: int32 = 0
    while s < 6:
        let fIdx = shotFirst[s]
        let path: str = root + "/" + AscentOutDir + "/a_f" + strings.IntToStr(fIdx) + ".ppm"
        let rgb = loadFramePixels(path)
        # label band (top-left) must hold white ink
        let labelPx = countWhiteIn(rgb, 40, 40, 700, 80, 1280)
        # caption band (bottom) must hold caption ink
        let capPx = countWhiteIn(rgb, 200, 600, 1080, 690, 1280)
        if labelPx >= 200:
            if capPx >= 200:
                appendCheck("ascent_shot_overlay", "PASS", Fmt"shot={s} label={labelPx} caption={capPx}")
            else:
                appendCheck("ascent_shot_overlay", "FAIL", Fmt"shot={s} caption missing")
                fails = fails + 1
        else:
            appendCheck("ascent_shot_overlay", "FAIL", Fmt"shot={s} label missing")
            fails = fails + 1
        s = s + 1

    # 4. MP4 stream truth via ffprobe (through PATH)
    let mp4Path = root + "/" + AscentOutDir + "/ascent.mp4"
    let probeRes = hostos.ExecFileCapture("/bin/sh",
        ["-c", Fmt"ffprobe -v error -show_entries stream=codec_name,width,height,nb_frames,duration -of default=noprint_wrappers=1 '{mp4Path}'"],
        [], "", true, 120)
    let probeOut = os.ExecCmdResultOutput(probeRes)
    let probeRc = os.ExecCmdResultExitCode(probeRes)
    if probeRc == 0:
        if strutil.Contains(probeOut, "nb_frames=240") && strutil.Contains(probeOut, "width=1280"):
            appendCheck("ascent_mp4", "PASS", "240 samples 1280x720")
        else:
            appendCheck("ascent_mp4", "FAIL", "stream metadata mismatch")
            fails = fails + 1
    else:
        appendCheck("ascent_mp4", "FAIL", "ffprobe failed")
        fails = fails + 1

    echo(Fmt"{AscentGateSchema} fails={fails}")
    if fails > 0:
        return 1
    echo("PASS csg_ascent_gate")
    return 0
