# csgworld export (G2): turns the verified scenes (climb / walk /
# journey / playground / skeleton) into pure-CSG distribution files. For every
# scene: produce ->
# validate -> facts CID -> Save -> immediate Load-back with the embedded
# CID and the recomputed CID both checked equal (lossless roundtrip) ->
# size + fact-stat report. The .csgworld file is the deliverable: same
# file, same CID, same film — no pixel payload is ever shipped.
import cheng/game/csg/schema
import cheng/game/csg/csgworld
import cheng/game/csg/validation
import cheng/game/csg/producer
import std/os
import std/strings as strings

const
    ExportSchema = "cheng.tools.csgworld_export.v1"
    OutDir = "artifacts/csg_world_video/csgworld"

type
    ExportStats =
        name: str
        bytes: int32
        cid12: str
        partCount: int32
        jointCount: int32
        ropeNodes: int32
        wallCount: int32
        actionCount: int32
        stepCount: int32
        totalTicks: int64

# Export one scene end to end. bytes < 0 marks a hard failure (bad
# validation or a roundtrip CID mismatch); the caller aborts.
@borrows
fn exportScene(sceneName: str, f: schema.CsgWorldFacts): ExportStats =
    var st: ExportStats
    st.name = Fmt"{sceneName}"
    st.bytes = -1
    st.cid12 = ""
    st.totalTicks = f.totalTicks
    # 1. validate: invalid facts never reach the distribution file
    var verdict = validation.CsgValidateFacts(f)
    if verdict.statusCode != validation.CsgValidOk:
        echo(Fmt"FAIL {sceneName} validate status={verdict.statusCode} detail={verdict.detailIndex}")
        return st
    # 2. facts CID
    let cid: str = Fmt"{schema.CsgWorldFactsCid(f)}"
    # 3. save the .csgworld file
    let path: str = Fmt"{OutDir}/{sceneName}.csgworld"
    csgworld.CsgWorldSave(f, cid, path)
    # 4. immediate load-back: embedded CID and recomputed CID must both
    # match the saved facts CID (lossless roundtrip)
    var loaded: schema.CsgWorldFacts
    let loadedCid: str = csgworld.CsgWorldLoad(path, loaded)
    if loadedCid != cid:
        echo(Fmt"FAIL {sceneName} load-back embedded cid mismatch")
        return st
    let recomputed: str = Fmt"{schema.CsgWorldFactsCid(loaded)}"
    if recomputed != cid:
        echo(Fmt"FAIL {sceneName} roundtrip cid drift")
        return st
    # 5. stats
    let text: str = os.ReadFile(path)
    st.bytes = strings.Len(text)
    st.cid12 = strings.CloneStrRange(cid, 0, 12)
    st.partCount = f.partKind.len
    st.jointCount = f.jointA.len
    st.ropeNodes = f.rope.nodeCount
    st.wallCount = f.wallCx.len
    st.actionCount = f.actionKind.len
    st.stepCount = f.stepPart.len
    let tickS: str = strings.Int64ToStr(st.totalTicks)
    echo(Fmt"{st.name} bytes={st.bytes} parts={st.partCount} joints={st.jointCount} ropeNodes={st.ropeNodes} walls={st.wallCount} actions={st.actionCount} steps={st.stepCount} ticks={tickS}")
    return st

fn main(): int32 =
    os.MkdirAll(OutDir, 493)
    var climbFacts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var climbStats = exportScene("climb", climbFacts)
    var walkFacts: schema.CsgWorldFacts = producer.CsgProducerBuildWalkScene()
    var walkStats = exportScene("walk", walkFacts)
    var journeyFacts: schema.CsgWorldFacts = producer.CsgProducerBuildJourneyScene()
    var journeyStats = exportScene("journey", journeyFacts)
    var playgroundFacts: schema.CsgWorldFacts = producer.CsgProducerBuildPlaygroundScene()
    var playgroundStats = exportScene("playground", playgroundFacts)
    var skeletonFacts: schema.CsgWorldFacts = producer.CsgProducerBuildSkeletonScene()
    var skeletonStats = exportScene("skeleton", skeletonFacts)
    # ballbalance: the ball-top stance facts (figure only — the rigid
    # ball is execution-side, see the producer chain-gap note)
    var ballbalanceFacts: schema.CsgWorldFacts = producer.CsgProducerBuildBallBalanceScene()
    var ballbalanceStats = exportScene("ballbalance", ballbalanceFacts)
    # desktopbiped: the 3.5 kg / 0.34 m desktop-biped carrier scene
    var desktopbipedFacts: schema.CsgWorldFacts = producer.CsgProducerBuildDesktopBipedScene()
    var desktopbipedStats = exportScene("desktopbiped", desktopbipedFacts)
    # summary table: one line per scene (name bytes cid12 ticks)
    echo("---- csgworld export summary ----")
    let climbTicks: str = strings.Int64ToStr(climbStats.totalTicks)
    let walkTicks: str = strings.Int64ToStr(walkStats.totalTicks)
    let journeyTicks: str = strings.Int64ToStr(journeyStats.totalTicks)
    let playgroundTicks: str = strings.Int64ToStr(playgroundStats.totalTicks)
    let skeletonTicks: str = strings.Int64ToStr(skeletonStats.totalTicks)
    let ballbalanceTicks: str = strings.Int64ToStr(ballbalanceStats.totalTicks)
    let desktopbipedTicks: str = strings.Int64ToStr(desktopbipedStats.totalTicks)
    echo(Fmt"{climbStats.name} bytes={climbStats.bytes} cid={climbStats.cid12} ticks={climbTicks}")
    echo(Fmt"{walkStats.name} bytes={walkStats.bytes} cid={walkStats.cid12} ticks={walkTicks}")
    echo(Fmt"{journeyStats.name} bytes={journeyStats.bytes} cid={journeyStats.cid12} ticks={journeyTicks}")
    echo(Fmt"{playgroundStats.name} bytes={playgroundStats.bytes} cid={playgroundStats.cid12} ticks={playgroundTicks}")
    echo(Fmt"{skeletonStats.name} bytes={skeletonStats.bytes} cid={skeletonStats.cid12} ticks={skeletonTicks}")
    echo(Fmt"{ballbalanceStats.name} bytes={ballbalanceStats.bytes} cid={ballbalanceStats.cid12} ticks={ballbalanceTicks}")
    echo(Fmt"{desktopbipedStats.name} bytes={desktopbipedStats.bytes} cid={desktopbipedStats.cid12} ticks={desktopbipedTicks}")
    if climbStats.bytes < 0:
        return 1
    if walkStats.bytes < 0:
        return 1
    if journeyStats.bytes < 0:
        return 1
    if playgroundStats.bytes < 0:
        return 1
    if skeletonStats.bytes < 0:
        return 1
    if ballbalanceStats.bytes < 0:
        return 1
    if desktopbipedStats.bytes < 0:
        return 1
    echo("PASS csgworld export")
    return 0
