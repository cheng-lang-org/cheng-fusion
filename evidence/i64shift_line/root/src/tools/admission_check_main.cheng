import cheng/core/lang/parser as parser
import std/cmdline as cmdline
import std/os
import std/strings
import std/strformat

# 批量准入检查器（门禁左移实体）。
#
# 消费 canonical parser 的规范化声明读取入口
# ParserBuildExprCallProfileWithExternalPackageRoots —— 与 driver 编译管线
# （compiler_csg normalized decl read）完全相同的准入语义，使非法形在写作
# 现场秒级暴露，而不是在烤制管线深处数天后爆炸。
#
# 用法:
#   admission_check <workspace-root> <manifest-path> [package-root]
# manifest: 每行一个源文件绝对路径；'#' 开头为注释行，空行跳过。
# 退出码: 0=全部通过  1=存在违规  2=用法错误

fn admissionManifestSplitLines(text: str): str[] =
    var out: str[]
    var start = 0
    let n = len(text)
    for i in 0..n:
        if i == n || text[i] == '\n':
            add(out, strings.CloneStr(strings.SliceBytes(text, start, i - start)))
            start = i + 1
    return out

fn admissionManifestStrip(line: str): str =
    var start = 0
    var stop = len(line)
    while start < stop &&
          (line[start] == ' ' || line[start] == '\r' ||
           line[start] == '\t'):
        start = start + 1
    while stop > start &&
          (line[stop - 1] == ' ' || line[stop - 1] == '\r' ||
           line[stop - 1] == '\t'):
        stop = stop - 1
    return strings.CloneStr(strings.SliceBytes(line, start, stop - start))

fn main(argc: int32, argv: ptr): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    let paramCount = cmdline.ParamCount()
    if paramCount < 2:
        echo("usage: admission_check <workspace-root> <manifest-path> [package-root]")
        return 2
    let workspaceRoot = cmdline.ParamStr(1)
    let manifestPath = cmdline.ParamStr(2)
    let packageRoot = paramCount >= 3 ? cmdline.ParamStr(3) : cmdline.ParamStr(1)
    let manifest = os.ReadFile(manifestPath)
    if manifest.len <= 0:
        echo(Fmt"admission_check: manifest empty or unreadable path={manifestPath}")
        return 2
    var total = 0
    var violations = 0
    var profile: parser.NormalizedExprCallProfile
    let lines = admissionManifestSplitLines(manifest)
    for lineIndex in 0..<lines.len:
        let line = admissionManifestStrip(lines[lineIndex])
        if line.len <= 0 || line[0] == '#':
            continue
        let text = os.ReadFile(line)
        if text.len <= 0:
            echo(Fmt"admission_violation file={line} rule=unreadable_or_empty")
            violations = violations + 1
            total = total + 1
            continue
        total = total + 1
        var err = ""
        let callWorkspaceRoot = strings.CloneStr(workspaceRoot)
        let callPackageRoot = strings.CloneStr(packageRoot)
        let callSourcePath = strings.CloneStr(line)
        let ok = parser.ParserBuildExprCallProfileWithExternalPackageRoots(
            callWorkspaceRoot,
            callPackageRoot,
            [],
            callSourcePath,
            text,
            profile,
            err)
        if !ok:
            violations = violations + 1
            echo(Fmt"admission_violation file={line} err={err}")
    echo(Fmt"admission_check_total={total} violations={violations}")
    if violations > 0:
        return 1
    return 0