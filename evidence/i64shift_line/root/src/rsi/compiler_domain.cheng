# 纯 Cheng RSI 框架: 编译器域 C1/C2 试验线 (批次四)。
# 变更空间 = (jobs 档 0..2 -> BACKEND_JOBS 1/2/4, 语料档索引 0..2;
# 开放门仅档 0, 见 types.RsiCompilerCorpusOpen)。
# 正确性锚 = 语义指纹 (产物真实运行 rc+stdout sha; Mach-O 随机 uuid
# 使产物字节 sha 不可用, map sha 仅记账不作锚; 语义输出变=miscompile)。
# C1 计分 = 编译器自报 exec_phase_total_us (微秒确定性相位; best-of-5
# 容 1 败、至少 3 成取 min; 成功烤语义指纹必须全等; 禁 wall-clock 单次
# 计时作改进证据)。C2 判定 = 三合一 (guard process_tree_enforced_peak_bytes
# (= guard 执行口径 max(resident, footprint); 缺该键不回落 resident) <= 硬门
# (单点派生自 tools/memory_model_limits.sh) 且 <= 回归帽=冻结基线 x 3/2 且
# rc=0) 且逐相读数在位; 回归帽是工作集回归检测, 不是理论
# 边界。峰值取值 = 成功轮 enforced peak 的 max (fail-closed, 不跟 C1 最优
# 轮走; 回执同留 peak_of_min_us_round + resident/footprint 归因副字段),
# 基线标定同口径。基线自身越
# 门 = 病态基线, 判拒收且不得就地重标 (含拒绝写越门新基线); 抬门轮 (env
# 覆写/守卫实测门 != 权威门) 判 diagnostic, 不入任何通过/更优判词。
# 判定单点 = RsiCdC2Verdict/RsiCdMeasurementVerdict。
# 档 3 (234 源全量自烤, 合同 corpus_tier3_contract.md): 尝试 5 / 失败 1 /
# 成功 3; 收尾检查点 = 轮内 CID 全等 (只读载具报告发射的
# source_snapshot_root_cid, 不在 RSI 侧复刻 CID 算法 §1.3) ∧ failCount<=1 ∧
# 逐相账齐全 (同一轮 trace, 按 A3 tools/phase_line_check.py 的 declared 形态
# 落盘, 未钉相标 unpinned); A/B 腿配对硬判据 = 闭包计数相等 (cid 允许不同,
# 逐源差异归因待载具发射逐源清单 §10-1)。
# 独立账本 artifacts/rsi_compiler (schema cheng.rsi.compiler.v1):
# events 哈希链 + facts 图 (csg.rsi.candidate/trial/cversion) +
# budgets.tsv + current.txt。生产谱系互不触碰。
# 冻结合同: docs/campaigns/2026-09-07-pure-cheng-rsi/compiler_domain_c1c2_contract.md。
# C 车头六墙规约全程遵守 (Fmt 外呼/void+Into/数组内联/单次行切分)。
import std/os as os
import std/os_host_process as hostos
import std/strings as strings
import std/strutils as strutil
import cheng/rsi/types as types
import cheng/rsi/proposal as proposal
import cheng/rsi/csg_layer as csg
import cheng/rsi/store as store

const
    RsiCdSchema = "cheng.rsi.compiler.v1"

# 从编译器 report 文本提取 exec_phase_total_us=<int>。
fn cdExtractTotalUsInto(reportText: str, outUs: var int64, outOk: var int32) =
    outOk = 0
    let key = "exec_phase_total_us="
    let n = len(reportText)
    var i: int32 = 0
    var go: int32 = 1
    while go == 1:
        if i + len(key) > n:
            go = 0
        else:
            let seg = strings.CloneStrRange(Fmt"{reportText}", i, len(key))
            if seg == key:
                var j: int32 = i + len(key)
                var digits: str
                while j < n:
                    let ch = reportText[j]
                    if ch >= '0' && ch <= '9':
                        digits = strutil.Join([Fmt"{digits}", strings.IntToStr(int32(ch) - 48)], "")
                        j = j + 1
                    else:
                        j = n
                if len(digits) > 0:
                    outUs = int64(strutil.ParseInt(digits))
                    outOk = 1
                go = 0
            else:
                i = i + 1

# 从 guard report 提取 <key><int> (key 含 '='; 无键/无数字 -> outOk=0)。
# 手工扫描: while+go 标志定位键 (CloneStrRange 等长片段比较), 再扫数字段。
fn cdExtractUintInto(reportText: str, key: str, outVal: var int64,
                     outOk: var int32) =
    outOk = 0
    let n = len(reportText)
    var i: int32 = 0
    var go: int32 = 1
    while go == 1:
        if i + len(key) > n:
            go = 0
        else:
            let seg = strings.CloneStrRange(Fmt"{reportText}", i, len(key))
            if seg == key:
                var j: int32 = i + len(key)
                var digits: str
                while j < n:
                    let ch = reportText[j]
                    if ch >= '0' && ch <= '9':
                        digits = strutil.Join([Fmt"{digits}", strings.IntToStr(int32(ch) - 48)], "")
                        j = j + 1
                    else:
                        j = n
                if len(digits) > 0:
                    outVal = int64(strutil.ParseInt(digits))
                    outOk = 1
                go = 0
            else:
                i = i + 1

# 数逐相读数行: guard phase-trace 行 = <t> TAB <kib> TAB <子进程 stderr 行>,
# 相位行 = 子进程 stderr 的 "phase=" 行。0 行 = 逐相读数缺失 (不得折算)。
fn cdCountPhaseRowsInto(traceText: str, outRows: var int32) =
    outRows = 0
    let lines = strutil.Split(Fmt"{traceText}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if len(line) > 0 && strutil.Contains(line, "phase="):
            outRows = outRows + 1

fn cdFileSha(path: str): str =
    let res = hostos.ExecFileCapture("/usr/bin/shasum",
        ["-a", "256", Fmt"{path}"], [], "", true, 120)
    let outText = os.ExecCmdResultOutput(res)
    let head = strutil.Strip(Fmt"{outText}")
    if len(head) < 64:
        return ""
    return strings.CloneStrRange(head, 0, 64)

# 权威硬门值单点派生 (2026-09-13 用户裁定 ③): 唯一权威件
# <root>/tools/memory_model_limits.sh 的 CHENG_MEMORY_MODEL_LIMIT_BYTES=;
# 本模块不含门值字面量。文件缺失 / 赋值行不唯一 / 非纯数字 -> outOk=0
# 硬失败 (不回落, 不猜默认值)。
fn RsiCdAuthorityLimitInto(root: str, outBytes: var int64, outOk: var int32) =
    outOk = 0
    outBytes = 0
    let key = "CHENG_MEMORY_MODEL_LIMIT_BYTES="
    let text = os.ReadFile(Fmt"{root}/tools/memory_model_limits.sh")
    if len(text) <= 0:
        return
    var hits: int32 = 0
    var acc: int64 = 0
    let lines = strutil.Split(Fmt"{text}", '\n')
    for i in 0..<lines.len:
        let line = strutil.Strip(Fmt"{lines[i]}")
        if !strings.HasPrefix(line, key):
            continue
        hits = hits + 1
        let digits = strings.CloneStrRange(line, len(key), len(line) - len(key))
        if len(digits) <= 0:
            return
        var v: int64 = 0
        for j in 0..<len(digits):
            let ch = digits[j]
            if ch < '0' || ch > '9':
                return
            v = v * 10 + int64(int32(ch) - 48)
        acc = v
    if hits != 1 || acc <= 0:
        return
    outBytes = acc
    outOk = 1

# 权威硬门值派生 (ledger 侧): 从 storeDir 上溯 <=6 级, 首个含
# tools/memory_model_limits.sh 的目录即宿主根; 命中即按 RsiCdAuthorityLimitInto
# 严格解析。找不到 / 解析失败 -> outOk=0 硬失败 (不回落默认值)。
fn RsiCdAuthorityLimitFromLedgerInto(storeDir: str, outBytes: var int64,
                                     outOk: var int32) =
    outOk = 0
    outBytes = 0
    var cursor = strings.CloneStr(Fmt"{storeDir}")
    var depth: int32 = 0
    while depth < 6:
        var cut: int32 = -1
        for i in 0..<len(cursor):
            if cursor[i] == '/':
                cut = i
        if cut <= 0:
            return
        cursor = strings.CloneStrRange(Fmt"{cursor}", 0, cut)
        var bytes: int64 = 0
        var ok: int32 = 0
        RsiCdAuthorityLimitInto(Fmt"{cursor}", bytes, ok)
        if ok == 1:
            outBytes = bytes
            outOk = 1
            return
        depth = depth + 1

# C2 测量准入 (bake 用, 无基线上下文): 门值 provenance / 读数 / 逐相 / 越门
# 四查。返回 reason (调用方不得改写判词):
#   pass | missing_limit_reading | diagnostic_cap_override |
#   missing_peak_reading (无键或值 <= 0) | missing_phase_readings | over_hard_gate
# limitBytes = guard report 实测内存限 (memory_limit_bytes), 不是 argv 自报。
fn RsiCdMeasurementVerdict(peakBytes: int64, peakOk: int32, limitBytes: int64,
                           gateBytes: int64, phaseRows: int32): str =
    if limitBytes <= 0:
        return "missing_limit_reading"
    if limitBytes != gateBytes:
        return "diagnostic_cap_override"
    # ok=1 只证键存在, 不证值可信: 编译进程常驻 0 字节物理上不可能; 值 <= 0
    # 与缺读数同族, 一律 missing_peak_reading (fail-closed, 2026-09-13 裁定②)。
    if peakOk != 1 || peakBytes <= 0:
        return "missing_peak_reading"
    if phaseRows <= 0:
        return "missing_phase_readings"
    if peakBytes > gateBytes:
        return "over_hard_gate"
    return "pass"

# C2 判定单点 (2026-09-13 用户裁定 ①②③): 三合一 (硬门 AND 回归帽 AND rc=0)
# 且逐相读数在位且基线非病态, 全部成立才 pass; 其余一律非 pass, 不得折算。
# 判词优先级固定 (门禁侧不得重排): 抬门/门值读数 -> 缺读数 -> 基线有效性 ->
# 越硬门 -> 越回归帽 -> rc。basePeak 语义 = 冻结基线 (标定轮则为本轮实测,
# 即"待冻结基线自身")。
fn RsiCdC2Verdict(peakBytes: int64, peakOk: int32, limitBytes: int64,
                  gateBytes: int64, basePeak: int64, baseOk: int32,
                  phaseRows: int32, rc: int32): str =
    let measurement = RsiCdMeasurementVerdict(peakBytes, peakOk, limitBytes,
                                              gateBytes, phaseRows)
    if measurement != "pass":
        return Fmt"{measurement}"
    if baseOk != 1:
        return "missing_baseline"
    if basePeak > gateBytes:
        return "pathological_baseline"
    if peakBytes * 2 > basePeak * 3:
        return "over_regression_cap"
    if rc != 0:
        return "bad_rc"
    return "pass"

# diagnostic 判词 (抬门轮): 不得进入任何"通过/更优"判词。
fn RsiCdReasonIsDiagnostic(reason: str): bool =
    if reason == "diagnostic_cap_override":
        return true
    return false

# 烤一次: guard 包裹 + env(jobs/禁缓存) -> 提取 sha/totalUs/peak; C2 三合一
# + 逐相非 pass 即不出回执 (outC2Reject=1, 判词入 stdout, 调用方不得重试)。
fn RsiCdBakeOnceInto(root: str, compilerPath: str, workDir: str, jobsTier: int32,
                  corpusIdx: int32, tag: str, outSha: var str,
                  outTotalUs: var int64, outPeak: var int64,
                  outResidentPeak: var int64, outFootprintPeak: var int64,
                  outC2Reject: var int32, outOk: var int32) =
    outOk = 0
    outC2Reject = 0
    outResidentPeak = 0
    outFootprintPeak = 0
    # C2 硬门单点派生 (权威件 tools/memory_model_limits.sh); 读不到 = 硬失败。
    var gateBytes: int64 = 0
    var gateOk: int32 = 0
    RsiCdAuthorityLimitInto(Fmt"{root}", gateBytes, gateOk)
    if gateOk != 1:
        outC2Reject = 1
        echo(Fmt"cd_c2_reject reason=authority_unreadable tag={tag} authority=tools/memory_model_limits.sh")
        return
    let gateText = strings.Int64ToStr(gateBytes)
    let jobsReal = types.RsiCompilerJobsOf(jobsTier)
    let jobsText = strings.IntToStr(jobsReal)
    let corpusRel = Fmt"{types.RsiCompilerCorpusRel(corpusIdx)}"
    let srcPath = Fmt"{root}/{corpusRel}"
    let binPath = Fmt"{workDir}/cd_{tag}.bin"
    let cReport = Fmt"{workDir}/cd_{tag}.creport.txt"
    let gReport = Fmt"{workDir}/cd_{tag}.greport.txt"
    let gOut = Fmt"{workDir}/cd_{tag}.gout.txt"
    let gErr = Fmt"{workDir}/cd_{tag}.gerr.txt"
    let gPhase = Fmt"{workDir}/cd_{tag}.phase.tsv"
    # tag 名跨进程固定复用 (g00../cand0..), guard 报告/stdout/stderr 走
    # O_EXCL 独占创建, 上一轮残留秒拒 -> 烤制 tag 一次性耗尽。每次烤前
    # 先清同名产物 (尽力删除, 缺文件不算错)。
    let _rmBin = os.RemoveFile(Fmt"{binPath}")
    let _rmCR = os.RemoveFile(Fmt"{cReport}")
    let _rmGR = os.RemoveFile(Fmt"{gReport}")
    let _rmGO = os.RemoveFile(Fmt"{gOut}")
    let _rmGE = os.RemoveFile(Fmt"{gErr}")
    let _rmPH = os.RemoveFile(Fmt"{gPhase}")
    let monitorSha = cdFileSha(Fmt"{root}/tools/beat_c_process_group_guard_runtime.py")
    let _cw = hostos.ExecFileCapture("/bin/chmod",
        ["a-w", Fmt"{root}/tools/beat_c_process_group_guard_runtime.py"],
        [], "", true, 30)
    # 环境单点: 禁缓存四件套恒定; 档 3 追加逐相账仪器 CHENG_CSG_MEM_TRACE=1
    # (合同 §3.2 仪器 = compiler_csg.cheng:1660 的 csg_mem/csg_stage 打点;
    # 无它则相读数恒缺失, 逐相账无从落盘)。只对档 3 追加, 档 0/1/2 环境与
    # 测量口径逐字节不变 (不新增第二套口径, 不动既有基线语义)。
    var envList: str[]
    add(envList, Fmt"BACKEND_JOBS={jobsText}")
    add(envList, "CHENG_ENTRY_CACHE=0")
    add(envList, "CHENG_NO_CACHE=1")
    add(envList, "CHENG_STRICT_NO_CACHE=1")
    # W3 (2026-09-13 T3): 载具 p2m 对象缓存只认 CHENG_DISABLE_COLD_OBJECT_CACHE,
    # 不认上面两个名字; 共享默认根 artifacts/cold_object_cache 上重复编译会撞
    # `cold object cache entry integrity failure` (外来二进制条目被判 integrity
    # die 而非 miss)。测量合同要求无缓存 ⇒ 显式注入缓存认的名字。
    # 根治路径 (待办): ① cold_object_cache_disabled() 纳入 CHENG_NO_CACHE;
    # ③ receipt 对外来条目应判 miss 而非 integrity die。
    add(envList, "CHENG_DISABLE_COLD_OBJECT_CACHE=1")
    add(envList, Fmt"BEAT_C_GUARD_EXPECTED_MONITOR_RUNTIME_SHA256={monitorSha}")
    if corpusIdx == types.RsiCompilerCorpusTier3:
        add(envList, "CHENG_CSG_MEM_TRACE=1")
        # P-a 修复 (2026-09-14, 独立复核 T3 抓出并本席逐字核实): `csg_stage=` 的发射门在
        # src/core/tooling/compiler_csg.cheng:2326-2329 —— `if compilerCsgTraceStderr && …`,
        # 而 compilerCsgTraceStderr 只由 :1657 `CHENG_COMPILER_CSG_STDERR == "1"` 打开。
        # 缺这一条时 RsiCdTier3PhaseScanInto(compiler_domain.cheng:501-545) 的 enter/bind/profiles
        # 恒缺 ⇒ 逐相账恒 missing_phase_reading ⇒ 档 3 的 C2 准入永远进不去(不是墙的问题, 是接线问题)。
        # 只对档 3 追加, 档 0/1/2 环境逐字节不变; 且档 3 现在被 Open(3)=false 挡在门外 ⇒ 对现役判词零影响。
        add(envList, "CHENG_COMPILER_CSG_STDERR=1")
    # A9b 实测更正 (2026-09-13): guard 默认 inherit_scrubbed 模式下任何
    # --target-env 条目被 runtime 判 EINVAL(ERRNO 22)
    # (beat_c_process_group_guard_runtime.py:5585) ⇒ 腿根本起不来, 不是缺读数;
    # 而 --target-env-clear 会切 exact 模式丢掉 PATH/HOME/TMPDIR。
    # 正解 = 父环境注入: 本条与 envList 其余项同路进 guard 的继承环境
    # (scrubbed_target_env 只剔除 BEAT_C_GUARD_*/OLDPWD/PWD/SHLVL/_, 本键保留)。
    add(envList, "CHENG_PROGRESS=1")
    let res = hostos.ExecFileCapture("/bin/bash",
        [Fmt"{root}/tools/beat_c_process_group_guard.sh",
         Fmt"--rss-limit:{gateText}",
         "--timeout:900",
         "--expected-exit-code:0",
         Fmt"--report-out:{gReport}",
         Fmt"--stdout:{gOut}",
         Fmt"--stderr:{gErr}",
         Fmt"--phase-trace:{gPhase}",
         "--",
         Fmt"{compilerPath}",
         "system-link-exec",
         Fmt"--root:{root}",
         Fmt"--in:{srcPath}",
         "--emit:exe",
         "--target:arm64-apple-darwin",
         Fmt"--out:{binPath}",
         Fmt"--report-out:{cReport}"],
        envList,
        "", true, 960)
    let rrc = os.ExecCmdResultExitCode(res)
    if rrc != 0:
        return
    # 语义指纹 = 产物真实运行的 (rc, stdout sha): jobs 只改布局 (map 会
    # 变, 合法), 语义输出变 = miscompile = 正确性锚要抓的。map sha 记
    # findings 不作锚。
    let runRes = hostos.ExecFileCapture(Fmt"{binPath}", [], [], "", true, 60)
    let runRc2 = os.ExecCmdResultExitCode(runRes)
    let runStdout = os.ExecCmdResultOutput(runRes)
    let runSha = strings.Sha256(Fmt"{runStdout}")
    let shaText = strutil.Join([strings.IntToStr(runRc2), Fmt"{runSha}"], ":")
    let cText = os.ReadFile(Fmt"{cReport}")
    var us: int64 = 0
    var usOk: int32 = 0
    cdExtractTotalUsInto(Fmt"{cText}", us, usOk)
    if usOk != 1:
        return
    let gText = os.ReadFile(Fmt"{gReport}")
    var peak: int64 = 0
    var peakOk: int32 = 0
    # C2 判据口径 = guard 执行口径 enforced = max(resident, footprint)
    # (runtime:5426 / 杀进程判定 runtime:6232); 缺该键 => peakOk=0 =>
    # missing_peak_reading, 不回落 resident (fail-closed, 2026-09-13 A5d)。
    cdExtractUintInto(Fmt"{gText}", "process_tree_enforced_peak_bytes=", peak,
                      peakOk)
    # 归因副字段 (只记账, 不参与判定): 用于分辨真增长 vs resident/footprint
    # 相对关系翻转; 缺键记 0 (0 字节物理上不可能, 可判为缺)。
    var resPeak: int64 = 0
    var fpPeak: int64 = 0
    var scratchAttribOk: int32 = 0
    cdExtractUintInto(Fmt"{gText}", "process_tree_resident_peak_bytes=", resPeak,
                      scratchAttribOk)
    cdExtractUintInto(Fmt"{gText}", "process_tree_phys_footprint_peak_bytes=",
                      fpPeak, scratchAttribOk)
    var limit: int64 = 0
    var limitOk: int32 = 0
    cdExtractUintInto(Fmt"{gText}", "memory_limit_bytes=", limit, limitOk)
    var phaseSize: int64 = 0
    var phaseSizeOk: int32 = 0
    cdExtractUintInto(Fmt"{gText}", "phase_trace_size=", phaseSize, phaseSizeOk)
    var phaseRows: int32 = 0
    if phaseSizeOk == 1 && phaseSize > 0:
        var traceText: str
        traceText = os.ReadFile(Fmt"{gPhase}")
        cdCountPhaseRowsInto(Fmt"{traceText}", phaseRows)
    # C2 三合一 + 逐相前置于回执: 非 pass 一律不出回执 (判词入 stdout, 取证)。
    let verdict = RsiCdMeasurementVerdict(peak, peakOk, limit, gateBytes,
                                          phaseRows)
    if verdict != "pass":
        outC2Reject = 1
        echo(Fmt"cd_c2_reject reason={verdict} tag={tag} peak={peak} peak_ok={peakOk} peak_resident={resPeak} peak_footprint={fpPeak} limit={limit} limit_ok={limitOk} gate={gateBytes} phase_rows={phaseRows} rc={rrc}")
        return
    outSha = strings.CloneStr(shaText)
    outTotalUs = us
    outPeak = peak
    outResidentPeak = resPeak
    outFootprintPeak = fpPeak
    outOk = 1

# --- 档 3 (234 源全量自烤) CID 冻结与逐相账 ---
# 合同: docs/campaigns/2026-09-07-pure-cheng-rsi/corpus_tier3_contract.md
#   §1.4 P3/P4/P5 (CID 冻结程序) / §3.2 (逐相账) / §6.2 S4 (收尾检查点)。
# 单一权威不复刻: 模型锚 + 50MB 阈值归 tools/memory_model_limits.sh +
# tools/phase_line_check.py (A3 冻结件, git 可追踪); 本模块只采集读数, 并按
# A3 已冻结的 "declared 相表" 形态落盘 (那是 RSI C2 逐相报告的接口形态);
# 自造第二套列格式被禁止 (融合计划 §四.5)。CID 算法不在此复刻 (合同 §1.3
# 红线): 只读载具报告发射的 source_snapshot_root_cid 字段。

# 64 位小写 hex 形状判定 (CID/载具 sha 形; 只校验形状, 不复算)。
fn cdHex64Ok(text: str): bool =
    if len(text) != 64:
        return false
    for i in 0..<64:
        let ch = text[i]
        if ch >= '0' && ch <= '9':
            continue
        if ch >= 'a' && ch <= 'f':
            continue
        return false
    return true

# 全十进制数字判定 (rss/count 等读数; 空串/含符号一律 false)。
fn cdDigitsOk(text: str): bool =
    if len(text) <= 0:
        return false
    for i in 0..<len(text):
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
    return true

# 提取 <key><token> (token 到空白/换行为止; key 含 '=')。token 起始位必须是
# 文本首或空白 —— 防 csg_mem 行的 forest_arena= 被 arena= 误命中。
# 首个命中即返回; 键缺失 / 空 token -> outOk=0 (fail-closed, 不回落默认值)。
fn cdExtractTokenInto(text: str, key: str, outVal: var str, outOk: var int32) =
    outOk = 0
    let n = len(text)
    var i: int32 = 0
    var go: int32 = 1
    while go == 1:
        if i + len(key) > n:
            go = 0
        else:
            var boundary: int32 = 0
            if i == 0:
                boundary = 1
            else:
                let prev = text[i - 1]
                if prev == ' ' || prev == '\t' || prev == '\n':
                    boundary = 1
            var matched: int32 = 0
            if boundary == 1:
                let seg = strings.CloneStrRange(Fmt"{text}", i, len(key))
                if seg == key:
                    matched = 1
            if matched == 0:
                i = i + 1
            else:
                var j: int32 = i + len(key)
                var token: str
                while j < n:
                    let ch = text[j]
                    if ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r':
                        j = n
                    else:
                        token = strutil.Join([Fmt"{token}", strings.CloneStrRange(Fmt"{text}", j, 1)], "")
                        j = j + 1
                if len(token) > 0:
                    outVal = strings.CloneStr(Fmt"{token}")
                    outOk = 1
                go = 0

# 单行内按 token 提取 <key><十进制> (token 起始位同 cdExtractTokenInto)。
fn cdLineUintInto(line: str, key: str, outVal: var int64, outOk: var int32) =
    outOk = 0
    var token: str
    var tokOk: int32 = 0
    cdExtractTokenInto(Fmt"{line}", Fmt"{key}", token, tokOk)
    if tokOk != 1:
        return
    let digitsOk = cdDigitsOk(Fmt"{token}")
    if !digitsOk:
        return
    outVal = int64(strutil.ParseInt(Fmt"{token}"))
    outOk = 1

# 单行内 token 精确命中 (token 起始位 = 行首/空白), 用于 csg_stage=<名>。
fn cdLineHasToken(line: str, token: str): bool =
    let n = len(line)
    var i: int32 = 0
    var hit: int32 = 0
    while i + len(token) <= n:
        var boundary: int32 = 0
        if i == 0:
            boundary = 1
        else:
            let prev = line[i - 1]
            if prev == ' ' || prev == '\t':
                boundary = 1
        if boundary == 1:
            let seg = strings.CloneStrRange(Fmt"{line}", i, len(token))
            if seg == token:
                hit = 1
                i = n
        if hit == 0:
            i = i + 1
    if hit == 1:
        return true
    return false

# 单行内 tag=<名> 的 <名> (只对 csg_mem 行调用)。
fn cdLineTagInto(line: str, outTag: var str, outOk: var int32) =
    outOk = 0
    var token: str
    var tokOk: int32 = 0
    cdExtractTokenInto(Fmt"{line}", "tag=", token, tokOk)
    if tokOk != 1:
        return
    outTag = strings.CloneStr(Fmt"{token}")
    outOk = 1

# 档 3 逐相读数采集 (合同 §3.2): 单遍扫 guard phase-trace
# (行 = <秒> TAB <KiB> TAB <子进程 stderr 行>; 第三列即 csg 打点原文)。
# 锚名与取值口径对齐 tools/phase_line_check.py 的 PHASES 表 (A3 冻结件):
#   enter / bind / profiles: csg_stage=<名> 的 rss_bytes (同名取最后一条)
#   forest:                  csg_mem tag ∈ {ta_stream} ∪ "forest*" 的 rss 峰值
#   TypeArena:               csg_mem tag=ta_stream 的 arena 峰值
#                            (arena 与 rss 不可互换, A3 明示)
# outMissing 位掩码: bit0 enter, bit1 bind, bit2 profiles, bit3 forest,
# bit4 type_arena。缺任一已钉相 = 读数缺失, 调用方一律拒收 (不得折算)。
fn RsiCdTier3PhaseScanInto(traceText: str, outEnterRss: var int64,
                           outBindRss: var int64, outProfilesRss: var int64,
                           outForestRss: var int64, outTypeArenaBytes: var int64,
                           outMissing: var int32) =
    outEnterRss = 0
    outBindRss = 0
    outProfilesRss = 0
    outForestRss = 0
    outTypeArenaBytes = 0
    outMissing = 0
    var enterSeen: int32 = 0
    var bindSeen: int32 = 0
    var profilesSeen: int32 = 0
    var forestSeen: int32 = 0
    var arenaSeen: int32 = 0
    let lines = strutil.Split(Fmt"{traceText}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if strutil.Contains(line, "\tcsg_stage="):
            if cdLineHasToken(Fmt"{line}", "csg_stage=enter"):
                var vEnter: int64 = 0
                var okEnter: int32 = 0
                cdLineUintInto(Fmt"{line}", "rss_bytes=", vEnter, okEnter)
                if okEnter == 1:
                    outEnterRss = vEnter
                    enterSeen = 1
            if cdLineHasToken(Fmt"{line}", "csg_stage=after_binding_source_texts"):
                var vBind: int64 = 0
                var okBind: int32 = 0
                cdLineUintInto(Fmt"{line}", "rss_bytes=", vBind, okBind)
                if okBind == 1:
                    outBindRss = vBind
                    bindSeen = 1
            if cdLineHasToken(Fmt"{line}", "csg_stage=after_profiles"):
                var vProf: int64 = 0
                var okProf: int32 = 0
                cdLineUintInto(Fmt"{line}", "rss_bytes=", vProf, okProf)
                if okProf == 1:
                    outProfilesRss = vProf
                    profilesSeen = 1
        if strutil.Contains(line, "\tcsg_mem "):
            var tag: str
            var tagOk: int32 = 0
            cdLineTagInto(Fmt"{line}", tag, tagOk)
            if tagOk == 1:
                let tagName = Fmt"{tag}"
                var forestFamily: int32 = 0
                if tagName == "ta_stream":
                    forestFamily = 1
                    var vArena: int64 = 0
                    var okArena: int32 = 0
                    cdLineUintInto(Fmt"{line}", "arena=", vArena, okArena)
                    if okArena == 1 && (arenaSeen == 0 || vArena > outTypeArenaBytes):
                        outTypeArenaBytes = vArena
                        arenaSeen = 1
                else:
                    if strings.HasPrefix(tagName, "forest"):
                        forestFamily = 1
                if forestFamily == 1:
                    var vRss: int64 = 0
                    var okRss: int32 = 0
                    cdLineUintInto(Fmt"{line}", "rss=", vRss, okRss)
                    if okRss == 1 && (forestSeen == 0 || vRss > outForestRss):
                        outForestRss = vRss
                        forestSeen = 1
    if enterSeen != 1:
        outMissing = outMissing + 1
    if bindSeen != 1:
        outMissing = outMissing + 2
    if profilesSeen != 1:
        outMissing = outMissing + 4
    if forestSeen != 1:
        outMissing = outMissing + 8
    if arenaSeen != 1:
        outMissing = outMissing + 16

# 档 3 轮内 CID 实例 (合同 §1.4 P3/P4): 只读载具报告字段, 不复算 CID。
# 同时执行 P3 自洽校验: source_snapshot_count == compile_input_source_file_count
# (同一快照两次发射, cheng_cold.c:75587,75590-75591) —— 不等 = 发射点被改坏
# => outOk=0 (REJECT)。CID 形状必须 64 位小写 hex。
fn RsiCdRoundCidInto(reportPath: str, outCid: var str, outCount: var int64,
                     outOk: var int32) =
    outOk = 0
    outCid = ""
    outCount = 0
    let text = os.ReadFile(Fmt"{reportPath}")
    if len(text) <= 0:
        return
    var cid: str
    var cidOk: int32 = 0
    cdExtractTokenInto(Fmt"{text}", "source_snapshot_root_cid=", cid, cidOk)
    let cidShapeOk = cdHex64Ok(Fmt"{cid}")
    if cidOk != 1 || !cidShapeOk:
        return
    var snapCount: int64 = 0
    var snapOk: int32 = 0
    cdExtractUintInto(Fmt"{text}", "source_snapshot_count=", snapCount, snapOk)
    var inputCount: int64 = 0
    var inputOk: int32 = 0
    cdExtractUintInto(Fmt"{text}", "compile_input_source_file_count=", inputCount,
                      inputOk)
    if snapOk != 1 || inputOk != 1 || snapCount <= 0:
        return
    if snapCount != inputCount:
        return
    outCid = strings.CloneStr(Fmt"{cid}")
    outCount = snapCount
    outOk = 1

# 链接工具 sha (合同 §4 ④ 身份四元组之一): 载具报告
# darwin_system_link_tool_sha256= (64 hex)。缺字段/形状不符 -> outOk=0
# (四元组缺一即降级 diagnostic, 不得编造/回落)。
fn RsiCdLinkToolShaInto(reportPath: str, outSha: var str, outOk: var int32) =
    outOk = 0
    outSha = ""
    let text = os.ReadFile(Fmt"{reportPath}")
    if len(text) <= 0:
        return
    var sha: str
    var shaOk: int32 = 0
    cdExtractTokenInto(Fmt"{text}", "darwin_system_link_tool_sha256=", sha, shaOk)
    let shaShapeOk = cdHex64Ok(Fmt"{sha}")
    if shaOk != 1 || !shaShapeOk:
        return
    outSha = strings.CloneStr(Fmt"{sha}")
    outOk = 1

# 档 3 腿身份 = 载具 sha 前 8 位 + tag: 冻结记录与逐相账按腿隔离, 不互相覆盖。
fn cdLegText(driverSha: str, tagBase: str): str =
    let shapeOk = cdHex64Ok(Fmt"{driverSha}")
    if !shapeOk:
        return ""
    let head = strings.CloneStrRange(Fmt"{driverSha}", 0, 8)
    return strutil.Join([Fmt"{head}", "_", Fmt"{tagBase}"], "")

# 档 3 逐相账落盘路径 (合同 §3.3 同轮 trace / §6.2 S7(c))。
fn RsiCdPhaseLedgerPath(workDir: str, corpusIdx: int32, jobsTier: int32,
                        driverSha: str, tagBase: str): str =
    let leg = cdLegText(Fmt"{driverSha}", Fmt"{tagBase}")
    if len(leg) <= 0:
        return ""
    return Fmt"{workDir}/cd_corpus{corpusIdx}_jobs{jobsTier}_leg{leg}.phases.txt"

# 档 3 腿级 CID 冻结记录路径 (合同 §1.4 P1/P6)。
fn RsiCdFreezePath(workDir: str, corpusIdx: int32, jobsTier: int32,
                   driverSha: str, tagBase: str): str =
    let leg = cdLegText(Fmt"{driverSha}", Fmt"{tagBase}")
    if len(leg) <= 0:
        return ""
    return Fmt"{workDir}/cd_corpus{corpusIdx}_jobs{jobsTier}_leg{leg}.freeze.txt"

# 档 3 身份 payload (合同 §7 身份行, 唯一格式): 首行即 events 追加行本体,
# main.cheng 接线后直接 append, 不另造格式。patch_sha 当前无落点 (合同 §10-8)
# -> 记 unpinned, 不得编造。
fn RsiCdTier3IdentityPayload(driverSha: str, cid: str, count: int64,
                             sourceRoot: str, patchSha: str, linkToolSha: str,
                             guardRuntimeSha: str): str =
    let patchText = if len(patchSha) > 0: Fmt"{patchSha}" else: "unpinned"
    let linkText = if len(linkToolSha) > 0: Fmt"{linkToolSha}" else: "unpinned"
    return strutil.Join(["event=cdomain_tier3_identity",
                         Fmt"driver_sha={driverSha}",
                         Fmt"corpus_cid={cid}",
                         Fmt"corpus_count={count}",
                         Fmt"source_root={sourceRoot}",
                         Fmt"patch_sha={patchText}",
                         Fmt"link_tool_sha={linkText}",
                         Fmt"guard_runtime_sha={guardRuntimeSha}"], " ")

# 档 3 逐相账: 从同一轮的 guard phase-trace 采集 5 个已钉相读数, 按 A3
# declared 形态落盘 (tmp+rename 原子 + 读回校验)。缺任一已钉相 / 门槛口径读不
# 出来 / 权威件不可读 -> 不落盘, outOk=0 (合同 §3.1 缺任一读数 REJECT)。
# 未钉相 (相 3 metadata = 无实测锚且与相 4 合并核账; 相 6 typed facts/Ir =
# 待钉区⑤) 以 # unpinned 行显式标注, 不当 0、不用估计值充数。
# 门槛口径 (融合计划 §6.2 F1: 标签不可信): 只认 guard report 的
# memory_limit_bytes 与权威件 CHENG_MEMORY_MODEL_LIMIT_BYTES 的相等性;
# 不等 = 抬门轮 -> gate=diagnostic (A3 对 diagnostic 一律不判 PASS)。
fn RsiCdTier3PhaseLedgerInto(root: str, workDir: str, corpusIdx: int32,
                             jobsTier: int32, roundTag: str, driverSha: str,
                             tagBase: str, outPath: var str, outOk: var int32) =
    outOk = 0
    outPath = ""
    let path = RsiCdPhaseLedgerPath(Fmt"{workDir}", corpusIdx, jobsTier,
                                    Fmt"{driverSha}", Fmt"{tagBase}")
    if len(path) <= 0:
        echo("cd_tier3_phase_reject reason=driver_sha_not_cid_shaped")
        return
    let leg = cdLegText(Fmt"{driverSha}", Fmt"{tagBase}")
    let tracePath = Fmt"{workDir}/cd_{roundTag}.phase.tsv"
    let traceText = os.ReadFile(Fmt"{tracePath}")
    if len(traceText) <= 0:
        echo(Fmt"cd_tier3_phase_reject reason=missing_phase_trace path={tracePath}")
        return
    var enterRss: int64 = 0
    var bindRss: int64 = 0
    var profilesRss: int64 = 0
    var forestRss: int64 = 0
    var arenaBytes: int64 = 0
    var missing: int32 = 0
    RsiCdTier3PhaseScanInto(Fmt"{traceText}", enterRss, bindRss, profilesRss,
                            forestRss, arenaBytes, missing)
    if missing != 0:
        echo(Fmt"cd_tier3_phase_reject reason=missing_phase_reading missing_mask={missing} trace={tracePath}")
        return
    var gateBytes: int64 = 0
    var gateOk: int32 = 0
    RsiCdAuthorityLimitInto(Fmt"{root}", gateBytes, gateOk)
    if gateOk != 1:
        echo("cd_tier3_phase_reject reason=authority_unreadable authority=tools/memory_model_limits.sh")
        return
    let gText = os.ReadFile(Fmt"{workDir}/cd_{roundTag}.greport.txt")
    if len(gText) <= 0:
        echo(Fmt"cd_tier3_phase_reject reason=missing_guard_report round={roundTag}")
        return
    var limit: int64 = 0
    var limitOk: int32 = 0
    cdExtractUintInto(Fmt"{gText}", "memory_limit_bytes=", limit, limitOk)
    if limitOk != 1 || limit <= 0:
        echo(Fmt"cd_tier3_phase_reject reason=missing_limit_reading round={roundTag}")
        return
    let gateText = if limit == gateBytes: "default" else: "diagnostic"
    var parts: str[]
    add(parts, Fmt"# tier3 phase ledger schema={RsiCdSchema} corpus={corpusIdx} jobs_tier={jobsTier} round={roundTag} leg={leg}")
    add(parts, "# unpinned phase=metadata(corpus phase 3) reason=no_measured_anchor merged_into=forest")
    add(parts, "# unpinned phase=typed_facts_ir(corpus phase 6) reason=待钉区⑤ model_anchor_unpinned")
    add(parts, Fmt"gate={gateText}")
    add(parts, Fmt"phase=enter rss_bytes={enterRss}")
    add(parts, Fmt"phase=bind rss_bytes={bindRss}")
    add(parts, Fmt"phase=profiles rss_bytes={profilesRss}")
    add(parts, Fmt"phase=forest rss_bytes={forestRss}")
    add(parts, Fmt"phase=type_arena arena_bytes={arenaBytes}")
    let text = strutil.Join(parts, "\n")
    let tmpPath = Fmt"{path}.tmp"
    os.WriteFile(Fmt"{tmpPath}", text)
    if os.ReadFile(Fmt"{tmpPath}") != text:
        echo(Fmt"cd_tier3_phase_reject reason=write_readback_mismatch path={tmpPath}")
        return
    let renamed = os.RenameFile(Fmt"{tmpPath}", Fmt"{path}")
    if !renamed:
        echo(Fmt"cd_tier3_phase_reject reason=rename_failed path={path}")
        return
    outPath = strings.CloneStr(Fmt"{path}")
    outOk = 1
    echo(Fmt"cd_tier3_phase_ledger ok=1 path={path} corpus={corpusIdx} jobs_tier={jobsTier} round={roundTag} gate={gateText} enter_rss={enterRss} bind_rss={bindRss} profiles_rss={profilesRss} forest_rss={forestRss} type_arena_bytes={arenaBytes} unpinned=metadata,typed_facts_ir")

# 档 3 腿级冻结落盘: 首行 = 身份 payload (events 行本体), 其余行 = 腿级事实
# (闭包计数 / CID 实例轮数 / 成败轮数)。轮内 CID 全等判据已在
# RsiCdBakePairedInto 内强制执行, 本件是它的锚证据。
fn RsiCdFreezeRecordWrite(workDir: str, corpusIdx: int32, jobsTier: int32,
                          tagBase: str, driverSha: str, cid: str, count: int64,
                          sourceRoot: str, linkToolSha: str, guardRuntimeSha: str,
                          roundsGood: int32, roundsFail: int32, cidRounds: int32,
                          outPath: var str, outOk: var int32) =
    outOk = 0
    outPath = ""
    let cidShapeOk = cdHex64Ok(Fmt"{cid}")
    if !cidShapeOk:
        echo("cd_tier3_freeze_reject reason=cid_not_cid_shaped")
        return
    let path = RsiCdFreezePath(Fmt"{workDir}", corpusIdx, jobsTier,
                               Fmt"{driverSha}", Fmt"{tagBase}")
    if len(path) <= 0:
        echo("cd_tier3_freeze_reject reason=driver_sha_not_cid_shaped")
        return
    var parts: str[]
    add(parts, RsiCdTier3IdentityPayload(Fmt"{driverSha}", Fmt"{cid}", count,
                                         Fmt"{sourceRoot}", "", Fmt"{linkToolSha}",
                                         Fmt"{guardRuntimeSha}"))
    add(parts, Fmt"corpus={corpusIdx}")
    add(parts, Fmt"jobs_tier={jobsTier}")
    add(parts, Fmt"leg={tagBase}")
    add(parts, Fmt"corpus_count={count}")
    add(parts, Fmt"corpus_cid={cid}")
    add(parts, Fmt"rounds_good={roundsGood}")
    add(parts, Fmt"rounds_fail={roundsFail}")
    add(parts, Fmt"cid_rounds={cidRounds}")
    let text = strutil.Join(parts, "\n")
    let tmpPath = Fmt"{path}.tmp"
    os.WriteFile(Fmt"{tmpPath}", text)
    if os.ReadFile(Fmt"{tmpPath}") != text:
        echo(Fmt"cd_tier3_freeze_reject reason=write_readback_mismatch path={tmpPath}")
        return
    let renamed = os.RenameFile(Fmt"{tmpPath}", Fmt"{path}")
    if !renamed:
        echo(Fmt"cd_tier3_freeze_reject reason=rename_failed path={path}")
        return
    outPath = strings.CloneStr(Fmt"{path}")
    outOk = 1
    echo(Fmt"cd_tier3_freeze ok=1 path={path} corpus={corpusIdx} jobs_tier={jobsTier} cid={cid} count={count} rounds_good={roundsGood} rounds_fail={roundsFail} cid_rounds={cidRounds}")

# A/B 腿配对判据 (合同 §1.4 P5): 硬判据 = count_A == count_B (闭包成员数不变;
# 变了 = 本 trial 无效, 须重冻结语料档)。cid_A != cid_B 允许 (内核刀就落在闭包
# 成员上; src=134 typed_expr.cheng, src=61 primary_object_plan.cheng,
# docs/cheng-plan.md:1000), 但差异必须由候选 patch 自身解释; 逐源差异归因需要
# 载具发射逐源清单 —— 当前不发射 (合同 §10-1) => 只记 cid_equal, 不作拒收理由,
# 且不得用 src=N 索引代替路径做归因。腿必须同语料同 jobs 档。
# 判词优先级固定: 缺件 -> 腿不同源 -> 计数不等 -> pass。
fn RsiCdFreezePairVerdictInto(pathA: str, pathB: str, outVerdict: var str,
                              outOk: var int32) =
    outOk = 0
    outVerdict = "missing_record"
    let textA = os.ReadFile(Fmt"{pathA}")
    let textB = os.ReadFile(Fmt"{pathB}")
    if len(textA) <= 0 || len(textB) <= 0:
        outVerdict = "missing_record"
        return
    var corpusA: int64 = 0
    var corpusAOk: int32 = 0
    var corpusB: int64 = 0
    var corpusBOk: int32 = 0
    cdExtractUintInto(Fmt"{textA}", "corpus=", corpusA, corpusAOk)
    cdExtractUintInto(Fmt"{textB}", "corpus=", corpusB, corpusBOk)
    var jobsA: int64 = 0
    var jobsAOk: int32 = 0
    var jobsB: int64 = 0
    var jobsBOk: int32 = 0
    cdExtractUintInto(Fmt"{textA}", "jobs_tier=", jobsA, jobsAOk)
    cdExtractUintInto(Fmt"{textB}", "jobs_tier=", jobsB, jobsBOk)
    if corpusAOk != 1 || corpusBOk != 1 || jobsAOk != 1 || jobsBOk != 1:
        outVerdict = "missing_record"
        return
    if corpusA != corpusB || jobsA != jobsB:
        outVerdict = "corpus_leg_mismatch"
        echo(Fmt"cd_tier3_pair_reject reason=corpus_leg_mismatch corpus_a={corpusA} corpus_b={corpusB} jobs_a={jobsA} jobs_b={jobsB}")
        return
    var countA: int64 = 0
    var countAOk: int32 = 0
    var countB: int64 = 0
    var countBOk: int32 = 0
    cdExtractUintInto(Fmt"{textA}", "corpus_count=", countA, countAOk)
    cdExtractUintInto(Fmt"{textB}", "corpus_count=", countB, countBOk)
    if countAOk != 1 || countBOk != 1:
        outVerdict = "missing_record"
        return
    if countA != countB:
        outVerdict = "count_mismatch"
        echo(Fmt"cd_tier3_pair_reject reason=count_mismatch count_a={countA} count_b={countB} corpus={corpusA}")
        return
    var cidA: str
    var cidAOk: int32 = 0
    var cidB: str
    var cidBOk: int32 = 0
    cdExtractTokenInto(Fmt"{textA}", "corpus_cid=", cidA, cidAOk)
    cdExtractTokenInto(Fmt"{textB}", "corpus_cid=", cidB, cidBOk)
    if cidAOk != 1 || cidBOk != 1:
        outVerdict = "missing_record"
        return
    var cidEqual: int32 = 0
    if cidA == cidB:
        cidEqual = 1
    outVerdict = "pass"
    outOk = 1
    echo(Fmt"cd_tier3_pair ok=1 corpus={corpusA} jobs_tier={jobsA} count={countA} cid_equal={cidEqual} cid_a={cidA} cid_b={cidB}")

# 配对回执: 尝试上限 12 / 成功下限 3 / 失败上限 9 (2026-09-09 引入, 消除
# 负载瞬态红绿交替), 成功轮语义指纹必须全等, total_us 只在成功轮取 min;
# C2 峰值取成功轮 max (fail-closed) 并同时回执两个峰值口径。
# 档 3 (合同 §2.0-1/§6.2 S4): 尝试上限 5 / 失败上限 1 / 成功下限 3; 收尾检查点
# = 轮内 CID 全等 ∧ failCount<=1 ∧ 逐相账齐全 (同一轮 trace, 未钉相标 unpinned),
# 缺任一 -> outOk=0 不出回执。档 0/1/2 口径逐字节不变。
# P-b (T65 裁定落地, 2026-09-16 窗口线): 增 outFreezePath 出参回传冻结记录
# 路径 (仅档 3 收尾检查点产出; 非档 3 恒空串, fail-closed), 调用方不再依赖
# stdout 解析。
fn RsiCdBakePairedInto(root: str, compilerPath: str, workDir: str, jobsTier: int32,
                    corpusIdx: int32, tagBase: str, outSha: var str,
                    outTotalUs: var int64, outPeak: var int64,
                    outOk: var int32, outFreezePath: var str) =
    # total_us 实测双峰 (慢路径 parse 实跑 ~4.2M vs 快路径 parse=0 ~1.6M,
    # 与 jobs 无关) + 偶发整烤缺失; min = 真实可达性能下界。
    # C2 峰值口径: 判据与基线一律取成功轮 enforced peak (= guard 执行口径
    # max(resident, footprint)) 的 max (fail-closed: 不跟 C1 最优轮走 —— 最快
    # 轮未必最占内存, 用它会低报; max 只多拒不假绿); resident/footprint 同轮值
    # 仅作归因副字段。
    # 锚 = 语义指纹 (产物运行 rc+stdout sha) 全等; Mach-O 产物含每进程随机
    # uuid, 产物字节 sha 跨进程漂移不可用; map sha 受 jobs 布局影响 (合法)
    # 仅记账不作锚。
    outOk = 0
    outFreezePath = ""
    # 档 3 冻结口径 (合同 §2.0-1): 尝试 <=5 / 容 1 败 / 成功 >=3; 档 0/1/2 沿用
    # 12/9/3 (A8 用户裁定保留), 两档口径互不影响 (tier3 单点派生自 types)。
    let tier3 = corpusIdx == types.RsiCompilerCorpusTier3
    let maxAttempts = if tier3: 5 else: 12
    let maxFail = if tier3: 1 else: 9
    let driverSha = cdFileSha(Fmt"{compilerPath}")
    var bestUs: int64 = -1
    var bestPk: int64 = 0
    var maxPk: int64 = 0
    # 归因副字段 (只记账, 不参与判定): 峰值轮同轮 resident/footprint, 用于分辨
    # 真增长 vs resident/footprint 相对关系翻转。
    var resOfMax: int64 = 0
    var fpOfMax: int64 = 0
    var firstSha: str
    var goodCount: int32 = 0
    var failCount: int32 = 0
    # 档 3 轮内 CID 实例 (合同 §1.4 P4): 逐成功轮各自记录 cid_k, 全等才出回执;
    # 峰值轮的逐相账归属 tag 同记 (C2 总峰口径 = 成功轮 max, §2.0-2)。
    var cidFirst: str
    var cidCount: int64 = 0
    var cidRounds: int32 = 0
    var peakRoundTag: str
    # 负载容错 (2026-09-09): kernel 会话重载下 guard/编译偶发瞬态失败
    # (实测 2/5 败致配对假失败), 12 尝试集满 3 成即回执; 指纹不一致
    # 仍立即拒 (非瞬态, 语义锚语义不变)。
    for k in 0..<maxAttempts:
        if goodCount == 3:
            return
        var shaK: str
        var usK: int64 = 0
        var pkK: int64 = 0
        var resK: int64 = 0
        var fpK: int64 = 0
        var c2RejectK: int32 = 0
        var okK: int32 = 0
        let tagK = strutil.Join([Fmt"{tagBase}", strings.IntToStr(k)], "")
        RsiCdBakeOnceInto(Fmt"{root}", Fmt"{compilerPath}", Fmt"{workDir}",
                          jobsTier, corpusIdx, Fmt"{tagK}",
                          shaK, usK, pkK, resK, fpK, c2RejectK, okK)
        # C2 判词非 pass = 结构性拒收 (判词已入 stdout), 不重试 —— 重试只会
        # 浪费编译槽位; 只有瞬态 guard/编译失败才计入失败上限。
        if c2RejectK == 1:
            return
        if okK != 1:
            failCount = failCount + 1
            if failCount > maxFail:
                return
        else:
            if goodCount == 0:
                firstSha = strings.CloneStr(Fmt"{shaK}")
            if shaK != firstSha:
                return
            # 档 3 轮内 CID 全等 (合同 §1.4 P4): 只读本轮载具报告字段; cid 不等
            # = 烤制过程中树被并发 lane 改动 => 立即 REJECT(corpus_mutated_
            # mid_trial), 不出回执。CID 算法不在 RSI 侧复刻 (合同 §1.3 红线)。
            if tier3:
                var cidK: str
                var cntK: int64 = 0
                var cidOkK: int32 = 0
                RsiCdRoundCidInto(Fmt"{workDir}/cd_{tagK}.creport.txt", cidK, cntK,
                                  cidOkK)
                if cidOkK != 1:
                    echo(Fmt"cd_tier3_cid_reject reason=missing_or_inconsistent_cid round={tagK} corpus={corpusIdx}")
                    return
                if cidRounds == 0:
                    cidFirst = strings.CloneStr(Fmt"{cidK}")
                    cidCount = cntK
                if cidK != cidFirst:
                    echo(Fmt"cd_tier3_cid_reject reason=corpus_mutated_mid_trial round={tagK} first={cidFirst} round_cid={cidK}")
                    return
                cidRounds = cidRounds + 1
            if bestUs < 0 || usK < bestUs:
                bestUs = usK
                bestPk = pkK
            if pkK > maxPk:
                maxPk = pkK
                resOfMax = resK
                fpOfMax = fpK
                peakRoundTag = strings.CloneStr(Fmt"{tagK}")
            goodCount = goodCount + 1
            if goodCount == 3:
                # 档 3 收尾检查点 (合同 §6.2 S4 三项): ①∀k cid 全等 (cidRounds=3
                # 且逐轮比对已过) ②failCount <= 1 ③逐相账齐全 (峰值轮同一轮
                # trace, 未钉相标 unpinned) + 腿级冻结落盘; 缺任一 -> outOk=0
                # 不出回执。档 0/1/2 不走此块 (口径逐字节不变)。
                if tier3:
                    if cidRounds != 3:
                        echo(Fmt"cd_tier3_checkpoint_reject reason=cid_rounds_incomplete cid_rounds={cidRounds} corpus={corpusIdx}")
                        return
                    if failCount > 1:
                        echo(Fmt"cd_tier3_checkpoint_reject reason=fail_count_over_1 fail_count={failCount} corpus={corpusIdx}")
                        return
                    var ledPath: str
                    var ledOk: int32 = 0
                    RsiCdTier3PhaseLedgerInto(Fmt"{root}", Fmt"{workDir}", corpusIdx,
                                              jobsTier, Fmt"{peakRoundTag}",
                                              Fmt"{driverSha}", Fmt"{tagBase}",
                                              ledPath, ledOk)
                    if ledOk != 1:
                        echo(Fmt"cd_tier3_checkpoint_reject reason=phase_ledger_incomplete corpus={corpusIdx} round={peakRoundTag}")
                        return
                    # 身份四元组 ④ 工具面 (合同 §4): 链接工具 sha 取自载具报告,
                    # guard 运行时 sha 取自在位脚本; 任一取不到 = 四元组缺一 =>
                    # 降级 diagnostic 不入 trial, 故不出回执 (不得编造/回落)。
                    var linkSha: str
                    var linkOk: int32 = 0
                    RsiCdLinkToolShaInto(Fmt"{workDir}/cd_{peakRoundTag}.creport.txt",
                                         linkSha, linkOk)
                    if linkOk != 1:
                        echo(Fmt"cd_tier3_checkpoint_reject reason=link_tool_sha_unavailable round={peakRoundTag}")
                        return
                    let guardSha = cdFileSha(Fmt"{root}/tools/beat_c_process_group_guard_runtime.py")
                    let guardShapeOk = cdHex64Ok(Fmt"{guardSha}")
                    if !guardShapeOk:
                        echo(Fmt"cd_tier3_checkpoint_reject reason=guard_runtime_sha_unavailable path={root}/tools/beat_c_process_group_guard_runtime.py")
                        return
                    var freezePath: str
                    var freezeOk: int32 = 0
                    RsiCdFreezeRecordWrite(Fmt"{workDir}", corpusIdx, jobsTier,
                                           Fmt"{tagBase}", Fmt"{driverSha}",
                                           Fmt"{cidFirst}", cidCount, Fmt"{root}",
                                           Fmt"{linkSha}", Fmt"{guardSha}",
                                           goodCount, failCount, cidRounds,
                                           freezePath, freezeOk)
                    if freezeOk != 1:
                        echo(Fmt"cd_tier3_checkpoint_reject reason=freeze_record_not_landed corpus={corpusIdx} round={peakRoundTag}")
                        return
                    echo(Fmt"cd_tier3_checkpoint ok=1 corpus={corpusIdx} jobs_tier={jobsTier} cid={cidFirst} count={cidCount} cid_rounds={cidRounds} ledger={ledPath} freeze={freezePath}")
                    outFreezePath = strings.CloneStr(Fmt"{freezePath}")
                outSha = strings.CloneStr(firstSha)
                outTotalUs = bestUs
                outPeak = maxPk
                outOk = 1
                echo(Fmt"cd_peak_receipt ok=1 jobs_tier={jobsTier} corpus={corpusIdx} peak_of_min_us_round={bestPk} peak_max_over_successes={maxPk} peak_resident={resOfMax} peak_footprint={fpOfMax} min_us={bestUs} successes={goodCount}")
                return
    if failCount > maxFail || goodCount < 3:
        return
    outSha = strings.CloneStr(firstSha)
    outTotalUs = bestUs
    outPeak = maxPk
    outOk = 1
    echo(Fmt"cd_peak_receipt ok=1 jobs_tier={jobsTier} corpus={corpusIdx} peak_of_min_us_round={bestPk} peak_max_over_successes={maxPk} peak_resident={resOfMax} peak_footprint={fpOfMax} min_us={bestUs} successes={goodCount}")

# 编译器域版本事实: 键序字母升序 (best_us,change,corpus,id,jobs_tier,kind,
# parent_facts_root,score)。
fn RsiCdVersionFact(gen: int32, jobsTier: int32, corpusIdx: int32,
                    bestUs: int64, parentRoot: str): str =
    let g = strings.IntToStr(gen)
    let j = strings.IntToStr(jobsTier)
    let c = strings.IntToStr(corpusIdx)
    let b = strings.Int64ToStr(bestUs)
    return strutil.Join(["{\"best_us\":\"", Fmt"{b}",
                         "\",\"change\":\"a\",\"corpus\":\"", Fmt"{c}",
                         "\",\"id\":\"cversion:", Fmt"{g}",
                         "\",\"jobs_tier\":\"", Fmt"{j}",
                         "\",\"kind\":\"csg.rsi.cversion\",\"parent_facts_root\":\"",
                         Fmt"{parentRoot}", "\",\"score\":\"", Fmt"{b}",
                         "\"}"], "")

# C2 内存账 (2026-09-13 口径): 每 (语料档) 一个冻结 peak 基线, 回归帽 =
# 基线 x 3/2 (工作集回归检测, 不是理论边界); 判据 = 硬门 AND 回归帽 AND
# rc=0 AND 逐相读数在位 (RsiCdC2Verdict 单点判词)。基线值与判据同口径 =
# 成功轮 enforced peak (= max(resident, footprint)) 的 max (RsiCdBakePairedInto,
# fail-closed)。预算表持久 budgets.tsv
# (行式 corpus/peak), 创世与每次 accepted 时按实测刷新 (越门/病态一律拒写,
# 不得把越界状态合法化); 超帽产出四元组 (corpus, budget, actual, ratio) 入
# events。逐相读数 = guard --phase-trace (子进程 stderr 的 phase= 行);
# 未钉模型项须显式标注"未钉", 不得当 0 或用估计值充数。
fn RsiCdBudgetPath(storeDir: str): str =
    return strutil.Join([Fmt"{storeDir}", "budgets.tsv"], "/")

# 读某语料档冻结基线 (无记录返回 -1)。
fn RsiCdBudgetLoadInto(storeDir: str, corpusIdx: int32,
                       outPeak: var int64, outOk: var int32) =
    outOk = 0
    outPeak = -1
    let path = RsiCdBudgetPath(storeDir)
    let text = os.ReadFile(Fmt"{path}")
    if len(text) <= 0:
        return
    let prefix = Fmt"corpus {corpusIdx} peak "
    let lines = strutil.Split(Fmt"{text}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if strings.HasPrefix(line, prefix):
            let digits = strings.CloneStrRange(line, len(prefix),
                                               len(line) - len(prefix))
            if len(digits) > 0:
                outPeak = int64(strutil.ParseInt(digits))
                outOk = 1
            return

# 写/刷新某语料档基线 (tmp+rename 原子; 其余行保留)。
# 2026-09-13 裁定 ②: 门值从权威件单点派生; 新基线越硬门 = 拒写; 既有基线
# 自身越门 = 病态基线, 拒绝就地重标 (返回 false = 硬失败, 一行都不写)。
fn RsiCdBudgetStore(storeDir: str, corpusIdx: int32, peak: int64): bool =
    var gateBytes: int64 = 0
    var gateOk: int32 = 0
    RsiCdAuthorityLimitFromLedgerInto(Fmt"{storeDir}", gateBytes, gateOk)
    if gateOk != 1:
        echo(Fmt"cd_baseline_reject reason=authority_unresolved corpus={corpusIdx} peak={peak} store={storeDir}")
        return false
    if peak > gateBytes:
        echo(Fmt"cd_baseline_reject reason=over_hard_gate corpus={corpusIdx} peak={peak} gate={gateBytes}")
        return false
    var prior: int64 = -1
    var priorOk: int32 = 0
    RsiCdBudgetLoadInto(Fmt"{storeDir}", corpusIdx, prior, priorOk)
    if priorOk == 1 && prior > gateBytes:
        echo(Fmt"cd_baseline_reject reason=pathological_baseline corpus={corpusIdx} prior={prior} gate={gateBytes}")
        return false
    let path = RsiCdBudgetPath(storeDir)
    let text = os.ReadFile(Fmt"{path}")
    let keepLine = Fmt"corpus {corpusIdx} peak {peak}"
    var kept: str[]
    if len(text) > 0:
        let lines = strutil.Split(Fmt"{text}", '\n')
        for i in 0..<lines.len:
            let line = Fmt"{lines[i]}"
            if len(strutil.Strip(line)) <= 0:
                continue
            let linePrefix = Fmt"corpus {corpusIdx} peak "
            if strings.HasPrefix(line, linePrefix):
                continue
            add(kept, Fmt"{line}")
    var parts: str[]
    var inserted: int32 = 0
    for i in 0..<kept.len:
        if inserted == 0:
            add(parts, Fmt"{keepLine}")
            inserted = 1
        add(parts, Fmt"{kept[i]}")
    if inserted == 0:
        add(parts, Fmt"{keepLine}")
    let next = strutil.Join(parts, "\n")
    let tmpPath = Fmt"{path}.tmp"
    os.WriteFile(Fmt"{tmpPath}", next)
    if os.ReadFile(Fmt"{tmpPath}") != next:
        return false
    return os.RenameFile(Fmt"{tmpPath}", Fmt"{path}")

# 读 current (行式, 手工扫描 key)。
fn RsiCdLoadInto(storeDir: str, ok: var int32, gen: var int32,
                 jobsTier: var int32, corpusIdx: var int32,
                 bestUs: var int64, productSha: var str,
                 factsRoot: var str) =
    ok = 0
    gen = 0
    jobsTier = 0
    corpusIdx = 0
    bestUs = 0
    productSha = ""
    factsRoot = ""
    let path = Fmt"{storeDir}/current.txt"
    let text = os.ReadFile(Fmt"{path}")
    if len(text) <= 0:
        return
    var seen: int32 = 0
    let lines = strutil.Split(Fmt"{text}", '\n')
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        if strings.HasPrefix(line, "schema "):
            let v = strings.CloneStrRange(line, 7, len(line) - 7)
            if v != RsiCdSchema:
                return
            seen = seen + 1
        if strings.HasPrefix(line, "generation "):
            gen = strutil.ParseInt(strings.CloneStrRange(line, 11, len(line) - 11))
            seen = seen + 1
        if strings.HasPrefix(line, "jobs_tier "):
            jobsTier = strutil.ParseInt(strings.CloneStrRange(line, 10, len(line) - 10))
            seen = seen + 1
        if strings.HasPrefix(line, "corpus "):
            corpusIdx = strutil.ParseInt(strings.CloneStrRange(line, 7, len(line) - 7))
            seen = seen + 1
        if strings.HasPrefix(line, "best_us "):
            bestUs = int64(strutil.ParseInt(strings.CloneStrRange(line, 8, len(line) - 8)))
            seen = seen + 1
        if strings.HasPrefix(line, "product_sha "):
            productSha = strings.CloneStrRange(line, 12, len(line) - 12)
            seen = seen + 1
        if strings.HasPrefix(line, "facts_root "):
            factsRoot = strings.CloneStrRange(line, 11, len(line) - 11)
            seen = seen + 1
    if seen != 7:
        ok = 0
        return
    ok = 1

fn RsiCdCommit(storeDir: str, gen: int32, jobsTier: int32, corpusIdx: int32,
               bestUs: int64, productSha: str, factsRoot: str): bool =
    let finalPath = Fmt"{storeDir}/current.txt"
    let tmpPath = Fmt"{storeDir}/current.txt.tmp"
    var parts: str[]
    add(parts, Fmt"schema {RsiCdSchema}")
    add(parts, Fmt"generation {gen}")
    add(parts, Fmt"jobs_tier {jobsTier}")
    add(parts, Fmt"corpus {corpusIdx}")
    add(parts, Fmt"best_us {bestUs}")
    add(parts, Fmt"product_sha {productSha}")
    add(parts, Fmt"facts_root {factsRoot}")
    let text = strutil.Join(parts, "\n")
    os.WriteFile(Fmt"{tmpPath}", text)
    if os.ReadFile(Fmt"{tmpPath}") != text:
        return false
    return os.RenameFile(Fmt"{tmpPath}", Fmt"{finalPath}")
