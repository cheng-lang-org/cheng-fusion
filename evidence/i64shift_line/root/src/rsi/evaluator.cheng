# 纯 Cheng RSI 框架: 独立评价器 (提案第5步)。
# 评价权归控制器: 候选只交答案行, 正确性与分数全部由本模块对照金标重算;
# 候选自报的任何 pass/fail 一律不采信。分数 = compares 计数, 越小越好,
# 提升必须严格不等 (平分不推进), 时间类观测不作为能力证据。
import std/strings as strings
import std/strutils as strutil
import cheng/rsi/types as types
import cheng/rsi/generator as generator

# 解析候选程序输出: 第一行 64 位十六进制答案, 第二行 compares 整数。
# 格式不符 / 哈希长度不符 / 非数字 -> outOk = 0 (C 车头坑: var-out 函数无返回值)。
fn RsiParseTaskOutputInto(text: str, outOk: var int32, outAnswer: var str,
                          outCompares: var int64) =
    outOk = 0
    if len(text) <= 0:
        return
    let lines = strutil.Split(text, '\n')
    if lines.len < 2:
        return
    let answer = strutil.Strip(Fmt"{lines[0]}")
    let countText = strutil.Strip(Fmt"{lines[1]}")
    if len(answer) != 64:
        return
    for i in 0..<64:
        let c = answer[i]
        let okDigit = c >= '0' && c <= '9'
        let okLower = c >= 'a' && c <= 'f'
        if !okDigit && !okLower:
            return
    let parsed = strutil.ParseInt(countText)
    if parsed < 0:
        return
    outAnswer = strings.CloneStr(answer)
    outCompares = int64(parsed)
    outOk = 1

# 任务域单候选裁决 (v2 双域): 正确性 = 候选答案 == 该域金标 (金标不消费
# 候选输出; 每域金标由 generator 按域独立重算)。
@borrows
fn RsiTaskCandidateCorrect(taskDomain: int32, answer: str): bool =
    return answer == generator.RsiGeneratorGoldenAnswer(taskDomain)

# 域准入 (提案 §4): 功能正确是硬约束; A 域聚合分必须严格低于父代;
# 编译器域 C1/C2 白名单已定义, 但载具级 A/B BLOCKED@kernel, 评价侧
# 仍恒 blocked (不产出假绿)。
fn RsiAdmissionForDomain(domain: int32, allCorrect: bool,
                         childScore: int64, parentScore: int64): int32 =
    if domain == types.RsiDomainCompiler:
        return types.RsiAdmitBlocked
    if domain != types.RsiDomainTask:
        return types.RsiAdmitBlocked
    if !allCorrect:
        return types.RsiAdmitReject
    if childScore < parentScore:
        return types.RsiAdmitAccept
    return types.RsiAdmitReject
