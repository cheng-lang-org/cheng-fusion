# 纯 Cheng RSI 框架: 变更提案校验 (提案第4步的准入侧)。
# 提案 = 精确的整数参数对 (domain, changeKind, strategy, param),
# 白名单外的提案一律拒绝。编译器域 C1/C2 批次四白名单见
# RsiProposalCellValid (语料门仅档 0 开放); C3-C5 在冻结测量合同落库前
# 仍拒; 载具级 C1 A/B 仍 BLOCKED@kernel (见编译器域合同)。
# 编译器域改进方向 (2026-09-07 用户定谳, 五维全为硬指标域;
# 2026-09-08 用户纠正解锁前置 —— 分域准入, GEN2/GEN3 固定点降为发布级;
# 2026-09-08 批次四实测修订 C1/C2 口径):
#   C1 编译时间   —— 编译器自报 exec_phase_total_us (微秒确定性相位;
#                    best-of-5 容 1 败取 min, 禁 wall-clock 单次计时);
#   C2 编译内存峰值 —— guard process_tree_resident_peak_bytes, per-corpus
#                    冻结基线 x 3/2 帽 (1GiB 为防失控硬限), 越低越好;
#   C3 最小编译内核 —— 自举闭包条目数/源码量, 满足全部门禁的最小集合;
#   C4 运行时性能 —— 产物代码质量 (探针运行时间/指令数), 不与 C1 混算;
#   C5 语法优雅简洁符合符号化直觉 —— 以 docs/cheng-formal-spec.md 正形
#      收敛为准 (直觉合法表面必须 primary/backend realizer 直修, 禁绕)。
# 试验准入 (每维独立, 无跨维串行): 固定语料集 (语料 CID 冻结) 新旧编译器
#   产物语义指纹 (运行 rc+stdout sha; 产物字节 sha 因 Mach-O 随机 uuid
#   不可用, map sha 仅记账) 对拍 + 全门禁绿 + 该维实测严格更优; C3 另加
#   自举链重新闭合 (不要求与旧字节相同); C5 另加 spec 迁移探针。
# 发布准入 (仓规第 6 条不变): GEN2/GEN3 原始字节固定点 + 权威链回执 ——
#   它是自举自洽的发布级证据, 不是改进试验的前置。
# 各维冻结测量合同 (语料/探针/口径/阈值) 落库前, 该维提案仍拒。
# C1/C2 冻结合同见
#   docs/campaigns/2026-09-07-pure-cheng-rsi/compiler_domain_c1c2_contract.md。
import cheng/rsi/types as types

# 域化提案校验 (批次三 v2 + 批次四编译器域 + 批次八 v4): 任务提案 =
# (taskDomain, changeKind, strategy, param) 四元组, A 的空间由
# types.RsiTaskCellValid 白名单钉死 (域 0 排序 7 族 x 3 param = 21 格 +
# 域 1 逆序对计数 5 格 + 域 3 数论 GCD 5 格, 共 31 格); meta 档
# 0..RsiMetaStrategyMax; 编译器域 (RsiCompilerDomain) 仅 C1/C2 构建参数档
# 白名单 (jobs 0..2 x 语料档仅 0 开放), 其余仍拒。
fn RsiProposalCellValid(taskDomain: int32, changeKind: int32, strategy: int32,
                        param: int32): bool =
    if taskDomain == types.RsiCompilerDomain && changeKind == types.RsiChangeTask:
        # 编译器域 (批次四 + B1 档 3): strategy=jobs 档 0..2,
        # param=语料档 0..RsiCompilerCorpusMax(=3); 语料档还须开放
        # (RsiCompilerCorpusOpen: 仅档 0=rsi_minimal_smoke 开放; 档 1/2/3 全闭,
        # 档 3=234 源全量自烤, 清墙前置见 corpus_tier3_contract.md §6.2 S1)。
        # 逻辑不新增分支: 上限与开放门自动跟随 types 单点。
        if strategy < 0 || strategy > types.RsiCompilerJobsMax:
            return false
        if param < 0 || param > types.RsiCompilerCorpusMax:
            return false
        return types.RsiCompilerCorpusOpen(param)
    if changeKind == types.RsiChangeTask:
        return types.RsiTaskCellValid(taskDomain, strategy, param)
    if changeKind == types.RsiChangeMeta:
        if strategy < 0 || strategy > types.RsiMetaStrategyMax:
            return false
        if param != 0:
            return false
        return true
    return false

# 兼容转发 (contract 旧断言): 仅保留旧单域任务入口; 编译器域走
# RsiProposalCellValid 批次四白名单, 本旧入口对编译器域恒拒 (合同冒烟
# 按旧口径断言 false), 未知域亦拒。
fn RsiProposalValid(domain: int32, changeKind: int32, strategy: int32,
                    param: int32): bool =
    if domain == types.RsiDomainCompiler:
        # 旧入口: 编译器域恒拒; 新白名单见 RsiProposalCellValid。
        return false
    if domain != types.RsiDomainTask:
        return false
    return RsiProposalCellValid(types.RsiDomainTask, changeKind, strategy,
                                param)
