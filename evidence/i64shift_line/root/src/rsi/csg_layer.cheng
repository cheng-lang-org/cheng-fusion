# 纯 Cheng RSI 框架: CSG 可控层 (2026-09-07 追加)。
# 可控性合同: RSI 的每次候选评价与版本推进都是 canonical JSONL 事实
# (csg.rsi.* dialect, 键字母序手工保证, gate 用权威 CsgCoreJsonCanonicalize
# 对拍钉死); 全集经 csg_core/merkle_dag 权威函数建 Patricia Merkle DAG,
# 根 (facts_root) 绑定版本谱系; 任何人可用 RsiCsgReplayInto 从盘上事实
# 独立重算 DAG 根 + 版本链衔接 + 严格降分/平分合同 —— 决策不是自报的。
# 权威边界 (如实): 本层复用 csg_core 库层 (merkle_dag/json_canonical/
# json_field/jsonl, 零 @importc), 不冒充 CSGC 生产准入链 (生产 CLI 在
# launcher 事件源接线前固定 HARD_RED); 自定义 kind 走 DAG 层身份,
# 不进入 validator 的闭合 kind 注册表。
# fact 数值一律字符串字段 (TopStringField 抽取, 避开 raw 数字解析)。
# C 车头坑规约 (lessons 2026-09-07): 形参外呼 Fmt; Split 产物不可传参
# (读回走 jsonl.CsgCoreJsonlSplitLines 权威切分); add 构造数组可传
# BuildFromCanonicalLines (probe_csg2/3 实证)。
import std/os as os
import std/strings as strings
import std/strutils as strutil
import cheng/core/csg_core/merkle_dag as mdag
import cheng/core/csg_core/json_canonical as jcanon
import cheng/core/csg_core/json_field as jfield
import cheng/core/csg_core/jsonl as jsonl
import cheng/rsi/types as types
import cheng/rsi/model as model

const
    # 每个事实集恰含一条 csg.core.schema 绑定 (features=["core-facts"]),
    # 与 csg_core 库层合同一致 (tests/csg_core_merkle_dag_smoke 同款)。
    RsiCsgSchemaFact = "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"

# 源码内容指纹: 对象级 "sha256:"+hex (与 csg.module.sha256 字段惯例同构);
# 不是域分离 merkle 节点哈希 —— DAG 根层面 (facts_root) 才是域分离权威。
fn RsiCsgSourceCid(source: str): str =
    let digest = strings.Sha256(Fmt"{source}")
    return strutil.Join(["sha256:", Fmt"{digest}"], "")

# fact 发射器: 键序手工字母升序, 数值为字符串字段 (三任务域: 事实带
# task_domain; 模型 cell = RsiModelCellOf 布局 0..6/7..11/14..18)。
# 键序: id,kind,param,strategy,task_domain
fn RsiCsgCandidateFact(tag: str, taskDomain: int32, strategy: int32,
                       param: int32): str =
    let d = strings.IntToStr(taskDomain)
    let s = strings.IntToStr(strategy)
    let p = strings.IntToStr(param)
    return strutil.Join(["{\"id\":\"cand:", Fmt"{tag}",
                         "\",\"kind\":\"csg.rsi.candidate\",\"param\":\"", Fmt"{p}",
                         "\",\"strategy\":\"", Fmt"{s}",
                         "\",\"task_domain\":\"", Fmt"{d}", "\"}"], "")

# 键序: id,kind,score,strategy,task_domain,verdict
# (score = 该域本域实测分, 学习信号按域, 不混入另一域账本分)。
fn RsiCsgTrialFact(tag: str, taskDomain: int32, strategy: int32, score: int64,
                   verdict: str): str =
    let scoreText = strings.Int64ToStr(score)
    let dText = strings.IntToStr(taskDomain)
    let sText = strings.IntToStr(strategy)
    return strutil.Join(["{\"id\":\"trial:", Fmt"{tag}",
                         "\",\"kind\":\"csg.rsi.trial\",\"score\":\"", Fmt"{scoreText}",
                         "\",\"strategy\":\"", Fmt"{sText}",
                         "\",\"task_domain\":\"", Fmt"{dText}",
                         "\",\"verdict\":\"", Fmt"{verdict}", "\"}"], "")

# 键序: change,d0_param,d0_score,d0_strategy,d1_param,d1_score,d1_strategy,
#       d2_param,d2_score,d2_strategy,id,kind,m_strategy,
#       parent_facts_root,score
# (score = 聚合分 = d0_score + d1_score + d2_score, 结构化保证;
#  d2 = 第三任务域 数论 GCD, taskDomain=3)。
fn RsiCsgVersionFact(gen: int32, change: str, mStrategy: int32,
                     d0Strategy: int32, d0Param: int32, d0Score: int64,
                     d1Strategy: int32, d1Param: int32, d1Score: int64,
                     d2Strategy: int32, d2Param: int32, d2Score: int64,
                     parentFactsRoot: str): str =
    let g = strings.IntToStr(gen)
    let m = strings.IntToStr(mStrategy)
    let d0s = strings.IntToStr(d0Strategy)
    let d0p = strings.IntToStr(d0Param)
    let d0ScoreText = strings.Int64ToStr(d0Score)
    let d1s = strings.IntToStr(d1Strategy)
    let d1p = strings.IntToStr(d1Param)
    let d1ScoreText = strings.Int64ToStr(d1Score)
    let d2s = strings.IntToStr(d2Strategy)
    let d2p = strings.IntToStr(d2Param)
    let d2ScoreText = strings.Int64ToStr(d2Score)
    let scoreText = strings.Int64ToStr(d0Score + d1Score + d2Score)
    return strutil.Join(["{\"change\":\"", Fmt"{change}",
                         "\",\"d0_param\":\"", Fmt"{d0p}",
                         "\",\"d0_score\":\"", Fmt"{d0ScoreText}",
                         "\",\"d0_strategy\":\"", Fmt"{d0s}",
                         "\",\"d1_param\":\"", Fmt"{d1p}",
                         "\",\"d1_score\":\"", Fmt"{d1ScoreText}",
                         "\",\"d1_strategy\":\"", Fmt"{d1s}",
                         "\",\"d2_param\":\"", Fmt"{d2p}",
                         "\",\"d2_score\":\"", Fmt"{d2ScoreText}",
                         "\",\"d2_strategy\":\"", Fmt"{d2s}",
                         "\",\"id\":\"version:", Fmt"{g}",
                         "\",\"kind\":\"csg.rsi.version\",\"m_strategy\":\"", Fmt"{m}",
                         "\",\"parent_facts_root\":\"", Fmt"{parentFactsRoot}",
                         "\",\"score\":\"", Fmt"{scoreText}", "\"}"], "")

# 决策事实: A-接受/拒绝与 M-接受/拒绝, ref 引用获胜试验 tag。
# 键序: decision,id,kind,ref (canonical 字母序)
fn RsiCsgDecisionFact(seq: int32, decision: str, refTag: str): str =
    let seqText = strings.IntToStr(seq)
    return strutil.Join(["{\"decision\":\"", Fmt"{decision}",
                         "\",\"id\":\"decision:", Fmt"{seqText}",
                         "\",\"kind\":\"csg.rsi.decision\",\"ref\":\"",
                         Fmt"{refTag}", "\"}"], "")

# 追加一条事实 (读全文 + 拼行 + 写回 + 回读比对)。
fn RsiCsgAppendFact(factsPath: str, fact: str): bool =
    let text = os.ReadFile(Fmt"{factsPath}")
    var next: str
    if len(text) <= 0:
        next = Fmt"{fact}"
    else:
        next = strutil.Join([Fmt"{text}", Fmt"{fact}"], "\n")
    os.WriteFile(Fmt"{factsPath}", next)
    return os.ReadFile(Fmt"{factsPath}") == next

# 全集 DAG 根 (读盘 -> jsonl 权威切分 -> merkle_dag 权威建 DAG)。
fn RsiCsgRootInto(factsPath: str, outRoot: var str, outOk: var int32) =
    outOk = 0
    let text = os.ReadFile(Fmt"{factsPath}")
    if len(text) <= 0:
        return
    let lines = jsonl.CsgCoreJsonlSplitLines(Fmt"{text}")
    if lines.len <= 0:
        return
    let dag = mdag.CsgCoreMerkleBuildFromCanonicalLines(lines)
    if !dag.ok:
        return
    let root = mdag.CsgCoreMerkleDagRootCid(dag)
    if len(root) != 71:
        return
    outRoot = strings.CloneStr(root)
    outOk = 1

# 模型快照事实 (决策前观测表序列化, 可解释复算锚点)。
# 键序: id,kind,table
fn RsiCsgModelFact(seq: int32, tableText: str): str =
    let seqText = strings.IntToStr(seq)
    return strutil.Join(["{\"id\":\"model:t", Fmt"{seqText}",
                         "\",\"kind\":\"csg.rsi.model\",\"table\":\"", Fmt"{tableText}",
                         "\"}"], "")

# 从盘上事实按行序重放观测, 重建模型表 (无隐藏状态: 模型=事实的函数)。
# trial 事实按行序依次 Observe (verdict=correct 才计); 三任务域:
# (task_domain, strategy) -> cell = model.RsiModelCellOf (0..6/7..11/14..18),
# 观测分数 = 本域实测分 (trial 事实分数即本域分, 学习信号按域)。
# 域/策略越界或字段缺失 (v2 之外的事实形态) -> outOk=0, 拒绝重建。
fn RsiCsgLoadModelInto(factsPath: str, table: var model.RsiModelTable,
                       outOk: var int32) =
    outOk = 0
    let text = os.ReadFile(Fmt"{factsPath}")
    if len(text) <= 0:
        return
    let lines = jsonl.CsgCoreJsonlSplitLines(Fmt"{text}")
    if lines.len <= 0:
        return
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        let kind = rsiField(Fmt"{line}", "kind")
        if kind == "csg.rsi.trial":
            let verdict = rsiField(Fmt"{line}", "verdict")
            if verdict == "correct":
                let dText = rsiField(Fmt"{line}", "task_domain")
                let sText = rsiField(Fmt"{line}", "strategy")
                let scoreText = rsiField(Fmt"{line}", "score")
                if len(dText) <= 0 || len(sText) <= 0 || len(scoreText) <= 0:
                    return
                let d = strutil.ParseInt(dText)
                let s = strutil.ParseInt(sText)
                if !types.RsiTaskCellValid(d, s, 0):
                    return
                let score = int64(strutil.ParseInt(scoreText))
                let cell = model.RsiModelCellOf(d, s)
                model.RsiModelObserve(table, cell, score)
    outOk = 1

# 变更空间覆盖审计 (v4 三任务域 31 格): 按 cand 事实的 (task_domain,
# strategy, param) 三元对照 types.RsiTaskCellValid 全空间 (域 0 七族 x 3
# param + 域 1 五族 x 1 param + 域 3 五族 x 1 param); trial 的 verdict
# 无关覆盖 (试过即覆盖), 已试格子中最小 correct 本域分由 trial 事实聚合。
# cand 事实域字段缺失 -> outOk=0。
fn RsiCsgCoverageInto(factsPath: str, outCovered: var int32,
                      outBestCorrect: var int64, outOk: var int32) =
    outOk = 0
    outCovered = 0
    outBestCorrect = -1
    let text = os.ReadFile(Fmt"{factsPath}")
    if len(text) <= 0:
        return
    let lines = jsonl.CsgCoreJsonlSplitLines(Fmt"{text}")
    # 格子全集必须显式累加三个真实任务域 (0/1/3): RsiTaskDomainCount=3
    # 只覆盖编号 0..2, Gcd 域 id=3 不在区间 (域 2 是编译器保留号, 0 格);
    # 漏加则 totalCells=22, 域 3 格子被 idx < totalCells 拦截, 26 格口径坏。
    var totalCells: int32 = 0
    totalCells = totalCells + types.RsiTaskDomainCellCount(0)
    totalCells = totalCells + types.RsiTaskDomainCellCount(1)
    totalCells = totalCells + types.RsiTaskDomainCellCount(types.RsiTaskDomainGcd)
    var seen: int32[]
    for i in 0..<totalCells:
        add(seen, 0)
    # 各域已试格子最小 correct 本域分之和 (= 最优完整 A 状态的聚合分口径,
    # 与 incumbent 聚合分同口径可比)。
    var bestPerDomain0: int64 = -1
    var bestPerDomain1: int64 = -1
    var bestPerDomain3: int64 = -1
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        let kind = rsiField(Fmt"{line}", "kind")
        if kind == "csg.rsi.trial":
            let verdict = rsiField(Fmt"{line}", "verdict")
            if verdict == "correct":
                let scoreText = rsiField(Fmt"{line}", "score")
                if len(scoreText) <= 0:
                    return
                let sc = int64(strutil.ParseInt(scoreText))
                let dText2 = rsiField(Fmt"{line}", "task_domain")
                if len(dText2) <= 0:
                    return
                let td = strutil.ParseInt(dText2)
                if td == 0:
                    if bestPerDomain0 < 0 || sc < bestPerDomain0:
                        bestPerDomain0 = sc
                if td == 1:
                    if bestPerDomain1 < 0 || sc < bestPerDomain1:
                        bestPerDomain1 = sc
                if td == types.RsiTaskDomainGcd:
                    if bestPerDomain3 < 0 || sc < bestPerDomain3:
                        bestPerDomain3 = sc
    # cand 事实给格子 (task_domain, strategy, param); 越白名单不计覆盖。
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        let kind = rsiField(Fmt"{line}", "kind")
        if kind == "csg.rsi.candidate":
            let dText = rsiField(Fmt"{line}", "task_domain")
            let sText = rsiField(Fmt"{line}", "strategy")
            let pText = rsiField(Fmt"{line}", "param")
            if len(dText) <= 0 || len(sText) <= 0 || len(pText) <= 0:
                return
            let d = strutil.ParseInt(dText)
            let st = strutil.ParseInt(sText)
            let pt = strutil.ParseInt(pText)
            if types.RsiTaskCellValid(d, st, pt):
                var idx: int32 = 0
                if d == 0:
                    idx = st * (types.RsiDomain0ParamMax + 1) + pt
                else:
                    if d == 1:
                        idx = types.RsiTaskDomainCellCount(0) + st * (types.RsiDomain1ParamMax + 1) + pt
                    else:
                        idx = types.RsiTaskDomainCellCount(0) + types.RsiTaskDomainCellCount(1) + st * (types.RsiDomain3ParamMax + 1) + pt
                if idx >= 0 && idx < totalCells:
                    if seen[idx] == 0:
                        seen[idx] = 1
                        outCovered = outCovered + 1
    # 域从未有 correct 观测时不参与最优切面主张 (计 0): v2 时代事实无域 3
    # 试验, 覆盖率不足是诚实状态 —— 审计按覆盖数如实给 PARTIAL, 不是扫描
    # 失败。在位两域 (0/1) 从未有 correct 观测 = 账本结构性损坏, 仍拒。
    if bestPerDomain0 < 0 || bestPerDomain1 < 0:
        return
    outBestCorrect = bestPerDomain0 + bestPerDomain1
    if bestPerDomain3 >= 0:
        outBestCorrect = outBestCorrect + bestPerDomain3
    outOk = 1

# 事实行数 (全局单调序号, 供跨进程唯一 tag 派生)。
fn RsiCsgFactCountInto(factsPath: str, outCount: var int32) =
    outCount = 0
    let text = os.ReadFile(Fmt"{factsPath}")
    if len(text) <= 0:
        return
    let lines = jsonl.CsgCoreJsonlSplitLines(Fmt"{text}")
    outCount = lines.len

# 按 kind 字段计数事实行 (收尾口径从图上事实派生, 不自报)。
fn RsiCsgCountKindInto(factsPath: str, kindName: str, outCount: var int32) =
    outCount = 0
    let text = os.ReadFile(Fmt"{factsPath}")
    if len(text) <= 0:
        return
    let lines = jsonl.CsgCoreJsonlSplitLines(Fmt"{text}")
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        let kind = rsiField(Fmt"{line}", "kind")
        if kind == kindName:
            outCount = outCount + 1

# 按 trial verdict 计数 (只统计 kind=="csg.rsi.trial" 且 verdict 匹配的行)。
fn RsiCsgCountTrialVerdictInto(factsPath: str, verdictName: str,
                               outCount: var int32) =
    outCount = 0
    let text = os.ReadFile(Fmt"{factsPath}")
    if len(text) <= 0:
        return
    let lines = jsonl.CsgCoreJsonlSplitLines(Fmt"{text}")
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        let kind = rsiField(Fmt"{line}", "kind")
        if kind == "csg.rsi.trial":
            let verdict = rsiField(Fmt"{line}", "verdict")
            if verdict == verdictName:
                outCount = outCount + 1

# canonical 对拍: 每行必须已是权威 canonical 形态 (发射器正确性的独立钉子)。
fn RsiCsgAllCanonicalInto(factsPath: str, outOk: var int32) =
    outOk = 0
    let text = os.ReadFile(Fmt"{factsPath}")
    if len(text) <= 0:
        return
    let lines = jsonl.CsgCoreJsonlSplitLines(Fmt"{text}")
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        let canon = jcanon.CsgCoreJsonCanonicalize(line)
        if !canon.ok:
            return
        let canonValue = Fmt"{canon.value}"
        if canonValue != line:
            return
    outOk = 1

# 抽取字符串字段 (缺失返回空)。
fn rsiField(line: str, name: str): str =
    let res = jfield.CsgCoreJsonTopStringField(Fmt"{line}", Fmt"{name}")
    if !res.found:
        return ""
    return Fmt"{res.value}"

# "version:12" -> 12; "trial:g3_c1" 无版本语义, 不在本函数处理。
fn rsiGenOfVersionId(idText: str): int32 =
    if len(idText) <= 8:
        return -1
    let digits = strings.CloneStrRange(Fmt"{idText}", 8, len(idText) - 8)
    return strutil.ParseInt(digits)

# 可控重放: 从盘上事实独立重算, 不信任账本自报。
# 合同 (全部通过才 outOk=1):
#   R1 全集 DAG 根可算 (71 字符 CID);
#   R2 schema fact 恰为第一行且等于 RsiCsgSchemaFact;
#   R3 version 链: gen 从 0 连续递增; version_g.parent_facts_root ==
#      「version_g 之前全部行」建 DAG 的根 (创世代 parent="none" 除外);
#   R4 change 合同: change="a" 的代聚合 score 严格小于前一 version 的聚合
#      score; change="meta" 的代聚合 score 等于前代且 m_strategy 翻转;
#      每代重放按行内代际校验聚合一致性 (v3: score == d0+d1+d2_score;
#      v2: score == d0+d1_score), 不等则拒;
#   R5 事实行全部 canonical。
# 输出: 最终 gen/score/全集根。
fn RsiCsgReplayInto(factsPath: str, outOk: var int32, outGen: var int32,
                    outScore: var int64, outRoot: var str) =
    outOk = 0
    outGen = -1
    outScore = -1
    let text = os.ReadFile(Fmt"{factsPath}")
    if len(text) <= 0:
        return
    let lines = jsonl.CsgCoreJsonlSplitLines(Fmt"{text}")
    if lines.len <= 0:
        return
    let first = Fmt"{lines[0]}"
    if first != RsiCsgSchemaFact:
        return
    # R5: canonical 逐行。
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        let canon = jcanon.CsgCoreJsonCanonicalize(line)
        if !canon.ok:
            return
        let canonValue = Fmt"{canon.value}"
        if canonValue != line:
            return
    # R3/R4: 滚动前缀建 DAG。
    var pending: str[]
    add(pending, Fmt"{lines[0]}")
    var prevGen: int32 = -1
    var prevScore: int64 = -1
    var prevM: int32 = -1
    var lastGen: int32 = -1
    var lastScore: int64 = -1
    for i in 1..<lines.len:
        let line = Fmt"{lines[i]}"
        let kind = rsiField(Fmt"{line}", "kind")
        if kind == "csg.rsi.cversion":
            # cdomain 账本链 (编译器域): 与任务域 version 合同同构, 但
            # score 语义 = best_us 逐代严格降 (cdomain 只准严格更优),
            # 无 meta 翻转语义; id 形如 cversion:N。
            let idTextC = rsiField(Fmt"{line}", "id")
            if len(idTextC) <= 9:
                return
            let genC = strutil.ParseInt(strings.CloneStrRange(Fmt"{idTextC}", 9,
                                                              len(idTextC) - 9))
            let scoreCText = rsiField(Fmt"{line}", "best_us")
            let scoreC = int64(strutil.ParseInt(scoreCText))
            let changeC = rsiField(Fmt"{line}", "change")
            let parentRootC = rsiField(Fmt"{line}", "parent_facts_root")
            if genC != prevGen + 1:
                return
            if scoreC < 0:
                return
            if prevGen < 0:
                if parentRootC != "none":
                    return
            else:
                let dagC = mdag.CsgCoreMerkleBuildFromCanonicalLines(pending)
                if !dagC.ok:
                    return
                let preRootC = mdag.CsgCoreMerkleDagRootCid(dagC)
                if preRootC != parentRootC:
                    return
                if changeC != "a":
                    return
                if !(scoreC < prevScore):
                    return
            add(pending, line)
            prevGen = genC
            prevScore = scoreC
            prevM = 0
            lastGen = genC
            lastScore = scoreC
        elif kind == "csg.rsi.version":
            let idText = rsiField(Fmt"{line}", "id")
            let gen = rsiGenOfVersionId(idText)
            let scoreText = rsiField(Fmt"{line}", "score")
            let score = int64(strutil.ParseInt(scoreText))
            let d0ScoreText = rsiField(Fmt"{line}", "d0_score")
            let d1ScoreText = rsiField(Fmt"{line}", "d1_score")
            # 代际判定 (行内字段存在性): version 事实无独立代际标记字段,
            # 按提案口径 d2_score 在场 = v3 三域聚合合同 (d2 三字段必须
            # 齐备); 缺席 = v2 双域聚合合同 (score == d0 + d1, 域 3 无试验
            # 时代, 旧代事实原样保留不改写, 读侧按其代际规则校验)。
            let d2ScoreText = rsiField(Fmt"{line}", "d2_score")
            if len(d0ScoreText) <= 0 || len(d1ScoreText) <= 0:
                return
            var d2Score: int64 = 0
            if len(d2ScoreText) > 0:
                let d2StrategyText = rsiField(Fmt"{line}", "d2_strategy")
                let d2ParamText = rsiField(Fmt"{line}", "d2_param")
                if len(d2StrategyText) <= 0 || len(d2ParamText) <= 0:
                    return
                d2Score = int64(strutil.ParseInt(d2ScoreText))
            let d0Score = int64(strutil.ParseInt(d0ScoreText))
            let d1Score = int64(strutil.ParseInt(d1ScoreText))
            let change = rsiField(Fmt"{line}", "change")
            let mText = rsiField(Fmt"{line}", "m_strategy")
            let m = strutil.ParseInt(mText)
            let parentRoot = rsiField(Fmt"{line}", "parent_facts_root")
            if gen != prevGen + 1:
                return
            if score < 0 || d0Score < 0 || d1Score < 0 || d2Score < 0:
                return
            # 聚合一致性: score == d0_score + d1_score + d2_score (不等即篡改)。
            if score != d0Score + d1Score + d2Score:
                return
            if prevGen < 0:
                if parentRoot != "none":
                    return
            else:
                # 前缀根衔接: pending (不含本 version 行) 的 DAG 根 == parent。
                let dag = mdag.CsgCoreMerkleBuildFromCanonicalLines(pending)
                if !dag.ok:
                    return
                let preRoot = mdag.CsgCoreMerkleDagRootCid(dag)
                if preRoot != parentRoot:
                    return
                # R4: change 合同 (聚合分口径)。
                if change == "a":
                    if !(score < prevScore):
                        return
                elif change == "meta":
                    if score != prevScore:
                        return
                    if m == prevM:
                        return
                else:
                    return
            add(pending, line)
            prevGen = gen
            prevScore = score
            prevM = m
            lastGen = gen
            lastScore = score
        else:
            add(pending, line)
    if lastGen < 0:
        return
    # R1: 全集根。
    let dagAll = mdag.CsgCoreMerkleBuildFromCanonicalLines(lines)
    if !dagAll.ok:
        return
    let rootAll = mdag.CsgCoreMerkleDagRootCid(dagAll)
    if len(rootAll) != 71:
        return
    outGen = lastGen
    outScore = lastScore
    outRoot = strings.CloneStr(rootAll)
    outOk = 1
