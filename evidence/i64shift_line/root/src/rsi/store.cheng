# 纯 Cheng RSI 框架: 内容寻址账本与版本存储 (提案第2步)。
# 账本 = 追加式文本, 每行携带 prev-line 摘要构成的哈希链 (篡改可见);
# 版本指针 = 写临时 -> 回读比对 -> RenameFile 原子换 (崩溃只留下旧或新完整版本)。
# 写会话互斥 (双写者拒绝) 见文件末 RsiStoreWriteLock*: 独占 mkdir 锁目录 +
# owner.txt (pid + 进程启动标识), 死 pid 陈旧锁可接管, 获取失败硬拒带判词。
# 全部事实只来自真实执行观测; 本模块不产生任何判定结论。
# 容器元素出仓一律先 Fmt 拷贝出 owned 再传 (借用契约, 学 fishing_gate)。
import std/os as os
import std/fs as fs
import std/strings as strings
import std/strutils as strutil
import cheng/rsi/types as types

# 行格式 (单行, 空格分词, 尾字段 detail 为自由文本但不允许换行):
#   chain <lineDigest> event <kind> gen <n> <k>=<v> ... detail <text>
# lineDigest = Sha256(prevLineDigest + "|" + payload), payload = 去掉 chain 字段的行体。
# 非 @borrows (move 形参): @borrows 嵌套调用链会使被调函数体不可达
# (body missing, 实证), 调用点一律 Fmt 拷贝后移交。
fn RsiStoreChainLine(prevDigest: str, payload: str): str =
    let seed = strutil.Join([Fmt"{prevDigest}", Fmt"{payload}"], "|")
    return strings.Sha256(Fmt"{seed}")

fn RsiStoreAppendLine(eventsPath: str, prevDigest: str, payload: str): str =
    let digest = RsiStoreChainLine(Fmt"{prevDigest}", Fmt"{payload}")
    let line = strutil.Join(["chain", Fmt"{digest}", Fmt"{payload}"], " ")
    let text = os.ReadFile(Fmt"{eventsPath}")
    var next: str
    if len(text) <= 0:
        next = line
    else:
        next = strutil.Join([Fmt"{text}", Fmt"{line}"], "\n")
    os.WriteFile(eventsPath, next)
    # 写后回读比对作为成功判据 (os.WriteFile 返回 void)。
    if os.ReadFile(eventsPath) != next:
        return ""
    return digest

# 全链重算验证: 行数与尾摘要走 var-out, 副作用函数无返回值 (C 车头坑规避)。
# 任何一行重算不匹配时 outLines = -1 (验证失败)。
fn RsiStoreVerifyChainInto(eventsPath: str, outLines: var int32,
                           outTailDigest: var str) =
    outLines = 0
    outTailDigest = types.RsiGenesisDigest()
    let text = os.ReadFile(Fmt"{eventsPath}")
    if len(text) <= 0:
        return
    let lines = strutil.Split(text, '\n')
    var digest = types.RsiGenesisDigest()
    for i in 0..<lines.len:
        let line = Fmt"{lines[i]}"
        let trimmed = strutil.Strip(line)
        if len(trimmed) <= 0:
            outLines = -1
            return
        if !strutil.StartsWith(trimmed, "chain "):
            outLines = -1
            return
        let fields = strutil.Split(trimmed, ' ')
        if fields.len < 3:
            outLines = -1
            return
        let want = Fmt"{fields[1]}"
        var rest: str[]
        for j in 2..<fields.len:
            add(rest, Fmt"{fields[j]}")
        let payload = strutil.Join(rest, " ")
        let calc = RsiStoreChainLine(Fmt"{digest}", Fmt"{payload}")
        if calc != want:
            outLines = -1
            return
        digest = strings.CloneStr(want)
    outTailDigest = strings.CloneStr(digest)
    outLines = lines.len

# 版本记录 (v3 三任务域纪元): 一代一行字段的文本文件, 14 行下限。
# score = 聚合分 = d0_score + d1_score + d2_score (写入端结构化保证,
# 读取端校验; d2 = 第三任务域 数论 GCD, taskDomain=3)。
fn RsiStoreVersionText(generation: int32, mStrategy: int32, d0Strategy: int32,
                       d0Param: int32, d0Score: int64, d1Strategy: int32,
                       d1Param: int32, d1Score: int64, d2Strategy: int32,
                       d2Param: int32, d2Score: int64,
                       factsRoot: str): str =
    let total = d0Score + d1Score + d2Score
    let d0ScoreText = strings.Int64ToStr(d0Score)
    let d1ScoreText = strings.Int64ToStr(d1Score)
    let d2ScoreText = strings.Int64ToStr(d2Score)
    let totalText = strings.Int64ToStr(total)
    var parts: str[]
    add(parts, Fmt"schema {types.RsiVersionLine}")
    add(parts, Fmt"generation {generation}")
    add(parts, Fmt"m_strategy {mStrategy}")
    add(parts, Fmt"d0_strategy {d0Strategy}")
    add(parts, Fmt"d0_param {d0Param}")
    add(parts, Fmt"d0_score {d0ScoreText}")
    add(parts, Fmt"d1_strategy {d1Strategy}")
    add(parts, Fmt"d1_param {d1Param}")
    add(parts, Fmt"d1_score {d1ScoreText}")
    add(parts, Fmt"d2_strategy {d2Strategy}")
    add(parts, Fmt"d2_param {d2Param}")
    add(parts, Fmt"d2_score {d2ScoreText}")
    add(parts, Fmt"score {totalText}")
    add(parts, Fmt"facts_root {factsRoot}")
    return strutil.Join(parts, "\n")

# 原子提交当前版本: 写 .tmp -> 回读比对 -> RenameFile。任一步失败返回 false。
fn RsiStoreCommitVersion(storeDir: str, generation: int32, mStrategy: int32,
                         d0Strategy: int32, d0Param: int32, d0Score: int64,
                         d1Strategy: int32, d1Param: int32, d1Score: int64,
                         d2Strategy: int32, d2Param: int32, d2Score: int64,
                         factsRoot: str): bool =
    let finalPath = strutil.Join([Fmt"{storeDir}", "current.txt"], "/")
    let tmpPath = strutil.Join([Fmt"{storeDir}", "current.txt.tmp"], "/")
    let text = RsiStoreVersionText(generation, mStrategy, d0Strategy, d0Param,
                                   d0Score, d1Strategy, d1Param, d1Score,
                                   d2Strategy, d2Param, d2Score,
                                   factsRoot)
    os.WriteFile(Fmt"{tmpPath}", Fmt"{text}")
    if os.ReadFile(Fmt"{tmpPath}") != text:
        return false
    if !os.RenameFile(Fmt"{tmpPath}", Fmt"{finalPath}"):
        return false
    return true

# 行 -> (key, value) 手工扫描: 单空格分隔, 恰好两段。
# 不用 strutil.Split(' '): 连续两次 Split 的产物内容损坏 (probe9e 定谳),
# 行级 Split 之后只能用索引扫描 + CloneStrRange 切片。
fn storeScanKeyValue(line: str, outKey: var str, outValue: var str): bool =
    let n = len(line)
    var sp: int32 = -1
    for i in 0..<n:
        if line[i] == ' ':
            sp = i
            if sp >= 0:
                if sp <= 0 || sp + 1 >= n:
                    return false
                outKey = strings.CloneStrRange(line, 0, sp)
                outValue = strings.CloneStrRange(line, sp + 1, n - sp - 1)
                return true
    return false

# 读取当前版本 (v3 三任务域全量, var-out; outOk=0 表示不存在或字段非法)。
# 行数下限 14; 聚合一致性 (score == d0+d1+d2_score) 不满足即拒
# (写入端结构化保证 d0+d1+d2, 读出不一致 = 篡改或损坏)。
fn RsiStoreLoadVersionDualInto(storeDir: str, outOk: var int32,
                               outGeneration: var int32,
                               outMStrategy: var int32,
                               outD0S: var int32, outD0P: var int32,
                               outD0Score: var int64, outD1S: var int32,
                               outD1P: var int32, outD1Score: var int64,
                               outD2S: var int32, outD2P: var int32,
                               outD2Score: var int64,
                               outScore: var int64, outFactsRoot: var str) =
    outOk = 0
    let finalPath = strutil.Join([Fmt"{storeDir}", "current.txt"], "/")
    let text = os.ReadFile(Fmt"{finalPath}")
    if len(text) <= 0:
        return
    let lines = strutil.Split(text, '\n')
    if lines.len < 14:
        return
    var seenGen: int32 = 0
    var seenM: int32 = 0
    var seenD0S: int32 = 0
    var seenD0P: int32 = 0
    var seenD0Score: int32 = 0
    var seenD1S: int32 = 0
    var seenD1P: int32 = 0
    var seenD1Score: int32 = 0
    var seenD2S: int32 = 0
    var seenD2P: int32 = 0
    var seenD2Score: int32 = 0
    var seenScore: int32 = 0
    var seenRoot: int32 = 0
    for i in 0..<lines.len:
        let line = strutil.Strip(Fmt"{lines[i]}")
        if len(line) <= 0:
            return
        var key: str
        var value: str
        if !storeScanKeyValue(line, key, value):
            return
        if key == "schema":
            if value != types.RsiVersionLine:
                return
        elif key == "generation":
            outGeneration = strutil.ParseInt(value)
            seenGen = 1
        elif key == "m_strategy":
            outMStrategy = strutil.ParseInt(value)
            seenM = 1
        elif key == "d0_strategy":
            outD0S = strutil.ParseInt(value)
            seenD0S = 1
        elif key == "d0_param":
            outD0P = strutil.ParseInt(value)
            seenD0P = 1
        elif key == "d0_score":
            outD0Score = int64(strutil.ParseInt(value))
            seenD0Score = 1
        elif key == "d1_strategy":
            outD1S = strutil.ParseInt(value)
            seenD1S = 1
        elif key == "d1_param":
            outD1P = strutil.ParseInt(value)
            seenD1P = 1
        elif key == "d1_score":
            outD1Score = int64(strutil.ParseInt(value))
            seenD1Score = 1
        elif key == "d2_strategy":
            outD2S = strutil.ParseInt(value)
            seenD2S = 1
        elif key == "d2_param":
            outD2P = strutil.ParseInt(value)
            seenD2P = 1
        elif key == "d2_score":
            outD2Score = int64(strutil.ParseInt(value))
            seenD2Score = 1
        elif key == "score":
            outScore = int64(strutil.ParseInt(value))
            seenScore = 1
        elif key == "facts_root":
            outFactsRoot = strings.CloneStr(value)
            seenRoot = 1
    if seenGen + seenM + seenD0S + seenD0P + seenD0Score + seenD1S + seenD1P + seenD1Score + seenD2S + seenD2P + seenD2Score + seenScore + seenRoot != 13:
        return
    if outGeneration < 0 || outScore < 0 || outD0Score < 0 || outD1Score < 0 || outD2Score < 0:
        return
    if outScore != outD0Score + outD1Score + outD2Score:
        return
    outOk = 1

# -----------------------------------------------------------------
# v2->v3 schema 代际 (批次八迁移)。
# 两代 current.txt 的 schema 行同为 cheng.rsi.version.v1 (无显式代际标记
# 字段), 代际判定 = 行内字段存在性 (与提案 §3「事实只增不改, 旧代事实按
# 其行内字段集读取」同口径):
#   v2 = 11 行: schema/generation/m_strategy/d0_*/d1_*/score/facts_root,
#        聚合合同 score == d0_score + d1_score;
#   v3 = 14 行: 追加 d2_strategy/d2_param/d2_score,
#        聚合合同 score == d0_score + d1_score + d2_score。
# 判定显式互斥: v2 读取器见任何 d2_* 字段即拒; v3 读取器 (上方 DualInto)
# 缺任一 d2_* 字段即拒。不是容错解析。
# 迁移 = 字段级映射: generation/m_strategy/d0_*/d1_*/score/facts_root 逐
# 字段原样保留, d2 = (0,0,0) —— v2 时代账本无域 3 试验, 第三任务域在位分
# 尚未建立, 零贡献入聚合 (score 不变); 事实图零改动故 facts_root 原样。
# -----------------------------------------------------------------

# v2 代际严格读取 (11 行双域, var-out; outOk=0 表示非 v2 或字段非法)。
# 任何 d2_* 字段在场 = v3 形, 本读取器必拒; score != d0+d1 必拒。
fn RsiStoreLoadVersionGen2Into(storeDir: str, outOk: var int32,
                               outGeneration: var int32,
                               outMStrategy: var int32,
                               outD0S: var int32, outD0P: var int32,
                               outD0Score: var int64, outD1S: var int32,
                               outD1P: var int32, outD1Score: var int64,
                               outScore: var int64, outFactsRoot: var str) =
    outOk = 0
    let finalPath = strutil.Join([Fmt"{storeDir}", "current.txt"], "/")
    let text = os.ReadFile(Fmt"{finalPath}")
    if len(text) <= 0:
        return
    let lines = strutil.Split(text, '\n')
    if lines.len < 11:
        return
    var seenGen: int32 = 0
    var seenM: int32 = 0
    var seenD0S: int32 = 0
    var seenD0P: int32 = 0
    var seenD0Score: int32 = 0
    var seenD1S: int32 = 0
    var seenD1P: int32 = 0
    var seenD1Score: int32 = 0
    var seenScore: int32 = 0
    var seenRoot: int32 = 0
    var seenD2: int32 = 0
    for i in 0..<lines.len:
        let line = strutil.Strip(Fmt"{lines[i]}")
        if len(line) <= 0:
            return
        var key: str
        var value: str
        if !storeScanKeyValue(line, key, value):
            return
        if key == "schema":
            if value != types.RsiVersionLine:
                return
        elif key == "generation":
            outGeneration = strutil.ParseInt(value)
            seenGen = 1
        elif key == "m_strategy":
            outMStrategy = strutil.ParseInt(value)
            seenM = 1
        elif key == "d0_strategy":
            outD0S = strutil.ParseInt(value)
            seenD0S = 1
        elif key == "d0_param":
            outD0P = strutil.ParseInt(value)
            seenD0P = 1
        elif key == "d0_score":
            outD0Score = int64(strutil.ParseInt(value))
            seenD0Score = 1
        elif key == "d1_strategy":
            outD1S = strutil.ParseInt(value)
            seenD1S = 1
        elif key == "d1_param":
            outD1P = strutil.ParseInt(value)
            seenD1P = 1
        elif key == "d1_score":
            outD1Score = int64(strutil.ParseInt(value))
            seenD1Score = 1
        elif key == "d2_strategy":
            seenD2 = 1
        elif key == "d2_param":
            seenD2 = 1
        elif key == "d2_score":
            seenD2 = 1
        elif key == "score":
            outScore = int64(strutil.ParseInt(value))
            seenScore = 1
        elif key == "facts_root":
            outFactsRoot = strings.CloneStr(value)
            seenRoot = 1
    if seenGen + seenM + seenD0S + seenD0P + seenD0Score + seenD1S + seenD1P + seenD1Score + seenScore + seenRoot != 10:
        return
    if seenD2 != 0:
        return
    if outGeneration < 0 || outScore < 0 || outD0Score < 0 || outD1Score < 0:
        return
    if outScore != outD0Score + outD1Score:
        return
    outOk = 1

# 代际自动读取 (var-out): 先 v3 严格读; 非法则 v2 严格读并内存升级
# (d2 = 0/0/0, 聚合不变)。outSchemaGen 报告实际代际 (3 或 2);
# outOk=0 = 两代皆不可读 (账本损坏或代际未知, 调用方不得猜)。
fn RsiStoreLoadVersionAutoInto(storeDir: str, outOk: var int32,
                               outSchemaGen: var int32,
                               outGeneration: var int32,
                               outMStrategy: var int32,
                               outD0S: var int32, outD0P: var int32,
                               outD0Score: var int64, outD1S: var int32,
                               outD1P: var int32, outD1Score: var int64,
                               outD2S: var int32, outD2P: var int32,
                               outD2Score: var int64,
                               outScore: var int64, outFactsRoot: var str) =
    outOk = 0
    outSchemaGen = 0
    outGeneration = 0
    outMStrategy = 0
    outD0S = 0
    outD0P = 0
    outD0Score = 0
    outD1S = 0
    outD1P = 0
    outD1Score = 0
    outD2S = 0
    outD2P = 0
    outD2Score = 0
    outScore = 0
    outFactsRoot = ""
    RsiStoreLoadVersionDualInto(Fmt"{storeDir}", outOk, outGeneration,
                                outMStrategy, outD0S, outD0P, outD0Score,
                                outD1S, outD1P, outD1Score, outD2S, outD2P,
                                outD2Score, outScore, outFactsRoot)
    if outOk == 1:
        outSchemaGen = 3
        return
    var v2Score: int64 = 0
    var v2Root: str
    RsiStoreLoadVersionGen2Into(Fmt"{storeDir}", outOk, outGeneration,
                                outMStrategy, outD0S, outD0P, outD0Score,
                                outD1S, outD1P, outD1Score, v2Score, v2Root)
    if outOk != 1:
        outOk = 0
        return
    outD2S = 0
    outD2P = 0
    outD2Score = 0
    outScore = v2Score
    outFactsRoot = strings.CloneStr(Fmt"{v2Root}")
    outSchemaGen = 2

# v2 -> v3 落盘迁移 (store 层自动升级入口): 字段级映射提交 (复用
# RsiStoreCommitVersion 原子通道), 提交后 v3 严格读回逐字段对拍映射,
# 任一字段不齐即 outOk=0。已是 v3 -> 幂等成功 (outMigrated=0 不写盘)。
# facts/events 两文件零改动。
fn RsiStoreMigrateV2ToV3Into(storeDir: str, outMigrated: var int32,
                             outOk: var int32) =
    outMigrated = 0
    outOk = 0
    var v3ok: int32 = 0
    var v3gen: int32 = 0
    var v3m: int32 = 0
    var v3d0s: int32 = 0
    var v3d0p: int32 = 0
    var v3d0sc: int64 = 0
    var v3d1s: int32 = 0
    var v3d1p: int32 = 0
    var v3d1sc: int64 = 0
    var v3d2s: int32 = 0
    var v3d2p: int32 = 0
    var v3d2sc: int64 = 0
    var v3score: int64 = 0
    var v3root: str
    RsiStoreLoadVersionDualInto(Fmt"{storeDir}", v3ok, v3gen, v3m, v3d0s,
                                v3d0p, v3d0sc, v3d1s, v3d1p, v3d1sc, v3d2s,
                                v3d2p, v3d2sc, v3score, v3root)
    if v3ok == 1:
        outOk = 1
        return
    var ok2: int32 = 0
    var v2gen: int32 = 0
    var v2m: int32 = 0
    var v2d0s: int32 = 0
    var v2d0p: int32 = 0
    var v2d0sc: int64 = 0
    var v2d1s: int32 = 0
    var v2d1p: int32 = 0
    var v2d1sc: int64 = 0
    var v2score: int64 = 0
    var v2root: str
    RsiStoreLoadVersionGen2Into(Fmt"{storeDir}", ok2, v2gen, v2m, v2d0s,
                                v2d0p, v2d0sc, v2d1s, v2d1p, v2d1sc, v2score,
                                v2root)
    if ok2 != 1:
        return
    let rootOwned = Fmt"{v2root}"
    if !RsiStoreCommitVersion(Fmt"{storeDir}", v2gen, v2m, v2d0s, v2d0p,
                              v2d0sc, v2d1s, v2d1p, v2d1sc, 0, 0, 0,
                              Fmt"{rootOwned}"):
        return
    var chkOk: int32 = 0
    var chkGen: int32 = 0
    var chkM: int32 = 0
    var chkD0S: int32 = 0
    var chkD0P: int32 = 0
    var chkD0Sc: int64 = 0
    var chkD1S: int32 = 0
    var chkD1P: int32 = 0
    var chkD1Sc: int64 = 0
    var chkD2S: int32 = 0
    var chkD2P: int32 = 0
    var chkD2Sc: int64 = 0
    var chkScore: int64 = 0
    var chkRoot: str
    RsiStoreLoadVersionDualInto(Fmt"{storeDir}", chkOk, chkGen, chkM, chkD0S,
                                chkD0P, chkD0Sc, chkD1S, chkD1P, chkD1Sc,
                                chkD2S, chkD2P, chkD2Sc, chkScore, chkRoot)
    if chkOk != 1:
        return
    if chkGen != v2gen || chkM != v2m || chkD0S != v2d0s || chkD0P != v2d0p:
        return
    if chkD0Sc != v2d0sc || chkD1S != v2d1s || chkD1P != v2d1p:
        return
    if chkD1Sc != v2d1sc || chkD2S != 0 || chkD2P != 0 || chkD2Sc != 0:
        return
    if chkScore != v2score:
        return
    let rootAfter = Fmt"{chkRoot}"
    if rootAfter != rootOwned:
        return
    outMigrated = 1
    outOk = 1

# 兼容读取 (main.cheng 既有调用, 旧 8 参签名): 代际自动读 (v3 优先,
# v2 内存升级), a_strategy/a_param 映射域 0 在位 (d0_strategy/d0_param),
# score 映射聚合分。只读: 本入口永不写盘。
fn RsiStoreLoadVersionInto(storeDir: str, outOk: var int32,
                           outGeneration: var int32, outAStrategy: var int32,
                           outAParam: var int32, outMStrategy: var int32,
                           outScore: var int64, outFactsRoot: var str) =
    outOk = 0
    var gen: int32 = 0
    var m: int32 = 0
    var schemaGen: int32 = 0
    var d0S: int32 = 0
    var d0P: int32 = 0
    var d0Score: int64 = 0
    var d1S: int32 = 0
    var d1P: int32 = 0
    var d1Score: int64 = 0
    var d2S: int32 = 0
    var d2P: int32 = 0
    var d2Score: int64 = 0
    var total: int64 = 0
    var root: str
    RsiStoreLoadVersionAutoInto(Fmt"{storeDir}", outOk, schemaGen, gen, m,
                                d0S, d0P, d0Score, d1S, d1P, d1Score, d2S,
                                d2P, d2Score, total, root)
    if outOk != 1:
        return
    outGeneration = gen
    outAStrategy = d0S
    outAParam = d0P
    outMStrategy = m
    outScore = total
    outFactsRoot = strings.CloneStr(Fmt"{root}")

# -----------------------------------------------------------------
# 写会话互斥 (提案 §5 步 2「双写者拒绝」)。
# 2026-09-10 只读审计: 本模块写路径 (RsiStoreAppendLine 追加账本行 /
# RsiStoreCommitVersion 提交版本) 与 engine 写路径此前均无任何互斥 ——
# 双写者只能靠 RenameFile 原子性避免读到半截文件, 会话级交错无拒绝判词。
# 锁原语: std 表面没有独占文件创建入口 (无 O_EXCL open); 唯一原子独占
# 创建原语 = mkdir (fs.Mkdir: 已存在即 Err)。故锁 = 独占创建的目录
# rsi.write.lock.d/ (语义等价 O_EXCL 锁文件), 目录内记录文件 owner.txt
# 载持有者身份:
#   schema cheng.rsi.write_lock.v1
#   pid <pid>
#   start <进程启动标识>
# 启动标识 = Darwin proc_pid_rusage RUSAGE_INFO_V0 ri_proc_start_abstime
# (与 C 运行时 install_lock 的 p_starttime 同口径: 区分同 pid 的不同前世)。
# 目录模式 0700: 记录仅所有者可读, 跨用户竞争者读不到记录 -> 硬拒。
# 判据 (无超时、无等待、无兜底; 任一不可判 -> 硬拒 fail closed):
#   独占创建成功 -> 写记录 + 回读逐字节相等 = 持有;
#   已存在 -> 读记录: pid+start 皆等于本进程 -> 拒 (held_by_self, 不重入);
#     pid 存活 (kill(pid,0) == 0 或 EPERM) -> 拒 (held_by_live);
#     死亡可证 (ESRCH, 或 pid == 本进程而 start 不同 = 同 pid 前世) -> 接管;
#     记录不可读 / 身份不可观测 / 存活不可判 -> 拒。
#   接管 = 观察到的陈旧记录文本未变时删记录 + rmdir + 重新独占创建;
#   竞争仲裁交给 mkdir (输者复读记录硬拒, 不重试不等待)。
#   释放 = 记录 pid+start 与本进程逐字段相等才删记录 + rmdir, 否则拒。
# 崩溃残留 (无 atexit 钩子) 由下一次获取按死 pid 接管; 正常退出必须显式
# 调 Release。锁为空/不存在时读取端零影响。
# -----------------------------------------------------------------
const
    RsiStoreWriteLockDirName = "rsi.write.lock.d"
    RsiStoreWriteLockRecordName = "owner.txt"
    RsiStoreWriteLockSchema = "cheng.rsi.write_lock.v1"
    # 0700: 所有者独占读写 (记录文件不经目录外暴露)。
    RsiStoreWriteLockMode = 448
    # kill(pid,0) 在本载具返回 errno (实测: 自身 0 / pid1 EPERM=1 /
    # 999999 ESRCH=3); ESRCH 是唯一可证的死亡判据, EPERM = 活但无权限。
    RsiStoreWriteLockEperm = 1
    RsiStoreWriteLockEsrch = 3

# 进程启动标识 (pid > 0 且存活时非 0; 0 = 不可观测, 调用方必须硬拒)。
fn RsiStoreProcessStartToken(pid: int32): int64 =
    if pid <= 0:
        return 0
    var info: os.OsRusageInfoV0
    let rc: int32 = os.os_proc_pid_rusage_bridge(pid,
                                                 os.osRusageInfoFlavorV0, info)
    if rc != 0:
        return 0
    if info.ri_proc_start_abstime <= 0:
        return 0
    return info.ri_proc_start_abstime

fn RsiStoreWriteLockRecordText(pid: int32, start: int64): str =
    let startText = strings.Int64ToStr(start)
    var parts: str[]
    add(parts, Fmt"schema {RsiStoreWriteLockSchema}")
    add(parts, Fmt"pid {pid}")
    add(parts, Fmt"start {startText}")
    return strutil.Join(parts, "\n")

# 启动标识格式判定 (纯十进制数字串, 1..19 位)。身份标识一律按原始文本
# 逐字符比较: strutil.ParseInt 是 32 位 (int), 会截断 63 位 mach 时刻
# (实测 6696843324034 -> 989309570), 故 start 字段不做数值解析。
fn RsiStoreWriteLockTokenDigitsOk(text: str): bool =
    let n = len(text)
    if n <= 0 || n > 19:
        return false
    for i in 0..<n:
        let c = text[i]
        if c < '0' || c > '9':
            return false
    return true

# 记录解析: 恰好 3 行且字段集完整, pid 为正, start 为十进制标识串;
# 否则 outOk = 0 (与版本读取器同纪律: 缺字段/半行一律拒, 不容错解析)。
fn RsiStoreWriteLockRecordParseInto(text: str, outOk: var int32,
                                    outPid: var int32,
                                    outStartText: var str) =
    outOk = 0
    outPid = 0
    outStartText = ""
    if len(text) <= 0:
        return
    let lines = strutil.Split(text, '\n')
    if lines.len != 3:
        return
    let l0 = strutil.Strip(Fmt"{lines[0]}")
    let l1 = strutil.Strip(Fmt"{lines[1]}")
    let l2 = strutil.Strip(Fmt"{lines[2]}")
    var k0: str
    var v0: str
    if !storeScanKeyValue(l0, k0, v0):
        return
    if k0 != "schema" || v0 != RsiStoreWriteLockSchema:
        return
    var k1: str
    var v1: str
    if !storeScanKeyValue(l1, k1, v1):
        return
    if k1 != "pid":
        return
    var k2: str
    var v2: str
    if !storeScanKeyValue(l2, k2, v2):
        return
    if k2 != "start":
        return
    let pid = strutil.ParseInt(v1)
    if pid <= 0:
        return
    if !RsiStoreWriteLockTokenDigitsOk(Fmt"{v2}"):
        return
    outPid = int32(pid)
    outStartText = strings.CloneStr(Fmt"{v2}")
    outOk = 1

# 删除锁产物并回查 (RemoveDir 是 void 且吞掉错误: 不信返回值, 一律删后
# 复查存在性, 残留 = 失败)。
fn RsiStoreWriteLockDropDirInto(lockDir: str, recordPath: str,
                                outGone: var int32) =
    outGone = 0
    let _rmRec = os.RemoveFile(Fmt"{recordPath}")
    if os.FileExists(Fmt"{recordPath}"):
        return
    os.RemoveDir(Fmt"{lockDir}")
    if os.DirExists(Fmt"{lockDir}"):
        return
    outGone = 1

# 获取写会话锁。outOk = 1 且判词含 acquired/acquired_by_takeover = 持有;
# outOk = 0 = 硬拒, 判词给出原因 (held_by_live/held_by_self/...)。
fn RsiStoreWriteLockAcquireInto(storeDir: str, outOk: var int32,
                                outVerdict: var str) =
    outOk = 0
    outVerdict = "rsi store write lock: acquire refused"
    if len(storeDir) <= 0:
        outVerdict = "rsi store write lock: empty store dir (refuse)"
        return
    if !os.DirExists(Fmt"{storeDir}"):
        outVerdict = "rsi store write lock: store dir missing (refuse)"
        return
    let selfPid = os.ProcessId()
    let selfStart = RsiStoreProcessStartToken(selfPid)
    if selfStart <= 0:
        outVerdict = "rsi store write lock: identity unobservable (refuse)"
        return
    let lockDir = strutil.Join([Fmt"{storeDir}", RsiStoreWriteLockDirName], "/")
    let recordPath = strutil.Join([Fmt"{lockDir}",
                                   RsiStoreWriteLockRecordName], "/")
    let selfStartText = strings.Int64ToStr(selfStart)
    let createRes = fs.Mkdir(Fmt"{lockDir}", RsiStoreWriteLockMode)
    if IsOk(createRes):
        let recordText = RsiStoreWriteLockRecordText(selfPid, selfStart)
        os.WriteFile(Fmt"{recordPath}", Fmt"{recordText}")
        if os.ReadFile(Fmt"{recordPath}") != recordText:
            var drop1: int32 = 0
            RsiStoreWriteLockDropDirInto(Fmt"{lockDir}", Fmt"{recordPath}",
                                         drop1)
            outVerdict = "rsi store write lock: owner record writeback mismatch (refuse)"
            return
        outOk = 1
        outVerdict = strutil.Join(["rsi store write lock: acquired",
                                   Fmt"pid={selfPid}",
                                   Fmt"start={selfStartText}"], " ")
        return
    # 已存在: 读记录判持有者 (自持 / 活 / 死 / 不可判)。
    let observed = os.ReadFile(Fmt"{recordPath}")
    var recOk: int32 = 0
    var recPid: int32 = 0
    var recStartText: str
    RsiStoreWriteLockRecordParseInto(Fmt"{observed}", recOk, recPid,
                                     recStartText)
    if recOk != 1:
        outVerdict = "rsi store write lock: owner record unreadable (refuse, fail closed)"
        return
    let recPidText = strings.IntToStr(recPid)
    if recPid == selfPid && recStartText == selfStartText:
        outVerdict = strutil.Join(["rsi store write lock: held_by_self",
                                   Fmt"pid={recPidText}"], " ")
        return
    var dead: int32 = 0
    if recPid == selfPid:
        # 同 pid 不同启动标识 = 记录属于本 pid 的前世, 已死 (本进程活着且
        # 标识不同), 死亡可证。
        dead = 1
    else:
        let probe = os.Kill(recPid, 0)
        if probe == RsiStoreWriteLockEsrch:
            dead = 1
        elif probe == 0 || probe == RsiStoreWriteLockEperm:
            dead = 0
        else:
            # 既非存活也非 ESRCH: 存活不可判 -> 不猜, 硬拒。
            dead = 2
    if dead == 0:
        outVerdict = strutil.Join(["rsi store write lock: held_by_live",
                                   Fmt"pid={recPidText}",
                                   Fmt"start={recStartText}"], " ")
        return
    if dead == 2:
        outVerdict = strutil.Join(["rsi store write lock: liveness unobservable",
                                   Fmt"pid={recPidText}", "(refuse)"], " ")
        return
    # 接管: 陈旧记录文本未变才删 (变 = 他者已接管 -> 复读判词后硬拒);
    # 删记录 + rmdir 后逐项回查, 残留即硬拒。
    let stillStale = os.ReadFile(Fmt"{recordPath}")
    if stillStale != observed:
        outVerdict = "rsi store write lock: takeover raced (lock changed under us, refuse)"
        return
    var dropped: int32 = 0
    RsiStoreWriteLockDropDirInto(Fmt"{lockDir}", Fmt"{recordPath}", dropped)
    if dropped != 1:
        outVerdict = "rsi store write lock: stale lock removal incomplete (refuse)"
        return
    let recreate = fs.Mkdir(Fmt"{lockDir}", RsiStoreWriteLockMode)
    if IsErr(recreate):
        # 竞争者的 mkdir 赢了 -> 本进程不持有, 不重试。
        outVerdict = "rsi store write lock: takeover lost race (refuse)"
        return
    let recordText2 = RsiStoreWriteLockRecordText(selfPid, selfStart)
    os.WriteFile(Fmt"{recordPath}", Fmt"{recordText2}")
    if os.ReadFile(Fmt"{recordPath}") != recordText2:
        var drop2: int32 = 0
        RsiStoreWriteLockDropDirInto(Fmt"{lockDir}", Fmt"{recordPath}", drop2)
        outVerdict = "rsi store write lock: takeover record writeback mismatch (refuse)"
        return
    outOk = 1
    outVerdict = strutil.Join(["rsi store write lock: acquired_by_takeover",
                               Fmt"dead_pid={recPidText}",
                               Fmt"start={selfStartText}"], " ")

# 释放写会话锁 (仅持有者): 记录 pid+start 与本进程逐字段相等才删。
fn RsiStoreWriteLockReleaseInto(storeDir: str, outOk: var int32,
                                outVerdict: var str) =
    outOk = 0
    outVerdict = "rsi store write lock: release refused"
    if len(storeDir) <= 0:
        outVerdict = "rsi store write lock: empty store dir (release refused)"
        return
    let selfPid = os.ProcessId()
    let selfStart = RsiStoreProcessStartToken(selfPid)
    let selfStartText = strings.Int64ToStr(selfStart)
    let lockDir = strutil.Join([Fmt"{storeDir}", RsiStoreWriteLockDirName], "/")
    let recordPath = strutil.Join([Fmt"{lockDir}",
                                   RsiStoreWriteLockRecordName], "/")
    let observed = os.ReadFile(Fmt"{recordPath}")
    var recOk: int32 = 0
    var recPid: int32 = 0
    var recStartText: str
    RsiStoreWriteLockRecordParseInto(Fmt"{observed}", recOk, recPid,
                                     recStartText)
    if recOk != 1:
        outVerdict = "rsi store write lock: not_owner (release refused, record unreadable)"
        return
    if selfStart <= 0 || recPid != selfPid || recStartText != selfStartText:
        outVerdict = "rsi store write lock: not_owner (release refused)"
        return
    var dropped: int32 = 0
    RsiStoreWriteLockDropDirInto(Fmt"{lockDir}", Fmt"{recordPath}", dropped)
    if dropped != 1:
        outVerdict = "rsi store write lock: release removal incomplete (refuse)"
        return
    outOk = 1
    outVerdict = "rsi store write lock: released"

# 单次提交的受锁入口 (获取 -> 提交 -> 释放): 获取失败硬拒且不提交;
# 长会话 (跨多次提交) 由调用方显式 Acquire/Release 持有。
fn RsiStoreCommitVersionGuarded(storeDir: str, generation: int32,
                                mStrategy: int32, d0Strategy: int32,
                                d0Param: int32, d0Score: int64,
                                d1Strategy: int32, d1Param: int32,
                                d1Score: int64, d2Strategy: int32,
                                d2Param: int32, d2Score: int64,
                                factsRoot: str,
                                outVerdict: var str): bool =
    var lockOk: int32 = 0
    var lockVerdict: str
    RsiStoreWriteLockAcquireInto(Fmt"{storeDir}", lockOk, lockVerdict)
    if lockOk != 1:
        outVerdict = strings.CloneStr(Fmt"{lockVerdict}")
        return false
    let committed = RsiStoreCommitVersion(Fmt"{storeDir}", generation,
                                          mStrategy, d0Strategy, d0Param,
                                          d0Score, d1Strategy, d1Param,
                                          d1Score, d2Strategy, d2Param,
                                          d2Score, Fmt"{factsRoot}")
    var relOk: int32 = 0
    var relVerdict: str
    RsiStoreWriteLockReleaseInto(Fmt"{storeDir}", relOk, relVerdict)
    if !committed:
        outVerdict = "rsi store write lock: commit failed under lock"
        return false
    if relOk != 1:
        outVerdict = strings.CloneStr(Fmt"{relVerdict}")
        return false
    outVerdict = "rsi store write lock: committed and released"
    return true
