# 纯 Cheng RSI 框架: 隔离执行与工作目录生命周期 (提案第3步)。
# 执行边界 (如实声明): argv 直传、合并 stderr、超时硬杀是本层提供的隔离;
# 文件/网络级权限隔离与进程树 RSS 守卫属宿主边界, 由 rsi_gate 外层
# (cheng_scratch_scope + beat_c_process_group_guard) 提供, 不在本层冒充。
# 候选源/产物必须落在 <root>/src/ 下 (编译器包根约束), 目录每轮自清理。
import std/os as os
import std/os_host_process as hostos
import std/strutils as strutil

fn RsiRunCapture(exePath: str, args: str[], envOverrides: str[],
                 workingDir: str, timeoutSec: int32, outOutput: var str,
                 outExitCode: var int32) =
    let res = hostos.ExecFileCapture(Fmt"{exePath}", args, envOverrides,
                                     workingDir, true, timeoutSec)
    outOutput = os.ExecCmdResultOutput(res)
    outExitCode = os.ExecCmdResultExitCode(res)

# 工作目录清空: 只删直接子文件; 目录本身保留 (由 scratch scope 生命周期兜底)。
# 删除后逐项回查, 残留即返回 false —— 不信任吞掉错误的删除返回值。
@borrows
fn RsiCleanWorkDir(workDir: str): bool =
    let listing = os.ListDir(Fmt"{workDir}")
    for i in 0..<listing.len:
        let entry = Fmt"{listing[i]}"
        let name = Fmt"{os.ExtractFilename(entry)}"
        if len(name) <= 0 || name == "." || name == "..":
            continue
        let path = strutil.Join([Fmt"{workDir}", Fmt"{name}"], "/")
        let _removed = os.RemoveFile(path)
    let after = os.ListDir(workDir)
    return after.len == 0
