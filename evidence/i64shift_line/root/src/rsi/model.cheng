# 纯 Cheng RSI 框架: 白盒可解释候选排序模型 (2026-09-07 三段, v4 三任务域 31 格)。
# 模型 = 逐策略族观测表 (n 次数, minObs 最好成绩) + 一条可一句话复算的
# 乐观界规则: 未观测族界=0 (探索优先), 已观测族界=1+minObs (利用最优)。
# v4 三任务域: 族号 = cell (域 0=0..6, 域 1=7..11, 12..13 编译器域保留号,
# 域 3 GCD=14..18, 见 RsiModelCellOf), 有效任务族 17, 表容量 19;
# 观测分数 = 本域实测分 (学习信号按域, 不混另一域账本分)。
# 排序键 = (界, cell)。无隐藏状态、无浮点、无学习黑盒 —— 任何一次 pick
# 都能从图上模型快照 + 本规则手工复算; 模型状态完全由 CSG trial 事实
# 重放得出 (RsiCsgLoadModelInto), 改进器源码内嵌快照+规则 (源码即模型)。
# 实现纪律: 纯整数; 托管 struct 一律 var 借用形参 + Into (var 形参函数
# 返回值不可信, C 车头坑); 表为平行 int 数组。
import std/strings as strings
import std/strutils as strutil
import std/seqs as seqs
import cheng/rsi/types as types

type
    RsiModelTable =
        familyCount: int32
        n: int32[]
        minObs: int64[]

fn RsiModelTableInit(table: var RsiModelTable) =
    table.familyCount = types.RsiModelCellSpan
    for i in 0..<table.familyCount:
        add(table.n, 0)
        add(table.minObs, 0)

# 任务域 -> 观测表 cell: 域 0 = 0..6, 域 1 = 7..11 (基 = 域 0 族数自动
# 派生), 域 3 = 14..18 (cell 12..13 为编译器域保留号, 任务观测永不入位);
# 越白名单 -1。
fn RsiModelCellOf(taskDomain: int32, strategy: int32): int32 =
    if taskDomain == 0:
        return strategy
    if taskDomain == 1:
        return (types.RsiDomain0StrategyMax + 1) + strategy
    if taskDomain == types.RsiTaskDomainGcd:
        return types.RsiModelCellBaseGcd + strategy
    return -1

# 观测更新 (增量): 正确候选才构成学习信号 (cell 语义, 0..familyCount-1)。
fn RsiModelObserve(table: var RsiModelTable, strategy: int32, score: int64) =
    if strategy < 0 || strategy >= table.familyCount:
        return
    let oldN = table.n[strategy]
    table.n[strategy] = oldN + 1
    if oldN == 0:
        table.minObs[strategy] = score
    else:
        let cur = table.minObs[strategy]
        if score < cur:
            table.minObs[strategy] = score

# 乐观界 (纯整数): 未观测=0, 已观测=1+minObs。
fn RsiModelBoundInto(table: var RsiModelTable, strategy: int32,
                     outBound: var int64) =
    if strategy < 0 || strategy >= table.familyCount:
        outBound = -1
        return
    if table.n[strategy] == 0:
        outBound = 0
        return
    outBound = table.minObs[strategy] + 1

# 依 (界, 族号) 排出完整策略序 (冒泡: 界小者前, 界同族号小者前)。
fn RsiModelOrderInto(table: var RsiModelTable, outOrder: var int32[]) =
    seqs.setLen(outOrder, 0)
    for i in 0..<table.familyCount:
        add(outOrder, i)
    for i in 0..<table.familyCount:
        for j in 0..<(table.familyCount - 1 - i):
            let a = outOrder[j]
            let b = outOrder[j + 1]
            var ba: int64 = 0
            var bb: int64 = 0
            RsiModelBoundInto(table, a, ba)
            RsiModelBoundInto(table, b, bb)
            if bb < ba || (bb == ba && b < a):
                outOrder[j] = b
                outOrder[j + 1] = a

# 序列化 "族:观测数:最好成绩;..." (纯数字/冒号/分号, JSON 字符串值免转义)。
fn RsiModelTableTextInto(table: var RsiModelTable, outText: var str) =
    var parts: str[]
    for i in 0..<table.familyCount:
        let nText = strings.IntToStr(table.n[i])
        let minText = strings.Int64ToStr(table.minObs[i])
        let piece = strutil.Join([strings.IntToStr(i), Fmt"{nText}",
                                  Fmt"{minText}"], ":")
        add(parts, Fmt"{piece}")
    outText = strutil.Join(parts, ";")
