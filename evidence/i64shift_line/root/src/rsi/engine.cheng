# 纯 Cheng RSI 框架: 递归闭环引擎 (提案第6步; v3 三任务域: 域 0/1/3)。
# 一轮 = 真实执行当前版本改进器 M_g 产生跨域候选序列 -> 逐候选只编译
# 变更域、隔离运行、独立评价 -> A-准入(聚合分严格降, 聚合=变更域实测分+
# 另两域账本在位分) -> 可选 M-元评价(同起点同预算一次前瞻, M' 后继聚合分
# 严格优于 M_g 后继才接受 M 变更) -> 版本原子推进 + 哈希链记账。
# 学习信号按域: trial 事实记本域实测分, 模型按 RsiModelCellOf 布局观测。
# 防假绿纪律: accepted 行只可能由真实 rc=0 + 答案==金标 + 聚合分严格不等
# 产生; 预算耗尽是正常终止; 任何守卫/IO 失败 -> 保持当前版本。
# C 车头坑规避 (probe3/4/5 实证):
#   1) 函数体内 call-result 局部 str 被 move 消费一次后再借用会被拒
#      (lacks exact live source) —— 同一局部每次外呼一律 Fmt 再拷贝;
#      函数形参是合法重复来源, 直传即可 (fishing_gate 先例)。
#   2) var 形参函数的返回值不可信 —— 副作用函数全 void + var-out (Into 模式),
#      行索引由调用点先快照, 判定与写入拆纯读/纯写。
#   3) 循环只用 for-in-range; 插值只喂简单变量 (int64 先 Int64ToStr,
#      容器索引先 let); 常量字面量直传; 嵌套调用不作实参。
import std/os as os
import std/strings as strings
import std/strutils as strutil
import cheng/rsi/types as types
import cheng/rsi/state as state
import cheng/rsi/store as store
import cheng/rsi/proposal as proposal
import cheng/rsi/generator as generator
import cheng/rsi/compiler as compiler
import cheng/rsi/execution as execution
import cheng/rsi/evaluator as evaluator
import cheng/rsi/promotion as promotion
import cheng/rsi/csg_layer as csg
import cheng/rsi/model as model
import cheng/rsi/generator_adapter as adapter

fn engineEmit(eventsPath: str, digest: var str, payload: str): bool =
    let next = store.RsiStoreAppendLine(Fmt"{eventsPath}", Fmt"{digest}",
                                        payload)
    if len(next) <= 0:
        return false
    digest = strings.CloneStr(Fmt"{next}")
    return true

# 单候选全链 (按域): 生成 -> 落盘 -> 编译 -> 运行 -> 解析 -> 金标裁决。
# 返回码: 0=评价完成, 1=编译失败, 2=运行失败, 3=输出不可解析,
# 4=提案白名单外, 5=源码落盘失败。outScore = 该域本域实测分。
fn engineTryTaskCandidate(root: str, compilerPath: str, workDir: str,
                          budget: types.RsiBudget, taskDomain: int32,
                          strategy: int32, param: int32, tag: str,
                          outScore: var int64, outCorrect: var int32,
                          outRc: var int32): int32 =
    if !proposal.RsiProposalCellValid(taskDomain, types.RsiChangeTask,
                                      strategy, param):
        return 4
    let srcPath = Fmt"{workDir}/cand_d{taskDomain}_{tag}.cheng"
    let binPath = Fmt"{workDir}/cand_d{taskDomain}_{tag}"
    let source = generator.RsiGeneratorTaskProgram(taskDomain, strategy, param)
    os.WriteFile(Fmt"{srcPath}", Fmt"{source}")
    if os.ReadFile(Fmt"{srcPath}") != source:
        return 5
    let crc = compiler.RsiCompileCheng(Fmt"{compilerPath}", Fmt"{root}",
                                       Fmt"{srcPath}", Fmt"{binPath}",
                                       budget.compileTimeoutSec,
                                       ["CHENG_ENTRY_CACHE=0",
                                        "CHENG_NO_CACHE=1",
                                        "CHENG_STRICT_NO_CACHE=1"])
    if crc != 0:
        outRc = crc
        return 1
    var output: str
    var rrc: int32 = 0
    execution.RsiRunCapture(Fmt"{binPath}", [], [], "", budget.runTimeoutSec,
                            output, rrc)
    if rrc != 0:
        outRc = rrc
        return 2
    var answer: str
    var compares: int64 = 0
    var parsedOk: int32 = 0
    evaluator.RsiParseTaskOutputInto(Fmt"{output}", parsedOk, answer, compares)
    if parsedOk != 1:
        return 3
    outScore = compares
    outCorrect = 0
    if evaluator.RsiTaskCandidateCorrect(taskDomain, Fmt"{answer}"):
        outCorrect = 1
    return 0

# 编译并真实运行改进器, 解析其候选序列 (v2 双域: 每候选三行 —— 域 d 行、
# 策略 s 行、参数 p 行, 共 3*maxCandidates 行)。越白名单输出 -> 3,
# 改进器无法扩大变更空间。
fn engineRunImprover(root: str, compilerPath: str, workDir: str,
                     budget: types.RsiBudget, mStrategy: int32, tag: str,
                     tableText: str, outPicksD: var int32[],
                     outStrategies: var int32[],
                     outParams: var int32[]): int32 =
    let srcPath = Fmt"{workDir}/impr_{tag}.cheng"
    let binPath = Fmt"{workDir}/impr_{tag}"
    let source = generator.RsiGeneratorImproverProgram(mStrategy,
                                                       budget.maxCandidates,
                                                       Fmt"{tableText}")
    os.WriteFile(Fmt"{srcPath}", Fmt"{source}")
    if os.ReadFile(Fmt"{srcPath}") != source:
        return 5
    let crc = compiler.RsiCompileCheng(Fmt"{compilerPath}", Fmt"{root}",
                                       Fmt"{srcPath}", Fmt"{binPath}",
                                       budget.compileTimeoutSec,
                                       ["CHENG_ENTRY_CACHE=0",
                                        "CHENG_NO_CACHE=1",
                                        "CHENG_STRICT_NO_CACHE=1"])
    if crc != 0:
        return 1
    var output: str
    var rrc: int32 = 0
    execution.RsiRunCapture(Fmt"{binPath}", [], [], "", budget.runTimeoutSec,
                            output, rrc)
    if rrc != 0:
        return 2
    let lines = strutil.Split(Fmt"{output}", '\n')
    if lines.len < 3 * budget.maxCandidates:
        return 3
    for c in 0..<budget.maxCandidates:
        let dLine = Fmt"{lines[3 * c]}"
        let sLine = Fmt"{lines[3 * c + 1]}"
        let pLine = Fmt"{lines[3 * c + 2]}"
        let dTrim = strutil.Strip(dLine)
        let sTrim = strutil.Strip(sLine)
        let pTrim = strutil.Strip(pLine)
        let d = strutil.ParseInt(Fmt"{dTrim}")
        let s = strutil.ParseInt(Fmt"{sTrim}")
        let p = strutil.ParseInt(Fmt"{pTrim}")
        if !proposal.RsiProposalCellValid(d, types.RsiChangeTask, s, p):
            return 3
        add(outPicksD, d)
        add(outStrategies, s)
        add(outParams, p)
    return 0

# 评价一个候选序列 (跨域): 候选聚合分 = 变更域实测分 + 另两域账本在位分
# (d0Ledger/d1Ledger/d2Ledger 为当前在位本域分); 最低聚合分为最优;
# 逐候选记账+落链。outBestScore 语义 = 聚合分; outBestDomainScore 为
# 获胜候选的本域实测分 (A-accept 更新对应域账本用)。
fn engineEvaluatePicks(root: str, compilerPath: str, workDir: str,
                       budget: types.RsiBudget, picksD: int32[],
                       picksS: int32[], picksP: int32[],
                       d0Ledger: int64, d1Ledger: int64, d2Ledger: int64,
                       eventsPath: str, digest: var str,
                       trials: var state.RsiTrialTable, genRound: int32,
                       changeKind: int32, factsPath: str,
                       modelTable: var model.RsiModelTable,
                       outBestScore: var int64, outBestDomain: var int32,
                       outBestStrategy: var int32, outBestParam: var int32,
                       outBestDomainScore: var int64,
                       outBestRow: var int32, outBestTag: var str): bool =
    outBestScore = -1
    outBestDomain = 0
    outBestStrategy = 0
    outBestParam = 0
    outBestDomainScore = 0
    outBestRow = -1
    outBestTag = ""
    for c in 0..<picksS.len:
        let candD = picksD[c]
        let candS = picksS[c]
        let candP = picksP[c]
        let row = trials.trialCount
        state.RsiTrialAppend(trials, types.RsiDomainTask, changeKind, candS,
                             candP)
        # tag 用事实行数派生的全局单调序号: 跨进程 run 轮次号会重复,
        # 撞键会破坏 DAG 键唯一 (gate 实测 duplicate key)。
        var factSeq: int32 = 0
        csg.RsiCsgFactCountInto(Fmt"{factsPath}", factSeq)
        let tag = Fmt"t{factSeq}_c{c}"
        var score: int64 = 0
        var correct: int32 = 0
        var rc: int32 = 0
        let phase = engineTryTaskCandidate(Fmt"{root}", Fmt"{compilerPath}",
                                           Fmt"{workDir}", budget, candD, candS,
                                           candP, Fmt"{tag}", score, correct,
                                           rc)
        # CSG 可控层: 候选与试验即时入图 (崩溃中断时已评试验仍可审计)。
        # cand/trial 事实带 task_domain; trial 分数 = 本域实测分。
        let candFact = csg.RsiCsgCandidateFact(Fmt"{tag}", candD, candS,
                                               candP)
        if !csg.RsiCsgAppendFact(Fmt"{factsPath}", candFact):
            return false
        var trialVerdict = "wrong_answer"
        if phase != 0:
            trialVerdict = "failed"
        if phase == 0 && correct == 1:
            trialVerdict = "correct"
        let trialFact = csg.RsiCsgTrialFact(Fmt"{tag}", candD, candS, score,
                                            Fmt"{trialVerdict}")
        if !csg.RsiCsgAppendFact(Fmt"{factsPath}", trialFact):
            return false
        if row >= 0 && row < trials.trialCount:
            let stRow = trials.state[row]
            if types.RsiTransitionLegal(stRow, types.RsiTrialAdmitted):
                state.RsiTrialWriteState(trials, row, types.RsiTrialAdmitted, 0)
        if phase != 0:
            if row >= 0 && row < trials.trialCount:
                # 合法迁移链 Admitted -> Built -> Failed (直接 Admitted ->
                # Failed 非法会被跳过, trial 滞留 Admitted)。
                let stBuildF = trials.state[row]
                if types.RsiTransitionLegal(stBuildF, types.RsiTrialBuilt):
                    state.RsiTrialWriteState(trials, row, types.RsiTrialBuilt,
                                             0)
                let stFail = trials.state[row]
                if types.RsiTransitionLegal(stFail, types.RsiTrialFailed):
                    state.RsiTrialWriteState(trials, row, types.RsiTrialFailed,
                                             score)
            let payload = strutil.Join(["event=trial_failed",
                                        Fmt"gen={genRound}",
                                        Fmt"candidate={c}",
                                        Fmt"task_domain={candD}",
                                        Fmt"strategy={candS}",
                                        Fmt"param={candP}",
                                        Fmt"phase={phase}",
                                        Fmt"rc={rc}"], " ")
            if !engineEmit(Fmt"{eventsPath}", digest, payload):
                return false
        else:
            if row >= 0 && row < trials.trialCount:
                # 合法迁移链 Admitted -> Built -> Evaluated (直接 Admitted ->
                # Evaluated 非法会被跳过, 连锁堵死 Evaluated ->
                # Accepted/Rejected, trial 滞留 Admitted)。
                let stBuildE = trials.state[row]
                if types.RsiTransitionLegal(stBuildE, types.RsiTrialBuilt):
                    state.RsiTrialWriteState(trials, row, types.RsiTrialBuilt,
                                             0)
                let stEval = trials.state[row]
                if types.RsiTransitionLegal(stEval, types.RsiTrialEvaluated):
                    state.RsiTrialWriteState(trials, row, types.RsiTrialEvaluated,
                                             score)
            if correct == 1:
                # 学习信号按域: cell 按 RsiModelCellOf 布局, 观测本域实测分。
                let cell = model.RsiModelCellOf(candD, candS)
                model.RsiModelObserve(modelTable, cell, score)
            if correct == 1:
                # 候选聚合分 = 变更域实测分 + 另两域账本在位分。
                var agg: int64 = 0
                if candD == 0:
                    agg = score + d1Ledger + d2Ledger
                else:
                    if candD == 1:
                        agg = d0Ledger + score + d2Ledger
                    else:
                        agg = d0Ledger + d1Ledger + score
                if outBestScore < 0 || agg < outBestScore:
                    outBestScore = agg
                    outBestDomain = candD
                    outBestStrategy = candS
                    outBestParam = candP
                    outBestDomainScore = score
                    outBestRow = row
                    outBestTag = Fmt"{tag}"
            let verdict = if correct == 1: "correct" else: "wrong_answer"
            let scoreText = strings.Int64ToStr(score)
            let payload = strutil.Join(["event=trial_evaluated",
                                        Fmt"gen={genRound}",
                                        Fmt"candidate={c}",
                                        Fmt"task_domain={candD}",
                                        Fmt"strategy={candS}",
                                        Fmt"param={candP}",
                                        Fmt"score={scoreText}",
                                        Fmt"verdict={verdict}"], " ")
            if !engineEmit(Fmt"{eventsPath}", digest, payload):
                return false
    return true

# 读取当前版本到本地 (Into 模式; ok=0 表示无版本)。v3 三任务域全量:
# 三域在位 (s,p,score) + 聚合分 (agg = d0Score + d1Score + d2Score)。
fn engineLoadVersion(storeDir: str, ok: var int32, gen: var int32,
                     mStrategy: var int32, d0S: var int32, d0P: var int32,
                     d0Score: var int64, d1S: var int32, d1P: var int32,
                     d1Score: var int64, d2S: var int32, d2P: var int32,
                     d2Score: var int64, aggScore: var int64,
                     factsRoot: var str) =
    ok = 0
    gen = 0
    mStrategy = 0
    d0S = 0
    d0P = 0
    d0Score = 0
    d1S = 0
    d1P = 0
    d1Score = 0
    d2S = 0
    d2P = 0
    d2Score = 0
    aggScore = 0
    factsRoot = ""
    store.RsiStoreLoadVersionDualInto(Fmt"{storeDir}", ok, gen, mStrategy, d0S,
                                      d0P, d0Score, d1S, d1P, d1Score, d2S,
                                      d2P, d2Score, aggScore, factsRoot)

# 创世 (v3 三任务域): 无当前版本时, 真实编译运行三域种子各得本域实测
# 初始分 —— 域 0 (0,0) 排序冒泡 + 域 1 (0,0) 逆序朴素 + 域 3 (1,0)
# 迭代辗转相除, 初始分数不捏造。
# version0: parent="none", m=0, 聚合 = d0Score + d1Score + d2Score。
fn engineGenesis(root: str, compilerPath: str, workDir: str, storeDir: str,
                 budget: types.RsiBudget, eventsPath: str, factsPath: str,
                 digest: var str): int32 =
    var d0Score: int64 = 0
    var d0Correct: int32 = 0
    var rc0: int32 = 0
    let phase0 = engineTryTaskCandidate(Fmt"{root}", Fmt"{compilerPath}",
                                        Fmt"{workDir}", budget, 0, 0, 0,
                                        "g0_seed", d0Score, d0Correct, rc0)
    if phase0 != 0 || d0Correct != 1:
        let payload = strutil.Join(["event=genesis_failed",
                                    Fmt"phase={phase0}", Fmt"rc={rc0}"], " ")
        let _kept0 = engineEmit(Fmt"{eventsPath}", digest, payload)
        return 1
    var d1Score: int64 = 0
    var d1Correct: int32 = 0
    var rc1: int32 = 0
    let phase1 = engineTryTaskCandidate(Fmt"{root}", Fmt"{compilerPath}",
                                        Fmt"{workDir}", budget, 1, 0, 0,
                                        "g1_seed", d1Score, d1Correct, rc1)
    if phase1 != 0 || d1Correct != 1:
        let payload = strutil.Join(["event=genesis_failed",
                                    Fmt"phase={phase1}", Fmt"rc={rc1}"], " ")
        let _kept1 = engineEmit(Fmt"{eventsPath}", digest, payload)
        return 1
    var d2Score: int64 = 0
    var d2Correct: int32 = 0
    var rc2: int32 = 0
    let phase2 = engineTryTaskCandidate(Fmt"{root}", Fmt"{compilerPath}",
                                        Fmt"{workDir}", budget,
                                        types.RsiTaskDomainGcd, 1, 0,
                                        "g2_seed", d2Score, d2Correct, rc2)
    if phase2 != 0 || d2Correct != 1:
        let payload = strutil.Join(["event=genesis_failed",
                                    Fmt"phase={phase2}", Fmt"rc={rc2}"], " ")
        let _kept2 = engineEmit(Fmt"{eventsPath}", digest, payload)
        return 1
    let seed0CandFact = csg.RsiCsgCandidateFact("g0_seed", 0, 0, 0)
    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", seed0CandFact):
        return 2
    let seed0TrialFact = csg.RsiCsgTrialFact("g0_seed", 0, 0, d0Score,
                                             "correct")
    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", seed0TrialFact):
        return 2
    let seed1CandFact = csg.RsiCsgCandidateFact("g1_seed", 1, 0, 0)
    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", seed1CandFact):
        return 2
    let seed1TrialFact = csg.RsiCsgTrialFact("g1_seed", 1, 0, d1Score,
                                             "correct")
    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", seed1TrialFact):
        return 2
    let seed2CandFact = csg.RsiCsgCandidateFact("g2_seed",
                                                types.RsiTaskDomainGcd, 1, 0)
    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", seed2CandFact):
        return 2
    let seed2TrialFact = csg.RsiCsgTrialFact("g2_seed", types.RsiTaskDomainGcd,
                                             1, d2Score, "correct")
    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", seed2TrialFact):
        return 2
    let v0Fact = csg.RsiCsgVersionFact(0, "a", 0, 0, 0, d0Score, 0, 0,
                                       d1Score, 1, 0, d2Score, "none")
    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", v0Fact):
        return 2
    var genesisRoot: str
    var genesisRootOk: int32 = 0
    csg.RsiCsgRootInto(Fmt"{factsPath}", genesisRoot, genesisRootOk)
    if genesisRootOk != 1:
        return 2
    if !store.RsiStoreCommitVersion(Fmt"{storeDir}", 0, 0, 0, 0, d0Score, 0, 0,
                                    d1Score, 1, 0, d2Score, genesisRoot):
        return 2
    let d0ScoreText = strings.Int64ToStr(d0Score)
    let d1ScoreText = strings.Int64ToStr(d1Score)
    let d2ScoreText = strings.Int64ToStr(d2Score)
    let totalText = strings.Int64ToStr(d0Score + d1Score + d2Score)
    let payload = strutil.Join(["event=genesis_committed", "gen=0",
                                Fmt"d0_score={d0ScoreText}",
                                Fmt"d1_score={d1ScoreText}",
                                Fmt"d2_score={d2ScoreText}",
                                Fmt"score={totalText}"], " ")
    if !engineEmit(Fmt"{eventsPath}", digest, payload):
        return 3
    return 0

# 主入口 (批次七前兼容签名): 无 LLM 提案源, 行为与批次六逐字节一致。
fn RsiEngineRun(root: str, compilerPath: str, storeDir: str, workDir: str,
                budget: types.RsiBudget): int32 =
    return RsiEngineRunSources(Fmt"{root}", Fmt"{compilerPath}",
                               Fmt"{storeDir}", Fmt"{workDir}", budget, "", "")

# 提案源全量入口: 提案源列表 = 改进器程序 M_g (恒在) + 外部 LLM 适配器
# (仅 llmEndpoint 非空时接线; 适配器 rc != 0 -> 引擎跳过该来源, 记账后
# 继续改进器提案; 合法提案走同一 engineEvaluatePicks 白名单+严格评价+
# 严格准入, 评价权与准入权完全留在引擎)。
fn RsiEngineRunSources(root: str, compilerPath: str, storeDir: str,
                       workDir: str, budget: types.RsiBudget,
                       llmEndpoint: str, llmModel: str): int32 =
    if !types.RsiBudgetValid(budget):
        return 3
    os.MkdirAll(Fmt"{storeDir}", 493)
    os.MkdirAll(Fmt"{workDir}", 493)
    let eventsPath = Fmt"{storeDir}/events.log"
    let factsPath = Fmt"{storeDir}/rsi.facts.jsonl"
    let factsText = os.ReadFile(Fmt"{factsPath}")
    if len(factsText) <= 0:
        let schemaFact = Fmt"{csg.RsiCsgSchemaFact}"
        os.WriteFile(Fmt"{factsPath}", schemaFact)
    var digest = types.RsiGenesisDigest()
    var chainLines: int32 = 0
    var tail: str
    store.RsiStoreVerifyChainInto(Fmt"{eventsPath}", chainLines, tail)
    if chainLines < 0:
        return 2
    digest = strings.CloneStr(Fmt"{tail}")

    var ok: int32 = 0
    var gen: int32 = 0
    var mStrategy: int32 = 0
    var d0S: int32 = 0
    var d0P: int32 = 0
    var d0Score: int64 = 0
    var d1S: int32 = 0
    var d1P: int32 = 0
    var d1Score: int64 = 0
    var d2S: int32 = 0
    var d2P: int32 = 0
    var d2Score: int64 = 0
    var parentScore: int64 = 0
    var loadedRoot: str
    # 代际自动升级 (批次八迁移): v2 在位版本 -> store 层字段级映射迁移 v3
    # 落盘 (facts/events 零改动, facts_root 原样); 已是 v3 为幂等 no-op。
    # 两代皆不可读时仅空账本 (事实 <= 1 行: 空或仅 schema fact) 允许
    # genesis; 有事实而不可读 = 账本损坏/代际未知, hard-fail 禁 genesis
    # 分叉 (判词 46: 重复 tag 撞 DAG)。
    var migratedFlag: int32 = 0
    var migrateOk: int32 = 0
    store.RsiStoreMigrateV2ToV3Into(Fmt"{storeDir}", migratedFlag, migrateOk)
    if migrateOk != 1:
        var factCount0: int32 = 0
        csg.RsiCsgFactCountInto(Fmt"{factsPath}", factCount0)
        if factCount0 > 1:
            echo("rsi_engine: FAIL ledger unreadable in both schemas (genesis fork forbidden)")
            return 3
        let grc = engineGenesis(Fmt"{root}", Fmt"{compilerPath}", Fmt"{workDir}",
                                Fmt"{storeDir}", budget, Fmt"{eventsPath}",
                                Fmt"{factsPath}", digest)
        if grc != 0:
            return 1
    if migratedFlag == 1:
        let migPayload = "event=store_migrated_v2_v3"
        if !engineEmit(Fmt"{eventsPath}", digest, migPayload):
            return 3
        echo("rsi_engine: store schema migrated v2->v3 (facts untouched)")
    engineLoadVersion(Fmt"{storeDir}", ok, gen, mStrategy, d0S, d0P, d0Score,
                      d1S, d1P, d1Score, d2S, d2P, d2Score, parentScore,
                      loadedRoot)
    if ok != 1:
        return 3
    let startScoreText = strings.Int64ToStr(parentScore)
    echo(Fmt"rsi_engine start gen={gen} d0={d0S}/{d0P} d1={d1S}/{d1P} d2={d2S}/{d2P} m={mStrategy} score={startScoreText}")

    var trials: state.RsiTrialTable
    trials.trialCount = 0
    for round in 1..<budget.maxGenerations + 1:
        if !execution.RsiCleanWorkDir(Fmt"{workDir}"):
            return 4
        # 每轮从已提交版本出发 (同起点)。
        engineLoadVersion(Fmt"{storeDir}", ok, gen, mStrategy, d0S, d0P,
                          d0Score, d1S, d1P, d1Score, d2S, d2P, d2Score,
                          parentScore, loadedRoot)
        if ok != 1:
            return 3
        # 模型状态从 CSG 图重放重建 (无隐藏状态), 快照入图作可解释锚点。
        var modelTable: model.RsiModelTable
        model.RsiModelTableInit(modelTable)
        var modelLoadOk: int32 = 0
        csg.RsiCsgLoadModelInto(Fmt"{factsPath}", modelTable, modelLoadOk)
        if modelLoadOk != 1:
            return 3
        var tableTextVar: str
        model.RsiModelTableTextInto(modelTable, tableTextVar)
        var modelSeq: int32 = 0
        csg.RsiCsgFactCountInto(Fmt"{factsPath}", modelSeq)
        let modelFactLine = csg.RsiCsgModelFact(modelSeq, Fmt"{tableTextVar}")
        if !csg.RsiCsgAppendFact(Fmt"{factsPath}", modelFactLine):
            return 3
        var picksD: int32[]
        var picksS: int32[]
        var picksP: int32[]
        let imprTag = Fmt"m{round}"
        let imprRc = engineRunImprover(Fmt"{root}", Fmt"{compilerPath}",
                                       Fmt"{workDir}", budget, mStrategy, imprTag,
                                       Fmt"{tableTextVar}",
                                       picksD, picksS, picksP)
        if imprRc == 0:
            # 额外提案源: 外部 LLM 适配器 (仅 --llm-endpoint 接线时)。
            # rc != 0 = 跳过该来源 (记账后继续); rc = 0 = 合法提案并入
            # 本轮候选, 与改进器提案走同一评价/准入管线。畸形/越白名单
            # 提案已在适配器内丢弃计数, 永不进评价。
            if len(llmEndpoint) > 0:
                var llmD: int32[]
                var llmS: int32[]
                var llmP: int32[]
                var llmDropped: int32 = 0
                let llmRc: int32 = adapter.RsiGeneratorAdapterProposeInto(
                    Fmt"{llmEndpoint}", Fmt"{llmModel}", Fmt"{tableTextVar}",
                    budget.maxCandidates, llmD, llmS, llmP, llmDropped)
                let llmCount: int32 = llmS.len
                let llmCountText: str = strings.IntToStr(llmCount)
                let llmDropText: str = strings.IntToStr(llmDropped)
                if llmRc == 0:
                    for i in 0..<llmCount:
                        let dv: int32 = llmD[i]
                        let sv: int32 = llmS[i]
                        let pv: int32 = llmP[i]
                        add(picksD, dv)
                        add(picksS, sv)
                        add(picksP, pv)
                    let llmPayload = strutil.Join(["event=llm_source_proposals",
                                                   Fmt"gen={gen}",
                                                   Fmt"count={llmCountText}",
                                                   Fmt"dropped={llmDropText}"], " ")
                    if !engineEmit(Fmt"{eventsPath}", digest, llmPayload):
                        return 3
                else:
                    let llmRcText: str = strings.IntToStr(llmRc)
                    let llmSkipPayload = strutil.Join(["event=llm_source_skipped",
                                                       Fmt"gen={gen}",
                                                       Fmt"phase={llmRcText}"], " ")
                    if !engineEmit(Fmt"{eventsPath}", digest, llmSkipPayload):
                        return 3
            var bestScore: int64 = -1
            var bestDomain: int32 = 0
            var bestStrategy: int32 = 0
            var bestParam: int32 = 0
            var bestDomainScore: int64 = 0
            var bestRow: int32 = -1
            var bestTag: str
            if !engineEvaluatePicks(Fmt"{root}", Fmt"{compilerPath}",
                                    Fmt"{workDir}", budget, picksD, picksS,
                                    picksP, d0Score, d1Score, d2Score,
                                    Fmt"{eventsPath}", digest, trials, round,
                                    types.RsiChangeTask, Fmt"{factsPath}",
                                    modelTable,
                                    bestScore, bestDomain, bestStrategy,
                                    bestParam, bestDomainScore, bestRow,
                                    bestTag):
                return 3
            if bestRow < 0:
                let payload = strutil.Join(["event=generation_no_correct_candidate",
                                            Fmt"gen={gen}"], " ")
                if !engineEmit(Fmt"{eventsPath}", digest, payload):
                    return 3
            else:
                # A-准入按聚合分 (child<parent 严格)。
                let admit = evaluator.RsiAdmissionForDomain(types.RsiDomainTask,
                                                            true, bestScore,
                                                            parentScore)
                if admit == types.RsiAdmitAccept:
                    # 更新变更域在位 (s,p,score), 另一域账本不动, 聚合重算。
                    var newD0S: int32 = d0S
                    var newD0P: int32 = d0P
                    var newD0Score: int64 = d0Score
                    var newD1S: int32 = d1S
                    var newD1P: int32 = d1P
                    var newD1Score: int64 = d1Score
                    var newD2S: int32 = d2S
                    var newD2P: int32 = d2P
                    var newD2Score: int64 = d2Score
                    if bestDomain == 0:
                        newD0S = bestStrategy
                        newD0P = bestParam
                        newD0Score = bestDomainScore
                    else:
                        if bestDomain == 1:
                            newD1S = bestStrategy
                            newD1P = bestParam
                            newD1Score = bestDomainScore
                        else:
                            newD2S = bestStrategy
                            newD2P = bestParam
                            newD2Score = bestDomainScore
                    var rootPre: str
                    var rootPreOk: int32 = 0
                    csg.RsiCsgRootInto(Fmt"{factsPath}", rootPre, rootPreOk)
                    if rootPreOk != 1:
                        return 3
                    let vFact = csg.RsiCsgVersionFact(gen + 1, "a", mStrategy,
                                                      newD0S, newD0P,
                                                      newD0Score, newD1S,
                                                      newD1P, newD1Score,
                                                      newD2S, newD2P,
                                                      newD2Score,
                                                      rootPre)
                    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", vFact):
                        return 3
                    var rootPost: str
                    var rootPostOk: int32 = 0
                    csg.RsiCsgRootInto(Fmt"{factsPath}", rootPost, rootPostOk)
                    if rootPostOk != 1:
                        return 3
                    if !store.RsiStoreCommitVersion(Fmt"{storeDir}", gen + 1,
                                                    mStrategy, newD0S, newD0P,
                                                    newD0Score, newD1S, newD1P,
                                                    newD1Score, newD2S,
                                                    newD2P, newD2Score,
                                                    rootPost):
                        return 3
                    if bestRow >= 0 && bestRow < trials.trialCount:
                        let stAccept = trials.state[bestRow]
                        if types.RsiTransitionLegal(stAccept, types.RsiTrialAccepted):
                            state.RsiTrialWriteState(trials, bestRow,
                                                     types.RsiTrialAccepted,
                                                     bestScore)
                    let bestText = strings.Int64ToStr(bestScore)
                    let parentText = strings.Int64ToStr(parentScore)
                    let payload = strutil.Join(["event=version_accepted",
                                                Fmt"gen={gen + 1}",
                                                Fmt"task_domain={bestDomain}",
                                                Fmt"d0_strategy={newD0S}",
                                                Fmt"d0_param={newD0P}",
                                                Fmt"d1_strategy={newD1S}",
                                                Fmt"d1_param={newD1P}",
                                                Fmt"d2_strategy={newD2S}",
                                                Fmt"d2_param={newD2P}",
                                                Fmt"m_strategy={mStrategy}",
                                                Fmt"score={bestText}",
                                                Fmt"parent_score={parentText}"], " ")
                    if !engineEmit(Fmt"{eventsPath}", digest, payload):
                        return 3
                    var dseq: int32 = 0
                    csg.RsiCsgFactCountInto(Fmt"{factsPath}", dseq)
                    let dFact = csg.RsiCsgDecisionFact(dseq, "accept",
                                                       Fmt"{bestTag}")
                    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", dFact):
                        return 3
                    gen = gen + 1
                    d0S = newD0S
                    d0P = newD0P
                    d0Score = newD0Score
                    d1S = newD1S
                    d1P = newD1P
                    d1Score = newD1Score
                    d2S = newD2S
                    d2P = newD2P
                    d2Score = newD2Score
                    parentScore = bestScore
                    echo(Fmt"rsi_engine accepted gen={gen} d0={d0S}/{d0P} d1={d1S}/{d1P} d2={d2S}/{d2P} score={bestText}")
                else:
                    if bestRow >= 0 && bestRow < trials.trialCount:
                        let stReject = trials.state[bestRow]
                        if types.RsiTransitionLegal(stReject, types.RsiTrialRejected):
                            state.RsiTrialWriteState(trials, bestRow,
                                                     types.RsiTrialRejected,
                                                     bestScore)
                    let bestText = strings.Int64ToStr(bestScore)
                    let parentText = strings.Int64ToStr(parentScore)
                    let payload = strutil.Join(["event=version_rejected",
                                                Fmt"gen={gen}",
                                                Fmt"best_score={bestText}",
                                                Fmt"parent_score={parentText}"], " ")
                    if !engineEmit(Fmt"{eventsPath}", digest, payload):
                        return 3
                    var dseq: int32 = 0
                    csg.RsiCsgFactCountInto(Fmt"{factsPath}", dseq)
                    let dFact = csg.RsiCsgDecisionFact(dseq, "reject",
                                                       Fmt"{bestTag}")
                    if !csg.RsiCsgAppendFact(Fmt"{factsPath}", dFact):
                        return 3

            # M-元评价 (一次前瞻): M' 与 M_g 同起点同预算各产生后继,
            # M' 后继聚合分严格更优才接受 M 变更; 后继只评价, 不再递归。
            if budget.metaEnabled == 1 && bestRow >= 0:
                let mCandidate = (mStrategy + 1) % (types.RsiMetaStrategyMax + 1)
                var picksD2: int32[]
                var picksS2: int32[]
                var picksP2: int32[]
                let imprTag2 = Fmt"m{round}p"
                let tableText2 = Fmt"{tableTextVar}"
                let imprRc2 = engineRunImprover(Fmt"{root}", Fmt"{compilerPath}",
                                                Fmt"{workDir}", budget, mCandidate,
                                                imprTag2, tableText2,
                                                picksD2, picksS2, picksP2)
                if imprRc2 == 0:
                    var best2Score: int64 = -1
                    var best2Domain: int32 = 0
                    var best2Strategy: int32 = 0
                    var best2Param: int32 = 0
                    var best2DomainScore: int64 = 0
                    var best2Row: int32 = -1
                    var best2Tag: str
                    if !engineEvaluatePicks(Fmt"{root}", Fmt"{compilerPath}",
                                            Fmt"{workDir}", budget, picksD2,
                                            picksS2, picksP2, d0Score, d1Score,
                                            d2Score,
                                            Fmt"{eventsPath}", digest, trials,
                                            round, types.RsiChangeMeta,
                                            Fmt"{factsPath}", modelTable,
                                            best2Score, best2Domain,
                                            best2Strategy, best2Param,
                                            best2DomainScore, best2Row,
                                            best2Tag):
                        return 3
                    if best2Row >= 0:
                        # 候选 A 不低于父代 (本轮接受后 parentScore 即最优聚合分)。
                        let aQualified = bestScore <= parentScore
                        # 前瞻预算配对账本接线 (提案 §5 步5「所有前瞻开销计入
                        # 预算」): 每臂子预算 = 1 次改进器编译运行 +
                        # maxCandidates 次后继候选编译运行 (由
                        # RsiLookaheadPerArmUnits 派生); 两臂按本轮实际编译
                        # 运行的后继候选数逐笔记账 —— 父代臂 = 本轮改进器
                        # (上已跑) + 本轮实际评价的后继候选 (含 LLM 适配器
                        # 追加的提案), 候选臂 = M' 改进器 + 其后继候选。
                        # 超支硬拒不截断; 两臂未同额耗尽 = 对照无效 ->
                        # 不得接受 M 变更 (与旧入口唯一行为差别)。
                        let perArmUnits = promotion.RsiLookaheadPerArmUnits(
                            budget.maxCandidates)
                        var laLedger: promotion.RsiLookaheadLedger
                        promotion.RsiLookaheadLedgerInitInto(perArmUnits,
                                                             laLedger)
                        var laCharged: int32 = 0
                        let parentSuccUnits: int64 = int64(picksS.len)
                        let candSuccUnits: int64 = int64(picksS2.len)
                        promotion.RsiLookaheadChargeInto(
                            laLedger, promotion.RsiLookaheadArmParent, int64(1),
                            laCharged)
                        promotion.RsiLookaheadChargeInto(
                            laLedger, promotion.RsiLookaheadArmParent,
                            parentSuccUnits, laCharged)
                        promotion.RsiLookaheadChargeInto(
                            laLedger, promotion.RsiLookaheadArmCandidate,
                            int64(1), laCharged)
                        promotion.RsiLookaheadChargeInto(
                            laLedger, promotion.RsiLookaheadArmCandidate,
                            candSuccUnits, laCharged)
                        let parentUnits =
                            promotion.RsiLookaheadParentSpent(laLedger)
                        let lookUnits =
                            promotion.RsiLookaheadLookaheadSpent(laLedger)
                        let perArmText = strings.Int64ToStr(perArmUnits)
                        let parentUnitsText = strings.Int64ToStr(parentUnits)
                        let lookUnitsText = strings.Int64ToStr(lookUnits)
                        let metaAdmit = promotion.RsiMetaPromotionDecideBudgeted(
                            aQualified, bestScore, best2Score, laLedger)
                        if metaAdmit == types.RsiAdmitAccept:
                            var metaRootPre: str
                            var metaRootPreOk: int32 = 0
                            csg.RsiCsgRootInto(Fmt"{factsPath}", metaRootPre,
                                               metaRootPreOk)
                            if metaRootPreOk != 1:
                                return 3
                            let metaFact = csg.RsiCsgVersionFact(gen + 1, "meta",
                                                                 mCandidate,
                                                                 d0S, d0P,
                                                                 d0Score, d1S,
                                                                 d1P, d1Score,
                                                                 d2S, d2P,
                                                                 d2Score,
                                                                 metaRootPre)
                            if !csg.RsiCsgAppendFact(Fmt"{factsPath}", metaFact):
                                return 3
                            var metaRootPost: str
                            var metaRootPostOk: int32 = 0
                            csg.RsiCsgRootInto(Fmt"{factsPath}", metaRootPost,
                                               metaRootPostOk)
                            if metaRootPostOk != 1:
                                return 3
                            if !store.RsiStoreCommitVersion(Fmt"{storeDir}",
                                                            gen + 1, mCandidate,
                                                            d0S, d0P, d0Score,
                                                            d1S, d1P, d1Score,
                                                            d2S, d2P, d2Score,
                                                            metaRootPost):
                                return 3
                            let pBestText = strings.Int64ToStr(bestScore)
                            let cBestText = strings.Int64ToStr(best2Score)
                            let payload = strutil.Join(["event=meta_accepted",
                                                        Fmt"gen={gen + 1}",
                                                        Fmt"m_strategy={mCandidate}",
                                                        Fmt"m_parent_best={pBestText}",
                                                        Fmt"m_candidate_best={cBestText}",
                                                        Fmt"per_arm_units={perArmText}",
                                                        Fmt"parent_units={parentUnitsText}",
                                                        Fmt"candidate_units={lookUnitsText}"], " ")
                            if !engineEmit(Fmt"{eventsPath}", digest, payload):
                                return 3
                            var dseq: int32 = 0
                            csg.RsiCsgFactCountInto(Fmt"{factsPath}", dseq)
                            let dFact = csg.RsiCsgDecisionFact(dseq, "accept",
                                                               Fmt"{best2Tag}")
                            if !csg.RsiCsgAppendFact(Fmt"{factsPath}", dFact):
                                return 3
                            gen = gen + 1
                            mStrategy = mCandidate
                            echo(Fmt"rsi_engine meta accepted gen={gen} m={mCandidate}")
                        else:
                            let pBestText = strings.Int64ToStr(bestScore)
                            let cBestText = strings.Int64ToStr(best2Score)
                            # 账本不全 (对照无效) 与真实不占优分开记: 前者是
                            # 预算证据缺失, 后者是严格更优判据不成立; 两者都
                            # 落同一条 reject 决策事实 (试验不留未决)。
                            var metaEvent: str = "event=meta_rejected"
                            if metaAdmit == promotion.RsiMetaComparisonInvalid:
                                metaEvent = "event=meta_comparison_invalid"
                            let payload = strutil.Join([Fmt"{metaEvent}",
                                                        Fmt"gen={gen}",
                                                        Fmt"m_parent_best={pBestText}",
                                                        Fmt"m_candidate_best={cBestText}",
                                                        Fmt"per_arm_units={perArmText}",
                                                        Fmt"parent_units={parentUnitsText}",
                                                        Fmt"candidate_units={lookUnitsText}"], " ")
                            if !engineEmit(Fmt"{eventsPath}", digest, payload):
                                return 3
                            var dseq: int32 = 0
                            csg.RsiCsgFactCountInto(Fmt"{factsPath}", dseq)
                            let dFact = csg.RsiCsgDecisionFact(dseq, "reject",
                                                               Fmt"{best2Tag}")
                            if !csg.RsiCsgAppendFact(Fmt"{factsPath}", dFact):
                                return 3
        else:
            let payload = strutil.Join(["event=improver_failed",
                                        Fmt"gen={gen}",
                                        Fmt"m_strategy={mStrategy}",
                                        Fmt"phase={imprRc}"], " ")
            if !engineEmit(Fmt"{eventsPath}", digest, payload):
                return 3
    var pending: int32 = 0
    state.RsiTrialPendingCountInto(trials, pending)
    # 收尾根同步: 版本提交后若仍有评价事实追加 (同轮 meta 后继/拒收试验),
    # 账本根必须锚定最终图态, 与 verify 重放的 R1 全集根口径一致。
    var finalRoot: str
    var finalRootOk: int32 = 0
    csg.RsiCsgRootInto(Fmt"{factsPath}", finalRoot, finalRootOk)
    if finalRootOk != 1:
        return 3
    if !store.RsiStoreCommitVersion(Fmt"{storeDir}", gen, mStrategy, d0S, d0P,
                                    d0Score, d1S, d1P, d1Score, d2S, d2P,
                                    d2Score, finalRoot):
        return 3
    # 收尾清场: 末轮候选/改进器产物不跨任务驻留 (尽力删除, 失败不掩终态,
    # 残留由下轮清场与外层 scratch 生命周期兜底)。
    let _finalClean = execution.RsiCleanWorkDir(Fmt"{workDir}")
    let finalScoreText = strings.Int64ToStr(parentScore)
    var resolvedCount: int32 = 0
    var decisionCount: int32 = 0
    var failedCount: int32 = 0
    csg.RsiCsgCountKindInto(Fmt"{factsPath}", "csg.rsi.decision", decisionCount)
    csg.RsiCsgCountTrialVerdictInto(Fmt"{factsPath}", "failed", failedCount)
    resolvedCount = decisionCount + failedCount
    let resolvedText = strings.IntToStr(resolvedCount)
    let trialTotalText = strings.IntToStr(trials.trialCount)
    echo(Fmt"rsi_engine done trials={trials.trialCount} pending={pending} gen={gen} score={finalScoreText} resolved={resolvedText}/{trialTotalText}")
    return 0
