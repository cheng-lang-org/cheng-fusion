# 纯 Cheng RSI 框架: 提升决策 (提案第5步)。
# A-变更: 全部必过任务正确且聚合分严格优于父代才推进。
# M-变更 (递归对象): 候选 A 必须不低于父代, 且同起点同预算一次前瞻中
# 候选改进器 M' 产生的后继聚合分严格优于当前改进器 M 的后继;
# 仅靠 A 提分不能接受退化或平分的 M。前瞻只评价后继, 不再递归启动
# 后继的改进器准入 (一次前瞻终点, 避免无限递归)。
# 前瞻预算记账 (提案 §5 步5 验收「所有前瞻开销计入预算」): 一次前瞻 =
# 两配对臂 (父代对照 M / 候选 M'), 每臂开销 = 1 次改进器编译运行 +
# maxCandidates 次后继候选编译运行; 两臂获得相同子预算 perArmUnits。
# 账本把两臂开销都计入总预算 (total = parent + candidate), 前瞻臂不免费:
# 带账本裁决要求两臂各耗尽同额子预算才有效 (同起点同预算对照), 否则
# 对照无效 -> RsiMetaComparisonInvalid, 不接受推进。
# 审计口径 (2026-09-10 立项, 批次九接线): engine.cheng 前瞻块 (M' 改进器 +
# 后继评价) 此前只落 trials/facts 记账; 现已接入本账本 —— 每臂 charge 1 次
# 改进器编译运行 + 每次后继候选编译运行 charge 1, 子预算由
# RsiLookaheadPerArmUnits 从 maxCandidates 派生。旧判词入口
# RsiMetaPromotionDecide 保留 (无账本 = 无预算证据), 引擎生产裁决一律走
# RsiMetaPromotionDecideBudgeted: 两臂未同额耗尽 = 对照无效, 不得接受。
import cheng/rsi/types as types

# M-试验元评价决策: parentBest = 当前 M 的后继最优分, candidateBest = M' 的。
fn RsiMetaPromotionDecide(candidateAQualified: bool, parentBest: int64,
                          candidateBest: int64): int32 =
    if !candidateAQualified:
        return types.RsiAdmitReject
    if candidateBest < parentBest:
        return types.RsiAdmitAccept
    return types.RsiAdmitReject

const
    # 配对臂: 0 = 父代对照臂 (M), 1 = 候选臂 (M' = 前瞻开销)。
    RsiLookaheadArmParent = 0
    RsiLookaheadArmCandidate = 1
    # 对照无效判词: 两臂未同额耗尽子预算 (非同预算对照) -> 不得接受。
    RsiMetaComparisonInvalid = 2

# 一次前瞻的配对预算账本 (三 int64, 小结构按值传递, 同 types.RsiBudget)。
# perArmUnits = 每臂子预算 (两臂相等); parentUnits/candidateUnits = 已计开销。
type
    RsiLookaheadLedger =
        perArmUnits: int64
        parentUnits: int64
        candidateUnits: int64

# 每臂子预算的唯一派生点 (批次九引擎接线): 1 次改进器编译运行 +
# maxCandidates 次后继候选编译运行。引擎前瞻块与合同冒烟共用本函数,
# 约定不靠两处字面量各写一份 (改预算口径只需改这里)。
fn RsiLookaheadPerArmUnits(maxCandidates: int32): int64 =
    assert(maxCandidates > 0,
           "rsi lookahead: max candidates must be positive")
    return int64(maxCandidates) + int64(1)

fn RsiLookaheadLedgerInitInto(perArmUnits: int64,
                              outLedger: var RsiLookaheadLedger) =
    # 预算必须为正且有限 (提案 §5: 预算为零不是合法状态)。
    assert(perArmUnits > int64(0),
           "rsi lookahead: per-arm sub-budget must be positive")
    outLedger.perArmUnits = perArmUnits
    outLedger.parentUnits = int64(0)
    outLedger.candidateUnits = int64(0)

# 记一笔开销到指定臂: 臂越界 / units <= 0 / 超该臂子预算 / 超总预算
# (2 x perArm) 一律 outOk = 0 且不落账 (不截断、不丢弃、不兜底)。
fn RsiLookaheadChargeInto(l: var RsiLookaheadLedger, arm: int32, units: int64,
                          outOk: var int32) =
    outOk = 0
    if units <= int64(0):
        return
    if l.perArmUnits <= int64(0):
        return
    if arm == RsiLookaheadArmParent:
        let next = l.parentUnits + units
        if next > l.perArmUnits:
            return
        if next + l.candidateUnits > l.perArmUnits * int64(2):
            return
        l.parentUnits = next
        outOk = 1
        return
    if arm == RsiLookaheadArmCandidate:
        let nextC = l.candidateUnits + units
        if nextC > l.perArmUnits:
            return
        if l.parentUnits + nextC > l.perArmUnits * int64(2):
            return
        l.candidateUnits = nextC
        outOk = 1
        return

fn RsiLookaheadParentSpent(l: RsiLookaheadLedger): int64 =
    return l.parentUnits

# 前瞻开销 (候选臂) 单独可观测: 证明它不是总预算之外的白送工作量。
fn RsiLookaheadLookaheadSpent(l: RsiLookaheadLedger): int64 =
    return l.candidateUnits

# 总预算已耗 = 两臂合计 (前瞻开销在内)。
fn RsiLookaheadTotalSpent(l: RsiLookaheadLedger): int64 =
    return l.parentUnits + l.candidateUnits

# 带预算账本的元评价裁决: 先要求对照有效 (两臂各耗尽同额子预算),
# 再套用与 RsiMetaPromotionDecide 完全相同的严格更优判词。
fn RsiMetaPromotionDecideBudgeted(candidateAQualified: bool,
                                  parentBest: int64, candidateBest: int64,
                                  ledger: RsiLookaheadLedger): int32 =
    if !candidateAQualified:
        return types.RsiAdmitReject
    if ledger.perArmUnits <= int64(0):
        return RsiMetaComparisonInvalid
    if ledger.parentUnits != ledger.perArmUnits:
        return RsiMetaComparisonInvalid
    if ledger.candidateUnits != ledger.perArmUnits:
        return RsiMetaComparisonInvalid
    return RsiMetaPromotionDecide(candidateAQualified, parentBest,
                                  candidateBest)
