# 纯 Cheng RSI 框架: 核心合同常量与纯函数 (提案 openspec/proposals/pure-cheng-rsi.md 第1步)。
# 本模块零 IO、零进程、零状态: 只固化不可变合同, 供 state/store/engine 与合同冒烟消费。
# 实现契约:
#   - 含 str 字段的结构体禁止入 seq (src/game/ecs.cheng 卷首警示, fishing_gate W-A1-8 SIGBUS);
#     本模块导出的 RsiBudget 仅含 int 字段, 安全。
#   - 分数语义: compares 计数, 越小越好; 一切提升判定必须严格不等, 平分不推进。
import std/strings as strings

const
    RsiSchema = "cheng.rsi.framework.v1"
    RsiVersionLine = "cheng.rsi.version.v1"
    RsiGenesisSeed = "cheng.rsi.genesis.v1"

    # 改进目标域。DomainCompiler 的 C1/C2 白名单已定义 (批次四), 但载具级
    # A/B 仍 BLOCKED@kernel; GEN2/GEN3 字节固定点降为发布级, 不是试验前置。
    # 评价侧在解锁前恒 blocked, 不产出假绿。
    RsiDomainTask = 0
    RsiDomainCompiler = 1

    # 试验状态机: Proposed -> Admitted -> Built -> Evaluated -> Accepted/Rejected;
    # 编译/运行失败 -> Failed; 守卫终止/评价器故障/控制器中断 -> Aborted。
    # 只有 Accepted 推进当前版本; 终态不可再流转。
    RsiTrialProposed = 0
    RsiTrialAdmitted = 1
    RsiTrialBuilt = 2
    RsiTrialEvaluated = 3
    RsiTrialAccepted = 4
    RsiTrialRejected = 5
    RsiTrialFailed = 6
    RsiTrialAborted = 7

    # 变更种类: 改任务执行器 A, 或改改进器 M 本身 (递归对象)。
    RsiChangeTask = 0
    RsiChangeMeta = 1

    # 任务域白名单 (v4 三任务域扩展, 26 -> 31 格): A 的空间 =
    # (taskDomain, s, p) 三元。域 0 = 排序 (7 族 x 3 param = 21 格,
    # s6 = 快速排序, param = 基准选取档 0 首/1 尾/2 三数取中); 域 1 =
    # 逆序对计数 (5 族 x 1 param = 5 格, s4 = 分块宽 4); 域 3 = 数论
    # GCD (5 族 x 1 param = 5 格, s4 = 扩展欧几里得; 域 2 = 编译器域
    # 保留号)。总 31 格。聚合分 = 三域分之和, 候选试验只编译变更域,
    # 另两域取账本在位分。新格分数可分性论证见
    # docs/campaigns/2026-09-07-pure-cheng-rsi/task_domain_v4_proposal.md。
    RsiTaskDomainCount = 3
    RsiDomain0StrategyMax = 6
    RsiDomain0ParamMax = 2
    RsiDomain1StrategyMax = 4
    RsiDomain1ParamMax = 0
    RsiTaskDomainGcd = 3
    RsiDomain3StrategyMax = 4
    RsiDomain3ParamMax = 0
    # 观测表 cell 号布局: 域 0 -> 0..6; 域 1 -> 7..11 (基 = 域 0 族数,
    # 公式自动派生); 12..13 为编译器域保留号 (任务域观测永不入位);
    # 域 3 -> 14..18 (基 14 不变); 表容量 = 19。
    RsiModelCellBaseGcd = 14
    RsiModelCellSpan = 19
    # 兼容别名 (域 0 旧名, 供既有引用逐步迁移)。
    RsiTaskStrategyMax = 6
    RsiTaskParamMax = 2
    # 改进器策略白名单: 0 = 顺序枚举, 1..3 = 白盒观测表界排序 (界公式按档位),
    # 4 = 全枚举 (界排序 + param 轮转, 覆盖能力 22/22 可达)。
    RsiMetaStrategyMax = 4

# 编译器域 C1/C2 试验合同 (批次四): 变更空间 = 构建参数档三元
# (compilerDomain=2, jobs 档, 语料档)。jobs 档 0/1/2 -> BACKEND_JOBS
# 1/2/4; 语料档为索引 0..3, 开放门档 0/1 (档 1 于 2026-09-13 T1 根修后
# 开放; 见 RsiCompilerCorpusOpen),
# 路径见 RsiCompilerCorpusRel。正确性锚 = 语义指纹 (产物运行 rc+stdout
# sha; 产物字节 sha 因 Mach-O 每进程随机 uuid 不可用, map sha 仅记账);
# C1 计分 = 编译器自报 exec_phase_total_us (微秒确定性相位; best-of-5
# 容 1 败取 min, 成功烤语义指纹必须全等); C2 记账 = guard
# process_tree_resident_peak_bytes (per-corpus 冻结基线, 帽=基线 x 3/2)。
# 源码级变更不在本批。冻结合同见
# docs/campaigns/2026-09-07-pure-cheng-rsi/compiler_domain_c1c2_contract.md。
const
    RsiCompilerDomain = 2
    RsiCompilerJobsMax = 2
    # 语料索引空间 0..3 (B1/合同 corpus_tier3_contract.md §6.2 S2: 2->3)。
    # 档 3 = 234 源全量自烤, 载体与档 2 同入口 (合同 §1.5); 语料 = 该入口在
    # 真实编译 (system-link-exec) 下实际打开并解析的源全集 (真实 plan 闭包),
    # 不是 dry-compile 扫描闭包。234 是"当前树的闭包计数"不是内容常量:
    # 行数/字节/根 CID 随树漂移 (合同 §1.2), 计数由载具报告字段发射。
    RsiCompilerCorpusMax = 3
    RsiCompilerCorpusTier3 = 3
    RsiCompilerCorpusDispatchMinRel = "src/core/tooling/backend_driver_dispatch_min.cheng"

fn RsiCompilerJobsOf(jobsTier: int32): int32 =
    if jobsTier == 0:
        return 1
    if jobsTier == 1:
        return 2
    return 4

# 语料档 (2026-09-09 C 链解锁后三修; 以本函数为准):
#   档 0 = src/tests/rsi_minimal_smoke.cheng (唯一开放档; 纯 std 闭包,
#           stage3 多轮绿+rc0 语义锚, CID ef548daabeee75a981eb880336ed7
#           f34f2379bf12f8dd543fd894a844d4b667a);
#   档 1 = src/tests/physics2d_determinism_smoke.cheng (2026-09-13 T1 线
#           根修后开放, commit 601c79e70: 源侧 use-after-move 定谳, ecs 14
#           只读查询+physics2d 5 处标 @borrows, 零编译器改动; 入口文件未动,
#           闭包变更行为等价 receiptCid 不变, smoke compile=0/run=0);
#   档 2 = src/core/tooling/backend_driver_dispatch_min.cheng (BLOCKED:
#           GEN2 覆盖墙 identity.cheng parser=7, 判词移交);
#   档 3 = 同入口 的 234 源全量自烤 (B1/合同 corpus_tier3_contract.md; 现
#           BLOCKED@kernel: 真默认门下并林 136/234 且树峰 839,353,592 B 超门,
#           合同 §0 四判据未成立)。
# 档 0 变更记录 (2026-09-08): 原 kernel 自烤档 (dispatch_min) 被 GEN2
# 管线墙阻塞 —— pure_driver 自烤撞 "compiler csg: parser-owned global
# coverage mismatch source=csg_core/identity.cheng parser=7 metadata=0"
# (kernel 战役热区, 本席不修, 判词移交); 换 physics2d 确定性 smoke
# (纯 std+game 闭包, kernel 载具可编, 产物 rc0 语义锚)。档 1 已于
# 2026-09-13 T1 根修后开放 (见上); 档 2 待 kernel 战役清墙后重新冻结;
# 语料门开放不等于载具级 A/B 解锁, 详见 compiler_domain_c1c2_contract.md。
fn RsiCompilerCorpusRel(corpusIdx: int32): str =
    if corpusIdx == 0:
        return "src/tests/rsi_minimal_smoke.cheng"
    if corpusIdx == 1:
        return "src/tests/physics2d_determinism_smoke.cheng"
    # 档 2 与档 3 同入口 (合同 §1.5): 差异在判据集, 不在入口源。
    return RsiCompilerCorpusDispatchMinRel

# 开放门: 档 0/1 开放 (档 1 = 2026-09-13 T1 线根修解锁, 见上方档 1 注)。
# 档 3 (234 源全量自烤) 的翻转硬前置 = 合同 §6.2 S1
# (真默认门下 §6.2 四判据 + §6.2.1 逐相贴线同时成立, 且该轮身份四元组已入
# receipts); 未满足前恒 false, 与档 2 同待遇。
# 档 3 的 CID 记录位 (合同 §1.4 P6): 冻结三元组 (cid, count, source_root,
# driver_sha, patch_sha) 以 receipts/events 身份行为准, 源码内不写死 CID 数值
# (合同 §1.2 根 CID 随树漂移; §10-7 档 0 记录值与文件当前内容关系未钉的教训);
# 运行期腿级冻结与 A/B 配对判词见 compiler_domain 的 RsiCdFreezeRecordWrite /
# RsiCdFreezePairVerdictInto。
fn RsiCompilerCorpusOpen(corpusIdx: int32): bool =
    return corpusIdx == 0 || corpusIdx == 1

# 任务域白名单查询: (taskDomain, strategy, param) 是否在格内。
fn RsiTaskCellValid(taskDomain: int32, strategy: int32, param: int32): bool =
    if taskDomain == 0:
        if strategy < 0 || strategy > RsiDomain0StrategyMax:
            return false
        if param < 0 || param > RsiDomain0ParamMax:
            return false
        return true
    if taskDomain == 1:
        if strategy < 0 || strategy > RsiDomain1StrategyMax:
            return false
        if param < 0 || param > RsiDomain1ParamMax:
            return false
        return true
    if taskDomain == RsiTaskDomainGcd:
        if strategy < 0 || strategy > RsiDomain3StrategyMax:
            return false
        if param < 0 || param > RsiDomain3ParamMax:
            return false
        return true
    return false

# 域内格子数 (覆盖审计用)。
fn RsiTaskDomainCellCount(taskDomain: int32): int32 =
    if taskDomain == 0:
        return (RsiDomain0StrategyMax + 1) * (RsiDomain0ParamMax + 1)
    if taskDomain == 1:
        return (RsiDomain1StrategyMax + 1) * (RsiDomain1ParamMax + 1)
    if taskDomain == RsiTaskDomainGcd:
        return (RsiDomain3StrategyMax + 1) * (RsiDomain3ParamMax + 1)
    return 0

const
    # 域准入判定的三值结果。
    RsiAdmitAccept = 1
    RsiAdmitReject = 0
    RsiAdmitBlocked = -1

type
    RsiBudget =
        maxGenerations: int32
        maxCandidates: int32
        compileTimeoutSec: int32
        runTimeoutSec: int32
        metaEnabled: int32

# 预算必须全为正且有限 (提案 §4: 预算耗尽是正常终止, 不制造成功)。
fn RsiBudgetValid(b: RsiBudget): bool =
    if b.maxGenerations < 1 || b.maxGenerations > 64:
        return false
    if b.maxCandidates < 1 || b.maxCandidates > 8:
        return false
    if b.compileTimeoutSec < 30 || b.compileTimeoutSec > 900:
        return false
    if b.runTimeoutSec < 5 || b.runTimeoutSec > 300:
        return false
    if b.metaEnabled < 0 || b.metaEnabled > 1:
        return false
    return true

# 状态转换合法表。Aborted 可从任何非终态进入 (控制器中断/守卫终止)。
fn RsiTrialTerminal(state: int32): bool =
    if state == RsiTrialAccepted:
        return true
    if state == RsiTrialRejected:
        return true
    if state == RsiTrialFailed:
        return true
    if state == RsiTrialAborted:
        return true
    return false

fn RsiTransitionLegal(fromState: int32, toState: int32): bool =
    if RsiTrialTerminal(fromState):
        return false
    if toState == RsiTrialAborted:
        return true
    if fromState == RsiTrialProposed && toState == RsiTrialAdmitted:
        return true
    if fromState == RsiTrialAdmitted && toState == RsiTrialBuilt:
        return true
    if fromState == RsiTrialBuilt && toState == RsiTrialEvaluated:
        return true
    if fromState == RsiTrialBuilt && toState == RsiTrialFailed:
        return true
    if fromState == RsiTrialEvaluated && toState == RsiTrialAccepted:
        return true
    if fromState == RsiTrialEvaluated && toState == RsiTrialRejected:
        return true
    return false

# 创世链摘要: 哈希链的链首由本常量派生, 不依赖任何运行观测。
@borrows
fn RsiGenesisDigest(): str =
    return strings.Sha256(RsiGenesisSeed)
