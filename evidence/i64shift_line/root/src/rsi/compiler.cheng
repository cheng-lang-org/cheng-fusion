# 纯 Cheng RSI 框架: 冻结的编译入口 (提案第3步)。
# 唯一编译通道 = system-link-exec --emit:exe --target:arm64-apple-darwin,
# argv 直传不拼 shell; 编译器身份由调用方 (rsi_gate) 哈希绑定, 本模块不改写。
import std/os as os
import std/os_host_process as hostos
import std/strings as strings
import std/strutils as strutil

@borrows
fn RsiCompileCheng(compilerPath: str, root: str, sourcePath: str,
                   outPath: str, timeoutSec: int32,
                   envOverrides: str[]): int32 =
    # argv 只能字面量直排: add() 构造的数组传参 live=0 被拒
    # (fishing_gate runCompile 同构先例)。envOverrides 则走 var+add 局部表先例
    # (core/tooling/compiler_csg.cheng CompilerCsgClone*Seq、
    # core/tooling/backend_driver_dispatch_min.cheng:3998-4003)。
    # A9b 前置消解 (不赌底层 spawn 的 env 语义): 子编译器只在 CHENG_PROGRESS
    # 为真时打印逐相行 (core/tooling/backend_driver_dispatch_min.cheng:3536,
    # core/tooling/system_link_exec_pure_main.cheng:180-186), 而现役调用方只传
    # CHENG_ENTRY_CACHE/NO_CACHE/STRICT_NO_CACHE。父进程 (rsi CLI, 由 guard
    # --target-env 注入) 设了就把 CHENG_PROGRESS=<值> 显式并入 envOverrides;
    # 调用方已显式传该键则以其为准 (不重复项)。父进程未设 => envList 与入参
    # 同序同字节 (osHostProcessEncodeWire 按下标原字节编码), 子进程可见环境
    # 逐字节不变, 等价 no-op。
    let parentProgress = os.GetEnv("CHENG_PROGRESS")
    var progressGiven: bool = false
    var envList: str[]
    for i in 0..<len(envOverrides):
        if strutil.StartsWith(envOverrides[i], "CHENG_PROGRESS="):
            progressGiven = true
        add(envList, Fmt"{envOverrides[i]}")
    if len(parentProgress) > 0 && !progressGiven:
        add(envList, Fmt"CHENG_PROGRESS={parentProgress}")
    let res = hostos.ExecFileCapture(Fmt"{compilerPath}",
        ["system-link-exec",
         Fmt"--root:{root}",
         Fmt"--in:{sourcePath}",
         "--emit:exe",
         "--target:arm64-apple-darwin",
         Fmt"--out:{outPath}"], envList, "", true, timeoutSec)
    # A9a 逐相行转发: 捕获文本 = 子进程 stdout+stderr 合并 (mergeStderr=true),
    # 此前整体丢弃 -> guard --phase-trace 只看得到 CLI 自身 stderr, A/M 腿逐相
    # 读数恒 0。此处只把既有协议前缀 "compile_progress " 的整行原样转到本进程
    # stderr (同 core/tooling/host_ops.cheng HostOpsEchoProgressChunk 既有转发面),
    # 其余捕获内容 (报告/理论块) 一律不外泄, 前缀外不做任何匹配, 不新增开关。
    # 成功路径上 CHENG_PROGRESS 未设 => 子进程无协议行 => 本块零输出。
    let captured = os.ExecCmdResultOutput(res)
    let capLen = len(captured)
    var lineStart: int32 = 0
    for i in 0..<capLen:
        if captured[i] == '\n':
            let line = strings.SliceBytes(captured, lineStart, i - lineStart)
            if len(line) > 0 && strutil.StartsWith(line, "compile_progress "):
                os.WriteLine(os.Get_stderr(), line)
            lineStart = i + 1
    # 末段 (末行无换行符时也必须逐相转发, 不静默丢弃)。
    let tailLine = strings.SliceBytes(captured, lineStart, capLen - lineStart)
    if len(tailLine) > 0 && strutil.StartsWith(tailLine, "compile_progress "):
        os.WriteLine(os.Get_stderr(), tailLine)
    return os.ExecCmdResultExitCode(res)
