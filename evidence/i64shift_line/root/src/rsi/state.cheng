# 纯 Cheng RSI 框架: 试验状态表 (SoA) 与状态流转记账 (提案第1步)。
# SoA 纪律: 跨节点身份用 int32 行索引; 试验表为平行 int 数组列,
# 禁止含 str/托管字段的记录入 seq (已知崩溃禁区)。
# C 车头坑规避 (probe4 实证): var 形参函数的返回值不可信 ——
# 副作用函数一律 void, 行索引由调用点先快照; 判定与写入拆成
# 纯读 CanAdvance + 纯写 WriteState 两步, 调用点组合。
import cheng/rsi/types as types

type
    RsiTrialTable =
        trialCount: int32
        state: int32[]
        domain: int32[]
        changeKind: int32[]
        strategy: int32[]
        param: int32[]
        score: int64[]

fn RsiTrialTableInit(): RsiTrialTable =
    var t: RsiTrialTable
    t.trialCount = 0
    return t

# 追加一个 Proposed 状态的新试验 (void; 行索引 = 调用点先快照的 trialCount)。
fn RsiTrialAppend(t: var RsiTrialTable, domain: int32, changeKind: int32,
                  strategy: int32, param: int32) =
    add(t.state, types.RsiTrialProposed)
    add(t.domain, domain)
    add(t.changeKind, changeKind)
    add(t.strategy, strategy)
    add(t.param, param)
    add(t.score, 0)
    t.trialCount = t.trialCount + 1

# 流转合法性判定不在本层提供: struct 值形参会 move 整表 (live=0 被拒),
# var 形参 + bool 返回在 C 车头下返回值不可信 —— 调用点用
# row/trialCount/state[row] 纯 int32 读数 + types.RsiTransitionLegal 内联判定。

# 纯写: 落状态与分数 (调用方必须先经 RsiTrialCanAdvance 判定)。
fn RsiTrialWriteState(t: var RsiTrialTable, row: int32, toState: int32,
                      score: int64) =
    t.state[row] = toState
    t.score[row] = score

# 未决试验 (非终态) 计数: 崩溃恢复时重启方据此把残留未决试验标 Aborted。
# var 借用形参 (值形参会 move 整表) + var-out (var 形参函数返回值不可信)。
fn RsiTrialPendingCountInto(t: var RsiTrialTable, outCount: var int32) =
    var n: int32 = 0
    for i in 0..<t.trialCount:
        if !types.RsiTrialTerminal(t.state[i]):
            n = n + 1
    outCount = n
