module tr119r3v_a_genarg_lib
import std/result

type IntAlias = int32
type BoolAlias = bool

fn makeIntAliasResult(v: int32): Result[IntAlias] =
    return Ok[IntAlias](v)

fn makeBoolAliasResult(v: int32): Result[BoolAlias] =
    if v < 0:
        return Err[BoolAlias]("neg")
    return Ok[BoolAlias](true)
