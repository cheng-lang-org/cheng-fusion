import repro_aliasgap121/customgen_lib

fn trapCustomGenMismatch(v: int32): Box[int32] =
    var stray: Box[bool] = makeBoxBool(v > 0)
    echo("about to fall off the end (custom generic instantiation mismatch)")

fn main(): int32 =
    var r: Box[int32] = trapCustomGenMismatch(7)
    echo(Fmt"should not reach here value={r.value}")
    return 0
