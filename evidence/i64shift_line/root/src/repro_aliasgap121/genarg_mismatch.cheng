import std/result
import repro_aliasgap121/genarg_lib

type IntAlias = int32
type BoolAlias = bool

fn trapGenArgAlias(v: int32): Result[BoolAlias] =
    var stray: Result[IntAlias] = makeIntAliasResult(v)
    echo("about to fall off the end without a return (generic-arg alias mismatch)")

fn main(): int32 =
    var r: Result[BoolAlias] = trapGenArgAlias(7)
    echo(Fmt"should not reach here: ok={Value(r)}")
    return 0
