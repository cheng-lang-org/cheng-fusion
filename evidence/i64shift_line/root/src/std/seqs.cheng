# Sequence module
import std/system

type
    ChengSeqHeader =
        len: int32
        cap: int32
        buffer: ptr

@importc("cheng_seq_string_elem_bytes_compat")
fn cheng_seq_string_elem_bytes_compat(): int32
@importc("cheng_seq_string_release_range_compat")
fn cheng_seq_string_release_range_compat(buffer: ptr, startIndex: int32, count: int32)
@importc("cheng_seq_string_delete_shift_compat")
fn cheng_seq_string_delete_shift_compat(buffer: ptr, at: int32, len: int32)
@abi_internal
@importc("cheng_seq_set_grow")
fn cheng_seq_set_grow(seqInst: var str[], idx: int32, elemSize: int32): ptr
@importc("cheng_seq_delete_shift")
fn cheng_seq_delete_shift(buffer: ptr, at: int32, len: int32, elemSize: int32)
@importc("cheng_seq_slice_alloc")
fn chengSeqSliceRaw(buffer: ptr, len: int32, startPos: int32, stopPos: int32,
                    exclusive: int32, elemSize: int32, outLen: ptr, outCap: ptr): ptr
@importc("cheng_seq_grow_to_raw")
fn cheng__seqGrowToRaw(pBuffer: ptr, pCap: ptr, minCap: int32, typeSize: int32)
@importc("cheng_seq_next_cap")
fn cheng__seqNextCapRaw(curCap: int32, needLen: int32): int32
@importc("cheng_seq_zero_tail_raw")
fn cheng__seqZeroTailRaw(buffer: ptr, seqCap0: int32, len: int32, target: int32, typeSize: int32)
@importc("cheng_mem_release")
fn seqs_mem_release(p: ptr)
@importc("cheng_seq_free")
fn chengSeqFreeHeader(header: var ChengSeqHeader)
@importc("cheng_seq_grow_inst")
fn chengSeqGrowHeader(header: var ChengSeqHeader, minCap: int32, typeSize: int32)
@abi_internal
@importc("cheng_seq_free")
fn freeSeq_str(seqInst: var str[])
@importc("cheng_seq_free")
fn freeSeq_bool(seqInst: var bool[])
@importc("cheng_seq_free")
fn freeSeq_int32(seqInst: var int32[])
@importc("cheng_seq_free")
fn freeSeq_int64(seqInst: var int64[])
@importc("cheng_seq_free")
fn freeSeq_uint64(seqInst: var uint64[])
@importc("cheng_seq_free")
fn freeSeq_uint8(seqInst: var uint8[])

fn chengSeqHeader(seqInst: var T[], header: var ChengSeqHeader) =
    header.len = seqInst.len
    header.cap = seqInst.cap
    header.buffer = seqInst.buffer

fn chengSeqCommitHeader(seqInst: var T[], header: ChengSeqHeader) =
    seqInst.buffer = header.buffer
    seqInst.cap = header.cap
    seqInst.len = header.len

fn chengSeqFreeTyped(seqInst: var T[]) =
    var header: ChengSeqHeader
    chengSeqHeader[T](seqInst, header)
    chengSeqFreeHeader(header)
    chengSeqCommitHeader[T](seqInst, header)

fn cheng__seqGrowInst(seqInst: var T[], minCap: int32, typeSize: int32) =
    var header: ChengSeqHeader
    chengSeqHeader[T](seqInst, header)
    chengSeqGrowHeader(header, minCap, typeSize)
    chengSeqCommitHeader[T](seqInst, header)

fn chengSeqStringSetGrow(seqInst: var str[], idx: int32, elemSize: int32): cstring =
    return cheng_seq_set_grow(seqInst, idx, elemSize)

# Cross-module str[] release has one unambiguous entry. Non-str release resolves
# through the sole generic freeSeq(T[]) below (no scalar overloads).
fn freeSeqStrRelease(seqInst: var str[]) =
    let freeSeqStrBufRaw: ptr = seqInst.buffer
    if freeSeqStrBufRaw != nil && seqInst.len > 0 &&
       memRefCount(freeSeqStrBufRaw) <= 1:
        cheng_seq_string_release_range_compat(freeSeqStrBufRaw, 0, seqInst.len)
    chengSeqFreeTyped(seqInst)

fn cheng__seqNextCap(curCap: int32, needLen: int32): int32 =
    let curCap0: int32 = curCap
    return cheng__seqNextCapRaw(curCap0, needLen)

@borrows
fn setLen(seqInst: var T[], newLen: int) =
    var target: int32 = Int32(newLen)
    let elemBytes: int32 = elemSize[T]()
    if target < 0:
        target = 0
    if target > seqInst.cap || (target > 0 && seqInst.buffer == nil):
        cheng__seqGrowInst(seqInst, target, elemBytes)
    if target > seqInst.len:
        cheng__seqZeroTailRaw(seqInst.buffer, seqInst.cap, seqInst.len, target, elemBytes)
    seqInst.len = target

fn setLen(seqInst: var T[], newLen: int32) =
    var target: int32 = newLen
    let elemBytes: int32 = elemSize[T]()
    if target < 0:
        target = 0
    if target > seqInst.cap || (target > 0 && seqInst.buffer == nil):
        cheng__seqGrowInst(seqInst, target, elemBytes)
    if target > seqInst.len:
        cheng__seqZeroTailRaw(seqInst.buffer, seqInst.cap, seqInst.len, target, elemBytes)
    seqInst.len = target

fn setLenPtr(seqInst: var T[], newLen: int) =
    setLen(seqInst, newLen)

fn reserve(seqInst: var T[], newCap: int32) =
    if newCap >= 0:
        if newCap > seqInst.cap || seqInst.buffer == nil:
            let elemBytes: int32 = elemSize[T]()
            cheng__seqGrowInst(seqInst, newCap, elemBytes)

fn reserve(seqInst: var T[], newCap: int) =
    reserve(seqInst, Int32(newCap))

fn reservePtr(seqInst: var T[], newCap: int32) =
    reserve(seqInst, newCap)

@borrows
fn clear(seqInst: var T[]) =
    seqInst.len = 0

fn clear(seqInst: var str[]) =
    setLen(seqInst, 0)

fn resize(seqInst: var T[], newLen: int, capHint: int32 = 0) =
    if capHint > 0:
        reserve(seqInst, capHint)
    setLen(seqInst, newLen)

fn len(seqInst: T[]): int32 =
    return seqInst.len

@borrows
fn dataPtr(seqInst: T[]): ptr =
    return seqInst.buffer

@borrows
@borrow_result
fn get(seqInst: T[], at: int32): T =
    return seqInst[at]

fn add(seqInst: var T[], val: T) =
    let writeAt: int32 = seqInst.len
    setLen(seqInst, writeAt + 1)
    seqInst[writeAt] = val

fn seqAdd(seqInst: var T[], val: T) =
    let writeAt: int32 = seqInst.len
    setLen(seqInst, writeAt + 1)
    seqInst[writeAt] = val

fn findImpl(seqInst: T[], val: T, start: int32): int32 =
    var index: int32 = start
    if index < 0:
        index = 0
    for index in index..<seqInst.len:
        if seqInst[index] == val:
            return index
    return -1

fn find(seqInst: T[], val: T): int32 =
    var index: int32
    for index in index..<seqInst.len:
        if seqInst[index] == val:
            return index
    return -1

fn find(seqInst: T[], val: T, start: int32): int32 =
    var index: int32 = start
    if index < 0:
        index = 0
    for index in index..<seqInst.len:
        if seqInst[index] == val:
            return index
    return -1

fn delete(seqInst: var T[], at: int32) =
    if at >= 0 && at < seqInst.len:
        cheng_seq_delete_shift(seqInst.buffer, at, seqInst.len, elemSize[T]())
        seqInst.len = seqInst.len - 1

fn delete(seqInst: var str[], at: int32) =
    if at >= 0 && at < seqInst.len:
        cheng_seq_string_delete_shift_compat(seqInst.buffer, at, seqInst.len)
        seqInst.len = seqInst.len - 1

fn freeSeqPtr(seqInst: var T[]) =
    chengSeqFreeTyped(seqInst)

fn freeSeqPtr(seqInst: var str[]) =
    let freeSeqPtrStrBufRaw: ptr = seqInst.buffer
    if freeSeqPtrStrBufRaw != nil && seqInst.len > 0 &&
       memRefCount(freeSeqPtrStrBufRaw) <= 1:
        cheng_seq_string_release_range_compat(freeSeqPtrStrBufRaw, 0, seqInst.len)
    chengSeqFreeTyped(seqInst)

fn freeSeq(seqInst: var T[]) =
    chengSeqFreeTyped(seqInst)

# Bootstrap compatibility symbol for concrete sequence release.
fn reset(seqInst: var T[]) =
    freeSeq(seqInst)

@borrows
fn arcRetainSeq(seqInst: T[]) =
    if seqInst.buffer != nil:
        memRetain(seqInst.buffer)

@borrows
fn arcReleaseSeq(seqInst: T[]) =
    if seqInst.buffer != nil:
        seqs_mem_release(seqInst.buffer)

# Monomorphized legacy alias for str sequence (kept for bootstrap compatibility).
type
    seq_string = str[]

fn freeSeqPtr_string(seqInst: var str[]) =
    if seqInst.buffer != nil && seqInst.len > 0 &&
       memRefCount(seqInst.buffer) <= 1:
        cheng_seq_string_release_range_compat(seqInst.buffer, 0, seqInst.len)
    chengSeqFreeTyped(seqInst)

@borrows
fn arcRetainSeqString(seqInst: str[]) =
    arcRetainSeq(seqInst)

@borrows
fn arcReleaseSeqString(seqInst: str[]) =
    arcReleaseSeq(seqInst)

@borrows
fn arcRetainSeq_string(seqInst: str[]) =
    arcRetainSeq(seqInst)

@borrows
fn arcReleaseSeq_string(seqInst: str[]) =
    arcReleaseSeq(seqInst)

fn chengSeqStringElemBytesCompat(): int32 =
    return cheng_seq_string_elem_bytes_compat()

fn chengSeqStoreStrCompat(slot: cstring, val: str) =
    if slot == nil:
        return
    chengStrStoreCompat(slot, val)

@abi_internal
@importc("cheng_seq_string_init_compat")
fn cheng_seq_string_init_compat(seqInst: var str[], seqLen: int32, seqCap: int32)

fn chengSeqStringInitCompat(seqInst: var str[], seqLen: int32, seqCap: int32) =
    cheng_seq_string_init_compat(seqInst, seqLen, seqCap)

fn newSeq_string(seqLen: int32, seqCap: int32): str[] =
    var out: str[]
    chengSeqStringInitCompat(out, seqLen, seqCap)
    # Older stage0/current-source drivers can mis-lower the raw local return
    # after compat out-ptr init; return through the concrete alias header shape.
    return out

fn setLen(seqInst: var str[], newLen: int) =
    var target: int32 = Int32(newLen)
    if target < 0:
        target = 0
    let elemBytes: int32 = chengSeqStringElemBytesCompat()
    let prevLen: int32 = seqInst.len
    if target > seqInst.cap || (target > 0 && seqInst.buffer == nil):
        cheng__seqGrowInst(seqInst, target, elemBytes)
    if target > seqInst.len:
        cheng__seqZeroTailRaw(seqInst.buffer, seqInst.cap, seqInst.len, target, elemBytes)
    elif target < prevLen:
        cheng_seq_string_release_range_compat(seqInst.buffer, target, prevLen - target)
    seqInst.len = target

fn setLen(seqInst: var str[], newLen: int32) =
    var target: int32 = newLen
    if target < 0:
        target = 0
    let elemBytes: int32 = chengSeqStringElemBytesCompat()
    let prevLen: int32 = seqInst.len
    if target > seqInst.cap || (target > 0 && seqInst.buffer == nil):
        cheng__seqGrowInst(seqInst, target, elemBytes)
    if target > seqInst.len:
        cheng__seqZeroTailRaw(seqInst.buffer, seqInst.cap, seqInst.len, target, elemBytes)
    elif target < prevLen:
        cheng_seq_string_release_range_compat(seqInst.buffer, target, prevLen - target)
    seqInst.len = target

fn reserve(seqInst: var str[], newCap: int32) =
    if newCap >= 0:
        if newCap > seqInst.cap || seqInst.buffer == nil:
            cheng__seqGrowInst(seqInst, newCap, chengSeqStringElemBytesCompat())

fn reserve(seqInst: var str[], newCap: int) =
    reserve(seqInst, Int32(newCap))

fn add(seqInst: var str[], val: str) =
    let writeAt: int32 = seqInst.len
    let slot: cstring = chengSeqStringSetGrow(seqInst, writeAt, chengSeqStringElemBytesCompat())
    chengSeqStoreStrCompat(slot, val)

fn seqAdd(seqInst: var str[], val: str) =
    let writeAt: int32 = seqInst.len
    let slot: cstring = chengSeqStringSetGrow(seqInst, writeAt, chengSeqStringElemBytesCompat())
    chengSeqStoreStrCompat(slot, val)

fn __cheng_vec_contains(seqInst: T[], val: T): bool =
    var index: int32
    let count: int32 = seqInst.len
    for index in index..<count:
        let cur: T = seqInst[index]
        if cur == val:
            return true
    return false

fn __cheng_slice_vec(seqInst: T[], startPos: int32, stopPos: int32, exclusive: bool): T[] =
    if exclusive:
        var index: int32 = startPos
        if index < 0:
            index = 0
        var out: T[]
        for index in index..<seqInst.len:
            if index >= stopPos:
                break
            let nextLen: int32 = out.len + 1
            if out.buffer == nil || out.len >= out.cap:
                cheng__seqGrowInst(out, nextLen, elemSize[T]())
            out.len = nextLen
            out[nextLen - 1] = seqInst[index]
        return out
    var index: int32 = startPos
    if index < 0:
        index = 0
    var out: T[]
    for index in index..<seqInst.len:
        if index > stopPos:
            break
        let nextLen: int32 = out.len + 1
        if out.buffer == nil || out.len >= out.cap:
            cheng__seqGrowInst(out, nextLen, elemSize[T]())
        out.len = nextLen
        out[nextLen - 1] = seqInst[index]
    return out

fn SetLen(seqInst: var T[], newLen: int) =
    setLen(seqInst, newLen)

fn SetLen(seqInst: var T[], newLen: int32) =
    setLen(seqInst, newLen)

fn Reserve(seqInst: var T[], newCap: int32) =
    reserve(seqInst, newCap)

fn Reserve(seqInst: var T[], newCap: int) =
    reserve(seqInst, newCap)

fn Clear(seqInst: var T[]) =
    clear(seqInst)

fn Len(seqInst: T[]): int32 =
    return seqInst.len

fn Get(seqInst: T[], at: int32): T =
    return get(seqInst, at)

fn Add(seqInst: var str[], val: str) =
    let writeAt: int32 = seqInst.len
    let slot: cstring = chengSeqStringSetGrow(seqInst, writeAt, chengSeqStringElemBytesCompat())
    chengSeqStoreStrCompat(slot, val)

fn Add(seqInst: var T[], val: T) =
    add(seqInst, val)

fn Find(seqInst: T[], val: T): int32 =
    return find(seqInst, val)

fn Find(seqInst: T[], val: T, start: int32): int32 =
    return find(seqInst, val, start)

fn Delete(seqInst: var T[], at: int32) =
    delete(seqInst, at)

fn FreeSeq(seqInst: var T[]) =
    freeSeq(seqInst)

fn Reset(seqInst: var T[]) =
    reset(seqInst)

# Provider-tier canonical descriptor read of the managed sequence buffer field.
# Kernel callers pass the sequence as a var borrow; no &/ptr surface is needed
# at the kernel boundary. cstring is std/system's byte-address alias.
fn bufferIdentity(seqInst: var T[]): cstring =
    return seqInst.buffer
