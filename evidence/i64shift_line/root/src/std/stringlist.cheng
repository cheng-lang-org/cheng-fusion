import std/strutils as strutil
# stringlist.cheng - fixed-size string list helpers
#
# API 对齐 pkg://cheng/libp2p 的 utils/stringlist，便于机械替换 import。

import std/result
import std/strings
import std/seqs

const
    maxStringList = 32

type
    StringList =
        count: int32
        items: str[]

fn initStringList(): StringList =
    var out: StringList
    out.count = 0
    return out

fn InitStringList(): StringList =
    return initStringList()

@borrows
fn stringListCount(list: StringList): int32 =
    list.count

@borrows
fn StringListCount(list: StringList): int32 =
    return stringListCount(list)

@borrows
fn stringListIsEmpty(list: StringList): bool =
    list.count <= 0

@borrows
fn StringListIsEmpty(list: StringList): bool =
    return stringListIsEmpty(list)

@borrows
fn stringListContains(list: StringList, item: str): bool =
    if len(item) <= 0:
        return false
    for i in 0..<list.count:
        if (list.items[i] == item):
            return true
    return false

@borrows
fn StringListContains(list: StringList, item: str): bool =
    return stringListContains(list, item)

fn stringListAdd(list: var StringList, item: str): Result[bool] =
    if len(item) <= 0:
        return Ok[bool](false)
    if stringListContains(list, item):
        return Ok[bool](true)
    if list.count >= maxStringList:
        return Err[bool]("stringlist: full")
    add(list.items, strings.CloneStr(item))
    list.count = list.count + 1
    return Ok[bool](true)

fn StringListAdd(list: var StringList, item: str): Result[bool] =
    return stringListAdd(list, item)

fn stringListFromLines(text: str): Result[StringList] =
    var list: StringList = initStringList()
    if len(text) <= 0:
        return Ok[StringList](list)
    var i: int32
    var start: int32
    let total: int32 = len(text)
    for i in i..total:
        var lineEnd: bool
        if i == total:
            lineEnd = true
        elif text[i] == '\n':
            lineEnd = true
        if lineEnd:
            let segLen: int32 = i - start
            if segLen > 0:
                let item: str = strings.CloneStr(sliceBytes(text, start, segLen))
                let addRes: Result[bool] = stringListAdd(list, item)
                if IsErr(addRes):
                    return Err[StringList](Error(addRes))
            start = i + 1
    return Ok[StringList](list)

fn StringListFromLines(text: str): Result[StringList] =
    return stringListFromLines(text)

@borrows
fn stringListToLines(list: StringList): str =
    if list.count <= 0:
        return ""
    var out: str
    var i: int32
    while i < list.count:
        if i > 0:
            out = out + "\n"
        out = out + strings.CloneStr(list.items[i])
        i = i + 1
    return out

@borrows
fn StringListToLines(list: StringList): str =
    return stringListToLines(list)

fn stringListSlice(list: StringList, offset: int32, limit: int32): StringList =
    var out: StringList = initStringList()
    if limit <= 0:
        return out
    let start: int32 = if offset < 0: 0 else: offset
    if start >= list.count:
        return out
    var i: int32 = start
    var remaining: int32 = limit
    let iStart = i
    for iValue in iStart..<list.count:
        i = iValue
        if ! (i < list.count && remaining > 0):
            break
        add(out.items, strings.CloneStr(list.items[i]))
        out.count = out.count + 1
        i = i + 1
        remaining = remaining - 1
    return out

fn StringListSlice(list: StringList, offset: int32, limit: int32): StringList =
    return stringListSlice(list, offset, limit)

fn stringListLimit(list: StringList, limit: int32): StringList =
    return stringListSlice(list, 0, limit)

fn StringListLimit(list: StringList, limit: int32): StringList =
    return stringListLimit(list, limit)

fn stringListOffset(list: StringList, offset: int32, limit: int32): StringList =
    return stringListSlice(list, offset, limit)

fn StringListOffset(list: StringList, offset: int32, limit: int32): StringList =
    return stringListOffset(list, offset, limit)

fn stringListPage(list: StringList, page: int32, size: int32): StringList =
    if size <= 0:
        return initStringList()
    var offset: int32
    if page > 1:
        offset = (page - 1) * size
    return stringListSlice(list, offset, size)

fn StringListPage(list: StringList, page: int32, size: int32): StringList =
    return stringListPage(list, page, size)
