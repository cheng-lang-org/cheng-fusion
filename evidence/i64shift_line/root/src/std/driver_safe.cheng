# driver_safe capability types. Public driver code sees addresses as typed
# capabilities, not as dereferenceable pointers.

type
    PhysAddr =
        raw: uint64

    VirtAddr =
        raw: uint64

    MmioRegU8 =
        phys: PhysAddr
        offset: uint64
        alignBytes: int32

    MmioRegU16 =
        phys: PhysAddr
        offset: uint64
        alignBytes: int32

    MmioRegU32 =
        phys: PhysAddr
        offset: uint64
        alignBytes: int32

    MmioRegU64 =
        phys: PhysAddr
        offset: uint64
        alignBytes: int32

    DmaBufferCpu[T] =
        id: uint64
        bytes: int32
        payload: T

    DmaBufferDevice[T] =
        id: uint64
        bytes: int32
        generation: uint64

    IrqToken =
        irq: int32
        generation: uint64

    IrqSpinLock[T] =
        state: int32
        value: T

@trusted_abi
fn TrustedPhysAddr(raw: uint64): PhysAddr =
    var out: PhysAddr
    out.raw = raw
    return out

@trusted_abi
fn TrustedVirtAddr(raw: uint64): VirtAddr =
    var out: VirtAddr
    out.raw = raw
    return out

@trusted_abi
fn TrustedMmioRegU8(base: PhysAddr, offset: uint64): MmioRegU8 =
    var out: MmioRegU8
    out.phys = base
    out.offset = offset
    out.alignBytes = 1
    return out

@trusted_abi
fn TrustedMmioRegU16(base: PhysAddr, offset: uint64): MmioRegU16 =
    var out: MmioRegU16
    out.phys = base
    out.offset = offset
    out.alignBytes = 2
    return out

@trusted_abi
fn TrustedMmioRegU32(base: PhysAddr, offset: uint64): MmioRegU32 =
    var out: MmioRegU32
    out.phys = base
    out.offset = offset
    out.alignBytes = 4
    return out

@trusted_abi
fn TrustedMmioRegU64(base: PhysAddr, offset: uint64): MmioRegU64 =
    var out: MmioRegU64
    out.phys = base
    out.offset = offset
    out.alignBytes = 8
    return out

fn DmaBufferForCpu[T](id: uint64, bytes: int32, payload: T): DmaBufferCpu[T] =
    var out: DmaBufferCpu[T]
    out.id = id
    out.bytes = bytes
    out.payload = payload
    return out

fn DmaHandToDevice[T](buf: DmaBufferCpu[T]): DmaBufferDevice[T] =
    var out: DmaBufferDevice[T]
    out.id = buf.id
    out.bytes = buf.bytes
    out.generation = uint64(1)
    return out

fn DmaReclaimFromDevice[T](buf: DmaBufferDevice[T], payload: T): DmaBufferCpu[T] =
    var out: DmaBufferCpu[T]
    out.id = buf.id
    out.bytes = buf.bytes
    out.payload = payload
    return out

fn IrqTokenFor(irq: int32, generation: uint64): IrqToken =
    var out: IrqToken
    out.irq = irq
    out.generation = generation
    return out

fn IrqSpinLockNew[T](value: T): IrqSpinLock[T] =
    var out: IrqSpinLock[T]
    out.state = 0
    out.value = value
    return out
