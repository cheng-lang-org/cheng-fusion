import std/os
import std/rawbytes
import std/result

type
    Stream =
        f: os.FileHandle

fn streamOpenMode(mode: os.FileMode): os.FileOpenMode =
    if mode == fmRead:
        return Read
    if mode == fmReadWrite:
        return ReadWrite
    return WriteTruncate

fn newFileStream(path: str, mode: os.FileMode): Stream =
    var s: Stream
    var openRes: Result[os.FileHandle] = os.OpenFileResult(path, streamOpenMode(mode))
    if result.IsOk(openRes):
        s.f = result.Value(openRes)
    return s

fn write(s: Stream, data: str) =
    if s.f == uint64(0):
        return
    var bytes: rawbytes.Bytes = rawbytes.BytesFromString(data)
    let _ = os.WriteAllBytesResult(s.f, bytes)

fn close(s: Stream) =
    if s.f == uint64(0):
        return
    let _ = os.CloseFileResult(s.f)

fn isNil(s: Stream): bool =
    return s.f == uint64(0)

fn Close(s: Stream) =
    close(s)

fn IsNil(s: Stream): bool =
    return isNil(s)

fn NewFileStream(path: str, mode: os.FileMode): Stream =
    return newFileStream(path, mode)
