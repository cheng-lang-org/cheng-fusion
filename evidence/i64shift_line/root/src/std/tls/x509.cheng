import std/strutils as strutil
# Minimal X.509 DER parser && chain validator(pure Cheng).

import std/result
import std/rawbytes
import std/buffer
import std/strings
import std/os
import std/crypto/minasn1
import std/crypto/rsa
import std/crypto/ecnist
const
    x509Asn1TagBoolean: int32 = 1
    x509Asn1TagBitString: int32 = 3
    x509Asn1TagOctetString: int32 = 4
    x509Asn1TagOid: int32 = 6
    x509Asn1TagSequence: int32 = 48
    x509TagUtcTime: int32 = 23
    x509TagGeneralizedTime: int32 = 24
    x509TagContext0: int32 = 160
    x509TagContext3: int32 = 163
    x509TagDnsName: int32 = 130
    x509MaxChain: int32 = 8
    x509MaxCrls: int32 = 8
    x509MaxRevoked: int32 = 128
    x509MonthsInYear: int32 = 12

    oidRsaEncryption = "1.2.840.113549.1.1.1"
    oidRsaPss = "1.2.840.113549.1.1.10"
    oidMgf1 = "1.2.840.113549.1.1.8"
    oidSha256WithRsa = "1.2.840.113549.1.1.11"
    oidSha384WithRsa = "1.2.840.113549.1.1.12"
    oidSha256 = "2.16.840.1.101.3.4.2.1"
    oidSha384 = "2.16.840.1.101.3.4.2.2"
    oidEcdsaPublicKey = "1.2.840.10045.2.1"
    oidPrime256v1 = "1.2.840.10045.3.1.7"
    oidEcdsaWithSha256 = "1.2.840.10045.4.3.2"
    oidEcdsaWithSha384 = "1.2.840.10045.4.3.3"
    oidOcspBasic = "1.3.6.1.5.5.7.48.1.1"
    oidBasicConstraints = "2.5.29.19"
    oidKeyUsage = "2.5.29.15"
    oidExtKeyUsage = "2.5.29.37"
    oidSubjectAltName = "2.5.29.17"
    oidServerAuth = "1.3.6.1.5.5.7.3.1"
    x509KeyUsageDigitalSignature: int32 = 1
    x509KeyUsageKeyEncipherment: int32 = 4
    x509KeyUsageKeyCertSign: int32 = 32

    x509OidCodeUnknown: int32 = 0
    x509OidCodeRsaEncryption: int32 = 1
    x509OidCodeRsaPss: int32 = 2
    x509OidCodeMgf1: int32 = 3
    x509OidCodeSha256WithRsa: int32 = 4
    x509OidCodeSha384WithRsa: int32 = 5
    x509OidCodeSha256: int32 = 6
    x509OidCodeSha384: int32 = 7
    x509OidCodeEcdsaPublicKey: int32 = 8
    x509OidCodePrime256v1: int32 = 9
    x509OidCodeEcdsaWithSha256: int32 = 10
    x509OidCodeEcdsaWithSha384: int32 = 11
    x509OidCodeOcspBasic: int32 = 12
    x509OidCodeBasicConstraints: int32 = 13
    x509OidCodeKeyUsage: int32 = 14
    x509OidCodeExtKeyUsage: int32 = 15
    x509OidCodeSubjectAltName: int32 = 16
    x509OidCodeServerAuth: int32 = 17

var
    x509DebugEnabled: bool

fn x509SetDebug(enabled: bool) =
    x509DebugEnabled = enabled

fn x509DebugWriteLine(text: str) =
    if !x509DebugEnabled:
        return
    os.WriteLine(os.Get_stderr(), text)

type
    X509SignatureKind = enum
        X509SigUnknown = 0
        X509SigRsaSha256 = 1
        X509SigRsaSha384 = 2
        X509SigEcdsaSha256 = 3
        X509SigEcdsaSha384 = 4
        X509SigRsaPss = 5

    X509HashKind = enum
        X509HashUnknown = 0
        X509HashSha256 = 1
        X509HashSha384 = 2

    X509PublicKeyKind = enum
        X509KeyUnknown = 0
        X509KeyRsa = 1
        X509KeyEcdsaP256 = 2

    X509OidNext =
        oid: str
        next: int32

    X509BitStringNext =
        bytes: Bytes
        unused: int32
        next: int32

    X509RawTlv =
        tag: int32
        raw: Bytes
        value: Bytes
        next: int32

    X509HashSaltLen =
        hash: X509HashKind
        saltLen: int32

    X509SigAlgNext =
        sigAlg: X509SignatureKind
        pssHash: X509HashKind
        pssSaltLen: int32
        next: int32

    X509AlgIdParamNext =
        oid: str
        paramOid: str
        next: int32

    X509PublicKey =
        kind: X509PublicKeyKind
        rsaN: Bytes
        rsaE: Bytes
        ecdsaBytes: Bytes

    X509Certificate =
        der: Bytes
        tbs: Bytes
        signature: Bytes
        sigAlg: X509SignatureKind
        pssHash: X509HashKind
        pssSaltLen: int32
        tbsSigAlg: X509SignatureKind
        tbsPssHash: X509HashKind
        tbsPssSaltLen: int32
        serial: Bytes
        issuer: Bytes
        subject: Bytes
        notBefore: int64
        notAfter: int64
        isCa: bool
        hasBasicConstraints: bool
        keyUsage: int32
        hasKeyUsage: bool
        extKeyUsageCount: int32
        hasServerAuthEku: bool
        dnsNameCount: int32
        dnsNamesDer: Bytes
        hasUnknownCritical: bool
        publicKey: X509PublicKey

    X509CertList =
        count: int32
        items: X509Certificate[x509MaxChain]
        derItems: Bytes[x509MaxChain]
        der0: Bytes
        der1: Bytes
        der2: Bytes
        der3: Bytes
        der4: Bytes
        der5: Bytes
        der6: Bytes
        der7: Bytes

    X509RevocationMode = enum
        X509RevocationOff = 0
        X509RevocationBestEffort = 1
        X509RevocationStrict = 2

    X509RevocationStatus = enum
        X509RevocationGood = 0
        X509RevocationRevoked = 1
        X509RevocationUnknown = 2

    X509Crl =
        issuer: Bytes
        thisUpdate: int64
        nextUpdate: int64
        revokedCount: int32
        revokedSerials: Bytes[x509MaxRevoked]

fn initX509PublicKey(): X509PublicKey =
    var out: X509PublicKey
    initX509PublicKeyInto(out)
    return out

fn initX509PublicKeyInto(out: var X509PublicKey) =
    out.kind = X509KeyUnknown
    out.rsaN = emptyBytes()
    out.rsaE = emptyBytes()
    out.ecdsaBytes = emptyBytes()

fn initX509Certificate(): X509Certificate =
    var out: X509Certificate
    initX509CertificateInto(out)
    return out

fn initX509CertificateInto(out: var X509Certificate) =
    out.der = emptyBytes()
    out.tbs = emptyBytes()
    out.signature = emptyBytes()
    out.sigAlg = X509SigUnknown
    out.pssHash = X509HashUnknown
    out.pssSaltLen = -1
    out.tbsSigAlg = X509SigUnknown
    out.tbsPssHash = X509HashUnknown
    out.tbsPssSaltLen = -1
    out.serial = emptyBytes()
    out.issuer = emptyBytes()
    out.subject = emptyBytes()
    out.notBefore = 0
    out.notAfter = 0
    out.isCa = false
    out.hasBasicConstraints = false
    out.keyUsage = 0
    out.hasKeyUsage = false
    out.extKeyUsageCount = 0
    out.hasServerAuthEku = false
    out.dnsNameCount = 0
    out.dnsNamesDer = emptyBytes()
    out.hasUnknownCritical = false
    initX509PublicKeyInto(out.publicKey)

@borrows
fn x509CertificateCopyInto(out: var X509Certificate, src: X509Certificate) =
    out.der = rawbytes.BytesSlice(src.der, 0, rawbytes.BytesLen(src.der))
    out.tbs = rawbytes.BytesSlice(src.tbs, 0, rawbytes.BytesLen(src.tbs))
    out.signature = rawbytes.BytesSlice(src.signature, 0, rawbytes.BytesLen(src.signature))
    out.sigAlg = src.sigAlg
    out.pssHash = src.pssHash
    out.pssSaltLen = src.pssSaltLen
    out.tbsSigAlg = src.tbsSigAlg
    out.tbsPssHash = src.tbsPssHash
    out.tbsPssSaltLen = src.tbsPssSaltLen
    out.serial = rawbytes.BytesSlice(src.serial, 0, rawbytes.BytesLen(src.serial))
    out.issuer = rawbytes.BytesSlice(src.issuer, 0, rawbytes.BytesLen(src.issuer))
    out.subject = rawbytes.BytesSlice(src.subject, 0, rawbytes.BytesLen(src.subject))
    out.notBefore = src.notBefore
    out.notAfter = src.notAfter
    out.isCa = src.isCa
    out.hasBasicConstraints = src.hasBasicConstraints
    out.keyUsage = src.keyUsage
    out.hasKeyUsage = src.hasKeyUsage
    out.extKeyUsageCount = src.extKeyUsageCount
    out.hasServerAuthEku = src.hasServerAuthEku
    out.dnsNameCount = src.dnsNameCount
    out.dnsNamesDer = rawbytes.BytesSlice(src.dnsNamesDer, 0, rawbytes.BytesLen(src.dnsNamesDer))
    out.hasUnknownCritical = src.hasUnknownCritical
    out.publicKey.kind = src.publicKey.kind
    out.publicKey.rsaN = rawbytes.BytesSlice(src.publicKey.rsaN, 0, rawbytes.BytesLen(src.publicKey.rsaN))
    out.publicKey.rsaE = rawbytes.BytesSlice(src.publicKey.rsaE, 0, rawbytes.BytesLen(src.publicKey.rsaE))
    out.publicKey.ecdsaBytes = rawbytes.BytesSlice(src.publicKey.ecdsaBytes, 0, rawbytes.BytesLen(src.publicKey.ecdsaBytes))

fn initX509CertList(): X509CertList =
    var out: X509CertList
    initX509CertListInto(out)
    return out

fn initX509CertListInto(out: var X509CertList) =
    out.count = 0
    for i in 0..<x509MaxChain:
        out.items[i] = initX509Certificate()
        out.derItems[i] = emptyBytes()
    out.der0 = emptyBytes()
    out.der1 = emptyBytes()
    out.der2 = emptyBytes()
    out.der3 = emptyBytes()
    out.der4 = emptyBytes()
    out.der5 = emptyBytes()
    out.der6 = emptyBytes()
    out.der7 = emptyBytes()

fn initX509Crl(): X509Crl =
    var out: X509Crl
    initX509CrlInto(out)
    return out

fn initX509CrlInto(out: var X509Crl) =
    out.issuer = emptyBytes()
    out.thisUpdate = 0
    out.nextUpdate = 0
    out.revokedCount = 0
    for i in 0..<x509MaxRevoked:
        out.revokedSerials[i] = emptyBytes()

@borrows
fn x509CrlAddRevoked(crl: var X509Crl, serial: Bytes): Result[bool] =
    if crl.revokedCount >= x509MaxRevoked:
        return Err[bool]("x509: crl revoked list full")
    crl.revokedSerials[crl.revokedCount] = serial
    crl.revokedCount = crl.revokedCount + 1
    return Ok[bool](true)

fn x509CertListAdd(list: var X509CertList, cert: var X509Certificate): Result[bool] =
    if list.count >= x509MaxChain:
        return Err[bool]("x509: cert list full")
    if BytesLen(cert.der) > 0:
        let idx: int32 = list.count
        let derRes: Result[bool] = x509CertListSetDerAt(list, idx, cert.der)
        if IsErr(derRes):
            return Err[bool](Error(derRes))
        list.count = list.count + 1
        return Ok[bool](true)
    x509CertificateCopyInto(list.items[list.count], cert)
    list.count = list.count + 1
    return Ok[bool](true)

fn x509CertListAllocSlot(list: var X509CertList): Result[int32] =
    if list.count >= x509MaxChain:
        return Err[int32]("x509: cert list full")
    let idx: int32 = list.count
    list.items[idx] = initX509Certificate()
    list.derItems[idx] = emptyBytes()
    list.count = list.count + 1
    return Ok[int32](idx)

@borrows
fn x509CertListSetDerAt(list: var X509CertList, idx: int32, der: Bytes): Result[bool] =
    let copy: Bytes = BytesSlice(der, 0, BytesLen(der))
    if idx == 0:
        list.der0 = copy
        return Ok[bool](true)
    if idx == 1:
        list.der1 = copy
        return Ok[bool](true)
    if idx == 2:
        list.der2 = copy
        return Ok[bool](true)
    if idx == 3:
        list.der3 = copy
        return Ok[bool](true)
    if idx == 4:
        list.der4 = copy
        return Ok[bool](true)
    if idx == 5:
        list.der5 = copy
        return Ok[bool](true)
    if idx == 6:
        list.der6 = copy
        return Ok[bool](true)
    if idx == 7:
        list.der7 = copy
        return Ok[bool](true)
    return Err[bool]("x509: cert list der index invalid")

@borrows
fn x509CertListDerAt(list: X509CertList, idx: int32): Bytes =
    if idx == 0:
        return BytesSlice(list.der0, 0, BytesLen(list.der0))
    if idx == 1:
        return BytesSlice(list.der1, 0, BytesLen(list.der1))
    if idx == 2:
        return BytesSlice(list.der2, 0, BytesLen(list.der2))
    if idx == 3:
        return BytesSlice(list.der3, 0, BytesLen(list.der3))
    if idx == 4:
        return BytesSlice(list.der4, 0, BytesLen(list.der4))
    if idx == 5:
        return BytesSlice(list.der5, 0, BytesLen(list.der5))
    if idx == 6:
        return BytesSlice(list.der6, 0, BytesLen(list.der6))
    if idx == 7:
        return BytesSlice(list.der7, 0, BytesLen(list.der7))
    return emptyBytes()

@borrows
fn x509CertListCertAt(list: X509CertList, idx: int32): Result[X509Certificate] =
    if idx < 0 || idx >= list.count:
        return Err[X509Certificate]("x509: cert list index invalid")
    let der: Bytes = x509CertListDerAt(list, idx)
    if BytesLen(der) > 0:
        var cert: X509Certificate = initX509Certificate()
        let parseRes: Result[bool] = x509ParseCertificateInto(cert, der)
        if IsErr(parseRes):
            return Err[X509Certificate](strutil.Join(["x509: cert list der parse: ", ErrorText(parseRes)], ""))
        return Ok[X509Certificate](cert)
    var copied: X509Certificate = list.items[idx]
    return Ok[X509Certificate](copied)

@borrows
fn x509CertListCertAtInto(out: var X509Certificate, list: X509CertList, idx: int32): Result[bool] =
    if idx < 0 || idx >= list.count:
        return Err[bool]("x509: cert list index invalid")
    let der: Bytes = x509CertListDerAt(list, idx)
    if BytesLen(der) > 0:
        initX509CertificateInto(out)
        let parseRes: Result[bool] = x509ParseCertificateInto(out, der)
        if IsErr(parseRes):
            return Err[bool](strutil.Join(["x509: cert list der parse: ", ErrorText(parseRes)], ""))
        return Ok[bool](true)
    x509CertificateCopyInto(out, list.items[idx])
    return Ok[bool](true)

fn x509CertListFindBySubject(list: var X509CertList, subject: Bytes): Result[X509Certificate] =
    for i in 0..<list.count:
        var cert: X509Certificate = initX509Certificate()
        let certRes: Result[bool] = x509CertListCertAtInto(cert, list, i)
        if IsErr(certRes):
            return Err[X509Certificate](Error(certRes))
        if BytesEqual(cert.subject, subject):
            return Ok[X509Certificate](cert)
    return Err[X509Certificate]("x509: issuer ! found")

@borrows
fn x509CertListFindBySubjectIndex(list: X509CertList, subject: Bytes): int32 =
    for i in 0..<list.count:
        var cert: X509Certificate = initX509Certificate()
        let certRes: Result[bool] = x509CertListCertAtInto(cert, list, i)
        if IsOk(certRes):
            if BytesEqual(cert.subject, subject):
                return i
    return -1

fn x509IntToString(value: int64): str =
    return int64ToStr(value)

fn x509BoolToString(value: bool): str =
    if value:
        return "true"
    return "false"

fn x509StrEqual(a: str, b: str): bool =
    if len(a) != len(b):
        return false
    for i in 0..<len(a):
        if a[i] != b[i]:
            return false
    return true

fn x509HashLenCode(hashCode: int32): int32 =
    if hashCode == 1:
        return 32
    if hashCode == 2:
        return 48
    return 0

@borrows
fn x509OidCode(oid: str): int32 =
    let n: int32 = len(oid)
    if n == 20:
        if oid[0] != '1' || oid[1] != '.':
            return x509OidCodeUnknown
        if oid[2] == '2':
            if oid[3] != '.':
                return x509OidCodeUnknown
            if oid[4] != '8':
                return x509OidCodeUnknown
            if oid[5] != '4':
                return x509OidCodeUnknown
            if oid[6] != '0':
                return x509OidCodeUnknown
            if oid[7] != '.':
                return x509OidCodeUnknown
            if oid[8] != '1':
                return x509OidCodeUnknown
            if oid[9] != '1':
                return x509OidCodeUnknown
            if oid[10] != '3':
                return x509OidCodeUnknown
            if oid[11] != '5':
                return x509OidCodeUnknown
            if oid[12] != '4':
                return x509OidCodeUnknown
            if oid[13] != '9':
                return x509OidCodeUnknown
            if oid[14] != '.':
                return x509OidCodeUnknown
            if oid[15] != '1':
                return x509OidCodeUnknown
            if oid[16] != '.':
                return x509OidCodeUnknown
            if oid[17] != '1':
                return x509OidCodeUnknown
            if oid[18] != '.':
                return x509OidCodeUnknown
            if oid[19] == '1':
                return x509OidCodeRsaEncryption
            if oid[19] == '8':
                return x509OidCodeMgf1
            return x509OidCodeUnknown
        if oid[2] == '3':
            if oid[3] != '.':
                return x509OidCodeUnknown
            if oid[4] != '6':
                return x509OidCodeUnknown
            if oid[5] != '.':
                return x509OidCodeUnknown
            if oid[6] != '1':
                return x509OidCodeUnknown
            if oid[7] != '.':
                return x509OidCodeUnknown
            if oid[8] != '5':
                return x509OidCodeUnknown
            if oid[9] != '.':
                return x509OidCodeUnknown
            if oid[10] != '5':
                return x509OidCodeUnknown
            if oid[11] != '.':
                return x509OidCodeUnknown
            if oid[12] != '7':
                return x509OidCodeUnknown
            if oid[13] != '.':
                return x509OidCodeUnknown
            if oid[14] != '4':
                return x509OidCodeUnknown
            if oid[15] != '8':
                return x509OidCodeUnknown
            if oid[16] != '.':
                return x509OidCodeUnknown
            if oid[17] != '1':
                return x509OidCodeUnknown
            if oid[18] != '.':
                return x509OidCodeUnknown
            if oid[19] == '1':
                return x509OidCodeOcspBasic
            return x509OidCodeUnknown
        return x509OidCodeUnknown
    if n == 21:
        if oid[0] != '1':
            return x509OidCodeUnknown
        if oid[1] != '.':
            return x509OidCodeUnknown
        if oid[2] != '2':
            return x509OidCodeUnknown
        if oid[3] != '.':
            return x509OidCodeUnknown
        if oid[4] != '8':
            return x509OidCodeUnknown
        if oid[5] != '4':
            return x509OidCodeUnknown
        if oid[6] != '0':
            return x509OidCodeUnknown
        if oid[7] != '.':
            return x509OidCodeUnknown
        if oid[8] != '1':
            return x509OidCodeUnknown
        if oid[9] != '1':
            return x509OidCodeUnknown
        if oid[10] != '3':
            return x509OidCodeUnknown
        if oid[11] != '5':
            return x509OidCodeUnknown
        if oid[12] != '4':
            return x509OidCodeUnknown
        if oid[13] != '9':
            return x509OidCodeUnknown
        if oid[14] != '.':
            return x509OidCodeUnknown
        if oid[15] != '1':
            return x509OidCodeUnknown
        if oid[16] != '.':
            return x509OidCodeUnknown
        if oid[17] != '1':
            return x509OidCodeUnknown
        if oid[18] != '.':
            return x509OidCodeUnknown
        if oid[19] != '1':
            return x509OidCodeUnknown
        if oid[20] == '0':
            return x509OidCodeRsaPss
        if oid[20] == '1':
            return x509OidCodeSha256WithRsa
        if oid[20] == '2':
            return x509OidCodeSha384WithRsa
        return x509OidCodeUnknown
    if n == 22:
        if oid[0] != '2':
            return x509OidCodeUnknown
        if oid[1] != '.':
            return x509OidCodeUnknown
        if oid[2] != '1':
            return x509OidCodeUnknown
        if oid[3] != '6':
            return x509OidCodeUnknown
        if oid[4] != '.':
            return x509OidCodeUnknown
        if oid[5] != '8':
            return x509OidCodeUnknown
        if oid[6] != '4':
            return x509OidCodeUnknown
        if oid[7] != '0':
            return x509OidCodeUnknown
        if oid[8] != '.':
            return x509OidCodeUnknown
        if oid[9] != '1':
            return x509OidCodeUnknown
        if oid[10] != '.':
            return x509OidCodeUnknown
        if oid[11] != '1':
            return x509OidCodeUnknown
        if oid[12] != '0':
            return x509OidCodeUnknown
        if oid[13] != '1':
            return x509OidCodeUnknown
        if oid[14] != '.':
            return x509OidCodeUnknown
        if oid[15] != '3':
            return x509OidCodeUnknown
        if oid[16] != '.':
            return x509OidCodeUnknown
        if oid[17] != '4':
            return x509OidCodeUnknown
        if oid[18] != '.':
            return x509OidCodeUnknown
        if oid[19] != '2':
            return x509OidCodeUnknown
        if oid[20] != '.':
            return x509OidCodeUnknown
        if oid[21] == '1':
            return x509OidCodeSha256
        if oid[21] == '2':
            return x509OidCodeSha384
        return x509OidCodeUnknown
    if n == 17:
        if oid[0] != '1' || oid[1] != '.':
            return x509OidCodeUnknown
        if oid[2] == '2':
            if oid[3] != '.':
                return x509OidCodeUnknown
            if oid[4] != '8':
                return x509OidCodeUnknown
            if oid[5] != '4':
                return x509OidCodeUnknown
            if oid[6] != '0':
                return x509OidCodeUnknown
            if oid[7] != '.':
                return x509OidCodeUnknown
            if oid[8] != '1':
                return x509OidCodeUnknown
            if oid[9] != '0':
                return x509OidCodeUnknown
            if oid[10] != '0':
                return x509OidCodeUnknown
            if oid[11] != '4':
                return x509OidCodeUnknown
            if oid[12] != '5':
                return x509OidCodeUnknown
            if oid[13] != '.':
                return x509OidCodeUnknown
            if oid[14] != '2':
                return x509OidCodeUnknown
            if oid[15] != '.':
                return x509OidCodeUnknown
            if oid[16] != '1':
                return x509OidCodeUnknown
            return x509OidCodeEcdsaPublicKey
        if oid[2] == '3':
            if oid[3] != '.':
                return x509OidCodeUnknown
            if oid[4] != '6':
                return x509OidCodeUnknown
            if oid[5] != '.':
                return x509OidCodeUnknown
            if oid[6] != '1':
                return x509OidCodeUnknown
            if oid[7] != '.':
                return x509OidCodeUnknown
            if oid[8] != '5':
                return x509OidCodeUnknown
            if oid[9] != '.':
                return x509OidCodeUnknown
            if oid[10] != '5':
                return x509OidCodeUnknown
            if oid[11] != '.':
                return x509OidCodeUnknown
            if oid[12] != '7':
                return x509OidCodeUnknown
            if oid[13] != '.':
                return x509OidCodeUnknown
            if oid[14] != '3':
                return x509OidCodeUnknown
            if oid[15] != '.':
                return x509OidCodeUnknown
            if oid[16] != '1':
                return x509OidCodeUnknown
            return x509OidCodeServerAuth
        return x509OidCodeUnknown
    if n == 19:
        if oid[0] != '1':
            return x509OidCodeUnknown
        if oid[1] != '.':
            return x509OidCodeUnknown
        if oid[2] != '2':
            return x509OidCodeUnknown
        if oid[3] != '.':
            return x509OidCodeUnknown
        if oid[4] != '8':
            return x509OidCodeUnknown
        if oid[5] != '4':
            return x509OidCodeUnknown
        if oid[6] != '0':
            return x509OidCodeUnknown
        if oid[7] != '.':
            return x509OidCodeUnknown
        if oid[8] != '1':
            return x509OidCodeUnknown
        if oid[9] != '0':
            return x509OidCodeUnknown
        if oid[10] != '0':
            return x509OidCodeUnknown
        if oid[11] != '4':
            return x509OidCodeUnknown
        if oid[12] != '5':
            return x509OidCodeUnknown
        if oid[13] != '.':
            return x509OidCodeUnknown
        if oid[14] == '3':
            if oid[15] != '.':
                return x509OidCodeUnknown
            if oid[16] != '1':
                return x509OidCodeUnknown
            if oid[17] != '.':
                return x509OidCodeUnknown
            if oid[18] == '7':
                return x509OidCodePrime256v1
            return x509OidCodeUnknown
        if oid[14] == '4':
            if oid[15] != '.':
                return x509OidCodeUnknown
            if oid[16] != '3':
                return x509OidCodeUnknown
            if oid[17] != '.':
                return x509OidCodeUnknown
            if oid[18] == '2':
                return x509OidCodeEcdsaWithSha256
            if oid[18] == '3':
                return x509OidCodeEcdsaWithSha384
            return x509OidCodeUnknown
        return x509OidCodeUnknown
    if n == 9:
        if oid[0] != '2':
            return x509OidCodeUnknown
        if oid[1] != '.':
            return x509OidCodeUnknown
        if oid[2] != '5':
            return x509OidCodeUnknown
        if oid[3] != '.':
            return x509OidCodeUnknown
        if oid[4] != '2':
            return x509OidCodeUnknown
        if oid[5] != '9':
            return x509OidCodeUnknown
        if oid[6] != '.':
            return x509OidCodeUnknown
        if oid[7] != '1':
            return x509OidCodeUnknown
        if oid[8] == '9':
            return x509OidCodeBasicConstraints
        if oid[8] == '5':
            return x509OidCodeKeyUsage
        if oid[8] == '7':
            return x509OidCodeSubjectAltName
        return x509OidCodeUnknown
    if n == 10:
        if oid[0] != '2':
            return x509OidCodeUnknown
        if oid[1] != '.':
            return x509OidCodeUnknown
        if oid[2] != '5':
            return x509OidCodeUnknown
        if oid[3] != '.':
            return x509OidCodeUnknown
        if oid[4] != '2':
            return x509OidCodeUnknown
        if oid[5] != '9':
            return x509OidCodeUnknown
        if oid[6] != '.':
            return x509OidCodeUnknown
        if oid[7] != '3':
            return x509OidCodeUnknown
        if oid[8] != '7':
            return x509OidCodeUnknown
        return x509OidCodeExtKeyUsage
    return x509OidCodeUnknown

@borrows
fn x509OidToString(value: Bytes): Result[str] =
    if BytesLen(value) <= 0:
        return Err[str]("x509: oid empty")
    let first: int32 = BytesGet(value, 0)
    var arc0: int64
    var arc1: int64
    if first < 40:
        arc0 = 0
        arc1 = first
    elif first < 80:
        arc0 = 1
        arc1 = first - 40
    else:
        arc0 = 2
        arc1 = first - 80
    var out: str = x509IntToString(arc0)
    out = strutil.Join([out, "."], "")
    out = strutil.Join([out, x509IntToString(arc1)], "")
    var acc: int64
    for i in 1..<BytesLen(value):
        let b: int32 = BytesGet(value, i)
        # Low 7 bits are empty after shift; + is equivalent to | here.
        acc = (acc << 7) + int64(b & 0x7f)
        if (b & 0x80) == 0:
            out = strutil.Join([out, "."], "")
            out = strutil.Join([out, x509IntToString(acc)], "")
            acc = 0
    if BytesLen(value) > 1 && (BytesGet(value, BytesLen(value) - 1) & 0x80) != 0:
        return Err[str]("x509: oid truncated")
    return Ok[str](out)

@borrows
fn x509ReadOid(data: Bytes, offset: int32): Result[X509OidNext] =
    let tlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(data, offset)
    if IsErr(tlvRes):
        return Err[X509OidNext](Error(tlvRes))
    let tlvTlv = Value(tlvRes)
    let tlvTag: int32 = tlvTlv.tag
    let oidTagMismatch: bool = tlvTag != 0x06
    if oidTagMismatch:
        return Err[X509OidNext]("x509: expected oid")
    let tlvValue: Bytes = tlvTlv.value
    let oidRes: Result[str] = x509OidToString(tlvValue)
    if IsErr(oidRes):
        return Err[X509OidNext](Error(oidRes))
    var out: X509OidNext
    out.oid = Value(oidRes)
    out.next = tlvTlv.next
    return Ok[X509OidNext](out)

@borrows
fn x509DecodeBitString(data: Bytes, offset: int32): Result[X509BitStringNext] =
    let tlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(data, offset)
    if IsErr(tlvRes):
        return Err[X509BitStringNext](Error(tlvRes))
    let tlvTlv = Value(tlvRes)
    let tlvTag: int32 = tlvTlv.tag
    let bitStringTagMismatch: bool = tlvTag != 0x03
    if bitStringTagMismatch:
        return Err[X509BitStringNext]("x509: expected bit string")
    let tlvValue: Bytes = tlvTlv.value
    if BytesLen(tlvValue) <= 0:
        return Err[X509BitStringNext]("x509: bit string empty")
    let unused: int32 = BytesGet(tlvValue, 0)
    if unused < 0 || unused > 7:
        return Err[X509BitStringNext]("x509: bit string unused bits invalid")
    let payload: Bytes = BytesSlice(tlvValue, 1, BytesLen(tlvValue) - 1)
    var out: X509BitStringNext
    out.bytes = payload
    out.unused = unused
    out.next = tlvTlv.next
    return Ok[X509BitStringNext](out)

@borrows
fn x509ReadRawTlv(data: Bytes, offset: int32): Result[X509RawTlv] =
    let tlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(data, offset)
    if IsErr(tlvRes):
        return Err[X509RawTlv](Error(tlvRes))
    let tlvTlv = Value(tlvRes)
    let tlvTag: int32 = tlvTlv.tag
    let tlvNext: int32 = tlvTlv.next
    let tlvValue: Bytes = tlvTlv.value
    let raw: Bytes = BytesSlice(data, offset, tlvNext - offset)
    if BytesLen(raw) <= 0:
        var msg: str = "x509: raw tlv empty"
        msg = strutil.Join([msg, " tag="], "")
        msg = strutil.Join([msg, x509IntToString(int64(tlvTag))], "")
        msg = strutil.Join([msg, " offset="], "")
        msg = strutil.Join([msg, x509IntToString(int64(offset))], "")
        msg = strutil.Join([msg, " next="], "")
        msg = strutil.Join([msg, x509IntToString(int64(tlvNext))], "")
        msg = strutil.Join([msg, " dataLen="], "")
        msg = strutil.Join([msg, x509IntToString(int64(BytesLen(data)))], "")
        return Err[X509RawTlv](msg)
    var out: X509RawTlv
    out.tag = tlvTag
    out.raw = raw
    out.value = tlvValue
    out.next = tlvNext
    return Ok[X509RawTlv](out)

@borrows
fn x509SigAlgCodeFromOid(oid: str): int32 =
    let oidCode: int32 = x509OidCode(oid)
    if oidCode == x509OidCodeSha256WithRsa:
        return int32(X509SigRsaSha256)
    if oidCode == x509OidCodeSha384WithRsa:
        return int32(X509SigRsaSha384)
    if oidCode == x509OidCodeEcdsaWithSha256:
        return int32(X509SigEcdsaSha256)
    if oidCode == x509OidCodeEcdsaWithSha384:
        return int32(X509SigEcdsaSha384)
    if oidCode == x509OidCodeRsaPss:
        return int32(X509SigRsaPss)
    return int32(X509SigUnknown)

@borrows
fn x509SigAlgFromOid(oid: str): X509SignatureKind =
    let code: int32 = x509SigAlgCodeFromOid(oid)
    if code == int32(X509SigRsaSha256):
        return X509SigRsaSha256
    if code == int32(X509SigRsaSha384):
        return X509SigRsaSha384
    if code == int32(X509SigEcdsaSha256):
        return X509SigEcdsaSha256
    if code == int32(X509SigEcdsaSha384):
        return X509SigEcdsaSha384
    if code == int32(X509SigRsaPss):
        return X509SigRsaPss
    return X509SigUnknown

@borrows
fn x509HashKindCodeFromOid(oid: str): int32 =
    let oidCode: int32 = x509OidCode(oid)
    if oidCode == x509OidCodeSha256:
        return int32(X509HashSha256)
    if oidCode == x509OidCodeSha384:
        return int32(X509HashSha384)
    return int32(X509HashUnknown)

@borrows
fn x509HashKindFromOid(oid: str): X509HashKind =
    let code: int32 = x509HashKindCodeFromOid(oid)
    if code == int32(X509HashSha256):
        return X509HashSha256
    if code == int32(X509HashSha384):
        return X509HashSha384
    return X509HashUnknown

fn x509HashLen(hash: X509HashKind): int32 =
    return x509HashLenCode(int32(hash))

@borrows
fn x509ParseMgf1Hash(value: Bytes): Result[int32] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(value, 0)
    if IsErr(seqRes):
        return Err[int32](Error(seqRes))
    let seqValue: Bytes = Value(seqRes).value
    var inner: int32
    let oidRes: Result[X509OidNext] = x509ReadOid(seqValue, inner)
    if IsErr(oidRes):
        return Err[int32](Error(oidRes))
    let oidTlv = Value(oidRes)
    let algOid: str = oidTlv.oid
    let algOidCode: int32 = x509OidCode(algOid)
    if algOidCode != x509OidCodeMgf1:
        return Err[int32]("x509: unsupported mgf")
    inner = oidTlv.next
    if inner >= BytesLen(seqValue):
        return Err[int32]("x509: mgf1 missing hash")
    let hashAlgRes: Result[Asn1TagValueNext] = asn1DecodeTlv(seqValue, inner)
    if IsErr(hashAlgRes):
        return Err[int32](Error(hashAlgRes))
    let hashAlgTlv = Value(hashAlgRes)
    let hashTag: int32 = hashAlgTlv.tag
    let hashAlgNotSequence: bool = hashTag != 0x30
    if hashAlgNotSequence:
        return Err[int32]("x509: mgf1 hash alg ! sequence")
    let hashValue: Bytes = hashAlgTlv.value
    let hashOidRes: Result[X509OidNext] = x509ReadOid(hashValue, 0)
    if IsErr(hashOidRes):
        return Err[int32](Error(hashOidRes))
    let hashCode: int32 = x509HashKindCodeFromOid(Value(hashOidRes).oid)
    if hashCode == int32(X509HashUnknown):
        return Err[int32]("x509: mgf1 hash unsupported")
    if hashCode == int32(X509HashSha384):
        return Ok[int32](int32(X509HashSha384))
    return Ok[int32](int32(X509HashSha256))

@borrows
fn x509ParsePssParams(value: Bytes): Result[X509HashSaltLen] =
    var hashCode: int32
    var mgfCode: int32
    var saltLen: int32 = -1
    var trailerField: int64 = 1
    var offset: int32
    while offset < BytesLen(value):
        let tlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(value, offset)
        if IsErr(tlvRes):
            return Err[X509HashSaltLen](Error(tlvRes))
        let tlv: Asn1TagValueNext = Value(tlvRes)
        let tlvTag: int32 = tlv.tag
        let tlvValue: Bytes = tlv.value
        if tlvTag == 0xa0:
            let algRes: Result[X509OidNext] = x509ParseAlgId(tlvValue, 0)
            if IsErr(algRes):
                return Err[X509HashSaltLen](Error(algRes))
            let alg: X509OidNext = Value(algRes)
            hashCode = x509HashKindCodeFromOid(alg.oid)
        elif tlvTag == 0xa1:
            let mgfRes: Result[int32] = x509ParseMgf1Hash(tlvValue)
            if IsErr(mgfRes):
                return Err[X509HashSaltLen](Error(mgfRes))
            mgfCode = Value(mgfRes)
        elif tlvTag == 0xa2:
            let lenRes: Result[minasn1.Asn1Int64Next] = asn1DecodeInt64(tlvValue, 0)
            if IsErr(lenRes):
                return Err[X509HashSaltLen](Error(lenRes))
            let parsedLen: minasn1.Asn1Int64Next = Value(lenRes)
            saltLen = int32(parsedLen.value)
        elif tlvTag == 0xa3:
            let trailerRes: Result[minasn1.Asn1Int64Next] = asn1DecodeInt64(tlvValue, 0)
            if IsErr(trailerRes):
                return Err[X509HashSaltLen](Error(trailerRes))
            let trailer: minasn1.Asn1Int64Next = Value(trailerRes)
            trailerField = trailer.value
        offset = tlv.next
    if trailerField != 1:
        return Err[X509HashSaltLen]("x509: unsupported pss trailer")
    if hashCode == 0:
        return Err[X509HashSaltLen]("x509: pss hash unsupported")
    if mgfCode == 0:
        return Err[X509HashSaltLen]("x509: pss mgf missing")
    if mgfCode != hashCode:
        return Err[X509HashSaltLen]("x509: pss mgf hash mismatch")
    let hashLen: int32 = x509HashLenCode(hashCode)
    if hashLen <= 0:
        return Err[X509HashSaltLen]("x509: pss hash length invalid")
    if saltLen < 0:
        saltLen = hashLen
    if saltLen != hashLen:
        return Err[X509HashSaltLen]("x509: pss salt length unsupported")
    var out: X509HashSaltLen
    out.hash = X509HashSha256
    if hashCode == int32(X509HashSha384):
        out.hash = X509HashSha384
    out.saltLen = saltLen
    return Ok[X509HashSaltLen](out)

@borrows
fn x509ParseSignatureAlgorithm(
    data: Bytes,
    offset: int32
): Result[X509SigAlgNext] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, offset)
    if IsErr(seqRes):
        panic("x509: sigalg sequence")
    let seqTlv = Value(seqRes)
    let seqValue: Bytes = seqTlv.value
    var inner: int32
    let oidRes: Result[X509OidNext] = x509ReadOid(seqValue, inner)
    if IsErr(oidRes):
        panic("x509: sigalg oid")
    let oidTlv = Value(oidRes)
    let algOid: str = oidTlv.oid
    inner = oidTlv.next
    let sigAlgCode: int32 = x509SigAlgCodeFromOid(algOid)
    var pssHashCode: int32 = int32(X509HashUnknown)
    var pssSaltLen: int32 = -1
    if sigAlgCode == int32(X509SigRsaPss):
        if inner >= BytesLen(seqValue):
            return Err[X509SigAlgNext]("x509: pss params missing")
        let paramRes: Result[Asn1TagValueNext] = asn1DecodeTlv(seqValue, inner)
        if IsErr(paramRes):
            return Err[X509SigAlgNext](Error(paramRes))
        let paramTlv = Value(paramRes)
        let paramTag: int32 = paramTlv.tag
        let paramNotSequence: bool = paramTag != 0x30
        if paramNotSequence:
            return Err[X509SigAlgNext]("x509: pss params ! sequence")
        let paramValue: Bytes = paramTlv.value
        let pssRes: Result[X509HashSaltLen] = x509ParsePssParams(paramValue)
        if IsErr(pssRes):
            return Err[X509SigAlgNext](Error(pssRes))
        let pss: X509HashSaltLen = Value(pssRes)
        if pss.hash == X509HashSha256:
            pssHashCode = int32(X509HashSha256)
        elif pss.hash == X509HashSha384:
            pssHashCode = int32(X509HashSha384)
        else:
            pssHashCode = int32(X509HashUnknown)
        pssSaltLen = pss.saltLen
    elif sigAlgCode == int32(X509SigUnknown):
        panic("x509: sigalg unknown oid")
    var out: X509SigAlgNext
    out.sigAlg = X509SigUnknown
    if sigAlgCode == int32(X509SigRsaSha256):
        out.sigAlg = X509SigRsaSha256
    elif sigAlgCode == int32(X509SigRsaSha384):
        out.sigAlg = X509SigRsaSha384
    elif sigAlgCode == int32(X509SigEcdsaSha256):
        out.sigAlg = X509SigEcdsaSha256
    elif sigAlgCode == int32(X509SigEcdsaSha384):
        out.sigAlg = X509SigEcdsaSha384
    elif sigAlgCode == int32(X509SigRsaPss):
        out.sigAlg = X509SigRsaPss
    out.pssHash = X509HashUnknown
    if pssHashCode == int32(X509HashSha256):
        out.pssHash = X509HashSha256
    elif pssHashCode == int32(X509HashSha384):
        out.pssHash = X509HashSha384
    out.pssSaltLen = pssSaltLen
    out.next = seqTlv.next
    return Ok[X509SigAlgNext](out)

@borrows
fn x509ParseAlgId(data: Bytes, offset: int32): Result[X509OidNext] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, offset)
    if IsErr(seqRes):
        return Err[X509OidNext](Error(seqRes))
    let seqTlv = Value(seqRes)
    let seqValue: Bytes = seqTlv.value
    let oidRes: Result[X509OidNext] = x509ReadOid(seqValue, 0)
    if IsErr(oidRes):
        return Err[X509OidNext](Error(oidRes))
    var out: X509OidNext
    out.oid = Value(oidRes).oid
    out.next = seqTlv.next
    return Ok[X509OidNext](out)

@borrows
fn x509ParseAlgIdWithParam(data: Bytes, offset: int32): Result[X509AlgIdParamNext] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, offset)
    if IsErr(seqRes):
        return Err[X509AlgIdParamNext](Error(seqRes))
    let seqTlv = Value(seqRes)
    let seqValue: Bytes = seqTlv.value
    let oidRes: Result[X509OidNext] = x509ReadOid(seqValue, 0)
    if IsErr(oidRes):
        return Err[X509AlgIdParamNext](Error(oidRes))
    let oidTlv = Value(oidRes)
    let inner: int32 = oidTlv.next
    var out: X509AlgIdParamNext
    out.oid = oidTlv.oid
    out.paramOid = ""
    out.next = seqTlv.next
    if inner >= BytesLen(seqValue):
        return Ok[X509AlgIdParamNext](out)
    let paramTlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(seqValue, inner)
    if IsErr(paramTlvRes):
        return Ok[X509AlgIdParamNext](out)
    let paramTlvTlv = Value(paramTlvRes)
    let paramTag: int32 = paramTlvTlv.tag
    let oidParamMismatch: bool = paramTag != 0x06
    if oidParamMismatch:
        return Ok[X509AlgIdParamNext](out)
    let paramValue: Bytes = paramTlvTlv.value
    let paramOidRes: Result[str] = x509OidToString(paramValue)
    if IsOk(paramOidRes):
        out.paramOid = Value(paramOidRes)
    return Ok[X509AlgIdParamNext](out)

fn x509Digit(c: char): int32 =
    if c < '0' || c > '9':
        return -1
    return int32(c) - int32('0')

@borrows
fn x509Parse2(text: str, pos: int32): Result[int32] =
    let d1: int32 = x509Digit(text[pos])
    let d2: int32 = x509Digit(text[pos + 1])
    if d1 < 0 || d2 < 0:
        return Err[int32]("x509: invalid time digit")
    return Ok[int32](d1 * 10 + d2)

@borrows
fn x509Parse4(text: str, pos: int32): Result[int32] =
    let a: int32 = x509Digit(text[pos])
    let b: int32 = x509Digit(text[pos + 1])
    let c: int32 = x509Digit(text[pos + 2])
    let d: int32 = x509Digit(text[pos + 3])
    if a < 0 || b < 0 || c < 0 || d < 0:
        return Err[int32]("x509: invalid time digit")
    return Ok[int32](((a * 10 + b) * 10 + c) * 10 + d)

fn x509IsLeap(year: int32): bool =
    if (year % 4) != 0:
        return false
    if (year % 100) != 0:
        return true
    return (year % 400) == 0

fn x509DaysInMonth(year: int32, month: int32): int32 =
    if month < 1 || month > x509MonthsInYear:
        return 0
    if month == 2 && x509IsLeap(year):
        return 29
    if month == 1:
        return 31
    if month == 2:
        return 28
    if month == 3:
        return 31
    if month == 4:
        return 30
    if month == 5:
        return 31
    if month == 6:
        return 30
    if month == 7:
        return 31
    if month == 8:
        return 31
    if month == 9:
        return 30
    if month == 10:
        return 31
    if month == 11:
        return 30
    if month == 12:
        return 31
    return 0

fn x509DaysBeforeYear(year: int32): int64 =
    var y: int32 = 1970
    var days: int64
    for y in y..<year:
        var yearDays: int64 = 365
        if x509IsLeap(y):
            yearDays = 366
        days = days + yearDays
    return days

fn x509DaysBeforeMonth(year: int32, month: int32): int32 =
    var m: int32 = 1
    var days: int32
    for m in m..<month:
        days = days + x509DaysInMonth(year, m)
    return days

fn x509ToEpoch(year: int32, month: int32, day: int32, hour: int32, minute: int32, second: int32): Result[int64] =
    if year < 1970:
        return Err[int64]("x509: time before epoch")
    if month < 1 || month > 12:
        return Err[int64]("x509: invalid time month")
    let maxDay: int32 = x509DaysInMonth(year, month)
    if day < 1 || day > maxDay:
        return Err[int64]("x509: invalid time day")
    if hour < 0 || hour > 23:
        return Err[int64]("x509: invalid time hour")
    if minute < 0 || minute > 59:
        return Err[int64]("x509: invalid time minute")
    if second < 0 || second > 59:
        return Err[int64]("x509: invalid time second")
    let days: int64 = x509DaysBeforeYear(year) + int64(x509DaysBeforeMonth(year, month) + (day - 1))
    let total: int64 = days * 86400 + int64(hour * 3600 + minute * 60 + second)
    return Ok[int64](total)

@borrows
fn x509ParseTimeBytes(data: Bytes, tag: int32): Result[int64] =
    let text: str = BytesToString(data)
    if len(text) <= 0:
        return Err[int64]("x509: empty time")
    if text[len(text) - 1] != 'Z':
        return Err[int64]("x509: time missing Z")
    if tag == 0x17:
        if len(text) != 11 && len(text) != 13:
            return Err[int64]("x509: utc time length")
        let yearRes: Result[int32] = x509Parse2(text, 0)
        if IsErr(yearRes):
            return Err[int64](Error(yearRes))
        let yy: int32 = Value(yearRes)
        let year: int32 = if yy >= 50: 1900 + yy else: 2000 + yy
        let monRes: Result[int32] = x509Parse2(text, 2)
        if IsErr(monRes):
            return Err[int64](Error(monRes))
        let dayRes: Result[int32] = x509Parse2(text, 4)
        if IsErr(dayRes):
            return Err[int64](Error(dayRes))
        let hourRes: Result[int32] = x509Parse2(text, 6)
        if IsErr(hourRes):
            return Err[int64](Error(hourRes))
        let minRes: Result[int32] = x509Parse2(text, 8)
        if IsErr(minRes):
            return Err[int64](Error(minRes))
        var sec: int32
        if len(text) == 13:
            let secRes: Result[int32] = x509Parse2(text, 10)
            if IsErr(secRes):
                return Err[int64](Error(secRes))
            sec = Value(secRes)
        return x509ToEpoch(year, Value(monRes), Value(dayRes), Value(hourRes), Value(minRes), sec)
    if tag == 0x18:
        if len(text) != 13 && len(text) != 15:
            return Err[int64]("x509: generalized time length")
        let yearRes: Result[int32] = x509Parse4(text, 0)
        if IsErr(yearRes):
            return Err[int64](Error(yearRes))
        let monRes: Result[int32] = x509Parse2(text, 4)
        if IsErr(monRes):
            return Err[int64](Error(monRes))
        let dayRes: Result[int32] = x509Parse2(text, 6)
        if IsErr(dayRes):
            return Err[int64](Error(dayRes))
        let hourRes: Result[int32] = x509Parse2(text, 8)
        if IsErr(hourRes):
            return Err[int64](Error(hourRes))
        let minRes: Result[int32] = x509Parse2(text, 10)
        if IsErr(minRes):
            return Err[int64](Error(minRes))
        var sec: int32
        if len(text) == 15:
            let secRes: Result[int32] = x509Parse2(text, 12)
            if IsErr(secRes):
                return Err[int64](Error(secRes))
            sec = Value(secRes)
        return x509ToEpoch(Value(yearRes), Value(monRes), Value(dayRes), Value(hourRes), Value(minRes), sec)
    return Err[int64]("x509: unsupported time tag")

@borrows
fn x509ParseTime(data: Bytes, offset: int32): Result[minasn1.Asn1Int64Next] =
    let tlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(data, offset)
    if IsErr(tlvRes):
        return Err[minasn1.Asn1Int64Next](Error(tlvRes))
    let tlvTlv = Value(tlvRes)
    let tlvTag: int32 = tlvTlv.tag
    let tlvValue: Bytes = tlvTlv.value
    let tlvNext: int32 = tlvTlv.next
    if tlvTag != 0x17 && tlvTag != 0x18:
        return Err[minasn1.Asn1Int64Next]("x509: invalid time tag")
    let timeRes: Result[int64] = x509ParseTimeBytes(tlvValue, tlvTag)
    if IsErr(timeRes):
        return Err[minasn1.Asn1Int64Next](Error(timeRes))
    var out: minasn1.Asn1Int64Next
    out.value = Value(timeRes)
    out.next = tlvNext
    return Ok[minasn1.Asn1Int64Next](out)

@borrows
fn x509ParseTimeAt(data: Bytes, offset: int32, outValue: var int64, outNext: var int32): Result[bool] =
    let tlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(data, offset)
    if IsErr(tlvRes):
        return Err[bool](Error(tlvRes))
    let tlvTlv = Value(tlvRes)
    let tlvTag: int32 = tlvTlv.tag
    let tlvValue: Bytes = tlvTlv.value
    let tlvNext: int32 = tlvTlv.next
    if tlvTag != 0x17 && tlvTag != 0x18:
        return Err[bool]("x509: invalid time tag")
    let timeRes: Result[int64] = x509ParseTimeBytes(tlvValue, tlvTag)
    if IsErr(timeRes):
        return Err[bool](Error(timeRes))
    outValue = Value(timeRes)
    outNext = tlvNext
    return Ok[bool](true)

@borrows
fn x509ParseKeyUsage(value: Bytes): Result[int32] =
    if BytesLen(value) <= 0:
        return Err[int32]("x509: keyusage empty")
    let unused: int32 = BytesGet(value, 0)
    if unused < 0 || unused > 7:
        return Err[int32]("x509: keyusage unused bits invalid")
    let totalBits: int32 = (BytesLen(value) - 1) * 8 - unused
    var mask: int32
    if totalBits <= 0:
        return Ok[int32](0)
    let b0: int32 = BytesGet(value, 1)
    if totalBits > 0:
        mask = mask | ((b0 >> 7) & 1)
    if totalBits > 2:
        mask = mask | (((b0 >> 5) & 1) << 2)
    if totalBits > 5:
        mask = mask | (((b0 >> 2) & 1) << 5)
    return Ok[int32](mask)

fn x509ParseSpki(spkiValue: Bytes): Result[X509PublicKey] =
    let algRes: Result[X509AlgIdParamNext] = x509ParseAlgIdWithParam(spkiValue, 0)
    if IsErr(algRes):
        return Err[X509PublicKey](Error(algRes))
    let algTlv = Value(algRes)
    let algOid: str = algTlv.oid
    let algParamOid: str = algTlv.paramOid
    let algOidCode: int32 = x509OidCode(algOid)
    let algParamOidCode: int32 = x509OidCode(algParamOid)
    let spkOffset: int32 = algTlv.next
    let spkRes: Result[X509BitStringNext] = x509DecodeBitString(spkiValue, spkOffset)
    if IsErr(spkRes):
        return Err[X509PublicKey](Error(spkRes))
    let spkBytes: Bytes = Value(spkRes).bytes
    if algOidCode == x509OidCodeRsaEncryption:
        let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(spkBytes, 0)
        if IsErr(seqRes):
            return Err[X509PublicKey](Error(seqRes))
        let seqValue: Bytes = Value(seqRes).value
        var inner: int32
        let nRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, inner)
        if IsErr(nRes):
            return Err[X509PublicKey](Error(nRes))
        let nTlv = Value(nRes)
        inner = nTlv.next
        let eRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, inner)
        if IsErr(eRes):
            return Err[X509PublicKey](Error(eRes))
        let nBytes: Bytes = nTlv.value
        let eBytes: Bytes = Value(eRes).value
        let rsaPartsValid: bool = rsaPublicKeyPartsValid(nBytes, eBytes)
        if ! rsaPartsValid:
            return Err[X509PublicKey]("x509: invalid rsa public key")
        var out: X509PublicKey
        initX509PublicKeyInto(out)
        out.kind = X509KeyRsa
        out.rsaN = nBytes
        out.rsaE = eBytes
        return Ok[X509PublicKey](out)
    if algOidCode == x509OidCodeEcdsaPublicKey:
        if algParamOidCode != x509OidCodePrime256v1:
            return Err[X509PublicKey]("x509: unsupported ec curve")
        var ecdsaPoint: ecnist.EcPoint
        let ecdsaRes: Result[bool] = ecnist.ecdsaParsePublicKeyPointBytes(spkBytes, true, ecdsaPoint)
        if IsErr(ecdsaRes):
            return Err[X509PublicKey](strutil.Join(["x509: invalid ecdsa public key: ", ErrorText(ecdsaRes)], ""))
        var out: X509PublicKey
        initX509PublicKeyInto(out)
        out.kind = X509KeyEcdsaP256
        out.ecdsaBytes = spkBytes
        return Ok[X509PublicKey](out)
    return Err[X509PublicKey]("x509: unsupported public key")

@borrows
fn x509ParseSpkiInto(out: var X509PublicKey, spkiValue: Bytes): Result[bool] =
    initX509PublicKeyInto(out)
    let algRes: Result[X509AlgIdParamNext] = x509ParseAlgIdWithParam(spkiValue, 0)
    if IsErr(algRes):
        return Err[bool](Error(algRes))
    let algTlv = Value(algRes)
    let algOid: str = algTlv.oid
    let algParamOid: str = algTlv.paramOid
    let algOidCode: int32 = x509OidCode(algOid)
    let algParamOidCode: int32 = x509OidCode(algParamOid)
    let spkOffset: int32 = algTlv.next
    let spkRes: Result[X509BitStringNext] = x509DecodeBitString(spkiValue, spkOffset)
    if IsErr(spkRes):
        return Err[bool](Error(spkRes))
    let spkBytes: Bytes = Value(spkRes).bytes
    if algOidCode == x509OidCodeRsaEncryption:
        let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(spkBytes, 0)
        if IsErr(seqRes):
            return Err[bool](Error(seqRes))
        let seqValue: Bytes = Value(seqRes).value
        var inner: int32
        let nRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, inner)
        if IsErr(nRes):
            return Err[bool](Error(nRes))
        let nTlv = Value(nRes)
        inner = nTlv.next
        let eRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, inner)
        if IsErr(eRes):
            return Err[bool](Error(eRes))
        let nBytes: Bytes = nTlv.value
        let eBytes: Bytes = Value(eRes).value
        let rsaPartsValid: bool = rsaPublicKeyPartsValid(nBytes, eBytes)
        if ! rsaPartsValid:
            return Err[bool]("x509: invalid rsa public key")
        out.kind = X509KeyRsa
        out.rsaN = nBytes
        out.rsaE = eBytes
        return Ok[bool](true)
    if algOidCode == x509OidCodeEcdsaPublicKey:
        if algParamOidCode != x509OidCodePrime256v1:
            return Err[bool]("x509: unsupported ec curve")
        var ecdsaPoint: ecnist.EcPoint
        let ecdsaRes: Result[bool] = ecnist.ecdsaParsePublicKeyPointBytes(spkBytes, true, ecdsaPoint)
        if IsErr(ecdsaRes):
            return Err[bool](strutil.Join(["x509: invalid ecdsa public key: ", ErrorText(ecdsaRes)], ""))
        out.kind = X509KeyEcdsaP256
        out.ecdsaBytes = spkBytes
        return Ok[bool](true)
    return Err[bool]("x509: unsupported public key")

@borrows
fn x509ParseBasicConstraintsExtension(extData: Bytes, cert: var X509Certificate): Result[bool] =
    let bcSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(extData, 0)
    if IsErr(bcSeqRes):
        return Err[bool]("x509: extensions basic constraints")
    let bcValue: Bytes = Value(bcSeqRes).value
    let bcLen: int32 = BytesLen(bcValue)
    if bcLen <= 0:
        return Ok[bool](true)
    let bcFirstRes: Result[Asn1TagValueNext] = asn1DecodeTlv(bcValue, 0)
    if IsErr(bcFirstRes):
        return Err[bool]("x509: extensions basic constraints first")
    let bcFirst: Asn1TagValueNext = Value(bcFirstRes)
    let bcFirstIsBoolean: bool = bcFirst.tag == 0x01
    if bcFirstIsBoolean:
        if BytesLen(bcFirst.value) == 1:
            cert.isCa = BytesGet(bcFirst.value, 0) != 0
    return Ok[bool](true)

@borrows
fn x509ParseKeyUsageExtension(extData: Bytes, cert: var X509Certificate): Result[bool] =
    let kuRes: Result[Asn1TagValueNext] = asn1DecodeTlv(extData, 0)
    if IsErr(kuRes):
        return Err[bool]("x509: extensions key usage")
    let kuTlv = Value(kuRes)
    let kuTag: int32 = kuTlv.tag
    let kuTagMismatch: bool = kuTag != 0x03
    if kuTagMismatch:
        return Err[bool]("x509: keyusage ! bit string")
    let maskRes: Result[int32] = x509ParseKeyUsage(kuTlv.value)
    if IsErr(maskRes):
        return Err[bool]("x509: extensions key usage mask")
    cert.keyUsage = Value(maskRes)
    return Ok[bool](true)

@borrows
fn x509ParseExtKeyUsageExtension(extData: Bytes, cert: var X509Certificate): Result[bool] =
    let ekuSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(extData, 0)
    if IsErr(ekuSeqRes):
        return Err[bool]("x509: extensions ext key usage")
    let ekuValue: Bytes = Value(ekuSeqRes).value
    let ekuLen: int32 = BytesLen(ekuValue)
    var ekuOff: int32
    while ekuOff < ekuLen:
        let ekuOidRes: Result[X509OidNext] = x509ReadOid(ekuValue, ekuOff)
        if IsErr(ekuOidRes):
            return Err[bool]("x509: extensions ext key usage oid")
        let ekuOid: X509OidNext = Value(ekuOidRes)
        cert.extKeyUsageCount = cert.extKeyUsageCount + 1
        let ekuOidCode: int32 = x509OidCode(ekuOid.oid)
        if ekuOidCode == x509OidCodeServerAuth:
            cert.hasServerAuthEku = true
        ekuOff = ekuOid.next
    return Ok[bool](true)

@borrows
fn x509ParseSubjectAltNameExtension(extData: Bytes, cert: var X509Certificate): Result[bool] =
    let sanSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(extData, 0)
    if IsErr(sanSeqRes):
        return Err[bool]("x509: extensions san")
    let sanValue: Bytes = Value(sanSeqRes).value
    if BytesLen(cert.dnsNamesDer) <= 0:
        cert.dnsNamesDer = sanValue
    else:
        let oldDnsNamesDer: Bytes = cert.dnsNamesDer
        let mergedDnsNamesDer: Bytes = BytesConcat(oldDnsNamesDer, sanValue)
        cert.dnsNamesDer = mergedDnsNamesDer
    let sanLen: int32 = BytesLen(sanValue)
    var sanOff: int32
    while sanOff < sanLen:
        let gnRes: Result[Asn1TagValueNext] = asn1DecodeTlv(sanValue, sanOff)
        if IsErr(gnRes):
            return Err[bool]("x509: extensions san name")
        let gn: Asn1TagValueNext = Value(gnRes)
        if gn.tag == 0x82:
            cert.dnsNameCount = cert.dnsNameCount + 1
        sanOff = gn.next
    return Ok[bool](true)

@borrows
fn x509ParseExtensions(data: Bytes, cert: var X509Certificate): Result[bool] =
    let dataLen: int32 = BytesLen(data)
    var offset: int32
    while offset < dataLen:
        let extRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, offset)
        if IsErr(extRes):
            return Err[bool]("x509: extensions ext sequence")
        let ext: Asn1ValueNext = Value(extRes)
        let extValue: Bytes = ext.value
        let extValueLen: int32 = BytesLen(extValue)
        offset = ext.next
        var inner: int32
        let oidRes: Result[X509OidNext] = x509ReadOid(extValue, inner)
        if IsErr(oidRes):
            return Err[bool]("x509: extensions oid")
        let oidNext: X509OidNext = Value(oidRes)
        let oid: str = oidNext.oid
        let oidCode: int32 = x509OidCode(oid)
        inner = oidNext.next
        var critical: bool
        if inner < extValueLen:
            let critRes: Result[Asn1TagValueNext] = asn1DecodeTlv(extValue, inner)
            if IsOk(critRes):
                let critTlv: Asn1TagValueNext = Value(critRes)
                let critTag: int32 = critTlv.tag
                if critTag == 0x01:
                    if BytesLen(critTlv.value) == 1 && BytesGet(critTlv.value, 0) != 0:
                        critical = true
                    inner = critTlv.next
        let valRes: Result[Asn1TagValueNext] = asn1DecodeTlv(extValue, inner)
        if IsErr(valRes):
            return Err[bool]("x509: extensions value")
        let valTlv: Asn1TagValueNext = Value(valRes)
        let valTag: int32 = valTlv.tag
        if valTag != 0x04:
            return Err[bool]("x509: extension value ! octet string")
        let extData: Bytes = valTlv.value
        if oidCode == x509OidCodeBasicConstraints:
            cert.hasBasicConstraints = true
            let bcRes: Result[bool] = x509ParseBasicConstraintsExtension(extData, cert)
            if IsErr(bcRes):
                return Err[bool](Error(bcRes))
        elif oidCode == x509OidCodeKeyUsage:
            cert.hasKeyUsage = true
            let kuRes: Result[bool] = x509ParseKeyUsageExtension(extData, cert)
            if IsErr(kuRes):
                return Err[bool](Error(kuRes))
        elif oidCode == x509OidCodeExtKeyUsage:
            let ekuRes: Result[bool] = x509ParseExtKeyUsageExtension(extData, cert)
            if IsErr(ekuRes):
                return Err[bool](Error(ekuRes))
        elif oidCode == x509OidCodeSubjectAltName:
            let sanRes: Result[bool] = x509ParseSubjectAltNameExtension(extData, cert)
            if IsErr(sanRes):
                return Err[bool](Error(sanRes))
        else:
            if critical:
                cert.hasUnknownCritical = true
    return Ok[bool](true)

fn x509ParseTbs(tbsValue: Bytes, cert: var X509Certificate): Result[bool] =
    var offset: int32
    if offset < BytesLen(tbsValue) && BytesGet(tbsValue, offset) == 160:
        let verRes: Result[Asn1TagValueNext] = asn1DecodeTlv(tbsValue, offset)
        if IsErr(verRes):
            return Err[bool](strutil.Join(["x509: tbs version: ", ErrorText(verRes)], ""))
        offset = Value(verRes).next
    let serialRes: Result[Asn1ValueNext] = asn1DecodeInteger(tbsValue, offset)
    if IsErr(serialRes):
        return Err[bool](strutil.Join(["x509: tbs serial: ", ErrorText(serialRes)], ""))
    let serialTlv = Value(serialRes)
    cert.serial = serialTlv.value
    offset = serialTlv.next
    let sigRes: Result[X509SigAlgNext] = x509ParseSignatureAlgorithm(tbsValue, offset)
    if IsErr(sigRes):
        return Err[bool](strutil.Join(["x509: tbs signature algorithm: ", ErrorText(sigRes)], ""))
    let sigTlv = Value(sigRes)
    cert.tbsSigAlg = sigTlv.sigAlg
    cert.tbsPssHash = sigTlv.pssHash
    cert.tbsPssSaltLen = sigTlv.pssSaltLen
    offset = sigTlv.next
    let issuerRes: Result[X509RawTlv] = x509ReadRawTlv(tbsValue, offset)
    if IsErr(issuerRes):
        return Err[bool](strutil.Join(["x509: tbs issuer: ", ErrorText(issuerRes)], ""))
    let issuerTlv = Value(issuerRes)
    let issuerTag: int32 = issuerTlv.tag
    if issuerTag != 48:
        return Err[bool]("x509: issuer ! sequence")
    cert.issuer = issuerTlv.raw
    offset = issuerTlv.next
    let validRes: Result[Asn1ValueNext] = asn1DecodeSequence(tbsValue, offset)
    if IsErr(validRes):
        return Err[bool](strutil.Join(["x509: tbs validity: ", ErrorText(validRes)], ""))
    let validTlv = Value(validRes)
    let validValue: Bytes = validTlv.value
    var vOff: int32
    var notBeforeSeconds: int64
    var notBeforeNext: int32
    let notBeforeRes: Result[bool] = x509ParseTimeAt(validValue, vOff, notBeforeSeconds, notBeforeNext)
    if IsErr(notBeforeRes):
        return Err[bool](strutil.Join(["x509: tbs notBefore: ", ErrorText(notBeforeRes)], ""))
    vOff = notBeforeNext
    var notAfterSeconds: int64
    var notAfterNext: int32
    let notAfterRes: Result[bool] = x509ParseTimeAt(validValue, vOff, notAfterSeconds, notAfterNext)
    if IsErr(notAfterRes):
        return Err[bool](strutil.Join(["x509: tbs notAfter: ", ErrorText(notAfterRes)], ""))
    cert.notBefore = notBeforeSeconds
    cert.notAfter = notAfterSeconds
    offset = validTlv.next
    let subjectRes: Result[X509RawTlv] = x509ReadRawTlv(tbsValue, offset)
    if IsErr(subjectRes):
        return Err[bool](strutil.Join(["x509: tbs subject: ", ErrorText(subjectRes)], ""))
    let subjectTlv = Value(subjectRes)
    let subjectTag: int32 = subjectTlv.tag
    if subjectTag != 48:
        return Err[bool]("x509: subject ! sequence")
    cert.subject = subjectTlv.raw
    offset = subjectTlv.next
    let spkiRes: Result[Asn1ValueNext] = asn1DecodeSequence(tbsValue, offset)
    if IsErr(spkiRes):
        return Err[bool](strutil.Join(["x509: tbs spki: ", ErrorText(spkiRes)], ""))
    let spkiTlv = Value(spkiRes)
    let spkiValue: Bytes = spkiTlv.value
    let keyRes: Result[bool] = x509ParseSpkiInto(cert.publicKey, spkiValue)
    if IsErr(keyRes):
        return Err[bool](strutil.Join(["x509: tbs public key: ", ErrorText(keyRes)], ""))
    offset = spkiTlv.next
    while offset < BytesLen(tbsValue):
        let extraRes: Result[Asn1TagValueNext] = asn1DecodeTlv(tbsValue, offset)
        if IsErr(extraRes):
            return Err[bool](strutil.Join(["x509: tbs extra: ", ErrorText(extraRes)], ""))
        let extraTlv = Value(extraRes)
        let extraTag: int32 = extraTlv.tag
        let extraValue: Bytes = extraTlv.value
        if extraTag == 163:
            let extSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(extraValue, 0)
            if IsErr(extSeqRes):
                return Err[bool](strutil.Join(["x509: tbs extensions: ", ErrorText(extSeqRes)], ""))
            let extSeqValue: Bytes = Value(extSeqRes).value
            let extRes: Result[bool] = x509ParseExtensions(extSeqValue, cert)
            if IsErr(extRes):
                return Err[bool](strutil.Join(["x509: tbs extensions body: ", ErrorText(extRes)], ""))
        offset = extraTlv.next
    return Ok[bool](true)

fn x509ParseCertificate(data: Bytes): Result[X509Certificate] =
    let certRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, 0)
    if IsErr(certRes):
        return Err[X509Certificate](Error(certRes))
    let certValue: Bytes = Value(certRes).value
    var offset: int32
    let tbsRes: Result[X509RawTlv] = x509ReadRawTlv(certValue, offset)
    if IsErr(tbsRes):
        return Err[X509Certificate](Error(tbsRes))
    let tbsTlv = Value(tbsRes)
    let tbsTag: int32 = tbsTlv.tag
    let tbsRaw: Bytes = tbsTlv.raw
    let tbsValue: Bytes = rawbytes.BytesSlice(tbsTlv.value, 0, rawbytes.BytesLen(tbsTlv.value))
    if tbsTag != 0x30:
        return Err[X509Certificate]("x509: tbs ! sequence")
    offset = tbsTlv.next
    let sigAlgRes: Result[X509SigAlgNext] = x509ParseSignatureAlgorithm(certValue, offset)
    if IsErr(sigAlgRes):
        return Err[X509Certificate](Error(sigAlgRes))
    let sigAlgTlv = Value(sigAlgRes)
    offset = sigAlgTlv.next
    let sigRes: Result[X509BitStringNext] = x509DecodeBitString(certValue, offset)
    if IsErr(sigRes):
        return Err[X509Certificate](Error(sigRes))
    let sigTlv = Value(sigRes)
    var cert: X509Certificate = initX509Certificate()
    cert.der = data
    cert.tbs.data = tbsRaw.data
    cert.tbs.len = tbsRaw.len
    cert.signature.data = sigTlv.bytes.data
    cert.signature.len = sigTlv.bytes.len
    cert.sigAlg = sigAlgTlv.sigAlg
    cert.pssHash = sigAlgTlv.pssHash
    cert.pssSaltLen = sigAlgTlv.pssSaltLen
    let tbsParseRes: Result[bool] = x509ParseTbs(tbsValue, cert)
    if IsErr(tbsParseRes):
        return Err[X509Certificate](Error(tbsParseRes))
    if cert.publicKey.kind == X509KeyUnknown:
        return Err[X509Certificate]("x509: public key missing")
    if cert.sigAlg == X509SigUnknown:
        return Err[X509Certificate]("x509: signature algorithm unsupported")
    if cert.tbsSigAlg != X509SigUnknown && cert.tbsSigAlg != cert.sigAlg:
        return Err[X509Certificate]("x509: signature algorithm mismatch")
    if cert.sigAlg == X509SigRsaPss:
        if cert.tbsPssHash != X509HashUnknown && cert.tbsPssHash != cert.pssHash:
            return Err[X509Certificate]("x509: pss hash mismatch")
        if cert.tbsPssSaltLen >= 0 && cert.tbsPssSaltLen != cert.pssSaltLen:
            return Err[X509Certificate]("x509: pss salt length mismatch")
    return Ok[X509Certificate](cert)

@borrows
fn x509ParseCertificateInto(out: var X509Certificate, der: Bytes): Result[bool] =
    # NOTE: Avoid assigning to the `var` parameter itself here.
    # Some backends treat `out = ...` as rebinding a local alias, which can drop
    # writes to the caller-provided certificate object.
    let certRes: Result[Asn1ValueNext] = asn1DecodeSequence(der, 0)
    if IsErr(certRes):
        return Err[bool](Error(certRes))
    let certValue: Bytes = Value(certRes).value
    var offset: int32
    let tbsRes: Result[X509RawTlv] = x509ReadRawTlv(certValue, offset)
    if IsErr(tbsRes):
        return Err[bool](strutil.Join(["x509: cert tbs: ", ErrorText(tbsRes)], ""))
    let tbsTlv = Value(tbsRes)
    let tbsTag: int32 = tbsTlv.tag
    let tbsRaw: Bytes = tbsTlv.raw
    let tbsValue: Bytes = rawbytes.BytesSlice(tbsTlv.value, 0, rawbytes.BytesLen(tbsTlv.value))
    if tbsTag != 0x30:
        return Err[bool]("x509: tbs ! sequence")
    offset = tbsTlv.next
    let sigAlgRes: Result[X509SigAlgNext] = x509ParseSignatureAlgorithm(certValue, offset)
    if IsErr(sigAlgRes):
        return Err[bool](strutil.Join(["x509: cert signature algorithm: ", ErrorText(sigAlgRes)], ""))
    let sigAlgTlv = Value(sigAlgRes)
    offset = sigAlgTlv.next
    let sigRes: Result[X509BitStringNext] = x509DecodeBitString(certValue, offset)
    if IsErr(sigRes):
        return Err[bool](strutil.Join(["x509: cert signature value: ", ErrorText(sigRes)], ""))
    let sigTlv = Value(sigRes)
    out.der = der
    out.tbs.data = tbsRaw.data
    out.tbs.len = tbsRaw.len
    out.signature.data = sigTlv.bytes.data
    out.signature.len = sigTlv.bytes.len
    out.sigAlg = sigAlgTlv.sigAlg
    out.pssHash = sigAlgTlv.pssHash
    out.pssSaltLen = sigAlgTlv.pssSaltLen
    let tbsParseRes: Result[bool] = x509ParseTbs(tbsValue, out)
    if IsErr(tbsParseRes):
        return Err[bool](strutil.Join(["x509: cert tbs body: ", ErrorText(tbsParseRes)], ""))
    if out.publicKey.kind == X509KeyUnknown:
        return Err[bool]("x509: public key missing")
    if out.sigAlg == X509SigUnknown:
        return Err[bool]("x509: signature algorithm unsupported")
    if out.tbsSigAlg != X509SigUnknown && out.tbsSigAlg != out.sigAlg:
        return Err[bool]("x509: signature algorithm mismatch")
    if out.sigAlg == X509SigRsaPss:
        if out.tbsPssHash != X509HashUnknown && out.tbsPssHash != out.pssHash:
            return Err[bool]("x509: pss hash mismatch")
        if out.tbsPssSaltLen >= 0 && out.tbsPssSaltLen != out.pssSaltLen:
            return Err[bool]("x509: pss salt length mismatch")
    return Ok[bool](true)

@borrows
fn x509CertListAddDer(list: var X509CertList, der: Bytes): Result[bool] =
    if list.count >= x509MaxChain:
        return Err[bool]("x509: cert list full")
    let idx: int32 = list.count
    var cert: X509Certificate = initX509Certificate()
    let parseRes: Result[bool] = x509ParseCertificateInto(cert, der)
    if IsErr(parseRes):
        return Err[bool](Error(parseRes))
    let storeRes: Result[bool] = x509CertListSetDerAt(list, idx, der)
    if IsErr(storeRes):
        return Err[bool](Error(storeRes))
    list.count = list.count + 1
    return Ok[bool](true)

fn x509LeftPad(data: Bytes, length: int32): Result[Bytes] =
    if BytesLen(data) > length:
        return Err[Bytes]("x509: integer too large")
    let out: Bytes = BytesAlloc(length)
    let offset: int32 = length - BytesLen(data)
    for i in 0..<BytesLen(data):
        BytesSet(out, offset + i, BytesGet(data, i))
    return Ok[Bytes](out)

@borrows
fn x509DecodeEcdsaSignature(sig: Bytes): Result[Bytes] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(sig, 0)
    if IsErr(seqRes):
        return Err[Bytes](Error(seqRes))
    let seqValue: Bytes = Value(seqRes).value
    let rRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, 0)
    if IsErr(rRes):
        return Err[Bytes](Error(rRes))
    let rNext: Asn1ValueNext = Value(rRes)
    let rBytes: Bytes = rNext.value
    let rLen: int32 = BytesLen(rBytes)
    if rLen > 32:
        return Err[Bytes]("x509: integer too large")
    let out: Bytes = BytesAlloc(64)
    let rBase: int32 = 32 - rLen
    for i in 0..<rLen:
        BytesSet(out, rBase + i, BytesGet(rBytes, i))
    let sRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, rNext.next)
    if IsErr(sRes):
        return Err[Bytes](Error(sRes))
    let sNext: Asn1ValueNext = Value(sRes)
    let sBytes: Bytes = sNext.value
    let sLen: int32 = BytesLen(sBytes)
    if sLen > 32:
        return Err[Bytes]("x509: integer too large")
    let sBase: int32 = 64 - sLen
    for i in 0..<sLen:
        BytesSet(out, sBase + i, BytesGet(sBytes, i))
    return Ok[Bytes](out)

fn x509VerifySignature(cert: var X509Certificate, issuer: var X509Certificate): Result[bool] =
    if cert.sigAlg == X509SigUnknown:
        return Err[bool]("x509: unsupported signature algorithm kind=unknown")
    if cert.sigAlg == X509SigRsaSha256 || cert.sigAlg == X509SigRsaSha384:
        if issuer.publicKey.kind != X509KeyRsa:
            return Err[bool]("x509: rsa signature with non-rsa issuer")
        let useSha384: bool = cert.sigAlg == X509SigRsaSha384
        return rsaVerifyPkcs1Bytes(issuer.publicKey.rsaN, issuer.publicKey.rsaE, cert.tbs, cert.signature, useSha384)
    if cert.sigAlg == X509SigRsaPss:
        if issuer.publicKey.kind != X509KeyRsa:
            return Err[bool]("x509: rsa pss with non-rsa issuer")
        if cert.pssHash != X509HashSha256 && cert.pssHash != X509HashSha384:
            return Err[bool]("x509: rsa pss hash unsupported")
        let useSha384: bool = cert.pssHash == X509HashSha384
        return rsaVerifyPssBytes(issuer.publicKey.rsaN, issuer.publicKey.rsaE, cert.tbs, cert.signature, useSha384)
    if cert.sigAlg == X509SigEcdsaSha256:
        if issuer.publicKey.kind != X509KeyEcdsaP256:
            return Err[bool]("x509: ecdsa signature with non-ecdsa issuer")
        x509DebugWriteLine("x509 debug: ecdsa signature decode begin")
        let sigRes: Result[Bytes] = x509DecodeEcdsaSignature(cert.signature)
        if IsErr(sigRes):
            return Err[bool](Error(sigRes))
        x509DebugWriteLine("x509 debug: ecdsa signature verify begin")
        let ok: bool = ecdsaVerifyTrustedBytes(issuer.publicKey.ecdsaBytes, cert.tbs, Value(sigRes))
        x509DebugWriteLine(strutil.Join(["x509 debug: ecdsa signature verify ok=", x509BoolToString(ok)], ""))
        return Ok[bool](ok)
    if cert.sigAlg == X509SigEcdsaSha384:
        return Err[bool]("x509: ecdsa sha384 unsupported")
    return Err[bool](strutil.Join(["x509: unsupported signature algorithm kind=", x509IntToString(int64(cert.sigAlg))], ""))

fn x509VerifyValidity(cert: var X509Certificate, now: int64): Result[bool] =
    if cert.notBefore > 0 && now < cert.notBefore:
        return Err[bool]("x509: ! yet valid")
    if cert.notAfter > 0 && now > cert.notAfter:
        return Err[bool]("x509: expired")
    return Ok[bool](true)

fn x509VerifyLeafConstraints(cert: var X509Certificate): Result[bool] =
    let hasUnknownCritical: bool = cert.hasUnknownCritical
    if hasUnknownCritical:
        return Err[bool]("x509: unknown critical extension")
    let basicConstraintsAsCa: bool = cert.hasBasicConstraints && cert.isCa
    if basicConstraintsAsCa:
        return Err[bool](strutil.Join([
            "x509: leaf marked as ca has_bc=",
            x509BoolToString(cert.hasBasicConstraints),
            " is_ca=",
            x509BoolToString(cert.isCa),
            " key_usage=",
            x509IntToString(int64(cert.keyUsage)),
            " eku_count=",
            x509IntToString(int64(cert.extKeyUsageCount)),
            " dns_count=",
            x509IntToString(int64(cert.dnsNameCount))
        ], ""))
    let hasKeyUsage: bool = cert.hasKeyUsage
    let digitalSignatureBits: int32 = cert.keyUsage & x509KeyUsageDigitalSignature
    if hasKeyUsage:
        let missingDigitalSignature: bool = digitalSignatureBits == 0
        if missingDigitalSignature:
            return Err[bool]("x509: leaf missing digitalSignature")
    let hasExtKeyUsage: bool = cert.extKeyUsageCount > 0
    let missingServerAuth: bool = ! cert.hasServerAuthEku
    if hasExtKeyUsage:
        if missingServerAuth:
            return Err[bool]("x509: leaf missing serverAuth eku")
    return Ok[bool](true)

fn x509VerifyCaConstraints(cert: var X509Certificate): Result[bool] =
    let hasUnknownCritical: bool = cert.hasUnknownCritical
    if hasUnknownCritical:
        return Err[bool]("x509: ca has unknown critical extension")
    let missingBasicConstraints: bool = ! cert.hasBasicConstraints
    if missingBasicConstraints:
        return Err[bool]("x509: ca basicConstraints missing")
    let notCa: bool = ! cert.isCa
    if notCa:
        return Err[bool]("x509: ca basicConstraints missing")
    let hasKeyUsage: bool = cert.hasKeyUsage
    let keyCertSignBits: int32 = cert.keyUsage & x509KeyUsageKeyCertSign
    if hasKeyUsage:
        let missingKeyCertSign: bool = keyCertSignBits == 0
        if missingKeyCertSign:
            return Err[bool]("x509: ca missing keyCertSign")
    return Ok[bool](true)

fn x509IsSelfSigned(cert: var X509Certificate): bool =
    return BytesEqual(cert.issuer, cert.subject)

fn x509VerifySelfSigned(cert: var X509Certificate): Result[bool] =
    if ! x509IsSelfSigned(cert):
        return Err[bool]("x509: ! self-signed")
    let sigRes: Result[bool] = x509VerifySignature(cert, cert)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    if ! Value(sigRes):
        return Err[bool]("x509: self-signature invalid")
    return Ok[bool](true)

fn x509VerifyChain(leaf: var X509Certificate, intermediates: var X509CertList, roots: var X509CertList, now: int64): Result[bool] =
    x509DebugWriteLine("x509 debug: chain begin")
    let leafTimeRes: Result[bool] = x509VerifyValidity(leaf, now)
    if IsErr(leafTimeRes):
        let leafTimeErr: str = Error(leafTimeRes)
        return Err[bool](leafTimeErr)
    x509DebugWriteLine("x509 debug: leaf validity ok")
    let pinnedSelfSignedLeaf: bool = x509IsSelfSigned(leaf) && x509CertListFindBySubjectIndex(roots, leaf.subject) >= 0
    x509DebugWriteLine(strutil.Join(["x509 debug: pinned_self_signed=", x509BoolToString(pinnedSelfSignedLeaf)], ""))
    if !pinnedSelfSignedLeaf:
        let leafRes: Result[bool] = x509VerifyLeafConstraints(leaf)
        if IsErr(leafRes):
            let leafErr: str = Error(leafRes)
            return Err[bool](leafErr)
    x509DebugWriteLine("x509 debug: leaf constraints ok")
    for pinnedIdx in 0..<roots.count:
        x509DebugWriteLine(strutil.Join(["x509 debug: pinned compare idx=", x509IntToString(int64(pinnedIdx))], ""))
        var pinnedLeaf: X509Certificate = initX509Certificate()
        let pinnedRes: Result[bool] = x509CertListCertAtInto(pinnedLeaf, roots, pinnedIdx)
        if IsErr(pinnedRes):
            return Err[bool](ErrorText(pinnedRes))
        if BytesEqual(leaf.tbs, pinnedLeaf.tbs) && BytesEqual(leaf.signature, pinnedLeaf.signature):
            return Ok[bool](true)
    var current: X509Certificate = initX509Certificate()
    x509CertificateCopyInto(current, leaf)
    var depth: int32
    for _ in depth..<x509MaxChain:
        x509DebugWriteLine(strutil.Join(["x509 debug: chain depth=", x509IntToString(int64(depth))], ""))
        if ! (depth < x509MaxChain):
            break
        if x509IsSelfSigned(current):
            x509DebugWriteLine("x509 debug: current self-signed")
            let anchorIdx: int32 = x509CertListFindBySubjectIndex(roots, current.subject)
            if anchorIdx < 0:
                return Err[bool]("x509: self-signed ! trusted")
            var anchorPtr: X509Certificate = initX509Certificate()
            let anchorRes: Result[bool] = x509CertListCertAtInto(anchorPtr, roots, anchorIdx)
            if IsErr(anchorRes):
                return Err[bool](ErrorText(anchorRes))
            let caRes: Result[bool] = x509VerifyCaConstraints(anchorPtr)
            if IsErr(caRes):
                let caErr: str = Error(caRes)
                return Err[bool](caErr)
            let caTimeRes: Result[bool] = x509VerifyValidity(anchorPtr, now)
            if IsErr(caTimeRes):
                let caTimeErr: str = Error(caTimeRes)
                return Err[bool](caTimeErr)
            if BytesEqual(current.tbs, anchorPtr.tbs) && BytesEqual(current.signature, anchorPtr.signature):
                return Ok[bool](true)
            let sigRes: Result[bool] = x509VerifySignature(current, anchorPtr)
            if IsErr(sigRes):
                let sigErr: str = Error(sigRes)
                return Err[bool](strutil.Join(["x509: trust anchor signature: ", sigErr], ""))
            if ! Value(sigRes):
                return Err[bool]("x509: trust anchor signature invalid")
            return Ok[bool](true)
        let issuerIdx: int32 = x509CertListFindBySubjectIndex(intermediates, current.issuer)
        x509DebugWriteLine(strutil.Join(["x509 debug: intermediate issuer_idx=", x509IntToString(int64(issuerIdx))], ""))
        if issuerIdx >= 0:
            var issuerPtr: X509Certificate = initX509Certificate()
            let issuerRes: Result[bool] = x509CertListCertAtInto(issuerPtr, intermediates, issuerIdx)
            if IsErr(issuerRes):
                return Err[bool](ErrorText(issuerRes))
            let caRes: Result[bool] = x509VerifyCaConstraints(issuerPtr)
            if IsErr(caRes):
                let caErr: str = Error(caRes)
                return Err[bool](caErr)
            let caTimeRes: Result[bool] = x509VerifyValidity(issuerPtr, now)
            if IsErr(caTimeRes):
                let caTimeErr: str = Error(caTimeRes)
                return Err[bool](caTimeErr)
            let sigRes: Result[bool] = x509VerifySignature(current, issuerPtr)
            if IsErr(sigRes):
                let sigErr: str = Error(sigRes)
                return Err[bool](strutil.Join(["x509: chain signature: ", sigErr], ""))
            if ! Value(sigRes):
                if current.sigAlg == X509SigRsaSha256 || current.sigAlg == X509SigRsaSha384:
                    let useSha384: bool = current.sigAlg == X509SigRsaSha384
                    let diagRes: Result[bool] = rsaVerifyPkcs1DiagBytes(
                        issuerPtr.publicKey.rsaN,
                        issuerPtr.publicKey.rsaE,
                        current.tbs,
                        current.signature,
                        useSha384
                    )
                    if IsErr(diagRes):
                        let diagErr: str = Error(diagRes)
                        return Err[bool](strutil.Join(["x509: signature invalid: ", diagErr], ""))
                return Err[bool]("x509: signature invalid")
            x509CertificateCopyInto(current, issuerPtr)
            depth = depth + 1
            continue
        let rootIdx: int32 = x509CertListFindBySubjectIndex(roots, current.issuer)
        x509DebugWriteLine(strutil.Join(["x509 debug: root_idx=", x509IntToString(int64(rootIdx))], ""))
        if rootIdx >= 0:
            x509DebugWriteLine("x509 debug: root branch begin")
            var rootPtr: X509Certificate = initX509Certificate()
            x509DebugWriteLine("x509 debug: root alloc ok")
            let rootRes: Result[bool] = x509CertListCertAtInto(rootPtr, roots, rootIdx)
            if IsErr(rootRes):
                return Err[bool](ErrorText(rootRes))
            x509DebugWriteLine(strutil.Join([
                "x509 debug: root load ok is_ca=",
                x509BoolToString(rootPtr.isCa),
                " sig_alg=",
                x509IntToString(int64(current.sigAlg))
            ], ""))
            let caRes: Result[bool] = x509VerifyCaConstraints(rootPtr)
            if IsErr(caRes):
                let caErr: str = Error(caRes)
                return Err[bool](caErr)
            x509DebugWriteLine("x509 debug: root ca ok")
            let caTimeRes: Result[bool] = x509VerifyValidity(rootPtr, now)
            if IsErr(caTimeRes):
                let caTimeErr: str = Error(caTimeRes)
                return Err[bool](caTimeErr)
            x509DebugWriteLine("x509 debug: root validity ok")
            let sigRes: Result[bool] = x509VerifySignature(current, rootPtr)
            if IsErr(sigRes):
                let sigErr: str = Error(sigRes)
                return Err[bool](strutil.Join(["x509: root signature: ", sigErr], ""))
            x509DebugWriteLine(strutil.Join(["x509 debug: root signature result=", x509BoolToString(Value(sigRes))], ""))
            if ! Value(sigRes):
                if current.sigAlg == X509SigRsaSha256 || current.sigAlg == X509SigRsaSha384:
                    let useSha384: bool = current.sigAlg == X509SigRsaSha384
                    let diagRes: Result[bool] = rsaVerifyPkcs1DiagBytes(
                        rootPtr.publicKey.rsaN,
                        rootPtr.publicKey.rsaE,
                        current.tbs,
                        current.signature,
                        useSha384
                    )
                    if IsErr(diagRes):
                        let diagErr: str = Error(diagRes)
                        return Err[bool](strutil.Join(["x509: signature invalid: ", diagErr], ""))
                return Err[bool]("x509: signature invalid")
            return Ok[bool](true)
        return Err[bool]("x509: issuer ! found")
    return Err[bool]("x509: chain too deep")

@borrows
fn x509LowerAscii(text: str): str =
    if len(text) <= 0:
        return ""
    let out: Bytes = BytesAlloc(len(text))
    for i in 0..<len(text):
        let c: char = text[i]
        var v: int32 = int32(c)
        if v >= int32('A') && v <= int32('Z'):
            v = v + (int32('a') - int32('A'))
        BytesSet(out, i, v)
    return BytesToString(out)

@borrows
@borrow_result
fn x509TrimTrailingDot(text: str): str =
    if len(text) <= 0:
        return text
    if text[len(text) - 1] != '.':
        return text
    return sliceBytes(text, 0, len(text) - 1)

@borrows
fn x509EndsWith(text: str, suffix: str): bool =
    let tlen: int32 = len(text)
    let slen: int32 = len(suffix)
    if slen <= 0:
        return true
    if tlen < slen:
        return false
    for i in 0..<slen:
        if text[tlen - slen + i] != suffix[i]:
            return false
    return true

@borrows
fn x509MatchDnsName(host: str, pattern: str): bool =
    if len(pattern) <= 0:
        return false
    if len(pattern) > 2 && pattern[0] == '*' && pattern[1] == '.':
        let suffix: str = sliceBytes(pattern, 2, len(pattern) - 2)
        if ! x509EndsWith(host, suffix):
            return false
        let prefixLen: int32 = len(host) - len(suffix)
        if prefixLen <= 1:
            return false
        if host[prefixLen - 1] != '.':
            return false
        for i in 0..<prefixLen - 1:
            if host[i] == '.':
                return false
        return true
    return (host == pattern)

@borrows
fn x509VerifyHostname(cert: var X509Certificate, host: str): bool =
    let normalized: str = x509TrimTrailingDot(x509LowerAscii(host))
    if len(normalized) <= 0:
        return false
    if cert.dnsNameCount <= 0:
        return false
    var sanOff: int32
    while sanOff < BytesLen(cert.dnsNamesDer):
        let gnRes: Result[Asn1TagValueNext] = asn1DecodeTlv(cert.dnsNamesDer, sanOff)
        if IsErr(gnRes):
            return false
        let gn = Value(gnRes)
        if gn.tag == 0x82:
            let entry: str = x509TrimTrailingDot(x509LowerAscii(BytesToString(gn.value)))
            if x509MatchDnsName(strings.CloneStr(normalized), entry):
                return true
        sanOff = gn.next
    return false

fn x509HashDigest(kind: X509HashKind, data: Bytes): Result[Bytes] =
    if kind == X509HashSha256:
        return Ok[Bytes](Sha256Digest(data))
    if kind == X509HashSha384:
        return Ok[Bytes](sha384Digest(data))
    return Err[Bytes]("x509: unsupported hash")

fn x509HashDigestCode(kindCode: int32, data: Bytes): Result[Bytes] =
    if kindCode == int32(X509HashSha256):
        return Ok[Bytes](Sha256Digest(data))
    if kindCode == int32(X509HashSha384):
        return Ok[Bytes](sha384Digest(data))
    return Err[Bytes]("x509: unsupported hash")

fn x509PublicKeyBytesInto(out: var Bytes, pub: X509PublicKey): Result[bool] =
    if pub.kind == X509KeyRsa:
        let nEnc: Bytes = asn1EncodeInteger(pub.rsaN)
        let eEnc: Bytes = asn1EncodeInteger(pub.rsaE)
        out = asn1EncodeSequence(BytesConcat(nEnc, eEnc))
        return Ok[bool](true)
    if pub.kind == X509KeyEcdsaP256:
        out = pub.ecdsaBytes
        return Ok[bool](true)
    return Err[bool]("x509: unsupported public key")

fn x509PublicKeyBytes(pub: X509PublicKey): Result[Bytes] =
    var out: Bytes
    let fillRes: Result[bool] = x509PublicKeyBytesInto(out, pub)
    if IsErr(fillRes):
        return Err[Bytes](Error(fillRes))
    return Ok[Bytes](out)

@borrows
fn x509VerifySignatureBytes(
    sigAlg: X509SignatureKind,
    pssHash: X509HashKind,
    issuer: X509Certificate,
    msg: Bytes,
    sig: Bytes
): Result[bool] =
    if sigAlg == X509SigRsaSha256 || sigAlg == X509SigRsaSha384:
        if issuer.publicKey.kind != X509KeyRsa:
            return Err[bool]("x509: rsa signature with non-rsa issuer")
        let useSha384: bool = sigAlg == X509SigRsaSha384
        return rsaVerifyPkcs1Bytes(issuer.publicKey.rsaN, issuer.publicKey.rsaE, msg, sig, useSha384)
    if sigAlg == X509SigRsaPss:
        if issuer.publicKey.kind != X509KeyRsa:
            return Err[bool]("x509: rsa pss with non-rsa issuer")
        if pssHash != X509HashSha256 && pssHash != X509HashSha384:
            return Err[bool]("x509: rsa pss hash unsupported")
        let useSha384: bool = pssHash == X509HashSha384
        return rsaVerifyPssBytes(issuer.publicKey.rsaN, issuer.publicKey.rsaE, msg, sig, useSha384)
    if sigAlg == X509SigEcdsaSha256:
        if issuer.publicKey.kind != X509KeyEcdsaP256:
            return Err[bool]("x509: ecdsa signature with non-ecdsa issuer")
        let sigRes: Result[Bytes] = x509DecodeEcdsaSignature(sig)
        if IsErr(sigRes):
            return Err[bool](Error(sigRes))
        return Ok[bool](ecdsaVerifyTrustedBytes(issuer.publicKey.ecdsaBytes, msg, Value(sigRes)))
    if sigAlg == X509SigEcdsaSha384:
        return Err[bool]("x509: ecdsa sha384 unsupported")
    return Err[bool](strutil.Join(["x509: unsupported signature algorithm kind=", x509IntToString(int64(sigAlg))], ""))

fn x509DecodeEnumerated(data: Bytes, offset: int32): Result[minasn1.Asn1Int64Next] =
    let tlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(data, offset)
    if IsErr(tlvRes):
        return Err[minasn1.Asn1Int64Next](Error(tlvRes))
    let tlv = Value(tlvRes)
    if tlv.tag != 0x0a:
        return Err[minasn1.Asn1Int64Next]("x509: expected enumerated")
    let vRes: Result[int64] = bytesToInt64(tlv.value)
    if IsErr(vRes):
        return Err[minasn1.Asn1Int64Next](Error(vRes))
    var decoded: minasn1.Asn1Int64Next
    decoded.value = Value(vRes)
    decoded.next = tlv.next
    return Ok[minasn1.Asn1Int64Next](decoded)

@borrows
fn x509CrlIsRevoked(crl: X509Crl, serial: Bytes): bool =
    if BytesLen(serial) <= 0:
        return false
    for i in 0..<crl.revokedCount:
        if BytesEqual(crl.revokedSerials[i], serial):
            return true
    return false

@borrows
fn x509ParseCrlTbs(tbsValue: Bytes): Result[X509Crl] =
    var crl: X509Crl
    initX509CrlInto(crl)
    var offset: int32
    let tbsLen: int32 = BytesLen(tbsValue)
    if offset < tbsLen:
        let firstTag: int32 = BytesGet(tbsValue, offset)
        if firstTag == 0xa0:
            let verRes: Result[Asn1TagValueNext] = asn1DecodeTlv(tbsValue, offset)
            if IsErr(verRes):
                return Err[X509Crl](Error(verRes))
            let verTlv: Asn1TagValueNext = Value(verRes)
            offset = verTlv.next
    let sigRes: Result[X509SigAlgNext] = x509ParseSignatureAlgorithm(tbsValue, offset)
    if IsErr(sigRes):
        return Err[X509Crl](Error(sigRes))
    let sigAlg: X509SigAlgNext = Value(sigRes)
    offset = sigAlg.next
    let issuerRes: Result[X509RawTlv] = x509ReadRawTlv(tbsValue, offset)
    if IsErr(issuerRes):
        return Err[X509Crl](Error(issuerRes))
    let issuerTlv: X509RawTlv = Value(issuerRes)
    let issuerNotSequence: bool = issuerTlv.tag != 0x30
    if issuerNotSequence:
        return Err[X509Crl]("x509: crl issuer ! sequence")
    crl.issuer = issuerTlv.raw
    offset = issuerTlv.next
    let thisRes: Result[minasn1.Asn1Int64Next] = x509ParseTime(tbsValue, offset)
    if IsErr(thisRes):
        return Err[X509Crl](Error(thisRes))
    let thisTime: minasn1.Asn1Int64Next = Value(thisRes)
    crl.thisUpdate = thisTime.value
    offset = thisTime.next
    if offset < tbsLen:
        let tag: int32 = BytesGet(tbsValue, offset)
        if tag == 0x17 || tag == 0x18:
            let nextRes: Result[minasn1.Asn1Int64Next] = x509ParseTime(tbsValue, offset)
            if IsErr(nextRes):
                return Err[X509Crl](Error(nextRes))
            let nextTime: minasn1.Asn1Int64Next = Value(nextRes)
            crl.nextUpdate = nextTime.value
            offset = nextTime.next
    if offset < tbsLen:
        let listTag: int32 = BytesGet(tbsValue, offset)
        if listTag == 0x30:
            let listRes: Result[Asn1ValueNext] = asn1DecodeSequence(tbsValue, offset)
            if IsErr(listRes):
                return Err[X509Crl](Error(listRes))
            let listSeq: Asn1ValueNext = Value(listRes)
            let listValue: Bytes = listSeq.value
            let listLen: int32 = BytesLen(listValue)
            var listOff: int32
            while listOff < listLen:
                let entryRes: Result[Asn1ValueNext] = asn1DecodeSequence(listValue, listOff)
                if IsErr(entryRes):
                    return Err[X509Crl](Error(entryRes))
                let entrySeq: Asn1ValueNext = Value(entryRes)
                let entryValue: Bytes = entrySeq.value
                var entryOff: int32
                let serialRes: Result[Asn1ValueNext] = asn1DecodeInteger(entryValue, entryOff)
                if IsErr(serialRes):
                    return Err[X509Crl](Error(serialRes))
                let serialValue: Asn1ValueNext = Value(serialRes)
                entryOff = serialValue.next
                let dateRes: Result[minasn1.Asn1Int64Next] = x509ParseTime(entryValue, entryOff)
                if IsErr(dateRes):
                    return Err[X509Crl](Error(dateRes))
                let revokeTime: minasn1.Asn1Int64Next = Value(dateRes)
                entryOff = revokeTime.next
                let addRes: Result[bool] = x509CrlAddRevoked(crl, serialValue.value)
                if IsErr(addRes):
                    return Err[X509Crl](Error(addRes))
                listOff = entrySeq.next
    return Ok[X509Crl](crl)

@borrows
fn x509VerifyCrl(der: Bytes, issuer: X509Certificate, now: int64): Result[X509Crl] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(der, 0)
    if IsErr(seqRes):
        return Err[X509Crl](Error(seqRes))
    let seqValue: Bytes = Value(seqRes).value
    var offset: int32
    let tbsRes: Result[X509RawTlv] = x509ReadRawTlv(seqValue, offset)
    if IsErr(tbsRes):
        return Err[X509Crl](Error(tbsRes))
    let tbsTlv = Value(tbsRes)
    offset = tbsTlv.next
    let sigAlgRes: Result[X509SigAlgNext] = x509ParseSignatureAlgorithm(seqValue, offset)
    if IsErr(sigAlgRes):
        return Err[X509Crl](Error(sigAlgRes))
    let sigAlgTlv = Value(sigAlgRes)
    offset = sigAlgTlv.next
    let sigRes: Result[X509BitStringNext] = x509DecodeBitString(seqValue, offset)
    if IsErr(sigRes):
        return Err[X509Crl](Error(sigRes))
    let sigTlv = Value(sigRes)
    let crlRes: Result[X509Crl] = x509ParseCrlTbs(tbsTlv.value)
    if IsErr(crlRes):
        return Err[X509Crl](Error(crlRes))
    var crl: X509Crl = Value(crlRes)
    if BytesLen(crl.issuer) <= 0 || ! BytesEqual(crl.issuer, issuer.subject):
        return Err[X509Crl]("x509: crl issuer mismatch")
    if now > 0:
        if crl.thisUpdate > 0 && now < crl.thisUpdate:
            return Err[X509Crl]("x509: crl ! yet valid")
        if crl.nextUpdate > 0 && now > crl.nextUpdate:
            return Err[X509Crl]("x509: crl expired")
    let verifyRes: Result[bool] = x509VerifySignatureBytes(sigAlgTlv.sigAlg, sigAlgTlv.pssHash, issuer, tbsTlv.raw, sigTlv.bytes)
    if IsErr(verifyRes):
        return Err[X509Crl](Error(verifyRes))
    if ! Value(verifyRes):
        return Err[X509Crl]("x509: crl signature invalid")
    return Ok[X509Crl](crl)

@borrows
fn x509VerifyOcspResponse(
    ocsp: Bytes,
    leaf: X509Certificate,
    issuer: X509Certificate,
    now: int64
): Result[X509RevocationStatus] =
    if BytesLen(ocsp) <= 0:
        return Err[X509RevocationStatus]("x509: ocsp empty")
    let respRes: Result[Asn1ValueNext] = asn1DecodeSequence(ocsp, 0)
    if IsErr(respRes):
        return Err[X509RevocationStatus](Error(respRes))
    let respSeq: Asn1ValueNext = Value(respRes)
    let respValue: Bytes = rawbytes.BytesSlice(respSeq.value, 0, rawbytes.BytesLen(respSeq.value))
    var offset: int32
    let statusRes: Result[minasn1.Asn1Int64Next] = x509DecodeEnumerated(respValue, offset)
    if IsErr(statusRes):
        return Err[X509RevocationStatus](Error(statusRes))
    let responseStatus: minasn1.Asn1Int64Next = Value(statusRes)
    let responseStatusCode: int64 = responseStatus.value
    offset = responseStatus.next
    if responseStatusCode != 0:
        return Err[X509RevocationStatus]("x509: ocsp response status")
    if offset >= BytesLen(respValue):
        return Err[X509RevocationStatus]("x509: ocsp response bytes missing")
    let bytesRes: Result[Asn1TagValueNext] = asn1DecodeTlv(respValue, offset)
    if IsErr(bytesRes):
        return Err[X509RevocationStatus](Error(bytesRes))
    let bytesTlv: Asn1TagValueNext = Value(bytesRes)
    if bytesTlv.tag != 0xa0:
        return Err[X509RevocationStatus]("x509: ocsp response bytes invalid")
    let rbSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(bytesTlv.value, 0)
    if IsErr(rbSeqRes):
        return Err[X509RevocationStatus](Error(rbSeqRes))
    let rbSeq: Asn1ValueNext = Value(rbSeqRes)
    let rbValue: Bytes = rawbytes.BytesSlice(rbSeq.value, 0, rawbytes.BytesLen(rbSeq.value))
    var rbOff: int32
    let typeRes: Result[X509OidNext] = x509ReadOid(rbValue, rbOff)
    if IsErr(typeRes):
        return Err[X509RevocationStatus](Error(typeRes))
    let responseType: X509OidNext = Value(typeRes)
    let responseTypeCode: int32 = x509OidCode(responseType.oid)
    if responseTypeCode != x509OidCodeOcspBasic:
        return Err[X509RevocationStatus]("x509: ocsp response type unsupported")
    rbOff = responseType.next
    let respOctetRes: Result[Asn1TagValueNext] = asn1DecodeTlv(rbValue, rbOff)
    if IsErr(respOctetRes):
        return Err[X509RevocationStatus](Error(respOctetRes))
    let respOctet: Asn1TagValueNext = Value(respOctetRes)
    let respOctetTag: int32 = respOctet.tag
    let respOctetTagMismatch: bool = respOctetTag != 0x04
    if respOctetTagMismatch:
        return Err[X509RevocationStatus]("x509: ocsp response ! octet string")
    let basicDer: Bytes = rawbytes.BytesSlice(respOctet.value, 0, rawbytes.BytesLen(respOctet.value))
    let basicSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(basicDer, 0)
    if IsErr(basicSeqRes):
        return Err[X509RevocationStatus](Error(basicSeqRes))
    let basicSeq: Asn1ValueNext = Value(basicSeqRes)
    let basicValue: Bytes = rawbytes.BytesSlice(basicSeq.value, 0, rawbytes.BytesLen(basicSeq.value))
    var bOff: int32
    let tbsRes: Result[X509RawTlv] = x509ReadRawTlv(basicValue, bOff)
    if IsErr(tbsRes):
        return Err[X509RevocationStatus](Error(tbsRes))
    let tbsTlv: X509RawTlv = Value(tbsRes)
    bOff = tbsTlv.next
    let sigAlgRes: Result[X509SigAlgNext] = x509ParseSignatureAlgorithm(basicValue, bOff)
    if IsErr(sigAlgRes):
        return Err[X509RevocationStatus](Error(sigAlgRes))
    let basicSigAlg: X509SigAlgNext = Value(sigAlgRes)
    bOff = basicSigAlg.next
    let sigRes: Result[X509BitStringNext] = x509DecodeBitString(basicValue, bOff)
    if IsErr(sigRes):
        return Err[X509RevocationStatus](Error(sigRes))
    let basicSig: X509BitStringNext = Value(sigRes)
    let verifyRes: Result[bool] = x509VerifySignatureBytes(basicSigAlg.sigAlg, basicSigAlg.pssHash, issuer, tbsTlv.raw, basicSig.bytes)
    if IsErr(verifyRes):
        return Err[X509RevocationStatus](Error(verifyRes))
    if ! Value(verifyRes):
        return Err[X509RevocationStatus]("x509: ocsp signature invalid")
    let tbsValue: Bytes = rawbytes.BytesSlice(tbsTlv.value, 0, rawbytes.BytesLen(tbsTlv.value))
    var rdOff: int32
    if rdOff < BytesLen(tbsValue) && BytesGet(tbsValue, rdOff) == 0xa0:
        let verRes: Result[Asn1TagValueNext] = asn1DecodeTlv(tbsValue, rdOff)
        if IsErr(verRes):
            return Err[X509RevocationStatus](Error(verRes))
        let verTlv: Asn1TagValueNext = Value(verRes)
        rdOff = verTlv.next
    let responderRes: Result[Asn1TagValueNext] = asn1DecodeTlv(tbsValue, rdOff)
    if IsErr(responderRes):
        return Err[X509RevocationStatus](Error(responderRes))
    let responderTlv: Asn1TagValueNext = Value(responderRes)
    rdOff = responderTlv.next
    let producedRes: Result[minasn1.Asn1Int64Next] = x509ParseTime(tbsValue, rdOff)
    if IsErr(producedRes):
        return Err[X509RevocationStatus](Error(producedRes))
    let producedTime: minasn1.Asn1Int64Next = Value(producedRes)
    rdOff = producedTime.next
    let responsesRes: Result[Asn1ValueNext] = asn1DecodeSequence(tbsValue, rdOff)
    if IsErr(responsesRes):
        return Err[X509RevocationStatus](Error(responsesRes))
    let responsesSeq: Asn1ValueNext = Value(responsesRes)
    let responsesValue: Bytes = rawbytes.BytesSlice(responsesSeq.value, 0, rawbytes.BytesLen(responsesSeq.value))
    if BytesLen(responsesValue) <= 0:
        return Err[X509RevocationStatus]("x509: ocsp response list empty")
    let singleRes: Result[Asn1ValueNext] = asn1DecodeSequence(responsesValue, 0)
    if IsErr(singleRes):
        return Err[X509RevocationStatus](Error(singleRes))
    let singleSeq: Asn1ValueNext = Value(singleRes)
    let singleValue: Bytes = rawbytes.BytesSlice(singleSeq.value, 0, rawbytes.BytesLen(singleSeq.value))
    var sOff: int32
    let certIdRes: Result[Asn1ValueNext] = asn1DecodeSequence(singleValue, sOff)
    if IsErr(certIdRes):
        return Err[X509RevocationStatus](Error(certIdRes))
    let certIdSeq: Asn1ValueNext = Value(certIdRes)
    sOff = certIdSeq.next
    let certIdValue: Bytes = rawbytes.BytesSlice(certIdSeq.value, 0, rawbytes.BytesLen(certIdSeq.value))
    var cOff: int32
    let hashAlgRes: Result[X509OidNext] = x509ParseAlgId(certIdValue, cOff)
    if IsErr(hashAlgRes):
        return Err[X509RevocationStatus](Error(hashAlgRes))
    let hashAlg: X509OidNext = Value(hashAlgRes)
    let hashCode: int32 = x509HashKindCodeFromOid(hashAlg.oid)
    if hashCode == int32(X509HashUnknown):
        return Err[X509RevocationStatus]("x509: ocsp hash unsupported")
    cOff = hashAlg.next
    let nameHashRes: Result[Asn1TagValueNext] = asn1DecodeTlv(certIdValue, cOff)
    if IsErr(nameHashRes):
        return Err[X509RevocationStatus](Error(nameHashRes))
    let nameHashTlv: Asn1TagValueNext = Value(nameHashRes)
    if nameHashTlv.tag != 0x04:
        return Err[X509RevocationStatus]("x509: ocsp name hash invalid")
    let nameHash: Bytes = rawbytes.BytesSlice(nameHashTlv.value, 0, rawbytes.BytesLen(nameHashTlv.value))
    cOff = nameHashTlv.next
    let keyHashRes: Result[Asn1TagValueNext] = asn1DecodeTlv(certIdValue, cOff)
    if IsErr(keyHashRes):
        return Err[X509RevocationStatus](Error(keyHashRes))
    let keyHashTlv: Asn1TagValueNext = Value(keyHashRes)
    if keyHashTlv.tag != 0x04:
        return Err[X509RevocationStatus]("x509: ocsp key hash invalid")
    let keyHash: Bytes = rawbytes.BytesSlice(keyHashTlv.value, 0, rawbytes.BytesLen(keyHashTlv.value))
    cOff = keyHashTlv.next
    let serialRes: Result[Asn1ValueNext] = asn1DecodeInteger(certIdValue, cOff)
    if IsErr(serialRes):
        return Err[X509RevocationStatus](Error(serialRes))
    let serialValue: Asn1ValueNext = Value(serialRes)
    let serial: Bytes = rawbytes.BytesSlice(serialValue.value, 0, rawbytes.BytesLen(serialValue.value))
    var expectName: Bytes = emptyBytes()
    if hashCode == int32(X509HashSha256):
        expectName = Sha256Digest(issuer.subject)
    elif hashCode == int32(X509HashSha384):
        expectName = sha384Digest(issuer.subject)
    else:
        return Err[X509RevocationStatus]("x509: ocsp hash unsupported")
    if ! BytesEqual(expectName, nameHash):
        return Err[X509RevocationStatus]("x509: ocsp issuer name hash mismatch")
    var issuerKeyBytes: Bytes = emptyBytes()
    if issuer.publicKey.kind == X509KeyRsa:
        let nEnc: Bytes = asn1EncodeInteger(issuer.publicKey.rsaN)
        let eEnc: Bytes = asn1EncodeInteger(issuer.publicKey.rsaE)
        issuerKeyBytes = asn1EncodeSequence(BytesConcat(nEnc, eEnc))
    elif issuer.publicKey.kind == X509KeyEcdsaP256:
        issuerKeyBytes = issuer.publicKey.ecdsaBytes
    else:
        return Err[X509RevocationStatus]("x509: unsupported public key")
    var expectKey: Bytes = emptyBytes()
    if hashCode == int32(X509HashSha256):
        expectKey = Sha256Digest(issuerKeyBytes)
    elif hashCode == int32(X509HashSha384):
        expectKey = sha384Digest(issuerKeyBytes)
    else:
        return Err[X509RevocationStatus]("x509: ocsp hash unsupported")
    if ! BytesEqual(expectKey, keyHash):
        return Err[X509RevocationStatus]("x509: ocsp issuer key hash mismatch")
    if BytesLen(leaf.serial) <= 0:
        return Err[X509RevocationStatus]("x509: ocsp leaf serial missing")
    if ! BytesEqual(leaf.serial, serial):
        return Err[X509RevocationStatus]("x509: ocsp serial mismatch")
    let statusTlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(singleValue, sOff)
    if IsErr(statusTlvRes):
        return Err[X509RevocationStatus](Error(statusTlvRes))
    let statusTlv: Asn1TagValueNext = Value(statusTlvRes)
    let statusTag: int32 = statusTlv.tag
    sOff = statusTlv.next
    var singleStatusCode: int32 = int32(X509RevocationUnknown)
    if statusTag == 0x80:
        singleStatusCode = int32(X509RevocationGood)
    elif statusTag == 0xa1 || statusTag == 0x81:
        singleStatusCode = int32(X509RevocationRevoked)
    elif statusTag == 0x82:
        singleStatusCode = int32(X509RevocationUnknown)
    else:
        return Err[X509RevocationStatus]("x509: ocsp status invalid")
    let thisRes: Result[minasn1.Asn1Int64Next] = x509ParseTime(singleValue, sOff)
    if IsErr(thisRes):
        return Err[X509RevocationStatus](Error(thisRes))
    let thisUpdateValue: minasn1.Asn1Int64Next = Value(thisRes)
    let thisUpdate: int64 = thisUpdateValue.value
    sOff = thisUpdateValue.next
    var nextUpdate: int64
    if sOff < BytesLen(singleValue) && BytesGet(singleValue, sOff) == 0xa0:
        let nextRes: Result[Asn1TagValueNext] = asn1DecodeTlv(singleValue, sOff)
        if IsErr(nextRes):
            return Err[X509RevocationStatus](Error(nextRes))
        let nextTlv: Asn1TagValueNext = Value(nextRes)
        let innerRes: Result[minasn1.Asn1Int64Next] = x509ParseTime(nextTlv.value, 0)
        if IsErr(innerRes):
            return Err[X509RevocationStatus](Error(innerRes))
        let innerTime: minasn1.Asn1Int64Next = Value(innerRes)
        nextUpdate = innerTime.value
        sOff = nextTlv.next
    if now > 0:
        if thisUpdate > 0 && now < thisUpdate:
            return Err[X509RevocationStatus]("x509: ocsp ! yet valid")
        if nextUpdate > 0 && now > nextUpdate:
            return Err[X509RevocationStatus]("x509: ocsp expired")
    if singleStatusCode == int32(X509RevocationGood):
        return Ok[X509RevocationStatus](X509RevocationGood)
    if singleStatusCode == int32(X509RevocationRevoked):
        return Ok[X509RevocationStatus](X509RevocationRevoked)
    return Ok[X509RevocationStatus](X509RevocationUnknown)

fn x509FindIssuer(
    leaf: X509Certificate,
    intermediates: X509CertList,
    roots: X509CertList
): Result[X509Certificate] =
    if BytesLen(leaf.issuer) <= 0:
        return Err[X509Certificate]("x509: issuer missing")
    let interRes: Result[X509Certificate] = x509CertListFindBySubject(intermediates, leaf.issuer)
    if IsOk(interRes):
        return interRes
    return x509CertListFindBySubject(roots, leaf.issuer)

@borrows
fn x509FindIssuerIndex(
    leaf: X509Certificate,
    intermediates: X509CertList,
    roots: X509CertList
): Result[int32] =
    if BytesLen(leaf.issuer) <= 0:
        return Err[int32]("x509: issuer missing")
    let interIdx: int32 = x509CertListFindBySubjectIndex(intermediates, leaf.issuer)
    if interIdx >= 0:
        return Ok[int32](interIdx)
    let rootIdx: int32 = x509CertListFindBySubjectIndex(roots, leaf.issuer)
    if rootIdx >= 0:
        return Ok[int32](-1 - rootIdx)
    return Err[int32]("x509: issuer ! found")

@borrows
fn x509VerifyRevocationWithIssuer(
    leaf: X509Certificate,
    issuer: X509Certificate,
    ocsp: Bytes,
    crls: Bytes[x509MaxCrls],
    crlCount: int32,
    now: int64,
    mode: X509RevocationMode
): Result[bool] =
    var checked: bool
    if BytesLen(ocsp) > 0:
        let ocspRes: Result[X509RevocationStatus] = x509VerifyOcspResponse(ocsp, leaf, issuer, now)
        if IsErr(ocspRes):
            if mode == X509RevocationStrict:
                return Err[bool](Error(ocspRes))
        if IsOk(ocspRes):
            checked = true
            let ocspStatusCode: int32 = int32(Value(ocspRes))
            if ocspStatusCode == int32(X509RevocationRevoked):
                return Err[bool]("x509: ocsp revoked")
            if ocspStatusCode == int32(X509RevocationUnknown):
                if mode == X509RevocationStrict:
                    return Err[bool]("x509: ocsp unknown")
                return Ok[bool](true)
            return Ok[bool](true)
    if crlCount > 0:
        for i in 0..<crlCount:
            let crlBytes: Bytes = crls[i]
            if BytesLen(crlBytes) > 0:
                let crlRes: Result[X509Crl] = x509VerifyCrl(crlBytes, issuer, now)
                if IsErr(crlRes):
                    if mode == X509RevocationStrict:
                        return Err[bool](Error(crlRes))
                else:
                    checked = true
                    if x509CrlIsRevoked(Value(crlRes), leaf.serial):
                        return Err[bool]("x509: crl revoked")
                    return Ok[bool](true)
    if ! checked && mode == X509RevocationStrict:
        return Err[bool]("x509: revocation data missing")
    return Ok[bool](true)

@borrows
fn x509VerifyRevocation(
    leaf: X509Certificate,
    intermediates: X509CertList,
    roots: X509CertList,
    ocsp: Bytes,
    crls: Bytes[x509MaxCrls],
    crlCount: int32,
    now: int64,
    mode: X509RevocationMode
): Result[bool] =
    if mode == X509RevocationOff:
        return Ok[bool](true)
    let issuerIdxRes: Result[int32] = x509FindIssuerIndex(leaf, intermediates, roots)
    if IsErr(issuerIdxRes):
        if mode == X509RevocationStrict:
            return Err[bool](Error(issuerIdxRes))
        return Ok[bool](true)
    let issuerIdx: int32 = Value(issuerIdxRes)
    if issuerIdx >= 0:
        let issuerRes: Result[X509Certificate] = x509CertListCertAt(intermediates, issuerIdx)
        if IsErr(issuerRes):
            return Err[bool](Error(issuerRes))
        let issuerPtr: X509Certificate = Value(issuerRes)
        return x509VerifyRevocationWithIssuer(leaf, issuerPtr, ocsp, crls, crlCount, now, mode)
    let rootIdx: int32 = -issuerIdx - 1
    let rootRes: Result[X509Certificate] = x509CertListCertAt(roots, rootIdx)
    if IsErr(rootRes):
        return Err[bool](Error(rootRes))
    let rootPtr: X509Certificate = Value(rootRes)
    return x509VerifyRevocationWithIssuer(leaf, rootPtr, ocsp, crls, crlCount, now, mode)
