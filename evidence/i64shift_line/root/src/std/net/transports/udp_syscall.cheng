import std/strutils as strutil
# UDP syscall helpers (BSD socket wrapper + errno mapping).

import std/result
import std/rawbytes
import std/os
import std/strings

importc fn cheng_udp_recvfrom_addr_ptr_bridge(fd: int32, payload: ptr, payloadLen: int32, flags: int32, addr: ptr, addrCap: int32, outAddrLen: ptr, outErr: ptr): int32

const
    udpAfInet = 2
    udpAfInet6Linux = 10
    udpAfInet6Bsd = 30
    udpSockDgram = 2
    udpRecvScratchSlots = 64
    udpRecvScratchAddrBytes = 128

    udpIpProtoIp = 0
    udpIpProtoIpv6 = 41
    udpIpTosLinux = 1
    udpIpTosBsd = 3
    udpIpv6TclassLinux = 67
    udpIpv6TclassBsd = 36

    udpFcntlGetFl = 3
    udpFcntlSetFl = 4
    udpONonblockLinux = 0x800
    udpONonblockBsd = 0x4
    udpErrAgainLinux = 11
    udpErrAgainBsd = 35
    udpErrWouldBlockLinux = 11
    udpErrWouldBlockBsd = 35
    udpErrIntr = 4
    udpErrInvalid = 22
    udpErrNoSys = 38
    udpErrOpNotSuppLinux = 95
    udpErrOpNotSuppBsd = 45

type
    UdpSocketHandle =
        fd: int32
        family: int32
        isV6: bool

    UdpSockAddr =
        data: Bytes
        len: int32
        family: int32
        isV6: bool
        host: str
        port: int32

    UdpRecvResult =
        data: Bytes
        fromAddr: UdpSockAddr

    UdpRecvScratchSlot =
        fd: int32
        dataPtr: uint64
        dataLen: int32
        addrPtr: uint64
        addrLen: int32

    UdpRecvScratch =
        slots: UdpRecvScratchSlot[udpRecvScratchSlots]

var
    udpRecvScratchReady: bool
    udpRecvScratch: UdpRecvScratch

fn udpErrno(): int32 =
    return os.udpErrno()

fn udpErrText(code: int32): str =
    let errText: str = os.udpErrText(code)
    return errText

fn udpErrWouldBlockOrIntr(code: int32): bool =
    if code == udpErrIntr:
        return true
    if code == udpErrAgainLinux || code == udpErrAgainBsd:
        return true
    if code == udpErrWouldBlockLinux || code == udpErrWouldBlockBsd:
        return true
    return false

fn udpErrSupportsLenFallback(code: int32): bool =
    if code == udpErrInvalid || code == udpErrNoSys:
        return true
    if code == udpErrOpNotSuppLinux || code == udpErrOpNotSuppBsd:
        return true
    return false

fn udpRecvScratchResetAt(scratch: var UdpRecvScratch, idx: int32) =
    scratch.slots[idx].fd = -1
    scratch.slots[idx].dataPtr = uint64(0)
    scratch.slots[idx].dataLen = 0
    scratch.slots[idx].addrPtr = uint64(0)
    scratch.slots[idx].addrLen = 0

fn udpRecvScratchFdAt(scratch: var UdpRecvScratch, idx: int32): int32 =
    return scratch.slots[idx].fd

fn udpRecvScratchSetFdAt(scratch: var UdpRecvScratch, idx: int32, fd: int32) =
    scratch.slots[idx].fd = fd

fn udpRecvScratchDataAt(scratch: var UdpRecvScratch, idx: int32): Bytes =
    let n: int32 = scratch.slots[idx].dataLen
    let p: uint64 = scratch.slots[idx].dataPtr
    if n <= 0 || p == uint64(0):
        return emptyBytes()
    return BytesView(ptr(p), n)

fn udpRecvScratchSetDataAt(scratch: var UdpRecvScratch, idx: int32, data: Bytes) =
    if data.len <= 0 || data.data == nil:
        scratch.slots[idx].dataPtr = uint64(0)
        scratch.slots[idx].dataLen = 0
        return
    scratch.slots[idx].dataPtr = uint64(data.data)
    scratch.slots[idx].dataLen = data.len

fn udpRecvScratchAddrAt(scratch: var UdpRecvScratch, idx: int32): Bytes =
    let n: int32 = scratch.slots[idx].addrLen
    let p: uint64 = scratch.slots[idx].addrPtr
    if n <= 0 || p == uint64(0):
        return emptyBytes()
    return BytesView(ptr(p), n)

fn udpRecvScratchSetAddrAt(scratch: var UdpRecvScratch, idx: int32, data: Bytes) =
    if data.len <= 0 || data.data == nil:
        scratch.slots[idx].addrPtr = uint64(0)
        scratch.slots[idx].addrLen = 0
        return
    scratch.slots[idx].addrPtr = uint64(data.data)
    scratch.slots[idx].addrLen = data.len

fn udpRecvScratchInit() =
    if udpRecvScratchReady:
        return
    for i in 0..<udpRecvScratchSlots:
        udpRecvScratchResetAt(udpRecvScratch, i)
    udpRecvScratchReady = true

fn udpRecvScratchSlot(fd: int32): int32 =
    udpRecvScratchInit()
    var freeIdx: int32 = -1
    for i in 0..<udpRecvScratchSlots:
        if udpRecvScratchFdAt(udpRecvScratch, i) == fd:
            return i
        if udpRecvScratchFdAt(udpRecvScratch, i) < 0 && freeIdx < 0:
            freeIdx = i
    if freeIdx >= 0:
        udpRecvScratchSetFdAt(udpRecvScratch, freeIdx, fd)
        return freeIdx
    var slot: int32 = fd % udpRecvScratchSlots
    if slot < 0:
        slot = 0 - slot
    udpRecvScratchResetAt(udpRecvScratch, slot)
    udpRecvScratchSetFdAt(udpRecvScratch, slot, fd)
    return slot

fn udpRecvScratchPayload(fd: int32, maxBytes: int32): Bytes =
    if fd < 0 || maxBytes <= 0:
        return emptyBytes()
    return BytesAlloc(maxBytes)

fn udpRecvScratchAddrBuf(fd: int32): Bytes =
    if fd < 0:
        return emptyBytes()
    return BytesAlloc(udpRecvScratchAddrBytes)

fn udpRecvScratchRelease(fd: int32) =
    udpRecvScratchInit()
    for i in 0..<udpRecvScratchSlots:
        if udpRecvScratchFdAt(udpRecvScratch, i) == fd:
            udpRecvScratchResetAt(udpRecvScratch, i)
            return

fn udpSocketEnableNonblock(fd: int32) =
    if fd < 0:
        return
    let flags: int32 = os.udpFcntl(fd, udpFcntlGetFl, 0)
    if flags < 0:
        return
    var bsdTry: int32 = flags
    if (bsdTry & 0x4) == 0:
        bsdTry = bsdTry + 0x4
    let _ = os.udpFcntl(fd, udpFcntlSetFl, bsdTry)
    let bsdFlags: int32 = os.udpFcntl(fd, udpFcntlGetFl, 0)
    if bsdFlags >= 0:
        if (bsdFlags & 0x4) != 0:
            return
    var linuxTry: int32 = flags
    if (linuxTry & 0x800) == 0:
        linuxTry = linuxTry + 0x800
    let _ = os.udpFcntl(fd, udpFcntlSetFl, linuxTry)
    let linuxFlags: int32 = os.udpFcntl(fd, udpFcntlGetFl, 0)
    if linuxFlags >= 0:
        if (linuxFlags & 0x800) != 0:
            return

fn udpSocketOpenDgram(isV6: bool): Result[UdpSocketHandle] =
    if !isV6:
        let fd: int32 = os.udpOpenSocket(udpAfInet, udpSockDgram, 0)
        if fd < 0:
            return Err[UdpSocketHandle]("udp syscall: socket failed")
        udpSocketEnableNonblock(fd)
        return Ok[UdpSocketHandle](UdpSocketHandle(fd: fd, family: udpAfInet, isV6: false))

    let fdLinux: int32 = os.udpOpenSocket(udpAfInet6Linux, udpSockDgram, 0)
    if fdLinux >= 0:
        udpSocketEnableNonblock(fdLinux)
        return Ok[UdpSocketHandle](UdpSocketHandle(fd: fdLinux, family: udpAfInet6Linux, isV6: true))

    let fdBsd: int32 = os.udpOpenSocket(udpAfInet6Bsd, udpSockDgram, 0)
    if fdBsd >= 0:
        udpSocketEnableNonblock(fdBsd)
        return Ok[UdpSocketHandle](UdpSocketHandle(fd: fdBsd, family: udpAfInet6Bsd, isV6: true))
    return Err[UdpSocketHandle]("udp syscall: ipv6 socket failed")

fn udpSocketClose(fd: int32) =
    if fd < 0:
        return
    udpRecvScratchRelease(fd)
    let _ = os.udpCloseFd(fd)

fn udpWriteU16BE(buf: Bytes, offset: int32, value: int32) =
    BytesSet(buf, offset, (value >> 8) & 0xff)
    BytesSet(buf, offset + 1, value & 0xff)

@borrows
fn udpRawStrByteAt(text: str, idx: int32): int32 =
    return int32(text[idx])

@borrows
fn udpWriteIpv4Literal(raw: Bytes, offset: int32, host: str): Result[bool] =
    if len(host) <= 0 || host == "0.0.0.0":
        for i in 0..<4:
            BytesSet(raw, offset + i, 0)
        return Ok[bool](true)
    var octet: int32
    var digits: int32
    var octetIndex: int32
    for i in 0..<len(host):
        let ch: int32 = udpRawStrByteAt(host, i)
        if ch == int32('.'):
            if digits <= 0 || octet < 0 || octet > 255 || octetIndex >= 4:
                return Err[bool]("udp syscall: invalid ip literal")
            BytesSet(raw, offset + octetIndex, octet)
            octetIndex = octetIndex + 1
            octet = 0
            digits = 0
            continue
        if ch < int32('0') || ch > int32('9'):
            return Err[bool]("udp syscall: invalid ip literal")
        octet = octet * 10 + (ch - int32('0'))
        digits = digits + 1
        if octet > 255:
            return Err[bool]("udp syscall: invalid ip literal")
    if digits <= 0 || octet < 0 || octet > 255 || octetIndex != 3:
        return Err[bool]("udp syscall: invalid ip literal")
    BytesSet(raw, offset + octetIndex, octet)
    return Ok[bool](true)

fn udpReadU16BE(buf: Bytes, offset: int32): int32 =
    return (BytesGet(buf, offset) << 8) | BytesGet(buf, offset + 1)

fn udpWriteI32LE(buf: Bytes, value: int32) =
    if BytesLen(buf) < 4:
        return
    BytesSet(buf, 0, value & 0xff)
    BytesSet(buf, 1, (value >> 8) & 0xff)
    BytesSet(buf, 2, (value >> 16) & 0xff)
    BytesSet(buf, 3, (value >> 24) & 0xff)

fn udpReadI32LE(buf: Bytes): int32 =
    if BytesLen(buf) < 4:
        return 0
    return BytesGet(buf, 0) |
           (BytesGet(buf, 1) << 8) |
           (BytesGet(buf, 2) << 16) |
           (BytesGet(buf, 3) << 24)

fn udpIpv4HostText(raw: Bytes, offset: int32): str =
    return strutil.Join([
        IntToStr(BytesGet(raw, offset)),
        ".",
        IntToStr(BytesGet(raw, offset + 1)),
        ".",
        IntToStr(BytesGet(raw, offset + 2)),
        ".",
        IntToStr(BytesGet(raw, offset + 3))
    ], "")

fn udpIpv6BuiltinHostText(raw: Bytes, offset: int32): str =
    var allZero: bool = true
    for i in 0..<16:
        if BytesGet(raw, offset + i) != 0:
            allZero = false
    if allZero:
        return "::"
    var loopback: bool = true
    for i in 0..<15:
        if BytesGet(raw, offset + i) != 0:
            loopback = false
    if BytesGet(raw, offset + 15) != 1:
        loopback = false
    if loopback:
        return "::1"
    return ""

@borrows
fn udpNormalizeHostLiteral(host: str, isV6: bool): str =
    if len(host) <= 0:
        return ""
    if host == "localhost":
        return if isV6: "::1" else: "127.0.0.1"
    return host

@borrows
fn udpNormalizeHostLiteralFamily(host: str, isV6Code: int32): str =
    if len(host) <= 0:
        return ""
    if host == "localhost":
        if isV6Code != 0:
            return "::1"
        return "127.0.0.1"
    return host

@borrows
fn udpSockAddrFromHostPortFamily(host: str,
                                  port: int32,
                                  family: int32,
                                  isV6Code: int32,
                                  useLenFieldCode: int32,
                                  out: var UdpSockAddr): Result[bool] =
    if port < 0 || port > 65535:
        return Err[bool]("udp syscall: port out of range")

    var resolvedFamily: int32 = family
    if isV6Code != 0:
        if resolvedFamily != udpAfInet6Linux && resolvedFamily != udpAfInet6Bsd:
            resolvedFamily = udpAfInet6Linux
    else:
        resolvedFamily = udpAfInet

    var addrSize: int32 = 16
    if isV6Code != 0:
        addrSize = 28
    let raw: Bytes = BytesAlloc(addrSize)

    if useLenFieldCode != 0:
        BytesSet(raw, 0, addrSize)
        BytesSet(raw, 1, resolvedFamily & 0xff)
    else:
        BytesSet(raw, 0, resolvedFamily & 0xff)
        BytesSet(raw, 1, (resolvedFamily >> 8) & 0xff)

    udpWriteU16BE(raw, 2, port)

    var ipOffset: int32 = 4
    var ipSize: int32 = 4
    if isV6Code != 0:
        ipOffset = 8
        ipSize = 16
    let ipBytes: Bytes = BytesAlloc(ipSize)
    let normalizedHost: str = udpNormalizeHostLiteralFamily(host, isV6Code)
    if len(normalizedHost) > 0:
        if isV6Code != 0 && normalizedHost == "::1":
            for i in 0..<ipSize:
                BytesSet(ipBytes, i, 0)
            BytesSet(ipBytes, 15, 1)
        else:
            let ptonRes: int32 = os.udpInetPton(resolvedFamily, normalizedHost, ipBytes)
            if ptonRes != 1:
                return Err[bool]("udp syscall: invalid ip literal")
        for i in 0..<ipSize:
            BytesSet(raw, ipOffset + i, BytesGet(ipBytes, i))

    out.data = raw
    out.len = addrSize
    out.family = resolvedFamily
    out.isV6 = isV6Code != 0
    if len(normalizedHost) > 0:
        out.host = normalizedHost
    elif isV6Code != 0:
        out.host = "::"
    else:
        out.host = "0.0.0.0"
    out.port = port
    return Ok[bool](true)

@borrows
fn udpSockAddrFromHostPort4(host: str,
                             port: int32,
                             useLenFieldCode: int32,
                             out: var UdpSockAddr): Result[bool] =
    if port < 0 || port > 65535:
        return Err[bool]("udp syscall: port out of range")
    let addrSize: int32 = 16
    let raw: Bytes = BytesAlloc(addrSize)
    if useLenFieldCode != 0:
        BytesSet(raw, 0, addrSize & 0xff)
        BytesSet(raw, 1, udpAfInet & 0xff)
    else:
        BytesSet(raw, 0, udpAfInet & 0xff)
        BytesSet(raw, 1, (udpAfInet >> 8) & 0xff)
    BytesSet(raw, 2, (port >> 8) & 0xff)
    BytesSet(raw, 3, port & 0xff)
    let normalizedHost: str = udpNormalizeHostLiteralFamily(host, 0)
    let parseRes: Result[bool] = udpWriteIpv4Literal(raw, 4, normalizedHost)
    if IsErr(parseRes):
        return Err[bool](ErrorText(parseRes))
    out.data = raw
    out.len = addrSize
    out.family = udpAfInet
    out.isV6 = false
    if len(normalizedHost) > 0:
        out.host = normalizedHost
    else:
        out.host = "0.0.0.0"
    out.port = port
    return Ok[bool](true)

@borrows
fn udpSockAddrFromHostPort6(host: str,
                             port: int32,
                             family: int32,
                             useLenFieldCode: int32,
                             out: var UdpSockAddr): Result[bool] =
    return udpSockAddrFromHostPortFamily(host, port, family, 1, useLenFieldCode, out)

@borrows
fn udpSockAddrFromHostPort(host: str, port: int32, isV6: bool, family: int32, useLenField: bool, out: var UdpSockAddr): Result[bool] =
    if port < 0 || port > 65535:
        return Err[bool]("udp syscall: port out of range")

    var resolvedFamily: int32 = family
    if isV6:
        if resolvedFamily != udpAfInet6Linux && resolvedFamily != udpAfInet6Bsd:
            resolvedFamily = udpAfInet6Linux
    else:
        resolvedFamily = udpAfInet

    let addrSize: int32 = if isV6: 28 else: 16
    let raw: Bytes = BytesAlloc(addrSize)

    if useLenField:
        BytesSet(raw, 0, addrSize)
        BytesSet(raw, 1, resolvedFamily & 0xff)
    else:
        BytesSet(raw, 0, resolvedFamily & 0xff)
        BytesSet(raw, 1, (resolvedFamily >> 8) & 0xff)

    udpWriteU16BE(raw, 2, port)

    let ipOffset: int32 = if isV6: 8 else: 4
    let ipSize: int32 = if isV6: 16 else: 4
    let ipBytes: Bytes = BytesAlloc(ipSize)
    let normalizedHost: str = udpNormalizeHostLiteral(host, isV6)
    if len(normalizedHost) > 0:
        let ptonRes: int32 = os.udpInetPton(resolvedFamily, normalizedHost, ipBytes)
        if ptonRes != 1:
            return Err[bool]("udp syscall: invalid ip literal")
        for i in 0..<ipSize:
            BytesSet(raw, ipOffset + i, BytesGet(ipBytes, i))

    out.data = raw
    out.len = addrSize
    out.family = resolvedFamily
    out.isV6 = isV6
    if len(normalizedHost) > 0:
        out.host = normalizedHost
    elif isV6:
        out.host = "::"
    else:
        out.host = "0.0.0.0"
    out.port = port
    return Ok[bool](true)

fn udpSockAddrDecode(raw: Bytes, rawLen: int32, out: var UdpSockAddr): Result[bool] =
    if rawLen <= 0:
        return Err[bool]("udp syscall: empty sockaddr")
    if BytesLen(raw) < rawLen:
        return Err[bool]("udp syscall: truncated sockaddr")
    if rawLen < 8:
        return Err[bool]("udp syscall: short sockaddr")

    let b0: int32 = BytesGet(raw, 0)
    let b1: int32 = BytesGet(raw, 1)

    var family: int32
    if (b0 == 16 || b0 == 28) && (b1 == udpAfInet || b1 == udpAfInet6Linux || b1 == udpAfInet6Bsd):
        family = b1
    else:
        family = b0 | (b1 << 8)

    var isV6: bool
    if family == udpAfInet:
        isV6 = false
    elif family == udpAfInet6Linux || family == udpAfInet6Bsd:
        isV6 = true
    else:
        return Err[bool]("udp syscall: unsupported sockaddr family")

    let addrSize: int32 = if isV6: 28 else: 16
    if rawLen < addrSize:
        return Err[bool]("udp syscall: sockaddr size mismatch")

    let port: int32 = udpReadU16BE(raw, 2)
    let ipOffset: int32 = if isV6: 8 else: 4
    let ipSize: int32 = if isV6: 16 else: 4
    var hostText: str
    if isV6:
        hostText = udpIpv6BuiltinHostText(raw, ipOffset)
        if len(hostText) <= 0:
            let ipView: Bytes = BytesSlice(raw, ipOffset, ipSize)
            hostText = os.udpInetNtop(family, ipView)
    else:
        hostText = udpIpv4HostText(raw, ipOffset)
    if len(hostText) <= 0 && isV6:
        let ipView: Bytes = BytesSlice(raw, ipOffset, ipSize)
        let altFamily: int32 = if family == udpAfInet6Linux: udpAfInet6Bsd else: udpAfInet6Linux
        hostText = os.udpInetNtop(altFamily, ipView)
        if len(hostText) > 0:
            family = altFamily
    if len(hostText) <= 0:
        return Err[bool]("udp syscall: inet_ntop failed")
    let packed: Bytes = BytesSlice(raw, 0, addrSize)

    out.data = packed
    out.len = addrSize
    out.family = family
    out.isV6 = isV6
    out.host = hostText
    out.port = port
    return Ok[bool](true)

@borrows
fn udpSockAddrCanonical(addr: UdpSockAddr): str =
    let portText: str = IntToStr(addr.port)
    if addr.isV6:
        var out: str = "/ip6/"
        out = strutil.Join([out, strings.CloneStr(addr.host)], "")
        out = strutil.Join([out, "/udp/"], "")
        out = strutil.Join([out, portText], "")
        out = strutil.Join([out, "/quic-v1"], "")
        return out
    var out: str = "/ip4/"
    out = strutil.Join([out, strings.CloneStr(addr.host)], "")
    out = strutil.Join([out, "/udp/"], "")
    out = strutil.Join([out, portText], "")
    out = strutil.Join([out, "/quic-v1"], "")
    return out

@borrows
fn udpBindAddr(fd: int32, addr: UdpSockAddr): Result[bool] =
    if fd < 0:
        return Err[bool]("udp syscall: invalid socket")
    let res: int32 = os.udpBindFd(fd, addr.data, addr.len)
    if res == 0:
        return Ok[bool](true)
    return Err[bool]("udp syscall: bind failed")

fn udpGetSockName(fd: int32, out: var UdpSockAddr): Result[bool] =
    if fd < 0:
        return Err[bool]("udp syscall: invalid socket")
    let rawAddr: Bytes = BytesAlloc(128)
    var rawLen: int32 = BytesLen(rawAddr)
    let rc: int32 = os.udpGetSockNameFd(fd, rawAddr, rawLen)
    if rc != 0 || rawLen <= 0:
        return Err[bool]("udp syscall: getsockname failed")
    if rawLen > BytesLen(rawAddr):
        rawLen = BytesLen(rawAddr)
    return udpSockAddrDecode(rawAddr, rawLen, out)

@borrows
fn udpSendTo(fd: int32, payload: Bytes, toAddr: UdpSockAddr): Result[int32] =
    if fd < 0:
        return Err[int32]("udp syscall: invalid socket")
    if BytesLen(payload) <= 0:
        return Ok[int32](0)
    let sent: int32 = os.udpSendToFd(fd, payload, 0, toAddr.data, toAddr.len)
    if sent >= 0:
        return Ok[int32](sent)
    let errCode: int32 = udpErrno()
    let errText: str = udpErrText(errCode)
    let errCodeText: str = IntToStr(errCode)
    var msg: str = "udp syscall: sendto failed: "
    msg = strutil.Join([msg, errText], "")
    msg = strutil.Join([msg, " ("], "")
    msg = strutil.Join([msg, errCodeText], "")
    msg = strutil.Join([msg, ")"], "")
    return Err[int32](msg)

fn udpRecvFromNonblock(fd: int32, maxBytes: int32, out: var UdpRecvResult): Result[bool] =
    if fd < 0:
        return Err[bool]("udp syscall: invalid socket")
    if maxBytes <= 0:
        return Err[bool]("udp syscall: invalid recv size")

    let recvFlags: int32 = os.udpPlatformMsgDontWaitBridge()
    var dataBuf: Bytes = BytesAlloc(maxBytes)
    var rawAddr: Bytes = BytesAlloc(udpRecvScratchAddrBytes)
    if BytesLen(dataBuf) < maxBytes || BytesLen(rawAddr) < udpRecvScratchAddrBytes:
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        return Err[bool]("udp syscall: recv scratch unavailable")
    var rawLenBuf: Bytes = BytesAlloc(4)
    var recvErrBuf: Bytes = BytesAlloc(4)
    udpWriteI32LE(rawLenBuf, BytesLen(rawAddr))
    udpWriteI32LE(recvErrBuf, 0)
    let recvLenRaw: int32 = cheng_udp_recvfrom_addr_ptr_bridge(
        fd,
        dataBuf.data,
        BytesLen(dataBuf),
        recvFlags,
        rawAddr.data,
        BytesLen(rawAddr),
        rawLenBuf.data,
        recvErrBuf.data
    )
    var rawLen: int32 = udpReadI32LE(rawLenBuf)
    var recvErr: int32 = udpReadI32LE(recvErrBuf)
    if recvLenRaw < 0:
        var errCode: int32 = recvErr
        if errCode == 0:
            errCode = udpErrno()
        if udpErrWouldBlockOrIntr(errCode):
            BytesFree(dataBuf)
            BytesFree(rawAddr)
            BytesFree(rawLenBuf)
            BytesFree(recvErrBuf)
            return Err[bool]("udp syscall: queue empty")
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        BytesFree(rawLenBuf)
        BytesFree(recvErrBuf)
        panic("udp syscall: recvfrom failed")
    var recvLen: int32 = recvLenRaw
    if recvLen > BytesLen(dataBuf):
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        BytesFree(rawLenBuf)
        BytesFree(recvErrBuf)
        return Err[bool]("udp syscall: datagram truncated")
    if rawLen > BytesLen(rawAddr):
        rawLen = BytesLen(rawAddr)
    if rawLen <= 0:
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        BytesFree(rawLenBuf)
        BytesFree(recvErrBuf)
        panic("udp syscall: recvfrom missing peer sockaddr")
    var payload: Bytes = emptyBytes()
    if recvLen > 0:
        payload = BytesSlice(dataBuf, 0, recvLen)

    var fromAddr: UdpSockAddr
    let fromRes: Result[bool] = udpSockAddrDecode(rawAddr, rawLen, fromAddr)
    if IsErr(fromRes):
        BytesFree(payload)
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        BytesFree(rawLenBuf)
        BytesFree(recvErrBuf)
        panic("udp syscall: sockaddr decode")
    out.data = payload
    out.fromAddr = fromAddr
    BytesFree(dataBuf)
    BytesFree(rawAddr)
    BytesFree(rawLenBuf)
    BytesFree(recvErrBuf)
    return Ok[bool](true)

fn udpRecvFromBlocking(fd: int32, maxBytes: int32, out: var UdpRecvResult): Result[bool] =
    if fd < 0:
        return Err[bool]("udp syscall: invalid socket")
    if maxBytes <= 0:
        return Err[bool]("udp syscall: invalid recv size")
    var dataBuf: Bytes = BytesAlloc(maxBytes)
    var rawAddr: Bytes = BytesAlloc(udpRecvScratchAddrBytes)
    if BytesLen(dataBuf) < maxBytes || BytesLen(rawAddr) < udpRecvScratchAddrBytes:
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        return Err[bool]("udp syscall: recv scratch unavailable")
    var rawLenBuf: Bytes = BytesAlloc(4)
    var recvErrBuf: Bytes = BytesAlloc(4)
    udpWriteI32LE(rawLenBuf, BytesLen(rawAddr))
    udpWriteI32LE(recvErrBuf, 0)
    let recvLenRaw: int32 = cheng_udp_recvfrom_addr_ptr_bridge(
        fd,
        dataBuf.data,
        BytesLen(dataBuf),
        0,
        rawAddr.data,
        BytesLen(rawAddr),
        rawLenBuf.data,
        recvErrBuf.data
    )
    var rawLen: int32 = udpReadI32LE(rawLenBuf)
    var recvErr: int32 = udpReadI32LE(recvErrBuf)
    if recvLenRaw < 0:
        var errCode: int32 = recvErr
        if errCode == 0:
            errCode = udpErrno()
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        BytesFree(rawLenBuf)
        BytesFree(recvErrBuf)
        return Err[bool](strutil.Join(["udp syscall: recvfrom failed: ", udpErrText(errCode)], ""))
    var recvLen: int32 = recvLenRaw
    if recvLen > BytesLen(dataBuf):
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        BytesFree(rawLenBuf)
        BytesFree(recvErrBuf)
        return Err[bool]("udp syscall: datagram truncated")
    if rawLen > BytesLen(rawAddr):
        rawLen = BytesLen(rawAddr)
    if rawLen <= 0:
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        BytesFree(rawLenBuf)
        BytesFree(recvErrBuf)
        return Err[bool]("udp syscall: recvfrom missing peer sockaddr")
    var payload: Bytes = emptyBytes()
    if recvLen > 0:
        payload = BytesSlice(dataBuf, 0, recvLen)

    var fromAddr: UdpSockAddr
    let fromRes: Result[bool] = udpSockAddrDecode(rawAddr, rawLen, fromAddr)
    if IsErr(fromRes):
        BytesFree(payload)
        BytesFree(dataBuf)
        BytesFree(rawAddr)
        BytesFree(rawLenBuf)
        BytesFree(recvErrBuf)
        return Err[bool](Error(fromRes))
    out.data = payload
    out.fromAddr = fromAddr
    BytesFree(dataBuf)
    BytesFree(rawAddr)
    BytesFree(rawLenBuf)
    BytesFree(recvErrBuf)
    return Ok[bool](true)

fn udpRecvFromBlockingRawText(fd: int32, maxBytes: int32, outData: var Bytes, outFromText: var str): int32 =
    outData = emptyBytes()
    outFromText = ""
    if fd < 0:
        return -1
    if maxBytes <= 0:
        return -1
    let dataBuf: Bytes = BytesAlloc(maxBytes)
    let rawAddr: Bytes = BytesAlloc(udpRecvScratchAddrBytes)
    if BytesLen(dataBuf) < maxBytes || BytesLen(rawAddr) < udpRecvScratchAddrBytes:
        return -1
    let rawLenBuf: Bytes = BytesAlloc(4)
    let recvErrBuf: Bytes = BytesAlloc(4)
    udpWriteI32LE(rawLenBuf, BytesLen(rawAddr))
    udpWriteI32LE(recvErrBuf, 0)
    let recvLenRaw: int32 = cheng_udp_recvfrom_addr_ptr_bridge(
        fd,
        dataBuf.data,
        BytesLen(dataBuf),
        0,
        rawAddr.data,
        BytesLen(rawAddr),
        rawLenBuf.data,
        recvErrBuf.data
    )
    var rawLen: int32 = udpReadI32LE(rawLenBuf)
    if recvLenRaw < 0:
        return -1
    var recvLen: int32 = recvLenRaw
    if recvLen > BytesLen(dataBuf):
        return -1
    if rawLen > BytesLen(rawAddr):
        rawLen = BytesLen(rawAddr)
    if recvLen <= 0:
        return 0
    if rawLen <= 0:
        return -1
    var fromAddr: UdpSockAddr
    let fromRes: Result[bool] = udpSockAddrDecode(rawAddr, rawLen, fromAddr)
    if IsErr(fromRes):
        return -1
    outData = BytesSlice(dataBuf, 0, recvLen)
    outFromText = udpSockAddrCanonical(fromAddr)
    return recvLen

fn udpSetSockOptInt(fd: int32, level: int32, optName: int32, value: int32): bool =
    let optBytes: Bytes = BytesAlloc(4)
    BytesSet(optBytes, 0, value & 0xff)
    BytesSet(optBytes, 1, (value >> 8) & 0xff)
    BytesSet(optBytes, 2, (value >> 16) & 0xff)
    BytesSet(optBytes, 3, (value >> 24) & 0xff)
    let setRc: int32 = os.udpSetSockOptIntFd(fd, level, optName, optBytes)
    return setRc == 0

fn udpSetDscpTos(fd: int32, dscp: int32, isV6: bool): Result[bool] =
    if fd < 0:
        return Err[bool]("udp syscall: invalid socket")
    if dscp < 0:
        return Ok[bool](false)

    let tos: int32 = (dscp & 63) << 2
    if isV6:
        if udpSetSockOptInt(fd, udpIpProtoIpv6, udpIpv6TclassLinux, tos):
            return Ok[bool](true)
        if udpSetSockOptInt(fd, udpIpProtoIpv6, udpIpv6TclassBsd, tos):
            return Ok[bool](true)
    else:
        if udpSetSockOptInt(fd, udpIpProtoIp, udpIpTosLinux, tos):
            return Ok[bool](true)
        if udpSetSockOptInt(fd, udpIpProtoIp, udpIpTosBsd, tos):
            return Ok[bool](true)

    return Err[bool]("udp syscall: setsockopt failed")

@borrows
fn UdpBindAddr(fd: int32, addr: UdpSockAddr): Result[bool] =
    return udpBindAddr(fd, addr)

fn UdpGetSockName(fd: int32, out: var UdpSockAddr): Result[bool] =
    return udpGetSockName(fd, out)

fn UdpRecvFromBlocking(fd: int32, maxBytes: int32, out: var UdpRecvResult): Result[bool] =
    return udpRecvFromBlocking(fd, maxBytes, out)

fn UdpRecvFromBlockingRawText(fd: int32, maxBytes: int32, outData: var Bytes, outFromText: var str): int32 =
    return udpRecvFromBlockingRawText(fd, maxBytes, outData, outFromText)

fn UdpRecvFromNonblock(fd: int32, maxBytes: int32, out: var UdpRecvResult): Result[bool] =
    return udpRecvFromNonblock(fd, maxBytes, out)

fn UdpRecvScratchRelease(fd: int32) =
    udpRecvScratchRelease(fd)

@borrows
fn UdpSendTo(fd: int32, payload: Bytes, toAddr: UdpSockAddr): Result[int32] =
    return udpSendTo(fd, payload, toAddr)

@borrows
fn UdpSockAddrCanonical(addr: UdpSockAddr): str =
    return udpSockAddrCanonical(addr)

@borrows
fn UdpSockAddrFromHostPort(host: str, port: int32, isV6: bool, family: int32, useLenField: bool, out: var UdpSockAddr): Result[bool] =
    return udpSockAddrFromHostPort(host, port, isV6, family, useLenField, out)

@borrows
fn UdpSockAddrFromHostPort4(host: str, port: int32, useLenFieldCode: int32, out: var UdpSockAddr): Result[bool] =
    return udpSockAddrFromHostPort4(host, port, useLenFieldCode, out)

@borrows
fn UdpSockAddrFromHostPort6(host: str, port: int32, family: int32, useLenFieldCode: int32, out: var UdpSockAddr): Result[bool] =
    return udpSockAddrFromHostPort6(host, port, family, useLenFieldCode, out)

fn UdpSocketClose(fd: int32) =
    udpSocketClose(fd)

fn UdpSocketOpenDgram(isV6: bool): Result[UdpSocketHandle] =
    return udpSocketOpenDgram(isV6)
