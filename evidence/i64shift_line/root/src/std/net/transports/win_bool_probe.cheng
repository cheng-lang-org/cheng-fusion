import std/result

type
    ProbeBig =
        fd: int32
        a: int64
        b: int64
        c: int64
        note: str

fn ProbeBoolSink(isV6: bool): str =
    if !isV6:
        return "v4"
    return "v6"

fn ProbeBigRet(host: str, port: int32, isV6: bool = false): Result[ProbeBig] =
    var out: ProbeBig
    out.fd = 1
    out.note = ProbeBoolSink(isV6)
    if isV6:
        return Err[ProbeBig]("isV6-true")
    return Ok[ProbeBig](out)

fn ProbeSmallRet(host: str, port: int32, isV6: bool = false): str =
    return ProbeBoolSink(isV6)

fn ProbeNoDefault(host: str, port: int32, isV6: bool): Result[ProbeBig] =
    var out: ProbeBig
    out.fd = 2
    out.note = ProbeBoolSink(isV6)
    if isV6:
        return Err[ProbeBig]("isV6-true-nodefault")
    return Ok[ProbeBig](out)

fn ProbeI32Default(host: str, port: int32, flag: int32 = 0): Result[ProbeBig] =
    var out: ProbeBig
    out.fd = 3
    if flag != 0:
        return Err[ProbeBig]("flag-nonzero")
    out.note = "flag-zero"
    return Ok[ProbeBig](out)
