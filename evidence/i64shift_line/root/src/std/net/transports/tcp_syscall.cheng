@borrows
fn tcpConnectResolved(host: str, port: int32): Result[TcpConnectionHandle] =
    let fd: int32 = cheng_tcp_connect_host_port_bridge(strToCStringTemp(host), port)
    if fd < 0:
        return Err[TcpConnectionHandle](strutil.Join(["tcp syscall: resolve connect failed: ", strings.CloneStr(host), ":", IntToStr(port)], ""))
    let protectRes: Result[bool] = tcpProtectOutboundFdForHost(fd, host)
    if IsErr(protectRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](Error(protectRes))
    var localAddr: TcpSockAddr
    let localRes: Result[bool] = tcpGetSockName(fd, localAddr)
    if IsErr(localRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](Error(localRes))
    var remoteAddr: TcpSockAddr
    let empty: Bytes = emptyBytes()
    remoteAddr.data = empty
    remoteAddr.len = 0
    remoteAddr.family = 0
    remoteAddr.isV6 = strings.StrContains(host, ":")
    remoteAddr.host = host
    remoteAddr.port = port
    return Ok[TcpConnectionHandle](
        TcpConnectionHandle(
            fd: fd,
            localAddr: localAddr,
            remoteAddr: remoteAddr,
            open: true
        )
    )

@borrows
fn tcpSend(conn: var TcpConnectionHandle, data: Bytes): Result[int32] =
    if !conn.open:
        return Err[int32]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[int32]("tcp syscall: connection closed")
    let totalLen: int32 = BytesLen(data)
    if totalLen <= 0:
        return Ok[int32](0)
    var sentTotal: int32
    while sentTotal < totalLen:
        let chunk: Bytes = BytesSliceView(data, sentTotal, totalLen - sentTotal)
        let sent: int32 = tcpRawSend(conn.fd, chunk.data, BytesLen(chunk), 0)
        if sent <= 0:
            let errCode: int32 = tcpErrno()
            if tcpWouldBlock(errCode):
                let waitRes: Result[bool] = tcpWaitWritableBlocking(conn.fd)
                if IsErr(waitRes):
                    return Err[int32](ErrorText(waitRes))
                continue
            return Err[int32](tcpErrMessage("tcp syscall: send failed: ", errCode))
        sentTotal = sentTotal + sent
    return Ok[int32](sentTotal)

@borrows
fn tcpSendNonblocking(conn: var TcpConnectionHandle, data: Bytes): Result[int32] =
    if !conn.open:
        return Err[int32]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[int32]("tcp syscall: connection closed")
    let totalLen: int32 = BytesLen(data)
    if totalLen <= 0:
        return Ok[int32](0)
    let sent: int32 = tcpRawSend(conn.fd, data.data, totalLen, 0)
    if sent < 0:
        let errCode: int32 = tcpErrno()
        if tcpWouldBlock(errCode):
            return Ok[int32](0)
        return Err[int32](tcpErrMessage("tcp syscall: send failed: ", errCode))
    return Ok[int32](sent)

fn tcpRecv(conn: var TcpConnectionHandle, maxBytes: int32): Result[Bytes] =
    if !conn.open:
        return Err[Bytes]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[Bytes]("tcp syscall: connection closed")
    if maxBytes <= 0:
        let empty: Bytes = emptyBytes()
        return Ok[Bytes](empty)
    var out: Bytes = BytesAlloc(maxBytes)
    while true:
        let got: int32 = tcpRawRecv(conn.fd, out.data, BytesLen(out), 0)
        if got < 0:
            let errCode: int32 = tcpErrno()
            if tcpWouldBlock(errCode):
                let waitRes: Result[bool] = tcpWaitReadableBlocking(conn.fd)
                if IsErr(waitRes):
                    BytesFree(out)
                    return Err[Bytes](ErrorText(waitRes))
                continue
            BytesFree(out)
            return Err[Bytes](tcpErrMessage("tcp syscall: recv failed: ", errCode))
        if got == 0:
            BytesFree(out)
            let empty: Bytes = emptyBytes()
            return Ok[Bytes](empty)
        if got == BytesLen(out):
            return Ok[Bytes](out)
        let sliced: Bytes = BytesSlice(out, 0, got)
        BytesFree(out)
        return Ok[Bytes](sliced)

fn tcpRecvNonblocking(conn: var TcpConnectionHandle, maxBytes: int32): Result[Bytes] =
    if !conn.open:
        return Err[Bytes]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[Bytes]("tcp syscall: connection closed")
    if maxBytes <= 0:
        let empty: Bytes = emptyBytes()
        return Ok[Bytes](empty)
    var out: Bytes = BytesAlloc(maxBytes)
    let got: int32 = tcpRawRecv(conn.fd, out.data, BytesLen(out), 0)
    if got < 0:
        let errCode: int32 = tcpErrno()
        # Free the scratch buffer on every non-success path. Without this, a
        # would-block (the common idle case) or short read leaks the whole
        # maxBytes allocation on every call — native-heap growth under traffic.
        BytesFree(out)
        if tcpWouldBlock(errCode):
            return Err[Bytes]("tcp syscall: would block")
        return Err[Bytes](tcpErrMessage("tcp syscall: recv failed: ", errCode))
    if got == 0:
        BytesFree(out)
        let empty: Bytes = emptyBytes()
        return Ok[Bytes](empty)
    if got == BytesLen(out):
        return Ok[Bytes](out)
    let sliced: Bytes = BytesSlice(out, 0, got)
    BytesFree(out)
    return Ok[Bytes](sliced)

fn tcpSendRaw(conn: var TcpConnectionHandle, data: ptr, dataLen: int32): Result[int32] =
    if !conn.open:
        return Err[int32]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[int32]("tcp syscall: connection closed")
    if data == nil || dataLen <= 0:
        return Ok[int32](0)
    var sentTotal: int32
    while sentTotal < dataLen:
        let chunkPtr: ptr = rawmem_support.RawmemPtrAdd(data, sentTotal)
        let wrote: int32 = tcpRawSend(conn.fd, chunkPtr, dataLen - sentTotal, 0)
        if wrote <= 0:
            let errCode: int32 = tcpErrno()
            if tcpWouldBlock(errCode):
                let waitRes: Result[bool] = tcpWaitWritableBlocking(conn.fd)
                if IsErr(waitRes):
                    return Err[int32](ErrorText(waitRes))
                continue
            return Err[int32](tcpErrMessage("tcp syscall: send failed: ", errCode))
        sentTotal = sentTotal + wrote
    return Ok[int32](sentTotal)

@borrows
fn tcpSendRawNonblocking(conn: var TcpConnectionHandle, data: ptr, dataLen: int32): Result[int32] =
    if !conn.open:
        return Err[int32]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[int32]("tcp syscall: connection closed")
    if data == nil || dataLen <= 0:
        return Ok[int32](0)
    let wrote: int32 = tcpRawSend(conn.fd, data, dataLen, 0)
    if wrote < 0:
        let errCode: int32 = tcpErrno()
        if tcpWouldBlock(errCode):
            return Ok[int32](0)
        return Err[int32](tcpErrMessage("tcp syscall: send failed: ", errCode))
    return Ok[int32](wrote)

@borrows
fn tcpRecvRaw(conn: var TcpConnectionHandle, out: ptr, outCap: int32): Result[int32] =
    if !conn.open:
        return Err[int32]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[int32]("tcp syscall: connection closed")
    if out == nil || outCap <= 0:
        return Ok[int32](0)
    while true:
        let got: int32 = tcpRawRecv(conn.fd, out, outCap, 0)
        if got < 0:
            let errCode: int32 = tcpErrno()
            if tcpWouldBlock(errCode):
                let waitRes: Result[bool] = tcpWaitReadableBlocking(conn.fd)
                if IsErr(waitRes):
                    return Err[int32](ErrorText(waitRes))
                continue
            if errCode == 0:
                return Err[int32]("tcp syscall: recv failed without errno")
            return Err[int32](tcpErrMessage("tcp syscall: recv failed: ", errCode))
        return Ok[int32](got)
    return Err[int32]("tcp syscall: recv loop exited")

@borrows
fn tcpRecvRawNonblocking(conn: var TcpConnectionHandle, out: ptr, outCap: int32): Result[int32] =
    if !conn.open:
        return Err[int32]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[int32]("tcp syscall: connection closed")
    if out == nil || outCap <= 0:
        return Ok[int32](0)
    let got: int32 = tcpRawRecv(conn.fd, out, outCap, 0)
    if got < 0:
        let errCode: int32 = tcpErrno()
        if tcpWouldBlock(errCode):
            return Err[int32]("tcp syscall: would block")
        if errCode == 0:
            return Err[int32]("tcp syscall: recv failed without errno")
        return Err[int32](tcpErrMessage("tcp syscall: recv failed: ", errCode))
    return Ok[int32](got)

@borrows
fn tcpSetNonblocking(conn: TcpConnectionHandle, enabled: bool): Result[bool] =
    if conn.fd < 0:
        return Err[bool]("tcp syscall: invalid connection")
    let enabledCode: int32 = if enabled: 1 else: 0
    let rc: int32 = cheng_fd_set_nonblocking_bridge(conn.fd, enabledCode)
    if rc != 0:
        let errCode: int32 = tcpErrno()
        return Err[bool](tcpErrMessage("tcp syscall: connection nonblocking failed: ", errCode))
    return Ok[bool](true)

@borrows
fn tcpShutdownWrite(conn: var TcpConnectionHandle): Result[bool] =
    if !conn.open:
        return Err[bool]("tcp syscall: connection closed")
    if conn.fd < 0:
        return Err[bool]("tcp syscall: connection closed")
    let rc: int32 = os.TcpShutdownFd(conn.fd, tcpShutdownWr)
    if rc != 0:
        let errCode: int32 = tcpErrno()
        return Err[bool](tcpErrMessage("tcp syscall: shutdown write failed: ", errCode))
    return Ok[bool](true)

fn tcpClose(conn: var TcpConnectionHandle) =
    // Android/JVM processes always own fds 0-2 (/dev/null etc., fdsan-tagged),
    // so a real socket fd is never 0 here. A zero-value handle (backend
    // zero-init of `var h: TcpConnectionHandle`) must NOT reach close(0):
    // fdsan raises SIGABRT ("attempted to close fd 0 ... owned by unique_fd").
    if conn.fd > 0:
        let closeRc: int32 = os.TcpShutdownFd(conn.fd, tcpShutdownRdWr)
        closeRc
        let _ = os.UdpCloseFd(conn.fd)
    conn.fd = -1
    conn.open = false
    rawbytes.BytesFree(conn.localAddr.data)
    rawbytes.BytesFree(conn.remoteAddr.data)

