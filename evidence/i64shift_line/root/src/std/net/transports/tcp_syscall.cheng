@borrows
fn tcpConnect4Timeout(host: str, port: int32, timeoutMs: int32): Result[TcpConnectionHandle] =
    if cheng_mobile_tcp_protect_callback_ready() != 0 && !tcpHostIsLoopback(host):
        let mobileRes: Result[TcpConnectionHandle] = tcpMobileConnect4Protected(strings.CloneStr(host), port, timeoutMs)
        if IsErr(mobileRes):
            return Err[TcpConnectionHandle](tcpEndpointError("tcp syscall: connect failed to ", host, port, ErrorText(mobileRes)))
        return mobileRes
    let openRes: Result[int32] = tcpSocketOpenStream4()
    if IsErr(openRes):
        return Err[TcpConnectionHandle](Error(openRes))
    let fd: int32 = Value(openRes)
    let protectRes: Result[bool] = tcpProtectOutboundFdForHost(fd, host)
    if IsErr(protectRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](Error(protectRes))
    var remoteAddr: TcpSockAddr
    let remoteRes: Result[bool] = tcpSockAddrFromHostPort4(host, port, remoteAddr)
    if IsErr(remoteRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](tcpEndpointError("tcp syscall: invalid remote address ", host, port, ErrorText(remoteRes)))
    let connectRes: Result[bool] = tcpConnectFdWithTimeout(fd, remoteAddr, timeoutMs)
    if IsErr(connectRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](tcpEndpointError("tcp syscall: connect failed to ", host, port, ErrorText(connectRes)))
    var localAddr: TcpSockAddr
    let localRes: Result[bool] = tcpGetSockName(fd, localAddr)
    if IsErr(localRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](Error(localRes))
    return Ok[TcpConnectionHandle](
        TcpConnectionHandle(
            fd: fd,
            localAddr: localAddr,
            remoteAddr: remoteAddr,
            open: true
        )
    )

