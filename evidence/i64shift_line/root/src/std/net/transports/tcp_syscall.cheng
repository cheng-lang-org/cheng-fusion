import std/strutils as strutil
# TCP syscall helpers (minimal loopback client/server transport).

import std/result
import std/rawbytes
import std/rawmem_support
import std/os
import std/strings
import std/system
import std/times
import std/net/transports/udp_syscall as udp

@importc("cheng_tcp_connect_host_port_bridge")
fn cheng_tcp_connect_host_port_bridge(hostText: cstring, port: int32): int32
@importc("cheng_mobile_protect_callback_ready")
fn cheng_mobile_tcp_protect_callback_ready(): int32
@importc("cheng_mobile_protect_fd")
fn cheng_mobile_tcp_protect_fd(fd: int32): int32
@importc("cheng_mobile_tcp_connect4_protected_addr_bridge")
fn cheng_mobile_tcp_connect4_protected_addr_bridge(b0: int32, b1: int32, b2: int32, b3: int32, port: int32, timeoutMs: int32): int32
@importc("cheng_mobile_local_proxy_stop_requested")
fn cheng_mobile_tcp_local_proxy_stop_requested(): int32
@importc("cheng_tcp_listen_host_port_bridge")
fn cheng_tcp_listen_host_port_bridge(hostText: cstring, port: int32, isV6: int32): int32
@importc("cheng_tcp_accept_noaddr_bridge")
fn cheng_tcp_accept_noaddr_bridge(fd: int32): int32
@importc("cheng_fd_set_nonblocking_bridge")
fn cheng_fd_set_nonblocking_bridge(fd: int32, enabled: int32): int32
@importc("cheng_tcp_set_nodelay_bridge")
fn cheng_tcp_set_nodelay_bridge(fd: int32, enabled: int32): int32
@importc("cheng_fd_wait_readable_bridge")
fn cheng_fd_wait_readable_bridge(fd: int32, timeoutMs: int32): int32
@importc("cheng_tcp_socket_error_bridge")
fn cheng_tcp_socket_error_bridge(fd: int32): int32
@importc("cheng_native_stream_send")
fn tcpRawSend(fd: int32, data: ptr, n: int32, flags: int32): int32
@importc("cheng_native_stream_recv")
fn tcpRawRecv(fd: int32, data: ptr, n: int32, flags: int32): int32

const
    tcpAfInet = 2
    tcpAfInet6Linux = 10
    tcpAfInet6Bsd = 30
    tcpSockStream = 1
    tcpShutdownWr = 1
    tcpShutdownRdWr = 2

type
    TcpSockAddr = udp.UdpSockAddr

    TcpListenerHandle =
        fd: int32
        addr: TcpSockAddr

    TcpConnectionHandle =
        fd: int32
        localAddr: TcpSockAddr
        remoteAddr: TcpSockAddr
        open: bool

fn tcpErrno(): int32 =
    return os.UdpErrno()

fn tcpErrText(code: int32): str =
    let text: str = os.udpErrText(code)
    return text

fn tcpWouldBlock(code: int32): bool =
    # 115/EINPROGRESS included: a send on a socket whose nonblocking connect
    # has not completed yet must wait for writability instead of failing.
    return code == 11 || code == 35 || code == 10035 || code == 115 || code == 36

fn tcpConnectInProgress(code: int32): bool =
    if code == 115:
        return true
    if code == 36:
        return true
    if code == 114:
        return true
    if code == 37:
        return true
    if code == 10035:
        return true
    if code == 10036:
        return true
    if code == 10037:
        return true
    return false

fn tcpConnectAlreadyConnected(code: int32): bool =
    if code == 106:
        return true
    if code == 56:
        return true
    if code == 10056:
        return true
    return false

fn tcpConnectSocketErrorOk(code: int32): bool =
    if code == 0:
        return true
    return tcpConnectAlreadyConnected(code)

fn tcpConnectErrnoOrSocketState(fd: int32, inProgressWhenClear: bool): Result[int32] =
    let errCode: int32 = tcpErrno()
    if errCode > 0 && errCode <= 4095:
        return Ok[int32](errCode)
    let socketErrRes: Result[int32] = tcpSocketError(fd)
    if IsErr(socketErrRes):
        return Err[int32](ErrorText(socketErrRes))
    let socketErr: int32 = Value(socketErrRes)
    if socketErr == 0 && inProgressWhenClear:
        return Ok[int32](115)
    return Ok[int32](socketErr)

fn tcpWaitReadableBlocking(fd: int32): Result[bool] =
    let ready: int32 = os.fdWaitReadable(fd, -1)
    if ready < 0:
        return Err[bool](tcpErrMessage("tcp syscall: recv poll failed: ", 0 - ready))
    return Ok[bool](true)

fn tcpWaitWritableBlocking(fd: int32): Result[bool] =
    let ready: int32 = os.fdWaitWritable(fd, -1)
    if ready < 0:
        return Err[bool](tcpErrMessage("tcp syscall: send poll failed: ", 0 - ready))
    return Ok[bool](true)

fn tcpErrCodeText(errCode: int32): str =
    var out: str = tcpErrText(errCode)
    out = strutil.Join([out, " ("], "")
    out = strutil.Join([out, IntToStr(errCode)], "")
    out = strutil.Join([out, ")"], "")
    return out

fn tcpErrMessage(prefix: str, errCode: int32): str =
    var out: str = prefix
    out = strutil.Join([out, tcpErrCodeText(errCode)], "")
    return out

@borrows
fn tcpHostEqualsLiteral(host: str, literal: str): bool =
    if len(host) != len(literal):
        return false
    for i in 0..<len(literal):
        if host[i] != literal[i]:
            return false
    return true

@borrows
fn tcpHostIsLoopback(host: str): bool =
    if tcpHostEqualsLiteral(host, "127.0.0.1"):
        return true
    if tcpHostEqualsLiteral(host, "localhost"):
        return true
    if tcpHostEqualsLiteral(host, "::1"):
        return true
    return false

fn tcpIpv6SocketErrMessage(errLinux: int32, errBsd: int32): str =
    if errLinux == errBsd:
        return tcpErrMessage("tcp syscall: ipv6 socket failed: ", errBsd)
    var out: str = "tcp syscall: ipv6 socket failed: "
    out = strutil.Join([out, tcpErrCodeText(errLinux)], "")
    out = strutil.Join([out, " | "], "")
    out = strutil.Join([out, tcpErrCodeText(errBsd)], "")
    return out

fn tcpSocketOpenStream(isV6: bool): Result[int32] =
    if !isV6:
        let fd: int32 = os.UdpOpenSocket(tcpAfInet, tcpSockStream, 0)
        if fd < 0:
            let errCode: int32 = tcpErrno()
            return Err[int32](tcpErrMessage("tcp syscall: socket failed: ", errCode))
        return Ok[int32](fd)

    let fdLinux: int32 = os.UdpOpenSocket(tcpAfInet6Linux, tcpSockStream, 0)
    if fdLinux >= 0:
        return Ok[int32](fdLinux)
    let errLinux: int32 = tcpErrno()

    let fdBsd: int32 = os.UdpOpenSocket(tcpAfInet6Bsd, tcpSockStream, 0)
    if fdBsd >= 0:
        return Ok[int32](fdBsd)
    let errBsd: int32 = tcpErrno()

    return Err[int32](tcpIpv6SocketErrMessage(errLinux, errBsd))

fn tcpSocketOpenStream4(): Result[int32] =
    let fd: int32 = os.UdpOpenSocket(tcpAfInet, tcpSockStream, 0)
    if fd < 0:
        let errCode: int32 = tcpErrno()
        return Err[int32](tcpErrMessage("tcp syscall: socket failed: ", errCode))
    return Ok[int32](fd)

fn tcpProtectOutboundFd(fd: int32): Result[bool] =
    if fd < 0:
        return Err[bool]("tcp syscall: invalid socket")
    if cheng_mobile_tcp_protect_callback_ready() == 0:
        return Ok[bool](true)
    if cheng_mobile_tcp_protect_fd(fd) == 0:
        return Err[bool]("tcp syscall: protect fd failed")
    return Ok[bool](true)

@borrows
fn tcpProtectOutboundFdForHost(fd: int32, host: str): Result[bool] =
    if tcpHostIsLoopback(host):
        return Ok[bool](true)
    return tcpProtectOutboundFd(fd)

fn tcpMobileLocalProxyStopRequested(): bool =
    if cheng_mobile_tcp_local_proxy_stop_requested() != 0:
        return true
    return false

fn tcpSocketOpenStream6(): Result[int32] =
    if os.udpPlatformUseLenFieldBridge() != 0:
        let fdBsdFirst: int32 = os.UdpOpenSocket(tcpAfInet6Bsd, tcpSockStream, 0)
        if fdBsdFirst >= 0:
            return Ok[int32](fdBsdFirst)
        let errBsdFirst: int32 = tcpErrno()
        let fdLinuxAfter: int32 = os.UdpOpenSocket(tcpAfInet6Linux, tcpSockStream, 0)
        if fdLinuxAfter >= 0:
            return Ok[int32](fdLinuxAfter)
        let errLinuxAfter: int32 = tcpErrno()
        return Err[int32](tcpIpv6SocketErrMessage(errLinuxAfter, errBsdFirst))
    let fdLinux: int32 = os.UdpOpenSocket(tcpAfInet6Linux, tcpSockStream, 0)
    if fdLinux >= 0:
        return Ok[int32](fdLinux)
    let errLinux: int32 = tcpErrno()

    let fdBsd: int32 = os.UdpOpenSocket(tcpAfInet6Bsd, tcpSockStream, 0)
    if fdBsd >= 0:
        return Ok[int32](fdBsd)
    let errBsd: int32 = tcpErrno()

    return Err[int32](tcpIpv6SocketErrMessage(errLinux, errBsd))

fn tcpFdSetNonblocking(fd: int32, enabled: bool): Result[bool] =
    if fd < 0:
        return Err[bool]("tcp syscall: invalid socket")
    let enabledCode: int32 = if enabled: 1 else: 0
    let rc: int32 = cheng_fd_set_nonblocking_bridge(fd, enabledCode)
    if rc != 0:
        let errCode: int32 = tcpErrno()
        return Err[bool](tcpErrMessage("tcp syscall: socket nonblocking failed: ", errCode))
    return Ok[bool](true)

@borrows
fn TcpSetNoDelay(conn: TcpConnectionHandle, enabled: bool): Result[bool] =
    # 关闭 Nagle: 交互式请求/响应(握手帧/小包)在 RTT>100ms 链路上
    # 否则会被 Nagle+delayed-ACK 拖住最多一个 RTT。
    return tcpFdSetNoDelay(conn.fd, enabled)

fn tcpFdSetNoDelay(fd: int32, enabled: bool): Result[bool] =
    if fd < 0:
        return Err[bool]("tcp syscall: invalid socket")
    let enabledCode: int32 = if enabled: 1 else: 0
    let rc: int32 = cheng_tcp_set_nodelay_bridge(fd, enabledCode)
    if rc != 0:
        let errCode: int32 = tcpErrno()
        return Err[bool](tcpErrMessage("tcp syscall: setsockopt nodelay failed: ", errCode))
    return Ok[bool](true)

fn tcpSocketError(fd: int32): Result[int32] =
    if fd < 0:
        return Err[int32]("tcp syscall: invalid socket")
    let code: int32 = cheng_tcp_socket_error_bridge(fd)
    if code < 0:
        let errCode: int32 = 0 - code
        if errCode > 0:
            return Err[int32](tcpErrMessage("tcp syscall: socket error query failed: ", errCode))
        return Err[int32]("tcp syscall: socket error query failed")
    return Ok[int32](code)

@borrows
fn tcpConnectFdWithTimeout(fd: int32,
                           remoteAddr: TcpSockAddr,
                           timeoutMs: int32): Result[bool] =
    let nbRes: Result[bool] = tcpFdSetNonblocking(fd, true)
    if IsErr(nbRes):
        return Err[bool](ErrorText(nbRes))
    let connectAddr: Bytes = remoteAddr.data
    let connectRes: int32 = os.TcpConnectFd(fd, connectAddr, remoteAddr.len)
    if connectRes == 0:
        let blockRes: Result[bool] = tcpFdSetNonblocking(fd, false)
        if IsErr(blockRes):
            return Err[bool](ErrorText(blockRes))
        return Ok[bool](true)
    let initialErrRes: Result[int32] = tcpConnectErrnoOrSocketState(fd, true)
    if IsErr(initialErrRes):
        return Err[bool](ErrorText(initialErrRes))
    var errCode: int32 = Value(initialErrRes)
    if tcpConnectAlreadyConnected(errCode):
        let blockRes2: Result[bool] = tcpFdSetNonblocking(fd, false)
        if IsErr(blockRes2):
            return Err[bool](ErrorText(blockRes2))
        return Ok[bool](true)
    if !tcpConnectInProgress(errCode):
        return Err[bool](tcpErrMessage("tcp syscall: connect failed: ", errCode))
    let stopCheckEnabled: bool = cheng_mobile_tcp_protect_callback_ready() != 0
    var remainingMs: int32 = timeoutMs
    while true:
        if stopCheckEnabled && tcpMobileLocalProxyStopRequested():
            return Err[bool]("tcp syscall: connect stopped")
        var waitMs: int32
        if timeoutMs <= 0:
            waitMs = 0
        elif stopCheckEnabled:
            waitMs = 100
            if remainingMs < waitMs:
                waitMs = remainingMs
        else:
            waitMs = remainingMs
        let ready: int32 = os.fdWaitWritable(fd, waitMs)
        if ready < 0:
            let waitErr: int32 = 0 - ready
            return Err[bool](tcpErrMessage("tcp syscall: connect poll failed: ", waitErr))
        if ready == 0:
            if timeoutMs <= 0:
                return Err[bool]("tcp syscall: connect timeout")
            if stopCheckEnabled:
                remainingMs = remainingMs - waitMs
                if remainingMs <= 0:
                    return Err[bool]("tcp syscall: connect timeout")
                continue
            return Err[bool]("tcp syscall: connect timeout")
        if stopCheckEnabled:
            remainingMs = remainingMs - waitMs
            if remainingMs < 0:
                return Err[bool]("tcp syscall: connect timeout")
        let retryConnectRes: int32 = os.TcpConnectFd(fd, connectAddr, remoteAddr.len)
        if retryConnectRes == 0:
            let blockRes3: Result[bool] = tcpFdSetNonblocking(fd, false)
            if IsErr(blockRes3):
                return Err[bool](ErrorText(blockRes3))
            return Ok[bool](true)
        let retryErrRes: Result[int32] = tcpConnectErrnoOrSocketState(fd, false)
        if IsErr(retryErrRes):
            return Err[bool](ErrorText(retryErrRes))
        errCode = Value(retryErrRes)
        if tcpConnectSocketErrorOk(errCode):
            let blockRes4: Result[bool] = tcpFdSetNonblocking(fd, false)
            if IsErr(blockRes4):
                return Err[bool](ErrorText(blockRes4))
            return Ok[bool](true)
        if !tcpConnectInProgress(errCode):
            return Err[bool](tcpErrMessage("tcp syscall: connect failed: ", errCode))
    return Err[bool]("tcp syscall: connect loop exited")

@borrows
fn tcpConnectStartNonblocking(host: str,
                              port: int32,
                              isV6: bool,
                              out: var TcpConnectionHandle): Result[bool] =
    out.fd = -1
    out.open = false
    let openRes: Result[int32] = tcpSocketOpenStream(isV6)
    if IsErr(openRes):
        return Err[bool](Error(openRes))
    let fd: int32 = Value(openRes)
    let protectRes: Result[bool] = tcpProtectOutboundFdForHost(fd, host)
    if IsErr(protectRes):
        let _ = os.UdpCloseFd(fd)
        return Err[bool](Error(protectRes))
    var remoteAddr: TcpSockAddr
    var remoteRes: Result[bool]
    if isV6:
        remoteRes = tcpSockAddrFromHostPort6(host, port, remoteAddr)
    else:
        remoteRes = tcpSockAddrFromHostPort4(host, port, remoteAddr)
    if IsErr(remoteRes):
        let _ = os.UdpCloseFd(fd)
        return Err[bool](tcpEndpointError("tcp syscall: invalid remote address ", host, port, ErrorText(remoteRes)))
    let nbRes: Result[bool] = tcpFdSetNonblocking(fd, true)
    if IsErr(nbRes):
        let _ = os.UdpCloseFd(fd)
        return Err[bool](ErrorText(nbRes))
    var connected: bool
    let connectRes: int32 = os.TcpConnectFd(fd, remoteAddr.data, remoteAddr.len)
    if connectRes == 0:
        connected = true
    else:
        connected = false
    var localAddr: TcpSockAddr = tcpSockAddrUnknown(emptyBytes(), 0)
    if connected:
        var localCandidate: TcpSockAddr
        let localRes: Result[bool] = tcpGetSockName(fd, localCandidate)
        if !IsErr(localRes):
            localAddr = localCandidate
    out.fd = fd
    out.localAddr = localAddr
    out.remoteAddr = remoteAddr
    out.open = true
    return Ok[bool](connected)

@borrows
fn tcpConnectPoll(conn: TcpConnectionHandle): Result[bool] =
    if conn.fd < 0 || !conn.open:
        return Err[bool]("tcp syscall: invalid connection")
    let socketErrRes: Result[int32] = tcpSocketError(conn.fd)
    if IsErr(socketErrRes):
        return Err[bool](ErrorText(socketErrRes))
    let socketErr: int32 = Value(socketErrRes)
    if tcpConnectSocketErrorOk(socketErr):
        return Ok[bool](true)
    if tcpConnectInProgress(socketErr):
        return Ok[bool](false)
    return Err[bool](tcpErrMessage("tcp syscall: connect failed: ", socketErr))

@borrows
fn tcpWriteIpv4Literal(raw: Bytes, offset: int32, host: str): Result[bool] =
    if len(host) <= 0 || host == "0.0.0.0":
        for clearIndex in 0..<4:
            BytesSet(raw, offset + clearIndex, 0)
        return Ok[bool](true)
    var octet: int32
    var digits: int32
    var octetIndex: int32
    let view: Bytes = BytesFromString(host)
    var i: int32
    while i < BytesLen(view):
        let ch: int32 = BytesGet(view, i)
        if ch == int32('.'):
            if digits <= 0 || octet < 0 || octet > 255 || octetIndex >= 4:
                return Err[bool]("tcp syscall: invalid ip literal")
            BytesSet(raw, offset + octetIndex, octet)
            octetIndex = octetIndex + 1
            octet = 0
            digits = 0
        elif ch >= int32('0') && ch <= int32('9'):
            octet = octet * 10 + (ch - int32('0'))
            digits = digits + 1
            if octet > 255:
                return Err[bool]("tcp syscall: invalid ip literal")
        else:
            return Err[bool]("tcp syscall: invalid ip literal")
        i = i + 1
    if digits <= 0 || octet < 0 || octet > 255 || octetIndex != 3:
        return Err[bool]("tcp syscall: invalid ip literal")
    BytesSet(raw, offset + octetIndex, octet)
    return Ok[bool](true)

@borrows
fn tcpSockAddrFromHostPort(host: str, port: int32, out: var TcpSockAddr, isV6: bool = false): Result[bool] =
    let useLenField: bool = os.udpPlatformUseLenFieldBridge() != 0
    return udp.udpSockAddrFromHostPort(host, port, isV6, 0, useLenField, out)

@borrows
fn tcpSockAddrFromHostPort4(host: str, port: int32, out: var TcpSockAddr): Result[bool] =
    if port < 0 || port > 65535:
        return Err[bool]("tcp syscall: port out of range")
    let addrSize: int32 = 16
    let raw: Bytes = BytesAlloc(addrSize)
    if os.udpPlatformUseLenFieldBridge() != 0:
        BytesSet(raw, 0, addrSize & 0xff)
        BytesSet(raw, 1, tcpAfInet & 0xff)
    else:
        BytesSet(raw, 0, tcpAfInet & 0xff)
        BytesSet(raw, 1, (tcpAfInet >> 8) & 0xff)
    BytesSet(raw, 2, (port >> 8) & 0xff)
    BytesSet(raw, 3, port & 0xff)
    var normalizedHost: str = strings.CloneStr(host)
    if host == "localhost":
        normalizedHost = "127.0.0.1"
    let parseRes: Result[bool] = tcpWriteIpv4Literal(raw, 4, normalizedHost)
    if IsErr(parseRes):
        return Err[bool](ErrorText(parseRes))
    out.data = raw
    out.len = addrSize
    out.family = tcpAfInet
    out.isV6 = false
    if len(normalizedHost) > 0:
        out.host = normalizedHost
    else:
        out.host = "0.0.0.0"
    out.port = port
    return Ok[bool](true)

@borrows
fn tcpSockAddrFromHostPort6(host: str, port: int32, out: var TcpSockAddr): Result[bool] =
    let useLenFieldCode: int32 = os.udpPlatformUseLenFieldBridge()
    if useLenFieldCode != 0:
        let bsdRes: Result[bool] = udp.UdpSockAddrFromHostPort6(host, port, tcpAfInet6Bsd, useLenFieldCode, out)
        if !IsErr(bsdRes):
            return bsdRes
        return udp.UdpSockAddrFromHostPort6(host, port, tcpAfInet6Linux, useLenFieldCode, out)
    let linuxRes: Result[bool] = udp.UdpSockAddrFromHostPort6(host, port, tcpAfInet6Linux, useLenFieldCode, out)
    if !IsErr(linuxRes):
        return linuxRes
    return udp.UdpSockAddrFromHostPort6(host, port, tcpAfInet6Bsd, useLenFieldCode, out)

fn tcpSockAddrDecode(raw: Bytes, rawLen: int32, out: var TcpSockAddr): Result[bool] =
    return udp.udpSockAddrDecode(raw, rawLen, out)

fn tcpSockAddrUnknown(raw: Bytes, rawLen: int32): TcpSockAddr =
    var out: TcpSockAddr
    if rawLen > 0 && rawLen <= BytesLen(raw):
        out.data = BytesSlice(raw, 0, rawLen)
        out.len = rawLen
    else:
        out.data = emptyBytes()
        out.len = 0
    out.family = 0
    out.isV6 = false
    out.host = ""
    out.port = 0
    return out

@borrows
fn tcpSockAddrCanonical(addr: TcpSockAddr): str =
    if addr.isV6:
        return strutil.Join(["tcp://[", strings.CloneStr(addr.host), "]:", IntToStr(addr.port)], "")
    return strutil.Join(["tcp://", strings.CloneStr(addr.host), ":", IntToStr(addr.port)], "")

@borrows
fn tcpEndpointError(prefix: str, host: str, port: int32, cause: str): str =
    return strutil.Join([strings.CloneStr(prefix), strings.CloneStr(host), ":", IntToStr(port), ": ", strings.CloneStr(cause)], "")

@borrows
fn tcpMobileConnect4Protected(host: str, port: int32, timeoutMs: int32): Result[TcpConnectionHandle] =
    var remoteAddr: TcpSockAddr
    let remoteRes: Result[bool] = tcpSockAddrFromHostPort4(host, port, remoteAddr)
    if IsErr(remoteRes):
        return Err[TcpConnectionHandle](Error(remoteRes))
    if BytesLen(remoteAddr.data) < 8:
        return Err[TcpConnectionHandle]("tcp syscall: invalid remote address")
    let fd: int32 = cheng_mobile_tcp_connect4_protected_addr_bridge(
        BytesGet(remoteAddr.data, 4),
        BytesGet(remoteAddr.data, 5),
        BytesGet(remoteAddr.data, 6),
        BytesGet(remoteAddr.data, 7),
        port,
        timeoutMs
    )
    if fd < 0:
        let errCode: int32 = 0 - fd
        return Err[TcpConnectionHandle](tcpErrMessage("tcp syscall: mobile protected connect failed: ", errCode))
    # [thruput-window] 高 RTT 链路(CN→SG ~380ms)的下行吞吐被接收通告窗口
    # 物理锁死: 默认 rcvbuf 87KB → in-flight 上限 87KB/0.38s ≈ 230KB/s,
    # 实测因 app_limited 连 BBR 都爬不起来只有 ~16KB/s。SO_RCVBUF=1MB
    # (SOL_SOCKET=1, SO_RCVBUF=8) 把通告窗口抬到 BDP 量级。
    # 值经堆 Bytes 传指针(&本地标量直传是冷后端指针 lowering 雷区,
    # 野指针写 4 字节=连接静默死, Bytes.data 同文件大量先例)。
    var rcvBufBytes: Bytes = rawbytes.BytesAlloc(4)
    if rcvBufBytes.data != nil:
        BytesSet(rcvBufBytes, 0, 0)
        BytesSet(rcvBufBytes, 1, 0)
        BytesSet(rcvBufBytes, 2, 16)
        BytesSet(rcvBufBytes, 3, 0)
        let _ = libc_setsockopt(fd, 1, 8, rcvBufBytes.data, 4)
        BytesFree(rcvBufBytes)
    var localAddr: TcpSockAddr
    let localRes: Result[bool] = tcpGetSockName(fd, localAddr)
    if IsErr(localRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](Error(localRes))
    return Ok[TcpConnectionHandle](
        TcpConnectionHandle(
            fd: fd,
            localAddr: localAddr,
            remoteAddr: remoteAddr,
            open: true
        )
    )

fn tcpGetSockName(fd: int32, out: var TcpSockAddr): Result[bool] =
    if fd < 0:
        return Err[bool]("tcp syscall: invalid socket")
    var rawAddr: Bytes = BytesAlloc(128)
    var rawLen: int32 = BytesLen(rawAddr)
    let rc: int32 = os.udpGetSockNameFd(fd, rawAddr, rawLen)
    if rc != 0:
        let errCode: int32 = tcpErrno()
        BytesFree(rawAddr)
        return Err[bool](tcpErrMessage("tcp syscall: getsockname failed: ", errCode))
    if rawLen <= 0:
        BytesFree(rawAddr)
        return Err[bool]("tcp syscall: getsockname empty address")
    if rawLen > BytesLen(rawAddr):
        rawLen = BytesLen(rawAddr)
    let decoded: Result[bool] = tcpSockAddrDecode(rawAddr, rawLen, out)
    BytesFree(rawAddr)
    return decoded

@borrows
fn tcpListen(host: str, port: int32, isV6: bool = false): Result[TcpListenerHandle] =
    let openRes: Result[int32] = tcpSocketOpenStream(isV6)
    if IsErr(openRes):
        return Err[TcpListenerHandle](Error(openRes))
    let fd: int32 = Value(openRes)
    var addr: TcpSockAddr
    let addrRes: Result[bool] = tcpSockAddrFromHostPort(host, port, addr, isV6)
    if IsErr(addrRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpListenerHandle](Error(addrRes))
    let bindRes: int32 = os.udpBindFd(fd, addr.data, addr.len)
    if bindRes != 0:
        let errCode: int32 = tcpErrno()
        let _ = os.UdpCloseFd(fd)
        return Err[TcpListenerHandle](tcpErrMessage("tcp syscall: bind failed: ", errCode))
    let listenRes: int32 = os.TcpListenFd(fd, 16)
    if listenRes != 0:
        let errCode: int32 = tcpErrno()
        let _ = os.UdpCloseFd(fd)
        return Err[TcpListenerHandle](tcpErrMessage("tcp syscall: listen failed: ", errCode))
    var localAddr: TcpSockAddr = addr
    if port == 0:
        let localRes: Result[bool] = tcpGetSockName(fd, localAddr)
        if IsErr(localRes):
            let _ = os.UdpCloseFd(fd)
            return Err[TcpListenerHandle](Error(localRes))
    return Ok[TcpListenerHandle](TcpListenerHandle(fd: fd, addr: localAddr))

@borrows
fn tcpListen4(host: str, port: int32): Result[TcpListenerHandle] =
    let fd: int32 = cheng_tcp_listen_host_port_bridge(strToCStringTemp(host), port, 0)
    if fd < 0:
        let errCode: int32 = 0 - fd
        return Err[TcpListenerHandle](tcpErrMessage("tcp syscall: listen bridge failed: ", errCode))
    var localAddr: TcpSockAddr
    localAddr.data.data = nil
    localAddr.data.len = 0
    localAddr.len = 0
    localAddr.family = tcpAfInet
    localAddr.isV6 = false
    localAddr.host = host
    localAddr.port = port
    return Ok[TcpListenerHandle](TcpListenerHandle(fd: fd, addr: localAddr))

@borrows
fn tcpListen4Fill(host: str, port: int32, out: var TcpListenerHandle): Result[bool] =
    out.fd = -1
    out.addr.data.data = nil
    out.addr.data.len = 0
    out.addr.len = 0
    out.addr.family = tcpAfInet
    out.addr.isV6 = false
    out.addr.host = strings.CloneStr(host)
    out.addr.port = port
    let fd: int32 = cheng_tcp_listen_host_port_bridge(strToCStringTemp(strings.CloneStr(host)), port, 0)
    if fd < 0:
        let errCode: int32 = 0 - fd
        return Err[bool](tcpErrMessage("tcp syscall: listen bridge failed: ", errCode))
    var boundPort: int32 = port
    if port == 0:
        boundPort = os.UdpBoundPortBridge(fd, 0)
        if boundPort <= 0:
            let errCode: int32 = 0 - boundPort
            let _ = os.UdpCloseFd(fd)
            return Err[bool](tcpErrMessage("tcp syscall: bound port failed: ", errCode))
    out.fd = fd
    out.addr.port = boundPort
    return Ok[bool](true)

@borrows
fn tcpListen6(host: str, port: int32): Result[TcpListenerHandle] =
    let openRes: Result[int32] = tcpSocketOpenStream6()
    if IsErr(openRes):
        return Err[TcpListenerHandle](Error(openRes))
    let fd: int32 = Value(openRes)
    var addr: TcpSockAddr
    let addrRes: Result[bool] = tcpSockAddrFromHostPort6(host, port, addr)
    if IsErr(addrRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpListenerHandle](Error(addrRes))
    let bindRes: int32 = os.udpBindFd(fd, addr.data, addr.len)
    if bindRes != 0:
        let errCode: int32 = tcpErrno()
        let _ = os.UdpCloseFd(fd)
        return Err[TcpListenerHandle](tcpErrMessage("tcp syscall: bind failed: ", errCode))
    let listenRes: int32 = os.TcpListenFd(fd, 16)
    if listenRes != 0:
        let errCode: int32 = tcpErrno()
        let _ = os.UdpCloseFd(fd)
        return Err[TcpListenerHandle](tcpErrMessage("tcp syscall: listen failed: ", errCode))
    var localAddr: TcpSockAddr = addr
    if port == 0:
        let localRes: Result[bool] = tcpGetSockName(fd, localAddr)
        if IsErr(localRes):
            let _ = os.UdpCloseFd(fd)
            return Err[TcpListenerHandle](Error(localRes))
    return Ok[TcpListenerHandle](TcpListenerHandle(fd: fd, addr: localAddr))

@borrows
fn tcpListenFill(host: str,
                 port: int32,
                 out: var TcpListenerHandle,
                 isV6: bool = false): Result[bool] =
    out.fd = -1
    let openRes: Result[int32] = tcpSocketOpenStream(isV6)
    if IsErr(openRes):
        return Err[bool](Error(openRes))
    let fd: int32 = Value(openRes)
    var addr: TcpSockAddr
    let addrRes: Result[bool] = tcpSockAddrFromHostPort(host, port, addr, isV6)
    if IsErr(addrRes):
        let _ = os.UdpCloseFd(fd)
        return Err[bool](Error(addrRes))
    let bindRes: int32 = os.udpBindFd(fd, addr.data, addr.len)
    if bindRes != 0:
        let errCode: int32 = tcpErrno()
        let _ = os.UdpCloseFd(fd)
        return Err[bool](tcpErrMessage("tcp syscall: bind failed: ", errCode))
    let listenRes: int32 = os.TcpListenFd(fd, 16)
    if listenRes != 0:
        let errCode: int32 = tcpErrno()
        let _ = os.UdpCloseFd(fd)
        return Err[bool](tcpErrMessage("tcp syscall: listen failed: ", errCode))
    var localAddr: TcpSockAddr = addr
    if port == 0:
        let localRes: Result[bool] = tcpGetSockName(fd, localAddr)
        if IsErr(localRes):
            let _ = os.UdpCloseFd(fd)
            return Err[bool](Error(localRes))
    out.fd = fd
    out.addr = localAddr
    return Ok[bool](true)

fn tcpListenerClose(listener: var TcpListenerHandle) =
    // Same fdsan invariant as tcpClose: fd 0 is JVM-owned on Android, never a
    // listener socket; zero-value handles must not reach close(0).
    if listener.fd > 0:
        let _ = os.UdpCloseFd(listener.fd)
        listener.fd = -1

@borrows
fn tcpListenerSetNonblocking(listener: TcpListenerHandle, enabled: bool): Result[bool] =
    if listener.fd < 0:
        return Err[bool]("tcp syscall: invalid listener")
    let enabledCode: int32 = if enabled: 1 else: 0
    let rc: int32 = cheng_fd_set_nonblocking_bridge(listener.fd, enabledCode)
    if rc != 0:
        let errCode: int32 = tcpErrno()
        return Err[bool](tcpErrMessage("tcp syscall: listener nonblocking failed: ", errCode))
    return Ok[bool](true)

@borrows
fn tcpListenerWaitReadable(listener: TcpListenerHandle, timeoutMs: int32): Result[bool] =
    if listener.fd < 0:
        return Err[bool]("tcp syscall: invalid listener")
    let rc: int32 = cheng_fd_wait_readable_bridge(listener.fd, timeoutMs)
    if rc < 0:
        let errCode: int32 = 0 - rc
        if errCode > 0:
            return Err[bool](tcpErrMessage("tcp syscall: listener wait readable failed: ", errCode))
        return Err[bool]("tcp syscall: listener wait readable failed")
    return Ok[bool](rc != 0)

@borrows
fn tcpConnectionWaitReadable(conn: TcpConnectionHandle, timeoutMs: int32): Result[bool] =
    if conn.fd < 0 || !conn.open:
        return Err[bool]("tcp syscall: invalid connection")
    let rc: int32 = cheng_fd_wait_readable_bridge(conn.fd, timeoutMs)
    if rc < 0:
        let errCode: int32 = 0 - rc
        if errCode > 0:
            return Err[bool](tcpErrMessage("tcp syscall: connection wait readable failed: ", errCode))
        return Err[bool]("tcp syscall: connection wait readable failed")
    return Ok[bool](rc != 0)

@borrows
fn tcpAccept(listener: TcpListenerHandle): Result[TcpConnectionHandle] =
    if listener.fd < 0:
        return Err[TcpConnectionHandle]("tcp syscall: invalid listener")
    let rawAddr: Bytes = emptyBytes()
    var rawLen: int32 = BytesLen(rawAddr)
    let fd: int32 = os.TcpAcceptFd(listener.fd, rawAddr, rawLen)
    if fd < 0:
        let errCode: int32 = tcpErrno()
        return Err[TcpConnectionHandle](tcpErrMessage("tcp syscall: accept failed: ", errCode))
    var remoteAddr: TcpSockAddr = tcpSockAddrUnknown(rawAddr, rawLen)
    var localAddr: TcpSockAddr = listener.addr
    localAddr.data = BytesSlice(listener.addr.data, 0, listener.addr.len)
    var out: TcpConnectionHandle
    out.fd = fd
    out.localAddr = localAddr
    out.remoteAddr = remoteAddr
    out.open = true
    return Ok[TcpConnectionHandle](out)

@borrows
fn tcpAcceptInto(listener: TcpListenerHandle, out: var TcpConnectionHandle): bool =
    out.fd = -1
    var localAddr: TcpSockAddr = listener.addr
    localAddr.data = BytesSlice(listener.addr.data, 0, listener.addr.len)
    out.localAddr = localAddr
    out.remoteAddr = tcpSockAddrUnknown(emptyBytes(), 0)
    out.open = false
    if listener.fd < 0:
        return false
    let fd: int32 = cheng_tcp_accept_noaddr_bridge(listener.fd)
    if fd < 0:
        return false
    out.fd = fd
    out.open = true
    return true

fn tcpAcceptFdInto(listenerFd: int32, out: var TcpConnectionHandle): bool =
    out.fd = -1
    out.open = false
    if listenerFd < 0:
        return false
    let fd: int32 = os.TcpAcceptFdNoAddr(listenerFd)
    if fd < 0:
        return false
    out.fd = fd
    out.open = true
    return true

@borrows
fn tcpAcceptNonblocking(listener: TcpListenerHandle): Result[TcpConnectionHandle] =
    if listener.fd < 0:
        return Err[TcpConnectionHandle]("tcp syscall: invalid listener")
    let fd: int32 = os.TcpAcceptFdNoAddr(listener.fd)
    if fd < 0:
        let errCode: int32 = tcpErrno()
        if tcpWouldBlock(errCode):
            return Err[TcpConnectionHandle]("tcp syscall: would block")
        return Err[TcpConnectionHandle](tcpErrMessage("tcp syscall: accept failed: ", errCode))
    var remoteAddr: TcpSockAddr = tcpSockAddrUnknown(emptyBytes(), 0)
    var localAddr: TcpSockAddr = listener.addr
    localAddr.data = BytesSlice(listener.addr.data, 0, listener.addr.len)
    var out: TcpConnectionHandle
    out.fd = fd
    out.localAddr = localAddr
    out.remoteAddr = remoteAddr
    out.open = true
    return Ok[TcpConnectionHandle](out)

@borrows
fn tcpConnect(host: str, port: int32, isV6: bool = false): Result[TcpConnectionHandle] =
    let openRes: Result[int32] = tcpSocketOpenStream(isV6)
    if IsErr(openRes):
        return Err[TcpConnectionHandle](Error(openRes))
    let fd: int32 = Value(openRes)
    let protectRes: Result[bool] = tcpProtectOutboundFdForHost(fd, host)
    if IsErr(protectRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](Error(protectRes))
    var remoteAddr: TcpSockAddr
    var remoteRes: Result[bool]
    if isV6:
        remoteRes = tcpSockAddrFromHostPort6(host, port, remoteAddr)
    else:
        remoteRes = tcpSockAddrFromHostPort4(host, port, remoteAddr)
    if IsErr(remoteRes):
        let _ = os.UdpCloseFd(fd)
        return tcpConnectResolved(host, port)
    let connectRes: int32 = os.TcpConnectFd(fd, remoteAddr.data, remoteAddr.len)
    if connectRes != 0:
        let errCode: int32 = tcpErrno()
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](tcpErrMessage("tcp syscall: connect failed: ", errCode))
    var localAddr: TcpSockAddr
    let localRes: Result[bool] = tcpGetSockName(fd, localAddr)
    if IsErr(localRes):
        let _ = os.UdpCloseFd(fd)
        return Err[TcpConnectionHandle](Error(localRes))
    return Ok[TcpConnectionHandle](
        TcpConnectionHandle(
            fd: fd,
            localAddr: localAddr,
            remoteAddr: remoteAddr,
            open: true
        )
    )

