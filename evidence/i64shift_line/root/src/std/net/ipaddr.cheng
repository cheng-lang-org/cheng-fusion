# ipaddr.cheng - IP address helpers (IPv4/IPv6 parsing + formatting)
#
# API 对齐 pkg://cheng/libp2p 的 utils/ipaddr，便于机械替换 import。

import std/result
import std/rawbytes
import std/strings
import std/buffer

const
    ipAddrTmpDigitsLen = 4
    ipAddrHextetsLen = 8

type
    IpAddr =
        isV6: bool
        data: Bytes

fn ipAddrIsV6(addr: IpAddr): bool =
    addr.isV6

fn ipAddrIsV4(addr: IpAddr): bool =
    !addr.isV6

fn ipAddrBytes(addr: IpAddr): Bytes =
    return addr.data

fn ipAddrEqual(a: IpAddr, b: IpAddr): bool =
    if a.isV6 != b.isV6:
        return false
    return BytesEqual(a.data, b.data)

@borrows
@borrows
fn ipaddrParseUIntRange(text: str, start: int32, count: int32): Result[int32] =
    if count <= 0:
        return Err[int32]("ipaddr: empty number")
    var i: int32
    var value: int32
    for i in i..<count:
        let c: char = text[start + i]
        if c < '0' || c > '9':
            return Err[int32]("ipaddr: invalid number")
        value = value * 10 + (int32(c) - int32('0'))
    return Ok[int32](value)

@borrows
fn parseIPv4Bytes(text: str): Result[Bytes] =
    var parts: int32
    var i: int32
    var start: int32
    let out: Bytes = BytesAlloc(4)
    for i in range(len(text) + 1):
        var partEnd: bool
        if i == len(text):
            partEnd = true
        elif text[i] == '.':
            partEnd = true
        if partEnd:
            let count: int32 = i - start
            let partRes: Result[int32] = ipaddrParseUIntRange(text, start, count)
            if IsErr(partRes):
                return Err[Bytes](Error(partRes))
            let value: int32 = Value(partRes)
            if value < 0 || value > 255:
                return Err[Bytes]("ipaddr: ipv4 out of range")
            if parts >= 4:
                return Err[Bytes]("ipaddr: ipv4 parts")
            BytesSet(out, parts, value)
            parts = parts + 1
            start = i + 1
    if parts != 4:
        return Err[Bytes]("ipaddr: ipv4 parts")
    return Ok[Bytes](out)

fn ipaddrHexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return int32(c) - int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + (int32(c) - int32('a'))
    if c >= 'A' && c <= 'F':
        return 10 + (int32(c) - int32('A'))
    return -1

@borrows
@borrows
fn ipaddrParseHexSegment(text: str, start: int32, count: int32): Result[int32] =
    if count <= 0 || count > 4:
        return Err[int32]("ipaddr: ipv6 part length")
    var i: int32
    var value: int32
    for i in i..<count:
        let v: int32 = ipaddrHexValue(text[start + i])
        if v < 0:
            return Err[int32]("ipaddr: ipv6 invalid hex")
        value = (value << 4) + v
    return Ok[int32](value)

@borrows
fn ipaddrWriteHextet(buf: Bytes, idx: int32, value: int32) =
    BytesSet(buf, idx * 2, (value >> 8) & 255)
    BytesSet(buf, idx * 2 + 1, value & 255)

@borrows
fn parseIPv6Bytes(text: str): Result[Bytes] =
    if len(text) <= 0:
        return Err[Bytes]("ipaddr: ipv6 empty")
    var head: Bytes = BytesAlloc(16)
    var tail: Bytes = BytesAlloc(16)
    var headCount: int32
    var tailCount: int32
    var seenCompress: bool
    var i: int32
    var segmentStart: int32
    while i <= len(text):
        let atEnd: bool = i == len(text)
        var isColon: bool
        if !atEnd:
            if text[i] == ':':
                isColon = true
        if atEnd || isColon:
            if i == segmentStart:
                var isDoubleColon: bool
                if isColon:
                    if i + 1 < len(text):
                        if text[i + 1] == ':':
                            isDoubleColon = true
                if isDoubleColon:
                    if seenCompress:
                        return Err[Bytes]("ipaddr: ipv6 multiple ::")
                    seenCompress = true
                    i = i + 1
                    segmentStart = i + 1
                else:
                    if atEnd && seenCompress:
                        break
                    return Err[Bytes]("ipaddr: ipv6 empty part")
            else:
                let partRes: Result[int32] = ipaddrParseHexSegment(text, segmentStart, i - segmentStart)
                if IsErr(partRes):
                    return Err[Bytes](Error(partRes))
                let value: int32 = Value(partRes)
                if !seenCompress:
                    if headCount >= 8:
                        return Err[Bytes]("ipaddr: ipv6 parts")
                    ipaddrWriteHextet(head, headCount, value)
                    headCount = headCount + 1
                else:
                    if tailCount >= 8:
                        return Err[Bytes]("ipaddr: ipv6 parts")
                    ipaddrWriteHextet(tail, tailCount, value)
                    tailCount = tailCount + 1
                var isDoubleColon: bool
                if isColon:
                    if i + 1 < len(text):
                        if text[i + 1] == ':':
                            isDoubleColon = true
                if isDoubleColon:
                    if seenCompress:
                        return Err[Bytes]("ipaddr: ipv6 multiple ::")
                    seenCompress = true
                    i = i + 1
                segmentStart = i + 1
        i = i + 1
    if seenCompress:
        if headCount + tailCount > 8:
            return Err[Bytes]("ipaddr: ipv6 parts")
    else:
        if headCount != 8:
            return Err[Bytes]("ipaddr: ipv6 parts")
    let out: Bytes = BytesAlloc(16)
    var outIdx: int32
    var headIdx: int32
    for headIdx in headIdx..<headCount:
        BytesSet(out, outIdx, BytesGet(head, headIdx * 2))
        BytesSet(out, outIdx + 1, BytesGet(head, headIdx * 2 + 1))
        outIdx = outIdx + 2
    let zeroHextets: int32 = if seenCompress: 8 - (headCount + tailCount) else: 0
    var zeroIdx: int32
    for zeroIdx in zeroIdx..<zeroHextets:
        BytesSet(out, outIdx, 0)
        BytesSet(out, outIdx + 1, 0)
        outIdx = outIdx + 2
    var tailIdx: int32
    for tailIdx in tailIdx..<tailCount:
        BytesSet(out, outIdx, BytesGet(tail, tailIdx * 2))
        BytesSet(out, outIdx + 1, BytesGet(tail, tailIdx * 2 + 1))
        outIdx = outIdx + 2
    return Ok[Bytes](out)

@borrows
fn parseIpAddr(text: str): Result[IpAddr] =
    if len(text) <= 0:
        return Err[IpAddr]("ipaddr: empty")
    if strContains(text, ":"):
        let ipv6Res: Result[Bytes] = parseIPv6Bytes(text)
        if IsErr(ipv6Res):
            var v6ErrText: str = Error(ipv6Res)
            return Err[IpAddr](v6ErrText)
        var v6Data: Bytes = Value(ipv6Res)
        var v6Addr: IpAddr
        v6Addr.isV6 = true
        v6Addr.data = v6Data
        return Ok[IpAddr](v6Addr)
    let ipv4Res: Result[Bytes] = parseIPv4Bytes(text)
    if IsErr(ipv4Res):
        var v4ErrText: str = Error(ipv4Res)
        return Err[IpAddr](v4ErrText)
    var v4Data: Bytes = Value(ipv4Res)
    var v4Addr: IpAddr
    v4Addr.isV6 = false
    v4Addr.data = v4Data
    return Ok[IpAddr](v4Addr)

fn appendDecimal(buf: var buffer.GrowByteBuffer, value: int32) =
    if value == 0:
        buffer.appendByte(buf, int32('0'))
        return
    var tmp: int32[ipAddrTmpDigitsLen]
    var count: int32
    var v: int32 = value
    while v > 0:
        tmp[count] = v % 10
        count = count + 1
        v = v / 10
    let iStart3 = count - 1
    for iOffset2 in 0..iStart3:
        let i = iStart3 - iOffset2
        buffer.appendByte(buf, int32('0') + tmp[i])

fn appendHexHextet(buf: var buffer.GrowByteBuffer, value: int32) =
    if value == 0:
        buffer.appendByte(buf, int32('0'))
        return
    var tmp: int32[ipAddrTmpDigitsLen]
    var count: int32
    var v: int32 = value
    while v > 0:
        tmp[count] = v & 15
        count = count + 1
        v = v >> 4
    let iStart2 = count - 1
    for iOffset in 0..iStart2:
        let i = iStart2 - iOffset
        let digit: int32 = tmp[i]
        if digit < 10:
            buffer.appendByte(buf, int32('0') + digit)
        else:
            buffer.appendByte(buf, int32('a') + (digit - 10))

fn ipAddrToString(addr: IpAddr): str =
    if addr.data.data == nil || addr.data.len <= 0:
        return ""
    if !addr.isV6:
        if BytesLen(addr.data) < 4:
            return ""
        var buf: buffer.GrowByteBuffer = buffer.newByteBuffer()
        for i in 0..<4:
            if i > 0:
                buffer.appendByte(buf, int32('.'))
            appendDecimal(buf, BytesGet(addr.data, i))
        return BytesToString(buffer.toBytes(buf))
    if BytesLen(addr.data) < 16:
        return ""
    var hextets: int32[ipAddrHextetsLen]
    for i in 0..<8:
        let hi: int32 = BytesGet(addr.data, i * 2)
        let lo: int32 = BytesGet(addr.data, i * 2 + 1)
        hextets[i] = (hi << 8) + lo
    var bestStart: int32 = -1
    var bestLen: int32
    var curStart: int32 = -1
    var curLen: int32
    i = 0
    for i in i..<8:
        if hextets[i] == 0:
            if curStart < 0:
                curStart = i
                curLen = 1
            else:
                curLen = curLen + 1
        else:
            if curStart >= 0 && curLen > bestLen:
                bestStart = curStart
                bestLen = curLen
            curStart = -1
            curLen = 0
    if curStart >= 0 && curLen > bestLen:
        bestStart = curStart
        bestLen = curLen
    if bestLen < 2:
        bestStart = -1
        bestLen = 0
    var buf: buffer.GrowByteBuffer = buffer.newByteBuffer()
    i = 0
    for _ in i..<8:
        if ! (i < 8):
            break
        if bestStart >= 0 && i == bestStart:
            buffer.appendByte(buf, int32(':'))
            buffer.appendByte(buf, int32(':'))
            i = i + bestLen
            if i >= 8:
                break
        else:
            let bufBytes: Bytes = buffer.toBytes(buf)
            if BytesLen(bufBytes) > 0 && !(bestStart >= 0 && i == bestStart):
                if !(BytesGet(bufBytes, BytesLen(bufBytes) - 1) == int32(':')):
                    buffer.appendByte(buf, int32(':'))
            appendHexHextet(buf, hextets[i])
            i = i + 1
    return BytesToString(buffer.toBytes(buf))

@borrows
fn ParseIpAddr(text: str): Result[IpAddr] =
    return parseIpAddr(text)
