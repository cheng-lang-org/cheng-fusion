# std/unicode.cheng - general-purpose Unicode data: General_Category L/N
# membership, canonical combining class, and NFC normalization (canonical
# decomposition + canonical ordering + canonical composition, UAX #15).
#
# Not bound to any specific model. Backing data is a binary fixture built at
# build time from the real Unicode Character Database by
# ts-csg/scripts/unicode-tables-build.mjs (magic/version/format documented
# there and mirrored below). Hangul syllables are handled algorithmically
# (UAX #15 formula), matching every conformant NFC implementation (ICU,
# Python unicodedata, ...) -- they are intentionally absent from the fixture
# tables.
#
# Binary format (little-endian), all integers int32 unless noted:
#   header: magic, version, lRangeCount, nRangeCount, combiningCount,
#           decompIndexCount, decompFlatCount, composeCount, int64 contentHash
#   lRanges: lRangeCount * (start, end)              -- inclusive, sorted
#   nRanges: nRangeCount * (start, end)               -- inclusive, sorted
#   combining: combiningCount * (cp, class)           -- sorted by cp, class != 0
#   decompIndex: decompIndexCount * (cp, offset, length) -- sorted by cp
#   decompFlat: decompFlatCount * cp
#   compose: composeCount * (leftCp, rightCp, composedCp) -- sorted by (left,right)

import std/result
import std/os
import std/rawbytes
import std/system

const
    UnicodeTablesMagic: int32 = 0x314e5543
    UnicodeTablesVersion: int32 = 1
    unicodeHangulSBase: int32 = 0xac00
    unicodeHangulLBase: int32 = 0x1100
    unicodeHangulVBase: int32 = 0x1161
    unicodeHangulTBase: int32 = 0x11a7
    unicodeHangulLCount: int32 = 19
    unicodeHangulVCount: int32 = 21
    unicodeHangulTCount: int32 = 28
    unicodeHangulNCount: int32 = 588   # VCount * TCount
    unicodeHangulSCount: int32 = 11172 # LCount * NCount

type
    UnicodeTables =
        lRangeStart: int32[]
        lRangeEnd: int32[]
        nRangeStart: int32[]
        nRangeEnd: int32[]
        combiningCp: int32[]
        combiningCls: int32[]
        decompCp: int32[]
        decompOffset: int32[]
        decompLength: int32[]
        decompFlat: int32[]
        composeLeft: int32[]
        composeRight: int32[]
        composeResult: int32[]

fn unicodeReadI32LE(buf: rawbytes.Bytes, offset: int32): int32 =
    let b0: int64 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1: int64 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2: int64 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3: int64 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    return int32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

fn unicodeReadI64LE(buf: rawbytes.Bytes, offset: int32): int64 =
    let b0: int64 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1: int64 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2: int64 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3: int64 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    let b4: int64 = int64(rawbytes.BytesGet(buf, offset + 4) & 255)
    let b5: int64 = int64(rawbytes.BytesGet(buf, offset + 5) & 255)
    let b6: int64 = int64(rawbytes.BytesGet(buf, offset + 6) & 255)
    let b7: int64 = int64(rawbytes.BytesGet(buf, offset + 7) & 255)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)

# Mirrors WeightTensorHashStep in src/inference/weight_store.cheng exactly
# (int64 wraparound multiply-add, negative results negated, never masked).
fn unicodeHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(524287) + value + int64(113)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

fn UnicodeTablesLoad(path: str): Result[UnicodeTables] =
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[UnicodeTables](Error(bytesRes))
    let buf = Value(bytesRes)
    if rawbytes.BytesLen(buf) < 36:
        return Err[UnicodeTables]("unicode tables: truncated header")
    var offset: int32
    let magic = unicodeReadI32LE(buf, offset)
    offset = offset + 4
    if magic != UnicodeTablesMagic:
        return Err[UnicodeTables]("unicode tables: bad magic")
    let version = unicodeReadI32LE(buf, offset)
    offset = offset + 4
    if version != UnicodeTablesVersion:
        return Err[UnicodeTables]("unicode tables: bad version")
    let lRangeCount = unicodeReadI32LE(buf, offset)
    offset = offset + 4
    let nRangeCount = unicodeReadI32LE(buf, offset)
    offset = offset + 4
    let combiningCount = unicodeReadI32LE(buf, offset)
    offset = offset + 4
    let decompIndexCount = unicodeReadI32LE(buf, offset)
    offset = offset + 4
    let decompFlatCount = unicodeReadI32LE(buf, offset)
    offset = offset + 4
    let composeCount = unicodeReadI32LE(buf, offset)
    offset = offset + 4
    let contentHash = unicodeReadI64LE(buf, offset)
    offset = offset + 8
    if lRangeCount < 0 || nRangeCount < 0 || combiningCount < 0 || decompIndexCount < 0 ||
       decompFlatCount < 0 || composeCount < 0:
        return Err[UnicodeTables]("unicode tables: negative count")

    var h: int64 = int64(113)
    h = unicodeHashStep(h, int64(magic))
    h = unicodeHashStep(h, int64(version))
    h = unicodeHashStep(h, int64(lRangeCount))
    h = unicodeHashStep(h, int64(nRangeCount))
    h = unicodeHashStep(h, int64(combiningCount))
    h = unicodeHashStep(h, int64(decompIndexCount))
    h = unicodeHashStep(h, int64(decompFlatCount))
    h = unicodeHashStep(h, int64(composeCount))

    var t: UnicodeTables
    setLen(t.lRangeStart, lRangeCount)
    setLen(t.lRangeEnd, lRangeCount)
    for i in 0..<lRangeCount:
        t.lRangeStart[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        t.lRangeEnd[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        h = unicodeHashStep(h, int64(t.lRangeStart[i]))
        h = unicodeHashStep(h, int64(t.lRangeEnd[i]))

    setLen(t.nRangeStart, nRangeCount)
    setLen(t.nRangeEnd, nRangeCount)
    for i in 0..<nRangeCount:
        t.nRangeStart[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        t.nRangeEnd[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        h = unicodeHashStep(h, int64(t.nRangeStart[i]))
        h = unicodeHashStep(h, int64(t.nRangeEnd[i]))

    setLen(t.combiningCp, combiningCount)
    setLen(t.combiningCls, combiningCount)
    for i in 0..<combiningCount:
        t.combiningCp[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        t.combiningCls[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        h = unicodeHashStep(h, int64(t.combiningCp[i]))
        h = unicodeHashStep(h, int64(t.combiningCls[i]))

    setLen(t.decompCp, decompIndexCount)
    setLen(t.decompOffset, decompIndexCount)
    setLen(t.decompLength, decompIndexCount)
    for i in 0..<decompIndexCount:
        t.decompCp[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        t.decompOffset[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        t.decompLength[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        h = unicodeHashStep(h, int64(t.decompCp[i]))
        h = unicodeHashStep(h, int64(t.decompOffset[i]))
        h = unicodeHashStep(h, int64(t.decompLength[i]))

    setLen(t.decompFlat, decompFlatCount)
    for i in 0..<decompFlatCount:
        t.decompFlat[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        h = unicodeHashStep(h, int64(t.decompFlat[i]))

    setLen(t.composeLeft, composeCount)
    setLen(t.composeRight, composeCount)
    setLen(t.composeResult, composeCount)
    for i in 0..<composeCount:
        t.composeLeft[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        t.composeRight[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        t.composeResult[i] = unicodeReadI32LE(buf, offset)
        offset = offset + 4
        h = unicodeHashStep(h, int64(t.composeLeft[i]))
        h = unicodeHashStep(h, int64(t.composeRight[i]))
        h = unicodeHashStep(h, int64(t.composeResult[i]))

    if h != contentHash:
        return Err[UnicodeTables]("unicode tables: content hash mismatch")
    return Ok[UnicodeTables](t)

@borrows
fn unicodeRangeContains(starts: int32[], ends: int32[], cp: int32): bool =
    var lo: int32
    var hi: int32 = starts.len - 1
    while lo <= hi:
        let mid: int32 = lo + (hi - lo) / 2
        if cp < starts[mid]:
            hi = mid - 1
        elif cp > ends[mid]:
            lo = mid + 1
        else:
            return true
    return false

@borrows
fn UnicodeIsLetter(t: UnicodeTables, cp: int32): bool =
    return unicodeRangeContains(t.lRangeStart, t.lRangeEnd, cp)

@borrows
fn UnicodeIsNumber(t: UnicodeTables, cp: int32): bool =
    return unicodeRangeContains(t.nRangeStart, t.nRangeEnd, cp)

@borrows
fn unicodeCombiningFind(t: UnicodeTables, cp: int32): int32 =
    var lo: int32
    var hi: int32 = t.combiningCp.len - 1
    while lo <= hi:
        let mid: int32 = lo + (hi - lo) / 2
        if t.combiningCp[mid] == cp:
            return mid
        elif t.combiningCp[mid] < cp:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

@borrows
fn UnicodeCombiningClass(t: UnicodeTables, cp: int32): int32 =
    if cp >= unicodeHangulSBase && cp < unicodeHangulSBase + unicodeHangulSCount:
        return 0
    let idx: int32 = unicodeCombiningFind(t, cp)
    if idx < 0:
        return 0
    return t.combiningCls[idx]

@borrows
fn unicodeDecompFind(t: UnicodeTables, cp: int32): int32 =
    var lo: int32
    var hi: int32 = t.decompCp.len - 1
    while lo <= hi:
        let mid: int32 = lo + (hi - lo) / 2
        if t.decompCp[mid] == cp:
            return mid
        elif t.decompCp[mid] < cp:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

@borrows
fn unicodeDecomposeOneAppend(t: UnicodeTables, cp: int32, out: var int32[]) =
    if cp >= unicodeHangulSBase && cp < unicodeHangulSBase + unicodeHangulSCount:
        let sIndex: int32 = cp - unicodeHangulSBase
        let l: int32 = unicodeHangulLBase + sIndex / unicodeHangulNCount
        let v: int32 = unicodeHangulVBase + (sIndex % unicodeHangulNCount) / unicodeHangulTCount
        let tt: int32 = sIndex % unicodeHangulTCount
        add(out, l)
        add(out, v)
        if tt != 0:
            add(out, unicodeHangulTBase + tt)
        return
    let idx: int32 = unicodeDecompFind(t, cp)
    if idx < 0:
        add(out, cp)
        return
    let off0: int32 = t.decompOffset[idx]
    let len0: int32 = t.decompLength[idx]
    for i in 0..<len0:
        add(out, t.decompFlat[off0 + i])

# Full canonical decomposition (NFD): recursive table expansion was already
# fully resolved at fixture-build time, so one pass here + canonical
# reordering (stable insertion sort within maximal non-starter runs, runs are
# always tiny so O(run^2) is irrelevant) is sufficient.
@borrows
fn UnicodeNfd(t: UnicodeTables, cps: int32[]): int32[] =
    var out: int32[]
    for i in 0..<cps.len:
        unicodeDecomposeOneAppend(t, cps[i], out)
    var i: int32
    while i < out.len:
        if UnicodeCombiningClass(t, out[i]) == 0:
            i = i + 1
        else:
            var j: int32 = i
            while j < out.len && UnicodeCombiningClass(t, out[j]) != 0:
                j = j + 1
            var k: int32 = i + 1
            while k < j:
                let key: int32 = out[k]
                let keyCls: int32 = UnicodeCombiningClass(t, key)
                var m: int32 = k - 1
                while m >= i && UnicodeCombiningClass(t, out[m]) > keyCls:
                    out[m + 1] = out[m]
                    m = m - 1
                out[m + 1] = key
                k = k + 1
            i = j
    return out

@borrows
fn unicodeComposeFind(t: UnicodeTables, left: int32, right: int32): int32 =
    var lo: int32
    var hi: int32 = t.composeLeft.len - 1
    while lo <= hi:
        let mid: int32 = lo + (hi - lo) / 2
        let cl: int32 = t.composeLeft[mid]
        let cr: int32 = t.composeRight[mid]
        if cl == left && cr == right:
            return mid
        elif cl < left || (cl == left && cr < right):
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

@borrows
fn UnicodeCompose(t: UnicodeTables, left: int32, right: int32): int32 =
    if left >= unicodeHangulLBase && left < unicodeHangulLBase + unicodeHangulLCount &&
       right >= unicodeHangulVBase && right < unicodeHangulVBase + unicodeHangulVCount:
        let lIndex: int32 = left - unicodeHangulLBase
        let vIndex: int32 = right - unicodeHangulVBase
        return unicodeHangulSBase + (lIndex * unicodeHangulVCount + vIndex) * unicodeHangulTCount
    if left >= unicodeHangulSBase && left < unicodeHangulSBase + unicodeHangulSCount &&
       (left - unicodeHangulSBase) % unicodeHangulTCount == 0 &&
       right > unicodeHangulTBase && right < unicodeHangulTBase + unicodeHangulTCount:
        return left + (right - unicodeHangulTBase)
    let idx: int32 = unicodeComposeFind(t, left, right)
    if idx < 0:
        return -1
    return t.composeResult[idx]

# UAX #15 canonical composition algorithm over an already-NFD'd + canonically
# ordered codepoint sequence.
@borrows
fn UnicodeNfc(t: UnicodeTables, cps: int32[]): int32[] =
    let d: int32[] = UnicodeNfd(t, cps)
    var out: int32[]
    var starterIdx: int32 = -1
    var lastClass: int32 = -1
    for i in 0..<d.len:
        let cp: int32 = d[i]
        let cls: int32 = UnicodeCombiningClass(t, cp)
        if starterIdx < 0:
            add(out, cp)
            if cls == 0:
                starterIdx = out.len - 1
                lastClass = -1
            else:
                lastClass = cls
        else:
            let starter: int32 = out[starterIdx]
            let blocked: bool = lastClass != -1 && lastClass >= cls
            var composed: int32 = -1
            if !blocked:
                composed = UnicodeCompose(t, starter, cp)
            if composed >= 0:
                out[starterIdx] = composed
            else:
                add(out, cp)
                if cls == 0:
                    starterIdx = out.len - 1
                    lastClass = -1
                else:
                    lastClass = cls
    return out

# --- UTF-8 codec (standard 1..4 byte encoding, no fallback: malformed input
# hard-fails rather than silently producing a replacement/garbage codepoint).
@borrows
fn Utf8Decode(bytes: rawbytes.Bytes): int32[] =
    var out: int32[]
    var i: int32
    let n: int32 = rawbytes.BytesLen(bytes)
    while i < n:
        let b0: int32 = rawbytes.BytesGet(bytes, i) & 255
        if b0 < 0x80:
            add(out, b0)
            i = i + 1
        elif (b0 & 0xe0) == 0xc0:
            Assert(i + 1 < n, "Utf8Decode: truncated 2-byte sequence")
            let b1: int32 = rawbytes.BytesGet(bytes, i + 1) & 255
            add(out, ((b0 & 0x1f) << 6) | (b1 & 0x3f))
            i = i + 2
        elif (b0 & 0xf0) == 0xe0:
            Assert(i + 2 < n, "Utf8Decode: truncated 3-byte sequence")
            let b1: int32 = rawbytes.BytesGet(bytes, i + 1) & 255
            let b2: int32 = rawbytes.BytesGet(bytes, i + 2) & 255
            add(out, ((b0 & 0x0f) << 12) | ((b1 & 0x3f) << 6) | (b2 & 0x3f))
            i = i + 3
        elif (b0 & 0xf8) == 0xf0:
            Assert(i + 3 < n, "Utf8Decode: truncated 4-byte sequence")
            let b1: int32 = rawbytes.BytesGet(bytes, i + 1) & 255
            let b2: int32 = rawbytes.BytesGet(bytes, i + 2) & 255
            let b3: int32 = rawbytes.BytesGet(bytes, i + 3) & 255
            add(out, ((b0 & 0x07) << 18) | ((b1 & 0x3f) << 12) | ((b2 & 0x3f) << 6) | (b3 & 0x3f))
            i = i + 4
        else:
            panic("Utf8Decode: invalid UTF-8 lead byte")
    return out

fn Utf8EncodeAppend(b: var rawbytes.BytesBuilder, cp: int32) =
    if cp < 0x80:
        rawbytes.BytesBuilderAppendByte(b, cp)
    elif cp < 0x800:
        rawbytes.BytesBuilderAppendByte(b, 0xc0 | (cp >> 6))
        rawbytes.BytesBuilderAppendByte(b, 0x80 | (cp & 0x3f))
    elif cp < 0x10000:
        rawbytes.BytesBuilderAppendByte(b, 0xe0 | (cp >> 12))
        rawbytes.BytesBuilderAppendByte(b, 0x80 | ((cp >> 6) & 0x3f))
        rawbytes.BytesBuilderAppendByte(b, 0x80 | (cp & 0x3f))
    else:
        rawbytes.BytesBuilderAppendByte(b, 0xf0 | (cp >> 18))
        rawbytes.BytesBuilderAppendByte(b, 0x80 | ((cp >> 12) & 0x3f))
        rawbytes.BytesBuilderAppendByte(b, 0x80 | ((cp >> 6) & 0x3f))
        rawbytes.BytesBuilderAppendByte(b, 0x80 | (cp & 0x3f))

fn Utf8Encode(cps: int32[]): rawbytes.Bytes =
    var b: rawbytes.BytesBuilder = rawbytes.BytesBuilderNew(cps.len)
    for i in 0..<cps.len:
        Utf8EncodeAppend(b, cps[i])
    return rawbytes.BytesBuilderFinish(b)

# Convenience: NFC-normalize a raw UTF-8 byte string end to end.
@borrows
fn UnicodeNfcBytes(t: UnicodeTables, input: rawbytes.Bytes): rawbytes.Bytes =
    let cps: int32[] = Utf8Decode(input)
    let normalized: int32[] = UnicodeNfc(t, cps)
    return Utf8Encode(normalized)
