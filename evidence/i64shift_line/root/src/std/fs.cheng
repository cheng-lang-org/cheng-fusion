# std/fs - Extended file system operations
import std/system
import std/strings
import std/result
import std/os

type
    FileStat =
        size: int64
        mode: int32
        mtime: int64
        isDir: bool
        isFile: bool

@importc("chmod")
fn libc_chmod(path: cstring, mode: int32): int32
@importc("realpath")
fn libc_realpath(path: cstring, resolved: var uint8[4096]): cstring
@importc("access")
fn libc_access(path: cstring, mode: int32): int32
@importc("unlink")
fn libc_unlink(path: cstring): int32
@importc("rmdir")
fn libc_rmdir(path: cstring): int32
@importc("mkdir")
fn libc_mkdir(path: cstring, mode: int32): int32
@importc("chdir")
fn libc_chdir(path: cstring): int32

# Provider-bound stat: libc_stat + Darwin field unpack live only in provider
# (cheng_fs_stat_scalars). std surface is typed FileStat; no buf:ptr / bare load.
@importc("cheng_fs_stat_scalars")
fn fs_rt_stat_scalars(path: cstring,
                      outSize: var int64,
                      outMode: var int32,
                      outMtime: var int64,
                      outIsDir: var int32,
                      outIsFile: var int32): int32

@borrows
fn stat(path: str): Result[FileStat] =
    if strings.Len(path) <= 0:
        return Err[FileStat]("empty path")
    let cpath: cstring = strToCStringTemp(path)
    var stSize: int64
    var stMode: int32
    var stMtime: int64
    var isDirFlag: int32
    var isFileFlag: int32
    let rc: int32 = fs_rt_stat_scalars(cpath,
                                       stSize,
                                       stMode,
                                       stMtime,
                                       isDirFlag,
                                       isFileFlag)
    if rc != 0:
        return Err[FileStat]("stat failed")
    var out: FileStat
    out.size = stSize
    out.mode = stMode
    out.mtime = stMtime
    out.isDir = isDirFlag != 0
    out.isFile = isFileFlag != 0
    return Ok[FileStat](out)

@borrows
fn statSize(path: str): int64 =
    let res: Result[FileStat] = stat(path)
    if result.IsOk(res):
        return result.Value[FileStat](res).size
    return int64(-1)

@borrows
fn statMode(path: str): int32 =
    let res: Result[FileStat] = stat(path)
    if result.IsOk(res):
        return result.Value[FileStat](res).mode
    return 0

@borrows
fn statMtime(path: str): int64 =
    let res: Result[FileStat] = stat(path)
    if result.IsOk(res):
        return result.Value[FileStat](res).mtime
    return int64(-1)

@borrows
fn isDir(path: str): bool =
    let res: Result[FileStat] = stat(path)
    if result.IsOk(res):
        return result.Value[FileStat](res).isDir
    return false

@borrows
fn isFile(path: str): bool =
    let res: Result[FileStat] = stat(path)
    if result.IsOk(res):
        return result.Value[FileStat](res).isFile
    return false

@borrows
fn chmod(path: str, mode: int32): Result[bool] =
    if strings.Len(path) <= 0:
        return Err[bool]("empty path")
    let rc: int32 = libc_chmod(strToCStringTemp(path), mode)
    if rc == 0:
        return Ok[bool](true)
    return Err[bool]("chmod failed")

@borrows
fn realpath(path: str): Result[str] =
    if strings.Len(path) <= 0:
        return Err[str]("empty path")
    var buf: uint8[4096]
    var zeroIndex: int32
    while zeroIndex < 4096:
        buf[zeroIndex] = 0
        zeroIndex = zeroIndex + 1
    let res: cstring = libc_realpath(strToCStringTemp(path), buf)
    if res == nil:
        return Err[str]("realpath failed")
    let out: str = strFromCStringCopy(res)
    return Ok[str](out)

@borrows
fn access(path: str, mode: int32): bool =
    if strings.Len(path) <= 0:
        return false
    if libc_access(strToCStringTemp(path), mode) == 0:
        return true
    return false

@borrows
fn exists(path: str): bool =
    return access(path, 0)

@borrows
fn isReadable(path: str): bool =
    return access(path, 4)

@borrows
fn isWritable(path: str): bool =
    return access(path, 2)

@borrows
fn isExecutable(path: str): bool =
    return access(path, 1)

@borrows
fn remove(path: str): Result[bool] =
    if strings.Len(path) <= 0:
        return Err[bool]("empty path")
    if isDir(path):
        let rc: int32 = libc_rmdir(strToCStringTemp(path))
        if rc == 0:
            return Ok[bool](true)
        return Err[bool]("rmdir failed")
    let rc: int32 = libc_unlink(strToCStringTemp(path))
    if rc == 0:
        return Ok[bool](true)
    return Err[bool]("unlink failed")

@borrows
fn mkdir(path: str, mode: int32): Result[bool] =
    if strings.Len(path) <= 0:
        return Err[bool]("empty path")
    let rc: int32 = libc_mkdir(strToCStringTemp(path), mode)
    if rc == 0:
        return Ok[bool](true)
    return Err[bool]("mkdir failed")

@borrows
fn chdir(path: str): Result[bool] =
    if strings.Len(path) <= 0:
        return Err[bool]("empty path")
    let rc: int32 = libc_chdir(strToCStringTemp(path))
    if rc == 0:
        return Ok[bool](true)
    return Err[bool]("chdir failed")

@borrows
fn readDir(path: str): str[] =
    return os.ListDir(path)

# ---- Public exports ----

@borrows
fn Stat(path: str): Result[FileStat] =
    return stat(path)

@borrows
fn StatSize(path: str): int64 =
    return statSize(path)

@borrows
fn StatMode(path: str): int32 =
    return statMode(path)

@borrows
fn StatMtime(path: str): int64 =
    return statMtime(path)

@borrows
fn IsDir(path: str): bool =
    return isDir(path)

@borrows
fn IsFile(path: str): bool =
    return isFile(path)

@borrows
fn Chmod(path: str, mode: int32): Result[bool] =
    return chmod(path, mode)

@borrows
fn Realpath(path: str): Result[str] =
    return realpath(path)

@borrows
fn Access(path: str, mode: int32): bool =
    return access(path, mode)

@borrows
fn Exists(path: str): bool =
    return exists(path)

@borrows
fn IsReadable(path: str): bool =
    return isReadable(path)

@borrows
fn IsWritable(path: str): bool =
    return isWritable(path)

@borrows
fn IsExecutable(path: str): bool =
    return isExecutable(path)

@borrows
fn Remove(path: str): Result[bool] =
    return remove(path)

@borrows
fn Mkdir(path: str, mode: int32): Result[bool] =
    return mkdir(path, mode)

@borrows
fn Chdir(path: str): Result[bool] =
    return chdir(path)

@borrows
fn ReadDir(path: str): str[] =
    return readDir(path)

const
    R_OK: int32 = 4
    W_OK: int32 = 2
    X_OK: int32 = 1
    F_OK: int32 = 0
