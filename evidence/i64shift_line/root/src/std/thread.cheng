import std/atomic
import std/system

@importc("cheng_thread_parallelism")
fn thread_parallelism_raw(): int32

@importc("cheng_thread_yield")
fn thread_yield_raw(): void

@importc("cheng_thread_start")
fn thread_start_raw(fnPtr: ptr, ctx: ptr): ptr

@importc("cheng_thread_spawn")
fn thread_spawn_raw(fnPtr: ptr, ctx: ptr): int32

@importc("cheng_thread_start0")
fn thread_start0_raw(entry: fn()): ptr

@importc("cheng_thread_spawn0")
fn thread_spawn0_raw(entry: fn()): int32

@importc("cheng_thread_join")
fn thread_join_raw(handle: ptr): int32

@importc("cheng_thread_detach")
fn thread_detach_raw(handle: ptr): int32

@importc("cheng_panic_cstring_and_exit")
fn thread_panic_raw(text: cstring): void

@importc("__cheng_call_indirect_void")
fn thread_call_indirect_void(fnPtr: ptr, ctx: ptr)

@importc("__cheng_call_indirect_i32")
fn thread_call_indirect_i32(fnPtr: ptr, ctx: ptr, a: int32, b: int32): int32

type
    Thread = ref object
        handle: ptr
        joined: bool
        detached: bool

    SpawnTaskPtr = ref object
        entry: ptr
        ctx: ptr

    Pool = ref object
        workerCount: int32

    ParallelForCtx = ref object
        count: int32
        nextIndex: atomic.I32
        body: ptr
        bodyCtx: ptr

    ParallelWorkerCtx = ref object
        shared: ParallelForCtx
        workerId: int32

@borrows
fn thread_spawn_task_entry(task: SpawnTaskPtr) =
    if task == nil:
        thread_panic_raw("cheng_thread_spawn_ptr_task_nil")
        return
    if task.entry != nil:
        thread_call_indirect_void(task.entry, task.ctx)
        return
    thread_panic_raw("cheng_thread_spawn_ptr_entry_nil")

fn thread_spawn_trampoline_ptr(raw: ptr) =
    if raw == nil:
        thread_panic_raw("cheng_thread_spawn_ptr_raw_nil")
        return
    thread_spawn_task_entry(SpawnTaskPtr(raw))

fn Parallelism(): int32 =
    return thread_parallelism_raw()

fn Yield() =
    thread_yield_raw()

fn ThreadFromHandle(handle: ptr): Thread =
    if handle == nil:
        thread_panic_raw("cheng_thread_start_failed")
        return nil
    let t = new(Thread)
    if t == nil:
        thread_panic_raw("cheng_thread_handle_alloc_failed")
        return nil
    t.handle = handle
    return t

@thread_boundary
fn Start(entry: ptr): Thread =
    if entry == nil:
        thread_panic_raw("cheng_thread_spawn_entry_nil")
        return nil
    let handle = thread_start_raw(entry, nil)
    if handle == nil:
        thread_panic_raw("cheng_thread_spawn_failed")
        return nil
    return ThreadFromHandle(handle)

@thread_boundary
fn StartFn(entry: fn()): Thread =
    if entry == nil:
        thread_panic_raw("cheng_thread_spawn_entry_nil")
        return nil
    let handle = thread_start0_raw(entry)
    if handle == nil:
        thread_panic_raw("cheng_thread_spawn_failed")
        return nil
    return ThreadFromHandle(handle)

@thread_boundary
@borrows
fn StartPtr(entry: ptr, ctx: ptr): Thread =
    if entry == nil:
        thread_panic_raw("cheng_thread_spawn_ptr_entry_nil")
        return nil
    let handle = thread_start_raw(entry, ctx)
    if handle == nil:
        thread_panic_raw("cheng_thread_spawn_ptr_failed")
        return nil
    return ThreadFromHandle(handle)

@borrows
fn JoinThread(t: Thread): bool =
    if t == nil || t.handle == nil:
        thread_panic_raw("cheng_thread_join_nil")
        return false
    if t.detached:
        thread_panic_raw("cheng_thread_join_detached")
        return false
    if t.joined:
        thread_panic_raw("cheng_thread_join_twice")
        return false
    if thread_join_raw(t.handle) == 0:
        thread_panic_raw("cheng_thread_join_failed")
        return false
    t.joined = true
    t.handle = nil
    return true

@borrows
fn Detach(t: Thread): bool =
    if t == nil || t.handle == nil:
        thread_panic_raw("cheng_thread_detach_nil")
        return false
    if t.joined:
        thread_panic_raw("cheng_thread_detach_joined")
        return false
    if t.detached:
        thread_panic_raw("cheng_thread_detach_twice")
        return false
    if thread_detach_raw(t.handle) == 0:
        thread_panic_raw("cheng_thread_detach_failed")
        return false
    t.detached = true
    t.handle = nil
    return true

@thread_boundary
fn Spawn(entry: ptr): bool =
    if entry == nil:
        thread_panic_raw("cheng_thread_spawn_entry_nil")
        return false
    if thread_spawn_raw(entry, nil) == 0:
        thread_panic_raw("cheng_thread_spawn_failed")
        return false
    return true

@thread_boundary
fn Spawn(entry: fn()): bool =
    if entry == nil:
        thread_panic_raw("cheng_thread_spawn_entry_nil")
        return false
    if thread_spawn0_raw(entry) == 0:
        thread_panic_raw("cheng_thread_spawn_failed")
        return false
    return true

@thread_boundary
fn SpawnPtr(entry: ptr, ctx: ptr): bool =
    if entry == nil:
        thread_panic_raw("cheng_thread_spawn_ptr_entry_nil")
        return false
    if thread_spawn_raw(entry, ctx) == 0:
        thread_panic_raw("cheng_thread_spawn_ptr_failed")
        return false
    return true

fn PoolNew(workerCount: int32): Pool =
    var count = workerCount
    if count <= 0:
        count = Parallelism()
    if count <= 0:
        count = 1
    let p = new(Pool)
    if p == nil:
        thread_panic_raw("cheng_thread_pool_alloc_failed")
        return nil
    p.workerCount = count
    return p

@borrows
fn thread_pool_ctx_run(ctx: ParallelForCtx, workerId: int32) =
    if ctx == nil || ctx.nextIndex == nil || ctx.body == nil:
        thread_panic_raw("cheng_thread_pool_ctx_invalid")
        return
    while true:
        let index = atomic.AddI32(ctx.nextIndex, 1) - 1
        if index >= ctx.count:
            break
        let _ = thread_call_indirect_i32(ctx.body, ctx.bodyCtx, index, workerId)

@borrows
fn thread_pool_worker_entry(worker: ParallelWorkerCtx) =
    if worker == nil:
        thread_panic_raw("cheng_thread_pool_worker_ctx_nil")
        return
    thread_pool_ctx_run(worker.shared, worker.workerId)

fn thread_pool_worker_main(raw: ptr) =
    if raw == nil:
        thread_panic_raw("cheng_thread_pool_ctx_nil")
        return
    thread_pool_worker_entry(ParallelWorkerCtx(raw))

fn ParallelForInitCtx(count: int32, body: ptr, bodyCtx: ptr): ParallelForCtx =
    let ctx = new(ParallelForCtx)
    if ctx == nil:
        thread_panic_raw("cheng_thread_pool_ctx_alloc_failed")
        return nil
    ctx.count = count
    ctx.nextIndex = atomic.NewI32(0)
    ctx.body = body
    ctx.bodyCtx = bodyCtx
    if ctx.nextIndex == nil:
        thread_panic_raw("cheng_thread_pool_atomic_alloc_failed")
        return nil
    return ctx

@borrows
fn ParallelForSpawnWorker(ctx: ParallelForCtx, workerId: int32): ParallelWorkerCtx =
    let workerCtx = new(ParallelWorkerCtx)
    if workerCtx == nil:
        thread_panic_raw("cheng_thread_pool_worker_ctx_alloc_failed")
        return nil
    workerCtx.shared = ctx
    workerCtx.workerId = workerId
    return workerCtx

fn ParallelForStartWorker(workerCtx: ParallelWorkerCtx): ptr =
    let handle = thread_start_raw(&thread_pool_worker_main, workerCtx)
    if handle == nil:
        thread_panic_raw("cheng_thread_pool_worker_start_failed")
        return nil
    return handle

@borrows
fn ParallelForJoinAll(workers: ptr[]) =
    var i: int32
    for i in 0..<workers.len:
        if thread_join_raw(workers[i]) == 0:
            thread_panic_raw("cheng_thread_pool_worker_join_failed")
            return

@borrows
fn ParallelForRunWorkers(ctx: ParallelForCtx, workerCount: int32) =
    var workers: ptr[]
    var workerCtxs: ParallelWorkerCtx[]
    var workerId: int32
    for workerId in 0..<workerCount:
        let workerCtx = ParallelForSpawnWorker(ctx, workerId)
        let handle = ParallelForStartWorker(share(workerCtx))
        add(workerCtxs, workerCtx)
        add(workers, handle)
    ParallelForJoinAll(workers)
    let _ = workerCtxs.len

@thread_boundary
fn ParallelFor(pool: Pool,
               count: int32,
               body: ptr,
               bodyCtx: ptr) =
    if count <= 0:
        return
    if body == nil:
        thread_panic_raw("cheng_thread_pool_body_nil")
        return
    var workerCount = 1
    if pool != nil && pool.workerCount > 0:
        workerCount = pool.workerCount
    if workerCount > count:
        workerCount = count
    let ctx = ParallelForInitCtx(count, body, bodyCtx)
    ParallelForRunWorkers(ctx, workerCount)
