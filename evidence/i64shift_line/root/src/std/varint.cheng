# varint.cheng - Varint encode/decode (unsigned, base-128)
#
# API 对齐 pkg://cheng/libp2p 的 utils/varint，便于机械替换 import。

import std/result
import std/rawbytes
import std/buffer as bytebuffer

type
    VarintDecoded =
        value: int64
        next: int32

fn encodeUVarint(value: int64): Bytes =
    if value < 0:
        return emptyBytes()
    var v: int64 = value
    var tmp: int32[10]
    var n: int32
    while true:
        let chunk: int32 = int32(v % 128)
        v = v / 128
        if v != 0:
            tmp[n] = chunk + 128
            n = n + 1
        else:
            tmp[n] = chunk
            n = n + 1
            break
    let out: Bytes = BytesAlloc(n)
    var i: int32
    while i < n:
        BytesSet(out, i, tmp[i])
        i = i + 1
    return out

@borrows
fn decodeUVarint(data: Bytes, offset: int32): Result[VarintDecoded] =
    if offset < 0:
        return Err[VarintDecoded]("varint: negative offset")
    var i: int32 = offset
    var mul: int64 = 1
    var result: int64
    let total: int32 = BytesLen(data)
    for i in i..<total:
        let b: int32 = BytesGet(data, i)
        let low: int32 = b % 128
        result = result + (int64(low) * mul)
        if b < 128:
            var out: Result[VarintDecoded]
            out.ok = true
            out.value.value = result
            out.value.next = i + 1
            ErrorOkInto(out.err)
            return out
        mul = mul * 128
        if mul <= 0:
            return Err[VarintDecoded]("varint: overflow")
    return Err[VarintDecoded]("varint: truncated input")
