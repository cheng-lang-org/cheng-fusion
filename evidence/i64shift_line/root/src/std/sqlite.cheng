type
    Connection =
        handle: uint64
        path: str
        readonly: bool

    Statement =
        handle: uint64

    Status =
        ok: bool
        code: int32
        error: str

    OpenResult =
        ok: bool
        db: Connection
        code: int32
        error: str

    PrepareResult =
        ok: bool
        stmt: Statement
        code: int32
        error: str

    StepResult =
        row: bool
        done: bool
        code: int32
        error: str

const
    SqliteOk: int32 = 0
    SqliteRow: int32 = 100
    SqliteDone: int32 = 101

@importc("cheng_sqlite_open_readonly")
fn sqliteRawOpenReadonly(path: str): uint64

@importc("cheng_sqlite_open_readwrite")
fn sqliteRawOpenReadwrite(path: str): uint64

@importc("cheng_sqlite_close")
fn sqliteRawClose(handle: uint64): int32

@importc("cheng_sqlite_prepare")
fn sqliteRawPrepare(dbHandle: uint64, sql: str): uint64

@importc("cheng_sqlite_prepare_path")
fn sqliteRawPreparePath(path: str, readonly: int32, sql: str): uint64

@importc("cheng_sqlite_finalize")
fn sqliteRawFinalize(stmtHandle: uint64): int32

@importc("cheng_sqlite_bind_text")
fn sqliteRawBindText(stmtHandle: uint64, index: int32, value: str): int32

@importc("cheng_sqlite_bind_int64")
fn sqliteRawBindInt64(stmtHandle: uint64, index: int32, value: int64): int32

@importc("cheng_sqlite_step")
fn sqliteRawStep(stmtHandle: uint64): int32

@importc("cheng_sqlite_column_text")
fn sqliteRawColumnText(stmtHandle: uint64, index: int32): str

@importc("cheng_sqlite_column_int64")
fn sqliteRawColumnInt64(stmtHandle: uint64, index: int32): int64

@importc("cheng_sqlite_last_error")
fn sqliteRawLastError(): str

fn LastError(): str =
    return sqliteRawLastError()

fn StatusFromCode(code: int32): Status =
    var result: Status
    result.code = code
    if code == SqliteOk:
        result.ok = true
        return result
    result.error = LastError()
    if result.error == "":
        result.error = "sqlite operation failed"
    return result

fn OpenReadonly(path: str): OpenResult =
    var result: OpenResult
    let handle = sqliteRawOpenReadonly(path)
    if handle == 0:
        result.code = 1
        result.error = LastError()
        if result.error == "":
            result.error = "sqlite open readonly failed"
        return result
    result.ok = true
    result.db.handle = handle
    result.db.path = path
    result.db.readonly = true
    return result

fn OpenReadwrite(path: str): OpenResult =
    var result: OpenResult
    let handle = sqliteRawOpenReadwrite(path)
    if handle == 0:
        result.code = 1
        result.error = LastError()
        if result.error == "":
            result.error = "sqlite open readwrite failed"
        return result
    result.ok = true
    result.db.handle = handle
    result.db.path = path
    result.db.readonly = false
    return result

fn Close(db: Connection): Status =
    return StatusFromCode(sqliteRawClose(db.handle))

fn Prepare(db: Connection, sql: str): PrepareResult =
    var result: PrepareResult
    var readonly: int32
    if db.readonly:
        readonly = 1
    let handle = sqliteRawPreparePath(db.path, readonly, sql)
    if handle == 0:
        result.code = 1
        if db.path == "":
            result.error = "sqlite prepare failed: empty connection path"
            return result
        result.error = LastError()
        if result.error == "":
            result.error = "sqlite prepare failed"
        return result
    result.ok = true
    result.stmt.handle = handle
    return result

fn Finalize(stmt: Statement): Status =
    return StatusFromCode(sqliteRawFinalize(stmt.handle))

fn BindText(stmt: Statement, index: int32, value: str): Status =
    return StatusFromCode(sqliteRawBindText(stmt.handle, index, value))

fn BindInt64(stmt: Statement, index: int32, value: int64): Status =
    return StatusFromCode(sqliteRawBindInt64(stmt.handle, index, value))

fn Step(stmt: Statement): StepResult =
    var result: StepResult
    let code = sqliteRawStep(stmt.handle)
    result.code = code
    if code == SqliteRow:
        result.row = true
        return result
    if code == SqliteDone:
        result.done = true
        return result
    result.error = LastError()
    if result.error == "":
        result.error = "sqlite step failed"
    return result

fn ColumnText(stmt: Statement, index: int32): str =
    return sqliteRawColumnText(stmt.handle, index)

fn ColumnInt64(stmt: Statement, index: int32): int64 =
    return sqliteRawColumnInt64(stmt.handle, index)
