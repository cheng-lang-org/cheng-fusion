# rawbytes.cheng - raw pointer bytes helpers (binary-safe)
#
# 注意：这里的 Bytes 与 pkg://cheng/libp2p 的 utils/bytes 对齐，方便机械替换 import。

import std/system
import std/strings
import std/rawmem_support

@abi_internal
@importc("cheng_rawbytes_get_at")
fn chengRawbytesGetAt(base: ptr, idx: int32): int32
@abi_internal
@importc("cheng_rawbytes_set_at")
fn chengRawbytesSetAt(base: ptr, idx: int32, value: int32)

type
    byte = int32
    Bytes =
        data: ptr
        len: int32

fn BytesView(data: ptr, length: int32): Bytes =
    var safeLen: int32 = length
    if safeLen < 0:
        safeLen = 0
    var out: Bytes
    out.data = data
    out.len = safeLen
    return out

fn emptyBytes(): Bytes =
    var out: Bytes
    out.data = nil
    out.len = 0
    return out

@borrows
fn __cheng_bytes_eq(a: Bytes, b: Bytes): bool =
    return BytesEqual(a, b)

@borrows
fn __cheng_bytes_neq(a: Bytes, b: Bytes): bool =
    return !BytesEqual(a, b)

@borrows
fn `$`(b: Bytes): str =
    return BytesToHex(b)

fn bytesFromHexNibble(c: char): int32 =
    if c >= '0' && c <= '9':
        return Int32(c) - Int32('0')
    if c >= 'a' && c <= 'f':
        return Int32(c) - Int32('a') + 10
    if c >= 'A' && c <= 'F':
        return Int32(c) - Int32('A') + 10
    return -1

@borrows
fn BytesFromHex(text: str): Bytes =
    let n: int32 = len(text) / 2
    if n <= 0:
        return EmptyBytes()
    var out: Bytes = BytesAlloc(n)
    var i: int32
    while i < n:
        let hi: int32 = bytesFromHexNibble(text[i * 2])
        let lo: int32 = bytesFromHexNibble(text[i * 2 + 1])
        if hi < 0 || lo < 0:
            BytesFree(out)
            return EmptyBytes()
        BytesSet(out, i, (hi << 4) | lo)
        i = i + 1
    return out

fn EmptyBytes(): Bytes =
    var out: Bytes
    out.data = nil
    out.len = 0
    return out

fn BytesAlloc(length: int32): Bytes =
    var out: Bytes
    if length <= 0:
        out.data = nil
        out.len = 0
        return out
    let p: ptr = HeapNewCompat(length)
    if p == nil:
        out.data = nil
        out.len = 0
        return out
    rawmem_support.RawmemSet(p, 0, length)
    out.data = p
    out.len = length
    return out

@borrows
@borrow_result
fn BytesFromString(s: str): Bytes =
    var out: Bytes
    let n = StrLenFast(s)
    out.data = s.data
    out.len = n
    return out

fn BytesFree(b: var Bytes) =
    if b.data != nil:
        # [free-hunt] 非对齐 data=视图/内点(合法堆 payload 最小 8 对齐)。移动端
        # tun worker 周期性被 foreign free fail-stop 打死, 此处先 panic 点名
        # (消息进 failstop.log, 与 cheng_free_locked 的 FREEFOR 尸检互补)。
        if (uint64(b.data) & uint64(7)) != uint64(0):
            var msg: str = "BFMISS data=" + strings.Int64ToStr(int64(b.data))
            msg = msg + " len=" + strings.Int64ToStr(int64(b.len))
            panic(msg)
        Free(b.data)
    b.data = nil
    b.len = 0

fn BytesTake(b: var Bytes): Bytes =
    var out: Bytes
    out.data = b.data
    out.len = b.len
    b.data = nil
    b.len = 0
    return out

@borrows
fn BytesToString(b: Bytes): str =
    if b.data == nil || b.len <= 0:
        return ""
    return NewStringCopy(b.data, b.len)

@borrows
fn BytesLen(b: Bytes): int32 =
    return b.len

@borrows
fn BytesDataPtr(b: Bytes): ptr =
    return b.data

@borrows
fn BytesGet(b: Bytes, idx: int32): int32 =
    if idx < 0 || idx >= b.len:
        return 0
    return chengRawbytesGetAt(b.data, idx)

fn BytesSet(b: var Bytes, idx: int32, val: int32) =
    if idx < 0 || idx >= b.len:
        return
    chengRawbytesSetAt(b.data, idx, val)

@borrows
fn BytesSlice(b: Bytes, start: int32, count: int32): Bytes =
    var out: Bytes
    var start0: int32 = start
    var n: int32 = count
    if n <= 0:
        out.data = nil
        out.len = 0
        return out
    if start0 < 0:
        out.data = nil
        out.len = 0
        return out
    if start0 >= b.len:
        out.data = nil
        out.len = 0
        return out
    if start0 + n > b.len:
        n = b.len - start0
    if n <= 0:
        out.data = nil
        out.len = 0
        return out
    out = BytesAlloc(n)
    rawmem_support.RawmemCopy(out.data, rawmem_support.RawmemPtrAdd(b.data, start0), n)
    return out

@borrows
@borrow_result
fn BytesSliceView(b: Bytes, start: int32, count: int32): Bytes =
    var out: Bytes
    out.data = b.data
    out.len = 0
    var start0: int32 = start
    var n: int32 = count
    if n <= 0:
        return out
    if start0 < 0:
        return out
    if start0 >= b.len:
        return out
    if start0 + n > b.len:
        n = b.len - start0
    if n <= 0:
        return out
    out.data = rawmem_support.RawmemPtrAdd(b.data, start0)
    out.len = n
    return out

@borrows
fn BytesCopyInto(dst: Bytes, offset: int32, src: Bytes) =
    let n: int32 = BytesLen(src)
    if n <= 0:
        return
    Assert(dst.data != nil, "BytesCopyInto: nil dst")
    Assert(src.data != nil, "BytesCopyInto: nil src")
    Assert(offset >= 0, "BytesCopyInto: negative offset")
    Assert(offset + n <= dst.len, "BytesCopyInto: range overflow")
    rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(dst.data, offset), src.data, n)

@borrows
fn BytesCopyRangeInto(dst: Bytes, dstOffset: int32, src: Bytes, srcOffset: int32, count: int32) =
    if count <= 0:
        return
    Assert(dst.data != nil, "BytesCopyRangeInto: nil dst")
    Assert(src.data != nil, "BytesCopyRangeInto: nil src")
    Assert(dstOffset >= 0, "BytesCopyRangeInto: negative dst offset")
    Assert(srcOffset >= 0, "BytesCopyRangeInto: negative src offset")
    Assert(count <= dst.len, "BytesCopyRangeInto: dst count overflow")
    Assert(count <= src.len, "BytesCopyRangeInto: src count overflow")
    Assert(dstOffset <= dst.len - count, "BytesCopyRangeInto: dst range overflow")
    Assert(srcOffset <= src.len - count, "BytesCopyRangeInto: src range overflow")
    rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(dst.data, dstOffset),
                              rawmem_support.RawmemPtrAdd(src.data, srcOffset),
                              count)

@borrows
fn BytesEqual(a: Bytes, b: Bytes): bool =
    if a.len != b.len:
        return false
    var i: int32
    while i < a.len:
        let av: int32 = BytesGet(a, i)
        let bv: int32 = BytesGet(b, i)
        if av != bv:
            return false
        i = i + 1
    return true

@borrows
fn BytesToHex(b: Bytes): str =
    let n = BytesLen(b)
    if n <= 0:
        return ""
    if n > 1073741823:
        panic("rawbytes_to_hex_size_overflow")
    var out = BytesAlloc(n * 2)
    if BytesDataPtr(out) == nil || out.len != n * 2:
        BytesFree(out)
        panic("rawbytes_to_hex_alloc_failed")
    var i: int32
    while i < n:
        let v = BytesGet(b, i) & 255
        let hi = (v >> 4) & 15
        let lo = v & 15
        var hiChar: int32 = Int32('0') + hi
        var loChar: int32 = Int32('0') + lo
        if hi >= 10:
            hiChar = Int32('a') + (hi - 10)
        if lo >= 10:
            loChar = Int32('a') + (lo - 10)
        BytesSet(out, i * 2, hiChar)
        BytesSet(out, i * 2 + 1, loChar)
        i = i + 1
    # Explicit independent copy: the linux x64 build aliased the
    # BytesToString result to `out` (view semantics), so freeing `out` left the
    # returned str dangling and its later release hit registry_miss. NewStringAlloc
    # is a fresh heap block and cannot alias; the memcpy makes the str own its bytes.
    var text = system.NewStringAlloc(n * 2)
    if system.StrDataPtr(text) == nil:
        BytesFree(out)
        return ""
    rawmem_support.RawmemCopy(system.StrDataPtr(text), BytesDataPtr(out), n * 2)
    BytesFree(out)
    return text

@borrows
fn BytesConcat(a: Bytes, b: Bytes): Bytes =
    let aLen: int32 = BytesLen(a)
    let bLen: int32 = BytesLen(b)
    if aLen <= 0 && bLen <= 0:
        return EmptyBytes()
    let outLen: int32 = aLen + bLen
    var out: Bytes = BytesAlloc(outLen)
    BytesCopyInto(out, 0, a)
    BytesCopyInto(out, aLen, b)
    return out

@borrows
fn BytesConcat3(a: Bytes, b: Bytes, c: Bytes): Bytes =
    let aLen: int32 = BytesLen(a)
    let bLen: int32 = BytesLen(b)
    let cLen: int32 = BytesLen(c)
    if aLen <= 0 && bLen <= 0 && cLen <= 0:
        return EmptyBytes()
    let outLen: int32 = aLen + bLen + cLen
    var out: Bytes = BytesAlloc(outLen)
    BytesCopyInto(out, 0, a)
    BytesCopyInto(out, aLen, b)
    BytesCopyInto(out, aLen + bLen, c)
    return out

# --- BytesBuilder: O(1) 摊还 append -----------------------------------------
#
# 消除 BytesConcat 链式拼接的 O(n^2) churn（每次全量重分配+拷贝）。字段布局与
# ChengSeqHeader（src/core/runtime/program_support_backend.cheng）逐字节对齐
# (len:int32, cap:int32, buffer:ptr)，因此可以直接复用 seq 既有的、真正做
# doubling 扩容的生产 runtime 原语 cheng_seq_grow_inst（elemSize=1），不新写
# 任何扩容算法，只新增 Bytes 语义的外壳。
#
# 生命周期：BytesBuilderNew 开局，BytesBuilderAppend/AppendByte 累积，最终
# 必须以 BytesBuilderFinish（正常移交所有权给 Bytes）或 BytesBuilderFree
# （放弃，仅释放）二选一收尾。Finish/Free 之后 builder 清零，不可再用。
type
    BytesBuilder =
        len: int32
        cap: int32
        buffer: ptr

@abi_internal
@importc("cheng_seq_grow_inst")
fn bytesBuilderGrowInst(seqPtr: ptr, minCap: int32, elemSize: int32)

fn BytesBuilderNew(capacityHint: int32): BytesBuilder =
    var out: BytesBuilder
    out.len = 0
    out.cap = 0
    out.buffer = nil
    if capacityHint > 0:
        bytesBuilderGrowInst(&out, capacityHint, 1)
    return out

fn BytesBuilderNew(): BytesBuilder =
    return BytesBuilderNew(0)

@borrows
fn BytesBuilderLen(b: BytesBuilder): int32 =
    return b.len

@borrows
fn BytesBuilderAppend(b: var BytesBuilder, src: Bytes) =
    let n: int32 = BytesLen(src)
    if n <= 0:
        return
    let needLen: int32 = b.len + n
    Assert(needLen >= b.len, "BytesBuilderAppend: length overflow")
    if needLen > b.cap || b.buffer == nil:
        bytesBuilderGrowInst(&b, needLen, 1)
    rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(b.buffer, b.len), src.data, n)
    b.len = needLen

fn BytesBuilderAppendByte(b: var BytesBuilder, value: int32) =
    let needLen: int32 = b.len + 1
    if needLen > b.cap || b.buffer == nil:
        bytesBuilderGrowInst(&b, needLen, 1)
    chengRawbytesSetAt(b.buffer, b.len, value)
    b.len = needLen

# 移交所有权：返回的 Bytes 直接接管 builder 的堆缓冲区（不拷贝、不收缩），
# builder 清零后不可再用。空 builder 返回 EmptyBytes()（并释放已分配但未写
# 内容的多余容量，维持 Bytes 的 len<=0 <=> data==nil 惯例）。
fn BytesBuilderFinish(b: var BytesBuilder): Bytes =
    var out: Bytes
    if b.len <= 0:
        if b.buffer != nil:
            Free(b.buffer)
        out.data = nil
        out.len = 0
    else:
        out.data = b.buffer
        out.len = b.len
    b.buffer = nil
    b.len = 0
    b.cap = 0
    return out

# 放弃 builder（不产出 Bytes），释放其持有的缓冲区。
fn BytesBuilderFree(b: var BytesBuilder) =
    if b.buffer != nil:
        Free(b.buffer)
    b.buffer = nil
    b.len = 0
    b.cap = 0
