import std/result
import std/rawbytes
import std/rawmem_support

const
    fixedBytes32Size: int32 = 32
    fixedBytes64Size: int32 = 64
    fixedBytes65Size: int32 = 65
    FixedBytes32Size: int32 = 32
    FixedBytes64Size: int32 = 64
    FixedBytes65Size: int32 = 65

type
    ByteSpan =
        data: Bytes

    ByteBuf =
        storage: Bytes
        len: int32
        cap: int32

    FixedBytes32 =
        data: uint8[fixedBytes32Size]

    FixedBytes64 =
        data: uint8[fixedBytes64Size]

    FixedBytes65 =
        data: uint8[fixedBytes65Size]

fn byteSpanEmpty(): ByteSpan =
    return ByteSpan(data: EmptyBytes())

@borrows
fn byteSpanFromBytes(data: Bytes): ByteSpan =
    return ByteSpan(data: BytesSlice(data, 0, BytesLen(data)))

@borrows
fn byteSpanLen(span: ByteSpan): int32 =
    return BytesLen(span.data)

@borrows
fn byteSpanAt(span: ByteSpan, idx: int32): int32 =
    return BytesGet(span.data, idx)

@borrows
fn byteSpanSlice(span: ByteSpan, start: int32, count: int32): ByteSpan =
    return ByteSpan(data: BytesSlice(span.data, start, count))

@borrows
fn byteSpanToBytes(span: ByteSpan): Bytes =
    let n = BytesLen(span.data)
    if n <= 0:
        return EmptyBytes()
    if span.data.data == nil:
        panic("bytes_layout_bytespan_source_invalid")
    var out = BytesAlloc(n)
    if out.data == nil || out.len != n:
        BytesFree(out)
        panic("bytes_layout_bytespan_copy_alloc_failed")
    rawmem_support.RawmemCopy(out.data, span.data.data, n)
    return out

fn byteBufInit(cap0: int32): ByteBuf =
    if cap0 < 0:
        panic("bytes_layout_bytebuf_negative_capacity")
    var cap: int32 = cap0
    if cap < 64:
        cap = 64
    var out: ByteBuf
    var storage = BytesAlloc(cap)
    if storage.data == nil || storage.len != cap:
        BytesFree(storage)
        panic("bytes_layout_bytebuf_alloc_failed")
    out.storage = storage
    out.len = 0
    out.cap = cap
    return out

@borrows
fn byteBufLen(buf: ByteBuf): int32 =
    return buf.len

@borrows
fn byteBufCap(buf: ByteBuf): int32 =
    return buf.cap

fn byteBufCheckedGrowCapacity(currentCap: int32,
                              need: int32,
                              nextCapOut: var int32): bool =
    if currentCap < 0 || need < 0:
        return false
    var nextCap = currentCap
    if nextCap < 64:
        nextCap = 64
    while nextCap < need:
        if nextCap > 1073741823:
            nextCap = need
        else:
            nextCap = nextCap * 2
    nextCapOut = nextCap
    return true

fn byteBufClear(buf: var ByteBuf) =
    buf.len = 0

fn byteBufEnsure(buf: var ByteBuf, extra: int32) =
    if extra < 0 || buf.len < 0 || buf.cap < 0 ||
       buf.len > buf.cap || buf.storage.len < buf.cap ||
       (buf.cap > 0 && buf.storage.data == nil):
        panic("bytes_layout_bytebuf_state_invalid")
    if extra == 0:
        return
    if buf.len > 2147483647 - extra:
        panic("bytes_layout_bytebuf_size_overflow")
    let need: int32 = buf.len + extra
    if need <= buf.cap:
        return
    var nextCap: int32
    if !byteBufCheckedGrowCapacity(buf.cap, need, nextCap):
        panic("bytes_layout_bytebuf_capacity_invalid")
    var nextStorage: Bytes = BytesAlloc(nextCap)
    if nextStorage.data == nil || nextStorage.len != nextCap:
        BytesFree(nextStorage)
        panic("bytes_layout_bytebuf_grow_alloc_failed")
    if buf.len > 0:
        rawmem_support.RawmemCopy(nextStorage.data, buf.storage.data, buf.len)
    var previousStorage = BytesTake(buf.storage)
    buf.storage = nextStorage
    buf.cap = nextCap
    BytesFree(previousStorage)

fn byteBufFree(buf: var ByteBuf) =
    BytesFree(buf.storage)
    buf.len = 0
    buf.cap = 0

fn byteBufAppendByte(buf: var ByteBuf, value: int32) =
    byteBufEnsure(buf, 1)
    BytesSet(buf.storage, buf.len, value & 255)
    buf.len = buf.len + 1

@borrows
fn byteBufAppendBytes(buf: var ByteBuf, data: Bytes) =
    let addLen: int32 = BytesLen(data)
    if addLen <= 0:
        return
    byteBufEnsure(buf, addLen)
    rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(buf.storage.data, buf.len), data.data, addLen)
    buf.len = buf.len + addLen

@borrows
fn byteBufAppendFixed32(buf: var ByteBuf, value: FixedBytes32) =
    byteBufEnsure(buf, fixedBytes32Size)
    let start = buf.len
    for i in 0..<fixedBytes32Size:
        BytesSet(buf.storage, start + i, Int32(value.data[i]) & 255)
    buf.len = start + fixedBytes32Size

@borrows
fn byteBufAppendSpan(buf: var ByteBuf, span: ByteSpan) =
    byteBufAppendBytes(buf, span.data)

@borrows
fn byteBufView(buf: var ByteBuf): ByteSpan =
    if buf.len < 0 || buf.cap < 0 || buf.len > buf.cap ||
       buf.storage.len < buf.cap ||
       (buf.len > 0 && buf.storage.data == nil):
        panic("bytes_layout_bytebuf_view_state_invalid")
    return ByteSpan(data: BytesSlice(buf.storage, 0, buf.len))

@borrows
fn byteBufToBytes(buf: ByteBuf): Bytes =
    if buf.len < 0 || buf.cap < 0 || buf.len > buf.cap ||
       buf.storage.len < buf.cap ||
       (buf.len > 0 && buf.storage.data == nil):
        panic("bytes_layout_bytebuf_copy_state_invalid")
    if buf.len == 0:
        return EmptyBytes()
    var out = BytesAlloc(buf.len)
    if out.data == nil || out.len != buf.len:
        BytesFree(out)
        panic("bytes_layout_bytebuf_copy_alloc_failed")
    rawmem_support.RawmemCopy(out.data, buf.storage.data, buf.len)
    return out

@borrows
fn fixedBytes32Equal(a: FixedBytes32, b: FixedBytes32): bool =
    for i in 0..<fixedBytes32Size:
        if a.data[i] != b.data[i]:
            return false
    return true

fn fixedBytes64Equal(a: FixedBytes64, b: FixedBytes64): bool =
    for i in 0..<fixedBytes64Size:
        if a.data[i] != b.data[i]:
            return false
    return true

fn fixedBytes65Equal(a: FixedBytes65, b: FixedBytes65): bool =
    for i in 0..<fixedBytes65Size:
        if a.data[i] != b.data[i]:
            return false
    return true

@borrows
fn fixedBytes32FromBytes(data: Bytes): Result[FixedBytes32] =
    if BytesLen(data) != fixedBytes32Size || data.data == nil:
        return Err[FixedBytes32](" bytes_layout: need 32 bytes")
    var out: FixedBytes32
    for i in 0..<fixedBytes32Size:
        out.data[i] = UInt8(BytesGet(data, i))
    return Ok[FixedBytes32](out)

@borrows
fn fixedBytes64FromBytes(data: Bytes): Result[FixedBytes64] =
    if BytesLen(data) != fixedBytes64Size || data.data == nil:
        return Err[FixedBytes64](" bytes_layout: need 64 bytes")
    var out: FixedBytes64
    for i in 0..<fixedBytes64Size:
        out.data[i] = UInt8(BytesGet(data, i))
    return Ok[FixedBytes64](out)

@borrows
fn fixedBytes65FromBytes(data: Bytes): Result[FixedBytes65] =
    if BytesLen(data) != fixedBytes65Size || data.data == nil:
        return Err[FixedBytes65](" bytes_layout: need 65 bytes")
    var out: FixedBytes65
    for i in 0..<fixedBytes65Size:
        out.data[i] = UInt8(BytesGet(data, i))
    return Ok[FixedBytes65](out)

@borrows
fn fixedBytes32ToBytesInto(out: var Bytes, value: FixedBytes32) =
    var tmp = BytesAlloc(fixedBytes32Size)
    if tmp.data == nil || tmp.len != fixedBytes32Size:
        BytesFree(tmp)
        panic("bytes_layout_fixed32_alloc_failed")
    for i in 0..<fixedBytes32Size:
        BytesSet(tmp, i, Int32(value.data[i]) & 255)
    out = tmp

@borrows
fn fixedBytes32ToBytes(value: FixedBytes32): Bytes =
    var out: Bytes
    fixedBytes32ToBytesInto(out, value)
    return out

fn fixedBytes64ToBytes(value: FixedBytes64): Bytes =
    var out: Bytes
    out = BytesAlloc(fixedBytes64Size)
    if out.data == nil || out.len != fixedBytes64Size:
        BytesFree(out)
        panic("bytes_layout_fixed64_alloc_failed")
    for i in 0..<fixedBytes64Size:
        BytesSet(out, i, Int32(value.data[i]) & 255)
    return out

@borrows
fn fixedBytes65ToBytes(value: FixedBytes65): Bytes =
    var out: Bytes
    out = BytesAlloc(fixedBytes65Size)
    if out.data == nil || out.len != fixedBytes65Size:
        BytesFree(out)
        panic("bytes_layout_fixed65_alloc_failed")
    for i in 0..<fixedBytes65Size:
        BytesSet(out, i, Int32(value.data[i]) & 255)
    return out

fn fixedBytesHexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return Int32(c) - Int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + Int32(c) - Int32('a')
    if c >= 'A' && c <= 'F':
        return 10 + Int32(c) - Int32('A')
    return -1

fn fixedBytesHexValueByte(c: int32): int32 =
    if c >= Int32('0') && c <= Int32('9'):
        return c - Int32('0')
    if c >= Int32('a') && c <= Int32('f'):
        return 10 + c - Int32('a')
    if c >= Int32('A') && c <= Int32('F'):
        return 10 + c - Int32('A')
    return -1

@borrows
fn fixedBytes32FromHex(text: str): Result[FixedBytes32] =
    if len(text) != fixedBytes32Size * 2:
        return Err[FixedBytes32](" bytes_layout: invalid fixed32 hex length")
    var out: FixedBytes32
    var i: int32
    while i < fixedBytes32Size:
        let hi = fixedBytesHexValue(text[i * 2])
        let lo = fixedBytesHexValue(text[i * 2 + 1])
        if hi < 0 || lo < 0:
            return Err[FixedBytes32](" bytes_layout: invalid fixed32 hex")
        out.data[i] = UInt8((hi << 4) | lo)
        i = i + 1
    return Ok[FixedBytes32](out)

@borrows
fn fixedBytes64FromHex(text: str): Result[FixedBytes64] =
    if len(text) != fixedBytes64Size * 2:
        return Err[FixedBytes64](" bytes_layout: invalid fixed64 hex length")
    var out: FixedBytes64
    var i: int32
    while i < fixedBytes64Size:
        let hi = fixedBytesHexValue(text[i * 2])
        let lo = fixedBytesHexValue(text[i * 2 + 1])
        if hi < 0 || lo < 0:
            return Err[FixedBytes64](" bytes_layout: invalid fixed64 hex")
        out.data[i] = UInt8((hi << 4) | lo)
        i = i + 1
    return Ok[FixedBytes64](out)

@borrows
fn fixedBytes65FromHex(text: str): Result[FixedBytes65] =
    if len(text) != fixedBytes65Size * 2:
        return Err[FixedBytes65](" bytes_layout: invalid fixed65 hex length")
    var out: FixedBytes65
    var i: int32
    while i < fixedBytes65Size:
        let hi = fixedBytesHexValue(text[i * 2])
        let lo = fixedBytesHexValue(text[i * 2 + 1])
        if hi < 0 || lo < 0:
            return Err[FixedBytes65](" bytes_layout: invalid fixed65 hex")
        out.data[i] = UInt8((hi << 4) | lo)
        i = i + 1
    return Ok[FixedBytes65](out)

@borrows
fn fixedBytes32Hex(value: FixedBytes32): str =
    var data = fixedBytes32ToBytes(value)
    let text = BytesToHex(data)
    BytesFree(data)
    return text

fn fixedBytes64Hex(value: FixedBytes64): str =
    var data = fixedBytes64ToBytes(value)
    let text = BytesToHex(data)
    BytesFree(data)
    return text

@borrows
fn FixedBytes32Equal(a: FixedBytes32, b: FixedBytes32): bool =
    return fixedBytes32Equal(a, b)

@borrows
fn FixedBytes32Copy(value: FixedBytes32): FixedBytes32 =
    var out: FixedBytes32
    for i in 0..<FixedBytes32Size:
        out.data[i] = value.data[i]
    return out

@borrows
fn FixedBytes32FromBytes(data: Bytes): Result[FixedBytes32] =
    return fixedBytes32FromBytes(data)

@borrows
fn FixedBytes32FromHex(text: str): Result[FixedBytes32] =
    return fixedBytes32FromHex(text)

@borrows
fn FixedBytes32ToBytes(value: FixedBytes32): Bytes =
    return fixedBytes32ToBytes(value)

@borrows
fn FixedBytes32Hex(value: FixedBytes32): str =
    return fixedBytes32Hex(value)

@borrows
fn ByteSpanFromBytes(data: Bytes): ByteSpan =
    return byteSpanFromBytes(data)

@borrows
fn ByteSpanLen(span: ByteSpan): int32 =
    return byteSpanLen(span)

@borrows
fn ByteSpanAt(span: ByteSpan, idx: int32): int32 =
    return byteSpanAt(span, idx)

@borrows
fn ByteSpanSlice(span: ByteSpan, start: int32, count: int32): ByteSpan =
    return byteSpanSlice(span, start, count)

@borrows
fn ByteSpanToBytes(span: ByteSpan): Bytes =
    return byteSpanToBytes(span)

fn ByteBufInit(cap0: int32): ByteBuf =
    return byteBufInit(cap0)

@borrows
fn ByteBufLen(buf: ByteBuf): int32 =
    return byteBufLen(buf)

fn ByteBufCheckedGrowCapacity(currentCap: int32,
                              need: int32,
                              nextCapOut: var int32): bool =
    return byteBufCheckedGrowCapacity(currentCap, need, nextCapOut)

@borrows
fn ByteBufView(buf: var ByteBuf): ByteSpan =
    return byteBufView(buf)

fn ByteBufAppendByte(buf: var ByteBuf, value: int32) =
    byteBufAppendByte(buf, value)

@borrows
fn ByteBufAppendBytes(buf: var ByteBuf, data: Bytes) =
    byteBufAppendBytes(buf, data)

@borrows
fn ByteBufAppendFixed32(buf: var ByteBuf, value: FixedBytes32) =
    byteBufAppendFixed32(buf, value)

fn ByteBufFree(buf: var ByteBuf) =
    byteBufFree(buf)

@borrows
fn ByteBufToBytes(buf: ByteBuf): Bytes =
    return byteBufToBytes(buf)

fn fixedBytes65Hex(value: FixedBytes65): str =
    var data = fixedBytes65ToBytes(value)
    let text = BytesToHex(data)
    BytesFree(data)
    return text

fn FixedBytes32ToBytesInto(out: var Bytes, value: FixedBytes32) =
    fixedBytes32ToBytesInto(out, value)

fn FixedBytes64Equal(a: FixedBytes64, b: FixedBytes64): bool =
    return fixedBytes64Equal(a, b)

@borrows
fn FixedBytes64FromBytes(data: Bytes): Result[FixedBytes64] =
    return fixedBytes64FromBytes(data)

fn FixedBytes64FromHex(text: str): Result[FixedBytes64] =
    return fixedBytes64FromHex(text)

fn FixedBytes64ToBytes(value: FixedBytes64): Bytes =
    return fixedBytes64ToBytes(value)

fn FixedBytes64Hex(value: FixedBytes64): str =
    return fixedBytes64Hex(value)

fn FixedBytes65Equal(a: FixedBytes65, b: FixedBytes65): bool =
    return fixedBytes65Equal(a, b)

@borrows
fn FixedBytes65FromBytes(data: Bytes): Result[FixedBytes65] =
    return fixedBytes65FromBytes(data)

fn FixedBytes65FromHex(text: str): Result[FixedBytes65] =
    return fixedBytes65FromHex(text)

@borrows
fn FixedBytes65ToBytes(value: FixedBytes65): Bytes =
    return fixedBytes65ToBytes(value)

fn FixedBytes65Hex(value: FixedBytes65): str =
    return fixedBytes65Hex(value)
