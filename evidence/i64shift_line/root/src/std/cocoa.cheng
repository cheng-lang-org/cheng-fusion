@importc("cheng_app_init")
fn appInit()

@importc("cheng_app_run")
fn appRun()

@importc("cheng_app_terminate")
fn appTerminate()

@importc("cheng_window_create")
fn windowCreate(title: str, width: int32, height: int32): ptr

@importc("cheng_window_show")
fn windowShow(win: ptr)

@importc("cheng_window_close")
fn windowClose(win: ptr)

@importc("cheng_window_set_title")
fn windowSetTitle(win: ptr, title: str)

@importc("cheng_log")
fn logMsg(msg: str)

@importc("cheng_poll_event")
fn pollEvent(): int32

# --- Cocoa-specific bindings ---

type
    CocoaRect =
        x: int32
        y: int32
        width: int32
        height: int32

@importc("cheng_cocoa_window_set_title")
fn CocoaWindowSetTitle(win: ptr, title: str)

@importc("cheng_cocoa_window_frame_x")
fn __cocoa_window_frame_x(win: ptr): int32

@importc("cheng_cocoa_window_frame_y")
fn __cocoa_window_frame_y(win: ptr): int32

@importc("cheng_cocoa_window_frame_width")
fn __cocoa_window_frame_width(win: ptr): int32

@importc("cheng_cocoa_window_frame_height")
fn __cocoa_window_frame_height(win: ptr): int32

fn CocoaWindowGetFrame(win: ptr): CocoaRect =
    var r: CocoaRect
    r.x = __cocoa_window_frame_x(win)
    r.y = __cocoa_window_frame_y(win)
    r.width = __cocoa_window_frame_width(win)
    r.height = __cocoa_window_frame_height(win)
    return r

@importc("cheng_cocoa_run_loop")
fn CocoaRunLoop()
