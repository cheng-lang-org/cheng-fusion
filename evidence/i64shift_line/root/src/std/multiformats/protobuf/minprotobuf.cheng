# Minimal protobuf helpers(varint + length-delimited).

import std/result
import std/rawbytes
import std/buffer
import std/varint
import std/seqs
type
    ProtoFieldKind = enum
        Varint = 0
        Length = 2

    ProtoResult[T] = Result[T]

    ProtoHeader =
        field: int64
        wire: int64
        next: int32

    ProtoBuffer =
        data: Bytes
        offset: int32
        out: GrowByteBuffer
        writing: bool

const
    maxRepeatedBytes = 32

type
    RepeatedBytes =
        items: Bytes[]
        count: int32

fn initRepeatedBytes(): RepeatedBytes =
    var out: RepeatedBytes
    return out

fn InitRepeatedBytes(): RepeatedBytes =
    var out: RepeatedBytes
    return out

fn InitProtoBuffer(): ProtoBuffer =
    var out: ProtoBuffer
    out.data = EmptyBytes()
    out.offset = 0
    out.out = newByteBuffer()
    out.writing = true
    return out

@borrows
fn InitProtoBufferFromBytes(data: Bytes, offset: int32): ProtoBuffer =
    var out: ProtoBuffer
    let n: int32 = BytesLen(data)
    if n > 0:
        let copied: Bytes = BytesAlloc(n)
        BytesCopyInto(copied, 0, data)
        out.data = copied
    out.offset = offset
    out.out = newByteBuffer()
    out.writing = false
    return out

fn protoToBytes(pb: var ProtoBuffer): Bytes =
    if pb.writing:
        return buffer.ByteBufferTakeAllBytes(pb.out)
    let n: int32 = BytesLen(pb.data)
    if n <= 0:
        return EmptyBytes()
    let out: Bytes = BytesAlloc(n)
    BytesCopyInto(out, 0, pb.data)
    return out

fn makeHeader(field: int32, wire: ProtoFieldKind): int64 =
    return (int64(field) << 3) | int64(wire)

fn writeFieldHeader(pb: var ProtoBuffer, field: int32, wire: ProtoFieldKind) =
    appendBytes(pb.out, encodeUVarint(makeHeader(field, wire)))

fn writeVarint(pb: var ProtoBuffer, field: int32, value: int64) =
    if ! pb.writing:
        pb.writing = true
    writeFieldHeader(pb, field, Varint)
    appendBytes(pb.out, encodeUVarint(value))

@borrows
fn writeBytes(pb: var ProtoBuffer, field: int32, value: Bytes) =
    if ! pb.writing:
        pb.writing = true
    writeFieldHeader(pb, field, Length)
    appendBytes(pb.out, encodeUVarint(BytesLen(value)))
    appendBytes(pb.out, value)

@borrows
fn writeString(pb: var ProtoBuffer, field: int32, value: str) =
    if ! pb.writing:
        pb.writing = true
    writeFieldHeader(pb, field, Length)
    let src: Bytes = BytesFromString(value)
    let srcLen: int32 = BytesLen(src)
    appendBytes(pb.out, encodeUVarint(srcLen))
    appendBytes(pb.out, src)

@borrows
fn readHeader(data: Bytes, idx: int32): Result[ProtoHeader] =
    let tagRes: Result[VarintDecoded] = decodeUVarint(data, idx)
    if IsErr(tagRes):
        return Err[ProtoHeader](Error(tagRes))
    let tag: VarintDecoded = Value(tagRes)
    let wire: int64 = tag.value & 7
    let field: int64 = tag.value >> 3
    return Ok[ProtoHeader](ProtoHeader(field: field, wire: wire, next: tag.next))

fn protoGetBytesField(pb: var ProtoBuffer, field: int32, output: var Bytes): Result[bool] =
    var idx: int32 = pb.offset
    while idx < BytesLen(pb.data):
        let headerRes: Result[ProtoHeader] = readHeader(pb.data, idx)
        if IsErr(headerRes):
            return Err[bool](Error(headerRes))
        let header: ProtoHeader = Value(headerRes)
        idx = header.next
        if header.field == int64(field):
            if header.wire != int64(Length):
                return Err[bool]("protobuf: expected length field")
            let lenRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(lenRes):
                return Err[bool](Error(lenRes))
            let lenDec: VarintDecoded = Value(lenRes)
            let size: int32 = int32(lenDec.value)
            idx = lenDec.next
            if size < 0 || idx + size > BytesLen(pb.data):
                return Err[bool]("protobuf: length out of range")
            if size <= 0:
                output = EmptyBytes()
                return Ok[bool](true)
            let copied: Bytes = BytesAlloc(size)
            BytesCopyRangeInto(copied, 0, pb.data, idx, size)
            output = copied
            return Ok[bool](true)
        if header.wire == int64(Varint):
            let skipRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(skipRes):
                return Err[bool](Error(skipRes))
            idx = Value(skipRes).next
        elif header.wire == int64(Length):
            let lenRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(lenRes):
                return Err[bool](Error(lenRes))
            let size: int32 = int32(Value(lenRes).value)
            idx = Value(lenRes).next + size
            if size < 0 || idx > BytesLen(pb.data):
                return Err[bool]("protobuf: length out of range")
        else:
            return Err[bool]("protobuf: unsupported wire type")
    return Ok[bool](false)

fn protoGetInt64Field(pb: var ProtoBuffer, field: int32, output: var int64): Result[bool] =
    var idx: int32 = pb.offset
    while idx < BytesLen(pb.data):
        let headerRes: Result[ProtoHeader] = readHeader(pb.data, idx)
        if IsErr(headerRes):
            return Err[bool](Error(headerRes))
        let header: ProtoHeader = Value(headerRes)
        idx = header.next
        if header.field == int64(field):
            if header.wire != int64(Varint):
                return Err[bool]("protobuf: expected varint field")
            let valRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(valRes):
                return Err[bool](Error(valRes))
            output = Value(valRes).value
            return Ok[bool](true)
        if header.wire == int64(Varint):
            let skipRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(skipRes):
                return Err[bool](Error(skipRes))
            idx = Value(skipRes).next
        elif header.wire == int64(Length):
            let lenRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(lenRes):
                return Err[bool](Error(lenRes))
            let size: int32 = int32(Value(lenRes).value)
            idx = Value(lenRes).next + size
            if size < 0 || idx > BytesLen(pb.data):
                return Err[bool]("protobuf: length out of range")
        else:
            return Err[bool]("protobuf: unsupported wire type")
    return Ok[bool](false)

fn protoGetStringField(pb: var ProtoBuffer, field: int32, output: var str): Result[bool] =
    var raw: Bytes
    let res: Result[bool] = protoGetBytesField(pb, field, raw)
    if IsErr(res):
        return res
    if Value(res):
        output = BytesToString(raw)
    return res

fn getField(pb: var ProtoBuffer, field: int32, output: var Bytes): Result[bool] =
    var idx: int32 = pb.offset
    while idx < BytesLen(pb.data):
        let headerRes = readHeader(pb.data, idx)
        if ! headerRes.ok:
            return Err[bool](Error(headerRes))
        let header: ProtoHeader = headerRes.value
        idx = header.next
        if header.field == int64(field):
            if header.wire != int64(Length):
                return Err[bool]("protobuf: expected length field")
            let lenRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(lenRes):
                return Err[bool](Error(lenRes))
            let lenDec: VarintDecoded = Value(lenRes)
            let size: int32 = int32(lenDec.value)
            idx = lenDec.next
            if size < 0 || idx + size > BytesLen(pb.data):
                return Err[bool]("protobuf: length out of range")
            output = BytesSlice(pb.data, idx, size)
            return Ok[bool](true)
        if header.wire == int64(Varint):
            let skipRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(skipRes):
                return Err[bool](Error(skipRes))
            let skipDec: VarintDecoded = Value(skipRes)
            idx = skipDec.next
        elif header.wire == int64(Length):
            let lenRes: Result[VarintDecoded] = decodeUVarint(pb.data, idx)
            if IsErr(lenRes):
                return Err[bool](Error(lenRes))
            let lenDec: VarintDecoded = Value(lenRes)
            let size: int32 = int32(lenDec.value)
            idx = lenDec.next + size
            if size < 0 || idx > BytesLen(pb.data):
                return Err[bool]("protobuf: length out of range")
        else:
            return Err[bool]("protobuf: unsupported wire type")
    return Ok[bool](false)

