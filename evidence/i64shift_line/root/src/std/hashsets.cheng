module hashsets
import std/hashmaps

type
    HashSetStr =
        map: hashmaps.HashMapStrInt

fn hashSetStrInit(cap0: int32 = 16): HashSetStr =
    let map0: hashmaps.HashMapStrInt = hashmaps.HashMapStrIntInit(cap0)
    var out: HashSetStr
    # Move the complete map value so hashes and both cache lanes cannot drift
    # from the owned key/value/state columns.
    out.map = map0
    return out

fn hashSetStrClear(s: var HashSetStr) =
    hashmaps.HashMapStrIntClear(s.map)

fn hashSetStrAdd(s: var HashSetStr, key: str) =
    if len(key) == 0:
        return
    hashmaps.HashMapStrIntPut(s.map, key, 1)

@borrows
fn hashSetStrHas(s: HashSetStr, key: str): bool =
    return hashmaps.HashMapStrIntFindSlot(s.map, key, false) >= 0

fn HashSetStrInit(cap0: int32 = 16): HashSetStr =
    return hashSetStrInit(cap0)

fn HashSetStrClear(s: var HashSetStr) =
    hashSetStrClear(s)

fn HashSetStrAdd(s: var HashSetStr, key: str) =
    hashSetStrAdd(s, key)

@borrows
fn HashSetStrHas(s: HashSetStr, key: str): bool =
    return hashSetStrHas(s, key)
