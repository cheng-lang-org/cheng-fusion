# std/strutils (minimal, pure Cheng)
import std/seqs
import std/strings
import std/rawmem_support
import std/system

@importc("cheng_seq_set_grow")
fn strutils_cheng_seq_set_grow(seqPtr: ptr, idx: int32, elemSize: int32): ptr
@importc("cheng_seq_string_elem_bytes_compat")
fn strutils_cheng_seq_string_elem_bytes_compat(): int32
@importc("cheng_seq_string_register_compat")
fn strutils_cheng_seq_string_register_compat(seqPtr: ptr)
@importc("cheng_seq_string_buffer_register_compat")
fn strutils_cheng_seq_string_buffer_register_compat(buffer: ptr)
@importc("cheng_f64_to_i32")
fn strutils_cheng_f64_to_i32(value: float64): int32

@importc("driver_c_new_string")
fn strutils_driver_c_new_string(size: int32): ptr

@importc("driver_c_new_string_copy_n")
fn strutils_driver_c_new_string_copy_n(raw: ptr, count: int32): ptr

type
    FloatFormatMode = enum
        ffDefault, ffDecimal

fn strutilsAppendStr(seqInst: var str[], val: str) =
    seqs.Add(seqInst, val)

fn strutilsLoadStrSlot(slotPtr: ptr): str =
    return chengStrLoadCompat(slotPtr)

fn strutilsBorrowStrSlot(slotPtr: ptr): str =
    return chengStrBorrowLoadCompat(slotPtr)

fn strutilsNewStringAlloc(count: int32): str =
    var out: str
    if count <= 0:
        return out
    let raw = strutils_driver_c_new_string(count)
    if raw != nil:
        out.data = raw
        out.len = count
        out.flags = 1
    return out

fn strutilsNewStringCopy(raw: ptr, count: int32): str =
    var out: str
    if raw != nil && count > 0:
        let copied: ptr = strutils_driver_c_new_string_copy_n(raw, count)
        if copied != nil:
            out.data = copied
            out.len = count
            out.flags = 1
    return out

fn strutilsCharToStr(c: char): str =
    let out: str = strutilsNewStringAlloc(1)
    let raw: ptr = StrDataPtr(out)
    if raw != nil:
        rawmem_support.RawmemWriteChar(raw, 0, c)
    return out

fn isStripDefaultChar(ch: char): bool =
    let chCode: int32 = Int32(ch)
    if chCode == 32:
        return true
    if chCode == 9:
        return true
    if chCode == 10:
        return true
    if chCode == 13:
        return true
    return false

@borrows
fn sliceStr(s: str, start: int32, stop: int32): str =
    if StrLenFast(s) == 0:
        return strings.stringsEmpty()
    var s0: int32 = start
    var e: int32 = stop
    if s0 < 0:
        s0 = 0
    let n: int32 = StrLenFast(s)
    if e < s0 || s0 >= n:
        return strings.stringsEmpty()
    if e >= n:
        e = n - 1
    let count: int32 = e - s0 + 1
    let src: ptr = rawmem_support.RawmemPtrAdd(StrDataPtr(s), s0)
    return strutilsNewStringCopy(src, count)

@borrows
fn startsWith(s: str, prefix: str): bool =
    if prefix.len > s.len:
        return false
    for i in 0..<prefix.len:
        if s[i] != prefix[i]:
            return false
    return true

@borrows
fn contains(s: str, sub: str): bool =
    if StrLenFast(sub) == 0:
        return true
    if StrLenFast(sub) > StrLenFast(s):
        return false
    var i: int32
    let n: int32 = StrLenFast(s)
    let m: int32 = StrLenFast(sub)
    while i + m <= n:
        var matched: bool = true
        for j in range(m):
            if s[i + j] != sub[j]:
                matched = false
                break
        if matched:
            return true
        i = i + 1
    return false

@borrows
fn toLowerAscii(s: str): str =
    let n: int32 = StrLenFast(s)
    if n <= 0:
        return ""
    var out: str = strutilsNewStringAlloc(n)
    if StrLenFast(out) != n:
        return s
    for i in range(n):
        var ch = s[i]
        if ch >= 'A' && ch <= 'Z':
            let oc: int32 = Int32(ch) + 32
            ch = Char(oc)
        rawmem_support.RawmemWriteChar(StrDataPtr(out), i, ch)
    return out

@borrows
fn toUpperAscii(s: str): str =
    let n: int32 = StrLenFast(s)
    if n <= 0:
        return ""
    var out: str = strutilsNewStringAlloc(n)
    if StrLenFast(out) != n:
        return s
    for i in range(n):
        var ch = s[i]
        if ch >= 'a' && ch <= 'z':
            let oc: int32 = Int32(ch) - 32
            ch = Char(oc)
        rawmem_support.RawmemWriteChar(StrDataPtr(out), i, ch)
    return out

@borrows
fn strip(s: str): str =
    let n: int32 = StrLenFast(s)
    if n == 0:
        return strings.CloneStr(s)
    var start: int32
    while start < n && isStripDefaultChar(s[start]):
        start = start + 1
    if start >= n:
        return strings.CloneStr(s)
    var stop: int32 = n - 1
    while stop >= start && isStripDefaultChar(s[stop]):
        stop = stop - 1
    let count: int32 = stop - start + 1
    if start == 0 && count == n:
        return strings.CloneStr(s)
    let src: ptr = rawmem_support.RawmemPtrAdd(StrDataPtr(s), start)
    return strutilsNewStringCopy(src, count)

@borrows
fn split(s: str, sep: char): str[] =
    var out: str[]
    var start = 0
    let n = StrLenFast(s)
    for i in range(n):
        if s[i] == sep:
            if i > start:
                strutilsAppendStr(out, sliceStr(strings.CloneStr(s), start, i - 1))
            else:
                strutilsAppendStr(out, strings.stringsEmpty())
            start = i + 1
    if start <= n - 1:
        strutilsAppendStr(out, sliceStr(strings.CloneStr(s), start, n - 1))
    elif start == n:
        strutilsAppendStr(out, strings.stringsEmpty())
    return out

@borrows
fn splitInto(s: str, sep: char, out: var str[]) =
    var start = 0
    for i in range(StrLenFast(s)):
        if s[i] == sep:
            if i > start:
                strutilsAppendStr(out, sliceStr(strings.CloneStr(s), start, i - 1))
            else:
                strutilsAppendStr(out, strings.stringsEmpty())
            start = i + 1
    if start <= StrLenFast(s) - 1:
        strutilsAppendStr(out, sliceStr(strings.CloneStr(s), start, StrLenFast(s) - 1))
    elif start == StrLenFast(s):
        strutilsAppendStr(out, strings.stringsEmpty())

@borrows
fn splitWhitespace(s: str): str[] =
    var out: str[]
    var i: int32
    let n = StrLenFast(s)
    while i < n:
        var start = i
        while i < n:
            if !isStripDefaultChar(s[i]):
                break
            i = i + 1
        if i >= n:
            break
        start = i
        while i < n:
            if isStripDefaultChar(s[i]):
                break
            i = i + 1
        if i > start:
            strutilsAppendStr(out, sliceStr(strings.CloneStr(s), start, i - 1))
    return out

@borrows
fn join(parts: str[], sep: str): str =
    if parts.len <= 0:
        return ""
    let sepLen: int32 = StrLenFast(sep)
    var total64: int64
    for i in 0..<parts.len:
        let partLen: int32 = StrLenFast(parts[i])
        total64 = total64 + int64(partLen)
        if i > 0:
            total64 = total64 + int64(sepLen)
    if total64 <= int64(0):
        return ""
    if total64 >= int64(2147483647):
        panic("strutils.Join: length overflow")
    let total: int32 = int32(total64)
    let out: str = strutilsNewStringAlloc(total)
    let outData: ptr = StrDataPtr(out)
    if outData == nil:
        panic("strutils.Join: alloc failed")
    var offset: int32
    for i in 0..<parts.len:
        if i > 0 && sepLen > 0:
            let sepData: ptr = StrDataPtr(sep)
            if sepData == nil:
                panic("strutils.Join: invalid separator")
            rawmem_support.RawmemCopy(SystemPtrAdd(outData, offset), sepData, sepLen)
            offset = offset + sepLen
        let partLen: int32 = StrLenFast(parts[i])
        if partLen > 0:
            let partData: ptr = StrDataPtr(parts[i])
            if partData == nil:
                panic("strutils.Join: invalid part")
            rawmem_support.RawmemCopy(SystemPtrAdd(outData, offset), partData, partLen)
            offset = offset + partLen
    rawmem_support.RawmemWriteI8(outData, total, Int8(0))
    return out

@borrows
fn replace(s: str, oldSub: str, newSub: str): str =
    if StrLenFast(oldSub) == 0:
        return s
    if StrLenFast(s) == 0:
        return s
    let n: int32 = StrLenFast(s)
    let m: int32 = StrLenFast(oldSub)
    let replacementLen: int32 = StrLenFast(newSub)
    var matchCount: int64
    var scan: int32
    while scan + m <= n:
        var matched = true
        for j in range(m):
            if s[scan + j] != oldSub[j]:
                matched = false
                break
        if matched:
            matchCount = matchCount + int64(1)
            scan = scan + m
        else:
            scan = scan + 1
    if matchCount == int64(0):
        return s
    let total64 =
        int64(n) +
        matchCount * (int64(replacementLen) - int64(m))
    if total64 < int64(0) || total64 >= int64(2147483647):
        panic("strutils.Replace: length overflow")
    if total64 == int64(0):
        return ""
    let total = int32(total64)
    let out = strutilsNewStringAlloc(total)
    let outData = StrDataPtr(out)
    let replacementData = StrDataPtr(newSub)
    if outData == nil ||
       (replacementLen > 0 && replacementData == nil):
        panic("strutils.Replace: alloc or replacement data unavailable")
    var sourceIndex: int32
    var outputIndex: int32
    while sourceIndex < n:
        var matched: bool
        if sourceIndex + m <= n:
            matched = true
            for j in range(m):
                if s[sourceIndex + j] != oldSub[j]:
                    matched = false
                    break
        if matched:
            if replacementLen > 0:
                rawmem_support.RawmemCopy(
                    SystemPtrAdd(outData, outputIndex),
                    replacementData,
                    replacementLen)
                outputIndex = outputIndex + replacementLen
            sourceIndex = sourceIndex + m
        else:
            rawmem_support.RawmemWriteI8(
                outData, outputIndex, Int8(int32(s[sourceIndex]) & 255))
            outputIndex = outputIndex + 1
            sourceIndex = sourceIndex + 1
    if outputIndex != total:
        panic("strutils.Replace: output length mismatch")
    rawmem_support.RawmemWriteI8(outData, total, Int8(0))
    return out

@borrows
fn countLines(s: str): int =
    if StrLenFast(s) == 0:
        return 0
    var count = 1
    for i in range(StrLenFast(s)):
        if s[i] == '\n':
            count = count + 1
    return count

@borrows
fn parseInt(s: str): int =
    if StrLenFast(s) == 0:
        return 0
    var sign = 1
    var offset: int32
    if s[0] == '+':
        offset = 1
    elif s[0] == '-':
        sign = -1
        offset = 1
    var val = 0
    var hadDigit = false
    let n: int32 = StrLenFast(s)
    for i in range(offset, n):
        let ch = s[i]
        if ch < '0' || ch > '9':
            break
        hadDigit = true
        val = val * 10 +(Int32(ch) - Int32('0'))
    if ! hadDigit:
        return 0
    return sign * val

fn formatFloatImpl(value: float64, mode: FloatFormatMode, precision: int): str =
    let _mode0: FloatFormatMode = mode
    let _precision0: int = precision
    return IntToStr(strutils_cheng_f64_to_i32(value))

fn formatFloat(value: float64): str =
    return strings.IntToStr(strutils_cheng_f64_to_i32(value))
fn formatFloat(value: float64, mode: FloatFormatMode): str =
    let _mode0: FloatFormatMode = mode
    return strings.IntToStr(strutils_cheng_f64_to_i32(value))
fn formatFloat(value: float64, mode: FloatFormatMode, precision: int): str =
    let _mode0: FloatFormatMode = mode
    let _precision0: int = precision
    return strings.IntToStr(strutils_cheng_f64_to_i32(value))

@borrows
fn SliceStr(s: str, start: int32, stop: int32): str =
    return sliceStr(s, start, stop)

@borrows
fn StartsWith(s: str, prefix: str): bool =
    return startsWith(s, prefix)

@borrows
fn Contains(s: str, sub: str): bool =
    return contains(s, sub)

@borrows
fn ToLowerAscii(s: str): str =
    return toLowerAscii(s)

@borrows
fn ToUpperAscii(s: str): str =
    return toUpperAscii(s)

@borrows
fn Strip(s: str): str =
    return strip(s)

@borrows
fn TrimSpace(s: str): str =
    return strip(s)

@borrows
fn Split(s: str, sep: char): str[] =
    return split(s, sep)

@borrows
fn SplitInto(s: str, sep: char, out: var str[]) =
    splitInto(s, sep, out)

@borrows
fn SplitWhitespace(s: str): str[] =
    return splitWhitespace(s)

@borrows
fn Join(parts: str[], sep: str): str =
    return join(parts, sep)

@borrows
fn Replace(s: str, oldSub: str, newSub: str): str =
    return replace(s, oldSub, newSub)

@borrows
fn CountLines(s: str): int =
    return countLines(s)

@borrows
fn ParseInt(s: str): int =
    return parseInt(s)

fn FormatFloat(value: float64): str =
    return strings.IntToStr(strutils_cheng_f64_to_i32(value))

fn FormatFloat(value: float64, mode: FloatFormatMode): str =
    let _mode0: FloatFormatMode = mode
    return strings.IntToStr(strutils_cheng_f64_to_i32(value))

fn FormatFloat(value: float64, mode: FloatFormatMode, precision: int): str =
    let _mode0: FloatFormatMode = mode
    let _precision0: int = precision
    return strings.IntToStr(strutils_cheng_f64_to_i32(value))
