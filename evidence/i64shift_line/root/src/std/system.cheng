@importc("ptr_add")
fn system_ptr_add(p: ptr, off: int32): ptr
fn SystemPtrAdd(p: ptr, off: int32): ptr =
    let out = system_ptr_add(p, off)
    return out
importc fn puts(s: cstring): int32
importc fn c_puts(s: cstring): int32
const chengStrFlagOwned: int32 = 1

fn strEmpty(): str =
    var out: str
    out.data = nil
    out.len = 0
    return out
fn StrEmpty(): str =
    var out: str
    return out

@borrows
fn strDataPtr(s: str): ptr =
    if s.data == nil:
        return nil
    if s.len <= 0:
        return nil
    return s.data
@borrows
fn StrDataPtr(s: str): ptr =
    if s.data == nil:
        return nil
    if s.len <= 0:
        return nil
    return s.data

@borrows
fn strLenFast(s: str): int32 =
    if s.data == nil:
        return 0
    if s.len <= 0:
        return 0
    return s.len
@borrows
fn StrLenFast(s: str): int32 =
    if s.data == nil:
        return 0
    if s.len <= 0:
        return 0
    return s.len

fn strViewWithFlags(data: ptr, len: int32, storeId: int32, flags: int32): str =
    var out: str
    if data != nil:
        if len > 0:
            out.data = data
            out.len = len
            out.store_id = storeId
            out.flags = flags
    return out

fn strViewUnsafe(data: ptr, len: int32): str =
    var out: str
    if data != nil && len > 0:
        out.data = data
        out.len = len
        out.store_id = 0
        out.flags = 0
    return out

@borrows
@borrow_result
fn strSubView(s: str, start: int32, count: int32): str =
    let n: int32 = strLenFast(s)
    var start0: int32 = start
    if start0 < 0:
        start0 = 0
    var kept: int32 = count
    if start0 + kept > n:
        kept = n - start0
    if start0 >= n:
        kept = 0
    if kept < 0:
        kept = 0
    var out: str
    out.data = s.data
    out.len = 0
    out.store_id = s.store_id
    out.flags = 0
    if kept > 0:
        out.data = system_ptr_add(s.data, start0)
        out.len = kept
    return out

@borrows
@borrow_result
fn StrSubView(s: str, start: int32, count: int32): str =
    var n: int32
    if s.data != nil && s.len > 0:
        n = s.len
    var start0: int32 = start
    if start0 < 0:
        start0 = 0
    var kept: int32 = count
    if start0 + kept > n:
        kept = n - start0
    if start0 >= n:
        kept = 0
    if kept < 0:
        kept = 0
    var out: str
    out.data = s.data
    out.len = 0
    out.store_id = s.store_id
    out.flags = 0
    if kept > 0:
        out.data = system_ptr_add(s.data, start0)
        out.len = kept
    return out

fn echo(msg: cstring) =
    puts(msg)
importc fn exit(code: int32)
importc fn cheng_dump_backtrace_if_enabled()
importc fn driver_c_new_string(size: int32): cstring
@importc("driver_c_new_string_copy_n")
fn driver_c_new_string_copy_n_cstr(raw: cstring, count: int32): cstring

# Managed cstring -> str copy. The physical intrinsic reads exactly `count`
# bytes from the cstring data pointer and returns an owned char buffer; the
# Cheng-visible contract carries only the managed cstring boundary and a
# value-typed str result.
fn NewStringCopyManaged(raw: cstring, count: int32): str =
    var out: str
    if raw == nil || count <= 0:
        return out
    let copied: cstring = driver_c_new_string_copy_n_cstr(raw, count)
    if copied == nil:
        return out
    out.data = copied
    out.len = count
    out.flags = chengStrFlagOwned
    return out
@borrows
fn panicCString(msg: str): cstring =
    if strLenFast(msg) == 0:
        return driver_c_new_string(0)
    let dataPtr0: ptr = strDataPtr(msg)
    if dataPtr0 == nil:
        return driver_c_new_string(0)
    if msg.flags == chengStrFlagOwned:
        return cstring(dataPtr0)
    return driver_c_new_string_copy_n_cstr(cstring(dataPtr0), strLenFast(msg))
# Panic must not depend on libc puts: in the cold Linux ELF closure puts
# resolves to a no-op and the message is silently lost (exit 1 with zero
# output). cheng_panic_cstring_and_exit is the dedicated provider ABI that
# writes the message to stderr on every platform and then exits(1).
@importc("cheng_panic_cstring_and_exit")
fn chengPanicCstringAndExitBridge(text: cstring)
@exported("panic")
fn panicPtrBridge(msg: ptr) =
    chengPanicCstringAndExitBridge(cstring(msg))
@borrows
fn panic(msg: str) =
    let raw: cstring = panicCString(msg)
    chengPanicCstringAndExitBridge(raw)
@borrows
fn panicStr(msg: str) =
    panic(msg)
fn panicErr(err: result.ErrorInfo) =
    let msgText: str = ErrorMessage(err)
    if strLenFast(msgText) == 0:
        let rawEmpty: cstring = panicCString("error")
        puts(rawEmpty)
        exit(1)
    let raw: cstring = panicCString(msgText)
    puts(raw)
    exit(1)
@borrows
fn Panic(msg: str) =
    panic(msg)
fn PanicPtrBridge(msg: ptr) =
    panicPtrBridge(msg)
fn PanicErrorInfo(err: result.ErrorInfo) =
    panicErr(err)

fn assertPtrBridgeRuntime(cond: bool, msg: ptr) =
    if ! cond:
        puts(cstring(msg))
        exit(1)

@exported("assert")
fn assertPtrBridge(cond: bool, msg: ptr) =
    assertPtrBridgeRuntime(cond, msg)

@borrows
fn assert(cond: bool, msg: str) =
    if ! cond:
        let raw: cstring = panicCString(msg)
        puts(raw)
        exit(1)
@exported("Assert")
fn AssertPtrBridge(cond: bool, msg: ptr) =
    assertPtrBridgeRuntime(cond, msg)
@borrows
fn Assert(cond: bool, msg: str) =
    if ! cond:
        let raw: cstring = panicCString(msg)
        puts(raw)
        exit(1)
fn panicSeqIndexOutOfBounds() =
    let raw: cstring = panicCString("seq index out of bounds")
    puts(raw)
    exit(1)
fn panicNilSeqPointer() =
    let raw: cstring = panicCString("cheng: nil seq pointer")
    puts(raw)
    exit(1)
