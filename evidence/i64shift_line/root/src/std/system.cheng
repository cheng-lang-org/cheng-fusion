fn `[]`(seqInst: T[], i: int32): T =
    let seqLen: int32 = seqInst.len
    if i < 0 || i >= seqLen:
        panicSeqIndexOutOfBounds()
    let elemBytes: int32 = int32(sizeof(T))
    let slot: ptr = cheng_seq_get(seqInst.buffer, seqLen, i, elemBytes)
    var out: T
    memCopyCompat(&out, slot, elemBytes)
    return out
fn `[]=`(seqInst: var T[], i: int32, val: T) =
    let seqLen: int32 = seqInst.len
    if i < 0 || i >= seqLen:
        panicSeqIndexOutOfBounds()
    let slot: ptr = cheng_seq_set(seqInst.buffer, seqLen, i, int32(sizeof(T)))
    memCopyCompat(slot, &val, int32(sizeof(T)))

fn chengStrLoadCompat(slot: ptr): str =
    var out: str
    if slot != nil:
        let ptrBytes: int32 = ptrSize()
        let i32Bytes: int32 = int32(sizeof(int32))
        out.data = ptrLoadCompat(slot)
        out.len = int32LoadCompat(system_ptr_add(slot, ptrBytes))
        out.store_id = int32LoadCompat(system_ptr_add(slot, ptrBytes + i32Bytes))
        out.flags = int32LoadCompat(system_ptr_add(slot, ptrBytes + i32Bytes + i32Bytes))
        if out.data != nil && out.flags == chengStrFlagOwned:
            memRetain(out.data)
    return out

fn chengStrBorrowLoadCompat(slot: ptr): str =
    var out: str
    if slot != nil:
        let ptrBytes: int32 = ptrSize()
        let i32Bytes: int32 = int32(sizeof(int32))
        out.data = ptrLoadCompat(slot)
        out.len = int32LoadCompat(system_ptr_add(slot, ptrBytes))
        out.store_id = int32LoadCompat(system_ptr_add(slot, ptrBytes + i32Bytes))
        out.flags = 0
    return out

fn chengStrStoreCompat(slot: ptr, val: str) =
    if slot == nil:
        return
    let ptrBytes: int32 = ptrSize()
    let i32Bytes: int32 = int32(sizeof(int32))
    let prevData: ptr = ptrLoadCompat(slot)
    let prevFlags: int32 = int32LoadCompat(system_ptr_add(slot, ptrBytes + i32Bytes + i32Bytes))
    var nextData: ptr
    var nextLen: int32
    var nextStoreId: int32
    var nextFlags: int32
    if val.data != nil && val.len > 0:
        if val.flags == chengStrFlagOwned:
            memRetain(val.data)
            nextData = val.data
            nextLen = val.len
            nextStoreId = val.store_id
            nextFlags = val.flags
        else:
            let copied: str = newStringCopy(val.data, val.len)
            if copied.data != nil && copied.flags == chengStrFlagOwned:
                memRetain(copied.data)
            nextData = copied.data
            nextLen = copied.len
            nextStoreId = copied.store_id
            nextFlags = copied.flags
    ptrStoreCompat(slot, nextData)
    int32StoreCompat(system_ptr_add(slot, ptrBytes), nextLen)
    int32StoreCompat(system_ptr_add(slot, ptrBytes + i32Bytes), nextStoreId)
    int32StoreCompat(system_ptr_add(slot, ptrBytes + i32Bytes + i32Bytes), nextFlags)
    if prevData != nil && prevFlags == chengStrFlagOwned:
        memRelease(prevData)

fn `[]`(seqInst: str[], i: int32): str =
    let seqLen: int32 = seqInst.len
    if i < 0 || i >= seqLen:
        panicSeqIndexOutOfBounds()
    return chengStrLoadCompat(cheng_seq_get(seqInst.buffer, seqLen, i, cheng_seq_string_elem_bytes_compat_system()))

fn `[]=`(seqInst: var str[], i: int32, val: str) =
    let seqLen: int32 = seqInst.len
    if i < 0 || i >= seqLen:
        panicSeqIndexOutOfBounds()
    chengStrStoreCompat(cheng_seq_set(seqInst.buffer, seqLen, i, cheng_seq_string_elem_bytes_compat_system()), val)

@importc("store_ptr")
