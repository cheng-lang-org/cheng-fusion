@borrows
fn RuntimeHeldExecTerminalObservationBindDurablePrefixInto(
        transportOwner: int32,
        session: int32,
        phase: int32,
        permission0: var int32,
        permission1: var int32,
        permission2: var int32,
        permission3: var int32,
        sessionCid: str,
        predecessorReceiptCid: str,
        evidenceBReceiptCid: str,
        outBindOwner: var int32,
        outCommitPermission0: var int32,
        outCommitPermission1: var int32,
        outCommitPermission2: var int32,
        outCommitPermission3: var int32): bool =
    outBindOwner = -1
    outCommitPermission0 = 0
    outCommitPermission1 = 0
    outCommitPermission2 = 0
    outCommitPermission3 = 0
    if transportOwner <= 0 || session <= 0 ||
       (phase != 1 && phase != 2) ||
       (permission0 == 0 && permission1 == 0 &&
        permission2 == 0 && permission3 == 0):
        return false
    let ownedPermission0 = permission0
    let ownedPermission1 = permission1
    let ownedPermission2 = permission2
    let ownedPermission3 = permission3
    permission0 = 0
    permission1 = 0
    permission2 = 0
    permission3 = 0
    let bindOwner =
        runtimeHeldExecTerminalObservationBindDurablePrefixBridge(
            transportOwner,
            session,
            phase,
            ownedPermission0,
            ownedPermission1,
            ownedPermission2,
            ownedPermission3,
            sessionCid,
            predecessorReceiptCid,
            evidenceBReceiptCid,
            outCommitPermission0,
            outCommitPermission1,
            outCommitPermission2,
            outCommitPermission3)
    if bindOwner <= 0:
        permission0 = ownedPermission0
        permission1 = ownedPermission1
        permission2 = ownedPermission2
        permission3 = ownedPermission3
        outCommitPermission0 = 0
        outCommitPermission1 = 0
        outCommitPermission2 = 0
        outCommitPermission3 = 0
        return false
    outBindOwner = bindOwner
    return true

@borrows
fn RuntimeHeldExecTerminalObservationCommitDurableAppendInto(
        bindOwner: var int32,
        session: int32,
        permission0: var int32,
        permission1: var int32,
        permission2: var int32,
        permission3: var int32,
        observationOwner: int32,
        projectedCanonicalCid: str,
        durableRecordCanonical: str,
        durableRecordReceiptCid: str,
        outDurableAppendOwner: var int32): bool =
    outDurableAppendOwner = -1
    if bindOwner <= 0 || session <= 0 || observationOwner <= 0 ||
       (permission0 == 0 && permission1 == 0 &&
        permission2 == 0 && permission3 == 0):
        return false
    let ownedBindOwner = bindOwner
    let ownedPermission0 = permission0
    let ownedPermission1 = permission1
    let ownedPermission2 = permission2
    let ownedPermission3 = permission3
    bindOwner = -1
    permission0 = 0
    permission1 = 0
    permission2 = 0
    permission3 = 0
    let durableAppendOwner =
        runtimeHeldExecTerminalObservationCommitDurableAppendBridge(
            ownedBindOwner,
            session,
            ownedPermission0,
            ownedPermission1,
            ownedPermission2,
            ownedPermission3,
            observationOwner,
            projectedCanonicalCid,
            durableRecordCanonical,
            durableRecordReceiptCid)
    if durableAppendOwner <= 0:
        bindOwner = ownedBindOwner
        permission0 = ownedPermission0
        permission1 = ownedPermission1
        permission2 = ownedPermission2
        permission3 = ownedPermission3
        return false
    outDurableAppendOwner = durableAppendOwner
    return true

fn RuntimeHeldExecTerminalObservationAckInto(
        session: int32,
        observationOwner: var int32,
        durableAppendOwner: var int32,
        outRetireOwner: var int32): bool =
    outRetireOwner = -1
    if session <= 0 || observationOwner <= 0 || durableAppendOwner <= 0:
        return false
    let ownedObservationOwner = observationOwner
    let ownedDurableAppendOwner = durableAppendOwner
    observationOwner = -1
    durableAppendOwner = -1
    let acked = runtimeHeldExecTerminalObservationAckBridge(
        session,
        ownedObservationOwner,
        ownedDurableAppendOwner,
        outRetireOwner) == 1
    if !acked:
        outRetireOwner = -1
        return false
    return true

fn RuntimeHeldExecTerminalRetireInto(
        retireOwner: var int32,
        outCloseReadyOwner: var int32): bool =
    outCloseReadyOwner = -1
    if retireOwner <= 0:
        return false
    let ownedRetireOwner = retireOwner
    retireOwner = -1
    if runtimeHeldExecTerminalRetireIntoBridge(
           ownedRetireOwner, outCloseReadyOwner) != 1 ||
       outCloseReadyOwner != ownedRetireOwner:
        outCloseReadyOwner = -1
        return false
    return true

fn RuntimeHeldExecTerminalCloseReadyConsume(
        closeReadyOwner: var int32): bool =
    if closeReadyOwner <= 0:
        return false
    let ownedCloseReadyOwner = closeReadyOwner
    closeReadyOwner = -1
    if runtimeHeldExecTerminalCloseReadyConsumeBridge(
           ownedCloseReadyOwner) != 1:
        return false
    return true

