@importc("cheng_atomic_cas_i32")
fn atomicCasI32(value: var int32, expect: int32, desired: int32): int32
@importc("cheng_atomic_store_i32")
fn atomicStoreI32(value: var int32, val: int32)
@importc("cheng_atomic_load_i32")
fn atomicLoadI32(value: var int32): int32
@importc("cheng_atomic_cas_i32")
fn atomicCasI32AtPtr(p: ptr, expect: int32, desired: int32): int32
@importc("cheng_atomic_store_i32")
fn atomicStoreI32AtPtr(p: ptr, val: int32)
@importc("cheng_atomic_load_i32")
fn atomicLoadI32AtPtr(p: ptr): int32

# Typed runtime atomics. Callers retain a `var int32` value-def; the physical
# address exists only for the duration of this runtime ABI call and never
# becomes an identity or a public Cheng value.
fn RuntimeAtomicCompareExchangeI32(
        value: var int32,
        expected: int32,
        desired: int32): bool =
    return atomicCasI32(value, expected, desired) != 0

fn RuntimeAtomicStoreI32(value: var int32, desired: int32) =
    atomicStoreI32(value, desired)

fn RuntimeAtomicLoadI32(value: var int32): int32 =
    return atomicLoadI32(value)

fn runtimeHeldOutputAtomicRowRequire(index: int32) =
    if index < 0 || index >= 128:
        panic("runtime held output atomic row out of bounds")

# The held-output capability arena is static DOD/SoA runtime storage. Public
# Cheng callers carry only an int32 row; the physical element address exists
# solely for the duration of these typed atomic ABI calls.
var runtimeHeldOutputAtomicStates: int32[128]
var runtimeHeldOutputAtomicLocks: int32[128]
var runtimeHeldOutputAtomicGenerations: int32[128]
var runtimeHeldOutputAtomicOwners: int32[128]
var runtimeHeldOutputStaticLanes: int32[4608]

type
    RuntimeHeldOutputStaticIdentity =
        fd: int32
        platformCode: int32
        size: int64
        mode: int32
        device: uint64
        inode: uint64
        ownerUid: uint64
        ownerGid: uint64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        changeVersion: uint64
        linkCount: uint64

fn RuntimeHeldOutputAtomicStateLoad(row: int32): int32 =
    runtimeHeldOutputAtomicRowRequire(row)
    return atomicLoadI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputAtomicStates), row * 4))

fn RuntimeHeldOutputAtomicStateStore(row: int32, state: int32) =
    runtimeHeldOutputAtomicRowRequire(row)
    atomicStoreI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputAtomicStates), row * 4), state)

fn RuntimeHeldOutputAtomicStateCas(
        row: int32,
        expected: int32,
        desired: int32): bool =
    runtimeHeldOutputAtomicRowRequire(row)
    return atomicCasI32AtPtr(
        SystemPtrAdd(ptr(&runtimeHeldOutputAtomicStates), row * 4), expected, desired) != 0

fn RuntimeHeldOutputAtomicLockAcquire(row: int32): bool =
    runtimeHeldOutputAtomicRowRequire(row)
    return atomicCasI32AtPtr(
        SystemPtrAdd(ptr(&runtimeHeldOutputAtomicLocks), row * 4), 0, 1) != 0

fn RuntimeHeldOutputAtomicLockRelease(row: int32) =
    runtimeHeldOutputAtomicRowRequire(row)
    atomicStoreI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputAtomicLocks), row * 4), 0)

fn RuntimeHeldOutputAtomicGenerationLoad(row: int32): int32 =
    runtimeHeldOutputAtomicRowRequire(row)
    return atomicLoadI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputAtomicGenerations), row * 4))

fn RuntimeHeldOutputAtomicGenerationStore(row: int32, value: int32) =
    runtimeHeldOutputAtomicRowRequire(row)
    atomicStoreI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputAtomicGenerations), row * 4), value)

fn RuntimeHeldOutputAtomicOwnerLoad(row: int32): int32 =
    runtimeHeldOutputAtomicRowRequire(row)
    return atomicLoadI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputAtomicOwners), row * 4))

fn RuntimeHeldOutputAtomicOwnerStore(row: int32, value: int32) =
    runtimeHeldOutputAtomicRowRequire(row)
    atomicStoreI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputAtomicOwners), row * 4), value)

fn runtimeHeldOutputStaticLaneOffset(
        column: int32,
        row: int32): int32 =
    runtimeHeldOutputAtomicRowRequire(row)
    if column < 0 || column >= 36:
        panic("runtime held output static column out of bounds")
    return column * 128 + row

fn runtimeHeldOutputStaticLaneLoad(
        column: int32,
        row: int32): int32 =
    let offset = runtimeHeldOutputStaticLaneOffset(column, row)
    return atomicLoadI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputStaticLanes), offset * 4))

fn runtimeHeldOutputStaticLaneStore(
        column: int32,
        row: int32,
        value: int32) =
    let offset = runtimeHeldOutputStaticLaneOffset(column, row)
    atomicStoreI32AtPtr(SystemPtrAdd(ptr(&runtimeHeldOutputStaticLanes), offset * 4), value)

fn runtimeHeldOutputStaticU64Load(
        lowColumn: int32,
        row: int32): uint64 =
    let low = uint64(uint32(
        runtimeHeldOutputStaticLaneLoad(lowColumn, row)))
    let high = uint64(uint32(
        runtimeHeldOutputStaticLaneLoad(lowColumn + 1, row)))
    return low | (high << 32)

fn runtimeHeldOutputStaticU64Store(
        lowColumn: int32,
        row: int32,
        value: uint64) =
    runtimeHeldOutputStaticLaneStore(
        lowColumn, row, int32(uint32(value)))
    runtimeHeldOutputStaticLaneStore(
        lowColumn + 1, row, int32(uint32(value >> 32)))

@borrows
fn RuntimeHeldOutputStaticIdentityStore(
        row: int32,
        identity: RuntimeHeldOutputStaticIdentity) =
    runtimeHeldOutputAtomicRowRequire(row)
    runtimeHeldOutputStaticLaneStore(0, row, identity.fd)
    runtimeHeldOutputStaticLaneStore(1, row, identity.platformCode)
    runtimeHeldOutputStaticLaneStore(2, row, identity.mode)
    runtimeHeldOutputStaticU64Store(3, row, uint64(identity.size))
    runtimeHeldOutputStaticU64Store(5, row, identity.device)
    runtimeHeldOutputStaticU64Store(7, row, identity.inode)
    runtimeHeldOutputStaticU64Store(9, row, identity.ownerUid)
    runtimeHeldOutputStaticU64Store(11, row, identity.ownerGid)
    runtimeHeldOutputStaticU64Store(13, row, uint64(identity.mtimeSec))
    runtimeHeldOutputStaticU64Store(15, row, uint64(identity.mtimeNsec))
    runtimeHeldOutputStaticU64Store(17, row, uint64(identity.ctimeSec))
    runtimeHeldOutputStaticU64Store(19, row, uint64(identity.ctimeNsec))
    runtimeHeldOutputStaticU64Store(21, row, identity.changeVersion)
    runtimeHeldOutputStaticU64Store(23, row, identity.linkCount)

fn RuntimeHeldOutputStaticIdentityLoad(
        row: int32): RuntimeHeldOutputStaticIdentity =
    runtimeHeldOutputAtomicRowRequire(row)
    var out: RuntimeHeldOutputStaticIdentity
    out.fd = runtimeHeldOutputStaticLaneLoad(0, row)
    out.platformCode = runtimeHeldOutputStaticLaneLoad(1, row)
    out.mode = runtimeHeldOutputStaticLaneLoad(2, row)
    out.size = Int64(runtimeHeldOutputStaticU64Load(3, row))
    out.device = runtimeHeldOutputStaticU64Load(5, row)
    out.inode = runtimeHeldOutputStaticU64Load(7, row)
    out.ownerUid = runtimeHeldOutputStaticU64Load(9, row)
    out.ownerGid = runtimeHeldOutputStaticU64Load(11, row)
    out.mtimeSec = Int64(runtimeHeldOutputStaticU64Load(13, row))
    out.mtimeNsec = Int64(runtimeHeldOutputStaticU64Load(15, row))
    out.ctimeSec = Int64(runtimeHeldOutputStaticU64Load(17, row))
    out.ctimeNsec = Int64(runtimeHeldOutputStaticU64Load(19, row))
    out.changeVersion = runtimeHeldOutputStaticU64Load(21, row)
    out.linkCount = runtimeHeldOutputStaticU64Load(23, row)
    return out

fn RuntimeHeldOutputPublishedSizeStore(row: int32, size: int64) =
    runtimeHeldOutputAtomicRowRequire(row)
    runtimeHeldOutputStaticU64Store(25, row, uint64(size))

fn RuntimeHeldOutputPublishedSizeLoad(row: int32): int64 =
    runtimeHeldOutputAtomicRowRequire(row)
    return Int64(runtimeHeldOutputStaticU64Load(25, row))

fn runtimeHeldOutputDigestWordRequire(
        row: int32,
        wordIndex: int32) =
    runtimeHeldOutputAtomicRowRequire(row)
    if wordIndex < 0 || wordIndex >= 8:
        panic("runtime held output digest word out of bounds")

fn RuntimeHeldOutputPublishedDigestWordStore(
        row: int32,
        wordIndex: int32,
        value: uint32) =
    runtimeHeldOutputDigestWordRequire(row, wordIndex)
    runtimeHeldOutputStaticLaneStore(
        27 + wordIndex, row, int32(value))

fn RuntimeHeldOutputPublishedDigestWordLoad(
        row: int32,
        wordIndex: int32): uint32 =
    runtimeHeldOutputDigestWordRequire(row, wordIndex)
    return uint32(runtimeHeldOutputStaticLaneLoad(
        27 + wordIndex, row))
