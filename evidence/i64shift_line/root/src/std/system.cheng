fn __cheng_concat_str(a: str, b: str): str =
    let nLeft: int32 = strLenFast(a)
    let nRight: int32 = strLenFast(b)
    let out: str = newStringAlloc(nLeft + nRight)
    if nLeft > 0:
        memCopyCompat(strDataPtr(out), strDataPtr(a), nLeft)
    if nRight > 0:
        memCopyCompat(system_ptr_add(strDataPtr(out), nLeft), strDataPtr(b), nRight)
    if strDataPtr(out) != nil:
        rawmemWriteI8Compat(strDataPtr(out), nLeft + nRight, int8(0))
    return out
fn __cheng_set_range_mask(start: int32, stop: int32, exclusive: bool): uint64 =
    var s: int32
    s = start
    var e: int32
    e = stop
    if exclusive:
        e = e - 1
    if s < 0:
        s = 0
    if e < s:
        return uint64(0)
    if e > 63:
        e = 63
    var mask: uint64
    mask = uint64(0)
    var i: int32
    i = s
    for i in i..e:
        mask = mask |(uint64(1) << uint64(i))
    return mask
fn setHas(s: set[T], value: T): bool =
    let idx64 = int64(value)
    let idx = uint64(idx64)
    let mask = uint64(1) << idx
    let bits = uint64(s)
    var out: bool
    out = (bits & mask) != 0
    return out
fn newString(len: int32): str =
    var out: str
    if len > 0:
        out = strOwnedAlloc(len)
    return out

fn strOwnedAlloc(len: int32): str =
    var out: str
    if len > 0:
        let raw: ptr = HeapNewCompat(len + 1)
        if raw != nil:
            memSetCompat(raw, 0, len + 1)
            out.data = raw
            out.len = len
            out.store_id = 0
            out.flags = chengStrFlagOwned
    return out

fn strFromBytesCopy(src: ptr, len: int32): str =
    # Direct-return shape: the conditional `var out` + `return out` pattern made
    # the result ownership summary collapse to borrow, which poisoned every
    # caller's owned managed return (fresh-compiler exact-return check).
    if src == nil || len <= 0:
        return ""
    var out = strOwnedAlloc(len)
    if out.data == nil:
        return ""
    memCopyCompat(out.data, src, len)
    return out
fn StrFromBytesCopy(src: ptr, len: int32): str =
    return strFromBytesCopy(src, len)

fn strFromCStringBorrow(raw: cstring): str =
    var out: str
    if raw != nil:
        let n: int32 = c_strlen(raw)
        out = strViewUnsafe(ptr(raw), n)
    return out
fn StrFromCStringBorrow(raw: cstring): str =
    var out: str
    if raw != nil:
        let n: int32 = c_strlen(raw)
        if n > 0:
            out.data = ptr(raw)
            out.len = n
    return out

fn strFromCStringCopy(raw: cstring): str =
    # See strFromBytesCopy: direct returns keep the owned-result proof intact.
    if raw == nil:
        return ""
    let n: int32 = c_strlen(raw)
    let out: str = strFromBytesCopy(ptr(raw), n)
    return out

@borrows
fn cheng_str_param_to_cstring_compat(s: str): cstring =
    let n: int32 = strLenFast(s)
    if n <= 0:
        return driver_c_new_string(0)
    return driver_c_new_string_copy_n_cstr(cstring(s.data), n)

@borrows
fn strToCStringTemp(s: str): cstring =
    return cheng_str_param_to_cstring_compat(s)

@borrows
fn StrToCStringTemp(s: str): cstring =
