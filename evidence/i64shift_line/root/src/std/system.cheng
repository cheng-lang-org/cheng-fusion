type
    RuntimeMemoryCounters =
        allocTotal: int64
        freeTotal: int64
        liveTotal: int64

# The runtime allocator owns all three counters.  This snapshot is only valid
# at a quiescent boundary: a concurrent allocation between the three locked
# reads is a contract violation and must fail instead of yielding a fabricated
# relation.
fn RuntimeMemoryCountersSnapshotQuiescent(): RuntimeMemoryCounters =
    var out: RuntimeMemoryCounters
    out.allocTotal = memAllocCount()
    out.freeTotal = memFreeCount()
    out.liveTotal = memLiveCount()
    if out.allocTotal < out.freeTotal ||
       out.allocTotal - out.freeTotal != out.liveTotal:
        panic("system: runtime memory counters changed during quiescent snapshot")
    return out

fn MemLiveAllocations(): int64 =
    return memLiveCount()

fn RuntimeAllocationLedgerSupported(): bool =
    return runtimeAllocationLedgerCapabilityBridge() == 1

fn runtimeAllocationLedgerHashU32FromBytes(
        b0: int32,
        b1: int32,
        b2: int32,
        b3: int32): uint64 =
    return (uint64(b0) << uint64(24)) |
           (uint64(b1) << uint64(16)) |
           (uint64(b2) << uint64(8)) |
           uint64(b3)

fn runtimeAllocationLedgerHashK(index: int32): uint64 =
    if index == 0: return runtimeAllocationLedgerHashU32FromBytes(0x42, 0x8a, 0x2f, 0x98)
    if index == 1: return runtimeAllocationLedgerHashU32FromBytes(0x71, 0x37, 0x44, 0x91)
    if index == 2: return runtimeAllocationLedgerHashU32FromBytes(0xb5, 0xc0, 0xfb, 0xcf)
    if index == 3: return runtimeAllocationLedgerHashU32FromBytes(0xe9, 0xb5, 0xdb, 0xa5)
    if index == 4: return runtimeAllocationLedgerHashU32FromBytes(0x39, 0x56, 0xc2, 0x5b)
    if index == 5: return runtimeAllocationLedgerHashU32FromBytes(0x59, 0xf1, 0x11, 0xf1)
    if index == 6: return runtimeAllocationLedgerHashU32FromBytes(0x92, 0x3f, 0x82, 0xa4)
    if index == 7: return runtimeAllocationLedgerHashU32FromBytes(0xab, 0x1c, 0x5e, 0xd5)
    if index == 8: return runtimeAllocationLedgerHashU32FromBytes(0xd8, 0x07, 0xaa, 0x98)
    if index == 9: return runtimeAllocationLedgerHashU32FromBytes(0x12, 0x83, 0x5b, 0x01)
    if index == 10: return runtimeAllocationLedgerHashU32FromBytes(0x24, 0x31, 0x85, 0xbe)
    if index == 11: return runtimeAllocationLedgerHashU32FromBytes(0x55, 0x0c, 0x7d, 0xc3)
    if index == 12: return runtimeAllocationLedgerHashU32FromBytes(0x72, 0xbe, 0x5d, 0x74)
    if index == 13: return runtimeAllocationLedgerHashU32FromBytes(0x80, 0xde, 0xb1, 0xfe)
    if index == 14: return runtimeAllocationLedgerHashU32FromBytes(0x9b, 0xdc, 0x06, 0xa7)
    if index == 15: return runtimeAllocationLedgerHashU32FromBytes(0xc1, 0x9b, 0xf1, 0x74)
    if index == 16: return runtimeAllocationLedgerHashU32FromBytes(0xe4, 0x9b, 0x69, 0xc1)
    if index == 17: return runtimeAllocationLedgerHashU32FromBytes(0xef, 0xbe, 0x47, 0x86)
    if index == 18: return runtimeAllocationLedgerHashU32FromBytes(0x0f, 0xc1, 0x9d, 0xc6)
    if index == 19: return runtimeAllocationLedgerHashU32FromBytes(0x24, 0x0c, 0xa1, 0xcc)
    if index == 20: return runtimeAllocationLedgerHashU32FromBytes(0x2d, 0xe9, 0x2c, 0x6f)
    if index == 21: return runtimeAllocationLedgerHashU32FromBytes(0x4a, 0x74, 0x84, 0xaa)
    if index == 22: return runtimeAllocationLedgerHashU32FromBytes(0x5c, 0xb0, 0xa9, 0xdc)
    if index == 23: return runtimeAllocationLedgerHashU32FromBytes(0x76, 0xf9, 0x88, 0xda)
    if index == 24: return runtimeAllocationLedgerHashU32FromBytes(0x98, 0x3e, 0x51, 0x52)
    if index == 25: return runtimeAllocationLedgerHashU32FromBytes(0xa8, 0x31, 0xc6, 0x6d)
    if index == 26: return runtimeAllocationLedgerHashU32FromBytes(0xb0, 0x03, 0x27, 0xc8)
    if index == 27: return runtimeAllocationLedgerHashU32FromBytes(0xbf, 0x59, 0x7f, 0xc7)
    if index == 28: return runtimeAllocationLedgerHashU32FromBytes(0xc6, 0xe0, 0x0b, 0xf3)
    if index == 29: return runtimeAllocationLedgerHashU32FromBytes(0xd5, 0xa7, 0x91, 0x47)
    if index == 30: return runtimeAllocationLedgerHashU32FromBytes(0x06, 0xca, 0x63, 0x51)
    if index == 31: return runtimeAllocationLedgerHashU32FromBytes(0x14, 0x29, 0x29, 0x67)
    if index == 32: return runtimeAllocationLedgerHashU32FromBytes(0x27, 0xb7, 0x0a, 0x85)
    if index == 33: return runtimeAllocationLedgerHashU32FromBytes(0x2e, 0x1b, 0x21, 0x38)
    if index == 34: return runtimeAllocationLedgerHashU32FromBytes(0x4d, 0x2c, 0x6d, 0xfc)
    if index == 35: return runtimeAllocationLedgerHashU32FromBytes(0x53, 0x38, 0x0d, 0x13)
    if index == 36: return runtimeAllocationLedgerHashU32FromBytes(0x65, 0x0a, 0x73, 0x54)
    if index == 37: return runtimeAllocationLedgerHashU32FromBytes(0x76, 0x6a, 0x0a, 0xbb)
    if index == 38: return runtimeAllocationLedgerHashU32FromBytes(0x81, 0xc2, 0xc9, 0x2e)
    if index == 39: return runtimeAllocationLedgerHashU32FromBytes(0x92, 0x72, 0x2c, 0x85)
    if index == 40: return runtimeAllocationLedgerHashU32FromBytes(0xa2, 0xbf, 0xe8, 0xa1)
    if index == 41: return runtimeAllocationLedgerHashU32FromBytes(0xa8, 0x1a, 0x66, 0x4b)
    if index == 42: return runtimeAllocationLedgerHashU32FromBytes(0xc2, 0x4b, 0x8b, 0x70)
    if index == 43: return runtimeAllocationLedgerHashU32FromBytes(0xc7, 0x6c, 0x51, 0xa3)
    if index == 44: return runtimeAllocationLedgerHashU32FromBytes(0xd1, 0x92, 0xe8, 0x19)
    if index == 45: return runtimeAllocationLedgerHashU32FromBytes(0xd6, 0x99, 0x06, 0x24)
    if index == 46: return runtimeAllocationLedgerHashU32FromBytes(0xf4, 0x0e, 0x35, 0x85)
    if index == 47: return runtimeAllocationLedgerHashU32FromBytes(0x10, 0x6a, 0xa0, 0x70)
    if index == 48: return runtimeAllocationLedgerHashU32FromBytes(0x19, 0xa4, 0xc1, 0x16)
    if index == 49: return runtimeAllocationLedgerHashU32FromBytes(0x1e, 0x37, 0x6c, 0x08)
    if index == 50: return runtimeAllocationLedgerHashU32FromBytes(0x27, 0x48, 0x77, 0x4c)
    if index == 51: return runtimeAllocationLedgerHashU32FromBytes(0x34, 0xb0, 0xbc, 0xb5)
    if index == 52: return runtimeAllocationLedgerHashU32FromBytes(0x39, 0x1c, 0x0c, 0xb3)
    if index == 53: return runtimeAllocationLedgerHashU32FromBytes(0x4e, 0xd8, 0xaa, 0x4a)
    if index == 54: return runtimeAllocationLedgerHashU32FromBytes(0x5b, 0x9c, 0xca, 0x4f)
    if index == 55: return runtimeAllocationLedgerHashU32FromBytes(0x68, 0x2e, 0x6f, 0xf3)
    if index == 56: return runtimeAllocationLedgerHashU32FromBytes(0x74, 0x8f, 0x82, 0xee)
    if index == 57: return runtimeAllocationLedgerHashU32FromBytes(0x78, 0xa5, 0x63, 0x6f)
    if index == 58: return runtimeAllocationLedgerHashU32FromBytes(0x84, 0xc8, 0x78, 0x14)
    if index == 59: return runtimeAllocationLedgerHashU32FromBytes(0x8c, 0xc7, 0x02, 0x08)
    if index == 60: return runtimeAllocationLedgerHashU32FromBytes(0x90, 0xbe, 0xff, 0xfa)
    if index == 61: return runtimeAllocationLedgerHashU32FromBytes(0xa4, 0x50, 0x6c, 0xeb)
    if index == 62: return runtimeAllocationLedgerHashU32FromBytes(0xbe, 0xf9, 0xa3, 0xf7)
    if index == 63: return runtimeAllocationLedgerHashU32FromBytes(0xc6, 0x71, 0x78, 0xf2)
    return uint64(0)

fn runtimeAllocationLedgerHashU32(value: uint64): uint64 =
    return value & uint64(0xffffffff)

fn runtimeAllocationLedgerHashRotateRight(
        value: uint64,
        amount: int32): uint64 =
    let bounded = runtimeAllocationLedgerHashU32(value)
    return runtimeAllocationLedgerHashU32(
        (bounded >> uint64(amount)) |
        (bounded << uint64(32 - amount)))

fn runtimeAllocationLedgerHashBigSigma0(value: uint64): uint64 =
    return runtimeAllocationLedgerHashU32(
        runtimeAllocationLedgerHashRotateRight(value, 2) ^
        runtimeAllocationLedgerHashRotateRight(value, 13) ^
        runtimeAllocationLedgerHashRotateRight(value, 22))

fn runtimeAllocationLedgerHashBigSigma1(value: uint64): uint64 =
    return runtimeAllocationLedgerHashU32(
        runtimeAllocationLedgerHashRotateRight(value, 6) ^
        runtimeAllocationLedgerHashRotateRight(value, 11) ^
        runtimeAllocationLedgerHashRotateRight(value, 25))

fn runtimeAllocationLedgerHashSmallSigma0(value: uint64): uint64 =
    let bounded = runtimeAllocationLedgerHashU32(value)
    return runtimeAllocationLedgerHashU32(
        runtimeAllocationLedgerHashRotateRight(bounded, 7) ^
        runtimeAllocationLedgerHashRotateRight(bounded, 18) ^
        (bounded >> uint64(3)))

fn runtimeAllocationLedgerHashSmallSigma1(value: uint64): uint64 =
    let bounded = runtimeAllocationLedgerHashU32(value)
    return runtimeAllocationLedgerHashU32(
        runtimeAllocationLedgerHashRotateRight(bounded, 17) ^
        runtimeAllocationLedgerHashRotateRight(bounded, 19) ^
        (bounded >> uint64(10)))

fn runtimeAllocationLedgerHashChoose(
        x: uint64,
        y: uint64,
        z: uint64): uint64 =
    let mask = uint64(0xffffffff)
    return runtimeAllocationLedgerHashU32(
        (x & y) ^ ((x ^ mask) & z))

fn runtimeAllocationLedgerHashMajority(
        x: uint64,
        y: uint64,
        z: uint64): uint64 =
    return runtimeAllocationLedgerHashU32(
        (x & y) ^ (x & z) ^ (y & z))

fn runtimeAllocationLedgerHashFramePutU64(
        frame: var uint8[448],
        offset: var int32,
        value: uint64): bool =
    if offset < 0 || offset > 440:
        return false
    for byteIndex in 0..<8:
        frame[offset + byteIndex] =
            uint8((value >> uint64(byteIndex * 8)) & uint64(255))
    offset = offset + 8
    return true

fn runtimeAllocationLedgerHashFramePutText(
        frame: var uint8[448],
        offset: var int32,
        value: str): bool =
    let count = StrLenFast(value)
    if count < 0 || offset < 0 || offset > 448 - count:
        return false
    for byteIndex in 0..<count:
        frame[offset + byteIndex] =
            uint8(int32(value[byteIndex]) & 255)
    offset = offset + count
    return true

@borrows
fn runtimeAllocationLedgerHashFrameU32Be(
        frame: uint8[448],
        offset: int32): uint64 =
    return (uint64(frame[offset]) << uint64(24)) |
           (uint64(frame[offset + 1]) << uint64(16)) |
           (uint64(frame[offset + 2]) << uint64(8)) |
           uint64(frame[offset + 3])

@borrows
fn runtimeAllocationLedgerHashCompress(
        frame: uint8[448],
        blockOffset: int32,
        state: var uint64[8],
        schedule: var uint64[64]) =
    for index in 0..<16:
        schedule[index] = runtimeAllocationLedgerHashFrameU32Be(
            frame, blockOffset + index * 4)
    for index in 16..<64:
        schedule[index] = runtimeAllocationLedgerHashU32(
            schedule[index - 16] +
            runtimeAllocationLedgerHashSmallSigma0(
                schedule[index - 15]) +
            schedule[index - 7] +
            runtimeAllocationLedgerHashSmallSigma1(
                schedule[index - 2]))
    var a = state[0]
    var b = state[1]
    var c = state[2]
    var d = state[3]
    var e = state[4]
    var f = state[5]
    var g = state[6]
    var h = state[7]
    for index in 0..<64:
        let first = runtimeAllocationLedgerHashU32(
            h + runtimeAllocationLedgerHashBigSigma1(e) +
            runtimeAllocationLedgerHashChoose(e, f, g) +
            runtimeAllocationLedgerHashK(index) + schedule[index])
        let second = runtimeAllocationLedgerHashU32(
            runtimeAllocationLedgerHashBigSigma0(a) +
            runtimeAllocationLedgerHashMajority(a, b, c))
        h = g
        g = f
        f = e
        e = runtimeAllocationLedgerHashU32(d + first)
        d = c
        c = b
        b = a
        a = runtimeAllocationLedgerHashU32(first + second)
    state[0] = runtimeAllocationLedgerHashU32(state[0] + a)
    state[1] = runtimeAllocationLedgerHashU32(state[1] + b)
    state[2] = runtimeAllocationLedgerHashU32(state[2] + c)
    state[3] = runtimeAllocationLedgerHashU32(state[3] + d)
    state[4] = runtimeAllocationLedgerHashU32(state[4] + e)
    state[5] = runtimeAllocationLedgerHashU32(state[5] + f)
    state[6] = runtimeAllocationLedgerHashU32(state[6] + g)
    state[7] = runtimeAllocationLedgerHashU32(state[7] + h)

fn runtimeAllocationLedgerReceiptCidMatchesWire(
        cid: RuntimeAllocationLedgerCid,
        wire: RuntimeAllocationLedgerReceiptWire): bool =
    let difference =
        (cid.word0 ^ wire.receipt0) |
        (cid.word1 ^ wire.receipt1) |
        (cid.word2 ^ wire.receipt2) |
        (cid.word3 ^ wire.receipt3)
    return difference == uint64(0)

fn RuntimeAllocationLedgerReceiptCidRecompute(
        wire: RuntimeAllocationLedgerReceiptWire,
        outCid: var RuntimeAllocationLedgerCid): bool =
    var cleared: RuntimeAllocationLedgerCid
    outCid = cleared
    var frame: uint8[448]
    var offset: int32
    let domain = "cheng.runtime.allocation_ledger.receipt_wire"
    let domainLength = StrLenFast(domain)
    let valid =
        domainLength == 44 &&
        runtimeAllocationLedgerHashFramePutU64(
            frame, offset, uint64(domainLength)) &&
        runtimeAllocationLedgerHashFramePutText(
            frame, offset, domain) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.abiMagic) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.abiByteSize) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, uint64(wire.complete)) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, uint64(wire.active)) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, uint64(wire.closed)) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, uint64(wire.operation)) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, uint64(wire.storageKind)) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, uint64(wire.rawManagedPointerAbaProven)) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, uint64(wire.recursiveLockProven)) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, uint64(wire.reserved)) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.capabilityGeneration) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.allocationId) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.ownerGeneration) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.allocationGeneration) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.slabId) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.slabGeneration) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.slabBackingBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.backingDeltaBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.reallocOverlapUsableBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.requestedPayloadBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.usablePayloadBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.headerBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.backingBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.alignmentBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.layout0) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.layout1) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.layout2) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.layout3) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.ownerDomain0) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.ownerDomain1) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.ownerDomain2) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.ownerDomain3) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.eventChain0) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.eventChain1) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.eventChain2) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.eventChain3) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.backingLimit) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.controlPlaneBackingBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.liveBackingBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.peakBackingBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.liveMappedVirtualBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.peakMappedVirtualBytes) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.liveAllocationCount) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.peakAllocationCount) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.liveMappingCount) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.liveHandleCount) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.peakHandleCount) &&
        runtimeAllocationLedgerHashFramePutU64(frame, offset, wire.eventIndex)
    if !valid || offset != 436:
        return false
    frame[offset] = uint8(0x80)
    var bitLength = uint64(436 * 8)
    for byteIndex in 0..<8:
        frame[447 - byteIndex] = uint8(bitLength & uint64(255))
        bitLength = bitLength >> uint64(8)
    var state: uint64[8]
    state[0] = runtimeAllocationLedgerHashU32FromBytes(0x6a, 0x09, 0xe6, 0x67)
    state[1] = runtimeAllocationLedgerHashU32FromBytes(0xbb, 0x67, 0xae, 0x85)
    state[2] = runtimeAllocationLedgerHashU32FromBytes(0x3c, 0x6e, 0xf3, 0x72)
    state[3] = runtimeAllocationLedgerHashU32FromBytes(0xa5, 0x4f, 0xf5, 0x3a)
    state[4] = runtimeAllocationLedgerHashU32FromBytes(0x51, 0x0e, 0x52, 0x7f)
    state[5] = runtimeAllocationLedgerHashU32FromBytes(0x9b, 0x05, 0x68, 0x8c)
    state[6] = runtimeAllocationLedgerHashU32FromBytes(0x1f, 0x83, 0xd9, 0xab)
    state[7] = runtimeAllocationLedgerHashU32FromBytes(0x5b, 0xe0, 0xcd, 0x19)
    var schedule: uint64[64]
    for blockIndex in 0..<7:
        runtimeAllocationLedgerHashCompress(
            frame, blockIndex * 64, state, schedule)
    outCid.word0 = (state[0] << uint64(32)) | state[1]
    outCid.word1 = (state[2] << uint64(32)) | state[3]
    outCid.word2 = (state[4] << uint64(32)) | state[5]
    outCid.word3 = (state[6] << uint64(32)) | state[7]
    return true

@borrows
fn RuntimeAllocationLedgerBegin(
        ownerDomain: str,
        backingLimit: uint64): RuntimeAllocationLedgerOwnerResult =
    var out: RuntimeAllocationLedgerOwnerResult
    if !RuntimeAllocationLedgerSupported():
        out.error = "allocation_ledger_provider_unsupported"
        return out
    let rc = runtimeAllocationLedgerBeginBridge(
        ownerDomain,
        backingLimit,
        out.owner.handle,
        out.owner.generation,
        out.error)
    if rc != 1 || out.owner.handle == uint64(0) ||
       out.owner.generation == uint64(0):
        if Len(out.error) == 0:
            out.error = "allocation_ledger_begin_failed"
        return out
    out.ok = true
    return out

fn RuntimeAllocationLedgerSessionOwnerBegin(
        backingLimit: uint64,
        capability: var RuntimeAllocationLedgerSessionCapability): bool =
    capability.handle = uint64(0)
    capability.generation = uint64(0)
    capability.nonce0 = uint64(0)
    capability.nonce1 = uint64(0)
    if !RuntimeAllocationLedgerSupported():
        return false
    var error: str
    let rc = runtimeAllocationLedgerSessionOwnerBeginBridge(
        backingLimit,
        capability.handle,
        capability.generation,
        capability.nonce0,
        capability.nonce1,
        error)
    return rc == 1 && capability.handle != uint64(0) &&
        capability.generation != uint64(0) &&
        (capability.nonce0 != uint64(0) ||
         capability.nonce1 != uint64(0))

fn RuntimeAllocationLedgerParticipantCapabilityIsEmpty(
        capability: RuntimeAllocationLedgerParticipantCapability): bool =
    return capability.row == 0 && capability.generation == 0 &&
        capability.owner == 0

fn RuntimeAllocationLedgerParticipantStartedWorkerOrdinal(): int32 =
    return runtimeAllocationLedgerParticipantStartedWorkerOrdinalBridge()

fn runtimeAllocationLedgerParticipantRootValid(
        root: RuntimeAllocationLedgerParticipantRoot): bool =
    return root.word0 != uint64(0) || root.word1 != uint64(0) ||
        root.word2 != uint64(0) || root.word3 != uint64(0)

fn RuntimeAllocationLedgerParticipantMint(
        workerOrdinal: int32,
        boundary: RuntimeAllocationLedgerParticipantRoot,
        capability: var
            RuntimeAllocationLedgerParticipantCapability): bool =
    capability = RuntimeAllocationLedgerParticipantCapability()
    if workerOrdinal < 0 ||
       !runtimeAllocationLedgerParticipantRootValid(boundary):
        return false
    let rc = runtimeAllocationLedgerParticipantMintBridge(
        workerOrdinal,
        boundary.word0,
        boundary.word1,
        boundary.word2,
        boundary.word3,
        capability.row,
        capability.generation,
        capability.owner)
    return rc == 1 && capability.row >= 0 &&
        capability.generation > 0 && capability.owner > 0

fn RuntimeAllocationLedgerParticipantMove(
        source: var RuntimeAllocationLedgerParticipantCapability,
        destination: var
            RuntimeAllocationLedgerParticipantCapability): bool =
    destination = RuntimeAllocationLedgerParticipantCapability()
    if source.row < 0 || source.generation <= 0 || source.owner <= 0:
        return false
    var nextGeneration: int32
    var nextOwner: int32
    let rc = runtimeAllocationLedgerParticipantMoveBridge(
        source.row,
        source.generation,
        source.owner,
        nextGeneration,
        nextOwner)
    if rc != 1 || nextGeneration <= 0 || nextOwner <= 0:
        return false
    destination.row = source.row
    destination.generation = nextGeneration
    destination.owner = nextOwner
    source = RuntimeAllocationLedgerParticipantCapability()
    return true

fn RuntimeAllocationLedgerParticipantClaim(
        capability: var RuntimeAllocationLedgerParticipantCapability,
        workerOrdinal: int32,
        boundary: RuntimeAllocationLedgerParticipantRoot): bool =
    if capability.row < 0 || capability.generation <= 0 ||
       capability.owner <= 0 || workerOrdinal < 0 ||
       !runtimeAllocationLedgerParticipantRootValid(boundary):
        return false
    var nextGeneration: int32
    var nextOwner: int32
    let rc = runtimeAllocationLedgerParticipantClaimBridge(
        capability.row,
        capability.generation,
        capability.owner,
        workerOrdinal,
        boundary.word0,
        boundary.word1,
        boundary.word2,
        boundary.word3,
        nextGeneration,
        nextOwner)
    if rc != 1 || nextGeneration <= 0 || nextOwner <= 0:
        return false
    capability.generation = nextGeneration
    capability.owner = nextOwner
    return true

fn RuntimeAllocationLedgerParticipantPublish(
        capability: var RuntimeAllocationLedgerParticipantCapability,
        workerOrdinal: int32,
        boundary: RuntimeAllocationLedgerParticipantRoot,
        result: RuntimeAllocationLedgerParticipantRoot): bool =
    if capability.row < 0 || capability.generation <= 0 ||
       capability.owner <= 0 || workerOrdinal < 0 ||
       !runtimeAllocationLedgerParticipantRootValid(boundary) ||
       !runtimeAllocationLedgerParticipantRootValid(result):
        return false
    var nextGeneration: int32
    var nextOwner: int32
    let rc = runtimeAllocationLedgerParticipantPublishBridge(
        capability.row,
        capability.generation,
        capability.owner,
        workerOrdinal,
        boundary.word0,
        boundary.word1,
        boundary.word2,
        boundary.word3,
        result.word0,
        result.word1,
        result.word2,
        result.word3,
        nextGeneration,
        nextOwner)
    if rc != 1 || nextGeneration <= 0 || nextOwner <= 0:
        return false
    capability.generation = nextGeneration
    capability.owner = nextOwner
    return true

fn RuntimeAllocationLedgerParticipantConsume(
        capability: var RuntimeAllocationLedgerParticipantCapability,
        workerOrdinal: int32,
        boundary: RuntimeAllocationLedgerParticipantRoot,
        result: RuntimeAllocationLedgerParticipantRoot): bool =
    if capability.row < 0 || capability.generation <= 0 ||
       capability.owner <= 0 || workerOrdinal < 0 ||
       !runtimeAllocationLedgerParticipantRootValid(boundary) ||
       !runtimeAllocationLedgerParticipantRootValid(result):
        return false
    let rc = runtimeAllocationLedgerParticipantConsumeBridge(
        capability.row,
        capability.generation,
        capability.owner,
        workerOrdinal,
        boundary.word0,
        boundary.word1,
        boundary.word2,
        boundary.word3,
        result.word0,
        result.word1,
        result.word2,
        result.word3)
    if rc != 1:
        return false
    capability = RuntimeAllocationLedgerParticipantCapability()
    return true

fn runtimeAllocationLedgerReadReceipt(
        handle: uint64,
        generation: uint64,
        nonce0: uint64,
        nonce1: uint64,
        sessionCapabilityRequired: bool,
        closeOwner: bool,
        outNextNonce0: var uint64,
        outNextNonce1: var uint64): RuntimeAllocationLedgerReceiptResult =
    var out: RuntimeAllocationLedgerReceiptResult
    outNextNonce0 = uint64(0)
    outNextNonce1 = uint64(0)
    if handle == uint64(0) || generation == uint64(0) ||
       (sessionCapabilityRequired &&
        nonce0 == uint64(0) && nonce1 == uint64(0)):
        out.error = "allocation_ledger_invalid_owner_handle"
        return out
    var wire: RuntimeAllocationLedgerReceiptWire
    var rc: int32
    if sessionCapabilityRequired && closeOwner:
        rc = runtimeAllocationLedgerSessionOwnerCloseBridge(
            handle,
            generation,
            nonce0,
            nonce1,
            wire,
            out.error)
    elif sessionCapabilityRequired:
        rc = runtimeAllocationLedgerSessionOwnerSnapshotBridge(
            handle,
            generation,
            nonce0,
            nonce1,
            outNextNonce0,
            outNextNonce1,
            wire,
            out.error)
    elif closeOwner:
        rc = runtimeAllocationLedgerCloseBridge(
            handle,
            generation,
            wire,
            out.error)
    else:
        rc = runtimeAllocationLedgerSnapshotBridge(
            handle,
            generation,
            wire,
            out.error)
    if rc != 1:
        if Len(out.error) == 0:
            out.error = "allocation_ledger_receipt_failed"
        return out
    if wire.abiMagic != uint64(0x43484c4452435054):
        out.error = "allocation_ledger_receipt_magic_mismatch"
        return out
    if wire.abiByteSize != uint64(384):
        out.error = "allocation_ledger_receipt_size_mismatch"
        return out
    if wire.reserved != 0:
        out.error = "allocation_ledger_receipt_reserved_invalid"
        return out
    if wire.complete < 0 || wire.complete > 1 ||
       wire.active < 0 || wire.active > 1 ||
       wire.closed < 0 || wire.closed > 1 ||
       wire.rawManagedPointerAbaProven < 0 ||
       wire.rawManagedPointerAbaProven > 1 ||
       wire.recursiveLockProven < 0 || wire.recursiveLockProven > 1:
        out.error = "allocation_ledger_receipt_boolean_invalid"
        return out
    if wire.operation != int32(RuntimeAllocationLedgerOpBegin) &&
       wire.operation != int32(RuntimeAllocationLedgerOpMalloc) &&
       wire.operation != int32(RuntimeAllocationLedgerOpRealloc) &&
       wire.operation != int32(RuntimeAllocationLedgerOpFree) &&
       wire.operation != int32(RuntimeAllocationLedgerOpMmap) &&
       wire.operation != int32(RuntimeAllocationLedgerOpMunmap) &&
       wire.operation != int32(RuntimeAllocationLedgerOpClose) &&
       wire.operation != int32(RuntimeAllocationLedgerOpRetain) &&
       wire.operation != int32(RuntimeAllocationLedgerOpRelease) &&
       wire.operation != int32(RuntimeAllocationLedgerOpHandleRegister) &&
       wire.operation != int32(RuntimeAllocationLedgerOpHandleInvalidate):
        out.error = "allocation_ledger_operation_invalid"
        return out
    if wire.storageKind < int32(RuntimeAllocationLedgerStorageNone) ||
       wire.storageKind > int32(RuntimeAllocationLedgerStorageFileMap):
        out.error = "allocation_ledger_storage_kind_invalid"
        return out
    var recomputedReceiptCid: RuntimeAllocationLedgerCid
    if !RuntimeAllocationLedgerReceiptCidRecompute(
           wire, recomputedReceiptCid):
        out.error = "allocation_ledger_receipt_cid_recompute_failed"
        return out
    if !runtimeAllocationLedgerReceiptCidMatchesWire(
           recomputedReceiptCid, wire):
        out.error = "allocation_ledger_receipt_cid_mismatch"
        return out
    if wire.capabilityGeneration != generation:
        out.error = "allocation_ledger_receipt_generation_mismatch"
        return out
    if closeOwner && (wire.active != 0 || wire.closed != 1 ||
                      wire.operation !=
                          int32(RuntimeAllocationLedgerOpClose)):
        out.error = "allocation_ledger_close_state_mismatch"
        return out
    if !closeOwner && (wire.active != 1 || wire.closed != 0):
        out.error = "allocation_ledger_snapshot_state_mismatch"
        return out
    let proofComplete = wire.closed == 1 &&
        wire.rawManagedPointerAbaProven == 1 &&
        wire.recursiveLockProven == 1
    if (wire.complete == 1) != proofComplete:
        out.error = "allocation_ledger_runtime_proof_binding_mismatch"
        return out
    out.receipt.complete = wire.complete == 1
    out.receipt.active = wire.active == 1
    out.receipt.closed = wire.closed == 1
    out.receipt.capabilityGeneration = wire.capabilityGeneration
    out.receipt.allocationId = wire.allocationId
    out.receipt.ownerGeneration = wire.ownerGeneration
    out.receipt.operation =
        RuntimeAllocationLedgerOperation(wire.operation)
    out.receipt.storageKind =
        RuntimeAllocationLedgerStorageKind(wire.storageKind)
    out.receipt.allocationGeneration = wire.allocationGeneration
    out.receipt.slabId = wire.slabId
    out.receipt.slabGeneration = wire.slabGeneration
    out.receipt.slabBackingBytes = wire.slabBackingBytes
    out.receipt.backingDeltaBytes = wire.backingDeltaBytes
    out.receipt.reallocOverlapUsableBytes =
        wire.reallocOverlapUsableBytes
    out.receipt.requestedPayloadBytes = wire.requestedPayloadBytes
    out.receipt.usablePayloadBytes = wire.usablePayloadBytes
    out.receipt.headerBytes = wire.headerBytes
    out.receipt.backingBytes = wire.backingBytes
    out.receipt.alignmentBytes = wire.alignmentBytes
    out.receipt.allocatorLayoutCid.word0 = wire.layout0
    out.receipt.allocatorLayoutCid.word1 = wire.layout1
    out.receipt.allocatorLayoutCid.word2 = wire.layout2
    out.receipt.allocatorLayoutCid.word3 = wire.layout3
    out.receipt.ownerDomainCid.word0 = wire.ownerDomain0
    out.receipt.ownerDomainCid.word1 = wire.ownerDomain1
    out.receipt.ownerDomainCid.word2 = wire.ownerDomain2
    out.receipt.ownerDomainCid.word3 = wire.ownerDomain3
    out.receipt.eventChainCid.word0 = wire.eventChain0
    out.receipt.eventChainCid.word1 = wire.eventChain1
    out.receipt.eventChainCid.word2 = wire.eventChain2
    out.receipt.eventChainCid.word3 = wire.eventChain3
    out.receipt.backingLimit = wire.backingLimit
    out.receipt.controlPlaneBackingBytes =
        wire.controlPlaneBackingBytes
    out.receipt.liveBackingBytes = wire.liveBackingBytes
    out.receipt.peakBackingBytes = wire.peakBackingBytes
    out.receipt.liveMappedVirtualBytes = wire.liveMappedVirtualBytes
    out.receipt.peakMappedVirtualBytes = wire.peakMappedVirtualBytes
    out.receipt.liveAllocationCount = wire.liveAllocationCount
    out.receipt.peakAllocationCount = wire.peakAllocationCount
    out.receipt.liveMappingCount = wire.liveMappingCount
    out.receipt.liveHandleCount = wire.liveHandleCount
    out.receipt.peakHandleCount = wire.peakHandleCount
    out.receipt.rawManagedPointerAbaProven =
        wire.rawManagedPointerAbaProven == 1
    out.receipt.recursiveLockProven = wire.recursiveLockProven == 1
    out.receipt.eventIndex = wire.eventIndex
    out.receipt.receiptCid.word0 = wire.receipt0
    out.receipt.receiptCid.word1 = wire.receipt1
    out.receipt.receiptCid.word2 = wire.receipt2
    out.receipt.receiptCid.word3 = wire.receipt3
    if closeOwner && wire.complete != 1:
        out.error = "allocation_ledger_incomplete_runtime_proof"
        return out
    out.ok = true
    return out

fn RuntimeAllocationLedgerSnapshot(
        owner: RuntimeAllocationLedgerOwner):
        RuntimeAllocationLedgerReceiptResult =
    var nextNonce0: uint64
    var nextNonce1: uint64
    return runtimeAllocationLedgerReadReceipt(
        owner.handle,
        owner.generation,
        uint64(0),
        uint64(0),
        false,
        false,
        nextNonce0,
        nextNonce1)

fn RuntimeAllocationLedgerClose(
        owner: RuntimeAllocationLedgerOwner):
        RuntimeAllocationLedgerReceiptResult =
    var nextNonce0: uint64
    var nextNonce1: uint64
    return runtimeAllocationLedgerReadReceipt(
        owner.handle,
        owner.generation,
        uint64(0),
        uint64(0),
        false,
        true,
        nextNonce0,
        nextNonce1)

fn RuntimeAllocationLedgerSessionOwnerSnapshot(
        capability: var RuntimeAllocationLedgerSessionCapability):
        RuntimeAllocationLedgerReceiptResult =
    var nextNonce0: uint64
    var nextNonce1: uint64
    let out = runtimeAllocationLedgerReadReceipt(
        capability.handle,
        capability.generation,
        capability.nonce0,
        capability.nonce1,
        true,
        false,
        nextNonce0,
        nextNonce1)
    if out.ok:
        capability.nonce0 = nextNonce0
        capability.nonce1 = nextNonce1
    return out

fn RuntimeAllocationLedgerSessionOwnerClose(
        capability: var RuntimeAllocationLedgerSessionCapability):
        RuntimeAllocationLedgerReceiptResult =
    var nextNonce0: uint64
    var nextNonce1: uint64
    let out = runtimeAllocationLedgerReadReceipt(
        capability.handle,
        capability.generation,
        capability.nonce0,
        capability.nonce1,
        true,
        true,
        nextNonce0,
        nextNonce1)
    if out.ok:
        capability.handle = uint64(0)
        capability.generation = uint64(0)
    capability.nonce0 = uint64(0)
    capability.nonce1 = uint64(0)
    return out

# Must be the first source-level operation in a production child.  `0` means
# no inherited ticket (ordinary non-production invocation), `1` means the
# ticket was atomically imported and acknowledged, and `-1` is a malformed or
# replayed channel that callers must treat as terminal failure.
fn RuntimeHeldExecChildImport(): int32 =
    return runtimeHeldExecChildImportBridge()

fn RuntimeHeldExecFdContentSha256(
        fd: int32): RuntimeHeldExecFdDigestResult =
    return runtimeHeldExecFdContentSha256Bridge(fd)

@borrows
fn RuntimeHeldExecParentSealBundleOwner(
        envelopeBytes: str,
        expectedHeldBundleCid: str): int32 =
    return runtimeHeldExecParentSealBundleOwnerBridge(
        envelopeBytes, expectedHeldBundleCid)

fn RuntimeHeldExecBundleOwnerAbort(bundleOwner: int32): bool =
    return runtimeHeldExecBundleOwnerAbortBridge(bundleOwner) == 1

fn RuntimeHeldExecChildAdmissionActive(): bool =
    return runtimeHeldExecChildAdmissionActiveBridge() == 1

fn RuntimeHeldExecChildCapsuleRoleOwner(): int32 =
    return runtimeHeldExecChildCapsuleRoleOwnerBridge()

fn RuntimeHeldExecChildExecutableCid(): str =
    let result = runtimeHeldExecChildExecutableDigestBridge()
    if result.status != 1:
        return ""
    return RuntimeHeldExecFdDigestCid(result)

fn RuntimeHeldExecChildTakeBundleBytesInto(
        outBytes: var str): RuntimeHeldExecBundleTakeResult =
    return runtimeHeldExecChildTakeBundleBytesBridge(outBytes)

fn runtimeHeldExecChildError(errorCode: int32): str =
    if errorCode == RuntimeHeldExecChildErrAdmissionMissing:
        return "held_exec_child_admission_missing"
    if errorCode == RuntimeHeldExecChildErrBundleMissing:
        return "held_exec_child_bundle_missing"
    if errorCode == RuntimeHeldExecChildErrPlanCidInvalid:
        return "held_exec_child_plan_cid_invalid"
    if errorCode == RuntimeHeldExecChildErrPlanSendFailed:
        return "held_exec_child_plan_send_failed"
    if errorCode == RuntimeHeldExecChildErrPlanAckInvalid:
        return "held_exec_child_plan_ack_invalid"
    if errorCode == RuntimeHeldExecChildErrOutputBindingInvalid:
        return "held_exec_child_output_binding_invalid"
    if errorCode == RuntimeHeldExecChildErrOutputOpenFailed:
        return "held_exec_child_output_open_failed"
    if errorCode == RuntimeHeldExecChildErrOutputSealInvalid:
        return "held_exec_child_output_seal_invalid"
    if errorCode == RuntimeHeldExecChildErrTerminalPreconditionFailed:
        return "held_exec_child_terminal_precondition_failed"
    if errorCode == RuntimeHeldExecChildErrTerminalSendFailed:
        return "held_exec_child_terminal_send_failed"
    if errorCode == RuntimeHeldExecChildErrDecisionInvalid:
        return "held_exec_child_terminal_decision_invalid"
    return "held_exec_child_unknown_failure"

fn runtimeHeldExecHexDigit(value: int32): int32 =
    if value < 10:
        return int32('0') + value
    return int32('a') + value - 10

fn runtimeHeldExecDigestCid(
        digest0: uint64,
        digest1: uint64,
        digest2: uint64,
        digest3: uint64): str =
    if digest0 == uint64(0) && digest1 == uint64(0) &&
       digest2 == uint64(0) && digest3 == uint64(0):
        return ""
    let out = newStringAlloc(71)
    if out.data == nil || out.len != 71:
        return ""
    rawmemWriteI8Compat(out.data, 0, int8(int32('s')))
    rawmemWriteI8Compat(out.data, 1, int8(int32('h')))
    rawmemWriteI8Compat(out.data, 2, int8(int32('a')))
    rawmemWriteI8Compat(out.data, 3, int8(int32('2')))
    rawmemWriteI8Compat(out.data, 4, int8(int32('5')))
    rawmemWriteI8Compat(out.data, 5, int8(int32('6')))
    rawmemWriteI8Compat(out.data, 6, int8(int32(':')))
    for byteIndex in 0..<32:
        let limbIndex = byteIndex / 8
        var limb = digest0
        if limbIndex == 1:
            limb = digest1
        elif limbIndex == 2:
            limb = digest2
        elif limbIndex == 3:
            limb = digest3
        let byteValue = int32(
            (limb >> uint64((byteIndex % 8) * 8)) & uint64(255))
        rawmemWriteI8Compat(
            out.data,
            7 + byteIndex * 2,
            int8(runtimeHeldExecHexDigit(byteValue / 16)))
        rawmemWriteI8Compat(
            out.data,
            8 + byteIndex * 2,
            int8(runtimeHeldExecHexDigit(byteValue % 16)))
    return out

@borrows
fn RuntimeHeldExecChildBindPlanReceiptInto(
        planEvidenceBytes: str,
        planEvidenceCid: str,
        outLauncherReceiptCid: var str,
        outError: var str): bool =
    outLauncherReceiptCid = ""
    outError = ""
    let result = runtimeHeldExecChildBindPlanReceiptBridge(
        planEvidenceBytes,
        planEvidenceCid)
    if result.status != 1:
        outError = runtimeHeldExecChildError(result.errorCode)
        return false
    let receiptCid = runtimeHeldExecDigestCid(
        result.digest0,
        result.digest1,
        result.digest2,
        result.digest3)
    if receiptCid.len != 71:
        outError = "held_exec_child_plan_receipt_projection_failed"
        return false
    outLauncherReceiptCid = receiptCid
    return true

@borrows
fn RuntimeHeldExecChildPublishOutputInto(
        outputCid: str,
        compileReceiptCid: str,
        compileReceiptCanonical: str,
        outputPath: str,
        outError: var str): bool =
    outError = ""
    let result = runtimeHeldExecChildPublishOutputBridge(
        outputCid,
        compileReceiptCid,
        compileReceiptCanonical,
        outputPath)
    if result.status != 1:
        outError = runtimeHeldExecChildError(result.errorCode)
        return false
    return true

@borrows
fn RuntimeHeldExecChildFinishInto(
        childCapsuleOwner: int32,
        exitCode: int32,
        allocationReceiptCid: str,
        outTerminalReceiptCid: var str,
        outError: var str): bool =
    outTerminalReceiptCid = ""
    outError = ""
    let result = runtimeHeldExecChildFinishBridge(
        childCapsuleOwner,
        exitCode, allocationReceiptCid)
    if result.status != 1:
        outError = runtimeHeldExecChildError(result.errorCode)
        return false
    let receiptCid = runtimeHeldExecDigestCid(
        result.digest0,
        result.digest1,
        result.digest2,
        result.digest3)
    if receiptCid.len != 71:
        outError = "held_exec_child_terminal_projection_failed"
        return false
    outTerminalReceiptCid = receiptCid
    return true

@borrows
fn RuntimeHeldExecFdDigestCid(
        result: RuntimeHeldExecFdDigestResult): str =
    return runtimeHeldExecDigestCid(
        result.digest0, result.digest1, result.digest2, result.digest3)

@borrows
fn RuntimeHeldExecBundleDigestCid(
        result: RuntimeHeldExecBundleTakeResult): str =
    return runtimeHeldExecDigestCid(
        result.digest0, result.digest1, result.digest2, result.digest3)

@borrows
fn RuntimeHeldExecParentBeginClaim(
        retainedBinaryFd: int32,
        outputPath: str): RuntimeHeldExecParentClaimResult =
    return runtimeHeldExecParentBeginClaimBridge(
        retainedBinaryFd, outputPath)

fn RuntimeHeldExecParentClaimEvidence(
        session: int32): RuntimeHeldExecParentClaimResult =
    return runtimeHeldExecParentClaimEvidenceBridge(session)

@borrows
fn RuntimeHeldExecParentActivateCapsuleOwner(
        session: int32,
        ownerClaimReceiptCid: str,
        providerRoleOwner: int32): RuntimeHeldExecParentPhaseResult =
    return runtimeHeldExecParentActivateCapsuleOwnerBridge(
        session,
        ownerClaimReceiptCid,
        providerRoleOwner)

fn runtimeHeldExecTerminalCapsuleRoleBindBundleOwner(
        providerRoleOwner: int32,
        bundleOwner: var int32): bool =
    if bundleOwner <= 0 ||
       runtimeHeldExecTerminalCapsuleRoleBindBundleOwnerBridge(
           providerRoleOwner,
           bundleOwner) != 1:
        return false
    bundleOwner = -1
    return true

fn RuntimeHeldExecTerminalCapsuleRoleOwnerAbort(
        providerRoleOwner: int32): bool =
    return runtimeHeldExecTerminalCapsuleRoleOwnerAbortBridge(
        providerRoleOwner) == 1

