@importc("load_ptr")
fn ptrLoadLegacy(p: ptr): ptr
fn store(p: ptr, val: T) =
    var tmp: T = val
    memCopyCompat(p, &tmp, elemSize[T]())
fn load(p: ptr): T =
    var out: T
    memCopyCompat(&out, p, elemSize[T]())
    return out
