# buffer.cheng - growable byte buffer (backed by std/rawbytes.Bytes)
#
# API 对齐 pkg://cheng/libp2p 的 utils/buffer，便于机械替换 import。
#
# `data` 存放的是已分配容量(BytesLen(data) == capacity)，`len` 是逻辑内容长度
# (len <= BytesLen(data))。扩容策略镜像 std/seqs.cheng 的 cheng_seq_next_cap
# (起始容量 4，不足时倍增)，把每次 Append 的分配次数从 O(n) 摊还成 O(log n)。
# 对外可见的 len/字节内容语义与旧实现完全一致：ToBytes()/toBytes() 只暴露前
# `len` 个字节，多分配出来的尾部容量从不对外可见。
#
# 调用方一律走本文件公开的 accessor(Len/ToBytes/AppendBytes/AppendText/
# AppendByte/Consume/TakeAllBytes/FinishString)——绝不允许绕过它们直接读写 `.data`/`.len`
# 字段：`.data` 现在是容量不是内容，直接读它当长度/内容会静默把尾部未使用的
# 容量当协议数据；直接写它而不同步 `.len` 会让下一次 Append 用旧的(可能更大的)
# `len` 去拷贝一个刚被换成空/更小容量的 `.data`，读到越界/空指针导致崩溃。

import std/rawbytes
import std/rawmem_support

@abi_internal
@importc("cheng_seq_next_cap")
fn chengBufferNextCap(curCap: int32, needLen: int32): int32

type
    GrowByteBuffer =
        data: Bytes
        len: int32

fn byteBufferEnsureCapacity(buf: var GrowByteBuffer, minCap: int32) =
    let curCap: int32 = BytesLen(buf.data)
    if minCap <= curCap:
        return
    let newCap: int32 = chengBufferNextCap(curCap, minCap)
    let grown: Bytes = BytesAlloc(newCap)
    if buf.len > 0:
        rawmem_support.RawmemCopy(grown.data, buf.data.data, buf.len)
    if curCap > 0:
        var oldData = BytesTake(buf.data)
        BytesFree(oldData)
    buf.data = grown

# 取走缓冲区最前面最多 n 个字节：返回值是这些字节的独立拷贝，缓冲区里剩余的
# (len - n) 个字节被搬到新分配块的最前面，len 相应减少。n<=0 或缓冲区已空时
# 返回空 Bytes、缓冲区不变。这是 GrowByteBuffer 唯一允许“消费掉前缀”的方式；
# 调用方不得再自行 BytesSlice(buf.data,...) 后直接赋回 buf.data。
fn byteBufferConsumeImpl(buf: var GrowByteBuffer, n: int32): Bytes =
    let avail: int32 = buf.len
    if n <= 0 || avail <= 0:
        return emptyBytes()
    let take: int32 = if n < avail: n else: avail
    let out: Bytes = BytesAlloc(take)
    rawmem_support.RawmemCopy(out.data, buf.data.data, take)
    let remain: int32 = avail - take
    if remain > 0:
        let shifted: Bytes = BytesAlloc(remain)
        rawmem_support.RawmemCopy(shifted.data, rawmem_support.RawmemPtrAdd(buf.data.data, take), remain)
        if BytesLen(buf.data) > 0:
            var oldData = BytesTake(buf.data)
            BytesFree(oldData)
        buf.data = shifted
        buf.len = remain
    else:
        if BytesLen(buf.data) > 0:
            var oldData = BytesTake(buf.data)
            BytesFree(oldData)
        buf.data = emptyBytes()
        buf.len = 0
    return out

fn newByteBuffer(): GrowByteBuffer =
    var out: GrowByteBuffer
    out.data = EmptyBytes()
    out.len = 0
    return out

@borrows
fn byteBufferLen(buf: GrowByteBuffer): int32 =
    return buf.len

@borrows
fn isEmpty(buf: GrowByteBuffer): bool =
    return byteBufferLen(buf) <= 0

@borrows
fn byteBufferAppendBytesImpl(buf: var GrowByteBuffer, data: Bytes) =
    let addLen: int32 = BytesLen(data)
    if addLen <= 0:
        return
    let oldLen: int32 = buf.len
    let newLen: int32 = oldLen + addLen
    byteBufferEnsureCapacity(buf, newLen)
    rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(buf.data.data, oldLen), data.data, addLen)
    buf.len = newLen

@borrows
fn appendBytes(buf: var GrowByteBuffer, data: Bytes) =
    byteBufferAppendBytesImpl(buf, data)

@borrows
fn appendText(buf: var GrowByteBuffer, data: str) =
    let dataBytes: Bytes = rawbytes.BytesFromString(data)
    byteBufferAppendBytesImpl(buf, dataBytes)

fn appendByte(buf: var GrowByteBuffer, value: int32) =
    AppendByte(buf, value)

@borrows
@borrow_result
fn toBytes(buf: GrowByteBuffer): Bytes =
    var out: Bytes
    out.data = buf.data.data
    out.len = buf.len
    return out

@borrows
fn AppendBytes(buf: var GrowByteBuffer, data: Bytes) =
    byteBufferAppendBytesImpl(buf, data)

@borrows
fn AppendText(buf: var GrowByteBuffer, data: str) =
    let dataBytes: Bytes = rawbytes.BytesFromString(data)
    byteBufferAppendBytesImpl(buf, dataBytes)

fn AppendByte(buf: var GrowByteBuffer, value: int32) =
    let oldLen: int32 = buf.len
    let newLen: int32 = oldLen + 1
    byteBufferEnsureCapacity(buf, newLen)
    BytesSet(buf.data, oldLen, value)
    buf.len = newLen

# 消费最前面 n 个字节(前移剩余字节 + 同步 len)，返回被取走的字节拷贝。
fn ByteBufferConsume(buf: var GrowByteBuffer, n: int32): Bytes =
    return byteBufferConsumeImpl(buf, n)

# 取走全部当前内容并把缓冲区清空(len=0，容量归零)。等价于
# ByteBufferConsume(buf, ByteBufferLen(buf))。
fn ByteBufferTakeAllBytes(buf: var GrowByteBuffer): Bytes =
    return byteBufferConsumeImpl(buf, buf.len)

# 把当前逻辑内容复制为独立 str，并消费 GrowByteBuffer 的全部所有权。
# 返回后 data/len 均为空，原容量已释放；返回字符串不借用缓冲区内存。
fn FinishString(buf: var GrowByteBuffer): str =
    let out: str = rawbytes.BytesToString(toBytes(buf))
    var ownedData: Bytes = BytesTake(buf.data)
    buf.len = 0
    BytesFree(ownedData)
    return out

fn NewByteBuffer(): GrowByteBuffer =
    var out: GrowByteBuffer
    out.data = EmptyBytes()
    out.len = 0
    return out

@borrows
fn ByteBufferLen(buf: GrowByteBuffer): int32 =
    return buf.len

@borrows
@borrow_result
fn ToBytes(buf: GrowByteBuffer): Bytes =
    var out: Bytes
    out.data = buf.data.data
    out.len = buf.len
    return out
