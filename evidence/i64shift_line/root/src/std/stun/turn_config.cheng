# TURN server production configuration (stage 4).
#
# The pure-lower `--emit:exe --link-providers` runtime does not read live process
# env (`cheng_host_getenv` is stubbed, confirmed stage 1/2), so configuration is
# read from command-line flags via std/cmdline instead of env vars. Flags accept
# the `--k:v`, `--k=v`, and `--k v` forms (std/cmdline).
#
# Every routine is a small single-purpose function to keep BodyIR/CFG small
# (stage 0-2 codegen contract).

import std/system
import std/cmdline

const
    turnCfgDefaultHost = "0.0.0.0"
    turnCfgDefaultRealm = "example.org"
    turnCfgDefaultNonce = "bd8as92Kdf02Jd72vMaPwcBNds7i40tn"
    turnCfgDefaultPort = 3478
    turnCfgDefaultMinPort = 49160
    turnCfgDefaultMaxPort = 49260
    turnCfgDefaultMaxConns = 256
    turnCfgDefaultNonceTtl = 300
    turnCfgDefaultMetricsMs = 5000
    turnCfgDefaultLogLevel = "info"
    turnCfgDefaultSoftware = "cheng-turn-stage4"
    turnCfgDefaultTlsPort = 5349

type
    TurnConfig =
        host: str
        port: int32
        realm: str
        nonce: str
        secret: str
        minPort: int32
        maxPort: int32
        logLevel: str
        maxConnections: int32
        nonceTtlSec: int32
        metricsIntervalMs: int32
        userdbPath: str
        software: str
        tlsPort: int32
        certPath: str
        keyPath: str
        caPath: str
        valid: bool
        error: str

fn TurnConfigNew(): TurnConfig =
    var c: TurnConfig
    c.host = turnCfgDefaultHost
    c.port = turnCfgDefaultPort
    c.realm = turnCfgDefaultRealm
    c.nonce = turnCfgDefaultNonce
    c.secret = ""
    c.minPort = turnCfgDefaultMinPort
    c.maxPort = turnCfgDefaultMaxPort
    c.logLevel = turnCfgDefaultLogLevel
    c.maxConnections = turnCfgDefaultMaxConns
    c.nonceTtlSec = turnCfgDefaultNonceTtl
    c.metricsIntervalMs = turnCfgDefaultMetricsMs
    c.userdbPath = ""
    c.software = turnCfgDefaultSoftware
    c.tlsPort = turnCfgDefaultTlsPort
    c.certPath = ""
    c.keyPath = ""
    c.caPath = ""
    c.valid = false
    c.error = ""
    return c

fn TurnConfigReadSecret(c: var TurnConfig) =
    c.secret = cmdline.ReadFlagOrDefault("--secret", "")

fn TurnConfigReadRealm(c: var TurnConfig) =
    c.realm = cmdline.ReadFlagOrDefault("--realm", turnCfgDefaultRealm)

fn TurnConfigReadHost(c: var TurnConfig) =
    c.host = cmdline.ReadFlagOrDefault("--host", turnCfgDefaultHost)

fn TurnConfigReadNonce(c: var TurnConfig) =
    c.nonce = cmdline.ReadFlagOrDefault("--nonce", turnCfgDefaultNonce)

fn TurnConfigReadLogLevel(c: var TurnConfig) =
    c.logLevel = cmdline.ReadFlagOrDefault("--log-level", turnCfgDefaultLogLevel)

fn TurnConfigReadUserdb(c: var TurnConfig) =
    c.userdbPath = cmdline.ReadFlagOrDefault("--userdb", "")

fn TurnConfigReadSoftware(c: var TurnConfig) =
    c.software = cmdline.ReadFlagOrDefault("--software", turnCfgDefaultSoftware)

fn TurnConfigReadTlsPort(c: var TurnConfig) =
    c.tlsPort = cmdline.ReadInt32FlagOrDefault("--tls-port", turnCfgDefaultTlsPort)

fn TurnConfigReadCert(c: var TurnConfig) =
    c.certPath = cmdline.ReadFlagOrDefault("--cert", "")

fn TurnConfigReadKey(c: var TurnConfig) =
    c.keyPath = cmdline.ReadFlagOrDefault("--key", "")

fn TurnConfigReadCa(c: var TurnConfig) =
    c.caPath = cmdline.ReadFlagOrDefault("--ca", "")

fn TurnConfigReadInts(c: var TurnConfig) =
    c.port = cmdline.ReadInt32FlagOrDefault("--port", turnCfgDefaultPort)
    c.minPort = cmdline.ReadInt32FlagOrDefault("--min-port", turnCfgDefaultMinPort)
    c.maxPort = cmdline.ReadInt32FlagOrDefault("--max-port", turnCfgDefaultMaxPort)
    c.maxConnections = cmdline.ReadInt32FlagOrDefault("--max-connections", turnCfgDefaultMaxConns)
    c.nonceTtlSec = cmdline.ReadInt32FlagOrDefault("--nonce-ttl", turnCfgDefaultNonceTtl)
    c.metricsIntervalMs = cmdline.ReadInt32FlagOrDefault("--metrics-interval-ms", turnCfgDefaultMetricsMs)

fn TurnConfigLoadFlags(c: var TurnConfig) =
    TurnConfigReadSecret(c)
    TurnConfigReadRealm(c)
    TurnConfigReadHost(c)
    TurnConfigReadNonce(c)
    TurnConfigReadLogLevel(c)
    TurnConfigReadUserdb(c)
    TurnConfigReadSoftware(c)
    TurnConfigReadTlsPort(c)
    TurnConfigReadCert(c)
    TurnConfigReadKey(c)
    TurnConfigReadCa(c)
    TurnConfigReadInts(c)

@borrows
fn TurnConfigValidateSecret(c: TurnConfig): bool =
    if c.secret == "":
        return false
    return true

@borrows
fn TurnConfigValidatePort(c: TurnConfig): bool =
    if c.port < 1 || c.port > 65535:
        return false
    return true

@borrows
fn TurnConfigValidateRelayRange(c: TurnConfig): bool =
    if c.minPort < 1 || c.minPort > 65535:
        return false
    if c.maxPort < 1 || c.maxPort > 65535:
        return false
    if c.minPort > c.maxPort:
        return false
    return true

@borrows
fn TurnConfigValidateMaxConns(c: TurnConfig): bool =
    if c.maxConnections < 1:
        return false
    return true

@borrows
fn TurnConfigValidateTls(c: TurnConfig): bool =
    # TURNS is opt-in: if cert and key are both provided, tlsPort must be valid.
    # If only one of cert/key is provided, that is a config error.
    let hasCert: bool = c.certPath != ""
    let hasKey: bool = c.keyPath != ""
    if !hasCert && !hasKey:
        return true
    if !hasCert || !hasKey:
        return false
    if c.tlsPort < 1 || c.tlsPort > 65535:
        return false
    return true

fn TurnConfigTlsEnabled(c: TurnConfig): bool =
    return c.certPath != "" && c.keyPath != ""

fn TurnConfigSetError(c: var TurnConfig, msg: str) =
    c.valid = false
    c.error = msg

fn TurnConfigValidate(c: var TurnConfig): int32 =
    if !TurnConfigValidateSecret(c):
        TurnConfigSetError(c, "secret is required (--secret)")
        return 1
    if !TurnConfigValidatePort(c):
        TurnConfigSetError(c, "port out of range 1..65535")
        return 2
    if !TurnConfigValidateRelayRange(c):
        TurnConfigSetError(c, "relay port range invalid (need 1<=min-port<=max-port<=65535)")
        return 3
    if !TurnConfigValidateMaxConns(c):
        TurnConfigSetError(c, "max-connections must be >= 1")
        return 4
    if !TurnConfigValidateTls(c):
        TurnConfigSetError(c, "tls requires both --cert and --key (and valid --tls-port 1..65535)")
        return 5
    c.valid = true
    c.error = ""
    return 0

# Load configuration from the captured command line. `main` must pass the real
# argc/argv so std/cmdline can capture them first. Returns a TurnConfig with
# `valid` set and `error` filled when validation fails.
fn TurnLoadConfig(argc: int32, argv: str*): TurnConfig =
    cmdline.CaptureCmdLine(argc, argv)
    var c: TurnConfig = TurnConfigNew()
    TurnConfigLoadFlags(c)
    let _ = TurnConfigValidate(c)
    return c

# Load configuration from the runtime-populated command line (standalone exe:
# the pure-lower runtime auto-fills std/cmdline params, so no argc/argv capture
# is needed from `main`). Used by the production standalone entry.
fn TurnLoadConfigRuntime(): TurnConfig =
    var c: TurnConfig = TurnConfigNew()
    TurnConfigLoadFlags(c)
    let _ = TurnConfigValidate(c)
    return c

# Validate a config without re-reading flags (used by unit tests that build a
# config by hand).
fn TurnValidateConfig(c: var TurnConfig): int32 =
    return TurnConfigValidate(c)

fn TurnConfigIsValid(c: TurnConfig): bool =
    return c.valid

fn TurnConfigError(c: TurnConfig): str =
    return c.error
