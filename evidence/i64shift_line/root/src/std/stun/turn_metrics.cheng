# TURN server metrics (stage 4).
#
# Thread-safe counters/gauges shared across the UDP server thread, the TCP
# accept thread, the per-connection TCP threads, and the metrics printer thread.
# Uses module-level int32 counters guarded by raw atomic ops (@importc of the
# same `cheng_atomic_*` C symbols that std/atomic binds to; the linker resolves
# the single provider definition). This avoids ref-counted atomic.I32 churn on
# the hot relay path and sidesteps module-level ref initializer uncertainty.
#
# Limitation: only int32 atomics are in the default --link-providers set, so the
# relay-byte counters wrap at 2 GiB. Production i64 byte counters need an i64
# atomic provider (recorded in findings). Allocation/connection/auth counters are
# int32 and sufficient.
#
# Every routine is a small single-purpose function (stage 0-2 codegen contract).

import std/system
import std/os

@importc("cheng_atomic_fetch_add_i32")
fn mFetchAdd(p: ptr, delta: int32): int32

@importc("cheng_atomic_load_i32")
fn mLoad(p: ptr): int32

@importc("cheng_atomic_store_i32")
fn mStore(p: ptr, val: int32)

var
    gActiveAlloc: int32
    gTotalAlloc: int32
    gActiveConn: int32
    gTotalConn: int32
    gRelayBytesIn: int32
    gRelayBytesOut: int32
    gAuthSuccess: int32
    gAuthFail: int32
    gErrors: int32
    gRateLimited: int32
    gCapacityExhausted: int32

fn TurnMetricsReset() =
    mStore(&gActiveAlloc, 0)
    mStore(&gTotalAlloc, 0)
    mStore(&gActiveConn, 0)
    mStore(&gTotalConn, 0)
    mStore(&gRelayBytesIn, 0)
    mStore(&gRelayBytesOut, 0)
    mStore(&gAuthSuccess, 0)
    mStore(&gAuthFail, 0)
    mStore(&gErrors, 0)
    mStore(&gRateLimited, 0)
    mStore(&gCapacityExhausted, 0)

fn TurnMetricsIncActiveAlloc() =
    let _ = mFetchAdd(&gActiveAlloc, 1)
    let _ = mFetchAdd(&gTotalAlloc, 1)

fn TurnMetricsDecActiveAlloc() =
    let _ = mFetchAdd(&gActiveAlloc, -1)

fn TurnMetricsIncActiveConn() =
    let _ = mFetchAdd(&gActiveConn, 1)
    let _ = mFetchAdd(&gTotalConn, 1)

fn TurnMetricsDecActiveConn() =
    let _ = mFetchAdd(&gActiveConn, -1)

fn TurnMetricsAddRelayIn(n: int32) =
    let _ = mFetchAdd(&gRelayBytesIn, n)

fn TurnMetricsAddRelayOut(n: int32) =
    let _ = mFetchAdd(&gRelayBytesOut, n)

fn TurnMetricsIncAuthSuccess() =
    let _ = mFetchAdd(&gAuthSuccess, 1)

fn TurnMetricsIncAuthFail() =
    let _ = mFetchAdd(&gAuthFail, 1)

fn TurnMetricsIncErrors() =
    let _ = mFetchAdd(&gErrors, 1)

fn TurnMetricsIncRateLimited() =
    let _ = mFetchAdd(&gRateLimited, 1)

fn TurnMetricsIncCapacityExhausted() =
    let _ = mFetchAdd(&gCapacityExhausted, 1)

fn TurnMetricsActiveAlloc(): int32 =
    return mLoad(&gActiveAlloc)

fn TurnMetricsTotalAlloc(): int32 =
    return mLoad(&gTotalAlloc)

fn TurnMetricsActiveConn(): int32 =
    return mLoad(&gActiveConn)

fn TurnMetricsTotalConn(): int32 =
    return mLoad(&gTotalConn)

fn TurnMetricsRelayIn(): int32 =
    return mLoad(&gRelayBytesIn)

fn TurnMetricsRelayOut(): int32 =
    return mLoad(&gRelayBytesOut)

fn TurnMetricsAuthSuccess(): int32 =
    return mLoad(&gAuthSuccess)

fn TurnMetricsAuthFail(): int32 =
    return mLoad(&gAuthFail)

fn TurnMetricsErrors(): int32 =
    return mLoad(&gErrors)

fn TurnMetricsRateLimited(): int32 =
    return mLoad(&gRateLimited)

fn TurnMetricsCapacityExhausted(): int32 =
    return mLoad(&gCapacityExhausted)

fn TurnMetricsPrint() =
    let aa: int32 = mLoad(&gActiveAlloc)
    let ta: int32 = mLoad(&gTotalAlloc)
    let ac: int32 = mLoad(&gActiveConn)
    let tc: int32 = mLoad(&gTotalConn)
    let ri: int32 = mLoad(&gRelayBytesIn)
    let ro: int32 = mLoad(&gRelayBytesOut)
    let ok: int32 = mLoad(&gAuthSuccess)
    let af: int32 = mLoad(&gAuthFail)
    let er: int32 = mLoad(&gErrors)
    let rl: int32 = mLoad(&gRateLimited)
    let ce: int32 = mLoad(&gCapacityExhausted)
    let line: str = Fmt"metrics active_alloc={aa} total_alloc={ta} active_conn={ac} total_conn={tc} relay_in={ri} relay_out={ro} auth_ok={ok} auth_fail={af} errors={er} rate_limited={rl} capacity_exhausted={ce}\n"
    os.Write(os.GetStderr(), line)
