# TURN relay port-range allocator (stage 4).
#
# coturn allocates relay ports from a configured range [min-port, max-port] and
# returns 508 Insufficient Capacity when the range is exhausted. This module
# hands out ports round-robin from a shared cursor guarded by an atomic spinlock
# (shared across the UDP server thread and TCP conn threads). The caller binds the
# returned port; if bind fails (port already in use by another process or by one
# of our own live relay sockets) the caller releases nothing and asks for the
# next port, so a full scan of the range either finds a bindable port or yields
# 508. Closing a relay fd frees its port for reuse when the cursor wraps.
#
# State is just four int32 words (no SoA array): a cheng cold-compiler codegen bug
# mishandles refs whose payload contains a large (>= ~1024 byte) fixed array, so
# the used-port set is avoided. Every routine is a small single-purpose function
# (stage 0-2 codegen contract).

import std/system
import std/thread

@importc("cheng_atomic_cas_i32")
fn paCas(p: ptr, expect: int32, desired: int32): int32

@importc("cheng_atomic_store_i32")
fn paStore(p: ptr, val: int32)

type
    TurnPortAlloc =
        lock: int32
        minPort: int32
        maxPort: int32
        cursor: int32

fn TurnPortAllocNew(minPort: int32, maxPort: int32): TurnPortAlloc =
    let a = new(TurnPortAlloc)
    a.lock = 0
    a.minPort = minPort
    a.maxPort = maxPort
    a.cursor = minPort
    return a

fn TurnPortAllocLock(a: var TurnPortAlloc) =
    while paCas(&a.lock, 0, 1) == 0:
        thread.Yield()

fn TurnPortAllocUnlock(a: var TurnPortAlloc) =
    paStore(&a.lock, 0)

# Reserve the next port in the range (round-robin from the cursor). Nil-safe:
# returns 1 when no allocator is configured so the caller can fall back to an
# ephemeral bind. Always succeeds otherwise; the caller binds the returned port
# and asks for the next one on bind failure.
fn TurnPortAllocNext(a: var TurnPortAlloc, outPort: var int32): int32 =
    if a == nil:
        return 1
    if a.maxPort < a.minPort:
        return 1
    TurnPortAllocLock(a)
    let p: int32 = a.cursor
    a.cursor = a.cursor + 1
    if a.cursor > a.maxPort:
        a.cursor = a.minPort
    TurnPortAllocUnlock(a)
    outPort = p
    return 0

# No per-port bookkeeping to release: closing the relay fd frees the port, and the
# cursor reuses it after one wrap. Kept for API symmetry with future bookkeeping.
fn TurnPortAllocRelease(a: var TurnPortAlloc, port: int32) =
    let _ = a
    let _ = port

# Value-returning variant: returns the next port, or -1 when there is no allocator
# or the range is empty. Used by callers that cannot take a var out-param across
# modules (the cold compiler drops var out-param writeback for some cross-module
# calls -- stage-4 lesson). The var-out-param opener is called intra-module here.
fn TurnPortAllocNextVal(a: var TurnPortAlloc): int32 =
    var p: int32
    let rc: int32 = TurnPortAllocNext(a, p)
    if rc != 0:
        return -1
    return p

fn TurnPortAllocMinPort(a: var TurnPortAlloc): int32 =
    return a.minPort

fn TurnPortAllocMaxPort(a: var TurnPortAlloc): int32 =
    return a.maxPort
