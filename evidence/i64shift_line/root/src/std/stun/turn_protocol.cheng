# TURN protocol (RFC 5766) — message types + attribute encode/decode.
#
# Reuses the STUN header/attribute framework from std/stun/protocol (header
# build, attribute append, XOR-MAPPED-ADDRESS codec, MESSAGE-INTEGRITY and
# FINGERPRINT). XOR-PEER-ADDRESS and XOR-RELAYED-ADDRESS share the XOR-MAPPED
# ADDRESS encoding, so they delegate to StunEncodeXorMappedAddress.
#
# Attribute / message-type code values are taken verbatim from RFC 5766
# section 13 (methods) and section 14 (attributes), NOT from the later
# RFC 8656 renumbering. coturn 4.6.x implements RFC 5766.
#
# Every routine is a small single-purpose function to keep BodyIR/CFG small.

import std/rawbytes
import std/system
import std/stun/protocol as stun

const
    # STUN methods (RFC 5766 section 13)
    turnMethodAllocate = 0x003
    turnMethodRefresh = 0x004
    turnMethodSend = 0x006
    turnMethodData = 0x007
    turnMethodCreatePermission = 0x008
    turnMethodChannelBind = 0x009

    # STUN message types (method encoded into the 16-bit type field per
    # RFC 5389 section 6: request=+0, indication=+0x0010, success=+0x0100,
    # error=+0x0110).
    turnAllocateRequest = 0x0003
    turnAllocateSuccess = 0x0103
    turnAllocateError = 0x0113
    turnRefreshRequest = 0x0004
    turnRefreshSuccess = 0x0104
    turnRefreshError = 0x0114
    turnSendIndication = 0x0016
    turnDataIndication = 0x0017
    turnCreatePermissionRequest = 0x0008
    turnCreatePermissionSuccess = 0x0108
    turnCreatePermissionError = 0x0118
    turnChannelBindRequest = 0x0009
    turnChannelBindSuccess = 0x0109
    turnChannelBindError = 0x0119

    # TURN attributes (RFC 5766 section 14)
    turnAttrChannelNumber = 0x000C
    turnAttrLifetime = 0x000D
    turnAttrXorPeerAddress = 0x0012
    turnAttrData = 0x0013
    turnAttrXorRelayedAddress = 0x0016
    turnAttrEvenPort = 0x0018
    turnAttrRequestedTransport = 0x0019
    turnAttrDontFragment = 0x001A
    turnAttrReservationToken = 0x0022

    # REQUESTED-TRANSPORT protocol codepoints (IPv4 Protocol / IPv6 NextHeader)
    turnProtoUdp = 17

    # Channel numbers are 0x4000-0x7FFF (RFC 5766 section 2.6 / 11.4).
    turnChannelMin = 0x4000
    turnChannelMax = 0x7FFF

type
    TurnAllocateResp =
        relayedFamily: int32
        relayedIp: Bytes
        relayedPort: int32
        hasRelayed: bool
        lifetime: int32
        hasLifetime: bool
        reservationToken: Bytes
        hasReservationToken: bool

# --- single-attribute encoders ---

fn TurnEncodeRequestedTransport(proto: int32): Bytes =
    let out: Bytes = BytesAlloc(4)
    BytesSet(out, 0, proto)
    BytesSet(out, 1, 0)
    BytesSet(out, 2, 0)
    BytesSet(out, 3, 0)
    return out

fn TurnEncodeLifetime(seconds: int32): Bytes =
    let out: Bytes = BytesAlloc(4)
    stun.StunSetU32BE(out, 0, int64(seconds))
    return out

fn TurnEncodeDontFragment(): Bytes =
    return EmptyBytes()

fn TurnEncodeChannelNumber(channel: int32): Bytes =
    let out: Bytes = BytesAlloc(4)
    stun.StunSetU16BE(out, 0, channel)
    stun.StunSetU16BE(out, 2, 0)
    return out

fn TurnEncodeEvenPort(reserve: bool): Bytes =
    let out: Bytes = BytesAlloc(1)
    if reserve:
        BytesSet(out, 0, 0x80)
    return out

fn TurnEncodeReservationToken(token: Bytes): Bytes =
    return token

# XOR-PEER-ADDRESS / XOR-RELAYED-ADDRESS reuse XOR-MAPPED-ADDRESS encoding.

fn TurnEncodeXorPeerAddress(ip: Bytes, port: int32, txid: Bytes): Bytes =
    return stun.StunEncodeXorMappedAddress(ip, port, stun.StunMagicCookie(), txid)

fn TurnEncodeXorRelayedAddress(ip: Bytes, port: int32, txid: Bytes): Bytes =
    return stun.StunEncodeXorMappedAddress(ip, port, stun.StunMagicCookie(), txid)

# --- single-attribute decoders ---

fn TurnDecodeRequestedTransport(msg: Bytes): int32 =
    let off: int32 = stun.StunFindAttrOffset(msg, turnAttrRequestedTransport)
    if off < 0:
        return -1
    return BytesGet(msg, off + 4)

fn TurnDecodeLifetime(msg: Bytes): int32 =
    let off: int32 = stun.StunFindAttrOffset(msg, turnAttrLifetime)
    if off < 0:
        return -1
    return int32(stun.StunU32BE(msg, off + 4))

fn TurnDecodeChannelNumber(msg: Bytes): int32 =
    let off: int32 = stun.StunFindAttrOffset(msg, turnAttrChannelNumber)
    if off < 0:
        return -1
    return stun.StunU16BE(msg, off + 4)

fn TurnDecodeData(msg: Bytes): Bytes =
    let off: int32 = stun.StunFindAttrOffset(msg, turnAttrData)
    if off < 0:
        return EmptyBytes()
    let l: int32 = stun.StunU16BE(msg, off + 2)
    return BytesSlice(msg, off + 4, l)

fn TurnDecodeReservationToken(msg: Bytes): Bytes =
    let off: int32 = stun.StunFindAttrOffset(msg, turnAttrReservationToken)
    if off < 0:
        return EmptyBytes()
    return BytesSlice(msg, off + 4, 8)

fn TurnDecodeXorPeerAddress(msg: Bytes, txid: Bytes): stun.StunXorMappedAddress =
    let off: int32 = stun.StunFindAttrOffset(msg, turnAttrXorPeerAddress)
    if off < 0:
        return stun.StunXorMappedAddress()
    let l: int32 = stun.StunU16BE(msg, off + 2)
    return stun.StunDecodeXorMappedAddress(BytesSlice(msg, off + 4, l), stun.StunMagicCookie(), txid)

fn TurnDecodeXorRelayedAddress(msg: Bytes, txid: Bytes): stun.StunXorMappedAddress =
    let off: int32 = stun.StunFindAttrOffset(msg, turnAttrXorRelayedAddress)
    if off < 0:
        return stun.StunXorMappedAddress()
    let l: int32 = stun.StunU16BE(msg, off + 2)
    return stun.StunDecodeXorMappedAddress(BytesSlice(msg, off + 4, l), stun.StunMagicCookie(), txid)

fn TurnHasDontFragment(msg: Bytes): bool =
    return stun.StunFindAttrOffset(msg, turnAttrDontFragment) >= 0

# --- message builders ---

fn TurnEncodeAllocateRequest(txid: Bytes, requestedTransport: int32, lifetime: int32, dontFragment: bool, software: Bytes, key: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnAllocateRequest, txid)
    let rt: Bytes = TurnEncodeRequestedTransport(requestedTransport)
    var msg: Bytes = stun.StunAppendAttr(base, turnAttrRequestedTransport, rt)
    if lifetime > 0:
        msg = stun.StunAppendAttr(msg, turnAttrLifetime, TurnEncodeLifetime(lifetime))
    if dontFragment:
        msg = stun.StunAppendAttr(msg, turnAttrDontFragment, TurnEncodeDontFragment())
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeAllocateResponse(txid: Bytes, relayedIp: Bytes, relayedPort: int32, lifetime: int32, reservationToken: Bytes, hasReservation: bool, key: Bytes, software: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnAllocateSuccess, txid)
    var msg: Bytes = base
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    let xra: Bytes = TurnEncodeXorRelayedAddress(relayedIp, relayedPort, txid)
    msg = stun.StunAppendAttr(msg, turnAttrXorRelayedAddress, xra)
    msg = stun.StunAppendAttr(msg, turnAttrLifetime, TurnEncodeLifetime(lifetime))
    if hasReservation && BytesLen(reservationToken) > 0:
        msg = stun.StunAppendAttr(msg, turnAttrReservationToken, TurnEncodeReservationToken(reservationToken))
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeCreatePermissionRequest(txid: Bytes, peerIp: Bytes, peerPort: int32, key: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnCreatePermissionRequest, txid)
    let xpa: Bytes = TurnEncodeXorPeerAddress(peerIp, peerPort, txid)
    var msg: Bytes = stun.StunAppendAttr(base, turnAttrXorPeerAddress, xpa)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeCreatePermissionRequestAuth(txid: Bytes, peerIp: Bytes, peerPort: int32, username: Bytes, realm: Bytes, nonce: Bytes, key: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnCreatePermissionRequest, txid)
    let xpa: Bytes = TurnEncodeXorPeerAddress(peerIp, peerPort, txid)
    var msg: Bytes = stun.StunAppendAttr(base, turnAttrXorPeerAddress, xpa)
    if BytesLen(username) > 0:
        msg = TurnAppendUsername(msg, username)
    if BytesLen(realm) > 0:
        msg = TurnAppendRealm(msg, realm)
    if BytesLen(nonce) > 0:
        msg = TurnAppendNonce(msg, nonce)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeCreatePermissionResponse(txid: Bytes, key: Bytes, software: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnCreatePermissionSuccess, txid)
    var msg: Bytes = base
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeSendIndication(txid: Bytes, peerIp: Bytes, peerPort: int32, data: Bytes, dontFragment: bool): Bytes =
    let base: Bytes = stun.StunNewHeader(turnSendIndication, txid)
    let xpa: Bytes = TurnEncodeXorPeerAddress(peerIp, peerPort, txid)
    var msg: Bytes = stun.StunAppendAttr(base, turnAttrXorPeerAddress, xpa)
    if BytesLen(data) > 0:
        msg = stun.StunAppendAttr(msg, turnAttrData, data)
    if dontFragment:
        msg = stun.StunAppendAttr(msg, turnAttrDontFragment, TurnEncodeDontFragment())
    msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeDataIndication(txid: Bytes, peerIp: Bytes, peerPort: int32, data: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnDataIndication, txid)
    let xpa: Bytes = TurnEncodeXorPeerAddress(peerIp, peerPort, txid)
    var msg: Bytes = stun.StunAppendAttr(base, turnAttrXorPeerAddress, xpa)
    if BytesLen(data) > 0:
        msg = stun.StunAppendAttr(msg, turnAttrData, data)
    msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeChannelBindRequest(txid: Bytes, channel: int32, peerIp: Bytes, peerPort: int32, key: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnChannelBindRequest, txid)
    let cn: Bytes = TurnEncodeChannelNumber(channel)
    var msg: Bytes = stun.StunAppendAttr(base, turnAttrChannelNumber, cn)
    let xpa: Bytes = TurnEncodeXorPeerAddress(peerIp, peerPort, txid)
    msg = stun.StunAppendAttr(msg, turnAttrXorPeerAddress, xpa)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeChannelBindResponse(txid: Bytes, key: Bytes, software: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnChannelBindSuccess, txid)
    var msg: Bytes = base
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeRefreshRequest(txid: Bytes, lifetime: int32, key: Bytes, software: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnRefreshRequest, txid)
    var msg: Bytes = base
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    if lifetime > 0:
        msg = stun.StunAppendAttr(msg, turnAttrLifetime, TurnEncodeLifetime(lifetime))
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeRefreshResponse(txid: Bytes, lifetime: int32, key: Bytes, software: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnRefreshSuccess, txid)
    var msg: Bytes = base
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    msg = stun.StunAppendAttr(msg, turnAttrLifetime, TurnEncodeLifetime(lifetime))
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeErrorResponse(msgType: int32, txid: Bytes, code: int32, reason: str, key: Bytes, software: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(msgType, txid)
    let ec: Bytes = stun.StunEncodeErrorCode(code, reason)
    var msg: Bytes = stun.StunAppendAttr(base, stun.StunAttrErrorCode(), ec)
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

# --- message decoders ---

fn TurnDecodeAllocateResponse(msg: Bytes, txid: Bytes): TurnAllocateResp =
    var resp: TurnAllocateResp
    let xra: stun.StunXorMappedAddress = TurnDecodeXorRelayedAddress(msg, txid)
    if xra.family != 0:
        resp.relayedFamily = xra.family
        resp.relayedIp = xra.ip
        resp.relayedPort = xra.port
        resp.hasRelayed = true
    let lt: int32 = TurnDecodeLifetime(msg)
    if lt >= 0:
        resp.lifetime = lt
        resp.hasLifetime = true
    let tok: Bytes = TurnDecodeReservationToken(msg)
    if BytesLen(tok) > 0:
        resp.reservationToken = tok
        resp.hasReservationToken = true
    return resp

fn TurnDecodeRefreshResponse(msg: Bytes): int32 =
    return TurnDecodeLifetime(msg)

fn TurnMessageType(msg: Bytes): int32 =
    return stun.StunU16BE(msg, 0)

fn TurnMessageTxid(msg: Bytes): Bytes =
    return BytesSlice(msg, 8, 12)

fn TurnIsAllocateRequest(msg: Bytes): bool =
    return TurnMessageType(msg) == turnAllocateRequest

fn TurnIsAllocateSuccess(msg: Bytes): bool =
    return TurnMessageType(msg) == turnAllocateSuccess

fn TurnIsAllocateError(msg: Bytes): bool =
    return TurnMessageType(msg) == turnAllocateError

fn TurnIsRefreshRequest(msg: Bytes): bool =
    return TurnMessageType(msg) == turnRefreshRequest

fn TurnIsSendIndication(msg: Bytes): bool =
    return TurnMessageType(msg) == turnSendIndication

fn TurnIsDataIndication(msg: Bytes): bool =
    return TurnMessageType(msg) == turnDataIndication

fn TurnIsCreatePermissionRequest(msg: Bytes): bool =
    return TurnMessageType(msg) == turnCreatePermissionRequest

fn TurnIsChannelBindRequest(msg: Bytes): bool =
    return TurnMessageType(msg) == turnChannelBindRequest

fn TurnIsValidChannel(channel: int32): bool =
    return channel >= turnChannelMin && channel <= turnChannelMax

fn TurnProtoUdp(): int32 =
    return turnProtoUdp

fn TurnAllocateErrorType(): int32 =
    return turnAllocateError

fn TurnCreatePermissionErrorType(): int32 =
    return turnCreatePermissionError

fn TurnChannelBindErrorType(): int32 =
    return turnChannelBindError

fn TurnRefreshErrorType(): int32 =
    return turnRefreshError

fn TurnAppendUsername(msg: Bytes, username: Bytes): Bytes =
    return stun.StunAppendAttr(msg, stun.StunAttrUsername(), username)

fn TurnAppendRealm(msg: Bytes, realm: Bytes): Bytes =
    return stun.StunAppendAttr(msg, stun.StunAttrRealm(), realm)

fn TurnAppendNonce(msg: Bytes, nonce: Bytes): Bytes =
    return stun.StunAppendAttr(msg, stun.StunAttrNonce(), nonce)

fn TurnEncodeAllocateRequestNoAuth(txid: Bytes, requestedTransport: int32, lifetime: int32, dontFragment: bool, software: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnAllocateRequest, txid)
    let rt: Bytes = TurnEncodeRequestedTransport(requestedTransport)
    var msg: Bytes = stun.StunAppendAttr(base, turnAttrRequestedTransport, rt)
    if lifetime > 0:
        msg = stun.StunAppendAttr(msg, turnAttrLifetime, TurnEncodeLifetime(lifetime))
    if dontFragment:
        msg = stun.StunAppendAttr(msg, turnAttrDontFragment, TurnEncodeDontFragment())
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    return msg

fn TurnEncodeAllocateRequestAuth(txid: Bytes, requestedTransport: int32, lifetime: int32, dontFragment: bool, software: Bytes, username: Bytes, realm: Bytes, nonce: Bytes, key: Bytes): Bytes =
    let base: Bytes = TurnEncodeAllocateRequestNoAuth(txid, requestedTransport, lifetime, dontFragment, software)
    var msg: Bytes = base
    if BytesLen(username) > 0:
        msg = TurnAppendUsername(msg, username)
    if BytesLen(realm) > 0:
        msg = TurnAppendRealm(msg, realm)
    if BytesLen(nonce) > 0:
        msg = TurnAppendNonce(msg, nonce)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
        msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnEncodeAllocate401(txid: Bytes, realm: Bytes, nonce: Bytes, software: Bytes, key: Bytes): Bytes =
    let base: Bytes = stun.StunNewHeader(turnAllocateError, txid)
    let ec: Bytes = stun.StunEncodeErrorCode(401, "Unauthorized")
    var msg: Bytes = stun.StunAppendAttr(base, stun.StunAttrErrorCode(), ec)
    if BytesLen(software) > 0:
        msg = stun.StunAppendAttr(msg, stun.StunAttrSoftware(), software)
    if BytesLen(realm) > 0:
        msg = TurnAppendRealm(msg, realm)
    if BytesLen(nonce) > 0:
        msg = TurnAppendNonce(msg, nonce)
    if BytesLen(key) > 0:
        msg = stun.StunAppendMessageIntegrity(msg, key)
    msg = stun.StunAppendFingerprint(msg)
    return msg

fn TurnDecodeRealm(msg: Bytes): Bytes =
    let off: int32 = stun.StunFindAttrOffset(msg, stun.StunAttrRealm())
    if off < 0:
        return EmptyBytes()
    let l: int32 = stun.StunU16BE(msg, off + 2)
    return BytesSlice(msg, off + 4, l)

fn TurnDecodeNonce(msg: Bytes): Bytes =
    let off: int32 = stun.StunFindAttrOffset(msg, stun.StunAttrNonce())
    if off < 0:
        return EmptyBytes()
    let l: int32 = stun.StunU16BE(msg, off + 2)
    return BytesSlice(msg, off + 4, l)

fn TurnDecodeUsername(msg: Bytes): Bytes =
    let off: int32 = stun.StunFindAttrOffset(msg, stun.StunAttrUsername())
    if off < 0:
        return EmptyBytes()
    let l: int32 = stun.StunU16BE(msg, off + 2)
    return BytesSlice(msg, off + 4, l)
