# TURN per-IP allocation rate limiting (stage 4).
#
# Limits the number of concurrent allocations per client IP (DoS protection):
# a single source IP may hold at most `maxPerIp` concurrent allocations. When the
# limit is exceeded the server rejects the Allocate with 438 Allocation Quota
# Reached (RFC 5766 §6.3) -- or, for the production hardening goal, denies before
# the relay socket is opened. The table is a fixed SoA host->count map guarded by
# an atomic spinlock (shared across the UDP server thread and TCP conn threads).
#
# The host table is capped at turnMaxRlHosts (256 distinct source IPs this stage;
# codegen-driven cap, recorded in findings). Every routine is a small
# single-purpose function (stage 0-2 codegen contract).

import std/system
import std/thread

const
    turnMaxRlHosts = 16

@importc("cheng_atomic_cas_i32")
fn rlCas(p: ptr, expect: int32, desired: int32): int32

@importc("cheng_atomic_store_i32")
fn rlStore(p: ptr, val: int32)

type
    TurnRateLimit =
        lock: int32
        maxPerIp: int32
        hosts: str[turnMaxRlHosts]
        counts: int32[turnMaxRlHosts]
        total: int32

fn TurnRateLimitNew(maxPerIp: int32): TurnRateLimit =
    let a = new(TurnRateLimit)
    a.lock = 0
    a.maxPerIp = maxPerIp
    a.total = 0
    return a

fn TurnRateLimitLock(a: var TurnRateLimit) =
    while rlCas(&a.lock, 0, 1) == 0:
        thread.Yield()

fn TurnRateLimitUnlock(a: var TurnRateLimit) =
    rlStore(&a.lock, 0)

@borrows
fn TurnRateLimitFindLocked(a: var TurnRateLimit, host: str): int32 =
    let n: int32 = a.total
    var i: int32
    for i in i..<n:
        if a.hosts[i] == host:
            return i
    return -1

# Try to admit one new allocation from `host`. Returns 0 ok (count incremented),
# 1 if the per-IP limit is exceeded, 2 if the host table is full.
fn TurnRateLimitCheckInc(a: var TurnRateLimit, host: str): int32 =
    TurnRateLimitLock(a)
    let idx: int32 = TurnRateLimitFindLocked(a, host)
    if idx >= 0:
        if a.counts[idx] >= a.maxPerIp:
            TurnRateLimitUnlock(a)
            return 1
        a.counts[idx] = a.counts[idx] + 1
        TurnRateLimitUnlock(a)
        return 0
    if a.total >= turnMaxRlHosts:
        TurnRateLimitUnlock(a)
        return 2
    let slot: int32 = a.total
    a.hosts[slot] = host
    a.counts[slot] = 1
    a.total = a.total + 1
    TurnRateLimitUnlock(a)
    return 0

# Decrement the allocation count for `host` (on refresh-to-zero, delete, or
# connection close). Removes the entry when the count reaches zero.
@borrows
fn TurnRateLimitDec(a: var TurnRateLimit, host: str) =
    TurnRateLimitLock(a)
    let idx: int32 = TurnRateLimitFindLocked(a, host)
    if idx < 0:
        TurnRateLimitUnlock(a)
        return
    a.counts[idx] = a.counts[idx] - 1
    if a.counts[idx] <= 0:
        let last: int32 = a.total - 1
        a.hosts[idx] = a.hosts[last]
        a.counts[idx] = a.counts[last]
        a.total = a.total - 1
    TurnRateLimitUnlock(a)

fn TurnRateLimitCount(a: var TurnRateLimit, host: str): int32 =
    TurnRateLimitLock(a)
    let idx: int32 = TurnRateLimitFindLocked(a, host)
    let n: int32 = if idx >= 0: a.counts[idx] else: 0
    TurnRateLimitUnlock(a)
    return n

fn TurnRateLimitTotal(a: var TurnRateLimit): int32 =
    TurnRateLimitLock(a)
    let n: int32 = a.total
    TurnRateLimitUnlock(a)
    return n
