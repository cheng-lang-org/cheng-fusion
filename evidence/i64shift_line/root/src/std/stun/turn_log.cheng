# TURN structured logging (stage 4).
#
# Reuses std/log for level filtering + stderr sink, and adds TURN-specific
# structured event helpers (allocation lifecycle, relay bytes, auth outcome,
# errors). Every routine is a small single-purpose function (stage 0-2 codegen
# contract: keep BodyIR/CFG small).
#
# Event fields are rendered with Fmt into a single line; levels are controlled
# by the cmdline `--log-level` (debug/info/warn/error) via std/log.LogLevelFromName.

import std/system
import std/log

fn TurnLogNew(level: str): log.Logger =
    let lvl: log.LogLevel = log.LogLevelFromName(level)
    return log.NewLogger("turn", lvl)

fn TurnLogInfo(logger: log.Logger, msg: str) =
    log.Info(logger, msg)

fn TurnLogWarn(logger: log.Logger, msg: str) =
    log.Warn(logger, msg)

fn TurnLogError(logger: log.Logger, msg: str) =
    log.Error(logger, msg)

fn TurnLogDebug(logger: log.Logger, msg: str) =
    log.Debug(logger, msg)

fn TurnLogAllocCreate(logger: log.Logger, clientHost: str, clientPort: int32, relayPort: int32) =
    log.Info(logger, Fmt"alloc create client={clientHost}:{clientPort} relay_port={relayPort}")

fn TurnLogAllocRefresh(logger: log.Logger, clientHost: str, clientPort: int32, lifetime: int32) =
    log.Info(logger, Fmt"alloc refresh client={clientHost}:{clientPort} lifetime={lifetime}")

fn TurnLogAllocDelete(logger: log.Logger, clientHost: str, clientPort: int32) =
    log.Info(logger, Fmt"alloc delete client={clientHost}:{clientPort}")

@borrows
fn TurnLogAuthSuccess(logger: log.Logger, clientHost: str, clientPort: int32, user: str) =
    log.Info(logger, Fmt"auth ok client={clientHost}:{clientPort} user={user}")

@borrows
fn TurnLogAuthFail(logger: log.Logger, clientHost: str, clientPort: int32, reason: str) =
    log.Warn(logger, Fmt"auth fail client={clientHost}:{clientPort} reason={reason}")

fn TurnLogRelayBytes(logger: log.Logger, dir: str, n: int32) =
    log.Debug(logger, Fmt"relay dir={dir} bytes={n}")

fn TurnLogRateLimited(logger: log.Logger, clientHost: str, clientPort: int32) =
    log.Warn(logger, Fmt"rate limited client={clientHost}:{clientPort}")

fn TurnLogCapacityExhausted(logger: log.Logger, clientHost: str, clientPort: int32) =
    log.Warn(logger, Fmt"capacity exhausted client={clientHost}:{clientPort}")

fn TurnLogListen(logger: log.Logger, host: str, port: int32, proto: str) =
    log.Info(logger, Fmt"listening host={host} port={port} proto={proto}")

fn TurnLogShutdown(logger: log.Logger) =
    log.Info(logger, "shutdown: stopping accept and clearing allocations")

fn TurnLogStartup(logger: log.Logger, realm: str, minPort: int32, maxPort: int32, maxConns: int32) =
    log.Info(logger, Fmt"startup realm={realm} relay_port_range={minPort}-{maxPort} max_connections={maxConns}")
