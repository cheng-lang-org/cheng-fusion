# TURN authentication (RFC 5766 + RFC 5389 long-term credentials + coturn REST).
#
# REST auth (coturn static-auth-secret flavor): the username is a time-limited
# "expiry:peerId" token and the password is HMAC-SHA1(secret, username). The
# long-term credential key is then MD5(username ":" realm ":" password) per
# RFC 5389 section 15.4 (a SINGLE md5, the HA1 value), reused from
# std/stun/protocol. MESSAGE-INTEGRITY is HMAC-SHA1 over the message with that
# key, also reused from std/stun/protocol.
#
# Note: coturn's REST API ships the password as base64(HMAC-SHA1(...)) to
# clients; the raw HMAC bytes here are the task-spec password material. The
# long-term key is computed over the raw octets via TurnLongTermKeyBytes so it
# stays correct whether the password is an ASCII string or raw bytes.

import std/rawbytes
import std/system
import std/strings
import std/strutils as strutil
import std/crypto/hkdf
import std/crypto/md5
import std/stun/protocol as stun

fn TurnRestUsername(expiry: int64, peerId: str): str =
    return strutil.Join([strings.Int64ToStr(expiry), peerId], ":")

@borrows
fn TurnRestPassword(username: str, secret: Bytes): Bytes =
    return hkdf.hmacDigestSha1(secret, BytesFromString(username))

fn TurnLongTermKey(user: str, realm: str, pass: str): Bytes =
    return stun.StunLongTermKey(user, realm, pass)

@borrows
fn TurnLongTermKeyBytes(user: Bytes, realm: Bytes, pass: Bytes): Bytes =
    let colon: Bytes = BytesFromString(":")
    let ur: Bytes = BytesConcat3(user, colon, realm)
    let urc: Bytes = BytesConcat(ur, colon)
    let full: Bytes = BytesConcat(urc, pass)
    return md5.Md5Digest(full)

@borrows
fn TurnRestLongTermKey(username: str, realm: str, secret: Bytes): Bytes =
    let userBytes: Bytes = BytesFromString(username)
    let realmBytes: Bytes = BytesFromString(realm)
    let passBytes: Bytes = TurnRestPassword(username, secret)
    return TurnLongTermKeyBytes(userBytes, realmBytes, passBytes)

fn TurnVerifyMessageIntegrity(msg: Bytes, key: Bytes): bool =
    return stun.StunVerifyMessageIntegrity(msg, key)

fn TurnVerifyFingerprint(msg: Bytes): bool =
    return stun.StunVerifyFingerprint(msg)
