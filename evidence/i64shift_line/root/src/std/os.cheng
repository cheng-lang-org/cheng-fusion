# Public export surface follows the language rule: exported names start uppercase.
fn GetStdin(): File =
    return get_stdin()

fn GetStdout(): File =
    return get_stdout()

fn GetStderr(): File =
    return get_stderr()

fn OpenRead(filename: str): File =
    return openRead(filename)

fn Open(filename: str, mode: FileMode): File =
    return open(filename, mode)

fn OpenFile(filename: str, flags: int32): File =
    let access = flags & 3
    if access == 0:
        return Open(filename, fmRead)
    if access == 2:
        return Open(filename, fmReadWrite)
    return Open(filename, fmWrite)

