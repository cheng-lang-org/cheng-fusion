@borrows
fn readFileSizedInto(path: str, size: int32, out: var str): bool =
    if size < 0:
        osSetEmpty(out)
        return false
    var readRes: Result[Bytes] = readFileBytesResult(path)
    if IsErr(readRes):
        osSetEmpty(out)
        return false
    var raw: Bytes = Value(readRes)
    if rawbytes.BytesLen(raw) != size:
        rawbytes.BytesFree(raw)
        osSetEmpty(out)
        return false
    var outText: str = rawbytes.BytesToString(raw)
    rawbytes.BytesFree(raw)
    osMoveStr(out, outText)
    return true

@borrows
fn readFileInto(path: str, out: var str): bool =
    if osDebugFileReadEnabled():
        osDebugFileRead(strings.ConcatStr("readFileInto path=", path))
    var readRes: Result[str] = readFileResult(path)
    if IsErr(readRes):
        if osDebugFileReadEnabled():
            osDebugFileRead(Error(readRes))
        osSetEmpty(out)
        return false
    var text: str = Value(readRes)
    osMoveStr(out, text)
    return true

@borrows
fn readFile(path: str): str =
    var readRes: Result[str] = readFileResult(path)
    if IsErr(readRes):
        return ""
    return Value(readRes)

@borrows
fn osWriteAllRaw(f: File, data: ptr, total: int32, label: str) =
    if f == nil:
        panic("os write failed: nil file")
    if total < 0:
        panic("os write failed: negative length")
    if total == 0:
        return
    if data == nil:
        panic("os write failed: nil data")
    var written: int32
    while written < total:
        let chunk: int32 = c_fwrite(SystemPtrAdd(data, written), 1, total - written, f)
        if chunk <= 0:
            panic(share(label))
        written = written + chunk
    ioMeterReport(ioWrite, Int64(written))

fn osCloseWrittenFile(f: File) =
    if c_fflush(f) != 0:
        let _closeAfterFlushFailure: int32 = c_fclose(f)
        panic("os write failed: flush")
    if c_fclose(f) != 0:
        panic("os write failed: close")

@borrows
fn writeFile(path: str, content: str) =
    var writeRes: Result[bool] = writeFileResult(path, content)
    if IsErr(writeRes):
        let writeErrText = Error(writeRes)
        panic(writeErrText)

fn writeFileBytes(path: str, bytes: uint8[]) =
    if strings.Len(path) <= 0:
        panic("os writeFileBytes: empty path")
    var packed: Bytes = rawbytes.EmptyBytes()
    if bytes.len > 0:
        packed = rawbytes.BytesAlloc(bytes.len)
        if rawbytes.BytesLen(packed) != bytes.len || rawbytes.BytesDataPtr(packed) == nil:
            panic("os writeFileBytes: nil data")
        for i in 0..<bytes.len:
            rawbytes.BytesSet(packed, i, int32(bytes[i]) & 255)
    let f: File = openImplWrite(path)
    if f == nil:
        rawbytes.BytesFree(packed)
        panic("os writeFileBytes: open failed")
    osWriteAllRaw(f, packed.data, rawbytes.BytesLen(packed), "os writeFileBytes: write failed")
    osCloseWrittenFile(f)
    rawbytes.BytesFree(packed)

@borrows
fn writeRawFileResult(path: str, data: ptr, dataLen: int32): Result[bool] =
    if strings.Len(path) <= 0:
        return Err[bool]("os write: empty path")
    if dataLen < 0:
        return Err[bool]("os write: negative length")
    if dataLen > 0 && data == nil:
        return Err[bool]("os write: nil data")
    let f: File = openImplWrite(path)
    if f == nil:
        return Err[bool]("os write: open failed")
    var written: int32
    while written < dataLen:
        let chunk: int32 = c_fwrite(SystemPtrAdd(data, written), 1, dataLen - written, f)
        if chunk <= 0:
            let _closeAfterWriteFailure: int32 = c_fclose(f)
            return Err[bool]("os write: write failed")
        written = written + chunk
    if c_fflush(f) != 0:
        let _closeAfterFlushFailure: int32 = c_fclose(f)
        return Err[bool]("os write: flush failed")
    if c_fclose(f) != 0:
        return Err[bool]("os write: close failed")
    if dataLen > 0:
        ioMeterReport(ioWrite, Int64(dataLen))
    return Ok[bool](true)

fn writeRawFileStatus(path: var str, data: ptr, dataLen: int32, outErr: var str): bool =
    outErr = ""
    let writeRes = writeRawFileResult(path, data, dataLen)
    if IsErr(writeRes):
        outErr = Error(writeRes)
        return false
    return true

fn writeRawFileBytesResult(path: str, bytes: rawbytes.Bytes): Result[bool] =
    return writeRawFileResult(path,
                              rawbytes.BytesDataPtr(bytes),
                              rawbytes.BytesLen(bytes))

fn writeRawFileBytesStatus(path: var str,
                           bytes: rawbytes.Bytes,
                           outErr: var str): bool =
    return writeRawFileStatus(path,
                              rawbytes.BytesDataPtr(bytes),
                              rawbytes.BytesLen(bytes),
                              outErr)

@borrows
fn readFileResult(path: str): Result[str] =
    var bytesRes: Result[Bytes] = readFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[str](Error(bytesRes))
    let bytes: Bytes = Value(bytesRes)
    return Ok[str](rawbytes.BytesToString(bytes))

@borrows
fn writeFileResult(path: str, content: str): Result[bool] =
    return writeRawFileResult(path, StrDataPtr(content), strings.Len(content))

@borrows
fn readFileBytesResult(path: str): Result[Bytes] =
    var openRes: Result[FileHandle] = openFileHandleResult(path, Read)
    if IsErr(openRes):
        return Err[Bytes](strings.CloneStr(openRes.err.msg))
    var handle: FileHandle = openRes.value
    openRes.value = uint64(0)
    var readRes: Result[Bytes] = readAllBytesHandleResult(handle)
    var closeRes: Result[bool] = closeFileHandleResult(handle)
    if IsErr(readRes):
        return Err[Bytes](strings.CloneStr(readRes.err.msg))
    if IsErr(closeRes):
        return Err[Bytes](strings.CloneStr(closeRes.err.msg))
    return readRes

fn readFileRangeBytesResult(path: str, offsetBytes: int64, byteCount: int32): Result[Bytes] =
    if strings.Len(path) <= 0:
        return Err[Bytes]("os file range read: empty path")
    if offsetBytes < Int64(0):
        return Err[Bytes]("os file range read: negative offset")
    if byteCount < 0:
        return Err[Bytes]("os file range read: negative count")
    let fileLen = fileSize(strings.CloneStr(path))
    if fileLen < Int64(0):
        return Err[Bytes]("os file range read: file size")
    if offsetBytes > fileLen:
        return Err[Bytes]("os file range read: offset beyond file")
    if Int64(byteCount) > fileLen - offsetBytes:
        return Err[Bytes]("os file range read: range beyond file")
    if byteCount == 0:
        return Ok[Bytes](rawbytes.EmptyBytes())
    let fd: int32 = libc_open(StrToCStringTemp(strings.CloneStr(path)), osOpenReadOnly, 0)
    if fd < 0:
        return Err[Bytes]("os file range read: open failed")
    let seeked = os_lseek(fd, offsetBytes, osSeekSet)
    if seeked != offsetBytes:
        let _closeAfterSeekFailure: int32 = libc_close(fd)
        return Err[Bytes]("os file range read: seek failed")
    var out: Bytes = rawbytes.BytesAlloc(byteCount)
    if rawbytes.BytesDataPtr(out) == nil || rawbytes.BytesLen(out) != byteCount:
        let _closeAfterAllocFailure: int32 = libc_close(fd)
        return Err[Bytes]("os file range read: alloc failed")
    var offset: int32
    while offset < byteCount:
        let chunk = libc_read(fd, SystemPtrAdd(rawbytes.BytesDataPtr(out), offset), Int64(byteCount - offset))
        if chunk <= Int64(0):
            rawbytes.BytesFree(out)
            let _closeAfterReadFailure: int32 = libc_close(fd)
            return Err[Bytes]("os file range read: short read")
        if chunk > Int64(byteCount - offset):
            rawbytes.BytesFree(out)
            let _closeAfterReadOverflow: int32 = libc_close(fd)
            return Err[Bytes]("os file range read: overflow")
        offset = offset + int32(chunk)
    let closeRc: int32 = libc_close(fd)
    if closeRc != 0:
        rawbytes.BytesFree(out)
        return Err[Bytes]("os file range read: close failed")
    ioMeterReport(ioRead, Int64(byteCount))
    return Ok[Bytes](out)

fn readFilePrefixBytesResult(path: str, maxBytes: int32): Result[Bytes] =
    if strings.Len(path) <= 0:
        return Err[Bytes]("os file prefix read: empty path")
    if maxBytes <= 0:
        return Err[Bytes]("os file prefix read: max bytes")
    let fileLen = fileSize(strings.CloneStr(path))
    if fileLen < Int64(0):
        return Err[Bytes]("os file prefix read: file size")
    var want: int32 = maxBytes
    if fileLen < Int64(maxBytes):
        want = int32(fileLen)
    return readFileRangeBytesResult(strings.CloneStr(path), Int64(0), want)

fn writeFileBytesResult(path: str, bytes: var Bytes): Result[bool] =
    return writeRawFileBytesResult(path, bytes)

