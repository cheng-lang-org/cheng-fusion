@borrows
fn AtomicTreeOpenTerminalCapsuleRoleOwnerInto(
        handle: AtomicTree,
        outRoleOwner: var int32,
        outExitPermission0: var int32,
        outExitPermission1: var int32,
        outExitPermission2: var int32,
        outExitPermission3: var int32,
        outReapPermission0: var int32,
        outReapPermission1: var int32,
        outReapPermission2: var int32,
        outReapPermission3: var int32,
        err: var str): bool =
    outRoleOwner = -1
    outExitPermission0 = 0
    outExitPermission1 = 0
    outExitPermission2 = 0
    outExitPermission3 = 0
    outReapPermission0 = 0
    outReapPermission1 = 0
    outReapPermission2 = 0
    outReapPermission3 = 0
    err = ""
    if handle == uint64(0):
        err = "os atomic tree capsule role owner: invalid tree"
        return false
    let owner =
        cheng_atomic_tree_open_terminal_capsule_role_owner_bridge(
            handle,
            outExitPermission0,
            outExitPermission1,
            outExitPermission2,
            outExitPermission3,
            outReapPermission0,
            outReapPermission1,
            outReapPermission2,
            outReapPermission3,
            err)
    if owner <= -2:
        outRoleOwner = 0 - owner - 1
        outExitPermission0 = 0
        outExitPermission1 = 0
        outExitPermission2 = 0
        outExitPermission3 = 0
        outReapPermission0 = 0
        outReapPermission1 = 0
        outReapPermission2 = 0
        outReapPermission3 = 0
        return false
    if owner <= 0:
        outExitPermission0 = 0
        outExitPermission1 = 0
        outExitPermission2 = 0
        outExitPermission3 = 0
        outReapPermission0 = 0
        outReapPermission1 = 0
        outReapPermission2 = 0
        outReapPermission3 = 0
        return false
    outRoleOwner = owner
    return true

fn AtomicTreeTerminalCapsuleRoleOwnerAbort(owner: int32): bool =
    return owner > 0 &&
        cheng_atomic_tree_terminal_capsule_role_owner_abort_bridge(owner) == 1

@borrows
fn AtomicTreeTerminalRecoveryLockOwnerAcquireInto(
        handle: AtomicTree,
        outOwner: var int32,
        err: var str): bool =
    outOwner = -1
    err = ""
    if handle == uint64(0):
        err = "os atomic tree terminal recovery lock: invalid tree"
        return false
    let owner =
        cheng_atomic_tree_terminal_recovery_lock_owner_acquire_bridge(
            handle, err)
    if owner <= 0:
        return false
    outOwner = owner
    return true

fn AtomicTreeTerminalRecoveryLockOwnerRelease(owner: int32): bool =
    return owner > 0 &&
        cheng_atomic_tree_terminal_recovery_lock_owner_release_bridge(owner) ==
            1

@borrows
fn AtomicTreeTerminalSessionLiveLockOwnerAcquirePreparedInto(
        handle: AtomicTree,
        outOwner: var int32,
        err: var str): bool =
    outOwner = -1
    err = ""
    if handle == uint64(0):
        err = "os atomic tree terminal live lock: invalid transaction"
        return false
    let owner =
        cheng_atomic_tree_terminal_session_live_lock_owner_acquire_prepared_bridge(
            handle, err)
    if owner <= 0:
        return false
    outOwner = owner
    return true

@borrows
fn AtomicTreeTerminalSessionLiveLockOwnerTryAcquireInto(
        handle: AtomicTree,
        outOwner: var int32,
        outBusy: var bool,
        err: var str): bool =
    outOwner = -1
    outBusy = false
    err = ""
    if handle == uint64(0):
        err = "os atomic tree terminal live lock: invalid root"
        return false
    var busy: int32
    let owner =
        cheng_atomic_tree_terminal_session_live_lock_owner_try_acquire_bridge(
            handle, busy, err)
    if owner > 0:
        outOwner = owner
        return true
    if owner == 0 && busy == 1 && err.len == 0:
        outBusy = true
        return true
    return false

fn AtomicTreeTerminalSessionLiveLockOwnerRelease(owner: int32): bool =
    return owner > 0 &&
        cheng_atomic_tree_terminal_session_live_lock_owner_release_bridge(
            owner) == 1

@borrows
fn AtomicTreeOpenTerminalFinishedRecoveryOwnerInto(
        handle: AtomicTree,
        childPid: int32,
        childBirthPlatform: int32,
        childBirth0: uint64,
        childBirth1: uint64,
        outRecoveryOwner: var int32,
        err: var str): bool =
    outRecoveryOwner = -1
    err = ""
    if handle == uint64(0):
        err = "os atomic tree finished recovery: invalid tree"
        return false
    let owner =
        cheng_atomic_tree_open_terminal_finished_recovery_owner_bridge(
            handle,
            childPid,
            childBirthPlatform,
            childBirth0,
            childBirth1,
            err)
    if owner <= 0:
        return false
    outRecoveryOwner = owner
    return true

