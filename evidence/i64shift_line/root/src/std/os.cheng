fn readOnlyMappedRegionReadWindowResult(
        handle: ReadOnlyMappedRegion,
        offset: int64,
        length: int32): Result[Bytes] =
    var outData: uint64
    var outLength: int32
    var err: str
    let rc = cheng_read_only_mapped_region_read_window_bridge(
        handle, offset, length, outData, outLength, err)
    if rc == 0:
        return Err[Bytes](atomicTreeErrorOr(
            err,
            "os read only mapped region read window: failed"))
    var out: Bytes
    out.data = ptr(outData)
    out.len = outLength
    if out.data == nil || out.len != length || out.len <= 0:
        if out.data != nil:
            rawbytes.BytesFree(out)
        return Err[Bytes](
            "os read only mapped region read window: invalid bridge length")
    return Ok[Bytes](out)

