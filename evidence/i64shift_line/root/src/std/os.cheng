fn atomicTreeCommitNoReplaceResult(
        handle: AtomicTree): Result[AtomicTreeCommitKind] =
    var err: str
    let rc = cheng_atomic_tree_commit_noreplace_bridge(handle, err)
    if rc == 1:
        return Ok[AtomicTreeCommitKind](AtomicTreeCommitted)
    if rc == 2:
        return Ok[AtomicTreeCommitKind](AtomicTreeDestinationExists)
    if rc == 3:
        return Ok[AtomicTreeCommitKind](AtomicTreeCommittedDurabilityUnknown)
    return Err[AtomicTreeCommitKind](atomicTreeErrorOr(
        err,
        "os atomic tree commit: failed"))

