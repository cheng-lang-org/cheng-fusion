        cheng_atomic_tree_open_verified_exclusive_or_absent_bridge(
            parentPath,
            finalName,
            kindCode,
            err)
    if handle == uint64(0):
        return Err[AtomicTreeExclusiveOpenResult](
            atomicTreeErrorOr(
                err,
                "os atomic tree exclusive open: failed"))
    var out: AtomicTreeExclusiveOpenResult
    out.tree = handle
    if kindCode == 1:
        out.kind = AtomicTreeExclusiveOpened
    elif kindCode == 2:
        out.kind = AtomicTreeExclusiveAbsent
    else:
        var closeErr: str
        let _ = cheng_atomic_tree_close_bridge(handle, closeErr)
        return Err[AtomicTreeExclusiveOpenResult](
            "os atomic tree exclusive open: invalid result kind")
    return Ok[AtomicTreeExclusiveOpenResult](out)

