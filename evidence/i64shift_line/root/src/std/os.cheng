# Anonymous held file pinned to the directory behind dirFd.  Linux uses
# O_TMPFILE; Darwin uses the create-exclusive + unlink-before-return
# equivalent inside the provider.  Returns the fd or -1 (fail-closed, no
# named-temporary-file fallback).
@borrows
fn ProcessRegistryAnonTmpFile(dirFd: int32): int32 =
    if dirFd < 0:
        return -1
    return osAnonTmpFileRaw(dirFd)

# Fixed descriptor-vector contract. The production three-role form is
# bundle / FINISHED writer inode / DECISION reader inode.
@borrows
fn ProcessRegistrySendFdVector(
        socketFd: int32,
        payload: rawbytes.Bytes,
        fd0: int32,
        fd1: int32,
        fdCount: int32): int32 =
    let payloadLen = rawbytes.BytesLen(payload)
    let payloadData = rawbytes.BytesDataPtr(payload)
    if payloadLen <= 0 || payloadData == nil:
        return -1
    return osSendFdVectorRaw(
        socketFd, payloadData, payloadLen, fd0, fd1, -1, fdCount)

