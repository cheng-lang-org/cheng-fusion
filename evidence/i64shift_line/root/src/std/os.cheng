@importc("cheng_getcwd")
fn cheng_getcwd_raw(): cstring
@importc("cheng_host_getenv")
fn cheng_host_getenv_raw(name: cstring): cstring
fn c_getenv(name: cstring): cstring =
    return cheng_host_getenv_raw(name)
@borrows
fn getEnv(key: str): str =
    let raw: cstring = c_getenv(StrToCStringTemp(key))
    if raw == nil:
        return strings.stringsEmpty()
    let n: int32 = os_cstrlen(raw)
    if n <= 0:
        return strings.stringsEmpty()
    return strings.NewStringFromCString(raw, n)
@borrows
fn getEnvDefault(key: str, defaultValue: str): str =
    let value = getEnv(key)
    if Len(value) <= 0:
        return strings.CloneStr(defaultValue)
    return value
importc fn setenv(name: cstring, value: cstring, overwrite: int32): int32
