@importc("cheng_host_darwin_send_fd_runtime")
fn osDarwinSendFdRaw(
    socketFd: int32,
    payload: ptr,
    payloadBytes: int32,
    passedFd: int32): int32

@importc("cheng_host_darwin_recv_optional_fd_runtime")
fn osDarwinRecvOptionalFdRaw(
    socketFd: int32,
    payload: ptr,
    payloadBytes: int32,
    outFd: var int32): int32

@borrows
fn ProcessRegistrySendFd(
        socketFd: int32,
        payload: rawbytes.Bytes,
        passedFd: int32): int32 =
    let payloadLen = rawbytes.BytesLen(payload)
    let payloadData = rawbytes.BytesDataPtr(payload)
    if payloadLen <= 0 || payloadData == nil:
        return -1
    return osDarwinSendFdRaw(
        socketFd, payloadData, payloadLen, passedFd)

@borrows
fn ProcessRegistryRecvOptionalFd(
        socketFd: int32,
        payload: rawbytes.Bytes,
        outFd: var int32): int32 =
    outFd = -1
    let payloadLen = rawbytes.BytesLen(payload)
    let payloadData = rawbytes.BytesDataPtr(payload)
    if payloadLen <= 0 || payloadData == nil:
        return -1
    return osDarwinRecvOptionalFdRaw(
        socketFd, payloadData, payloadLen, outFd)

@importc("cheng_host_socketpair_runtime")
fn osSocketpairRaw(
    domain: int32,
    socketType: int32,
    protocol: int32,
    fds: var int32[2]): int32

@borrows
fn ProcessRegistrySocketpair(
        domain: int32,
        socketType: int32,
        protocol: int32,
        outFd0: var int32,
        outFd1: var int32): bool =
    outFd0 = -1
    outFd1 = -1
    var fds: int32[2]
    fds[0] = -1
    fds[1] = -1
    if osSocketpairRaw(
           domain, socketType, protocol, fds) != 0:
        return false
    if fds[0] < 0 || fds[1] < 0 || fds[0] == fds[1]:
        if fds[0] >= 0:
            let _close0 = libc_close(fds[0])
        if fds[1] >= 0:
            let _close1 = libc_close(fds[1])
        return false
    outFd0 = fds[0]
    outFd1 = fds[1]
    return true

@importc("cheng_host_getsockopt_runtime")
fn osGetsockoptRaw(
    fd: int32,
    level: int32,
    optionName: int32,
    optionValue: var int32,
    optionLength: var int32): int32

@borrows
fn ProcessRegistryDarwinPeerIdentity(
        socketFd: int32,
        outPeerPid: var int32,
        outPeerEpid: var int32): bool =
    outPeerPid = -1
    outPeerEpid = -1
    var pidValue: int32 = -1
    var pidLength: int32 = 4
    if osGetsockoptRaw(
           socketFd, 0, 2, pidValue, pidLength) != 0 ||
       pidLength != 4 || pidValue <= 0:
        return false
    var epidValue: int32 = -1
    var epidLength: int32 = 4
    if osGetsockoptRaw(
           socketFd, 0, 3, epidValue, epidLength) != 0 ||
       epidLength != 4 || epidValue <= 0:
        return false
    outPeerPid = pidValue
    outPeerEpid = epidValue
    return true

@borrows
fn ProcessRegistryCloseFd(fd: int32): int32 =
    return libc_close(fd)

@abi_internal
@importc("cheng_file_handle_open_read_fd_bridge")
fn osOpenReadOnlyFdRaw(path: str, outErr: var str): int32

@borrows
fn ProcessRegistryOpenReadOnlyFd(
        path: str,
        outFd: var int32,
        err: var str): bool =
    outFd = -1
    err = ""
    if path.len <= 0:
        err = "os file open: empty path"
        return false
    let pathOwned: str = strings.CloneStr(path)
    let fd = osOpenReadOnlyFdRaw(pathOwned, err)
    if fd < 0:
        return false
    outFd = fd
    return true

