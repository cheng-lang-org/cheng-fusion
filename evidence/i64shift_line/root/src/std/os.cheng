@importc("cheng_mem_release")
fn os_mem_release(p: ptr)

@importc("cheng_memory_pressure_relief")
fn os_memory_pressure_relief(): int64

fn add(dst: var str[], val: str) =
    seqs.Add(dst, val)

fn osReturnStrSeq(out: str[]): str[] =
    return out

fn osSetEmpty(out: var str) =
    out.data = nil
    out.len = 0
    out.store_id = 0
    out.flags = 0

@borrows
fn osSetStr(out: var str, value: str) =
    out.data = value.data
    out.len = value.len
    out.store_id = value.store_id
    out.flags = value.flags

fn osReleaseStr(out: var str) =
    if out.flags == 1 && out.data != nil:
        os_mem_release(out.data)
    osSetEmpty(out)

fn ReleaseStr(out: var str) =
    osReleaseStr(out)

fn ProcessMemoryPressureRelief(): int64 =
    return os_memory_pressure_relief()

fn osMoveStr(out: var str, value: var str) =
    if out.data != value.data:
        osReleaseStr(out)
    out.data = value.data
    out.len = value.len
    out.store_id = value.store_id
    out.flags = value.flags
    value.data = nil
    value.len = 0
    value.store_id = 0
    value.flags = 0

type
    File = ptr

type
    OsTimeval =
        tv_sec: int64
        tv_usec: int64

    # Darwin rusage_info_v0 (sys/resource.h), flat int64 mirror: ri_uuid[16] is modelled as
    # two int64 words so no embedded array participates in field-offset codegen. Kernel
    # copyout for flavor RUSAGE_INFO_V0 writes exactly these 96 bytes.
    OsRusageInfoV0 =
        ri_uuid_lo: int64
        ri_uuid_hi: int64
        ri_user_time: int64
        ri_system_time: int64
        ri_pkg_idle_wkups: int64
        ri_interrupt_wkups: int64
        ri_pageins: int64
        ri_wired_size: int64
        ri_resident_size: int64
        ri_phys_footprint: int64
        ri_proc_start_abstime: int64
        ri_proc_exit_abstime: int64

    OsRusage =
        ru_utime: OsTimeval
        ru_stime: OsTimeval
        ru_maxrss: int64
        ru_ixrss: int64
        ru_idrss: int64
        ru_isrss: int64
        ru_minflt: int64
        ru_majflt: int64
        ru_nswap: int64
        ru_inblock: int64
        ru_oublock: int64
        ru_msgsnd: int64
        ru_msgrcv: int64
        ru_nsignals: int64
        ru_nvcsw: int64
        ru_nivcsw: int64

    # Linux struct utsname (sys/utsname.h): six 65-byte fields, flat byte mirror
    # (sysname at offset 0, nodename 65, release 130, version 195, machine 260,
    # domainname 325). Only reachable from linux-target closures.
    OsUtsname =
        data: uint8[390]

type
    FileMode = enum
        fmRead
        fmWrite
        fmReadWrite

type
    FileHandle = uint64

type
    AtomicTree = uint64

type
    AtomicTreeExclusiveOpenKind = enum
        AtomicTreeExclusiveOpened
        AtomicTreeExclusiveAbsent

type
    AtomicTreeExclusiveOpenResult =
        kind: AtomicTreeExclusiveOpenKind
        tree: AtomicTree

type
    ReadOnlyMappedRegion = uint64

type
    PersistentUserDataRoot =
        ok: bool
        error: str
        platform: str
        effectiveUid: int64
        rootPath: str

type
    AtomicTreeCommitKind = enum
        AtomicTreeCommitted
        AtomicTreeDestinationExists
        AtomicTreeCommittedDurabilityUnknown

type
    FileOpenMode = enum
        Read
        WriteTruncate
        ReadWrite
        Append

type
    IoMeterOp = enum
        ioRead
        ioWrite

type
    IoMeterHook = fn (op: IoMeterOp, bytes: int64)

var
    ioMeterHasHook: bool = false
    ioMeterHook: IoMeterHook = nil

const osOpenWriteOnly: int32 = 0x0001
const osOpenReadOnly: int32 = 0
const osOpenCreate: int32 = 0x0200
const osOpenTrunc: int32 = 0x0400
const osFileMode0644: int32 = 420
const osSeekSet: int32 = 0
