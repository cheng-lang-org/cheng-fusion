@borrows
fn atomicTreeReadStableResult(handle: AtomicTree,
                              relativePath: str): Result[Bytes] =
    var text: str
    var err: str
    let rc = cheng_atomic_tree_read_stable_bridge(handle,
                                                   relativePath,
                                                   text,
                                                   err)
    if rc == 0:
        return Err[Bytes](atomicTreeErrorOr(err,
                                            "os atomic tree read: failed"))
    let view = rawbytes.BytesFromString(text)
    let count = rawbytes.BytesLen(view)
    if count <= 0:
        return Ok[Bytes](rawbytes.EmptyBytes())
    let out = rawbytes.BytesAlloc(count)
    if rawbytes.BytesDataPtr(out) == nil:
        return Err[Bytes]("os atomic tree read: alloc failed")
    rawbytes.BytesCopyInto(out, 0, view)
    return Ok[Bytes](out)

fn atomicTreeExpectedWireAppendU32(buf: var buffer.GrowByteBuffer,
                                   value: int32) =
    buffer.AppendByte(buf, value & 255)
    buffer.AppendByte(buf, (value >> 8) & 255)
    buffer.AppendByte(buf, (value >> 16) & 255)
    buffer.AppendByte(buf, (value >> 24) & 255)

@borrows
fn atomicTreeExpectedWireResult(items: str[]): Result[str] =
    let headerBytes = (Int64(items.len) + Int64(2)) * Int64(4)
    if headerBytes < Int64(8) || headerBytes > Int64(268435456):
        return Err[str]("os atomic tree exact verify: expected set header overflow")
    var payloadBytes: int64
    for itemIndex in 0..<items.len:
        let itemLen = strings.Len(items[itemIndex])
        if itemLen < 0 ||
           payloadBytes > Int64(268435456) - Int64(itemLen):
            return Err[str]("os atomic tree exact verify: expected set payload overflow")
        payloadBytes = payloadBytes + Int64(itemLen)
    if payloadBytes > Int64(268435456) - headerBytes:
        return Err[str]("os atomic tree exact verify: expected set wire overflow")
    var wireBuffer = buffer.NewByteBuffer()
    atomicTreeExpectedWireAppendU32(wireBuffer, items.len)
    var payloadOffset: int32
    for itemIndex in 0..<items.len:
        atomicTreeExpectedWireAppendU32(wireBuffer, payloadOffset)
        payloadOffset = payloadOffset + strings.Len(items[itemIndex])
    atomicTreeExpectedWireAppendU32(wireBuffer, payloadOffset)
    for itemIndex in 0..<items.len:
        buffer.AppendText(wireBuffer, items[itemIndex])
    return Ok[str](buffer.FinishString(wireBuffer))

@borrows
fn atomicTreeVerifyExactResult(handle: AtomicTree,
                               expectedDirs: str[],
                               expectedFiles: str[]): Result[bool] =
    let expectedDirsWireRes = atomicTreeExpectedWireResult(expectedDirs)
    if IsErr(expectedDirsWireRes):
        return Err[bool](Error(expectedDirsWireRes))
    let expectedFilesWireRes = atomicTreeExpectedWireResult(expectedFiles)
    if IsErr(expectedFilesWireRes):
        return Err[bool](Error(expectedFilesWireRes))
    let expectedDirsWire = Value(expectedDirsWireRes)
    let expectedFilesWire = Value(expectedFilesWireRes)
    var err: str
    let rc = cheng_atomic_tree_verify_exact_bridge(handle,
                                                    expectedDirsWire,
                                                    expectedFilesWire,
                                                    err)
    return atomicTreeBoolResult(rc,
                                err,
                                "os atomic tree exact verify: failed")

