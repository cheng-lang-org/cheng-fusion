fn udpErrno(): int32 =
    return cheng_errno()

fn udpErrText(errCode: int32): str =
    let textPtr: cstring = cheng_strerror(errCode)
    if textPtr == nil:
        return "unknown"
    # Owned copy: returning the borrow variant as an owned str fails the
    # exact return check (and copying the static strerror buffer is safer).
    return strFromCStringCopy(textPtr)

fn udpCloseFd(fd: int32): int32 =
    return libc_close(fd)

fn udpOpenSocket(domain: int32, typ: int32, protocol: int32): int32 =
    return libc_socket(domain, typ, protocol)

fn udpFcntl(fd: int32, cmd: int32, arg: int32): int32 =
    return libc_fcntl(fd, cmd, arg)

@borrows
fn udpInetPton(family: int32, src: str, dst: Bytes): int32 =
    if strings.Len(src) <= 0 || rawbytes.BytesLen(dst) <= 0:
        return 0
    return libc_inet_pton(family, StrToCStringTemp(src), dst.data)

@borrows
fn udpInetNtop(family: int32, src: Bytes): str =
    if rawbytes.BytesLen(src) <= 0:
        return ""
    let outBuf: Bytes = rawbytes.BytesAlloc(128)
    if rawbytes.BytesLen(outBuf) <= 0:
        return ""
    rawbytes.BytesSet(outBuf, 0, 0)
    let textPtr: ptr = libc_inet_ntop(family, src.data, outBuf.data, rawbytes.BytesLen(outBuf))
    if textPtr == nil:
        return ""
    return strFromCStringCopy(cstring(textPtr))

@borrows
fn udpBindFd(fd: int32, addr: Bytes, addrLen: int32): int32 =
    if fd < 0 || addrLen <= 0:
        return -1
    return libc_bind(fd, addr.data, addrLen)

fn tcpListenFd(fd: int32, backlog: int32): int32 =
    if fd < 0:
        return -1
    return libc_listen(fd, backlog)

@borrows
fn tcpConnectFd(fd: int32, addr: Bytes, addrLen: int32): int32 =
    if fd < 0 || addrLen <= 0:
        return -1
    return libc_connect(fd, addr.data, addrLen)

fn tcpAcceptFd(fd: int32, addr: Bytes, addrLen: var int32): int32 =
    if fd < 0:
        addrLen = 0
        return -1
    if rawbytes.BytesLen(addr) <= 0:
        addrLen = 0
        return libc_accept(fd, nil, addrLen)
    addrLen = rawbytes.BytesLen(addr)
    return libc_accept(fd, addr.data, addrLen)

fn tcpAcceptFdNoAddr(fd: int32): int32 =
    if fd < 0:
        return -1
    return libc_accept_noaddr(fd, nil, nil)

fn tcpSendFd(fd: int32, payload: Bytes, flags: int32): int32 =
    if fd < 0 || rawbytes.BytesLen(payload) <= 0:
        return -1
    return libc_send(fd, payload.data, rawbytes.BytesLen(payload), flags)

fn tcpRecvFd(fd: int32, payload: Bytes, flags: int32): int32 =
    if fd < 0 || rawbytes.BytesLen(payload) <= 0:
        return -1
    if flags == 0:
        return Int32(libc_read(fd, payload.data, Int64(rawbytes.BytesLen(payload))))
    return libc_recv(fd, payload.data, rawbytes.BytesLen(payload), flags)

fn tcpShutdownFd(fd: int32, how: int32): int32 =
    if fd < 0:
        return -1
    return libc_shutdown(fd, how)

@borrows
fn udpSendToFd(fd: int32, payload: Bytes, flags: int32, addr: Bytes, addrLen: int32): int32 =
    if fd < 0 || addrLen <= 0 || rawbytes.BytesLen(payload) <= 0:
        return -1
    return libc_sendto(fd, payload.data, rawbytes.BytesLen(payload), flags, addr.data, addrLen)

fn udpRecvFromFd(fd: int32, payload: Bytes, flags: int32): int32 =
    if fd < 0 || rawbytes.BytesLen(payload) <= 0:
        return -1
    var rawLen: int32
    return libc_recvfrom(fd, payload.data, rawbytes.BytesLen(payload), flags, nil, rawLen)

fn udpRecvFromFdEx(fd: int32, payload: Bytes, flags: int32, outErr: var int32): int32 =
    outErr = 0
    if fd < 0 || rawbytes.BytesLen(payload) <= 0:
        return -1
    return cheng_recvfrom_fd_ex(fd, payload.data, rawbytes.BytesLen(payload), flags, nil, nil, outErr)

fn udpRecvFromFdAddrEx(fd: int32, payload: Bytes, flags: int32, outAddr: Bytes, outAddrLen: var int32, outErr: var int32): int32 =
    let payloadLen: int32 = rawbytes.BytesLen(payload)
    let addrCap: int32 = rawbytes.BytesLen(outAddr)
    outErr = 0
    if fd < 0 || payloadLen <= 0 || addrCap <= 0:
        outAddrLen = 0
        return -1
    outAddrLen = addrCap
    let payloadPtr: ptr = payload.data
    let addrPtr: ptr = outAddr.data
    return cheng_udp_recvfrom_addr_bridge(fd, payloadPtr, payloadLen, flags, addrPtr, addrCap, outAddrLen, outErr)

@borrows
fn udpSetSockOptIntFd(fd: int32, level: int32, optName: int32, optBytes: Bytes): int32 =
    if fd < 0 || rawbytes.BytesLen(optBytes) <= 0:
        return -1
    return libc_setsockopt(fd, level, optName, optBytes.data, rawbytes.BytesLen(optBytes))

# Fills through the data pointer; does not consume the struct.
@borrows
fn udpGetSockNameFd(fd: int32, addr: Bytes, addrLen: var int32): int32 =
    if fd < 0 || rawbytes.BytesLen(addr) <= 0:
        addrLen = 0
        return -1
    addrLen = rawbytes.BytesLen(addr)
    return libc_getsockname(fd, addr.data, addrLen)

fn udpBindHostPortBridge(host: str, port: int32, isV6: int32, outFd: var int32, outPort: var int32, outFamily: var int32, outUseLenField: var int32): int32 =
    return cheng_udp_bind_host_port_bridge(host, port, isV6, outFd, outPort, outFamily, outUseLenField)

@borrows
fn udpBindFdBridge(host: str, port: int32, isV6: int32): int32 =
    return cheng_udp_bind_fd_bridge(host, port, isV6)

fn udpBoundPortBridge(fd: int32, isV6: int32): int32 =
    return cheng_udp_bound_port_bridge(fd, isV6)

fn udpPlatformUseLenFieldBridge(): int32 =
    return cheng_udp_platform_use_len_field_bridge()

fn udpPlatformMsgDontWaitBridge(): int32 =
    return cheng_udp_platform_msg_dontwait_bridge()

fn fdWaitReadable(fd: int32, timeoutMs: int32): int32 =
    return cheng_fd_wait_readable_bridge(fd, timeoutMs)

fn UdpFdWaitReadable(fd: int32, timeoutMs: int32): int32 =
    return fdWaitReadable(fd, timeoutMs)

fn fdWaitWritable(fd: int32, timeoutMs: int32): int32 =
    return cheng_fd_wait_writable_bridge(fd, timeoutMs)

fn openImplRead(filename: str): File =
    return cheng_os_fopen_mode_bridge(filename, "rb")

@borrows
fn openImplWrite(filename: str): File =
    return cheng_os_fopen_mode_bridge(strings.CloneStr(filename), "wb")

fn openImplReadWrite(filename: str): File =
    return cheng_os_fopen_mode_bridge(filename, "rb+")

fn setIoMeterHook(hook: IoMeterHook) =
    if hook == nil:
        ioMeterHasHook = false
    else:
        ioMeterHasHook = true
    ioMeterHook = hook

fn clearIoMeterHook() =
    ioMeterHasHook = false
    ioMeterHook = nil

# NOTE(2026-08-24 gapup_dist_opt unblock): 全仓库无 SetIoMeterHook 注册者，
# 原 guard 读可变全局标量触发 cold 校验 global-scalar-root 拒绝。
# 语义等价空实现（c_iometer_call 本身即 system_helpers 提供的 no-op stub）。
fn ioMeterReport(op: IoMeterOp, bytes: int64) =
    op
    bytes
    return

fn openImpl(filename: str, mode: FileMode): File =
    if mode == fmRead:
        return openImplRead(filename)
    if mode == fmWrite:
        return openImplWrite(filename)
    return openImplReadWrite(filename)

fn openRead(filename: str): File =
    return openImplRead(filename)

fn open(filename: str, mode: FileMode): File =
    if mode == fmRead:
        return openImplRead(filename)
    if mode == fmWrite:
        return openImplWrite(filename)
    return openImplReadWrite(filename)

fn close(f: File): void =
    let _rc: int32 = c_fclose(f)

fn osDebugFileReadEnabled(): bool =
    return getEnvDefault("BACKEND_DEBUG_FILE_READ", "") == "1"

fn osDebugFileRead(msg: str): void =
    if osDebugFileReadEnabled():
        let f: File = get_stderr()
        osWriteText(f, "[os.Read] ")
        osWriteLineText(f, msg)

fn osDebugFileReadKV(label: str, value: int32): void =
    if osDebugFileReadEnabled():
        let f: File = get_stderr()
        osWriteText(f, "[os.Read] ")
        osWriteText(f, label)
        osWriteText(f, "=")
        osWriteLineText(f, strings.IntToStr(value))

fn readAllInto(f: File, out: var str): bool =
    if f == nil:
        osSetEmpty(out)
        return true
    var outBuf: buffer.GrowByteBuffer = buffer.NewByteBuffer()
    while true:
        let chunk: Bytes = rawbytes.BytesAlloc(256)
        let room: int32 = rawbytes.BytesLen(chunk)
        let got: int32 = c_fread(chunk.data, 1, room, f)
        osDebugFileReadKV("chunk.got", got)
        osDebugFileReadKV("chunk.room", room)
        osDebugFileReadKV("chunk.len_before", buffer.ByteBufferLen(outBuf))
        if got <= 0:
            break
        if got >= room:
            buffer.AppendBytes(outBuf, chunk)
        else:
            buffer.AppendBytes(outBuf, BytesSlice(chunk, 0, got))
        ioMeterReport(ioRead, Int64(got))
    var outText: str = rawbytes.BytesToString(buffer.ToBytes(outBuf))
    let finalLen: int32 = strings.Len(outText)
    osDebugFileReadKV("final.lenRead", finalLen)
    osDebugFileReadKV("final.outLen", strings.Len(outText))
    osMoveStr(out, outText)
    return true

fn readAll(f: File): str =
    var out: str
    osSetEmpty(out)
    let _ok: bool = readAllInto(f, out)
    return out

@borrows
fn osWriteText(f: File, s: str) =
    osWriteAllRaw(f, StrDataPtr(s), strings.Len(s), "write")

@borrows
fn osWriteLineText(f: File, s: str) =
    osWriteText(f, s)
    osWriteText(f, "\n")

type
    SplitFileResult =
        dir: str
        name: str
        ext: str
type
    PathComponent = enum
        pcFile, pcDir, pcLinkToFile, pcLinkToDir, pcOther
type
    WalkDirEntry = str
type
    ProcessOption = enum
        poStdErrToStdOut, poUsePath, poEvalCommand
type
    ExecCmdResult = ref object
        output: str
        exitCode: int32
type
    ExecFilePipeSpawnResult =
        ok: bool
        readFd: int32
        writeFd: int32
        pid: int64
type
    PtySpawnResult =
        ok: bool
        masterFd: int32
        pid: int64
type
    PipeSpawnResult =
        ok: bool
        readFd: int32
        writeFd: int32
        pid: int64
type
    TextReadResult =
        text: str
        eof: bool
type
    PtyWaitResult =
        waitStatus: int32
        exitCode: int32
type
    seq_WalkDirEntry = WalkDirEntry[]
fn os_newSeq_WalkDirEntry(len: int32, cap: int32): str[] =
    var out: str[]
    if cap > 0:
        seqs.Reserve(out, cap)
    if len > 0:
        seqs.SetLen(out, len)
    return out
@borrows
fn os_get_WalkDirEntry(seqInst: str[], i: int32): WalkDirEntry =
    return strings.ConcatStr(seqInst[i], "")
@borrows
fn walkDirEntryKind(entry: str): PathComponent =
    if strings.Len(entry) <= 0:
        return pcOther
    let code: char = entry[0]
    if code == '0':
        return pcFile
    if code == '1':
        return pcDir
    if code == '2':
        return pcLinkToFile
    if code == '3':
        return pcLinkToDir
    return pcOther
@borrows
fn walkDirEntryPath(entry: str): str =
    if strings.Len(entry) < 2:
        return ""
    if entry[1] != '|':
        return ""
    return strings.CloneStrRange(entry, 2, strings.Len(entry) - 2)

fn splitFileResult(dir: str, name: str, ext: str): SplitFileResult =
    var out: SplitFileResult
    out.dir = dir
    out.name = name
    out.ext = ext
    return out

fn pathComponentDir(): PathComponent =
    return pcDir
fn os_addPtr_WalkDirEntry(seqInst: var str[], val: WalkDirEntry) =
    add(seqInst, val)

@borrows
fn fileExists(path: str): bool =
    return cheng_os_file_exists_bridge(path) != 0
fn dirExists(path: str): bool =
    return cheng_os_dir_exists_bridge(path) != 0
fn createDir(path: str) =
    let _ = cheng_os_mkdir_bridge(path)
fn bos_dirExists(path: str): bool =
    return dirExists(path)
fn makeDir(path: str): bool =
    return cheng_os_mkdir_bridge(path) == 0
fn fileMtime(path: str): int64 =
    return cheng_file_mtime(StrToCStringTemp(path))
fn fileSize(path: str): int64 =
    return cheng_os_file_size_bridge(path)
fn getCurrentDir(): str =
    let raw: cstring = cheng_getcwd_raw()
    let n: int32 = os_cstrlen(raw)
    if raw == nil || n <= 0:
        return ""
    return strings.NewStringFromCString(raw, n)
fn removeFile(path: str): bool =
    if ! fileExists(path):
        return false
    return cheng_os_remove_file_bridge(path) == 0
fn renameFile(oldPath: str, newPath: str): bool =
    if ! fileExists(strings.CloneStr(oldPath)):
        return false
    return cheng_os_rename_bridge(strings.CloneStr(oldPath), strings.CloneStr(newPath)) == 0
fn renamePath(oldPath: str, newPath: str): bool =
    if !fileExists(strings.CloneStr(oldPath)) && !dirExists(strings.CloneStr(oldPath)):
        return false
    return cheng_os_rename_bridge(strings.CloneStr(oldPath), strings.CloneStr(newPath)) == 0
fn removeDir(path: str) =
    if strings.Len(path) > 0:
        let _ = cheng_os_remove_dir_bridge(path)
fn setEnv(key: str, value: str) =
    let _ = setenv(StrToCStringTemp(key), StrToCStringTemp(value), 1)
fn commandLineParams(): str[] =
    # cmdline module now loads argv from runtime bridge lazily.
    let count: int32 = cmdline.ParamCount()
    var out: str[]
    if count > 0:
        setLen(out, count)
        for i in 1..count:
            out[i - 1] = cmdline.ParamStr(i)
    let result = osReturnStrSeq(out)
    return result
fn quoteShell(value: str): str =
    if Len(value) == 0:
        return "''"
    var out: str = "'"
    for i in 0..<Len(value):
        let part = strings.CloneStrRange(value, i, 1)
        if part == "'":
            out = strings.ConcatStr(out, "'\"'\"'")
        else:
            out = strings.ConcatStr(out, part)
    out = strings.ConcatStr(out, "'")
    return out

@borrows
fn joinPath(a: str, b: str): str =
    if strings.Len(a) == 0:
        return b
    if a[0] == Char(0):
        return b
    if strings.Len(b) == 0:
        return a
    if b[0] == Char(0):
        return a
    let aLen: int32 = strings.Len(a)
    let last: char = a[aLen - 1]
    var hasSep: bool
    if last == '/':
        hasSep = true
    if last == '\\':
        hasSep = true
    var result: str
    if !hasSep:
        result = strings.ConcatStr(strings.ConcatStr(a, "/"), b)
    else:
        result = strings.ConcatStr(a, b)
    # Reject path traversal: "../" segments and trailing ".."
    if StrContains(result, "/../") || strings.HasSuffix(result, "/.."):
        return ""
    return result
fn `/`(a: str, b: str): str =
    return joinPath(a, b)

@borrows
fn osSliceStr(text: str, start: int32, stop: int32): str =
    if strings.Len(text) == 0:
        return ""
    var s: int32 = start
    var e: int32 = stop
    if s < 0:
        s = 0
    let n: int32 = strings.Len(text)
    if e < s || s >= n:
        return ""
    if e >= n:
        e = n - 1
    let count: int32 = e - s + 1
    return strings.CloneStrRange(text, s, count)
@borrows
fn absolutePath(path: str): str =
    if strings.Len(path) == 0 || path[0] == Char(0):
        return getCurrentDir()
    let c0: char = path[0]
    if c0 == '/' || c0 == '\\':
        return path
    if strings.Len(path) > 1 && path[1] == ':':
        return path
    return joinPath(getCurrentDir(), path)
@borrows
fn isAbsolute(path: str): bool =
    if strings.Len(path) == 0 || path[0] == Char(0):
        return false
    let c0: char = path[0]
    if c0 == '/' || c0 == '\\':
        return true
    if strings.Len(path) > 1 && path[1] == ':':
        return true
    return false
@borrows
fn parentDir(path: str): str =
    let n: int32 = strings.Len(path)
    if n <= 0:
        return ""
    var lastSep: int32 = -1
    for i in 0..<n:
        let ch: char = path[i]
        if ch == '/' || ch == '\\':
            lastSep = i
    if lastSep <= 0:
        return ""
    return osSliceStr(path, 0, lastSep - 1)
@borrows
fn relativePath(path: str, base: str): str =
    if strings.Len(base) == 0 || base[0] == Char(0):
        return path
    let baseLen: int32 = strings.Len(base)
    let pathLen: int32 = strings.Len(path)
    if pathLen >= baseLen && osSliceStr(path, 0, baseLen - 1) == base:
        var idx: int32 = baseLen
        if idx < pathLen && (path[idx] == '/' || path[idx] == '\\'):
            idx = idx + 1
        if idx <= pathLen:
            return osSliceStr(path, idx, pathLen - 1)
    return path
@borrows
fn splitFile(path: str): SplitFileResult =
    let pathLen: int32 = strings.Len(path)
    if pathLen == 0:
        return splitFileResult("", "", "")
    var lastSep: int32 = -1
    for i in 0..<pathLen:
        let ch: char = path[i]
        if ch == '/' || ch == '\\':
            lastSep = i
    var lastDot: int32 = -1
    let nameStart: int32 = lastSep + 1
    if nameStart < pathLen:
        let revStart: int32 = pathLen - 1
        var revOffset: int32
        var scanDot = true
        while revOffset <= revStart - nameStart && scanDot:
            let idx: int32 = revStart - revOffset
            let ch: char = path[idx]
            if ch == '.':
                lastDot = idx
                scanDot = false
            revOffset = revOffset + 1
    var dir = ""
    var name = ""
    var ext = ""
    if lastSep > 0:
        dir = osSliceStr(path, 0, lastSep - 1)
    if lastDot > lastSep && lastDot >= 0:
        ext = osSliceStr(path, lastDot, pathLen - 1)
        if lastDot - 1 >= nameStart:
            name = osSliceStr(path, nameStart, lastDot - 1)
    elif nameStart < pathLen:
        name = osSliceStr(path, nameStart, pathLen - 1)
    return splitFileResult(dir, name, ext)
@borrows
fn getFileSize(path: str): int64 =
    return fileSize(strings.CloneStr(path))
fn getAppDir(): str =
    return getCurrentDir()
fn findExe(name: str): str =
    return ""
fn setCurrentDir(path: str) =
    return
fn copyDir(src: str, dest: str) =
    return
fn makeWalkDirEntry(kind: PathComponent, path: str): str =
    let kindText: str = strings.IntToStr(Int32(kind))
    return strings.ConcatStr(strings.ConcatStr(kindText, "|"), path)
fn osAppendStrSetLen(out: var str[], value: str) =
    # Direct index assignment lowers to the raw seq-store specialization, which
    # does NOT call chengStrStoreCompat and therefore does not copy/retain str
    # payloads. walkDirRec relies on this helper for both borrowed callers and
    # still-owned sequence entries; use the ownership-correct seq append path.
    add(out, value)
@borrows
fn listDir(path: str): str[] =
    var out: str[]
    if Len(path) == 0 || path[0] == Char(0) || !dirExists(strings.CloneStr(path)):
        let result = osReturnStrSeq(out)
        return result
    let listRaw: cstring = cheng_os_list_dir_bridge(strings.CloneStr(path))
    if listRaw == nil:
        let result = osReturnStrSeq(out)
        return result
    let total: int32 = os_cstrlen(listRaw)
    if total <= 0:
        cheng_os_list_dir_free_bridge(listRaw)
        let result = osReturnStrSeq(out)
        return result
    let listText: str = strings.NewStringFromCString(listRaw, total)
    cheng_os_list_dir_free_bridge(listRaw)
    var start: int32
    var count: int32
    for i in 0..total:
        var endHit: bool
        if i == total:
            endHit = true
        elif listText[i] == '\n':
            endHit = true
        if endHit:
            var endIdx: int32 = i - 1
            if endIdx >= start && listText[endIdx] == '\r':
                endIdx = endIdx - 1
            if endIdx >= start:
                if listText[start] != Char(0):
                    count = count + 1
            start = i + 1
    if count > 0:
        setLen(out, count)
        start = 0
        var writeAt: int32
        for i in 0..total:
            var endHit: bool
            if i == total:
                endHit = true
            elif listText[i] == '\n':
                endHit = true
            if endHit:
                var endIdx: int32 = i - 1
                if endIdx >= start && listText[endIdx] == '\r':
                    endIdx = endIdx - 1
                if endIdx >= start && listText[start] != Char(0):
                    out[writeAt] = osSliceStr(listText, start, endIdx)
                    writeAt = writeAt + 1
                start = i + 1
        if writeAt < out.len:
            setLen(out, writeAt)
    let result = osReturnStrSeq(out)
    return result
fn walkDir(path: str): str[] =
    var out: str[]
    if Len(path) == 0 || path[0] == Char(0) || !dirExists(strings.CloneStr(path)):
        let result = osReturnStrSeq(out)
        return result
    let names: str[] = listDir(strings.CloneStr(path))
    if names.len > 0:
        setLen(out, names.len)
    var writeAt: int32
    for i in 0..<names.len:
        let name: str = names[i]
        if Len(name) <= 0 || name[0] == Char(0):
            continue
        let fullPath: str = joinPath(strings.CloneStr(path), name)
        var kind: PathComponent = PathComponent(4)
        if dirExists(strings.CloneStr(fullPath)):
            kind = PathComponent(1)
        elif fileExists(strings.CloneStr(fullPath)):
            kind = PathComponent(0)
        out[writeAt] = makeWalkDirEntry(kind, fullPath)
        writeAt = writeAt + 1
    if writeAt < out.len:
        setLen(out, writeAt)
    let result = osReturnStrSeq(out)
    return result

fn walkDirRec(path: str): str[] =
    var out: str[]
    if strings.Len(path) == 0 || !dirExists(strings.CloneStr(path)):
        let result = osReturnStrSeq(out)
        return result
    var pending: str[]
    osAppendStrSetLen(pending, path)
    while pending.len > 0:
        let last = pending.len - 1
        let current: str = strings.CloneStr(pending[last])
        setLen(pending, last)
        let items: str[] = walkDir(current)
        for i in 0..<items.len:
            let kind: PathComponent = walkDirEntryKind(items[i])
            if kind == PathComponent(1) || kind == PathComponent(3):
                osAppendStrSetLen(pending, walkDirEntryPath(items[i]))
            elif kind == PathComponent(0) || kind == PathComponent(2):
                osAppendStrSetLen(out, walkDirEntryPath(items[i]))
    let result = osReturnStrSeq(out)
    return result
fn extractFilename(path: str): str =
    let pathLen: int32 = strings.Len(path)
    if pathLen <= 0:
        return ""
    var lastSep: int32 = -1
    for i in 0..<pathLen:
        let ch: char = path[i]
        if ch == '/' || ch == '\\':
            lastSep = i
    let nameStart: int32 = lastSep + 1
    if nameStart >= pathLen:
        return ""
    return osSliceStr(path, nameStart, pathLen - 1)
fn getLastModificationTime(path: str): DateTime =
    return getTime()
fn processOptionMask(opt: ProcessOption): uint64 =
    let one: uint64 = UInt64(1)
    let shift: uint64 = UInt64(Int64(opt))
    return one << shift

fn execCommandHasEvalOption(options: uint64): bool =
    let evalBit: uint64 = UInt64(4)
    let zero: uint64 = UInt64(0)
    return (options & evalBit) != zero

fn execCommandWithEvalOption(options: uint64): uint64 =
    let evalBit: uint64 = UInt64(4)
    return options | evalBit

@borrows
fn execCmdExImpl(command: str, options: uint64, workingDir: str): ExecCmdResult =
    var output0: str
    osSetEmpty(output0)
    var exitCode0: int32 = -1
    if strings.Len(command) == 0:
        let emptyResult: ExecCmdResult = new(ExecCmdResult)
        emptyResult.output = output0
        emptyResult.exitCode = exitCode0
        return emptyResult
    var merge: int32
    let mask: uint64 = UInt64(1)
    if (options & mask) != 0:
        merge = 1
    let output1: str = strFromCStringBorrow(cheng_exec_cmd_capture_raw(StrToCStringTemp(command),
                                                                       StrToCStringTemp(workingDir),
                                                                       merge))
    let exitCode64: int64 = cheng_exec_cmd_last_exit_code_raw()
    osSetStr(output0, output1)
    exitCode0 = Int32(exitCode64)
    let out: ExecCmdResult = new(ExecCmdResult)
    out.output = output0
    out.exitCode = exitCode0
    return out
@borrows
fn execCmdEx(command: str, options: uint64, workingDir: str): ExecCmdResult =
    if !execCommandHasEvalOption(options):
        osWriteLineText(get_stderr(), "std/os ExecCmdEx requires PoEvalCommand; prefer std/os_host_process ExecFile* for argv-safe execution")
        os_exit_bridge(2)
        let failed: ExecCmdResult = new(ExecCmdResult)
        failed.exitCode = -1
        return failed
    return execCmdExImpl(command, options, workingDir)

@borrows
fn execShellCmdEx(command: str, options: uint64, workingDir: str): ExecCmdResult =
    return execCmdExImpl(command, execCommandWithEvalOption(options), workingDir)

@borrows
fn execCmdStatus(command: str, workingDir: str): int32 =
    osWriteLineText(get_stderr(), "std/os ExecCmdStatus requires explicit shell eval; use ExecShellCmdStatus or std/os_host_process ExecFileStatus")
    os_exit_bridge(2)
    return -1

@borrows
fn execShellCmdStatus(command: str, workingDir: str): int32 =
    if strings.Len(command) == 0:
        return -1
    let rawCommand: cstring = StrToCStringTemp(command)
    let rawWorkingDir: cstring = StrToCStringTemp(workingDir)
    return cheng_exec_cmd_status_raw(rawCommand, rawWorkingDir)
fn execCmdResultNew(): ExecCmdResult =
    return new(ExecCmdResult)

fn execCmdResultExitCode(result: ExecCmdResult): int32 =
    let out: int32 = result.exitCode
    return out
fn execCmdResultOutput(result: ExecCmdResult): str =
    let n: int32 = StrLenFast(result.output)
    if n <= 0:
        return ""
    return NewStringCopy(StrDataPtr(result.output), n)

const osResourceGuardRusageSelf: int32 = 0
const osResourceGuardMemoryExceeded: int32 = 125
const osRusageInfoFlavorV0: int32 = 0

var processResourceGuardConfiguredMaxRssBytesReady: bool
var processResourceGuardConfiguredMaxRssBytesCached: int64

fn processResourceGuardParseUnsignedInt64(raw: str): int64 =
    if Len(raw) <= 0:
        return Int64(-1)
    var value: int64
    var hadDigit = false
    var trailingSpace = false
    for i in 0..<Len(raw):
        let ch = raw[i]
        if ch >= '0' && ch <= '9':
            if trailingSpace:
                return Int64(-1)
            value = value * Int64(10) + Int64(Int32(ch) - Int32('0'))
            hadDigit = true
        elif ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r':
            if hadDigit:
                trailingSpace = true
        else:
            return Int64(-1)
    if !hadDigit:
        return Int64(-1)
    return value
# Official 1GiB process hard gate. Per-compile theory lower bound is
# FullRssMemoryModel.modeledLowerBoundBytes (consume-window + ORC, no fudge).
fn CompileRssTheoryHardGateBytes(): int64 =
    return Int64(1073741824)
fn processResourceGuardDefaultMaxRssBytes(): int64 =
    return CompileRssTheoryHardGateBytes()
fn processResourceGuardConfiguredMaxRssBytes(): int64 =
    let parentGuardRaw = getEnv("CHENG_PARENT_RSS_GUARD")
    if Len(getEnv("PARENT_RSS_GUARD")) > 0 ||
       Len(getEnv("PROCESS_MAX_RSS_BYTES")) > 0 ||
       Len(getEnv("CHENG_MAX_RSS_BYTES")) > 0 ||
       Len(getEnv("MAX_RSS_BYTES")) > 0:
        return Int64(-1)
    if Len(parentGuardRaw) > 0:
        return Int64(0)
    var raw = getEnv("CHENG_PROCESS_MAX_RSS_BYTES")
    if Len(raw) <= 0:
        return processResourceGuardDefaultMaxRssBytes()
    let parsed = processResourceGuardParseUnsignedInt64(raw)
    if parsed <= Int64(0):
        return Int64(-1)
    return parsed
fn processResourceGuardConfiguredMaxRssBytesOnce(): int64 =
    return processResourceGuardConfiguredMaxRssBytes()
var processResourceGuardRuMaxrssScaleCached: int64

fn processResourceGuardRuMaxrssScaleBytes(): int64 =
    # getrusage ru_maxrss unit is a platform ABI fact: Linux reports KiB, Darwin reports bytes.
    # /proc/self/statm existence is the definitive Linux discriminator (the runtime already
    # requires procfs on Linux for all process RSS accounting).
    if processResourceGuardRuMaxrssScaleCached > Int64(0):
        return processResourceGuardRuMaxrssScaleCached
    let statmFd: int32 = libc_open(StrToCStringTemp("/proc/self/statm"), osOpenReadOnly, 0)
    if statmFd >= 0:
        let _closeStatmProbe: int32 = libc_close(statmFd)
        processResourceGuardRuMaxrssScaleCached = Int64(1024)
    else:
        processResourceGuardRuMaxrssScaleCached = Int64(1)
    return processResourceGuardRuMaxrssScaleCached

fn processResourceGuardCurrentRssBytes(): int64 =
    if processResourceGuardRuMaxrssScaleBytes() == Int64(1024):
        # Linux (procfs present): ru_maxrss KiB high-water is the established honest metric.
        var usage: OsRusage
        if os_getrusage_bridge(osResourceGuardRusageSelf, usage) != 0:
            return Int64(-1)
        if usage.ru_maxrss <= Int64(0):
            return Int64(-1)
        return usage.ru_maxrss * processResourceGuardRuMaxrssScaleBytes()
    # Darwin: ru_maxrss is blind to compressed memory (measured 3.27GB ru_maxrss while
    # phys_footprint hit 9.74GB past an 8GB guard without triggering), so the guard must
    # read phys_footprint. Loud -1 on bridge failure — no fallback to the blind metric.
    var info: OsRusageInfoV0
    if os_proc_pid_rusage_bridge(os_getpid_bridge(), osRusageInfoFlavorV0, info) != 0:
        return Int64(-1)
    if info.ri_phys_footprint <= Int64(0):
        return Int64(-1)
    return info.ri_phys_footprint

fn SystemMemoryTotalBytes(): int64 =
    let bytes = os_system_memory_total_bytes_bridge()
    if bytes <= Int64(0):
        return Int64(0)
    return bytes

@borrows
fn ProcessId(): int32 =
    let pid = os_getpid_bridge()
    assert(pid > 0, "os: getpid returned invalid process identity")
    return pid

fn EffectiveUserId(): int64 =
    return int64(os_geteuid_bridge())

fn osFixedCString4096ToString(buf: var uint8[4096]): str =
    var n: int32
    while n < 4096 && buf[n] != 0:
        n = n + 1
    let out: str = NewStringAlloc(n)
    var i: int32
    while i < n:
        strings.stringWriteByte(out, i, Int32(buf[i]))
        i = i + 1
    return out

fn osFixedCString32ToString(buf: var uint8[32]): str =
    var n: int32
    while n < 32 && buf[n] != 0:
        n = n + 1
    let out: str = NewStringAlloc(n)
    var i: int32
    while i < n:
        strings.stringWriteByte(out, i, Int32(buf[i]))
        i = i + 1
    return out

fn PersistentUserDataRootIssue(): PersistentUserDataRoot =
    var out: PersistentUserDataRoot
    let effectiveUid = EffectiveUserId()
    if effectiveUid < int64(0) ||
       effectiveUid > int64(4294967295):
        out.error =
            "os_persistent_user_data_root_effective_uid_invalid"
        return out
    var rootBuffer: uint8[4096]
    var platformBuffer: uint8[32]
    let rc = cheng_host_authenticated_persistent_root_bridge(
        uint32(effectiveUid),
        rootBuffer,
        4096,
        platformBuffer,
        16)
    if rc != 0:
        out.error = strings.ConcatStr(
            "os_persistent_user_data_root_failed:",
            strings.IntToStr(rc))
        return out
    out.rootPath = osFixedCString4096ToString(rootBuffer)
    out.platform = osFixedCString32ToString(platformBuffer)
    if out.rootPath.len == 0 ||
       out.platform.len == 0 ||
       !IsAbsolute(out.rootPath):
        out.error =
            "os_persistent_user_data_root_invalid_bridge_result"
        return out
    out.effectiveUid = effectiveUid
    out.ok = true
    return out

fn ProcessRssBytes(): int64 =
    return processResourceGuardCurrentRssBytes()

fn processResourceGuardMemoryLimitExceededLine(rssBytes: int64,
                                                maxRssBytes: int64): str =
    let rssText: str = strings.Int64ToStr(rssBytes)
    let limitText: str = strings.Int64ToStr(maxRssBytes)
    let left: str = strings.ConcatStr("compile_progress phase=resource_guard status=rss_limit_exceeded rss_bytes=", rssText)
    let right: str = strings.ConcatStr(" limit_bytes=", limitText)
    return strings.ConcatStr(left, right)
fn processResourceGuardMemoryUnavailableLine(): str =
    return "compile_progress phase=resource_guard status=rss_unavailable"
fn processResourceGuardCheck() =
    let maxRssBytes = processResourceGuardConfiguredMaxRssBytesOnce()
    if maxRssBytes == Int64(0):
        return
    if maxRssBytes < Int64(0):
        osWriteLineText(get_stderr(), "compile_progress phase=resource_guard status=invalid_max_rss")
        os_exit_bridge(2)
    let rssBytes = processResourceGuardCurrentRssBytes()
    if rssBytes <= Int64(0):
        osWriteLineText(get_stderr(), processResourceGuardMemoryUnavailableLine())
        os_exit_bridge(osResourceGuardMemoryExceeded)
    if rssBytes > maxRssBytes:
        osWriteLineText(get_stderr(), processResourceGuardMemoryLimitExceededLine(rssBytes, maxRssBytes))
        os_exit_bridge(osResourceGuardMemoryExceeded)
fn sleepMs(value: int32) =
    if value <= 0:
        return
    libc_usleep(UInt32(value * 1000))

fn fileOpenModeCode(mode: FileOpenMode): int32 =
    if mode == FileOpenMode(0):
        return 0
    if mode == FileOpenMode(1):
        return 1
    if mode == FileOpenMode(2):
        return 2
    return 3

@borrows
fn openFileHandleResult(path: str, mode: FileOpenMode): Result[FileHandle] =
    return openFileHandleCodeResult(path, fileOpenModeCode(mode))

fn openFileHandleProviderResult(handle: FileHandle, err: str): Result[FileHandle] =
    if handle == uint64(0):
        if strings.Len(err) > 0:
            return Err[FileHandle](err)
        return Err[FileHandle]("os file open: failed")
    return Ok[FileHandle](handle)

@borrows
fn openReadFileHandleResult(path: str): Result[FileHandle] =
    if strings.Len(path) <= 0:
        return Err[FileHandle]("os file open: empty path")
    var err: str
    let handle: FileHandle = cheng_file_handle_open_read_bridge(path, err)
    return openFileHandleProviderResult(handle, err)

@borrows
fn openWriteTruncateFileHandleResult(path: str): Result[FileHandle] =
    if strings.Len(path) <= 0:
        return Err[FileHandle]("os file open: empty path")
    var err: str
    let handle: FileHandle = cheng_file_handle_open_write_truncate_bridge(path, err)
    return openFileHandleProviderResult(handle, err)

@borrows
fn openAppendFileHandleResult(path: str): Result[FileHandle] =
    if strings.Len(path) <= 0:
        return Err[FileHandle]("os file open: empty path")
    var err: str
    let handle: FileHandle = cheng_file_handle_open_append_bridge(path, err)
    return openFileHandleProviderResult(handle, err)

@borrows
fn openFileHandleCodeResult(path: str, modeCode: int32): Result[FileHandle] =
    if strings.Len(path) <= 0:
        return Err[FileHandle]("os file open: empty path")
    if modeCode == 0:
        return openReadFileHandleResult(path)
    if modeCode == 1:
        return openWriteTruncateFileHandleResult(path)
    if modeCode == 3:
        return openAppendFileHandleResult(path)
    if modeCode < 0 || modeCode > 3:
        return Err[FileHandle]("os file open: invalid mode")
    var err: str
    let handle: FileHandle = cheng_file_handle_open_bridge(path, modeCode, err)
    if handle == uint64(0):
        if strings.Len(err) > 0:
            return Err[FileHandle](err)
        return Err[FileHandle]("os file open: failed")
    return Ok[FileHandle](handle)

fn closeFileHandleResult(handle: FileHandle): Result[bool] =
    if handle == uint64(0):
        return Err[bool]("os file close: invalid handle")
    var err: str
    let rc: int32 = cheng_file_handle_close_bridge(handle, err)
    if rc == 0:
        if strings.Len(err) > 0:
            return Err[bool](err)
        return Err[bool]("os file close: failed")
    return Ok[bool](true)

fn readAllBytesHandleResult(handle: FileHandle): Result[Bytes] =
    if handle == uint64(0):
        return Err[Bytes]("os file read: invalid handle")
    var text: str
    var err: str
    let rc: int32 = cheng_file_handle_read_all_bridge(handle, text, err)
    if rc == 0:
        if strings.Len(err) > 0:
            return Err[Bytes](err)
        return Err[Bytes]("os file read: failed")
    let src: Bytes = rawbytes.BytesFromString(text)
    let n: int32 = rawbytes.BytesLen(src)
    if n <= 0:
        return Ok[Bytes](rawbytes.EmptyBytes())
    let out: Bytes = rawbytes.BytesAlloc(n)
    if rawbytes.BytesDataPtr(out) == nil:
        return Err[Bytes]("os file read: alloc failed")
    rawbytes.BytesCopyInto(out, 0, src)
    return Ok[Bytes](out)

@borrows
fn writeAllBytesHandleResult(handle: FileHandle, bytes: Bytes): Result[bool] =
    if handle == uint64(0):
        return Err[bool]("os file write: invalid handle")
    let dataLen: int32 = rawbytes.BytesLen(bytes)
    let dataPtr: ptr = bytes.data
    if dataLen < 0:
        return Err[bool]("os file write: negative length")
    if dataLen > 0 && dataPtr == nil:
        return Err[bool]("os file write: nil data")
    var err: str
    let rc: int32 = cheng_file_handle_write_all_bridge(handle, dataPtr, dataLen, err)
    if rc == 0:
        if strings.Len(err) > 0:
            return Err[bool](err)
        return Err[bool]("os file write: failed")
    if dataLen > 0:
        ioMeterReport(ioWrite, Int64(dataLen))
    return Ok[bool](true)

fn atomicTreeErrorOr(err: str, fallback: str): str =
    if strings.Len(err) > 0:
        return err
    return fallback

fn atomicTreeHandleResult(handle: AtomicTree,
                          err: str,
                          fallback: str): Result[AtomicTree] =
    if handle == uint64(0):
        return Err[AtomicTree](atomicTreeErrorOr(err, fallback))
    return Ok[AtomicTree](handle)

fn atomicTreeBoolResult(rc: int32,
                        err: str,
                        fallback: str): Result[bool] =
    if rc == 0:
        return Err[bool](atomicTreeErrorOr(err, fallback))
    return Ok[bool](true)

@borrows
fn atomicTreeBeginResult(parentPath: str,
                         stagingName: str,
                         finalName: str): Result[AtomicTree] =
    var err: str
    let handle = cheng_atomic_tree_begin_bridge(parentPath,
