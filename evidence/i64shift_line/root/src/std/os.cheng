# Process-lifetime Arena/SoA owner for one verified AtomicTree root.  The raw
# tree handle is created by consuming an exclusive-ABSENT handle and never
# crosses this boundary.  Rows are burned monotonically and never recycled.
const
    AtomicTreeOwnerRegistryRows: int32 = 1024
    AtomicTreeOwnerFixedRecordBytes: int32 = 512
    AtomicTreeOwnerMaxRecords: int32 = 1048576
    atomicTreeOwnerStateEmpty: int32 = 0
    atomicTreeOwnerStateBuilding: int32 = 1
    atomicTreeOwnerStateIssued: int32 = 2
    atomicTreeOwnerStateMoving: int32 = 3
    atomicTreeOwnerStateAppending: int32 = 4
    atomicTreeOwnerStateReading: int32 = 5
    atomicTreeOwnerStateSealing: int32 = 6
    atomicTreeOwnerStateTerminal: int32 = 7
    atomicTreeOwnerStateClosing: int32 = 8
    atomicTreeOwnerStateClosed: int32 = 9
    atomicTreeOwnerStateFailed: int32 = 10
    atomicTreeOwnerEventsDirectory: str = "atomic-tree-owner-v1"
    atomicTreeOwnerRootStagingPrefix: str =
        ".atomic-tree-owner-root-v1-"
    atomicTreeOwnerEventStagingPrefix: str =
        ".atomic-tree-owner-event-v1-"
    atomicTreeOwnerEventFinalPrefix: str = "event-v1-"
    atomicTreeOwnerTerminalFinalName: str = "terminal-v1"
    atomicTreeOwnerRecordFile: str = "record.bin"

type
    AtomicTreeOwner =
        row: int32
        generation: int32
        owner: int32

    AtomicTreeOwnerCloseReceipt =
        row: int32
        consumedGeneration: int32
        consumedOwner: int32
        closedGeneration: int32
        closedOwner: int32
        recordCount: int32
        terminalRow: int32
        retainedBytes: int64

var
    atomicTreeOwnerRegistryInit: int32
    atomicTreeOwnerNextRow: atomic.I32
    atomicTreeOwnerStates: atomic.I32[]
    atomicTreeOwnerGenerations: atomic.I32[]
    atomicTreeOwnerOwners: atomic.I32[]
    atomicTreeOwnerTrees: AtomicTree[]
    atomicTreeOwnerRecordCounts: int32[]
    atomicTreeOwnerTerminalRows: int32[]
    atomicTreeOwnerRetainedBytes: int64[]

fn AtomicTreeOwnerRegistryInitializeBeforeWorkload(): bool =
    let state = system.RuntimeAtomicLoadI32(atomicTreeOwnerRegistryInit)
    if state == 2:
        return true
    if state != 0 ||
       !system.RuntimeAtomicCompareExchangeI32(
           atomicTreeOwnerRegistryInit, 0, 1):
        return false
    setLen(atomicTreeOwnerStates, AtomicTreeOwnerRegistryRows)
    setLen(atomicTreeOwnerGenerations, AtomicTreeOwnerRegistryRows)
    setLen(atomicTreeOwnerOwners, AtomicTreeOwnerRegistryRows)
    setLen(atomicTreeOwnerTrees, AtomicTreeOwnerRegistryRows)
    setLen(atomicTreeOwnerRecordCounts, AtomicTreeOwnerRegistryRows)
    setLen(atomicTreeOwnerTerminalRows, AtomicTreeOwnerRegistryRows)
    setLen(atomicTreeOwnerRetainedBytes, AtomicTreeOwnerRegistryRows)
    for row in 0..<AtomicTreeOwnerRegistryRows:
        atomicTreeOwnerStates[row] = atomic.NewI32(atomicTreeOwnerStateEmpty)
        atomicTreeOwnerGenerations[row] = atomic.NewI32(0)
        atomicTreeOwnerOwners[row] = atomic.NewI32(0)
        atomicTreeOwnerTerminalRows[row] = -1
        if atomicTreeOwnerStates[row] == nil ||
           atomicTreeOwnerGenerations[row] == nil ||
           atomicTreeOwnerOwners[row] == nil:
            system.RuntimeAtomicStoreI32(atomicTreeOwnerRegistryInit, 3)
            return false
    atomicTreeOwnerNextRow = atomic.NewI32(0)
    if atomicTreeOwnerNextRow == nil:
        system.RuntimeAtomicStoreI32(atomicTreeOwnerRegistryInit, 3)
        return false
    system.RuntimeAtomicStoreI32(atomicTreeOwnerRegistryInit, 2)
    return true

fn AtomicTreeOwnerIsEmpty(value: AtomicTreeOwner): bool =
    return value.row == 0 && value.generation == 0 && value.owner == 0

fn atomicTreeOwnerShapeValid(value: AtomicTreeOwner): bool =
    return value.row >= 0 &&
        value.row < AtomicTreeOwnerRegistryRows &&
        value.generation > 0 && value.owner > 0

fn atomicTreeOwnerTokenMatches(value: AtomicTreeOwner): bool =
    return atomicTreeOwnerShapeValid(value) &&
        atomic.LoadI32(
            atomicTreeOwnerGenerations[value.row]) == value.generation &&
        atomic.LoadI32(atomicTreeOwnerOwners[value.row]) == value.owner

fn atomicTreeOwnerStateCas(
        row: int32,
        expected: int32,
        desired: int32): bool =
    return atomic.CasI32(
        atomicTreeOwnerStates[row], expected, desired)

fn atomicTreeOwnerStateStore(row: int32, state: int32) =
    atomic.StoreI32(atomicTreeOwnerStates[row], state)

fn atomicTreeOwnerAllocateRow(): int32 =
    if system.RuntimeAtomicLoadI32(atomicTreeOwnerRegistryInit) != 2:
        return -1
    let row = atomic.FetchAddI32(atomicTreeOwnerNextRow, 1)
    if row < 0 || row >= AtomicTreeOwnerRegistryRows:
        # Permanently close issuance before the signed counter can wrap and
        # make any burned row observable as available again.
        system.RuntimeAtomicStoreI32(atomicTreeOwnerRegistryInit, 3)
        return -1
    if !atomicTreeOwnerStateCas(
           row, atomicTreeOwnerStateEmpty, atomicTreeOwnerStateBuilding):
        panic("os atomic tree owner: non-recyclable row reused")
    return row

fn atomicTreeOwnerNextToken(
        row: int32,
        outGeneration: var int32,
        outOwner: var int32): bool =
    let generation = atomic.LoadI32(atomicTreeOwnerGenerations[row])
    let owner = atomic.LoadI32(atomicTreeOwnerOwners[row])
    if generation <= 0 || owner <= 0 ||
       generation == int32(2147483647) ||
       owner == int32(2147483647):
        return false
    outGeneration = generation + 1
    outOwner = owner + 1
    return true

fn atomicTreeOwnerRotateToken(
        row: int32,
        value: var AtomicTreeOwner): bool =
    var nextGeneration: int32
    var nextOwner: int32
    if !atomicTreeOwnerNextToken(row, nextGeneration, nextOwner):
        return false
    atomic.StoreI32(
        atomicTreeOwnerGenerations[row], nextGeneration)
    atomic.StoreI32(atomicTreeOwnerOwners[row], nextOwner)
    value.generation = nextGeneration
    value.owner = nextOwner
    return true

fn atomicTreeOwnerRootStagingName(row: int32): str =
    return strings.ConcatStr(
        atomicTreeOwnerRootStagingPrefix,
        strings.IntToStr(row))

fn atomicTreeOwnerEventFinalName(
        eventRow: int32,
        terminal: bool): str =
    if terminal:
        return atomicTreeOwnerTerminalFinalName
    return strings.ConcatStr(
        atomicTreeOwnerEventFinalPrefix,
        strings.IntToStr(eventRow))

fn atomicTreeOwnerEventStagingName(
        eventRow: int32,
        terminal: bool): str =
    return strings.ConcatStr(
        atomicTreeOwnerEventStagingPrefix,
        atomicTreeOwnerEventFinalName(eventRow, terminal))

fn atomicTreeOwnerAbortOrPanic(tree: AtomicTree, context: str) =
    if tree == uint64(0):
        return
    let aborted = AtomicTreeAbort(tree)
    if IsErr(aborted) || !Value(aborted):
        panic(context)

fn atomicTreeOwnerCloseOrPanic(tree: AtomicTree, context: str) =
    if tree == uint64(0):
        return
    let closed = AtomicTreeClose(tree)
    if IsErr(closed) || !Value(closed):
        panic(context)

fn AtomicTreeOwnerBeginFromExclusiveAbsent(
        source: var AtomicTree,
        out: var AtomicTreeOwner,
        err: var str): bool =
    out = AtomicTreeOwner()
    err = ""
    if source == uint64(0) ||
       system.RuntimeAtomicLoadI32(atomicTreeOwnerRegistryInit) != 2:
        err = "os atomic tree owner: source or registry invalid"
        return false
    let row = atomicTreeOwnerAllocateRow()
    if row < 0:
        err = "os atomic tree owner: arena exhausted"
        return false
    var transaction: AtomicTree
    let begun = AtomicTreeBeginFromExclusiveAbsent(
        source, atomicTreeOwnerRootStagingName(row))
    if IsErr(begun):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = strings.CloneStr(Error(begun))
        return false
    transaction = Value(begun)
    let madeEvents = AtomicTreeMkdir(
        transaction, atomicTreeOwnerEventsDirectory)
    if IsErr(madeEvents) || !Value(madeEvents):
        atomicTreeOwnerAbortOrPanic(
            transaction,
            "os atomic tree owner: root preparation abort failed")
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = IsErr(madeEvents) ? strings.CloneStr(Error(madeEvents)) :
            "os atomic tree owner: event directory creation failed"
        return false
    var expectedRootDirectories = [
        strings.CloneStr(atomicTreeOwnerEventsDirectory)]
    var noRootFiles: str[]
    let exact = AtomicTreeVerifyExact(
        transaction, expectedRootDirectories, noRootFiles)
    if IsErr(exact) || !Value(exact):
        atomicTreeOwnerAbortOrPanic(
            transaction,
            "os atomic tree owner: root exact abort failed")
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = IsErr(exact) ? strings.CloneStr(Error(exact)) :
            "os atomic tree owner: prepared root shape invalid"
        return false
    let committed =
        AtomicTreeCommitExclusiveNoReplaceAndOpenVerified(transaction)
    if IsErr(committed):
        if transaction != uint64(0):
            atomicTreeOwnerAbortOrPanic(
                transaction,
                "os atomic tree owner: root commit abort failed")
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = strings.CloneStr(Error(committed))
        return false
    let root = Value(committed)
    let rootExact = AtomicTreeVerifyRootExact(
        root, expectedRootDirectories, noRootFiles)
    if IsErr(rootExact) || !Value(rootExact):
        atomicTreeOwnerCloseOrPanic(
            root,
            "os atomic tree owner: invalid committed root close failed")
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = IsErr(rootExact) ? strings.CloneStr(Error(rootExact)) :
            "os atomic tree owner: committed root shape invalid"
        return false
    atomicTreeOwnerTrees[row] = root
    atomicTreeOwnerRecordCounts[row] = 0
    atomicTreeOwnerTerminalRows[row] = -1
    atomicTreeOwnerRetainedBytes[row] = Int64(0)
    atomic.StoreI32(atomicTreeOwnerGenerations[row], 1)
    atomic.StoreI32(atomicTreeOwnerOwners[row], 1)
    out.row = row
    out.generation = 1
    out.owner = 1
    atomicTreeOwnerStateStore(row, atomicTreeOwnerStateIssued)
    return true

fn AtomicTreeOwnerMove(
        source: var AtomicTreeOwner,
        out: var AtomicTreeOwner,
        err: var str): bool =
    out = AtomicTreeOwner()
    err = ""
    if !atomicTreeOwnerTokenMatches(source):
        err = "os atomic tree owner: move source stale"
        return false
    let row = source.row
    let state = atomic.LoadI32(atomicTreeOwnerStates[row])
    if (state != atomicTreeOwnerStateIssued &&
        state != atomicTreeOwnerStateTerminal) ||
       !atomicTreeOwnerStateCas(row, state, atomicTreeOwnerStateMoving):
        err = "os atomic tree owner: move source stale"
        return false
    if !atomicTreeOwnerTokenMatches(source):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: move token drifted"
        return false
    out = source
    if !atomicTreeOwnerRotateToken(row, out):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        out = AtomicTreeOwner()
        err = "os atomic tree owner: move token overflow"
        return false
    source = AtomicTreeOwner()
    atomicTreeOwnerStateStore(row, state)
    return true

@borrows
fn atomicTreeOwnerCommitRecordInto(
        row: int32,
        eventRow: int32,
        terminal: bool,
        record: Bytes,
        err: var str): bool =
    let root = atomicTreeOwnerTrees[row]
    if root == uint64(0):
        err = "os atomic tree owner: private root missing"
        return false
    let finalName = atomicTreeOwnerEventFinalName(eventRow, terminal)
    let begun = AtomicTreeBeginChildFromVerifiedRoot(
        root,
        atomicTreeOwnerEventsDirectory,
        atomicTreeOwnerEventStagingName(eventRow, terminal),
        finalName)
    if IsErr(begun):
        err = strings.CloneStr(Error(begun))
        return false
    let child = Value(begun)
    let written = AtomicTreeWriteExclusiveLeaseSync(
        child, atomicTreeOwnerRecordFile, record)
    if IsErr(written) || !Value(written):
        atomicTreeOwnerAbortOrPanic(
            child,
            "os atomic tree owner: record write abort failed")
        err = IsErr(written) ? strings.CloneStr(Error(written)) :
            "os atomic tree owner: fixed record write failed"
        return false
    let sealed = AtomicTreeSealReadOnly(child, atomicTreeOwnerRecordFile)
    if IsErr(sealed) || !Value(sealed):
        atomicTreeOwnerAbortOrPanic(
            child,
            "os atomic tree owner: record seal abort failed")
        err = IsErr(sealed) ? strings.CloneStr(Error(sealed)) :
            "os atomic tree owner: fixed record seal failed"
        return false
    var noDirectories: str[]
    var expectedFiles = [strings.CloneStr(atomicTreeOwnerRecordFile)]
    let exact = AtomicTreeVerifyExact(child, noDirectories, expectedFiles)
    if IsErr(exact) || !Value(exact):
        atomicTreeOwnerAbortOrPanic(
            child,
            "os atomic tree owner: record exact abort failed")
        err = IsErr(exact) ? strings.CloneStr(Error(exact)) :
            "os atomic tree owner: fixed record shape invalid"
        return false
    let committed = AtomicTreeCommitNoReplace(child)
    if IsErr(committed):
        atomicTreeOwnerAbortOrPanic(
            child,
            "os atomic tree owner: record commit abort failed")
        err = strings.CloneStr(Error(committed))
        return false
    let commitKind = Value(committed)
    if commitKind == AtomicTreeDestinationExists:
        atomicTreeOwnerAbortOrPanic(
            child,
            "os atomic tree owner: replay abort failed")
        err = "os atomic tree owner: durable record replay rejected"
        return false
    if commitKind == AtomicTreeCommittedDurabilityUnknown:
        atomicTreeOwnerCloseOrPanic(
            child,
            "os atomic tree owner: uncertain record close failed")
        err = "os atomic tree owner: record durability unknown"
        return false
    if commitKind != AtomicTreeCommitted:
        panic("os atomic tree owner: impossible record commit result")
    atomicTreeOwnerCloseOrPanic(
        child,
        "os atomic tree owner: committed record close failed")
    let opened = AtomicTreeOpenChildFromVerifiedRoot(
        root, atomicTreeOwnerEventsDirectory, finalName)
    if IsErr(opened):
        err = strings.CloneStr(Error(opened))
        return false
    let readbackTree = Value(opened)
    let readbackShape = AtomicTreeVerifyExact(
        readbackTree, noDirectories, expectedFiles)
    if IsErr(readbackShape) || !Value(readbackShape):
        atomicTreeOwnerCloseOrPanic(
            readbackTree,
            "os atomic tree owner: invalid readback close failed")
        err = IsErr(readbackShape) ?
            strings.CloneStr(Error(readbackShape)) :
            "os atomic tree owner: readback shape invalid"
        return false
    let readbackResult = AtomicTreeReadStable(
        readbackTree, atomicTreeOwnerRecordFile)
    if IsErr(readbackResult):
        atomicTreeOwnerCloseOrPanic(
            readbackTree,
            "os atomic tree owner: failed readback close failed")
        err = strings.CloneStr(Error(readbackResult))
        return false
    var readback = Value(readbackResult)
    let equal = rawbytes.BytesLen(readback) ==
            AtomicTreeOwnerFixedRecordBytes &&
        rawbytes.BytesEqual(readback, record)
    rawbytes.BytesFree(readback)
    atomicTreeOwnerCloseOrPanic(
        readbackTree,
        "os atomic tree owner: readback close failed")
    if !equal:
        err = "os atomic tree owner: record readback mismatch"
        return false
    err = ""
    return true

@borrows
fn AtomicTreeOwnerAppendFixed(
        value: var AtomicTreeOwner,
        eventRow: int32,
        record: Bytes,
        err: var str): bool =
    err = ""
    if rawbytes.BytesLen(record) != AtomicTreeOwnerFixedRecordBytes ||
       eventRow < 0 || eventRow >= AtomicTreeOwnerMaxRecords ||
       !atomicTreeOwnerTokenMatches(value):
        err = "os atomic tree owner: fixed record input invalid"
        return false
    let row = value.row
    if atomicTreeOwnerRecordCounts[row] != eventRow ||
       atomicTreeOwnerTerminalRows[row] != -1 ||
       !atomicTreeOwnerStateCas(
           row,
           atomicTreeOwnerStateIssued,
           atomicTreeOwnerStateAppending):
        err = "os atomic tree owner: append order or token invalid"
        return false
    if !atomicTreeOwnerTokenMatches(value):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: append token drifted"
        return false
    if !atomicTreeOwnerCommitRecordInto(
           row, eventRow, false, record, err):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        return false
    atomicTreeOwnerRecordCounts[row] = eventRow + 1
    atomicTreeOwnerRetainedBytes[row] =
        atomicTreeOwnerRetainedBytes[row] +
        Int64(AtomicTreeOwnerFixedRecordBytes)
    if !atomicTreeOwnerRotateToken(row, value):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: append token overflow"
        return false
    atomicTreeOwnerStateStore(row, atomicTreeOwnerStateIssued)
    return true

@borrows
fn AtomicTreeOwnerSealTerminal(
        value: var AtomicTreeOwner,
        eventRow: int32,
        record: Bytes,
        err: var str): bool =
    err = ""
    if rawbytes.BytesLen(record) != AtomicTreeOwnerFixedRecordBytes ||
       eventRow < 0 || eventRow >= AtomicTreeOwnerMaxRecords ||
       !atomicTreeOwnerTokenMatches(value):
        err = "os atomic tree owner: terminal input invalid"
        return false
    let row = value.row
    if atomicTreeOwnerRecordCounts[row] != eventRow ||
       atomicTreeOwnerTerminalRows[row] != -1 ||
       !atomicTreeOwnerStateCas(
           row,
           atomicTreeOwnerStateIssued,
           atomicTreeOwnerStateSealing):
        err = "os atomic tree owner: terminal seal rejected"
        return false
    if !atomicTreeOwnerTokenMatches(value):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: terminal token drifted"
        return false
    if !atomicTreeOwnerCommitRecordInto(
           row, eventRow, true, record, err):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        return false
    atomicTreeOwnerRecordCounts[row] = eventRow + 1
    atomicTreeOwnerTerminalRows[row] = eventRow
    atomicTreeOwnerRetainedBytes[row] =
        atomicTreeOwnerRetainedBytes[row] +
        Int64(AtomicTreeOwnerFixedRecordBytes)
    if !atomicTreeOwnerRotateToken(row, value):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: terminal token overflow"
        return false
    atomicTreeOwnerStateStore(row, atomicTreeOwnerStateTerminal)
    return true

fn AtomicTreeOwnerReadFixed(
        value: AtomicTreeOwner,
        eventRow: int32,
        outRecord: var Bytes,
        err: var str): bool =
    rawbytes.BytesFree(outRecord)
    err = ""
    if eventRow < 0 || !atomicTreeOwnerTokenMatches(value):
        err = "os atomic tree owner: stable read input invalid"
        return false
    let row = value.row
    let state = atomic.LoadI32(atomicTreeOwnerStates[row])
    if (state != atomicTreeOwnerStateIssued &&
        state != atomicTreeOwnerStateTerminal) ||
       eventRow >= atomicTreeOwnerRecordCounts[row] ||
       !atomicTreeOwnerStateCas(row, state, atomicTreeOwnerStateReading):
        err = "os atomic tree owner: stable read token or row invalid"
        return false
    if !atomicTreeOwnerTokenMatches(value):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: stable read token drifted"
        return false
    let terminal = eventRow == atomicTreeOwnerTerminalRows[row]
    let opened = AtomicTreeOpenChildFromVerifiedRoot(
        atomicTreeOwnerTrees[row],
        atomicTreeOwnerEventsDirectory,
        atomicTreeOwnerEventFinalName(eventRow, terminal))
    if IsErr(opened):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = strings.CloneStr(Error(opened))
        return false
    let child = Value(opened)
    var noDirectories: str[]
    var expectedFiles = [strings.CloneStr(atomicTreeOwnerRecordFile)]
    let shape = AtomicTreeVerifyExact(child, noDirectories, expectedFiles)
    if IsErr(shape) || !Value(shape):
        atomicTreeOwnerCloseOrPanic(
            child,
            "os atomic tree owner: invalid stable read close failed")
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = IsErr(shape) ? strings.CloneStr(Error(shape)) :
            "os atomic tree owner: stable read shape invalid"
        return false
    let read = AtomicTreeReadStable(child, atomicTreeOwnerRecordFile)
    if IsErr(read):
        atomicTreeOwnerCloseOrPanic(
            child,
            "os atomic tree owner: failed stable read close failed")
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = strings.CloneStr(Error(read))
        return false
    var bytes = Value(read)
    if rawbytes.BytesLen(bytes) != AtomicTreeOwnerFixedRecordBytes:
        rawbytes.BytesFree(bytes)
        atomicTreeOwnerCloseOrPanic(
            child,
            "os atomic tree owner: short stable read close failed")
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: stable read byte count invalid"
        return false
    outRecord = rawbytes.BytesTake(bytes)
    atomicTreeOwnerCloseOrPanic(
        child,
        "os atomic tree owner: stable read close failed")
    atomicTreeOwnerStateStore(row, state)
    return true

fn AtomicTreeOwnerCloseReceiptValid(
        receipt: AtomicTreeOwnerCloseReceipt): bool =
    return receipt.row >= 0 &&
        receipt.row < AtomicTreeOwnerRegistryRows &&
        atomicTreeOwnerNextRow != nil &&
        receipt.row < atomic.LoadI32(atomicTreeOwnerNextRow) &&
        atomic.LoadI32(atomicTreeOwnerStates[receipt.row]) ==
            atomicTreeOwnerStateClosed &&
        atomicTreeOwnerTrees[receipt.row] == uint64(0) &&
        receipt.consumedGeneration > 0 && receipt.consumedOwner > 0 &&
        receipt.closedGeneration == receipt.consumedGeneration + 1 &&
        receipt.closedOwner == receipt.consumedOwner + 1 &&
        atomic.LoadI32(atomicTreeOwnerGenerations[receipt.row]) ==
            receipt.closedGeneration &&
        atomic.LoadI32(atomicTreeOwnerOwners[receipt.row]) ==
            receipt.closedOwner &&
        receipt.recordCount > 0 &&
        receipt.terminalRow == receipt.recordCount - 1 &&
        atomicTreeOwnerRecordCounts[receipt.row] == receipt.recordCount &&
        atomicTreeOwnerTerminalRows[receipt.row] == receipt.terminalRow &&
        atomicTreeOwnerRetainedBytes[receipt.row] == receipt.retainedBytes &&
        receipt.retainedBytes ==
            Int64(receipt.recordCount) *
            Int64(AtomicTreeOwnerFixedRecordBytes)

fn AtomicTreeOwnerCloseInto(
        value: var AtomicTreeOwner,
        outReceipt: var AtomicTreeOwnerCloseReceipt,
        err: var str): bool =
    outReceipt = AtomicTreeOwnerCloseReceipt()
    err = ""
    if !atomicTreeOwnerTokenMatches(value):
        err = "os atomic tree owner: close token stale"
        return false
    let row = value.row
    if atomicTreeOwnerTerminalRows[row] < 0 ||
       !atomicTreeOwnerStateCas(
           row, atomicTreeOwnerStateTerminal, atomicTreeOwnerStateClosing):
        err = "os atomic tree owner: close before terminal or replay"
        return false
    if !atomicTreeOwnerTokenMatches(value):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: close token drifted"
        return false
    var nextGeneration: int32
    var nextOwner: int32
    if !atomicTreeOwnerNextToken(row, nextGeneration, nextOwner):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = "os atomic tree owner: close token overflow"
        return false
    let closed = AtomicTreeClose(atomicTreeOwnerTrees[row])
    if IsErr(closed) || !Value(closed):
        atomicTreeOwnerStateStore(row, atomicTreeOwnerStateFailed)
        err = IsErr(closed) ? strings.CloneStr(Error(closed)) :
            "os atomic tree owner: close failed"
        return false
    atomicTreeOwnerTrees[row] = uint64(0)
    outReceipt.row = row
    outReceipt.consumedGeneration = value.generation
    outReceipt.consumedOwner = value.owner
    outReceipt.closedGeneration = nextGeneration
    outReceipt.closedOwner = nextOwner
    outReceipt.recordCount = atomicTreeOwnerRecordCounts[row]
    outReceipt.terminalRow = atomicTreeOwnerTerminalRows[row]
    outReceipt.retainedBytes = atomicTreeOwnerRetainedBytes[row]
    atomic.StoreI32(
        atomicTreeOwnerGenerations[row], nextGeneration)
    atomic.StoreI32(atomicTreeOwnerOwners[row], nextOwner)
    value = AtomicTreeOwner()
    atomicTreeOwnerStateStore(row, atomicTreeOwnerStateClosed)
    if !AtomicTreeOwnerCloseReceiptValid(outReceipt):
        panic("os atomic tree owner: close receipt invalid")
    return true

