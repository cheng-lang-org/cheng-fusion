# std/drawlist — DrawList rendering API
#
# Collects draw commands (rect, border, text) then submits to platform renderer.
# Backed by C/ObjC bridge in support/drawlist_bridge.{h,m}

# --- Internal @importc bridge ---

@importc("cheng_drawlist_new")
fn __drawlist_new(capacity: int32): ptr

@importc("cheng_drawlist_free")
fn __drawlist_free(list: ptr)

@importc("cheng_drawlist_init")
fn __drawlist_init(list: ptr, capacity: int32)

@importc("cheng_drawlist_clear")
fn __drawlist_clear(list: ptr)

@importc("cheng_drawlist_count")
fn __drawlist_count(list: ptr): int32

@importc("cheng_drawlist_push_rect")
fn __drawlist_push_rect(list: ptr, x: int32, y: int32, w: int32, h: int32, r: int32, g: int32, b: int32, a: int32)

@importc("cheng_drawlist_push_border")
fn __drawlist_push_border(list: ptr, x: int32, y: int32, w: int32, h: int32, r: int32, g: int32, b: int32, a: int32, borderWidth: int32, radius: int32)

@importc("cheng_drawlist_push_text")
fn __drawlist_push_text(list: ptr, text: str, textLen: int32, x: int32, y: int32, fontSize: int32, r: int32, g: int32, b: int32, a: int32)

@importc("cheng_drawlist_render_cg")
fn __drawlist_render_cg(list: ptr, cgContext: ptr, viewW: int32, viewH: int32)

# --- Public API ---

fn new(capacity: int32): ptr =
    return __drawlist_new(capacity)

fn free(list: ptr) =
    __drawlist_free(list)

@borrows
fn clear(list: ptr) =
    __drawlist_clear(list)

fn count(list: ptr): int32 =
    return __drawlist_count(list)

fn pushRect(list: ptr, x: int32, y: int32, w: int32, h: int32, color: int32) =
    var r: int32 = (color >> 16) & 0xff
    var g: int32 = (color >> 8) & 0xff
    var b: int32 = color & 0xff
    __drawlist_push_rect(list, x, y, w, h, r, g, b, 255)

fn pushRectAlpha(list: ptr, x: int32, y: int32, w: int32, h: int32, color: int32, alpha: int32) =
    var r: int32 = (color >> 16) & 0xff
    var g: int32 = (color >> 8) & 0xff
    var b: int32 = color & 0xff
    __drawlist_push_rect(list, x, y, w, h, r, g, b, alpha)

fn pushBorder(list: ptr, x: int32, y: int32, w: int32, h: int32, color: int32, borderWidth: int32, radius: int32) =
    var r: int32 = (color >> 16) & 0xff
    var g: int32 = (color >> 8) & 0xff
    var b: int32 = color & 0xff
    __drawlist_push_border(list, x, y, w, h, r, g, b, 255, borderWidth, radius)

fn pushText(list: ptr, text: str, x: int32, y: int32, fontSize: int32, color: int32) =
    var r: int32 = (color >> 16) & 0xff
    var g: int32 = (color >> 8) & 0xff
    var b: int32 = color & 0xff
    __drawlist_push_text(list, text, text.len, x, y, fontSize, r, g, b, 255)

fn render(list: ptr, ctx: ptr, w: int32, h: int32) =
    __drawlist_render_cg(list, ctx, w, h)
