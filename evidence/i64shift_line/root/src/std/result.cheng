# std/result
import std/system
import std/strings as stdstrings

type
    ErrorInfo =
        code: int32
        msg: str

type
    Result[T] =
        ok: bool
        value: T
        err: ErrorInfo

fn ErrorInfoMessageInto(out: var str, src: ErrorInfo) =
    out = src.msg

fn ErrorInfoCopyInto(out: var ErrorInfo, src: ErrorInfo) =
    out.code = src.code
    out.msg = stdstrings.CloneStr(src.msg)

fn ErrorOkInto(out: var ErrorInfo) =
    out.code = 0
    out.msg = ""

fn ErrorNewInto(out: var ErrorInfo, msg: str) =
    out.code = 1
    out.msg = msg

fn IsError(e: ErrorInfo): bool =
    if e.code != 0:
        return true
    return Len(e.msg) > 0

fn ErrorCodeOf(e: ErrorInfo): int32 =
    return e.code

@borrows
fn ErrorMessage(e: ErrorInfo): str =
    if Len(e.msg) == 0:
        return ""
    return stdstrings.CloneStr(e.msg)

@borrows
fn ErrorFormat(e: ErrorInfo): str =
    if Len(e.msg) == 0:
        return "error"
    return stdstrings.CloneStr(e.msg)

fn Ok[T](value: T): Result[T] =
    var out: Result[T]
    out.ok = true
    out.value = value
    ErrorOkInto(out.err)
    return out

@borrows
fn Err[T](err: str): Result[T] =
    # Ownership contract: the constructed Result owns an independent copy of
    # the message. Callers routinely pass borrowed field expressions
    # (r.err.msg); taking the string by value moved a bitwise field copy
    # here without a retain, producing two owners and an exit-time
    # double release (ORC registry_miss). Cloning inside the constructor
    # makes the contract explicit and safe for every call shape.
    var out: Result[T]
    out.ok = false
    ErrorNewInto(out.err, stdstrings.CloneStr(err))
    return out

fn ErrCode[T](code: int32, msg: str): Result[T] =
    var out: Result[T]
    out.ok = false
    out.err.code = code
    out.err.msg = stdstrings.CloneStr(msg)
    return out

fn ErrInfo[T](err: ErrorInfo): Result[T] =
    var out: Result[T]
    out.ok = false
    ErrorInfoCopyInto(out.err, err)
    return out

fn IsOk[T](r: var Result[T]): bool =
    return r.ok

fn IsErr[T](r: var Result[T]): bool =
    return !r.ok

fn Value[T](r: Result[T]): T =
    if !r.ok:
        system.PanicErrorInfo(r.err)
    return r.value

@borrows
fn ErrorInfoOf[T](r: Result[T]): ErrorInfo =
    var out: ErrorInfo
    out.code = r.err.code
    out.msg = stdstrings.CloneStr(r.err.msg)
    return out

@borrows
fn Error[T](r: Result[T]): str =
    if Len(r.err.msg) == 0:
        return ""
    return stdstrings.CloneStr(r.err.msg)

@borrows
fn ErrorText[T](r: Result[T]): str =
    if Len(r.err.msg) == 0:
        return ""
    return stdstrings.CloneStr(r.err.msg)
