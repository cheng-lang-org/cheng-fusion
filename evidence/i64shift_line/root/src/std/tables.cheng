import std/seqs
import std/strings
import std/strutils as strutil
# Minimal Tables: linear-probing hash table (str key)

type
    Table[V] =
        keys: str[]
        vals: V[]
        states: uint8[] # 0=empty, 1=used
        len: int32

type
    Table_string = Table[str]

@borrows
fn __cheng_tables_hashStr(s: str): int32 =
    var h: int32
    if len(s) == 0:
        return 0
    let n: int32 = len(s)
    for i in 0..<n:
        let code: int32 = int32(s[i])
        h = h + code
        h = h + (h << 10)
        h = h ^ (h >> 6)
    h = h + (h << 3)
    h = h ^ (h >> 11)
    h = h + (h << 15)
    return h

@borrows
fn __cheng_tables_hashStrHrt(s: str): int32 =
    var h: int32
    if len(s) == 0:
        return 0
    let n: int32 = len(s)
    for i in 0..<n:
        let code: int32 = int32(s[i])
        h = h + code
        h = h + (h << 10)
        h = h ^ (h >> 6)
    h = h + (h << 3)
    h = h ^ (h >> 11)
    h = h + (h << 15)
    return h

fn __cheng_tables_roundUpPow2(x0: int32): int32 =
    if x0 < 2:
        return 1
    var x: int32 = x0 - 1
    x = x | (x >> 1)
    x = x | (x >> 2)
    x = x | (x >> 4)
    x = x | (x >> 8)
    x = x | (x >> 16)
    x = x + 1
    return x

fn __cheng_tables_initCap(initialCap: int32): int32 =
    if initialCap < 8:
        return __cheng_tables_roundUpPow2(8)
    return __cheng_tables_roundUpPow2(initialCap)

@borrows
fn __cheng_tables_findSlot(t: Table[V], key: str, allowInsert: bool): int32 =
    let cap: int32 = t.keys.len
    if cap < 1 || len(key) == 0:
        return -1
    var probe: int32 = (__cheng_tables_hashStr(key) & 0x7fffffff) % cap
    var scanned: int32
    for scanned in scanned..<cap:
        let st: uint8 = t.states[probe]
        if st == uint8(0):
            if allowInsert:
                return probe
            return -1
        if st == uint8(1) && (t.keys[probe] == key):
            return probe
        probe = probe + 1
        if probe >= cap:
            probe = 0
    return -1

fn __cheng_tables_grow(t: var Table[V]) =
    let oldCap: int32 = t.keys.len
    var growCap: int32 = oldCap * 2
    if growCap < 8:
        growCap = 8
    let newCap: int32 = __cheng_tables_initCap(growCap)

    var keys: str[]
    setLen(keys, newCap)
    var vals: V[]
    setLen(vals, newCap)
    var states: uint8[]
    setLen(states, newCap)
    var nextTable: Table[V] = Table[V](keys: keys, vals: vals, states: states, len: 0)

    for i in 0..<oldCap:
        if t.states[i] == uint8(1):
            let slot: int32 = __cheng_tables_findSlot[V](nextTable, t.keys[i], true)
            if slot >= 0:
                # Owned per-row key copy: the superseded table storage is
                # released by the natural drop at the whole-table rebind below.
                nextTable.keys[slot] = strings.CloneStr(t.keys[i])
                nextTable.vals[slot] = t.vals[i]
                nextTable.states[slot] = uint8(1)
                nextTable.len = nextTable.len + 1

    t = nextTable

fn TableInit(initialCap: int32 = 64): Table[V] =
    let cap: int32 = __cheng_tables_initCap(initialCap)
    var keys: str[]
    setLen(keys, cap)
    var vals: V[]
    setLen(vals, cap)
    var states: uint8[]
    setLen(states, cap)
    return Table[V](keys: keys, vals: vals, states: states, len: 0)

@borrows
fn TableLen(t: Table[V]): int32 =
    return t.len

@borrows
fn TableHas(t: var Table[V], key: str): bool =
    let slot: int32 = __cheng_tables_findSlot[V](t, key, false)
    return slot >= 0

@borrows
@borrow_result
fn TableGet(t: Table[V], key: str): V =
    let slot: int32 = __cheng_tables_findSlot[V](t, key, false)
    if slot < 0:
        panic("tables: missing key")
    return t.vals[slot]

@borrows
fn TableTryGet(t: Table[V], key: str, out: var V): bool =
    let slot: int32 = __cheng_tables_findSlot[V](t, key, false)
    if slot < 0:
        var defaultValue: V
        out = defaultValue
        return false
    out = t.vals[slot]
    return true

@borrows
fn TableTryGet(t: var Table[V], key: str, out: var V): bool =
    let slot: int32 = __cheng_tables_findSlot[V](t, key, false)
    if slot < 0:
        var defaultValue: V
        out = defaultValue
        return false
    out = t.vals[slot]
    return true

@borrows
@borrow_result
fn `[]`(t: Table[V], key: str): V =
    return TableGet[V](t, key)

fn `$`(t: Table[V]): str =
    return strutil.Join(["<Table len=", IntToStr(t.len), ">"], "")

fn TableNext(t: Table[V], cursor: int32, key: var str, val: var V, nextCursor: var int32): bool =
    let cap: int32 = t.keys.len
    if cap < 1:
        nextCursor = 0
        return false
    var i: int32 = cursor
    if i < 0:
        i = 0
    for i in i..<cap:
        if t.states[i] == uint8(1):
            key = t.keys[i]
            val = t.vals[i]
            nextCursor = i + 1
            return true
    nextCursor = cap
    return false

fn TablePut(t: var Table[V], key: str, val: V) =
    if len(key) == 0:
        return
    if t.keys.len < 1:
        t = TableInit[V](64)
    if (t.len + 1) * 10 >= t.keys.len * 7:
        __cheng_tables_grow[V](t)
    let slot: int32 = __cheng_tables_findSlot[V](t, key, true)
    if slot < 0:
        return
    if t.states[slot] != uint8(1):
        t.len = t.len + 1
        t.states[slot] = uint8(1)
    t.keys[slot] = key
    t.vals[slot] = val

fn `[]=`(t: var Table[V], key: str, val: V) =
    TablePut[V](t, key, val)

fn arcRetainTable(t: Table[V]) =
    arcRetainSeq[str](t.keys)
    arcRetainSeq[V](t.vals)
    arcRetainSeq[uint8](t.states)

fn arcReleaseTable(t: Table[V]) =
    arcReleaseSeq[uint8](t.states)
    arcReleaseSeq[V](t.vals)
    arcReleaseSeq[str](t.keys)
