# Mobile Surface: native window surface for Android/HarmonyOS rendering.
# Wraps support/mobile_surface_provider.h via @importc FFI.

# ── String bridge ──

@importc("cheng_str_to_cstring_temp_bridge")
fn __MobileStrToCString(text: str): cstring

# ── Struct types (flat layout, matches C ABI) ──

type
    MobileSurfaceBuffer =
        pixels: ptr
        stride: int32
        width: int32
        height: int32

    MobileSurfaceEvent =
        eventType: int32
        timestampMs: int64
        surfaceWidth: int32
        surfaceHeight: int32
        fingerId: int32
        touchAction: int32
        touchX: int32
        touchY: int32
        pressure: int32
        keyCode: int32
        keyAction: int32
        keyModifiers: int32

# ── Constants ──

const
    MobileEventNone  = 0
    MobileEventTouch = 1
    MobileEventKey   = 2
    MobileEventClose = 3

    MobileTouchDown   = 0
    MobileTouchUp     = 1
    MobileTouchMove   = 2
    MobileTouchCancel = 3

    MobileKeyDown = 0
    MobileKeyUp   = 1

# ── FFI declarations ──

@importc("mobile_surface_create")
fn __mobileSurfaceCreate(width: int32, height: int32, title: cstring): uint64

@importc("mobile_surface_destroy")
fn __mobileSurfaceDestroy(handle: uint64)

@importc("mobile_surface_lock")
fn __mobileSurfaceLock(handle: uint64): MobileSurfaceBuffer

@importc("mobile_surface_unlock")
fn __mobileSurfaceUnlock(handle: uint64)

@importc("mobile_surface_poll_event")
fn __mobileSurfacePollEvent(handle: uint64, out: var MobileSurfaceEvent): int32

# ── Public API ──

fn MobileSurfaceCreate(width: int32, height: int32, title: str): uint64 =
    let ctitle = __MobileStrToCString(title)
    return __mobileSurfaceCreate(width, height, ctitle)

fn MobileSurfaceDestroy(handle: uint64) =
    __mobileSurfaceDestroy(handle)

fn MobileSurfaceLock(handle: uint64): MobileSurfaceBuffer =
    return __mobileSurfaceLock(handle)

fn MobileSurfaceUnlock(handle: uint64) =
    __mobileSurfaceUnlock(handle)

fn MobileSurfacePollEvent(handle: uint64, out: var MobileSurfaceEvent): int32 =
    return __mobileSurfacePollEvent(handle, out)
