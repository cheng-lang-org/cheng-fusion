# ChaCha20-Poly1305 AEAD(RFC 8439).

import std/result
import std/rawbytes
const
    chaChaPolyKeySize: int32 = 32
    chaChaPolyNonceSize: int32 = 12
    chaChaPolyTagSize: int32 = 16
    chaChaStateWords: int32 = 16

type
    ChaChaPolyKey =
        data: Bytes

    ChaChaPolyNonce =
        data: Bytes

    ChaChaPolyTag =
        data: Bytes

@borrows
fn intoChaChaPolyKey(data: Bytes): Result[ChaChaPolyKey] =
    if BytesLen(data) != chaChaPolyKeySize:
        return Err[ChaChaPolyKey]("chacha20poly1305: invalid key size")
    var key: ChaChaPolyKey
    key.data = data
    return Ok[ChaChaPolyKey](key)

@borrows
fn intoChaChaPolyNonce(data: Bytes): Result[ChaChaPolyNonce] =
    if BytesLen(data) != chaChaPolyNonceSize:
        return Err[ChaChaPolyNonce]("chacha20poly1305: invalid nonce size")
    var nonce: ChaChaPolyNonce
    nonce.data = data
    return Ok[ChaChaPolyNonce](nonce)

@borrows
fn intoChaChaPolyTag(data: Bytes): Result[ChaChaPolyTag] =
    if BytesLen(data) != chaChaPolyTagSize:
        return Err[ChaChaPolyTag]("chacha20poly1305: invalid tag size")
    var tag: ChaChaPolyTag
    tag.data = data
    return Ok[ChaChaPolyTag](tag)

fn chachaU32Mask(): int64 =
    return (int64(1) << 32) - 1

fn chachaU32(x: int64): int64 =
    return x & chachaU32Mask()

fn chachaRotl32(value: int64, shift: int32): int64 =
    let mask: int64 = chachaU32Mask()
    let v: int64 = value & mask
    return ((v << shift) | (v >> (32 - shift))) & mask

fn chachaQR(a: var int64, b: var int64, c: var int64, d: var int64) =
    a = chachaU32(a + b)
    d = chachaRotl32(d ^ a, 16)
    c = chachaU32(c + d)
    b = chachaRotl32(b ^ c, 12)
    a = chachaU32(a + b)
    d = chachaRotl32(d ^ a, 8)
    c = chachaU32(c + d)
    b = chachaRotl32(b ^ c, 7)

fn chachaByte0(value: int64): int32 =
    return int32(value & 0xff)

fn chachaByte8(value: int64): int32 =
    return int32((value >> 8) & 0xff)

fn chachaByte16(value: int64): int32 =
    return int32((value >> 16) & 0xff)

fn chachaByte24(value: int64): int32 =
    return int32((value >> 24) & 0xff)

@borrows
fn loadU32LE(data: Bytes, offset: int32): int64 =
    let b0: int64 = int64(BytesGet(data, offset))
    let b1: int64 = int64(BytesGet(data, offset + 1))
    let b2: int64 = int64(BytesGet(data, offset + 2))
    let b3: int64 = int64(BytesGet(data, offset + 3))
    return chachaU32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

fn storeU32LE(data: var Bytes, offset: int32, value: int64) =
    let v: int64 = chachaU32(value)
    BytesSet(data, offset, chachaByte0(v))
    BytesSet(data, offset + 1, chachaByte8(v))
    BytesSet(data, offset + 2, chachaByte16(v))
    BytesSet(data, offset + 3, chachaByte24(v))

# Produce one 64-byte keystream block into a caller-provided buffer (reused across blocks),
# eliminating the per-block triple BytesAlloc. The 16 ChaCha words are held in 16 int64
# locals, so the hot loop never touches the heap or does a bounds-checked word load/store.
@borrows
fn chacha20BlockInto(out: var Bytes, key: Bytes, counter: int32, nonce: Bytes) =
    let o0: int64 = int64(0x61707865)
    let o1: int64 = int64(0x3320646e)
    let o2: int64 = int64(0x79622d32)
    let o3: int64 = int64(0x6b206574)
    let o4: int64 = loadU32LE(key, 0)
    let o5: int64 = loadU32LE(key, 4)
    let o6: int64 = loadU32LE(key, 8)
    let o7: int64 = loadU32LE(key, 12)
    let o8: int64 = loadU32LE(key, 16)
    let o9: int64 = loadU32LE(key, 20)
    let o10: int64 = loadU32LE(key, 24)
    let o11: int64 = loadU32LE(key, 28)
    let o12: int64 = chachaU32(counter)
    let o13: int64 = loadU32LE(nonce, 0)
    let o14: int64 = loadU32LE(nonce, 4)
    let o15: int64 = loadU32LE(nonce, 8)
    var x0: int64 = o0
    var x1: int64 = o1
    var x2: int64 = o2
    var x3: int64 = o3
    var x4: int64 = o4
    var x5: int64 = o5
    var x6: int64 = o6
    var x7: int64 = o7
    var x8: int64 = o8
    var x9: int64 = o9
    var x10: int64 = o10
    var x11: int64 = o11
    var x12: int64 = o12
    var x13: int64 = o13
    var x14: int64 = o14
    var x15: int64 = o15
    # RFC 8439 ChaCha20 double-round. Keep this structured instead of fully
    # inlining it so Android direct object codegen stays below the large-body edge.
    let qrMask: int64 = chachaU32Mask()
    for rounds in 0..<10:
        chachaQR(x0, x4, x8, x12)
        chachaQR(x1, x5, x9, x13)
        chachaQR(x2, x6, x10, x14)
        chachaQR(x3, x7, x11, x15)
        chachaQR(x0, x5, x10, x15)
        chachaQR(x1, x6, x11, x12)
        chachaQR(x2, x7, x8, x13)
        chachaQR(x3, x4, x9, x14)
    storeU32LE(out, 0, (x0 + o0) & qrMask)
    storeU32LE(out, 4, (x1 + o1) & qrMask)
    storeU32LE(out, 8, (x2 + o2) & qrMask)
    storeU32LE(out, 12, (x3 + o3) & qrMask)
    storeU32LE(out, 16, (x4 + o4) & qrMask)
    storeU32LE(out, 20, (x5 + o5) & qrMask)
    storeU32LE(out, 24, (x6 + o6) & qrMask)
    storeU32LE(out, 28, (x7 + o7) & qrMask)
    storeU32LE(out, 32, (x8 + o8) & qrMask)
    storeU32LE(out, 36, (x9 + o9) & qrMask)
    storeU32LE(out, 40, (x10 + o10) & qrMask)
    storeU32LE(out, 44, (x11 + o11) & qrMask)
    storeU32LE(out, 48, (x12 + o12) & qrMask)
    storeU32LE(out, 52, (x13 + o13) & qrMask)
    storeU32LE(out, 56, (x14 + o14) & qrMask)
    storeU32LE(out, 60, (x15 + o15) & qrMask)

@borrows
fn Chacha20Block(key: Bytes, counter: int32, nonce: Bytes): Bytes =
    var out: Bytes = BytesAlloc(64)
    chacha20BlockInto(out, key, counter, nonce)
    return out

@borrows
fn chacha20Xor(data: var Bytes, key: Bytes, nonce: Bytes, counter: int32): Result[bool] =
    # Fused ChaCha20 keystream + word-batch XOR:
    # the 16 working words live in scalar locals through all 10 double rounds,
    # and each generated keystream word is XORed against the message in a
    # single 32-bit word batch (1 loadU32LE + 1 storeU32LE per word),
    # eliminating the intermediate ks buffer AND its per-byte bridge calls.
    let total: int32 = BytesLen(data)
    if total <= 0:
        return Ok[bool](true)
    let mask: int64 = chachaU32Mask()
    let o0: int64 = int64(0x61707865)
    let o1: int64 = int64(0x3320646e)
    let o2: int64 = int64(0x79622d32)
    let o3: int64 = int64(0x6b206574)
    let o4: int64 = loadU32LE(key, 0)
    let o5: int64 = loadU32LE(key, 4)
    let o6: int64 = loadU32LE(key, 8)
    let o7: int64 = loadU32LE(key, 12)
    let o8: int64 = loadU32LE(key, 16)
    let o9: int64 = loadU32LE(key, 20)
    let o10: int64 = loadU32LE(key, 24)
    let o11: int64 = loadU32LE(key, 28)
    let o12: int64 = chachaU32(counter)
    let o13: int64 = loadU32LE(nonce, 0)
    let o14: int64 = loadU32LE(nonce, 4)
    let o15: int64 = loadU32LE(nonce, 8)
    var offset: int32
    var blockCounter: int32 = counter
    while offset < total:
        var x0: int64 = o0
        var x1: int64 = o1
        var x2: int64 = o2
        var x3: int64 = o3
        var x4: int64 = o4
        var x5: int64 = o5
        var x6: int64 = o6
        var x7: int64 = o7
        var x8: int64 = o8
        var x9: int64 = o9
        var x10: int64 = o10
        var x11: int64 = o11
        var x12: int64 = o12
        var x13: int64 = o13
        var x14: int64 = o14
        var x15: int64 = o15
        for rounds in 0..<10:
            chachaQR(x0, x4, x8, x12)
            chachaQR(x1, x5, x9, x13)
            chachaQR(x2, x6, x10, x14)
            chachaQR(x3, x7, x11, x15)
            chachaQR(x0, x5, x10, x15)
            chachaQR(x1, x6, x11, x12)
            chachaQR(x2, x7, x8, x13)
            chachaQR(x3, x4, x9, x14)
        # Tail block (<64 bytes): XOR byte-wise; loadU32LE word-batch below
        # would read past data end (harmless on the old silent-bounds backend,
        # fatal on the new fail-stop x86 bounds codegen).
        if total - offset < 64:
            var ks: Bytes = BytesAlloc(64)
            chacha20BlockInto(ks, key, blockCounter, nonce)
            var bi: int32 = offset
            while bi < total:
                BytesSet(data, bi, BytesGet(data, bi) ^ BytesGet(ks, bi - offset))
                bi = bi + 1
            BytesFree(ks)
            offset = offset + 64
            blockCounter = blockCounter + 1
            continue
        # Word-batched XOR against message data.
        var tmp0: int64 = chachaU32((x0 + o0) & mask) ^ loadU32LE(data, offset + 0)
        var tmp1: int64 = chachaU32((x1 + o1) & mask) ^ loadU32LE(data, offset + 4)
        var tmp2: int64 = chachaU32((x2 + o2) & mask) ^ loadU32LE(data, offset + 8)
        var tmp3: int64 = chachaU32((x3 + o3) & mask) ^ loadU32LE(data, offset + 12)
        var tmp4: int64 = chachaU32((x4 + o4) & mask) ^ loadU32LE(data, offset + 16)
        var tmp5: int64 = chachaU32((x5 + o5) & mask) ^ loadU32LE(data, offset + 20)
        var tmp6: int64 = chachaU32((x6 + o6) & mask) ^ loadU32LE(data, offset + 24)
        var tmp7: int64 = chachaU32((x7 + o7) & mask) ^ loadU32LE(data, offset + 28)
        var tmp8: int64 = chachaU32((x8 + o8) & mask) ^ loadU32LE(data, offset + 32)
        var tmp9: int64 = chachaU32((x9 + o9) & mask) ^ loadU32LE(data, offset + 36)
        var tmp10: int64 = chachaU32((x10 + o10) & mask) ^ loadU32LE(data, offset + 40)
        var tmp11: int64 = chachaU32((x11 + o11) & mask) ^ loadU32LE(data, offset + 44)
        var tmp12: int64 = chachaU32((x12 + o12) & mask) ^ loadU32LE(data, offset + 48)
        var tmp13: int64 = chachaU32((x13 + o13) & mask) ^ loadU32LE(data, offset + 52)
        var tmp14: int64 = chachaU32((x14 + o14) & mask) ^ loadU32LE(data, offset + 56)
        var tmp15: int64 = chachaU32((x15 + o15) & mask) ^ loadU32LE(data, offset + 60)
        storeU32LE(data, offset + 0, tmp0)
        storeU32LE(data, offset + 4, tmp1)
        storeU32LE(data, offset + 8, tmp2)
        storeU32LE(data, offset + 12, tmp3)
        storeU32LE(data, offset + 16, tmp4)
        storeU32LE(data, offset + 20, tmp5)
        storeU32LE(data, offset + 24, tmp6)
        storeU32LE(data, offset + 28, tmp7)
        storeU32LE(data, offset + 32, tmp8)
        storeU32LE(data, offset + 36, tmp9)
        storeU32LE(data, offset + 40, tmp10)
        storeU32LE(data, offset + 44, tmp11)
        storeU32LE(data, offset + 48, tmp12)
        storeU32LE(data, offset + 52, tmp13)
        storeU32LE(data, offset + 56, tmp14)
        storeU32LE(data, offset + 60, tmp15)
        offset = offset + 64
        blockCounter = blockCounter + 1
    return Ok[bool](true)

type
    PolyState =
        r0: int64
        r1: int64
        r2: int64
        r3: int64
        r4: int64
        s1: int64
        s2: int64
        s3: int64
        s4: int64
        h0: int64
        h1: int64
        h2: int64
        h3: int64
        h4: int64

fn poly1305Init(key: Bytes): PolyState =
    let t0: int64 = loadU32LE(key, 0)
    let t1: int64 = loadU32LE(key, 4)
    let t2: int64 = loadU32LE(key, 8)
    let t3: int64 = loadU32LE(key, 12)
    var st: PolyState
    st.r0 = t0 & 0x3ffffff
    st.r1 = ((t0 >> 26) | (t1 << 6)) & 0x3ffff03
    st.r2 = ((t1 >> 20) | (t2 << 12)) & 0x3ffc0ff
    st.r3 = ((t2 >> 14) | (t3 << 18)) & 0x3f03fff
    st.r4 = (t3 >> 8) & 0x00fffff
    st.s1 = st.r1 * 5
    st.s2 = st.r2 * 5
    st.s3 = st.r3 * 5
    st.s4 = st.r4 * 5
    st.h0 = 0
    st.h1 = 0
    st.h2 = 0
    st.h3 = 0
    st.h4 = 0
    return st

fn poly1305Block(st: var PolyState, block: Bytes, hibit: int64) =
    let t0: int64 = loadU32LE(block, 0)
    let t1: int64 = loadU32LE(block, 4)
    let t2: int64 = loadU32LE(block, 8)
    let t3: int64 = loadU32LE(block, 12)
    let b0: int64 = t0 & 0x3ffffff
    let b1: int64 = ((t0 >> 26) | (t1 << 6)) & 0x3ffffff
    let b2: int64 = ((t1 >> 20) | (t2 << 12)) & 0x3ffffff
    let b3: int64 = ((t2 >> 14) | (t3 << 18)) & 0x3ffffff
    let b4: int64 = (t3 >> 8) | hibit
    st.h0 = st.h0 + b0
    st.h1 = st.h1 + b1
    st.h2 = st.h2 + b2
    st.h3 = st.h3 + b3
    st.h4 = st.h4 + b4
    let d0: int64 = st.h0 * st.r0 + st.h1 * st.s4 + st.h2 * st.s3 + st.h3 * st.s2 + st.h4 * st.s1
    let d1: int64 = st.h0 * st.r1 + st.h1 * st.r0 + st.h2 * st.s4 + st.h3 * st.s3 + st.h4 * st.s2
    let d2: int64 = st.h0 * st.r2 + st.h1 * st.r1 + st.h2 * st.r0 + st.h3 * st.s4 + st.h4 * st.s3
    let d3: int64 = st.h0 * st.r3 + st.h1 * st.r2 + st.h2 * st.r1 + st.h3 * st.r0 + st.h4 * st.s4
    let d4: int64 = st.h0 * st.r4 + st.h1 * st.r3 + st.h2 * st.r2 + st.h3 * st.r1 + st.h4 * st.r0
    var c: int64 = d0 >> 26
    st.h0 = d0 & 0x3ffffff
    var d1c: int64 = d1 + c
    c = d1c >> 26
    st.h1 = d1c & 0x3ffffff
    var d2c: int64 = d2 + c
    c = d2c >> 26
    st.h2 = d2c & 0x3ffffff
    var d3c: int64 = d3 + c
    c = d3c >> 26
    st.h3 = d3c & 0x3ffffff
    var d4c: int64 = d4 + c
    c = d4c >> 26
    st.h4 = d4c & 0x3ffffff
    st.h0 = st.h0 + c * 5
    c = st.h0 >> 26
    st.h0 = st.h0 & 0x3ffffff
    st.h1 = st.h1 + c

fn poly1305Tag(key: Bytes, data: Bytes): Bytes =
    var st: PolyState = poly1305Init(key)
    let total: int32 = BytesLen(data)
    # Message-invariant key limbs and the running accumulator hoisted into scalar locals
    # so the multiply-and-reduce hot loop never reloads them through the var PolyState
    # pointer. Under stage3 (no regalloc) a pointer-aliased struct field cannot be kept
    # live across a store, so every st.h* was a real load/store; scalar locals remove
    # that traffic. Arithmetic order is identical to poly1305Block, so the MAC is
    # byte-identical (RFC 8439 KAT unchanged). loadU32LE reads directly at data+offset,
    # dropping the per-block BytesSliceView.
    let r0: int64 = st.r0
    let r1: int64 = st.r1
    let r2: int64 = st.r2
    let r3: int64 = st.r3
    let r4: int64 = st.r4
    let sp1: int64 = st.s1
    let sp2: int64 = st.s2
    let sp3: int64 = st.s3
    let sp4: int64 = st.s4
    var h0: int64 = st.h0
    var h1: int64 = st.h1
    var h2: int64 = st.h2
    var h3: int64 = st.h3
    var h4: int64 = st.h4
    var offset: int32
    while offset + 16 <= total:
        let t0: int64 = loadU32LE(data, offset)
        let t1: int64 = loadU32LE(data, offset + 4)
        let t2: int64 = loadU32LE(data, offset + 8)
        let t3: int64 = loadU32LE(data, offset + 12)
        h0 = h0 + (t0 & 0x3ffffff)
        h1 = h1 + (((t0 >> 26) | (t1 << 6)) & 0x3ffffff)
        h2 = h2 + (((t1 >> 20) | (t2 << 12)) & 0x3ffffff)
        h3 = h3 + (((t2 >> 14) | (t3 << 18)) & 0x3ffffff)
        h4 = h4 + ((t3 >> 8) | (1 << 24))
        let d0: int64 = h0 * r0 + h1 * sp4 + h2 * sp3 + h3 * sp2 + h4 * sp1
        let d1: int64 = h0 * r1 + h1 * r0 + h2 * sp4 + h3 * sp3 + h4 * sp2
        let d2: int64 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * sp4 + h4 * sp3
        let d3: int64 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * sp4
        let d4: int64 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
        var c: int64 = d0 >> 26
        h0 = d0 & 0x3ffffff
        var d1c: int64 = d1 + c
        c = d1c >> 26
        h1 = d1c & 0x3ffffff
        var d2c: int64 = d2 + c
        c = d2c >> 26
        h2 = d2c & 0x3ffffff
        var d3c: int64 = d3 + c
        c = d3c >> 26
        h3 = d3c & 0x3ffffff
        var d4c: int64 = d4 + c
        c = d4c >> 26
        h4 = d4c & 0x3ffffff
        h0 = h0 + c * 5
        c = h0 >> 26
        h0 = h0 & 0x3ffffff
        h1 = h1 + c
        offset = offset + 16
    st.h0 = h0
    st.h1 = h1
    st.h2 = h2
    st.h3 = h3
    st.h4 = h4
    if offset < total:
        var block: Bytes = BytesAlloc(16)
        for i in 0..<total - offset:
            BytesSet(block, i, BytesGet(data, offset + i))
        BytesSet(block, total - offset, 1)
        poly1305Block(st, block, 0)
        BytesFree(block)
    var c: int64 = st.h1 >> 26
    st.h1 = st.h1 & 0x3ffffff
    st.h2 = st.h2 + c
    c = st.h2 >> 26
    st.h2 = st.h2 & 0x3ffffff
    st.h3 = st.h3 + c
    c = st.h3 >> 26
    st.h3 = st.h3 & 0x3ffffff
    st.h4 = st.h4 + c
    c = st.h4 >> 26
    st.h4 = st.h4 & 0x3ffffff
    st.h0 = st.h0 + c * 5
    c = st.h0 >> 26
    st.h0 = st.h0 & 0x3ffffff
    st.h1 = st.h1 + c
    var g0: int64 = st.h0 + 5
    c = g0 >> 26
    g0 = g0 & 0x3ffffff
    var g1: int64 = st.h1 + c
    c = g1 >> 26
    g1 = g1 & 0x3ffffff
    var g2: int64 = st.h2 + c
    c = g2 >> 26
    g2 = g2 & 0x3ffffff
    var g3: int64 = st.h3 + c
    c = g3 >> 26
    g3 = g3 & 0x3ffffff
    var g4: int64 = st.h4 + c - (1 << 26)
    if g4 >= 0:
        st.h0 = g0
        st.h1 = g1
        st.h2 = g2
        st.h3 = g3
        st.h4 = g4
    let f0: int64 = chachaU32(st.h0 | (st.h1 << 26))
    let f1: int64 = chachaU32((st.h1 >> 6) | (st.h2 << 20))
    let f2: int64 = chachaU32((st.h2 >> 12) | (st.h3 << 14))
    let f3: int64 = chachaU32((st.h3 >> 18) | (st.h4 << 8))
    let s0: int64 = loadU32LE(key, 16)
    let s1: int64 = loadU32LE(key, 20)
    let s2: int64 = loadU32LE(key, 24)
    let s3: int64 = loadU32LE(key, 28)
    var t0: int64 = f0 + s0
    var t1: int64 = f1 + s1 + (t0 >> 32)
    var t2: int64 = f2 + s2 + (t1 >> 32)
    var t3: int64 = f3 + s3 + (t2 >> 32)
    var tag: Bytes = BytesAlloc(16)
    storeU32LE(tag, 0, t0)
    storeU32LE(tag, 4, t1)
    storeU32LE(tag, 8, t2)
    storeU32LE(tag, 12, t3)
    return tag

fn storeU64LE(data: Bytes, offset: int32, value: int64) =
    var v: int64 = value
    var i: int32
    while i < 8:
        BytesSet(data, offset + i, int32(v & 0xff))
        v = v >> 8
        i = i + 1

# Assemble the Poly1305 MAC input (aad || zero-pad16 || ciphertext || zero-pad16 ||
# u64le(aadLen) || u64le(ctLen)) directly into one presized buffer. BytesAlloc zero-fills
# so the pad regions need no writes; the two payloads go in via bulk RawmemCopy. This
# replaces the old ByteBuffer append form which reallocated + copied the whole growing
# buffer on every appendByte (~31 reallocs + a redundant full-ciphertext copy per record).
fn buildPoly1305Input(aad: Bytes, ciphertext: Bytes): Bytes =
    let aadLen: int32 = BytesLen(aad)
    let ctLen: int32 = BytesLen(ciphertext)
    let padAad: int32 = (16 - aadLen % 16) % 16
    let padCt: int32 = (16 - ctLen % 16) % 16
    let total: int32 = aadLen + padAad + ctLen + padCt + 16
    let out: Bytes = BytesAlloc(total)
    if aadLen > 0:
        BytesCopyInto(out, 0, aad)
    if ctLen > 0:
        BytesCopyInto(out, aadLen + padAad, ciphertext)
    let lenOffset: int32 = aadLen + padAad + ctLen + padCt
    storeU64LE(out, lenOffset, int64(aadLen))
    storeU64LE(out, lenOffset + 8, int64(ctLen))
    return out

@borrows
fn tagEqual(a: Bytes, b: Bytes): bool =
    if BytesLen(a) != BytesLen(b):
        return false
    var diff: int32
    for i in 0..<BytesLen(a):
        diff = diff | (BytesGet(a, i) ^ BytesGet(b, i))
    return diff == 0

@borrows
fn encrypt(key: ChaChaPolyKey, nonce: ChaChaPolyNonce, tag: var ChaChaPolyTag, data: Bytes, aad: Bytes): Result[bool] =
    if BytesLen(key.data) != chaChaPolyKeySize:
        return Err[bool]("chacha20poly1305: invalid key")
    if BytesLen(nonce.data) != chaChaPolyNonceSize:
        return Err[bool]("chacha20poly1305: invalid nonce")
    var block0: Bytes = Chacha20Block(key.data, 0, nonce.data)
    var polyKey: Bytes = BytesSlice(block0, 0, 32)
    let xorRes: Result[bool] = chacha20Xor(data, key.data, nonce.data, 1)
    if IsErr(xorRes):
        BytesFree(block0)
        BytesFree(polyKey)
        return Err[bool](Error(xorRes))
    var macInput: Bytes = buildPoly1305Input(aad, data)
    let tagBytes: Bytes = poly1305Tag(polyKey, macInput)
    tag.data = tagBytes
    BytesFree(block0)
    BytesFree(polyKey)
    BytesFree(macInput)
    return Ok[bool](true)

fn decrypt(key: ChaChaPolyKey, nonce: ChaChaPolyNonce, tag: ChaChaPolyTag, data: Bytes, aad: Bytes): Result[bool] =
    if BytesLen(key.data) != chaChaPolyKeySize:
        return Err[bool]("chacha20poly1305: invalid key")
    if BytesLen(nonce.data) != chaChaPolyNonceSize:
        return Err[bool]("chacha20poly1305: invalid nonce")
    if BytesLen(tag.data) != chaChaPolyTagSize:
        return Err[bool]("chacha20poly1305: invalid tag")
    var block0: Bytes = Chacha20Block(key.data, 0, nonce.data)
    var polyKey: Bytes = BytesSlice(block0, 0, 32)
    var macInput: Bytes = buildPoly1305Input(aad, data)
    var expect: Bytes = poly1305Tag(polyKey, macInput)
    if ! tagEqual(expect, tag.data):
        BytesFree(block0)
        BytesFree(polyKey)
        BytesFree(macInput)
        BytesFree(expect)
        return Err[bool]("chacha20poly1305: tag mismatch")
    let xorRes: Result[bool] = chacha20Xor(data, key.data, nonce.data, 1)
    if IsErr(xorRes):
        BytesFree(block0)
        BytesFree(polyKey)
        BytesFree(macInput)
        BytesFree(expect)
        return Err[bool](Error(xorRes))
    BytesFree(block0)
    BytesFree(polyKey)
    BytesFree(macInput)
    BytesFree(expect)
    return Ok[bool](true)
