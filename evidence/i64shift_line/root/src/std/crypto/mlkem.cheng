# ML-KEM (FIPS 203) — K-PKE (Algorithms 13/14/15) and ML-KEM
# (Algorithms 16/17/18 internal, 19/20/21 public) on top of the
# polynomial math layer in std/crypto/mlkem_poly.
#   H = SHA3-256, G = SHA3-512, J = SHAKE256(., 32),
#   PRF_eta(s, b) = SHAKE256(s || b, 64*eta).
# Vectors of k polynomials are stored as flat int32[] of length k*256;
# the k x k matrix A_hat is flat int32[] of length k*k*256, row-major,
# A_hat[i][j] = SampleNTT(rho || j || i) per FIPS 203 index order.
# All coefficients stay canonical in [0, q); every value fits int32.

import std/result
import std/system
import std/rawbytes
import std/crypto/sha3
import std/crypto/mlkem_poly
import std/crypto/rand

type
    MlkemParams =
        k: int32
        eta1: int32
        eta2: int32
        du: int32
        dv: int32

    MlkemKeyPair =
        ek: Bytes
        dk: Bytes

    MlkemEncapsResult =
        sharedSecret: Bytes
        ciphertext: Bytes

fn MlkemParams512(): MlkemParams =
    var p: MlkemParams
    p.k = 2
    p.eta1 = 3
    p.eta2 = 2
    p.du = 10
    p.dv = 4
    return p

fn MlkemParams768(): MlkemParams =
    var p: MlkemParams
    p.k = 3
    p.eta1 = 2
    p.eta2 = 2
    p.du = 10
    p.dv = 4
    return p

fn MlkemParams1024(): MlkemParams =
    var p: MlkemParams
    p.k = 4
    p.eta1 = 2
    p.eta2 = 2
    p.du = 11
    p.dv = 5
    return p

fn MlkemEkLen(p: MlkemParams): int32 =
    return 384 * p.k + 32

fn MlkemDkLen(p: MlkemParams): int32 =
    return 768 * p.k + 96

fn MlkemCtLen(p: MlkemParams): int32 =
    return 32 * (p.du * p.k + p.dv)

fn MlkemSharedSecretLen(): int32 =
    return 32

# PRF_eta(s, b) = SHAKE256(s || b, 64*eta), s is 32 bytes, b one byte.
fn mlkemPrf(s: Bytes, b: int32, eta: int32): Bytes =
    Assert(BytesLen(s) == 32, "mlkemPrf: seed must be 32 bytes")
    let input: Bytes = BytesAlloc(33)
    BytesCopyInto(input, 0, s)
    BytesSet(input, 32, b)
    return Shake256Xof(input, 64 * eta)

# Copy polynomial slot i out of a flat vector.
@borrows
fn mlkemVecPoly(v: int32[], i: int32): int32[] =
    var p: int32[]
    setLen(p, 256)
    let base: int32 = i * 256
    for t in 0..<256:
        p[t] = v[base + t]
    return p

# Copy polynomial p into slot i of a flat vector.
fn mlkemVecSetPoly(v: var int32[], i: int32, p: int32[]) =
    let base: int32 = i * 256
    for t in 0..<256:
        v[base + t] = p[t]

# Generate A_hat from rho: A_hat[i][j] = SampleNTT(rho || j || i).
fn mlkemMatrixGen(rho: Bytes, k: int32): int32[] =
    Assert(BytesLen(rho) == 32, "mlkemMatrixGen: rho must be 32 bytes")
    var a: int32[]
    setLen(a, k * k * 256)
    for i in 0..<k:
        for j in 0..<k:
            let seed: Bytes = BytesAlloc(34)
            BytesCopyInto(seed, 0, rho)
            BytesSet(seed, 32, j)
            BytesSet(seed, 33, i)
            mlkemVecSetPoly(a, i * k + j, MlkemSampleNtt(seed))
    return a

# Compress_d applied per coefficient.
fn mlkemPolyCompress(f: int32[], d: int32): int32[] =
    var g: int32[]
    setLen(g, 256)
    for t in 0..<256:
        g[t] = MlkemCompress(f[t], d)
    return g

# Decompress_d applied per coefficient.
fn mlkemPolyDecompress(f: int32[], d: int32): int32[] =
    var g: int32[]
    setLen(g, 256)
    for t in 0..<256:
        g[t] = MlkemDecompress(f[t], d)
    return g

# FIPS 203 Algorithm 13: K-PKE.KeyGen(d) -> (ek_PKE, dk_PKE).
fn MlkemPkeKeyGen(p: MlkemParams, d: Bytes): MlkemKeyPair =
    Assert(BytesLen(d) == 32, "MlkemPkeKeyGen: d must be 32 bytes")
    let k: int32 = p.k
    let seedInput: Bytes = BytesAlloc(33)
    BytesCopyInto(seedInput, 0, d)
    BytesSet(seedInput, 32, k)
    let g: Bytes = Sha3_512Digest(seedInput)
    let rho: Bytes = BytesSlice(g, 0, 32)
    let sigma: Bytes = BytesSlice(g, 32, 32)
    let aHat: int32[] = mlkemMatrixGen(rho, k)
    var n: int32
    var sHat: int32[]
    setLen(sHat, k * 256)
    for i in 0..<k:
        var s: int32[] = MlkemSamplePolyCbd(mlkemPrf(sigma, n, p.eta1), p.eta1)
        n = n + 1
        MlkemNtt(s)
        mlkemVecSetPoly(sHat, i, s)
    var eHat: int32[]
    setLen(eHat, k * 256)
    for i in 0..<k:
        var e: int32[] = MlkemSamplePolyCbd(mlkemPrf(sigma, n, p.eta1), p.eta1)
        n = n + 1
        MlkemNtt(e)
        mlkemVecSetPoly(eHat, i, e)
    let ek: Bytes = BytesAlloc(384 * k + 32)
    let dk: Bytes = BytesAlloc(384 * k)
    for i in 0..<k:
        # t_hat[i] = sum_j A_hat[i][j] o s_hat[j] + e_hat[i]
        var acc: int32[] = mlkemVecPoly(eHat, i)
        for j in 0..<k:
            acc = MlkemPolyAdd(acc, MlkemMultiplyNtts(mlkemVecPoly(aHat, i * k + j), mlkemVecPoly(sHat, j)))
        BytesCopyInto(ek, 384 * i, MlkemByteEncode(acc, 12))
        BytesCopyInto(dk, 384 * i, MlkemByteEncode(mlkemVecPoly(sHat, i), 12))
    BytesCopyInto(ek, 384 * k, rho)
    var out: MlkemKeyPair
    out.ek = ek
    out.dk = dk
    return out

# FIPS 203 Algorithm 14: K-PKE.Encrypt(ek_PKE, m, r) -> c.
fn MlkemPkeEncrypt(p: MlkemParams, ekPke: Bytes, m: Bytes, r: Bytes): Bytes =
    let k: int32 = p.k
    Assert(BytesLen(ekPke) == 384 * k + 32, "MlkemPkeEncrypt: ek length wrong")
    Assert(BytesLen(m) == 32, "MlkemPkeEncrypt: m must be 32 bytes")
    Assert(BytesLen(r) == 32, "MlkemPkeEncrypt: r must be 32 bytes")
    var tHat: int32[]
    setLen(tHat, k * 256)
    for i in 0..<k:
        mlkemVecSetPoly(tHat, i, MlkemByteDecode(BytesSlice(ekPke, 384 * i, 384), 12))
    let rho: Bytes = BytesSlice(ekPke, 384 * k, 32)
    let aHat: int32[] = mlkemMatrixGen(rho, k)
    var n: int32
    var yHat: int32[]
    setLen(yHat, k * 256)
    for i in 0..<k:
        var y: int32[] = MlkemSamplePolyCbd(mlkemPrf(r, n, p.eta1), p.eta1)
        n = n + 1
        MlkemNtt(y)
        mlkemVecSetPoly(yHat, i, y)
    var e1: int32[]
    setLen(e1, k * 256)
    for i in 0..<k:
        mlkemVecSetPoly(e1, i, MlkemSamplePolyCbd(mlkemPrf(r, n, p.eta2), p.eta2))
        n = n + 1
    let e2: int32[] = MlkemSamplePolyCbd(mlkemPrf(r, n, p.eta2), p.eta2)
    let c: Bytes = BytesAlloc(32 * (p.du * k + p.dv))
    for i in 0..<k:
        # u[i] = INTT(sum_j A_hat[j][i] o y_hat[j]) + e1[i]  (A transposed)
        var acc: int32[] = MlkemPolyNew()
        for j in 0..<k:
            acc = MlkemPolyAdd(acc, MlkemMultiplyNtts(mlkemVecPoly(aHat, j * k + i), mlkemVecPoly(yHat, j)))
        MlkemIntt(acc)
        let u: int32[] = MlkemPolyAdd(acc, mlkemVecPoly(e1, i))
        BytesCopyInto(c, 32 * p.du * i, MlkemByteEncode(mlkemPolyCompress(u, p.du), p.du))
    # v = INTT(t_hat . y_hat) + e2 + Decompress_1(ByteDecode_1(m))
    var vAcc: int32[] = MlkemPolyNew()
    for j in 0..<k:
        vAcc = MlkemPolyAdd(vAcc, MlkemMultiplyNtts(mlkemVecPoly(tHat, j), mlkemVecPoly(yHat, j)))
    MlkemIntt(vAcc)
    let mu: int32[] = mlkemPolyDecompress(MlkemByteDecode(m, 1), 1)
    let v: int32[] = MlkemPolyAdd(MlkemPolyAdd(vAcc, e2), mu)
    BytesCopyInto(c, 32 * p.du * k, MlkemByteEncode(mlkemPolyCompress(v, p.dv), p.dv))
    return c

# FIPS 203 Algorithm 15: K-PKE.Decrypt(dk_PKE, c) -> m.
fn MlkemPkeDecrypt(p: MlkemParams, dkPke: Bytes, c: Bytes): Bytes =
    let k: int32 = p.k
    Assert(BytesLen(dkPke) == 384 * k, "MlkemPkeDecrypt: dk length wrong")
    Assert(BytesLen(c) == 32 * (p.du * k + p.dv), "MlkemPkeDecrypt: c length wrong")
    # w = v' - INTT(s_hat . NTT(u'))
    var acc: int32[] = MlkemPolyNew()
    for i in 0..<k:
        var u: int32[] = mlkemPolyDecompress(MlkemByteDecode(BytesSlice(c, 32 * p.du * i, 32 * p.du), p.du), p.du)
        MlkemNtt(u)
        let sHatI: int32[] = MlkemByteDecode(BytesSlice(dkPke, 384 * i, 384), 12)
        acc = MlkemPolyAdd(acc, MlkemMultiplyNtts(sHatI, u))
    MlkemIntt(acc)
    let v: int32[] = mlkemPolyDecompress(MlkemByteDecode(BytesSlice(c, 32 * p.du * k, 32 * p.dv), p.dv), p.dv)
    let w: int32[] = MlkemPolySub(v, acc)
    return MlkemByteEncode(mlkemPolyCompress(w, 1), 1)

# FIPS 203 Algorithm 16: ML-KEM.KeyGen_internal(d, z) -> (ek, dk).
fn MlkemKeyGenInternal(p: MlkemParams, d: Bytes, z: Bytes): MlkemKeyPair =
    Assert(BytesLen(d) == 32, "MlkemKeyGenInternal: d must be 32 bytes")
    Assert(BytesLen(z) == 32, "MlkemKeyGenInternal: z must be 32 bytes")
    let k: int32 = p.k
    let pke: MlkemKeyPair = MlkemPkeKeyGen(p, d)
    # dk = dk_PKE || ek || H(ek) || z
    let dk: Bytes = BytesAlloc(768 * k + 96)
    BytesCopyInto(dk, 0, pke.dk)
    BytesCopyInto(dk, 384 * k, pke.ek)
    BytesCopyInto(dk, 768 * k + 32, Sha3_256Digest(pke.ek))
    BytesCopyInto(dk, 768 * k + 64, z)
    var out: MlkemKeyPair
    out.ek = pke.ek
    out.dk = dk
    return out

# FIPS 203 Algorithm 17: ML-KEM.Encaps_internal(ek, m) -> (K, c).
fn MlkemEncapsInternal(p: MlkemParams, ek: Bytes, m: Bytes): MlkemEncapsResult =
    Assert(BytesLen(ek) == 384 * p.k + 32, "MlkemEncapsInternal: ek length wrong")
    Assert(BytesLen(m) == 32, "MlkemEncapsInternal: m must be 32 bytes")
    let g: Bytes = Sha3_512Digest(BytesConcat(m, Sha3_256Digest(ek)))
    var out: MlkemEncapsResult
    out.sharedSecret = BytesSlice(g, 0, 32)
    out.ciphertext = MlkemPkeEncrypt(p, ek, m, BytesSlice(g, 32, 32))
    return out

# FIPS 203 Algorithm 18: ML-KEM.Decaps_internal(dk, c) -> K.
# Implicit rejection: K_bar = J(z || c) is returned when the re-encrypted
# ciphertext does not match c.
fn MlkemDecapsInternal(p: MlkemParams, dk: Bytes, c: Bytes): Bytes =
    let k: int32 = p.k
    Assert(BytesLen(dk) == 768 * k + 96, "MlkemDecapsInternal: dk length wrong")
    Assert(BytesLen(c) == 32 * (p.du * k + p.dv), "MlkemDecapsInternal: c length wrong")
    let dkPke: Bytes = BytesSlice(dk, 0, 384 * k)
    let ekPke: Bytes = BytesSlice(dk, 384 * k, 384 * k + 32)
    let h: Bytes = BytesSlice(dk, 768 * k + 32, 32)
    let z: Bytes = BytesSlice(dk, 768 * k + 64, 32)
    let mPrime: Bytes = MlkemPkeDecrypt(p, dkPke, c)
    let g: Bytes = Sha3_512Digest(BytesConcat(mPrime, h))
    let kPrime: Bytes = BytesSlice(g, 0, 32)
    let rPrime: Bytes = BytesSlice(g, 32, 32)
    let kBar: Bytes = Shake256Xof(BytesConcat(z, c), 32)
    let cPrime: Bytes = MlkemPkeEncrypt(p, ekPke, mPrime, rPrime)
    if !BytesEqual(c, cPrime):
        return kBar
    return kPrime

# Encapsulation key check (FIPS 203 7.2): length + modulus check via
# decode/encode round-trip (ByteDecode_12 reduces mod q, so a non-canonical
# coefficient re-encodes differently).
fn MlkemEkValid(p: MlkemParams, ek: Bytes): bool =
    if BytesLen(ek) != 384 * p.k + 32:
        return false
    for i in 0..<p.k:
        let seg: Bytes = BytesSlice(ek, 384 * i, 384)
        if !BytesEqual(MlkemByteEncode(MlkemByteDecode(seg, 12), 12), seg):
            return false
    return true

# Decapsulation key check (FIPS 203 7.3): length + hash consistency
# H(ek) == dk[768k+32 : 768k+64].
fn MlkemDkValid(p: MlkemParams, dk: Bytes): bool =
    if BytesLen(dk) != 768 * p.k + 96:
        return false
    let ekPke: Bytes = BytesSlice(dk, 384 * p.k, 384 * p.k + 32)
    let h: Bytes = BytesSlice(dk, 768 * p.k + 32, 32)
    return BytesEqual(Sha3_256Digest(ekPke), h)

# FIPS 203 Algorithm 19: ML-KEM.KeyGen() with fresh randomness.
fn MlkemKeyGen(p: MlkemParams): Result[MlkemKeyPair] =
    let dRes: Result[Bytes] = randomBytes(32)
    if IsErr(dRes):
        return Err[MlkemKeyPair](Error(dRes))
    let zRes: Result[Bytes] = randomBytes(32)
    if IsErr(zRes):
        return Err[MlkemKeyPair](Error(zRes))
    return Ok[MlkemKeyPair](MlkemKeyGenInternal(p, Value(dRes), Value(zRes)))

# FIPS 203 Algorithm 20: ML-KEM.Encaps(ek) with fresh randomness.
fn MlkemEncaps(p: MlkemParams, ek: Bytes): Result[MlkemEncapsResult] =
    if !MlkemEkValid(p, ek):
        return Err[MlkemEncapsResult]("mlkem: invalid encapsulation key")
    let mRes: Result[Bytes] = randomBytes(32)
    if IsErr(mRes):
        return Err[MlkemEncapsResult](Error(mRes))
    return Ok[MlkemEncapsResult](MlkemEncapsInternal(p, ek, Value(mRes)))

# FIPS 203 Algorithm 21: ML-KEM.Decaps(dk, c).
fn MlkemDecaps(p: MlkemParams, dk: Bytes, c: Bytes): Result[Bytes] =
    if BytesLen(c) != 32 * (p.du * p.k + p.dv):
        return Err[Bytes]("mlkem: invalid ciphertext length")
    if !MlkemDkValid(p, dk):
        return Err[Bytes]("mlkem: invalid decapsulation key")
    return Ok[Bytes](MlkemDecapsInternal(p, dk, c))
