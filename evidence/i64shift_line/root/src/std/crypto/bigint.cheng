# Big integer helpers(unsigned, base 2^32).
#
# NOTE: We store limbs in `int32`, but treat them as unsigned 32-bit words.
# This avoids signed-compare bugs (e.g. modulus MSW >= 0x80000000) while
# also avoiding relying on unsigned codegen for critical crypto paths.

import std/result
import std/rawbytes

const
    bigIntWordBits = 32
    maxBigIntLimbs = 256
    maxBigIntHalfDigits = maxBigIntLimbs * 2
    bigIntWordBase: int64 = int64(1) << 32
    bigModInvOddBinaryMaxSteps = maxBigIntLimbs * bigIntWordBits * 16

type
    BigInt =
        count: int32
        # Little-endian 32-bit limbs (stored as int32, interpreted unsigned).
        limbs: int32[maxBigIntLimbs]

    BigMontgomeryContext =
        modulus: BigInt
        modulusCount: int32
        n0Inv: uint64
        r2: BigInt
        oneMont: BigInt

    BigMontgomeryScratch =
        low: int32[maxBigIntLimbs]
        high: int32[maxBigIntLimbs]
        top: int32

fn bigWordToU64(w: int32): int64 =
    let bits: uint64 = bigWordToBitsU64(w)
    return int64(bits)

fn bigWordFromU64(v: int64): int32 =
    if v >= 0:
        return bigWordFromBitsU64(uint64(v))
    let mag: int64 = int64(0) - v
    let magBits: uint64 = uint64(mag)
    let magShifted: uint64 = (magBits >> uint64(bigIntWordBits)) << uint64(bigIntWordBits)
    let magLow: uint64 = magBits - magShifted
    if magLow == 0:
        return 0
    let lowBits: uint64 = (uint64(1) << uint64(bigIntWordBits)) - magLow
    return bigWordFromBitsU64(lowBits)

@borrows
fn bigWordToBitsU64(w: int32): uint64 =
    if w >= 0:
        return uint64(w)
    return (uint64(1) << uint64(bigIntWordBits)) - uint64(int64(0) - int64(w))

fn bigWordFromBitsU64(v: uint64): int32 =
    let low: uint64 = v - ((v >> uint64(bigIntWordBits)) << uint64(bigIntWordBits))
    if low < (uint64(1) << uint64(bigIntWordBits - 1)):
        return int32(low)
    return 0 - int32((uint64(1) << uint64(bigIntWordBits)) - low)

@borrows
fn bigLowHalfBitsU64(v: uint64): uint64 =
    let hi: uint64 = v >> uint64(16)
    return v - (hi << uint64(16))

@borrows
fn bigLowWordBitsU64(v: uint64): uint64 =
    let hi: uint64 = v >> uint64(bigIntWordBits)
    return v - (hi << uint64(bigIntWordBits))

@borrows
fn bigLowByte(v: uint64): int32 =
    let hi: uint64 = v >> uint64(8)
    return int32(v - (hi << uint64(8)))

fn bigBorrowFromWide(wide: int64): int64 =
    return int64(1) - (wide >> bigIntWordBits)

fn bigZero(): BigInt =
    BigInt(count: 0)

@borrows
fn bigCountValueValid(count: int32): bool =
    return count >= 0 && count <= maxBigIntLimbs

@borrows
fn bigIsZero(a: BigInt): bool =
    if ! bigCountValueValid(a.count):
        return false
    return a.count <= 0

@borrows
fn bigIsOdd(a: BigInt): bool =
    if ! bigCountValueValid(a.count):
        return false
    return a.count > 0 && (bigWordToU64(a.limbs[0]) & 1) != 0

fn bigNormalize(a: var BigInt) =
    if a.count < 0 || a.count > maxBigIntLimbs:
        a.count = 0
        return
    let iStart3 = a.count - 1
    if iStart3 >= 0:
        for iOffset3 in 0..iStart3:
            let i = iStart3 - iOffset3
            if a.limbs[i] != 0:
                a.count = i + 1
                return
    a.count = 0

@borrows
fn bigFromInt(value: int64): BigInt =
    if value <= 0:
        return BigInt(count: 0)
    var out: BigInt
    var bits: uint64 = uint64(value)
    var i: int32
    var nBits: int32
    var tmp: uint64 = bits
    while tmp != uint64(0):
        tmp = tmp >> uint64(bigIntWordBits)
        nBits = nBits + 1
    for _ in range(nBits):
        out.limbs[i] = bigWordFromBitsU64(bits)
        bits = bits >> uint64(bigIntWordBits)
        i = i + 1
    out.count = i
    return out

@borrows
fn bigCopy(a: BigInt): BigInt =
    var out: BigInt
    if ! bigCountValueValid(a.count):
        return out
    out.count = a.count
    var i: int32
    for i in i..<a.count:
        out.limbs[i] = a.limbs[i]
    return out

@borrows
fn bigCmp(a: BigInt, b: BigInt): int32 =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count):
        return 1
    if a.count < b.count:
        return -1
    if a.count > b.count:
        return 1
    let iStart2 = a.count - 1
    if iStart2 >= 0:
        for iOffset2 in 0..iStart2:
            let i = iStart2 - iOffset2
            let av: int64 = bigWordToU64(a.limbs[i])
            let bv: int64 = bigWordToU64(b.limbs[i])
            if av < bv:
                return -1
            if av > bv:
                return 1
    return 0

@borrows
fn bigAdd(a: BigInt, b: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count):
        return Err[BigInt]("bigint: add invalid count")
    var out: BigInt
    var maxCount: int32 = a.count
    if b.count > maxCount:
        maxCount = b.count
    var carry: int64
    var i: int32
    for i in i..<maxCount:
        var av: int64
        if i < a.count:
            av = bigWordToU64(a.limbs[i])
        var bv: int64
        if i < b.count:
            bv = bigWordToU64(b.limbs[i])
        let sum: int64 = av + bv + carry
        let sumWord: int32 = bigWordFromU64(sum)
        out.limbs[i] = sumWord
        carry = sum >> bigIntWordBits
    if carry != 0:
        if maxCount >= maxBigIntLimbs:
            return Err[BigInt]("bigint: add overflow")
        let carryWord: int32 = bigWordFromU64(carry)
        out.limbs[maxCount] = carryWord
        out.count = maxCount + 1
    else:
        out.count = maxCount
    return Ok[BigInt](out)

@borrows
fn bigSub(a: BigInt, b: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count):
        return Err[BigInt]("bigint: subtract invalid count")
    if bigCmp(a, b) < 0:
        return Err[BigInt]("bigint: negative result")
    var out: BigInt
    out.count = a.count
    var borrow: int64
    var i: int32
    for i in i..<a.count:
        let av: int64 = bigWordToU64(a.limbs[i])
        var bv: int64
        if i < b.count:
            bv = bigWordToU64(b.limbs[i])
        let wide: int64 = av - bv - borrow
        let wideWord: int32 = bigWordFromU64(wide)
        out.limbs[i] = wideWord
        if wide < 0:
            borrow = 1
        else:
            borrow = 0
    bigNormalize(out)
    return Ok[BigInt](out)

@borrows
fn bigAddInt(a: BigInt, value: int32): Result[BigInt] =
    if value < 0:
        return Err[BigInt]("bigint: add negative")
    let valueBig: BigInt = bigFromInt(int64(value))
    return bigAdd(a, valueBig)

@borrows
fn bigShiftLeft1(a: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count):
        return Err[BigInt]("bigint: shift invalid count")
    if a.count <= 0:
        return Ok[BigInt](a)
    var inBytes: Bytes = bigToBytes(a, 0)
    let inLen: int32 = BytesLen(inBytes)
    let top: int32 = BytesGet(inBytes, 0)
    var outLen: int32 = inLen
    if (top & 0x80) != 0:
        if inLen >= maxBigIntLimbs * 4:
            BytesFree(inBytes)
            return Err[BigInt]("bigint: shift overflow")
        outLen = outLen + 1
    var outBytes: Bytes = BytesAlloc(outLen)
    var carry: int32
    var srcIdx: int32 = inLen - 1
    var dstIdx: int32 = outLen - 1
    for _ in range(inLen):
        let cur: int32 = BytesGet(inBytes, srcIdx)
        let shifted: int32 = ((cur << 1) & 0xff) | carry
        carry = (cur >> 7) & 1
        BytesSet(outBytes, dstIdx, shifted)
        srcIdx = srcIdx - 1
        dstIdx = dstIdx - 1
    if dstIdx >= 0:
        BytesSet(outBytes, dstIdx, carry)
    let res: Result[BigInt] = bigFromBytes(outBytes)
    BytesFree(inBytes)
    BytesFree(outBytes)
    return res

@borrows
fn bigShiftRight1(a: BigInt): BigInt =
    if ! bigCountValueValid(a.count):
        return BigInt(count: 0)
    if a.count <= 0:
        # @borrows: return an owned copy, not the borrowed input itself.
        var emptyOut: BigInt
        bigCopyInto(emptyOut, a)
        return emptyOut
    var inBytes: Bytes = bigToBytes(a, 0)
    let inLen: int32 = BytesLen(inBytes)
    var outBytes: Bytes = BytesAlloc(inLen)
    var carry: int32
    var i: int32
    for i in i..<inLen:
        let cur: int32 = BytesGet(inBytes, i)
        BytesSet(outBytes, i, (cur >> 1) | (carry << 7))
        carry = cur & 1
    let res: BigInt = Value(bigFromBytes(outBytes))
    BytesFree(inBytes)
    BytesFree(outBytes)
    return res

@borrows
fn bigBitLen(a: BigInt): int32 =
    if a.count <= 0:
        return 0
    if a.count > maxBigIntLimbs:
        return -1
    var v: int64 = bigWordToU64(a.limbs[a.count - 1])
    var bits: int32 = (a.count - 1) * bigIntWordBits
    var nBits: int32
    var vTmp: int64 = v
    while vTmp > 0:
        vTmp = vTmp >> 1
        nBits = nBits + 1
    return bits + nBits

@borrows
fn bigGetBit(a: BigInt, idx: int32): int32 =
    if idx < 0:
        return 0
    if ! bigCountValueValid(a.count):
        return 0
    let limbIdx: int32 = idx / bigIntWordBits
    if limbIdx < 0 || limbIdx >= a.count:
        return 0
    let bitIdx: int32 = idx % bigIntWordBits
    let v: int64 = bigWordToU64(a.limbs[limbIdx])
    return int32((v >> bitIdx) & 1)

@borrows
fn bigFromBytes(data: Bytes): Result[BigInt] =
    let n: int32 = BytesLen(data)
    if n <= 0:
        return Ok[BigInt](BigInt(count: 0))
    let limbCount: int32 = (n + 3) / 4
    if limbCount > maxBigIntLimbs:
        return Err[BigInt]("bigint: input too large")
    var out: BigInt
    out.count = limbCount
    for i in range(limbCount):
        let start: int32 = n - (i + 1) * 4
        var acc: int64
        var j: int32
        for j in j..<4:
            let idx: int32 = start + j
            acc = acc << 8
            if idx >= 0 && idx < n:
                acc = acc | int64(BytesGet(data, idx))
        let accWord: int32 = bigWordFromU64(acc)
        out.limbs[i] = accWord
    bigNormalize(out)
    return Ok[BigInt](out)

@borrows
fn bigToBytes(a: BigInt, minLen: int32): Bytes =
    if a.count <= 0:
        let outLen: int32 = if minLen > 0: minLen else: 1
        return BytesAlloc(outLen)
    if a.count > maxBigIntLimbs:
        return BytesAlloc(0)
    let bits: int32 = bigBitLen(a)
    if bits < 0:
        return BytesAlloc(0)
    let rawLen: int32 = (bits + 7) / 8
    let outLen: int32 = if minLen > rawLen: minLen else: rawLen
    let out: Bytes = BytesAlloc(outLen)
    var i: int32
    for i in i..<outLen:
        let byteIdx: int32 = outLen - 1 - i
        let bitIdx: int32 = i * 8
        let limbIdx: int32 = bitIdx / bigIntWordBits
        let shift: int32 = bitIdx % bigIntWordBits
        var v: int64
        if limbIdx < a.count:
            v = bigWordToU64(a.limbs[limbIdx]) >> shift
        if shift > 24 && limbIdx + 1 < a.count:
            v = v | (bigWordToU64(a.limbs[limbIdx + 1]) << (bigIntWordBits - shift))
        BytesSet(out, byteIdx, int32(v & 0xff))
    return out

@borrows
fn bigHalfDigitCount(a: BigInt): int32 =
    if a.count <= 0:
        return 0
    if a.count > maxBigIntLimbs:
        return -1
    let top: uint64 = bigWordToBitsU64(a.limbs[a.count - 1])
    return (a.count - 1) * 2 + (if (top >> uint64(16)) != uint64(0): 2 else: 1)

@borrows
fn bigGetHalfDigit(a: BigInt, idx: int32): uint64 =
    if idx < 0:
        return uint64(0)
    if ! bigCountValueValid(a.count):
        return uint64(0)
    let limbIdx: int32 = idx / 2
    if limbIdx < 0 || limbIdx >= a.count:
        return uint64(0)
    let word: uint64 = bigWordToBitsU64(a.limbs[limbIdx])
    if (idx & 1) == 0:
        return word & uint64(0xffff)
    return (word >> uint64(16)) & uint64(0xffff)

@borrows
fn bigHalfDigitScratchGet(digits: Bytes, idx: int32): uint64 =
    let offset: int32 = idx * 2
    let lo: uint64 = uint64(BytesGet(digits, offset))
    let hi: uint64 = uint64(BytesGet(digits, offset + 1))
    return lo | (hi << uint64(8))

@borrows
fn bigHalfDigitScratchSet(digits: Bytes, idx: int32, value: uint64) =
    let offset: int32 = idx * 2
    BytesSet(digits, offset, bigLowByte(value))
    BytesSet(digits, offset + 1, bigLowByte(value >> uint64(8)))

@borrows
fn bigMontgomeryScratchGet(scratch: BigMontgomeryScratch, idx: int32): uint64 =
    if idx < maxBigIntLimbs:
        return bigWordToBitsU64(scratch.low[idx])
    if idx < maxBigIntLimbs * 2:
        return bigWordToBitsU64(scratch.high[idx - maxBigIntLimbs])
    return bigWordToBitsU64(scratch.top)

@borrows
fn bigMontgomeryScratchSet(scratch: var BigMontgomeryScratch, idx: int32, value: uint64) =
    let word: int32 = bigWordFromBitsU64(value)
    if idx < maxBigIntLimbs:
        scratch.low[idx] = word
        return
    if idx < maxBigIntLimbs * 2:
        scratch.high[idx - maxBigIntLimbs] = word
        return
    scratch.top = word

fn bigMontgomeryAddMulAt(scratch: var BigMontgomeryScratch,
                         offset: int32,
                         mulWord: uint64,
                         multiplicand: var BigInt,
                         limbCount: int32) =
    if mulWord == uint64(0):
        return
    var carry: uint64 = uint64(0)
    for j in 0..<limbCount:
        let bv: uint64 = if j < multiplicand.count: bigWordToBitsU64(multiplicand.limbs[j]) else: uint64(0)
        let cur: uint64 = bigMontgomeryScratchGet(scratch, offset + j)
        # Native 32x32->64 multiply (operands already <= word width). Extract the
        # low word via bigLowWordBitsU64, NOT `& uint64(0xffffffff)` — that literal
        # sign-extends in the cold compiler. Byte-identical to the old 16x16
        # emulation; ~4x fewer multiplies in the bigint Montgomery hot path.
        let prodFull: uint64 = bigLowWordBitsU64(mulWord) * bigLowWordBitsU64(bv)
        let prodLo: uint64 = bigLowWordBitsU64(prodFull)
        # prodFull can exceed 2^63 (product of two near-2^32 words); the cold/self-host backend
        # emits `uint64 >> n` as an ARITHMETIC shift, sign-extending when bit 63 is set, which
        # corrupts the high word. Mask via bigLowWordBitsU64 (its <<-then-subtract cancels the
        # sign extension) — same defensive idiom already used for the low word.
        let prodHi: uint64 = bigLowWordBitsU64(prodFull >> uint64(bigIntWordBits))
        let sumLo: uint64 = cur + prodLo + carry
        bigMontgomeryScratchSet(scratch, offset + j, sumLo)
        carry = prodHi + bigLowWordBitsU64(sumLo >> uint64(bigIntWordBits))
    var carryIdx: int32 = offset + limbCount
    while carry != uint64(0):
        let cur: uint64 = bigMontgomeryScratchGet(scratch, carryIdx)
        let sum: uint64 = cur + carry
        bigMontgomeryScratchSet(scratch, carryIdx, sum)
        carry = sum >> uint64(bigIntWordBits)
        carryIdx = carryIdx + 1

@borrows
fn bigBuildMontgomeryN0Inv(modulus: BigInt): Result[uint64] =
    if ! bigCountValueValid(modulus.count):
        return Err[uint64]("bigint: montgomery modulus invalid count")
    if modulus.count <= 0:
        return Err[uint64]("bigint: montgomery modulus zero")
    let n0: uint64 = bigWordToBitsU64(modulus.limbs[0])
    if (n0 & uint64(1)) == uint64(0):
        return Err[uint64]("bigint: montgomery requires odd modulus")
    var x: uint64 = uint64(1)
    for _ in 0..<5:
        let step: uint64 = uint64(2) - bigLowWordBitsU64(n0 * x)
        x = bigLowWordBitsU64(x * step)
    return Ok[uint64](bigLowWordBitsU64(uint64(0) - x))

@borrows
fn bigComputePow2Mod(modulus: BigInt, bitCount: int32): Result[BigInt] =
    if ! bigCountValueValid(modulus.count):
        return Err[BigInt]("bigint: pow2 invalid count")
    var out: BigInt = bigFromInt(1)
    for _ in 0..<bitCount:
        let dblRes: Result[BigInt] = bigModAdd(out, out, modulus)
        if IsErr(dblRes):
            return Err[BigInt](Error(dblRes))
        out = Value(dblRes)
    return Ok[BigInt](out)

fn bigMontgomeryMulCore(a: var BigInt, b: var BigInt, ctx: var BigMontgomeryContext): Result[BigInt] =
    let limbCount: int32 = ctx.modulusCount
    if limbCount <= 0:
        return Err[BigInt]("bigint: montgomery limb count zero")
    if limbCount > maxBigIntLimbs:
        return Err[BigInt]("bigint: montgomery limb count invalid")
    if limbCount * 2 > maxBigIntLimbs * 2:
        return Err[BigInt]("bigint: montgomery scratch overflow")
    var scratch: BigMontgomeryScratch
    for clearIdx in 0..<maxBigIntLimbs:
        scratch.low[clearIdx] = 0
        scratch.high[clearIdx] = 0
    scratch.top = 0
    for i in 0..<limbCount:
        let bi: uint64 = if i < b.count: bigWordToBitsU64(b.limbs[i]) else: uint64(0)
        bigMontgomeryAddMulAt(scratch, i, bi, a, limbCount)
        let mWord: uint64 = bigLowWordBitsU64(bigMontgomeryScratchGet(scratch, i) * ctx.n0Inv)
        bigMontgomeryAddMulAt(scratch, i, mWord, ctx.modulus, limbCount)
    var out: BigInt
    out.count = limbCount
    for i in 0..<limbCount:
        out.limbs[i] = bigWordFromBitsU64(bigMontgomeryScratchGet(scratch, i + limbCount))
    let highWord: uint64 = bigMontgomeryScratchGet(scratch, limbCount * 2)
    if highWord != uint64(0):
        if limbCount >= maxBigIntLimbs:
            return Err[BigInt]("bigint: montgomery high carry overflow")
        out.limbs[limbCount] = bigWordFromBitsU64(highWord)
        out.count = limbCount + 1
    bigNormalize(out)
    while bigCmp(out, ctx.modulus) >= 0:
        let subRes: Result[BigInt] = bigSub(out, ctx.modulus)
        if IsErr(subRes):
            return Err[BigInt](Error(subRes))
        out = Value(subRes)
    return Ok[BigInt](out)

fn bigMontgomeryMulCoreInto(out: var BigInt, a: var BigInt, b: var BigInt, ctx: var BigMontgomeryContext): Result[bool] =
    let limbCount: int32 = ctx.modulusCount
    if limbCount <= 0:
        return Err[bool]("bigint: montgomery limb count zero")
    if limbCount > maxBigIntLimbs:
        return Err[bool]("bigint: montgomery limb count invalid")
    if limbCount * 2 > maxBigIntLimbs * 2:
        return Err[bool]("bigint: montgomery scratch overflow")
    var scratch: BigMontgomeryScratch
    for clearIdx in 0..<maxBigIntLimbs:
        scratch.low[clearIdx] = 0
        scratch.high[clearIdx] = 0
    scratch.top = 0
    for i in 0..<limbCount:
        let bi: uint64 = if i < b.count: bigWordToBitsU64(b.limbs[i]) else: uint64(0)
        bigMontgomeryAddMulAt(scratch, i, bi, a, limbCount)
        let mWord: uint64 = bigLowWordBitsU64(bigMontgomeryScratchGet(scratch, i) * ctx.n0Inv)
        bigMontgomeryAddMulAt(scratch, i, mWord, ctx.modulus, limbCount)
    out.count = limbCount
    for i in 0..<limbCount:
        out.limbs[i] = bigWordFromBitsU64(bigMontgomeryScratchGet(scratch, i + limbCount))
    let highWord: uint64 = bigMontgomeryScratchGet(scratch, limbCount * 2)
    if highWord != uint64(0):
        if limbCount >= maxBigIntLimbs:
            return Err[bool]("bigint: montgomery high carry overflow")
        out.limbs[limbCount] = bigWordFromBitsU64(highWord)
        out.count = limbCount + 1
    bigNormalize(out)
    while bigCmp(out, ctx.modulus) >= 0:
        let subRes: Result[BigInt] = bigSub(out, ctx.modulus)
        if IsErr(subRes):
            return Err[bool](Error(subRes))
        bigCopyInto(out, Value(subRes))
    return Ok[bool](true)

@borrows
fn bigBuildMontgomeryContext(modulus: BigInt): Result[BigMontgomeryContext] =
    if ! bigCountValueValid(modulus.count):
        return Err[BigMontgomeryContext]("bigint: montgomery modulus invalid count")
    if modulus.count <= 0:
        return Err[BigMontgomeryContext]("bigint: montgomery modulus zero")
    if !bigIsOdd(modulus):
        return Err[BigMontgomeryContext]("bigint: montgomery requires odd modulus")
    let invRes: Result[uint64] = bigBuildMontgomeryN0Inv(modulus)
    if IsErr(invRes):
        return Err[BigMontgomeryContext](Error(invRes))
    let r2Res: Result[BigInt] = bigComputePow2Mod(modulus, modulus.count * 64)
    if IsErr(r2Res):
        return Err[BigMontgomeryContext](Error(r2Res))
    var ctx: BigMontgomeryContext
    ctx.modulus = modulus
    ctx.modulusCount = modulus.count
    ctx.n0Inv = Value(invRes)
    ctx.r2 = Value(r2Res)
    var one: BigInt = bigFromInt(1)
    var r2Local: BigInt = ctx.r2
    let oneMontRes: Result[BigInt] = bigMontgomeryMulCore(one, r2Local, ctx)
    if IsErr(oneMontRes):
        return Err[BigMontgomeryContext](Error(oneMontRes))
    ctx.oneMont = Value(oneMontRes)
    return Ok[BigMontgomeryContext](ctx)

# (a + a) mod modulus; consumes `a` (the loop-carried accumulation shape).
@borrows
fn bigModDoubleModMove(a: BigInt, modulus: BigInt): BigInt =
    return Value(bigModAdd(a, a, modulus))

@borrows
fn bigComputePow2ModInto(out: var BigInt, modulus: BigInt, bitCount: int32): Result[bool] =
    if ! bigCountValueValid(modulus.count):
        return Err[bool]("bigint: pow2 invalid count")
    var acc: BigInt = bigFromInt(1)
    for _ in 0..<bitCount:
        # Consuming-call shape (like `out = ConcatStr(out, ...)`): the call
        # explicitly consumes the old carrier and the result rebinds it —
        # a plain `acc = fresh` reassign leaves the old def's kill implicit,
        # which the loop-phi memory-version merge cannot prove.
        acc = bigModDoubleModMove(acc, bigCopy(modulus))
    bigCopyInto(out, acc)
    return Ok[bool](true)

@borrows
fn bigBuildMontgomeryContextInto(ctx: var BigMontgomeryContext, modulus: BigInt): Result[bool] =
    if ! bigCountValueValid(modulus.count):
        return Err[bool]("bigint: montgomery modulus invalid count")
    if modulus.count <= 0:
        return Err[bool]("bigint: montgomery modulus zero")
    if !bigIsOdd(modulus):
        return Err[bool]("bigint: montgomery requires odd modulus")
    let invRes: Result[uint64] = bigBuildMontgomeryN0Inv(modulus)
    if IsErr(invRes):
        return Err[bool](Error(invRes))
    bigCopyInto(ctx.modulus, modulus)
    ctx.modulusCount = modulus.count
    ctx.n0Inv = Value(invRes)
    let r2Res: Result[bool] = bigComputePow2ModInto(ctx.r2, modulus, modulus.count * 64)
    if IsErr(r2Res):
        return Err[bool](Error(r2Res))
    var one: BigInt = bigFromInt(1)
    var r2Local: BigInt = bigCopy(ctx.r2)
    # out field must not alias the ctx formal: compute into a temp, store back.
    var oneMontOut: BigInt
    let oneMontRes: Result[bool] = bigMontgomeryMulCoreInto(oneMontOut, one, r2Local, ctx)
    if IsErr(oneMontRes):
        return Err[bool](Error(oneMontRes))
    ctx.oneMont = oneMontOut
    return Ok[bool](true)

fn bigModMulWithContext(a: var BigInt, b: var BigInt, ctx: var BigMontgomeryContext): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count) || ! bigCountValueValid(ctx.modulus.count):
        return Err[BigInt]("bigint: modmul context invalid count")
    var aNorm: BigInt
    bigCopyInto(aNorm, a)
    if bigCmp(aNorm, ctx.modulus) >= 0:
        let modRes: Result[BigInt] = bigMod(aNorm, ctx.modulus)
        if IsErr(modRes):
            return Err[BigInt](Error(modRes))
        bigCopyInto(aNorm, Value(modRes))
    var bNorm: BigInt
    bigCopyInto(bNorm, b)
    if bigCmp(bNorm, ctx.modulus) >= 0:
        let modRes: Result[BigInt] = bigMod(bNorm, ctx.modulus)
        if IsErr(modRes):
            return Err[BigInt](Error(modRes))
        bigCopyInto(bNorm, Value(modRes))
    var r2LocalA: BigInt
    bigCopyInto(r2LocalA, ctx.r2)
    let aMontRes: Result[BigInt] = bigMontgomeryMulCore(aNorm, r2LocalA, ctx)
    if IsErr(aMontRes):
        return Err[BigInt](Error(aMontRes))
    var r2LocalB: BigInt
    bigCopyInto(r2LocalB, ctx.r2)
    let bMontRes: Result[BigInt] = bigMontgomeryMulCore(bNorm, r2LocalB, ctx)
    if IsErr(bMontRes):
        return Err[BigInt](Error(bMontRes))
    var aMont: BigInt
    bigCopyInto(aMont, Value(aMontRes))
    var bMont: BigInt
    bigCopyInto(bMont, Value(bMontRes))
    let prodMontRes: Result[BigInt] = bigMontgomeryMulCore(aMont, bMont, ctx)
    if IsErr(prodMontRes):
        return Err[BigInt](Error(prodMontRes))
    var prodMont: BigInt
    bigCopyInto(prodMont, Value(prodMontRes))
    var one: BigInt = bigFromInt(1)
    return bigMontgomeryMulCore(prodMont, one, ctx)

fn bigModExpWithContext(base: var BigInt, exp: var BigInt, ctx: var BigMontgomeryContext): Result[BigInt] =
    if ! bigCountValueValid(base.count) || ! bigCountValueValid(exp.count) || ! bigCountValueValid(ctx.modulus.count):
        return Err[BigInt]("bigint: modexp context invalid count")
    if bigIsZero(ctx.modulus):
        return Err[BigInt]("bigint: modexp modulus zero")
    var baseNorm: BigInt = bigCopy(base)
    if bigCmp(baseNorm, ctx.modulus) >= 0:
        let baseModRes: Result[BigInt] = bigMod(baseNorm, ctx.modulus)
        if IsErr(baseModRes):
            return Err[BigInt](Error(baseModRes))
        baseNorm = Value(baseModRes)
    var resultMont: BigInt = bigCopy(ctx.oneMont)
    var r2Local: BigInt = bigCopy(ctx.r2)
    let powMontRes: Result[BigInt] = bigMontgomeryMulCore(baseNorm, r2Local, ctx)
    if IsErr(powMontRes):
        return Err[BigInt](Error(powMontRes))
    var powMont: BigInt = Value(powMontRes)
    let bits: int32 = bigBitLen(exp)
    if bits < 0:
        return Err[BigInt]("bigint: modexp context invalid bit length")
    for i in 0..<bits:
        if bigGetBit(exp, i) != 0:
            let mulRes: Result[BigInt] = bigMontgomeryMulCore(resultMont, powMont, ctx)
            if IsErr(mulRes):
                return Err[BigInt](Error(mulRes))
            resultMont = Value(mulRes)
        var powMontSq: BigInt = bigCopy(powMont)
        let sqRes: Result[BigInt] = bigMontgomeryMulCore(powMont, powMontSq, ctx)
        if IsErr(sqRes):
            return Err[BigInt](Error(sqRes))
        powMont = Value(sqRes)
    var one: BigInt = bigFromInt(1)
    return bigMontgomeryMulCore(resultMont, one, ctx)

fn bigModExpWithContextInto(out: var BigInt, base: var BigInt, exp: var BigInt, ctx: var BigMontgomeryContext): Result[bool] =
    if ! bigCountValueValid(base.count) || ! bigCountValueValid(exp.count) || ! bigCountValueValid(ctx.modulus.count):
        return Err[bool]("bigint: modexp context invalid count")
    if bigIsZero(ctx.modulus):
        return Err[bool]("bigint: modexp modulus zero")
    var baseNorm: BigInt = bigCopy(base)
    if bigCmp(baseNorm, ctx.modulus) >= 0:
        let baseModRes: Result[BigInt] = bigMod(baseNorm, ctx.modulus)
        if IsErr(baseModRes):
            return Err[bool](Error(baseModRes))
        bigCopyInto(baseNorm, Value(baseModRes))
    var resultMont: BigInt = bigCopy(ctx.oneMont)
    var r2Local: BigInt = bigCopy(ctx.r2)
    var powMont: BigInt
    let powMontRes: Result[bool] = bigMontgomeryMulCoreInto(powMont, baseNorm, r2Local, ctx)
    if IsErr(powMontRes):
        return Err[bool](Error(powMontRes))
    let bits: int32 = bigBitLen(exp)
    if bits < 0:
        return Err[bool]("bigint: modexp context invalid bit length")
    for i in 0..<bits:
        if bigGetBit(exp, i) != 0:
            var nextResult: BigInt
            let mulRes: Result[bool] = bigMontgomeryMulCoreInto(nextResult, resultMont, powMont, ctx)
            if IsErr(mulRes):
                return Err[bool](Error(mulRes))
            bigCopyInto(resultMont, nextResult)
        var nextPow: BigInt
        var powMontInto: BigInt = bigCopy(powMont)
        let sqRes: Result[bool] = bigMontgomeryMulCoreInto(nextPow, powMont, powMontInto, ctx)
        if IsErr(sqRes):
            return Err[bool](Error(sqRes))
        bigCopyInto(powMont, nextPow)
    var one: BigInt = bigFromInt(1)
    return bigMontgomeryMulCoreInto(out, resultMont, one, ctx)

@borrows
fn bigMul(a: BigInt, b: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count):
        return Err[BigInt]("bigint: mul invalid count")
    if a.count <= 0:
        return Ok[BigInt](BigInt(count: 0))
    if b.count <= 0:
        return Ok[BigInt](BigInt(count: 0))
    let outMax: int32 = a.count + b.count
    if outMax > maxBigIntLimbs:
        return Err[BigInt]("bigint: mul overflow")
    let aHalfCount: int32 = bigHalfDigitCount(a)
    let bHalfCount: int32 = bigHalfDigitCount(b)
    if aHalfCount < 0 || bHalfCount < 0:
        return Err[BigInt]("bigint: mul invalid half-digit count")
    let outHalfMax: int32 = aHalfCount + bHalfCount
    if outHalfMax > 512:
        return Err[BigInt]("bigint: mul half-digit overflow")
    var outHalfDigits: Bytes = BytesAlloc(outHalfMax * 2)
    var out: BigInt
    for i in range(aHalfCount):
        let av: uint64 = bigGetHalfDigit(a, i)
        var carry: uint64 = uint64(0)
        var j: int32
        for j in j..<bHalfCount:
            let idx: int32 = i + j
            let bv: uint64 = bigGetHalfDigit(b, j)
            let cur: uint64 = bigHalfDigitScratchGet(outHalfDigits, idx)
            let prod: uint64 = av * bv
            let sum: uint64 = prod + cur + carry
            bigHalfDigitScratchSet(outHalfDigits, idx, bigLowHalfBitsU64(sum))
            carry = sum >> uint64(16)
        var carryIdx: int32 = i + bHalfCount
        while carry != uint64(0):
            if carryIdx >= outHalfMax:
                BytesFree(outHalfDigits)
                return Err[BigInt]("bigint: mul carry overflow")
            let cur: uint64 = bigHalfDigitScratchGet(outHalfDigits, carryIdx)
            let sum: uint64 = cur + carry
            bigHalfDigitScratchSet(outHalfDigits, carryIdx, bigLowHalfBitsU64(sum))
            carry = sum >> uint64(16)
            carryIdx = carryIdx + 1
    out.count = (outHalfMax + 1) / 2
    var outIdx: int32
    for outIdx in outIdx..<out.count:
        let lo: uint64 = bigHalfDigitScratchGet(outHalfDigits, outIdx * 2)
        let hiIdx: int32 = outIdx * 2 + 1
        var hi: uint64 = uint64(0)
        if hiIdx < outHalfMax:
            hi = bigHalfDigitScratchGet(outHalfDigits, hiIdx)
        let outWord: int32 = bigWordFromBitsU64(lo | (hi << uint64(16)))
        out.limbs[outIdx] = outWord
    bigNormalize(out)
    BytesFree(outHalfDigits)
    return Ok[BigInt](out)

@borrows
fn bigWordBit(w: int32, idx: int32): int32 =
    if idx < 0 || idx >= bigIntWordBits:
        return 0
    let bits: int64 = bigWordToU64(w)
    return int32((bits >> idx) & 1)

@borrows
fn bigModStepBit(rem: BigInt, bit: int32, m: BigInt): Result[BigInt] =
    let shiftRes: Result[BigInt] = bigShiftLeft1(rem)
    if IsErr(shiftRes):
        return shiftRes
    let shifted: BigInt = Value(shiftRes)
    if bit != 0:
        let addRes: Result[BigInt] = bigAddInt(shifted, 1)
        if IsErr(addRes):
            return addRes
        let added: BigInt = Value(addRes)
        if bigCmp(added, m) >= 0:
            return bigSub(added, m)
        return Ok[BigInt](added)
    if bigCmp(shifted, m) >= 0:
        return bigSub(shifted, m)
    return Ok[BigInt](shifted)

@borrows
fn bigModFold8(rem: BigInt, word: int32, hi: int32, m: BigInt): Result[BigInt] =
    let s0: Result[BigInt] = bigModStepBit(rem, bigWordBit(word, hi), m)
    if IsErr(s0):
        return s0
    let s1: Result[BigInt] = bigModStepBit(Value(s0), bigWordBit(word, hi - 1), m)
    if IsErr(s1):
        return s1
    let s2: Result[BigInt] = bigModStepBit(Value(s1), bigWordBit(word, hi - 2), m)
    if IsErr(s2):
        return s2
    let s3: Result[BigInt] = bigModStepBit(Value(s2), bigWordBit(word, hi - 3), m)
    if IsErr(s3):
        return s3
    let s4: Result[BigInt] = bigModStepBit(Value(s3), bigWordBit(word, hi - 4), m)
    if IsErr(s4):
        return s4
    let s5: Result[BigInt] = bigModStepBit(Value(s4), bigWordBit(word, hi - 5), m)
    if IsErr(s5):
        return s5
    let s6: Result[BigInt] = bigModStepBit(Value(s5), bigWordBit(word, hi - 6), m)
    if IsErr(s6):
        return s6
    return bigModStepBit(Value(s6), bigWordBit(word, hi - 7), m)

@borrows
fn bigModFoldLimb(rem: BigInt, limb: int32, m: BigInt): Result[BigInt] =
    let p0: Result[BigInt] = bigModFold8(rem, limb, 31, m)
    if IsErr(p0):
        return p0
    let p1: Result[BigInt] = bigModFold8(Value(p0), limb, 23, m)
    if IsErr(p1):
        return p1
    let p2: Result[BigInt] = bigModFold8(Value(p1), limb, 15, m)
    if IsErr(p2):
        return p2
    return bigModFold8(Value(p2), limb, 7, m)

@borrows
fn bigModFromLimb(a: BigInt, m: BigInt, k: int32): Result[BigInt] =
    if k < 0:
        return Ok[BigInt](bigZero())
    let prevRes: Result[BigInt] = bigModFromLimb(a, m, k - 1)
    if IsErr(prevRes):
        return prevRes
    return bigModFoldLimb(Value(prevRes), a.limbs[k], m)

@borrows
fn bigMod(a: BigInt, m: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(m.count):
        return Err[BigInt]("bigint: mod invalid count")
    if bigIsZero(m):
        return Err[BigInt]("bigint: % by zero")
    if a.count <= 0:
        return Ok[BigInt](bigZero())
    return bigModFromLimb(a, m, a.count - 1)

@borrows
fn bigModAdd(a: BigInt, b: BigInt, m: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count) || ! bigCountValueValid(m.count):
        return Err[BigInt]("bigint: modadd invalid count")
    let sumRes: Result[BigInt] = bigAdd(a, b)
    if IsErr(sumRes):
        return Err[BigInt](Error(sumRes))
    var sum: BigInt = Value(sumRes)
    if bigCmp(sum, m) >= 0:
        let subRes: Result[BigInt] = bigSub(sum, m)
        if IsErr(subRes):
            return Err[BigInt](Error(subRes))
        sum = Value(subRes)
    return Ok[BigInt](sum)

@borrows
fn bigModSub(a: BigInt, b: BigInt, m: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count) || ! bigCountValueValid(m.count):
        return Err[BigInt]("bigint: modsub invalid count")
    if bigCmp(a, b) >= 0:
        return bigSub(a, b)
    let diffRes: Result[BigInt] = bigSub(m, b)
    if IsErr(diffRes):
        return Err[BigInt](Error(diffRes))
    let sumRes: Result[BigInt] = bigAdd(a, Value(diffRes))
    if IsErr(sumRes):
        return Err[BigInt](Error(sumRes))
    var sum: BigInt = Value(sumRes)
    if bigCmp(sum, m) >= 0:
        let subRes: Result[BigInt] = bigSub(sum, m)
        if IsErr(subRes):
            return Err[BigInt](Error(subRes))
        sum = Value(subRes)
    return Ok[BigInt](sum)

@borrows
fn bigHalfModOdd(a: BigInt, m: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(m.count):
        return Err[BigInt]("bigint: half invalid count")
    if bigIsOdd(a):
        let sumRes: Result[BigInt] = bigAdd(a, m)
        if IsErr(sumRes):
            return Err[BigInt](Error(sumRes))
        return Ok[BigInt](bigShiftRight1(Value(sumRes)))
    return Ok[BigInt](bigShiftRight1(a))

@borrows
fn bigModInvOddBinary(a: BigInt, m: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(m.count):
        return Err[BigInt]("bigint: inverse invalid count")
    if bigIsZero(m) || ! bigIsOdd(m):
        return Err[BigInt]("bigint: inverse requires odd modulus")
    let aModRes: Result[BigInt] = bigMod(a, m)
    if IsErr(aModRes):
        return Err[BigInt](Error(aModRes))
    var u: BigInt = bigCopy(Value(aModRes))
    if bigIsZero(u):
        return Err[BigInt]("bigint: inverse of zero")
    let one: BigInt = bigFromInt(1)
    if bigCmp(u, one) == 0:
        return Ok[BigInt](one)
    var v: BigInt = bigCopy(m)
    var x1: BigInt = bigCopy(one)
    var x2: BigInt = bigZero()
    var steps: int32
    while true:
        steps = steps + 1
        if steps > bigModInvOddBinaryMaxSteps:
            return Err[BigInt]("bigint: inverse iteration overflow")
        while ! bigIsZero(u) && ! bigIsOdd(u):
            u = bigShiftRight1(u)
            let halfRes: Result[BigInt] = bigHalfModOdd(x1, m)
            if IsErr(halfRes):
                return Err[BigInt](Error(halfRes))
            x1 = bigCopy(Value(halfRes))
        while ! bigIsZero(v) && ! bigIsOdd(v):
            v = bigShiftRight1(v)
            let halfRes: Result[BigInt] = bigHalfModOdd(x2, m)
            if IsErr(halfRes):
                return Err[BigInt](Error(halfRes))
            x2 = bigCopy(Value(halfRes))
        if bigCmp(u, one) == 0:
            return Ok[BigInt](x1)
        if bigCmp(v, one) == 0:
            return Ok[BigInt](x2)
        if bigCmp(u, v) >= 0:
            let subRes: Result[BigInt] = bigSub(u, v)
            if IsErr(subRes):
                return Err[BigInt](Error(subRes))
            u = bigCopy(Value(subRes))
            let diffRes: Result[BigInt] = bigModSub(x1, x2, m)
            if IsErr(diffRes):
                return Err[BigInt](Error(diffRes))
            x1 = bigCopy(Value(diffRes))
        else:
            let subRes: Result[BigInt] = bigSub(v, u)
            if IsErr(subRes):
                return Err[BigInt](Error(subRes))
            v = bigCopy(Value(subRes))
            let diffRes: Result[BigInt] = bigModSub(x2, x1, m)
            if IsErr(diffRes):
                return Err[BigInt](Error(diffRes))
            x2 = bigCopy(Value(diffRes))
    return Err[BigInt]("bigint: inverse failed")

@borrows
fn bigModMul(a: BigInt, b: BigInt, m: BigInt): Result[BigInt] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count) || ! bigCountValueValid(m.count):
        return Err[BigInt]("bigint: modmul invalid count")
    if bigIsOdd(m):
        let ctxRes: Result[BigMontgomeryContext] = bigBuildMontgomeryContext(m)
        if !IsErr(ctxRes):
            var ctx: BigMontgomeryContext = Value(ctxRes)
            var left: BigInt = a
            var right: BigInt = b
            return bigModMulWithContext(left, right, ctx)
    let mulRes: Result[BigInt] = bigMul(a, b)
    if IsErr(mulRes):
        return Err[BigInt](Error(mulRes))
    return bigMod(Value(mulRes), m)

@borrows
fn bigModExp(base: BigInt, exp: BigInt, m: BigInt): Result[BigInt] =
    if ! bigCountValueValid(base.count) || ! bigCountValueValid(exp.count) || ! bigCountValueValid(m.count):
        return Err[BigInt]("bigint: modexp invalid count")
    if bigIsZero(m):
        return Err[BigInt]("bigint: modexp modulus zero")
    if bigIsOdd(m):
        let ctxRes: Result[BigMontgomeryContext] = bigBuildMontgomeryContext(m)
        if !IsErr(ctxRes):
            var ctx: BigMontgomeryContext = Value(ctxRes)
            var baseLocal: BigInt = base
            var expLocal: BigInt = exp
            return bigModExpWithContext(baseLocal, expLocal, ctx)
    var result: BigInt = bigFromInt(1)
    let baseModRes: Result[BigInt] = bigMod(base, m)
    if IsErr(baseModRes):
        return Err[BigInt](Error(baseModRes))
    var pow: BigInt = Value(baseModRes)
    let bits: int32 = bigBitLen(exp)
    if bits < 0:
        return Err[BigInt]("bigint: modexp invalid bit length")
    for i in 0..<bits:
        if bigGetBit(exp, i) != 0:
            let mulRawRes: Result[BigInt] = bigMul(result, pow)
            if IsErr(mulRawRes):
                return Err[BigInt](Error(mulRawRes))
            let mulRes: Result[BigInt] = bigMod(Value(mulRawRes), m)
            if IsErr(mulRes):
                return Err[BigInt](Error(mulRes))
            result = Value(mulRes)
        let sqRawRes: Result[BigInt] = bigMul(pow, pow)
        if IsErr(sqRawRes):
            return Err[BigInt](Error(sqRawRes))
        let sqRes: Result[BigInt] = bigMod(Value(sqRawRes), m)
        if IsErr(sqRes):
            return Err[BigInt](Error(sqRes))
        pow = Value(sqRes)
    return Ok[BigInt](result)

@borrows
fn bigCopyInto(out: var BigInt, value: BigInt) =
    if ! bigCountValueValid(value.count):
        out.count = 0
        return
    out.count = value.count
    for i in 0..<maxBigIntLimbs:
        out.limbs[i] = value.limbs[i]
    bigNormalize(out)

fn bigModInto(out: var BigInt, a: var BigInt, m: var BigInt): Result[bool] =
    let res: Result[BigInt] = bigMod(a, m)
    if IsErr(res):
        return Err[bool](Error(res))
    bigCopyInto(out, Value(res))
    return Ok[bool](true)

fn bigModMulOddWithContextInto(out: var BigInt,
                                 a: var BigInt,
                                 b: var BigInt,
                                 m: var BigInt,
                                 ctx: var BigMontgomeryContext): Result[bool] =
    var aNorm: BigInt
    let aNormRes: Result[bool] = bigModInto(aNorm, a, m)
    if IsErr(aNormRes):
        return Err[bool](Error(aNormRes))
    var bNorm: BigInt
    let bNormRes: Result[bool] = bigModInto(bNorm, b, m)
    if IsErr(bNormRes):
        return Err[bool](Error(bNormRes))
    var r2LocalA: BigInt
    bigCopyInto(r2LocalA, ctx.r2)
    var aMont: BigInt
    let aMontRes: Result[bool] = bigMontgomeryMulCoreInto(aMont, aNorm, r2LocalA, ctx)
    if IsErr(aMontRes):
        return Err[bool](Error(aMontRes))
    var r2LocalB: BigInt
    bigCopyInto(r2LocalB, ctx.r2)
    var bMont: BigInt
    let bMontRes: Result[bool] = bigMontgomeryMulCoreInto(bMont, bNorm, r2LocalB, ctx)
    if IsErr(bMontRes):
        return Err[bool](Error(bMontRes))
    var prodMont: BigInt
    let prodMontRes: Result[bool] = bigMontgomeryMulCoreInto(prodMont, aMont, bMont, ctx)
    if IsErr(prodMontRes):
        return Err[bool](Error(prodMontRes))
    var one: BigInt
    bigCopyInto(one, bigFromInt(1))
    return bigMontgomeryMulCoreInto(out, prodMont, one, ctx)

fn bigModMulInto(out: var BigInt, a: var BigInt, b: var BigInt, m: var BigInt): Result[bool] =
    if ! bigCountValueValid(a.count) || ! bigCountValueValid(b.count) || ! bigCountValueValid(m.count):
        return Err[bool]("bigint: modmul invalid count")
    if bigIsZero(m):
        return Err[bool]("bigint: modmul modulus zero")
    if bigIsOdd(m):
        var ctx: BigMontgomeryContext
        let ctxRes: Result[bool] = bigBuildMontgomeryContextInto(ctx, m)
        if !IsErr(ctxRes):
            return bigModMulOddWithContextInto(out, a, b, m, ctx)
    let mulRes: Result[BigInt] = bigMul(a, b)
    if IsErr(mulRes):
        return Err[bool](Error(mulRes))
    var product: BigInt
    bigCopyInto(product, Value(mulRes))
    return bigModInto(out, product, m)

@borrows
fn bigModExpInto(out: var BigInt, base: BigInt, exp: BigInt, m: BigInt): Result[bool] =
    if ! bigCountValueValid(base.count) || ! bigCountValueValid(exp.count) || ! bigCountValueValid(m.count):
        return Err[bool]("bigint: modexp invalid count")
    if bigIsZero(m):
        return Err[bool]("bigint: modexp modulus zero")
    if bigIsOdd(m):
        var ctx: BigMontgomeryContext
        let ctxRes: Result[bool] = bigBuildMontgomeryContextInto(ctx, m)
        if !IsErr(ctxRes):
            var baseLocal: BigInt = base
            var expLocal: BigInt = exp
            return bigModExpWithContextInto(out, baseLocal, expLocal, ctx)
    var result: BigInt = bigFromInt(1)
    let baseModRes: Result[BigInt] = bigMod(base, m)
    if IsErr(baseModRes):
        return Err[bool](Error(baseModRes))
    var pow: BigInt
    bigCopyInto(pow, Value(baseModRes))
    let bits: int32 = bigBitLen(exp)
    if bits < 0:
        return Err[bool]("bigint: modexp invalid bit length")
    for i in 0..<bits:
        if bigGetBit(exp, i) != 0:
            let mulRawRes: Result[BigInt] = bigMul(result, pow)
            if IsErr(mulRawRes):
                return Err[bool](Error(mulRawRes))
            let mulRes: Result[BigInt] = bigMod(Value(mulRawRes), m)
            if IsErr(mulRes):
                return Err[bool](Error(mulRes))
            bigCopyInto(result, Value(mulRes))
        let sqRawRes: Result[BigInt] = bigMul(pow, pow)
        if IsErr(sqRawRes):
            return Err[bool](Error(sqRawRes))
        let sqRes: Result[BigInt] = bigMod(Value(sqRawRes), m)
        if IsErr(sqRes):
            return Err[bool](Error(sqRes))
        bigCopyInto(pow, Value(sqRes))
    bigCopyInto(out, result)
    return Ok[bool](true)
