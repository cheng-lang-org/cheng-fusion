# SHA-256 digest.

import std/rawbytes
import std/rawmem_support
import std/system

@abi_internal
@importc("cheng_atomic_store_i32")
fn sha256AtomicStoreI32(value: var int32, newValue: int32)

@abi_internal
@importc("cheng_atomic_load_i32")
fn sha256AtomicLoadI32(value: var int32): int32

@abi_internal
@importc("cheng_atomic_cas_i32")
fn sha256AtomicCasI32(value: var int32, expect: int32, desired: int32): int32
fn U32Mask(): int64 =
    return (Int64(1) << 32) - 1

fn U32(x: int64): int64 =
    let out = x & U32Mask()
    return out

fn Rotr32(x: int64, n: int32): int64 =
    let v: int64 = U32(x)
    let rotated: int64 = (v >> n) | (v << (32 - n))
    let out: int64 = U32(rotated)
    return out

fn Ch(x: int64, y: int64, z: int64): int64 =
    let xu: int64 = U32(x)
    let yu: int64 = U32(y)
    let zu: int64 = U32(z)
    let mask: int64 = U32Mask()
    let notXuRaw: int64 = xu ^ mask
    let notXu: int64 = U32(notXuRaw)
    let mixed: int64 = (xu & yu) ^ (notXu & zu)
    let out: int64 = U32(mixed)
    return out

fn Maj(x: int64, y: int64, z: int64): int64 =
    let xu: int64 = U32(x)
    let yu: int64 = U32(y)
    let zu: int64 = U32(z)
    let mixed: int64 = (xu & yu) ^ (xu & zu) ^ (yu & zu)
    let out: int64 = U32(mixed)
    return out

fn BigSigma0(x: int64): int64 =
    let mixed: int64 = Rotr32(x, 2) ^ Rotr32(x, 13) ^ Rotr32(x, 22)
    let out: int64 = U32(mixed)
    return out

fn BigSigma1(x: int64): int64 =
    let mixed: int64 = Rotr32(x, 6) ^ Rotr32(x, 11) ^ Rotr32(x, 25)
    let out: int64 = U32(mixed)
    return out

fn SmallSigma0(x: int64): int64 =
    let xu: int64 = U32(x)
    let mixed: int64 = Rotr32(x, 7) ^ Rotr32(x, 18) ^ (xu >> 3)
    let out: int64 = U32(mixed)
    return out

fn SmallSigma1(x: int64): int64 =
    let xu: int64 = U32(x)
    let mixed: int64 = Rotr32(x, 17) ^ Rotr32(x, 19) ^ (xu >> 10)
    let out: int64 = U32(mixed)
    return out

fn U32FromBytes(b0: int32, b1: int32, b2: int32, b3: int32): int64 =
    return (Int64(b0) << 24) | (Int64(b1) << 16) | (Int64(b2) << 8) | Int64(b3)

fn K256(i: int32): int64 =
    if i == 0: return U32FromBytes(0x42, 0x8a, 0x2f, 0x98)
    if i == 1: return U32FromBytes(0x71, 0x37, 0x44, 0x91)
    if i == 2: return U32FromBytes(0xb5, 0xc0, 0xfb, 0xcf)
    if i == 3: return U32FromBytes(0xe9, 0xb5, 0xdb, 0xa5)
    if i == 4: return U32FromBytes(0x39, 0x56, 0xc2, 0x5b)
    if i == 5: return U32FromBytes(0x59, 0xf1, 0x11, 0xf1)
    if i == 6: return U32FromBytes(0x92, 0x3f, 0x82, 0xa4)
    if i == 7: return U32FromBytes(0xab, 0x1c, 0x5e, 0xd5)
    if i == 8: return U32FromBytes(0xd8, 0x07, 0xaa, 0x98)
    if i == 9: return U32FromBytes(0x12, 0x83, 0x5b, 0x01)
    if i == 10: return U32FromBytes(0x24, 0x31, 0x85, 0xbe)
    if i == 11: return U32FromBytes(0x55, 0x0c, 0x7d, 0xc3)
    if i == 12: return U32FromBytes(0x72, 0xbe, 0x5d, 0x74)
    if i == 13: return U32FromBytes(0x80, 0xde, 0xb1, 0xfe)
    if i == 14: return U32FromBytes(0x9b, 0xdc, 0x06, 0xa7)
    if i == 15: return U32FromBytes(0xc1, 0x9b, 0xf1, 0x74)
    if i == 16: return U32FromBytes(0xe4, 0x9b, 0x69, 0xc1)
    if i == 17: return U32FromBytes(0xef, 0xbe, 0x47, 0x86)
    if i == 18: return U32FromBytes(0x0f, 0xc1, 0x9d, 0xc6)
    if i == 19: return U32FromBytes(0x24, 0x0c, 0xa1, 0xcc)
    if i == 20: return U32FromBytes(0x2d, 0xe9, 0x2c, 0x6f)
    if i == 21: return U32FromBytes(0x4a, 0x74, 0x84, 0xaa)
    if i == 22: return U32FromBytes(0x5c, 0xb0, 0xa9, 0xdc)
    if i == 23: return U32FromBytes(0x76, 0xf9, 0x88, 0xda)
    if i == 24: return U32FromBytes(0x98, 0x3e, 0x51, 0x52)
    if i == 25: return U32FromBytes(0xa8, 0x31, 0xc6, 0x6d)
    if i == 26: return U32FromBytes(0xb0, 0x03, 0x27, 0xc8)
    if i == 27: return U32FromBytes(0xbf, 0x59, 0x7f, 0xc7)
    if i == 28: return U32FromBytes(0xc6, 0xe0, 0x0b, 0xf3)
    if i == 29: return U32FromBytes(0xd5, 0xa7, 0x91, 0x47)
    if i == 30: return U32FromBytes(0x06, 0xca, 0x63, 0x51)
    if i == 31: return U32FromBytes(0x14, 0x29, 0x29, 0x67)
    if i == 32: return U32FromBytes(0x27, 0xb7, 0x0a, 0x85)
    if i == 33: return U32FromBytes(0x2e, 0x1b, 0x21, 0x38)
    if i == 34: return U32FromBytes(0x4d, 0x2c, 0x6d, 0xfc)
    if i == 35: return U32FromBytes(0x53, 0x38, 0x0d, 0x13)
    if i == 36: return U32FromBytes(0x65, 0x0a, 0x73, 0x54)
    if i == 37: return U32FromBytes(0x76, 0x6a, 0x0a, 0xbb)
    if i == 38: return U32FromBytes(0x81, 0xc2, 0xc9, 0x2e)
    if i == 39: return U32FromBytes(0x92, 0x72, 0x2c, 0x85)
    if i == 40: return U32FromBytes(0xa2, 0xbf, 0xe8, 0xa1)
    if i == 41: return U32FromBytes(0xa8, 0x1a, 0x66, 0x4b)
    if i == 42: return U32FromBytes(0xc2, 0x4b, 0x8b, 0x70)
    if i == 43: return U32FromBytes(0xc7, 0x6c, 0x51, 0xa3)
    if i == 44: return U32FromBytes(0xd1, 0x92, 0xe8, 0x19)
    if i == 45: return U32FromBytes(0xd6, 0x99, 0x06, 0x24)
    if i == 46: return U32FromBytes(0xf4, 0x0e, 0x35, 0x85)
    if i == 47: return U32FromBytes(0x10, 0x6a, 0xa0, 0x70)
    if i == 48: return U32FromBytes(0x19, 0xa4, 0xc1, 0x16)
    if i == 49: return U32FromBytes(0x1e, 0x37, 0x6c, 0x08)
    if i == 50: return U32FromBytes(0x27, 0x48, 0x77, 0x4c)
    if i == 51: return U32FromBytes(0x34, 0xb0, 0xbc, 0xb5)
    if i == 52: return U32FromBytes(0x39, 0x1c, 0x0c, 0xb3)
    if i == 53: return U32FromBytes(0x4e, 0xd8, 0xaa, 0x4a)
    if i == 54: return U32FromBytes(0x5b, 0x9c, 0xca, 0x4f)
    if i == 55: return U32FromBytes(0x68, 0x2e, 0x6f, 0xf3)
    if i == 56: return U32FromBytes(0x74, 0x8f, 0x82, 0xee)
    if i == 57: return U32FromBytes(0x78, 0xa5, 0x63, 0x6f)
    if i == 58: return U32FromBytes(0x84, 0xc8, 0x78, 0x14)
    if i == 59: return U32FromBytes(0x8c, 0xc7, 0x02, 0x08)
    if i == 60: return U32FromBytes(0x90, 0xbe, 0xff, 0xfa)
    if i == 61: return U32FromBytes(0xa4, 0x50, 0x6c, 0xeb)
    if i == 62: return U32FromBytes(0xbe, 0xf9, 0xa3, 0xf7)
    if i == 63: return U32FromBytes(0xc6, 0x71, 0x78, 0xf2)
    return 0

@borrows
fn GetU32BE(data: Bytes, offset: int32): int64 =
    let b0: int64 = Int64(BytesGet(data, offset))
    let b1: int64 = Int64(BytesGet(data, offset + 1))
    let b2: int64 = Int64(BytesGet(data, offset + 2))
    let b3: int64 = Int64(BytesGet(data, offset + 3))
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

fn SetU32BE(data: var Bytes, offset: int32, value: int64) =
    let v: int64 = U32(value)
    let byte0: int64 = (v >> 24) & 255
    let byte1: int64 = (v >> 16) & 255
    let byte2: int64 = (v >> 8) & 255
    let byte3: int64 = v & 255
    BytesSet(data, offset, Int32(byte0))
    BytesSet(data, offset + 1, Int32(byte1))
    BytesSet(data, offset + 2, Int32(byte2))
    BytesSet(data, offset + 3, Int32(byte3))

@borrows
fn LoadU32LE(data: Bytes, offset: int32): int64 =
    let b0: int64 = Int64(BytesGet(data, offset))
    let b1: int64 = Int64(BytesGet(data, offset + 1))
    let b2: int64 = Int64(BytesGet(data, offset + 2))
    let b3: int64 = Int64(BytesGet(data, offset + 3))
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn StoreU32LE(data: var Bytes, offset: int32, value: int64) =
    let v: int64 = U32(value)
    BytesSet(data, offset, Int32(v & 255))
    BytesSet(data, offset + 1, Int32((v >> 8) & 255))
    BytesSet(data, offset + 2, Int32((v >> 16) & 255))
    BytesSet(data, offset + 3, Int32((v >> 24) & 255))

# Raw-pointer U32LE store: byte-identical to StoreU32LE on a BytesView of the
# same base, but takes a bare ptr so the caller needs no `var` view local
# (a `var` borrow-view local got an owned drop-release in the linux x86_64
# backend, releasing the borrowed buffer's address -- see findings dosg entry).
fn StoreU32LERaw(state: ptr, offset: int32, value: int64) =
    let v: int64 = U32(value)
    rawmem_support.RawmemSet(rawmem_support.RawmemPtrAdd(state, offset), Int32(v & 255), 1)
    rawmem_support.RawmemSet(rawmem_support.RawmemPtrAdd(state, offset + 1), Int32((v >> 8) & 255), 1)
    rawmem_support.RawmemSet(rawmem_support.RawmemPtrAdd(state, offset + 2), Int32((v >> 16) & 255), 1)
    rawmem_support.RawmemSet(rawmem_support.RawmemPtrAdd(state, offset + 3), Int32((v >> 24) & 255), 1)

@borrows
fn GetU32LEBytes(data: Bytes, offset: int32): int64 =
    let b0: int64 = Int64(BytesGet(data, offset))
    let b1: int64 = Int64(BytesGet(data, offset + 1))
    let b2: int64 = Int64(BytesGet(data, offset + 2))
    let b3: int64 = Int64(BytesGet(data, offset + 3))
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn SetU32LEBytes(data: var Bytes, offset: int32, value: int64) =
    let v: int64 = U32(value)
    BytesSet(data, offset, Int32(v & 255))
    BytesSet(data, offset + 1, Int32((v >> 8) & 255))
    BytesSet(data, offset + 2, Int32((v >> 16) & 255))
    BytesSet(data, offset + 3, Int32((v >> 24) & 255))

# Path C hardware-SHA256 intrinsic seam. `cheng_crypto_sha256_compress_block` is the symbol
# the arm64 backend recognizer (primary_object_plan PrimaryInlineSha256BlockKind) replaces
# inline with ARMv8 SHA256H/SHA256H2/SHA256SU0/SHA256SU1 at call sites inside straight-line
# BodyIR hosts. This is ALSO its real scalar body: on non-arm64 / without recognizer the call
# lands here and runs a software single-block compress — no external C symbol needed (mirrors
# cheng_crypto_aes_block_enc128). state = 8x uint32 hash words (native-endian, 32B, in/out);
# block = 64-byte raw big-endian message block; k256 = 64x uint32 round constants (native-endian).
fn cheng_crypto_sha256_compress_block(state: ptr, block: ptr, k256: ptr) =
    let stateView: Bytes = BytesView(state, 32)
    let blockView: Bytes = BytesView(block, 64)
    let kView: Bytes = BytesView(k256, 256)
    var h0: int64 = LoadU32LE(stateView, 0)
    var h1: int64 = LoadU32LE(stateView, 4)
    var h2: int64 = LoadU32LE(stateView, 8)
    var h3: int64 = LoadU32LE(stateView, 12)
    var h4: int64 = LoadU32LE(stateView, 16)
    var h5: int64 = LoadU32LE(stateView, 20)
    var h6: int64 = LoadU32LE(stateView, 24)
    var h7: int64 = LoadU32LE(stateView, 28)
    var wBytes = BytesAlloc(512)
    let mask: int64 = U32Mask()
    for ts in 0..<16:
        SetU32LEBytes(wBytes, ts * 4, GetU32BE(blockView, ts * 4))
    for te in 16..<64:
        let x15: int64 = GetU32LEBytes(wBytes, (te - 15) * 4)
        let s0w: int64 = (((x15 >> 7) | (x15 << 25)) ^ ((x15 >> 18) | (x15 << 14)) ^ (x15 >> 3)) & mask
        let x2: int64 = GetU32LEBytes(wBytes, (te - 2) * 4)
        let s1w: int64 = (((x2 >> 17) | (x2 << 15)) ^ ((x2 >> 19) | (x2 << 13)) ^ (x2 >> 10)) & mask
        SetU32LEBytes(wBytes, te * 4,
                      (GetU32LEBytes(wBytes, (te - 16) * 4) + s0w + GetU32LEBytes(wBytes, (te - 7) * 4) + s1w) & mask)
    var a: int64 = h0
    var b: int64 = h1
    var c: int64 = h2
    var d: int64 = h3
    var e: int64 = h4
    var f: int64 = h5
    var g: int64 = h6
    var h: int64 = h7
    for t in 0..<64:
        let kt: int64 = LoadU32LE(kView, t * 4)
        let s1: int64 = (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & mask
        let chv: int64 = ((e & f) ^ ((e ^ mask) & g)) & mask
        let t1: int64 = (h + s1 + chv + kt + GetU32LEBytes(wBytes, t * 4)) & mask
        let s0: int64 = (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & mask
        let mj: int64 = ((a & b) ^ (a & c) ^ (b & c)) & mask
        let t2: int64 = (s0 + mj) & mask
        h = g
        g = f
        f = e
        e = (d + t1) & mask
        d = c
        c = b
        b = a
        a = (t1 + t2) & mask
    StoreU32LERaw(state, 0, U32(h0 + a))
    StoreU32LERaw(state, 4, U32(h1 + b))
    StoreU32LERaw(state, 8, U32(h2 + c))
    StoreU32LERaw(state, 12, U32(h3 + d))
    StoreU32LERaw(state, 16, U32(h4 + e))
    StoreU32LERaw(state, 20, U32(h5 + f))
    StoreU32LERaw(state, 24, U32(h6 + g))
    StoreU32LERaw(state, 28, U32(h7 + h))

# Straight-line host so the recognizer fires on the inner call. MUST stay one call + return
# (no loop) or low_uir Phase-1 won't emit a BodyIR and the SHA256H inline won't trigger.
fn sha256CompressBlockHwHost(state: ptr, block: ptr, k256: ptr): int32 =
    cheng_crypto_sha256_compress_block(state, block, k256)
    return 0

# Path C hardware-SHA256 64-block serial-chain seam (SHA kind 2, single-stream):
# one call compresses 64 consecutive blocks with the H chain flowing inside the
# inline sequence (measured ~2100MB/s single-stream on Apple M4 Pro, parity
# with CC_SHA256; 17x over the per-block-call form). Scalar fallback body =
# 64 x sha256CompressBlockHwHost (kind 1 stays inlined there on any compiler
# that carries the single-block recognizer, so no speed regression on old
# binaries). No recursion: the single-block seam body never calls back here.
fn cheng_crypto_sha256_serial64_compress(state: ptr, msg: ptr, k256: ptr) =
    var msgView: Bytes = BytesView(msg, 4096)
    for b in 0..<64:
        sha256CompressBlockHwHost(
            state,
            rawmem_support.RawmemPtrAdd(msgView.data, b * 64),
            k256)

# Straight-line host so the kind-2 recognizer fires on the inner call.
fn sha256Serial64HwHost(state: ptr, msg: ptr, k256: ptr): int32 =
    cheng_crypto_sha256_serial64_compress(state, msg, k256)
    return 0

@borrows
fn Sha256CompressBlockReuse(state: var Bytes,
                            block: Bytes,
                            kTable: var Bytes,
                            schedule: var int64[]) =
    if state.len != 32 || block.len != 64 || kTable.len != 256 ||
       schedule.len != 64:
        panic("sha256 block reuse shape mismatch")
    let h0 = LoadU32LE(state, 0)
    let h1 = LoadU32LE(state, 4)
    let h2 = LoadU32LE(state, 8)
    let h3 = LoadU32LE(state, 12)
    let h4 = LoadU32LE(state, 16)
    let h5 = LoadU32LE(state, 20)
    let h6 = LoadU32LE(state, 24)
    let h7 = LoadU32LE(state, 28)
    let mask = U32Mask()
    for index in 0..<16:
        schedule[index] = GetU32BE(block, index * 4)
    for index in 16..<64:
        let x15 = schedule[index - 15]
        let sigma0 = (((x15 >> 7) | (x15 << 25)) ^
                      ((x15 >> 18) | (x15 << 14)) ^
                      (x15 >> 3)) & mask
        let x2 = schedule[index - 2]
        let sigma1 = (((x2 >> 17) | (x2 << 15)) ^
                      ((x2 >> 19) | (x2 << 13)) ^
                      (x2 >> 10)) & mask
        schedule[index] = (schedule[index - 16] + sigma0 +
                           schedule[index - 7] + sigma1) & mask
    var a = h0
    var b = h1
    var c = h2
    var d = h3
    var e = h4
    var f = h5
    var g = h6
    var h = h7
    for index in 0..<64:
        let constant = LoadU32LE(kTable, index * 4)
        let sigma1 = (((e >> 6) | (e << 26)) ^
                      ((e >> 11) | (e << 21)) ^
                      ((e >> 25) | (e << 7))) & mask
        let choose = ((e & f) ^ ((e ^ mask) & g)) & mask
        let temp1 = (h + sigma1 + choose + constant + schedule[index]) & mask
        let sigma0 = (((a >> 2) | (a << 30)) ^
                      ((a >> 13) | (a << 19)) ^
                      ((a >> 22) | (a << 10))) & mask
        let majority = ((a & b) ^ (a & c) ^ (b & c)) & mask
        let temp2 = (sigma0 + majority) & mask
        h = g
        g = f
        f = e
        e = (d + temp1) & mask
        d = c
        c = b
        b = a
        a = (temp1 + temp2) & mask
    StoreU32LE(state, 0, U32(h0 + a))
    StoreU32LE(state, 4, U32(h1 + b))
    StoreU32LE(state, 8, U32(h2 + c))
    StoreU32LE(state, 12, U32(h3 + d))
    StoreU32LE(state, 16, U32(h4 + e))
    StoreU32LE(state, 20, U32(h5 + f))
    StoreU32LE(state, 24, U32(h6 + g))
    StoreU32LE(state, 28, U32(h7 + h))

type
    Sha256TwoPartState =
        state: Bytes
        block: Bytes
        kTable: Bytes
        schedule: int64[]
        blockLen: int32
        totalLen: int64

fn Sha256TwoPartStateRelease(state: var Sha256TwoPartState) =
    BytesFree(state.state)
    BytesFree(state.block)
    BytesFree(state.kTable)
    state.schedule = []
    state.blockLen = 0
    state.totalLen = 0

fn Sha256TwoPartStateInit(): Sha256TwoPartState =
    var state: Sha256TwoPartState
    var stateState = BytesAlloc(32)
    var stateBlock = BytesAlloc(64)
    var stateKTable = BytesAlloc(256)
    var stateSchedule: int64[]
    setLen(stateSchedule, 64)
    if sha256BytesDataPtr(stateState) == nil || stateState.len != 32 ||
       sha256BytesDataPtr(stateBlock) == nil || stateBlock.len != 64 ||
       sha256BytesDataPtr(stateKTable) == nil || stateKTable.len != 256 ||
       stateSchedule.len != 64:
        BytesFree(stateState)
        BytesFree(stateBlock)
        BytesFree(stateKTable)
        Sha256TwoPartStateRelease(state)
        panic("sha256 two-part state allocation failed")
    state.state = stateState
    state.block = stateBlock
    state.kTable = stateKTable
    state.schedule = stateSchedule
    StoreU32LE(state.state, 0, U32FromBytes(0x6a, 0x09, 0xe6, 0x67))
    StoreU32LE(state.state, 4, U32FromBytes(0xbb, 0x67, 0xae, 0x85))
    StoreU32LE(state.state, 8, U32FromBytes(0x3c, 0x6e, 0xf3, 0x72))
    StoreU32LE(state.state, 12, U32FromBytes(0xa5, 0x4f, 0xf5, 0x3a))
    StoreU32LE(state.state, 16, U32FromBytes(0x51, 0x0e, 0x52, 0x7f))
    StoreU32LE(state.state, 20, U32FromBytes(0x9b, 0x05, 0x68, 0x8c))
    StoreU32LE(state.state, 24, U32FromBytes(0x1f, 0x83, 0xd9, 0xab))
    StoreU32LE(state.state, 28, U32FromBytes(0x5b, 0xe0, 0xcd, 0x19))
    let kPtr = sha256BytesDataPtr(state.kTable)
    for index in 0..<64:
        StoreU32LERaw(kPtr, index * 4, K256(index))
    return state

@borrows
fn Sha256TwoPartCompress(state: var Sha256TwoPartState,
                         block: Bytes) =
    if block.data == nil || block.len != 64:
        panic("sha256 two-part block invalid")
    Sha256CompressBlockReuse(state.state,
                            block,
                            state.kTable,
                            state.schedule)

@borrows
fn Sha256TwoPartUpdate(state: var Sha256TwoPartState,
                       data: Bytes) =
    if data.len < 0 || (data.len > 0 && data.data == nil) ||
       state.blockLen < 0 || state.blockLen >= 64 ||
       state.totalLen < 0:
        panic("sha256 two-part input invalid")
    let maxByteLen = (Int64(1) << 60) - 1
    if state.totalLen > maxByteLen - Int64(data.len):
        panic("sha256 two-part length overflow")
    state.totalLen = state.totalLen + Int64(data.len)
    var offset: int32
    if state.blockLen > 0 && data.len > 0:
        let blockRemaining = 64 - state.blockLen
        let take = data.len < blockRemaining ? data.len : blockRemaining
        rawmem_support.RawmemCopy(
            rawmem_support.RawmemPtrAdd(sha256BytesDataPtr(state.block), state.blockLen),
            data.data,
            take)
        state.blockLen = state.blockLen + take
        offset = take
        if state.blockLen == 64:
            Sha256TwoPartCompress(state, state.block)
            state.blockLen = 0
    while data.len - offset >= 64:
        let blockView = BytesView(
            rawmem_support.RawmemPtrAdd(data.data, offset), 64)
        Sha256TwoPartCompress(state, blockView)
        offset = offset + 64
    let tailLen = data.len - offset
    if tailLen > 0:
        rawmem_support.RawmemCopy(
            sha256BytesDataPtr(state.block),
            rawmem_support.RawmemPtrAdd(data.data, offset),
            tailLen)
        state.blockLen = tailLen

fn Sha256TwoPartFinish(state: var Sha256TwoPartState): Bytes =
    if state.blockLen < 0 || state.blockLen >= 64 || state.totalLen < 0:
        Sha256TwoPartStateRelease(state)
        panic("sha256 two-part state invalid")
    BytesSet(state.block, state.blockLen, 0x80)
    state.blockLen = state.blockLen + 1
    if state.blockLen > 56:
        for index in state.blockLen..<64:
            BytesSet(state.block, index, 0)
        Sha256TwoPartCompress(state, state.block)
        state.blockLen = 0
    for index in state.blockLen..<56:
        BytesSet(state.block, index, 0)
    var bitLen = state.totalLen * 8
    for index in 0..<8:
        BytesSet(state.block, 63 - index, Int32(bitLen & 255))
        bitLen = bitLen >> 8
    Sha256TwoPartCompress(state, state.block)
    var out = BytesAlloc(32)
    if sha256BytesDataPtr(out) == nil || out.len != 32:
        BytesFree(out)
        Sha256TwoPartStateRelease(state)
        panic("sha256 two-part digest allocation failed")
    for index in 0..<8:
        SetU32BE(out,
                 index * 4,
                 LoadU32LE(state.state, index * 4))
    Sha256TwoPartStateRelease(state)
    return out

@borrows
fn Sha256DigestTwo(first: Bytes, second: Bytes): Bytes =
    var state = Sha256TwoPartStateInit()
    Sha256TwoPartUpdate(state, first)
    Sha256TwoPartUpdate(state, second)
    return Sha256TwoPartFinish(state)

# The production backends do not yet prove addressable non-scalar const data:
# a fixed-array global can acquire an address while its data payload is emitted
# as zeroes. Keep one managed table until that backend contract exists, but make
# its lifecycle explicit and race-free. State is static scalar storage:
# 0=empty, 1=initializing, 2=ready, 3=closing, 4=closed.
const
    sharedSha256KTabStateEmpty: int32 = 0
    sharedSha256KTabStateInitializing: int32 = 1
    sharedSha256KTabStateReady: int32 = 2
    sharedSha256KTabStateClosing: int32 = 3
    sharedSha256KTabStateClosed: int32 = 4

var sharedSha256KTabCache: Bytes
var sharedSha256KTabStateWord: int32
var sharedSha256KTabReaderCount: int32

type
    Sha256KTableLease =
        table: Bytes
        sharedLease: bool

fn sharedSha256KTabBuild(): Bytes =
    var table: Bytes
    table = BytesAlloc(256)
    let p = sha256BytesDataPtr(table)
    if p == nil || table.len != 256:
        BytesFree(table)
        panic("sha256 shared K table allocation failed")
    for index in 0..<64:
        StoreU32LERaw(p, index * 4, K256(index))
    return table

fn sharedSha256KTabReaderLeave() =
    while true:
        let readers = sha256AtomicLoadI32(sharedSha256KTabReaderCount)
        if readers <= 0:
            panic("sha256 shared K table reader underflow")
        if sha256AtomicCasI32(
                sharedSha256KTabReaderCount,
                readers,
                readers - 1) != 0:
            return

fn sharedSha256KTabReaderEnter(): bool =
    if sha256AtomicLoadI32(sharedSha256KTabStateWord) !=
       sharedSha256KTabStateReady:
        return false
    while true:
        let readers = sha256AtomicLoadI32(sharedSha256KTabReaderCount)
        if readers < 0 || readers == int32(2147483647):
            panic("sha256 shared K table reader overflow")
        if sha256AtomicCasI32(
                sharedSha256KTabReaderCount,
                readers,
                readers + 1) != 0:
            if sha256AtomicLoadI32(sharedSha256KTabStateWord) ==
               sharedSha256KTabStateReady:
                return true
            sharedSha256KTabReaderLeave()
            return false

fn sharedSha256KTabLeaseRelease(lease: var Sha256KTableLease) =
    if lease.table.data == nil || lease.table.len != 256:
        panic("sha256 K table lease release invalid")
    if lease.sharedLease:
        sharedSha256KTabReaderLeave()
        lease.table.data = nil
        lease.table.len = 0
        lease.sharedLease = false
        return
    BytesFree(lease.table)

@borrows
fn sha256BytesDataPtr(bytes: rawbytes.Bytes): ptr =
    return bytes.data

fn sharedSha256KTabPrivateLease(): Sha256KTableLease =
    return Sha256KTableLease(
        table: sharedSha256KTabBuild(),
        sharedLease: false
    )

fn sharedSha256KTabSharedViewLease(): Sha256KTableLease =
    return Sha256KTableLease(
        table: BytesView(sha256BytesDataPtr(sharedSha256KTabCache), 256),
        sharedLease: true
    )

fn sharedSha256KTabAcquire(): Sha256KTableLease =
    while true:
        let state = sha256AtomicLoadI32(sharedSha256KTabStateWord)
        if state == sharedSha256KTabStateReady:
            if !sharedSha256KTabReaderEnter():
                continue
            if sha256BytesDataPtr(sharedSha256KTabCache) == nil ||
               sharedSha256KTabCache.len != 256:
                sharedSha256KTabReaderLeave()
                panic("sha256 shared K table ready state invalid")
            return sharedSha256KTabSharedViewLease()
        if state == sharedSha256KTabStateEmpty:
            if sha256AtomicCasI32(
                    sharedSha256KTabStateWord,
                    sharedSha256KTabStateEmpty,
                    sharedSha256KTabStateInitializing) != 0:
                var table: Bytes
                table = sharedSha256KTabBuild()
                sharedSha256KTabCache.data = sha256BytesDataPtr(table)
                sharedSha256KTabCache.len = table.len
                table.data = nil
                table.len = 0
                sha256AtomicStoreI32(
                    sharedSha256KTabReaderCount,
                    1)
                sha256AtomicStoreI32(
                    sharedSha256KTabStateWord,
                    sharedSha256KTabStateReady)
                return sharedSha256KTabSharedViewLease()
            return sharedSha256KTabPrivateLease()
        if state == sharedSha256KTabStateInitializing:
            return sharedSha256KTabPrivateLease()
        panic("sha256 shared K table used after close")

fn Sha256SharedKTableClose(): bool =
    let state = sha256AtomicLoadI32(sharedSha256KTabStateWord)
    if state == sharedSha256KTabStateEmpty:
        if sha256AtomicCasI32(
                sharedSha256KTabStateWord,
                sharedSha256KTabStateEmpty,
                sharedSha256KTabStateClosed) != 0:
            return true
        return false
    if state != sharedSha256KTabStateReady:
        return false
    if sha256AtomicCasI32(
            sharedSha256KTabStateWord,
            sharedSha256KTabStateReady,
            sharedSha256KTabStateClosing) == 0:
        return false
    if sha256AtomicLoadI32(sharedSha256KTabReaderCount) != 0:
        sha256AtomicStoreI32(
            sharedSha256KTabStateWord,
            sharedSha256KTabStateReady)
        return false
    var table = BytesTake(sharedSha256KTabCache)
    BytesFree(table)
    sha256AtomicStoreI32(
        sharedSha256KTabStateWord,
        sharedSha256KTabStateClosed)
    return true

@borrows
fn Sha256DigestInto(data: Bytes, stateBuf: var Bytes, msg: var Bytes, out: var Bytes) =
    # Zero-heap-traffic digest: caller-provided scratch, reused across calls
    # (parallel ingest workers build thousands of digests per publish; the
    # allocating form's per-call stateBuf/msg/out churn was the measured
    # serialization source under the runtime allocator lock). Contracts:
    # stateBuf >= 32B, msg >= data.len+72B, out >= 32B; every byte the
    # compress path reads is (re)written per call, so stale scratch content
    # is never observed. Same HW-seam compress and byte-identical result as
    # the allocating Sha256Digest wrapper below.
    StoreU32LE(stateBuf, 0, U32FromBytes(0x6a, 0x09, 0xe6, 0x67))
    StoreU32LE(stateBuf, 4, U32FromBytes(0xbb, 0x67, 0xae, 0x85))
    StoreU32LE(stateBuf, 8, U32FromBytes(0x3c, 0x6e, 0xf3, 0x72))
    StoreU32LE(stateBuf, 12, U32FromBytes(0xa5, 0x4f, 0xf5, 0x3a))
    StoreU32LE(stateBuf, 16, U32FromBytes(0x51, 0x0e, 0x52, 0x7f))
    StoreU32LE(stateBuf, 20, U32FromBytes(0x9b, 0x05, 0x68, 0x8c))
    StoreU32LE(stateBuf, 24, U32FromBytes(0x1f, 0x83, 0xd9, 0xab))
    StoreU32LE(stateBuf, 28, U32FromBytes(0x5b, 0xe0, 0xcd, 0x19))

    let inputLen: int32 = data.len
    var padZero: int32
    while ((inputLen + 1 + padZero) % 64) != 56:
        padZero = padZero + 1
    let totalLen: int32 = inputLen + 1 + padZero + 8
    if inputLen > 0:
        rawmem_support.RawmemCopy(msg.data, data.data, inputLen)
    BytesSet(msg, inputLen, 0x80)
    for padIdx in inputLen + 1..<totalLen - 8:
        BytesSet(msg, padIdx, 0)
    var bitLen: int64 = Int64(inputLen) * 8
    for i in 0..<8:
        let byteVal: int64 = bitLen & 255
        BytesSet(msg, totalLen - 1 - i, Int32(byteVal))
        bitLen = bitLen >> 8

    var offset: int32
    var kTabLease = sharedSha256KTabAcquire()
    defer:
        sharedSha256KTabLeaseRelease(kTabLease)
    # 64-block bulk path: one HwHost call per 4096B dilutes the per-block
    # cheng loop overhead (~2600 cycles/block down to ~20) — measured 17x
    # end-to-end on the hardware-sequence prototype. Tail blocks (<64) take
    # the original per-block loop below.
    while offset + 4096 <= totalLen:
        sha256Serial64HwHost(
            stateBuf.data,
            rawmem_support.RawmemPtrAdd(msg.data, offset),
            kTabLease.table.data)
        offset = offset + 4096
    while offset < totalLen:
        sha256CompressBlockHwHost(
            stateBuf.data,
            rawmem_support.RawmemPtrAdd(msg.data, offset),
            kTabLease.table.data)
        offset = offset + 64

    SetU32BE(out, 0, LoadU32LE(stateBuf, 0))
    SetU32BE(out, 4, LoadU32LE(stateBuf, 4))
    SetU32BE(out, 8, LoadU32LE(stateBuf, 8))
    SetU32BE(out, 12, LoadU32LE(stateBuf, 12))
    SetU32BE(out, 16, LoadU32LE(stateBuf, 16))
    SetU32BE(out, 20, LoadU32LE(stateBuf, 20))
    SetU32BE(out, 24, LoadU32LE(stateBuf, 24))
    SetU32BE(out, 28, LoadU32LE(stateBuf, 28))

@borrows
fn Sha256Digest(data: Bytes): Bytes =
    # Path C production seam: per-block compress now goes through
    # cheng_crypto_sha256_compress_block (arm64 inlines the ARMv8 SHA256H/
    # SHA256H2/SHA256SU0/SHA256SU1 kernel at this call site; elsewhere it
    # runs the seam's own scalar body). state/k256 are packed native-endian
    # (LE) 32-bit words, matching the seam's LoadU32LE/StoreU32LE contract.
    let inputLen: int32 = data.len
    var padZero: int32
    while ((inputLen + 1 + padZero) % 64) != 56:
        padZero = padZero + 1
    var stateBuf: Bytes = BytesAlloc(32)
    var msg: Bytes = BytesAlloc(inputLen + 1 + padZero + 8)
    var out: Bytes = BytesAlloc(32)
    Sha256DigestInto(data, stateBuf, msg, out)
    BytesFree(stateBuf)
    BytesFree(msg)
    return out

fn Sha256FillKTable(kTab: var int64[]) =
    if kTab.len < 64:
        setLen(kTab, 64)
    for ki in 0..<64:
        kTab[ki] = K256(ki)

@borrows
fn Sha256DigestReuse(data: Bytes,
                     msg: var Bytes, kTab: int64[], w: var int64[],
                     outBytes: var Bytes) =
    var h0: int64 = U32FromBytes(0x6a, 0x09, 0xe6, 0x67)
    var h1: int64 = U32FromBytes(0xbb, 0x67, 0xae, 0x85)
    var h2: int64 = U32FromBytes(0x3c, 0x6e, 0xf3, 0x72)
    var h3: int64 = U32FromBytes(0xa5, 0x4f, 0xf5, 0x3a)
    var h4: int64 = U32FromBytes(0x51, 0x0e, 0x52, 0x7f)
    var h5: int64 = U32FromBytes(0x9b, 0x05, 0x68, 0x8c)
    var h6: int64 = U32FromBytes(0x1f, 0x83, 0xd9, 0xab)
    var h7: int64 = U32FromBytes(0x5b, 0xe0, 0xcd, 0x19)

    let inputLen: int32 = data.len
    var padZero: int32
    while ((inputLen + 1 + padZero) % 64) != 56:
        padZero = padZero + 1
    let totalLen: int32 = inputLen + 1 + padZero + 8
    if inputLen > 0:
        rawmem_support.RawmemCopy(msg.data, data.data, inputLen)
    BytesSet(msg, inputLen, 0x80)
    for padIdx in inputLen + 1..<totalLen - 8:
        BytesSet(msg, padIdx, 0)
    var bitLen: int64 = Int64(inputLen) * 8
    for i in 0..<8:
        let byteVal: int64 = bitLen & 255
        BytesSet(msg, totalLen - 1 - i, Int32(byteVal))
        bitLen = bitLen >> 8

    let mask: int64 = U32Mask()
    var offset: int32
    while offset < totalLen:
        for ts in 0..<16:
            w[ts] = GetU32BE(msg, offset + ts * 4)
        for te in 16..<64:
            let x15: int64 = w[te - 15]
            let s0w: int64 = (((x15 >> 7) | (x15 << 25)) ^ ((x15 >> 18) | (x15 << 14)) ^ (x15 >> 3)) & mask
            let x2: int64 = w[te - 2]
            let s1w: int64 = (((x2 >> 17) | (x2 << 15)) ^ ((x2 >> 19) | (x2 << 13)) ^ (x2 >> 10)) & mask
            w[te] = (w[te - 16] + s0w + w[te - 7] + s1w) & mask

        var a: int64 = h0
        var b: int64 = h1
        var c: int64 = h2
        var d: int64 = h3
        var e: int64 = h4
        var f: int64 = h5
        var g: int64 = h6
        var h: int64 = h7

        for t in 0..<64:
            let s1: int64 = (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & mask
            let chv: int64 = ((e & f) ^ ((e ^ mask) & g)) & mask
            let t1: int64 = (h + s1 + chv + kTab[t] + w[t]) & mask
            let s0: int64 = (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & mask
            let mj: int64 = ((a & b) ^ (a & c) ^ (b & c)) & mask
            let t2: int64 = (s0 + mj) & mask
            h = g
            g = f
            f = e
            e = (d + t1) & mask
            d = c
            c = b
            b = a
            a = (t1 + t2) & mask

        let sumH0: int64 = h0 + a
        let sumH1: int64 = h1 + b
        let sumH2: int64 = h2 + c
        let sumH3: int64 = h3 + d
        let sumH4: int64 = h4 + e
        let sumH5: int64 = h5 + f
        let sumH6: int64 = h6 + g
        let sumH7: int64 = h7 + h
        h0 = U32(sumH0)
        h1 = U32(sumH1)
        h2 = U32(sumH2)
        h3 = U32(sumH3)
        h4 = U32(sumH4)
        h5 = U32(sumH5)
        h6 = U32(sumH6)
        h7 = U32(sumH7)
        offset = offset + 64

    SetU32BE(outBytes, 0, h0)
    SetU32BE(outBytes, 4, h1)
    SetU32BE(outBytes, 8, h2)
    SetU32BE(outBytes, 12, h3)
    SetU32BE(outBytes, 16, h4)
    SetU32BE(outBytes, 20, h5)
    SetU32BE(outBytes, 24, h6)
    SetU32BE(outBytes, 28, h7)
