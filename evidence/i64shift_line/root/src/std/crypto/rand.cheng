# Deterministic RNG(seed required || system entropy).

import std/result
import std/rawbytes
import std/crypto/sha512
import std/crypto/chacha20poly1305

@importc("cheng_system_entropy_fill")
fn chengSystemEntropyFill(dst: ptr, len: int32): int32

type
    KeyNonceCounter =
        key: rawbytes.Bytes
        nonce: rawbytes.Bytes
        counter: int32

const
    randSeedSize: int32 = 64

var rngSeeded: bool
var rngSystemAttempted: bool
var rngKey: rawbytes.Bytes
var rngNonce: rawbytes.Bytes
var rngCounter: int32
var rngBlock: rawbytes.Bytes
var rngBlockOffset: int32

fn resetRandomState() =
    BytesFree(rngKey)
    BytesFree(rngNonce)
    BytesFree(rngBlock)
    rngCounter = 0
    rngBlockOffset = 0
    rngSeeded = false
    rngSystemAttempted = false

fn deriveKeyNonce(seed: rawbytes.Bytes): Result[KeyNonceCounter] =
    if BytesLen(seed) <= 0:
        return Err[KeyNonceCounter]("rand: seed empty")
    let digest: rawbytes.Bytes = Sha512Digest(seed)
    if BytesLen(digest) < 48:
        return Err[KeyNonceCounter]("rand: digest too short")
    let key: rawbytes.Bytes = BytesSlice(digest, 0, 32)
    let nonce: rawbytes.Bytes = BytesSlice(digest, 32, 12)
    let c0: int32 = BytesGet(digest, 44)
    let c1: int32 = BytesGet(digest, 45)
    let c2: int32 = BytesGet(digest, 46)
    let c3: int32 = BytesGet(digest, 47)
    let counter: int32 = (c0 << 24) | (c1 << 16) | (c2 << 8) | c3
    var out: KeyNonceCounter
    out.key = key
    out.nonce = nonce
    out.counter = counter
    return Ok[KeyNonceCounter](out)

fn setRandomSeed(seed: rawbytes.Bytes): bool =
    if BytesLen(seed) <= 0:
        resetRandomState()
        return false
    let res: Result[KeyNonceCounter] = deriveKeyNonce(seed)
    if IsErr(res):
        resetRandomState()
        return false
    let derived: KeyNonceCounter = Value(res)
    BytesFree(rngKey)
    BytesFree(rngNonce)
    BytesFree(rngBlock)
    rngKey = BytesSlice(derived.key, 0, BytesLen(derived.key))
    rngNonce = BytesSlice(derived.nonce, 0, BytesLen(derived.nonce))
    rngCounter = derived.counter
    rngBlockOffset = 0
    if BytesLen(rngKey) != 32 || BytesLen(rngNonce) != 12:
        resetRandomState()
        return false
    rngSeeded = true
    rngSystemAttempted = true
    return true

@borrows
fn randomFillWindows(out: rawbytes.Bytes): bool =
    let _unused: int32 = BytesLen(out)
    return false

@borrows
fn randomFillNative(out: rawbytes.Bytes): bool =
    if out.data == nil:
        return false
    if out.len <= 0:
        return false
    if chengSystemEntropyFill(out.data, out.len) != 0:
        return true
    return false

fn systemRandomBytes(length: int32): Result[rawbytes.Bytes] =
    if length <= 0:
        return Ok[rawbytes.Bytes](emptyBytes())
    let out: rawbytes.Bytes = BytesAlloc(length)
    if randomFillNative(out):
        return Ok[rawbytes.Bytes](out)
    if randomFillWindows(out):
        return Ok[rawbytes.Bytes](out)
    return Err[rawbytes.Bytes]("rand: system entropy unavailable")

fn randomSeedFromSystem(): Result[bool] =
    let seedRes: Result[rawbytes.Bytes] = systemRandomBytes(randSeedSize)
    if IsErr(seedRes):
        return Err[bool](Error(seedRes))
    let seed: rawbytes.Bytes = Value(seedRes)
    if ! setRandomSeed(seed):
        return Err[bool]("rand: seed ! set")
    return Ok[bool](true)

fn randomEnsureSeeded(): Result[bool] =
    if rngSeeded:
        return Ok[bool](true)
    if ! rngSystemAttempted:
        rngSystemAttempted = true
        let seedBytesRes: Result[rawbytes.Bytes] = systemRandomBytes(randSeedSize)
        if IsErr(seedBytesRes):
            return Err[bool](Error(seedBytesRes))
        let seedBytes: rawbytes.Bytes = Value(seedBytesRes)
        let seedOk: bool = setRandomSeed(seedBytes)
        var seedRes: Result[bool]
        if seedOk:
            seedRes = Ok[bool](true)
        else:
            seedRes = Err[bool]("rand: seed ! set")
        if IsErr(seedRes):
            return Err[bool](Error(seedRes))
    if ! rngSeeded:
        return Err[bool]("rand: seed ! set")
    return Ok[bool](true)

fn randomBytes(length: int32): Result[rawbytes.Bytes] =
    if length <= 0:
        return Ok[rawbytes.Bytes](emptyBytes())
    if !rngSeeded:
        return systemRandomBytes(length)
    let seedRes: Result[bool] = randomEnsureSeeded()
    if IsErr(seedRes):
        return Err[rawbytes.Bytes](Error(seedRes))
    let out: rawbytes.Bytes = BytesAlloc(length)
    var i: int32
    while i < length:
        if rngBlockOffset >= BytesLen(rngBlock):
            let block: rawbytes.Bytes = Chacha20Block(rngKey, rngCounter, rngNonce)
            BytesFree(rngBlock)
            rngBlock = block
            rngCounter = rngCounter + 1
            rngBlockOffset = 0
        let blockOffset: int32 = rngBlockOffset
        let byteValue: int32 = BytesGet(rngBlock, blockOffset)
        BytesSet(out, i, byteValue)
        rngBlockOffset = rngBlockOffset + 1
        i = i + 1
    return Ok[rawbytes.Bytes](out)

@borrows
fn randomFill(out: rawbytes.Bytes): bool =
    if out.data == nil || out.len <= 0:
        return false
    if randomFillNative(out):
        return true
    if randomFillWindows(out):
        return true
    return false

fn SetRandomSeed(seed: rawbytes.Bytes): bool =
    return setRandomSeed(seed)

fn RandomBytes(length: int32): Result[rawbytes.Bytes] =
    return randomBytes(length)

# Fills through the data pointer; does not consume the struct.
@borrows
fn RandomFill(out: rawbytes.Bytes): bool =
    return randomFill(out)
