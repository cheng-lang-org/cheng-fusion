# ML-KEM (FIPS 203) polynomial math layer over R_q = Z_q[x]/(x^256 + 1),
# q = 3329, zeta = 17.
#   - NTT / inverse NTT          (FIPS 203 Algorithms 9 / 10)
#   - MultiplyNTTs / BaseCaseMultiply (Algorithms 11 / 12)
#   - ByteEncode_d / ByteDecode_d (Algorithms 5 / 6, d = 1..12)
#   - Compress_d / Decompress_d   (Section 4.2.1, d = 1..11)
#   - SampleNTT                   (Algorithm 7, SHAKE128 rejection sampling)
#   - SamplePolyCBD_eta           (Algorithm 8, eta = 2 or 3)
# Coefficients are kept canonical in [0, q). All intermediates stay below
# 2^31, so plain int32 arithmetic is exact.

import std/rawbytes
import std/system
import std/crypto/sha3

fn MlkemQ(): int32 =
    return 3329

fn MlkemN(): int32 =
    return 256

# 128^{-1} mod q (for the final INTT scaling).
fn mlkemInv128(): int32 =
    return 3303

fn MlkemAddMod(a: int32, b: int32): int32 =
    return (a + b) % 3329

fn MlkemSubMod(a: int32, b: int32): int32 =
    return (a - b + 3329) % 3329

fn MlkemMulMod(a: int32, b: int32): int32 =
    return (a * b) % 3329

# Reverse the low 7 bits of x.
fn mlkemBitRev7(x: int32): int32 =
    var out: int32
    var i: int32
    while i < 7:
        out = (out << 1) | ((x >> i) & 1)
        i = i + 1
    return out

# zetas[i] = 17^BitRev7(i) mod q for i in 0..127 (NTT twiddle factors).
fn mlkemZetaTable(): int32[] =
    var pow17: int32[]
    setLen(pow17, 128)
    pow17[0] = 1
    for k in 1..<128:
        pow17[k] = (pow17[k - 1] * 17) % 3329
    var zetas: int32[]
    setLen(zetas, 128)
    for i in 0..<128:
        zetas[i] = pow17[mlkemBitRev7(i)]
    return zetas

fn MlkemPolyNew(): int32[] =
    var f: int32[]
    setLen(f, 256)
    return f

fn MlkemPolyAdd(f: int32[], g: int32[]): int32[] =
    Assert(f.len == 256 && g.len == 256, "MlkemPolyAdd: polynomials must have 256 coefficients")
    var h: int32[]
    setLen(h, 256)
    for i in 0..<256:
        h[i] = (f[i] + g[i]) % 3329
    return h

fn MlkemPolySub(f: int32[], g: int32[]): int32[] =
    Assert(f.len == 256 && g.len == 256, "MlkemPolySub: polynomials must have 256 coefficients")
    var h: int32[]
    setLen(h, 256)
    for i in 0..<256:
        h[i] = (f[i] - g[i] + 3329) % 3329
    return h

# FIPS 203 Algorithm 9: in-place NTT, 7 butterfly layers.
fn MlkemNtt(f: var int32[]) =
    Assert(f.len == 256, "MlkemNtt: polynomial must have 256 coefficients")
    let zetas: int32[] = mlkemZetaTable()
    var i: int32 = 1
    var span: int32 = 128
    while span >= 2:
        var start: int32
        while start < 256:
            let zeta: int32 = zetas[i]
            i = i + 1
            var j: int32 = start
            while j < start + span:
                let t: int32 = (zeta * f[j + span]) % 3329
                f[j + span] = (f[j] - t + 3329) % 3329
                f[j] = (f[j] + t) % 3329
                j = j + 1
            start = start + 2 * span
        span = span / 2

# FIPS 203 Algorithm 10: in-place inverse NTT.
fn MlkemIntt(f: var int32[]) =
    Assert(f.len == 256, "MlkemIntt: polynomial must have 256 coefficients")
    let zetas: int32[] = mlkemZetaTable()
    var i: int32 = 127
    var span: int32 = 2
    while span <= 128:
        var start: int32
        while start < 256:
            let zeta: int32 = zetas[i]
            i = i - 1
            var j: int32 = start
            while j < start + span:
                let t: int32 = f[j]
                f[j] = (t + f[j + span]) % 3329
                f[j + span] = (zeta * ((f[j + span] - t + 3329) % 3329)) % 3329
                j = j + 1
            start = start + 2 * span
        span = span * 2
    for k in 0..<256:
        f[k] = (f[k] * mlkemInv128()) % 3329

# FIPS 203 Algorithm 11 (MultiplyNTTs) with Algorithm 12 (BaseCaseMultiply)
# inlined: gamma_i = 17^(2*BitRev7(i)+1) = zetas[i]^2 * 17 mod q.
fn MlkemMultiplyNtts(f: int32[], g: int32[]): int32[] =
    Assert(f.len == 256 && g.len == 256, "MlkemMultiplyNtts: polynomials must have 256 coefficients")
    let zetas: int32[] = mlkemZetaTable()
    var h: int32[]
    setLen(h, 256)
    for i in 0..<128:
        let zsq: int32 = (zetas[i] * zetas[i]) % 3329
        let gamma: int32 = (zsq * 17) % 3329
        let a0: int32 = f[2 * i]
        let a1: int32 = f[2 * i + 1]
        let b0: int32 = g[2 * i]
        let b1: int32 = g[2 * i + 1]
        let a1b1: int32 = (a1 * b1) % 3329
        h[2 * i] = ((a0 * b0) % 3329 + (a1b1 * gamma) % 3329) % 3329
        h[2 * i + 1] = ((a0 * b1) % 3329 + (a1 * b0) % 3329) % 3329
    return h

# Compress_d(x) = round(2^d * x / q) mod 2^d, ties round up (FIPS 203 4.2.1).
# round(a/q) half-up == floor((2a + q) / (2q)); ties never occur for
# 0 < x < q since q is odd.
fn MlkemCompress(x: int32, d: int32): int32 =
    Assert(d >= 1 && d <= 11, "MlkemCompress: d must be in 1..11")
    Assert(x >= 0 && x < 3329, "MlkemCompress: x must be in [0, q)")
    let rounded: int32 = ((x << (d + 1)) + 3329) / 6658
    return rounded & ((1 << d) - 1)

# Decompress_d(y) = round(q * y / 2^d), ties round up.
fn MlkemDecompress(y: int32, d: int32): int32 =
    Assert(d >= 1 && d <= 11, "MlkemDecompress: d must be in 1..11")
    Assert(y >= 0 && y < (1 << d), "MlkemDecompress: y must be in [0, 2^d)")
    return (3329 * y + (1 << (d - 1))) >> d

# FIPS 203 Algorithm 5: pack 256 d-bit integers into 32*d bytes,
# little-endian bit order within the stream.
fn MlkemByteEncode(f: int32[], d: int32): Bytes =
    Assert(d >= 1 && d <= 12, "MlkemByteEncode: d must be in 1..12")
    Assert(f.len == 256, "MlkemByteEncode: polynomial must have 256 coefficients")
    var m: int32 = 1 << d
    if d == 12:
        m = 3329
    let out: Bytes = BytesAlloc(32 * d)
    var acc: int32
    var accBits: int32
    var outPos: int32
    for i in 0..<256:
        Assert(f[i] >= 0 && f[i] < m, "MlkemByteEncode: coefficient out of range")
        acc = acc | (f[i] << accBits)
        accBits = accBits + d
        while accBits >= 8:
            BytesSet(out, outPos, acc & 255)
            outPos = outPos + 1
            acc = acc >> 8
            accBits = accBits - 8
    return out

# FIPS 203 Algorithm 6: unpack 32*d bytes into 256 d-bit integers;
# for d = 12 values are reduced mod q.
fn MlkemByteDecode(b: Bytes, d: int32): int32[] =
    Assert(d >= 1 && d <= 12, "MlkemByteDecode: d must be in 1..12")
    Assert(BytesLen(b) == 32 * d, "MlkemByteDecode: input must be 32*d bytes")
    var f: int32[]
    setLen(f, 256)
    var acc: int32
    var accBits: int32
    var pos: int32
    for i in 0..<256:
        while accBits < d:
            acc = acc | (BytesGet(b, pos) << accBits)
            pos = pos + 1
            accBits = accBits + 8
        var v: int32 = acc & ((1 << d) - 1)
        acc = acc >> d
        accBits = accBits - d
        if d == 12:
            v = v % 3329
        f[i] = v
    return f

# FIPS 203 Algorithm 7: rejection-sample a polynomial in the NTT domain
# from SHAKE128(seed). seed is the 34-byte XOF input (rho || j || i).
# The one-shot SHAKE is re-squeezed with a longer output when the stream
# runs out; SHAKE outputs are prefix-consistent, so already-consumed
# positions keep their values.
fn MlkemSampleNtt(seed: Bytes): int32[] =
    Assert(BytesLen(seed) == 34, "MlkemSampleNtt: seed must be 34 bytes")
    var a: int32[]
    setLen(a, 256)
    var bufLen: int32 = 504
    var buf: Bytes = Shake128Xof(seed, bufLen)
    var pos: int32
    var j: int32
    while j < 256:
        if pos + 3 > bufLen:
            bufLen = bufLen + 504
            buf = Shake128Xof(seed, bufLen)
        let c0: int32 = BytesGet(buf, pos)
        let c1: int32 = BytesGet(buf, pos + 1)
        let c2: int32 = BytesGet(buf, pos + 2)
        pos = pos + 3
        let d1: int32 = c0 + 256 * (c1 % 16)
        let d2: int32 = c1 / 16 + 16 * c2
        if d1 < 3329:
            a[j] = d1
            j = j + 1
        if d2 < 3329 && j < 256:
            a[j] = d2
            j = j + 1
    return a

# FIPS 203 Algorithm 8: centered binomial distribution sample from 64*eta
# input bytes (the PRF output). Coefficients are stored mod q, so a draw
# of -k appears as q - k.
fn MlkemSamplePolyCbd(b: Bytes, eta: int32): int32[] =
    Assert(eta == 2 || eta == 3, "MlkemSamplePolyCbd: eta must be 2 or 3")
    Assert(BytesLen(b) == 64 * eta, "MlkemSamplePolyCbd: input must be 64*eta bytes")
    var f: int32[]
    setLen(f, 256)
    for i in 0..<256:
        var x: int32
        var y: int32
        for j in 0..<eta:
            let bitIdx: int32 = 2 * i * eta + j
            x = x + ((BytesGet(b, bitIdx / 8) >> (bitIdx % 8)) & 1)
        for k in 0..<eta:
            let bitIdx2: int32 = 2 * i * eta + eta + k
            y = y + ((BytesGet(b, bitIdx2 / 8) >> (bitIdx2 % 8)) & 1)
        f[i] = (x - y + 3329) % 3329
    return f
