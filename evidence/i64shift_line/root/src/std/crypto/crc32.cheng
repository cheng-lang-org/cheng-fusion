# CRC-32 (IEEE 802.3): poly 0xEDB88320, init 0xFFFFFFFF, final XOR 0xFFFFFFFF.
#
# Returns the unsigned 32-bit checksum in an int64 (low 32 bits). The int64
# carrier keeps the u32 value positive so callers can compare against hex
# constants and extract big-endian bytes without int32 sign issues.

import std/rawbytes
import std/system

fn crc32Mask(): int64 =
    return (int64(1) << 32) - 1

fn Crc32(data: Bytes): int64 =
    let mask: int64 = crc32Mask()
    var crc: int64 = mask
    let n: int32 = BytesLen(data)
    for i in 0..<n:
        crc = crc ^ int64(BytesGet(data, i) & 255)
        for bit in 0..<8:
            if (crc & 1) != 0:
                crc = (crc >> 1) ^ int64(0xEDB88320)
            else:
                crc = crc >> 1
    return (crc ^ mask) & mask
