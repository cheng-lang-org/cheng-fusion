import std/result
import std/system
import std/rawbytes
import std/crypto/sha256
import cheng/std/bytes_layout as layout

@borrows
fn Sha256Fixed(data: layout.ByteSpan): layout.FixedBytes32 =
    var digestBytes: Bytes = sha256.Sha256Digest(data.data)
    let digestRes: Result[layout.FixedBytes32] = layout.FixedBytes32FromBytes(digestBytes)
    if IsErr(digestRes):
        BytesFree(digestBytes)
        system.Panic(" hash256: sha256 digest width mismatch")
    let out = Value(digestRes)
    BytesFree(digestBytes)
    return out

@borrows
fn Sha256FixedTwo(first: layout.ByteSpan,
                  second: layout.ByteSpan): layout.FixedBytes32 =
    var digestBytes = sha256.Sha256DigestTwo(first.data, second.data)
    let digestRes: Result[layout.FixedBytes32] =
        layout.FixedBytes32FromBytes(digestBytes)
    if IsErr(digestRes):
        BytesFree(digestBytes)
        system.Panic(" hash256: sha256 two-part digest width mismatch")
    let out = Value(digestRes)
    BytesFree(digestBytes)
    return out
