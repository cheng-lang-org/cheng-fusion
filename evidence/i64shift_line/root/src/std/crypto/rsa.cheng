import std/strutils as strutil
# RSA helpers(minimal, small-int implementation).

import std/result
import std/rawbytes
import std/buffer as bytebuffer
import std/strings
import std/crypto/rand
import std/crypto/sha256
import std/crypto/sha384
import std/crypto/minasn1
import std/crypto/bigint
const
    rsaDefaultPrimeBits = 30
    rsaMinPrimeBits = 8
    rsaMaxPrimeBits = 31
    rsaDefaultE = 65537
    rsaExponentCandidateCount = 5
    rsaSignatureScratchCapacity = 512
    rsaBCryptRsaPrivateMagic = 0x32415352
    rsaBCryptRsaFullPrivateMagic = 0x33415352
    rsaBCryptPadPss = 0x00000008

var
    rsaPssSignatureScratch: Bytes
    rsaPssSignatureScratchLen: int32
    rsaPssSignatureHexScratch: str
    rsaPssSignatureScratchBytes: int32[rsaSignatureScratchCapacity]

@importc("BCryptOpenAlgorithmProvider")
fn rsaBCryptOpenAlgorithmProvider(outAlg: ptr, algId: ptr, implementation: ptr, flags: int32): int32
@importc("BCryptCloseAlgorithmProvider")
fn rsaBCryptCloseAlgorithmProvider(alg: ptr, flags: int32): int32
@importc("BCryptImportKeyPair")
fn rsaBCryptImportKeyPair(alg: ptr, importKey: ptr, blobType: ptr, outKey: ptr, input: ptr, inputLen: int32, flags: int32): int32
@importc("BCryptDestroyKey")
fn rsaBCryptDestroyKey(key: ptr): int32
@importc("BCryptSignHash")
fn rsaBCryptSignHash(key: ptr, paddingInfo: ptr, input: ptr, inputLen: int32, output: ptr, outputLen: int32, resultLen: ptr, flags: int32): int32
@importc("store_ptr")
fn rsaStorePtr(dst: ptr, value: ptr)
@importc("load_ptr")
fn rsaLoadPtr(src: ptr): ptr
@importc("store_int32")
fn rsaStoreInt32(dst: ptr, value: int32)
@importc("load_int32")
fn rsaLoadInt32(src: ptr): int32
@importc("ptr_add")
fn rsaPtrAdd(p: ptr, off: int32): ptr
@importc("cheng_windows_rsa_pss_sign_blob")
fn rsaWindowsPssSignBlob(blob: ptr, blobLen: int32, digest: ptr, digestLen: int32, useSha384: int32, out: ptr): int32
@importc("cheng_windows_rsa_pss_sign_pkcs8")
fn rsaWindowsPssSignPkcs8(pk8: ptr, pk8Len: int32, digest: ptr, digestLen: int32, useSha384: int32, out: ptr): int32
@importc("cheng_windows_rsa_pss_verify_public_blob")
fn rsaWindowsPssVerifyPublicBlob(blob: ptr, blobLen: int32, digest: ptr, digestLen: int32, useSha384: int32, sig: ptr): int32

type
    RsaPublicKey =
        n: int64
        e: int64

    RsaPrivateKey =
        n: int64
        e: int64
        d: int64
        p: int64
        q: int64

    RsaKeyPair =
        publicKey: RsaPublicKey
        privateKey: RsaPrivateKey

    RsaBigPublicKey =
        n: bigint.BigInt
        e: bigint.BigInt
        modBits: int32
        modLen: int32

    RsaBigPrivateKey =
        n: bigint.BigInt
        d: bigint.BigInt
        modBits: int32
        modLen: int32

fn rsaCopyBytes(dst: var Bytes, dstOffset: int32, src: Bytes, srcOffset: int32, count: int32) =
    if count <= 0:
        return
    for i in 0..<count:
        BytesSet(dst, dstOffset + i, BytesGet(src, srcOffset + i))

@borrows
fn rsaBigSetInto(out: var bigint.BigInt, value: bigint.BigInt) =
    out.count = value.count
    for i in 0..<256:
        out.limbs[i] = value.limbs[i]
    bigint.bigNormalize(out)

@borrows
fn rsaBigCopyInto(value: bigint.BigInt): bigint.BigInt =
    var out: bigint.BigInt
    rsaBigSetInto(out, value)
    return out

fn rsaBigWordToU64(w: int32): uint64 =
    return uint64(uint32(w))

fn rsaBigWordToI64(w: int32): int64 =
    if w >= 0:
        return int64(w)
    return (int64(1) << 32) - (int64(0) - int64(w))

fn rsaBigWordFromBits(v: uint64): int32 =
    let low: uint64 = v - ((v >> uint64(32)) << uint64(32))
    if low < (uint64(1) << uint64(31)):
        return int32(low)
    return 0 - int32((uint64(1) << uint64(32)) - low)

fn rsaBigLowByte(value: uint64): int32 =
    return int32(value & uint64(0xff))

fn rsaBigLowHalfBits(value: uint64): uint64 =
    return value & uint64(0xffff)

fn rsaBigLimbAt(a: var bigint.BigInt, idx: int32): int32 =
    return a.limbs[idx]

fn rsaBigHalfDigitCount(a: var bigint.BigInt): int32 =
    if a.count <= 0:
        return 0
    if a.count > 256:
        return -1
    let topIdx: int32 = a.count - 1
    let top: uint64 = rsaBigWordToU64(rsaBigLimbAt(a, topIdx))
    return (a.count - 1) * 2 + (if (top >> uint64(16)) != uint64(0): 2 else: 1)

fn rsaBigGetHalfDigit(a: var bigint.BigInt, idx: int32): uint64 =
    if idx < 0:
        return uint64(0)
    let limbIdx: int32 = idx / 2
    if limbIdx < 0 || limbIdx >= a.count:
        return uint64(0)
    let word: uint64 = rsaBigWordToU64(a.limbs[limbIdx])
    if (idx & 1) == 0:
        return word & uint64(0xffff)
    return (word >> uint64(16)) & uint64(0xffff)

fn rsaBigHalfDigitScratchGet(digits: Bytes, idx: int32): uint64 =
    let offset: int32 = idx * 2
    let lo: uint64 = uint64(BytesGet(digits, offset))
    let hi: uint64 = uint64(BytesGet(digits, offset + 1))
    return lo | (hi << uint64(8))

fn rsaBigHalfDigitScratchSet(digits: Bytes, idx: int32, value: uint64) =
    let offset: int32 = idx * 2
    BytesSet(digits, offset, rsaBigLowByte(value))
    BytesSet(digits, offset + 1, rsaBigLowByte(value >> uint64(8)))

fn rsaBigNormalizeInto(a: var bigint.BigInt): Result[bool] =
    if a.count < 0 || a.count > 256:
        return Err[bool]("rsa: bigint count out of range")
    let iStart: int32 = a.count - 1
    if iStart >= 0:
        for iOffset in 0..iStart:
            let i: int32 = iStart - iOffset
            if a.limbs[i] != 0:
                a.count = i + 1
                return Ok[bool](true)
    a.count = 0
    return Ok[bool](true)

fn rsaBigCopyVarInto(out: var bigint.BigInt, src: var bigint.BigInt): Result[bool] =
    if src.count < 0 || src.count > 256:
        return Err[bool]("rsa: bigint source count out of range")
    out.count = src.count
    for i in 0..<256:
        out.limbs[i] = src.limbs[i]
    return rsaBigNormalizeInto(out)

fn rsaBigSetSmallInto(out: var bigint.BigInt, value: int32): Result[bool] =
    out.count = 0
    for i in 0..<256:
        out.limbs[i] = 0
    if value <= 0:
        return Ok[bool](true)
    out.count = 1
    out.limbs[0] = value
    return Ok[bool](true)

fn rsaBigCmpVar(a: var bigint.BigInt, b: var bigint.BigInt): int32 =
    var aCount: int32 = a.count
    if aCount > 256:
        aCount = 256
    while aCount > 0 && a.limbs[aCount - 1] == 0:
        aCount = aCount - 1
    var bCount: int32 = b.count
    if bCount > 256:
        bCount = 256
    while bCount > 0 && b.limbs[bCount - 1] == 0:
        bCount = bCount - 1
    if aCount < bCount:
        return -1
    if aCount > bCount:
        return 1
    let iStart: int32 = aCount - 1
    if iStart >= 0:
        for iOffset in 0..iStart:
            let i: int32 = iStart - iOffset
            let av: int64 = rsaBigWordToI64(a.limbs[i])
            let bv: int64 = rsaBigWordToI64(b.limbs[i])
            if av < bv:
                return -1
            if av > bv:
                return 1
    return 0

fn rsaBigTrySubInPlace(a: var bigint.BigInt, b: var bigint.BigInt): Result[bool] =
    var original: bigint.BigInt
    let originalRes: Result[bool] = rsaBigCopyVarInto(original, a)
    if IsErr(originalRes):
        return Err[bool](Error(originalRes))
    var borrow: int64
    var maxCount: int32 = a.count
    if b.count > maxCount:
        maxCount = b.count
    if maxCount > 256:
        return Err[bool]("rsa: bigint subtract count invalid")
    for i in 0..<maxCount:
        let av: int64 = rsaBigWordToI64(a.limbs[i])
        var bv: int64
        if i < b.count:
            bv = rsaBigWordToI64(b.limbs[i])
        var diff: int64 = av - bv - borrow
        if diff < 0:
            diff = diff + (int64(1) << 32)
            borrow = 1
        else:
            borrow = 0
        a.limbs[i] = rsaBigWordFromBits(uint64(diff))
    if borrow != 0:
        let restoreRes: Result[bool] = rsaBigCopyVarInto(a, original)
        if IsErr(restoreRes):
            return Err[bool](Error(restoreRes))
        return Ok[bool](false)
    a.count = maxCount
    return rsaBigNormalizeInto(a)

fn rsaBigSubInPlace(a: var bigint.BigInt, b: var bigint.BigInt): Result[bool] =
    let subRes: Result[bool] = rsaBigTrySubInPlace(a, b)
    if IsErr(subRes):
        return Err[bool](Error(subRes))
    if ! Value(subRes):
        return Err[bool]("rsa: bigint subtract borrow")
    return Ok[bool](true)

fn rsaBigModSubInto(out: var bigint.BigInt, a: var bigint.BigInt, b: var bigint.BigInt, m: var bigint.BigInt): Result[bool] =
    var left: bigint.BigInt
    let leftRes: Result[bool] = rsaBigModInto(left, a, m)
    if IsErr(leftRes):
        return Err[bool](Error(leftRes))
    var right: bigint.BigInt
    let rightRes: Result[bool] = rsaBigModInto(right, b, m)
    if IsErr(rightRes):
        return Err[bool](Error(rightRes))
    if rsaBigCmpVar(left, right) >= 0:
        let copyRes: Result[bool] = rsaBigCopyVarInto(out, left)
        if IsErr(copyRes):
            return Err[bool](Error(copyRes))
        let subLeftRes: Result[bool] = rsaBigSubInPlace(out, right)
        if IsErr(subLeftRes):
            return Err[bool](strutil.Join(["rsa: modsub left subtract: ", Error(subLeftRes)], ""))
        return Ok[bool](true)
    let baseRes: Result[bool] = rsaBigCopyVarInto(out, m)
    if IsErr(baseRes):
        return Err[bool](Error(baseRes))
    let subRes: Result[bool] = rsaBigSubInPlace(out, right)
    if IsErr(subRes):
        return Err[bool](strutil.Join(["rsa: modsub base subtract: ", Error(subRes)], ""))
    let addRes: Result[bool] = rsaBigAddModInPlace(out, left, m)
    if IsErr(addRes):
        return Err[bool](strutil.Join(["rsa: modsub add: ", Error(addRes)], ""))
    return Ok[bool](true)

fn rsaBigAddModInPlace(a: var bigint.BigInt, b: var bigint.BigInt, m: var bigint.BigInt): Result[bool] =
    var carry: uint64
    var maxCount: int32 = a.count
    if b.count > maxCount:
        maxCount = b.count
    if maxCount > 256:
        return Err[bool]("rsa: bigint addmod count")
    for i in 0..<maxCount:
        var av: uint64
        if i < a.count:
            av = rsaBigWordToU64(a.limbs[i])
        var bv: uint64
        if i < b.count:
            bv = rsaBigWordToU64(b.limbs[i])
        let sum: uint64 = av + bv + carry
        a.limbs[i] = rsaBigWordFromBits(sum)
        carry = sum >> uint64(32)
    a.count = maxCount
    if carry != uint64(0):
        if a.count >= 256:
            return Err[bool]("rsa: bigint addmod overflow")
        a.limbs[a.count] = rsaBigWordFromBits(carry)
        a.count = a.count + 1
    let normRes: Result[bool] = rsaBigNormalizeInto(a)
    if IsErr(normRes):
        return Err[bool](Error(normRes))
    if rsaBigCmpVar(a, m) >= 0:
        let subRes: Result[bool] = rsaBigSubInPlace(a, m)
        if IsErr(subRes):
            return Err[bool](strutil.Join(["rsa: addmod subtract: ", Error(subRes)], ""))
        return Ok[bool](true)
    return Ok[bool](true)

fn rsaBigDoubleAddBitModInPlace(a: var bigint.BigInt, bit: int32, m: var bigint.BigInt): Result[bool] =
    var carry: uint64 = uint64(bit & 1)
    for i in 0..<a.count:
        let wide: uint64 = (rsaBigWordToU64(a.limbs[i]) << uint64(1)) + carry
        a.limbs[i] = rsaBigWordFromBits(wide)
        carry = wide >> uint64(32)
    if carry != uint64(0):
        if a.count >= 256:
            return Err[bool]("rsa: bigint double overflow")
        a.limbs[a.count] = rsaBigWordFromBits(carry)
        a.count = a.count + 1
    let normRes: Result[bool] = rsaBigNormalizeInto(a)
    if IsErr(normRes):
        return Err[bool](Error(normRes))
    while m.count > 0 && rsaBigCmpVar(a, m) >= 0:
        let subRes: Result[bool] = rsaBigSubInPlace(a, m)
        if IsErr(subRes):
            return Err[bool](strutil.Join(["rsa: doublemod subtract: ", Error(subRes)], ""))
    return Ok[bool](true)

fn rsaBigBitLenVar(a: var bigint.BigInt): int32 =
    if a.count <= 0:
        return 0
    if a.count > 256:
        return -1
    let topIdx: int32 = a.count - 1
    var v: uint64 = rsaBigWordToU64(rsaBigLimbAt(a, topIdx))
    var bits: int32 = (a.count - 1) * 32
    var nBits: int32
    while v != uint64(0):
        v = v >> uint64(1)
        nBits = nBits + 1
    return bits + nBits

fn rsaBigGetBitVar(a: var bigint.BigInt, idx: int32): int32 =
    if idx < 0:
        return 0
    let limbIdx: int32 = idx / 32
    if limbIdx < 0 || limbIdx >= a.count || limbIdx >= 256:
        return 0
    let shift: int32 = idx % 32
    let word: uint64 = rsaBigWordToU64(a.limbs[limbIdx])
    return int32((word >> uint64(shift)) & uint64(1))

fn rsaBigModInto(out: var bigint.BigInt, a: var bigint.BigInt, m: var bigint.BigInt): Result[bool] =
    if m.count <= 0:
        return Err[bool]("rsa: mod modulus zero")
    let initRes: Result[bool] = rsaBigSetSmallInto(out, 0)
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    let bits: int32 = rsaBigBitLenVar(a)
    if bits < 0:
        return Err[bool]("rsa: mod input count invalid")
    for offset in 0..<bits:
        let bitIndex: int32 = bits - 1 - offset
        let bit: int32 = rsaBigGetBitVar(a, bitIndex)
        let stepRes: Result[bool] = rsaBigDoubleAddBitModInPlace(out, bit, m)
        if IsErr(stepRes):
            return Err[bool](Fmt"rsa: mod step bit_index={bitIndex} out_count={out.count} m_count={m.count} err={Error(stepRes)}")
    return Ok[bool](true)

fn rsaBigModMulInto(out: var bigint.BigInt, a: var bigint.BigInt, b: var bigint.BigInt, m: var bigint.BigInt): Result[bool] =
    if m.count <= 0:
        return Err[bool]("rsa: modmul modulus zero")
    var product: bigint.BigInt
    let mulRes: Result[bool] = rsaBigMulInto(product, a, b)
    if IsErr(mulRes):
        return Err[bool](Error(mulRes))
    return rsaBigModInto(out, product, m)

fn rsaBigModMulPlainInto(out: var bigint.BigInt, a: var bigint.BigInt, b: var bigint.BigInt, m: var bigint.BigInt): Result[bool] =
    if m.count <= 0:
        return Err[bool]("rsa: plain modmul modulus zero")
    let mulRes: Result[bigint.BigInt] = bigint.bigMul(a, b)
    if IsErr(mulRes):
        return Err[bool](Error(mulRes))
    var product: bigint.BigInt
    rsaBigSetInto(product, Value(mulRes))
    let modRes: Result[bigint.BigInt] = bigint.bigMod(product, m)
    if IsErr(modRes):
        return Err[bool](Error(modRes))
    rsaBigSetInto(out, Value(modRes))
    return Ok[bool](true)

fn rsaBigModExpInto(out: var bigint.BigInt, base: var bigint.BigInt, exp: var bigint.BigInt, m: var bigint.BigInt): Result[bool] =
    var result: bigint.BigInt
    let oneRes: Result[bool] = rsaBigSetSmallInto(result, 1)
    if IsErr(oneRes):
        return Err[bool](Error(oneRes))
    var pow: bigint.BigInt
    let modRes: Result[bool] = rsaBigModInto(pow, base, m)
    if IsErr(modRes):
        return Err[bool](Error(modRes))
    let bits: int32 = rsaBigBitLenVar(exp)
    if bits < 0:
        return Err[bool]("rsa: modexp exponent count invalid")
    for i in 0..<bits:
        if rsaBigGetBitVar(exp, i) != 0:
            var nextResult: bigint.BigInt
            let mulRes: Result[bool] = rsaBigModMulInto(nextResult, result, pow, m)
            if IsErr(mulRes):
                return Err[bool](Error(mulRes))
            let copyRes: Result[bool] = rsaBigCopyVarInto(result, nextResult)
            if IsErr(copyRes):
                return Err[bool](Error(copyRes))
        var nextPow: bigint.BigInt
        let sqRes: Result[bool] = rsaBigModMulInto(nextPow, pow, pow, m)
        if IsErr(sqRes):
            return Err[bool](Error(sqRes))
        let powCopyRes: Result[bool] = rsaBigCopyVarInto(pow, nextPow)
        if IsErr(powCopyRes):
            return Err[bool](Error(powCopyRes))
    return rsaBigCopyVarInto(out, result)

fn rsaBigMulInto(out: var bigint.BigInt, a: var bigint.BigInt, b: var bigint.BigInt): Result[bool] =
    if a.count < 0 || b.count < 0 || a.count + b.count > 256:
        return Err[bool]("rsa: bigint mul count invalid")
    let initRes: Result[bool] = rsaBigSetSmallInto(out, 0)
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    if a.count <= 0 || b.count <= 0:
        return Ok[bool](true)
    let aHalfCount: int32 = rsaBigHalfDigitCount(a)
    let bHalfCount: int32 = rsaBigHalfDigitCount(b)
    if aHalfCount < 0 || bHalfCount < 0:
        return Err[bool]("rsa: bigint mul half-digit count invalid")
    let outHalfMax: int32 = aHalfCount + bHalfCount
    if outHalfMax > 512:
        return Err[bool]("rsa: bigint mul half-digit overflow")
    let outHalfDigits: Bytes = BytesAlloc(outHalfMax * 2)
    for i in 0..<aHalfCount:
        let av: uint64 = rsaBigGetHalfDigit(a, i)
        var carry: uint64
        for j in 0..<bHalfCount:
            let idx: int32 = i + j
            let bv: uint64 = rsaBigGetHalfDigit(b, j)
            let cur: uint64 = rsaBigHalfDigitScratchGet(outHalfDigits, idx)
            let prod: uint64 = av * bv
            let sum: uint64 = prod + cur + carry
            rsaBigHalfDigitScratchSet(outHalfDigits, idx, rsaBigLowHalfBits(sum))
            carry = sum >> uint64(16)
        var carryIdx: int32 = i + bHalfCount
        while carry != uint64(0):
            if carryIdx >= outHalfMax:
                return Err[bool]("rsa: bigint mul carry overflow")
            let cur: uint64 = rsaBigHalfDigitScratchGet(outHalfDigits, carryIdx)
            let sum: uint64 = cur + carry
            rsaBigHalfDigitScratchSet(outHalfDigits, carryIdx, rsaBigLowHalfBits(sum))
            carry = sum >> uint64(16)
            carryIdx = carryIdx + 1
    out.count = (outHalfMax + 1) / 2
    for outIdx in 0..<out.count:
        let lo: uint64 = rsaBigHalfDigitScratchGet(outHalfDigits, outIdx * 2)
        let hiIdx: int32 = outIdx * 2 + 1
        var hi: uint64
        if hiIdx < outHalfMax:
            hi = rsaBigHalfDigitScratchGet(outHalfDigits, hiIdx)
        out.limbs[outIdx] = rsaBigWordFromBits(lo | (hi << uint64(16)))
    return rsaBigNormalizeInto(out)

fn rsaBigAddInto(out: var bigint.BigInt, a: var bigint.BigInt, b: var bigint.BigInt): Result[bool] =
    let initRes: Result[bool] = rsaBigSetSmallInto(out, 0)
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    var maxCount: int32 = a.count
    if b.count > maxCount:
        maxCount = b.count
    if maxCount > 256:
        return Err[bool]("rsa: bigint add count invalid")
    var carry: uint64
    for i in 0..<maxCount:
        var av: uint64
        if i < a.count:
            av = rsaBigWordToU64(a.limbs[i])
        var bv: uint64
        if i < b.count:
            bv = rsaBigWordToU64(b.limbs[i])
        let sum: uint64 = av + bv + carry
        out.limbs[i] = rsaBigWordFromBits(sum)
        carry = sum >> uint64(32)
    out.count = maxCount
    if carry != uint64(0):
        if out.count >= 256:
            return Err[bool]("rsa: bigint add overflow")
        out.limbs[out.count] = rsaBigWordFromBits(carry)
        out.count = out.count + 1
    return rsaBigNormalizeInto(out)

fn rsaAppendU32LE(buf: var bytebuffer.GrowByteBuffer, value: int32) =
    bytebuffer.AppendByte(buf, value & 0xff)
    bytebuffer.AppendByte(buf, (value / 256) & 0xff)
    bytebuffer.AppendByte(buf, (value / 65536) & 0xff)
    bytebuffer.AppendByte(buf, (value / 16777216) & 0xff)

fn rsaWideAscii(text: str): Bytes =
    let out: Bytes = BytesAlloc(text.len * 2 + 2)
    for i in 0..<text.len:
        BytesSet(out, i * 2, int32(text[i]))
        BytesSet(out, i * 2 + 1, 0)
    BytesSet(out, text.len * 2, 0)
    BytesSet(out, text.len * 2 + 1, 0)
    return out

fn rsaTrimLeadingZeroOffset(data: Bytes): int32 =
    var offset: int32
    while offset + 1 < BytesLen(data) && BytesGet(data, offset) == 0:
        offset = offset + 1
    return offset

fn rsaAppendBytesRange(buf: var bytebuffer.GrowByteBuffer, data: Bytes, offset: int32, count: int32) =
    for i in 0..<count:
        bytebuffer.AppendByte(buf, BytesGet(data, offset + i))

fn rsaAppendBytesFixedBE(buf: var bytebuffer.GrowByteBuffer, data: Bytes, width: int32): Result[bool] =
    let off: int32 = rsaTrimLeadingZeroOffset(data)
    let n: int32 = BytesLen(data) - off
    if width <= 0 || n <= 0 || n > width:
        return Err[bool]("rsa: invalid fixed key part length")
    for _ in 0..<(width - n):
        bytebuffer.AppendByte(buf, 0)
    rsaAppendBytesRange(buf, data, off, n)
    return Ok[bool](true)

fn rsaBlobPutU32LE(out: Bytes, pos: var int32, value: int32) =
    BytesSet(out, pos, value & 0xff)
    BytesSet(out, pos + 1, (value / 256) & 0xff)
    BytesSet(out, pos + 2, (value / 65536) & 0xff)
    BytesSet(out, pos + 3, (value / 16777216) & 0xff)
    pos = pos + 4

fn rsaBlobCopyRange(out: Bytes, pos: var int32, data: Bytes, offset: int32, count: int32) =
    for i in 0..<count:
        BytesSet(out, pos + i, BytesGet(data, offset + i))
    pos = pos + count

fn rsaBlobCopyFixedBE(out: Bytes, pos: var int32, data: Bytes, width: int32): Result[bool] =
    let off: int32 = rsaTrimLeadingZeroOffset(data)
    let n: int32 = BytesLen(data) - off
    if width <= 0 || n <= 0 || n > width:
        return Err[bool]("rsa: invalid fixed key part length")
    for _ in 0..<(width - n):
        BytesSet(out, pos, 0)
        pos = pos + 1
    rsaBlobCopyRange(out, pos, data, off, n)
    return Ok[bool](true)

fn rsaBuildBCryptFullPrivateBlobFill(
    nBytes: Bytes,
    eBytes: Bytes,
    dBytes: Bytes,
    pBytes: Bytes,
    qBytes: Bytes,
    dpBytes: Bytes,
    dqBytes: Bytes,
    qiBytes: Bytes,
    bitLen: int32,
    out: Bytes
): Result[int32] =
    let nOff: int32 = rsaTrimLeadingZeroOffset(nBytes)
    let eOff: int32 = rsaTrimLeadingZeroOffset(eBytes)
    let pOff: int32 = rsaTrimLeadingZeroOffset(pBytes)
    let qOff: int32 = rsaTrimLeadingZeroOffset(qBytes)
    let nLen: int32 = BytesLen(nBytes) - nOff
    let eLen: int32 = BytesLen(eBytes) - eOff
    let pLen: int32 = BytesLen(pBytes) - pOff
    let qLen: int32 = BytesLen(qBytes) - qOff
    let totalLen: int32 = 24 + eLen + nLen + pLen + qLen + pLen + qLen + pLen + nLen
    if nLen <= 0 || eLen <= 0 || pLen <= 0 || qLen <= 0 || totalLen > BytesLen(out):
        return Err[int32]("rsa: invalid bcrypt key part length")
    var pos: int32
    rsaBlobPutU32LE(out, pos, rsaBCryptRsaFullPrivateMagic)
    rsaBlobPutU32LE(out, pos, bitLen)
    rsaBlobPutU32LE(out, pos, eLen)
    rsaBlobPutU32LE(out, pos, nLen)
    rsaBlobPutU32LE(out, pos, pLen)
    rsaBlobPutU32LE(out, pos, qLen)
    rsaBlobCopyRange(out, pos, eBytes, eOff, eLen)
    rsaBlobCopyRange(out, pos, nBytes, nOff, nLen)
    rsaBlobCopyRange(out, pos, pBytes, pOff, pLen)
    rsaBlobCopyRange(out, pos, qBytes, qOff, qLen)
    let dpRes: Result[bool] = rsaBlobCopyFixedBE(out, pos, dpBytes, pLen)
    if IsErr(dpRes):
        return Err[int32](Error(dpRes))
    let dqRes: Result[bool] = rsaBlobCopyFixedBE(out, pos, dqBytes, qLen)
    if IsErr(dqRes):
        return Err[int32](Error(dqRes))
    let qiRes: Result[bool] = rsaBlobCopyFixedBE(out, pos, qiBytes, pLen)
    if IsErr(qiRes):
        return Err[int32](Error(qiRes))
    let dRes: Result[bool] = rsaBlobCopyFixedBE(out, pos, dBytes, nLen)
    if IsErr(dRes):
        return Err[int32](Error(dRes))
    return Ok[int32](pos)

fn rsaBuildBCryptPublicBlobFill(nBytes: Bytes, eBytes: Bytes, bitLen: int32, out: Bytes): Result[int32] =
    let nOff: int32 = rsaTrimLeadingZeroOffset(nBytes)
    let eOff: int32 = rsaTrimLeadingZeroOffset(eBytes)
    let nLen: int32 = BytesLen(nBytes) - nOff
    let eLen: int32 = BytesLen(eBytes) - eOff
    let totalLen: int32 = 24 + eLen + nLen
    if nLen <= 0 || eLen <= 0 || totalLen > BytesLen(out):
        return Err[int32]("rsa: invalid bcrypt public key part length")
    var pos: int32
    rsaBlobPutU32LE(out, pos, 0x31415352)
    rsaBlobPutU32LE(out, pos, bitLen)
    rsaBlobPutU32LE(out, pos, eLen)
    rsaBlobPutU32LE(out, pos, nLen)
    rsaBlobPutU32LE(out, pos, 0)
    rsaBlobPutU32LE(out, pos, 0)
    rsaBlobCopyRange(out, pos, eBytes, eOff, eLen)
    rsaBlobCopyRange(out, pos, nBytes, nOff, nLen)
    return Ok[int32](pos)

fn rsaBuildBCryptFullPrivateBlob(
    nBytes: Bytes,
    eBytes: Bytes,
    dBytes: Bytes,
    pBytes: Bytes,
    qBytes: Bytes,
    dpBytes: Bytes,
    dqBytes: Bytes,
    qiBytes: Bytes,
    bitLen: int32
): Result[Bytes] =
    let nOff: int32 = rsaTrimLeadingZeroOffset(nBytes)
    let eOff: int32 = rsaTrimLeadingZeroOffset(eBytes)
    let pOff: int32 = rsaTrimLeadingZeroOffset(pBytes)
    let qOff: int32 = rsaTrimLeadingZeroOffset(qBytes)
    let nLen: int32 = BytesLen(nBytes) - nOff
    let eLen: int32 = BytesLen(eBytes) - eOff
    let pLen: int32 = BytesLen(pBytes) - pOff
    let qLen: int32 = BytesLen(qBytes) - qOff
    if nLen <= 0 || eLen <= 0 || pLen <= 0 || qLen <= 0:
        return Err[Bytes]("rsa: invalid bcrypt key part length")
    var blob: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    rsaAppendU32LE(blob, rsaBCryptRsaFullPrivateMagic)
    rsaAppendU32LE(blob, bitLen)
    rsaAppendU32LE(blob, eLen)
    rsaAppendU32LE(blob, nLen)
    rsaAppendU32LE(blob, pLen)
    rsaAppendU32LE(blob, qLen)
    rsaAppendBytesRange(blob, eBytes, eOff, eLen)
    rsaAppendBytesRange(blob, nBytes, nOff, nLen)
    rsaAppendBytesRange(blob, pBytes, pOff, pLen)
    rsaAppendBytesRange(blob, qBytes, qOff, qLen)
    let dpRes: Result[bool] = rsaAppendBytesFixedBE(blob, dpBytes, pLen)
    if IsErr(dpRes):
        return Err[Bytes](Error(dpRes))
    let dqRes: Result[bool] = rsaAppendBytesFixedBE(blob, dqBytes, qLen)
    if IsErr(dqRes):
        return Err[Bytes](Error(dqRes))
    let qiRes: Result[bool] = rsaAppendBytesFixedBE(blob, qiBytes, pLen)
    if IsErr(qiRes):
        return Err[Bytes](Error(qiRes))
    let dRes: Result[bool] = rsaAppendBytesFixedBE(blob, dBytes, nLen)
    if IsErr(dRes):
        return Err[Bytes](Error(dRes))
    return Ok[Bytes](bytebuffer.ToBytes(blob))

fn rsaNativePssSignFill(
    nBytes: Bytes,
    eBytes: Bytes,
    dBytes: Bytes,
    pBytes: Bytes,
    qBytes: Bytes,
    dpBytes: Bytes,
    dqBytes: Bytes,
    qiBytes: Bytes,
    bitLen: int32,
    msg: Bytes,
    useSha384: bool,
    out: Bytes
): Result[int32] =
    let blob: Bytes = BytesAlloc(1400)
    let blobLenRes: Result[int32] = rsaBuildBCryptFullPrivateBlobFill(nBytes, eBytes, dBytes, pBytes, qBytes, dpBytes, dqBytes, qiBytes, bitLen, blob)
    if IsErr(blobLenRes):
        return Err[int32](Error(blobLenRes))
    let blobLen: int32 = Value(blobLenRes)
    let digest: Bytes = if useSha384: rsaHashSha384(msg) else: rsaHashSha256(msg)
    let useSha384Int: int32 = if useSha384: 1 else: 0
    let sigLen: int32 = rsaWindowsPssSignBlob(blob.data, blobLen, digest.data, BytesLen(digest), useSha384Int, out.data)
    if sigLen < 0:
        return Err[int32]("rsa: bcrypt pss sign failed")
    if sigLen <= 0 || sigLen > BytesLen(out):
        return Err[int32]("rsa: bcrypt signature length invalid")
    for i in 0..<sigLen:
        let sigByte: int32 = BytesGet(out, i)
        rsaPssSignatureScratchBytes[i] = sigByte
        BytesSet(out, i, sigByte)
    return Ok[int32](sigLen)

fn rsaNativePssSignPkcs8Fill(privData: Bytes, msg: Bytes, useSha384: bool, out: Bytes): Result[int32] =
    let digest: Bytes = if useSha384: rsaHashSha384(msg) else: rsaHashSha256(msg)
    let useSha384Int: int32 = if useSha384: 1 else: 0
    let sigLen: int32 = rsaWindowsPssSignPkcs8(privData.data, BytesLen(privData), digest.data, BytesLen(digest), useSha384Int, out.data)
    if sigLen < 0:
        return Err[int32]("rsa: ncrypt pkcs8 pss sign failed")
    if sigLen <= 0 || sigLen > BytesLen(out):
        return Err[int32]("rsa: ncrypt signature length invalid")
    let exact: Bytes = BytesAlloc(sigLen)
    for i in 0..<sigLen:
        let sigByte: int32 = BytesGet(out, i)
        rsaPssSignatureScratchBytes[i] = sigByte
        BytesSet(exact, i, sigByte)
        BytesSet(out, i, sigByte)
    rsaPssSignatureScratch = exact
    return Ok[int32](sigLen)

# Fills through the data pointer; does not consume the struct.
@borrows
fn rsaBigToBytesLocalFill(a: bigint.BigInt, minLen: int32, out: Bytes): Result[int32] =
    var outLen: int32
    var aLocal: bigint.BigInt = rsaBigCopyInto(a)
    if minLen > 0:
        outLen = minLen
    elif aLocal.count <= 0:
        outLen = 1
    else:
        outLen = aLocal.count * 4
    if BytesLen(out) < outLen:
        return Err[int32]("rsa: output buffer too small")
    if aLocal.count < 0 || aLocal.count > 256:
        return Err[int32]("rsa: to-bytes bigint count invalid")
    let totalBytes: int32 = aLocal.count * 4
    if totalBytes > outLen:
        for extraIdx in outLen..<totalBytes:
            let bitIdx: int32 = extraIdx * 8
            let limbIdx: int32 = bitIdx / 32
            let shift: int32 = bitIdx % 32
            var extra: uint64
            if limbIdx < aLocal.count:
                extra = rsaBigWordToU64(aLocal.limbs[limbIdx]) >> uint64(shift)
            if rsaBigLowByte(extra) != 0:
                return Err[int32]("rsa: encoded integer too large for output")
    for i in 0..<outLen:
        let byteIdx: int32 = outLen - 1 - i
        let bitIdx: int32 = i * 8
        let limbIdx: int32 = bitIdx / 32
        let shift: int32 = bitIdx % 32
        var v: uint64
        if aLocal.count > 0 && limbIdx < aLocal.count:
            v = rsaBigWordToU64(aLocal.limbs[limbIdx]) >> uint64(shift)
        if aLocal.count > 0 && shift > 24 && limbIdx + 1 < aLocal.count:
            v = v | (rsaBigWordToU64(aLocal.limbs[limbIdx + 1]) << uint64(32 - shift))
        let byteValue: int32 = rsaBigLowByte(v)
        BytesSet(out, byteIdx, byteValue)
        if byteIdx >= 0 && byteIdx < rsaSignatureScratchCapacity:
            rsaPssSignatureScratchBytes[byteIdx] = byteValue
    return Ok[int32](outLen)

fn gcd(a: int64, b: int64): int64 =
    var x: int64 = if a < 0: -a else: a
    var y: int64 = if b < 0: -b else: b
    while y != 0:
        let t: int64 = x % y
        x = y
        y = t
    return x

fn modInv(a: int64, modv: int64): Result[int64] =
    var t: int64
    var newT: int64 = 1
    var r: int64 = modv
    var newR: int64 = a % modv
    while newR != 0:
        let q: int64 = r / newR
        let nextT: int64 = t - q * newT
        t = newT
        newT = nextT
        let nextR: int64 = r - q * newR
        r = newR
        newR = nextR
    if r != 1 && r != -1:
        return Err[int64]("rsa: inverse ! found")
    if t < 0:
        t = t + modv
    return Ok[int64](t)

fn mulMod(a: int64, b: int64, modv: int64): int64 =
    var res: int64
    var x: int64 = a % modv
    var y: int64 = b
    while y > 0:
        if (y & 1) != 0:
            res = (res + x) % modv
        x = (x << 1) % modv
        y = y >> 1
    return res

fn powMod(base: int64, exp: int64, modv: int64): int64 =
    var result: int64 = 1 % modv
    var b: int64 = base % modv
    var e: int64 = exp
    while e > 0:
        if (e & 1) != 0:
            result = mulMod(result, b, modv)
        b = mulMod(b, b, modv)
        e = e >> 1
    return result

fn isPrime(n: int64): bool =
    if n <= 1:
        return false
    if n <= 3:
        return true
    if (n & 1) == 0:
        return false
    var i: int64 = 3
    while i * i <= n:
        if n % i == 0:
            return false
        i = i + 2
    return true

fn randomInt(bits: int32): Result[int64] =
    if bits < 2:
        return Err[int64]("rsa: bits too small")
    if bits > 62:
        return Err[int64]("rsa: bits too large")
    let byteCount: int32 = (bits + 7) / 8
    let res: Result[Bytes] = randomBytes(byteCount)
    if IsErr(res):
        return Err[int64](Error(res))
    let data: Bytes = Value(res)
    var value: int64
    for i in 0..<BytesLen(data):
        value = (value << 8) | int64(BytesGet(data, i))
    let topBit: int64 = int64(1) << (bits - 1)
    let mask: int64 = (int64(1) << bits) - 1
    value = value & mask
    value = value | topBit
    value = value | 1
    return Ok[int64](value)

fn generatePrime(bits: int32): Result[int64] =
    for attempt in 0..<10000:
        let res: Result[int64] = randomInt(bits)
        if IsErr(res):
            return Err[int64](Error(res))
        let candidate: int64 = Value(res)
        if isPrime(candidate):
            return Ok[int64](candidate)
    return Err[int64]("rsa: failed to generate prime")

fn rsaExponentCandidate(idx: int32): int64 =
    if idx == 0:
        return rsaDefaultE
    if idx == 1:
        return 257
    if idx == 2:
        return 17
    if idx == 3:
        return 5
    return 3

fn pickPublicExponent(phi: int64): Result[int64] =
    for i in 0..<rsaExponentCandidateCount:
        let e: int64 = rsaExponentCandidate(i)
        if e > 1 && e < phi && gcd(e, phi) == 1:
            return Ok[int64](e)
    return Err[int64]("rsa: no valid public exponent")

fn generateRsaKeyPair(primeBits: int32): Result[RsaKeyPair] =
    if primeBits < rsaMinPrimeBits || primeBits > rsaMaxPrimeBits:
        return Err[RsaKeyPair]("rsa: prime bits out of range")
    let pRes: Result[int64] = generatePrime(primeBits)
    if IsErr(pRes):
        return Err[RsaKeyPair](Error(pRes))
    var p: int64 = Value(pRes)
    var q: int64
    for attempt in 0..<10000:
        let qRes: Result[int64] = generatePrime(primeBits)
        if IsErr(qRes):
            return Err[RsaKeyPair](Error(qRes))
        q = Value(qRes)
        if q != p:
            break
    if q == 0 || q == p:
        return Err[RsaKeyPair]("rsa: failed to generate q")
    let n: int64 = p * q
    let phi: int64 = (p - 1) * (q - 1)
    let eRes: Result[int64] = pickPublicExponent(phi)
    if IsErr(eRes):
        return Err[RsaKeyPair](Error(eRes))
    let e: int64 = Value(eRes)
    let dRes: Result[int64] = modInv(e, phi)
    if IsErr(dRes):
        return Err[RsaKeyPair](Error(dRes))
    let d: int64 = Value(dRes)
    let pub: RsaPublicKey = RsaPublicKey(n: n, e: e)
    let priv: RsaPrivateKey = RsaPrivateKey(n: n, e: e, d: d, p: p, q: q)
    return Ok[RsaKeyPair](RsaKeyPair(publicKey: pub, privateKey: priv))

fn generateRsaKeyPair(): Result[RsaKeyPair] =
    return generateRsaKeyPair(rsaDefaultPrimeBits)

fn rsaPublicKeyFromPrivate(priv: RsaPrivateKey): RsaPublicKey =
    return RsaPublicKey(n: priv.n, e: priv.e)

fn bytesToInt64Mod(data: Bytes, modv: int64): int64 =
    if modv <= 0:
        return 0
    var acc: int64
    for i in 0..<BytesLen(data):
        acc = (acc * 256 + int64(BytesGet(data, i))) % modv
    return acc

fn rsaHexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return int32(c) - int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + int32(c) - int32('a')
    if c >= 'A' && c <= 'F':
        return 10 + int32(c) - int32('A')
    return -1

fn rsaHexDecode(text: str): Result[Bytes] =
    if len(text) % 2 != 0:
        return Err[Bytes]("rsa: hex length must be even")
    let out: Bytes = BytesAlloc(len(text) / 2)
    var i: int32
    for _ in range(len(text) / 2):
        let hi: int32 = rsaHexValue(text[i])
        let lo: int32 = rsaHexValue(text[i + 1])
        if hi < 0 || lo < 0:
            return Err[Bytes]("rsa: invalid hex")
        BytesSet(out, i / 2, (hi << 4) | lo)
        i = i + 2
    return Ok[Bytes](out)

fn rsaHashLenSha256(): int32 =
    return 32

fn rsaHashLenSha384(): int32 =
    return 48

@borrows
fn rsaHashSha256(data: Bytes): Bytes =
    return Sha256Digest(data)

@borrows
fn rsaHashSha384(data: Bytes): Bytes =
    return sha384Digest(data)

fn rsaDigestInfoSha256(hash: Bytes): Result[Bytes] =
    let prefixRes: Result[Bytes] = rsaHexDecode("3031300d060960864801650304020105000420")
    if IsErr(prefixRes):
        return Err[Bytes](Error(prefixRes))
    return Ok[Bytes](BytesConcat(Value(prefixRes), hash))

fn rsaDigestInfoSha384(hash: Bytes): Result[Bytes] =
    let prefixRes: Result[Bytes] = rsaHexDecode("3041300d060960864801650304020205000430")
    if IsErr(prefixRes):
        return Err[Bytes](Error(prefixRes))
    return Ok[Bytes](BytesConcat(Value(prefixRes), hash))

fn rsaMgf1(seed: Bytes, length: int32, useSha384: bool): Bytes =
    if length <= 0:
        return EmptyBytes()
    var out: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    var counter: int32
    while byteBufferLen(out) < length:
        let ctr: Bytes = BytesAlloc(4)
        BytesSet(ctr, 0, int32((counter >> 24) & 255))
        BytesSet(ctr, 1, int32((counter >> 16) & 255))
        BytesSet(ctr, 2, int32((counter >> 8) & 255))
        BytesSet(ctr, 3, int32(counter & 255))
        let msg: Bytes = BytesConcat(seed, ctr)
        var digest: Bytes
        if useSha384:
            digest = rsaHashSha384(msg)
        else:
            digest = rsaHashSha256(msg)
        bytebuffer.AppendBytes(out, digest)
        counter = counter + 1
    let mask: Bytes = bytebuffer.ByteBufferTakeAllBytes(out)
    if BytesLen(mask) <= length:
        return mask
    return BytesSlice(mask, 0, length)

fn rsaBytesXorExact(a: Bytes, b: Bytes): Bytes =
    let out: Bytes = BytesAlloc(BytesLen(a))
    for i in 0..<BytesLen(a):
        let av: int32 = BytesGet(a, i)
        let bv: int32 = BytesGet(b, i)
        BytesSet(out, i, av + bv - 2 * (av & bv))
    return out

fn rsaBytesXorLen(a: Bytes, b: Bytes, count: int32): Bytes =
    let out: Bytes = BytesAlloc(count)
    var i: int32
    for i in i..<count:
        let av: int32 = BytesGet(a, i)
        let bv: int32 = BytesGet(b, i)
        BytesSet(out, i, av + bv - 2 * (av & bv))
    return out

fn rsaBytesEqualLen(a: Bytes, b: Bytes, count: int32): bool =
    var i: int32
    for i in i..<count:
        if BytesGet(a, i) != BytesGet(b, i):
            return false
    return true

fn rsaBytesXor(a: Bytes, b: Bytes): Result[Bytes] =
    if BytesLen(a) != BytesLen(b):
        return Err[Bytes]("rsa: ^ length mismatch")
    return Ok[Bytes](rsaBytesXorExact(a, b))

fn rsaBigModAddSlow(a: var bigint.BigInt, b: var bigint.BigInt, m: var bigint.BigInt): Result[bigint.BigInt] =
    if bigint.bigIsZero(m):
        return Err[bigint.BigInt]("rsa: modadd modulus zero")
    var left: bigint.BigInt
    rsaBigSetInto(left, a)
    if bigint.bigCmp(left, m) >= 0:
        let leftModRes: Result[bigint.BigInt] = bigint.bigMod(left, m)
        if IsErr(leftModRes):
            return Err[bigint.BigInt](Error(leftModRes))
        rsaBigSetInto(left, Value(leftModRes))
    var right: bigint.BigInt
    rsaBigSetInto(right, b)
    if bigint.bigCmp(right, m) >= 0:
        let rightModRes: Result[bigint.BigInt] = bigint.bigMod(right, m)
        if IsErr(rightModRes):
            return Err[bigint.BigInt](Error(rightModRes))
        rsaBigSetInto(right, Value(rightModRes))
    let gapRes: Result[bigint.BigInt] = bigint.bigSub(m, right)
    if IsErr(gapRes):
        return Err[bigint.BigInt](Error(gapRes))
    var gap: bigint.BigInt
    rsaBigSetInto(gap, Value(gapRes))
    if bigint.bigCmp(left, gap) >= 0:
        let subRes: Result[bigint.BigInt] = bigint.bigSub(left, gap)
        if IsErr(subRes):
            return Err[bigint.BigInt](Error(subRes))
        var outSub: bigint.BigInt
        rsaBigSetInto(outSub, Value(subRes))
        return Ok[bigint.BigInt](outSub)
    var addRes: Result[bigint.BigInt]
    if left.count < right.count:
        addRes = bigint.bigAdd(right, left)
    else:
        addRes = bigint.bigAdd(left, right)
    if IsErr(addRes):
        return Err[bigint.BigInt](Error(addRes))
    var outAdd: bigint.BigInt
    rsaBigSetInto(outAdd, Value(addRes))
    return Ok[bigint.BigInt](outAdd)

fn rsaBigModMulSlow(a: var bigint.BigInt, b: var bigint.BigInt, m: var bigint.BigInt): Result[bigint.BigInt] =
    if bigint.bigIsZero(m):
        return Err[bigint.BigInt]("rsa: modmul modulus zero")
    if a.count < b.count:
        return rsaBigModMulSlow(b, a, m)
    var addend: bigint.BigInt
    if bigint.bigCmp(a, m) >= 0:
        let aModRes: Result[bigint.BigInt] = bigint.bigMod(a, m)
        if IsErr(aModRes):
            return Err[bigint.BigInt](Error(aModRes))
        rsaBigSetInto(addend, Value(aModRes))
    else:
        rsaBigSetInto(addend, a)
    var multiplier: bigint.BigInt
    rsaBigSetInto(multiplier, b)
    var result: bigint.BigInt = bigint.bigFromInt(0)
    let bits: int32 = bigint.bigBitLen(multiplier)
    for i in 0..<bits:
        if bigint.bigGetBit(multiplier, i) != 0:
            let addRes: Result[bigint.BigInt] = rsaBigModAddSlow(result, addend, m)
            if IsErr(addRes):
                return Err[bigint.BigInt](Error(addRes))
            rsaBigSetInto(result, Value(addRes))
        if i + 1 < bits:
            var addendCopy: bigint.BigInt = bigint.bigCopy(addend)
            let dblRes: Result[bigint.BigInt] = rsaBigModAddSlow(addend, addendCopy, m)
            if IsErr(dblRes):
                return Err[bigint.BigInt](Error(dblRes))
            rsaBigSetInto(addend, Value(dblRes))
    return Ok[bigint.BigInt](result)

fn rsaBigModMulFast(a: var bigint.BigInt, b: var bigint.BigInt, m: var bigint.BigInt): Result[bigint.BigInt] =
    if bigint.bigIsZero(m):
        return Err[bigint.BigInt]("rsa: modmul modulus zero")
    let mulRes: Result[bigint.BigInt] = bigint.bigMul(a, b)
    if IsErr(mulRes):
        return Err[bigint.BigInt](Error(mulRes))
    let modRes: Result[bigint.BigInt] = bigint.bigMod(Value(mulRes), m)
    if IsErr(modRes):
        return Err[bigint.BigInt](Error(modRes))
    return modRes

fn rsaBigModExpSlow(base: bigint.BigInt, exp: bigint.BigInt, m: bigint.BigInt): Result[bigint.BigInt] =
    var baseLocal: bigint.BigInt
    rsaBigSetInto(baseLocal, base)
    var exponent: bigint.BigInt
    rsaBigSetInto(exponent, exp)
    var modulus: bigint.BigInt
    rsaBigSetInto(modulus, m)
    if bigint.bigIsZero(modulus):
        return Err[bigint.BigInt]("rsa: modexp modulus zero")
    var result: bigint.BigInt = bigint.bigFromInt(1)
    var started: bool
    var pow: bigint.BigInt
    if bigint.bigCmp(baseLocal, modulus) >= 0:
        let baseModRes: Result[bigint.BigInt] = bigint.bigMod(baseLocal, modulus)
        if IsErr(baseModRes):
            return Err[bigint.BigInt](Error(baseModRes))
        rsaBigSetInto(pow, Value(baseModRes))
    else:
        rsaBigSetInto(pow, baseLocal)
    let bits: int32 = bigint.bigBitLen(exponent)
    for i in 0..<bits:
        if bigint.bigGetBit(exponent, i) != 0:
            if ! started:
                rsaBigSetInto(result, pow)
                started = true
            else:
                let mulRes: Result[bigint.BigInt] = rsaBigModMulSlow(result, pow, modulus)
                if IsErr(mulRes):
                    return Err[bigint.BigInt](Error(mulRes))
                rsaBigSetInto(result, Value(mulRes))
        if i + 1 < bits:
            # pow aliases both operands; the overlap guard requires a copy,
            # and var formals require a named place for it.
            var powCopy: bigint.BigInt = bigint.bigCopy(pow)
            let sqRes: Result[bigint.BigInt] = rsaBigModMulSlow(pow, powCopy, modulus)
            if IsErr(sqRes):
                return Err[bigint.BigInt](Error(sqRes))
            rsaBigSetInto(pow, Value(sqRes))
    return Ok[bigint.BigInt](result)

fn rsaBigPublicKeyFromBytes(data: Bytes): Result[RsaBigPublicKey] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, 0)
    if IsErr(seqRes):
        return Err[RsaBigPublicKey](Error(seqRes))
    var offset: int32
    let seqValue: Bytes = Value(seqRes).value
    let nRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, offset)
    if IsErr(nRes):
        return Err[RsaBigPublicKey](Error(nRes))
    offset = Value(nRes).next
    let eRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, offset)
    if IsErr(eRes):
        return Err[RsaBigPublicKey](Error(eRes))
    let nBytes: Bytes = Value(nRes).value
    let eBytes: Bytes = Value(eRes).value
    let nBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(nBytes)
    if IsErr(nBigRes):
        return Err[RsaBigPublicKey](Error(nBigRes))
    let eBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(eBytes)
    if IsErr(eBigRes):
        return Err[RsaBigPublicKey](Error(eBigRes))
    var nBig: bigint.BigInt
    rsaBigSetInto(nBig, Value(nBigRes))
    var eBig: bigint.BigInt
    rsaBigSetInto(eBig, Value(eBigRes))
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    if modBits <= 0 || modLen <= 0:
        return Err[RsaBigPublicKey]("rsa: invalid modulus")
    let one: bigint.BigInt = bigint.bigFromInt(1)
    if bigint.bigCmp(eBig, one) <= 0 || bigint.bigGetBit(eBig, 0) == 0:
        return Err[RsaBigPublicKey]("rsa: invalid exponent")
    if bigint.bigCmp(eBig, nBig) >= 0:
        return Err[RsaBigPublicKey]("rsa: exponent out of range")
    var out: RsaBigPublicKey
    rsaBigSetInto(out.n, nBig)
    rsaBigSetInto(out.e, eBig)
    out.modBits = modBits
    out.modLen = modLen
    return Ok[RsaBigPublicKey](out)

fn rsaBigPublicKeyFromParts(nBytes: Bytes, eBytes: Bytes): Result[RsaBigPublicKey] =
    let nBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(nBytes)
    if IsErr(nBigRes):
        return Err[RsaBigPublicKey](Error(nBigRes))
    let eBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(eBytes)
    if IsErr(eBigRes):
        return Err[RsaBigPublicKey](Error(eBigRes))
    var nBig: bigint.BigInt
    rsaBigSetInto(nBig, Value(nBigRes))
    var eBig: bigint.BigInt
    rsaBigSetInto(eBig, Value(eBigRes))
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    if modBits <= 0 || modLen <= 0:
        return Err[RsaBigPublicKey]("rsa: invalid modulus")
    let one: bigint.BigInt = bigint.bigFromInt(1)
    if bigint.bigCmp(eBig, one) <= 0 || bigint.bigGetBit(eBig, 0) == 0:
        return Err[RsaBigPublicKey]("rsa: invalid exponent")
    if bigint.bigCmp(eBig, nBig) >= 0:
        return Err[RsaBigPublicKey]("rsa: exponent out of range")
    var out: RsaBigPublicKey
    rsaBigSetInto(out.n, nBig)
    rsaBigSetInto(out.e, eBig)
    out.modBits = modBits
    out.modLen = modLen
    return Ok[RsaBigPublicKey](out)

@borrows
fn rsaPublicKeyPartsValid(nBytes: Bytes, eBytes: Bytes): bool =
    let nBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(nBytes)
    if IsErr(nBigRes):
        return false
    let eBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(eBytes)
    if IsErr(eBigRes):
        return false
    var nBig: bigint.BigInt
    rsaBigSetInto(nBig, Value(nBigRes))
    var eBig: bigint.BigInt
    rsaBigSetInto(eBig, Value(eBigRes))
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    if modBits <= 0 || modLen <= 0:
        return false
    let one: bigint.BigInt = bigint.bigFromInt(1)
    if bigint.bigCmp(eBig, one) <= 0 || bigint.bigGetBit(eBig, 0) == 0:
        return false
    if bigint.bigCmp(eBig, nBig) >= 0:
        return false
    return true

@borrows
fn rsaIsRsaEncryptionOid(oidValue: Bytes): bool =
    let expectRes: Result[Bytes] = rsaHexDecode("2a864886f70d010101")
    if IsErr(expectRes):
        return false
    return BytesEqual(oidValue, Value(expectRes))

@borrows
fn rsaBigPrivateKeyFromPkcs1ValueInto(
    seqValue: Bytes,
    outN: var bigint.BigInt,
    outD: var bigint.BigInt,
    outModBits: var int32,
    outModLen: var int32
): Result[bool] =
    var offset: int32
    let vRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, offset)
    if IsErr(vRes):
        return Err[bool](Error(vRes))
    let vDecoded: Asn1ValueNext = Value(vRes)
    let vValue: Bytes = vDecoded.value
    offset = vDecoded.next
    let nRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, offset)
    if IsErr(nRes):
        return Err[bool](Error(nRes))
    let nDecoded: Asn1ValueNext = Value(nRes)
    let nValue: Bytes = nDecoded.value
    offset = nDecoded.next
    let eRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, offset)
    if IsErr(eRes):
        return Err[bool](Error(eRes))
    let eDecoded: Asn1ValueNext = Value(eRes)
    let eValue: Bytes = eDecoded.value
    offset = eDecoded.next
    let dRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, offset)
    if IsErr(dRes):
        return Err[bool](Error(dRes))
    let dDecoded: Asn1ValueNext = Value(dRes)
    let dValue: Bytes = dDecoded.value
    let vIntRes: Result[int64] = bytesToInt64(vValue)
    if IsErr(vIntRes) || Value(vIntRes) != 0:
        return Err[bool]("rsa: invalid private key version")
    let nBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(nValue)
    if IsErr(nBigRes):
        return Err[bool](Error(nBigRes))
    let eBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(eValue)
    if IsErr(eBigRes):
        return Err[bool](Error(eBigRes))
    let dBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(dValue)
    if IsErr(dBigRes):
        return Err[bool](Error(dBigRes))
    var nBig: bigint.BigInt
    rsaBigSetInto(nBig, Value(nBigRes))
    var eBig: bigint.BigInt
    rsaBigSetInto(eBig, Value(eBigRes))
    var dBig: bigint.BigInt
    rsaBigSetInto(dBig, Value(dBigRes))
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    if modBits <= 0 || modLen <= 0:
        return Err[bool]("rsa: invalid modulus")
    let one: bigint.BigInt = bigint.bigFromInt(1)
    if bigint.bigCmp(eBig, one) <= 0 || bigint.bigGetBit(eBig, 0) == 0:
        return Err[bool]("rsa: invalid exponent")
    if bigint.bigCmp(eBig, nBig) >= 0:
        return Err[bool]("rsa: exponent out of range")
    if bigint.bigCmp(dBig, one) <= 0:
        return Err[bool]("rsa: invalid private exponent")
    rsaBigSetInto(outN, nBig)
    rsaBigSetInto(outD, dBig)
    outModBits = modBits
    outModLen = modLen
    return Ok[bool](true)

fn rsaBigPrivateKeyFromPkcs1Value(seqValue: Bytes): Result[RsaBigPrivateKey] =
    var nBig: bigint.BigInt
    var dBig: bigint.BigInt
    var modBits: int32
    var modLen: int32
    let fillRes: Result[bool] = rsaBigPrivateKeyFromPkcs1ValueInto(seqValue, nBig, dBig, modBits, modLen)
    if IsErr(fillRes):
        return Err[RsaBigPrivateKey](Error(fillRes))
    var out: RsaBigPrivateKey
    rsaBigSetInto(out.n, nBig)
    rsaBigSetInto(out.d, dBig)
    out.modBits = modBits
    out.modLen = modLen
    return Ok[RsaBigPrivateKey](out)

@borrows
fn rsaBigPrivateKeyFromPkcs8ValueInto(
    seqValue: Bytes,
    outN: var bigint.BigInt,
    outD: var bigint.BigInt,
    outModBits: var int32,
    outModLen: var int32
): Result[bool] =
    var offset: int32
    let vRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, offset)
    if IsErr(vRes):
        return Err[bool](Error(vRes))
    let vDecoded: Asn1ValueNext = Value(vRes)
    let vValue: Bytes = vDecoded.value
    let vIntRes: Result[int64] = bytesToInt64(vValue)
    if IsErr(vIntRes) || (Value(vIntRes) != 0 && Value(vIntRes) != 1):
        return Err[bool]("rsa: invalid pkcs8 version")
    offset = vDecoded.next
    let algRes: Result[Asn1ValueNext] = asn1DecodeSequence(seqValue, offset)
    if IsErr(algRes):
        return Err[bool](Error(algRes))
    let algDecoded: Asn1ValueNext = Value(algRes)
    let algValue: Bytes = algDecoded.value
    let oidTlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(algValue, 0)
    if IsErr(oidTlvRes):
        return Err[bool](Error(oidTlvRes))
    let oidDecoded: Asn1TagValueNext = Value(oidTlvRes)
    let oidTag: int32 = oidDecoded.tag
    let oidValue: Bytes = oidDecoded.value
    let oidNext: int32 = oidDecoded.next
    if oidTag != 0x06 || ! rsaIsRsaEncryptionOid(oidValue):
        return Err[bool]("rsa: unsupported pkcs8 algorithm")
    if oidNext < BytesLen(algValue):
        let paramRes: Result[Asn1TagValueNext] = asn1DecodeTlv(algValue, oidNext)
        if IsErr(paramRes):
            return Err[bool](Error(paramRes))
        let paramDecoded: Asn1TagValueNext = Value(paramRes)
        if paramDecoded.tag != 0x05:
            return Err[bool]("rsa: unsupported pkcs8 params")
    offset = algDecoded.next
    let keyRes: Result[Asn1TagValueNext] = asn1DecodeTlv(seqValue, offset)
    if IsErr(keyRes):
        return Err[bool](Error(keyRes))
    let keyDecoded: Asn1TagValueNext = Value(keyRes)
    let keyTag: int32 = keyDecoded.tag
    let keyValue: Bytes = keyDecoded.value
    if keyTag != 0x04:
        return Err[bool]("rsa: pkcs8 private key ! octet string")
    return rsaBigPrivateKeyFromBytesInto(keyValue, outN, outD, outModBits, outModLen)

fn rsaBigPrivateKeyFromPkcs8Value(seqValue: Bytes): Result[RsaBigPrivateKey] =
    var nBig: bigint.BigInt
    var dBig: bigint.BigInt
    var modBits: int32
    var modLen: int32
    let fillRes: Result[bool] = rsaBigPrivateKeyFromPkcs8ValueInto(seqValue, nBig, dBig, modBits, modLen)
    if IsErr(fillRes):
        return Err[RsaBigPrivateKey](Error(fillRes))
    var out: RsaBigPrivateKey
    rsaBigSetInto(out.n, nBig)
    rsaBigSetInto(out.d, dBig)
    out.modBits = modBits
    out.modLen = modLen
    return Ok[RsaBigPrivateKey](out)

@borrows
fn rsaBigPrivateKeyFromBytesInto(
    data: Bytes,
    outN: var bigint.BigInt,
    outD: var bigint.BigInt,
    outModBits: var int32,
    outModLen: var int32
): Result[bool] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, 0)
    if IsErr(seqRes):
        return Err[bool](Error(seqRes))
    let seqDecoded: Asn1ValueNext = Value(seqRes)
    let seqValue: Bytes = seqDecoded.value
    let vRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, 0)
    if IsErr(vRes):
        return Err[bool](Error(vRes))
    let vDecoded: Asn1ValueNext = Value(vRes)
    let nextRes: Result[Asn1TagValueNext] = asn1DecodeTlv(seqValue, vDecoded.next)
    if IsErr(nextRes):
        return Err[bool](Error(nextRes))
    let nextDecoded: Asn1TagValueNext = Value(nextRes)
    let nextTag: int32 = nextDecoded.tag
    if nextTag == 0x02:
        return rsaBigPrivateKeyFromPkcs1ValueInto(seqValue, outN, outD, outModBits, outModLen)
    if nextTag == 0x30:
        return rsaBigPrivateKeyFromPkcs8ValueInto(seqValue, outN, outD, outModBits, outModLen)
    return Err[bool]("rsa: unsupported private key format")

@borrows
fn rsaBigPrivateKeyFromBytes(data: Bytes): Result[RsaBigPrivateKey] =
    var nBig: bigint.BigInt
    var dBig: bigint.BigInt
    var modBits: int32
    var modLen: int32
    let fillRes: Result[bool] = rsaBigPrivateKeyFromBytesInto(data, nBig, dBig, modBits, modLen)
    if IsErr(fillRes):
        return Err[RsaBigPrivateKey](Error(fillRes))
    var out: RsaBigPrivateKey
    rsaBigSetInto(out.n, nBig)
    rsaBigSetInto(out.d, dBig)
    out.modBits = modBits
    out.modLen = modLen
    return Ok[RsaBigPrivateKey](out)

fn rsaBigDecrypt(pub: RsaBigPublicKey, sig: Bytes): Result[Bytes] =
    if BytesLen(sig) <= 0:
        return Err[Bytes]("rsa: empty signature")
    if BytesLen(sig) > pub.modLen:
        return Err[Bytes]("rsa: signature too long")
    let sigRes: Result[bigint.BigInt] = bigint.bigFromBytes(sig)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    var sigBig: bigint.BigInt
    rsaBigSetInto(sigBig, Value(sigRes))
    if bigint.bigIsZero(sigBig):
        return Err[Bytes]("rsa: signature zero")
    if bigint.bigCmp(sigBig, pub.n) >= 0:
        return Err[Bytes]("rsa: signature out of range")
    var mBig: bigint.BigInt
    let mRes: Result[bool] = bigint.bigModExpInto(mBig, sigBig, pub.e, pub.n)
    if IsErr(mRes):
        return Err[Bytes](Error(mRes))
    let em: Bytes = bigint.bigToBytes(mBig, pub.modLen)
    return Ok[Bytes](em)

@borrows
fn rsaBigDecryptBytes(nBytes: Bytes, eBytes: Bytes, sig: Bytes): Result[Bytes] =
    let nBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(nBytes)
    if IsErr(nBigRes):
        return Err[Bytes](Error(nBigRes))
    let eBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(eBytes)
    if IsErr(eBigRes):
        return Err[Bytes](Error(eBigRes))
    var nBig: bigint.BigInt
    rsaBigSetInto(nBig, Value(nBigRes))
    var eBig: bigint.BigInt
    rsaBigSetInto(eBig, Value(eBigRes))
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    if modBits <= 0 || modLen <= 0:
        return Err[Bytes]("rsa: invalid modulus")
    let one: bigint.BigInt = bigint.bigFromInt(1)
    if bigint.bigCmp(eBig, one) <= 0 || bigint.bigGetBit(eBig, 0) == 0:
        return Err[Bytes]("rsa: invalid exponent")
    if bigint.bigCmp(eBig, nBig) >= 0:
        return Err[Bytes]("rsa: exponent out of range")
    if BytesLen(sig) <= 0:
        return Err[Bytes]("rsa: empty signature")
    if BytesLen(sig) > modLen:
        return Err[Bytes]("rsa: signature too long")
    let sigRes: Result[bigint.BigInt] = bigint.bigFromBytes(sig)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    var sigBig: bigint.BigInt
    rsaBigSetInto(sigBig, Value(sigRes))
    if bigint.bigIsZero(sigBig):
        return Err[Bytes]("rsa: signature zero")
    if bigint.bigCmp(sigBig, nBig) >= 0:
        return Err[Bytes]("rsa: signature out of range")
    var mBig: bigint.BigInt
    let mRes: Result[bool] = bigint.bigModExpInto(mBig, sigBig, eBig, nBig)
    if IsErr(mRes):
        return Err[Bytes](Error(mRes))
    let em: Bytes = bigint.bigToBytes(mBig, modLen)
    return Ok[Bytes](em)

fn rsaBigModSubSlow(a: var bigint.BigInt, b: var bigint.BigInt, m: var bigint.BigInt): Result[bigint.BigInt] =
    if bigint.bigCmp(a, b) >= 0:
        let subRes: Result[bigint.BigInt] = bigint.bigSub(a, b)
        if IsErr(subRes):
            return Err[bigint.BigInt](Error(subRes))
        var outSub: bigint.BigInt
        rsaBigSetInto(outSub, Value(subRes))
        return Ok[bigint.BigInt](outSub)
    let diffRes: Result[bigint.BigInt] = bigint.bigSub(m, b)
    if IsErr(diffRes):
        return Err[bigint.BigInt](Error(diffRes))
    var diff: bigint.BigInt
    rsaBigSetInto(diff, Value(diffRes))
    let sumRes: Result[bigint.BigInt] = bigint.bigAdd(a, diff)
    if IsErr(sumRes):
        return Err[bigint.BigInt](Error(sumRes))
    var sum: bigint.BigInt
    rsaBigSetInto(sum, Value(sumRes))
    if bigint.bigCmp(sum, m) >= 0:
        let subRes: Result[bigint.BigInt] = bigint.bigSub(sum, m)
        if IsErr(subRes):
            return Err[bigint.BigInt](Error(subRes))
        rsaBigSetInto(sum, Value(subRes))
    return Ok[bigint.BigInt](sum)

fn rsaBigIsOneVar(a: var bigint.BigInt): bool =
    return a.count == 1 && a.limbs[0] == 1

fn rsaBigCrtCombineInto(
    out: var bigint.BigInt,
    pBig: var bigint.BigInt,
    qBig: var bigint.BigInt,
    qiBig: var bigint.BigInt,
    m1: var bigint.BigInt,
    m2: var bigint.BigInt
): Result[bool] =
    var coeffCheck: bigint.BigInt
    let coeffCheckRes: Result[bool] = rsaBigModMulPlainInto(coeffCheck, qBig, qiBig, pBig)
    if IsErr(coeffCheckRes):
        return Err[bool](Error(coeffCheckRes))
    if ! rsaBigIsOneVar(coeffCheck):
        return Err[bool]("rsa: invalid crt coefficient")
    var diff: bigint.BigInt
    let diffRes: Result[bigint.BigInt] = bigint.bigModSub(m1, m2, pBig)
    if IsErr(diffRes):
        return Err[bool](Error(diffRes))
    rsaBigSetInto(diff, Value(diffRes))
    var h: bigint.BigInt
    let hRes: Result[bool] = rsaBigModMulPlainInto(h, qiBig, diff, pBig)
    if IsErr(hRes):
        return Err[bool](Error(hRes))
    if rsaBigCmpVar(h, pBig) >= 0:
        return Err[bool](Fmt"rsa: crt h out of range h_count={h.count} p_count={pBig.count}")
    let qhRes: Result[bigint.BigInt] = bigint.bigMul(qBig, h)
    if IsErr(qhRes):
        return Err[bool](Error(qhRes))
    var qh: bigint.BigInt
    rsaBigSetInto(qh, Value(qhRes))
    let sigRes: Result[bigint.BigInt] = bigint.bigAdd(m2, qh)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    rsaBigSetInto(out, Value(sigRes))
    var nCheck: bigint.BigInt
    let nCheckRes: Result[bigint.BigInt] = bigint.bigMul(pBig, qBig)
    if IsErr(nCheckRes):
        return Err[bool](Error(nCheckRes))
    rsaBigSetInto(nCheck, Value(nCheckRes))
    while bigint.bigCmp(out, nCheck) >= 0:
        let reduceRes: Result[bigint.BigInt] = bigint.bigSub(out, nCheck)
        if IsErr(reduceRes):
            return Err[bool](Error(reduceRes))
        rsaBigSetInto(out, Value(reduceRes))
    return Ok[bool](true)

fn rsaBigSignEmCrtParts(
    pBig: var bigint.BigInt,
    qBig: var bigint.BigInt,
    dpBig: var bigint.BigInt,
    dqBig: var bigint.BigInt,
    qiBig: var bigint.BigInt,
    modLen: int32,
    em: Bytes
): Result[Bytes] =
    if BytesLen(em) != modLen:
        return Err[Bytes]("rsa: encoded message length mismatch")
    let emRes: Result[bigint.BigInt] = bigint.bigFromBytes(em)
    if IsErr(emRes):
        return Err[Bytes](Error(emRes))
    var emBig: bigint.BigInt
    rsaBigSetInto(emBig, Value(emRes))
    var emP: bigint.BigInt
    let emPRes: Result[bool] = bigint.bigModInto(emP, emBig, pBig)
    if IsErr(emPRes):
        return Err[Bytes](Error(emPRes))
    var m1: bigint.BigInt
    let m1Res: Result[bool] = bigint.bigModExpInto(m1, emP, dpBig, pBig)
    if IsErr(m1Res):
        return Err[Bytes](Error(m1Res))
    if bigint.bigIsZero(m1):
        return Err[Bytes](Fmt"rsa: crt m1 zero emP_count={emP.count} dp_count={dpBig.count} p_count={pBig.count}")
    var emQ: bigint.BigInt
    let emQRes: Result[bool] = bigint.bigModInto(emQ, emBig, qBig)
    if IsErr(emQRes):
        return Err[Bytes](Error(emQRes))
    var m2: bigint.BigInt
    let m2Res: Result[bool] = bigint.bigModExpInto(m2, emQ, dqBig, qBig)
    if IsErr(m2Res):
        return Err[Bytes](Error(m2Res))
    if bigint.bigIsZero(m2):
        return Err[Bytes](Fmt"rsa: crt m2 zero emQ_count={emQ.count} dq_count={dqBig.count} q_count={qBig.count}")
    var sigBig: bigint.BigInt
    let sigRes: Result[bool] = rsaBigCrtCombineInto(sigBig, pBig, qBig, qiBig, m1, m2)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    if bigint.bigIsZero(sigBig):
        return Err[Bytes](Fmt"rsa: crt signature zero m1_count={m1.count} m2_count={m2.count}")
    let out: Bytes = BytesAlloc(modLen)
    let fillRes: Result[int32] = rsaBigToBytesLocalFill(sigBig, modLen, out)
    if IsErr(fillRes):
        return Err[Bytes](Error(fillRes))
    return Ok[Bytes](out)

fn rsaBigSignEmCrtPartsFill(
    pBig: var bigint.BigInt,
    qBig: var bigint.BigInt,
    dpBig: var bigint.BigInt,
    dqBig: var bigint.BigInt,
    qiBig: var bigint.BigInt,
    modLen: int32,
    em: Bytes,
    out: Bytes
): Result[int32] =
    if BytesLen(em) != modLen:
        return Err[int32]("rsa: encoded message length mismatch")
    let emRes: Result[bigint.BigInt] = bigint.bigFromBytes(em)
    if IsErr(emRes):
        return Err[int32](Error(emRes))
    var emBig: bigint.BigInt
    rsaBigSetInto(emBig, Value(emRes))
    var emP: bigint.BigInt
    let emPRes: Result[bool] = bigint.bigModInto(emP, emBig, pBig)
    if IsErr(emPRes):
        return Err[int32](Error(emPRes))
    var m1: bigint.BigInt
    let m1Res: Result[bool] = bigint.bigModExpInto(m1, emP, dpBig, pBig)
    if IsErr(m1Res):
        return Err[int32](Error(m1Res))
    if bigint.bigIsZero(m1):
        return Err[int32](Fmt"rsa: crt m1 zero emP_count={emP.count} dp_count={dpBig.count} p_count={pBig.count}")
    var emQ: bigint.BigInt
    let emQRes: Result[bool] = bigint.bigModInto(emQ, emBig, qBig)
    if IsErr(emQRes):
        return Err[int32](Error(emQRes))
    var m2: bigint.BigInt
    let m2Res: Result[bool] = bigint.bigModExpInto(m2, emQ, dqBig, qBig)
    if IsErr(m2Res):
        return Err[int32](Error(m2Res))
    if bigint.bigIsZero(m2):
        return Err[int32](Fmt"rsa: crt m2 zero emQ_count={emQ.count} dq_count={dqBig.count} q_count={qBig.count}")
    var sigBig: bigint.BigInt
    let sigRes: Result[bool] = rsaBigCrtCombineInto(sigBig, pBig, qBig, qiBig, m1, m2)
    if IsErr(sigRes):
        return Err[int32](Error(sigRes))
    if bigint.bigIsZero(sigBig):
        return Err[int32](Fmt"rsa: crt signature zero m1_count={m1.count} m2_count={m2.count}")
    return rsaBigToBytesLocalFill(sigBig, modLen, out)

fn rsaBigVerifyEncodedSignature(
    nBig: var bigint.BigInt,
    eBig: var bigint.BigInt,
    modLen: int32,
    em: Bytes,
    sig: Bytes
): Result[bool] =
    if BytesLen(em) != modLen || BytesLen(sig) != modLen:
        return Err[bool]("rsa: verify encoded length mismatch")
    let emRes: Result[bigint.BigInt] = bigint.bigFromBytes(em)
    if IsErr(emRes):
        return Err[bool](Error(emRes))
    let sigRes: Result[bigint.BigInt] = bigint.bigFromBytes(sig)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    var emBig: bigint.BigInt
    rsaBigSetInto(emBig, Value(emRes))
    var sigBig: bigint.BigInt
    rsaBigSetInto(sigBig, Value(sigRes))
    if bigint.bigIsZero(sigBig):
        return Err[bool]("rsa: crt signature zero")
    if bigint.bigCmp(sigBig, nBig) >= 0:
        return Err[bool]("rsa: crt signature out of range")
    var decoded: bigint.BigInt
    let decodeRes: Result[bool] = bigint.bigModExpInto(decoded, sigBig, eBig, nBig)
    if IsErr(decodeRes):
        return Err[bool](Error(decodeRes))
    if rsaBigCmpVar(decoded, emBig) != 0:
        return Err[bool]("rsa: crt signature verification mismatch")
    return Ok[bool](true)

fn rsaBigSignEmParts(nBig: bigint.BigInt, dBig: bigint.BigInt, modLen: int32, em: Bytes): Result[Bytes] =
    if BytesLen(em) != modLen:
        return Err[Bytes]("rsa: encoded message length mismatch")
    let emRes: Result[bigint.BigInt] = bigint.bigFromBytes(em)
    if IsErr(emRes):
        return Err[Bytes](Error(emRes))
    var emBig: bigint.BigInt
    rsaBigSetInto(emBig, Value(emRes))
    if bigint.bigCmp(emBig, nBig) >= 0:
        return Err[Bytes]("rsa: encoded message too large")
    var sigBig: bigint.BigInt
    let sigRes: Result[bool] = bigint.bigModExpInto(sigBig, emBig, dBig, nBig)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    let sigBytes: Bytes = BytesAlloc(modLen)
    let fillRes: Result[int32] = rsaBigToBytesLocalFill(sigBig, modLen, sigBytes)
    if IsErr(fillRes):
        return Err[Bytes](Error(fillRes))
    return Ok[Bytes](sigBytes)

fn rsaBigSignEmPartsInto(nBig: bigint.BigInt, dBig: bigint.BigInt, modLen: int32, em: Bytes, out: var Bytes): Result[bool] =
    if BytesLen(em) != modLen:
        return Err[bool]("rsa: encoded message length mismatch")
    let emRes: Result[bigint.BigInt] = bigint.bigFromBytes(em)
    if IsErr(emRes):
        return Err[bool](Error(emRes))
    var emBig: bigint.BigInt
    rsaBigSetInto(emBig, Value(emRes))
    if bigint.bigCmp(emBig, nBig) >= 0:
        return Err[bool]("rsa: encoded message too large")
    var sigBig: bigint.BigInt
    let sigRes: Result[bool] = bigint.bigModExpInto(sigBig, emBig, dBig, nBig)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    let sigBytes: Bytes = BytesAlloc(modLen)
    let fillRes: Result[int32] = rsaBigToBytesLocalFill(sigBig, modLen, sigBytes)
    if IsErr(fillRes):
        return Err[bool](Error(fillRes))
    out = sigBytes
    return Ok[bool](true)

fn rsaBigSignEmPartsFill(nBig: bigint.BigInt, eBig: bigint.BigInt, dBig: bigint.BigInt, modLen: int32, em: Bytes, out: Bytes): Result[int32] =
    if BytesLen(em) != modLen:
        return Err[int32]("rsa: encoded message length mismatch")
    let emRes: Result[bigint.BigInt] = bigint.bigFromBytes(em)
    if IsErr(emRes):
        return Err[int32](Error(emRes))
    var emBig: bigint.BigInt
    rsaBigSetInto(emBig, Value(emRes))
    if bigint.bigCmp(emBig, nBig) >= 0:
        return Err[int32]("rsa: encoded message too large")
    var sigBig: bigint.BigInt
    let sigRes: Result[bool] = bigint.bigModExpInto(sigBig, emBig, dBig, nBig)
    if IsErr(sigRes):
        return Err[int32](Error(sigRes))
    let checkRes: Result[bigint.BigInt] = rsaBigModExpSlow(sigBig, eBig, nBig)
    if IsErr(checkRes):
        return Err[int32](Error(checkRes))
    var checkBig: bigint.BigInt
    rsaBigSetInto(checkBig, Value(checkRes))
    if rsaBigCmpVar(checkBig, emBig) != 0:
        return Err[int32]("rsa: encoded signature verification mismatch")
    return rsaBigToBytesLocalFill(sigBig, modLen, out)

fn rsaBigSignEm(priv: RsaBigPrivateKey, em: Bytes): Result[Bytes] =
    return rsaBigSignEmParts(priv.n, priv.d, priv.modLen, em)

fn rsaBigSignPkcs1(priv: RsaBigPrivateKey, msg: Bytes, useSha384: bool): Result[Bytes] =
    var digest: Bytes
    if useSha384:
        digest = rsaHashSha384(msg)
    else:
        digest = rsaHashSha256(msg)
    var diRes: Result[Bytes]
    if useSha384:
        diRes = rsaDigestInfoSha384(digest)
    else:
        diRes = rsaDigestInfoSha256(digest)
    if IsErr(diRes):
        return Err[Bytes](Error(diRes))
    let t: Bytes = Value(diRes)
    let emLen: int32 = priv.modLen
    let tLen: int32 = BytesLen(t)
    if emLen < tLen + 11:
        return Err[Bytes]("rsa: pkcs1 em too short")
    let psLen: int32 = emLen - tLen - 3
    let em: Bytes = BytesAlloc(emLen)
    BytesSet(em, 0, 0x00)
    BytesSet(em, 1, 0x01)
    for i in 0..<psLen:
        BytesSet(em, 2 + i, 0xff)
    BytesSet(em, 2 + psLen, 0x00)
    rsaCopyBytes(em, 3 + psLen, t, 0, tLen)
    return rsaBigSignEm(priv, em)

fn rsaBigSignPkcs1Pkcs1Value(pkcs1Value: Bytes, msg: Bytes, useSha384: bool): Result[Bytes] =
    let vRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, 0)
    if IsErr(vRes):
        return Err[Bytes](Error(vRes))
    let vDecoded: Asn1ValueNext = Value(vRes)
    let vIntRes: Result[int64] = bytesToInt64(vDecoded.value)
    if IsErr(vIntRes) || Value(vIntRes) != 0:
        return Err[Bytes]("rsa: invalid private key version")
    let nRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, vDecoded.next)
    if IsErr(nRes):
        return Err[Bytes](Error(nRes))
    let nDecoded: Asn1ValueNext = Value(nRes)
    let eRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, nDecoded.next)
    if IsErr(eRes):
        return Err[Bytes](Error(eRes))
    let eDecoded: Asn1ValueNext = Value(eRes)
    let dRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, eDecoded.next)
    if IsErr(dRes):
        return Err[Bytes](Error(dRes))
    let dDecoded: Asn1ValueNext = Value(dRes)
    let pRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, dDecoded.next)
    if IsErr(pRes):
        return Err[Bytes](Error(pRes))
    let pDecoded: Asn1ValueNext = Value(pRes)
    let qRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, pDecoded.next)
    if IsErr(qRes):
        return Err[Bytes](Error(qRes))
    let qDecoded: Asn1ValueNext = Value(qRes)
    let dpRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, qDecoded.next)
    if IsErr(dpRes):
        return Err[Bytes](Error(dpRes))
    let dpDecoded: Asn1ValueNext = Value(dpRes)
    let dqRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, dpDecoded.next)
    if IsErr(dqRes):
        return Err[Bytes](Error(dqRes))
    let dqDecoded: Asn1ValueNext = Value(dqRes)
    let qiRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, dqDecoded.next)
    if IsErr(qiRes):
        return Err[Bytes](Error(qiRes))
    let qiDecoded: Asn1ValueNext = Value(qiRes)
    let nBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(nDecoded.value)
    if IsErr(nBigRes):
        return Err[Bytes](Error(nBigRes))
    let eBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(eDecoded.value)
    if IsErr(eBigRes):
        return Err[Bytes](Error(eBigRes))
    let dBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(dDecoded.value)
    if IsErr(dBigRes):
        return Err[Bytes](Error(dBigRes))
    let pBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(pDecoded.value)
    if IsErr(pBigRes):
        return Err[Bytes](Error(pBigRes))
    let qBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(qDecoded.value)
    if IsErr(qBigRes):
        return Err[Bytes](Error(qBigRes))
    let dpBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(dpDecoded.value)
    if IsErr(dpBigRes):
        return Err[Bytes](Error(dpBigRes))
    let dqBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(dqDecoded.value)
    if IsErr(dqBigRes):
        return Err[Bytes](Error(dqBigRes))
    let qiBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(qiDecoded.value)
    if IsErr(qiBigRes):
        return Err[Bytes](Error(qiBigRes))
    var nBig: bigint.BigInt
    rsaBigSetInto(nBig, Value(nBigRes))
    var eBig: bigint.BigInt
    rsaBigSetInto(eBig, Value(eBigRes))
    var dBig: bigint.BigInt
    rsaBigSetInto(dBig, Value(dBigRes))
    var pBig: bigint.BigInt
    rsaBigSetInto(pBig, Value(pBigRes))
    var qBig: bigint.BigInt
    rsaBigSetInto(qBig, Value(qBigRes))
    var dpBig: bigint.BigInt
    rsaBigSetInto(dpBig, Value(dpBigRes))
    var dqBig: bigint.BigInt
    rsaBigSetInto(dqBig, Value(dqBigRes))
    var qiBig: bigint.BigInt
    rsaBigSetInto(qiBig, Value(qiBigRes))
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    if modBits <= 0 || modLen <= 0:
        return Err[Bytes]("rsa: invalid modulus")
    let one: bigint.BigInt = bigint.bigFromInt(1)
    if bigint.bigCmp(eBig, one) <= 0 || bigint.bigGetBit(eBig, 0) == 0:
        return Err[Bytes]("rsa: invalid exponent")
    if bigint.bigCmp(eBig, nBig) >= 0:
        return Err[Bytes]("rsa: exponent out of range")
    if bigint.bigCmp(dBig, one) <= 0:
        return Err[Bytes]("rsa: invalid private exponent")
    if bigint.bigCmp(pBig, one) <= 0 || bigint.bigCmp(qBig, one) <= 0:
        return Err[Bytes]("rsa: invalid crt prime")
    if bigint.bigCmp(dpBig, one) <= 0 || bigint.bigCmp(dqBig, one) <= 0:
        return Err[Bytes]("rsa: invalid crt exponent")
    if bigint.bigCmp(qiBig, one) <= 0:
        return Err[Bytes]("rsa: invalid crt coefficient")
    var digest: Bytes
    if useSha384:
        digest = rsaHashSha384(msg)
    else:
        digest = rsaHashSha256(msg)
    var diRes: Result[Bytes]
    if useSha384:
        diRes = rsaDigestInfoSha384(digest)
    else:
        diRes = rsaDigestInfoSha256(digest)
    if IsErr(diRes):
        return Err[Bytes](Error(diRes))
    let t: Bytes = Value(diRes)
    if modLen < BytesLen(t) + 11:
        return Err[Bytes]("rsa: pkcs1 em too short")
    let psLen: int32 = modLen - BytesLen(t) - 3
    let em: Bytes = BytesAlloc(modLen)
    BytesSet(em, 0, 0x00)
    BytesSet(em, 1, 0x01)
    for i in 0..<psLen:
        BytesSet(em, 2 + i, 0xff)
    BytesSet(em, 2 + psLen, 0x00)
    rsaCopyBytes(em, 3 + psLen, t, 0, BytesLen(t))
    return rsaBigSignEmParts(nBig, dBig, modLen, em)

@borrows
fn rsaBuildPssEncodedMessage(
    msg: Bytes,
    salt: Bytes,
    modBits: int32,
    modLen: int32,
    useSha384: bool
): Result[Bytes] =
    let hLen: int32 = if useSha384: rsaHashLenSha384() else: rsaHashLenSha256()
    let sLen: int32 = hLen
    let emLen: int32 = modLen
    if emLen < hLen + sLen + 2:
        return Err[Bytes]("rsa: pss em too short")
    if BytesLen(salt) < sLen:
        return Err[Bytes]("rsa: pss salt too short")
    var mHash: Bytes
    if useSha384:
        mHash = rsaHashSha384(msg)
    else:
        mHash = rsaHashSha256(msg)
    let prefix: Bytes = BytesAlloc(8)
    let saltUse: Bytes = salt
    let hMsg: Bytes = BytesConcat3(prefix, mHash, saltUse)
    var h: Bytes
    if useSha384:
        h = rsaHashSha384(hMsg)
    else:
        h = rsaHashSha256(hMsg)
    # Bytes is POD: share() only accepts managed sources. Clone instead.
    var hMaskSeedBuf: Bytes = BytesAlloc(BytesLen(h))
    rawbytes.BytesCopyInto(hMaskSeedBuf, 0, h)
    let hMaskSeed: Bytes = hMaskSeedBuf
    let hOut: Bytes = h
    let psLen: int32 = emLen - sLen - hLen - 2
    if psLen < 0:
        return Err[Bytes]("rsa: pss ps len invalid")
    let dbLen: int32 = psLen + 1 + sLen
    let db: Bytes = BytesAlloc(dbLen)
    BytesSet(db, psLen, 0x01)
    for saltIndex in 0..<sLen:
        BytesSet(db, psLen + 1 + saltIndex, BytesGet(saltUse, saltIndex))
    let dbMask: Bytes = rsaMgf1(hMaskSeed, dbLen, useSha384)
    let maskedDb: Bytes = rsaBytesXorLen(db, dbMask, dbLen)
    let emBits: int32 = modBits - 1
    let unusedBits: int32 = emLen * 8 - emBits
    if unusedBits > 0:
        let mask: int32 = 0xff >> unusedBits
        BytesSet(maskedDb, 0, BytesGet(maskedDb, 0) & mask)
    let em: Bytes = BytesAlloc(emLen)
    let maskedLen: int32 = emLen - hLen - 1
    for i in 0..<maskedLen:
        BytesSet(em, i, BytesGet(maskedDb, i))
    for j in 0..<hLen:
        BytesSet(em, maskedLen + j, BytesGet(hOut, j))
    BytesSet(em, emLen - 1, 0xbc)
    return Ok[Bytes](em)

fn rsaBuildPssEncodedMessageFill(
    msg: Bytes,
    salt: Bytes,
    modBits: int32,
    modLen: int32,
    useSha384: bool,
    em: Bytes
): Result[bool] =
    let hLen: int32 = if useSha384: rsaHashLenSha384() else: rsaHashLenSha256()
    let sLen: int32 = hLen
    let emLen: int32 = modLen
    if BytesLen(em) < emLen:
        return Err[bool]("rsa: pss em output too short")
    if emLen < hLen + sLen + 2:
        return Err[bool]("rsa: pss em too short")
    if BytesLen(salt) < sLen:
        return Err[bool]("rsa: pss salt too short")
    var mHash: Bytes
    if useSha384:
        mHash = rsaHashSha384(msg)
    else:
        mHash = rsaHashSha256(msg)
    let prefix: Bytes = BytesAlloc(8)
    let hMsg: Bytes = BytesConcat3(prefix, mHash, salt)
    var h: Bytes
    if useSha384:
        h = rsaHashSha384(hMsg)
    else:
        h = rsaHashSha256(hMsg)
    let psLen: int32 = emLen - sLen - hLen - 2
    if psLen < 0:
        return Err[bool]("rsa: pss ps len invalid")
    let dbLen: int32 = psLen + 1 + sLen
    let db: Bytes = BytesAlloc(dbLen)
    BytesSet(db, psLen, 0x01)
    for saltIndex in 0..<sLen:
        BytesSet(db, psLen + 1 + saltIndex, BytesGet(salt, saltIndex))
    let dbMask: Bytes = rsaMgf1(h, dbLen, useSha384)
    let maskedDb: Bytes = rsaBytesXorLen(db, dbMask, dbLen)
    let emBits: int32 = modBits - 1
    let unusedBits: int32 = emLen * 8 - emBits
    if unusedBits > 0:
        let mask: int32 = 0xff >> unusedBits
        BytesSet(maskedDb, 0, BytesGet(maskedDb, 0) & mask)
    let maskedLen: int32 = emLen - hLen - 1
    for i in 0..<maskedLen:
        BytesSet(em, i, BytesGet(maskedDb, i))
    for j in 0..<hLen:
        BytesSet(em, maskedLen + j, BytesGet(h, j))
    BytesSet(em, emLen - 1, 0xbc)
    return Ok[bool](true)

fn rsaBigSignPss(priv: RsaBigPrivateKey, msg: Bytes, useSha384: bool): Result[Bytes] =
    let hLen: int32 = if useSha384: rsaHashLenSha384() else: rsaHashLenSha256()
    let modBits: int32 = priv.modBits
    let modLen: int32 = priv.modLen
    let salt: Bytes = BytesAlloc(hLen)
    if !rand.RandomFill(salt):
        return Err[Bytes]("rsa: pss salt random failed")
    let emRes: Result[Bytes] = rsaBuildPssEncodedMessage(
        msg,
        salt,
        modBits,
        modLen,
        useSha384
    )
    if IsErr(emRes):
        return Err[Bytes](Error(emRes))
    let em: Bytes = Value(emRes)
    let sigRes: Result[Bytes] = rsaBigSignEm(priv, em)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    let sig: Bytes = Value(sigRes)
    return Ok[Bytes](sig)

@borrows
fn rsaPkcs1ValueFromPkcs8OuterSeqInto(
    outerSeqValue: Bytes,
    outerVersionValue: Bytes,
    algValue: Bytes,
    nextOffset: int32,
    outValue: var Bytes
): Result[bool] =
    let outerVersionIntRes: Result[int64] = bytesToInt64(outerVersionValue)
    if IsErr(outerVersionIntRes) || (Value(outerVersionIntRes) != 0 && Value(outerVersionIntRes) != 1):
        return Err[bool]("rsa: invalid pkcs8 version")
    let oidTlvRes: Result[Asn1TagValueNext] = asn1DecodeTlv(algValue, 0)
    if IsErr(oidTlvRes):
        return Err[bool](Error(oidTlvRes))
    let oidDecoded: Asn1TagValueNext = Value(oidTlvRes)
    let oidTag: int32 = oidDecoded.tag
    let oidValue: Bytes = oidDecoded.value
    let oidNext: int32 = oidDecoded.next
    if oidTag != 0x06 || ! rsaIsRsaEncryptionOid(oidValue):
        return Err[bool]("rsa: unsupported pkcs8 algorithm")
    if oidNext < BytesLen(algValue):
        let paramRes: Result[Asn1TagValueNext] = asn1DecodeTlv(algValue, oidNext)
        if IsErr(paramRes):
            return Err[bool](Error(paramRes))
        let paramDecoded: Asn1TagValueNext = Value(paramRes)
        if paramDecoded.tag != 0x05:
            return Err[bool]("rsa: unsupported pkcs8 params")
    let keyRes: Result[Asn1TagValueNext] = asn1DecodeTlv(outerSeqValue, nextOffset)
    if IsErr(keyRes):
        return Err[bool](Error(keyRes))
    let keyDecoded: Asn1TagValueNext = Value(keyRes)
    let keyTag: int32 = keyDecoded.tag
    let keyValue: Bytes = keyDecoded.value
    if keyTag != 0x04:
        return Err[bool]("rsa: pkcs8 private key ! octet string")
    let innerSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(keyValue, 0)
    if IsErr(innerSeqRes):
        return Err[bool](Error(innerSeqRes))
    outValue = Value(innerSeqRes).value
    return Ok[bool](true)

@borrows
fn rsaPkcs1ValueFromPrivateKeyBodyInto(
    outerSeqValue: Bytes,
    outerVersionValue: Bytes,
    nextTag: int32,
    nextValue: Bytes,
    nextOffset: int32,
    outValue: var Bytes
): Result[bool] =
    if nextTag == 0x02:
        outValue = outerSeqValue
        return Ok[bool](true)
    if nextTag == 0x30:
        return rsaPkcs1ValueFromPkcs8OuterSeqInto(outerSeqValue, outerVersionValue, nextValue, nextOffset, outValue)
    return Err[bool]("rsa: unsupported private key format")

@borrows
fn rsaPkcs1ValueFromPrivateKeyBytes(privData: Bytes): Result[Bytes] =
    let outerSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(privData, 0)
    if IsErr(outerSeqRes):
        return Err[Bytes](Error(outerSeqRes))
    let outerSeqDecoded: Asn1ValueNext = Value(outerSeqRes)
    let outerSeqValue: Bytes = outerSeqDecoded.value
    let outerVersionRes: Result[Asn1ValueNext] = asn1DecodeInteger(outerSeqValue, 0)
    if IsErr(outerVersionRes):
        return Err[Bytes](Error(outerVersionRes))
    let outerVersionDecoded: Asn1ValueNext = Value(outerVersionRes)
    let nextRes: Result[Asn1TagValueNext] = asn1DecodeTlv(outerSeqValue, outerVersionDecoded.next)
    if IsErr(nextRes):
        return Err[Bytes](Error(nextRes))
    let nextDecoded: Asn1TagValueNext = Value(nextRes)
    let nextTag: int32 = nextDecoded.tag
    let nextValue: Bytes = nextDecoded.value
    let nextOffset: int32 = nextDecoded.next
    let outerVersionValue: Bytes = outerVersionDecoded.value
    var outValue: Bytes
    let fillRes: Result[bool] = rsaPkcs1ValueFromPrivateKeyBodyInto(
        outerSeqValue,
        outerVersionValue,
        nextTag,
        nextValue,
        nextOffset,
        outValue
    )
    if IsErr(fillRes):
        return Err[Bytes](Error(fillRes))
    return Ok[Bytes](outValue)

@borrows
fn rsaPkcs1ValueFromPrivateKeyBytesInto(privData: Bytes, outValue: var Bytes): Result[bool] =
    let outerSeqRes: Result[Asn1ValueNext] = asn1DecodeSequence(privData, 0)
    if IsErr(outerSeqRes):
        return Err[bool](Error(outerSeqRes))
    let outerSeqDecoded: Asn1ValueNext = Value(outerSeqRes)
    let outerSeqValue: Bytes = outerSeqDecoded.value
    let outerVersionRes: Result[Asn1ValueNext] = asn1DecodeInteger(outerSeqValue, 0)
    if IsErr(outerVersionRes):
        return Err[bool](Error(outerVersionRes))
    let outerVersionDecoded: Asn1ValueNext = Value(outerVersionRes)
    let nextRes: Result[Asn1TagValueNext] = asn1DecodeTlv(outerSeqValue, outerVersionDecoded.next)
    if IsErr(nextRes):
        return Err[bool](Error(nextRes))
    let nextDecoded: Asn1TagValueNext = Value(nextRes)
    return rsaPkcs1ValueFromPrivateKeyBodyInto(
        outerSeqValue,
        outerVersionDecoded.value,
        nextDecoded.tag,
        nextDecoded.value,
        nextDecoded.next,
        outValue
    )

@borrows
fn rsaBigSignPssPkcs1Value(pkcs1Value: Bytes, msg: Bytes, useSha384: bool, out: var Bytes): Result[bool] =
    let vRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, 0)
    if IsErr(vRes):
        return Err[bool](Error(vRes))
    let vDecoded: Asn1ValueNext = Value(vRes)
    let vIntRes: Result[int64] = bytesToInt64(vDecoded.value)
    if IsErr(vIntRes) || Value(vIntRes) != 0:
        return Err[bool]("rsa: invalid private key version")
    let nRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, vDecoded.next)
    if IsErr(nRes):
        return Err[bool](Error(nRes))
    let nDecoded: Asn1ValueNext = Value(nRes)
    let eRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, nDecoded.next)
    if IsErr(eRes):
        return Err[bool](Error(eRes))
    let eDecoded: Asn1ValueNext = Value(eRes)
    let dRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, eDecoded.next)
    if IsErr(dRes):
        return Err[bool](Error(dRes))
    let dDecoded: Asn1ValueNext = Value(dRes)
    let pRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, dDecoded.next)
    if IsErr(pRes):
        return Err[bool](Error(pRes))
    let pDecoded: Asn1ValueNext = Value(pRes)
    let qRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, pDecoded.next)
    if IsErr(qRes):
        return Err[bool](Error(qRes))
    let qDecoded: Asn1ValueNext = Value(qRes)
    let dpRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, qDecoded.next)
    if IsErr(dpRes):
        return Err[bool](Error(dpRes))
    let dpDecoded: Asn1ValueNext = Value(dpRes)
    let dqRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, dpDecoded.next)
    if IsErr(dqRes):
        return Err[bool](Error(dqRes))
    let dqDecoded: Asn1ValueNext = Value(dqRes)
    let qiRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, dqDecoded.next)
    if IsErr(qiRes):
        return Err[bool](Error(qiRes))
    let qiDecoded: Asn1ValueNext = Value(qiRes)
    let nBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(nDecoded.value)
    if IsErr(nBigRes):
        return Err[bool](Error(nBigRes))
    let eBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(eDecoded.value)
    if IsErr(eBigRes):
        return Err[bool](Error(eBigRes))
    let dBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(dDecoded.value)
    if IsErr(dBigRes):
        return Err[bool](Error(dBigRes))
    let pBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(pDecoded.value)
    if IsErr(pBigRes):
        return Err[bool](Error(pBigRes))
    let qBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(qDecoded.value)
    if IsErr(qBigRes):
        return Err[bool](Error(qBigRes))
    let dpBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(dpDecoded.value)
    if IsErr(dpBigRes):
        return Err[bool](Error(dpBigRes))
    let dqBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(dqDecoded.value)
    if IsErr(dqBigRes):
        return Err[bool](Error(dqBigRes))
    let qiBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(qiDecoded.value)
    if IsErr(qiBigRes):
        return Err[bool](Error(qiBigRes))
    var nBig: bigint.BigInt
    rsaBigSetInto(nBig, Value(nBigRes))
    var eBig: bigint.BigInt
    rsaBigSetInto(eBig, Value(eBigRes))
    var dBig: bigint.BigInt
    rsaBigSetInto(dBig, Value(dBigRes))
    var pBig: bigint.BigInt
    rsaBigSetInto(pBig, Value(pBigRes))
    var qBig: bigint.BigInt
    rsaBigSetInto(qBig, Value(qBigRes))
    var dpBig: bigint.BigInt
    rsaBigSetInto(dpBig, Value(dpBigRes))
    var dqBig: bigint.BigInt
    rsaBigSetInto(dqBig, Value(dqBigRes))
    var qiBig: bigint.BigInt
    rsaBigSetInto(qiBig, Value(qiBigRes))
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    if modBits <= 0 || modLen <= 0:
        return Err[bool]("rsa: invalid modulus")
    let one: bigint.BigInt = bigint.bigFromInt(1)
    if bigint.bigCmp(eBig, one) <= 0 || bigint.bigGetBit(eBig, 0) == 0:
        return Err[bool]("rsa: invalid exponent")
    if bigint.bigCmp(eBig, nBig) >= 0:
        return Err[bool]("rsa: exponent out of range")
    if bigint.bigCmp(dBig, one) <= 0:
        return Err[bool]("rsa: invalid private exponent")
    if bigint.bigCmp(pBig, one) <= 0 || bigint.bigCmp(qBig, one) <= 0:
        return Err[bool]("rsa: invalid crt prime")
    if bigint.bigCmp(dpBig, one) <= 0 || bigint.bigCmp(dqBig, one) <= 0:
        return Err[bool]("rsa: invalid crt exponent")
    if bigint.bigCmp(qiBig, one) <= 0:
        return Err[bool]("rsa: invalid crt coefficient")
    let hLen: int32 = if useSha384: rsaHashLenSha384() else: rsaHashLenSha256()
    let salt: Bytes = BytesAlloc(hLen)
    if !rand.RandomFill(salt):
        return Err[bool]("rsa: pss salt random failed")
    let emRes: Result[Bytes] = rsaBuildPssEncodedMessage(msg, salt, modBits, modLen, useSha384)
    if IsErr(emRes):
        return Err[bool](Error(emRes))
    let em: Bytes = Value(emRes)
    let sig: Bytes = BytesAlloc(modLen)
    let sigRes: Result[int32] = rsaBigSignEmPartsFill(nBig, eBig, dBig, modLen, em, sig)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    if Value(sigRes) != modLen:
        return Err[bool]("rsa: pss signature length mismatch")
    out = sig
    return Ok[bool](true)

fn rsaBigSignPssBytes(privData: Bytes, msg: Bytes, useSha384: bool): Result[Bytes] =
    let pkcs1ValueRes: Result[Bytes] = rsaPkcs1ValueFromPrivateKeyBytes(privData)
    if IsErr(pkcs1ValueRes):
        return Err[Bytes](Error(pkcs1ValueRes))
    var out: Bytes
    let sigRes: Result[bool] = rsaBigSignPssPkcs1Value(Value(pkcs1ValueRes), msg, useSha384, out)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    return Ok[Bytes](out)

fn rsaBigSignPssBytesInto(privData: Bytes, msg: Bytes, useSha384: bool, out: var Bytes): Result[bool] =
    let pkcs1ValueRes: Result[Bytes] = rsaPkcs1ValueFromPrivateKeyBytes(privData)
    if IsErr(pkcs1ValueRes):
        return Err[bool](Error(pkcs1ValueRes))
    return rsaBigSignPssPkcs1Value(Value(pkcs1ValueRes), msg, useSha384, out)

@borrows
fn rsaBigSignPssPkcs1ValueFill(pkcs1Value: Bytes, msg: Bytes, useSha384: bool, out: var Bytes): Result[int32] =
    var sig: Bytes
    let sigRes: Result[bool] = rsaBigSignPssPkcs1Value(pkcs1Value, msg, useSha384, sig)
    if IsErr(sigRes):
        return Err[int32](Error(sigRes))
    let sigLen: int32 = BytesLen(sig)
    if sigLen <= 0:
        return Err[int32]("rsa: pss signature length invalid")
    if BytesLen(out) < sigLen:
        return Err[int32]("rsa: output buffer too small")
    for i in 0..<sigLen:
        let sigByte: int32 = BytesGet(sig, i)
        BytesSet(out, i, sigByte)
        if i >= 0 && i < rsaSignatureScratchCapacity:
            rsaPssSignatureScratchBytes[i] = sigByte
    return Ok[int32](sigLen)

@borrows
fn rsaBigSignPssBytesFill(privData: Bytes, msg: Bytes, useSha384: bool, out: var Bytes): Result[int32] =
    var pkcs1Value: Bytes
    let pkcs1ValueRes: Result[bool] = rsaPkcs1ValueFromPrivateKeyBytesInto(privData, pkcs1Value)
    if IsErr(pkcs1ValueRes):
        return Err[int32](Error(pkcs1ValueRes))
    return rsaBigSignPssPkcs1ValueFill(pkcs1Value, msg, useSha384, out)

@borrows
fn rsaBigSignPssBytesScratch(privData: Bytes, msg: Bytes, useSha384: bool): Result[bool] =
    rsaPssSignatureScratch = BytesAlloc(rsaSignatureScratchCapacity)
    rsaPssSignatureScratchLen = 0
    rsaPssSignatureHexScratch = ""
    let sigLenRes: Result[int32] = rsaBigSignPssBytesFill(privData, msg, useSha384, rsaPssSignatureScratch)
    if IsErr(sigLenRes):
        return Err[bool](Error(sigLenRes))
    rsaPssSignatureScratchLen = Value(sigLenRes)
    return Ok[bool](true)

fn rsaBigLastPssSignatureLen(): int32 =
    return rsaPssSignatureScratchLen

fn rsaBigLastPssSignatureByte(idx: int32): int32 =
    if idx < 0 || idx >= rsaPssSignatureScratchLen:
        return -1
    return BytesGet(rsaPssSignatureScratch, idx)

fn rsaAppendLastPssSignatureToBuffer(buf: var bytebuffer.GrowByteBuffer): Result[bool] =
    bytebuffer.AppendBytes(buf, rsaPssSignatureScratch)
    return Ok[bool](true)

fn rsaHexDigit(value: int32): str =
    let hexChars: str = "0123456789abcdef"
    let idx: int32 = value & 0x0f
    return hexChars[idx]

fn rsaBigLastPssSignatureHex(): str =
    return rsaPssSignatureHexScratch

fn rsaBigSignPkcs1Bytes(privData: Bytes, msg: Bytes, useSha384: bool): Result[Bytes] =
    let pkcs1ValueRes: Result[Bytes] = rsaPkcs1ValueFromPrivateKeyBytes(privData)
    if IsErr(pkcs1ValueRes):
        return Err[Bytes](Error(pkcs1ValueRes))
    return rsaBigSignPkcs1Pkcs1Value(Value(pkcs1ValueRes), msg, useSha384)

fn rsaVerifyPkcs1(pub: RsaBigPublicKey, msg: Bytes, sig: Bytes, useSha384: bool): bool =
    var digest: Bytes
    if useSha384:
        digest = rsaHashSha384(msg)
    else:
        digest = rsaHashSha256(msg)
    var diRes: Result[Bytes]
    if useSha384:
        diRes = rsaDigestInfoSha384(digest)
    else:
        diRes = rsaDigestInfoSha256(digest)
    if IsErr(diRes):
        return false
    let t: Bytes = Value(diRes)
    let emRes: Result[Bytes] = rsaBigDecrypt(pub, sig)
    if IsErr(emRes):
        return false
    let em: Bytes = Value(emRes)
    let emLen: int32 = BytesLen(em)
    let tLen: int32 = BytesLen(t)
    if emLen < tLen + 11:
        return false
    if BytesGet(em, 0) != 0x00 || BytesGet(em, 1) != 0x01:
        return false
    let psLen: int32 = emLen - tLen - 3
    for i in 0..<psLen:
        if BytesGet(em, 2 + i) != 0xff:
            return false
    if BytesGet(em, 2 + psLen) != 0x00:
        return false
    let tStart: int32 = 3 + psLen
    let tBytes: Bytes = BytesSlice(em, tStart, tLen)
    return BytesEqual(tBytes, t)

fn rsaVerifyPkcs1Diag(pub: RsaBigPublicKey, msg: Bytes, sig: Bytes, useSha384: bool): Result[bool] =
    var digest: Bytes
    if useSha384:
        digest = rsaHashSha384(msg)
    else:
        digest = rsaHashSha256(msg)
    var diRes: Result[Bytes]
    if useSha384:
        diRes = rsaDigestInfoSha384(digest)
    else:
        diRes = rsaDigestInfoSha256(digest)
    if IsErr(diRes):
        return Err[bool]("rsa: digestinfo build failed")
    let t: Bytes = Value(diRes)
    let emRes: Result[Bytes] = rsaBigDecrypt(pub, sig)
    if IsErr(emRes):
        return Err[bool](strutil.Join(["rsa: decrypt failed: ", Error(emRes)], ""))
    let em: Bytes = Value(emRes)
    let emLen: int32 = BytesLen(em)
    let tLen: int32 = BytesLen(t)
    if emLen < tLen + 11:
        return Err[bool]("rsa: pkcs1 em too short")
    if BytesGet(em, 0) != 0x00 || BytesGet(em, 1) != 0x01:
        return Err[bool]("rsa: pkcs1 em prefix mismatch")
    let psLen: int32 = emLen - tLen - 3
    for i in 0..<psLen:
        if BytesGet(em, 2 + i) != 0xff:
            return Err[bool]("rsa: pkcs1 padding mismatch")
    if BytesGet(em, 2 + psLen) != 0x00:
        return Err[bool]("rsa: pkcs1 delimiter mismatch")
    let tStart: int32 = 3 + psLen
    let tBytes: Bytes = BytesSlice(em, tStart, tLen)
    if ! BytesEqual(tBytes, t):
        return Err[bool]("rsa: pkcs1 digestinfo mismatch")
    return Ok[bool](true)

@borrows
fn rsaVerifyPkcs1EmDiag(msg: Bytes, em: Bytes, useSha384: bool): Result[bool] =
    var digest: Bytes
    if useSha384:
        digest = rsaHashSha384(msg)
    else:
        digest = rsaHashSha256(msg)
    var diRes: Result[Bytes]
    if useSha384:
        diRes = rsaDigestInfoSha384(digest)
    else:
        diRes = rsaDigestInfoSha256(digest)
    if IsErr(diRes):
        return Err[bool]("rsa: digestinfo build failed")
    let t: Bytes = Value(diRes)
    let emLen: int32 = BytesLen(em)
    let tLen: int32 = BytesLen(t)
    if emLen < tLen + 11:
        return Err[bool]("rsa: pkcs1 em too short")
    if BytesGet(em, 0) != 0x00 || BytesGet(em, 1) != 0x01:
        return Err[bool]("rsa: pkcs1 em prefix mismatch")
    let psLen: int32 = emLen - tLen - 3
    for i in 0..<psLen:
        if BytesGet(em, 2 + i) != 0xff:
            return Err[bool]("rsa: pkcs1 padding mismatch")
    if BytesGet(em, 2 + psLen) != 0x00:
        return Err[bool]("rsa: pkcs1 delimiter mismatch")
    let tStart: int32 = 3 + psLen
    let tBytes: Bytes = BytesSlice(em, tStart, tLen)
    if ! BytesEqual(tBytes, t):
        return Err[bool]("rsa: pkcs1 digestinfo mismatch")
    return Ok[bool](true)

@borrows
fn rsaVerifyPkcs1Bytes(nBytes: Bytes, eBytes: Bytes, msg: Bytes, sig: Bytes, useSha384: bool): Result[bool] =
    let emRes: Result[Bytes] = rsaBigDecryptBytes(nBytes, eBytes, sig)
    if IsErr(emRes):
        return Err[bool](Error(emRes))
    return rsaVerifyPkcs1EmDiag(msg, Value(emRes), useSha384)

@borrows
fn rsaVerifyPkcs1DiagBytes(nBytes: Bytes, eBytes: Bytes, msg: Bytes, sig: Bytes, useSha384: bool): Result[bool] =
    let emRes: Result[Bytes] = rsaBigDecryptBytes(nBytes, eBytes, sig)
    if IsErr(emRes):
        let emErr: str = Error(emRes)
        return Err[bool](strutil.Join(["rsa: decrypt failed: ", emErr], ""))
    return rsaVerifyPkcs1EmDiag(msg, Value(emRes), useSha384)

@borrows
fn rsaVerifyPssEncodedMessageDiag(
    em: Bytes,
    msg: Bytes,
    modBits: int32,
    useSha384: bool
): Result[bool] =
    let hLen: int32 = if useSha384: rsaHashLenSha384() else: rsaHashLenSha256()
    let sLen: int32 = hLen
    let emLen: int32 = BytesLen(em)
    if emLen < hLen + sLen + 2:
        return Err[bool]("rsa: pss em too short")
    if BytesGet(em, emLen - 1) != 0xbc:
        return Err[bool]("rsa: pss trailer mismatch")
    let dbLen: int32 = emLen - hLen - 1
    let maskedDb: Bytes = BytesSlice(em, 0, dbLen)
    let h: Bytes = BytesSlice(em, dbLen, hLen)
    let hSeed: Bytes = BytesSlice(h, 0, BytesLen(h))
    let dbMask: Bytes = rsaMgf1(hSeed, dbLen, useSha384)
    let db: Bytes = rsaBytesXorLen(maskedDb, dbMask, dbLen)
    let emBits: int32 = modBits - 1
    let unusedBits: int32 = emLen * 8 - emBits
    if unusedBits > 0:
        let mask: int32 = 0xff ^((1 << (8 - unusedBits)) - 1)
        if (BytesGet(maskedDb, 0) & mask) != 0:
            return Err[bool]("rsa: pss maskeddb high bits set")
        BytesSet(db, 0, BytesGet(db, 0) & (0xff >> unusedBits))
    let psLen: int32 = dbLen - sLen - 1
    if psLen < 0:
        return Err[bool]("rsa: pss ps len invalid")
    var i: int32
    for i in i..<psLen:
        if BytesGet(db, i) != 0x00:
            return Err[bool]("rsa: pss ps mismatch")
    if BytesGet(db, psLen) != 0x01:
        return Err[bool]("rsa: pss delimiter mismatch")
    let salt: Bytes = BytesSlice(db, psLen + 1, sLen)
    var mHash: Bytes
    if useSha384:
        mHash = rsaHashSha384(msg)
    else:
        mHash = rsaHashSha256(msg)
    let prefix: Bytes = BytesAlloc(8)
    let hMsg: Bytes = BytesConcat3(prefix, mHash, salt)
    var h2: Bytes
    if useSha384:
        h2 = rsaHashSha384(hMsg)
    else:
        h2 = rsaHashSha256(hMsg)
    if ! BytesEqual(h, h2):
        return Err[bool]("rsa: pss hash mismatch")
    return Ok[bool](true)

fn rsaVerifyPssDiag(pub: RsaBigPublicKey, msg: Bytes, sig: Bytes, useSha384: bool): Result[bool] =
    let emRes: Result[Bytes] = rsaBigDecrypt(pub, sig)
    if IsErr(emRes):
        let emErr: str = Error(emRes)
        return Err[bool](strutil.Join(["rsa: pss decrypt failed: ", emErr], ""))
    return rsaVerifyPssEncodedMessageDiag(Value(emRes), msg, pub.modBits, useSha384)

fn rsaVerifyPss(pub: RsaBigPublicKey, msg: Bytes, sig: Bytes, useSha384: bool): bool =
    let res: Result[bool] = rsaVerifyPssDiag(pub, msg, sig, useSha384)
    if IsErr(res):
        return false
    return Value(res)

@borrows
fn rsaVerifyPssDiagBytes(nBytes: Bytes, eBytes: Bytes, msg: Bytes, sig: Bytes, useSha384: bool): Result[bool] =
    let nBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(nBytes)
    if IsErr(nBigRes):
        return Err[bool](Error(nBigRes))
    let eBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(eBytes)
    if IsErr(eBigRes):
        return Err[bool](Error(eBigRes))
    var nBig: bigint.BigInt
    rsaBigSetInto(nBig, Value(nBigRes))
    var eBig: bigint.BigInt
    rsaBigSetInto(eBig, Value(eBigRes))
    let modBits: int32 = bigint.bigBitLen(nBig)
    let modLen: int32 = (modBits + 7) / 8
    if modBits <= 0 || modLen <= 0:
        return Err[bool]("rsa: invalid modulus")
    let eInputLen: int32 = BytesLen(eBytes)
    let one: bigint.BigInt = bigint.bigFromInt(1)
    if bigint.bigCmp(eBig, one) <= 0 || bigint.bigGetBit(eBig, 0) == 0:
        return Err[bool]("rsa: invalid exponent")
    if bigint.bigCmp(eBig, nBig) >= 0:
        return Err[bool]("rsa: exponent out of range")
    let sigBigRes: Result[bigint.BigInt] = bigint.bigFromBytes(sig)
    if IsErr(sigBigRes):
        return Err[bool](Error(sigBigRes))
    var sigBig: bigint.BigInt
    rsaBigSetInto(sigBig, Value(sigBigRes))
    if bigint.bigIsZero(sigBig):
        return Err[bool]("rsa: pss decrypt failed: rsa: signature zero")
    if bigint.bigCmp(sigBig, nBig) >= 0:
        return Err[bool]("rsa: pss decrypt failed: rsa: signature out of range")
    var mBig: bigint.BigInt
    let mRes: Result[bool] = bigint.bigModExpInto(mBig, sigBig, eBig, nBig)
    if IsErr(mRes):
        let mErr: str = Error(mRes)
        return Err[bool](strutil.Join(["rsa: pss decrypt failed: ", mErr], ""))
    let em: Bytes = BytesAlloc(modLen)
    let fillRes: Result[int32] = rsaBigToBytesLocalFill(mBig, modLen, em)
    if IsErr(fillRes):
        let fillErr: str = Error(fillRes)
        return Err[bool](strutil.Join(["rsa: pss decrypt failed: ", fillErr], ""))
    return rsaVerifyPssEncodedMessageDiag(em, msg, modBits, useSha384)

@borrows
fn rsaVerifyPssBytes(nBytes: Bytes, eBytes: Bytes, msg: Bytes, sig: Bytes, useSha384: bool): Result[bool] =
    return rsaVerifyPssDiagBytes(nBytes, eBytes, msg, sig, useSha384)

fn rsaSign(priv: RsaPrivateKey, msg: Bytes): Result[Bytes] =
    if priv.n <= 0 || priv.d <= 0:
        return Err[Bytes]("rsa: invalid private key")
    let digest: Bytes = Sha256Digest(msg)
    let m: int64 = bytesToInt64Mod(digest, priv.n)
    let s: int64 = powMod(m, priv.d, priv.n)
    let sig: Bytes = int64ToBytes(s)
    return Ok[Bytes](sig)

fn rsaVerify(pub: RsaPublicKey, msg: Bytes, sig: Bytes): bool =
    if pub.n <= 0 || pub.e <= 0:
        return false
    let sigValRes: Result[int64] = bytesToInt64(sig)
    if IsErr(sigValRes):
        return false
    let s: int64 = Value(sigValRes)
    let digest: Bytes = Sha256Digest(msg)
    let m: int64 = bytesToInt64Mod(digest, pub.n)
    let v: int64 = powMod(s, pub.e, pub.n)
    return v == m

fn rsaPublicKeyToBytes(pub: RsaPublicKey): Bytes =
    let nEnc: Bytes = asn1EncodeInt64(pub.n)
    let eEnc: Bytes = asn1EncodeInt64(pub.e)
    var seq: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    bytebuffer.AppendBytes(seq, nEnc)
    bytebuffer.AppendBytes(seq, eEnc)
    return asn1EncodeSequence(bytebuffer.ToBytes(seq))

fn rsaBigPublicKeyToBytes(pub: RsaBigPublicKey): Bytes =
    let nEnc: Bytes = asn1EncodeInteger(bigint.bigToBytes(pub.n, pub.modLen))
    let eLen: int32 = (bigint.bigBitLen(pub.e) + 7) / 8
    let eEnc: Bytes = asn1EncodeInteger(bigint.bigToBytes(pub.e, eLen))
    var seq: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    bytebuffer.AppendBytes(seq, nEnc)
    bytebuffer.AppendBytes(seq, eEnc)
    return asn1EncodeSequence(bytebuffer.ToBytes(seq))

fn rsaBigPublicKeyToBytesParts(nBytes: Bytes, eBytes: Bytes): Bytes =
    let nEnc: Bytes = asn1EncodeInteger(nBytes)
    let eEnc: Bytes = asn1EncodeInteger(eBytes)
    var seq: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    bytebuffer.AppendBytes(seq, nEnc)
    bytebuffer.AppendBytes(seq, eEnc)
    return asn1EncodeSequence(bytebuffer.ToBytes(seq))

fn rsaPrivateKeyToBytes(priv: RsaPrivateKey): Bytes =
    let vEnc: Bytes = asn1EncodeInt64(0)
    let nEnc: Bytes = asn1EncodeInt64(priv.n)
    let eEnc: Bytes = asn1EncodeInt64(priv.e)
    let dEnc: Bytes = asn1EncodeInt64(priv.d)
    let pEnc: Bytes = asn1EncodeInt64(priv.p)
    let qEnc: Bytes = asn1EncodeInt64(priv.q)
    var seq: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    bytebuffer.AppendBytes(seq, vEnc)
    bytebuffer.AppendBytes(seq, nEnc)
    bytebuffer.AppendBytes(seq, eEnc)
    bytebuffer.AppendBytes(seq, dEnc)
    bytebuffer.AppendBytes(seq, pEnc)
    bytebuffer.AppendBytes(seq, qEnc)
    return asn1EncodeSequence(bytebuffer.ToBytes(seq))

fn rsaPublicKeyFromBytes(data: Bytes): Result[RsaPublicKey] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, 0)
    if IsErr(seqRes):
        return Err[RsaPublicKey](Error(seqRes))
    var offset: int32
    let seqValue: Bytes = Value(seqRes).value
    let nRes: Result[Asn1Int64Next] = asn1DecodeInt64(seqValue, offset)
    if IsErr(nRes):
        return Err[RsaPublicKey](Error(nRes))
    offset = Value(nRes).next
    let eRes: Result[Asn1Int64Next] = asn1DecodeInt64(seqValue, offset)
    if IsErr(eRes):
        return Err[RsaPublicKey](Error(eRes))
    let n: int64 = Value(nRes).value
    let e: int64 = Value(eRes).value
    if n <= 0 || e <= 0:
        return Err[RsaPublicKey]("rsa: invalid public key")
    return Ok[RsaPublicKey](RsaPublicKey(n: n, e: e))

fn rsaBigPublicKeyBytesInto(data: Bytes, outNBytes: var Bytes, outEBytes: var Bytes): Result[bool] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, 0)
    if IsErr(seqRes):
        return Err[bool](Error(seqRes))
    let seqValue: Bytes = Value(seqRes).value
    let nRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, 0)
    if IsErr(nRes):
        return Err[bool](Error(nRes))
    let nDecoded: Asn1ValueNext = Value(nRes)
    let eRes: Result[Asn1ValueNext] = asn1DecodeInteger(seqValue, nDecoded.next)
    if IsErr(eRes):
        return Err[bool](Error(eRes))
    let eDecoded: Asn1ValueNext = Value(eRes)
    if !rsaPublicKeyPartsValid(nDecoded.value, eDecoded.value):
        return Err[bool]("rsa: invalid public key parts")
    outNBytes = nDecoded.value
    outEBytes = eDecoded.value
    return Ok[bool](true)

@borrows
fn rsaPrivateKeyFromBytes(data: Bytes): Result[RsaPrivateKey] =
    let seqRes: Result[Asn1ValueNext] = asn1DecodeSequence(data, 0)
    if IsErr(seqRes):
        return Err[RsaPrivateKey](Error(seqRes))
    var offset: int32
    let seqValue: Bytes = Value(seqRes).value
    let vRes: Result[Asn1Int64Next] = asn1DecodeInt64(seqValue, offset)
    if IsErr(vRes):
        return Err[RsaPrivateKey](Error(vRes))
    offset = Value(vRes).next
    let nRes: Result[Asn1Int64Next] = asn1DecodeInt64(seqValue, offset)
    if IsErr(nRes):
        return Err[RsaPrivateKey](Error(nRes))
    offset = Value(nRes).next
    let eRes: Result[Asn1Int64Next] = asn1DecodeInt64(seqValue, offset)
    if IsErr(eRes):
        return Err[RsaPrivateKey](Error(eRes))
    offset = Value(eRes).next
    let dRes: Result[Asn1Int64Next] = asn1DecodeInt64(seqValue, offset)
    if IsErr(dRes):
        return Err[RsaPrivateKey](Error(dRes))
    offset = Value(dRes).next
    let pRes: Result[Asn1Int64Next] = asn1DecodeInt64(seqValue, offset)
    if IsErr(pRes):
        return Err[RsaPrivateKey](Error(pRes))
    offset = Value(pRes).next
    let qRes: Result[Asn1Int64Next] = asn1DecodeInt64(seqValue, offset)
    if IsErr(qRes):
        return Err[RsaPrivateKey](Error(qRes))
    let n: int64 = Value(nRes).value
    let e: int64 = Value(eRes).value
    let d: int64 = Value(dRes).value
    let p: int64 = Value(pRes).value
    let q: int64 = Value(qRes).value
    if n <= 0 || e <= 0 || d <= 0:
        return Err[RsaPrivateKey]("rsa: invalid private key")
    return Ok[RsaPrivateKey](RsaPrivateKey(n: n, e: e, d: d, p: p, q: q))

fn validateRsaPublicKeyBytes(data: Bytes): bool =
    var nBytes: Bytes
    var eBytes: Bytes
    let bigRes: Result[bool] = rsaBigPublicKeyBytesInto(data, nBytes, eBytes)
    if IsOk(bigRes):
        return true
    let res: Result[RsaPublicKey] = rsaPublicKeyFromBytes(data)
    return IsOk(res)

@borrows
fn validateRsaPrivateKeyBytes(data: Bytes): bool =
    let pkcs1ValueRes: Result[Bytes] = rsaPkcs1ValueFromPrivateKeyBytes(data)
    if IsOk(pkcs1ValueRes):
        return true
    let bigRes: Result[RsaBigPrivateKey] = rsaBigPrivateKeyFromBytes(data)
    if IsOk(bigRes):
        return true
    let res: Result[RsaPrivateKey] = rsaPrivateKeyFromBytes(data)
    return IsOk(res)

fn validateRsaSignatureBytes(data: Bytes): bool =
    return BytesLen(data) > 0

fn rsaSignBytes(privData: Bytes, msg: Bytes): Result[Bytes] =
    let bigRes: Result[RsaBigPrivateKey] = rsaBigPrivateKeyFromBytes(privData)
    if IsOk(bigRes):
        let priv: RsaBigPrivateKey = Value(bigRes)
        let sigRes: Result[Bytes] = rsaBigSignPkcs1(priv, msg, false)
        if IsErr(sigRes):
            return Err[Bytes](Error(sigRes))
        return sigRes
    let privRes: Result[RsaPrivateKey] = rsaPrivateKeyFromBytes(privData)
    if IsErr(privRes):
        return Err[Bytes](Error(privRes))
    return rsaSign(Value(privRes), msg)

fn rsaVerifyBytes(pubData: Bytes, msg: Bytes, sig: Bytes): bool =
    var nBytes: Bytes
    var eBytes: Bytes
    let bigRes: Result[bool] = rsaBigPublicKeyBytesInto(pubData, nBytes, eBytes)
    if IsOk(bigRes):
        let pkcs1Sha256Res = rsaVerifyPkcs1Bytes(nBytes, eBytes, msg, sig, false)
        if IsOk(pkcs1Sha256Res) && Value(pkcs1Sha256Res):
            return true
        let pkcs1Sha384Res = rsaVerifyPkcs1Bytes(nBytes, eBytes, msg, sig, true)
        if IsOk(pkcs1Sha384Res) && Value(pkcs1Sha384Res):
            return true
        let pssSha256Res = rsaVerifyPssBytes(nBytes, eBytes, msg, sig, false)
        if IsOk(pssSha256Res) && Value(pssSha256Res):
            return true
        let pssSha384Res = rsaVerifyPssBytes(nBytes, eBytes, msg, sig, true)
        if IsOk(pssSha384Res) && Value(pssSha384Res):
            return true
    let pubRes: Result[RsaPublicKey] = rsaPublicKeyFromBytes(pubData)
    if IsErr(pubRes):
        return false
    return rsaVerify(Value(pubRes), msg, sig)

fn rsaPublicKeyFromPrivateBytes(privData: Bytes): Result[Bytes] =
    var bigOut: Bytes
    let bigRes: Result[bool] = rsaBigPublicKeyFromPrivateBytesInto(bigOut, privData)
    if IsOk(bigRes):
        return Ok[Bytes](bigOut)
    let privRes: Result[RsaPrivateKey] = rsaPrivateKeyFromBytes(privData)
    if IsErr(privRes):
        return Err[Bytes](Error(privRes))
    let pub: RsaPublicKey = rsaPublicKeyFromPrivate(Value(privRes))
    return Ok[Bytes](rsaPublicKeyToBytes(pub))

fn rsaBigPublicKeyFromPrivateBytesInto(out: var Bytes, privData: Bytes): Result[bool] =
    let pkcs1Res: Result[Bytes] = rsaPkcs1ValueFromPrivateKeyBytes(privData)
    if IsErr(pkcs1Res):
        return Err[bool](Error(pkcs1Res))
    let pkcs1Value: Bytes = Value(pkcs1Res)
    let vRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, 0)
    if IsErr(vRes):
        return Err[bool](Error(vRes))
    let vDecoded: Asn1ValueNext = Value(vRes)
    let vIntRes: Result[int64] = bytesToInt64(vDecoded.value)
    if IsErr(vIntRes) || Value(vIntRes) != 0:
        return Err[bool]("rsa: invalid private key version")
    let nRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, vDecoded.next)
    if IsErr(nRes):
        return Err[bool](Error(nRes))
    let nDecoded: Asn1ValueNext = Value(nRes)
    let eRes: Result[Asn1ValueNext] = asn1DecodeInteger(pkcs1Value, nDecoded.next)
    if IsErr(eRes):
        return Err[bool](Error(eRes))
    let nBytes: Bytes = nDecoded.value
    let eBytes: Bytes = Value(eRes).value
    if !rsaPublicKeyPartsValid(nBytes, eBytes):
        return Err[bool]("rsa: invalid public key parts")
    out = rsaBigPublicKeyToBytesParts(nBytes, eBytes)
    return Ok[bool](true)

fn rsaBigPublicKeyFromPrivateBytes(privData: Bytes): Result[Bytes] =
    var out: Bytes
    let fillRes: Result[bool] = rsaBigPublicKeyFromPrivateBytesInto(out, privData)
    if IsErr(fillRes):
        return Err[Bytes](Error(fillRes))
    return Ok[Bytes](out)
