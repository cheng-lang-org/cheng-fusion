fn p256GeneratorWindow4NegPoint(idx: int32): EcPointFixed =
    if idx == 0:
        return pointInfinityFixed()
    let point: EcPointFixed = p256GeneratorWindow4Point(idx)
    let yNeg: pfix.P256Fixed = p256FieldFixedSubCrash(pfix.P256Fixed(), point.y)
    var out: EcPointFixed
    pointFixedSetCoordsInto(out, point.x, yNeg)
    return out

