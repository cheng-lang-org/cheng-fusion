@borrows
fn p256ScalarFixedIsZero(a: pfix.P256Fixed): bool =
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    return pfix.p256FixedIsZero(aa)

@borrows
fn p256ScalarFixedIsOdd(a: pfix.P256Fixed): bool =
    return (pfix.p256FixedWordToBitsU64(a.limbs[0]) & uint64(1)) != uint64(0)

@borrows
fn p256ScalarFixedLow5(a: pfix.P256Fixed): int32 =
    return int32(pfix.p256FixedWordToBitsU64(a.limbs[0]) & uint64(31))

@borrows
fn p256ScalarFixedAddSmall(a: pfix.P256Fixed, delta: int32): pfix.P256Fixed =
    var out: pfix.P256Fixed
    p256FixedCopyInto(out, a)
    var carry: uint64 = uint64(delta)
    var i: int32
    while carry != uint64(0) && i < pfix.p256FixedLimbCount:
        let av: uint64 = pfix.p256FixedWordToBitsU64(out.limbs[i])
        let sum: uint64 = av + carry
        out.limbs[i] = pfix.p256FixedWordFromBitsU64(sum)
        carry = sum >> uint64(pfix.p256FixedWordBits)
        i = i + 1
    return out

@borrows
fn p256ScalarFixedSubSmall(a: pfix.P256Fixed, delta: int32): pfix.P256Fixed =
    var out: pfix.P256Fixed
    p256FixedCopyInto(out, a)
    var borrow: uint64 = uint64(delta)
    var i: int32
    let wordBase: uint64 = uint64(1) << uint64(pfix.p256FixedWordBits)
    while borrow != uint64(0) && i < pfix.p256FixedLimbCount:
        let av: uint64 = pfix.p256FixedWordToBitsU64(out.limbs[i])
        if av >= borrow:
            out.limbs[i] = pfix.p256FixedWordFromBitsU64(av - borrow)
            borrow = uint64(0)
        else:
            out.limbs[i] = pfix.p256FixedWordFromBitsU64(wordBase + av - borrow)
            borrow = uint64(1)
        i = i + 1
    return out

@borrows
fn p256ScalarFixedShiftRight1(a: pfix.P256Fixed): pfix.P256Fixed =
    var out: pfix.P256Fixed
    var carry: uint64 = uint64(0)
    let iStart2 = pfix.p256FixedLimbCount - 1
    for iOffset2 in 0..iStart2:
        let i = iStart2 - iOffset2
        let limb: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[i])
        let shifted: uint64 = (limb >> uint64(1)) | (carry << uint64(pfix.p256FixedWordBits - 1))
        out.limbs[i] = pfix.p256FixedWordFromBitsU64(shifted)
        carry = limb & uint64(1)
    return out

fn p256ScalarFixedComb8Digit(a: pfix.P256Fixed, row: int32): int32 =
    var digit: int32
    var i: int32
    for i in i..<8:
        let bitIdx: int32 = row + (32 * i)
        digit = digit | (pfix.p256FixedGetBit(a, bitIdx) << i)
    return digit

fn p256ScalarFixedComb6Digit(a: pfix.P256Fixed, row: int32): int32 =
    let w0: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[0])
    let w1: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[1])
    let w2: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[2])
    let w3: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[3])
    let w4: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[4])
    let w5: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[5])
    let w6: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[6])
    let w7: uint64 = pfix.p256FixedWordToBitsU64(a.limbs[7])
    var digit: int32
    if row < 32:
        digit = digit | int32((w0 >> uint64(row)) & uint64(1))
    else:
        digit = digit | int32((w1 >> uint64(row - 32)) & uint64(1))
    if row < 21:
        digit = digit | (int32((w1 >> uint64(row + 11)) & uint64(1)) << 1)
    else:
        digit = digit | (int32((w2 >> uint64(row - 21)) & uint64(1)) << 1)
    if row < 10:
        digit = digit | (int32((w2 >> uint64(row + 22)) & uint64(1)) << 2)
    elif row < 42:
        digit = digit | (int32((w3 >> uint64(row - 10)) & uint64(1)) << 2)
    else:
        digit = digit | (int32(w4 & uint64(1)) << 2)
    if row < 31:
        digit = digit | (int32((w4 >> uint64(row + 1)) & uint64(1)) << 3)
    else:
        digit = digit | (int32((w5 >> uint64(row - 31)) & uint64(1)) << 3)
    if row < 20:
        digit = digit | (int32((w5 >> uint64(row + 12)) & uint64(1)) << 4)
    else:
        digit = digit | (int32((w6 >> uint64(row - 20)) & uint64(1)) << 4)
    if row < 9:
        digit = digit | (int32((w6 >> uint64(row + 23)) & uint64(1)) << 5)
    else:
        digit = digit | (int32((w7 >> uint64(row - 9)) & uint64(1)) << 5)
    return digit

fn ecnistHexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return int32(c) - int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + int32(c) - int32('a')
    if c >= 'A' && c <= 'F':
        return 10 + int32(c) - int32('A')
    return -1

fn hexDecode(text: str): Result[Bytes] =
    if len(text) % 2 != 0:
        return Err[Bytes]("ecdsa: hex length must be even")
    let out: Bytes = BytesAlloc(len(text) / 2)
    var i: int32
    while i < len(text):
        let hi: int32 = ecnistHexValue(text[i])
        let lo: int32 = ecnistHexValue(text[i + 1])
        if hi < 0 || lo < 0:
            return Err[Bytes]("ecdsa: invalid hex")
        BytesSet(out, i / 2, (hi << 4) | lo)
        i = i + 2
    return Ok[Bytes](out)

fn bytesFromByte(value: int32): Bytes =
    let out: Bytes = BytesAlloc(1)
    BytesSet(out, 0, value)
    return out

fn hmacSha256(key: Bytes, data: Bytes): Bytes =
    return hmacDigestSha256(key, data)

fn ecnistSha256DigestFn(data: Bytes): Bytes =
    return Sha256Digest(data)

fn p256EnsureInit(): Result[bool] =
    if p256InitDone:
        return Ok[bool](true)
    var pConst: bigint.BigInt
    var nConst: bigint.BigInt
    var bConst: bigint.BigInt
    var gxConst: bigint.BigInt
    var gyConst: bigint.BigInt
    p256ConstPInto(pConst)
    p256ConstNInto(nConst)
    p256ConstBInto(bConst)
    p256ConstGxInto(gxConst)
    p256ConstGyInto(gyConst)
    let three: bigint.BigInt = bigint.bigFromInt(3)
    let aRes: Result[bigint.BigInt] = bigint.bigSub(pConst, three)
    if IsErr(aRes):
        return Err[bool](Error(aRes))
    p256BigSetInto(p256A, Value(aRes))
    let two: bigint.BigInt = bigint.bigFromInt(2)
    let pMinus2Res: Result[bigint.BigInt] = bigint.bigSub(pConst, two)
    if IsErr(pMinus2Res):
        return Err[bool](Error(pMinus2Res))
    let nMinus2Res: Result[bigint.BigInt] = bigint.bigSub(nConst, two)
    if IsErr(nMinus2Res):
        return Err[bool](Error(nMinus2Res))
    p256BigSetInto(p256P, pConst)
    p256BigSetInto(p256N, nConst)
    p256BigSetInto(p256B, bConst)
    pointSetCoordsInto(p256G, gxConst, gyConst)
    p256P.count = 8
    p256P.limbs[7] = pConst.limbs[7]
    p256N.count = 8
    p256N.limbs[7] = nConst.limbs[7]
    p256B.count = 8
    p256B.limbs[7] = bConst.limbs[7]
    p256G.x.count = 8
    p256G.x.limbs[7] = gxConst.limbs[7]
    p256G.y.count = 8
    p256G.y.limbs[7] = gyConst.limbs[7]
    p256BigSetInto(p256PMinus2, Value(pMinus2Res))
    p256BigSetInto(p256NMinus2, Value(nMinus2Res))
    p256BigSetInto(p256NHalf, bigint.bigShiftRight1(nConst))
    return p256EnsureInitFixedContexts(bConst)

fn p256EnsureInitFixedContexts(bConst: var bigint.BigInt): Result[bool] =
    let fieldModulus: pfix.P256Fixed = pfix.p256FieldModulus()
    p256FixedCopyInto(p256PCtxFixed.modulus, fieldModulus)
    p256PCtxFixed.n0Inv = uint64(1)
    let fieldR2: pfix.P256Fixed = pfix.p256FieldR2()
    p256FixedCopyInto(p256PCtxFixed.r2, fieldR2)
    let fieldOneMont: pfix.P256Fixed = pfix.p256FieldOneMont()
    p256FixedCopyInto(p256PCtxFixed.oneMont, fieldOneMont)
    let scalarModulus: pfix.P256Fixed = pfix.p256ScalarModulus()
    p256FixedCopyInto(p256NCtxFixed.modulus, scalarModulus)
    p256NCtxFixed.n0Inv = uint64(0xee00bc4f)
    let scalarR2: pfix.P256Fixed = pfix.p256ScalarR2()
    p256FixedCopyInto(p256NCtxFixed.r2, scalarR2)
    let scalarOneMont: pfix.P256Fixed = pfix.p256ScalarOneMont()
    p256FixedCopyInto(p256NCtxFixed.oneMont, scalarOneMont)
    var pMinus2Big: bigint.BigInt
    p256BigSetInto(pMinus2Big, p256PMinus2)
    let pMinus2FixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(pMinus2Big)
    if IsErr(pMinus2FixedRes):
        return Err[bool](Error(pMinus2FixedRes))
    p256FixedCopyInto(p256PMinus2Fixed, Value(pMinus2FixedRes))
    var nMinus2Big: bigint.BigInt
    p256BigSetInto(nMinus2Big, p256NMinus2)
    let nMinus2FixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(nMinus2Big)
    if IsErr(nMinus2FixedRes):
        return Err[bool](Error(nMinus2FixedRes))
    p256FixedCopyInto(p256NMinus2Fixed, Value(nMinus2FixedRes))
    let bFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(bConst)
    if IsErr(bFixedRes):
        return Err[bool](Error(bFixedRes))
    p256FixedCopyInto(p256BFixed, Value(bFixedRes))
    p256InitDone = true
    return Ok[bool](true)

fn p256EnsureFixedInit(): Result[bool] =
    if p256FixedInitDone:
        return Ok[bool](true)
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    p256FixedInitDone = true
    return Ok[bool](true)

@borrows
fn p256Mod(a: bigint.BigInt): Result[bigint.BigInt] =
    let modulus: bigint.BigInt = p256ConstP()
    return bigint.bigMod(a, modulus)

fn p256FixedToBigResult(value: pfix.P256Fixed): Result[bigint.BigInt] =
    return Ok[bigint.BigInt](pfix.p256FixedToBigInt(value))

@borrows
fn p256ModMul(a: bigint.BigInt, b: bigint.BigInt): Result[bigint.BigInt] =
    var left: bigint.BigInt = bigint.bigCopy(a)
    var right: bigint.BigInt = bigint.bigCopy(b)
    var out: bigint.BigInt
    let mulRes: Result[bool] = p256ModMulInto(out, left, right)
    if IsErr(mulRes):
        return Err[bigint.BigInt](Error(mulRes))
    return Ok[bigint.BigInt](out)

fn p256ModMulInto(out: var bigint.BigInt, a: var bigint.BigInt, b: var bigint.BigInt): Result[bool] =
    var modulus: bigint.BigInt = p256ConstP()
    return bigint.bigModMulInto(out, a, b, modulus)

@borrows
fn p256ModAdd(a: bigint.BigInt, b: bigint.BigInt): Result[bigint.BigInt] =
    let modulus: bigint.BigInt = p256ConstP()
    return bigint.bigModAdd(a, b, modulus)

@borrows
fn p256ModSub(a: bigint.BigInt, b: bigint.BigInt): Result[bigint.BigInt] =
    let modulus: bigint.BigInt = p256ConstP()
    return bigint.bigModSub(a, b, modulus)

fn p256ModHalfOdd(a: bigint.BigInt, modulus: bigint.BigInt): Result[bigint.BigInt] =
    if bigint.bigIsOdd(a):
        let sumRes: Result[bigint.BigInt] = bigint.bigAdd(a, modulus)
        if IsErr(sumRes):
            return Err[bigint.BigInt](Error(sumRes))
        return Ok[bigint.BigInt](bigint.bigShiftRight1(Value(sumRes)))
    return Ok[bigint.BigInt](bigint.bigShiftRight1(a))

fn p256ModInvBinaryInline(reduced: bigint.BigInt,
                          modulus: bigint.BigInt,
                          label: str): Result[bigint.BigInt] =
    if bigint.bigIsZero(reduced):
        return Err[bigint.BigInt]("ecdsa: inverse of zero")
    var u: bigint.BigInt
    p256BigSetInto(u, reduced)
    var v: bigint.BigInt
    p256BigSetInto(v, modulus)
    let one: bigint.BigInt = bigint.bigFromInt(1)
    var x1: bigint.BigInt
    p256BigSetInto(x1, one)
    var x2: bigint.BigInt = bigint.bigZero()
    var steps: int32
    while true:
        steps = steps + 1
        if steps > 4096:
            return Err[bigint.BigInt](strutil.Join([label, ": inverse iteration overflow"], ""))
        while ! bigint.bigIsZero(u) && ! bigint.bigIsOdd(u):
            u = bigint.bigShiftRight1(u)
            let halfRes: Result[bigint.BigInt] = p256ModHalfOdd(x1, modulus)
            if IsErr(halfRes):
                return Err[bigint.BigInt](Error(halfRes))
            p256BigSetInto(x1, Value(halfRes))
        while ! bigint.bigIsZero(v) && ! bigint.bigIsOdd(v):
            v = bigint.bigShiftRight1(v)
            let halfRes: Result[bigint.BigInt] = p256ModHalfOdd(x2, modulus)
            if IsErr(halfRes):
                return Err[bigint.BigInt](Error(halfRes))
            p256BigSetInto(x2, Value(halfRes))
        if bigint.bigCmp(u, one) == 0:
            return Ok[bigint.BigInt](x1)
        if bigint.bigCmp(v, one) == 0:
            return Ok[bigint.BigInt](x2)
        if bigint.bigIsZero(u) || bigint.bigIsZero(v):
            return Err[bigint.BigInt](strutil.Join([label, ": inverse not invertible"], ""))
        if bigint.bigCmp(u, v) >= 0:
            let subRes: Result[bigint.BigInt] = bigint.bigSub(u, v)
            if IsErr(subRes):
                return Err[bigint.BigInt](Error(subRes))
            p256BigSetInto(u, Value(subRes))
            let diffRes: Result[bigint.BigInt] = bigint.bigModSub(x1, x2, modulus)
            if IsErr(diffRes):
                return Err[bigint.BigInt](Error(diffRes))
            p256BigSetInto(x1, Value(diffRes))
        else:
            let subRes: Result[bigint.BigInt] = bigint.bigSub(v, u)
            if IsErr(subRes):
                return Err[bigint.BigInt](Error(subRes))
            p256BigSetInto(v, Value(subRes))
            let diffRes: Result[bigint.BigInt] = bigint.bigModSub(x2, x1, modulus)
            if IsErr(diffRes):
                return Err[bigint.BigInt](Error(diffRes))
            p256BigSetInto(x2, Value(diffRes))
    return Err[bigint.BigInt](strutil.Join([label, ": inverse failed"], ""))

fn p256FixedPrimeModInv(a: bigint.BigInt,
                        modulus: bigint.BigInt,
                        modulusMinus2: var pfix.P256Fixed,
                        ctx: var pfix.P256FixedMontgomeryContext): Result[bigint.BigInt] =
    var reduced: bigint.BigInt
    p256BigSetInto(reduced, a)
    if bigint.bigCmp(reduced, modulus) >= 0:
        return Err[bigint.BigInt]("ecdsa: inverse input not reduced")
    if bigint.bigIsZero(reduced):
        return Err[bigint.BigInt]("ecdsa: inverse of zero")
    let fixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(reduced)
    if IsErr(fixedRes):
        return Err[bigint.BigInt](Error(fixedRes))
    var fixed: pfix.P256Fixed
    p256FixedCopyInto(fixed, Value(fixedRes))
    var exp: pfix.P256Fixed
    p256FixedCopyInto(exp, modulusMinus2)
    let invFixed: pfix.P256Fixed = pfix.p256FixedModExpWithContextTrusted(fixed, exp, ctx)
    return Ok[bigint.BigInt](pfix.p256FixedToBigInt(invFixed))

fn p256ModPow(base: bigint.BigInt, exp: bigint.BigInt): Result[bigint.BigInt] =
    var baseLocal: bigint.BigInt = base
    var expLocal: bigint.BigInt = exp
    var modulus: bigint.BigInt = p256ConstP()
    var out: bigint.BigInt
    let powRes: Result[bool] = bigint.bigModExpInto(out, baseLocal, expLocal, modulus)
    if IsErr(powRes):
        return Err[bigint.BigInt](Error(powRes))
    return Ok[bigint.BigInt](out)

fn p256ModInv(a: bigint.BigInt): Result[bigint.BigInt] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bigint.BigInt](Error(initRes))
    let reducedRes: Result[bigint.BigInt] = p256Mod(a)
    if IsErr(reducedRes):
        return Err[bigint.BigInt](Error(reducedRes))
    var reduced: bigint.BigInt
    p256BigSetInto(reduced, Value(reducedRes))
    if bigint.bigIsZero(reduced):
        return Err[bigint.BigInt]("ecdsa: inverse of zero")
    let modulus: bigint.BigInt = p256ConstP()
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContext()
    return p256FixedPrimeModInv(reduced, modulus, p256PMinus2Fixed, ctx)

fn nMod(a: bigint.BigInt): Result[bigint.BigInt] =
    let modulus: bigint.BigInt = p256ConstN()
    return bigint.bigMod(a, modulus)

fn nModMulInto(out: var bigint.BigInt, a: var bigint.BigInt, b: var bigint.BigInt): Result[bool] =
    var modulus: bigint.BigInt = p256ConstN()
    return bigint.bigModMulInto(out, a, b, modulus)

fn nModMul(a: bigint.BigInt, b: bigint.BigInt): Result[bigint.BigInt] =
    var left: bigint.BigInt = a
    var right: bigint.BigInt = b
    var out: bigint.BigInt
    let mulRes: Result[bool] = nModMulInto(out, left, right)
    if IsErr(mulRes):
        return Err[bigint.BigInt](Error(mulRes))
    return Ok[bigint.BigInt](out)

fn nModAdd(a: bigint.BigInt, b: bigint.BigInt): Result[bigint.BigInt] =
    let modulus: bigint.BigInt = p256ConstN()
    return bigint.bigModAdd(a, b, modulus)

fn nModPow(base: bigint.BigInt, exp: bigint.BigInt): Result[bigint.BigInt] =
    var one: bigint.BigInt = bigint.bigFromInt(1)
    var result: bigint.BigInt
    p256BigSetInto(result, one)
    let baseModRes: Result[bigint.BigInt] = nMod(base)
    if IsErr(baseModRes):
        return Err[bigint.BigInt](Error(baseModRes))
    var pow: bigint.BigInt
    p256BigSetInto(pow, Value(baseModRes))
    let bits: int32 = bigint.bigBitLen(exp)
    for i in 0..<bits:
        if bigint.bigGetBit(exp, i) != 0:
            var mul: bigint.BigInt
            let mulRes: Result[bool] = nModMulInto(mul, result, pow)
            if IsErr(mulRes):
                return Err[bigint.BigInt](Error(mulRes))
            p256BigSetInto(result, mul)
        if i + 1 < bits:
            var square: bigint.BigInt
            let squareRes: Result[bool] = nModMulInto(square, pow, pow)
            if IsErr(squareRes):
                return Err[bigint.BigInt](Error(squareRes))
            p256BigSetInto(pow, square)
    return Ok[bigint.BigInt](result)

fn nModInv(a: bigint.BigInt): Result[bigint.BigInt] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bigint.BigInt](Error(initRes))
    let reducedRes: Result[bigint.BigInt] = nMod(a)
    if IsErr(reducedRes):
        return Err[bigint.BigInt](Error(reducedRes))
    var reduced: bigint.BigInt
    p256BigSetInto(reduced, Value(reducedRes))
    if bigint.bigIsZero(reduced):
        return Err[bigint.BigInt]("ecdsa: inverse of zero")
    let modulus: bigint.BigInt = p256ConstN()
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256ScalarMontgomeryContext()
    return p256FixedPrimeModInv(reduced, modulus, p256NMinus2Fixed, ctx)

fn p256FieldFixedOne(): pfix.P256Fixed =
    return pfix.p256FieldOneMont()

@borrows
fn p256FieldFixedToMont(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContext()
    var r2: pfix.P256Fixed
    p256FixedCopyInto(r2, ctx.r2)
    return pfix.p256FixedMontgomeryMulCore(aa, r2, ctx)

@borrows
fn p256FieldFixedFromMont(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContext()
    var one: pfix.P256Fixed = pfix.p256FixedOne()
    return pfix.p256FixedMontgomeryMulCore(aa, one, ctx)

fn p256FieldFixedAdd(a: pfix.P256Fixed, b: pfix.P256Fixed): Result[pfix.P256Fixed] =
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContext()
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    var bb: pfix.P256Fixed
    p256FixedCopyInto(bb, b)
    var modulus: pfix.P256Fixed
    p256FixedCopyInto(modulus, ctx.modulus)
    return pfix.p256FixedModAdd(aa, bb, modulus)

fn p256FieldFixedSub(a: pfix.P256Fixed, b: pfix.P256Fixed): Result[pfix.P256Fixed] =
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContext()
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    var bb: pfix.P256Fixed
    p256FixedCopyInto(bb, b)
    var modulus: pfix.P256Fixed
    p256FixedCopyInto(modulus, ctx.modulus)
    return pfix.p256FixedModSub(aa, bb, modulus)

fn p256FieldFixedMul(a: pfix.P256Fixed, b: pfix.P256Fixed): Result[pfix.P256Fixed] =
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContextMul()
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    var bb: pfix.P256Fixed
    p256FixedCopyInto(bb, b)
    return pfix.p256FixedMontgomeryMulCore(aa, bb, ctx)

fn p256FieldFixedSquare(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContextMul()
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    var bb: pfix.P256Fixed
    p256FixedCopyInto(bb, a)
    return pfix.p256FixedMontgomeryMulCore(aa, bb, ctx)

fn p256FieldFixedInv(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    if pfix.p256FixedIsZero(a):
        return Err[pfix.P256Fixed]("ecdsa: inverse of zero")
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[pfix.P256Fixed](Error(initRes))
    let aNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(a)
    if IsErr(aNormRes):
        return Err[pfix.P256Fixed](Error(aNormRes))
    var aNorm: pfix.P256Fixed = Value(aNormRes)
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContext()
    var exp: pfix.P256Fixed
    p256FixedCopyFromVarInto(exp, p256PMinus2Fixed)
    let invNorm: pfix.P256Fixed = pfix.p256FixedModExpWithContextTrusted(aNorm, exp, ctx)
    return p256FieldFixedToMont(invNorm)

fn p256FieldFixedDouble(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    return p256FieldFixedAdd(a, a)

fn p256FieldFixedTriple(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    let dblRes: Result[pfix.P256Fixed] = p256FieldFixedDouble(a)
    if IsErr(dblRes):
        return Err[pfix.P256Fixed](Error(dblRes))
    return p256FieldFixedAdd(Value(dblRes), a)

fn p256FieldFixedQuad(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    let dblRes: Result[pfix.P256Fixed] = p256FieldFixedDouble(a)
    if IsErr(dblRes):
        return Err[pfix.P256Fixed](Error(dblRes))
    return p256FieldFixedDouble(Value(dblRes))

fn p256FieldFixedEight(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    let quadRes: Result[pfix.P256Fixed] = p256FieldFixedQuad(a)
    if IsErr(quadRes):
        return Err[pfix.P256Fixed](Error(quadRes))
    return p256FieldFixedDouble(Value(quadRes))

fn p256FieldFixedIsOne(a: pfix.P256Fixed): bool =
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    var one: pfix.P256Fixed = p256FieldFixedOne()
    return pfix.p256FixedCmp(aa, one) == 0

fn p256FieldFixedAddCrash(a: pfix.P256Fixed, b: pfix.P256Fixed): pfix.P256Fixed =
    let res: Result[pfix.P256Fixed] = p256FieldFixedAdd(a, b)
    let failed: bool = IsErr(res)
    Assert(!failed, "ecdsa: fixed add failed")
    return Value(res)

fn p256FieldFixedSubCrash(a: pfix.P256Fixed, b: pfix.P256Fixed): pfix.P256Fixed =
    let res: Result[pfix.P256Fixed] = p256FieldFixedSub(a, b)
    let failed: bool = IsErr(res)
    Assert(!failed, "ecdsa: fixed sub failed")
    return Value(res)

fn p256FieldFixedMulCrash(a: pfix.P256Fixed, b: pfix.P256Fixed): pfix.P256Fixed =
    let res: Result[pfix.P256Fixed] = p256FieldFixedMul(a, b)
    let failed: bool = IsErr(res)
    Assert(!failed, "ecdsa: fixed mul failed")
    return Value(res)

fn p256FieldFixedSquareCrash(a: pfix.P256Fixed): pfix.P256Fixed =
    let res: Result[pfix.P256Fixed] = p256FieldFixedSquare(a)
    let failed: bool = IsErr(res)
    Assert(!failed, "ecdsa: fixed square failed")
    return Value(res)

fn p256FieldFixedDoubleCrash(a: pfix.P256Fixed): pfix.P256Fixed =
    return p256FieldFixedAddCrash(a, a)

fn p256FieldFixedTripleCrash(a: pfix.P256Fixed): pfix.P256Fixed =
    return p256FieldFixedAddCrash(p256FieldFixedDoubleCrash(a), a)

fn p256FieldFixedQuadCrash(a: pfix.P256Fixed): pfix.P256Fixed =
    return p256FieldFixedDoubleCrash(p256FieldFixedDoubleCrash(a))

fn p256FieldFixedEightCrash(a: pfix.P256Fixed): pfix.P256Fixed =
    return p256FieldFixedDoubleCrash(p256FieldFixedQuadCrash(a))

fn pointInfinityFixed(): EcPointFixed =
    var out: EcPointFixed
    pointFixedSetInfinityInto(out)
    return out

fn pointJacobianInfinityFixed(): EcPointJacobianFixed =
    var out: EcPointJacobianFixed
    pointJacobianFixedSetInfinityInto(out)
    return out

fn pointJacobianSetInfinityFixed(p: var EcPointJacobianFixed) =
    pointJacobianFixedSetInfinityInto(p)

fn pointJacobianSetFromAffineFixed(p: var EcPointJacobianFixed, q: EcPointFixed) =
    pointJacobianFixedSetFromAffineInto(p, q)

fn pointFixedFromBig(p: EcPoint): Result[EcPointFixed] =
    if p.inf:
        let outInf: EcPointFixed = pointInfinityFixed()
        return Ok[EcPointFixed](outInf)
    var xBig: bigint.BigInt
    p256BigSetInto(xBig, p.x)
    let xRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(xBig)
    if IsErr(xRes):
        return Err[EcPointFixed](Error(xRes))
    var yBig: bigint.BigInt
    p256BigSetInto(yBig, p.y)
    let yRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(yBig)
    if IsErr(yRes):
        return Err[EcPointFixed](Error(yRes))
    let xMontRes: Result[pfix.P256Fixed] = p256FieldFixedToMont(Value(xRes))
    if IsErr(xMontRes):
        return Err[EcPointFixed](Error(xMontRes))
    let yMontRes: Result[pfix.P256Fixed] = p256FieldFixedToMont(Value(yRes))
    if IsErr(yMontRes):
        return Err[EcPointFixed](Error(yMontRes))
    var out: EcPointFixed
    pointFixedSetCoordsInto(out, Value(xMontRes), Value(yMontRes))
    return Ok[EcPointFixed](out)

fn pointBigFromFixedInto(out: var EcPoint, p: EcPointFixed) =
    if p.inf:
        pointSetInfinityInto(out)
        return
    let xNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(p.x)
    if IsErr(xNormRes):
        Panic("ecdsa: pointBigFromFixed x fromMont failed")
    let yNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(p.y)
    if IsErr(yNormRes):
        Panic("ecdsa: pointBigFromFixed y fromMont failed")
    var x: pfix.P256Fixed = Value(xNormRes)
    var y: pfix.P256Fixed = Value(yNormRes)
    let xBig: bigint.BigInt = pfix.p256FixedToBigInt(x)
    let yBig: bigint.BigInt = pfix.p256FixedToBigInt(y)
    out.x = xBig
    out.y = yBig
    out.inf = false

fn pointBigFromFixed(p: EcPointFixed): EcPoint =
    var out: EcPoint
    pointBigFromFixedInto(out, p)
    return out

fn pointJacobianFromAffineFixed(p: EcPointFixed): EcPointJacobianFixed =
    if p.inf:
        return pointJacobianInfinityFixed()
    var out: EcPointJacobianFixed
    pointJacobianFixedSetFromAffineInto(out, p)
    return out

fn pointJacobianCopyFixed(p: EcPointJacobianFixed): EcPointJacobianFixed =
    var out: EcPointJacobianFixed
    pointJacobianFixedSetInto(out, p)
    return out

fn pointJacobianToAffineFixed(p: EcPointJacobianFixed): Result[EcPointFixed] =
    if p.inf || pfix.p256FixedIsZero(p.z):
        let outInf: EcPointFixed = pointInfinityFixed()
        return Ok[EcPointFixed](outInf)
    if p256FieldFixedIsOne(p.z):
        var outOne: EcPointFixed
        pointFixedSetCoordsInto(outOne, p.x, p.y)
        return Ok[EcPointFixed](outOne)
    let zInvRes: Result[pfix.P256Fixed] = p256FieldFixedInv(p.z)
    if IsErr(zInvRes):
        return Err[EcPointFixed](Error(zInvRes))
    let zInv: pfix.P256Fixed = Value(zInvRes)
    let zInv2: pfix.P256Fixed = p256FieldFixedSquareCrash(zInv)
    let zInvCubed: pfix.P256Fixed = p256FieldFixedMulCrash(zInv2, zInv)
    let x: pfix.P256Fixed = p256FieldFixedMulCrash(p.x, zInv2)
    let y: pfix.P256Fixed = p256FieldFixedMulCrash(p.y, zInvCubed)
    var out: EcPointFixed
    pointFixedSetCoordsInto(out, x, y)
    return Ok[EcPointFixed](out)

fn pointJacobianXToScalarBigInt(p: EcPointJacobianFixed): Result[bigint.BigInt] =
    if p.inf || pfix.p256FixedIsZero(p.z):
        return Err[bigint.BigInt]("ecdsa: jacobian point at infinity")
    var xNorm: pfix.P256Fixed
    if p256FieldFixedIsOne(p.z):
        let xNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(p.x)
        if IsErr(xNormRes):
            return Err[bigint.BigInt](Error(xNormRes))
        xNorm = Value(xNormRes)
    else:
        let zInvRes: Result[pfix.P256Fixed] = p256FieldFixedInv(p.z)
        if IsErr(zInvRes):
            return Err[bigint.BigInt](Error(zInvRes))
        let zInv2Res: Result[pfix.P256Fixed] = p256FieldFixedSquare(Value(zInvRes))
        if IsErr(zInv2Res):
            return Err[bigint.BigInt](Error(zInv2Res))
        let xMontRes: Result[pfix.P256Fixed] = p256FieldFixedMul(p.x, Value(zInv2Res))
        if IsErr(xMontRes):
            return Err[bigint.BigInt](Error(xMontRes))
        let xNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(Value(xMontRes))
        if IsErr(xNormRes):
            return Err[bigint.BigInt](Error(xNormRes))
        xNorm = Value(xNormRes)
    var reduced: pfix.P256Fixed = p256FieldFixedXReduceToScalarFixed(xNorm)
    return Ok[bigint.BigInt](pfix.p256FixedToBigInt(reduced))

fn pointJacobianXToScalarFixedCrash(p: EcPointJacobianFixed): pfix.P256Fixed =
    Assert(!(p.inf || pfix.p256FixedIsZero(p.z)), "ecdsa: jacobian point at infinity")
    var xNorm: pfix.P256Fixed
    if p256FieldFixedIsOne(p.z):
        let xNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(p.x)
        let xNormFailed: bool = IsErr(xNormRes)
        Assert(!xNormFailed, "ecdsa: x fromMont failed")
        xNorm = Value(xNormRes)
    else:
        let zInvRes: Result[pfix.P256Fixed] = p256FieldFixedInv(p.z)
        let zInvFailed: bool = IsErr(zInvRes)
        Assert(!zInvFailed, "ecdsa: z inverse failed")
        let zInv2: pfix.P256Fixed = p256FieldFixedSquareCrash(Value(zInvRes))
        let xMont: pfix.P256Fixed = p256FieldFixedMulCrash(p.x, zInv2)
        let xNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(xMont)
        let xNormFailed: bool = IsErr(xNormRes)
        Assert(!xNormFailed, "ecdsa: x normalize failed")
        xNorm = Value(xNormRes)
    return p256FieldFixedXReduceToScalarFixed(xNorm)

fn p256FieldFixedXReduceToScalarBigInt(xNorm: pfix.P256Fixed): bigint.BigInt =
    var reduced: pfix.P256Fixed = p256FieldFixedXReduceToScalarFixed(xNorm)
    return pfix.p256FixedToBigInt(reduced)

fn p256FieldFixedXReduceToScalarFixed(xNorm: pfix.P256Fixed): pfix.P256Fixed =
    var reduced: pfix.P256Fixed
    p256FixedCopyInto(reduced, xNorm)
    var nBig: bigint.BigInt = p256ConstN()
    let nModulusRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(nBig)
    let nModulusFailed: bool = IsErr(nModulusRes)
    Assert(!nModulusFailed, "ecdsa: scalar modulus fixed failed")
    var nModulus: pfix.P256Fixed = Value(nModulusRes)
    if pfix.p256FixedCmp(reduced, nModulus) >= 0:
        p256FixedCopyInto(reduced, pfix.p256FixedModSubTrusted(reduced, nModulus, nModulus))
    return reduced

fn pointJacobianDoubleFixed(p: EcPointJacobianFixed): EcPointJacobianFixed =
    if p.inf || pfix.p256FixedIsZero(p.y):
        return pointJacobianInfinityFixed()
    let delta: pfix.P256Fixed = p256FieldFixedSquareCrash(p.z)
    let gamma: pfix.P256Fixed = p256FieldFixedSquareCrash(p.y)
    let beta: pfix.P256Fixed = p256FieldFixedMulCrash(p.x, gamma)
    let xMinusDelta: pfix.P256Fixed = p256FieldFixedSubCrash(p.x, delta)
    let xPlusDelta: pfix.P256Fixed = p256FieldFixedAddCrash(p.x, delta)
    let alphaBase: pfix.P256Fixed = p256FieldFixedMulCrash(xMinusDelta, xPlusDelta)
    let alpha: pfix.P256Fixed = p256FieldFixedTripleCrash(alphaBase)
    let alpha2: pfix.P256Fixed = p256FieldFixedSquareCrash(alpha)
    let beta4: pfix.P256Fixed = p256FieldFixedQuadCrash(beta)
    let beta8: pfix.P256Fixed = p256FieldFixedDoubleCrash(beta4)
    let x3: pfix.P256Fixed = p256FieldFixedSubCrash(alpha2, beta8)
    let yPlusZ: pfix.P256Fixed = p256FieldFixedAddCrash(p.y, p.z)
    let yPlusZ2: pfix.P256Fixed = p256FieldFixedSquareCrash(yPlusZ)
    let z3a: pfix.P256Fixed = p256FieldFixedSubCrash(yPlusZ2, gamma)
    let z3: pfix.P256Fixed = p256FieldFixedSubCrash(z3a, delta)
    let gamma2: pfix.P256Fixed = p256FieldFixedSquareCrash(gamma)
    let gamma8: pfix.P256Fixed = p256FieldFixedEightCrash(gamma2)
    let beta4MinusX3: pfix.P256Fixed = p256FieldFixedSubCrash(beta4, x3)
    let y3a: pfix.P256Fixed = p256FieldFixedMulCrash(alpha, beta4MinusX3)
    let y3: pfix.P256Fixed = p256FieldFixedSubCrash(y3a, gamma8)
    var out: EcPointJacobianFixed
    pointJacobianFixedSetCoordsInto(out, x3, y3, z3)
    return out

fn pointJacobianDoubleFixedInPlace(p: var EcPointJacobianFixed) =
    if p.inf || pfix.p256FixedIsZero(p.y):
        pointJacobianSetInfinityFixed(p)
        return
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContext()
    var modulus: pfix.P256Fixed
    p256FixedCopyInto(modulus, ctx.modulus)
    var scratch: pfix.P256FixedMontgomeryScratch
    var delta: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(delta, p.z, p.z, ctx, scratch)
    var gamma: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(gamma, p.y, p.y, ctx, scratch)
    var beta: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(beta, p.x, gamma, ctx, scratch)
    var xMinusDelta: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(xMinusDelta, p.x, delta, modulus)
    var xPlusDelta: pfix.P256Fixed
    pfix.p256FixedModAddTrustedInto(xPlusDelta, p.x, delta, modulus)
    var alphaBase: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(alphaBase, xMinusDelta, xPlusDelta, ctx, scratch)
    let alpha: pfix.P256Fixed = p256FieldFixedTripleCrash(alphaBase)
    var alpha2: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(alpha2, alpha, alpha, ctx, scratch)
    let beta4: pfix.P256Fixed = p256FieldFixedQuadCrash(beta)
    let beta8: pfix.P256Fixed = p256FieldFixedDoubleCrash(beta4)
    var x3: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(x3, alpha2, beta8, modulus)
    var yPlusZ: pfix.P256Fixed
    pfix.p256FixedModAddTrustedInto(yPlusZ, p.y, p.z, modulus)
    var yPlusZ2: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(yPlusZ2, yPlusZ, yPlusZ, ctx, scratch)
    var z3a: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(z3a, yPlusZ2, gamma, modulus)
    var z3: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(z3, z3a, delta, modulus)
    var gamma2: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(gamma2, gamma, gamma, ctx, scratch)
    let gamma8: pfix.P256Fixed = p256FieldFixedEightCrash(gamma2)
    var beta4MinusX3: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(beta4MinusX3, beta4, x3, modulus)
    var y3a: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(y3a, alpha, beta4MinusX3, ctx, scratch)
    var y3: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(y3, y3a, gamma8, modulus)
    pointJacobianFixedSetCoordsInto(p, x3, y3, z3)

fn pointJacobianAddFixed(p1: EcPointJacobianFixed, p2: EcPointJacobianFixed): EcPointJacobianFixed =
    if p1.inf || pfix.p256FixedIsZero(p1.z):
        return p2
    if p2.inf || pfix.p256FixedIsZero(p2.z):
        return p1
    let z1z1: pfix.P256Fixed = p256FieldFixedSquareCrash(p1.z)
    let z2z2: pfix.P256Fixed = p256FieldFixedSquareCrash(p2.z)
    let u1: pfix.P256Fixed = p256FieldFixedMulCrash(p1.x, z2z2)
    let u2: pfix.P256Fixed = p256FieldFixedMulCrash(p2.x, z1z1)
    let z1Cubed: pfix.P256Fixed = p256FieldFixedMulCrash(p1.z, z1z1)
    let z2Cubed: pfix.P256Fixed = p256FieldFixedMulCrash(p2.z, z2z2)
    let s1: pfix.P256Fixed = p256FieldFixedMulCrash(p1.y, z2Cubed)
    let s2: pfix.P256Fixed = p256FieldFixedMulCrash(p2.y, z1Cubed)
    if pfix.p256FixedCmp(u1, u2) == 0:
        if pfix.p256FixedCmp(s1, s2) != 0:
            return pointJacobianInfinityFixed()
        return pointJacobianDoubleFixed(p1)
    let h: pfix.P256Fixed = p256FieldFixedSubCrash(u2, u1)
    let twoH: pfix.P256Fixed = p256FieldFixedDoubleCrash(h)
    let i: pfix.P256Fixed = p256FieldFixedSquareCrash(twoH)
    let j: pfix.P256Fixed = p256FieldFixedMulCrash(h, i)
    let sDiff: pfix.P256Fixed = p256FieldFixedSubCrash(s2, s1)
    let r: pfix.P256Fixed = p256FieldFixedDoubleCrash(sDiff)
    let v: pfix.P256Fixed = p256FieldFixedMulCrash(u1, i)
    let r2: pfix.P256Fixed = p256FieldFixedSquareCrash(r)
    let twoV: pfix.P256Fixed = p256FieldFixedDoubleCrash(v)
    let x3a: pfix.P256Fixed = p256FieldFixedSubCrash(r2, j)
    let x3: pfix.P256Fixed = p256FieldFixedSubCrash(x3a, twoV)
    let vMinusX3: pfix.P256Fixed = p256FieldFixedSubCrash(v, x3)
    let s1j: pfix.P256Fixed = p256FieldFixedMulCrash(s1, j)
    let twoS1J: pfix.P256Fixed = p256FieldFixedDoubleCrash(s1j)
    let y3a: pfix.P256Fixed = p256FieldFixedMulCrash(r, vMinusX3)
    let y3: pfix.P256Fixed = p256FieldFixedSubCrash(y3a, twoS1J)
    let z1PlusZ2: pfix.P256Fixed = p256FieldFixedAddCrash(p1.z, p2.z)
    let z1PlusZ2Sq: pfix.P256Fixed = p256FieldFixedSquareCrash(z1PlusZ2)
    let z3a: pfix.P256Fixed = p256FieldFixedSubCrash(z1PlusZ2Sq, z1z1)
    let z3b: pfix.P256Fixed = p256FieldFixedSubCrash(z3a, z2z2)
    let z3: pfix.P256Fixed = p256FieldFixedMulCrash(z3b, h)
    var out: EcPointJacobianFixed
    pointJacobianFixedSetCoordsInto(out, x3, y3, z3)
    return out

fn pointJacobianAddAffineFixed(p1: EcPointJacobianFixed, p2: EcPointFixed): EcPointJacobianFixed =
    if p2.inf:
        return p1
    if p1.inf || pfix.p256FixedIsZero(p1.z):
        return pointJacobianFromAffineFixed(p2)
    let z1z1: pfix.P256Fixed = p256FieldFixedSquareCrash(p1.z)
    let u2: pfix.P256Fixed = p256FieldFixedMulCrash(p2.x, z1z1)
    let z1Cubed: pfix.P256Fixed = p256FieldFixedMulCrash(p1.z, z1z1)
    let s2: pfix.P256Fixed = p256FieldFixedMulCrash(p2.y, z1Cubed)
    if pfix.p256FixedCmp(p1.x, u2) == 0:
        if pfix.p256FixedCmp(p1.y, s2) != 0:
            return pointJacobianInfinityFixed()
        return pointJacobianDoubleFixed(p1)
    let h: pfix.P256Fixed = p256FieldFixedSubCrash(u2, p1.x)
    let hh: pfix.P256Fixed = p256FieldFixedSquareCrash(h)
    let i: pfix.P256Fixed = p256FieldFixedQuadCrash(hh)
    let j: pfix.P256Fixed = p256FieldFixedMulCrash(h, i)
    let yDiff: pfix.P256Fixed = p256FieldFixedSubCrash(s2, p1.y)
    let r: pfix.P256Fixed = p256FieldFixedDoubleCrash(yDiff)
    let v: pfix.P256Fixed = p256FieldFixedMulCrash(p1.x, i)
    let r2: pfix.P256Fixed = p256FieldFixedSquareCrash(r)
    let twoV: pfix.P256Fixed = p256FieldFixedDoubleCrash(v)
    let x3a: pfix.P256Fixed = p256FieldFixedSubCrash(r2, j)
    let x3: pfix.P256Fixed = p256FieldFixedSubCrash(x3a, twoV)
    let vMinusX3: pfix.P256Fixed = p256FieldFixedSubCrash(v, x3)
    let y1j: pfix.P256Fixed = p256FieldFixedMulCrash(p1.y, j)
    let twoY1J: pfix.P256Fixed = p256FieldFixedDoubleCrash(y1j)
    let y3a: pfix.P256Fixed = p256FieldFixedMulCrash(r, vMinusX3)
    let y3: pfix.P256Fixed = p256FieldFixedSubCrash(y3a, twoY1J)
    let z1PlusH: pfix.P256Fixed = p256FieldFixedAddCrash(p1.z, h)
    let z1PlusHSq: pfix.P256Fixed = p256FieldFixedSquareCrash(z1PlusH)
    let z3a: pfix.P256Fixed = p256FieldFixedSubCrash(z1PlusHSq, z1z1)
    let z3: pfix.P256Fixed = p256FieldFixedSubCrash(z3a, hh)
    var out: EcPointJacobianFixed
    pointJacobianFixedSetCoordsInto(out, x3, y3, z3)
    return out

fn pointJacobianAddAffineFixedInPlace(p1: var EcPointJacobianFixed, p2: EcPointFixed) =
    if p2.inf:
        return
    if p1.inf || pfix.p256FixedIsZero(p1.z):
        pointJacobianSetFromAffineFixed(p1, p2)
        return
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256FieldMontgomeryContext()
    var modulus: pfix.P256Fixed
    p256FixedCopyInto(modulus, ctx.modulus)
    var scratch: pfix.P256FixedMontgomeryScratch
    var z1z1: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(z1z1, p1.z, p1.z, ctx, scratch)
    var u2: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(u2, p2.x, z1z1, ctx, scratch)
    var z1Cubed: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(z1Cubed, p1.z, z1z1, ctx, scratch)
    var s2: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(s2, p2.y, z1Cubed, ctx, scratch)
    if pfix.p256FixedCmp(p1.x, u2) == 0:
        if pfix.p256FixedCmp(p1.y, s2) != 0:
            pointJacobianSetInfinityFixed(p1)
            return
        pointJacobianDoubleFixedInPlace(p1)
        return
    var h: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(h, u2, p1.x, modulus)
    var hh: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(hh, h, h, ctx, scratch)
    let i: pfix.P256Fixed = p256FieldFixedQuadCrash(hh)
    var j: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(j, h, i, ctx, scratch)
    let yDiff: pfix.P256Fixed = p256FieldFixedSubCrash(s2, p1.y)
    let r: pfix.P256Fixed = p256FieldFixedDoubleCrash(yDiff)
    var v: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(v, p1.x, i, ctx, scratch)
    var r2: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(r2, r, r, ctx, scratch)
    let twoV: pfix.P256Fixed = p256FieldFixedDoubleCrash(v)
    var x3a: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(x3a, r2, j, modulus)
    var x3: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(x3, x3a, twoV, modulus)
    var vMinusX3: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(vMinusX3, v, x3, modulus)
    var y1j: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(y1j, p1.y, j, ctx, scratch)
    let twoY1J: pfix.P256Fixed = p256FieldFixedDoubleCrash(y1j)
    var y3a: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(y3a, r, vMinusX3, ctx, scratch)
    var y3: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(y3, y3a, twoY1J, modulus)
    var z1PlusH: pfix.P256Fixed
    pfix.p256FixedModAddTrustedInto(z1PlusH, p1.z, h, modulus)
    var z1PlusHSq: pfix.P256Fixed
    pfix.p256FixedMontgomeryMulCoreTrustedScratchInto(z1PlusHSq, z1PlusH, z1PlusH, ctx, scratch)
    var z3a: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(z3a, z1PlusHSq, z1z1, modulus)
    var z3: pfix.P256Fixed
    pfix.p256FixedModSubTrustedInto(z3, z3a, hh, modulus)
    pointJacobianFixedSetCoordsInto(p1, x3, y3, z3)

fn p256FixedWindowNibble(scalar: pfix.P256Fixed, baseBit: int32): int32 =
    var out: int32
    var shift: int32
    for shift in shift..<4:
        out = out | (pfix.p256FixedGetBit(scalar, baseBit + shift) << shift)
    return out

fn pointJacobianBatchToAffineWindow16Into(table: EcPointJacobianFixed[16],
                                         outTable: var EcPointFixed[16]): Result[bool] =
    pointFixedSetInfinityInto(outTable[0])
    var i: int32 = 1
    for i in i..<16:
        if table[i].inf:
            pointFixedSetInfinityInto(outTable[i])
            continue
        let ziInvRes: Result[pfix.P256Fixed] = p256FieldFixedInv(table[i].z)
        if IsErr(ziInvRes):
            return Err[bool](Error(ziInvRes))
        let ziInv: pfix.P256Fixed = Value(ziInvRes)
        let ziInv2Res: Result[pfix.P256Fixed] = p256FieldFixedSquare(ziInv)
        if IsErr(ziInv2Res):
            return Err[bool](Error(ziInv2Res))
        let ziInv2: pfix.P256Fixed = Value(ziInv2Res)
        let ziInvCubedRes: Result[pfix.P256Fixed] = p256FieldFixedMul(ziInv2, ziInv)
        if IsErr(ziInvCubedRes):
            return Err[bool](Error(ziInvCubedRes))
        let ziInvCubed: pfix.P256Fixed = Value(ziInvCubedRes)
        let xRes: Result[pfix.P256Fixed] = p256FieldFixedMul(table[i].x, ziInv2)
        if IsErr(xRes):
            return Err[bool](Error(xRes))
        let yRes: Result[pfix.P256Fixed] = p256FieldFixedMul(table[i].y, ziInvCubed)
        if IsErr(yRes):
            return Err[bool](Error(yRes))
        pointFixedSetCoordsInto(outTable[i], Value(xRes), Value(yRes))
    i = 16
    for i in i..<16:
        pointFixedSetInfinityInto(outTable[i])
    return Ok[bool](true)

@borrows
fn pointMulFixedWindowedFromBit(result: EcPointJacobianFixed,
                                  scalar: pfix.P256Fixed,
                                  p: EcPointFixed,
                                  bit: int32): Result[EcPointFixed] =
    if bit < 0:
        return pointJacobianToAffineFixed(result)
    let doubled = PointJacobianDoubleFixed(result)
    if pfix.p256FixedGetBit(scalar, bit) != 0:
        return pointMulFixedWindowedFromBit(pointJacobianAddAffineFixed(doubled, p),
                                              scalar,
                                              p,
                                              bit - 1)
    return pointMulFixedWindowedFromBit(doubled, scalar, p, bit - 1)

fn pointMulFixedWindowed(scalar: pfix.P256Fixed, p: EcPointFixed): Result[EcPointFixed] =
    var inf: EcPointJacobianFixed
    pointJacobianSetInfinityFixed(inf)
    return pointMulFixedWindowedFromBit(inf, scalar, p, 255)

fn pointMulGeneratorAndFixedShamir(u1: pfix.P256Fixed, u2: pfix.P256Fixed, p: EcPointFixed): Result[EcPointJacobianFixed] =
    if p.inf:
        return Err[EcPointJacobianFixed]("ecdsa: verify public point at infinity")
    let genRes: Result[EcPointFixed] = pointMulGeneratorComb6Fixed(u1)
    if IsErr(genRes):
        return Err[EcPointJacobianFixed](Error(genRes))
    let fixedRes: Result[EcPointFixed] = pointMulFixedWindowed(u2, p)
    if IsErr(fixedRes):
        return Err[EcPointJacobianFixed](Error(fixedRes))
    var result: EcPointJacobianFixed = pointJacobianFromAffineFixed(Value(genRes))
    pointJacobianAddAffineFixedInPlace(result, Value(fixedRes))
    if result.inf || pfix.p256FixedIsZero(result.z):
        return Err[EcPointJacobianFixed]("ecdsa: verify result at infinity")
    return Ok[EcPointJacobianFixed](result)

fn pointAffineNegateFixed(p: EcPointFixed): Result[EcPointFixed] =
    if p.inf:
        var outInf: EcPointFixed
        pointFixedSetInto(outInf, p)
        return Ok[EcPointFixed](outInf)
    let yNegRes: Result[pfix.P256Fixed] = p256FieldFixedSub(pfix.P256Fixed(), p.y)
    if IsErr(yNegRes):
        return Err[EcPointFixed](Error(yNegRes))
    var out: EcPointFixed
    pointFixedSetCoordsInto(out, p.x, Value(yNegRes))
    return Ok[EcPointFixed](out)

fn pointMulGeneratorWnaf(k: bigint.BigInt): Result[EcPointFixed] =
    let initRes: Result[bool] = p256EnsureFixedInit()
    if IsErr(initRes):
        return Err[EcPointFixed](Error(initRes))
    var scalarBig: bigint.BigInt = k
    let scalarRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(scalarBig)
    if IsErr(scalarRes):
        return Err[EcPointFixed](Error(scalarRes))
    return pointMulGeneratorWnafFixed(Value(scalarRes))

fn p256WnafReduceOddInto(work: var pfix.P256Fixed, digit: int32) =
    var nextWork: pfix.P256Fixed
    if digit > 0:
        p256FixedCopyInto(nextWork, p256ScalarFixedSubSmall(work, digit))
    else:
        p256FixedCopyInto(nextWork, p256ScalarFixedAddSmall(work, -digit))
    p256FixedCopyInto(work, nextWork)

fn p256WnafShiftRight1Into(work: var pfix.P256Fixed) =
    var nextWork: pfix.P256Fixed
    p256FixedCopyInto(nextWork, p256ScalarFixedShiftRight1(work))
    p256FixedCopyInto(work, nextWork)

fn p256WnafCollectDigits(k: pfix.P256Fixed, digitCount: var int32, digits: var int32[260]) =
    var work: pfix.P256Fixed
    p256FixedCopyInto(work, k)
    while ! p256ScalarFixedIsZero(work):
        var digit: int32
        if p256ScalarFixedIsOdd(work):
            digit = p256ScalarFixedLow5(work)
            if digit > 16:
                digit = digit - 32
            p256WnafReduceOddInto(work, digit)
        digits[digitCount] = digit
        digitCount = digitCount + 1
        p256WnafShiftRight1Into(work)

fn p256WnafAccumulate(digits: int32[260], digitCount: int32, result: var EcPointJacobianFixed) =
    pointJacobianSetInfinityFixed(result)
    let iStart = digitCount - 1
    for iOffset in 0..iStart:
        let i = iStart - iOffset
        pointJacobianDoubleFixedInPlace(result)
        let digit: int32 = digits[i]
        if digit > 0:
            let addPoint: EcPointFixed = p256GeneratorWindow4Point(digit)
            pointJacobianAddAffineFixedInPlace(result, addPoint)
        elif digit < 0:
            let addNegPoint: EcPointFixed = p256GeneratorWindow4NegPoint(-digit)
            pointJacobianAddAffineFixedInPlace(result, addNegPoint)

fn pointMulGeneratorJacobianWnafFixed(k: pfix.P256Fixed): EcPointJacobianFixed =
    var digits: int32[260]
    var digitCount: int32
    p256WnafCollectDigits(k, digitCount, digits)
    var result: EcPointJacobianFixed
    p256WnafAccumulate(digits, digitCount, result)
    return result

fn pointMulGeneratorJacobianComb6FixedInto(result: var EcPointJacobianFixed, k: pfix.P256Fixed) =
    pointJacobianSetInfinityFixed(result)
    var started: bool
    let rowStart = p256GeneratorComb6Depth - 1
    for rowOffset in 0..rowStart:
        let row = rowStart - rowOffset
        let digit: int32 = p256ScalarFixedComb6Digit(k, row)
        if ! started:
            if digit == 0:
                continue
            let firstPoint: EcPointFixed = p256GeneratorComb6Point(digit)
            pointJacobianSetFromAffineFixed(result, firstPoint)
            started = true
            continue
        pointJacobianDoubleFixedInPlace(result)
        if digit != 0:
            let addPoint: EcPointFixed = p256GeneratorComb6Point(digit)
            pointJacobianAddAffineFixedInPlace(result, addPoint)

fn pointMulGeneratorWnafFixed(k: pfix.P256Fixed): Result[EcPointFixed] =
    var result: EcPointJacobianFixed
    pointJacobianFixedSetInto(result, pointMulGeneratorJacobianWnafFixed(k))
    let affineRes: Result[EcPointFixed] = pointJacobianToAffineFixed(result)
    if IsErr(affineRes):
        return Err[EcPointFixed](Error(affineRes))
    let affine: EcPointFixed = Value(affineRes)
    return Ok[EcPointFixed](affine)

# Comb-6 fixed-window generator multiply (43 doublings vs the wNAF's 256).
# Byte-identical affine result to pointMulGeneratorWnafFixed (verified across
# the ECDSA vectors); used on the verify hot path where the sign path already
# routes k*G through the comb table via pointMulGeneratorRFixedBig.
fn pointMulGeneratorComb6Fixed(k: pfix.P256Fixed): Result[EcPointFixed] =
    var result: EcPointJacobianFixed
    pointMulGeneratorJacobianComb6FixedInto(result, k)
    let affineRes: Result[EcPointFixed] = pointJacobianToAffineFixed(result)
    if IsErr(affineRes):
        return Err[EcPointFixed](Error(affineRes))
    let affine: EcPointFixed = Value(affineRes)
    return Ok[EcPointFixed](affine)

fn pointDoubleCoordsInto(outX: var bigint.BigInt,
                         outY: var bigint.BigInt,
                         x: bigint.BigInt,
                         y: bigint.BigInt): Result[bool] =
    if bigint.bigIsZero(y):
        return Ok[bool](true)
    let x2Res: Result[bigint.BigInt] = p256ModMul(x, x)
    if IsErr(x2Res):
        return Err[bool](Error(x2Res))
    let dblRes: Result[bigint.BigInt] = p256ModAdd(Value(x2Res), Value(x2Res))
    if IsErr(dblRes):
        return Err[bool](Error(dblRes))
    let tripleRes: Result[bigint.BigInt] = p256ModAdd(Value(dblRes), Value(x2Res))
    if IsErr(tripleRes):
        return Err[bool](Error(tripleRes))
    let fieldModulus: bigint.BigInt = p256ConstP()
    let three: bigint.BigInt = bigint.bigFromInt(3)
    let aRes: Result[bigint.BigInt] = bigint.bigSub(fieldModulus, three)
    if IsErr(aRes):
        return Err[bool](Error(aRes))
    let numRes: Result[bigint.BigInt] = p256ModAdd(Value(tripleRes), Value(aRes))
    if IsErr(numRes):
        return Err[bool](Error(numRes))
    let denomRes: Result[bigint.BigInt] = p256ModAdd(y, y)
    if IsErr(denomRes):
        return Err[bool](Error(denomRes))
    let invRes: Result[bigint.BigInt] = p256ModInv(Value(denomRes))
    if IsErr(invRes):
        return Err[bool](Error(invRes))
    let lambdaRes: Result[bigint.BigInt] = p256ModMul(Value(numRes), Value(invRes))
    if IsErr(lambdaRes):
        return Err[bool](Error(lambdaRes))
    let lambda: bigint.BigInt = Value(lambdaRes)
    let lambda2Res: Result[bigint.BigInt] = p256ModMul(lambda, lambda)
    if IsErr(lambda2Res):
        return Err[bool](Error(lambda2Res))
    let twoXRes: Result[bigint.BigInt] = p256ModAdd(x, x)
    if IsErr(twoXRes):
        return Err[bool](Error(twoXRes))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(lambda2Res), Value(twoXRes))
    if IsErr(x3Res):
        return Err[bool](Error(x3Res))
    let x1MinusX3Res: Result[bigint.BigInt] = p256ModSub(x, Value(x3Res))
    if IsErr(x1MinusX3Res):
        return Err[bool](Error(x1MinusX3Res))
    let y3Res1: Result[bigint.BigInt] = p256ModMul(lambda, Value(x1MinusX3Res))
    if IsErr(y3Res1):
        return Err[bool](Error(y3Res1))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3Res1), y)
    if IsErr(y3Res):
        return Err[bool](Error(y3Res))
    p256BigSetInto(outX, Value(x3Res))
    p256BigSetInto(outY, Value(y3Res))
    return Ok[bool](false)

fn pointAddCoordsInto(outX: var bigint.BigInt,
                      outY: var bigint.BigInt,
                      x1: bigint.BigInt,
                      y1: bigint.BigInt,
                      x2: bigint.BigInt,
                      y2: bigint.BigInt): Result[bool] =
    if bigint.bigCmp(x1, x2) == 0:
        let sumRes: Result[bigint.BigInt] = p256ModAdd(y1, y2)
        if IsErr(sumRes):
            return Err[bool](Error(sumRes))
        if bigint.bigIsZero(Value(sumRes)):
            return Ok[bool](true)
        return pointDoubleCoordsInto(outX, outY, x1, y1)
    let dyRes: Result[bigint.BigInt] = p256ModSub(y2, y1)
    if IsErr(dyRes):
        return Err[bool](Error(dyRes))
    let dxRes: Result[bigint.BigInt] = p256ModSub(x2, x1)
    if IsErr(dxRes):
        return Err[bool](Error(dxRes))
    let invRes: Result[bigint.BigInt] = p256ModInv(Value(dxRes))
    if IsErr(invRes):
        return Err[bool](Error(invRes))
    let lambdaRes: Result[bigint.BigInt] = p256ModMul(Value(dyRes), Value(invRes))
    if IsErr(lambdaRes):
        return Err[bool](Error(lambdaRes))
    let lambda: bigint.BigInt = Value(lambdaRes)
    let lambda2Res: Result[bigint.BigInt] = p256ModMul(lambda, lambda)
    if IsErr(lambda2Res):
        return Err[bool](Error(lambda2Res))
    let x3Res1: Result[bigint.BigInt] = p256ModSub(Value(lambda2Res), x1)
    if IsErr(x3Res1):
        return Err[bool](Error(x3Res1))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(x3Res1), x2)
    if IsErr(x3Res):
        return Err[bool](Error(x3Res))
    let x1MinusX3Res: Result[bigint.BigInt] = p256ModSub(x1, Value(x3Res))
    if IsErr(x1MinusX3Res):
        return Err[bool](Error(x1MinusX3Res))
    let y3Res1: Result[bigint.BigInt] = p256ModMul(lambda, Value(x1MinusX3Res))
    if IsErr(y3Res1):
        return Err[bool](Error(y3Res1))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3Res1), y1)
    if IsErr(y3Res):
        return Err[bool](Error(y3Res))
    p256BigSetInto(outX, Value(x3Res))
    p256BigSetInto(outY, Value(y3Res))
    return Ok[bool](false)

fn p256FieldAddInto(out: var bigint.BigInt, a: bigint.BigInt, b: bigint.BigInt): Result[bool] =
    let res: Result[bigint.BigInt] = p256ModAdd(a, b)
    if IsErr(res):
        return Err[bool](Error(res))
    p256BigSetInto(out, Value(res))
    return Ok[bool](true)

fn p256FieldSubInto(out: var bigint.BigInt, a: bigint.BigInt, b: bigint.BigInt): Result[bool] =
    let res: Result[bigint.BigInt] = p256ModSub(a, b)
    if IsErr(res):
        return Err[bool](Error(res))
    p256BigSetInto(out, Value(res))
    return Ok[bool](true)

fn p256FieldMulInto(out: var bigint.BigInt, a: bigint.BigInt, b: bigint.BigInt): Result[bool] =
    var left: bigint.BigInt = a
    var right: bigint.BigInt = b
    return p256ModMulInto(out, left, right)

fn p256FieldDoubleInto(out: var bigint.BigInt, a: bigint.BigInt): Result[bool] =
    return p256FieldAddInto(out, a, a)

fn p256FieldTripleInto(out: var bigint.BigInt, a: bigint.BigInt): Result[bool] =
    var doubled: bigint.BigInt
    let dblRes: Result[bool] = p256FieldDoubleInto(doubled, a)
    if IsErr(dblRes):
        return Err[bool](Error(dblRes))
    return p256FieldAddInto(out, doubled, a)

fn p256FieldQuadInto(out: var bigint.BigInt, a: bigint.BigInt): Result[bool] =
    var doubled: bigint.BigInt
    let dblRes: Result[bool] = p256FieldDoubleInto(doubled, a)
    if IsErr(dblRes):
        return Err[bool](Error(dblRes))
    return p256FieldDoubleInto(out, doubled)

fn p256FieldEightInto(out: var bigint.BigInt, a: bigint.BigInt): Result[bool] =
    var quad: bigint.BigInt
    let quadRes: Result[bool] = p256FieldQuadInto(quad, a)
    if IsErr(quadRes):
        return Err[bool](Error(quadRes))
    return p256FieldDoubleInto(out, quad)

fn pointJacobianDoubleCoordsInto(outX: var bigint.BigInt,
                                 outY: var bigint.BigInt,
                                 outZ: var bigint.BigInt,
                                 x: bigint.BigInt,
                                 y: bigint.BigInt,
                                 z: bigint.BigInt): Result[bool] =
    if bigint.bigIsZero(y) || bigint.bigIsZero(z):
        return Ok[bool](true)
    var step: Result[bool]
    var delta: bigint.BigInt
    step = p256FieldMulInto(delta, z, z)
    if IsErr(step):
        return Err[bool](Error(step))
    var gamma: bigint.BigInt
    step = p256FieldMulInto(gamma, y, y)
    if IsErr(step):
        return Err[bool](Error(step))
    var beta: bigint.BigInt
    step = p256FieldMulInto(beta, x, gamma)
    if IsErr(step):
        return Err[bool](Error(step))
    var xMinusDelta: bigint.BigInt
    step = p256FieldSubInto(xMinusDelta, x, delta)
    if IsErr(step):
        return Err[bool](Error(step))
    var xPlusDelta: bigint.BigInt
    step = p256FieldAddInto(xPlusDelta, x, delta)
    if IsErr(step):
        return Err[bool](Error(step))
    var alpha: bigint.BigInt
    step = p256FieldMulInto(alpha, xMinusDelta, xPlusDelta)
    if IsErr(step):
        return Err[bool](Error(step))
    step = p256FieldTripleInto(alpha, alpha)
    if IsErr(step):
        return Err[bool](Error(step))
    var alpha2: bigint.BigInt
    step = p256FieldMulInto(alpha2, alpha, alpha)
    if IsErr(step):
        return Err[bool](Error(step))
    var beta4: bigint.BigInt
    step = p256FieldQuadInto(beta4, beta)
    if IsErr(step):
        return Err[bool](Error(step))
    var beta8: bigint.BigInt
    step = p256FieldDoubleInto(beta8, beta4)
    if IsErr(step):
        return Err[bool](Error(step))
    var x3: bigint.BigInt
    step = p256FieldSubInto(x3, alpha2, beta8)
    if IsErr(step):
        return Err[bool](Error(step))
    var yPlusZ: bigint.BigInt
    step = p256FieldAddInto(yPlusZ, y, z)
    if IsErr(step):
        return Err[bool](Error(step))
    var yPlusZ2: bigint.BigInt
    step = p256FieldMulInto(yPlusZ2, yPlusZ, yPlusZ)
    if IsErr(step):
        return Err[bool](Error(step))
    var gamma2: bigint.BigInt
    step = p256FieldMulInto(gamma2, gamma, gamma)
    if IsErr(step):
        return Err[bool](Error(step))
    var gamma8: bigint.BigInt
    step = p256FieldEightInto(gamma8, gamma2)
    if IsErr(step):
        return Err[bool](Error(step))
    var beta4MinusX3: bigint.BigInt
    step = p256FieldSubInto(beta4MinusX3, beta4, x3)
    if IsErr(step):
        return Err[bool](Error(step))
    var y3a: bigint.BigInt
    step = p256FieldMulInto(y3a, alpha, beta4MinusX3)
    if IsErr(step):
        return Err[bool](Error(step))
    var y3: bigint.BigInt
    step = p256FieldSubInto(y3, y3a, gamma8)
    if IsErr(step):
        return Err[bool](Error(step))
    var z3a: bigint.BigInt
    step = p256FieldSubInto(z3a, yPlusZ2, gamma)
    if IsErr(step):
        return Err[bool](Error(step))
    var z3: bigint.BigInt
    step = p256FieldSubInto(z3, z3a, delta)
    if IsErr(step):
        return Err[bool](Error(step))
    p256BigSetInto(outX, x3)
    p256BigSetInto(outY, y3)
    p256BigSetInto(outZ, z3)
    return Ok[bool](false)

fn pointJacobianAddAffineCoordsInto(outX: var bigint.BigInt,
                                    outY: var bigint.BigInt,
                                    outZ: var bigint.BigInt,
                                    x1: bigint.BigInt,
                                    y1: bigint.BigInt,
                                    z1: bigint.BigInt,
                                    x2: bigint.BigInt,
                                    y2: bigint.BigInt): Result[bool] =
    if bigint.bigIsZero(z1):
        return Ok[bool](true)
    var step: Result[bool]
    var z1z1: bigint.BigInt
    step = p256FieldMulInto(z1z1, z1, z1)
    if IsErr(step):
        return Err[bool](Error(step))
    var u2: bigint.BigInt
    step = p256FieldMulInto(u2, x2, z1z1)
    if IsErr(step):
        return Err[bool](Error(step))
    var z1Cubed: bigint.BigInt
    step = p256FieldMulInto(z1Cubed, z1, z1z1)
    if IsErr(step):
        return Err[bool](Error(step))
    var s2: bigint.BigInt
    step = p256FieldMulInto(s2, y2, z1Cubed)
    if IsErr(step):
        return Err[bool](Error(step))
    if bigint.bigCmp(x1, u2) == 0:
        if bigint.bigCmp(y1, s2) != 0:
            return Ok[bool](true)
        return pointJacobianDoubleCoordsInto(outX, outY, outZ, x1, y1, z1)
    var h: bigint.BigInt
    step = p256FieldSubInto(h, u2, x1)
    if IsErr(step):
        return Err[bool](Error(step))
    var hh: bigint.BigInt
    step = p256FieldMulInto(hh, h, h)
    if IsErr(step):
        return Err[bool](Error(step))
    var iVal: bigint.BigInt
    step = p256FieldQuadInto(iVal, hh)
    if IsErr(step):
        return Err[bool](Error(step))
    var j: bigint.BigInt
    step = p256FieldMulInto(j, h, iVal)
    if IsErr(step):
        return Err[bool](Error(step))
    var yDiff: bigint.BigInt
    step = p256FieldSubInto(yDiff, s2, y1)
    if IsErr(step):
        return Err[bool](Error(step))
    var r: bigint.BigInt
    step = p256FieldDoubleInto(r, yDiff)
    if IsErr(step):
        return Err[bool](Error(step))
    var v: bigint.BigInt
    step = p256FieldMulInto(v, x1, iVal)
    if IsErr(step):
        return Err[bool](Error(step))
    var r2: bigint.BigInt
    step = p256FieldMulInto(r2, r, r)
    if IsErr(step):
        return Err[bool](Error(step))
    var twoV: bigint.BigInt
    step = p256FieldDoubleInto(twoV, v)
    if IsErr(step):
        return Err[bool](Error(step))
    var x3a: bigint.BigInt
    step = p256FieldSubInto(x3a, r2, j)
    if IsErr(step):
        return Err[bool](Error(step))
    var x3: bigint.BigInt
    step = p256FieldSubInto(x3, x3a, twoV)
    if IsErr(step):
        return Err[bool](Error(step))
    var vMinusX3: bigint.BigInt
    step = p256FieldSubInto(vMinusX3, v, x3)
    if IsErr(step):
        return Err[bool](Error(step))
    var y1j: bigint.BigInt
    step = p256FieldMulInto(y1j, y1, j)
    if IsErr(step):
        return Err[bool](Error(step))
    var twoY1J: bigint.BigInt
    step = p256FieldDoubleInto(twoY1J, y1j)
    if IsErr(step):
        return Err[bool](Error(step))
    var y3a: bigint.BigInt
    step = p256FieldMulInto(y3a, r, vMinusX3)
    if IsErr(step):
        return Err[bool](Error(step))
    var y3: bigint.BigInt
    step = p256FieldSubInto(y3, y3a, twoY1J)
    if IsErr(step):
        return Err[bool](Error(step))
    var z1PlusH: bigint.BigInt
    step = p256FieldAddInto(z1PlusH, z1, h)
    if IsErr(step):
        return Err[bool](Error(step))
    var z1PlusHSq: bigint.BigInt
    step = p256FieldMulInto(z1PlusHSq, z1PlusH, z1PlusH)
    if IsErr(step):
        return Err[bool](Error(step))
    var z3a: bigint.BigInt
    step = p256FieldSubInto(z3a, z1PlusHSq, z1z1)
    if IsErr(step):
        return Err[bool](Error(step))
    var z3: bigint.BigInt
    step = p256FieldSubInto(z3, z3a, hh)
    if IsErr(step):
        return Err[bool](Error(step))
    p256BigSetInto(outX, x3)
    p256BigSetInto(outY, y3)
    p256BigSetInto(outZ, z3)
    return Ok[bool](false)

fn pointMulGeneratorR(k: bigint.BigInt): Result[bigint.BigInt] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bigint.BigInt](Error(initRes))
    if bigint.bigIsZero(k):
        return Err[bigint.BigInt]("ecdsa: generator result at infinity")
    let modulus: bigint.BigInt = p256ConstN()
    if bigint.bigCmp(k, modulus) >= 0:
        return Err[bigint.BigInt]("ecdsa: scalar out of range")
    var gx: bigint.BigInt
    var gy: bigint.BigInt
    var one: bigint.BigInt = bigint.bigFromInt(1)
    p256ConstGxInto(gx)
    p256ConstGyInto(gy)
    var resultInf: bool = true
    var resultX: bigint.BigInt
    var resultY: bigint.BigInt
    var resultZ: bigint.BigInt
    let bitLen: int32 = bigint.bigBitLen(k)
    let bitStart: int32 = bitLen - 1
    for bitOffset in 0..bitStart:
        let bitIdx: int32 = bitStart - bitOffset
        if ! resultInf:
            var doubledX: bigint.BigInt
            var doubledY: bigint.BigInt
            var doubledZ: bigint.BigInt
            let dblRes: Result[bool] = pointJacobianDoubleCoordsInto(doubledX, doubledY, doubledZ, resultX, resultY, resultZ)
            if IsErr(dblRes):
                return Err[bigint.BigInt](Error(dblRes))
            resultInf = Value(dblRes)
            if ! resultInf:
                p256BigSetInto(resultX, doubledX)
                p256BigSetInto(resultY, doubledY)
                p256BigSetInto(resultZ, doubledZ)
        if bigint.bigGetBit(k, bitIdx) != 0:
            if resultInf:
                p256BigSetInto(resultX, gx)
                p256BigSetInto(resultY, gy)
                p256BigSetInto(resultZ, one)
                resultInf = false
            else:
                var addedX: bigint.BigInt
                var addedY: bigint.BigInt
                var addedZ: bigint.BigInt
                let addRes: Result[bool] = pointJacobianAddAffineCoordsInto(addedX, addedY, addedZ, resultX, resultY, resultZ, gx, gy)
                if IsErr(addRes):
                    return Err[bigint.BigInt](Error(addRes))
                resultInf = Value(addRes)
                if ! resultInf:
                    p256BigSetInto(resultX, addedX)
                    p256BigSetInto(resultY, addedY)
                    p256BigSetInto(resultZ, addedZ)
    if resultInf || bigint.bigIsZero(resultZ):
        return Err[bigint.BigInt]("ecdsa: generator result at infinity")
    if bigint.bigCmp(resultZ, one) == 0:
        return nMod(resultX)
    let zInvRes: Result[bigint.BigInt] = p256ModInv(resultZ)
    if IsErr(zInvRes):
        return Err[bigint.BigInt](Error(zInvRes))
    let zInv2Res: Result[bigint.BigInt] = p256ModMul(Value(zInvRes), Value(zInvRes))
    if IsErr(zInv2Res):
        return Err[bigint.BigInt](Error(zInv2Res))
    let xAffineRes: Result[bigint.BigInt] = p256ModMul(resultX, Value(zInv2Res))
    if IsErr(xAffineRes):
        return Err[bigint.BigInt](Error(xAffineRes))
    return nMod(Value(xAffineRes))

fn ecdsaVerifyShamirXBig(u1: var bigint.BigInt,
                         u2: var bigint.BigInt,
                         pubX: var bigint.BigInt,
                         pubY: var bigint.BigInt): Result[bigint.BigInt] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bigint.BigInt](Error(initRes))
    if bigint.bigIsZero(pubX) || bigint.bigIsZero(pubY):
        return Err[bigint.BigInt]("ecdsa: invalid public point")
    var gx: bigint.BigInt
    var gy: bigint.BigInt
    var one: bigint.BigInt = bigint.bigFromInt(1)
    p256ConstGxInto(gx)
    p256ConstGyInto(gy)
    var resultInf: bool = true
    var resultX: bigint.BigInt
    var resultY: bigint.BigInt
    var resultZ: bigint.BigInt
    let u1Bits: int32 = bigint.bigBitLen(u1)
    let u2Bits: int32 = bigint.bigBitLen(u2)
    let maxBits: int32 = if u1Bits > u2Bits: u1Bits else: u2Bits
    if maxBits <= 0:
        return Err[bigint.BigInt]("ecdsa: verify scalar zero")
    let bitStart: int32 = maxBits - 1
    for bitOffset in 0..bitStart:
        let bitIdx: int32 = bitStart - bitOffset
        if ! resultInf:
            var doubledX: bigint.BigInt
            var doubledY: bigint.BigInt
            var doubledZ: bigint.BigInt
            let dblRes: Result[bool] = pointJacobianDoubleCoordsInto(doubledX, doubledY, doubledZ, resultX, resultY, resultZ)
            if IsErr(dblRes):
                return Err[bigint.BigInt](Error(dblRes))
            resultInf = Value(dblRes)
            if ! resultInf:
                p256BigSetInto(resultX, doubledX)
                p256BigSetInto(resultY, doubledY)
                p256BigSetInto(resultZ, doubledZ)
        if bigint.bigGetBit(u1, bitIdx) != 0:
            if resultInf:
                p256BigSetInto(resultX, gx)
                p256BigSetInto(resultY, gy)
                p256BigSetInto(resultZ, one)
                resultInf = false
            else:
                var addedGX: bigint.BigInt
                var addedGY: bigint.BigInt
                var addedGZ: bigint.BigInt
                let addGRes: Result[bool] = pointJacobianAddAffineCoordsInto(addedGX, addedGY, addedGZ, resultX, resultY, resultZ, gx, gy)
                if IsErr(addGRes):
                    return Err[bigint.BigInt](Error(addGRes))
                resultInf = Value(addGRes)
                if ! resultInf:
                    p256BigSetInto(resultX, addedGX)
                    p256BigSetInto(resultY, addedGY)
                    p256BigSetInto(resultZ, addedGZ)
        if bigint.bigGetBit(u2, bitIdx) != 0:
            if resultInf:
                p256BigSetInto(resultX, pubX)
                p256BigSetInto(resultY, pubY)
                p256BigSetInto(resultZ, one)
                resultInf = false
            else:
                var addedQX: bigint.BigInt
                var addedQY: bigint.BigInt
                var addedQZ: bigint.BigInt
                let addQRes: Result[bool] = pointJacobianAddAffineCoordsInto(addedQX, addedQY, addedQZ, resultX, resultY, resultZ, pubX, pubY)
                if IsErr(addQRes):
                    return Err[bigint.BigInt](Error(addQRes))
                resultInf = Value(addQRes)
                if ! resultInf:
                    p256BigSetInto(resultX, addedQX)
                    p256BigSetInto(resultY, addedQY)
                    p256BigSetInto(resultZ, addedQZ)
    if resultInf || bigint.bigIsZero(resultZ):
        return Err[bigint.BigInt]("ecdsa: verify result at infinity")
    if bigint.bigCmp(resultZ, one) == 0:
        return nMod(resultX)
    let zInvRes: Result[bigint.BigInt] = p256ModInv(resultZ)
    if IsErr(zInvRes):
        return Err[bigint.BigInt](Error(zInvRes))
    var zInv: bigint.BigInt = Value(zInvRes)
    var zInv2: bigint.BigInt
    let zInv2Res: Result[bool] = p256ModMulInto(zInv2, zInv, zInv)
    if IsErr(zInv2Res):
        return Err[bigint.BigInt](Error(zInv2Res))
    var xAffine: bigint.BigInt
    let xAffineRes: Result[bool] = p256ModMulInto(xAffine, resultX, zInv2)
    if IsErr(xAffineRes):
        return Err[bigint.BigInt](Error(xAffineRes))
    return nMod(xAffine)

fn pointMulGeneratorRFixedCrash(k: pfix.P256Fixed): pfix.P256Fixed =
    var result: EcPointJacobianFixed
    pointJacobianFixedSetInto(result, pointMulGeneratorJacobianWnafFixed(k))
    return pointJacobianXToScalarFixedCrash(result)

fn pointMulGeneratorRFixedBig(k: pfix.P256Fixed): Result[bigint.BigInt] =
    var result: EcPointJacobianFixed
    pointMulGeneratorJacobianComb6FixedInto(result, k)
    if result.inf || pfix.p256FixedIsZero(result.z):
        return Err[bigint.BigInt]("ecdsa: generator result at infinity")
    let x: pfix.P256Fixed = pointJacobianXToScalarFixedCrash(result)
    return Ok[bigint.BigInt](pfix.p256FixedToBigInt(x))

fn isInfinity(p: EcPoint): bool =
    return p.inf

fn pointInfinity(): EcPoint =
    EcPoint(x: bigint.bigZero(), y: bigint.bigZero(), inf: true)

fn pointJacobianInfinity(): EcPointJacobian =
    EcPointJacobian(x: bigint.bigZero(), y: bigint.bigZero(), z: bigint.bigZero(), inf: true)

fn pointJacobianSetInfinityInto(out: var EcPointJacobian) =
    out.x.count = 0
    for i in 0..<bigint.maxBigIntLimbs:
        out.x.limbs[i] = 0
    out.y.count = 0
    for i in 0..<bigint.maxBigIntLimbs:
        out.y.limbs[i] = 0
    out.z.count = 0
    for i in 0..<bigint.maxBigIntLimbs:
        out.z.limbs[i] = 0
    out.inf = true

fn pointJacobianSetInto(out: var EcPointJacobian, src: var EcPointJacobian) =
    out.x.count = src.x.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.x.limbs[i] = 0
    for i in 0..<src.x.count:
        out.x.limbs[i] = src.x.limbs[i]
    if src.x.count > 7:
        out.x.limbs[7] = src.x.limbs[7]
    out.y.count = src.y.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.y.limbs[i] = 0
    for i in 0..<src.y.count:
        out.y.limbs[i] = src.y.limbs[i]
    if src.y.count > 7:
        out.y.limbs[7] = src.y.limbs[7]
    out.z.count = src.z.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.z.limbs[i] = 0
    for i in 0..<src.z.count:
        out.z.limbs[i] = src.z.limbs[i]
    if src.z.count > 7:
        out.z.limbs[7] = src.z.limbs[7]
    out.inf = src.inf

fn pointJacobianSetCoordsInto(out: var EcPointJacobian, x: bigint.BigInt, y: bigint.BigInt, z: bigint.BigInt) =
    out.x.count = x.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.x.limbs[i] = 0
    for i in 0..<x.count:
        out.x.limbs[i] = x.limbs[i]
    if x.count > 7:
        out.x.limbs[7] = x.limbs[7]
    out.y.count = y.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.y.limbs[i] = 0
    for i in 0..<y.count:
        out.y.limbs[i] = y.limbs[i]
    if y.count > 7:
        out.y.limbs[7] = y.limbs[7]
    out.z.count = z.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.z.limbs[i] = 0
    for i in 0..<z.count:
        out.z.limbs[i] = z.limbs[i]
    if z.count > 7:
        out.z.limbs[7] = z.limbs[7]
    out.inf = false

fn pointJacobianFromAffine(p: EcPoint): EcPointJacobian =
    if p.inf:
        return pointJacobianInfinity()
    return EcPointJacobian(x: p.x, y: p.y, z: bigint.bigFromInt(1), inf: false)

fn pointJacobianToAffineInto(out: var EcPoint, p: EcPointJacobian): Result[bool] =
    if p.inf || bigint.bigIsZero(p.z):
        pointSetInfinityInto(out)
        return Ok[bool](true)
    let zInvRes: Result[bigint.BigInt] = p256ModInv(p.z)
    if IsErr(zInvRes):
        return Err[bool](Error(zInvRes))
    let zInv: bigint.BigInt = Value(zInvRes)
    let zInv2Res: Result[bigint.BigInt] = p256ModMul(zInv, zInv)
    if IsErr(zInv2Res):
        return Err[bool](Error(zInv2Res))
    let zInvCubedRes: Result[bigint.BigInt] = p256ModMul(Value(zInv2Res), zInv)
    if IsErr(zInvCubedRes):
        return Err[bool](Error(zInvCubedRes))
    let xRes: Result[bigint.BigInt] = p256ModMul(p.x, Value(zInv2Res))
    if IsErr(xRes):
        return Err[bool](Error(xRes))
    let yRes: Result[bigint.BigInt] = p256ModMul(p.y, Value(zInvCubedRes))
    if IsErr(yRes):
        return Err[bool](Error(yRes))
    var x: bigint.BigInt
    p256BigSetInto(x, Value(xRes))
    var y: bigint.BigInt
    p256BigSetInto(y, Value(yRes))
    pointSetCoordsInto(out, x, y)
    return Ok[bool](true)

fn pointJacobianToAffine(p: EcPointJacobian): Result[EcPoint] =
    if p.inf || bigint.bigIsZero(p.z):
        return Ok[EcPoint](pointInfinity())
    let zInvRes: Result[bigint.BigInt] = p256ModInv(p.z)
    if IsErr(zInvRes):
        return Err[EcPoint](Error(zInvRes))
    let zInv: bigint.BigInt = Value(zInvRes)
    let zInv2Res: Result[bigint.BigInt] = p256ModMul(zInv, zInv)
    if IsErr(zInv2Res):
        return Err[EcPoint](Error(zInv2Res))
    let zInvCubedRes: Result[bigint.BigInt] = p256ModMul(Value(zInv2Res), zInv)
    if IsErr(zInvCubedRes):
        return Err[EcPoint](Error(zInvCubedRes))
    let xRes: Result[bigint.BigInt] = p256ModMul(p.x, Value(zInv2Res))
    if IsErr(xRes):
        return Err[EcPoint](Error(xRes))
    let yRes: Result[bigint.BigInt] = p256ModMul(p.y, Value(zInvCubedRes))
    if IsErr(yRes):
        return Err[EcPoint](Error(yRes))
    return Ok[EcPoint](EcPoint(x: Value(xRes), y: Value(yRes), inf: false))

fn pointJacobianDoubleInto(out: var EcPointJacobian, p: var EcPointJacobian): Result[bool] =
    if p.inf || bigint.bigIsZero(p.y):
        pointJacobianSetInfinityInto(out)
        return Ok[bool](true)
    let deltaRes: Result[bigint.BigInt] = p256ModMul(p.z, p.z)
    if IsErr(deltaRes):
        return Err[bool](Error(deltaRes))
    let gammaRes: Result[bigint.BigInt] = p256ModMul(p.y, p.y)
    if IsErr(gammaRes):
        return Err[bool](Error(gammaRes))
    let betaRes: Result[bigint.BigInt] = p256ModMul(p.x, Value(gammaRes))
    if IsErr(betaRes):
        return Err[bool](Error(betaRes))
    let xMinusDeltaRes: Result[bigint.BigInt] = p256ModSub(p.x, Value(deltaRes))
    if IsErr(xMinusDeltaRes):
        return Err[bool](Error(xMinusDeltaRes))
    let xPlusDeltaRes: Result[bigint.BigInt] = p256ModAdd(p.x, Value(deltaRes))
    if IsErr(xPlusDeltaRes):
        return Err[bool](Error(xPlusDeltaRes))
    let alphaBaseRes: Result[bigint.BigInt] = p256ModMul(Value(xMinusDeltaRes), Value(xPlusDeltaRes))
    if IsErr(alphaBaseRes):
        return Err[bool](Error(alphaBaseRes))
    let alphaRes: Result[bigint.BigInt] = p256ModTriple(Value(alphaBaseRes))
    if IsErr(alphaRes):
        return Err[bool](Error(alphaRes))
    let alpha2Res: Result[bigint.BigInt] = p256ModMul(Value(alphaRes), Value(alphaRes))
    if IsErr(alpha2Res):
        return Err[bool](Error(alpha2Res))
    let beta4Res: Result[bigint.BigInt] = p256ModQuad(Value(betaRes))
    if IsErr(beta4Res):
        return Err[bool](Error(beta4Res))
    let beta8Res: Result[bigint.BigInt] = p256ModDouble(Value(beta4Res))
    if IsErr(beta8Res):
        return Err[bool](Error(beta8Res))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(alpha2Res), Value(beta8Res))
    if IsErr(x3Res):
        return Err[bool](Error(x3Res))
    let yPlusZRes: Result[bigint.BigInt] = p256ModAdd(p.y, p.z)
    if IsErr(yPlusZRes):
        return Err[bool](Error(yPlusZRes))
    let yPlusZ2Res: Result[bigint.BigInt] = p256ModMul(Value(yPlusZRes), Value(yPlusZRes))
    if IsErr(yPlusZ2Res):
        return Err[bool](Error(yPlusZ2Res))
    let z3aRes: Result[bigint.BigInt] = p256ModSub(Value(yPlusZ2Res), Value(gammaRes))
    if IsErr(z3aRes):
        return Err[bool](Error(z3aRes))
    let z3Res: Result[bigint.BigInt] = p256ModSub(Value(z3aRes), Value(deltaRes))
    if IsErr(z3Res):
        return Err[bool](Error(z3Res))
    let gamma2Res: Result[bigint.BigInt] = p256ModMul(Value(gammaRes), Value(gammaRes))
    if IsErr(gamma2Res):
        return Err[bool](Error(gamma2Res))
    let gamma8Res: Result[bigint.BigInt] = p256ModEight(Value(gamma2Res))
    if IsErr(gamma8Res):
        return Err[bool](Error(gamma8Res))
    let beta4MinusX3Res: Result[bigint.BigInt] = p256ModSub(Value(beta4Res), Value(x3Res))
    if IsErr(beta4MinusX3Res):
        return Err[bool](Error(beta4MinusX3Res))
    let y3aRes: Result[bigint.BigInt] = p256ModMul(Value(alphaRes), Value(beta4MinusX3Res))
    if IsErr(y3aRes):
        return Err[bool](Error(y3aRes))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3aRes), Value(gamma8Res))
    if IsErr(y3Res):
        return Err[bool](Error(y3Res))
    let x3: bigint.BigInt = Value(x3Res)
    let y3: bigint.BigInt = Value(y3Res)
    let z3: bigint.BigInt = Value(z3Res)
    pointJacobianSetCoordsInto(out, x3, y3, z3)
    return Ok[bool](true)

fn pointJacobianAddInto(out: var EcPointJacobian, p1: var EcPointJacobian, p2: var EcPointJacobian): Result[bool] =
    if p1.inf || bigint.bigIsZero(p1.z):
        pointJacobianSetInto(out, p2)
        return Ok[bool](true)
    if p2.inf || bigint.bigIsZero(p2.z):
        pointJacobianSetInto(out, p1)
        return Ok[bool](true)
    let z1z1Res: Result[bigint.BigInt] = p256ModMul(p1.z, p1.z)
    if IsErr(z1z1Res):
        return Err[bool](Error(z1z1Res))
    let z2z2Res: Result[bigint.BigInt] = p256ModMul(p2.z, p2.z)
    if IsErr(z2z2Res):
        return Err[bool](Error(z2z2Res))
    let u1Res: Result[bigint.BigInt] = p256ModMul(p1.x, Value(z2z2Res))
    if IsErr(u1Res):
        return Err[bool](Error(u1Res))
    let u2Res: Result[bigint.BigInt] = p256ModMul(p2.x, Value(z1z1Res))
    if IsErr(u2Res):
        return Err[bool](Error(u2Res))
    let z1CubedRes: Result[bigint.BigInt] = p256ModMul(p1.z, Value(z1z1Res))
    if IsErr(z1CubedRes):
        return Err[bool](Error(z1CubedRes))
    let z2CubedRes: Result[bigint.BigInt] = p256ModMul(p2.z, Value(z2z2Res))
    if IsErr(z2CubedRes):
        return Err[bool](Error(z2CubedRes))
    let s1Res: Result[bigint.BigInt] = p256ModMul(p1.y, Value(z2CubedRes))
    if IsErr(s1Res):
        return Err[bool](Error(s1Res))
    let s2Res: Result[bigint.BigInt] = p256ModMul(p2.y, Value(z1CubedRes))
    if IsErr(s2Res):
        return Err[bool](Error(s2Res))
    if bigint.bigCmp(Value(u1Res), Value(u2Res)) == 0:
        if bigint.bigCmp(Value(s1Res), Value(s2Res)) != 0:
            pointJacobianSetInfinityInto(out)
            return Ok[bool](true)
        return pointJacobianDoubleInto(out, p1)
    let hRes: Result[bigint.BigInt] = p256ModSub(Value(u2Res), Value(u1Res))
    if IsErr(hRes):
        return Err[bool](Error(hRes))
    let twoHRes: Result[bigint.BigInt] = p256ModDouble(Value(hRes))
    if IsErr(twoHRes):
        return Err[bool](Error(twoHRes))
    let iRes: Result[bigint.BigInt] = p256ModMul(Value(twoHRes), Value(twoHRes))
    if IsErr(iRes):
        return Err[bool](Error(iRes))
    let jRes: Result[bigint.BigInt] = p256ModMul(Value(hRes), Value(iRes))
    if IsErr(jRes):
        return Err[bool](Error(jRes))
    let sDiffRes: Result[bigint.BigInt] = p256ModSub(Value(s2Res), Value(s1Res))
    if IsErr(sDiffRes):
        return Err[bool](Error(sDiffRes))
    let rRes: Result[bigint.BigInt] = p256ModDouble(Value(sDiffRes))
    if IsErr(rRes):
        return Err[bool](Error(rRes))
    let vRes: Result[bigint.BigInt] = p256ModMul(Value(u1Res), Value(iRes))
    if IsErr(vRes):
        return Err[bool](Error(vRes))
    let r2Res: Result[bigint.BigInt] = p256ModMul(Value(rRes), Value(rRes))
    if IsErr(r2Res):
        return Err[bool](Error(r2Res))
    let twoVRes: Result[bigint.BigInt] = p256ModDouble(Value(vRes))
    if IsErr(twoVRes):
        return Err[bool](Error(twoVRes))
    let x3aRes: Result[bigint.BigInt] = p256ModSub(Value(r2Res), Value(jRes))
    if IsErr(x3aRes):
        return Err[bool](Error(x3aRes))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(x3aRes), Value(twoVRes))
    if IsErr(x3Res):
        return Err[bool](Error(x3Res))
    let vMinusX3Res: Result[bigint.BigInt] = p256ModSub(Value(vRes), Value(x3Res))
    if IsErr(vMinusX3Res):
        return Err[bool](Error(vMinusX3Res))
    let s1jRes: Result[bigint.BigInt] = p256ModMul(Value(s1Res), Value(jRes))
    if IsErr(s1jRes):
        return Err[bool](Error(s1jRes))
    let twoS1JRes: Result[bigint.BigInt] = p256ModDouble(Value(s1jRes))
    if IsErr(twoS1JRes):
        return Err[bool](Error(twoS1JRes))
    let y3aRes: Result[bigint.BigInt] = p256ModMul(Value(rRes), Value(vMinusX3Res))
    if IsErr(y3aRes):
        return Err[bool](Error(y3aRes))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3aRes), Value(twoS1JRes))
    if IsErr(y3Res):
        return Err[bool](Error(y3Res))
    let z1PlusZ2Res: Result[bigint.BigInt] = p256ModAdd(p1.z, p2.z)
    if IsErr(z1PlusZ2Res):
        return Err[bool](Error(z1PlusZ2Res))
    let z1PlusZ2SqRes: Result[bigint.BigInt] = p256ModMul(Value(z1PlusZ2Res), Value(z1PlusZ2Res))
    if IsErr(z1PlusZ2SqRes):
        return Err[bool](Error(z1PlusZ2SqRes))
    let z3aRes: Result[bigint.BigInt] = p256ModSub(Value(z1PlusZ2SqRes), Value(z1z1Res))
    if IsErr(z3aRes):
        return Err[bool](Error(z3aRes))
    let z3bRes: Result[bigint.BigInt] = p256ModSub(Value(z3aRes), Value(z2z2Res))
    if IsErr(z3bRes):
        return Err[bool](Error(z3bRes))
    let z3Res: Result[bigint.BigInt] = p256ModMul(Value(z3bRes), Value(hRes))
    if IsErr(z3Res):
        return Err[bool](Error(z3Res))
    let x3: bigint.BigInt = Value(x3Res)
    let y3: bigint.BigInt = Value(y3Res)
    let z3: bigint.BigInt = Value(z3Res)
    pointJacobianSetCoordsInto(out, x3, y3, z3)
    return Ok[bool](true)

fn p256ModDouble(a: bigint.BigInt): Result[bigint.BigInt] =
    return p256ModAdd(a, a)

fn p256ModTriple(a: bigint.BigInt): Result[bigint.BigInt] =
    let dblRes: Result[bigint.BigInt] = p256ModDouble(a)
    if IsErr(dblRes):
        return Err[bigint.BigInt](Error(dblRes))
    return p256ModAdd(Value(dblRes), a)

fn p256ModQuad(a: bigint.BigInt): Result[bigint.BigInt] =
    let dblRes: Result[bigint.BigInt] = p256ModDouble(a)
    if IsErr(dblRes):
        return Err[bigint.BigInt](Error(dblRes))
    return p256ModDouble(Value(dblRes))

fn p256ModEight(a: bigint.BigInt): Result[bigint.BigInt] =
    let quadRes: Result[bigint.BigInt] = p256ModQuad(a)
    if IsErr(quadRes):
        return Err[bigint.BigInt](Error(quadRes))
    return p256ModDouble(Value(quadRes))

fn pointJacobianDouble(p: EcPointJacobian): Result[EcPointJacobian] =
    if p.inf || bigint.bigIsZero(p.y):
        return Ok[EcPointJacobian](pointJacobianInfinity())
    let deltaRes: Result[bigint.BigInt] = p256ModMul(p.z, p.z)
    if IsErr(deltaRes):
        return Err[EcPointJacobian](Error(deltaRes))
    let gammaRes: Result[bigint.BigInt] = p256ModMul(p.y, p.y)
    if IsErr(gammaRes):
        return Err[EcPointJacobian](Error(gammaRes))
    let betaRes: Result[bigint.BigInt] = p256ModMul(p.x, Value(gammaRes))
    if IsErr(betaRes):
        return Err[EcPointJacobian](Error(betaRes))
    let xMinusDeltaRes: Result[bigint.BigInt] = p256ModSub(p.x, Value(deltaRes))
    if IsErr(xMinusDeltaRes):
        return Err[EcPointJacobian](Error(xMinusDeltaRes))
    let xPlusDeltaRes: Result[bigint.BigInt] = p256ModAdd(p.x, Value(deltaRes))
    if IsErr(xPlusDeltaRes):
        return Err[EcPointJacobian](Error(xPlusDeltaRes))
    let alphaBaseRes: Result[bigint.BigInt] = p256ModMul(Value(xMinusDeltaRes), Value(xPlusDeltaRes))
    if IsErr(alphaBaseRes):
        return Err[EcPointJacobian](Error(alphaBaseRes))
    let alphaRes: Result[bigint.BigInt] = p256ModTriple(Value(alphaBaseRes))
    if IsErr(alphaRes):
        return Err[EcPointJacobian](Error(alphaRes))
    let alpha2Res: Result[bigint.BigInt] = p256ModMul(Value(alphaRes), Value(alphaRes))
    if IsErr(alpha2Res):
        return Err[EcPointJacobian](Error(alpha2Res))
    let beta4Res: Result[bigint.BigInt] = p256ModQuad(Value(betaRes))
    if IsErr(beta4Res):
        return Err[EcPointJacobian](Error(beta4Res))
    let beta8Res: Result[bigint.BigInt] = p256ModDouble(Value(beta4Res))
    if IsErr(beta8Res):
        return Err[EcPointJacobian](Error(beta8Res))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(alpha2Res), Value(beta8Res))
    if IsErr(x3Res):
        return Err[EcPointJacobian](Error(x3Res))
    let yPlusZRes: Result[bigint.BigInt] = p256ModAdd(p.y, p.z)
    if IsErr(yPlusZRes):
        return Err[EcPointJacobian](Error(yPlusZRes))
    let yPlusZ2Res: Result[bigint.BigInt] = p256ModMul(Value(yPlusZRes), Value(yPlusZRes))
    if IsErr(yPlusZ2Res):
        return Err[EcPointJacobian](Error(yPlusZ2Res))
    let z3aRes: Result[bigint.BigInt] = p256ModSub(Value(yPlusZ2Res), Value(gammaRes))
    if IsErr(z3aRes):
        return Err[EcPointJacobian](Error(z3aRes))
    let z3Res: Result[bigint.BigInt] = p256ModSub(Value(z3aRes), Value(deltaRes))
    if IsErr(z3Res):
        return Err[EcPointJacobian](Error(z3Res))
    let gamma2Res: Result[bigint.BigInt] = p256ModMul(Value(gammaRes), Value(gammaRes))
    if IsErr(gamma2Res):
        return Err[EcPointJacobian](Error(gamma2Res))
    let gamma8Res: Result[bigint.BigInt] = p256ModEight(Value(gamma2Res))
    if IsErr(gamma8Res):
        return Err[EcPointJacobian](Error(gamma8Res))
    let beta4MinusX3Res: Result[bigint.BigInt] = p256ModSub(Value(beta4Res), Value(x3Res))
    if IsErr(beta4MinusX3Res):
        return Err[EcPointJacobian](Error(beta4MinusX3Res))
    let y3aRes: Result[bigint.BigInt] = p256ModMul(Value(alphaRes), Value(beta4MinusX3Res))
    if IsErr(y3aRes):
        return Err[EcPointJacobian](Error(y3aRes))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3aRes), Value(gamma8Res))
    if IsErr(y3Res):
        return Err[EcPointJacobian](Error(y3Res))
    return Ok[EcPointJacobian](EcPointJacobian(x: Value(x3Res), y: Value(y3Res), z: Value(z3Res), inf: false))

fn pointJacobianAdd(p1: EcPointJacobian, p2: EcPointJacobian): Result[EcPointJacobian] =
    if p1.inf || bigint.bigIsZero(p1.z):
        return Ok[EcPointJacobian](p2)
    if p2.inf || bigint.bigIsZero(p2.z):
        return Ok[EcPointJacobian](p1)
    let z1z1Res: Result[bigint.BigInt] = p256ModMul(p1.z, p1.z)
    if IsErr(z1z1Res):
        return Err[EcPointJacobian](Error(z1z1Res))
    let z2z2Res: Result[bigint.BigInt] = p256ModMul(p2.z, p2.z)
    if IsErr(z2z2Res):
        return Err[EcPointJacobian](Error(z2z2Res))
    let u1Res: Result[bigint.BigInt] = p256ModMul(p1.x, Value(z2z2Res))
    if IsErr(u1Res):
        return Err[EcPointJacobian](Error(u1Res))
    let u2Res: Result[bigint.BigInt] = p256ModMul(p2.x, Value(z1z1Res))
    if IsErr(u2Res):
        return Err[EcPointJacobian](Error(u2Res))
    let z1CubedRes: Result[bigint.BigInt] = p256ModMul(p1.z, Value(z1z1Res))
    if IsErr(z1CubedRes):
        return Err[EcPointJacobian](Error(z1CubedRes))
    let z2CubedRes: Result[bigint.BigInt] = p256ModMul(p2.z, Value(z2z2Res))
    if IsErr(z2CubedRes):
        return Err[EcPointJacobian](Error(z2CubedRes))
    let s1Res: Result[bigint.BigInt] = p256ModMul(p1.y, Value(z2CubedRes))
    if IsErr(s1Res):
        return Err[EcPointJacobian](Error(s1Res))
    let s2Res: Result[bigint.BigInt] = p256ModMul(p2.y, Value(z1CubedRes))
    if IsErr(s2Res):
        return Err[EcPointJacobian](Error(s2Res))
    if bigint.bigCmp(Value(u1Res), Value(u2Res)) == 0:
        if bigint.bigCmp(Value(s1Res), Value(s2Res)) != 0:
            return Ok[EcPointJacobian](pointJacobianInfinity())
        return pointJacobianDouble(p1)
    let hRes: Result[bigint.BigInt] = p256ModSub(Value(u2Res), Value(u1Res))
    if IsErr(hRes):
        return Err[EcPointJacobian](Error(hRes))
    let twoHRes: Result[bigint.BigInt] = p256ModDouble(Value(hRes))
    if IsErr(twoHRes):
        return Err[EcPointJacobian](Error(twoHRes))
    let iRes: Result[bigint.BigInt] = p256ModMul(Value(twoHRes), Value(twoHRes))
    if IsErr(iRes):
        return Err[EcPointJacobian](Error(iRes))
    let jRes: Result[bigint.BigInt] = p256ModMul(Value(hRes), Value(iRes))
    if IsErr(jRes):
        return Err[EcPointJacobian](Error(jRes))
    let sDiffRes: Result[bigint.BigInt] = p256ModSub(Value(s2Res), Value(s1Res))
    if IsErr(sDiffRes):
        return Err[EcPointJacobian](Error(sDiffRes))
    let rRes: Result[bigint.BigInt] = p256ModDouble(Value(sDiffRes))
    if IsErr(rRes):
        return Err[EcPointJacobian](Error(rRes))
    let vRes: Result[bigint.BigInt] = p256ModMul(Value(u1Res), Value(iRes))
    if IsErr(vRes):
        return Err[EcPointJacobian](Error(vRes))
    let r2Res: Result[bigint.BigInt] = p256ModMul(Value(rRes), Value(rRes))
    if IsErr(r2Res):
        return Err[EcPointJacobian](Error(r2Res))
    let twoVRes: Result[bigint.BigInt] = p256ModDouble(Value(vRes))
    if IsErr(twoVRes):
        return Err[EcPointJacobian](Error(twoVRes))
    let x3aRes: Result[bigint.BigInt] = p256ModSub(Value(r2Res), Value(jRes))
    if IsErr(x3aRes):
        return Err[EcPointJacobian](Error(x3aRes))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(x3aRes), Value(twoVRes))
    if IsErr(x3Res):
        return Err[EcPointJacobian](Error(x3Res))
    let vMinusX3Res: Result[bigint.BigInt] = p256ModSub(Value(vRes), Value(x3Res))
    if IsErr(vMinusX3Res):
        return Err[EcPointJacobian](Error(vMinusX3Res))
    let s1jRes: Result[bigint.BigInt] = p256ModMul(Value(s1Res), Value(jRes))
    if IsErr(s1jRes):
        return Err[EcPointJacobian](Error(s1jRes))
    let twoS1JRes: Result[bigint.BigInt] = p256ModDouble(Value(s1jRes))
    if IsErr(twoS1JRes):
        return Err[EcPointJacobian](Error(twoS1JRes))
    let y3aRes: Result[bigint.BigInt] = p256ModMul(Value(rRes), Value(vMinusX3Res))
    if IsErr(y3aRes):
        return Err[EcPointJacobian](Error(y3aRes))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3aRes), Value(twoS1JRes))
    if IsErr(y3Res):
        return Err[EcPointJacobian](Error(y3Res))
    let z1PlusZ2Res: Result[bigint.BigInt] = p256ModAdd(p1.z, p2.z)
    if IsErr(z1PlusZ2Res):
        return Err[EcPointJacobian](Error(z1PlusZ2Res))
    let z1PlusZ2SqRes: Result[bigint.BigInt] = p256ModMul(Value(z1PlusZ2Res), Value(z1PlusZ2Res))
    if IsErr(z1PlusZ2SqRes):
        return Err[EcPointJacobian](Error(z1PlusZ2SqRes))
    let z3aRes: Result[bigint.BigInt] = p256ModSub(Value(z1PlusZ2SqRes), Value(z1z1Res))
    if IsErr(z3aRes):
        return Err[EcPointJacobian](Error(z3aRes))
    let z3bRes: Result[bigint.BigInt] = p256ModSub(Value(z3aRes), Value(z2z2Res))
    if IsErr(z3bRes):
        return Err[EcPointJacobian](Error(z3bRes))
    let z3Res: Result[bigint.BigInt] = p256ModMul(Value(z3bRes), Value(hRes))
    if IsErr(z3Res):
        return Err[EcPointJacobian](Error(z3Res))
    return Ok[EcPointJacobian](EcPointJacobian(x: Value(x3Res), y: Value(y3Res), z: Value(z3Res), inf: false))

@borrows
fn pointCoordsOnCurveRhs(x: bigint.BigInt, x3: bigint.BigInt): Result[bigint.BigInt] =
    let fieldModulus: bigint.BigInt = p256ConstP()
    let three: bigint.BigInt = bigint.bigFromInt(3)
    let aRes: Result[bigint.BigInt] = bigint.bigSub(fieldModulus, three)
    if IsErr(aRes):
        return Err[bigint.BigInt](Error(aRes))
    let axRes: Result[bigint.BigInt] = p256ModMul(Value(aRes), x)
    if IsErr(axRes):
        return Err[bigint.BigInt](Error(axRes))
    let rhs1Res: Result[bigint.BigInt] = p256ModAdd(x3, Value(axRes))
    if IsErr(rhs1Res):
        return Err[bigint.BigInt](Error(rhs1Res))
    let bConst: bigint.BigInt = p256ConstB()
    return p256ModAdd(Value(rhs1Res), bConst)

fn pointCoordsAreOnCurve(xInput: bigint.BigInt, yInput: bigint.BigInt): Result[bool] =
    let xModRes: Result[bigint.BigInt] = p256Mod(xInput)
    if IsErr(xModRes):
        return Err[bool](Error(xModRes))
    let yModRes: Result[bigint.BigInt] = p256Mod(yInput)
    if IsErr(yModRes):
        return Err[bool](Error(yModRes))
    let x: bigint.BigInt = Value(xModRes)
    let y: bigint.BigInt = Value(yModRes)
    let y2Res: Result[bigint.BigInt] = p256ModMul(y, y)
    if IsErr(y2Res):
        return Err[bool](Error(y2Res))
    let x2Res: Result[bigint.BigInt] = p256ModMul(x, x)
    if IsErr(x2Res):
        return Err[bool](Error(x2Res))
    let x3Res: Result[bigint.BigInt] = p256ModMul(Value(x2Res), x)
    if IsErr(x3Res):
        return Err[bool](Error(x3Res))
    let rhsRes: Result[bigint.BigInt] = pointCoordsOnCurveRhs(x, Value(x3Res))
    if IsErr(rhsRes):
        return Err[bool](Error(rhsRes))
    return Ok[bool](bigint.bigCmp(Value(y2Res), Value(rhsRes)) == 0)

fn pointIsOnCurve(p: var EcPoint): Result[bool] =
    if p.inf:
        return Ok[bool](false)
    var x: bigint.BigInt = p.x
    var y: bigint.BigInt = p.y
    return pointCoordsAreOnCurve(x, y)

@borrows
fn pointIsOnCurveFixedBMont(): Result[pfix.P256Fixed] =
    var bBig: bigint.BigInt
    p256BigSetInto(bBig, p256ConstB())
    let bFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(bBig)
    if IsErr(bFixedRes):
        return Err[pfix.P256Fixed](Error(bFixedRes))
    return p256FieldFixedToMont(Value(bFixedRes))

fn pointIsOnCurveFixed(p: EcPointFixed): Result[bool] =
    if p.inf:
        return Ok[bool](false)
    let y2Res: Result[pfix.P256Fixed] = p256FieldFixedSquare(p.y)
    if IsErr(y2Res):
        return Err[bool](Error(y2Res))
    let x2Res: Result[pfix.P256Fixed] = p256FieldFixedSquare(p.x)
    if IsErr(x2Res):
        return Err[bool](Error(x2Res))
    let x3Res: Result[pfix.P256Fixed] = p256FieldFixedMul(Value(x2Res), p.x)
    if IsErr(x3Res):
        return Err[bool](Error(x3Res))
    let threeXRes: Result[pfix.P256Fixed] = p256FieldFixedTriple(p.x)
    if IsErr(threeXRes):
        return Err[bool](Error(threeXRes))
    let rhsBaseRes: Result[pfix.P256Fixed] = p256FieldFixedSub(Value(x3Res), Value(threeXRes))
    if IsErr(rhsBaseRes):
        return Err[bool](Error(rhsBaseRes))
    let bMontRes: Result[pfix.P256Fixed] = pointIsOnCurveFixedBMont()
    if IsErr(bMontRes):
        return Err[bool](Error(bMontRes))
    let rhsRes: Result[pfix.P256Fixed] = p256FieldFixedAdd(Value(rhsBaseRes), Value(bMontRes))
    if IsErr(rhsRes):
        return Err[bool](Error(rhsRes))
    return Ok[bool](pfix.p256FixedCmp(Value(y2Res), Value(rhsRes)) == 0)

@borrows
fn ecdsaParsePublicKeyPointFixedBytes(data: Bytes,
                                      requireCurveCheck: bool,
                                      out: var EcPointFixed): Result[bool] =
    let initRes: Result[bool] = p256EnsureFixedInit()
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    if BytesLen(data) != p256PublicSize:
        return Err[bool]("ecdsa: invalid public key length")
    if BytesGet(data, 0) != 0x04:
        return Err[bool]("ecdsa: invalid public key prefix")
    let xNormRes: Result[pfix.P256Fixed] = pfix.p256FixedReadBytesBE32(data, 1)
    if IsErr(xNormRes):
        return Err[bool](Error(xNormRes))
    let yNormRes: Result[pfix.P256Fixed] = pfix.p256FixedReadBytesBE32(data, 1 + p256ScalarSize)
    if IsErr(yNormRes):
        return Err[bool](Error(yNormRes))
    var xNorm: pfix.P256Fixed = Value(xNormRes)
    var yNorm: pfix.P256Fixed = Value(yNormRes)
    var modulus: pfix.P256Fixed = pfix.p256FieldModulus()
    if pfix.p256FixedCmp(xNorm, modulus) >= 0 || pfix.p256FixedCmp(yNorm, modulus) >= 0:
        return Err[bool]("ecdsa: point out of range")
    let xMontRes: Result[pfix.P256Fixed] = p256FieldFixedToMont(xNorm)
    if IsErr(xMontRes):
        return Err[bool](Error(xMontRes))
    let yMontRes: Result[pfix.P256Fixed] = p256FieldFixedToMont(yNorm)
    if IsErr(yMontRes):
        return Err[bool](Error(yMontRes))
    pointFixedSetCoordsInto(out, Value(xMontRes), Value(yMontRes))
    if requireCurveCheck:
        let onCurveRes: Result[bool] = pointIsOnCurveFixed(out)
        if IsErr(onCurveRes) || ! Value(onCurveRes):
            let xBig: bigint.BigInt = pfix.p256FixedToBigInt(xNorm)
            let yBig: bigint.BigInt = pfix.p256FixedToBigInt(yNorm)
            let bigCheckRes: Result[bool] = pointCoordsAreOnCurve(xBig, yBig)
            if IsErr(bigCheckRes) || ! Value(bigCheckRes):
                return Err[bool]("ecdsa: point ! on curve")
    return Ok[bool](true)

fn pointSetInfinityInto(out: var EcPoint) =
    out.x.count = 0
    for i in 0..<bigint.maxBigIntLimbs:
        out.x.limbs[i] = 0
    out.y.count = 0
    for i in 0..<bigint.maxBigIntLimbs:
        out.y.limbs[i] = 0
    out.inf = true

fn pointSetInto(out: var EcPoint, src: var EcPoint) =
    out.x.count = src.x.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.x.limbs[i] = 0
    for i in 0..<src.x.count:
        out.x.limbs[i] = src.x.limbs[i]
    if src.x.count > 7:
        out.x.limbs[7] = src.x.limbs[7]
    out.y.count = src.y.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.y.limbs[i] = 0
    for i in 0..<src.y.count:
        out.y.limbs[i] = src.y.limbs[i]
    if src.y.count > 7:
        out.y.limbs[7] = src.y.limbs[7]
    out.inf = src.inf

fn pointSetCoordsInto(out: var EcPoint, x: bigint.BigInt, y: bigint.BigInt) =
    out.x.count = x.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.x.limbs[i] = 0
    for i in 0..<x.count:
        out.x.limbs[i] = x.limbs[i]
    if x.count > 7:
        out.x.limbs[7] = x.limbs[7]
    out.y.count = y.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.y.limbs[i] = 0
    for i in 0..<y.count:
        out.y.limbs[i] = y.limbs[i]
    if y.count > 7:
        out.y.limbs[7] = y.limbs[7]
    out.inf = false

fn pointAssignInto(out: var EcPoint, src: EcPoint) =
    if src.inf:
        pointSetInfinityInto(out)
        return
    var x: bigint.BigInt = src.x
    var y: bigint.BigInt = src.y
    pointSetCoordsInto(out, x, y)

fn pointDoubleInto(out: var EcPoint, p: var EcPoint): Result[bool] =
    if p.inf:
        pointSetInto(out, p)
        return Ok[bool](true)
    var px: bigint.BigInt = p.x
    var py: bigint.BigInt = p.y
    if bigint.bigIsZero(py):
        pointSetInfinityInto(out)
        return Ok[bool](true)
    let x2Res: Result[bigint.BigInt] = p256ModMul(px, px)
    if IsErr(x2Res):
        return Err[bool](Error(x2Res))
    let dblRes: Result[bigint.BigInt] = p256ModAdd(Value(x2Res), Value(x2Res))
    if IsErr(dblRes):
        return Err[bool](Error(dblRes))
    let tripleRes: Result[bigint.BigInt] = p256ModAdd(Value(dblRes), Value(x2Res))
    if IsErr(tripleRes):
        return Err[bool](Error(tripleRes))
    let fieldModulus: bigint.BigInt = p256ConstP()
    let three: bigint.BigInt = bigint.bigFromInt(3)
    let aRes: Result[bigint.BigInt] = bigint.bigSub(fieldModulus, three)
    if IsErr(aRes):
        return Err[bool](Error(aRes))
    let numRes: Result[bigint.BigInt] = p256ModAdd(Value(tripleRes), Value(aRes))
    if IsErr(numRes):
        return Err[bool](Error(numRes))
    let denomRes: Result[bigint.BigInt] = p256ModAdd(py, py)
    if IsErr(denomRes):
        return Err[bool](Error(denomRes))
    let invRes: Result[bigint.BigInt] = p256ModInv(Value(denomRes))
    if IsErr(invRes):
        return Err[bool](Error(invRes))
    let lambdaRes: Result[bigint.BigInt] = p256ModMul(Value(numRes), Value(invRes))
    if IsErr(lambdaRes):
        return Err[bool](Error(lambdaRes))
    let lambda: bigint.BigInt = Value(lambdaRes)
    let lambda2Res: Result[bigint.BigInt] = p256ModMul(lambda, lambda)
    if IsErr(lambda2Res):
        return Err[bool](Error(lambda2Res))
    let twoXRes: Result[bigint.BigInt] = p256ModAdd(px, px)
    if IsErr(twoXRes):
        return Err[bool](Error(twoXRes))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(lambda2Res), Value(twoXRes))
    if IsErr(x3Res):
        return Err[bool](Error(x3Res))
    let x1MinusX3Res: Result[bigint.BigInt] = p256ModSub(px, Value(x3Res))
    if IsErr(x1MinusX3Res):
        return Err[bool](Error(x1MinusX3Res))
    let y3Res1: Result[bigint.BigInt] = p256ModMul(lambda, Value(x1MinusX3Res))
    if IsErr(y3Res1):
        return Err[bool](Error(y3Res1))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3Res1), py)
    if IsErr(y3Res):
        return Err[bool](Error(y3Res))
    let x3: bigint.BigInt = Value(x3Res)
    let y3: bigint.BigInt = Value(y3Res)
    pointSetCoordsInto(out, x3, y3)
    return Ok[bool](true)

fn pointDouble(p: EcPoint): Result[EcPoint] =
    var out: EcPoint
    if p.inf:
        pointSetInfinityInto(out)
        return Ok[EcPoint](out)
    var px: bigint.BigInt = p.x
    var py: bigint.BigInt = p.y
    if bigint.bigIsZero(py):
        pointSetInfinityInto(out)
        return Ok[EcPoint](out)
    let x2Res: Result[bigint.BigInt] = p256ModMul(px, px)
    if IsErr(x2Res):
        return Err[EcPoint](Error(x2Res))
    let dblRes: Result[bigint.BigInt] = p256ModAdd(Value(x2Res), Value(x2Res))
    if IsErr(dblRes):
        return Err[EcPoint](Error(dblRes))
    let tripleRes: Result[bigint.BigInt] = p256ModAdd(Value(dblRes), Value(x2Res))
    if IsErr(tripleRes):
        return Err[EcPoint](Error(tripleRes))
    let fieldModulus: bigint.BigInt = p256ConstP()
    let three: bigint.BigInt = bigint.bigFromInt(3)
    let aRes: Result[bigint.BigInt] = bigint.bigSub(fieldModulus, three)
    if IsErr(aRes):
        return Err[EcPoint](Error(aRes))
    let numRes: Result[bigint.BigInt] = p256ModAdd(Value(tripleRes), Value(aRes))
    if IsErr(numRes):
        return Err[EcPoint](Error(numRes))
    let denomRes: Result[bigint.BigInt] = p256ModAdd(py, py)
    if IsErr(denomRes):
        return Err[EcPoint](Error(denomRes))
    let invRes: Result[bigint.BigInt] = p256ModInv(Value(denomRes))
    if IsErr(invRes):
        return Err[EcPoint](Error(invRes))
    let lambdaRes: Result[bigint.BigInt] = p256ModMul(Value(numRes), Value(invRes))
    if IsErr(lambdaRes):
        return Err[EcPoint](Error(lambdaRes))
    let lambda: bigint.BigInt = Value(lambdaRes)
    let lambda2Res: Result[bigint.BigInt] = p256ModMul(lambda, lambda)
    if IsErr(lambda2Res):
        return Err[EcPoint](Error(lambda2Res))
    let twoXRes: Result[bigint.BigInt] = p256ModAdd(px, px)
    if IsErr(twoXRes):
        return Err[EcPoint](Error(twoXRes))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(lambda2Res), Value(twoXRes))
    if IsErr(x3Res):
        return Err[EcPoint](Error(x3Res))
    let x1MinusX3Res: Result[bigint.BigInt] = p256ModSub(px, Value(x3Res))
    if IsErr(x1MinusX3Res):
        return Err[EcPoint](Error(x1MinusX3Res))
    let y3Res1: Result[bigint.BigInt] = p256ModMul(lambda, Value(x1MinusX3Res))
    if IsErr(y3Res1):
        return Err[EcPoint](Error(y3Res1))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3Res1), py)
    if IsErr(y3Res):
        return Err[EcPoint](Error(y3Res))
    pointSetCoordsInto(out, Value(x3Res), Value(y3Res))
    return Ok[EcPoint](out)

fn pointAddInto(out: var EcPoint, p1: var EcPoint, p2: var EcPoint): Result[bool] =
    if p1.inf:
        pointSetInto(out, p2)
        return Ok[bool](true)
    if p2.inf:
        pointSetInto(out, p1)
        return Ok[bool](true)
    var p1x: bigint.BigInt = p1.x
    var p1y: bigint.BigInt = p1.y
    var p2x: bigint.BigInt = p2.x
    var p2y: bigint.BigInt = p2.y
    if bigint.bigCmp(p1x, p2x) == 0:
        let sumRes: Result[bigint.BigInt] = p256ModAdd(p1y, p2y)
        if IsErr(sumRes):
            return Err[bool](Error(sumRes))
        if bigint.bigIsZero(Value(sumRes)):
            pointSetInfinityInto(out)
            return Ok[bool](true)
        return pointDoubleInto(out, p1)
    let dyRes: Result[bigint.BigInt] = p256ModSub(p2y, p1y)
    if IsErr(dyRes):
        return Err[bool](Error(dyRes))
    let dxRes: Result[bigint.BigInt] = p256ModSub(p2x, p1x)
    if IsErr(dxRes):
        return Err[bool](Error(dxRes))
    let invRes: Result[bigint.BigInt] = p256ModInv(Value(dxRes))
    if IsErr(invRes):
        return Err[bool](Error(invRes))
    let lambdaRes: Result[bigint.BigInt] = p256ModMul(Value(dyRes), Value(invRes))
    if IsErr(lambdaRes):
        return Err[bool](Error(lambdaRes))
    let lambda: bigint.BigInt = Value(lambdaRes)
    let lambda2Res: Result[bigint.BigInt] = p256ModMul(lambda, lambda)
    if IsErr(lambda2Res):
        return Err[bool](Error(lambda2Res))
    let x3Res1: Result[bigint.BigInt] = p256ModSub(Value(lambda2Res), p1x)
    if IsErr(x3Res1):
        return Err[bool](Error(x3Res1))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(x3Res1), p2x)
    if IsErr(x3Res):
        return Err[bool](Error(x3Res))
    let x1MinusX3Res: Result[bigint.BigInt] = p256ModSub(p1x, Value(x3Res))
    if IsErr(x1MinusX3Res):
        return Err[bool](Error(x1MinusX3Res))
    let y3Res1: Result[bigint.BigInt] = p256ModMul(lambda, Value(x1MinusX3Res))
    if IsErr(y3Res1):
        return Err[bool](Error(y3Res1))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3Res1), p1y)
    if IsErr(y3Res):
        return Err[bool](Error(y3Res))
    let x3: bigint.BigInt = Value(x3Res)
    let y3: bigint.BigInt = Value(y3Res)
    pointSetCoordsInto(out, x3, y3)
    return Ok[bool](true)

fn pointAdd(p1: EcPoint, p2: EcPoint): Result[EcPoint] =
    var out: EcPoint
    if p1.inf:
        if p2.inf:
            pointSetInfinityInto(out)
            return Ok[EcPoint](out)
        var p2xOnly: bigint.BigInt = p2.x
        var p2yOnly: bigint.BigInt = p2.y
        pointSetCoordsInto(out, p2xOnly, p2yOnly)
        return Ok[EcPoint](out)
    if p2.inf:
        var p1xOnly: bigint.BigInt = p1.x
        var p1yOnly: bigint.BigInt = p1.y
        pointSetCoordsInto(out, p1xOnly, p1yOnly)
        return Ok[EcPoint](out)
    var p1x: bigint.BigInt = p1.x
    var p1y: bigint.BigInt = p1.y
    var p2x: bigint.BigInt = p2.x
    var p2y: bigint.BigInt = p2.y
    if bigint.bigCmp(p1x, p2x) == 0:
        let sumRes: Result[bigint.BigInt] = p256ModAdd(p1y, p2y)
        if IsErr(sumRes):
            return Err[EcPoint](Error(sumRes))
        if bigint.bigIsZero(Value(sumRes)):
            pointSetInfinityInto(out)
            return Ok[EcPoint](out)
        return pointDouble(p1)
    let dyRes: Result[bigint.BigInt] = p256ModSub(p2y, p1y)
    if IsErr(dyRes):
        return Err[EcPoint](Error(dyRes))
    let dxRes: Result[bigint.BigInt] = p256ModSub(p2x, p1x)
    if IsErr(dxRes):
        return Err[EcPoint](Error(dxRes))
    let invRes: Result[bigint.BigInt] = p256ModInv(Value(dxRes))
    if IsErr(invRes):
        return Err[EcPoint](Error(invRes))
    let lambdaRes: Result[bigint.BigInt] = p256ModMul(Value(dyRes), Value(invRes))
    if IsErr(lambdaRes):
        return Err[EcPoint](Error(lambdaRes))
    let lambda: bigint.BigInt = Value(lambdaRes)
    let lambda2Res: Result[bigint.BigInt] = p256ModMul(lambda, lambda)
    if IsErr(lambda2Res):
        return Err[EcPoint](Error(lambda2Res))
    let x3Res1: Result[bigint.BigInt] = p256ModSub(Value(lambda2Res), p1x)
    if IsErr(x3Res1):
        return Err[EcPoint](Error(x3Res1))
    let x3Res: Result[bigint.BigInt] = p256ModSub(Value(x3Res1), p2x)
    if IsErr(x3Res):
        return Err[EcPoint](Error(x3Res))
    let x1MinusX3Res: Result[bigint.BigInt] = p256ModSub(p1x, Value(x3Res))
    if IsErr(x1MinusX3Res):
        return Err[EcPoint](Error(x1MinusX3Res))
    let y3Res1: Result[bigint.BigInt] = p256ModMul(lambda, Value(x1MinusX3Res))
    if IsErr(y3Res1):
        return Err[EcPoint](Error(y3Res1))
    let y3Res: Result[bigint.BigInt] = p256ModSub(Value(y3Res1), p1y)
    if IsErr(y3Res):
        return Err[EcPoint](Error(y3Res))
    pointSetCoordsInto(out, Value(x3Res), Value(y3Res))
    return Ok[EcPoint](out)

fn pointMulInto(out: var EcPoint, k: bigint.BigInt, p: var EcPoint): Result[bool] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    if p.inf:
        pointSetInto(out, p)
        return Ok[bool](true)
    if bigint.bigIsZero(k):
        pointSetInfinityInto(out)
        return Ok[bool](true)
    let bitLen: int32 = bigint.bigBitLen(k)
    var result: EcPoint
    pointSetInfinityInto(result)
    var addend: EcPoint
    pointSetInto(addend, p)
    var bitIdx: int32
    for bitIdx in bitIdx..<bitLen:
        if bigint.bigGetBit(k, bitIdx) != 0:
            var nextResult: EcPoint
            let addRes: Result[bool] = pointAddInto(nextResult, result, addend)
            if IsErr(addRes):
                return Err[bool](Error(addRes))
            pointSetInto(result, nextResult)
        if bitIdx + 1 < bitLen:
            var nextAddend: EcPoint
            let dblRes: Result[bool] = pointDoubleInto(nextAddend, addend)
            if IsErr(dblRes):
                return Err[bool](Error(dblRes))
            pointSetInto(addend, nextAddend)
    pointSetInto(out, result)
    return Ok[bool](true)

fn pointMulJacobianInto(out: var EcPoint, k: bigint.BigInt, p: var EcPoint): Result[bool] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    if p.inf:
        pointSetInto(out, p)
        return Ok[bool](true)
    if bigint.bigIsZero(k):
        pointSetInfinityInto(out)
        return Ok[bool](true)
    let bitLen: int32 = bigint.bigBitLen(k)
    var result: EcPointJacobian = pointJacobianInfinity()
    var addend: EcPointJacobian = pointJacobianFromAffine(p)
    var bitIdx: int32
    for bitIdx in bitIdx..<bitLen:
        if bigint.bigGetBit(k, bitIdx) != 0:
            var nextResult: EcPointJacobian
            let addRes: Result[bool] = pointJacobianAddInto(nextResult, result, addend)
            if IsErr(addRes):
                return Err[bool](Error(addRes))
            result = nextResult
        if bitIdx + 1 < bitLen:
            var nextAddend: EcPointJacobian
            let dblRes: Result[bool] = pointJacobianDoubleInto(nextAddend, addend)
            if IsErr(dblRes):
                return Err[bool](Error(dblRes))
            addend = nextAddend
    return pointJacobianToAffineInto(out, result)

fn pointMul(k: bigint.BigInt, p: EcPoint): Result[EcPoint] =
    var result: EcPoint
    var base: EcPoint
    pointAssignInto(base, p)
    let mulRes: Result[bool] = pointMulJacobianInto(result, k, base)
    if IsErr(mulRes):
        return Err[EcPoint](Error(mulRes))
    return Ok[EcPoint](result)

fn pointMulGenerator(k: bigint.BigInt): Result[EcPoint] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[EcPoint](Error(initRes))
    if bigint.bigIsZero(k):
        return Ok[EcPoint](pointInfinity())
    var gxConst: bigint.BigInt
    var gyConst: bigint.BigInt
    p256ConstGxInto(gxConst)
    p256ConstGyInto(gyConst)
    var base: EcPoint
    pointSetCoordsInto(base, gxConst, gyConst)
    base.x.count = 8
    base.x.limbs[7] = gxConst.limbs[7]
    base.y.count = 8
    base.y.limbs[7] = gyConst.limbs[7]
    return pointMul(k, base)

fn pointMulGeneratorInto(out: var EcPoint, k: bigint.BigInt): Result[bool] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    if bigint.bigIsZero(k):
        pointSetInfinityInto(out)
        return Ok[bool](true)
    var gxConst: bigint.BigInt
    var gyConst: bigint.BigInt
    p256ConstGxInto(gxConst)
    p256ConstGyInto(gyConst)
    var base: EcPoint
    pointSetCoordsInto(base, gxConst, gyConst)
    base.x.count = 8
    base.x.limbs[7] = gxConst.limbs[7]
    base.y.count = 8
    base.y.limbs[7] = gyConst.limbs[7]
    return pointMulJacobianInto(out, k, base)

fn pointMulGeneratorFixed(k: bigint.BigInt): Result[EcPointFixed] =
    let initRes: Result[bool] = p256EnsureFixedInit()
    if IsErr(initRes):
        return Err[EcPointFixed](Error(initRes))
    if bigint.bigIsZero(k):
        return Ok[EcPointFixed](pointInfinityFixed())
    var scalarBig: bigint.BigInt = k
    let scalarRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(scalarBig)
    if IsErr(scalarRes):
        return Err[EcPointFixed](Error(scalarRes))
    var scalar: pfix.P256Fixed = Value(scalarRes)
    var nBig: bigint.BigInt = p256ConstN()
    let nModulusRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(nBig)
    if IsErr(nModulusRes):
        return Err[EcPointFixed](Error(nModulusRes))
    var nModulus: pfix.P256Fixed = Value(nModulusRes)
    if pfix.p256FixedCmp(scalar, nModulus) >= 0:
        return Err[EcPointFixed]("ecdsa: scalar out of range")
    return pointMulGeneratorWnafFixed(scalar)

fn p256Hash(msg: Bytes): Result[bigint.BigInt] =
    let digest: Bytes = Sha256Digest(msg)
    return bigint.bigFromBytes(digest)

fn p256DeterministicConcat4(a: Bytes, b: Bytes, c: Bytes, d: Bytes): Bytes =
    let total: int32 = BytesLen(a) + BytesLen(b) + BytesLen(c) + BytesLen(d)
    var out: Bytes = BytesAlloc(total)
    var offset: int32
    BytesCopyInto(out, offset, a)
    offset = offset + BytesLen(a)
    BytesCopyInto(out, offset, b)
    offset = offset + BytesLen(b)
    BytesCopyInto(out, offset, c)
    offset = offset + BytesLen(c)
    BytesCopyInto(out, offset, d)
    return out

fn p256DeterministicFilledBytes(fill: int32): Bytes =
    var out: Bytes = BytesAlloc(hkdf.sha256Size)
    rawmem_support.RawmemSet(out.data, fill, hkdf.sha256Size)
    return out

@borrows
fn p256DeterministicK(priv: bigint.BigInt, msg: Bytes): Result[bigint.BigInt] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bigint.BigInt](Error(initRes))
    let xBytes: Bytes = bigint.bigToBytes(priv, p256ScalarSize)
    let h1: Bytes = Sha256Digest(msg)
    var v: Bytes = p256DeterministicFilledBytes(0x01)
    var k: Bytes = p256DeterministicFilledBytes(0x00)
    let zero: Bytes = bytesFromByte(0x00)
    let one: Bytes = bytesFromByte(0x01)
    let seed0: Bytes = p256DeterministicConcat4(v, zero, xBytes, h1)
    let k1: Bytes = hmacSha256(k, seed0)
    k = k1
    v = hmacSha256(k, v)
    let seed1: Bytes = p256DeterministicConcat4(v, one, xBytes, h1)
    k = hmacSha256(k, seed1)
    v = hmacSha256(k, v)
    let modulus: bigint.BigInt = p256ConstN()
    for attempt in 0..<64:
        v = hmacSha256(k, v)
        let tRes: Result[bigint.BigInt] = bigint.bigFromBytes(v)
        if IsErr(tRes):
            return Err[bigint.BigInt](Error(tRes))
        let candidate: bigint.BigInt = Value(tRes)
        if ! bigint.bigIsZero(candidate) && bigint.bigCmp(candidate, modulus) < 0:
            return Ok[bigint.BigInt](candidate)
        let retrySeed: Bytes = BytesConcat(v, zero)
        k = hmacSha256(k, retrySeed)
        v = hmacSha256(k, v)
    return Err[bigint.BigInt]("ecdsa: failed to derive nonce")

fn publicKeyFromPrivateKey(priv: EcPrivateKey): Result[EcPublicKey] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[EcPublicKey](Error(initRes))
    let pointRes: Result[EcPointFixed] = pointMulGeneratorFixed(priv.d)
    if IsErr(pointRes):
        return Err[EcPublicKey](Error(pointRes))
    let pointFixed: EcPointFixed = Value(pointRes)
    if pointFixed.inf:
        return Err[EcPublicKey]("ecdsa: public key at infinity")
    return Ok[EcPublicKey](EcPublicKey(point: pointBigFromFixed(pointFixed)))

fn generateEcKeyPair(): Result[EcKeyPair] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[EcKeyPair](Error(initRes))
    var attempt: int32
    for _ in attempt..<100:
        if ! (attempt < 100):
            break
        let privRes: Result[Bytes] = randomBytes(p256ScalarSize)
        if IsErr(privRes):
            return Err[EcKeyPair](Error(privRes))
        let dRes: Result[bigint.BigInt] = bigint.bigFromBytes(Value(privRes))
        if IsErr(dRes):
            return Err[EcKeyPair](Error(dRes))
        let d: bigint.BigInt = Value(dRes)
        let modulus: bigint.BigInt = p256ConstN()
        if bigint.bigIsZero(d) || bigint.bigCmp(d, modulus) >= 0:
            attempt = attempt + 1
            continue
        let priv: EcPrivateKey = EcPrivateKey(d: d)
        let pubRes: Result[EcPublicKey] = publicKeyFromPrivateKey(priv)
        if IsErr(pubRes):
            return Err[EcKeyPair](Error(pubRes))
        return Ok[EcKeyPair](EcKeyPair(publicKey: Value(pubRes), privateKey: priv))
    return Err[EcKeyPair]("ecdsa: failed to generate key")

@borrows
fn ecdsaSignScalarResult(d: bigint.BigInt, msg: Bytes): Result[EcSignature] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[EcSignature](Error(initRes))
    let modulus: bigint.BigInt = p256ConstN()
    if bigint.bigIsZero(d) || bigint.bigCmp(d, modulus) >= 0:
        return Err[EcSignature]("ecdsa: invalid private key")
    let eFixedRes: Result[pfix.P256Fixed] = p256ScalarFixedFromSha256(msg)
    if IsErr(eFixedRes):
        return Err[EcSignature](Error(eFixedRes))
    let dFixedRes: Result[pfix.P256Fixed] = ecdsaScalarToFixed(d)
    if IsErr(dFixedRes):
        return Err[EcSignature](Error(dFixedRes))
    let kRes: Result[bigint.BigInt] = p256DeterministicK(d, msg)
    if IsErr(kRes):
        return Err[EcSignature](Error(kRes))
    let k: bigint.BigInt = Value(kRes)
    let kFixedRes: Result[pfix.P256Fixed] = ecdsaScalarToFixed(k)
    if IsErr(kFixedRes):
        return Err[EcSignature](Error(kFixedRes))
    let rRes: Result[bigint.BigInt] = pointMulGeneratorRFixedBig(Value(kFixedRes))
    if IsErr(rRes):
        return Err[EcSignature](Error(rRes))
    let r: bigint.BigInt = Value(rRes)
    if bigint.bigIsZero(r):
        return Err[EcSignature]("ecdsa: r is zero")
    let rFixedRes: Result[pfix.P256Fixed] = ecdsaScalarToFixed(r)
    if IsErr(rFixedRes):
        return Err[EcSignature](Error(rFixedRes))
    let rdRes: Result[pfix.P256Fixed] = p256ScalarFixedMul(Value(rFixedRes), Value(dFixedRes))
    if IsErr(rdRes):
        return Err[EcSignature](Error(rdRes))
    var scalarModulus: pfix.P256Fixed = pfix.p256ScalarModulus()
    let sumRes: Result[pfix.P256Fixed] = pfix.p256FixedModAdd(Value(eFixedRes), Value(rdRes), scalarModulus)
    if IsErr(sumRes):
        return Err[EcSignature](Error(sumRes))
    let kInvRes: Result[pfix.P256Fixed] = p256ScalarFixedInv(Value(kFixedRes))
    if IsErr(kInvRes):
        return Err[EcSignature](Error(kInvRes))
    let sFixedRes: Result[pfix.P256Fixed] = p256ScalarFixedMul(Value(kInvRes), Value(sumRes))
    if IsErr(sFixedRes):
        return Err[EcSignature](Error(sFixedRes))
    var sFixed: pfix.P256Fixed = Value(sFixedRes)
    var s: bigint.BigInt = pfix.p256FixedToBigInt(sFixed)
    if bigint.bigIsZero(s):
        return Err[EcSignature]("ecdsa: s is zero")
    let halfModulus: bigint.BigInt = p256ConstNHalf()
    if bigint.bigCmp(s, halfModulus) > 0:
        let subRes: Result[bigint.BigInt] = bigint.bigSub(modulus, s)
        if IsErr(subRes):
            return Err[EcSignature](Error(subRes))
        s = Value(subRes)
    return Ok[EcSignature](EcSignature(r: r, s: s))

fn ecdsaSignScalarCore(d: bigint.BigInt, msg: Bytes, rOut: var bigint.BigInt, sOut: var bigint.BigInt): Result[bool] =
    let sigRes: Result[EcSignature] = ecdsaSignScalarResult(d, msg)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    let sig: EcSignature = Value(sigRes)
    rOut = sig.r
    sOut = sig.s
    return Ok[bool](true)

fn ecdsaVerifyPublicXYScalars(pubX: var bigint.BigInt,
                              pubY: var bigint.BigInt,
                              requireCurveCheck: bool,
                              msg: Bytes,
                              r: bigint.BigInt,
                              s: bigint.BigInt): bool =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return false
    if bigint.bigIsZero(pubX) || bigint.bigIsZero(pubY):
        return false
    if bigint.bigIsZero(r) || bigint.bigIsZero(s):
        return false
    let modulus: bigint.BigInt = p256ConstN()
    if bigint.bigCmp(r, modulus) >= 0 || bigint.bigCmp(s, modulus) >= 0:
        return false
    var verifyS: bigint.BigInt
    p256BigSetInto(verifyS, s)
    if requireCurveCheck:
        let onCurveRes: Result[bool] = pointCoordsAreOnCurve(pubX, pubY)
        if IsErr(onCurveRes) || ! Value(onCurveRes):
            return false
    let eRes: Result[bigint.BigInt] = p256Hash(msg)
    if IsErr(eRes):
        return false
    let eModRes: Result[bigint.BigInt] = nMod(Value(eRes))
    if IsErr(eModRes):
        return false
    let wRes: Result[bigint.BigInt] = nModInv(verifyS)
    if IsErr(wRes):
        return false
    var eMod: bigint.BigInt
    p256BigSetInto(eMod, Value(eModRes))
    var w: bigint.BigInt
    p256BigSetInto(w, Value(wRes))
    var u1: bigint.BigInt
    let u1Res: Result[bool] = nModMulInto(u1, eMod, w)
    if IsErr(u1Res):
        return false
    var rLocal: bigint.BigInt
    p256BigSetInto(rLocal, r)
    var u2: bigint.BigInt
    let u2Res: Result[bool] = nModMulInto(u2, rLocal, w)
    if IsErr(u2Res):
        return false
    let xRes: Result[bigint.BigInt] = ecdsaVerifyShamirXBig(u1, u2, pubX, pubY)
    if IsErr(xRes):
        return false
    return bigint.bigCmp(Value(xRes), r) == 0

fn ecdsaVerifyPointScalars(pubPoint: var EcPoint,
                           requireCurveCheck: bool,
                           msg: Bytes,
                           r: bigint.BigInt,
                           s: bigint.BigInt): bool =
    if pubPoint.inf:
        return false
    var pubX: bigint.BigInt
    var pubY: bigint.BigInt
    p256BigSetInto(pubX, pubPoint.x)
    p256BigSetInto(pubY, pubPoint.y)
    return ecdsaVerifyPublicXYScalars(pubX, pubY, requireCurveCheck, msg, r, s)

fn ecdsaSign(priv: EcPrivateKey, msg: Bytes): Result[EcSignature] =
    return ecdsaSignScalarResult(priv.d, msg)

@borrows
fn ecdsaScalarToFixed(a: bigint.BigInt): Result[pfix.P256Fixed] =
    var aBig: bigint.BigInt
    p256BigSetInto(aBig, a)
    return pfix.p256FixedFromBigInt(aBig)

fn p256ScalarFixedReduceOnceInto(value: var pfix.P256Fixed) =
    var modulus: pfix.P256Fixed = pfix.p256ScalarModulus()
    if pfix.p256FixedCmp(value, modulus) >= 0:
        var reduced: pfix.P256Fixed
        pfix.p256FixedModSubTrustedInto(reduced, value, modulus, modulus)
        p256FixedCopyInto(value, reduced)

@borrows
fn p256ScalarFixedFromSha256(msg: Bytes): Result[pfix.P256Fixed] =
    let digest: Bytes = Sha256Digest(msg)
    let fixedRes: Result[pfix.P256Fixed] = pfix.p256FixedReadBytesBE32(digest, 0)
    if IsErr(fixedRes):
        return Err[pfix.P256Fixed](Error(fixedRes))
    var out: pfix.P256Fixed
    p256FixedCopyInto(out, Value(fixedRes))
    p256ScalarFixedReduceOnceInto(out)
    return Ok[pfix.P256Fixed](out)

fn p256ScalarFixedMul(a: pfix.P256Fixed, b: pfix.P256Fixed): Result[pfix.P256Fixed] =
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    var bb: pfix.P256Fixed
    p256FixedCopyInto(bb, b)
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256ScalarMontgomeryContext()
    let out: pfix.P256Fixed = pfix.p256FixedModMulWithContextTrusted(aa, bb, ctx)
    return Ok[pfix.P256Fixed](out)

fn p256ScalarFixedInv(a: pfix.P256Fixed): Result[pfix.P256Fixed] =
    var aa: pfix.P256Fixed
    p256FixedCopyInto(aa, a)
    if pfix.p256FixedIsZero(aa):
        return Err[pfix.P256Fixed]("ecdsa: inverse of zero")
    var ctx: pfix.P256FixedMontgomeryContext = pfix.p256ScalarMontgomeryContext()
    var exp: pfix.P256Fixed
    p256FixedCopyFromVarInto(exp, p256NMinus2Fixed)
    let out: pfix.P256Fixed = pfix.p256FixedModExpWithContextTrusted(aa, exp, ctx)
    return Ok[pfix.P256Fixed](out)

@borrows
fn ecdsaParseSignatureFixedBytes(data: Bytes,
                                 rOut: var pfix.P256Fixed,
                                 sOut: var pfix.P256Fixed): Result[bool] =
    if BytesLen(data) != p256SignatureSize:
        return Err[bool]("ecdsa: invalid signature length")
    let rFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedReadBytesBE32(data, 0)
    if IsErr(rFixedRes):
        return Err[bool](Error(rFixedRes))
    let sFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedReadBytesBE32(data, p256ScalarSize)
    if IsErr(sFixedRes):
        return Err[bool](Error(sFixedRes))
    p256FixedCopyInto(rOut, Value(rFixedRes))
    p256FixedCopyInto(sOut, Value(sFixedRes))
    if pfix.p256FixedIsZero(rOut) || pfix.p256FixedIsZero(sOut):
        return Err[bool]("ecdsa: invalid signature value")
    var modulus: pfix.P256Fixed = pfix.p256ScalarModulus()
    if pfix.p256FixedCmp(rOut, modulus) >= 0 || pfix.p256FixedCmp(sOut, modulus) >= 0:
        return Err[bool]("ecdsa: signature out of range")
    return Ok[bool](true)

@borrows
fn ecdsaVerifyFixedPointSignatureBytes(pubPoint: EcPointFixed, msg: Bytes, sig: Bytes): bool =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return false
    if pubPoint.inf:
        return false
    var r: pfix.P256Fixed
    var s: pfix.P256Fixed
    let sigRes: Result[bool] = ecdsaParseSignatureFixedBytes(sig, r, s)
    if IsErr(sigRes):
        return false
    let eRes: Result[pfix.P256Fixed] = p256ScalarFixedFromSha256(msg)
    if IsErr(eRes):
        return false
    let wRes: Result[pfix.P256Fixed] = p256ScalarFixedInv(s)
    if IsErr(wRes):
        return false
    let u1Res: Result[pfix.P256Fixed] = p256ScalarFixedMul(Value(eRes), Value(wRes))
    if IsErr(u1Res):
        return false
    let u2Res: Result[pfix.P256Fixed] = p256ScalarFixedMul(r, Value(wRes))
    if IsErr(u2Res):
        return false
    var pubLocal: EcPointFixed
    pointFixedSetInto(pubLocal, pubPoint)
    let sumRes: Result[EcPointJacobianFixed] = pointMulGeneratorAndFixedShamir(Value(u1Res), Value(u2Res), pubLocal)
    if IsErr(sumRes):
        return false
    var sumPoint: EcPointJacobianFixed
    pointJacobianFixedSetInto(sumPoint, Value(sumRes))
    if sumPoint.inf || pfix.p256FixedIsZero(sumPoint.z):
        return false
    var x: pfix.P256Fixed = pointJacobianXToScalarFixedCrash(sumPoint)
    let rBig: bigint.BigInt = pfix.p256FixedToBigInt(r)
    let xBig: bigint.BigInt = pfix.p256FixedToBigInt(x)
    let rBytes: Bytes = bigint.bigToBytes(rBig, p256ScalarSize)
    let xBytes: Bytes = bigint.bigToBytes(xBig, p256ScalarSize)
    if BytesLen(rBytes) != p256ScalarSize || BytesLen(xBytes) != p256ScalarSize:
        return false
    return bigint.bigCmp(xBig, rBig) == 0

fn ecdsaVerifyFixedPointScalars(pubPoint: EcPointFixed,
                                msg: Bytes,
                                r: bigint.BigInt,
                                s: bigint.BigInt): bool =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return false
    if pubPoint.inf:
        return false
    if bigint.bigIsZero(r) || bigint.bigIsZero(s):
        return false
    let modulus: bigint.BigInt = p256ConstN()
    if bigint.bigCmp(r, modulus) >= 0 || bigint.bigCmp(s, modulus) >= 0:
        return false
    var verifyS: bigint.BigInt
    p256BigSetInto(verifyS, s)
    let eRes: Result[bigint.BigInt] = p256Hash(msg)
    if IsErr(eRes):
        return false
    let eModRes: Result[bigint.BigInt] = nMod(Value(eRes))
    if IsErr(eModRes):
        return false
    let wRes: Result[bigint.BigInt] = nModInv(verifyS)
    if IsErr(wRes):
        return false
    var eMod: bigint.BigInt
    p256BigSetInto(eMod, Value(eModRes))
    var w: bigint.BigInt
    p256BigSetInto(w, Value(wRes))
    var u1: bigint.BigInt
    let u1Res: Result[bool] = nModMulInto(u1, eMod, w)
    if IsErr(u1Res):
        return false
    var rLocal: bigint.BigInt
    p256BigSetInto(rLocal, r)
    var u2: bigint.BigInt
    let u2Res: Result[bool] = nModMulInto(u2, rLocal, w)
    if IsErr(u2Res):
        return false
    let u1FixedRes: Result[pfix.P256Fixed] = ecdsaScalarToFixed(u1)
    if IsErr(u1FixedRes):
        return false
    let u2FixedRes: Result[pfix.P256Fixed] = ecdsaScalarToFixed(u2)
    if IsErr(u2FixedRes):
        return false
    var pubLocal: EcPointFixed
    pointFixedSetInto(pubLocal, pubPoint)
    let sumRes: Result[EcPointJacobianFixed] = pointMulGeneratorAndFixedShamir(Value(u1FixedRes), Value(u2FixedRes), pubLocal)
    if IsErr(sumRes):
        return false
    var sumPoint: EcPointJacobianFixed
    pointJacobianFixedSetInto(sumPoint, Value(sumRes))
    let xRes: Result[bigint.BigInt] = pointJacobianXToScalarBigInt(sumPoint)
    if IsErr(xRes):
        return false
    return bigint.bigCmp(Value(xRes), r) == 0

fn ecdsaVerifyShamirX(pubPoint: EcPoint,
                      u1: pfix.P256Fixed,
                      u2: pfix.P256Fixed): Result[pfix.P256Fixed] =
    let pubFixedRes: Result[EcPointFixed] = pointFixedFromBig(pubPoint)
    if IsErr(pubFixedRes):
        return Err[pfix.P256Fixed](Error(pubFixedRes))
    let sumRes: Result[EcPointJacobianFixed] = pointMulGeneratorAndFixedShamir(u1, u2, Value(pubFixedRes))
    if IsErr(sumRes):
        return Err[pfix.P256Fixed](Error(sumRes))
    let sumPoint: EcPointJacobianFixed = Value(sumRes)
    if sumPoint.inf || pfix.p256FixedIsZero(sumPoint.z):
        return Err[pfix.P256Fixed]("ecdsa: verify infinity")
    return Ok[pfix.P256Fixed](pointJacobianXToScalarFixedCrash(sumPoint))

fn ecdsaVerifyShamirXFixedBig(pubPoint: EcPoint,
                              u1: pfix.P256Fixed,
                              u2: pfix.P256Fixed): Result[bigint.BigInt] =
    let pubFixedRes: Result[EcPointFixed] = pointFixedFromBig(pubPoint)
    if IsErr(pubFixedRes):
        return Err[bigint.BigInt](Error(pubFixedRes))
    let sumRes: Result[EcPointJacobianFixed] = pointMulGeneratorAndFixedShamir(u1, u2, Value(pubFixedRes))
    if IsErr(sumRes):
        return Err[bigint.BigInt](Error(sumRes))
    let sumPoint: EcPointJacobianFixed = Value(sumRes)
    if sumPoint.inf || pfix.p256FixedIsZero(sumPoint.z):
        return Err[bigint.BigInt]("ecdsa: verify infinity")
    return pointJacobianXToScalarBigInt(sumPoint)

fn ecdsaVerify(pub: EcPublicKey, msg: Bytes, sig: EcSignature): bool =
    var point: EcPoint = pub.point
    return ecdsaVerifyPointScalars(point, true, msg, sig.r, sig.s)

fn ecdsaVerifyTrustedPublicKey(pub: EcPublicKey, msg: Bytes, sig: EcSignature): bool =
    var point: EcPoint = pub.point
    return ecdsaVerifyPointScalars(point, false, msg, sig.r, sig.s)

fn ecdsaPublicKeyXYRequireCurve(x: var bigint.BigInt, y: var bigint.BigInt): Result[bool] =
    let onCurveRes: Result[bool] = pointCoordsAreOnCurve(x, y)
    if !IsErr(onCurveRes):
        if Value(onCurveRes):
            return Ok[bool](true)
    let xFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(x)
    let yFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(y)
    if IsErr(xFixedRes) || IsErr(yFixedRes):
        return Err[bool]("ecdsa: point ! on curve")
    let xMontRes: Result[pfix.P256Fixed] = p256FieldFixedToMont(Value(xFixedRes))
    let yMontRes: Result[pfix.P256Fixed] = p256FieldFixedToMont(Value(yFixedRes))
    if IsErr(xMontRes) || IsErr(yMontRes):
        return Err[bool]("ecdsa: point ! on curve")
    var fixedPoint: EcPointFixed
    pointFixedSetCoordsInto(fixedPoint, Value(xMontRes), Value(yMontRes))
    let fixedCheckRes: Result[bool] = pointIsOnCurveFixed(fixedPoint)
    if IsErr(fixedCheckRes) || !Value(fixedCheckRes):
        return Err[bool]("ecdsa: point ! on curve")
    return Ok[bool](true)

@borrows
fn ecdsaParsePublicKeyXYBytes(data: Bytes,
                              requireCurveCheck: bool,
                              xOut: var bigint.BigInt,
                              yOut: var bigint.BigInt): Result[bool] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    if BytesLen(data) != p256PublicSize:
        return Err[bool]("ecdsa: invalid public key length")
    if BytesGet(data, 0) != 0x04:
        return Err[bool]("ecdsa: invalid public key prefix")
    let xRes: Result[bigint.BigInt] = bigint.bigFromBytes(BytesSliceView(data, 1, p256ScalarSize))
    if IsErr(xRes):
        return Err[bool](Error(xRes))
    let yRes: Result[bigint.BigInt] = bigint.bigFromBytes(BytesSliceView(data, 1 + p256ScalarSize, p256ScalarSize))
    if IsErr(yRes):
        return Err[bool](Error(yRes))
    var x: bigint.BigInt
    var y: bigint.BigInt
    p256BigSetInto(x, Value(xRes))
    p256BigSetInto(y, Value(yRes))
    let fieldModulus: bigint.BigInt = p256ConstP()
    if bigint.bigCmp(x, fieldModulus) >= 0 || bigint.bigCmp(y, fieldModulus) >= 0:
        return Err[bool]("ecdsa: point out of range")
    if requireCurveCheck:
        let curveRes = ecdsaPublicKeyXYRequireCurve(x, y)
        if IsErr(curveRes):
            return curveRes
    p256BigSetInto(xOut, x)
    p256BigSetInto(yOut, y)
    return Ok[bool](true)

@borrows
fn ecdsaParsePublicKeyPointBytes(data: Bytes,
                                 requireCurveCheck: bool,
                                 out: var EcPoint): Result[bool] =
    var x: bigint.BigInt
    var y: bigint.BigInt
    let xyRes: Result[bool] = ecdsaParsePublicKeyXYBytes(data, requireCurveCheck, x, y)
    if IsErr(xyRes):
        return Err[bool](Error(xyRes))
    pointSetCoordsInto(out, x, y)
    return Ok[bool](true)

@borrows
fn ecdsaParsePrivateScalarBytes(data: Bytes, out: var bigint.BigInt): Result[bool] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    if BytesLen(data) != p256ScalarSize:
        return Err[bool]("ecdsa: invalid private key length")
    let dRes: Result[bigint.BigInt] = bigint.bigFromBytes(data)
    if IsErr(dRes):
        return Err[bool](Error(dRes))
    p256BigSetInto(out, Value(dRes))
    let modulus: bigint.BigInt = p256ConstN()
    if bigint.bigIsZero(out) || bigint.bigCmp(out, modulus) >= 0:
        return Err[bool]("ecdsa: invalid private key value")
    return Ok[bool](true)

fn ecdsaParseSignatureScalarsBytes(data: Bytes, rOut: var bigint.BigInt, sOut: var bigint.BigInt): Result[bool] =
    let initRes: Result[bool] = p256EnsureInit()
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    if BytesLen(data) != p256SignatureSize:
        return Err[bool]("ecdsa: invalid signature length")
    let rFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedReadBytesBE32(data, 0)
    if IsErr(rFixedRes):
        return Err[bool](Error(rFixedRes))
    let sFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedReadBytesBE32(data, p256ScalarSize)
    if IsErr(sFixedRes):
        return Err[bool](Error(sFixedRes))
    var rFixed: pfix.P256Fixed
    p256FixedCopyInto(rFixed, Value(rFixedRes))
    var sFixed: pfix.P256Fixed
    p256FixedCopyInto(sFixed, Value(sFixedRes))
    if pfix.p256FixedIsZero(rFixed) || pfix.p256FixedIsZero(sFixed):
        return Err[bool]("ecdsa: invalid signature value")
    var modulus: pfix.P256Fixed = pfix.p256ScalarModulus()
    if pfix.p256FixedCmp(rFixed, modulus) >= 0 || pfix.p256FixedCmp(sFixed, modulus) >= 0:
        return Err[bool]("ecdsa: signature out of range")
    let rBig: bigint.BigInt = pfix.p256FixedToBigInt(rFixed)
    let sBig: bigint.BigInt = pfix.p256FixedToBigInt(sFixed)
    p256BigSetInto(rOut, rBig)
    p256BigSetInto(sOut, sBig)
    return Ok[bool](true)

fn ecdsaPublicPointToBytes(point: EcPoint): Bytes =
    let out: Bytes = BytesAlloc(p256PublicSize)
    BytesSet(out, 0, 0x04)
    let xBytes: Bytes = bigint.bigToBytes(point.x, p256ScalarSize)
    let yBytes: Bytes = bigint.bigToBytes(point.y, p256ScalarSize)
    BytesCopyInto(out, 1, xBytes)
    BytesCopyInto(out, 1 + p256ScalarSize, yBytes)
    return out

fn ecdsaPublicPointFixedToBytes(point: EcPointFixed): Bytes =
    Assert(!point.inf, "ecdsa: invalid public point at infinity")
    let xNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(point.x)
    let xNormFailed: bool = IsErr(xNormRes)
    Assert(!xNormFailed, "ecdsa: public x fromMont failed")
    let yNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(point.y)
    let yNormFailed: bool = IsErr(yNormRes)
    Assert(!yNormFailed, "ecdsa: public y fromMont failed")
    var xNorm: pfix.P256Fixed = Value(xNormRes)
    var yNorm: pfix.P256Fixed = Value(yNormRes)
    let xBig: bigint.BigInt = pfix.p256FixedToBigInt(xNorm)
    let yBig: bigint.BigInt = pfix.p256FixedToBigInt(yNorm)
    let out: Bytes = BytesAlloc(p256PublicSize)
    BytesSet(out, 0, 0x04)
    let xBytes: Bytes = bigint.bigToBytes(xBig, p256ScalarSize)
    let yBytes: Bytes = bigint.bigToBytes(yBig, p256ScalarSize)
    BytesCopyInto(out, 1, xBytes)
    BytesCopyInto(out, 1 + p256ScalarSize, yBytes)
    return out

fn ecdsaSignatureScalarsToBytes(r: bigint.BigInt, s: bigint.BigInt): Bytes =
    let out: Bytes = BytesAlloc(p256SignatureSize)
    let rBytes: Bytes = bigint.bigToBytes(r, p256ScalarSize)
    let sBytes: Bytes = bigint.bigToBytes(s, p256ScalarSize)
    BytesCopyInto(out, 0, rBytes)
    BytesCopyInto(out, p256ScalarSize, sBytes)
    return out

fn ecdsaVerifyTrustedPublicKeyBytes(pubBytes: Bytes, msg: Bytes, sig: EcSignature): Result[bool] =
    var pubPoint: EcPointFixed
    let pubLocal: Bytes = ecdsaBytesOwnedCopy(pubBytes)
    let pointRes: Result[bool] = ecdsaParsePublicKeyPointFixedBytes(pubLocal, false, pubPoint)
    if IsErr(pointRes):
        return Err[bool](Error(pointRes))
    return Ok[bool](ecdsaVerifyFixedPointScalars(pubPoint, msg, sig.r, sig.s))

fn ecdsaPublicKeyBytesValid(pubBytes: Bytes): bool =
    var point: EcPointFixed
    let pointRes: Result[bool] = ecdsaParsePublicKeyPointFixedBytes(pubBytes, true, point)
    return IsOk(pointRes)

fn ecdsaPublicKeyToBytes(pub: EcPublicKey): Bytes =
    return ecdsaPublicPointToBytes(pub.point)

fn ecdsaPrivateKeyToBytes(priv: EcPrivateKey): Bytes =
    return bigint.bigToBytes(priv.d, p256ScalarSize)

fn ecdsaSignatureToBytes(sig: EcSignature): Bytes =
    return ecdsaSignatureScalarsToBytes(sig.r, sig.s)

fn ecdsaPublicKeyFromBytes(data: Bytes): Result[EcPublicKey] =
    var point: EcPoint
    let pointRes: Result[bool] = ecdsaParsePublicKeyPointBytes(data, true, point)
    if IsErr(pointRes):
        return Err[EcPublicKey](Error(pointRes))
    return Ok[EcPublicKey](EcPublicKey(point: point))

fn ecdsaTrustedPublicKeyFromBytes(data: Bytes): Result[EcPublicKey] =
    var point: EcPoint
    let pointRes: Result[bool] = ecdsaParsePublicKeyPointBytes(data, false, point)
    if IsErr(pointRes):
        return Err[EcPublicKey](Error(pointRes))
    return Ok[EcPublicKey](EcPublicKey(point: point))

fn ecdsaPrivateKeyFromBytes(data: Bytes): Result[EcPrivateKey] =
    var d: bigint.BigInt
    let dRes: Result[bool] = ecdsaParsePrivateScalarBytes(data, d)
    if IsErr(dRes):
        return Err[EcPrivateKey](Error(dRes))
    return Ok[EcPrivateKey](EcPrivateKey(d: d))

fn ecdsaSignatureFromBytes(data: Bytes): Result[EcSignature] =
    var r: bigint.BigInt
    var s: bigint.BigInt
    let sigRes: Result[bool] = ecdsaParseSignatureScalarsBytes(data, r, s)
    if IsErr(sigRes):
        return Err[EcSignature](Error(sigRes))
    return Ok[EcSignature](EcSignature(r: r, s: s))

fn validateEcdsaPublicKeyBytes(data: Bytes): bool =
    var point: EcPoint
    let pointRes: Result[bool] = ecdsaParsePublicKeyPointBytes(data, true, point)
    return IsOk(pointRes)

fn validateEcdsaTrustedPublicKeyBytes(data: Bytes): bool =
    var point: EcPoint
    let pointRes: Result[bool] = ecdsaParsePublicKeyPointBytes(data, false, point)
    return IsOk(pointRes)

@borrows
fn validateEcdsaPrivateKeyBytes(data: Bytes): bool =
    var d: bigint.BigInt
    let dRes: Result[bool] = ecdsaParsePrivateScalarBytes(data, d)
    return IsOk(dRes)

fn validateEcdsaSignatureBytes(data: Bytes): bool =
    var r: bigint.BigInt
    var s: bigint.BigInt
    let sigRes: Result[bool] = ecdsaParseSignatureScalarsBytes(data, r, s)
    return IsOk(sigRes)

fn EcdsaNativeSignP256Sha256WithPublic(privData: Bytes, pubData: Bytes, msg: Bytes): Result[Bytes] =
    pubData
    return ecdsaSignBytes(privData, msg)

@borrows
fn ecdsaSignBytes(privData: Bytes, msg: Bytes): Result[Bytes] =
    var d: bigint.BigInt
    let dRes: Result[bool] = ecdsaParsePrivateScalarBytes(privData, d)
    if IsErr(dRes):
        return Err[Bytes](Error(dRes))
    let sigRes: Result[EcSignature] = ecdsaSignScalarResult(d, msg)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    let sig: EcSignature = Value(sigRes)
    let sigBytes: Bytes = ecdsaSignatureScalarsToBytes(sig.r, sig.s)
    return Ok[Bytes](sigBytes)

fn ecdsaVerifyBytes(pubData: Bytes, msg: Bytes, sig: Bytes): bool =
    let pubLocal: Bytes = ecdsaBytesOwnedCopy(pubData)
    let sigLocal: Bytes = ecdsaBytesOwnedCopy(sig)
    var pubPoint: EcPointFixed
    let pointRes = ecdsaParsePublicKeyPointFixedBytes(pubLocal, true, pubPoint)
    if IsErr(pointRes):
        return false
    return ecdsaVerifyFixedPointSignatureBytes(pubPoint, msg, sigLocal)

@borrows
fn ecdsaVerifyTrustedBytes(pubData: Bytes, msg: Bytes, sig: Bytes): bool =
    let pubLocal: Bytes = ecdsaBytesOwnedCopy(pubData)
    let sigLocal: Bytes = ecdsaBytesOwnedCopy(sig)
    var pubPoint: EcPointFixed
    let pointRes: Result[bool] = ecdsaParsePublicKeyPointFixedBytes(pubLocal, false, pubPoint)
    if IsErr(pointRes):
        return false
    return ecdsaVerifyFixedPointSignatureBytes(pubPoint, msg, sigLocal)

fn ecdsaPublicKeyFromPrivateBytes(privData: Bytes): Result[Bytes] =
    var d: bigint.BigInt
    let dRes: Result[bool] = ecdsaParsePrivateScalarBytes(privData, d)
    if IsErr(dRes):
        return Err[Bytes](Error(dRes))
    let initRes: Result[bool] = p256EnsureFixedInit()
    if IsErr(initRes):
        return Err[Bytes](Error(initRes))
    let pointRes: Result[EcPointFixed] = pointMulGeneratorFixed(d)
    if IsErr(pointRes):
        return Err[Bytes](Error(pointRes))
    let point: EcPointFixed = Value(pointRes)
    if point.inf:
        return Err[Bytes]("ecdsa: public key at infinity")
    return Ok[Bytes](ecdsaPublicPointFixedToBytes(point))

@borrows
fn ecdhP256SharedSecretBytes(privData: Bytes, peerPubData: Bytes): Result[Bytes] =
    var d: bigint.BigInt
    let dRes: Result[bool] = ecdsaParsePrivateScalarBytes(privData, d)
    if IsErr(dRes):
        return Err[Bytes](Error(dRes))
    let initRes: Result[bool] = p256EnsureFixedInit()
    if IsErr(initRes):
        return Err[Bytes](Error(initRes))
    var dLocal: bigint.BigInt = d
    let scalarRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(dLocal)
    if IsErr(scalarRes):
        return Err[Bytes](Error(scalarRes))
    var peerPoint: EcPointFixed
    let pointRes: Result[bool] = ecdsaParsePublicKeyPointFixedBytes(peerPubData, true, peerPoint)
    if IsErr(pointRes):
        return Err[Bytes](Error(pointRes))
    let sharedRes: Result[EcPointFixed] = pointMulFixedWindowed(Value(scalarRes), peerPoint)
    if IsErr(sharedRes):
        return Err[Bytes](Error(sharedRes))
    let sharedPoint: EcPointFixed = Value(sharedRes)
    if sharedPoint.inf:
        return Err[Bytes]("ecdsa: invalid ecdh point")
    let xNormRes: Result[pfix.P256Fixed] = p256FieldFixedFromMont(sharedPoint.x)
    if IsErr(xNormRes):
        return Err[Bytes](Error(xNormRes))
    var xNorm: pfix.P256Fixed = Value(xNormRes)
    let xBig: bigint.BigInt = pfix.p256FixedToBigInt(xNorm)
    let secret: Bytes = bigint.bigToBytes(xBig, p256ScalarSize)
    return Ok[Bytes](secret)

fn EcdsaParsePublicKeyPointFixedBytes(data: Bytes,
                                      requireCurveCheck: bool,
                                      out: var EcPointFixed): Result[bool] =
    return ecdsaParsePublicKeyPointFixedBytes(data, requireCurveCheck, out)

fn EcdsaPublicPointFixedToBytes(point: EcPointFixed): Bytes =
    return ecdsaPublicPointFixedToBytes(point)

fn EcdsaVerifyTrustedBytes(pubData: Bytes, msg: Bytes, sig: Bytes): bool =
    return ecdsaVerifyTrustedBytes(pubData, msg, sig)

fn P256EnsureInit(): Result[bool] =
    return p256EnsureInit()

@borrows
fn ValidateEcdsaPrivateKeyBytes(data: Bytes): bool =
    return validateEcdsaPrivateKeyBytes(data)

fn EcdsaPublicKeyFromPrivateBytes(data: Bytes): Result[Bytes] =
    return ecdsaPublicKeyFromPrivateBytes(data)

fn PointJacobianInfinityFixed(): EcPointJacobianFixed =
    return pointJacobianInfinityFixed()

fn PointJacobianDoubleFixedInPlace(p: var EcPointJacobianFixed) =
    pointJacobianDoubleFixedInPlace(p)

@borrows
fn PointJacobianDoubleFixed(p: EcPointJacobianFixed): EcPointJacobianFixed =
    var out = p
    pointJacobianDoubleFixedInPlace(out)
    return out

fn PointJacobianAddAffineFixedInPlace(p1: var EcPointJacobianFixed, p2: EcPointFixed) =
    pointJacobianAddAffineFixedInPlace(p1, p2)

@borrows
fn PointJacobianToAffineFixed(p: EcPointJacobianFixed): Result[EcPointFixed] =
    return pointJacobianToAffineFixed(p)

fn PointMulGeneratorWnafFixed(k: pfix.P256Fixed): Result[EcPointFixed] =
    return pointMulGeneratorWnafFixed(k)

fn PointJacobianFromAffineFixed(p: EcPointFixed): EcPointJacobianFixed =
    return pointJacobianFromAffineFixed(p)

@borrows
fn PointJacobianAddAffineFixed(p1: EcPointJacobianFixed, p2: EcPointFixed): EcPointJacobianFixed =
    return pointJacobianAddAffineFixed(p1, p2)
