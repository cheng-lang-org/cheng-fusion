const
    p256ScalarSize: int32 = 32
    p256PublicSize: int32 = 65
    p256SignatureSize: int32 = 64
    p256GeneratorComb6Width: int32 = 6
    p256GeneratorComb6Depth: int32 = 43
    p256HexP = "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"
    p256HexN = "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"
    p256HexB = "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"
    p256HexGx = "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
    p256HexGy = "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"

type
    EcPoint =
        x: bigint.BigInt
        y: bigint.BigInt
        inf: bool

    EcPointJacobian =
        x: bigint.BigInt
        y: bigint.BigInt
        z: bigint.BigInt
        inf: bool

    EcPointFixed =
        x: pfix.P256Fixed
        y: pfix.P256Fixed
        inf: bool

    EcPointJacobianFixed =
        x: pfix.P256Fixed
        y: pfix.P256Fixed
        z: pfix.P256Fixed
        inf: bool


    EcPublicKey =
        point: EcPoint

    EcPrivateKey =
        d: bigint.BigInt

    EcKeyPair =
        publicKey: EcPublicKey
        privateKey: EcPrivateKey

    EcSignature =
        r: bigint.BigInt
        s: bigint.BigInt

var
    p256InitDone: bool
    p256FixedInitDone: bool
    p256P: bigint.BigInt
    p256N: bigint.BigInt
    p256A: bigint.BigInt
    p256B: bigint.BigInt
    p256G: EcPoint
    p256PMinus2: bigint.BigInt
    p256NMinus2: bigint.BigInt
    p256NHalf: bigint.BigInt
    p256PCtxFixed: pfix.P256FixedMontgomeryContext
    p256NCtxFixed: pfix.P256FixedMontgomeryContext
    p256PMinus2Fixed: pfix.P256Fixed
    p256NMinus2Fixed: pfix.P256Fixed
    p256BFixed: pfix.P256Fixed

fn p256ConstBig8(count: int32,
                 l0: int32,
                 l1: int32,
                 l2: int32,
                 l3: int32,
                 l4: int32,
                 l5: int32,
                 l6: int32,
                 l7: int32): bigint.BigInt =
    var out: bigint.BigInt
    out.count = count
    out.limbs[0] = l0
    out.limbs[1] = l1
    out.limbs[2] = l2
    out.limbs[3] = l3
    out.limbs[4] = l4
    out.limbs[5] = l5
    out.limbs[6] = l6
    out.limbs[7] = l7
    return out

fn p256ConstBig8Into(out: var bigint.BigInt,
                     count: int32,
                     l0: int32,
                     l1: int32,
                     l2: int32,
                     l3: int32,
                     l4: int32,
                     l5: int32,
                     l6: int32,
                     l7: int32) =
    out.count = count
    for i in 0..<bigint.maxBigIntLimbs:
        out.limbs[i] = 0
    out.limbs[0] = l0
    out.limbs[1] = l1
    out.limbs[2] = l2
    out.limbs[3] = l3
    out.limbs[4] = l4
    out.limbs[5] = l5
    out.limbs[6] = l6
    out.limbs[7] = l7

@borrows
fn p256BigSetInto(out: var bigint.BigInt, src: bigint.BigInt) =
    out.count = src.count
    for i in 0..<bigint.maxBigIntLimbs:
        out.limbs[i] = 0
    for i in 0..<src.count:
        out.limbs[i] = src.limbs[i]
    if src.count > 7:
        out.limbs[7] = src.limbs[7]

fn p256BigSetLimb(out: var bigint.BigInt, idx: int32, value: int32) =
    out.limbs[idx] = value

@borrows
fn ecdsaBytesOwnedCopy(src: Bytes): Bytes =
    let n: int32 = BytesLen(src)
    if n <= 0:
        return BytesAlloc(0)
    let out: Bytes = BytesAlloc(n)
    BytesCopyInto(out, 0, src)
    return out

fn p256ConstFixed8(l0: int32,
                   l1: int32,
                   l2: int32,
                   l3: int32,
                   l4: int32,
                   l5: int32,
                   l6: int32,
                   l7: int32): pfix.P256Fixed =
    var out: pfix.P256Fixed
    out.limbs[0] = l0
    out.limbs[1] = l1
    out.limbs[2] = l2
    out.limbs[3] = l3
    out.limbs[4] = l4
    out.limbs[5] = l5
    out.limbs[6] = l6
    out.limbs[7] = l7
    return out

@borrows
fn p256FixedCopyInto(out: var pfix.P256Fixed, src: pfix.P256Fixed) =
    for i in 0..<pfix.p256FixedLimbCount:
        out.limbs[i] = src.limbs[i]

fn p256FixedCopyFromVarInto(out: var pfix.P256Fixed, src: var pfix.P256Fixed) =
    for i in 0..<pfix.p256FixedLimbCount:
        out.limbs[i] = src.limbs[i]

fn p256FixedZeroInto(out: var pfix.P256Fixed) =
    for i in 0..<pfix.p256FixedLimbCount:
        out.limbs[i] = 0

fn p256FixedContextCopyInto(out: var pfix.P256FixedMontgomeryContext,
                            src: pfix.P256FixedMontgomeryContext) =
    p256FixedCopyInto(out.modulus, src.modulus)
    out.n0Inv = src.n0Inv
    p256FixedCopyInto(out.r2, src.r2)
    p256FixedCopyInto(out.oneMont, src.oneMont)

fn p256FixedContextClone(src: var pfix.P256FixedMontgomeryContext): pfix.P256FixedMontgomeryContext =
    var out: pfix.P256FixedMontgomeryContext
    p256FixedCopyInto(out.modulus, src.modulus)
    out.n0Inv = src.n0Inv
    p256FixedCopyInto(out.r2, src.r2)
    p256FixedCopyInto(out.oneMont, src.oneMont)
    return out

fn pointFixedSetInfinityInto(out: var EcPointFixed) =
    p256FixedZeroInto(out.x)
    p256FixedZeroInto(out.y)
    out.inf = true

fn pointFixedSetCoordsInto(out: var EcPointFixed,
                           x: pfix.P256Fixed,
                           y: pfix.P256Fixed) =
    p256FixedCopyInto(out.x, x)
    p256FixedCopyInto(out.y, y)
    out.inf = false

@borrows
fn pointFixedSetInto(out: var EcPointFixed, src: EcPointFixed) =
    if src.inf:
        pointFixedSetInfinityInto(out)
        return
    pointFixedSetCoordsInto(out, src.x, src.y)

fn pointJacobianFixedSetInfinityInto(out: var EcPointJacobianFixed) =
    p256FixedZeroInto(out.x)
    p256FixedZeroInto(out.y)
    p256FixedZeroInto(out.z)
    out.inf = true

fn pointJacobianFixedSetCoordsInto(out: var EcPointJacobianFixed,
                                   x: pfix.P256Fixed,
                                   y: pfix.P256Fixed,
                                   z: pfix.P256Fixed) =
    p256FixedCopyInto(out.x, x)
    p256FixedCopyInto(out.y, y)
    p256FixedCopyInto(out.z, z)
    out.inf = false

fn pointJacobianFixedSetInto(out: var EcPointJacobianFixed, src: EcPointJacobianFixed) =
    if src.inf:
        pointJacobianFixedSetInfinityInto(out)
        return
    pointJacobianFixedSetCoordsInto(out, src.x, src.y, src.z)

fn pointJacobianFixedSetFromAffineInto(out: var EcPointJacobianFixed, src: EcPointFixed) =
    if src.inf:
        pointJacobianFixedSetInfinityInto(out)
        return
    let one: pfix.P256Fixed = p256FieldFixedOne()
    pointJacobianFixedSetCoordsInto(out, src.x, src.y, one)

fn p256ConstP(): bigint.BigInt =
    return p256ConstBig8(8, -1, -1, -1, 0, 0, 0, 1, -1)

fn p256ConstPInto(out: var bigint.BigInt) =
    out.count = 8
    for i in 0..<bigint.maxBigIntLimbs:
        out.limbs[i] = 0
    out.limbs[0] = -1
    out.limbs[1] = -1
    out.limbs[2] = -1
    out.limbs[3] = 0
    out.limbs[4] = 0
    out.limbs[5] = 0
    out.limbs[6] = 1
    p256BigSetLimb(out, 7, -1)

fn p256ConstN(): bigint.BigInt =
    return p256ConstBig8(8, -60611247, -205927742, -1491624316, -1125713235, -1, -1, 0, -1)

fn p256ConstNInto(out: var bigint.BigInt) =
    out.count = 8
    for i in 0..<bigint.maxBigIntLimbs:
        out.limbs[i] = 0
    out.limbs[0] = -60611247
    out.limbs[1] = -205927742
    out.limbs[2] = -1491624316
    out.limbs[3] = -1125713235
    out.limbs[4] = -1
    out.limbs[5] = -1
    out.limbs[6] = 0
    p256BigSetLimb(out, 7, -1)

fn p256ConstNHalf(): bigint.BigInt =
    return p256ConstBig8(8, 2117178024, 2044519777, -745812158, -562856618, -1, 2147483647, -2147483648, 2147483647)

