# Noise_XX_25519_ChaChaPoly_SHA256 handshake state machine (Noise Protocol
# Framework, https://noiseprotocol.org/noise.html). Pure protocol primitives:
# no IO, no libp2p/QUIC types. Composes existing production primitives only
# (std/crypto/curve25519 for X25519 DH, std/crypto/chacha20poly1305 for the
# AEAD, std/crypto/hkdf for HKDF-SHA256) -- no hand-rolled crypto here.
#
# Noise's own HKDF(chaining_key, ikm, num_outputs) is HKDF-Expand(SHA256)
# with info="" seeded from PRK = HMAC(chaining_key, ikm):
#   temp_key = HMAC-HASH(chaining_key, ikm)         == hkdfExtractSha256(ikm, chaining_key)
#   output_i = HMAC-HASH(temp_key, output_{i-1}||i) == the i-th 32-byte block
#              of hkdfExpandSha256(temp_key, "", 32*num_outputs)
# so noiseHkdf2/3 below are thin compositions of the two exported std/crypto/hkdf
# entry points, not a reimplementation of HMAC.

import std/result
import std/rawbytes
import std/crypto/curve25519
import std/crypto/chacha20poly1305 as aead
import std/crypto/hkdf
import std/crypto/sha256

const
    noiseProtocolName = "Noise_XX_25519_ChaChaPoly_SHA256"
    noiseHashLen: int32 = 32
    noiseDhLen: int32 = 32
    noiseTagLen: int32 = 16

# ---------------------------------------------------------------------------
# CipherState (Noise 5.1)
# ---------------------------------------------------------------------------

type
    CipherState =
        k: Bytes
        n: int64

@borrows
fn cipherStateHasKey(cs: CipherState): bool =
    return BytesLen(cs.k) == noiseHashLen

fn cipherStateInitializeKey(cs: var CipherState, key: Bytes) =
    cs.k = key
    cs.n = 0

# 96-bit ChaChaPoly nonce per Noise 4.2: 32 zero bits followed by the
# little-endian encoding of the 64-bit counter n.
fn noiseNonceBytes(n: int64): Bytes =
    let out: Bytes = BytesAlloc(12)
    var v: int64 = n
    var i: int32 = 4
    while i < 12:
        BytesSet(out, i, int32(v & 0xff))
        v = v >> 8
        i = i + 1
    return out

fn cipherStateEncryptWithAd(cs: var CipherState, ad: Bytes, plaintext: Bytes): Result[Bytes] =
    if !cipherStateHasKey(cs):
        return Ok[Bytes](BytesSlice(plaintext, 0, BytesLen(plaintext)))
    let keyRes: Result[aead.ChaChaPolyKey] = aead.intoChaChaPolyKey(cs.k)
    if IsErr(keyRes):
        return Err[Bytes](Error(keyRes))
    let nonceRes: Result[aead.ChaChaPolyNonce] = aead.intoChaChaPolyNonce(noiseNonceBytes(cs.n))
    if IsErr(nonceRes):
        return Err[Bytes](Error(nonceRes))
    var buf: Bytes = BytesSlice(plaintext, 0, BytesLen(plaintext))
    var tag: aead.ChaChaPolyTag
    let encRes: Result[bool] = aead.encrypt(Value(keyRes), Value(nonceRes), tag, buf, ad)
    if IsErr(encRes):
        return Err[Bytes](Error(encRes))
    cs.n = cs.n + 1
    return Ok[Bytes](BytesConcat(buf, tag.data))

fn cipherStateDecryptWithAd(cs: var CipherState, ad: Bytes, ciphertext: Bytes): Result[Bytes] =
    if !cipherStateHasKey(cs):
        return Ok[Bytes](BytesSlice(ciphertext, 0, BytesLen(ciphertext)))
    let total: int32 = BytesLen(ciphertext)
    if total < noiseTagLen:
        return Err[Bytes]("noise: ciphertext shorter than AEAD tag")
    let keyRes: Result[aead.ChaChaPolyKey] = aead.intoChaChaPolyKey(cs.k)
    if IsErr(keyRes):
        return Err[Bytes](Error(keyRes))
    let nonceRes: Result[aead.ChaChaPolyNonce] = aead.intoChaChaPolyNonce(noiseNonceBytes(cs.n))
    if IsErr(nonceRes):
        return Err[Bytes](Error(nonceRes))
    let ctLen: int32 = total - noiseTagLen
    var buf: Bytes = BytesSlice(ciphertext, 0, ctLen)
    let tagRes: Result[aead.ChaChaPolyTag] = aead.intoChaChaPolyTag(BytesSlice(ciphertext, ctLen, noiseTagLen))
    if IsErr(tagRes):
        return Err[Bytes](Error(tagRes))
    # aead.decrypt does a constant-time tag compare (tagEqual XORs every byte,
    # no early exit on content) before touching plaintext, so a flipped tag or
    # a flipped AAD/ciphertext byte fails here with no partial keystream leak.
    let decRes: Result[bool] = aead.decrypt(Value(keyRes), Value(nonceRes), Value(tagRes), buf, ad)
    if IsErr(decRes):
        return Err[Bytes](Error(decRes))
    cs.n = cs.n + 1
    return Ok[Bytes](buf)

# ---------------------------------------------------------------------------
# SymmetricState (Noise 5.2)
# ---------------------------------------------------------------------------

type
    SymmetricState =
        ck: Bytes
        h: Bytes
        cs: CipherState

fn noiseInitializeSymmetric(protocolName: str): SymmetricState =
    let nameBytes: Bytes = BytesFromString(protocolName)
    var h: Bytes
    if BytesLen(nameBytes) <= noiseHashLen:
        h = BytesAlloc(noiseHashLen)
        BytesCopyInto(h, 0, nameBytes)
    else:
        h = Sha256Digest(nameBytes)
    var ss: SymmetricState
    ss.h = h
    ss.ck = BytesSlice(h, 0, noiseHashLen)
    return ss

fn noiseMixHash(ss: var SymmetricState, data: Bytes) =
    ss.h = Sha256Digest(BytesConcat(ss.h, data))

# HKDF(chaining_key, ikm, numOutputs) per Noise 4.3, numOutputs in {2, 3}.
# See module header comment for the mapping onto hkdfExtractSha256/hkdfExpandSha256.
@borrows
fn noiseHkdf(chainingKey: Bytes, ikm: Bytes, numOutputs: int32, out1: var Bytes, out2: var Bytes, out3: var Bytes): Result[bool] =
    if numOutputs != 2 && numOutputs != 3:
        return Err[bool]("noise: hkdf numOutputs must be 2 or 3")
    let tempKey: Bytes = hkdfExtractSha256(ikm, chainingKey)
    let okmRes: Result[Bytes] = hkdfExpandSha256(tempKey, EmptyBytes(), noiseHashLen * numOutputs)
    if IsErr(okmRes):
        return Err[bool](Error(okmRes))
    let okm: Bytes = Value(okmRes)
    out1 = BytesSlice(okm, 0, noiseHashLen)
    out2 = BytesSlice(okm, noiseHashLen, noiseHashLen)
    if numOutputs == 3:
        out3 = BytesSlice(okm, 2 * noiseHashLen, noiseHashLen)
    return Ok[bool](true)

fn noiseMixKey(ss: var SymmetricState, ikm: Bytes): Result[bool] =
    var out1: Bytes
    var out2: Bytes
    var out3: Bytes
    let res: Result[bool] = noiseHkdf(ss.ck, ikm, 2, out1, out2, out3)
    if IsErr(res):
        return res
    ss.ck = out1
    cipherStateInitializeKey(ss.cs, out2)
    return Ok[bool](true)

fn noiseEncryptAndHash(ss: var SymmetricState, plaintext: Bytes): Result[Bytes] =
    let ctRes: Result[Bytes] = cipherStateEncryptWithAd(ss.cs, ss.h, plaintext)
    if IsErr(ctRes):
        return ctRes
    noiseMixHash(ss, Value(ctRes))
    return ctRes

fn noiseDecryptAndHash(ss: var SymmetricState, ciphertext: Bytes): Result[Bytes] =
    let ptRes: Result[Bytes] = cipherStateDecryptWithAd(ss.cs, ss.h, ciphertext)
    if IsErr(ptRes):
        return ptRes
    noiseMixHash(ss, ciphertext)
    return ptRes

fn noiseSplit(ss: SymmetricState, c1: var CipherState, c2: var CipherState): Result[bool] =
    var out1: Bytes
    var out2: Bytes
    var out3: Bytes
    let res: Result[bool] = noiseHkdf(ss.ck, EmptyBytes(), 2, out1, out2, out3)
    if IsErr(res):
        return res
    cipherStateInitializeKey(c1, out1)
    cipherStateInitializeKey(c2, out2)
    return Ok[bool](true)

# ---------------------------------------------------------------------------
# HandshakeState (Noise 5.3), fixed to the XX pattern:
#   -> e
#   <- e, ee, s, es
#   -> s, se
# Message-numbered functions are written from a fixed role (WriteMessage1/3 +
# ReadMessage2 are the initiator's side; ReadMessage1 + WriteMessage2 +
# ReadMessage3 are the responder's side) since XX's two roles are asymmetric
# by construction -- a generic token interpreter would just be indirection
# around the same 3 fixed messages.
# ---------------------------------------------------------------------------

type
    HandshakeState =
        ss: SymmetricState
        s: curve25519.Curve25519KeyPair
        e: curve25519.Curve25519KeyPair
        rs: Bytes
        re: Bytes

fn noiseHandshakeInit(staticKeyPair: curve25519.Curve25519KeyPair, prologue: Bytes): HandshakeState =
    var hs: HandshakeState
    hs.ss = noiseInitializeSymmetric(noiseProtocolName)
    noiseMixHash(hs.ss, prologue)
    hs.s = staticKeyPair
    hs.rs = EmptyBytes()
    hs.re = EmptyBytes()
    return hs

# Test-only determinism hook: pre-seed the ephemeral keypair so a fixed-vector
# probe can replay a handshake without touching std/crypto/rand. WriteMessage1/2
# only generate a fresh ephemeral when none has been set yet.
fn noiseHandshakeSetEphemeral(hs: var HandshakeState, ephemeral: curve25519.Curve25519KeyPair) =
    hs.e = ephemeral

fn noiseHandshakeHash(hs: HandshakeState): Bytes =
    return hs.ss.h

fn noiseEnsureEphemeral(hs: var HandshakeState): Result[bool] =
    if BytesLen(hs.e.pub) == noiseDhLen:
        return Ok[bool](true)
    # Field-assignment via generateCurve25519KeyPairInto instead of the
    # generateCurve25519KeyPair() convenience wrapper: that wrapper's own
    # body ends in curve25519.initCurve25519KeyPair(priv, pub), a bare
    # named-field struct literal that trips a cheng_cold cross/intra-module
    # reachability edge case ("reachable function body missing" + "non-void
    # function block unterminated") isolated with a minimal repro during
    # this slice -- generateCurve25519KeyPairInto is the same CSPRNG call
    # with no such body, so this is not a behavior change.
    var priv: Bytes = EmptyBytes()
    var pub: Bytes = EmptyBytes()
    let genRes: Result[bool] = curve25519.generateCurve25519KeyPairInto(priv, pub)
    if IsErr(genRes):
        return Err[bool](Error(genRes))
    var kp: curve25519.Curve25519KeyPair
    kp.priv = priv
    kp.pub = pub
    hs.e = kp
    return Ok[bool](true)

# -> e
fn noiseWriteMessage1(hs: var HandshakeState, payload: Bytes): Result[Bytes] =
    let ephRes: Result[bool] = noiseEnsureEphemeral(hs)
    if IsErr(ephRes):
        return Err[Bytes](Error(ephRes))
    noiseMixHash(hs.ss, hs.e.pub)
    let ctRes: Result[Bytes] = noiseEncryptAndHash(hs.ss, payload)
    if IsErr(ctRes):
        return ctRes
    return Ok[Bytes](BytesConcat(hs.e.pub, Value(ctRes)))

fn noiseReadMessage1(hs: var HandshakeState, message: Bytes): Result[Bytes] =
    if BytesLen(message) < noiseDhLen:
        return Err[Bytes]("noise: message1 shorter than one DH public key")
    hs.re = BytesSlice(message, 0, noiseDhLen)
    noiseMixHash(hs.ss, hs.re)
    let payloadCt: Bytes = BytesSlice(message, noiseDhLen, BytesLen(message) - noiseDhLen)
    return noiseDecryptAndHash(hs.ss, payloadCt)

# <- e, ee, s, es (responder)
fn noiseWriteMessage2(hs: var HandshakeState, payload: Bytes): Result[Bytes] =
    let ephRes: Result[bool] = noiseEnsureEphemeral(hs)
    if IsErr(ephRes):
        return Err[Bytes](Error(ephRes))
    noiseMixHash(hs.ss, hs.e.pub)
    let eeRes: Result[Bytes] = curve25519.curve25519SharedKey(hs.e.priv, hs.re)
    if IsErr(eeRes):
        return Err[Bytes](Error(eeRes))
    let mixEeRes: Result[bool] = noiseMixKey(hs.ss, Value(eeRes))
    if IsErr(mixEeRes):
        return Err[Bytes](Error(mixEeRes))
    let sCtRes: Result[Bytes] = noiseEncryptAndHash(hs.ss, hs.s.pub)
    if IsErr(sCtRes):
        return sCtRes
    let esRes: Result[Bytes] = curve25519.curve25519SharedKey(hs.s.priv, hs.re)
    if IsErr(esRes):
        return Err[Bytes](Error(esRes))
    let mixEsRes: Result[bool] = noiseMixKey(hs.ss, Value(esRes))
    if IsErr(mixEsRes):
        return Err[Bytes](Error(mixEsRes))
    let payloadCtRes: Result[Bytes] = noiseEncryptAndHash(hs.ss, payload)
    if IsErr(payloadCtRes):
        return payloadCtRes
    return Ok[Bytes](BytesConcat3(hs.e.pub, Value(sCtRes), Value(payloadCtRes)))

fn noiseReadMessage2(hs: var HandshakeState, message: Bytes): Result[Bytes] =
    let sCtLen: int32 = noiseDhLen + noiseTagLen
    if BytesLen(message) < noiseDhLen + sCtLen:
        return Err[Bytes]("noise: message2 truncated")
    hs.re = BytesSlice(message, 0, noiseDhLen)
    noiseMixHash(hs.ss, hs.re)
    let eeRes: Result[Bytes] = curve25519.curve25519SharedKey(hs.e.priv, hs.re)
    if IsErr(eeRes):
        return Err[Bytes](Error(eeRes))
    let mixEeRes: Result[bool] = noiseMixKey(hs.ss, Value(eeRes))
    if IsErr(mixEeRes):
        return Err[Bytes](Error(mixEeRes))
    let sCt: Bytes = BytesSlice(message, noiseDhLen, sCtLen)
    let rsRes: Result[Bytes] = noiseDecryptAndHash(hs.ss, sCt)
    if IsErr(rsRes):
        return rsRes
    hs.rs = Value(rsRes)
    let esRes: Result[Bytes] = curve25519.curve25519SharedKey(hs.e.priv, hs.rs)
    if IsErr(esRes):
        return Err[Bytes](Error(esRes))
    let mixEsRes: Result[bool] = noiseMixKey(hs.ss, Value(esRes))
    if IsErr(mixEsRes):
        return Err[Bytes](Error(mixEsRes))
    let payloadOffset: int32 = noiseDhLen + sCtLen
    let payloadCt: Bytes = BytesSlice(message, payloadOffset, BytesLen(message) - payloadOffset)
    return noiseDecryptAndHash(hs.ss, payloadCt)

# -> s, se (initiator)
fn noiseWriteMessage3(hs: var HandshakeState, payload: Bytes): Result[Bytes] =
    let sCtRes: Result[Bytes] = noiseEncryptAndHash(hs.ss, hs.s.pub)
    if IsErr(sCtRes):
        return sCtRes
    let seRes: Result[Bytes] = curve25519.curve25519SharedKey(hs.s.priv, hs.re)
    if IsErr(seRes):
        return Err[Bytes](Error(seRes))
    let mixSeRes: Result[bool] = noiseMixKey(hs.ss, Value(seRes))
    if IsErr(mixSeRes):
        return Err[Bytes](Error(mixSeRes))
    let payloadCtRes: Result[Bytes] = noiseEncryptAndHash(hs.ss, payload)
    if IsErr(payloadCtRes):
        return payloadCtRes
    return Ok[Bytes](BytesConcat(Value(sCtRes), Value(payloadCtRes)))

fn noiseReadMessage3(hs: var HandshakeState, message: Bytes): Result[Bytes] =
    let sCtLen: int32 = noiseDhLen + noiseTagLen
    if BytesLen(message) < sCtLen:
        return Err[Bytes]("noise: message3 shorter than encrypted static key")
    let sCt: Bytes = BytesSlice(message, 0, sCtLen)
    let rsRes: Result[Bytes] = noiseDecryptAndHash(hs.ss, sCt)
    if IsErr(rsRes):
        return rsRes
    hs.rs = Value(rsRes)
    let seRes: Result[Bytes] = curve25519.curve25519SharedKey(hs.e.priv, hs.rs)
    if IsErr(seRes):
        return Err[Bytes](Error(seRes))
    let mixSeRes: Result[bool] = noiseMixKey(hs.ss, Value(seRes))
    if IsErr(mixSeRes):
        return Err[Bytes](Error(mixSeRes))
    let payloadCt: Bytes = BytesSlice(message, sCtLen, BytesLen(message) - sCtLen)
    return noiseDecryptAndHash(hs.ss, payloadCt)

fn noiseHandshakeSplit(hs: HandshakeState, c1: var CipherState, c2: var CipherState): Result[bool] =
    return noiseSplit(hs.ss, c1, c2)
