# HKDF extract/expand helpers(SHA1/SHA256/SHA512).

import std/result
import std/rawbytes
import std/buffer as bytebuffer
import std/os
import std/crypto/sha1
import std/crypto/sha256
import std/crypto/sha384
import std/crypto/sha512
const
    sha1BlockSize = 64
    sha256BlockSize = 64
    sha384BlockSize = 128
    sha512BlockSize = 128
    sha1Size = 20
    sha256Size = 32
    sha384Size = 48
    sha512Size = 64

var
    hkdfDebugEnabled: bool

fn hkdfSetDebug(enabled: bool) =
    hkdfDebugEnabled = enabled

fn hkdfDebug(text: str) =
    if !hkdfDebugEnabled:
        return
    os.WriteLine(os.Get_stderr(), text)

fn selectKeyBlock(key: Bytes, blockSize: int32, digest: fn (data: Bytes): Bytes): Bytes =
    if BytesLen(key) > blockSize:
        let h: Bytes = digest(key)
        return h
    return key

fn keyToBlock(key: Bytes, blockSize: int32, hashSize: int32, digest: fn (data: Bytes): Bytes): Bytes =
    let k: Bytes = selectKeyBlock(key, blockSize, digest)
    let out: Bytes = BytesAlloc(blockSize)
    var i: int32
    let klen: int32 = BytesLen(k)
    for i in i..<blockSize:
        let v: int32 = if i < klen: BytesGet(k, i) else: 0
        BytesSet(out, i, v)
    return out

@borrows
fn xorPad(keyBlock: Bytes, padByte: int32): Bytes =
    let out: Bytes = BytesAlloc(BytesLen(keyBlock))
    for i in 0..<BytesLen(keyBlock):
        let v: int32 = BytesGet(keyBlock, i) ^ padByte
        BytesSet(out, i, v)
    return out

fn hmacDigest(key: Bytes, data: Bytes, blockSize: int32, hashSize: int32, digest: fn (data: Bytes): Bytes): Bytes =
    let keyBlock: Bytes = keyToBlock(key, blockSize, hashSize, digest)
    let oKey: Bytes = xorPad(keyBlock, 0x5c)
    let iKey: Bytes = xorPad(keyBlock, 0x36)
    let inner: Bytes = digest(BytesConcat(iKey, data))
    return digest(BytesConcat(oKey, inner))

fn hkdfExtract(key: Bytes, salt: Bytes, blockSize: int32, hashSize: int32, digest: fn (data: Bytes): Bytes): Bytes =
    var useSalt: Bytes = salt
    if BytesLen(useSalt) <= 0:
        useSalt = BytesAlloc(hashSize)
    return hmacDigest(useSalt, key, blockSize, hashSize, digest)

fn hkdfExpand(prk: Bytes, info: Bytes, length: int32, blockSize: int32, hashSize: int32, digest: fn (data: Bytes): Bytes): Result[Bytes] =
    if length < 0:
        return Err[Bytes]("hkdf: negative length")
    if length == 0:
        return Ok[Bytes](EmptyBytes())
    let n: int32 = (length + hashSize - 1) / hashSize
    if n > 255:
        return Err[Bytes]("hkdf: length too large")
    var okm: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    var t: Bytes = EmptyBytes()
    for i in 1..n:
        let ctr: Bytes = BytesAlloc(1)
        BytesSet(ctr, 0, i)
        let input: Bytes = BytesConcat3(t, info, ctr)
        t = hmacDigest(prk, input, blockSize, hashSize, digest)
        bytebuffer.AppendBytes(okm, t)
    let out: Bytes = rawbytes.BytesSlice(bytebuffer.ToBytes(okm), 0, rawbytes.BytesLen(bytebuffer.ToBytes(okm)))
    if BytesLen(out) <= length:
        return Ok[Bytes](out)
    return Ok[Bytes](BytesSlice(out, 0, length))

fn hkdfExtractSha1(ikm: Bytes, salt: Bytes): Bytes =
    return hkdfExtract(ikm, salt, sha1BlockSize, sha1Size, hkdfSha1DigestFn)

fn hkdfExpandSha1(prk: Bytes, info: Bytes, length: int32): Result[Bytes] =
    return hkdfExpand(prk, info, length, sha1BlockSize, sha1Size, hkdfSha1DigestFn)

fn hkdfSha1(ikm: Bytes, salt: Bytes, info: Bytes, length: int32): Result[Bytes] =
    let prk: Bytes = hkdfExtractSha1(ikm, salt)
    return hkdfExpandSha1(prk, info, length)

fn hkdfSaltForExtract(salt: Bytes): Bytes =
    if BytesLen(salt) <= 0:
        return BytesAlloc(sha256Size)
    var out: Bytes = BytesAlloc(BytesLen(salt))
    BytesCopyInto(out, 0, salt)
    return out

@borrows
fn hkdfExtractSha256(ikm: Bytes, salt: Bytes): Bytes =
    hkdfDebug("msquic_tls13_phase hkdf_extract_sha256_enter")
    # Same helper-fn shape as hkdfKeySource (local if/else phi fails exact
    # memory-version validation).
    var useSalt: Bytes = hkdfSaltForExtract(salt)
    hkdfDebug("msquic_tls13_phase hkdf_extract_sha256_hmac_begin")
    return hmacDigestSha256(useSalt, ikm)

@borrows
fn hkdfExpandSha256(prk: Bytes, info: Bytes, length: int32): Result[Bytes] =
    if length < 0:
        return Err[Bytes]("hkdf: negative length")
    if length == 0:
        return Ok[Bytes](EmptyBytes())
    let n: int32 = (length + sha256Size - 1) / sha256Size
    if n > 255:
        return Err[Bytes]("hkdf: length too large")
    var okm: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    var t: Bytes = EmptyBytes()
    for i in 1..n:
        let tLen: int32 = BytesLen(t)
        let infoLen: int32 = BytesLen(info)
        let input: Bytes = BytesAlloc(tLen + infoLen + 1)
        for j in 0..<tLen:
            BytesSet(input, j, BytesGet(t, j))
        for j in 0..<infoLen:
            BytesSet(input, tLen + j, BytesGet(info, j))
        BytesSet(input, tLen + infoLen, i)
        t = hmacDigestSha256(prk, input)
        bytebuffer.AppendBytes(okm, t)
    let out: Bytes = rawbytes.BytesSlice(bytebuffer.ToBytes(okm), 0, rawbytes.BytesLen(bytebuffer.ToBytes(okm)))
    if BytesLen(out) <= length:
        return Ok[Bytes](out)
    return Ok[Bytes](BytesSlice(out, 0, length))

fn hkdfSha256(ikm: Bytes, salt: Bytes, info: Bytes, length: int32): Result[Bytes] =
    let prk: Bytes = hkdfExtractSha256(ikm, salt)
    return hkdfExpandSha256(prk, info, length)

fn hkdfExtractSha384(ikm: Bytes, salt: Bytes): Bytes =
    var useSalt: Bytes = salt
    if BytesLen(useSalt) <= 0:
        useSalt = BytesAlloc(sha384Size)
    return hmacDigestSha384(useSalt, ikm)

fn hkdfExpandSha384(prk: Bytes, info: Bytes, length: int32): Result[Bytes] =
    if length < 0:
        return Err[Bytes]("hkdf: negative length")
    if length == 0:
        return Ok[Bytes](EmptyBytes())
    let n: int32 = (length + sha384Size - 1) / sha384Size
    if n > 255:
        return Err[Bytes]("hkdf: length too large")
    var okm: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    var t: Bytes = EmptyBytes()
    for i in 1..n:
        let tLen: int32 = BytesLen(t)
        let infoLen: int32 = BytesLen(info)
        let input: Bytes = BytesAlloc(tLen + infoLen + 1)
        for j in 0..<tLen:
            BytesSet(input, j, BytesGet(t, j))
        for j in 0..<infoLen:
            BytesSet(input, tLen + j, BytesGet(info, j))
        BytesSet(input, tLen + infoLen, i)
        t = hmacDigestSha384(prk, input)
        bytebuffer.AppendBytes(okm, t)
    let out: Bytes = rawbytes.BytesSlice(bytebuffer.ToBytes(okm), 0, rawbytes.BytesLen(bytebuffer.ToBytes(okm)))
    if BytesLen(out) <= length:
        return Ok[Bytes](out)
    return Ok[Bytes](BytesSlice(out, 0, length))

fn hkdfSha384(ikm: Bytes, salt: Bytes, info: Bytes, length: int32): Result[Bytes] =
    let prk: Bytes = hkdfExtractSha384(ikm, salt)
    return hkdfExpandSha384(prk, info, length)

fn hkdfExtractSha512(ikm: Bytes, salt: Bytes): Bytes =
    return hkdfExtract(ikm, salt, sha512BlockSize, sha512Size, hkdfSha512DigestFn)

fn hkdfExpandSha512(prk: Bytes, info: Bytes, length: int32): Result[Bytes] =
    return hkdfExpand(prk, info, length, sha512BlockSize, sha512Size, hkdfSha512DigestFn)

fn hkdfSha512(ikm: Bytes, salt: Bytes, info: Bytes, length: int32): Result[Bytes] =
    let prk: Bytes = hkdfExtractSha512(ikm, salt)
    return hkdfExpandSha512(prk, info, length)

# Owned key material: over-size keys are hashed down, short keys copied.
@borrows
fn hkdfKeySource(key: Bytes): Bytes =
    if BytesLen(key) > sha256BlockSize:
        return Sha256Digest(key)
    var out: Bytes = BytesAlloc(BytesLen(key))
    BytesCopyInto(out, 0, key)
    return out

@borrows
fn hmacDigestSha256(key: Bytes, data: Bytes): Bytes =
    hkdfDebug("msquic_tls13_phase hmac_sha256_enter")
    # Helper-fn return keeps the branch inside return-merges (the local
    # if/else variable phi fails exact memory-version validation).
    var keySource: Bytes = hkdfKeySource(key)
    var keySourceOwned: bool = true
    var keyBlock: Bytes = BytesAlloc(sha256BlockSize)
    let keyLen: int32 = BytesLen(keySource)
    for i in 0..<sha256BlockSize:
        let v: int32 = if i < keyLen: BytesGet(keySource, i) else: 0
        BytesSet(keyBlock, i, v)
    if keySourceOwned:
        BytesFree(keySource)
    var oKey: Bytes = xorPad(keyBlock, 0x5c)
    var iKey: Bytes = xorPad(keyBlock, 0x36)
    BytesFree(keyBlock)
    let dataLen: int32 = BytesLen(data)
    var innerInput: Bytes = BytesAlloc(sha256BlockSize + dataLen)
    for i in 0..<sha256BlockSize:
        BytesSet(innerInput, i, BytesGet(iKey, i))
    if dataLen > 0:
        for i in 0..<dataLen:
            BytesSet(innerInput, sha256BlockSize + i, BytesGet(data, i))
    BytesFree(iKey)
    var inner: Bytes = Sha256Digest(innerInput)
    BytesFree(innerInput)
    var outerInput: Bytes = BytesAlloc(sha256BlockSize + sha256Size)
    for i in 0..<sha256BlockSize:
        BytesSet(outerInput, i, BytesGet(oKey, i))
    for i in 0..<sha256Size:
        BytesSet(outerInput, sha256BlockSize + i, BytesGet(inner, i))
    BytesFree(oKey)
    BytesFree(inner)
    let result: Bytes = Sha256Digest(outerInput)
    BytesFree(outerInput)
    return result

fn hmacDigestSha384(key: Bytes, data: Bytes): Bytes =
    var keySource: Bytes = key
    if BytesLen(keySource) > sha384BlockSize:
        keySource = sha384Digest(keySource)
    let keyBlock: Bytes = BytesAlloc(sha384BlockSize)
    let keyLen: int32 = BytesLen(keySource)
    for i in 0..<sha384BlockSize:
        let v: int32 = if i < keyLen: BytesGet(keySource, i) else: 0
        BytesSet(keyBlock, i, v)
    let oKey: Bytes = xorPad(keyBlock, 0x5c)
    let iKey: Bytes = xorPad(keyBlock, 0x36)
    let dataLen: int32 = BytesLen(data)
    let innerInput: Bytes = BytesAlloc(sha384BlockSize + dataLen)
    for i in 0..<sha384BlockSize:
        BytesSet(innerInput, i, BytesGet(iKey, i))
    if dataLen > 0:
        for i in 0..<dataLen:
            BytesSet(innerInput, sha384BlockSize + i, BytesGet(data, i))
    let inner: Bytes = sha384Digest(innerInput)
    let outerInput: Bytes = BytesAlloc(sha384BlockSize + sha384Size)
    for i in 0..<sha384BlockSize:
        BytesSet(outerInput, i, BytesGet(oKey, i))
    for i in 0..<sha384Size:
        BytesSet(outerInput, sha384BlockSize + i, BytesGet(inner, i))
    return sha384Digest(outerInput)

@borrows
fn hmacDigestSha1(key: Bytes, data: Bytes): Bytes =
    var keySource: Bytes = key
    var keySourceOwned: bool
    if BytesLen(keySource) > sha1BlockSize:
        keySource = sha1Digest(keySource)
        keySourceOwned = true
    var keyBlock: Bytes = BytesAlloc(sha1BlockSize)
    let keyLen: int32 = BytesLen(keySource)
    for i in 0..<sha1BlockSize:
        let v: int32 = if i < keyLen: BytesGet(keySource, i) else: 0
        BytesSet(keyBlock, i, v)
    if keySourceOwned:
        BytesFree(keySource)
    var oKey: Bytes = xorPad(keyBlock, 0x5c)
    var iKey: Bytes = xorPad(keyBlock, 0x36)
    BytesFree(keyBlock)
    let dataLen: int32 = BytesLen(data)
    var innerInput: Bytes = BytesAlloc(sha1BlockSize + dataLen)
    for i in 0..<sha1BlockSize:
        BytesSet(innerInput, i, BytesGet(iKey, i))
    if dataLen > 0:
        for i in 0..<dataLen:
            BytesSet(innerInput, sha1BlockSize + i, BytesGet(data, i))
    BytesFree(iKey)
    var inner: Bytes = sha1Digest(innerInput)
    BytesFree(innerInput)
    var outerInput: Bytes = BytesAlloc(sha1BlockSize + sha1Size)
    for i in 0..<sha1BlockSize:
        BytesSet(outerInput, i, BytesGet(oKey, i))
    for i in 0..<sha1Size:
        BytesSet(outerInput, sha1BlockSize + i, BytesGet(inner, i))
    BytesFree(oKey)
    BytesFree(inner)
    let result: Bytes = sha1Digest(outerInput)
    BytesFree(outerInput)
    return result

fn hkdfSha1DigestFn(data: Bytes): Bytes =
    return sha1Digest(data)

fn hkdfSha256DigestFn(data: Bytes): Bytes =
    return Sha256Digest(data)

fn hkdfSha384DigestFn(data: Bytes): Bytes =
    return sha384Digest(data)

fn hkdfSha512DigestFn(data: Bytes): Bytes =
    return Sha512Digest(data)
