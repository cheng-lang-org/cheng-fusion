# SHA-3 (FIPS 202): Keccak-f[1600] permutation, SHA3-256/SHA3-512 digests,
# SHAKE128/SHAKE256 extendable-output functions.

import std/rawbytes
import std/system

fn keccakAllOnes(): int64 =
    return 0 - 1

fn keccakMaxPos(): int64 =
    return (int64(1) << 63) ^ keccakAllOnes()

# Logical (zero-fill) right shift for 64-bit lane values.
# ">>" on int64 is an arithmetic shift, so clear the sign-extended bit after
# one step, then shift the remaining distance on a non-negative value.
fn keccakLshr(x: int64, n: int32): int64 =
    let half: int64 = (x >> 1) & keccakMaxPos()
    return half >> (n - 1)

fn keccakRotl(x: int64, n: int32): int64 =
    if n == 0:
        return x
    return (x << n) | keccakLshr(x, 64 - n)

fn keccakLaneGet(state: Bytes, lane: int32): int64 =
    let base: int32 = lane * 8
    let b0: int64 = int64(BytesGet(state, base))
    let b1: int64 = int64(BytesGet(state, base + 1))
    let b2: int64 = int64(BytesGet(state, base + 2))
    let b3: int64 = int64(BytesGet(state, base + 3))
    let b4: int64 = int64(BytesGet(state, base + 4))
    let b5: int64 = int64(BytesGet(state, base + 5))
    let b6: int64 = int64(BytesGet(state, base + 6))
    let b7: int64 = int64(BytesGet(state, base + 7))
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) |
           (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)

fn keccakLaneSet(state: Bytes, lane: int32, value: int64) =
    let base: int32 = lane * 8
    BytesSet(state, base, int32(value & 255))
    BytesSet(state, base + 1, int32((value >> 8) & 255))
    BytesSet(state, base + 2, int32((value >> 16) & 255))
    BytesSet(state, base + 3, int32((value >> 24) & 255))
    BytesSet(state, base + 4, int32((value >> 32) & 255))
    BytesSet(state, base + 5, int32((value >> 40) & 255))
    BytesSet(state, base + 6, int32((value >> 48) & 255))
    BytesSet(state, base + 7, int32((value >> 56) & 255))

fn keccakLaneConst(b0: int32, b1: int32, b2: int32, b3: int32,
                   b4: int32, b5: int32, b6: int32, b7: int32): int64 =
    return (int64(b0) << 56) | (int64(b1) << 48) | (int64(b2) << 40) |
           (int64(b3) << 32) | (int64(b4) << 24) | (int64(b5) << 16) |
           (int64(b6) << 8) | int64(b7)

fn keccakRc(round: int32): int64 =
    if round == 0:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01)
    elif round == 1:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x82)
    elif round == 2:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x8a)
    elif round == 3:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x80, 0x00, 0x80, 0x00)
    elif round == 4:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x8b)
    elif round == 5:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x80, 0x00, 0x00, 0x01)
    elif round == 6:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x80, 0x00, 0x80, 0x81)
    elif round == 7:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x09)
    elif round == 8:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x8a)
    elif round == 9:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x88)
    elif round == 10:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x80, 0x00, 0x80, 0x09)
    elif round == 11:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x80, 0x00, 0x00, 0x0a)
    elif round == 12:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x80, 0x00, 0x80, 0x8b)
    elif round == 13:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x8b)
    elif round == 14:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x89)
    elif round == 15:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x03)
    elif round == 16:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x02)
    elif round == 17:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80)
    elif round == 18:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x0a)
    elif round == 19:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x80, 0x00, 0x00, 0x0a)
    elif round == 20:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x80, 0x00, 0x80, 0x81)
    elif round == 21:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80, 0x80)
    elif round == 22:
        return keccakLaneConst(0x00, 0x00, 0x00, 0x00, 0x80, 0x00, 0x00, 0x01)
    elif round == 23:
        return keccakLaneConst(0x80, 0x00, 0x00, 0x00, 0x80, 0x00, 0x80, 0x08)
    Assert(false, "keccakRc: round index out of range")
    return 0

# Keccak-f[1600]: 24 rounds of theta, rho, pi, chi, iota over the
# 5x5 lane state (25 x 64-bit, little-endian, 200 bytes). The state is
# loaded into 25 int64 locals once, all 24 rounds run fully unrolled in
# the lane domain (zero allocations, no per-lane byte traffic), then the
# lanes are stored back. Rho offsets and pi destinations are the FIPS 202
# tables baked in at flat index lane = x + 5*y.
fn KeccakF1600(state: Bytes) =
    Assert(BytesLen(state) == 200, "KeccakF1600: state must be 200 bytes")
    var st0: int64 = keccakLaneGet(state, 0)
    var st1: int64 = keccakLaneGet(state, 1)
    var st2: int64 = keccakLaneGet(state, 2)
    var st3: int64 = keccakLaneGet(state, 3)
    var st4: int64 = keccakLaneGet(state, 4)
    var st5: int64 = keccakLaneGet(state, 5)
    var st6: int64 = keccakLaneGet(state, 6)
    var st7: int64 = keccakLaneGet(state, 7)
    var st8: int64 = keccakLaneGet(state, 8)
    var st9: int64 = keccakLaneGet(state, 9)
    var st10: int64 = keccakLaneGet(state, 10)
    var st11: int64 = keccakLaneGet(state, 11)
    var st12: int64 = keccakLaneGet(state, 12)
    var st13: int64 = keccakLaneGet(state, 13)
    var st14: int64 = keccakLaneGet(state, 14)
    var st15: int64 = keccakLaneGet(state, 15)
    var st16: int64 = keccakLaneGet(state, 16)
    var st17: int64 = keccakLaneGet(state, 17)
    var st18: int64 = keccakLaneGet(state, 18)
    var st19: int64 = keccakLaneGet(state, 19)
    var st20: int64 = keccakLaneGet(state, 20)
    var st21: int64 = keccakLaneGet(state, 21)
    var st22: int64 = keccakLaneGet(state, 22)
    var st23: int64 = keccakLaneGet(state, 23)
    var st24: int64 = keccakLaneGet(state, 24)
    let allOnes: int64 = keccakAllOnes()
    var round: int32
    while round < 24:
        # theta: column parities, then xor the rotated neighbour parity
        let c0: int64 = st0 ^ st5 ^ st10 ^ st15 ^ st20
        let c1: int64 = st1 ^ st6 ^ st11 ^ st16 ^ st21
        let c2: int64 = st2 ^ st7 ^ st12 ^ st17 ^ st22
        let c3: int64 = st3 ^ st8 ^ st13 ^ st18 ^ st23
        let c4: int64 = st4 ^ st9 ^ st14 ^ st19 ^ st24
        let d0: int64 = c4 ^ keccakRotl(c1, 1)
        let d1: int64 = c0 ^ keccakRotl(c2, 1)
        let d2: int64 = c1 ^ keccakRotl(c3, 1)
        let d3: int64 = c2 ^ keccakRotl(c4, 1)
        let d4: int64 = c3 ^ keccakRotl(c0, 1)
        # rho + pi folded with the theta xor: b[pi(src)] = rotl(st[src] ^ d[src%5], rho[src])
        let b0: int64 = st0 ^ d0
        let b10: int64 = keccakRotl(st1 ^ d1, 1)
        let b20: int64 = keccakRotl(st2 ^ d2, 62)
        let b5: int64 = keccakRotl(st3 ^ d3, 28)
        let b15: int64 = keccakRotl(st4 ^ d4, 27)
        let b16: int64 = keccakRotl(st5 ^ d0, 36)
        let b1: int64 = keccakRotl(st6 ^ d1, 44)
        let b11: int64 = keccakRotl(st7 ^ d2, 6)
        let b21: int64 = keccakRotl(st8 ^ d3, 55)
        let b6: int64 = keccakRotl(st9 ^ d4, 20)
        let b7: int64 = keccakRotl(st10 ^ d0, 3)
        let b17: int64 = keccakRotl(st11 ^ d1, 10)
        let b2: int64 = keccakRotl(st12 ^ d2, 43)
        let b12: int64 = keccakRotl(st13 ^ d3, 25)
        let b22: int64 = keccakRotl(st14 ^ d4, 39)
        let b23: int64 = keccakRotl(st15 ^ d0, 41)
        let b8: int64 = keccakRotl(st16 ^ d1, 45)
        let b18: int64 = keccakRotl(st17 ^ d2, 15)
        let b3: int64 = keccakRotl(st18 ^ d3, 21)
        let b13: int64 = keccakRotl(st19 ^ d4, 8)
        let b14: int64 = keccakRotl(st20 ^ d0, 18)
        let b24: int64 = keccakRotl(st21 ^ d1, 2)
        let b9: int64 = keccakRotl(st22 ^ d2, 61)
        let b19: int64 = keccakRotl(st23 ^ d3, 56)
        let b4: int64 = keccakRotl(st24 ^ d4, 14)
        # chi: st[x,y] = b[x,y] ^ (~b[x+1,y] & b[x+2,y])
        st0 = b0 ^ ((b1 ^ allOnes) & b2)
        st1 = b1 ^ ((b2 ^ allOnes) & b3)
        st2 = b2 ^ ((b3 ^ allOnes) & b4)
        st3 = b3 ^ ((b4 ^ allOnes) & b0)
        st4 = b4 ^ ((b0 ^ allOnes) & b1)
        st5 = b5 ^ ((b6 ^ allOnes) & b7)
        st6 = b6 ^ ((b7 ^ allOnes) & b8)
        st7 = b7 ^ ((b8 ^ allOnes) & b9)
        st8 = b8 ^ ((b9 ^ allOnes) & b5)
        st9 = b9 ^ ((b5 ^ allOnes) & b6)
        st10 = b10 ^ ((b11 ^ allOnes) & b12)
        st11 = b11 ^ ((b12 ^ allOnes) & b13)
        st12 = b12 ^ ((b13 ^ allOnes) & b14)
        st13 = b13 ^ ((b14 ^ allOnes) & b10)
        st14 = b14 ^ ((b10 ^ allOnes) & b11)
        st15 = b15 ^ ((b16 ^ allOnes) & b17)
        st16 = b16 ^ ((b17 ^ allOnes) & b18)
        st17 = b17 ^ ((b18 ^ allOnes) & b19)
        st18 = b18 ^ ((b19 ^ allOnes) & b15)
        st19 = b19 ^ ((b15 ^ allOnes) & b16)
        st20 = b20 ^ ((b21 ^ allOnes) & b22)
        st21 = b21 ^ ((b22 ^ allOnes) & b23)
        st22 = b22 ^ ((b23 ^ allOnes) & b24)
        st23 = b23 ^ ((b24 ^ allOnes) & b20)
        st24 = b24 ^ ((b20 ^ allOnes) & b21)
        # iota
        st0 = st0 ^ keccakRc(round)
        round = round + 1
    keccakLaneSet(state, 0, st0)
    keccakLaneSet(state, 1, st1)
    keccakLaneSet(state, 2, st2)
    keccakLaneSet(state, 3, st3)
    keccakLaneSet(state, 4, st4)
    keccakLaneSet(state, 5, st5)
    keccakLaneSet(state, 6, st6)
    keccakLaneSet(state, 7, st7)
    keccakLaneSet(state, 8, st8)
    keccakLaneSet(state, 9, st9)
    keccakLaneSet(state, 10, st10)
    keccakLaneSet(state, 11, st11)
    keccakLaneSet(state, 12, st12)
    keccakLaneSet(state, 13, st13)
    keccakLaneSet(state, 14, st14)
    keccakLaneSet(state, 15, st15)
    keccakLaneSet(state, 16, st16)
    keccakLaneSet(state, 17, st17)
    keccakLaneSet(state, 18, st18)
    keccakLaneSet(state, 19, st19)
    keccakLaneSet(state, 20, st20)
    keccakLaneSet(state, 21, st21)
    keccakLaneSet(state, 22, st22)
    keccakLaneSet(state, 23, st23)
    keccakLaneSet(state, 24, st24)

# Sponge: absorb data at the given rate with the pad10*1 domain-separated
# padding byte, then squeeze outLen bytes.
@borrows
fn keccakSponge(data: Bytes, rate: int32, domainSep: int32, outLen: int32): Bytes =
    Assert(rate > 0 && rate < 200, "keccakSponge: invalid rate")
    Assert(outLen > 0, "keccakSponge: output length must be positive")
    var state: Bytes = BytesAlloc(200)
    let inputLen: int32 = BytesLen(data)
    var offset: int32
    var i: int32
    while inputLen - offset >= rate:
        i = 0
        while i < rate:
            BytesSet(state, i, BytesGet(state, i) ^ BytesGet(data, offset + i))
            i = i + 1
        KeccakF1600(state)
        offset = offset + rate
    let rem: int32 = inputLen - offset
    var j: int32
    while j < rem:
        BytesSet(state, j, BytesGet(state, j) ^ BytesGet(data, offset + j))
        j = j + 1
    BytesSet(state, rem, BytesGet(state, rem) ^ domainSep)
    BytesSet(state, rate - 1, BytesGet(state, rate - 1) ^ 0x80)
    KeccakF1600(state)
    let out: Bytes = BytesAlloc(outLen)
    var produced: int32
    var k: int32
    while produced < outLen:
        var take: int32 = outLen - produced
        if take > rate:
            take = rate
        k = 0
        while k < take:
            BytesSet(out, produced + k, BytesGet(state, k))
            k = k + 1
        produced = produced + take
        if produced < outLen:
            KeccakF1600(state)
    BytesFree(state)
    return out

@borrows
fn Sha3_256Digest(data: Bytes): Bytes =
    return keccakSponge(data, 136, 0x06, 32)

fn Sha3_512Digest(data: Bytes): Bytes =
    return keccakSponge(data, 72, 0x06, 64)

fn Shake128Xof(data: Bytes, outLen: int32): Bytes =
    return keccakSponge(data, 168, 0x1f, outLen)

fn Shake256Xof(data: Bytes, outLen: int32): Bytes =
    return keccakSponge(data, 136, 0x1f, outLen)
