# ML-DSA (FIPS 204) polynomial math layer over R_q = Z_q[x]/(x^256 + 1),
# q = 8380417 = 2^23 - 2^13 + 1, zeta = 1753, d = 13.
#   - NTT / inverse NTT             (FIPS 204 Algorithms 41 / 42, 8 layers)
#   - MultiplyNTTs                  (Algorithm 45, fully split pointwise)
#   - Power2Round                   (Algorithm 35, d = 13)
#   - Decompose / HighBits / LowBits (Algorithms 36 / 37 / 38, gamma2 in
#     {(q-1)/88, (q-1)/32})
#   - MakeHint / UseHint            (Algorithms 39 / 40)
#   - SimpleBitPack / SimpleBitUnpack / BitPack / BitUnpack
#     (Algorithms 16 / 18 family, bit width parameterized)
#   - RejNTTPoly                    (Algorithm 30, SHAKE128 23-bit rejection)
#   - RejBoundedPoly                (Algorithm 31, eta = 2 or 4)
#   - ExpandMask (single polynomial) (Algorithm 34 body, gamma1 = 2^17 / 2^19)
# Coefficients are kept canonical in [0, q). Products reach ~2^46, so every
# modular multiplication goes through int64. int64 % truncates the dividend
# to its low 32 bits (miscompile family, probe 2026-06-12: 5000000000 % 7
# == 5; int64 / is correct), so reduction is division-free: fold
# 2^23 == 2^13 - 1 (mod q) with shifts/masks only. The >= 2^31 literal /
# bit63 / negative-shift hazards are avoided by construction.

import std/rawbytes
import std/system
import std/crypto/sha3

fn MldsaQ(): int32 =
    return 8380417

fn MldsaN(): int32 =
    return 256

# Exact reduction of p in [0, 2^46) mod q without division: q = 2^23 -
# 2^13 + 1 gives 2^23 == 2^13 - 1 (mod q), so each fold maps
# p -> (p >> 23) * 8191 + (p & (2^23 - 1)). Bounds per fold:
# 2^46 -> 2^36 -> 2^27 -> 2^24 -> < 2q, then one conditional subtract.
# All intermediates are non-negative, so arithmetic shifts are exact.
fn mldsaReduce46(p: int64): int32 =
    var t: int64 = p
    t = (t >> 23) * 8191 + (t & 8388607)
    t = (t >> 23) * 8191 + (t & 8388607)
    t = (t >> 23) * 8191 + (t & 8388607)
    t = (t >> 23) * 8191 + (t & 8388607)
    var r: int32 = int32(t)
    while r >= 8380417:
        r = r - 8380417
    return r

# 256^{-1} mod q (for the final INTT scaling, FIPS 204 Algorithm 42).
fn mldsaInv256(): int32 =
    return 8347681

fn MldsaAddMod(a: int32, b: int32): int32 =
    Assert(a >= 0 && a < 8380417 && b >= 0 && b < 8380417, "MldsaAddMod: inputs must be canonical in [0, q)")
    var s: int32 = a + b
    if s >= 8380417:
        s = s - 8380417
    return s

fn MldsaSubMod(a: int32, b: int32): int32 =
    Assert(a >= 0 && a < 8380417 && b >= 0 && b < 8380417, "MldsaSubMod: inputs must be canonical in [0, q)")
    var s: int32 = a - b
    if s < 0:
        s = s + 8380417
    return s

fn MldsaMulMod(a: int32, b: int32): int32 =
    Assert(a >= 0 && a < 8380417 && b >= 0 && b < 8380417, "MldsaMulMod: inputs must be canonical in [0, q)")
    return mldsaReduce46(int64(a) * int64(b))

# Map canonical [0, q) to the centered representative mod+- q
# in [-(q-1)/2, (q-1)/2].
fn MldsaCentered(x: int32): int32 =
    Assert(x >= 0 && x < 8380417, "MldsaCentered: input must be canonical in [0, q)")
    if x > 4190208:
        return x - 8380417
    return x

# Map a signed value with |x| < q back to canonical [0, q).
fn MldsaCanonical(x: int32): int32 =
    Assert(x > 0 - 8380417 && x < 8380417, "MldsaCanonical: |x| must be < q")
    if x < 0:
        return x + 8380417
    return x

# Reverse the low 8 bits of x.
fn mldsaBitRev8(x: int32): int32 =
    var out: int32
    var i: int32
    while i < 8:
        out = (out << 1) | ((x >> i) & 1)
        i = i + 1
    return out

# zetas[k] = 1753^BitRev8(k) mod q for k in 0..255 (NTT twiddle factors;
# index 0 is never consumed by the butterflies).
fn mldsaZetaTable(): int32[] =
    var pow: int32[]
    setLen(pow, 256)
    pow[0] = 1
    for k in 1..<256:
        pow[k] = MldsaMulMod(pow[k - 1], 1753)
    var zetas: int32[]
    setLen(zetas, 256)
    for i in 0..<256:
        zetas[i] = pow[mldsaBitRev8(i)]
    return zetas

fn MldsaPolyNew(): int32[] =
    var f: int32[]
    setLen(f, 256)
    return f

@borrows
fn MldsaPolyAdd(f: int32[], g: int32[]): int32[] =
    Assert(f.len == 256 && g.len == 256, "MldsaPolyAdd: polynomials must have 256 coefficients")
    var h: int32[]
    setLen(h, 256)
    for i in 0..<256:
        h[i] = MldsaAddMod(f[i], g[i])
    return h

@borrows
fn MldsaPolySub(f: int32[], g: int32[]): int32[] =
    Assert(f.len == 256 && g.len == 256, "MldsaPolySub: polynomials must have 256 coefficients")
    var h: int32[]
    setLen(h, 256)
    for i in 0..<256:
        h[i] = MldsaSubMod(f[i], g[i])
    return h

# FIPS 204 Algorithm 41: NTT, 8 butterfly layers (fully split into 256
# degree-0 components). Pure: returns a fresh array.
@borrows
fn MldsaNtt(f: int32[]): int32[] =
    Assert(f.len == 256, "MldsaNtt: polynomial must have 256 coefficients")
    let zetas: int32[] = mldsaZetaTable()
    var w: int32[]
    setLen(w, 256)
    for c in 0..<256:
        w[c] = f[c]
    var k: int32
    var span: int32 = 128
    while span >= 1:
        var start: int32
        while start < 256:
            k = k + 1
            let zeta: int32 = zetas[k]
            var j: int32 = start
            while j < start + span:
                let t: int32 = MldsaMulMod(zeta, w[j + span])
                w[j + span] = MldsaSubMod(w[j], t)
                w[j] = MldsaAddMod(w[j], t)
                j = j + 1
            start = start + 2 * span
        span = span / 2
    return w

# FIPS 204 Algorithm 42: inverse NTT. Pure: returns a fresh array.
@borrows
fn MldsaIntt(f: int32[]): int32[] =
    Assert(f.len == 256, "MldsaIntt: polynomial must have 256 coefficients")
    let zetas: int32[] = mldsaZetaTable()
    var w: int32[]
    setLen(w, 256)
    for c in 0..<256:
        w[c] = f[c]
    var k: int32 = 256
    var span: int32 = 1
    while span < 256:
        var start: int32
        while start < 256:
            k = k - 1
            let zetaNeg: int32 = 8380417 - zetas[k]
            var j: int32 = start
            while j < start + span:
                let t: int32 = w[j]
                w[j] = MldsaAddMod(t, w[j + span])
                w[j + span] = MldsaSubMod(t, w[j + span])
                w[j + span] = MldsaMulMod(zetaNeg, w[j + span])
                j = j + 1
            start = start + 2 * span
        span = span * 2
    for c in 0..<256:
        w[c] = MldsaMulMod(w[c], mldsaInv256())
    return w

# FIPS 204 Algorithm 45: pointwise product in the NTT domain.
@borrows
fn MldsaMultiplyNtts(f: int32[], g: int32[]): int32[] =
    Assert(f.len == 256 && g.len == 256, "MldsaMultiplyNtts: polynomials must have 256 coefficients")
    var h: int32[]
    setLen(h, 256)
    for i in 0..<256:
        h[i] = MldsaMulMod(f[i], g[i])
    return h

# FIPS 204 Algorithm 35 (Power2Round, d = 13): r = r1 * 2^13 + r0 with
# r0 = r mod+- 2^13 in (-2^12, 2^12]. These two accessors recompute the
# shared centering; r is canonical in [0, q).
fn MldsaPower2RoundLow(r: int32): int32 =
    Assert(r >= 0 && r < 8380417, "MldsaPower2RoundLow: input must be canonical in [0, q)")
    var r0: int32 = r & 8191
    if r0 > 4096:
        r0 = r0 - 8192
    return r0

fn MldsaPower2RoundHigh(r: int32): int32 =
    Assert(r >= 0 && r < 8380417, "MldsaPower2RoundHigh: input must be canonical in [0, q)")
    return (r - MldsaPower2RoundLow(r)) / 8192

# FIPS 204 Algorithm 36 (Decompose): r = r1 * (2 * gamma2) + r0 (mod q) with
# r0 = r mod+- (2 * gamma2); the r+ - r0 == q - 1 corner folds r1 to 0 and
# shifts r0 down by 1. gamma2 is (q-1)/88 = 95232 or (q-1)/32 = 261888.
fn mldsaCheckGamma2(gamma2: int32) =
    Assert(gamma2 == 95232 || gamma2 == 261888, "mldsaCheckGamma2: gamma2 must be (q-1)/88 or (q-1)/32")

# FIPS 204 Algorithm 38 (LowBits).
fn MldsaLowBits(r: int32, gamma2: int32): int32 =
    mldsaCheckGamma2(gamma2)
    Assert(r >= 0 && r < 8380417, "MldsaLowBits: input must be canonical in [0, q)")
    var r0: int32 = r % (2 * gamma2)
    if r0 > gamma2:
        r0 = r0 - 2 * gamma2
    if r - r0 == 8380416:
        r0 = r0 - 1
    return r0

# FIPS 204 Algorithm 37 (HighBits).
fn MldsaHighBits(r: int32, gamma2: int32): int32 =
    mldsaCheckGamma2(gamma2)
    Assert(r >= 0 && r < 8380417, "MldsaHighBits: input must be canonical in [0, q)")
    var r0: int32 = r % (2 * gamma2)
    if r0 > gamma2:
        r0 = r0 - 2 * gamma2
    if r - r0 == 8380416:
        return 0
    return (r - r0) / (2 * gamma2)

# FIPS 204 Algorithm 39 (MakeHint): hint bit telling whether adding z to r
# changes the high bits. z and r are canonical in [0, q).
fn MldsaMakeHint(z: int32, r: int32, gamma2: int32): int32 =
    mldsaCheckGamma2(gamma2)
    let r1: int32 = MldsaHighBits(r, gamma2)
    let v1: int32 = MldsaHighBits(MldsaAddMod(r, z), gamma2)
    if r1 != v1:
        return 1
    return 0

# FIPS 204 Algorithm 40 (UseHint): recover HighBits(r + z) from the hint.
fn MldsaUseHint(h: int32, r: int32, gamma2: int32): int32 =
    mldsaCheckGamma2(gamma2)
    Assert(h == 0 || h == 1, "MldsaUseHint: hint must be 0 or 1")
    let m: int32 = 8380416 / (2 * gamma2)
    let r1: int32 = MldsaHighBits(r, gamma2)
    if h == 0:
        return r1
    if MldsaLowBits(r, gamma2) > 0:
        return (r1 + 1) % m
    return (r1 + m - 1) % m

# Bit length of x >= 1.
fn mldsaBitLen(x: int32): int32 =
    Assert(x >= 1, "mldsaBitLen: input must be >= 1")
    var v: int32 = x
    var c: int32
    while v > 0:
        v = v >> 1
        c = c + 1
    return c

# FIPS 204 Algorithm 16 (SimpleBitPack): pack 256 coefficients in [0, b]
# into 32 * bitlen(b) bytes, little-endian bit order within the stream.
fn MldsaSimpleBitPack(f: int32[], b: int32): Bytes =
    Assert(f.len == 256, "MldsaSimpleBitPack: polynomial must have 256 coefficients")
    let c: int32 = mldsaBitLen(b)
    Assert(c <= 20, "MldsaSimpleBitPack: bit width must be <= 20")
    let out: Bytes = BytesAlloc(32 * c)
    var acc: int32
    var accBits: int32
    var outPos: int32
    for i in 0..<256:
        Assert(f[i] >= 0 && f[i] <= b, "MldsaSimpleBitPack: coefficient out of range")
        acc = acc | (f[i] << accBits)
        accBits = accBits + c
        while accBits >= 8:
            BytesSet(out, outPos, acc & 255)
            outPos = outPos + 1
            acc = acc >> 8
            accBits = accBits - 8
    return out

# FIPS 204 Algorithm 18 (SimpleBitUnpack): inverse of SimpleBitPack; output
# values lie in [0, 2^bitlen(b) - 1] and may exceed b (validity is checked
# by the caller, as in the standard).
fn MldsaSimpleBitUnpack(v: Bytes, b: int32): int32[] =
    let c: int32 = mldsaBitLen(b)
    Assert(c <= 20, "MldsaSimpleBitUnpack: bit width must be <= 20")
    Assert(BytesLen(v) == 32 * c, "MldsaSimpleBitUnpack: input must be 32*bitlen(b) bytes")
    var f: int32[]
    setLen(f, 256)
    var acc: int32
    var accBits: int32
    var pos: int32
    for i in 0..<256:
        while accBits < c:
            acc = acc | (BytesGet(v, pos) << accBits)
            pos = pos + 1
            accBits = accBits + 8
        f[i] = acc & ((1 << c) - 1)
        acc = acc >> c
        accBits = accBits - c
    return f

# FIPS 204 Algorithm 17 (BitPack): coefficients are canonical mod-q values
# whose centered representatives lie in [-a, b]; each is stored as
# b - centered(f[i]) in bitlen(a + b) bits.
fn MldsaBitPack(f: int32[], a: int32, b: int32): Bytes =
    Assert(f.len == 256, "MldsaBitPack: polynomial must have 256 coefficients")
    Assert(a >= 0 && b >= 1, "MldsaBitPack: need a >= 0 and b >= 1")
    let c: int32 = mldsaBitLen(a + b)
    Assert(c <= 20, "MldsaBitPack: bit width must be <= 20")
    let out: Bytes = BytesAlloc(32 * c)
    var acc: int32
    var accBits: int32
    var outPos: int32
    for i in 0..<256:
        let w: int32 = MldsaCentered(f[i])
        Assert(w >= 0 - a && w <= b, "MldsaBitPack: centered coefficient out of [-a, b]")
        let z: int32 = b - w
        acc = acc | (z << accBits)
        accBits = accBits + c
        while accBits >= 8:
            BytesSet(out, outPos, acc & 255)
            outPos = outPos + 1
            acc = acc >> 8
            accBits = accBits - 8
    return out

# FIPS 204 Algorithm 19 (BitUnpack): inverse of BitPack; returns canonical
# mod-q values. As in the standard the centered value may fall outside
# [-a, b] for adversarial input; range validity is checked by the caller.
fn MldsaBitUnpack(v: Bytes, a: int32, b: int32): int32[] =
    Assert(a >= 0 && b >= 1, "MldsaBitUnpack: need a >= 0 and b >= 1")
    let c: int32 = mldsaBitLen(a + b)
    Assert(c <= 20, "MldsaBitUnpack: bit width must be <= 20")
    Assert(BytesLen(v) == 32 * c, "MldsaBitUnpack: input must be 32*bitlen(a+b) bytes")
    var f: int32[]
    setLen(f, 256)
    var acc: int32
    var accBits: int32
    var pos: int32
    for i in 0..<256:
        while accBits < c:
            acc = acc | (BytesGet(v, pos) << accBits)
            pos = pos + 1
            accBits = accBits + 8
        let z: int32 = acc & ((1 << c) - 1)
        acc = acc >> c
        accBits = accBits - c
        f[i] = MldsaCanonical(b - z)
    return f

# FIPS 204 Algorithm 30 (RejNTTPoly) with Algorithm 14
# (CoeffFromThreeBytes) inlined: rejection-sample a polynomial in the NTT
# domain from SHAKE128(seed). seed is the 34-byte XOF input (rho || s || r).
# The one-shot SHAKE is re-squeezed with a longer output when the stream
# runs out; SHAKE outputs are prefix-consistent, so already-consumed
# positions keep their values.
fn MldsaRejNttPoly(seed: Bytes): int32[] =
    Assert(BytesLen(seed) == 34, "MldsaRejNttPoly: seed must be 34 bytes")
    var a: int32[]
    setLen(a, 256)
    var bufLen: int32 = 840
    var buf: Bytes = sha3.Shake128Xof(seed, bufLen)
    var pos: int32
    var j: int32
    while j < 256:
        if pos + 3 > bufLen:
            bufLen = bufLen + 504
            buf = sha3.Shake128Xof(seed, bufLen)
        let c0: int32 = BytesGet(buf, pos)
        let c1: int32 = BytesGet(buf, pos + 1)
        let c2: int32 = BytesGet(buf, pos + 2) & 127
        pos = pos + 3
        let z: int32 = c0 + 256 * c1 + 65536 * c2
        if z < 8380417:
            a[j] = z
            j = j + 1
    return a

# FIPS 204 Algorithm 15 (CoeffFromHalfByte): returns the canonical mod-q
# coefficient, or -1 when the half-byte is rejected.
fn mldsaCoeffFromHalfByte(z: int32, eta: int32): int32 =
    if eta == 2:
        if z < 15:
            return MldsaCanonical(2 - (z % 5))
        return 0 - 1
    if z < 9:
        return MldsaCanonical(4 - z)
    return 0 - 1

# FIPS 204 Algorithm 31 (RejBoundedPoly): rejection-sample a polynomial
# with coefficients in [-eta, eta] (stored canonical mod q) from
# SHAKE256(seed). seed is the 66-byte XOF input (rho || two index bytes).
fn MldsaRejBoundedPoly(seed: Bytes, eta: int32): int32[] =
    Assert(BytesLen(seed) == 66, "MldsaRejBoundedPoly: seed must be 66 bytes")
    Assert(eta == 2 || eta == 4, "MldsaRejBoundedPoly: eta must be 2 or 4")
    var a: int32[]
    setLen(a, 256)
    var bufLen: int32 = 272
    var buf: Bytes = sha3.Shake256Xof(seed, bufLen)
    var pos: int32
    var j: int32
    while j < 256:
        if pos >= bufLen:
            bufLen = bufLen + 136
            buf = sha3.Shake256Xof(seed, bufLen)
        let z: int32 = BytesGet(buf, pos)
        pos = pos + 1
        let z0: int32 = mldsaCoeffFromHalfByte(z & 15, eta)
        if z0 >= 0:
            a[j] = z0
            j = j + 1
        let z1: int32 = mldsaCoeffFromHalfByte(z >> 4, eta)
        if z1 >= 0 && j < 256:
            a[j] = z1
            j = j + 1
    return a

# FIPS 204 Algorithm 34 (ExpandMask) body for a single polynomial: the
# caller supplies the 66-byte XOF input (rho' || IntegerToBytes(mu + r, 2));
# the c = 1 + bitlen(gamma1 - 1) bit stream is decoded with BitUnpack.
# gamma1 is 2^17 = 131072 or 2^19 = 524288; coefficients land in
# [-gamma1 + 1, gamma1], stored canonical mod q.
fn MldsaExpandMaskPoly(seed: Bytes, gamma1: int32): int32[] =
    Assert(BytesLen(seed) == 66, "MldsaExpandMaskPoly: seed must be 66 bytes")
    Assert(gamma1 == 131072 || gamma1 == 524288, "MldsaExpandMaskPoly: gamma1 must be 2^17 or 2^19")
    var c: int32 = 18
    if gamma1 == 524288:
        c = 20
    let v: Bytes = sha3.Shake256Xof(seed, 32 * c)
    return MldsaBitUnpack(v, gamma1 - 1, gamma1)
