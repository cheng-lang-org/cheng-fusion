# vrf.cheng - ECVRF-EDWARDS25519-SHA512-TAI (draft-irtf-cfrg-vrf-15, Section 5.5)
#
# suite_string = 0x03; cofactor = 8; cLen = 16; ptLen = qLen = 32.
# Nonce generation: RFC 8032 style (Section 5.4.2.2 of the draft).
# encode_to_curve_salt = PK_string; TAI interpret = string_to_point(hash[0..31]).
# All integers little-endian per RFC 8032 Section 5.1.2.

import std/rawbytes
import std/result
import std/system
import std/crypto/sha512
import std/crypto/ed25519/ref10 as ref10

const
    VrfSuiteTai: int32 = 0x03
    VrfPtLen: int32 = 32
    VrfCLen: int32 = 16
    VrfQLen: int32 = 32
    VrfPiLen: int32 = VrfPtLen + VrfCLen + VrfQLen
    VrfBetaLen: int32 = 64

type
    VrfKeyMaterial =
        scalar: Bytes
        prefix: Bytes
        pk: Bytes

# ---------- field/group helpers (negation via the negate-vartime decode path) ----------

fn VrfFeNegate(src: ref10.Fe): ref10.Fe =
    var outF: ref10.Fe
    ref10.feNeg(outF, src)
    return outF

# Standard RFC 8032 Section 5.1.3 point decode. ref10 exposes only the
# negate-vartime variant (Ed25519 verify convention), so flip x/t back.
@borrows
fn VrfStringToPoint(s: Bytes): Result[ref10.GeP3] =
    if s.len != VrfPtLen:
        return Err[ref10.GeP3]("vrf: point string must be 32 bytes")
    var neg: ref10.GeP3
    if !ref10.GeFromBytesNegateVartime(neg, s):
        return Err[ref10.GeP3]("vrf: string_to_point invalid encoding")
    var outP: ref10.GeP3
    outP.x = VrfFeNegate(neg.x)
    outP.y = neg.y
    outP.z = neg.z
    outP.t = VrfFeNegate(neg.t)
    return Ok[ref10.GeP3](outP)

fn VrfIsIdentity(p: ref10.GeP3): bool =
    return ref10.feIsNonZero(p.x) == 0

# ref10 decodes its base-point constant through the negate-vartime path,
# so geScalarMultBase yields -[a]B under RFC 8032 conventions (verified:
# seed 9d61b19d... encodes ...511a as d75a...519a). Flip back here so the
# VRF operates on the standard group. The library is internally consistent
# (-B convention across libp2p sign/verify); fixing it at the source would
# invalidate existing peer identities and is tracked separately.
@borrows
fn VrfBaseMultStd(a: Bytes): ref10.GeP3 =
    var neg: ref10.GeP3
    ref10.geScalarMultBase(neg, a)
    var outP: ref10.GeP3
    outP.x = VrfFeNegate(neg.x)
    outP.y = neg.y
    outP.z = neg.z
    outP.t = VrfFeNegate(neg.t)
    return outP

fn VrfDoubleThreeTimes(p: var ref10.GeP3) =
    var t1: ref10.GeP3
    ref10.geDouble(t1, p)
    var t2: ref10.GeP3
    ref10.geDouble(t2, t1)
    ref10.geDouble(p, t2)

# cofactor*Y != identity, per draft Section 5.4.5.
@borrows
fn VrfValidateKey(pk: Bytes): Result[bool] =
    let yRes = VrfStringToPoint(pk)
    if !yRes.ok:
        return Err[bool](yRes.err.msg)
    var y = yRes.value
    VrfDoubleThreeTimes(y)
    if VrfIsIdentity(y):
        return Err[bool]("vrf: public key is low-order (cofactor cleared to identity)")
    return Ok[bool](true)

# ---------- key handling (RFC 8032 Section 5.1.5 derivation) ----------

@borrows
fn VrfExpandSecret(sk: Bytes): Result[VrfKeyMaterial] =
    if sk.len != VrfQLen:
        return Err[VrfKeyMaterial]("vrf: secret key must be 32 bytes")
    let h = sha512.Sha512Digest(sk)
    var scalar = BytesSlice(h, 0, 32)
    BytesSet(scalar, 0, BytesGet(scalar, 0) & 248)
    BytesSet(scalar, 31, (BytesGet(scalar, 31) & 127) | 64)
    var prefix = BytesSlice(h, 32, 32)
    var km: VrfKeyMaterial
    km.scalar = scalar
    km.prefix = prefix
    km.pk = ref10.geP3ToBytes(VrfBaseMultStd(scalar))
    return Ok[VrfKeyMaterial](km)

@borrows
fn VrfPublicFromSecret(sk: Bytes): Result[Bytes] =
    let kmRes = VrfExpandSecret(sk)
    if !kmRes.ok:
        return Err[Bytes](kmRes.err.msg)
    return Ok[Bytes](kmRes.value.pk)

# ---------- draft Section 5.4.1.1 try-and-increment with salt = PK ----------

@borrows
fn VrfEncodeToCurveTai(pk: Bytes, alpha: Bytes): Result[ref10.GeP3] =
    let msgLen: int32 = 2 + pk.len + alpha.len + 2
    var buf = BytesAlloc(msgLen)
    BytesSet(buf, 0, VrfSuiteTai)
    BytesSet(buf, 1, 0x01)
    var i: int32
    while i < pk.len:
        BytesSet(buf, 2 + i, BytesGet(pk, i))
        i = i + 1
    var j: int32
    while j < alpha.len:
        BytesSet(buf, 2 + pk.len + j, BytesGet(alpha, j))
        j = j + 1
    let ctrPos: int32 = 2 + pk.len + alpha.len
    BytesSet(buf, ctrPos + 1, 0x00)
    var ctr: int32
    while ctr < 256:
        BytesSet(buf, ctrPos, ctr)
        let h = sha512.Sha512Digest(buf)
        let ptRes = VrfStringToPoint(BytesSlice(h, 0, 32))
        if ptRes.ok:
            var pt = ptRes.value
            if !VrfIsIdentity(pt):
                # cofactor > 1: H = 8 * H (draft step 5.d)
                VrfDoubleThreeTimes(pt)
                BytesFree(buf)
                return Ok[ref10.GeP3](pt)
        ctr = ctr + 1
    BytesFree(buf)
    return Err[ref10.GeP3]("vrf: try-and-increment exhausted 256 counters")

# ---------- draft Section 5.4.2.2 nonce generation (RFC 8032 style) ----------

@borrows
fn VrfNonceRfc8032(prefix: Bytes, hString: Bytes): Bytes =
    let k64 = sha512.Sha512Digest2(prefix, hString)
    return ref10.scReduce(k64)

# ---------- draft Section 5.4.3 challenge generation ----------

@borrows
fn VrfChallengeGeneration(yStr: Bytes, hStr: Bytes, gammaStr: Bytes,
                          uStr: Bytes, vStr: Bytes): Bytes =
    # suite(1) + front(1) + five points(160) + back(1)
    let total: int32 = 2 + 5 * VrfPtLen + 1
    var buf = BytesAlloc(total)
    BytesSet(buf, 0, VrfSuiteTai)
    BytesSet(buf, 1, 0x02)
    var off: int32 = 2
    var idx: int32
    while idx < 32:
        BytesSet(buf, off + idx, BytesGet(yStr, idx))
        BytesSet(buf, off + 32 + idx, BytesGet(hStr, idx))
        BytesSet(buf, off + 64 + idx, BytesGet(gammaStr, idx))
        BytesSet(buf, off + 96 + idx, BytesGet(uStr, idx))
        BytesSet(buf, off + 128 + idx, BytesGet(vStr, idx))
        idx = idx + 1
    BytesSet(buf, total - 1, 0x00)
    let d = sha512.Sha512Digest(buf)
    BytesFree(buf)
    return BytesSlice(d, 0, VrfCLen)

@borrows
fn VrfPad16To32(c16: Bytes): Bytes =
    var cPad = BytesAlloc(VrfQLen)
    var i: int32
    while i < VrfCLen:
        BytesSet(cPad, i, BytesGet(c16, i))
        i = i + 1
    return cPad

# ---------- proving / proof-to-hash / verifying ----------

# pi_string layout (draft Section 5.1 step 8):
#   Gamma(32) || c(16, LE) || s(32, LE), total 80 bytes.
@borrows
fn VrfProve(sk: Bytes, alpha: Bytes): Result[Bytes] =
    let kmRes = VrfExpandSecret(sk)
    if !kmRes.ok:
        return Err[Bytes](kmRes.err.msg)
    let km = kmRes.value
    let hRes = VrfEncodeToCurveTai(km.pk, alpha)
    if !hRes.ok:
        return Err[Bytes](hRes.err.msg)
    var hPoint = hRes.value
    let hStr = ref10.geP3ToBytes(hPoint)
    var gamma: ref10.GeP3
    ref10.geScalarMult(gamma, km.scalar, hPoint)
    let gammaStr = ref10.geP3ToBytes(gamma)
    let k = VrfNonceRfc8032(km.prefix, hStr)
    let uStr = ref10.geP3ToBytes(VrfBaseMultStd(k))
    var vPoint: ref10.GeP3
    ref10.geScalarMult(vPoint, k, hPoint)
    let vStr = ref10.geP3ToBytes(vPoint)
    let c16 = VrfChallengeGeneration(km.pk, hStr, gammaStr, uStr, vStr)
    let cPad = VrfPad16To32(c16)
    let s = ref10.scMulAdd(cPad, km.scalar, k)
    var pi = BytesAlloc(VrfPiLen)
    var i: int32
    while i < VrfPtLen:
        BytesSet(pi, i, BytesGet(gammaStr, i))
        BytesSet(pi, VrfPtLen + VrfCLen + i, BytesGet(s, i))
        i = i + 1
    i = 0
    while i < VrfCLen:
        BytesSet(pi, VrfPtLen + i, BytesGet(c16, i))
        i = i + 1
    return Ok[Bytes](pi)

# beta = SHA512(suite || 0x03 || point_to_string(cofactor * Gamma) || 0x00)
# (draft Section 5.2 steps 4-6).
@borrows
fn VrfProofToHash(pi: Bytes): Result[Bytes] =
    if pi.len != VrfPiLen:
        return Err[Bytes]("vrf: proof length invalid")
    let gRes = VrfStringToPoint(BytesSlice(pi, 0, VrfPtLen))
    if !gRes.ok:
        return Err[Bytes](gRes.err.msg)
    var gamma8 = gRes.value
    VrfDoubleThreeTimes(gamma8)
    let g8Str = ref10.geP3ToBytes(gamma8)
    # suite(1) + front(1) + point(32) + back(1); the trailing separator is an
    # appended octet and must not overlap the point encoding.
    let total: int32 = 2 + VrfPtLen + 1
    var buf = BytesAlloc(total)
    BytesSet(buf, 0, VrfSuiteTai)
    BytesSet(buf, 1, 0x03)
    var i: int32
    while i < VrfPtLen:
        BytesSet(buf, 2 + i, BytesGet(g8Str, i))
        i = i + 1
    BytesSet(buf, total - 1, 0x00)
    let beta = sha512.Sha512Digest(buf)
    BytesFree(buf)
    return Ok[Bytes](beta)

@borrows
fn VrfDecodeProof(pi: Bytes): Result[ref10.GeP3] =
    if pi.len != VrfPiLen:
        return Err[ref10.GeP3]("vrf: proof length invalid")
    let sStr = BytesSlice(pi, VrfPtLen + VrfCLen, VrfQLen)
    if !ref10.checkScalar(sStr):
        return Err[ref10.GeP3]("vrf: scalar s out of range")
    let gRes = VrfStringToPoint(BytesSlice(pi, 0, VrfPtLen))
    if !gRes.ok:
        return Err[ref10.GeP3](gRes.err.msg)
    return Ok[ref10.GeP3](gRes.value)

# U = s*B - c*Y and V = s*H - c*Gamma via addition of the negated point
# (draft Section 5.3 steps 8-9).
fn VrfVerify(pk: Bytes, alpha: Bytes, pi: Bytes): Result[Bytes] =
    if pk.len != VrfPtLen:
        return Err[Bytes]("vrf: public key length invalid")
    let valRes = VrfValidateKey(pk)
    if !valRes.ok:
        return Err[Bytes](valRes.err.msg)
    let decRes = VrfDecodeProof(pi)
    if !decRes.ok:
        return Err[Bytes](decRes.err.msg)
    var gamma = decRes.value
    let gammaStr = BytesSlice(pi, 0, VrfPtLen)
    let c16 = BytesSlice(pi, VrfPtLen, VrfCLen)
    let sStr = BytesSlice(pi, VrfPtLen + VrfCLen, VrfQLen)
    let yRes = VrfStringToPoint(pk)
    if !yRes.ok:
        return Err[Bytes](yRes.err.msg)
    var yPoint = yRes.value
    let hRes = VrfEncodeToCurveTai(pk, alpha)
    if !hRes.ok:
        return Err[Bytes](hRes.err.msg)
    var hPoint = hRes.value
    let hStr = ref10.geP3ToBytes(hPoint)
    let cPad = VrfPad16To32(c16)
    var sb: ref10.GeP3 = VrfBaseMultStd(sStr)
    var negY = yPoint
    negY.x = VrfFeNegate(yPoint.x)
    negY.t = VrfFeNegate(yPoint.t)
    var cy: ref10.GeP3
    ref10.geScalarMult(cy, cPad, negY)
    var uPoint: ref10.GeP3
    ref10.geAdd(uPoint, sb, cy)
    var sh: ref10.GeP3
    ref10.geScalarMult(sh, sStr, hPoint)
    var negGamma = gamma
    negGamma.x = VrfFeNegate(gamma.x)
    negGamma.t = VrfFeNegate(gamma.t)
    var cg: ref10.GeP3
    ref10.geScalarMult(cg, cPad, negGamma)
    var vPoint: ref10.GeP3
    ref10.geAdd(vPoint, sh, cg)
    let uStr = ref10.geP3ToBytes(uPoint)
    let vStr = ref10.geP3ToBytes(vPoint)
    let cPrime = VrfChallengeGeneration(pk, hStr, gammaStr, uStr, vStr)
    var i: int32
    while i < VrfCLen:
        if BytesGet(cPrime, i) != BytesGet(c16, i):
            return Err[Bytes]("vrf: challenge mismatch")
        i = i + 1
    return VrfProofToHash(pi)
