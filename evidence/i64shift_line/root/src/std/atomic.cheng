@importc("cheng_panic_cstring_and_exit")
fn atomicPanicRaw(text: cstring): void

@importc("cheng_atomic_fetch_add_i32")
fn atomicFetchAddI32Raw(p: ptr, delta: int32): int32

@importc("cheng_atomic_store_i32")
fn atomicStoreI32(p: ptr, val: int32)

@importc("cheng_atomic_load_i32")
fn atomicLoadI32(p: ptr): int32

@importc("cheng_atomic_cas_i32")
fn atomicCasI32(p: ptr, expect: int32, desired: int32): int32

@importc("malloc")
fn c_malloc(size: int64): ptr

fn Malloc(size: int32): ptr =
    if size <= 0: return nil
    return c_malloc(int64(size))

type
    I32 = ref object
        value: int32

fn NewI32(value: int32): I32 =
    var a: I32 = new(I32)
    if a != nil:
        a.value = value
    return a

@borrows
fn LoadI32(a: I32): int32 =
    if a == nil:
        atomicPanicRaw("std_atomic_i32_load_nil")
        return 0
    return atomicLoadI32(&a.value)

@borrows
fn StoreI32(a: I32, value: int32) =
    if a == nil:
        atomicPanicRaw("std_atomic_i32_store_nil")
        return
    atomicStoreI32(&a.value, value)

@borrows
fn CasI32(a: I32,
          expect: int32,
          desired: int32): bool =
    if a == nil:
        atomicPanicRaw("std_atomic_i32_cas_nil")
        return false
    return atomicCasI32(&a.value, expect, desired) != 0

@borrows
fn FetchAddI32(a: I32, delta: int32): int32 =
    if a == nil:
        atomicPanicRaw("std_atomic_i32_fetch_add_nil")
        return 0
    return atomicFetchAddI32Raw(&a.value, delta)

@borrows
fn AddI32(a: I32, delta: int32): int32 =
    return FetchAddI32(a, delta) + delta
