# std/path — File path manipulation (Node.js path module equivalent)
# Covers the 5 core APIs used by Claude Code: basename, dirname, join, resolve, extname
import std/strings
import std/strutils
import std/os
import std/seqs

const
    pathSep: char = '/'
    pathSepStr: str = "/"

# Exclusive-range slice: [start, stop). Guarded per SliceBytes predicate rules
# (start>=0, count>=0, start+count<=len) before handing off to strings.SliceBytes.
@borrows
fn sliceRange(s: str, start: int32, stop: int32): str =
    let n: int32 = strings.Len(s)
    var a: int32 = start
    var b: int32 = stop
    if a < 0:
        a = 0
    if b > n:
        b = n
    if b < a:
        return ""
    return strings.SliceBytes(s, a, b - a)

# --- basename(path, ext?) ---
# Returns the last portion of a path. If ext is provided, strips that extension.
fn basename(path: str, ext: str): str =
    let n: int32 = strings.Len(path)
    if n <= 0:
        return ""

    # Strip trailing separators
    var end: int32 = n - 1
    while end >= 0 && path[end] == pathSep:
        end = end - 1
    if end < 0:
        return "/"

    # Find last separator
    var start: int32 = end
    while start >= 0 && path[start] != pathSep:
        start = start - 1
    start = start + 1

    let base: str = sliceRange(path, start, end + 1)

    # Strip extension if provided
    let extLen: int32 = strings.Len(ext)
    if extLen > 0 && strings.HasSuffix(base, ext):
        let baseLen: int32 = strings.Len(base)
        return sliceRange(base, 0, baseLen - extLen)

    return base

# basename without extension stripping
fn basename(path: str): str =
    return basename(path, "")

# --- dirname(path) ---
# Returns the directory name of a path.
fn dirname(path: str): str =
    let n: int32 = strings.Len(path)
    if n <= 0:
        return "."

    # Strip trailing separators (but not if path is just "/")
    var end: int32 = n - 1
    while end > 0 && path[end] == pathSep:
        end = end - 1

    # Find last separator
    var sep: int32 = end
    while sep >= 0 && path[sep] != pathSep:
        sep = sep - 1

    if sep < 0:
        return "."
    if sep == 0:
        return "/"

    # Strip trailing separators from dir part
    var dirEnd: int32 = sep - 1
    while dirEnd > 0 && path[dirEnd] == pathSep:
        dirEnd = dirEnd - 1

    return sliceRange(path, 0, dirEnd + 1)

# --- join(...parts) ---
# Joins path segments using the platform separator.
fn join(parts: str[]): str =
    let n: int32 = seqs.Len(parts)
    if n <= 0:
        return "."

    # Filter out empty parts, handle absolute paths
    var filtered: str[]
    var i: int32
    var isAbsolute: bool
    for i in 0..<n:
        let part: str = parts[i]
        let partLen: int32 = strings.Len(part)
        if partLen <= 0:
            continue
        if part[0] == pathSep:
            # Absolute path resets
            isAbsolute = true
            seqs.Clear(filtered)
        seqs.Add(filtered, part)

    let filteredLen: int32 = seqs.Len(filtered)
    if filteredLen <= 0:
        if isAbsolute:
            return "/"
        return "."

    let result: str = strutils.Join(filtered, pathSepStr)
    if isAbsolute && strings.Len(result) > 0 && result[0] != pathSep:
        return strings.ConcatStr("/", result)
    return result

# --- resolve(...parts) ---
# Resolves path segments to an absolute path.
fn resolve(parts: str[]): str =
    let n: int32 = seqs.Len(parts)
    if n <= 0:
        # Return cwd
        return os.getCurrentDir()

    # Build all parts array with cwd first
    var allParts: str[]
    seqs.Add(allParts, os.getCurrentDir())

    var i: int32
    for i in 0..<n:
        seqs.Add(allParts, parts[i])

    # Join and normalize
    let joined: str = join(allParts)
    return normalize(joined)

# --- extname(path) ---
# Returns the file extension including the dot.
fn extname(path: str): str =
    let base: str = basename(path, "")
    let n: int32 = strings.Len(base)
    if n <= 1:
        return ""

    # Find last dot (but not a leading dot)
    var i: int32 = n - 1
    while i > 0:
        if base[i] == '.':
            return sliceRange(base, i, n)
        i = i - 1
    return ""

# --- normalize(path) ---
# Normalizes a path by resolving . and .. segments.
fn normalize(path: str): str =
    let n: int32 = strings.Len(path)
    if n <= 0:
        return "."

    let isAbsolute: bool = path[0] == pathSep

    # Split into segments
    var segments: str[]
    var i: int32
    var segStart: int32
    for i in 0..<n:
        if path[i] == pathSep:
            if i > segStart:
                seqs.Add(segments, sliceRange(path, segStart, i))
            segStart = i + 1
    if segStart < n:
        seqs.Add(segments, sliceRange(path, segStart, n))

    # Process segments
    var result: str[]
    let segCount: int32 = seqs.Len(segments)
    for i in 0..<segCount:
        let seg: str = segments[i]
        if seg == "." || strings.Len(seg) <= 0:
            continue
        if seg == "..":
            let resLen: int32 = seqs.Len(result)
            if resLen > 0:
                # Remove last segment (pop)
                var newResult: str[]
                var j: int32
                for j in 0..<(resLen - 1):
                    seqs.Add(newResult, result[j])
                result = newResult
            elif !isAbsolute:
                seqs.Add(result, "..")
            continue
        seqs.Add(result, seg)

    let final: str = strutils.Join(result, pathSepStr)
    if isAbsolute:
        return strings.ConcatStr("/", final)
    if strings.Len(final) <= 0:
        return "."
    return final

# --- relative(from, to) ---
# Returns the relative path from one path to another.
fn relative(from: str, to: str): str =
    let absFrom: str = resolve([from])
    let absTo: str = resolve([to])

    if absFrom == absTo:
        return ""

    # Split both into segments
    let fromParts: str[] = splitPath(absFrom)
    let toParts: str[] = splitPath(absTo)

    # Find common prefix
    var commonLen: int32
    let minLen: int32 = min_i32(seqs.Len(fromParts), seqs.Len(toParts))
    while commonLen < minLen && fromParts[commonLen] == toParts[commonLen]:
        commonLen = commonLen + 1

    # Build relative path
    var result: str[]
    var i: int32
    let fromLen: int32 = seqs.Len(fromParts)
    for i in commonLen..<fromLen:
        seqs.Add(result, "..")

    let toLen: int32 = seqs.Len(toParts)
    for i in commonLen..<toLen:
        seqs.Add(result, toParts[i])

    let relResult: str = strutils.Join(result, pathSepStr)
    if strings.Len(relResult) <= 0:
        return "."
    return relResult

# Helper: split path into segments
fn splitPath(path: str): str[] =
    var result: str[]
    let n: int32 = strings.Len(path)
    if n <= 0:
        return result

    var start: int32
    if path[0] == pathSep:
        start = 1  # Skip leading /
    var segStart: int32 = start
    var i: int32
    for i in start..<n:
        if path[i] == pathSep:
            if i > segStart:
                seqs.Add(result, sliceRange(path, segStart, i))
            segStart = i + 1
    if segStart < n:
        seqs.Add(result, sliceRange(path, segStart, n))
    return result

fn min_i32(a: int32, b: int32): int32 =
    if a < b:
        return a
    return b
