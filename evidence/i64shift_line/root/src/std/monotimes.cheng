# std/monotimes (minimal, pure Cheng)
# Cheng-side name deliberately differs from the importc symbol — see the SIGSYS note in
# std/times.cheng: the stage3 intrinsic inliner keys on the name cheng_monotime_ns and
# replaces call sites with a Darwin-only syscall sequence regardless of --target.
@importc("cheng_monotime_ns")
fn cheng_monotime_ns_call(): int64
type
    MonoTime =
        ns: int64
type
    Duration =
        ns: int64
fn getMonoTime(): MonoTime =
    var t: MonoTime
    t.ns = cheng_monotime_ns_call()
    return t
@borrows
fn monoTimeNs(t: MonoTime): int64 =
    return t.ns
fn `-`(a, b: MonoTime): Duration =
    var d: Duration
    d.ns = a.ns - b.ns
    return d
fn inMilliseconds(d: Duration): int64 =
    d.ns / 1000000

@borrows
fn GetMonoTime(): MonoTime =
    return getMonoTime()

@borrows
fn MonoTimeNs(t: MonoTime): int64 =
    return monoTimeNs(t)

@borrows
fn InMilliseconds(d: Duration): int64 =
    return inMilliseconds(d)
