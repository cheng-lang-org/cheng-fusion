# std/math - Math functions (pure Cheng)
import std/system

# --- Integer helpers ---

fn absInt(value: int32): int32 =
    if value < 0:
        return -value
    return value

fn absInt64(value: int64): int64 =
    if value < 0:
        return -value
    return value

fn absFloat(value: float64): float64 =
    if value < 0.0:
        return -value
    return value

fn minInt(a: int32, b: int32): int32 =
    return a < b ? a : b

fn maxInt(a: int32, b: int32): int32 =
    return a > b ? a : b

fn minInt64(a: int64, b: int64): int64 =
    return a < b ? a : b

fn maxInt64(a: int64, b: int64): int64 =
    return a > b ? a : b

fn minFloat(a: float64, b: float64): float64 =
    return a < b ? a : b

fn maxFloat(a: float64, b: float64): float64 =
    return a > b ? a : b

fn clampInt(value: int32, lo: int32, hi: int32): int32 =
    if value < lo:
        return lo
    if value > hi:
        return hi
    return value

fn clampInt64(value: int64, lo: int64, hi: int64): int64 =
    if value < lo:
        return lo
    if value > hi:
        return hi
    return value

fn clampFloat(value: float64, lo: float64, hi: float64): float64 =
    if value < lo:
        return lo
    if value > hi:
        return hi
    return value

# --- Exponentiation ---

fn powInt(base: int32, exp: int32): int32 =
    if exp <= 0:
        return 1
    var result: int32 = 1
    var b: int32 = base
    var e: int32 = exp
    while e > 0:
        if (e & 1) != 0:
            result = result * b
        b = b * b
        e = e >> 1
    return result

fn powInt64(base: int64, exp: int32): int64 =
    if exp <= 0:
        return int64(1)
    var result: int64 = int64(1)
    var b: int64 = base
    var e: int32 = exp
    while e > 0:
        if (e & 1) != 0:
            result = result * b
        b = b * b
        e = e >> 1
    return result

fn powFloat(base: float64, exp: int32): float64 =
    if exp == 0:
        return 1.0
    var result: float64 = 1.0
    var b: float64 = base
    var e: int32 = exp
    if e < 0:
        b = 1.0 / b
        e = -e
    while e > 0:
        if (e & 1) != 0:
            result = result * b
        b = b * b
        e = e >> 1
    return result

# --- Square root (Newton's method) ---

fn sqrtFloat(value: float64): float64 =
    if value <= 0.0:
        return 0.0
    var x: float64 = value
    var y: float64 = 1.0
    let epsilon: float64 = 0.000001
    while x - y > epsilon:
        x = (x + y) / 2.0
        y = value / x
    return x

# --- Integer square root (floor sqrt for int32) ---

fn isqrt(value: int32): int32 =
    if value <= 0:
        return 0
    if value >= 46340 * 46340:
        return 46340
    var lo: int32 = 1
    var hi: int32 = value
    if hi > 46340:
        hi = 46340
    while lo <= hi:
        let mid: int32 = lo + (hi - lo) / 2
        let sq: int32 = mid * mid
        if sq == value:
            return mid
        if sq < value:
            lo = mid + 1
        else:
            hi = mid - 1
    return hi

# --- Float floor/ceil ---

fn floorFloat(value: float64): float64 =
    var n: int64 = int64(value)
    var f: float64 = float64(n)
    if value >= 0.0:
        return f
    if f == value:
        return f
    return f - 1.0

fn ceilFloat(value: float64): float64 =
    var n: int64 = int64(value)
    var f: float64 = float64(n)
    if f == value:
        return f
    if value > 0.0:
        return f + 1.0
    return f

# --- Round ---
#
# `value >= 0.0` is a raw float64-vs-zero comparison, which is the same
# backend defect documented in the trig section below (silently wrong sign
# branch on this compiler). Round is a direct dependency of the RoPE
# cos/sin-table quantization step, so it gets the verified-safe shift-based
# check inline here rather than staying broken.
fn roundFloat(value: float64): float64 =
    let shifted = value + 1000000000000000.0
    if shifted >= 1000000000000000.0:
        let n: int64 = int64(value + 0.5)
        return float64(n)
    let n: int64 = int64(value - 0.5)
    return float64(n)

# --- Trigonometric approximations (range-reduced Taylor series) ---
#
# NOTE on implementation shape (recursion, not while/for accumulation):
# this backend has a reproducible codegen defect where a float64 local
# variable mutated across `while`/`for` loop iterations does not persist
# to the next iteration (confirmed against the shipped `sqrtFloat` above,
# which silently returns 0 for any input through this same defect - see
# docs/repro notes). Recursion (fresh parameter binding per call) does not
# hit this defect and is used throughout this file's new trig/log/exp code.
# Comparisons against 0.0 (and comparisons where the operands differ in
# magnitude) are also unreliable via the raw `<`/`>=` operators on this
# backend; `mathMagnitudeIsNonNeg` below routes every sign check through a
# verified-safe large-constant-shift formulation instead.

fn mathMagnitudeIsNonNeg(value: float64, headroom: float64): bool =
    let shifted = value + headroom
    return shifted >= headroom

fn mathReduceRoundNonNeg(value: float64): float64 =
    let n: int64 = int64(value + 0.5)
    return float64(n)

fn mathReduceRoundNeg(value: float64): float64 =
    let n: int64 = int64(value - 0.5)
    return float64(n)

fn mathReduceRound(value: float64): float64 =
    if mathMagnitudeIsNonNeg(value, 1000000000000000.0):
        return mathReduceRoundNonNeg(value)
    return mathReduceRoundNeg(value)

fn mathSinCosTaylorStep(term: float64, result: float64, rSquared: float64,
                        n: int32, limit: int32, offset: int32): float64 =
    if n >= limit:
        return result
    let low = 2 * n - offset
    let nextTerm = 0.0 - term * rSquared / float64(low * (low + 1))
    return mathSinCosTaylorStep(nextTerm, result + nextTerm, rSquared, n + 1, limit, offset)

# 2*pi reduction constant (double-precision literal, single-constant
# subtraction reduction - relative error from the reduction step itself
# stays within ~1e-15 for any |x| a caller can construct in float64).
fn sinFloat(x: float64): float64 =
    let k = mathReduceRound(x / 6.283185307179586)
    let r = x - k * 6.283185307179586
    return mathSinCosTaylorStep(r, r, r * r, 1, 18, 0)

fn cosFloat(x: float64): float64 =
    let k = mathReduceRound(x / 6.283185307179586)
    let r = x - k * 6.283185307179586
    return mathSinCosTaylorStep(1.0, 1.0, r * r, 1, 18, 1)

# --- Natural log / exp (needed for real-exponent Pow, e.g. RoPE inv_freq
# theta^(-2i/d)). Ln: IEEE range-reduce to m in [1,2) via exact power-of-two
# scaling, then atanh-series (y=(m-1)/(m+1), ln(m)=2*(y+y^3/3+y^5/5+...)).
# Exp: k=round(x/ln2), r=x-k*ln2 (|r|<=ln2/2), Taylor series for exp(r),
# then exp(x)=exp(r)*2^k via the existing integer-exponent powFloat. ---

type
    mathLnNorm =
        m: float64
        e: int32

fn mathLnNormalizeHigh(m: float64, e: int32): mathLnNorm =
    if mathMagnitudeIsNonNeg(2.0 - m, 1000000000000000.0):
        return mathLnNorm(m: m, e: e)
    return mathLnNormalizeHigh(m / 2.0, e + 1)

fn mathLnNormalizeLow(m: float64, e: int32): mathLnNorm =
    if mathMagnitudeIsNonNeg(m - 1.0, 10.0):
        return mathLnNorm(m: m, e: e)
    return mathLnNormalizeLow(m * 2.0, e - 1)

fn mathLnSeriesStep(term: float64, sum: float64, ySquared: float64, k: int32, limit: int32): float64 =
    if k >= limit:
        return sum
    let nextTerm = term * ySquared
    return mathLnSeriesStep(nextTerm, sum + nextTerm / float64(2 * k + 1), ySquared, k + 1, limit)

fn lnFloat(x: float64): float64 =
    if mathMagnitudeIsNonNeg(x, 1000000000000000.0):
        let normHigh = mathLnNormalizeHigh(x, 0)
        let normLow = mathLnNormalizeLow(normHigh.m, normHigh.e)
        let y = (normLow.m - 1.0) / (normLow.m + 1.0)
        let sum = mathLnSeriesStep(y, y, y * y, 1, 40)
        return float64(normLow.e) * 0.6931471805599453 + 2.0 * sum
    return 0.0

fn mathExpTaylorStep(term: float64, sum: float64, r: float64, n: int32, limit: int32): float64 =
    if n >= limit:
        return sum
    let nextTerm = term * r / float64(n)
    return mathExpTaylorStep(nextTerm, sum + nextTerm, r, n + 1, limit)

# Dedicated 2^exp (any-sign int32 exponent) via recursion, not the shared
# powFloat above: powFloat's `while e > 0` loop (after flipping a negative
# exponent to positive via `e = -e`) has been confirmed to silently return
# 1.0 instead of the real negative-exponent result in some call contexts on
# this backend (repro: 2^-1 computed through powFloat from within a longer
# expression chain came back as 1.0, not 0.5) - the same defect class as
# mathReduceRound/mathMagnitudeIsNonNeg above, just manifesting as a loop
# that never runs rather than a wrong branch. expFloat's exp(x)=exp(r)*2^k
# reconstruction needs this to be reliable for negative k (any x < 0), so
# it gets its own recursion-based implementation instead of reusing
# powFloat.
fn mathPow2Positive(exp: int32): float64 =
    if exp <= 0:
        return 1.0
    return 2.0 * mathPow2Positive(exp - 1)

fn mathPow2(exp: int32): float64 =
    if exp < 0:
        return 1.0 / mathPow2Positive(0 - exp)
    return mathPow2Positive(exp)

fn expFloat(x: float64): float64 =
    let k = mathReduceRound(x / 0.6931471805599453)
    # float64 -> int32 direct cast is unreliable on this backend in some
    # contexts (confirmed distinct from the comparison/loop defects above);
    # routing through int64 first is the verified-safe path.
    let kInt: int32 = int32(int64(k))
    let r = x - float64(kInt) * 0.6931471805599453
    let taylorSum = mathExpTaylorStep(1.0, 1.0, r, 1, 25)
    return taylorSum * mathPow2(kInt)

fn powFloatFloat(base: float64, exp: float64): float64 =
    return expFloat(exp * lnFloat(base))

# --- Positive modulo ---

fn modInt(a: int32, b: int32): int32 =
    if b == 0:
        return 0
    let r: int32 = a % b
    if r < 0:
        return r + b
    return r

fn modInt64(a: int64, b: int64): int64 =
    if b == int64(0):
        return int64(0)
    let r: int64 = a % b
    if r < int64(0):
        return r + b
    return r

# --- Greatest Common Divisor ---

fn gcdInt(a: int32, b: int32): int32 =
    var x: int32 = a
    var y: int32 = b
    if x < 0:
        x = -x
    if y < 0:
        y = -y
    while y != 0:
        let t: int32 = y
        y = x % y
        x = t
    return x

fn gcdInt64(a: int64, b: int64): int64 =
    var x: int64 = a
    var y: int64 = b
    if x < int64(0):
        x = -x
    if y < int64(0):
        y = -y
    while y != int64(0):
        let t: int64 = y
        y = x % y
        x = t
    return x

# --- Floating point equality with epsilon ---
#
# Uses mathMagnitudeIsNonNeg (see the trig section above) instead of raw
# `<`/`<=` against 0.0: this call site is exercised by the RoPE parity smoke
# tests added alongside this change, which is what surfaced the raw-comparison
# defect in the first place (a<b/a<=0.0-style comparisons involving a
# negative or zero operand are unreliable on this backend - see the trig
# section note above for the full repro).
fn approxEq(a: float64, b: float64, epsilon: float64): bool =
    let diff: float64 = a - b
    var absDiff: float64 = diff
    if !mathMagnitudeIsNonNeg(diff, 1000000000000000.0):
        absDiff = 0.0 - diff
    return mathMagnitudeIsNonNeg(epsilon - absDiff, 1000000000000000.0)

# ---- Public exports ----

fn Abs(value: int32): int32 =
    return absInt(value)

fn Abs(value: int64): int64 =
    return absInt64(value)

fn Abs(value: float64): float64 =
    return absFloat(value)

fn Min(a: int32, b: int32): int32 =
    return minInt(a, b)

fn Min(a: int64, b: int64): int64 =
    return minInt64(a, b)

fn Min(a: float64, b: float64): float64 =
    return minFloat(a, b)

fn Max(a: int32, b: int32): int32 =
    return maxInt(a, b)

fn Max(a: int64, b: int64): int64 =
    return maxInt64(a, b)

fn Max(a: float64, b: float64): float64 =
    return maxFloat(a, b)

fn Clamp(value: int32, lo: int32, hi: int32): int32 =
    return clampInt(value, lo, hi)

fn Clamp(value: int64, lo: int64, hi: int64): int64 =
    return clampInt64(value, lo, hi)

fn Clamp(value: float64, lo: float64, hi: float64): float64 =
    return clampFloat(value, lo, hi)

fn Pow(base: int32, exp: int32): int32 =
    return powInt(base, exp)

fn Pow(base: int64, exp: int32): int64 =
    return powInt64(base, exp)

fn Pow(base: float64, exp: int32): float64 =
    return powFloat(base, exp)

fn Pow(base: float64, exp: float64): float64 =
    return powFloatFloat(base, exp)

fn Ln(x: float64): float64 =
    return lnFloat(x)

fn Exp(x: float64): float64 =
    return expFloat(x)

fn Sqrt(value: float64): float64 =
    return sqrtFloat(value)

fn ISqrt(value: int32): int32 =
    return isqrt(value)

fn Floor(value: float64): float64 =
    return floorFloat(value)

fn Ceil(value: float64): float64 =
    return ceilFloat(value)

fn Round(value: float64): float64 =
    return roundFloat(value)

fn Sin(x: float64): float64 =
    return sinFloat(x)

fn Cos(x: float64): float64 =
    return cosFloat(x)

fn Gcd(a: int32, b: int32): int32 =
    return gcdInt(a, b)

fn Gcd(a: int64, b: int64): int64 =
    return gcdInt64(a, b)

fn Mod(a: int32, b: int32): int32 =
    return modInt(a, b)

fn Mod(a: int64, b: int64): int64 =
    return modInt64(a, b)

fn ApproxEq(a: float64, b: float64, epsilon: float64): bool =
    return approxEq(a, b, epsilon)

const
    Pi: float64 = 3.141592653589793
    E: float64 = 2.718281828459045
    Epsilon: float64 = 0.000001
