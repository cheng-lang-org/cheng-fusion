# std/times (minimal, pure Cheng)
import std/strings
importc fn cheng_epoch_time(): float64
importc fn cheng_epoch_time_seconds(): int64
importc fn cheng_epoch_time_ms(): int64
# Deliberately bound via explicit @importc alias, NOT a bare `importc fn cheng_monotime_ns`
# declaration: the stage3 driver intrinsic-inlines call sites of the bare declaration with a
# Darwin gettimeofday sequence (svc 0x80) regardless of --target. On aarch64-linux objects the
# Linux kernel ignores the svc immediate and reads x8 (a stale sret pointer) as the syscall
# number: Android seccomp kills the app with SIGSYS (reproduced on-device 2026-07-11, GBJ0222
# B24021692), OHOS returns garbage time. The alias form compiles to a plain call and the
# symbol is provided by the platform runtime provider at link time (already in every ROOTS
# whitelist). Same root cause exists in cheng_cold.c BODY_OP_TIME_NS (a64 leg) — fixed there
# too, but stage3 predates rebuildable sources, so this source-side form is the active guard.
@importc("cheng_monotime_ns")
fn cheng_monotime_ns_call(): int64
type
    DateTime =
        unix: int64
        nanosecond: int32

fn epochTime(): float64 =
    let secs: float64 = cheng_epoch_time()
    return secs

fn epochTimeSeconds(): int64 =
    let secs: int64 = cheng_epoch_time_seconds()
    return secs

fn epochTimeNs(): int64 =
    let secs: int64 = epochTimeSeconds()
    return secs * 1000000000

fn epochTimeMs(): int64 =
    return cheng_epoch_time_ms()

fn monotimeNs(): int64 =
    return cheng_monotime_ns_call()

fn monotimeMs(): int64 =
    return cheng_monotime_ns_call() / 1000000

fn getTime(): DateTime =
    let secs: int64 = epochTimeSeconds()
    return DateTime(unix: secs, nanosecond: 0)
fn now(): DateTime =
    getTime()
fn toUnix(t: DateTime): int64 =
    t.unix
fn format(t: DateTime, pattern: str): str =
    let _patternLen: int32 = pattern.len
    let unixSecs: int32 = int32(t.unix)
    let out: str = strings.IntToStr(unixSecs)
    return out

fn EpochTime(): float64 =
    return epochTime()

fn EpochTimeSeconds(): int64 =
    return epochTimeSeconds()

fn EpochTimeNs(): int64 =
    return epochTimeNs()

fn EpochTimeMs(): int64 =
    return epochTimeMs()

fn MonotimeNs(): int64 =
    return monotimeNs()

fn MonotimeMs(): int64 =
    return monotimeMs()

fn GetTime(): DateTime =
    return getTime()

fn Now(): DateTime =
    return now()

fn ToUnix(t: DateTime): int64 =
    return toUnix(t)

fn Format(t: DateTime, pattern: str): str =
    return format(t, pattern)
