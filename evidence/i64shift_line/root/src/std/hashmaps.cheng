# T67 撞名消歧(同 8d6f5d486 手法): 两个 HashMapStrIntGetOrInsertEx 大写重载
# 共用同一名字, PrimaryObjectPlanCallCandidateMatchesArgTypes 剥 var 后
# concreteMatchCount=2 → same_source_ambiguous → missing_call_target(A-gate census)。
# ptr 形分支改名 HashMapStrIntGetOrInsertExPtr(与其调用的 lowercase 实现同名同构,
# 复刻文件内其余 Xxx/xxx 大小写配对惯例); var-bool 形分支保留 HashMapStrIntGetOrInsertEx
# (与 HashMapStrIntGetEx/HashMapStrIntGetMutEx 等惯用 out-param 形态一致)。零调用点
# (两名此前均无任何调用方), 纯改名消碰撞, 零行为变化。
fn HashMapStrIntGetOrInsertExPtr(m: var HashMapStrInt, key: str, newVal: int32, foundPtr: ptr = nil): int32 =
    return hashMapStrIntGetOrInsertExPtr(m, key, newVal, foundPtr)

fn HashMapStrIntGetOrInsertEx(m: var HashMapStrInt, key: str, newVal: int32, found: var bool): int32 =
    return hashMapStrIntGetOrInsertExPtr(m, key, newVal, &found)

