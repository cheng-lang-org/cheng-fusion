module hashmaps
import std/seqs
import std/strings
import std/system

const
    # arm64 Cheng ABI contract used by retained-memory accounting.
    # seq = {len:i32, cap:i32, buffer:ptr}; str remains a 24-byte value.
    ChengA64SequenceHeaderBytes: int64 = 16
    ChengA64StringSlotBytes: int64 = 24
    HashMapStrIntSequenceFieldCount: int64 = 4
    # mask/used plus alignment = 16 bytes. Each cache lane is 32 bytes:
    # ptr(8), len+padding(8), pack(8), slot+value(8).
    HashMapStrIntInlineFieldBytes: int64 = 80

type
    HashMapStrInt =
        keys: str[]
        vals: int32[]
        hashes: uint64[]
        # ABI-stable owned storage: [bucket states K][occupied slots K*4].
        # The packed occupied-slot tail makes clear/grow O(used) without a
        # fifth owned sequence that would invalidate existing four-column
        # capacity ledgers.
        states: uint8[] # bucket byte: 0=empty, 1=used
        mask: uint64
        used: int32
        cacheKeyPtr0: ptr
        cacheKeyLen0: int32
        cachePack0: uint64
        cacheSlot0: int32
        cacheVal0: int32
        cacheKeyPtr1: ptr
        cacheKeyLen1: int32
        cachePack1: uint64
        cacheSlot1: int32
        cacheVal1: int32

    HashMapStrIntClearProbe =
        # Increment at the actual tail decode and bucket-state load sites.
        # Neither count is conditional on the bucket being occupied.
        occupiedTailReadCount: int64
        bucketReadCount: int64
        occupiedSlotVisitCount: int64

    HashMapStrIntGrowProbe =
        # Source traversal proof. Destination collision probes are separate
        # from the question this receipt answers: did grow scan old capacity?
        occupiedTailReadCount: int64
        sourceBucketReadCount: int64
        rehashedEntryCount: int64
        sourceCapacity: int32
        destinationCapacity: int32
        sourceUsed: int32

    HashMapStrIntRetainedByteReport =
        sequenceHeaderBytes: int64
        inlineFieldBytes: int64
        keySlotBytes: int64
        valueSlotBytes: int64
        hashSlotBytes: int64
        stateAndOccupiedSlotBytes: int64
        totalBytes: int64

    HashMapStrSeqInt =
        keys: str[]
        valStart: int32[]
        valLen: int32[]
        valCap: int32[]
        states: uint8[] # 0=empty, 1=used
        pool: int32[]
        mask: uint64
        used: int32

    HashMapPtrInt =
        keys: int64[]
        vals: int32[]
        states: uint8[] # 0=empty, 1=used
        mask: uint64
        used: int32

    # Concrete seq aliases keep old-builder object returns stable.
    hashMap_seq_int32 = int32[]
    hashMap_seq_int64 = int64[]
    hashMap_seq_str = str[]
    hashMap_seq_uint8 = uint8[]

fn hashMapReturnSeqInt32(out: int32[]): int32[] =
    return out

fn hashMapReturnSeqInt64(out: int64[]): int64[] =
    return out

fn hashMapReturnSeqStr(out: str[]): str[] =
    return out

fn hashMapReturnSeqUint8(out: uint8[]): uint8[] =
    return out

fn hashMapAppendInt32(seqInst: var int32[], value: int32) =
    let idx: int32 = seqInst.len
    let needLen: int32 = idx + 1
    if seqInst.buffer == nil || seqInst.cap < needLen:
        reserve(seqInst, needLen)
    setLen(seqInst, needLen)
    seqInst[idx] = value

@borrows
fn hashMapAppendStr(seqInst: var str[], value: str) =
    let idx: int32 = seqInst.len
    let needLen: int32 = idx + 1
    if seqInst.buffer == nil || seqInst.cap < needLen:
        reserve(seqInst, needLen)
    setLen(seqInst, needLen)
    seqInst[idx] = strings.CloneStr(value)

fn hashMapNextPow2(n0: int32, minCap: int32 = 8): int32 =
    var n: int32 = n0
    if n < minCap:
        n = minCap
    var cap: int32 = 1
    while cap < n:
        cap = cap * 2
    return cap

fn hashMapStrIntStateStorageLen(bucketCapacity: int32): int32 =
    if bucketCapacity <= 0:
        return 0
    if bucketCapacity > 429496729:
        panic("hashmaps: str-int state storage overflow")
    return bucketCapacity * 5

fn hashMapStrIntOccupiedSlotByteOffset(bucketCapacity: int32,
                                       occupiedIndex: int32): int32 =
    if bucketCapacity <= 0 || occupiedIndex < 0 || occupiedIndex >= bucketCapacity:
        panic("hashmaps: str-int occupied slot index out of bounds")
    return bucketCapacity + occupiedIndex * 4

fn hashMapStrIntWriteOccupiedSlot(states: var uint8[],
                                  bucketCapacity: int32,
                                  occupiedIndex: int32,
                                  slot: int32) =
    if slot < 0 || slot >= bucketCapacity:
        panic("hashmaps: str-int occupied slot out of bounds")
    let offset = hashMapStrIntOccupiedSlotByteOffset(bucketCapacity,
                                                      occupiedIndex)
    if offset < 0 || offset + 3 >= states.len:
        panic("hashmaps: str-int occupied slot storage mismatch")
    let value = uint32(slot)
    states[offset] = uint8(value & uint32(255))
    states[offset + 1] = uint8((value >> uint32(8)) & uint32(255))
    states[offset + 2] = uint8((value >> uint32(16)) & uint32(255))
    states[offset + 3] = uint8((value >> uint32(24)) & uint32(255))

@borrows
fn hashMapStrIntReadOccupiedSlot(states: uint8[],
                                 bucketCapacity: int32,
                                 occupiedIndex: int32): int32 =
    let offset = hashMapStrIntOccupiedSlotByteOffset(bucketCapacity,
                                                      occupiedIndex)
    if offset < 0 || offset + 3 >= states.len:
        panic("hashmaps: str-int occupied slot storage mismatch")
    let value = uint32(states[offset]) |
                (uint32(states[offset + 1]) << uint32(8)) |
                (uint32(states[offset + 2]) << uint32(16)) |
                (uint32(states[offset + 3]) << uint32(24))
    if value >= uint32(bucketCapacity):
        panic("hashmaps: str-int occupied slot corrupt")
    return int32(value)

fn hashMapStrIntClearOccupiedSlotBytes(states: var uint8[],
                                       bucketCapacity: int32,
                                       occupiedIndex: int32) =
    let offset = hashMapStrIntOccupiedSlotByteOffset(bucketCapacity,
                                                      occupiedIndex)
    if offset < 0 || offset + 3 >= states.len:
        panic("hashmaps: str-int occupied slot storage mismatch")
    states[offset] = uint8(0)
    states[offset + 1] = uint8(0)
    states[offset + 2] = uint8(0)
    states[offset + 3] = uint8(0)

fn hashMapStrIntRecordOccupiedSlot(m: var HashMapStrInt, slot: int32) =
    let bucketCapacity = m.keys.len
    if m.used < 0 || m.used >= bucketCapacity:
        panic("hashmaps: str-int occupied slot count overflow")
    if slot < 0 || slot >= bucketCapacity || m.states[slot] != uint8(0):
        panic("hashmaps: str-int occupied slot must be empty")
    hashMapStrIntWriteOccupiedSlot(m.states, bucketCapacity, m.used, slot)

fn hashMapAllocZeroSeq[T](cap0: int32): T[] =
    if cap0 <= 0:
        return []
    if cap0 > int32(2147483647):
        panic("hashmaps: allocation overflow")
    var out: T[]
    setLen(out, cap0)
    return out

# Stage1/self-link fallback symbols for concrete seq alloc helpers.
fn hashMapAllocZeroSeq_int32(cap0: int32): int32[] =
    var out: int32[]
    if cap0 > 0:
        let bytes64: int64 = int64(cap0) * int64(4)
        if bytes64 <= 0 || bytes64 > int64(2147483647):
            panic("hashmaps: allocation overflow")
        setLen(out, cap0)
    return out

fn hashMapAllocZeroSeq_int64(cap0: int32): int64[] =
    var out: int64[]
    if cap0 > 0:
        let bytes64: int64 = int64(cap0) * int64(8)
        if bytes64 <= 0 || bytes64 > int64(2147483647):
            panic("hashmaps: allocation overflow")
        setLen(out, cap0)
    return out

fn hashMapAllocZeroSeq_uint64(cap0: int32): uint64[] =
    var out: uint64[]
    if cap0 > 0:
        let bytes64: int64 = int64(cap0) * int64(8)
        if bytes64 <= 0 || bytes64 > int64(2147483647):
            panic("hashmaps: allocation overflow")
        setLen(out, cap0)
    return out

fn hashMapAllocZeroSeq_str(cap0: int32): str[] =
    var out: str[]
    if cap0 > 0:
        let bytes64: int64 = int64(cap0) * int64(24)
        if bytes64 <= 0 || bytes64 > int64(2147483647):
            panic("hashmaps: allocation overflow")
        setLen(out, cap0)
    return out

fn hashMapAllocZeroSeq_uint8(cap0: int32): uint8[] =
    var out: uint8[]
    if cap0 > 0:
        let bytes64: int64 = int64(cap0)
        if bytes64 <= 0 || bytes64 > int64(2147483647):
            panic("hashmaps: allocation overflow")
        setLen(out, cap0)
    return out

fn hashMapHash64StrMetaRaw(dataPtr0: ptr, n: int32): uint64 =
    var h: uint64 = (uint64(1469598103) * uint64(1000000000)) + uint64(934665603)
    if n <= 0:
        return h
    if dataPtr0 == nil:
        return h
    for i in 0..<n:
        let ch: uint64 = uint64(load[uint8](system_ptr_add(dataPtr0, i))) & uint64(0xFF)
        h = h ^ ch
        h = h * ((uint64(1099511628) * uint64(1000)) + uint64(211))
    return h

fn hashMapStrPack8(dataPtr0: ptr, n: int32): uint64 =
    if n <= 0 || dataPtr0 == nil:
        return uint64(0)
    var out: uint64
    for i in 0..<n:
        let ch: uint64 = uint64(load[uint8](system_ptr_add(dataPtr0, i))) & uint64(0xFF)
        out = out | (ch << uint64(i * 8))
    return out

fn hashMapHash64StrMeta(s: str): uint64 =
    return hashMapHash64StrMetaRaw(StrDataPtr(s), StrLenFast(s))

fn hashMapHash64Str(s: str): uint64 =
    return hashMapHash64StrMeta(s)

fn hashMapHash64Ptr(p: int64): uint64 =
    if p == 0:
        return 0
    var h: uint64 = uint64(p)
    h = h ^ (h >> 33)
    h = h ^ (h >> 17)
    h = h ^ (h >> 9)
    return h

@borrows
fn hashMapStrEq(cur: str, key: str): bool =
    return hashMapStrEqMeta(cur, key.len, key.data)

@borrows
fn hashMapStrEqMeta(cur: str, keyLen: int32, keyPtr: ptr): bool =
    if keyLen <= 0:
        return false
    let nCur: int32 = cur.len
    if nCur != keyLen:
        return false
    let curPtr: ptr = cur.data
    if curPtr == keyPtr:
        return true
    if curPtr == nil || keyPtr == nil:
        return false
    return cmpMem(curPtr, keyPtr, int64(keyLen)) == 0

fn hashMapStrIntResetCache(m: var HashMapStrInt) =
    m.cacheKeyPtr0 = nil
    m.cacheKeyLen0 = 0
    m.cachePack0 = uint64(0)
    m.cacheSlot0 = -1
    m.cacheVal0 = 0
    m.cacheKeyPtr1 = nil
    m.cacheKeyLen1 = 0
    m.cachePack1 = uint64(0)
    m.cacheSlot1 = -1
    m.cacheVal1 = 0

@borrows
fn hashMapStrIntCachedSlot(m: HashMapStrInt, keyLen: int32, keyPtr: ptr): int32 =
    if keyLen <= 0 || keyPtr == nil:
        return -1
    let slotPtr0: int32 = m.cacheSlot0
    if slotPtr0 >= 0 && slotPtr0 < m.keys.len:
        if m.cacheKeyPtr0 == keyPtr && m.cacheKeyLen0 == keyLen && m.states[slotPtr0] == uint8(1):
            return slotPtr0
    let slotPtr1: int32 = m.cacheSlot1
    if slotPtr1 >= 0 && slotPtr1 < m.keys.len:
        if m.cacheKeyPtr1 == keyPtr && m.cacheKeyLen1 == keyLen && m.states[slotPtr1] == uint8(1):
            return slotPtr1
    if keyLen <= 8:
        let keyPack: uint64 = hashMapStrPack8(keyPtr, keyLen)
        let slotSmall0: int32 = m.cacheSlot0
        if slotSmall0 >= 0 && slotSmall0 < m.keys.len:
            if m.cacheKeyLen0 == keyLen && m.cachePack0 == keyPack && m.states[slotSmall0] == uint8(1):
                return slotSmall0
        let slotSmall1: int32 = m.cacheSlot1
        if slotSmall1 >= 0 && slotSmall1 < m.keys.len:
            if m.cacheKeyLen1 == keyLen && m.cachePack1 == keyPack && m.states[slotSmall1] == uint8(1):
                return slotSmall1
        return -1
    let slot0: int32 = m.cacheSlot0
    if slot0 >= 0 && slot0 < m.keys.len:
        if m.cacheKeyPtr0 == keyPtr && m.cacheKeyLen0 == keyLen && m.states[slot0] == uint8(1):
            if StrLenFast(m.keys[slot0]) == keyLen && StrDataPtr(m.keys[slot0]) == keyPtr:
                return slot0
    let slot1: int32 = m.cacheSlot1
    if slot1 >= 0 && slot1 < m.keys.len:
            if m.cacheKeyPtr1 == keyPtr && m.cacheKeyLen1 == keyLen && m.states[slot1] == uint8(1):
                if StrLenFast(m.keys[slot1]) == keyLen && StrDataPtr(m.keys[slot1]) == keyPtr:
                    return slot1
    return -1

fn hashMapStrIntRememberSlot(m: var HashMapStrInt, keyLen: int32, keyPtr: ptr, slot: int32) =
    if keyLen <= 0 || keyPtr == nil || slot < 0:
        return
    if slot >= m.keys.len || m.states[slot] != uint8(1):
        return
    if m.keys[slot].len != keyLen:
        return
    let storedPtr: ptr = m.keys[slot].data
    if storedPtr == nil:
        return
    let storedPack: uint64 = (keyLen <= 8) ? hashMapStrPack8(storedPtr, keyLen) : uint64(0)
    if m.cacheSlot0 == slot:
        m.cacheKeyPtr0 = nil
        m.cacheKeyLen0 = 0
        m.cachePack0 = uint64(0)
        m.cacheSlot0 = -1
        m.cacheVal0 = 0
    if m.cacheSlot1 == slot:
        m.cacheKeyPtr1 = nil
        m.cacheKeyLen1 = 0
        m.cachePack1 = uint64(0)
        m.cacheSlot1 = -1
        m.cacheVal1 = 0
    let storedVal: int32 = m.vals[slot]
    if keyLen <= 8:
        if m.cacheKeyLen0 == keyLen && m.cachePack0 == storedPack:
            m.cacheKeyPtr0 = storedPtr
            m.cacheSlot0 = slot
            m.cacheVal0 = storedVal
            return
        if m.cacheKeyLen1 == keyLen && m.cachePack1 == storedPack:
            m.cacheKeyPtr1 = storedPtr
            m.cacheSlot1 = slot
            m.cacheVal1 = storedVal
            return
    else:
        if m.cacheKeyPtr0 == storedPtr && m.cacheKeyLen0 == keyLen:
            m.cacheSlot0 = slot
            m.cacheVal0 = storedVal
            return
        if m.cacheKeyPtr1 == storedPtr && m.cacheKeyLen1 == keyLen:
            m.cacheSlot1 = slot
            m.cacheVal1 = storedVal
            return
    m.cacheKeyPtr1 = m.cacheKeyPtr0
    m.cacheKeyLen1 = m.cacheKeyLen0
    m.cachePack1 = m.cachePack0
    m.cacheSlot1 = m.cacheSlot0
    m.cacheVal1 = m.cacheVal0
    m.cacheKeyPtr0 = storedPtr
    m.cacheKeyLen0 = keyLen
    m.cachePack0 = storedPack
    m.cacheSlot0 = slot
    m.cacheVal0 = storedVal

fn hashMapStrIntInit(cap0: int32 = 16): HashMapStrInt =
    var m: HashMapStrInt
    hashMapStrIntInitInPlace(m, cap0)
    return m

fn hashMapStrIntInitInPlace(m: var HashMapStrInt, cap0: int32 = 16) =
    let cap: int32 = hashMapNextPow2(cap0, 8)
    let keys: str[] = hashMapAllocZeroSeq_str(cap)
    let vals: int32[] = hashMapAllocZeroSeq_int32(cap)
    let hashes: uint64[] = hashMapAllocZeroSeq_uint64(cap)
    let states: uint8[] = hashMapAllocZeroSeq_uint8(
        hashMapStrIntStateStorageLen(cap))
    for i in 0..<cap:
        keys[i] = ""
        vals[i] = 0
        hashes[i] = uint64(0)
        states[i] = uint8(0)
    for stateIndex in cap..<states.len:
        states[stateIndex] = uint8(0)
    m.keys = keys
    m.vals = vals
    m.hashes = hashes
    m.states = states
    m.mask = uint64(cap - 1)
    m.used = 0
    hashMapStrIntResetCache(m)

fn hashMapStrIntClearWithProbe(m: var HashMapStrInt,
                               probe: var HashMapStrIntClearProbe) =
    probe.occupiedTailReadCount = Int64(0)
    probe.bucketReadCount = Int64(0)
    probe.occupiedSlotVisitCount = Int64(0)
    hashMapStrIntResetCache(m)
    let bucketCapacity = m.keys.len
    if bucketCapacity <= 0:
        m.mask = 0
        m.used = 0
        return
    if m.vals.len != bucketCapacity || m.hashes.len != bucketCapacity ||
       m.states.len != hashMapStrIntStateStorageLen(bucketCapacity) ||
       m.mask != uint64(bucketCapacity - 1) ||
       m.used < 0 || m.used > bucketCapacity:
        panic("hashmaps: str-int clear storage invariant failed")
    let occupiedCount = m.used
    for occupiedIndex in 0..<occupiedCount:
        let slot = hashMapStrIntReadOccupiedSlot(m.states,
                                                 bucketCapacity,
                                                 occupiedIndex)
        probe.occupiedTailReadCount =
            probe.occupiedTailReadCount + Int64(1)
        let occupiedState = m.states[slot]
        probe.bucketReadCount = probe.bucketReadCount + Int64(1)
        if occupiedState != uint8(1):
            panic("hashmaps: str-int occupied slot state mismatch")
        m.keys[slot] = ""
        m.vals[slot] = 0
        m.hashes[slot] = uint64(0)
        m.states[slot] = uint8(0)
        hashMapStrIntClearOccupiedSlotBytes(m.states,
                                            bucketCapacity,
                                            occupiedIndex)
        probe.occupiedSlotVisitCount =
            probe.occupiedSlotVisitCount + Int64(1)
    m.used = 0

fn hashMapStrIntClear(m: var HashMapStrInt) =
    var probe: HashMapStrIntClearProbe
    hashMapStrIntClearWithProbe(m, probe)

@borrows
fn hashMapStrIntFindSlot(m: HashMapStrInt,
                         key: str,
                         allowInsert: bool): int32 =
    let keyLen: int32 = key.len
    if keyLen <= 0 || m.mask == 0:
        return -1
    let keyPtr: ptr = key.data
    if keyPtr == nil:
        return -1
    let keyHash: uint64 = hashMapHash64StrMetaRaw(keyPtr, keyLen)
    return hashMapStrIntFindSlotMeta(m, keyHash, keyLen, keyPtr, allowInsert)

@borrows
fn hashMapStrIntFindSlotMeta(m: HashMapStrInt,
                             keyHash: uint64,
                             keyLen: int32,
                             keyPtr: ptr,
                             allowInsert: bool): int32 =
    let mask: int32 = int32(m.mask)
    var probe: int32 = int32(keyHash & uint64(mask))
    var scanned: int32
    for scanned in scanned..mask:
        let st: uint8 = m.states[probe]
        if st == uint8(0):
            if allowInsert:
                return probe
            return -1
        if m.hashes[probe] == keyHash:
            if hashMapStrEqMeta(
                    m.keys[probe], keyLen, keyPtr):
                return probe
        probe = (probe + 1) & mask
    return -1

fn hashMapStrIntGrowWithProbe(m: var HashMapStrInt,
                              probe: var HashMapStrIntGrowProbe) =
    probe.occupiedTailReadCount = Int64(0)
    probe.sourceBucketReadCount = Int64(0)
    probe.rehashedEntryCount = Int64(0)
    probe.sourceCapacity = 0
    probe.destinationCapacity = 0
    probe.sourceUsed = 0
    let oldCap: int32 = m.keys.len
    let oldUsed: int32 = m.used
    if oldCap <= 0 || m.vals.len != oldCap || m.hashes.len != oldCap ||
       m.states.len != hashMapStrIntStateStorageLen(oldCap) ||
       oldUsed < 0 || oldUsed > oldCap:
        panic("hashmaps: str-int grow storage invariant failed")
    probe.sourceCapacity = oldCap
    probe.sourceUsed = oldUsed

    var newCap: int32 = oldCap * 2
    if newCap <= 0:
        newCap = 16
    let nextCap: int32 = hashMapNextPow2(newCap, 8)
    var nextMap: HashMapStrInt = hashMapStrIntInit(nextCap)

    for occupiedIndex in 0..<oldUsed:
        let oldSlot = hashMapStrIntReadOccupiedSlot(m.states,
                                                    oldCap,
                                                    occupiedIndex)
        probe.occupiedTailReadCount =
            probe.occupiedTailReadCount + Int64(1)
        let oldState = m.states[oldSlot]
        probe.sourceBucketReadCount =
            probe.sourceBucketReadCount + Int64(1)
        if oldState != uint8(1):
            panic("hashmaps: str-int grow occupied slot state mismatch")
        let val: int32 = m.vals[oldSlot]
        let keyHash: uint64 = m.hashes[oldSlot]
        let keyLen: int32 = m.keys[oldSlot].len
        let keyPtr: ptr = m.keys[oldSlot].data
        let slot: int32 = hashMapStrIntFindSlotMeta(nextMap,
                                                    keyHash,
                                                    keyLen,
                                                    keyPtr,
                                                    true)
        if slot < 0:
            panic("hashmaps: str-int grow insert failed")
        if nextMap.states[slot] != uint8(0):
            panic("hashmaps: str-int grow duplicate occupied slot")
        hashMapStrIntRecordOccupiedSlot(nextMap, slot)
        # Owned per-row copy: the whole superseded table (buffers and key
        # payloads) is released by the natural drop at the rebind below.
        nextMap.keys[slot] = strings.CloneStr(m.keys[oldSlot])
        nextMap.vals[slot] = val
        nextMap.hashes[slot] = keyHash
        nextMap.states[slot] = uint8(1)
        nextMap.used = nextMap.used + 1
        probe.rehashedEntryCount = probe.rehashedEntryCount + Int64(1)
    probe.destinationCapacity = nextMap.keys.len
    m = nextMap

fn hashMapStrIntGrow(m: var HashMapStrInt) =
    var probe: HashMapStrIntGrowProbe
    hashMapStrIntGrowWithProbe(m, probe)

fn hashMapStrIntPut(m: var HashMapStrInt, key: str, val: int32) =
    let keyLen: int32 = key.len
    if keyLen > 0:
        if m.mask == 0:
            hashMapStrIntInitInPlace(m, 16)
        let keyPtr: ptr = key.data
        if (m.used + 1) * 10 >= m.keys.len * 7:
            hashMapStrIntGrow(m)
        let keyHash: uint64 = hashMapHash64StrMetaRaw(keyPtr, keyLen)
        let slot: int32 = hashMapStrIntFindSlotMeta(m, keyHash, keyLen, keyPtr, true)
        if slot >= 0:
            if m.states[slot] == uint8(0):
                hashMapStrIntRecordOccupiedSlot(m, slot)
                m.used = m.used + 1
                m.states[slot] = uint8(1)
            m.keys[slot] = key
            m.vals[slot] = val
            m.hashes[slot] = keyHash
            hashMapStrIntRememberSlot(m, keyLen, keyPtr, slot)

# PERF-9/hashmap 撞名根修: 原两个同名 hashMapStrIntGetEx 重载(value/var)在自举
# 后端调用目标解析里(PrimaryObjectPlanCallCandidateMatchesArgTypes 逐字段比对前
# 先 TypedExprStripVarType 去掉 var 修饰)完全不可区分 -> concreteMatchCount=2 ->
# 判二义 -> missing_call_target。value 分支改名为 hashMapStrIntGetExValue(如实
# 反映"按值只读, 不缓存槽位"的语义); var 分支纯粹是 hashMapStrIntGetMutEx 的转发,
# 删除后调用点直呼 hashMapStrIntGetMutEx, 零行为变化。
@borrows
fn hashMapStrIntGetExValue(m: HashMapStrInt, key: str, found: var bool): int32 =
    let keyLen: int32 = key.len
    if keyLen <= 0 || m.mask == 0:
        found = false
        return 0
    let keyPtr: ptr = key.data
    let cachedSlot: int32 = hashMapStrIntCachedSlot(m, keyLen, keyPtr)
    if cachedSlot >= 0:
        found = true
        return m.vals[cachedSlot]
    let keyHash: uint64 = hashMapHash64StrMetaRaw(keyPtr, keyLen)
    let slot: int32 = hashMapStrIntFindSlotMeta(m, keyHash, keyLen, keyPtr, false)
    if slot < 0:
        found = false
        return 0
    found = true
    return m.vals[slot]

@borrows
fn hashMapStrIntGet(m: HashMapStrInt, key: str): int32 =
    var found: bool
    return hashMapStrIntGetExValue(m, key, found)

@borrows
fn hashMapStrIntGet(m: HashMapStrInt, key: str, found: var bool): int32 =
    let keyLen: int32 = key.len
    if keyLen <= 0 || m.mask == 0:
        found = false
        return 0
    let keyPtr: ptr = key.data
    let cachedSlot: int32 = hashMapStrIntCachedSlot(m, keyLen, keyPtr)
    if cachedSlot >= 0:
        found = true
        return m.vals[cachedSlot]
    let keyHash: uint64 = hashMapHash64StrMetaRaw(keyPtr, keyLen)
    let slot: int32 = hashMapStrIntFindSlotMeta(m, keyHash, keyLen, keyPtr, false)
    if slot < 0:
        found = false
        return 0
    found = true
    return m.vals[slot]

@borrows
fn hashMapStrIntGetMut(m: var HashMapStrInt, key: str): int32 =
    var found: bool
    return hashMapStrIntGetMutEx(m, key, found)

@borrows
fn hashMapStrIntGetMutEx(m: var HashMapStrInt, key: str, found: var bool): int32 =
    return hashMapStrIntGetMutExCore(m, key, found)

@borrows
fn hashMapStrIntGetMutExCore(m: var HashMapStrInt, key: str, found: var bool): int32 =
    let keyLen: int32 = key.len
    if keyLen <= 0 || m.mask == 0:
        found = false
        return 0
    let keyPtr: ptr = key.data
    if m.used > 0:
        if m.cacheKeyPtr0 == keyPtr:
            if m.cacheKeyLen0 == keyLen:
                found = true
                return m.cacheVal0
        if m.cacheKeyPtr1 == keyPtr:
            if m.cacheKeyLen1 == keyLen:
                found = true
                return m.cacheVal1
    let cachedSlot: int32 = hashMapStrIntCachedSlot(m, keyLen, keyPtr)
    if cachedSlot >= 0:
        found = true
        return m.vals[cachedSlot]
    let keyHash: uint64 = hashMapHash64StrMetaRaw(keyPtr, keyLen)
    let slot: int32 = hashMapStrIntFindSlotMeta(m, keyHash, keyLen, keyPtr, false)
    if slot < 0:
        found = false
        return 0
    found = true
    hashMapStrIntRememberSlot(m, keyLen, keyPtr, slot)
    return m.vals[slot]


@borrows
fn `[]`(m: HashMapStrInt, key: str): int32 =
    var found: bool
    return hashMapStrIntGetExValue(m, key, found)

fn `[]=`(m: var HashMapStrInt, key: str, val: int32) =
    hashMapStrIntPut(m, key, val)

fn hashMapStrIntGetOrInsertExPtr(m: var HashMapStrInt, key: str, newVal: int32, foundPtr: ptr = nil): int32 =
    let keyLen: int32 = key.len
    if keyLen <= 0:
        if foundPtr != nil:
            var found0: bool
            memCopyCompat(foundPtr, &found0, int32(sizeof(bool)))
        return newVal
    if m.mask == 0:
        hashMapStrIntInitInPlace(m, 16)
    let keyPtr: ptr = key.data
    let cachedSlot: int32 = hashMapStrIntCachedSlot(m, keyLen, keyPtr)
    if cachedSlot >= 0:
        if foundPtr != nil:
            var foundCached: bool = true
            memCopyCompat(foundPtr, &foundCached, int32(sizeof(bool)))
        return m.vals[cachedSlot]
    if (m.used + 1) * 10 >= m.keys.len * 7:
        hashMapStrIntGrow(m)
    let keyHash: uint64 = hashMapHash64StrMetaRaw(keyPtr, keyLen)
    let slot: int32 = hashMapStrIntFindSlotMeta(m, keyHash, keyLen, keyPtr, true)
    if slot < 0:
        if foundPtr != nil:
            var found1: bool
            memCopyCompat(foundPtr, &found1, int32(sizeof(bool)))
        return newVal
    let existed: bool = (m.states[slot] == uint8(1))
    if !existed:
        hashMapStrIntRecordOccupiedSlot(m, slot)
        m.used = m.used + 1
        m.states[slot] = uint8(1)
        m.keys[slot] = key
        m.hashes[slot] = keyHash
        m.vals[slot] = newVal
    hashMapStrIntRememberSlot(m, keyLen, keyPtr, slot)
    if foundPtr != nil:
        var found2: bool = existed
        memCopyCompat(foundPtr, &found2, int32(sizeof(bool)))
    return m.vals[slot]

# No dual free-name hashMapStrIntGetOrInsertEx(foundPtr|found) overloads:
# PrimaryObjectPlanCallCandidateMatchesArgTypes strips var before match →
# same_source_ambiguous → HashMapStrIntGetOrInsertEx missing_call_target (A-gate census).
# Sole path = hashMapStrIntGetOrInsertExPtr; capital wrappers call it directly.

fn hashMapStrIntGetOrInsert(m: var HashMapStrInt, key: str, newVal: int32): int32 =
    return hashMapStrIntGetOrInsertExPtr(m, key, newVal, nil)

fn hashMapStrIntGetOrInsert(m: var HashMapStrInt, key: str, newVal: int32, found: var bool): int32 =
    return hashMapStrIntGetOrInsertExPtr(m, key, newVal, &found)

fn hashMapStrIntCapacityForEntryLimit(entryLimit: int32): int32 =
    if entryLimit < 0:
        panic("hashmaps: str-int entry limit must be non-negative")
    var cap: int32 = 8
    let required = Int64(entryLimit)
    while required * Int64(10) >= Int64(cap) * Int64(7):
        if cap > 214748364:
            panic("hashmaps: str-int entry capacity overflow")
        cap = cap * 2
    return cap

fn hashMapStrIntStateCapacityForBucketCapacity(bucketCapacity: int32): int32 =
    if bucketCapacity <= 0 ||
       (bucketCapacity & (bucketCapacity - 1)) != 0:
        panic("hashmaps: str-int bucket capacity must be positive power of two")
    let storageLen = hashMapStrIntStateStorageLen(bucketCapacity)
    if storageLen > 1073741824:
        panic("hashmaps: str-int retained state capacity overflow")
    return hashMapNextPow2(storageLen, 8)

fn hashMapStrIntRetainedByteLimitForBucketCapacity(
        bucketCapacity: int32): int64 =
    if bucketCapacity <= 0:
        panic("hashmaps: str-int retained bucket capacity must be positive")
    let cap64 = Int64(bucketCapacity)
    let stateCapacity =
        hashMapStrIntStateCapacityForBucketCapacity(bucketCapacity)
    return HashMapStrIntSequenceFieldCount *
               ChengA64SequenceHeaderBytes +
           HashMapStrIntInlineFieldBytes +
           cap64 * ChengA64StringSlotBytes +
           cap64 * Int64(4) + cap64 * Int64(8) +
           Int64(stateCapacity)

@borrows
fn hashMapStrIntRetainedBytes(m: HashMapStrInt): HashMapStrIntRetainedByteReport =
    var out: HashMapStrIntRetainedByteReport
    out.sequenceHeaderBytes = HashMapStrIntSequenceFieldCount *
                              ChengA64SequenceHeaderBytes
    out.inlineFieldBytes = HashMapStrIntInlineFieldBytes
    out.keySlotBytes = Int64(m.keys.cap) * ChengA64StringSlotBytes
    out.valueSlotBytes = Int64(m.vals.cap) * Int64(4)
    out.hashSlotBytes = Int64(m.hashes.cap) * Int64(8)
    out.stateAndOccupiedSlotBytes = Int64(m.states.cap)
    out.totalBytes = out.sequenceHeaderBytes + out.inlineFieldBytes +
                     out.keySlotBytes +
                     out.valueSlotBytes + out.hashSlotBytes +
                     out.stateAndOccupiedSlotBytes
    return out

fn hashMapStrSeqIntInit(cap0: int32 = 16): HashMapStrSeqInt =
    let capHint: int32 = (cap0 < 64) ? 64 : cap0
    let cap: int32 = hashMapNextPow2(capHint, 8)
    let keys: str[] = hashMapAllocZeroSeq_str(cap)
    var valStart: int32[] = hashMapAllocZeroSeq_int32(cap)
    let valLen: int32[] = hashMapAllocZeroSeq_int32(cap)
    let valCap: int32[] = hashMapAllocZeroSeq_int32(cap)
    let states: uint8[] = hashMapAllocZeroSeq_uint8(cap)
    var pool: int32[]
    for i in 0..<cap:
        valStart[i] = -1
    return HashMapStrSeqInt(keys: keys,
                            valStart: valStart,
                            valLen: valLen,
                            valCap: valCap,
                            states: states,
                            pool: pool,
                            mask: uint64(cap - 1),
                            used: 0)

fn hashMapStrSeqIntClear(m: var HashMapStrSeqInt) =
    if m.keys.len <= 0:
        m.mask = 0
        m.used = 0
        m.pool.len = 0
    else:
        for i in 0..<m.keys.len:
            m.keys[i] = ""
            m.valStart[i] = -1
            m.valLen[i] = 0
            m.valCap[i] = 0
            m.states[i] = uint8(0)
        m.pool.len = 0
        m.used = 0

@borrows
fn hashMapStrSeqIntFindSlot(m: HashMapStrSeqInt, key: str, allowInsert: bool): int32 =
    let keyLen: int32 = key.len
    if keyLen <= 0 || m.mask == 0:
        return -1
    let keyPtr: ptr = key.data
    let mask: int32 = int32(m.mask)
    let states: uint8[] = m.states
    let keys: str[] = m.keys
    var probe: int32 = int32(hashMapHash64StrMetaRaw(keyPtr, keyLen) & uint64(mask))
    var scanned: int32
    for scanned in scanned..mask:
        let st: uint8 = states[probe]
        if st == uint8(0):
            if allowInsert:
                return probe
            return -1
        let cur: str = keys[probe]
        if hashMapStrEqMeta(cur, keyLen, keyPtr):
            return probe
        probe = (probe + 1) & mask
    return -1

@borrows
fn hashMapStrSeqIntFindSlotMut(m: var HashMapStrSeqInt, key: str, allowInsert: bool): int32 =
    let keyLen: int32 = key.len
    if keyLen <= 0 || m.mask == 0:
        return -1
    let keyPtr: ptr = key.data
    let mask: int32 = int32(m.mask)
    let states: uint8[] = m.states
    let keys: str[] = m.keys
    var probe: int32 = int32(hashMapHash64StrMetaRaw(keyPtr, keyLen) & uint64(mask))
    var scanned: int32
    for scanned in scanned..mask:
        let st: uint8 = states[probe]
        if st == uint8(0):
            if allowInsert:
                return probe
            return -1
        let cur: str = keys[probe]
        if hashMapStrEqMeta(cur, keyLen, keyPtr):
            return probe
        probe = (probe + 1) & mask
    return -1

fn hashMapStrSeqIntStoreSeqAt(m: var HashMapStrSeqInt, slot: int32, val: int32[]) =
    if slot >= 0 && slot < m.keys.len:
        if val.len <= 0:
            m.valStart[slot] = -1
            m.valLen[slot] = 0
            m.valCap[slot] = 0
        else:
            let oldStart: int32 = m.valStart[slot]
            let oldCap: int32 = m.valCap[slot]
            if oldStart >= 0 && oldCap >= val.len && oldStart + oldCap <= m.pool.len:
                m.valLen[slot] = val.len
                for i in 0..<val.len:
                    m.pool[oldStart + i] = val[i]
                return
            var newCap: int32 = hashMapStrSeqIntNextCap(val.len, oldCap)
            if oldStart >= 0 && oldCap > 0 && oldStart + oldCap == m.pool.len:
                let needLen: int32 = oldStart + newCap
                if m.pool.buffer == nil || m.pool.cap < needLen:
                    reserve(m.pool, needLen)
                setLen(m.pool, needLen)
                m.valStart[slot] = oldStart
                m.valLen[slot] = val.len
                m.valCap[slot] = newCap
                for i in 0..<val.len:
                    m.pool[oldStart + i] = val[i]
                return
            let start: int32 = hashMapStrSeqIntAllocTail(m, newCap)
            m.valStart[slot] = start
            m.valLen[slot] = val.len
            m.valCap[slot] = newCap
            for i in 0..<val.len:
                m.pool[start + i] = val[i]

@borrows
fn hashMapStrSeqIntBuildSeq(m: HashMapStrSeqInt, slot: int32): int32[] =
    var out: int32[]
    if slot < 0 || slot >= m.keys.len:
        return hashMapReturnSeqInt32(out)
    let start: int32 = m.valStart[slot]
    let n: int32 = m.valLen[slot]
    if start < 0:
        return hashMapReturnSeqInt32(out)
    if n <= 0:
        return hashMapReturnSeqInt32(out)
    if start + n > m.pool.len:
        return hashMapReturnSeqInt32(out)
    setLen(out, n)
    for i in 0..<n:
        out[i] = m.pool[start + i]
    return hashMapReturnSeqInt32(out)

@borrows
fn hashMapStrSeqIntGrowBuild(oldKeys: str[], oldValStart: int32[], oldValLen: int32[],
        oldValCap: int32[], oldStates: uint8[], oldPool: int32[], nextCap: int32): HashMapStrSeqInt =
    var nextMap: HashMapStrSeqInt = hashMapStrSeqIntInit(nextCap)
    let oldCap: int32 = oldKeys.len
    for i in 0..<oldCap:
        if oldStates[i] == uint8(1):
            let key: str = oldKeys[i]
            let slot: int32 = hashMapStrSeqIntFindSlotMut(nextMap, key, true)
            if slot >= 0:
                nextMap.keys[slot] = strings.CloneStr(key)
                nextMap.states[slot] = uint8(1)
                nextMap.used = nextMap.used + 1
                let start: int32 = oldValStart[i]
                let n: int32 = oldValLen[i]
                if start >= 0 && n > 0:
                    let segCap: int32 = hashMapStrSeqIntNextCap(n, oldValCap[i])
                    let segStart: int32 = hashMapStrSeqIntAllocTail(nextMap, segCap)
                    nextMap.valStart[slot] = segStart
                    nextMap.valLen[slot] = n
                    nextMap.valCap[slot] = segCap
                    for vi in 0..<n:
                        nextMap.pool[segStart + vi] = oldPool[start + vi]
                else:
                    nextMap.valStart[slot] = -1
                    nextMap.valLen[slot] = 0
                    nextMap.valCap[slot] = 0
    return nextMap

fn hashMapStrSeqIntGrow(m: var HashMapStrSeqInt) =
    var oldKeys: str[] = m.keys
    var oldValStart: int32[] = m.valStart
    var oldValLen: int32[] = m.valLen
    var oldValCap: int32[] = m.valCap
    var oldStates: uint8[] = m.states
    var oldPool: int32[] = m.pool
    let oldCap: int32 = oldKeys.len
    var newCap: int32 = (oldCap < 1024) ? (oldCap * 4) : (oldCap * 2)
    if newCap <= 0:
        newCap = 16
    let nextCap: int32 = hashMapNextPow2(newCap, 8)
    var nextMap: HashMapStrSeqInt = hashMapStrSeqIntGrowBuild(oldKeys, oldValStart, oldValLen,
            oldValCap, oldStates, oldPool, nextCap)
    # wave-17 定点修复: buffer-only free of the superseded tables (payloads moved).
    # r110: frees 先于 replace——借用寿命在提交前终结，避免 managed replace 撞活借用。
    seqs.chengSeqFreeTyped(oldKeys)
    seqs.chengSeqFreeTyped(oldValStart)
    seqs.chengSeqFreeTyped(oldValLen)
    seqs.chengSeqFreeTyped(oldValCap)
    seqs.chengSeqFreeTyped(oldStates)
    seqs.chengSeqFreeTyped(oldPool)
    m = nextMap

fn hashMapStrSeqIntPutSeq(m: var HashMapStrSeqInt, key: str, val: int32[]) =
    if len(key) > 0 && key != "":
        if m.mask == 0:
            m = hashMapStrSeqIntInit(16)
        let existingSlot: int32 = hashMapStrSeqIntFindSlotMut(m, key, false)
        if existingSlot >= 0:
            m.keys[existingSlot] = key
            hashMapStrSeqIntStoreSeqAt(m, existingSlot, val)
            return
        if (m.used + 1) * 10 >= m.keys.len * 7:
            hashMapStrSeqIntGrow(m)
        let slot: int32 = hashMapStrSeqIntFindSlotMut(m, key, true)
        if slot >= 0:
            if m.states[slot] == uint8(0):
                m.used = m.used + 1
                m.states[slot] = uint8(1)
            m.keys[slot] = key
            hashMapStrSeqIntStoreSeqAt(m, slot, val)

fn hashMapStrSeqIntAdd(m: var HashMapStrSeqInt, key: str, value: int32) =
    if len(key) > 0 && key != "":
        if m.mask == 0:
            m = hashMapStrSeqIntInit(16)
        let existingSlot: int32 = hashMapStrSeqIntFindSlotMut(m, key, false)
        if existingSlot >= 0:
            m.keys[existingSlot] = key
            let oldStart: int32 = m.valStart[existingSlot]
            let oldLen: int32 = m.valLen[existingSlot]
            let oldCap: int32 = m.valCap[existingSlot]
            if oldStart >= 0 && oldCap > oldLen && oldStart + oldCap <= m.pool.len:
                m.pool[oldStart + oldLen] = value
                m.valLen[existingSlot] = oldLen + 1
                return
            let newLen: int32 = oldLen + 1
            let newCap: int32 = hashMapStrSeqIntNextCap(newLen, oldCap)
            if oldStart >= 0 && oldCap > 0 && oldStart + oldCap == m.pool.len:
                let needLen: int32 = oldStart + newCap
                if m.pool.buffer == nil || m.pool.cap < needLen:
                    reserve(m.pool, needLen)
                setLen(m.pool, needLen)
                m.pool[oldStart + oldLen] = value
                m.valLen[existingSlot] = newLen
                m.valCap[existingSlot] = newCap
                return
            let newStart: int32 = hashMapStrSeqIntAllocTail(m, newCap)
            if oldStart >= 0 && oldLen > 0 && oldStart + oldLen <= m.pool.len:
                for i in 0..<oldLen:
                    m.pool[newStart + i] = m.pool[oldStart + i]
            m.pool[newStart + oldLen] = value
            m.valStart[existingSlot] = newStart
            m.valLen[existingSlot] = newLen
            m.valCap[existingSlot] = newCap
            return
        if (m.used + 1) * 10 >= m.keys.len * 7:
            hashMapStrSeqIntGrow(m)
        let slot: int32 = hashMapStrSeqIntFindSlotMut(m, key, true)
        if slot >= 0:
            if m.states[slot] == uint8(0):
                m.used = m.used + 1
                m.states[slot] = uint8(1)
                m.keys[slot] = key
                let start: int32 = hashMapStrSeqIntAllocTail(m, 4)
                m.valStart[slot] = start
                m.valLen[slot] = 1
                m.valCap[slot] = 4
                m.pool[start] = value

@borrows
fn hashMapStrSeqIntGet(m: HashMapStrSeqInt, key: str): int32[] =
    var found: bool
    return hashMapStrSeqIntGetEx(m, key, found)

@borrows
fn hashMapStrSeqIntGetEx(m: HashMapStrSeqInt, key: str, found: var bool): int32[] =
    if len(key) == 0 || key == "" || m.mask == 0:
        found = false
        return []
    let slot: int32 = hashMapStrSeqIntFindSlot(m, key, false)
    if slot < 0:
        found = false
        return []
    found = true
    return hashMapStrSeqIntBuildSeq(m, slot)

