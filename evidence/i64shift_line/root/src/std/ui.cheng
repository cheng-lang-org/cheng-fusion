# src/std/ui — Production GUI API (no raw ptr exposure)
#
# All handles are int32 indices into a component table managed by C bridge.
# Application code never sees ptr.
#
# Usage: @importc the functions you need from this module after importing.

# --- @importc bridge for handle management ---

@importc("cheng_ui_alloc_handle")
fn __ui_allocHandle(ptr: ptr): int32

@importc("cheng_ui_get_handle")
fn __ui_getHandle(id: int32): ptr

@importc("cheng_ui_free_handle")
fn __ui_freeHandle(id: int32)

# --- Window ---
@importc("cheng_app_init")
fn __ui_appInit()

@importc("cheng_app_run_frame")
fn __ui_processFrame()

@importc("cheng_window_create")
fn __ui_windowCreate(title: str, w: int32, h: int32): ptr

@importc("cheng_window_show")
fn __ui_windowShow(win: ptr)

@importc("cheng_window_close")
fn __ui_windowClose(win: ptr)

@importc("cheng_window_set_title")
fn __ui_windowSetTitle(win: ptr, title: str)

@importc("cheng_window_add_view")
fn __ui_windowAddView(win: ptr, view: ptr)

# --- Controls ---
@importc("cheng_label_create")
fn __ui_labelCreate(text: str, x: int32, y: int32, w: int32, h: int32): ptr

@importc("cheng_label_set_text")
fn __ui_labelSetText(label: ptr, text: str)

@importc("cheng_button_create")
fn __ui_buttonCreate(title: str, x: int32, y: int32, w: int32, h: int32): ptr

@importc("cheng_canvas_create")
fn __ui_canvasCreate(x: int32, y: int32, w: int32, h: int32): ptr

@importc("cheng_canvas_set_color")
fn __ui_canvasSetColor(canvas: ptr, r: int32, g: int32, b: int32)

@importc("cheng_view_release")
fn __ui_viewRelease(view: ptr)

# --- Event ---
@importc("cheng_next_event_type")
fn __ui_nextEventType(): int32

@importc("cheng_next_event_x")
fn __ui_nextEventX(): int32

@importc("cheng_next_event_y")
fn __ui_nextEventY(): int32

@importc("cheng_event_consume")
fn __ui_eventConsume()

@importc("cheng_sleep_ms")
fn __ui_sleepMs(ms: int32)

# ============================================================
# Public API — no ptr in any signature
# ============================================================

const
    EVENT_NONE: int32 = 0
    EVENT_QUIT: int32 = 1
    EVENT_KEY: int32 = 2
    EVENT_CLICK: int32 = 3
    EVENT_RESIZE: int32 = 4
    EVENT_MOUSE_MOVE: int32 = 5

# Application
fn app_init() =
    __ui_appInit()

fn app_processFrame() =
    __ui_processFrame()

fn app_sleepMs(ms: int32) =
    __ui_sleepMs(ms)

# Event
fn app_nextEvent(): int32 =
    return __ui_nextEventType()

fn app_eventX(): int32 =
    return __ui_nextEventX()

fn app_eventY(): int32 =
    return __ui_nextEventY()

fn app_consumeEvent() =
    __ui_eventConsume()

# Window
fn window_create(title: str, w: int32, h: int32): int32 =
    var win = __ui_windowCreate(title, w, h)
    return __ui_allocHandle(win)

fn window_show(id: int32) =
    var win = __ui_getHandle(id)
    __ui_windowShow(win)

fn window_close(id: int32) =
    var win = __ui_getHandle(id)
    __ui_windowClose(win)

fn window_setTitle(id: int32, title: str) =
    var win = __ui_getHandle(id)
    __ui_windowSetTitle(win, title)

fn window_add(id: int32, childId: int32) =
    var win = __ui_getHandle(id)
    var child = __ui_getHandle(childId)
    __ui_windowAddView(win, child)

# Label
fn label_create(text: str, x: int32, y: int32, w: int32, h: int32): int32 =
    var lbl = __ui_labelCreate(text, x, y, w, h)
    return __ui_allocHandle(lbl)

fn label_setText(id: int32, text: str) =
    var lbl = __ui_getHandle(id)
    __ui_labelSetText(lbl, text)

# Button
fn button_create(title: str, x: int32, y: int32, w: int32, h: int32): int32 =
    var btn = __ui_buttonCreate(title, x, y, w, h)
    return __ui_allocHandle(btn)

# Canvas
fn canvas_create(x: int32, y: int32, w: int32, h: int32): int32 =
    var cv = __ui_canvasCreate(x, y, w, h)
    return __ui_allocHandle(cv)

fn canvas_setColor(id: int32, r: int32, g: int32, b: int32) =
    var cv = __ui_getHandle(id)
    __ui_canvasSetColor(cv, r, g, b)

# Cleanup
fn control_release(id: int32) =
    var view = __ui_getHandle(id)
    __ui_viewRelease(view)
    __ui_freeHandle(id)
