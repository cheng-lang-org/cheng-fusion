# std/int64 - 64-bit integer operations
import std/system

# --- Type conversions ---

fn i64(value: int32): int64 =
    return int64(value)

fn i32(value: int64): int32 =
    return int32(value)

fn i64FromU64(value: uint64): int64 =
    return int64(value)

fn u64FromI64(value: int64): uint64 =
    return uint64(value)

# --- Absolute value ---

fn i64Abs(value: int64): int64 =
    if value < 0:
        return -value
    return value

# --- Min / Max / Clamp ---

fn i64Min(a: int64, b: int64): int64 =
    return a < b ? a : b

fn i64Max(a: int64, b: int64): int64 =
    return a > b ? a : b

fn i64Clamp(value: int64, lo: int64, hi: int64): int64 =
    if value < lo:
        return lo
    if value > hi:
        return hi
    return value

# --- Comparisons ---

fn i64Eq(a: int64, b: int64): bool =
    return a == b

fn i64Ne(a: int64, b: int64): bool =
    return a != b

fn i64Lt(a: int64, b: int64): bool =
    return a < b

fn i64Le(a: int64, b: int64): bool =
    return a <= b

fn i64Gt(a: int64, b: int64): bool =
    return a > b

fn i64Ge(a: int64, b: int64): bool =
    return a >= b

# --- Checked arithmetic (overflow panics) ---

fn i64Add(a: int64, b: int64): int64 =
    var sum: int64 = a + b
    if (a > 0 && b > 0 && sum < 0) || (a < 0 && b < 0 && sum > 0):
        panic("i64Add overflow")
    return sum

fn i64Sub(a: int64, b: int64): int64 =
    var diff: int64 = a - b
    if (a > 0 && b < 0 && diff < 0) || (a < 0 && b > 0 && diff > 0):
        panic("i64Sub overflow")
    return diff

fn i64Mul(a: int64, b: int64): int64 =
    if a == 0 || b == 0:
        return 0
    # a == -1 needs special handling because the division check below
    # would miss overflow when b == INT64_MIN (INT64_MIN / -1 overflows).
    if a == -1:
        var neg: int64 = -b
        if b < 0 && neg < 0:
            panic("i64Mul overflow")
        return neg
    var result: int64 = a * b
    if result / a != b:
        panic("i64Mul overflow")
    return result

# --- Wrapping arithmetic (no overflow check) ---

fn i64WrappingAdd(a: int64, b: int64): int64 =
    return a + b

fn i64WrappingSub(a: int64, b: int64): int64 =
    return a - b

fn i64WrappingMul(a: int64, b: int64): int64 =
    return a * b

# --- Bitwise operations ---

fn i64Shl(a: int64, shift: int32): int64 =
    return a << shift

fn i64Shr(a: int64, shift: int32): int64 =
    return a >> shift

fn i64And(a: int64, b: int64): int64 =
    return a & b

fn i64Or(a: int64, b: int64): int64 =
    return a | b

fn i64Xor(a: int64, b: int64): int64 =
    return a ^ b
