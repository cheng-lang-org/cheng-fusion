import std/result
import std/rawbytes

@importc("cheng_media_darwin_provider_probe_bridge")
fn __media_darwin_provider_probe_bridge(): int32

@importc("cheng_media_darwin_provider_last_error_code_bridge")
fn __media_darwin_provider_last_error_code_bridge(): int32

@importc("cheng_media_darwin_h264_hardware_decode_supported_bridge")
fn __media_darwin_h264_hardware_decode_supported_bridge(): int32

@importc("cheng_media_darwin_h264_mp4_first_frame_decode_bridge")
fn __media_darwin_h264_mp4_first_frame_decode_bridge(data: ptr,
                                                     dataLen: int32,
                                                     widthOut: ptr,
                                                     heightOut: ptr,
                                                     pixelFormatOut: ptr,
                                                     pixelBufferHandleOut: ptr,
                                                     textureHandleOut: ptr,
                                                     bytesReadyOut: ptr,
                                                     statusOut: ptr,
                                                     infoFlagsOut: ptr): int32

const
    MediaPlatformProbeSchema = "cheng.media.platform.probe.v1"
    MediaPlatformDarwin = "darwin"
    MediaPlatformDarwinVideoToolboxProvider = "macos-videotoolbox-codec-provider"
    MediaPlatformDarwinMetalTextureProvider = "metal-surface-texture-provider"
    MediaPlatformCapabilityVideoToolbox: int32 = 1
    MediaPlatformCapabilityCoreVideo: int32 = 2
    MediaPlatformCapabilityMetal: int32 = 4
    MediaPlatformCapabilityQuartzCore: int32 = 8
    MediaPlatformDarwinRequiredCapabilityMask: int32 = 15
    MediaPlatformFirstFrameDecodeSchema = "cheng.media.platform.first_frame_decode.v1"

type
    MediaPlatformProbeReceipt =
        schema: str
        platform: str
        capabilityMask: int32
        videoToolboxReady: bool
        coreVideoReady: bool
        metalReady: bool
        quartzCoreReady: bool
        h264HardwareDecodeSupported: bool
        decodeProviderReady: bool
        textureProviderReady: bool
        decodeProvider: str
        textureProvider: str
        errorCode: int32
        trace: str

    MediaPlatformFirstFrameDecodeReceipt =
        schema: str
        platform: str
        decodeProvider: str
        textureProvider: str
        decodedWidth: int32
        decodedHeight: int32
        pixelFormat: int32
        pixelBufferHandle: uint64
        textureHandle: uint64
        textureReady: bool
        bytesReady: int32
        statusCode: int32
        infoFlags: int32
        trace: str

fn MediaPlatformHasCapability(mask: int32, capability: int32): bool =
    if capability <= 0:
        return false
    return (mask & capability) == capability

fn MediaPlatformDarwinErrorText(code: int32): str =
    if code == 0:
        return ""
    if code == 10:
        return "media platform darwin: VideoToolbox framework missing"
    if code == 11:
        return "media platform darwin: VTDecompressionSessionCreate missing"
    if code == 20:
        return "media platform darwin: CoreVideo framework missing"
    if code == 21:
        return "media platform darwin: CVPixelBufferGetWidth missing"
    if code == 30:
        return "media platform darwin: Metal framework missing"
    if code == 31:
        return "media platform darwin: MTLCreateSystemDefaultDevice missing"
    if code == 40:
        return "media platform darwin: QuartzCore framework missing"
    if code == 41:
        return "media platform darwin: CAMetalLayer class missing"
    return "media platform darwin: provider probe failed"

fn MediaPlatformDarwinBuildReceipt(mask: int32, errorCode: int32): MediaPlatformProbeReceipt =
    var out: MediaPlatformProbeReceipt
    out.schema = MediaPlatformProbeSchema
    out.platform = MediaPlatformDarwin
    out.capabilityMask = mask
    out.videoToolboxReady = MediaPlatformHasCapability(mask, MediaPlatformCapabilityVideoToolbox)
    out.coreVideoReady = MediaPlatformHasCapability(mask, MediaPlatformCapabilityCoreVideo)
    out.metalReady = MediaPlatformHasCapability(mask, MediaPlatformCapabilityMetal)
    out.quartzCoreReady = MediaPlatformHasCapability(mask, MediaPlatformCapabilityQuartzCore)
    out.h264HardwareDecodeSupported = false
    if __media_darwin_h264_hardware_decode_supported_bridge() != 0:
        out.h264HardwareDecodeSupported = true
    out.decodeProviderReady = false
    if out.videoToolboxReady:
        if out.coreVideoReady:
            if out.h264HardwareDecodeSupported:
                out.decodeProviderReady = true
    out.textureProviderReady = false
    if out.metalReady:
        if out.quartzCoreReady:
            out.textureProviderReady = true
    out.decodeProvider = MediaPlatformDarwinVideoToolboxProvider
    out.textureProvider = MediaPlatformDarwinMetalTextureProvider
    out.errorCode = errorCode
    out.trace = "dlopen->dlsym->capability-mask"
    return out

fn MediaPlatformDarwinProbe(): Result[MediaPlatformProbeReceipt] =
    let mask: int32 = __media_darwin_provider_probe_bridge()
    let errorCode: int32 = __media_darwin_provider_last_error_code_bridge()
    let receipt = MediaPlatformDarwinBuildReceipt(mask, errorCode)
    if mask <= 0:
        return Err[MediaPlatformProbeReceipt](MediaPlatformDarwinErrorText(errorCode))
    return Ok[MediaPlatformProbeReceipt](receipt)

fn MediaPlatformDarwinProbeStrict(): Result[MediaPlatformProbeReceipt] =
    let probeRes = MediaPlatformDarwinProbe()
    if IsErr(probeRes):
        return Err[MediaPlatformProbeReceipt](Error(probeRes))
    let receipt = Value(probeRes)
    if !receipt.videoToolboxReady:
        return Err[MediaPlatformProbeReceipt](MediaPlatformDarwinErrorText(receipt.errorCode))
    if !receipt.coreVideoReady:
        return Err[MediaPlatformProbeReceipt](MediaPlatformDarwinErrorText(receipt.errorCode))
    if !receipt.metalReady:
        return Err[MediaPlatformProbeReceipt](MediaPlatformDarwinErrorText(receipt.errorCode))
    if !receipt.quartzCoreReady:
        return Err[MediaPlatformProbeReceipt](MediaPlatformDarwinErrorText(receipt.errorCode))
    if !receipt.h264HardwareDecodeSupported:
        return Err[MediaPlatformProbeReceipt]("media platform darwin: h264 hardware decode unsupported")
    if !receipt.decodeProviderReady:
        return Err[MediaPlatformProbeReceipt]("media platform darwin: decode provider incomplete")
    if !receipt.textureProviderReady:
        return Err[MediaPlatformProbeReceipt]("media platform darwin: texture provider incomplete")
    return Ok[MediaPlatformProbeReceipt](receipt)

fn MediaPlatformDarwinDecodeFirstFrame(data: rawbytes.Bytes): Result[MediaPlatformFirstFrameDecodeReceipt] =
    if rawbytes.BytesLen(data) <= 0:
        return Err[MediaPlatformFirstFrameDecodeReceipt]("media platform darwin: empty decode input")
    let probeRes = MediaPlatformDarwinProbeStrict()
    if IsErr(probeRes):
        return Err[MediaPlatformFirstFrameDecodeReceipt](Error(probeRes))
    var width: int32
    var height: int32
    var pixelFormat: int32
    var pixelBufferHandle: uint64
    var textureHandle: uint64
    var bytesReady: int32
    var statusCode: int32
    var infoFlags: int32
    let ok = __media_darwin_h264_mp4_first_frame_decode_bridge(data.data,
                                                               rawbytes.BytesLen(data),
                                                               ptr(&width),
                                                               ptr(&height),
                                                               ptr(&pixelFormat),
                                                               ptr(&pixelBufferHandle),
                                                               ptr(&textureHandle),
                                                               ptr(&bytesReady),
                                                               ptr(&statusCode),
                                                               ptr(&infoFlags))
    if ok == 0:
        return Err[MediaPlatformFirstFrameDecodeReceipt](
            Fmt"media platform darwin: h264 first frame decode failed status={statusCode}"
        )
    if width <= 0 || height <= 0:
        return Err[MediaPlatformFirstFrameDecodeReceipt]("media platform darwin: invalid decoded dimensions")
    if pixelBufferHandle == uint64(0):
        return Err[MediaPlatformFirstFrameDecodeReceipt]("media platform darwin: missing pixel buffer handle")
    if textureHandle == uint64(0):
        return Err[MediaPlatformFirstFrameDecodeReceipt]("media platform darwin: missing metal texture handle")
    return Ok[MediaPlatformFirstFrameDecodeReceipt](
        MediaPlatformFirstFrameDecodeReceipt(
            schema: MediaPlatformFirstFrameDecodeSchema,
            platform: MediaPlatformDarwin,
            decodeProvider: MediaPlatformDarwinVideoToolboxProvider,
            textureProvider: MediaPlatformDarwinMetalTextureProvider,
            decodedWidth: width,
            decodedHeight: height,
            pixelFormat: pixelFormat,
            pixelBufferHandle: pixelBufferHandle,
            textureHandle: textureHandle,
            textureReady: true,
            bytesReady: bytesReady,
            statusCode: statusCode,
            infoFlags: infoFlags,
            trace: "mp4->avcC->cmsamplebuffer->videotoolbox->cvpixelbuffer->cvmetaltexture"
        )
    )
