                     x: int32,
                     y: int32,
                     w: int32,
                     h: int32,
                     opacity: int32,
                     data: ptr,
                     dataLen: int32) =
    __gui_drawlist_push_image_raw(list, x, y, w, h, opacity, data, dataLen)
