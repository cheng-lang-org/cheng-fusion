const
    EVENT_NONE: int32 = 0
    EVENT_QUIT: int32 = 1
    EVENT_KEY: int32 = 2
    EVENT_CLICK: int32 = 3
    EVENT_RESIZE: int32 = 4
    EVENT_MOUSE_MOVE: int32 = 5
    DRAWLIST_COMMAND_NONE: int32 = 0
    DRAWLIST_COMMAND_RECT: int32 = 1
    DRAWLIST_COMMAND_BORDER: int32 = 2
    DRAWLIST_COMMAND_TEXT: int32 = 3
    DRAWLIST_COMMAND_TEXTURE: int32 = 4

fn guiCString(text: str): cstring =
    return strToCStringTemp(text)

fn Init() =
    __gui_app_init()

fn Run() =
    __gui_app_run()

fn Quit() =
    __gui_app_terminate()

fn Log(msg: str) =
    __gui_log(guiCString(msg))

fn CreateWindow(title: str, width: int32, height: int32): int32 =
    return __gui_window_create(guiCString(title), width, height)

fn ShowWindow(win: int32) =
    __gui_window_show(win)

fn CloseWindow(win: int32) =
    __gui_window_close(win)

fn SetWindowTitle(win: int32, title: str) =
    __gui_window_set_title(win, guiCString(title))

fn PollEvent(): int32 =
    return __gui_poll_event()

fn NextEvent(): int32 =
    return __gui_next_event_type()

fn EventX(): int32 =
    return __gui_next_event_x()

fn EventY(): int32 =
    return __gui_next_event_y()

fn EventKey(): int32 =
    return __gui_next_event_key()

fn EventWidth(): int32 =
    return __gui_next_event_width()

fn EventHeight(): int32 =
    return __gui_next_event_height()

fn ConsumeEvent() =
    __gui_event_consume()

fn ProcessFrame() =
    __gui_app_run_frame()

fn CreateButton(title: str, x: int32, y: int32, w: int32, h: int32): int32 =
    return __gui_button_create(guiCString(title), x, y, w, h)

fn CreateLabel(text: str, x: int32, y: int32, w: int32, h: int32): int32 =
    return __gui_label_create(guiCString(text), x, y, w, h)

fn SetLabelText(label: int32, text: str) =
    __gui_label_set_text(label, guiCString(text))

fn AddView(win: int32, view: int32) =
    __gui_window_add_view(win, view)

fn CreateCanvas(x: int32, y: int32, w: int32, h: int32): int32 =
    return __gui_canvas_create(x, y, w, h)

fn SetCanvasColor(canvas: int32, r: int32, g: int32, b: int32) =
    __gui_canvas_set_color(canvas, r, g, b)

fn CreateDrawListCanvas(x: int32, y: int32, w: int32, h: int32): int32 =
    return __gui_drawlist_canvas_create(x, y, w, h)

fn SetCanvasDrawList(canvas: int32, list: int32) =
    __gui_drawlist_canvas_set_list(canvas, list)

fn TimerTick(): int32 =
    return __gui_timer_tick()

fn SleepMs(ms: int32) =
    __gui_sleep_ms(ms)

fn ReleaseView(view: int32) =
    __gui_view_release(view)

@importc("cheng_drawlist_push_bgra")
fn __gui_drawlist_push_bgra(list: int32, x: int32, y: int32, w: int32, h: int32, bgra: ptr): int32

# Push a live BGRA buffer (w*h*4 bytes, must stay alive until the next
# push) as a full-frame image draw command.
fn DrawListPushBGRA(list: int32, x: int32, y: int32, w: int32, h: int32, bgra: ptr) =
    let _r = __gui_drawlist_push_bgra(list, x, y, w, h, bgra)

@importc("cheng_drawlist_push_bgra")
fn __gui_drawlist_push_bgra_raw(list: ptr, x: int32, y: int32, w: int32, h: int32, bgra: ptr): int32

# ptr-list variant of DrawListPushBGRA (same C entry, raw family)
fn DrawListPushBGRAPtr(list: ptr, x: int32, y: int32, w: int32, h: int32, bgra: ptr) =
    let _r = __gui_drawlist_push_bgra_raw(list, x, y, w, h, bgra)

fn DrawListNew(capacity: int32): int32 =
    return __gui_drawlist_new(capacity)

fn DrawListFree(list: int32) =
    __gui_drawlist_free(list)

fn DrawListClear(list: int32) =
    __gui_drawlist_clear(list)

fn DrawListCount(list: int32): int32 =
    return __gui_drawlist_count(list)

fn DrawListIsActive(list: int32): bool =
    return __gui_drawlist_is_active(list) != 0

fn MediaDarwinLastTextureReady(): bool =
    return __gui_media_darwin_last_texture_ready() != 0

fn DrawListPushRect(list: int32,
                    x: int32,
                    y: int32,
                    w: int32,
                    h: int32,
                    r: int32,
                    g: int32,
                    b: int32,
                    a: int32): bool =
    if __gui_drawlist_push_rect_command(list) == 0:
        return false
    if __gui_drawlist_set_last_command_position(list, x, y) == 0:
        return false
    if __gui_drawlist_set_last_command_size(list, w, h) == 0:
        return false
    if __gui_drawlist_set_last_command_color_rg(list, r, g) == 0:
        return false
    return __gui_drawlist_set_last_command_color_ba(list, b, a) != 0

fn DrawListPushBorder(list: int32,
                      x: int32,
                      y: int32,
                      w: int32,
                      h: int32,
                      r: int32,
                      g: int32,
                      b: int32,
                      a: int32,
                      borderWidth: int32,
                      radius: int32): bool =
    if __gui_drawlist_push_border_command(list) == 0:
        return false
    if __gui_drawlist_set_last_command_position(list, x, y) == 0:
        return false
    if __gui_drawlist_set_last_command_size(list, w, h) == 0:
        return false
    if __gui_drawlist_set_last_command_color_rg(list, r, g) == 0:
        return false
    if __gui_drawlist_set_last_command_color_ba(list, b, a) == 0:
        return false
    return __gui_drawlist_set_last_border_style(list, borderWidth, radius) != 0

fn DrawListPushText(list: int32,
                    text: str,
                    x: int32,
                    y: int32,
                    fontSize: int32,
                    r: int32,
                    g: int32,
                    b: int32,
                    a: int32): bool =
    let textLen: int32 = strings.Len(text)
    if __gui_drawlist_push_text_command(list, guiCString(text), textLen) == 0:
        return false
    if __gui_drawlist_set_last_command_position(list, x, y) == 0:
        return false
    if __gui_drawlist_set_last_text_font(list, fontSize) == 0:
        return false
    if __gui_drawlist_set_last_command_color_rg(list, r, g) == 0:
        return false
    return __gui_drawlist_set_last_command_color_ba(list, b, a) != 0

fn DrawListLastCommandKind(list: int32): int32 =
    return __gui_drawlist_last_command_kind(list)

fn DrawListRectCount(list: int32): int32 =
    return __gui_drawlist_rect_count(list)

fn DrawListBorderCount(list: int32): int32 =
    return __gui_drawlist_border_count(list)

fn DrawListTextCount(list: int32): int32 =
    return __gui_drawlist_text_count(list)

fn DrawListPushTexture(list: int32,
                       textureHandle: uint64,
                       x: int32,
                       y: int32,
                       w: int32,
                       h: int32,
                       decodedWidth: int32,
                       decodedHeight: int32,
                       pixelFormat: int32): bool =
    let handleHi = int32((textureHandle >> uint64(32)) & uint64(4294967295))
    let handleLo = int32(textureHandle & uint64(4294967295))
    if __gui_drawlist_push_texture_parts(list, handleHi, handleLo) == 0:
        return false
    if __gui_drawlist_set_last_texture_rect(list, x, y) == 0:
        return false
    if __gui_drawlist_set_last_texture_size(list, w, h) == 0:
        return false
    return __gui_drawlist_set_last_texture_metrics(list,
                                                   decodedWidth,
                                                   decodedHeight,
                                                   pixelFormat) != 0

fn DrawListPushTextureHandle(list: int32, textureHandle: uint64): bool =
    let handleHi = int32((textureHandle >> uint64(32)) & uint64(4294967295))
    let handleLo = int32(textureHandle & uint64(4294967295))
    return __gui_drawlist_push_texture_parts(list, handleHi, handleLo) != 0

fn DrawListPushLastDecodedTexture(list: int32): bool =
    return __gui_drawlist_push_last_decoded_texture(list) != 0

fn DrawListSetLastTextureRect(list: int32, x: int32, y: int32): bool =
    return __gui_drawlist_set_last_texture_rect(list, x, y) != 0

fn DrawListSetLastTextureSize(list: int32, w: int32, h: int32): bool =
    return __gui_drawlist_set_last_texture_size(list, w, h) != 0

fn DrawListSetLastTextureMetrics(list: int32,
                                 decodedWidth: int32,
                                 decodedHeight: int32,
                                 pixelFormat: int32): bool =
    return __gui_drawlist_set_last_texture_metrics(list,
                                                   decodedWidth,
                                                   decodedHeight,
                                                   pixelFormat) != 0

fn DrawListTextureCount(list: int32): int32 =
    return __gui_drawlist_texture_count(list)

fn DrawListLastTextureHandle(list: int32): uint64 =
    return __gui_drawlist_last_texture_handle(list)

fn DrawListLastTextureX(list: int32): int32 =
    return __gui_drawlist_last_texture_x(list)

fn DrawListLastTextureY(list: int32): int32 =
    return __gui_drawlist_last_texture_y(list)

fn DrawListLastTextureDrawWidth(list: int32): int32 =
    return __gui_drawlist_last_texture_draw_width(list)

fn DrawListLastTextureDrawHeight(list: int32): int32 =
    return __gui_drawlist_last_texture_draw_height(list)

fn DrawListLastTextureWidth(list: int32): int32 =
    return __gui_drawlist_last_texture_width(list)

fn DrawListLastTextureHeight(list: int32): int32 =
    return __gui_drawlist_last_texture_height(list)

fn DrawListLastTexturePixelFormat(list: int32): int32 =
    return __gui_drawlist_last_texture_pixel_format(list)

# ---- raw-pointer boundary channel (ObjC bridge exception, csg_player --window) ----
# cheng_window_create 只落 cocoa_bridge.m 内部 static 句柄表，而 IMAGE 绘制命令
# cheng_drawlist_push_image 只有原始指针签名（drawlist_bridge.h:52），raw 画布/
# 列表链路因此需要指针形入口。窗口三件套来自探针胶水 src/tests/csg_window_glue.m，
# 其余全部是 cocoa_bridge.m / drawlist_bridge.m 的既有 C 导出符号。

@importc("csg_window_create_ptr")
