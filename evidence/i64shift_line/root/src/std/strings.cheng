import std/rawbytes
import std/crypto/sha256
# Strings module (minimal)
import std/system
import std/rawmem_support

fn stringsEmpty(): str =
    var out: str
    return out

fn stringsNewStringAlloc(count: int32): str =
    return NewStringAlloc(count)

@borrows
fn NewStringFromCString(raw: cstring, count: int32): str =
    return NewStringCopyManaged(raw, count)

fn stringsNewStringCopy(raw: ptr, count: int32): str =
    return NewStringCopy(raw, count)

@borrows
fn len(s: str): int32 =
    return StrLenFast(s)

@borrows
fn streq(s1: str, s2: str): bool =
    let n: int32 = StrLenFast(s1)
    if n != StrLenFast(s2):
        return false
    if n <= 0:
        return true
    var i: int32
    for i in i..<n:
        if s1[i] != s2[i]:
            return false
    return true

@borrows
fn `==`(s1: str, s2: str): bool =
    return streq(s1, s2)

@borrows
fn strIsEmpty(s: str): bool =
    return StrLenFast(s) == 0

@borrows
fn strNonEmpty(s: str): bool =
    return StrLenFast(s) != 0

@borrows
fn hasPrefix(s: str, prefix: str): bool =
    let n: int32 = StrLenFast(s)
    let m: int32 = StrLenFast(prefix)
    if m == 0:
        return true
    if m > n:
        return false
    var i: int32
    for i in i..<m:
        if s[i] != prefix[i]:
            return false
    return true

@borrows
fn hasSuffix(s: str, suffix: str): bool =
    let n: int32 = StrLenFast(s)
    let m: int32 = StrLenFast(suffix)
    if m == 0:
        return true
    if m > n:
        return false
    var i: int32
    let start: int32 = n - m
    for i in i..<m:
        if s[start + i] != suffix[i]:
            return false
    return true

@borrows
@borrow_result
fn dropPrefix(s: str, prefix: str): str =
    if !hasPrefix(s, prefix):
        return s
    let prefixLen = StrLenFast(prefix)
    let totalLen = StrLenFast(s)
    let out = StrSubView(s, prefixLen, totalLen - prefixLen)
    return out

fn __cheng_str_from_bytes(data: uint8[], countRaw: int32): str =
    if countRaw <= 0:
        return stringsEmpty()
    var count: int32 = countRaw
    if count > data.len:
        count = data.len
    if count <= 0:
        return stringsEmpty()
    let out: str = stringsNewStringAlloc(count)
    let outData: ptr = StrDataPtr(out)
    if outData == nil:
        panic("strings: str_from_bytes alloc failed")
    for i in 0..<count:
        rawmem_support.RawmemWriteI8(outData, i, Int8(Int32(data[i])))
    rawmem_support.RawmemWriteI8(outData, count, Int8(0))
    return out

@borrows
fn concatStr(s1: str, s2: str): str =
    let lenA: int32 = StrLenFast(s1)
    let lenB: int32 = StrLenFast(s2)
    let dataA: ptr = StrDataPtr(s1)
    let dataB: ptr = StrDataPtr(s2)
    if lenA > 0 && dataA == nil:
        panic("ConcatStr: invalid left string")
    if lenB > 0 && dataB == nil:
        panic("ConcatStr: invalid right string")
    let total64: int64 = int64(lenA) + int64(lenB)
    if total64 < 0 || total64 >= int64(2147483647):
        panic("ConcatStr: length overflow")
    let total: int32 = int32(total64)
    if total <= 0:
        let empty = stringsEmpty()
        return empty
    let out: str = stringsNewStringAlloc(total)
    let outData: ptr = StrDataPtr(out)
    if outData == nil:
        panic("ConcatStr: alloc failed")
    if lenA > 0:
        rawmem_support.RawmemCopy(outData, dataA, lenA)
    if lenB > 0:
        let outTail = SystemPtrAdd(outData, lenA)
        rawmem_support.RawmemCopy(outTail, dataB, lenB)
    rawmem_support.RawmemWriteI8(outData, total, Int8(0))
    return out

fn charToStr(c: char): str =
    let out: str = stringsNewStringAlloc(1)
    if StrDataPtr(out) != nil && StrLenFast(out) == 1:
        rawmem_support.RawmemWriteI8(StrDataPtr(out), 0, Int8(Int32(c)))
    return out

fn `[]`(s: str, i: int32): char =
    let n: int32 = StrLenFast(s)
    let data: ptr = StrDataPtr(s)
    if data == nil:
        return Char(0)
    if i < 0:
        return Char(0)
    if i >= n:
        return Char(0)
    let byteVal: uint8 = uint8(rawmem_support.RawmemReadI8(data, i))
    return Char(byteVal)

fn `[]=`(s: str, i: int32, val: char) =
    let n: int32 = StrLenFast(s)
    let data: ptr = StrDataPtr(s)
    if data == nil:
        return
    if i < 0:
        return
    if i >= n:
        return
    rawmem_support.RawmemWriteI8(data, i, Int8(Int32(val)))

@borrows
@borrow_result
fn __cheng_slice_string(s: str, start: int32, stop: int32, exclusive: bool): str =
    let count: int32 = exclusive ? (stop - start) : (stop - start + 1)
    return StrSubView(s, start, count)

@borrows
fn __cheng_string_contains_char(s: str, c: char): bool =
    let n: int32 = StrLenFast(s)
    var i: int32
    for i in i..<n:
        if s[i] == c:
            return true
    return false

@borrows
fn __cheng_string_contains_str(s: str, sub: str): bool =
    return strContains(s, sub)


@borrows
@borrow_result
fn sliceBytes(text: str, start: int32, count: int32): str =
    return StrSubView(text, start, count)

@borrows
fn strContains(text: str, sub: str): bool =
    let n: int32 = StrLenFast(text)
    let m: int32 = StrLenFast(sub)
    if m == 0:
        return true
    if m > n:
        return false
    let limit = n - m
    var i: int32
    while i <= limit:
        var matched: bool = true
        var j: int32
        while j < m:
            if text[i + j] != sub[j]:
                matched = false
                break
            j = j + 1
        if matched:
            return true
        i = i + 1
    return false

fn int32PositiveDecimalLen(value: int32): int32 =
    if value == 0:
        return 1
    var n: int32 = value
    var count: int32
    while n != 0:
        count = count + 1
        n = n / 10
    return count

fn uint64DecimalLen(value: uint64): int32 =
    if value == UInt64(0):
        return 1
    var n: uint64 = value
    var count: int32
    while n != UInt64(0):
        count = count + 1
        n = n / UInt64(10)
    return count

@borrows
fn stringWriteByte(out: str, index: int32, value: int32) =
    rawmem_support.RawmemWriteI8(StrDataPtr(out), index, Int8(value))

fn int32PositiveToStr(value: int32): str =
    let digitCount: int32 = int32PositiveDecimalLen(value)
    let out: str = stringsNewStringAlloc(digitCount)
    var n: int32 = value
    var cursor: int32 = digitCount
    if n == 0:
        stringWriteByte(out, 0, Int32('0'))
        return out
    while n != 0:
        let q: int32 = n / 10
        let digit: int32 = n - (q * 10)
        cursor = cursor - 1
        stringWriteByte(out, cursor, Int32('0') + digit)
        n = q
    return out

fn uint64ToStr(x: uint64): str =
    let value: uint64 = x
    let digitCount: int32 = uint64DecimalLen(value)
    let out: str = stringsNewStringAlloc(digitCount)
    var n: uint64 = value
    var cursor: int32 = digitCount
    if n == UInt64(0):
        stringWriteByte(out, 0, Int32('0'))
        return out
    while n != UInt64(0):
        let q: uint64 = n / UInt64(10)
        let digit: uint64 = n - (q * UInt64(10))
        cursor = cursor - 1
        stringWriteByte(out, cursor, Int32('0') + Int32(digit))
        n = q
    return out

fn prependByte(text: str, value: int32): str =
    let n: int32 = Len(text)
    let out: str = stringsNewStringAlloc(n + 1)
    stringWriteByte(out, 0, value)
    var i: int32
    for i in i..<n:
        stringWriteByte(out, i + 1, Int32(text[i]))
    return out

fn int32NegativeToStr(i: int32): str =
    if i < Int32(-2147483647):
        return "-2147483648"
    return prependByte(int32PositiveToStr(Int32(0) - i), Int32('-'))

fn positiveInt64ToStr(value: uint64): str =
    return uint64ToStr(value)

fn IntToStr(i: int32): str =
    if i >= Int32(0):
        return int32PositiveToStr(i)
    return int32NegativeToStr(i)

fn int64ToStr(i: int64): str =
    if i >= Int64(0):
        return positiveInt64ToStr(UInt64(i))
    if i < Int64(-9223372036854775807):
        return "-9223372036854775808"
    let mag: uint64 = UInt64(0) - UInt64(i)
    return prependByte(positiveInt64ToStr(mag), Int32('-'))

fn `$`(x: bool): str =
    return stdStringifyBoolImpl(x)

fn `$`(x: char): str =
    return stdStringifyCharImpl(x)

fn `$`(x: int8): str =
    return stdStringifyInt8Impl(x)

fn `$`(x: uint8): str =
    return stdStringifyUInt8Impl(x)

fn `$`(x: int16): str =
    return stdStringifyInt16Impl(x)

fn `$`(x: uint16): str =
    return stdStringifyUInt16Impl(x)

fn `$`(x: int32): str =
    return stdStringifyInt32Impl(x)

fn `$`(x: int): str =
    return stdStringifyIntImpl(x)

fn `$`(x: uint32): str =
    return stdStringifyUInt32Impl(x)

fn `$`(x: int64): str =
    return stdStringifyInt64Impl(x)

fn `$`(x: uint64): str =
    return stdStringifyUInt64Impl(x)

fn `$`(s: str): str =
    return stdStringifyStrImpl(s)

fn stdStringifyBoolImpl(x: bool): str =
    return boolToString(x)

fn stdStringifyCharImpl(x: char): str =
    return charToString(x)

fn stdStringifyInt8Impl(x: int8): str =
    return IntToStr(Int32(x))

fn stdStringifyUInt8Impl(x: uint8): str =
    return uint64ToStr(UInt64(x))

fn stdStringifyInt16Impl(x: int16): str =
    return IntToStr(Int32(x))

fn stdStringifyUInt16Impl(x: uint16): str =
    return uint64ToStr(UInt64(x))

fn stdStringifyInt32Impl(x: int32): str =
    return IntToStr(x)

fn stdStringifyIntImpl(x: int): str =
    return IntToStr(Int32(x))

fn stdStringifyUInt32Impl(x: uint32): str =
    return uint64ToStr(UInt64(x))

fn stdStringifyInt64Impl(x: int64): str =
    return int64ToStr(x)

fn stdStringifyUInt64Impl(x: uint64): str =
    return uint64ToStr(x)

fn stdStringifyStrImpl(s: str): str =
    let data = StrDataPtr(s)
    let size = StrLenFast(s)
    return stringsNewStringCopy(data, size)

fn appendSeqPrefix(out: str, index: int32): str =
    if index > 0:
        return ConcatStr(out, ", ")
    return out

fn reprSeqString(xs: str[]): str =
    var out: str = "["
    var i: int32
    for i in i..<xs.len:
        out = appendSeqPrefix(out, i)
        out = ConcatStr(out, xs[i])
    return ConcatStr(out, "]")

fn reprSeqBool(xs: bool[]): str =
    var out: str = "["
    var i: int32
    for i in i..<xs.len:
        out = appendSeqPrefix(out, i)
        if xs[i]:
            out = ConcatStr(out, "true")
        else:
            out = ConcatStr(out, "false")
    return ConcatStr(out, "]")

fn reprSeqI32(xs: int32[]): str =
    var out: str = "["
    var i: int32
    for i in i..<xs.len:
        out = appendSeqPrefix(out, i)
        out = ConcatStr(out, IntToStr(xs[i]))
    return ConcatStr(out, "]")

fn reprSeqI64(xs: int64[]): str =
    var out: str = "["
    var i: int32
    for i in i..<xs.len:
        out = appendSeqPrefix(out, i)
        out = ConcatStr(out, int64ToStr(xs[i]))
    return ConcatStr(out, "]")

fn `$`(xs: str[]): str =
    return stdStringifySeqStrImpl(xs)

fn `$`(xs: bool[]): str =
    return stdStringifySeqBoolImpl(xs)

fn `$`(xs: int32[]): str =
    return stdStringifySeqInt32Impl(xs)

fn `$`(xs: int64[]): str =
    return stdStringifySeqInt64Impl(xs)

fn stdStringifySeqStrImpl(xs: str[]): str =
    return reprSeqString(xs)

fn stdStringifySeqBoolImpl(xs: bool[]): str =
    return reprSeqBool(xs)

fn stdStringifySeqInt32Impl(xs: int32[]): str =
    return reprSeqI32(xs)

fn stdStringifySeqInt64Impl(xs: int64[]): str =
    return reprSeqI64(xs)

@borrows
fn Len(s: str): int32 =
    let out = StrLenFast(s)
    return out

@borrows
fn Streq(s1: str, s2: str): bool =
    let out = streq(s1, s2)
    return out

@borrows
fn HasPrefix(s: str, prefix: str): bool =
    let out = hasPrefix(s, prefix)
    return out

@borrows
fn HasSuffix(s: str, suffix: str): bool =
    let out = hasSuffix(s, suffix)
    return out

@borrows
@borrow_result
fn DropPrefix(s: str, prefix: str): str =
    let out = dropPrefix(s, prefix)
    return out

# Owned copy of any (possibly borrowed) str. Allocates once and byte-copies
# (never retains the source's data pointer, so the result carries no source
# borrow edge).  Do NOT build with ConcatStr per character — that is O(n^2)
# and multi-MB inputs (scene/font resources) never finish.
@borrows
fn CloneStr(value: str): str =
    let n: int32 = StrLenFast(value)
    if n <= 0:
        return stringsEmpty()
    let out: str = NewStringAlloc(n)
    rawmem_support.RawmemCopy(RawmemAsVoid(out), StrDataPtr(value), n)
    return out

# Owned [start, start+count) range copy of any (possibly borrowed) str.
@borrows
fn CloneStrRange(value: str, start: int32, count: int32): str =
    let n: int32 = StrLenFast(value)
    var safeStart: int32 = start
    var safeCount: int32 = count
    if safeStart < 0:
        safeStart = 0
    if safeStart > n:
        safeStart = n
    if safeCount < 0 || safeStart + safeCount > n:
        safeCount = n - safeStart
    if safeCount <= 0:
        return stringsEmpty()
    let out: str = NewStringAlloc(safeCount)
    rawmem_support.RawmemCopy(RawmemAsVoid(out), rawmem_support.RawmemPtrAdd(StrDataPtr(value), safeStart), safeCount)
    return out

@borrows
fn ConcatStr(s1: str, s2: str): str =
    let out = concatStr(s1, s2)
    return out

fn CharToStr(c: char): str =
    let out = charToStr(c)
    return out

@borrows
@borrow_result
fn SliceBytes(text: str, start: int32, count: int32): str =
    return sliceBytes(text, start, count)

@borrows
fn StrContains(text: str, sub: str): bool =
    return strContains(text, sub)

@borrows
fn Sha256(text: str): str =
    let raw = rawbytes.BytesFromString(text)
    var digest = sha256.Sha256Digest(raw)
    defer:
        rawbytes.BytesFree(digest)
    return rawbytes.BytesToHex(digest)

fn Uint64ToStr(x: uint64): str =
    return uint64ToStr(x)

fn Int64ToStr(i: int64): str =
    return int64ToStr(i)
