# ball_film (BALL BALANCE): the 20-second two-case physics milestone film
# cut from the ballbalance scene (the exact ball_balance_probe wiring:
# execution-side ball injection, settle anchored 0..99, release at tick
# 100, frozen producer ball parameters r = 0.35 m / m = 30 kg).
#
# Three acts, 480 frames at 24 fps (20 s), FrameStep = 20 ticks/frame:
#   act 1 (frames 0-159, ticks 0-3200): "ACT 1 - SURF" — the v1 surf
#     baseline (CsgBalanceSetParams, capture reflex disarmed via the
#     100 m/s trigger): the servo pumps the pair, the ball is kicked
#     into its steady roll; a live ball-drift counter is drawn into the
#     frame, its value refreshed every 60 frames.
#   act 2 (frames 160-239): "ACT 2 - SWITCH" — freeze-frame transition:
#     the case-B hang pose rendered dimmed with the switch caption.
#   act 3 (frames 240-479, ticks 0-4800): "ACT 3 - STAND" — the
#     ball-top stand (CsgBalanceSetBallMode): same figure, same scene,
#     the servo retargeted onto the ball frame; drift counter again,
#     closing caption "PURE CHENG XPBD PHYSICS" for the last 2 s.
#
# Why two simulations spliced instead of one world switching modes at
# the act boundary: CsgBalanceSetBallMode IS a live per-state retarget
# (soft-start ramp, latching arming basin), but at act-1's end the v1
# pair rolls at 4.75 m/s some 60 m out — the ball servo was validated
# catching the figure from the hang pose at rest, never braking a fast
# roll, and its frozen enable-time foot/pelvis offsets plus the 0.6 m
# CoM arming basin make a mid-roll catch unproven (latch-off would
# topple act 3). The probe's two-case protocol is therefore kept: case
# A and case B run as independent episodes of the same scene and the
# cut splices them; the MP4 is assembled once over the act-ordered
# frame sequence.
#
# Pipeline per skeleton_film: pass 1 serial physics + per-frame state
# dump + smoothed ball-chase camera buffering (numbers only inside the
# physics loop; param files written after each segment), pass 2
# frame-parallel render workers (state file + param file -> PPM), pass
# 3 PPM -> VideoToolbox H.264 + ScorePcm48k(20 s) AAC -> Mp4Assemble
# video+audio + manifest. The stage is deliberately wall-free, and act
# 1 rolls past the library ground's +/-20 m, so the film draws its own
# +/-80 m checker ground with the identical ray-cast contract. Gates:
# zero rejected physics steps in both episodes, act-1 drift proves the
# contact kick, act-3 never toppled and drift under the 2 m band at
# tick 2000 (int-mm compares, the documented-safe boundary).
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/contacts3d
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/cinema/camera
import cheng/game/cinema/vtbr
import cheng/game/cinema/mp4
import cheng/game/cinema/aac
import cheng/game/cinema/score
import cheng/game/render/cpu_raster as raster
import cheng/game/render/character
import cheng/game/render/text
import cheng/game/render/render_state
import std/os
import std/strings as strings
import std/rawbytes
import std/math as m
import std/thread

const
    FilmSchema = "cheng.apps.ball_film.v1"
    FilmWidth = 1280
    FilmHeight = 720
    FilmDir = "artifacts/csg_world_video/ball_film"
    FrameStep = 20
    Act1Frames = 160
    Act2Frames = 80
    Act3Frames = 240
    FilmFrames = 480
    SegATicks = 3200
    SegBTicks = 4800
    DriftCheckTick = 2000
    Act1DriftPassMm: int64 = 5000
    Act3DriftPassMm: int64 = 2000
    EndCaptionFrames = 48
    # follow camera: position = ball center + offset, look-at = smoothed
    # ball center; pulled back far enough to hold figure + ball + ground
    CamOffX = -2.8
    CamOffY = 2.4
    CamOffZ = 1.6
    CamFocal = 750.0
    CamSmooth = 0.30
    GroundExtent = 80.0
    CaptionEvery = 60
    # spot-check PPMs kept on disk (one per act)
    SpotFrame1 = 80
    SpotFrame2 = 200
    SpotFrame3 = 360

type
    SegResult =
        ok: bool
        rejected: int32
        fallTick: int32
        driftEndMm: int64
        driftCheckMm: int64
        factsCid: str
        chainCid: str
        drift: float64[]
        camX: float64[]
        camY: float64[]
        camZ: float64[]
        tgtX: float64[]
        tgtY: float64[]
        tgtZ: float64[]

fn FramePath(frame: int32): str =
    return FilmDir + "/ball_f" + strings.IntToStr(frame) + ".ppm"

fn ParamPath(frame: int32): str =
    return FilmDir + "/param_f" + strings.IntToStr(frame) + ".txt"

fn StateIdxPath(stateIdx: int32): str =
    return render_state.RenderStateFramePath(FilmDir, stateIdx)

fn QuantMm(v: float64): int64 =
    return int64(v * 1000.0)

fn MicronOf(v: float64): int64 =
    if v >= 0.0:
        return int64(v * 1000000.0 + 0.5)
    return int64(v * 1000000.0 - 0.5)

fn MicronToFloat(mcr: int64): float64 =
    return float64(mcr) / 1000000.0

fn IsSpot(frame: int32): bool =
    if frame == SpotFrame1:
        return true
    if frame == SpotFrame2:
        return true
    if frame == SpotFrame3:
        return true
    return false

# Drift caption: meters with three decimals through the int-mm hop
# (strings carries no float formatter; Int64ToStr + fixed scale is the
# exact probe fmtMm shape lifted to whole meters).
fn FmtMeters(x: float64): str =
    let scaled: int64 = int64(m.roundFloat(x * 1000.0))
    let intPart: int64 = scaled / 1000
    let fracPart: int64 = scaled % 1000
    return strings.Int64ToStr(intPart) + "." + strings.CloneStrRange(strings.Int64ToStr(fracPart + 1000), 1, 3) + " m"

# Per-frame camera/caption parameter file (numeric line 1, state line 2,
# act label line 3, caption line 4):
#   line 1: camX camY camZ tgtX tgtY tgtZ focal subOn dim   (microns)
fn WriteParam(frame: int32,
              camX: float64,
              camY: float64,
              camZ: float64,
              tgtX: float64,
              tgtY: float64,
              tgtZ: float64,
              subOn: int32,
              dim: int32,
              stateIdx: int32,
              label: str,
              caption: str) =
    var ptext: str = ""
    ptext = ptext + strings.Int64ToStr(MicronOf(camX))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(camY))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(camZ))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtX))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtY))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtZ))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(CamFocal))
    ptext = ptext + " " + strings.IntToStr(subOn)
    ptext = ptext + " " + strings.IntToStr(dim)
    ptext = ptext + "\n"
    ptext = ptext + strings.IntToStr(stateIdx) + "\n"
    ptext = ptext + label + "\n"
    ptext = ptext + caption + "\n"
    os.WriteFile(ParamPath(frame), ptext)

# One episode of the ballbalance experiment with the exact probe
# protocol: settle anchored, release at tick 100, run segTicks. ballMode
# false = v1 surf servo (case A), true = ball-top servo (case B). The
# physics loop stays numeric; states are saved at frame ticks, camera
# and drift ride back per frame in the result.
fn RunSeg(ballMode: bool, segTicks: int32, frames: int32, outBase: int32): SegResult =
    var out: SegResult
    out.ok = false
    out.rejected = 0
    out.fallTick = 0 - 1
    out.driftEndMm = 0
    out.driftCheckMm = 0
    out.factsCid = ""
    out.chainCid = ""
    setLen(out.drift, frames)
    setLen(out.camX, frames)
    setLen(out.camY, frames)
    setLen(out.camZ, frames)
    setLen(out.tgtX, frames)
    setLen(out.tgtY, frames)
    setLen(out.tgtZ, frames)
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildBallBalanceScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        return out
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        return out
    # execution-side ball injection before execution init clones the
    # world (the probe's chain-gap bridge, verbatim)
    let ballSlot: int32 = world3d.World3dSpawnBody(w,
        producer.CsgBallBalanceBallCenterX,
        producer.CsgBallBalanceBallCenterY,
        producer.CsgBallBalanceBallRadiusM,
        producer.CsgBallBalanceBallMassKg,
        producer.CsgBallBalanceBallRadiusM,
        world3d.World3dBodyBallRigid)
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    if ballMode:
        execution.CsgBalanceSetBallMode(st,
            ballSlot,
            producer.CsgBallBalanceBallRadiusM,
            execution.CsgBalanceBallGain,
            execution.CsgBalanceBallFootGain,
            execution.CsgBalanceBallDamp,
            execution.CsgBalanceBallTorsoCapMps,
            execution.CsgBalanceBallCorrCapMps)
    else:
        execution.CsgBalanceSetParams(st,
            execution.CsgBalanceGain,
            execution.CsgBalanceDamp,
            execution.CsgBalanceCorrCapMps,
            100.0,
            execution.CsgCaptureStepLenM,
            2.0, 30.0, 270.0)
    # semantic part lookup through the role table (exact identity); the
    # state stream stores the frozen RenderCharacterState role order
    var roles: int32[]
    setLen(roles, 7)
    var found: int32
    found = 0
    var ri: int32 = 0
    while ri < facts.partRole.len:
        if facts.partRole[ri] == schema.CsgRolePelvis:
            roles[0] = ri
            found = found + 1
        if facts.partRole[ri] == schema.CsgRoleChest:
            roles[1] = ri
            found = found + 1
        if facts.partRole[ri] == schema.CsgRoleHead:
            roles[2] = ri
            found = found + 1
        if facts.partRole[ri] == schema.CsgRoleHandL:
            roles[3] = ri
            found = found + 1
        if facts.partRole[ri] == schema.CsgRoleHandR:
            roles[4] = ri
            found = found + 1
        if facts.partRole[ri] == schema.CsgRoleFootL:
            roles[5] = ri
            found = found + 1
        if facts.partRole[ri] == schema.CsgRoleFootR:
            roles[6] = ri
            found = found + 1
        ri = ri + 1
    if found != 7:
        return out
    let pelvisSlot: int32 = mp.partSlot[roles[0]]
    let headSlot: int32 = mp.partSlot[roles[2]]
    let ballX0: float64 = st.w.bodyPx[ballSlot]
    let ballY0: float64 = st.w.bodyPy[ballSlot]
    var rejected: int32
    rejected = 0
    var fallTick: int32
    fallTick = 0 - 1
    var driftCheck: float64
    driftCheck = 0.0
    var fCamX: float64
    var fCamY: float64
    var fCamZ: float64
    var fTgtX: float64
    var fTgtY: float64
    var fTgtZ: float64
    var frame: int32
    frame = 0
    var tick: int32
    tick = 0
    while tick < segTicks:
        let dx = st.w.bodyPx[ballSlot] - ballX0
        let dy = st.w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        if tick == DriftCheckTick:
            driftCheck = drift
        if st.w.bodyPz[headSlot] < st.w.bodyPz[pelvisSlot]:
            if fallTick < 0:
                fallTick = tick
        if tick % FrameStep == 0:
            let bx = st.w.bodyPx[ballSlot]
            let by = st.w.bodyPy[ballSlot]
            let bz = st.w.bodyPz[ballSlot]
            if frame == 0:
                fTgtX = bx
                fTgtY = by
                fTgtZ = bz
                fCamX = bx + CamOffX
                fCamY = by + CamOffY
                fCamZ = bz + CamOffZ
            else:
                fTgtX = fTgtX + (bx - fTgtX) * CamSmooth
                fTgtY = fTgtY + (by - fTgtY) * CamSmooth
                fTgtZ = fTgtZ + (bz - fTgtZ) * CamSmooth
                fCamX = fCamX + (bx + CamOffX - fCamX) * CamSmooth
                fCamY = fCamY + (by + CamOffY - fCamY) * CamSmooth
                fCamZ = fCamZ + (bz + CamOffZ - fCamZ) * CamSmooth
            out.drift[frame] = drift
            out.camX[frame] = fCamX
            out.camY[frame] = fCamY
            out.camZ[frame] = fCamZ
            out.tgtX[frame] = fTgtX
            out.tgtY[frame] = fTgtY
            out.tgtZ[frame] = fTgtZ
            render_state.RenderStateSave(st.w, roles, StateIdxPath(outBase + frame))
            frame = frame + 1
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            rejected = rejected + 1
            break
        tick = tick + 1
    if frame != frames:
        out.rejected = rejected
        return out
    out.rejected = rejected
    out.fallTick = fallTick
    out.driftEndMm = QuantMm(out.drift[frames - 1])
    out.driftCheckMm = QuantMm(driftCheck)
    out.factsCid = Fmt"{schema.CsgWorldFactsCid(facts)}"
    out.chainCid = Fmt"{st.chainCid}"
    out.ok = true
    return out

# Wide checker ground for the surf act: the RasterGround ray-cast
# contract with +/-80 m reach and a 2 m band so the checker stays
# legible while the pair rolls tens of metres.
@borrows
fn GroundWide(t: raster.RasterTarget, cam: camera.CinemaCamera) =
    var py: int32 = 0
    while py < t.height:
        let sv = (float64(t.height) * 0.5 - float64(py) - 0.5) / cam.focalPx
        let dzRow = cam.fz + cam.uz * sv
        if dzRow < -0.0001:
            var px: int32 = 0
            while px < t.width:
                let su = (float64(px) + 0.5 - float64(t.width) * 0.5) / cam.focalPx
                let dx = cam.fx + cam.rx * su
                let dy = cam.fy + cam.ry * su
                let tt = (0.0 - cam.posZ) / dzRow
                if tt > 0.1:
                    let hitX = cam.posX + dx * tt
                    let hitY = cam.posY + dy * tt
                    if hitX > 0.0 - GroundExtent:
                        if hitX < GroundExtent:
                            if hitY > 0.0 - GroundExtent:
                                if hitY < GroundExtent:
                                    let bandX: int32 = int32(m.floorFloat(hitX * 0.5))
                                    let bandY: int32 = int32(m.floorFloat(hitY * 0.5))
                                    var lum = 0.35 + 0.65 * raster.RasterLightZ
                                    if (bandX + bandY) % 2 == 0:
                                        lum = lum * 0.82
                                    raster.RasterPut(t, px, py, tt, int32(90.0 * lum), int32(80.0 * lum), int32(70.0 * lum))
                px = px + 1
        py = py + 1

# The ball rides the state stream (it is a world body, not a facts
# part): one shaded sphere per ball-rigid body, the milestone ball.
@borrows
fn DrawBallState(t: raster.RasterTarget, cam: camera.CinemaCamera, s: render_state.RenderState) =
    var i: int32 = 0
    while i < s.bodyCount:
        if s.kinds[i] == world3d.World3dBodyBallRigid:
            raster.RasterSphere(t, cam, s.px[i], s.py[i], s.pz[i], s.radius[i], 205, 120, 35)
        i = i + 1

# Act-2 dark field: the frozen pose dimmed to 30 percent before the
# captions go on top bright.
@borrows
fn DimFrame(t: raster.RasterTarget) =
    let total: int32 = t.width * t.height
    var pi: int32 = 0
    while pi < total:
        rawbytes.BytesSet(t.frame.bgra, pi * 4, rawbytes.BytesGet(t.frame.bgra, pi * 4) * 3 / 10)
        rawbytes.BytesSet(t.frame.bgra, pi * 4 + 1, rawbytes.BytesGet(t.frame.bgra, pi * 4 + 1) * 3 / 10)
        rawbytes.BytesSet(t.frame.bgra, pi * 4 + 2, rawbytes.BytesGet(t.frame.bgra, pi * 4 + 2) * 3 / 10)
        pi = pi + 1

# Pass 2 worker: load this frame's param file (camera, switches, act
# label, caption) and its state file, render ground + figure + ball,
# apply the act-2 dim, draw the captions, write the PPM. Every input
# comes from this frame's own files — no shared state across threads.
fn ballRenderWorker(raw: ptr, index: int32, worker: int32): int32 =
    let _raw = raw
    let _worker = worker
    let ptext: str = os.ReadFile(ParamPath(index))
    if ptext.len < 8:
        return 1
    var camv: int64[]
    setLen(camv, 0)
    var subOn: int32
    var dim: int32
    var stateIdx: int32
    var pos: int32 = 0
    var fi: int32 = 0
    while fi < 10:
        var v: int64
        var neg: bool
        var seen: bool
        v = 0
        neg = false
        seen = false
        while pos < ptext.len:
            let c: int32 = int32(ptext[pos])
            if c == 45:
                neg = true
                seen = true
                pos = pos + 1
            else:
                if c == 32 || c == 10:
                    if seen:
                        pos = pos + 1
                        break
                    pos = pos + 1
                else:
                    v = v * 10 + int64(c - 48)
                    seen = true
                    pos = pos + 1
        if neg:
            v = 0 - v
        if fi < 7:
            add(camv, v)
        if fi == 7:
            subOn = int32(v)
        if fi == 8:
            dim = int32(v)
        if fi == 9:
            stateIdx = int32(v)
        fi = fi + 1
    # the 10th token's terminator ends line 2, so pos sits at the act
    # label already: read it, then the caption behind it
    var ls: int32 = pos
    while pos < ptext.len:
        if int32(ptext[pos]) == 10:
            break
        pos = pos + 1
    let label: str = strings.sliceBytes(ptext, ls, pos - ls)
    pos = pos + 1
    # line 4: caption
    var cs: int32 = pos
    while pos < ptext.len:
        if int32(ptext[pos]) == 10:
            break
        pos = pos + 1
    let caption: str = strings.sliceBytes(ptext, cs, pos - cs)
    var cam = camera.CinemaCameraLookAt(
        MicronToFloat(camv[0]), MicronToFloat(camv[1]), MicronToFloat(camv[2]),
        MicronToFloat(camv[3]), MicronToFloat(camv[4]), MicronToFloat(camv[5]),
        MicronToFloat(camv[6]), FilmWidth, FilmHeight)
    let state = render_state.RenderStateLoad(StateIdxPath(stateIdx))
    # RenderStateLoad yields an empty non-nil state on a missing or
    # malformed file — the 7-role / 8-body shape is the load-bearing
    # guard before the frozen-order character draw
    if state == nil:
        return 1
    if state.roleCount != 7:
        return 1
    if state.bodyCount < 8:
        return 1
    var t: raster.RasterTarget
    t = raster.RasterMake(FilmWidth, FilmHeight)
    GroundWide(t, cam)
    character.RenderCharacterState(t, cam, state)
    DrawBallState(t, cam, state)
    if dim >= 1:
        DimFrame(t)
    text.RasterText(t, 40, 40, 2, label, 255, 255, 255)
    if subOn >= 1:
        let tw: int32 = text.TextPixelWidth(caption, 3)
        text.RasterText(t, (FilmWidth - tw) / 2, FilmHeight - 90, 3, caption, 240, 240, 220)
    raster.RasterWritePpm(t, FramePath(index))
    if index == SpotFrame1:
        raster.RasterWritePpm(t, FilmDir + "/spot_act1_surf.ppm")
    if index == SpotFrame2:
        raster.RasterWritePpm(t, FilmDir + "/spot_act2_switch.ppm")
    if index == SpotFrame3:
        raster.RasterWritePpm(t, FilmDir + "/spot_act3_stand.ppm")
    return 0

fn main(): int32 =
    os.MkdirAll(FilmDir, 493)
    # self-collision on: the figure-ball pair resolves through
    # Contacts3dResolveBodyPairs (the probe's contract, verbatim)
    contacts3d.Contacts3dSelfCollisionSet(1)
    # ---- pass 1a: act 1, the v1 surf episode (case A) ----
    var segA = RunSeg(false, SegATicks, Act1Frames, 0)
    if !segA.ok:
        echo("FAIL act1 surf segment (validation/materialize/frame count)")
        return 1
    # ---- pass 1b: act 3, the ball-top stand episode (case B) ----
    var segB = RunSeg(true, SegBTicks, Act3Frames, Act1Frames + Act2Frames)
    if !segB.ok:
        echo("FAIL act3 stand segment (validation/materialize/frame count)")
        return 1
    # ---- episode gates (int-mm compares, the documented-safe boundary) ----
    if segA.rejected != 0 || segB.rejected != 0:
        echo("FAIL ball film physics rejections a=" + strings.IntToStr(segA.rejected)
            + " b=" + strings.IntToStr(segB.rejected))
        return 1
    if segB.fallTick >= 0:
        echo("FAIL act3 figure fell at tick " + strings.IntToStr(segB.fallTick))
        return 1
    if segA.driftEndMm <= Act1DriftPassMm:
        echo("FAIL act1 ball never rolled drift_end_mm=" + strings.Int64ToStr(segA.driftEndMm))
        return 1
    if segB.driftCheckMm >= Act3DriftPassMm:
        echo("FAIL act3 drift at tick " + strings.IntToStr(DriftCheckTick)
            + " mm=" + strings.Int64ToStr(segB.driftCheckMm))
        return 1
    # ---- act parameter files (all caption str work is post-loop) ----
    var f: int32
    f = 0
    while f < Act1Frames:
        let fr: int32 = f - f % CaptionEvery
        let cap: str = "BALL DRIFT " + FmtMeters(segA.drift[fr])
        WriteParam(f, segA.camX[f], segA.camY[f], segA.camZ[f],
            segA.tgtX[f], segA.tgtY[f], segA.tgtZ[f],
            1, 0, f, "ACT 1 - SURF", cap)
        f = f + 1
    f = Act1Frames
    while f < Act1Frames + Act2Frames:
        WriteParam(f, segB.camX[0], segB.camY[0], segB.camZ[0],
            segB.tgtX[0], segB.tgtY[0], segB.tgtZ[0],
            1, 1, Act1Frames + Act2Frames, "ACT 2 - SWITCH", "SAME FIGURE - BALL MODE ON")
        f = f + 1
    f = Act1Frames + Act2Frames
    while f < FilmFrames:
        let lf: int32 = f - (Act1Frames + Act2Frames)
        var cap: str
        if lf >= Act3Frames - EndCaptionFrames:
            cap = "PURE CHENG XPBD PHYSICS"
        else:
            let fr: int32 = lf - lf % CaptionEvery
            cap = "BALL DRIFT " + FmtMeters(segB.drift[fr])
        WriteParam(f, segB.camX[lf], segB.camY[lf], segB.camZ[lf],
            segB.tgtX[lf], segB.tgtY[lf], segB.tgtZ[lf],
            1, 0, f, "ACT 3 - STAND", cap)
        f = f + 1
    # ---- pass 2: frame-parallel render from the state stream ----
    var pool = thread.PoolNew(0)
    thread.ParallelFor(pool, FilmFrames, &ballRenderWorker, nil)
    # ---- pass 3: stream PPM frames -> VideoToolbox -> ball_balance.mp4 ----
    let vctx: ptr = vtbr.VtbrVideoSessionCreate(FilmWidth, FilmHeight)
    if vctx == nil:
        echo("FAIL vt session")
        return 1
    var encodeFail: int32
    encodeFail = 0
    var pixTotal: int32 = FilmWidth * FilmHeight
    f = 0
    while f < FilmFrames:
        let ppm: str = os.ReadFile(FramePath(f))
        if ppm.len < 16 + pixTotal * 3:
            echo("FAIL ppm short frame=" + strings.IntToStr(f))
            return 1
        var b: rawbytes.Bytes = rawbytes.BytesAlloc(pixTotal * 4)
        var pi: int32 = 0
        while pi < pixTotal:
            rawbytes.BytesSet(b, pi * 4, int32(ppm[16 + pi * 3 + 2]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 1, int32(ppm[16 + pi * 3 + 1]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 2, int32(ppm[16 + pi * 3]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 3, int32(255))
            pi = pi + 1
        let erc = vtbr.VtbrVideoEncodeBgra(vctx, rawbytes.BytesDataPtr(b), FilmWidth * 4, FilmWidth, FilmHeight, f * 1000)
        rawbytes.BytesFree(b)
        if erc != 0:
            encodeFail = encodeFail + 1
        if !IsSpot(f):
            let _removed = os.RemoveFile(FramePath(f))
        f = f + 1
    if encodeFail > 0:
        echo("FAIL encode frames n=" + strings.IntToStr(encodeFail))
        return 1
    if vtbr.VtbrVideoFinish(vctx) != 0:
        echo("FAIL video finish")
        return 1
    let _drained = vtbr.VtbrVideoDrain(vctx)
    var videoPayload: uint8[]
    setLen(videoPayload, 0)
    vtbr.VtbrVideoCopyPayload(vctx, videoPayload)
    var videoSizes: int32[]
    setLen(videoSizes, 0)
    vtbr.VtbrVideoCopySizes(vctx, videoSizes)
    var videoKf: int32[]
    setLen(videoKf, 0)
    vtbr.VtbrVideoCopyKeyframes(vctx, videoKf)
    var sps: uint8[]
    setLen(sps, 0)
    var pps: uint8[]
    setLen(pps, 0)
    vtbr.VtbrVideoCopyParamSets(vctx, sps, pps)
    if sps.len == 0 || pps.len == 0:
        echo("FAIL paramsets empty")
        return 1
    if videoSizes.len != FilmFrames:
        echo("FAIL video sample count n=" + strings.IntToStr(videoSizes.len))
        return 1
    var inp: mp4.Mp4Input
    inp.videoSizes = videoSizes
    inp.videoKf = videoKf
    inp.videoPayload = videoPayload
    inp.sps = sps
    inp.pps = pps
    var scorePcm: uint8[]
    setLen(scorePcm, 0)
    let scoreSamples: int32 = score.ScorePcm48k(scorePcm, 20)
    var audioPayload: uint8[]
    setLen(audioPayload, 0)
    var audioSizes: int32[]
    setLen(audioSizes, 0)
    let arc = aac.AacEncodePcm16(scorePcm, scorePcm.len, audioPayload, audioSizes)
    if arc != 0:
        echo("FAIL audio encode rc=" + strings.IntToStr(arc))
        return 1
    var packetBytes: int32 = 0
    var asi: int32 = 0
    while asi < audioSizes.len:
        packetBytes = packetBytes + audioSizes[asi]
        asi = asi + 1
    if packetBytes != audioPayload.len:
        echo("FAIL audio payload mismatch")
        return 1
    inp.audioPayload = audioPayload
    inp.audioSizes = audioSizes
    inp.audioSamples = scoreSamples
    let filmPath: str = FilmDir + "/ball_balance.mp4"
    mp4.Mp4Assemble(inp, filmPath)
    var man: str = ""
    man = man + "schema=" + FilmSchema + "\n"
    man = man + "film=BALL BALANCE\n"
    man = man + "frames=" + strings.IntToStr(FilmFrames) + "\n"
    man = man + "fps=24\n"
    man = man + "acts=3\n"
    man = man + "act1=surf frames 0-159 ticks 0-3200 ballMode=off\n"
    man = man + "act2=switch frames 160-239 freeze\n"
    man = man + "act3=stand frames 240-479 ticks 0-4800 ballMode=on\n"
    man = man + "chainCid=" + Fmt"{segB.chainCid}" + "\n"
    man = man + "chainCidAct1=" + Fmt"{segA.chainCid}" + "\n"
    man = man + "factsCid=" + Fmt"{segB.factsCid}" + "\n"
    man = man + "act1DriftEndMm=" + strings.Int64ToStr(segA.driftEndMm) + "\n"
    man = man + "act3DriftCheckMm=" + strings.Int64ToStr(segB.driftCheckMm) + "\n"
    man = man + "act3DriftEndMm=" + strings.Int64ToStr(segB.driftEndMm) + "\n"
    man = man + "rejectedCount=0\n"
    man = man + "audioPackets=" + strings.IntToStr(audioSizes.len) + "\n"
    man = man + "audioSamples=" + strings.IntToStr(scoreSamples) + "\n"
    os.WriteFile(FilmDir + "/manifest.txt", man)
    echo("act1 drift_end_mm=" + strings.Int64ToStr(segA.driftEndMm))
    echo("act3 drift_check_mm=" + strings.Int64ToStr(segB.driftCheckMm)
        + " drift_end_mm=" + strings.Int64ToStr(segB.driftEndMm))
    echo("frames=" + strings.IntToStr(FilmFrames))
    echo("audioPackets=" + strings.IntToStr(audioSizes.len))
    echo("factsCid=" + Fmt"{segB.factsCid}")
    echo("chainCid=" + Fmt"{segB.chainCid}")
    echo("film=" + filmPath)
    echo("PASS ball film")
    return 0
