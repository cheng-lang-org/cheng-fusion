# ball_walk_film (DUCK WALK ON BALL): the 12-second two-track film of the
# tuned ball-walk gait - the machine duck (real parameters, 15 links /
# 14 hinge servos, official MICRODUCK stl meshes) CONTINUOUSLY CAPTURE-
# STEP WALKING on the real FIBA size-7 basketball for the whole runtime.
#
# Physics = the microduck_ball_walk_probe caseW2 episode exactly (same
# 911-seeded direct world3d build, same stack, longer window): the caseFULL
# static stack (torso servo frozen defaults + lever-2 contact silence +
# joint coordination kHip 8 / kAnkle 4 PD kVel 32) + the caseE2 active
# rolling resistance (Crr' = 0.03 while the duck rides upright) + the
# BallWalkTick capture-step coordinator pinned to the SHIPPED adaptive
# tune (BallWalkSetAdaptive with the csg/ball_servo_rigid constants):
#   winTicks = clamp(60 / (1 + |vBall| * BallWalkWindowSpeedK), min, 60)
#   reachM   = clamp(|vBall| * BallWalkReachSpeedK, -cap, +cap) of arc
#     along the roll axis (SIGNED; the shipped kR = -0.10 s is the BRAKE
#     side - the press point sinks down the back flank behind the ball
#     center, growing the rho*W brake lever; positive reach measured to
#     pump the roll) with the window gain shipped at 0 (measured
#     ineffective; the formula stays opt-in).
# Tick order every tick, immediately before the physics step:
# BallServoRigidTick, BallServoCoordTick, BallWalkTick; the E2 resistance
# rides in after the step while upright, the probe contract verbatim.
#
# Film: 288 frames at 24 fps (FrameStep = 24 ticks/frame = 6912 ticks =
# 12.0 s), single act - the walk. Follow camera on the ball (the duck
# rides it), live caption refreshed every 24 frames (1 s): capture-step
# count + system displacement velocity (mm/s, the mass-weighted duck+ball
# CoM speed over the frame step). Opening title card 1.5 s, closing card
# last 2 s. Audio: ScorePcm48k(12 s) AAC.
#
# Pipeline per duck_film: pass 1 serial physics with a strictly numeric
# loop (per-frame body poses + camera + counters buffered in memory; str
# work only after the loop), state/param files, pass 2 frame-parallel
# render workers (state file + param file -> PPM, official meshes), pass
# 3 PPM -> VideoToolbox H.264 + ScorePcm48k(12 s) AAC -> Mp4Assemble
# video+audio + manifest. Gates: zero rejected physics steps, zero
# balance loss (fall = head com z under torso com z) for the whole 6912
# ticks, and proven dynamic gait (capture steps fired). The two walk
# anchor bodies (World3dBodyAnchor, invMass 0) are control points, never
# rendered and never a system mass.
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/constraints3d
import cheng/game/csg/joint_motor
import cheng/game/csg/numerics
import cheng/game/csg/ball_servo_rigid as bsr
import cheng/game/csg/microduck_model as mm
import cheng/game/cinema/camera
import cheng/game/cinema/vtbr
import cheng/game/cinema/mp4
import cheng/game/cinema/aac
import cheng/game/cinema/score
import cheng/game/render/cpu_raster as raster
import cheng/game/render/mesh_render
import cheng/game/render/text
import std/os
import std/strings as strings
import std/rawbytes
import std/math as m
import std/thread

const
    FilmSchema = "cheng.apps.ball_walk_film.v1"
    FilmWidth = 1280
    FilmHeight = 720
    FilmDir = "artifacts/csg_world_video/ball_walk_film"
    FrameStep = 24
    FilmFrames = 288
    TotalTicks = 6912
    TitleFrames = 36
    EndFrames = 48
    CaptionEvery = 24
    # follow camera: position = ball center + offset, look-at = smoothed
    # ball center (the duck_film framing for the real-size pair)
    CamOffX = -1.26
    CamOffY = 1.08
    CamOffZ = 0.72
    CamFocal = 750.0
    CamSmooth = 0.30
    GroundExtent = 80.0
    # spot-check PPMs kept on disk (title frame / mid-walk frame)
    SpotFrameTitle = 2
    SpotFrameWalk = 150
    # real FIBA size-7 basketball: r = 0.121 m, m = 0.62 kg
    BallCenterX = 0.0
    BallCenterY = 0.85
    BallCenterZ = 0.121
    BallRadiusM = 0.121
    BallMassKg = 0.62
    # the duck root pose stands the sole plane on the ball top (the
    # microduck_ball_walk_probe constant verbatim)
    DuckRootZ = 0.275364117885
    ContactSilenceSlackM: float64 = 0.004
    # physics tick rate (Hz)
    PhysicsTickRateHz: float64 = 240.0
    # caseE2 rolling-resistance lever, active while the duck rides upright
    WalkRollCrr: float64 = 0.03
    AngleNeutralTolRad = 0.001
    AnchorGapTolM = 0.001
    # a rejected step rolls back and never advances the tick, so 64
    # straight rejects at one tick is an engine stall (reported as data)
    StallRejectRun = 64
    # 15 duck bodies (slots 0-14) + 1 ball = the rendered population; the
    # two walk anchors (slots 16-17 once spawned) are control points,
    # never rendered
    BodyTotal = 16
    BallSlot = 15
    # -- MICRODUCK official mesh assets (binary STL, meters) --
    MeshPathTrunk = "assets/microduck_meshes/trunk_base.stl"
    MeshPathBearing = "assets/microduck_meshes/bearing_roll.stl"
    MeshPathUpperLeg = "assets/microduck_meshes/upper_leg_left.stl"
    MeshPathFoot = "assets/microduck_meshes/foot_left.stl"
    MeshPathAnkle = "assets/microduck_meshes/ankle_left.stl"
    MeshPathHeadShell = "assets/microduck_meshes/bottom_head_shell.stl"
    MeshPathFace = "assets/microduck_meshes/face_part.stl"
    MeshIdxTrunk = 0
    MeshIdxBearing = 1
    MeshIdxUpperLeg = 2
    MeshIdxFoot = 3
    MeshIdxAnkle = 4
    MeshIdxHeadShell = 5
    MeshIdxFace = 6
    MeshHandleCount = 7
    # -- urdf materials (rgba 0..255) --
    ColorCreamR = 247
    ColorCreamG = 230
    ColorCreamB = 203
    ColorOrangeR = 248
    ColorOrangeG = 78
    ColorOrangeB = 5
    ColorGreyR = 82
    ColorGreyG = 82
    ColorGreyB = 86
    ColorMotorR = 40
    ColorMotorG = 40
    ColorMotorB = 44
    ColorBallR = 224
    ColorBallG = 116
    ColorBallB = 50
    ColorGrooveR = 30
    ColorGrooveG = 26
    ColorGrooveB = 24

# mesh handle table, loaded once in main() before the render workers
# fan out (read-only during pass 2)
var meshHandles: int32[]

type
    FilmData =
        ok: bool
        rejected: int32
        firstRejectTick: int32
        stallTick: int32
        fallTick: int32
        stepsEnd: int32
        sysDriftEndMm: int64
        ballVEndMmS: int64
        avgVelEndMmS: int64
        drift: float64[]
        sysVelMmS: int64[]
        steps: int32[]
        camX: float64[]
        camY: float64[]
        camZ: float64[]
        tgtX: float64[]
        tgtY: float64[]
        tgtZ: float64[]
        # per-frame body snapshot buffers, frame * BodyTotal + bodyIndex
        snapPx: float64[]
        snapPy: float64[]
        snapPz: float64[]
        snapQw: float64[]
        snapQx: float64[]
        snapQy: float64[]
        snapQz: float64[]
        snapR: float64[]
        snapH: float64[]
        # per-frame ball visual attitude (render-layer only)
        snapVqw: float64[]
        snapVqx: float64[]
        snapVqy: float64[]
        snapVqz: float64[]

fn FramePath(frame: int32): str =
    return FilmDir + "/walk_f" + strings.IntToStr(frame) + ".ppm"

fn ParamPath(frame: int32): str =
    return FilmDir + "/param_f" + strings.IntToStr(frame) + ".txt"

fn StatePath(frame: int32): str =
    return FilmDir + "/state_f" + strings.IntToStr(frame) + ".txt"

fn MicronOf(v: float64): int64 =
    if v >= 0.0:
        return int64(v * 1000000.0 + 0.5)
    return int64(v * 1000000.0 - 0.5)

fn MicronToFloat(mcr: int64): float64 =
    return float64(mcr) / 1000000.0

fn MmOf(v: float64): int64 =
    if v >= 0.0:
        return int64(v * 1000.0 + 0.5)
    return int64(v * 1000.0 - 0.5)

fn QuatOf(q: float64): int64 =
    if q >= 0.0:
        return int64(q * 1000000000.0 + 0.5)
    return int64(q * 1000000000.0 - 0.5)

fn QuatToFloat(v: int64): float64 =
    return float64(v) / 1000000000.0

# Load the 7 official meshes into the handle table; any structural
# failure is a startup panic (let-it-crash).
fn LoadMeshes() =
    setLen(meshHandles, MeshHandleCount)
    let hTrunk = mesh_render.MeshStlLoad(MeshPathTrunk)
    let hBearing = mesh_render.MeshStlLoad(MeshPathBearing)
    let hUpperLeg = mesh_render.MeshStlLoad(MeshPathUpperLeg)
    let hFoot = mesh_render.MeshStlLoad(MeshPathFoot)
    let hAnkle = mesh_render.MeshStlLoad(MeshPathAnkle)
    let hShell = mesh_render.MeshStlLoad(MeshPathHeadShell)
    let hFace = mesh_render.MeshStlLoad(MeshPathFace)
    if !mesh_render.MeshValid(hTrunk):
        panic("ball walk film: stl load failed trunk_base")
    if !mesh_render.MeshValid(hBearing):
        panic("ball walk film: stl load failed bearing_roll")
    if !mesh_render.MeshValid(hUpperLeg):
        panic("ball walk film: stl load failed upper_leg_left")
    if !mesh_render.MeshValid(hFoot):
        panic("ball walk film: stl load failed foot_left")
    if !mesh_render.MeshValid(hAnkle):
        panic("ball walk film: stl load failed ankle_left")
    if !mesh_render.MeshValid(hShell):
        panic("ball walk film: stl load failed bottom_head_shell")
    if !mesh_render.MeshValid(hFace):
        panic("ball walk film: stl load failed face_part")
    meshHandles[MeshIdxTrunk] = hTrunk
    meshHandles[MeshIdxBearing] = hBearing
    meshHandles[MeshIdxUpperLeg] = hUpperLeg
    meshHandles[MeshIdxFoot] = hFoot
    meshHandles[MeshIdxAnkle] = hAnkle
    meshHandles[MeshIdxHeadShell] = hShell
    meshHandles[MeshIdxFace] = hFace

# Whitespace-delimited int64 scanner (the duck_film exact shape).
@borrows
fn ScanI64(text: str, pos: var int32): int64 =
    var v: int64 = 0
    var neg: bool = false
    var seen: bool = false
    while pos < text.len:
        let c: int32 = int32(text[pos])
        if c == 45:
            neg = true
            seen = true
            pos = pos + 1
        else:
            if c == 32 || c == 10:
                if seen:
                    pos = pos + 1
                    break
                pos = pos + 1
            else:
                v = v * 10 + int64(c - 48)
                seen = true
                pos = pos + 1
    if neg:
        v = 0 - v
    return v

# One text line from pos (terminator consumed).
@borrows
fn ScanLine(text: str, pos: var int32): str =
    let start: int32 = pos
    while pos < text.len:
        if int32(text[pos]) == 10:
            break
        pos = pos + 1
    let outp: str = strings.sliceBytes(text, start, pos - start)
    if pos < text.len:
        pos = pos + 1
    return outp

# Park the servo command and goal at the measured standing flexion so tick
# 0 commands no step change; returns the measured angle.
fn parkHingeServo(w: var World3d, ci: int32): float64 =
    let th0 = Constraints3dHingeAngle(w, ci)
    w.conCmd[ci] = th0
    w.conGoal[ci] = th0
    return th0

# One MJCF joint -> one hinge servo from the model table (the
# microduck_ball_walk_probe construction, verbatim).
@borrows
fn stanceHinge(w: var World3d, mdl: mm.MicroduckModel, jointIdx: int32, refX: float64, refY: float64, refZ: float64, tauMax: float64, omegaRadS: float64): int32 =
    let jt = mdl.joints[jointIdx]
    let pl = mdl.links[jt.parentLink]
    let cl = mdl.links[jt.childLink]
    var anchAx: float64
    var anchAy: float64
    var anchAz: float64
    mm.MicroduckPointToLocal(pl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, pl.cx, pl.cy, pl.cz, anchAx, anchAy, anchAz)
    var axisAx: float64
    var axisAy: float64
    var axisAz: float64
    mm.MicroduckVecToLocal(pl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisAx, axisAy, axisAz)
    var anchBx: float64
    var anchBy: float64
    var anchBz: float64
    mm.MicroduckPointToLocal(cl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, cl.cx, cl.cy, cl.cz, anchBx, anchBy, anchBz)
    var axisBx: float64
    var axisBy: float64
    var axisBz: float64
    mm.MicroduckVecToLocal(cl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisBx, axisBy, axisBz)
    let ci = world3d.World3dAddHingeJoint(w, jt.parentLink, jt.childLink, world3d.World3dConHingeServo, anchAx, anchAy, anchAz, anchBx, anchBy, anchBz, axisAx, axisAy, axisAz, axisBx, axisBy, axisBz)
    var refAlX: float64
    var refAlY: float64
    var refAlZ: float64
    mm.MicroduckVecToLocal(pl.axisKind, refX, refY, refZ, refAlX, refAlY, refAlZ)
    var refBlX: float64
    var refBlY: float64
    var refBlZ: float64
    mm.MicroduckVecToLocal(cl.axisKind, refX, refY, refZ, refBlX, refBlY, refBlZ)
    world3d.World3dSetHingeRefs(w, ci, refAlX, refAlY, refAlZ, refBlX, refBlY, refBlZ)
    world3d.World3dSetHingeServo(w, ci, tauMax, omegaRadS, jt.minRad, jt.maxRad)
    if constraints3d.Constraints3dJointAnchorGap(w, ci) > AnchorGapTolM:
        panic("ball walk film: hinge pivot gap at " + jt.name)
    return ci

# The four leg pitch hinge-servo constraint indices the coordination
# channel drives.
type
    DuckPitchCons =
        hipL: int32
        hipR: int32
        ankleL: int32
        ankleR: int32

# The full-DoF assembly at root pose (the microduck_ball_walk_probe
# buildDuck, verbatim, echoes stripped).
fn buildDuck(w: var World3d, rootX: float64, rootY: float64, rootZ: float64, cons: var DuckPitchCons) =
    world3d.World3dReset(w, int64(911))
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if mdl.links.len != 15:
        panic("ball walk film: link count")
    if mdl.joints.len != 14:
        panic("ball walk film: joint count")
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > 0.000000001:
        panic("ball walk film: total mass off the MJCF sum")
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, rootX, rootY, rootZ, 0.0)
        let slot = world3d.World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("ball walk film: link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    let tauHip = mm.MicroduckTauMaxHipNm
    let tauKnee = mm.MicroduckTauMaxKneeNm
    let tauAnkle = mm.MicroduckTauMaxAnkleNm
    let tauNeck = mm.MicroduckTauMaxNeckNm
    let ciHipYawL = stanceHinge(w, mdl, mm.MicroduckJointHipYawL, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipRollL = stanceHinge(w, mdl, mm.MicroduckJointHipRollL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciHipPitchL = stanceHinge(w, mdl, mm.MicroduckJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeL = stanceHinge(w, mdl, mm.MicroduckJointKneeL, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleL = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchL, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciHipYawR = stanceHinge(w, mdl, mm.MicroduckJointHipYawR, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipRollR = stanceHinge(w, mdl, mm.MicroduckJointHipRollR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciHipPitchR = stanceHinge(w, mdl, mm.MicroduckJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeR = stanceHinge(w, mdl, mm.MicroduckJointKneeR, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleR = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchR, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciNeck = stanceHinge(w, mdl, mm.MicroduckJointNeckPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadPitch = stanceHinge(w, mdl, mm.MicroduckJointHeadPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadYaw = stanceHinge(w, mdl, mm.MicroduckJointHeadYaw, 0.0, 1.0, 0.0, tauNeck, omegaRadS)
    let ciHeadRoll = stanceHinge(w, mdl, mm.MicroduckJointHeadRoll, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let th = mm.MicroduckStanceHipRad
    parkHingeServo(w, ciHipPitchL)
    parkHingeServo(w, ciHipPitchR)
    parkHingeServo(w, ciKneeL)
    parkHingeServo(w, ciKneeR)
    parkHingeServo(w, ciAnkleL)
    parkHingeServo(w, ciAnkleR)
    parkHingeServo(w, ciNeck)
    parkHingeServo(w, ciHeadPitch)
    parkHingeServo(w, ciHeadYaw)
    parkHingeServo(w, ciHeadRoll)
    parkHingeServo(w, ciHipYawL)
    parkHingeServo(w, ciHipYawR)
    parkHingeServo(w, ciHipRollL)
    parkHingeServo(w, ciHipRollR)
    let thHipL = Constraints3dHingeAngle(w, ciHipPitchL)
    let thHipR = Constraints3dHingeAngle(w, ciHipPitchR)
    let thAnkleL = Constraints3dHingeAngle(w, ciAnkleL)
    let thAnkleR = Constraints3dHingeAngle(w, ciAnkleR)
    cons.hipL = ciHipPitchL
    cons.hipR = ciHipPitchR
    cons.ankleL = ciAnkleL
    cons.ankleR = ciAnkleR
    if numerics.CsgAbs(thHipL - th) > AngleNeutralTolRad:
        panic("ball walk film: hip pitch L th0 off the stance")
    if numerics.CsgAbs(thHipR + th) > AngleNeutralTolRad:
        panic("ball walk film: hip pitch R th0 off the stance")
    if numerics.CsgAbs(thAnkleL + th) > AngleNeutralTolRad:
        panic("ball walk film: ankle L th0 off the stance")
    if numerics.CsgAbs(thAnkleR - th) > AngleNeutralTolRad:
        panic("ball walk film: ankle R th0 off the stance")

# Probe-side equivalent rolling-resistance impulse for one tick (the
# caseE2 engine-faithful form, the probe verbatim). Scalar math only.
fn filmRollResistTick(w: var World3d, ballSlot: int32, crr: float64, excessN: float64, dt: float64) =
    if w.bodyPz[ballSlot] > w.bodyRadius[ballSlot]:
        return
    let mass = 1.0 / w.bodyInvMass[ballSlot]
    let r = w.bodyRadius[ballSlot]
    let vhx = w.bodyVx[ballSlot]
    let vhy = w.bodyVy[ballSlot]
    let vhMag = numerics.CsgSqrt(vhx * vhx + vhy * vhy)
    if vhMag <= 0.0:
        return
    var jr = excessN * crr * dt
    let jrMax = vhMag * mass
    if jr > jrMax:
        jr = jrMax
    let sr = jr / vhMag
    let jrx = (0.0 - vhx) * sr
    let jry = (0.0 - vhy) * sr
    w.bodyVx[ballSlot] = w.bodyVx[ballSlot] + jrx / mass
    w.bodyVy[ballSlot] = w.bodyVy[ballSlot] + jry / mass
    w.bodyAngVy[ballSlot] = w.bodyAngVy[ballSlot] + jrx / (mass * r)
    w.bodyAngVx[ballSlot] = w.bodyAngVx[ballSlot] - jry / (mass * r)

# Rotate one point by a unit quaternion (world <- local).
fn QuatRotatePoint(qw: float64, qx: float64, qy: float64, qz: float64, vx: float64, vy: float64, vz: float64, outX: var float64, outY: var float64, outZ: var float64) =
    let tx = 2.0 * (qy * vz - qz * vy)
    let ty = 2.0 * (qz * vx - qx * vz)
    let tz = 2.0 * (qx * vy - qy * vx)
    outX = vx + qw * tx + (qy * tz - qz * ty)
    outY = vy + qw * ty + (qz * tx - qx * tz)
    outZ = vz + qw * tz + (qx * ty - qy * tx)

# Hamilton product of two unit quaternions (world <- local).
fn QuatMul(aw: float64, ax: float64, ay: float64, az: float64, bw: float64, bx: float64, by: float64, bz: float64, outW: var float64, outX: var float64, outY: var float64, outZ: var float64) =
    outW = aw * bw - ax * bx - ay * by - az * bz
    outX = aw * bx + ax * bw + ay * bz - az * by
    outY = aw * by - ax * bz + ay * bw + az * bx
    outZ = aw * bz + ax * by - ay * bx + az * bw

# Advance the ball's render-layer visual attitude by one frame (the
# duck_film exact shape; physics has no attitude column).
fn BallVisualQuatStep(vqw: var float64, vqx: var float64, vqy: var float64, vqz: var float64, avx: float64, avy: float64, avz: float64, dt: float64) =
    let half: float64 = dt * 0.5
    var dw: float64 = 1.0
    var dx: float64 = avx * half
    var dy: float64 = avy * half
    var dz: float64 = avz * half
    let dn: float64 = numerics.CsgSqrt(dw * dw + dx * dx + dy * dy + dz * dz)
    dw = dw / dn
    dx = dx / dn
    dy = dy / dn
    dz = dz / dn
    let rw: float64 = dw * vqw - dx * vqx - dy * vqy - dz * vqz
    let rx: float64 = dw * vqx + dx * vqw + dy * vqz - dz * vqy
    let ry: float64 = dw * vqy - dx * vqz + dy * vqw + dz * vqx
    let rz: float64 = dw * vqz + dx * vqy - dy * vqx + dz * vqw
    let nn: float64 = numerics.CsgSqrt(rw * rw + rx * rx + ry * ry + rz * rz)
    vqw = rw / nn
    vqx = rx / nn
    vqy = ry / nn
    vqz = rz / nn

# One docked mesh instance (the duck_film exact shape).
@borrows
fn DrawOneMesh(t: raster.RasterTarget,
               cam: camera.CinemaCamera,
               handle: int32,
               px: float64,
               py: float64,
               pz: float64,
               qw: float64,
               qx: float64,
               qy: float64,
               qz: float64,
               cx: float64,
               cy: float64,
               cz: float64,
               thetaRad: float64,
               cr: int32,
               cg: int32,
               cb: int32) =
    var rx: float64
    var ry: float64
    var rz2: float64
    QuatRotatePoint(qw, qx, qy, qz, cx * 0.001, cy * 0.001, cz * 0.001, rx, ry, rz2)
    let halfTheta: float64 = thetaRad * 0.5
    var tw: float64
    var tx: float64
    var ty: float64
    var tz: float64
    QuatMul(qw, qx, qy, qz, m.cosFloat(halfTheta), 0.0, 0.0, m.sinFloat(halfTheta), tw, tx, ty, tz)
    mesh_render.MeshRasterFrameOrient(t, cam, handle, px + rx, py + ry, pz + rz2, 1.0, tw, tx, ty, tz, cr, cg, cb)

# Dark capsule impostor for the meshless links.
@borrows
fn DrawLinkImpostor(t: raster.RasterTarget,
                    cam: camera.CinemaCamera,
                    px: float64,
                    py: float64,
                    pz: float64,
                    qw: float64,
                    qx: float64,
                    qy: float64,
                    qz: float64,
                    r: float64,
                    h: float64) =
    let ax = 2.0 * (qx * qz + qw * qy)
    let ay = 2.0 * (qy * qz - qw * qx)
    let az = 1.0 - 2.0 * (qx * qx + qy * qy)
    let step: float64 = r * 0.6
    let nSteps: int32 = int32(h / step) + 1
    var k: int32 = 0 - nSteps
    while k <= nSteps:
        let t2: float64 = float64(k) * step
        if t2 <= h:
            raster.RasterSphere(t, cam, px - ax * t2, py - ay * t2, pz - az * t2, r, ColorMotorR, ColorMotorG, ColorMotorB)
        k = k + 1

# The official-mesh dock table (the duck_film exact shape, slot map =
# the 15-link full-DoF assembly).
@borrows
fn DrawDuckMeshes(t: raster.RasterTarget,
                  cam: camera.CinemaCamera,
                  px: float64[],
                  py: float64[],
                  pz: float64[],
                  qw: float64[],
                  qx: float64[],
                  qy: float64[],
                  qz: float64[],
                  rad: float64[],
                  vqw: float64,
                  vqx: float64,
                  vqy: float64,
                  vqz: float64) =
    let piRad: float64 = m.Pi
    DrawOneMesh(t, cam, meshHandles[MeshIdxTrunk], px[0], py[0], pz[0], qw[0], qx[0], qy[0], qz[0], 0.0, 22.419, 0.0 - 19.875, piRad, ColorCreamR, ColorCreamG, ColorCreamB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxBearing], px[1], py[1], pz[1], qw[1], qx[1], qy[1], qz[1], 17.500348, 0.0 - 3.214531, 4.430763, piRad, ColorMotorR, ColorMotorG, ColorMotorB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxBearing], px[6], py[6], pz[6], qw[6], qx[6], qy[6], qz[6], 17.499650, 0.0 - 3.214531, 4.430763, piRad, ColorMotorR, ColorMotorG, ColorMotorB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxUpperLeg], px[3], py[3], pz[3], qw[3], qx[3], qy[3], qz[3], 0.0 - 54.995, 22.480, 7.318, 0.0, ColorCreamR, ColorCreamG, ColorCreamB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxUpperLeg], px[8], py[8], pz[8], qw[8], qx[8], qy[8], qz[8], 54.995, 22.480, 7.318, piRad, ColorCreamR, ColorCreamG, ColorCreamB)
    DrawLinkImpostor(t, cam, px[4], py[4], pz[4], qw[4], qx[4], qy[4], qz[4], 0.008, 0.024)
    DrawLinkImpostor(t, cam, px[9], py[9], pz[9], qw[9], qx[9], qy[9], qz[9], 0.008, 0.024)
    DrawOneMesh(t, cam, meshHandles[MeshIdxFoot], px[5], py[5], pz[5], qw[5], qx[5], qy[5], qz[5], 0.0 - 49.021, 15.524, 19.803, 0.0, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxAnkle], px[5], py[5], pz[5], qw[5], qx[5], qy[5], qz[5], 0.0 - 49.021, 15.524, 19.803, 0.0, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxFoot], px[10], py[10], pz[10], qw[10], qx[10], qy[10], qz[10], 49.021, 15.524, 19.803, piRad, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxAnkle], px[10], py[10], pz[10], qw[10], qx[10], qy[10], qz[10], 49.021, 15.524, 19.803, piRad, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawLinkImpostor(t, cam, px[11], py[11], pz[11], qw[11], qx[11], qy[11], qz[11], 0.014, 0.026)
    DrawLinkImpostor(t, cam, px[12], py[12], pz[12], qw[12], qx[12], qy[12], qz[12], 0.006, 0.008)
    DrawLinkImpostor(t, cam, px[13], py[13], pz[13], qw[13], qx[13], qy[13], qz[13], 0.008, 0.010)
    DrawOneMesh(t, cam, meshHandles[MeshIdxHeadShell], px[14], py[14], pz[14], qw[14], qx[14], qy[14], qz[14], 1.454, 0.0 - 14.986, 0.0 - 8.010, piRad, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxFace], px[14], py[14], pz[14], qw[14], qx[14], qy[14], qz[14], 1.546, 0.0 - 15.186, 0.0 - 8.210, piRad, ColorGreyR, ColorGreyG, ColorGreyB)
    raster.RasterBasketball(t, cam, px[BallSlot], py[BallSlot], pz[BallSlot], rad[BallSlot], vqw, vqx, vqy, vqz, ColorBallR, ColorBallG, ColorBallB, ColorGrooveR, ColorGrooveG, ColorGrooveB)

# Pass 1: the caseW2 walk episode, 6912 ticks. Numeric loop only; frames
# buffer into the snapshot memory. On an engine stall the remaining
# frames freeze the last world state (reported as data).
fn RunFilm(): FilmData =
    var outData: FilmData
    outData.ok = false
    outData.rejected = 0
    outData.firstRejectTick = 0 - 1
    outData.stallTick = 0 - 1
    outData.fallTick = 0 - 1
    outData.stepsEnd = 0
    outData.sysDriftEndMm = 0
    outData.ballVEndMmS = 0
    outData.avgVelEndMmS = 0
    setLen(outData.drift, FilmFrames)
    setLen(outData.sysVelMmS, FilmFrames)
    setLen(outData.steps, FilmFrames)
    setLen(outData.camX, FilmFrames)
    setLen(outData.camY, FilmFrames)
    setLen(outData.camZ, FilmFrames)
    setLen(outData.tgtX, FilmFrames)
    setLen(outData.tgtY, FilmFrames)
    setLen(outData.tgtZ, FilmFrames)
    setLen(outData.snapPx, FilmFrames * BodyTotal)
    setLen(outData.snapPy, FilmFrames * BodyTotal)
    setLen(outData.snapPz, FilmFrames * BodyTotal)
    setLen(outData.snapQw, FilmFrames * BodyTotal)
    setLen(outData.snapQx, FilmFrames * BodyTotal)
    setLen(outData.snapQy, FilmFrames * BodyTotal)
    setLen(outData.snapQz, FilmFrames * BodyTotal)
    setLen(outData.snapR, FilmFrames * BodyTotal)
    setLen(outData.snapH, FilmFrames * BodyTotal)
    setLen(outData.snapVqw, FilmFrames)
    setLen(outData.snapVqx, FilmFrames)
    setLen(outData.snapVqy, FilmFrames)
    setLen(outData.snapVqz, FilmFrames)
    var w: world3d.World3d
    var cons: DuckPitchCons
    buildDuck(w, BallCenterX, BallCenterY, DuckRootZ, cons)
    echo("PHASE assembly done bodies=" + strings.IntToStr(w.count))
    if w.count != BodyTotal - 1:
        echo("FAIL assembly body count")
        return outData
    if w.conCount != 14:
        echo("FAIL assembly constraint count")
        return outData
    # execution-side ball injection, the probe window
    let ballSlot = world3d.World3dSpawnBody(w, BallCenterX, BallCenterY, BallCenterZ, BallMassKg, BallRadiusM, world3d.World3dBodyBallRigid)
    if ballSlot != BallSlot:
        echo("FAIL ball slot mismatch")
        return outData
    echo("PHASE ball spawned slot=" + strings.IntToStr(ballSlot))
    let torsoSlot: int32 = mm.MicroduckLinkTorso
    let headSlot: int32 = mm.MicroduckLinkHead
    let footLSlot: int32 = mm.MicroduckLinkFootL
    let footRSlot: int32 = mm.MicroduckLinkFootR
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    let contactDistM: float64 = BallRadiusM + mdl.links[mm.MicroduckLinkFootL].radius + ContactSilenceSlackM
    let carriedLoadN: float64 = mdl.totalMass * physics3d.Physics3dGravity
    let dtTick: float64 = 1.0 / PhysicsTickRateHz
    var st: bsr.BallServoRigidState
    bsr.BallServoRigidStateInit(st, w, ballSlot, torsoSlot, headSlot,
        bsr.BallServoRigidDefaultK, bsr.BallServoRigidDefaultC,
        bsr.BallServoRigidDefaultLinCapMps, bsr.BallServoRigidDefaultLinDampCapMps,
        bsr.BallServoRigidDefaultKAng, bsr.BallServoRigidDefaultCAng,
        bsr.BallServoRigidDefaultAngCapRadS, bsr.BallServoRigidDefaultAngDampCapRadS,
        bsr.BallServoRigidDefaultRampTicks)
    bsr.BallServoRigidSetContactSilence(st, w, footLSlot, footRSlot, contactDistM)
    var cst: bsr.BallServoCoordState
    bsr.BallServoCoordInit(cst, w, ballSlot, 0, ballSlot - 1,
        cons.hipL, cons.hipR, cons.ankleL, cons.ankleR,
        mdl.joints[mm.MicroduckJointHipPitchL].minRad, mdl.joints[mm.MicroduckJointHipPitchL].maxRad,
        mdl.joints[mm.MicroduckJointAnklePitchL].minRad, mdl.joints[mm.MicroduckJointAnklePitchL].maxRad,
        bsr.BallServoCoordDefaultKHip, bsr.BallServoCoordDefaultKAnkle,
        bsr.BallServoCoordErrClampM, bsr.BallServoCoordGoalClampRad)
    bsr.BallServoCoordSetVelGain(cst, bsr.BallServoCoordDefaultKVel)
    var bw: bsr.BallWalkState
    bsr.BallWalkInit(bw, w, ballSlot, footLSlot, footRSlot, 0, ballSlot - 1, contactDistM)
    # the SHIPPED adaptive tune (the caseW2 constants, pinned explicitly)
    bsr.BallWalkSetAdaptive(bw, bsr.BallWalkWindowSpeedK, bsr.BallWalkWindowMinTicks, bsr.BallWalkReachSpeedK, bsr.BallWalkReachMaxM)
    echo("PHASE walk armed adaptive winK=" + strings.Int64ToStr(MmOf(bsr.BallWalkWindowSpeedK)) + " winMin=" + strings.Int64ToStr(MmOf(bsr.BallWalkWindowMinTicks)) + " reachK=" + strings.Int64ToStr(MmOf(bsr.BallWalkReachSpeedK)) + " reachMaxMm=" + strings.Int64ToStr(MmOf(bsr.BallWalkReachMaxM)))
    let ballX0: float64 = w.bodyPx[ballSlot]
    let ballY0: float64 = w.bodyPy[ballSlot]
    # system CoM reference (duck links + ball, the probe convention)
    var mSys0: float64 = 0.0
    var sysX0: float64 = 0.0
    var sysY0: float64 = 0.0
    var csi: int32 = 0
    while csi <= ballSlot:
        let mass: float64 = 1.0 / w.bodyInvMass[csi]
        mSys0 = mSys0 + mass
        sysX0 = sysX0 + mass * w.bodyPx[csi]
        sysY0 = sysY0 + mass * w.bodyPy[csi]
        csi = csi + 1
    # per-frame system CoM position (for the post-loop frame velocity)
    var sysXf: float64[]
    var sysYf: float64[]
    setLen(sysXf, FilmFrames)
    setLen(sysYf, FilmFrames)
    # ball visual attitude, identity at the release pose
    var vqw: float64 = 1.0
    var vqx: float64
    var vqy: float64
    var vqz: float64
    vqx = 0.0
    vqy = 0.0
    vqz = 0.0
    var fCamX: float64
    var fCamY: float64
    var fCamZ: float64
    var fTgtX: float64
    var fTgtY: float64
    var fTgtZ: float64
    var rejected: int32
    rejected = 0
    var firstRejectTick: int32
    firstRejectTick = 0 - 1
    var stallTick: int32
    stallTick = 0 - 1
    var fallTick: int32
    fallTick = 0 - 1
    var rejectRun: int32 = 0
    var frame: int32 = 0
    echo("PHASE servos armed, entering pass1")
    var tick: int32 = 0
    while tick < TotalTicks and stallTick < 0:
        # the caseW2 stack timing: torso servo, coordination, walk, step
        bsr.BallServoRigidTick(st, w)
        bsr.BallServoCoordTick(cst, w, st.armed)
        bsr.BallWalkTick(bw, w, st.armed)
        var r = physics3d.Physics3dStep(w, "film:duckballwalk")
        if r.statusCode != physics3d.Physics3dStatusOk:
            rejected = rejected + 1
            rejectRun = rejectRun + 1
            if firstRejectTick < 0:
                firstRejectTick = tick
            if rejectRun > StallRejectRun:
                stallTick = tick
        else:
            rejectRun = 0
        # caseE2 lever: active while the duck rides upright
        if fallTick < 0:
            filmRollResistTick(w, ballSlot, WalkRollCrr, carriedLoadN, dtTick)
        let dx = w.bodyPx[ballSlot] - ballX0
        let dy = w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        if fallTick < 0:
            if w.bodyPz[headSlot] < w.bodyPz[torsoSlot]:
                fallTick = tick
        if tick % 1200 == 0:
            echo("PHASE pass1 tick=" + strings.IntToStr(tick) + " drift_mm=" + strings.Int64ToStr(int64(drift * 1000.0)) + " steps=" + strings.IntToStr(bw.stepCount))
        if tick % FrameStep == 0:
            # frame capture, inlined (scalar copies only)
            let bx = w.bodyPx[ballSlot]
            let by = w.bodyPy[ballSlot]
            let bz = w.bodyPz[ballSlot]
            BallVisualQuatStep(vqw, vqx, vqy, vqz, w.bodyAngVx[ballSlot], w.bodyAngVy[ballSlot], w.bodyAngVz[ballSlot], float64(FrameStep) / 240.0)
            outData.snapVqw[frame] = vqw
            outData.snapVqx[frame] = vqx
            outData.snapVqy[frame] = vqy
            outData.snapVqz[frame] = vqz
            if frame == 0:
                fTgtX = bx
                fTgtY = by
                fTgtZ = bz
                fCamX = bx + CamOffX
                fCamY = by + CamOffY
                fCamZ = bz + CamOffZ
            else:
                fTgtX = fTgtX + (bx - fTgtX) * CamSmooth
                fTgtY = fTgtY + (by - fTgtY) * CamSmooth
                fTgtZ = fTgtZ + (bz - fTgtZ) * CamSmooth
                fCamX = fCamX + (bx + CamOffX - fCamX) * CamSmooth
                fCamY = fCamY + (by + CamOffY - fCamY) * CamSmooth
                fCamZ = fCamZ + (bz + CamOffZ - fCamZ) * CamSmooth
            outData.drift[frame] = drift
            outData.steps[frame] = bw.stepCount
            # system CoM position this frame
            var mSys: float64 = 0.0
            var sX: float64 = 0.0
            var sY: float64 = 0.0
            var cj: int32 = 0
            while cj <= ballSlot:
                let massS: float64 = 1.0 / w.bodyInvMass[cj]
                mSys = mSys + massS
                sX = sX + massS * w.bodyPx[cj]
                sY = sY + massS * w.bodyPy[cj]
                cj = cj + 1
            sysXf[frame] = sX / mSys
            sysYf[frame] = sY / mSys
            outData.camX[frame] = fCamX
            outData.camY[frame] = fCamY
            outData.camZ[frame] = fCamZ
            outData.tgtX[frame] = fTgtX
            outData.tgtY[frame] = fTgtY
            outData.tgtZ[frame] = fTgtZ
            var bi: int32 = 0
            while bi < BodyTotal:
                let k: int32 = frame * BodyTotal + bi
                outData.snapPx[k] = w.bodyPx[bi]
                outData.snapPy[k] = w.bodyPy[bi]
                outData.snapPz[k] = w.bodyPz[bi]
                outData.snapQw[k] = w.bodyQuatW[bi]
                outData.snapQx[k] = w.bodyQuatX[bi]
                outData.snapQy[k] = w.bodyQuatY[bi]
                outData.snapQz[k] = w.bodyQuatZ[bi]
                outData.snapR[k] = w.bodyRadius[bi]
                outData.snapH[k] = w.bodyCapsuleHalf[bi]
                bi = bi + 1
            frame = frame + 1
        tick = tick + 1
    # stall freeze: the remaining frames hold the last world state
    while frame < FilmFrames:
        let dx = w.bodyPx[ballSlot] - ballX0
        let dy = w.bodyPy[ballSlot] - ballY0
        outData.drift[frame] = numerics.CsgSqrt(dx * dx + dy * dy)
        outData.steps[frame] = bw.stepCount
        sysXf[frame] = sysXf[frame - 1]
        sysYf[frame] = sysYf[frame - 1]
        outData.camX[frame] = fCamX
        outData.camY[frame] = fCamY
        outData.camZ[frame] = fCamZ
        outData.tgtX[frame] = fTgtX
        outData.tgtY[frame] = fTgtY
        outData.tgtZ[frame] = fTgtZ
        var bf: int32 = 0
        while bf < BodyTotal:
            let k: int32 = frame * BodyTotal + bf
            outData.snapPx[k] = w.bodyPx[bf]
            outData.snapPy[k] = w.bodyPy[bf]
            outData.snapPz[k] = w.bodyPz[bf]
            outData.snapQw[k] = w.bodyQuatW[bf]
            outData.snapQx[k] = w.bodyQuatX[bf]
            outData.snapQy[k] = w.bodyQuatY[bf]
            outData.snapQz[k] = w.bodyQuatZ[bf]
            outData.snapR[k] = w.bodyRadius[bf]
            outData.snapH[k] = w.bodyCapsuleHalf[bf]
            bf = bf + 1
        frame = frame + 1
    # frame-interval system velocity (mm/s) over FrameStep ticks
    var fi: int32 = 0
    while fi < FilmFrames:
        if fi == 0:
            outData.sysVelMmS[fi] = 0
        else:
            let vdx: float64 = sysXf[fi] - sysXf[fi - 1]
            let vdy: float64 = sysYf[fi] - sysYf[fi - 1]
            let v: float64 = numerics.CsgSqrt(vdx * vdx + vdy * vdy) * 1000.0 * (240.0 / float64(FrameStep))
            outData.sysVelMmS[fi] = int64(v + 0.5)
        fi = fi + 1
    # avg system velocity over the last 4.8 s (1152 ticks = 48 frames),
    # displacement-based like the probe bar
    let lastStart: int32 = FilmFrames - 48
    let avgVel: float64 = numerics.CsgSqrt((sysXf[FilmFrames - 1] - sysXf[lastStart]) * (sysXf[FilmFrames - 1] - sysXf[lastStart]) + (sysYf[FilmFrames - 1] - sysYf[lastStart]) * (sysYf[FilmFrames - 1] - sysYf[lastStart])) * 1000.0 * (240.0 / float64(FrameStep * 48))
    echo("PHASE pass1 complete driftEnd_mm=" + strings.Int64ToStr(MmOf(outData.drift[FilmFrames - 1])) + " steps=" + strings.IntToStr(bw.stepCount))
    if !world3d.World3dValid(w):
        echo("FAIL world validity")
        return outData
    outData.rejected = rejected
    outData.firstRejectTick = firstRejectTick
    outData.stallTick = stallTick
    outData.fallTick = fallTick
    outData.stepsEnd = bw.stepCount
    outData.sysDriftEndMm = MmOf(outData.drift[FilmFrames - 1])
    let bvx = w.bodyVx[ballSlot]
    let bvy = w.bodyVy[ballSlot]
    outData.ballVEndMmS = MmOf(numerics.CsgSqrt(bvx * bvx + bvy * bvy))
    outData.avgVelEndMmS = int64(avgVel + 0.5)
    outData.ok = true
    return outData

# Per-frame state file from the snapshot memory (the duck_film exact
# shape; ball row carries the four visual-attitude tokens).
@borrows
fn WriteStateFile(data: FilmData, frame: int32) =
    var text: str = ""
    text = text + strings.IntToStr(BodyTotal) + "\n"
    var bi: int32 = 0
    while bi < BodyTotal:
        let k: int32 = frame * BodyTotal + bi
        text = text + strings.Int64ToStr(MmOf(data.snapPx[k]))
        text = text + " " + strings.Int64ToStr(MmOf(data.snapPy[k]))
        text = text + " " + strings.Int64ToStr(MmOf(data.snapPz[k]))
        text = text + " " + strings.Int64ToStr(QuatOf(data.snapQw[k]))
        text = text + " " + strings.Int64ToStr(QuatOf(data.snapQx[k]))
        text = text + " " + strings.Int64ToStr(QuatOf(data.snapQy[k]))
        text = text + " " + strings.Int64ToStr(QuatOf(data.snapQz[k]))
        text = text + " " + strings.Int64ToStr(MmOf(data.snapR[k]))
        text = text + " " + strings.Int64ToStr(MmOf(data.snapH[k]))
        if bi == BallSlot:
            text = text + " " + strings.Int64ToStr(QuatOf(data.snapVqw[frame]))
            text = text + " " + strings.Int64ToStr(QuatOf(data.snapVqx[frame]))
            text = text + " " + strings.Int64ToStr(QuatOf(data.snapVqy[frame]))
            text = text + " " + strings.Int64ToStr(QuatOf(data.snapVqz[frame]))
        text = text + "\n"
        bi = bi + 1
    os.WriteFile(StatePath(frame), text)

# Per-frame camera/caption parameter file (the duck_film 5-line shape).
fn WriteParam(frame: int32,
              camX: float64,
              camY: float64,
              camZ: float64,
              tgtX: float64,
              tgtY: float64,
              tgtZ: float64,
              stateIdx: int32,
              label: str,
              caption: str,
              subcap: str) =
    var ptext: str = ""
    ptext = ptext + strings.Int64ToStr(MicronOf(camX))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(camY))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(camZ))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtX))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtY))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtZ))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(CamFocal))
    ptext = ptext + "\n"
    ptext = ptext + strings.IntToStr(stateIdx) + "\n"
    ptext = ptext + label + "\n"
    ptext = ptext + caption + "\n"
    ptext = ptext + subcap + "\n"
    os.WriteFile(ParamPath(frame), ptext)

# Wide checker ground (the duck_film stage, verbatim).
@borrows
fn GroundWide(t: raster.RasterTarget, cam: camera.CinemaCamera) =
    var py: int32 = 0
    while py < t.height:
        let sv = (float64(t.height) * 0.5 - float64(py) - 0.5) / cam.focalPx
        let dzRow = cam.fz + cam.uz * sv
        if dzRow < -0.0001:
            var px: int32 = 0
            while px < t.width:
                let su = (float64(px) + 0.5 - float64(t.width) * 0.5) / cam.focalPx
                let dx = cam.fx + cam.rx * su
                let dy = cam.fy + cam.ry * su
                let tt = (0.0 - cam.posZ) / dzRow
                if tt > 0.1:
                    let hitX = cam.posX + dx * tt
                    let hitY = cam.posY + dy * tt
                    if hitX > 0.0 - GroundExtent:
                        if hitX < GroundExtent:
                            if hitY > 0.0 - GroundExtent:
                                if hitY < GroundExtent:
                                    let bandX: int32 = int32(m.floorFloat(hitX * 0.5))
                                    let bandY: int32 = int32(m.floorFloat(hitY * 0.5))
                                    var lum = 0.35 + 0.65 * raster.RasterLightZ
                                    if (bandX + bandY) % 2 == 0:
                                        lum = lum * 0.82
                                    raster.RasterPut(t, px, py, tt, int32(90.0 * lum), int32(80.0 * lum), int32(70.0 * lum))
                px = px + 1
        py = py + 1

# Pass 2 worker (the duck_film exact shape).
fn ballWalkRenderWorker(raw: ptr, index: int32, worker: int32): int32 =
    let _raw = raw
    let _worker = worker
    let ptext: str = os.ReadFile(ParamPath(index))
    if ptext.len < 8:
        return 1
    var pos: int32 = 0
    var camv: int64[]
    setLen(camv, 0)
    var fi: int32 = 0
    while fi < 7:
        let v = ScanI64(ptext, pos)
        add(camv, v)
        fi = fi + 1
    let stateIdx: int32 = int32(ScanI64(ptext, pos))
    let label: str = ScanLine(ptext, pos)
    let caption: str = ScanLine(ptext, pos)
    let subcap: str = ScanLine(ptext, pos)
    var cam = camera.CinemaCameraLookAt(
        MicronToFloat(camv[0]), MicronToFloat(camv[1]), MicronToFloat(camv[2]),
        MicronToFloat(camv[3]), MicronToFloat(camv[4]), MicronToFloat(camv[5]),
        MicronToFloat(camv[6]), FilmWidth, FilmHeight)
    let stext: str = os.ReadFile(StatePath(stateIdx))
    if stext.len < 4:
        return 1
    var spos: int32 = 0
    let bc: int32 = int32(ScanI64(stext, spos))
    if bc != BodyTotal:
        return 1
    var px: float64[]
    var py: float64[]
    var pz: float64[]
    var qw: float64[]
    var qx: float64[]
    var qy: float64[]
    var qz: float64[]
    var rad: float64[]
    var bvqw: float64 = 1.0
    var bvqx: float64 = 0.0
    var bvqy: float64 = 0.0
    var bvqz: float64 = 0.0
    setLen(px, BodyTotal)
    setLen(py, BodyTotal)
    setLen(pz, BodyTotal)
    setLen(qw, BodyTotal)
    setLen(qx, BodyTotal)
    setLen(qy, BodyTotal)
    setLen(qz, BodyTotal)
    setLen(rad, BodyTotal)
    var bi: int32 = 0
    while bi < BodyTotal:
        let vx: float64 = float64(ScanI64(stext, spos)) / 1000.0
        let vy: float64 = float64(ScanI64(stext, spos)) / 1000.0
        let vz: float64 = float64(ScanI64(stext, spos)) / 1000.0
        let vqw: float64 = QuatToFloat(ScanI64(stext, spos))
        let vqx: float64 = QuatToFloat(ScanI64(stext, spos))
        let vqy: float64 = QuatToFloat(ScanI64(stext, spos))
        let vqz: float64 = QuatToFloat(ScanI64(stext, spos))
        let vr: float64 = float64(ScanI64(stext, spos)) / 1000.0
        let _vh: float64 = float64(ScanI64(stext, spos)) / 1000.0
        if bi == BallSlot:
            bvqw = QuatToFloat(ScanI64(stext, spos))
            bvqx = QuatToFloat(ScanI64(stext, spos))
            bvqy = QuatToFloat(ScanI64(stext, spos))
            bvqz = QuatToFloat(ScanI64(stext, spos))
        px[bi] = vx
        py[bi] = vy
        pz[bi] = vz
        qw[bi] = vqw
        qx[bi] = vqx
        qy[bi] = vqy
        qz[bi] = vqz
        rad[bi] = vr
        bi = bi + 1
    var t: raster.RasterTarget
    t = raster.RasterMake(FilmWidth, FilmHeight)
    GroundWide(t, cam)
    DrawDuckMeshes(t, cam, px, py, pz, qw, qx, qy, qz, rad, bvqw, bvqx, bvqy, bvqz)
    text.RasterText(t, 40, 40, 2, label, 255, 255, 255)
    let cw: int32 = text.TextPixelWidth(caption, 3)
    text.RasterText(t, (FilmWidth - cw) / 2, FilmHeight - 96, 3, caption, 240, 240, 220)
    if subcap.len > 0:
        let sw: int32 = text.TextPixelWidth(subcap, 2)
        text.RasterText(t, (FilmWidth - sw) / 2, FilmHeight - 48, 2, subcap, 210, 215, 230)
    raster.RasterWritePpm(t, FramePath(index))
    if index == SpotFrameTitle:
        raster.RasterWritePpm(t, FilmDir + "/spot_title.ppm")
    if index == SpotFrameWalk:
        raster.RasterWritePpm(t, FilmDir + "/spot_walk.ppm")
    return 0

fn main(): int32 =
    os.MkdirAll(FilmDir, 493)
    LoadMeshes()
    # ---- pass 1: the caseW2 walk episode ----
    var data = RunFilm()
    if !data.ok:
        echo("FAIL film physics segment (assembly/world/frame buffers)")
        return 1
    # ---- captions (all str work is post-loop) ----
    var f: int32 = 0
    while f < FilmFrames:
        var cap: str
        if f < TitleFrames:
            cap = "PURE CHENG XPBD - CAPTURE-STEP GAIT"
        else:
            if f >= FilmFrames - EndFrames:
                cap = "DUCK WALK ON BALL - PURE CHENG XPBD PHYSICS"
            else:
                let fr: int32 = f - f % CaptionEvery
                cap = "STEPS " + strings.IntToStr(data.steps[fr]) + " / SYS VEL " + strings.IntToStr(int32(data.sysVelMmS[fr])) + " MM/S"
        WriteParam(f, data.camX[f], data.camY[f], data.camZ[f],
            data.tgtX[f], data.tgtY[f], data.tgtZ[f],
            f, "DUCK WALK ON BALL", cap, "SPEED-SCALED BRAKE REACH GAIT / REAL SIZE-7 BALL")
        f = f + 1
    # ---- state files from the snapshot memory ----
    f = 0
    while f < FilmFrames:
        WriteStateFile(data, f)
        f = f + 1
    echo("PHASE snapshots written")
    # ---- pass 2: frame-parallel render ----
    var pool = thread.PoolNew(0)
    thread.ParallelFor(pool, FilmFrames, &ballWalkRenderWorker, nil)
    echo("PHASE pass2 done")
    # ---- pass 3: stream PPM frames -> VideoToolbox -> ball_walk.mp4 ----
    let vctx: ptr = vtbr.VtbrVideoSessionCreate(FilmWidth, FilmHeight)
    if vctx == nil:
        echo("FAIL vt session")
        return 1
    var encodeFail: int32
    encodeFail = 0
    var pixTotal: int32 = FilmWidth * FilmHeight
    f = 0
    while f < FilmFrames:
        let ppm: str = os.ReadFile(FramePath(f))
        if ppm.len < 16 + pixTotal * 3:
            echo("FAIL ppm short frame=" + strings.IntToStr(f))
            return 1
        var b: rawbytes.Bytes = rawbytes.BytesAlloc(pixTotal * 4)
        var pi: int32 = 0
        while pi < pixTotal:
            rawbytes.BytesSet(b, pi * 4, int32(ppm[16 + pi * 3 + 2]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 1, int32(ppm[16 + pi * 3 + 1]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 2, int32(ppm[16 + pi * 3]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 3, int32(255))
            pi = pi + 1
        let erc = vtbr.VtbrVideoEncodeBgra(vctx, rawbytes.BytesDataPtr(b), FilmWidth * 4, FilmWidth, FilmHeight, f * 1000)
        rawbytes.BytesFree(b)
        if erc != 0:
            encodeFail = encodeFail + 1
        if f != SpotFrameTitle:
            if f != SpotFrameWalk:
                let _removed = os.RemoveFile(FramePath(f))
        f = f + 1
    if encodeFail > 0:
        echo("FAIL encode frames n=" + strings.IntToStr(encodeFail))
        return 1
    if vtbr.VtbrVideoFinish(vctx) != 0:
        echo("FAIL video finish")
        return 1
    let _drained = vtbr.VtbrVideoDrain(vctx)
    var videoPayload: uint8[]
    setLen(videoPayload, 0)
    vtbr.VtbrVideoCopyPayload(vctx, videoPayload)
    var videoSizes: int32[]
    setLen(videoSizes, 0)
    vtbr.VtbrVideoCopySizes(vctx, videoSizes)
    var videoKf: int32[]
    setLen(videoKf, 0)
    vtbr.VtbrVideoCopyKeyframes(vctx, videoKf)
    var sps: uint8[]
    setLen(sps, 0)
    var pps: uint8[]
    setLen(pps, 0)
    vtbr.VtbrVideoCopyParamSets(vctx, sps, pps)
    if sps.len == 0 || pps.len == 0:
        echo("FAIL paramsets empty")
        return 1
    if videoSizes.len != FilmFrames:
        echo("FAIL video sample count n=" + strings.IntToStr(videoSizes.len))
        return 1
    var inp: mp4.Mp4Input
    inp.videoSizes = videoSizes
    inp.videoKf = videoKf
    inp.videoPayload = videoPayload
    inp.sps = sps
    inp.pps = pps
    var scorePcm: uint8[]
    setLen(scorePcm, 0)
    let scoreSamples: int32 = score.ScorePcm48k(scorePcm, 12)
    var audioPayload: uint8[]
    setLen(audioPayload, 0)
    var audioSizes: int32[]
    setLen(audioSizes, 0)
    let arc = aac.AacEncodePcm16(scorePcm, scorePcm.len, audioPayload, audioSizes)
    if arc != 0:
        echo("FAIL audio encode rc=" + strings.IntToStr(arc))
        return 1
    var packetBytes: int32 = 0
    var asi: int32 = 0
    while asi < audioSizes.len:
        packetBytes = packetBytes + audioSizes[asi]
        asi = asi + 1
    if packetBytes != audioPayload.len:
        echo("FAIL audio payload mismatch")
        return 1
    inp.audioPayload = audioPayload
    inp.audioSizes = audioSizes
    inp.audioSamples = scoreSamples
    let filmPath: str = FilmDir + "/ball_walk.mp4"
    mp4.Mp4Assemble(inp, filmPath)
    var man: str = ""
    man = man + "schema=" + FilmSchema + "\n"
    man = man + "film=DUCK WALK ON BALL\n"
    man = man + "frames=" + strings.IntToStr(FilmFrames) + "\n"
    man = man + "fps=24\n"
    man = man + "seconds=12\n"
    man = man + "ticks=" + strings.IntToStr(TotalTicks) + "\n"
    man = man + "act=walk frames 0-287 ticks 0-6911 continuous capture-step walking on the free ball\n"
    man = man + "physics=microduck_ball_walk_probe caseW2 episode (seed 911, caseFULL static stack + caseE2 rolling resistance Crr=0.03 upright)\n"
    man = man + "gait=BallWalkTick tuned adaptive (measured sweep winner): reachM=clamp(|vBall|*kR,-cap,+cap) arc along the roll axis, shipped kR=-0.10 s cap=60 mm = BRAKE side (the press point sinks down the back flank behind the ball center); winTicks=clamp(60/(1+|vBall|*kW),min,60) with shipped kW=0 (window shrink measured ineffective, kept opt-in)\n"
    man = man + "gaitWinK_x1000=" + strings.Int64ToStr(MmOf(bsr.BallWalkWindowSpeedK)) + "\n"
    man = man + "gaitWinMinTicks_x1000=" + strings.Int64ToStr(MmOf(bsr.BallWalkWindowMinTicks)) + "\n"
    man = man + "gaitReachK_x1000=" + strings.Int64ToStr(MmOf(bsr.BallWalkReachSpeedK)) + "\n"
    man = man + "gaitReachMaxMm_x1000=" + strings.Int64ToStr(MmOf(bsr.BallWalkReachMaxM)) + "\n"
    man = man + "duck=15 capsule links (full-DoF verbatim MJCF assembly) + 14 hinge servos parked at stance\n"
    man = man + "ball=real FIBA size-7 BallRigid r=0.121 m m=0.62 kg at (0, 0.85, 0.121)\n"
    man = man + "fallTick=" + strings.IntToStr(data.fallTick) + "\n"
    man = man + "captureSteps=" + strings.IntToStr(data.stepsEnd) + "\n"
    man = man + "ballDriftEndMm=" + strings.Int64ToStr(data.sysDriftEndMm) + "\n"
    man = man + "ballVEndMmS=" + strings.Int64ToStr(data.ballVEndMmS) + "\n"
    man = man + "sysVelLast4p8sMmS=" + strings.Int64ToStr(data.avgVelEndMmS) + "\n"
    man = man + "rejectedCount=" + strings.IntToStr(data.rejected) + "\n"
    man = man + "firstRejectTick=" + strings.IntToStr(data.firstRejectTick) + "\n"
    man = man + "stallTick=" + strings.IntToStr(data.stallTick) + "\n"
    man = man + "render=microduck official stl meshes (the duck_film dock table) + RasterBasketball seams on the render-layer visual attitude quaternion\n"
    man = man + "audioPackets=" + strings.IntToStr(audioSizes.len) + "\n"
    man = man + "audioSamples=" + strings.IntToStr(scoreSamples) + "\n"
    os.WriteFile(FilmDir + "/manifest.txt", man)
    # scratch cleanup: state/param files were pass-2 inputs only
    f = 0
    while f < FilmFrames:
        let _rs = os.RemoveFile(StatePath(f))
        let _rp = os.RemoveFile(ParamPath(f))
        f = f + 1
    echo("fallTick=" + strings.IntToStr(data.fallTick) + " captureSteps=" + strings.IntToStr(data.stepsEnd))
    echo("ballDriftEndMm=" + strings.Int64ToStr(data.sysDriftEndMm) + " ballVEndMmS=" + strings.Int64ToStr(data.ballVEndMmS) + " sysVelLast4p8sMmS=" + strings.Int64ToStr(data.avgVelEndMmS))
    echo("rejected=" + strings.IntToStr(data.rejected) + " firstRejectTick=" + strings.IntToStr(data.firstRejectTick) + " stallTick=" + strings.IntToStr(data.stallTick))
    echo("frames=" + strings.IntToStr(FilmFrames))
    echo("audioPackets=" + strings.IntToStr(audioSizes.len))
    echo("film=" + filmPath)
    # gates: zero rejects, no balance loss, proven dynamic gait
    if data.rejected != 0:
        echo("FAIL ball walk film rejected steps at " + strings.IntToStr(data.firstRejectTick))
        return 1
    if data.fallTick >= 0:
        echo("FAIL ball walk film balance lost at tick " + strings.IntToStr(data.fallTick))
        return 1
    if data.stepsEnd == 0:
        echo("FAIL ball walk film gait never fired")
        return 1
    echo("PASS ball walk film")
    return 0
