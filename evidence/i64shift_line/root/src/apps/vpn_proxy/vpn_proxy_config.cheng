import std/os
import std/result
import std/strings as strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/apps/vpn_proxy/vpn_proxy_json as vpnjson

type
    VpnProxyTunConfig =
        enabled: bool
        address: str
        mtu: int32
        routeMode: str
        dnsMode: str
        fakeIpPrefix: str

    VpnProxySecurityConfig =
        authMode: str
        expectedAuthSha256: str
        serverPinSha256: str[]
        clientCertMode: str
        disable0Rtt: bool

    VpnProxyMasqueradeConfig =
        enabled: bool
        host: str
        path: str
        status: int32
        body: str

    VpnProxyAntiBlockConfig =
        masquerade: VpnProxyMasqueradeConfig

    VpnProxyIdentityConfig =
        listen: str
        certDer: str
        certChainDer: str[]
        keyPk8Der: str
        trustRootDer: str
        trustRootsDer: str[]
        expectedAuth: str
        expectedAuthSha256: str
        expectedAuthority: str
        ccRxText: str
        dnsServer: str
        tun: VpnProxyTunConfig

    VpnProxyExitConfig =
        name: str
        transport: str
        host: str
        port: int32
        serverName: str
        authority: str
        auth: str
        ccRx: int32
        weight: int32
        dialerProxy: str

    VpnProxyConfig =
        configPath: str
        configDir: str
        protocol: str
        client: VpnProxyIdentityConfig
        server: VpnProxyIdentityConfig
        exits: VpnProxyExitConfig[]
        security: VpnProxySecurityConfig
        antiBlock: VpnProxyAntiBlockConfig

fn VpnProxyDefaultTunConfig(): VpnProxyTunConfig =
    var out: VpnProxyTunConfig
    out.enabled = false
    out.address = "198.18.0.2"
    out.mtu = 1500
    out.routeMode = "fast"
    out.dnsMode = "fake-ip"
    out.fakeIpPrefix = "198.18.0.0/16"
    return out

fn VpnProxyDefaultSecurityConfig(): VpnProxySecurityConfig =
    var out: VpnProxySecurityConfig
    out.authMode = ""
    out.expectedAuthSha256 = ""
    out.serverPinSha256 = []
    out.clientCertMode = "off"
    out.disable0Rtt = true
    return out

fn VpnProxyDefaultMasqueradeConfig(): VpnProxyMasqueradeConfig =
    var out: VpnProxyMasqueradeConfig
    out.enabled = false
    out.host = ""
    out.path = "/"
    out.status = 200
    out.body = ""
    return out

fn VpnProxyDefaultAntiBlockConfig(): VpnProxyAntiBlockConfig =
    var out: VpnProxyAntiBlockConfig
    out.masquerade = VpnProxyDefaultMasqueradeConfig()
    return out

@borrows
fn VpnProxyJsonRequiredStr(node: vpnjson.JsonNode, key: str): Result[str] =
    if !vpnjson.IsObject(node):
        return Err[str](Fmt"vpn proxy config: missing string field: {key}")
    if !vpnjson.HasKey(node, key):
        return Err[str](Fmt"vpn proxy config: missing string field: {key}")
    let value: vpnjson.JsonNode = vpnjson.JsonGetField(node, key)
    if !vpnjson.IsString(value):
        return Err[str](Fmt"vpn proxy config: missing string field: {key}")
    let text: str = vpnjson.GetStr(value)
    if len(text) <= 0:
        return Err[str](Fmt"vpn proxy config: empty string field: {key}")
    return Ok[str](strings.CloneStr(text))

@borrows
fn VpnProxyJsonOptionalStr(node: vpnjson.JsonNode, key: str): Result[str] =
    if !vpnjson.IsObject(node):
        return Ok[str]("")
    if !vpnjson.HasKey(node, key):
        return Ok[str]("")
    let value: vpnjson.JsonNode = vpnjson.JsonGetField(node, key)
    if !vpnjson.IsString(value):
        return Err[str](Fmt"vpn proxy config: invalid string field: {key}")
    return Ok[str](strings.CloneStr(vpnjson.GetStr(value)))

@borrows
fn VpnProxyJsonRequiredInt(node: vpnjson.JsonNode, key: str): Result[int32] =
    if !vpnjson.IsObject(node):
        return Err[int32](Fmt"vpn proxy config: missing integer field: {key}")
    if !vpnjson.HasKey(node, key):
        return Err[int32](Fmt"vpn proxy config: missing integer field: {key}")
    let value: vpnjson.JsonNode = vpnjson.JsonGetField(node, key)
    if !vpnjson.IsInt(value):
        return Err[int32](Fmt"vpn proxy config: missing integer field: {key}")
    return Ok[int32](int32(vpnjson.GetInt(value)))

@borrows
fn VpnProxyJsonOptionalInt(node: vpnjson.JsonNode, key: str): Result[int32] =
    if !vpnjson.IsObject(node):
        return Ok[int32](0)
    if !vpnjson.HasKey(node, key):
        return Ok[int32](0)
    let value: vpnjson.JsonNode = vpnjson.JsonGetField(node, key)
    if !vpnjson.IsInt(value):
        return Err[int32](Fmt"vpn proxy config: invalid integer field: {key}")
    return Ok[int32](int32(vpnjson.GetInt(value)))

@borrows
fn VpnProxyJsonOptionalBoolInt(node: vpnjson.JsonNode,
                                 key: str,
                                 defaultValue: bool): Result[int32] =
    var defaultInt: int32
    if defaultValue:
        defaultInt = 1
    if !vpnjson.IsObject(node):
        return Ok[int32](defaultInt)
    if !vpnjson.HasKey(node, key):
        return Ok[int32](defaultInt)
    let value: vpnjson.JsonNode = vpnjson.JsonGetField(node, key)
    if !vpnjson.IsBool(value):
        return Err[int32](Fmt"vpn proxy config: invalid bool field: {key}")
    if vpnjson.GetBool(value):
        return Ok[int32](1)
    return Ok[int32](0)

@borrows
fn VpnProxyJsonOptionalStringArray(node: vpnjson.JsonNode, key: str): str[] =
    var out: str[]
    if !vpnjson.IsObject(node):
        return out
    if !vpnjson.HasKey(node, key):
        return out
    let arr: vpnjson.JsonNode = vpnjson.JsonGetField(node, key)
    if !vpnjson.IsArray(arr):
        return out
    for i in 0..<arr.a.len:
        let item: vpnjson.JsonNode = arr.a[i]
        if !vpnjson.IsString(item):
            continue
        let text: str = strutil.Strip(vpnjson.GetStr(item))
        if len(text) > 0:
            add(out, text)
    return out

fn VpnProxyDefaultExitTransport(): str =
    return "udp-quic"

@borrows
fn VpnProxyExitTransportSupported(transport: str): bool =
    if transport == "udp-quic":
        return true
    if transport == "tcp-tls-forward":
        return true
    return false

@borrows
fn VpnProxyParseTunConfig(node: vpnjson.JsonNode): Result[VpnProxyTunConfig] =
    var out: VpnProxyTunConfig = VpnProxyDefaultTunConfig()
    if !vpnjson.IsObject(node):
        return Ok[VpnProxyTunConfig](out)
    if !vpnjson.HasKey(node, "tun"):
        return Ok[VpnProxyTunConfig](out)
    let tunNode: vpnjson.JsonNode = vpnjson.JsonGetField(node, "tun")
    if !vpnjson.IsObject(tunNode):
        return Err[VpnProxyTunConfig]("vpn proxy config: invalid object field: tun")
    let enabledRes: Result[int32] = VpnProxyJsonOptionalBoolInt(tunNode, "enabled", out.enabled)
    if IsErr(enabledRes):
        return Err[VpnProxyTunConfig](ErrorText(enabledRes))
    out.enabled = Value(enabledRes) != 0
    let mtuRes: Result[int32] = VpnProxyJsonOptionalInt(tunNode, "mtu")
    if IsErr(mtuRes):
        return Err[VpnProxyTunConfig](ErrorText(mtuRes))
    if Value(mtuRes) > 0:
        out.mtu = Value(mtuRes)
    if out.mtu < 576 || out.mtu > 9000:
        return Err[VpnProxyTunConfig]("vpn proxy config: invalid tun mtu")
    let addressRes: Result[str] = VpnProxyJsonOptionalStr(tunNode, "address")
    if IsErr(addressRes):
        return Err[VpnProxyTunConfig](ErrorText(addressRes))
    if len(Value(addressRes)) > 0:
        out.address = Value(addressRes)
    if len(out.address) <= 0:
        return Err[VpnProxyTunConfig]("vpn proxy config: invalid tun address")
    let routeModeRes: Result[str] = VpnProxyJsonOptionalStr(tunNode, "route_mode")
    if IsErr(routeModeRes):
        return Err[VpnProxyTunConfig](ErrorText(routeModeRes))
    if len(Value(routeModeRes)) > 0:
        out.routeMode = Value(routeModeRes)
    if out.routeMode != "fast" && out.routeMode != "global":
        return Err[VpnProxyTunConfig]("vpn proxy config: unsupported tun route_mode")
    let dnsModeRes: Result[str] = VpnProxyJsonOptionalStr(tunNode, "dns_mode")
    if IsErr(dnsModeRes):
        return Err[VpnProxyTunConfig](ErrorText(dnsModeRes))
    if len(Value(dnsModeRes)) > 0:
        out.dnsMode = Value(dnsModeRes)
    if out.dnsMode != "fake-ip":
        return Err[VpnProxyTunConfig]("vpn proxy config: unsupported tun dns_mode")
    let fakeIpRes: Result[str] = VpnProxyJsonOptionalStr(tunNode, "fake_ip_prefix")
    if IsErr(fakeIpRes):
        return Err[VpnProxyTunConfig](ErrorText(fakeIpRes))
    if len(Value(fakeIpRes)) > 0:
        out.fakeIpPrefix = Value(fakeIpRes)
    if out.fakeIpPrefix != "198.18.0.0/16":
        return Err[VpnProxyTunConfig]("vpn proxy config: unsupported tun fake_ip_prefix")
    return Ok[VpnProxyTunConfig](out)

@borrows
fn VpnProxyParseSecurityConfig(root: vpnjson.JsonNode): Result[VpnProxySecurityConfig] =
    var out: VpnProxySecurityConfig = VpnProxyDefaultSecurityConfig()
    if !vpnjson.IsObject(root) || !vpnjson.HasKey(root, "security"):
        return Ok[VpnProxySecurityConfig](out)
    let node: vpnjson.JsonNode = vpnjson.JsonGetField(root, "security")
    if !vpnjson.IsObject(node):
        return Err[VpnProxySecurityConfig]("vpn proxy config: invalid object field: security")
    let authModeRes: Result[str] = VpnProxyJsonOptionalStr(node, "auth_mode")
    if IsErr(authModeRes):
        return Err[VpnProxySecurityConfig](ErrorText(authModeRes))
    out.authMode = Value(authModeRes)
    if len(out.authMode) > 0 && out.authMode != "token_sha256":
        let authModeLen: str = IntToStr(len(out.authMode))
        return Err[VpnProxySecurityConfig](Fmt"vpn proxy config: unsupported security auth_mode: {out.authMode} len={authModeLen}")
    let authShaRes: Result[str] = VpnProxyJsonOptionalStr(node, "expected_auth_sha256")
    if IsErr(authShaRes):
        return Err[VpnProxySecurityConfig](ErrorText(authShaRes))
    out.expectedAuthSha256 = Value(authShaRes)
    out.serverPinSha256 = VpnProxyJsonOptionalStringArray(node, "server_pin_sha256")
    let certModeRes: Result[str] = VpnProxyJsonOptionalStr(node, "client_cert_mode")
    if IsErr(certModeRes):
        return Err[VpnProxySecurityConfig](ErrorText(certModeRes))
    if len(Value(certModeRes)) > 0:
        out.clientCertMode = Value(certModeRes)
    if out.clientCertMode != "off" && out.clientCertMode != "required":
        return Err[VpnProxySecurityConfig]("vpn proxy config: unsupported security client_cert_mode")
    let disable0RttRes: Result[int32] = VpnProxyJsonOptionalBoolInt(node, "disable_0rtt", out.disable0Rtt)
    if IsErr(disable0RttRes):
        return Err[VpnProxySecurityConfig](ErrorText(disable0RttRes))
    out.disable0Rtt = Value(disable0RttRes) != 0
    return Ok[VpnProxySecurityConfig](out)

@borrows
fn VpnProxyParseAntiBlockConfig(root: vpnjson.JsonNode): Result[VpnProxyAntiBlockConfig] =
    var out: VpnProxyAntiBlockConfig = VpnProxyDefaultAntiBlockConfig()
    if !vpnjson.IsObject(root) || !vpnjson.HasKey(root, "anti_block"):
        return Ok[VpnProxyAntiBlockConfig](out)
    let node: vpnjson.JsonNode = vpnjson.JsonGetField(root, "anti_block")
    if !vpnjson.IsObject(node):
        return Err[VpnProxyAntiBlockConfig]("vpn proxy config: invalid object field: anti_block")
    if !vpnjson.HasKey(node, "masquerade"):
        return Ok[VpnProxyAntiBlockConfig](out)
    let masqNode: vpnjson.JsonNode = vpnjson.JsonGetField(node, "masquerade")
    if !vpnjson.IsObject(masqNode):
        return Err[VpnProxyAntiBlockConfig]("vpn proxy config: invalid object field: masquerade")
    let enabledRes: Result[int32] = VpnProxyJsonOptionalBoolInt(masqNode, "enabled", out.masquerade.enabled)
    if IsErr(enabledRes):
        return Err[VpnProxyAntiBlockConfig](ErrorText(enabledRes))
    out.masquerade.enabled = Value(enabledRes) != 0
    let hostRes: Result[str] = VpnProxyJsonOptionalStr(masqNode, "host")
    if IsErr(hostRes):
        return Err[VpnProxyAntiBlockConfig](ErrorText(hostRes))
    out.masquerade.host = Value(hostRes)
    let pathRes: Result[str] = VpnProxyJsonOptionalStr(masqNode, "path")
    if IsErr(pathRes):
        return Err[VpnProxyAntiBlockConfig](ErrorText(pathRes))
    if len(Value(pathRes)) > 0:
        out.masquerade.path = Value(pathRes)
    let statusRes: Result[int32] = VpnProxyJsonOptionalInt(masqNode, "status")
    if IsErr(statusRes):
        return Err[VpnProxyAntiBlockConfig](ErrorText(statusRes))
    if Value(statusRes) > 0:
        out.masquerade.status = Value(statusRes)
    if out.masquerade.status < 100 || out.masquerade.status > 599:
        return Err[VpnProxyAntiBlockConfig]("vpn proxy config: invalid masquerade status")
    let bodyRes: Result[str] = VpnProxyJsonOptionalStr(masqNode, "body")
    if IsErr(bodyRes):
        return Err[VpnProxyAntiBlockConfig](ErrorText(bodyRes))
    out.masquerade.body = Value(bodyRes)
    return Ok[VpnProxyAntiBlockConfig](out)

@borrows
fn VpnProxyParseIdentity(node: vpnjson.JsonNode,
                           key: str): Result[VpnProxyIdentityConfig] =
    var empty: VpnProxyIdentityConfig
    empty.tun = VpnProxyDefaultTunConfig()
    if !vpnjson.IsObject(node):
        return Ok[VpnProxyIdentityConfig](empty)
    if !vpnjson.HasKey(node, key):
        return Ok[VpnProxyIdentityConfig](empty)
    let child: vpnjson.JsonNode = vpnjson.JsonGetField(node, key)
    if !vpnjson.IsObject(child):
        return Err[VpnProxyIdentityConfig](Fmt"vpn proxy config: invalid object field: {key}")
    var out: VpnProxyIdentityConfig
    let listenRes: Result[str] = VpnProxyJsonOptionalStr(child, "listen")
    if IsErr(listenRes):
        return Err[VpnProxyIdentityConfig](ErrorText(listenRes))
    out.listen = Value(listenRes)
    let certRes: Result[str] = VpnProxyJsonOptionalStr(child, "cert_der")
    if IsErr(certRes):
        return Err[VpnProxyIdentityConfig](ErrorText(certRes))
    out.certDer = Value(certRes)
    let keyRes: Result[str] = VpnProxyJsonOptionalStr(child, "key_pk8_der")
    if IsErr(keyRes):
        return Err[VpnProxyIdentityConfig](ErrorText(keyRes))
    out.keyPk8Der = Value(keyRes)
    let trustRootRes: Result[str] = VpnProxyJsonOptionalStr(child, "trust_root_der")
    if IsErr(trustRootRes):
        return Err[VpnProxyIdentityConfig](ErrorText(trustRootRes))
    out.trustRootDer = Value(trustRootRes)
    let expectedAuthRes: Result[str] = VpnProxyJsonOptionalStr(child, "expected_auth")
    if IsErr(expectedAuthRes):
        return Err[VpnProxyIdentityConfig](ErrorText(expectedAuthRes))
    out.expectedAuth = Value(expectedAuthRes)
    let expectedAuthorityRes: Result[str] = VpnProxyJsonOptionalStr(child, "expected_authority")
    if IsErr(expectedAuthorityRes):
        return Err[VpnProxyIdentityConfig](ErrorText(expectedAuthorityRes))
    out.expectedAuthority = Value(expectedAuthorityRes)
    let ccRxTextRes: Result[str] = VpnProxyJsonOptionalStr(child, "cc_rx_text")
    if IsErr(ccRxTextRes):
        return Err[VpnProxyIdentityConfig](ErrorText(ccRxTextRes))
    out.ccRxText = Value(ccRxTextRes)
    let dnsServerRes: Result[str] = VpnProxyJsonOptionalStr(child, "dns_server")
    if IsErr(dnsServerRes):
        return Err[VpnProxyIdentityConfig](ErrorText(dnsServerRes))
    out.dnsServer = Value(dnsServerRes)
    let expectedAuthShaRes: Result[str] = VpnProxyJsonOptionalStr(child, "expected_auth_sha256")
    if IsErr(expectedAuthShaRes):
        return Err[VpnProxyIdentityConfig](ErrorText(expectedAuthShaRes))
    out.expectedAuthSha256 = Value(expectedAuthShaRes)
    let tunRes: Result[VpnProxyTunConfig] = VpnProxyParseTunConfig(child)
    if IsErr(tunRes):
        return Err[VpnProxyIdentityConfig](ErrorText(tunRes))
    out.tun = Value(tunRes)
    out.certChainDer = VpnProxyJsonOptionalStringArray(child, "cert_chain_der")
    out.trustRootsDer = VpnProxyJsonOptionalStringArray(child, "trust_roots_der")
    return Ok[VpnProxyIdentityConfig](out)

@borrows
fn VpnProxyFindExitConfigByName(exits: VpnProxyExitConfig[], nameRaw: str): int32 =
    let name: str = strutil.Strip(nameRaw)
    if len(name) <= 0:
        return -1
    for i in 0..<exits.len:
        if exits[i].name == name:
            return i
    return -1

@borrows
fn VpnProxyValidateDialerProxyConfig(exits: VpnProxyExitConfig[]): Result[bool] =
    for i in 0..<exits.len:
        let name: str = strutil.Strip(exits[i].name)
        if len(name) <= 0:
            continue
        for j in i + 1..<exits.len:
            if exits[j].name == name:
                return Err[bool](Fmt"vpn proxy config: duplicate exit name: {name}")
    for i in 0..<exits.len:
        let dialerName: str = strutil.Strip(exits[i].dialerProxy)
        if len(dialerName) <= 0:
            continue
        if exits[i].transport != "tcp-tls-forward":
            return Err[bool]("vpn proxy config: dialer_proxy requires tcp-tls-forward exit")
        let dialerIndex: int32 = VpnProxyFindExitConfigByName(exits, dialerName)
        if dialerIndex < 0:
            return Err[bool](Fmt"vpn proxy config: dialer_proxy target missing: {dialerName}")
        if dialerIndex == i:
            return Err[bool](Fmt"vpn proxy config: dialer_proxy self reference: {dialerName}")
        if exits[dialerIndex].transport != "tcp-tls-forward":
            return Err[bool]("vpn proxy config: dialer_proxy target must be tcp-tls-forward")
        if len(strutil.Strip(exits[dialerIndex].dialerProxy)) > 0:
            return Err[bool]("vpn proxy config: nested dialer_proxy unsupported")
    return Ok[bool](true)

@borrows
fn VpnProxyParseConfigText(configPath: str,
                             configText: str): Result[VpnProxyConfig] =
    let parseRes: vpnjson.ParseResult = vpnjson.ParseJsonSafe(configText)
    if !parseRes.ok:
        return Err[VpnProxyConfig](Fmt"vpn proxy config: {parseRes.error}")
    let root: vpnjson.JsonNode = parseRes.value
    if !vpnjson.IsObject(root):
        return Err[VpnProxyConfig]("vpn proxy config: root must be object")
    var out: VpnProxyConfig
    let parts: os.SplitFileResult = os.SplitFile(configPath)
    out.configPath = configPath
    out.configDir = parts.dir
    let protocolRes: Result[str] = VpnProxyJsonOptionalStr(root, "protocol")
    if IsErr(protocolRes):
        return Err[VpnProxyConfig](ErrorText(protocolRes))
    out.protocol = Value(protocolRes)
    if len(out.protocol) > 0 && out.protocol != "hy2-tun-v1":
        let protocolLen: str = IntToStr(len(out.protocol))
        return Err[VpnProxyConfig](Fmt"vpn proxy config: unsupported protocol: {out.protocol} len={protocolLen}")
    let securityRes: Result[VpnProxySecurityConfig] = VpnProxyParseSecurityConfig(root)
    if IsErr(securityRes):
        return Err[VpnProxyConfig](ErrorText(securityRes))
    out.security = Value(securityRes)
    let antiBlockRes: Result[VpnProxyAntiBlockConfig] = VpnProxyParseAntiBlockConfig(root)
    if IsErr(antiBlockRes):
        return Err[VpnProxyConfig](ErrorText(antiBlockRes))
    out.antiBlock = Value(antiBlockRes)
    let clientRes: Result[VpnProxyIdentityConfig] = VpnProxyParseIdentity(root, "client")
    if IsErr(clientRes):
        return Err[VpnProxyConfig](ErrorText(clientRes))
    out.client = Value(clientRes)
    let serverRes: Result[VpnProxyIdentityConfig] = VpnProxyParseIdentity(root, "server")
    if IsErr(serverRes):
        return Err[VpnProxyConfig](ErrorText(serverRes))
    out.server = Value(serverRes)
    if len(out.server.expectedAuthSha256) <= 0 && len(out.security.expectedAuthSha256) > 0:
        out.server.expectedAuthSha256 = out.security.expectedAuthSha256
    if vpnjson.HasKey(root, "exits"):
        let exitsNode: vpnjson.JsonNode = vpnjson.JsonGetField(root, "exits")
        if !vpnjson.IsArray(exitsNode):
            return Err[VpnProxyConfig]("vpn proxy config: exits must be array")
        for i in 0..<exitsNode.a.len:
            let item: vpnjson.JsonNode = exitsNode.a[i]
            if !vpnjson.IsObject(item):
                return Err[VpnProxyConfig]("vpn proxy config: invalid exits[] entry")
            var entry: VpnProxyExitConfig
            let nameRes: Result[str] = VpnProxyJsonRequiredStr(item, "name")
            if IsErr(nameRes):
                return Err[VpnProxyConfig](ErrorText(nameRes))
            entry.name = Value(nameRes)
            let transportRes: Result[str] = VpnProxyJsonOptionalStr(item, "transport")
            if IsErr(transportRes):
                return Err[VpnProxyConfig](ErrorText(transportRes))
            entry.transport = Value(transportRes)
            if len(entry.transport) <= 0:
                entry.transport = VpnProxyDefaultExitTransport()
            if !VpnProxyExitTransportSupported(entry.transport):
                return Err[VpnProxyConfig](Fmt"vpn proxy config: unsupported exit transport: {entry.transport}")
            let hostRes: Result[str] = VpnProxyJsonRequiredStr(item, "host")
            if IsErr(hostRes):
                return Err[VpnProxyConfig](ErrorText(hostRes))
            entry.host = Value(hostRes)
            let portRes: Result[int32] = VpnProxyJsonRequiredInt(item, "port")
            if IsErr(portRes):
                return Err[VpnProxyConfig](ErrorText(portRes))
            entry.port = Value(portRes)
            let serverNameRes: Result[str] = VpnProxyJsonRequiredStr(item, "server_name")
            if IsErr(serverNameRes):
                return Err[VpnProxyConfig](ErrorText(serverNameRes))
            entry.serverName = Value(serverNameRes)
            let authorityRes: Result[str] = VpnProxyJsonOptionalStr(item, "authority")
            if IsErr(authorityRes):
                return Err[VpnProxyConfig](ErrorText(authorityRes))
            entry.authority = Value(authorityRes)
            let authRes: Result[str] = VpnProxyJsonOptionalStr(item, "auth")
            if IsErr(authRes):
                return Err[VpnProxyConfig](ErrorText(authRes))
            entry.auth = Value(authRes)
            let ccRxRes: Result[int32] = VpnProxyJsonOptionalInt(item, "cc_rx")
            if IsErr(ccRxRes):
                return Err[VpnProxyConfig](ErrorText(ccRxRes))
            entry.ccRx = Value(ccRxRes)
            let weightRes: Result[int32] = VpnProxyJsonOptionalInt(item, "weight")
            if IsErr(weightRes):
                return Err[VpnProxyConfig](ErrorText(weightRes))
            entry.weight = Value(weightRes)
            let dialerProxyRes: Result[str] = VpnProxyJsonOptionalStr(item, "dialer_proxy")
            if IsErr(dialerProxyRes):
                return Err[VpnProxyConfig](ErrorText(dialerProxyRes))
            entry.dialerProxy = strutil.Strip(Value(dialerProxyRes))
            add(out.exits, entry)
    for i in 0..<out.exits.len:
        let entry: VpnProxyExitConfig = out.exits[i]
        if len(entry.name) <= 0 || len(entry.transport) <= 0 || len(entry.host) <= 0 || entry.port <= 0 || len(entry.serverName) <= 0:
            return Err[VpnProxyConfig]("vpn proxy config: invalid exits[] entry")
    let dialerProxyRes: Result[bool] = VpnProxyValidateDialerProxyConfig(out.exits)
    if IsErr(dialerProxyRes):
        return Err[VpnProxyConfig](ErrorText(dialerProxyRes))
    return Ok[VpnProxyConfig](out)

@borrows
fn VpnProxyParseConfigTextForTest(configText: str): Result[VpnProxyConfig] =
    return VpnProxyParseConfigText("/tmp/vpn_proxy_config_test.json", configText)

@borrows
fn VpnProxyLoadConfig(configPathRaw: str): Result[VpnProxyConfig] =
    if len(configPathRaw) <= 0:
        return Err[VpnProxyConfig]("vpn proxy: missing --config")
    let configPath: str = chengpath.PathAbsolute(os.GetCurrentDir(), configPathRaw)
    let configText: str = chengpath.ReadTextFileViaHandle(configPath)
    if len(configText) <= 0:
        let existsText: str = if os.FileExists(configPath): "exists" else: "missing"
        let sizeText: str = Int64ToStr(os.FileSize(configPath))
        return Err[VpnProxyConfig](Fmt"vpn proxy: failed to read config: {configPath} ({existsText}, size={sizeText})")
    let parsedRes: Result[VpnProxyConfig] = VpnProxyParseConfigText(strings.CloneStr(configPath), configText)
    if IsErr(parsedRes):
        return parsedRes
    var out: VpnProxyConfig = Value(parsedRes)
    if len(out.configDir) <= 0:
        out.configDir = chengpath.PathParentDir(configPath)
    return Ok[VpnProxyConfig](out)
