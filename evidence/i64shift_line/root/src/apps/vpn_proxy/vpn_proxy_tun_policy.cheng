import std/strings as strings
import std/rawbytes as rawbytes

const
    VpnProxyTunMtu = 1500
    VpnProxyTunTcpPayloadChunkBytes = 1200
    VpnProxyTunMaxTcpSessions = 2048
    VpnProxyTunMaxServerRetransmitSegments = 16
    VpnProxyTunMaxServerRetransmitBytes = 32768
    VpnProxyTunConnectTimeoutMs = 3000
    VpnProxyTunSendWaitTimeoutMs = 3000
    VpnProxyTunSocketReadIdleTimeoutMs = 0
    VpnProxyTunHotPathLogLimit = 80
    VpnProxyTunFakeDnsHost = "198.18.0.1"
    VpnProxyTunFakeIpPrefix = "198.18."
    VpnProxyTunRouteModeFast = 1
    VpnProxyTunRouteModeGlobal = 2
    VpnProxyTunTransportDirect = 0
    VpnProxyTunTransportProxy = 1
    VpnProxyTunTransportDirectSs = 2
    VpnProxyTunUdpForward = 0
    VpnProxyTunUdpDrop = 1
    VpnProxyTunUdpReject = 2
    VpnProxyTunRuleDomain = 1
    VpnProxyTunRuleDomainSuffix = 2
    VpnProxyTunRuleDomainKeyword = 3
    VpnProxyTunRuleTargetDirect = 0
    VpnProxyTunRuleTargetProxy = 1
    VpnProxyTunRuleTargetReject = 2

// Built inside a function (not a module-level initializer): the cold backend's
// JNI .so has a null .init_array, so a module-level `let str[] = [...]` lands as
// a zero-size symbol that is never populated at load — which silently emptied the
// fake-domain rule table on mobile (every listed domain fell through to direct,
// and direct to a blocked IP times out). A function body runs at call time, so the
// array is constructed correctly here and cached once by VpnProxyTunFakeDomainSuffixes().
fn VpnProxyTunFakeDomainSuffixPackedA(): str =
    return "1e100.net|admob.com|ampproject.org|android.com|anthropic.com|appspot.com|archive.org|bbc.co.uk|bbc.com|blogger.com|blogspot.com|bloomberg.com|cdninstagram.com|chatgpt.com|chromium.org|claude.ai|cnn.com|discord.com"
fn VpnProxyTunFakeDomainSuffixPackedB(): str =
    return "discord.gg|discordapp.com|discordapp.net|doubleclick.net|dropbox.com|dropboxusercontent.com|dw.com|economist.com|facebook.com|facebook.net|fb.com|fb.me|fbcdn.net|fbsbx.com|firebaseapp.com|firebaseio.com|ft.com"
fn VpnProxyTunFakeDomainSuffixPackedC(): str =
    return "ftchinese.com|g.co|gcr.io|ggpht.com|githubusercontent.com|gmail.com|gmodules.com|goo.gl|google-analytics.com|google.ca|google.cn|google.co.in|google.co.jp|google.co.uk|google.com|google.com.au|google.com.br|google.com.hk"
fn VpnProxyTunFakeDomainSuffixPackedD(): str =
    return "google.com.mx|google.com.sg|google.com.tw|google.de|google.es|google.fr|google.it|google.nl|google.org|google.ru|googleadservices.com|googleapis.cn|googleapis.com|googleblog.com|googlemail.com|googlesource.com"
fn VpnProxyTunFakeDomainSuffixPackedE(): str =
    return "googlesyndication.com|googletagmanager.com|googletagservices.com|googleusercontent.com|googlevideo.com|gstatic.com|gvt1.com|gvt2.com|gvt3.com|hf.co|huggingface.co|instagram.com|line-apps.com|line-scdn.net|line.me"
fn VpnProxyTunFakeDomainSuffixPackedF(): str =
    return "medium.com|messenger.com|nyt.com|nytimes.com|oaistatic.com|oaiusercontent.com|openai.com|perplexity.ai|pinimg.com|pinterest.com|quora.com|quoracdn.net|recaptcha.net|redd.it|reddit.com|redditmedia.com|redditstatic.com"
fn VpnProxyTunFakeDomainSuffixPackedG(): str =
    return "reuters.com|rfa.org|signal.org|sndcdn.com|soundcloud.com|t.co|t.me|tdesktop.com|telegram.dog|telegram.me|telegram.org|telesco.pe|theguardian.com|threads.net|ttvnw.net|tumblr.com|twimg.com|twitch.tv|twitter.com|twttr.com"
fn VpnProxyTunFakeDomainSuffixPackedH(): str =
    return "vimeo.com|vimeocdn.com|voanews.com|whatsapp.com|whatsapp.net|wikidata.org|wikimedia.org|wikipedia.org|wiktionary.org|withgoogle.com|wordpress.com|wsj.com|x.ai|x.com|youtu.be|youtube-nocookie.com|youtube.com|ytimg.com"
fn VpnProxyTunFakeDomainSuffixPackedI(): str =
    return "httpdns-browser.platform.dbankcloud.cn|dbankcloud.cn|hicloud.com"

# Suffix decision rebuilt on std string primitives only (strContains /
# SliceBytes / concat). The earlier hand-rolled indexed scan returned false
# on arm64-android while the identical logic passed offline, so every table
# domain silently fell through to direct resolution.
#
# Equivalence: query domain D matches table entry S iff S == D or D ends
# with "." + S. Enumerating the trailing label sequences of D (whole name,
# then successively dropping leading labels) covers both forms. Each tail is
# probed as an exact "|"-delimited member of every packed chunk via one std
# strContains call, so no custom long-str indexing survives here. DNS names
# reaching this path are lowercase on Android (netd normalizes); the table
# is lowercase.
# Scalar fold helper still used by the IP-rule prefix/fold matchers below.
# str 的 text[idx] 索引在 aarch64 cold codegen 下随全量重编发生过确定性失配
# (09-16 真机实证: 白名单全落 direct → GFW 投毒应答, 同一二进制模拟器正常)。
# 所有逐字符访问统一走 StrDataPtr+BytesGet 视图原语——TUN 数据面同一原语
# (IP/TCP/TLS 解析)已大规模验证稳定。
@borrows
fn VpnProxyTunStrByteAt(text: str, idx: int32): int32 =
    var view: rawbytes.Bytes
    view.data = StrDataPtr(text)
    view.len = len(text)
    return rawbytes.BytesGet(view, idx)

@borrows
fn VpnProxyTunLowerAsciiChar(ch: char): char =
    if ch >= 'A' && ch <= 'Z':
        return Char(Int32(ch) + 32)
    return ch

fn VpnProxyTunFoldLowerI(v: int32): int32 =
    if v >= 65 && v <= 90:
        return v + 32
    return v

@borrows
fn VpnProxyTunCharCodeAt(text: str, idx: int32): int32 =
    return VpnProxyTunStrByteAt(text, idx)

# Delimiter-aware suffix membership. The packed literal holds entries joined
# by '|'; the domain matches when it ENDS with an entry exactly at a label
# boundary (entry == domain, or the char before the matched span is '.').
#
# Single forward scan over the chunk comparing backwards from the domain end.
# No SliceBytes tails, no per-label re-scan of the domain, no concatenation,
# no strContains, no transient managed storage -- the previous tail-slicing
# shape diverged on arm64-android (deterministic per-domain misses that the
# same algorithm passes in a reference interpreter), so the hot path now only
# indexes two plain str locals with bounded offsets.
@borrows
fn VpnProxyTunChunkHasSuffixEntry(packed: str, domain: str): bool =
    let pLen: int32 = len(packed)
    let dLen: int32 = len(domain)
    if pLen <= 0 || dLen <= 0:
        return false
    var segStart: int32
    var i: int32
    while i <= pLen:
        var segEnd: int32 = -1
        if i == pLen:
            segEnd = i
        elif VpnProxyTunCharCodeAt(packed, i) == 124:
            segEnd = i
        if segEnd >= 0:
            let eLen: int32 = segEnd - segStart
            if eLen > 0 && eLen <= dLen:
                var j: int32
                while j < eLen && VpnProxyTunCharCodeAt(packed, segStart + j) == VpnProxyTunFoldLowerI(VpnProxyTunCharCodeAt(domain, dLen - eLen + j)):
                    j = j + 1
                if j == eLen:
                    if eLen == dLen:
                        return true
                    if VpnProxyTunCharCodeAt(domain, dLen - eLen - 1) == 46:
                        return true
            segStart = i + 1
        i = i + 1
    return false

var g_vpnProxyTunSelfTestH: bool

fn VpnProxyTunRunSelfTestH(): bool =
    g_vpnProxyTunSelfTestH = VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedH(), "www.youtube.com")
    return g_vpnProxyTunSelfTestH

var g_vpnProxyTunLastMatchChunk: int32

fn VpnProxyTunLastMatchChunk(): int32 =
    return g_vpnProxyTunLastMatchChunk

@borrows
fn VpnProxyTunShouldFakeDomain(domain: str): bool =
    let dLen: int32 = len(domain)
    g_vpnProxyTunLastMatchChunk = -1
    if dLen <= 0:
        return false
    g_vpnProxyTunLastMatchChunk = 0
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedA(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = 1
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedB(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = 2
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedC(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = 3
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedD(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = 4
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedE(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = 5
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedF(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = 6
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedG(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = 7
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedH(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = 8
    if VpnProxyTunChunkHasSuffixEntry(VpnProxyTunFakeDomainSuffixPackedI(), domain):
        return true
    g_vpnProxyTunLastMatchChunk = -2
    return false


@borrows
fn VpnProxyTunIsFakeIp(ipText: str): bool =
    if len(ipText) < 7:
        return false
    if VpnProxyTunStrByteAt(ipText, 0) != 49:
        return false
    if VpnProxyTunStrByteAt(ipText, 1) != 57:
        return false
    if VpnProxyTunStrByteAt(ipText, 2) != 56:
        return false
    if VpnProxyTunStrByteAt(ipText, 3) != 46:
        return false
    if VpnProxyTunStrByteAt(ipText, 4) != 49:
        return false
    if VpnProxyTunStrByteAt(ipText, 5) != 56:
        return false
    if VpnProxyTunStrByteAt(ipText, 6) != 46:
        return false
    return true

@borrows
fn VpnProxyTunStartsWithText(valueRaw: str, prefixRaw: str): bool =
    if len(valueRaw) < len(prefixRaw):
        return false
    return VpnProxyTunRegionEqualsAsciiFold(valueRaw, 0, prefixRaw)

@borrows
fn VpnProxyTunRegionEqualsAsciiFold(value: str, start: int32, suffix: str): bool =
    if start < 0:
        return false
    if start + len(suffix) > len(value):
        return false
    for i in 0..<len(suffix):
        if VpnProxyTunLowerAsciiChar(Char(VpnProxyTunStrByteAt(value, start + i))) != VpnProxyTunLowerAsciiChar(Char(VpnProxyTunStrByteAt(suffix, i))):
            return false
    return true

@borrows
fn VpnProxyTunShouldProxyIpDirectly(ipText: str): bool =
    if VpnProxyTunStartsWithText(ipText, "216.239."):
        return true
    if VpnProxyTunStartsWithText(ipText, "142.250."):
        return true
    if VpnProxyTunStartsWithText(ipText, "142.251."):
        return true
    if VpnProxyTunStartsWithText(ipText, "172.217."):
        return true
    if VpnProxyTunStartsWithText(ipText, "172.253."):
        return true
    if VpnProxyTunStartsWithText(ipText, "74.125."):
        return true
    if VpnProxyTunStartsWithText(ipText, "64.233."):
        return true
    if VpnProxyTunStartsWithText(ipText, "108.177."):
        return true
    if VpnProxyTunStartsWithText(ipText, "173.194."):
        return true
    if VpnProxyTunStartsWithText(ipText, "209.85."):
        return true
    if VpnProxyTunStartsWithText(ipText, "91.108."):
        return true
    if VpnProxyTunStartsWithText(ipText, "149.154."):
        return true
    return false

@borrows
fn VpnProxyTunTransportForTarget(ipText: str, fakeDomain: str): int32 =
    if len(fakeDomain) > 0:
        return VpnProxyTunTransportDirectSs
    if VpnProxyTunIsFakeIp(ipText):
        return VpnProxyTunTransportDirectSs
    if VpnProxyTunShouldProxyIpDirectly(ipText):
        return VpnProxyTunTransportDirectSs
    return VpnProxyTunTransportDirect

@borrows
fn VpnProxyTunRouteModeForText(routeMode: str): int32 =
    if routeMode == "global":
        return VpnProxyTunRouteModeGlobal
    return VpnProxyTunRouteModeFast

@borrows
fn VpnProxyTunTransportForTargetMode(ipText: str, fakeDomain: str, routeMode: int32): int32 =
    if routeMode == VpnProxyTunRouteModeGlobal:
        return VpnProxyTunTransportDirectSs
    return VpnProxyTunTransportForTarget(ipText, fakeDomain)

@borrows
fn VpnProxyTunUdpActionForTarget(ipText: str, port: int32): int32 =
    if port == 443 && (VpnProxyTunIsFakeIp(ipText) || VpnProxyTunShouldProxyIpDirectly(ipText)):
        return VpnProxyTunUdpDrop
    return VpnProxyTunUdpForward

fn VpnProxyTunTcpChunkBytes(mtu: int32): int32 =
    var maxPayload: int32
    if mtu <= 0:
        maxPayload = VpnProxyTunTcpPayloadChunkBytes
    else:
        maxPayload = mtu - 100
    if maxPayload < 512:
        return 512
    if maxPayload > VpnProxyTunTcpPayloadChunkBytes:
        return VpnProxyTunTcpPayloadChunkBytes
    return maxPayload

fn VpnProxyTunSessionLimit(): int32 =
    return VpnProxyTunMaxTcpSessions

fn VpnProxyTunMaxRetransmitSegments(): int32 =
    return VpnProxyTunMaxServerRetransmitSegments

fn VpnProxyTunMaxRetransmitBytes(): int32 =
    return VpnProxyTunMaxServerRetransmitBytes

fn VpnProxyTunReadIdleTimeoutMs(): int32 =
    return VpnProxyTunSocketReadIdleTimeoutMs

fn VpnProxyTunShouldClearConnectedReadTimeout(): bool =
    return VpnProxyTunSocketReadIdleTimeoutMs == 0

fn VpnProxyTunShouldLogHotPath(currentCount: int64): bool =
    return currentCount < Int64(VpnProxyTunHotPathLogLimit)

fn VpnProxyTunRouteMode(): int32 =
    return VpnProxyTunRouteModeFast
