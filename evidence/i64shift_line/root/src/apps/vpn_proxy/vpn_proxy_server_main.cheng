import std/os as os
import cheng/apps/vpn_proxy/vpn_proxy_main as vpnproxy

fn VpnProxyServerToolRoot(): str =
    let envRoot: str = os.GetEnv("CHENG_ROOT")
    if len(envRoot) > 0:
        return envRoot
    return os.GetCurrentDir()

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    let rootDir: str = VpnProxyServerToolRoot()
    let configEnv: str = os.GetEnvDefault("CHENG_VPN_PROXY_CONFIG", "")
    var configPath: str = configEnv
    if len(configPath) <= 0:
        configPath = rootDir + "/artifacts/vpn-proxy-local/server.json"
    let readyEnv: str = os.GetEnvDefault("CHENG_VPN_PROXY_READY", "")
    var args: str[]
    add(args, "--config:" + configPath)
    if len(readyEnv) > 0:
        add(args, "--ready-path:" + readyEnv)
    return vpnproxy.VpnProxyExit(rootDir, args)
