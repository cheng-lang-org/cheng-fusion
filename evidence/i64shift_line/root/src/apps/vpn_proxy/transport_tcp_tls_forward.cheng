import std/result
import std/rawbytes
import std/rawmem_support
import std/crypto/sha256
import std/strings
import std/strutils as strutil

type
    VpnProxyTcpTlsForwardFrame =
        frameType: int32
        flags: int32
        streamId: int32
        payload: Bytes

const
    VpnProxyTcpTlsForwardHeaderLen = 16
    VpnProxyTcpTlsForwardMaxPayloadLen = 1048576
    VpnProxyTcpTlsForwardTypeAuth = 1
    VpnProxyTcpTlsForwardTypeOpen = 2
    VpnProxyTcpTlsForwardTypeData = 3
    VpnProxyTcpTlsForwardTypeClose = 4
    VpnProxyTcpTlsForwardTypeProbe = 5
    VpnProxyTcpTlsForwardTypeProbeOk = 6
    VpnProxyTcpTlsForwardTypeOpenOk = 7
    VpnProxyTcpTlsForwardTypeOpenError = 8
    # [keepalive] PING=停靠热连接保活/验活, 服务器回 PingOk 后继续停靠;
    # 与 PROBE(排水=回 ProbeOk 后双方关连接)语义严格区分。
    VpnProxyTcpTlsForwardTypePing = 9
    VpnProxyTcpTlsForwardTypePingOk = 10

fn tcpTlsHexNibble(value: int32): str =
    let text: str = "0123456789abcdef"
    return strings.SliceBytes(text, value & 15, 1)

@borrows
fn tcpTlsBytesHexLower(data: Bytes): str =
    var parts: str[]
    for i in 0..<data.len:
        let b: int32 = BytesGet(data, i) & 255
        add(parts, tcpTlsHexNibble((b >> 4) & 15))
        add(parts, tcpTlsHexNibble(b & 15))
    return strutil.Join(parts, "")

@borrows
fn tcpTlsConstantTimeAsciiEq(left: str, right: str): bool =
    var maxLen: int32 = len(left)
    if len(right) > maxLen:
        maxLen = len(right)
    var diff: int32 = len(left) ^ len(right)
    for i in 0..<maxLen:
        var leftByte: int32
        var rightByte: int32
        if i < len(left):
            leftByte = int32(left[i]) & 255
        if i < len(right):
            rightByte = int32(right[i]) & 255
        diff = diff | (leftByte ^ rightByte)
    return diff == 0

@borrows
fn tcpTlsReadU32(data: Bytes, offset: int32): int32 =
    var value: int32
    value = (BytesGet(data, offset) & 255) << 24
    value = value | ((BytesGet(data, offset + 1) & 255) << 16)
    value = value | ((BytesGet(data, offset + 2) & 255) << 8)
    value = value | (BytesGet(data, offset + 3) & 255)
    return value

fn tcpTlsFrameTypeValidCode(frameType: int32): int32 =
    if frameType == VpnProxyTcpTlsForwardTypeAuth:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypeOpen:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypeData:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypeClose:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypeProbe:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypeProbeOk:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypeOpenOk:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypeOpenError:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypePing:
        return 1
    if frameType == VpnProxyTcpTlsForwardTypePingOk:
        return 1
    return 0

fn tcpTlsFrameTypeValid(frameType: int32): bool =
    return tcpTlsFrameTypeValidCode(frameType) == 1

fn VpnProxyTcpTlsForwardFrameKindAuth(): int32 =
    return VpnProxyTcpTlsForwardTypeAuth

fn VpnProxyTcpTlsForwardFrameKindOpen(): int32 =
    return VpnProxyTcpTlsForwardTypeOpen

fn VpnProxyTcpTlsForwardFrameKindData(): int32 =
    return VpnProxyTcpTlsForwardTypeData

fn VpnProxyTcpTlsForwardFrameKindClose(): int32 =
    return VpnProxyTcpTlsForwardTypeClose

fn VpnProxyTcpTlsForwardFrameKindProbe(): int32 =
    return VpnProxyTcpTlsForwardTypeProbe

fn VpnProxyTcpTlsForwardFrameKindProbeOk(): int32 =
    return VpnProxyTcpTlsForwardTypeProbeOk

fn VpnProxyTcpTlsForwardFrameKindOpenOk(): int32 =
    return VpnProxyTcpTlsForwardTypeOpenOk

fn VpnProxyTcpTlsForwardFrameKindOpenError(): int32 =
    return VpnProxyTcpTlsForwardTypeOpenError

fn VpnProxyTcpTlsForwardFrameKindPing(): int32 =
    return VpnProxyTcpTlsForwardTypePing

fn VpnProxyTcpTlsForwardFrameKindPingOk(): int32 =
    return VpnProxyTcpTlsForwardTypePingOk

fn VpnProxyTcpTlsForwardHeaderBytes(): int32 =
    return VpnProxyTcpTlsForwardHeaderLen

@borrows
fn tcpTlsForwardMakeFrame(frameType: int32,
                          flags: int32,
                          streamId: int32,
                          payload: Bytes): Bytes =
    let payloadLen: int32 = payload.len
    let outLen: int32 = VpnProxyTcpTlsForwardHeaderLen + payloadLen
    var wire: Bytes = BytesAlloc(outLen)
    BytesSet(wire, 0, 67)
    BytesSet(wire, 1, 84)
    BytesSet(wire, 2, 70)
    BytesSet(wire, 3, 49)
    BytesSet(wire, 4, 1)
    BytesSet(wire, 5, frameType & 255)
    BytesSet(wire, 6, flags & 255)
    BytesSet(wire, 7, 0)
    BytesSet(wire, 8, (streamId >> 24) & 255)
    BytesSet(wire, 9, (streamId >> 16) & 255)
    BytesSet(wire, 10, (streamId >> 8) & 255)
    BytesSet(wire, 11, streamId & 255)
    BytesSet(wire, 12, (payloadLen >> 24) & 255)
    BytesSet(wire, 13, (payloadLen >> 16) & 255)
    BytesSet(wire, 14, (payloadLen >> 8) & 255)
    BytesSet(wire, 15, payloadLen & 255)
    if payloadLen > 0:
        rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(wire.data, VpnProxyTcpTlsForwardHeaderLen),
                                  payload.data,
                                  payloadLen)
    return wire

@borrows
fn tcpTlsForwardMakeTextFrame(frameType: int32,
                              flags: int32,
                              streamId: int32,
                              text: str): Bytes =
    let payloadLen: int32 = len(text)
    let outLen: int32 = VpnProxyTcpTlsForwardHeaderLen + payloadLen
    var wire: Bytes = BytesAlloc(outLen)
    BytesSet(wire, 0, 67)
    BytesSet(wire, 1, 84)
    BytesSet(wire, 2, 70)
    BytesSet(wire, 3, 49)
    BytesSet(wire, 4, 1)
    BytesSet(wire, 5, frameType & 255)
    BytesSet(wire, 6, flags & 255)
    BytesSet(wire, 7, 0)
    BytesSet(wire, 8, (streamId >> 24) & 255)
    BytesSet(wire, 9, (streamId >> 16) & 255)
    BytesSet(wire, 10, (streamId >> 8) & 255)
    BytesSet(wire, 11, streamId & 255)
    BytesSet(wire, 12, (payloadLen >> 24) & 255)
    BytesSet(wire, 13, (payloadLen >> 16) & 255)
    BytesSet(wire, 14, (payloadLen >> 8) & 255)
    BytesSet(wire, 15, payloadLen & 255)
    if payloadLen > 0:
        rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(wire.data, VpnProxyTcpTlsForwardHeaderLen),
                                  StrDataPtr(text),
                                  payloadLen)
    return wire

@borrows
fn tcpTlsForwardFillTextFrame(frameType: int32,
                              flags: int32,
                              streamId: int32,
                              text: str,
                              out: var Bytes) =
    let payloadLen: int32 = len(text)
    let outLen: int32 = VpnProxyTcpTlsForwardHeaderLen + payloadLen
    var wire: Bytes = BytesAlloc(outLen)
    BytesSet(wire, 0, 67)
    BytesSet(wire, 1, 84)
    BytesSet(wire, 2, 70)
    BytesSet(wire, 3, 49)
    BytesSet(wire, 4, 1)
    BytesSet(wire, 5, frameType & 255)
    BytesSet(wire, 6, flags & 255)
    BytesSet(wire, 7, 0)
    BytesSet(wire, 8, (streamId >> 24) & 255)
    BytesSet(wire, 9, (streamId >> 16) & 255)
    BytesSet(wire, 10, (streamId >> 8) & 255)
    BytesSet(wire, 11, streamId & 255)
    BytesSet(wire, 12, (payloadLen >> 24) & 255)
    BytesSet(wire, 13, (payloadLen >> 16) & 255)
    BytesSet(wire, 14, (payloadLen >> 8) & 255)
    BytesSet(wire, 15, payloadLen & 255)
    if payloadLen > 0:
        rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(wire.data, VpnProxyTcpTlsForwardHeaderLen),
                                  StrDataPtr(text),
                                  payloadLen)
    out = wire

fn tcpTlsForwardMakeEmptyFrame(frameType: int32,
                               flags: int32,
                               streamId: int32): Bytes =
    let outLen: int32 = VpnProxyTcpTlsForwardHeaderLen
    var wire: Bytes = BytesAlloc(outLen)
    BytesSet(wire, 0, 67)
    BytesSet(wire, 1, 84)
    BytesSet(wire, 2, 70)
    BytesSet(wire, 3, 49)
    BytesSet(wire, 4, 1)
    BytesSet(wire, 5, frameType & 255)
    BytesSet(wire, 6, flags & 255)
    BytesSet(wire, 7, 0)
    BytesSet(wire, 8, (streamId >> 24) & 255)
    BytesSet(wire, 9, (streamId >> 16) & 255)
    BytesSet(wire, 10, (streamId >> 8) & 255)
    BytesSet(wire, 11, streamId & 255)
    BytesSet(wire, 12, 0)
    BytesSet(wire, 13, 0)
    BytesSet(wire, 14, 0)
    BytesSet(wire, 15, 0)
    return wire

fn tcpTlsForwardFillEmptyFrame(frameType: int32,
                               flags: int32,
                               streamId: int32,
                               out: var Bytes) =
    let outLen: int32 = VpnProxyTcpTlsForwardHeaderLen
    var wire: Bytes = BytesAlloc(outLen)
    BytesSet(wire, 0, 67)
    BytesSet(wire, 1, 84)
    BytesSet(wire, 2, 70)
    BytesSet(wire, 3, 49)
    BytesSet(wire, 4, 1)
    BytesSet(wire, 5, frameType & 255)
    BytesSet(wire, 6, flags & 255)
    BytesSet(wire, 7, 0)
    BytesSet(wire, 8, (streamId >> 24) & 255)
    BytesSet(wire, 9, (streamId >> 16) & 255)
    BytesSet(wire, 10, (streamId >> 8) & 255)
    BytesSet(wire, 11, streamId & 255)
    BytesSet(wire, 12, 0)
    BytesSet(wire, 13, 0)
    BytesSet(wire, 14, 0)
    BytesSet(wire, 15, 0)
    out = wire

@borrows
fn tcpTlsForwardFillFrame(frameType: int32,
                          flags: int32,
                          streamId: int32,
                          payload: Bytes,
                          out: var Bytes) =
    out = tcpTlsForwardMakeFrame(frameType, flags, streamId, payload)

@borrows
fn tcpTlsForwardFrameCompleteLengthCode(data: Bytes): int32 =
    if data.len < VpnProxyTcpTlsForwardHeaderLen:
        return 0
    if BytesGet(data, 0) != 67 ||
       BytesGet(data, 1) != 84 ||
       BytesGet(data, 2) != 70 ||
       BytesGet(data, 3) != 49:
        return -1
    if BytesGet(data, 4) != 1:
        return -2
    let frameType: int32 = BytesGet(data, 5) & 255
    let frameTypeCode: int32 = tcpTlsFrameTypeValidCode(frameType)
    if frameTypeCode < 1:
        return -3
    let payloadLen: int32 = tcpTlsReadU32(data, 12)
    if payloadLen < 0 || payloadLen > VpnProxyTcpTlsForwardMaxPayloadLen:
        return -4
    let totalLen: int32 = VpnProxyTcpTlsForwardHeaderLen + payloadLen
    if data.len < totalLen:
        return 0
    return totalLen

fn tcpTlsForwardFrameLengthErrorText(code: int32): str =
    if code == -1:
        return "tcp-tls-forward: bad frame magic"
    if code == -2:
        return "tcp-tls-forward: unsupported version"
    if code == -3:
        return "tcp-tls-forward: invalid frame type"
    if code == -4:
        return "tcp-tls-forward: invalid payload length"
    return "tcp-tls-forward: invalid frame"

@borrows
fn tcpTlsForwardDecodeFrameUnchecked(data: Bytes,
                                     out: var VpnProxyTcpTlsForwardFrame) =
    let payloadLen: int32 = tcpTlsReadU32(data, 12)
    out.frameType = BytesGet(data, 5) & 255
    out.flags = BytesGet(data, 6) & 255
    out.streamId = tcpTlsReadU32(data, 8)
    # [orc-hunt x86] out.payload 曾是 BytesSlice 视图：调用方解码后立即 BytesFree
    # 底下 plaintext，视图悬垂；中继循环 BytesFree(视图)=内点 release。owned 拷贝。
    var ownedPayload: Bytes = BytesAlloc(payloadLen)
    var copyIdx: int32
    while copyIdx < payloadLen:
        BytesSet(ownedPayload, copyIdx, BytesGet(data, VpnProxyTcpTlsForwardHeaderLen + copyIdx) & 255)
        copyIdx = copyIdx + 1
    out.payload = ownedPayload

@borrows
fn VpnProxyTcpTlsForwardDecodeFrameCode(data: Bytes,
                                        out: var VpnProxyTcpTlsForwardFrame): int32 =
    let totalLen: int32 = tcpTlsForwardFrameCompleteLengthCode(data)
    if totalLen < 0:
        return totalLen
    if totalLen <= 0:
        return 0
    tcpTlsForwardDecodeFrameUnchecked(data, out)
    return 1

@borrows
fn VpnProxyTcpTlsForwardBuildAuthFrameInto(rawToken: str, out: var Bytes): int32 =
    if len(rawToken) < 32:
        return -1
    tcpTlsForwardFillTextFrame(1, 0, 0, rawToken, out)
    return 1

@borrows
fn VpnProxyTcpTlsForwardBuildOpenFrameInto(streamId: int32,
                                           address: str,
                                           out: var Bytes): int32 =
    if streamId <= 0:
        return -1
    if len(address) <= 0:
        return -2
    tcpTlsForwardFillTextFrame(2, 0, streamId, address, out)
    return 1

@borrows
fn VpnProxyTcpTlsForwardBuildDataFrameInto(streamId: int32,
                                           payload: Bytes,
                                           out: var Bytes): int32 =
    if streamId <= 0:
        return -1
    tcpTlsForwardFillFrame(3, 0, streamId, payload, out)
    return 1

fn VpnProxyTcpTlsForwardBuildCloseFrameInto(streamId: int32,
                                            out: var Bytes): int32 =
    if streamId <= 0:
        return -1
    tcpTlsForwardFillEmptyFrame(4, 0, streamId, out)
    return 1

fn VpnProxyTcpTlsForwardBuildOpenOkFrameInto(streamId: int32,
                                             out: var Bytes): int32 =
    if streamId <= 0:
        return -1
    tcpTlsForwardFillEmptyFrame(7, 0, streamId, out)
    return 1

@borrows
fn VpnProxyTcpTlsForwardBuildOpenErrorFrameInto(streamId: int32,
                                                errorText: str,
                                                out: var Bytes): int32 =
    if streamId <= 0:
        return -1
    tcpTlsForwardFillTextFrame(8, 0, streamId, errorText, out)
    return 1

fn VpnProxyTcpTlsForwardBuildProbeFrameInto(out: var Bytes): int32 =
    tcpTlsForwardFillEmptyFrame(5, 0, 0, out)
    return 1

fn VpnProxyTcpTlsForwardBuildProbeOkFrameInto(out: var Bytes): int32 =
    tcpTlsForwardFillEmptyFrame(6, 0, 0, out)
    return 1

fn VpnProxyTcpTlsForwardBuildPingFrameInto(out: var Bytes): int32 =
    tcpTlsForwardFillEmptyFrame(9, 0, 0, out)
    return 1

fn VpnProxyTcpTlsForwardBuildPingOkFrameInto(out: var Bytes): int32 =
    tcpTlsForwardFillEmptyFrame(10, 0, 0, out)
    return 1

@borrows
fn VpnProxyTcpTlsForwardAuthPayloadOk(payload: Bytes, expectedSha256: str): bool =
    let tokenHash: str = tcpTlsBytesHexLower(sha256.Sha256Digest(payload))
    return tcpTlsConstantTimeAsciiEq(tokenHash, expectedSha256)

@borrows
fn VpnProxyTcpTlsForwardPayloadText(frame: VpnProxyTcpTlsForwardFrame): str =
    return BytesToString(frame.payload)
