import std/result
import std/strings

type
    VpnProxyCliOptions =
        configPath: str
        readyPath: str
        acceptCount: int32
        probeIntervalMs: int32
        probeTimeoutMs: int32
        tunFakeDnsPersistKind: int32
        tunRouteModeText: str

fn VpnProxyIsAsciiSpace(ch: char): bool =
    if ch == ' ':
        return true
    let code: int32 = int32(ch)
    if code == 9:
        return true
    if code == 10:
        return true
    if code == 13:
        return true
    return false

@borrows
fn VpnProxyParseInt32(textRaw: str): Result[int32] =
    if len(textRaw) <= 0:
        return Err[int32]("vpn proxy: empty integer")
    var start: int32
    while start < len(textRaw):
        if !VpnProxyIsAsciiSpace(textRaw[start]):
            break
        start = start + 1
    var end: int32 = len(textRaw)
    while end > start:
        if !VpnProxyIsAsciiSpace(textRaw[end - 1]):
            break
        end = end - 1
    if start >= end:
        return Err[int32]("vpn proxy: empty integer")
    var sign: int32 = 1
    var cursor: int32 = start
    if textRaw[cursor] == '-':
        sign = -1
        cursor = cursor + 1
    if cursor >= end:
        return Err[int32]("vpn proxy: invalid integer")
    var value: int32
    var pos: int32 = cursor
    while pos < end:
        let ch = textRaw[pos]
        if ch < '0':
            return Err[int32]("vpn proxy: invalid integer")
        if ch > '9':
            return Err[int32]("vpn proxy: invalid integer")
        value = value * 10 + (int32(ch) - int32('0'))
        pos = pos + 1
    return Ok[int32](value * sign)

@borrows
fn VpnProxyReadFlagInto(out: var str, args: str[], key: str, defaultValue: str) =
    let keyLen: int32 = len(key)
    for i in 0..<args.len:
        let arg: str = strings.CloneStr(args[i])
        var hasPrefix: bool
        if len(arg) > keyLen:
            hasPrefix = true
            for j in 0..<keyLen:
                if arg[j] != key[j]:
                    hasPrefix = false
                    break
        if hasPrefix:
            let sep: char = arg[keyLen]
            if sep == ':' || sep == '=':
                let valueLen: int32 = len(arg) - keyLen - 1
                if valueLen <= 0:
                    out = ""
                    return
                out = strings.CloneStr(strings.SliceBytes(arg, keyLen + 1, valueLen))
                return
        if arg == key && i + 1 < args.len:
            out = strings.CloneStr(args[i + 1])
            return
    out = defaultValue


@borrows
fn VpnProxyReadFlagMatch(args: str[], key: str, defaultValue: str): str =
    let keyLen: int32 = len(key)
    for i in 0..<args.len:
        let arg: str = strings.CloneStr(args[i])
        var hasPrefix: bool
        if len(arg) > keyLen:
            hasPrefix = true
            for j in 0..<keyLen:
                if arg[j] != key[j]:
                    hasPrefix = false
                    break
        if hasPrefix:
            let sep: char = arg[keyLen]
            if sep == ':' || sep == '=':
                let valueLen: int32 = len(arg) - keyLen - 1
                if valueLen <= 0:
                    return ""
                return strings.CloneStr(strings.SliceBytes(arg, keyLen + 1, valueLen))
        if arg == key && i + 1 < args.len:
            return strings.CloneStr(args[i + 1])
    return defaultValue


@borrows
fn VpnProxyReadFlag(args: str[], key: str, defaultValue: str): str =
    var matched: str = VpnProxyReadFlagMatch(args, key, defaultValue)
    let owned: str = strings.CloneStr(matched)
    return owned

@borrows
fn VpnProxyReadIntFlag(args: str[], key: str, defaultValue: int32): int32 =
    var raw: str
    VpnProxyReadFlagInto(raw, args, key, "")
    if len(raw) <= 0:
        return defaultValue
    let parseRes: Result[int32] = VpnProxyParseInt32(raw)
    if IsErr(parseRes):
        return defaultValue
    return Value(parseRes)

@borrows
fn VpnProxyCollectArgsFrom(args: str[], start: int32): str[] =
    var out: str[]
    out = []
    if start < 0 || start >= args.len:
        return out
    for i in start..<args.len:
        add(out, args[i])
    return out

@borrows
fn VpnProxyOptionsFillInto(args: str[], out: var VpnProxyCliOptions) =
    var configPath: str
    var readyPath: str
    VpnProxyReadFlagInto(configPath, args, "--config", "")
    VpnProxyReadFlagInto(readyPath, args, "--ready-path", "")
    out.configPath = configPath
    out.readyPath = readyPath
    out.acceptCount = VpnProxyReadIntFlag(args, "--accept-count", 0)
    out.probeIntervalMs = VpnProxyReadIntFlag(args, "--probe-interval-ms", 3000)
    out.probeTimeoutMs = VpnProxyReadIntFlag(args, "--probe-timeout-ms", 1000)
    if out.probeIntervalMs < 0:
        out.probeIntervalMs = 0
    if out.probeTimeoutMs <= 0:
        out.probeTimeoutMs = 1000

@borrows
fn VpnProxyOptions(args: str[]): VpnProxyCliOptions =
    var out: VpnProxyCliOptions
    VpnProxyOptionsFillInto(args, out)
    return out
