import std/cmdline as cmdline
import std/os as os
import std/rawmem_support
import cheng/apps/vpn_proxy/vpn_proxy_main as vpnproxy
import cheng/apps/vpn_proxy/vpn_proxy_host_cli as hostcli

@importc("signal")
fn VpnProxyRuntimeLibcSignal(sig: int32, handler: ptr): ptr

# Ignore SIGPIPE process-wide. The client multiplexer is a single process writing
# to many app/tunnel sockets; a peer that closes mid-write would otherwise deliver
# SIGPIPE and kill the whole proxy. Lives in this (macOS client) entry, not the
# shared module, so the Linux server build doesn't reference the libc `signal`
# symbol (its static-ELF provider has no libc; the server tolerates SIGPIPE via
# its fork-per-tunnel isolation instead).
fn VpnProxyRuntimeIgnoreSigpipe() =
    var nilp: ptr
    let sigIgn: ptr = rawmem_support.RawmemPtrAdd(nilp, 1)
    let _ = VpnProxyRuntimeLibcSignal(13, sigIgn)

fn VpnProxyRuntimeToolRoot(): str =
    let envRoot: str = os.GetEnv("CHENG_ROOT")
    if len(envRoot) > 0:
        return envRoot
    return os.GetCurrentDir()

fn VpnProxyRuntimeToolCollectArgsFrom(startIndex: int32,
                                        count: int32): str[] =
    var out: str[]
    if startIndex > count:
        return out
    for i in startIndex..count:
        let arg: str = cmdline.ParamStr(i)
        if len(arg) > 0:
            add(out, arg)
    return out

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    VpnProxyRuntimeIgnoreSigpipe()
    let rootDir: str = VpnProxyRuntimeToolRoot()
    let count: int32 = cmdline.ParamCount()
    let args: str[] = VpnProxyRuntimeToolCollectArgsFrom(1, count)
    return hostcli.VpnProxyMain(rootDir, args)
