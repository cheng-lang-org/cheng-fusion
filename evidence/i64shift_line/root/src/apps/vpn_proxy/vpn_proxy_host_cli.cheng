import std/result
import std/strings
import std/strutils as strutil
import std/os as os
import std/crypto/sha256
import cheng/apps/vpn_proxy/vpn_proxy_cli as cli
import cheng/core/tooling/path as chengpath
import cheng/quic/tls/test_pki as testpki
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn

fn VpnProxyUsage() =
    VpnProxyPrintLine("usage: cheng vpn-proxy <init-local|local|exit|status|gui> --config:<path>")
    VpnProxyPrintLine("init-local flags: --out:<dir> --server-host:<host> --server-port:<n> --token:<secret> --authority:<name>")
    VpnProxyPrintLine("local flags: --ready-path:<path> --accept-count:<n> --probe-interval-ms:<n> --probe-timeout-ms:<n>")
    VpnProxyPrintLine("exit flags: --ready-path:<path> --accept-count:<n>")
    VpnProxyPrintLine("status flags: --probe-timeout-ms:<n>")
    VpnProxyPrintLine("gui flags: --config:<path> --runtime-tool:<path>")


fn VpnProxyWriteConfigTextChecked(path: str, text: str): Result[bool] =
    let parseRes: Result[VpnProxyConfig] = config.VpnProxyParseConfigTextForTest(text)
    if IsErr(parseRes):
        return Err[bool](ErrorText(parseRes))
    if !VpnProxyEnsureParentDir(path):
        return Err[bool]("vpn proxy init-local: config parent mkdir failed")
    if !chengpath.WriteTextFile("", path, text):
        return Err[bool](strutil.Join(["vpn proxy init-local: write failed: ", path], ""))
    return Ok[bool](true)

@borrows

fn VpnProxyLocalDeployServerConfigText(listenPort: int32,
                                         authority: str,
                                         authSha: str): str =
    var joined: str = strutil.Join(["{\"protocol\":\"hy2-tun-v1\",",
        "\"server\":{\"listen\":\"0.0.0.0:", IntToStr(listenPort), "\",",
        "\"cert_der\":\"transport.cert.der\",",
        "\"key_pk8_der\":\"transport.key.pk8\",",
        "\"trust_root_der\":\"transport.root.der\",",
        "\"expected_auth_sha256\":", VpnProxyJsonQuote(strings.CloneStr(authSha)), ",",
        "\"expected_authority\":", VpnProxyJsonQuote(strings.CloneStr(authority)), ",",
        "\"cc_rx_text\":\"auto\"},",
        "\"security\":{\"auth_mode\":\"token_sha256\",",
        "\"expected_auth_sha256\":", VpnProxyJsonQuote(strings.CloneStr(authSha)), ",",
        "\"disable_0rtt\":true},",
        "\"anti_block\":{\"masquerade\":{\"enabled\":true,",
        "\"host\":\"www.example.com\",\"path\":\"/\",",
        "\"status\":200,\"body\":\"ok\"}}}\n"
    ], "")
    return strings.CloneStr(joined)

@borrows

fn VpnProxyLocalDeployMacClientConfigText(host: str,
                                           port: int32,
                                           authority: str,
                                           token: str,
                                           serverPin: str): str =
    var joined: str = strutil.Join(["{\"protocol\":\"hy2-tun-v1\",",
        "\"client\":{\"cert_der\":\"transport.cert.der\",",
        "\"key_pk8_der\":\"transport.key.pk8\",",
        "\"trust_root_der\":\"transport.root.der\",",
        "\"tun\":{\"enabled\":true,\"address\":\"198.18.0.2\",",
        "\"mtu\":1500,\"route_mode\":\"global\",",
        "\"dns_mode\":\"fake-ip\",\"fake_ip_prefix\":\"198.18.0.0/16\"}},",
        "\"security\":{\"auth_mode\":\"token_sha256\",",
        "\"server_pin_sha256\":[", VpnProxyJsonQuote(strings.CloneStr(serverPin)), "],",
        "\"client_cert_mode\":\"off\",\"disable_0rtt\":true},",
        "\"exits\":[{\"name\":\"windows\",",
        "\"host\":", VpnProxyJsonQuote(strings.CloneStr(host)), ",",
        "\"port\":", IntToStr(port), ",",
        "\"server_name\":", VpnProxyJsonQuote(strings.CloneStr(authority)), ",",
        "\"authority\":", VpnProxyJsonQuote(strings.CloneStr(authority)), ",",
        "\"auth\":", VpnProxyJsonQuote(strings.CloneStr(token)), ",",
        "\"cc_rx\":123456,\"weight\":10}]}\n"
    ], "")
    return strings.CloneStr(joined)

@borrows@borrows


fn VpnProxyLocalDeployCursorConfigText(host: str,
                                         port: int32,
                                         authority: str,
                                         token: str,
                                         listenText: str): str =
    var joined: str = strutil.Join(["{\"client\":{\"listen\":", VpnProxyJsonQuote(strings.CloneStr(listenText)), ",",
        "\"cert_der\":\"transport.cert.der\",",
        "\"key_pk8_der\":\"transport.key.pk8\",",
        "\"trust_root_der\":\"transport.root.der\"},",
        "\"exits\":[{\"name\":\"windows\",",
        "\"host\":", VpnProxyJsonQuote(strings.CloneStr(host)), ",",
        "\"port\":", IntToStr(port), ",",
        "\"server_name\":", VpnProxyJsonQuote(strings.CloneStr(authority)), ",",
        "\"authority\":", VpnProxyJsonQuote(strings.CloneStr(authority)), ",",
        "\"auth\":", VpnProxyJsonQuote(strings.CloneStr(token)), ",",
        "\"cc_rx\":123456,\"weight\":10}]}\n"
    ], "")
    return strings.CloneStr(joined)


fn VpnProxyInitLocalUsage() =
    VpnProxyPrintLine("usage: cheng vpn-proxy init-local [--out:<dir>] [--server-host:<host>] [--server-port:<n>]")
    VpnProxyPrintLine("init-local flags: --token:<secret> --authority:<name> --client-listen:<host:port>")


fn VpnProxyInitLocalDeploy(rootDir: str, args: str[]): int32 =
    if args.len > 0:
        var cmd: str = strings.CloneStr(args[0])
        if cmd == "help":
            VpnProxyInitLocalUsage()
            return 0
        if cmd == "--help":
            VpnProxyInitLocalUsage()
            return 0
        if cmd == "-h":
            VpnProxyInitLocalUsage()
            return 0
    var defOut: str = "artifacts/vpn-proxy-local"
    var outRaw: str = cli.VpnProxyReadFlag(args, "--out", defOut)
    var defHost: str = "10.13.12.93"
    var host: str = cli.VpnProxyReadFlag(args, "--server-host", defHost)
    var defPort: str = IntToStr(VpnProxyLocalDeployDefaultPort)
    var portRaw: str = cli.VpnProxyReadFlag(args, "--server-port", defPort)
    var portRes: Result[int32] = cli.VpnProxyParseInt32(portRaw)
    if IsErr(portRes):
        VpnProxyPrintErr("vpn proxy init-local: invalid --server-port")
        return 1
    if Value(portRes) <= 0:
        VpnProxyPrintErr("vpn proxy init-local: invalid --server-port")
        return 1
    var defToken: str = "cheng-hy2-tun-local-shared-token-2026"
    var token: str = cli.VpnProxyReadFlag(args, "--token", defToken)
    if len(token) < 32:
        VpnProxyPrintErr("vpn proxy init-local: --token must be at least 32 bytes")
        return 1
    var defAuthority: str = "unimaker.fun"
    var authority: str = cli.VpnProxyReadFlag(args, "--authority", defAuthority)
    if len(authority) <= 0:
        VpnProxyPrintErr("vpn proxy init-local: --authority required")
        return 1
    var defListen: str = "127.0.0.1:1080"
    var clientListen: str = cli.VpnProxyReadFlag(args, "--client-listen", defListen)
    var outDir: str = chengpath.PathAbsolute(rootDir, outRaw)
    if !chengpath.MkdirP("", outDir):
        VpnProxyPrintErr("vpn proxy init-local: output directory mkdir failed")
        return 1

    var trustRoot: Bytes
    testpki.msquicLocalhostTransportTrustRootDerInto(trustRoot)
    var certDer: Bytes
    testpki.msquicLocalhostTransportCertDerInto(certDer)
    var keyPk8: Bytes
    testpki.msquicLocalhostTransportKeyPkcs8DerInto(keyPk8)
    var rootPath: str = os.JoinPath(outDir, "transport.root.der")
    var certPath: str = os.JoinPath(outDir, "transport.cert.der")
    var keyPath: str = os.JoinPath(outDir, "transport.key.pk8")
    if !VpnProxyWriteBytesFile(rootPath, trustRoot):
        VpnProxyPrintErr("vpn proxy init-local: write transport.root.der failed")
        return 1
    if !VpnProxyWriteBytesFile(certPath, certDer):
        VpnProxyPrintErr("vpn proxy init-local: write transport.cert.der failed")
        return 1
    if !VpnProxyWriteBytesFile(keyPath, keyPk8):
        VpnProxyPrintErr("vpn proxy init-local: write transport.key.pk8 failed")
        return 1

    var tokenShaInput: str = strings.CloneStr(token)
    var authSha: str = VpnProxySha256Hex(tokenShaInput)
    var serverPin: str = VpnProxyBytesHexLower(sha256.Sha256Digest(certDer))
    var port: int32 = Value(portRes)
    var serverText: str = VpnProxyLocalDeployServerConfigText(port, authority, authSha)
    var macText: str = VpnProxyLocalDeployMacClientConfigText(host, port, authority, token, serverPin)
    var cursorText: str = VpnProxyLocalDeployCursorConfigText(host, port, authority, token, clientListen)
    var serverPath: str = os.JoinPath(outDir, "server.json")
    var macPath: str = os.JoinPath(outDir, "client-macos.json")
    var cursorPath: str = os.JoinPath(outDir, "client-cursor-proxy.json")
    var serverWriteRes: Result[bool] = VpnProxyWriteConfigTextChecked(strings.CloneStr(serverPath), serverText)
    if IsErr(serverWriteRes):
        VpnProxyPrintErr(ErrorText(serverWriteRes))
        return 1
    var macWriteRes: Result[bool] = VpnProxyWriteConfigTextChecked(strings.CloneStr(macPath), macText)
    if IsErr(macWriteRes):
        VpnProxyPrintErr(ErrorText(macWriteRes))
        return 1
    var cursorWriteRes: Result[bool] = VpnProxyWriteConfigTextChecked(strings.CloneStr(cursorPath), cursorText)
    if IsErr(cursorWriteRes):
        VpnProxyPrintErr(ErrorText(cursorWriteRes))
        return 1
    VpnProxyPrintLine(strutil.Join(["vpn-proxy local assets ready: ", outDir], ""))
    VpnProxyPrintLine(strutil.Join(["server_config=", serverPath], ""))
    VpnProxyPrintLine(strutil.Join(["client_config=", macPath], ""))
    VpnProxyPrintLine(strutil.Join(["cursor_proxy_config=", cursorPath], ""))
    VpnProxyPrintLine(strutil.Join(["server_pin_sha256=", serverPin], ""))
    return 0


fn VpnProxyMain(rootDir: str, args: str[]): int32 =
    if args.len <= 0:
        VpnProxyUsage()
        return 1
    let cmd: str = strings.CloneStr(args[0])
    let rest: str[] = cli.VpnProxyCollectArgsFrom(args, 1)
    if cmd == "help" || cmd == "--help" || cmd == "-h":
        VpnProxyUsage()
        return 0
    if cmd == "local":
        return VpnProxyLocal(rootDir, rest)
    if cmd == "exit":
        return VpnProxyExit(rootDir, rest)
    if cmd == "status":
        return VpnProxyStatus(rootDir, rest)
    if cmd == "__status-probe-exit":
        return VpnProxyStatusProbeExitChild(rootDir, rest)
    if cmd == "gui":
        return VpnProxyGui(rootDir, rest)
    if cmd == "init-local":
        return VpnProxyInitLocalDeploy(rootDir, rest)
    VpnProxyPrintErr(strutil.Join(["vpn proxy: unknown subcommand: ", cmd], ""))
    VpnProxyUsage()
    return 1

