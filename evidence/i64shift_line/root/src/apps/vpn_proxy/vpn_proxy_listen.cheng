import std/result
import std/strings
import std/rawmem_support
import cheng/apps/vpn_proxy/vpn_proxy_cli as cli



type
    VpnProxyListenAddress =
        host: str
        port: int32
        isV6: bool

const
    vpnProxyByteColon = 58
    vpnProxyByteOpenBracket = 91
    vpnProxyByteCloseBracket = 93

@borrows
fn VpnProxyTextSlice(text: str, start: int32, count: int32): str =
    if count <= 0:
        return ""
    return strings.SliceBytes(text, start, count)

@borrows
fn VpnProxyTextByteAt(text: str, idx: int32): int32 =
    if idx < 0 || idx >= len(text):
        return 0
    return int32(text[idx])

@borrows
fn VpnProxyTextFindCloseBracket(text: str): int32 =
    var out: int32 = -1
    for i in 1..<len(text):
        if out < 0 && VpnProxyTextByteAt(text, i) == vpnProxyByteCloseBracket:
            out = i
    return out

@borrows
fn VpnProxyTextFindLastColon(text: str): int32 =
    var out: int32 = -1
    for i in 0..<len(text):
        if VpnProxyTextByteAt(text, i) == vpnProxyByteColon:
            out = i
    return out


@borrows
fn VpnProxyParseListenAddressInto(textRaw: str, outHost: var str, outPort: var int32): Result[bool] =
    # Owned copy: the bare alias bind made the scope-exit release hit the
    # caller's buffer (ORC registry_miss on x86). Same family as parserInit.
    let text: str = strings.CloneStr(textRaw)
    if len(text) <= 0:
        return Err[bool]("vpn proxy: listen address must be host:port")
    if VpnProxyTextByteAt(text, 0) == vpnProxyByteOpenBracket:
        let closeIdx: int32 = VpnProxyTextFindCloseBracket(text)
        if closeIdx < 0:
            return Err[bool]("vpn proxy: invalid ipv6 listen address")
        if closeIdx + 1 >= len(text) || VpnProxyTextByteAt(text, closeIdx + 1) != vpnProxyByteColon:
            return Err[bool]("vpn proxy: invalid ipv6 listen address")
        outHost = NewStringCopy(rawmem_support.RawmemPtrAdd(StrDataPtr(text), 1), closeIdx - 1)
        let portText: str = NewStringCopy(rawmem_support.RawmemPtrAdd(StrDataPtr(text), closeIdx + 2), len(text) - closeIdx - 2)
        let portRes: Result[int32] = cli.VpnProxyParseInt32(portText)
        if IsErr(portRes):
            return Err[bool](ErrorText(portRes))
        outPort = Value(portRes)
    else:
        let lastColon: int32 = VpnProxyTextFindLastColon(text)
        if lastColon <= 0 || lastColon + 1 >= len(text):
            return Err[bool]("vpn proxy: listen address must be host:port")
        # [orc-hunt x86] 视图临时值(基串+off)会在表达式尾被 x86 codegen release
        # (端口视图 +off≡7 mod 8 → ORC registry_miss)。零视图形：指针加法直拷。
        outHost = NewStringCopy(StrDataPtr(text), lastColon)
        let portText: str = NewStringCopy(rawmem_support.RawmemPtrAdd(StrDataPtr(text), lastColon + 1), len(text) - lastColon - 1)
        let portRes: Result[int32] = cli.VpnProxyParseInt32(portText)
        if IsErr(portRes):
            return Err[bool](ErrorText(portRes))
        outPort = Value(portRes)
    if len(outHost) <= 0 || outPort < 0 || outPort > 65535:
        return Err[bool]("vpn proxy: listen address must be host:port")
    return Ok[bool](true)


fn VpnProxyParseListenAddress(textRaw: str): Result[VpnProxyListenAddress] =
    # Owned copy: see VpnProxyParseListenAddressInto.
    let text: str = strings.CloneStr(textRaw)
    if len(text) <= 0:
        return Err[VpnProxyListenAddress]("vpn proxy: listen address must be host:port")
    var out: VpnProxyListenAddress
    if VpnProxyTextByteAt(text, 0) == vpnProxyByteOpenBracket:
        out.isV6 = true
        let closeIdx: int32 = VpnProxyTextFindCloseBracket(text)
        if closeIdx < 0:
            return Err[VpnProxyListenAddress]("vpn proxy: invalid ipv6 listen address")
        if closeIdx + 1 >= len(text) || VpnProxyTextByteAt(text, closeIdx + 1) != vpnProxyByteColon:
            return Err[VpnProxyListenAddress]("vpn proxy: invalid ipv6 listen address")
        out.host = NewStringCopy(rawmem_support.RawmemPtrAdd(StrDataPtr(text), 1), closeIdx - 1)
        let portText: str = NewStringCopy(rawmem_support.RawmemPtrAdd(StrDataPtr(text), closeIdx + 2), len(text) - closeIdx - 2)
        let portRes: Result[int32] = cli.VpnProxyParseInt32(portText)
        if IsErr(portRes):
            return Err[VpnProxyListenAddress](ErrorText(portRes))
        out.port = Value(portRes)
    else:
        out.isV6 = false
        let lastColon: int32 = VpnProxyTextFindLastColon(text)
        if lastColon <= 0 || lastColon + 1 >= len(text):
            return Err[VpnProxyListenAddress]("vpn proxy: listen address must be host:port")
        out.host = NewStringCopy(StrDataPtr(text), lastColon)
        let portText: str = NewStringCopy(rawmem_support.RawmemPtrAdd(StrDataPtr(text), lastColon + 1), len(text) - lastColon - 1)
        let portRes: Result[int32] = cli.VpnProxyParseInt32(portText)
        if IsErr(portRes):
            return Err[VpnProxyListenAddress](ErrorText(portRes))
        out.port = Value(portRes)
    if len(out.host) <= 0 || out.port < 0 || out.port > 65535:
        return Err[VpnProxyListenAddress]("vpn proxy: listen address must be host:port")
    return Ok[VpnProxyListenAddress](out)
