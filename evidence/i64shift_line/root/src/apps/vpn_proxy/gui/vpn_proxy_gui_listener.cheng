import std/result
import std/net/transports/tcp_syscall as tcp

fn VpnProxyGuiOpenListenerFd(host: str, port: int32): int32 =
    var listener: tcp.TcpListenerHandle
    let listenRes: Result[bool] = tcp.TcpListenFill(host, port, listener, false)
    if IsErr(listenRes):
        return -1
    return listener.fd
