import std/result
import std/os
import std/strutils as strutil
import std/net/transports/tcp_syscall as tcp
import cheng/apps/vpn_proxy/gui/vpn_proxy_gui as core

fn VpnGuiServerPrintLine(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn VpnGuiServerServeReadyOnce(listener: tcp.TcpListenerHandle,
                                port: int32,
                                url: str): Result[bool] =
    var conn: tcp.TcpConnectionHandle
    if !tcp.TcpAcceptInto(listener, conn):
        return Ok[bool](false)
    core.VpnGuiHandleGlobalHttp(conn, port, url)
    tcp.TcpClose(conn)
    return Ok[bool](true)

fn VpnProxyGuiRun(rootDir: str,
                    runtimeToolPathRaw: str,
                    configPathRaw: str): int32 =
    let listenRes: Result[tcp.TcpListenerHandle] = tcp.TcpListen(core.VpnGuiListenHost,
                                                                  core.VpnGuiWebPort,
                                                                  false)
    if IsErr(listenRes):
        VpnGuiServerPrintLine(ErrorText(listenRes))
        return 1
    var listener: tcp.TcpListenerHandle = Value(listenRes)
    let nonblockingRes: Result[bool] = tcp.TcpListenerSetNonblocking(listener, true)
    if IsErr(nonblockingRes):
        let errText: str = ErrorText(nonblockingRes)
        tcp.TcpListenerClose(listener)
        VpnGuiServerPrintLine(errText)
        return 1
    core.VpnGuiInitGlobalState(rootDir, runtimeToolPathRaw, configPathRaw)
    let port: int32 = if listener.addr.port > 0: listener.addr.port else: core.VpnGuiWebPort
    let url: str = strutil.Join(["http://", core.VpnGuiListenHost, ":", IntToStr(port), "/"], "")
    VpnGuiServerPrintLine(strutil.Join(["vpn gui: open ", url], ""))
    core.VpnGuiTryOpenBrowser(rootDir, url)
    var exitCode: int32
    while !core.VpnGuiGlobalQuitRequested():
        core.VpnGuiPollGlobal()
        let readyRes: Result[bool] = tcp.TcpListenerWaitReadable(listener, core.VpnGuiWaitMs)
        if IsErr(readyRes):
            core.VpnGuiSetGlobalErrorText(ErrorText(readyRes))
            exitCode = 1
            break
        if !Value(readyRes):
            continue
        let serveRes: Result[bool] = VpnGuiServerServeReadyOnce(listener, port, url)
        if IsErr(serveRes):
            core.VpnGuiSetGlobalErrorText(ErrorText(serveRes))
            exitCode = 1
            break
    tcp.TcpListenerClose(listener)
    let errorText: str = core.VpnGuiGlobalErrorText()
    if exitCode != 0 && len(errorText) > 0:
        VpnGuiServerPrintLine(errorText)
    if core.VpnGuiGlobalProcRunning():
        VpnGuiServerPrintLine(strutil.Join(["vpn gui: ui closed, local proxy still running pid=", IntToStr(int32(core.VpnGuiGlobalProcPid()))], ""))
    return exitCode
