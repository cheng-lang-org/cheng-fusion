import cheng/apps/vpn_proxy/vpn_proxy_config as config
import cheng/std/strings

type
    VpnProxyExitState =
        cfg: config.VpnProxyExitConfig
        sendClientCertificate: bool
        healthy: bool
        ewmaMs: int64
        probeFailures: int32
        recoverySuccesses: int32
        recentOpenFail0Ms: int64
        recentOpenFail1Ms: int64
        lastProbeMs: int64
        lastSampleMs: int64
        lastError: str

@borrows
fn VpnProxyInitExitStateWithClientCertificate(cfg: config.VpnProxyExitConfig,
                                                sendClientCertificate: bool): VpnProxyExitState =
    var state: VpnProxyExitState
    state.cfg.name = strings.CloneStr(cfg.name)
    state.cfg.transport = strings.CloneStr(cfg.transport)
    state.cfg.host = strings.CloneStr(cfg.host)
    state.cfg.port = cfg.port
    state.cfg.serverName = strings.CloneStr(cfg.serverName)
    state.cfg.authority = strings.CloneStr(cfg.authority)
    state.cfg.auth = strings.CloneStr(cfg.auth)
    state.cfg.ccRx = cfg.ccRx
    state.cfg.weight = cfg.weight
    state.cfg.dialerProxy = strings.CloneStr(cfg.dialerProxy)
    state.sendClientCertificate = sendClientCertificate
    state.healthy = true
    state.ewmaMs = 0
    state.probeFailures = 0
    state.recoverySuccesses = 0
    state.recentOpenFail0Ms = 0
    state.recentOpenFail1Ms = 0
    state.lastProbeMs = 0
    state.lastSampleMs = 0
    state.lastError = ""
    return state

fn VpnProxyInitExitState(cfg: config.VpnProxyExitConfig): VpnProxyExitState =
    return VpnProxyInitExitStateWithClientCertificate(cfg, false)

@borrows
fn VpnProxyInitExitStatesWithClientCertificate(cfgs: config.VpnProxyExitConfig[],
                                                sendClientCertificate: bool): VpnProxyExitState[] =
    var out: VpnProxyExitState[]
    out = []
    for i in 0..<cfgs.len:
        add(out, VpnProxyInitExitStateWithClientCertificate(cfgs[i], sendClientCertificate))
    return out

fn VpnProxyInitExitStates(cfgs: config.VpnProxyExitConfig[]): VpnProxyExitState[] =
    return VpnProxyInitExitStatesWithClientCertificate(cfgs, false)

@borrows
fn VpnProxyMarkProbeFailure(state: var VpnProxyExitState, nowMs: int64, err: str) =
    state.lastProbeMs = nowMs
    state.lastError = err
    state.probeFailures = state.probeFailures + 1
    state.recoverySuccesses = 0
    if state.probeFailures >= 3:
        state.healthy = false

fn VpnProxyMarkSuccess(state: var VpnProxyExitState, nowMs: int64, sampleMs: int64) =
    state.lastProbeMs = nowMs
    state.lastSampleMs = sampleMs
    state.lastError = ""
    state.probeFailures = 0
    if state.ewmaMs <= 0:
        state.ewmaMs = sampleMs
    else:
        state.ewmaMs = (state.ewmaMs * 8 + sampleMs * 2) / 10
    if !state.healthy:
        state.recoverySuccesses = state.recoverySuccesses + 1
        if state.recoverySuccesses >= 2:
            state.healthy = true
    else:
        state.recoverySuccesses = 0

@borrows
fn VpnProxyRecordOpenFailure(state: var VpnProxyExitState, nowMs: int64, err: str) =
    state.lastError = err
    state.recentOpenFail0Ms = state.recentOpenFail1Ms
    state.recentOpenFail1Ms = nowMs
    if state.recentOpenFail0Ms > 0 &&
       nowMs - state.recentOpenFail0Ms <= 30000 &&
       nowMs - state.recentOpenFail1Ms <= 30000:
        state.healthy = false

@borrows
fn VpnProxyBestHealthyExit(states: VpnProxyExitState[], excludeIndex: int32): int32 =
    var bestIndex: int32 = -1
    var bestEwma: int64
    for i in 0..<states.len:
        if i == excludeIndex:
            continue
        let state: VpnProxyExitState = states[i]
        if !state.healthy || state.ewmaMs <= 0:
            continue
        if bestIndex < 0 || state.ewmaMs < bestEwma:
            bestIndex = i
            bestEwma = state.ewmaMs
    return bestIndex
