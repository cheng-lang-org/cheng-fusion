import cheng/apps/vpn_proxy/mobile/vpn_proxy_mobile_gui as mobilegui

fn Contains(haystack: str,
            needle: str): bool =
    let n: int32 = len(needle)
    if n <= 0:
        return true
    let h: int32 = len(haystack)
    if n > h:
        return false
    for i in 0..<(h - n + 1):
        var ok: bool = true
        for j in 0..<n:
            if haystack[i + j] != needle[j]:
                ok = false
        if ok:
            return true
    return false

fn main(): int32 =
    var emptyState = mobilegui.VpnMobileGuiInit("harmony", "")
    let emptyIdle: str = mobilegui.VpnMobileGuiSnapshotJson(emptyState)
    if !Contains(emptyIdle, "\"stop_enabled\":false"):
        return 31
    if !Contains(emptyIdle, "\"product_mode\":\"fast\""):
        return 46
    if !Contains(emptyIdle, "\"pac_supported\":true"):
        return 47
    var state = mobilegui.VpnMobileGuiInit("android", "/data/user/0/org.cheng.hy2tunvpn/files/hy2-tun-client.json")
    let idle: str = mobilegui.VpnMobileGuiSnapshotJson(state)
    if !Contains(idle, "\"format\":\"cheng_hy2_tun_mobile_gui_v1\""):
        return 1
    if !Contains(idle, "\"start_enabled\":true"):
        return 2
    if !Contains(idle, "\"product_mode\":\"fast\""):
        return 48
    if !Contains(idle, "\"pac_supported\":true"):
        return 49
    mobilegui.VpnMobileGuiApplyAction(state, mobilegui.VpnMobileGuiActionStart)
    let starting: str = mobilegui.VpnMobileGuiSnapshotJson(state)
    if !Contains(starting, "\"status\":\"starting\""):
        return 3
    if !Contains(starting, "\"stop_enabled\":true"):
        return 4
    mobilegui.VpnMobileGuiApplyStatus(state, "failed", "start failed before native connected")
    let failedAfterStart: str = mobilegui.VpnMobileGuiSnapshotJson(state)
    if !Contains(failedAfterStart, "\"stop_enabled\":true"):
        return 28
    if !Contains(failedAfterStart, "\"start_enabled\":false"):
        return 29
    mobilegui.VpnMobileGuiApplyAction(state, mobilegui.VpnMobileGuiActionStop)
    let stopped: str = mobilegui.VpnMobileGuiSnapshotJson(state)
    if !Contains(stopped, "\"status\":\"disconnected\""):
        return 25
    mobilegui.VpnMobileGuiApplyStatus(state, "failed", "missing Cheng core")
    let failed: str = mobilegui.VpnMobileGuiSnapshotJson(state)
    if !Contains(failed, "\"status\":\"failed\""):
        return 5
    if !Contains(failed, "\"stop_enabled\":true"):
        return 6
    if !Contains(failed, "\"start_enabled\":false"):
        return 30
    state.sessionId = uint64(9)
    state.tunFd = 43
    mobilegui.VpnMobileGuiApplyStatus(state, "failed", "native session needs cleanup")
    let failedActive: str = mobilegui.VpnMobileGuiSnapshotJson(state)
    if !Contains(failedActive, "\"stop_enabled\":true"):
        return 26
    if !Contains(failedActive, "\"start_enabled\":false"):
        return 27
    state.productMode = "fast"
    state.transport = "tcp-tls-forward"
    state.googleText = "google: ok code=204"
    state.coreAvailable = true
    state.sessionId = uint64(7)
    state.tunFd = 42
    state.rxBytes = uint64(2048)
    state.txBytes = uint64(1024)
    state.configSummary = "tun: 10.111.0.2/32 mtu: 1500 dns: 198.18.0.1"
    mobilegui.VpnMobileGuiApplyStatus(state, "connected", "native core connected")
    let rendered: str = mobilegui.VpnMobileGuiRenderJson(state)
    if !Contains(rendered, "\"format\":\"cheng_hy2_tun_mobile_gui_v2\""):
        return 7
    if !Contains(rendered, "\"source\":\"pure-cheng\""):
        return 8
    if !Contains(rendered, "\"button_layout\":\"top-fixed\""):
        return 9
    if !Contains(rendered, "\"status_layout\":\"below-buttons\""):
        return 10
    if !Contains(rendered, "\"host_role\":\"render-only\""):
        return 17
    if !Contains(rendered, "\"min_touch_dp\":52"):
        return 18
    if !Contains(rendered, "\"stable_button_geometry\":true"):
        return 19
    if !Contains(rendered, "\"no_screenshot_positioning\":true"):
        return 20
    if !Contains(rendered, "\"theme\":{\"background\":\"#FFFFFF\",\"text\":\"#0F172A\",\"inverse_text\":\"#FFFFFF\""):
        return 21
    if !Contains(rendered, "\"danger_soft\":\"#FEF2F2\""):
        return 22
    if !Contains(rendered, "\"border\":\"#E2E8F0\""):
        return 23
    if !Contains(rendered, "\"button_rows\":[[\"mode_fast\",\"mode_global\"],[\"proxy_toggle\"],[\"test_google\"]]"):
        return 11
    if !Contains(rendered, "\"id\":\"mode_fast\""):
        return 34
    if !Contains(rendered, "\"id\":\"mode_global\""):
        return 35
    if !Contains(rendered, "\"id\":\"proxy_toggle\""):
        return 37
    if !Contains(rendered, "\"text\":\"极速\""):
        return 38
    if !Contains(rendered, "\"text\":\"全局\""):
        return 61
    if !Contains(rendered, "\"text\":\"关闭代理\""):
        return 62
    if Contains(rendered, "\"id\":\"start\""):
        return 39
    if Contains(rendered, "\"id\":\"stop\""):
        return 40
    if Contains(rendered, "\"id\":\"network_settings\""):
        return 32
    if Contains(rendered, "OPEN NETWORK SETTINGS"):
        return 33
    if Contains(rendered, "\"id\":\"status_refresh\""):
        return 41
    if Contains(rendered, "\"id\":\"transport_udp_quic\""):
        return 44
    if Contains(rendered, "\"id\":\"transport_tcp_forward\""):
        return 45
    if Contains(rendered, "\"id\":\"config_path\""):
        return 55
    if Contains(rendered, "\"id\":\"config_label\""):
        return 56
    if Contains(rendered, "\"id\":\"config_summary\""):
        return 57
    if Contains(rendered, "\"id\":\"transport_text\""):
        return 58
    if Contains(rendered, "\"id\":\"session_text\""):
        return 59
    if Contains(rendered, "\"id\":\"tun_text\""):
        return 60
    if !Contains(rendered, "\"status_rows\":[[\"google_status\"],[\"status_badge\",\"core_text\"],[\"detail_text\"],[\"traffic_text\"],[\"error_text\"]]"):
        return 24
    if Contains(rendered, "\"id\":\"choose\""):
        return 16
    if !Contains(rendered, "\"id\":\"status_badge\""):
        return 12
    if !Contains(rendered, "\"text\":\"connected\""):
        return 13
    if !Contains(rendered, "\"id\":\"traffic_text\""):
        return 14
    if !Contains(rendered, "\"text\":\"core: available\""):
        return 15
    var harmonyState = mobilegui.VpnMobileGuiInit("harmony", "/data/storage/el2/base/haps/entry/files/cheng-hy2-tun-client.json")
    harmonyState.coreAvailable = true
    mobilegui.VpnMobileGuiApplyStatus(harmonyState, "connected", "native core connected")
    let harmonyRendered: str = mobilegui.VpnMobileGuiRenderJson(harmonyState)
    if !Contains(harmonyRendered, "\"button_rows\":[[\"mode_fast\",\"mode_global\"],[\"proxy_toggle\"],[\"test_google\"]]"):
        return 50
    if !Contains(harmonyRendered, "\"id\":\"mode_fast\""):
        return 51
    if !Contains(harmonyRendered, "\"id\":\"mode_global\""):
        return 52
    if !Contains(harmonyRendered, "\"id\":\"proxy_toggle\""):
        return 53
    if !Contains(harmonyRendered, "\"id\":\"test_google\""):
        return 54
    return 0
