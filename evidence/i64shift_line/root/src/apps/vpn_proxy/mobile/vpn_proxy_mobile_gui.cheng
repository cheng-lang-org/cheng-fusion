import std/strings
import std/strutils as strutil

type
    VpnMobileGuiAction = enum
        VpnMobileGuiActionStart
        VpnMobileGuiActionStop
        VpnMobileGuiActionStatus

type
    VpnMobileGuiState =
        platformName: str
        title: str
        configPath: str
        productMode: str
        transport: str
        googleText: str
        statusText: str
        detailText: str
        configSummary: str
        pacText: str
        errorText: str
        sessionId: uint64
        tunFd: int32
        rxBytes: uint64
        txBytes: uint64
        coreAvailable: bool
        startEnabled: bool
        stopEnabled: bool
        stopControlAvailable: bool
        pacSupported: bool
        tunSupported: bool
        lastAction: VpnMobileGuiAction

@borrows
fn VpnMobileGuiJsonQuote(raw: str): str =
    var pieces: str[]
    add(pieces, "\"")
    for i in 0..<len(raw):
        let ch = raw[i]
        if ch == '\\':
            add(pieces, "\\\\")
        elif ch == '"':
            add(pieces, "\\\"")
        elif ch == '\n':
            add(pieces, "\\n")
        elif ch == '\r':
            add(pieces, "\\r")
        elif ch == '\t':
            add(pieces, "\\t")
        else:
            add(pieces, strings.CharToStr(ch))
    add(pieces, "\"")
    return strutil.Join(pieces, "")

fn VpnMobileGuiBoolText(value: bool): str =
    if value:
        return "true"
    return "false"

fn VpnMobileGuiDigitText(digit: int32): str =
    if digit == 0:
        return "0"
    if digit == 1:
        return "1"
    if digit == 2:
        return "2"
    if digit == 3:
        return "3"
    if digit == 4:
        return "4"
    if digit == 5:
        return "5"
    if digit == 6:
        return "6"
    if digit == 7:
        return "7"
    if digit == 8:
        return "8"
    return "9"

fn VpnMobileGuiU64ToStr(value: uint64): str =
    if value == uint64(0):
        return "0"
    var n: uint64 = value
    var rev: str[]
    while n > uint64(0):
        let digit: int32 = int32(n % uint64(10))
        add(rev, VpnMobileGuiDigitText(digit))
        n = n / uint64(10)
    var out: str[]
    var i: int32 = len(rev) - 1
    while i >= 0:
        var keptDigit: str = strings.CloneStr(rev[i])
        add(out, keptDigit)
        i = i - 1
    return strutil.Join(out, "")

fn VpnMobileGuiActionName(action: VpnMobileGuiAction): str =
    if action == VpnMobileGuiActionStart:
        return "start"
    if action == VpnMobileGuiActionStop:
        return "stop"
    return "status"

@borrows
fn VpnMobileGuiCanStop(state: VpnMobileGuiState): bool =
    if state.statusText == "starting" || state.statusText == "connected" || state.statusText == "stopping":
        return true
    if state.statusText == "error" || state.statusText == "failed":
        return true
    if state.stopControlAvailable:
        return true
    if state.sessionId > uint64(0):
        return true
    if state.tunFd >= 0:
        return true
    return false

@borrows
fn VpnMobileGuiInit(platform: str,
                    configPath: str): VpnMobileGuiState =
    var out: VpnMobileGuiState
    out.platformName = platform
    out.title = "代理"
    out.configPath = configPath
    out.productMode = "fast"
    out.tunSupported = true
    if platform == "android" || platform == "harmony" || platform == "ohos":
        out.pacSupported = true
    out.transport = "udp-quic"
    out.googleText = "google: not tested"
    out.statusText = "disconnected"
    out.detailText = ""
    out.configSummary = ""
    out.pacText = "pac: inactive"
    out.errorText = ""
    out.sessionId = uint64(0)
    out.tunFd = -1
    out.rxBytes = uint64(0)
    out.txBytes = uint64(0)
    out.coreAvailable = false
    out.startEnabled = true
    out.stopEnabled = false
    out.stopControlAvailable = false
    out.lastAction = VpnMobileGuiActionStatus
    return out

@borrows
fn VpnMobileGuiApplyStatus(state: var VpnMobileGuiState,
                           statusText: str,
                           detailText: str) =
    state.statusText = strings.CloneStr(statusText)
    state.detailText = strings.CloneStr(detailText)
    if statusText == "disconnected":
        state.stopControlAvailable = false
    elif statusText == "starting" || statusText == "connected" || statusText == "stopping":
        state.stopControlAvailable = true
    if VpnMobileGuiCanStop(state):
        state.startEnabled = false
        state.stopEnabled = true
        return
    state.startEnabled = true
    state.stopEnabled = false

fn VpnMobileGuiApplyAction(state: var VpnMobileGuiState,
                           action: VpnMobileGuiAction) =
    state.lastAction = action
    if action == VpnMobileGuiActionStart:
        state.stopControlAvailable = true
        VpnMobileGuiApplyStatus(state, "starting", "waiting for native VPN")
        return
    if action == VpnMobileGuiActionStop:
        state.stopControlAvailable = false
        VpnMobileGuiApplyStatus(state, "disconnected", "stop requested")
        return
    VpnMobileGuiApplyStatus(state, state.statusText, state.detailText)

fn VpnMobileGuiSnapshotJson(state: VpnMobileGuiState): str =
    var parts: str[]
    add(parts, "{\"format\":\"cheng_hy2_tun_mobile_gui_v1\"")
    add(parts, ",\"platform\":")
    add(parts, VpnMobileGuiJsonQuote(state.platformName))
    add(parts, ",\"title\":")
    add(parts, VpnMobileGuiJsonQuote(state.title))
    add(parts, ",\"config_path\":")
    add(parts, VpnMobileGuiJsonQuote(state.configPath))
    add(parts, ",\"product_mode\":")
    add(parts, VpnMobileGuiJsonQuote(state.productMode))
    add(parts, ",\"transport\":")
    add(parts, VpnMobileGuiJsonQuote(state.transport))
    add(parts, ",\"google\":")
    add(parts, VpnMobileGuiJsonQuote(state.googleText))
    add(parts, ",\"status\":")
    add(parts, VpnMobileGuiJsonQuote(state.statusText))
    add(parts, ",\"detail\":")
    add(parts, VpnMobileGuiJsonQuote(state.detailText))
    add(parts, ",\"config_summary\":")
    add(parts, VpnMobileGuiJsonQuote(state.configSummary))
    add(parts, ",\"pac\":")
    add(parts, VpnMobileGuiJsonQuote(state.pacText))
    add(parts, ",\"error\":")
    add(parts, VpnMobileGuiJsonQuote(state.errorText))
    add(parts, ",\"session_id\":")
    add(parts, VpnMobileGuiU64ToStr(state.sessionId))
    add(parts, ",\"tun_fd\":")
    add(parts, IntToStr(state.tunFd))
    add(parts, ",\"rx_bytes\":")
    add(parts, VpnMobileGuiU64ToStr(state.rxBytes))
    add(parts, ",\"tx_bytes\":")
    add(parts, VpnMobileGuiU64ToStr(state.txBytes))
    add(parts, ",\"core_available\":")
    add(parts, VpnMobileGuiBoolText(state.coreAvailable))
    add(parts, ",\"start_enabled\":")
    add(parts, VpnMobileGuiBoolText(state.startEnabled))
    add(parts, ",\"stop_enabled\":")
    add(parts, VpnMobileGuiBoolText(state.stopEnabled))
    add(parts, ",\"pac_supported\":")
    add(parts, VpnMobileGuiBoolText(state.pacSupported))
    add(parts, ",\"tun_supported\":")
    add(parts, VpnMobileGuiBoolText(state.tunSupported))
    add(parts, ",\"last_action\":")
    add(parts, VpnMobileGuiJsonQuote(VpnMobileGuiActionName(state.lastAction)))
    add(parts, "}")
    return strutil.Join(parts, "")

@borrows
fn VpnMobileGuiStatusTone(statusText: str): str =
    if statusText == "connected":
        return "success"
    if statusText == "starting" || statusText == "stopping":
        return "warning"
    if statusText == "error" || statusText == "failed":
        return "danger"
    return "neutral"

fn VpnMobileGuiEnabledText(enabled: bool): str =
    if enabled:
        return "enabled"
    return "disabled"

fn VpnMobileGuiNeedsNetworkSettings(state: VpnMobileGuiState): bool =
    if strutil.Contains(state.detailText, "app network access blocked"):
        return true
    if strutil.Contains(state.errorText, "app network access blocked"):
        return true
    return false

@borrows
fn VpnMobileGuiPrimaryToggleText(state: VpnMobileGuiState): str =
    if state.statusText == "connected":
        return "关闭代理"
    if state.statusText == "starting":
        return "停止启动"
    if state.statusText == "stopping":
        return "停止中"
    if state.statusText == "error" || state.statusText == "failed":
        return "重置代理"
    return "开启代理"

@borrows
fn VpnMobileGuiPrimaryToggleStyle(state: VpnMobileGuiState): str =
    if state.stopEnabled:
        return "danger"
    return "primary"

@borrows
fn VpnMobileGuiComponentJson(id: str,
                             kind: str,
                             slot: str,
                             text: str,
                             action: str,
                             style: str,
                             enabled: bool): str =
    var minTouchDp: str = "0"
    if kind == "button" || kind == "input":
        minTouchDp = "52"
    var parts: str[]
    add(parts, "{\"id\":")
    add(parts, VpnMobileGuiJsonQuote(strings.CloneStr(id)))
    add(parts, ",\"kind\":")
    add(parts, VpnMobileGuiJsonQuote(strings.CloneStr(kind)))
    add(parts, ",\"slot\":")
    add(parts, VpnMobileGuiJsonQuote(strings.CloneStr(slot)))
    add(parts, ",\"text\":")
    add(parts, VpnMobileGuiJsonQuote(strings.CloneStr(text)))
    add(parts, ",\"action\":")
    add(parts, VpnMobileGuiJsonQuote(strings.CloneStr(action)))
    add(parts, ",\"style\":")
    add(parts, VpnMobileGuiJsonQuote(strings.CloneStr(style)))
    add(parts, ",\"enabled\":")
    add(parts, VpnMobileGuiBoolText(enabled))
    add(parts, ",\"min_touch_dp\":")
    add(parts, minTouchDp)
    add(parts, ",\"stable_frame\":true")
    add(parts, ",\"accessibility\":")
    var accessLabel: str = strutil.Join([strings.CloneStr(id), " ", strings.CloneStr(kind), " ", VpnMobileGuiEnabledText(enabled)], "")
    add(parts, VpnMobileGuiJsonQuote(accessLabel))
    add(parts, "}")
    return strutil.Join(parts, "")

@borrows
fn VpnMobileGuiAddComponent(parts: var str[],
                            first: var bool,
                            id: str,
                            kind: str,
                            slot: str,
                            text: str,
                            action: str,
                            style: str,
                            enabled: bool) =
    if !first:
        add(parts, ",")
    first = false
    add(parts, VpnMobileGuiComponentJson(id, kind, slot, text, action, style, enabled))

fn VpnMobileGuiRenderJson(state: VpnMobileGuiState): str =
    var parts: str[]
    add(parts, "{\"format\":\"cheng_hy2_tun_mobile_gui_v2\"")
    add(parts, ",\"source\":\"pure-cheng\"")
    add(parts, ",\"layout_version\":2")
    add(parts, ",\"platform\":")
    add(parts, VpnMobileGuiJsonQuote(state.platformName))
    add(parts, ",\"button_layout\":\"top-fixed\"")
    add(parts, ",\"status_layout\":\"below-buttons\"")
    add(parts, ",\"host_role\":\"render-only\"")
    add(parts, ",\"ux\":{\"min_touch_dp\":52,\"button_height_dp\":52,\"content_max_width_dp\":720,\"stable_button_geometry\":true,\"status_scroll_area\":true,\"no_screenshot_positioning\":true}")
    add(parts, ",\"theme\":{\"background\":\"#FFFFFF\",\"text\":\"#0F172A\",\"inverse_text\":\"#FFFFFF\",\"muted\":\"#475569\",\"muted_dark\":\"#334155\",\"primary\":\"#155EEF\",\"success\":\"#16A34A\",\"warning\":\"#D97706\",\"danger\":\"#DC2626\",\"danger_soft\":\"#FEF2F2\",\"surface\":\"#F8FAFC\",\"disabled\":\"#F1F5F9\",\"disabled_text\":\"#94A3B8\",\"border\":\"#E2E8F0\"}")
    if state.pacSupported && state.tunSupported:
        add(parts, ",\"button_rows\":[[\"mode_fast\",\"mode_global\"],[\"proxy_toggle\"],[\"test_google\"]]")
    else:
        add(parts, ",\"button_rows\":[[\"proxy_toggle\"],[\"test_google\"]]")
    add(parts, ",\"status_rows\":[[\"google_status\"],[\"status_badge\",\"core_text\"],[\"detail_text\"],[\"traffic_text\"],[\"error_text\"]]")
    add(parts, ",\"components\":[")
    var first: bool = true
    VpnMobileGuiAddComponent(parts, first, "title", "text", "header", state.title, "", "title", true)
    if state.pacSupported && state.tunSupported:
        VpnMobileGuiAddComponent(parts, first, "mode_fast", "button", "actions", "极速", "set_mode_fast", "secondary", true)
        VpnMobileGuiAddComponent(parts, first, "mode_global", "button", "actions", "全局", "set_mode_global", "secondary", true)
    VpnMobileGuiAddComponent(parts, first, "proxy_toggle", "button", "actions", VpnMobileGuiPrimaryToggleText(state), "toggle_proxy", VpnMobileGuiPrimaryToggleStyle(state), state.startEnabled || state.stopEnabled)
    VpnMobileGuiAddComponent(parts, first, "test_google", "button", "actions", "TEST GOOGLE", "test_google", "primary-wide", true)
    VpnMobileGuiAddComponent(parts, first, "google_status", "text", "status", state.googleText, "", "muted", true)
    VpnMobileGuiAddComponent(parts, first, "status_badge", "badge", "status", state.statusText, "", VpnMobileGuiStatusTone(state.statusText), true)
    var coreText: str = "core: missing"
    if state.coreAvailable:
        coreText = "core: available"
    VpnMobileGuiAddComponent(parts, first, "core_text", "text", "status", coreText, "", "body", true)
    VpnMobileGuiAddComponent(parts, first, "detail_text", "text", "status", state.detailText, "", "muted", len(state.detailText) > 0)
    VpnMobileGuiAddComponent(parts, first, "traffic_text", "text", "status", strutil.Join(["rx: ", VpnMobileGuiU64ToStr(state.rxBytes), " / tx: ", VpnMobileGuiU64ToStr(state.txBytes)], ""), "", "muted", true)
    VpnMobileGuiAddComponent(parts, first, "error_text", "text", "status", state.errorText, "", "danger", len(state.errorText) > 0)
    add(parts, "]}")
    return strutil.Join(parts, "")

fn VpnMobileGuiDefaultConfigJson(): str =
    return """
{
  "protocol": "hy2-tun-v1",
  "client": {
    "mode": "tun",
    "tun": {
      "enabled": true,
      "address": "10.111.0.2/32",
      "mtu": 1500,
      "route_mode": "fast",
      "dns_mode": "fake-ip",
      "fake_ip_prefix": "198.18.0.0/16",
      "dns_server": "198.18.0.1"
    }
  },
  "security": {
    "auth_mode": "token_sha256",
    "client_cert_mode": "off",
    "disable_0rtt": true
  },
  "exits": []
}
"""
