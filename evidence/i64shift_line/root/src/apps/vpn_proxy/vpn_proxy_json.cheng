import std/strings
import std/system as system
import std/strutils as strutil

type
    JsonNodeKind = enum
        JNull
        JBool
        JInt
        JFloat
        JString
        JArray
        JObject

    JsonNode =
        kind: JsonNodeKind
        b: bool
        i: int64
        f: float64
        s: str
        a: JsonNode[]
        okeys: str[]
        ovalues: JsonNode[]

    ParseResult =
        ok: bool
        value: JsonNode
        error: str

    JsonParser =
        text: str
        pos: int32
        length: int32
        error: str

const
    jsonByteQuote = 34
    jsonByteComma = 44
    jsonByteMinus = 45
    jsonByteDot = 46
    jsonByteZero = 48
    jsonByteNine = 57
    jsonByteColon = 58
    jsonByteOpenBracket = 91
    jsonByteCloseBracket = 93
    jsonByteBackslash = 92
    jsonByteOpenBrace = 123
    jsonByteCloseBrace = 125
    jsonByteSpace = 32
    jsonByteTab = 9
    jsonByteLf = 10
    jsonByteCr = 13
    jsonByteLowerN = 110
    jsonByteLowerR = 114
    jsonByteLowerT = 116

fn newJsonNode(kind: JsonNodeKind): JsonNode =
    var node: JsonNode
    node.kind = kind
    return node

fn newJNull(): JsonNode =
    return newJsonNode(JNull)

fn newJBool(value: bool): JsonNode =
    var node: JsonNode = newJsonNode(JBool)
    node.b = value
    return node

fn newJInt(value: int64): JsonNode =
    var node: JsonNode = newJsonNode(JInt)
    node.i = value
    return node

fn newJFloat(value: float64): JsonNode =
    var node: JsonNode = newJsonNode(JFloat)
    node.f = value
    return node

@borrows
fn newJString(value: str): JsonNode =
    var node: JsonNode = newJsonNode(JString)
    node.s = strings.CloneStr(value)
    return node

fn newJArray(): JsonNode =
    var node: JsonNode = newJsonNode(JArray)
    node.a = []
    return node

fn newJObject(): JsonNode =
    var node: JsonNode = newJsonNode(JObject)
    node.okeys = []
    node.ovalues = []
    return node

@borrows
fn hasKey(node: JsonNode, key: str): bool =
    if node.kind != JObject:
        return false
    for i in 0..<node.okeys.len:
        if node.okeys[i] == key:
            return true
    return false

@borrows
fn jsonOwnedCloneDepth(node: JsonNode, depth: int32): JsonNode =
    if depth > 256:
        system.Panic("vpn proxy json owned clone depth exceeded")
    var out: JsonNode
    out.kind = node.kind
    out.b = node.b
    out.i = node.i
    out.f = node.f
    out.s = strings.CloneStr(node.s)
    for index in 0..<node.a.len:
        add(out.a, jsonOwnedCloneDepth(node.a[index], depth + 1))
    for index in 0..<node.okeys.len:
        add(out.okeys, strings.CloneStr(node.okeys[index]))
    for index in 0..<node.ovalues.len:
        add(out.ovalues, jsonOwnedCloneDepth(node.ovalues[index], depth + 1))
    return out

@borrows
fn jsonGetField(node: JsonNode, key: str): JsonNode =
    if node.kind != JObject:
        return newJNull()
    for i in 0..<node.okeys.len:
        if node.okeys[i] == key:
            return jsonOwnedCloneDepth(node.ovalues[i], 0)
    return newJNull()

fn jsonSetField(node: var JsonNode, key: str, value: JsonNode) =
    if node.kind != JObject:
        return
    let valueClone: JsonNode = jsonOwnedCloneDepth(value, 0)
    for i in 0..<node.okeys.len:
        if node.okeys[i] == key:
            node.ovalues[i] = valueClone
            return
    add(node.okeys, strings.CloneStr(key))
    add(node.ovalues, valueClone)

fn `[]`(node: JsonNode, key: str): JsonNode =
    return jsonGetField(node, key)

fn `[]=`(node: var JsonNode, key: str, value: JsonNode) =
    jsonSetField(node, key, value)

@borrows
fn isObject(node: JsonNode): bool =
    return node.kind == JObject

@borrows
fn isArray(node: JsonNode): bool =
    return node.kind == JArray

@borrows
fn isString(node: JsonNode): bool =
    return node.kind == JString

@borrows
fn isInt(node: JsonNode): bool =
    return node.kind == JInt

@borrows
fn isBool(node: JsonNode): bool =
    return node.kind == JBool

@borrows
fn getInt(node: JsonNode): int64 =
    if node.kind == JInt:
        return node.i
    return 0

@borrows
fn getBool(node: JsonNode): bool =
    if node.kind == JBool:
        return node.b
    return false

@borrows
fn getFloat(node: JsonNode): float64 =
    if node.kind == JFloat:
        return node.f
    if node.kind == JInt:
        return float64(node.i)
    return 0.0

@borrows
fn getStr(node: JsonNode): str =
    if node.kind == JString:
        return strings.CloneStr(node.s)
    return ""

@borrows
fn parserInit(text: str): JsonParser =
    return JsonParser(text: strings.CloneStr(text), pos: 0, length: len(text), error: "")

@borrows
fn parserFail(p: var JsonParser, msg: str) =
    if len(p.error) <= 0:
        p.error = strings.CloneStr(msg)

@borrows
fn parserRawByteAt(p: JsonParser, pos: int32): int32 =
    if pos < 0 || pos >= p.length:
        return 0
    return int32(p.text[pos])

@borrows
fn parserPeekByte(p: JsonParser): int32 =
    if p.pos >= p.length:
        return 0
    return parserRawByteAt(p, p.pos)

fn parserNextByte(p: var JsonParser): int32 =
    if p.pos >= p.length:
        return 0
    let out: int32 = parserRawByteAt(p, p.pos)
    p.pos = p.pos + 1
    return out

@borrows
fn parserByteText(p: JsonParser, pos: int32): str =
    if pos < 0:
        return ""
    if pos >= p.length:
        return ""
    return strings.SliceBytes(p.text, pos, 1)

fn jsonByteText(value: int32): str =
    if value == jsonByteQuote:
        return "\""
    if value == jsonByteBackslash:
        return "\\"
    if value == jsonByteLf:
        return "\n"
    if value == jsonByteCr:
        return "\r"
    if value == jsonByteTab:
        return "\t"
    return ""

fn skipWhitespace(p: var JsonParser) =
    while p.pos < p.length:
        let b: int32 = parserPeekByte(p)
        if b == jsonByteSpace:
            p.pos = p.pos + 1
        else:
            if b == jsonByteLf:
                p.pos = p.pos + 1
            else:
                if b == jsonByteCr:
                    p.pos = p.pos + 1
                else:
                    if b == jsonByteTab:
                        p.pos = p.pos + 1
                    else:
                        return

fn isDigitByte(b: int32): bool =
    if b < jsonByteZero:
        return false
    if b > jsonByteNine:
        return false
    return true

fn parseString(p: var JsonParser): str =
    if parserPeekByte(p) != jsonByteQuote:
        parserFail(p, "expected string")
        return ""
    let _open: int32 = parserNextByte(p)
    _open
    let start: int32 = p.pos
    var scan: int32 = p.pos
    while scan < p.length:
        let b0: int32 = parserRawByteAt(p, scan)
        if b0 == jsonByteQuote:
            let count: int32 = scan - start
            p.pos = scan + 1
            if count <= 0:
                return ""
            return strings.SliceBytes(p.text, start, count)
        if b0 == jsonByteBackslash:
            break
        scan = scan + 1
    var out: str
    while p.pos < p.length:
        let chPos: int32 = p.pos
        let b: int32 = parserNextByte(p)
        if b == jsonByteQuote:
            return out
        if b == jsonByteBackslash:
            if p.pos >= p.length:
                parserFail(p, "unterminated string escape")
                return out
            let esc: int32 = parserNextByte(p)
            if esc == jsonByteQuote:
                out = strutil.Join([strings.CloneStr(out), jsonByteText(jsonByteQuote)], "")
            else:
                if esc == jsonByteBackslash:
                    out = strutil.Join([strings.CloneStr(out), jsonByteText(jsonByteBackslash)], "")
                else:
                    if esc == jsonByteLowerN:
                        out = strutil.Join([strings.CloneStr(out), jsonByteText(jsonByteLf)], "")
                    else:
                        if esc == jsonByteLowerR:
                            out = strutil.Join([strings.CloneStr(out), jsonByteText(jsonByteCr)], "")
                        else:
                            if esc == jsonByteLowerT:
                                out = strutil.Join([strings.CloneStr(out), jsonByteText(jsonByteTab)], "")
                            else:
                                out = strutil.Join([strings.CloneStr(out), parserByteText(p, p.pos - 1)], "")
        else:
            out = strutil.Join([strings.CloneStr(out), parserByteText(p, chPos)], "")
    parserFail(p, "unterminated string")
    return out

fn parseNumber(p: var JsonParser): JsonNode =
    var sign: int64 = 1
    let first: int32 = parserPeekByte(p)
    if first == jsonByteMinus:
        sign = -1
        let _minus: int32 = parserNextByte(p)
        _minus
    var value: int64
    var digits: int32
    while true:
        let b: int32 = parserPeekByte(p)
        if !isDigitByte(b):
            break
        let _digit: int32 = parserNextByte(p)
        _digit
        value = value * 10 + int64(b - jsonByteZero)
        digits = digits + 1
    if digits <= 0:
        parserFail(p, "invalid integer")
        return newJInt(0)
    let next: int32 = parserPeekByte(p)
    if next == jsonByteDot:
        parserFail(p, "float numbers unsupported")
        return newJInt(0)
    if next == 69:
        parserFail(p, "float numbers unsupported")
        return newJInt(0)
    if next == 101:
        parserFail(p, "float numbers unsupported")
        return newJInt(0)
    return newJInt(value * sign)

@borrows
fn consumeLiteral(p: var JsonParser, lit: str): bool =
    var i: int32
    for i in i..<len(lit):
        if parserPeekByte(p) != int32(lit[i]):
            return false
        let _b: int32 = parserNextByte(p)
        _b
    return true

fn parseValue(p: var JsonParser): JsonNode =
    skipWhitespace(p)
    let b: int32 = parserPeekByte(p)
    if b == jsonByteQuote:
        return newJString(parseString(p))
    if b == jsonByteOpenBracket:
        let _open: int32 = parserNextByte(p)
        _open
        var out: JsonNode = newJArray()
        skipWhitespace(p)
        if parserPeekByte(p) == jsonByteCloseBracket:
            let _close: int32 = parserNextByte(p)
            _close
            return out
        var done: bool
        while !done:
            let item: JsonNode = parseValue(p)
            add(out.a, jsonOwnedCloneDepth(item, 0))
            skipWhitespace(p)
            let sep: int32 = parserPeekByte(p)
            if sep == jsonByteComma:
                let _comma: int32 = parserNextByte(p)
                _comma
                skipWhitespace(p)
            else:
                if sep == jsonByteCloseBracket:
                    let _close: int32 = parserNextByte(p)
                    _close
                    done = true
                else:
                    parserFail(p, "expected ',' or ']'")
                    return out
        return out
    if b == jsonByteOpenBrace:
        let _open: int32 = parserNextByte(p)
        _open
        var out: JsonNode = newJObject()
        skipWhitespace(p)
        if parserPeekByte(p) == jsonByteCloseBrace:
            let _close: int32 = parserNextByte(p)
            _close
            return out
        var done: bool
        while !done:
            skipWhitespace(p)
            let key: str = parseString(p)
            skipWhitespace(p)
            if parserPeekByte(p) != jsonByteColon:
                parserFail(p, "expected ':'")
                return out
            let _colon: int32 = parserNextByte(p)
            _colon
            skipWhitespace(p)
            let value: JsonNode = parseValue(p)
            jsonSetField(out, key, value)
            skipWhitespace(p)
            let sep: int32 = parserPeekByte(p)
            if sep == jsonByteComma:
                let _comma: int32 = parserNextByte(p)
                _comma
                skipWhitespace(p)
            else:
                if sep == jsonByteCloseBrace:
                    let _close: int32 = parserNextByte(p)
                    _close
                    done = true
                else:
                    parserFail(p, "expected ',' or '}'")
                    return out
        return out
    if b == jsonByteMinus:
        return parseNumber(p)
    if isDigitByte(b):
        return parseNumber(p)
    if consumeLiteral(p, "true"):
        return newJBool(true)
    if consumeLiteral(p, "false"):
        return newJBool(false)
    if consumeLiteral(p, "null"):
        return newJNull()
    parserFail(p, "unexpected token")
    return newJNull()

fn parseArray(p: var JsonParser): JsonNode =
    if parserPeekByte(p) != jsonByteOpenBracket:
        parserFail(p, "expected '['")
        return newJArray()
    let _open: int32 = parserNextByte(p)
    _open
    var out: JsonNode = newJArray()
    skipWhitespace(p)
    if parserPeekByte(p) == jsonByteCloseBracket:
        let _close: int32 = parserNextByte(p)
        _close
        return out
    var done: bool
    while !done:
        let item: JsonNode = parseValue(p)
        add(out.a, jsonOwnedCloneDepth(item, 0))
        skipWhitespace(p)
        let b: int32 = parserPeekByte(p)
        if b == jsonByteComma:
            let _comma: int32 = parserNextByte(p)
            _comma
            skipWhitespace(p)
        else:
            if b == jsonByteCloseBracket:
                let _close: int32 = parserNextByte(p)
                _close
                done = true
            else:
                parserFail(p, "expected ',' or ']'")
                return out
    return out

fn parseObject(p: var JsonParser): JsonNode =
    if parserPeekByte(p) != jsonByteOpenBrace:
        parserFail(p, "expected '{'")
        return newJObject()
    let _open: int32 = parserNextByte(p)
    _open
    var out: JsonNode = newJObject()
    skipWhitespace(p)
    if parserPeekByte(p) == jsonByteCloseBrace:
        let _close: int32 = parserNextByte(p)
        _close
        return out
    var done: bool
    while !done:
        skipWhitespace(p)
        let key: str = parseString(p)
        skipWhitespace(p)
        if parserPeekByte(p) != jsonByteColon:
            parserFail(p, "expected ':'")
            return out
        let _colon: int32 = parserNextByte(p)
        _colon
        skipWhitespace(p)
        let value: JsonNode = parseValue(p)
        jsonSetField(out, key, value)
        skipWhitespace(p)
        let b: int32 = parserPeekByte(p)
        if b == jsonByteComma:
            let _comma: int32 = parserNextByte(p)
            _comma
            skipWhitespace(p)
        else:
            if b == jsonByteCloseBrace:
                let _close: int32 = parserNextByte(p)
                _close
                done = true
            else:
                parserFail(p, "expected ',' or '}'")
                return out
    return out

@borrows
fn parseJsonSafe(content: str): ParseResult =
    var out: ParseResult
    if len(content) <= 0:
        out.ok = false
        out.error = "empty input"
        return out
    var p: JsonParser = parserInit(content)
    let value: JsonNode = parseValue(p)
    skipWhitespace(p)
    if p.pos < p.length:
        parserFail(p, "trailing data")
    if len(p.error) > 0:
        out.ok = false
        out.error = strings.CloneStr(p.error)
        return out
    out.ok = true
    out.value = value
    return out

@borrows
fn IsObject(node: JsonNode): bool =
    return isObject(node)

@borrows
fn IsArray(node: JsonNode): bool =
    return isArray(node)

@borrows
fn IsString(node: JsonNode): bool =
    return isString(node)

@borrows
fn IsInt(node: JsonNode): bool =
    return isInt(node)

@borrows
fn IsBool(node: JsonNode): bool =
    return isBool(node)

@borrows
fn JsonGetField(node: JsonNode, key: str): JsonNode =
    return jsonGetField(node, key)

fn JsonSetField(node: var JsonNode, key: str, value: JsonNode) =
    jsonSetField(node, key, value)

@borrows
fn HasKey(node: JsonNode, key: str): bool =
    return hasKey(node, key)

@borrows
fn GetInt(node: JsonNode): int64 =
    return getInt(node)

@borrows
fn GetBool(node: JsonNode): bool =
    return getBool(node)

@borrows
fn GetFloat(node: JsonNode): float64 =
    return getFloat(node)

@borrows
fn GetStr(node: JsonNode): str =
    return getStr(node)

fn NewJNull(): JsonNode =
    return newJNull()

fn NewJBool(value: bool): JsonNode =
    return newJBool(value)

fn NewJInt(value: int64): JsonNode =
    return newJInt(value)

fn NewJFloat(value: float64): JsonNode =
    return newJFloat(value)

@borrows
fn NewJString(value: str): JsonNode =
    return newJString(value)

fn NewJArray(): JsonNode =
    return newJArray()

fn NewJObject(): JsonNode =
    return newJObject()

@borrows
fn CloneNode(node: JsonNode): JsonNode =
    return jsonOwnedCloneDepth(node, 0)

@borrows
fn ParseJsonSafe(content: str): ParseResult =
    return parseJsonSafe(content)
