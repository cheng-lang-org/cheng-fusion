var
    VpnProxyTunActiveFd: int32
    VpnProxyTunActiveName: str
    VpnProxyTunStopRequested: bool
    VpnProxyLocalProxyStopRequested: bool
    VpnProxyLocalProxyLastError: str
    VpnProxyLocalWorkerConfigPath: str
    VpnProxyLocalWorkerListenHost: str
    VpnProxyLocalWorkerListenPort: int32
    VpnProxyLocalWorkerListenIsV6: bool
    VpnProxyLocalWorkerProbeIntervalMs: int32
    VpnProxyLocalWorkerProbeTimeoutMs: int32
    VpnProxyExitWorkerConfigPath: str
    VpnProxyTcpTlsHandshakeLockWord: int32
    VpnProxyRawFileStorage: str[]

type
    VpnProxyIdentityConfig = config.VpnProxyIdentityConfig
    VpnProxyExitConfig = config.VpnProxyExitConfig
    VpnProxyConfig = config.VpnProxyConfig
    VpnProxySecurityConfig = config.VpnProxySecurityConfig
    VpnProxyMasqueradeConfig = config.VpnProxyMasqueradeConfig

    VpnProxyLoadedIdentity =
        certs: Bytes[]
        privateKey: Bytes
        leafKeyKind: x509.X509PublicKeyKind
        trustRoots: Bytes[]

    VpnProxyExitState = routing.VpnProxyExitState

    VpnProxyCliOptions = cli.VpnProxyCliOptions
    VpnProxyHy2TcpStream = hy2sess.VpnProxyHy2TcpStream
    VpnProxyHy2TcpStreamAllocator = hy2sess.VpnProxyHy2TcpStreamAllocator
    Hysteria2AuthResponse = hy2.Hysteria2AuthResponse
    Hysteria2UdpMessage = hy2.Hysteria2UdpMessage

    VpnProxyQuicLink =
        transport: qtransport.MsQuicTransport
        conn: qconn.Connection
        stream: VpnProxyHy2TcpStream
        tcpStreams: VpnProxyHy2TcpStreamAllocator
        streamOpen: bool
        exitIndex: int32

    VpnProxyTcpTlsForwardLink =
        conn: tcp.TcpConnectionHandle
        sendKeys: tlsrec.VpnProxyTcpTlsRecordKeys
        recvKeys: tlsrec.VpnProxyTcpTlsRecordKeys
        streamId: int32
        open: bool
        exitIndex: int32
        dialerProxyActive: bool
        dialerProxyStreamId: int32
        dialerProxySendKeys: tlsrec.VpnProxyTcpTlsRecordKeys
        dialerProxyRecvKeys: tlsrec.VpnProxyTcpTlsRecordKeys
        dialerProxyFramePending: Bytes
        dialerProxyDataPending: Bytes
        relayTargetPending: Bytes
        relayRemotePending: Bytes
        # [thruput] google→手机方向待发原始字节: TGT 读到后不再同步写隧道
        # (WriteAll 自旋把 google 腿焊死在手机排空速率上), 改入队+可写时排空。
        relayRemoteOutPending: Bytes
        relayOutClosedFrameSent: bool

    VpnProxyTcpTlsHandshakeFlightRecords =
        serverHelloRecord: Bytes
        encryptedFlightRecord: Bytes
        pending: Bytes

    VpnProxyTcpTlsDialerRecordRead =
        record: Bytes
        pending: Bytes

    VpnProxyTcpTlsFrameDecodeRead =
        decoded: bool
        pending: Bytes
        frame: ttf.VpnProxyTcpTlsForwardFrame

    # [mux] 服务端流表条目: 一条 TCP-TLS 隧道承载多个 TCP 流, 按 streamId
    # 路由。形状纪律(aarch64 三禁忌): 流表=局部 var managed seq, 只做元素
    # 顶层字段读写(同 tcpLinks 泵), 禁元素投影 var 传参; pending 拼接用
    # byval 标量进/Result 出(VpnProxyRelayJoinPending 同款)。
    # target 只存 fd/open 标量: TcpConnectionHandle 内嵌 UdpSockAddr.host
    # (str, 托管)非 address-free, 不可作为条目字段整 struct 拷贝; 每次
    # syscall 前用标量重建局部 handle, 用后标量写回。
    VpnProxyTcpTlsStreamEntry =
        streamId: int32
        targetFd: int32
        targetOpen: bool
        active: bool
        # target 侧已 EOF(读到 0/负), CLOSE 帧推迟到 outPending 排空后发。
        readClosed: bool
        # 已向手机发 CLOSE(streamId)。
        closeSent: bool
        # 手机已发 CLOSE(streamId): 不再收新数据。
        remoteClosed: bool
        # 已对 target 半关写(remoteClosed 且 inPending 排空后一次)。
        shutWrite: bool
        # 手机→target 已解密 DATA 待 target 可写。
        inPending: Bytes
        # target→手机原始字节待隧道可写。
        outPending: Bytes

    VpnProxyTarget = socks.VpnProxyTarget
    VpnProxySocksRequest = socks.VpnProxySocksRequest
    VpnProxySocksUdpDatagram = socks.VpnProxySocksUdpDatagram

    VpnProxyUdpBoundSocket =
        socket: udp.UdpSocketHandle
        bindTarget: VpnProxyTarget

    VpnProxyUdpFragState =
        sessionId: int64
        packetId: int32
        address: str
        firstSeenMs: int64
        lastSeenMs: int64
        payloadBytes: int32
        fragments: Hysteria2UdpMessage[]

    VpnProxyUdpFragFeedOutcome =
        complete: bool
        message: Hysteria2UdpMessage

    VpnProxyUdpFlowSession =
        address: str
        sessionId: int64

    VpnProxyUdpSessionTable =
        nextSessionId: int64
        flows: VpnProxyUdpFlowSession[]

    VpnProxyUdpSocketPair =
        v4Open: bool
        v4: udp.UdpSocketHandle
        v6Open: bool
        v6: udp.UdpSocketHandle

    VpnProxyStatusProbeResult =
        healthy: bool
        timedOut: bool
        exitCode: int32
        output: str
        lastError: str
        sampleMs: int64

    VpnProxyTunTcpLink =
        sessionKey: int64
        transportKind: int32
        link: VpnProxyQuicLink
        tcpTlsLink: VpnProxyTcpTlsForwardLink
        tcpTlsPendingRead: Bytes
        open: bool
        remoteOpen: bool
        targetHost: str
        targetPort: int32
        lastPacket: Bytes
        # [seq-fix] 隧道发送 seq 的元素顶层标量真身: 嵌套字段
        # (tcpTlsLink.sendKeys.seq)经元素写回在 aarch64 不持久化。
        tlsSendSeq: int64
        # [seq-fix] 接收侧同源: FlushRemote 批间从数组旧 seq 重启解密。
        tlsRecvSeq: int64
        # [mux] >0 = 该 TUN 流复用在共享 mux 隧道上(不拥有 tcpTlsLink)。
        muxStreamId: int32

    VpnProxyTunUdpFlow =
        sessionId: int64
        address: str
        clientPacket: Bytes

const
    VpnProxySocksVersion = 5
    VpnProxySocksCmdConnect = 1
    VpnProxySocksCmdBind = 2
    VpnProxySocksCmdUdpAssoc = 3
    VpnProxySocksAtypIpv4 = 1
    VpnProxySocksAtypDomain = 3
    VpnProxySocksAtypIpv6 = 4
    VpnProxySocksReplyGeneralFailure = 1
    VpnProxySocksReplyConnectionRefused = 5
    VpnProxySocksReplyCommandUnsupported = 7
    VpnProxySocksReplyAddressUnsupported = 8
    VpnProxyRelayChunkBytes = 32768
    # [mux] 单流 inPending 背压上限: 对端不排空的流超限即弃, 防拖垮整隧道。
    VpnProxyMuxStreamPendingCap = 1048576
    VpnProxyConnectTimeoutMs = 15000
    # [pool] 池取 OPEN 的快速超时: 陈旧热连接(网络切换/服务端早关)必须快速
    # 失败回落冷拨, 不得吃满 15s 连接超时。
    VpnProxyPoolOpenTimeoutMs = 2500
    # [pool] maintainer 轮询间隔: 用掉一条热连接后 ≤150ms 开始补拨。
    VpnProxyPoolPollMs = 150
    # [dial-job] N-A: 拨号线程空闲轮询间隔 = 提交→认领延迟上限(数据面
    # 每 tick ≥1 次迭代不受影响)。
    VpnProxyDialJobPollMs = 2
    # [pool] 热连接保鲜期: 载体 NAT/中间盒会静默丢长期空闲 TCP 映射(实测
    # ~1-2min 后 OPEN 写入石沉大海)。超龄槽直接关闭换新, 不让消费者吃
    # 2.5s 死 OPEN 超时。
    VpnProxyPoolMaxAgeMs = 45000
    # [keepalive] 停靠热槽 PING 验活节奏: 服务器 AUTH 后停靠窗口读超时 15s,
    # 每 5s 一轮 PING 重置之, 停靠连接不再被服务器掐死(消费者把 OPEN 写进
    # 死连接=下行 flight 丢失白屏根因); pong 同步刷新保鲜时点。
    VpnProxyPoolPingIntervalMs = 5000
    VpnProxyPoolPingTimeoutMs = 2000
    # [carrier-rotate] mux 载体轮换阈值: 载体长活连接经国际链路丢包后 BBR
    # 停留低窗口(对抗验证实测: 长活 280Kbps vs 同路径新连接 900KB/s, cwnd
    # 11-18/RTO 3.5s)。按累计收发字节或服役时限退役换新, 有活跃流时新流
    # 避让(回落池)+排空后拆, 禁止中流杀流。
    VpnProxyMuxRotateBytes = 4194304
    VpnProxyMuxRotateAgeMs = 90000
    VpnProxyHy2AuthOkStatus = 233
    VpnProxyHy2AuthRejectStatus = 403
    VpnProxyHy2TcpStreamId = 8
    VpnProxyHy2ProbeAddress = "cheng-vpn-probe.invalid:0"
    VpnProxyHy2UdpSessionId = 1
    VpnProxyUdpRelayChunkBytes = 65535
    VpnProxyUdpRelaySleepMs = 10
    VpnProxyUdpFragExpiryMs = 30000
    VpnProxyUdpFragMaxPendingPackets = 64
    VpnProxyHttpProxyMaxHeaderBytes = 8192
    VpnProxyPacScriptPath = "/cheng-hy2-tun.pac"
    VpnProxyLocalDeployDefaultDir = "artifacts/vpn-proxy-local"
    VpnProxyLocalDeployDefaultHost = "10.13.12.93"
    VpnProxyLocalDeployDefaultPort = 7443
    VpnProxyLocalDeployDefaultToken = "cheng-hy2-tun-local-shared-token-2026"
    VpnProxyLocalDeployDefaultAuthority = "unimaker.fun"
    VpnProxyLocalDeployDefaultClientListen = "127.0.0.1:1080"
    VpnProxyTunTcpTransportQuic = 1
    VpnProxyTunTcpTransportTcpTls = 2

fn VpnProxyPrintLine(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn VpnProxyPrintErr(text: str) =
    os.WriteLine(os.Get_stderr(), text)

fn VpnProxyTcpTlsForwardDebugEnabled(): bool =
    return os.GetEnvDefault("CHENG_TCP_TLS_FORWARD_DEBUG", "") == "1"

fn VpnProxyTcpTlsForwardDebugLine(parts: str[]) =
    if !VpnProxyTcpTlsForwardDebugEnabled():
        return
    os.WriteLine(os.Get_stderr(), strutil.Join(parts, ""))

fn VpnProxyTcpTlsHandshakeLock() =
    while VpnProxyAtomicCasI32(&VpnProxyTcpTlsHandshakeLockWord, 0, 1) == 0:
        thread.Yield()

fn VpnProxyTcpTlsHandshakeUnlock() =
    VpnProxyAtomicStoreI32(&VpnProxyTcpTlsHandshakeLockWord, 0)

fn VpnProxyMonoNowMs(): int64 =
    return VpnProxyMonoTimeNsBridge() / 1000000

fn VpnProxyLocalAcceptWaitMs(probeIntervalMs: int32,
                               lastIdleProbeMs: int64,
                               nowMs: int64): int32 =
    if probeIntervalMs <= 0:
        return 1000
    let remainingMs: int64 = int64(probeIntervalMs) - (nowMs - lastIdleProbeMs)
    if remainingMs <= 0:
        return 0
    if remainingMs > 1000:
        return 1000
    return int32(remainingMs)

fn VpnProxyBytesCopyInto(dst: Bytes, offset: int32, src: Bytes) =
    if src.len <= 0:
        return
    rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(dst.data, offset), src.data, src.len)

fn VpnProxyEmptyBytes(): Bytes =
    var out: Bytes
    out.data = nil
    out.len = 0
    return out

@borrows
fn VpnProxyBytesConcat(a: Bytes, b: Bytes): Bytes =
    if a.len <= 0 && b.len <= 0:
        return VpnProxyEmptyBytes()
    let outLen: int32 = a.len + b.len
    var out: Bytes = BytesAlloc(outLen)
    VpnProxyBytesCopyInto(out, 0, a)
    VpnProxyBytesCopyInto(out, a.len, b)
    return out

fn VpnProxyBytesConcat3(a: Bytes, b: Bytes, c: Bytes): Bytes =
    if a.len <= 0 && b.len <= 0 && c.len <= 0:
        return VpnProxyEmptyBytes()
    let outLen: int32 = a.len + b.len + c.len
    var out: Bytes = BytesAlloc(outLen)
    VpnProxyBytesCopyInto(out, 0, a)
    VpnProxyBytesCopyInto(out, a.len, b)
    VpnProxyBytesCopyInto(out, a.len + b.len, c)
    return out

@borrows
fn VpnProxyBytesDropPrefix(data: Bytes, count: int32): Bytes =
    let total: int32 = data.len
    var start: int32
    if count > 0:
        if count < total:
            start = count
        else:
            start = total
    # [x86 BytesSlice len 错译绕行] 手工组 Bytes, 不经 BytesSlice——实测其 len
    # 实参在 x86 产物中被错译(记录边界错位→'invalid legacy version'→conn 死)。
    var out: Bytes
    out.data = rawmem_support.RawmemPtrAdd(data.data, start)
    out.len = total - start
    return out

fn VpnProxyHexNibble(value: int32): str =
    let text: str = "0123456789abcdef"
    let idx: int32 = value & 15
    return strings.SliceBytes(text, idx, 1)

fn VpnProxyBytesHexLower(data: Bytes): str =
    var parts: str[]
    for i in 0..<BytesLen(data):
        let b: int32 = BytesGet(data, i) & 255
        add(parts, VpnProxyHexNibble((b >> 4) & 15))
        add(parts, VpnProxyHexNibble(b & 15))
    return strutil.Join(parts, "")

fn VpnProxySha256Hex(text: str): str =
    return VpnProxyBytesHexLower(sha256.Sha256Digest(BytesFromString(text)))

@borrows
fn VpnProxyIsHexSha256(textRaw: str): bool =
    let text: str = textRaw
    if len(text) != 64:
        return false
    for i in 0..<len(text):
        let ch: int32 = int32(text[i])
        if !((ch >= int32('0') && ch <= int32('9')) ||
             (ch >= int32('a') && ch <= int32('f')) ||
             (ch >= int32('A') && ch <= int32('F'))):
            return false
    return true

@borrows
fn VpnProxyConstantTimeAsciiEq(left: str, right: str): bool =
    var maxLen: int32 = len(left)
    if len(right) > maxLen:
        maxLen = len(right)
    var diff: int32 = len(left) ^ len(right)
    for i in 0..<maxLen:
        var leftByte: int32
        var rightByte: int32
        if i < len(left):
            leftByte = int32(left[i])
        if i < len(right):
            rightByte = int32(right[i])
        diff = diff | (leftByte ^ rightByte)
    if diff != 0:
        return false
    return true

@borrows
fn VpnProxyAuthMatches(rawAuth: str,
                         expectedRaw: str,
                         expectedSha256: str): bool =
    let expectedHash: str = strutil.Strip(expectedSha256)
    if len(expectedHash) > 0:
        if !VpnProxyIsHexSha256(expectedHash):
            return false
        return VpnProxyConstantTimeAsciiEq(VpnProxySha256Hex(strings.CloneStr(rawAuth)), expectedHash)
    let expectedText: str = strutil.Strip(expectedRaw)
    if len(expectedText) <= 0:
        return false
    return VpnProxyConstantTimeAsciiEq(rawAuth, expectedText)

fn VpnProxyRequireNo0Rtt(settings: qruntime.MsQuicSettings): Result[bool] =
    if settings.allow0Rtt:
        return Err[bool]("vpn proxy: 0-rtt disabled")
    return Ok[bool](true)

fn VpnProxyApplyTransportSettings(transport: var qtransport.MsQuicTransport,
                                  handshakeTimeoutMs: int64): Result[bool] =
    var settings: qruntime.MsQuicSettings
    qruntime.initMsQuicSettingsInto(settings)
    if handshakeTimeoutMs > 0:
        settings.handshakeIdleTimeoutMs = handshakeTimeoutMs
    if settings.allow0Rtt:
        return Err[bool]("vpn proxy: 0-rtt disabled")
    return qtransport.setMsQuicTransportSettings(transport, settings)

@importc("cheng_tun_open_utun_named_bridge")
fn VpnProxyTunOpen(): int32

@importc("cheng_tun_last_utun_name_ptr")
fn VpnProxyTunNamePtr(): ptr

@importc("cheng_tun_last_utun_name_len")
fn VpnProxyTunNameLen(): int32

fn VpnProxyTunName(): str =
    let p: ptr = VpnProxyTunNamePtr()
    let n: int32 = VpnProxyTunNameLen()
    if p == nil || n <= 0:
        return ""
    return NewStringCopy(p, n)

fn VpnProxyTunStoreFd(fd: int32, name: str) =
    VpnProxyTunActiveFd = fd
    VpnProxyTunActiveName = name

fn VpnProxyTunDarwinConfigureCommand(ifName: str,
                                      tunAddr: str,
                                      tunMTU: int32,
                                      exitHost: str): str =
    return strutil.Join([
        "gw=$(route -n get default | awk '/gateway:/{print $2; exit}'); ",
        "ifconfig ", os.QuoteShell(ifName), " inet ", os.QuoteShell(tunAddr), " ", os.QuoteShell(tunAddr),
        " netmask 255.255.255.255 mtu ", IntToStr(tunMTU), " up || exit 1; ",
        "if [ -n \"$gw\" ]; then route -n add -host ", os.QuoteShell(exitHost),
        " \"$gw\" 2>/dev/null || route -n change -host ", os.QuoteShell(exitHost),
        " \"$gw\" || exit 1; fi; ",
        "route -n add -net 0.0.0.0/1 -interface ", os.QuoteShell(ifName), " 2>/dev/null || true; ",
        "route -n add -net 128.0.0.0/1 -interface ", os.QuoteShell(ifName), " 2>/dev/null || true"
    ], "")

@borrows
fn VpnProxyTunConfigureDarwin(ifName: str,
                               tunAddr: str,
                               tunMTU: int32,
                               exitHost: str): Result[bool] =
    return Err[bool]("vpn proxy tun: darwin interface configure unavailable in this Windows build")

fn VpnProxyTunDarwinCleanupCommand(ifName: str): str =
    let qIf: str = os.QuoteShell(ifName)
    return strutil.Join([
        "route -n delete -net 0.0.0.0/1 2>/dev/null || true; ",
        "route -n delete -net 128.0.0.0/1 2>/dev/null || true; ",
        "ifconfig ", qIf, " down 2>/dev/null || true"
    ], "")

@borrows
fn VpnProxyTunCleanupDarwin(ifName: str) =
    return

fn VpnProxyRequireHy2TunClientConfig(cfg: VpnProxyConfig): Result[bool] =
    if cfg.protocol != "hy2-tun-v1":
        return Ok[bool](true)
    if !cfg.client.tun.enabled:
        return Err[bool]("vpn proxy config: client.tun.enabled required")
    if len(strutil.Strip(cfg.client.tun.address)) <= 0:
        return Err[bool]("vpn proxy config: client.tun.address required")
    if len(strutil.Strip(cfg.client.trustRootDer)) <= 0 && cfg.client.trustRootsDer.len <= 0:
        return Err[bool]("vpn proxy config: client trust root required")
    if cfg.security.authMode != "token_sha256":
        return Err[bool]("vpn proxy config: security.auth_mode token_sha256 required")
    if cfg.security.serverPinSha256.len <= 0:
        return Err[bool]("vpn proxy config: security.server_pin_sha256 required")
    for i in 0..<cfg.security.serverPinSha256.len:
        if !VpnProxyIsHexSha256(cfg.security.serverPinSha256[i]):
            return Err[bool]("vpn proxy config: invalid security.server_pin_sha256")
    if !cfg.security.disable0Rtt:
        return Err[bool]("vpn proxy config: disable_0rtt must be true")
    for i in 0..<cfg.exits.len:
        var transportText: str = strutil.Strip(cfg.exits[i].transport)
        if len(transportText) <= 0:
            transportText = "udp-quic"
        var transportSupported: bool
        if transportText == "udp-quic":
            transportSupported = true
        if transportText == "tcp-tls-forward":
            transportSupported = true
        if !transportSupported:
            return Err[bool]("vpn proxy config: unsupported exit transport")
        if len(strutil.Strip(cfg.exits[i].auth)) < 32:
            return Err[bool]("vpn proxy config: exit auth token too short")
    if cfg.exits.len <= 0:
        return Err[bool]("vpn proxy config: exits[] missing")
    return Ok[bool](true)

fn VpnProxyPrepareHy2TunLocalClient(cfg: VpnProxyConfig): Result[bool] =
    let requireRes: Result[bool] = VpnProxyRequireHy2TunClientConfig(cfg)
    if IsErr(requireRes):
        return Err[bool](ErrorText(requireRes))
    if cfg.protocol != "hy2-tun-v1":
        return Ok[bool](true)
    let tunFd: int32 = VpnProxyTunOpen()
    if tunFd < 0:
        return Err[bool]("vpn proxy tun: platform provider missing")

    let tunName: str = VpnProxyTunName()
    var tunAddr: str = strings.CloneStr(cfg.client.tun.address)
    var tunMTU: int32 = 1500
    if cfg.client.tun.mtu > 0:
        tunMTU = cfg.client.tun.mtu
    var exitHost: str = strings.CloneStr(cfg.exits[0].host)
    let cfgRes: Result[bool] = VpnProxyTunConfigureDarwin(tunName, tunAddr, tunMTU, exitHost)
    if IsErr(cfgRes):
        return Err[bool](ErrorText(cfgRes))

    VpnProxyTunStoreFd(tunFd, tunName)
    return Ok[bool](true)

@borrows
fn VpnProxyRequireHy2TunServerConfig(cfg: VpnProxyConfig): Result[bool] =
    if cfg.protocol != "hy2-tun-v1":
        return Ok[bool](true)
    if cfg.security.authMode != "token_sha256":
        return Err[bool]("vpn proxy config: security.auth_mode token_sha256 required")
    if !VpnProxyIsHexSha256(cfg.server.expectedAuthSha256):
        return Err[bool]("vpn proxy config: server expected_auth_sha256 required")
    if len(strutil.Strip(cfg.server.expectedAuthority)) <= 0:
        return Err[bool]("vpn proxy config: server expected_authority required")
    if !cfg.antiBlock.masquerade.enabled:
        return Err[bool]("vpn proxy config: anti_block.masquerade.enabled required")
    if len(strutil.Strip(cfg.antiBlock.masquerade.host)) <= 0 ||
       len(strutil.Strip(cfg.antiBlock.masquerade.path)) <= 0:
        return Err[bool]("vpn proxy config: masquerade host/path required")
    if !cfg.security.disable0Rtt:
        return Err[bool]("vpn proxy config: disable_0rtt must be true")
    return Ok[bool](true)

@borrows
fn VpnProxyWouldBlockUdp(err: str): bool =
    if err != "udp syscall: queue empty":
        return false
    return true

fn VpnProxyUdpUseLenField(): bool =
    if os.udpPlatformUseLenFieldBridge() == 0:
        return false
    return true

@borrows
fn VpnProxyUdpSocketAddrEq(left: udp.UdpSockAddr,
                             right: udp.UdpSockAddr): bool =
    if left.isV6 != right.isV6:
        return false
    if left.port != right.port:
        return false
    if left.host != right.host:
        return false
    return true

@borrows
fn VpnProxyUdpTargetFromSockAddr(addr: udp.UdpSockAddr): VpnProxyTarget =
    var out: VpnProxyTarget
    out.host = strings.CloneStr(addr.host)
    out.port = addr.port
    return out

fn VpnProxyUdpPacketNext(nextId: var int32): int32 =
    let out: int32 = nextId
    nextId = nextId + 1
    if nextId > 65535:
        nextId = 0
    return out

fn VpnProxyUdpSessionTableInit(out: var VpnProxyUdpSessionTable) =
    out.nextSessionId = int64(1)
    out.flows = []

fn VpnProxyUdpSessionTableNextId(table: var VpnProxyUdpSessionTable): Result[int64] =
    if table.nextSessionId <= int64(0):
        table.nextSessionId = int64(1)
    if table.nextSessionId > int64(4294967295):
        return Err[int64]("vpn proxy: udp session id exhausted")
    let out: int64 = table.nextSessionId
    table.nextSessionId = table.nextSessionId + int64(1)
    return Ok[int64](out)

fn VpnProxyUdpSessionRemember(table: var VpnProxyUdpSessionTable,
                                address: str,
                                sessionId: int64): Result[bool] =
    let addressText: str = strutil.Strip(address)
    if len(addressText) <= 0:
        return Err[bool]("vpn proxy: udp session address missing")
    if sessionId <= int64(0) || sessionId > int64(4294967295):
        return Err[bool]("vpn proxy: udp session id invalid")
    for i in 0..<table.flows.len:
        if table.flows[i].address == addressText:
            table.flows[i].sessionId = sessionId
            return Ok[bool](true)
    var entry: VpnProxyUdpFlowSession
    entry.address = addressText
    entry.sessionId = sessionId
    add(table.flows, entry)
    return Ok[bool](true)

@borrows
fn VpnProxyUdpSessionForAddress(table: var VpnProxyUdpSessionTable,
                                  address: str): Result[int64] =
    let addressText: str = strutil.Strip(address)
    if len(addressText) <= 0:
        return Err[int64]("vpn proxy: udp session address missing")
    for i in 0..<table.flows.len:
        if table.flows[i].address == addressText:
            return Ok[int64](table.flows[i].sessionId)
    let sessionRes: Result[int64] = VpnProxyUdpSessionTableNextId(table)
    if IsErr(sessionRes):
        return Err[int64](ErrorText(sessionRes))
    let rememberRes: Result[bool] = VpnProxyUdpSessionRemember(table, addressText, Value(sessionRes))
    if IsErr(rememberRes):
        return Err[int64](ErrorText(rememberRes))
    return sessionRes

@borrows
fn VpnProxyUdpSessionForKnownAddress(table: VpnProxyUdpSessionTable,
                                       address: str): Result[int64] =
    let addressText: str = strutil.Strip(address)
    if len(addressText) <= 0:
        return Err[int64]("vpn proxy: udp session address missing")
    for i in 0..<table.flows.len:
        if table.flows[i].address == addressText:
            return Ok[int64](table.flows[i].sessionId)
    return Err[int64]("vpn proxy: udp session unknown address")

@borrows
fn VpnProxyUdpSessionContainsId(table: VpnProxyUdpSessionTable,
                                  sessionId: int64): bool =
    for i in 0..<table.flows.len:
        if table.flows[i].sessionId == sessionId:
            return true
    return false

fn VpnProxyUdpFragSweepExpired(states: var VpnProxyUdpFragState[],
                                 nowMs: int64) =
    var kept: VpnProxyUdpFragState[]
    for i in 0..<states.len:
        let state = states[i]
        if state.lastSeenMs <= 0:
            continue
        if nowMs - state.lastSeenMs < int64(VpnProxyUdpFragExpiryMs):
            add(kept, share(state))
    states = kept

fn VpnProxyUdpFragStatesRemove(states: var VpnProxyUdpFragState[],
                                 dropIdx: int32) =
    var kept: VpnProxyUdpFragState[]
    for i in 0..<states.len:
        if i != dropIdx:
            add(kept, share(states[i]))
    states = kept

@borrows
fn VpnProxyUdpMessageAssign(out: var Hysteria2UdpMessage,
                              msg: Hysteria2UdpMessage) =
    out.sessionId = msg.sessionId
    out.packetId = msg.packetId
    out.fragmentId = msg.fragmentId
    out.fragmentCount = msg.fragmentCount
    out.address = strings.CloneStr(msg.address)
    out.payload = BytesSlice(msg.payload, 0, BytesLen(msg.payload))

@borrows
fn VpnProxyUdpFragFeedAt(states: var VpnProxyUdpFragState[],
                           msg: var Hysteria2UdpMessage,
                           nowMs: int64,
                           out: var Hysteria2UdpMessage): Result[bool] =
    if msg.fragmentCount <= 1:
        out.sessionId = msg.sessionId
        out.packetId = msg.packetId
        out.fragmentId = msg.fragmentId
        out.fragmentCount = msg.fragmentCount
        out.address = strings.CloneStr(msg.address)
        out.payload = rawbytes.BytesSlice(msg.payload, 0, BytesLen(msg.payload))
        return Ok[bool](true)
    if msg.fragmentId < 0 || msg.fragmentId >= msg.fragmentCount:
        return Err[bool]("vpn proxy: udp fragment invalid")
    VpnProxyUdpFragSweepExpired(states, nowMs)
    let msgBytes: int32 = BytesLen(msg.payload)
    if msgBytes < 0:
        return Err[bool]("vpn proxy: udp fragment payload invalid")
    if msgBytes > VpnProxyUdpRelayChunkBytes:
        return Err[bool]("vpn proxy: udp fragment payload too large")
    var stateIdx: int32 = -1
    for i in 0..<states.len:
        if states[i].sessionId == msg.sessionId &&
           states[i].packetId == msg.packetId &&
           states[i].address == msg.address:
            stateIdx = i
            break
    if stateIdx < 0:
        if states.len >= VpnProxyUdpFragMaxPendingPackets:
            return Err[bool]("vpn proxy: udp fragment state overflow")
        var state: VpnProxyUdpFragState
        state.sessionId = msg.sessionId
        state.packetId = msg.packetId
        state.address = strings.CloneStr(msg.address)
        state.firstSeenMs = nowMs
        state.lastSeenMs = nowMs
        state.payloadBytes = msgBytes
        var fragCopy: Hysteria2UdpMessage
        fragCopy.sessionId = msg.sessionId
        fragCopy.packetId = msg.packetId
        fragCopy.fragmentId = msg.fragmentId
        fragCopy.fragmentCount = msg.fragmentCount
        fragCopy.address = strings.CloneStr(msg.address)
        fragCopy.payload = rawbytes.BytesSlice(msg.payload, 0, BytesLen(msg.payload))
        add(state.fragments, fragCopy)
        add(states, state)
        return Ok[bool](false)
    var state = states[stateIdx]
    for i in 0..<state.fragments.len:
        let item: Hysteria2UdpMessage = state.fragments[i]
        if item.fragmentCount != msg.fragmentCount:
            return Err[bool]("vpn proxy: udp fragment count mismatch")
        if item.fragmentId == msg.fragmentId:
            return Err[bool]("vpn proxy: udp duplicate fragment")
        if item.sessionId != msg.sessionId ||
           item.packetId != msg.packetId ||
           item.address != msg.address:
            return Err[bool]("vpn proxy: udp fragment metadata mismatch")
    if state.payloadBytes + msgBytes > VpnProxyUdpRelayChunkBytes:
        return Err[bool]("vpn proxy: udp fragment payload exceeds datagram limit")
    var nextFragments = state.fragments
    var fragCopy2: Hysteria2UdpMessage
    fragCopy2.sessionId = msg.sessionId
    fragCopy2.packetId = msg.packetId
    fragCopy2.fragmentId = msg.fragmentId
    fragCopy2.fragmentCount = msg.fragmentCount
    fragCopy2.address = strings.CloneStr(msg.address)
    fragCopy2.payload = rawbytes.BytesSlice(msg.payload, 0, BytesLen(msg.payload))
    add(nextFragments, fragCopy2)
    state.fragments = nextFragments
    state.lastSeenMs = nowMs
    state.payloadBytes = state.payloadBytes + msgBytes
    if state.fragments.len != msg.fragmentCount:
        VpnProxyStoreFragStateAt(states, stateIdx, state)
        return Ok[bool](false)
    let fillRes = hy2.Hysteria2ReassembleUdpMessagesFill(state.fragments, out)
    if IsErr(fillRes):
        return Err[bool](Error(fillRes))
    VpnProxyUdpFragStatesRemove(states, stateIdx)
    return Ok[bool](true)

@borrows
fn VpnProxyUdpFragFeed(states: var VpnProxyUdpFragState[],
                         msg: var Hysteria2UdpMessage,
                         out: var Hysteria2UdpMessage): Result[bool] =
    return VpnProxyUdpFragFeedAt(states, msg, VpnProxyMonoNowMs(), out)

@borrows
fn VpnProxyUdpLiteralTarget(target: var VpnProxyTarget,
                              family: int32,
                              out: var udp.UdpSockAddr): Result[bool] =
    let isV6: bool = strings.StrContains(target.host, ":")
    return udp.UdpSockAddrFromHostPort(target.host,
                                       target.port,
                                       isV6,
                                       family,
                                       VpnProxyUdpUseLenField(),
                                       out)

@borrows
fn VpnProxyHy2UdpPayloadLimit(transport: qtransport.MsQuicTransport,
                                sessionId: int64,
                                address: str): Result[int32] =
    var emptyPayload: Bytes
    emptyPayload.data = nil
    emptyPayload.len = 0
    let headerRes: Result[Bytes] = hy2.Hysteria2EncodeUdpMessage(hy2.Hysteria2MakeUdpMessage(sessionId,
                                                                                                   0,
                                                                                                   0,
                                                                                                   1,
                                                                                                   strings.CloneStr(address),
                                                                                                   emptyPayload))
    if IsErr(headerRes):
        return Err[int32](ErrorText(headerRes))
    var headerOwned: Bytes = Value(headerRes)
    let limit: int32 = transport.settings.maxDatagram - BytesLen(headerOwned)
    if limit <= 0:
        return Err[int32]("vpn proxy: udp payload limit invalid")
    return Ok[int32](limit)

fn VpnProxyUdpSocketSend(fd: int32,
                           payload: Bytes,
                           toAddr: udp.UdpSockAddr): Result[bool] =
    let sendRes: Result[int32] = udp.UdpSendTo(fd, payload, toAddr)
    if IsErr(sendRes):
        return Err[bool](ErrorText(sendRes))
    if Value(sendRes) != BytesLen(payload):
        return Err[bool]("vpn proxy: udp short send")
    return Ok[bool](true)

@borrows
fn VpnProxyUdpBindSocket(host: str,
                           port: int32,
                           isV6: bool,
                           outSocket: var udp.UdpSocketHandle,
                           outSockName: var udp.UdpSockAddr): Result[bool] =
    var isV6Flag: int32
    if isV6:
        isV6Flag = 1
    let fd: int32 = os.udpBindFdBridge(host, port, isV6Flag)
    if fd < 0:
        return Err[bool]("udp syscall: bind failed")
    let sockNameRes: Result[bool] = udp.UdpGetSockName(fd, outSockName)
    if IsErr(sockNameRes):
        udp.UdpSocketClose(fd)
        return Err[bool](ErrorText(sockNameRes))
    outSocket.fd = fd
    outSocket.family = outSockName.family
    outSocket.isV6 = outSockName.isV6
    return Ok[bool](true)

@borrows
fn VpnProxyUdpBoundSocketOpen(host: str,
                                isV6: bool): Result[VpnProxyUdpBoundSocket] =
    var sockName: udp.UdpSockAddr
    var socket: udp.UdpSocketHandle
    let bindRes: Result[bool] = VpnProxyUdpBindSocket(host, 0, isV6, socket, sockName)
    if IsErr(bindRes):
        return Err[VpnProxyUdpBoundSocket](ErrorText(bindRes))
    var out: VpnProxyUdpBoundSocket
    out.socket = socket
    out.bindTarget = VpnProxyUdpTargetFromSockAddr(sockName)
    return Ok[VpnProxyUdpBoundSocket](out)

fn VpnProxyUdpSocketPairClose(pair: var VpnProxyUdpSocketPair) =
    if pair.v4Open:
        udp.UdpSocketClose(pair.v4.fd)
        pair.v4Open = false
    if pair.v6Open:
        udp.UdpSocketClose(pair.v6.fd)
        pair.v6Open = false

fn VpnProxyUdpSocketPairEnsure(pair: var VpnProxyUdpSocketPair,
                                 isV6: bool): Result[udp.UdpSocketHandle] =
    if isV6:
        if pair.v6Open:
            return Ok[udp.UdpSocketHandle](pair.v6)
        var sockName: udp.UdpSockAddr
        var socket: udp.UdpSocketHandle
        let bindRes: Result[bool] = VpnProxyUdpBindSocket("", 0, true, socket, sockName)
        if IsErr(bindRes):
            return Err[udp.UdpSocketHandle](ErrorText(bindRes))
        pair.v6 = socket
        pair.v6Open = true
        return Ok[udp.UdpSocketHandle](pair.v6)
    if pair.v4Open:
        return Ok[udp.UdpSocketHandle](pair.v4)
    var sockName: udp.UdpSockAddr
    var socket: udp.UdpSocketHandle
    let bindRes: Result[bool] = VpnProxyUdpBindSocket("", 0, false, socket, sockName)
    if IsErr(bindRes):
        return Err[udp.UdpSocketHandle](ErrorText(bindRes))
    pair.v4 = socket
    pair.v4Open = true
    return Ok[udp.UdpSocketHandle](pair.v4)

fn VpnProxyProtocolId(): int32 =
    return lptypes.Libp2pProtocolProxyTcp

# Last error text for the TUN dataplane. The mobile core's status emit calls
# this for the "connected" state, where the last error is empty (a non-empty
# error text in that state would be misleading). The actual session-level error
# is carried by ChengHy2TunMobileLastError in the mobile core.
# It now carries the most recent exit-dial/open failure so the periodic status
# heartbeat surfaces relay-path faults without extra tooling.
var vpnTunLastRelayError: str
var vpnTunActiveExitStates: VpnProxyExitState[]
# x86 var-array-element field writes can be silently dropped (backend mis-
# lowering), so the opened transport is parked in globals keyed by session
# slot and read back by the pump. REVERT after kernel fix.
var vpnTunOpenTransportKind: int32
var vpnTunOpenTcpTlsLink: VpnProxyTcpTlsForwardLink
var vpnTunOpenValid: int32
var vpnTunOpenTargetHost: str
# [pool-handoff-fix] OPEN 往返后的 send/recv seq 标量 park: 消费者 post-restore
# 改读这两个标量(已证形状), 不再经 元素投影→嵌套字段 读(布局彩票失真点)。
var vpnTunOpenSendSeq: int64
var vpnTunOpenRecvSeq: int64
# [dial-job] N-A: EnsureRemoteOpen 的 pending 出口标记(仅 worker 线程读写,
# 同 vpnTunOpenValid park 家族): 置 1 表示本次冷拨已转后台, 调用方立即返回。
var vpnTunEnsurePending: int32
# [dial-job] 收获对账(仅 worker 线程读写): submit 时记录期望 seq/key, 收获
# 只装匹配结果 —— 跨代陈旧结果(会话已换, 拨号线程迟到的发布)一律弃装。
var vpnTunDialWantSeq: int32
var vpnTunDialWantKey: int64
# [dial-job] 拨号窗口内主循环迭代数: 断流消除判据读数(>0 = 拨号坏窗内
# 数据面泵未停)。收获时随 DIALJOB 标记落盘并清零。
var vpnDialWindowIters: int64

fn VpnProxySetTunActiveExitStates(states: var VpnProxyExitState[]) =
    # The aarch64 backend has a known seq-parameter staleness defect: the
    # tun pump's copy of the exits descriptor can read empty while the probe
    # path sees the populated array. Register an element-level clone in a
    # module global once per session so the relay gate reads live data (a
    # plain descriptor store has been observed lost on arm64).
    var copy: VpnProxyExitState[]
    for i in 0..<states.len:
        add(copy, VpnProxyCloneExitState(states[i]))
    vpnTunActiveExitStates = copy
    VpnProxyTunRecordRelayError(strings.ConcatStr("SET len=", strings.Int64ToStr(copy.len)))

fn VpnProxyClearTunActiveExitStates() =
    var empty: VpnProxyExitState[]
    vpnTunActiveExitStates = empty
var vpnTunRelayTraceLines: str[]
var vpnTunProbeMarkerPath: str

fn VpnProxyTunProbeMark(tag: str) =
    # Crash-site probe: overwrite-write a unique tag immediately before each
    # suspect release/close. After an ORC registry_miss SIGABRT the surviving
    # files/probe_marker.txt names the exact close site that was executing.
    if len(vpnTunProbeMarkerPath) <= 0:
        return
    let _wroteMark: bool = chengpath.WriteTextFile(
        "", strings.CloneStr(vpnTunProbeMarkerPath), strings.CloneStr(tag))

var vpnTunTraceFlushLastMs: int64
var vpnTunFastPoll: bool
var vpnTunFlushEnterLogs: int32
# [perf] 诊断总开关: 生产关(热路径零开销), 排查时置 true。
# [tls-hdr-hunt] 诊断版置 true: 抓 invalid tls record length 现场。
# [dial-stall-hunt] 已定谳: PING 推进 seq 破坏池消费不变式(badslot 全拒)
# + 单槽拨号 unfair CAS 锁被高频 probe/fill 饿死(pending 永不认领)。
# 双修=expect-seq 镜像对账 + fair-ticket 拨号锁, curl 204/1.7s 复验通过。
var vpnTunTraceEnabled: bool
var vpnTunSelfHealLastThxMs: int64
var vpnTunSelfHealGuard: int32
# [nborc] 旧 streams_cap_link 单槽已拆除: mux serve 在服务器进程是每连接
# 一线程(ExitTcpTlsWorkerMain), 单槽=跨线程共享托管句柄, 线程 A 写槽释放
# 旧串时线程 B 正 var 借读(AppendIn 回写 CLOSE) = ORCU 同族 underflow 窗。
# link 现经 AppendIn 参数直传(serve 局部 var, 每连接私有), 零全局零窗。

# [orcu-marker] vpnTunLastRelayError 单槽三写者(worker/maintainer/看门狗)
# + 心跳读者: 释放旧串与装新串跨线程交错 = ORCU 同族 underflow 窗(M:964
# [nborc] 注释同族; 实证 storm 夹具 10/10 ORCMISS/underflow)。写者与读者
# 全部冷路径(marker/trace 门控/5s 心跳), 自旋锁代价可忽略。
var VpnProxyMarkerLockWord: int32

fn VpnProxyMarkerLock() =
    while VpnProxyAtomicCasI32(&VpnProxyMarkerLockWord, 0, 1) == 0:
        thread.Yield()

fn VpnProxyMarkerUnlock() =
    VpnProxyAtomicStoreI32(&VpnProxyMarkerLockWord, 0)

fn VpnProxyTunRecordRelayError(text: str) =
    if ! vpnTunTraceEnabled:
        return
    VpnProxyMarkerLock()
    vpnTunLastRelayError = strings.CloneStr(text)
    VpnProxyMarkerUnlock()
    # flushed to the app files dir so the dial path stays observable while the
    # connected-state UI hides the ring. REVERT after fix.
    add(vpnTunRelayTraceLines, strings.CloneStr(strings.ConcatStr(strings.Int64ToStr(VpnProxyMonoNowMs()), strings.ConcatStr(" ", strings.CloneStr(text)))))
    if vpnTunRelayTraceLines.len > 400:
        var kept: str[]
        var keptIdx: int32 = vpnTunRelayTraceLines.len - 200
        while keptIdx < vpnTunRelayTraceLines.len:
            add(kept, strings.CloneStr(vpnTunRelayTraceLines[keptIdx]))
            keptIdx = keptIdx + 1
        vpnTunRelayTraceLines = kept
    # [perf] 热路径节流: 原来每条 trace 全量重写 400 行文件(每秒数百次
    # flash IO)拖垮 flush 节奏。2s 节流落盘, 诊断仍可读。
    var traceNowMs: int64 = VpnProxyMonoNowMs()
    if traceNowMs - vpnTunTraceFlushLastMs >= 500:
        vpnTunTraceFlushLastMs = traceNowMs
        chengpath.WriteTextFile("", "/data/data/org.cheng.hy2tunvpn/files/relay_trace.log", strutil.Join(vpnTunRelayTraceLines, "\n"))

# [spin-wd] 看门狗专用落盘: 不看 vpnTunTraceEnabled 总开关(该门在 aarch64
# 布局彩票下曾被错译为恒假, 且生产默认关), 无条件立即写整文件。触发频率
# 极低(仅死旋现场), 立即落盘保证进程被杀前取证成功。
fn VpnProxyTunWatchdogRecord(text: str) =
    VpnProxyMarkerLock()
    vpnTunLastRelayError = strings.CloneStr(text)
    VpnProxyMarkerUnlock()
    add(vpnTunRelayTraceLines, strings.CloneStr(strings.ConcatStr(strings.Int64ToStr(VpnProxyMonoNowMs()), strings.ConcatStr(" ", strings.CloneStr(text)))))
    if vpnTunRelayTraceLines.len > 400:
        var keptWd: str[]
        var keptWdIdx: int32 = vpnTunRelayTraceLines.len - 200
        while keptWdIdx < vpnTunRelayTraceLines.len:
            add(keptWd, strings.CloneStr(vpnTunRelayTraceLines[keptWdIdx]))
            keptWdIdx = keptWdIdx + 1
        vpnTunRelayTraceLines = keptWd
    chengpath.WriteTextFile("", "/data/data/org.cheng.hy2tunvpn/files/relay_trace.log", strutil.Join(vpnTunRelayTraceLines, "\n"))

fn VpnProxyTunLastErrorText(): str =
    # Defensive clone: returning the global str bare crosses an ownership
    # boundary that has historically moved/consumed globals on arm64-android
    # (same registry_miss class as the heartbeat freeze). The heartbeat reads
    # this every 5s - a consumed global would UAF on the second read.
    # [orcu-marker] 锁内快照: 防读窗与写者释放/装新交错(见锁定义处注释)。
    VpnProxyMarkerLock()
    let snap: str = strings.CloneStr(vpnTunLastRelayError)
    VpnProxyMarkerUnlock()
    return snap

@borrows
fn VpnProxyTextSlice(text: str, start: int32, count: int32): str =
    if count <= 0:
        return ""
    return strings.SliceBytes(text, start, count)

@borrows
fn VpnProxyEnsureParentDir(path: str): bool =
    if len(path) <= 0:
        return true
    let parts: os.SplitFileResult = os.SplitFile(path)
    if len(parts.dir) <= 0:
        return true
    return chengpath.MkdirP("", parts.dir)

@borrows
fn VpnProxyWriteReadyPort(path: str, port: int32): bool =
    if len(path) <= 0:
        return true
    if !VpnProxyEnsureParentDir(path):
        return false
    return chengpath.WriteTextFile("", strings.CloneStr(path), strutil.Join([IntToStr(port), "\n"], ""))

fn VpnProxyWriteBytesFile(path: str, data: Bytes): bool =
    if !VpnProxyEnsureParentDir(path):
        return false
    var view: rawbytes.Bytes = rawbytes.BytesView(data.data, BytesLen(data))
    var writeRes: Result[bool] = os.WriteFileBytesResult(path, view)
    return IsOk(writeRes)

fn VpnProxyJsonQuote(raw: str): str =
    var out: str = "\""
    for i in 0..<len(raw):
        let ch = raw[i]
        if ch == '\\':
            out = strutil.Join([out, "\\\\"], "")
        elif ch == '"':
            out = strutil.Join([out, "\\\""], "")
        elif ch == '\n':
            out = strutil.Join([out, "\\n"], "")
        elif ch == '\r':
            out = strutil.Join([out, "\\r"], "")
        elif ch == '\t':
            out = strutil.Join([out, "\\t"], "")
        else:
            out = strutil.Join([out, strings.CharToStr(ch)], "")
    return strutil.Join([out, "\""], "")

fn VpnProxyLoadBytesFile(path: str): Result[Bytes] =
    if !os.FileExists(path) || os.FileSize(path) <= int64(0):
        return Err[Bytes](strutil.Join(["vpn proxy: failed to read file: ", path], ""))
    let raw: str = chengpath.ReadTextFileViaHandle(path)
    let rawLen: int32 = len(raw)
    if rawLen <= 0:
        return Err[Bytes](strutil.Join(["vpn proxy: failed to read file: ", path], ""))
    add(VpnProxyRawFileStorage, raw)
    return Ok[Bytes](rawbytes.BytesView(StrDataPtr(VpnProxyRawFileStorage[VpnProxyRawFileStorage.len - 1]), rawLen))

fn VpnProxyLoadBytesFileFixedInto(out: var Bytes, path: str): bool =
    if !os.FileExists(path) || os.FileSize(path) <= int64(0):
        VpnProxyPrintErr(strutil.Join(["vpn proxy: failed to read file: ", path], ""))
        return false
    let raw: str = chengpath.ReadTextFileViaHandle(path)
    let rawLen: int32 = len(raw)
    if rawLen <= 0:
        VpnProxyPrintErr(strutil.Join(["vpn proxy: failed to read file: ", path], ""))
        return false
    # Copy into a fresh heap allocation: aliasing the keep-alive string made
    # out.data an interior pointer, and the scope release of the Bytes then
    # hit the ORC registry miss (interior pointers are not allocation starts).
    out = rawbytes.BytesFromString(raw)
    return true

fn VpnProxyLoadFixedServerIdentityInto(out: var VpnProxyLoadedIdentity): bool =
    var certDer: Bytes
    if !VpnProxyLoadBytesFileFixedInto(certDer, "transport.cert.der"):
        return false
    add(out.certs, certDer)
    var keyPk8: Bytes
    if !VpnProxyLoadBytesFileFixedInto(keyPk8, "transport.key.pk8"):
        return false
    out.privateKey = keyPk8
    var trustRoot: Bytes
    if !VpnProxyLoadBytesFileFixedInto(trustRoot, "transport.root.der"):
        return false
    add(out.trustRoots, trustRoot)
    out.leafKeyKind = x509.X509KeyEcdsaP256
    return true

fn VpnProxyParseConfigTextForTest(configText: str): Result[VpnProxyConfig] =
    return config.VpnProxyParseConfigTextForTest(configText)

@borrows
fn VpnProxyLoadConfig(configPathRaw: str): Result[VpnProxyConfig] =
    return config.VpnProxyLoadConfig(configPathRaw)

@borrows
fn VpnProxyRequireConfigLiteralsAll(configText: str, literals: str[]): bool =
    for i in 0..<len(literals):
        if !strings.StrContains(configText, literals[i]):
            VpnProxyPrintErr(strutil.Join(["vpn proxy fixed server config: missing literal ", strings.CloneStr(literals[i])], ""))
            return false
    return true

fn VpnProxyLoadFixedProductionServerConfigInto(out: var VpnProxyConfig,
                                               configPathRaw: str): bool =
    if len(configPathRaw) <= 0:
        VpnProxyPrintErr("vpn proxy: missing --config")
        return false
    let configPathClone: str = strings.CloneStr(configPathRaw)
    let configText: str = chengpath.ReadTextFileViaHandle(configPathClone)
    if len(configText) <= 0:
        VpnProxyPrintErr("vpn proxy: failed to read fixed server config")
        return false
    var requiredLiterals: str[] = ["\"protocol\":\"hy2-tun-v1\"",
                                    "\"listen\":\"0.0.0.0:7443\"",
                                    "\"cert_der\":\"transport.cert.der\"",
                                    "\"key_pk8_der\":\"transport.key.pk8\"",
                                    "\"trust_root_der\":\"transport.root.der\"",
                                    "\"expected_auth_sha256\":\"25e8b2cf0aa570ef5e11ec1026782e297912bb0cc729dbef2290278b925b54a6\"",
                                    "\"expected_authority\":\"unimaker.fun\"",
                                    "\"cc_rx_text\":\"auto\"",
                                    "\"dns_server\":\"8.8.8.8\"",
                                    "\"auth_mode\":\"token_sha256\"",
                                    "\"disable_0rtt\":true",
                                    "\"enabled\":true",
                                    "\"host\":\"www.example.com\"",
                                    "\"path\":\"/\"",
                                    "\"status\":200",
                                    "\"body\":\"ok\""]
    if !VpnProxyRequireConfigLiteralsAll(configText, requiredLiterals):
        return false

    var serverCfg: VpnProxyIdentityConfig
    serverCfg.listen = "0.0.0.0:7443"
    serverCfg.certDer = "transport.cert.der"
    serverCfg.keyPk8Der = "transport.key.pk8"
    serverCfg.trustRootDer = "transport.root.der"
    serverCfg.expectedAuthSha256 = "25e8b2cf0aa570ef5e11ec1026782e297912bb0cc729dbef2290278b925b54a6"
    serverCfg.expectedAuthority = "unimaker.fun"
    serverCfg.ccRxText = "auto"
    serverCfg.dnsServer = "8.8.8.8"
    var securityCfg: VpnProxySecurityConfig
    securityCfg.authMode = "token_sha256"
    securityCfg.expectedAuthSha256 = "25e8b2cf0aa570ef5e11ec1026782e297912bb0cc729dbef2290278b925b54a6"
    securityCfg.clientCertMode = "off"
    securityCfg.disable0Rtt = true
    var masqueradeCfg: VpnProxyMasqueradeConfig
    masqueradeCfg.enabled = true
    masqueradeCfg.host = "www.example.com"
    masqueradeCfg.path = "/"
    masqueradeCfg.status = 200
    masqueradeCfg.body = "ok"
    var antiBlockCfg: VpnProxyAntiBlockConfig
    antiBlockCfg.masquerade = masqueradeCfg
    let isLocalArtifactsDir: bool = strings.StrContains(configPathRaw, "artifacts/vpn-proxy-local/")
    out.configPath = configPathRaw
    if isLocalArtifactsDir:
        out.configDir = "artifacts/vpn-proxy-local"
    else:
        out.configDir = "."
    out.protocol = "hy2-tun-v1"
    out.server = serverCfg
    out.security = securityCfg
    out.antiBlock = antiBlockCfg
    return true

fn VpnProxyIsPathSeparator(ch: char): bool =
    if ch == '/':
        return true
    if ch == '\\':
        return true
    return false

@borrows
fn VpnProxyIsWindowsDriveAbsolute(path: str): bool =
    if len(path) < 3:
        return false
    if path[1] != ':':
        return false
    return VpnProxyIsPathSeparator(path[2])

@borrows
fn VpnProxyResolvePath(baseDir: str, pathRaw: str): str =
    let trimmed: str = pathRaw
    if len(trimmed) <= 0:
        return ""
    if VpnProxyIsPathSeparator(trimmed[0]):
        return trimmed
    if VpnProxyIsWindowsDriveAbsolute(trimmed):
        return trimmed
    if len(baseDir) > 0:
        let last: char = baseDir[len(baseDir) - 1]
        if VpnProxyIsPathSeparator(last):
            return strutil.Join([strings.CloneStr(baseDir), strings.CloneStr(trimmed)], "")
        return strutil.Join([strings.CloneStr(baseDir), "/", strings.CloneStr(trimmed)], "")
    return chengpath.PathAbsolute(baseDir, trimmed)

fn VpnProxyConfigDirFromPath(configPath: str, parsedDir: str): str =
    var lastSep: int32 = -1
    for i in 0..<len(configPath):
        if VpnProxyIsPathSeparator(configPath[i]):
            lastSep = i
    if lastSep > 0:
        return strings.SliceBytes(configPath, 0, lastSep)
    if lastSep == 0:
        return strings.SliceBytes(configPath, 0, 1)
    if len(parsedDir) > 0 && parsedDir != ".":
        return parsedDir
    return chengpath.PathCurrentDir()

fn VpnProxySetTunStopRequested(stopRequested: bool) =
    VpnProxyTunStopRequested = stopRequested

fn VpnProxySetLocalProxyStopRequested(stopRequested: bool) =
    VpnProxyLocalProxyStopRequested = stopRequested
    var stopCode: int32
    if stopRequested:
        stopCode = 1
    let _ = VpnProxyMobileLocalProxyStopSet(stopCode)
    if !stopRequested:
        VpnProxyLocalProxyLastError = ""

fn VpnProxyLocalProxyShouldStop(): bool =
    if VpnProxyLocalProxyStopRequested:
        return true
    if VpnProxyMobileLocalProxyStopRequested() != 0:
        return true
    return false

fn VpnProxyRecordLocalProxyClientError(text: str) =
    VpnProxyLocalProxyLastError = text

fn VpnProxyLocalProxyLastClientError(): str =
    # ORCU2 defensive clone (mirror VpnProxyTunLastErrorText above): the only
    # caller is the GUI-thread @exportc status poll, while the proxy worker
    # thread reassigns this global on the client-error path. Returning the
    # global bare holds a borrowed handle across the SABI emit window.
    return strings.CloneStr(VpnProxyLocalProxyLastError)

@borrows
fn VpnProxyLoadLeafKeyKind(certDer: Bytes): Result[x509.X509PublicKeyKind] =
    var cert = x509.initX509Certificate()
    let parseRes: Result[bool] = x509.x509ParseCertificateInto(cert, certDer)
    if IsErr(parseRes):
        return Err[x509.X509PublicKeyKind](ErrorText(parseRes))
    if cert.publicKey.kind == x509.X509KeyUnknown:
        return Err[x509.X509PublicKeyKind]("vpn proxy: certificate public key kind missing")
    return Ok[x509.X509PublicKeyKind](cert.publicKey.kind)

@borrows
fn VpnProxyLoadIdentity(baseDir: str,
                          cfg: VpnProxyIdentityConfig,
                          requireListen: bool): Result[VpnProxyLoadedIdentity] =
    if requireListen && len(cfg.listen) <= 0:
        return Err[VpnProxyLoadedIdentity]("vpn proxy config: listen missing")
    if len(cfg.certDer) <= 0 || len(cfg.keyPk8Der) <= 0 || len(cfg.trustRootDer) <= 0:
        return Err[VpnProxyLoadedIdentity]("vpn proxy config: cert_der/key_pk8_der/trust_root_der required")
    var out = VpnProxyLoadedIdentity()
    let leafPath: str = VpnProxyResolvePath(baseDir, cfg.certDer)
    let leafRes: Result[Bytes] = VpnProxyLoadBytesFile(leafPath)
    if IsErr(leafRes):
        return Err[VpnProxyLoadedIdentity](ErrorText(leafRes))
    add(out.certs, Value(leafRes))
    for i in 0..<cfg.certChainDer.len:
        let path: str = VpnProxyResolvePath(baseDir, cfg.certChainDer[i])
        let certRes: Result[Bytes] = VpnProxyLoadBytesFile(path)
        if IsErr(certRes):
            return Err[VpnProxyLoadedIdentity](ErrorText(certRes))
        add(out.certs, Value(certRes))
    let keyPath: str = VpnProxyResolvePath(baseDir, cfg.keyPk8Der)
    let keyRes: Result[Bytes] = VpnProxyLoadBytesFile(keyPath)
    if IsErr(keyRes):
        return Err[VpnProxyLoadedIdentity](ErrorText(keyRes))
    out.privateKey = Value(keyRes)
    out.leafKeyKind = x509.X509KeyRsa
    let trustPath: str = VpnProxyResolvePath(baseDir, cfg.trustRootDer)
    let trustRes: Result[Bytes] = VpnProxyLoadBytesFile(trustPath)
    if IsErr(trustRes):
        return Err[VpnProxyLoadedIdentity](ErrorText(trustRes))
    add(out.trustRoots, Value(trustRes))
    for i in 0..<cfg.trustRootsDer.len:
        let path: str = VpnProxyResolvePath(baseDir, cfg.trustRootsDer[i])
        let rootRes: Result[Bytes] = VpnProxyLoadBytesFile(path)
        if IsErr(rootRes):
            return Err[VpnProxyLoadedIdentity](ErrorText(rootRes))
        add(out.trustRoots, Value(rootRes))
    return Ok[VpnProxyLoadedIdentity](out)

@borrows
fn VpnProxyBuildPolicy(identity: var VpnProxyLoadedIdentity,
                         serverName: str,
                         requireClientCertificate: bool,
                         sendClientCertificate: bool): Result[qpolicy.MsQuicTlsPolicy] =
    var out = qpolicy.initMsQuicTlsPolicy()
    out.serverName = serverName
    out.requireClientCertificate = requireClientCertificate
    out.sendClientCertificate = sendClientCertificate
    out.certPrivateKey = identity.privateKey
    out.certLeafKeyKind = identity.leafKeyKind
    if identity.certs.len > 0:
        out.certChain0 = identity.certs[0]
        out.certChainCount = 1
    if identity.certs.len > 1:
        out.certChain1 = identity.certs[1]
        out.certChainCount = 2
    if identity.certs.len > 2:
        out.certChain2 = identity.certs[2]
        out.certChainCount = 3
    if identity.certs.len > 3:
        out.certChain3 = identity.certs[3]
        out.certChainCount = 4
    if identity.trustRoots.len > 0:
        out.trustRoot0 = identity.trustRoots[0]
        out.trustRootsCount = 1
    if identity.trustRoots.len > 1:
        out.trustRoot1 = identity.trustRoots[1]
        out.trustRootsCount = 2
    if identity.trustRoots.len > 2:
        out.trustRoot2 = identity.trustRoots[2]
        out.trustRootsCount = 3
    if identity.trustRoots.len > 3:
        out.trustRoot3 = identity.trustRoots[3]
        out.trustRootsCount = 4
    return Ok[qpolicy.MsQuicTlsPolicy](out)

@borrows
fn VpnProxyBuildPolicyInto(out: var qpolicy.MsQuicTlsPolicy,
                           identity: var VpnProxyLoadedIdentity,
                           serverName: str,
                           requireClientCertificate: bool,
                           sendClientCertificate: bool): Result[bool] =
    qpolicy.initMsQuicTlsPolicyInto(out)
    out.serverName = strings.CloneStr(serverName)
    out.requireClientCertificate = requireClientCertificate
    out.sendClientCertificate = sendClientCertificate
    out.certPrivateKey = rawbytes.BytesSlice(identity.privateKey, 0, rawbytes.BytesLen(identity.privateKey))
    out.certLeafKeyKind = identity.leafKeyKind
    if identity.certs.len > 0:
        out.certChain0 = rawbytes.BytesSlice(identity.certs[0], 0, rawbytes.BytesLen(identity.certs[0]))
        out.certChainCount = 1
    if identity.certs.len > 1:
        out.certChain1 = rawbytes.BytesSlice(identity.certs[1], 0, rawbytes.BytesLen(identity.certs[1]))
        out.certChainCount = 2
    if identity.certs.len > 2:
        out.certChain2 = rawbytes.BytesSlice(identity.certs[2], 0, rawbytes.BytesLen(identity.certs[2]))
        out.certChainCount = 3
    if identity.certs.len > 3:
        out.certChain3 = rawbytes.BytesSlice(identity.certs[3], 0, rawbytes.BytesLen(identity.certs[3]))
        out.certChainCount = 4
    if identity.trustRoots.len > 0:
        out.trustRoot0 = rawbytes.BytesSlice(identity.trustRoots[0], 0, rawbytes.BytesLen(identity.trustRoots[0]))
        out.trustRootsCount = 1
    if identity.trustRoots.len > 1:
        out.trustRoot1 = rawbytes.BytesSlice(identity.trustRoots[1], 0, rawbytes.BytesLen(identity.trustRoots[1]))
        out.trustRootsCount = 2
    if identity.trustRoots.len > 2:
        out.trustRoot2 = rawbytes.BytesSlice(identity.trustRoots[2], 0, rawbytes.BytesLen(identity.trustRoots[2]))
        out.trustRootsCount = 3
    if identity.trustRoots.len > 3:
        out.trustRoot3 = rawbytes.BytesSlice(identity.trustRoots[3], 0, rawbytes.BytesLen(identity.trustRoots[3]))
        out.trustRootsCount = 4
    return Ok[bool](true)

@borrows
fn VpnProxyLoadedIdentityPresent(identity: var VpnProxyLoadedIdentity): bool =
    if identity.certs.len <= 0:
        return false
    if BytesLen(identity.privateKey) <= 0:
        return false
    if identity.leafKeyKind == x509.X509KeyUnknown:
        return false
    if identity.trustRoots.len <= 0:
        return false
    return true

@borrows
fn VpnProxyConfigSendsClientCertificate(config: VpnProxyConfig): bool =
    if config.security.clientCertMode == "required":
        return true
    if len(config.client.certDer) <= 0:
        return false
    if len(config.client.keyPk8Der) <= 0:
        return false
    return true

fn VpnProxyCloseQuicLink(link: var VpnProxyQuicLink) =
    if link.streamOpen:
        hy2sess.VpnProxyHy2TcpStreamClose(link.stream)
        link.streamOpen = false
    if link.conn.open:
        qconn.ConnClose(link.conn)
    link.exitIndex = -1

@borrows
fn VpnProxyDialExit(exitCfg: var VpnProxyExitConfig,
                      identity: var VpnProxyLoadedIdentity,
                      handshakeTimeoutMs: int32,
                      exitIndex: int32,
                      sendClientCertificate: bool): Result[VpnProxyQuicLink] =
    let addrRes = quic_transport.Libp2pQuicAddrFromHostPort(exitCfg.host, exitCfg.port)
    if IsErr(addrRes):
        return Err[VpnProxyQuicLink](ErrorText(addrRes))
    let policyRes: Result[qpolicy.MsQuicTlsPolicy] = VpnProxyBuildPolicy(identity, exitCfg.serverName, false, sendClientCertificate)
    if IsErr(policyRes):
        return Err[VpnProxyQuicLink](ErrorText(policyRes))
    var transport: qtransport.MsQuicTransport
    qtransport.InitMsQuicTransportInto(transport)
    let settingsRes: Result[bool] = VpnProxyApplyTransportSettings(transport, int64(handshakeTimeoutMs))
    if IsErr(settingsRes):
        return Err[VpnProxyQuicLink](ErrorText(settingsRes))
    let tlsRes: Result[bool] = qtransport.setMsQuicTransportTlsPolicy(transport, Value(policyRes))
    if IsErr(tlsRes):
        return Err[VpnProxyQuicLink](ErrorText(tlsRes))
    let dialRes = qtransport.dial(transport, Value(addrRes))
    if IsErr(dialRes):
        return Err[VpnProxyQuicLink](ErrorText(dialRes))
    var conn = Value(dialRes)
    let selectRes = quic_transport.Libp2pQuicClientSelectProtocolWithTimeout(transport,
                                                                               conn,
                                                                               VpnProxyProtocolId(),
                                                                               handshakeTimeoutMs)
    if IsErr(selectRes):
        qconn.ConnClose(conn)
        return Err[VpnProxyQuicLink](ErrorText(selectRes))
    var out: VpnProxyQuicLink
    out.transport = transport
    out.conn = conn
    out.tcpStreams = hy2sess.VpnProxyHy2NewTcpStreamAllocator()
    out.streamOpen = false
    out.exitIndex = exitIndex
    return Ok[VpnProxyQuicLink](out)

fn VpnProxyCloseTcpTlsForwardLink(link: var VpnProxyTcpTlsForwardLink) =
    if link.open:
        VpnProxyTunProbeMark("cA_tcp")
        tcp.TcpClose(link.conn)
    link.open = false
    link.exitIndex = -1
    if BytesLen(link.dialerProxyFramePending) > 0:
        VpnProxyTunProbeMark("cB_free_frame")
        BytesFree(link.dialerProxyFramePending)
    if BytesLen(link.dialerProxyDataPending) > 0:
        VpnProxyTunProbeMark("cC_free_data")
        BytesFree(link.dialerProxyDataPending)
    link.dialerProxyFramePending = BytesAlloc(0)
    link.dialerProxyDataPending = BytesAlloc(0)
    link.dialerProxyActive = false
    if BytesLen(link.relayTargetPending) > 0:
        BytesFree(link.relayTargetPending)
    if BytesLen(link.relayRemotePending) > 0:
        BytesFree(link.relayRemotePending)
    if BytesLen(link.relayRemoteOutPending) > 0:
        BytesFree(link.relayRemoteOutPending)
    link.relayTargetPending.data = nil
    link.relayTargetPending.len = 0
    link.relayRemotePending.data = nil
    link.relayRemotePending.len = 0
    link.relayRemoteOutPending.data = nil
    link.relayRemoteOutPending.len = 0
    VpnProxyTunProbeMark("cD_done")

@borrows
fn VpnProxyTcpTlsForwardDial(exitCfg: var VpnProxyExitConfig,
                             identity: var VpnProxyLoadedIdentity,
                             exitIndex: int32): Result[VpnProxyTcpTlsForwardLink] =
    if VpnProxyExitTransportText(exitCfg) != "tcp-tls-forward":
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy tcp-tls-forward: invalid transport")
    if identity.trustRoots.len <= 0:
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy tcp-tls-forward: trust root required")
    var connectRes: Result[tcp.TcpConnectionHandle]
    if strings.StrContains(exitCfg.host, ":"):
        connectRes = tcp.TcpConnect6Timeout(exitCfg.host, exitCfg.port, VpnProxyConnectTimeoutMs)
    else:
        connectRes = tcp.TcpConnect4Timeout(exitCfg.host, exitCfg.port, VpnProxyConnectTimeoutMs)
    if IsErr(connectRes):
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(connectRes))
    var out: VpnProxyTcpTlsForwardLink
    out.conn = Value(connectRes)
    out.streamId = 1
    out.open = true
    out.exitIndex = exitIndex
    var exitCfgOwned: VpnProxyExitConfig = VpnProxyCloneExitConfig(exitCfg)
    var identityOwned: VpnProxyLoadedIdentity = VpnProxyCloneLoadedIdentityForCall(identity)
    let handshakeRes: Result[bool] = VpnProxyTcpTlsForwardClientHandshakeOnLink(out,
                                                                                exitCfgOwned,
                                                                                identityOwned)
    if IsErr(handshakeRes):
        VpnProxyCloseTcpTlsForwardLink(out)
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(handshakeRes))
    return Ok[VpnProxyTcpTlsForwardLink](out)

# Device dial entry: every managed field is read straight from the exit
# array and cloned before crossing a call boundary. By-value VpnProxyExitConfig
# copies diverge on aarch64 (host strings arrive freed -> connect targets an
# empty host), so this path never passes the struct by value.
@borrows
fn VpnProxyTcpTlsForwardDialStates(states: var VpnProxyExitState[],
                                   identity: var VpnProxyLoadedIdentity,
                                   exitIndex: int32): Result[VpnProxyTcpTlsForwardLink] =
    if exitIndex < 0 || exitIndex >= states.len:
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy: invalid exit index")
    if VpnProxyExitTransportText(states[exitIndex].cfg) != "tcp-tls-forward":
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy tcp-tls-forward: invalid transport")
    if identity.trustRoots.len <= 0:
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy tcp-tls-forward: trust root required")
    let dialHost: str = strings.CloneStr(states[exitIndex].cfg.host)
    let dialPort: int32 = states[exitIndex].cfg.port
    let probeT0: int64 = VpnProxyMonoNowMs()
    var connectRes: Result[tcp.TcpConnectionHandle]
    if strings.StrContains(dialHost, ":"):
        connectRes = tcp.TcpConnect6Timeout(dialHost, dialPort, VpnProxyConnectTimeoutMs)
    else:
        connectRes = tcp.TcpConnect4Timeout(dialHost, dialPort, VpnProxyConnectTimeoutMs)
    if IsErr(connectRes):
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(connectRes))
    let _ = tcp.TcpSetNoDelay(Value(connectRes), true)
    VpnProxyTunRecordRelayError(strutil.Join(["PROBE dial_tcp=", strings.Int64ToStr(VpnProxyMonoNowMs() - probeT0)], ""))
    var out: VpnProxyTcpTlsForwardLink
    out.conn = Value(connectRes)
    out.streamId = 1
    out.open = true
    out.exitIndex = exitIndex
    let sniCopy: str = strings.CloneStr(states[exitIndex].cfg.serverName)
    let authCopy: str = strings.CloneStr(states[exitIndex].cfg.auth)
    let probeT1: int64 = VpnProxyMonoNowMs()
    let handshakeRes: Result[bool] = VpnProxyTcpTlsForwardClientHandshakeScalars(out,
                                                                                 sniCopy,
                                                                                 authCopy,
                                                                                 identity)
    VpnProxyTunRecordRelayError(strutil.Join(["PROBE dial_tls_auth=", strings.Int64ToStr(VpnProxyMonoNowMs() - probeT1)], ""))
    if IsErr(handshakeRes):
        VpnProxyCloseTcpTlsForwardLink(out)
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(handshakeRes))
    return Ok[VpnProxyTcpTlsForwardLink](out)

@borrows
fn VpnProxyExitAuthority(exitCfg: var VpnProxyExitConfig): str =
    let authorityText: str = strutil.Strip(exitCfg.authority)
    if len(authorityText) > 0:
        return authorityText
    return strutil.Strip(exitCfg.serverName)

@borrows
fn VpnProxyServerCcRxText(serverCfg: VpnProxyIdentityConfig): str =
    let text: str = strutil.Strip(serverCfg.ccRxText)
    if len(text) > 0:
        return text
    return "auto"

@borrows
fn VpnProxyExitTransportText(exitCfg: var VpnProxyExitConfig): str =
    let text: str = strutil.Strip(exitCfg.transport)
    if len(text) <= 0:
        return "udp-quic"
    return text

@borrows
fn VpnProxyRequireExitHy2Config(exitCfg: var VpnProxyExitConfig): Result[bool] =
    let transportText: str = VpnProxyExitTransportText(exitCfg)
    if transportText != "udp-quic":
        return Err[bool]("vpn proxy: hy2 requires udp-quic transport")
    let authText: str = strutil.Strip(exitCfg.auth)
    let authLen: int32 = len(authText)
    if authLen <= 0:
        return Err[bool]("vpn proxy: exit auth missing")
    let authorityText: str = VpnProxyExitAuthority(exitCfg)
    let authorityLen: int32 = len(authorityText)
    if authorityLen <= 0:
        return Err[bool]("vpn proxy: exit authority missing")
    if exitCfg.ccRx <= 0:
        return Err[bool]("vpn proxy: exit cc_rx invalid")
    return Ok[bool](true)

@borrows
fn VpnProxyRequireExitClientConfig(exitCfg: var VpnProxyExitConfig): Result[bool] =
    let authText: str = strutil.Strip(exitCfg.auth)
    if len(authText) <= 0:
        return Err[bool]("vpn proxy: exit auth missing")
    if len(strutil.Strip(exitCfg.serverName)) <= 0:
        return Err[bool]("vpn proxy: exit server_name missing")
    if exitCfg.port <= 0 || exitCfg.port > 65535:
        return Err[bool]("vpn proxy: exit port invalid")
    if len(strutil.Strip(exitCfg.host)) <= 0:
        return Err[bool]("vpn proxy: exit host missing")
    let transportText: str = VpnProxyExitTransportText(exitCfg)
    if len(strutil.Strip(exitCfg.dialerProxy)) > 0 && transportText != "tcp-tls-forward":
        return Err[bool]("vpn proxy: dialer_proxy requires tcp-tls-forward exit")
    if transportText == "udp-quic":
        return VpnProxyRequireExitHy2Config(exitCfg)
    if transportText == "tcp-tls-forward":
        if len(authText) < 32:
            return Err[bool]("vpn proxy: exit auth token too short")
        return Ok[bool](true)
    return Err[bool]("vpn proxy: unsupported exit transport")

@borrows
fn VpnProxyRequireServerHy2Config(serverCfg: VpnProxyIdentityConfig): Result[bool] =
    let expectedAuthText: str = serverCfg.expectedAuth
    let expectedAuthShaText: str = serverCfg.expectedAuthSha256
    if len(expectedAuthShaText) > 0 && !VpnProxyIsHexSha256(expectedAuthShaText):
        return Err[bool]("vpn proxy: server expected_auth_sha256 invalid")
    if len(expectedAuthText) <= 0 && len(expectedAuthShaText) <= 0:
        return Err[bool]("vpn proxy: server expected auth missing")
    return Ok[bool](true)

@borrows
fn VpnProxyTargetAddress(target: var VpnProxyTarget): str =
    # The str[]-literal + Join form crosses a call boundary with a managed
    # array and produced empty/garbage addresses on arm64-android — the same
    # corruption class as the fake-DNS question name (see lessons.md). Build
    # host + ":" + port (bracketed IPv6 literals kept) in ONE owned bytes
    # buffer and convert once with BytesToString.
    let portText: str = strings.IntToStr(target.port)
    let hostLen: int32 = len(target.host)
    let hasColon: bool = strings.StrContains(target.host, ":")
    let portLen: int32 = len(portText)
    var total: int32 = hostLen + portLen + 1
    if hasColon:
        total = total + 2
    var buf: rawbytes.Bytes = rawbytes.BytesAlloc(total)
    var offset: int32
    if hasColon:
        rawbytes.BytesSet(buf, offset, 91)
        offset = offset + 1
    if hostLen > 0:
        var hostView: rawbytes.Bytes = rawbytes.BytesView(StrDataPtr(target.host), hostLen)
        rawbytes.BytesCopyRangeInto(buf, offset, hostView, 0, hostLen)
        offset = offset + hostLen
    if hasColon:
        rawbytes.BytesSet(buf, offset, 93)
    else:
        rawbytes.BytesSet(buf, offset, 58)
    offset = offset + 1
    var portView: rawbytes.Bytes = rawbytes.BytesView(StrDataPtr(portText), portLen)
    rawbytes.BytesCopyRangeInto(buf, offset, portView, 0, portLen)
    var sliced: rawbytes.Bytes = rawbytes.BytesSlice(buf, 0, total)
    let outText: str = rawbytes.BytesToString(sliced)
    rawbytes.BytesFree(sliced)
    rawbytes.BytesFree(buf)
    return outText

@borrows
fn VpnProxyTargetFromAddressScalars(address: str, outHost: var str, outPort: var int32): Result[bool] =
    return listen.VpnProxyParseListenAddressInto(address, outHost, outPort)

fn VpnProxyTargetFromAddress(address: str): Result[VpnProxyTarget] =
    let parsedRes: Result[listen.VpnProxyListenAddress] = listen.VpnProxyParseListenAddress(address)
    if IsErr(parsedRes):
        return Err[VpnProxyTarget](ErrorText(parsedRes))
    let parsed: listen.VpnProxyListenAddress = Value(parsedRes)
    var out: VpnProxyTarget
    out.host = parsed.host
    out.port = parsed.port
    return Ok[VpnProxyTarget](out)

@borrows
# [thruput-window] target socket 接收缓冲显式扩容: 自动调在高 RTT 间歇读
# 场景会陷入低窗口稳态(PUMPRATE 定谳: target 供数 ~13KB/s 与出帧同步,
# carrier 写侧零积压)。4MB 堆 Bytes 传指针(&本地标量是冷后端野指针雷区)。
fn VpnProxyTargetSocketTune(conn: var tcp.TcpConnectionHandle) =
    var rcvBytes: Bytes = BytesAlloc(4)
    if rcvBytes.data == nil:
        return
    BytesSet(rcvBytes, 0, 0)
    BytesSet(rcvBytes, 1, 0)
    BytesSet(rcvBytes, 2, 64)
    BytesSet(rcvBytes, 3, 0)
    let _ = os.udpSetSockOptIntFd(conn.fd, 1, 8, rcvBytes)
    BytesFree(rcvBytes)

fn VpnProxyConnectTargetTcp(target: VpnProxyTarget): Result[tcp.TcpConnectionHandle] =
    if strings.StrContains(target.host, ":"):
        let v6Res: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect6Timeout(strings.CloneStr(target.host), target.port, VpnProxyConnectTimeoutMs)
        if IsOk(v6Res):
            var v6Conn: tcp.TcpConnectionHandle = Value(v6Res)
            VpnProxyTargetSocketTune(v6Conn)
            return Ok[tcp.TcpConnectionHandle](v6Conn)
        return Err[tcp.TcpConnectionHandle](ErrorText(v6Res))
    if exitdns.VpnProxyExitDnsHostIsIpv4Literal(target.host):
        let litRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4Timeout(strings.CloneStr(target.host), target.port, VpnProxyConnectTimeoutMs)
        if IsOk(litRes):
            var litConn: tcp.TcpConnectionHandle = Value(litRes)
            VpnProxyTargetSocketTune(litConn)
            return Ok[tcp.TcpConnectionHandle](litConn)
        return Err[tcp.TcpConnectionHandle](ErrorText(litRes))
    let resolvedRes: Result[str] = exitdns.VpnProxyExitDnsResolveIpv4(strings.CloneStr(target.host))
    if IsErr(resolvedRes):
        return Err[tcp.TcpConnectionHandle](ErrorText(resolvedRes))
    var resolvedOwned: str = Value(resolvedRes)
    let dnsRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4Timeout(resolvedOwned, target.port, VpnProxyConnectTimeoutMs)
    if IsOk(dnsRes):
        var dnsConn: tcp.TcpConnectionHandle = Value(dnsRes)
        VpnProxyTargetSocketTune(dnsConn)
        return Ok[tcp.TcpConnectionHandle](dnsConn)
    return Err[tcp.TcpConnectionHandle](ErrorText(dnsRes))

@borrows
fn VpnProxyHy2ClientHandshake(base: var qconn.Connection,
                                exitCfg: var VpnProxyExitConfig): Result[Hysteria2AuthResponse] =
    let cfgRes: Result[bool] = VpnProxyRequireExitHy2Config(exitCfg)
    if IsErr(cfgRes):
        return Err[Hysteria2AuthResponse](ErrorText(cfgRes))
    let preambleWriteRes: Result[bool] = hy2sess.VpnProxyHy2ClientSendPreamble(base)
    if IsErr(preambleWriteRes):
        return Err[Hysteria2AuthResponse](ErrorText(preambleWriteRes))
    let preambleReadRes: Result[bool] = hy2sess.VpnProxyHy2ClientExpectServerPreamble(base)
    if IsErr(preambleReadRes):
        return Err[Hysteria2AuthResponse](ErrorText(preambleReadRes))
    let authRes = hy2sess.VpnProxyHy2ClientAuth(base,
                                                  VpnProxyExitAuthority(exitCfg),
                                                  exitCfg.auth,
                                                  int64(exitCfg.ccRx),
                                                  "")
    if IsErr(authRes):
        return Err[Hysteria2AuthResponse](ErrorText(authRes))
    let authResp = Value(authRes)
    if authResp.statusCode != VpnProxyHy2AuthOkStatus:
        return Err[Hysteria2AuthResponse]("vpn proxy: exit auth rejected")
    return Ok[Hysteria2AuthResponse](authResp)

@borrows
fn VpnProxyHy2OpenTargetStream(base: var qconn.Connection,
                                 target: var VpnProxyTarget,
                                 streamId: int64): Result[VpnProxyHy2TcpStream] =
    # Same preflight as the tcp-tls-forward path: reject corrupted targets
    # before they reach the wire. Server logs showed "<junk>8080<space>:8080"
    # addresses arriving through THIS channel under load.
    if len(target.host) <= 0:
        VpnProxyTunRecordRelayError("ofh_host_empty")
        return Err[VpnProxyHy2TcpStream]("vpn proxy: open target host empty")
    let addrProbeText: str = VpnProxyTargetAddress(target)
    let addrProbeRes: Result[listen.VpnProxyListenAddress] = listen.VpnProxyParseListenAddress(strings.CloneStr(addrProbeText))
    if IsErr(addrProbeRes):
        VpnProxyTunRecordRelayError("ofh_addr_invalid")
        return Err[VpnProxyHy2TcpStream]("vpn proxy: open target address unparsable")
    let streamRes: Result[VpnProxyHy2TcpStream] = hy2sess.VpnProxyHy2OpenTcpStream(base, streamId)
    if IsErr(streamRes):
        return Err[VpnProxyHy2TcpStream](ErrorText(streamRes))
    var stream = Value(streamRes)
    var emptyPadding: Bytes
    emptyPadding.data = nil
    emptyPadding.len = 0
    let reqWriteRes: Result[bool] = hy2sess.VpnProxyHy2TcpStreamWriteRequest(stream,
                                                                               addrProbeText,
                                                                               emptyPadding)
    if IsErr(reqWriteRes):
        return Err[VpnProxyHy2TcpStream](ErrorText(reqWriteRes))
    let respRes = hy2sess.VpnProxyHy2TcpStreamReadResponse(stream)
    if IsErr(respRes):
        return Err[VpnProxyHy2TcpStream](ErrorText(respRes))
    let resp = Value(respRes)
    if !resp.ok:
        let messageText: str = strutil.Strip(resp.message)
        if len(messageText) > 0:
            return Err[VpnProxyHy2TcpStream](messageText)
        return Err[VpnProxyHy2TcpStream]("vpn proxy: remote target open failed")
    return Ok[VpnProxyHy2TcpStream](stream)

@borrows
fn VpnProxyHy2ProbeAt(base: var qconn.Connection,
                        streamId: int64): Result[bool] =
    var emptyPadding: Bytes
    emptyPadding.data = nil
    emptyPadding.len = 0
    let reqWriteRes: Result[bool] = hy2sess.VpnProxyHy2ClientWriteTcpRequest(base,
                                                                                streamId,
                                                                                VpnProxyHy2ProbeAddress,
                                                                                emptyPadding)
    if IsErr(reqWriteRes):
        return Err[bool](ErrorText(reqWriteRes))
    let respRes = hy2sess.VpnProxyHy2ClientReadTcpResponse(base, streamId)
    if IsErr(respRes):
        return Err[bool](ErrorText(respRes))
    let resp = Value(respRes).resp
    if !resp.ok:
        let messageText: str = strutil.Strip(resp.message)
        if len(messageText) > 0:
            return Err[bool](messageText)
        return Err[bool]("vpn proxy: exit probe rejected")
    return Ok[bool](true)

@borrows
fn VpnProxyHy2Probe(base: var qconn.Connection): Result[bool] =
    return VpnProxyHy2ProbeAt(base, VpnProxyHy2TcpStreamId)

@borrows
fn VpnProxyHy2ServerAuth(base: var qconn.Connection,
                           serverCfg: VpnProxyIdentityConfig,
                           masquerade: VpnProxyMasqueradeConfig): Result[bool] =
    let cfgRes: Result[bool] = VpnProxyRequireServerHy2Config(serverCfg)
    if IsErr(cfgRes):
        return Err[bool](ErrorText(cfgRes))
    let preambleWriteRes: Result[bool] = hy2sess.VpnProxyHy2ServerSendPreamble(base)
    if IsErr(preambleWriteRes):
        return Err[bool](ErrorText(preambleWriteRes))
    let preambleReadRes: Result[bool] = hy2sess.VpnProxyHy2ServerExpectClientPreamble(base)
    if IsErr(preambleReadRes):
        return Err[bool](ErrorText(preambleReadRes))
    let authReqRes = hy2sess.VpnProxyHy2ServerReadAuth(base)
    if IsErr(authReqRes):
        return Err[bool](ErrorText(authReqRes))
    let authReq = Value(authReqRes)
    let expectedAuthorityText: str = strutil.Strip(serverCfg.expectedAuthority)
    if !VpnProxyAuthMatches(authReq.auth, serverCfg.expectedAuth, serverCfg.expectedAuthSha256) ||
       (len(expectedAuthorityText) > 0 && authReq.authority != expectedAuthorityText):
        var bodyText: str = "<html><body>ok</body></html>"
        var statusCode: int32 = 200
        if masquerade.enabled:
            bodyText = masquerade.body
            statusCode = masquerade.status
        let _ = hy2sess.VpnProxyHy2ServerWriteMasqueradeResponse(base,
                                                                   statusCode,
                                                                   bodyText)
        return Err[bool]("vpn proxy exit: auth rejected")
    let authRespRes: Result[bool] = hy2sess.VpnProxyHy2ServerWriteAuthResponse(base,
                                                                                  VpnProxyHy2AuthOkStatus,
                                                                                  true,
                                                                                  VpnProxyServerCcRxText(serverCfg),
                                                                                  "")
    if IsErr(authRespRes):
        return Err[bool](ErrorText(authRespRes))
    return Ok[bool](true)

@borrows
fn VpnProxyWouldBlockQuic(err: str): bool =
    if err == "msquic udp: queue empty":
        return true
    if err == "pipe: empty":
        return true
    if err == "connection: empty":
        return true
    return false

fn VpnProxyTcpReadExact(conn: var tcp.TcpConnectionHandle, count: int32): Result[Bytes] =
    var out: Bytes
    let fillRes: Result[bool] = VpnProxyTcpReadExactInto(conn, count, out)
    if IsErr(fillRes):
        return Err[Bytes](ErrorText(fillRes))
    return Ok[Bytes](out)

fn VpnProxyTcpReadExactInto(conn: var tcp.TcpConnectionHandle,
                            count: int32,
                            out: var Bytes): Result[bool] =
    if count <= 0:
        out = BytesAlloc(0)
        return Ok[bool](true)
    out = BytesAlloc(count)
    var filled: int32
    while filled < count:
        let dstPtr: ptr = rawmem_support.RawmemPtrAdd(out.data, filled)
        let readRes: Result[int32] = tcp.TcpRecvRaw(conn, dstPtr, count - filled)
        if IsErr(readRes):
            return Err[bool](ErrorText(readRes))
        let got: int32 = Value(readRes)
        if got <= 0:
            # SCOPED DIAGNOSTIC: mark which exact stage hit EOF. REVERT.
            return Err[bool](strings.ConcatStr("vpn proxy: unexpected tcp eof at filled=", strings.ConcatStr(strings.Int64ToStr(filled), strings.ConcatStr("/", strings.Int64ToStr(count)))))
        filled = filled + got
    return Ok[bool](true)

# [tls-hdr-hunt] 错误现场取证: 打印缓冲区前 N 字节(十进制逗号列表),
# 用于判定 invalid tls record length 是帧界偏移(读到 payload 内容)还是
# 随机垃圾(堆腐蚀)。仅错误冷路径调用。
# [cold-shape] 以 (ptr,len) 标量传参(VpnProxyRelayJoinPending 同款):
# var 聚合/字段投影非 address-free, 不可按 byval Bytes 聚合拷出。
fn VpnProxyTlsHeaderDumpText(dataPtr: ptr, dataLen: int32, maxBytes: int32): str =
    var view: Bytes
    view.data = dataPtr
    view.len = dataLen
    var out: str
    var n: int32 = view.len
    if n > maxBytes:
        n = maxBytes
    var i: int32
    while i < n:
        out = out + strings.Int64ToStr(int64(BytesGet(view, i) & 255))
        if i + 1 < n:
            out = out + ","
        i = i + 1
    return out

fn VpnProxyTcpReadExactStopAware(conn: var tcp.TcpConnectionHandle,
                                 count: int32,
                                 timeoutMs: int32): Result[Bytes] =
    if count <= 0:
        return Ok[Bytes](BytesAlloc(0))
    let nbRes: Result[bool] = tcp.TcpSetNonblocking(conn, true)
    if IsErr(nbRes):
        return Err[Bytes](ErrorText(nbRes))
    let out: Bytes = BytesAlloc(count)
    var filled: int32
    var deadlineMs: int64
    if timeoutMs > 0:
        deadlineMs = VpnProxyMonoNowMs() + int64(timeoutMs)
    while filled < count:
        if VpnProxyLocalProxyShouldStop():
            return Err[Bytes]("vpn proxy: local proxy stopped")
        var waitMs: int32 = -1
        if timeoutMs > 0:
            let remainingMs: int64 = deadlineMs - VpnProxyMonoNowMs()
            if remainingMs <= 0:
                return Err[Bytes]("vpn proxy tcp-tls-forward: read timeout")
            waitMs = int32(remainingMs)
        let readyRes: Result[bool] = tcp.TcpConnectionWaitReadable(conn, waitMs)
        if IsErr(readyRes):
            return Err[Bytes](ErrorText(readyRes))
        if VpnProxyLocalProxyShouldStop():
            return Err[Bytes]("vpn proxy: local proxy stopped")
        if !Value(readyRes):
            continue
        let dstPtr: ptr = rawmem_support.RawmemPtrAdd(out.data, filled)
        let readRes: Result[int32] = tcp.TcpRecvRawNonblocking(conn, dstPtr, count - filled)
        if IsErr(readRes):
            if ErrorText(readRes) != "tcp syscall: would block":
                return Err[Bytes](ErrorText(readRes))
        else:
            let got: int32 = Value(readRes)
            if got <= 0:
                return Err[Bytes](strutil.Join(["vpn proxy: unexpected tcp eof at filled=", strings.Int64ToStr(filled), "/", strings.Int64ToStr(count)], ""))
            filled = filled + got
            if filled >= count:
                let blockRes: Result[bool] = tcp.TcpSetNonblocking(conn, false)
                if IsErr(blockRes):
                    return Err[Bytes](ErrorText(blockRes))
                return Ok[Bytes](out)
    return Ok[Bytes](out)

fn VpnProxyTcpWriteAll(conn: var tcp.TcpConnectionHandle, data: var Bytes): Result[int32] =
    # [partial-write fix] 单次 send 在大记录(8KB 级上行)与非阻塞套接字下必然
    # 出现部分写: 只发 423/8244 后放弃尾部=隧道流截断(服务器 'eof at filled=423/8239'
    # 铁证)。循环直至全部写出; EAGAIN 短歇重试。
    # [teardown-race] fd 预检: 拆除竞态下对已关 fd 发送=bad fd err。
    if conn.fd < 0:
        return Err[int32]("tcp syscall: fd already closed")
    var sent: int32
    # [spin-wd] EAGAIN 自旋 5s 上限: 健康 TCP 的发送窗不会持续 5s 打不开,
    # 超时=对端冻结/fd 状态腐烂(aarch64 错译家族现场), 报错断链让上层
    # 重置会话, 替代原来的永久自旋(死旋线程累积的来源之一)。
    var spinStartMs: int64
    # [spin-wd] 自旋迭代心跳: 每 1000 次不可写迭代落一条 WDWSPIN(trace 门控
    # 内), 死旋现场可见循环卡点与推进速率; 与 5s 超时互补(超时只报终态)。
    var spinIters: int32
    while sent < rawbytes.BytesLen(data):
        let chunkPtr: ptr = rawmem_support.RawmemPtrAdd(data.data, sent)
        let sendRes: Result[int32] = tcp.TcpSendRaw(conn, chunkPtr, rawbytes.BytesLen(data) - sent)
        if IsErr(sendRes):
            if ErrorText(sendRes) == "tcp syscall: would block":
                if spinStartMs == 0:
                    spinStartMs = VpnProxyMonoNowMs()
                elif VpnProxyMonoNowMs() - spinStartMs > int64(5000):
                    VpnProxyTunWatchdogRecord(strings.ConcatStr("WDWALL fd=", strings.ConcatStr(strings.Int64ToStr(int64(conn.fd)), strings.ConcatStr(" sent=", strings.ConcatStr(strings.Int64ToStr(int64(sent)), strings.ConcatStr(" total=", strings.Int64ToStr(int64(rawbytes.BytesLen(data)))))))))
                    VpnProxyPrintErr(strings.ConcatStr("tcp write spin timeout fd=", strings.Int64ToStr(int64(conn.fd))))
                    return Err[int32]("tcp write spin timeout")
                spinIters = spinIters + 1
                if spinIters >= 1000:
                    spinIters = 0
                    if vpnTunTraceEnabled:
                        VpnProxyTunRecordRelayError(strings.ConcatStr("WDWSPIN fd=", strings.ConcatStr(strings.Int64ToStr(int64(conn.fd)), strings.ConcatStr(" sent=", strings.ConcatStr(strings.Int64ToStr(int64(sent)), strings.ConcatStr(" total=", strings.Int64ToStr(int64(rawbytes.BytesLen(data)))))))))
                os.SleepMs(1)
                continue
            return Err[bool](ErrorText(sendRes))
        let wrote: int32 = Value(sendRes)
        if wrote <= 0:
            if spinStartMs == 0:
                spinStartMs = VpnProxyMonoNowMs()
            elif VpnProxyMonoNowMs() - spinStartMs > int64(5000):
                VpnProxyTunWatchdogRecord(strings.ConcatStr("WDWALL0 fd=", strings.ConcatStr(strings.Int64ToStr(int64(conn.fd)), strings.ConcatStr(" sent=", strings.ConcatStr(strings.Int64ToStr(int64(sent)), strings.ConcatStr(" total=", strings.Int64ToStr(int64(rawbytes.BytesLen(data)))))))))
                VpnProxyPrintErr(strings.ConcatStr("tcp write spin timeout fd=", strings.Int64ToStr(int64(conn.fd))))
                return Err[int32]("tcp write spin timeout")
            spinIters = spinIters + 1
            if spinIters >= 1000:
                spinIters = 0
                if vpnTunTraceEnabled:
                    VpnProxyTunRecordRelayError(strings.ConcatStr("WDWSPIN0 fd=", strings.ConcatStr(strings.Int64ToStr(int64(conn.fd)), strings.ConcatStr(" sent=", strings.ConcatStr(strings.Int64ToStr(int64(sent)), strings.ConcatStr(" total=", strings.Int64ToStr(int64(rawbytes.BytesLen(data)))))))))
            os.SleepMs(1)
            continue
        spinStartMs = 0
        sent = sent + wrote
    return Ok[int32](sent)

fn VpnProxyTcpTlsRecordPayloadLen(header: Bytes): int32 =
    var value: int32
    value = (VpnProxyBytesRawGet(header, 3) & 255) << 8
    value = value | (VpnProxyBytesRawGet(header, 4) & 255)
    return value

fn VpnProxyTcpTlsReadRecord(conn: var tcp.TcpConnectionHandle): Result[Bytes] =
    var out: Bytes
    let fillRes: Result[bool] = VpnProxyTcpTlsReadRecordInto(conn, out)
    if IsErr(fillRes):
        return Err[Bytes](ErrorText(fillRes))
    return Ok[Bytes](out)

fn VpnProxyTcpTlsReadRecordInto(conn: var tcp.TcpConnectionHandle,
                                out: var Bytes): Result[bool] =
    let recordRes: Result[Bytes] = VpnProxyTcpTlsReadRecordStopAware(conn,
                                                                      VpnProxyConnectTimeoutMs)
    if IsErr(recordRes):
        return Err[bool](ErrorText(recordRes))
    out = Value(recordRes)
    return Ok[bool](true)

fn VpnProxyTcpTlsReadRecordStopAware(conn: var tcp.TcpConnectionHandle,
                                     timeoutMs: int32): Result[Bytes] =
    let headerRes: Result[Bytes] = VpnProxyTcpReadExactStopAware(conn, 5, timeoutMs)
    if IsErr(headerRes):
        return Err[Bytes](ErrorText(headerRes))
    let header: Bytes = Value(headerRes)
    let payloadLen: int32 = VpnProxyTcpTlsRecordPayloadLen(header)
    if payloadLen < 0 || payloadLen > 16401:
        # [tls-hdr-hunt] 记录头取证: 判定帧界偏移 vs 随机垃圾。
        VpnProxyPrintErr(strutil.Join(["TLSHDR site=record fd=", strings.Int64ToStr(int64(conn.fd)), " declared=", strings.Int64ToStr(int64(payloadLen)), " head=", VpnProxyTlsHeaderDumpText(header.data, BytesLen(header), 16)], ""))
        return Err[Bytes]("vpn proxy tcp-tls-forward: invalid tls record length")
    let payloadRes: Result[Bytes] = VpnProxyTcpReadExactStopAware(conn, payloadLen, timeoutMs)
    if IsErr(payloadRes):
        return Err[Bytes](ErrorText(payloadRes))
    return Ok[Bytes](VpnProxyBytesConcat(header, Value(payloadRes)))

fn VpnProxyTcpTlsReadDialerProxyBytesStopAware(link: var VpnProxyTcpTlsForwardLink,
                                               count: int32,
                                               timeoutMs: int32): Result[Bytes] =
    if count <= 0:
        return Ok[Bytes](BytesAlloc(0))
    let nonblockingRes: Result[bool] = tcp.TcpSetNonblocking(link.conn, true)
    if IsErr(nonblockingRes):
        return Err[Bytes](ErrorText(nonblockingRes))
    var deadlineMs: int64
    if timeoutMs > 0:
        deadlineMs = VpnProxyMonoNowMs() + int64(timeoutMs)
    var pending: Bytes = BytesSlice(link.dialerProxyDataPending, 0, BytesLen(link.dialerProxyDataPending))
    while BytesLen(pending) < count:
        if VpnProxyLocalProxyShouldStop():
            link.dialerProxyDataPending = pending
            return Err[Bytes]("vpn proxy: local proxy stopped")
        if timeoutMs > 0 && VpnProxyMonoNowMs() >= deadlineMs:
            link.dialerProxyDataPending = pending
            return Err[Bytes]("vpn proxy tcp-tls-forward: read timeout")
        let frameRes: Result[bool] = VpnProxyTcpTlsTryReadDialerProxyPayloadFrameNonblocking(link,
                                                                                              pending)
        link.dialerProxyDataPending = pending
        if IsErr(frameRes):
            return Err[Bytes](ErrorText(frameRes))
        if !Value(frameRes):
            os.SleepMs(1)
    # [relay-owned] out 与剩余字节都做 owned 拷贝: BytesSlice/DropPrefix 返回
    # 内点视图, 底座一旦释放即悬垂, 后续 free = 内点释放(foreign pointer)。
    var out: Bytes = BytesAlloc(count)
    var outIdx: int32
    while outIdx < count:
        BytesSet(out, outIdx, BytesGet(link.dialerProxyDataPending, outIdx) & 255)
        outIdx = outIdx + 1
    var remainLen: int32 = BytesLen(link.dialerProxyDataPending) - count
    var restOwned: Bytes = BytesAlloc(0)
    if remainLen > 0:
        restOwned = BytesAlloc(remainLen)
        var cpRestIdx: int32
        while cpRestIdx < remainLen:
            BytesSet(restOwned, cpRestIdx, BytesGet(link.dialerProxyDataPending, count + cpRestIdx) & 255)
            cpRestIdx = cpRestIdx + 1
    BytesFree(link.dialerProxyDataPending)
    link.dialerProxyDataPending.data = restOwned.data
    link.dialerProxyDataPending.len = restOwned.len
    restOwned.data = nil
    restOwned.len = 0
    return Ok[Bytes](out)

fn VpnProxyTcpTlsReadDialerProxyRecordStopAware(link: var VpnProxyTcpTlsForwardLink,
                                                pending: var Bytes,
                                                timeoutMs: int32): Result[Bytes] =
    let nonblockingRes: Result[bool] = tcp.TcpSetNonblocking(link.conn, true)
    if IsErr(nonblockingRes):
        return Err[Bytes](ErrorText(nonblockingRes))
    var deadlineMs: int64
    if timeoutMs > 0:
        deadlineMs = VpnProxyMonoNowMs() + int64(timeoutMs)
    while BytesLen(pending) < 5:
        if VpnProxyLocalProxyShouldStop():
            return Err[Bytes]("vpn proxy: local proxy stopped")
        if timeoutMs > 0 && VpnProxyMonoNowMs() >= deadlineMs:
            return Err[Bytes]("vpn proxy tcp-tls-forward: read timeout")
        let frameRes: Result[bool] = VpnProxyTcpTlsTryReadDialerProxyPayloadFrameNonblocking(link,
                                                                                              pending)
        if IsErr(frameRes):
            return Err[Bytes](ErrorText(frameRes))
        if !Value(frameRes):
            os.SleepMs(1)
    let header: Bytes = BytesSlice(pending, 0, 5)
    let payloadLen: int32 = VpnProxyTcpTlsRecordPayloadLen(header)
    if payloadLen < 0 || payloadLen > 16401:
        # [tls-hdr-hunt] 记录头取证: 判定帧界偏移 vs 随机垃圾。
        VpnProxyPrintErr(strutil.Join(["TLSHDR site=dialerrec fd=", strings.Int64ToStr(int64(link.conn.fd)), " declared=", strings.Int64ToStr(int64(payloadLen)), " plen=", strings.Int64ToStr(int64(BytesLen(pending))), " head=", VpnProxyTlsHeaderDumpText(pending.data, BytesLen(pending), 16)], ""))
        return Err[Bytes]("vpn proxy tcp-tls-forward: invalid tls record length")
    let recordLen: int32 = 5 + payloadLen
    while BytesLen(pending) < recordLen:
        if VpnProxyLocalProxyShouldStop():
            return Err[Bytes]("vpn proxy: local proxy stopped")
        if timeoutMs > 0 && VpnProxyMonoNowMs() >= deadlineMs:
            return Err[Bytes]("vpn proxy tcp-tls-forward: read timeout")
        let frameRes2: Result[bool] = VpnProxyTcpTlsTryReadDialerProxyPayloadFrameNonblocking(link,
                                                                                              pending)
        if IsErr(frameRes2):
            return Err[Bytes](ErrorText(frameRes2))
        if !Value(frameRes2):
            os.SleepMs(1)
    # [relay-owned] out 改 owned 拷贝; 剩余改 owned consume+free 旧底座
    # (原形: out 视图+DropPrefix 内点存回 var 形参, 底座泄漏且后续 free 内点)。
    var out: Bytes = BytesAlloc(recordLen)
    var outIdx2: int32
    while outIdx2 < recordLen:
        BytesSet(out, outIdx2, BytesGet(pending, outIdx2) & 255)
        outIdx2 = outIdx2 + 1
    var remainLen2: int32 = BytesLen(pending) - recordLen
    var restOwned2: Bytes = BytesAlloc(0)
    if remainLen2 > 0:
        restOwned2 = BytesAlloc(remainLen2)
        var cpRestIdx2: int32
        while cpRestIdx2 < remainLen2:
            BytesSet(restOwned2, cpRestIdx2, BytesGet(pending, recordLen + cpRestIdx2) & 255)
            cpRestIdx2 = cpRestIdx2 + 1
    BytesFree(pending)
    pending.data = restOwned2.data
    pending.len = restOwned2.len
    restOwned2.data = nil
    restOwned2.len = 0
    return Ok[Bytes](out)

fn VpnProxyTcpTlsReadDialerProxyRecordValueStopAware(link: var VpnProxyTcpTlsForwardLink,
                                                     pendingIn: Bytes,
                                                     timeoutMs: int32): Result[VpnProxyTcpTlsDialerRecordRead] =
    let nonblockingRes: Result[bool] = tcp.TcpSetNonblocking(link.conn, true)
    if IsErr(nonblockingRes):
        return Err[VpnProxyTcpTlsDialerRecordRead](ErrorText(nonblockingRes))
    var deadlineMs: int64
    if timeoutMs > 0:
        deadlineMs = VpnProxyMonoNowMs() + int64(timeoutMs)
    var pending: Bytes = pendingIn
    while BytesLen(pending) < 5:
        if VpnProxyLocalProxyShouldStop():
            return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy: local proxy stopped")
        if timeoutMs > 0 && VpnProxyMonoNowMs() >= deadlineMs:
            return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy tcp-tls-forward: read timeout")
        var frame: ttf.VpnProxyTcpTlsForwardFrame
        var framePending: Bytes = link.dialerProxyFramePending
        let frameRes: Result[bool] = VpnProxyTcpTlsTryReadFrameNonblockingRaw(link.conn,
                                                                               link.dialerProxyRecvKeys,
                                                                               framePending,
                                                                               frame)
        link.dialerProxyFramePending = framePending
        if IsErr(frameRes):
            return Err[VpnProxyTcpTlsDialerRecordRead](ErrorText(frameRes))
        if Value(frameRes):
            if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindData():
                let joined: Bytes = VpnProxyBytesConcat(pending, frame.payload)
                BytesFree(pending)
                BytesFree(frame.payload)
                pending = joined
            elif frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindClose():
                return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy tcp-tls-forward: remote closed")
            else:
                return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy tcp-tls-forward: unexpected dialer_proxy frame")
        else:
            os.SleepMs(1)
    let header: Bytes = BytesSlice(pending, 0, 5)
    let payloadLen: int32 = VpnProxyTcpTlsRecordPayloadLen(header)
    if payloadLen < 0 || payloadLen > 16401:
        # [tls-hdr-hunt] 记录头取证: 判定帧界偏移 vs 随机垃圾。
        VpnProxyPrintErr(strutil.Join(["TLSHDR site=dialerval fd=", strings.Int64ToStr(int64(link.conn.fd)), " declared=", strings.Int64ToStr(int64(payloadLen)), " plen=", strings.Int64ToStr(int64(BytesLen(pending))), " head=", VpnProxyTlsHeaderDumpText(pending.data, BytesLen(pending), 16)], ""))
        return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy tcp-tls-forward: invalid tls record length")
    let recordLen: int32 = 5 + payloadLen
    while BytesLen(pending) < recordLen:
        if VpnProxyLocalProxyShouldStop():
            return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy: local proxy stopped")
        if timeoutMs > 0 && VpnProxyMonoNowMs() >= deadlineMs:
            return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy tcp-tls-forward: read timeout")
        var frame2: ttf.VpnProxyTcpTlsForwardFrame
        var framePending2: Bytes = link.dialerProxyFramePending
        let frameRes2: Result[bool] = VpnProxyTcpTlsTryReadFrameNonblockingRaw(link.conn,
                                                                                link.dialerProxyRecvKeys,
                                                                                framePending2,
                                                                                frame2)
        link.dialerProxyFramePending = framePending2
        if IsErr(frameRes2):
            return Err[VpnProxyTcpTlsDialerRecordRead](ErrorText(frameRes2))
        if Value(frameRes2):
            if frame2.frameType == ttf.VpnProxyTcpTlsForwardFrameKindData():
                let joined2: Bytes = VpnProxyBytesConcat(pending, frame2.payload)
                BytesFree(pending)
                BytesFree(frame2.payload)
                pending = joined2
            elif frame2.frameType == ttf.VpnProxyTcpTlsForwardFrameKindClose():
                return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy tcp-tls-forward: remote closed")
            else:
                return Err[VpnProxyTcpTlsDialerRecordRead]("vpn proxy tcp-tls-forward: unexpected dialer_proxy frame")
        else:
            os.SleepMs(1)
    # [relay-owned] record/rest 都改 owned 拷贝: 原形 BytesSlice+DropPrefix 返回
    # 内点视图, free 底座后双双悬垂, 调用方后续 free = 内点释放。
    var recordOwned: Bytes = BytesAlloc(recordLen)
    var recIdx2: int32
    while recIdx2 < recordLen:
        BytesSet(recordOwned, recIdx2, BytesGet(pending, recIdx2) & 255)
        recIdx2 = recIdx2 + 1
    var remainLen3: int32 = BytesLen(pending) - recordLen
    var rest: Bytes = BytesAlloc(0)
    if remainLen3 > 0:
        rest = BytesAlloc(remainLen3)
        var cpRestIdx3: int32
        while cpRestIdx3 < remainLen3:
            BytesSet(rest, cpRestIdx3, BytesGet(pending, recordLen + cpRestIdx3) & 255)
            cpRestIdx3 = cpRestIdx3 + 1
    BytesFree(pending)
    var out: VpnProxyTcpTlsDialerRecordRead
    out.record = recordOwned
    out.pending = rest
    return Ok[VpnProxyTcpTlsDialerRecordRead](out)

fn VpnProxyTcpTlsReadDialerProxyHandshakeFlightStopAware(link: var VpnProxyTcpTlsForwardLink,
                                                         timeoutMs: int32): Result[VpnProxyTcpTlsHandshakeFlightRecords] =
    var pending: Bytes = BytesSlice(link.dialerProxyDataPending, 0, BytesLen(link.dialerProxyDataPending))
    let firstRes: Result[VpnProxyTcpTlsDialerRecordRead] = VpnProxyTcpTlsReadDialerProxyRecordValueStopAware(link,
                                                                                                             pending,
                                                                                                             timeoutMs)
    if IsErr(firstRes):
        return Err[VpnProxyTcpTlsHandshakeFlightRecords](ErrorText(firstRes))
    let firstRead: VpnProxyTcpTlsDialerRecordRead = Value(firstRes)
    let secondRes: Result[VpnProxyTcpTlsDialerRecordRead] = VpnProxyTcpTlsReadDialerProxyRecordValueStopAware(link,
                                                                                                              BytesSlice(firstRead.pending, 0, BytesLen(firstRead.pending)),
                                                                                                              timeoutMs)
    if IsErr(secondRes):
        return Err[VpnProxyTcpTlsHandshakeFlightRecords](ErrorText(secondRes))
    var out: VpnProxyTcpTlsHandshakeFlightRecords
    let secondRead: VpnProxyTcpTlsDialerRecordRead = Value(secondRes)
    out.serverHelloRecord = firstRead.record
    out.encryptedFlightRecord = secondRead.record
    out.pending = secondRead.pending
    return Ok[VpnProxyTcpTlsHandshakeFlightRecords](out)

fn VpnProxyTcpTlsReadDialerProxyHandshakeFlightStopAwareInto(link: var VpnProxyTcpTlsForwardLink,
                                                             timeoutMs: int32,
                                                             outServerHello: var Bytes,
                                                             outEncryptedFlight: var Bytes,
                                                             outPending: var Bytes): Result[bool] =
    var pending: Bytes = BytesSlice(link.dialerProxyDataPending, 0, BytesLen(link.dialerProxyDataPending))
    let firstRes: Result[VpnProxyTcpTlsDialerRecordRead] = VpnProxyTcpTlsReadDialerProxyRecordValueStopAware(link,
                                                                                                             pending,
                                                                                                             timeoutMs)
    if IsErr(firstRes):
        return Err[bool](ErrorText(firstRes))
    let firstRead: VpnProxyTcpTlsDialerRecordRead = Value(firstRes)
    let secondRes: Result[VpnProxyTcpTlsDialerRecordRead] = VpnProxyTcpTlsReadDialerProxyRecordValueStopAware(link,
                                                                                                              BytesSlice(firstRead.pending, 0, BytesLen(firstRead.pending)),
                                                                                                              timeoutMs)
    if IsErr(secondRes):
        return Err[bool](ErrorText(secondRes))
    let secondRead: VpnProxyTcpTlsDialerRecordRead = Value(secondRes)
    outServerHello = firstRead.record
    outEncryptedFlight = secondRead.record
    outPending = secondRead.pending
    return Ok[bool](true)

fn VpnProxyTcpTlsReadRecordStopAwareForLink(link: var VpnProxyTcpTlsForwardLink,
                                            timeoutMs: int32): Result[Bytes] =
    if !link.dialerProxyActive:
        return VpnProxyTcpTlsReadRecordStopAware(link.conn, timeoutMs)
    var pendingArg: Bytes = BytesSlice(link.dialerProxyDataPending, 0, BytesLen(link.dialerProxyDataPending))
    let readRes: Result[VpnProxyTcpTlsDialerRecordRead] = VpnProxyTcpTlsReadDialerProxyRecordValueStopAware(link,
                                                                                                            pendingArg,
                                                                                                            timeoutMs)
    if IsErr(readRes):
        return Err[Bytes](ErrorText(readRes))
    let read: VpnProxyTcpTlsDialerRecordRead = Value(readRes)
    link.dialerProxyDataPending = read.pending
    return Ok[Bytes](read.record)

fn VpnProxyTcpTlsWriteRecord(conn: var tcp.TcpConnectionHandle, record: var Bytes): Result[bool] =
    # [tls-hdr-hunt] 写侧金丝雀: 记录在 encrypt→send 间隔被堆腐蚀(头字节/
    # 长度字段被踩)时当场抓获, 而不是等服务端 invalid length/tag mismatch。
    # 纯读检查, 冷路径才打印。
    let wrLen: int32 = BytesLen(record)
    if wrLen >= 5:
        let wrB0: int32 = BytesGet(record, 0) & 255
        let wrDeclared: int32 = ((BytesGet(record, 3) & 255) * 256) + (BytesGet(record, 4) & 255)
        if wrB0 < 20 || wrB0 > 23 || wrDeclared != wrLen - 5:
            VpnProxyPrintErr(strutil.Join(["WSTOMP fd=", strings.Int64ToStr(int64(conn.fd)), " len=", strings.Int64ToStr(int64(wrLen)), " declared=", strings.Int64ToStr(int64(wrDeclared)), " head=", VpnProxyTlsHeaderDumpText(record.data, wrLen, 16)], ""))
            VpnProxyTunRecordRelayError(strutil.Join(["WSTOMP fd=", strings.Int64ToStr(int64(conn.fd)), " len=", strings.Int64ToStr(int64(wrLen)), " declared=", strings.Int64ToStr(int64(wrDeclared)), " head=", VpnProxyTlsHeaderDumpText(record.data, wrLen, 16)], ""))
    let writeRes: Result[int32] = VpnProxyTcpWriteAll(conn, record)
    if IsErr(writeRes):
        return Err[bool](ErrorText(writeRes))
    if Value(writeRes) != BytesLen(record):
        return Err[bool]("vpn proxy tcp-tls-forward: short write")
    return Ok[bool](true)

fn VpnProxyTcpTlsWriteFrameRaw(conn: var tcp.TcpConnectionHandle,
                               sendKeys: var tlsrec.VpnProxyTcpTlsRecordKeys,
                               frameWire: Bytes): Result[bool] =
    # SCOPED DIAGNOSTIC: data-frame flow marker. REVERT.
    VpnProxyTunRecordRelayError(strings.ConcatStr("WRAW len=", strings.ConcatStr(strings.Int64ToStr(rawbytes.BytesLen(frameWire)), strings.ConcatStr(" seq=", strings.Int64ToStr(sendKeys.seq)))))
    var record: Bytes
    # [seq-fix] 同 WriteFrame: 显式 seq + 字段写回, 免疫聚合 copy-back 丢失。
    let sendSeq: int64 = sendKeys.seq
    let recordRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordEncryptIntoWithSeq(sendKeys,
                                                                         sendSeq,
                                                                         tlsrec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                         frameWire,
                                                                         record)
    if IsErr(recordRes):
        return Err[bool](ErrorText(recordRes))
    sendKeys.seq = sendSeq + int64(1)
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteRecord(conn, record)
    BytesFree(record)
    return writeRes

fn VpnProxyTcpTlsForwardDataPayloadLimit(): int32 =
    return tlsrec.VpnProxyTcpTlsRecordMaxPayloadBytes() - ttf.VpnProxyTcpTlsForwardHeaderBytes()

@borrows
fn VpnProxyTcpTlsForwardDataPayloadLimitForLink(link: VpnProxyTcpTlsForwardLink): int32 =
    let baseLimit: int32 = VpnProxyTcpTlsForwardDataPayloadLimit()
    if !link.dialerProxyActive:
        return baseLimit
    return baseLimit - tlsrec.VpnProxyTcpTlsRecordEncryptedWireOverheadBytes() - ttf.VpnProxyTcpTlsForwardHeaderBytes()

fn VpnProxyTcpTlsWriteDataFrameRaw(conn: var tcp.TcpConnectionHandle,
                                   sendKeys: var tlsrec.VpnProxyTcpTlsRecordKeys,
                                   streamId: int32,
                                   payload: Bytes): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildDataFrameInto(streamId,
                                                                      payload,
                                                                      wire)
    if buildRes <= 0:
        return Err[bool]("tcp-tls-forward: data frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrameRaw(conn, sendKeys, wire)
    BytesFree(wire)
    return writeRes

fn VpnProxyTcpTlsWriteDataFrameChunkedRaw(conn: var tcp.TcpConnectionHandle,
                                          sendKeys: var tlsrec.VpnProxyTcpTlsRecordKeys,
                                          streamId: int32,
                                          payload: Bytes): Result[bool] =
    let limit: int32 = VpnProxyTcpTlsForwardDataPayloadLimit()
    if limit <= 0:
        return Err[bool]("tcp-tls-forward: invalid data frame payload limit")
    if BytesLen(payload) <= 0:
        return VpnProxyTcpTlsWriteDataFrameRaw(conn, sendKeys, streamId, payload)
    var offset: int32
    # [scalar-once] 循环边界一次性标量化(同 WriteDataFrameSeq, 防二读衰减)。
    var payloadTotal: int32 = BytesLen(payload)
    while offset < payloadTotal:
        var take: int32 = payloadTotal - offset
        if take > limit:
            take = limit
        var chunk: Bytes = BytesSlice(payload, offset, take)
        let writeRes: Result[bool] = VpnProxyTcpTlsWriteDataFrameRaw(conn, sendKeys, streamId, chunk)
        BytesFree(chunk)
        if IsErr(writeRes):
            return Err[bool](ErrorText(writeRes))
        offset = offset + take
    return Ok[bool](true)

@borrows
fn VpnProxyTcpTlsWriteDialerProxyData(link: var VpnProxyTcpTlsForwardLink,
                                      payload: Bytes): Result[bool] =
    return VpnProxyTcpTlsWriteDataFrameChunkedRaw(link.conn,
                                                  link.dialerProxySendKeys,
                                                  link.dialerProxyStreamId,
                                                  payload)

fn VpnProxyTcpTlsWriteRecordForLink(link: var VpnProxyTcpTlsForwardLink,
                                    record: var Bytes): Result[bool] =
    if link.dialerProxyActive:
        return VpnProxyTcpTlsWriteDialerProxyData(link, record)
    return VpnProxyTcpTlsWriteRecord(link.conn, record)

fn VpnProxyTcpTlsWriteFrame(link: var VpnProxyTcpTlsForwardLink, frameWire: Bytes): Result[bool] =
    # TASK-SCOPED DIAGNOSTIC: log every frame (len + type byte) crossing the
    # tunnel. REVERT after frame-alignment fix.
    # [tls-hdr-hunt] fd+seq 入线: 逐连接重建 seq 时间线, 抓重复/跳号。
    var ftDump: int32
    if rawbytes.BytesLen(frameWire) > 5:
        ftDump = rawbytes.BytesGet(frameWire, 5)
    if vpnTunTraceEnabled:
        VpnProxyTunRecordRelayError(strutil.Join(["WFRAME len=", strings.Int64ToStr(rawbytes.BytesLen(frameWire)), " type=", strings.Int64ToStr(ftDump), " fd=", strings.Int64ToStr(int64(link.conn.fd)), " seq=", strings.Int64ToStr(link.sendKeys.seq)], ""))
    var record: Bytes
    # [seq-fix] 显式 seq + 字段写回: EncryptInto 的 var 聚合 copy-back 在
    # aarch64 被丢(实证 tag mismatch 恒 seq=3), 字段写回免疫。
    let sendSeq: int64 = link.sendKeys.seq
    let recordRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordEncryptIntoWithSeq(link.sendKeys,
                                                                         sendSeq,
                                                                         tlsrec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                         frameWire,
                                                                         record)
    if IsErr(recordRes):
        return Err[bool](ErrorText(recordRes))
    link.sendKeys.seq = sendSeq + int64(1)
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteRecordForLink(link, record)
    BytesFree(record)
    return writeRes

# Handshake core takes scalar ownership clones so no managed struct crosses
# a call boundary on aarch64 (var/by-value aggregate copies diverge there;
# see scratchpad/HANDOFF-vpn-e2e-round2.md).
@borrows
fn VpnProxyTcpTlsForwardClientHandshakeScalars(link: var VpnProxyTcpTlsForwardLink,
                                               serverNameText: str,
                                               authText: str,
                                               identity: var VpnProxyLoadedIdentity): Result[bool] =
    VpnProxyTcpTlsHandshakeLock()
    # [psk-resume] resume hello when a fresh ticket is cached for this SNI.
    let helloRes: Result[Bytes] = tlshs.VpnProxyTcpTlsForwardClientBuildHelloMaybeResume(serverNameText,
                                                                                          identity.trustRoots[0])
    if IsErr(helloRes):
        VpnProxyTcpTlsHandshakeUnlock()
        return Err[bool](ErrorText(helloRes))
    VpnProxyTcpTlsHandshakeUnlock()
    var helloRecord: Bytes = Value(helloRes)
    let helloWriteRes: Result[bool] = VpnProxyTcpTlsWriteRecordForLink(link, helloRecord)
    if IsErr(helloWriteRes):
        return Err[bool](ErrorText(helloWriteRes))
    var serverHelloRecordRes: Result[Bytes]
    var encryptedFlightRecordRes: Result[Bytes]
    if link.dialerProxyActive:
        var serverHelloRecordOwned: Bytes
        var encryptedFlightRecordOwned: Bytes
        var flightPendingOwned: Bytes
        let flightRes: Result[bool] = VpnProxyTcpTlsReadDialerProxyHandshakeFlightStopAwareInto(link,
                                                                                                 VpnProxyConnectTimeoutMs,
                                                                                                 serverHelloRecordOwned,
                                                                                                 encryptedFlightRecordOwned,
                                                                                                 flightPendingOwned)
        if IsErr(flightRes):
            return Err[bool](ErrorText(flightRes))
        serverHelloRecordRes = Ok[Bytes](serverHelloRecordOwned)
        encryptedFlightRecordRes = Ok[Bytes](encryptedFlightRecordOwned)
        link.dialerProxyDataPending = flightPendingOwned
    else:
        serverHelloRecordRes = VpnProxyTcpTlsReadRecordStopAware(link.conn,
                                                                 VpnProxyConnectTimeoutMs)
        if IsOk(serverHelloRecordRes):
            encryptedFlightRecordRes = VpnProxyTcpTlsReadRecordStopAware(link.conn,
                                                                         VpnProxyConnectTimeoutMs)
    if IsErr(serverHelloRecordRes):
        return Err[bool](ErrorText(serverHelloRecordRes))
    if IsErr(encryptedFlightRecordRes):
        return Err[bool](ErrorText(encryptedFlightRecordRes))
    var serverHelloRecord: Bytes = Value(serverHelloRecordRes)
    var encryptedFlightRecord: Bytes = Value(encryptedFlightRecordRes)
    VpnProxyTcpTlsHandshakeLock()
    let clientFinishedRes: Result[Bytes] = tlshs.VpnProxyTcpTlsForwardClientProcessServerFlight(serverHelloRecord,
                                                                                                encryptedFlightRecord)
    if IsErr(clientFinishedRes):
        VpnProxyTcpTlsHandshakeUnlock()
        return Err[bool](ErrorText(clientFinishedRes))
    # [psk-resume] cache the fresh session ticket right after the flight is
    # consumed (inside the lock; best-effort). Owned named local for the
    # byval str formal (shared params cannot re-enter byval formals).
    var snResumeOwned: str = strings.CloneStr(serverNameText)
    let resumeStoreRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardClientStoreResumeTicket(snResumeOwned)
    if IsErr(resumeStoreRes):
        VpnProxyTcpTlsHandshakeUnlock()
        return Err[bool](ErrorText(resumeStoreRes))
    VpnProxyTcpTlsHandshakeUnlock()
    var clientFinishedRecord: Bytes = Value(clientFinishedRes)
    let finishedWriteRes: Result[bool] = VpnProxyTcpTlsWriteRecordForLink(link, clientFinishedRecord)
    if IsErr(finishedWriteRes):
        return Err[bool](ErrorText(finishedWriteRes))
    let sendKeysRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardClientAppSendKeysInto(link.sendKeys)
    if IsErr(sendKeysRes):
        return Err[bool](ErrorText(sendKeysRes))
    let recvKeysRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardClientAppRecvKeysInto(link.recvKeys)
    if IsErr(recvKeysRes):
        return Err[bool](ErrorText(recvKeysRes))
    var authFrame: Bytes = BytesAlloc(0)
    let authFrameRes: int32 = ttf.VpnProxyTcpTlsForwardBuildAuthFrameInto(authText,
                                                                          authFrame)
    if authFrameRes <= 0:
        return Err[bool]("tcp-tls-forward: auth frame build failed")
    let authWriteRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, authFrame)
    if IsErr(authWriteRes):
        return Err[bool](ErrorText(authWriteRes))
    return Ok[bool](true)

@borrows
fn VpnProxyTcpTlsForwardClientHandshakeOnLink(link: var VpnProxyTcpTlsForwardLink,
                                             exitCfg: var VpnProxyExitConfig,
                                             identity: var VpnProxyLoadedIdentity): Result[bool] =
    let sniCopy: str = strings.CloneStr(exitCfg.serverName)
    let authCopy: str = strings.CloneStr(exitCfg.auth)
    let res: Result[bool] = VpnProxyTcpTlsForwardClientHandshakeScalars(link,
                                                                        sniCopy,
                                                                        authCopy,
                                                                        identity)
    return res

fn VpnProxyTcpTlsForwardFillEmptyFrame(frameType: int32, streamId: int32, out: var Bytes) =
    var wire: Bytes = BytesAlloc(ttf.VpnProxyTcpTlsForwardHeaderBytes())
    BytesSet(wire, 0, int32('C'))
    BytesSet(wire, 1, int32('T'))
    BytesSet(wire, 2, int32('F'))
    BytesSet(wire, 3, int32('1'))
    BytesSet(wire, 4, 1)
    BytesSet(wire, 5, frameType & 255)
    BytesSet(wire, 6, 0)
    BytesSet(wire, 7, 0)
    BytesSet(wire, 8, (streamId >> 24) & 255)
    BytesSet(wire, 9, (streamId >> 16) & 255)
    BytesSet(wire, 10, (streamId >> 8) & 255)
    BytesSet(wire, 11, streamId & 255)
    BytesSet(wire, 12, 0)
    BytesSet(wire, 13, 0)
    BytesSet(wire, 14, 0)
    BytesSet(wire, 15, 0)
    out = wire

fn VpnProxyTcpTlsWriteProbeOkFrame(link: var VpnProxyTcpTlsForwardLink): Result[bool] =
    var okWire: Bytes
    VpnProxyTcpTlsForwardFillEmptyFrame(ttf.VpnProxyTcpTlsForwardFrameKindProbeOk(), 0, okWire)
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, okWire)
    BytesFree(okWire)
    return writeRes

fn VpnProxyTcpTlsWritePingOkFrame(link: var VpnProxyTcpTlsForwardLink): Result[bool] =
    var okWire: Bytes
    VpnProxyTcpTlsForwardFillEmptyFrame(ttf.VpnProxyTcpTlsForwardFrameKindPingOk(), 0, okWire)
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, okWire)
    BytesFree(okWire)
    return writeRes

fn VpnProxyTcpTlsWriteCloseFrame(link: var VpnProxyTcpTlsForwardLink): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildCloseFrameInto(link.streamId, wire)
    if buildRes <= 0:
        return Err[bool]("tcp-tls-forward: close frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, wire)
    BytesFree(wire)
    return writeRes

fn VpnProxyTcpTlsWriteDataFrame(link: var VpnProxyTcpTlsForwardLink, payload: Bytes): Result[bool] =
    let limit: int32 = VpnProxyTcpTlsForwardDataPayloadLimitForLink(link)
    if limit <= 0:
        return Err[bool]("tcp-tls-forward: invalid data frame payload limit")
    if BytesLen(payload) <= 0:
        var emptyWire: Bytes
        let emptyBuildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildDataFrameInto(link.streamId,
                                                                               payload,
                                                                               emptyWire)
        if emptyBuildRes <= 0:
            return Err[bool]("tcp-tls-forward: data frame build failed")
        let emptyWriteRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, emptyWire)
        BytesFree(emptyWire)
        return emptyWriteRes
    var offset: int32
    # [scalar-once] 循环边界一次性标量化(同 WriteDataFrameSeq, 防二读衰减)。
    var payloadTotal: int32 = BytesLen(payload)
    while offset < payloadTotal:
        var take: int32 = payloadTotal - offset
        if take > limit:
            take = limit
        var chunk: Bytes = BytesSlice(payload, offset, take)
        var wire: Bytes
        let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildDataFrameInto(link.streamId,
                                                                          chunk,
                                                                          wire)
        BytesFree(chunk)
        if buildRes <= 0:
            return Err[bool]("tcp-tls-forward: data frame build failed")
        let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, wire)
        BytesFree(wire)
        if IsErr(writeRes):
            return Err[bool](ErrorText(writeRes))
        offset = offset + take
    return Ok[bool](true)

fn VpnProxyTcpTlsWriteDataFrameSeq(link: var VpnProxyTcpTlsForwardLink,
                                   payload: Bytes,
                                   seq: int64): Result[int64] =
    # [seq-fix] seq 以 byval 标量进/Result 出: 数组元素投影作为 var 传参时
    # aarch64 冷后端 copy-back 缺失(规则⑦), 内部递增不落储 → data#2 起恒
    # 旧 seq → 服务端 tag mismatch。调用方拿到新 seq 后做元素字段写回。
    # [scalar-once] 全函数只读一次 BytesLen(payload), 且必须是首次读: 二读在
    # aarch64 布局彩票下衰减(实证: WDFENTER 打印 len=381 而紧随的第二次读
    # 得 0 → 循环整体跳过 → 上行数据全断)。诊断打印也改用该标量。
    var payloadTotal: int32 = BytesLen(payload)
    let limit: int32 = VpnProxyTcpTlsForwardDataPayloadLimitForLink(link)
    # SCOPED DIAGNOSTIC: entry payload len. REVERT.
    if vpnTunTraceEnabled:
        VpnProxyTunRecordRelayError(strings.ConcatStr("WDFENTER len=", strings.Int64ToStr(payloadTotal)))
    if limit <= 0:
        return Err[int64]("tcp-tls-forward: invalid data frame payload limit")
    var offset: int32
    var curSeq: int64 = seq
    while offset < payloadTotal:
        var take: int32 = payloadTotal - offset
        if take > limit:
            take = limit
        # [seq-fix] 显式拷贝代替 BytesSlice: 内点视图 len 实参在 aarch64 被
        # 错译(块长垃圾→记录长度字段错→服务端 invalid tls record length)。
        if take <= 0:
            return Err[int64]("tcp-tls-forward: chunk underflow")
        var chunk: Bytes = BytesAlloc(take)
        var cpChunkIdx: int32
        while cpChunkIdx < take:
            BytesSet(chunk, cpChunkIdx, BytesGet(payload, offset + cpChunkIdx) & 255)
            cpChunkIdx = cpChunkIdx + 1
        var wire: Bytes
        let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildDataFrameInto(link.streamId,
                                                                          chunk,
                                                                          wire)
        BytesFree(chunk)
        if buildRes <= 0:
            return Err[int64]("tcp-tls-forward: data frame build failed")
        # SCOPED DIAGNOSTIC: per-chunk write accounting. REVERT.
        # [uaf-fix] 原 WDFSEQ 行在 BytesFree(chunk) 之后读 BytesLen(chunk)
        # (use-after-free 读, 打印恒 len=16)。改用活标量 take。
        # [gate-lottery] 此处 if vpnTunTraceEnabled 门在 aarch64 布局彩票下被
        # 误编译为恒假(实证: WDFENTER 打印而 WDFCHUNK 全无)——诊断期无条件
        # 打印, RecordRelayError 内部早退兜底总开关。
        VpnProxyTunRecordRelayError(strings.ConcatStr("WDFCHUNK fd=", strings.ConcatStr(strings.Int64ToStr(int64(link.conn.fd)), strings.ConcatStr(" take=", strings.ConcatStr(strings.Int64ToStr(take), strings.ConcatStr(" seq=", strings.Int64ToStr(curSeq))))))
        VpnProxyTunRecordRelayError(strings.ConcatStr("WDFSEQ fd=", strings.ConcatStr(strings.Int64ToStr(int64(link.conn.fd)), strings.ConcatStr(" len=", strings.ConcatStr(strings.Int64ToStr(ttf.VpnProxyTcpTlsForwardHeaderBytes() + take), strings.ConcatStr(" seq=", strings.Int64ToStr(curSeq))))))
        var record: Bytes
        let recordRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordEncryptIntoWithSeq(link.sendKeys,
                                                                                    curSeq,
                                                                                    tlsrec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                                    wire,
                                                                                    record)
        if IsErr(recordRes):
            BytesFree(wire)
            return Err[int64](ErrorText(recordRes))
        let writeRes: Result[bool] = VpnProxyTcpTlsWriteRecordForLink(link, record)
        BytesFree(record)
        BytesFree(wire)
        if IsErr(writeRes):
            return Err[int64](ErrorText(writeRes))
        curSeq = curSeq + int64(1)
        offset = offset + take
    # [seq-fix] 镜像回写 sendKeys.seq: close 帧经 WriteFrame 读此计数器,
    # 不同步则 close 用陈旧 seq 加密 → 服务端 tag mismatch 杀流。
    link.sendKeys.seq = curSeq
    return Ok[int64](curSeq)

fn VpnProxyTcpTlsWriteOpenOkFrame(link: var VpnProxyTcpTlsForwardLink): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenOkFrameInto(link.streamId, wire)
    if buildRes <= 0:
        return Err[bool]("tcp-tls-forward: open-ok frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, wire)
    BytesFree(wire)
    return writeRes

fn VpnProxyTcpTlsWriteOpenErrorFrame(link: var VpnProxyTcpTlsForwardLink,
                                     errorText: str): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenErrorFrameInto(link.streamId,
                                                                           errorText,
                                                                           wire)
    if buildRes <= 0:
        return Err[bool]("tcp-tls-forward: open-error frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, wire)
    BytesFree(wire)
    return writeRes

fn VpnProxyTcpTlsReadFrame(link: var VpnProxyTcpTlsForwardLink): Result[ttf.VpnProxyTcpTlsForwardFrame] =
    var outFrame: ttf.VpnProxyTcpTlsForwardFrame
    let readRes: Result[bool] = VpnProxyTcpTlsReadFrameInto(link, outFrame)
    if IsErr(readRes):
        return Err[ttf.VpnProxyTcpTlsForwardFrame](ErrorText(readRes))
    return Ok[ttf.VpnProxyTcpTlsForwardFrame](outFrame)

fn VpnProxyTcpTlsReadFrameInto(link: var VpnProxyTcpTlsForwardLink,
                               outFrame: var ttf.VpnProxyTcpTlsForwardFrame): Result[bool] =
    var record: Bytes
    let recordRes: Result[bool] = VpnProxyTcpTlsReadRecordInto(link.conn, record)
    if IsErr(recordRes):
        return Err[bool](ErrorText(recordRes))
    var plain: tlsrec.VpnProxyTcpTlsRecordPlain
    let plainRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordDecryptInto(link.recvKeys,
                                                                         record,
                                                                         plain)
    if IsErr(plainRes):
        BytesFree(record)
        return Err[bool](ErrorText(plainRes))
    if plain.contentType != tlsrec.VpnProxyTcpTlsRecordContentTypeApplicationData():
        BytesFree(record)
        BytesFree(plain.payload)
        return Err[bool]("vpn proxy tcp-tls-forward: expected application record")
    let decodeCode: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(plain.payload, outFrame)
    # [orc-hunt x86] outFrame.payload 是 plain.payload 的视图,下方立即 BytesFree
    # (悬垂)。中继/消费侧读 freed 内容时好时坏(quarantine 复用竞速)=TLS relay
    # 随机腐蚀。owned 拷贝替换后才准释放底座。
    if decodeCode > 0 && BytesLen(outFrame.payload) > 0:
        var ownedPayload: Bytes = BytesAlloc(BytesLen(outFrame.payload))
        var ownIdx: int32
        while ownIdx < BytesLen(ownedPayload):
            BytesSet(ownedPayload, ownIdx, BytesGet(outFrame.payload, ownIdx) & 255)
            ownIdx = ownIdx + 1
        outFrame.payload = ownedPayload
    BytesFree(record)
    BytesFree(plain.payload)
    if decodeCode <= 0:
        return Err[bool]("vpn proxy tcp-tls-forward: invalid frame")
    return Ok[bool](true)

fn VpnProxyBytesToStringAt(data: Bytes, start: int32, count: int32): str =
    if data.data == nil || start < 0 || count <= 0 || start + count > BytesLen(data):
        return ""
    return NewStringCopy(rawmem_support.RawmemPtrAdd(data.data, start), count)

fn VpnProxyBytesRawGet(data: Bytes, idx: int32): int32 =
    if data.data == nil || idx < 0 || idx >= BytesLen(data):
        return 0
    return BytesGet(data, idx)

fn VpnProxyBytesRawSet(data: Bytes, idx: int32, value: int32) =
    if data.data == nil || idx < 0 || idx >= BytesLen(data):
        return
    BytesSet(data, idx, value & 0xff)

fn VpnProxyBytesMatchAsciiAt(data: Bytes, start: int32, text: str): bool =
    if start < 0 || start + len(text) > BytesLen(data):
        return false
    for i in 0..<len(text):
        let expected: int32 = int32(text[i])
        if VpnProxyBytesRawGet(data, start + i) != expected:
            return false
    return true

fn VpnProxySocksReply(code: int32): Bytes =
    return socks.VpnProxySocksReply(code)

fn VpnProxySocksMethodHandshakeWithVersion(conn: var tcp.TcpConnectionHandle,
                                            version: int32): Result[bool] =
    let countRes: Result[Bytes] = VpnProxyTcpReadExactStopAware(conn, 1, VpnProxyConnectTimeoutMs)
    if IsErr(countRes):
        return Err[bool](ErrorText(countRes))
    let countWire = Value(countRes)
    let methodCount: int32 = BytesGet(countWire, 0)
    let methodsRes: Result[Bytes] = VpnProxyTcpReadExactStopAware(conn, methodCount, VpnProxyConnectTimeoutMs)
    if IsErr(methodsRes):
        return Err[bool](ErrorText(methodsRes))
    let methods = Value(methodsRes)
    var header: Bytes = BytesAlloc(2)
    BytesSet(header, 0, version)
    BytesSet(header, 1, methodCount)
    let request: Bytes = VpnProxyBytesConcat(header, methods)
    let replyRes: Result[Bytes] = socks.VpnProxySocksMethodReplyFor(request)
    if IsErr(replyRes):
        let errText: str = ErrorText(replyRes)
        if ErrorText(replyRes) == "vpn proxy socks5: no supported auth method":
            var rejectWire: Bytes = rawbytes.BytesSlice(BytesFromString("\x05\xff"), 0, 2)
            let _ = VpnProxyTcpWriteAll(conn, rejectWire)
        return Err[bool](errText)
    var replyWire: Bytes = Value(replyRes)
    let writeRes = VpnProxyTcpWriteAll(conn, replyWire)
    if IsErr(writeRes):
        return Err[bool](ErrorText(writeRes))
    return Ok[bool](true)

fn VpnProxySocksMethodHandshake(conn: var tcp.TcpConnectionHandle): Result[bool] =
    let versionRes: Result[Bytes] = VpnProxyTcpReadExactStopAware(conn, 1, VpnProxyConnectTimeoutMs)
    if IsErr(versionRes):
        return Err[bool](ErrorText(versionRes))
    var versionOwned: Bytes = Value(versionRes)
    return VpnProxySocksMethodHandshakeWithVersion(conn, BytesGet(versionOwned, 0))

fn VpnProxySocksReadRequest(conn: var tcp.TcpConnectionHandle): Result[VpnProxySocksRequest] =
    let headRes: Result[Bytes] = VpnProxyTcpReadExactStopAware(conn, 4, VpnProxyConnectTimeoutMs)
    if IsErr(headRes):
        return Err[VpnProxySocksRequest](ErrorText(headRes))
    let head = Value(headRes)
    let atyp: int32 = BytesGet(head, 3)
    var tail: Bytes = BytesAlloc(0)
    if atyp == VpnProxySocksAtypIpv4:
        let addrRes = VpnProxyTcpReadExactStopAware(conn, 4, VpnProxyConnectTimeoutMs)
        if IsErr(addrRes):
            return Err[VpnProxySocksRequest](ErrorText(addrRes))
        tail = Value(addrRes)
    elif atyp == VpnProxySocksAtypDomain:
        let lenRes = VpnProxyTcpReadExactStopAware(conn, 1, VpnProxyConnectTimeoutMs)
        if IsErr(lenRes):
            return Err[VpnProxySocksRequest](ErrorText(lenRes))
        let hostLenByte: Bytes = Value(lenRes)
        let hostLen: int32 = BytesGet(hostLenByte, 0)
        let hostRes = VpnProxyTcpReadExactStopAware(conn, hostLen, VpnProxyConnectTimeoutMs)
        if IsErr(hostRes):
            return Err[VpnProxySocksRequest](ErrorText(hostRes))
        tail = VpnProxyBytesConcat(hostLenByte, Value(hostRes))
    elif atyp == VpnProxySocksAtypIpv6:
        let addrRes = VpnProxyTcpReadExactStopAware(conn, 16, VpnProxyConnectTimeoutMs)
        if IsErr(addrRes):
            return Err[VpnProxySocksRequest](ErrorText(addrRes))
        tail = Value(addrRes)
    else:
        var replyWire: Bytes = VpnProxySocksReply(VpnProxySocksReplyAddressUnsupported)
        let _ = VpnProxyTcpWriteAll(conn, replyWire)
        return Err[VpnProxySocksRequest]("vpn proxy socks5: unsupported address type")
    let portRes = VpnProxyTcpReadExactStopAware(conn, 2, VpnProxyConnectTimeoutMs)
    if IsErr(portRes):
        return Err[VpnProxySocksRequest](ErrorText(portRes))
    let wire: Bytes = VpnProxyBytesConcat3(head, tail, Value(portRes))
    let parseRes: Result[VpnProxySocksRequest] = socks.VpnProxySocksParseRequestWire(wire)
    if IsErr(parseRes):
        let err: str = ErrorText(parseRes)
        if err == "vpn proxy socks5: unsupported command" ||
           err == "vpn proxy socks5: invalid command":
            var replyWire: Bytes = VpnProxySocksReply(VpnProxySocksReplyCommandUnsupported)
            let _ = VpnProxyTcpWriteAll(conn, replyWire)
        elif err == "vpn proxy socks5: unsupported address type":
            var replyWire: Bytes = VpnProxySocksReply(VpnProxySocksReplyAddressUnsupported)
            let _ = VpnProxyTcpWriteAll(conn, replyWire)
        return Err[VpnProxySocksRequest](err)
    return parseRes

fn VpnProxyHttpReadConnectHeader(conn: var tcp.TcpConnectionHandle,
                                  firstByte: int32,
                                  outLen: var int32): Result[Bytes] =
    outLen = 0
    let out: Bytes = BytesAlloc(VpnProxyHttpProxyMaxHeaderBytes)
    if out.data == nil:
        return Err[Bytes]("vpn proxy http proxy: header alloc failed")
    VpnProxyBytesRawSet(out, 0, firstByte)
    outLen = 1
    while outLen < VpnProxyHttpProxyMaxHeaderBytes:
        let oneRes: Result[Bytes] = VpnProxyTcpReadExactStopAware(conn, 1, VpnProxyConnectTimeoutMs)
        if IsErr(oneRes):
            return Err[Bytes](ErrorText(oneRes))
        var oneOwned: Bytes = Value(oneRes)
        VpnProxyBytesRawSet(out, outLen, VpnProxyBytesRawGet(oneOwned, 0))
        outLen = outLen + 1
        if outLen >= 4:
            if VpnProxyBytesRawGet(out, outLen - 4) == 13 &&
               VpnProxyBytesRawGet(out, outLen - 3) == 10 &&
               VpnProxyBytesRawGet(out, outLen - 2) == 13 &&
               VpnProxyBytesRawGet(out, outLen - 1) == 10:
                return Ok[Bytes](out)
    return Err[Bytes]("vpn proxy http proxy: header too large")

fn VpnProxyHttpParseConnectTarget(header: Bytes, headerLen: int32): Result[VpnProxyTarget] =
    if headerLen <= 0 || headerLen > BytesLen(header):
        return Err[VpnProxyTarget]("vpn proxy http proxy: invalid header")
    if !VpnProxyBytesMatchAsciiAt(header, 0, "CONNECT "):
        return Err[VpnProxyTarget]("vpn proxy http proxy: CONNECT required")
    var targetStart: int32 = 8
    var targetEnd: int32 = -1
    for i in targetStart..<headerLen:
        if targetEnd < 0 && VpnProxyBytesRawGet(header, i) == 32:
            targetEnd = i
    if targetEnd <= targetStart:
        return Err[VpnProxyTarget]("vpn proxy http proxy: target missing")
    var hostStart: int32 = targetStart
    var hostEnd: int32 = targetEnd
    var portStart: int32 = -1
    if VpnProxyBytesRawGet(header, hostStart) == int32('['):
        var closeIdx: int32 = -1
        for i in hostStart + 1..<targetEnd:
            if closeIdx < 0 && VpnProxyBytesRawGet(header, i) == int32(']'):
                closeIdx = i
        if closeIdx <= hostStart || closeIdx + 1 >= targetEnd || VpnProxyBytesRawGet(header, closeIdx + 1) != int32(':'):
            return Err[VpnProxyTarget]("vpn proxy http proxy: invalid ipv6 target")
        hostStart = hostStart + 1
        hostEnd = closeIdx
        portStart = closeIdx + 2
    else:
        var colonIdx: int32 = -1
        for i in targetStart..<targetEnd:
            if VpnProxyBytesRawGet(header, i) == int32(':'):
                colonIdx = i
        if colonIdx <= targetStart || colonIdx + 1 >= targetEnd:
            return Err[VpnProxyTarget]("vpn proxy http proxy: target port missing")
        hostEnd = colonIdx
        portStart = colonIdx + 1
    let hostText: str = VpnProxyBytesToStringAt(header, hostStart, hostEnd - hostStart)
    let portText: str = VpnProxyBytesToStringAt(header, portStart, targetEnd - portStart)
    let portRes: Result[int32] = cli.VpnProxyParseInt32(portText)
    if IsErr(portRes):
        return Err[VpnProxyTarget](ErrorText(portRes))
    var target: VpnProxyTarget
    target.host = hostText
    target.port = Value(portRes)
    if len(target.host) <= 0 || target.port <= 0 || target.port > 65535:
        return Err[VpnProxyTarget]("vpn proxy http proxy: invalid target")
    return Ok[VpnProxyTarget](target)

fn VpnProxyHttpRequestTarget(header: Bytes,
                             headerLen: int32,
                             methodText: str,
                             targetStart: int32): str =
    if headerLen <= targetStart || headerLen > BytesLen(header):
        return ""
    if !VpnProxyBytesMatchAsciiAt(header, 0, methodText):
        return ""
    var targetEnd: int32 = -1
    for i in targetStart..<headerLen:
        if targetEnd < 0 && VpnProxyBytesRawGet(header, i) == 32:
            targetEnd = i
    if targetEnd <= targetStart:
        return ""
    return VpnProxyBytesToStringAt(header, targetStart, targetEnd - targetStart)

fn VpnProxyHttpIsPacRequest(header: Bytes, headerLen: int32): bool =
    let target: str = VpnProxyHttpRequestTarget(header, headerLen, "GET ", 4)
    return target == VpnProxyPacScriptPath

fn VpnProxyPacScript(proxyPort: int32): str =
    let proxyText: str = strutil.Join(["PROXY 127.0.0.1:", IntToStr(proxyPort)], "")
    return strutil.Join([
        "function FindProxyForURL(url, host) {\n",
        "  if (isPlainHostName(host) || host == \"localhost\" || shExpMatch(host, \"127.*\") || shExpMatch(host, \"10.*\") || shExpMatch(host, \"192.168.*\") || shExpMatch(host, \"172.16.*\") || shExpMatch(host, \"172.17.*\") || shExpMatch(host, \"172.18.*\") || shExpMatch(host, \"172.19.*\") || shExpMatch(host, \"172.2?.*\") || shExpMatch(host, \"172.30.*\") || shExpMatch(host, \"172.31.*\")) { return \"DIRECT\"; }\n",
        "  return \"", proxyText, "\";\n",
        "}\n"
    ], "")

fn VpnProxyHttpWriteResponse(conn: var tcp.TcpConnectionHandle,
                             statusLine: str,
                             contentType: str,
                             body: str): Result[bool] =
    let responseText: str = strutil.Join([
        statusLine, "\r\n",
        "Content-Type: ", contentType, "\r\n",
        "Content-Length: ", IntToStr(len(body)), "\r\n",
        "Cache-Control: no-store\r\n",
        "Connection: close\r\n",
        "\r\n",
        body
    ], "")
    var responseTemplate: Bytes = BytesFromString(responseText)
    var responseWire: Bytes = BytesAlloc(BytesLen(responseTemplate))
    rawbytes.BytesCopyInto(responseWire, 0, responseTemplate)
    let writeRes: Result[int32] = VpnProxyTcpWriteAll(conn, responseWire)
    if IsErr(writeRes):
        return Err[bool](ErrorText(writeRes))
    if Value(writeRes) != BytesLen(responseWire):
        return Err[bool]("vpn proxy http proxy: short response write")
    return Ok[bool](true)

fn VpnProxyHandleLocalPacRequest(conn: var tcp.TcpConnectionHandle,
                                 firstByte: int32): Result[bool] =
    var headerLen: int32
    let headerRes: Result[Bytes] = VpnProxyHttpReadConnectHeader(conn, firstByte, headerLen)
    if IsErr(headerRes):
        let bodyText: str = "bad request\n"
        let _ = VpnProxyHttpWriteResponse(conn,
                                          "HTTP/1.1 400 Bad Request",
                                          "text/plain; charset=utf-8",
                                          bodyText)
        return Err[bool](ErrorText(headerRes))
    if !VpnProxyHttpIsPacRequest(Value(headerRes), headerLen):
        let bodyText: str = "not found\n"
        let _ = VpnProxyHttpWriteResponse(conn,
                                          "HTTP/1.1 404 Not Found",
                                          "text/plain; charset=utf-8",
                                          bodyText)
        return Err[bool]("vpn proxy local: unsupported HTTP GET")
    let pacBody: str = VpnProxyPacScript(conn.localAddr.port)
    return VpnProxyHttpWriteResponse(conn,
                                     "HTTP/1.1 200 OK",
                                     "application/x-ns-proxy-autoconfig",
                                     pacBody)

fn VpnProxyProbeTcpTlsForwardOpenLink(state: var VpnProxyExitState,
                                      link: var VpnProxyTcpTlsForwardLink,
                                      beginMs: int64,
                                      timeoutMs: int32): bool =
    var probeFrame: Bytes
    let probeFrameRes: int32 = ttf.VpnProxyTcpTlsForwardBuildProbeFrameInto(probeFrame)
    if probeFrameRes <= 0:
        VpnProxyCloseTcpTlsForwardLink(link)
        routing.VpnProxyMarkProbeFailure(state, beginMs, "tcp-tls-forward: probe frame build failed")
        return false
    # TASK-SCOPED DIAGNOSTIC: dump the probe frame wire so the server-side
    # seq=1 plaintext can be compared byte-for-byte. REVERT after fix.
    VpnProxyTunRecordRelayError(strings.ConcatStr("PROBEWIRE len=", strings.ConcatStr(strings.Int64ToStr(rawbytes.BytesLen(probeFrame)), strings.ConcatStr(" hex=", rawbytes.BytesToHex(probeFrame)))))
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, probeFrame)
    BytesFree(probeFrame)
    if IsErr(writeRes):
        VpnProxyCloseTcpTlsForwardLink(link)
        routing.VpnProxyMarkProbeFailure(state, beginMs, ErrorText(writeRes))
        return false
    let replyRes: Result[ttf.VpnProxyTcpTlsForwardFrame] = VpnProxyTcpTlsReadFrameStopAware(link,
                                                                                              timeoutMs)
    if IsErr(replyRes):
        VpnProxyCloseTcpTlsForwardLink(link)
        routing.VpnProxyMarkProbeFailure(state, beginMs, ErrorText(replyRes))
        return false
    VpnProxyCloseTcpTlsForwardLink(link)
    if Value(replyRes).frameType != ttf.VpnProxyTcpTlsForwardFrameKindProbeOk():
        routing.VpnProxyMarkProbeFailure(state, beginMs, "vpn proxy status: tcp-tls-forward probe rejected")
        return false
    let endMs: int64 = VpnProxyMonoNowMs()
    routing.VpnProxyMarkSuccess(state, endMs, endMs - beginMs)
    return true

@borrows
fn VpnProxyProbeExit(state: var VpnProxyExitState,
                       identity: var VpnProxyLoadedIdentity,
                       timeoutMs: int32): bool =
    let beginMs: int64 = VpnProxyMonoNowMs()
    if VpnProxyExitTransportText(state.cfg) == "tcp-tls-forward":
        timeoutMs
        let dialRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyTcpTlsForwardDial(state.cfg,
                                                                                   identity,
                                                                                   -1)
        if IsErr(dialRes):
            routing.VpnProxyMarkProbeFailure(state, beginMs, ErrorText(dialRes))
            return false
        var link: VpnProxyTcpTlsForwardLink = Value(dialRes)
        return VpnProxyProbeTcpTlsForwardOpenLink(state, link, beginMs, timeoutMs)
    if VpnProxyExitTransportText(state.cfg) != "udp-quic":
        routing.VpnProxyMarkProbeFailure(state, beginMs, "vpn proxy status: unsupported exit transport")
        return false
    hy2sess.VpnProxyHy2SetReadTimeoutMs(timeoutMs)
    let dialRes: Result[VpnProxyQuicLink] = VpnProxyDialExit(state.cfg,
                                                              identity,
                                                              timeoutMs,
                                                              -1,
                                                              state.sendClientCertificate)
    if IsErr(dialRes):
        hy2sess.VpnProxyHy2SetReadTimeoutMs(0)
        routing.VpnProxyMarkProbeFailure(state, beginMs, ErrorText(dialRes))
        return false
    var link = Value(dialRes)
    VpnProxyCloseQuicLink(link)
    hy2sess.VpnProxyHy2SetReadTimeoutMs(0)
    let endMs: int64 = VpnProxyMonoNowMs()
    routing.VpnProxyMarkSuccess(state, endMs, endMs - beginMs)
    return true

@borrows
fn VpnProxyProbeExitSelected(states: var VpnProxyExitState[],
                             identity: var VpnProxyLoadedIdentity,
                             exitIndex: int32,
                             timeoutMs: int32): bool =
    if exitIndex < 0 || exitIndex >= states.len:
        return false
    if VpnProxyExitTransportText(states[exitIndex].cfg) == "tcp-tls-forward":
        let beginMs: int64 = VpnProxyMonoNowMs()
        let dialRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyTcpTlsForwardDialSelected(states,
                                                                                           identity,
                                                                                           exitIndex)
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[exitIndex])
        if IsErr(dialRes):
            routing.VpnProxyMarkProbeFailure(state, beginMs, ErrorText(dialRes))
            VpnProxyStoreExitStateAt(states, exitIndex, state)
            return false
        var link: VpnProxyTcpTlsForwardLink = Value(dialRes)
        # SCOPED DIAGNOSTIC: confirm probe-frame stage entry. REVERT.
        VpnProxyTunRecordRelayError("PSEL entering OpenLink")
        let ok: bool = VpnProxyProbeTcpTlsForwardOpenLink(state, link, beginMs, timeoutMs)
        VpnProxyTunRecordRelayError(strings.ConcatStr("PSEL openlink ok=", strings.Int64ToStr(int32(ok))))
        VpnProxyStoreExitStateAt(states, exitIndex, state)
        return ok
    var state2: VpnProxyExitState = VpnProxyCloneExitState(states[exitIndex])
    let ok2: bool = VpnProxyProbeExit(state2, identity, timeoutMs)
    VpnProxyStoreExitStateAt(states, exitIndex, state2)
    return ok2

@borrows
fn VpnProxyProbeAll(states: var VpnProxyExitState[],
                      identity: var VpnProxyLoadedIdentity,
                      timeoutMs: int32) =
    for i in 0..<states.len:
        let _ok: bool = VpnProxyProbeExitSelected(states, identity, i, timeoutMs)

@borrows
fn VpnProxyEnsureFreshExits(states: var VpnProxyExitState[],
                              identity: var VpnProxyLoadedIdentity,
                              probeIntervalMs: int32,
                              probeTimeoutMs: int32) =
    let nowMs: int64 = VpnProxyMonoNowMs()
    for i in 0..<states.len:
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[i])
        if state.lastProbeMs <= 0 || nowMs - state.lastProbeMs >= int64(probeIntervalMs):
            VpnProxyStoreExitStateAt(states, i, state)
            let _ok: bool = VpnProxyProbeExitSelected(states, identity, i, probeTimeoutMs)

fn VpnProxyStatusProbeResultFromExit(exitCode: int32, sampleMs: int64): VpnProxyStatusProbeResult =
    var out: VpnProxyStatusProbeResult
    out.exitCode = exitCode
    out.output = ""
    out.sampleMs = sampleMs
    if exitCode == 0:
        out.healthy = true
        out.lastError = ""
    else:
        out.healthy = false
        out.lastError = strutil.Join(["vpn proxy status: probe failed rc=", IntToStr(exitCode)], "")
        out.sampleMs = int64(0)
    return out

fn VpnProxyStatusTimeoutResult(timeoutMs: int32): VpnProxyStatusProbeResult =
    var out: VpnProxyStatusProbeResult
    out.healthy = false
    out.timedOut = true
    out.exitCode = 124
    out.output = ""
    out.lastError = strutil.Join(["vpn proxy status: probe timeout after ", IntToStr(timeoutMs), " ms"], "")
    out.sampleMs = int64(0)
    return out

fn
fn VpnProxyStatusSpawnFailureResult(message: str): VpnProxyStatusProbeResult =
    var out: VpnProxyStatusProbeResult
    out.healthy = false
    out.timedOut = false
    out.exitCode = 127
    out.output = ""
    out.lastError = message
    out.sampleMs = int64(0)
    return out
@borrows
fn VpnProxyStatusProbeMarkerValue(output: str, marker: str): str =
    var lineStart: int32
    while lineStart < len(output):
        var lineEnd: int32
        lineEnd = lineStart
        while lineEnd < len(output):
            if int32(output[lineEnd]) == 10:
                break
            lineEnd = lineEnd + 1
        let lineLen: int32 = lineEnd - lineStart
        if lineLen >= len(marker):
            let prefix: str = VpnProxyTextSlice(output, lineStart, len(marker))
            if prefix == marker:
                return VpnProxyTextSlice(output, lineStart + len(marker), lineLen - len(marker))
        lineStart = lineEnd + 1
    return ""

fn VpnProxyStatusProbeResultFromOutput(exitCode: int32,
                                       sampleMs: int64,
                                       output: str): VpnProxyStatusProbeResult =
    var out: VpnProxyStatusProbeResult = VpnProxyStatusProbeResultFromExit(exitCode, sampleMs)
    out.output = strings.CloneStr(output)
    let healthyText: str = VpnProxyStatusProbeMarkerValue(strings.CloneStr(output), "probe_healthy=")
    let errorText: str = VpnProxyStatusProbeMarkerValue(strings.CloneStr(output), "probe_error=")
    let sampleText: str = VpnProxyStatusProbeMarkerValue(strings.CloneStr(output), "probe_sample_ms=")
    if healthyText == "true":
        out.healthy = true
        out.timedOut = false
        out.exitCode = 0
        out.lastError = ""
    elif healthyText == "false":
        out.healthy = false
        out.timedOut = false
        if exitCode == 0:
            out.exitCode = 2
    if len(errorText) > 0:
        out.lastError = errorText
    let sampleRes: Result[int32] = cli.VpnProxyParseInt32(sampleText)
    if IsOk(sampleRes):
        out.sampleMs = int64(Value(sampleRes))
    return out

fn VpnProxyStatusDrainProbeOutput(readFd: var int32, output: var str) =
    while readFd >= 0:
        let readRes = hostproc.FdReadWait(readFd, 65536, 0)
        if strings.Len(readRes.text) <= 0:
            if readRes.eof:
                hostproc.PtyClose(readFd)
                readFd = -1
            return
        output = strutil.Join([strings.CloneStr(output), strings.CloneStr(readRes.text)], "")

@borrows
fn VpnProxyStatusSuperviseProbe(rootDir: var str,
                                  configDir: str,
                                  configPath: str,
                                  exitIndex: int32,
                                  timeoutMsRaw: int32): VpnProxyStatusProbeResult =
    var timeoutMs: int32 = timeoutMsRaw
    if timeoutMs <= 0:
        timeoutMs = 1000
    let exePath: str = VpnProxyCurrentExecutablePath(rootDir)
    if len(exePath) <= 0:
        return VpnProxyStatusSpawnFailureResult("vpn proxy status: current executable missing")
    let exeHostPath: str = chengpath.PathHostFilePath(exePath)
    var childWorkDir: str = configDir
    if len(childWorkDir) <= 0:
        childWorkDir = chengpath.PathCurrentDir()
    let workHostPath: str = chengpath.PathHostFilePath(childWorkDir)
    let startedAtMs: int64 = VpnProxyMonoNowMs()
    var childArgs: str[]
    var arg0: str = "__status-probe-exit"
    var arg1: str = "--config"
    var arg2: str = strings.CloneStr(configPath)
    var arg3: str = "--exit-index"
    var arg4: str = IntToStr(exitIndex)
    var arg5: str = "--probe-timeout-ms"
    var arg6: str = IntToStr(timeoutMs)
    childArgs = [arg0, arg1, arg2, arg3, arg4, arg5, arg6]
    let spawnRes = hostproc.ExecFilePipeSpawn(exeHostPath, childArgs, [], workHostPath)
    if !spawnRes.ok || spawnRes.pid <= int64(0) || spawnRes.readFd < 0:
        return VpnProxyStatusSpawnFailureResult("vpn proxy status: probe spawn failed")
    if spawnRes.writeFd >= 0:
        hostproc.PtyClose(spawnRes.writeFd)
    var readFd: int32 = spawnRes.readFd
    var probeOutput: str
    let deadlineMs: int64 = startedAtMs + int64(timeoutMs)
    var timedOut: bool
    var termSent: bool
    var killSent: bool
    while true:
        VpnProxyStatusDrainProbeOutput(readFd, probeOutput)
        let waitRes = hostproc.PtyWait(spawnRes.pid)
        if waitRes.waitStatus == 1:
            VpnProxyStatusDrainProbeOutput(readFd, probeOutput)
            if readFd >= 0:
                hostproc.PtyClose(readFd)
            if timedOut:
                return VpnProxyStatusTimeoutResult(timeoutMs)
            return VpnProxyStatusProbeResultFromOutput(waitRes.exitCode,
                                                       VpnProxyMonoNowMs() - startedAtMs,
                                                       probeOutput)
        if waitRes.waitStatus < 0:
            if readFd >= 0:
                hostproc.PtyClose(readFd)
            return VpnProxyStatusSpawnFailureResult("vpn proxy status: probe wait failed")
        let nowMs: int64 = VpnProxyMonoNowMs()
        if !timedOut && nowMs >= deadlineMs:
            timedOut = true
        if timedOut:
            if !termSent:
                let _termOk: bool = hostproc.ProcessSignal(spawnRes.pid, 15)
                termSent = true
            elif !killSent && nowMs - deadlineMs >= int64(100):
                let _killOk: bool = hostproc.ProcessSignal(spawnRes.pid, 9)
                killSent = true
            elif nowMs - deadlineMs >= int64(1000):
                if readFd >= 0:
                    hostproc.PtyClose(readFd)
                return VpnProxyStatusTimeoutResult(timeoutMs)
        os.SleepMs(1)

fn VpnProxyStatusProbeExitChild(rootDir: str, args: str[]): int32 =
    rootDir
    var opts: VpnProxyCliOptions
    cli.VpnProxyOptionsFillInto(args, opts)
    let exitIndex: int32 = cli.VpnProxyReadIntFlag(args, "--exit-index", -1)
    let configRes: Result[VpnProxyConfig] = VpnProxyLoadConfig(opts.configPath)
    if IsErr(configRes):
        VpnProxyPrintLine("probe_healthy=false")
        var errLine: str = "probe_error="
        errLine = errLine + strings.CloneStr(ErrorText(configRes))
        VpnProxyPrintLine(errLine)
        VpnProxyPrintLine("probe_sample_ms=0")
        return 2
    let config = Value(configRes)
    opts.configPath = config.configPath
    if exitIndex < 0 || exitIndex >= config.exits.len:
        VpnProxyPrintLine("probe_healthy=false")
        VpnProxyPrintLine("probe_error=vpn proxy status: invalid exit index")
        VpnProxyPrintLine("probe_sample_ms=0")
        return 2
    let probeConfigDir: str = config.configDir
    let identityRes = VpnProxyLoadIdentity(probeConfigDir, config.client, false)
    if IsErr(identityRes):
        VpnProxyPrintLine("probe_healthy=false")
        var errLine: str = "probe_error="
        errLine = errLine + strings.CloneStr(ErrorText(identityRes))
        VpnProxyPrintLine(errLine)
        VpnProxyPrintLine("probe_sample_ms=0")
        return 2
    var states: VpnProxyExitState[]
    states = routing.VpnProxyInitExitStatesWithClientCertificate(config.exits,
                                                                  VpnProxyConfigSendsClientCertificate(config))
    var probeIdentity: VpnProxyLoadedIdentity = Value(identityRes)
    let ok: bool = VpnProxyProbeExitSelected(states,
                                             probeIdentity,
                                             exitIndex,
                                             opts.probeTimeoutMs)
    var state: VpnProxyExitState = VpnProxyCloneExitState(states[exitIndex])
    if !ok:
        state.healthy = false
    var healthyText: str = "false"
    if ok && state.healthy:
        healthyText = "true"
    var healthyLine: str = "probe_healthy="
    healthyLine = healthyLine + strings.CloneStr(healthyText)
    VpnProxyPrintLine(healthyLine)
    var errorLine: str = "probe_error="
    errorLine = errorLine + strings.CloneStr(state.lastError)
    VpnProxyPrintLine(errorLine)
    var sampleLine: str = "probe_sample_ms="
    var ewmaText: str = int64ToStr(state.ewmaMs)
    sampleLine = sampleLine + strings.CloneStr(ewmaText)
    VpnProxyPrintLine(sampleLine)
    if ok && state.healthy:
        return 0
    return 2

@borrows
fn VpnProxyOpenRemoteAttempt(states: var VpnProxyExitState[],
                               identity: var VpnProxyLoadedIdentity,
                               target: var VpnProxyTarget,
                               idx: int32): Result[VpnProxyQuicLink] =
    if idx < 0 || idx >= states.len:
        return Err[VpnProxyQuicLink]("vpn proxy: invalid exit index")
    if VpnProxyExitTransportText(states[idx].cfg) == "tcp-tls-forward":
        return Err[VpnProxyQuicLink]("vpn proxy: tcp-tls-forward requires tcp forward open path")
    if VpnProxyExitTransportText(states[idx].cfg) != "udp-quic":
        return Err[VpnProxyQuicLink]("vpn proxy: unsupported exit transport")
    let dialRes: Result[VpnProxyQuicLink] = VpnProxyDialExit(states[idx].cfg,
                                                                 identity,
                                                                 VpnProxyConnectTimeoutMs,
                                                                 idx,
                                                                 states[idx].sendClientCertificate)
    if IsErr(dialRes):
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
        routing.VpnProxyRecordOpenFailure(state, VpnProxyMonoNowMs(), ErrorText(dialRes))
        VpnProxyStoreExitStateAt(states, idx, state)
        return Err[VpnProxyQuicLink](ErrorText(dialRes))
    var link = Value(dialRes)
    let authRes: Result[Hysteria2AuthResponse] = VpnProxyHy2ClientHandshake(link.conn, states[idx].cfg)
    if IsErr(authRes):
        VpnProxyCloseQuicLink(link)
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
        routing.VpnProxyRecordOpenFailure(state, VpnProxyMonoNowMs(), ErrorText(authRes))
        VpnProxyStoreExitStateAt(states, idx, state)
        return Err[VpnProxyQuicLink](ErrorText(authRes))
    let streamIdRes: Result[int64] = hy2sess.VpnProxyHy2TcpStreamAllocatorNext(link.tcpStreams)
    if IsErr(streamIdRes):
        VpnProxyCloseQuicLink(link)
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
        routing.VpnProxyRecordOpenFailure(state, VpnProxyMonoNowMs(), ErrorText(streamIdRes))
        VpnProxyStoreExitStateAt(states, idx, state)
        return Err[VpnProxyQuicLink](ErrorText(streamIdRes))
    let streamRes: Result[VpnProxyHy2TcpStream] = VpnProxyHy2OpenTargetStream(link.conn,
                                                                               target,
                                                                               Value(streamIdRes))
    if IsErr(streamRes):
        VpnProxyCloseQuicLink(link)
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
        routing.VpnProxyRecordOpenFailure(state, VpnProxyMonoNowMs(), ErrorText(streamRes))
        VpnProxyStoreExitStateAt(states, idx, state)
        return Err[VpnProxyQuicLink](ErrorText(streamRes))
    link.stream = Value(streamRes)
    link.streamOpen = true
    link.exitIndex = idx
    return Ok[VpnProxyQuicLink](link)

@borrows
fn VpnProxyFindExitStateByName(states: var VpnProxyExitState[], nameRaw: str): int32 =
    let name: str = strutil.Strip(nameRaw)
    if len(name) <= 0:
        return -1
    for i in 0..<states.len:
        if states[i].cfg.name == name:
            return i
    return -1

@borrows
fn VpnProxyExitIsDialerProxyTarget(states: var VpnProxyExitState[], exitIndex: int32): bool =
    if exitIndex < 0 || exitIndex >= states.len:
        return false
    let name: str = strutil.Strip(states[exitIndex].cfg.name)
    if len(name) <= 0:
        return false
    for i in 0..<states.len:
        if i == exitIndex:
            continue
        if strutil.Strip(states[i].cfg.dialerProxy) == name:
            return true
    return false

@borrows
fn VpnProxyTcpTlsForwardOpenTarget(link: var VpnProxyTcpTlsForwardLink,
                                   target: var VpnProxyTarget): Result[bool] =
    return VpnProxyTcpTlsForwardOpenTargetTimeoutMs(link, target, VpnProxyConnectTimeoutMs)

# [pool] 可配超时的 OPEN: 池取路径用短超时(陈旧热连接快速失败→回落冷拨),
# 黑洞 conn 不得把 TUN worker 拖满 15s。
@borrows
fn VpnProxyTcpTlsForwardOpenTargetTimeoutMs(link: var VpnProxyTcpTlsForwardLink,
                                            target: var VpnProxyTarget,
                                            openTimeoutMs: int32): Result[bool] =
    # Classify corrupted targets BEFORE building the open frame: the exit saw
    # "invalid remote address <junk>P<spaces>:<port>" spam from raw-IP relay
    # flows while the port field arrived intact, so the poison enters through
    # the host bytes. Validate with the same parser the exit side uses and
    # leave a class marker in the relay error channel instead of shipping an
    # undialable frame.
    if len(target.host) <= 0:
        VpnProxyTunRecordRelayError("of_host_empty")
        return Err[bool]("tcp-tls-forward: open target host empty")
    let addrProbeText: str = VpnProxyTargetAddress(target)
    let addrProbeRes: Result[listen.VpnProxyListenAddress] = listen.VpnProxyParseListenAddress(strings.CloneStr(addrProbeText))
    if IsErr(addrProbeRes):
        VpnProxyTunRecordRelayError("ofc_addr_invalid")
        return Err[bool]("tcp-tls-forward: open target address unparsable")
    var openFrame: Bytes
    let openAddrText: str = VpnProxyTargetAddress(target)
    let openFrameRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenFrameInto(link.streamId,
                                                                          openAddrText,
                                                                          openFrame)
    if openFrameRes <= 0:
        return Err[bool]("tcp-tls-forward: open frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, openFrame)
    BytesFree(openFrame)
    if IsErr(writeRes):
        return Err[bool](ErrorText(writeRes))
    # SCOPED DIAGNOSTIC: fd identity at OpenOk wait. REVERT.
    VpnProxyTunRecordRelayError(strutil.Join(["OPENWAIT fd=", strings.Int64ToStr(link.conn.fd), " open=", strings.Int64ToStr(int32(link.open))], ""))
    let replyRes: Result[ttf.VpnProxyTcpTlsForwardFrame] = VpnProxyTcpTlsReadFrameStopAware(link,
                                                                                             openTimeoutMs)
    if IsErr(replyRes):
        VpnProxyTunRecordRelayError(strutil.Join(["OPENWAIT err=", ErrorText(replyRes), " fd=", strings.Int64ToStr(link.conn.fd)], ""))
        return Err[bool](ErrorText(replyRes))
    let reply: ttf.VpnProxyTcpTlsForwardFrame = Value(replyRes)
    if reply.frameType == ttf.VpnProxyTcpTlsForwardFrameKindOpenOk():
        return Ok[bool](true)
    if reply.frameType == ttf.VpnProxyTcpTlsForwardFrameKindOpenError():
        return Err[bool](ttf.VpnProxyTcpTlsForwardPayloadText(reply))
    return Err[bool]("vpn proxy tcp-tls-forward: remote open rejected")

@borrows
fn VpnProxyTcpTlsForwardDialSelected(states: var VpnProxyExitState[],
                                     identity: var VpnProxyLoadedIdentity,
                                     idx: int32): Result[VpnProxyTcpTlsForwardLink] =
    if idx < 0 || idx >= states.len:
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy: invalid exit index")
    var selectedState: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
    let dialerName: str = strutil.Strip(selectedState.cfg.dialerProxy)
    if len(dialerName) <= 0:
        return VpnProxyTcpTlsForwardDialStates(states, identity, idx)
    if VpnProxyExitTransportText(selectedState.cfg) != "tcp-tls-forward":
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy dialer_proxy: final exit must be tcp-tls-forward")
    let dialerIndex: int32 = VpnProxyFindExitStateByName(states, dialerName)
    if dialerIndex < 0:
        return Err[VpnProxyTcpTlsForwardLink](strutil.Join(["vpn proxy dialer_proxy: target missing: ", strings.CloneStr(dialerName)], ""))
    if dialerIndex == idx:
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy dialer_proxy: self reference")
    var dialerState: VpnProxyExitState = VpnProxyCloneExitState(states[dialerIndex])
    if VpnProxyExitTransportText(dialerState.cfg) != "tcp-tls-forward":
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy dialer_proxy: target must be tcp-tls-forward")
    if len(strutil.Strip(dialerState.cfg.dialerProxy)) > 0:
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy dialer_proxy: nested dialer_proxy unsupported")
    let carrierRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyTcpTlsForwardDialStates(states, identity, dialerIndex)
    if IsErr(carrierRes):
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(carrierRes))
    var carrier: VpnProxyTcpTlsForwardLink = Value(carrierRes)
    var finalExitTarget: VpnProxyTarget
    finalExitTarget.host = selectedState.cfg.host
    finalExitTarget.port = selectedState.cfg.port
    let openCarrierRes: Result[bool] = VpnProxyTcpTlsForwardOpenTarget(carrier,
                                                                        finalExitTarget)
    if IsErr(openCarrierRes):
        VpnProxyCloseTcpTlsForwardLink(carrier)
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(openCarrierRes))
    let carrierStreamId: int32 = int32(carrier.streamId)
    carrier.exitIndex = idx
    carrier.streamId = 1
    carrier.dialerProxyActive = true
    carrier.dialerProxyStreamId = carrierStreamId
    let emptyPendingFrame: Bytes = BytesAlloc(0)
    let emptyPendingData: Bytes = BytesAlloc(0)
    carrier.dialerProxyFramePending = emptyPendingFrame
    carrier.dialerProxyDataPending = emptyPendingData
    let sniFinal: str = strings.CloneStr(states[idx].cfg.serverName)
    let authFinal: str = strings.CloneStr(states[idx].cfg.auth)
    let finalHandshakeRes: Result[bool] = VpnProxyTcpTlsForwardClientHandshakeScalars(carrier,
                                                                                      sniFinal,
                                                                                      authFinal,
                                                                                      identity)
    if IsErr(finalHandshakeRes):
        VpnProxyCloseTcpTlsForwardLink(carrier)
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(finalHandshakeRes))
    return Ok[VpnProxyTcpTlsForwardLink](carrier)

@borrows
fn VpnProxyOpenRemoteTcpTlsAttempt(states: var VpnProxyExitState[],
                                   identity: var VpnProxyLoadedIdentity,
                                   target: var VpnProxyTarget,
                                   idx: int32): Result[VpnProxyTcpTlsForwardLink] =
    if idx < 0 || idx >= states.len:
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy: invalid exit index")
    if VpnProxyExitTransportText(states[idx].cfg) != "tcp-tls-forward":
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy: exit is not tcp-tls-forward")
    let dialRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyTcpTlsForwardDialSelected(states,
                                                                                       identity,
                                                                                       idx)
    if IsErr(dialRes):
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
        let dialErrText: str = ErrorText(dialRes)
        routing.VpnProxyRecordOpenFailure(state, VpnProxyMonoNowMs(), dialErrText)
        VpnProxyStoreExitStateAt(states, idx, state)
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(dialRes))
    var link: VpnProxyTcpTlsForwardLink = Value(dialRes)
    let probeO: int64 = VpnProxyMonoNowMs()
    let openRes: Result[bool] = VpnProxyTcpTlsForwardOpenTarget(link, target)
    VpnProxyTunRecordRelayError(strutil.Join(["PROBE dial_open=", strings.Int64ToStr(VpnProxyMonoNowMs() - probeO)], ""))
    if IsOk(openRes):
        link.exitIndex = idx
        return Ok[VpnProxyTcpTlsForwardLink](link)
    VpnProxyCloseTcpTlsForwardLink(link)
    var state2: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
    let errText: str = ErrorText(openRes)
    routing.VpnProxyRecordOpenFailure(state2, VpnProxyMonoNowMs(), errText)
    VpnProxyStoreExitStateAt(states, idx, state2)
    return Err[VpnProxyTcpTlsForwardLink](errText)

@borrows
fn VpnProxyOpenRemoteDatagramAttempt(states: var VpnProxyExitState[],
                                       identity: var VpnProxyLoadedIdentity,
                                       idx: int32): Result[VpnProxyQuicLink] =
    if idx < 0 || idx >= states.len:
        return Err[VpnProxyQuicLink]("vpn proxy: invalid exit index")
    if VpnProxyExitTransportText(states[idx].cfg) == "tcp-tls-forward":
        return Err[VpnProxyQuicLink]("vpn proxy: tcp-tls-forward transport does not support UDP datagrams")
    if VpnProxyExitTransportText(states[idx].cfg) != "udp-quic":
        return Err[VpnProxyQuicLink]("vpn proxy: unsupported exit transport")
    let dialRes: Result[VpnProxyQuicLink] = VpnProxyDialExit(states[idx].cfg,
                                                                 identity,
                                                                 VpnProxyConnectTimeoutMs,
                                                                 idx,
                                                                 states[idx].sendClientCertificate)
    if IsErr(dialRes):
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
        routing.VpnProxyRecordOpenFailure(state, VpnProxyMonoNowMs(), ErrorText(dialRes))
        VpnProxyStoreExitStateAt(states, idx, state)
        return Err[VpnProxyQuicLink](ErrorText(dialRes))
    var link = Value(dialRes)
    let authRes: Result[Hysteria2AuthResponse] = VpnProxyHy2ClientHandshake(link.conn, states[idx].cfg)
    if IsErr(authRes):
        VpnProxyCloseQuicLink(link)
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
        routing.VpnProxyRecordOpenFailure(state, VpnProxyMonoNowMs(), ErrorText(authRes))
        VpnProxyStoreExitStateAt(states, idx, state)
        return Err[VpnProxyQuicLink](ErrorText(authRes))
    if !Value(authRes).udpEnabled:
        VpnProxyCloseQuicLink(link)
        var state: VpnProxyExitState = VpnProxyCloneExitState(states[idx])
        routing.VpnProxyRecordOpenFailure(state, VpnProxyMonoNowMs(), "vpn proxy: exit udp disabled")
        VpnProxyStoreExitStateAt(states, idx, state)
        return Err[VpnProxyQuicLink]("vpn proxy: exit udp disabled")
    link.exitIndex = idx
    return Ok[VpnProxyQuicLink](link)

@borrows
fn VpnProxyOpenRemote(states: var VpnProxyExitState[],
                        identity: var VpnProxyLoadedIdentity,
                        target: var VpnProxyTarget,
                        probeIntervalMs: int32,
                        probeTimeoutMs: int32): Result[VpnProxyQuicLink] =
    let firstIndex: int32 = routing.VpnProxyBestHealthyExit(states, -1)
    var firstTryIndex: int32 = firstIndex
    if firstTryIndex < 0 && states.len > 0:
        firstTryIndex = 0
    if firstTryIndex < 0:
        return Err[VpnProxyQuicLink]("vpn proxy: no exit")
    let secondIndex: int32 = routing.VpnProxyBestHealthyExit(states, firstTryIndex)
    let firstRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemoteAttempt(states, identity, target, firstTryIndex)
    let firstErr: str = if IsErr(firstRes): ErrorText(firstRes) else: ""
    if IsOk(firstRes):
        return firstRes
    if VpnProxyLocalProxyShouldStop():
        return Err[VpnProxyTcpTlsForwardLink](strutil.Join(["vpn proxy: open stopped: ", firstErr], ""))
    if secondIndex >= 0:
        let secondRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemoteAttempt(states, identity, target, secondIndex)
        let secondErr: str = if IsErr(secondRes): ErrorText(secondRes) else: ""
        if IsOk(secondRes):
            return secondRes
        return Err[VpnProxyQuicLink](strutil.Join(["vpn proxy: open failed on all exits: ", firstErr, " | ", secondErr], ""))
    return Err[VpnProxyQuicLink](strutil.Join(["vpn proxy: open failed on all exits: ", firstErr], ""))

@borrows
fn VpnProxyBestHealthyExitForTransport(states: var VpnProxyExitState[],
                                       transport: str,
                                       excludeIndex: int32): int32 =
    var bestIndex: int32 = -1
    var bestEwma: int64
    for i in 0..<states.len:
        if i == excludeIndex:
            continue
        if VpnProxyExitIsDialerProxyTarget(states, i):
            continue
        if VpnProxyExitTransportText(states[i].cfg) != transport:
            continue
        let state: VpnProxyExitState = VpnProxyCloneExitState(states[i])
        if !state.healthy:
            continue
        if state.ewmaMs <= 0:
            continue
        if bestIndex < 0 || state.ewmaMs < bestEwma:
            bestIndex = i
            bestEwma = state.ewmaMs
    if bestIndex >= 0:
        return bestIndex
    for i in 0..<states.len:
        if i == excludeIndex:
            continue
        if VpnProxyExitIsDialerProxyTarget(states, i):
            continue
        if VpnProxyExitTransportText(states[i].cfg) == transport:
            return i
    return -1

@borrows
fn VpnProxyOpenRemoteTcpTlsFromIndex(states: var VpnProxyExitState[],
                                     identity: var VpnProxyLoadedIdentity,
                                     target: var VpnProxyTarget,
                                     firstTryIndex: int32): Result[VpnProxyTcpTlsForwardLink] =
    # Lossy high-RTT paths drop the dial TCP handshake or a TLS flight
    # outright; one round of attempts is not enough. Retry the whole
    # sequence with backoff so transient loss rides out.
    let firstRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyOpenRemoteTcpTlsFromIndexOnce(states, identity, target, firstTryIndex)
    if IsOk(firstRes):
        return firstRes
    os.SleepMs(400)
    let secondRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyOpenRemoteTcpTlsFromIndexOnce(states, identity, target, firstTryIndex)
    if IsOk(secondRes):
        return secondRes
    os.SleepMs(800)
    let thirdRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyOpenRemoteTcpTlsFromIndexOnce(states, identity, target, firstTryIndex)
    if IsOk(thirdRes):
        return thirdRes
    return Err[VpnProxyTcpTlsForwardLink](ErrorText(thirdRes))

@borrows
fn VpnProxyOpenRemoteTcpTlsFromIndexOnce(states: var VpnProxyExitState[],
                                     identity: var VpnProxyLoadedIdentity,
                                     target: var VpnProxyTarget,
                                     firstTryIndex: int32): Result[VpnProxyTcpTlsForwardLink] =
    if firstTryIndex < 0:
        return Err[VpnProxyTcpTlsForwardLink]("vpn proxy: no exit")
    let secondIndex: int32 = VpnProxyBestHealthyExitForTransport(states,
                                                                 "tcp-tls-forward",
                                                                 firstTryIndex)
    let firstRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyOpenRemoteTcpTlsAttempt(states,
                                                                                      identity,
                                                                                      target,
                                                                                      firstTryIndex)
    let firstErr: str = if IsErr(firstRes): ErrorText(firstRes) else: ""
    if IsOk(firstRes):
        return firstRes
    if secondIndex >= 0:
        let secondRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyOpenRemoteTcpTlsAttempt(states,
                                                                                           identity,
                                                                                           target,
                                                                                           secondIndex)
        let secondErr: str = if IsErr(secondRes): ErrorText(secondRes) else: ""
        if IsOk(secondRes):
            return secondRes
        return Err[VpnProxyTcpTlsForwardLink](strutil.Join(["vpn proxy: open failed on all exits: ", firstErr, " | ", secondErr], ""))
    return Err[VpnProxyTcpTlsForwardLink](strutil.Join(["vpn proxy: open failed on all exits: ", firstErr], ""))

@borrows
fn VpnProxyOpenRemoteTcpTls(states: var VpnProxyExitState[],
                            identity: var VpnProxyLoadedIdentity,
                            target: var VpnProxyTarget): Result[VpnProxyTcpTlsForwardLink] =
    let firstIndex: int32 = VpnProxyBestHealthyExitForTransport(states,
                                                               "tcp-tls-forward",
                                                               -1)
    return VpnProxyOpenRemoteTcpTlsFromIndex(states, identity, target, firstIndex)

@borrows
fn VpnProxyOpenRemoteDatagram(states: var VpnProxyExitState[],
                                identity: var VpnProxyLoadedIdentity,
                                probeIntervalMs: int32,
                                probeTimeoutMs: int32): Result[VpnProxyQuicLink] =
    let firstIndex: int32 = routing.VpnProxyBestHealthyExit(states, -1)
    var firstTryIndex: int32 = firstIndex
    if firstTryIndex < 0 && states.len > 0:
        firstTryIndex = 0
    if firstTryIndex < 0:
        return Err[VpnProxyQuicLink]("vpn proxy: no exit")
    let secondIndex: int32 = routing.VpnProxyBestHealthyExit(states, firstTryIndex)
    let firstRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemoteDatagramAttempt(states, identity, firstTryIndex)
    let firstErr: str = if IsErr(firstRes): ErrorText(firstRes) else: ""
    if IsOk(firstRes):
        return firstRes
    if secondIndex >= 0:
        let secondRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemoteDatagramAttempt(states, identity, secondIndex)
        let secondErr: str = if IsErr(secondRes): ErrorText(secondRes) else: ""
        if IsOk(secondRes):
            return secondRes
        return Err[VpnProxyQuicLink](strutil.Join(["vpn proxy: open failed on all exits: ", firstErr, " | ", secondErr], ""))
    return Err[VpnProxyQuicLink](strutil.Join(["vpn proxy: open failed on all exits: ", firstErr], ""))

@borrows
fn VpnProxyTunTcpLinkIndex(links: VpnProxyTunTcpLink[], key: int64): int32 =
    for i in 0..<links.len:
        if links[i].open && links[i].sessionKey == key:
            return i
    return -1

fn VpnProxyTunTcpLinksClose(links: var VpnProxyTunTcpLink[]) =
    for i in 0..<links.len:
        if links[i].open && links[i].remoteOpen:
            # Close IN PLACE on the array element. Passing a struct copy let
            # Close free the shared pending buffers while the element kept
            # dangling pointers; the ORC teardown of the links array then
            # released them a SECOND time (registry_miss). Same for QuicLink
            # streamOpen flag divergence.
            if links[i].transportKind == VpnProxyTunTcpTransportTcpTls:
                VpnProxyTunProbeMark(strutil.Join(["cls_tls_", strings.IntToStr(i)], ""))
                VpnProxyCloseTcpTlsForwardLink(links[i].tcpTlsLink)
            else:
                VpnProxyTunProbeMark(strutil.Join(["cls_quic_", strings.IntToStr(i)], ""))
                VpnProxyCloseQuicLink(links[i].link)
            links[i].remoteOpen = false
            links[i].open = false
    # [mux] 会话级链路全关: 复用隧道一并复位。
    VpnProxyMuxSessionReset()

fn VpnProxyTunTcpLinkRemove(links: var VpnProxyTunTcpLink[], dropIdx: int32) =
    if dropIdx >= 0 && dropIdx < links.len:
        # [mux] 移除 muxed 流时收敛活跃计数(任何路径移除都计数, 防漂移)。
        if links[dropIdx].muxStreamId > 0:
            links[dropIdx].muxStreamId = 0
            if vpnMuxActive > 0:
                vpnMuxActive = vpnMuxActive - 1
        if links[dropIdx].open && links[dropIdx].remoteOpen:
            if links[dropIdx].transportKind == VpnProxyTunTcpTransportTcpTls:
                VpnProxyTunProbeMark("rm_tls")
                VpnProxyCloseTcpTlsForwardLink(links[dropIdx].tcpTlsLink)
            else:
                VpnProxyTunProbeMark("rm_quic")
                VpnProxyCloseQuicLink(links[dropIdx].link)
        # Clear state flags after closing so a stale-index Remove can never
        # double-close the same transport handle even if the caller races a
        # FlushRemote close (defense in depth for the double-free audit).
        links[dropIdx].remoteOpen = false
        links[dropIdx].open = false
    var kept: VpnProxyTunTcpLink[]
    for i in 0..<links.len:
        if i != dropIdx:
            var keptLink: VpnProxyTunTcpLink = links[i]
            add(kept, keptLink)
    links = kept

# Isolate a single broken forward link without tearing down the tun loop:
# reset the app-side session (RST, not FIN — the exit died mid-relay so the
# stream is truncated), close the transport in place on the array element,
# then remove the slot. The browser retries over a fresh TCP session whose
# dial re-opens the exit; every other session keeps flowing.
fn VpnProxyTunTcpLinkAbortIsolated(fd: int32,
                                   frameMode: int32,
                                   links: var VpnProxyTunTcpLink[],
                                   dropIdx: int32,
                                   markText: str) =
    if dropIdx < 0 || dropIdx >= links.len:
        return
    if links[dropIdx].open:
        let rst: Bytes = tun.VpnTunBuildTcpRst(links[dropIdx].lastPacket)
        if BytesLen(rst) > 0:
            let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, rst)
    VpnProxyTunProbeMark(markText)
    if links[dropIdx].open && links[dropIdx].remoteOpen:
        if links[dropIdx].transportKind == VpnProxyTunTcpTransportTcpTls:
            VpnProxyCloseTcpTlsForwardLink(links[dropIdx].tcpTlsLink)
        else:
            VpnProxyCloseQuicLink(links[dropIdx].link)
    links[dropIdx].remoteOpen = false
    links[dropIdx].open = false
    VpnProxyTunTcpLinkRemove(links, dropIdx)

fn VpnProxyTunPacketTarget(packet: Bytes): Result[VpnProxyTarget] =
    var parsed: tun.VpnTunIpv4Packet
    if !tun.VpnTunParseIpv4(packet, parsed):
        return Err[VpnProxyTarget]("vpn proxy tun: invalid ipv4 packet")
    var out: VpnProxyTarget
    out.host = parsed.dstIpText
    out.port = parsed.dstPort
    return Ok[VpnProxyTarget](out)

fn VpnProxyTunPacketSessionKey(packet: Bytes): Result[int64] =
    var parsed: tun.VpnTunIpv4Packet
    if !tun.VpnTunParseIpv4(packet, parsed):
        return Err[int64]("vpn proxy tun: invalid ipv4 packet")
    return Ok[int64](tun.VpnTunSessionKey(parsed.srcIp, parsed.srcPort, parsed.dstIp, parsed.dstPort))

@borrows
fn VpnProxyCloneLoadedIdentityForCall(src: var VpnProxyLoadedIdentity): VpnProxyLoadedIdentity =
    var out: VpnProxyLoadedIdentity
    var outCerts: Bytes[]
    outCerts = []
    for i in 0..<src.certs.len:
        var certCopy: Bytes = rawbytes.BytesSlice(src.certs[i], 0, rawbytes.BytesLen(src.certs[i]))
        add(outCerts, certCopy)
    out.certs = outCerts
    out.privateKey = rawbytes.BytesSlice(src.privateKey, 0, rawbytes.BytesLen(src.privateKey))
    out.leafKeyKind = src.leafKeyKind
    var outRoots: Bytes[]
    outRoots = []
    for i in 0..<src.trustRoots.len:
        var rootCopy: Bytes = rawbytes.BytesSlice(src.trustRoots[i], 0, rawbytes.BytesLen(src.trustRoots[i]))
        add(outRoots, rootCopy)
    out.trustRoots = outRoots
    return out

fn VpnProxyTlsU16(payload: rawbytes.Bytes, offset: int32): int32 =
    if offset < 0 || offset + 1 >= BytesLen(payload):
        return -1
    let hi: int32 = BytesGet(payload, offset) & 255
    let lo: int32 = BytesGet(payload, offset + 1) & 255
    return (hi << 8) | lo

fn VpnProxyTlsClientHelloSni(payload: rawbytes.Bytes): str =
    # Extract server_name from a TLS ClientHello carried in one record.
    # Returns "" when the payload is not a parseable ClientHello with SNI.
    let total: int32 = BytesLen(payload)
    if total < 43:
        return ""
    if (BytesGet(payload, 0) & 255) != 0x16:
        return ""
    let recLen: int32 = VpnProxyTlsU16(payload, 3)
    var hs: int32 = 5
    let hsEnd: int32 = 5 + recLen
    if hsEnd > total:
        hsEnd = total
    if hs + 4 > hsEnd:
        return ""
    if (BytesGet(payload, hs) & 255) != 0x01:
        return ""
    var pos: int32 = hs + 4
    if pos + 2 > hsEnd:
        return ""
    pos = pos + 2
    # skip the 32-byte random before session_id
    if pos + 32 > hsEnd:
        return ""
    pos = pos + 32
    let sidLen: int32 = BytesGet(payload, pos) & 255
    pos = pos + 1 + sidLen
    if pos + 2 > hsEnd:
        return ""
    let csLen: int32 = VpnProxyTlsU16(payload, pos)
    if csLen < 0:
        return ""
    pos = pos + 2 + csLen
    if pos + 1 > hsEnd:
        return ""
    let compLen: int32 = BytesGet(payload, pos) & 255
    pos = pos + 1 + compLen
    if pos + 2 > hsEnd:
        return ""
    let extTotal: int32 = VpnProxyTlsU16(payload, pos)
    pos = pos + 2
    let extEnd: int32 = pos + extTotal
    if extEnd > hsEnd:
        extEnd = hsEnd
    while pos + 4 <= extEnd:
        let extType: int32 = VpnProxyTlsU16(payload, pos)
        let extLen: int32 = VpnProxyTlsU16(payload, pos + 2)
        if extLen < 0:
            return ""
        let body: int32 = pos + 4
        if body + extLen > extEnd:
            return ""
        if extType == 0:
            if extLen < 5:
                return ""
            let listLen: int32 = VpnProxyTlsU16(payload, body)
            if listLen < 3:
                return ""
            let nameType: int32 = BytesGet(payload, body + 2) & 255
            if nameType != 0:
                return ""
            let hostLen: int32 = VpnProxyTlsU16(payload, body + 3)
            let hostStart: int32 = body + 5
            if hostLen <= 0 || hostStart + hostLen > total:
                return ""
            # Per-char str[] + Join corrupts transient element storage on
            # arm64-android (same class as the fake-DNS question name fix).
            # Copy the name bytes into ONE owned buffer and convert once.
            var nameBuf: rawbytes.Bytes = rawbytes.BytesAlloc(hostLen)
            var nameIdx: int32
            while nameIdx < hostLen:
                rawbytes.BytesSet(nameBuf, nameIdx, BytesGet(payload, hostStart + nameIdx) & 255)
                nameIdx = nameIdx + 1
            let sniText: str = rawbytes.BytesToString(nameBuf)
            rawbytes.BytesFree(nameBuf)
            return sniText
        pos = body + extLen
    return ""

@borrows
fn VpnProxyTunTcpEnsureRemoteOpen(states: var VpnProxyExitState[],
                                  identity: var VpnProxyLoadedIdentity,
                                  link: var VpnProxyTunTcpLink): Result[bool] =
    if link.remoteOpen:
        return Ok[bool](true)
    if len(link.targetHost) <= 0:
        # x86 byref mis-lowering drops the caller's field writes on the var
        # link copy; recover the parked target host instead of failing.
        if len(vpnTunOpenTargetHost) > 0:
            link.targetHost = strings.CloneStr(vpnTunOpenTargetHost)
        else:
            return Err[bool]("vpn proxy tun: tcp target host missing")
    if link.targetPort <= 0:
        return Err[bool]("vpn proxy tun: tcp target port missing")
    # [mux] 复用隧道优先: 一条 TLS 隧道承载多流, 新流只发 OPEN(~1RTT)。
    # 未就绪则先拨; mux 失败回落池取/冷拨(向后兼容)。仅限 tcp-tls-forward。
    # [carrier-rotate] 退役标记在挂时新流避让 mux(旧载体排空中), 直落池。
    if states.len > 0 && !vpnMuxRetirePending && VpnProxyExitTransportTextForIndex(states) == "tcp-tls-forward":
        let muxEnsureRes: Result[bool] = VpnProxyMuxEnsureTunnel(states, identity)
        if IsOk(muxEnsureRes):
            # 借用字段不作 byval 实参直传: 先 CloneStr 成 owned。
            let muxHostOwned: str = strings.CloneStr(link.targetHost)
            let muxOpenRes: Result[int32] = VpnProxyMuxOpenStream(muxHostOwned, link.targetPort)
            if IsOk(muxOpenRes):
                vpnTunOpenMuxValid = 1
                vpnTunOpenMuxStreamId = Value(muxOpenRes)
                vpnTunOpenTransportKind = VpnProxyTunTcpTransportTcpTls
                return Ok[bool](true)
        else:
            VpnProxyPoolMarker(strutil.Join(["MUX ensure err ", ErrorText(muxEnsureRes)], ""))
    # [pool] 热连接优先: 池内连接已完成 TCP+TLS+AUTH, 只差 OPEN(~1RTT),
    # 免去 dial_tcp+TLS+AUTH(~2s/流)。未命中或热连接已死 → 回落下方同步拨号。
    let poolRes: Result[bool] = VpnProxyPoolTakeAndOpen(link)
    if IsOk(poolRes):
        return Ok[bool](true)
    # of the states array. REVERT after fix.
    VpnProxyTunRecordRelayError(strings.ConcatStr("gate states.len=", strings.Int64ToStr(states.len)))
    if states.len <= 0:
        # aarch64 stale seq descriptor: the pump's copy reads empty while the
        # probes saw the populated array. Relay via the module-global registry
        # registered at session start. REVERT after kernel fix.
        return VpnProxyTunTcpEnsureRemoteOpenFromGlobal(identity, link)
    var selectedIndex: int32 = routing.VpnProxyBestHealthyExit(states, -1)
    if selectedIndex < 0 && states.len > 0:
        selectedIndex = 0
    if selectedIndex < 0:
        VpnProxyTunRecordRelayError("vpn proxy tun: no exit available")
        return Err[bool]("vpn proxy tun: no exit available")
    var target: VpnProxyTarget
    target.host = link.targetHost
    target.port = link.targetPort
    if VpnProxyExitTransportText(states[selectedIndex].cfg) == "tcp-tls-forward":
        # [dial-job] N-A: 前台冷拨(connect+TLS13+AUTH+OPEN)整体出主循环:
        # 提交后台拨号作业 + 本流标 pending 立即返回。拨号本体在 dial 线程
        # 原样执行(与池 fill 经 PoolDialLock 互斥, TLS13 全局不可重入约束
        # 不变); 成品由主循环 DIALJOB 收获装回本流。拨号坏窗(9-12s)期间
        # 数据面(mux drain/flush/keepalive/selfheal)连续泵 —— 断流主因消除。
        # 在途或槽忙(他人作业待收/拨号中): 本流一律 pending, 随下一 payload
        # 再试(对端 TCP 重传天然驱动)。
        if vpnDialJobState == 0:
            let _submitted: bool = VpnProxyDialJobSubmit(1, link.sessionKey, strings.CloneStr(link.targetHost), link.targetPort)
        vpnTunEnsurePending = 1
        return Ok[bool](true)
    let openRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemote(states,
                                                                identity,
                                                                target,
                                                                3000,
                                                                VpnProxyConnectTimeoutMs)
    if IsErr(openRes):
        return Err[bool](ErrorText(openRes))
    link.transportKind = VpnProxyTunTcpTransportQuic
    link.link = Value(openRes)
    link.remoteOpen = true
    return Ok[bool](true)

fn VpnProxyTunTcpEnsureRemoteOpenFromGlobal(identity: var VpnProxyLoadedIdentity,
                                            link: var VpnProxyTunTcpLink): Result[bool] =
    if vpnTunActiveExitStates.len <= 0:
        VpnProxyTunRecordRelayError("vpn proxy tun: no exit available")
        return Err[bool]("vpn proxy tun: no exit available")
    # Element-level clone: a fresh owned seq carries exact borrow authority
    # for the var-seq formals below (direct global pass fails the audit).
    var localStates: VpnProxyExitState[]
    for i in 0..<vpnTunActiveExitStates.len:
        add(localStates, VpnProxyCloneExitState(vpnTunActiveExitStates[i]))
    var target: VpnProxyTarget
    target.host = link.targetHost
    target.port = link.targetPort
    let transportText: str = strutil.Strip(strings.CloneStr(localStates[0].cfg.transport))
    if transportText == "tcp-tls-forward":
        # [dial-job] N-A: 同 EnsureRemoteOpen 主路 —— 冷拨出循环: 提交 +
        # pending 立即返回。exit/identity 由 dial 线程从会话交接快照解析。
        if vpnDialJobState == 0:
            let _submitted: bool = VpnProxyDialJobSubmit(1, link.sessionKey, strings.CloneStr(link.targetHost), link.targetPort)
        vpnTunEnsurePending = 1
        return Ok[bool](true)
    let openRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemote(localStates,
                                                                identity,
                                                                target,
                                                                3000,
                                                                VpnProxyConnectTimeoutMs)
    if IsErr(openRes):
        VpnProxyTunRecordRelayError(ErrorText(openRes))
        return Err[bool](ErrorText(openRes))
    link.transportKind = VpnProxyTunTcpTransportQuic
    link.link = Value(openRes)
    link.remoteOpen = true
    return Ok[bool](true)

fn VpnProxyTunTcpFlushRemote(runtime: var tun.VpnTunRuntime,
                              fd: int32,
                              frameMode: int32,
                              link: var VpnProxyTunTcpLink): Result[bool] =
    if !link.remoteOpen:
        return Ok[bool](true)
    if link.muxStreamId > 0:
        # [mux] 下行由泵的 MuxDrain 统一按流路由, 此处无事可做。
        return Ok[bool](true)
    if link.transportKind == VpnProxyTunTcpTransportTcpTls:
        # [drain-metrics] 单次 drain 批量统计: 帧数+总字节, 判断每次排水是否
        # 充分(与 TUN 写回速率/隧道窗口对读)。纯本地标量, 跨调用零传递。
        var drainFrames: int64
        var drainBytes: int64
        if vpnTunFlushEnterLogs < 4:
            vpnTunFlushEnterLogs = vpnTunFlushEnterLogs + 1
            VpnProxyTunRecordRelayError("FLUSH enter rOpen=" + strings.Int64ToStr(int64(link.remoteOpen)))
        while link.open:
            var frame: ttf.VpnProxyTcpTlsForwardFrame
            let frameRes: Result[bool] = VpnProxyTcpTlsTryReadFrameNonblocking(link.tcpTlsLink,
                                                                                link.tcpTlsPendingRead,
                                                                                frame)
            if IsErr(frameRes):
                let err: str = ErrorText(frameRes)
                if err == "vpn proxy tcp-tls-forward: remote closed":
                    if vpnTunTraceEnabled:
                        VpnProxyTunRecordRelayError(strutil.Join(["FLUSHBATCH frames=", strings.Int64ToStr(drainFrames), " bytes=", strings.Int64ToStr(drainBytes), " end=eof"], ""))
                    VpnProxyTunRecordRelayError("TUNCLOSE tls remote_eof")
                    let fin: Bytes = tun.VpnTunBuildTcpFin(runtime, link.lastPacket)
                    if BytesLen(fin) > 0:
                        let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, fin)
                    VpnProxyTunProbeMark("flsh_tls_rclose")
                    VpnProxyCloseTcpTlsForwardLink(link.tcpTlsLink)
                    link.open = false
                    return Ok[bool](true)
                return Err[bool](strings.CloneStr(err))
            if !Value(frameRes):
                # [drain-metrics] 空批(frames=0 bytes=0)不落环: 5ms flush tick
                # 每 tick 一条空 FLUSHBATCH 会刷掉 200 行环里的 POOL/TUNITER
                # 等关键标记。有实际交付量时才记录。
                if vpnTunTraceEnabled:
                    if drainFrames > 0 || drainBytes > 0:
                        VpnProxyTunRecordRelayError(strutil.Join(["FLUSHBATCH frames=", strings.Int64ToStr(drainFrames), " bytes=", strings.Int64ToStr(drainBytes), " end=drained"], ""))
                return Ok[bool](true)
            if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindData():
                # [byte-cmp] 交付对拍: 下行帧前 16B hex+总长(与服务器 tcpdump 对拍)。
                # [rss-batch] 必须整块门控: 16 次 ConcatStr 在 RecordRelayError
                # early-return 之前执行, trace 关时也是纯 churn(每帧~20 次堆串分配)。
                if vpnTunTraceEnabled:
                    var thx: str = "THX t=" + strings.Int64ToStr(VpnProxyMonoNowMs()) + " len=" + strings.Int64ToStr(int64(BytesLen(frame.payload))) + " head="
                    var thi: int32
                    while thi < 16:
                        if thi >= BytesLen(frame.payload):
                            break
                        thx = thx + strings.Int64ToStr(int64(BytesGet(frame.payload, thi) & 255)) + ","
                        thi = thi + 1
                    VpnProxyTunRecordRelayError(thx)
                drainFrames = drainFrames + 1
                drainBytes = drainBytes + int64(BytesLen(frame.payload))
                let reply: Bytes = tun.VpnTunBuildTcpPayload(runtime, link.lastPacket, frame.payload)
                if BytesLen(reply) > 0:
                    if !tun.VpnTunWritePacketFrameMode(fd, frameMode, reply):
                        # SCOPED DIAGNOSTIC: TUN write failure marker. REVERT.
                        VpnProxyTunRecordRelayError(strings.ConcatStr("TUNW FAIL len=", strings.Int64ToStr(BytesLen(reply))))
                        return Err[bool]("vpn proxy tun: tcp write failed")
                    # SCOPED DIAGNOSTIC: TUN write ok marker. REVERT.
                    # [rss-batch] 成功路径每帧一次 ConcatStr, 同样随总开关门控。
                    if vpnTunTraceEnabled:
                        VpnProxyTunRecordRelayError(strings.ConcatStr("TUNW len=", strings.Int64ToStr(BytesLen(reply))))
                    vpnTunFastPoll = true
                    vpnTunSelfHealLastThxMs = VpnProxyMonoNowMs()
            elif frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindClose():
                let fin: Bytes = tun.VpnTunBuildTcpFin(runtime, link.lastPacket)
                if BytesLen(fin) > 0:
                    let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, fin)
                VpnProxyTunProbeMark("flsh_tls_frameclose")
                VpnProxyCloseTcpTlsForwardLink(link.tcpTlsLink)
                link.open = false
                return Ok[bool](true)
            else:
                return Err[bool]("vpn proxy tun: tcp-tls-forward unexpected frame")
        return Ok[bool](true)
    while link.open:
        let readRes: Result[Bytes] = hy2sess.VpnProxyHy2TcpStreamReadNonblocking(link.link.stream,
                                                                                  VpnProxyRelayChunkBytes)
        if IsErr(readRes):
            let err: str = ErrorText(readRes)
            if VpnProxyWouldBlockQuic(err):
                return Ok[bool](true)
            if err == "msquic: stream closed" ||
               err == "msquic: pipe closed" ||
               err == "connection: closed":
                let fin: Bytes = tun.VpnTunBuildTcpFin(runtime, link.lastPacket)
                if BytesLen(fin) > 0:
                    let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, fin)
                VpnProxyTunProbeMark("flsh_quic_sclose")
                VpnProxyCloseQuicLink(link.link)
                link.open = false
                return Ok[bool](true)
            return Err[bool](strings.CloneStr(err))
        let chunk: Bytes = Value(readRes)
        if BytesLen(chunk) <= 0:
            return Ok[bool](true)
        let reply: Bytes = tun.VpnTunBuildTcpPayload(runtime, link.lastPacket, chunk)
        if BytesLen(reply) > 0:
            if !tun.VpnTunWritePacketFrameMode(fd, frameMode, reply):
                return Err[bool]("vpn proxy tun: tcp write failed")
    return Ok[bool](true)

fn VpnProxyTunTcpFlushRemoteSeq(runtime: var tun.VpnTunRuntime,
                                fd: int32,
                                frameMode: int32,
                                link: var VpnProxyTunTcpLink,
                                recvSeq: int64): Result[int64] =
    # [seq-fix] 接收 seq byval 进/Result 出: 元素 copy-back 丢批间递增,
    # 批间从旧 seq 重启解密=第二批起对手机全垃圾(浏览器告警关流白屏)。
    link.tcpTlsLink.recvKeys.seq = recvSeq
    let flushRes: Result[bool] = VpnProxyTunTcpFlushRemote(runtime, fd, frameMode, link)
    if IsErr(flushRes):
        return Err[int64](ErrorText(flushRes))
    return Ok[int64](link.tcpTlsLink.recvKeys.seq)


@borrows
fn VpnProxyTunUdpFlowIndex(flows: VpnProxyTunUdpFlow[], sessionId: int64): int32 =
    for i in 0..<flows.len:
        if flows[i].sessionId == sessionId:
            return i
    return -1

fn VpnProxyTunUdpRemember(flows: var VpnProxyTunUdpFlow[],
                           sessionId: int64,
                           address: str,
                           packet: Bytes) =
    var flow: VpnProxyTunUdpFlow
    flow.sessionId = sessionId
    flow.address = strings.CloneStr(address)
    flow.clientPacket = rawbytes.BytesSlice(packet, 0, rawbytes.BytesLen(packet))
    add(flows, flow)

fn VpnProxyTunUdpFlushRemote(fd: int32,
                              frameMode: int32,
                              link: var VpnProxyQuicLink,
                              flows: var VpnProxyTunUdpFlow[],
                              remoteFrags: var VpnProxyUdpFragState[]): Result[bool] =
    while true:
        let readRes: Result[Bytes] = qtransport.msquicTransportDatagramRead(link.transport, link.conn)
        if IsErr(readRes):
            var errText: str = ErrorText(readRes)
            if VpnProxyWouldBlockQuic(errText):
                return Ok[bool](true)
            var errOwned: str = strings.CloneStr(errText)
            return Err[bool](errOwned)
        var decodedRaw: Bytes = Value(readRes)
        let msgRes: Result[Hysteria2UdpMessage] = hy2.Hysteria2DecodeUdpMessage(decodedRaw)
        if IsErr(msgRes):
            var msgErrText: str = ErrorText(msgRes)
            return Err[bool](msgErrText)
        var fullMsg: Hysteria2UdpMessage
        var decodedMsg: Hysteria2UdpMessage = Value(msgRes)
        let fullRes: Result[bool] = VpnProxyUdpFragFeed(remoteFrags, decodedMsg, fullMsg)
        if IsErr(fullRes):
            var fullErrText: str = ErrorText(fullRes)
            return Err[bool](fullErrText)
        if Value(fullRes):
            let idx: int32 = VpnProxyTunUdpFlowIndex(flows, fullMsg.sessionId)
            if idx < 0:
                return Err[bool]("vpn proxy tun: udp session unknown")
            var flowEntry: VpnProxyTunUdpFlow = flows[idx]
            let reply: Bytes = tun.VpnTunBuildUdpResponse(flowEntry.clientPacket, fullMsg.payload)
            if BytesLen(reply) > 0:
                if !tun.VpnTunWritePacketFrameMode(fd, frameMode, reply):
                    return Err[bool]("vpn proxy tun: udp write failed")

# ===========================================================================
# [pool] 预热隧道连接池(纯客户端, 服务器零改动): N=2 条已完成 TCP+TLS+AUTH
# 的热连接。新流到达 → 取热连接 → 只发 OPEN(~1RTT) → 立即 relay, 免去每流
# dial_tcp(~564ms)+TLS+AUTH(~1.5-2s)。后台 maintainer 线程维持水位。
#
# 形状纪律(aarch64 三禁忌):
# - 槽 = 全局 var struct 单槽 + 标量状态机, 禁 managed seq-of-struct;
#   状态迁移全部走 cheng_atomic_cas_i32 原子所有权转移(同自旋锁先例)。
# - 状态机: 0=空 1=填充中(生产者独占) 2=热连接就绪 3=消费中(消费者独占)。
#   生产者单线程(maintainer), 消费者单线程(TUN worker)。
# - 交接 = 严格所有权转移: 生产者发布(state=2)后不再触碰槽内容; 消费者
#   CAS(2→3)取走后立即归还槽(state=0)再慢速 OPEN, 补拨与 OPEN 重叠。
# - 取用路径复用 OpenRemoteTcpTlsAttempt 同款已证形状: 本地 var struct +
#   @borrows OpenTarget + park 全局(vpnTunOpenTcpTlsLink/vpnTunOpenValid)
#   交接, 调用方 post-restore 零改动。
# ===========================================================================
var vpnPoolLinkA: VpnProxyTcpTlsForwardLink
var vpnPoolStateA: int32
var vpnPoolPutMsA: int64
var vpnPoolPingMsA: int64
# [keepalive] 消费者坏档对账镜像: fill 后 AUTH 耗 seq0 → 期待 send seq=1;
# 每次成功 PING 消耗一条发送记录 → 镜像 +1。消费者比对槽内 seq 与镜像,
# 失配=拷贝失真(原 seq==1 不变式的 ping 兼容版, 检测强度不降)。
var vpnPoolExpectSeqA: int64
var vpnPoolLinkB: VpnProxyTcpTlsForwardLink
var vpnPoolStateB: int32
var vpnPoolPutMsB: int64
var vpnPoolPingMsB: int64
var vpnPoolExpectSeqB: int64
# 会话代际: 每次会话启动 ++, maintainer 捕获后比对, 换代即退出。
var vpnPoolGeneration: int32
# [dial-serial] 全客户端拨号互斥: TLS13 握手状态是全局的(msquicTls13*),
# 握手锁只护 CPU 段后, 两次并发拨号的外层 IO 序列交错即污染全局状态
# (实证: 并发拨号报 'tls13: application secrets not ready')。历史形状=
# 全程持锁串行; 本锁恢复该语义: fill 与前台冷拨互斥, 热连接 OPEN 不碰
# 握手全局, 不持锁。
# [fair-ticket] 取号-叫号锁: 原 0/1 CAS 自旋锁无排队序, maintainer 高频
# probe/fill 反复抢锁可让 dial-job 线程无限插队饿死(诊断 trace 实锤:
# DIALJOB pending flow 无限滞留, curl 流拨号永不认领)。取号-叫号保证
# FIFO, 先到先拨。
var VpnProxyPoolDialTicket: int32
var VpnProxyPoolDialServing: int32
# 在途填充计数: SessionStart 覆盖 identity/exitstates 全局前必须等它归零
# (fill 线程克隆这两个全局期间, ORC 非原子引用计数不容并发触碰)。
var vpnPoolFillingCount: int32
var vpnPoolMissStreak: int32
# [nborc] 旧 vpnPoolIdentity/vpnPoolIdentityValid 全局已拆除: maintainer 每次
# fill 克隆这两个全局, 与下一代 tun worker 的无守卫写点(mobile 入口
# SetTunActiveExitStates 重注册 / SessionStart 覆盖)构成并发窗(ORC 非原子
# 引用计数不容并发触碰, 快速重启时旧 maintainer 存活跨越写点)。新形=spawn
# 交接槽(读写面拆分): SessionStart 写槽(owned 深拷) → StartPtr happens-
# before → maintainer 启动单次快照, 运行期零托管全局读。
var vpnPoolHandoffStates: VpnProxyExitState[]
var vpnPoolHandoffIdentity: VpnProxyLoadedIdentity
# 池计数(状态心跳可见的验收读数)。
var vpnPoolTakeCount: int32
var vpnPoolTakeOkCount: int32
var vpnPoolMissCount: int32
var vpnPoolFillCount: int32

fn VpnProxyPoolMarker(text: str) =
    # 池事件写状态心跳可见的 lastRelayError 槽(5s 心跳经
    # VpnProxyTunLastErrorText 上报), 不进 trace 环(热路径门控防 RSS churn);
    # trace 开时才落环。
    # [orcu-marker] 锁内单槽写: maintainer/worker 双线程 marker 交错
    # 释放/装新 = underflow 家族(storm 夹具实证)。
    VpnProxyMarkerLock()
    vpnTunLastRelayError = strings.CloneStr(text)
    VpnProxyMarkerUnlock()
    if vpnTunTraceEnabled:
        VpnProxyTunRecordRelayError(strings.CloneStr(text))

fn VpnProxyPoolFillingEnter() =
    while true:
        let cur: int32 = vpnPoolFillingCount
        if VpnProxyAtomicCasI32(&vpnPoolFillingCount, cur, cur + 1) == 1:
            return

fn VpnProxyPoolFillingExit() =
    while true:
        let cur: int32 = vpnPoolFillingCount
        if VpnProxyAtomicCasI32(&vpnPoolFillingCount, cur, cur - 1) == 1:
            return

fn VpnProxyPoolDialLock() =
    # [fair-ticket] 取号: CAS fetch-increment 拿序号, 再自旋等叫号到。
    var myTicket: int32 = -1
    while myTicket < 0:
        let cur: int32 = VpnProxyPoolDialTicket
        if VpnProxyAtomicCasI32(&VpnProxyPoolDialTicket, cur, cur + 1) == 1:
            myTicket = cur
    while VpnProxyPoolDialServing != myTicket:
        thread.Yield()

fn VpnProxyPoolDialUnlock() =
    # [fair-ticket] 叫下一位。持锁者唯一, 读-改-写无竞。
    VpnProxyAtomicStoreI32(&VpnProxyPoolDialServing, VpnProxyPoolDialServing + 1)

@borrows
fn VpnProxyExitTransportTextForIndex(states: var VpnProxyExitState[]): str =
    # mux 优先路径用: 取最优 tcp-tls-forward exit 的 transport 文本。
    let idx: int32 = VpnProxyBestHealthyExitForTransport(states, "tcp-tls-forward", -1)
    if idx < 0:
        return ""
    return VpnProxyExitTransportText(states[idx].cfg)

# 排水 = 发 PROBE 帧并等 ProbeOk(≤1s)再关: 服务器走 Probe→ProbeOk→Ok 收尾,
# journal 记 conn end ok, 避免 "AUTH 后裸断 → eof" 污染验收读数。全部
# best-effort: conn 已死时写/读失败直接关闭。
fn VpnProxyPoolProbeDrainLink(link: var VpnProxyTcpTlsForwardLink) =
    var probeFrame: Bytes
    let built: int32 = ttf.VpnProxyTcpTlsForwardBuildProbeFrameInto(probeFrame)
    if built > 0:
        let probeWriteRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, probeFrame)
        BytesFree(probeFrame)
        if IsOk(probeWriteRes):
            let _ = VpnProxyTcpTlsReadFrameStopAware(link, 1000)
    VpnProxyCloseTcpTlsForwardLink(link)

fn VpnProxyPoolDrainHot() =
    # 关闭当前就绪热连接(仅会话启停/停机时调用; CAS 取所有权后关, 防与
    # 消费者竞态)。
    if VpnProxyAtomicCasI32(&vpnPoolStateA, 2, 3) == 1:
        VpnProxyPoolProbeDrainLink(vpnPoolLinkA)
        VpnProxyAtomicStoreI32(&vpnPoolStateA, 0)
    if VpnProxyAtomicCasI32(&vpnPoolStateB, 2, 3) == 1:
        VpnProxyPoolProbeDrainLink(vpnPoolLinkB)
        VpnProxyAtomicStoreI32(&vpnPoolStateB, 0)

# [keepalive] 停靠热槽 PING 验活: 服务器 AUTH 后停靠窗口的 15s 读超时被
# 每次 PING 重置, 热连接不再被服务器周期掐断(旧行为=22s 一轮 conn end
# read timeout, 消费者把 OPEN 写进已死连接=下行 flight 丢失白屏)。返回
# >=0 = pong 校验通过且值为 ping 后的 send seq 标量镜像(调用方刷新保鲜
# 时点与期待 seq 并回存 state=2); -1 = 写失败或 pong 缺失/错误(调用方
# 关连接回存 state=0 补拨)。调用前调用方必须已 CAS 该槽 2→3(与消费者/
# 排水互斥)。PingOk 空 payload 是已释放底座的空视图, 与排水路径同款:
# 整帧弃读, 禁止 free payload。seq 读在函数内同函数往返(嵌套投影跨调用
# 持久 hazard 禁区), 调用方只接标量。
fn VpnProxyPoolPingSlot(link: var VpnProxyTcpTlsForwardLink): int64 =
    var pingFrame: Bytes
    let built: int32 = ttf.VpnProxyTcpTlsForwardBuildPingFrameInto(pingFrame)
    if built <= 0:
        return int64(-1)
    let pingWriteRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, pingFrame)
    BytesFree(pingFrame)
    if IsErr(pingWriteRes):
        return int64(-1)
    let pongRes: Result[ttf.VpnProxyTcpTlsForwardFrame] = VpnProxyTcpTlsReadFrameStopAware(link,
                                                                                           VpnProxyPoolPingTimeoutMs)
    if IsErr(pongRes):
        return int64(-1)
    let pong: ttf.VpnProxyTcpTlsForwardFrame = Value(pongRes)
    if pong.frameType != ttf.VpnProxyTcpTlsForwardFrameKindPingOk():
        return int64(-1)
    let seqNow: int64 = link.sendKeys.seq
    return seqNow

fn VpnProxyPoolSessionStart(states: var VpnProxyExitState[],
                             identity: var VpnProxyLoadedIdentity) =
    vpnPoolGeneration = vpnPoolGeneration + 1
    # 先等在途 fill 收尾(最多一个拨号周期), 再覆盖 identity/exitstates 全局:
    # 旧 maintainer 线程克隆这两个全局期间, ORC 非原子引用计数不容并发触碰。
    while vpnPoolFillingCount > 0:
        thread.Yield()
    VpnProxyPoolDrainHot()
    # [mux] 会话换代: 复用隧道一并复位(旧 maintainer 已等收尾)。
    VpnProxyMuxSessionReset()
    # 桌面 CLI tun 路径未注册全局 exits 时补注册(泵 fallback 读全局)。
    if vpnTunActiveExitStates.len <= 0:
        VpnProxySetTunActiveExitStates(states)
    # [nborc] spawn 前把 owned 深拷写进交接槽: maintainer 启动单次快照,
    # fill 不再读 vpnTunActiveExitStates/identity 全局(并发窗消)。
    vpnPoolHandoffStates = VpnProxyCloneExitStates(states)
    vpnPoolHandoffIdentity = VpnProxyCloneLoadedIdentityForCall(identity)
    let genValue: uint64 = uint64(vpnPoolGeneration)
    let worker = thread.StartPtr(&VpnProxyPoolMaintainerMain, ptr(genValue))
    if worker != nil:
        let _ = thread.Detach(worker)
    VpnProxyPoolMarker(strutil.Join(["POOL start gen=", strings.Int64ToStr(int64(vpnPoolGeneration))], ""))
    # [dial-job] N-A: 拨号线程随会话启动(与 maintainer 共享同一交接快照与
    # 代际; 旧代线程空闲即退, 迟到的旧代结果由收获侧 wantSeq 对账弃装)。
    # 复位对账标在本线程(收获唯一执行者), 先于新循环建立判据基线。
    vpnTunDialWantSeq = -1
    vpnTunDialWantKey = 0
    let dialGenValue: uint64 = uint64(vpnPoolGeneration)
    let dialWorker = thread.StartPtr(&VpnProxyDialJobThreadMain, ptr(dialGenValue))
    if dialWorker != nil:
        let _ = thread.Detach(dialWorker)
    VpnProxyPoolMarker(strutil.Join(["DIALJOB start gen=", strings.Int64ToStr(int64(vpnPoolGeneration))], ""))

# 单槽填充: 调用方已 CAS 该槽 0→1(生产者独占)。states/identity = maintainer
# 启动快照(本地), 不读全局。返回码: 1=已发布(或换代收尾), 0=拨号失败(小
# 退避), -1=无可用 tcp-tls-forward exit(长退避)。
fn VpnProxyPoolFillSlot(slotIdx: int32,
                        myStates: var VpnProxyExitState[],
                        myIdentity: var VpnProxyLoadedIdentity): int32 =
    VpnProxyPoolFillingEnter()
    let myGen: int32 = vpnPoolGeneration
    var code: int32
    # 双卫皆=交接快照在(形稳零重排): 快照空=无可用 exits, 长退避语义同旧。
    if myStates.len > 0:
        if myStates.len > 0:
            var localStates: VpnProxyExitState[]
            for i in 0..<myStates.len:
                add(localStates, VpnProxyCloneExitState(myStates[i]))
            var ident: VpnProxyLoadedIdentity = VpnProxyCloneLoadedIdentityForCall(myIdentity)
            let idx: int32 = VpnProxyBestHealthyExitForTransport(localStates, "tcp-tls-forward", -1)
            if idx >= 0:
                vpnPoolFillCount = vpnPoolFillCount + 1
                let dialT0: int64 = VpnProxyMonoNowMs()
                # [dial-serial] 与前台冷拨互斥: TLS13 全局握手状态不可重入。
                VpnProxyPoolDialLock()
                let dialRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyTcpTlsForwardDialSelected(localStates, ident, idx)
                VpnProxyPoolDialUnlock()
                if IsOk(dialRes):
                    var hot: VpnProxyTcpTlsForwardLink = Value(dialRes)
                    hot.exitIndex = idx
                    if vpnPoolGeneration == myGen:
                        if slotIdx == 0:
                            vpnPoolLinkA = hot
                            vpnPoolPutMsA = VpnProxyMonoNowMs()
                            vpnPoolPingMsA = vpnPoolPutMsA
                            vpnPoolExpectSeqA = int64(1)
                        else:
                            vpnPoolLinkB = hot
                            vpnPoolPutMsB = VpnProxyMonoNowMs()
                            vpnPoolPingMsB = vpnPoolPutMsB
                            vpnPoolExpectSeqB = int64(1)
                        code = 1
                        VpnProxyPoolMarker(strutil.Join(["POOL fill dial_ms=", strings.Int64ToStr(VpnProxyMonoNowMs() - dialT0)], ""))
                    else:
                        VpnProxyCloseTcpTlsForwardLink(hot)
                        code = 1
                else:
                    VpnProxyPoolMarker(strutil.Join(["POOL fill_err ", ErrorText(dialRes)], ""))
                    code = 0
            else:
                code = -1
    else:
        code = -1
    VpnProxyPoolFillingExit()
    if slotIdx == 0:
        if code == 1:
            VpnProxyAtomicStoreI32(&vpnPoolStateA, 2)
        else:
            VpnProxyAtomicStoreI32(&vpnPoolStateA, 0)
    else:
        if code == 1:
            VpnProxyAtomicStoreI32(&vpnPoolStateB, 2)
        else:
            VpnProxyAtomicStoreI32(&vpnPoolStateB, 0)
    return code

fn VpnProxyPoolMaintainerMain(raw: ptr) =
    if raw == nil:
        return
    let myGen: int32 = int32(uint64(raw))
    # [nborc] 启动单次深拷快照(StartPtr happens-before 保证可见; 全局作 var
    # 实参有 VpnProxyCloseTcpTlsForwardLink(vpnPoolLinkA) 先例; share(全局)
    # 撞 exact-owned 墙故用深拷助手)。之后 fill 全用本地副本, 运行期零托管
    # 全局读。下一代会话重写交接槽时本线程持独立副本, 释放互不波及。
    var myStates: VpnProxyExitState[] = VpnProxyCloneExitStates(vpnPoolHandoffStates)
    var myIdentity: VpnProxyLoadedIdentity = VpnProxyCloneLoadedIdentityForCall(vpnPoolHandoffIdentity)
    while true:
        if vpnPoolGeneration != myGen:
            # 会话换代: 新会话的 Start 已接管排水, 本线程只退出(不碰新代槽位)。
            return
        if VpnProxyTunStopRequested:
            VpnProxyPoolDrainHot()
            VpnProxyPoolMarker("POOL stop")
            return
        # [keepalive] 停靠热槽周期 PING 验活(mux 复用就绪时池冻结, 不碰)。
        # pong 通过 → 刷新 ping/保鲜时点回存 state=2; 失败 → 关连接回存
        # state=0 由下方补拨。5s 节奏, 服务器 15s 停靠窗口内至少 2 轮。
        if vpnMuxState != 2:
            if VpnProxyAtomicCasI32(&vpnPoolStateA, 2, 3) == 1:
                if VpnProxyMonoNowMs() - vpnPoolPingMsA > VpnProxyPoolPingIntervalMs:
                    let pingSeqA: int64 = VpnProxyPoolPingSlot(vpnPoolLinkA)
                    if pingSeqA >= int64(0):
                        vpnPoolPingMsA = VpnProxyMonoNowMs()
                        vpnPoolPutMsA = vpnPoolPingMsA
                        vpnPoolExpectSeqA = pingSeqA
                        VpnProxyAtomicStoreI32(&vpnPoolStateA, 2)
                    else:
                        VpnProxyCloseTcpTlsForwardLink(vpnPoolLinkA)
                        VpnProxyAtomicStoreI32(&vpnPoolStateA, 0)
                else:
                    VpnProxyAtomicStoreI32(&vpnPoolStateA, 2)
            if VpnProxyAtomicCasI32(&vpnPoolStateB, 2, 3) == 1:
                if VpnProxyMonoNowMs() - vpnPoolPingMsB > VpnProxyPoolPingIntervalMs:
                    let pingSeqB: int64 = VpnProxyPoolPingSlot(vpnPoolLinkB)
                    if pingSeqB >= int64(0):
                        vpnPoolPingMsB = VpnProxyMonoNowMs()
                        vpnPoolPutMsB = vpnPoolPingMsB
                        vpnPoolExpectSeqB = pingSeqB
                        VpnProxyAtomicStoreI32(&vpnPoolStateB, 2)
                    else:
                        VpnProxyCloseTcpTlsForwardLink(vpnPoolLinkB)
                        VpnProxyAtomicStoreI32(&vpnPoolStateB, 0)
                else:
                    VpnProxyAtomicStoreI32(&vpnPoolStateB, 2)
        # [pool] 保鲜: 超龄热槽关闭换新(权属 CAS 仲裁, 与消费者取用互斥)。
        if VpnProxyAtomicCasI32(&vpnPoolStateA, 2, 3) == 1:
            if VpnProxyMonoNowMs() - vpnPoolPutMsA > VpnProxyPoolMaxAgeMs:
                VpnProxyCloseTcpTlsForwardLink(vpnPoolLinkA)
                VpnProxyAtomicStoreI32(&vpnPoolStateA, 0)
            else:
                VpnProxyAtomicStoreI32(&vpnPoolStateA, 2)
        if VpnProxyAtomicCasI32(&vpnPoolStateB, 2, 3) == 1:
            if VpnProxyMonoNowMs() - vpnPoolPutMsB > VpnProxyPoolMaxAgeMs:
                VpnProxyCloseTcpTlsForwardLink(vpnPoolLinkB)
                VpnProxyAtomicStoreI32(&vpnPoolStateB, 0)
            else:
                VpnProxyAtomicStoreI32(&vpnPoolStateB, 2)
        # [mux] 复用隧道就绪时冻结池(不补拨不排旧), mux 死亡自动恢复。
        if vpnMuxState == 2:
            os.SleepMs(VpnProxyPoolPollMs)
            continue
        # 每轮至多填一槽(串行拨号, 单生产者纪律); 按填充结果分级退避。
        if VpnProxyAtomicCasI32(&vpnPoolStateA, 0, 1) == 1:
            let fillCodeA: int32 = VpnProxyPoolFillSlot(0, myStates, myIdentity)
            if fillCodeA == 0:
                os.SleepMs(2000)
            if fillCodeA < 0:
                os.SleepMs(60000)
            continue
        if VpnProxyAtomicCasI32(&vpnPoolStateB, 0, 1) == 1:
            let fillCodeB: int32 = VpnProxyPoolFillSlot(1, myStates, myIdentity)
            if fillCodeB == 0:
                os.SleepMs(2000)
            if fillCodeB < 0:
                os.SleepMs(60000)
            continue
        os.SleepMs(VpnProxyPoolPollMs)

# 池取 + OPEN: TUN worker 的 EnsureRemoteOpen 专用。命中 → 热连接只差一个
# OPEN 往返; 未命中/热连接已死 → 返回 Err 回落原同步拨号路径。
@borrows
fn VpnProxyPoolTakeAndOpen(link: var VpnProxyTunTcpLink): Result[bool] =
    var hot: VpnProxyTcpTlsForwardLink
    var took: bool
    # [keepalive] 坏档对账期待值: 槽 CAS 独占期间读镜像标量(与槽内容同窗)。
    var expectSeq: int64 = int64(-1)
    if VpnProxyAtomicCasI32(&vpnPoolStateA, 2, 3) == 1:
        if VpnProxyMonoNowMs() - vpnPoolPutMsA > VpnProxyPoolMaxAgeMs:
            # 超龄槽: NAT 映射大概率已死, 直接关闭换新, 不吃 2.5s 死 OPEN。
            VpnProxyCloseTcpTlsForwardLink(vpnPoolLinkA)
            VpnProxyAtomicStoreI32(&vpnPoolStateA, 0)
        else:
            hot = vpnPoolLinkA
            expectSeq = vpnPoolExpectSeqA
            VpnProxyAtomicStoreI32(&vpnPoolStateA, 0)
            took = true
    if !took:
        if VpnProxyAtomicCasI32(&vpnPoolStateB, 2, 3) == 1:
            if VpnProxyMonoNowMs() - vpnPoolPutMsB > VpnProxyPoolMaxAgeMs:
                VpnProxyCloseTcpTlsForwardLink(vpnPoolLinkB)
                VpnProxyAtomicStoreI32(&vpnPoolStateB, 0)
            else:
                hot = vpnPoolLinkB
                expectSeq = vpnPoolExpectSeqB
                VpnProxyAtomicStoreI32(&vpnPoolStateB, 0)
                took = true
    if !took:
        vpnPoolMissCount = vpnPoolMissCount + 1
        VpnProxyPoolMarker(strutil.Join(["POOL miss take=", strings.Int64ToStr(int64(vpnPoolTakeCount))], ""))
        return Err[bool]("vpn proxy tun: pool empty")
    # [pool-handoff-fix] 槽拷贝失真检测(ping 兼容版): fill 后期待 seq=1,
    # 每次 PING 推进镜像; 槽内 seq 与镜像失配 = 拷贝失真/可见性坏档 →
    # 该槽密钥不可信, 直接弃槽回落冷拨 —— 坏 OPEN 记录不再上线。
    let takenSendSeq: int64 = hot.sendKeys.seq
    if takenSendSeq != expectSeq:
        VpnProxyCloseTcpTlsForwardLink(hot)
        VpnProxyPoolMarker(strutil.Join(["POOL badslot send_seq=", strings.Int64ToStr(takenSendSeq), " expect=", strings.Int64ToStr(expectSeq)], ""))
        vpnPoolMissCount = vpnPoolMissCount + 1
        return Err[bool]("vpn proxy tun: pool slot corrupt")
    vpnPoolTakeCount = vpnPoolTakeCount + 1
    var target: VpnProxyTarget
    target.host = link.targetHost
    target.port = link.targetPort
    let openT0: int64 = VpnProxyMonoNowMs()
    let openRes: Result[bool] = VpnProxyTcpTlsForwardOpenTargetTimeoutMs(hot, target, VpnProxyPoolOpenTimeoutMs)
    if IsErr(openRes):
        # 陈旧热连接: 快速失败(2.5s 上限), 关闭后回落冷拨; 槽已归还, 生产者补位。
        VpnProxyCloseTcpTlsForwardLink(hot)
        VpnProxyPoolMarker(strutil.Join(["POOL dead open_ms=", strings.Int64ToStr(VpnProxyMonoNowMs() - openT0)], ""))
        return Err[bool]("vpn proxy tun: pooled link open failed")
    link.transportKind = VpnProxyTunTcpTransportTcpTls
    link.tcpTlsLink = hot
    link.tcpTlsPendingRead = BytesAlloc(0)
    link.remoteOpen = true
    # 元素 copy-back 不持久化(aarch64 实证): 与拨号路径同一 park 全局交接,
    # 调用方 payload 分支的 post-restore 块负责落回元素槽。
    vpnTunOpenTransportKind = link.transportKind
    vpnTunOpenTcpTlsLink = link.tcpTlsLink
    # [pool-handoff-fix] seq 标量 park: hot 是本地 var(读安全), OPEN 已让
    # send seq=2/recv seq=1。post-restore 改读标量, 免嵌套投影读失真。
    vpnTunOpenSendSeq = hot.sendKeys.seq
    vpnTunOpenRecvSeq = hot.recvKeys.seq
    vpnTunOpenValid = 1
    vpnPoolTakeOkCount = vpnPoolTakeOkCount + 1
    VpnProxyPoolMarker(strutil.Join(["POOL hit open_ms=", strings.Int64ToStr(VpnProxyMonoNowMs() - openT0), " take=", strings.Int64ToStr(int64(vpnPoolTakeCount)), " ok=", strings.Int64ToStr(int64(vpnPoolTakeOkCount)), " miss=", strings.Int64ToStr(int64(vpnPoolMissCount))], ""))
    return Ok[bool](true)


# ===========================================================================
# [dial-job] N-A 拨号异步化: 前台冷拨(TCP connect + TLS13 + AUTH + OPEN)
# 整体搬出 TUN worker 主循环。worker 只做非阻塞提交/收获, 拨号在常驻
# dial 线程执行 —— 拨号坏窗(9-12s)期间数据面(mux drain / flush /
# keepalive / selfheal)连续泵, 消除单线程泵停摆断流主因。
# ORC 并发面(ORCU2 同款纪律, 全部走真机已证形状):
# - 请求字段: worker CloneStr 快照写入(vpnDialJobHost), 字段填妥后
#   atomic store(state 0→1)为发布围栏; dial 线程 CAS(1→2) 认领后才读。
# - 结果槽: dial 线程填 vpnDialJobLink 后 CAS(2→3) 发布, 发布即移交
#   所有权、此后零触碰; worker 收获认领(清槽)后本地拷贝独占 —— 池槽
#   vpnPoolLinkA/B 同款 CAS 所有权转移(M:PoolTakeAndOpen 先例)。
# - seq 走标量槽(vpnDialJobSendSeq/RecvSeq), 免嵌套投影读(布局彩票纪律)。
# - 单 in-flight: 槽单槽 = 同一时刻至多一个拨号, 与 TLS13 握手全局不可
#   重入([dial-serial])天然对齐; dial 线程拨号仍持 PoolDialLock(与池
#   maintainer 互斥)。陈旧结果(跨代迟到发布)由收获侧 wantSeq 对账弃装。
# 状态机: 0=idle 1=请求就绪 2=拨号中 3=成功待收 4=失败待收。
# ===========================================================================
var vpnDialJobState: int32
var vpnDialJobKind: int32
var vpnDialJobSeq: int32
var vpnDialJobOwnerKey: int64
var vpnDialJobPort: int32
var vpnDialJobHost: str
var vpnDialJobLink: VpnProxyTcpTlsForwardLink
var vpnDialJobSendSeq: int64
var vpnDialJobRecvSeq: int64
var vpnDialJobStartMs: int64
var vpnDialJobEndMs: int64
# 拨号线程侧诊断(ORCU 纪律: 线程侧禁止触碰共享 marker 全局
# vpnTunLastRelayError —— 双线程 CloneStr 释放/覆写竞态 = underflow 家族,
# 实测 20 进程 4 中)。ErrKind/ErrText 单写者=dial 线程, 发布围栏(state
# 2→3/4)前写定, worker 认领后 CloneStr 读 —— 同 Host 快照协议。
var vpnDialJobErrKind: int32
var vpnDialJobErrText: str
var vpnDialJobSubmitCount: int32
var vpnDialJobOkCount: int32
var vpnDialJobFailCount: int32

# 提交拨号作业(worker 主循环专用, 单写者)。槽被占(在途/待收)时拒绝返回
# false —— 调用方按 pending 处理。字段先填后发布(state 1 = 发布围栏);
# hostOwned 调用方 CloneStr 所有权移交, dial 线程读取走 CloneStr 快照。
fn VpnProxyDialJobSubmit(jobKind: int32, ownerKey: int64, hostOwned: str, port: int32): bool =
    if vpnDialJobState != 0:
        return false
    vpnDialJobKind = jobKind
    vpnDialJobOwnerKey = ownerKey
    vpnDialJobPort = port
    vpnDialJobHost = hostOwned
    vpnDialJobErrKind = 0
    vpnDialJobSeq = vpnDialJobSeq + 1
    vpnTunDialWantSeq = vpnDialJobSeq
    vpnTunDialWantKey = ownerKey
    vpnDialJobSubmitCount = vpnDialJobSubmitCount + 1
    vpnDialJobStartMs = VpnProxyMonoNowMs()
    VpnProxyAtomicStoreI32(&vpnDialJobState, 1)
    VpnProxyPoolMarker(strutil.Join(["DIALJOB submit kind=", strings.Int64ToStr(int64(jobKind)), " seq=", strings.Int64ToStr(int64(vpnDialJobSeq))], ""))
    return true

# 只读观察口(收获侧窗口计数与夹具判据用): 槽当前状态。
fn VpnProxyDialJobStateNow(): int32 =
    return vpnDialJobState

# 收获认领(仅 worker 线程): 有就绪结果(3/4)即清槽并返回结果码, 无则 0。
# 先清槽后消费字段是安全的: 下次覆写 vpnDialJobLink 必须先有新提交
# (state 0→1), 而提交者正是本线程 —— 认领与消费同 tick 内完成。
fn VpnProxyDialJobPollClaim(): int32 =
    let st: int32 = vpnDialJobState
    if st != 3 && st != 4:
        return 0
    VpnProxyAtomicStoreI32(&vpnDialJobState, 0)
    return st

# 收获读数(纯标量): claimed 0/3/4; stale=seq 对账不符(已弃装);
# muxInstalled=成功且已装共享隧道; elapsedMs=拨号窗耗时。
# 前台链接的元素装回留主函数体内(元素 copy-back 纪律: callee 写
# var 数组元素在 aarch64 不持久)。
type
    VpnProxyDialJobHarvest =
        claimed: int32
        stale: bool
        muxInstalled: bool
        elapsedMs: int64

# 收获执行体(仅全局读写, 不触 tcpLinks): 成功且 kind=2 时就地装
# vpnMuxLink(原 MuxEnsureTunnel 装配段); 前台成功只交读数, 装回由
# 主函数体按 wantKey 完成。[seed-gate] 出参填充形(var out + T() 弃用,
# cheng_seed 门禁拒结构体 T() 显式默认初始化)。
fn VpnProxyDialJobHarvestInto(out: var VpnProxyDialJobHarvest) =
    let djState: int32 = VpnProxyDialJobPollClaim()
    out.claimed = djState
    out.elapsedMs = VpnProxyMonoNowMs() - vpnDialJobStartMs
    if djState == 0:
        return
    if vpnDialJobSeq != vpnTunDialWantSeq:
        # 跨代陈旧结果: 弃装(关链接), 槽已在认领时归零。
        VpnProxyCloseTcpTlsForwardLink(vpnDialJobLink)
        VpnProxyPoolMarker(strutil.Join(["DIALJOB stale seq=", strings.Int64ToStr(int64(vpnDialJobSeq))], ""))
        out.stale = true
        return
    if djState == 3 && vpnDialJobKind == 2:
        # [mux] 隧道安装(原 MuxEnsureTunnel 装配段: vpnMuxLink 由 worker
        # 单线程写; seq 走标量镜像, 免嵌套投影读)。
        vpnMuxLink = vpnDialJobLink
        vpnMuxSendSeq = vpnDialJobSendSeq
        vpnMuxRecvSeq = vpnDialJobRecvSeq
        vpnMuxNextStreamId = 1
        vpnMuxActive = 0
        if BytesLen(vpnMuxRecvPending) > 0:
            BytesFree(vpnMuxRecvPending)
        vpnMuxRecvPending = BytesAlloc(0)
        if BytesLen(vpnMuxStashRaw) > 0:
            BytesFree(vpnMuxStashRaw)
        vpnMuxStashRaw = BytesAlloc(0)
        vpnMuxState = 2
        vpnMuxLastActivityMs = VpnProxyMonoNowMs()
        # [carrier-rotate] 新载体服役计量归零。
        vpnMuxBornMs = VpnProxyMonoNowMs()
        vpnMuxServedBytes = 0
        vpnMuxRetirePending = false
        vpnDialJobOkCount = vpnDialJobOkCount + 1
        out.muxInstalled = true

# 拨号执行体(旧 FillSlot 已证形状): states/identity 直接以会话交接全局
# 为 var 实参(全局即精确所有者, 过审计); 全局读窗用 vpnPoolFillingCount
# 屏障罩住 —— SessionStart 换代覆写交接全局前必等屏障清零, 读窗内免竞。
# 屏障只罩克隆段(读全局窗), 拨号本体在屏障外(不拖慢换代收尾)。
# 返回 dial 是否成功; 成品已发布进结果槽(所有权移交, 返回后零触碰)。
fn VpnProxyDialJobRunDial(jobKind: int32,
                          myStates: var VpnProxyExitState[],
                          myIdentity: var VpnProxyLoadedIdentity): bool =
    VpnProxyPoolFillingEnter()
    var localStates: VpnProxyExitState[]
    var stIdx: int32
    while stIdx < myStates.len:
        add(localStates, VpnProxyCloneExitState(myStates[stIdx]))
        stIdx = stIdx + 1
    var ident: VpnProxyLoadedIdentity = VpnProxyCloneLoadedIdentityForCall(myIdentity)
    VpnProxyPoolFillingExit()
    var dialOk: bool
    var exitIdx: int32 = VpnProxyBestHealthyExitForTransport(localStates, "tcp-tls-forward", -1)
    if exitIdx < 0:
        exitIdx = 0
    var target: VpnProxyTarget
    target.host = strings.CloneStr(vpnDialJobHost)
    target.port = vpnDialJobPort
    # [dial-serial] TLS13 握手全局不可重入: 与池 fill 互斥(前台冷拨已出
    # 主循环, 本锁现为 dial 线程 vs maintainer 的互斥点)。
    VpnProxyPoolDialLock()
    var dialRes: Result[VpnProxyTcpTlsForwardLink]
    if jobKind == 2:
        dialRes = VpnProxyTcpTlsForwardDialSelected(localStates, ident, exitIdx)
    else:
        dialRes = VpnProxyOpenRemoteTcpTlsFromIndex(localStates, ident, target, exitIdx)
    VpnProxyPoolDialUnlock()
    if IsOk(dialRes):
        var djHot: VpnProxyTcpTlsForwardLink = Value(dialRes)
        djHot.exitIndex = exitIdx
        if jobKind == 2:
            let nbRes: Result[bool] = tcp.TcpSetNonblocking(djHot.conn, true)
            if IsErr(nbRes):
                VpnProxyCloseTcpTlsForwardLink(djHot)
                vpnDialJobErrKind = 1
                vpnDialJobErrText = strings.CloneStr(ErrorText(nbRes))
            else:
                dialOk = true
        else:
            dialOk = true
        if dialOk:
            # seq 先读进标量镜像(读的是本地 var, 安全), 再发布移交。
            let djSend: int64 = djHot.sendKeys.seq
            let djRecv: int64 = djHot.recvKeys.seq
            vpnDialJobSendSeq = djSend
            vpnDialJobRecvSeq = djRecv
            vpnDialJobLink = djHot
    else:
        # 线程侧零共享 marker: 失败文本进单写者槽, 发布后由 worker 收获
        # 侧落共享 marker(修 ORCU 实测 underflow 面)。
        vpnDialJobErrKind = 2
        vpnDialJobErrText = strings.CloneStr(ErrorText(dialRes))
    return dialOk

# 拨号线程主体(maintainer 同款形状): 代际退出 + CAS 认领。换代时本线程
# 只在空闲循环顶退出; 在途作业由任一代线程完成发布(结果由收获侧 wantSeq
# 对账, 陈旧即弃), 故无卡槽态。
fn VpnProxyDialJobThreadMain(raw: ptr) =
    if raw == nil:
        return
    let myGen: int32 = int32(uint64(raw))
    while true:
        if vpnPoolGeneration != myGen:
            return
        if VpnProxyTunStopRequested:
            return
        if VpnProxyAtomicCasI32(&vpnDialJobState, 1, 2) == 1:
            let jobKind: int32 = vpnDialJobKind
            let dialOk: bool = VpnProxyDialJobRunDial(jobKind, vpnPoolHandoffStates, vpnPoolHandoffIdentity)
            if dialOk:
                if VpnProxyAtomicCasI32(&vpnDialJobState, 2, 3) != 1:
                    # 不可达(认领者唯一, 无他人写 state 2); 防御性留痕。
                    vpnDialJobErrKind = 3
                    vpnDialJobErrText = strings.CloneStr("publish clash")
            else:
                let _ = VpnProxyAtomicCasI32(&vpnDialJobState, 2, 4)
                vpnDialJobFailCount = vpnDialJobFailCount + 1
            vpnDialJobEndMs = VpnProxyMonoNowMs()
        else:
            os.SleepMs(VpnProxyDialJobPollMs)


# ===========================================================================
# [mux] 客户端多流复用端点: 一条 TCP-TLS 隧道(vpnMuxLink)承载多个 TUN TCP
# 流。新流 = OPEN(递增 streamId) + 等 OpenOk; 下行 = 泵统一 drain 隧道按
# streamId 直写 TUN; 上行 = 按流 streamId 发 DATA 帧。空闲 15s 发 PROBE 保
# 活(服务端中途 PROBE 回 ProbeOk)。任何 mux 失败 → 回退既有 pool/冷拨路径
# (向后兼容: 服务端同样兼容旧单流客户端)。
# 形状纪律(aarch64 三禁忌): 帧读写经 vpnMuxSendSeq/vpnMuxRecvSeq 标量真身
# 镜像(元素/嵌套投影不跨调用持久); 元素操作收敛小助手; 借用字段不作
# byval 实参直传(先拷局部)。
# ===========================================================================
var vpnMuxLink: VpnProxyTcpTlsForwardLink
var vpnMuxState: int32
var vpnMuxNextStreamId: int32
var vpnMuxActive: int32
var vpnMuxSendSeq: int64
var vpnMuxRecvSeq: int64
var vpnMuxRecvPending: Bytes
var vpnMuxLastActivityMs: int64
# [carrier-rotate] 载体服役计量: born=安装时刻, served=收发字节累计,
# retirePending=已标记退役(新流避让回落池, 流排空后拆旧换新)。
var vpnMuxBornMs: int64
var vpnMuxServedBytes: int64
var vpnMuxRetirePending: bool
var vpnMuxOpensOk: int32
var vpnMuxOpensFail: int32
var vpnMuxOpenTimeoutStreak: int32
# OPEN 等待期收到他人流的帧暂存(单泵线程, 泵 tick 内路由)。
# 平面缓冲: [u32 sid][u32 kind][u32 len][data] 重复; 避开元素拷贝审计。
var vpnMuxStashRaw: Bytes
# EnsureRemoteOpen → 泵 payload 分支的 mux streamId 交接(元素标量写回纪律)。
var vpnTunOpenMuxValid: int32
var vpnTunOpenMuxStreamId: int32

fn VpnProxyMuxTeardown() =
    if vpnMuxLink.open:
        VpnProxyCloseTcpTlsForwardLink(vpnMuxLink)
    vpnMuxLink.open = false
    vpnMuxState = 0
    vpnMuxActive = 0
    vpnMuxRecvSeq = 0
    vpnMuxSendSeq = 0
    vpnMuxRetirePending = false
    if BytesLen(vpnMuxRecvPending) > 0:
        BytesFree(vpnMuxRecvPending)
    vpnMuxRecvPending = BytesAlloc(0)
    VpnProxyPoolMarker("MUX teardown")

# 会话级复位: 关隧道 + 清暂存(换代/停机时调用)。
fn VpnProxyMuxSessionReset() =
    VpnProxyMuxTeardown()
    if BytesLen(vpnMuxStashRaw) > 0:
        BytesFree(vpnMuxStashRaw)
    vpnMuxStashRaw = BytesAlloc(0)

# 拨一条 mux 隧道(TCP+TLS+AUTH 完成)。与前台冷拨/池 fill 互斥(TLS13 全局)。
# [mux-off-diag] 已归因完毕(mux 与池路径吞吐同级, 均受服务器 target 供数
# 节律限制), 恢复 mux 优先(OPEN 1RTT 时延优)。
var vpnMuxDisabledDiag: bool

fn VpnProxyMuxEnsureTunnel(states: var VpnProxyExitState[],
                           identity: var VpnProxyLoadedIdentity): Result[bool] =
    if vpnMuxDisabledDiag:
        return Err[bool]("vpn proxy mux: disabled (diag)")
    if vpnMuxState == 2:
        return Ok[bool](true)
    if states.len <= 0:
        return Err[bool]("vpn proxy mux: no exits")
    # [dial-job] N-A: mux 冷拨出主循环: 提交 kind=2 作业(exit 由拨号线程
    # 从会话交接快照解析, 非 blocking 版本拨完即置 nonblocking), 完成由
    # 主循环 DIALJOB 收获装 vpnMuxLink。本函数只剩"就绪与否"判定, 调用方
    # 按 Err 回落池取/前台拨号提交 —— 单槽仲裁: 谁先占槽谁先拨, 数据面
    # 零阻塞。
    if !VpnProxyDialJobSubmit(2, 0, "", 0):
        return Err[bool]("vpn proxy mux: dial job busy")
    return Err[bool]("vpn proxy mux: dial job enqueued")

# 全局链路原始帧写: seq 标量真身进/出(经 link 接口字段同函数往返)。
fn VpnProxyMuxWriteFrameRaw(wire: Bytes): Result[bool] =
    vpnMuxLink.sendKeys.seq = vpnMuxSendSeq
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(vpnMuxLink, wire)
    vpnMuxSendSeq = vpnMuxLink.sendKeys.seq
    vpnMuxLastActivityMs = VpnProxyMonoNowMs()
    # [carrier-rotate] 上行计入服役字节。
    vpnMuxServedBytes = vpnMuxServedBytes + int64(BytesLen(wire))
    return writeRes

# 按流 streamId 分块发 DATA。
fn VpnProxyMuxWriteStreamData(streamId: int32, payload: Bytes): Result[bool] =
    if vpnMuxState != 2:
        return Err[bool]("vpn proxy mux: tunnel absent")
    let limit: int32 = VpnProxyTcpTlsForwardDataPayloadLimit()
    if limit <= 0:
        return Err[bool]("vpn proxy mux: payload limit invalid")
    var payloadTotal: int32 = BytesLen(payload)
    var offset: int32
    while offset < payloadTotal:
        var take: int32 = payloadTotal - offset
        if take > limit:
            take = limit
        var chunk: Bytes = BytesAlloc(take)
        var cpIdx: int32
        while cpIdx < take:
            BytesSet(chunk, cpIdx, BytesGet(payload, offset + cpIdx) & 255)
            cpIdx = cpIdx + 1
        var wire: Bytes
        let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildDataFrameInto(streamId, chunk, wire)
        BytesFree(chunk)
        if buildRes <= 0:
            return Err[bool]("vpn proxy mux: data frame build failed")
        let writeRes: Result[bool] = VpnProxyMuxWriteFrameRaw(wire)
        BytesFree(wire)
        if IsErr(writeRes):
            return Err[bool](ErrorText(writeRes))
        offset = offset + take
    return Ok[bool](true)

fn VpnProxyMuxSendStreamClose(streamId: int32): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildCloseFrameInto(streamId, wire)
    if buildRes <= 0:
        return Err[bool]("vpn proxy mux: close frame build failed")
    let writeRes: Result[bool] = VpnProxyMuxWriteFrameRaw(wire)
    BytesFree(wire)
    return writeRes

fn VpnProxyMuxSendProbe(): Result[bool] =
    var probeFrame: Bytes
    let built: int32 = ttf.VpnProxyTcpTlsForwardBuildProbeFrameInto(probeFrame)
    if built <= 0:
        return Err[bool]("vpn proxy mux: probe build failed")
    let writeRes: Result[bool] = VpnProxyMuxWriteFrameRaw(probeFrame)
    BytesFree(probeFrame)
    return writeRes

# 非阻塞读一帧(下/上行共用): pending 与 keys 经局部往返全局, StashPop 同款
# var 出参形状。返回: 0=暂无完整帧 1=有帧(payload 所有权交调用方) 2=隧道死亡。
fn VpnProxyMuxReadFrameTo(outType: var int32,
                          outStreamId: var int32,
                          outPayload: var Bytes): int32 =
    # 全路径显式定义: 精确身份槽不允许哨兵(早退路径也留权威定义)。
    outPayload = BytesAlloc(0)
    # 生产 FlushRemote 同形状: link 级 TryReadFrameNonblocking 直用全局链路,
    # pending 局部往返; seq 经标量镜像(嵌套字段仅同函数内往返)。
    var pendLocal: Bytes = BytesAlloc(0)
    pendLocal = vpnMuxRecvPending
    var frameLocal: ttf.VpnProxyTcpTlsForwardFrame
    let frameRes: Result[bool] = VpnProxyTcpTlsTryReadFrameNonblocking(vpnMuxLink, pendLocal, frameLocal)
    vpnMuxRecvPending = pendLocal
    if IsErr(frameRes):
        return 2
    if !Value(frameRes):
        return 0
    outType = frameLocal.frameType
    outStreamId = frameLocal.streamId
    return 1

# mux 流 → links 元素下标。
@borrows
fn VpnProxyMuxLinkIndexForStream(links: VpnProxyTunTcpLink[], streamId: int32): int32 =
    for i in 0..<links.len:
        if links[i].open && links[i].muxStreamId == streamId:
            return i
    return -1

# 单个 DATA 项路由: 直写 TUN(借用 lastPacket 局部暂存)。
@borrows
fn VpnProxyMuxRouteProbeLinks(links: var VpnProxyTunTcpLink[], streamId: int32): bool =
    let idx: int32 = VpnProxyMuxLinkIndexForStream(links, streamId)
    return idx >= 0

fn VpnProxyMuxRouteProbeRuntime(runtime: var tun.VpnTunRuntime): bool =
    return runtime.fakeDnsCount >= 0

fn VpnProxyMuxRouteProbe4(runtime: var tun.VpnTunRuntime,
                          fd: int32,
                          frameMode: int32,
                          links: var VpnProxyTunTcpLink[]): bool =
    let idx: int32 = VpnProxyMuxLinkIndexForStream(links, 1)
    return runtime.fakeDnsCount >= 0 && fd >= 0 && frameMode >= 0 && idx >= -2

fn VpnProxyMuxRouteProbe6a(runtime: var tun.VpnTunRuntime,
                           fd: int32,
                           frameMode: int32,
                           links: var VpnProxyTunTcpLink[],
                           streamId: int32,
                           payload: Bytes): bool =
    let idx: int32 = VpnProxyMuxLinkIndexForStream(links, streamId)
    let n: int32 = BytesLen(payload)
    return runtime.fakeDnsCount >= 0 && fd >= 0 && frameMode >= 0 && idx >= -2 && n >= 0

fn VpnProxyMuxRouteDataToTun(runtime: var tun.VpnTunRuntime,
                             fd: int32,
                             frameMode: int32,
                             links: var VpnProxyTunTcpLink[],
                             streamId: int32,
                             payload: Bytes): bool =
    let idx: int32 = VpnProxyMuxLinkIndexForStream(links, streamId)
    if idx < 0:
        return true
    var lastPacketLocal: Bytes = links[idx].lastPacket
    let reply: Bytes = tun.VpnTunBuildTcpPayload(runtime, lastPacketLocal, payload)
    if BytesLen(reply) <= 0:
        return true
    if !tun.VpnTunWritePacketFrameMode(fd, frameMode, reply):
        links[idx].open = false
        links[idx].remoteOpen = false
        return false
    vpnTunFastPoll = true
    return true

# 标记某 mux 流关闭(FIN 回 TUN); 活跃计数与移除统一由 sweep/LinkRemove 收敛。
fn VpnProxyMuxMarkLinkClosedByStream(runtime: var tun.VpnTunRuntime,
                                     links: var VpnProxyTunTcpLink[],
                                     fd: int32,
                                     frameMode: int32,
                                     streamId: int32) =
    let idx: int32 = VpnProxyMuxLinkIndexForStream(links, streamId)
    if idx >= 0:
        var lastPacketLocal: Bytes = links[idx].lastPacket
        let fin: Bytes = tun.VpnTunBuildTcpFin(runtime, lastPacketLocal)
        if BytesLen(fin) > 0:
            let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, fin)
        links[idx].open = false
        links[idx].remoteOpen = false

# 隧道死亡: RST 所有 mux 流 + 拆隧道。
fn VpnProxyMuxAbortAll(fd: int32,
                       frameMode: int32,
                       links: var VpnProxyTunTcpLink[]) =
    VpnProxyPoolMarker("MUX tunnel dead")
    for i in 0..<links.len:
        if links[i].open && links[i].muxStreamId > 0:
            let rst: Bytes = tun.VpnTunBuildTcpRst(links[i].lastPacket)
            if BytesLen(rst) > 0:
                let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, rst)
            links[i].open = false
            links[i].remoteOpen = false
    vpnMuxActive = 0
    VpnProxyMuxTeardown()

# OPEN 一个新流: 发 OPEN(递增 id) + 等 OpenOk, 途中他人帧入暂存。
fn VpnProxyMuxOpenStream(targetHost: str,
                         targetPort: int32): Result[int32] =
    if vpnMuxState != 2:
        return Err[int32]("vpn proxy mux: tunnel absent")
    if vpnMuxActive >= 32:
        return Err[int32]("vpn proxy mux: stream limit")
    var target: VpnProxyTarget
    target.host = strings.CloneStr(targetHost)
    target.port = targetPort
    let addrText: str = VpnProxyTargetAddress(target)
    let addrProbeRes: Result[listen.VpnProxyListenAddress] = listen.VpnProxyParseListenAddress(strings.CloneStr(addrText))
    if IsErr(addrProbeRes):
        return Err[int32]("vpn proxy mux: address unparsable")
    let streamId: int32 = vpnMuxNextStreamId
    vpnMuxNextStreamId = streamId + 1
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenFrameInto(streamId, addrText, wire)
    if buildRes <= 0:
        return Err[int32]("vpn proxy mux: open frame build failed")
    let writeRes: Result[bool] = VpnProxyMuxWriteFrameRaw(wire)
    BytesFree(wire)
    if IsErr(writeRes):
        vpnMuxOpensFail = vpnMuxOpensFail + 1
        VpnProxyMuxTeardown()
        return Err[int32]("vpn proxy mux: open write failed")
    let deadlineMs: int64 = VpnProxyMonoNowMs() + int64(VpnProxyPoolOpenTimeoutMs)
    while VpnProxyMonoNowMs() < deadlineMs:
        var readType: int32
        var readSid: int32
        var readPayload: Bytes = BytesAlloc(0)
        let readCode: int32 = VpnProxyMuxReadFrameTo(readType, readSid, readPayload)
        if readCode == 2:
            BytesFree(readPayload)
            vpnMuxOpensFail = vpnMuxOpensFail + 1
            return Err[int32]("vpn proxy mux: tunnel dead during open")
        if readCode == 1:
            vpnMuxLastActivityMs = VpnProxyMonoNowMs()
            if readType == ttf.VpnProxyTcpTlsForwardFrameKindOpenOk() && readSid == streamId:
                BytesFree(readPayload)
                vpnMuxOpenTimeoutStreak = 0
                vpnMuxActive = vpnMuxActive + 1
                vpnMuxOpensOk = vpnMuxOpensOk + 1
                VpnProxyPoolMarker(strutil.Join(["MUX open ok sid=", strings.Int64ToStr(int64(streamId)), " active=", strings.Int64ToStr(int64(vpnMuxActive)), " ok=", strings.Int64ToStr(int64(vpnMuxOpensOk))], ""))
                return Ok[int32](streamId)
            if readType == ttf.VpnProxyTcpTlsForwardFrameKindOpenError() && readSid == streamId:
                let errText: str = rawbytes.BytesToString(readPayload)
                BytesFree(readPayload)
                vpnMuxOpensFail = vpnMuxOpensFail + 1
                return Err[int32](strings.CloneStr(errText))
            if readType == ttf.VpnProxyTcpTlsForwardFrameKindData() || readType == ttf.VpnProxyTcpTlsForwardFrameKindClose():
                var stashKind: int32 = 2
                if readType == ttf.VpnProxyTcpTlsForwardFrameKindData():
                    stashKind = 1
                VpnProxyMuxStashPush(readSid, stashKind, readPayload)
            BytesFree(readPayload)
        os.SleepMs(1)
    vpnMuxOpensFail = vpnMuxOpensFail + 1
    vpnMuxOpenTimeoutStreak = vpnMuxOpenTimeoutStreak + 1
    if vpnMuxOpenTimeoutStreak >= 2:
        # 连续超时 = 隧道静默死亡(NAT 丢弃): 拆掉让下个流重拨自愈。
        # 单次超时不拆: 服务端可能只是忙于其他流的阻塞拨号。
        VpnProxyMuxTeardown()
    return Err[int32]("vpn proxy mux: open timeout")

# [mux] 暂存压入: [u32 sid][u32 kind][u32 len][data] 追加到平面缓冲。
fn VpnProxyMuxStashPush(streamId: int32, kind: int32, payload: Bytes) =
    let payloadLen: int32 = BytesLen(payload)
    var rec: Bytes = BytesAlloc(12 + payloadLen)
    BytesSet(rec, 0, (streamId >> 24) & 255)
    BytesSet(rec, 1, (streamId >> 16) & 255)
    BytesSet(rec, 2, (streamId >> 8) & 255)
    BytesSet(rec, 3, streamId & 255)
    BytesSet(rec, 4, (kind >> 24) & 255)
    BytesSet(rec, 5, (kind >> 16) & 255)
    BytesSet(rec, 6, (kind >> 8) & 255)
    BytesSet(rec, 7, kind & 255)
    BytesSet(rec, 8, (payloadLen >> 24) & 255)
    BytesSet(rec, 9, (payloadLen >> 16) & 255)
    BytesSet(rec, 10, (payloadLen >> 8) & 255)
    BytesSet(rec, 11, payloadLen & 255)
    var cpIdx: int32
    while cpIdx < payloadLen:
        BytesSet(rec, 12 + cpIdx, BytesGet(payload, cpIdx) & 255)
        cpIdx = cpIdx + 1
    vpnMuxStashRaw = VpnProxyRelayJoinPending(vpnMuxStashRaw.data, vpnMuxStashRaw.len, rec, 12 + payloadLen)
    BytesFree(rec)

# [mux] 暂存弹出: 从头取一条; 无返回 false。outPayload 所有权交调用方。
fn VpnProxyMuxStashPop(outStreamId: var int32,
                       outKind: var int32,
                       outPayload: var Bytes): bool =
    let total: int32 = BytesLen(vpnMuxStashRaw)
    if total < 12:
        return false
    var sid: int32
    var kind: int32
    var plen: int32
    var bIdx: int32
    while bIdx < 4:
        sid = (sid << 8) | (BytesGet(vpnMuxStashRaw, bIdx) & 255)
        kind = (kind << 8) | (BytesGet(vpnMuxStashRaw, 4 + bIdx) & 255)
        plen = (plen << 8) | (BytesGet(vpnMuxStashRaw, 8 + bIdx) & 255)
        bIdx = bIdx + 1
    if plen < 0 || 12 + plen > total:
        # 腐烂记录: 整段弃置。
        BytesFree(vpnMuxStashRaw)
        vpnMuxStashRaw = BytesAlloc(0)
        return false
    var payload: Bytes = BytesAlloc(plen)
    var cpIdx: int32
    while cpIdx < plen:
        BytesSet(payload, cpIdx, BytesGet(vpnMuxStashRaw, 12 + cpIdx) & 255)
        cpIdx = cpIdx + 1
    var remain: int32 = total - (12 + plen)
    var rest: Bytes = BytesAlloc(0)
    if remain > 0:
        rest = BytesAlloc(remain)
        var cpRest: int32
        while cpRest < remain:
            BytesSet(rest, cpRest, BytesGet(vpnMuxStashRaw, 12 + plen + cpRest) & 255)
            cpRest = cpRest + 1
    BytesFree(vpnMuxStashRaw)
    vpnMuxStashRaw = rest
    outStreamId = sid
    outKind = kind
    outPayload = payload
    return true

# 泵 tick: 暂存路由 + 隧道非阻塞 drain 按流直写 TUN。隧道死亡 → 全 RST。
fn VpnProxyMuxDrainStash(runtime: var tun.VpnTunRuntime,
                         fd: int32,
                         frameMode: int32,
                         links: var VpnProxyTunTcpLink[]): bool =
    # 返回 true = 隧道死亡需 AbortAll。
    var dead: bool
    while !dead:
        var stashSid: int32
        var stashKind: int32
        var stashPayload: Bytes = BytesAlloc(0)
        let popped: bool = VpnProxyMuxStashPop(stashSid, stashKind, stashPayload)
        if !popped:
            BytesFree(stashPayload)
            break
        if stashKind == 1:
            let routeOk: bool = VpnProxyMuxRouteDataToTun(runtime, fd, frameMode, links, stashSid, stashPayload)
            if !routeOk:
                dead = true
        else:
            VpnProxyMuxMarkLinkClosedByStream(runtime, links, fd, frameMode, stashSid)
        BytesFree(stashPayload)
    return dead

fn VpnProxyMuxDrainFrames(runtime: var tun.VpnTunRuntime,
                          fd: int32,
                          frameMode: int32,
                          links: var VpnProxyTunTcpLink[]): bool =
    var dead: bool
    while !dead:
        var readType: int32
        var readSid: int32
        var readPayload: Bytes = BytesAlloc(0)
        let readCode: int32 = VpnProxyMuxReadFrameTo(readType, readSid, readPayload)
        if readCode == 2:
            BytesFree(readPayload)
            dead = true
            break
        if readCode == 0:
            BytesFree(readPayload)
            break
        if readCode == 1:
            vpnMuxLastActivityMs = VpnProxyMonoNowMs()
            # [carrier-rotate] 下行计入服役字节(帧头 16B + payload)。
            vpnMuxServedBytes = vpnMuxServedBytes + int64(BytesLen(readPayload)) + int64(16)
        if readType == ttf.VpnProxyTcpTlsForwardFrameKindData():
            let routeOk: bool = VpnProxyMuxRouteDataToTun(runtime, fd, frameMode, links, readSid, readPayload)
            if !routeOk:
                BytesFree(readPayload)
                dead = true
                break
        elif readType == ttf.VpnProxyTcpTlsForwardFrameKindClose():
            VpnProxyMuxMarkLinkClosedByStream(runtime, links, fd, frameMode, readSid)
            BytesFree(readPayload)
        else:
            BytesFree(readPayload)
    return dead

fn VpnProxyMuxDrain(runtime: var tun.VpnTunRuntime,
                    fd: int32,
                    frameMode: int32,
                    links: var VpnProxyTunTcpLink[]): Result[bool] =
    # 先清扫已死 mux 流(隧道已拆也要清, 防数组尸体累积)。
    var sweepIdx: int32 = links.len - 1
    while sweepIdx >= 0:
        if links[sweepIdx].muxStreamId > 0 && !links[sweepIdx].open:
            VpnProxyTunTcpLinkRemove(links, sweepIdx)
        sweepIdx = sweepIdx - 1
    if vpnMuxState != 2:
        return Ok[bool](true)
    let stashDead: bool = VpnProxyMuxDrainStash(runtime, fd, frameMode, links)
    var dead: bool = stashDead
    if !dead:
        dead = VpnProxyMuxDrainFrames(runtime, fd, frameMode, links)
    if dead:
        VpnProxyMuxAbortAll(fd, frameMode, links)
    return Ok[bool](true)

# 空闲保活: 无活跃流且 >15s 无隧道活动时发 PROBE(服务端回 ProbeOk)。
fn VpnProxyMuxKeepaliveMaybe(): Result[bool] =
    if vpnMuxState != 2:
        return Ok[bool](true)
    if vpnMuxActive > 0:
        return Ok[bool](true)
    if VpnProxyMonoNowMs() - vpnMuxLastActivityMs < int64(15000):
        return Ok[bool](true)
    VpnProxyPoolMarker("MUX keepalive probe")
    return VpnProxyMuxSendProbe()


@borrows
fn VpnProxyRunTunOnFd(states: var VpnProxyExitState[],
                       identity: var VpnProxyLoadedIdentity,
                       opts: var VpnProxyCliOptions,
                       fd: int32,
                       frameMode: int32,
                       tunName: str): Result[bool] =
    if fd < 0:
        return Err[bool]("vpn proxy tun: fd missing")
    VpnProxyTunRecordRelayError(strings.ConcatStr("RUNTFD len=", strings.Int64ToStr(states.len)))
    var runtime: tun.VpnTunRuntime
    tun.VpnTunInitRuntime(runtime)
    tun.VpnTunSetRouteMode(runtime, policy.VpnProxyTunRouteModeForText(opts.tunRouteModeText))
    var fakeDnsPersistPath: str
    var persistedFakeDnsCount: int32
    if len(opts.configPath) > 0:
        let markerParts: os.SplitFileResult = os.SplitFile(opts.configPath)
        if len(markerParts.dir) > 0:
            var markerPathParts: str[]
            add(markerPathParts, strings.CloneStr(markerParts.dir))
            add(markerPathParts, "/probe_marker.txt")
            vpnTunProbeMarkerPath = strutil.Join(markerPathParts, "")
    if opts.tunFakeDnsPersistKind > 0 && len(opts.configPath) > 0:
        let splitParts: os.SplitFileResult = os.SplitFile(opts.configPath)
        if len(splitParts.dir) > 0:
            var persistPathParts: str[]
            add(persistPathParts, strings.CloneStr(splitParts.dir))
            add(persistPathParts, "/fake_dns_domains.txt")
            fakeDnsPersistPath = strutil.Join(persistPathParts, "")
            let persistedText: str = chengpath.ReadTextFile("", strings.CloneStr(fakeDnsPersistPath))
            if len(persistedText) > 0:
                let _imported: int32 = tun.VpnTunFakeDnsImportDomains(runtime, strings.CloneStr(persistedText))
        persistedFakeDnsCount = runtime.fakeDnsCount
    var tcpLinks: VpnProxyTunTcpLink[]
    var udpFlows: VpnProxyTunUdpFlow[]
    var udpFrags: VpnProxyUdpFragState[]
    var udpSessions: VpnProxyUdpSessionTable
    var udpLink: VpnProxyQuicLink
    var udpLinkOpen: bool
    var udpPacketId: int32
    VpnProxyUdpSessionTableInit(udpSessions)
    # One owned identity clone for the whole tun session. The payload path
    # used to deep-copy certs+key+roots on EVERY TCP payload packet; under a
    # multi-stream storm (x.com cold start) that is hundreds of full identity
    # copies per second feeding the allocator - the exact regime where the ORC
    # suicide fired. All dial callees are @borrows, so one owned copy shared
    # across calls is sound.
    var tunIdentity: VpnProxyLoadedIdentity = VpnProxyCloneLoadedIdentityForCall(identity)
    # [pool] 会话启动: 换代+排空旧热连接+注册 identity 快照+拉起 maintainer
    # 预热线程(维持 2 条 TCP+TLS+AUTH 完成的热连接, 新流只差 OPEN)。
    VpnProxyPoolSessionStart(states, identity)
    var activeLine: str = "vpn-proxy tun active "
    activeLine = activeLine + strings.CloneStr(tunName)
    VpnProxyPrintLine(activeLine)
    if !VpnProxyWriteReadyPort(opts.readyPath, 0):
        return Err[bool]("vpn proxy: failed to write ready path")
    var handled: int32
    # Exit-dial health: consecutive failed EnsureRemoteOpen calls plus the span
    # since the first one. When dials keep failing past the threshold the
    # session is beyond in-place repair (stale bound network handle, dead
    # underlying, exit gone) — fail the dataplane so the supervised owner
    # re-establishes a fresh session instead of answering SYNs forever with
    # connections that never leave the device.
    var dialFailStreak: int32
    var dialFailFirstMs: int64
    var flushBranchLogs: int32
    # [self-heal] 下行 flight 停滞自愈

    # [throughput-fix] 时间驱动周期 flush: 原逻辑只在 TUN 无包时 flush 隧道,
    # 流式下行期间 app ACK 持续占满循环, 隧道读被饿死(实测 7KB/s)。
    var lastFlushMs: int64
    # [spin-wd] 单迭代 CPU 看门狗基线: 值=当前迭代开始时的线程 CPU 时间。
    var wdIterCpuStartNs: int64 = VpnProxyThreadCpuNs()
    var wdFired: int32
    # [spin-wd] 主循环迭代心跳: 每 1000 迭代一条 TUNITER(trace 门控内),
    # 纯用户态死旋现场可见 TUN 泵是否仍在推进及速率。
    var tunLoopIters: int64
    while opts.acceptCount <= 0 || handled < opts.acceptCount:
        if VpnProxyTunStopRequested:
            VpnProxyTunRecordRelayError("TUNEXIT stop_requested")
            VpnProxyTunTcpLinksClose(tcpLinks)
            if udpLinkOpen:
                VpnProxyCloseQuicLink(udpLink)
            tun.VpnTunStopRuntime(runtime)
            return Ok[bool](false)
        # [spin-wd] 上一迭代线程 CPU 时间 >500ms = 该迭代里有纯用户态长循环
        # (BytesLen 二读衰减/拷贝界腐烂家族)。无门控强制落盘。
        var wdCpuNowNs: int64 = VpnProxyThreadCpuNs()
        if wdCpuNowNs >= wdIterCpuStartNs:
            var wdIterNs: int64 = wdCpuNowNs - wdIterCpuStartNs
            if wdIterNs >= int64(500000000):
                var wdFlushLagMs: int64 = VpnProxyMonoNowMs() - lastFlushMs
                wdFired = wdFired + 1
                VpnProxyTunWatchdogRecord(strings.ConcatStr("WDTUN n=", strings.ConcatStr(strings.Int64ToStr(int64(wdFired)), strings.ConcatStr(" cpuMs=", strings.ConcatStr(strings.Int64ToStr(wdIterNs / int64(1000000)), strings.ConcatStr(" handled=", strings.ConcatStr(strings.Int64ToStr(int64(handled)), strings.ConcatStr(" links=", strings.ConcatStr(strings.Int64ToStr(int64(tcpLinks.len)), strings.ConcatStr(" fast=", strings.ConcatStr(strings.Int64ToStr(int64(int32(vpnTunFastPoll))), strings.ConcatStr(" flushLagMs=", strings.ConcatStr(strings.Int64ToStr(wdFlushLagMs), strings.ConcatStr(" dialFailStreak=", strings.Int64ToStr(int64(dialFailStreak))))))))))))))))
        wdIterCpuStartNs = wdCpuNowNs
        tunLoopIters = tunLoopIters + 1
        if tunLoopIters >= 1000:
            tunLoopIters = 0
            if vpnTunTraceEnabled:
                VpnProxyTunRecordRelayError(strutil.Join(["TUNITER handled=", strings.Int64ToStr(int64(handled)), " links=", strings.Int64ToStr(int64(tcpLinks.len))], ""))
        var nowMs: int64 = VpnProxyMonoNowMs()
        if nowMs - lastFlushMs >= 5:
            # [mux] 共享隧道 drain(下行路由) + 空闲保活, 每 tick 一次。
            let muxDrainRes0: Result[bool] = VpnProxyMuxDrain(runtime, fd, frameMode, tcpLinks)
            if IsErr(muxDrainRes0):
                VpnProxyTunRecordRelayError("MUXD0 " + ErrorText(muxDrainRes0))
            let _ = VpnProxyMuxKeepaliveMaybe()
            var flIdx0: int32
            while flIdx0 < tcpLinks.len:
                if !tcpLinks[flIdx0].open:
                    flIdx0 = flIdx0 + 1
                    continue
                var curRecv0: int64 = tcpLinks[flIdx0].tlsRecvSeq
                let flushRes0: Result[int64] = VpnProxyTunTcpFlushRemoteSeq(runtime, fd, frameMode, tcpLinks[flIdx0], curRecv0)
                if IsErr(flushRes0):
                    VpnProxyTunTcpLinkAbortIsolated(fd, frameMode, tcpLinks, flIdx0, "iso_periodic")
                    flIdx0 = flIdx0 + 1
                    continue
                tcpLinks[flIdx0].tlsRecvSeq = Value(flushRes0)
                flIdx0 = flIdx0 + 1
            lastFlushMs = nowMs
        var packet: Bytes
        # [perf] 自适应 poll: 刚排空过数据→1ms 快轮, 否则 10ms。
        # [self-heal] 已移除：SELFHEAL 15s 无下行即拆全部链接=误杀空闲会话
        # （trace 铁证：SELFHEAL→teardown→rebuild 循环=50% 流失败根因）。
        # 死隧道检测已由载体轮换+MuxAbortAll+DIALJOB fail 熔断覆盖。
        var hasOpenLinks: bool
        var shScan: int32
        while shScan < tcpLinks.len:
            if tcpLinks[shScan].open:
                hasOpenLinks = true
                shScan = tcpLinks.len
                continue
            shScan = shScan + 1
        # [carrier-rotate] mux 载体老化轮换检查(纯标量, 每 tick): 服役超
        # 4MB/90s 即标记退役——有活跃 mux 流: 新流经 EnsureRemoteOpen 避让
        # 回落池(池连接 ≤45s 自轮换), 本 tick 只置标记; 无活跃流: 直接拆旧,
        # 下个新流触发重拨(PSK resume ~600ms)。禁止中流杀流。
        if vpnMuxState == 2:
            var muxActiveNow: bool = false
            var crScan: int32
            while crScan < tcpLinks.len:
                if tcpLinks[crScan].open && tcpLinks[crScan].muxStreamId > 0:
                    muxActiveNow = true
                    crScan = tcpLinks.len
                    continue
                crScan = crScan + 1
            let rotateDue: bool = (nowMs - vpnMuxBornMs > VpnProxyMuxRotateAgeMs) || (vpnMuxServedBytes > VpnProxyMuxRotateBytes)
            if rotateDue || vpnMuxRetirePending:
                if muxActiveNow:
                    if !vpnMuxRetirePending:
                        vpnMuxRetirePending = true
                        VpnProxyPoolMarker(strutil.Join(["MUX rotate pending served=", strings.Int64ToStr(vpnMuxServedBytes), " age_ms=", strings.Int64ToStr(nowMs - vpnMuxBornMs)], ""))
                else:
                    VpnProxyMuxTeardown()
        # [dial-job] N-A: 拨号作业收获 —— 每 tick 先于 TUN 读执行(无包分支
        # 亦经过本段), 拨号坏窗内数据面活性判据读数 = DIALJOB 标记中的
        # winIters(窗口内主循环迭代数, >0 即泵未停)。收获主体在
        # DialJobHarvest(纯全局), 前台元素的装回留本函数体(元素 copy-back
        # 纪律)。
        if vpnDialJobState != 0:
            vpnDialWindowIters = vpnDialWindowIters + 1
            var dj: VpnProxyDialJobHarvest
            VpnProxyDialJobHarvestInto(dj)
            if dj.claimed == 3 && !dj.stale:
                if dj.muxInstalled:
                    VpnProxyPoolMarker(strutil.Join(["DIALJOB done kind=mux ms=", strings.Int64ToStr(dj.elapsedMs), " winIters=", strings.Int64ToStr(vpnDialWindowIters)], ""))
                    vpnDialWindowIters = 0
                else:
                    # 前台流装回: 按提交时 sessionKey 找发起流; 元素顶层字段
                    # 直写(主函数体内已证形状); seq 从收获标量镜像落元素顶层
                    # 标量(AUTH+OPEN 已耗 0/1, 应用数据从 2 起)。
                    var djFound: int32 = -1
                    var djScan: int32
                    while djScan < tcpLinks.len:
                        if tcpLinks[djScan].open && tcpLinks[djScan].sessionKey == vpnTunDialWantKey:
                            djFound = djScan
                            djScan = tcpLinks.len
                            continue
                        djScan = djScan + 1
                    if djFound < 0:
                        # 发起流已死(RST/超时): 成品链接直接关闭。
                        VpnProxyCloseTcpTlsForwardLink(vpnDialJobLink)
                        VpnProxyPoolMarker("DIALJOB owner gone")
                    else:
                        tcpLinks[djFound].transportKind = VpnProxyTunTcpTransportTcpTls
                        tcpLinks[djFound].tcpTlsLink = vpnDialJobLink
                        tcpLinks[djFound].tcpTlsPendingRead = BytesAlloc(0)
                        tcpLinks[djFound].remoteOpen = true
                        tcpLinks[djFound].tlsSendSeq = vpnDialJobSendSeq
                        tcpLinks[djFound].tlsRecvSeq = vpnDialJobRecvSeq
                        dialFailStreak = 0
                        dialFailFirstMs = 0
                        vpnDialJobOkCount = vpnDialJobOkCount + 1
                        VpnProxyPoolMarker(strutil.Join(["DIALJOB done kind=link ms=", strings.Int64ToStr(dj.elapsedMs), " winIters=", strings.Int64ToStr(vpnDialWindowIters), " host=", strings.CloneStr(tcpLinks[djFound].targetHost)], ""))
                    vpnDialWindowIters = 0
            elif dj.claimed == 4:
                # 失败收获: 槽已清。仅对账命中的结果计入失败 streak(与原
                # payload 分支 ENSURE_ERR 同阈值语义: 30 次/120s 熔断会话)。
                if dj.stale:
                    VpnProxyPoolMarker("DIALJOB stale fail")
                else:
                    dialFailStreak = dialFailStreak + 1
                    if dialFailFirstMs == 0:
                        dialFailFirstMs = VpnProxyMonoNowMs()
                    let djErr: str = strings.CloneStr(vpnDialJobErrText)
                    VpnProxyPoolMarker(strutil.Join(["DIALJOB fail streak=", strings.Int64ToStr(int64(dialFailStreak)), " ms=", strings.Int64ToStr(dj.elapsedMs), " winIters=", strings.Int64ToStr(vpnDialWindowIters), " errKind=", strings.Int64ToStr(int64(vpnDialJobErrKind)), " err=", djErr], ""))
                    if dialFailStreak >= 30 && VpnProxyMonoNowMs() - dialFailFirstMs >= int64(120000):
                        VpnProxyTunTcpLinksClose(tcpLinks)
                        if udpLinkOpen:
                            VpnProxyCloseQuicLink(udpLink)
                        tun.VpnTunStopRuntime(runtime)
                        VpnProxyTunRecordRelayError("TUNEXIT dialjob_persist")
                        return Err[bool]("vpn proxy tun: dial job failures persist, resetting session")
                vpnDialWindowIters = 0
        var tunPollMs: int32 = 10
        if vpnTunFastPoll:
            tunPollMs = 1
        if !tun.VpnTunReadPacketWithTimeout(fd, packet, tunPollMs):
            # [spin-fix] 快轮闩锁复位: fastPoll 一旦置位永不清零, worker 在
            # 会话空闲后仍以 1ms 轮询+全链路 flush 空转(实测空闲 14% CPU、
            # 轻载 66% CPU, 多 worker 被抢 starve → 吞吐崩塌)。本轮回合无包
            # =排空完毕, 回落 10ms 慢轮; 有数据时 3947 行再次拉起快轮。
            # [thruput-fix] 但活跃会话(mux 载波在/open links 在)期间禁回落:
            # 慢轮 10ms 是唯一 drain 节拍时, 每 16ms 才碰一次 carrier, 下行
            # 被节拍器压死(实测 19KB/s vs 直连 499KB/s)。空闲(无 links 无
            # mux)才真正回落。
            if !hasOpenLinks && vpnMuxState != 2:
                vpnTunFastPoll = false
            # [flush-hunt] 前 8 次打印链路表, 定位下行泵饿死原因。
            if flushBranchLogs < 8:
                flushBranchLogs = flushBranchLogs + 1
                var fh: int32
                var fhText: str = "FLUSHBRANCH n=" + strings.Int64ToStr(int64(tcpLinks.len))
                while fh < tcpLinks.len:
                    fhText = fhText + " [open=" + strings.Int64ToStr(int64(int32(tcpLinks[fh].open))) + " rOpen=" + strings.Int64ToStr(int64(int32(tcpLinks[fh].remoteOpen))) + "]"
                    fh = fh + 1
                VpnProxyTunRecordRelayError(fhText)
            # [mux] 无包分支同样 drain(空闲期下行主要入口)。
            let muxDrainRes1: Result[bool] = VpnProxyMuxDrain(runtime, fd, frameMode, tcpLinks)
            if IsErr(muxDrainRes1):
                VpnProxyTunRecordRelayError("MUXD1 " + ErrorText(muxDrainRes1))
            var flushIdx: int32
            while flushIdx < tcpLinks.len:
                if !tcpLinks[flushIdx].open:
                    flushIdx = flushIdx + 1
                    continue
                var curRecv1: int64 = tcpLinks[flushIdx].tlsRecvSeq
                let flushRes: Result[int64] = VpnProxyTunTcpFlushRemoteSeq(runtime, fd, frameMode, tcpLinks[flushIdx], curRecv1)
                if IsErr(flushRes):
                    # One dead transport aborts only its own session; the loop
                    # keeps serving every other link (burst recovery).
                    VpnProxyTunTcpLinkAbortIsolated(fd,
                                                    frameMode,
                                                    tcpLinks,
                                                    flushIdx,
                                                    "iso_tls_flush")
                    continue
                tcpLinks[flushIdx].tlsRecvSeq = Value(flushRes)
                flushIdx = flushIdx + 1
            if udpLinkOpen:
                let udpFlushRes: Result[bool] = VpnProxyTunUdpFlushRemote(fd, frameMode, udpLink, udpFlows, udpFrags)
                if IsErr(udpFlushRes):
                    VpnProxyTunTcpLinksClose(tcpLinks)
                    VpnProxyCloseQuicLink(udpLink)
                    return Err[bool](ErrorText(udpFlushRes))
            let pumpRes: Result[bool] = tun.VpnTunPumpDirectResolves(runtime, fd, frameMode)
            if IsErr(pumpRes):
                VpnProxyTunRecordRelayError("TUNEXIT pump_res " + ErrorText(pumpRes))
                VpnProxyTunTcpLinksClose(tcpLinks)
                if udpLinkOpen:
                    VpnProxyCloseQuicLink(udpLink)
                return Err[bool](ErrorText(pumpRes))
            continue
        let dnsReply: Bytes = tun.VpnTunMaybeBuildDnsResponse(runtime, packet)
        let dnsDiag: str = tun.VpnTunDnsDiagText()
        if len(dnsDiag) > 0:
            VpnProxyTunRecordRelayError(dnsDiag)
            # The diag is a sticky global; without this clear it would be
            # re-recorded on every loop iteration and bury newer markers.
            tun.VpnTunSetDnsDiag("")
        if BytesLen(dnsReply) > 0:
            if len(fakeDnsPersistPath) > 0 && runtime.fakeDnsCount != persistedFakeDnsCount:
                persistedFakeDnsCount = runtime.fakeDnsCount
                let _exported: str = tun.VpnTunFakeDnsExportDomains(runtime)
                let _wrote: bool = chengpath.WriteTextFile("", strings.CloneStr(fakeDnsPersistPath), strings.CloneStr(_exported))
            if !tun.VpnTunWritePacketFrameMode(fd, frameMode, dnsReply):
                VpnProxyTunTcpLinksClose(tcpLinks)
                if udpLinkOpen:
                    VpnProxyCloseQuicLink(udpLink)
                VpnProxyTunRecordRelayError("TUNEXIT dns_write")
                return Err[bool]("vpn proxy tun: dns write failed")
            handled = handled + 1
            continue
        if tun.VpnTunPacketIsFakeDnsQuery(packet):
            handled = handled + 1
            continue
        var decision: tun.VpnTunPacketDecision
        let _ok: bool = tun.VpnTunDecidePacket(runtime, packet, "", decision)
        # [dec-hunt] 每包决策标记(限频: 仅 SYN/Open 与非常规 action 全打)。
        if decision.action == tun.VpnTunPacketTcpOpen:
            VpnProxyTunRecordRelayError("DEC open")
        elif decision.action == tun.VpnTunPacketDrop:
            VpnProxyTunRecordRelayError("DEC drop")
            # [rst-fix] 已关 session 的 TCP 迟到包回 RST(仅 fake-IP 目标,
            # 本代理签发): 让浏览器立即弃连重连, 不再指数退避傻等。
            let dropProto: int32 = BytesGet(packet, 9) & 255
            if dropProto == 6:
                let dstB0: int32 = BytesGet(packet, 16) & 255
                let dstB1: int32 = BytesGet(packet, 17) & 255
                if dstB0 == 198 && (dstB1 == 18 || dstB1 == 19):
                    let rstLate: Bytes = tun.VpnTunBuildTcpRst(packet)
                    if BytesLen(rstLate) > 0:
                        let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, rstLate)
        var isTcpPayloadOrAck: bool
        if decision.action == tun.VpnTunPacketTcpPayload:
            isTcpPayloadOrAck = true
        if decision.action == tun.VpnTunPacketTcpAck:
            isTcpPayloadOrAck = true
        if decision.action == tun.VpnTunPacketTcpOpen:
            let keyRes: Result[int64] = VpnProxyTunPacketSessionKey(packet)
            var invalidTcpOpenTarget: bool
            if IsErr(keyRes):
                invalidTcpOpenTarget = true
            if len(decision.targetHost) <= 0:
                # Stale fake IP cached by the phone resolver across worker
                # restarts (198.18.0.0/15): accept and recover the target from
                # the TLS ClientHello SNI on the first payload segment.
                let dstB0: int32 = BytesGet(packet, 16) & 255
                let dstB1: int32 = BytesGet(packet, 17) & 255
                var dstIsFake: bool
                if dstB0 == 198:
                    if dstB1 == 18:
                        dstIsFake = true
                    if dstB1 == 19:
                        dstIsFake = true
                if !dstIsFake:
                    invalidTcpOpenTarget = true
            if decision.targetPort <= 0:
                invalidTcpOpenTarget = true
            if invalidTcpOpenTarget:
                VpnProxyTunRecordRelayError("SYNSKIP invalid host=" + strings.CloneStr(decision.targetHost) + " port=" + strings.Int64ToStr(int64(decision.targetPort)))
                let rst: Bytes = tun.VpnTunBuildTcpRst(packet)
                let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, rst)
            elif decision.transport == tunpolicy.VpnProxyTunTransportDirect && len(decision.targetHost) > 0:
                VpnProxyTunRecordRelayError("SYNSKIP direct host=" + strings.CloneStr(decision.targetHost))
                let rst: Bytes = tun.VpnTunBuildTcpRst(packet)
                let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, rst)
                handled = handled + 1
            else:
                var entry: VpnProxyTunTcpLink
                entry.sessionKey = Value(keyRes)
                entry.open = true
                entry.remoteOpen = false
                # Own the string: decision is a per-iteration temporary whose
                # managed fields do not survive the loop body; storing the str
                # directly left link.targetHost dangling after the temporary
                # release (use-after-free here, double release at link close).
                entry.targetHost = strings.CloneStr(decision.targetHost)
                # x86 byref workaround: park targetHost so EnsureRemoteOpen can
                # recover it when the var-link copy loses its fields. REVERT.
                vpnTunOpenTargetHost = strings.CloneStr(decision.targetHost)
                entry.targetPort = decision.targetPort
                entry.lastPacket = packet
                add(tcpLinks, entry)
                VpnProxyTunRecordRelayError("SYNADD n=" + strings.Int64ToStr(int64(tcpLinks.len)) + " host=" + strings.CloneStr(entry.targetHost))
                let synAck: Bytes = tun.VpnTunBuildTcpSynAck(runtime, packet)
                let wroteSa: bool = tun.VpnTunWritePacketFrameMode(fd, frameMode, synAck)
                # [seq-fix] early dial 已移除: 元素 copy-back 丢拨号结果 +
                # 全局 park 单槽被多流交叉污染(对端 seq 失步根源)。
                # 拨号统一在 payload 分支: dial→park→restore 闭环单线程串行,
                # 无交叉。成本=首包延迟回退 ~1s。
        elif decision.action == tun.VpnTunPacketTcpSynRetransmit:
            let retransSynAck: Bytes = tun.VpnTunBuildTcpSynAckRetransmit(runtime, packet)
            if BytesLen(retransSynAck) > 0:
                let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, retransSynAck)
            handled = handled + 1
        elif isTcpPayloadOrAck:
            let keyRes: Result[int64] = VpnProxyTunPacketSessionKey(packet)
            if IsOk(keyRes):
                let idx: int32 = VpnProxyTunTcpLinkIndex(tcpLinks, Value(keyRes))
                if idx >= 0:
                    tcpLinks[idx].lastPacket = packet
                    if decision.action == tun.VpnTunPacketTcpPayload:
                        let payload: Bytes = tun.VpnTunPacketPayload(packet)
                        if BytesLen(payload) > 0:
                            # SCOPED DIAGNOSTIC: payload reached the pump. REVERT.
                            if vpnTunTraceEnabled:
                                VpnProxyTunRecordRelayError(strings.ConcatStr("PAYLOAD len=", strings.Int64ToStr(BytesLen(payload))))
                            # [seq-fix] payload 是共享 TUN scratch 的内点视图, 且
                            # 拨号(~2-5s)后大函数局部槽被毁(同 relay-hunt 类):
                            # 实证 PAYLOAD len=519 → 写时 len=9。立即拷成 owned
                            # 稳定缓冲, 后续全部用稳定副本。
                            var payloadLen: int32 = BytesLen(payload)
                            # [spin-wd] 硬不变量: TUN 包载荷 ≤64KB(IP 总长 16 位)。
                            # BytesLen 二读衰减产出的巨大 len 会让下面的拷贝循环
                            # 变纯用户态死旋 — 直接拒绝并取证。
                            if payloadLen < 0 || payloadLen > 65536:
                                VpnProxyTunWatchdogRecord(strings.ConcatStr("WDPLEN decay len=", strings.Int64ToStr(int64(payloadLen))))
                                VpnProxyTunTcpLinkAbortIsolated(fd, frameMode, tcpLinks, idx, "iso_payload_len")
                                handled = handled + 1
                                continue
                            var stablePayload: Bytes = BytesAlloc(payloadLen)
                            var spIdx: int32
                            while spIdx < payloadLen:
                                BytesSet(stablePayload, spIdx, BytesGet(payload, spIdx) & 255)
                                spIdx = spIdx + 1
                            # [spin-wd] 迭代内检查: 拷贝/后续处理已烧 >500ms CPU
                            # = 迭代中存在纯内存长循环, 取证。
                            var wdCpuMidNs: int64 = VpnProxyThreadCpuNs()
                            if wdCpuMidNs >= wdIterCpuStartNs && wdCpuMidNs - wdIterCpuStartNs >= int64(500000000):
                                VpnProxyTunWatchdogRecord(strings.ConcatStr("WDTUNCPY cpuMs=", strings.ConcatStr(strings.Int64ToStr((wdCpuMidNs - wdIterCpuStartNs) / int64(1000000)), strings.ConcatStr(" payloadLen=", strings.Int64ToStr(int64(payloadLen))))))
                            # SCOPED DIAGNOSTIC: post-copy len. REVERT.
                            if vpnTunTraceEnabled:
                                VpnProxyTunRecordRelayError(strings.ConcatStr("PAYLOAD2 len=", strings.Int64ToStr(BytesLen(stablePayload))))
                            # SCOPED DIAGNOSTIC: copied content check. REVERT.
                            if vpnTunTraceEnabled:
                                var hexBuf: str
                                var hexIdx: int32
                                while hexIdx < 16 && hexIdx < payloadLen:
                                    hexBuf = hexBuf + strings.Int64ToStr(int64(BytesGet(stablePayload, hexIdx) & 255)) + ","
                                    hexIdx = hexIdx + 1
                                VpnProxyTunRecordRelayError(strings.ConcatStr("PAYLOAD2 len=", strings.ConcatStr(strings.Int64ToStr(payloadLen), strings.ConcatStr(" head=", hexBuf))))
                            let sniHost: str = VpnProxyTlsClientHelloSni(stablePayload)
                            if len(sniHost) > 0:
                                tcpLinks[idx].targetHost = strings.CloneStr(sniHost)
                            elif !tcpLinks[idx].remoteOpen:
                                # No SNI is fatal only before the exit
                                # exists: post-handshake segments (CCS/
                                # Finished) legitimately carry none and
                                # the dialed target already covers them.
                                if len(tcpLinks[idx].targetHost) <= 0:
                                    let rstNoSni: Bytes = tun.VpnTunBuildTcpRst(packet)
                                    let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, rstNoSni)
                                    VpnProxyTunTcpLinkRemove(tcpLinks, idx)
                                    handled = handled + 1
                                    continue
                            # [seq-fix] 先恢复 park 再判 remoteOpen: 元素投影
                            # copy-back 会丢 remoteOpen/keys, 不先恢复则必然
                            # 重拨全新隧道(fresh keys seq=0 → 服务端失配)。
                            if vpnTunOpenValid == 1:
                                tcpLinks[idx].transportKind = vpnTunOpenTransportKind
                                tcpLinks[idx].tcpTlsLink = vpnTunOpenTcpTlsLink
                                tcpLinks[idx].tcpTlsPendingRead = BytesAlloc(0)
                                tcpLinks[idx].remoteOpen = true
                                # [pool-handoff-fix] seq 改读 park 标量(元素
                                # 投影→嵌套字段读在布局彩票下会失真)。
                                tcpLinks[idx].tlsSendSeq = vpnTunOpenSendSeq
                                tcpLinks[idx].tlsRecvSeq = vpnTunOpenRecvSeq
                                vpnTunOpenValid = 0
                            let ensureRes: Result[bool] = VpnProxyTunTcpEnsureRemoteOpen(states,
                                                                                          tunIdentity,
                                                                                          tcpLinks[idx])
                            # [dial-job] N-A: 在途拨号 —— 本流 pending: 不计
                            # 失败不掉流, payload 由对端 TCP 重传自然重试,
                            # 等 DIALJOB 收获装回。数据面在拨号窗内继续泵。
                            if vpnTunEnsurePending == 1:
                                vpnTunEnsurePending = 0
                                if vpnTunTraceEnabled:
                                    VpnProxyTunRecordRelayError("DIALJOB pending flow")
                                handled = handled + 1
                                continue
                            if IsErr(ensureRes):
                                dialFailStreak = dialFailStreak + 1
                                if dialFailFirstMs == 0:
                                    dialFailFirstMs = VpnProxyMonoNowMs()
                                if dialFailStreak >= 30 && VpnProxyMonoNowMs() - dialFailFirstMs >= int64(120000):
                                    VpnProxyTunTcpLinksClose(tcpLinks)
                                    if udpLinkOpen:
                                        VpnProxyCloseQuicLink(udpLink)
                                    tun.VpnTunStopRuntime(runtime)
                                    VpnProxyTunRecordRelayError("TUNEXIT dial_persist")
                                    # [repair] return 必须在阈值 if 内: 任何单次瞬时
                                    # 拨号失败不得重置全会话(注释"keep the link"即此意)。
                                    return Err[bool]("vpn proxy tun: exit dial failures persist, resetting session")
                                # Keep the link: a transient dial failure must
                                # not drop the client's flow (the payload will
                                # retry on the next segment). REVERT wording.
                                VpnProxyTunRecordRelayError(strings.ConcatStr("ENSURE_ERR keep ", ErrorText(ensureRes)))
                                handled = handled + 1
                                continue
                            # SCOPED DIAGNOSTIC: ensure result. REVERT.
                            if vpnTunTraceEnabled:
                                VpnProxyTunRecordRelayError(strutil.Join(["ENSURE ok=", strings.Int64ToStr(int32(IsOk(ensureRes))), " err=", IsErr(ensureRes) ? ErrorText(ensureRes) : ""], ""))
                            dialFailStreak = 0
                            dialFailFirstMs = 0
                            # x86 byref workaround: read the parked transport
                            # back from globals into the link slot. REVERT.
                            if vpnTunOpenValid == 1:
                                tcpLinks[idx].transportKind = vpnTunOpenTransportKind
                                tcpLinks[idx].tcpTlsLink = vpnTunOpenTcpTlsLink
                                tcpLinks[idx].tcpTlsPendingRead = BytesAlloc(0)
                                tcpLinks[idx].remoteOpen = true
                                # [seq-fix] 拨号内 AUTH+OPEN 已耗 seq 0/1, 应用数据
                                # 从 2 起; 存元素顶层标量(嵌套字段写回不持久化)。
                                # [pool-handoff-fix] seq 改读 park 标量(元素
                                # 投影→嵌套字段读在布局彩票下会失真)。
                                tcpLinks[idx].tlsSendSeq = vpnTunOpenSendSeq
                                tcpLinks[idx].tlsRecvSeq = vpnTunOpenRecvSeq
                                vpnTunOpenValid = 0
                            # [mux] OPEN 完成的流经 park 标量交接(元素投影写回
                            # 在 aarch64 不持久, 与 tlsSendSeq 同纪律)。
                            if vpnTunOpenMuxValid == 1:
                                tcpLinks[idx].muxStreamId = vpnTunOpenMuxStreamId
                                tcpLinks[idx].transportKind = VpnProxyTunTcpTransportTcpTls
                                tcpLinks[idx].remoteOpen = true
                                vpnTunOpenMuxValid = 0
                            # SCOPED DIAGNOSTIC: reached the data-write branch. REVERT.
                            if vpnTunTraceEnabled:
                                VpnProxyTunRecordRelayError(strutil.Join(["WRBRANCH idx=", strings.Int64ToStr(idx), " n=", strings.Int64ToStr(tcpLinks.len), " tkind=", strings.Int64ToStr(tcpLinks[idx].transportKind), " rOpen=", strings.Int64ToStr(int32(tcpLinks[idx].remoteOpen)), " open=", strings.Int64ToStr(int32(tcpLinks[idx].open))], ""))
                            if tcpLinks[idx].muxStreamId > 0:
                                # [mux] 上行: 共享隧道按流 streamId 发 DATA 帧。
                                let muxWriteRes: Result[bool] = VpnProxyMuxWriteStreamData(tcpLinks[idx].muxStreamId, stablePayload)
                                if IsErr(muxWriteRes):
                                    # 隧道级死亡: 全部 mux 流 RST + 拆隧道, 下个流重拨。
                                    VpnProxyMuxAbortAll(fd, frameMode, tcpLinks)
                                    handled = handled + 1
                                    continue
                            elif tcpLinks[idx].transportKind == VpnProxyTunTcpTransportTcpTls:
                                # [seq-fix] seq byval 进/Result 出 + 元素顶层标量
                                # 字段写回(lastPacket 同款已证形状): 嵌套字段与
                                # 元素投影 copy-back 在 aarch64 均不持久化。
                                var curSeq: int64 = tcpLinks[idx].tlsSendSeq
                                let writeFrameRes: Result[int64] = VpnProxyTcpTlsWriteDataFrameSeq(tcpLinks[idx].tcpTlsLink,
                                                                                                   stablePayload,
                                                                                                   curSeq)
                                if IsErr(writeFrameRes):
                                    # SCOPED DIAGNOSTIC: surface the real write
                                    # failure instead of silently dropping the
                                    # link. REVERT after fix.
                                    VpnProxyTunRecordRelayError(strings.ConcatStr("TLSWRITE_ERR ", ErrorText(writeFrameRes)))
                                    VpnProxyTunTcpLinkAbortIsolated(fd,
                                                                    frameMode,
                                                                    tcpLinks,
                                                                    idx,
                                                                    "iso_tls_write")
                                    handled = handled + 1
                                    continue
                                tcpLinks[idx].tlsSendSeq = Value(writeFrameRes)
                                tcpLinks[idx].tcpTlsLink.sendKeys.seq = Value(writeFrameRes)
                            else:
                                let writeRes: Result[int32] = hy2sess.VpnProxyHy2TcpStreamWrite(tcpLinks[idx].link.stream, stablePayload)
                                if IsErr(writeRes):
                                    VpnProxyTunTcpLinkAbortIsolated(fd,
                                                                    frameMode,
                                                                    tcpLinks,
                                                                    idx,
                                                                    "iso_quic_write")
                                    handled = handled + 1
                                    continue
                            let ack: Bytes = tun.VpnTunBuildTcpAck(runtime, packet)
                            if BytesLen(ack) > 0:
                                let _ = tun.VpnTunWritePacketFrameMode(fd, frameMode, ack)
                            BytesFree(stablePayload)
                    var curRecv2: int64 = tcpLinks[idx].tlsRecvSeq
                    let flushRes: Result[int64] = VpnProxyTunTcpFlushRemoteSeq(runtime, fd, frameMode, tcpLinks[idx], curRecv2)
                    if IsErr(flushRes):
                        VpnProxyTunTcpLinkAbortIsolated(fd,
                                                        frameMode,
                                                        tcpLinks,
                                                        idx,
                                                        "iso_tls_flush2")
                        handled = handled + 1
                        continue
                    tcpLinks[idx].tlsRecvSeq = Value(flushRes)
        elif decision.action == tun.VpnTunPacketTcpClose:
            let keyRes: Result[int64] = VpnProxyTunPacketSessionKey(packet)
            if IsOk(keyRes):
                let idx: int32 = VpnProxyTunTcpLinkIndex(tcpLinks, Value(keyRes))
                if idx >= 0:
                    # [mux] 应用关流: 先向服务端发 CLOSE(streamId), 再移除。
                    if tcpLinks[idx].muxStreamId > 0:
                        let _ = VpnProxyMuxSendStreamClose(tcpLinks[idx].muxStreamId)
                        if vpnMuxActive > 0:
                            vpnMuxActive = vpnMuxActive - 1
                        tcpLinks[idx].muxStreamId = 0
                    VpnProxyTunTcpLinkRemove(tcpLinks, idx)
        elif decision.action == tun.VpnTunPacketUdpForward:
            var udpSelectedIndex: int32 = routing.VpnProxyBestHealthyExit(states, -1)
            if udpSelectedIndex < 0:
                if states.len > 0:
                    udpSelectedIndex = 0
            var udpUnsupportedOnSelectedExit: bool
            if udpSelectedIndex >= 0:
                var udpSelectedState: VpnProxyExitState = VpnProxyCloneExitState(states[udpSelectedIndex])
                if VpnProxyExitTransportText(udpSelectedState.cfg) == "tcp-tls-forward":
                    udpUnsupportedOnSelectedExit = true
            if udpUnsupportedOnSelectedExit:
                handled = handled + 1
                continue
            if !udpLinkOpen:
                var identityForUdp: VpnProxyLoadedIdentity = VpnProxyCloneLoadedIdentityForCall(identity)
                let openUdpRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemoteDatagram(states,
                                                                                       identityForUdp,
                                                                                       opts.probeIntervalMs,
                                                                                       opts.probeTimeoutMs)
                if IsErr(openUdpRes):
                    handled = handled + 1
                    continue
                udpLink = Value(openUdpRes)
                udpLinkOpen = true
            let targetRes: Result[VpnProxyTarget] = VpnProxyTunPacketTarget(packet)
            if IsOk(targetRes):
                var targetValue: VpnProxyTarget = Value(targetRes)
                let targetText: str = VpnProxyTargetAddress(targetValue)
                let sessionIdRes: Result[int64] = VpnProxyUdpSessionForAddress(udpSessions, targetText)
                if IsErr(sessionIdRes):
                    handled = handled + 1
                    continue
                let payloadLimitRes: Result[int32] = VpnProxyHy2UdpPayloadLimit(udpLink.transport,
                                                                                  Value(sessionIdRes),
                                                                                  targetText)
                if IsErr(payloadLimitRes):
                    VpnProxyCloseQuicLink(udpLink)
                    udpLinkOpen = false
                    seqs.SetLen(udpFlows, 0)
                    seqs.SetLen(udpFrags, 0)
                    handled = handled + 1
                    continue
                VpnProxyTunUdpRemember(udpFlows, Value(sessionIdRes), strings.CloneStr(targetText), packet)
                let msg: Hysteria2UdpMessage = hy2.Hysteria2MakeUdpMessage(Value(sessionIdRes),
                                                                               VpnProxyUdpPacketNext(udpPacketId),
                                                                               0,
                                                                               1,
                                                                               targetText,
                                                                               tun.VpnTunPacketPayload(packet))
                let fragsRes: Result[Hysteria2UdpMessage[]] = hy2.Hysteria2FragmentUdpMessage(msg, Value(payloadLimitRes))
                if IsErr(fragsRes):
                    VpnProxyTunRecordRelayError("TUNEXIT frags " + ErrorText(fragsRes))
                    VpnProxyTunTcpLinksClose(tcpLinks)
                    VpnProxyCloseQuicLink(udpLink)
                    return Err[bool](ErrorText(fragsRes))
                let frags: Hysteria2UdpMessage[] = Value(fragsRes)
                var udpWriteFailed: bool
                for i in 0..<frags.len:
                    if udpWriteFailed:
                        continue
                    let wireRes: Result[Bytes] = hy2.Hysteria2EncodeUdpMessage(frags[i])
                    if IsErr(wireRes):
                        VpnProxyTunRecordRelayError("TUNEXIT wire " + ErrorText(wireRes))
                        VpnProxyTunTcpLinksClose(tcpLinks)
                        VpnProxyCloseQuicLink(udpLink)
                        return Err[bool](ErrorText(wireRes))
                    let writeRes: Result[int32] = qtransport.msquicTransportDatagramWrite(udpLink.transport,
                                                                                           udpLink.conn,
                                                                                           Value(wireRes))
                    if IsErr(writeRes):
                        udpWriteFailed = true
                        continue
                if udpWriteFailed:
                    VpnProxyCloseQuicLink(udpLink)
                    udpLinkOpen = false
                    seqs.SetLen(udpFlows, 0)
                    seqs.SetLen(udpFrags, 0)
                    handled = handled + 1
                    continue
                let udpFlushRes: Result[bool] = VpnProxyTunUdpFlushRemote(fd, frameMode, udpLink, udpFlows, udpFrags)
                if IsErr(udpFlushRes):
                    VpnProxyCloseQuicLink(udpLink)
                    udpLinkOpen = false
                    seqs.SetLen(udpFlows, 0)
                    seqs.SetLen(udpFrags, 0)
                    handled = handled + 1
                    continue
        handled = handled + 1
    VpnProxyTunRecordRelayError("TUNEXIT loop_out handled=" + strings.Int64ToStr(int64(handled)) + " accept=" + strings.Int64ToStr(int64(opts.acceptCount)))
    VpnProxyTunTcpLinksClose(tcpLinks)
    if udpLinkOpen:
        VpnProxyCloseQuicLink(udpLink)
    tun.VpnTunStopRuntime(runtime)
    return Ok[bool](true)

@borrows
fn VpnProxyRunTunLocal(states: var VpnProxyExitState[],
                        identity: var VpnProxyLoadedIdentity,
                        opts: VpnProxyCliOptions): Result[bool] =
    return VpnProxyRunTunOnFd(states,
                              identity,
                              opts,
                              VpnProxyTunActiveFd,
                              tun.VpnTunFrameModeDarwinUtun,
                              VpnProxyTunActiveName)

fn VpnProxyRelayShutdownQuicWrite(quicStream: var VpnProxyHy2TcpStream): Result[bool] =
    return hy2sess.VpnProxyHy2TcpStreamShutdownWrite(quicStream)

fn VpnProxyRelayShutdownTcpWrite(conn: var tcp.TcpConnectionHandle): Result[bool] =
    return tcp.TcpShutdownWrite(conn)

fn VpnProxyFreeRelayBuffersRelayTcpQuic(readBuf: var Bytes, pending: var rawbytes.BytesBuilder): str =
    rawbytes.BytesBuilderFree(pending)
    BytesFree(readBuf)
    return "vpn proxy relay: failed"

fn VpnProxyJoinRelayErrFreeRelayTcpQuic(message: str, readBuf: var Bytes, pending: var rawbytes.BytesBuilder): str =
    rawbytes.BytesBuilderFree(pending)
    BytesFree(readBuf)
    return message

fn VpnProxyRelayTcpQuic(conn: var tcp.TcpConnectionHandle,
                          quicStream: var VpnProxyHy2TcpStream): Result[bool] =
    let nbRes = tcp.TcpSetNonblocking(conn, true)
    if IsErr(nbRes):
        return Err[bool](ErrorText(nbRes))
    var tcpReadBuf: Bytes = BytesAlloc(VpnProxyRelayChunkBytes)
    var pending: rawbytes.BytesBuilder = rawbytes.BytesBuilderNew(VpnProxyRelayChunkBytes)
    var tcpReadClosed = false
    var tcpWriteClosed = false
    var quicReadClosed = false
    var quicWriteClosed = false
    while true:
        var progressed = false
        if !tcpReadClosed:
            let readRes: Result[int32] = tcp.TcpRecvRawNonblocking(conn, tcpReadBuf.data, BytesLen(tcpReadBuf))
            if IsErr(readRes):
                if ErrorText(readRes) != "tcp syscall: would block":
                    return Err[bool](VpnProxyFreeRelayBuffersRelayTcpQuic(tcpReadBuf, pending))
            else:
                let got: int32 = Value(readRes)
                if got <= 0:
                    tcpReadClosed = true
                    if !quicWriteClosed:
                        let closeRes: Result[bool] = VpnProxyRelayShutdownQuicWrite(quicStream)
                        if IsErr(closeRes):
                            return Err[bool](VpnProxyFreeRelayBuffersRelayTcpQuic(tcpReadBuf, pending))
                        quicWriteClosed = true
                    progressed = true
                else:
                    var chunk: Bytes = BytesSlice(tcpReadBuf, 0, got)
                    let writeRes: Result[int32] = hy2sess.VpnProxyHy2TcpStreamWrite(quicStream, chunk)
                    BytesFree(chunk)
                    if IsErr(writeRes):
                        return Err[bool](VpnProxyFreeRelayBuffersRelayTcpQuic(tcpReadBuf, pending))
                    progressed = true
        while true:
            let readRes: Result[Bytes] = hy2sess.VpnProxyHy2TcpStreamReadNonblocking(quicStream,
                                                                                        VpnProxyRelayChunkBytes)
            if IsErr(readRes):
                let err: str = ErrorText(readRes)
                if VpnProxyWouldBlockQuic(err):
                    break
                if err == "msquic: stream closed" ||
                   err == "msquic: pipe closed" ||
                   err == "connection: closed":
                    quicReadClosed = true
                    break
                return Err[bool](VpnProxyJoinRelayErrFreeRelayTcpQuic(strings.CloneStr(err), tcpReadBuf, pending))
            var chunk: Bytes = Value(readRes)
            if BytesLen(chunk) <= 0:
                BytesFree(chunk)
                break
            rawbytes.BytesBuilderAppend(pending, chunk)
            BytesFree(chunk)
            progressed = true
        let pendingLen: int32 = rawbytes.BytesBuilderLen(pending)
        if pendingLen > 0:
            let sendRes: Result[int32] = tcp.TcpSendRawNonblocking(conn, pending.buffer, pendingLen)
            if IsErr(sendRes):
                return Err[bool](VpnProxyFreeRelayBuffersRelayTcpQuic(tcpReadBuf, pending))
            let sent: int32 = Value(sendRes)
            if sent > 0:
                if sent < pendingLen:
                    rawmem_support.RawmemCopy(pending.buffer,
                                              rawmem_support.RawmemPtrAdd(pending.buffer, sent),
                                              pendingLen - sent)
                pending.len = pending.len - sent
                progressed = true
        if quicReadClosed && rawbytes.BytesBuilderLen(pending) <= 0 && !tcpWriteClosed:
            let shutdownRes: Result[bool] = VpnProxyRelayShutdownTcpWrite(conn)
            if IsErr(shutdownRes):
                return Err[bool](VpnProxyFreeRelayBuffersRelayTcpQuic(tcpReadBuf, pending))
            tcpWriteClosed = true
        if tcpReadClosed && quicReadClosed && rawbytes.BytesBuilderLen(pending) <= 0:
            rawbytes.BytesBuilderFree(pending)
            BytesFree(tcpReadBuf)
            return Ok[bool](true)
        if !progressed:
            os.SleepMs(10)
        if !conn.open || !quicStream.conn.open:
            if rawbytes.BytesBuilderLen(pending) <= 0:
                rawbytes.BytesBuilderFree(pending)
                BytesFree(tcpReadBuf)
                return Ok[bool](true)
        if quicReadClosed && rawbytes.BytesBuilderLen(pending) <= 0 && tcpReadClosed:
            rawbytes.BytesBuilderFree(pending)
            BytesFree(tcpReadBuf)
            return Ok[bool](true)

@borrows
fn VpnProxyTcpTlsTryDecodeFrameFromPendingRead(recvKeys: var tlsrec.VpnProxyTcpTlsRecordKeys,
                                               pendingIn: var Bytes,
                                               outPending: var Bytes,
                                               outFrame: var ttf.VpnProxyTcpTlsForwardFrame): Result[bool] =
    let completeRes: Result[int32] = tlsrec.VpnProxyTcpTlsRecordPlainCompleteLength(pendingIn)
    if IsErr(completeRes):
        return Err[bool](ErrorText(completeRes))
    # [repair] 被吃掉的 if 行:0=未读够属正常态,须等待而非报错。
    if Value(completeRes) <= 0:
        return Ok[bool](false)
    VpnProxyTcpTlsForwardDebugLine(["tcp_tls_forward decode_record pending_len=",
                                    IntToStr(BytesLen(pendingIn)),
                                    " complete_len=",
                                    IntToStr(Value(completeRes)),
                                    " recv_seq=",
                                    IntToStr(int32(recvKeys.seq))])
    # [relay-owned] record/rest 改 owned 拷贝(原内点视图+free 底座=双悬垂)
    var record: Bytes = BytesAlloc(Value(completeRes))
    var recOwnedIdx: int32
    while recOwnedIdx < Value(completeRes):
        BytesSet(record, recOwnedIdx, BytesGet(pendingIn, recOwnedIdx) & 255)
        recOwnedIdx = recOwnedIdx + 1
    var rest: Bytes = BytesAlloc(0)
    if BytesLen(pendingIn) > Value(completeRes):
        rest = BytesAlloc(BytesLen(pendingIn) - Value(completeRes))
        var cpRestIdx4: int32
        while cpRestIdx4 < BytesLen(rest):
            BytesSet(rest, cpRestIdx4, BytesGet(pendingIn, Value(completeRes) + cpRestIdx4) & 255)
            cpRestIdx4 = cpRestIdx4 + 1
    BytesFree(pendingIn)
    var plain: tlsrec.VpnProxyTcpTlsRecordPlain
    let plainRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordDecryptInto(recvKeys,
                                                                         record,
                                                                         plain)
    if IsErr(plainRes):
        BytesFree(record)
        BytesFree(rest)
        return Err[bool](ErrorText(plainRes))
    if plain.contentType != tlsrec.VpnProxyTcpTlsRecordContentTypeApplicationData():
        BytesFree(record)
        BytesFree(plain.payload)
        BytesFree(rest)
        return Err[bool]("vpn proxy tcp-tls-forward: expected application record")
    var frame: ttf.VpnProxyTcpTlsForwardFrame
    let frameCode: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(plain.payload, frame)
    # [orc-hunt x86] frame.payload 是 plain.payload 的视图,下方立即释放底座;
    # 消费侧(concat/写 TUN)读 freed 内容=随机腐蚀。owned 拷贝后才释放。
    if frameCode > 0 && BytesLen(frame.payload) > 0:
        var ownedPayload: Bytes = BytesAlloc(BytesLen(frame.payload))
        var ownIdx: int32
        while ownIdx < BytesLen(ownedPayload):
            BytesSet(ownedPayload, ownIdx, BytesGet(frame.payload, ownIdx) & 255)
            ownIdx = ownIdx + 1
        frame.payload = ownedPayload
    BytesFree(record)
    BytesFree(plain.payload)
    if frameCode <= 0:
        BytesFree(rest)
        return Err[bool]("vpn proxy tcp-tls-forward: invalid frame")
    outPending = rest
    outFrame = frame
    return Ok[bool](true)


# [rss-batch] worker 级静态读缓冲(单份 32KB, 进程生命周期): 旧形状在
# VpnProxyTcpTlsTryReadFrameNonblockingRaw 里每次可读都 BytesAlloc(32768)
# (含 32KB 清零)+BytesFree, 每读一次分配/清零 churn 是 RSS 滞留源之一。
# TUN worker 与池 maintainer 拨号线都会进该函数, scratch 用 CAS 自旋锁互斥
# (临界区=一次非阻塞 recv+owned 拷贝, 微秒级; 拨号读稀疏, 实际无争用)。
# 读满即拷走处理, 无需清零。
var g_vpn_tls_read_scratch: Bytes
var g_vpn_tls_read_scratch_ready: bool
var VpnProxyTlsReadScratchLockWord: int32

fn VpnProxyTlsReadScratchLock() =
    while VpnProxyAtomicCasI32(&VpnProxyTlsReadScratchLockWord, 0, 1) == 0:
        thread.Yield()

fn VpnProxyTlsReadScratchUnlock() =
    VpnProxyAtomicStoreI32(&VpnProxyTlsReadScratchLockWord, 0)

fn VpnProxyTcpTlsTryReadFrameNonblockingRaw(conn: var tcp.TcpConnectionHandle,
                                            recvKeys: var tlsrec.VpnProxyTcpTlsRecordKeys,
                                            pending: var Bytes,
                                            outFrame: var ttf.VpnProxyTcpTlsForwardFrame): Result[bool] =
    var newPending: Bytes = BytesAlloc(0)
    let pendingFrameRes: Result[bool] = VpnProxyTcpTlsTryDecodeFrameFromPendingRead(recvKeys,
                                                                                    pending,
                                                                                    newPending,
                                                                                    outFrame)
    if IsErr(pendingFrameRes):
        return Err[bool](ErrorText(pendingFrameRes))
    # [owned-fix] 只在成功消费时采纳 owned remainder; 不完整路径必须保留
    # 原 pending(否则半条记录被 {nil,0} 覆盖=静默丢字节)。
    if Value(pendingFrameRes):
        pending = newPending
        # [repair] 被吃掉的 if 行:pending 已有完整帧才直接返回。
        return Ok[bool](true)
    # [drain-dry] 吸干循环: 高 RTT 链路一次 recv 常只到部分记录, 旧形"读
    # 一次不成帧即返 false"让调用方 break 等下一轮主循环(实测 ~16ms/轮),
    # 单位时间净得几 KB → 62KB/s 天花板 + 窗口收缩背压顶回服务器。改为
    # 读至 EAGAIN(内核真无数据)或成帧; 探测 wait 保留 1ms(aarch64 下
    # timeout=0 的 poll 语义历史分歧, 1ms 已证)。
    while true:
        let readyRes: Result[bool] = tcp.TcpConnectionWaitReadable(conn, 1)
        if IsErr(readyRes):
            return Err[bool](ErrorText(readyRes))
        if !Value(readyRes):
            return Ok[bool](false)
        VpnProxyTlsReadScratchLock()
        if !g_vpn_tls_read_scratch_ready:
            g_vpn_tls_read_scratch = BytesAlloc(VpnProxyRelayChunkBytes)
            g_vpn_tls_read_scratch_ready = true
        let readRes: Result[int32] = tcp.TcpRecvRawNonblocking(conn, g_vpn_tls_read_scratch.data, BytesLen(g_vpn_tls_read_scratch))
        if IsErr(readRes):
            VpnProxyTlsReadScratchUnlock()
            if ErrorText(readRes) != "tcp syscall: would block":
                return Err[bool](ErrorText(readRes))
            return Ok[bool](false)
        let got: int32 = Value(readRes)
        if got <= 0:
            VpnProxyTlsReadScratchUnlock()
            # [rd-hunt] EOF 时打印 pending 头部声明: 判定等不到的是"服务器写错头"
            # 还是"字节途中丢失"(声明 N vs 已收 BytesLen(pending))。
            var eofDiag: str = "RDEOF got=" + strings.Int64ToStr(int64(got)) + " seq=" + strings.Int64ToStr(int64(recvKeys.seq))
            eofDiag = eofDiag + " plen=" + strings.Int64ToStr(int64(BytesLen(pending)))
            if BytesLen(pending) >= 5:
                var hb: int32
                while hb < 5:
                    eofDiag = eofDiag + "," + strings.Int64ToStr(int64(BytesGet(pending, hb) & 255))
                    hb = hb + 1
            VpnProxyTunRecordRelayError(eofDiag)
            return Err[bool]("vpn proxy tcp-tls-forward: remote closed")
        var chunk: Bytes = BytesSlice(g_vpn_tls_read_scratch, 0, got)
        VpnProxyTlsReadScratchUnlock()
        VpnProxyTcpTlsForwardDebugLine(["tcp_tls_forward raw_read got=",
                                        IntToStr(got),
                                        " pending_before=",
                                        IntToStr(BytesLen(pending))])
        pending = VpnProxyBytesConcat(pending, chunk)
        if vpnTunTraceEnabled:
            VpnProxyTunRecordRelayError("RD t=" + strings.Int64ToStr(VpnProxyMonoNowMs()) + " got=" + strings.Int64ToStr(int64(BytesLen(chunk))) + " pending=" + strings.Int64ToStr(int64(BytesLen(pending))))
        BytesFree(chunk)
        VpnProxyTcpTlsForwardDebugLine(["tcp_tls_forward raw_read pending_after=",
                                        IntToStr(BytesLen(pending))])
        var newPending2: Bytes = BytesAlloc(0)
        let decodeRes: Result[bool] = VpnProxyTcpTlsTryDecodeFrameFromPendingRead(recvKeys,
                                                                                  pending,
                                                                                  newPending2,
                                                                                  outFrame)
        # [owned-fix] 同 4405: 只在成功消费时采纳 remainder, 不完整路径保留原 pending。
        if IsErr(decodeRes):
            return Err[bool](ErrorText(decodeRes))
        if Value(decodeRes):
            pending = newPending2
            return Ok[bool](true)
        # 记录不完整: 继续探测读(吸干), EAGAIN 由循环顶 wait_readable 兜。

fn VpnProxyTcpTlsMoveDialerProxyBufferedData(link: var VpnProxyTcpTlsForwardLink,
                                             pending: var Bytes): bool =
    if BytesLen(link.dialerProxyDataPending) <= 0:
        return false
    var chunk: Bytes = link.dialerProxyDataPending
    pending = VpnProxyBytesConcat(pending, chunk)
    VpnProxyTunRecordRelayError("RD t=" + strings.Int64ToStr(VpnProxyMonoNowMs()) + " got=" + strings.Int64ToStr(int64(BytesLen(chunk))) + " pending=" + strings.Int64ToStr(int64(BytesLen(pending))))
    BytesFree(chunk)
    link.dialerProxyDataPending = BytesAlloc(0)
    return true

fn VpnProxyTcpTlsTryReadDialerProxyPayloadFrameNonblocking(link: var VpnProxyTcpTlsForwardLink,
                                                           pending: var Bytes): Result[bool] =
    var frame: ttf.VpnProxyTcpTlsForwardFrame
    var framePending: Bytes = link.dialerProxyFramePending
    let frameRes: Result[bool] = VpnProxyTcpTlsTryReadFrameNonblockingRaw(link.conn,
                                                                           link.dialerProxyRecvKeys,
                                                                           framePending,
                                                                           frame)
    link.dialerProxyFramePending = framePending
    if IsErr(frameRes):
        return Err[bool](ErrorText(frameRes))
    if !Value(frameRes):
        return Ok[bool](false)
    if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindData():
        VpnProxyTcpTlsForwardDebugLine(["tcp_tls_forward dialer_data_frame payload_len=",
                                        IntToStr(BytesLen(frame.payload)),
                                        " recv_seq_next=",
                                        IntToStr(int32(link.dialerProxyRecvKeys.seq))])
        pending = VpnProxyBytesConcat(pending, frame.payload)
        BytesFree(frame.payload)
        return Ok[bool](true)
    if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindClose():
        return Err[bool]("vpn proxy tcp-tls-forward: remote closed")
    return Err[bool]("vpn proxy tcp-tls-forward: unexpected dialer_proxy frame")

fn VpnProxyTcpTlsTryReadDialerProxyPayloadNonblocking(link: var VpnProxyTcpTlsForwardLink,
                                                      pending: var Bytes): Result[bool] =
    if VpnProxyTcpTlsMoveDialerProxyBufferedData(link, pending):
        return Ok[bool](true)
    let frameRes: Result[bool] = VpnProxyTcpTlsTryReadDialerProxyPayloadFrameNonblocking(link,
                                                                                          pending)
    return frameRes

fn VpnProxyTcpTlsTryReadFrameNonblocking(link: var VpnProxyTcpTlsForwardLink,
                                         pending: var Bytes,
                                         outFrame: var ttf.VpnProxyTcpTlsForwardFrame): Result[bool] =
    if !link.dialerProxyActive:
        let rawRes: Result[bool] = VpnProxyTcpTlsTryReadFrameNonblockingRaw(link.conn,
                                                                            link.recvKeys,
                                                                            pending,
                                                                            outFrame)
        return rawRes
    # [repair] 原 dialer 分支被无条件 return 截断,后续读 payload+解码不可达;
    # 按前后语义重建:先取 dialer payload,再解码,pending 不足不算错误。
    let fillRes: Result[bool] = VpnProxyTcpTlsTryReadDialerProxyPayloadNonblocking(link, pending)
    if IsErr(fillRes):
        return Err[bool](ErrorText(fillRes))
    if !Value(fillRes):
        return Ok[bool](false)
    var frameOwned: ttf.VpnProxyTcpTlsForwardFrame
    var newPending: Bytes = BytesAlloc(0)
    # [keys-fix] dialer 路径的读与解码必须使用同一密钥集。
    let pendingFrameRes: Result[bool] = VpnProxyTcpTlsTryDecodeFrameFromPendingRead(link.dialerProxyRecvKeys,
                                                                                    pending,
                                                                                    newPending,
                                                                                    frameOwned)
    # [owned-fix] 只在成功消费时采纳 remainder; 不完整路径保留原 pending。
    if IsErr(pendingFrameRes):
        return Err[bool](ErrorText(pendingFrameRes))
    if !Value(pendingFrameRes):
        return Ok[bool](false)
    pending = newPending
    outFrame = frameOwned
    return Ok[bool](true)

fn VpnProxyTcpTlsReadFrameStopAware(link: var VpnProxyTcpTlsForwardLink,
                                    timeoutMs: int32): Result[ttf.VpnProxyTcpTlsForwardFrame] =
    let nbRes = tcp.TcpSetNonblocking(link.conn, true)
    if IsErr(nbRes):
        return Err[ttf.VpnProxyTcpTlsForwardFrame](ErrorText(nbRes))
    var pending: Bytes = BytesAlloc(0)
    var deadlineMs: int64
    if timeoutMs > 0:
        deadlineMs = VpnProxyMonoNowMs() + int64(timeoutMs)
    while true:
        if VpnProxyLocalProxyShouldStop():
            return Err[ttf.VpnProxyTcpTlsForwardFrame]("vpn proxy: local proxy stopped")
        var frame: ttf.VpnProxyTcpTlsForwardFrame
        let frameRes: Result[bool] = VpnProxyTcpTlsTryReadFrameNonblocking(link, pending, frame)
        if IsErr(frameRes):
            return Err[ttf.VpnProxyTcpTlsForwardFrame](ErrorText(frameRes))
        if Value(frameRes):
            return Ok[ttf.VpnProxyTcpTlsForwardFrame](frame)
        if timeoutMs > 0:
            if VpnProxyMonoNowMs() >= deadlineMs:
                return Err[ttf.VpnProxyTcpTlsForwardFrame]("vpn proxy tcp-tls-forward: read timeout")
        os.SleepMs(1)

@borrows
fn VpnProxyTcpTlsRelayBufferedReadAvailable(link: var VpnProxyTcpTlsForwardLink,
                                            pending: var Bytes): bool =
    if BytesLen(pending) > 0:
        return true
    if !link.dialerProxyActive:
        return false
    if BytesLen(link.dialerProxyFramePending) > 0:
        return true
    if BytesLen(link.dialerProxyDataPending) > 0:
        return true
    return false

fn VpnProxyRelayTcpTlsForward(conn: var tcp.TcpConnectionHandle,
                              link: var VpnProxyTcpTlsForwardLink): Result[bool] =
    let localNbRes = tcp.TcpSetNonblocking(conn, true)
    if IsErr(localNbRes):
        return Err[bool](ErrorText(localNbRes))
    let remoteNbRes = tcp.TcpSetNonblocking(link.conn, true)
    if IsErr(remoteNbRes):
        return Err[bool](ErrorText(remoteNbRes))
    var localPendingWrite: rawbytes.BytesBuilder = rawbytes.BytesBuilderNew(VpnProxyRelayChunkBytes)
    var remotePendingRead: Bytes = BytesAlloc(0)
    var localReadClosed: bool
    var remoteClosed: bool
    # [spin-wd] 手机侧 relay 迭代 CPU 基线(与 exit 侧 WDRELY 同形)。
    var rlwIterCpuStartNs: int64 = VpnProxyThreadCpuNs()
    var rlwWdFired: int32
    # [spin-wd] 迭代心跳: 每 1000 迭代一条 RLWITER(trace 门控内), 死旋时
    # 可见循环是否仍在推进及速率; 与 500ms CPU 看门狗(只报长迭代)互补。
    var rlwIters: int64
    while true:
        if VpnProxyLocalProxyShouldStop():
            rawbytes.BytesBuilderFree(localPendingWrite)
            BytesFree(remotePendingRead)
            return Err[bool]("vpn proxy: local proxy stopped")
        var rlwCpuNowNs: int64 = VpnProxyThreadCpuNs()
        if rlwCpuNowNs >= rlwIterCpuStartNs && rlwCpuNowNs - rlwIterCpuStartNs >= int64(500000000):
            rlwWdFired = rlwWdFired + 1
            var rlwPendLen: int32 = rawbytes.BytesBuilderLen(localPendingWrite)
            var rlwRprLen: int32 = BytesLen(remotePendingRead)
            VpnProxyTunWatchdogRecord(strutil.Join(["WDRLW n=", strings.Int64ToStr(int64(rlwWdFired)), " cpuMs=", strings.Int64ToStr((rlwCpuNowNs - rlwIterCpuStartNs) / int64(1000000)), " lRC=", strings.Int64ToStr(int64(int32(localReadClosed))), " rC=", strings.Int64ToStr(int64(int32(remoteClosed))), " pend=", strings.Int64ToStr(int64(rlwPendLen)), " rpr=", strings.Int64ToStr(int64(rlwRprLen))], ""))
        rlwIterCpuStartNs = rlwCpuNowNs
        rlwIters = rlwIters + 1
        if rlwIters >= 1000:
            rlwIters = 0
            if vpnTunTraceEnabled:
                var rlwHbPend: int32 = rawbytes.BytesBuilderLen(localPendingWrite)
                var rlwHbRpr: int32 = BytesLen(remotePendingRead)
                VpnProxyTunRecordRelayError(strutil.Join(["RLWITER lRC=", strings.Int64ToStr(int64(int32(localReadClosed))), " rC=", strings.Int64ToStr(int64(int32(remoteClosed))), " pend=", strings.Int64ToStr(int64(rlwHbPend)), " rpr=", strings.Int64ToStr(int64(rlwHbRpr))], ""))
        var progressed: bool
        if !localReadClosed:
            let localReadable: int32 = VpnProxyFdWaitReadable(conn.fd, 0)
            if localReadable < 0:
                return Err[bool]("vpn proxy tcp-tls-forward: local wait readable failed")
            if localReadable > 0:
                var readBuf: Bytes = BytesAlloc(VpnProxyRelayChunkBytes)
                let readRes: Result[int32] = tcp.TcpRecvRawNonblocking(conn, readBuf.data, BytesLen(readBuf))
                if IsErr(readRes):
                    BytesFree(readBuf)
                    if ErrorText(readRes) != "tcp syscall: would block":
                        return Err[bool](ErrorText(readRes))
                else:
                    let got: int32 = Value(readRes)
                    if got <= 0:
                        BytesFree(readBuf)
                        localReadClosed = true
                        let closeWriteRes: Result[bool] = VpnProxyTcpTlsWriteCloseFrame(link)
                        if IsErr(closeWriteRes):
                            return Err[bool](ErrorText(closeWriteRes))
                    else:
                        var chunk: Bytes = BytesSlice(readBuf, 0, got)
                        BytesFree(readBuf)
                        let writeRes: Result[bool] = VpnProxyTcpTlsWriteDataFrame(link, chunk)
                        BytesFree(chunk)
                        if IsErr(writeRes):
                            return Err[bool](ErrorText(writeRes))
                    progressed = true
        var remoteReady: bool = VpnProxyTcpTlsRelayBufferedReadAvailable(link, remotePendingRead)
        if !remoteReady:
            let remoteReadable: int32 = VpnProxyFdWaitReadable(link.conn.fd, 0)
            if remoteReadable < 0:
                return Err[bool]("vpn proxy tcp-tls-forward: remote wait readable failed")
            if remoteReadable > 0:
                remoteReady = true
        if remoteReady:
            var frame: ttf.VpnProxyTcpTlsForwardFrame
            let frameRes: Result[bool] = VpnProxyTcpTlsTryReadFrameNonblocking(link,
                                                                                remotePendingRead,
                                                                                frame)
            if IsErr(frameRes):
                if ErrorText(frameRes) == "vpn proxy tcp-tls-forward: remote closed":
                    remoteClosed = true
                else:
                    VpnProxyTunRecordRelayError("RDERR " + ErrorText(frameRes))
                    return Err[bool](ErrorText(frameRes))
            elif Value(frameRes):
                if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindData():
                    # [rd-hunt] 下行帧到达标记: 长度+累计待发。
                    VpnProxyTunRecordRelayError("RDDEC len=" + strings.Int64ToStr(int64(BytesLen(frame.payload))) + " pend=" + strings.Int64ToStr(int64(rawbytes.BytesBuilderLen(localPendingWrite))))
                    rawbytes.BytesBuilderAppend(localPendingWrite, frame.payload)
                    BytesFree(frame.payload)
                elif frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindClose():
                    remoteClosed = true
                else:
                    return Err[bool]("vpn proxy tcp-tls-forward: unexpected relay frame")
                progressed = true
        let pendingLen: int32 = rawbytes.BytesBuilderLen(localPendingWrite)
        if pendingLen > 0:
            let sendRes: Result[int32] = tcp.TcpSendRawNonblocking(conn,
                                                                    localPendingWrite.buffer,
                                                                    pendingLen)
            if IsErr(sendRes):
                if ErrorText(sendRes) != "tcp syscall: would block":
                    rawbytes.BytesBuilderFree(localPendingWrite)
                    BytesFree(remotePendingRead)
                    return Err[bool](ErrorText(sendRes))
            else:
                let sent: int32 = Value(sendRes)
                if sent > 0:
                    if sent < pendingLen:
                        rawmem_support.RawmemCopy(localPendingWrite.buffer,
                                                  rawmem_support.RawmemPtrAdd(localPendingWrite.buffer, sent),
                                                  pendingLen - sent)
                    localPendingWrite.len = localPendingWrite.len - sent
                    progressed = true
        if remoteClosed && rawbytes.BytesBuilderLen(localPendingWrite) <= 0:
            let _ = tcp.TcpShutdownWrite(conn)
            rawbytes.BytesBuilderFree(localPendingWrite)
            BytesFree(remotePendingRead)
            return Ok[bool](true)
        if localReadClosed && rawbytes.BytesBuilderLen(localPendingWrite) <= 0:
            rawbytes.BytesBuilderFree(localPendingWrite)
            BytesFree(remotePendingRead)
            return Ok[bool](true)
        if localReadClosed && remoteClosed && rawbytes.BytesBuilderLen(localPendingWrite) <= 0:
            rawbytes.BytesBuilderFree(localPendingWrite)
            BytesFree(remotePendingRead)
            return Ok[bool](true)
        if !progressed:
            os.SleepMs(1)

@borrows
fn VpnProxyCloneUdpSockAddr(srcAddr: udp.UdpSockAddr): udp.UdpSockAddr =
    var outAddr: udp.UdpSockAddr
    var dataCopy: Bytes = rawbytes.BytesSlice(srcAddr.data, 0, rawbytes.BytesLen(srcAddr.data))
    outAddr.data = dataCopy
    outAddr.len = srcAddr.len
    outAddr.family = srcAddr.family
    outAddr.isV6 = srcAddr.isV6
    outAddr.host = strings.CloneStr(srcAddr.host)
    outAddr.port = srcAddr.port
    return outAddr

fn VpnProxyEmptyUdpSockAddr(): udp.UdpSockAddr =
    var outAddr: udp.UdpSockAddr
    var emptyData: Bytes = rawbytes.EmptyBytes()
    outAddr.data = emptyData
    outAddr.len = 0
    outAddr.family = 0
    outAddr.isV6 = false
    outAddr.host = ""
    outAddr.port = 0
    return outAddr

fn VpnProxyStoreFragStateAt(states: var VpnProxyUdpFragState[], idx: int32, st: VpnProxyUdpFragState) =
    states[idx].sessionId = st.sessionId
    states[idx].packetId = st.packetId
    states[idx].address = strings.CloneStr(st.address)
    states[idx].firstSeenMs = st.firstSeenMs
    states[idx].lastSeenMs = st.lastSeenMs
    states[idx].payloadBytes = st.payloadBytes
    states[idx].fragments = st.fragments

fn VpnProxyUdpFragFeedValue(fragStates: var VpnProxyUdpFragState[],
                            msg: Hysteria2UdpMessage): Result[VpnProxyUdpFragFeedOutcome] =
    var outMsg: Hysteria2UdpMessage
    let feedRes: Result[bool] = VpnProxyUdpFragFeed(fragStates, msg, outMsg)
    if IsErr(feedRes):
        var feedErrText: str = ErrorText(feedRes)
        return Err[VpnProxyUdpFragFeedOutcome](feedErrText)
    var outcome: VpnProxyUdpFragFeedOutcome
    outcome.complete = Value(feedRes)
    outcome.message = outMsg
    return Ok[VpnProxyUdpFragFeedOutcome](outcome)

fn VpnProxyUdpRecvFromNonblockValue(fd: int32,
                                    maxBytes: int32): Result[udp.UdpRecvResult] =
    var outRecv: udp.UdpRecvResult
    let recvRes: Result[bool] = udp.UdpRecvFromNonblock(fd, maxBytes, outRecv)
    if IsErr(recvRes):
        var recvErrText: str = ErrorText(recvRes)
        return Err[udp.UdpRecvResult](recvErrText)
    return Ok[udp.UdpRecvResult](outRecv)

fn VpnProxyUdpRecvFromNonblockInto(fd: int32,
                                   maxBytes: int32,
                                   outData: var Bytes,
                                   outFromAddr: var udp.UdpSockAddr): Result[bool] =
    var outRecv: udp.UdpRecvResult
    let recvRes: Result[bool] = udp.UdpRecvFromNonblock(fd, maxBytes, outRecv)
    if IsErr(recvRes):
        var recvErrText: str = ErrorText(recvRes)
        return Err[bool](recvErrText)
    outData = outRecv.data
    outFromAddr = outRecv.fromAddr
    return Ok[bool](true)

@borrows
fn VpnProxyRelayUdpPumpOnce(conn: var tcp.TcpConnectionHandle,
                            relaySocket: VpnProxyUdpBoundSocket,
                            link: var VpnProxyQuicLink,
                            clientPeerSet: var bool,
                            clientPeerKeySlot: var str[],
                            clientPeerSlot: var udp.UdpSockAddr[],
                            clientPacketId: var int32,
                            remoteFrags: var VpnProxyUdpFragState[],
                            localSessions: var VpnProxyUdpSessionTable): Result[int32] =
    let controlBuf: Bytes = BytesAlloc(1)
    var progressedSlot: bool[]
    let controlRes: Result[int32] = tcp.TcpRecvRawNonblocking(conn, controlBuf.data, 1)
    if IsErr(controlRes):
        if ErrorText(controlRes) != "tcp syscall: would block":
            return Err[bool](ErrorText(controlRes))
    else:
        let got: int32 = Value(controlRes)
        if got == 0:
            return Ok[int32](2)
        return Err[bool]("vpn proxy socks5: udp associate control stream invalid")
    var localRecvData: Bytes = BytesAlloc(0)
    var recvFromAddr: udp.UdpSockAddr
    let localRecvRes: Result[bool] = VpnProxyUdpRecvFromNonblockInto(relaySocket.socket.fd,
                                                                     VpnProxyUdpRelayChunkBytes,
                                                                     localRecvData,
                                                                     recvFromAddr)
    if IsErr(localRecvRes):
        if !VpnProxyWouldBlockUdp(ErrorText(localRecvRes)):
            return Err[bool](ErrorText(localRecvRes))
    else:
        var keyParts: str[]
        add(keyParts, strings.CloneStr(recvFromAddr.host))
        add(keyParts, IntToStr(recvFromAddr.port))
        let fromKey: str = strutil.Join(keyParts, ":")
        let knownKey: str = if len(clientPeerKeySlot) > 0: strings.CloneStr(clientPeerKeySlot[0]) else: ""
        if fromKey != knownKey:
        else:
            if !clientPeerSet:
                add(clientPeerKeySlot, strings.CloneStr(fromKey))
                add(clientPeerSlot, VpnProxyCloneUdpSockAddr(recvFromAddr))
                clientPeerSet = true
            let udpReqRes: Result[VpnProxySocksUdpDatagram] = socks.VpnProxySocksDecodeUdpDatagram(localRecvData)
            if IsErr(udpReqRes):
                return Err[bool](ErrorText(udpReqRes))
            var udpReq: VpnProxySocksUdpDatagram = Value(udpReqRes)
            if udpReq.fragmentId != 0:
                return Err[bool]("vpn proxy: socks udp fragmentation unsupported")
            let targetText: str = VpnProxyTargetAddress(udpReq.target)
            let sessionIdRes: Result[int64] = VpnProxyUdpSessionForAddress(localSessions, targetText)
            if IsErr(sessionIdRes):
                return Err[bool](ErrorText(sessionIdRes))
            var sessionIdOwned: int64 = Value(sessionIdRes)
            let payloadLimitRes: Result[int32] = VpnProxyHy2UdpPayloadLimit(link.transport,
                                                                              sessionIdOwned,
                                                                              targetText)
            if IsErr(payloadLimitRes):
                return Err[bool](ErrorText(payloadLimitRes))
            let packetId: int32 = VpnProxyUdpPacketNext(clientPacketId)
            let msg: Hysteria2UdpMessage = hy2.Hysteria2MakeUdpMessage(sessionIdOwned,
                                                                           packetId,
                                                                           0,
                                                                           1,
                                                                           targetText,
                                                                           BytesSlice(udpReq.payload, 0, BytesLen(udpReq.payload)))
            let fragmentsRes: Result[Hysteria2UdpMessage[]] = hy2.Hysteria2FragmentUdpMessage(msg,
                                                                                                   Value(payloadLimitRes))
            if IsErr(fragmentsRes):
                return Err[bool](ErrorText(fragmentsRes))
            let fragments: Hysteria2UdpMessage[] = Value(fragmentsRes)
            for i in 0..<fragments.len:
                let wireRes: Result[Bytes] = hy2.Hysteria2EncodeUdpMessage(fragments[i])
                if IsErr(wireRes):
                    return Err[bool](ErrorText(wireRes))
                let writeRes: Result[int32] = qtransport.msquicTransportDatagramWrite(link.transport,
                                                                                       link.conn,
                                                                                       Value(wireRes))
                if IsErr(writeRes):
                    return Err[bool](ErrorText(writeRes))
    let remoteReadRes: Result[Bytes] = qtransport.msquicTransportDatagramRead(link.transport, link.conn)
    if IsErr(remoteReadRes):
        let err: str = ErrorText(remoteReadRes)
        if !VpnProxyWouldBlockQuic(err):
            return Err[bool](strings.CloneStr(err))
    else:
        let msgRes: Result[Hysteria2UdpMessage] = hy2.Hysteria2DecodeUdpMessage(Value(remoteReadRes))
        if IsErr(msgRes):
            return Err[bool](ErrorText(msgRes))
        var msg: Hysteria2UdpMessage = Value(msgRes)
        if !VpnProxyUdpSessionContainsId(localSessions, msg.sessionId):
            return Err[bool]("vpn proxy: udp session unknown")
        var feedMsg: Hysteria2UdpMessage
        let feedRes: Result[bool] = VpnProxyUdpFragFeed(remoteFrags, msg, feedMsg)
        if IsErr(feedRes):
            return Err[bool](ErrorText(feedRes))
        if Value(feedRes):
            if !clientPeerSet:
                return Err[bool]("vpn proxy: udp client peer missing")
            var targetHost: str
            var targetPort: int32
            let targetRes: Result[bool] = VpnProxyTargetFromAddressScalars(strings.CloneStr(feedMsg.address),
                                                                           targetHost,
                                                                           targetPort)
            if IsErr(targetRes):
                return Err[bool](ErrorText(targetRes))
            var socksDatagram: VpnProxySocksUdpDatagram
            socksDatagram.fragmentId = 0
            socksDatagram.target.host = targetHost
            socksDatagram.target.port = targetPort
            var payloadCopy: Bytes = rawbytes.BytesSlice(feedMsg.payload, 0, BytesLen(feedMsg.payload))
            socksDatagram.payload = payloadCopy
            let socksWireRes: Result[Bytes] = socks.VpnProxySocksEncodeUdpDatagram(socksDatagram)
            if IsErr(socksWireRes):
                return Err[bool](ErrorText(socksWireRes))
            var sendPayloadOwned: Bytes = Value(socksWireRes)
            var sendPeer: udp.UdpSockAddr = VpnProxyCloneUdpSockAddr(clientPeerSlot[0])
            let sendRes: Result[bool] = VpnProxyUdpSocketSend(relaySocket.socket.fd,
                                                                sendPayloadOwned,
                                                                sendPeer)
            if IsErr(sendRes):
                return Err[bool](ErrorText(sendRes))
    if len(progressedSlot) > 0:
        return Ok[int32](1)
    return Ok[int32](0)
@borrows
fn VpnProxyRelayLocalUdp(conn: var tcp.TcpConnectionHandle,
                           relaySocket: VpnProxyUdpBoundSocket,
                           link: var VpnProxyQuicLink): Result[bool] =
    let nbRes: Result[bool] = tcp.TcpSetNonblocking(conn, true)
    if IsErr(nbRes):
        return Err[bool](ErrorText(nbRes))
    var clientPeerSet: bool
    var clientPeerKeySlot: str[]
    var clientPeerSlot: udp.UdpSockAddr[]
    var clientPacketId: int32
    var remoteFrags: VpnProxyUdpFragState[]
    var localSessions: VpnProxyUdpSessionTable
    VpnProxyUdpSessionTableInit(localSessions)
    while true:
        let pumpRes: Result[int32] = VpnProxyRelayUdpPumpOnce(conn,
                                                                 relaySocket,
                                                                 link,
                                                                 clientPeerSet,
                                                                 clientPeerKeySlot,
                                                                 clientPeerSlot,
                                                                 clientPacketId,
                                                                 remoteFrags,
                                                                 localSessions)
        if IsErr(pumpRes):
            var pumpErrText: str = ErrorText(pumpRes)
            return Err[bool](pumpErrText)
        let pumpState: int32 = Value(pumpRes)
        if pumpState == 2:
            return Ok[bool](true)
        if pumpState == 0:
            os.SleepMs(VpnProxyUdpRelaySleepMs)

@borrows
fn VpnProxyHandleLocalConnectWithReplies(states: var VpnProxyExitState[],
                                          identity: var VpnProxyLoadedIdentity,
                                          probeIntervalMs: int32,
                                          probeTimeoutMs: int32,
                                          conn: var tcp.TcpConnectionHandle,
                                          target: var VpnProxyTarget,
                                          okWire: var Bytes,
                                          failWire: var Bytes): Result[bool] =
    probeIntervalMs
    probeTimeoutMs
    var selectedIndex: int32 = VpnProxyBestHealthyExitForTransport(states,
                                                                   "tcp-tls-forward",
                                                                   -1)
    if selectedIndex >= 0:
        let tcpOpenRes: Result[VpnProxyTcpTlsForwardLink] = VpnProxyOpenRemoteTcpTlsFromIndex(states,
                                                                                              identity,
                                                                                              target,
                                                                                              selectedIndex)
        if IsErr(tcpOpenRes):
            let _ = VpnProxyTcpWriteAll(conn, failWire)
            return Err[bool](ErrorText(tcpOpenRes))
        var tcpLink: VpnProxyTcpTlsForwardLink = Value(tcpOpenRes)
        let tcpOkRes = VpnProxyTcpWriteAll(conn, okWire)
        if IsErr(tcpOkRes):
            VpnProxyCloseTcpTlsForwardLink(tcpLink)
            return Err[bool](ErrorText(tcpOkRes))
        let tcpRelayRes = VpnProxyRelayTcpTlsForward(conn, tcpLink)
        VpnProxyCloseTcpTlsForwardLink(tcpLink)
        if IsErr(tcpRelayRes):
            return Err[bool](ErrorText(tcpRelayRes))
        return Ok[bool](true)
    selectedIndex = routing.VpnProxyBestHealthyExit(states, -1)
    if selectedIndex < 0 && states.len > 0:
        selectedIndex = 0
    let openRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemote(states,
                                                                   identity,
                                                                   target,
                                                                   probeIntervalMs,
                                                                   probeTimeoutMs)
    if IsErr(openRes):
        let _ = VpnProxyTcpWriteAll(conn, failWire)
        return Err[bool](ErrorText(openRes))
    var link = Value(openRes)
    let okRes = VpnProxyTcpWriteAll(conn, okWire)
    if IsErr(okRes):
        VpnProxyCloseQuicLink(link)
        return Err[bool](ErrorText(okRes))
    let relayRes = VpnProxyRelayTcpQuic(conn, link.stream)
    VpnProxyCloseQuicLink(link)
    if IsErr(relayRes):
        return Err[bool](ErrorText(relayRes))
    return Ok[bool](true)

@borrows
fn VpnProxyHandleLocalConnect(states: var VpnProxyExitState[],
                                identity: var VpnProxyLoadedIdentity,
                                probeIntervalMs: int32,
                                probeTimeoutMs: int32,
                                conn: var tcp.TcpConnectionHandle,
                                target: var VpnProxyTarget): Result[bool] =
    var okWire: Bytes = VpnProxySocksReply(0)
    var failWire: Bytes = VpnProxySocksReply(VpnProxySocksReplyConnectionRefused)
    return VpnProxyHandleLocalConnectWithReplies(states,
                                                 identity,
                                                 probeIntervalMs,
                                                 probeTimeoutMs,
                                                 conn,
                                                 target,
                                                 okWire,
                                                 failWire)

@borrows
fn VpnProxyHandleLocalHttpConnect(states: var VpnProxyExitState[],
                                   identity: var VpnProxyLoadedIdentity,
                                   probeIntervalMs: int32,
                                   probeTimeoutMs: int32,
                                   conn: var tcp.TcpConnectionHandle,
                                   firstByte: int32): Result[bool] =
    var headerLen: int32
    let headerRes: Result[Bytes] = VpnProxyHttpReadConnectHeader(conn, firstByte, headerLen)
    if IsErr(headerRes):
        var failWire: Bytes = BytesAlloc(47)
        var failTemplate: Bytes = BytesFromString("HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
        rawbytes.BytesCopyInto(failWire, 0, failTemplate)
        let _ = VpnProxyTcpWriteAll(conn, failWire)
        return Err[bool](ErrorText(headerRes))
    let targetRes: Result[VpnProxyTarget] = VpnProxyHttpParseConnectTarget(Value(headerRes), headerLen)
    if IsErr(targetRes):
        var failWire: Bytes = BytesAlloc(52)
        var failTemplate: Bytes = BytesFromString("HTTP/1.1 405 Method Not Allowed\r\nContent-Length: 0\r\n\r\n")
        rawbytes.BytesCopyInto(failWire, 0, failTemplate)
        let _ = VpnProxyTcpWriteAll(conn, failWire)
        return Err[bool](ErrorText(targetRes))
    var okWire: Bytes = BytesAlloc(58)
    var okTemplate: Bytes = BytesFromString("HTTP/1.1 200 Connection Established\r\nProxy-Agent: Cheng VPN\r\n\r\n")
    rawbytes.BytesCopyInto(okWire, 0, okTemplate)
    var failWire: Bytes = VpnProxySocksReply(VpnProxySocksReplyGeneralFailure)
    var targetOwned2: VpnProxyTarget = Value(targetRes)
    return VpnProxyHandleLocalConnectWithReplies(states,
                                                 identity,
                                                 probeIntervalMs,
                                                 probeTimeoutMs,
                                                 conn,
                                                 targetOwned2,
                                                 okWire,
                                                 failWire)

@borrows
fn VpnProxyHandleLocalUdpAssociate(states: var VpnProxyExitState[],
                                     identity: var VpnProxyLoadedIdentity,
                                     probeIntervalMs: int32,
                                     probeTimeoutMs: int32,
                                     conn: var tcp.TcpConnectionHandle): Result[bool] =
    let openRes: Result[VpnProxyQuicLink] = VpnProxyOpenRemoteDatagram(states,
                                                                            identity,
                                                                            probeIntervalMs,
                                                                            probeTimeoutMs)
    if IsErr(openRes):
        var replyWire: Bytes = VpnProxySocksReply(VpnProxySocksReplyConnectionRefused)
        let _ = VpnProxyTcpWriteAll(conn, replyWire)
        return Err[bool](ErrorText(openRes))
    var link = Value(openRes)
    let socketRes: Result[VpnProxyUdpBoundSocket] = VpnProxyUdpBoundSocketOpen(conn.localAddr.host,
                                                                                    conn.localAddr.isV6)
    if IsErr(socketRes):
        VpnProxyCloseQuicLink(link)
        var replyWire: Bytes = VpnProxySocksReply(VpnProxySocksReplyGeneralFailure)
        let _ = VpnProxyTcpWriteAll(conn, replyWire)
        return Err[bool](ErrorText(socketRes))
    var relaySocket: VpnProxyUdpBoundSocket = Value(socketRes)
    let replyRes: Result[Bytes] = socks.VpnProxySocksReplyForTarget(0, relaySocket.bindTarget)
    if IsErr(replyRes):
        udp.UdpSocketClose(relaySocket.socket.fd)
        VpnProxyCloseQuicLink(link)
        var replyErrText: str = ErrorText(replyRes)
        return Err[bool](replyErrText)
    var replyWire: Bytes = Value(replyRes)
    let writeRes: Result[int32] = VpnProxyTcpWriteAll(conn, replyWire)
    if IsErr(writeRes):
        udp.UdpSocketClose(relaySocket.socket.fd)
        VpnProxyCloseQuicLink(link)
        var writeErrText: str = ErrorText(writeRes)
        return Err[bool](writeErrText)
    let relayRes: Result[bool] = VpnProxyRelayLocalUdp(conn, relaySocket, link)
    udp.UdpSocketClose(relaySocket.socket.fd)
    VpnProxyCloseQuicLink(link)
    if IsErr(relayRes):
        var relayErrText: str = ErrorText(relayRes)
        return Err[bool](relayErrText)
    return Ok[bool](true)

@borrows
fn VpnProxyHandleLocalClient(states: var VpnProxyExitState[],
                               identity: var VpnProxyLoadedIdentity,
                               probeIntervalMs: int32,
                               probeTimeoutMs: int32,
                               conn: var tcp.TcpConnectionHandle): Result[bool] =
    let firstRes: Result[Bytes] = VpnProxyTcpReadExactStopAware(conn, 1, VpnProxyConnectTimeoutMs)
    if IsErr(firstRes):
        let bodyText: str = "bad request\n"
        let _ = VpnProxyHttpWriteResponse(conn,
                                          "HTTP/1.1 400 Bad Request",
                                          "text/plain; charset=utf-8",
                                          bodyText)
        return Err[bool](ErrorText(firstRes))
    let firstByte: int32 = VpnProxyBytesRawGet(Value(firstRes), 0)
    if firstByte == 0:
        return Err[bool]("vpn proxy: local proxy stopped")
    if firstByte == int32('C'):
        return VpnProxyHandleLocalHttpConnect(states,
                                              identity,
                                              probeIntervalMs,
                                              probeTimeoutMs,
                                              conn,
                                              firstByte)
    if firstByte == int32('G'):
        return VpnProxyHandleLocalPacRequest(conn, firstByte)
    if firstByte != VpnProxySocksVersion:
        return Err[bool]("vpn proxy local: expected SOCKS5, HTTP CONNECT, or PAC GET")
    let methodRes = VpnProxySocksMethodHandshakeWithVersion(conn, firstByte)
    if IsErr(methodRes):
        return Err[bool](ErrorText(methodRes))
    let requestRes: Result[VpnProxySocksRequest] = VpnProxySocksReadRequest(conn)
    if IsErr(requestRes):
        return Err[bool](ErrorText(requestRes))
    var request: VpnProxySocksRequest = Value(requestRes)
    if request.cmd == VpnProxySocksCmdConnect:
        var requestTarget: VpnProxyTarget = request.target
        return VpnProxyHandleLocalConnect(states,
                                            identity,
                                            probeIntervalMs,
                                            probeTimeoutMs,
                                            conn,
                                            requestTarget)
    if request.cmd == VpnProxySocksCmdUdpAssoc:
        return VpnProxyHandleLocalUdpAssociate(states,
                                                 identity,
                                                 probeIntervalMs,
                                                 probeTimeoutMs,
                                                 conn)
    return Err[bool]("vpn proxy socks5: unsupported command")

fn VpnProxyLocalProxyStopAndClose(listener: var tcp.TcpListenerHandle): Result[bool] =
    tcp.TcpListenerClose(listener)
    return Ok[bool](true)

@borrows
fn VpnProxyCloneStr(text: str): str =
    if len(text) <= 0:
        return ""
    return NewStringCopy(StrDataPtr(text), StrLenFast(text))

@borrows
fn VpnProxyCloneStrArray(items: var str[]): str[] =
    var out: str[]
    for i in 0..<items.len:
        add(out, VpnProxyCloneStr(items[i]))
    return out

@borrows
fn VpnProxyCloneBytes(data: Bytes): Bytes =
    return BytesSlice(data, 0, BytesLen(data))

fn VpnProxyCloneBytesArray(items: var Bytes[]): Bytes[] =
    var out: Bytes[]
    for i in 0..<items.len:
        add(out, VpnProxyCloneBytes(items[i]))
    return out

@borrows
fn VpnProxyCloneExitConfig(cfg: var VpnProxyExitConfig): VpnProxyExitConfig =
    var out: VpnProxyExitConfig
    out.name = VpnProxyCloneStr(cfg.name)
    out.transport = VpnProxyCloneStr(cfg.transport)
    out.host = VpnProxyCloneStr(cfg.host)
    out.port = cfg.port
    out.serverName = VpnProxyCloneStr(cfg.serverName)
    out.authority = VpnProxyCloneStr(cfg.authority)
    out.auth = VpnProxyCloneStr(cfg.auth)
    out.ccRx = cfg.ccRx
    out.weight = cfg.weight
    out.dialerProxy = VpnProxyCloneStr(cfg.dialerProxy)
    return out

@borrows
fn VpnProxyCloneExitState(state: VpnProxyExitState): VpnProxyExitState =
    var out: VpnProxyExitState
    out.cfg = VpnProxyCloneExitConfig(state.cfg)
    out.sendClientCertificate = state.sendClientCertificate
    out.healthy = state.healthy
    out.ewmaMs = state.ewmaMs
    out.probeFailures = state.probeFailures
    out.recoverySuccesses = state.recoverySuccesses
    out.recentOpenFail0Ms = state.recentOpenFail0Ms
    out.recentOpenFail1Ms = state.recentOpenFail1Ms
    out.lastProbeMs = state.lastProbeMs
    out.lastSampleMs = state.lastSampleMs
    out.lastError = VpnProxyCloneStr(state.lastError)
    return out

fn VpnProxyStoreExitStateAt(states: var VpnProxyExitState[], idx: int32, s: VpnProxyExitState) =
    states[idx].cfg.name = VpnProxyCloneStr(s.cfg.name)
    states[idx].cfg.transport = VpnProxyCloneStr(s.cfg.transport)
    states[idx].cfg.host = VpnProxyCloneStr(s.cfg.host)
    states[idx].cfg.port = s.cfg.port
    states[idx].cfg.serverName = VpnProxyCloneStr(s.cfg.serverName)
    states[idx].cfg.authority = VpnProxyCloneStr(s.cfg.authority)
    states[idx].cfg.auth = VpnProxyCloneStr(s.cfg.auth)
    states[idx].cfg.ccRx = s.cfg.ccRx
    states[idx].cfg.weight = s.cfg.weight
    states[idx].cfg.dialerProxy = VpnProxyCloneStr(s.cfg.dialerProxy)
    states[idx].sendClientCertificate = s.sendClientCertificate
    states[idx].healthy = s.healthy
    states[idx].ewmaMs = s.ewmaMs
    states[idx].probeFailures = s.probeFailures
    states[idx].recoverySuccesses = s.recoverySuccesses
    states[idx].recentOpenFail0Ms = s.recentOpenFail0Ms
    states[idx].recentOpenFail1Ms = s.recentOpenFail1Ms
    states[idx].lastProbeMs = s.lastProbeMs
    states[idx].lastSampleMs = s.lastSampleMs
    states[idx].lastError = VpnProxyCloneStr(s.lastError)

@borrows
fn VpnProxyCloneExitStates(states: var VpnProxyExitState[]): VpnProxyExitState[] =
    var out: VpnProxyExitState[]
    for i in 0..<states.len:
        add(out, VpnProxyCloneExitState(states[i]))
    return out

@borrows
fn VpnProxyCloneLoadedIdentity(identity: var VpnProxyLoadedIdentity): VpnProxyLoadedIdentity =
    var out: VpnProxyLoadedIdentity
    out.certs = VpnProxyCloneBytesArray(identity.certs)
    out.privateKey = VpnProxyCloneBytes(identity.privateKey)
    out.leafKeyKind = identity.leafKeyKind
    out.trustRoots = VpnProxyCloneBytesArray(identity.trustRoots)
    return out

fn VpnProxyLocalWorkerLoadState(states: var VpnProxyExitState[],
                                identity: var VpnProxyLoadedIdentity): Result[bool] =
    var configPath: str = VpnProxyCloneStr(VpnProxyLocalWorkerConfigPath)
    let configRes: Result[VpnProxyConfig] = VpnProxyLoadConfig(configPath)
    if IsErr(configRes):
        return Err[bool](ErrorText(configRes))
    var config: VpnProxyConfig = Value(configRes)
    let identityRes: Result[VpnProxyLoadedIdentity] = VpnProxyLoadIdentity(config.configDir, config.client, true)
    if IsErr(identityRes):
        return Err[bool](ErrorText(identityRes))
    for i in 0..<config.exits.len:
        let exitCfgRes: Result[bool] = VpnProxyRequireExitClientConfig(config.exits[i])
        if IsErr(exitCfgRes):
            return Err[bool](ErrorText(exitCfgRes))
    identity = Value(identityRes)
    states = routing.VpnProxyInitExitStatesWithClientCertificate(config.exits,
                                                                  VpnProxyConfigSendsClientCertificate(config))
    return Ok[bool](true)

fn VpnProxyLocalClientWorkerMain(raw: ptr) =
    if raw == nil:
        return
    let encodedFd: uint64 = uint64(raw)
    if encodedFd == uint64(0):
        return
    var conn: tcp.TcpConnectionHandle
    conn.fd = int32(encodedFd) - 1
    conn.open = true
    conn.localAddr.host = VpnProxyCloneStr(VpnProxyLocalWorkerListenHost)
    conn.localAddr.port = VpnProxyLocalWorkerListenPort
    conn.localAddr.isV6 = VpnProxyLocalWorkerListenIsV6
    var states: VpnProxyExitState[]
    var identity: VpnProxyLoadedIdentity
    let loadRes = VpnProxyLocalWorkerLoadState(states, identity)
    if IsErr(loadRes):
        VpnProxyPrintErr(ErrorText(loadRes))
        tcp.TcpClose(conn)
        return
    let handleRes = VpnProxyHandleLocalClient(states,
                                             identity,
                                             VpnProxyLocalWorkerProbeIntervalMs,
                                             VpnProxyLocalWorkerProbeTimeoutMs,
                                             conn)
    tcp.TcpClose(conn)
    if IsErr(handleRes):
        if ErrorText(handleRes) != "vpn proxy: local proxy stopped":
            VpnProxyPrintErr(ErrorText(handleRes))

fn VpnProxyStartLocalClientWorker(conn: var tcp.TcpConnectionHandle,
                                  workerThreads: var thread.Thread[],
                                  joinWorker: bool): Result[bool] =
    if conn.fd < 0:
        return Err[bool]("vpn proxy local: invalid accepted client fd")
    let acceptedFd: int32 = conn.fd
    let encodedFd: uint64 = uint64(acceptedFd + 1)
    let worker = thread.StartPtr(&VpnProxyLocalClientWorkerMain, ptr(encodedFd))
    if worker == nil:
        return Err[bool]("vpn proxy local: worker start failed")
    conn.fd = -1
    conn.open = false
    if joinWorker:
        add(workerThreads, worker)
        return Ok[bool](true)
    if !thread.Detach(worker):
        return Err[bool]("vpn proxy local: worker detach failed")
    return Ok[bool](true)

fn VpnProxyJoinLocalClientWorkers(workerThreads: var thread.Thread[]): Result[bool] =
    for ti in 0..<workerThreads.len:
        if !thread.JoinThread(workerThreads[ti]):
            return Err[bool]("vpn proxy local: worker join failed")
    return Ok[bool](true)

fn VpnProxyLocalProxyCloseAndJoin(listener: var tcp.TcpListenerHandle,
                                  workerThreads: var thread.Thread[]): Result[bool] =
    tcp.TcpListenerClose(listener)
    return VpnProxyJoinLocalClientWorkers(workerThreads)

@borrows
fn VpnProxyRunLocalProxyOnListener(states: var VpnProxyExitState[],
                                   identity: var VpnProxyLoadedIdentity,
                                   opts: VpnProxyCliOptions,
                                   listener: var tcp.TcpListenerHandle): Result[bool] =
    let nonblockingRes: Result[bool] = tcp.TcpListenerSetNonblocking(listener, true)
    if IsErr(nonblockingRes):
        tcp.TcpListenerClose(listener)
        return Err[bool](ErrorText(nonblockingRes))
    if !VpnProxyWriteReadyPort(opts.readyPath, listener.addr.port):
        tcp.TcpListenerClose(listener)
        return Err[bool]("vpn proxy: failed to write ready path")
    var served: int32
    while opts.acceptCount <= 0 || served < opts.acceptCount:
        if VpnProxyLocalProxyShouldStop():
            return VpnProxyLocalProxyStopAndClose(listener)
        let readyRes: Result[bool] = tcp.TcpListenerWaitReadable(listener, 250)
        if IsErr(readyRes):
            if VpnProxyLocalProxyShouldStop():
                return VpnProxyLocalProxyStopAndClose(listener)
            tcp.TcpListenerClose(listener)
            return Err[bool](ErrorText(readyRes))
        if !Value(readyRes):
            continue
        let acceptRes: Result[tcp.TcpConnectionHandle] = tcp.TcpAcceptNonblocking(listener)
        if IsErr(acceptRes):
            let acceptErrView: str = ErrorText(acceptRes)
            if VpnProxyLocalProxyShouldStop():
                return VpnProxyLocalProxyStopAndClose(listener)
            if acceptErrView != "tcp syscall: would block":
                tcp.TcpListenerClose(listener)
                var acceptErrOwned: str = strings.CloneStr(acceptErrView)
                return Err[bool](acceptErrOwned)
            continue
        var conn: tcp.TcpConnectionHandle = Value(acceptRes)
        var identityForClient: VpnProxyLoadedIdentity = VpnProxyCloneLoadedIdentityForCall(identity)
        let handleRes = VpnProxyHandleLocalClient(states,
                                                  identityForClient,
                                                  opts.probeIntervalMs,
                                                  opts.probeTimeoutMs,
                                                  conn)
        tcp.TcpClose(conn)
        if IsErr(handleRes):
            if ErrorText(handleRes) == "vpn proxy: local proxy stopped":
                return VpnProxyLocalProxyStopAndClose(listener)
            VpnProxyRecordLocalProxyClientError(ErrorText(handleRes))
        served = served + 1
    tcp.TcpListenerClose(listener)
    return Ok[bool](true)

@borrows
fn VpnProxyRunLocalProxyOnListenerThreaded(states: var VpnProxyExitState[],
                                           identity: var VpnProxyLoadedIdentity,
                                           opts: VpnProxyCliOptions,
                                           listener: var tcp.TcpListenerHandle): Result[bool] =
    states
    identity
    VpnProxyLocalWorkerConfigPath = opts.configPath
    VpnProxyLocalWorkerListenHost = listener.addr.host
    VpnProxyLocalWorkerListenPort = listener.addr.port
    VpnProxyLocalWorkerListenIsV6 = listener.addr.isV6
    VpnProxyLocalWorkerProbeIntervalMs = opts.probeIntervalMs
    VpnProxyLocalWorkerProbeTimeoutMs = opts.probeTimeoutMs
    let nonblockingRes: Result[bool] = tcp.TcpListenerSetNonblocking(listener, true)
    if IsErr(nonblockingRes):
        tcp.TcpListenerClose(listener)
        return Err[bool](ErrorText(nonblockingRes))
    if !VpnProxyWriteReadyPort(opts.readyPath, listener.addr.port):
        tcp.TcpListenerClose(listener)
        return Err[bool]("vpn proxy: failed to write ready path")
    var workerThreads: thread.Thread[]
    let joinWorkers: bool = opts.acceptCount > 0
    var served: int32
    while opts.acceptCount <= 0 || served < opts.acceptCount:
        if VpnProxyLocalProxyShouldStop():
            return VpnProxyLocalProxyCloseAndJoin(listener, workerThreads)
        let readyRes: Result[bool] = tcp.TcpListenerWaitReadable(listener, 250)
        if IsErr(readyRes):
            if VpnProxyLocalProxyShouldStop():
                return VpnProxyLocalProxyCloseAndJoin(listener, workerThreads)
            tcp.TcpListenerClose(listener)
            let _ = VpnProxyJoinLocalClientWorkers(workerThreads)
            return Err[bool](ErrorText(readyRes))
        if !Value(readyRes):
            continue
        let acceptRes: Result[tcp.TcpConnectionHandle] = tcp.TcpAcceptNonblocking(listener)
        if IsErr(acceptRes):
            let acceptErr: str = ErrorText(acceptRes)
            if VpnProxyLocalProxyShouldStop():
                return VpnProxyLocalProxyCloseAndJoin(listener, workerThreads)
            if acceptErr != "tcp syscall: would block":
                tcp.TcpListenerClose(listener)
                let _ = VpnProxyJoinLocalClientWorkers(workerThreads)
                return Err[bool](strings.CloneStr(acceptErr))
            continue
        var conn: tcp.TcpConnectionHandle = Value(acceptRes)
        let workerRes = VpnProxyStartLocalClientWorker(conn,
                                                       workerThreads,
                                                       joinWorkers)
        if IsErr(workerRes):
            tcp.TcpClose(conn)
            tcp.TcpListenerClose(listener)
            let _ = VpnProxyJoinLocalClientWorkers(workerThreads)
            return Err[bool](ErrorText(workerRes))
        served = served + 1
    return VpnProxyLocalProxyCloseAndJoin(listener, workerThreads)

fn VpnProxyLocal(rootDir: str, args: str[]): int32 =
    rootDir
    var opts: VpnProxyCliOptions
    cli.VpnProxyOptionsFillInto(args, opts)
    let configRes: Result[VpnProxyConfig] = VpnProxyLoadConfig(opts.configPath)
    if IsErr(configRes):
        VpnProxyPrintErr(ErrorText(configRes))
        return 1
    var config = Value(configRes)
    opts.configPath = config.configPath
    if config.protocol == "hy2-tun-v1":
        let protocolRes: Result[bool] = VpnProxyPrepareHy2TunLocalClient(config)
        if IsErr(protocolRes):
            VpnProxyPrintErr(ErrorText(protocolRes))
            return 1
        VpnProxyPrintLine("vpn-proxy protocol hy2-tun-v1")
    if config.exits.len <= 0:
        VpnProxyPrintErr("vpn proxy config: exits[] missing")
        return 1
    let requireClientListen: bool = config.protocol != "hy2-tun-v1"
    let identityRes = VpnProxyLoadIdentity(config.configDir, config.client, requireClientListen)
    if IsErr(identityRes):
        VpnProxyPrintErr(ErrorText(identityRes))
        return 1
    var identity = Value(identityRes)
    for i in 0..<config.exits.len:
        let exitCfgRes: Result[bool] = VpnProxyRequireExitClientConfig(config.exits[i])
        if IsErr(exitCfgRes):
            VpnProxyPrintErr(ErrorText(exitCfgRes))
            return 1
    if config.protocol == "hy2-tun-v1":
        var states: VpnProxyExitState[]
        states = routing.VpnProxyInitExitStatesWithClientCertificate(config.exits,
                                                                      VpnProxyConfigSendsClientCertificate(config))
        VpnProxyProbeAll(states, identity, opts.probeTimeoutMs)
        let tunRes: Result[bool] = VpnProxyRunTunLocal(states, identity, opts)
        VpnProxyTunCleanupDarwin(VpnProxyTunActiveName)
        if IsErr(tunRes):
            VpnProxyPrintErr(ErrorText(tunRes))
            return 1
        return 0
    var listenHost = ""
    var listenPort: int32
    let listenText: str = config.client.listen
    if len(listenText) <= 0:
        VpnProxyPrintErr("vpn proxy: empty listen address")
        return 1
    let listenParsedRes: Result[listen.VpnProxyListenAddress] = listen.VpnProxyParseListenAddress(strings.CloneStr(listenText))
    if IsErr(listenParsedRes):
        VpnProxyPrintErr(ErrorText(listenParsedRes))
        return 1
    let listenParsed: listen.VpnProxyListenAddress = Value(listenParsedRes)
    listenHost = listenParsed.host
    listenPort = listenParsed.port
    var states: VpnProxyExitState[]
    states = routing.VpnProxyInitExitStatesWithClientCertificate(config.exits,
                                                                  VpnProxyConfigSendsClientCertificate(config))
    var listenIsV6: bool
    if len(listenText) > 0:
        listenIsV6 = int32(listenText[0]) == 91
    var listener: tcp.TcpListenerHandle
    let listenTcpRes: Result[bool] = tcp.TcpListenFill(listenHost, listenPort, listener, listenIsV6)
    if IsErr(listenTcpRes):
        VpnProxyPrintErr(ErrorText(listenTcpRes))
        return 1
    VpnProxyPrintLine(strutil.Join(["vpn-proxy local listening ", listenHost, ":", IntToStr(listener.addr.port)], ""))
    let runRes: Result[bool] = VpnProxyRunLocalProxyOnListenerThreaded(states,
                                                                       identity,
                                                                       opts,
                                                                       listener)
    if IsErr(runRes):
        VpnProxyPrintErr(ErrorText(runRes))
        return 1
    return 0

fn VpnProxyHandleExitTcpStream(stream: var VpnProxyHy2TcpStream,
                                 req: hy2.Hysteria2TcpRequest): Result[bool] =
    if req.address == VpnProxyHy2ProbeAddress:
        var emptyPadding: Bytes
        emptyPadding.data = nil
        emptyPadding.len = 0
        let probeOkRes: Result[bool] = hy2sess.VpnProxyHy2TcpStreamWriteResponse(stream,
                                                                                    true,
                                                                                    "",
                                                                                    emptyPadding)
        if IsErr(probeOkRes):
            return Err[bool](ErrorText(probeOkRes))
        return Ok[bool](true)
    let targetWireRes: Result[VpnProxyTarget] = VpnProxyTargetFromAddress(strings.CloneStr(req.address))
    if IsErr(targetWireRes):
        var emptyPadding: Bytes
        emptyPadding.data = nil
        emptyPadding.len = 0
        let _ = hy2sess.VpnProxyHy2TcpStreamWriteResponse(stream,
                                                            false,
                                                            ErrorText(targetWireRes),
                                                            emptyPadding)
        return Err[bool](ErrorText(targetWireRes))
    var targetRes: Result[tcp.TcpConnectionHandle]
    targetRes = VpnProxyConnectTargetTcp(Value(targetWireRes))
    if IsErr(targetRes):
        var emptyPadding: Bytes
        emptyPadding.data = nil
        emptyPadding.len = 0
        let _ = hy2sess.VpnProxyHy2TcpStreamWriteResponse(stream,
                                                            false,
                                                            ErrorText(targetRes),
                                                            emptyPadding)
        return Err[bool](ErrorText(targetRes))
    var targetConn = Value(targetRes)
    var emptyPadding: Bytes
    emptyPadding.data = nil
    emptyPadding.len = 0
    let okRes: Result[bool] = hy2sess.VpnProxyHy2TcpStreamWriteResponse(stream,
                                                                          true,
                                                                          "",
                                                                          emptyPadding)
    if IsErr(okRes):
        tcp.TcpClose(targetConn)
        return Err[bool](ErrorText(okRes))
    let relayRes = VpnProxyRelayTcpQuic(targetConn, stream)
    tcp.TcpClose(targetConn)
    hy2sess.VpnProxyHy2TcpStreamClose(stream)
    if IsErr(relayRes):
        return Err[bool](ErrorText(relayRes))
    return Ok[bool](true)

@borrows
fn VpnProxyTcpTlsServerAcceptHandshake(conn: var tcp.TcpConnectionHandle,
                                       identity: var VpnProxyLoadedIdentity): Result[VpnProxyTcpTlsForwardLink] =
    var out: VpnProxyTcpTlsForwardLink
    let fillRes: Result[bool] = VpnProxyTcpTlsServerAcceptHandshakeInto(conn, identity, out)
    if IsErr(fillRes):
        return Err[VpnProxyTcpTlsForwardLink](ErrorText(fillRes))
    return Ok[VpnProxyTcpTlsForwardLink](out)

@borrows
fn VpnProxyTcpTlsServerAcceptHandshakeIntoUnlocked(conn: var tcp.TcpConnectionHandle,
                                                   identity: var VpnProxyLoadedIdentity,
                                                   out: var VpnProxyTcpTlsForwardLink): Result[bool] =
    var policy: qpolicy.MsQuicTlsPolicy
    let policyRes: Result[bool] = VpnProxyBuildPolicyInto(policy,
                                                          identity,
                                                          "vpn-proxy.exit",
                                                          false,
                                                          false)
    if IsErr(policyRes):
        return Err[bool](ErrorText(policyRes))
    var clientHelloRecord: Bytes
    let chT0: int64 = VpnProxyMonoNowMs()
    # [lockfix] 读 CH 在锁外(纯网络), 锁只包全局状态的 crypto 段。
    let clientHelloRecordRes: Result[bool] = VpnProxyTcpTlsReadRecordInto(conn, clientHelloRecord)
    if IsErr(clientHelloRecordRes):
        return Err[bool](ErrorText(clientHelloRecordRes))
    let chWaitMs: int64 = VpnProxyMonoNowMs() - chT0
    let buildT0: int64 = VpnProxyMonoNowMs()
    VpnProxyTcpTlsHandshakeLock()
    var flight: tlshs.VpnProxyTcpTlsServerFlight
    let flightRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardServerBuildFlightInto(clientHelloRecord,
                                                                                   policy,
                                                                                   flight)
    if IsErr(flightRes):
        VpnProxyTcpTlsHandshakeUnlock()
        return Err[bool](ErrorText(flightRes))
    # [psk-resume] read inside the lock: server global state is only stable here.
    let resumedAccepted: bool = tlshs.msquicTls13ServerPskAccepted()
    VpnProxyTcpTlsHandshakeUnlock()
    let buildMs: int64 = VpnProxyMonoNowMs() - buildT0
    var serverHelloRecord: Bytes = flight.serverHelloRecord
    let shWriteRes: Result[bool] = VpnProxyTcpTlsWriteRecord(conn, serverHelloRecord)
    if IsErr(shWriteRes):
        return Err[bool](ErrorText(shWriteRes))
    var encryptedFlightRecord: Bytes = flight.encryptedHandshakeRecord
    let flightWriteRes: Result[bool] = VpnProxyTcpTlsWriteRecord(conn, encryptedFlightRecord)
    if IsErr(flightWriteRes):
        return Err[bool](ErrorText(flightWriteRes))
    let finT0: int64 = VpnProxyMonoNowMs()
    var clientFinishedRecord: Bytes
    let clientFinishedRecordRes: Result[bool] = VpnProxyTcpTlsReadRecordInto(conn, clientFinishedRecord)
    if IsErr(clientFinishedRecordRes):
        return Err[bool](ErrorText(clientFinishedRecordRes))
    let finWaitMs: int64 = VpnProxyMonoNowMs() - finT0
    VpnProxyTcpTlsHandshakeLock()
    let finishRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardServerProcessClientFinished(clientFinishedRecord)
    if IsErr(finishRes):
        VpnProxyTcpTlsHandshakeUnlock()
        return Err[bool](ErrorText(finishRes))
    VpnProxyTcpTlsHandshakeUnlock()
    var resumedText: str = "0"
    if resumedAccepted:
        resumedText = "1"
    VpnProxyPrintLine(strutil.Join(["hs_metrics ch_wait_ms=", strings.Int64ToStr(chWaitMs),
                                    " build_ms=", strings.Int64ToStr(buildMs),
                                    " fin_wait_ms=", strings.Int64ToStr(finWaitMs),
                                    " resumed=", resumedText], ""))
    let sendKeysRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardServerAppSendKeysInto(out.sendKeys)
    if IsErr(sendKeysRes):
        return Err[bool](ErrorText(sendKeysRes))
    let recvKeysRes: Result[bool] = tlshs.VpnProxyTcpTlsForwardServerAppRecvKeysInto(out.recvKeys)
    if IsErr(recvKeysRes):
        return Err[bool](ErrorText(recvKeysRes))
    out.conn = conn
    out.streamId = 1
    out.open = true
    out.exitIndex = -1
    return Ok[bool](true)

@borrows
fn VpnProxyTcpTlsServerAcceptHandshakeInto(conn: var tcp.TcpConnectionHandle,
                                           identity: var VpnProxyLoadedIdentity,
                                           out: var VpnProxyTcpTlsForwardLink): Result[bool] =
    # [lockfix] 锁已内移到 Unlocked 的 crypto 段, 网络 IO 不再持锁。
    let res: Result[bool] = VpnProxyTcpTlsServerAcceptHandshakeIntoUnlocked(conn,
                                                                            identity,
                                                                            out)
    return res

fn VpnProxyRelayExitDecryptRecord(link: var VpnProxyTcpTlsForwardLink,
                                    record: Bytes,
                                    plain: var tlsrec.VpnProxyTcpTlsRecordPlain): Result[bool] =
    return tlsrec.VpnProxyTcpTlsRecordDecryptInto(link.recvKeys, record, plain)

fn VpnProxyRelayJoinPending(pendingData: ptr, pendingLen: int32, buf: Bytes, got: int32): Bytes =
    # [x86 relay-hunt] CLT 路径的分配/拼接收进此小函数: 大函数内联优化对
    # Bytes 局部槽的复用在 x86 产物中产出悬垂副本 (BFMISS len=0)。
    # pending 以标量 (ptr,len) 传入: link 字段非 address-free, 不可按 byval
    # Bytes 聚合拷出 (审计: plain local copy)。
    var pendingView: Bytes
    pendingView.data = pendingData
    pendingView.len = pendingLen
    var chunk: Bytes = BytesAlloc(got)
    var cpIdx: int32
    while cpIdx < got:
        BytesSet(chunk, cpIdx, BytesGet(buf, cpIdx) & 255)
        cpIdx = cpIdx + 1
    var joined: Bytes = VpnProxyBytesConcat(pendingView, chunk)
    BytesFree(chunk)
    return joined

# ===========================================================================
# [mux] 服务端多流复用: 一条 TCP-TLS 隧道承载多个 TCP 流。
# AUTH 之后进入帧分发循环: OPEN→连目标→OpenOk→入流表; DATA→按 streamId
# 写对应 targetConn; CLOSE→关对应 targetConn; PROBE→ProbeOk(池排水/保活)。
# 向后兼容: 旧单流客户端(一次 OPEN + streamId=1)在同一循环里行为不变,
# 只是 conn 生命周期延至隧道 EOF。
# 形状纪律(aarch64 三禁忌): 流表=局部 var managed seq, 只做元素顶层字段
# 读写(同 tcpLinks 泵), 禁元素投影 var 传参; pending 拼接/裁剪一律 byval
# 标量进/Result 出(VpnProxyRelayJoinPending 同款) + 整 Bytes 字段写回;
# 记录/帧 payload 解码后立即 owned 拷贝(旧 relay 同款)。
# ===========================================================================
@borrows
fn VpnProxyMuxStreamFindIndex(streams: VpnProxyTcpTlsStreamEntry[], streamId: int32): int32 =
    for i in 0..<streams.len:
        if streams[i].active && streams[i].streamId == streamId:
            return i
    return -1

# [mux] DATA 追加小助手: 元素 pending 读改收敛在本小函数(大函数体内
# 循环+元素读触发冷审计 plain-local-copy 误杀)。
fn VpnProxyMuxStreamAppendIn(link: var VpnProxyTcpTlsForwardLink,
                             streams: var VpnProxyTcpTlsStreamEntry[],
                             idx: int32,
                             chunk: Bytes): Result[bool] =
    var pendLocal: Bytes = streams[idx].inPending
    var joined: Bytes = VpnProxyRelayJoinPending(pendLocal.data, pendLocal.len, chunk, BytesLen(chunk))
    BytesFree(pendLocal)
    streams[idx].inPending = joined
    # [mux] 慢流背压保护: 对端不排空的流超限即弃(双 EOF 标记交收割路径
    # 统一释放, 不在分支内 free/重置元素 Bytes)。
    if BytesLen(streams[idx].inPending) > VpnProxyMuxStreamPendingCap:
        streams[idx].readClosed = true
        streams[idx].remoteClosed = true
        let capCloseRes: Result[bool] = VpnProxyMuxServerWriteStreamClose(link, streams[idx].streamId)
        return capCloseRes
    return Ok[bool](true)

fn VpnProxyMuxStreamRemoveAt(streams: var VpnProxyTcpTlsStreamEntry[], dropIdx: int32) =
    if dropIdx >= 0 && dropIdx < streams.len:
        if BytesLen(streams[dropIdx].inPending) > 0:
            BytesFree(streams[dropIdx].inPending)
        if BytesLen(streams[dropIdx].outPending) > 0:
            BytesFree(streams[dropIdx].outPending)
        streams[dropIdx].inPending = BytesAlloc(0)
        streams[dropIdx].outPending = BytesAlloc(0)
        if streams[dropIdx].targetOpen:
            var deadConn: tcp.TcpConnectionHandle
            deadConn.fd = streams[dropIdx].targetFd
            deadConn.open = true
            tcp.TcpClose(deadConn)
        streams[dropIdx].targetFd = -1
        streams[dropIdx].targetOpen = false
        streams[dropIdx].active = false
    var kept: VpnProxyTcpTlsStreamEntry[]
    for i in 0..<streams.len:
        if i != dropIdx:
            var keptEntry: VpnProxyTcpTlsStreamEntry = streams[i]
            add(kept, keptEntry)
    streams = kept

fn VpnProxyMuxServerWriteStreamData(link: var VpnProxyTcpTlsForwardLink,
                                    streamId: int32,
                                    chunk: Bytes): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildDataFrameInto(streamId, chunk, wire)
    if buildRes <= 0:
        return Err[bool]("tcp-tls-forward: data frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, wire)
    BytesFree(wire)
    return writeRes

fn VpnProxyMuxServerWriteStreamClose(link: var VpnProxyTcpTlsForwardLink,
                                     streamId: int32): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildCloseFrameInto(streamId, wire)
    if buildRes <= 0:
        return Err[bool]("tcp-tls-forward: close frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, wire)
    BytesFree(wire)
    return writeRes

fn VpnProxyMuxServerWriteStreamOpenOk(link: var VpnProxyTcpTlsForwardLink,
                                      streamId: int32): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenOkFrameInto(streamId, wire)
    if buildRes <= 0:
        return Err[bool]("tcp-tls-forward: open-ok frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, wire)
    BytesFree(wire)
    return writeRes

fn VpnProxyMuxServerWriteStreamOpenError(link: var VpnProxyTcpTlsForwardLink,
                                         streamId: int32,
                                         errorText: str): Result[bool] =
    var wire: Bytes
    let buildRes: int32 = ttf.VpnProxyTcpTlsForwardBuildOpenErrorFrameInto(streamId,
                                                                           errorText,
                                                                           wire)
    if buildRes <= 0:
        return Err[bool]("tcp-tls-forward: open-error frame build failed")
    let writeRes: Result[bool] = VpnProxyTcpTlsWriteFrame(link, wire)
    BytesFree(wire)
    return writeRes

# [mux] OPEN 帧处理小助手: OpenOk→拨 target→入流表。失败返回 Err(隧道级)。
@borrows
fn VpnProxyMuxHandleOpenFrame(link: var VpnProxyTcpTlsForwardLink,
                              streams: var VpnProxyTcpTlsStreamEntry[],
                              streamId: int32,
                              targetText: str,
                              muxOpens: var int32): Result[bool] =
    if streams.len >= 64:
        return VpnProxyMuxServerWriteStreamOpenError(link, streamId, "vpn proxy tcp-tls-forward: mux stream limit")
    let targetRes: Result[VpnProxyTarget] = VpnProxyTargetFromAddress(strings.CloneStr(targetText))
    if IsErr(targetRes):
        VpnProxyPrintErr(ErrorText(targetRes))
        return VpnProxyMuxServerWriteStreamOpenError(link, streamId, ErrorText(targetRes))
    # [optimistic-open] 先回 OpenOk 再连 target(旧单流路径同款): 该流的
    # ClientHello 堆在隧道内核缓冲, relay 起来后自然排空。
    let okWriteRes: Result[bool] = VpnProxyMuxServerWriteStreamOpenOk(link, streamId)
    if IsErr(okWriteRes):
        return Err[bool](ErrorText(okWriteRes))
    let targetConnRes: Result[tcp.TcpConnectionHandle] = VpnProxyConnectTargetTcp(Value(targetRes))
    if IsErr(targetConnRes):
        VpnProxyPrintErr(ErrorText(targetConnRes))
        return VpnProxyMuxServerWriteStreamClose(link, streamId)
    var connNew: tcp.TcpConnectionHandle = Value(targetConnRes)
    let _ = tcp.TcpSetNoDelay(connNew, true)
    var entry: VpnProxyTcpTlsStreamEntry
    entry.streamId = streamId
    entry.targetFd = connNew.fd
    entry.targetOpen = connNew.open
    entry.active = true
    entry.inPending = BytesAlloc(0)
    entry.outPending = BytesAlloc(0)
    add(streams, entry)
    muxOpens = muxOpens + 1
    VpnProxyPrintErr(strutil.Join(["MUXOPEN fd=", strings.Int64ToStr(int64(link.conn.fd)),
                                    " stream=", strings.Int64ToStr(int64(streamId)),
                                    " target=", strings.CloneStr(targetText),
                                    " active=", strings.Int64ToStr(int64(streams.len)),
                                    " opens=", strings.Int64ToStr(int64(muxOpens))], ""))
    return Ok[bool](true)

# [mux] 每流泵小助手: target 读 / target 写 / 隧道写回 / 关闭传播。
# 形状纪律: 元素字段读写收敛在本小函数(冷审计/探针 bless 形状), 大循环
# 只留标量状态。返回: 0=无进展 1=有进展 2=该流已死需收割 3=隧道级致命。
fn VpnProxyMuxPumpStream(link: var VpnProxyTcpTlsForwardLink,
                         streams: var VpnProxyTcpTlsStreamEntry[],
                         si: int32,
                         tunnelDead: bool): int32 =
    var code: int32
    var tc: tcp.TcpConnectionHandle
    tc.fd = streams[si].targetFd
    tc.open = streams[si].targetOpen
    if !streams[si].readClosed:
        let targetReadable: int32 = VpnProxyFdWaitReadable(tc.fd, 0)
        if targetReadable < 0:
            return 3
        if targetReadable > 0:
            var readBuf: Bytes = BytesAlloc(VpnProxyRelayChunkBytes)
            let readRes: Result[int32] = tcp.TcpRecvRawNonblocking(tc, readBuf.data, BytesLen(readBuf))
            if IsErr(readRes):
                BytesFree(readBuf)
                if ErrorText(readRes) != "tcp syscall: would block":
                    streams[si].targetFd = tc.fd
                    streams[si].targetOpen = tc.open
                    return 3
            else:
                let got: int32 = Value(readRes)
                if got <= 0:
                    BytesFree(readBuf)
                    # [thruput] target EOF: CLOSE 推迟到 outPending 排空后。
                    streams[si].readClosed = true
                    code = 1
                else:
                    var outLocal: Bytes = streams[si].outPending
                    var joinedOut: Bytes = VpnProxyRelayJoinPending(outLocal.data,
                                                                     outLocal.len,
                                                                     readBuf,
                                                                     got)
                    BytesFree(outLocal)
                    BytesFree(readBuf)
                    streams[si].outPending = joinedOut
                    code = 1
    var inLocal: Bytes = streams[si].inPending
    if BytesLen(inLocal) > 0:
        let targetWritable: int32 = VpnProxyFdWaitWritable(tc.fd, 1)
        if targetWritable < 0:
            streams[si].targetFd = tc.fd
            streams[si].targetOpen = tc.open
            return 3
        if targetWritable > 0:
            let sendRes: Result[int32] = tcp.TcpSendRawNonblocking(tc, inLocal.data, BytesLen(inLocal))
            if IsErr(sendRes):
                if ErrorText(sendRes) != "tcp syscall: would block":
                    streams[si].targetFd = tc.fd
                    streams[si].targetOpen = tc.open
                    return 3
            else:
                let sent: int32 = Value(sendRes)
                if sent > 0:
                    var trimLen: int32 = BytesLen(inLocal) - sent
                    var trimmed: Bytes = BytesAlloc(0)
                    if trimLen > 0:
                        trimmed = BytesAlloc(trimLen)
                        var cpTrimIdx: int32
                        while cpTrimIdx < trimLen:
                            BytesSet(trimmed, cpTrimIdx, BytesGet(inLocal, sent + cpTrimIdx) & 255)
                            cpTrimIdx = cpTrimIdx + 1
                    BytesFree(inLocal)
                    streams[si].inPending = trimmed
                    code = 1
    var outLocal2: Bytes = streams[si].outPending
    if BytesLen(outLocal2) > 0 && !tunnelDead:
        # [thruput] 出帧循环: 旧形每轮只写 1 帧(16KB)+loop 固定 ≥1ms 等待,
        # 单流下载被压到几十 KB/s。写至 carrier 不可写/排空, 8 帧上限防
        # 饿死同隧道其他流。游标式遍历(循环内零 owned 重绑, 过 cold 审计)。
        var outCursor: int32
        var outTotal: int32 = BytesLen(outLocal2)
        var burstFrames: int32
        block out_burst:
            while outCursor < outTotal && burstFrames < 8:
                let outWritable: int32 = VpnProxyFdWaitWritable(link.conn.fd, 0)
                if outWritable < 0:
                    streams[si].targetFd = tc.fd
                    streams[si].targetOpen = tc.open
                    streams[si].outPending = outLocal2
                    return 3
                if outWritable == 0:
                    break out_burst
                var take2: int32 = outTotal - outCursor
                let frameLimit: int32 = VpnProxyTcpTlsForwardDataPayloadLimit()
                if take2 > frameLimit:
                    take2 = frameLimit
                var chunk2: Bytes = BytesAlloc(take2)
                var cpOutIdx: int32
                while cpOutIdx < take2:
                    BytesSet(chunk2, cpOutIdx, BytesGet(outLocal2, outCursor + cpOutIdx) & 255)
                    cpOutIdx = cpOutIdx + 1
                let outWriteRes: Result[bool] = VpnProxyMuxServerWriteStreamData(link, streams[si].streamId, chunk2)
                BytesFree(chunk2)
                if IsErr(outWriteRes):
                    streams[si].targetFd = tc.fd
                    streams[si].targetOpen = tc.open
                    streams[si].outPending = outLocal2
                    return 3
                outCursor = outCursor + take2
                burstFrames = burstFrames + 1
                code = 1
        # 未排空余量: 单次 owned 重建回元素槽。
        if outCursor < outTotal:
            var restOut: Bytes = BytesAlloc(outTotal - outCursor)
            var cpRestOut: int32
            while cpRestOut < outTotal - outCursor:
                BytesSet(restOut, cpRestOut, BytesGet(outLocal2, outCursor + cpRestOut) & 255)
                cpRestOut = cpRestOut + 1
            BytesFree(outLocal2)
            streams[si].outPending = restOut
        else:
            BytesFree(outLocal2)
            streams[si].outPending = BytesAlloc(0)
    if streams[si].readClosed && !streams[si].closeSent && BytesLen(streams[si].outPending) <= 0:
        if !tunnelDead:
            let closeWriteRes: Result[bool] = VpnProxyMuxServerWriteStreamClose(link, streams[si].streamId)
            if IsErr(closeWriteRes):
                streams[si].targetFd = tc.fd
                streams[si].targetOpen = tc.open
                return 3
        streams[si].closeSent = true
        code = 1
    if streams[si].remoteClosed && BytesLen(streams[si].inPending) <= 0 && !streams[si].shutWrite:
        let _ = tcp.TcpShutdownWrite(tc)
        streams[si].shutWrite = true
        code = 1
    streams[si].targetFd = tc.fd
    streams[si].targetOpen = tc.open
    # 收割判定: 双向 EOF = 死重(旧 relay 同款); 或双关且全部排空。
    if streams[si].readClosed && streams[si].remoteClosed:
        code = 2
    elif streams[si].closeSent && streams[si].shutWrite && BytesLen(streams[si].inPending) <= 0 && BytesLen(streams[si].outPending) <= 0:
        code = 2
    return code

# [mux] AUTH 后的帧分发主循环(单函数, streams 局部 var, 旧 relay 同形状)。
# firstFrame: 已解密的首个 OPEN 帧(调用方保证), payload 所有权移交本函数。
@borrows
fn VpnProxyServeExitTcpTlsMux(link: var VpnProxyTcpTlsForwardLink,
                              firstFrame: var ttf.VpnProxyTcpTlsForwardFrame): Result[bool] =
    var streams: VpnProxyTcpTlsStreamEntry[]
    let remoteNbRes: Result[bool] = tcp.TcpSetNonblocking(link.conn, true)
    if IsErr(remoteNbRes):
        BytesFree(firstFrame.payload)
        return Err[bool](ErrorText(remoteNbRes))
    link.relayRemotePending = BytesAlloc(0)
    var tunnelDead: bool
    # [tls-hdr-hunt] 最近一次解密成功记录的 seq(失败现场定位跳号/偏移)。
    var lastGoodSeq: int64 = -1
    var muxOpens: int32
    let serveT0: int64 = VpnProxyMonoNowMs()
    # ---- 首帧分发(保证为 OPEN): 连目标 + 入流表 ----
    var dispatchFatal: bool
    block first_open:
        if firstFrame.streamId <= 0:
            break first_open
        let targetText0: str = rawbytes.BytesToString(firstFrame.payload)
        BytesFree(firstFrame.payload)
        let targetOwned0: str = strings.CloneStr(targetText0)
        if VpnProxyMuxStreamFindIndex(streams, firstFrame.streamId) >= 0:
            let dupRes0: Result[bool] = VpnProxyMuxServerWriteStreamOpenError(link,
                                                                              firstFrame.streamId,
                                                                              "vpn proxy tcp-tls-forward: duplicate stream id")
            if IsErr(dupRes0):
                dispatchFatal = true
            break first_open
        if streams.len >= 64:
            let limitRes0: Result[bool] = VpnProxyMuxServerWriteStreamOpenError(link,
                                                                                firstFrame.streamId,
                                                                                "vpn proxy tcp-tls-forward: mux stream limit")
            if IsErr(limitRes0):
                dispatchFatal = true
            break first_open
        let targetRes0: Result[VpnProxyTarget] = VpnProxyTargetFromAddress(strings.CloneStr(targetOwned0))
        if IsErr(targetRes0):
            VpnProxyPrintErr(ErrorText(targetRes0))
            let oerRes0: Result[bool] = VpnProxyMuxServerWriteStreamOpenError(link,
                                                                              firstFrame.streamId,
                                                                              ErrorText(targetRes0))
            if IsErr(oerRes0):
                dispatchFatal = true
            break first_open
        # [optimistic-open] 先回 OpenOk 再连 target(旧单流路径同款): 该流的
        # ClientHello 堆在隧道内核缓冲, relay 起来后自然排空。
        let okWriteRes0: Result[bool] = VpnProxyMuxServerWriteStreamOpenOk(link, firstFrame.streamId)
        if IsErr(okWriteRes0):
            dispatchFatal = true
            break first_open
        let targetConnRes0: Result[tcp.TcpConnectionHandle] = VpnProxyConnectTargetTcp(Value(targetRes0))
        if IsErr(targetConnRes0):
            VpnProxyPrintErr(ErrorText(targetConnRes0))
            let cfRes0: Result[bool] = VpnProxyMuxServerWriteStreamClose(link, firstFrame.streamId)
            if IsErr(cfRes0):
                dispatchFatal = true
            break first_open
        var conn0: tcp.TcpConnectionHandle = Value(targetConnRes0)
        let _ = tcp.TcpSetNoDelay(conn0, true)
        var entry0: VpnProxyTcpTlsStreamEntry
        entry0.streamId = firstFrame.streamId
        entry0.targetFd = conn0.fd
        entry0.targetOpen = conn0.open
        entry0.active = true
        entry0.inPending = BytesAlloc(0)
        entry0.outPending = BytesAlloc(0)
        add(streams, entry0)
        muxOpens = muxOpens + 1
        VpnProxyPrintErr(strutil.Join(["MUXOPEN fd=", strings.Int64ToStr(int64(link.conn.fd)),
                                        " stream=", strings.Int64ToStr(int64(firstFrame.streamId)),
                                        " target=", strings.CloneStr(targetOwned0),
                                        " active=", strings.Int64ToStr(int64(streams.len)),
                                        " opens=", strings.Int64ToStr(int64(muxOpens))], ""))
    if dispatchFatal:
        return Err[bool]("vpn proxy tcp-tls-forward: mux first open failed")
    while true:
        var progressed: bool
        if !tunnelDead:
            # [event-loop] carrier+全部 target 单次 ppoll(5ms): 任一 fd 就绪
            # 即醒即读, 替代"carrier 1ms 等待+每流 timeout=0 轮询"的间歇读
            # 模型——PUMPRATE 定谳该模型驯化源站 BBR 供数节律(~900ms/批)。
            VpnProxyFdWaitMultiReset()
            let _ = VpnProxyFdWaitMultiAdd(link.conn.fd, 1)
            var ewIdx: int32
            while ewIdx < streams.len:
                if streams[ewIdx].targetOpen:
                    let _ = VpnProxyFdWaitMultiAdd(streams[ewIdx].targetFd, 1)
                ewIdx = ewIdx + 1
            let multiWaitRc: int32 = VpnProxyFdWaitMultiWait(5)
            if multiWaitRc < 0:
                return Err[bool]("vpn proxy tcp-tls-forward: event wait failed")
            let remoteReadyRes: Result[bool] = tcp.TcpConnectionWaitReadable(link.conn, 0)
            if IsErr(remoteReadyRes):
                return Err[bool](ErrorText(remoteReadyRes))
            if Value(remoteReadyRes):
                var remoteReadBuf: Bytes = BytesAlloc(VpnProxyRelayChunkBytes)
                let remoteReadRes: Result[int32] = tcp.TcpRecvRawNonblocking(link.conn,
                                                                             remoteReadBuf.data,
                                                                             BytesLen(remoteReadBuf))
                if IsErr(remoteReadRes):
                    BytesFree(remoteReadBuf)
                    if ErrorText(remoteReadRes) != "tcp syscall: would block":
                        return Err[bool](ErrorText(remoteReadRes))
                else:
                    let remoteGot: int32 = Value(remoteReadRes)
                    if remoteGot <= 0:
                        BytesFree(remoteReadBuf)
                        tunnelDead = true
                        progressed = true
                    else:
                        # [x86 BytesSlice len 错译绕行] owned 拼接(旧 relay 同款)。
                        var joinedRemote: Bytes = VpnProxyRelayJoinPending(link.relayRemotePending.data,
                                                                           link.relayRemotePending.len,
                                                                           remoteReadBuf,
                                                                           remoteGot)
                        BytesFree(link.relayRemotePending)
                        BytesFree(remoteReadBuf)
                        link.relayRemotePending = joinedRemote
                        progressed = true
            # 记录解码内循环: 每条完整 TLS 记录 → 解密 → 帧 → 按流分发。
            while !tunnelDead:
                let completeRes: Result[int32] = tlsrec.VpnProxyTcpTlsRecordPlainCompleteLength(link.relayRemotePending)
                if IsErr(completeRes):
                    VpnProxyPrintErr(strutil.Join(["TLSHDR site=muxrelay fd=", strings.Int64ToStr(int64(link.conn.fd)), " plen=", strings.Int64ToStr(int64(BytesLen(link.relayRemotePending))), " head=", VpnProxyTlsHeaderDumpText(link.relayRemotePending.data, BytesLen(link.relayRemotePending), 16)], ""))
                    return Err[bool](ErrorText(completeRes))
                if Value(completeRes) <= 0:
                    break
                var recordLen: int32 = Value(completeRes)
                var record: Bytes = BytesAlloc(recordLen)
                var recIdx: int32
                while recIdx < recordLen:
                    BytesSet(record, recIdx, BytesGet(link.relayRemotePending, recIdx) & 255)
                    recIdx = recIdx + 1
                var remainLen: int32 = BytesLen(link.relayRemotePending) - recordLen
                var rest: Bytes = BytesAlloc(0)
                if remainLen > 0:
                    rest = BytesAlloc(remainLen)
                    var cpRestIdx: int32
                    while cpRestIdx < remainLen:
                        BytesSet(rest, cpRestIdx, BytesGet(link.relayRemotePending, recordLen + cpRestIdx) & 255)
                        cpRestIdx = cpRestIdx + 1
                BytesFree(link.relayRemotePending)
                link.relayRemotePending = rest
                var plain: tlsrec.VpnProxyTcpTlsRecordPlain
                var usedSeq: int64 = link.recvKeys.seq
                let plainRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordDecryptInto(link.recvKeys, record, plain)
                if IsErr(plainRes):
                    # [tls-hdr-hunt] KeyS 级失真取证: 失败记录 seq + 前 5 字节
                    # TLS header hex + 上一条成功记录 seq。冷路径, 零热路径开销。
                    var hdrText: str
                    var hdrIdx: int32
                    while hdrIdx < 5 && hdrIdx < BytesLen(record):
                        let hdrByte: int32 = BytesGet(record, hdrIdx) & 255
                        hdrText = hdrText + VpnProxyHexNibble((hdrByte >> 4) & 15) + VpnProxyHexNibble(hdrByte & 15)
                        hdrIdx = hdrIdx + 1
                    VpnProxyPrintErr(strutil.Join(["TLSHDR site=muxtag fd=", strings.Int64ToStr(int64(link.conn.fd)), " seq=", strings.Int64ToStr(usedSeq), " last_good_seq=", strings.Int64ToStr(lastGoodSeq), " hdr5=", hdrText, " err=", ErrorText(plainRes)], ""))
                    BytesFree(record)
                    return Err[bool](ErrorText(plainRes))
                BytesFree(record)
                lastGoodSeq = usedSeq
                if plain.contentType != tlsrec.VpnProxyTcpTlsRecordContentTypeApplicationData():
                    BytesFree(plain.payload)
                    return Err[bool]("vpn proxy tcp-tls-forward: expected application record")
                var frame: ttf.VpnProxyTcpTlsForwardFrame
                let decodeCode: int32 = ttf.VpnProxyTcpTlsForwardDecodeFrameCode(plain.payload, frame)
                # [orc-hunt x86] 视图悬垂: 先 owned 拷贝再释放底座(旧 relay 同款)。
                if decodeCode > 0 && BytesLen(frame.payload) > 0:
                    var ownedPayload: Bytes = BytesAlloc(BytesLen(frame.payload))
                    var ownIdx: int32
                    while ownIdx < BytesLen(ownedPayload):
                        BytesSet(ownedPayload, ownIdx, BytesGet(frame.payload, ownIdx) & 255)
                        ownIdx = ownIdx + 1
                    frame.payload = ownedPayload
                BytesFree(plain.payload)
                if decodeCode <= 0:
                    return Err[bool]("vpn proxy tcp-tls-forward: invalid frame")
                progressed = true
                # ---- 帧分发(OPEN/DATA/CLOSE/PROBE) ----
                if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindOpen():
                    # payload 所有权先落局部(借用字段直作 byval 实参触发冷审计)。
                    var dataLocal: Bytes = frame.payload
                    frame.payload = BytesAlloc(0)
                    let targetText: str = rawbytes.BytesToString(dataLocal)
                    BytesFree(dataLocal)
                    if frame.streamId <= 0:
                        continue
                    if VpnProxyMuxStreamFindIndex(streams, frame.streamId) >= 0:
                        let dupRes: Result[bool] = VpnProxyMuxServerWriteStreamOpenError(link,
                                                                                         frame.streamId,
                                                                                         "vpn proxy tcp-tls-forward: duplicate stream id")
                        if IsErr(dupRes):
                            return Err[bool](ErrorText(dupRes))
                        continue
                    let openRes: Result[bool] = VpnProxyMuxHandleOpenFrame(link,
                                                                           streams,
                                                                           frame.streamId,
                                                                           targetText,
                                                                           muxOpens)
                    if IsErr(openRes):
                        return Err[bool](ErrorText(openRes))
                    continue
                if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindData():
                    let dataIdx: int32 = VpnProxyMuxStreamFindIndex(streams, frame.streamId)
                    if dataIdx >= 0:
                        # [nborc] 旧 streams_cap_link 单槽写点已拆除(见全局注释)。
                        # 显式 owned 拷贝(帧字段直接作实参源触发冷审计误杀)。
                        var dataLen: int32 = BytesLen(frame.payload)
                        var dataLocal: Bytes = BytesAlloc(dataLen)
                        var cpDataIdx: int32
                        while cpDataIdx < dataLen:
                            BytesSet(dataLocal, cpDataIdx, BytesGet(frame.payload, cpDataIdx) & 255)
                            cpDataIdx = cpDataIdx + 1
                        let appendRes: Result[bool] = VpnProxyMuxStreamAppendIn(link, streams, dataIdx, dataLocal)
                        BytesFree(dataLocal)
                        if IsErr(appendRes):
                            return Err[bool](ErrorText(appendRes))
                    BytesFree(frame.payload)
                    continue
                if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindClose():
                    let closeIdx: int32 = VpnProxyMuxStreamFindIndex(streams, frame.streamId)
                    if closeIdx >= 0:
                        streams[closeIdx].remoteClosed = true
                    BytesFree(frame.payload)
                    continue
                if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindProbe():
                    let probeOkRes: Result[bool] = VpnProxyTcpTlsWriteProbeOkFrame(link)
                    BytesFree(frame.payload)
                    if IsErr(probeOkRes):
                        return Err[bool](ErrorText(probeOkRes))
                    continue
                if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindPing():
                    # [keepalive] mux 内 PING 同 PROBE: 回 PingOk 后继续中继,
                    # 不关连接。
                    let pingOkRes: Result[bool] = VpnProxyTcpTlsWritePingOkFrame(link)
                    BytesFree(frame.payload)
                    if IsErr(pingOkRes):
                        return Err[bool](ErrorText(pingOkRes))
                    continue
                BytesFree(frame.payload)
                return Err[bool]("vpn proxy tcp-tls-forward: unexpected relay frame")
        # ---- 每流泵: 小助手逐流处理, 大循环只留标量状态 ----
        var si: int32
        while si < streams.len:
            let pumpCode: int32 = VpnProxyMuxPumpStream(link, streams, si, tunnelDead)
            if pumpCode == 3:
                return Err[bool]("vpn proxy tcp-tls-forward: mux stream pump failed")
            if pumpCode == 2:
                VpnProxyPrintErr(strutil.Join(["MUXCLOSE fd=", strings.Int64ToStr(int64(link.conn.fd)),
                                                " stream=", strings.Int64ToStr(int64(streams[si].streamId)),
                                                " active=", strings.Int64ToStr(int64(streams.len - 1))], ""))
                VpnProxyMuxStreamRemoveAt(streams, si)
                progressed = true
            else:
                if pumpCode == 1:
                    progressed = true
                si = si + 1
        if tunnelDead:
            VpnProxyPrintErr(strutil.Join(["MUXDONE fd=", strings.Int64ToStr(int64(link.conn.fd)),
                                            " opens=", strings.Int64ToStr(int64(muxOpens)),
                                            " relay_ms=", strings.Int64ToStr(VpnProxyMonoNowMs() - serveT0)], ""))            while streams.len > 0:
                VpnProxyMuxStreamRemoveAt(streams, 0)
            if BytesLen(link.relayRemotePending) > 0:
                BytesFree(link.relayRemotePending)
            link.relayRemotePending = BytesAlloc(0)
            return Ok[bool](true)
        if !progressed:
            if streams.len <= 0:
                # 空闲: 等下一个 OPEN 或隧道 EOF, 200ms 粒度不烧 CPU。
                let idleRes: Result[bool] = tcp.TcpConnectionWaitReadable(link.conn, 200)
                if IsErr(idleRes):
                    return Err[bool](ErrorText(idleRes))
            # [event-loop] 非空闲不 sleep: 循环顶的 multi ppoll(5ms) 已是
            # 唯一等待点(旧形此处再 sleep 2ms 叠加读延迟)。

@borrows
fn VpnProxyHandleExitTcpTlsConn(conn: var tcp.TcpConnectionHandle,
                                identity: var VpnProxyLoadedIdentity,
                                serverCfg: VpnProxyIdentityConfig): Result[bool] =
    let _ = tcp.TcpSetNoDelay(conn, true)
    let connT0: int64 = VpnProxyMonoNowMs()
    var link: VpnProxyTcpTlsForwardLink
    var linkRes: Result[bool] = VpnProxyTcpTlsServerAcceptHandshakeInto(conn, identity, link)
    if IsErr(linkRes):
        return Err[bool](ErrorText(linkRes))
    let connTlsMs: int64 = VpnProxyMonoNowMs() - connT0
    let authT0: int64 = VpnProxyMonoNowMs()
    var authFrame: ttf.VpnProxyTcpTlsForwardFrame
    let authFrameRes: Result[bool] = VpnProxyTcpTlsReadFrameInto(link, authFrame)
    if IsErr(authFrameRes):
        VpnProxyCloseTcpTlsForwardLink(link)
        return Err[bool](ErrorText(authFrameRes))
    let connAuthMs: int64 = VpnProxyMonoNowMs() - authT0
    if authFrame.frameType != ttf.VpnProxyTcpTlsForwardFrameKindAuth():
        VpnProxyCloseTcpTlsForwardLink(link)
        return Err[bool]("vpn proxy tcp-tls-forward: auth frame required")
    if !VpnProxyAuthMatches(ttf.VpnProxyTcpTlsForwardPayloadText(authFrame),
                            serverCfg.expectedAuth,
                            serverCfg.expectedAuthSha256):
        VpnProxyCloseTcpTlsForwardLink(link)
        return Err[bool]("vpn proxy tcp-tls-forward: auth rejected")
    var frame: ttf.VpnProxyTcpTlsForwardFrame
    # [keepalive] 停靠窗口: 池 fill 的热连接 AUTH 后长期等首个 OPEN, 客户端
    # maintainer 周期发 PING 验活。回 PingOk 后继续等真首帧; 15s 读超时被每
    # 次 PING 重置, 停靠不再被超时掐断(旧模式=22s 一轮 conn end read timeout,
    # 消费者把 OPEN 写进已被服务器掐死的连接 = 下行 flight 丢失白屏)。
    var frameFatal: str
    block first_frame:
        while true:
            var loopFrame: ttf.VpnProxyTcpTlsForwardFrame
            let loopFrameRes: Result[bool] = VpnProxyTcpTlsReadFrameInto(link, loopFrame)
            if IsErr(loopFrameRes):
                frameFatal = ErrorText(loopFrameRes)
                break first_frame
            if loopFrame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindPing():
                # PING 空 payload 是已释放底座的空视图: 禁止 free/读取。
                let pingOkRes: Result[bool] = VpnProxyTcpTlsWritePingOkFrame(link)
                if IsErr(pingOkRes):
                    frameFatal = ErrorText(pingOkRes)
                    break first_frame
                continue
            frame = loopFrame
            break first_frame
    if len(frameFatal) > 0:
        VpnProxyCloseTcpTlsForwardLink(link)
        return Err[bool](frameFatal)
    if frame.frameType == ttf.VpnProxyTcpTlsForwardFrameKindProbe():
        let writeRes: Result[bool] = VpnProxyTcpTlsWriteProbeOkFrame(link)
        VpnProxyCloseTcpTlsForwardLink(link)
        if IsErr(writeRes):
            return Err[bool](ErrorText(writeRes))
        return Ok[bool](true)
    if frame.frameType != ttf.VpnProxyTcpTlsForwardFrameKindOpen():
        VpnProxyPrintErr("vpn proxy tcp-tls-forward: expected open frame")
        VpnProxyCloseTcpTlsForwardLink(link)
        return Err[bool]("vpn proxy tcp-tls-forward: expected open frame")
    # [mux] AUTH+首个 OPEN 完成; 同一 conn 进入多流帧分发循环。向后兼容:
    # 旧单流客户端行为不变(streamId=1 单条目流表), conn 生命周期延至 EOF。
    link.streamId = frame.streamId
    let relayRes: Result[bool] = VpnProxyServeExitTcpTlsMux(link, frame)
    VpnProxyCloseTcpTlsForwardLink(link)
    VpnProxyPrintLine(strutil.Join(["conn_metrics tls_ms=", strings.Int64ToStr(connTlsMs),
                                    " auth_ms=", strings.Int64ToStr(connAuthMs),
                                    " target_ms=0",
                                    " relay_ms=", strings.Int64ToStr(VpnProxyMonoNowMs() - authT0)],
                                   ""))
    if IsErr(relayRes):
        return Err[bool](ErrorText(relayRes))
    return Ok[bool](true)

fn VpnProxyHandleExitUdpConnCore(listener: var qtransport.MsQuicTransport,
                                   conn: var qconn.Connection,
                                   firstMsg: Hysteria2UdpMessage,
                                   sockets: var VpnProxyUdpSocketPair): Result[bool] =
    var clientFrags: VpnProxyUdpFragState[]
    var clientSessions: VpnProxyUdpSessionTable
    var exitPacketId: int32
    var pendingMsg: Hysteria2UdpMessage
    pendingMsg.sessionId = firstMsg.sessionId
    pendingMsg.packetId = firstMsg.packetId
    pendingMsg.fragmentId = firstMsg.fragmentId
    pendingMsg.fragmentCount = firstMsg.fragmentCount
    pendingMsg.address = strings.CloneStr(firstMsg.address)
    pendingMsg.payload = rawbytes.BytesSlice(firstMsg.payload, 0, rawbytes.BytesLen(firstMsg.payload))
    var hasPending: bool = true
    VpnProxyUdpSessionTableInit(clientSessions)
    while true:
        var progressed: bool
        if hasPending:
            hasPending = false
            if pendingMsg.sessionId <= int64(0):
                return Err[bool]("vpn proxy: udp session id invalid")
            var fullMsg: Hysteria2UdpMessage
            var feedMsg: Hysteria2UdpMessage
            feedMsg.sessionId = pendingMsg.sessionId
            feedMsg.packetId = pendingMsg.packetId
            feedMsg.fragmentId = pendingMsg.fragmentId
            feedMsg.fragmentCount = pendingMsg.fragmentCount
            feedMsg.address = strings.CloneStr(pendingMsg.address)
            feedMsg.payload = rawbytes.BytesSlice(pendingMsg.payload, 0, rawbytes.BytesLen(pendingMsg.payload))
            let fullRes: Result[bool] = VpnProxyUdpFragFeed(clientFrags, feedMsg, fullMsg)
            if IsErr(fullRes):
                return Err[bool](ErrorText(fullRes))
            if Value(fullRes):
                let addrForRemember: str = strings.CloneStr(fullMsg.address)
                let rememberRes: Result[bool] = VpnProxyUdpSessionRemember(clientSessions,
                                                                             addrForRemember,
                                                                             fullMsg.sessionId)
                if IsErr(rememberRes):
                    return Err[bool](ErrorText(rememberRes))
                let targetRes: Result[VpnProxyTarget] = VpnProxyTargetFromAddress(strings.CloneStr(fullMsg.address))
                if IsErr(targetRes):
                    return Err[bool](ErrorText(targetRes))
                var targetValue: VpnProxyTarget = Value(targetRes)
                let targetIsV6: bool = strings.StrContains(strings.CloneStr(targetValue.host), ":")
                let socketRes: Result[udp.UdpSocketHandle] = VpnProxyUdpSocketPairEnsure(sockets, targetIsV6)
                if IsErr(socketRes):
                    return Err[bool](ErrorText(socketRes))
                let socket: udp.UdpSocketHandle = Value(socketRes)
                var targetAddr: udp.UdpSockAddr
                let literalRes: Result[bool] = VpnProxyUdpLiteralTarget(targetValue, socket.family, targetAddr)
                if IsErr(literalRes):
                    return Err[bool]("vpn proxy: udp target host literal required")
                let sendRes: Result[bool] = VpnProxyUdpSocketSend(socket.fd, rawbytes.BytesSlice(fullMsg.payload, 0, rawbytes.BytesLen(fullMsg.payload)), targetAddr)
                if IsErr(sendRes):
                    return Err[bool](ErrorText(sendRes))
            progressed = true
        let remoteReadRes: Result[Bytes] = qtransport.msquicTransportDatagramRead(listener, conn)
        if IsErr(remoteReadRes):
            let err: str = ErrorText(remoteReadRes)
            if !VpnProxyWouldBlockQuic(err):
                if err == "msquic: pipe closed":
                    return Ok[bool](true)
                if err == "msquic: connection closed":
                    return Ok[bool](true)
                if err == "connection: closed":
                    return Ok[bool](true)
                return Err[bool](strings.CloneStr(err))
        else:
            let msgRes: Result[Hysteria2UdpMessage] = hy2.Hysteria2DecodeUdpMessage(Value(remoteReadRes))
            if IsErr(msgRes):
                return Err[bool](ErrorText(msgRes))
            let decodedPending: Hysteria2UdpMessage = Value(msgRes)
            pendingMsg.sessionId = decodedPending.sessionId
            pendingMsg.packetId = decodedPending.packetId
            pendingMsg.fragmentId = decodedPending.fragmentId
            pendingMsg.fragmentCount = decodedPending.fragmentCount
            pendingMsg.address = strings.CloneStr(decodedPending.address)
            pendingMsg.payload = rawbytes.BytesSlice(decodedPending.payload, 0, rawbytes.BytesLen(decodedPending.payload))
            hasPending = true
            progressed = true
        if sockets.v4Open:
            var recv4: udp.UdpRecvResult
            let recvRes4: Result[bool] = udp.UdpRecvFromNonblock(sockets.v4.fd, VpnProxyUdpRelayChunkBytes, recv4)
            if IsErr(recvRes4):
                if !VpnProxyWouldBlockUdp(ErrorText(recvRes4)):
                    return Err[bool](ErrorText(recvRes4))
            else:
                var sourceTarget: VpnProxyTarget = VpnProxyUdpTargetFromSockAddr(recv4.fromAddr)
                let sourceText: str = VpnProxyTargetAddress(sourceTarget)
                let sessionIdRes: Result[int64] = VpnProxyUdpSessionForKnownAddress(clientSessions, sourceText)
                if IsErr(sessionIdRes):
                    return Err[bool](ErrorText(sessionIdRes))
                let payloadLimitRes: Result[int32] = VpnProxyHy2UdpPayloadLimit(listener,
                                                                                  Value(sessionIdRes),
                                                                                  sourceText)
                if IsErr(payloadLimitRes):
                    return Err[bool](ErrorText(payloadLimitRes))
                let packetId: int32 = VpnProxyUdpPacketNext(exitPacketId)
                let msg: Hysteria2UdpMessage = hy2.Hysteria2MakeUdpMessage(Value(sessionIdRes),
                                                                               packetId,
                                                                               0,
                                                                               1,
                                                                               sourceText,
                                                                               rawbytes.BytesSlice(recv4.data, 0, rawbytes.BytesLen(recv4.data)))
                let fragmentsRes: Result[Hysteria2UdpMessage[]] = hy2.Hysteria2FragmentUdpMessage(msg,
                                                                                                       Value(payloadLimitRes))
                if IsErr(fragmentsRes):
                    return Err[bool](ErrorText(fragmentsRes))
                let fragments: Hysteria2UdpMessage[] = Value(fragmentsRes)
                for i in 0..<fragments.len:
                    let wireRes: Result[Bytes] = hy2.Hysteria2EncodeUdpMessage(fragments[i])
                    if IsErr(wireRes):
                        return Err[bool](ErrorText(wireRes))
                    let writeRes: Result[int32] = qtransport.msquicTransportDatagramWrite(listener,
                                                                                           conn,
                                                                                           Value(wireRes))
                    if IsErr(writeRes):
                        return Err[bool](ErrorText(writeRes))
                progressed = true
        if sockets.v6Open:
            var recv6: udp.UdpRecvResult
            let recvRes6: Result[bool] = udp.UdpRecvFromNonblock(sockets.v6.fd, VpnProxyUdpRelayChunkBytes, recv6)
            if IsErr(recvRes6):
                if !VpnProxyWouldBlockUdp(ErrorText(recvRes6)):
                    return Err[bool](ErrorText(recvRes6))
            else:
                var sourceTarget: VpnProxyTarget = VpnProxyUdpTargetFromSockAddr(recv6.fromAddr)
                let sourceText: str = VpnProxyTargetAddress(sourceTarget)
                let sessionIdRes: Result[int64] = VpnProxyUdpSessionForKnownAddress(clientSessions, sourceText)
                if IsErr(sessionIdRes):
                    return Err[bool](ErrorText(sessionIdRes))
                let payloadLimitRes: Result[int32] = VpnProxyHy2UdpPayloadLimit(listener,
                                                                                  Value(sessionIdRes),
                                                                                  sourceText)
                if IsErr(payloadLimitRes):
                    return Err[bool](ErrorText(payloadLimitRes))
                let packetId: int32 = VpnProxyUdpPacketNext(exitPacketId)
                let msg: Hysteria2UdpMessage = hy2.Hysteria2MakeUdpMessage(Value(sessionIdRes),
                                                                               packetId,
                                                                               0,
                                                                               1,
                                                                               sourceText,
                                                                               rawbytes.BytesSlice(recv6.data, 0, rawbytes.BytesLen(recv6.data)))
                let fragmentsRes: Result[Hysteria2UdpMessage[]] = hy2.Hysteria2FragmentUdpMessage(msg,
                                                                                                       Value(payloadLimitRes))
                if IsErr(fragmentsRes):
                    return Err[bool](ErrorText(fragmentsRes))
                let fragments: Hysteria2UdpMessage[] = Value(fragmentsRes)
                for i in 0..<fragments.len:
                    let wireRes: Result[Bytes] = hy2.Hysteria2EncodeUdpMessage(fragments[i])
                    if IsErr(wireRes):
                        return Err[bool](ErrorText(wireRes))
                    let writeRes: Result[int32] = qtransport.msquicTransportDatagramWrite(listener,
                                                                                           conn,
                                                                                           Value(wireRes))
                    if IsErr(writeRes):
                        return Err[bool](ErrorText(writeRes))
                progressed = true
        if !progressed:
            os.SleepMs(VpnProxyUdpRelaySleepMs)

fn VpnProxyHandleExitUdpConn(listener: var qtransport.MsQuicTransport,
                               conn: var qconn.Connection,
                               firstMsg: Hysteria2UdpMessage): Result[bool] =
    var sockets: VpnProxyUdpSocketPair
    let relayRes: Result[bool] = VpnProxyHandleExitUdpConnCore(listener, conn, firstMsg, sockets)
    VpnProxyUdpSocketPairClose(sockets)
    return relayRes

@borrows
fn VpnProxyHandleExitConn(listener: var qtransport.MsQuicTransport,
                            conn: var qconn.Connection,
                            serverCfg: VpnProxyIdentityConfig,
                            masquerade: VpnProxyMasqueradeConfig): Result[bool] =
    let selectRes = quic_transport.Libp2pQuicServerSelectProtocol(listener, conn, VpnProxyProtocolId())
    if IsErr(selectRes):
        return Err[bool](ErrorText(selectRes))
    let authRes: Result[bool] = VpnProxyHy2ServerAuth(conn, serverCfg, masquerade)
    if IsErr(authRes):
        return Err[bool](ErrorText(authRes))
    while true:
        let datagramRes: Result[Bytes] = qtransport.msquicTransportDatagramRead(listener, conn)
        if IsErr(datagramRes):
            let err: str = ErrorText(datagramRes)
            if !VpnProxyWouldBlockQuic(err):
                if err == "msquic: connection closed":
                    return Ok[bool](true)
                if err == "connection: closed":
                    return Ok[bool](true)
                return Err[bool](strings.CloneStr(err))
        else:
            let msgRes: Result[Hysteria2UdpMessage] = hy2.Hysteria2DecodeUdpMessage(Value(datagramRes))
            if IsErr(msgRes):
                return Err[bool](ErrorText(msgRes))
            return VpnProxyHandleExitUdpConn(listener, conn, Value(msgRes))
        let streamRes: Result[VpnProxyHy2TcpStream] = hy2sess.VpnProxyHy2AcceptTcpStream(conn)
        if IsErr(streamRes):
            let err: str = ErrorText(streamRes)
            if !VpnProxyWouldBlockQuic(err):
                if err == "msquic: pipe closed":
                    return Ok[bool](true)
                if err == "connection: closed":
                    return Ok[bool](true)
                return Err[bool](strings.CloneStr(err))
        else:
            var stream = Value(streamRes)
            let reqRes: Result[hy2.Hysteria2TcpRequest] = hy2sess.VpnProxyHy2TcpStreamReadRequest(stream)
            if IsErr(reqRes):
                hy2sess.VpnProxyHy2TcpStreamClose(stream)
                return Err[bool](ErrorText(reqRes))
            let handleRes: Result[bool] = VpnProxyHandleExitTcpStream(stream, Value(reqRes))
            if IsErr(handleRes):
                return Err[bool](ErrorText(handleRes))
            continue
        os.SleepMs(VpnProxyUdpRelaySleepMs)

@borrows
fn VpnProxyExitAcceptTransientError(err: str): bool =
    if err == "msquic: accept timeout":
        return true
    if err == "msquic native: accept failed":
        return true
    if strutil.StartsWith(err, "msquic native: accept handshake ! ready"):
        return true
    if strutil.StartsWith(err, "msquic native: handshake ! ready"):
        return true
    if strutil.StartsWith(err, "msquic native: session ! ready"):
        return true
    if strutil.StartsWith(err, "msquic native: pipe read timeout"):
        return true
    if err == "msquic: accept timeout":
        return true
    return false

fn VpnProxyExitWorkerFillFixedConfig(configOut: var VpnProxyConfig): bool =
    let workerConfigPath: str = strings.CloneStr(VpnProxyExitWorkerConfigPath)
    return VpnProxyLoadFixedProductionServerConfigInto(configOut, workerConfigPath)

fn VpnProxyExitWorkerBuildIdentity(config: var VpnProxyConfig): Result[VpnProxyLoadedIdentity] =
    let identityRes: Result[VpnProxyLoadedIdentity] = VpnProxyLoadIdentity(config.configDir,
                                                                           config.server,
                                                                           false)
    if IsErr(identityRes):
        return Err[VpnProxyLoadedIdentity](ErrorText(identityRes))
    var identity: VpnProxyLoadedIdentity = Value(identityRes)
    if identity.certs.len <= 0 || identity.trustRoots.len <= 0 || identity.privateKey.len <= 0:
        return Err[VpnProxyLoadedIdentity]("vpn proxy: server identity incomplete")
    let leafKindRes = VpnProxyLoadLeafKeyKind(identity.certs[0])
    if IsErr(leafKindRes):
        return Err[VpnProxyLoadedIdentity](ErrorText(leafKindRes))
    identity.leafKeyKind = Value(leafKindRes)
    return Ok[VpnProxyLoadedIdentity](identity)

fn VpnProxyExitWorkerHandleAcceptedConn(conn: var tcp.TcpConnectionHandle): Result[bool] =
    var configForIdentity: VpnProxyConfig
    if !VpnProxyExitWorkerFillFixedConfig(configForIdentity):
        return Err[bool]("vpn proxy exit worker: fixed production server config load failed")
    let identityRes: Result[VpnProxyLoadedIdentity] = VpnProxyExitWorkerBuildIdentity(configForIdentity)
    if IsErr(identityRes):
        return Err[bool](ErrorText(identityRes))
    var identity: VpnProxyLoadedIdentity = Value(identityRes)
    var configForServe: VpnProxyConfig
    if !VpnProxyExitWorkerFillFixedConfig(configForServe):
        return Err[bool]("vpn proxy exit worker: fixed production server config reload failed")
    let hRes: Result[bool] = VpnProxyHandleExitTcpTlsConn(conn, identity, configForServe.server)
    return hRes

fn VpnProxyExitTcpTlsWorkerMain(raw: ptr) =
    if raw == nil:
        return
    let encodedFd: uint64 = uint64(raw)
    if encodedFd == uint64(0):
        return
    var tcpConn: tcp.TcpConnectionHandle
    tcpConn.fd = int32(encodedFd) - 1
    tcpConn.open = true
    let blockRes: Result[bool] = tcp.TcpSetNonblocking(tcpConn, false)
    if IsErr(blockRes):
        VpnProxyPrintErr(ErrorText(blockRes))
        tcp.TcpClose(tcpConn)
        return
    let handleRes: Result[bool] = VpnProxyExitWorkerHandleAcceptedConn(tcpConn)
    # [conn-end marker] 归因谁先拆: Ok=客户端 FIN, Err=服务器 relay 错误。
    if IsErr(handleRes):
        VpnProxyPrintErr(strutil.Join(["conn end fd=", strings.Int64ToStr(int64(tcpConn.fd)), " err: ", ErrorText(handleRes)], ""))
    else:
        VpnProxyPrintErr(strutil.Join(["conn end fd=", strings.Int64ToStr(int64(tcpConn.fd)), " ok"], ""))
    # Success paths own the close (CloseTcpTlsForwardLink closed the fd inside
    # the handler); closing again here double-closes the fd and, once the
    # kernel recycles the number, tears down an unrelated new connection
    # (registry_miss on the recycled fd followed by process exit).
    if IsErr(handleRes):
        VpnProxyPrintErr(ErrorText(handleRes))
        tcp.TcpClose(tcpConn)

fn VpnProxyStartExitTcpTlsWorker(conn: var tcp.TcpConnectionHandle,
                                 workerThreads: var thread.Thread[],
                                 joinWorker: bool): Result[bool] =
    if conn.fd < 0:
        return Err[bool]("vpn proxy exit: invalid accepted tcp fd")
    let acceptedFd: int32 = conn.fd
    let encodedFd: uint64 = uint64(acceptedFd + 1)
    let worker = thread.StartPtr(&VpnProxyExitTcpTlsWorkerMain, ptr(encodedFd))
    if worker == nil:
        return Err[bool]("vpn proxy exit: tcp worker start failed")
    conn.fd = -1
    conn.open = false
    if joinWorker:
        add(workerThreads, worker)
        return Ok[bool](true)
    if !thread.Detach(worker):
        return Err[bool]("vpn proxy exit: tcp worker detach failed")
    return Ok[bool](true)

@borrows
fn VpnProxyExitRunLoop(readyPath: str,
                       acceptCount: int32,
                       config: VpnProxyConfig,
                       identity: var VpnProxyLoadedIdentity,
                       listenHost: str,
                       listenPort: int32): int32 =
    VpnProxyExitWorkerConfigPath = config.configPath
    # Handshake phase debug: the per-conn tls_ms/auth_ms metrics in this file
    # say HOW LONG a handshake takes; these lines say WHERE. Output goes to the
    # unit log (stderr) with millisecond prefixes. Volume: ~20 lines/conn.
    hs.msquicTls13SetDebug(true)
    hs.msquicTls13SetPhaseDebug(true)
    hs.msquicTls13SetCertVerifyDebug(true)
    var requireClientCertificate = false
    if config.security.clientCertMode == "required":
        requireClientCertificate = true
    var listenerPolicy: qpolicy.MsQuicTlsPolicy
    let policyRes: Result[bool] = VpnProxyBuildPolicyInto(listenerPolicy,
                                                          identity,
                                                          "vpn-proxy.exit",
                                                          requireClientCertificate,
                                                          false)
    if IsErr(policyRes):
        VpnProxyPrintErr(ErrorText(policyRes))
        return 1
    VpnProxyPrintLine("vpn-proxy fixed policy ok")
    let listenIsV6: bool = strings.StrContains(listenHost, ":")
    var tcpListener: tcp.TcpListenerHandle
    let tcpListenRes: Result[bool] = tcp.TcpListenFill(listenHost, listenPort, tcpListener, listenIsV6)
    if IsErr(tcpListenRes):
        VpnProxyPrintErr(ErrorText(tcpListenRes))
        return 1
    VpnProxyPrintLine("vpn-proxy fixed tcp listen ok")
    let boundListenPort: int32 = tcpListener.addr.port
    let addrRes = quic_transport.Libp2pQuicAddrFromHostPort(listenHost, boundListenPort)
    if IsErr(addrRes):
        VpnProxyPrintErr(ErrorText(addrRes))
        tcp.TcpListenerClose(tcpListener)
        return 1
    VpnProxyPrintLine("vpn-proxy fixed quic addr ok")
    var listener: qtransport.MsQuicTransport
    qtransport.InitMsQuicTransportInto(listener)
    let listenerStartRes: Result[bool] = qtransport.startWithDefaultSettingsPolicyRef(listener, Value(addrRes), listenerPolicy)
    if IsErr(listenerStartRes):
        VpnProxyPrintErr(ErrorText(listenerStartRes))
        tcp.TcpListenerClose(tcpListener)
        return 1
    if !listener.running:
        VpnProxyPrintErr(strings.CloneStr(listener.lastError))
        tcp.TcpListenerClose(tcpListener)
        return 1
    VpnProxyPrintLine("vpn-proxy fixed quic start ok")
    if !VpnProxyWriteReadyPort(readyPath, tcpListener.addr.port):
        VpnProxyPrintErr("vpn proxy: failed to write ready path")
        tcp.TcpListenerClose(tcpListener)
        qtransport.Stop(listener)
        return 1
    let tcpNonblockingRes: Result[bool] = tcp.TcpListenerSetNonblocking(tcpListener, true)
    if IsErr(tcpNonblockingRes):
        VpnProxyPrintErr(ErrorText(tcpNonblockingRes))
        tcp.TcpListenerClose(tcpListener)
        qtransport.Stop(listener)
        return 1
    VpnProxyPrintLine("vpn-proxy exit listening")
    var tcpWorkerThreads: thread.Thread[]
    let joinTcpWorkers: bool = acceptCount > 0
    var served: int32
    while acceptCount <= 0 || served < acceptCount:
        let tcpReadyRes: Result[bool] = tcp.TcpListenerWaitReadable(tcpListener, 25)
        if IsErr(tcpReadyRes):
            VpnProxyPrintErr(ErrorText(tcpReadyRes))
            # A transient wait failure must not kill the whole exit process:
            # log, back off, keep serving. (A probe-connection EOF previously
            # cascaded into process exit via this path.)
            VpnProxyPrintErr(ErrorText(tcpReadyRes))
            os.SleepMs(50)
            continue
        if Value(tcpReadyRes):
            let tcpAcceptRes: Result[tcp.TcpConnectionHandle] = tcp.TcpAcceptNonblocking(tcpListener)
            if IsErr(tcpAcceptRes):
                let acceptErr: str = ErrorText(tcpAcceptRes)
                if acceptErr != "tcp syscall: would block":
                    # Connection-level accept failure: keep the exit alive.
                    VpnProxyPrintErr(strings.CloneStr(acceptErr))
                    os.SleepMs(50)
                continue
            var tcpConn: tcp.TcpConnectionHandle = Value(tcpAcceptRes)
            # around the worker start. REVERT after fix.
            let workerRes: Result[bool] = VpnProxyStartExitTcpTlsWorker(tcpConn,
                                                                        tcpWorkerThreads,
                                                                        joinTcpWorkers)
            if IsErr(workerRes):
                # Worker start failure is connection-scoped: close and serve on.
                tcp.TcpClose(tcpConn)
                VpnProxyPrintErr(ErrorText(workerRes))
                continue
            served = served + 1
            continue
        let acceptRes = qtransport.acceptGlobalTimed(25)
        if IsErr(acceptRes):
            let err: str = strings.CloneStr(ErrorText(acceptRes))
            if VpnProxyExitAcceptTransientError(err):
                # Transient QUIC accept errors fire continuously; yield the
                # core instead of hot-spinning (measured 97% CPU on dosg).
                os.SleepMs(5)
                continue
            VpnProxyPrintErr(strings.CloneStr(err))
            tcp.TcpListenerClose(tcpListener)
            qtransport.Stop(listener)
            let _ = VpnProxyJoinLocalClientWorkers(tcpWorkerThreads)
            return 1
        var conn = Value(acceptRes)
        let handleRes = VpnProxyHandleExitConn(listener, conn, config.server, config.antiBlock.masquerade)
        qconn.ConnClose(conn)
        if IsErr(handleRes):
            let err: str = strings.CloneStr(ErrorText(handleRes))
            if !VpnProxyExitAcceptTransientError(err):
                VpnProxyPrintErr(strings.CloneStr(err))
        served = served + 1
    qtransport.Stop(listener)
    tcp.TcpListenerClose(tcpListener)
    let joinRes: Result[bool] = VpnProxyJoinLocalClientWorkers(tcpWorkerThreads)
    if IsErr(joinRes):
        VpnProxyPrintErr(ErrorText(joinRes))
        return 1
    return 0

fn VpnProxyExit(rootDir: str, args: str[]): int32 =
    rootDir
    VpnProxyPrintLine("vpn-proxy exit")
    var opts: VpnProxyCliOptions
    cli.VpnProxyOptionsFillInto(args, opts)
    var config: VpnProxyConfig
    if !VpnProxyLoadFixedProductionServerConfigInto(config, share(opts.configPath)):
        return 1
    let protocolRes: Result[bool] = VpnProxyRequireHy2TunServerConfig(config)
    if IsErr(protocolRes):
        VpnProxyPrintErr(ErrorText(protocolRes))
        return 1
    if config.protocol == "hy2-tun-v1":
        VpnProxyPrintLine("vpn-proxy protocol hy2-tun-v1")
    var identity: VpnProxyLoadedIdentity
    if !VpnProxyLoadFixedServerIdentityInto(identity):
        return 1
    if identity.certs.len <= 0 || identity.trustRoots.len <= 0 || identity.privateKey.len <= 0:
        VpnProxyPrintErr("vpn proxy: server identity incomplete")
        return 1
    if identity.leafKeyKind == x509.X509KeyUnknown:
        VpnProxyPrintErr("vpn proxy: server leaf key kind missing")
        return 1
    let listenText: str = config.server.listen
    if len(listenText) <= 0:
        VpnProxyPrintErr("vpn proxy: empty listen address")
        return 1
    # Scalar-only v4 listen parse: view strings (SliceBytes chain) have been
    # observed mis-lowered on x86 (retain on an interior pointer => SEGV), so
    # this path never materializes a view.
    var listenParsed: listen.VpnProxyListenAddress
    listenParsed.isV6 = false
    var lastColon: int32 = -1
    var scanIdx: int32
    while scanIdx < len(listenText):
        if int32(listenText[scanIdx]) == 58:
            lastColon = scanIdx
        scanIdx = scanIdx + 1
    if lastColon <= 0 || lastColon + 1 >= len(listenText):
        VpnProxyPrintErr("vpn proxy: listen address must be host:port")
        return 1
    var hostBuf: str = strings.CloneStr("")
    var hostBuildIdx: int32
    while hostBuildIdx < lastColon:
        hostBuf = strings.ConcatStr(hostBuf, strings.CharToStr(int32(listenText[hostBuildIdx]) & 255))
        hostBuildIdx = hostBuildIdx + 1
    listenParsed.host = hostBuf
    var portAcc: int32
    var portBuildIdx: int32 = lastColon + 1
    while portBuildIdx < len(listenText):
        let digit: int32 = int32(listenText[portBuildIdx]) - 48
        if digit < 0 || digit > 9:
            VpnProxyPrintErr("vpn proxy: listen address must be host:port")
            return 1
        portAcc = portAcc * 10 + digit
        portBuildIdx = portBuildIdx + 1
    if portAcc < 0 || portAcc > 65535:
        VpnProxyPrintErr("vpn proxy: listen address must be host:port")
        return 1
    listenParsed.port = portAcc
    let dnsServerText: str = config.server.dnsServer
    let dnsConfigureRes: Result[bool] = exitdns.VpnProxyExitDnsConfigureFromSystem(strings.CloneStr(dnsServerText))
    if IsErr(dnsConfigureRes):
        VpnProxyPrintErr(ErrorText(dnsConfigureRes))
        return 1
    VpnProxyPrintLine(strutil.Join(["vpn-proxy exit dns resolver ", exitdns.VpnProxyExitDnsConfiguredServer()], ""))
    # host/port actually reaching the runloop. REVERT after fix.
    VpnProxyPrintLine(strutil.Join(["vpn-proxy exit listen=", strings.CloneStr(listenParsed.host), " port=", strings.Int64ToStr(listenParsed.port)], ""))
    return VpnProxyExitRunLoop(strings.CloneStr(opts.readyPath), opts.acceptCount, config, identity, strings.CloneStr(listenParsed.host), listenParsed.port)

fn VpnProxyStatus(rootDir: str, args: str[]): int32 =
    rootDir
    VpnProxyPrintLine("vpn-proxy status")
    var opts: VpnProxyCliOptions
    cli.VpnProxyOptionsFillInto(args, opts)
    let configRes: Result[VpnProxyConfig] = VpnProxyLoadConfig(opts.configPath)
    if IsErr(configRes):
        VpnProxyPrintErr(ErrorText(configRes))
        return 1
    var config = Value(configRes)
    if config.exits.len > 0:
        opts.configPath = config.configPath
        let statusConfigDir: str = config.configDir
        var states: VpnProxyExitState[]
        states = routing.VpnProxyInitExitStatesWithClientCertificate(config.exits,
                                                                      VpnProxyConfigSendsClientCertificate(config))
        for i in 0..<states.len:
            var state: VpnProxyExitState = VpnProxyCloneExitState(states[i])
            var rootDirOwned: str = strings.CloneStr(rootDir)
            let probeRes: VpnProxyStatusProbeResult = VpnProxyStatusSuperviseProbe(rootDirOwned,
                                                                                   statusConfigDir,
                                                                                   config.configPath,
                                                                                   i,
                                                                                   opts.probeTimeoutMs)
            state.lastProbeMs = VpnProxyMonoNowMs()
            state.healthy = probeRes.healthy
            state.lastError = probeRes.lastError
            if probeRes.healthy:
                state.probeFailures = 0
                state.recoverySuccesses = 0
                state.ewmaMs = probeRes.sampleMs
                state.lastSampleMs = probeRes.sampleMs
            else:
                state.probeFailures = 1
                state.recoverySuccesses = 0
                state.ewmaMs = 0
                state.lastSampleMs = 0
            VpnProxyStoreExitStateAt(states, i, state)
        var hasTcpTlsForward: bool
        for i in 0..<states.len:
            if VpnProxyExitTransportText(states[i].cfg) == "tcp-tls-forward":
                hasTcpTlsForward = true
        var bestIndex: int32
        if hasTcpTlsForward:
            bestIndex = VpnProxyBestHealthyExitForTransport(states, "tcp-tls-forward", -1)
        else:
            bestIndex = routing.VpnProxyBestHealthyExit(states, -1)
        if len(config.client.listen) > 0:
            var statusLine: str = strings.CloneStr("client.listen=")
            statusLine = statusLine + strings.CloneStr(config.client.listen)
            VpnProxyPrintLine(statusLine)
        if bestIndex >= 0:
            var statusLine: str = strings.CloneStr("best_exit=")
            statusLine = statusLine + strings.CloneStr(states[bestIndex].cfg.name)
            VpnProxyPrintLine(statusLine)
        else:
            VpnProxyPrintLine("best_exit=")
        for i in 0..<states.len:
            let state: VpnProxyExitState = VpnProxyCloneExitState(states[i])
            var statusLine: str = strings.CloneStr("exit.")
            statusLine = statusLine + strings.CloneStr(IntToStr(i))
            statusLine = statusLine + strings.CloneStr(".name=")
            statusLine = statusLine + strings.CloneStr(state.cfg.name)
            VpnProxyPrintLine(statusLine)
            var healthyText: str = "false"
            if state.healthy:
                healthyText = "true"
            var statusLine: str = strings.CloneStr("exit.")
            statusLine = statusLine + strings.CloneStr(IntToStr(i))
            statusLine = statusLine + strings.CloneStr(".healthy=")
            statusLine = statusLine + strings.CloneStr(healthyText)
            VpnProxyPrintLine(statusLine)
            var statusLine: str = strings.CloneStr("exit.")
            statusLine = statusLine + strings.CloneStr(IntToStr(i))
            statusLine = statusLine + strings.CloneStr(".ewma_ms=")
            statusLine = statusLine + strings.CloneStr(int64ToStr(state.ewmaMs))
            VpnProxyPrintLine(statusLine)
            var statusLine: str = strings.CloneStr("exit.")
            statusLine = statusLine + strings.CloneStr(IntToStr(i))
            statusLine = statusLine + strings.CloneStr(".last_error=")
            statusLine = statusLine + strings.CloneStr(state.lastError)
            VpnProxyPrintLine(statusLine)
        return 0
    if len(config.server.listen) > 0:
        var statusLine: str = strings.CloneStr("server.listen=")
        statusLine = statusLine + strings.CloneStr(config.server.listen)
        VpnProxyPrintLine(statusLine)
        return 0
    VpnProxyPrintErr("vpn proxy status: config missing client exits or server.listen")
    return 1

@borrows
fn VpnProxyCurrentExecutablePath(rootDir: var str): str =
    let raw: str = strutil.Strip(cmdline.ProgramName())
    if len(raw) <= 0:
        return ""
    if strutil.Contains(raw, "/") || strutil.Contains(raw, "\\"):
        return chengpath.PathAbsolute(chengpath.PathCurrentDir(), raw)
    return chengpath.PathAbsolute(rootDir, raw)

fn VpnProxyGuiUsage() =
    VpnProxyPrintLine("usage: cheng vpn-proxy gui [--config:<path>] [--runtime-tool:<path>]")
    VpnProxyPrintLine("opens the graphical client and starts local mode from the selected runtime tool")

fn VpnProxyGui(rootDir: str, args: str[]): int32 =
    if args.len > 0:
        let cmd: str = args[0]
        if cmd == "help":
            VpnProxyGuiUsage()
            return 0
        if cmd == "--help":
            VpnProxyGuiUsage()
            return 0
        if cmd == "-h":
            VpnProxyGuiUsage()
            return 0
    let runtimeOverride: str = cli.VpnProxyReadFlag(args, "--runtime-tool", "")
    var runtimeToolPath: str
    if len(strutil.Strip(runtimeOverride)) > 0:
        runtimeToolPath = chengpath.PathAbsolute(rootDir, runtimeOverride)
    else:
        runtimeToolPath = VpnProxyCurrentExecutablePath(rootDir)
    if len(runtimeToolPath) <= 0:
        VpnProxyPrintErr("vpn gui: runtime tool missing")
        return 1
    VpnProxyPrintErr("vpn gui: unavailable in the runtime-only Windows build")
    return 1
