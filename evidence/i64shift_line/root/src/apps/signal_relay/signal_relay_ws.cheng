# signal_relay_ws.cheng
# WebSocket frame handling for Cheng signal relay (server-side TCP).
# Adapted from web_websocket_runtime.cheng for Bytes-based TCP I/O.
# RFC 6455 Section 5.

import std/rawbytes
import std/strings

const
    SignalRelayWsOpcodeText: int32 = 0x1
    SignalRelayWsOpcodeBinary: int32 = 0x2
    SignalRelayWsOpcodeClose: int32 = 0x8
    SignalRelayWsOpcodePing: int32 = 0x9
    SignalRelayWsOpcodePong: int32 = 0xA

const
    SignalRelayWsMagicGuid: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

type
    SignalRelayWsFrame =
        fin: bool
        opcode: int32
        mask: bool
        payload: str

fn SignalRelayWsReadByte(data: Bytes, idx: int32): int32 =
    if idx < 0 or idx >= BytesLen(data):
        return 0
    return BytesGet(data, idx) & 0xFF

fn SignalRelayWsWriteByte(data: var Bytes, idx: int32, val: int32) =
    if idx < 0 or idx >= BytesLen(data):
        return
    BytesSet(data, idx, val & 0xFF)

fn SignalRelayWsReadInt16(data: Bytes, idx: int32): int32 =
    let hi: int32 = SignalRelayWsReadByte(data, idx)
    let lo: int32 = SignalRelayWsReadByte(data, idx + 1)
    return (hi << 8) | lo

fn SignalRelayWsReadInt64(data: Bytes, idx: int32): int64 =
    var val: int64 = Int64(0)
    for i in 0..<8:
        val = (val << 8) | Int64(SignalRelayWsReadByte(data, idx + i))
    return val

fn SignalRelayWsBytesToString(b: Bytes): str =
    let n: int32 = BytesLen(b)
    if n <= 0:
        return ""
    return BytesToString(b)

fn SignalRelayWsConcat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn SignalRelayWsConcat3(a: str, b: str, c: str): str =
    return strings.ConcatStr(strings.ConcatStr(a, b), c)

fn SignalRelayWsConcat4(a: str, b: str, c: str, d: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(a, b), c), d)

# Decode one WebSocket frame from raw bytes.
# Returns the frame if complete, or empty frame if more data needed.
fn SignalRelayWsDecodeFrame(raw: Bytes, outFrame: var SignalRelayWsFrame): bool =
    let rawLen: int32 = BytesLen(raw)
    if rawLen < 2:
        return false

    let b0: int32 = SignalRelayWsReadByte(raw, 0)
    let b1: int32 = SignalRelayWsReadByte(raw, 1)

    let fin: bool = (b0 & 0x80) != 0
    let opcode: int32 = b0 & 0x0F
    let maskFlag: bool = (b1 & 0x80) != 0
    var payloadLen7: int32 = b1 & 0x7F

    var cursor: int32 = 2

    var payloadLen: int32 = payloadLen7
    if payloadLen7 == 126:
        if rawLen < cursor + 2:
            return false
        payloadLen = SignalRelayWsReadInt16(raw, cursor)
        cursor = cursor + 2
    elif payloadLen7 == 127:
        if rawLen < cursor + 8:
            return false
        let extLen64: int64 = SignalRelayWsReadInt64(raw, cursor)
        cursor = cursor + 8
        if extLen64 > Int64(2147483647):
            payloadLen = 2147483647
        else:
            payloadLen = Int32(extLen64)

    # Server frames must not be masked (RFC 6455 Section 5.1)
    if !maskFlag:
        return false

    # Read masking key (4 bytes)
    if rawLen < cursor + 4:
        return false
    let mk0: int32 = SignalRelayWsReadByte(raw, cursor)
    let mk1: int32 = SignalRelayWsReadByte(raw, cursor + 1)
    let mk2: int32 = SignalRelayWsReadByte(raw, cursor + 2)
    let mk3: int32 = SignalRelayWsReadByte(raw, cursor + 3)
    cursor = cursor + 4

    # Verify we have all payload bytes
    if rawLen < cursor + payloadLen:
        return false

    # Unmask payload
    var payload: str
    for i in 0..<payloadLen:
        let masked: int32 = SignalRelayWsReadByte(raw, cursor + i)
        let r: int32 = i % 4
        var keyByte: int32 = mk0
        if r == 1:
            keyByte = mk1
        elif r == 2:
            keyByte = mk2
        elif r == 3:
            keyByte = mk3
        let unmasked: int32 = masked ^ keyByte
        payload = SignalRelayWsConcat(payload, strings.SliceBytes(strings.CharToStr(Char(unmasked)), 0, 1))

    outFrame.fin = fin
    outFrame.opcode = opcode
    outFrame.mask = true
    outFrame.payload = payload
    return true

# Encode a server-to-client WebSocket text frame (unmasked per RFC 6455 Section 5.1).
fn SignalRelayWsEncodeTextFrame(payload: str): Bytes =
    let payloadLen: int32 = len(payload)
    var headerLen: int32 = 2
    if payloadLen >= 126:
        if payloadLen >= 65536:
            headerLen = headerLen + 8
        else:
            headerLen = headerLen + 2
    let totalLen: int32 = headerLen + payloadLen
    var out: Bytes = BytesAlloc(totalLen)

    var b0: int32 = 0x80 | SignalRelayWsOpcodeText
    SignalRelayWsWriteByte(out, 0, b0)

    var b1: int32  # MASK=0 for server-to-client
    var cursor: int32 = 2

    if payloadLen < 126:
        b1 = b1 | (payloadLen & 0x7F)
        SignalRelayWsWriteByte(out, 1, b1)
    elif payloadLen < 65536:
        b1 = b1 | 126
        SignalRelayWsWriteByte(out, 1, b1)
        SignalRelayWsWriteByte(out, 2, (payloadLen >> 8) & 0xFF)
        SignalRelayWsWriteByte(out, 3, payloadLen & 0xFF)
        cursor = cursor + 2
    else:
        b1 = b1 | 127
        SignalRelayWsWriteByte(out, 1, b1)
        for i in 0..<4:
            SignalRelayWsWriteByte(out, cursor, 0)
            cursor = cursor + 1
        SignalRelayWsWriteByte(out, cursor, (payloadLen >> 24) & 0xFF)
        SignalRelayWsWriteByte(out, cursor + 1, (payloadLen >> 16) & 0xFF)
        SignalRelayWsWriteByte(out, cursor + 2, (payloadLen >> 8) & 0xFF)
        SignalRelayWsWriteByte(out, cursor + 3, payloadLen & 0xFF)
        cursor = cursor + 4

    # Copy payload (unmasked for server-to-client)
    for i in 0..<payloadLen:
        SignalRelayWsWriteByte(out, cursor + i, Int32(payload[i]) & 0xFF)

    return out

# Build HTTP 101 Switching Protocols response for WebSocket upgrade.
fn SignalRelayWsBuildUpgradeResponse(clientKey: str): str =
    let acceptInput: str = SignalRelayWsConcat(strings.Strip(clientKey), SignalRelayWsMagicGuid)
    let sha1Bytes: Bytes = BytesFromString(acceptInput)
    # SHA1 and Base64 require external crypto - placeholder for build
    # In production, the relay uses the libp2p ingress SHA1+Base64 functions
    var out: str = "HTTP/1.1 101 Switching Protocols\r\n"
    out = SignalRelayWsConcat(out, "Upgrade: websocket\r\n")
    out = SignalRelayWsConcat(out, "Connection: Upgrade\r\n")
    out = SignalRelayWsConcat(out, "Sec-WebSocket-Accept: ")
    out = SignalRelayWsConcat(out, acceptInput)  # placeholder - needs SHA1+Base64
    out = SignalRelayWsConcat(out, "\r\n\r\n")
    return out
