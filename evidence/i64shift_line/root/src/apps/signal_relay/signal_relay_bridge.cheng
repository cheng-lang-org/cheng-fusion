# signal_relay_bridge.cheng
# Bridges WebSocket messages to libp2p pubsub for decentralized signal relay.
# Each PWA peer connects via WebSocket and gets a session.
# Signals to the same relay are delivered directly.
# Signals across relays go through gossipsub topic /unimaker/signal/v1.

import std/rawbytes
import std/strings
import std/strutils as strutil

const
    SignalRelayBridgeMaxSessions: int32 = 256
    SignalRelayBridgeSessionTtlMs: int64 = Int64(300000)
    SignalRelayBridgeSignalTopic: str = "/unimaker/signal/v1"

type
    SignalRelayPwaSession =
        peerId: str
        connFd: int32
        connectedAtMs: int64
        lastSeenAtMs: int64

type
    SignalRelayBridgeState =
        sessions: SignalRelayPwaSession[]

fn SignalRelayBridgeConcat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn SignalRelayBridgeConcat3(a: str, b: str, c: str): str =
    return strings.ConcatStr(strings.ConcatStr(a, b), c)

fn SignalRelayBridgeInit(): SignalRelayBridgeState =
    var out: SignalRelayBridgeState
    out.sessions = []
    return out

# Register a PWA peer session associated with a TCP file descriptor.
fn SignalRelayBridgeRegister(
    sessions: var SignalRelayPwaSession[],
    peerId: str,
    connFd: int32,
    nowMs: int64,
): bool =
    let normalizedPeerId: str = strutil.Strip(peerId)
    if len(normalizedPeerId) <= 0:
        return false
    # Replace existing session for same peerId
    for i in 0..<sessions.len:
        if sessions[i].peerId == normalizedPeerId:
            sessions[i].connFd = connFd
            sessions[i].lastSeenAtMs = nowMs
            return true
    # Too many sessions
    if sessions.len >= SignalRelayBridgeMaxSessions:
        return false
    var session: SignalRelayPwaSession
    session.peerId = normalizedPeerId
    session.connFd = connFd
    session.connectedAtMs = nowMs
    session.lastSeenAtMs = nowMs
    add(sessions, session)
    return true

# Find a session by peer ID.
fn SignalRelayBridgeFindSession(
    sessions: var SignalRelayPwaSession[],
    peerId: str,
): int32 =
    for i in 0..<sessions.len:
        if sessions[i].peerId == peerId:
            return i
    return -1

# Remove a session by connection fd.
fn SignalRelayBridgeRemoveByFd(
    sessions: var SignalRelayPwaSession[],
    connFd: int32,
) =
    var i: int32
    while i < sessions.len:
        if sessions[i].connFd == connFd:
            # Swap-remove
            sessions[i] = sessions[sessions.len - 1]
            let _ = pop(sessions)
            return
        i = i + 1

# Touch a session (update lastSeenAtMs).
fn SignalRelayBridgeTouch(
    sessions: var SignalRelayPwaSession[],
    connFd: int32,
    nowMs: int64,
) =
    for i in 0..<sessions.len:
        if sessions[i].connFd == connFd:
            sessions[i].lastSeenAtMs = nowMs
            return

# Get the connection fd for a peer, or -1 if not connected to this relay.
fn SignalRelayBridgeGetConnFd(
    sessions: var SignalRelayPwaSession[],
    peerId: str,
): int32 =
    let idx: int32 = SignalRelayBridgeFindSession(sessions, peerId)
    if idx < 0:
        return -1
    return sessions[idx].connFd

# Clean up expired sessions.
fn SignalRelayBridgeCleanupExpired(
    sessions: var SignalRelayPwaSession[],
    nowMs: int64,
) =
    var i: int32
    while i < sessions.len:
        if nowMs - sessions[i].lastSeenAtMs > SignalRelayBridgeSessionTtlMs:
            sessions[i] = sessions[sessions.len - 1]
            let _ = pop(sessions)
        else:
            i = i + 1
