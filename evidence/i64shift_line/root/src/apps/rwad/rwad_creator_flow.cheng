# rwad_creator_flow.cheng - creator funding flow: stake escrow -> usage
# batch submission (Merkle-Sum root) -> challenge/slash -> settle split.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/chain/rwad_bridge_contract as brg
import cheng/apps/rwad/rwad_settlement as ssm

const
    CffDraft: int32 = 0
    CffFunded: int32 = 1
    CffSubmitted: int32 = 2
    CffChallenged: int32 = 3
    CffSettled: int32 = 4

type
    CreatorFlow =
        campaignCid: layout.FixedBytes32
        creatorCid: layout.FixedBytes32
        platformCid: layout.FixedBytes32
        stakeAmount: int64
        status: int32
        rootOfLastBatch: layout.FixedBytes32
        lockedRemaining: int64

fn FlowFund(st: var ssm.SsmState, flow: var CreatorFlow,
            sponsorCid: layout.FixedBytes32, stakeAmount: int64,
            expiresAt: int64): Result[bool] =
    if flow.status != CffDraft:
        return Err[bool]("cff: already funded")
    let lRes = ssm.SsmEscrowLock(st, flow.campaignCid, sponsorCid, stakeAmount, expiresAt)
    if !lRes.ok:
        return Err[bool](lRes.err.msg)
    flow.stakeAmount = stakeAmount
    flow.lockedRemaining = stakeAmount
    flow.status = CffFunded
    return Ok[bool](true)

@borrows
fn FlowSubmitUsageBatch(st: var ssm.SsmState, flow: var CreatorFlow,
                        entries: brg.BridgeEntry[], batchCid: layout.FixedBytes32,
                        nowMs: int64, windowMs: int64): Result[bool] =
    if flow.status != CffFunded and flow.status != CffChallenged:
        return Err[bool]("cff: flow not submittable")
    let rootRes = brg.BridgeBatchRoot(entries)
    if !rootRes.ok:
        return Err[bool](rootRes.err.msg)
    var total: int64 = 0
    var i: int32
    while i < entries.len:
        total = total + entries[i].amount
        i = i + 1
    var totals: ssm.SsmBatchTotals
    totals.totalPayout = total
    totals.totalFees = 0
    totals.totalCount = Int64(entries.len)
    let subRes = ssm.SsmBatchSubmit(st, batchCid, Int64(0), rootRes.value, totals, nowMs, windowMs)
    if !subRes.ok:
        return Err[bool](subRes.err.msg)
    flow.rootOfLastBatch = rootRes.value
    flow.status = CffSubmitted
    return Ok[bool](true)

fn FlowChallenge(st: var ssm.SsmState, flow: var CreatorFlow,
                 challenger: layout.FixedBytes32, proofValid: bool): Result[bool] =
    if !proofValid:
        return Ok[bool](false)
    if flow.status != CffSubmitted:
        return Err[bool]("cff: nothing submitted to challenge")
    let slashAmount: int64 = flow.stakeAmount / Int64(10)
    let sRes = ssm.SsmEscrowSlashWithSplit(st, flow.campaignCid, slashAmount, challenger)
    if !sRes.ok:
        return Err[bool](sRes.err.msg)
    flow.lockedRemaining = flow.lockedRemaining - slashAmount
    flow.status = CffChallenged
    return Ok[bool](true)

fn FlowSettle(st: var ssm.SsmState, flow: var CreatorFlow,
              creatorShareBp: int32): Result[bool] =
    if flow.status != CffSubmitted:
        return Err[bool]("cff: only submitted flows settle")
    if creatorShareBp < 0 or creatorShareBp > 10000:
        return Err[bool]("cff: share bp out of range")
    let creatorCut: int64 = flow.lockedRemaining * Int64(creatorShareBp) / Int64(10000)
    let platformCut: int64 = flow.lockedRemaining - creatorCut
    let cRel = ssm.SsmEscrowRelease(st, flow.campaignCid, flow.creatorCid, creatorCut)
    if !cRel.ok:
        return Err[bool](cRel.err.msg)
    let pRel = ssm.SsmEscrowRelease(st, flow.campaignCid, flow.platformCid, platformCut)
    if !pRel.ok:
        return Err[bool](pRel.err.msg)
    flow.status = CffSettled
    return Ok[bool](true)
