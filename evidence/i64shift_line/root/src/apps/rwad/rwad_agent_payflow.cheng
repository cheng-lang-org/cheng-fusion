# rwad_agent_payflow.cheng - AI agent quote / lock / metered-charge /
# refund flow on top of the settlement escrow state.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/chain/lsmr_types as lt
import cheng/apps/rwad/rwad_settlement as ssm

const
    ApfLockEscrowTag: int32 = 91

type
    AgentQuote =
        quoteCid: layout.FixedBytes32
        agentCid: layout.FixedBytes32
        clientCid: layout.FixedBytes32
        pricePerCall: int64
        maxCalls: int32
        expiresAtMs: int64

    AgentBook =
        quote: AgentQuote
        lockEscrowCid: layout.FixedBytes32
        lockedCalls: int32
        usedCalls: int32
        refunded: bool
        locked: bool

fn FlowQuote(book: var AgentBook, q: AgentQuote): Result[bool] =
    if q.pricePerCall <= 0:
        return Err[bool]("apf: price must be positive")
    if q.maxCalls <= 0:
        return Err[bool]("apf: maxCalls must be positive")
    if q.expiresAtMs <= 0:
        return Err[bool]("apf: expiry must be positive")
    book.quote = q
    book.locked = false
    book.refunded = false
    book.usedCalls = 0
    book.lockedCalls = 0
    return Ok[bool](true)

fn FlowLock(st: var ssm.SsmState, book: var AgentBook,
            lockEscrowCid: layout.FixedBytes32, nowMs: int64): Result[bool] =
    if book.locked:
        return Err[bool]("apf: already locked")
    if nowMs > book.quote.expiresAtMs:
        return Err[bool]("apf: quote expired")
    let total: int64 = book.quote.pricePerCall * Int64(book.quote.maxCalls)
    let lRes = ssm.SsmEscrowLock(st, lockEscrowCid, book.quote.clientCid, total, book.quote.expiresAtMs)
    if !lRes.ok:
        return Err[bool](lRes.err.msg)
    book.lockEscrowCid = lockEscrowCid
    book.lockedCalls = book.quote.maxCalls
    book.locked = true
    return Ok[bool](true)

fn FlowCharge(st: var ssm.SsmState, book: var AgentBook,
              receiptHash: layout.FixedBytes32,
              expectedReceipt: layout.FixedBytes32): Result[bool] =
    if !layout.FixedBytes32Equal(receiptHash, expectedReceipt):
        return Err[bool]("apf: receipt mismatch")
    if book.refunded:
        return Err[bool]("apf: book refunded")
    if book.usedCalls >= book.lockedCalls:
        return Err[bool]("apf: call budget exhausted")
    let rRes = ssm.SsmEscrowRelease(st, book.lockEscrowCid, book.quote.agentCid, book.quote.pricePerCall)
    if !rRes.ok:
        return Err[bool](rRes.err.msg)
    book.usedCalls = book.usedCalls + 1
    return Ok[bool](true)

fn FlowRefund(st: var ssm.SsmState, book: var AgentBook): Result[bool] =
    if book.refunded:
        return Err[bool]("apf: already refunded")
    if book.usedCalls >= book.lockedCalls:
        return Err[bool]("apf: nothing to refund")
    let remaining: int64 = book.quote.pricePerCall * Int64(book.lockedCalls - book.usedCalls)
    let rRes = ssm.SsmEscrowRelease(st, book.lockEscrowCid, book.quote.clientCid, remaining)
    if !rRes.ok:
        return Err[bool](rRes.err.msg)
    book.refunded = true
    return Ok[bool](true)
