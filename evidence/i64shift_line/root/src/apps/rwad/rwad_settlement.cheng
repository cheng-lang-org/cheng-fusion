# rwad_settlement.cheng - escrow / batch / challenge-slash semantics.
#
# Migration of RWAD-blockchain rwad_settlement onto the LSMR kernel,
# preserving the original module's observable semantics exactly:
#   applyEscrowLock          -> SsmEscrowLock
#   applyBatchChallenge      -> SsmBatchChallenge (invalid proof: no-op false)
#   applyEscrowSlashWithSplit-> SsmEscrowSlashWithSplit
#                               reward = amt*rewardBp/10000 to challenger,
#                               burn   = amt*burnBp/10000 to burnBucket,
#                               remainder to safetyFund; lock shrinks.
# Account identity is a 32-byte LSMR cid (the original repo used strings).
# State lives in parallel arrays per kernel style; every mutation is an
# explicit hard-fail on precondition breach.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/chain/lsmr_types as lt

const
    SsmRewardBpDefault: int32 = 200
    SsmBurnBpDefault: int32 = 300
    SsmEscrowLocked: int32 = 0
    SsmEscrowReleased: int32 = 1
    SsmEscrowChallenged: int32 = 2
    SsmEscrowSlashed: int32 = 3
    SsmEscrowRefunded: int32 = 4
    SsmBatchSubmitted: int32 = 0
    SsmBatchChallenged: int32 = 1
    SsmBatchFinalized: int32 = 2
    SsmBatchRejected: int32 = 3

type
    SsmParams =
        challengeRewardBp: int32
        burnBp: int32

    SsmPools =
        burnBucket: int64
        safetyFund: int64
        rewardPool: int64

    SsmEscrow =
        escrowCid: layout.FixedBytes32
        payer: layout.FixedBytes32
        amountLocked: int64
        amountReleased: int64
        expiresAt: int64
        status: int32

    SsmBatchTotals =
        totalPayout: int64
        totalFees: int64
        totalCount: int64

    SsmBatch =
        batchCid: layout.FixedBytes32
        epoch: int64
        merkleRoot: layout.FixedBytes32
        totals: SsmBatchTotals
        status: int32
        challengeUntil: int64

    SsmState =
        balAccounts: layout.FixedBytes32[]
        balAmounts: int64[]
        escrows: SsmEscrow[]
        batches: SsmBatch[]
        pools: SsmPools
        params: SsmParams

fn SsmInit(): SsmState =
    var s: SsmState
    s.params.challengeRewardBp = SsmRewardBpDefault
    s.params.burnBp = SsmBurnBpDefault
    return s

@borrows
fn SsmBalanceOf(st: SsmState, account: layout.FixedBytes32): int64 =
    var i: int32
    while i < st.balAccounts.len:
        if layout.FixedBytes32Equal(st.balAccounts[i], account):
            return st.balAmounts[i]
        i = i + 1
    return 0

fn SsmCredit(st: var SsmState, account: layout.FixedBytes32, amount: int64): Result[bool] =
    if amount < 0:
        return Err[bool]("ssm: negative credit")
    var i: int32
    while i < st.balAccounts.len:
        if layout.FixedBytes32Equal(st.balAccounts[i], account):
            st.balAmounts[i] = st.balAmounts[i] + amount
            return Ok[bool](true)
        i = i + 1
    add(st.balAccounts, account)
    add(st.balAmounts, amount)
    return Ok[bool](true)

fn SsmDebit(st: var SsmState, account: layout.FixedBytes32, amount: int64): Result[bool] =
    if amount < 0:
        return Err[bool]("ssm: negative debit")
    var i: int32
    while i < st.balAccounts.len:
        if layout.FixedBytes32Equal(st.balAccounts[i], account):
            if st.balAmounts[i] < amount:
                return Err[bool]("ssm: insufficient balance")
            st.balAmounts[i] = st.balAmounts[i] - amount
            return Ok[bool](true)
        i = i + 1
    return Err[bool]("ssm: unknown account")

# Lock funds from payer into a new escrow record.
fn SsmEscrowLock(st: var SsmState, escrowCid: layout.FixedBytes32,
                 payer: layout.FixedBytes32, amount: int64,
                 expiresAt: int64): Result[bool] =
    if amount <= 0:
        return Err[bool]("ssm: escrow amount must be positive")
    let dRes = SsmDebit(st, payer, amount)
    if !dRes.ok:
        return Err[bool](dRes.err.msg)
    var e: SsmEscrow
    e.escrowCid = escrowCid
    e.payer = payer
    e.amountLocked = amount
    e.amountReleased = 0
    e.expiresAt = expiresAt
    e.status = SsmEscrowLocked
    add(st.escrows, e)
    return Ok[bool](true)

# Submit a batch with its challenge deadline.
fn SsmBatchSubmit(st: var SsmState, batchCid: layout.FixedBytes32, epoch: int64,
                  merkleRoot: layout.FixedBytes32, totals: SsmBatchTotals,
                  nowMs: int64, challengeWindowMs: int64): Result[bool] =
    var i: int32
    while i < st.batches.len:
        if layout.FixedBytes32Equal(st.batches[i].batchCid, batchCid):
            return Err[bool]("ssm: duplicate batch id")
        i = i + 1
    var b: SsmBatch
    b.batchCid = batchCid
    b.epoch = epoch
    b.merkleRoot = merkleRoot
    b.totals = totals
    b.status = SsmBatchSubmitted
    b.challengeUntil = nowMs + challengeWindowMs
    add(st.batches, b)
    return Ok[bool](true)

# Challenge semantics preserved from the original module: an invalid proof
# is a no-op returning false (batch stays submitted); a valid proof moves
# submitted -> challenged and returns true. Any other source status errors.
fn SsmBatchChallenge(st: var SsmState, batchCid: layout.FixedBytes32,
                     proofValid: bool): Result[bool] =
    var i: int32
    while i < st.batches.len:
        if layout.FixedBytes32Equal(st.batches[i].batchCid, batchCid):
            if !proofValid:
                return Ok[bool](false)
            if st.batches[i].status != SsmBatchSubmitted:
                return Err[bool]("ssm: batch not challengeable")
            st.batches[i].status = SsmBatchChallenged
            return Ok[bool](true)
        i = i + 1
    return Err[bool]("ssm: unknown batch")

# Slash split identical to the original: challenger reward from bp, burn
# bucket from bp, the remainder lands in the safety fund.
fn SsmEscrowSlashWithSplit(st: var SsmState, escrowCid: layout.FixedBytes32,
                           slashAmount: int64,
                           challenger: layout.FixedBytes32): Result[bool] =
    if slashAmount <= 0:
        return Err[bool]("ssm: slash amount must be positive")
    var i: int32
    while i < st.escrows.len:
        if layout.FixedBytes32Equal(st.escrows[i].escrowCid, escrowCid):
            if st.escrows[i].status == SsmEscrowSlashed:
                return Err[bool]("ssm: escrow already slashed")
            if st.escrows[i].amountLocked < slashAmount:
                return Err[bool]("ssm: slash exceeds locked amount")
            let reward: int64 = slashAmount * Int64(st.params.challengeRewardBp) / Int64(10000)
            let burn: int64 = slashAmount * Int64(st.params.burnBp) / Int64(10000)
            let safety: int64 = slashAmount - reward - burn
            let cRes = SsmCredit(st, challenger, reward)
            if !cRes.ok:
                return Err[bool](cRes.err.msg)
            st.pools.burnBucket = st.pools.burnBucket + burn
            st.pools.safetyFund = st.pools.safetyFund + safety
            st.escrows[i].amountLocked = st.escrows[i].amountLocked - slashAmount
            st.escrows[i].status = SsmEscrowSlashed
            return Ok[bool](true)
        i = i + 1
    return Err[bool]("ssm: unknown escrow")

# Release part of a locked escrow to a payee (settlement payout leg).
fn SsmEscrowRelease(st: var SsmState, escrowCid: layout.FixedBytes32,
                    payee: layout.FixedBytes32, amount: int64): Result[bool] =
    if amount <= 0:
        return Err[bool]("ssm: release amount must be positive")
    var i: int32
    while i < st.escrows.len:
        if layout.FixedBytes32Equal(st.escrows[i].escrowCid, escrowCid):
            if st.escrows[i].amountLocked < amount:
                return Err[bool]("ssm: release exceeds locked")
            st.escrows[i].amountLocked = st.escrows[i].amountLocked - amount
            st.escrows[i].amountReleased = st.escrows[i].amountReleased + amount
            if st.escrows[i].amountLocked == 0:
                st.escrows[i].status = SsmEscrowReleased
            let cRes = SsmCredit(st, payee, amount)
            if !cRes.ok:
                return Err[bool](cRes.err.msg)
            return Ok[bool](true)
        i = i + 1
    return Err[bool]("ssm: unknown escrow")
