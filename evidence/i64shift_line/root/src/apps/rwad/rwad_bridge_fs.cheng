# rwad_bridge_fs.cheng - file-system shell of the bridge contract.
# Wire frame (binary, big-endian):
#   "RWBX" | u32 entryCount | entries { 32B cid | i64 amount } | 32B root
# Export serializes a finalized batch; apply re-derives the Merkle-Sum
# root from the entries and refuses the file on any mismatch (drift,
# truncation, or tamper). Final home: this repo (cheng-lang) - the
# economic kernel is self-contained; no cross-repo dependency remains.

import std/system
import std/rawbytes
import std/result
import std/os
import cheng/std/bytes_layout as layout
import cheng/chain/rwad_bridge_contract as brg
import cheng/apps/rwad/rwad_settlement as ssm

const
    BfsMagic0: int32 = 82
    BfsMagic1: int32 = 87
    BfsMagic2: int32 = 66
    BfsMagic3: int32 = 88
    BfsHeaderLen: int32 = 8
    BfsEntryLen: int32 = 40
    BfsRootLen: int32 = 32

fn BfsPutU32(buf: var Bytes, off: int32, v: int32) =
    BytesSet(buf, off + 0, (v / 16777216) % 256)
    BytesSet(buf, off + 1, (v / 65536) % 256)
    BytesSet(buf, off + 2, (v / 256) % 256)
    BytesSet(buf, off + 3, v % 256)

@borrows
fn BfsGetU32(buf: Bytes, off: int32): int32 =
    return Int32(BytesGet(buf, off)) * 16777216 + Int32(BytesGet(buf, off + 1)) * 65536 + Int32(BytesGet(buf, off + 2)) * 256 + Int32(BytesGet(buf, off + 3))

fn BfsPutI64(buf: var Bytes, off: int32, v: int64) =
    var k: int32
    while k < 8:
        BytesSet(buf, off + k, Int32((v >> (56 - k * 8)) % 256))
        k = k + 1

@borrows
fn BfsGetI64(buf: Bytes, off: int32): int64 =
    var v: int64 = 0
    var k: int32
    while k < 8:
        v = v * 256 + Int64(BytesGet(buf, off + k))
        k = k + 1
    return v

@borrows
fn BfsExportFile(entries: brg.BridgeEntry[], root: layout.FixedBytes32,
                 path: str): Result[bool] =
    let total: int32 = BfsHeaderLen + BfsEntryLen * entries.len + BfsRootLen
    var buf = BytesAlloc(total)
    BytesSet(buf, 0, BfsMagic0)
    BytesSet(buf, 1, BfsMagic1)
    BytesSet(buf, 2, BfsMagic2)
    BytesSet(buf, 3, BfsMagic3)
    BfsPutU32(buf, 4, entries.len)
    var off: int32 = BfsHeaderLen
    var i: int32
    while i < entries.len:
        let cidBytes = layout.FixedBytes32ToBytes(entries[i].accountCid)
        var k: int32
        while k < 32:
            BytesSet(buf, off + k, BytesGet(cidBytes, k))
            k = k + 1
        BfsPutI64(buf, off + 32, entries[i].amount)
        off = off + BfsEntryLen
        i = i + 1
    let rootBytes = layout.FixedBytes32ToBytes(root)
    var r: int32
    while r < 32:
        BytesSet(buf, off + r, BytesGet(rootBytes, r))
        r = r + 1
    let wRes = os.WriteFileBytesResult(path, buf)
    if !wRes.ok:
        # literal message: never propagate a str across Result here (ORC
        # registry_miss trigger, see gate known_debts / repro or5)
        return Err[bool]("bfs: write failed")
    return Ok[bool](true)

@borrows
fn BfsApplyFile(st: var ssm.SsmState, path: str,
                batchCid: layout.FixedBytes32, nowMs: int64,
                windowMs: int64): Result[bool] =
    # explicit precondition: refuse absent files before touching the reader
    # (also avoids a kernel ORC early-return path; see gate known_debts)
    if !os.FileExists(path):
        return Err[bool]("bfs: file not found")
    let rRes = os.ReadFileBytesResult(path)
    if !rRes.ok:
        # literal message: never propagate a str across Result here (ORC
        # registry_miss trigger, see gate known_debts / repro or5)
        return Err[bool]("bfs: read failed")
    let buf: Bytes = rRes.value
    if buf.len < BfsHeaderLen + BfsRootLen:
        return Err[bool]("bfs: truncated frame")
    if BytesGet(buf, 0) != BfsMagic0 or BytesGet(buf, 1) != BfsMagic1 or BytesGet(buf, 2) != BfsMagic2 or BytesGet(buf, 3) != BfsMagic3:
        return Err[bool]("bfs: bad magic")
    let count: int32 = BfsGetU32(buf, 4)
    if count < 0 or buf.len != BfsHeaderLen + BfsEntryLen * count + BfsRootLen:
        return Err[bool]("bfs: length mismatch")
    var entries: brg.BridgeEntry[]
    # parallel copies: BridgeBatchRoot consumes the entry array, so keep
    # cid/amount aside for the total and credit passes afterwards.
    var cidsKeep: layout.FixedBytes32[]
    var amountsKeep: int64[]
    var off: int32 = BfsHeaderLen
    var i: int32
    while i < count:
        var raw = BytesAlloc(32)
        var k: int32
        while k < 32:
            BytesSet(raw, k, BytesGet(buf, off + k))
            k = k + 1
        let cidRes = layout.FixedBytes32FromBytes(raw)
        if !cidRes.ok:
            return Err[bool]("bfs: bad cid")
        var eEntry: brg.BridgeEntry
        eEntry.accountCid = cidRes.value
        eEntry.amount = BfsGetI64(buf, off + 32)
        add(entries, eEntry)
        add(cidsKeep, cidRes.value)
        add(amountsKeep, eEntry.amount)
        off = off + BfsEntryLen
        i = i + 1
    let calc = brg.BridgeBatchRoot(entries)
    if !calc.ok:
        return Err[bool](calc.err.msg)
    var rootRaw = BytesAlloc(32)
    var r2: int32
    while r2 < 32:
        BytesSet(rootRaw, r2, BytesGet(buf, off + r2))
        r2 = r2 + 1
    let fileRoot = layout.FixedBytes32FromBytes(rootRaw)
    if !fileRoot.ok:
        return Err[bool]("bfs: bad root field")
    if !layout.FixedBytes32Equal(calc.value, fileRoot.value):
        return Err[bool]("bfs: root mismatch (tampered or drifted file)")
    var total: int64 = 0
    var j: int32
    while j < amountsKeep.len:
        total = total + amountsKeep[j]
        j = j + 1
    var totals: ssm.SsmBatchTotals
    totals.totalPayout = total
    totals.totalFees = 0
    totals.totalCount = Int64(amountsKeep.len)
    let sub = ssm.SsmBatchSubmit(st, batchCid, Int64(0), calc.value, totals, nowMs, windowMs)
    if !sub.ok:
        return Err[bool](sub.err.msg)
    var m: int32
    while m < amountsKeep.len:
        if amountsKeep[m] > 0:
            let cred = ssm.SsmCredit(st, cidsKeep[m], amountsKeep[m])
            if !cred.ok:
                return Err[bool](cred.err.msg)
        m = m + 1
    return Ok[bool](true)
