# rwad_settlement_cycle.cheng - unified settlement-cycle orchestration:
# reserve discipline gate -> creator flow -> agent payflow -> depin settle
# run on ONE shared settlement state, with per-flow cid namespaces and a
# global conservation audit over the whole cycle.
#
# The orchestrator owns no ledgers of its own; it sequences the existing
# flow modules and computes the closure identity:
#   credited == sum(final balances) + pools(burn+safety) + outstanding escrow

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_creator_flow as cff
import cheng/apps/rwad/rwad_agent_payflow as apf
import cheng/apps/rwad/rwad_depin_settle as dps
import cheng/apps/rwad/rwad_reserve as rsv

type
    CycleCids =
        creatorCampaign: layout.FixedBytes32
        agentLockEscrow: layout.FixedBytes32
        depinCycle: layout.FixedBytes32
        creatorBatch1: layout.FixedBytes32
        creatorBatch2: layout.FixedBytes32

    CycleAudit =
        totalCredited: int64
        finalBalances: int64
        finalPools: int64
        finalEscrowLocked: int64
        closed: bool

fn CidTagged(tag: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, tag)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn CycleAuditCompute(st: ssm.SsmState, totalCredited: int64): CycleAudit =
    var audit: CycleAudit
    var balSum: int64 = 0
    var i: int32
    while i < st.balAmounts.len:
        balSum = balSum + st.balAmounts[i]
        i = i + 1
    # outstanding = live collateral: Locked(0)/Challenged(2)/Slashed(3);
    # only Released(1) and Refunded(4) have fully unwound.
    var lockedSum: int64 = 0
    var j: int32
    while j < st.escrows.len:
        if st.escrows[j].status != 1 and st.escrows[j].status != 4:
            lockedSum = lockedSum + (st.escrows[j].amountLocked - st.escrows[j].amountReleased)
        j = j + 1
    audit.totalCredited = totalCredited
    audit.finalBalances = balSum
    audit.finalPools = st.pools.burnBucket + st.pools.safetyFund + st.pools.rewardPool
    audit.finalEscrowLocked = lockedSum
    audit.closed = (totalCredited == balSum + audit.finalPools + lockedSum)
    return audit

# Namespace guard: the three flow escrow ids must be pairwise distinct so
# no release can ever cross a flow boundary.
@borrows
fn CycleNamespacesDistinct(cids: CycleCids): Result[bool] =
    if layout.FixedBytes32Equal(cids.creatorCampaign, cids.agentLockEscrow):
        return Err[bool]("cyc: campaign collides with agent lock")
    if layout.FixedBytes32Equal(cids.creatorCampaign, cids.depinCycle):
        return Err[bool]("cyc: campaign collides with depin cycle")
    if layout.FixedBytes32Equal(cids.agentLockEscrow, cids.depinCycle):
        return Err[bool]("cyc: agent lock collides with depin cycle")
    return Ok[bool](true)
