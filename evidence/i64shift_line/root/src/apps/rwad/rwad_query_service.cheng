# rwad_query_service.cheng - read-only query surface with a fixed wire
# format: 4B BE kind + 32B key request; 1B ok + 8B BE value response.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout

const
    QsKindBalance: int32 = 1
    QsKindEscrowLocked: int32 = 2
    QsWireRequestLen: int32 = 36

type
    QueryRequest =
        kind: int32
        keyCid: layout.FixedBytes32

fn QueryEncode(req: QueryRequest): Bytes =
    var buf = BytesAlloc(QsWireRequestLen)
    BytesSet(buf, 3, req.kind % 256)
    BytesSet(buf, 2, (req.kind / 256) % 256)
    BytesSet(buf, 1, (req.kind / 65536) % 256)
    BytesSet(buf, 0, (req.kind / 16777216) % 256)
    let k = layout.FixedBytes32ToBytes(req.keyCid)
    var i: int32
    while i < 32:
        BytesSet(buf, 4 + i, BytesGet(k, i))
        i = i + 1
    return buf

fn QueryDecode(b: Bytes): Result[QueryRequest] =
    if b.len < QsWireRequestLen:
        return Err[QueryRequest]("qs: short request")
    let kind: int32 = Int32(BytesGet(b, 0)) * 16777216 + Int32(BytesGet(b, 1)) * 65536 + Int32(BytesGet(b, 2)) * 256 + Int32(BytesGet(b, 3))
    var raw = BytesAlloc(32)
    var i: int32
    while i < 32:
        BytesSet(raw, i, BytesGet(b, 4 + i))
        i = i + 1
    let cidRes = layout.FixedBytes32FromBytes(raw)
    if !cidRes.ok:
        return Err[QueryRequest]("qs: bad key")
    var outQ: QueryRequest
    outQ.kind = kind
    outQ.keyCid = cidRes.value
    return Ok[QueryRequest](outQ)
