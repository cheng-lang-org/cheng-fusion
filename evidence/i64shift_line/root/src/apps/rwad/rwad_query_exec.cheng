# rwad_query_exec.cheng - execution half of the query surface, split from
# the wire codec so settlement stays the only owner of SsmState mutation.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_query_service as qs

const
    QxKindBalance: int32 = 1
    QxKindEscrowLocked: int32 = 2

@borrows
fn QueryExecute(st: ssm.SsmState, req: qs.QueryRequest): Result[int64] =
    if req.kind == QxKindBalance:
        return Ok[int64](ssm.SsmBalanceOf(st, req.keyCid))
    if req.kind == QxKindEscrowLocked:
        var i: int32
        while i < st.escrows.len:
            if layout.FixedBytes32Equal(st.escrows[i].escrowCid, req.keyCid):
                return Ok[int64](st.escrows[i].amountLocked)
            i = i + 1
        return Err[int64]("qs: unknown escrow")
    return Err[int64]("qs: unsupported kind")

fn QueryResponseWire(okFlag: bool, value: int64): Bytes =
    var buf = BytesAlloc(9)
    if okFlag:
        BytesSet(buf, 0, 1)
    else:
        BytesSet(buf, 0, 0)
    var i: int32
    while i < 8:
        BytesSet(buf, 1 + i, Int32((value >> (56 - i * 8)) % 256))
        i = i + 1
    return buf
