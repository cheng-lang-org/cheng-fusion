# rwad_gov_cert_flow.cheng - on-ledger governance flow for the key-epoch
# forced line. A raise proposal is a deterministic 32-byte motion record;
# committee members sign it with their CURRENT epoch keys; the flow
# verifies every vote under its own convention, requires 2f+1 valid
# votes, and only then applies GovSetMinEpoch. No off-ledger authority.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/libp2p/crypto/ed25519/ed25519 as ed
import cheng/apps/rwad/rwad_gov_epoch as gov

type
    GcfVote =
        pubKey: Bytes
        sig: Bytes
        epoch: int32

# Motion record for raising the forced line to `target`:
#   [0]=0xA1 marker, [1]=target, [2..31]=nonce derived from saltTag.
# Deterministic: every committee member derives the identical bytes.
fn GcfMotionBytes(target: int32, saltTag: int32): Bytes =
    var m = BytesAlloc(32)
    BytesSet(m, 0, 0xA1)
    BytesSet(m, 1, target)
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, saltTag)
    BytesSet(raw, 1, 0x5A)
    let saltRes = layout.FixedBytes32FromBytes(raw)
    if saltRes.ok:
        let salt = layout.FixedBytes32ToBytes(saltRes.value)
        var i: int32 = 2
        while i < 32:
            BytesSet(m, i, BytesGet(salt, i))
            i = i + 1
    return m

# Verify the vote set against the motion; apply the raise only when
# strictly more than f votes (i.e. >= 2f+1 assuming f is the max faulty)
# are valid AND each vote's epoch clears nothing extra here - admission
# of the voter identity itself is the caller's registry concern.
@borrows
fn BytesEqual(a: Bytes, b: Bytes): bool =
    if a.len != b.len:
        return false
    var i: int32
    while i < a.len:
        if BytesGet(a, i) != BytesGet(b, i):
            return false
        i = i + 1
    return true

@borrows
fn GcfApplyRaiseByQuorum(book: var gov.GovEpochBook,
                         votes: GcfVote[], motion: Bytes,
                         committeePks: Bytes[], f: int32,
                         target: int32, nowMs: int64): Result[bool] =
    if target < book.minKeyEpoch:
        return Err[bool]("gcf: cannot lower the forced line")
    var valid: int32 = 0
    var i: int32
    while i < votes.len:
        # membership gate first: a cryptographically valid signature from a
        # key NOT on the committee roster must never count toward quorum.
        var isMember: bool = false
        var j: int32
        while j < committeePks.len:
            if BytesEqual(committeePks[j], votes[i].pubKey):
                isMember = true
            j = j + 1
        if isMember and ed.verifyEd25519Epoch(votes[i].pubKey, motion, votes[i].sig, votes[i].epoch):
            valid = valid + 1
        i = i + 1
    if valid < 2 * f + 1:
        return Err[bool]("gcf: proposal quorum not reached")
    return gov.GovSetMinEpoch(book, target, nowMs)
