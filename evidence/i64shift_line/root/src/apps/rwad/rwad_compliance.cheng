# rwad_compliance.cheng - F-phase compliance closure: governed slashing
# parameters (whitelist + hard bounds) and a deterministic compliance
# report rendered from the live settlement state.
#
# Governance rule: parameter changes arrive as (rewardBp, burnBp) pairs;
# rewardBp+burnBp must stay <= 10000 (remainder funds the safety fund),
# each must be non-negative, and the pair must be on the approved grid.

import std/system
import std/rawbytes
import std/result
import cheng/std/strings as strings
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_disclosure as dsc

const
    CmpApprovedPairs: str = "200x300|100x400|200x300|500x500|0x10000"

type
    CmpSlashParams =
        challengeRewardBp: int32
        burnBp: int32

fn CmpPairOnGrid(rewardBp: int32, burnBp: int32): bool =
    # approved grid is small; exact string compare against canonical forms
    var target: str = dsc.DscI64(Int64(rewardBp)) + "x" + dsc.DscI64(Int64(burnBp))
    let gridLen: int32 = strings.Len(CmpApprovedPairs)
    var i: int32 = 0
    while i < gridLen:
        var j: int32 = i
        while j < gridLen:
            if osSliceStr(CmpApprovedPairs, j, j) == "|":
                break
            j = j + 1
        let entry: str = osSliceStr(CmpApprovedPairs, i, j - 1)
        if entry == target:
            return true
        i = j + 1
    return false

fn CmpValidateParams(rewardBp: int32, burnBp: int32): Result[bool] =
    if rewardBp < 0 or burnBp < 0:
        return Err[bool]("cmp: negative bp")
    if rewardBp + burnBp > 10000:
        return Err[bool]("cmp: split exceeds total")
    if !CmpPairOnGrid(rewardBp, burnBp):
        return Err[bool]("cmp: pair not on approved grid")
    return Ok[bool](true)

fn CmpApplyParams(st: var ssm.SsmState, rewardBp: int32, burnBp: int32): Result[bool] =
    let v = CmpValidateParams(rewardBp, burnBp)
    if !v.ok:
        return Err[bool](v.err.msg)
    st.params.challengeRewardBp = rewardBp
    st.params.burnBp = burnBp
    return Ok[bool](true)

@borrows
fn CmpReport(st: ssm.SsmState): Result[str] =
    # hard invariants, checked not narrated
    if st.params.challengeRewardBp < 0 or st.params.burnBp < 0:
        return Err[str]("cmp: negative params in state")
    if st.params.challengeRewardBp + st.params.burnBp > 10000:
        return Err[str]("cmp: param split exceeds total")
    if st.pools.burnBucket < 0 or st.pools.safetyFund < 0 or st.pools.rewardPool < 0:
        return Err[str]("cmp: negative pool")
    var outS: str = "compliance|params|reward=" + dsc.DscI64(Int64(st.params.challengeRewardBp)) + "|burn=" + dsc.DscI64(Int64(st.params.burnBp)) + "\n"
    outS = outS + "compliance|pool_burn|" + dsc.DscI64(st.pools.burnBucket) + "\n"
    outS = outS + "compliance|pool_safety|" + dsc.DscI64(st.pools.safetyFund) + "\n"
    outS = outS + "compliance|pool_reward|" + dsc.DscI64(st.pools.rewardPool) + "\n"
    var slashCount: int32 = 0
    var i: int32
    while i < st.escrows.len:
        if st.escrows[i].status == 3:
            slashCount = slashCount + 1
        i = i + 1
    outS = outS + "compliance|slash_events|" + dsc.DscI64(Int64(slashCount)) + "\n"
    return Ok[str](outS)
