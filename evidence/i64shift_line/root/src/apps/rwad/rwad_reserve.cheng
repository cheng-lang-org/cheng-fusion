# rwad_reserve.cheng - reserve discipline: no unbacked minting, capped
# credit issuance with TTL freeze, monotone custody snapshot binding.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout

const
    RsvDefaultCapBp: int32 = 500
    RsvDefaultTtlMs: int64 = 604800000

type
    ReserveBook =
        reserveProofHash: layout.FixedBytes32
        reserveAmount: int64
        mintedSupply: int64
        creditCapBp: int32
        creditTtlMs: int64
        snapshotHash: layout.FixedBytes32
        snapshotTs: int64

    CreditLine =
        accountCid: layout.FixedBytes32
        principal: int64
        issuedAtMs: int64
        frozen: bool

fn ResInit(book: var ReserveBook, proofHash: layout.FixedBytes32,
           reserveAmount: int64, capBp: int32, ttlMs: int64): Result[bool] =
    if capBp < 0 or capBp > 10000:
        return Err[bool]("rsv: cap bp out of range")
    book.reserveProofHash = proofHash
    book.reserveAmount = reserveAmount
    book.mintedSupply = 0
    book.creditCapBp = capBp
    book.creditTtlMs = ttlMs
    book.snapshotTs = -1
    return Ok[bool](true)

fn ResMint(book: var ReserveBook, amount: int64,
           proofHash: layout.FixedBytes32): Result[bool] =
    if !layout.FixedBytes32Equal(proofHash, book.reserveProofHash):
        return Err[bool]("rsv: reserve proof mismatch")
    if amount <= 0:
        return Err[bool]("rsv: non-positive mint")
    if book.mintedSupply + amount > book.reserveAmount:
        return Err[bool]("rsv: mint exceeds reserve (unbacked supply)")
    book.mintedSupply = book.mintedSupply + amount
    return Ok[bool](true)

@borrows
fn CreditOutstanding(lines: CreditLine[]): int64 =
    var total: int64 = 0
    var i: int32
    while i < lines.len:
        if !lines[i].frozen:
            total = total + lines[i].principal
        i = i + 1
    return total

# Issuance mutates only the lines array; the cap inputs pass by scalar so
# the caller keeps ownership of the book.
fn ResIssueCredit(mintedSupply: int64, creditCapBp: int32,
                  lines: var CreditLine[], account: layout.FixedBytes32,
                  amount: int64, nowMs: int64): Result[bool] =
    if amount <= 0:
        return Err[bool]("rsv: non-positive credit")
    let outstanding: int64 = CreditOutstanding(lines)
    let projected: int64 = outstanding + amount
    if projected * Int64(10000) > mintedSupply * Int64(creditCapBp):
        return Err[bool]("rsv: credit cap exceeded")
    var i: int32
    while i < lines.len:
        if layout.FixedBytes32Equal(lines[i].accountCid, account):
            if !lines[i].frozen:
                return Err[bool]("rsv: active line exists for account")
        i = i + 1
    var line: CreditLine
    line.accountCid = account
    line.principal = amount
    line.issuedAtMs = nowMs
    line.frozen = false
    add(lines, line)
    return Ok[bool](true)

fn ResFreezeExpired(lines: var CreditLine[], ttlMs: int64, nowMs: int64): int32 =
    var frozenCount: int32 = 0
    var i: int32
    while i < lines.len:
        if !lines[i].frozen:
            if nowMs - lines[i].issuedAtMs > ttlMs:
                lines[i].frozen = true
                frozenCount = frozenCount + 1
        i = i + 1
    return frozenCount

@borrows
fn ResGuardSpend(lines: CreditLine[], account: layout.FixedBytes32): Result[bool] =
    var i: int32
    while i < lines.len:
        if layout.FixedBytes32Equal(lines[i].accountCid, account):
            if lines[i].frozen:
                return Err[bool]("rsv: frozen credit blocks spend")
        i = i + 1
    return Ok[bool](true)

fn ResSnapshotBind(book: var ReserveBook, hash: layout.FixedBytes32,
                   ts: int64): Result[bool] =
    if book.snapshotTs >= 0 and ts <= book.snapshotTs:
        return Err[bool]("rsv: snapshot timestamp not monotone")
    book.snapshotHash = hash
    book.snapshotTs = ts
    return Ok[bool](true)

@borrows
fn ResSnapshotVerify(book: ReserveBook,
                     claimedHash: layout.FixedBytes32): Result[bool] =
    if !layout.FixedBytes32Equal(claimedHash, book.snapshotHash):
        return Err[bool]("rsv: snapshot hash mismatch")
    return Ok[bool](true)
