# rwad_disclosure.cheng - D4 kernel-side disclosure feed: renders the
# settlement ledger into a deterministic line record (label|hexcid|value)
# that the product repo can pull verbatim. No heuristics: every number is
# read straight from the state arrays; the closed flag recomputes the
# conservation identity on every render.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/std/strings as strings

const
    DscHexDigits: str = "0123456789abcdef"

fn DscI64(v: int64): str =
    if v == 0:
        return "0"
    var neg: bool = false
    var x: int64 = v
    if x < 0:
        neg = true
        x = -x
    var digits: str = ""
    while x > 0:
        let d: int32 = Int32(x % 10)
        digits = osSliceStr(DscHexDigits, d, d) + digits
        x = x / 10
    if neg:
        return "-" + digits
    return digits

fn DebugLen(s: str): int32 =
    return StrLenFast(s)

# exact substring scan (naive, deterministic; disclosure lines are short)
@borrows
fn DscContains(haystack: str, needle: str): bool =
    let hLen: int32 = strings.Len(haystack)
    let nLen: int32 = strings.Len(needle)
    if nLen == 0:
        return true
    if nLen > hLen:
        return false
    var i: int32
    while i <= hLen - nLen:
        var allMatch: bool = true
        var k: int32
        while k < nLen:
            if osSliceStr(haystack, i + k, i + k) != osSliceStr(needle, k, k):
                allMatch = false
            k = k + 1
        if allMatch:
            return true
        i = i + 1
    return false

fn DscHex(b: layout.FixedBytes32): str =
    let cb = layout.FixedBytes32ToBytes(b)
    var hex: str = ""
    var k: int32
    while k < 32:
        let byteVal: int32 = BytesGet(cb, k)
        let hi: int32 = byteVal / 16
        let lo: int32 = byteVal % 16
        hex = hex + osSliceStr(DscHexDigits, hi, hi)
        hex = hex + osSliceStr(DscHexDigits, lo, lo)
        k = k + 1
    return hex

@borrows
fn DisclosureRender(st: ssm.SsmState, cycleLabel: str): Result[str] =
    var outS: str = "disclosure|" + cycleLabel + "\n"
    var i: int32
    while i < st.balAccounts.len:
        outS = outS + "balance|" + DscHex(st.balAccounts[i]) + "|" + DscI64(st.balAmounts[i]) + "\n"
        i = i + 1
    outS = outS + "pool|burn|" + DscI64(st.pools.burnBucket) + "\n"
    outS = outS + "pool|safety|" + DscI64(st.pools.safetyFund) + "\n"
    outS = outS + "pool|reward|" + DscI64(st.pools.rewardPool) + "\n"
    var lockedSum: int64 = 0
    var escCount: int32 = 0
    var j: int32
    while j < st.escrows.len:
        # Locked(0)/Challenged(2)/Slashed(3) still hold live collateral
        if st.escrows[j].status != 1 and st.escrows[j].status != 4:
            lockedSum = lockedSum + (st.escrows[j].amountLocked - st.escrows[j].amountReleased)
            escCount = escCount + 1
        j = j + 1
    outS = outS + "escrow|outstanding|" + DscI64(lockedSum) + "\n"
    outS = outS + "escrow|live_count|" + DscI64(Int64(escCount)) + "\n"
    var balSum: int64 = 0
    var m: int32
    while m < st.balAmounts.len:
        balSum = balSum + st.balAmounts[m]
        m = m + 1
    let poolsAll: int64 = st.pools.burnBucket + st.pools.safetyFund + st.pools.rewardPool
    # closure needs the credited total; the renderer takes it via a marker
    # the caller appends: disclosure is complete only with credit_total set.
    outS = outS + "audit|balances|" + DscI64(balSum) + "\n"
    outS = outS + "audit|pools|" + DscI64(poolsAll) + "\n"
    return Ok[str](outS)

@borrows
fn DisclosureClosureLine(st: ssm.SsmState, totalCredited: int64): str =
    var balSum: int64 = 0
    var i: int32
    while i < st.balAmounts.len:
        balSum = balSum + st.balAmounts[i]
        i = i + 1
    var lockedSum: int64 = 0
    var j: int32
    while j < st.escrows.len:
        # same live-collateral rule as the renderer
        if st.escrows[j].status != 1 and st.escrows[j].status != 4:
            lockedSum = lockedSum + (st.escrows[j].amountLocked - st.escrows[j].amountReleased)
        j = j + 1
    let poolsAll: int64 = st.pools.burnBucket + st.pools.safetyFund + st.pools.rewardPool
    let closed: bool = totalCredited == balSum + poolsAll + lockedSum
    if closed:
        return "audit|closed|1|credited=" + DscI64(totalCredited) + "\n"
    return "audit|closed|0|credited=" + DscI64(totalCredited) + "\n"
