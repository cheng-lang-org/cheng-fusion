# rwad_gov_epoch.cheng - governance key-epoch floor: a monotonically
# raising minimum identity epoch. Identities whose epoch sits below the
# forced line are refused; the floor never moves down, only accepts the
# canonical epochs {0, 1}, and every raise binds an activation timestamp.

import std/system
import std/result

type
    GovEpochBook =
        minKeyEpoch: int32
        currentEpoch: int32
        activatedAtMs: int64

fn GovInit(book: var GovEpochBook, currentEpoch: int32): Result[bool] =
    if currentEpoch != 0 and currentEpoch != 1:
        return Err[bool]("invalid epoch")
    book.minKeyEpoch = 0
    book.currentEpoch = currentEpoch
    book.activatedAtMs = -1
    return Ok[bool](true)

fn GovSetMinEpoch(book: var GovEpochBook, target: int32, nowMs: int64): Result[bool] =
    if target != 0 and target != 1:
        return Err[bool]("invalid epoch")
    if target < book.minKeyEpoch:
        return Err[bool]("cannot lower floor")
    book.minKeyEpoch = target
    book.activatedAtMs = nowMs
    return Ok[bool](true)

@borrows
fn GovAcceptIdentity(book: GovEpochBook, epoch: int32): Result[bool] =
    if epoch < book.minKeyEpoch:
        return Err[bool]("epoch below forced line")
    return Ok[bool](true)

@borrows
fn GovIsForced(book: GovEpochBook): bool =
    return book.minKeyEpoch > 0
