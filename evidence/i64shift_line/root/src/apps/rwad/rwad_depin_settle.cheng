# rwad_depin_settle.cheng - DePIN metering cycle: evidence meters ->
# Merle-Sum batch -> payer escrow lock -> challenge window -> per-provider
# payout finalize.
#
# Fixed-point convention: amounts are gpuHoursMilli * unitPriceMilli /
# 1000000, i.e. hours*price with both factors scaled by 1e3.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/chain/rwad_bridge_contract as brg
import cheng/apps/rwad/rwad_settlement as ssm

const
    DpsOpen: int32 = 0
    DpsSubmitted: int32 = 1
    DpsFinalized: int32 = 2

type
    DepinMeter =
        providerCid: layout.FixedBytes32
        gpuHoursMilli: int64
        unitPriceMilli: int64
        evidenceDigest: layout.FixedBytes32

    DepinCycle =
        cycleCid: layout.FixedBytes32
        payerCid: layout.FixedBytes32
        meters: DepinMeter[]
        root: layout.FixedBytes32
        challengeUntilMs: int64
        status: int32
        totalDue: int64

fn ZeroDigest(d: layout.FixedBytes32): bool =
    let b = layout.FixedBytes32ToBytes(d)
    var i: int32
    while i < 32:
        if BytesGet(b, i) != 0:
            return false
        i = i + 1
    return true

fn CycleAddMeter(cycle: var DepinCycle, m: DepinMeter): Result[bool] =
    if cycle.status != DpsOpen:
        return Err[bool]("dps: cycle not open")
    if m.gpuHoursMilli <= 0:
        return Err[bool]("dps: non-positive metering")
    if m.unitPriceMilli < 0:
        return Err[bool]("dps: negative price")
    if ZeroDigest(m.evidenceDigest):
        return Err[bool]("dps: empty evidence digest")
    add(cycle.meters, m)
    return Ok[bool](true)

fn CycleSubmit(cycle: var DepinCycle, st: var ssm.SsmState,
               windowMs: int64, nowMs: int64): Result[bool] =
    if cycle.status != DpsOpen:
        return Err[bool]("dps: cycle not open")
    if cycle.meters.len == 0:
        return Err[bool]("dps: no meters")
    var entries: brg.BridgeEntry[]
    var total: int64 = 0
    var i: int32
    while i < cycle.meters.len:
        var e: brg.BridgeEntry
        e.accountCid = cycle.meters[i].providerCid
        e.amount = cycle.meters[i].gpuHoursMilli * cycle.meters[i].unitPriceMilli / Int64(1000000)
        total = total + e.amount
        add(entries, e)
        i = i + 1
    let rootRes = brg.BridgeBatchRoot(entries)
    if !rootRes.ok:
        return Err[bool](rootRes.err.msg)
    cycle.root = rootRes.value
    cycle.totalDue = total
    let lockRes = ssm.SsmEscrowLock(st, cycle.cycleCid, cycle.payerCid, total, nowMs + windowMs)
    if !lockRes.ok:
        return Err[bool](lockRes.err.msg)
    var totals: ssm.SsmBatchTotals
    totals.totalPayout = total
    totals.totalFees = 0
    totals.totalCount = Int64(cycle.meters.len)
    let subRes = ssm.SsmBatchSubmit(st, cycle.cycleCid, Int64(0), cycle.root, totals, nowMs, windowMs)
    if !subRes.ok:
        return Err[bool](subRes.err.msg)
    cycle.challengeUntilMs = nowMs + windowMs
    cycle.status = DpsSubmitted
    return Ok[bool](true)

fn CycleFinalize(cycle: var DepinCycle, st: var ssm.SsmState, nowMs: int64): Result[bool] =
    if cycle.status != DpsSubmitted:
        return Err[bool]("dps: cycle not submitted")
    if nowMs < cycle.challengeUntilMs:
        return Err[bool]("dps: challenge window open")
    var i: int32
    while i < cycle.meters.len:
        let amount: int64 = cycle.meters[i].gpuHoursMilli * cycle.meters[i].unitPriceMilli / Int64(1000000)
        if amount > 0:
            let rRes = ssm.SsmEscrowRelease(st, cycle.cycleCid, cycle.meters[i].providerCid, amount)
            if !rRes.ok:
                return Err[bool](rRes.err.msg)
        i = i + 1
    cycle.status = DpsFinalized
    return Ok[bool](true)
