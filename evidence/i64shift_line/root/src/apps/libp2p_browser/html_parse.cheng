import std/strings
import std/strutils as strutil
import cheng/core/runtime/web_runtime as web

const
    HtmlFormKindInput: int32 = 1
    HtmlFormKindTextarea: int32 = 2
    HtmlFormKindSelect: int32 = 3
    HtmlFormKindButton: int32 = 4
    HtmlHandlerClick: int32 = 1
    HtmlHandlerInput: int32 = 2
    HtmlHandlerChange: int32 = 3
    HtmlHandlerSubmit: int32 = 4

fn HtmlIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\n' || ch == '\r'

fn HtmlIsAlpha(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    return ch >= 'A' && ch <= 'Z'

fn HtmlIsNameChar(ch: char): bool =
    if HtmlIsAlpha(ch):
        return true
    if ch >= '0' && ch <= '9':
        return true
    return ch == '-' || ch == '_' || ch == ':'

fn HtmlLowerChar(ch: char): char =
    if ch >= 'A' && ch <= 'Z':
        return char(int32(ch) + 32)
    return ch

@borrows
fn HtmlSlice(text: str, start: int32, stopExclusive: int32): str =
    if start < 0 || stopExclusive <= start || start >= text.len:
        return ""
    var stop = stopExclusive
    if stop > text.len:
        stop = text.len
    return strings.ConcatStr(strings.SliceBytes(text, start, stop - start), "")

@borrows
fn HtmlSkipWs(text: str, pos: int32): int32 =
    var i = pos
    while i < text.len && HtmlIsWs(text[i]):
        i = i + 1
    return i

@borrows
fn HtmlEqualsIgnoreCase(left: str, right: str): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if HtmlLowerChar(left[i]) != HtmlLowerChar(right[i]):
            return false
    return true

@borrows
fn HtmlStartsAtIgnoreCase(text: str, pos: int32, needle: str): bool =
    if pos < 0 || needle.len <= 0:
        return false
    if pos + needle.len > text.len:
        return false
    for i in 0..<needle.len:
        if HtmlLowerChar(text[pos + i]) != HtmlLowerChar(needle[i]):
            return false
    return true

@borrows
fn HtmlIsVoidTag(tag: str): bool =
    if tag == "area" || tag == "base" || tag == "br" || tag == "col":
        return true
    if tag == "embed" || tag == "hr" || tag == "img" || tag == "input":
        return true
    if tag == "link" || tag == "meta" || tag == "param" || tag == "source":
        return true
    if tag == "track" || tag == "wbr":
        return true
    return false

@borrows
fn HtmlIsRawTextTag(tag: str): bool =
    return tag == "script" || tag == "style" || tag == "textarea" || tag == "title" || tag == "noscript"

@borrows
fn HtmlIsHeadTag(tag: str): bool =
    if tag == "meta" || tag == "title" || tag == "link" || tag == "style":
        return true
    if tag == "script" || tag == "base" || tag == "noscript":
        return true
    return false

@borrows
fn HtmlIsHiddenTag(tag: str): bool =
    if tag == "script" || tag == "style" || tag == "meta" || tag == "link":
        return true
    if tag == "head" || tag == "noscript" || tag == "template":
        return true
    return false

fn HtmlHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'a' && ch <= 'f':
        return int32(ch) - int32('a') + 10
    if ch >= 'A' && ch <= 'F':
        return int32(ch) - int32('A') + 10
    return -1

fn HtmlAppendCodepoint(parts: var str[], code: int32) =
    if code <= 0:
        return
    if code < 128:
        add(parts, strings.CharToStr(char(code)))
        return
    if code < 2048:
        add(parts, strings.CharToStr(char(192 + code / 64)))
        add(parts, strings.CharToStr(char(128 + code % 64)))
        return
    if code < 65536:
        add(parts, strings.CharToStr(char(224 + code / 4096)))
        add(parts, strings.CharToStr(char(128 + (code / 64) % 64)))
        add(parts, strings.CharToStr(char(128 + code % 64)))
        return
    add(parts, strings.CharToStr(char(240 + code / 262144)))
    add(parts, strings.CharToStr(char(128 + (code / 4096) % 64)))
    add(parts, strings.CharToStr(char(128 + (code / 64) % 64)))
    add(parts, strings.CharToStr(char(128 + code % 64)))

@borrows
fn HtmlDecodeEntities(text: str): str =
    if text.len <= 0:
        return ""
    var parts: str[]
    var i: int32 = 0
    while i < text.len:
        if text[i] != '&':
            add(parts, strings.CharToStr(text[i]))
            i = i + 1
            continue
        var semi = i + 1
        while semi < text.len && text[semi] != ';' && semi - i < 32:
            semi = semi + 1
        if semi >= text.len || text[semi] != ';':
            add(parts, "&")
            i = i + 1
            continue
        let body = HtmlSlice(text, i + 1, semi)
        if body == "amp":
            add(parts, "&")
        elif body == "lt":
            add(parts, "<")
        elif body == "gt":
            add(parts, ">")
        elif body == "quot":
            add(parts, "\"")
        elif body == "apos":
            add(parts, "'")
        elif body == "nbsp":
            HtmlAppendCodepoint(parts, 160)
        elif body.len >= 2 && body[0] == '#':
            var code: int32 = 0
            var ok = true
            if body[1] == 'x' || body[1] == 'X':
                if body.len <= 2:
                    ok = false
                var hi = 2
                while hi < body.len:
                    let hv = HtmlHexValue(body[hi])
                    if hv < 0:
                        ok = false
                    if ok:
                        code = code * 16 + hv
                    hi = hi + 1
            else:
                var di = 1
                while di < body.len:
                    if body[di] < '0' || body[di] > '9':
                        ok = false
                    if ok:
                        code = code * 10 + (int32(body[di]) - int32('0'))
                    di = di + 1
            if ok && code > 0:
                HtmlAppendCodepoint(parts, code)
            else:
                add(parts, HtmlSlice(text, i, semi + 1))
        else:
            add(parts, HtmlSlice(text, i, semi + 1))
        i = semi + 1
    return strutil.Join(parts, "")

@borrows
fn HtmlTrimAscii(text: str): str =
    var start: int32 = 0
    var stop = text.len
    while start < stop && HtmlIsWs(text[start]):
        start = start + 1
    while stop > start && HtmlIsWs(text[stop - 1]):
        stop = stop - 1
    return HtmlSlice(text, start, stop)

@borrows
fn HtmlParseStyleDeclarations(document: var web.WebDocument, nodeId: int32, styleText: str) =
    var i: int32 = 0
    while i < styleText.len:
        var semi = i
        while semi < styleText.len && styleText[semi] != ';':
            semi = semi + 1
        let decl = HtmlTrimAscii(HtmlSlice(styleText, i, semi))
        if decl.len > 0:
            var colon: int32 = 0
            while colon < decl.len && decl[colon] != ':':
                colon = colon + 1
            if colon > 0 && colon < decl.len:
                let name = strutil.ToLowerAscii(HtmlTrimAscii(HtmlSlice(decl, 0, colon)))
                let value = HtmlTrimAscii(HtmlSlice(decl, colon + 1, decl.len))
                if name.len > 0 && value.len > 0:
                    web.WebDocumentSetInlineStyleValue(document, nodeId, name, value)
        i = semi + 1

@borrows
fn HtmlCurrent(stack: int32[]): int32 =
    if stack.len <= 0:
        return 0
    return stack[stack.len - 1]

fn HtmlPush(stack: var int32[], nodeId: int32) =
    add(stack, nodeId)

fn HtmlPop(stack: var int32[]) =
    if stack.len > 0:
        setLen(stack, stack.len - 1)

@borrows
fn HtmlPopUntilTag(document: var web.WebDocument, stack: var int32[], tag: str, htmlId: int32, bodyId: int32, headId: int32) =
    var guard: int32 = 0
    while stack.len > 0 && guard < 4096:
        let top = HtmlCurrent(stack)
        if top == htmlId:
            return
        var topTag: str
        if web.WebDocumentNodeTagName(document, top, topTag):
            if topTag == tag:
                HtmlPop(stack)
                return
        if top == bodyId || top == headId:
            return
        HtmlPop(stack)
        guard = guard + 1

@borrows
fn HtmlSkipCommentOrDoctype(html: str, pos: int32): int32 =
    if HtmlStartsAtIgnoreCase(html, pos, "<!--"):
        var i = pos + 4
        while i + 2 < html.len:
            if html[i] == '-' && html[i + 1] == '-' && html[i + 2] == '>':
                return i + 3
            i = i + 1
        return html.len
    var i = pos
    while i < html.len && html[i] != '>':
        i = i + 1
    if i < html.len:
        return i + 1
    return html.len

@borrows
fn HtmlParseQuoted(html: str, pos: int32, quote: char, outStop: var int32): str =
    var i = pos
    while i < html.len && html[i] != quote:
        i = i + 1
    outStop = i
    if i < html.len:
        outStop = i + 1
    return HtmlDecodeEntities(HtmlSlice(html, pos, i))

@borrows
fn HtmlParseAttributes(html: str, pos: int32, tagEnd: var int32, names: var str[], values: var str[], selfClosing: var bool): bool =
    names = []
    values = []
    selfClosing = false
    var i = HtmlSkipWs(html, pos)
    while i < html.len:
        if html[i] == '>':
            tagEnd = i + 1
            return true
        if html[i] == '/' && i + 1 < html.len && html[i + 1] == '>':
            selfClosing = true
            tagEnd = i + 2
            return true
        if !HtmlIsNameChar(html[i]):
            i = i + 1
            continue
        var nameStart = i
        while i < html.len && HtmlIsNameChar(html[i]):
            i = i + 1
        let rawName = HtmlSlice(html, nameStart, i)
        let name = strings.ConcatStr(strutil.ToLowerAscii(rawName), "")
        i = HtmlSkipWs(html, i)
        var value = strings.ConcatStr(name, "")
        if i < html.len && html[i] == '=':
            i = HtmlSkipWs(html, i + 1)
            if i >= html.len:
                tagEnd = html.len
                return false
            if html[i] == '"' || html[i] == '\'':
                let quote = html[i]
                var after: int32
                value = HtmlParseQuoted(html, i + 1, quote, after)
                i = after
            else:
                var vStart = i
                while i < html.len && !HtmlIsWs(html[i]) && html[i] != '>' && html[i] != '/':
                    i = i + 1
                value = HtmlDecodeEntities(HtmlSlice(html, vStart, i))
        add(names, name)
        add(values, value)
        i = HtmlSkipWs(html, i)
    tagEnd = html.len
    return false

@borrows
fn HtmlApplyEventAttrs(document: var web.WebDocument, nodeId: int32, tag: str, names: str[], values: str[]) =
    var hasClick = false
    var hasInput = false
    var hasChange = false
    var hasSubmit = false
    for i in 0..<names.len:
        let n = names[i]
        if n == "onclick":
            hasClick = true
        elif n == "oninput":
            hasInput = true
        elif n == "onchange":
            hasChange = true
        elif n == "onsubmit":
            hasSubmit = true
    if tag == "a" || tag == "button" || hasClick:
        web.WebDocumentAddEventListener(document, nodeId, "click", HtmlHandlerClick, false, false)
    if tag == "input" || tag == "textarea" || hasInput:
        web.WebDocumentAddEventListener(document, nodeId, "input", HtmlHandlerInput, false, false)
    if tag == "input" || tag == "textarea" || tag == "select" || hasChange:
        web.WebDocumentAddEventListener(document, nodeId, "change", HtmlHandlerChange, false, false)
    if tag == "form" || hasSubmit:
        web.WebDocumentAddEventListener(document, nodeId, "submit", HtmlHandlerSubmit, false, false)

@borrows
fn HtmlApplyFormControl(document: var web.WebDocument, nodeId: int32, tag: str, names: str[], values: str[]) =
    if tag == "input":
        var inputType = "text"
        var value = ""
        var checked = false
        var disabled = false
        for i in 0..<names.len:
            if names[i] == "type" && values[i].len > 0:
                inputType = strutil.ToLowerAscii(values[i])
            elif names[i] == "value":
                value = values[i]
            elif names[i] == "checked":
                checked = true
            elif names[i] == "disabled":
                disabled = true
        web.WebDocumentSetFormControl(document, nodeId, HtmlFormKindInput, strings.ConcatStr(inputType, ""))
        web.WebDocumentSetFormValue(document, nodeId, strings.ConcatStr(value, ""))
        web.WebDocumentSetChecked(document, nodeId, checked)
        web.WebDocumentSetDisabled(document, nodeId, disabled)
        return
    if tag == "textarea":
        web.WebDocumentSetFormControl(document, nodeId, HtmlFormKindTextarea, "textarea")
        return
    if tag == "select":
        web.WebDocumentSetFormControl(document, nodeId, HtmlFormKindSelect, "select")
        return
    if tag == "button":
        var buttonType = "submit"
        for i in 0..<names.len:
            if names[i] == "type" && values[i].len > 0:
                buttonType = strutil.ToLowerAscii(values[i])
        web.WebDocumentSetFormControl(document, nodeId, HtmlFormKindButton, buttonType)

@borrows
fn HtmlReadRawText(html: str, pos: int32, tag: str, outStop: var int32): str =
    var i = pos
    let close = strings.ConcatStr("</", strings.ConcatStr(tag, ">"))
    while i < html.len:
        if HtmlStartsAtIgnoreCase(html, i, close):
            outStop = i + close.len
            return HtmlSlice(html, pos, i)
        i = i + 1
    outStop = html.len
    return HtmlSlice(html, pos, html.len)

var HtmlParseErrorText: str
var HtmlParseCssText: str
var HtmlParseLinkHrefText: str

fn HtmlParseError(): str =
    return HtmlParseErrorText

fn HtmlParseCss(): str =
    return HtmlParseCssText

fn HtmlParseLinks(): str =
    return HtmlParseLinkHrefText

@borrows
fn HtmlParseDocument(html: str, document: var web.WebDocument): bool =
    HtmlParseErrorText = ""
    HtmlParseCssText = ""
    HtmlParseLinkHrefText = ""
    if html.len <= 0:
        HtmlParseErrorText = "html_parse: empty document"
        return false
    web.WebDocumentInit(document)
    let docId = web.WebDocumentCreateDocumentNode(document)
    let htmlId = web.WebDocumentCreateElement(document, "html")
    let headId = web.WebDocumentCreateElement(document, "head")
    let bodyId = web.WebDocumentCreateElement(document, "body")
    if !web.WebDocumentAppendChild(document, docId, htmlId):
        HtmlParseErrorText = "html_parse: append html"
        return false
    if !web.WebDocumentAppendChild(document, htmlId, headId):
        HtmlParseErrorText = "html_parse: append head"
        return false
    if !web.WebDocumentAppendChild(document, htmlId, bodyId):
        HtmlParseErrorText = "html_parse: append body"
        return false
    web.WebDocumentSetInlineStyleValue(document, headId, "display", "none")
    var stack: int32[]
    HtmlPush(stack, htmlId)
    HtmlPush(stack, bodyId)
    var cssParts: str[]
    var linkParts: str[]
    var pos: int32 = 0
    var inHead = false
    if html.len >= 3 && int32(html[0]) == 239 && int32(html[1]) == 187 && int32(html[2]) == 191:
        pos = 3
    while pos < html.len:
        if html[pos] != '<':
            var textEnd = pos
            while textEnd < html.len && html[textEnd] != '<':
                textEnd = textEnd + 1
            let rawText = HtmlDecodeEntities(HtmlSlice(html, pos, textEnd))
            var allWs = true
            for ti in 0..<rawText.len:
                if !HtmlIsWs(rawText[ti]):
                    allWs = false
            if !allWs && rawText.len > 0:
                var parent = HtmlCurrent(stack)
                if parent == htmlId:
                    parent = bodyId
                if inHead && parent == headId:
                    parent = headId
                let textId = web.WebDocumentCreateText(document, rawText)
                if !web.WebDocumentAppendChild(document, parent, textId):
                    HtmlParseErrorText = "html_parse: append text"
                    return false
                var parentTag: str
                if web.WebDocumentNodeTagName(document, parent, parentTag):
                    if parentTag == "textarea":
                        web.WebDocumentSetFormValue(document, parent, strings.ConcatStr(rawText, ""))
            pos = textEnd
            continue
        if pos + 1 >= html.len:
            break
        let next = html[pos + 1]
        if next == '!':
            pos = HtmlSkipCommentOrDoctype(html, pos)
            continue
        if next == '?':
            pos = HtmlSkipCommentOrDoctype(html, pos)
            continue
        if next == '/':
            var nameStart = pos + 2
            var nameEnd = nameStart
            while nameEnd < html.len && HtmlIsNameChar(html[nameEnd]):
                nameEnd = nameEnd + 1
            let endTag = strutil.ToLowerAscii(HtmlSlice(html, nameStart, nameEnd))
            var gt = nameEnd
            while gt < html.len && html[gt] != '>':
                gt = gt + 1
            if gt < html.len:
                pos = gt + 1
            else:
                pos = html.len
            if endTag == "html" || endTag == "body" || endTag == "head":
                continue
            HtmlPopUntilTag(document, stack, endTag, htmlId, bodyId, headId)
            continue
        if !HtmlIsAlpha(next):
            let textId = web.WebDocumentCreateText(document, "<")
            var parent = HtmlCurrent(stack)
            if parent == htmlId:
                parent = bodyId
            if !web.WebDocumentAppendChild(document, parent, textId):
                HtmlParseErrorText = "html_parse: append lt text"
                return false
            pos = pos + 1
            continue
        var tagStart = pos + 1
        var tagEndName = tagStart
        while tagEndName < html.len && HtmlIsNameChar(html[tagEndName]):
            tagEndName = tagEndName + 1
        let tag = strutil.ToLowerAscii(HtmlSlice(html, tagStart, tagEndName))
        if tag.len <= 0:
            HtmlParseErrorText = "html_parse: empty tag"
            return false
        var attrEnd: int32
        var names: str[]
        var values: str[]
        var selfClosing = false
        if !HtmlParseAttributes(html, tagEndName, attrEnd, names, values, selfClosing):
            HtmlParseErrorText = "html_parse: unterminated tag"
            return false
        pos = attrEnd
        if tag == "html":
            for ai in 0..<names.len:
                web.WebDocumentSetAttribute(document, htmlId, names[ai], values[ai])
            continue
        if tag == "head":
            inHead = true
            HtmlPush(stack, headId)
            continue
        if tag == "body":
            inHead = false
            for ai in 0..<names.len:
                web.WebDocumentSetAttribute(document, bodyId, names[ai], values[ai])
                if names[ai] == "style":
                    HtmlParseStyleDeclarations(document, bodyId, values[ai])
            continue
        var parent = HtmlCurrent(stack)
        if HtmlIsHeadTag(tag) && (parent == htmlId || parent == bodyId || inHead):
            parent = headId
        elif parent == htmlId:
            parent = bodyId
        let nodeId = web.WebDocumentCreateElement(document, tag)
        for ai in 0..<names.len:
            if !web.WebDocumentSetAttribute(document, nodeId, names[ai], values[ai]):
                HtmlParseErrorText = "html_parse: set attribute"
                return false
            if names[ai] == "style":
                HtmlParseStyleDeclarations(document, nodeId, values[ai])
        if HtmlIsHiddenTag(tag):
            web.WebDocumentSetInlineStyleValue(document, nodeId, "display", "none")
        if tag == "link":
            var rel: str = ""
            var href: str = ""
            var li: int32 = 0
            while li < names.len:
                if names[li] == "rel":
                    rel = strutil.ToLowerAscii(values[li])
                elif names[li] == "href":
                    href = strings.ConcatStr(values[li], "")
                li = li + 1
            if href.len > 0 && (rel == "stylesheet" || strings.StrContains(rel, "stylesheet")):
                add(linkParts, href)
        HtmlApplyEventAttrs(document, nodeId, tag, names, values)
        HtmlApplyFormControl(document, nodeId, tag, names, values)
        if !web.WebDocumentAppendChild(document, parent, nodeId):
            HtmlParseErrorText = "html_parse: append element"
            return false
        let voidTag = HtmlIsVoidTag(tag) || selfClosing
        if HtmlIsRawTextTag(tag):
            var rawStop: int32
            let raw = HtmlReadRawText(html, pos, tag, rawStop)
            pos = rawStop
            if tag == "style":
                if raw.len > 0:
                    add(cssParts, raw)
            elif tag == "textarea":
                let decoded = HtmlDecodeEntities(raw)
                if decoded.len > 0:
                    let textId = web.WebDocumentCreateText(document, decoded)
                    if !web.WebDocumentAppendChild(document, nodeId, textId):
                        HtmlParseErrorText = "html_parse: textarea text"
                        return false
                    web.WebDocumentSetFormValue(document, nodeId, strings.ConcatStr(decoded, ""))
            elif tag == "title" && raw.len > 0:
                let decoded = HtmlDecodeEntities(raw)
                let textId = web.WebDocumentCreateText(document, decoded)
                if !web.WebDocumentAppendChild(document, nodeId, textId):
                    HtmlParseErrorText = "html_parse: title text"
                    return false
            continue
        if !voidTag:
            HtmlPush(stack, nodeId)
    HtmlParseCssText = strutil.Join(cssParts, "\n")
    HtmlParseLinkHrefText = strutil.Join(linkParts, "\n")
    document.styleSheetCss = strings.ConcatStr(HtmlParseCssText, "")
    return true
