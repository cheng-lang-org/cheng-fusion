import std/strutils as strutil

fn BrowserSnapshotCaptureScript(): str =
    var chunks: str[]
    add(chunks, "(function(){")
    add(chunks, "function signed(u){u=u>>>0;return u>2147483647?u-4294967296:u;}")
    add(chunks, "function argb(c){")
    add(chunks, "  if(!c||c==='transparent')return 0;")
    add(chunks, "  var m=c.match(/^rgba?\\(\\s*([\\d.]+)\\s*,\\s*([\\d.]+)\\s*,\\s*([\\d.]+)(?:\\s*,\\s*([\\d.]+))?\\s*\\)$/);")
    add(chunks, "  if(!m)return 0;")
    add(chunks, "  var r=+m[1]|0,g=+m[2]|0,b=+m[3]|0,a=m[4]==null?1:+m[4];")
    add(chunks, "  var ai=Math.round(a*255);")
    add(chunks, "  if(ai<=0)return 0;")
    add(chunks, "  if(ai>255)ai=255;")
    add(chunks, "  return signed((ai<<24)|(r<<16)|(g<<8)|b);")
    add(chunks, "}")
    add(chunks, "function mulA(color,op){")
    add(chunks, "  if(!color||op>=0.999)return color;")
    add(chunks, "  if(op<=0)return 0;")
    add(chunks, "  var u=color>>>0;")
    add(chunks, "  var a=Math.round(((u>>>24)&255)*op);")
    add(chunks, "  if(a<=0)return 0;")
    add(chunks, "  return signed((a<<24)|(u&0xffffff));")
    add(chunks, "}")
    add(chunks, "function px(s){var n=parseFloat(s);return isFinite(n)?Math.round(n):0;}")
    add(chunks, "function rad(st,w,h){")
    add(chunks, "  var s=st.borderTopLeftRadius||'0';")
    add(chunks, "  var n=parseFloat(s);")
    add(chunks, "  if(!isFinite(n)||n<=0)return 0;")
    add(chunks, "  if(String(s).indexOf('%')>=0){var m=w<h?w:h;return Math.round(m*n/100);}")
    add(chunks, "  return Math.round(n);")
    add(chunks, "}")
    add(chunks, "function weightOf(st){")
    add(chunks, "  var w=st.fontWeight;")
    add(chunks, "  if(w==='bold')return 700;")
    add(chunks, "  if(w==='normal')return 400;")
    add(chunks, "  var n=parseInt(w,10);")
    add(chunks, "  return isFinite(n)&&n>0?n:400;")
    add(chunks, "}")
    add(chunks, "var bgCache={};")
    add(chunks, "var bgFetches=0;")
    add(chunks, "var bgBytes=0;")
    add(chunks, "// 单轮抓图预算: 视口内渲染够用即可。大预算会让每轮 CLB/ops 随之膨胀,")
    add(chunks, "// 而 cheng ABI 当前零归还(每轮全量滞留), 预算即滞留速率的直接杠杆。")
    add(chunks, "var BG_MAX_BYTES=6*1024*1024;")
    add(chunks, "var BG_MAX_ITEM=2*1024*1024;")
    add(chunks, "function bgImageData(el,st){")
    add(chunks, "  var bi=st&&st.backgroundImage;")
    add(chunks, "  if(!bi||bi==='none') return '';")
    add(chunks, "  var m=bi.match(/url\\\\?\\((['\"]?)([^')\"]+)\\1\\)/);")
    add(chunks, "  if(!m) return '';")
    add(chunks, "  var url=m[2];")
    add(chunks, "  if(bgCache[url]!==undefined) return bgCache[url];")
    add(chunks, "  var out='';")
    add(chunks, "  if(url.indexOf('data:')===0){")
    add(chunks, "    out=url;")
    add(chunks, "  } else if(bgFetches<64){")
    add(chunks, "    bgFetches+=1;")
    add(chunks, "    try{")
    add(chunks, "      var x=new XMLHttpRequest();")
    add(chunks, "      x.open('GET',url,false);")
    add(chunks, "      x.responseType='arraybuffer';")
    add(chunks, "      x.send(null);")
    add(chunks, "      if(x.status===200||x.status===0){")
    add(chunks, "        if(bgBytes>BG_MAX_BYTES){ out=''; }")
    add(chunks, "        else{")
    add(chunks, "          var raw=new Uint8Array(x.response);")
    add(chunks, "          // 分块 join 而非 += 拼接(+= 为 O(n²), 单张 2MB 图产生数百 MB 临时串)")
    add(chunks, "          var nChunks=(raw.length+8191)>>13;")
    add(chunks, "          var parts=new Array(nChunks);")
    add(chunks, "          for(var i=0,ci=0;i<raw.length;i+=8192,ci++) parts[ci]=String.fromCharCode.apply(null,raw.subarray(i,Math.min(i+8192,raw.length)));")
    add(chunks, "          var bin=parts.join('');")
    add(chunks, "          bgBytes+=raw.length;")
    add(chunks, "          var mime=x.getResponseHeader('Content-Type')||'image/png';")
    add(chunks, "          out='data:'+mime+';base64,'+btoa(bin);")
    add(chunks, "        }")
    add(chunks, "      }")
    add(chunks, "    }catch(e){ out=''; }")
    add(chunks, "  }")
    add(chunks, "  bgCache[url]=out;")
    add(chunks, "  return out;")
    add(chunks, "}")
    add(chunks, "function familyOf(st){")
    add(chunks, "  // 全字体列表按序回传(host 逐个做 CoreText 命中匹配, 首个真实命中的生效),")
    add(chunks, "  // 波单抓第一项会让不命中项静默退到系统默认而非 CSS 回落链。")
    add(chunks, "  var f=st.fontFamily||'';")
    add(chunks, "  if(!f) return '';")
    add(chunks, "  var parts=f.split(',');")
    add(chunks, "  var out=[];")
    add(chunks, "  for(var i=0;i<parts.length&&out.length<6;i++){")
    add(chunks, "    var t=parts[i].replace(/[\"']/g,'').replace(/ /g,' ').trim();")
    add(chunks, "    if(!t) continue;")
    add(chunks, "    if(t==='inherit'||t==='initial'||t==='unset') continue;")
    add(chunks, "    out.push(t);")
    add(chunks, "  }")
    add(chunks, "  return out.join('|');")
    add(chunks, "}")
    add(chunks, "function skipTag(t){")
    add(chunks, "  return t==='script'||t==='style'||t==='meta'||t==='link'||t==='head'||t==='noscript'||t==='template'||t==='br'||t==='wbr'||t==='option'||t==='optgroup';")
    add(chunks, "}")
    add(chunks, "function esc(s){")
    add(chunks, "  s=String(s||'');")
    add(chunks, "  var o='';")
    add(chunks, "  for(var i=0;i<s.length;i++){")
    add(chunks, "    var ch=s.charAt(i);")
    add(chunks, "    if(ch==='%')o+='%25';")
    add(chunks, "    else if(ch==='\\n')o+='%0A';")
    add(chunks, "    else if(ch==='\\r')o+='%0D';")
    add(chunks, "    else o+=ch;")
    add(chunks, "  }")
    add(chunks, "  return o;")
    add(chunks, "}")
    add(chunks, "// 控件语义注册表: 交互元素分配单调 captureId(存在元素 JS 属性上, 跨抓取稳定),")
    add(chunks, "// els[] 提供 id→元素反查, 语义动作通道按 id 寻址而非坐标。断连元素每次抓取")
    add(chunks, "// 剪除; 重挂时凭元素上的旧 id 原样重注册, captureId 永不复用。")
    add(chunks, "function ctlEsc(s){")
    add(chunks, "  s=String(s||'');")
    add(chunks, "  var o='';")
    add(chunks, "  for(var i=0;i<s.length;i++){")
    add(chunks, "    var ch=s.charAt(i);")
    add(chunks, "    if(ch==='%')o+='%25';")
    add(chunks, "    else if(ch==='\\n')o+='%0A';")
    add(chunks, "    else if(ch==='\\r')o+='%0D';")
    add(chunks, "    else if(ch==='|')o+='%7C';")
    add(chunks, "    else if(ch==='\\t')o+='%09';")
    add(chunks, "    else o+=ch;")
    add(chunks, "  }")
    add(chunks, "  return o;")
    add(chunks, "}")
    add(chunks, "function ctlRegister(el){")
    add(chunks, "  var c=window.__chengCtl;")
    add(chunks, "  if(!c){ c=window.__chengCtl={seq:0,els:[]}; }")
    add(chunks, "  var id=el.__chengCtlId;")
    add(chunks, "  if(!id){ c.seq=c.seq+1; id=c.seq; el.__chengCtlId=id; }")
    add(chunks, "  if(c.els[id]!==el) c.els[id]=el;")
    add(chunks, "  return id;")
    add(chunks, "}")
    add(chunks, "window.__chengCtlById=function(id){")
    add(chunks, "  var c=window.__chengCtl;")
    add(chunks, "  var e=c?c.els[id]:null;")
    add(chunks, "  return e||null;")
    add(chunks, "};")
    add(chunks, "function ctlRoleOf(el){")
    add(chunks, "  return String(el.getAttribute('role')||'');")
    add(chunks, "}")
    add(chunks, "// accessible name 求解链: aria-label > aria-labelledby(逐 id 聚合) >")
    add(chunks, "// label[for]/包裹 label > placeholder > title > alt > 自身聚合文本 > value。")
    add(chunks, "function ctlNameOf(el){")
    add(chunks, "  var doc=el.ownerDocument||document;")
    add(chunks, "  var v=String(el.getAttribute('aria-label')||'').replace(/\\s+/g,' ').trim();")
    add(chunks, "  if(v) return v.slice(0,200);")
    add(chunks, "  var lb=el.getAttribute('aria-labelledby');")
    add(chunks, "  if(lb){")
    add(chunks, "    var parts=[];")
    add(chunks, "    var ids=lb.split(/\\s+/);")
    add(chunks, "    for(var i=0;i<ids.length;i++){")
    add(chunks, "      if(!ids[i])continue;")
    add(chunks, "      var n=doc.getElementById(ids[i]);")
    add(chunks, "      if(n){ var t=String(n.textContent||'').replace(/\\s+/g,' ').trim(); if(t)parts.push(t); }")
    add(chunks, "    }")
    add(chunks, "    v=parts.join(' ').trim();")
    add(chunks, "    if(v) return v.slice(0,200);")
    add(chunks, "  }")
    add(chunks, "  var lab=null;")
    add(chunks, "  try{ lab=el.id?doc.querySelector('label[for=\"'+el.id.replace(/\"/g,'')+'\"]'):null; }catch(e){ lab=null; }")
    add(chunks, "  if(!lab&&el.closest) lab=el.closest('label');")
    add(chunks, "  if(lab){ v=String(lab.textContent||'').replace(/\\s+/g,' ').trim(); if(v) return v.slice(0,200); }")
    add(chunks, "  v=String(el.getAttribute('placeholder')||'').replace(/\\s+/g,' ').trim();")
    add(chunks, "  if(v) return v.slice(0,200);")
    add(chunks, "  v=String(el.getAttribute('title')||'').replace(/\\s+/g,' ').trim();")
    add(chunks, "  if(v) return v.slice(0,200);")
    add(chunks, "  v=String(el.getAttribute('alt')||'').replace(/\\s+/g,' ').trim();")
    add(chunks, "  if(v) return v.slice(0,200);")
    add(chunks, "  v=String(el.textContent||'').replace(/\\s+/g,' ').trim();")
    add(chunks, "  if(v) return v.slice(0,200);")
    add(chunks, "  try{ v=String(el.value||'').replace(/\\s+/g,' ').trim(); }catch(e){ v=''; }")
    add(chunks, "  return v.slice(0,200);")
    add(chunks, "}")
    add(chunks, "// flags 位模型: 1=disabled(含 aria-disabled), 2=readonly, 4=checked。")
    add(chunks, "function ctlFlagsOf(el){")
    add(chunks, "  var f=0;")
    add(chunks, "  try{ if(el.disabled||el.getAttribute('aria-disabled')==='true') f|=1; }catch(e){}")
    add(chunks, "  try{ if(el.readOnly) f|=2; }catch(e){}")
    add(chunks, "  try{ if(el.checked) f|=4; }catch(e){}")
    add(chunks, "  return f;")
    add(chunks, "}")
    add(chunks, "function intersect(a,b){")
    add(chunks, "  var x=Math.max(a.x,b.x), y=Math.max(a.y,b.y);")
    add(chunks, "  var r=Math.min(a.x+a.w,b.x+b.w), btm=Math.min(a.y+a.h,b.y+b.h);")
    add(chunks, "  return {x:x,y:y,w:Math.max(0,r-x),h:Math.max(0,btm-y)};")
    add(chunks, "}")
    add(chunks, "function isBlockingOverlay(st,r,vw,vh){")
    add(chunks, "  if(!st||!r) return false;")
    add(chunks, "  if(st.position!=='fixed') return false;")
    add(chunks, "  if(r.width<vw*0.8||r.height<vh*0.8) return false;")
    add(chunks, "  var z=parseInt(st.zIndex,10);")
    add(chunks, "  if(!isFinite(z)) z=0;")
    add(chunks, "  return z>=10;")
    add(chunks, "}")
    add(chunks, "function visClip(b,clip,vw,vh){")
    add(chunks, "  if(b.w<=0||b.h<=0)return false;")
    add(chunks, "  if(b.x>=vw||b.y>=vh||b.x+b.w<=0||b.y+b.h<=0)return false;")
    add(chunks, "  if(clip.w<=0||clip.h<=0)return false;")
    add(chunks, "  var i=intersect(b,clip);")
    add(chunks, "  return i.w>0&&i.h>0;")
    add(chunks, "}")
    add(chunks, "function parseShadow(s){")
    add(chunks, "  var out={x:0,y:0,blur:0,spread:0,c:0};")
    add(chunks, "  if(!s||s==='none')return out;")
    add(chunks, "  var col=s.match(/rgba?\\([^)]+\\)/);")
    add(chunks, "  if(col) out.c=argb(col[0]);")
    add(chunks, "  var nums=s.match(/-?[\\d.]+px/g)||[];")
    add(chunks, "  if(nums.length>=1) out.x=px(nums[0]);")
    add(chunks, "  if(nums.length>=2) out.y=px(nums[1]);")
    add(chunks, "  if(nums.length>=3) out.blur=px(nums[2]);")
    add(chunks, "  if(nums.length>=4) out.spread=px(nums[3]);")
    add(chunks, "  return out;")
    add(chunks, "}")
    add(chunks, "function gradientFill(st){")
    add(chunks, "  var bi=st.backgroundImage||'';")
    add(chunks, "  if(bi==='none'||bi.indexOf('gradient')<0)return 0;")
    add(chunks, "  var m=bi.match(/rgba?\\(\\s*[\\d.]+(?:\\s*,\\s*[\\d.]+){2,3}\\s*\\)/);")
    add(chunks, "  return m?argb(m[0]):0;")
    add(chunks, "}")
    add(chunks, "function cssContent(raw){")
    add(chunks, "  if(!raw||raw==='none'||raw==='normal'||raw==='open-quote'||raw==='close-quote')return '';")
    add(chunks, "  var m=String(raw).match(/^['\"]([\\s\\S]*)['\"]$/);")
    add(chunks, "  var t=m?m[1]:'';")
    add(chunks, "  t=t.replace(/\\\\([0-9a-fA-F]{1,6})[ \\t]?/g,function(_,h){return String.fromCharCode(parseInt(h,16));});")
    add(chunks, "  return t;")
    add(chunks, "}")
    add(chunks, "var srcCache={};")
    add(chunks, "var srcFetches=0;")
    add(chunks, "var srcBytes=0;")
    add(chunks, "var SRC_MAX_BYTES=6*1024*1024;")
    add(chunks, "var SRC_MAX_ITEM=2*1024*1024;")
    add(chunks, "function fetchSrcDataURI(el){")
    add(chunks, "  var src=el.getAttribute&&el.getAttribute('src')||'';")
    add(chunks, "  if(!src) return '';")
    add(chunks, "  if(src.indexOf('data:')===0) return src;")
    add(chunks, "  if(srcCache[src]!==undefined) return srcCache[src];")
    add(chunks, "  var out='';")
    add(chunks, "  if(bgFetches<64){")
    add(chunks, "    srcFetches+=1;")
    add(chunks, "    try{")
    add(chunks, "      var abs=src;")
    add(chunks, "      if(src.indexOf('/')===0&&src.indexOf('//')!==0) abs=location.origin+src;")
    add(chunks, "      else if(src.indexOf('http')!==0) abs=location.origin+location.pathname.replace(/[^/]*$/,'')+src;")
    add(chunks, "      var x=new XMLHttpRequest();")
    add(chunks, "      x.open('GET',abs,false);")
    add(chunks, "      x.responseType='arraybuffer';")
    add(chunks, "      x.send(null);")
    add(chunks, "      if(x.status===200||x.status===0){")
    add(chunks, "        if(srcBytes>SRC_MAX_BYTES){ out=''; }")
    add(chunks, "        else{")
    add(chunks, "          var raw=new Uint8Array(x.response);")
    add(chunks, "          var nChunks2=(raw.length+8191)>>13;")
    add(chunks, "          var parts2=new Array(nChunks2);")
    add(chunks, "          for(var i=0,ci=0;i<raw.length;i+=8192,ci++) parts2[ci]=String.fromCharCode.apply(null,raw.subarray(i,Math.min(i+8192,raw.length)));")
    add(chunks, "          var bin=parts2.join('');")
    add(chunks, "          srcBytes+=raw.length;")
    add(chunks, "          var mime=x.getResponseHeader('Content-Type')||'image/svg+xml';")
    add(chunks, "          out='data:'+mime+';base64,'+btoa(bin);")
    add(chunks, "        }")
    add(chunks, "      }")
    add(chunks, "    }catch(e){ out=''; }")
    add(chunks, "  }")
    add(chunks, "  srcCache[src]=out;")
    add(chunks, "  return out;")
    add(chunks, "}")
    add(chunks, "function imgData(el){")
    add(chunks, "  try{")
    add(chunks, "    var tag=el.tagName?el.tagName.toLowerCase():'';")
    add(chunks, "    if(tag==='img'&&(!el.complete||el.naturalWidth===0)){")
    add(chunks, "      var f=fetchSrcDataURI(el);")
    add(chunks, "      if(f) return f;")
    add(chunks, "    }")
    add(chunks, "    if(tag==='img'&&el.complete&&el.naturalWidth>0&&el.naturalHeight>0){")
    add(chunks, "      var c=document.createElement('canvas');")
    add(chunks, "      var iw=el.naturalWidth, ih=el.naturalHeight;")
    add(chunks, "      var max=2048, sc=Math.max(iw,ih);")
    add(chunks, "      if(sc>max){var k=max/sc; iw=Math.round(iw*k); ih=Math.round(ih*k);}")
    add(chunks, "      c.width=iw; c.height=ih;")
    add(chunks, "      c.getContext('2d').drawImage(el,0,0,iw,ih);")
    add(chunks, "      return c.toDataURL('image/png');")
    add(chunks, "    }")
    add(chunks, "    if(tag==='svg'||(el.namespaceURI&&String(el.namespaceURI).indexOf('svg')>=0)){")
    add(chunks, "      var ser=new XMLSerializer().serializeToString(el);")
    add(chunks, "      if(ser.indexOf('xmlns')<0) ser=ser.replace('<svg','<svg xmlns=\"http://www.w3.org/2000/svg\"');")
    add(chunks, "      return 'data:image/svg+xml;base64,'+btoa(unescape(encodeURIComponent(ser)));")
    add(chunks, "    }")
    add(chunks, "    if(tag==='canvas'&&el.width>0&&el.height>0){")
    add(chunks, "      // canvas 像素回放: 2D 直接 toDataURL; WebGL 依赖 preserveDrawingBuffer")
    add(chunks, "      // (未设则合成后帧已清空, 返回空如实跳过——不伪造像素)。")
    add(chunks, "      var kw=el.width, kh=el.height;")
    add(chunks, "      var cmax=1024, ksc=Math.max(kw,kh);")
    add(chunks, "      if(ksc>cmax){var kk=cmax/ksc; kw=Math.round(kw*kk); kh=Math.round(kh*kk);}")
    add(chunks, "      var cc=document.createElement('canvas');")
    add(chunks, "      cc.width=kw; cc.height=kh;")
    add(chunks, "      cc.getContext('2d').drawImage(el,0,0,kw,kh);")
    add(chunks, "      var curl=cc.toDataURL('image/png');")
    add(chunks, "      if(curl.length<=600000) return curl;")
    add(chunks, "    }")
    add(chunks, "    if(tag==='video'&&el.readyState>=2&&el.videoWidth>0&&el.videoHeight>0){")
    add(chunks, "      // 视频当前帧回放: drawImage 抓帧缩到 640, JPEG 0.6(photographic);")
    add(chunks, "      // 跨域视频会污染 canvas 抛异常, catch 后如实跳过。")
    add(chunks, "      var vw2=el.videoWidth, vh2=el.videoHeight;")
    add(chunks, "      var vmax=640, vsc=Math.max(vw2,vh2);")
    add(chunks, "      if(vsc>vmax){var vk=vmax/vsc; vw2=Math.round(vw2*vk); vh2=Math.round(vh2*vk);}")
    add(chunks, "      var vc=document.createElement('canvas');")
    add(chunks, "      vc.width=vw2; vc.height=vh2;")
    add(chunks, "      vc.getContext('2d').drawImage(el,0,0,vw2,vh2);")
    add(chunks, "      return vc.toDataURL('image/jpeg',0.6);")
    add(chunks, "    }")
    add(chunks, "  }catch(e){}")
    add(chunks, "  return '';")
    add(chunks, "}")
    add(chunks, "function isPuaText(s){")
    add(chunks, "  s=String(s||'');")
    add(chunks, "  for(var i=0;i<s.length;i++){")
    add(chunks, "    var c=s.charCodeAt(i);")
    add(chunks, "    if(c>=0xE000&&c<=0xF8FF) return true;")
    add(chunks, "  }")
    add(chunks, "  return false;")
    add(chunks, "}")
    add(chunks, "function shouldRasterGlyph(st,txt){")
    add(chunks, "  txt=String(txt||'');")
    add(chunks, "  if(!txt||txt.length>8) return false;")
    add(chunks, "  if(isPuaText(txt)) return true;")
    add(chunks, "  var ff=String(st&&st.fontFamily||'');")
    add(chunks, "  if(/icon|awesome|glyph|icomoon|fontello|material icons/i.test(ff)) return true;")
    add(chunks, "  if(txt.length<=2){")
    add(chunks, "    for(var i=0;i<txt.length;i++){ if(txt.charCodeAt(i)>255) return true; }")
    add(chunks, "  }")
    add(chunks, "  return false;")
    add(chunks, "}")
    add(chunks, "function rasterText(st,txt,w,h){")
    add(chunks, "  try{")
    add(chunks, "    w=Math.max(1,Math.round(w||0)); h=Math.max(1,Math.round(h||0));")
    add(chunks, "    var c=document.createElement('canvas');")
    add(chunks, "    var dpr=2;")
    add(chunks, "    c.width=w*dpr; c.height=h*dpr;")
    add(chunks, "    var ctx=c.getContext('2d');")
    add(chunks, "    ctx.scale(dpr,dpr);")
    add(chunks, "    ctx.font=st.font||((st.fontSize||'14px')+' '+(st.fontFamily||'sans-serif'));")
    add(chunks, "    ctx.fillStyle=st.color||'#111';")
    add(chunks, "    ctx.textBaseline='middle';")
    add(chunks, "    ctx.textAlign='left';")
    add(chunks, "    ctx.fillText(txt,0,h/2);")
    add(chunks, "    return c.toDataURL('image/png');")
    add(chunks, "  }catch(e){ return ''; }")
    add(chunks, "}")
    add(chunks, "function makeBox(k,t,x,y,w,h,bg,fg,fs,bw,bc,rr,href,typ,id,val,txt,fw,ff,img,sh,clip,z,opts,depth,paintPath){")
    add(chunks, "  return {k:k,t:t,x:x,y:y,w:w,h:h,bg:bg,fg:fg,fs:fs,bw:bw,bc:bc,rr:rr,href:href||'',typ:typ||'',id:id||'',val:val||'',txt:txt||'',fw:fw||400,ff:ff||'',img:img||'',sx:sh?sh.x:0,sy:sh?sh.y:0,sblur:sh?sh.blur:0,sspread:sh?sh.spread:0,sc:sh?sh.c:0,cx:clip.x,cy:clip.y,cw:clip.w,ch:clip.h,z:z||0,opts:opts||'',depth:depth||0,paintPath:paintPath||null};")
    add(chunks, "}")
    add(chunks, "function encOpts(opts){")
    add(chunks, "  var parts=[];")
    add(chunks, "  for(var i=0;i<opts.length;i++){")
    add(chunks, "    var v=String(opts[i].v||'').replace(/\\t/g,' ');")
    add(chunks, "    var t=String(opts[i].t||'').replace(/\\t/g,' ');")
    add(chunks, "    parts.push((opts[i].s?1:0)+'\\t'+v+'\\t'+t);")
    add(chunks, "  }")
    add(chunks, "  return parts.join('\\n');")
    add(chunks, "}")
    add(chunks, "function optionsOf(el){")
    add(chunks, "  var out=[], seen={};")
    add(chunks, "  function add(v,t,s){")
    add(chunks, "    v=String(v||'').replace(/\\s+/g,' ').trim();")
    add(chunks, "    t=String(t||'').replace(/\\s+/g,' ').trim();")
    add(chunks, "    if(!t) return;")
    add(chunks, "    if(!v) v=t;")
    add(chunks, "    var key=v+'|'+t;")
    add(chunks, "    if(seen[key]) return;")
    add(chunks, "    seen[key]=1;")
    add(chunks, "    out.push({v:v,t:t,s:s?1:0});")
    add(chunks, "  }")
    add(chunks, "  if(!el) return out;")
    add(chunks, "  if(el.tagName==='SELECT'){")
    add(chunks, "    for(var i=0;i<el.options.length;i++) add(el.options[i].value, el.options[i].text, el.options[i].selected);")
    add(chunks, "    return out;")
    add(chunks, "  }")
    add(chunks, "  var roots=[el];")
    add(chunks, "  var cid=el.getAttribute('aria-controls')||el.getAttribute('aria-owns');")
    add(chunks, "  if(cid){")
    add(chunks, "    var doc=el.ownerDocument||document;")
    add(chunks, "    var t=doc.getElementById(cid);")
    add(chunks, "    if(t) roots.push(t);")
    add(chunks, "  }")
    add(chunks, "  for(var n=0;n<roots.length;n++){")
    add(chunks, "    var root=roots[n];")
    add(chunks, "    if(!root || !root.querySelectorAll) continue;")
    add(chunks, "    if(root.tagName==='SELECT'){")
    add(chunks, "      for(var i=0;i<root.options.length;i++) add(root.options[i].value, root.options[i].text, root.options[i].selected);")
    add(chunks, "      continue;")
    add(chunks, "    }")
    add(chunks, "    var opts=root.querySelectorAll('[role=option], [role=listbox] [role=option], [role=listbox] li');")
    add(chunks, "    for(var i=0;i<opts.length;i++){")
    add(chunks, "      var o=opts[i];")
    add(chunks, "      var lab=(o.getAttribute('aria-label')||o.textContent||'').replace(/\\s+/g,' ').trim();")
    add(chunks, "      if(!lab) continue;")
    add(chunks, "      var v=o.getAttribute('data-value')||o.getAttribute('value')||lab;")
    add(chunks, "      var s=o.getAttribute('aria-selected')==='true'||(' '+o.className+' ').indexOf(' selected ')>=0;")
    add(chunks, "      add(v,lab,s);")
    add(chunks, "    }")
    add(chunks, "  }")
    add(chunks, "  return out;")
    add(chunks, "}")
    add(chunks, "function capture(){")
    add(chunks, "  window.__chengCaptureActive=1;")
    add(chunks, "  var t0=performance.now();")
    add(chunks, "  // 单次抓取图片字节预算计数(此前 bgBytes/srcBytes 未声明, 32MB 上限恒不")
    add(chunks, "  // 触发, 淘宝级页面数百张图全量抓取是 phys_footprint 爆炸主因之一)")
    add(chunks, "  bgBytes=0;")
    add(chunks, "  srcBytes=0;")
    add(chunks, "  var cc0=window.__chengCtl;")
    add(chunks, "  if(cc0){")
    add(chunks, "    for(var pi=1;pi<cc0.els.length;pi++){")
    add(chunks, "      var pe=cc0.els[pi];")
    add(chunks, "      if(pe&&!pe.isConnected) delete cc0.els[pi];")
    add(chunks, "    }")
    add(chunks, "  }")
    add(chunks, "  var vw=Math.round(document.documentElement.clientWidth||innerWidth||0);")
    add(chunks, "  var vh=Math.round(document.documentElement.clientHeight||innerHeight||0);")
    add(chunks, "  if(vw<1)vw=1;")
    add(chunks, "  if(vh<1)vh=1;")
    add(chunks, "  var boxes=[];")
    add(chunks, "  var view={x:0,y:0,w:vw,h:vh};")
    add(chunks, "  function pushTextNode(node,st,clip,op,z,ox,oy,depth,ctxPath,scaleK){")
    add(chunks, "    var raw=node.nodeValue; if(!raw)return;")
    add(chunks, "    var fg=mulA(argb(st.color),op);")
    add(chunks, "    var fs=px(st.fontSize); if(fs<=0)fs=14;")
    add(chunks, "    var sk=(typeof scaleK==='number'&&scaleK>0.05&&scaleK<20)?scaleK:1;")
    add(chunks, "    if(Math.abs(sk-1)>0.01) fs=Math.max(6,Math.round(fs*sk));")
    add(chunks, "    var fw=weightOf(st);")
    add(chunks, "    var ff=familyOf(st);")
    add(chunks, "    var range=(node.ownerDocument||document).createRange();")
    add(chunks, "    var n=raw.length;")
    add(chunks, "    if(n>8000) n=8000;")
    add(chunks, "    var run=null;")
    add(chunks, "    for(var i=0;i<n;i++){")
    add(chunks, "      range.setStart(node,i);")
    add(chunks, "      range.setEnd(node,i+1);")
    add(chunks, "      var r=range.getBoundingClientRect();")
    add(chunks, "      if(r.width<=0||r.height<=0) continue;")
    add(chunks, "      var ch=raw.charAt(i);")
    add(chunks, "      var x=r.left+ox, y=r.top+oy;")
    add(chunks, "      var bx={x:x,y:y,w:r.width,h:r.height};")
    add(chunks, "      if(!visClip(bx,clip,vw,vh)) continue;")
    add(chunks, "      if(run && Math.abs(y-run.y)<1 && Math.abs(x-(run.x+run.w))<1.6 && Math.abs(r.height-run.h)<1){")
    add(chunks, "        run.txt+=ch;")
    add(chunks, "        run.w=Math.round(x+r.width-run.x);")
    add(chunks, "      } else {")
    add(chunks, "        if(run){")
    add(chunks, "          if(shouldRasterGlyph(st,run.txt)){")
    add(chunks, "            run.img=rasterText(st,run.txt,run.w,run.h);")
    add(chunks, "            run.txt='';")
    add(chunks, "          }")
    add(chunks, "          boxes.push(run);")
    add(chunks, "        }")
    add(chunks, "        run=makeBox(0,'#text',Math.round(x),Math.round(y),Math.round(r.width),Math.round(r.height),0,fg,fs,0,0,0,'','','','',ch,fw,ff,'',null,clip,z,depth+1,ctxPath);")
    add(chunks, "      }")
    add(chunks, "    }")
    add(chunks, "    if(run){")
    add(chunks, "      if(shouldRasterGlyph(st,run.txt)){")
    add(chunks, "        run.img=rasterText(st,run.txt,run.w,run.h);")
    add(chunks, "        run.txt='';")
    add(chunks, "      }")
    add(chunks, "      boxes.push(run);")
    add(chunks, "    }")
    add(chunks, "  }")
    add(chunks, "  function addPseudo(el,which,clip,op,z,ox,oy,depth,ctxPath){")
    add(chunks, "    var st=getComputedStyle(el,which);")
    add(chunks, "    if(!st||st.display==='none'||st.visibility==='hidden')return;")
    add(chunks, "    var txt=cssContent(st.content);")
    add(chunks, "    var bg=mulA(argb(st.backgroundColor),op);")
    add(chunks, "    var g=mulA(gradientFill(st),op);")
    add(chunks, "    if(g&&!bg) bg=g;")
    add(chunks, "    var bw=px(st.borderTopWidth);")
    add(chunks, "    var ow=px(st.outlineWidth);")
    add(chunks, "    if(bw<=0&&ow>0&&st.outlineStyle&&st.outlineStyle!=='none'){bw=ow;}")
    add(chunks, "    var er=el.getBoundingClientRect();")
    add(chunks, "    var w=px(st.width), h=px(st.height);")
    add(chunks, "    if(w<=0) w=px(st.fontSize)||px(er.width);")
    add(chunks, "    if(h<=0) h=px(st.lineHeight)||px(st.fontSize)||px(er.height);")
    add(chunks, "    if(w<=0||h<=0){ if(!txt) return; w=w||px(st.fontSize)||12; h=h||px(st.fontSize)||12; }")
    add(chunks, "    var x=Math.round(er.left+ox+px(st.left));")
    add(chunks, "    var y=Math.round(er.top+oy+px(st.top));")
    add(chunks, "    if(st.position==='static'){ x=Math.round(er.left+ox); y=Math.round(er.top+oy); }")
    add(chunks, "    var box={x:x,y:y,w:Math.round(w),h:Math.round(h)};")
    add(chunks, "    if(!visClip(box,clip,vw,vh)) return;")
    add(chunks, "    var fg=mulA(argb(st.color),op);")
    add(chunks, "    var fs=px(st.fontSize); if(fs<=0)fs=14;")
    add(chunks, "    var sh=parseShadow(st.boxShadow);")
    add(chunks, "    sh.c=mulA(sh.c,op);")
    add(chunks, "    var img='';")
    add(chunks, "    if(shouldRasterGlyph(st,txt)){")
    add(chunks, "      img=rasterText(st,txt,box.w,box.h);")
    add(chunks, "      txt='';")
    add(chunks, "    }")
    add(chunks, "    var b=makeBox(0,'#'+which.replace(':',''),box.x,box.y,box.w,box.h,bg,fg,fs,bw,mulA(argb(st.borderTopColor||st.outlineColor),op),rad(st,box.w,box.h),'','','','',txt,weightOf(st),familyOf(st),img,sh,clip,z,depth+1,ctxPath);")
    add(chunks, "    boxes.push(b);")
    add(chunks, "    // 底边独占边框(eServices 导航蓝条型): CLB 统一 bw 模型只取 border-top,")
    add(chunks, "    // 底边专属的边框以等价填充条发射(同层同序, 视觉等价)。")
    add(chunks, "    var bbw=px(st.borderBottomWidth);")
    add(chunks, "    var bbc=mulA(argb(st.borderBottomColor),op);")
    add(chunks, "    if(bbw>0&&bbc&&bbc!==0){")
    add(chunks, "      boxes.push(makeBox(0,'#bborder',box.x,box.y+box.h-bbw,box.w,bbw,bbc,fg,fs,0,0,0,'','','','','',weightOf(st),familyOf(st),'',null,clip,z,'',depth+1,ctxPath));")
    add(chunks, "    }")
    add(chunks, "  }")
    add(chunks, "  function paintSelectList(el,clip,ox,oy,z,st0){")
    add(chunks, "    if(!el||!el.options||el.options.length<=0) return;")
    add(chunks, "    var n=el.options.length;")
    add(chunks, "    var vis=[];")
    add(chunks, "    for(var i=0;i<n;i++){")
    add(chunks, "      var o=el.options[i];")
    add(chunks, "      var r=o.getBoundingClientRect();")
    add(chunks, "      if(r.width>0&&r.height>0) vis.push({i:i,x:r.left+ox,y:r.top+oy,w:r.width,h:r.height});")
    add(chunks, "    }")
    add(chunks, "    var open=!!el.__chengOpen;")
    add(chunks, "    try{ if(el.matches(':open')) open=true; }catch(e){}")
    add(chunks, "    if(el.size>1||el.multiple) open=true;")
    add(chunks, "    if(vis.length===0&&!open) return;")
    add(chunks, "    var sr=el.getBoundingClientRect();")
    add(chunks, "    var cx=Math.round(sr.left+ox), cy=Math.round(sr.top+oy), cw=Math.round(sr.width), ch=Math.round(sr.height);")
    add(chunks, "    var rowH=ch>0?ch:28;")
    add(chunks, "    if(rowH<24) rowH=28;")
    add(chunks, "    if(vis.length===0){")
    add(chunks, "      var total=rowH*n;")
    add(chunks, "      var openUp=cy>=(vh-(cy+ch));")
    add(chunks, "      var y0=openUp?cy-total:cy+ch;")
    add(chunks, "      for(var i=0;i<n;i++) vis.push({i:i,x:cx,y:y0+i*rowH,w:cw,h:rowH});")
    add(chunks, "    }")
    add(chunks, "    if(vis.length===0) return;")
    add(chunks, "    var minx=vis[0].x, miny=vis[0].y, maxr=vis[0].x+vis[0].w, maxb=vis[0].y+vis[0].h;")
    add(chunks, "    for(var i=1;i<vis.length;i++){")
    add(chunks, "      if(vis[i].x<minx) minx=vis[i].x;")
    add(chunks, "      if(vis[i].y<miny) miny=vis[i].y;")
    add(chunks, "      if(vis[i].x+vis[i].w>maxr) maxr=vis[i].x+vis[i].w;")
    add(chunks, "      if(vis[i].y+vis[i].h>maxb) maxb=vis[i].y+vis[i].h;")
    add(chunks, "    }")
    add(chunks, "    var panel={x:Math.round(minx),y:Math.round(miny),w:Math.round(maxr-minx),h:Math.round(maxb-miny)};")
    add(chunks, "    if(visClip(panel,clip,vw,vh)){")
    add(chunks, "      var psh={x:0,y:8,blur:24,spread:0,c:signed((0x33<<24))};")
    add(chunks, "      boxes.push(makeBox(0,'#list',panel.x,panel.y,panel.w,panel.h,-1,0,14,1,signed((255<<24)|(229<<16)|(231<<8)|235),8,'','','','','',400,'','',psh,clip,z+20));")
    add(chunks, "    }")
    add(chunks, "    var fs=st0?px(st0.fontSize):14; if(fs<=0)fs=14;")
    add(chunks, "    var ff=st0?familyOf(st0):'';")
    add(chunks, "    for(var i=0;i<vis.length;i++){")
    add(chunks, "      var it=vis[i];")
    add(chunks, "      var o=el.options[it.i];")
    add(chunks, "      var lab=String(o.text||o.label||o.value||'');")
    add(chunks, "      var sel=!!o.selected;")
    add(chunks, "      var bg=0;")
    add(chunks, "      var fg=signed((255<<24)|(17<<16)|(24<<8)|39);")
    add(chunks, "      try{")
    add(chunks, "        var os=getComputedStyle(o);")
    add(chunks, "        if(os){")
    add(chunks, "          bg=argb(os.backgroundColor);")
    add(chunks, "          var cf=argb(os.color);")
    add(chunks, "          if(cf) fg=cf;")
    add(chunks, "        }")
    add(chunks, "      }catch(e){}")
    add(chunks, "      if(sel){")
    add(chunks, "        if(!bg) bg=signed((255<<24)|(59<<16)|(130<<8)|246);")
    add(chunks, "        fg=signed((255<<24)|(255<<16)|(255<<8)|255);")
    add(chunks, "      } else if(!bg){")
    add(chunks, "        bg=-1;")
    add(chunks, "      }")
    add(chunks, "      var ob={x:Math.round(it.x),y:Math.round(it.y),w:Math.round(it.w),h:Math.round(it.h)};")
    add(chunks, "      if(!visClip(ob,clip,vw,vh)) continue;")
    add(chunks, "      boxes.push(makeBox(0,'option',ob.x,ob.y,ob.w,ob.h,bg,fg,fs,0,0,0,'','option','',String(o.value||''),lab,400,ff,'',null,clip,z+21));")
    add(chunks, "    }")
    add(chunks, "  }")
    add(chunks, "  function walk(el,clip,opMul,ox,oy,depth,ctxPath){")
    add(chunks, "    if(!el||el.nodeType!==1)return;")
    add(chunks, "    var tag=el.tagName.toLowerCase();")
    add(chunks, "    if(skipTag(tag))return;")
    add(chunks, "    if(el.hidden||el.getAttribute('aria-hidden')==='true')return;")
    add(chunks, "    var st=getComputedStyle(el);")
    add(chunks, "    if(!st||st.display==='none'||st.visibility==='hidden')return;")
    add(chunks, "    var cl=String(st.clip||'');")
    add(chunks, "    if(cl.indexOf('rect(0px')===0||cl.indexOf('rect(0,')===0||cl.indexOf('rect(0 ')===0) return;")
    add(chunks, "    var op=opMul*(parseFloat(st.opacity)||1);")
    add(chunks, "    if(op<=0)return;")
    add(chunks, "    if(tag==='input' && String(el.type||'').toLowerCase()==='hidden') return;")
    add(chunks, "    var r=el.getBoundingClientRect();")
    add(chunks, "    var x=Math.round(r.left+ox),y=Math.round(r.top+oy),w=Math.round(r.width),h=Math.round(r.height);")
    add(chunks, "    if(tag==='iframe'){")
    add(chunks, "      var idoc=null;")
    add(chunks, "      try{ idoc=el.contentDocument||(el.contentWindow&&el.contentWindow.document); }catch(e){ idoc=null; }")
    add(chunks, "      if(idoc&&idoc.documentElement){")
    add(chunks, "        walk(idoc.documentElement, intersect(clip,{x:x,y:y,w:w,h:h}), op, x, y, 0, ctxPath||[]);")
    add(chunks, "        return;")
    add(chunks, "      }")
    add(chunks, "    }")
    add(chunks, "    if(isBlockingOverlay(st,r,vw,vh)) return;")
    add(chunks, "    var kind=0;")
    add(chunks, "    if(tag==='input')kind=1;")
    add(chunks, "    else if(tag==='textarea')kind=2;")
    add(chunks, "    else if(tag==='a')kind=3;")
    add(chunks, "    else if(tag==='select')kind=6;")
    add(chunks, "    else if(tag==='button')kind=4;")
    add(chunks, "    else if(tag==='img'||tag==='svg'||tag==='canvas'||tag==='video'||tag==='iframe')kind=5;")
    add(chunks, "    else if(el.getAttribute('role')==='button'||el.getAttribute('onclick'))kind=4;")
    add(chunks, "    var harvested=[];")
    add(chunks, "    if(tag==='select'){")
    add(chunks, "      harvested=optionsOf(el);")
    add(chunks, "    } else if(tag!=='input' && tag!=='textarea' && tag!=='button'){")
    add(chunks, "      var role=el.getAttribute('role')||'';")
    add(chunks, "      var popup=el.getAttribute('aria-haspopup')||'';")
    add(chunks, "      if(role==='combobox'||role==='listbox'||popup==='listbox'||popup==='true'){")
    add(chunks, "        harvested=optionsOf(el);")
    add(chunks, "        if(harvested.length>0) kind=6;")
    add(chunks, "      }")
    add(chunks, "    }")
    add(chunks, "    var ctlId=0, ctlRole='', ctlName='', ctlFlags=0;")
    add(chunks, "    if(kind===1||kind===2||kind===3||kind===4||kind===6){")
    add(chunks, "      ctlId=ctlRegister(el);")
    add(chunks, "      ctlRole=ctlRoleOf(el);")
    add(chunks, "      ctlName=ctlNameOf(el);")
    add(chunks, "      ctlFlags=ctlFlagsOf(el);")
    add(chunks, "    }")
    add(chunks, "    var bg=mulA(argb(st.backgroundColor),op);")
    add(chunks, "    var g=mulA(gradientFill(st),op);")
    add(chunks, "    if(g&&!bg) bg=g;")
    add(chunks, "    var fg=mulA(argb(st.color),op);")
    add(chunks, "    var fs=px(st.fontSize); if(fs<=0)fs=14;")
    add(chunks, "    if(kind===1){ try{ var pst=el.parentElement?getComputedStyle(el.parentElement):null; if(pst&&st.fontSize===pst.fontSize) fs=13; }catch(e){} }")
    add(chunks, "    // 祖先 transform scale 折算: getBoundingClientRect 是缩放后矩形而 fontSize")
    add(chunks, "    // 仍是未缩放值(WebKit 按 scale 后尺寸渲染文本), 不折算则右栏文本放大溢出")
    add(chunks, "    // (巴林反馈条 20px*0.8=16px 实测案例)。")
    add(chunks, "    try{")
    add(chunks, "      var ow2=el.offsetWidth||0;")
    add(chunks, "      if(ow2>0&&w>0){")
    add(chunks, "        var kx=w/ow2;")
    add(chunks, "        if(kx>0.05&&kx<20&&Math.abs(kx-1)>0.01) fs=Math.max(6,Math.round(fs*kx));")
    add(chunks, "      }")
    add(chunks, "    }catch(e){}")
    add(chunks, "    var bw=px(st.borderTopWidth);")
    add(chunks, "    var ow=px(st.outlineWidth);")
    add(chunks, "    if(bw<=0&&ow>0&&st.outlineStyle&&st.outlineStyle!=='none'){bw=ow;}")
    add(chunks, "    var bc=mulA(argb(st.borderTopColor||st.outlineColor),op);")
    add(chunks, "    var rr=rad(st,w,h);")
    add(chunks, "    var href=kind===3?String(el.getAttribute('href')||''):'';")
    add(chunks, "    var typ='';")
    add(chunks, "    if(kind===1||kind===2||kind===4||kind===6) typ=String(el.getAttribute('type')||el.type||'');")
    add(chunks, "    var id=String(el.id||el.getAttribute('name')||'');")
    add(chunks, "    var val='';")
    add(chunks, "    if(kind===1||kind===2||kind===6) val=String(el.value||'');")
    add(chunks, "    // 凭据脱敏: password 真值不出捕获端(CLBJ不携带), 渲染按长度画圆点")
    add(chunks, "    if(kind===1&&String(el.type||'').toLowerCase()==='password'&&val) val='\\u2022'.repeat(val.length);")
    add(chunks, "    var txt='';")
    add(chunks, "    if(kind===6){")
    add(chunks, "      var lab='';")
    add(chunks, "      for(var oi=0;oi<harvested.length;oi++){ if(harvested[oi].s){ lab=harvested[oi].t; if(!val) val=harvested[oi].v; break; } }")
    add(chunks, "      if(!lab && tag==='select' && el.selectedIndex>=0 && el.options[el.selectedIndex]){")
    add(chunks, "        lab=String(el.options[el.selectedIndex].text||'');")
    add(chunks, "        if(!val) val=String(el.options[el.selectedIndex].value||lab);")
    add(chunks, "      }")
    add(chunks, "      txt=lab;")
    add(chunks, "    } else if(kind===1||kind===2){")
    add(chunks, "      if(val) txt=val;")
    add(chunks, "      else if(el.placeholder){ txt=String(el.placeholder); fg=mulA(argb('rgb(156,163,175)'),op); }")
    add(chunks, "    }")
    add(chunks, "    if(val&&val.length>400) val=val.slice(0,400);")
    add(chunks, "    if(txt&&txt.length>400) txt=txt.slice(0,400);")
    add(chunks, "    var sh=parseShadow(st.boxShadow);")
    add(chunks, "    sh.c=mulA(sh.c,op);")
    add(chunks, "    var z=parseInt(st.zIndex,10); if(!isFinite(z)) z=0;")
    add(chunks, "    // CSS 层叠层模型: 定位元素(z≠0)自成层叠上下文, 整棵子树按该层绘制(原子);")
    add(chunks, "    // 定位元素(z=auto)其后代保持原层, 元素自身盒画在定位层(1000);")
    add(chunks, "    // static 的 z 不生效(CSS 规范)按层 0 走树序。层内稳定排序=DOM 树序=绘制序。")
    add(chunks, "    var isPos=!!(st.position&&st.position!=='static');")
    add(chunks, "    var childPath=ctxPath;")
    add(chunks, "    if(isPos&&z!==0) childPath=ctxPath.concat([1000+z]);")
    add(chunks, "    var nextClip=clip;")
    add(chunks, "    if(st.overflow==='hidden'||st.overflow==='auto'||st.overflow==='scroll'||st.overflowX==='hidden'||st.overflowY==='hidden'||st.position==='fixed'||st.position==='sticky'){")
    add(chunks, "      nextClip=intersect(clip,{x:x,y:y,w:w,h:h});")
    add(chunks, "    }")
    add(chunks, "    // 视口内才抓图(对称 R1): 渲染不需要视口外的图, 语义不需要任何图——")
    add(chunks, "    // 淘宝级长页全量抓图会把单轮 CLB/ops 推到几十 MB, 高频重放下驻留爆炸")
    add(chunks, "    // 视口内才抓图(对称 R1): 渲染不需要视口外的图, 语义不需要任何图。")
    add(chunks, "    // 此处 box 尚未定义(img 行先于 var box), 用 x/y/w/h 直接判定视口交集")
    add(chunks, "    var img='';")
    add(chunks, "    if(x+w>0&&y+h>0&&x<vw&&y<vh){")
    add(chunks, "      img=kind===5?imgData(el):bgImageData(el,st);")
    add(chunks, "    }")
    add(chunks, "    var optsStr=encOpts(harvested);")
    add(chunks, "    var box={x:x,y:y,w:w,h:h};")
    add(chunks, "    // R1 滚动寻址: 交互控件在文档流中但视口外(与视口也无交集)仍入快照——")
    add(chunks, "    // 语义寻址需全量控件, 离屏盒渲染端天然裁剪无害; 视口内被 overflow 容器")
    add(chunks, "    // 裁剪的仍丢弃(物理不可见, scrollIntoView 也救不了容器外隐藏)。")
    add(chunks, "    var r1Offscreen=(kind===1||kind===2||kind===3||kind===4||kind===6)&&!visClip(box,view,vw,vh);")
    add(chunks, "    var paint=(visClip(box,clip,vw,vh)&&(bg!==0||kind>0||bw>0||sh.c!==0||img||optsStr||txt||(st.backgroundImage&&st.backgroundImage!=='none')))||r1Offscreen;")
    add(chunks, "    if(paint){")
    add(chunks, "      var pushed=makeBox(kind,tag,x,y,w,h,bg,fg,fs,bw,bc,rr,href,typ,id,val,txt,weightOf(st),familyOf(st),img,sh,nextClip,z,optsStr,depth,isPos?1:0,childPath);")
    add(chunks, "      boxes.push(pushed);")
    add(chunks, "      if(ctlId>0){ pushed.ctlId=ctlId; pushed.ctlRole=ctlRole; pushed.ctlName=ctlName; pushed.ctlFlags=ctlFlags; }")
    add(chunks, "      if(kind===6){")
    add(chunks, "        var cw=Math.max(10,Math.min(18,h));")
    add(chunks, "        boxes.push(makeBox(0,'#chev',x+w-cw-4,y,cw,h,0,fg,Math.max(10,fs-2),0,0,0,'','','','','\\u25BE',400,familyOf(st),'',null,nextClip,z,depth+1));")
    add(chunks, "      }")
    add(chunks, "    }")
    add(chunks, "    if(tag==='select'){")
    add(chunks, "      paintSelectList(el, nextClip, ox, oy, z, st);")
    add(chunks, "      return;")
    add(chunks, "    }")
    add(chunks, "    addPseudo(el,'::before',nextClip,op,z,ox,oy,depth+1,childPath);")
    add(chunks, "    // R3 shadow DOM 穿透: open shadowRoot 的子树并入快照(closed 无法穿透=")
    add(chunks, "    // 语言边界如实排除); light DOM slot 子节点照常由下方 childNodes 遍历,")
    add(chunks, "    // slot 重布局双画风险留档 v1 不做 slot 解析。")
    add(chunks, "    try{")
    add(chunks, "      if(el.shadowRoot){")
    add(chunks, "        var srKids=el.shadowRoot.childNodes;")
    add(chunks, "        for(var sk=0;sk<srKids.length;sk++){")
    add(chunks, "          var sn=srKids[sk];")
    add(chunks, "          if(sn.nodeType===3) pushTextNode(sn,st,nextClip,op,z,ox,oy,depth+1,childPath,1);")
    add(chunks, "          else if(sn.nodeType===1) walk(sn,nextClip,op,ox,oy,depth+1,childPath);")
    add(chunks, "        }")
    add(chunks, "      }")
    add(chunks, "    }catch(e){}")
    add(chunks, "    var liChildBase=-1;")
    add(chunks, "    if(tag==='li') liChildBase=boxes.length;")
    add(chunks, "    var ch=el.childNodes;")
    add(chunks, "    for(var i=0;i<ch.length;i++){")
    add(chunks, "      var n=ch[i];")
    add(chunks, "      if(n.nodeType===3){")
    add(chunks, "          var scK=1;")
    add(chunks, "          try{")
    add(chunks, "            var ow2=el.offsetWidth||0;")
    add(chunks, "            if(ow2>0&&w>0){")
    add(chunks, "              scK=w/ow2;")
    add(chunks, "              if(!(scK>0.05&&scK<20)) scK=1;")
    add(chunks, "              if(Math.abs(scK-1)<=0.01) scK=1;")
    add(chunks, "            }")
    add(chunks, "          }catch(e){ scK=1; }")
    add(chunks, "          pushTextNode(n,st,nextClip,op,z,ox,oy,depth+1,childPath,scK);")
    add(chunks, "        }")
    add(chunks, "      else if(n.nodeType===1) walk(n,nextClip,op,ox,oy,depth+1,childPath);")
    add(chunks, "    }")
    add(chunks, "    // ::marker 合成: li(display:list-item) 的列表符号不是 DOM 节点, TreeWalker")
    add(chunks, "    // 看不见; 按首个后裔文本盒定位(符号在文本左侧 fs*1.4 处), 字形按")
    add(chunks, "    // list-style-type 映射(disc •/circle ○/square ▪/decimal N.)。")
    add(chunks, "    if(tag==='li'&&String(st.display||'').indexOf('list-item')>=0&&(st.listStyleType||'').toLowerCase()!=='none'){")
    add(chunks, "      var liBase=liChildBase>=0?liChildBase:-1;")
    add(chunks, "      var firstText=null;")
    add(chunks, "      for(var bi=liBase;bi<boxes.length;bi++){")
    add(chunks, "        if(boxes[bi].t&&boxes[bi].t.length>0&&boxes[bi].x>=x-1){ firstText=boxes[bi]; break; }")
    add(chunks, "      }")
    add(chunks, "      if(firstText){")
    add(chunks, "        var lst=(st.listStyleType||'').toLowerCase();")
    add(chunks, "        var ord2=1, sb=el.previousElementSibling;")
    add(chunks, "        while(sb){ if(sb.tagName&&String(sb.tagName).toLowerCase()==='li') ord2++; sb=sb.previousElementSibling; }")
    add(chunks, "        var mk='•';")
    add(chunks, "        if(lst==='circle') mk='○';")
    add(chunks, "        else if(lst==='square') mk='■';")
    add(chunks, "        else if(lst.indexOf('decimal')>=0||lst.indexOf('arabic')>=0) mk=ord2+'.';")
    add(chunks, "        var mfs=Math.max(9,fs);")
    add(chunks, "        var mx=firstText.x-Math.round(mfs*1.4);")
    add(chunks, "        var my=firstText.y;")
    add(chunks, "        boxes.push(makeBox(0,'#marker',mx,my,Math.round(mfs*1.2),firstText.h,0,fg,mfs,0,0,0,'','','','',mk,weightOf(st),familyOf(st),'',null,nextClip,z,depth+1,childPath));")
    add(chunks, "      }")
    add(chunks, "    }")
    add(chunks, "    var liChildBase=-1;")
    add(chunks, "    addPseudo(el,'::after',nextClip,op,z,ox,oy,depth+1,childPath);")
    add(chunks, "  }")
    add(chunks, "  walk(document.documentElement,view,1,0,0,0,[]);")
    add(chunks, "  boxes.forEach(function(b,i){b.ord=i;});")
    add(chunks, "  boxes.sort(function(a,b){")
    add(chunks, "      var pa=a.paintPath||[], pb=b.paintPath||[];")
    add(chunks, "      var n=Math.min(pa.length,pb.length);")
    add(chunks, "      for(var i=0;i<n;i++){ if(pa[i]!==pb[i]) return pa[i]-pb[i]; }")
    add(chunks, "      return (pa.length-pb.length)||(a.ord-b.ord);")
    add(chunks, "    });")
    add(chunks, "  var ms=Math.round(performance.now()-t0);")
    add(chunks, "  // CLB4: 盒区与 CLB3 逐字节同布局(连续 10 行×count, 不得插入其他行); 交互")
    add(chunks, "  // 语义以 CTL|boxOrd|captureId|flags|role|name 行统一附在盒区之后(parser 只")
    add(chunks, "  // 读 count 个盒, 未知行跳过——沿 FONT| 先例)。boxOrd 是排序后文件盒下标,")
    add(chunks, "  // cheng 端控件表按它对齐盒/控件。")
    add(chunks, "  var out='CLB4\\n'+vw+' '+vh+' '+boxes.length+' '+ms+'\\n';")
    add(chunks, "  var ctlOut='';")
    add(chunks, "  for(var i=0;i<boxes.length;i++){")
    add(chunks, "    var b=boxes[i];")
    add(chunks, "    out+=[b.k,b.x,b.y,b.w,b.h,b.bg,b.fg,b.fs,b.bw,b.bc,b.rr,b.fw,b.sx,b.sy,b.sblur,b.sspread,b.sc,b.cx,b.cy,b.cw,b.ch].join(' ')+'\\n';")
    add(chunks, "    out+=esc(b.t)+'\\n'+esc(b.href)+'\\n'+esc(b.typ)+'\\n'+esc(b.id)+'\\n'+esc(b.val)+'\\n'+esc(b.txt)+'\\n'+esc(b.ff)+'\\n'+esc(b.img)+'\\n'+esc(b.opts||'')+'\\n';")
    add(chunks, "    if(b.ctlId>0){")
    add(chunks, "      ctlOut+='CTL|'+i+'|'+b.ctlId+'|'+b.ctlFlags+'|'+ctlEsc(b.ctlRole)+'|'+ctlEsc(b.ctlName)+'\\n';")
    add(chunks, "    }")
    add(chunks, "  }")
    add(chunks, "  out+=ctlOut;")
    add(chunks, "  window.__chengCaptureActive=0;")
    add(chunks, "  // 增量补丁字体通道: @font-face data:font/ttf 字节以 FONT|family|base64 尾行")
    add(chunks, "  // 附在盒区之后(Cheng parser 只读 count 个盒, 尾行天然忽略); host 取出注册")
    add(chunks, "  // CoreText 进程域, 右栏得以用页面真实网络字体渲染字形。")
    add(chunks, "  try{")
    add(chunks, "    var seen={};")
    add(chunks, "    for(var si=0;si<document.styleSheets.length;si++){")
    add(chunks, "      var rules=null;")
    add(chunks, "      try{ rules=document.styleSheets[si].cssRules; }catch(e){ continue; }")
    add(chunks, "      if(!rules) continue;")
    add(chunks, "      for(var ri=0;ri<rules.length;ri++){")
    add(chunks, "        var rule=rules[ri];")
    add(chunks, "        if(!rule.style) continue;")
    add(chunks, "        var src=rule.style.getPropertyValue('src')||'';")
    add(chunks, "        var m=src.match(/data:font\\/ttf;base64,([A-Za-z0-9+\\/=]+)/);")
    add(chunks, "        if(!m) continue;")
    add(chunks, "        var fam=(rule.style.getPropertyValue('font-family')||'').replace(/[\"']/g,'').trim();")
    add(chunks, "        if(!fam||seen[fam]) continue;")
    add(chunks, "        seen[fam]=1;")
    add(chunks, "        out+='FONT|'+esc(fam)+'|'+m[1]+'\\n';")
    add(chunks, "      }")
    add(chunks, "    }")
    add(chunks, "  }catch(e){}")
    add(chunks, "  return out;")
    add(chunks, "}")
    add(chunks, "function postCapture(){")
    add(chunks, "  try{")
    add(chunks, "    if(window.webkit&&window.webkit.messageHandlers&&window.webkit.messageHandlers.chengCapture){")
    add(chunks, "      window.webkit.messageHandlers.chengCapture.postMessage('live');")
    add(chunks, "    }")
    add(chunks, "  }catch(e){}")
    add(chunks, "}")
    add(chunks, "function requestRecapture(){")
    add(chunks, "  var st=window.__chengLive;")
    add(chunks, "  if(!st) return;")
    add(chunks, "  // webfont 就绪门控: 字体未加载完就抓盒, 度量会落在回退字体上,")
    add(chunks, "  // 与左栏字体加载后的重排发散(Back/Continue 几何左右不一致实证)。")
    add(chunks, "  if(document.fonts&&document.fonts.status!=='loaded'){ st.fontsWait=1; return; }")
    add(chunks, "  if(st.fontsWait){ st.fontsWait=0; }")
    add(chunks, "  if(st.raf) return;")
    add(chunks, "  st.raf=1;")
    add(chunks, "  requestAnimationFrame(function(){")
    add(chunks, "    st.raf=0;")
    add(chunks, "    postCapture();")
    add(chunks, "  });")
    add(chunks, "}")
    add(chunks, "if(document.fonts){")
    add(chunks, "  var onFontsReady=function(){")
    add(chunks, "    window.__chengLive=window.__chengLive||{raf:0};")
    add(chunks, "    if(window.__chengLive.fontsWait){ window.__chengLive.fontsWait=0; requestRecapture(); }")
    add(chunks, "  };")
    add(chunks, "  if(document.fonts.status==='loaded') setTimeout(onFontsReady,0);")
    add(chunks, "  else if(document.fonts.ready&&document.fonts.ready.then) document.fonts.ready.then(onFontsReady).catch(function(){});")
    add(chunks, "}")
    add(chunks, "function armDoc(doc){")
    add(chunks, "  if(!doc||doc.__chengArm) return;")
    add(chunks, "  try{ doc.__chengArm=1; }catch(e){ return; }")
    add(chunks, "  var root=doc.documentElement||doc;")
    add(chunks, "  try{")
    add(chunks, "    var mo=new MutationObserver(requestRecapture);")
    add(chunks, "    mo.observe(root,{subtree:true,childList:true,attributes:true,characterData:true});")
    add(chunks, "  }catch(e){}")
    add(chunks, "  function onEvt(){ requestRecapture(); }")
    add(chunks, "  function markSelectOpen(ev){")
    add(chunks, "    var t=ev&&ev.target;")
    add(chunks, "    if(!t||String(t.tagName).toLowerCase()!=='select') return;")
    add(chunks, "    if(ev.type==='keydown'){")
    add(chunks, "      var k=ev.key||'';")
    add(chunks, "      if(k!==' '&&k!=='Enter'&&k!=='ArrowDown'&&k!=='ArrowUp'&&k!=='F4') return;")
    add(chunks, "    }")
    add(chunks, "    t.__chengOpen=1;")
    add(chunks, "  }")
    add(chunks, "  function markSelectClosed(ev){")
    add(chunks, "    var t=ev&&ev.target;")
    add(chunks, "    if(!t||!t.tagName) return;")
    add(chunks, "    if(String(t.tagName).toLowerCase()==='select') t.__chengOpen=0;")
    add(chunks, "  }")
    add(chunks, "  var evts=['input','change','click','keyup','keydown','scroll','focus','blur','submit','toggle','transitionend','animationend'];")
    add(chunks, "  for(var i=0;i<evts.length;i++){")
    add(chunks, "    try{ doc.addEventListener(evts[i], onEvt, true); }catch(e){}")
    add(chunks, "  }")
    add(chunks, "  try{ doc.addEventListener('mousedown', markSelectOpen, true); }catch(e){}")
    add(chunks, "  try{ doc.addEventListener('keydown', markSelectOpen, true); }catch(e){}")
    add(chunks, "  try{ doc.addEventListener('change', markSelectClosed, true); }catch(e){}")
    add(chunks, "  try{ doc.addEventListener('blur', markSelectClosed, true); }catch(e){}")
    add(chunks, "  var win=doc.defaultView;")
    add(chunks, "  if(win){")
    add(chunks, "    try{ win.addEventListener('scroll', onEvt, true); }catch(e){}")
    add(chunks, "    try{ win.addEventListener('resize', onEvt, true); }catch(e){}")
    add(chunks, "    try{ win.addEventListener('hashchange', onEvt, true); }catch(e){}")
    add(chunks, "    try{ win.addEventListener('popstate', onEvt, true); }catch(e){}")
    add(chunks, "  }")
    add(chunks, "  var fs=doc.getElementsByTagName?doc.getElementsByTagName('iframe'):[];")
    add(chunks, "  for(var i=0;i<fs.length;i++){")
    add(chunks, "    (function(fr){")
    add(chunks, "      try{")
    add(chunks, "        var d=fr.contentDocument||(fr.contentWindow&&fr.contentWindow.document);")
    add(chunks, "        if(d) armDoc(d);")
    add(chunks, "      }catch(e){}")
    add(chunks, "      try{")
    add(chunks, "        fr.addEventListener('load', function(){")
    add(chunks, "          try{")
    add(chunks, "            var d2=fr.contentDocument||(fr.contentWindow&&fr.contentWindow.document);")
    add(chunks, "            if(d2) armDoc(d2);")
    add(chunks, "          }catch(e){}")
    add(chunks, "          requestRecapture();")
    add(chunks, "        });")
    add(chunks, "      }catch(e){}")
    add(chunks, "    })(fs[i]);")
    add(chunks, "  }")
    add(chunks, "}")
    add(chunks, "function armLive(){")
    add(chunks, "  if(!window.__chengLive) window.__chengLive={raf:0};")
    add(chunks, "  armDoc(document);")
    add(chunks, "}")
    add(chunks, "try{ armLive(); return capture(); }")
    add(chunks, "catch(e){ return 'CLB-ERR '+String(e&&e.message?e.message:e); }")
    add(chunks, "})();")
    add(chunks, "")
    return strutil.Join(chunks, "\n")
