import std/cmdline as cmdline
import std/os
import std/strings
import cheng/apps/libp2p_browser/session as sess

@borrows
fn BrowserMainPrint(text: str) =
    os.WriteLine(os.Get_stdout(), text)

@borrows
fn BrowserReadFlag(args: str[], key: str): str =
    let colon = strings.ConcatStr(key, ":")
    var i: int32 = 0
    while i < args.len:
        let arg = args[i]
        if strings.StrContains(arg, colon) && i >= 0:
            if arg.len >= colon.len:
                var prefOk = true
                var j: int32 = 0
                while j < colon.len:
                    if arg[j] != colon[j]:
                        prefOk = false
                    j = j + 1
                if prefOk:
                    return strings.ConcatStr(strings.SliceBytes(arg, colon.len, arg.len - colon.len), "")
        i = i + 1
    return ""

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    var args: str[]
    var i: int32 = 1
    let n = cmdline.ParamCount()
    while i <= n:
        add(args, strings.ConcatStr(cmdline.ParamStr(i), ""))
        i = i + 1
    let htmlPath = BrowserReadFlag(args, "--html")
    let url = BrowserReadFlag(args, "--url")
    let peer = BrowserReadFlag(args, "--peer")
    let selfPeer = BrowserReadFlag(args, "--self")
    var selfText = strings.ConcatStr(selfPeer, "")
    if selfText.len <= 0:
        selfText = "desktop-peer"
    var session = sess.BrowserSessionInit(selfText, 640, 720)
    if peer.len > 0:
        if !sess.BrowserSessionAttachPeer(session, peer):
            BrowserMainPrint(session.lastError)
            return 2
        if !sess.BrowserSessionSelectPeer(session, peer):
            BrowserMainPrint(session.lastError)
            return 3
    var pageUrl = strings.ConcatStr(url, "")
    var html: str = ""
    if htmlPath.len <= 0:
        BrowserMainPrint("usage: libp2p-browser --html:<path> [--url:<url>] [--peer:<id>] [--self:<id>]")
        return 0
    if !os.ReadFileInto(htmlPath, html):
        BrowserMainPrint("libp2p-browser: html file missing")
        return 4
    if pageUrl.len <= 0:
        pageUrl = strings.ConcatStr("file://", htmlPath)
    sess.BrowserSessionBeginLoad(session, pageUrl)
    if session.rightOpen:
        BrowserMainPrint("libp2p-browser: right opened before load complete")
        return 6
    if !sess.BrowserSessionOnLoadComplete(session, html):
        BrowserMainPrint(session.lastError)
        return 7
    if !session.rightOpen:
        BrowserMainPrint("libp2p-browser: right did not open")
        return 8
    BrowserMainPrint(sess.BrowserSessionStatsLine(session))
    BrowserMainPrint(sess.BrowserSessionSnapshotJson(session))
    return 0
