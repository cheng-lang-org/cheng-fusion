import std/strings
import std/strutils as strutil
import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_style_runtime as style
import cheng/core/runtime/web_layout_runtime as layout
import cheng/core/runtime/web_style_layout_bridge as bridge
import cheng/core/runtime/web_paint_runtime as paint
import cheng/apps/libp2p_browser/html_parse as htmlparse

@importc("cheng_monotime_ns")
fn BrowserMonoNs(): int64

const
    BrowserWidgetInput: int32 = 1
    BrowserWidgetTextarea: int32 = 2
    BrowserWidgetAnchor: int32 = 3
    BrowserWidgetButton: int32 = 4
    BrowserWidgetSelect: int32 = 6
    BrowserWidgetOption: int32 = 7

type
    BrowserCompileStats =
        parseMs: int64
        styleMs: int64
        layoutMs: int64
        paintMs: int64
        nodeCount: int32
        inputCount: int32
        eventCount: int32
        widgetCount: int32
        opCount: int32
        boxCount: int32
        styleCount: int32
        viewportW: int32
        viewportH: int32
        cssParseOk: bool

    BrowserWidget =
        kind: int32
        nodeId: int32
        fieldId: str
        href: str
        inputType: str
        value: str
        options: str
        x: int32
        y: int32
        w: int32
        h: int32
        # CLB4 控件语义(captureId/flags/role/name), 快照线专用;
        # HTML 重排旧路线产 0/""(无语义)。
        ctlId: int32
        ctlFlags: int32
        ctlRole: str
        ctlName: str

    BrowserCompileBundle =
        stats: BrowserCompileStats
        err: str
        ops: paint.PaintOp[]
        widgets: BrowserWidget[]

fn BrowserMsSince(startNs: int64): int64 =
    let now = BrowserMonoNs()
    if now < startNs:
        return 0
    return (now - startNs) / 1000000

fn BrowserHexDigit(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'a' && ch <= 'f':
        return int32(ch) - int32('a') + 10
    if ch >= 'A' && ch <= 'F':
        return int32(ch) - int32('A') + 10
    return -1

fn BrowserParseIntClamped(text: str, out: var int32): bool =
    var i: int32 = 0
    var n: int32 = 0
    var any = false
    while i < text.len && (text[i] == ' ' || text[i] == '\t'):
        i = i + 1
    while i < text.len && text[i] >= '0' && text[i] <= '9':
        n = n * 10 + (int32(text[i]) - int32('0'))
        any = true
        i = i + 1
    if !any:
        return false
    out = n
    return true

@borrows
fn BrowserParseCssColor(text: str, out: var int32): bool =
    var t = strutil.ToLowerAscii(htmlparse.HtmlTrimAscii(text))
    if t.len <= 0:
        return false
    if t == "transparent":
        out = 0
        return true
    if t == "white":
        out = int32(0xFFFFFFFF)
        return true
    if t == "black":
        out = int32(0xFF000000)
        return true
    if t == "red":
        out = int32(0xFFFF0000)
        return true
    if t == "blue":
        out = int32(0xFF0000EE)
        return true
    if t == "navy":
        out = int32(0xFF000080)
        return true
    if t == "gray" || t == "grey":
        out = int32(0xFF808080)
        return true
    if t == "silver":
        out = int32(0xFFC0C0C0)
        return true
    if t == "green":
        out = int32(0xFF008000)
        return true
    if t == "yellow":
        out = int32(0xFFFFFF00)
        return true
    if t == "orange":
        out = int32(0xFFFFA500)
        return true
    if t == "purple":
        out = int32(0xFF800080)
        return true
    if t == "teal":
        out = int32(0xFF008080)
        return true
    if t == "aqua" || t == "cyan":
        out = int32(0xFF00FFFF)
        return true
    if t == "fuchsia" || t == "magenta":
        out = int32(0xFFFF00FF)
        return true
    if t == "lime":
        out = int32(0xFF00FF00)
        return true
    if t == "maroon":
        out = int32(0xFF800000)
        return true
    if t == "olive":
        out = int32(0xFF808000)
        return true
    if t.len >= 4 && t[0] == '#':
        if t.len == 4:
            let r = BrowserHexDigit(t[1])
            let g = BrowserHexDigit(t[2])
            let b = BrowserHexDigit(t[3])
            if r < 0 || g < 0 || b < 0:
                return false
            out = int32(0xFF000000) | ((r * 16 + r) << 16) | ((g * 16 + g) << 8) | (b * 16 + b)
            return true
        if t.len == 7:
            let r = BrowserHexDigit(t[1]) * 16 + BrowserHexDigit(t[2])
            let g = BrowserHexDigit(t[3]) * 16 + BrowserHexDigit(t[4])
            let b = BrowserHexDigit(t[5]) * 16 + BrowserHexDigit(t[6])
            if r < 0 || g < 0 || b < 0:
                return false
            out = int32(0xFF000000) | (r << 16) | (g << 8) | b
            return true
        return false
    if t.len >= 10 && t[0] == 'r' && t[1] == 'g' && t[2] == 'b' && t[3] == '(':
        var nums: int32[]
        var i: int32 = 4
        var cur: int32 = 0
        var have = false
        while i < t.len:
            let ch = t[i]
            if ch >= '0' && ch <= '9':
                cur = cur * 10 + (int32(ch) - int32('0'))
                have = true
            else:
                if have:
                    add(nums, cur)
                    cur = 0
                    have = false
                if ch == ')':
                    break
            i = i + 1
        if have:
            add(nums, cur)
        if nums.len < 3:
            return false
        out = int32(0xFF000000) | ((nums[0] & 255) << 16) | ((nums[1] & 255) << 8) | (nums[2] & 255)
        return true
    return false

@borrows
fn BrowserSpanText(source: str, start: int32, stop: int32): str =
    if start < 0 || stop < start || source.len <= 0:
        return ""
    if start >= source.len:
        return ""
    var end = stop
    if end >= source.len:
        end = source.len - 1
    return htmlparse.HtmlSlice(source, start, end + 1)

@borrows
fn BrowserFieldId(document: var web.WebDocument, nodeId: int32): str =
    var idAttr: str
    if web.WebDocumentGetAttribute(document, nodeId, "id", idAttr) && idAttr.len > 0:
        return idAttr
    var nameAttr: str
    if web.WebDocumentGetAttribute(document, nodeId, "name", nameAttr) && nameAttr.len > 0:
        return nameAttr
    return strings.ConcatStr("n", strings.IntToStr(nodeId))

@borrows
fn BrowserResolveUrl(baseUrl: str, href: str): str =
    if href.len <= 0:
        return baseUrl
    if href.len >= 7 && htmlparse.HtmlStartsAtIgnoreCase(href, 0, "http://"):
        return href
    if href.len >= 8 && htmlparse.HtmlStartsAtIgnoreCase(href, 0, "https://"):
        return href
    if href.len >= 7 && htmlparse.HtmlStartsAtIgnoreCase(href, 0, "file://"):
        return href
    if href.len >= 5 && htmlparse.HtmlStartsAtIgnoreCase(href, 0, "data:"):
        return href
    if href[0] == '#':
        return strings.ConcatStr(baseUrl, href)
    if href[0] == '/':
        var schemeEnd: int32 = 0
        while schemeEnd < baseUrl.len && baseUrl[schemeEnd] != ':':
            schemeEnd = schemeEnd + 1
        if schemeEnd + 2 < baseUrl.len && baseUrl[schemeEnd] == ':' && baseUrl[schemeEnd + 1] == '/' && baseUrl[schemeEnd + 2] == '/':
            var hostEnd = schemeEnd + 3
            while hostEnd < baseUrl.len && baseUrl[hostEnd] != '/' && baseUrl[hostEnd] != '?' && baseUrl[hostEnd] != '#':
                hostEnd = hostEnd + 1
            let origin = htmlparse.HtmlSlice(baseUrl, 0, hostEnd)
            return strings.ConcatStr(origin, href)
        return href
    var cut = baseUrl.len
    var i = baseUrl.len - 1
    while i >= 0:
        if baseUrl[i] == '/' :
            cut = i + 1
            break
        i = i - 1
    let prefix = htmlparse.HtmlSlice(baseUrl, 0, cut)
    return strings.ConcatStr(prefix, href)

@borrows
fn BrowserDefaultFill(tag: str): int32 =
    if tag == "input" || tag == "textarea" || tag == "select":
        return int32(0xFFFFFFFF)
    if tag == "button":
        return int32(0xFFE5E7EB)
    if tag == "body" || tag == "html":
        return int32(0xFFFFFFFF)
    if tag == "a":
        return 0
    return int32(0x00000000)

@borrows
fn BrowserDefaultTextColor(tag: str): int32 =
    if tag == "a":
        return int32(0xFF0000EE)
    return int32(0xFF111827)

@borrows
fn BrowserRegisterNodePaint(document: var web.WebDocument,
                              sheet: var style.WebStyleSheet,
                              registry: var paint.WebPaintColorRegistry,
                              nodeId: int32,
                              tag: str): bool =
    var fill = BrowserDefaultFill(tag)
    var bg: str
    if web.WebDocumentGetInlineStyleValue(document, nodeId, "background-color", bg):
        var parsed: int32
        if BrowserParseCssColor(bg, parsed):
            fill = parsed
    elif web.WebDocumentGetInlineStyleValue(document, nodeId, "background", bg):
        var parsed: int32
        if BrowserParseCssColor(bg, parsed):
            fill = parsed
    if fill != 0:
        if !paint.WebPaintRegisterFillStyle(registry, nodeId, fill, 0):
            return false
    var computed: style.WebComputedStyle
    var textColor = BrowserDefaultTextColor(tag)
    if style.WebStyleSheetComputeStyle(document, sheet, nodeId, computed):
        if computed.hasColor:
            let colorText = BrowserSpanText(computed.colorSource, computed.colorStart, computed.colorStop)
            var parsedText: int32
            if BrowserParseCssColor(colorText, parsedText):
                textColor = parsedText
    if !paint.WebPaintRegisterTextColor(registry, nodeId, textColor):
        return false
    if tag == "input" || tag == "textarea" || tag == "select" || tag == "button":
        if !paint.WebPaintRegisterBorderStyle(registry, nodeId, int32(0xFF9CA3AF), 1, 1, 1, 1, 2):
            return false
    return true

fn BrowserNodePlainText(document: var web.WebDocument, nodeId: int32, out: var str): bool =
    out = ""
    let kind = web.WebDocumentNodeKind(document, nodeId)
    if kind == web.WebNodeKindText:
        return web.WebDocumentNodeTextContent(document, nodeId, out)
    var parts: str[]
    let n = web.WebDocumentChildCount(document, nodeId)
    var i: int32 = 0
    while i < n:
        let cid = web.WebDocumentChildAt(document, nodeId, i)
        i = i + 1
        var t: str
        if BrowserNodePlainText(document, cid, t) && t.len > 0:
            add(parts, t)
    out = strutil.Join(parts, "")
    return true

fn BrowserSelectOptionPayload(document: var web.WebDocument, selectId: int32): str =
    var parts: str[]
    let n = web.WebDocumentChildCount(document, selectId)
    var i: int32 = 0
    while i < n:
        let cid = web.WebDocumentChildAt(document, selectId, i)
        i = i + 1
        if web.WebDocumentNodeKind(document, cid) != web.WebNodeKindElement:
            continue
        var tag: str
        if !web.WebDocumentNodeTagName(document, cid, tag):
            continue
        if tag != "option":
            continue
        var val: str = ""
        web.WebDocumentGetAttribute(document, cid, "value", val)
        var label: str = ""
        BrowserNodePlainText(document, cid, label)
        if val.len <= 0:
            val = strings.ConcatStr(label, "")
        var selected: int32 = 0
        var sattr: str = ""
        if web.WebDocumentGetAttribute(document, cid, "selected", sattr):
            selected = 1
        add(parts, strings.IntToStr(selected))
        add(parts, "\t")
        add(parts, val)
        add(parts, "\t")
        add(parts, label)
        add(parts, "\n")
    return strutil.Join(parts, "")

@borrows
fn BrowserSelectChosenLabel(payload: str): str =
    var pos: int32 = 0
    while pos < payload.len:
        var lineEnd = pos
        while lineEnd < payload.len && payload[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        if lineEnd > pos && payload[pos] == '1':
            var t1 = pos
            while t1 < lineEnd && payload[t1] != '\t':
                t1 = t1 + 1
            var t2 = t1 + 1
            while t2 < lineEnd && payload[t2] != '\t':
                t2 = t2 + 1
            if t2 + 1 < lineEnd:
                return htmlparse.HtmlSlice(payload, t2 + 1, lineEnd)
            if t1 + 1 < t2:
                return htmlparse.HtmlSlice(payload, t1 + 1, t2)
        if lineEnd < payload.len:
            pos = lineEnd + 1
        else:
            pos = payload.len
    return ""

@borrows
fn BrowserCollectWidgets(document: var web.WebDocument,
                           tree: var layout.WebLayoutTree,
                           widgets: var BrowserWidget[]): bool =
    widgets = []
    let n = web.WebDocumentNodeCount(document)
    var i: int32 = 0
    while i < n:
        let nodeId = web.WebDocumentNodeIdAt(document, i)
        i = i + 1
        if web.WebDocumentNodeKind(document, nodeId) != web.WebNodeKindElement:
            continue
        var tag: str
        if !web.WebDocumentNodeTagName(document, nodeId, tag):
            continue
        var kind: int32 = 0
        if tag == "input":
            kind = BrowserWidgetInput
        elif tag == "textarea":
            kind = BrowserWidgetTextarea
        elif tag == "a":
            kind = BrowserWidgetAnchor
        elif tag == "button":
            kind = BrowserWidgetButton
        elif tag == "select":
            kind = BrowserWidgetSelect
        if kind == 0:
            continue
        let boxIndex = layout.WebLayoutFindBoxIndexForNodeFrom(tree, nodeId, 0)
        if boxIndex < 0:
            continue
        var w: BrowserWidget
        w.kind = kind
        w.nodeId = nodeId
        w.fieldId = BrowserFieldId(document, nodeId)
        w.href = ""
        w.inputType = ""
        w.value = ""
        w.options = ""
        w.ctlId = 0
        w.ctlFlags = 0
        w.ctlRole = ""
        w.ctlName = ""
        w.x = layout.WebLayoutBoxXAt(tree, boxIndex)
        w.y = layout.WebLayoutBoxYAt(tree, boxIndex)
        w.w = layout.WebLayoutBoxWidthAt(tree, boxIndex)
        w.h = layout.WebLayoutBoxHeightAt(tree, boxIndex)
        if kind == BrowserWidgetAnchor:
            var href: str
            if web.WebDocumentGetAttribute(document, nodeId, "href", href):
                w.href = href
        if kind == BrowserWidgetInput:
            var inputType: str
            if !web.WebDocumentGetAttribute(document, nodeId, "type", inputType):
                inputType = "text"
            w.inputType = strutil.ToLowerAscii(inputType)
            var formValue: str
            if web.WebDocumentGetFormValue(document, nodeId, formValue):
                w.value = formValue
        if kind == BrowserWidgetTextarea:
            w.inputType = "textarea"
            var formValue: str
            if web.WebDocumentGetFormValue(document, nodeId, formValue):
                w.value = formValue
        if kind == BrowserWidgetButton:
            var buttonType: str
            if !web.WebDocumentGetAttribute(document, nodeId, "type", buttonType):
                buttonType = "submit"
            w.inputType = strutil.ToLowerAscii(buttonType)
        if kind == BrowserWidgetSelect:
            w.inputType = "select"
            w.options = BrowserSelectOptionPayload(document, nodeId)
            var formValue: str
            if web.WebDocumentGetFormValue(document, nodeId, formValue) && formValue.len > 0:
                w.value = formValue
            elif w.options.len > 0:
                w.value = BrowserSelectChosenLabel(w.options)
        add(widgets, w)
    return true

@borrows
fn BrowserHitWidget(widgets: BrowserWidget[], x: int32, y: int32): int32 =
    var i = widgets.len - 1
    while i >= 0:
        let w = widgets[i]
        if x >= w.x && y >= w.y && x < w.x + w.w && y < w.y + w.h:
            return i
        i = i - 1
    return -1

@borrows
fn BrowserCompileHtml(html: str,
                        extraCss: str,
                        viewportW: int32,
                        viewportH: int32,
                        document: var web.WebDocument,
                        bundle: var BrowserCompileBundle): bool =
    bundle.stats.parseMs = 0
    bundle.stats.styleMs = 0
    bundle.stats.layoutMs = 0
    bundle.stats.paintMs = 0
    bundle.stats.nodeCount = 0
    bundle.stats.inputCount = 0
    bundle.stats.eventCount = 0
    bundle.stats.widgetCount = 0
    bundle.stats.opCount = 0
    bundle.stats.boxCount = 0
    bundle.stats.styleCount = 0
    bundle.stats.viewportW = viewportW
    bundle.stats.viewportH = viewportH
    bundle.stats.cssParseOk = true
    bundle.err = ""
    bundle.ops = []
    bundle.widgets = []
    let t0 = BrowserMonoNs()
    if !htmlparse.HtmlParseDocument(html, document):
        bundle.err = htmlparse.HtmlParseError()
        bundle.stats.parseMs = BrowserMsSince(t0)
        return false
    bundle.stats.parseMs = BrowserMsSince(t0)
    bundle.stats.nodeCount = web.WebDocumentNodeCount(document)
    let t1 = BrowserMonoNs()
    var sheet: style.WebStyleSheet
    style.WebStyleSheetInit(sheet)
    var cssText = htmlparse.HtmlParseCss()
    if extraCss.len > 0:
        if cssText.len > 0:
            cssText = strings.ConcatStr(cssText, strings.ConcatStr("\n", extraCss))
        else:
            cssText = strings.ConcatStr(extraCss, "")
    if cssText.len > 0:
        if !style.WebStyleSheetParse(cssText, sheet):
            bundle.stats.cssParseOk = false
            style.WebStyleSheetInit(sheet)
    bundle.stats.styleMs = BrowserMsSince(t1)
    let t2 = BrowserMonoNs()
    var tree: layout.WebLayoutTree
    var layoutRoot = web.WebDocumentFindDocumentElement(document)
    if layoutRoot <= 0:
        var bodyId: int32
        if web.WebDocumentEnsureBody(document, bodyId):
            layoutRoot = bodyId
        else:
            layoutRoot = document.rootNodeId
    if !bridge.WebStyleLayoutBridgeBuildTree(document, sheet, layoutRoot, tree):
        bundle.err = "compile: layout bridge"
        bundle.stats.layoutMs = BrowserMsSince(t2)
        return false
    var ei: int32 = 0
    let nNodes = web.WebDocumentNodeCount(document)
    while ei < nNodes:
        let nodeId = web.WebDocumentNodeIdAt(document, ei)
        ei = ei + 1
        if web.WebDocumentNodeKind(document, nodeId) != web.WebNodeKindElement:
            continue
        if layout.WebLayoutFindStyleIndex(tree, nodeId) < 0:
            continue
        let parentId = web.WebDocumentParentOf(document, nodeId)
        if parentId <= 0:
            continue
        if layout.WebLayoutFindStyleIndex(tree, parentId) < 0:
            continue
        if layout.WebLayoutParentOf(tree, nodeId) != 0:
            continue
        if !bridge.WebStyleLayoutBridgeAppendChild(tree, parentId, nodeId):
            continue
    var vw = viewportW
    var vh = viewportH
    if vw <= 0:
        vw = 640
    if vh <= 0:
        vh = 720
    var computeRoot = tree.rootNodeId
    if computeRoot <= 0:
        computeRoot = layoutRoot
    if !layout.WebLayoutSetRootViewport(tree, computeRoot, vw, vh):
        bundle.err = "compile: viewport"
        bundle.stats.layoutMs = BrowserMsSince(t2)
        return false
    if !layout.WebLayoutCompute(tree, computeRoot):
        bundle.err = "compile: layout"
        bundle.stats.layoutMs = BrowserMsSince(t2)
        return false
    var extraY: int32 = 8
    if tree.boxes.len > 0:
        let lastBox = tree.boxes[tree.boxes.len - 1]
        extraY = lastBox.y + lastBox.height + 8
    var si: int32 = 0
    while si < tree.styles.len:
        let styleRow = tree.styles[si]
        let styledId = styleRow.nodeId
        if styledId > 0 && styleRow.display != layout.WebLayoutDisplayNone:
            if layout.WebLayoutFindBoxIndexForNodeFrom(tree, styledId, 0) < 0:
                if layout.WebLayoutLayoutSubtree(tree, styledId, 8, extraY, vw):
                    let newIdx = layout.WebLayoutFindBoxIndexForNodeFrom(tree, styledId, 0)
                    if newIdx >= 0:
                        extraY = layout.WebLayoutBoxYAt(tree, newIdx) + layout.WebLayoutBoxHeightAt(tree, newIdx) + 8
        si = si + 1
    bundle.stats.layoutMs = BrowserMsSince(t2)
    let t3 = BrowserMonoNs()
    var registry: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(registry)
    let n = web.WebDocumentNodeCount(document)
    var ni: int32 = 0
    while ni < n:
        let nodeId = web.WebDocumentNodeIdAt(document, ni)
        ni = ni + 1
        if web.WebDocumentNodeKind(document, nodeId) != web.WebNodeKindElement:
            continue
        var tag: str
        if !web.WebDocumentNodeTagName(document, nodeId, tag):
            continue
        if !BrowserRegisterNodePaint(document, sheet, registry, nodeId, tag):
            bundle.err = "compile: paint register"
            bundle.stats.paintMs = BrowserMsSince(t3)
            return false
    var ops: paint.PaintOp[]
    if !paint.WebPaintBuildOpsFromLayoutTreeWithRegistry(tree, registry, ops):
        bundle.err = "compile: paint ops"
        bundle.stats.paintMs = BrowserMsSince(t3)
        return false
    var widgets: BrowserWidget[]
    if !BrowserCollectWidgets(document, tree, widgets):
        bundle.err = "compile: widgets"
        bundle.stats.paintMs = BrowserMsSince(t3)
        return false
    bundle.ops = ops
    bundle.widgets = widgets
    bundle.stats.paintMs = BrowserMsSince(t3)
    bundle.stats.opCount = ops.len
    bundle.stats.widgetCount = widgets.len
    bundle.stats.boxCount = tree.boxes.len
    bundle.stats.styleCount = tree.styles.len
    var inputCount: int32 = 0
    var wi: int32 = 0
    while wi < widgets.len:
        if widgets[wi].kind == BrowserWidgetInput || widgets[wi].kind == BrowserWidgetTextarea:
            inputCount = inputCount + 1
        wi = wi + 1
    bundle.stats.inputCount = inputCount
    bundle.stats.eventCount = document.listeners.len
    return true

fn BrowserArgbChannel(color: int32, shift: int32): int32 =
    let v = (color >> shift) & 255
    if v < 0:
        return v + 256
    return v
