# 双栏快照线 → CSG 合流(Q6): 把 CLB4 控件表导出为 CsgWebControlSurfaceFact[]
# (对齐 src/core/ir/csg_web_facts.cheng schema), 快照线与 ts-csg 热换线接轨。
# 映射确定性: 显式 role 优先, 空时按 W3C implicit ARIA 从 kind/inputType 推导;
# actionKind 按控件类型唯一主动作; disabled 位入 guard; 无启发式匹配。
# effectClass 等页面语义(外发/支付)不在静态导出中臆断, 留空由动作层显式声明。

import std/strings
import cheng/core/ir/csg_web_facts as csgweb
import cheng/apps/libp2p_browser/compile_render as compile
import cheng/apps/libp2p_browser/session as sess

fn BrowserCsgIsTextInputType(inputType: str): bool =
    # number 框的 implicit role 是 spinbutton, 其余可输入框是 textbox
    return inputType == "number"

@borrows
fn BrowserCsgImplicitRole(kind: int32, inputType: str, explicit: str): str =
    if explicit.len > 0:
        return strings.ConcatStr(explicit, "")
    if kind == compile.BrowserWidgetButton:
        return "button"
    if kind == compile.BrowserWidgetAnchor:
        return "link"
    if kind == compile.BrowserWidgetSelect:
        return "combobox"
    if kind == compile.BrowserWidgetTextarea:
        return "textbox"
    if kind == compile.BrowserWidgetInput:
        if inputType == "checkbox":
            return "checkbox"
        if inputType == "radio":
            return "radio"
        if inputType == "number":
            return "spinbutton"
        if inputType == "submit" || inputType == "button":
            return "button"
        return "textbox"
    return "generic"

@borrows
fn BrowserCsgActionKind(kind: int32, inputType: str): str =
    # 唯一主动作: 勾选类 Toggle, 选择类 Select, 可输入类 SetText, 其余 Click
    if kind == compile.BrowserWidgetSelect:
        return "Select"
    if kind == compile.BrowserWidgetInput:
        if inputType == "checkbox" || inputType == "radio":
            return "Toggle"
        if inputType != "submit" && inputType != "button":
            return "SetText"
    if kind == compile.BrowserWidgetTextarea:
        return "SetText"
    return "Click"

@borrows
fn BrowserCsgPayloadSchema(kind: int32, inputType: str): str =
    let action = BrowserCsgActionKind(kind, inputType)
    if action == "Select":
        return "option-ref"
    if action == "SetText":
        if inputType == "number":
            return "number"
        return "text"
    return ""

# 单返回点 helper: 条件重赋值托管 local 会触发 drop 溯源失败(编译器前科),
# 所有派生串经 helper 单点返回, 保证 exact owned definition。
fn BrowserCsgPickNonEmpty(value: str, fallback: str): str =
    if value.len > 0:
        return strings.ConcatStr(value, "")
    return strings.ConcatStr(fallback, "")

fn BrowserCsgDisabledGuard(flags: int32): str =
    if (flags & 1) == 1:
        return "disabled"
    return ""

@borrows
fn BrowserCsgExportControlSurface(session: sess.BrowserSession, owner: str): csgweb.CsgWebControlSurfaceFact[] =
    # 结构体字面量逐行构造(仓内 CSG fact 构造先例: csg_web_media_facts_smoke)
    var facts: csgweb.CsgWebControlSurfaceFact[]
    facts = []
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].ctlId > 0:
            # 构造器每个托管字段一个新鲜表达式(local 不跨字段复用,
            # 避免字段来源 movable 判定失败)
            let ctlId = session.widgets[i].ctlId
            let role = BrowserCsgImplicitRole(session.widgets[i].kind, session.widgets[i].inputType, session.widgets[i].ctlRole)
            let actionKind = BrowserCsgActionKind(session.widgets[i].kind, session.widgets[i].inputType)
            let payloadSchema = BrowserCsgPayloadSchema(session.widgets[i].kind, session.widgets[i].inputType)
            let guard = BrowserCsgDisabledGuard(session.widgets[i].ctlFlags)
            add(facts, csgweb.CsgWebControlSurfaceFact(
                kind: csgweb.CsgWebControlSurface,
                id: strings.ConcatStr("csg.web.control_surface:ctl-", strings.IntToStr(ctlId)),
                coreFact: "clb4-snapshot",
                nodeTemplate: BrowserCsgPickNonEmpty(strings.ConcatStr(session.widgets[i].fieldId, ""), strings.ConcatStr("ctl-", strings.IntToStr(ctlId))),
                owner: strings.ConcatStr(owner, ""),
                role: role,
                label: strings.ConcatStr(session.widgets[i].ctlName, ""),
                stateRef: strings.ConcatStr(session.widgets[i].fieldId, ""),
                actionKind: actionKind,
                payloadSchema: payloadSchema,
                effect: "",
                guard: guard,
                trace: strings.ConcatStr("clb4:ctl-", strings.IntToStr(ctlId)),
                sourceFile: strings.ConcatStr(owner, ""),
                sourceLine: 0
            ))
        i = i + 1
    return facts
