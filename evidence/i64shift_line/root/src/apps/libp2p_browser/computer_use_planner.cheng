# Q4b 多步规划(LLM 在环): 控件树清单喂真实模型 → 指令序列 → 执行回读循环。
# 本模块只做确定性的 prompt 组装与回复解析(协议解析, 非 Mock 模型——模型
# 调用发生在 host 的真实 HTTP 端点); 解析出的每条指令经 BrowserCuseCommand
# 执行, 全量继承 typed 准入/确认门/hard-fail 语义。
# 指令协议沿 Q4a 语法: 动词 目标 [载荷], 引号支持多词名。
# 返回码: 0=ok; -10 plan_e_empty_controls; -11 plan_e_no_steps; -12 plan_e_bad_reply

import std/strings
import std/strutils as strutil
import cheng/apps/libp2p_browser/session as sess
import cheng/apps/libp2p_browser/computer_use_command as cmd

@borrows
fn BrowserCusePlanControlsOrEmpty(session: sess.BrowserSession): bool =
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].ctlId > 0:
            return true
        i = i + 1
    return false

@borrows
fn BrowserCusePlanKindLabel(kind: int32, inputType: str): str =
    # 模型友好的控件类型标签(确定性单点映射)
    if kind == 4:
        return "button"
    if kind == 3:
        return "link"
    if kind == 6:
        return "combobox"
    if kind == 2:
        return "textbox"
    if kind == 1:
        if inputType == "checkbox":
            return "checkbox"
        if inputType == "radio":
            return "radio"
        if inputType == "number":
            return "number box"
        if inputType == "submit" || inputType == "button":
            return "button"
        return "textbox"
    return "control"

@borrows
fn BrowserCusePlanControlsText(session: sess.BrowserSession): str =
    # 模型视角控件清单: 名称优先且唯一可寻址标识, 不暴露 ctlId
    # (模型见到数字会误用为目标——实证后移除)
    var out: str = ""
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].ctlId > 0:
            out = strings.ConcatStr(out, "- \"")
            out = strings.ConcatStr(out, session.widgets[i].ctlName)
            out = strings.ConcatStr(out, "\" (")
            out = strings.ConcatStr(out, BrowserCusePlanKindLabel(session.widgets[i].kind, session.widgets[i].inputType))
            out = strings.ConcatStr(out, ")")
            if session.widgets[i].value.len > 0:
                out = strings.ConcatStr(out, " current value: ")
                out = strings.ConcatStr(out, session.widgets[i].value)
            if (session.widgets[i].ctlFlags & 1) == 1:
                out = strings.ConcatStr(out, " [disabled]")
            out = strings.ConcatStr(out, "\n")
        i = i + 1
    return out

@borrows
fn BrowserCusePlanSetAllow(session: var sess.BrowserSession, allow: str) =
    session.planAllow = strings.ConcatStr(allow, "")

@borrows
fn BrowserCusePlanBegin(session: var sess.BrowserSession, goal: str): int32 =
    if !BrowserCusePlanControlsOrEmpty(session):
        session.lastError = "plan_e_empty_controls"
        return -10
    # 小模型友好: 控件清单 + 目标 + 严格指令协议 + few-shot, 输出只允许指令行
    var prompt: str = ""
    prompt = strings.ConcatStr(prompt, "You control a web page. Controls:\n")
    prompt = strings.ConcatStr(prompt, BrowserCusePlanControlsText(session))
    prompt = strings.ConcatStr(prompt, "Goal: ")
    prompt = strings.ConcatStr(prompt, goal)
    prompt = strings.ConcatStr(prompt, "\n")
    prompt = strings.ConcatStr(prompt, "Output commands, one per line, format: VERB \"TARGET\" [PAYLOAD]\n")
    prompt = strings.ConcatStr(prompt, "VERB MUST be exactly one of: set, click, select, toggle, read. Never invent verbs like \"search\" or \"open\".\n")
    prompt = strings.ConcatStr(prompt, "To perform a search: set the text into the search textbox, then click the search button.\n")
    if session.planAllow.len > 0:
        prompt = strings.ConcatStr(prompt, "Allowed verbs for this goal: ")
        prompt = strings.ConcatStr(prompt, session.planAllow)
        prompt = strings.ConcatStr(prompt, ". Commands with other verbs will be discarded.\n")
    prompt = strings.ConcatStr(prompt, "TARGET is the exact control name from the list above, always wrapped in double quotes.\n")
    prompt = strings.ConcatStr(prompt, "Examples (generic, use the control names from the list above, never these):\n")
    prompt = strings.ConcatStr(prompt, "set \"City\" Berlin\n")
    prompt = strings.ConcatStr(prompt, "click \"Submit\"\n")
    prompt = strings.ConcatStr(prompt, "toggle \"Remember me\"\n")
    prompt = strings.ConcatStr(prompt, "Output only command lines, nothing else.\n")
    session.planPrompt = strings.ConcatStr(prompt, "")
    session.planSteps = []
    return 0

@borrows
fn BrowserCuseVerbAllowed(session: sess.BrowserSession, line: str): bool =
    # planAllow 空=不限制; 非空=首词动词必须在允许集(逗号分隔)内
    if session.planAllow.len <= 0:
        return true
    var head: str = ""
    var rest: str = ""
    if !cmd.BrowserCuseFirstToken(line, head, rest):
        return false
    var actionRaw: str = ""
    if !cmd.BrowserCuseMapVerb(head, actionRaw):
        return false
    let action = strutil.ToLowerAscii(actionRaw)
    var pos: int32 = 0
    while pos < session.planAllow.len:
        var end: int32 = pos
        while end < session.planAllow.len && session.planAllow[end] != ',':
            end = end + 1
        let item = strutil.ToLowerAscii(strings.SliceBytes(session.planAllow, pos, end))
        if item.len > 0 && item == action:
            return true
        pos = end + 1
    return false

fn BrowserCuseLineLooksLikeCommand(line: str): bool =
    # 协议行判定: 首词必须是已知动词(确定性解析, 不猜语义)
    var head: str = ""
    var rest: str = ""
    if !cmd.BrowserCuseFirstToken(line, head, rest):
        return false
    var action: str = ""
    return cmd.BrowserCuseMapVerb(head, action)

@borrows
fn BrowserCusePlanAddStep(session: var sess.BrowserSession, line: str) =
    add(session.planSteps, strings.ConcatStr(line, ""))

@borrows
fn BrowserCusePlanSubmit(session: var sess.BrowserSession, reply: str): int32 =
    # 确定性协议解析: 逐行扫描, 只收协议行(动词判定), 其余(围栏/寒暄/思考)
    # 一律丢弃; 0 条 = hard-fail, 不降级
    session.planSteps = []
    var pos: int32 = 0
    while pos < reply.len:
        var line: str = ""
        var next: int32 = pos
        while next < reply.len && reply[next] != '\n':
            next = next + 1
        line = strings.SliceBytes(reply, pos, next - pos)
        if next < reply.len && reply[next] == '\n':
            next = next + 1
        pos = next
        # 去首尾空白: 逐字符找首尾非空白
        var b: int32 = 0
        var e: int32 = line.len
        while b < e && (line[b] == ' ' || line[b] == '\t' || line[b] == '\r'):
            b = b + 1
        while e > b && (line[e - 1] == ' ' || line[e - 1] == '\t' || line[e - 1] == '\r'):
            e = e - 1
        if e <= b:
            continue
        let trimmed = strings.SliceBytes(line, b, e - b)
        # 跳过 markdown 围栏与编号前缀("1. click X" → 取 "click X" 起)
        var probe = strings.ConcatStr(trimmed, "")
        if probe.len >= 2 && probe[0] == '`':
            continue
        var k: int32 = 0
        while k < trimmed.len && trimmed[k] >= '0' && trimmed[k] <= '9':
            k = k + 1
        if k > 0 && k + 1 < trimmed.len && (trimmed[k] == '.' || trimmed[k] == ')') && trimmed[k + 1] == ' ':
            probe = strings.SliceBytes(trimmed, k + 2, trimmed.len - k - 2)
        if BrowserCuseLineLooksLikeCommand(probe):
            if !BrowserCuseVerbAllowed(session, probe):
                continue
            BrowserCusePlanAddStep(session, probe)
    if session.planSteps.len <= 0:
        session.lastError = "plan_e_no_steps"
        return -11
    return 0

@borrows
fn BrowserCusePlanStepCount(session: sess.BrowserSession): int32 =
    return session.planSteps.len

@borrows
fn BrowserCusePlanStepAt(session: sess.BrowserSession, index: int32): str =
    if index < 0 || index >= session.planSteps.len:
        return ""
    return strings.ConcatStr(session.planSteps[index], "")
