import std/strings
import std/strutils as strutil
import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_paint_runtime as paint
import cheng/apps/libp2p_browser/html_parse as htmlparse
import cheng/apps/libp2p_browser/compile_render as compile

type
    BrowserSnapBox =
        kind: int32
        x: int32
        y: int32
        w: int32
        h: int32
        fill: int32
        textColor: int32
        fontSize: int32
        borderW: int32
        borderC: int32
        radius: int32
        fontWeight: int32
        shadowX: int32
        shadowY: int32
        shadowBlur: int32
        shadowSpread: int32
        shadowColor: int32
        clipX: int32
        clipY: int32
        clipW: int32
        clipH: int32
        tag: str
        href: str
        inputType: str
        fieldId: str
        value: str
        text: str
        fontFamily: str
        image: str
        options: str

@borrows
fn SnapMagicVersion(text: str): int32 =
    if text.len < 5:
        return 0
    if text[0] != 'C' || text[1] != 'L' || text[2] != 'B':
        return 0
    if text[4] != '\n' && text[4] != '\r':
        return 0
    if text[3] == '2':
        return 2
    if text[3] == '3':
        return 3
    if text[3] == '4':
        return 4
    return 0

@borrows
fn SnapStartsMagic(text: str): bool =
    return SnapMagicVersion(text) > 0

@borrows
fn SnapParseI32(text: str, pos: int32, value: var int32, next: var int32): bool =
    var i = pos
    while i < text.len && (text[i] == ' ' || text[i] == '\t'):
        i = i + 1
    if i >= text.len:
        return false
    var neg = false
    if text[i] == '-':
        neg = true
        i = i + 1
    if i >= text.len || text[i] < '0' || text[i] > '9':
        return false
    var n: int32 = 0
    while i < text.len && text[i] >= '0' && text[i] <= '9':
        n = n * 10 + (int32(text[i]) - int32('0'))
        i = i + 1
    if neg:
        n = 0 - n
    value = n
    next = i
    return true

@borrows
fn SnapSkipLineEnd(text: str, pos: int32, next: var int32): bool =
    var i = pos
    while i < text.len && (text[i] == ' ' || text[i] == '\t' || text[i] == '\r'):
        i = i + 1
    if i < text.len && text[i] == '\n':
        next = i + 1
        return true
    if i >= text.len:
        next = i
        return true
    return false

@borrows
fn SnapReadLine(text: str, pos: int32, line: var str, next: var int32): bool =
    if pos < 0 || pos > text.len:
        return false
    var i = pos
    while i < text.len && text[i] != '\n' && text[i] != '\r':
        i = i + 1
    line = htmlparse.HtmlSlice(text, pos, i)
    if i < text.len && text[i] == '\r':
        i = i + 1
    if i < text.len && text[i] == '\n':
        i = i + 1
    next = i
    return true

@borrows
fn SnapPercentDecode(text: str): str =
    if text.len <= 0:
        return ""
    var hasPct = false
    var pi: int32 = 0
    while pi < text.len:
        if text[pi] == '%':
            hasPct = true
        pi = pi + 1
    if !hasPct:
        return strings.ConcatStr(text, "")
    var parts: str[]
    var i: int32 = 0
    while i < text.len:
        if text[i] == '%' && i + 2 < text.len:
            let hi = htmlparse.HtmlHexValue(text[i + 1])
            let lo = htmlparse.HtmlHexValue(text[i + 2])
            if hi >= 0 && lo >= 0:
                add(parts, strings.CharToStr(char(hi * 16 + lo)))
                i = i + 3
                continue
        add(parts, strings.CharToStr(text[i]))
        i = i + 1
    return strutil.Join(parts, "")

@borrows
fn SnapReadEncoded(text: str, pos: int32, out: var str, next: var int32): bool =
    var line: str
    if !SnapReadLine(text, pos, line, next):
        return false
    out = SnapPercentDecode(line)
    return true

fn SnapColorVisible(color: int32): bool =
    let a = compile.BrowserArgbChannel(color, 24)
    return a > 0

@borrows
fn SnapParseBoxes(text: str, viewportW: var int32, viewportH: var int32, captureMs: var int32, boxes: var BrowserSnapBox[]): bool =
    # setLen(0) instead of []: a caller-owned scratch keeps its buffer capacity
    # across parses (warm swaps append into the retired buffer, zero realloc).
    setLen(boxes, 0)
    viewportW = 0
    viewportH = 0
    captureMs = 0
    let version = SnapMagicVersion(text)
    if version <= 0:
        return false
    var pos: int32 = 5
    if text.len >= 6 && text[4] == '\r' && text[5] == '\n':
        pos = 6
    if !SnapParseI32(text, pos, viewportW, pos):
        return false
    if !SnapParseI32(text, pos, viewportH, pos):
        return false
    var count: int32 = 0
    if !SnapParseI32(text, pos, count, pos):
        return false
    if !SnapParseI32(text, pos, captureMs, pos):
        return false
    if !SnapSkipLineEnd(text, pos, pos):
        return false
    if viewportW <= 0 || viewportH <= 0:
        return false
    if count < 0 || count > 100000:
        return false
    var i: int32 = 0
    while i < count:
        var box: BrowserSnapBox
        box.kind = 0
        box.x = 0
        box.y = 0
        box.w = 0
        box.h = 0
        box.fill = 0
        box.textColor = 0
        box.fontSize = 0
        box.borderW = 0
        box.borderC = 0
        box.radius = 0
        box.fontWeight = 400
        box.shadowX = 0
        box.shadowY = 0
        box.shadowBlur = 0
        box.shadowSpread = 0
        box.shadowColor = 0
        box.clipX = 0
        box.clipY = 0
        box.clipW = 0
        box.clipH = 0
        box.tag = ""
        box.href = ""
        box.inputType = ""
        box.fieldId = ""
        box.value = ""
        box.text = ""
        box.fontFamily = ""
        box.image = ""
        box.options = ""
        if !SnapParseI32(text, pos, box.kind, pos):
            return false
        if !SnapParseI32(text, pos, box.x, pos):
            return false
        if !SnapParseI32(text, pos, box.y, pos):
            return false
        if !SnapParseI32(text, pos, box.w, pos):
            return false
        if !SnapParseI32(text, pos, box.h, pos):
            return false
        if !SnapParseI32(text, pos, box.fill, pos):
            return false
        if !SnapParseI32(text, pos, box.textColor, pos):
            return false
        if !SnapParseI32(text, pos, box.fontSize, pos):
            return false
        if !SnapParseI32(text, pos, box.borderW, pos):
            return false
        if !SnapParseI32(text, pos, box.borderC, pos):
            return false
        if !SnapParseI32(text, pos, box.radius, pos):
            return false
        if version >= 3:
            if !SnapParseI32(text, pos, box.fontWeight, pos):
                return false
            if !SnapParseI32(text, pos, box.shadowX, pos):
                return false
            if !SnapParseI32(text, pos, box.shadowY, pos):
                return false
            if !SnapParseI32(text, pos, box.shadowBlur, pos):
                return false
            if !SnapParseI32(text, pos, box.shadowSpread, pos):
                return false
            if !SnapParseI32(text, pos, box.shadowColor, pos):
                return false
            if !SnapParseI32(text, pos, box.clipX, pos):
                return false
            if !SnapParseI32(text, pos, box.clipY, pos):
                return false
            if !SnapParseI32(text, pos, box.clipW, pos):
                return false
            if !SnapParseI32(text, pos, box.clipH, pos):
                return false
        if !SnapSkipLineEnd(text, pos, pos):
            return false
        if !SnapReadEncoded(text, pos, box.tag, pos):
            return false
        if !SnapReadEncoded(text, pos, box.href, pos):
            return false
        if !SnapReadEncoded(text, pos, box.inputType, pos):
            return false
        if !SnapReadEncoded(text, pos, box.fieldId, pos):
            return false
        if !SnapReadEncoded(text, pos, box.value, pos):
            return false
        if !SnapReadEncoded(text, pos, box.text, pos):
            return false
        if version >= 3:
            if !SnapReadEncoded(text, pos, box.fontFamily, pos):
                return false
            if !SnapReadEncoded(text, pos, box.image, pos):
                return false
            if !SnapReadEncoded(text, pos, box.options, pos):
                return false
        if box.fontSize <= 0:
            box.fontSize = 14
        if box.fontWeight <= 0:
            box.fontWeight = 400
        add(boxes, box)
        i = i + 1
    return true

# CLB4 控件语义侧表: CTL|boxOrd|captureId|flags|role|name 行附在盒区之后。
# 语义不进 BrowserSnapBox——增量窗口重解析只重建窗口内盒行, 盒内字段会丢;
# 侧表每次全量重析, boxOrd 对齐盒下标, ctlOfBox[k] = 行下标或 -1。
type
    SnapControlRow =
        boxOrd: int32
        ctlId: int32
        flags: int32
        role: str
        name: str

fn SnapCtlLinesPerBox(version: int32): int32 =
    if version >= 3:
        return 10
    return 7

@borrows
fn SnapParseControlTable(text: str, rows: var SnapControlRow[], ctlOfBox: var int32[]): bool =
    setLen(rows, 0)
    setLen(ctlOfBox, 0)
    let version = SnapMagicVersion(text)
    if version <= 0:
        return false
    var vw: int32 = 0
    var vh: int32 = 0
    var count: int32 = 0
    var captureMs: int32 = 0
    var pos: int32 = 5
    if text.len >= 6 && text[4] == '\r' && text[5] == '\n':
        pos = 6
    if !SnapParseI32(text, pos, vw, pos):
        return false
    if !SnapParseI32(text, pos, vh, pos):
        return false
    if !SnapParseI32(text, pos, count, pos):
        return false
    if !SnapParseI32(text, pos, captureMs, pos):
        return false
    if !SnapSkipLineEnd(text, pos, pos):
        return false
    if vw <= 0 || vh <= 0 || count < 0 || count > 100000:
        return false
    # 内联行推进(等价 SnapBoxLineAdvance): 本函数声明序在其实体定义之前,
    # 本仓模块内前向引用不可靠。
    var adv: int32 = SnapCtlLinesPerBox(version) * count
    while adv > 0 && pos < text.len:
        while pos < text.len && text[pos] != '\n' && text[pos] != '\r':
            pos = pos + 1
        if pos < text.len && text[pos] == '\r':
            pos = pos + 1
        if pos < text.len && text[pos] == '\n':
            pos = pos + 1
        adv = adv - 1
    if adv > 0:
        return false
    var bi: int32 = 0
    while bi < count:
        add(ctlOfBox, -1)
        bi = bi + 1
    var line: str = ""
    while pos < text.len:
        if !SnapReadLine(text, pos, line, pos):
            return false
        if line.len < 5:
            continue
        if line[0] != 'C' || line[1] != 'T' || line[2] != 'L' || line[3] != '|':
            continue
        var p: int32 = 4
        var boxOrd: int32 = 0
        if !SnapParseI32(line, p, boxOrd, p):
            return false
        if p >= line.len || line[p] != '|':
            return false
        p = p + 1
        var ctlId: int32 = 0
        if !SnapParseI32(line, p, ctlId, p):
            return false
        if p >= line.len || line[p] != '|':
            return false
        p = p + 1
        var flags: int32 = 0
        if !SnapParseI32(line, p, flags, p):
            return false
        if p >= line.len || line[p] != '|':
            return false
        p = p + 1
        var sep: int32 = p
        while sep < line.len && line[sep] != '|':
            sep = sep + 1
        var role: str = SnapPercentDecode(htmlparse.HtmlSlice(line, p, sep))
        var name: str = ""
        if sep < line.len:
            name = SnapPercentDecode(htmlparse.HtmlSlice(line, sep + 1, line.len))
        if boxOrd < 0 || boxOrd >= count:
            return false
        if ctlId <= 0:
            return false
        var row: SnapControlRow
        row.boxOrd = boxOrd
        row.ctlId = ctlId
        row.flags = flags
        row.role = strings.ConcatStr(role, "")
        row.name = strings.ConcatStr(name, "")
        add(rows, row)
        ctlOfBox[boxOrd] = rows.len - 1
    return true

fn SnapInitBundle(bundle: var compile.BrowserCompileBundle) =
    bundle.stats.parseMs = 0
    bundle.stats.styleMs = 0
    bundle.stats.layoutMs = 0
    bundle.stats.paintMs = 0
    bundle.stats.nodeCount = 0
    bundle.stats.inputCount = 0
    bundle.stats.eventCount = 0
    bundle.stats.widgetCount = 0
    bundle.stats.opCount = 0
    bundle.stats.boxCount = 0
    bundle.stats.styleCount = 0
    bundle.stats.viewportW = 0
    bundle.stats.viewportH = 0
    bundle.stats.cssParseOk = true
    bundle.err = ""
    bundle.ops = []
    bundle.widgets = []

fn SnapApplyClip(op: var paint.PaintOp, clipX: int32, clipY: int32, clipW: int32, clipH: int32) =
    if clipW <= 0 || clipH <= 0:
        return
    op.clipRect.x = clipX
    op.clipRect.y = clipY
    op.clipRect.width = clipW
    op.clipRect.height = clipH

@borrows
fn SnapAppendFill(ops: var paint.PaintOp[], x: int32, y: int32, w: int32, h: int32, color: int32, radius: int32, clipX: int32, clipY: int32, clipW: int32, clipH: int32, shadowX: int32, shadowY: int32, shadowBlur: int32, shadowSpread: int32, shadowColor: int32) =
    if w <= 0 || h <= 0:
        return
    if SnapColorVisible(shadowColor) && (shadowBlur > 0 || shadowX != 0 || shadowY != 0):
        var sh = paint.PaintOpMakeBoxShadow(x, y, w, h, shadowX, shadowY, shadowBlur, shadowSpread, shadowColor, false)
        sh.borderRadius = radius
        SnapApplyClip(sh, clipX, clipY, clipW, clipH)
        add(ops, sh)
    if !SnapColorVisible(color):
        return
    var op = paint.PaintOpMakeFillRect(x, y, w, h, color)
    op.borderRadius = radius
    SnapApplyClip(op, clipX, clipY, clipW, clipH)
    add(ops, op)

@borrows
fn SnapAppendBorder(ops: var paint.PaintOp[], x: int32, y: int32, w: int32, h: int32, color: int32, borderW: int32, radius: int32, clipX: int32, clipY: int32, clipW: int32, clipH: int32) =
    if w <= 0 || h <= 0 || borderW <= 0:
        return
    if !SnapColorVisible(color):
        return
    var op = paint.PaintOpMakeStrokeRect(x, y, w, h, color, borderW, radius)
    SnapApplyClip(op, clipX, clipY, clipW, clipH)
    add(ops, op)

@borrows
fn SnapAppendText(ops: var paint.PaintOp[], x: int32, y: int32, w: int32, h: int32, fontSize: int32, fontWeight: int32, fontFamily: str, color: int32, text: str, clipX: int32, clipY: int32, clipW: int32, clipH: int32, textAlign: int32, alignWidth: int32) =
    if text.len <= 0:
        return
    if !SnapColorVisible(color):
        return
    var fs = fontSize
    if fs <= 0:
        fs = 14
    var cw = fs / 2
    if cw <= 0:
        cw = 8
    var lh = h
    if lh <= 0:
        lh = fs
    var op = paint.PaintOpMakeFillText(x, y, strings.ConcatStr(text, ""), cw, lh, fs, color)
    if w > 0:
        op.rect.width = w
    if h > 0:
        op.rect.height = h
    op.text.fontWeight = fontWeight
    op.shadowText = strings.ConcatStr(fontFamily, "")
    op.text.textAlign = textAlign
    op.text.alignWidth = alignWidth
    op.text.alignX = x
    SnapApplyClip(op, clipX, clipY, clipW, clipH)
    add(ops, op)

@borrows
fn SnapAppendImage(ops: var paint.PaintOp[], x: int32, y: int32, w: int32, h: int32, image: str, clipX: int32, clipY: int32, clipW: int32, clipH: int32) =
    if image.len <= 0 || w <= 0 || h <= 0:
        return
    var op = paint.PaintOpMakeDrawImage(x, y, w, h, 0, w, h)
    op.text.text = strings.ConcatStr(image, "")
    SnapApplyClip(op, clipX, clipY, clipW, clipH)
    add(ops, op)

fn SnapBindWidgetDocument(document: var web.WebDocument, widgets: var compile.BrowserWidget[]): bool =
    web.WebDocumentInit(document)
    let docId = web.WebDocumentCreateDocumentNode(document)
    let htmlId = web.WebDocumentCreateElement(document, "html")
    let bodyId = web.WebDocumentCreateElement(document, "body")
    if !web.WebDocumentAppendChild(document, docId, htmlId):
        return false
    if !web.WebDocumentAppendChild(document, htmlId, bodyId):
        return false
    var i: int32 = 0
    while i < widgets.len:
        let kind = widgets[i].kind
        var tag = "div"
        if kind == compile.BrowserWidgetInput:
            tag = "input"
        elif kind == compile.BrowserWidgetTextarea:
            tag = "textarea"
        elif kind == compile.BrowserWidgetAnchor:
            tag = "a"
        elif kind == compile.BrowserWidgetButton:
            tag = "button"
        elif kind == compile.BrowserWidgetSelect:
            tag = "select"
        let nodeId = web.WebDocumentCreateElement(document, tag)
        if widgets[i].fieldId.len > 0:
            if !web.WebDocumentSetAttribute(document, nodeId, "id", strings.ConcatStr(widgets[i].fieldId, "")):
                return false
        if widgets[i].href.len > 0:
            if !web.WebDocumentSetAttribute(document, nodeId, "href", strings.ConcatStr(widgets[i].href, "")):
                return false
        if widgets[i].inputType.len > 0:
            if !web.WebDocumentSetAttribute(document, nodeId, "type", strings.ConcatStr(widgets[i].inputType, "")):
                return false
        if !web.WebDocumentAppendChild(document, bodyId, nodeId):
            return false
        if kind == compile.BrowserWidgetInput:
            web.WebDocumentSetFormControl(document, nodeId, htmlparse.HtmlFormKindInput, strings.ConcatStr(widgets[i].inputType, ""))
            web.WebDocumentSetFormValue(document, nodeId, strings.ConcatStr(widgets[i].value, ""))
            web.WebDocumentAddEventListener(document, nodeId, "input", htmlparse.HtmlHandlerInput, false, false)
            web.WebDocumentAddEventListener(document, nodeId, "change", htmlparse.HtmlHandlerChange, false, false)
        elif kind == compile.BrowserWidgetTextarea:
            web.WebDocumentSetFormControl(document, nodeId, htmlparse.HtmlFormKindTextarea, "textarea")
            web.WebDocumentSetFormValue(document, nodeId, strings.ConcatStr(widgets[i].value, ""))
            web.WebDocumentAddEventListener(document, nodeId, "input", htmlparse.HtmlHandlerInput, false, false)
            web.WebDocumentAddEventListener(document, nodeId, "change", htmlparse.HtmlHandlerChange, false, false)
        elif kind == compile.BrowserWidgetButton:
            var buttonType = strings.ConcatStr(widgets[i].inputType, "")
            if buttonType.len <= 0:
                buttonType = "submit"
            web.WebDocumentSetFormControl(document, nodeId, htmlparse.HtmlFormKindButton, buttonType)
            web.WebDocumentAddEventListener(document, nodeId, "click", htmlparse.HtmlHandlerClick, false, false)
        elif kind == compile.BrowserWidgetAnchor:
            web.WebDocumentAddEventListener(document, nodeId, "click", htmlparse.HtmlHandlerClick, false, false)
        elif kind == compile.BrowserWidgetSelect:
            web.WebDocumentSetFormControl(document, nodeId, htmlparse.HtmlFormKindSelect, "select")
            web.WebDocumentSetFormValue(document, nodeId, strings.ConcatStr(widgets[i].value, ""))
            web.WebDocumentAddEventListener(document, nodeId, "change", htmlparse.HtmlHandlerChange, false, false)
            web.WebDocumentAddEventListener(document, nodeId, "click", htmlparse.HtmlHandlerClick, false, false)
        var nw: compile.BrowserWidget
        nw.kind = kind
        nw.nodeId = nodeId
        nw.fieldId = strings.ConcatStr(widgets[i].fieldId, "")
        nw.href = strings.ConcatStr(widgets[i].href, "")
        nw.inputType = strings.ConcatStr(widgets[i].inputType, "")
        nw.value = strings.ConcatStr(widgets[i].value, "")
        nw.options = strings.ConcatStr(widgets[i].options, "")
        nw.ctlId = widgets[i].ctlId
        nw.ctlFlags = widgets[i].ctlFlags
        nw.ctlRole = strings.ConcatStr(widgets[i].ctlRole, "")
        nw.ctlName = strings.ConcatStr(widgets[i].ctlName, "")
        nw.x = widgets[i].x
        nw.y = widgets[i].y
        nw.w = widgets[i].w
        nw.h = widgets[i].h
        if nw.fieldId.len <= 0:
            nw.fieldId = strings.ConcatStr("n", strings.IntToStr(nodeId))
        widgets[i] = nw
        i = i + 1
    return true

@borrows
# Build paint ops + widgets for boxes[from..<to], appending to ops/widgets.
# boxOpStart/boxWidgetStart receive prefix arrays of length (to-from)+1 where
# entry[k] is the op/widget index (relative to the arrays' length at entry)
# where box from+k starts contributing. Shared by the full snapshot compile
# and the incremental window rebuild.
@borrows
fn SnapAppendBoxRangeOps(boxes: BrowserSnapBox[],
                         from: int32,
                         to: int32,
                         ctlRows: SnapControlRow[],
                         ctlOfBox: int32[],
                         ops: var paint.PaintOp[],
                         widgets: var compile.BrowserWidget[],
                         boxOpStart: var int32[],
                         boxWidgetStart: var int32[]): bool =
    setLen(boxOpStart, 0)
    setLen(boxWidgetStart, 0)
    var i: int32 = from
    while i < to:
        add(boxOpStart, ops.len)
        add(boxWidgetStart, widgets.len)
        let kind = boxes[i].kind
        let x = boxes[i].x
        let y = boxes[i].y
        let w = boxes[i].w
        let h = boxes[i].h
        let fill = boxes[i].fill
        let textColor = boxes[i].textColor
        let fontSize = boxes[i].fontSize
        let borderW = boxes[i].borderW
        let borderC = boxes[i].borderC
        let radius = boxes[i].radius
        let clipX = boxes[i].clipX
        let clipY = boxes[i].clipY
        let clipW = boxes[i].clipW
        let clipH = boxes[i].clipH
        SnapAppendFill(ops, x, y, w, h, fill, radius, clipX, clipY, clipW, clipH, boxes[i].shadowX, boxes[i].shadowY, boxes[i].shadowBlur, boxes[i].shadowSpread, boxes[i].shadowColor)
        SnapAppendBorder(ops, x, y, w, h, borderC, borderW, radius, clipX, clipY, clipW, clipH)
        SnapAppendImage(ops, x, y, w, h, boxes[i].image, clipX, clipY, clipW, clipH)
        var face = strings.ConcatStr(boxes[i].text, "")
        if kind == compile.BrowserWidgetSelect && face.len <= 0:
            face = SnapChosenLabel(boxes[i].options, boxes[i].value)
        # WebKit 表单语义: input 的 submit/button/reset 值文本在盒内水平居中;
        # 其余(文本框/select)左对齐。
        var textAlign: int32 = 0
        var alignWidth: int32 = 0
        if kind == compile.BrowserWidgetInput:
            var it = boxes[i].inputType
            if it == "submit" || it == "button" || it == "reset":
                textAlign = 1
                alignWidth = w
        SnapAppendText(ops, x, y, w, h, fontSize, boxes[i].fontWeight, boxes[i].fontFamily, textColor, face, clipX, clipY, clipW, clipH, textAlign, alignWidth)
        var widgetKind: int32 = 0
        if kind == compile.BrowserWidgetInput:
            widgetKind = compile.BrowserWidgetInput
        elif kind == compile.BrowserWidgetTextarea:
            widgetKind = compile.BrowserWidgetTextarea
        elif kind == compile.BrowserWidgetAnchor:
            widgetKind = compile.BrowserWidgetAnchor
        elif kind == compile.BrowserWidgetButton:
            widgetKind = compile.BrowserWidgetButton
        elif kind == compile.BrowserWidgetSelect:
            widgetKind = compile.BrowserWidgetSelect
        if boxes[i].options.len > 0:
            widgetKind = compile.BrowserWidgetSelect
        if widgetKind != 0 && w > 0 && h > 0:
            var widget: compile.BrowserWidget
            widget.kind = widgetKind
            widget.nodeId = 0
            widget.fieldId = strings.ConcatStr(boxes[i].fieldId, "")
            widget.href = strings.ConcatStr(boxes[i].href, "")
            widget.inputType = strings.ConcatStr(boxes[i].inputType, "")
            widget.value = strings.ConcatStr(boxes[i].value, "")
            widget.options = strings.ConcatStr(boxes[i].options, "")
            widget.x = x
            widget.y = y
            widget.w = w
            widget.h = h
            widget.ctlId = 0
            widget.ctlFlags = 0
            widget.ctlRole = ""
            widget.ctlName = ""
            if i < ctlOfBox.len:
                let crow = ctlOfBox[i]
                if crow >= 0 && crow < ctlRows.len:
                    widget.ctlId = ctlRows[crow].ctlId
                    widget.ctlFlags = ctlRows[crow].flags
                    widget.ctlRole = strings.ConcatStr(ctlRows[crow].role, "")
                    widget.ctlName = strings.ConcatStr(ctlRows[crow].name, "")
            add(widgets, widget)
        i = i + 1
    add(boxOpStart, ops.len)
    add(boxWidgetStart, widgets.len)
    return true

@borrows
fn BrowserCompileSnapshot(snapshot: str,
                          document: var web.WebDocument,
                          bundle: var compile.BrowserCompileBundle): bool =
    SnapInitBundle(bundle)
    let t0 = compile.BrowserMonoNs()
    var vw: int32 = 0
    var vh: int32 = 0
    var captureMs: int32 = 0
    var boxes: BrowserSnapBox[]
    if !SnapParseBoxes(snapshot, vw, vh, captureMs, boxes):
        bundle.err = "snapshot: bad CLB"
        bundle.stats.parseMs = compile.BrowserMsSince(t0)
        web.WebDocumentInit(document)
        return false
    var ctlRows: SnapControlRow[]
    var ctlOfBox: int32[]
    if !SnapParseControlTable(snapshot, ctlRows, ctlOfBox):
        bundle.err = "snapshot: bad CTL"
        bundle.stats.parseMs = compile.BrowserMsSince(t0)
        web.WebDocumentInit(document)
        return false
    bundle.stats.parseMs = compile.BrowserMsSince(t0)
    bundle.stats.layoutMs = int64(captureMs)
    bundle.stats.nodeCount = boxes.len
    bundle.stats.boxCount = boxes.len
    bundle.stats.viewportW = vw
    bundle.stats.viewportH = vh
    let t1 = compile.BrowserMonoNs()
    var ops: paint.PaintOp[]
    var widgets: compile.BrowserWidget[]
    var fullOpStart: int32[]
    var fullWidgetStart: int32[]
    if !SnapAppendBoxRangeOps(boxes, 0, boxes.len, ctlRows, ctlOfBox, ops, widgets, fullOpStart, fullWidgetStart):
        bundle.err = "snapshot: op build"
        bundle.stats.paintMs = compile.BrowserMsSince(t1)
        web.WebDocumentInit(document)
        return false
    if !SnapBindWidgetDocument(document, widgets):
        bundle.err = "snapshot: widget document"
        bundle.stats.paintMs = compile.BrowserMsSince(t1)
        return false
    bundle.ops = ops
    bundle.widgets = widgets
    bundle.stats.paintMs = compile.BrowserMsSince(t1)
    bundle.stats.opCount = ops.len
    bundle.stats.widgetCount = widgets.len
    bundle.stats.styleCount = 0
    bundle.stats.eventCount = document.listeners.len
    var inputCount: int32 = 0
    var wi: int32 = 0
    while wi < widgets.len:
        if widgets[wi].kind == compile.BrowserWidgetInput || widgets[wi].kind == compile.BrowserWidgetTextarea:
            inputCount = inputCount + 1
        wi = wi + 1
    bundle.stats.inputCount = inputCount
    return true

@borrows
fn SnapFindOverride(fields: str[], vals: str[], fieldId: str): str =
    var i: int32 = 0
    while i < fields.len && i < vals.len:
        if fields[i] == fieldId:
            return strings.ConcatStr(vals[i], "")
        i = i + 1
    return ""

@borrows
fn SnapParseOptionLine(payload: str, pos: int32, next: var int32, selected: var int32, value: var str, label: var str): bool =
    if pos >= payload.len:
        return false
    var i = pos
    while i < payload.len && payload[i] != '\n':
        i = i + 1
    let line = htmlparse.HtmlSlice(payload, pos, i)
    if i < payload.len && payload[i] == '\n':
        next = i + 1
    else:
        next = i
    if line.len <= 0:
        selected = 0
        value = ""
        label = ""
        return true
    var t1: int32 = 0
    while t1 < line.len && line[t1] != '\t':
        t1 = t1 + 1
    var t2 = t1 + 1
    while t2 < line.len && line[t2] != '\t':
        t2 = t2 + 1
    selected = 0
    if t1 > 0 && line[0] == '1':
        selected = 1
    if t1 + 1 <= t2:
        value = htmlparse.HtmlSlice(line, t1 + 1, t2)
    else:
        value = ""
    if t2 + 1 <= line.len:
        label = htmlparse.HtmlSlice(line, t2 + 1, line.len)
    else:
        label = strings.ConcatStr(value, "")
    return true

@borrows
fn SnapChosenLabel(options: str, chosen: str): str =
    var pos: int32 = 0
    var fallback: str = ""
    while pos < options.len:
        var next: int32 = 0
        var selected: int32 = 0
        var value: str = ""
        var label: str = ""
        if !SnapParseOptionLine(options, pos, next, selected, value, label):
            break
        pos = next
        if label.len <= 0:
            label = strings.ConcatStr(value, "")
        if fallback.len <= 0 && label.len > 0:
            fallback = strings.ConcatStr(label, "")
        if chosen.len > 0 && (chosen == value || chosen == label):
            return strings.ConcatStr(label, "")
        if chosen.len <= 0 && selected == 1 && label.len > 0:
            return strings.ConcatStr(label, "")
    if chosen.len > 0:
        return strings.ConcatStr(chosen, "")
    return fallback

@borrows
fn BrowserSnapshotAppendSelectMenu(ops: var paint.PaintOp[], menuWidgets: var compile.BrowserWidget[], fieldId: str, selectCtlId: int32, x: int32, y: int32, w: int32, h: int32, options: str, chosen: str, viewportH: int32) =
    if options.len <= 0 || w <= 0:
        return
    var rowH = h
    if rowH < 28:
        rowH = 28
    var count: int32 = 0
    var scan: int32 = 0
    while scan < options.len:
        var dummyNext: int32 = 0
        var sel: int32 = 0
        var val: str = ""
        var lab: str = ""
        if !SnapParseOptionLine(options, scan, dummyNext, sel, val, lab):
            break
        if lab.len > 0 || val.len > 0:
            count = count + 1
        scan = dummyNext
    if count <= 0:
        return
    let menuH = rowH * count + 8
    var menuY = y + h + 4
    if viewportH > 0 && menuY + menuH > viewportH:
        var up = y - 4 - menuH
        if up >= 0:
            menuY = up
    var menuW = w
    if menuW < 220:
        menuW = 220
    SnapAppendFill(ops, x, menuY, menuW, menuH, int32(0xFFFFFFFF), 8, 0, 0, 0, 0, 0, 8, 24, 0, int32(0x33000000))
    SnapAppendBorder(ops, x, menuY, menuW, menuH, int32(0xFFE5E7EB), 1, 8, 0, 0, 0, 0)
    var pos: int32 = 0
    var row: int32 = 0
    while pos < options.len:
        var next: int32 = 0
        var selected: int32 = 0
        var value: str = ""
        var label: str = ""
        if !SnapParseOptionLine(options, pos, next, selected, value, label):
            break
        pos = next
        if label.len <= 0 && value.len <= 0:
            continue
        let oy = menuY + 4 + row * rowH
        var on = false
        if chosen.len > 0 && (chosen == value || chosen == label):
            on = true
        elif chosen.len <= 0 && selected == 1:
            on = true
        if on:
            SnapAppendFill(ops, x + 4, oy, menuW - 8, rowH, int32(0xFF3B82F6), 6, 0, 0, 0, 0, 0, 0, 0, 0, 0)
        var fg = int32(0xFF111827)
        if on:
            fg = int32(0xFFFFFFFF)
        SnapAppendText(ops, x + 12, oy, menuW - 24, rowH, 14, 400, "", fg, label, 0, 0, 0, 0, 0, 0)
        var opt: compile.BrowserWidget
        opt.kind = compile.BrowserWidgetOption
        opt.nodeId = 0
        opt.fieldId = strings.ConcatStr(fieldId, "")
        opt.href = strings.ConcatStr(label, "")
        opt.inputType = "option"
        opt.value = strings.ConcatStr(value, "")
        opt.options = ""
        opt.ctlId = selectCtlId
        opt.ctlFlags = 0
        opt.ctlRole = ""
        opt.ctlName = ""
        opt.x = x
        opt.y = oy
        opt.w = menuW
        opt.h = rowH
        add(menuWidgets, opt)
        row = row + 1

@borrows
fn BrowserSnapshotApplySelectState(ops: var paint.PaintOp[], widgets: var compile.BrowserWidget[], menuWidgets: var compile.BrowserWidget[], openFieldId: str, ovFields: str[], ovVals: str[], viewportH: int32) =
    var i: int32 = 0
    while i < widgets.len:
        let fieldId = strings.ConcatStr(widgets[i].fieldId, "")
        let ov = SnapFindOverride(ovFields, ovVals, fieldId)
        if ov.len > 0:
            var nw: compile.BrowserWidget
            nw.kind = widgets[i].kind
            nw.nodeId = widgets[i].nodeId
            nw.fieldId = strings.ConcatStr(fieldId, "")
            nw.href = strings.ConcatStr(widgets[i].href, "")
            nw.inputType = strings.ConcatStr(widgets[i].inputType, "")
            nw.value = strings.ConcatStr(ov, "")
            nw.options = strings.ConcatStr(widgets[i].options, "")
            nw.ctlId = widgets[i].ctlId
            nw.ctlFlags = widgets[i].ctlFlags
            nw.ctlRole = strings.ConcatStr(widgets[i].ctlRole, "")
            nw.ctlName = strings.ConcatStr(widgets[i].ctlName, "")
            nw.x = widgets[i].x
            nw.y = widgets[i].y
            nw.w = widgets[i].w
            nw.h = widgets[i].h
            widgets[i] = nw
            let ix = widgets[i].x + 2
            let iy = widgets[i].y + 2
            var iw = widgets[i].w - 4
            var ih = widgets[i].h - 4
            if iw < 8:
                iw = widgets[i].w
            if ih < 8:
                ih = widgets[i].h
            SnapAppendFill(ops, ix, iy, iw, ih, int32(0xFFFFFFFF), 2, 0, 0, 0, 0, 0, 0, 0, 0, 0)
            let face = SnapChosenLabel(widgets[i].options, ov)
            SnapAppendText(ops, ix + 6, iy, iw - 12, ih, 14, 400, "", int32(0xFF111827), face, 0, 0, 0, 0, 0, 0)
        i = i + 1
    if openFieldId.len <= 0:
        return
    var si: int32 = 0
    while si < widgets.len:
        if widgets[si].kind == compile.BrowserWidgetSelect && widgets[si].fieldId == openFieldId:
            BrowserSnapshotAppendSelectMenu(ops, menuWidgets, openFieldId, widgets[si].ctlId, widgets[si].x, widgets[si].y, widgets[si].w, widgets[si].h, widgets[si].options, widgets[si].value, viewportH)
            return
        si = si + 1

# ================= 增量图补丁一级：无变化帧零成本跳过 =================
#
# CLB 文本头部的 capture-ms 每次抓取必变，字节级全等永远不成立；相等判定必须
# 只比盒区（header 之后）。盒区相等 ⇒ 本帧与上一帧逐盒一致，跳过整轮解析与
# op/widget 重建（热换最大占比场景：节流抓取下页面静止）。分段（窗口）补丁的
# 结构级方案挂账：仓内托管拷贝语义在 slot→slot 记录搬运上仍会双重释放，等
# 编译器所有权域收口后按 SnapHeaderParse/SnapCollectBoxStarts/SnapDiffBoxWindow
# 的设计（本提交前身已实证窗口判定正确）重接。

@borrows
fn SnapHeaderParse(text: str,
                   version: int32,
                   viewportW: var int32,
                   viewportH: var int32,
                   boxCount: var int32,
                   captureMs: var int32,
                   headerEnd: var int32): bool =
    viewportW = 0
    viewportH = 0
    boxCount = 0
    captureMs = 0
    headerEnd = 0
    if version <= 0:
        return false
    var pos: int32 = 5
    if text.len >= 6 && text[4] == '\r' && text[5] == '\n':
        pos = 6
    if !SnapParseI32(text, pos, viewportW, pos):
        return false
    if !SnapParseI32(text, pos, viewportH, pos):
        return false
    if !SnapParseI32(text, pos, boxCount, pos):
        return false
    if !SnapParseI32(text, pos, captureMs, pos):
        return false
    if !SnapSkipLineEnd(text, pos, pos):
        return false
    if viewportW <= 0 || viewportH <= 0:
        return false
    if boxCount < 0 || boxCount > 100000:
        return false
    headerEnd = pos
    return true

@borrows
fn SnapBoxRunEqualFlat(a: str, aStart: int32, aStop: int32, b: str, bStart: int32, bStop: int32): bool =
    let aLen = aStop - aStart
    let bLen = bStop - bStart
    if aLen != bLen:
        return false
    var k: int32 = 0
    while k < aLen:
        if a[aStart + k] != b[bStart + k]:
            return false
        k = k + 1
    return true

@borrows
fn SnapBoxRegionEqual(a: str, b: str): bool =
    if a.len <= 0 || b.len <= 0:
        return false
    let versionA = SnapMagicVersion(a)
    let versionB = SnapMagicVersion(b)
    if versionA <= 0 || versionA != versionB:
        return false
    var vwA: int32 = 0
    var vhA: int32 = 0
    var countA: int32 = 0
    var msA: int32 = 0
    var endA: int32 = 0
    var vwB: int32 = 0
    var vhB: int32 = 0
    var countB: int32 = 0
    var msB: int32 = 0
    var endB: int32 = 0
    if !SnapHeaderParse(a, versionA, vwA, vhA, countA, msA, endA):
        return false
    if !SnapHeaderParse(b, versionB, vwB, vhB, countB, msB, endB):
        return false
    if vwA != vwB || vhA != vhB || countA != countB:
        return false
    if countA <= 0:
        return false
    return SnapBoxRunEqualFlat(a, endA, a.len, b, endB, b.len)

fn SnapBoxLinesPerBox(version: int32): int32 =
    # one numeric line + N percent-encoded field lines per box
    if version >= 3:
        return 10
    return 7

@borrows
fn SnapBoxLineAdvance(text: str, pos: var int32, lineCount: int32): bool =
    var li: int32 = 0
    while li < lineCount:
        if pos >= text.len:
            return false
        while pos < text.len && text[pos] != '\n' && text[pos] != '\r':
            pos = pos + 1
        if pos < text.len && text[pos] == '\r':
            pos = pos + 1
        if pos < text.len && text[pos] == '\n':
            pos = pos + 1
        li = li + 1
    return true

@borrows
fn SnapCollectBoxStarts(text: str, version: int32, headerEnd: int32, boxCount: int32, starts: var int32[]): bool =
    setLen(starts, 0)
    let linesPerBox = SnapBoxLinesPerBox(version)
    var pos: int32 = headerEnd
    var i: int32 = 0
    while i < boxCount:
        add(starts, pos)
        if !SnapBoxLineAdvance(text, pos, linesPerBox):
            return false
        i = i + 1
    return true

@borrows
fn SnapDiffBoxWindow(prevText: str,
                     snapshot: str,
                     version: int32,
                     boxCountPrev: int32,
                     boxCountNew: int32,
                     startsPrev: int32[],
                     startsNew: int32[],
                     winFrom: var int32,
                     winToPrev: var int32,
                     winToNew: var int32): bool =
    # Forward + backward anchor scans over box runs. The new text's box k
    # aligns with the previous text's box k - delta until the changed window
    # ends, so an insertion shifts only the window, never the whole tail.
    # 条件全部拆为独立 if：规避编译器 `?:`/复合条件的历史 codegen 前科。
    winFrom = 0
    winToPrev = 0
    winToNew = 0
    var minCount: int32 = boxCountPrev
    if boxCountNew < minCount:
        minCount = boxCountNew
    var a: int32 = 0
    while a < minCount:
        var aStop: int32 = prevText.len
        if a + 1 < boxCountPrev:
            aStop = startsPrev[a + 1]
        var bStop: int32 = snapshot.len
        if a + 1 < boxCountNew:
            bStop = startsNew[a + 1]
        if !SnapBoxRunEqualFlat(prevText, startsPrev[a], aStop, snapshot, startsNew[a], bStop):
            break
        a = a + 1
    if a >= minCount:
        winFrom = a
        winToPrev = boxCountPrev
        winToNew = boxCountNew
        return true
    let delta = boxCountNew - boxCountPrev
    var bNew: int32 = boxCountNew - 1
    var bPrev: int32 = bNew - delta
    while bNew > a && bPrev > a:
        var aStop: int32 = prevText.len
        if bPrev + 1 < boxCountPrev:
            aStop = startsPrev[bPrev + 1]
        var bStop: int32 = snapshot.len
        if bNew + 1 < boxCountNew:
            bStop = startsNew[bNew + 1]
        if !SnapBoxRunEqualFlat(prevText, startsPrev[bPrev], aStop, snapshot, startsNew[bNew], bStop):
            break
        bNew = bNew - 1
        bPrev = bPrev - 1
    winFrom = a
    if bNew <= a || bPrev <= a:
        winToPrev = boxCountPrev
        winToNew = boxCountNew
    else:
        winToPrev = bPrev + 1
        winToNew = bNew + 1
    return true

var __snapBoxStartsPrev: int32[]
var __snapBoxStartsNew: int32[]
var __snapWindowBoxes: BrowserSnapBox[]
var __snapThrowOpStart: int32[]
var __snapThrowWidgetStart: int32[]

@borrows
fn SnapWindowParseBoxes(snapshot: str,
                        version: int32,
                        viewportW: int32,
                        viewportH: int32,
                        startsNew: int32[],
                        winFrom: int32,
                        winToNew: int32,
                        boxes: var BrowserSnapBox[]): bool =
    # Synthesize a standalone CLB text for the window so the unchanged
    # SnapParseBoxes parser stays the single source of truth for field layout.
    if winToNew <= winFrom:
        setLen(boxes, 0)
        return true
    let runStart = startsNew[winFrom]
    var runStop: int32 = snapshot.len
    if winToNew < startsNew.len:
        runStop = startsNew[winToNew]
    if runStop < runStart:
        return false
    var header: str = "CLB"
    if version >= 3:
        header = strings.ConcatStr(header, "3\n")
    else:
        header = strings.ConcatStr(header, "2\n")
    header = strings.ConcatStr(header, strings.IntToStr(viewportW))
    header = strings.ConcatStr(header, " ")
    header = strings.ConcatStr(header, strings.IntToStr(viewportH))
    header = strings.ConcatStr(header, " ")
    header = strings.ConcatStr(header, strings.IntToStr(winToNew - winFrom))
    header = strings.ConcatStr(header, " 0\n")
    let run = htmlparse.HtmlSlice(snapshot, runStart, runStop)
    let windowText = strings.ConcatStr(header, run)
    var wv: int32 = 0
    var wh: int32 = 0
    var wc: int32 = 0
    var wms: int32 = 0
    if !SnapParseBoxes(windowText, wv, wh, wms, boxes):
        return false
    return boxes.len == winToNew - winFrom

@borrows
fn SnapCloneAssignBoxAt(dst: var BrowserSnapBox, src: BrowserSnapBox) =
    # Field-wise deep clone: every managed string field receives its own fresh
    # copy, so no string header is ever shared between two slots.
    dst.kind = src.kind
    dst.x = src.x
    dst.y = src.y
    dst.w = src.w
    dst.h = src.h
    dst.fill = src.fill
    dst.textColor = src.textColor
    dst.fontSize = src.fontSize
    dst.borderW = src.borderW
    dst.borderC = src.borderC
    dst.radius = src.radius
    dst.fontWeight = src.fontWeight
    dst.shadowX = src.shadowX
    dst.shadowY = src.shadowY
    dst.shadowBlur = src.shadowBlur
    dst.shadowSpread = src.shadowSpread
    dst.shadowColor = src.shadowColor
    dst.clipX = src.clipX
    dst.clipY = src.clipY
    dst.clipW = src.clipW
    dst.clipH = src.clipH
    dst.tag = strings.ConcatStr(src.tag, "")
    dst.href = strings.ConcatStr(src.href, "")
    dst.inputType = strings.ConcatStr(src.inputType, "")
    dst.fieldId = strings.ConcatStr(src.fieldId, "")
    dst.value = strings.ConcatStr(src.value, "")
    dst.text = strings.ConcatStr(src.text, "")
    dst.fontFamily = strings.ConcatStr(src.fontFamily, "")
    dst.image = strings.ConcatStr(src.image, "")
    dst.options = strings.ConcatStr(src.options, "")

fn SnapZeroBoxAt(box: var BrowserSnapBox) =
    box.kind = 0
    box.x = 0
    box.y = 0
    box.w = 0
    box.h = 0
    box.fill = 0
    box.textColor = 0
    box.fontSize = 0
    box.borderW = 0
    box.borderC = 0
    box.radius = 0
    box.fontWeight = 400
    box.shadowX = 0
    box.shadowY = 0
    box.shadowBlur = 0
    box.shadowSpread = 0
    box.shadowColor = 0
    box.clipX = 0
    box.clipY = 0
    box.clipW = 0
    box.clipH = 0
    box.tag = ""
    box.href = ""
    box.inputType = ""
    box.fieldId = ""
    box.value = ""
    box.text = ""
    box.fontFamily = ""
    box.image = ""
    box.options = ""

fn BrowserSnapshotPatchSession(prevText: str,
                               snapshot: str,
                               boxes: var BrowserSnapBox[],
                               document: var web.WebDocument,
                               bundle: var compile.BrowserCompileBundle): bool =
    SnapInitBundle(bundle)
    if prevText.len <= 0 || snapshot.len <= 0:
        return false
    let versionPrev = SnapMagicVersion(prevText)
    let versionNew = SnapMagicVersion(snapshot)
    if versionPrev <= 0 || versionNew != versionPrev:
        return false
    var vwPrev: int32 = 0
    var vhPrev: int32 = 0
    var countPrev: int32 = 0
    var msPrev: int32 = 0
    var endPrev: int32 = 0
    var vwNew: int32 = 0
    var vhNew: int32 = 0
    var countNew: int32 = 0
    var msNew: int32 = 0
    var endNew: int32 = 0
    if !SnapHeaderParse(prevText, versionPrev, vwPrev, vhPrev, countPrev, msPrev, endPrev):
        return false
    if !SnapHeaderParse(snapshot, versionNew, vwNew, vhNew, countNew, msNew, endNew):
        return false
    if vwPrev != vwNew || vhPrev != vhNew:
        return false
    if countPrev <= 0 || countNew <= 0:
        return false
    # Resident box rows must describe exactly the previous text's box set.
    if boxes.len != countPrev:
        return false
    if !SnapCollectBoxStarts(prevText, versionPrev, endPrev, countPrev, __snapBoxStartsPrev):
        return false
    if !SnapCollectBoxStarts(snapshot, versionNew, endNew, countNew, __snapBoxStartsNew):
        return false
    var winFrom: int32 = 0
    var winToPrev: int32 = 0
    var winToNew: int32 = 0
    if !SnapDiffBoxWindow(prevText, snapshot, versionPrev, countPrev, countNew,
                          __snapBoxStartsPrev, __snapBoxStartsNew,
                          winFrom, winToPrev, winToNew):
        return false
    let t0 = compile.BrowserMonoNs()
    if winToNew > winFrom && (winToNew - winFrom) * 2 > countNew:
        # Pathological window (page-wide rewrite): a full recompile is cheaper
        # and simpler; caller falls back.
        return false
    # Re-parse only the changed window's box rows.
    if !SnapWindowParseBoxes(snapshot, versionPrev, vwNew, vhNew, __snapBoxStartsNew, winFrom, winToNew, __snapWindowBoxes):
        return false
    let windowCount = winToNew - winFrom
    let boxWinPrev = winToPrev - winFrom
    let deltaBox = windowCount - boxWinPrev
    let boxTailCount = countPrev - winToPrev
    # Shift the resident tail with clone assignments routed through a staging
    # row (the compiler rejects potentially-aliasing var formals in one call).
    if deltaBox > 0:
        setLen(boxes, boxes.len + deltaBox)
    var stage: BrowserSnapBox
    SnapZeroBoxAt(stage)
    var k: int32 = boxTailCount - 1
    while k >= 0:
        SnapCloneAssignBoxAt(stage, boxes[winFrom + boxWinPrev + k])
        SnapCloneAssignBoxAt(boxes[winFrom + windowCount + k], stage)
        k = k - 1
    if deltaBox < 0:
        setLen(boxes, boxes.len + deltaBox)
    k = 0
    while k < windowCount:
        SnapCloneAssignBoxAt(boxes[winFrom + k], __snapWindowBoxes[k])
        k = k + 1
    # Reproduce ops/widgets for the full box set into fresh local arrays and
    # hand them to the caller through the bundle (proven field-to-field flow;
    # session assigns its live arrays from the bundle afterwards).
    var ctlRowsNext: SnapControlRow[]
    var ctlOfBoxNext: int32[]
    if !SnapParseControlTable(snapshot, ctlRowsNext, ctlOfBoxNext):
        bundle.err = "snapshot: bad CTL"
        return false
    var opsNext: paint.PaintOp[]
    var widgetsNext: compile.BrowserWidget[]
    if !SnapAppendBoxRangeOps(boxes, 0, boxes.len, ctlRowsNext, ctlOfBoxNext, opsNext, widgetsNext, __snapThrowOpStart, __snapThrowWidgetStart):
        bundle.err = "snapshot: op build"
        return false
    bundle.ops = opsNext
    bundle.widgets = widgetsNext
    # Rebind the widget document (nodeIds are document-scoped).
    if !SnapBindWidgetDocument(document, widgetsNext):
        bundle.err = "snapshot: widget document"
        return false
    bundle.stats.parseMs = compile.BrowserMsSince(t0)
    bundle.stats.layoutMs = int64(msNew)
    bundle.stats.nodeCount = boxes.len
    bundle.stats.boxCount = boxes.len
    bundle.stats.viewportW = vwNew
    bundle.stats.viewportH = vhNew
    var inputCount: int32 = 0
    var wi: int32 = 0
    while wi < widgetsNext.len:
        if widgetsNext[wi].kind == compile.BrowserWidgetInput || widgetsNext[wi].kind == compile.BrowserWidgetTextarea:
            inputCount = inputCount + 1
        wi = wi + 1
    bundle.stats.eventCount = document.listeners.len
    bundle.stats.inputCount = inputCount
    bundle.stats.widgetCount = widgetsNext.len
    bundle.stats.opCount = opsNext.len
    bundle.stats.styleCount = 0
    return true
