# CLB 线语义动作会话: 按 captureId 寻址控件执行 typed 动作(Click/SetText/
# SetNumber/Select/Toggle), 动作经 WebSceneComputerUseAdmit 准入。effectClass
# 词表与确认要求自 05 起由 csg_action_authority 注册合同表裁决: 未注册的
# (动作, effectClass) 组合按 -3 拒绝。08 执行层接线后确认签发的唯一生产通路
# 是 BrowserCuseActionWithCredential 凭证入口 (提名凭证行句柄, 按 动作+参数
# +版本+世代 精确一次性消费); 旧 confirmed 布尔入口仅保留给注册表确认要求为
# none 的动作, 确认类动作走布尔面按 -7 显式拒绝并指向凭证入口。
# 返回码: 0=ok; 负值=hard-fail(调用方禁止降级为坐标合成)。
#   -1 cuse_e_no_control            captureId 不在控件表
#   -2 cuse_e_disabled              控件 disabled 位
#   -3 (admit err)                  非法动作类型 / effectClass 未注册 / 凭证门未满足
#   -4 cuse_e_action_kind_for_control  动作与控件类型不匹配
#   -5 cuse_e_no_option             Select 目标值不在 options
#   -6 cuse_e_not_number            SetNumber payload 非整数
#   -7 cuse_e_confirmation_credential_required  确认类动作走布尔面(须走凭证入口)

import std/strings
import cheng/core/runtime/web_runtime as web
import cheng/apps/libp2p_browser/html_parse as htmlparse
import cheng/apps/libp2p_browser/compile_render as compile
import cheng/apps/libp2p_browser/page_snapshot as snap
import cheng/apps/libp2p_browser/session as sess
import cheng/core/runtime/web_scene_computer_use as cu
import cheng/core/runtime/csg_action_authority as auth

@borrows
fn BrowserCuseFindWidget(session: sess.BrowserSession, ctlId: int32): int32 =
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].ctlId == ctlId:
            return i
        i = i + 1
    return -1

@borrows
fn BrowserCuseNumberPayload(payload: str): bool =
    if payload.len <= 0:
        return false
    var i: int32 = 0
    if payload[0] == '-':
        i = 1
    if i >= payload.len:
        return false
    while i < payload.len:
        if payload[i] < '0' || payload[i] > '9':
            return false
        i = i + 1
    return true

@borrows
fn BrowserCuseCloneWidget(session: var sess.BrowserSession, index: int32, value: str) =
    var nw: compile.BrowserWidget
    nw.kind = session.widgets[index].kind
    nw.nodeId = session.widgets[index].nodeId
    nw.fieldId = strings.ConcatStr(session.widgets[index].fieldId, "")
    nw.href = strings.ConcatStr(session.widgets[index].href, "")
    nw.inputType = strings.ConcatStr(session.widgets[index].inputType, "")
    nw.value = strings.ConcatStr(value, "")
    nw.options = strings.ConcatStr(session.widgets[index].options, "")
    nw.ctlId = session.widgets[index].ctlId
    nw.ctlFlags = session.widgets[index].ctlFlags
    nw.ctlRole = strings.ConcatStr(session.widgets[index].ctlRole, "")
    nw.ctlName = strings.ConcatStr(session.widgets[index].ctlName, "")
    nw.x = session.widgets[index].x
    nw.y = session.widgets[index].y
    nw.w = session.widgets[index].w
    nw.h = session.widgets[index].h
    session.widgets[index] = nw

fn BrowserCuseReject(session: var sess.BrowserSession, rc: int32, code: str, err: var str): int32 =
    err = strings.ConcatStr(code, "")
    session.lastError = strings.ConcatStr(code, "")
    return rc

# 准入通过后的真实执行 (授权签发唯一权威在 csg_action_authority 的准入门;
# 本函数只做控件匹配与 apply, 不再签发授权)。
@borrows
fn browserCuseApplyAction(session: var sess.BrowserSession, ctlId: int32, idx: int32, actionKind: str, payload: str, err: var str): int32 =
    let kind = session.widgets[idx].kind
    let inputType = strings.ConcatStr(session.widgets[idx].inputType, "")
    let fieldId = strings.ConcatStr(session.widgets[idx].fieldId, "")
    let nodeId = session.widgets[idx].nodeId
    if actionKind == "Click" || actionKind == "Toggle":
        var clickable = false
        var toggle = false
        if kind == compile.BrowserWidgetButton || kind == compile.BrowserWidgetAnchor:
            clickable = true
        if kind == compile.BrowserWidgetInput:
            if inputType == "submit" || inputType == "button":
                clickable = true
            elif inputType == "checkbox" || inputType == "radio":
                clickable = true
                if actionKind == "Toggle":
                    toggle = true
        if !clickable:
            return BrowserCuseReject(session, -4, "cuse_e_action_kind_for_control", err)
        if toggle:
            var checked = false
            web.WebDocumentGetChecked(session.document, nodeId, checked)
            web.WebDocumentSetChecked(session.document, nodeId, !checked)
            web.WebDocumentDispatchEvent(session.document, nodeId, "change")
        web.WebDocumentClick(session.document, nodeId)
        web.WebDocumentDispatchEvent(session.document, nodeId, "click")
        if kind == compile.BrowserWidgetAnchor:
            let href = strings.ConcatStr(session.widgets[idx].href, "")
            if href.len > 0 && href[0] != '#' && !htmlparse.HtmlStartsAtIgnoreCase(href, 0, "javascript:"):
                let nextUrl = compile.BrowserResolveUrl(session.url, href)
                sess.BrowserSessionNavigate(session, nextUrl, true)
        sess.BrowserSessionMarkApplyAction(session, ctlId, fieldId, "", actionKind)
        err = ""
        return 0
    if actionKind == "SetText" || actionKind == "SetNumber":
        if kind != compile.BrowserWidgetInput && kind != compile.BrowserWidgetTextarea:
            return BrowserCuseReject(session, -4, "cuse_e_action_kind_for_control", err)
        if inputType == "submit" || inputType == "button" || inputType == "checkbox" || inputType == "radio":
            return BrowserCuseReject(session, -4, "cuse_e_action_kind_for_control", err)
        if actionKind == "SetNumber":
            if !BrowserCuseNumberPayload(payload):
                return BrowserCuseReject(session, -6, "cuse_e_not_number", err)
        BrowserCuseCloneWidget(session, idx, payload)
        web.WebDocumentSetFormValue(session.document, nodeId, strings.ConcatStr(payload, ""))
        web.WebDocumentDispatchEvent(session.document, nodeId, "input")
        sess.BrowserSessionSetOverride(session, fieldId, payload)
        sess.BrowserSessionMarkApplyAction(session, ctlId, fieldId, payload, actionKind)
        err = ""
        return 0
    if actionKind == "Select":
        if kind != compile.BrowserWidgetSelect:
            return BrowserCuseReject(session, -4, "cuse_e_action_kind_for_control", err)
        let options = strings.ConcatStr(session.widgets[idx].options, "")
        var pos: int32 = 0
        var found: str = ""
        while pos < options.len:
            var next: int32 = 0
            var sel: int32 = 0
            var oval: str = ""
            var olab: str = ""
            if !snap.SnapParseOptionLine(options, pos, next, sel, oval, olab):
                break
            pos = next
            if payload == oval || (olab.len > 0 && payload == olab):
                found = strings.ConcatStr(oval, "")
                break
        if found.len <= 0:
            return BrowserCuseReject(session, -5, "cuse_e_no_option", err)
        BrowserCuseCloneWidget(session, idx, found)
        web.WebDocumentSetFormValue(session.document, nodeId, strings.ConcatStr(found, ""))
        web.WebDocumentDispatchEvent(session.document, nodeId, "change")
        sess.BrowserSessionSetOverride(session, fieldId, found)
        sess.BrowserSessionMarkApplyAction(session, ctlId, fieldId, found, actionKind)
        err = ""
        return 0
    return BrowserCuseReject(session, -3, "cuse_e_action_kind", err)

@borrows
fn BrowserCuseAction(session: var sess.BrowserSession, ctlId: int32, actionKind: str, payload: str, effectClass: str, confirmed: bool, err: var str): int32 =
    # 失败动作不得残留上一动作的 apply 状态(host 会据此注入)
    session.applyReady = false
    session.applyField = ""
    session.applyValue = ""
    session.applyCtlId = 0
    session.applyAction = ""
    let idx = BrowserCuseFindWidget(session, ctlId)
    if idx < 0:
        return BrowserCuseReject(session, -1, "cuse_e_no_control", err)
    let flags = session.widgets[idx].ctlFlags
    if (flags & 1) == 1:
        return BrowserCuseReject(session, -2, "cuse_e_disabled", err)
    if !cu.WebSceneComputerUseAdmit(actionKind, effectClass, confirmed, err):
        session.lastError = strings.ConcatStr(err, "")
        return -3
    # 08 布尔面收紧: 调用方布尔值不得签发授权, 注册表确认要求为确认类的
    # 动作一律拒绝并指向凭证入口 (BrowserCuseActionWithCredential)。
    let admitRow = auth.CsgActionAuthorityRowLookup(actionKind, effectClass)
    if auth.CsgActionAuthorityRowRequiresConfirm(admitRow):
        return BrowserCuseReject(session, -7, "cuse_e_confirmation_credential_required", err)
    return browserCuseApplyAction(session, ctlId, idx, actionKind, payload, err)

# 08 凭证化确认入口: 调用方按凭证行句柄提名消费 (句柄来自
# CsgActionAuthorityGrantConfirm 签发后的 CsgActionAuthorityLastGrantedRow);
# 消费仍按 (动作, 参数, 版本, 世代) 精确重验, 一次性。
fn BrowserCuseActionWithCredential(session: var sess.BrowserSession, ctlId: int32, actionKind: str, payload: str, effectClass: str, credentialRow: int32, err: var str): int32 =
    # 失败动作不得残留上一动作的 apply 状态(host 会据此注入)
    session.applyReady = false
    session.applyField = ""
    session.applyValue = ""
    session.applyCtlId = 0
    session.applyAction = ""
    let idx = BrowserCuseFindWidget(session, ctlId)
    if idx < 0:
        return BrowserCuseReject(session, -1, "cuse_e_no_control", err)
    let flags = session.widgets[idx].ctlFlags
    if (flags & 1) == 1:
        return BrowserCuseReject(session, -2, "cuse_e_disabled", err)
    if !auth.CsgActionAuthorityAdmitWithCredential(actionKind, effectClass, payload, credentialRow, err):
        session.lastError = strings.ConcatStr(err, "")
        return -3
    return browserCuseApplyAction(session, ctlId, idx, actionKind, payload, err)
