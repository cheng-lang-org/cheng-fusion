# 结构化指令层(确定性, 无 LLM): 指令 = 动词 + 目标名 + 载荷(空格分隔),
# 按控件表 accessible name/fieldId 精确检索执行。自然语言/多步模糊指令归
# Q4b 的规划层, 本层不做任何模糊/启发式匹配——检索失败即 hard-fail。
# 指令语法:
#   click|点击|按下 <名称>
#   set|输入|填写|填|设置 <名称> <载荷...>   (载荷全数字且控件 type=number 时走 SetNumber)
#   select|选择|选 <名称> <选项...>
#   toggle|勾选|切换 <名称>
# 返回码沿 BrowserCuseAction; 解析失败 -10 cuse_e_bad_command。

import std/strings
import std/strutils as strutil
import cheng/apps/libp2p_browser/session as sess
import cheng/apps/libp2p_browser/computer_use_session as cuse

@borrows
fn BrowserCuseFirstToken(text: str, head: var str, rest: var str): bool =
    var i: int32 = 0
    while i < text.len && (text[i] == ' ' || text[i] == '\t'):
        i = i + 1
    if i >= text.len:
        return false
    let start = i
    while i < text.len && text[i] != ' ' && text[i] != '\t':
        i = i + 1
    head = html_Slice(text, start, i)
    while i < text.len && (text[i] == ' ' || text[i] == '\t'):
        i = i + 1
    rest = html_Slice(text, i, text.len)
    return true

@borrows
fn html_Slice(text: str, from: int32, to: int32): str =
    # 本地切片: 避免为一个小工具函数引入 html_parse 依赖
    if from < 0 || to <= from || to > text.len:
        return ""
    var out: str = ""
    var i: int32 = from
    while i < to:
        out = strings.ConcatStr(out, strings.CharToStr(text[i]))
        i = i + 1
    return out

@borrows
fn BrowserCuseFindQuote(text: str, from: int32): int32 =
    var i: int32 = from
    while i < text.len:
        if text[i] == '"':
            return i
        i = i + 1
    return -1

@borrows
fn BrowserCuseMapVerb(head: str, action: var str): bool =
    let v = strutil.ToLowerAscii(head)
    if v == "click" || v == "点击" || v == "按下":
        action = "Click"
        return true
    if v == "set" || v == "输入" || v == "填写" || v == "填" || v == "设置":
        action = "Set"
        return true
    if v == "select" || v == "选择" || v == "选":
        action = "Select"
        return true
    if v == "toggle" || v == "勾选" || v == "切换":
        action = "Toggle"
        return true
    if v == "read" || v == "读取" || v == "查" || v == "查找" || v == "看":
        action = "Read"
        return true
    if v == "drag" || v == "拖" || v == "拖动" || v == "滑动":
        action = "Drag"
        return true
    return false

@borrows
fn BrowserCuseFindByName(session: sess.BrowserSession, name: str): int32 =
    # accessible name 优先, fieldId 次之; 均为精确匹配, 不做模糊
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].ctlId > 0 && session.widgets[i].ctlName == name:
            return i
        i = i + 1
    i = 0
    while i < session.widgets.len:
        if session.widgets[i].ctlId > 0 && session.widgets[i].fieldId == name:
            return i
        i = i + 1
    return -1

fn BrowserCuseDigitsOnly(payload: str): bool =
    if payload.len <= 0:
        return false
    var i: int32 = 0
    while i < payload.len:
        if payload[i] < '0' || payload[i] > '9':
            return false
        i = i + 1
    return true

# 非 @borrows: 本层把本地拼装的 target/payload 传给借用形参的被调,
# 拥有实参才有精确存活来源(@borrows 调用者传本地借用串会被拒)。
fn BrowserCuseCommand(session: var sess.BrowserSession, text: str, effectClass: str, confirmed: bool, err: var str): int32 =
    session.applyReady = false
    session.applyField = ""
    session.applyValue = ""
    session.applyCtlId = 0
    session.applyAction = ""
    var head: str = ""
    var rest: str = ""
    if !BrowserCuseFirstToken(text, head, rest):
        return cuse.BrowserCuseReject(session, -10, "cuse_e_bad_command", err)
    var action: str = ""
    if !BrowserCuseMapVerb(head, action):
        return cuse.BrowserCuseReject(session, -10, "cuse_e_bad_command", err)
    # 目标名支持引号语法(名称含空格): "multi word name" — 确定性切分, 不猜
    var target: str = ""
    var payload: str = ""
    if rest.len > 0 && rest[0] == '"':
        let close = BrowserCuseFindQuote(rest, 1)
        if close < 0:
            return cuse.BrowserCuseReject(session, -10, "cuse_e_bad_command", err)
        target = html_Slice(rest, 1, close)
        # payload = 引号后剩余去掉前导空格段(payload 可含空格, 不再切分)
        let tail = html_Slice(rest, close + 1, rest.len)
        var ps: int32 = 0
        while ps < tail.len && (tail[ps] == ' ' || tail[ps] == '\t'):
            ps = ps + 1
        payload = html_Slice(tail, ps, tail.len)
    else:
        if !BrowserCuseFirstToken(rest, target, payload):
            return cuse.BrowserCuseReject(session, -10, "cuse_e_bad_command", err)
    # 载荷对称引号剥离: 模型常输出 set "T" "V"(目标/载荷都引号), 语法上
    # 目标引号已剥离, 载荷两端引号同样剥去(确定性语法扩展)
    if payload.len >= 2 && payload[0] == '"' && payload[payload.len - 1] == '"':
        payload = html_Slice(payload, 1, payload.len - 1)
    # Read 只读语义: 关键词=动词后整段(不切目标、不经控件检索), 须前置
    if action == "Read":
        return cmd_BrowserCuseReadSnapshot(session, rest)
    # Drag 坐标寻址: 拖拽=按下(x,y)+偏移(dx,dy)的宿主 CGEvent 轨迹(合成 JS
    # 事件 isTrusted=false 过不了风控), 不经控件检索, 须前置
    if action == "Drag":
        return cmd_BrowserCuseDrag(session, rest, err)
    let idx = BrowserCuseFindByName(session, target)
    if idx < 0:
        return cuse.BrowserCuseReject(session, -1, "cuse_e_no_control", err)
    let ctlId = session.widgets[idx].ctlId
    # 本地拼装串先克隆出精确存活来源再传入借用形参(仓内惯用法)
    let actionArg = strings.ConcatStr(action, "")
    let payloadArg = strings.ConcatStr(payload, "")
    let effectArg = strings.ConcatStr(effectClass, "")
    if action == "Set":
        let inputType = strutil.ToLowerAscii(session.widgets[idx].inputType)
        if BrowserCuseDigitsOnly(payload) && inputType == "number":
            return cuse.BrowserCuseAction(session, ctlId, "SetNumber", payloadArg, effectArg, confirmed, err)
        return cuse.BrowserCuseAction(session, ctlId, "SetText", payloadArg, effectArg, confirmed, err)
    if action == "Select":
        return cuse.BrowserCuseAction(session, ctlId, "Select", payloadArg, effectArg, confirmed, err)
    return cuse.BrowserCuseAction(session, ctlId, actionArg, "", effectArg, confirmed, err)

# 控件树序列化(指令层报错上下文与 Q4b 规划层输入):
# 每控件一行 ctlId|kind|flags|name|value|options
@borrows
fn BrowserCuseControlTreeText(session: sess.BrowserSession): str =
    var out: str = ""
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].ctlId > 0:
            out = strings.ConcatStr(out, strings.IntToStr(session.widgets[i].ctlId))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, strings.IntToStr(session.widgets[i].kind))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, strings.IntToStr(session.widgets[i].ctlFlags))
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, session.widgets[i].ctlName)
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, session.widgets[i].value)
            out = strings.ConcatStr(out, "|")
            out = strings.ConcatStr(out, session.widgets[i].options)
            out = strings.ConcatStr(out, "\n")
        i = i + 1
    return out


# 读取语义(R6): 关键词命中快照文本盒(txt 含子串), 命中行集写入 session.readResult
# (带盒坐标), 供 host [read] 输出/上层回读。0 命中 hard-fail -7, 不降级不臆造。
fn cmd_BrowserCuseReadSnapshot(session: var sess.BrowserSession, pattern: str): int32 =
    session.applyReady = false
    session.applyField = ""
    session.applyValue = ""
    session.applyCtlId = 0
    session.applyAction = "Read"
    session.readResult = ""
    if pattern.len <= 0:
        session.lastError = "cuse_e_not_found"
        return -7
    var out: str = ""
    var hits: int32 = 0
    var i: int32 = 0
    while i < session.snapBoxes.len:
        if session.snapBoxes[i].tag == "#text" && session.snapBoxes[i].text.len > 0:
            if strings.StrContains(session.snapBoxes[i].text, pattern):
                hits = hits + 1
                if hits <= 20:
                    out = strings.ConcatStr(out, session.snapBoxes[i].text)
                    out = strings.ConcatStr(out, "  @(")
                    out = strings.ConcatStr(out, strings.IntToStr(session.snapBoxes[i].x))
                    out = strings.ConcatStr(out, ",")
                    out = strings.ConcatStr(out, strings.IntToStr(session.snapBoxes[i].y))
                    out = strings.ConcatStr(out, ")\n")
        i = i + 1
    if hits <= 0:
        session.lastError = "cuse_e_not_found"
        return -7
    session.readResult = strings.ConcatStr(out, "")
    return 0


# 拖拽语义(R7): drag <x> <y> <dx> <dy>——页面坐标按下+偏移释放, 逗号或空格
# 分隔均可。cheng 侧只解析与标记(applyAction=Drag), 轨迹由 host 以 CGEvent
# (isTrusted=true)插值执行——合成 JS 事件过不了滑块风控。
@borrows
fn BrowserCuseParseI32Token(text: str, out: var int32): bool =
    # [+-]?digits 严格解析; 失败 false
    var i: int32 = 0
    var neg = false
    if text.len > 0 && (text[0] == '-' || text[0] == '+'):
        neg = text[0] == '-'
        i = 1
    if i >= text.len:
        return false
    var v: int32 = 0
    while i < text.len:
        if text[i] < '0' || text[i] > '9':
            return false
        v = v * 10 + (int32(text[i]) - int32('0'))
        i = i + 1
    if neg:
        out = 0 - v
    else:
        out = v
    return true

fn cmd_BrowserCuseDrag(session: var sess.BrowserSession, rest: str, err: var str): int32 =
    session.applyReady = false
    session.applyField = ""
    session.applyValue = ""
    session.applyCtlId = 0
    session.applyAction = ""
    # 四段坐标用 FirstToken 链式提取(无数组/循环 add, 规避序列前驱检查)
    var t1: str = ""
    var r1: str = ""
    var t2: str = ""
    var r2: str = ""
    var t3: str = ""
    var r3: str = ""
    var t4: str = ""
    if !BrowserCuseFirstToken(rest, t1, r1):
        session.lastError = "cuse_e_bad_command"
        return -10
    if !BrowserCuseFirstToken(r1, t2, r2):
        session.lastError = "cuse_e_bad_command"
        return -10
    if !BrowserCuseFirstToken(r2, t3, r3):
        session.lastError = "cuse_e_bad_command"
        return -10
    if !BrowserCuseFirstToken(r3, t4, r3):
        session.lastError = "cuse_e_bad_command"
        return -10
    var vX: int32 = 0
    var vY: int32 = 0
    var vDX: int32 = 0
    var vDY: int32 = 0
    if !BrowserCuseParseI32Token(t1, vX) || !BrowserCuseParseI32Token(t2, vY) || !BrowserCuseParseI32Token(t3, vDX) || !BrowserCuseParseI32Token(t4, vDY):
        session.lastError = "cuse_e_bad_command"
        return -10
    session.applyValue = strings.ConcatStr(strings.IntToStr(vX), strings.ConcatStr(",", strings.ConcatStr(strings.IntToStr(vY), strings.ConcatStr(",", strings.ConcatStr(strings.IntToStr(vDX), strings.ConcatStr(",", strings.IntToStr(vDY)))))))
    session.applyAction = "Drag"
    session.applyReady = true
    err = ""
    return 0
