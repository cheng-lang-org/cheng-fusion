import std/strings
import std/strutils as strutil
import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_paint_runtime as paint
import cheng/apps/libp2p_browser/html_parse as htmlparse
import cheng/apps/libp2p_browser/compile_render as compile
import cheng/apps/libp2p_browser/page_snapshot as snap
import cheng/apps/libp2p_browser/sync_protocol as sync

type
    BrowserSession =
        url: str
        html: str
        loadComplete: bool
        rightOpen: bool
        lastError: str
        cssParseOk: bool
        parseMs: int64
        styleMs: int64
        layoutMs: int64
        paintMs: int64
        nodeCount: int32
        inputCount: int32
        eventCount: int32
        widgetCount: int32
        opCount: int32
        viewportW: int32
        viewportH: int32
        focusedNodeId: int32
        sessionEpoch: int32
        selfPeer: str
        selectedPeer: str
        connectedPeers: str[]
        pendingUrl: str
        document: web.WebDocument
        ops: paint.PaintOp[]
        widgets: compile.BrowserWidget[]
        outbox: sync.BrowserSyncMessage[]
        inbox: sync.BrowserSyncMessage[]
        lastSnapshot: str
        extraCss: str
        openFieldId: str
        overrideFields: str[]
        overrideValues: str[]
        overlayOps: paint.PaintOp[]
        overlayWidgets: compile.BrowserWidget[]
        applyField: str
        applyValue: str
        applyReady: bool
        # 语义动作 apply 通道: ctlId>0 时 host 按 captureId 寻址注入 JS
        # (__chengCtlById), applyAction 分派注入模板(Click/Toggle/SetText/
        # SetNumber/Select); ctlId=0 走旧 fieldId 写回(兼容)。
        applyCtlId: int32
        applyAction: str
        # Q4b 规划会话: planPrompt=喂给真实模型的控件树+目标; planSteps=模型
        # 回复解析出的指令行(经确定性协议解析), host 逐条走 cuse_command。
        planPrompt: str
        planSteps: str[]
        # 规划允许动词集(逗号分隔, 如 "set,click,read"): 解析层逐条过滤越权
        # 步骤(模型无视 goal 约束的确定性对策); 空串=不限制
        planAllow: str
        # Read 指令结果: 快照文本盒按关键词命中的行集(只读语义, 不产生注入)
        readResult: str
        # Incremental snapshot patch state: resident parsed box rows kept so
        # each swap re-parses only the changed CLB window.
        snapBoxes: snap.BrowserSnapBox[]

fn BrowserSessionInit(selfPeer: str, viewportW: int32, viewportH: int32): BrowserSession =
    var s: BrowserSession
    s.url = ""
    s.html = ""
    s.loadComplete = false
    s.rightOpen = false
    s.lastError = ""
    s.cssParseOk = true
    s.parseMs = 0
    s.styleMs = 0
    s.layoutMs = 0
    s.paintMs = 0
    s.nodeCount = 0
    s.inputCount = 0
    s.eventCount = 0
    s.widgetCount = 0
    s.opCount = 0
    s.viewportW = viewportW
    s.viewportH = viewportH
    if s.viewportW <= 0:
        s.viewportW = 640
    if s.viewportH <= 0:
        s.viewportH = 720
    s.focusedNodeId = 0
    s.sessionEpoch = 0
    s.selfPeer = strings.ConcatStr(selfPeer, "")
    s.selectedPeer = ""
    s.connectedPeers = []
    s.pendingUrl = ""
    web.WebDocumentInit(s.document)
    s.ops = []
    s.widgets = []
    s.outbox = []
    s.inbox = []
    s.lastSnapshot = ""
    s.extraCss = ""
    s.openFieldId = ""
    s.overrideFields = []
    s.overrideValues = []
    s.overlayOps = []
    s.overlayWidgets = []
    s.applyField = ""
    s.applyValue = ""
    s.applyReady = false
    s.applyCtlId = 0
    s.applyAction = ""
    s.planPrompt = ""
    s.planSteps = []
    s.planAllow = ""
    s.readResult = ""
    s.snapBoxes = []
    return s

@borrows
fn BrowserSessionPeerConnected(session: BrowserSession, peer: str): bool =
    if peer.len <= 0:
        return false
    for i in 0..<session.connectedPeers.len:
        if session.connectedPeers[i] == peer:
            return true
    return false

@borrows
fn BrowserSessionAttachPeer(session: var BrowserSession, peer: str): bool =
    if peer.len <= 0:
        session.lastError = "session: empty peer"
        return false
    if BrowserSessionPeerConnected(session, peer):
        return true
    add(session.connectedPeers, strings.ConcatStr(peer, ""))
    return true

@borrows
fn BrowserSessionSelectPeer(session: var BrowserSession, peer: str): bool =
    if !BrowserSessionPeerConnected(session, peer):
        session.lastError = "session: peer not connected"
        return false
    session.selectedPeer = strings.ConcatStr(peer, "")
    return true

fn BrowserSessionCloseRight(session: var BrowserSession) =
    session.rightOpen = false
    session.loadComplete = false
    session.focusedNodeId = 0
    session.ops = []
    session.widgets = []
    session.html = ""
    session.nodeCount = 0
    session.inputCount = 0
    session.eventCount = 0
    session.widgetCount = 0
    session.opCount = 0
    session.parseMs = 0
    session.styleMs = 0
    session.layoutMs = 0
    session.paintMs = 0
    session.lastSnapshot = ""
    session.extraCss = ""
    session.openFieldId = ""
    session.overrideFields = []
    session.overrideValues = []
    session.overlayOps = []
    session.overlayWidgets = []
    session.applyField = ""
    session.applyValue = ""
    session.applyReady = false
    session.applyCtlId = 0
    session.applyAction = ""
    session.planPrompt = ""
    session.planSteps = []
    session.readResult = ""

@borrows
fn BrowserSessionBeginLoad(session: var BrowserSession, url: str) =
    session.url = strings.ConcatStr(url, "")
    session.pendingUrl = session.url
    session.sessionEpoch = session.sessionEpoch + 1
    session.lastError = ""
    BrowserSessionCloseRight(session)

@borrows
fn BrowserSessionCanSend(session: BrowserSession): bool =
    if session.selectedPeer.len <= 0:
        return false
    return BrowserSessionPeerConnected(session, session.selectedPeer)

fn BrowserSessionQueueOut(session: var BrowserSession, msg: sync.BrowserSyncMessage) =
    if !BrowserSessionCanSend(session):
        return
    add(session.outbox, sync.BrowserSyncCloneMessage(msg))

@borrows
fn BrowserSessionApplyInputToWidgets(session: var BrowserSession, fieldId: str, value: str): bool =
    var found = false
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].fieldId == fieldId:
            var nw: compile.BrowserWidget
            nw.kind = session.widgets[i].kind
            nw.nodeId = session.widgets[i].nodeId
            nw.fieldId = strings.ConcatStr(session.widgets[i].fieldId, "")
            nw.href = strings.ConcatStr(session.widgets[i].href, "")
            nw.inputType = strings.ConcatStr(session.widgets[i].inputType, "")
            nw.value = strings.ConcatStr(value, "")
            nw.options = strings.ConcatStr(session.widgets[i].options, "")
            nw.ctlId = session.widgets[i].ctlId
            nw.ctlFlags = session.widgets[i].ctlFlags
            nw.ctlRole = strings.ConcatStr(session.widgets[i].ctlRole, "")
            nw.ctlName = strings.ConcatStr(session.widgets[i].ctlName, "")
            nw.x = session.widgets[i].x
            nw.y = session.widgets[i].y
            nw.w = session.widgets[i].w
            nw.h = session.widgets[i].h
            session.widgets[i] = nw
            web.WebDocumentSetFormValue(session.document, nw.nodeId, strings.ConcatStr(nw.value, ""))
            found = true
        i = i + 1
    return found

fn BrowserSessionApplyPendingInputs(session: var BrowserSession) =
    var kept: sync.BrowserSyncMessage[]
    var i: int32 = 0
    while i < session.inbox.len:
        let msg = session.inbox[i]
        i = i + 1
        if msg.kind == sync.BrowserSyncKindInput && (msg.epoch == session.sessionEpoch || msg.url == session.url):
            if !BrowserSessionApplyInputToWidgets(session, msg.fieldId, msg.value):
                add(kept, sync.BrowserSyncCloneMessage(msg))
            continue
        add(kept, sync.BrowserSyncCloneMessage(msg))
    session.inbox = kept

@borrows
fn BrowserSessionCommitPageUrl(session: var BrowserSession, url: str) =
    if url.len > 0:
        if session.pendingUrl.len <= 0 || session.pendingUrl != url:
            if session.url != url:
                session.sessionEpoch = session.sessionEpoch + 1
        session.url = strings.ConcatStr(url, "")
        session.pendingUrl = strings.ConcatStr(url, "")
    elif session.url.len <= 0:
        session.url = "about:blank"
        session.pendingUrl = "about:blank"

@borrows
fn BrowserSessionFocusedFieldId(session: BrowserSession): str =
    if session.focusedNodeId <= 0:
        return ""
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].nodeId == session.focusedNodeId:
            return strings.ConcatStr(session.widgets[i].fieldId, "")
        i = i + 1
    return ""

@borrows
fn BrowserSessionRestoreFocus(session: var BrowserSession, fieldId: str) =
    session.focusedNodeId = 0
    if fieldId.len <= 0:
        return
    var i: int32 = 0
    while i < session.widgets.len:
        if session.widgets[i].fieldId == fieldId:
            session.focusedNodeId = session.widgets[i].nodeId
            return
        i = i + 1

fn BrowserSessionInstallBundle(session: var BrowserSession, document: var web.WebDocument, bundle: var compile.BrowserCompileBundle, ok: bool, applyPending: bool): bool =
    let keepField = BrowserSessionFocusedFieldId(session)
    if !ok:
        session.lastError = strings.ConcatStr(bundle.err, "")
        return false
    session.document = document
    session.ops = bundle.ops
    session.widgets = bundle.widgets
    session.rightOpen = true
    session.cssParseOk = bundle.stats.cssParseOk
    session.parseMs = bundle.stats.parseMs
    session.styleMs = bundle.stats.styleMs
    session.layoutMs = bundle.stats.layoutMs
    session.paintMs = bundle.stats.paintMs
    session.nodeCount = bundle.stats.nodeCount
    session.inputCount = bundle.stats.inputCount
    session.eventCount = bundle.stats.eventCount
    session.widgetCount = bundle.stats.widgetCount
    session.opCount = bundle.stats.opCount
    session.focusedNodeId = 0
    session.lastError = ""
    if applyPending:
        BrowserSessionApplyPendingInputs(session)
        if BrowserSessionCanSend(session):
            BrowserSessionQueueOut(session, sync.BrowserSyncLoadComplete(session.url, session.sessionEpoch, session.parseMs, session.layoutMs, session.paintMs))
    BrowserSessionRestoreFocus(session, keepField)
    session.overlayOps = []
    session.overlayWidgets = []
    return true

@borrows
fn BrowserSessionOnPageLoaded(session: var BrowserSession, url: str, html: str): bool =
    BrowserSessionCommitPageUrl(session, url)
    session.html = strings.ConcatStr(html, "")
    session.loadComplete = true
    var document: web.WebDocument
    var bundle: compile.BrowserCompileBundle
    let ok = compile.BrowserCompileHtml(html, session.extraCss, session.viewportW, session.viewportH, document, bundle)
    return BrowserSessionInstallBundle(session, document, bundle, ok, true)

@borrows
fn BrowserSessionOnPageSnapshot(session: var BrowserSession, url: str, snapshot: str): bool =
    BrowserSessionCommitPageUrl(session, url)
    session.html = ""
    session.loadComplete = true
    var document: web.WebDocument
    var bundle: compile.BrowserCompileBundle
    if snapshot.len <= 0:
        web.WebDocumentInit(document)
        snap.SnapInitBundle(bundle)
        bundle.err = "session: empty snapshot"
        return BrowserSessionInstallBundle(session, document, bundle, false, false)
    let ok = snap.BrowserCompileSnapshot(snapshot, document, bundle)
    if ok && bundle.stats.nodeCount <= 0:
        bundle.err = "snapshot: zero boxes"
        return BrowserSessionInstallBundle(session, document, bundle, false, false)
    if ok && bundle.stats.viewportW > 0:
        session.viewportW = bundle.stats.viewportW
        session.viewportH = bundle.stats.viewportH
    if ok:
        session.lastSnapshot = strings.ConcatStr(snapshot, "")
        session.openFieldId = ""
        session.overrideFields = []
        session.overrideValues = []
        session.applyReady = false
        session.applyField = ""
        session.applyValue = ""
        session.applyCtlId = 0
        session.applyAction = ""
        var seedVw: int32 = 0
        var seedVh: int32 = 0
        var seedMs: int32 = 0
        if !snap.SnapParseBoxes(snapshot, seedVw, seedVh, seedMs, session.snapBoxes):
            setLen(session.snapBoxes, 0)
    return BrowserSessionInstallBundle(session, document, bundle, ok, true)

fn BrowserSessionRefreshSnapshot(session: var BrowserSession, url: str, snapshot: str): bool =
    BrowserSessionCommitPageUrl(session, url)
    session.loadComplete = true
    var document: web.WebDocument
    var bundle: compile.BrowserCompileBundle
    if snapshot.len <= 0:
        session.lastError = "session: empty snapshot"
        return false
    # Incremental level-1: the CLB header's capture-ms field differs every
    # capture, so equality is judged over the box region. Equal box region
    # means the frame is identical: skip the whole recompile (zero parse, zero
    # op/widget churn on throttled idle captures). Any difference falls through
    # to the full recompile below.
    # Incremental level-2: window patch — diff the previous and current CLB
    # box runs, re-parse only the changed window, splice the resident box rows
    # and reproduce ops/widgets from them. Falls back to the full recompile
    # below on any shape it cannot patch.
    if session.snapBoxes.len > 0:
        let patchKeepField = BrowserSessionFocusedFieldId(session)
        var patchDocument: web.WebDocument
        var patchBundle: compile.BrowserCompileBundle
        var patchPrev = strings.ConcatStr(session.lastSnapshot, "")
        var patchNext = strings.ConcatStr(snapshot, "")
        if snap.BrowserSnapshotPatchSession(patchPrev, patchNext,
                                            session.snapBoxes,
                                            patchDocument, patchBundle):
            if patchBundle.stats.nodeCount <= 0:
                session.lastError = "snapshot: zero boxes"
                return false
            if patchBundle.stats.viewportW > 0:
                session.viewportW = patchBundle.stats.viewportW
                session.viewportH = patchBundle.stats.viewportH
            session.document = patchDocument
            session.ops = patchBundle.ops
            session.widgets = patchBundle.widgets
            session.cssParseOk = true
            session.parseMs = patchBundle.stats.parseMs
            session.styleMs = patchBundle.stats.styleMs
            session.layoutMs = patchBundle.stats.layoutMs
            session.paintMs = patchBundle.stats.paintMs
            session.nodeCount = patchBundle.stats.nodeCount
            session.inputCount = patchBundle.stats.inputCount
            session.eventCount = patchBundle.stats.eventCount
            session.widgetCount = patchBundle.stats.widgetCount
            session.opCount = patchBundle.stats.opCount
            session.lastError = ""
            session.lastSnapshot = strings.ConcatStr(snapshot, "")
            session.openFieldId = ""
            session.overrideFields = []
            session.overrideValues = []
            session.overlayOps = []
            session.overlayWidgets = []
            session.applyReady = false
            session.applyField = ""
            session.applyValue = ""
            session.applyCtlId = 0
            session.applyAction = ""
            BrowserSessionRestoreFocus(session, patchKeepField)
            return true
    # Incremental level-1: the CLB header's capture-ms field differs every
    # capture, so equality is judged over the box region. Equal box region
    # means the frame is identical: skip the whole recompile (zero parse, zero
    # op/widget churn on throttled idle captures). Any difference falls through
    # to the full recompile below.
    if session.lastSnapshot.len > 0 && snap.SnapBoxRegionEqual(session.lastSnapshot, snapshot):
        session.openFieldId = ""
        session.overrideFields = []
        session.overrideValues = []
        session.overlayOps = []
        session.overlayWidgets = []
        session.applyReady = false
        session.applyField = ""
        session.applyValue = ""
        session.applyCtlId = 0
        session.applyAction = ""
        session.lastError = ""
        return true
    let ok = snap.BrowserCompileSnapshot(snapshot, document, bundle)
    if !ok:
        session.lastError = strings.ConcatStr(bundle.err, "")
        return false
    if bundle.stats.nodeCount <= 0:
        session.lastError = "snapshot: zero boxes"
        return false
    var seedVw: int32 = 0
    var seedVh: int32 = 0
    var seedMs: int32 = 0
    if !snap.SnapParseBoxes(snapshot, seedVw, seedVh, seedMs, session.snapBoxes):
        setLen(session.snapBoxes, 0)
    if bundle.stats.viewportW > 0:
        session.viewportW = bundle.stats.viewportW
        session.viewportH = bundle.stats.viewportH
    session.lastSnapshot = strings.ConcatStr(snapshot, "")
    session.openFieldId = ""
    session.overrideFields = []
    session.overrideValues = []
    session.applyReady = false
    session.applyField = ""
    session.applyValue = ""
    session.applyCtlId = 0
    session.applyAction = ""
    return BrowserSessionInstallBundle(session, document, bundle, true, false)

@borrows
fn BrowserSessionOnLoadComplete(session: var BrowserSession, html: str): bool =
    var pageUrl = strings.ConcatStr(session.pendingUrl, "")
    if pageUrl.len <= 0:
        pageUrl = strings.ConcatStr(session.url, "")
    return BrowserSessionOnPageLoaded(session, pageUrl, html)

@borrows
fn BrowserSessionNavigate(session: var BrowserSession, url: str, sendToPeer: bool) =
    BrowserSessionBeginLoad(session, url)
    if sendToPeer:
        BrowserSessionQueueOut(session, sync.BrowserSyncNavigate(session.url, session.sessionEpoch))

@borrows
fn BrowserSessionSetOverride(session: var BrowserSession, fieldId: str, value: str) =
    if fieldId.len <= 0:
        return
    var i: int32 = 0
    while i < session.overrideFields.len:
        if session.overrideFields[i] == fieldId:
            var fields: str[]
            var vals: str[]
            var j: int32 = 0
            while j < session.overrideFields.len:
                if j == i:
                    add(fields, strings.ConcatStr(fieldId, ""))
                    add(vals, strings.ConcatStr(value, ""))
                else:
                    add(fields, strings.ConcatStr(session.overrideFields[j], ""))
                    add(vals, strings.ConcatStr(session.overrideValues[j], ""))
                j = j + 1
            session.overrideFields = fields
            session.overrideValues = vals
            return
        i = i + 1
    add(session.overrideFields, strings.ConcatStr(fieldId, ""))
    add(session.overrideValues, strings.ConcatStr(value, ""))

fn BrowserSessionPaintLive(session: var BrowserSession): bool =
    session.overlayOps = []
    session.overlayWidgets = []
    snap.BrowserSnapshotApplySelectState(session.overlayOps, session.widgets, session.overlayWidgets, session.openFieldId, session.overrideFields, session.overrideValues, session.viewportH)
    session.opCount = session.ops.len + session.overlayOps.len
    session.widgetCount = session.widgets.len + session.overlayWidgets.len
    return true

fn BrowserSessionRealizeRight(session: var BrowserSession): bool =
    return BrowserSessionPaintLive(session)

@borrows
fn BrowserSessionMarkApply(session: var BrowserSession, fieldId: str, value: str) =
    session.applyField = strings.ConcatStr(fieldId, "")
    session.applyValue = strings.ConcatStr(value, "")
    session.applyReady = true
    session.applyCtlId = 0
    session.applyAction = "value"

# 语义动作 apply: ctlId 寻址 + 动作类型分派 host 注入模板。
@borrows
fn BrowserSessionMarkApplyAction(session: var BrowserSession, ctlId: int32, fieldId: str, value: str, actionKind: str) =
    session.applyField = strings.ConcatStr(fieldId, "")
    session.applyValue = strings.ConcatStr(value, "")
    session.applyReady = true
    session.applyCtlId = ctlId
    session.applyAction = strings.ConcatStr(actionKind, "")

fn BrowserSessionClick(session: var BrowserSession, x: int32, y: int32): int32 =
    session.applyReady = false
    session.applyField = ""
    session.applyValue = ""
    session.applyCtlId = 0
    session.applyAction = ""
    if !session.rightOpen:
        return 0
    let overlayIdx = compile.BrowserHitWidget(session.overlayWidgets, x, y)
    if overlayIdx >= 0:
        let kindOv = session.overlayWidgets[overlayIdx].kind
        if kindOv == compile.BrowserWidgetOption:
            let fieldId = strings.ConcatStr(session.overlayWidgets[overlayIdx].fieldId, "")
            let value = strings.ConcatStr(session.overlayWidgets[overlayIdx].value, "")
            let ctlIdOv = session.overlayWidgets[overlayIdx].ctlId
            BrowserSessionSetOverride(session, fieldId, value)
            BrowserSessionMarkApplyAction(session, ctlIdOv, fieldId, value, "Select")
            session.openFieldId = ""
            BrowserSessionQueueOut(session, sync.BrowserSyncInput(fieldId, value, session.url, session.sessionEpoch))
            BrowserSessionRealizeRight(session)
            return 5
    var idx = compile.BrowserHitWidget(session.widgets, x, y)
    var kind: int32 = 0
    if idx >= 0:
        kind = session.widgets[idx].kind
    if kind == compile.BrowserWidgetOption:
        let fieldId = strings.ConcatStr(session.widgets[idx].fieldId, "")
        let value = strings.ConcatStr(session.widgets[idx].value, "")
        let ctlIdOp = session.widgets[idx].ctlId
        BrowserSessionSetOverride(session, fieldId, value)
        BrowserSessionMarkApplyAction(session, ctlIdOp, fieldId, value, "Select")
        session.openFieldId = ""
        BrowserSessionQueueOut(session, sync.BrowserSyncInput(fieldId, value, session.url, session.sessionEpoch))
        BrowserSessionRealizeRight(session)
        return 5
    if kind == compile.BrowserWidgetSelect:
        let fieldId = strings.ConcatStr(session.widgets[idx].fieldId, "")
        if session.openFieldId == fieldId:
            session.openFieldId = ""
        else:
            session.openFieldId = strings.ConcatStr(fieldId, "")
        BrowserSessionRealizeRight(session)
        return 5
    if session.openFieldId.len > 0:
        session.openFieldId = ""
        BrowserSessionRealizeRight(session)
        idx = compile.BrowserHitWidget(session.widgets, x, y)
        if idx < 0:
            session.focusedNodeId = 0
            return 0
        kind = session.widgets[idx].kind
    if idx < 0:
        session.focusedNodeId = 0
        return 0
    let nodeId = session.widgets[idx].nodeId
    let inputType = strings.ConcatStr(session.widgets[idx].inputType, "")
    let href = strings.ConcatStr(session.widgets[idx].href, "")
    if nodeId > 0:
        web.WebDocumentClick(session.document, nodeId)
        web.WebDocumentDispatchEvent(session.document, nodeId, "click")
    if kind == compile.BrowserWidgetInput || kind == compile.BrowserWidgetTextarea:
        if inputType == "submit" || inputType == "button" || inputType == "checkbox":
            if inputType == "checkbox":
                var checked = false
                web.WebDocumentGetChecked(session.document, nodeId, checked)
                web.WebDocumentSetChecked(session.document, nodeId, !checked)
            return 3
        session.focusedNodeId = nodeId
        web.WebDocumentFocus(session.document, nodeId)
        return 1
    if kind == compile.BrowserWidgetButton:
        return 3
    if kind == compile.BrowserWidgetAnchor && href.len > 0:
        if href[0] == '#':
            return 4
        if htmlparse.HtmlStartsAtIgnoreCase(href, 0, "javascript:"):
            return 4
        let nextUrl = compile.BrowserResolveUrl(session.url, href)
        BrowserSessionNavigate(session, nextUrl, true)
        return 2
    return 0

fn BrowserSessionKeyChar(session: var BrowserSession, code: int32): bool =
    if !session.rightOpen || session.focusedNodeId <= 0:
        return false
    var i: int32 = 0
    var found = false
    var widgetIndex: int32 = -1
    while i < session.widgets.len:
        if session.widgets[i].nodeId == session.focusedNodeId:
            found = true
            widgetIndex = i
        i = i + 1
    if !found || widgetIndex < 0:
        return false
    let kind = session.widgets[widgetIndex].kind
    let nodeId = session.widgets[widgetIndex].nodeId
    let inputType = strings.ConcatStr(session.widgets[widgetIndex].inputType, "")
    let fieldId = strings.ConcatStr(session.widgets[widgetIndex].fieldId, "")
    if kind != compile.BrowserWidgetInput && kind != compile.BrowserWidgetTextarea:
        return false
    if inputType == "submit" || inputType == "button" || inputType == "checkbox" || inputType == "radio":
        return false
    var value = strings.ConcatStr(session.widgets[widgetIndex].value, "")
    if code == 8:
        if value.len <= 0:
            return true
        value = htmlparse.HtmlSlice(value, 0, value.len - 1)
    elif code == 13:
        web.WebDocumentDispatchEvent(session.document, nodeId, "change")
        return true
    elif code >= 32 && code < 127:
        let alphabet = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
        value = strings.ConcatStr(value, strings.ConcatStr(strings.SliceBytes(alphabet, code - 32, 1), ""))
    else:
        return false
    var nw: compile.BrowserWidget
    nw.kind = kind
    nw.nodeId = nodeId
    nw.fieldId = strings.ConcatStr(fieldId, "")
    nw.href = strings.ConcatStr(session.widgets[widgetIndex].href, "")
    nw.inputType = strings.ConcatStr(inputType, "")
    nw.value = strings.ConcatStr(value, "")
    nw.options = strings.ConcatStr(session.widgets[widgetIndex].options, "")
    nw.ctlId = session.widgets[widgetIndex].ctlId
    nw.ctlFlags = session.widgets[widgetIndex].ctlFlags
    nw.ctlRole = strings.ConcatStr(session.widgets[widgetIndex].ctlRole, "")
    nw.ctlName = strings.ConcatStr(session.widgets[widgetIndex].ctlName, "")
    nw.x = session.widgets[widgetIndex].x
    nw.y = session.widgets[widgetIndex].y
    nw.w = session.widgets[widgetIndex].w
    nw.h = session.widgets[widgetIndex].h
    session.widgets[widgetIndex] = nw
    web.WebDocumentSetFormValue(session.document, nodeId, strings.ConcatStr(value, ""))
    web.WebDocumentDispatchEvent(session.document, nodeId, "input")
    BrowserSessionSetOverride(session, fieldId, value)
    BrowserSessionQueueOut(session, sync.BrowserSyncInput(fieldId, value, session.url, session.sessionEpoch))
    BrowserSessionRealizeRight(session)
    return true

@borrows
fn BrowserSessionPushInboxEncoded(session: var BrowserSession, wire: str): bool =
    var msg: sync.BrowserSyncMessage
    if !sync.BrowserSyncDecode(wire, msg):
        session.lastError = "session: bad sync wire"
        return false
    add(session.inbox, sync.BrowserSyncCloneMessage(msg))
    return true

fn BrowserSessionApplyInbox(session: var BrowserSession): int32 =
    var kept: sync.BrowserSyncMessage[]
    var applied: int32 = 0
    var i: int32 = 0
    while i < session.inbox.len:
        let msg = session.inbox[i]
        i = i + 1
        if msg.kind == sync.BrowserSyncKindNavigate:
            if msg.url.len > 0:
                BrowserSessionBeginLoad(session, msg.url)
                applied = applied + 1
            continue
        if msg.kind == sync.BrowserSyncKindInput:
            if session.rightOpen:
                if BrowserSessionApplyInputToWidgets(session, msg.fieldId, msg.value):
                    applied = applied + 1
                    continue
            add(kept, sync.BrowserSyncCloneMessage(msg))
            continue
        if msg.kind == sync.BrowserSyncKindLoadComplete:
            applied = applied + 1
            continue
        add(kept, sync.BrowserSyncCloneMessage(msg))
    session.inbox = kept
    return applied

fn BrowserSessionDrainOutbox(session: var BrowserSession): str[] =
    var wires: str[]
    var i: int32 = 0
    while i < session.outbox.len:
        let wire = sync.BrowserSyncEncode(session.outbox[i])
        if wire.len > 0:
            add(wires, wire)
        i = i + 1
    session.outbox = []
    return wires

fn BrowserSessionDeliver(fromSession: var BrowserSession, toSession: var BrowserSession): int32 =
    if fromSession.selectedPeer != toSession.selfPeer:
        return 0
    var delivered: int32 = 0
    var i: int32 = 0
    while i < fromSession.outbox.len:
        add(toSession.inbox, sync.BrowserSyncCloneMessage(fromSession.outbox[i]))
        delivered = delivered + 1
        i = i + 1
    fromSession.outbox = []
    return delivered

@borrows
fn BrowserJsonString(raw: str): str =
    var parts: str[]
    add(parts, "\"")
    for i in 0..<raw.len:
        let ch = raw[i]
        if ch == '\\':
            add(parts, "\\\\")
        elif ch == '"':
            add(parts, "\\\"")
        elif ch == '\n':
            add(parts, "\\n")
        elif ch == '\r':
            add(parts, "\\r")
        elif ch == '\t':
            add(parts, "\\t")
        else:
            add(parts, strings.CharToStr(ch))
    add(parts, "\"")
    return strutil.Join(parts, "")

@borrows
fn BrowserSessionStatsLine(session: BrowserSession): str =
    var parts: str[]
    add(parts, "parse=")
    add(parts, strings.int64ToStr(session.parseMs))
    add(parts, "ms style=")
    add(parts, strings.int64ToStr(session.styleMs))
    add(parts, "ms layout=")
    add(parts, strings.int64ToStr(session.layoutMs))
    add(parts, "ms paint=")
    add(parts, strings.int64ToStr(session.paintMs))
    add(parts, "ms nodes=")
    add(parts, strings.IntToStr(session.nodeCount))
    add(parts, " inputs=")
    add(parts, strings.IntToStr(session.inputCount))
    add(parts, " events=")
    add(parts, strings.IntToStr(session.eventCount))
    add(parts, " ops=")
    add(parts, strings.IntToStr(session.opCount))
    return strutil.Join(parts, "")

@borrows
fn BrowserSessionSnapshotJson(session: BrowserSession): str =
    var right = "false"
    if session.rightOpen:
        right = "true"
    var load = "false"
    if session.loadComplete:
        load = "true"
    var cssOk = "false"
    if session.cssParseOk:
        cssOk = "true"
    var parts: str[]
    add(parts, "{\"format\":\"cheng_libp2p_browser_v1\"")
    add(parts, ",\"url\":")
    add(parts, BrowserJsonString(session.url))
    add(parts, ",\"self_peer\":")
    add(parts, BrowserJsonString(session.selfPeer))
    add(parts, ",\"selected_peer\":")
    add(parts, BrowserJsonString(session.selectedPeer))
    add(parts, ",\"connected_count\":")
    add(parts, strings.IntToStr(session.connectedPeers.len))
    add(parts, ",\"right_open\":")
    add(parts, right)
    add(parts, ",\"load_complete\":")
    add(parts, load)
    add(parts, ",\"css_parse_ok\":")
    add(parts, cssOk)
    add(parts, ",\"parse_ms\":")
    add(parts, strings.int64ToStr(session.parseMs))
    add(parts, ",\"style_ms\":")
    add(parts, strings.int64ToStr(session.styleMs))
    add(parts, ",\"layout_ms\":")
    add(parts, strings.int64ToStr(session.layoutMs))
    add(parts, ",\"paint_ms\":")
    add(parts, strings.int64ToStr(session.paintMs))
    add(parts, ",\"node_count\":")
    add(parts, strings.IntToStr(session.nodeCount))
    add(parts, ",\"input_count\":")
    add(parts, strings.IntToStr(session.inputCount))
    add(parts, ",\"event_count\":")
    add(parts, strings.IntToStr(session.eventCount))
    add(parts, ",\"widget_count\":")
    add(parts, strings.IntToStr(session.widgetCount))
    add(parts, ",\"op_count\":")
    add(parts, strings.IntToStr(session.opCount))
    add(parts, ",\"pending_url\":")
    add(parts, BrowserJsonString(session.pendingUrl))
    add(parts, ",\"error\":")
    add(parts, BrowserJsonString(session.lastError))
    add(parts, "}")
    return strutil.Join(parts, "")
