import std/strings
import std/strutils as strutil

const
    BrowserSyncKindNavigate: int32 = 1
    BrowserSyncKindInput: int32 = 2
    BrowserSyncKindLoadComplete: int32 = 3
    BrowserSyncMagic: str = "CLB1"

type
    BrowserSyncMessage =
        kind: int32
        url: str
        fieldId: str
        value: str
        epoch: int32
        parseMs: int64
        layoutMs: int64
        paintMs: int64

fn BrowserSyncInitMessage(): BrowserSyncMessage =
    var msg: BrowserSyncMessage
    msg.kind = 0
    msg.url = ""
    msg.fieldId = ""
    msg.value = ""
    msg.epoch = 0
    msg.parseMs = 0
    msg.layoutMs = 0
    msg.paintMs = 0
    return msg

@borrows
fn BrowserSyncCloneMessage(msg: BrowserSyncMessage): BrowserSyncMessage =
    var out = BrowserSyncInitMessage()
    out.kind = msg.kind
    out.url = strings.ConcatStr(msg.url, "")
    out.fieldId = strings.ConcatStr(msg.fieldId, "")
    out.value = strings.ConcatStr(msg.value, "")
    out.epoch = msg.epoch
    out.parseMs = msg.parseMs
    out.layoutMs = msg.layoutMs
    out.paintMs = msg.paintMs
    return out

@borrows
fn BrowserSyncReadDecimal(text: str, pos: int32, outPos: var int32, outVal: var int64): bool =
    var i = pos
    var sign: int64 = 1
    if i < text.len && text[i] == '-':
        sign = 0 - 1
        i = i + 1
    var n: int64 = 0
    var any = false
    while i < text.len && text[i] >= '0' && text[i] <= '9':
        n = n * 10 + int64(int32(text[i]) - int32('0'))
        any = true
        i = i + 1
    if !any:
        return false
    if i >= text.len || text[i] != ';':
        return false
    outPos = i + 1
    outVal = n * sign
    return true

@borrows
fn BrowserSyncEncode(msg: BrowserSyncMessage): str =
    if msg.kind != BrowserSyncKindNavigate && msg.kind != BrowserSyncKindInput && msg.kind != BrowserSyncKindLoadComplete:
        return ""
    var parts: str[]
    add(parts, strings.ConcatStr(BrowserSyncMagic, ""))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.IntToStr(msg.kind))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.IntToStr(msg.epoch))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.IntToStr(msg.url.len))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.ConcatStr(msg.url, ""))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.IntToStr(msg.fieldId.len))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.ConcatStr(msg.fieldId, ""))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.IntToStr(msg.value.len))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.ConcatStr(msg.value, ""))
    add(parts, strings.ConcatStr(";", ""))
    add(parts, strings.int64ToStr(msg.parseMs))
    add(parts, ";")
    add(parts, strings.int64ToStr(msg.layoutMs))
    add(parts, ";")
    add(parts, strings.int64ToStr(msg.paintMs))
    add(parts, ";")
    return strutil.Join(parts, "")

@borrows
fn BrowserSyncReadExact(text: str, pos: int32, n: int32, outPos: var int32, outText: var str): bool =
    if n < 0:
        return false
    if pos + n > text.len:
        return false
    outText = strings.ConcatStr(strings.SliceBytes(text, pos, n), "")
    var next = pos + n
    if next >= text.len || text[next] != ';':
        return false
    outPos = next + 1
    return true

@borrows
fn BrowserSyncDecode(text: str, msg: var BrowserSyncMessage): bool =
    msg = BrowserSyncInitMessage()
    if text.len < 5:
        return false
    if !strings.StrContains(text, BrowserSyncMagic):
        return false
    if text[0] != 'C' || text[1] != 'L' || text[2] != 'B' || text[3] != '1' || text[4] != ';':
        return false
    var pos: int32 = 5
    var kind64: int64
    if !BrowserSyncReadDecimal(text, pos, pos, kind64):
        return false
    let kind = int32(kind64)
    if kind != BrowserSyncKindNavigate && kind != BrowserSyncKindInput && kind != BrowserSyncKindLoadComplete:
        return false
    var epoch64: int64
    if !BrowserSyncReadDecimal(text, pos, pos, epoch64):
        return false
    var urlLen64: int64
    if !BrowserSyncReadDecimal(text, pos, pos, urlLen64):
        return false
    var url: str
    if !BrowserSyncReadExact(text, pos, int32(urlLen64), pos, url):
        return false
    var fieldLen64: int64
    if !BrowserSyncReadDecimal(text, pos, pos, fieldLen64):
        return false
    var fieldId: str
    if !BrowserSyncReadExact(text, pos, int32(fieldLen64), pos, fieldId):
        return false
    var valueLen64: int64
    if !BrowserSyncReadDecimal(text, pos, pos, valueLen64):
        return false
    var value: str
    if !BrowserSyncReadExact(text, pos, int32(valueLen64), pos, value):
        return false
    var parseMs: int64
    if !BrowserSyncReadDecimal(text, pos, pos, parseMs):
        return false
    var layoutMs: int64
    if !BrowserSyncReadDecimal(text, pos, pos, layoutMs):
        return false
    var paintMs: int64
    if !BrowserSyncReadDecimal(text, pos, pos, paintMs):
        return false
    msg.kind = kind
    msg.url = url
    msg.fieldId = fieldId
    msg.value = value
    msg.epoch = int32(epoch64)
    msg.parseMs = parseMs
    msg.layoutMs = layoutMs
    msg.paintMs = paintMs
    return true

@borrows
fn BrowserSyncNavigate(url: str, epoch: int32): BrowserSyncMessage =
    var msg = BrowserSyncInitMessage()
    msg.kind = BrowserSyncKindNavigate
    msg.url = strings.ConcatStr(url, "")
    msg.epoch = epoch
    return msg

@borrows
fn BrowserSyncInput(fieldId: str, value: str, url: str, epoch: int32): BrowserSyncMessage =
    var msg = BrowserSyncInitMessage()
    msg.kind = BrowserSyncKindInput
    msg.fieldId = strings.ConcatStr(fieldId, "")
    msg.value = strings.ConcatStr(value, "")
    msg.url = strings.ConcatStr(url, "")
    msg.epoch = epoch
    return msg

@borrows
fn BrowserSyncLoadComplete(url: str, epoch: int32, parseMs: int64, layoutMs: int64, paintMs: int64): BrowserSyncMessage =
    var msg = BrowserSyncInitMessage()
    msg.kind = BrowserSyncKindLoadComplete
    msg.url = strings.ConcatStr(url, "")
    msg.epoch = epoch
    msg.parseMs = parseMs
    msg.layoutMs = layoutMs
    msg.paintMs = paintMs
    return msg
