@exportc("cheng_libp2p_browser_paint_kind_at")
fn cheng_libp2p_browser_paint_kind_at(index: int32): int32 =
    BrowserHostEnsure()
    if !BrowserHostPaintPick(index):
        return 0
    if HostPaintUseOverlay:
        return BrowserHostSession.overlayOps[HostPaintLocal].kind
    return BrowserHostSession.ops[HostPaintLocal].kind

