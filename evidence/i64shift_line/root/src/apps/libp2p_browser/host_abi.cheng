@exportc("cheng_libp2p_browser_capture_script_byte")
fn cheng_libp2p_browser_capture_script_byte(index: int32): int32 =
    BrowserHostEnsure()
    let script = BrowserCaptureScriptEnsure()
    if index < 0 || index >= script.len:
        return 0
    return int32(script[index])

