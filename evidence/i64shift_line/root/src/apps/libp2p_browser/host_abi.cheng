var HostPaintUseOverlay: bool
var HostPaintLocal: int32

fn BrowserHostPaintTotal(): int32 =
    return BrowserHostSession.ops.len + BrowserHostSession.overlayOps.len

fn BrowserHostPaintPick(index: int32): bool =
    HostPaintUseOverlay = false
    HostPaintLocal = 0
    if index < 0:
        return false
    if index < BrowserHostSession.ops.len:
        HostPaintLocal = index
        return true
    let j = index - BrowserHostSession.ops.len
    if j < 0 || j >= BrowserHostSession.overlayOps.len:
        return false
    HostPaintUseOverlay = true
    HostPaintLocal = j
    return true

@exportc("cheng_libp2p_browser_paint_count")
fn cheng_libp2p_browser_paint_count(): int32 =
    BrowserHostEnsure()
    return BrowserHostPaintTotal()

