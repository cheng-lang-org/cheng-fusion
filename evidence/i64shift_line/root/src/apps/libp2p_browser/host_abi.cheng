var BrowserCaptureScript: str
var BrowserCaptureScriptReady: bool = false

@importc("cheng_browser_http_get")
fn cheng_browser_http_get(urlRaw: ptr, urlLen: int64): int32
@importc("cheng_browser_http_status")
fn cheng_browser_http_status(): int32
@importc("cheng_browser_http_body_len")
fn cheng_browser_http_body_len(): int32
@importc("cheng_browser_http_body_byte")
fn cheng_browser_http_body_byte(index: int32): int32
@importc("cheng_browser_http_body_ptr")
fn cheng_browser_http_body_ptr(): ptr

var BrowserHostSession: sess.BrowserSession
var BrowserHostInited: bool

fn BrowserHostCopyRawText(raw: ptr, rawLen: int64): str =
    if raw == nil || rawLen <= int64(0):
        return ""
    if rawLen > int64(2147483647):
        return ""
    return rawbytes.BytesToString(rawbytes.BytesView(raw, int32(rawLen)))

@borrows
fn BrowserHostFetch(url: str, body: var str): bool =
    body = ""
    if url.len <= 0:
        return false
    let p = system.StrDataPtr(url)
    if p == nil:
        return false
    if cheng_browser_http_get(p, int64(url.len)) != 0:
        return false
    let st = cheng_browser_http_status()
    if st < 200 || st >= 300:
        return false
    let n = cheng_browser_http_body_len()
    if n <= 0:
        return true
    let raw = cheng_browser_http_body_ptr()
    if raw == nil:
        return false
    body = strings.ConcatStr(rawbytes.BytesToString(rawbytes.BytesView(raw, n)), "")
    return true

@borrows
fn BrowserHostLoadExtraCss(baseUrl: str, html: str): str =
    var document: web.WebDocument
    if !htmlparse.HtmlParseDocument(html, document):
        return ""
    var css = htmlparse.HtmlParseCss()
    let links = htmlparse.HtmlParseLinks()
    var pos: int32 = 0
    while pos < links.len:
        var lineEnd = pos
        while lineEnd < links.len && links[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        let href = htmlparse.HtmlSlice(links, pos, lineEnd)
        if href.len > 0:
            let abs = compile.BrowserResolveUrl(baseUrl, href)
            var sheet: str
            if BrowserHostFetch(abs, sheet) && sheet.len > 0:
                if css.len > 0:
                    css = strings.ConcatStr(css, strings.ConcatStr("\n", sheet))
                else:
                    css = sheet
        if lineEnd < links.len:
            pos = lineEnd + 1
        else:
            pos = links.len
    return css

fn BrowserCaptureScriptEnsure(): str =
    if !BrowserCaptureScriptReady:
        BrowserCaptureScript = snapscript.BrowserSnapshotCaptureScript()
        BrowserCaptureScriptReady = true
    return BrowserCaptureScript

fn BrowserHostEnsure(): int32 =
    if BrowserHostInited:
        return 0
    BrowserHostSession = sess.BrowserSessionInit("cheng-browser", 640, 720)
    BrowserHostInited = true
    BrowserCaptureScriptEnsure()
    return 0

@exportc("cheng_libp2p_browser_init")
fn cheng_libp2p_browser_init(selfPeerRaw: ptr, selfPeerLen: int64, viewportW: int32, viewportH: int32): int32 =
    let peer = BrowserHostCopyRawText(selfPeerRaw, selfPeerLen)
    var vw = viewportW
    var vh = viewportH
    if vw <= 0:
        vw = 640
    if vh <= 0:
        vh = 720
    BrowserHostSession = sess.BrowserSessionInit(peer, vw, vh)
    BrowserHostInited = true
    return 0

@exportc("cheng_libp2p_browser_begin_load")
fn cheng_libp2p_browser_begin_load(urlRaw: ptr, urlLen: int64): int32 =
    BrowserHostEnsure()
    let url = BrowserHostCopyRawText(urlRaw, urlLen)
    if url.len <= 0:
        return -1
    sess.BrowserSessionBeginLoad(BrowserHostSession, url)
    return 0

@exportc("cheng_libp2p_browser_on_load_complete")
fn cheng_libp2p_browser_on_load_complete(htmlRaw: ptr, htmlLen: int64): int32 =
    BrowserHostEnsure()
    let html = BrowserHostCopyRawText(htmlRaw, htmlLen)
    if !sess.BrowserSessionOnLoadComplete(BrowserHostSession, html):
        return -1
    return 0

@exportc("cheng_libp2p_browser_on_page_loaded")
fn cheng_libp2p_browser_on_page_loaded(urlRaw: ptr, urlLen: int64, htmlRaw: ptr, htmlLen: int64): int32 =
    BrowserHostEnsure()
    let url = BrowserHostCopyRawText(urlRaw, urlLen)
    let html = BrowserHostCopyRawText(htmlRaw, htmlLen)
    if !sess.BrowserSessionOnPageLoaded(BrowserHostSession, url, html):
        return -1
    return 0

@exportc("cheng_libp2p_browser_on_url_loaded")
fn cheng_libp2p_browser_on_url_loaded(urlRaw: ptr, urlLen: int64): int32 =
    BrowserHostEnsure()
    let url = BrowserHostCopyRawText(urlRaw, urlLen)
    if url.len <= 0:
        return -1
    var html: str
    if !BrowserHostFetch(url, html):
        return -1
    BrowserHostSession.extraCss = BrowserHostLoadExtraCss(url, html)
    if !sess.BrowserSessionOnPageLoaded(BrowserHostSession, url, html):
        return -1
    return 0

