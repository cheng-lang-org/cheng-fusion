@exportc("cheng_libp2p_browser_cuse_command")
fn cheng_libp2p_browser_cuse_command(textRaw: ptr, textLen: int64, effectRaw: ptr, effectLen: int64, confirmed: int32): int32 =
    BrowserHostEnsure()
    let text = BrowserHostCopyRawText(textRaw, textLen)
    let effectClass = BrowserHostCopyRawText(effectRaw, effectLen)
    var err: str = ""
    return cmdu.BrowserCuseCommand(BrowserHostSession, text, effectClass, confirmed != 0, err)

@exportc("cheng_libp2p_browser_cuse_action")
fn cheng_libp2p_browser_cuse_action(ctlId: int32, actionRaw: ptr, actionLen: int64, payloadRaw: ptr, payloadLen: int64, effectRaw: ptr, effectLen: int64, confirmed: int32): int32 =
    BrowserHostEnsure()
    let actionKind = BrowserHostCopyRawText(actionRaw, actionLen)
    let payload = BrowserHostCopyRawText(payloadRaw, payloadLen)
    let effectClass = BrowserHostCopyRawText(effectRaw, effectLen)
    var err: str = ""
    let rc = cuse.BrowserCuseAction(BrowserHostSession, ctlId, actionKind, payload, effectClass, confirmed != 0, err)
    return rc

# 08 凭证化确认入口: 确认类动作唯一生产通路。credentialRow 是确认凭证表行
# 句柄 (int32 索引, 来自确认签发回执), 不引入任何裸指针/地址 ABI; 文本
# 实参照既有 (ptr,len)->深拷贝配方落地为自有 str, 返回码同 cuse_action
# (-7 只会出现在布尔面)。
@exportc("cheng_libp2p_browser_cuse_action_cred")
fn cheng_libp2p_browser_cuse_action_cred(ctlId: int32, actionRaw: ptr, actionLen: int64, payloadRaw: ptr, payloadLen: int64, effectRaw: ptr, effectLen: int64, credentialRow: int32): int32 =
    BrowserHostEnsure()
    let actionKind = BrowserHostCopyRawText(actionRaw, actionLen)
    let payload = BrowserHostCopyRawText(payloadRaw, payloadLen)
    let effectClass = BrowserHostCopyRawText(effectRaw, effectLen)
    var err: str = ""
    let rc = cuse.BrowserCuseActionWithCredential(BrowserHostSession, ctlId, actionKind, payload, effectClass, credentialRow, err)
    return rc

