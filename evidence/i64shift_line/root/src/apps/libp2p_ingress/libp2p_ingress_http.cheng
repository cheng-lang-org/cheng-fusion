import std/result
import std/rawbytes
import std/strings
import std/strutils as strutil
import std/cmdline
import std/os
import std/times
import std/net/transports/tcp_syscall as tcp
import std/crypto/sha1

const
    Libp2pIngressDefaultTurnPort: int32 = 3478
    Libp2pIngressDefaultTurnRealm: str = "unimaker.fun"
    Libp2pIngressDefaultTurnCredentialTtlSec: int32 = 600
    Libp2pIngressDefaultListenHost: str = "127.0.0.1"
    Libp2pIngressDefaultListenPort: int32 = 4187
    Libp2pIngressHttpReadMaxChars: int32 = 65536
    Libp2pIngressHttpReadChunks: int32 = 32
    Libp2pIngressSha1BlockSize: int32 = 64
    Libp2pIngressBase64Alphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

type
    Libp2pIngressConfig =
        turnPublicHost: str
        turnPublicHosts: str[]
        turnPort: int32 = 3478
        turnSharedSecret: str
        turnRealm: str = "unimaker.fun"
        turnCredentialTtlSec: int32 = 600
        turnRelayOnly: bool
        listenHost: str = "127.0.0.1"
        listenPort: int32 = 4187
        maxRequests: int32

    Libp2pIngressHttpResponse =
        statusCode: int32
        reason: str
        contentType: str = "application/json; charset=utf-8"
        body: str

fn Libp2pIngressConfigInit(): Libp2pIngressConfig =
    var out: Libp2pIngressConfig
    out.turnPublicHosts = []
    return out

fn Libp2pIngressCat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

fn Libp2pIngressCat3(a: str, b: str, c: str): str =
    return strings.ConcatStr(strings.ConcatStr(a, b), c)

fn Libp2pIngressCat4(a: str, b: str, c: str, d: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(a, b), c), d)

fn Libp2pIngressCat5(a: str, b: str, c: str, d: str, e: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(a, b), c), d), e)

fn Libp2pIngressCat6(a: str, b: str, c: str, d: str, e: str, f: str): str =
    return strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(strings.ConcatStr(a, b), c), d), e), f)

fn Libp2pIngressFindChar(text: str, needle: char, start: int32): int32 =
    let n: int32 = len(text)
    var i: int32 = start
    while i < n:
        if text[i] == needle:
            return i
        i = i + 1
    return -1

fn Libp2pIngressFindSub(text: str, needle: str): int32 =
    let n: int32 = len(text)
    let m: int32 = len(needle)
    if m <= 0:
        return 0
    if m > n:
        return -1
    var i: int32
    while i + m <= n:
        var matched = true
        for j in 0..<m:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return i
        i = i + 1
    return -1

fn Libp2pIngressJsonQuote(text: str): str =
    var out = "\""
    for i in 0..<len(text):
        let ch: char = text[i]
        if ch == '"':
            out = Libp2pIngressCat(out, "\\\"")
        elif ch == '\\':
            out = Libp2pIngressCat(out, "\\\\")
        elif ch == '\n':
            out = Libp2pIngressCat(out, "\\n")
        elif ch == '\r':
            out = Libp2pIngressCat(out, "\\r")
        elif ch == '\t':
            out = Libp2pIngressCat(out, "\\t")
        else:
            out = Libp2pIngressCat(out, strings.SliceBytes(text, i, 1))
    return Libp2pIngressCat(out, "\"")

fn Libp2pIngressJsonBool(value: bool): str =
    return value ? "true" : "false"

fn Libp2pIngressJsonStringArray(items: str[]): str =
    var out = "["
    for i in 0..<items.len:
        if i > 0:
            out = Libp2pIngressCat(out, ",")
        out = Libp2pIngressCat(out, Libp2pIngressJsonQuote(items[i]))
    return Libp2pIngressCat(out, "]")

fn Libp2pIngressStringSeen(items: str[], value: str): bool =
    for i in 0..<items.len:
        if items[i] == value:
            return true
    return false

fn Libp2pIngressAppendUniqueNonEmpty(items: str[], valueRaw: str): str[] =
    var out: str[] = items
    let value: str = strutil.Strip(valueRaw)
    if len(value) <= 0:
        return out
    if Libp2pIngressStringSeen(out, value):
        return out
    add(out, value)
    return out

fn Libp2pIngressSplitCsv(value: str): str[] =
    var out: str[]
    out = []
    var start: int32
    var i: int32
    while i < len(value):
        if value[i] == ',':
            let item: str = strings.SliceBytes(value, start, i - start)
            out = Libp2pIngressAppendUniqueNonEmpty(out, item)
            start = i + 1
        i = i + 1
    if start <= len(value):
        let item: str = strings.SliceBytes(value, start, len(value) - start)
        out = Libp2pIngressAppendUniqueNonEmpty(out, item)
    return out

fn Libp2pIngressSplitCsvInto(value: str, out: var str[]) =
    out = Libp2pIngressSplitCsv(value)

fn Libp2pIngressPoolHosts(config: var Libp2pIngressConfig): str[] =
    var out: str[]
    out = []
    for i in 0..<config.turnPublicHosts.len:
        out = Libp2pIngressAppendUniqueNonEmpty(out, config.turnPublicHosts[i])
    out = Libp2pIngressAppendUniqueNonEmpty(out, config.turnPublicHost)
    return out

fn Libp2pIngressSanitizeTurnUser(value: str): str =
    var out: str
    for i in 0..<len(value):
        if len(out) >= 48:
            break
        let ch: char = value[i]
        let isAlpha = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
        let isDigit = ch >= '0' && ch <= '9'
        let isMark = ch == '_' || ch == '.' || ch == ':' || ch == '@' || ch == '-'
        if isAlpha || isDigit || isMark:
            out = Libp2pIngressCat(out, strings.SliceBytes(value, i, 1))
    if len(strutil.Strip(out)) <= 0:
        return "anon"
    return out

fn Libp2pIngressHmacSha1(secret: str, message: str): Bytes =
    var keyBlock: Bytes = BytesFromString(secret)
    if BytesLen(keyBlock) > Libp2pIngressSha1BlockSize:
        keyBlock = sha1.sha1Digest(keyBlock)
    let keyLen: int32 = BytesLen(keyBlock)
    let data: Bytes = BytesFromString(message)
    let dataLen: int32 = BytesLen(data)
    let innerInput: Bytes = BytesAlloc(Libp2pIngressSha1BlockSize + dataLen)
    for i in 0..<Libp2pIngressSha1BlockSize:
        let keyByte: int32 = if i < keyLen: BytesGet(keyBlock, i) else: 0
        BytesSet(innerInput, i, keyByte ^ 0x36)
    for i in 0..<dataLen:
        BytesSet(innerInput, Libp2pIngressSha1BlockSize + i, BytesGet(data, i))
    let inner: Bytes = sha1.sha1Digest(innerInput)
    let outerLen: int32 = BytesLen(inner)
    let outerInput: Bytes = BytesAlloc(Libp2pIngressSha1BlockSize + outerLen)
    for i in 0..<Libp2pIngressSha1BlockSize:
        let keyByte: int32 = if i < keyLen: BytesGet(keyBlock, i) else: 0
        BytesSet(outerInput, i, keyByte ^ 0x5c)
    for i in 0..<outerLen:
        BytesSet(outerInput, Libp2pIngressSha1BlockSize + i, BytesGet(inner, i))
    return sha1.sha1Digest(outerInput)

fn Libp2pIngressHmacSha1Base64(secret: str, message: str): str =
    return Libp2pIngressBase64Encode(Libp2pIngressHmacSha1(secret, message))

fn Libp2pIngressBase64Char(idx: int32): str =
    return strings.SliceBytes(Libp2pIngressBase64Alphabet, idx & 63, 1)

fn Libp2pIngressBase64Encode(data: Bytes): str =
    let n: int32 = BytesLen(data)
    if n <= 0:
        return ""
    var out: str
    var i: int32
    while i < n:
        let b0: int32 = BytesGet(data, i)
        let b1: int32 = if i + 1 < n: BytesGet(data, i + 1) else: 0
        let b2: int32 = if i + 2 < n: BytesGet(data, i + 2) else: 0
        let triple: int32 = (b0 << 16) | (b1 << 8) | b2
        out = Libp2pIngressCat(out, Libp2pIngressBase64Char((triple >> 18) & 63))
        out = Libp2pIngressCat(out, Libp2pIngressBase64Char((triple >> 12) & 63))
        if i + 1 < n:
            out = Libp2pIngressCat(out, Libp2pIngressBase64Char((triple >> 6) & 63))
        else:
            out = Libp2pIngressCat(out, "=")
        if i + 2 < n:
            out = Libp2pIngressCat(out, Libp2pIngressBase64Char(triple & 63))
        else:
            out = Libp2pIngressCat(out, "=")
        i = i + 3
    return out

fn Libp2pIngressCredentialTtl(config: var Libp2pIngressConfig): int32 =
    if config.turnCredentialTtlSec < 60:
        return 60
    return config.turnCredentialTtlSec

fn Libp2pIngressBuildStunUrls(hosts: str[], port: int32): str[] =
    var out: str[]
    for i in 0..<hosts.len:
        add(out, Libp2pIngressCat4("stun:", hosts[i], ":", IntToStr(port)))
    return out

fn Libp2pIngressBuildTurnUrls(hosts: str[], port: int32): str[] =
    var out: str[]
    for i in 0..<hosts.len:
        add(out, Libp2pIngressCat5("turn:", hosts[i], ":", IntToStr(port), "?transport=udp"))
        add(out, Libp2pIngressCat5("turn:", hosts[i], ":", IntToStr(port), "?transport=tcp"))
    return out

fn Libp2pIngressTurnServersJson(turnUrls: str[], username: str, credential: str): str =
    var out = "["
    for i in 0..<turnUrls.len:
        if i > 0:
            out = Libp2pIngressCat(out, ",")
        out = Libp2pIngressCat3(out, "{\"url\":", Libp2pIngressJsonQuote(turnUrls[i]))
        out = Libp2pIngressCat3(out, ",\"username\":", Libp2pIngressJsonQuote(username))
        out = Libp2pIngressCat3(out, ",\"credential\":", Libp2pIngressJsonQuote(credential))
        out = Libp2pIngressCat(out, "}")
    return Libp2pIngressCat(out, "]")

fn Libp2pIngressIceServersJson(stunUrls: str[], turnUrls: str[], username: str, credential: str): str =
    var out = "["
    var count: int32
    if stunUrls.len > 0:
        out = Libp2pIngressCat4(out, "{\"urls\":", Libp2pIngressJsonStringArray(stunUrls), "}")
        count = count + 1
    for i in 0..<turnUrls.len:
        if count > 0:
            out = Libp2pIngressCat(out, ",")
        out = Libp2pIngressCat4(out, "{\"urls\":[", Libp2pIngressJsonQuote(turnUrls[i]), "]")
        out = Libp2pIngressCat3(out, ",\"username\":", Libp2pIngressJsonQuote(username))
        out = Libp2pIngressCat3(out, ",\"credential\":", Libp2pIngressJsonQuote(credential))
        out = Libp2pIngressCat(out, "}")
        count = count + 1
    return Libp2pIngressCat(out, "]")

fn Libp2pIngressIceConfigured(config: var Libp2pIngressConfig): bool =
    if len(strutil.Strip(config.turnSharedSecret)) <= 0:
        return false
    let hosts = Libp2pIngressPoolHosts(config)
    return hosts.len > 0 && config.turnPort > 0

fn Libp2pIngressBuildIceConfigJson(config: var Libp2pIngressConfig,
                                     peerId: str,
                                     nowSeconds: int64): Result[str] =
    if !Libp2pIngressIceConfigured(config):
        return Err[str]("webrtc_ice_not_configured")
    let hosts = Libp2pIngressPoolHosts(config)
    let ttl: int32 = Libp2pIngressCredentialTtl(config)
    let expiry: int64 = nowSeconds + Int64(ttl)
    let username: str = Libp2pIngressCat3(strings.Int64ToStr(expiry), ":", Libp2pIngressSanitizeTurnUser(peerId))
    let credential: str = Libp2pIngressHmacSha1Base64(config.turnSharedSecret, username)
    let stunUrls = Libp2pIngressBuildStunUrls(hosts, config.turnPort)
    let turnUrls = Libp2pIngressBuildTurnUrls(hosts, config.turnPort)
    var realm = config.turnRealm
    if len(strutil.Strip(realm)) <= 0:
        realm = Libp2pIngressDefaultTurnRealm
    var body = "{\"ok\":true"
    body = Libp2pIngressCat3(body, ",\"relayOnly\":", Libp2pIngressJsonBool(config.turnRelayOnly))
    body = Libp2pIngressCat3(body, ",\"realm\":", Libp2pIngressJsonQuote(realm))
    body = Libp2pIngressCat3(body, ",\"ttlSeconds\":", IntToStr(ttl))
    body = Libp2pIngressCat3(body, ",\"expiresAt\":", strings.Int64ToStr(expiry))
    body = Libp2pIngressCat3(body, ",\"poolHosts\":", Libp2pIngressJsonStringArray(hosts))
    body = Libp2pIngressCat3(body, ",\"stunUrls\":", Libp2pIngressJsonStringArray(stunUrls))
    body = Libp2pIngressCat3(body, ",\"turnServers\":", Libp2pIngressTurnServersJson(turnUrls, username, credential))
    body = Libp2pIngressCat3(body, ",\"iceServers\":", Libp2pIngressIceServersJson(stunUrls, turnUrls, username, credential))
    body = Libp2pIngressCat(body, "}")
    return Ok[str](body)

fn Libp2pIngressJsonResponse(statusCode: int32,
                               reason: str,
                               body: str): Libp2pIngressHttpResponse =
    var out: Libp2pIngressHttpResponse
    out.statusCode = statusCode
    out.reason = reason
    out.contentType = "application/json; charset=utf-8"
    out.body = body
    return out

fn Libp2pIngressErrorJson(error: str): str =
    return Libp2pIngressCat3("{\"ok\":false,\"error\":", Libp2pIngressJsonQuote(error), "}")

fn Libp2pIngressParseRequestLine(requestText: str,
                                   outMethod: var str,
                                   outTarget: var str): bool =
    let lineEnd: int32 = Libp2pIngressFindSub(requestText, "\r\n")
    if lineEnd <= 0:
        return false
    let line: str = strings.SliceBytes(requestText, 0, lineEnd)
    let firstSpace: int32 = Libp2pIngressFindChar(line, char(32), 0)
    if firstSpace <= 0:
        return false
    let secondSpace: int32 = Libp2pIngressFindChar(line, char(32), firstSpace + 1)
    if secondSpace <= firstSpace + 1:
        return false
    outMethod = strutil.Strip(strings.SliceBytes(line, 0, firstSpace))
    outTarget = strutil.Strip(strings.SliceBytes(line, firstSpace + 1, secondSpace - firstSpace - 1))
    return len(outMethod) > 0 && len(outTarget) > 0

fn Libp2pIngressSplitTarget(target: str,
                              outPath: var str,
                              outQuery: var str) =
    let q: int32 = Libp2pIngressFindChar(target, '?', 0)
    if q < 0:
        outPath = target
        outQuery = ""
        return
    outPath = strings.SliceBytes(target, 0, q)
    outQuery = strings.SliceBytes(target, q + 1, len(target) - q - 1)

fn Libp2pIngressQueryValue(query: str, key: str): str =
    var start: int32
    while start < len(query):
        var stop: int32 = Libp2pIngressFindChar(query, '&', start)
        if stop < 0:
            stop = len(query)
        let item: str = strings.SliceBytes(query, start, stop - start)
        let eq: int32 = Libp2pIngressFindChar(item, '=', 0)
        if eq > 0:
            let itemKey: str = strings.SliceBytes(item, 0, eq)
            if itemKey == key:
                return strings.SliceBytes(item, eq + 1, len(item) - eq - 1)
        start = stop + 1
    return ""

fn Libp2pIngressHandleRequestText(config: var Libp2pIngressConfig,
                                    requestText: str,
                                    nowSeconds: int64): Libp2pIngressHttpResponse =
    var method: str
    var target: str
    if !Libp2pIngressParseRequestLine(requestText, method, target):
        return Libp2pIngressJsonResponse(400, "Bad Request", Libp2pIngressErrorJson("bad_request"))
    if method != "GET":
        return Libp2pIngressJsonResponse(405, "Method Not Allowed", Libp2pIngressErrorJson("method_not_allowed"))
    var path: str
    var query: str
    Libp2pIngressSplitTarget(target, path, query)
    if path == "/healthz":
        return Libp2pIngressJsonResponse(200, "OK", "{\"ok\":true,\"service\":\"cheng_libp2p_ingress\"}")
    if path == "/readyz":
        if Libp2pIngressIceConfigured(config):
            return Libp2pIngressJsonResponse(200, "OK", "{\"ok\":true,\"service\":\"cheng_libp2p_ingress\",\"iceConfigured\":true}")
        return Libp2pIngressJsonResponse(503, "Service Unavailable", Libp2pIngressErrorJson("webrtc_ice_not_configured"))
    if path == "/v1/libp2p/webrtc/ice-config":
        let peerId: str = Libp2pIngressQueryValue(query, "peerId")
        let bodyRes: Result[str] = Libp2pIngressBuildIceConfigJson(config, peerId, nowSeconds)
        if IsErr(bodyRes):
            return Libp2pIngressJsonResponse(503, "Service Unavailable", Libp2pIngressErrorJson(Error(bodyRes)))
        return Libp2pIngressJsonResponse(200, "OK", Value(bodyRes))
    return Libp2pIngressJsonResponse(404, "Not Found", Libp2pIngressErrorJson("not_found"))

fn Libp2pIngressHttpResponseWire(response: Libp2pIngressHttpResponse): str =
    var out = Libp2pIngressCat5("HTTP/1.1 ", IntToStr(response.statusCode), " ", response.reason, "\r\n")
    out = Libp2pIngressCat4(out, "Content-Type: ", response.contentType, "\r\n")
    out = Libp2pIngressCat(out, "Cache-Control: no-store\r\n")
    out = Libp2pIngressCat4(out, "Content-Length: ", IntToStr(len(response.body)), "\r\n")
    out = Libp2pIngressCat(out, "Connection: close\r\n\r\n")
    return Libp2pIngressCat(out, response.body)

fn Libp2pIngressReadHttpRequest(conn: var tcp.TcpConnectionHandle): Result[str] =
    var requestText: str
    for _ in 0..<Libp2pIngressHttpReadChunks:
        let readRes: Result[Bytes] = tcp.TcpRecv(conn, 4096)
        if IsErr(readRes):
            return Err[str](Error(readRes))
        let chunk: Bytes = Value(readRes)
        if BytesLen(chunk) <= 0:
            break
        requestText = Libp2pIngressCat(requestText, BytesToString(chunk))
        if len(requestText) > Libp2pIngressHttpReadMaxChars:
            return Err[str]("libp2p ingress: http request too large")
        if Libp2pIngressFindSub(requestText, "\r\n\r\n") >= 0:
            return Ok[str](requestText)
    return Err[str]("libp2p ingress: incomplete http request")

fn Libp2pIngressServeConnection(config: var Libp2pIngressConfig,
                                 conn: var tcp.TcpConnectionHandle) =
    let readRes: Result[str] = Libp2pIngressReadHttpRequest(conn)
    if IsErr(readRes):
        let response = Libp2pIngressJsonResponse(400, "Bad Request", Libp2pIngressErrorJson(Error(readRes)))
        let _ = tcp.TcpSend(conn, BytesFromString(Libp2pIngressHttpResponseWire(response)))
        return
    let response = Libp2pIngressHandleRequestText(config, Value(readRes), times.EpochTimeSeconds())
    let _ = tcp.TcpSend(conn, BytesFromString(Libp2pIngressHttpResponseWire(response)))

fn Libp2pIngressServe(config: var Libp2pIngressConfig): int32 =
    let listenRes: Result[tcp.TcpListenerHandle] = tcp.TcpListen(config.listenHost,
                                                                  config.listenPort,
                                                                  strings.StrContains(config.listenHost, ":"))
    if IsErr(listenRes):
        os.WriteLine(os.Get_stderr(), Error(listenRes))
        return 1
    var listener: tcp.TcpListenerHandle = Value(listenRes)
    os.WriteLine(os.Get_stdout(), Libp2pIngressCat4("cheng libp2p ingress listening ", config.listenHost, ":", IntToStr(listener.addr.port)))
    var served: int32
    while config.maxRequests <= 0 || served < config.maxRequests:
        var conn: tcp.TcpConnectionHandle
        conn.localAddr = listener.addr
        if !tcp.TcpAcceptFdInto(listener.fd, conn):
            os.WriteLine(os.Get_stderr(), "tcp syscall: accept failed")
            tcp.TcpListenerClose(listener)
            return 1
        Libp2pIngressServeConnection(config, conn)
        tcp.TcpClose(conn)
        served = served + 1
    tcp.TcpListenerClose(listener)
    return 0

fn Libp2pIngressReadFlagOrEnv(flag: str, envKey: str, defaultValue: str): str =
    var value: str
    if cmdline.readLastFlagValue(flag, value):
        return value
    return os.GetEnvDefault(envKey, defaultValue)

fn Libp2pIngressReadIntFlagOrEnv(flag: str, envKey: str, defaultValue: int32): int32 =
    let raw: str = Libp2pIngressReadFlagOrEnv(flag, envKey, "")
    if len(strutil.Strip(raw)) <= 0:
        return defaultValue
    var out: int32
    if cmdline.parseInt32(raw, out):
        return out
    return defaultValue

fn Libp2pIngressReadBoolFlagOrEnv(flag: str, envKey: str): bool =
    let raw: str = Libp2pIngressReadFlagOrEnv(flag, envKey, "")
    var out: bool
    if cmdline.parseBool(raw, out):
        return out
    return false

fn Libp2pIngressConfigFromEnvAndArgs(): Libp2pIngressConfig =
    var out = Libp2pIngressConfigInit()
    out.turnPublicHost = Libp2pIngressReadFlagOrEnv("--turn-public-host",
                                                     "LIBP2P_INGRESS_TURN_PUBLIC_HOST",
                                                     "")
    let hostsCsv: str = Libp2pIngressReadFlagOrEnv("--turn-public-hosts",
                                                    "LIBP2P_INGRESS_TURN_PUBLIC_HOSTS",
                                                    "")
    Libp2pIngressSplitCsvInto(hostsCsv, out.turnPublicHosts)
    out.turnPort = Libp2pIngressReadIntFlagOrEnv("--turn-port",
                                                  "LIBP2P_INGRESS_TURN_PORT",
                                                  Libp2pIngressDefaultTurnPort)
    out.turnSharedSecret = Libp2pIngressReadFlagOrEnv("--turn-shared-secret",
                                                       "LIBP2P_INGRESS_TURN_SHARED_SECRET",
                                                       "")
    out.turnRealm = Libp2pIngressReadFlagOrEnv("--turn-realm",
                                                "LIBP2P_INGRESS_TURN_REALM",
                                                Libp2pIngressDefaultTurnRealm)
    out.turnCredentialTtlSec = Libp2pIngressReadIntFlagOrEnv("--turn-ttl-sec",
                                                              "LIBP2P_INGRESS_TURN_CREDENTIAL_TTL_SEC",
                                                              Libp2pIngressDefaultTurnCredentialTtlSec)
    out.turnRelayOnly = Libp2pIngressReadBoolFlagOrEnv("--turn-relay-only",
                                                        "LIBP2P_INGRESS_TURN_RELAY_ONLY")
    out.listenHost = Libp2pIngressReadFlagOrEnv("--host",
                                                 "LIBP2P_INGRESS_LISTEN_HOST",
                                                 Libp2pIngressDefaultListenHost)
    out.listenPort = Libp2pIngressReadIntFlagOrEnv("--port",
                                                    "LIBP2P_INGRESS_LISTEN_PORT",
                                                    Libp2pIngressDefaultListenPort)
    out.maxRequests = Libp2pIngressReadIntFlagOrEnv("--max-requests",
                                                     "LIBP2P_INGRESS_MAX_REQUESTS",
                                                     0)
    return out

fn Libp2pIngressMain(): int32 =
    var config: Libp2pIngressConfig = Libp2pIngressConfigFromEnvAndArgs()
    return Libp2pIngressServe(config)
