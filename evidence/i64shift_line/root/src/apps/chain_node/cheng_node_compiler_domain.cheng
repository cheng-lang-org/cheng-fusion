        return Err[str](Error(reqRes))
    let planRes = ChengNodeCompilerBuildPlan()
    if IsErr(planRes):
        return Err[str](Error(planRes))
    return cwlpnet.CompilerWorldFreshNodeSelfhostReport(ChengNodeCompilerRoot(),
                                                       Value(reqRes),
                                                       Value(planRes))

fn ChengNodeCompilerMigrationSemanticProofInto(
        outProof: var ceq.CompilerMigrationSemanticProof,
        outEvidence: var ceq.CompilerMigrationEvidence): Result[bool] =
    let evidenceTextRes = ChengNodeCompilerReadText(
        cmdline.readFlagOrDefault("--migration-evidence", ""))
    if IsErr(evidenceTextRes):
        return Err[bool](Error(evidenceTextRes))
    let baselineCsgRes = ChengNodeCompilerReadText(cmdline.readFlagOrDefault("--baseline-csg", ""))
    if IsErr(baselineCsgRes):
        return Err[bool](Error(baselineCsgRes))
    let migratedCsgRes = ChengNodeCompilerReadText(cmdline.readFlagOrDefault("--migrated-csg", ""))
    if IsErr(migratedCsgRes):
        return Err[bool](Error(migratedCsgRes))
    let baselineSurfaceRes = ChengNodeCompilerReadText(cmdline.readFlagOrDefault("--baseline-surface", ""))
    if IsErr(baselineSurfaceRes):
        return Err[bool](Error(baselineSurfaceRes))
    let migratedSurfaceRes = ChengNodeCompilerReadText(cmdline.readFlagOrDefault("--migrated-surface", ""))
    if IsErr(migratedSurfaceRes):
        return Err[bool](Error(migratedSurfaceRes))
    let baselineSemanticRes = ChengNodeCompilerReadText(
        cmdline.readFlagOrDefault("--baseline-semantic", ""))
    if IsErr(baselineSemanticRes):
        return Err[bool](Error(baselineSemanticRes))
    let migratedSemanticRes = ChengNodeCompilerReadText(
        cmdline.readFlagOrDefault("--migrated-semantic", ""))
    if IsErr(migratedSemanticRes):
        return Err[bool](Error(migratedSemanticRes))
    let packageIdRes = ChengNodeCompilerRequireFlag("--package")
    if IsErr(packageIdRes):
        return Err[bool](Error(packageIdRes))
    let targetTripleRes = ChengNodeCompilerRequireFlag("--target")
    if IsErr(targetTripleRes):
        return Err[bool](Error(targetTripleRes))
    let channelRaw = strutil.Strip(cmdline.readFlagOrDefault("--channel", "stable"))
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceFromReportText(
        Value(evidenceTextRes),
        evidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    let baselineGraphRes = ccsg.CompilerCsgCanonicalGraphCidFromReportText(
        Value(baselineCsgRes))
    if IsErr(baselineGraphRes):
        return Err[bool](Error(baselineGraphRes))
    let migratedGraphRes = ccsg.CompilerCsgCanonicalGraphCidFromReportText(
        Value(migratedCsgRes))
    if IsErr(migratedGraphRes):
        return Err[bool](Error(migratedGraphRes))
    var baselineSurface: ccsg.CsgExportSurface
    let baselineSurfaceParseRes = ccsg.CompilerExportSurfaceFromReportText(
        Value(baselineSurfaceRes),
        baselineSurface)
    if IsErr(baselineSurfaceParseRes):
        return Err[bool](Error(baselineSurfaceParseRes))
    var migratedSurface: ccsg.CsgExportSurface
    let migratedSurfaceParseRes = ccsg.CompilerExportSurfaceFromReportText(
        Value(migratedSurfaceRes),
        migratedSurface)
    if IsErr(migratedSurfaceParseRes):
        return Err[bool](Error(migratedSurfaceParseRes))
    var baselineSemantic: sexec.CompileSemanticReceipt
    let baselineSemanticParseRes =
        sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
            Value(baselineSemanticRes),
            baselineSemantic)
    if IsErr(baselineSemanticParseRes):
        return Err[bool](Error(baselineSemanticParseRes))
    var migratedSemantic: sexec.CompileSemanticReceipt
    let migratedSemanticParseRes =
        sexec.SystemLinkExecCompileSemanticReceiptFromReportText(
            Value(migratedSemanticRes),
            migratedSemantic)
    if IsErr(migratedSemanticParseRes):
        return Err[bool](Error(migratedSemanticParseRes))
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofMake(
        Value(packageIdRes),
        channelRaw,
        evidence,
        Value(baselineGraphRes),
        Value(migratedGraphRes),
        baselineSurface,
        migratedSurface,
        baselineSemantic,
        migratedSemantic,
        Value(targetTripleRes),
        proof)
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    outProof = proof
    outEvidence = evidence
    return Ok[bool](true)

fn ChengNodeCompilerMigrationSemanticProofText(): Result[str] =
    var proof: ceq.CompilerMigrationSemanticProof
    var evidence: ceq.CompilerMigrationEvidence
    let proofRes = ChengNodeCompilerMigrationSemanticProofInto(
        proof,
        evidence)
    if IsErr(proofRes):
        return Err[str](Error(proofRes))
    return Ok[str](ceq.CompilerMigrationSemanticProofReport(proof))

fn ChengNodeCompilerPublishCheckText(): Result[str] =
    var proof: ceq.CompilerMigrationSemanticProof
    var evidence: ceq.CompilerMigrationEvidence
    let proofRes = ChengNodeCompilerMigrationSemanticProofInto(
        proof,
        evidence)
    if IsErr(proofRes):
        return Err[str](Error(proofRes))
    let worldHeadCidRes = layout.FixedBytes32FromHex(cmdline.readFlagOrDefault("--world-head-cid", ""))
    if IsErr(worldHeadCidRes):
        return Err[str]("cheng_node compiler: invalid --world-head-cid")
    let channelRaw = strutil.Strip(cmdline.readFlagOrDefault("--channel", "stable"))
    var channel = ""
    var stableGateRequired = 0
    var equivalenceCheckedFlag = 0
    var equivalencePassed = 0
    var publishAllowed = 0
    var proofCid = layout.FixedBytes32()
    let decisionRes = cpub.CompilerPublishDecisionEvaluate(channelRaw,
                                                             Value(worldHeadCidRes),
                                                             true,
                                                             proof,
                                                             evidence,
                                                             channel,
                                                             stableGateRequired,
                                                             equivalenceCheckedFlag,
                                                             equivalencePassed,
                                                             publishAllowed,
                                                             proofCid)
    if IsErr(decisionRes):
        return Err[str](Error(decisionRes))
    return Ok[str](cpub.CompilerPublishDecisionReport(channel,
                                                        stableGateRequired,
                                                        equivalenceCheckedFlag,
                                                        equivalencePassed,
                                                        publishAllowed,
                                                        Value(worldHeadCidRes),
                                                        proofCid))

fn ChengNodeCompilerPrintForwardResult(subcmd: str,
                                         commandIndex: int32): int32 =
    let textRes = ChengNodeCompilerForwardSubcommandText(subcmd, commandIndex)
    if IsErr(textRes):
        echo(Error(textRes))
        return 1
    let text = Value(textRes)
    if len(text) > 0:
        echo(text)
    return 0

fn ChengNodeCompilerCommandAt(commandIndex: int32): int32 =
    let count = cmdline.ParamCount()
    if count < commandIndex:
        echo(ChengNodeCompilerUsageText())
        return 0
    let subcmd = cmdline.ParamStr(commandIndex)
    if subcmd == "--help" || subcmd == "-h" || subcmd == "help":
        echo(ChengNodeCompilerUsageText())
        return 0
    if subcmd == "surface":
        echo(ChengNodeCompilerSurfaceText())
        return 0
    if subcmd == "status":
        echo(ChengNodeCompilerStatusText())
        return 0
    if subcmd == "system-link-exec":
        let textRes = ChengNodeCompilerSystemLinkExecText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "debug-report":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "print-symbols":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "print-line-map":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "print-object":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "print-elf":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "print-asm":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "profile-run":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "profile-report":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "crash-report":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "print-build-plan":
        let textRes = ChengNodeCompilerBuildPlanText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "emit-csg":
        let textRes = ChengNodeCompilerCsgText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "migrate-csg":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "emit-surface":
        let textRes = ChengNodeCompilerSurfaceReportText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "emit-receipt":
        let textRes = ChengNodeCompilerReceiptText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "verify-world":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "world-sync":
        let textRes = ChengNodeCompilerWorldSyncText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "materialize-world-mirrors":
        let textRes = ChengNodeCompilerMaterializeWorldMirrorsText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "prove-migration":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "publish-world":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "fresh-node-selfhost":
        let textRes = ChengNodeCompilerFreshNodeSelfhostText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "follow-world":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "selfhost-build":
        return ChengNodeCompilerPrintForwardResult(subcmd, commandIndex)
    if subcmd == "prove-equivalence":
        let textRes = ChengNodeCompilerMigrationSemanticProofText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    if subcmd == "publish-check":
        let textRes = ChengNodeCompilerPublishCheckText()
        if IsErr(textRes):
            echo(Error(textRes))
            return 1
        echo(Value(textRes))
        return 0
    echo(ChengNodeCompilerUsageText())
    return 2
