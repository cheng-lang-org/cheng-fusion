fn ChengNodeCompilerWorldSyncText(): Result[str] =
    let sourcePathRes = ChengNodeCompilerRequireFlag("--in")
    if IsErr(sourcePathRes):
        return Err[str](Error(sourcePathRes))
    let outputPathRes = ChengNodeCompilerRequireFlag("--out")
    if IsErr(outputPathRes):
        return Err[str](Error(outputPathRes))
    return cwlpnet.CompilerWorldSyncSmokeReport(ChengNodeCompilerRoot(),
                                               Value(sourcePathRes),
                                               Value(outputPathRes))

fn ChengNodeCompilerMaterializeWorldMirrorsText(): Result[str] =
    let bundlePrefixRes = ChengNodeCompilerRequireFlag("--in")
    if IsErr(bundlePrefixRes):
        return Err[str](Error(bundlePrefixRes))
    let bundlePrefix = Value(bundlePrefixRes)
    var bundle: cwbundle.CompilerWorldBundle
    let bundleRes = cwbundle.CompilerWorldBundleReadAndVerify(
        ChengNodeCompilerRoot(),
        share(bundlePrefix),
        bundle)
    if IsErr(bundleRes):
        return Err[str](Error(bundleRes))
    let materializeRes = cwlp.CompilerWorldMaterializeManagedMirrorBundles(
        ChengNodeCompilerRoot(),
        bundle.manifest,
        bundle.managedDependencyReceipt,
        bundle.managedMirrorBundles)
    if IsErr(materializeRes):
        return Err[str](Error(materializeRes))
    return Ok[str](cwlp.CompilerWorldManagedMirrorMaterializeReport(
        bundlePrefix,
        Value(materializeRes)))

