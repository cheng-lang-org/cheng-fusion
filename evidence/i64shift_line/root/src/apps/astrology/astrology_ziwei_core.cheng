import std/strings
import std/result
import cheng/apps/astrology/astrology_calendar_core as cal

type
    AstrologyZiweiSolarParts =
        year: int32
        month: int32
        day: int32
        hour: int32
        minute: int32

    AstrologyZiweiGuideExtract =
        mingGongIndex: int32
        shenGongIndex: int32
        juNumber: int32 = 4
        mingGongDizhi: str
        shenGongDizhi: str
        relationScore: int32
        careerScore: int32
        wealthScore: int32
        healthScore: int32
        learningScore: int32
        expressionScore: int32
        siHuaScore: int32

fn AstrologyZiweiSolarPartsMake(year: int32, month: int32, day: int32, hour: int32, minute: int32): AstrologyZiweiSolarParts =
    var out: AstrologyZiweiSolarParts
    out.year = year
    out.month = month
    out.day = day
    out.hour = hour
    out.minute = minute
    return out

@borrows
fn AstrologyZiweiNormalizeMod(value: int32, modulus: int32): int32 =
    let rem = value % modulus
    if rem < 0:
        return rem + modulus
    return rem

fn AstrologyZiweiFloorDiv(value: int32, divisor: int32): int32 =
    var q = value / divisor
    let r = value % divisor
    if r != 0 && value < 0:
        q = q - 1
    return q

fn AstrologyZiweiJsonAppendEscapedChar(out: str, ch: char): str =
    if ch == '"':
        return strings.ConcatStr(out, "\\\"")
    if ch == '\\':
        return strings.ConcatStr(out, "\\\\")
    if ch == '\n':
        return strings.ConcatStr(out, "\\n")
    if ch == '\r':
        return strings.ConcatStr(out, "\\r")
    if ch == '\t':
        return strings.ConcatStr(out, "\\t")
    return strings.ConcatStr(out, strings.CharToStr(ch))

@borrows
fn AstrologyZiweiJsonString(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        out = AstrologyZiweiJsonAppendEscapedChar(out, value[i])
    return strings.ConcatStr(out, "\"")

@borrows
fn AstrologyZiweiJsonKey(key: str): str =
    return strings.ConcatStr(AstrologyZiweiJsonString(key), ":")

@borrows
fn AstrologyZiweiStemText(index: int32): str =
    let idx = AstrologyZiweiNormalizeMod(index, 10)
    if idx == 0: return "甲"
    if idx == 1: return "乙"
    if idx == 2: return "丙"
    if idx == 3: return "丁"
    if idx == 4: return "戊"
    if idx == 5: return "己"
    if idx == 6: return "庚"
    if idx == 7: return "辛"
    if idx == 8: return "壬"
    return "癸"

@borrows
fn AstrologyZiweiBranchText(index: int32): str =
    let idx = AstrologyZiweiNormalizeMod(index, 12)
    if idx == 0: return "子"
    if idx == 1: return "丑"
    if idx == 2: return "寅"
    if idx == 3: return "卯"
    if idx == 4: return "辰"
    if idx == 5: return "巳"
    if idx == 6: return "午"
    if idx == 7: return "未"
    if idx == 8: return "申"
    if idx == 9: return "酉"
    if idx == 10: return "戌"
    return "亥"

@borrows
fn AstrologyZiweiGanzhiText(index: int32): str =
    let idx = AstrologyZiweiNormalizeMod(index, 60)
    return strings.ConcatStr(AstrologyZiweiStemText(idx), AstrologyZiweiBranchText(idx))

@borrows
fn AstrologyZiweiPalaceName(index: int32): str =
    let idx = AstrologyZiweiNormalizeMod(index, 12)
    if idx == 0: return "命宫"
    if idx == 1: return "兄弟宫"
    if idx == 2: return "夫妻宫"
    if idx == 3: return "子女宫"
    if idx == 4: return "财帛宫"
    if idx == 5: return "疾厄宫"
    if idx == 6: return "迁移宫"
    if idx == 7: return "仆役宫"
    if idx == 8: return "官禄宫"
    if idx == 9: return "田宅宫"
    if idx == 10: return "福德宫"
    return "父母宫"

fn AstrologyZiweiGridRow(zhiIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(zhiIdx, 12)
    if idx == 5 || idx == 6 || idx == 7 || idx == 8:
        return 0
    if idx == 4 || idx == 9:
        return 1
    if idx == 3 || idx == 10:
        return 2
    return 3

fn AstrologyZiweiGridCol(zhiIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(zhiIdx, 12)
    if idx == 5 || idx == 4 || idx == 3 || idx == 2:
        return 0
    if idx == 6 || idx == 1:
        return 1
    if idx == 7 || idx == 0:
        return 2
    return 3

fn AstrologyZiweiGetMingGongTianGan(yearGanIdx: int32, zhiIdx: int32): int32 =
    let yinGanIdx = (AstrologyZiweiNormalizeMod(yearGanIdx, 10) % 5) * 2 + 2
    let dist = AstrologyZiweiNormalizeMod(zhiIdx - 2, 12)
    return AstrologyZiweiNormalizeMod(yinGanIdx + dist, 10)

@borrows
fn AstrologyZiweiGanzhiIndexForGanZhi(ganIdx: int32, zhiIdx: int32): int32 =
    let gan = AstrologyZiweiNormalizeMod(ganIdx, 10)
    let zhi = AstrologyZiweiNormalizeMod(zhiIdx, 12)
    for probe in 0..<60:
        if AstrologyZiweiNormalizeMod(probe, 10) == gan && AstrologyZiweiNormalizeMod(probe, 12) == zhi:
            return probe
    return 0

@borrows
fn AstrologyZiweiNayinJuByGanzhiIndex(ganzhiIndex: int32): int32 =
    let pair = AstrologyZiweiNormalizeMod(ganzhiIndex, 60) / 2
    if pair == 0: return 4
    if pair == 1: return 6
    if pair == 2: return 3
    if pair == 3: return 5
    if pair == 4: return 4
    if pair == 5: return 6
    if pair == 6: return 2
    if pair == 7: return 5
    if pair == 8: return 4
    if pair == 9: return 3
    if pair == 10: return 2
    if pair == 11: return 5
    if pair == 12: return 6
    if pair == 13: return 3
    if pair == 14: return 2
    if pair == 15: return 4
    if pair == 16: return 6
    if pair == 17: return 3
    if pair == 18: return 5
    if pair == 19: return 4
    if pair == 20: return 6
    if pair == 21: return 2
    if pair == 22: return 5
    if pair == 23: return 4
    if pair == 24: return 3
    if pair == 25: return 2
    if pair == 26: return 5
    if pair == 27: return 6
    if pair == 28: return 3
    return 2

