fn AstrologyZiweiTianchuZhi(yearGanIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearGanIdx, 10)
    if idx == 0: return 5
    if idx == 1: return 6
    if idx == 2: return 0
    if idx == 3: return 9
    if idx == 4: return 5
    if idx == 5: return 6
    if idx == 6: return 2
    if idx == 7: return 3
