fn AstrologyZiweiMainStarName(index: int32): str =
    if index == 0: return "紫微"
    if index == 1: return "天机"
    if index == 2: return "太阳"
    if index == 3: return "武曲"
    if index == 4: return "天同"
    if index == 5: return "廉贞"
    if index == 6: return "天府"
    if index == 7: return "太阴"
    if index == 8: return "贪狼"
    if index == 9: return "巨门"
    if index == 10: return "天相"
    if index == 11: return "天梁"
    if index == 12: return "七杀"
    return "破军"

fn AstrologyZiweiMainStarZhi(index: int32, ziweiGongZhi: int32): int32 =
    let tianfuGongZhi = AstrologyZiweiNormalizeMod(12 - ziweiGongZhi + 4, 12)
    if index == 0: return ziweiGongZhi
    if index == 1: return AstrologyZiweiNormalizeMod(ziweiGongZhi - 1, 12)
    if index == 2: return AstrologyZiweiNormalizeMod(ziweiGongZhi - 3, 12)
    if index == 3: return AstrologyZiweiNormalizeMod(ziweiGongZhi - 4, 12)
    if index == 4: return AstrologyZiweiNormalizeMod(ziweiGongZhi - 5, 12)
    if index == 5: return AstrologyZiweiNormalizeMod(ziweiGongZhi - 7, 12)
    if index == 6: return tianfuGongZhi
    if index == 7: return AstrologyZiweiNormalizeMod(tianfuGongZhi + 1, 12)
    if index == 8: return AstrologyZiweiNormalizeMod(tianfuGongZhi + 2, 12)
    if index == 9: return AstrologyZiweiNormalizeMod(tianfuGongZhi + 3, 12)
    if index == 10: return AstrologyZiweiNormalizeMod(tianfuGongZhi + 4, 12)
    if index == 11: return AstrologyZiweiNormalizeMod(tianfuGongZhi + 5, 12)
    if index == 12: return AstrologyZiweiNormalizeMod(tianfuGongZhi + 6, 12)
    return AstrologyZiweiNormalizeMod(tianfuGongZhi + 10, 12)

