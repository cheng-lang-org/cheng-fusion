fn AstrologyZiweiAuxStarZhi(index: int32,
                            lunarMonth: int32,
                            lunarDay: int32,
                            shichen: int32,
                            yearGanIdx: int32,
                            yearZhiIdx: int32,
                            mingGongZhiIdx: int32,
                            shenGongZhiIdx: int32): int32 =
    let sanheGroup = AstrologyZiweiSanHeGroup(yearZhiIdx)
    let lucunZhi = AstrologyZiweiLucunZhi(yearGanIdx)
    let wenchangZhi = AstrologyZiweiNormalizeMod(10 - shichen, 12)
    let wenquZhi = AstrologyZiweiNormalizeMod(4 + shichen, 12)
    let hongluanZhi = AstrologyZiweiNormalizeMod(3 - yearZhiIdx, 12)
    let tiankuZhi = AstrologyZiweiNormalizeMod(6 - yearZhiIdx, 12)
    let yuedeZhi = AstrologyZiweiNormalizeMod(lunarMonth + 1, 12)
    if index == 0: return wenchangZhi
    if index == 1: return wenquZhi
    if index == 2: return AstrologyZiweiNormalizeMod(4 + lunarMonth - 1, 12)
    if index == 3: return AstrologyZiweiNormalizeMod(10 - lunarMonth + 1, 12)
    if index == 4: return AstrologyZiweiTiankuiZhi(yearGanIdx)
    if index == 5: return AstrologyZiweiTianyueZhi(yearGanIdx)
    if index == 6: return lucunZhi
    if index == 7: return AstrologyZiweiNormalizeMod(lucunZhi + 1, 12)
    if index == 8: return AstrologyZiweiNormalizeMod(lucunZhi - 1, 12)
    if index == 9: return AstrologyZiweiNormalizeMod(AstrologyZiweiGroupTable(sanheGroup, 2, 8, 5, 11) + shichen, 12)
    if index == 10: return AstrologyZiweiNormalizeMod(AstrologyZiweiGroupTable(sanheGroup, 10, 4, 1, 7) + shichen, 12)
    if index == 11: return AstrologyZiweiNormalizeMod(11 - shichen, 12)
    if index == 12: return AstrologyZiweiNormalizeMod(11 + shichen, 12)
    if index == 13: return AstrologyZiweiGroupTable(sanheGroup, 2, 8, 5, 11)
    if index == 14: return hongluanZhi
    if index == 15: return AstrologyZiweiNormalizeMod(hongluanZhi + 6, 12)
    if index == 16: return AstrologyZiweiGroupTable(sanheGroup, 9, 3, 0, 6)
    if index == 17: return AstrologyZiweiNormalizeMod(yearZhiIdx + 1, 12)
    if index == 18: return tiankuZhi
    if index == 19: return AstrologyZiweiNormalizeMod(tiankuZhi + 6, 12)
    if index == 20: return AstrologyZiweiGuChenZhi(yearZhiIdx)
    if index == 21: return AstrologyZiweiGuaSuZhi(yearZhiIdx)
    if index == 22: return AstrologyZiweiGroupTable(sanheGroup, 4, 10, 7, 1)
    if index == 23: return AstrologyZiweiTianguanZhi(yearGanIdx)
    if index == 24: return AstrologyZiweiTianfuMinorZhi(yearGanIdx)
    if index == 25: return AstrologyZiweiTianchuZhi(yearGanIdx)
    if index == 26: return AstrologyZiweiNormalizeMod(8 + lunarMonth - 1, 12)
    if index == 27: return AstrologyZiweiNormalizeMod(lunarMonth * 2 + yearZhiIdx, 12)
    if index == 28: return AstrologyZiweiNormalizeMod(yearZhiIdx + 7, 12)
    if index == 29: return AstrologyZiweiNormalizeMod(lunarMonth + yearZhiIdx, 12)
    if index == 30: return AstrologyZiweiNormalizeMod(yearZhiIdx + lunarMonth + 3, 12)
    if index == 31: return AstrologyZiweiNormalizeMod(4 + yearZhiIdx, 12)
    if index == 32: return AstrologyZiweiNormalizeMod(10 - yearZhiIdx, 12)
    if index == 33: return AstrologyZiweiNormalizeMod(yearZhiIdx + 4, 12)
    if index == 34: return AstrologyZiweiNormalizeMod(yearZhiIdx + 8, 12)
    if index == 35: return AstrologyZiweiNormalizeMod(wenchangZhi + 2, 12)
    if index == 36: return AstrologyZiweiNormalizeMod(wenquZhi - 2, 12)
    if index == 37: return mingGongZhiIdx
    if index == 38: return shenGongZhiIdx
    if index == 39: return AstrologyZiweiNormalizeMod(mingGongZhiIdx + 6, 12)
    if index == 40: return AstrologyZiweiNormalizeMod(shenGongZhiIdx + 6, 12)
    if index == 41: return AstrologyZiweiNormalizeMod(yearGanIdx + 3, 12)
    if index == 42: return yuedeZhi
    if index == 43: return AstrologyZiweiNormalizeMod(yearZhiIdx + 5, 12)
    if index == 44: return AstrologyZiweiNormalizeMod(lucunZhi + 6, 12)
    if index == 45: return AstrologyZiweiNormalizeMod(yearZhiIdx + lunarDay, 12)
    return AstrologyZiweiNormalizeMod(yuedeZhi + 6, 12)

