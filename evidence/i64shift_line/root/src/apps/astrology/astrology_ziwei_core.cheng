fn AstrologyZiweiSanHeGroup(yearZhiIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearZhiIdx, 12)
    if idx == 8 || idx == 0 || idx == 4: return 0
    if idx == 2 || idx == 6 || idx == 10: return 1
    if idx == 11 || idx == 3 || idx == 7: return 2
    return 3

@borrows
fn AstrologyZiweiXiaoxianStartZhiIdx(yearZhiIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearZhiIdx, 12)
    if idx == 8 || idx == 0 || idx == 4: return 10
    if idx == 2 || idx == 6 || idx == 10: return 4
    if idx == 11 || idx == 3 || idx == 7: return 1
    return 7

fn AstrologyZiweiGuChenZhi(yearZhiIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearZhiIdx, 12)
    if idx == 2 || idx == 3 || idx == 4: return 5
    if idx == 5 || idx == 6 || idx == 7: return 8
    if idx == 8 || idx == 9 || idx == 10: return 11
    return 2

fn AstrologyZiweiGuaSuZhi(yearZhiIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearZhiIdx, 12)
    if idx == 2 || idx == 3 || idx == 4: return 1
    if idx == 5 || idx == 6 || idx == 7: return 4
    if idx == 8 || idx == 9 || idx == 10: return 7
    return 10

fn AstrologyZiweiZiweiStartGong(lunarDay: int32, juNumber: int32): int32 =
    var day = lunarDay
    if day < 1: day = 1
    if day > 30: day = 30
    var ju = juNumber
    if ju < 2: ju = 2
    if ju > 6: ju = 6
    let x = AstrologyZiweiNormalizeMod(ju - AstrologyZiweiNormalizeMod(day, ju), ju)
    let y = (day + x) / ju
    var k = y
    if x != 0:
        if x % 2 == 0:
            k = y + x
        else:
            k = y - x
    return AstrologyZiweiNormalizeMod(2 + (k - 1), 12)

@borrows
fn AstrologyZiweiShichenToHour(shichen: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(shichen, 12)
    if idx == 0:
        return 23
    return idx * 2 - 1

@borrows
fn AstrologyZiweiHourMinuteToShichen(hour: int32, minute: int32): int32 =
    let h = AstrologyZiweiNormalizeMod(hour, 24)
    var m = AstrologyZiweiNormalizeMod(minute, 60)
    let totalMinutes = h * 60 + m
    return (((totalMinutes / 60) + 1) % 24) / 2

@borrows
fn AstrologyZiweiAddMinutes(parts: AstrologyZiweiSolarParts, deltaMinutes: int32): AstrologyZiweiSolarParts =
    let totalMinutes = parts.hour * 60 + parts.minute + deltaMinutes
    let dayDelta = AstrologyZiweiFloorDiv(totalMinutes, 1440)
    let normalizedMinutes = totalMinutes - dayDelta * 1440
    let jdn = cal.AstrologyGregorianToJdn(parts.year, parts.month, parts.day) + dayDelta
    let solar = cal.AstrologyJdnToSolar(jdn)
    return AstrologyZiweiSolarPartsMake(solar.year, solar.month, solar.day, normalizedMinutes / 60, normalizedMinutes % 60)

@borrows
fn AstrologyZiweiLongitudeCorrectionMinutes(longitudeMilli: int32): int32 =
    let deltaMilli = (longitudeMilli - 120000) * 4
    return AstrologyZiweiFloorDiv(deltaMilli + 500, 1000)

@borrows
fn AstrologyZiweiSolarPartsValid(parts: AstrologyZiweiSolarParts): bool =
    return cal.AstrologySolarDateValid(cal.AstrologySolarDateMake(parts.year, parts.month, parts.day, parts.hour, parts.minute))

@borrows
fn AstrologyZiweiSolarFromInput(calendarType: str,
                                year: int32,
                                month: int32,
                                day: int32,
                                inputHour: int32,
                                minute: int32,
                                timezone: str,
                                longitudeMilli: int32,
                                hasLongitude: bool,
                                useTrueSolarTime: bool,
                                outSolar: var AstrologyZiweiSolarParts): bool =
    var solar: AstrologyZiweiSolarParts
    if calendarType == "solar":
        solar = AstrologyZiweiSolarPartsMake(year, month, day, inputHour, minute)
        if !AstrologyZiweiSolarPartsValid(solar):
            return false
    elif calendarType == "lunar":
        var lunarDay = day
        if lunarDay > 30:
            lunarDay = 30
        let lunar = cal.AstrologyLunarDateMake(year, month, lunarDay, false)
        let solarRes = cal.AstrologySolarFromLunar(lunar)
        if IsErr(solarRes):
            return false
        let solarBase = Value(solarRes)
        solar = AstrologyZiweiSolarPartsMake(solarBase.year, solarBase.month, solarBase.day, inputHour, minute)
        if !AstrologyZiweiSolarPartsValid(solar):
            return false
    else:
        return false
    if useTrueSolarTime && hasLongitude:
        if timezone != "Asia/Shanghai" && timezone != "":
            return false
        solar = AstrologyZiweiAddMinutes(solar, AstrologyZiweiLongitudeCorrectionMinutes(longitudeMilli))
        if !AstrologyZiweiSolarPartsValid(solar):
            return false
    outSolar = solar
    return true

fn AstrologyZiweiGroupTable(group: int32, a: int32, b: int32, c: int32, d: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(group, 4)
    if idx == 0: return a
    if idx == 1: return b
    if idx == 2: return c
    return d

fn AstrologyZiweiTiankuiZhi(yearGanIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearGanIdx, 10)
    if idx == 0: return 1
    if idx == 1: return 0
    if idx == 2: return 11
    if idx == 3: return 11
    if idx == 4: return 1
    if idx == 5: return 0
    if idx == 6: return 7
    if idx == 7: return 6
    if idx == 8: return 3
    return 3

fn AstrologyZiweiTianyueZhi(yearGanIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearGanIdx, 10)
    if idx == 0: return 7
    if idx == 1: return 8
    if idx == 2: return 9
    if idx == 3: return 9
    if idx == 4: return 7
    if idx == 5: return 8
    if idx == 6: return 1
    if idx == 7: return 2
    if idx == 8: return 5
    return 5

fn AstrologyZiweiLucunZhi(yearGanIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearGanIdx, 10)
    if idx == 0: return 2
    if idx == 1: return 3
    if idx == 2: return 5
    if idx == 3: return 6
    if idx == 4: return 5
    if idx == 5: return 6
    if idx == 6: return 8
    if idx == 7: return 9
    if idx == 8: return 11
    return 0

fn AstrologyZiweiTianguanZhi(yearGanIdx: int32): int32 =
    let idx = AstrologyZiweiNormalizeMod(yearGanIdx, 10)
