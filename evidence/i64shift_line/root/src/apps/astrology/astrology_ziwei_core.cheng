@borrows
fn AstrologyZiweiSiHuaName(index: int32): str =
    if index == 0: return "化禄"
    if index == 1: return "化权"
    if index == 2: return "化科"
    return "化忌"

fn AstrologyZiweiSiHuaStar(yearGanIdx: int32, index: int32): str =
    let gan = AstrologyZiweiNormalizeMod(yearGanIdx, 10)
    if gan == 0:
        if index == 0: return "廉贞"
        if index == 1: return "破军"
        if index == 2: return "武曲"
        return "太阳"
    if gan == 1:
        if index == 0: return "天机"
        if index == 1: return "天梁"
        if index == 2: return "紫微"
        return "太阴"
    if gan == 2:
        if index == 0: return "天同"
        if index == 1: return "天机"
        if index == 2: return "文昌"
        return "廉贞"
    if gan == 3:
        if index == 0: return "太阴"
        if index == 1: return "天同"
        if index == 2: return "天机"
        return "巨门"
    if gan == 4:
        if index == 0: return "贪狼"
        if index == 1: return "太阴"
        if index == 2: return "右弼"
        return "天机"
    if gan == 5:
        if index == 0: return "武曲"
        if index == 1: return "贪狼"
        if index == 2: return "天梁"
        return "文曲"
    if gan == 6:
        if index == 0: return "太阳"
        if index == 1: return "武曲"
        if index == 2: return "太阴"
        return "天同"
    if gan == 7:
        if index == 0: return "巨门"
        if index == 1: return "太阳"
        if index == 2: return "文曲"
        return "文昌"
    if gan == 8:
        if index == 0: return "天梁"
        if index == 1: return "紫微"
        if index == 2: return "左辅"
        return "武曲"
    if index == 0: return "破军"
    if index == 1: return "巨门"
    if index == 2: return "太阴"
    return "贪狼"

@borrows
fn AstrologyZiweiSiHuaForStar(yearGanIdx: int32, starName: str): str =
    for i in 0..<4:
        if AstrologyZiweiSiHuaStar(yearGanIdx, i) == starName:
            return AstrologyZiweiSiHuaName(i)
    return ""

@borrows
fn AstrologyZiweiStarAtPalace(starName: str,
                              zhiIdx: int32,
                              ziweiGongZhi: int32,
                              lunarMonth: int32,
                              lunarDay: int32,
                              shichen: int32,
                              yearGanIdx: int32,
                              yearZhiIdx: int32,
                              mingGongZhiIdx: int32,
                              shenGongZhiIdx: int32): bool =
    for i in 0..<14:
        if AstrologyZiweiMainStarName(i) == starName && AstrologyZiweiMainStarZhi(i, ziweiGongZhi) == zhiIdx:
            return true
    for i in 0..<47:
        if AstrologyZiweiAuxStarName(i) == starName && AstrologyZiweiAuxStarZhi(i, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx) == zhiIdx:
            return true
    return false

@borrows
fn AstrologyZiweiStarJson(starName: str, zhiIdx: int32, yearGanIdx: int32): str =
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyZiweiJsonKey("name"), AstrologyZiweiJsonString(starName)))
    let brightness = AstrologyZiweiBrightness(starName, zhiIdx)
    if brightness.len == 0:
        out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("brightness"), "null")))
    else:
        out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("brightness"), AstrologyZiweiJsonString(brightness))))
    let siHua = AstrologyZiweiSiHuaForStar(yearGanIdx, starName)
    if siHua.len == 0:
        out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("siHua"), "null")))
    else:
        out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("siHua"), AstrologyZiweiJsonString(siHua))))
    return strings.ConcatStr(out, "}")

fn AstrologyZiweiAgeSeriesJson(startAge: int32): str =
    var normalized = startAge
    if normalized < 1: normalized = 1
    if normalized > 12: normalized = 12
    var out = "["
    var first = true
    var age = normalized
    while age <= 120:
        if first:
            first = false
        else:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, strings.IntToStr(age))
        age = age + 12
    return strings.ConcatStr(out, "]")

fn AstrologyZiweiMainStarsJson(zhiIdx: int32, ziweiGongZhi: int32, yearGanIdx: int32): str =
    var out = "["
    var first = true
    for i in 0..<14:
        if AstrologyZiweiMainStarZhi(i, ziweiGongZhi) == zhiIdx:
            if first:
                first = false
            else:
                out = strings.ConcatStr(out, ",")
            out = strings.ConcatStr(out, AstrologyZiweiStarJson(AstrologyZiweiMainStarName(i), zhiIdx, yearGanIdx))
    return strings.ConcatStr(out, "]")

fn AstrologyZiweiAuxStarsJson(zhiIdx: int32,
                              lunarMonth: int32,
                              lunarDay: int32,
                              shichen: int32,
                              yearGanIdx: int32,
                              yearZhiIdx: int32,
                              mingGongZhiIdx: int32,
                              shenGongZhiIdx: int32): str =
    var out = "["
    var first = true
    for i in 0..<47:
        if AstrologyZiweiAuxStarZhi(i, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx) == zhiIdx:
            if first:
                first = false
            else:
                out = strings.ConcatStr(out, ",")
            out = strings.ConcatStr(out, AstrologyZiweiStarJson(AstrologyZiweiAuxStarName(i), zhiIdx, yearGanIdx))
    return strings.ConcatStr(out, "]")

fn AstrologyZiweiSiHuaArrayJson(zhiIdx: int32,
                                ziweiGongZhi: int32,
                                lunarMonth: int32,
                                lunarDay: int32,
                                shichen: int32,
                                yearGanIdx: int32,
                                yearZhiIdx: int32,
                                mingGongZhiIdx: int32,
                                shenGongZhiIdx: int32): str =
    var out = "["
    var first = true
    for i in 0..<4:
        let starName = AstrologyZiweiSiHuaStar(yearGanIdx, i)
        if AstrologyZiweiStarAtPalace(starName, zhiIdx, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx):
            if first:
                first = false
            else:
                out = strings.ConcatStr(out, ",")
            out = strings.ConcatStr(out, AstrologyZiweiJsonString(strings.ConcatStr(starName, AstrologyZiweiSiHuaName(i))))
    return strings.ConcatStr(out, "]")

@borrows
fn AstrologyZiweiPalaceJson(palaceIndex: int32,
                            solarYear: int32,
                            lunarMonth: int32,
                            lunarDay: int32,
                            shichen: int32,
                            gender: str,
                            yearGanIdx: int32,
                            yearZhiIdx: int32,
                            mingGongZhiIdx: int32,
                            shenGongZhiIdx: int32,
                            ziweiGongZhi: int32,
                            juNumber: int32,
                            forward: bool): str =
    let zhiIdx = AstrologyZiweiNormalizeMod(mingGongZhiIdx - palaceIndex, 12)
    let ganIdx = AstrologyZiweiGetMingGongTianGan(yearGanIdx, zhiIdx)
    let step = forward ? palaceIndex : AstrologyZiweiNormalizeMod(12 - palaceIndex, 12)
    let daxianStart = juNumber + step * 10
    let liunianStartAge = AstrologyZiweiNormalizeMod(zhiIdx - yearZhiIdx + 12, 12) + 1
    let xiaoxianStartZhi = AstrologyZiweiXiaoxianStartZhiIdx(yearZhiIdx)
    let xiaoxianStep = (gender == "男") ? AstrologyZiweiNormalizeMod(zhiIdx - xiaoxianStartZhi + 12, 12) : AstrologyZiweiNormalizeMod(xiaoxianStartZhi - zhiIdx + 12, 12)
    let xiaoxianStartAge = xiaoxianStep + 1
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyZiweiJsonKey("name"), AstrologyZiweiJsonString(AstrologyZiweiPalaceName(palaceIndex))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("dizhi"), AstrologyZiweiJsonString(AstrologyZiweiBranchText(zhiIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("tiangan"), AstrologyZiweiJsonString(AstrologyZiweiStemText(ganIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("mainStars"), AstrologyZiweiMainStarsJson(zhiIdx, ziweiGongZhi, yearGanIdx))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("auxStars"), AstrologyZiweiAuxStarsJson(zhiIdx, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("siHua"), AstrologyZiweiSiHuaArrayJson(zhiIdx, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("daxianStart"), strings.IntToStr(daxianStart))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("daxianEnd"), strings.IntToStr(daxianStart + 9))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("liunianYear"), strings.IntToStr(solarYear + liunianStartAge - 1))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("liunianAges"), AstrologyZiweiAgeSeriesJson(liunianStartAge))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("xiaoxianAges"), AstrologyZiweiAgeSeriesJson(xiaoxianStartAge))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("gridRow"), strings.IntToStr(AstrologyZiweiGridRow(zhiIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("gridCol"), strings.IntToStr(AstrologyZiweiGridCol(zhiIdx)))))
    return strings.ConcatStr(out, "}")

# Owned copy helper usable on borrowed strings (ConcatStr would consume).
@borrows
fn AstrologyZiweiCloneStr(value: str): str =
    var out = ""
    for i in 0..<value.len:
        out = strings.ConcatStr(out, strings.CharToStr(value[i]))
    return out

@borrows
fn AstrologyZiweiGongsJson(solarYear: int32,
                           lunarMonth: int32,
                           lunarDay: int32,
                           shichen: int32,
                           gender: str,
                           yearGanIdx: int32,
                           yearZhiIdx: int32,
                           mingGongZhiIdx: int32,
                           shenGongZhiIdx: int32,
                           ziweiGongZhi: int32,
                           juNumber: int32,
                           forward: bool): str =
    var out = "["
    for i in 0..<12:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        out = strings.ConcatStr(out, AstrologyZiweiPalaceJson(i, solarYear, lunarMonth, lunarDay, shichen, AstrologyZiweiCloneStr(gender), yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx, ziweiGongZhi, juNumber, forward))
    return strings.ConcatStr(out, "]")

@borrows
fn AstrologyZiweiShenGongIndex(mingGongZhiIdx: int32, shenGongZhiIdx: int32): int32 =
    for i in 0..<12:
        if AstrologyZiweiNormalizeMod(mingGongZhiIdx - i, 12) == shenGongZhiIdx:
            return i
    return 0

fn AstrologyZiweiDecimalMilliJson(longitudeMilli: int32): str =
    let whole = longitudeMilli / 1000
    var frac = longitudeMilli % 1000
    if frac < 0:
        frac = 0 - frac
    var fracText = strings.IntToStr(frac)
    if frac < 10:
        fracText = strings.ConcatStr("00", fracText)
    elif frac < 100:
        fracText = strings.ConcatStr("0", fracText)
    return strings.ConcatStr(strings.ConcatStr(strings.IntToStr(whole), "."), fracText)

@borrows
fn AstrologyZiweiInputJson(calendarType: str,
                           year: int32,
                           month: int32,
                           day: int32,
                           inputHour: int32,
                           minute: int32,
                           timezone: str,
                           longitudeMilli: int32,
                           hasLongitude: bool,
                           gender: str): str =
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyZiweiJsonKey("calendar"), AstrologyZiweiJsonString(calendarType)))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("year"), strings.IntToStr(year))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("month"), strings.IntToStr(month))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("day"), strings.IntToStr(day))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("hour"), strings.IntToStr(inputHour))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("minute"), strings.IntToStr(minute))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("timezone"), AstrologyZiweiJsonString(timezone))))
    if hasLongitude:
        out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("longitude"), AstrologyZiweiDecimalMilliJson(longitudeMilli))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("gender"), AstrologyZiweiJsonString(gender))))
    return strings.ConcatStr(out, "}")

@borrows
fn AstrologyZiweiProfileJson(useTrueSolarTime: bool, lateZiBoundary: str): str =
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyZiweiJsonKey("profileId"), AstrologyZiweiJsonString("wenmo-basic-v1")))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("useTrueSolarTime"), useTrueSolarTime ? "true" : "false")))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("lateZiBoundary"), AstrologyZiweiJsonString(lateZiBoundary))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("monthBoundary"), AstrologyZiweiJsonString("jieqi"))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("dayunStartMode"), AstrologyZiweiJsonString("exact-jieqi-diff"))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("ziweiDaxianDirection"), AstrologyZiweiJsonString("gender-year-yinyang"))))
    return strings.ConcatStr(out, "}")

fn AstrologyZiweiBuildResultJson(year: int32,
                                 month: int32,
                                 day: int32,
                                 shichenInput: int32,
                                 gender: str,
                                 calendarType: str,
                                 minute: int32,
                                 timezoneRaw: str,
                                 longitudeMilli: int32,
                                 hasLongitude: bool,
                                 useTrueSolarTime: bool,
                                 lateZiBoundaryRaw: str,
                                 outJson: var str): bool =
    if gender != "男" && gender != "女":
        return false
    var timezone = timezoneRaw
    if timezone.len == 0:
        timezone = "Asia/Shanghai"
    var lateZiBoundary = lateZiBoundaryRaw
    if lateZiBoundary.len == 0:
        lateZiBoundary = "00:00"
    if lateZiBoundary != "00:00" && lateZiBoundary != "23:00":
        return false
    let inputHour = AstrologyZiweiShichenToHour(shichenInput)
    var solar: AstrologyZiweiSolarParts
    if !AstrologyZiweiSolarFromInput(AstrologyZiweiCloneStr(calendarType), year, month, day, inputHour, minute, AstrologyZiweiCloneStr(timezone), longitudeMilli, hasLongitude, useTrueSolarTime, solar):
        return false
    let lunarRes = cal.AstrologyLunarFromSolar(cal.AstrologySolarDateMake(solar.year, solar.month, solar.day, solar.hour, solar.minute))
    if IsErr(lunarRes):
        return false
    let lunar = Value(lunarRes)
    let lunarYear = lunar.year
    let lunarMonth = lunar.month
    let lunarDay = lunar.day
    let shichen = AstrologyZiweiHourMinuteToShichen(solar.hour, solar.minute)
    let yearGzIndex = AstrologyZiweiNormalizeMod(lunarYear - 4, 60)
    let yearGanIdx = AstrologyZiweiNormalizeMod(yearGzIndex, 10)
    let yearZhiIdx = AstrologyZiweiNormalizeMod(yearGzIndex, 12)
    let mingGongZhiIdx = AstrologyZiweiNormalizeMod(2 + (lunarMonth - 1) - shichen, 12)
    let shenGongZhiIdx = AstrologyZiweiNormalizeMod(2 + (lunarMonth - 1) + shichen, 12)
    let mingGongGanIdx = AstrologyZiweiGetMingGongTianGan(yearGanIdx, mingGongZhiIdx)
    let juNumber = AstrologyZiweiNayinJuByGanzhiIndex(AstrologyZiweiGanzhiIndexForGanZhi(mingGongGanIdx, mingGongZhiIdx))
    let ziweiGongZhi = AstrologyZiweiZiweiStartGong(lunarDay, juNumber)
    let forward = (gender == "男" && yearGanIdx % 2 == 0) || (gender == "女" && yearGanIdx % 2 != 0)
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyZiweiJsonKey("gongs"), AstrologyZiweiGongsJson(solar.year, lunarMonth, lunarDay, shichen, AstrologyZiweiCloneStr(gender), yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx, ziweiGongZhi, juNumber, forward)))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("mingGongIdx"), "0")))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("shenGongIdx"), strings.IntToStr(AstrologyZiweiShenGongIndex(mingGongZhiIdx, shenGongZhiIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("wuxingJu"), AstrologyZiweiJsonString(AstrologyZiweiJuName(juNumber)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("juNumber"), strings.IntToStr(juNumber))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("yearGanZhi"), AstrologyZiweiJsonString(AstrologyZiweiGanzhiText(yearGzIndex)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("mingZhu"), AstrologyZiweiJsonString(AstrologyZiweiMingZhu(mingGongZhiIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("shenZhu"), AstrologyZiweiJsonString(AstrologyZiweiShenZhu(yearZhiIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("input"), AstrologyZiweiInputJson(calendarType, year, month, day, inputHour, minute, timezone, longitudeMilli, hasLongitude, gender))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyZiweiJsonKey("profile"), AstrologyZiweiProfileJson(useTrueSolarTime, lateZiBoundary))))
    outJson = strings.ConcatStr(out, "}")
    return true

@borrows
fn AstrologyZiweiStarScoreValue(name: str): int32 =
    if name == "紫微": return 2
    if name == "天府": return 2
    if name == "天相": return 1
    if name == "天梁": return 1
    if name == "天机": return 1
    if name == "天同": return 1
    if name == "太阳": return 1
    if name == "太阴": return 1
    if name == "武曲": return 1
    if name == "文昌": return 1
    if name == "文曲": return 1
    if name == "左辅": return 1
    if name == "右弼": return 1
    if name == "禄存": return 1
    if name == "贪狼": return 0
    if name == "廉贞": return 0
    if name == "七杀": return -1
    if name == "破军": return -1
    if name == "巨门": return -1
    if name == "擎羊": return -1
    if name == "陀罗": return -1
    if name == "火星": return -1
    if name == "铃星": return -1
    if name == "地空": return -2
    if name == "地劫": return -2
    return 0

@borrows
fn AstrologyZiweiBrightnessScoreValue(brightness: str): int32 =
    if brightness == "庙": return 2
    if brightness == "旺": return 2
    if brightness == "得": return 1
    if brightness == "利": return 1
    if brightness == "平": return 0
    if brightness == "不": return -1
    if brightness == "陷": return -2
    return 0

@borrows
fn AstrologyZiweiSiHuaScoreValue(siHuaName: str): int32 =
    if siHuaName == "化禄": return 2
    if siHuaName == "化权": return 1
    if siHuaName == "化科": return 1
    if siHuaName == "化忌": return -2
    return 0

@borrows
fn AstrologyZiweiScoreStar(name: str, brightness: str, siHua: str, weight: int32): int32 =
    var base = AstrologyZiweiStarScoreValue(name)
    if brightness.len != 0:
        base = base + AstrologyZiweiBrightnessScoreValue(brightness)
    if siHua.len != 0:
        base = base + AstrologyZiweiSiHuaScoreValue(siHua)
    return base * weight

@borrows
fn AstrologyZiweiPalaceScore(palaceIndex: int32,
                             ziweiGongZhi: int32,
                             lunarMonth: int32,
                             lunarDay: int32,
                             shichen: int32,
                             yearGanIdx: int32,
                             yearZhiIdx: int32,
                             mingGongZhiIdx: int32,
                             shenGongZhiIdx: int32): int32 =
    let zhiIdx = AstrologyZiweiNormalizeMod(mingGongZhiIdx - palaceIndex, 12)
    var score = 0
    for i in 0..<14:
        if AstrologyZiweiMainStarZhi(i, ziweiGongZhi) == zhiIdx:
            let name = AstrologyZiweiMainStarName(i)
            let brightness = AstrologyZiweiBrightness(name, zhiIdx)
            let siHua = AstrologyZiweiSiHuaForStar(yearGanIdx, name)
            score = score + AstrologyZiweiScoreStar(name, brightness, siHua, 2)
    for i in 0..<47:
        if AstrologyZiweiAuxStarZhi(i, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx) == zhiIdx:
            let name = AstrologyZiweiAuxStarName(i)
            let brightness = AstrologyZiweiBrightness(name, zhiIdx)
            let siHua = AstrologyZiweiSiHuaForStar(yearGanIdx, name)
            score = score + AstrologyZiweiScoreStar(name, brightness, siHua, 1)
    for i in 0..<4:
        let starName = AstrologyZiweiSiHuaStar(yearGanIdx, i)
        if AstrologyZiweiStarAtPalace(starName, zhiIdx, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx):
            score = score + AstrologyZiweiSiHuaScoreValue(AstrologyZiweiSiHuaName(i))
    return score

@borrows
fn AstrologyZiweiGuideScoreFromInput(calendarType: str,
                                     year: int32,
                                     month: int32,
                                     day: int32,
                                     hour: int32,
                                     minute: int32,
                                     gender: str,
                                     timezoneRaw: str,
                                     longitudeMilli: int32,
                                     hasLongitude: bool,
                                     useTrueSolarTime: bool,
                                     out: var AstrologyZiweiGuideExtract): bool =
    if gender != "男" && gender != "女":
        return false
    var timezone = timezoneRaw
    if timezone.len == 0:
        timezone = "Asia/Shanghai"
    var solar: AstrologyZiweiSolarParts
    if !AstrologyZiweiSolarFromInput(calendarType, year, month, day, hour, minute, timezone, longitudeMilli, hasLongitude, useTrueSolarTime, solar):
        return false
    let lunarRes = cal.AstrologyLunarFromSolar(cal.AstrologySolarDateMake(solar.year, solar.month, solar.day, solar.hour, solar.minute))
    if IsErr(lunarRes):
        return false
    let lunar = Value(lunarRes)
    let lunarYear = lunar.year
    let lunarMonth = lunar.month
    let lunarDay = lunar.day
    let shichen = AstrologyZiweiHourMinuteToShichen(solar.hour, solar.minute)
    let yearGzIndex = AstrologyZiweiNormalizeMod(lunarYear - 4, 60)
    let yearGanIdx = AstrologyZiweiNormalizeMod(yearGzIndex, 10)
    let yearZhiIdx = AstrologyZiweiNormalizeMod(yearGzIndex, 12)
    let mingGongZhiIdx = AstrologyZiweiNormalizeMod(2 + (lunarMonth - 1) - shichen, 12)
    let shenGongZhiIdx = AstrologyZiweiNormalizeMod(2 + (lunarMonth - 1) + shichen, 12)
    let mingGongGanIdx = AstrologyZiweiGetMingGongTianGan(yearGanIdx, mingGongZhiIdx)
    let juNumber = AstrologyZiweiNayinJuByGanzhiIndex(AstrologyZiweiGanzhiIndexForGanZhi(mingGongGanIdx, mingGongZhiIdx))
    let ziweiGongZhi = AstrologyZiweiZiweiStartGong(lunarDay, juNumber)

    let mingScore = AstrologyZiweiPalaceScore(0, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)
    let fuqiScore = AstrologyZiweiPalaceScore(2, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)
    let caiboScore = AstrologyZiweiPalaceScore(4, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)
    let jieeScore = AstrologyZiweiPalaceScore(5, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)
    let qianyiScore = AstrologyZiweiPalaceScore(6, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)
    let guanluScore = AstrologyZiweiPalaceScore(8, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)
    let tianzhaiScore = AstrologyZiweiPalaceScore(9, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)
    let fudeScore = AstrologyZiweiPalaceScore(10, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)
    let fumuScore = AstrologyZiweiPalaceScore(11, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx)

    out.relationScore = fuqiScore + AstrologyZiweiFloorDiv(mingScore, 2)
    out.careerScore = guanluScore + AstrologyZiweiFloorDiv(qianyiScore, 2)
    out.wealthScore = caiboScore + AstrologyZiweiFloorDiv(tianzhaiScore, 2)
    out.healthScore = jieeScore + AstrologyZiweiFloorDiv(fudeScore, 2)
    out.learningScore = fudeScore + AstrologyZiweiFloorDiv(fumuScore, 2)
    out.expressionScore = mingScore + AstrologyZiweiFloorDiv(qianyiScore, 2)

    var siHua = 0
    for p in 0..<12:
        let pzhi = AstrologyZiweiNormalizeMod(mingGongZhiIdx - p, 12)
        for i in 0..<4:
            let starName = AstrologyZiweiSiHuaStar(yearGanIdx, i)
            if AstrologyZiweiStarAtPalace(starName, pzhi, ziweiGongZhi, lunarMonth, lunarDay, shichen, yearGanIdx, yearZhiIdx, mingGongZhiIdx, shenGongZhiIdx):
                siHua = siHua + AstrologyZiweiSiHuaScoreValue(AstrologyZiweiSiHuaName(i))
    out.siHuaScore = siHua

    out.mingGongIndex = 0
    out.shenGongIndex = AstrologyZiweiShenGongIndex(mingGongZhiIdx, shenGongZhiIdx)
    out.mingGongDizhi = AstrologyZiweiBranchText(mingGongZhiIdx)
    out.shenGongDizhi = AstrologyZiweiBranchText(shenGongZhiIdx)
    out.juNumber = juNumber
    return true
