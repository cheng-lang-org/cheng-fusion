import std/strings
import cheng/apps/astrology/astrology_daily_guide_scalar_abi as scalar
import cheng/apps/astrology/astrology_scalar_jie_boundary_minute_table as jieMinute

type
    AstrologyBaziSolarParts =
        year: int32
        month: int32
        day: int32
        hour: int32
        minute: int32

    AstrologyBaziGuideExtract =
        dayGanIndex: int32
        yearZhiIndex: int32
        dayMasterStrengthValue: int32 = 1
        wuxingWood: int32
        wuxingFire: int32
        wuxingEarth: int32
        wuxingMetal: int32
        wuxingWater: int32
        dayGanText: str

fn AstrologyBaziNormalizeMod(value: int32, modulus: int32): int32 =
    let rem = value % modulus
    if rem < 0:
        return rem + modulus
    return rem

fn AstrologyBaziFloorDiv(value: int32, divisor: int32): int32 =
    var q = value / divisor
    let r = value % divisor
    if r != 0 && value < 0:
        q = q - 1
    return q

fn AstrologyBaziIsLeapYear(year: int32): bool =
    if year % 400 == 0:
        return true
    if year % 100 == 0:
        return false
    return year % 4 == 0

fn AstrologyBaziDaysInMonth(year: int32, month: int32): int32 =
    if month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12:
        return 31
    if month == 4 || month == 6 || month == 9 || month == 11:
        return 30
    if month == 2:
        if AstrologyBaziIsLeapYear(year):
            return 29
        return 28
    return 0

fn AstrologyBaziSolarValid(parts: AstrologyBaziSolarParts): bool =
    if parts.year < 1900 || parts.year > 2101:
        return false
    if parts.month < 1 || parts.month > 12:
        return false
    let days = AstrologyBaziDaysInMonth(parts.year, parts.month)
    if days <= 0 || parts.day < 1 || parts.day > days:
        return false
    if parts.hour < 0 || parts.hour > 23:
        return false
    if parts.minute < 0 || parts.minute > 59:
        return false
    return true

fn AstrologyBaziJdnToSolar(jdn: int32, hour: int32, minute: int32): AstrologyBaziSolarParts =
    let a = jdn + 32044
    let b = (4 * a + 3) / 146097
    let c = a - (146097 * b) / 4
    let d = (4 * c + 3) / 1461
    let e = c - (1461 * d) / 4
    let m = (5 * e + 2) / 153
    var out: AstrologyBaziSolarParts
    out.day = e - (153 * m + 2) / 5 + 1
    out.month = m + 3 - 12 * (m / 10)
    out.year = 100 * b + d - 4800 + (m / 10)
    out.hour = hour
    out.minute = minute
    return out

fn AstrologyBaziAddMinutes(parts: AstrologyBaziSolarParts, deltaMinutes: int32): AstrologyBaziSolarParts =
    let totalMinutes = parts.hour * 60 + parts.minute + deltaMinutes
    let dayDelta = AstrologyBaziFloorDiv(totalMinutes, 1440)
    let normalizedMinutes = totalMinutes - dayDelta * 1440
    let jdn = scalar.AstrologyScalarGregorianToJdn(parts.year, parts.month, parts.day) + dayDelta
    return AstrologyBaziJdnToSolar(jdn, normalizedMinutes / 60, normalizedMinutes % 60)

fn AstrologyBaziAddYears(parts: AstrologyBaziSolarParts, years: int32): AstrologyBaziSolarParts =
    var out = parts
    out.year = out.year + years
    let days = AstrologyBaziDaysInMonth(out.year, out.month)
    if out.day > days:
        out.day = days
    return out

fn AstrologyBaziAddMonths(parts: AstrologyBaziSolarParts, months: int32): AstrologyBaziSolarParts =
    var total = (parts.year * 12 + (parts.month - 1)) + months
    let year = AstrologyBaziFloorDiv(total, 12)
    let monthZero = total - year * 12
    var out = parts
    out.year = year
    out.month = monthZero + 1
    let days = AstrologyBaziDaysInMonth(out.year, out.month)
    if out.day > days:
        out.day = days
    return out

fn AstrologyBaziAddDays(parts: AstrologyBaziSolarParts, days: int32): AstrologyBaziSolarParts =
    let jdn = scalar.AstrologyScalarGregorianToJdn(parts.year, parts.month, parts.day) + days
    return AstrologyBaziJdnToSolar(jdn, parts.hour, parts.minute)

fn AstrologyBaziAddHours(parts: AstrologyBaziSolarParts, hours: int32): AstrologyBaziSolarParts =
    return AstrologyBaziAddMinutes(parts, hours * 60)

fn AstrologyBaziJsonAppendEscapedChar(out: str, ch: char): str =
    if ch == '"':
        return strings.ConcatStr(out, "\\\"")
    if ch == '\\':
        return strings.ConcatStr(out, "\\\\")
    if ch == '\n':
        return strings.ConcatStr(out, "\\n")
    if ch == '\r':
        return strings.ConcatStr(out, "\\r")
    if ch == '\t':
        return strings.ConcatStr(out, "\\t")
    return strings.ConcatStr(out, strings.CharToStr(ch))

@borrows
fn AstrologyBaziJsonString(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        out = AstrologyBaziJsonAppendEscapedChar(out, value[i])
    out = strings.ConcatStr(out, "\"")
    return out

@borrows
fn AstrologyBaziJsonKey(key: str): str =
    return strings.ConcatStr(AstrologyBaziJsonString(key), ":")

fn AstrologyBaziStemText(index: int32): str =
    let idx = AstrologyBaziNormalizeMod(index, 10)
    if idx == 0: return "甲"
    if idx == 1: return "乙"
    if idx == 2: return "丙"
    if idx == 3: return "丁"
    if idx == 4: return "戊"
    if idx == 5: return "己"
    if idx == 6: return "庚"
    if idx == 7: return "辛"
    if idx == 8: return "壬"
    return "癸"

fn AstrologyBaziBranchText(index: int32): str =
    let idx = AstrologyBaziNormalizeMod(index, 12)
    if idx == 0: return "子"
    if idx == 1: return "丑"
    if idx == 2: return "寅"
    if idx == 3: return "卯"
    if idx == 4: return "辰"
    if idx == 5: return "巳"
    if idx == 6: return "午"
    if idx == 7: return "未"
    if idx == 8: return "申"
    if idx == 9: return "酉"
    if idx == 10: return "戌"
    return "亥"

fn AstrologyBaziElementText(index: int32): str =
    let idx = AstrologyBaziNormalizeMod(index, 5)
    if idx == 0: return "木"
    if idx == 1: return "火"
    if idx == 2: return "土"
    if idx == 3: return "金"
    return "水"

fn AstrologyBaziStemElementId(stemIndex: int32): int32 =
    let idx = AstrologyBaziNormalizeMod(stemIndex, 10)
    if idx == 0 || idx == 1: return 0
    if idx == 2 || idx == 3: return 1
    if idx == 4 || idx == 5: return 2
    if idx == 6 || idx == 7: return 3
    return 4

fn AstrologyBaziBranchElementId(branchIndex: int32): int32 =
    let idx = AstrologyBaziNormalizeMod(branchIndex, 12)
    if idx == 2 || idx == 3: return 0
    if idx == 5 || idx == 6: return 1
    if idx == 1 || idx == 4 || idx == 7 || idx == 10: return 2
    if idx == 8 || idx == 9: return 3
    return 4

fn AstrologyBaziYinYangText(index: int32): str =
    if AstrologyBaziNormalizeMod(index, 2) == 0:
        return "阳"
    return "阴"

fn AstrologyBaziCangGanArrayJson(branchIndex: int32): str =
    let idx = AstrologyBaziNormalizeMod(branchIndex, 12)
    if idx == 0: return "[\"癸\"]"
    if idx == 1: return "[\"己\",\"癸\",\"辛\"]"
    if idx == 2: return "[\"甲\",\"丙\",\"戊\"]"
    if idx == 3: return "[\"乙\"]"
    if idx == 4: return "[\"戊\",\"乙\",\"癸\"]"
    if idx == 5: return "[\"丙\",\"庚\",\"戊\"]"
    if idx == 6: return "[\"丁\",\"己\"]"
    if idx == 7: return "[\"己\",\"丁\",\"乙\"]"
    if idx == 8: return "[\"庚\",\"壬\",\"戊\"]"
    if idx == 9: return "[\"辛\"]"
    if idx == 10: return "[\"戊\",\"辛\",\"丁\"]"
    return "[\"壬\",\"甲\"]"

fn AstrologyBaziMainCangGanIndex(branchIndex: int32): int32 =
    let idx = AstrologyBaziNormalizeMod(branchIndex, 12)
    if idx == 0: return 9
    if idx == 1: return 5
    if idx == 2: return 0
    if idx == 3: return 1
    if idx == 4: return 4
    if idx == 5: return 2
    if idx == 6: return 3
    if idx == 7: return 5
    if idx == 8: return 6
    if idx == 9: return 7
    if idx == 10: return 4
    return 8

fn AstrologyBaziNayinText(ganzhiIndex: int32): str =
    let pair = AstrologyBaziNormalizeMod(ganzhiIndex, 60) / 2
    if pair == 0: return "海中金"
    if pair == 1: return "炉中火"
    if pair == 2: return "大林木"
    if pair == 3: return "路旁土"
    if pair == 4: return "剑锋金"
    if pair == 5: return "山头火"
    if pair == 6: return "涧下水"
    if pair == 7: return "城头土"
    if pair == 8: return "白蜡金"
    if pair == 9: return "杨柳木"
    if pair == 10: return "泉中水"
    if pair == 11: return "屋上土"
    if pair == 12: return "霹雳火"
    if pair == 13: return "松柏木"
    if pair == 14: return "长流水"
    if pair == 15: return "砂中金"
    if pair == 16: return "山下火"
    if pair == 17: return "平地木"
    if pair == 18: return "壁上土"
    if pair == 19: return "金箔金"
    if pair == 20: return "覆灯火"
    if pair == 21: return "天河水"
    if pair == 22: return "大驿土"
    if pair == 23: return "钗钏金"
    if pair == 24: return "桑柘木"
    if pair == 25: return "大溪水"
    if pair == 26: return "沙中土"
    if pair == 27: return "天上火"
    if pair == 28: return "石榴木"
    return "大海水"

fn AstrologyBaziGanzhiText(ganzhiIndex: int32): str =
    let idx = AstrologyBaziNormalizeMod(ganzhiIndex, 60)
    return strings.ConcatStr(AstrologyBaziStemText(idx), AstrologyBaziBranchText(idx))

fn AstrologyBaziPillarJson(ganzhiIndex: int32): str =
    let idx = AstrologyBaziNormalizeMod(ganzhiIndex, 60)
    let ganIdx = AstrologyBaziNormalizeMod(idx, 10)
    let zhiIdx = AstrologyBaziNormalizeMod(idx, 12)
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyBaziJsonKey("gan"), AstrologyBaziJsonString(AstrologyBaziStemText(ganIdx))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("zhi"), AstrologyBaziJsonString(AstrologyBaziBranchText(zhiIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("ganWuxing"), AstrologyBaziJsonString(AstrologyBaziElementText(AstrologyBaziStemElementId(ganIdx))))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("zhiWuxing"), AstrologyBaziJsonString(AstrologyBaziElementText(AstrologyBaziBranchElementId(zhiIdx))))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("ganYinyang"), AstrologyBaziJsonString(AstrologyBaziYinYangText(ganIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("zhiYinyang"), AstrologyBaziJsonString(AstrologyBaziYinYangText(zhiIdx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("cangGan"), AstrologyBaziCangGanArrayJson(zhiIdx))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("nayin"), AstrologyBaziJsonString(AstrologyBaziNayinText(idx)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("ganIdx"), strings.IntToStr(ganIdx))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("zhiIdx"), strings.IntToStr(zhiIdx))))
    return strings.ConcatStr(out, "}")

fn AstrologyBaziShiShenText(dayGanIndex: int32, otherGanIndex: int32): str =
    if AstrologyBaziNormalizeMod(dayGanIndex, 10) == AstrologyBaziNormalizeMod(otherGanIndex, 10):
        return "比肩"
    let myElement = AstrologyBaziStemElementId(dayGanIndex)
    let otherElement = AstrologyBaziStemElementId(otherGanIndex)
    let sameYinYang = AstrologyBaziNormalizeMod(dayGanIndex, 2) == AstrologyBaziNormalizeMod(otherGanIndex, 2)
    if myElement == otherElement:
        return sameYinYang ? "比肩" : "劫财"
    if AstrologyBaziNormalizeMod(myElement + 1, 5) == otherElement:
        return sameYinYang ? "食神" : "伤官"
    if AstrologyBaziNormalizeMod(myElement + 2, 5) == otherElement:
        return sameYinYang ? "偏财" : "正财"
    if AstrologyBaziNormalizeMod(otherElement + 2, 5) == myElement:
        return sameYinYang ? "七杀" : "正官"
    if AstrologyBaziNormalizeMod(otherElement + 1, 5) == myElement:
        return sameYinYang ? "偏印" : "正印"
    return "未知"

fn AstrologyBaziDiShiText(dayGanIndex: int32, branchIndex: int32): str =
    let gan = AstrologyBaziNormalizeMod(dayGanIndex, 10)
    var offset: int32
    if gan == 0: offset = 1
    elif gan == 1: offset = 6
    elif gan == 2: offset = 10
    elif gan == 3: offset = 9
    elif gan == 4: offset = 10
    elif gan == 5: offset = 9
    elif gan == 6: offset = 7
    elif gan == 7: offset = 0
    elif gan == 8: offset = 4
    else: offset = 3
    var idx = offset
    if gan % 2 == 0:
        idx = idx + AstrologyBaziNormalizeMod(branchIndex, 12)
    else:
        idx = idx - AstrologyBaziNormalizeMod(branchIndex, 12)
    idx = AstrologyBaziNormalizeMod(idx, 12)
    if idx == 0: return "长生"
    if idx == 1: return "沐浴"
    if idx == 2: return "冠带"
    if idx == 3: return "临官"
    if idx == 4: return "帝旺"
    if idx == 5: return "衰"
    if idx == 6: return "病"
    if idx == 7: return "死"
    if idx == 8: return "墓"
    if idx == 9: return "绝"
    if idx == 10: return "胎"
    return "养"

fn AstrologyBaziXunKongJson(ganzhiIndex: int32): str =
    let idx = AstrologyBaziNormalizeMod(ganzhiIndex, 60)
    let diff = AstrologyBaziNormalizeMod(AstrologyBaziNormalizeMod(idx, 10) - AstrologyBaziNormalizeMod(idx, 12), 12)
    let xunIndex = diff / 2
    if xunIndex == 0: return "[\"戌\",\"亥\"]"
    if xunIndex == 1: return "[\"申\",\"酉\"]"
    if xunIndex == 2: return "[\"午\",\"未\"]"
    if xunIndex == 3: return "[\"辰\",\"巳\"]"
    if xunIndex == 4: return "[\"寅\",\"卯\"]"
    return "[\"子\",\"丑\"]"

fn AstrologyBaziStrengthForElement(wangElement: int32, element: int32): str =
    let wang = AstrologyBaziNormalizeMod(wangElement, 5)
    let item = AstrologyBaziNormalizeMod(element, 5)
    if item == wang:
        return "旺"
    if item == AstrologyBaziNormalizeMod(wang + 1, 5):
        return "相"
    if AstrologyBaziNormalizeMod(item + 1, 5) == wang:
        return "休"
    if AstrologyBaziNormalizeMod(item + 2, 5) == wang:
        return "囚"
    return "死"

fn AstrologyBaziWuxingStrengthJson(monthBranchIndex: int32): str =
    let wang = AstrologyBaziBranchElementId(monthBranchIndex)
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyBaziJsonKey("木"), AstrologyBaziJsonString(AstrologyBaziStrengthForElement(wang, 0))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("火"), AstrologyBaziJsonString(AstrologyBaziStrengthForElement(wang, 1)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("土"), AstrologyBaziJsonString(AstrologyBaziStrengthForElement(wang, 2)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("金"), AstrologyBaziJsonString(AstrologyBaziStrengthForElement(wang, 3)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("水"), AstrologyBaziJsonString(AstrologyBaziStrengthForElement(wang, 4)))))
    return strings.ConcatStr(out, "}")

fn AstrologyBaziWuxingCountJson(yearGz: int32, monthGz: int32, dayGz: int32, hourGz: int32): str =
    var counts: int32[5]
    # 局部数组内联累加, 规避 var int32[5] 形参不回写的编译器缺陷
    # (docs/repro/var_fixed_array_param_writeback); 局部动态下标写正常。
    let elems = [AstrologyBaziStemElementId(yearGz), AstrologyBaziBranchElementId(yearGz), AstrologyBaziStemElementId(monthGz), AstrologyBaziBranchElementId(monthGz), AstrologyBaziStemElementId(dayGz), AstrologyBaziBranchElementId(dayGz), AstrologyBaziStemElementId(hourGz), AstrologyBaziBranchElementId(hourGz)]
    for i in 0..<8:
        let idx = AstrologyBaziNormalizeMod(elems[i], 5)
        counts[idx] = counts[idx] + 1
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyBaziJsonKey("木"), strings.IntToStr(counts[0])))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("火"), strings.IntToStr(counts[1]))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("土"), strings.IntToStr(counts[2]))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("金"), strings.IntToStr(counts[3]))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("水"), strings.IntToStr(counts[4]))))
    return strings.ConcatStr(out, "}")

fn AstrologyBaziDayMasterStrength(yearGz: int32, monthGz: int32, dayGz: int32, hourGz: int32): str =
    let dayElement = AstrologyBaziStemElementId(dayGz)
    var support: int32
    let generatedBy = AstrologyBaziNormalizeMod(dayElement + 4, 5)
    let stems = [yearGz, monthGz, dayGz, hourGz]
    for i in 0..<4:
        let stemElement = AstrologyBaziStemElementId(stems[i])
        if stemElement == dayElement || stemElement == generatedBy:
            support = support + 1
        let branchElement = AstrologyBaziBranchElementId(stems[i])
        if branchElement == dayElement || branchElement == generatedBy:
            support = support + 1
    if support * 100 >= 480:
        return "强"
    if support * 100 <= 280:
        return "弱"
    return "中和"

fn AstrologyBaziLiunianJson(startYear: int32, count: int32): str =
    var out = "["
    for i in 0..<count:
        if i > 0:
            out = strings.ConcatStr(out, ",")
        let year = startYear + i
        let gz = AstrologyBaziNormalizeMod(year - 4, 60)
        var item = "{"
        item = strings.ConcatStr(item, strings.ConcatStr(AstrologyBaziJsonKey("year"), strings.IntToStr(year)))
        item = strings.ConcatStr(item, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("gan"), AstrologyBaziJsonString(AstrologyBaziStemText(gz)))))
        item = strings.ConcatStr(item, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("zhi"), AstrologyBaziJsonString(AstrologyBaziBranchText(gz)))))
        item = strings.ConcatStr(item, "}")
        out = strings.ConcatStr(out, item)
    return strings.ConcatStr(out, "]")

fn AstrologyBaziPrevNextJieMinutes(parts: AstrologyBaziSolarParts, prevOut: var int32, nextOut: var int32): bool =
    let current = scalar.AstrologyScalarMinutesSince1900(parts.year, parts.month, parts.day, parts.hour * 60 + parts.minute)
    var prev: int32 = -2147483648
    var next: int32 = 2147483647
    for year in (parts.year - 1)..(parts.year + 1):
        for slot in 0..<16:
            let value = jieMinute.V3AstrologyScalarJieBoundaryMinute(year, slot)
            if value <= current && value > prev:
                prev = value
            if value > current && value < next:
                next = value
    if prev == -2147483648 || next == 2147483647:
        return false
    prevOut = prev
    nextOut = next
    return true

fn AstrologyBaziDayunStartSolar(parts: AstrologyBaziSolarParts, forward: bool, startSolar: var AstrologyBaziSolarParts): bool =
    var prev: int32
    var next: int32
    if !AstrologyBaziPrevNextJieMinutes(parts, prev, next):
        return false
    let current = scalar.AstrologyScalarMinutesSince1900(parts.year, parts.month, parts.day, parts.hour * 60 + parts.minute)
    var minutes = forward ? (next - current) : (current - prev)
    if minutes < 0:
        return false
    let startYears = minutes / 4320
    minutes = minutes - startYears * 4320
    let startMonths = minutes / 360
    minutes = minutes - startMonths * 360
    let startDays = minutes / 12
    minutes = minutes - startDays * 12
    let startHours = minutes * 2
    # Fresh lets: `out = <composite call>` reassignment emits a PAYLOAD_STORE
    # without an exact value definition, breaking the next call's transfer
    # authority. let-bindings publish clean defs.
    let afterYears = AstrologyBaziAddYears(parts, startYears)
    let afterMonths = AstrologyBaziAddMonths(afterYears, startMonths)
    let afterDays = AstrologyBaziAddDays(afterMonths, startDays)
    let afterHours = AstrologyBaziAddHours(afterDays, startHours)
    startSolar = afterHours
    return true

@borrows
fn AstrologyBaziDayunJson(parts: AstrologyBaziSolarParts,
                          gender: str,
                          yearGz: int32,
                          monthGz: int32,
                          currentYear: int32,
                          outStartAge: var int32,
                          outActiveIndex: var int32): str =
    outActiveIndex = -1
    let yearGanIndex = AstrologyBaziNormalizeMod(yearGz, 10)
    let yang = yearGanIndex % 2 == 0
    let man = gender == "男"
    let forward = (yang && man) || (!yang && !man)
    var startSolar: AstrologyBaziSolarParts
    if !AstrologyBaziDayunStartSolar(parts, forward, startSolar):
        outStartAge = 1
        return "[]"
    var out = "["
    var first = true
    for i in 1..<12:
        let startYear = startSolar.year + (i - 1) * 10
        let startAge = startYear - parts.year + 1
        let endAge = startAge + 9
        if startAge <= 0:
            continue
        if first:
            first = false
            outStartAge = startAge
        else:
            out = strings.ConcatStr(out, ",")
        let gz = AstrologyBaziNormalizeMod(monthGz + (forward ? i : (0 - i)), 60)
        var item = "{"
        item = strings.ConcatStr(item, strings.ConcatStr(AstrologyBaziJsonKey("startAge"), strings.IntToStr(startAge)))
        item = strings.ConcatStr(item, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("endAge"), strings.IntToStr(endAge))))
        item = strings.ConcatStr(item, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("startYear"), strings.IntToStr(startYear))))
        item = strings.ConcatStr(item, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("gan"), AstrologyBaziJsonString(AstrologyBaziStemText(gz)))))
        item = strings.ConcatStr(item, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("zhi"), AstrologyBaziJsonString(AstrologyBaziBranchText(gz)))))
        item = strings.ConcatStr(item, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("ganWuxing"), AstrologyBaziJsonString(AstrologyBaziElementText(AstrologyBaziStemElementId(gz))))))
        item = strings.ConcatStr(item, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("zhiWuxing"), AstrologyBaziJsonString(AstrologyBaziElementText(AstrologyBaziBranchElementId(gz))))))
        item = strings.ConcatStr(item, "}")
        out = strings.ConcatStr(out, item)
        let age = currentYear - parts.year
        if age >= startAge && age <= endAge:
            outActiveIndex = i - 1
    if first:
        outStartAge = 1
    return strings.ConcatStr(out, "]")

fn AstrologyBaziLongitudeCorrectionMinutes(longitudeMilli: int32): int32 =
    let deltaMilli = (longitudeMilli - 120000) * 4
    return AstrologyBaziFloorDiv(deltaMilli + 500, 1000)

@borrows
fn AstrologyBaziProfileJson(useTrueSolarTime: bool, lateZiBoundary: str): str =
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyBaziJsonKey("profileId"), AstrologyBaziJsonString("wenmo-basic-v1")))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("useTrueSolarTime"), useTrueSolarTime ? "true" : "false")))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("lateZiBoundary"), AstrologyBaziJsonString(lateZiBoundary))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("monthBoundary"), AstrologyBaziJsonString("jieqi"))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("dayunStartMode"), AstrologyBaziJsonString("exact-jieqi-diff"))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("ziweiDaxianDirection"), AstrologyBaziJsonString("gender-year-yinyang"))))
    return strings.ConcatStr(out, "}")

@borrows
fn AstrologyBaziInputJson(year: int32,
                          month: int32,
                          day: int32,
                          hour: int32,
                          minute: int32,
                          timezone: str,
                          longitudeMilli: int32,
                          hasLongitude: bool,
                          gender: str): str =
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyBaziJsonKey("calendar"), AstrologyBaziJsonString("solar")))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("year"), strings.IntToStr(year))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("month"), strings.IntToStr(month))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("day"), strings.IntToStr(day))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("hour"), strings.IntToStr(hour))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("minute"), strings.IntToStr(minute))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("timezone"), AstrologyBaziJsonString(timezone))))
    if hasLongitude:
        let whole = longitudeMilli / 1000
        var frac = longitudeMilli % 1000
        if frac < 0:
            frac = 0 - frac
        var fracText = strings.IntToStr(frac)
        if frac < 10:
            fracText = strings.ConcatStr("00", fracText)
        elif frac < 100:
            fracText = strings.ConcatStr("0", fracText)
        out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("longitude"), strings.ConcatStr(strings.ConcatStr(strings.IntToStr(whole), "."), fracText))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("gender"), AstrologyBaziJsonString(gender))))
    return strings.ConcatStr(out, "}")

# Owned copy helper usable on borrowed strings (ConcatStr would consume).
@borrows
fn AstrologyBaziCloneStr(value: str): str =
    var out = ""
    for i in 0..<value.len:
        out = strings.ConcatStr(out, strings.CharToStr(value[i]))
    return out

@borrows
fn AstrologyBaziBuildResultJson(year: int32,
                                month: int32,
                                day: int32,
                                hour: int32,
                                minute: int32,
                                gender: str,
                                timezone: str,
                                longitudeMilli: int32,
                                hasLongitude: bool,
                                useTrueSolarTime: bool,
                                lateZiBoundary: str,
                                currentYear: int32,
                                outJson: var str,
                                outActiveDayunIdx: var int32): bool =
    var inputParts: AstrologyBaziSolarParts
    inputParts.year = year
    inputParts.month = month
    inputParts.day = day
    inputParts.hour = hour
    inputParts.minute = minute
    if !AstrologyBaziSolarValid(inputParts):
        return false
    # Call-result def on every path: a field-built struct carries no exact
    # def, which made the hasLongitude merge ambiguous (one side def-less).
    var solarParts = AstrologyBaziAddMinutes(inputParts, 0)
    if useTrueSolarTime:
        if timezone != "Asia/Shanghai" && timezone != "":
            return false
        if hasLongitude:
            solarParts = AstrologyBaziAddMinutes(solarParts, AstrologyBaziLongitudeCorrectionMinutes(longitudeMilli))
            if !AstrologyBaziSolarValid(solarParts):
                return false
    let hm = solarParts.hour * 60 + solarParts.minute
    let yearGz = scalar.AstrologyScalarYearGanzhiExactIndex(solarParts.year, solarParts.month, solarParts.day, hm)
    let monthGz = scalar.AstrologyScalarMonthGanzhiExactIndex(solarParts.year, solarParts.month, solarParts.day, hm)
    let dayBaseGz = scalar.AstrologyScalarDayGanzhiIndex(solarParts.year, solarParts.month, solarParts.day)
    var dayGz = dayBaseGz
    if lateZiBoundary == "23:00" && solarParts.hour == 23:
        dayGz = AstrologyBaziNormalizeMod(dayBaseGz + 1, 60)
    let hourGz = scalar.AstrologyScalarHourGanzhiIndex(dayBaseGz, solarParts.hour, solarParts.minute, 1)
    let dayGan = AstrologyBaziNormalizeMod(dayGz, 10)
    let yearZhi = AstrologyBaziNormalizeMod(yearGz, 12)
    let monthZhi = AstrologyBaziNormalizeMod(monthGz, 12)
    let dayZhi = AstrologyBaziNormalizeMod(dayGz, 12)
    let hourZhi = AstrologyBaziNormalizeMod(hourGz, 12)
    var dayunStartAge: int32
    var activeIdx: int32
    let dayunJson = AstrologyBaziDayunJson(solarParts, AstrologyBaziCloneStr(gender), yearGz, monthGz, currentYear, dayunStartAge, activeIdx)
    outActiveDayunIdx = activeIdx
    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyBaziJsonKey("yearPillar"), AstrologyBaziPillarJson(yearGz)))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("monthPillar"), AstrologyBaziPillarJson(monthGz))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("dayPillar"), AstrologyBaziPillarJson(dayGz))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("hourPillar"), AstrologyBaziPillarJson(hourGz))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("dayGan"), AstrologyBaziJsonString(AstrologyBaziStemText(dayGan)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("wuxingCount"), AstrologyBaziWuxingCountJson(yearGz, monthGz, dayGz, hourGz))))
    var shiShen = "{"
    shiShen = strings.ConcatStr(shiShen, strings.ConcatStr(AstrologyBaziJsonKey("yearGan"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, yearGz))))
    shiShen = strings.ConcatStr(shiShen, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("monthGan"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, monthGz)))))
    shiShen = strings.ConcatStr(shiShen, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("hourGan"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, hourGz)))))
    shiShen = strings.ConcatStr(shiShen, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("yearZhi"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, AstrologyBaziMainCangGanIndex(yearZhi))))))
    shiShen = strings.ConcatStr(shiShen, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("monthZhi"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, AstrologyBaziMainCangGanIndex(monthZhi))))))
    shiShen = strings.ConcatStr(shiShen, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("hourZhi"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, AstrologyBaziMainCangGanIndex(hourZhi))))))
    shiShen = strings.ConcatStr(shiShen, "}")
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("shiShen"), shiShen)))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("dayMasterStrength"), AstrologyBaziJsonString(AstrologyBaziDayMasterStrength(yearGz, monthGz, dayGz, hourGz)))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("gender"), AstrologyBaziJsonString(gender))))
    var napilar = "{"
    napilar = strings.ConcatStr(napilar, strings.ConcatStr(AstrologyBaziJsonKey("year"), AstrologyBaziJsonString(AstrologyBaziNayinText(yearGz))))
    napilar = strings.ConcatStr(napilar, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("month"), AstrologyBaziJsonString(AstrologyBaziNayinText(monthGz)))))
    napilar = strings.ConcatStr(napilar, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("day"), AstrologyBaziJsonString(AstrologyBaziNayinText(dayGz)))))
    napilar = strings.ConcatStr(napilar, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("hour"), AstrologyBaziJsonString(AstrologyBaziNayinText(hourGz)))))
    napilar = strings.ConcatStr(napilar, "}")
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("napilar"), napilar)))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("dayun"), dayunJson)))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("dayunStartAge"), strings.IntToStr(dayunStartAge))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("liunian"), AstrologyBaziLiunianJson(currentYear - 1, 12))))
    var xingYun = "{"
    xingYun = strings.ConcatStr(xingYun, strings.ConcatStr(AstrologyBaziJsonKey("year"), AstrologyBaziJsonString(AstrologyBaziDiShiText(dayGan, yearZhi))))
    xingYun = strings.ConcatStr(xingYun, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("month"), AstrologyBaziJsonString(AstrologyBaziDiShiText(dayGan, monthZhi)))))
    xingYun = strings.ConcatStr(xingYun, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("day"), AstrologyBaziJsonString(AstrologyBaziDiShiText(dayGan, dayZhi)))))
    xingYun = strings.ConcatStr(xingYun, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("hour"), AstrologyBaziJsonString(AstrologyBaziDiShiText(dayGan, hourZhi)))))
    xingYun = strings.ConcatStr(xingYun, "}")
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("xingYun"), xingYun)))
    var kongWang = "{"
    kongWang = strings.ConcatStr(kongWang, strings.ConcatStr(AstrologyBaziJsonKey("day"), AstrologyBaziXunKongJson(dayGz)))
    kongWang = strings.ConcatStr(kongWang, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("year"), AstrologyBaziXunKongJson(yearGz))))
    kongWang = strings.ConcatStr(kongWang, "}")
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("kongWang"), kongWang)))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("wuxingStrength"), AstrologyBaziWuxingStrengthJson(monthZhi))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("birthYear"), strings.IntToStr(solarParts.year))))
    var shiShenZhi = "{"
    shiShenZhi = strings.ConcatStr(shiShenZhi, strings.ConcatStr(AstrologyBaziJsonKey("yearZhi"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, AstrologyBaziMainCangGanIndex(yearZhi)))))
    shiShenZhi = strings.ConcatStr(shiShenZhi, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("monthZhi"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, AstrologyBaziMainCangGanIndex(monthZhi))))))
    shiShenZhi = strings.ConcatStr(shiShenZhi, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("dayZhi"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, AstrologyBaziMainCangGanIndex(dayZhi))))))
    shiShenZhi = strings.ConcatStr(shiShenZhi, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("hourZhi"), AstrologyBaziJsonString(AstrologyBaziShiShenText(dayGan, AstrologyBaziMainCangGanIndex(hourZhi))))))
    shiShenZhi = strings.ConcatStr(shiShenZhi, "}")
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("shiShenZhi"), shiShenZhi)))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("input"), AstrologyBaziInputJson(year, month, day, hour, minute, timezone, longitudeMilli, hasLongitude, gender))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyBaziJsonKey("profile"), AstrologyBaziProfileJson(useTrueSolarTime, lateZiBoundary))))
    outJson = strings.ConcatStr(out, "}")
    return true

@borrows
fn AstrologyBaziGuideProfileFromInput(year: int32,
                                      month: int32,
                                      day: int32,
                                      hour: int32,
                                      minute: int32,
                                      timezone: str,
                                      longitudeMilli: int32,
                                      hasLongitude: bool,
                                      useTrueSolarTime: bool,
                                      lateZiBoundary: str,
                                      out: var AstrologyBaziGuideExtract): bool =
    var inputParts: AstrologyBaziSolarParts
    inputParts.year = year
    inputParts.month = month
    inputParts.day = day
    inputParts.hour = hour
    inputParts.minute = minute
    if !AstrologyBaziSolarValid(inputParts):
        return false
    # Call-result def on every path: a field-built struct carries no exact
    # def, which made the hasLongitude merge ambiguous (one side def-less).
    var solarParts = AstrologyBaziAddMinutes(inputParts, 0)
    if useTrueSolarTime:
        if timezone != "Asia/Shanghai" && timezone != "":
            return false
        if hasLongitude:
            solarParts = AstrologyBaziAddMinutes(solarParts, AstrologyBaziLongitudeCorrectionMinutes(longitudeMilli))
            if !AstrologyBaziSolarValid(solarParts):
                return false
    let hm = solarParts.hour * 60 + solarParts.minute
    let yearGz = scalar.AstrologyScalarYearGanzhiExactIndex(solarParts.year, solarParts.month, solarParts.day, hm)
    let monthGz = scalar.AstrologyScalarMonthGanzhiExactIndex(solarParts.year, solarParts.month, solarParts.day, hm)
    let dayBaseGz = scalar.AstrologyScalarDayGanzhiIndex(solarParts.year, solarParts.month, solarParts.day)
    var dayGz = dayBaseGz
    if lateZiBoundary == "23:00" && solarParts.hour == 23:
        dayGz = AstrologyBaziNormalizeMod(dayBaseGz + 1, 60)
    let hourGz = scalar.AstrologyScalarHourGanzhiIndex(dayBaseGz, solarParts.hour, solarParts.minute, 1)
    let dayGan = AstrologyBaziNormalizeMod(dayGz, 10)
    let yearZhi = AstrologyBaziNormalizeMod(yearGz, 12)
    # wuxing 计数与 AstrologyBaziWuxingCountJson 同源(4 柱天干+地支的五行), 但内联标量累加,
    # 规避共享 AstrologyBaziAddElementCount 对 var int32[5] 形参不回写的既有缺陷。
    let elems = [AstrologyBaziStemElementId(yearGz), AstrologyBaziBranchElementId(yearGz), AstrologyBaziStemElementId(monthGz), AstrologyBaziBranchElementId(monthGz), AstrologyBaziStemElementId(dayGz), AstrologyBaziBranchElementId(dayGz), AstrologyBaziStemElementId(hourGz), AstrologyBaziBranchElementId(hourGz)]
    var wood = 0
    var fire = 0
    var earth = 0
    var metal = 0
    var water = 0
    for i in 0..<8:
        let e = AstrologyBaziNormalizeMod(elems[i], 5)
        if e == 0:
            wood = wood + 1
        elif e == 1:
            fire = fire + 1
        elif e == 2:
            earth = earth + 1
        elif e == 3:
            metal = metal + 1
        else:
            water = water + 1
    let strengthText = AstrologyBaziDayMasterStrength(yearGz, monthGz, dayGz, hourGz)
    var strengthValue = 1
    if strengthText == "强":
        strengthValue = 2
    elif strengthText == "弱":
        strengthValue = -1
    out.dayGanIndex = dayGan
    out.yearZhiIndex = yearZhi
    out.dayMasterStrengthValue = strengthValue
    out.wuxingWood = wood
    out.wuxingFire = fire
    out.wuxingEarth = earth
    out.wuxingMetal = metal
    out.wuxingWater = water
    out.dayGanText = AstrologyBaziStemText(dayGan)
    return true
