    if index == 4: return "亨，君子有终。"
    if index == 5: return "利艰贞。"
    if index == 6: return "元亨，用见大人，勿恤，南征吉。"
    if index == 7: return "小往大来，吉亨。"
    if index == 8: return "利建侯行师。"
    if index == 9: return "亨，震来虩虩，笑言哑哑。"
