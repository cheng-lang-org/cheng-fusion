# ---------------------------------------------------------------------------
# PWA buildAstrologyDailyGuideFromRuntime 的忠实移植 (app/domain/astrology/dailyGuide.ts).
# 输出 JSON 键集与 AstrologyDailyGuide 完全一致。birth 盘走 bazi/ziwei core,
# 今日 transit 走 calendar core + scalar abi, 组装与文本逐字对齐 PWA。
# ---------------------------------------------------------------------------

fn AstrologyArchiveJsonAppendEscapedChar(out: str, ch: char): str =
    if ch == '"':
        return strings.ConcatStr(out, "\\\"")
    if ch == '\\':
        return strings.ConcatStr(out, "\\\\")
    if ch == '\n':
        return strings.ConcatStr(out, "\\n")
    if ch == '\r':
        return strings.ConcatStr(out, "\\r")
    if ch == '\t':
        return strings.ConcatStr(out, "\\t")
    return strings.ConcatStr(out, strings.CharToStr(ch))

@borrows
fn AstrologyArchiveJsonString(value: str): str =
    var out = "\""
    for i in 0..<value.len:
        out = AstrologyArchiveJsonAppendEscapedChar(out, value[i])
    return strings.ConcatStr(out, "\"")

@borrows
fn AstrologyArchiveJsonKey(key: str): str =
    return strings.ConcatStr(AstrologyArchiveJsonString(key), ":")

# currentSolarParts 的时区集合: 只覆盖无 DST 的恒定偏移时区 (逐个核实)。
# 空串按 PWA `input.timezone || 'Asia/Shanghai'` 语义回落到上海。
# 未知时区一律诚实失败 (return false), 严禁默默当成上海。
@borrows
fn AstrologyArchiveTimezoneOffsetMinutes(timezone: str, out: var int32): bool =
    if timezone == "" || timezone == "Asia/Shanghai" || timezone == "Asia/Chongqing":
        out = 480
        return true
    if timezone == "Asia/Hong_Kong" || timezone == "Asia/Macau" || timezone == "Asia/Taipei" || timezone == "Asia/Singapore" || timezone == "Asia/Kuala_Lumpur" || timezone == "Asia/Manila":
        out = 480
        return true
    if timezone == "Asia/Urumqi":
        out = 360
        return true
    if timezone == "Asia/Tokyo" || timezone == "Asia/Seoul":
        out = 540
        return true
    if timezone == "Asia/Bangkok" || timezone == "Asia/Ho_Chi_Minh" || timezone == "Asia/Jakarta":
        out = 420
        return true
    if timezone == "Asia/Kolkata":
        out = 330
        return true
    if timezone == "Asia/Dubai":
        out = 240
        return true
    if timezone == "UTC" || timezone == "Etc/UTC":
        out = 0
        return true
    return false

# nowEpochMs (UTC ms) + 时区固定偏移 -> 本地民用 Y/M/D/H/M。
# Unix 纪元 1970-01-01 对应 JDN 2440588, 复用 cal.AstrologyJdnToSolar 还原公历。
fn AstrologyArchiveCurrentSolar(offsetMinutes: int32, nowEpochMs: int64): cal.AstrologySolarDate =
    let totalMinutes: int64 = nowEpochMs / Int64(60000) + Int64(offsetMinutes)
    var days: int64 = totalMinutes / Int64(1440)
    var minuteOfDay: int64 = totalMinutes % Int64(1440)
    if minuteOfDay < Int64(0):
        days = days - Int64(1)
        minuteOfDay = minuteOfDay + Int64(1440)
    let dayIndex: int32 = Int32(days)
    let hour: int32 = Int32(minuteOfDay / Int64(60))
    let minute: int32 = Int32(minuteOfDay % Int64(60))
    let jdn: int32 = dayIndex + 2440588
    let solar = cal.AstrologyJdnToSolar(jdn)
    return cal.AstrologySolarDateMake(solar.year, solar.month, solar.day, hour, minute)

fn AstrologyArchiveLunarMonthText(month: int32): str =
    if month == 1: return "正"
    if month == 2: return "二"
    if month == 3: return "三"
    if month == 4: return "四"
    if month == 5: return "五"
    if month == 6: return "六"
    if month == 7: return "七"
    if month == 8: return "八"
    if month == 9: return "九"
    if month == 10: return "十"
    if month == 11: return "冬"
    if month == 12: return "腊"
    return strings.IntToStr(month)

