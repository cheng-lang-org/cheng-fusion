fn AstrologyArchiveRelationLabel(dayElement: int32, otherElement: int32): str =
    let base = cal.AstrologyNormalizeMod(dayElement, 5)
    let other = cal.AstrologyNormalizeMod(otherElement, 5)
    if base == other:
        return "同气"
    if cal.AstrologyNormalizeMod(other + 1, 5) == base:
        return "生扶"
    if cal.AstrologyNormalizeMod(other + 2, 5) == base:
        return "克压"
    if cal.AstrologyNormalizeMod(base + 1, 5) == other:
        return "泄气"
    return "耗制"

fn AstrologyArchivePillarTrendLabel(score: int32): str =
    if score >= 3:
        return "明显生扶"
    if score >= 1:
        return "偏扶"
    if score <= -3:
        return "明显克泄"
    if score <= -1:
        return "偏耗"
    return "平衡"

fn AstrologyArchiveWeightedScoreLabel(score: int32): str =
    if score >= 6:
        return "整体偏顺，可主动推进。"
    if score >= 2:
        return "整体可推，但先顺时序。"
    if score <= -6:
        return "整体压制明显，宜先收口。"
    if score <= -2:
        return "整体偏紧，宜先稳后动。"
    return "整体平平，按轻重缓急处理。"

# pillarScoreAgainstDayMaster(dayElement, ganzhiText): 用 transit 干支 index 直取
# 天干/地支 五行, 与 elementSupportScore 累加 (等价于 PWA splitGanzhiText 反查)。
fn AstrologyArchivePillarScore(dayElement: int32, gzIndex: int32): int32 =
    let stemElement = guide.AstrologyStemElementId(cal.AstrologyNormalizeMod(gzIndex, 10))
    let branchElement = guide.AstrologyBranchElementId(cal.AstrologyNormalizeMod(gzIndex, 12))
    return guide.AstrologyElementSupportScore(dayElement, stemElement) + guide.AstrologyElementSupportScore(dayElement, branchElement)

@borrows
fn AstrologyArchiveBranchIndex(text: str): int32 =
    if text == "子": return 0
    if text == "丑": return 1
    if text == "寅": return 2
    if text == "卯": return 3
    if text == "辰": return 4
    if text == "巳": return 5
    if text == "午": return 6
    if text == "未": return 7
    if text == "申": return 8
    if text == "酉": return 9
    if text == "戌": return 10
    if text == "亥": return 11
    return 0

fn AstrologyArchiveBranchRelationLabel(baseBranchIndex: int32, transitBranchIndex: int32): str =
    let delta = cal.AstrologyNormalizeMod(transitBranchIndex - baseBranchIndex, 12)
    if delta == 0:
        return "直临"
    if delta == 6:
        return "对冲"
    if delta == 4 || delta == 8:
        return "三合引动"
    if delta == 1 || delta == 11:
        return "邻位牵动"
    return "过宫牵引"

fn AstrologyArchiveZiweiFocus(elementId: int32,
                              relationScore: int32,
                              careerScore: int32,
                              wealthScore: int32,
                              healthScore: int32,
                              learningScore: int32,
                              expressionScore: int32): str =
    let e = cal.AstrologyNormalizeMod(elementId, 5)
    if e == 0:
        return careerScore >= learningScore ? "事业" : "学习"
    if e == 1:
        return expressionScore >= relationScore ? "表达" : "关系"
    if e == 2:
        return wealthScore >= healthScore ? "财务" : "健康"
    if e == 3:
        return wealthScore >= learningScore ? "财务" : "学习"
    return relationScore >= healthScore ? "关系" : "健康"

fn AstrologyArchiveCalendarReference(yearGanzhiText: str, monthGanzhiText: str, dayGanzhiText: str): str =
    return strutil.Join(["万年历参考：年柱", yearGanzhiText, "主外部背景，月柱", monthGanzhiText, "主当月节令，日柱", dayGanzhiText, "主当天触发，今天先看日柱，再看月柱。"], "")

fn AstrologyArchiveBaziReference(dayGanText: str,
                                 dayElement: int32,
                                 yearGzIndex: int32,
                                 monthGzIndex: int32,
                                 dayGzIndex: int32,
                                 yearGanzhiText: str,
                                 monthGanzhiText: str,
                                 dayGanzhiText: str): str =
    let yearScore = AstrologyArchivePillarScore(dayElement, yearGzIndex)
    let monthScore = AstrologyArchivePillarScore(dayElement, monthGzIndex)
    let dayScore = AstrologyArchivePillarScore(dayElement, dayGzIndex)
    let yearStemRelation = AstrologyArchiveRelationLabel(dayElement, guide.AstrologyStemElementId(cal.AstrologyNormalizeMod(yearGzIndex, 10)))
    let monthStemRelation = AstrologyArchiveRelationLabel(dayElement, guide.AstrologyStemElementId(cal.AstrologyNormalizeMod(monthGzIndex, 10)))
    let dayStemRelation = AstrologyArchiveRelationLabel(dayElement, guide.AstrologyStemElementId(cal.AstrologyNormalizeMod(dayGzIndex, 10)))
    let weighted = yearScore + monthScore * 2 + dayScore * 3
    return strutil.Join(["八字参考：日主", dayGanText, "。年柱", yearGanzhiText, yearStemRelation, "，整体", AstrologyArchivePillarTrendLabel(yearScore), "；月柱", monthGanzhiText, monthStemRelation, "，整体", AstrologyArchivePillarTrendLabel(monthScore), "；日柱", dayGanzhiText, dayStemRelation, "，整体", AstrologyArchivePillarTrendLabel(dayScore), "；", AstrologyArchiveWeightedScoreLabel(weighted)], "")

fn AstrologyArchiveZiweiReference(mingGongDizhi: str,
                                  shenGongDizhi: str,
                                  relationScore: int32,
                                  careerScore: int32,
                                  wealthScore: int32,
                                  healthScore: int32,
                                  learningScore: int32,
                                  expressionScore: int32,
                                  yearGzIndex: int32,
                                  monthGzIndex: int32,
                                  dayGzIndex: int32,
                                  yearGanzhiText: str,
                                  monthGanzhiText: str,
                                  dayGanzhiText: str): str =
    let mingBranchIndex = AstrologyArchiveBranchIndex(mingGongDizhi)
    let shenBranchIndex = AstrologyArchiveBranchIndex(shenGongDizhi)
    let yearFocus = AstrologyArchiveZiweiFocus(guide.AstrologyStemElementId(cal.AstrologyNormalizeMod(yearGzIndex, 10)), relationScore, careerScore, wealthScore, healthScore, learningScore, expressionScore)
    let monthFocus = AstrologyArchiveZiweiFocus(guide.AstrologyStemElementId(cal.AstrologyNormalizeMod(monthGzIndex, 10)), relationScore, careerScore, wealthScore, healthScore, learningScore, expressionScore)
    let dayFocus = AstrologyArchiveZiweiFocus(guide.AstrologyStemElementId(cal.AstrologyNormalizeMod(dayGzIndex, 10)), relationScore, careerScore, wealthScore, healthScore, learningScore, expressionScore)
    let yearBranchIndex = cal.AstrologyNormalizeMod(yearGzIndex, 12)
    let monthBranchIndex = cal.AstrologyNormalizeMod(monthGzIndex, 12)
    let dayBranchIndex = cal.AstrologyNormalizeMod(dayGzIndex, 12)
    let yearBranchText = cal.AstrologyBranchText(yearBranchIndex)
    let monthBranchText = cal.AstrologyBranchText(monthBranchIndex)
    let dayBranchText = cal.AstrologyBranchText(dayBranchIndex)
    return strutil.Join(["紫微参考：年柱", yearGanzhiText, "把重心牵到", yearFocus, "，", yearBranchText, AstrologyArchiveBranchRelationLabel(mingBranchIndex, yearBranchIndex), "命宫；月柱", monthGanzhiText, "把重心牵到", monthFocus, "，", monthBranchText, AstrologyArchiveBranchRelationLabel(shenBranchIndex, monthBranchIndex), "身宫；日柱", dayGanzhiText, "把重心落到", dayFocus, "，", dayBranchText, AstrologyArchiveBranchRelationLabel(mingBranchIndex, dayBranchIndex), "命宫；今天先看日柱触发，再看月柱延续。"], "")

@borrows
fn AstrologyArchiveDailyGuideJson(birthYear: int32,
                                  birthMonth: int32,
                                  birthDay: int32,
                                  birthHour: int32,
                                  birthMinute: int32,
                                  gender: str,
                                  timezone: str,
                                  longitudeMilli: int32,
                                  hasLongitude: bool,
                                  useTrueSolarTime: bool,
                                  lateZiBoundary: str,
                                  nowEpochMs: int64,
                                  outJson: var str): bool =
    if gender != "男" && gender != "女":
        return false
    var effectiveLateZi = strings.CloneStr(lateZiBoundary)
    if effectiveLateZi.len == 0:
        effectiveLateZi = "00:00"
    if effectiveLateZi != "00:00" && effectiveLateZi != "23:00":
        return false

    var offsetMinutes: int32
    if !AstrologyArchiveTimezoneOffsetMinutes(timezone, offsetMinutes):
        return false

    var baziExtract = bazi.AstrologyBaziGuideExtract()
    if !bazi.AstrologyBaziGuideProfileFromInput(birthYear, birthMonth, birthDay, birthHour, birthMinute, strings.CloneStr(timezone), longitudeMilli, hasLongitude, useTrueSolarTime, strings.CloneStr(effectiveLateZi), baziExtract):
        return false

    var ziweiExtract = ziwei.AstrologyZiweiGuideExtract()
    if !ziwei.AstrologyZiweiGuideScoreFromInput("solar", birthYear, birthMonth, birthDay, birthHour, birthMinute, strings.CloneStr(gender), strings.CloneStr(timezone), longitudeMilli, hasLongitude, useTrueSolarTime, ziweiExtract):
        return false

    let currentSolar = AstrologyArchiveCurrentSolar(offsetMinutes, nowEpochMs)
    let lateZiAt23 = effectiveLateZi == "23:00"
    let stateRes = cal.AstrologyCalendarStateFromSolar(currentSolar, lateZiAt23)
    if IsErr(stateRes):
        return false
    let state = Value(stateRes)

    let todayHm = currentSolar.hour * 60 + currentSolar.minute
    let yearGzIndex = scalar.AstrologyScalarYearGanzhiExactIndex(currentSolar.year, currentSolar.month, currentSolar.day, todayHm)
    let monthGzIndex = scalar.AstrologyScalarMonthGanzhiExactIndex(currentSolar.year, currentSolar.month, currentSolar.day, todayHm)
    let dayGzIndex = state.dayGanzhiIndex
    let yearGanzhiText = cal.AstrologyGanzhiText(yearGzIndex)
    let monthGanzhiText = cal.AstrologyGanzhiText(monthGzIndex)
    let dayGanzhiText = state.dayGanzhiText
    let hourGanzhiText = state.hourGanzhiText

    var baziProfile = guide.AstrologyBaziGuideProfile()
    baziProfile.dayGanIndex = baziExtract.dayGanIndex
    baziProfile.yearZhiIndex = baziExtract.yearZhiIndex
    baziProfile.dayMasterStrength = baziExtract.dayMasterStrengthValue
    baziProfile.wuxingWood = baziExtract.wuxingWood
    baziProfile.wuxingFire = baziExtract.wuxingFire
    baziProfile.wuxingEarth = baziExtract.wuxingEarth
    baziProfile.wuxingMetal = baziExtract.wuxingMetal
    baziProfile.wuxingWater = baziExtract.wuxingWater

    var ziweiProfile = guide.AstrologyZiweiGuideProfile()
    ziweiProfile.mingGongIndex = ziweiExtract.mingGongIndex
    ziweiProfile.shenGongIndex = ziweiExtract.shenGongIndex
    ziweiProfile.relationScore = ziweiExtract.relationScore
    ziweiProfile.careerScore = ziweiExtract.careerScore
    ziweiProfile.wealthScore = ziweiExtract.wealthScore
    ziweiProfile.healthScore = ziweiExtract.healthScore
    ziweiProfile.learningScore = ziweiExtract.learningScore
    ziweiProfile.expressionScore = ziweiExtract.expressionScore
    ziweiProfile.siHuaScore = ziweiExtract.siHuaScore

    let core = guide.AstrologyDailyGuideCompute(state, baziProfile, ziweiProfile)

    let dayElement = guide.AstrologyStemElementId(baziExtract.dayGanIndex)
    let calendarReference = AstrologyArchiveCalendarReference(strings.CloneStr(yearGanzhiText), strings.CloneStr(monthGanzhiText), strings.CloneStr(dayGanzhiText))
    let baziReference = AstrologyArchiveBaziReference(strings.CloneStr(baziExtract.dayGanText), dayElement, yearGzIndex, monthGzIndex, dayGzIndex, strings.CloneStr(yearGanzhiText), strings.CloneStr(monthGanzhiText), strings.CloneStr(dayGanzhiText))
    let ziweiReference = AstrologyArchiveZiweiReference(strings.CloneStr(ziweiExtract.mingGongDizhi), strings.CloneStr(ziweiExtract.shenGongDizhi), ziweiExtract.relationScore, ziweiExtract.careerScore, ziweiExtract.wealthScore, ziweiExtract.healthScore, ziweiExtract.learningScore, ziweiExtract.expressionScore, yearGzIndex, monthGzIndex, dayGzIndex, strings.CloneStr(yearGanzhiText), strings.CloneStr(monthGanzhiText), strings.CloneStr(dayGanzhiText))
    let summary = AstrologyArchiveHexagramBriefByIndex(core.hexagramIndex)

    let lunarMonthText = AstrologyArchiveLunarMonthText(state.lunar.month)
    let lunarDayText = AstrologyArchiveLunarDayText(state.lunar.day)

    var out = "{"
    out = strings.ConcatStr(out, strings.ConcatStr(AstrologyArchiveJsonKey("generatedAt"), strings.Int64ToStr(nowEpochMs)))

    var solarObj = "{"
    solarObj = strings.ConcatStr(solarObj, strings.ConcatStr(AstrologyArchiveJsonKey("year"), strings.IntToStr(currentSolar.year)))
    solarObj = strings.ConcatStr(solarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("month"), strings.IntToStr(currentSolar.month))))
    solarObj = strings.ConcatStr(solarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("day"), strings.IntToStr(currentSolar.day))))
    solarObj = strings.ConcatStr(solarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("hour"), strings.IntToStr(currentSolar.hour))))
    solarObj = strings.ConcatStr(solarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("minute"), strings.IntToStr(currentSolar.minute))))
    solarObj = strings.ConcatStr(solarObj, "}")
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("currentSolar"), solarObj)))

    var lunarObj = "{"
    lunarObj = strings.ConcatStr(lunarObj, strings.ConcatStr(AstrologyArchiveJsonKey("year"), strings.IntToStr(state.lunar.year)))
    lunarObj = strings.ConcatStr(lunarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("month"), strings.IntToStr(state.lunar.month))))
    lunarObj = strings.ConcatStr(lunarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("day"), strings.IntToStr(state.lunar.day))))
    lunarObj = strings.ConcatStr(lunarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("leap"), state.lunar.leap ? "true" : "false")))
    lunarObj = strings.ConcatStr(lunarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("monthText"), AstrologyArchiveJsonString(lunarMonthText))))
    lunarObj = strings.ConcatStr(lunarObj, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("dayText"), AstrologyArchiveJsonString(lunarDayText))))
    lunarObj = strings.ConcatStr(lunarObj, "}")
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("currentLunar"), lunarObj)))

    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("yearGanzhiText"), AstrologyArchiveJsonString(yearGanzhiText))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("monthGanzhiText"), AstrologyArchiveJsonString(monthGanzhiText))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("dayGanzhiText"), AstrologyArchiveJsonString(dayGanzhiText))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("hourGanzhiText"), AstrologyArchiveJsonString(hourGanzhiText))))

    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("hexagramIndex"), strings.IntToStr(core.hexagramIndex))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("hexagramName"), AstrologyArchiveJsonString(core.hexagramName))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("upperTrigramIndex"), strings.IntToStr(core.upperTrigramIndex))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("upperTrigramName"), AstrologyArchiveJsonString(core.upperTrigramName))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("lowerTrigramIndex"), strings.IntToStr(core.lowerTrigramIndex))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("lowerTrigramName"), AstrologyArchiveJsonString(core.lowerTrigramName))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("movingLine"), strings.IntToStr(core.movingLine))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("changedHexagramIndex"), strings.IntToStr(core.changedHexagramIndex))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("changedHexagramName"), AstrologyArchiveJsonString(core.changedHexagramName))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("actionCode"), AstrologyArchiveJsonString(core.actionCode))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("bitPattern"), AstrologyArchiveJsonString(core.bitPattern))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("summary"), AstrologyArchiveJsonString(summary))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("calendarReference"), AstrologyArchiveJsonString(calendarReference))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("baziReference"), AstrologyArchiveJsonString(baziReference))))
    out = strings.ConcatStr(out, strings.ConcatStr(",", strings.ConcatStr(AstrologyArchiveJsonKey("ziweiReference"), AstrologyArchiveJsonString(ziweiReference))))
    outJson = strings.ConcatStr(out, "}")
    return true
