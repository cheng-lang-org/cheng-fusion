# build_ascent (F): the film-edit entry, built as a three-pass pipeline.
# Pass 1 (serial) runs the 2400-tick climb physics and dumps one render
# state file plus one camera/caption parameter file per film frame.
# Pass 2 renders all 240 frames in parallel — each worker loads only its
# own state and parameter files and writes its own PPM, so no shared
# memory crosses a thread boundary. Pass 3 (serial) streams the PPM
# frames through the BGRA encoder, encodes the deterministic ascent
# score into AAC-LC and assembles the MP4 (video + audio trak) with a
# bound manifest.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/time
import cheng/game/cinema/camera
import cheng/game/cinema/shot_plan
import cheng/game/cinema/vtbr
import cheng/game/cinema/mp4
import cheng/game/cinema/aac
import cheng/game/cinema/score
import cheng/game/render/cpu_raster as raster
import cheng/game/render/character
import cheng/game/render/text
import cheng/game/render/render_state
import std/os
import std/strings as strings
import std/rawbytes
import std/thread
import std/math as m

const
    AscentSchema = "cheng.apps.build_ascent.v1"
    FilmWidth = 1280
    FilmHeight = 720
    OutDir = "artifacts/csg_world_video/ascent"
    AscentFrames = 240

fn BuildPlan(): shot_plan.ShotPlan =
    var p: shot_plan.ShotPlan
    shot_plan.ShotPlanReset(p)
    # six shots across the 2400-tick climb, three camera families
    shot_plan.ShotPlanAddShot(p, -4.6, 3.2, 1.7, 0.0, 0.8, 1.35, 950.0, int64(0), int64(399), "SHOT 1: THE WALL")
    shot_plan.ShotPlanAddShot(p, 3.0, 3.4, 1.5, 0.0, 0.9, 1.20, 1150.0, int64(400), int64(799), "SHOT 2: FIRST GRIP")
    shot_plan.ShotPlanAddShot(p, -1.8, 3.4, 4.6, 0.0, 0.85, 1.30, 850.0, int64(800), int64(1199), "SHOT 3: REACHING")
    shot_plan.ShotPlanAddShot(p, -4.0, 2.2, 1.2, 0.0, 0.8, 1.50, 1050.0, int64(1200), int64(1599), "SHOT 4: THE PEDAL")
    shot_plan.ShotPlanAddShot(p, 2.6, 2.6, 1.1, 0.0, 0.95, 1.60, 1200.0, int64(1600), int64(1999), "SHOT 5: HIGHER")
    shot_plan.ShotPlanAddShot(p, -4.6, 3.2, 1.7, 0.0, 1.1, 1.90, 950.0, int64(2000), int64(2399), "SHOT 6: THE TOP")
    # narrative subtitles (non-overlapping windows)
    shot_plan.ShotPlanAddSubtitle(p, int64(30), int64(360), "THE CLIMB BEGINS")
    shot_plan.ShotPlanAddSubtitle(p, int64(430), int64(760), "ONE HAND AT A TIME")
    shot_plan.ShotPlanAddSubtitle(p, int64(830), int64(1160), "THE NEXT HOLD WAITS")
    shot_plan.ShotPlanAddSubtitle(p, int64(1230), int64(1560), "FOOT AGAINST THE ROCK")
    shot_plan.ShotPlanAddSubtitle(p, int64(1630), int64(1960), "HIGHER AND HIGHER")
    shot_plan.ShotPlanAddSubtitle(p, int64(2030), int64(2360), "THE TOP IS CLOSE")
    return p

# The shot plan (with its seq fields) never crosses a thread boundary:
# pass 1 freezes each frame's camera scalars and caption choice into a
# per-frame text file. Camera scalars travel as micro-metre integers so
# the worker's hand parse round-trips the plan's decimal literals
# exactly; the label and caption ride the following lines verbatim.
#   line 1: pxU pyU pzU txU tyU tzU focalU captionOn
#   line 2: shot label
#   line 3: caption (empty line when captionOn = 0)
fn ParamFramePath(dir: str, frame: int32): str =
    return dir + "/param_f" + strings.IntToStr(frame) + ".txt"

fn MicronOf(v: float64): int64 =
    if v >= 0.0:
        return int64(v * 1000000.0 + 0.5)
    return int64(v * 1000000.0 - 0.5)

fn MicronToFloat(m: int64): float64 =
    return float64(m) / 1000000.0

# Pass 2 worker: every input comes from this frame's own files, every
# output goes to this frame's own PPM — worker frames share nothing.
fn ascentRenderWorker(raw: ptr, index: int32, worker: int32): int32 =
    let _raw = raw
    let _w = worker
    let ptext: str = os.ReadFile(ParamFramePath(OutDir, index))
    var camv: int64[]
    setLen(camv, 0)
    var captionOn: int32 = 0
    var pos: int32 = 0
    var fi: int32 = 0
    while fi < 8:
        var v: int64 = 0
        var neg: bool = false
        var seen: bool = false
        while pos < ptext.len:
            let c: int32 = int32(ptext[pos])
            if c == 45:
                neg = true
                seen = true
                pos = pos + 1
            else:
                if c == 32 || c == 10:
                    if seen:
                        pos = pos + 1
                        break
                    pos = pos + 1
                else:
                    v = v * 10 + int64(c - 48)
                    seen = true
                    pos = pos + 1
        if neg:
            v = 0 - v
        if fi < 7:
            add(camv, v)
        else:
            captionOn = int32(v)
        fi = fi + 1
    # line 2: shot label, line 3: caption
    var ls: int32 = pos
    while pos < ptext.len:
        if int32(ptext[pos]) == 10:
            break
        pos = pos + 1
    var label: str = strings.sliceBytes(ptext, ls, pos - ls)
    pos = pos + 1
    var cs: int32 = pos
    while pos < ptext.len:
        if int32(ptext[pos]) == 10:
            break
        pos = pos + 1
    var caption: str = strings.sliceBytes(ptext, cs, pos - cs)
    var cam = camera.CinemaCameraLookAt(
        MicronToFloat(camv[0]), MicronToFloat(camv[1]), MicronToFloat(camv[2]),
        MicronToFloat(camv[3]), MicronToFloat(camv[4]), MicronToFloat(camv[5]),
        MicronToFloat(camv[6]), FilmWidth, FilmHeight)
    let state = render_state.RenderStateLoad(render_state.RenderStateFramePath(OutDir, index))
    if state == nil:
        return 1
    var t: raster.RasterTarget
    t = raster.RasterMake(FilmWidth, FilmHeight)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRopeState(t, cam, state)
    character.RenderCharacterState(t, cam, state)
    # shot label top-left
    text.RasterText(t, 40, 40, 2, label, 255, 255, 255)
    # caption bottom when active
    if captionOn == 1:
        let tw = text.TextPixelWidth(caption, 3)
        text.RasterText(t, (FilmWidth - tw) / 2, FilmHeight - 90, 3, caption, 240, 240, 220)
    raster.RasterWritePpm(t, OutDir + "/par_f" + strings.IntToStr(index) + ".ppm")
    return 0

fn main(): int32 =
    os.MkdirAll(OutDir, 493)
    var plan = BuildPlan()
    if !shot_plan.ShotPlanValid(plan):
        echo("FAIL shot plan invalid")
        return 1
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation")
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    # pass 1: serial physics, per-frame state + parameter dumps
    var curShot: int32 = -1
    var frame: int32 = 0
    var t: int32 = 0
    while t < 2400:
        let shotIdx = shot_plan.ShotPlanShotAt(plan, int64(t))
        if shotIdx != curShot:
            curShot = shotIdx
            echo("shot " + strings.IntToStr(shotIdx) + " at frame " + strings.IntToStr(frame))
        if t % 10 == 0:
            var ptext: str = ""
            ptext = ptext + strings.Int64ToStr(MicronOf(plan.camPx[shotIdx]))
            ptext = ptext + " " + strings.Int64ToStr(MicronOf(plan.camPy[shotIdx]))
            ptext = ptext + " " + strings.Int64ToStr(MicronOf(plan.camPz[shotIdx]))
            ptext = ptext + " " + strings.Int64ToStr(MicronOf(plan.camTx[shotIdx]))
            ptext = ptext + " " + strings.Int64ToStr(MicronOf(plan.camTy[shotIdx]))
            ptext = ptext + " " + strings.Int64ToStr(MicronOf(plan.camTz[shotIdx]))
            ptext = ptext + " " + strings.Int64ToStr(MicronOf(plan.camFocal[shotIdx]))
            let subIdx = shot_plan.ShotPlanSubtitleAt(plan, int64(t))
            if subIdx >= 0:
                ptext = ptext + " 1\n"
            else:
                ptext = ptext + " 0\n"
            ptext = ptext + plan.label[shotIdx] + "\n"
            if subIdx >= 0:
                ptext = ptext + plan.subText[subIdx] + "\n"
            else:
                ptext = ptext + "\n"
            os.WriteFile(ParamFramePath(OutDir, frame), ptext)
            render_state.RenderStateSave(st.w, partRoles, render_state.RenderStateFramePath(OutDir, frame))
            frame = frame + 1
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL step rejected")
            return 1
        t = t + 1
    if frame != AscentFrames:
        echo("FAIL frame count")
        echo("n=" + strings.IntToStr(frame))
        return 1
    # pass 2: parallel per-frame renders from the state+parameter streams
    var pool = thread.PoolNew(0)
    thread.ParallelFor(pool, AscentFrames, &ascentRenderWorker, nil)
    # pass 3: serial encode of the edited frame stream
    let vctx: ptr = vtbr.VtbrVideoSessionCreate(FilmWidth, FilmHeight)
    if vctx == nil:
        echo("FAIL vt session")
        return 1
    var encodeFail: int32 = 0
    frame = 0
    while frame < AscentFrames:
        let ppm: str = os.ReadFile(OutDir + "/par_f" + strings.IntToStr(frame) + ".ppm")
        if ppm.len != 16 + FilmWidth * FilmHeight * 3:
            echo("FAIL ppm size at frame " + strings.IntToStr(frame))
            return 1
        var b: rawbytes.Bytes = rawbytes.BytesAlloc(FilmWidth * FilmHeight * 4)
        var bi: int32 = 0
        while bi < FilmWidth * FilmHeight:
            let o: int32 = 16 + bi * 3
            rawbytes.BytesSet(b, bi * 4, int32(ppm[o + 2]) & 255)
            rawbytes.BytesSet(b, bi * 4 + 1, int32(ppm[o + 1]) & 255)
            rawbytes.BytesSet(b, bi * 4 + 2, int32(ppm[o]) & 255)
            rawbytes.BytesSet(b, bi * 4 + 3, int32(255))
            bi = bi + 1
        let erc = vtbr.VtbrVideoEncodeBgra(vctx, rawbytes.BytesDataPtr(b), FilmWidth * 4, FilmWidth, FilmHeight, frame * 1000)
        rawbytes.BytesFree(b)
        if erc != 0:
            encodeFail = encodeFail + 1
        frame = frame + 1
    if encodeFail > 0:
        echo("FAIL encode frames")
        echo("n=" + strings.IntToStr(encodeFail))
        return 1
    if vtbr.VtbrVideoFinish(vctx) != 0:
        echo("FAIL video finish")
        return 1
    let _drained = vtbr.VtbrVideoDrain(vctx)
    var videoPayload: uint8[]
    setLen(videoPayload, 0)
    vtbr.VtbrVideoCopyPayload(vctx, videoPayload)
    var videoSizes: int32[]
    setLen(videoSizes, 0)
    vtbr.VtbrVideoCopySizes(vctx, videoSizes)
    var videoKf: int32[]
    setLen(videoKf, 0)
    vtbr.VtbrVideoCopyKeyframes(vctx, videoKf)
    var sps: uint8[]
    setLen(sps, 0)
    var pps: uint8[]
    setLen(pps, 0)
    vtbr.VtbrVideoCopyParamSets(vctx, sps, pps)
    if sps.len == 0 || pps.len == 0:
        echo("FAIL paramsets empty")
        return 1
    if videoSizes.len != AscentFrames:
        echo("FAIL video sample count")
        echo("n=" + strings.IntToStr(videoSizes.len))
        return 1
    var inp: mp4.Mp4Input
    inp.videoSizes = videoSizes
    inp.videoKf = videoKf
    inp.videoPayload = videoPayload
    inp.sps = sps
    inp.pps = pps
    var scorePcm: uint8[]
    setLen(scorePcm, 0)
    let scoreSamples: int32 = score.ScorePcm48k(scorePcm, 10)
    var audioPayload: uint8[]
    setLen(audioPayload, 0)
    var audioSizes: int32[]
    setLen(audioSizes, 0)
    let arc = aac.AacEncodePcm16(scorePcm, scorePcm.len, audioPayload, audioSizes)
    if arc != 0:
        echo("FAIL audio encode rc=" + strings.IntToStr(arc))
        return 1
    var packetBytes: int32 = 0
    var asi: int32 = 0
    while asi < audioSizes.len:
        packetBytes = packetBytes + audioSizes[asi]
        asi = asi + 1
    if packetBytes != audioPayload.len:
        echo("FAIL audio payload mismatch")
        return 1
    inp.audioPayload = audioPayload
    inp.audioSizes = audioSizes
    inp.audioSamples = scoreSamples
    mp4.Mp4Assemble(inp, OutDir + "/ascent.mp4")
    var man: str = ""
    man = man + "schema=" + AscentSchema + "\n"
    man = man + "shots=" + strings.IntToStr(plan.shotCount) + "\n"
    man = man + "frames=" + strings.IntToStr(frame) + "\n"
    man = man + "audioPackets=" + strings.IntToStr(audioSizes.len) + "\n"
    man = man + "audioSamples=" + strings.IntToStr(scoreSamples) + "\n"
    man = man + "factsCid=" + Fmt"{schema.CsgWorldFactsCid(facts)}" + "\n"
    man = man + "chainCid=" + Fmt"{st.chainCid}" + "\n"
    os.WriteFile(OutDir + "/manifest.txt", man)
    echo("frames=" + strings.IntToStr(frame))
    echo("samples=" + strings.IntToStr(videoSizes.len))
    echo("chainCid=" + Fmt"{st.chainCid}")
    echo("PASS build ascent")
    return 0
