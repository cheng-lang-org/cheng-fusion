import std/strings
import std/os
import std/rawbytes
import std/result
import std/cmdline
import cheng/game/assets/semantic_video/schema
import cheng/game/assets/semantic_video/reader
import cheng/game/assets/semantic_video/convert

# semantic_convert <in.mp4> <out.svblock>
# 存量 MP4 → CSG 语义视频 v0.1 记录块 CLI。stdout 逐行 k=v; rc=0/1。

fn main(): int32 =
    if cmdline.ParamCount() < 3:
        echo("semantic_convert error: usage semantic_convert <in.mp4> <out.svblock>")
        return 1
    let inPath = cmdline.ParamStr(1)
    let outPath = cmdline.ParamStr(2)
    let fileResult = os.ReadFileBytesResult(inPath)
    if result.IsErr(fileResult):
        echo("semantic_convert error: read input failed")
        return 1
    var data = result.Value(fileResult)
    var cv = convert.SvConvert(data, outPath)
    if !cv.ok:
        echo(strings.ConcatStr("semantic_convert error: ", cv.error))
        return 1
    # 提交后回读已落盘块, 汇报观测/实体计数 (同时证明提交现场可读)。
    let blockResult = os.ReadFileBytesResult(outPath)
    if result.IsErr(blockResult):
        echo("semantic_convert error: read back failed")
        return 1
    var blockBytes = result.Value(blockResult)
    var decoded = reader.SvReaderDecode(blockBytes)
    if !decoded.ok:
        echo(strings.ConcatStr("semantic_convert error: decode ", decoded.error))
        return 1
    var parsed = reader.SvParseRecords(decoded.lines)
    if !parsed.ok:
        echo(strings.ConcatStr("semantic_convert error: parse ", parsed.error))
        return 1
    echo(strings.ConcatStr("inputCid=", cv.sourceCid))
    echo(strings.ConcatStr("sourceBytes=", strings.IntToStr(rawbytes.BytesLen(data))))
    echo(strings.ConcatStr("factCount=", strings.IntToStr(cv.factCount)))
    echo(strings.ConcatStr("contentId=", cv.contentId))
    echo(strings.ConcatStr("claimedDirectoryCid=", cv.claimedDirectoryCid))
    echo(strings.ConcatStr("svblockBytes=", strings.IntToStr(cv.svblockBytes)))
    echo(strings.ConcatStr("sampleCount=", strings.IntToStr(cv.sampleCount)))
    echo(strings.ConcatStr("keyframeCount=", strings.IntToStr(cv.keyframeCount)))
    echo(strings.ConcatStr("observationCount=", strings.IntToStr(parsed.records.observations.len)))
    echo(strings.ConcatStr("entities=", strings.IntToStr(parsed.records.entities.len)))
    return 0
