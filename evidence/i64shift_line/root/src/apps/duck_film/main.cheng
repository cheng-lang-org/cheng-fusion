# duck_film (MICRODUCK BALL BALANCE II): the 16-second two-act
# machine-duck film cut from the microduck-on-ball scene — the
# microduck_ball_probe caseL delivery stack (full-DoF verbatim-MJCF
# assembly + free real-ball + the triple balance servo) behind the full
# ball_film production line:
#   physics — the machine duck assembled straight into a world3d world
#     at the full 15-link/14-joint MJCF table (MicroduckModelBuild: 14
#     hinge servos from the model table, every servo parked at its
#     measured stance angle) at the ball-top root pose (0, 0.85,
#     0.275364117885), then the real FIBA size-7 solid ball (BallRigid
#     r = 0.121 m, m = 0.62 kg at (0, 0.85, 0.121)) injected
#     execution-side after the assembly and before the first step. After
#     the ball spawn the THREE-channel balance stack is armed (the caseL
#     wiring verbatim): the ball-frame rigid torso servo
#     (csg/ball_servo_rigid BallServoRigidStateInit at the release pose,
#     frozen defaults), the slow leak-free hip-PITCH goal-offset
#     integrator (BallServoHipTrimInit, the caseG CEM-best operating
#     point dTheta0 = 0.009 rad, rate 1/856 per tick, +-0.10 rad clamp)
#     and its lateral twin (BallServoRollTrimInit, the caseL delivery
#     rung +-0.10 rad clamp + the 0.3 lateral ball-velocity brake).
#     Tick order every tick, immediately before the physics step:
#     BallServoRigidTick, BallServoHipTrimTick, BallServoRollTrimTick.
#     The probe's measured caseL delivery datum: 5000-tick stand with
#     end drift 459.5 mm < 500 mm. Self-collision stays OFF exactly like
#     the probe scene the trim stack was calibrated on. Zero-velocity
#     release, honest drop onto the sphere — a topple is a valid
#     reported outcome and physics runs the whole window regardless.
#   film — 384 frames at 24 fps (FrameStep = 24 ticks/frame, 9216 ticks
#     = 16.0 s):
#     act 1 (frames 0-16, ticks 0-407): "DEPLOY" — release + drop +
#     servo soft-start ramp, caption "MICRODUCK BALL BALANCE II - PURE
#     CHENG XPBD".
#     act 2 (frames 17-383, ticks 408-9215): "BALANCE" — free ball,
#     the triple servo stack balancing, live ball-drift counter (int64
#     mm fixed point through the meter formatter) plus the static line
#     "FREE BALL / SERVO + DUAL TRIM CONTROL"; the last 60 frames
#     swap the drift line for the honest ending card: "STABLE" when the
#     servo held armed and upright the whole 9216 ticks (with the drift
#     final value appended when the pair crept past the 2 m
#     honest-drift line), or "SURVIVED <lossTick> TICKS" from the first
#     balance-loss tick (servo disarm latch or head-below-torso topple).
#   Honest-content contract: a topple or a servo disarm is a valid
#     reported outcome, so physics runs the whole window regardless;
#     fall tick, disarm tick, ball drift, trim integrator end states,
#     rejected steps and any engine stall ride the manifest. The
#     documented post-topple wreck-pump of the ground landing is part
#     of the footage, not a defect to hide.
#   Pipeline per ball_film: pass 1 serial physics with a strictly
#     numeric loop (per-frame body poses buffered in memory, camera and
#     drift ride the frame buffers; str work only after the loop), then
#     state/param files, pass 2 frame-parallel render workers (state
#     file + param file -> PPM), pass 3 PPM -> VideoToolbox H.264 +
#     ScorePcm48k(16 s) AAC -> Mp4Assemble video+audio + manifest.
#   Render (MICRODUCK official STL meshes, 1:1 visual): pass 2 loads
#     the 7 shipped MICRODUCK meshes once at startup (binary STL ->
#     mesh_render.MeshStlLoad handle table, shared read-only across
#     workers). Each mesh is docked to its engine link body frame with
#     the exact URDF visual constants (docs: pollen-robotics microduck
#     microduck.urdf, chain-composed to the engine frame engine_x =
#     -mjcf_y / engine_y = +mjcf_x / engine_z = +mjcf_z, urdf left
#     chain = engine -X side; zero-pose chain positions cross-checked
#     against the model table to 0.021 mm):
#       trunk_base.stl        -> torso link (exact, yaw 180)
#       bearing_roll.stl      -> hipYawCarrierL / hipYawCarrierR
#                                (exact, yaw 180; the drums stay docked
#                                to the yaw-rotating frames — the M6
#                                fused yoke dock re-expressed on the
#                                split MJCF yaw carriers, same
#                                root-frame placement, official urdf
#                                asymmetry preserved)
#       upper_leg_left.stl    -> thighR (exact, yaw 180) and thighL
#                                (rigid yaw-pi mirror approximation)
#       foot_left.stl + ankle_left.stl -> footR (exact, yaw 180) and
#                                footL (rigid yaw-pi mirror)
#       bottom_head_shell.stl + face_part.stl -> head link (exact,
#                                yaw 180)
#     Orientation (resolved): mesh_render.MeshRasterFrameOrient renders
#     every mesh with the FULL link quaternion (world = o + R(q) v, the
#     body q composed with the fixed dock z rotation) — the former
#     yaw-only upright approximation (upper-leg 90 deg dock pitch,
#     stance joint pitches rendered upright) is gone. Remaining
#     approximation (reported): the mirror instances (thighL, footL)
#     reuse the exact-side stl behind a rigid yaw-pi dock because the
#     official mirrored stls are not shipped. The neck-chain links
#     (neck, head pitch/yaw carriers) and both shins have no shipped
#     mesh; they render as dark capsule impostors (the official dark
#     servo stacks) so the figure stays connected.
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/constraints3d
import cheng/game/csg/joint_motor
import cheng/game/csg/numerics
import cheng/game/csg/ball_servo_rigid as bsr
import cheng/game/csg/microduck_model as mm
import cheng/game/cinema/camera
import cheng/game/cinema/vtbr
import cheng/game/cinema/mp4
import cheng/game/cinema/aac
import cheng/game/cinema/score
import cheng/game/render/cpu_raster as raster
import cheng/game/render/mesh_render
import cheng/game/render/text
import std/os
import std/strings as strings
import std/rawbytes
import std/math as m
import std/thread

const
    FilmSchema = "cheng.apps.duck_film.v1"
    FilmWidth = 1280
    FilmHeight = 720
    FilmDir = "artifacts/csg_world_video/duck_film"
    FrameStep = 24
    PerturbTick1 = 2400
    PerturbTick2 = 5200
    FilmPerturbMps = 0.30
    # act 1 = the 400-tick deploy window -> frames 0-16 (frame 17 starts
    # at tick 408, the first full BALL BALANCE frame)
    Act1Frames = 17
    FilmFrames = 384
    TotalTicks = 9216
    # ending card: the last 60 frames (2.5 s)
    EndCaptionFrames = 60
    # honest-drift line: a full stand with the pair crept past this still
    # films to the end, but the card carries the drift final value
    DriftHonestLimitM = 2.0
    # follow camera: position = ball center + offset, look-at = smoothed
    # ball center. Direction preserved from the ball_film framing; the
    # offset magnitude is scaled 0.45x for the real-size duck (0.255 m)
    # and real size-7 ball (r = 0.121 m), holding the figure ~105 px tall
    CamOffX = -1.26
    CamOffY = 1.08
    CamOffZ = 0.72
    CamFocal = 750.0
    CamSmooth = 0.30
    GroundExtent = 80.0
    # spot-check PPMs kept on disk (deploy frame / balance frame);
    # deploy rides frame 2 (tick 48, on the ball inside the servo
    # soft-start ramp)
    SpotFrameDeploy = 2
    SpotFrameBalance = 200
    # real FIBA size-7 basketball: r = 0.121 m, m = 0.62 kg, resting on
    # the ground plane (center z = r) - the microduck_ball_probe caseB
    # ball (the historical fictional r = 0.35 m / 30 kg ball is gone)
    BallCenterX = 0.0
    BallCenterY = 0.85
    BallCenterZ = 0.121
    BallRadiusM = 0.121
    BallMassKg = 0.62
    # ball top = 2r = 0.242: the duck root pose stands the balanced-
    # stance sole plane on it (root = ball top + the stance lift chain,
    # the probe caseB constant verbatim)
    DuckRootZ = 0.275364117885
    # a rejected step rolls back and never advances the tick, so 64
    # straight rejects at one tick is an engine stall (assembly-probe
    # guard), reported as data instead of being spun on silently
    StallRejectRun = 64
    AngleNeutralTolRad = 0.001
    AnchorGapTolM = 0.001
    # 15 duck bodies (slots 0-14: the full-DoF MJCF assembly links) +
    # 1 ball = the exact world population, asserted at spawn
    BodyTotal = 16
    BallSlot = 15
    # -- balance stack trim channels (microduck_ball_probe caseG
    #    CEM-best operating point + the caseL delivery rung) --
    # pitch slow integral: dTheta0 = 0.009 rad, rate 1/856 per tick,
    # +-0.10 rad goal-authority clamp
    TrimPitchDTheta0 = 0.009
    TrimRate = 0.0011682242990654206
    TrimPitchRangeRad = 0.10
    # roll slow integral (caseL delivery): +-0.10 rad clamp (still 3.8x
    # inside the +-0.384 rad MJCF hip-roll limit) x the 0.3 lateral
    # ball-velocity brake (2x faster walk to authority than the
    # measured 809.2 mm kFf 0.15 rung)
    TrimRollRangeRad = 0.10
    TrimRollKFfLat = 0.3
    # -- MICRODUCK official mesh assets (binary STL, meters) --
    MeshPathTrunk = "assets/microduck_meshes/trunk_base.stl"
    MeshPathBearing = "assets/microduck_meshes/bearing_roll.stl"
    MeshPathUpperLeg = "assets/microduck_meshes/upper_leg_left.stl"
    MeshPathFoot = "assets/microduck_meshes/foot_left.stl"
    MeshPathAnkle = "assets/microduck_meshes/ankle_left.stl"
    MeshPathHeadShell = "assets/microduck_meshes/bottom_head_shell.stl"
    MeshPathFace = "assets/microduck_meshes/face_part.stl"
    # mesh handle table slots (load order = const order below)
    MeshIdxTrunk = 0
    MeshIdxBearing = 1
    MeshIdxUpperLeg = 2
    MeshIdxFoot = 3
    MeshIdxAnkle = 4
    MeshIdxHeadShell = 5
    MeshIdxFace = 6
    MeshHandleCount = 7
    # -- urdf materials (rgba 0..255): the official visual palette --
    ColorCreamR = 247
    ColorCreamG = 230
    ColorCreamB = 203
    ColorOrangeR = 248
    ColorOrangeG = 78
    ColorOrangeB = 5
    ColorGreyR = 82
    ColorGreyG = 82
    ColorGreyB = 86
    ColorMotorR = 40
    ColorMotorG = 40
    ColorMotorB = 44
    # basketball: FIBA orange leather base + dark seam groove color
    # (raster.RasterBasketball base/groove palette)
    ColorBallR = 224
    ColorBallG = 116
    ColorBallB = 50
    ColorGrooveR = 30
    ColorGrooveG = 26
    ColorGrooveB = 24

# mesh handle table, loaded once in main() before the render workers
# fan out (mesh_render keeps its own module SoA store; the handles are
# plain int32 indices, read-only during pass 2)
var meshHandles: int32[]

type
    FilmData =
        ok: bool
        rejected: int32
        firstRejectTick: int32
        stallTick: int32
        fallTick: int32
        # servo disarm-latch tick (first arming-basin violation), -1 if
        # the servo never disarmed
        disarmTick: int32
        # servo armed latch value at the end of the episode (1 = balanced
        # through the last tick)
        armedEnd: int32
        driftMax: float64
        driftEndMm: int64
        # trim integrator end states (diagnostics, mrad via MmOf)
        trimDThetaEnd: float64
        trimDRollEnd: float64
        drift: float64[]
        tilt: float64[]
        camX: float64[]
        camY: float64[]
        camZ: float64[]
        tgtX: float64[]
        tgtY: float64[]
        tgtZ: float64[]
        # per-frame body snapshot buffers, frame * BodyTotal + bodyIndex
        snapPx: float64[]
        snapPy: float64[]
        snapPz: float64[]
        snapQw: float64[]
        snapQx: float64[]
        snapQy: float64[]
        snapQz: float64[]
        snapR: float64[]
        snapH: float64[]
        # per-frame ball visual attitude (render-layer only, world frame):
        # integrated from the ball's angular velocity at the frame step,
        # consumed by raster.RasterBasketball for the seam pattern
        snapVqw: float64[]
        snapVqx: float64[]
        snapVqy: float64[]
        snapVqz: float64[]

fn FramePath(frame: int32): str =
    return FilmDir + "/duck_f" + strings.IntToStr(frame) + ".ppm"

fn ParamPath(frame: int32): str =
    return FilmDir + "/param_f" + strings.IntToStr(frame) + ".txt"

fn StatePath(frame: int32): str =
    return FilmDir + "/state_f" + strings.IntToStr(frame) + ".txt"

fn MicronOf(v: float64): int64 =
    if v >= 0.0:
        return int64(v * 1000000.0 + 0.5)
    return int64(v * 1000000.0 - 0.5)

fn MicronToFloat(mcr: int64): float64 =
    return float64(mcr) / 1000000.0

fn MmOf(v: float64): int64 =
    if v >= 0.0:
        return int64(v * 1000.0 + 0.5)
    return int64(v * 1000.0 - 0.5)

fn QuatOf(q: float64): int64 =
    if q >= 0.0:
        return int64(q * 1000000000.0 + 0.5)
    return int64(q * 1000000000.0 - 0.5)

fn QuatToFloat(v: int64): float64 =
    return float64(v) / 1000000000.0

# Load the 7 official meshes into the handle table; any structural
# failure is a startup panic (let-it-crash: the film cannot exist
# without its visuals).
fn LoadMeshes() =
    setLen(meshHandles, MeshHandleCount)
    let hTrunk = mesh_render.MeshStlLoad(MeshPathTrunk)
    let hBearing = mesh_render.MeshStlLoad(MeshPathBearing)
    let hUpperLeg = mesh_render.MeshStlLoad(MeshPathUpperLeg)
    let hFoot = mesh_render.MeshStlLoad(MeshPathFoot)
    let hAnkle = mesh_render.MeshStlLoad(MeshPathAnkle)
    let hShell = mesh_render.MeshStlLoad(MeshPathHeadShell)
    let hFace = mesh_render.MeshStlLoad(MeshPathFace)
    if !mesh_render.MeshValid(hTrunk):
        panic("duck film: stl load failed trunk_base")
    if !mesh_render.MeshValid(hBearing):
        panic("duck film: stl load failed bearing_roll")
    if !mesh_render.MeshValid(hUpperLeg):
        panic("duck film: stl load failed upper_leg_left")
    if !mesh_render.MeshValid(hFoot):
        panic("duck film: stl load failed foot_left")
    if !mesh_render.MeshValid(hAnkle):
        panic("duck film: stl load failed ankle_left")
    if !mesh_render.MeshValid(hShell):
        panic("duck film: stl load failed bottom_head_shell")
    if !mesh_render.MeshValid(hFace):
        panic("duck film: stl load failed face_part")
    meshHandles[MeshIdxTrunk] = hTrunk
    meshHandles[MeshIdxBearing] = hBearing
    meshHandles[MeshIdxUpperLeg] = hUpperLeg
    meshHandles[MeshIdxFoot] = hFoot
    meshHandles[MeshIdxAnkle] = hAnkle
    meshHandles[MeshIdxHeadShell] = hShell
    meshHandles[MeshIdxFace] = hFace

# Drift caption: meters with three decimals through the int64 mm hop
# (strings carries no float formatter; the ball_film exact shape).
fn FmtMeters(x: float64): str =
    let scaled: int64 = int64(m.roundFloat(x * 1000.0))
    let intPart: int64 = scaled / 1000
    let fracPart: int64 = scaled % 1000
    return strings.Int64ToStr(intPart) + "." + strings.CloneStrRange(strings.Int64ToStr(fracPart + 1000), 1, 3) + " m"

fn FmtTilt(deg: float64): str =
    let scaled: int64 = int64(m.roundFloat(deg * 10.0))
    let intPart: int64 = scaled / 10
    let fracPart: int64 = scaled % 10
    return strings.Int64ToStr(intPart) + "." + strings.Int64ToStr(fracPart) + " deg"

# Whitespace-delimited int64 scanner: the ball_film param-token loop
# lifted verbatim; pos ends just past the token's terminator so text
# lines can be read behind the numeric block. The text is borrowed —
# one row can fire many scans over the same buffer.
@borrows
fn ScanI64(text: str, pos: var int32): int64 =
    var v: int64 = 0
    var neg: bool = false
    var seen: bool = false
    while pos < text.len:
        let c: int32 = int32(text[pos])
        if c == 45:
            neg = true
            seen = true
            pos = pos + 1
        else:
            if c == 32 || c == 10:
                if seen:
                    pos = pos + 1
                    break
                pos = pos + 1
            else:
                v = v * 10 + int64(c - 48)
                seen = true
                pos = pos + 1
    if neg:
        v = 0 - v
    return v

# One text line from pos (terminator consumed), for the caption lines
# behind the numeric block. The text is borrowed like ScanI64.
@borrows
fn ScanLine(text: str, pos: var int32): str =
    let start: int32 = pos
    while pos < text.len:
        if int32(text[pos]) == 10:
            break
        pos = pos + 1
    let outp: str = strings.sliceBytes(text, start, pos - start)
    if pos < text.len:
        pos = pos + 1
    return outp

# Park the servo command and goal at the measured standing flexion so tick
# 0 commands no step change; returns the measured angle.
fn parkHingeServo(w: var World3d, ci: int32): float64 =
    let th0 = Constraints3dHingeAngle(w, ci)
    w.conCmd[ci] = th0
    w.conGoal[ci] = th0
    return th0

# One MJCF joint -> one hinge servo from the model table (the
# microduck_ball_probe buildDuck construction, verbatim).
@borrows
fn stanceHinge(w: var World3d, mdl: mm.MicroduckModel, jointIdx: int32, refX: float64, refY: float64, refZ: float64, tauMax: float64, omegaRadS: float64): int32 =
    let jt = mdl.joints[jointIdx]
    let pl = mdl.links[jt.parentLink]
    let cl = mdl.links[jt.childLink]
    var anchAx: float64
    var anchAy: float64
    var anchAz: float64
    mm.MicroduckPointToLocal(pl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, pl.cx, pl.cy, pl.cz, anchAx, anchAy, anchAz)
    var axisAx: float64
    var axisAy: float64
    var axisAz: float64
    mm.MicroduckVecToLocal(pl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisAx, axisAy, axisAz)
    var anchBx: float64
    var anchBy: float64
    var anchBz: float64
    mm.MicroduckPointToLocal(cl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, cl.cx, cl.cy, cl.cz, anchBx, anchBy, anchBz)
    var axisBx: float64
    var axisBy: float64
    var axisBz: float64
    mm.MicroduckVecToLocal(cl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisBx, axisBy, axisBz)
    let ci = world3d.World3dAddHingeJoint(w, jt.parentLink, jt.childLink, world3d.World3dConHingeServo, anchAx, anchAy, anchAz, anchBx, anchBy, anchBz, axisAx, axisAy, axisAz, axisBx, axisBy, axisBz)
    var refAlX: float64
    var refAlY: float64
    var refAlZ: float64
    mm.MicroduckVecToLocal(pl.axisKind, refX, refY, refZ, refAlX, refAlY, refAlZ)
    var refBlX: float64
    var refBlY: float64
    var refBlZ: float64
    mm.MicroduckVecToLocal(cl.axisKind, refX, refY, refZ, refBlX, refBlY, refBlZ)
    world3d.World3dSetHingeRefs(w, ci, refAlX, refAlY, refAlZ, refBlX, refBlY, refBlZ)
    world3d.World3dSetHingeServo(w, ci, tauMax, omegaRadS, jt.minRad, jt.maxRad)
    if constraints3d.Constraints3dJointAnchorGap(w, ci) > AnchorGapTolM:
        panic("duck film: hinge pivot gap at " + jt.name)
    return ci

# The four leg hinge-servo constraint indices the trim channels drive
# (the microduck_ball_probe DuckPitchCons shape; ankle indices carried
# for parity with the probe struct).
type
    DuckPitchCons =
        hipL: int32
        hipR: int32
        ankleL: int32
        ankleR: int32
        hipRollL: int32
        hipRollR: int32

# The full-DoF assembly at root pose (rootX, rootY, rootZ) yaw 0: 15
# link capsules at the balanced stance, 14 hinge servos from the model
# table (five DoF per leg: yaw/roll/pitch/knee/ankle, plus the 4-joint
# neck chain), every parked servo at its measured stance angle — the
# microduck_ball_probe caseL buildDuck, verbatim (echoes stripped).
fn buildDuck(w: var World3d, rootX: float64, rootY: float64, rootZ: float64, cons: var DuckPitchCons) =
    world3d.World3dReset(w, int64(911))
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if mdl.links.len != 15:
        panic("duck film: link count")
    if mdl.joints.len != 14:
        panic("duck film: joint count")
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > 0.000000001:
        panic("duck film: total mass off the MJCF sum")
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, rootX, rootY, rootZ, 0.0)
        let slot = world3d.World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("duck film: link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    let tauHip = mm.MicroduckTauMaxHipNm
    let tauKnee = mm.MicroduckTauMaxKneeNm
    let tauAnkle = mm.MicroduckTauMaxAnkleNm
    let tauNeck = mm.MicroduckTauMaxNeckNm
    let ciHipYawL = stanceHinge(w, mdl, mm.MicroduckJointHipYawL, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipRollL = stanceHinge(w, mdl, mm.MicroduckJointHipRollL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciHipPitchL = stanceHinge(w, mdl, mm.MicroduckJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeL = stanceHinge(w, mdl, mm.MicroduckJointKneeL, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleL = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchL, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciHipYawR = stanceHinge(w, mdl, mm.MicroduckJointHipYawR, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipRollR = stanceHinge(w, mdl, mm.MicroduckJointHipRollR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciHipPitchR = stanceHinge(w, mdl, mm.MicroduckJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeR = stanceHinge(w, mdl, mm.MicroduckJointKneeR, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleR = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchR, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciNeck = stanceHinge(w, mdl, mm.MicroduckJointNeckPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadPitch = stanceHinge(w, mdl, mm.MicroduckJointHeadPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadYaw = stanceHinge(w, mdl, mm.MicroduckJointHeadYaw, 0.0, 1.0, 0.0, tauNeck, omegaRadS)
    let ciHeadRoll = stanceHinge(w, mdl, mm.MicroduckJointHeadRoll, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let th = mm.MicroduckStanceHipRad
    let thHipL = parkHingeServo(w, ciHipPitchL)
    let thHipR = parkHingeServo(w, ciHipPitchR)
    let thRollL = parkHingeServo(w, ciHipRollL)
    let thRollR = parkHingeServo(w, ciHipRollR)
    let thKneeL = parkHingeServo(w, ciKneeL)
    let thKneeR = parkHingeServo(w, ciKneeR)
    let thAnkleL = parkHingeServo(w, ciAnkleL)
    let thAnkleR = parkHingeServo(w, ciAnkleR)
    let thNeck = parkHingeServo(w, ciNeck)
    parkHingeServo(w, ciHeadPitch)
    parkHingeServo(w, ciHeadYaw)
    parkHingeServo(w, ciHeadRoll)
    parkHingeServo(w, ciHipYawL)
    parkHingeServo(w, ciHipYawR)
    cons.hipL = ciHipPitchL
    cons.hipR = ciHipPitchR
    cons.ankleL = ciAnkleL
    cons.ankleR = ciAnkleR
    cons.hipRollL = ciHipRollL
    cons.hipRollR = ciHipRollR
    # Create-time pose validation (pose-invariant distance checks, the
    # probe's stance acceptance).
    if numerics.CsgAbs(thHipL - th) > AngleNeutralTolRad:
        panic("duck film: hip pitch L th0 off the stance")
    if numerics.CsgAbs(thHipR + th) > AngleNeutralTolRad:
        panic("duck film: hip pitch R th0 off the stance")
    if numerics.CsgAbs(thAnkleL + th) > AngleNeutralTolRad:
        panic("duck film: ankle L th0 off the stance")
    if numerics.CsgAbs(thAnkleR - th) > AngleNeutralTolRad:
        panic("duck film: ankle R th0 off the stance")
    if numerics.CsgAbs(thRollL) > AngleNeutralTolRad:
        panic("duck film: hip roll L th0 not neutral")
    if numerics.CsgAbs(thRollR) > AngleNeutralTolRad:
        panic("duck film: hip roll R th0 not neutral")
    if numerics.CsgAbs(thKneeL) > AngleNeutralTolRad:
        panic("duck film: knee L th0 not neutral")
    if numerics.CsgAbs(thKneeR) > AngleNeutralTolRad:
        panic("duck film: knee R th0 not neutral")
    if numerics.CsgAbs(thNeck) > AngleNeutralTolRad:
        panic("duck film: neck th0 not neutral")

# Rotate one point by a unit quaternion (world <- local), the exact
# v' = q v q* form; used to carry each mesh's docked body-local center
# through the FULL body orientation (the mesh orientation itself rides
# the same full quaternion through MeshRasterFrameOrient).
fn QuatRotatePoint(qw: float64, qx: float64, qy: float64, qz: float64, vx: float64, vy: float64, vz: float64, outX: var float64, outY: var float64, outZ: var float64) =
    let tx = 2.0 * (qy * vz - qz * vy)
    let ty = 2.0 * (qz * vx - qx * vz)
    let tz = 2.0 * (qx * vy - qy * vx)
    outX = vx + qw * tx + (qy * tz - qz * ty)
    outY = vy + qw * ty + (qz * tx - qx * tz)
    outZ = vz + qw * tz + (qx * ty - qy * tx)

# Hamilton product of two unit quaternions (world <- local): the
# returned rotation applies (bw,bx,by,bz) first, then (aw,ax,ay,az).
# Used to compose each body quaternion with its fixed dock z rotation.
fn QuatMul(aw: float64, ax: float64, ay: float64, az: float64, bw: float64, bx: float64, by: float64, bz: float64, outW: var float64, outX: var float64, outY: var float64, outZ: var float64) =
    outW = aw * bw - ax * bx - ay * by - az * bz
    outX = aw * bx + ax * bw + ay * bz - az * by
    outY = aw * by - ax * bz + ay * bw + az * bx
    outZ = aw * bz + ax * by - ay * bx + az * bw

# Advance the ball's render-layer visual attitude by one step: dq =
# normalize(1, omega*dt/2) from the world-frame angular velocity, vq =
# dq (x) vq (world-frame left multiply, inlined Hamilton product),
# renormalized. Pure visual state — the physics ball is attitude-
# symmetric by design (G1: bodyAngV has no attitude column), this
# quaternion only carries the seam pattern with the visible roll and
# never enters the physics CID.
fn BallVisualQuatStep(vqw: var float64, vqx: var float64, vqy: var float64, vqz: var float64, avx: float64, avy: float64, avz: float64, dt: float64) =
    let half: float64 = dt * 0.5
    var dw: float64 = 1.0
    var dx: float64 = avx * half
    var dy: float64 = avy * half
    var dz: float64 = avz * half
    let dn: float64 = numerics.CsgSqrt(dw * dw + dx * dx + dy * dy + dz * dz)
    dw = dw / dn
    dx = dx / dn
    dy = dy / dn
    dz = dz / dn
    let rw: float64 = dw * vqw - dx * vqx - dy * vqy - dz * vqz
    let rx: float64 = dw * vqx + dx * vqw + dy * vqz - dz * vqy
    let ry: float64 = dw * vqy - dx * vqz + dy * vqw + dz * vqx
    let rz: float64 = dw * vqz + dx * vqy - dy * vqx + dz * vqw
    let nn: float64 = numerics.CsgSqrt(rw * rw + rx * rx + ry * ry + rz * rz)
    vqw = rw / nn
    vqx = rx / nn
    vqy = ry / nn
    vqz = rz / nn

# One docked mesh instance: the body pose rides the snapshot, the dock
# constants (cvec = the mesh frame origin in the body frame, engine
# axes; thetaRad = the fixed mesh-axes-to-engine-axes z rotation baked
# from the urdf visual chain) come from the table below.
@borrows
fn DrawOneMesh(t: raster.RasterTarget,
               cam: camera.CinemaCamera,
               handle: int32,
               px: float64,
               py: float64,
               pz: float64,
               qw: float64,
               qx: float64,
               qy: float64,
               qz: float64,
               cx: float64,
               cy: float64,
               cz: float64,
               thetaRad: float64,
               cr: int32,
               cg: int32,
               cb: int32) =
    var rx: float64
    var ry: float64
    var rz2: float64
    # the dock table carries millimeter values (matching the urdf chain
    # derivation); the mesh store and world are meters - convert here
    QuatRotatePoint(qw, qx, qy, qz, cx * 0.001, cy * 0.001, cz * 0.001, rx, ry, rz2)
    # the fixed dock rotation is a z rotation of thetaRad in the mesh
    # axes; compose body q * Rz(theta) so the FULL body orientation
    # (pitch and roll included) carries the mesh
    let halfTheta: float64 = thetaRad * 0.5
    var tw: float64
    var tx: float64
    var ty: float64
    var tz: float64
    QuatMul(qw, qx, qy, qz, m.cosFloat(halfTheta), 0.0, 0.0, m.sinFloat(halfTheta), tw, tx, ty, tz)
    mesh_render.MeshRasterFrameOrient(t, cam, handle, px + rx, py + ry, pz + rz2, 1.0, tw, tx, ty, tz, cr, cg, cb)

# Dark capsule impostor for the meshless links: the old multi-sphere
# capsule path (spheres spaced <= 0.6r along the live body quaternion
# axis), one color.
@borrows
fn DrawLinkImpostor(t: raster.RasterTarget,
                    cam: camera.CinemaCamera,
                    px: float64,
                    py: float64,
                    pz: float64,
                    qw: float64,
                    qx: float64,
                    qy: float64,
                    qz: float64,
                    r: float64,
                    h: float64) =
    let ax = 2.0 * (qx * qz + qw * qy)
    let ay = 2.0 * (qy * qz - qw * qx)
    let az = 1.0 - 2.0 * (qx * qx + qy * qy)
    let step: float64 = r * 0.6
    let nSteps: int32 = int32(h / step) + 1
    var k: int32 = 0 - nSteps
    while k <= nSteps:
        let t2: float64 = float64(k) * step
        if t2 <= h:
            raster.RasterSphere(t, cam, px - ax * t2, py - ay * t2, pz - az * t2, r, ColorMotorR, ColorMotorG, ColorMotorB)
        k = k + 1

# The official-mesh dock table, one call per shipped mesh instance.
# Constants: urdf chain-composed (see the header), millimeter values as
# decided by the zero-pose cross-check. Mirror instances (engine +X
# side) reuse the same mesh with a rigid yaw-pi approximation of the
# official mirrored stl (not shipped). Slot map = the 15-link full-DoF
# assembly (torso 0, hipYawCarrierL 1, hipRollCarrierL 2, thighL 3,
# shinL 4, footL 5, hipYawCarrierR 6, hipRollCarrierR 7, thighR 8,
# shinR 9, footR 10, neck 11, headPitchCarrier 12, headYawCarrier 13,
# head 14); the bearing drums stay on the yaw-rotating carrier frames
# (1 / 6) at the same root-frame placement the fused-yoke dock had.
@borrows
fn DrawDuckMeshes(t: raster.RasterTarget,
                  cam: camera.CinemaCamera,
                  px: float64[],
                  py: float64[],
                  pz: float64[],
                  qw: float64[],
                  qx: float64[],
                  qy: float64[],
                  qz: float64[],
                  rad: float64[],
                  vqw: float64,
                  vqx: float64,
                  vqy: float64,
                  vqz: float64) =
    let piRad: float64 = m.Pi
    # torso <- trunk_base (exact)
    DrawOneMesh(t, cam, meshHandles[MeshIdxTrunk], px[0], py[0], pz[0], qw[0], qx[0], qy[0], qz[0], 0.0, 22.419, 0.0 - 19.875, piRad, ColorCreamR, ColorCreamG, ColorCreamB)
    # hipYawCarrierL / hipYawCarrierR <- bearing_roll (exact, official
    # urdf drum asymmetry preserved in the root frame)
    DrawOneMesh(t, cam, meshHandles[MeshIdxBearing], px[1], py[1], pz[1], qw[1], qx[1], qy[1], qz[1], 17.500348, 0.0 - 3.214531, 4.430763, piRad, ColorMotorR, ColorMotorG, ColorMotorB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxBearing], px[6], py[6], pz[6], qw[6], qx[6], qy[6], qz[6], 17.499650, 0.0 - 3.214531, 4.430763, piRad, ColorMotorR, ColorMotorG, ColorMotorB)
    # thighL (mirror) / thighR (exact) <- upper_leg_left (the 90 deg
    # dock pitch rides the full body quaternion)
    DrawOneMesh(t, cam, meshHandles[MeshIdxUpperLeg], px[3], py[3], pz[3], qw[3], qx[3], qy[3], qz[3], 0.0 - 54.995, 22.480, 7.318, 0.0, ColorCreamR, ColorCreamG, ColorCreamB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxUpperLeg], px[8], py[8], pz[8], qw[8], qx[8], qy[8], qz[8], 54.995, 22.480, 7.318, piRad, ColorCreamR, ColorCreamG, ColorCreamB)
    # shinL / shinR: no shipped mesh (official leg.stl absent) - dark
    # capsule impostor (the official dark servo block)
    DrawLinkImpostor(t, cam, px[4], py[4], pz[4], qw[4], qx[4], qy[4], qz[4], 0.008, 0.024)
    DrawLinkImpostor(t, cam, px[9], py[9], pz[9], qw[9], qx[9], qy[9], qz[9], 0.008, 0.024)
    # footL (mirror) / footR (exact) <- foot_left + ankle_left
    DrawOneMesh(t, cam, meshHandles[MeshIdxFoot], px[5], py[5], pz[5], qw[5], qx[5], qy[5], qz[5], 0.0 - 49.021, 15.524, 19.803, 0.0, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxAnkle], px[5], py[5], pz[5], qw[5], qx[5], qy[5], qz[5], 0.0 - 49.021, 15.524, 19.803, 0.0, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxFoot], px[10], py[10], pz[10], qw[10], qx[10], qy[10], qz[10], 49.021, 15.524, 19.803, piRad, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxAnkle], px[10], py[10], pz[10], qw[10], qx[10], qy[10], qz[10], 49.021, 15.524, 19.803, piRad, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    # neck chain: no shipped meshes - dark capsule impostors
    DrawLinkImpostor(t, cam, px[11], py[11], pz[11], qw[11], qx[11], qy[11], qz[11], 0.014, 0.026)
    DrawLinkImpostor(t, cam, px[12], py[12], pz[12], qw[12], qx[12], qy[12], qz[12], 0.006, 0.008)
    DrawLinkImpostor(t, cam, px[13], py[13], pz[13], qw[13], qx[13], qy[13], qz[13], 0.008, 0.010)
    # head <- bottom_head_shell + face_part (exact)
    DrawOneMesh(t, cam, meshHandles[MeshIdxHeadShell], px[14], py[14], pz[14], qw[14], qx[14], qy[14], qz[14], 1.454, 0.0 - 14.986, 0.0 - 8.010, piRad, ColorOrangeR, ColorOrangeG, ColorOrangeB)
    DrawOneMesh(t, cam, meshHandles[MeshIdxFace], px[14], py[14], pz[14], qw[14], qx[14], qy[14], qz[14], 1.546, 0.0 - 15.186, 0.0 - 8.210, piRad, ColorGreyR, ColorGreyG, ColorGreyB)
    # the ball: real-basketball render (orange leather, seam grooves
    # riding the render-layer visual attitude quaternion)
    raster.RasterBasketball(t, cam, px[BallSlot], py[BallSlot], pz[BallSlot], rad[BallSlot], vqw, vqx, vqy, vqz, ColorBallR, ColorBallG, ColorBallB, ColorGrooveR, ColorGrooveG, ColorGrooveB)

# Pass 1: the microduck_ball_probe caseL episode, 9216 ticks,
# zero-velocity release on the ball top with the triple balance stack
# armed (torso servo frozen defaults + the dual trim channels, Init
# after the ball spawn, Tick before every step). The loop is numeric
# only; frames buffer into the snapshot memory. On an engine stall the
# remaining frames freeze the last world state (reported as data).
fn RunFilm(): FilmData =
    var outData: FilmData
    outData.ok = false
    outData.rejected = 0
    outData.firstRejectTick = 0 - 1
    outData.stallTick = 0 - 1
    outData.fallTick = 0 - 1
    outData.disarmTick = 0 - 1
    outData.armedEnd = 0
    outData.driftMax = 0.0
    outData.driftEndMm = 0
    setLen(outData.drift, FilmFrames)
    setLen(outData.tilt, FilmFrames)
    setLen(outData.camX, FilmFrames)
    setLen(outData.camY, FilmFrames)
    setLen(outData.camZ, FilmFrames)
    setLen(outData.tgtX, FilmFrames)
    setLen(outData.tgtY, FilmFrames)
    setLen(outData.tgtZ, FilmFrames)
    setLen(outData.snapPx, FilmFrames * BodyTotal)
    setLen(outData.snapPy, FilmFrames * BodyTotal)
    setLen(outData.snapPz, FilmFrames * BodyTotal)
    setLen(outData.snapQw, FilmFrames * BodyTotal)
    setLen(outData.snapQx, FilmFrames * BodyTotal)
    setLen(outData.snapQy, FilmFrames * BodyTotal)
    setLen(outData.snapQz, FilmFrames * BodyTotal)
    setLen(outData.snapR, FilmFrames * BodyTotal)
    setLen(outData.snapH, FilmFrames * BodyTotal)
    setLen(outData.snapVqw, FilmFrames)
    setLen(outData.snapVqx, FilmFrames)
    setLen(outData.snapVqy, FilmFrames)
    setLen(outData.snapVqz, FilmFrames)
    var w: world3d.World3d
    var cons: DuckPitchCons
    buildDuck(w, BallCenterX, BallCenterY, DuckRootZ, cons)
    echo("PHASE assembly done bodies=" + strings.IntToStr(w.count))
    if w.count != BodyTotal - 1:
        echo("FAIL assembly body count")
        return outData
    if w.conCount != 14:
        echo("FAIL assembly constraint count")
        return outData
    # execution-side ball injection, the microduck_ball_probe window:
    # after the assembly, before the first physics step
    let ballSlot = world3d.World3dSpawnBody(w, BallCenterX, BallCenterY, BallCenterZ, BallMassKg, BallRadiusM, world3d.World3dBodyBallRigid)
    if ballSlot != BallSlot:
        echo("FAIL ball slot mismatch")
        return outData
    echo("PHASE ball spawned slot=" + strings.IntToStr(ballSlot))
    # arm the ball-frame rigid balance servo at the release pose — the
    # microduck_ball_probe caseB wiring verbatim: Init once after the
    # ball spawn and before the first step, Tick every tick immediately
    # before the physics step
    let torsoSlot: int32 = mm.MicroduckLinkTorso
    let headSlot: int32 = mm.MicroduckLinkHead
    var st: bsr.BallServoRigidState
    bsr.BallServoRigidStateInit(st, w, ballSlot, torsoSlot, headSlot,
        bsr.BallServoRigidDefaultK, bsr.BallServoRigidDefaultC,
        bsr.BallServoRigidDefaultLinCapMps, bsr.BallServoRigidDefaultLinDampCapMps,
        bsr.BallServoRigidDefaultKAng, bsr.BallServoRigidDefaultCAng,
        bsr.BallServoRigidDefaultAngCapRadS, bsr.BallServoRigidDefaultAngDampCapRadS,
        bsr.BallServoRigidDefaultRampTicks)
    # the caseL dual trim channels on top (the runCaseL wiring verbatim):
    # the slow hip-pitch goal-offset integrator at the caseG CEM-best
    # operating point and the lateral roll twin with the ball-velocity
    # brake — disjoint write sets (pitch conGoal / roll conGoal columns),
    # armed once after the torso servo, before the first tick
    var mdlTrim: mm.MicroduckModel = mm.MicroduckModelBuild()
    var ht: bsr.BallServoHipTrimState
    bsr.BallServoHipTrimInit(ht, w, ballSlot, 0, ballSlot - 1,
        cons.hipL, cons.hipR,
        mdlTrim.joints[mm.MicroduckJointHipPitchL].minRad, mdlTrim.joints[mm.MicroduckJointHipPitchL].maxRad,
        TrimPitchDTheta0, TrimRate, TrimPitchRangeRad)
    var rt: bsr.BallServoRollTrimState
    bsr.BallServoRollTrimInit(rt, w, ballSlot, 0, ballSlot - 1,
        cons.hipRollL, cons.hipRollR,
        mdlTrim.joints[mm.MicroduckJointHipRollL].minRad, mdlTrim.joints[mm.MicroduckJointHipRollL].maxRad,
        0.0, TrimRate, TrimRollRangeRad)
    bsr.BallServoRollTrimSetFeedforward(rt, TrimRollKFfLat)
    # topple measure: the assembly probe's convention — the duck fell
    # when its head com dropped below the torso com (a lying duck keeps
    # them equal, so the pair crossing is the honest first-loss signal)
    let ballX0: float64 = w.bodyPx[ballSlot]
    let ballY0: float64 = w.bodyPy[ballSlot]
    # ball visual attitude, identity at the release pose (render-layer
    # only; integrated at every frame capture over the frame step, the
    # fixed physics3d tick is 1/240 s)
    var vqw: float64 = 1.0
    var vqx: float64
    var vqy: float64
    var vqz: float64
    vqx = 0.0
    vqy = 0.0
    vqz = 0.0
    var fCamX: float64
    var fCamY: float64
    var fCamZ: float64
    var fTgtX: float64
    var fTgtY: float64
    var fTgtZ: float64
    var rejected: int32
    rejected = 0
    var firstRejectTick: int32
    firstRejectTick = 0 - 1
    var stallTick: int32
    stallTick = 0 - 1
    var fallTick: int32
    fallTick = 0 - 1
    var disarmTick: int32
    disarmTick = 0 - 1
    var driftMax: float64
    driftMax = 0.0
    var rejectRun: int32 = 0
    var frame: int32 = 0
    echo("PHASE servos armed, entering pass1")
    var tick: int32 = 0
    while tick < TotalTicks and stallTick < 0:
        # the caseL stack timing: torso servo + pitch trim + roll trim,
        # then the step (disjoint write sets, the probe's channel order)
        bsr.BallServoRigidTick(st, w)
        bsr.BallServoHipTrimTick(ht, w)
        bsr.BallServoRollTrimTick(rt, w)
        # the dynamic-balance shot: two scripted lateral pushes on the
        # ball (tick 2400 and 5200, +Y then -Y) — the servo/trim recovery
        # wobble is the film's subject, invisible without a disturbance
        if tick == PerturbTick1 or tick == PerturbTick2:
            var pd: int32 = 1
            if tick == PerturbTick2:
                pd = 0 - 1
            w.bodyVy[ballSlot] = w.bodyVy[ballSlot] + float64(pd) * FilmPerturbMps
        if st.armed == 0:
            if disarmTick < 0:
                disarmTick = tick
        var r = physics3d.Physics3dStep(w, "film:duckball")
        if r.statusCode != physics3d.Physics3dStatusOk:
            rejected = rejected + 1
            rejectRun = rejectRun + 1
            if firstRejectTick < 0:
                firstRejectTick = tick
            if rejectRun > StallRejectRun:
                stallTick = tick
        else:
            rejectRun = 0
        let dx = w.bodyPx[ballSlot] - ballX0
        let dy = w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        if drift > driftMax:
            driftMax = drift
        # torso->head line tilt from vertical (degrees): the visible
        # dynamic-balance signal, drawn on the caption each frame
        var hdx: float64 = w.bodyPx[headSlot] - w.bodyPx[torsoSlot]
        var hdy: float64 = w.bodyPy[headSlot] - w.bodyPy[torsoSlot]
        var hdz: float64 = w.bodyPz[headSlot] - w.bodyPz[torsoSlot]
        let hlen = numerics.CsgSqrt(hdx * hdx + hdy * hdy + hdz * hdz)
        if hlen > 0.000001:
            hdx = hdx / hlen
            hdy = hdy / hlen
            hdz = hdz / hlen
        # acos by bisection (joint_motor precedent; no library acos)
        var lo: float64 = 0.0
        var hi: float64 = 3.14159265358979
        var bi: int32 = 0
        let cc = m.minFloat(1.0, m.maxFloat(0.0 - 1.0, hdz))
        while bi < 40:
            let mid = (lo + hi) * 0.5
            if m.cosFloat(mid) > cc:
                lo = mid
            else:
                hi = mid
            bi = bi + 1
        if frame < FilmFrames:
            outData.tilt[frame] = (lo + hi) * 0.5 * 57.29577951308232
        if fallTick < 0:
            if w.bodyPz[headSlot] < w.bodyPz[torsoSlot]:
                fallTick = tick
        if tick % FrameStep == 0 and tick > 0 and tick % 2400 == 0:
            echo("PHASE pass1 tick=" + strings.IntToStr(tick))
        if tick >= 7200 and tick % 240 == 0:
            echo("PHASE crashwin tick=" + strings.IntToStr(tick) + " drift=" + strings.Int64ToStr(int64(drift)) + "mm fall=" + strings.IntToStr(fallTick))
        if tick % FrameStep == 0:
            # frame capture, inlined (scalar copies only)
            let bx = w.bodyPx[ballSlot]
            let by = w.bodyPy[ballSlot]
            let bz = w.bodyPz[ballSlot]
            BallVisualQuatStep(vqw, vqx, vqy, vqz, w.bodyAngVx[ballSlot], w.bodyAngVy[ballSlot], w.bodyAngVz[ballSlot], float64(FrameStep) / 240.0)
            outData.snapVqw[frame] = vqw
            outData.snapVqx[frame] = vqx
            outData.snapVqy[frame] = vqy
            outData.snapVqz[frame] = vqz
            if frame == 0:
                fTgtX = bx
                fTgtY = by
                fTgtZ = bz
                fCamX = bx + CamOffX
                fCamY = by + CamOffY
                fCamZ = bz + CamOffZ
            else:
                fTgtX = fTgtX + (bx - fTgtX) * CamSmooth
                fTgtY = fTgtY + (by - fTgtY) * CamSmooth
                fTgtZ = fTgtZ + (bz - fTgtZ) * CamSmooth
                fCamX = fCamX + (bx + CamOffX - fCamX) * CamSmooth
                fCamY = fCamY + (by + CamOffY - fCamY) * CamSmooth
                fCamZ = fCamZ + (bz + CamOffZ - fCamZ) * CamSmooth
            outData.drift[frame] = drift
            outData.camX[frame] = fCamX
            outData.camY[frame] = fCamY
            outData.camZ[frame] = fCamZ
            outData.tgtX[frame] = fTgtX
            outData.tgtY[frame] = fTgtY
            outData.tgtZ[frame] = fTgtZ
            var bi: int32 = 0
            while bi < w.count:
                let k: int32 = frame * BodyTotal + bi
                let vpx: float64 = w.bodyPx[bi]
                let vpy: float64 = w.bodyPy[bi]
                let vpz: float64 = w.bodyPz[bi]
                let vqw: float64 = w.bodyQuatW[bi]
                let vqx: float64 = w.bodyQuatX[bi]
                let vqy: float64 = w.bodyQuatY[bi]
                let vqz: float64 = w.bodyQuatZ[bi]
                let vr: float64 = w.bodyRadius[bi]
                let vh: float64 = w.bodyCapsuleHalf[bi]
                outData.snapPx[k] = vpx
                outData.snapPy[k] = vpy
                outData.snapPz[k] = vpz
                outData.snapQw[k] = vqw
                outData.snapQx[k] = vqx
                outData.snapQy[k] = vqy
                outData.snapQz[k] = vqz
                outData.snapR[k] = vr
                outData.snapH[k] = vh
                bi = bi + 1
            frame = frame + 1
        tick = tick + 1
    # stall freeze: the remaining frames hold the last world state
    while frame < FilmFrames:
        let dx = w.bodyPx[ballSlot] - ballX0
        let dy = w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        let bx = w.bodyPx[ballSlot]
        let by = w.bodyPy[ballSlot]
        let bz = w.bodyPz[ballSlot]
        fTgtX = fTgtX + (bx - fTgtX) * CamSmooth
        fTgtY = fTgtY + (by - fTgtY) * CamSmooth
        fTgtZ = fTgtZ + (bz - fTgtZ) * CamSmooth
        fCamX = fCamX + (bx + CamOffX - fCamX) * CamSmooth
        fCamY = fCamY + (by + CamOffY - fCamY) * CamSmooth
        fCamZ = fCamZ + (bz + CamOffZ - fCamZ) * CamSmooth
        outData.drift[frame] = drift
        outData.camX[frame] = fCamX
        outData.camY[frame] = fCamY
        outData.camZ[frame] = fCamZ
        outData.tgtX[frame] = fTgtX
        outData.tgtY[frame] = fTgtY
        outData.tgtZ[frame] = fTgtZ
        var bf: int32 = 0
        while bf < w.count:
            let k: int32 = frame * BodyTotal + bf
            let vpx: float64 = w.bodyPx[bf]
            let vpy: float64 = w.bodyPy[bf]
            let vpz: float64 = w.bodyPz[bf]
            let vqw: float64 = w.bodyQuatW[bf]
            let vqx: float64 = w.bodyQuatX[bf]
            let vqy: float64 = w.bodyQuatY[bf]
            let vqz: float64 = w.bodyQuatZ[bf]
            let vr: float64 = w.bodyRadius[bf]
            let vh: float64 = w.bodyCapsuleHalf[bf]
            outData.snapPx[k] = vpx
            outData.snapPy[k] = vpy
            outData.snapPz[k] = vpz
            outData.snapQw[k] = vqw
            outData.snapQx[k] = vqx
            outData.snapQy[k] = vqy
            outData.snapQz[k] = vqz
            outData.snapR[k] = vr
            outData.snapH[k] = vh
            bf = bf + 1
        frame = frame + 1
    echo("PHASE pass1 complete driftEnd=" + strings.Int64ToStr(int64(outData.drift[FilmFrames - 1])))
    if !world3d.World3dValid(w):
        echo("FAIL world validity")
        return outData
    outData.rejected = rejected
    outData.firstRejectTick = firstRejectTick
    outData.stallTick = stallTick
    outData.fallTick = fallTick
    outData.disarmTick = disarmTick
    outData.armedEnd = st.armed
    outData.driftMax = driftMax
    outData.driftEndMm = MmOf(outData.drift[FilmFrames - 1])
    outData.trimDThetaEnd = ht.dTheta
    outData.trimDRollEnd = rt.dRoll
    outData.ok = true
    return outData

# Per-frame state file from the snapshot memory (pass 1 output, pass 2
# input): line 1 bodyCount, then one line per body
#   pxMm pyMm pzMm qwN qxN qyN qzN rMm hMm
# with the ball row (the last body) carrying four extra trailing columns
#   vqwN vqxN vqyN vqzN
# (the render-layer visual attitude quaternion, 1e9-fixed; mm lengths,
# 1e9-fixed quaternions; colors are derived in the worker
# from the asserted spawn-order slots). The buffers are borrowed — the
# data stays owned by main across all 384 writes.
@borrows
fn WriteStateFile(data: FilmData, frame: int32) =
    var text: str = ""
    text = text + strings.IntToStr(BodyTotal) + "\n"
    var bi: int32 = 0
    while bi < BodyTotal:
        let k: int32 = frame * BodyTotal + bi
        text = text + strings.Int64ToStr(MmOf(data.snapPx[k]))
        text = text + " " + strings.Int64ToStr(MmOf(data.snapPy[k]))
        text = text + " " + strings.Int64ToStr(MmOf(data.snapPz[k]))
        text = text + " " + strings.Int64ToStr(QuatOf(data.snapQw[k]))
        text = text + " " + strings.Int64ToStr(QuatOf(data.snapQx[k]))
        text = text + " " + strings.Int64ToStr(QuatOf(data.snapQy[k]))
        text = text + " " + strings.Int64ToStr(QuatOf(data.snapQz[k]))
        text = text + " " + strings.Int64ToStr(MmOf(data.snapR[k]))
        text = text + " " + strings.Int64ToStr(MmOf(data.snapH[k]))
        if bi == BallSlot:
            text = text + " " + strings.Int64ToStr(QuatOf(data.snapVqw[frame]))
            text = text + " " + strings.Int64ToStr(QuatOf(data.snapVqx[frame]))
            text = text + " " + strings.Int64ToStr(QuatOf(data.snapVqy[frame]))
            text = text + " " + strings.Int64ToStr(QuatOf(data.snapVqz[frame]))
        text = text + "\n"
        bi = bi + 1
    os.WriteFile(StatePath(frame), text)

# Per-frame camera/caption parameter file (numeric line 1, state line 2,
# label line 3, caption line 4, subcaption line 5):
#   line 1: camX camY camZ tgtX tgtY tgtZ focal   (microns)
fn WriteParam(frame: int32,
              camX: float64,
              camY: float64,
              camZ: float64,
              tgtX: float64,
              tgtY: float64,
              tgtZ: float64,
              stateIdx: int32,
              label: str,
              caption: str,
              subcap: str) =
    var ptext: str = ""
    ptext = ptext + strings.Int64ToStr(MicronOf(camX))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(camY))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(camZ))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtX))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtY))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(tgtZ))
    ptext = ptext + " " + strings.Int64ToStr(MicronOf(CamFocal))
    ptext = ptext + "\n"
    ptext = ptext + strings.IntToStr(stateIdx) + "\n"
    ptext = ptext + label + "\n"
    ptext = ptext + caption + "\n"
    ptext = ptext + subcap + "\n"
    os.WriteFile(ParamPath(frame), ptext)

# Wide checker ground: the RasterGround ray-cast contract with +/-80 m
# reach and a 2 m band (the ball_film stage, verbatim).
@borrows
fn GroundWide(t: raster.RasterTarget, cam: camera.CinemaCamera) =
    var py: int32 = 0
    while py < t.height:
        let sv = (float64(t.height) * 0.5 - float64(py) - 0.5) / cam.focalPx
        let dzRow = cam.fz + cam.uz * sv
        if dzRow < -0.0001:
            var px: int32 = 0
            while px < t.width:
                let su = (float64(px) + 0.5 - float64(t.width) * 0.5) / cam.focalPx
                let dx = cam.fx + cam.rx * su
                let dy = cam.fy + cam.ry * su
                let tt = (0.0 - cam.posZ) / dzRow
                if tt > 0.1:
                    let hitX = cam.posX + dx * tt
                    let hitY = cam.posY + dy * tt
                    if hitX > 0.0 - GroundExtent:
                        if hitX < GroundExtent:
                            if hitY > 0.0 - GroundExtent:
                                if hitY < GroundExtent:
                                    let bandX: int32 = int32(m.floorFloat(hitX * 0.5))
                                    let bandY: int32 = int32(m.floorFloat(hitY * 0.5))
                                    var lum = 0.35 + 0.65 * raster.RasterLightZ
                                    if (bandX + bandY) % 2 == 0:
                                        lum = lum * 0.82
                                    raster.RasterPut(t, px, py, tt, int32(90.0 * lum), int32(80.0 * lum), int32(70.0 * lum))
                px = px + 1
        py = py + 1

# Pass 2 worker: load this frame's param file (camera, label, captions)
# and state file, render ground + meshed duck + ball, draw the captions,
# write the PPM. Every input comes from this frame's own files — no
# shared mutable state across threads (the mesh handle table and the
# mesh_render SoA store are read-only here).
fn duckRenderWorker(raw: ptr, index: int32, worker: int32): int32 =
    let _raw = raw
    let _worker = worker
    let ptext: str = os.ReadFile(ParamPath(index))
    if ptext.len < 8:
        return 1
    var pos: int32 = 0
    var camv: int64[]
    setLen(camv, 0)
    var fi: int32 = 0
    while fi < 7:
        let v = ScanI64(ptext, pos)
        add(camv, v)
        fi = fi + 1
    let stateIdx: int32 = int32(ScanI64(ptext, pos))
    let label: str = ScanLine(ptext, pos)
    let caption: str = ScanLine(ptext, pos)
    let subcap: str = ScanLine(ptext, pos)
    var cam = camera.CinemaCameraLookAt(
        MicronToFloat(camv[0]), MicronToFloat(camv[1]), MicronToFloat(camv[2]),
        MicronToFloat(camv[3]), MicronToFloat(camv[4]), MicronToFloat(camv[5]),
        MicronToFloat(camv[6]), FilmWidth, FilmHeight)
    let stext: str = os.ReadFile(StatePath(stateIdx))
    if stext.len < 4:
        return 1
    var spos: int32 = 0
    let bc: int32 = int32(ScanI64(stext, spos))
    if bc != BodyTotal:
        return 1
    var px: float64[]
    var py: float64[]
    var pz: float64[]
    var qw: float64[]
    var qx: float64[]
    var qy: float64[]
    var qz: float64[]
    var rad: float64[]
    # ball visual attitude columns (identity until the ball row's four
    # extra tokens are scanned below)
    var bvqw: float64 = 1.0
    var bvqx: float64 = 0.0
    var bvqy: float64 = 0.0
    var bvqz: float64 = 0.0
    setLen(px, BodyTotal)
    setLen(py, BodyTotal)
    setLen(pz, BodyTotal)
    setLen(qw, BodyTotal)
    setLen(qx, BodyTotal)
    setLen(qy, BodyTotal)
    setLen(qz, BodyTotal)
    setLen(rad, BodyTotal)
    var bi: int32 = 0
    while bi < BodyTotal:
        # expr -> seq-element stores ride explicit value temps so the
        # cold reader sees plain f64 stores; the capsule half-length
        # token is consumed and discarded (mesh render derives impostor
        # geometry from the dock table)
        let vx: float64 = float64(ScanI64(stext, spos)) / 1000.0
        let vy: float64 = float64(ScanI64(stext, spos)) / 1000.0
        let vz: float64 = float64(ScanI64(stext, spos)) / 1000.0
        let vqw: float64 = QuatToFloat(ScanI64(stext, spos))
        let vqx: float64 = QuatToFloat(ScanI64(stext, spos))
        let vqy: float64 = QuatToFloat(ScanI64(stext, spos))
        let vqz: float64 = QuatToFloat(ScanI64(stext, spos))
        let vr: float64 = float64(ScanI64(stext, spos)) / 1000.0
        let _vh: float64 = float64(ScanI64(stext, spos)) / 1000.0
        if bi == BallSlot:
            bvqw = QuatToFloat(ScanI64(stext, spos))
            bvqx = QuatToFloat(ScanI64(stext, spos))
            bvqy = QuatToFloat(ScanI64(stext, spos))
            bvqz = QuatToFloat(ScanI64(stext, spos))
        px[bi] = vx
        py[bi] = vy
        pz[bi] = vz
        qw[bi] = vqw
        qx[bi] = vqx
        qy[bi] = vqy
        qz[bi] = vqz
        rad[bi] = vr
        bi = bi + 1
    var t: raster.RasterTarget
    t = raster.RasterMake(FilmWidth, FilmHeight)
    GroundWide(t, cam)
    DrawDuckMeshes(t, cam, px, py, pz, qw, qx, qy, qz, rad, bvqw, bvqx, bvqy, bvqz)
    text.RasterText(t, 40, 40, 2, label, 255, 255, 255)
    let cw: int32 = text.TextPixelWidth(caption, 3)
    text.RasterText(t, (FilmWidth - cw) / 2, FilmHeight - 96, 3, caption, 240, 240, 220)
    if subcap.len > 0:
        let sw: int32 = text.TextPixelWidth(subcap, 2)
        text.RasterText(t, (FilmWidth - sw) / 2, FilmHeight - 48, 2, subcap, 210, 215, 230)
    raster.RasterWritePpm(t, FramePath(index))
    if index == SpotFrameDeploy:
        raster.RasterWritePpm(t, FilmDir + "/spot_deploy.ppm")
    if index == SpotFrameBalance:
        raster.RasterWritePpm(t, FilmDir + "/spot_balance.ppm")
    return 0

fn main(): int32 =
    os.MkdirAll(FilmDir, 493)
    LoadMeshes()
    # ---- pass 1: the microduck-on-ball episode ----
    var data = RunFilm()
    if !data.ok:
        echo("FAIL film physics segment (assembly/world/frame buffers)")
        return 1
    # ---- act captions (all str work is post-loop) ----
    # first balance-loss tick: the servo disarm latch or the head-below-
    # torso topple, whichever comes first — the honest SURVIVED counter
    var lossTick: int32
    lossTick = data.fallTick
    if data.disarmTick >= 0:
        if lossTick < 0:
            lossTick = data.disarmTick
        else:
            if data.disarmTick < lossTick:
                lossTick = data.disarmTick
    var f: int32 = 0
    while f < FilmFrames:
        var lbl: str = "DEPLOY"
        if f >= Act1Frames:
            lbl = "BALANCE"
        var cap: str
        var subcap: str
        if f >= FilmFrames - EndCaptionFrames:
            if lossTick >= 0:
                cap = "SURVIVED " + strings.IntToStr(lossTick) + " TICKS"
            else:
                if data.drift[FilmFrames - 1] > DriftHonestLimitM:
                    cap = "STABLE / DRIFT " + FmtMeters(data.drift[FilmFrames - 1])
                else:
                    cap = "STABLE"
            subcap = "FREE BALL / SERVO + DUAL TRIM CONTROL"
        else:
            if f < Act1Frames:
                cap = "MICRODUCK BALL BALANCE II - PURE CHENG XPBD"
                subcap = ""
            else:
                cap = "BALL DRIFT " + FmtMeters(data.drift[f]) + " / TILT " + FmtTilt(data.tilt[f])
                subcap = "FREE BALL / SERVO + DUAL TRIM CONTROL"
        WriteParam(f, data.camX[f], data.camY[f], data.camZ[f],
            data.tgtX[f], data.tgtY[f], data.tgtZ[f],
            f, lbl, cap, subcap)
        f = f + 1
    # ---- state files from the snapshot memory ----
    f = 0
    while f < FilmFrames:
        WriteStateFile(data, f)
        f = f + 1
    echo("PHASE snapshots written")
    # ---- pass 2: frame-parallel render ----
    var pool = thread.PoolNew(0)
    thread.ParallelFor(pool, FilmFrames, &duckRenderWorker, nil)
    echo("PHASE pass2 render done")
    echo("PHASE pass2 done")
    # ---- pass 3: stream PPM frames -> VideoToolbox -> microduck_balance.mp4 ----
    let vctx: ptr = vtbr.VtbrVideoSessionCreate(FilmWidth, FilmHeight)
    if vctx == nil:
        echo("FAIL vt session")
        return 1
    var encodeFail: int32
    encodeFail = 0
    var pixTotal: int32 = FilmWidth * FilmHeight
    f = 0
    while f < FilmFrames:
        let ppm: str = os.ReadFile(FramePath(f))
        if ppm.len < 16 + pixTotal * 3:
            echo("FAIL ppm short frame=" + strings.IntToStr(f))
            return 1
        var b: rawbytes.Bytes = rawbytes.BytesAlloc(pixTotal * 4)
        var pi: int32 = 0
        while pi < pixTotal:
            rawbytes.BytesSet(b, pi * 4, int32(ppm[16 + pi * 3 + 2]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 1, int32(ppm[16 + pi * 3 + 1]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 2, int32(ppm[16 + pi * 3]) & 255)
            rawbytes.BytesSet(b, pi * 4 + 3, int32(255))
            pi = pi + 1
        let erc = vtbr.VtbrVideoEncodeBgra(vctx, rawbytes.BytesDataPtr(b), FilmWidth * 4, FilmWidth, FilmHeight, f * 1000)
        rawbytes.BytesFree(b)
        if erc != 0:
            encodeFail = encodeFail + 1
        if f != SpotFrameDeploy:
            if f != SpotFrameBalance:
                let _removed = os.RemoveFile(FramePath(f))
        f = f + 1
    if encodeFail > 0:
        echo("FAIL encode frames n=" + strings.IntToStr(encodeFail))
        return 1
    if vtbr.VtbrVideoFinish(vctx) != 0:
        echo("FAIL video finish")
        return 1
    let _drained = vtbr.VtbrVideoDrain(vctx)
    var videoPayload: uint8[]
    setLen(videoPayload, 0)
    vtbr.VtbrVideoCopyPayload(vctx, videoPayload)
    var videoSizes: int32[]
    setLen(videoSizes, 0)
    vtbr.VtbrVideoCopySizes(vctx, videoSizes)
    var videoKf: int32[]
    setLen(videoKf, 0)
    vtbr.VtbrVideoCopyKeyframes(vctx, videoKf)
    var sps: uint8[]
    setLen(sps, 0)
    var pps: uint8[]
    setLen(pps, 0)
    vtbr.VtbrVideoCopyParamSets(vctx, sps, pps)
    if sps.len == 0 || pps.len == 0:
        echo("FAIL paramsets empty")
        return 1
    if videoSizes.len != FilmFrames:
        echo("FAIL video sample count n=" + strings.IntToStr(videoSizes.len))
        return 1
    var inp: mp4.Mp4Input
    inp.videoSizes = videoSizes
    inp.videoKf = videoKf
    inp.videoPayload = videoPayload
    inp.sps = sps
    inp.pps = pps
    var scorePcm: uint8[]
    setLen(scorePcm, 0)
    let scoreSamples: int32 = score.ScorePcm48k(scorePcm, 16)
    var audioPayload: uint8[]
    setLen(audioPayload, 0)
    var audioSizes: int32[]
    setLen(audioSizes, 0)
    # user feedback 2026-09-12: the synthetic score reads as noisy
    # buzzing — ship this film with a silent audio track (dual-track
    # pipeline stays intact; other films keep their score)
    var si: int32 = 0
    while si < scorePcm.len:
        scorePcm[si] = uint8(0)
        si = si + 1
    let arc = aac.AacEncodePcm16(scorePcm, scorePcm.len, audioPayload, audioSizes)
    if arc != 0:
        echo("FAIL audio encode rc=" + strings.IntToStr(arc))
        return 1
    var packetBytes: int32 = 0
    var asi: int32 = 0
    while asi < audioSizes.len:
        packetBytes = packetBytes + audioSizes[asi]
        asi = asi + 1
    if packetBytes != audioPayload.len:
        echo("FAIL audio payload mismatch")
        return 1
    inp.audioPayload = audioPayload
    inp.audioSizes = audioSizes
    inp.audioSamples = scoreSamples
    let filmPath: str = FilmDir + "/microduck_balance.mp4"
    mp4.Mp4Assemble(inp, filmPath)
    var survived: int32 = TotalTicks
    if lossTick >= 0:
        survived = lossTick
    var man: str = ""
    man = man + "schema=" + FilmSchema + "\n"
    man = man + "film=MICRODUCK BALL BALANCE II\n"
    man = man + "frames=" + strings.IntToStr(FilmFrames) + "\n"
    man = man + "fps=24\n"
    man = man + "seconds=16\n"
    man = man + "ticks=" + strings.IntToStr(TotalTicks) + "\n"
    man = man + "acts=2\n"
    man = man + "act1=deploy frames 0-16 ticks 0-407 zero-velocity release on the ball top + servo soft-start\n"
    man = man + "act2=balance frames 17-383 ticks 408-9215 free ball triple servo stack live mm drift\n"
    man = man + "servoMode=full trim/pitch+roll\n"
    man = man + "servo=ball_servo_rigid BallServoRigidStateInit frozen defaults k=0.5 c=0.25 kAng=128 cAng=1.5 ramp=24 + BallServoHipTrim pitch slow integral dTheta0=0.009 rad rate=1/856 clamp=0.10 rad (caseG CEM-best) + BallServoRollTrim roll slow integral clamp=0.10 rad kFfLat=0.3 (caseL delivery rung)\n"
    man = man + "trimEvidence=microduck_ball_probe caseL delivery stack measured 5000-tick stand end drift 459.5 mm < 500 mm\n"
    man = man + "duck=15 capsule links (full-DoF verbatim MJCF MicroduckModelBuild assembly, balanced stance) + 14 hinge servos parked at stance\n"
    man = man + "ball=real FIBA size-7 BallRigid r=0.121 m m=0.62 kg at (0, 0.85, 0.121)\n"
    man = man + "fallTick=" + strings.IntToStr(data.fallTick) + "\n"
    man = man + "survivedTicks=" + strings.IntToStr(survived) + "\n"
    man = man + "servoArmedEnd=" + strings.IntToStr(data.armedEnd) + "\n"
    man = man + "servoDisarmTick=" + strings.IntToStr(data.disarmTick) + "\n"
    man = man + "ballDriftEndMm=" + strings.Int64ToStr(data.driftEndMm) + "\n"
    man = man + "ballDriftMaxMm=" + strings.Int64ToStr(MmOf(data.driftMax)) + "\n"
    man = man + "trimPitchEndMrad=" + strings.Int64ToStr(MmOf(data.trimDThetaEnd)) + "\n"
    man = man + "trimRollEndMrad=" + strings.Int64ToStr(MmOf(data.trimDRollEnd)) + "\n"
    man = man + "rejectedCount=" + strings.IntToStr(data.rejected) + "\n"
    man = man + "firstRejectTick=" + strings.IntToStr(data.firstRejectTick) + "\n"
    man = man + "stallTick=" + strings.IntToStr(data.stallTick) + "\n"
    man = man + "render=microduck official stl meshes via mesh_render: trunk_base->torso, bearing_roll->hipYawCarrierL/R (drums on the yaw-rotating frames, official urdf root-frame placement preserved), upper_leg_left->thighR + thighL (rigid yaw-pi mirror), foot_left+ankle_left->footR + footL (rigid yaw-pi mirror), bottom_head_shell+face_part->head; neck chain + shins = dark capsule impostors (no shipped mesh); ball = raster.RasterBasketball seams on the render-layer visual attitude quaternion integrated from the ball angular velocity\n"
    man = man + "renderGap=resolved: MeshRasterFrameOrient renders every mesh with the full link quaternion (body q composed with the fixed dock z rotation); remaining approximation = thighL/footL rigid yaw-pi mirror dock (official mirrored stls not shipped)\n"
    man = man + "audioPackets=" + strings.IntToStr(audioSizes.len) + "\n"
    man = man + "audioSamples=" + strings.IntToStr(scoreSamples) + "\n"
    os.WriteFile(FilmDir + "/manifest.txt", man)
    # scratch cleanup: state/param files were pass-2 inputs only
    f = 0
    while f < FilmFrames:
        let _rs = os.RemoveFile(StatePath(f))
        let _rp = os.RemoveFile(ParamPath(f))
        f = f + 1
    echo("fallTick=" + strings.IntToStr(data.fallTick) + " survivedTicks=" + strings.IntToStr(survived))
    echo("servoArmedEnd=" + strings.IntToStr(data.armedEnd) + " servoDisarmTick=" + strings.IntToStr(data.disarmTick))
    echo("ballDriftEndMm=" + strings.Int64ToStr(data.driftEndMm) + " ballDriftMaxMm=" + strings.Int64ToStr(MmOf(data.driftMax)))
    echo("trimPitchEndMrad=" + strings.Int64ToStr(MmOf(data.trimDThetaEnd)) + " trimRollEndMrad=" + strings.Int64ToStr(MmOf(data.trimDRollEnd)))
    echo("rejected=" + strings.IntToStr(data.rejected) + " firstRejectTick=" + strings.IntToStr(data.firstRejectTick) + " stallTick=" + strings.IntToStr(data.stallTick))
    echo("frames=" + strings.IntToStr(FilmFrames))
    echo("audioPackets=" + strings.IntToStr(audioSizes.len))
    echo("film=" + filmPath)
    echo("PASS duck film")
    return 0
