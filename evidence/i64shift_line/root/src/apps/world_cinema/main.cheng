# world_cinema (E1): the ten-second film pipeline.
#
#   produce -> validate -> materialize -> execute 2400 authority ticks.
#   Camera A renders 240 PPM frames (24 fps) of the normal film; the
#   support-removal intervention derives from the tick-1200 checkpoint and
#   renders its own 120-frame tail; cameras B/C render verification frames
#   of the same submitted states. A bound manifest records the facts CID,
#   world CIDs, causal metrics (free-fall COM vs analytic, no-contact
#   window) and frame counts. Rendering reads only submitted state.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/assets/climb_assets
import cheng/game/world3d
import cheng/game/rope3d
import cheng/game/physics3d
import cheng/game/time
import cheng/game/cinema/camera
import cheng/game/render/cpu_raster as raster
import cheng/game/render/character
import std/strings as strings
import std/math as m
import std/os

const
    FilmAppSchema = "cheng.apps.world_cinema.v1"
    FilmOutDir = "artifacts/csg_world_video"
    FilmWidth = 1280
    FilmHeight = 720
    FilmCheckpointTick = 2100

fn fmtMmLocal(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

@borrows
fn renderWorld(cam: camera.CinemaCamera,
               w: world3d.World3d,
               partRoles: int32[],
               path: str) =
    var target: raster.RasterTarget
    target = raster.RasterMake(FilmWidth, FilmHeight)
    raster.RasterGround(target, cam)
    raster.RasterWallFace(target, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRope(target, cam, w)
    character.RenderCharacter(target, cam, w, partRoles)
    raster.RasterWritePpm(target, path)

fn framePath(dir: str, frame: int32): str =
    var n: int32 = frame
    var digits: str = ""
    var k: int32 = 0
    while k < 4:
        let d: int32 = n % 10
        digits = strings.IntToStr(d) + digits
        n = n / 10
        k = k + 1
    return dir + "/f" + digits + ".ppm"

fn main(): int32 =
    os.MkdirAll(FilmOutDir + "/normal", 493)
    os.MkdirAll(FilmOutDir + "/intervention", 493)
    os.MkdirAll(FilmOutDir + "/verify", 493)
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation status=" + strings.IntToStr(verdict.statusCode))
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize: " + err)
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    var camA = camera.CinemaCameraLookAt(-4.6, 3.2, 1.7, 0.0, 0.8, 1.35, 950.0, FilmWidth, FilmHeight)
    var camB = camera.CinemaCameraLookAt(3.0, 3.4, 1.5, 0.0, 0.85, 1.30, 1150.0, FilmWidth, FilmHeight)
    var camC = camera.CinemaCameraLookAt(-1.8, 3.4, 4.6, 0.0, 0.85, 1.20, 850.0, FilmWidth, FilmHeight)
    let factsCid: str = Fmt"{schema.CsgWorldFactsCid(facts)}"
    let charCid: str = climb_assets.ClimbCharacterCid(facts, mp)
    if charCid.len != 64:
        echo("FAIL character skeleton table rejected")
        return 1
    let startCid: str = Fmt"{World3dCid(st.w)}"
    echo("film start factsCid=" + factsCid + " worldCid=" + startCid)
    var comStart: float64 = World3dComZ(st.w)
    # intervention branch state
    var snapTaken: bool = false
    var snap: execution.CsgExecutionState
    var ivComZ0: float64 = 0.0
    var ivComVz0: float64 = 0.0
    var ivNoContact: bool = true
    var ivTicks: int32 = 0
    var ivFrames: int32 = 0
    var ivAnalyticErr: float64 = 0.0
    var ivComNow: float64 = 0.0
    var massSum: float64 = 0.0
    var weightedVz: float64 = 0.0
    var normalFrames: int32 = 0
    var tick: int32 = 0
    while tick < 2400:
        if st.w.tick % int64(10) == int64(0):
            let frame = time.CinemaTimeFrameOf(st.w.tick)
            renderWorld(camA, st.w, partRoles, framePath(FilmOutDir + "/normal", frame))
            normalFrames = normalFrames + 1
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL step rejected at tick " + strings.Int64ToStr(receipt.tick))
            return 1
        # checkpoint: derive the support-removal intervention branch
        if st.w.tick == int64(FilmCheckpointTick):
            snap = execution.CsgExecutionSnapshot(st)
            rope3d.Rope3dRemoveFromWorld(snap.w)
            snapTaken = true
            ivComZ0 = World3dComZ(snap.w)
            massSum = 0.0
            weightedVz = 0.0
            var bi: int32 = 0
            while bi < snap.w.count:
                if snap.w.bodyInvMass[bi] > 0.0:
                    let massKg = 1.0 / snap.w.bodyInvMass[bi]
                    massSum = massSum + massKg
                    weightedVz = weightedVz + massKg * snap.w.bodyVz[bi]
                bi = bi + 1
            ivComVz0 = weightedVz / massSum
            echo("intervention: support removed at tick " + strings.Int64ToStr(snap.w.tick) + " comZ=" + fmtMmLocal(ivComZ0) + " comVz=" + fmtMmLocal(ivComVz0))
        # advance + render the intervention branch after removal
        if snapTaken:
            # causality window: the first 60 ticks (250 ms) must be
            # contact-free and match the analytic ballistic COM exactly
            if ivTicks < 60:
                if ivTicks % 10 == 0:
                    let ivFrame = int32((snap.w.tick - int64(FilmCheckpointTick)) / int64(10))
                    renderWorld(camA, snap.w, partRoles, framePath(FilmOutDir + "/intervention", ivFrame))
                    ivFrames = ivFrames + 1
                var ivReceipt = physics3d.Physics3dStep(snap.w, "intervention:free-fall")
                if ivReceipt.statusCode != physics3d.Physics3dStatusOk:
                    echo("FAIL intervention step rejected at " + strings.Int64ToStr(ivReceipt.tick))
                    return 1
                if ivReceipt.contactCount > 0:
                    ivNoContact = false
                if ivTicks == 59:
                    let tWin: float64 = 60.0 / 240.0
                    ivComNow = World3dComZ(snap.w)
                    ivAnalyticErr = m.absFloat(ivComNow - (ivComZ0 + ivComVz0 * tWin - 0.5 * physics3d.Physics3dGravity * tWin * tWin))
                ivTicks = ivTicks + 1
            elif ivTicks < 1200:
                if ivTicks % 10 == 0:
                    let ivFrame = int32((snap.w.tick - int64(FilmCheckpointTick)) / int64(10))
                    renderWorld(camA, snap.w, partRoles, framePath(FilmOutDir + "/intervention", ivFrame))
                    ivFrames = ivFrames + 1
                var ivReceipt2 = physics3d.Physics3dStep(snap.w, "intervention:free-fall")
                if ivReceipt2.statusCode != physics3d.Physics3dStatusOk:
                    echo("FAIL intervention step rejected at " + strings.Int64ToStr(ivReceipt2.tick))
                    return 1
                ivTicks = ivTicks + 1
        tick = tick + 1
    let endCid: str = Fmt"{World3dCid(st.w)}"
    let comEnd: float64 = World3dComZ(st.w)
    # verification frames of the final submitted state from cameras B/C
    var vfinal: world3d.World3d = World3dClone(st.w)
    renderWorld(camB, vfinal, partRoles, FilmOutDir + "/verify/camB_final.ppm")
    renderWorld(camC, vfinal, partRoles, FilmOutDir + "/verify/camC_final.ppm")
    var ivNoContactStr: str = "0"
    if ivNoContact:
        ivNoContactStr = "1"
    # causal metric measured over the 250 ms contact-free window
    let ivErr: float64 = ivAnalyticErr
    echo("intervention: windowTicks=" + strings.IntToStr(ivTicks) + " comZ0=" + fmtMmLocal(ivComZ0) + " comNow=" + fmtMmLocal(ivComNow) + " comErr_mm=" + fmtMmLocal(ivErr * 1000.0) + " noContact=" + ivNoContactStr)
    # manifest
    var man: str = ""
    man = man + "schema=" + FilmAppSchema + "\n"
    man = man + "factsCid=" + factsCid + "\n"
    man = man + "characterCid=" + charCid + "\n"
    man = man + "startWorldCid=" + startCid + "\n"
    man = man + "endWorldCid=" + endCid + "\n"
    man = man + "normalFrames=" + strings.IntToStr(normalFrames) + "\n"
    man = man + "interventionFrames=" + strings.IntToStr(ivFrames) + "\n"
    man = man + "comRiseMm=" + fmtMmLocal((comEnd - comStart) * 1000.0) + "\n"
    man = man + "graspOk=" + strings.IntToStr(st.graspOkCount) + "\n"
    man = man + "graspFail=" + strings.IntToStr(st.graspFailCount) + "\n"
    man = man + "rejections=" + strings.IntToStr(st.rejectedCount) + "\n"
    man = man + "chainCid=" + st.chainCid + "\n"
    man = man + "interventionComErrMm=" + fmtMmLocal(ivErr * 1000.0) + "\n"
    man = man + "interventionNoContact=" + ivNoContactStr + "\n"
    os.WriteFile(FilmOutDir + "/manifest.txt", man)
    echo("manifest written: comRiseMm=" + fmtMmLocal((comEnd - comStart) * 1000.0) + " chainCid=" + st.chainCid)
    echo("PASS world_cinema")
    return 0
