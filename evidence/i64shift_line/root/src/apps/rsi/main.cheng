# 纯 Cheng RSI 框架: CLI 入口 (提案第6步)。
# 子命令:
#   run    --root:<repoRoot> --compiler:<compilerPath>
#         [--max-generations:n] [--max-candidates:n] [--meta:0|1]
#         [--store-dir:<absoluteDir>]
#   status --root:<repoRoot> [--store-dir:<absoluteDir>]
#   verify --root:<repoRoot> [--store-dir:<absoluteDir>]  (重算账本哈希链, 篡改必拒)
#   exhausted --root:<repoRoot> [--store-dir:<absoluteDir>]  (覆盖审计)
#   cdomain --root:<repoRoot> --compiler:<compilerPath> [--corpus:0] [--store-dir:<absoluteDir>]
# C 车头坑规避 (lessons 2026-09-07): 形参/call-result 外呼一律 Fmt;
# var-out 函数无返回值; add() 构造的数组不可传参 -> 参数解析全内联直读。
import std/cmdline as cmdline
import std/strings as strings
import std/strutils as strutil
import std/os as os
import cheng/rsi/types as types
import cheng/rsi/store as store
import cheng/rsi/engine as engine
import cheng/rsi/csg_layer as csg
import cheng/rsi/compiler_domain as cd

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 1:
        echo("usage: rsi <run|status|verify|exhausted|cdomain> --root:<repoRoot> --compiler:<path> [flags]")
        return 2
    let stage = Fmt"{cmdline.paramStr(1)}"
    var root: str
    var compilerPath: str
    var storeDirArg: str
    var corpusArgLocal: str
    var jobsTierArgLocal: str
    var llmEndpointArg: str
    var llmModelArg: str
    var maxGen: int32 = 1
    var maxCand: int32 = 3
    var metaEnabled: int32 = 0
    for i in 2..<(argc + 1):
        let item = Fmt"{cmdline.paramStr(i)}"
        if strings.HasPrefix(item, "--root:"):
            root = strings.CloneStrRange(item, 7, len(item) - 7)
        elif strings.HasPrefix(item, "--compiler:"):
            compilerPath = strings.CloneStrRange(item, 11, len(item) - 11)
        elif strings.HasPrefix(item, "--corpus:"):
            corpusArgLocal = strings.CloneStrRange(item, 9, len(item) - 9)
        elif strings.HasPrefix(item, "--jobs-tier:"):
            jobsTierArgLocal = strings.CloneStrRange(item, 12, len(item) - 12)
        elif strings.HasPrefix(item, "--store-dir:"):
            storeDirArg = strings.CloneStrRange(item, 12, len(item) - 12)
        elif strings.HasPrefix(item, "--llm-endpoint:"):
            llmEndpointArg = strings.CloneStrRange(item, 15, len(item) - 15)
        elif strings.HasPrefix(item, "--llm-model:"):
            llmModelArg = strings.CloneStrRange(item, 12, len(item) - 12)
        elif strings.HasPrefix(item, "--max-generations:"):
            let v = strings.CloneStrRange(item, 18, len(item) - 18)
            maxGen = strutil.ParseInt(strutil.Strip(v))
        elif strings.HasPrefix(item, "--max-candidates:"):
            let v = strings.CloneStrRange(item, 17, len(item) - 17)
            maxCand = strutil.ParseInt(strutil.Strip(v))
        elif strings.HasPrefix(item, "--meta:"):
            let v = strings.CloneStrRange(item, 7, len(item) - 7)
            metaEnabled = strutil.ParseInt(strutil.Strip(v))
    if stage == "run":
        if len(root) <= 0 || len(compilerPath) <= 0:
            echo("run requires --root:<repoRoot> and --compiler:<compilerPath>")
            return 2
        var budget: types.RsiBudget
        budget.maxGenerations = maxGen
        budget.maxCandidates = maxCand
        budget.compileTimeoutSec = 300
        budget.runTimeoutSec = 60
        budget.metaEnabled = metaEnabled
        if !types.RsiBudgetValid(budget):
            echo("rsi run: budget invalid")
            return 2
        if len(llmEndpointArg) > 0:
            if len(llmModelArg) <= 0:
                echo("rsi run: --llm-endpoint requires --llm-model")
                return 2
        let storeDir = if len(storeDirArg) > 0: Fmt"{storeDirArg}" else: Fmt"{root}/artifacts/rsi"
        let workDir = Fmt"{root}/src/rsi_work"
        return engine.RsiEngineRunSources(Fmt"{root}", Fmt"{compilerPath}",
                                          Fmt"{storeDir}", Fmt"{workDir}",
                                          budget, Fmt"{llmEndpointArg}",
                                          Fmt"{llmModelArg}")
    if stage == "status":
        if len(root) <= 0:
            echo("status requires --root:<repoRoot>")
            return 2
        let storeDir = if len(storeDirArg) > 0: Fmt"{storeDirArg}" else: Fmt"{root}/artifacts/rsi"
        var ok: int32 = 0
        var gen: int32 = 0
        var aStrategy: int32 = 0
        var aParam: int32 = 0
        var mStrategy: int32 = 0
        var score: int64 = 0
        var factsRoot: str
        store.RsiStoreLoadVersionInto(Fmt"{storeDir}", ok, gen, aStrategy,
                                      aParam, mStrategy, score, factsRoot)
        if ok != 1:
            echo("rsi_status: no committed version")
            return 1
        let scoreText = strings.Int64ToStr(score)
        echo(Fmt"rsi_status: gen={gen} a={aStrategy}/{aParam} m={mStrategy} score={scoreText}")
        echo(Fmt"rsi_status: facts_root={factsRoot}")
        return 0
    if stage == "verify":
        if len(root) <= 0:
            echo("verify requires --root:<repoRoot>")
            return 2
        let storeDir = if len(storeDirArg) > 0: Fmt"{storeDirArg}" else: Fmt"{root}/artifacts/rsi"
        let eventsPath = Fmt"{storeDir}/events.log"
        var lines: int32 = 0
        var tail: str
        store.RsiStoreVerifyChainInto(Fmt"{eventsPath}", lines, tail)
        if lines < 0:
            echo("rsi_verify: FAIL chain tampered or malformed")
            return 1
        # CSG 可控重放: 从盘上事实独立重算 DAG 根 + 版本链 + 降分合同,
        # 与账本 current.txt 对拍 —— 决策不是自报的。
        let factsPath = Fmt"{storeDir}/rsi.facts.jsonl"
        var replayOk: int32 = 0
        var replayGen: int32 = 0
        var replayScore: int64 = 0
        var replayRoot: str
        csg.RsiCsgReplayInto(Fmt"{factsPath}", replayOk, replayGen, replayScore,
                             replayRoot)
        if replayOk != 1:
            echo("rsi_verify: FAIL csg replay rejected facts")
            return 1
        var vOk: int32 = 0
        var vGen: int32 = 0
        var vA: int32 = 0
        var vP: int32 = 0
        var vM: int32 = 0
        var vScore: int64 = 0
        var vRoot: str
        store.RsiStoreLoadVersionInto(Fmt"{storeDir}", vOk, vGen, vA, vP, vM,
                                      vScore, vRoot)
        if vOk == 1:
            if replayRoot != vRoot || replayGen != vGen || replayScore != vScore:
                echo("rsi_verify: FAIL csg replay mismatch with ledger")
                return 1
        else:
            # cdomain 账本回退: 编译器域 ledger (compiler schema), 对
            # replay 链 (cversion gen/best_us) 与 cd 账本双对拍。
            var cdOk: int32 = 0
            var cdGen: int32 = 0
            var cdJobs: int32 = 0
            var cdCorpus: int32 = 0
            var cdBest: int64 = 0
            var cdSha: str
            var cdRootC: str
            cd.RsiCdLoadInto(Fmt"{storeDir}", cdOk, cdGen, cdJobs, cdCorpus,
                             cdBest, cdSha, cdRootC)
            if cdOk != 1:
                echo("rsi_verify: FAIL no committed version in either schema")
                return 1
            if replayGen != cdGen || replayScore != cdBest:
                echo("rsi_verify: FAIL csg replay mismatch with compiler ledger")
                return 1
        echo(Fmt"rsi_verify: OK lines={lines} gen={replayGen} score={replayScore}")
        echo(Fmt"rsi_verify: facts_root={replayRoot}")
        return 0
    if stage == "exhausted":
        if len(root) <= 0:
            echo("exhausted requires --root:<repoRoot>")
            return 2
        let storeDirX = if len(storeDirArg) > 0: Fmt"{storeDirArg}" else: Fmt"{root}/artifacts/rsi"
        let factsPathX = Fmt"{storeDirX}/rsi.facts.jsonl"
        var cov: int32 = 0
        var bestCorrect: int64 = -1
        var covOk: int32 = 0
        csg.RsiCsgCoverageInto(Fmt"{factsPathX}", cov, bestCorrect, covOk)
        if covOk != 1:
            echo("rsi_exhausted: FAIL coverage scan failed")
            return 1
        var vOk2: int32 = 0
        var vGen2: int32 = 0
        var vA2: int32 = 0
        var vP2: int32 = 0
        var vM2: int32 = 0
        var vScore2: int64 = 0
        var vRoot2: str
        store.RsiStoreLoadVersionInto(Fmt"{storeDirX}", vOk2, vGen2, vA2, vP2,
                                      vM2, vScore2, vRoot2)
        let covText = strings.IntToStr(cov)
        let bestText = strings.Int64ToStr(bestCorrect)
        if vOk2 != 1:
            echo("rsi_exhausted: FAIL no committed version")
            return 1
        # 分母与 RsiCsgCoverageInto 同口径: 域 0+1+3 = 31 格, 不硬编码。
        var totalCellsX: int32 = 0
        totalCellsX = totalCellsX + types.RsiTaskDomainCellCount(0)
        totalCellsX = totalCellsX + types.RsiTaskDomainCellCount(1)
        totalCellsX = totalCellsX + types.RsiTaskDomainCellCount(types.RsiTaskDomainGcd)
        let totalCellsText = strings.IntToStr(totalCellsX)
        if cov == totalCellsX && vScore2 <= bestCorrect:
            echo(Fmt"rsi_exhausted: EXHAUSTED covered={covText}/{totalCellsText} incumbent_min={bestText}")
            return 0
        echo(Fmt"rsi_exhausted: PARTIAL covered={covText}/{totalCellsText} best_min_aggregate={bestText} incumbent={vScore2}")
        return 1
    if stage == "cdomain":
        if len(root) <= 0 || len(compilerPath) <= 0:
            echo("cdomain requires --root and --compiler")
            return 2
        # 语料档默认 0 (src/tests/rsi_minimal_smoke.cheng, 唯一开放档, CID ef548daa…,
        # 以 types.RsiCompilerCorpusRel/CorpusOpen 为准); 候选 jobs 档 = (incumbent+1)%3。
        var corpusIdx: int32 = 0
        if len(corpusArgLocal) > 0:
            corpusIdx = strutil.ParseInt(strutil.Strip(Fmt"{corpusArgLocal}"))
        var jobsTierScan: int32 = -1
        if len(jobsTierArgLocal) > 0:
            jobsTierScan = strutil.ParseInt(strutil.Strip(Fmt"{jobsTierArgLocal}"))
        if !types.RsiCompilerCorpusOpen(corpusIdx):
            echo(Fmt"rsi_cdomain: corpus tier {corpusIdx} BLOCKED (only tier 0 open)")
            return 2
        let storeDirC = if len(storeDirArg) > 0: Fmt"{storeDirArg}" else: Fmt"{root}/artifacts/rsi_compiler"
        let workDirC = Fmt"{root}/src/rsi_work"
        os.MkdirAll(Fmt"{storeDirC}", 493)
        os.MkdirAll(Fmt"{workDirC}", 493)
        let factsPathC = Fmt"{storeDirC}/rsi.facts.jsonl"
        let eventsPathC = Fmt"{storeDirC}/events.log"
        let factsText0 = os.ReadFile(Fmt"{factsPathC}")
        if len(factsText0) <= 0:
            let schemaFactC = Fmt"{csg.RsiCsgSchemaFact}"
            os.WriteFile(Fmt"{factsPathC}", schemaFactC)
        var digestC = types.RsiGenesisDigest()
        var tailC: str
        var chainLinesC: int32 = 0
        store.RsiStoreVerifyChainInto(Fmt"{eventsPathC}", chainLinesC, tailC)
        if chainLinesC < 0:
            echo("rsi_cdomain: FAIL events chain tampered")
            return 1
        digestC = strings.CloneStr(tailC)
        var okC: int32 = 0
        var shaC: str
        var genC: int32 = 0
        var jobsC: int32 = 0
        var corpusC: int32 = 0
        var bestUsC: int64 = 0
        var rootC: str
        cd.RsiCdLoadInto(Fmt"{storeDirC}", okC, genC, jobsC, corpusC,
                         bestUsC, shaC, rootC)
        if okC != 1:
            # 创世: 基线 jobs 档 0 烤 (best-of-5), peak 入预算表。
            var sha0: str
            var us0: int64 = 0
            var pk0: int64 = 0
            var ok0: int32 = 0
            var freeze0: str
            cd.RsiCdBakePairedInto(Fmt"{root}", Fmt"{compilerPath}",
                                   Fmt"{workDirC}", 0, corpusIdx, "g0",
                                   sha0, us0, pk0, ok0, freeze0)
            if ok0 != 1:
                echo("rsi_cdomain: FAIL genesis paired bake failed")
                return 1
            var root0: str
            var root0Ok: int32 = 0
            csg.RsiCsgRootInto(Fmt"{factsPathC}", root0, root0Ok)
            if root0Ok != 1:
                return 3
            let v0 = cd.RsiCdVersionFact(0, 0, corpusIdx, us0, "none")
            if !csg.RsiCsgAppendFact(Fmt"{factsPathC}", v0):
                return 3
            var root0b: str
            var root0bOk: int32 = 0
            csg.RsiCsgRootInto(Fmt"{factsPathC}", root0b, root0bOk)
            if root0bOk != 1:
                return 3
            if !cd.RsiCdCommit(Fmt"{storeDirC}", 0, 0, corpusIdx, us0,
                               Fmt"{sha0}", root0b):
                return 3
            if !cd.RsiCdBudgetStore(Fmt"{storeDirC}", corpusIdx, pk0):
                return 3
            let payload0 = strutil.Join(["event=cdomain_genesis",
                                         "gen=0",
                                         Fmt"jobs_tier=0",
                                         Fmt"corpus={corpusIdx}",
                                         Fmt"total_us={us0}",
                                         Fmt"peak_bytes={pk0}"], " ")
            let next0 = store.RsiStoreAppendLine(Fmt"{eventsPathC}",
                                                Fmt"{digestC}", payload0)
            if len(next0) == 64:
                digestC = strings.CloneStr(next0)
            echo(Fmt"rsi_cdomain: genesis gen=0 jobs=1 total_us={us0} peak={pk0}")
            genC = 0
            jobsC = 0
            bestUsC = us0
            corpusC = corpusIdx
            # 创世提交后同步内存账本 shaC: 不赋值则保持空串, 首轮
            # shaC != shaK 恒真, 新 store 必假 REJECT。
            shaC = strings.CloneStr(Fmt"{sha0}")
        # 候选: (incumbent+1)%3 档, 同语料; 基线 = 账本持久值
        # (best_us + product_sha, 重放由 verify/对拍锚保证), 不重烤。
        # 候选档选择: --jobs-tier 扫描覆盖优先 (全格扫描用, 准入合同
        # 不变——语义锚+严格更优照旧), 否则 (incumbent+1)%3 轮转。
        let candJobs = if jobsTierScan >= 0 && jobsTierScan <= 2: jobsTierScan else: (jobsC + 1) % 3
        var shaK: str
        var usK: int64 = 0
        var pkK: int64 = 0
        var okK: int32 = 0
        var freezeK: str
        cd.RsiCdBakePairedInto(Fmt"{root}", Fmt"{compilerPath}",
                               Fmt"{workDirC}", candJobs, corpusC, "cand",
                               shaK, usK, pkK, okK, freezeK)
        if okK != 1:
            echo("rsi_cdomain: FAIL candidate bake failed")
            return 1
        # C2 预算帽: 候选 peak 超过冻结基线 x 3/2 -> 归因四元组入 events。
        var budgetPeak: int64 = -1
        var budgetOk: int32 = 0
        cd.RsiCdBudgetLoadInto(Fmt"{storeDirC}", corpusC, budgetPeak, budgetOk)
        if budgetOk == 1 && pkK * 2 > budgetPeak * 3:
            let ratioText = strings.Int64ToStr(pkK * 100 / budgetPeak)
            let payloadB = strutil.Join(["event=cdomain_budget_breach",
                                         Fmt"gen={genC}",
                                         Fmt"corpus={corpusC}",
                                         Fmt"budget={budgetPeak}",
                                         Fmt"actual={pkK}",
                                         Fmt"ratio_pct={ratioText}",
                                         "dim=peak"], " ")
            let nextB = store.RsiStoreAppendLine(Fmt"{eventsPathC}",
                                                Fmt"{digestC}", payloadB)
            if len(nextB) == 64:
                digestC = strings.CloneStr(nextB)
            echo(Fmt"rsi_cdomain: BUDGET BREACH corpus={corpusC} budget={budgetPeak} actual={pkK} (x1.5 cap)")
            return 0
        if shaC != shaK:
            echo("rsi_cdomain: REJECT semantic fingerprint mismatch (correctness anchor)")
            let payloadM = strutil.Join(["event=cdomain_rejected",
                                         Fmt"gen={genC}",
                                         "reason=sha_mismatch"], " ")
            let nextM = store.RsiStoreAppendLine(Fmt"{eventsPathC}",
                                                Fmt"{digestC}", payloadM)
            if len(nextM) == 64:
                digestC = strings.CloneStr(nextM)
            return 0
        # 试验事实入图 (task_domain=2=compiler)。
        var factSeq: int32 = 0
        csg.RsiCsgFactCountInto(Fmt"{factsPathC}", factSeq)
        let tagK = Fmt"cd{factSeq}"
        let candFactK = csg.RsiCsgCandidateFact(Fmt"{tagK}",
                                                types.RsiCompilerDomain,
                                                candJobs, corpusC)
        if !csg.RsiCsgAppendFact(Fmt"{factsPathC}", candFactK):
            return 3
        let trialFactK = csg.RsiCsgTrialFact(Fmt"{tagK}",
                                             types.RsiCompilerDomain,
                                             candJobs, usK, "correct")
        if !csg.RsiCsgAppendFact(Fmt"{factsPathC}", trialFactK):
            return 3
        if usK < bestUsC:
            var rootPre: str
            var rootPreOk: int32 = 0
            csg.RsiCsgRootInto(Fmt"{factsPathC}", rootPre, rootPreOk)
            if rootPreOk != 1:
                return 3
            let vFact = cd.RsiCdVersionFact(genC + 1, candJobs, corpusC,
                                            usK, rootPre)
            if !csg.RsiCsgAppendFact(Fmt"{factsPathC}", vFact):
                return 3
            var rootPost: str
            var rootPostOk: int32 = 0
            csg.RsiCsgRootInto(Fmt"{factsPathC}", rootPost, rootPostOk)
            if rootPostOk != 1:
                return 3
            if !cd.RsiCdCommit(Fmt"{storeDirC}", genC + 1, candJobs, corpusC,
                               usK, Fmt"{shaK}", rootPost):
                return 3
            if !cd.RsiCdBudgetStore(Fmt"{storeDirC}", corpusC, pkK):
                return 3
            let payloadA = strutil.Join(["event=cdomain_accepted",
                                         Fmt"gen={genC + 1}",
                                         Fmt"jobs_tier={candJobs}",
                                         Fmt"corpus={corpusC}",
                                         Fmt"best_us={usK}",
                                         Fmt"parent_us={bestUsC}",
                                         Fmt"peak_bytes={pkK}",
                                         Fmt"sha={shaK}"], " ")
            let nextA = store.RsiStoreAppendLine(Fmt"{eventsPathC}",
                                                Fmt"{digestC}", payloadA)
            if len(nextA) == 64:
                digestC = strings.CloneStr(nextA)
            echo(Fmt"rsi_cdomain: accepted gen={genC + 1} jobs_tier={candJobs} total_us {bestUsC} -> {usK}")
        else:
            let payloadR = strutil.Join(["event=cdomain_rejected",
                                         Fmt"gen={genC}",
                                         Fmt"jobs_tier={candJobs}",
                                         Fmt"best_us={usK}",
                                         Fmt"parent_us={bestUsC}",
                                         Fmt"reason=no_strict_gain"], " ")
            let nextR = store.RsiStoreAppendLine(Fmt"{eventsPathC}",
                                                Fmt"{digestC}", payloadR)
            if len(nextR) == 64:
                digestC = strings.CloneStr(nextR)
            echo(Fmt"rsi_cdomain: rejected jobs_tier={candJobs} total_us={usK} parent={bestUsC}")
        return 0
    echo(Fmt"rsi: unknown stage={stage}")
    return 2
