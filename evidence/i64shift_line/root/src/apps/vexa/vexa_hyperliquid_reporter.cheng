import std/result
import std/strings
import cheng/codex/std/http
import cheng/oracle/oracle_types as oracle_types
import cheng/core/csg_asset/hyperliquid_source as hyper

type
    VexaHyperliquidReporterResult =
        statusCode: int32
        rawResponse: str
        sourceFact: hyper.HyperliquidMidSourceFact

fn vexaHlErr(message: str): Result[VexaHyperliquidReporterResult] =
    var out: Result[VexaHyperliquidReporterResult]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn vexaHlOk(value: VexaHyperliquidReporterResult): Result[VexaHyperliquidReporterResult] =
    var out: Result[VexaHyperliquidReporterResult]
    out.ok = true
    out.value = value
    return out

fn VexaHyperliquidFetchAllMidsSourceFact(coin: str,
                                         assetId: oracle_types.OracleAssetId,
                                         quoteId: oracle_types.OracleQuoteId,
                                         observedAtMs: int64,
                                         timeoutSeconds: int32): Result[VexaHyperliquidReporterResult] =
    if timeoutSeconds <= 0:
        return vexaHlErr("vexa hyperliquid reporter: timeout must be positive")
    let response = http.HttpRequestWithTimeout("POST",
                                               hyper.HyperliquidAllMidsSourceUri,
                                               hyper.HyperliquidAllMidsRequestBody,
                                               "[\"Content-Type: application/json\"]",
                                               timeoutSeconds)
    if !response.ok:
        if response.error.len > 0:
            return vexaHlErr(strings.ConcatStr("vexa hyperliquid reporter: ", response.error))
        return vexaHlErr("vexa hyperliquid reporter: request failed")
    if response.statusCode != 200:
        return vexaHlErr(strings.ConcatStr("vexa hyperliquid reporter: unexpected status ",
                                           strings.IntToStr(response.statusCode)))
    let sourceRes = hyper.HyperliquidAllMidsPriceFromResponse(response.body,
                                                              coin,
                                                              assetId,
                                                              quoteId,
                                                              observedAtMs)
    if !sourceRes.ok:
        return vexaHlErr(sourceRes.err.msg)
    var out: VexaHyperliquidReporterResult
    out.statusCode = response.statusCode
    out.rawResponse = response.body
    out.sourceFact = sourceRes.value
    return vexaHlOk(out)
