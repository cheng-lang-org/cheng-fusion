import std/result
import std/rawbytes
import std/strings as strings
import std/strutils as strutil
import cheng/core/csg_core/csgc
import cheng/core/csg_core/validator as csg
import cheng/core/csg_core/json_field as jfield
import cheng/core/csg_asset/oracle_asset as asset

type
    VexaAdmittedAsset =
        assetId: str
        subjectId: str
        assetKind: str
        sourceProfile: str
        trustLevel: str
        assetFactRoot: str
        closedLoopFactsRoot: str
        planRoot: str
        proofHash: str
        receiptHash: str
        recoveryRoot: str
        factCount: int32
        complete: bool

    VexaAdmissionRegistry =
        assets: VexaAdmittedAsset[]
        registryRoot: str

fn vexaAdmitErr(message: str): Result[VexaAdmittedAsset] =
    var out: Result[VexaAdmittedAsset]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn vexaAdmitOk(value: VexaAdmittedAsset): Result[VexaAdmittedAsset] =
    var out: Result[VexaAdmittedAsset]
    out.ok = true
    out.value = value
    return out

fn vexaRegistryErr(message: str): Result[VexaAdmittedAsset] =
    var out: Result[VexaAdmittedAsset]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn vexaFindFactLine(lines: str[], kind: str): str =
    for i in 0..<lines.len:
        let kindField = jfield.CsgCoreJsonKind(lines[i])
        if kindField.found && kindField.value == kind:
            return lines[i]
    return ""

fn vexaStringFieldOrEmpty(line: str, name: str): str =
    let field = jfield.CsgCoreJsonTopStringField(line, name)
    if field.found:
        return field.value
    return ""

fn vexaRequireString(line: str, name: str): Result[str] =
    let value = vexaStringFieldOrEmpty(line, name)
    if value.len <= 0:
        var out: Result[str]
        out.ok = false
        out.err.code = 1
        out.err.msg = "vexa discovery: missing required field"
        return out
    var out: Result[str]
    out.ok = true
    out.value = value
    return out

fn vexaStrLess(left: str, right: str): bool =
    if left == right:
        return false
    let sharedLen = len(left) < len(right) ? len(left) : len(right)
    for i in 0..<sharedLen:
        if left[i] == right[i]:
            continue
        return left[i] < right[i]
    return len(left) < len(right)

fn vexaSortStrings(values: var str[]) =
    if values.len <= 1:
        return
    for i in 1..<values.len:
        let value = values[i]
        var j = i
        while j > 0:
            if !vexaStrLess(value, values[j - 1]):
                break
            values[j] = values[j - 1]
            j = j - 1
        values[j] = value

fn VexaAdmittedAssetPreimage(value: VexaAdmittedAsset): str =
    return strutil.Join([
        "schema=csg_dialect::vexa::admission",
        "\nassetId=", value.assetId,
        "\nsubjectId=", value.subjectId,
        "\nassetKind=", value.assetKind,
        "\nsourceProfile=", value.sourceProfile,
        "\ntrustLevel=", value.trustLevel,
        "\nassetFactRoot=", value.assetFactRoot,
        "\nclosedLoopFactsRoot=", value.closedLoopFactsRoot,
        "\nplanRoot=", value.planRoot,
        "\nproofHash=", value.proofHash,
        "\nreceiptHash=", value.receiptHash,
        "\nrecoveryRoot=", value.recoveryRoot,
        "\nfactCount=", strings.IntToStr(value.factCount),
        "\ncomplete=", value.complete ? "true" : "false"
    ], "")

fn VexaAdmissionRegistryRoot(assets: VexaAdmittedAsset[]): str =
    var preimages: str[]
    for i in 0..<assets.len:
        add(preimages, VexaAdmittedAssetPreimage(assets[i]))
    vexaSortStrings(preimages)
    return asset.AssetSha256(strutil.Join(preimages, "\n---\n"))

fn VexaAdmissionRegistryInit(): VexaAdmissionRegistry =
    var out: VexaAdmissionRegistry
    out.registryRoot = VexaAdmissionRegistryRoot(out.assets)
    return out

fn VexaAdmissionRegistryCount(registry: VexaAdmissionRegistry): int32 =
    return registry.assets.len

fn VexaAdmissionRegistryFindByRecoveryRoot(registry: VexaAdmissionRegistry,
                                           recoveryRoot: str): int32 =
    for i in 0..<registry.assets.len:
        if registry.assets[i].recoveryRoot == recoveryRoot:
            return i
    return -1

fn VexaAdmissionRegistryFindByPlanRoot(registry: VexaAdmissionRegistry,
                                       planRoot: str): int32 =
    for i in 0..<registry.assets.len:
        if registry.assets[i].planRoot == planRoot:
            return i
    return -1

fn VexaAdmissionRegistryAdmit(registry: var VexaAdmissionRegistry,
                              admitted: VexaAdmittedAsset): Result[VexaAdmittedAsset] =
    if !admitted.complete:
        return vexaRegistryErr("vexa discovery: incomplete admitted asset rejected")
    if len(admitted.closedLoopFactsRoot) <= 0:
        return vexaRegistryErr("vexa discovery: missing closed-loop facts root")
    if len(admitted.recoveryRoot) <= 0:
        return vexaRegistryErr("vexa discovery: missing recovery root")
    if VexaAdmissionRegistryFindByRecoveryRoot(registry, admitted.recoveryRoot) >= 0:
        return vexaRegistryErr("vexa discovery: duplicate recovery root")
    if VexaAdmissionRegistryFindByPlanRoot(registry, admitted.planRoot) >= 0:
        return vexaRegistryErr("vexa discovery: duplicate plan root")
    add(registry.assets, admitted)
    registry.registryRoot = VexaAdmissionRegistryRoot(registry.assets)
    var out: Result[VexaAdmittedAsset]
    out.ok = true
    out.value = admitted
    return out

fn VexaAdmitClosedLoopAssetFromCsgc(bytes: rawbytes.Bytes): Result[VexaAdmittedAsset] =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return vexaAdmitErr(decoded.error)
    let validation =
        csg.CsgCoreProductionAdmitFactLines(
            decoded.lines)
    if !validation.valid || !validation.complete:
        return vexaAdmitErr("vexa discovery: CSGC facts are not valid complete strict facts")
    if validation.factsRoot.len <= 0:
        return vexaAdmitErr("vexa discovery: admitted CSGC facts root is missing")

    let assetLine = vexaFindFactLine(decoded.lines, "csg_dialect::vexa::asset")
    if assetLine.len <= 0:
        return vexaAdmitErr("vexa discovery: missing Vexa asset fact")
    let planLine = vexaFindFactLine(decoded.lines, "csg_dialect::vexa::deterministic_plan")
    if planLine.len <= 0:
        return vexaAdmitErr("vexa discovery: missing Vexa deterministic plan fact")
    let receiptLine = vexaFindFactLine(decoded.lines, "csg_dialect::vexa::execution_receipt")
    if receiptLine.len <= 0:
        return vexaAdmitErr("vexa discovery: missing Vexa execution receipt fact")
    let cellLine = vexaFindFactLine(decoded.lines, "csg_dialect::vexa::recoverable_cell")
    if cellLine.len <= 0:
        return vexaAdmitErr("vexa discovery: missing Vexa recoverable cell fact")

    let assetId = vexaRequireString(assetLine, "id")
    if !assetId.ok:
        return vexaAdmitErr(assetId.err.msg)
    let subjectId = vexaRequireString(assetLine, "subjectId")
    if !subjectId.ok:
        return vexaAdmitErr(subjectId.err.msg)
    let assetKind = vexaRequireString(assetLine, "assetKind")
    if !assetKind.ok:
        return vexaAdmitErr(assetKind.err.msg)
    let sourceProfile = vexaRequireString(assetLine, "sourceProfile")
    if !sourceProfile.ok:
        return vexaAdmitErr(sourceProfile.err.msg)
    let trustLevel = vexaRequireString(assetLine, "trustLevel")
    if !trustLevel.ok:
        return vexaAdmitErr(trustLevel.err.msg)
    let assetFactRoot = vexaRequireString(planLine, "assetFactRoot")
    if !assetFactRoot.ok:
        return vexaAdmitErr(assetFactRoot.err.msg)
    let planRoot = vexaRequireString(planLine, "planRoot")
    if !planRoot.ok:
        return vexaAdmitErr(planRoot.err.msg)
    let proofHash = vexaRequireString(planLine, "proofHash")
    if !proofHash.ok:
        return vexaAdmitErr(proofHash.err.msg)
    let receiptHash = vexaRequireString(receiptLine, "receiptHash")
    if !receiptHash.ok:
        return vexaAdmitErr(receiptHash.err.msg)
    let receiptPlanRoot = vexaRequireString(receiptLine, "planRoot")
    if !receiptPlanRoot.ok:
        return vexaAdmitErr(receiptPlanRoot.err.msg)
    if receiptPlanRoot.value != planRoot.value:
        return vexaAdmitErr("vexa discovery: execution receipt plan root mismatch")
    let cellPlanRoot = vexaRequireString(cellLine, "planRoot")
    if !cellPlanRoot.ok:
        return vexaAdmitErr(cellPlanRoot.err.msg)
    if cellPlanRoot.value != planRoot.value:
        return vexaAdmitErr("vexa discovery: recoverable cell plan root mismatch")
    let cellReceiptHash = vexaRequireString(cellLine, "receiptHash")
    if !cellReceiptHash.ok:
        return vexaAdmitErr(cellReceiptHash.err.msg)
    if cellReceiptHash.value != receiptHash.value:
        return vexaAdmitErr("vexa discovery: recoverable cell receipt hash mismatch")
    let recoveryRoot = vexaRequireString(cellLine, "recoveryRoot")
    if !recoveryRoot.ok:
        return vexaAdmitErr(recoveryRoot.err.msg)

    var out: VexaAdmittedAsset
    out.assetId = assetId.value
    out.subjectId = subjectId.value
    out.assetKind = assetKind.value
    out.sourceProfile = sourceProfile.value
    out.trustLevel = trustLevel.value
    out.assetFactRoot = assetFactRoot.value
    out.closedLoopFactsRoot = validation.factsRoot
    out.planRoot = planRoot.value
    out.proofHash = proofHash.value
    out.receiptHash = receiptHash.value
    out.recoveryRoot = recoveryRoot.value
    out.factCount = decoded.factCount
    out.complete = true
    return vexaAdmitOk(out)

fn VexaAdmissionRegistryAdmitCsgc(registry: var VexaAdmissionRegistry,
                                  bytes: rawbytes.Bytes): Result[VexaAdmittedAsset] =
    let admittedRes = VexaAdmitClosedLoopAssetFromCsgc(bytes)
    if !admittedRes.ok:
        return vexaRegistryErr(admittedRes.err.msg)
    return VexaAdmissionRegistryAdmit(registry, admittedRes.value)
