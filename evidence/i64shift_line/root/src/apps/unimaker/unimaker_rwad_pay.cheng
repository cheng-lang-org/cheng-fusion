# unimaker_rwad_pay.cheng - UniMaker-side payment intent adapter.
#
# Thin bridge from a UniMaker product payment intent to the RWAD serial
# state machine. The kernel keeps its note/nullifier (UTXO) model, so the
# product wallet tracks its own live note ids; the adapter translates
# intent -> transfer, applies it, and reports a receipt with post-balances
# for the product UI. It never mints: top-ups arrive via bridge/oracle
# intents, not here.

import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_serial_state_machine as serial

const
    UrpCodeOk: int32 = 0
    UrpCodeBadAmount: int32 = 1
    UrpCodeApply: int32 = 2

type
    UnimakerPayIntent =
        payerNoteId: int64
        payerCid: layout.FixedBytes32
        payeeCid: layout.FixedBytes32
        amount: int64

    UnimakerPayReceipt =
        code: int32
        accepted: bool
        txHeight: int64
        payerBalanceAfter: int64
        payeeBalanceAfter: int64

fn UnimakerPayApply(m: var serial.RwadStateMachine,
                    intent: UnimakerPayIntent,
                    height: int64): UnimakerPayReceipt =
    var out: UnimakerPayReceipt
    out.code = UrpCodeBadAmount
    if intent.amount <= 0:
        return out
    out.code = UrpCodeApply
    let xfer = serial.RwadTransferTxMake(intent.payerNoteId,
                                         intent.payerCid,
                                         intent.payeeCid,
                                         Int64(1),
                                         intent.amount)
    let res = serial.RwadStateMachineApplyTransfer(m, height, xfer)
    if !res.accepted:
        return out
    out.code = UrpCodeOk
    out.accepted = true
    out.txHeight = height
    out.payerBalanceAfter = serial.RwadOwnerBalance(m, intent.payerCid)
    out.payeeBalanceAfter = serial.RwadOwnerBalance(m, intent.payeeCid)
    return out
