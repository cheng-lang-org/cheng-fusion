import std/result
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/csg_asset/oracle_asset as asset
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/validator as csg
import cheng/core/csg_core/csgc

const
    InnovationTargetDocument: int32 = 1
    InnovationTargetClaim: int32 = 2
    InnovationTargetClaimElement: int32 = 3
    InnovationTargetPaperContribution: int32 = 4
    InnovationTargetProductEvidence: int32 = 5

    InnovationDocumentPatent: int32 = 1
    InnovationDocumentPaper: int32 = 2
    InnovationEmbeddingMaxDimension: int32 = 4096
    InnovationEmbeddingComponentLimit: int32 = 32767
    InnovationSimilarityScale: int64 = 1000000

type
    InnovationDocumentInput =
        id: str
        documentKind: int32
        externalId: str
        titleHash: str
        sourceCid: str
        sourceUri: str
        publicationDate: int64
        priorityDate: int64
        jurisdiction: str
        language: str
        licenseHash: str
        semanticStatus: str

    InnovationClaimInput =
        id: str
        documentIndex: int32
        claimNumber: int32
        parentClaimIndex: int32 = -1
        independent: bool
        claimTextHash: str
        semanticStatus: str

    InnovationClaimElementInput =
        id: str
        claimIndex: int32
        ordinal: int32
        required: bool
        elementTextHash: str
        technicalEffectHash: str
        semanticStatus: str

    InnovationPaperContributionInput =
        id: str
        documentIndex: int32
        ordinal: int32
        contributionHash: str
        methodHash: str
        evidenceHash: str
        semanticStatus: str

    InnovationProductEvidenceInput =
        id: str
        productId: str
        ordinal: int32
        evidenceHash: str
        sourceCid: str
        observedAtMs: int64
        semanticStatus: str

    InnovationEmbeddingInput =
        id: str
        targetKind: int32
        targetIndex: int32
        modelCid: str
        tokenizerCid: str
        toolCid: str
        normalizationScale: int32
        quantization: str
        values: int32[]

    InnovationEmbeddingQuery =
        queryFactCid: str
        modelCid: str
        tokenizerCid: str
        toolCid: str
        normalizationScale: int32
        quantization: str
        values: int32[]

    InnovationCsgStore =
        sealed: bool

        documentIds: str[]
        documentKinds: int32[]
        documentExternalIds: str[]
        documentTitleHashes: str[]
        documentSourceCids: str[]
        documentSourceUris: str[]
        documentPublicationDates: int64[]
        documentPriorityDates: int64[]
        documentJurisdictions: str[]
        documentLanguages: str[]
        documentLicenseHashes: str[]
        documentSemanticStatuses: str[]

        claimIds: str[]
        claimDocumentIndexes: int32[]
        claimNumbers: int32[]
        claimParentIndexes: int32[]
        claimIndependent: bool[]
        claimTextHashes: str[]
        claimSemanticStatuses: str[]

        elementIds: str[]
        elementClaimIndexes: int32[]
        elementOrdinals: int32[]
        elementRequired: bool[]
        elementTextHashes: str[]
        elementTechnicalEffectHashes: str[]
        elementSemanticStatuses: str[]

        contributionIds: str[]
        contributionDocumentIndexes: int32[]
        contributionOrdinals: int32[]
        contributionHashes: str[]
        contributionMethodHashes: str[]
        contributionEvidenceHashes: str[]
        contributionSemanticStatuses: str[]

        evidenceIds: str[]
        evidenceProductIds: str[]
        evidenceOrdinals: int32[]
        evidenceHashes: str[]
        evidenceSourceCids: str[]
        evidenceObservedAtMs: int64[]
        evidenceSemanticStatuses: str[]
        evidenceProductOrder: int32[]

        embeddingIds: str[]
        embeddingTargetKinds: int32[]
        embeddingTargetIndexes: int32[]
        embeddingModelCids: str[]
        embeddingTokenizerCids: str[]
        embeddingToolCids: str[]
        embeddingVectorCids: str[]
        embeddingNormalizationScales: int32[]
        embeddingQuantizations: str[]
        embeddingValueStarts: int32[]
        embeddingValueCounts: int32[]
        embeddingValues: int32[]
        embeddingIndexKeys: str[]
        embeddingOrder: int32[]

    InnovationSearchResult =
        targetKinds: int32[]
        targetIndexes: int32[]
        embeddingIndexes: int32[]
        scoreMicros: int32[]
        queryReceiptHash: str

    InnovationSearchOutcome =
        ok: bool
        error: str
        result: InnovationSearchResult

    InnovationClaimChart =
        claimIndex: int32 = -1
        productId: str
        claimElementIndexes: int32[]
        evidenceIndexes: int32[]
        scoreMicros: int32[]
        matched: bool[]
        requiredCount: int32
        matchedCount: int32
        allRequiredCandidate: bool
        candidateOnly: bool = true
        thresholdMicros: int32
        corpusFactsRoot: str
        modelCid: str
        tokenizerCid: str
        toolCid: str
        dimension: int32
        normalizationScale: int32
        quantization: str
        alignmentRoot: str
        receiptHash: str

    InnovationClaimChartOutcome =
        ok: bool
        error: str
        chart: InnovationClaimChart

fn innovationErrInt(message: str): Result[int32] =
    var out: Result[int32]
    out.err.code = 1
    out.err.msg = message
    return out

fn innovationOkInt(value: int32): Result[int32] =
    var out: Result[int32]
    out.ok = true
    out.value = value
    return out

fn innovationErrBool(message: str): Result[bool] =
    var out: Result[bool]
    out.err.code = 1
    out.err.msg = message
    return out

fn innovationOkBool(): Result[bool] =
    var out: Result[bool]
    out.ok = true
    out.value = true
    return out

fn innovationSearchFail(message: str): InnovationSearchOutcome =
    var out: InnovationSearchOutcome
    out.error = message
    return out

fn innovationChartFail(message: str): InnovationClaimChartOutcome =
    var out: InnovationClaimChartOutcome
    out.error = message
    return out

@borrows
fn innovationNonEmpty(value: str): bool =
    return value.len > 0

fn innovationHexDigit(ch: char): bool =
    return (ch >= '0' && ch <= '9') ||
           (ch >= 'a' && ch <= 'f')

@borrows
fn InnovationSha256CidValid(value: str): bool =
    if value.len != 71 || !strings.HasPrefix(value, "sha256:"):
        return false
    for i in 7..<value.len:
        if !innovationHexDigit(value[i]):
            return false
    return true

@borrows
fn innovationInputCommonValid(id: str, semanticStatus: str): bool =
    return innovationNonEmpty(id) && innovationNonEmpty(semanticStatus)

@borrows
fn innovationStoreMutable(store: InnovationCsgStore): bool =
    return !store.sealed

@borrows
fn InnovationAddDocument(store: var InnovationCsgStore,
                         input: InnovationDocumentInput): Result[int32] =
    if !innovationStoreMutable(store):
        return innovationErrInt("innovation csg: store is sealed")
    if !innovationInputCommonValid(input.id, input.semanticStatus) ||
       !innovationNonEmpty(input.externalId) ||
       !innovationNonEmpty(input.sourceUri) ||
       !innovationNonEmpty(input.jurisdiction) ||
       !innovationNonEmpty(input.language) ||
       !InnovationSha256CidValid(input.titleHash) ||
       !InnovationSha256CidValid(input.sourceCid) ||
       !InnovationSha256CidValid(input.licenseHash):
        return innovationErrInt("innovation csg: invalid document identity")
    if input.documentKind != InnovationDocumentPatent &&
       input.documentKind != InnovationDocumentPaper:
        return innovationErrInt("innovation csg: invalid document kind")
    if input.publicationDate < int64(0) || input.priorityDate < int64(0):
        return innovationErrInt("innovation csg: invalid document date")
    let row = store.documentIds.len
    add(store.documentIds, strings.CloneStr(input.id))
    add(store.documentKinds, input.documentKind)
    add(store.documentExternalIds, strings.CloneStr(input.externalId))
    add(store.documentTitleHashes, strings.CloneStr(input.titleHash))
    add(store.documentSourceCids, strings.CloneStr(input.sourceCid))
    add(store.documentSourceUris, strings.CloneStr(input.sourceUri))
    add(store.documentPublicationDates, input.publicationDate)
    add(store.documentPriorityDates, input.priorityDate)
    add(store.documentJurisdictions, strings.CloneStr(input.jurisdiction))
    add(store.documentLanguages, strings.CloneStr(input.language))
    add(store.documentLicenseHashes, strings.CloneStr(input.licenseHash))
    add(store.documentSemanticStatuses, strings.CloneStr(input.semanticStatus))
    return innovationOkInt(row)

@borrows
fn InnovationAddClaim(store: var InnovationCsgStore,
                      input: InnovationClaimInput): Result[int32] =
    if !innovationStoreMutable(store):
        return innovationErrInt("innovation csg: store is sealed")
    if !innovationInputCommonValid(input.id, input.semanticStatus) ||
       !InnovationSha256CidValid(input.claimTextHash) ||
       input.documentIndex < 0 ||
       input.documentIndex >= store.documentIds.len ||
       store.documentKinds[input.documentIndex] != InnovationDocumentPatent ||
       input.parentClaimIndex < -1 ||
       input.claimNumber <= 0:
        return innovationErrInt("innovation csg: invalid claim")
    if input.parentClaimIndex >= store.claimIds.len:
        return innovationErrInt("innovation csg: claim parent is not an existing row")
    if input.independent && input.parentClaimIndex >= 0:
        return innovationErrInt("innovation csg: independent claim cannot have a parent")
    if !input.independent && input.parentClaimIndex < 0:
        return innovationErrInt("innovation csg: dependent claim requires a parent")
    if input.parentClaimIndex >= 0 &&
       store.claimDocumentIndexes[input.parentClaimIndex] != input.documentIndex:
        return innovationErrInt("innovation csg: claim parent document mismatch")
    let row = store.claimIds.len
    add(store.claimIds, strings.CloneStr(input.id))
    add(store.claimDocumentIndexes, input.documentIndex)
    add(store.claimNumbers, input.claimNumber)
    add(store.claimParentIndexes, input.parentClaimIndex)
    add(store.claimIndependent, input.independent)
    add(store.claimTextHashes, strings.CloneStr(input.claimTextHash))
    add(store.claimSemanticStatuses, strings.CloneStr(input.semanticStatus))
    return innovationOkInt(row)

@borrows
fn InnovationAddClaimElement(store: var InnovationCsgStore,
                             input: InnovationClaimElementInput): Result[int32] =
    if !innovationStoreMutable(store):
        return innovationErrInt("innovation csg: store is sealed")
    if !innovationInputCommonValid(input.id, input.semanticStatus) ||
       input.claimIndex < 0 || input.claimIndex >= store.claimIds.len ||
       input.ordinal < 0 ||
       !InnovationSha256CidValid(input.elementTextHash) ||
       !InnovationSha256CidValid(input.technicalEffectHash):
        return innovationErrInt("innovation csg: invalid claim element")
    let row = store.elementIds.len
    add(store.elementIds, strings.CloneStr(input.id))
    add(store.elementClaimIndexes, input.claimIndex)
    add(store.elementOrdinals, input.ordinal)
    add(store.elementRequired, input.required)
    add(store.elementTextHashes, strings.CloneStr(input.elementTextHash))
    add(store.elementTechnicalEffectHashes,
        strings.CloneStr(input.technicalEffectHash))
    add(store.elementSemanticStatuses, strings.CloneStr(input.semanticStatus))
    return innovationOkInt(row)

@borrows
fn InnovationAddPaperContribution(
        store: var InnovationCsgStore,
        input: InnovationPaperContributionInput): Result[int32] =
    if !innovationStoreMutable(store):
        return innovationErrInt("innovation csg: store is sealed")
    if !innovationInputCommonValid(input.id, input.semanticStatus) ||
       input.documentIndex < 0 ||
       input.documentIndex >= store.documentIds.len ||
       store.documentKinds[input.documentIndex] != InnovationDocumentPaper ||
       input.ordinal < 0 ||
       !InnovationSha256CidValid(input.contributionHash) ||
       !InnovationSha256CidValid(input.methodHash) ||
       !InnovationSha256CidValid(input.evidenceHash):
        return innovationErrInt("innovation csg: invalid paper contribution")
    let row = store.contributionIds.len
    add(store.contributionIds, strings.CloneStr(input.id))
    add(store.contributionDocumentIndexes, input.documentIndex)
    add(store.contributionOrdinals, input.ordinal)
    add(store.contributionHashes, strings.CloneStr(input.contributionHash))
    add(store.contributionMethodHashes, strings.CloneStr(input.methodHash))
    add(store.contributionEvidenceHashes, strings.CloneStr(input.evidenceHash))
    add(store.contributionSemanticStatuses,
        strings.CloneStr(input.semanticStatus))
    return innovationOkInt(row)

@borrows
fn InnovationAddProductEvidence(
        store: var InnovationCsgStore,
        input: InnovationProductEvidenceInput): Result[int32] =
    if !innovationStoreMutable(store):
        return innovationErrInt("innovation csg: store is sealed")
    if !innovationInputCommonValid(input.id, input.semanticStatus) ||
       !innovationNonEmpty(input.productId) || input.ordinal < 0 ||
       input.observedAtMs < int64(0) ||
       !InnovationSha256CidValid(input.evidenceHash) ||
       !InnovationSha256CidValid(input.sourceCid):
        return innovationErrInt("innovation csg: invalid product evidence")
    let row = store.evidenceIds.len
    add(store.evidenceIds, strings.CloneStr(input.id))
    add(store.evidenceProductIds, strings.CloneStr(input.productId))
    add(store.evidenceOrdinals, input.ordinal)
    add(store.evidenceHashes, strings.CloneStr(input.evidenceHash))
    add(store.evidenceSourceCids, strings.CloneStr(input.sourceCid))
    add(store.evidenceObservedAtMs, input.observedAtMs)
    add(store.evidenceSemanticStatuses, strings.CloneStr(input.semanticStatus))
    return innovationOkInt(row)

@borrows
fn innovationTargetRowValid(store: InnovationCsgStore,
                            targetKind: int32,
                            targetIndex: int32): bool =
    if targetIndex < 0:
        return false
    if targetKind == InnovationTargetDocument:
        return targetIndex < store.documentIds.len
    if targetKind == InnovationTargetClaim:
        return targetIndex < store.claimIds.len
    if targetKind == InnovationTargetClaimElement:
        return targetIndex < store.elementIds.len
    if targetKind == InnovationTargetPaperContribution:
        return targetIndex < store.contributionIds.len
    if targetKind == InnovationTargetProductEvidence:
        return targetIndex < store.evidenceIds.len
    return false

@borrows
fn innovationEmbeddingValuesValid(values: int32[]): bool =
    if values.len <= 0 || values.len > InnovationEmbeddingMaxDimension:
        return false
    var nonZero = false
    for i in 0..<values.len:
        if values[i] < -InnovationEmbeddingComponentLimit ||
           values[i] > InnovationEmbeddingComponentLimit:
            return false
        if values[i] != 0:
            nonZero = true
    return nonZero

@borrows
fn innovationVectorCid(input: InnovationEmbeddingInput): str =
    var parts: str[]
    add(parts, "schema=unimaker.innovation.embedding.vector.v1")
    add(parts, strings.CloneStr(input.modelCid))
    add(parts, strings.CloneStr(input.tokenizerCid))
    add(parts, strings.CloneStr(input.toolCid))
    add(parts, strings.IntToStr(input.normalizationScale))
    add(parts, strings.CloneStr(input.quantization))
    add(parts, strings.IntToStr(input.values.len))
    for i in 0..<input.values.len:
        add(parts, strings.IntToStr(input.values[i]))
    return asset.AssetSha256(strutil.Join(parts, "\n"))

@borrows
fn innovationEmbeddingIndexKey(targetKind: int32,
                               targetIndex: int32,
                               modelCid: str,
                               tokenizerCid: str,
                               toolCid: str,
                               normalizationScale: int32,
                               quantization: str,
                               dimension: int32): str =
    var parts: str[]
    add(parts, strings.IntToStr(targetKind))
    add(parts, strings.IntToStr(targetIndex))
    add(parts, strings.CloneStr(modelCid))
    add(parts, strings.CloneStr(tokenizerCid))
    add(parts, strings.CloneStr(toolCid))
    add(parts, strings.IntToStr(normalizationScale))
    add(parts, strings.CloneStr(quantization))
    add(parts, strings.IntToStr(dimension))
    return strutil.Join(parts, "\x1f")

@borrows
fn InnovationAddEmbedding(store: var InnovationCsgStore,
                          input: InnovationEmbeddingInput): Result[int32] =
    if !innovationStoreMutable(store):
        return innovationErrInt("innovation csg: store is sealed")
    if !innovationNonEmpty(input.id) ||
       !innovationTargetRowValid(store, input.targetKind, input.targetIndex) ||
       !InnovationSha256CidValid(input.modelCid) ||
       !InnovationSha256CidValid(input.tokenizerCid) ||
       !InnovationSha256CidValid(input.toolCid) ||
       input.normalizationScale <= 0 ||
       !innovationNonEmpty(input.quantization) ||
       !innovationEmbeddingValuesValid(input.values):
        return innovationErrInt("innovation csg: invalid embedding receipt")
    let row = store.embeddingIds.len
    let start = store.embeddingValues.len
    add(store.embeddingIds, strings.CloneStr(input.id))
    add(store.embeddingTargetKinds, input.targetKind)
    add(store.embeddingTargetIndexes, input.targetIndex)
    add(store.embeddingModelCids, strings.CloneStr(input.modelCid))
    add(store.embeddingTokenizerCids, strings.CloneStr(input.tokenizerCid))
    add(store.embeddingToolCids, strings.CloneStr(input.toolCid))
    add(store.embeddingVectorCids, innovationVectorCid(input))
    add(store.embeddingNormalizationScales, input.normalizationScale)
    add(store.embeddingQuantizations, strings.CloneStr(input.quantization))
    add(store.embeddingValueStarts, start)
    add(store.embeddingValueCounts, input.values.len)
    for i in 0..<input.values.len:
        add(store.embeddingValues, input.values[i])
    return innovationOkInt(row)

@borrows
fn innovationStrLess(left: str, right: str): bool =
    if left == right:
        return false
    let shared = left.len < right.len ? left.len : right.len
    for i in 0..<shared:
        if left[i] == right[i]:
            continue
        return (int32(left[i]) & 255) < (int32(right[i]) & 255)
    return left.len < right.len

@borrows
fn innovationSortedOrder(values: str[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, values.len)
    setLen(scratch, values.len)
    for i in 0..<values.len:
        order[i] = i
    var width: int32 = 1
    while width < values.len:
        var base: int32
        while base < values.len:
            var middle = base + width
            if middle > values.len:
                middle = values.len
            var finish = middle + width
            if finish > values.len:
                finish = values.len
            var left = base
            var right = middle
            var out = base
            while left < middle && right < finish:
                if innovationStrLess(values[order[right]],
                                     values[order[left]]):
                    scratch[out] = order[right]
                    right = right + 1
                else:
                    scratch[out] = order[left]
                    left = left + 1
                out = out + 1
            while left < middle:
                scratch[out] = order[left]
                left = left + 1
                out = out + 1
            while right < finish:
                scratch[out] = order[right]
                right = right + 1
                out = out + 1
            base = finish
        for i in 0..<values.len:
            order[i] = scratch[i]
        if width > values.len - width:
            width = values.len
        else:
            width = width + width
    return order

@borrows
fn innovationUniqueIds(store: InnovationCsgStore): Result[bool] =
    var ids: str[]
    for i in 0..<store.documentIds.len:
        add(ids, strings.CloneStr(store.documentIds[i]))
    for i in 0..<store.claimIds.len:
        add(ids, strings.CloneStr(store.claimIds[i]))
    for i in 0..<store.elementIds.len:
        add(ids, strings.CloneStr(store.elementIds[i]))
    for i in 0..<store.contributionIds.len:
        add(ids, strings.CloneStr(store.contributionIds[i]))
    for i in 0..<store.evidenceIds.len:
        add(ids, strings.CloneStr(store.evidenceIds[i]))
    for i in 0..<store.embeddingIds.len:
        add(ids, strings.CloneStr(store.embeddingIds[i]))
    let order = innovationSortedOrder(ids)
    for i in 1..<order.len:
        if ids[order[i - 1]] == ids[order[i]]:
            return innovationErrBool("innovation csg: duplicate fact id")
    return innovationOkBool()

@borrows
fn innovationColumnsValid(store: InnovationCsgStore): bool =
    let documents = store.documentIds.len
    let claims = store.claimIds.len
    let elements = store.elementIds.len
    let contributions = store.contributionIds.len
    let evidence = store.evidenceIds.len
    let embeddings = store.embeddingIds.len
    return store.documentKinds.len == documents &&
           store.documentExternalIds.len == documents &&
           store.documentTitleHashes.len == documents &&
           store.documentSourceCids.len == documents &&
           store.documentSourceUris.len == documents &&
           store.documentPublicationDates.len == documents &&
           store.documentPriorityDates.len == documents &&
           store.documentJurisdictions.len == documents &&
           store.documentLanguages.len == documents &&
           store.documentLicenseHashes.len == documents &&
           store.documentSemanticStatuses.len == documents &&
           store.claimDocumentIndexes.len == claims &&
           store.claimNumbers.len == claims &&
           store.claimParentIndexes.len == claims &&
           store.claimIndependent.len == claims &&
           store.claimTextHashes.len == claims &&
           store.claimSemanticStatuses.len == claims &&
           store.elementClaimIndexes.len == elements &&
           store.elementOrdinals.len == elements &&
           store.elementRequired.len == elements &&
           store.elementTextHashes.len == elements &&
           store.elementTechnicalEffectHashes.len == elements &&
           store.elementSemanticStatuses.len == elements &&
           store.contributionDocumentIndexes.len == contributions &&
           store.contributionOrdinals.len == contributions &&
           store.contributionHashes.len == contributions &&
           store.contributionMethodHashes.len == contributions &&
           store.contributionEvidenceHashes.len == contributions &&
           store.contributionSemanticStatuses.len == contributions &&
           store.evidenceProductIds.len == evidence &&
           store.evidenceOrdinals.len == evidence &&
           store.evidenceHashes.len == evidence &&
           store.evidenceSourceCids.len == evidence &&
           store.evidenceObservedAtMs.len == evidence &&
           store.evidenceSemanticStatuses.len == evidence &&
           store.embeddingTargetKinds.len == embeddings &&
           store.embeddingTargetIndexes.len == embeddings &&
           store.embeddingModelCids.len == embeddings &&
           store.embeddingTokenizerCids.len == embeddings &&
           store.embeddingToolCids.len == embeddings &&
           store.embeddingVectorCids.len == embeddings &&
           store.embeddingNormalizationScales.len == embeddings &&
           store.embeddingQuantizations.len == embeddings &&
           store.embeddingValueStarts.len == embeddings &&
           store.embeddingValueCounts.len == embeddings

@borrows
fn innovationEvidenceProductOrder(store: InnovationCsgStore): int32[] =
    var keys: str[]
    for i in 0..<store.evidenceIds.len:
        var parts: str[]
        add(parts, strings.CloneStr(store.evidenceProductIds[i]))
        add(parts, strings.IntToStr(store.evidenceOrdinals[i]))
        add(parts, strings.IntToStr(i))
        add(keys, strutil.Join(parts, "\x1f"))
    let rough = innovationSortedOrder(keys)
    var order: int32[]
    for i in 0..<rough.len:
        add(order, rough[i])
    return order

@borrows
fn innovationStoredEmbeddingValuesValid(store: InnovationCsgStore,
                                        row: int32): bool =
    let start = store.embeddingValueStarts[row]
    let count = store.embeddingValueCounts[row]
    if start < 0 || count <= 0 ||
       start > store.embeddingValues.len ||
       count > store.embeddingValues.len - start ||
       count > InnovationEmbeddingMaxDimension:
        return false
    var nonZero = false
    for valueIndex in 0..<count:
        let value = store.embeddingValues[start + valueIndex]
        if value < -InnovationEmbeddingComponentLimit ||
           value > InnovationEmbeddingComponentLimit:
            return false
        if value != 0:
            nonZero = true
    return nonZero

@borrows
fn innovationStoredVectorCid(store: InnovationCsgStore,
                             row: int32): str =
    var parts: str[]
    add(parts, "schema=unimaker.innovation.embedding.vector.v1")
    add(parts, strings.CloneStr(store.embeddingModelCids[row]))
    add(parts, strings.CloneStr(store.embeddingTokenizerCids[row]))
    add(parts, strings.CloneStr(store.embeddingToolCids[row]))
    add(parts, strings.IntToStr(store.embeddingNormalizationScales[row]))
    add(parts, strings.CloneStr(store.embeddingQuantizations[row]))
    let start = store.embeddingValueStarts[row]
    let count = store.embeddingValueCounts[row]
    add(parts, strings.IntToStr(count))
    for valueIndex in 0..<count:
        add(parts, strings.IntToStr(
            store.embeddingValues[start + valueIndex]))
    return asset.AssetSha256(strutil.Join(parts, "\n"))

@borrows
fn innovationKeysUnique(keys: str[]): bool =
    let order = innovationSortedOrder(keys)
    for i in 1..<order.len:
        if keys[order[i - 1]] == keys[order[i]]:
            return false
    return true

@borrows
fn innovationRelationKeysUnique(store: InnovationCsgStore): bool =
    var keys: str[]
    for i in 0..<store.documentIds.len:
        add(keys, innovationCat(
            "document:",
            innovationCat(
                strings.IntToStr(store.documentKinds[i]),
                innovationCat(
                    ":", innovationCat(
                        strings.IntToStr(store.documentJurisdictions[i].len),
                        innovationCat(
                            ":", innovationCat(
                                store.documentJurisdictions[i],
                                innovationCat(
                                    ":", store.documentExternalIds[i]))))))))
    for i in 0..<store.claimIds.len:
        add(keys, innovationCat(
            "claim:", innovationCat(
                strings.IntToStr(store.claimDocumentIndexes[i]),
                innovationCat(
                    ":", strings.IntToStr(store.claimNumbers[i])))))
    for i in 0..<store.elementIds.len:
        add(keys, innovationCat(
            "element:", innovationCat(
                strings.IntToStr(store.elementClaimIndexes[i]),
                innovationCat(
                    ":", strings.IntToStr(store.elementOrdinals[i])))))
    for i in 0..<store.contributionIds.len:
        add(keys, innovationCat(
            "contribution:", innovationCat(
                strings.IntToStr(store.contributionDocumentIndexes[i]),
                innovationCat(
                    ":", strings.IntToStr(store.contributionOrdinals[i])))))
    for i in 0..<store.evidenceIds.len:
        add(keys, innovationCat(
            "evidence:", innovationCat(
                strings.IntToStr(store.evidenceProductIds[i].len),
                innovationCat(
                    ":", innovationCat(
                        store.evidenceProductIds[i],
                        innovationCat(
                            ":", strings.IntToStr(
                                store.evidenceOrdinals[i])))))))
    return innovationKeysUnique(keys)

@borrows
fn InnovationSeal(store: var InnovationCsgStore): Result[bool] =
    if store.sealed:
        return innovationErrBool("innovation csg: store already sealed")
    if !innovationColumnsValid(store):
        return innovationErrBool("innovation csg: SoA column drift")
    let unique = innovationUniqueIds(store)
    if !unique.ok:
        return innovationErrBool(unique.err.msg)
    if !innovationRelationKeysUnique(store):
        return innovationErrBool("innovation csg: duplicate relation identity")
    for i in 0..<store.documentIds.len:
        if !innovationInputCommonValid(
               store.documentIds[i], store.documentSemanticStatuses[i]) ||
           (store.documentKinds[i] != InnovationDocumentPatent &&
            store.documentKinds[i] != InnovationDocumentPaper) ||
           !innovationNonEmpty(store.documentExternalIds[i]) ||
           !innovationNonEmpty(store.documentSourceUris[i]) ||
           !innovationNonEmpty(store.documentJurisdictions[i]) ||
           !innovationNonEmpty(store.documentLanguages[i]) ||
           store.documentPublicationDates[i] < int64(0) ||
           store.documentPriorityDates[i] < int64(0) ||
           !InnovationSha256CidValid(store.documentTitleHashes[i]) ||
           !InnovationSha256CidValid(store.documentSourceCids[i]) ||
           !InnovationSha256CidValid(store.documentLicenseHashes[i]):
            return innovationErrBool("innovation csg: invalid document row")
    for i in 0..<store.claimIds.len:
        let parent = store.claimParentIndexes[i]
        let documentIndex = store.claimDocumentIndexes[i]
        if !innovationInputCommonValid(
               store.claimIds[i], store.claimSemanticStatuses[i]) ||
           documentIndex < 0 || documentIndex >= store.documentIds.len ||
           store.documentKinds[documentIndex] != InnovationDocumentPatent ||
           store.claimNumbers[i] <= 0 || parent >= i || parent < -1 ||
           (store.claimIndependent[i] && parent >= 0) ||
           (!store.claimIndependent[i] && parent < 0) ||
           (parent >= 0 &&
            store.claimDocumentIndexes[parent] != documentIndex) ||
           !InnovationSha256CidValid(store.claimTextHashes[i]):
            return innovationErrBool("innovation csg: invalid claim row")
    for i in 0..<store.elementIds.len:
        if !innovationInputCommonValid(
               store.elementIds[i], store.elementSemanticStatuses[i]) ||
           store.elementClaimIndexes[i] < 0 ||
           store.elementClaimIndexes[i] >= store.claimIds.len ||
           store.elementOrdinals[i] < 0 ||
           !InnovationSha256CidValid(store.elementTextHashes[i]) ||
           !InnovationSha256CidValid(
               store.elementTechnicalEffectHashes[i]):
            return innovationErrBool("innovation csg: invalid claim element row")
    for i in 0..<store.contributionIds.len:
        let documentIndex = store.contributionDocumentIndexes[i]
        if !innovationInputCommonValid(
               store.contributionIds[i],
               store.contributionSemanticStatuses[i]) ||
           documentIndex < 0 || documentIndex >= store.documentIds.len ||
           store.documentKinds[documentIndex] != InnovationDocumentPaper ||
           store.contributionOrdinals[i] < 0 ||
           !InnovationSha256CidValid(store.contributionHashes[i]) ||
           !InnovationSha256CidValid(store.contributionMethodHashes[i]) ||
           !InnovationSha256CidValid(store.contributionEvidenceHashes[i]):
            return innovationErrBool("innovation csg: invalid contribution row")
    for i in 0..<store.evidenceIds.len:
        if !innovationInputCommonValid(
               store.evidenceIds[i], store.evidenceSemanticStatuses[i]) ||
           !innovationNonEmpty(store.evidenceProductIds[i]) ||
           store.evidenceOrdinals[i] < 0 ||
           store.evidenceObservedAtMs[i] < int64(0) ||
           !InnovationSha256CidValid(store.evidenceHashes[i]) ||
           !InnovationSha256CidValid(store.evidenceSourceCids[i]):
            return innovationErrBool("innovation csg: invalid evidence row")
    var embeddingKeys: str[]
    var arenaCursor: int32
    for i in 0..<store.embeddingIds.len:
        let start = store.embeddingValueStarts[i]
        let count = store.embeddingValueCounts[i]
        if start != arenaCursor ||
           !innovationNonEmpty(store.embeddingIds[i]) ||
           !innovationTargetRowValid(
               store,
               store.embeddingTargetKinds[i],
               store.embeddingTargetIndexes[i]) ||
           !InnovationSha256CidValid(store.embeddingModelCids[i]) ||
           !InnovationSha256CidValid(store.embeddingTokenizerCids[i]) ||
           !InnovationSha256CidValid(store.embeddingToolCids[i]) ||
           store.embeddingNormalizationScales[i] <= 0 ||
           !innovationNonEmpty(store.embeddingQuantizations[i]) ||
           !innovationStoredEmbeddingValuesValid(store, i) ||
           store.embeddingVectorCids[i] !=
               innovationStoredVectorCid(store, i):
            return innovationErrBool("innovation csg: invalid embedding row")
        arenaCursor = arenaCursor + count
        add(embeddingKeys,
            innovationEmbeddingIndexKey(
                store.embeddingTargetKinds[i],
                store.embeddingTargetIndexes[i],
                store.embeddingModelCids[i],
                store.embeddingTokenizerCids[i],
                store.embeddingToolCids[i],
                store.embeddingNormalizationScales[i],
                store.embeddingQuantizations[i],
                count))
    if arenaCursor != store.embeddingValues.len:
        return innovationErrBool("innovation csg: embedding arena is not exact")
    let embeddingOrder = innovationSortedOrder(embeddingKeys)
    for i in 1..<embeddingOrder.len:
        if embeddingKeys[embeddingOrder[i - 1]] ==
           embeddingKeys[embeddingOrder[i]]:
            return innovationErrBool("innovation csg: ambiguous embedding target receipt")
    store.embeddingIndexKeys = embeddingKeys
    store.embeddingOrder = embeddingOrder
    store.evidenceProductOrder = innovationEvidenceProductOrder(store)
    store.sealed = true
    return innovationOkBool()

@borrows
fn innovationQueryValid(query: InnovationEmbeddingQuery): bool =
    return InnovationSha256CidValid(query.queryFactCid) &&
           InnovationSha256CidValid(query.modelCid) &&
           InnovationSha256CidValid(query.tokenizerCid) &&
           InnovationSha256CidValid(query.toolCid) &&
           query.normalizationScale > 0 &&
           innovationNonEmpty(query.quantization) &&
           innovationEmbeddingValuesValid(query.values)

fn innovationIntSqrt(value: int64): int64 =
    if value <= int64(0):
        return int64(0)
    var low: int64 = 1
    var high = value
    if high > int64(2147483647):
        high = int64(2147483647)
    var answer: int64
    while low <= high:
        let middle = low + (high - low) / int64(2)
        if middle <= value / middle:
            answer = middle
            low = middle + int64(1)
        else:
            high = middle - int64(1)
    return answer

@borrows
fn innovationEmbeddingScore(store: InnovationCsgStore,
                            embeddingRow: int32,
                            query: InnovationEmbeddingQuery): int32 =
    let start = store.embeddingValueStarts[embeddingRow]
    let count = store.embeddingValueCounts[embeddingRow]
    if count != query.values.len:
        return -1000001
    var dot: int64
    var leftNorm: int64
    var rightNorm: int64
    for i in 0..<count:
        let left = int64(store.embeddingValues[start + i])
        let right = int64(query.values[i])
        dot = dot + left * right
        leftNorm = leftNorm + left * left
        rightNorm = rightNorm + right * right
    let denominator = innovationIntSqrt(leftNorm) * innovationIntSqrt(rightNorm)
    if denominator <= int64(0):
        return -1000001
    var score = dot * InnovationSimilarityScale / denominator
    if score > InnovationSimilarityScale:
        score = InnovationSimilarityScale
    if score < -InnovationSimilarityScale:
        score = -InnovationSimilarityScale
    return int32(score)

@borrows
fn innovationSearchLess(scores: int32[],
                        kinds: int32[],
                        indexes: int32[],
                        left: int32,
                        right: int32): bool =
    if scores[left] != scores[right]:
        return scores[left] > scores[right]
    if kinds[left] != kinds[right]:
        return kinds[left] < kinds[right]
    return indexes[left] < indexes[right]

@borrows
fn innovationSearchOrder(scores: int32[],
                         kinds: int32[],
                         indexes: int32[]): int32[] =
    var order: int32[]
    var scratch: int32[]
    setLen(order, scores.len)
    setLen(scratch, scores.len)
    for i in 0..<scores.len:
        order[i] = i
    var width: int32 = 1
    while width < scores.len:
        var base: int32
        while base < scores.len:
            var middle = base + width
            if middle > scores.len:
                middle = scores.len
            var finish = middle + width
            if finish > scores.len:
                finish = scores.len
            var left = base
            var right = middle
            var out = base
            while left < middle && right < finish:
                if innovationSearchLess(scores, kinds, indexes,
                                        order[right], order[left]):
                    scratch[out] = order[right]
                    right = right + 1
                else:
                    scratch[out] = order[left]
                    left = left + 1
                out = out + 1
            while left < middle:
                scratch[out] = order[left]
                left = left + 1
                out = out + 1
            while right < finish:
                scratch[out] = order[right]
                right = right + 1
                out = out + 1
            base = finish
        for i in 0..<scores.len:
            order[i] = scratch[i]
        if width > scores.len - width:
            width = scores.len
        else:
            width = width + width
    return order

@borrows
fn innovationQueryReceiptHash(query: InnovationEmbeddingQuery,
                              targetKind: int32,
                              result: InnovationSearchResult): str =
    var parts: str[]
    add(parts, "schema=unimaker.innovation.search.receipt.v1")
    add(parts, strings.CloneStr(query.queryFactCid))
    add(parts, strings.CloneStr(query.modelCid))
    add(parts, strings.CloneStr(query.tokenizerCid))
    add(parts, strings.CloneStr(query.toolCid))
    add(parts, strings.IntToStr(query.normalizationScale))
    add(parts, strings.CloneStr(query.quantization))
    add(parts, strings.IntToStr(query.values.len))
    for valueIndex in 0..<query.values.len:
        add(parts, strings.IntToStr(query.values[valueIndex]))
    add(parts, strings.IntToStr(targetKind))
    for i in 0..<result.targetKinds.len:
        add(parts, strings.IntToStr(result.targetKinds[i]))
        add(parts, strings.IntToStr(result.targetIndexes[i]))
        add(parts, strings.IntToStr(result.embeddingIndexes[i]))
        add(parts, strings.IntToStr(result.scoreMicros[i]))
    return asset.AssetSha256(strutil.Join(parts, "\n"))

@borrows
fn InnovationSearchByEmbedding(store: InnovationCsgStore,
                               query: InnovationEmbeddingQuery,
                               targetKind: int32 = 0): InnovationSearchOutcome =
    if !store.sealed:
        return innovationSearchFail("innovation csg: search requires sealed store")
    if !innovationQueryValid(query):
        return innovationSearchFail("innovation csg: invalid embedding query")
    if targetKind != 0 &&
       targetKind != InnovationTargetDocument &&
       targetKind != InnovationTargetClaim &&
       targetKind != InnovationTargetClaimElement &&
       targetKind != InnovationTargetPaperContribution &&
       targetKind != InnovationTargetProductEvidence:
        return innovationSearchFail("innovation csg: invalid search target kind")
    var kinds: int32[]
    var indexes: int32[]
    var embeddings: int32[]
    var scores: int32[]
    for i in 0..<store.embeddingIds.len:
        if targetKind != 0 && store.embeddingTargetKinds[i] != targetKind:
            continue
        if store.embeddingModelCids[i] != query.modelCid ||
           store.embeddingTokenizerCids[i] != query.tokenizerCid ||
           store.embeddingToolCids[i] != query.toolCid ||
           store.embeddingNormalizationScales[i] != query.normalizationScale ||
           store.embeddingQuantizations[i] != query.quantization ||
           store.embeddingValueCounts[i] != query.values.len:
            continue
        let score = innovationEmbeddingScore(store, i, query)
        if score < -1000000:
            continue
        add(kinds, store.embeddingTargetKinds[i])
        add(indexes, store.embeddingTargetIndexes[i])
        add(embeddings, i)
        add(scores, score)
    let order = innovationSearchOrder(scores, kinds, indexes)
    var result: InnovationSearchResult
    for i in 0..<order.len:
        let at = order[i]
        add(result.targetKinds, kinds[at])
        add(result.targetIndexes, indexes[at])
        add(result.embeddingIndexes, embeddings[at])
        add(result.scoreMicros, scores[at])
    result.queryReceiptHash = innovationQueryReceiptHash(query,
                                                         targetKind,
                                                         result)
    var out: InnovationSearchOutcome
    out.ok = true
    out.result = result
    return out

fn innovationCat(left: str, right: str): str =
    return strings.ConcatStr(left, right)

@borrows
fn innovationJsonString(value: str): str =
    return canonical.CsgCoreJsonQuote(value)

@borrows
fn innovationCanonical(raw: str): str =
    let result = canonical.CsgCoreJsonCanonicalize(raw)
    if !result.ok:
        panic(strings.CloneStr(result.error))
    return strings.CloneStr(result.value)

fn innovationBool(value: bool): str =
    return value ? "true" : "false"

@borrows
fn innovationDocumentFact(store: InnovationCsgStore,
                          row: int32): str =
    var raw = "{"
    raw = innovationCat(raw, "\"kind\":\"csg_dialect::unimaker_product::innovation_document\",")
    raw = innovationCat(raw, innovationCat("\"id\":", innovationJsonString(store.documentIds[row])))
    raw = innovationCat(raw, innovationCat(",\"documentKind\":", strings.IntToStr(store.documentKinds[row])))
    raw = innovationCat(raw, innovationCat(",\"externalId\":", innovationJsonString(store.documentExternalIds[row])))
    raw = innovationCat(raw, innovationCat(",\"titleHash\":", innovationJsonString(store.documentTitleHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"sourceCid\":", innovationJsonString(store.documentSourceCids[row])))
    raw = innovationCat(raw, innovationCat(",\"sourceUri\":", innovationJsonString(store.documentSourceUris[row])))
    raw = innovationCat(raw, innovationCat(",\"publicationDate\":", strings.Int64ToStr(store.documentPublicationDates[row])))
    raw = innovationCat(raw, innovationCat(",\"priorityDate\":", strings.Int64ToStr(store.documentPriorityDates[row])))
    raw = innovationCat(raw, innovationCat(",\"jurisdiction\":", innovationJsonString(store.documentJurisdictions[row])))
    raw = innovationCat(raw, innovationCat(",\"language\":", innovationJsonString(store.documentLanguages[row])))
    raw = innovationCat(raw, innovationCat(",\"licenseHash\":", innovationJsonString(store.documentLicenseHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"semanticStatus\":", innovationJsonString(store.documentSemanticStatuses[row])))
    raw = innovationCat(raw, ",\"complete\":true}")
    return innovationCanonical(raw)

@borrows
fn innovationClaimFact(store: InnovationCsgStore,
                       row: int32): str =
    var raw = "{"
    raw = innovationCat(raw, "\"kind\":\"csg_dialect::unimaker_product::innovation_claim\",")
    raw = innovationCat(raw, innovationCat("\"id\":", innovationJsonString(store.claimIds[row])))
    raw = innovationCat(raw, innovationCat(",\"documentId\":", innovationJsonString(store.documentIds[store.claimDocumentIndexes[row]])))
    raw = innovationCat(raw, innovationCat(",\"claimNumber\":", strings.IntToStr(store.claimNumbers[row])))
    var parentId: str
    if store.claimParentIndexes[row] >= 0:
        parentId = strings.CloneStr(
            store.claimIds[store.claimParentIndexes[row]])
    else:
        parentId = "none"
    raw = innovationCat(raw, innovationCat(",\"parentClaimId\":", innovationJsonString(parentId)))
    raw = innovationCat(raw, innovationCat(",\"independent\":", innovationBool(store.claimIndependent[row])))
    raw = innovationCat(raw, innovationCat(",\"claimTextHash\":", innovationJsonString(store.claimTextHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"semanticStatus\":", innovationJsonString(store.claimSemanticStatuses[row])))
    raw = innovationCat(raw, ",\"complete\":true}")
    return innovationCanonical(raw)

@borrows
fn innovationElementFact(store: InnovationCsgStore,
                         row: int32): str =
    var raw = "{"
    raw = innovationCat(raw, "\"kind\":\"csg_dialect::unimaker_product::innovation_claim_element\",")
    raw = innovationCat(raw, innovationCat("\"id\":", innovationJsonString(store.elementIds[row])))
    raw = innovationCat(raw, innovationCat(",\"claimId\":", innovationJsonString(store.claimIds[store.elementClaimIndexes[row]])))
    raw = innovationCat(raw, innovationCat(",\"ordinal\":", strings.IntToStr(store.elementOrdinals[row])))
    raw = innovationCat(raw, innovationCat(",\"required\":", innovationBool(store.elementRequired[row])))
    raw = innovationCat(raw, innovationCat(",\"elementTextHash\":", innovationJsonString(store.elementTextHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"technicalEffectHash\":", innovationJsonString(store.elementTechnicalEffectHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"semanticStatus\":", innovationJsonString(store.elementSemanticStatuses[row])))
    raw = innovationCat(raw, ",\"complete\":true}")
    return innovationCanonical(raw)

@borrows
fn innovationContributionFact(store: InnovationCsgStore,
                              row: int32): str =
    var raw = "{"
    raw = innovationCat(raw, "\"kind\":\"csg_dialect::unimaker_product::innovation_paper_contribution\",")
    raw = innovationCat(raw, innovationCat("\"id\":", innovationJsonString(store.contributionIds[row])))
    raw = innovationCat(raw, innovationCat(",\"documentId\":", innovationJsonString(store.documentIds[store.contributionDocumentIndexes[row]])))
    raw = innovationCat(raw, innovationCat(",\"ordinal\":", strings.IntToStr(store.contributionOrdinals[row])))
    raw = innovationCat(raw, innovationCat(",\"contributionHash\":", innovationJsonString(store.contributionHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"methodHash\":", innovationJsonString(store.contributionMethodHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"evidenceHash\":", innovationJsonString(store.contributionEvidenceHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"semanticStatus\":", innovationJsonString(store.contributionSemanticStatuses[row])))
    raw = innovationCat(raw, ",\"complete\":true}")
    return innovationCanonical(raw)

@borrows
fn innovationEvidenceFact(store: InnovationCsgStore,
                          row: int32): str =
    var raw = "{"
    raw = innovationCat(raw, "\"kind\":\"csg_dialect::unimaker_product::innovation_product_evidence\",")
    raw = innovationCat(raw, innovationCat("\"id\":", innovationJsonString(store.evidenceIds[row])))
    raw = innovationCat(raw, innovationCat(",\"productId\":", innovationJsonString(store.evidenceProductIds[row])))
    raw = innovationCat(raw, innovationCat(",\"ordinal\":", strings.IntToStr(store.evidenceOrdinals[row])))
    raw = innovationCat(raw, innovationCat(",\"evidenceHash\":", innovationJsonString(store.evidenceHashes[row])))
    raw = innovationCat(raw, innovationCat(",\"sourceCid\":", innovationJsonString(store.evidenceSourceCids[row])))
    raw = innovationCat(raw, innovationCat(",\"observedAtMs\":", strings.Int64ToStr(store.evidenceObservedAtMs[row])))
    raw = innovationCat(raw, innovationCat(",\"semanticStatus\":", innovationJsonString(store.evidenceSemanticStatuses[row])))
    raw = innovationCat(raw, ",\"complete\":true}")
    return innovationCanonical(raw)

@borrows
fn innovationTargetFact(store: InnovationCsgStore,
                        targetKind: int32,
                        targetIndex: int32): str =
    if targetKind == InnovationTargetDocument:
        return innovationDocumentFact(store, targetIndex)
    if targetKind == InnovationTargetClaim:
        return innovationClaimFact(store, targetIndex)
    if targetKind == InnovationTargetClaimElement:
        return innovationElementFact(store, targetIndex)
    if targetKind == InnovationTargetPaperContribution:
        return innovationContributionFact(store, targetIndex)
    if targetKind == InnovationTargetProductEvidence:
        return innovationEvidenceFact(store, targetIndex)
    panic("innovation csg: invalid target fact")

@borrows
fn innovationTargetId(store: InnovationCsgStore,
                      targetKind: int32,
                      targetIndex: int32): str =
    if targetKind == InnovationTargetDocument:
        return strings.CloneStr(store.documentIds[targetIndex])
    if targetKind == InnovationTargetClaim:
        return strings.CloneStr(store.claimIds[targetIndex])
    if targetKind == InnovationTargetClaimElement:
        return strings.CloneStr(store.elementIds[targetIndex])
    if targetKind == InnovationTargetPaperContribution:
        return strings.CloneStr(store.contributionIds[targetIndex])
    if targetKind == InnovationTargetProductEvidence:
        return strings.CloneStr(store.evidenceIds[targetIndex])
    panic("innovation csg: invalid target identity")

@borrows
fn innovationFactCid(fact: str): str =
    var error: str
    let digest = merkle_dag.CsgCoreMerkleFactHash(fact, error)
    if error.len > 0:
        panic(strings.CloneStr(error))
    return innovationCat("sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn innovationVectorJson(store: InnovationCsgStore,
                        embeddingRow: int32): str =
    let start = store.embeddingValueStarts[embeddingRow]
    let count = store.embeddingValueCounts[embeddingRow]
    var parts: str[]
    add(parts, "[")
    for i in 0..<count:
        if i > 0:
            add(parts, ",")
        add(parts, strings.IntToStr(store.embeddingValues[start + i]))
    add(parts, "]")
    return strutil.Join(parts, "")

@borrows
fn innovationEmbeddingFact(store: InnovationCsgStore,
                           row: int32): str =
    let targetFact = innovationTargetFact(store,
                                          store.embeddingTargetKinds[row],
                                          store.embeddingTargetIndexes[row])
    let sourceFactCid = innovationFactCid(targetFact)
    var raw = "{"
    raw = innovationCat(raw, "\"kind\":\"csg_dialect::unimaker_product::innovation_embedding_receipt\",")
    raw = innovationCat(raw, innovationCat("\"id\":", innovationJsonString(store.embeddingIds[row])))
    raw = innovationCat(raw, innovationCat(",\"targetKind\":", strings.IntToStr(store.embeddingTargetKinds[row])))
    let targetId = innovationTargetId(store,
                                      store.embeddingTargetKinds[row],
                                      store.embeddingTargetIndexes[row])
    raw = innovationCat(raw, innovationCat(",\"targetId\":", innovationJsonString(targetId)))
    raw = innovationCat(raw, innovationCat(",\"sourceFactCid\":", innovationJsonString(sourceFactCid)))
    raw = innovationCat(raw, innovationCat(",\"modelCid\":", innovationJsonString(store.embeddingModelCids[row])))
    raw = innovationCat(raw, innovationCat(",\"tokenizerCid\":", innovationJsonString(store.embeddingTokenizerCids[row])))
    raw = innovationCat(raw, innovationCat(",\"toolCid\":", innovationJsonString(store.embeddingToolCids[row])))
    raw = innovationCat(raw, innovationCat(",\"vectorCid\":", innovationJsonString(store.embeddingVectorCids[row])))
    raw = innovationCat(raw, innovationCat(",\"dimension\":", strings.IntToStr(store.embeddingValueCounts[row])))
    raw = innovationCat(raw, innovationCat(",\"normalizationScale\":", strings.IntToStr(store.embeddingNormalizationScales[row])))
    raw = innovationCat(raw, innovationCat(",\"quantization\":", innovationJsonString(store.embeddingQuantizations[row])))
    raw = innovationCat(raw, innovationCat(",\"vectorValues\":", innovationVectorJson(store, row)))
    raw = innovationCat(raw, ",\"complete\":true}")
    return innovationCanonical(raw)

@borrows
fn InnovationFactsCanonicalLines(store: InnovationCsgStore): str[] =
    if !store.sealed:
        panic("innovation csg: facts require sealed store")
    var lines: str[]
    add(lines, "{\"features\":[\"core-facts\",\"unimaker-product\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}")
    for i in 0..<store.documentIds.len:
        add(lines, innovationDocumentFact(store, i))
    for i in 0..<store.claimIds.len:
        add(lines, innovationClaimFact(store, i))
    for i in 0..<store.elementIds.len:
        add(lines, innovationElementFact(store, i))
    for i in 0..<store.contributionIds.len:
        add(lines, innovationContributionFact(store, i))
    for i in 0..<store.evidenceIds.len:
        add(lines, innovationEvidenceFact(store, i))
    for i in 0..<store.embeddingIds.len:
        add(lines, innovationEmbeddingFact(store, i))
    return lines

@borrows
fn InnovationFactsRoot(store: InnovationCsgStore): str =
    let lines = InnovationFactsCanonicalLines(store)
    let admission = csg.CsgCoreProductionAdmitFactLines(lines)
    if !admission.valid || !admission.complete:
        return ""
    return strings.CloneStr(admission.factsRoot)

@borrows
fn InnovationEncodeCsgc(store: InnovationCsgStore): asset.CsgAssetCsgcCargo =
    let lines = InnovationFactsCanonicalLines(store)
    let admission = csg.CsgCoreProductionAdmitFactLines(lines)
    var out: asset.CsgAssetCsgcCargo
    if !admission.valid || !admission.complete:
        out.error = "innovation csg: strict admission failed"
        return out
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok:
        out.error = strings.CloneStr(encoded.error)
        return out
    if encoded.factCount != admission.factCount:
        rawbytes.BytesFree(encoded.bytes)
        out.error = "innovation csg: admission and CSGC count differ"
        return out
    out.ok = true
    out.factsRoot = strings.CloneStr(admission.factsRoot)
    out.bytes = encoded.bytes
    out.headerSize = encoded.headerSize
    out.flags = encoded.flags
    out.factCount = encoded.factCount
    out.dictionaryCount = encoded.dictionaryCount
    return out

@borrows
fn innovationFindEmbedding(store: InnovationCsgStore,
                           targetKind: int32,
                           targetIndex: int32,
                           query: InnovationEmbeddingQuery): int32 =
    let key = innovationEmbeddingIndexKey(targetKind,
                                          targetIndex,
                                          query.modelCid,
                                          query.tokenizerCid,
                                          query.toolCid,
                                          query.normalizationScale,
                                          query.quantization,
                                          query.values.len)
    var low: int32
    var high = store.embeddingOrder.len
    while low < high:
        let middle = low + (high - low) / 2
        let row = store.embeddingOrder[middle]
        if innovationStrLess(store.embeddingIndexKeys[row], key):
            low = middle + 1
        else:
            high = middle
    if low < store.embeddingOrder.len:
        let row = store.embeddingOrder[low]
        if store.embeddingIndexKeys[row] == key:
            return row
    return -1

@borrows
fn innovationChartReceiptHash(store: InnovationCsgStore,
                              chart: InnovationClaimChart): str =
    var parts: str[]
    add(parts, "schema=unimaker.innovation.claim_chart.v1")
    add(parts, strings.CloneStr(store.claimIds[chart.claimIndex]))
    add(parts, strings.CloneStr(chart.productId))
    add(parts, strings.CloneStr(chart.corpusFactsRoot))
    add(parts, strings.CloneStr(chart.modelCid))
    add(parts, strings.CloneStr(chart.tokenizerCid))
    add(parts, strings.CloneStr(chart.toolCid))
    add(parts, strings.IntToStr(chart.dimension))
    add(parts, strings.IntToStr(chart.normalizationScale))
    add(parts, strings.CloneStr(chart.quantization))
    add(parts, strings.IntToStr(chart.thresholdMicros))
    add(parts, strings.IntToStr(chart.requiredCount))
    add(parts, strings.IntToStr(chart.matchedCount))
    add(parts, innovationBool(chart.allRequiredCandidate))
    add(parts, "candidateOnly=true")
    for i in 0..<chart.claimElementIndexes.len:
        add(parts, strings.CloneStr(store.elementIds[chart.claimElementIndexes[i]]))
        if chart.evidenceIndexes[i] >= 0:
            add(parts, strings.CloneStr(store.evidenceIds[chart.evidenceIndexes[i]]))
        else:
            add(parts, "none")
        add(parts, strings.IntToStr(chart.scoreMicros[i]))
        add(parts, innovationBool(chart.matched[i]))
    return asset.AssetSha256(strutil.Join(parts, "\n"))

@borrows
fn InnovationBuildClaimChart(store: InnovationCsgStore,
                             claimIndex: int32,
                             productId: str,
                             queryContract: InnovationEmbeddingQuery,
                             thresholdMicros: int32): InnovationClaimChartOutcome =
    if !store.sealed:
        return innovationChartFail("innovation csg: claim chart requires sealed store")
    if claimIndex < 0 || claimIndex >= store.claimIds.len ||
       !store.claimIndependent[claimIndex]:
        return innovationChartFail("innovation csg: claim chart requires an independent claim")
    if !innovationNonEmpty(productId) || !innovationQueryValid(queryContract) ||
       thresholdMicros < -1000000 || thresholdMicros > 1000000:
        return innovationChartFail("innovation csg: invalid claim chart request")
    var productEvidence: int32[]
    for i in 0..<store.evidenceProductOrder.len:
        let row = store.evidenceProductOrder[i]
        if store.evidenceProductIds[row] == productId:
            add(productEvidence, row)
    if productEvidence.len == 0:
        return innovationChartFail("innovation csg: product has no admitted evidence")
    var chart: InnovationClaimChart
    chart.claimIndex = claimIndex
    chart.productId = strings.CloneStr(productId)
    chart.thresholdMicros = thresholdMicros
    chart.modelCid = strings.CloneStr(queryContract.modelCid)
    chart.tokenizerCid = strings.CloneStr(queryContract.tokenizerCid)
    chart.toolCid = strings.CloneStr(queryContract.toolCid)
    chart.dimension = queryContract.values.len
    chart.normalizationScale = queryContract.normalizationScale
    chart.quantization = strings.CloneStr(queryContract.quantization)
    chart.corpusFactsRoot = InnovationFactsRoot(store)
    if !InnovationSha256CidValid(chart.corpusFactsRoot):
        return innovationChartFail("innovation csg: corpus strict admission failed")
    for elementIndex in 0..<store.elementIds.len:
        if store.elementClaimIndexes[elementIndex] != claimIndex ||
           !store.elementRequired[elementIndex]:
            continue
        chart.requiredCount = chart.requiredCount + 1
        let elementEmbedding = innovationFindEmbedding(
            store, InnovationTargetClaimElement,
            elementIndex, queryContract)
        var bestEvidence: int32 = -1
        var bestScore: int32 = -1000001
        if elementEmbedding >= 0:
            var elementQuery: InnovationEmbeddingQuery
            elementQuery.queryFactCid =
                strings.CloneStr(queryContract.queryFactCid)
            elementQuery.modelCid =
                strings.CloneStr(queryContract.modelCid)
            elementQuery.tokenizerCid =
                strings.CloneStr(queryContract.tokenizerCid)
            elementQuery.toolCid =
                strings.CloneStr(queryContract.toolCid)
            elementQuery.normalizationScale =
                queryContract.normalizationScale
            elementQuery.quantization =
                strings.CloneStr(queryContract.quantization)
            let start = store.embeddingValueStarts[elementEmbedding]
            let count = store.embeddingValueCounts[elementEmbedding]
            for valueIndex in 0..<count:
                add(elementQuery.values,
                    store.embeddingValues[start + valueIndex])
            for evidenceAt in 0..<productEvidence.len:
                let evidenceIndex = productEvidence[evidenceAt]
                let evidenceEmbedding = innovationFindEmbedding(
                    store, InnovationTargetProductEvidence,
                    evidenceIndex, queryContract)
                if evidenceEmbedding < 0:
                    continue
                let score = innovationEmbeddingScore(
                    store, evidenceEmbedding, elementQuery)
                if score > bestScore ||
                   (score == bestScore &&
                    (bestEvidence < 0 || evidenceIndex < bestEvidence)):
                    bestScore = score
                    bestEvidence = evidenceIndex
        let matched = bestEvidence >= 0 && bestScore >= thresholdMicros
        if matched:
            chart.matchedCount = chart.matchedCount + 1
        add(chart.claimElementIndexes, elementIndex)
        add(chart.evidenceIndexes, bestEvidence)
        add(chart.scoreMicros, bestScore)
        add(chart.matched, matched)
    if chart.requiredCount <= 0:
        return innovationChartFail("innovation csg: independent claim has no required elements")
    chart.allRequiredCandidate = chart.matchedCount == chart.requiredCount
    chart.alignmentRoot = innovationChartReceiptHash(store, chart)
    chart.receiptHash = asset.AssetSha256(
        innovationCat("schema=unimaker.innovation.claim_chart.receipt.v1\n",
                      chart.alignmentRoot))
    var out: InnovationClaimChartOutcome
    out.ok = true
    out.chart = chart
    return out

@borrows
fn InnovationClaimChartFact(chart: InnovationClaimChart,
                            claimId: str): str =
    if !chart.candidateOnly ||
       !InnovationSha256CidValid(chart.corpusFactsRoot) ||
       !InnovationSha256CidValid(chart.alignmentRoot) ||
       !InnovationSha256CidValid(chart.receiptHash):
        panic("innovation csg: invalid claim chart receipt")
    var raw = "{"
    raw = innovationCat(raw, "\"kind\":\"csg_dialect::unimaker_product::innovation_claim_chart\",")
    raw = innovationCat(raw, innovationCat("\"id\":", innovationJsonString(innovationCat("claim-chart:", chart.receiptHash))))
    raw = innovationCat(raw, innovationCat(",\"claimId\":", innovationJsonString(claimId)))
    raw = innovationCat(raw, innovationCat(",\"productId\":", innovationJsonString(chart.productId)))
    raw = innovationCat(raw, innovationCat(",\"requiredCount\":", strings.IntToStr(chart.requiredCount)))
    raw = innovationCat(raw, innovationCat(",\"matchedCount\":", strings.IntToStr(chart.matchedCount)))
    raw = innovationCat(raw, innovationCat(",\"allRequiredCandidate\":", innovationBool(chart.allRequiredCandidate)))
    raw = innovationCat(raw, ",\"candidateOnly\":true")
    raw = innovationCat(raw, innovationCat(",\"thresholdMicros\":", strings.IntToStr(chart.thresholdMicros)))
    raw = innovationCat(raw, innovationCat(",\"corpusFactsRoot\":", innovationJsonString(chart.corpusFactsRoot)))
    raw = innovationCat(raw, innovationCat(",\"modelCid\":", innovationJsonString(chart.modelCid)))
    raw = innovationCat(raw, innovationCat(",\"tokenizerCid\":", innovationJsonString(chart.tokenizerCid)))
    raw = innovationCat(raw, innovationCat(",\"toolCid\":", innovationJsonString(chart.toolCid)))
    raw = innovationCat(raw, innovationCat(",\"dimension\":", strings.IntToStr(chart.dimension)))
    raw = innovationCat(raw, innovationCat(",\"normalizationScale\":", strings.IntToStr(chart.normalizationScale)))
    raw = innovationCat(raw, innovationCat(",\"quantization\":", innovationJsonString(chart.quantization)))
    raw = innovationCat(raw, innovationCat(",\"alignmentRoot\":", innovationJsonString(chart.alignmentRoot)))
    raw = innovationCat(raw, innovationCat(",\"receiptHash\":", innovationJsonString(chart.receiptHash)))
    raw = innovationCat(raw, ",\"complete\":true}")
    return innovationCanonical(raw)
