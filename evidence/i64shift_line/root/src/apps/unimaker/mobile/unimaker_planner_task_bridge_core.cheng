import std/rawbytes as rawbytes
import cheng/inference/distributed_engine as engine
import cheng/inference/planner_task as ptask

# 小优规划器 <-> UniMaker computer-use 执行面桥, 首切片。
#
# ABI 形状逐行照抄 src/apps/vpn_proxy/mobile/vpn_proxy_mobile_core.cheng 的
# SABI 配方 (utf8 输入走 (ptr,len) 立即深拷贝成 str, 文本输出走 @importc
# emit 回调同步 push, 禁止 @exportc 返回 str/cstring/owned_cstring)。
#
# 任务03 失败语义 (合同: docs/campaigns/2026-09-21-csg-decision-computer-use/
# contract.md §3): 两个显式模式入口, 无任何失败回退通道 ——
#   cheng_unimaker_planner_classify_task_kind        模型模式: Ok -> emit + rc=0;
#       Err (未配置/坏权重/加载/推理/取消/超时) -> rc=2 且不 emit
#       (取消/失败无 emit 副作用, 调用者能区别成功与失败)。
#   cheng_unimaker_planner_classify_task_kind_rules  规则模式: 独立显式入口,
#       只能由调用者预先选择, 不是模型失败的替换品; 语义同旧 rc 契约。

@importc("cheng_unimaker_planner_task_kind_emit")
fn ChengUnimakerPlannerTaskKindEmitRaw(taskKindRaw: ptr, taskKindLen: int64): int32

fn ChengUnimakerPlannerTaskKindEmit(taskKind: str): int32 =
    return ChengUnimakerPlannerTaskKindEmitRaw(StrDataPtr(taskKind), int64(len(taskKind)))

fn ChengUnimakerPlannerCopyRawText(raw: ptr, rawLen: int64): str =
    if raw == nil || rawLen <= int64(0):
        return ""
    if rawLen > int64(2147483647):
        return ""
    return rawbytes.BytesToString(rawbytes.BytesView(raw, int32(rawLen)))

@exportc("cheng_unimaker_planner_classify_task_kind")
fn cheng_unimaker_planner_classify_task_kind(transcriptRaw: ptr, transcriptLen: int64): int32 =
    let transcript = ChengUnimakerPlannerCopyRawText(transcriptRaw, transcriptLen)
    let kindRes = ptask.PlannerTaskClassifyFromTextWithBudget(
        transcript, engine.DistributedGenerationBudgetUnbounded())
    if IsErr(kindRes):
        return 2
    return ChengUnimakerPlannerTaskKindEmit(Value(kindRes))

@exportc("cheng_unimaker_planner_classify_task_kind_rules")
fn cheng_unimaker_planner_classify_task_kind_rules(transcriptRaw: ptr, transcriptLen: int64): int32 =
    let transcript = ChengUnimakerPlannerCopyRawText(transcriptRaw, transcriptLen)
    let taskKind = ptask.PlannerTaskClassifyRulesFromText(transcript)
    return ChengUnimakerPlannerTaskKindEmit(taskKind)
