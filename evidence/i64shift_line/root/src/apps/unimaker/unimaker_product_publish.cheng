import std/result
import std/rawbytes
import std/strings as strings
import std/strutils as strutil
import cheng/apps/unimaker/unimaker_edge_types as types
import cheng/apps/unimaker/unimaker_edge_agent as edge_agent
import cheng/core/csg_asset/oracle_asset as asset
import cheng/apps/vexa/vexa_asset_discovery as discovery

type
    UnimakerProductPublishRequest =
        observation: asset.OracleAssetObservation
        claim: asset.UnimakerProductSourceClaim
        nowMs: int64
        actionKind: str
        preconditionHash: str
        executorId: str
        executionStateHash: str
        outputStateHash: str
        executedAtMs: int64
        resumeTokenHash: str

    UnimakerProductSignedPublishRequest =
        observation: asset.OracleAssetObservation
        signedClaim: asset.UnimakerProductSignedSourceClaim
        trustedSignerHash: str
        nowMs: int64
        actionKind: str
        preconditionHash: str
        executorId: str
        executionStateHash: str
        outputStateHash: str
        executedAtMs: int64
        resumeTokenHash: str

    UnimakerProductPublishBundle =
        certificate: asset.UnimakerProductCertificate
        candidate: asset.VexaAssetCandidate
        plan: asset.VexaDeterministicPlan
        executionReceipt: asset.VexaExecutionReceipt
        cell: asset.VexaRecoverableCell
        assetFactsRoot: str
        closedLoopFactsRoot: str
        csgcBytes: rawbytes.Bytes
        csgcFactCount: int32

    UnimakerProductPublishRecord =
        taskId: str
        productId: str
        assetId: str
        csgcByteCount: int32
        csgcFactCount: int32
        assetFactsRoot: str
        closedLoopFactsRoot: str
        planRoot: str
        proofHash: str
        receiptHash: str
        recoveryRoot: str
        eventContentHash: str
        epochSeconds: int64
        complete: bool

    UnimakerProductPublishLedger =
        records: UnimakerProductPublishRecord[]
        ledgerRoot: str

    UnimakerProductPublishSubmitResult =
        bundle: UnimakerProductPublishBundle
        record: UnimakerProductPublishRecord
        capsule: types.EvoCapsule
        admitted: discovery.VexaAdmittedAsset
        ledgerRoot: str
        registryRoot: str

fn unimakerPublishErr(message: str): Result[UnimakerProductPublishBundle] =
    var out: Result[UnimakerProductPublishBundle]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn unimakerPublishOk(value: UnimakerProductPublishBundle): Result[UnimakerProductPublishBundle] =
    var out: Result[UnimakerProductPublishBundle]
    out.ok = true
    out.value = value
    return out

fn unimakerRecordErr(message: str): Result[UnimakerProductPublishRecord] =
    var out: Result[UnimakerProductPublishRecord]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn unimakerRecordOk(value: UnimakerProductPublishRecord): Result[UnimakerProductPublishRecord] =
    var out: Result[UnimakerProductPublishRecord]
    out.ok = true
    out.value = value
    return out

fn unimakerProductPublishCompileWithCertificate(request: UnimakerProductPublishRequest,
                                                cert: asset.UnimakerProductCertificate): Result[UnimakerProductPublishBundle] =
    let candidateRes = asset.VexaAssetFromProductCertificate(cert)
    if !candidateRes.ok:
        return unimakerPublishErr(candidateRes.err.msg)
    let candidate = candidateRes.value

    let assetLines = asset.CsgAssetFactsDebugLines(request.observation, cert, candidate)
    let assetAdmission =
        asset.CsgAssetProductionAdmitFactLines(
            assetLines)
    if !assetAdmission.valid || !assetAdmission.complete:
        var reason =
            "unimaker publish: asset facts admission failed"
        if assetAdmission.errors.len > 0:
            reason = strings.ConcatStr(
                reason,
                strings.ConcatStr(
                    " ", assetAdmission.errors[0]))
        return unimakerPublishErr(reason)
    let assetFactsRoot = assetAdmission.factsRoot

    let planRes = asset.VexaCompileDeterministicPlan(candidate,
                                                     assetFactsRoot,
                                                     request.actionKind,
                                                     request.preconditionHash,
                                                     request.nowMs,
                                                     cert.validUntilMs)
    if !planRes.ok:
        return unimakerPublishErr(planRes.err.msg)
    let plan = planRes.value

    let receiptRes = asset.VexaCommitExecutionReceipt(plan,
                                                      request.executorId,
                                                      request.executionStateHash,
                                                      request.outputStateHash,
                                                      request.executedAtMs,
                                                      "committed")
    if !receiptRes.ok:
        return unimakerPublishErr(receiptRes.err.msg)
    let executionReceipt = receiptRes.value

    let cellRes = asset.VexaBuildRecoverableCell(assetFactsRoot,
                                                 plan,
                                                 executionReceipt,
                                                 request.resumeTokenHash)
    if !cellRes.ok:
        return unimakerPublishErr(cellRes.err.msg)
    let cell = cellRes.value

    let closedLines = asset.CsgAssetClosedLoopFactsDebugLines(request.observation,
                                                             cert,
                                                             candidate,
                                                             plan,
                                                             executionReceipt,
                                                             cell)
    let csgcCargo =
        asset.CsgAssetAdmitAndEncodeCsgc(
            closedLines)
    if !csgcCargo.ok:
        return unimakerPublishErr(csgcCargo.error)

    var out: UnimakerProductPublishBundle
    out.certificate = cert
    out.candidate = candidate
    out.plan = plan
    out.executionReceipt = executionReceipt
    out.cell = cell
    out.assetFactsRoot = assetFactsRoot
    out.closedLoopFactsRoot = csgcCargo.factsRoot
    out.csgcBytes = csgcCargo.bytes
    out.csgcFactCount = csgcCargo.factCount
    return unimakerPublishOk(out)

fn UnimakerProductPublishCompile(request: UnimakerProductPublishRequest): Result[UnimakerProductPublishBundle] =
    let certRes = asset.UnimakerCompileProductCertificateFromObservation(request.claim,
                                                                         request.observation,
                                                                         request.nowMs)
    if !certRes.ok:
        return unimakerPublishErr(certRes.err.msg)
    return unimakerProductPublishCompileWithCertificate(request, certRes.value)

fn UnimakerProductPublishCompileSigned(request: UnimakerProductSignedPublishRequest): Result[UnimakerProductPublishBundle] =
    let certRes = asset.UnimakerCompileProductCertificateFromSignedObservation(request.signedClaim,
                                                                               request.trustedSignerHash,
                                                                               request.observation,
                                                                               request.nowMs)
    if !certRes.ok:
        return unimakerPublishErr(certRes.err.msg)
    var unsignedRequest: UnimakerProductPublishRequest
    unsignedRequest.observation = request.observation
    unsignedRequest.claim = request.signedClaim.claim
    unsignedRequest.nowMs = request.nowMs
    unsignedRequest.actionKind = request.actionKind
    unsignedRequest.preconditionHash = request.preconditionHash
    unsignedRequest.executorId = request.executorId
    unsignedRequest.executionStateHash = request.executionStateHash
    unsignedRequest.outputStateHash = request.outputStateHash
    unsignedRequest.executedAtMs = request.executedAtMs
    unsignedRequest.resumeTokenHash = request.resumeTokenHash
    return unimakerProductPublishCompileWithCertificate(unsignedRequest, certRes.value)

fn UnimakerProductPublishEvent(bundle: UnimakerProductPublishBundle,
                               taskId: str,
                               epochSeconds: int64): types.EvolutionEvent =
    var keywords: str[]
    add(keywords, "product")
    add(keywords, "publish")
    add(keywords, "csg")
    let content = asset.AssetSha256(bundle.cell.recoveryRoot)
    return types.UnimakerEventMake(types.UnimakerEventToolResult,
                                    taskId,
                                    content,
                                    keywords,
                                    [],
                                    types.UnimakerEdgeKindCausedBy,
                                    epochSeconds)

fn UnimakerProductPublishIngestAgent(edge: var edge_agent.UnimakerAgent,
                                     bundle: UnimakerProductPublishBundle,
                                     taskId: str,
                                     epochSeconds: int64): Result[types.EvoCapsule] =
    if !bundle.cell.complete:
        return Err[types.EvoCapsule]("unimaker publish: incomplete bundle cannot enter edge agent")
    if rawbytes.BytesLen(bundle.csgcBytes) <= 64:
        return Err[types.EvoCapsule]("unimaker publish: empty CSGC cannot enter edge agent")
    if len(taskId) <= 0:
        return Err[types.EvoCapsule]("unimaker publish: missing task id")
    if epochSeconds <= int64(0):
        return Err[types.EvoCapsule]("unimaker publish: invalid publish timestamp")
    let event = UnimakerProductPublishEvent(bundle, taskId, epochSeconds)
    return edge_agent.UnimakerAgentIngest(edge, event)

fn unimakerPublishStrLess(left: str, right: str): bool =
    if left == right:
        return false
    let sharedLen = len(left) < len(right) ? len(left) : len(right)
    for i in 0..<sharedLen:
        if left[i] == right[i]:
            continue
        return left[i] < right[i]
    return len(left) < len(right)

fn unimakerPublishSortStrings(values: var str[]) =
    if values.len <= 1:
        return
    for i in 1..<values.len:
        let value = values[i]
        var j = i
        while j > 0:
            if !unimakerPublishStrLess(value, values[j - 1]):
                break
            values[j] = values[j - 1]
            j = j - 1
        values[j] = value

fn UnimakerProductPublishRecordPreimage(record: UnimakerProductPublishRecord): str =
    return strutil.Join([
        "schema=csg_dialect::unimaker_product::publish_record",
        "\ntaskId=", record.taskId,
        "\nproductId=", record.productId,
        "\nassetId=", record.assetId,
        "\ncsgcByteCount=", strings.IntToStr(record.csgcByteCount),
        "\ncsgcFactCount=", strings.IntToStr(record.csgcFactCount),
        "\nassetFactsRoot=", record.assetFactsRoot,
        "\nclosedLoopFactsRoot=", record.closedLoopFactsRoot,
        "\nplanRoot=", record.planRoot,
        "\nproofHash=", record.proofHash,
        "\nreceiptHash=", record.receiptHash,
        "\nrecoveryRoot=", record.recoveryRoot,
        "\neventContentHash=", record.eventContentHash,
        "\nepochSeconds=", strings.Int64ToStr(record.epochSeconds),
        "\ncomplete=", record.complete ? "true" : "false"
    ], "")

fn UnimakerProductPublishLedgerRoot(records: UnimakerProductPublishRecord[]): str =
    var preimages: str[]
    for i in 0..<records.len:
        add(preimages, UnimakerProductPublishRecordPreimage(records[i]))
    unimakerPublishSortStrings(preimages)
    return asset.AssetSha256(strutil.Join(preimages, "\n---\n"))

fn UnimakerProductPublishLedgerInit(): UnimakerProductPublishLedger =
    var out: UnimakerProductPublishLedger
    out.ledgerRoot = UnimakerProductPublishLedgerRoot(out.records)
    return out

@borrows
fn UnimakerProductPublishLedgerCount(ledger: UnimakerProductPublishLedger): int32 =
    return ledger.records.len

fn UnimakerProductPublishLedgerFindRecoveryRoot(ledger: UnimakerProductPublishLedger,
                                                recoveryRoot: str): int32 =
    for i in 0..<ledger.records.len:
        if ledger.records[i].recoveryRoot == recoveryRoot:
            return i
    return -1

fn UnimakerProductPublishRecordFromBundle(bundle: UnimakerProductPublishBundle,
                                          taskId: str,
                                          epochSeconds: int64): Result[UnimakerProductPublishRecord] =
    if !bundle.cell.complete:
        return unimakerRecordErr("unimaker publish: incomplete recoverable Cell")
    if bundle.csgcFactCount <= 0:
        return unimakerRecordErr("unimaker publish: empty CSGC facts")
    if rawbytes.BytesLen(bundle.csgcBytes) <= 64:
        return unimakerRecordErr("unimaker publish: empty CSGC bytes")
    if len(taskId) <= 0:
        return unimakerRecordErr("unimaker publish: missing task id")
    if epochSeconds <= int64(0):
        return unimakerRecordErr("unimaker publish: invalid publish timestamp")
    let event = UnimakerProductPublishEvent(bundle, taskId, epochSeconds)
    var out: UnimakerProductPublishRecord
    out.taskId = taskId
    out.productId = bundle.certificate.productId
    out.assetId = bundle.candidate.id
    out.csgcByteCount = rawbytes.BytesLen(bundle.csgcBytes)
    out.csgcFactCount = bundle.csgcFactCount
    out.assetFactsRoot = bundle.assetFactsRoot
    out.closedLoopFactsRoot = bundle.closedLoopFactsRoot
    out.planRoot = bundle.plan.planRoot
    out.proofHash = bundle.plan.proofHash
    out.receiptHash = bundle.executionReceipt.receiptHash
    out.recoveryRoot = bundle.cell.recoveryRoot
    out.eventContentHash = event.contentText
    out.epochSeconds = epochSeconds
    out.complete = true
    return unimakerRecordOk(out)

fn UnimakerProductPublishLedgerAppend(ledger: var UnimakerProductPublishLedger,
                                      record: UnimakerProductPublishRecord): Result[UnimakerProductPublishRecord] =
    if !record.complete:
        return unimakerRecordErr("unimaker publish: incomplete publish record")
    if len(record.recoveryRoot) <= 0:
        return unimakerRecordErr("unimaker publish: missing recovery root")
    if UnimakerProductPublishLedgerFindRecoveryRoot(ledger, record.recoveryRoot) >= 0:
        return unimakerRecordErr("unimaker publish: duplicate recovery root")
    add(ledger.records, record)
    ledger.ledgerRoot = UnimakerProductPublishLedgerRoot(ledger.records)
    return unimakerRecordOk(record)

fn UnimakerProductPublishLedgerAppendBundle(ledger: var UnimakerProductPublishLedger,
                                            bundle: UnimakerProductPublishBundle,
                                            taskId: str,
                                            epochSeconds: int64): Result[UnimakerProductPublishRecord] =
    let recordRes = UnimakerProductPublishRecordFromBundle(bundle, taskId, epochSeconds)
    if !recordRes.ok:
        return unimakerRecordErr(recordRes.err.msg)
    return UnimakerProductPublishLedgerAppend(ledger, recordRes.value)

fn unimakerSubmitErr(message: str): Result[UnimakerProductPublishSubmitResult] =
    var out: Result[UnimakerProductPublishSubmitResult]
    out.ok = false
    out.err.code = 1
    out.err.msg = message
    return out

fn unimakerSubmitOk(value: UnimakerProductPublishSubmitResult): Result[UnimakerProductPublishSubmitResult] =
    var out: Result[UnimakerProductPublishSubmitResult]
    out.ok = true
    out.value = value
    return out

fn unimakerProductPublishSubmitBundle(edge: var edge_agent.UnimakerAgent,
                                      ledger: var UnimakerProductPublishLedger,
                                      registry: var discovery.VexaAdmissionRegistry,
                                      bundle: UnimakerProductPublishBundle,
                                      taskId: str,
                                      epochSeconds: int64): Result[UnimakerProductPublishSubmitResult] =
    let recordRes = UnimakerProductPublishRecordFromBundle(bundle, taskId, epochSeconds)
    if !recordRes.ok:
        return unimakerSubmitErr(recordRes.err.msg)
    let record = recordRes.value
    if UnimakerProductPublishLedgerFindRecoveryRoot(ledger, record.recoveryRoot) >= 0:
        return unimakerSubmitErr("unimaker publish: duplicate recovery root")
    let admittedRes = discovery.VexaAdmitClosedLoopAssetFromCsgc(bundle.csgcBytes)
    if !admittedRes.ok:
        return unimakerSubmitErr(admittedRes.err.msg)
    let admitted = admittedRes.value
    if discovery.VexaAdmissionRegistryFindByRecoveryRoot(registry, admitted.recoveryRoot) >= 0:
        return unimakerSubmitErr("vexa discovery: duplicate recovery root")
    if discovery.VexaAdmissionRegistryFindByPlanRoot(registry, admitted.planRoot) >= 0:
        return unimakerSubmitErr("vexa discovery: duplicate plan root")
    if record.planRoot != admitted.planRoot:
        return unimakerSubmitErr("unimaker publish: ledger plan root diverged from Vexa admission")
    if record.closedLoopFactsRoot != admitted.closedLoopFactsRoot:
        return unimakerSubmitErr("unimaker publish: ledger facts root diverged from Vexa admission")
    if record.receiptHash != admitted.receiptHash:
        return unimakerSubmitErr("unimaker publish: ledger receipt hash diverged from Vexa admission")
    if record.recoveryRoot != admitted.recoveryRoot:
        return unimakerSubmitErr("unimaker publish: ledger recovery root diverged from Vexa admission")
    let appendRes = UnimakerProductPublishLedgerAppend(ledger, record)
    if !appendRes.ok:
        return unimakerSubmitErr(appendRes.err.msg)
    let capsuleRes = UnimakerProductPublishIngestAgent(edge,
                                                       bundle,
                                                       taskId,
                                                       epochSeconds)
    if IsErr(capsuleRes):
        return unimakerSubmitErr(Error(capsuleRes))
    let capsule = Value(capsuleRes)
    let registryRes = discovery.VexaAdmissionRegistryAdmit(registry, admitted)
    if !registryRes.ok:
        return unimakerSubmitErr(registryRes.err.msg)
    if capsule.contentText != record.eventContentHash:
        return unimakerSubmitErr("unimaker publish: edge capsule content diverged from ledger event")
    var out: UnimakerProductPublishSubmitResult
    out.bundle = bundle
    out.record = record
    out.capsule = capsule
    out.admitted = admitted
    out.ledgerRoot = ledger.ledgerRoot
    out.registryRoot = registry.registryRoot
    return unimakerSubmitOk(out)

fn UnimakerProductPublishSubmit(edge: var edge_agent.UnimakerAgent,
                                ledger: var UnimakerProductPublishLedger,
                                registry: var discovery.VexaAdmissionRegistry,
                                request: UnimakerProductPublishRequest,
                                taskId: str,
                                epochSeconds: int64): Result[UnimakerProductPublishSubmitResult] =
    let bundleRes = UnimakerProductPublishCompile(request)
    if !bundleRes.ok:
        return unimakerSubmitErr(bundleRes.err.msg)
    return unimakerProductPublishSubmitBundle(edge,
                                             ledger,
                                             registry,
                                             bundleRes.value,
                                             taskId,
                                             epochSeconds)

fn UnimakerProductPublishSubmitSigned(edge: var edge_agent.UnimakerAgent,
                                      ledger: var UnimakerProductPublishLedger,
                                      registry: var discovery.VexaAdmissionRegistry,
                                      request: UnimakerProductSignedPublishRequest,
                                      taskId: str,
                                      epochSeconds: int64): Result[UnimakerProductPublishSubmitResult] =
    let bundleRes = UnimakerProductPublishCompileSigned(request)
    if !bundleRes.ok:
        return unimakerSubmitErr(bundleRes.err.msg)
    return unimakerProductPublishSubmitBundle(edge,
                                             ledger,
                                             registry,
                                             bundleRes.value,
                                             taskId,
                                             epochSeconds)
