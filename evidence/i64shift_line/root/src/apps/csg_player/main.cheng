# Per frame: compute each dock instance's world pose from the live body
# quaternion (pos = body pos + R(q_body)·cvec, quat = q_body (x) Rz(theta)
# — the DuckDrawOneMesh math collected into the table).
@borrows
fn DuckMeshInstancesBuild(w: world3d.World3d) =
    var i: int32 = 0
    while i < DuckMeshInstCount:
        let link: int32 = duckInstLink[i]
        let bw: float64 = w.bodyQuatW[link]
        let bx: float64 = w.bodyQuatX[link]
        let by: float64 = w.bodyQuatY[link]
        let bz: float64 = w.bodyQuatZ[link]
        var rx: float64
        var ry: float64
        var rz2: float64
        DuckQuatRotatePoint(bw, bx, by, bz, duckInstCx[i] * 0.001, duckInstCy[i] * 0.001, duckInstCz[i] * 0.001, rx, ry, rz2)
        duckInstPx[i] = w.bodyPx[link] + rx
        duckInstPy[i] = w.bodyPy[link] + ry
        duckInstPz[i] = w.bodyPz[link] + rz2
        let dw: float64 = m.cosFloat(duckInstTheta[i] * 0.5)
        let dz2: float64 = m.sinFloat(duckInstTheta[i] * 0.5)
        duckInstQw[i] = bw * dw - bz * dz2
        duckInstQx[i] = bx * dw + by * dz2
        duckInstQy[i] = by * dw - bx * dz2
        duckInstQz[i] = bz * dw + bw * dz2
        i = i + 1

# Per frame, after the pose build: frustum-mark each instance against
# the camera using the mesh's bounding sphere (center = instance pos,
# radius = the max half extent of the handle). Hidden instances cost
# nothing in the GPU batch or the CPU fallback.
@borrows
fn DuckMeshInstancesMarkHidden(cam: camera.CinemaCamera) =
    var i: int32 = 0
    while i < DuckMeshInstCount:
        duckInstHidden[i] = 1
        let h: int32 = duckInstHandle[i]
        let hx: float64 = mesh_render.MeshHalfExtentX(duckMeshHandles[h])
        let hy: float64 = mesh_render.MeshHalfExtentY(duckMeshHandles[h])
        let hz: float64 = mesh_render.MeshHalfExtentZ(duckMeshHandles[h])
        var rad: float64 = hx
        if hy > rad:
            rad = hy
        if hz > rad:
            rad = hz
        let proj = camera.CameraProject(cam, duckInstPx[i], duckInstPy[i], duckInstPz[i])
        if proj.depth > 0.05:
            let pixelR: float64 = rad * cam.focalPx / proj.depth
            if proj.sx + pixelR >= 0.0:
                if proj.sx - pixelR <= float64(PlayerWidth):
                    if proj.sy + pixelR >= 0.0:
                        if proj.sy - pixelR <= float64(PlayerHeight):
                            duckInstHidden[i] = 0
        i = i + 1

# CPU fallback draw of the instance table (GPU batch unavailable)
@borrows
fn DuckDrawMeshInstancesCpu(t: raster.RasterTarget,
                            cam: camera.CinemaCamera) =
    var i: int32 = 0
    while i < DuckMeshInstCount:
        if duckInstHidden[i] == 0:
            mesh_render.MeshRasterFrameOrient(t, cam, duckMeshHandles[duckInstHandle[i]], duckInstPx[i], duckInstPy[i], duckInstPz[i], 1.0, duckInstQw[i], duckInstQx[i], duckInstQy[i], duckInstQz[i], duckInstR[i], duckInstG[i], duckInstB[i])
        i = i + 1

# Leg-fold diagnostic: the angle in DEGREES between the world-frame
# capsule axes of two joined links (world axis = local +Z through the
# body quaternion, the impostor convention). acos via the shared
# joint-motor bisection (no std acos).
@borrows
fn DuckLinkAxisAngleDeg(w: world3d.World3d, a: int32, b: int32): float64 =
    let axa = 2.0 * (w.bodyQuatX[a] * w.bodyQuatZ[a] + w.bodyQuatW[a] * w.bodyQuatY[a])
    let aya = 2.0 * (w.bodyQuatY[a] * w.bodyQuatZ[a] - w.bodyQuatW[a] * w.bodyQuatX[a])
    let aza = 1.0 - 2.0 * (w.bodyQuatX[a] * w.bodyQuatX[a] + w.bodyQuatY[a] * w.bodyQuatY[a])
    let bxb = 2.0 * (w.bodyQuatX[b] * w.bodyQuatZ[b] + w.bodyQuatW[b] * w.bodyQuatY[b])
    let byb = 2.0 * (w.bodyQuatY[b] * w.bodyQuatZ[b] - w.bodyQuatW[b] * w.bodyQuatX[b])
    let bzb = 1.0 - 2.0 * (w.bodyQuatX[b] * w.bodyQuatX[b] + w.bodyQuatY[b] * w.bodyQuatY[b])
    let dot = axa * bxb + aya * byb + aza * bzb
    let cc = m.clampFloat(dot, -1.0, 1.0)
    return joint_motor.jointMotorAcos(cc) * 57.29577951308232

# Load the 7 MICRODUCK official meshes into the handle table; any
# structural failure marks the whole table invalid (the renderer falls
# back, no startup crash - the spectator mode must survive a missing
# asset and keep the physics contract measurable).
fn DuckMeshesLoad() =
    setLen(duckMeshHandles, DuckMeshHandleCount)
    duckMeshHandles[DuckMeshIdxTrunk] = mesh_render.MeshStlLoad(DuckMeshPathTrunk)
    duckMeshHandles[DuckMeshIdxBearing] = mesh_render.MeshStlLoad(DuckMeshPathBearing)
    duckMeshHandles[DuckMeshIdxUpperLeg] = mesh_render.MeshStlLoad(DuckMeshPathUpperLeg)
    duckMeshHandles[DuckMeshIdxFoot] = mesh_render.MeshStlLoad(DuckMeshPathFoot)
    duckMeshHandles[DuckMeshIdxAnkle] = mesh_render.MeshStlLoad(DuckMeshPathAnkle)
    duckMeshHandles[DuckMeshIdxHeadShell] = mesh_render.MeshStlLoad(DuckMeshPathHeadShell)
    duckMeshHandles[DuckMeshIdxFace] = mesh_render.MeshStlLoad(DuckMeshPathFace)
    duckMeshHandles[DuckMeshIdxHeadTop] = mesh_render.MeshStlLoad(DuckMeshPathHeadTop)
    duckMeshHandles[DuckMeshIdxMouth] = mesh_render.MeshStlLoad(DuckMeshPathMouth)
    duckMeshHandles[DuckMeshIdxJaw] = mesh_render.MeshStlLoad(DuckMeshPathJaw)
    duckMeshHandles[DuckMeshIdxShellL] = mesh_render.MeshStlLoad(DuckMeshPathShellL)
    duckMeshHandles[DuckMeshIdxShellR] = mesh_render.MeshStlLoad(DuckMeshPathShellR)
    duckMeshHandles[DuckMeshIdxHip] = mesh_render.MeshStlLoad(DuckMeshPathHip)
    duckMeshHandles[DuckMeshIdxXl330] = mesh_render.MeshStlLoad(DuckMeshPathXl330)
    duckMeshHandles[DuckMeshIdxLeg] = mesh_render.MeshStlLoad(DuckMeshPathLeg)
    duckMeshHandles[DuckMeshIdxSole] = mesh_render.MeshStlLoad(DuckMeshPathSole)
    duckMeshOk = mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxTrunk]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxBearing]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxUpperLeg]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxFoot]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxAnkle]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxHeadShell]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxFace]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxHeadTop]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxMouth]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxJaw]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxShellL]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxShellR]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxHip]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxXl330]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxLeg]) and mesh_render.MeshValid(duckMeshHandles[DuckMeshIdxSole])

# The live world bodies: the MICRODUCK official STL meshes docked to the
# engine link frames (the duck_film DrawDuckMeshes mapping verbatim),
# each riding the live FULL body quaternion through
# mesh_render.MeshRasterFrameOrient (scale 1.0, official urdf palette);
# the meshless links stay dark capsule impostors. The ball is one
# sphere in the milestone orange. Fallback (STL load failed at
# startup): the legacy multi-sphere pass - each capsule link shaded
# spheres spaced <= 0.6r along the capsule axis riding the live body
# quaternion; head/torso warm yellow, links gray-blue, ball orange.
@borrows
fn DrawDuckBodies(t: raster.RasterTarget,
                  cam: camera.CinemaCamera,
                  w: world3d.World3d,
                  ballSlot: int32,
                  skipMeshes: bool,
                  impostorAll: bool,
                  vqw: float64,
                  vqx: float64,
                  vqy: float64,
                  vqz: float64) =
    if duckMeshOk:
        if impostorAll:
            # far-camera LOD: every link as cheap bounding spheres (the
            # official palette), the ball below keeps the full seam shader
            var i2: int32 = 0
            while i2 < w.count:
                if i2 != ballSlot:
                    var cr2: int32 = 185
                    var cg2: int32 = 185
                    var cb2: int32 = 200
                    if i2 == mm.MicroduckLinkTorso:
                        cr2 = 250
                        cg2 = 205
                        cb2 = 70
                    if i2 == mm.MicroduckAssemblyLinkHead:
                        cr2 = 250
                        cg2 = 205
                        cb2 = 70
                    if i2 == DuckLinkFootL:
                        cr2 = DuckColorOrangeR
                        cg2 = DuckColorOrangeG
                        cb2 = DuckColorOrangeB
                    if i2 == DuckLinkFootR:
                        cr2 = DuckColorOrangeR
                        cg2 = DuckColorOrangeG
                        cb2 = DuckColorOrangeB
                    let h2: float64 = w.bodyCapsuleHalf[i2]
                    let r2: float64 = w.bodyRadius[i2]
                    if h2 > 0.0:
                        let ax2 = 2.0 * (w.bodyQuatX[i2] * w.bodyQuatZ[i2] + w.bodyQuatW[i2] * w.bodyQuatY[i2])
                        let ay2 = 2.0 * (w.bodyQuatY[i2] * w.bodyQuatZ[i2] - w.bodyQuatW[i2] * w.bodyQuatX[i2])
                        let az2 = 1.0 - 2.0 * (w.bodyQuatX[i2] * w.bodyQuatX[i2] + w.bodyQuatY[i2] * w.bodyQuatY[i2])
                        let step2: float64 = r2 * 0.6
                        let nSteps2: int32 = int32(h2 / step2) + 1
                        var k2: int32 = 0 - nSteps2
                        while k2 <= nSteps2:
                            let t3: float64 = float64(k2) * step2
                            if t3 <= h2:
                                raster.RasterSphere(t, cam, w.bodyPx[i2] - ax2 * t3, w.bodyPy[i2] - ay2 * t3, w.bodyPz[i2] - az2 * t3, r2, cr2, cg2, cb2)
                            k2 = k2 + 1
                    else:
                        raster.RasterSphere(t, cam, w.bodyPx[i2], w.bodyPy[i2], w.bodyPz[i2], r2, cr2, cg2, cb2)
                i2 = i2 + 1
        else:
            if !skipMeshes:
                DuckDrawMeshInstancesCpu(t, cam)
            # shinL / shinR: no shipped mesh - dark capsule impostor
            DuckDrawLinkImpostor(t, cam, w.bodyPx[DuckLinkShinL], w.bodyPy[DuckLinkShinL], w.bodyPz[DuckLinkShinL], w.bodyQuatW[DuckLinkShinL], w.bodyQuatX[DuckLinkShinL], w.bodyQuatY[DuckLinkShinL], w.bodyQuatZ[DuckLinkShinL], 0.008, 0.024)
            DuckDrawLinkImpostor(t, cam, w.bodyPx[DuckLinkShinR], w.bodyPy[DuckLinkShinR], w.bodyPz[DuckLinkShinR], w.bodyQuatW[DuckLinkShinR], w.bodyQuatX[DuckLinkShinR], w.bodyQuatY[DuckLinkShinR], w.bodyQuatZ[DuckLinkShinR], 0.008, 0.024)
            # neck chain: no shipped meshes - dark capsule impostors
            DuckDrawLinkImpostor(t, cam, w.bodyPx[DuckLinkNeck], w.bodyPy[DuckLinkNeck], w.bodyPz[DuckLinkNeck], w.bodyQuatW[DuckLinkNeck], w.bodyQuatX[DuckLinkNeck], w.bodyQuatY[DuckLinkNeck], w.bodyQuatZ[DuckLinkNeck], 0.014, 0.026)
            DuckDrawLinkImpostor(t, cam, w.bodyPx[DuckLinkHeadPitch], w.bodyPy[DuckLinkHeadPitch], w.bodyPz[DuckLinkHeadPitch], w.bodyQuatW[DuckLinkHeadPitch], w.bodyQuatX[DuckLinkHeadPitch], w.bodyQuatY[DuckLinkHeadPitch], w.bodyQuatZ[DuckLinkHeadPitch], 0.006, 0.008)
            DuckDrawLinkImpostor(t, cam, w.bodyPx[DuckLinkHeadYaw], w.bodyPy[DuckLinkHeadYaw], w.bodyPz[DuckLinkHeadYaw], w.bodyQuatW[DuckLinkHeadYaw], w.bodyQuatX[DuckLinkHeadYaw], w.bodyQuatY[DuckLinkHeadYaw], w.bodyQuatZ[DuckLinkHeadYaw], 0.008, 0.010)
        # the ball: real-basketball render (orange leather, seam grooves
        # riding the render-layer visual attitude quaternion)
        raster.RasterBasketball(t, cam, w.bodyPx[ballSlot], w.bodyPy[ballSlot], w.bodyPz[ballSlot], w.bodyRadius[ballSlot], vqw, vqx, vqy, vqz, DuckBallBaseR, DuckBallBaseG, DuckBallBaseB, DuckBallGrooveR, DuckBallGrooveG, DuckBallGrooveB)
    else:
        var i: int32 = 0
        while i < w.count:
            var cr: int32 = 185
            var cg: int32 = 185
            var cb: int32 = 200
            if i == ballSlot:
                cr = 220
                cg = 120
                cb = 40
            if i == mm.MicroduckLinkTorso:
                cr = 250
                cg = 205
                cb = 70
            if i == mm.MicroduckAssemblyLinkHead:
                cr = 250
                cg = 205
                cb = 70
            let h: float64 = w.bodyCapsuleHalf[i]
            let r: float64 = w.bodyRadius[i]
            if h > 0.0:
                let ax = 2.0 * (w.bodyQuatX[i] * w.bodyQuatZ[i] + w.bodyQuatW[i] * w.bodyQuatY[i])
                let ay = 2.0 * (w.bodyQuatY[i] * w.bodyQuatZ[i] - w.bodyQuatW[i] * w.bodyQuatX[i])
                let az = 1.0 - 2.0 * (w.bodyQuatX[i] * w.bodyQuatX[i] + w.bodyQuatY[i] * w.bodyQuatY[i])
                let step: float64 = r * 0.6
                let nSteps: int32 = int32(h / step) + 1
                var k: int32 = 0 - nSteps
                while k <= nSteps:
                    let t2: float64 = float64(k) * step
                    if t2 <= h:
                        raster.RasterSphere(t, cam, w.bodyPx[i] - ax * t2, w.bodyPy[i] - ay * t2, w.bodyPz[i] - az * t2, r, cr, cg, cb)
                    k = k + 1
            else:
                raster.RasterSphere(t, cam, w.bodyPx[i], w.bodyPy[i], w.bodyPz[i], r, cr, cg, cb)
            i = i + 1

# Duck-mode overlay: key hints top left, camera status top right, live
# SURVIVE tick counter + BALL DRIFT mm top center; on game over the big
# center banner replaces them.
@borrows
fn DrawDuckHud(t: raster.RasterTarget,
               survived: int64,
               driftMm: float64,
               gameOver: bool,
               camN: int32,
               followOn: bool,
               fpvOn: bool,
               orbOn: bool,
               fpsShown: int32) =
    gui_text.RasterText(t, 8, 8, 2, "1-3 CAM | C FOLLOW | F FIRST-PERSON | V ORBIT | ARROWS LOOK | W/S DOLLY | A/D LEAN | R RESTART | ESC QUIT", 255, 255, 255)
    var statusText: str = "FPS=" + strings.IntToStr(fpsShown) + " CAM=" + strings.IntToStr(camN)
    if fpvOn:
        statusText = statusText + " FPV"
    if orbOn:
        statusText = statusText + " ORBIT"
    if followOn:
        statusText = statusText + " FOLLOW"
    if duckGroundSpawn:
        statusText = statusText + " GROUND"
    let statusW: int32 = gui_text.TextPixelWidth(statusText, 2)
    gui_text.RasterText(t, PlayerWidth - statusW - 8, 28, 2, statusText, 255, 255, 255)
    if gameOver:
        let overText: str = "GAME OVER  survived=" + strings.Int64ToStr(survived)
        let overW: int32 = gui_text.TextPixelWidth(overText, 4)
        gui_text.RasterText(t, (PlayerWidth - overW) / 2, PlayerHeight / 2 - 30, 4, overText, 255, 80, 80)
        let hintText: str = "R RESTART | ESC QUIT"
        let hintW: int32 = gui_text.TextPixelWidth(hintText, 2)
        gui_text.RasterText(t, (PlayerWidth - hintW) / 2, PlayerHeight / 2 + 30, 2, hintText, 255, 255, 255)
    else:
        let survText: str = "SURVIVE " + strings.Int64ToStr(survived)
        let survW: int32 = gui_text.TextPixelWidth(survText, 2)
        gui_text.RasterText(t, (PlayerWidth - survW) / 2, 30, 2, survText, 120, 255, 120)
        let driftText: str = "BALL DRIFT " + DuckFmtMm(driftMm) + " mm"
        let driftW: int32 = gui_text.TextPixelWidth(driftText, 2)
        gui_text.RasterText(t, (PlayerWidth - driftW) / 2, 52, 2, driftText, 255, 255, 255)

# clear-free frame push (the caller painted ground+wall already): duck
# bodies + HUD, then push the surface through the drawlist.
@borrows
fn DuckFrameBack(t: raster.RasterTarget,
                 cam: camera.CinemaCamera,
                 w: world3d.World3d,
                 ballSlot: int32,
                 dlist: ptr,
                 canvas: ptr,
                 survived: int64,
                 driftMm: float64,
                 gameOver: bool,
                 camN: int32,
                 followOn: bool,
                 fpvOn: bool,
                 orbOn: bool,
                 fpsShown: int32,
                 meshesDone: bool,
                 impostorAll: bool,
                 vqw: float64,
                 vqx: float64,
                 vqy: float64,
                 vqz: float64) =
    DrawDuckBodies(t, cam, w, ballSlot, meshesDone, impostorAll, vqw, vqx, vqy, vqz)
    DrawDuckHud(t, survived, driftMm, gameOver, camN, followOn, fpvOn, orbOn, fpsShown)
    gui.DrawListClearPtr(dlist)
    gui.DrawListPushBGRAPtr(dlist, 0, 0, PlayerWidth, PlayerHeight, rawbytes.BytesDataPtr(t.frame.bgra))
    gui.DrawListCanvasSetListPtr(canvas, dlist)

# Sole-plate attach (DUCK_FOOT_PLATE=1): 4 welded pad spheres (2 per
# foot, toe/heel) giving the pitch/roll restoring couples the capsule
# line contact lacks. Shared by the interactive build AND the standeval
# rollout — the plate is part of the training plant, and a path that
# skips it silently trains a bare-foot policy on a plated gate.
fn DuckPlateAttach(w: var World3d) =
    if duckFootPlate:
        # pad mass budget: each 6.3 g pad is carved out of its foot so
        # the robot total stays at the MJCF sum — a 2 g pad cannot carry
        # a stiff contact at 240 Hz (k*dt^2/m explodes past the explicit
        # stability bound; measured 46-tick stall)
        if w.bodyInvMass[5] > 0.0:
            w.bodyInvMass[5] = 1.0 / (1.0 / w.bodyInvMass[5] - 0.0126)
        if w.bodyInvMass[10] > 0.0:
            w.bodyInvMass[10] = 1.0 / (1.0 / w.bodyInvMass[10] - 0.0126)
        # sole plate: two welded pad spheres per foot (toe/heel at
        # +-20 mm along the foot's forward axis) — the 4-point support
        # gives the pitch/roll restoring couples the round capsule line
        # contact structurally lacks; spawned after the ball so the
        # assembly slot contract stays untouched
        let tauNeck = mm.MicroduckTauMaxNeckNm
        let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
        let plateOffM: int32 = ParseDigits(os.GetEnvDefault("DUCK_PLATE_OFF_MM", "20"))
        let plateOff: float64 = float64(plateOffM) / 1000.0
        let _s1 = DuckSpawnSolePad(w, mm.MicroduckLinkFootL, plateOff, tauNeck, omegaRadS)
        let _s2 = DuckSpawnSolePad(w, mm.MicroduckLinkFootL, 0.0 - plateOff, tauNeck, omegaRadS)
        let _s3 = DuckSpawnSolePad(w, mm.MicroduckLinkFootR, plateOff, tauNeck, omegaRadS)
        let _s4 = DuckSpawnSolePad(w, mm.MicroduckLinkFootR, 0.0 - plateOff, tauNeck, omegaRadS)

# One full episode build (the PlayWorldBuild shape): session counters
# reset + world reset + the probe stance assembly + ball injection +
# release-pose freeze. The servo state is initialized by the caller
# directly at the probe call shape (one BallServoRigidStateInit per
# episode owner, gated by DuckBallServoOn); called once per episode.
@borrows
fn DuckEpisodeBuild(w: var World3d,
                    sess: var DuckSession): int32 =
    DuckSessionReset(sess)
    var ballSlot: int32 = 0
    if duckGroundSpawn:
        # ground locomotion mode: the stance builder places the sole
        # plane at the given root height — the floor, 0.7 m +X of the
        # ball (the jump-on target keeps its home spot)
        ballSlot = DuckAssemble(w, DuckGroundRootX, DuckGroundRootY, DuckGroundRootZ)
    else:
        ballSlot = DuckAssemble(w, DuckBallCenterX, DuckBallCenterY, DuckRootZ)
    DuckPlateAttach(w)
    sess.torsoZ0 = w.bodyPz[mm.MicroduckLinkTorso]
    if duckResidEcho:
        # spawn statics: total COM vs the capsule-foot contact support
        # range — the forward-topple discriminator (the model plate
        # margins 20.7/20.1 mm shrink to the capsule halfLen under the
        # engine's capsule-foot approximation)
        var mt: float64 = 0.0
        var cx: float64 = 0.0
        var cy: float64 = 0.0
        var cz: float64 = 0.0
        var mi: int32 = 0
        while mi < w.count:
            if w.bodyInvMass[mi] > 0.0:
                let m = 1.0 / w.bodyInvMass[mi]
                mt = mt + m
                cx = cx + m * w.bodyPx[mi]
                cy = cy + m * w.bodyPy[mi]
                cz = cz + m * w.bodyPz[mi]
            mi = mi + 1
        cx = cx / mt
        cy = cy / mt
        cz = cz / mt
        echo("spawn statics: bodies=" + strings.IntToStr(w.count) + " mass=" + DuckFmtMm(mt * 1000.0) + "g com=(" + DuckFmtMm(cx * 1000.0) + "," + DuckFmtMm(cy * 1000.0) + "," + DuckFmtMm(cz * 1000.0) + ")mm")
        var fi: int32 = 0
        while fi < w.count:
            if w.bodyKind[fi] == world3d.World3dBodyCapsuleRigid:
                if w.bodyCapsuleHalf[fi] > 0.0:
                    let h = w.bodyCapsuleHalf[fi]
                    let ax = 2.0 * (w.bodyQuatX[fi] * w.bodyQuatZ[fi] + w.bodyQuatW[fi] * w.bodyQuatY[fi])
                    let ay = 2.0 * (w.bodyQuatY[fi] * w.bodyQuatZ[fi] - w.bodyQuatW[fi] * w.bodyQuatX[fi])
                    let az = 1.0 - 2.0 * (w.bodyQuatX[fi] * w.bodyQuatX[fi] + w.bodyQuatY[fi] * w.bodyQuatY[fi])
                    if w.bodyPz[fi] < 0.060:
                        echo("spawn foot i=" + strings.IntToStr(fi) + " com=(" + DuckFmtMm(w.bodyPx[fi] * 1000.0) + "," + DuckFmtMm(w.bodyPy[fi] * 1000.0) + "," + DuckFmtMm(w.bodyPz[fi] * 1000.0) + ") axis=(" + DuckFmtMm(ax) + "," + DuckFmtMm(ay) + "," + DuckFmtMm(az) + ") half=" + DuckFmtMm(h * 1000.0) + " yspan=[" + DuckFmtMm((w.bodyPy[fi] - h * (0.0 - ay)) * 1000.0) + "," + DuckFmtMm((w.bodyPy[fi] + h * ay) * 1000.0) + "] r=" + DuckFmtMm(w.bodyRadius[fi] * 1000.0))
            fi = fi + 1
    sess.ballX0 = w.bodyPx[ballSlot]
    sess.ballY0 = w.bodyPy[ballSlot]
    return ballSlot

# One duckmode episode: build once (the probe one-owner-per-episode
# shape: a single unconditional build + servo init at the top, Tick in
# the loop), run the interactive window loop, echo the buffered trace
# and the verdict. Returns 0 = finished (verdict line printed), 1 =
# failed (verdict line printed), 2 = R restart requested (no verdict —
# the caller starts a fresh episode).
fn DuckEpisode(): int32 =
    var w: world3d.World3d
    var sess: DuckSession
    let torsoSlot: int32 = mm.MicroduckLinkTorso
    let headSlot: int32 = mm.MicroduckLinkHead
    var st: bsr.BallServoRigidState
    var ballSlot: int32 = DuckEpisodeBuild(w, sess)
    # arm the ball-frame rigid servo at the release pose — the
    # microduck_ball_probe caseB wiring verbatim (frozen N1 defaults),
    # the probe's direct one-init-per-owner call shape; DuckBallServoOn
    # is the master switch (see the section header)
    if DuckBallServoOn and !duckGroundSpawn:
        bsr.BallServoRigidStateInit(st, w, ballSlot, torsoSlot, headSlot,
            bsr.BallServoRigidDefaultK, bsr.BallServoRigidDefaultC,
            bsr.BallServoRigidDefaultLinCapMps, bsr.BallServoRigidDefaultLinDampCapMps,
            bsr.BallServoRigidDefaultKAng, bsr.BallServoRigidDefaultCAng,
            bsr.BallServoRigidDefaultAngCapRadS, bsr.BallServoRigidDefaultAngDampCapRadS,
            bsr.BallServoRigidDefaultRampTicks)
        # pair station-keeping: anchor at the spawn position. SIGN
        # (measured): leaning DRIVES the pair in the lean direction, so
        # the home bias is the negated displacement/velocity — the duck
        # leans away from a drift and the pair rolls back home.
        bsr.BallServoRigidSetAnchor(st, w, 0.06, 0.7)
    echo("DUCKMODE bodies=" + strings.IntToStr(w.count) + " constraints=" + strings.IntToStr(w.conCount) + " ball_r_mm=" + DuckFmtMm(DuckBallRadiusM * 1000.0) + " ball_m_g=" + DuckFmtMm(DuckBallMassKg * 1000.0) + " torsoZ0_mm=" + DuckFmtMm(sess.torsoZ0 * 1000.0))
    # numeric trace buffers (echoed after the loop, probe contract)
    var recTick: int64[]
    setLen(recTick, DuckTraceCount)
    var recTorsoZ: float64[]
    setLen(recTorsoZ, DuckTraceCount)
    var recHeadZ: float64[]
    setLen(recHeadZ, DuckTraceCount)
    var recDrift: float64[]
    setLen(recDrift, DuckTraceCount)
    var recArmed: int32[]
    setLen(recArmed, DuckTraceCount)
    # ball rolling diagnostics: center speed, spin, ground-contact slip
    var recBallV: float64[]
    var recBallW: float64[]
    var recBallSlip: float64[]
    setLen(recBallV, DuckTraceCount)
    setLen(recBallW, DuckTraceCount)
    setLen(recBallSlip, DuckTraceCount)
    # leg-fold diagnostics: hip (yoke-thigh) and knee (thigh-shin) axis
    # angles in degrees, L/R — the squat ratchet signature
    var recHipL: float64[]
    var recHipR: float64[]
    var recKneeL: float64[]
    var recKneeR: float64[]
    setLen(recHipL, DuckTraceCount)
    setLen(recHipR, DuckTraceCount)
    setLen(recKneeL, DuckTraceCount)
    setLen(recKneeR, DuckTraceCount)
    # fine standing diagnostics: the first 120 ticks tick-by-tick —
    # torso up.z + z, the four leg-pitch measured angles, and both foot
    # plate bottoms (z minus radius) — echoed only on game over
    var dUp: float64[]
    var dTz: float64[]
    var dHipL: float64[]
    var dHipR: float64[]
    var dKneeL: float64[]
    var dKneeR: float64[]
    var dAnkL: float64[]
    var dAnkR: float64[]
    var dFootL: float64[]
    var dFootR: float64[]
    var dVy: float64[]
    var dVx: float64[]
    setLen(dUp, 400)
    setLen(dTz, 400)
    setLen(dHipL, 400)
    setLen(dHipR, 400)
    setLen(dKneeL, 400)
    setLen(dKneeR, 400)
    setLen(dAnkL, 400)
    setLen(dAnkR, 400)
    setLen(dFootL, 400)
    setLen(dFootR, 400)
    setLen(dVy, 400)
    setLen(dVx, 400)
    var dN: int32 = 0
    # tick cap: DUCKMODE_TICKS=<n> override for the deterministic
    # acceptance run, else the interactive-session bound; a capped run
    # also exits at game over instead of idling on the banner
    let capText: str = os.GetEnvDefault("DUCKMODE_TICKS", "")
    var tickCap: int64 = int64(DuckTickCapDefault)
    var capSet: bool = false
    if capText.len > 0:
        let cv: int32 = ParseDigits(capText)
        if cv > 0:
            tickCap = int64(cv)
            capSet = true
    echo("DUCKMODE tick_cap=" + strings.Int64ToStr(tickCap))
    # PPM spot-check hook (deterministic acceptance): DUCKMODE_PPM=<path>
    # writes the first rendered frame's raster target once, then keeps
    # running (read once here, outside the physics loop)
    let duckPpmPath: str = os.GetEnvDefault("DUCKMODE_PPM", "")
    gui.Init()
    let win: ptr = gui.WindowCreatePtr("csg duck", PlayerWidth, PlayerHeight)
    let canvas: ptr = gui.DrawListCanvasCreatePtr(0, 0, PlayerWidth, PlayerHeight)
    let dlist: ptr = gui.DrawListNewPtr(4)
    gui.DrawListCanvasSetListPtr(canvas, dlist)
    gui.WindowAddViewPtr(win, canvas)
    gui.WindowShowPtr(win)
    # two raster targets rotating as display surfaces A/B (GPU ground+
    # wall+depth into the back group, CPU adds duck+HUD; CPU fallback
    # targets keep the run alive when no Metal device exists)
    let gpu: gpu_raster.GpuRaster = gpu_raster.GpuRasterInit(PlayerWidth, PlayerHeight)
    var gpuOk: bool = gpu.ok
    if gpuOk:
        echo("gpu raster ready")
    else:
        echo("gpu raster unavailable stage=" + strings.IntToStr(gpu.failStage) + ", cpu path")
    # GPU mesh batch pipeline (one dispatch for all 11 dock instances);
    # failure falls back to the CPU mesh path per frame
    let meshGpuRc: int32 = mesh_render.MeshGpuInit(PlayerWidth, PlayerHeight)
    var meshGpuReady: bool = meshGpuRc == 0
    if meshGpuReady:
        echo("mesh gpu batch ready")
    else:
        echo("mesh gpu unavailable stage=" + strings.IntToStr(meshGpuRc) + ", cpu mesh path")
    var surfA: raster.RasterTarget
    var surfB: raster.RasterTarget
    if gpuOk:
        surfA = raster.RasterAdoptViews(PlayerWidth, PlayerHeight, gpu_raster.GpuRasterBgraPtr(gpu, true), gpu_raster.GpuRasterDepthPtr(gpu, true))
        surfB = raster.RasterAdoptViews(PlayerWidth, PlayerHeight, gpu_raster.GpuRasterBgraPtr(gpu, false), gpu_raster.GpuRasterDepthPtr(gpu, false))
    else:
        surfA = raster.RasterMake(PlayerWidth, PlayerHeight)
        surfB = raster.RasterMake(PlayerWidth, PlayerHeight)
    var useSurfA: bool = false
    var camN: int32 = 1
    var followOn: bool = false
    var followInit: bool = false
    # WoW-style camera state: FPV/orbit share (yaw,pitch) so switching
    # modes continues the same sight line
    var fpvOn: bool = false
    var orbOn: bool = false
    var camYaw: float64 = DuckCamYaw0
    var camPitch: float64 = DuckCamPitch0
    var orbDist: float64 = DuckOrbitDist0
    # held-key deadlines (ns, refreshed by key-repeat events) + the
    # previous rendered frame's clock for the per-frame dt
    var heldLeftUntil: int64 = 0 - 1
    var heldRightUntil: int64 = 0 - 1
    var heldUpUntil: int64 = 0 - 1
    var heldDownUntil: int64 = 0 - 1
    var heldWUntil: int64 = 0 - 1
    var heldSUntil: int64 = 0 - 1
    var prevFrameNs: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    # FPS accounting: a 0.5 s window feeds the HUD number, the totals
    # feed the exit summary, and the four phase accumulators attribute
    # each frame's cost (events+camera / physics ticks / ground+wall /
    # duck+HUD+push). Scalar int64 only, echoed after the loop.
    var fpsShown: int32 = 0
    var fpsWinFrames: int32 = 0
    var fpsWinStartNs: int64 = 0
    var fpsTotalFrames: int64 = 0
    var fpsTotalNs: int64 = 0
    var nsPump: int64 = 0
    var nsPhys: int64 = 0
    var nsGpu: int64 = 0
    var nsDuck: int64 = 0
    var meshGpuFails: int32 = 0
    # tick-phase attribution (ns totals): servo vs step vs the rest of
    # the tick body, echoed once after the loop
    var nsServo: int64 = 0
    var nsStep: int64 = 0
    var nsMesh: int64 = 0
    var mPerfA: int64 = 0
    var mPerfB: int64 = 0
    var mPerfC: int64 = 0
    var mPerfD: int64 = 0
    var nInstTot: int64 = 0
    var nCopy: int64 = 0
    var fTgtX: float64
    var fTgtY: float64
    var fTgtZ: float64
    var fCamX: float64
    var fCamY: float64
    var fCamZ: float64
    var driftNow: float64
    driftNow = 0.0
    # ball visual attitude, identity at every episode build (render-layer
    # only; R restart re-enters DuckEpisode, so the restart resets it)
    var vqw: float64 = 1.0
    var vqx: float64 = 0.0
    var vqy: float64 = 0.0
    var vqz: float64 = 0.0
    var gameEnded: bool = false
    var duckPpmDumped: bool = false
    var frame: int32 = 0
    var quit: bool = false
    # ground gait oscillator phase (W latches walking)
    var gaitPhase: float64 = DuckGaitPhase0
    var gaitOn: bool = duckWalkLatch and duckGroundSpawn
    # jump sequencer: 0=idle, 1=crouch (20 ticks), 2=thrust (15), 3=recover
    var jumpPhase: int32 = 0
    var jumpTick: int32 = 0
    # env latch: fire the jump at tick 100 (deterministic acceptance)
    var jumpArmed: bool = os.GetEnvDefault("DUCK_JUMP", "") == "1"
    var jumpFired: bool = false
    var tzMax: float64 = 0.0
    while !quit and w.tick < tickCap:
        if sess.gameOver:
            if capSet:
                break
        let frameNs: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        let fpsv: int32 = FpsWindowAdvance(fpsWinFrames, fpsWinStartNs, frameNs)
        if fpsv >= 0:
            fpsShown = fpsv
        gui.ProcessFrame()
        var ev: int32 = gui.NextEvent()
        while ev != gui.EVENT_NONE:
            if ev == gui.EVENT_KEY:
                let key: int32 = gui.EventKey()
                if key == 53 or key == 12:
                    quit = true
                if key == 18 or key == 19 or key == 20:
                    camN = key - 17
                    followOn = false
                    followInit = false
                if key == 8:
                    followOn = !followOn
                    followInit = false
                if key == 15:
                    sess.restartReq = true
                # G (kVK_ANSI_G=5): toggle ground/ball spawn at restart
                if key == 5:
                    duckGroundSpawn = !duckGroundSpawn
                    sess.restartReq = true
                # Space (49): jump (ground mode only)
                if key == 49:
                    if duckGroundSpawn and jumpPhase == 0:
                        jumpPhase = 1
                        jumpTick = 0
                # W (kVK_ANSI_W=13): walk toggle (ground mode only)
                if key == 13:
                    if duckGroundSpawn:
                        gaitOn = !gaitOn
                        if !gaitOn:
                            w.conGoal[duckCiHipL] = mm.MicroduckStanceHipRad
                            w.conGoal[duckCiHipR] = mm.MicroduckStanceHipRad
                            w.conGoal[duckCiKneeL] = 0.0
                            w.conGoal[duckCiKneeR] = 0.0
                            w.conGoal[duckCiAnkleL] = 0.0 - mm.MicroduckStanceHipRad
                            w.conGoal[duckCiAnkleR] = mm.MicroduckStanceHipRad
                # WoW camera: F toggles first-person, V toggles the
                # panoramic orbit; the two are mutually exclusive
                if key == DuckKeyF:
                    fpvOn = !fpvOn
                    if fpvOn:
                        orbOn = false
                if key == DuckKeyV:
                    orbOn = !orbOn
                    if orbOn:
                        fpvOn = false
                # arrows/dolly only stamp held-deadlines here; the actual
                # rotation integrates once per rendered frame (seamless)
                if key == DuckKeyLeft:
                    heldLeftUntil = frameNs + DuckKeyHoldNs
                if key == DuckKeyRight:
                    heldRightUntil = frameNs + DuckKeyHoldNs
                if key == DuckKeyUp:
                    heldUpUntil = frameNs + DuckKeyHoldNs
                if key == DuckKeyDown:
                    heldDownUntil = frameNs + DuckKeyHoldNs
                if key == DuckKeyW:
                    heldWUntil = frameNs + DuckKeyHoldNs
                if key == DuckKeyS:
                    heldSUntil = frameNs + DuckKeyHoldNs
                # interactive lean: A (kVK_ANSI_A=0) lean left, D
                # (kVK_ANSI_D=2) lean right — tap toggles the lateral
                # impulse direction on the torso body, the servo
                # recovers, the ball rolls under the shifted COM
                if key == 0:
                    sess.leanDir = 0 - 1
                    sess.leanTicks = DuckLeanBurstTicks
                if key == 2:
                    sess.leanDir = 1
                    sess.leanTicks = DuckLeanBurstTicks
            gui.ConsumeEvent()
            ev = gui.NextEvent()
        if quit:
            break
        if sess.restartReq:
            break
        # frame-rate-continuous camera: held arrows/dolly integrate once
        # per rendered frame from the key-repeat-refreshed deadlines, so
        # a full 360-degree sweep is seamless instead of bursty; pitch is
        # kept off the poles and the dolly stays in its band (yaw wraps
        # through the trig reduction with no seam)
        var nowNs: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        var dtS: float64 = float64(nowNs - prevFrameNs) * 0.000000001
        prevFrameNs = nowNs
        if dtS > 0.1:
            dtS = 0.1
        if dtS > 0.0:
            if nowNs < heldLeftUntil:
                camYaw = camYaw + DuckCamYawRateS * dtS
            if nowNs < heldRightUntil:
                camYaw = camYaw - DuckCamYawRateS * dtS
            if nowNs < heldUpUntil:
                camPitch = camPitch + DuckCamPitchRateS * dtS
            if nowNs < heldDownUntil:
                camPitch = camPitch - DuckCamPitchRateS * dtS
            if nowNs < heldWUntil:
                orbDist = orbDist - DuckOrbitDollyRateS * dtS
            if nowNs < heldSUntil:
                orbDist = orbDist + DuckOrbitDollyRateS * dtS
        if camPitch > DuckCamPitchMax:
            camPitch = DuckCamPitchMax
        if camPitch < 0.0 - DuckCamPitchMax:
            camPitch = 0.0 - DuckCamPitchMax
        if orbDist < DuckOrbitDistMin:
            orbDist = DuckOrbitDistMin
        if orbDist > DuckOrbitDistMax:
            orbDist = DuckOrbitDistMax
        let nsIntegrated: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        # tick subloop: the probe caseB timing (servo correction first,
        # then the step); the fall/stall gates ride the loop condition.
        # A wall-time budget (min two ticks) bounds the frame cost: a
        # solver spike tick costs one long frame, not a frozen window,
        # and the sim flows at the delivered tick rate (slow-motion).
        var tk: int32 = 0
        let tb0: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        while tk < DuckFrameTicks and !sess.gameOver and sess.stallTick < 0:
            let ts0: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
            physics3d.physics3dGaitMode = 0
            if gaitOn:
                physics3d.physics3dGaitMode = 1
                gaitFreqHzM = GaitEnvOverride("GAIT_FREQ", gaitFreqHzM)
                gaitHipAmpM = GaitEnvOverride("GAIT_HIP", gaitHipAmpM)
                gaitKneeSwingM = GaitEnvOverride("GAIT_KNEE", gaitKneeSwingM)
                gaitAnkleAmpM = GaitEnvOverride("GAIT_ANKLE", gaitAnkleAmpM)
                gaitKneeLeadM = GaitEnvOverride("GAIT_LEAD", gaitKneeLeadM)
                gaitRollGainM = GaitEnvOverride("GAIT_ROLL", gaitRollGainM)
            if jumpArmed and !jumpFired and w.tick >= 100 and duckGroundSpawn:
                jumpFired = true
                jumpPhase = 1
                jumpTick = 0
            if w.tick >= 100 and w.tick <= 400:
                if w.bodyPz[mm.MicroduckLinkTorso] > tzMax:
                    tzMax = w.bodyPz[mm.MicroduckLinkTorso]
            physics3d.physics3dGaitMode = gaitOn
            if jumpPhase > 0:
                # jump sequencer overrides gait goals
                jumpTick = jumpTick + 1
                let ck = DuckJumpCrouchKneeRad
                if jumpPhase == 1:
                    # crouch: knees flex, ANKLES LOCKED at the level-
                    # sole counter-stance (a dorsiflexion goal cams the
                    # foot plate and walks the sole pole out of the
                    # support band — the v1 kick-through-air failure)
                    if jumpTick <= 40:
                        w.conGoal[duckCiKneeL] = 0.7
                        w.conGoal[duckCiKneeR] = 0.7
                        w.conGoal[duckCiAnkleL] = 0.0 - 0.4530
                        w.conGoal[duckCiAnkleR] = 0.4530
                    else:
                        jumpPhase = 2
                        jumpTick = 0
                elif jumpPhase == 2:
                    # thrust: knees snap straight, ankles hold level —
                    # the legs lengthen against the planted soles
                    w.conGoal[duckCiKneeL] = 0.0
                    w.conGoal[duckCiKneeR] = 0.0
                    if jumpTick > 40:
                        jumpPhase = 3
                        jumpTick = 0
                else:
                    # recover: back to stance
                    if jumpTick > 30:
                        w.conGoal[duckCiKneeL] = 0.0
                        w.conGoal[duckCiKneeR] = 0.0
                        w.conGoal[duckCiAnkleL] = 0.0 - mm.MicroduckStanceHipRad
                        w.conGoal[duckCiAnkleR] = mm.MicroduckStanceHipRad
                    if jumpTick > 60:
                        jumpPhase = 0
            elif gaitOn:
                DuckGaitTick(w, gaitPhase, 1.0 / 240.0)
            elif duckGroundSpawn:
                # 10 Hz goal refresh: a continuously sliding servo goal
                # keeps the hinge rows above the residual gate (the
                # refine pass re-ran its 4096-sweep budget every tick —
                # seconds per tick); the real robot's IMU loop is 100 Hz,
                # 10 Hz here is both cheaper and closer to a first-order
                # hold on the actuator side
                # roll-only balance, 10 Hz: the passive pitch stack
                # (knee preload + D-term) holds, but a slow static roll
                # leak (ankle rows asymmetrizing, up.z decaying sideways)
                # needs the yoke P; pitch stays passive (the full
                # tilt->goal loop fought the residual gate)
                # DUCK_POLICY: the trained policy owns the goal side and
                # displaces the roll-balance feedback entirely
                if duckPolicyOn == 1:
                    DuckPolicyTick(w)
                elif duckBalanceOn and (w.tick % duckRollDivN) == 0:
                    # the 10Hz throttle is a measured stabilizer, not a
                    # cost artifact: continuous roll correction pumped
                    # the stance (178 vs 376) — the sampled-hold acts as
                    # a low-pass on the sliding-goal channel
                    if duckBalFull:
                        DuckStandBalanceTick(w, 0, 0)
                    else:
                        DuckStandRollTick(w)
            if DuckBallServoOn:
                bsr.BallServoRigidTick(st, w)
            let ts1: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
            # active balance: PD controller on torso orientation.
            # Reads tilt (up vector) and angular velocity, applies
            # corrective angular velocity directly to the torso body.
            # This bypasses the servo rate cap entirely — it acts at
            # the dynamics level, the same layer as gravity.
            # UNCONDITIONAL in ground mode (the validated 241-tick
            # standing stack includes it — the DUCK_BALANCE env gates
            # the goal-side RollTick feedback, not this fixture; gating
            # it off collapsed standing to 93 ticks).
            if duckGroundSpawn and !sess.gameOver:
                let btqx = w.bodyQuatX[torsoSlot]
                let btqy = w.bodyQuatY[torsoSlot]
                let btqz = w.bodyQuatZ[torsoSlot]
                let btqw = w.bodyQuatW[torsoSlot]
                # world-frame tilt vector (small angle)
                var tx = 2.0 * (btqx * btqz + btqw * btqy)
                var ty = 2.0 * (btqy * btqz - btqw * btqx)
                if !(tx > 0.0 - 100.0) or !(tx < 100.0):
                    tx = 0.0
                if !(ty > 0.0 - 100.0) or !(ty < 100.0):
                    ty = 0.0
                # PD: kp * tilt + kd * angular_velocity
                let rollRate = w.bodyAngVx[torsoSlot]
                let pitchRate = w.bodyAngVy[torsoSlot]
                # corrective angular velocity about world x (pitch) and y (roll)
                let pdP = float64(duckPdPM) / 1000.0
                let pdD = float64(duckPdDM) / 1000.0
                w.bodyAngVx[torsoSlot] = w.bodyAngVx[torsoSlot] - pdP * ty - pdD * pitchRate
                w.bodyAngVy[torsoSlot] = w.bodyAngVy[torsoSlot] + pdP * tx + pdD * rollRate
            # interactive lean: the player's A/D shifts the torso COM,
            # the ball rolls under the shifted weight (friction coupling)
            if sess.leanDir != 0:
                w.bodyVy[torsoSlot] = w.bodyVy[torsoSlot] + float64(sess.leanDir) * DuckLeanImpulseMps
                sess.leanTicks = sess.leanTicks - 1
                if sess.leanTicks <= 0:
                    sess.leanDir = 0
            var r = physics3d.Physics3dStep(w, "duckmode")
            let ts2: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
            if duckSweepEchoOn == 1:
                if w.tick <= 8 or w.tick % 32 == 0:
                    echo("SW t=" + strings.Int64ToStr(w.tick) + " sweeps=" + strings.IntToStr(constraints3d.constraints3dSweepCountLast) + " resUm=" + strings.IntToStr(constraints3d.constraints3dResidLastUm) + " stepUs=" + strings.Int64ToStr((ts2 - ts1) / 1000))
            if duckResidEcho:
                if w.tick == 100 or w.tick == 130 or w.tick == 160:
                    var hci: int32 = 0
                    while hci < w.conCount:
                        if w.conActive[hci] == 1:
                            let gapM = constraints3d.Constraints3dJointAnchorGap(w, hci)
                            let angE = constraints3d.Constraints3dHingeAngle(w, hci) - w.conCmd[hci]
                            echo("hres t=" + strings.Int64ToStr(w.tick) + " ci=" + strings.IntToStr(hci) + " gap=" + DuckFmtMm(gapM * 1000.0) + " ang=" + DuckFmtMm(angE * 1000.0) + " cmd=" + DuckFmtMm(w.conCmd[hci] * 57.29577951308232))
                        hci = hci + 1
                if w.tick == 10 or w.tick == 30 or w.tick == 50 or w.tick == 80 or w.tick == 120:
                    echo("om t=" + strings.Int64ToStr(w.tick) + " torso=(" + DuckFmtMm(w.bodyAngVx[torsoSlot] * 1000.0) + "," + DuckFmtMm(w.bodyAngVy[torsoSlot] * 1000.0) + "," + DuckFmtMm(w.bodyAngVz[torsoSlot] * 1000.0) + ")mrad footL=(" + DuckFmtMm(w.bodyAngVx[3] * 1000.0) + "," + DuckFmtMm(w.bodyAngVy[3] * 1000.0) + "," + DuckFmtMm(w.bodyAngVz[3] * 1000.0) + ") footR=(" + DuckFmtMm(w.bodyAngVx[7] * 1000.0) + "," + DuckFmtMm(w.bodyAngVy[7] * 1000.0) + "," + DuckFmtMm(w.bodyAngVz[7] * 1000.0) + ") shL=(" + DuckFmtMm(w.bodyAngVx[2] * 1000.0) + "," + DuckFmtMm(w.bodyAngVy[2] * 1000.0) + "," + DuckFmtMm(w.bodyAngVz[2] * 1000.0) + ")")
                if w.tick == 40 or w.tick == 80 or w.tick == 120 or w.tick == 160:
                    echo("gauge lastAct=" + strings.IntToStr(constraints3d.constraints3dGaugeLastActTick) + " at t=" + strings.Int64ToStr(w.tick))
                if w.tick < 60:
                    echo("resid t=" + strings.Int64ToStr(w.tick) + " mm=" + DuckFmtMm(r.maxResidualMm) + " code=" + strings.IntToStr(r.statusCode) + " hipL cmd=" + DuckFmtMm(w.conCmd[duckCiHipL] * 57.29577951308232) + " th=" + DuckFmtMm(constraints3d.Constraints3dHingeAngle(w, duckCiHipL) * 57.29577951308232) + " kneeL cmd=" + DuckFmtMm(w.conCmd[duckCiKneeL] * 57.29577951308232) + " th=" + DuckFmtMm(constraints3d.Constraints3dHingeAngle(w, duckCiKneeL) * 57.29577951308232) + " ankL cmd=" + DuckFmtMm(w.conCmd[duckCiAnkleL] * 57.29577951308232) + " th=" + DuckFmtMm(constraints3d.Constraints3dHingeAngle(w, duckCiAnkleL) * 57.29577951308232))

            # residual-rollback stall breaker: a state whose residual
            # never converges rolls back every tick (t=128 freeze: 4.3 s
            # per step, tick pinned) — report it as game over instead of
            # spinning forever
            if r.statusCode != physics3d.Physics3dStatusOk:
                sess.rejectRun = sess.rejectRun + 1
                if sess.rejectRun > 24:
                    sess.stallTick = w.tick
                    sess.fallTick = w.tick
                    sess.survivedFinal = w.tick
                    sess.gameOver = true
            nsServo = nsServo + (ts1 - ts0)
            nsStep = nsStep + (ts2 - ts1)
            if r.statusCode != physics3d.Physics3dStatusOk:
                sess.rejected = sess.rejected + 1
                # rejectRun already counted in the stall breaker above
                if sess.firstRejectTick < 0:
                    sess.firstRejectTick = int32(w.tick)
                if sess.rejectRun > DuckStallRejectRun:
                    sess.stallTick = w.tick
            else:
                sess.rejectRun = 0
            # fine diagnostic capture (first 130 ticks, every tick)
            if dN < 400:
                let qwD = w.bodyQuatW[torsoSlot]
                let qxD = w.bodyQuatX[torsoSlot]
                let qyD = w.bodyQuatY[torsoSlot]
                dUp[dN] = 1.0 - 2.0 * (qxD * qxD + qyD * qyD)
                dTz[dN] = w.bodyPz[torsoSlot]
                dHipL[dN] = constraints3d.Constraints3dHingeAngle(w, duckCiHipL)
                dHipR[dN] = constraints3d.Constraints3dHingeAngle(w, duckCiHipR)
                dKneeL[dN] = constraints3d.Constraints3dHingeAngle(w, duckCiKneeL)
                dKneeR[dN] = constraints3d.Constraints3dHingeAngle(w, duckCiKneeR)
                dAnkL[dN] = constraints3d.Constraints3dHingeAngle(w, duckCiAnkleL)
                dAnkR[dN] = constraints3d.Constraints3dHingeAngle(w, duckCiAnkleR)
                dFootL[dN] = w.bodyPz[DuckLinkFootL] - w.bodyRadius[DuckLinkFootL]
                dFootR[dN] = w.bodyPz[DuckLinkFootR] - w.bodyRadius[DuckLinkFootR]
                dVx[dN] = w.bodyVx[torsoSlot]
                dVy[dN] = w.bodyVy[torsoSlot]
                dN = dN + 1
            let dx = w.bodyPx[ballSlot] - sess.ballX0
            let dy = w.bodyPy[ballSlot] - sess.ballY0
            driftNow = numerics.CsgSqrt(dx * dx + dy * dy)
            if driftNow > sess.driftMax:
                sess.driftMax = driftNow
            # fall = head link com below torso link com (the probe
            # upright convention; the servo latches off on the same
            # predicate, so the HUD and the servo agree), OR the torso
            # tipping over: a pitched-torso degenerate posture (face
            # down on the ball, joint angles normal) reads as alive
            # under the head/torso test while tobogganing at full lean
            if w.bodyPz[headSlot] < w.bodyPz[torsoSlot] and sess.fallTick < 0:
                var bi2: int32 = 0
                while bi2 < w.count:
                    echo("FALLBODY i=" + strings.IntToStr(bi2) + " p=" + strings.Int64ToStr(int64(w.bodyPx[bi2] * 1000.0)) + "," + strings.Int64ToStr(int64(w.bodyPy[bi2] * 1000.0)) + "," + strings.Int64ToStr(int64(w.bodyPz[bi2] * 1000.0)))
                    bi2 = bi2 + 1
            if w.bodyPz[headSlot] < w.bodyPz[torsoSlot]:
                sess.fallTick = w.tick
                sess.survivedFinal = w.tick
                sess.gameOver = true
            else:
                let qw2 = w.bodyQuatW[torsoSlot]
                let qx2 = w.bodyQuatX[torsoSlot]
                let qy2 = w.bodyQuatY[torsoSlot]
                let qz2 = w.bodyQuatZ[torsoSlot]
                let upz2 = 1.0 - 2.0 * (qx2 * qx2 + qy2 * qy2)
                if upz2 < 0.5:
                    sess.fallTick = w.tick
                    sess.survivedFinal = w.tick
                    sess.gameOver = true
            if w.tick % int64(DuckTraceStride) == 0:
                if sess.ti < DuckTraceCount:
                    let bvx: float64 = w.bodyVx[ballSlot]
                    let bvy: float64 = w.bodyVy[ballSlot]
                    let slipX: float64 = bvx - w.bodyAngVy[ballSlot] * DuckBallRadiusM
                    let slipY: float64 = bvy + w.bodyAngVx[ballSlot] * DuckBallRadiusM
                    recTick[sess.ti] = w.tick
                    recTorsoZ[sess.ti] = w.bodyPz[torsoSlot]
                    recHeadZ[sess.ti] = w.bodyPz[headSlot]
                    recDrift[sess.ti] = driftNow
                    recArmed[sess.ti] = st.armed
                    recBallV[sess.ti] = numerics.CsgSqrt(bvx * bvx + bvy * bvy)
                    recBallW[sess.ti] = numerics.CsgSqrt(w.bodyAngVx[ballSlot] * w.bodyAngVx[ballSlot] + w.bodyAngVy[ballSlot] * w.bodyAngVy[ballSlot])
                    recBallSlip[sess.ti] = numerics.CsgSqrt(slipX * slipX + slipY * slipY)
                    # leg-fold diagnostics: the angle between the capsule
                    # axes of the joined links (hip = yoke vs thigh, knee =
                    # thigh vs shin), from the world-frame capsule axes
                    recHipL[sess.ti] = DuckLinkAxisAngleDeg(w, DuckLinkYokeL, DuckLinkThighL)
                    recHipR[sess.ti] = DuckLinkAxisAngleDeg(w, DuckLinkYokeR, DuckLinkThighR)
                    recKneeL[sess.ti] = DuckLinkAxisAngleDeg(w, DuckLinkThighL, DuckLinkShinL)
                    recKneeR[sess.ti] = DuckLinkAxisAngleDeg(w, DuckLinkThighR, DuckLinkShinR)
                    sess.ti = sess.ti + 1
            tk = tk + 1
            if tk >= 2:
                let tbn: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
                if tbn - tb0 > DuckFrameBudgetNs:
                    break
        # visual attitude integration (render-layer only, scalar math):
        # world-frame ball omega over the ticks actually run this frame
        # at the fixed physics3d 1/240 s tick
        DuckBallVisualQuatStep(vqw, vqx, vqy, vqz, w.bodyAngVx[ballSlot], w.bodyAngVy[ballSlot], w.bodyAngVz[ballSlot], float64(tk) / 240.0)
        if sess.gameOver:
            if !gameEnded:
                gameEnded = true
                echo("GAME OVER survived=" + strings.Int64ToStr(sess.survivedFinal) + " fall_tick=" + strings.Int64ToStr(sess.fallTick))
                # the fine standing diagnostics: every captured tick up to
                # the fall (stride 10 for readability, last 10 raw)
                var di: int32 = 0
                while di < dN:
                    if di % 10 == 0 or di >= dN - 10:
                        echo("diag t=" + strings.IntToStr(di) + " up=" + DuckFmtMm(dUp[di]) + " tz=" + DuckFmtMm(dTz[di] * 1000.0) + " hipL=" + DuckFmtMm(dHipL[di] * 57.29577951308232) + " hipR=" + DuckFmtMm(dHipR[di] * 57.29577951308232) + " kneeL=" + DuckFmtMm(dKneeL[di] * 57.29577951308232) + " kneeR=" + DuckFmtMm(dKneeR[di] * 57.29577951308232) + " ankL=" + DuckFmtMm(dAnkL[di] * 57.29577951308232) + " ankR=" + DuckFmtMm(dAnkR[di] * 57.29577951308232) + " footL=" + DuckFmtMm(dFootL[di] * 1000.0) + " footR=" + DuckFmtMm(dFootR[di] * 1000.0) + " vx=" + DuckFmtMm(dVx[di]) + " vy=" + DuckFmtMm(dVy[di]))
                    di = di + 1
        # camera precedence: F first-person > V orbit > C follow > preset.
        # FPV: eye = head link position, target = eye + (yaw,pitch) dir.
        # Orbit: eye = torso pivot + spherical (dist,yaw,pitch), target =
        # pivot — the full-panorama free camera.
        var cam: camera.CinemaCamera
        if fpvOn:
            let ex = w.bodyPx[headSlot]
            let ey = w.bodyPy[headSlot]
            let ez = w.bodyPz[headSlot]
            let cp = m.cosFloat(camPitch)
            cam = camera.CinemaCameraLookAt(ex, ey, ez,
                ex + cp * m.cosFloat(camYaw),
                ey + cp * m.sinFloat(camYaw),
                ez + m.sinFloat(camPitch),
                DuckFollowFocal, PlayerWidth, PlayerHeight)
        elif orbOn:
            let tx = w.bodyPx[torsoSlot]
            let ty = w.bodyPy[torsoSlot]
            let tz = w.bodyPz[torsoSlot]
            let cp = m.cosFloat(camPitch)
            var eyeZ: float64 = tz + orbDist * m.sinFloat(camPitch)
            if eyeZ < DuckOrbitGroundMargin:
                eyeZ = DuckOrbitGroundMargin
            cam = camera.CinemaCameraLookAt(
                tx + orbDist * cp * m.cosFloat(camYaw),
                ty + orbDist * cp * m.sinFloat(camYaw),
                eyeZ,
                tx, ty, tz,
                DuckFollowFocal, PlayerWidth, PlayerHeight)
        elif followOn:
            let tx = w.bodyPx[torsoSlot]
            let ty = w.bodyPy[torsoSlot]
            let tz = w.bodyPz[torsoSlot]
            if !followInit:
                fTgtX = tx
                fTgtY = ty
                fTgtZ = tz
                fCamX = tx + DuckFollowOffX
                fCamY = ty + DuckFollowOffY
                fCamZ = tz + DuckFollowOffZ
                followInit = true
            fTgtX = fTgtX + (tx - fTgtX) * DuckFollowSmooth
            fTgtY = fTgtY + (ty - fTgtY) * DuckFollowSmooth
            fTgtZ = fTgtZ + (tz - fTgtZ) * DuckFollowSmooth
            fCamX = fCamX + (tx + DuckFollowOffX - fCamX) * DuckFollowSmooth
            fCamY = fCamY + (ty + DuckFollowOffY - fCamY) * DuckFollowSmooth
            fCamZ = fCamZ + (tz + DuckFollowOffZ - fCamZ) * DuckFollowSmooth
            cam = camera.CinemaCameraLookAt(fCamX, fCamY, fCamZ, fTgtX, fTgtY, fTgtZ, DuckFollowFocal, PlayerWidth, PlayerHeight)
        else:
            cam = DuckCameraFor(camN)
        var hudSurvive: int64 = w.tick
        if sess.gameOver:
            hudSurvive = sess.survivedFinal
        let nsRender0: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        if gpuOk:
            gpu_raster.GpuRasterFrame(gpu, useSurfA, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
        else:
            if useSurfA:
                raster.RasterClear(surfA)
                raster.RasterGround(surfA, cam)
                raster.RasterWallFace(surfA, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
            else:
                raster.RasterClear(surfB)
                raster.RasterGround(surfB, cam)
                raster.RasterWallFace(surfB, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
        # mesh LOD: beyond the distance gate the duck draws as cheap
        # link impostors; up close the full GPU mesh batch runs (the
        # prepass is the second per-frame cost after the solver)
        var impostorAll: bool = false
        if duckMeshOk:
            let ldx: float64 = cam.posX - w.bodyPx[mm.MicroduckLinkTorso]
            let ldy: float64 = cam.posY - w.bodyPy[mm.MicroduckLinkTorso]
            let ldz: float64 = cam.posZ - w.bodyPz[mm.MicroduckLinkTorso]
            impostorAll = fpvOn or (ldx * ldx + ldy * ldy + ldz * ldz) > DuckMeshLodDist2
        let nsRender1: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        # meshes: ONE GPU batch composite over the live surface (ground+
        # wall already painted into it); any failure falls back to the
        # CPU table draw inside DrawDuckBodies. Visible instances are
        # compacted to the array front first.
        var meshesDone: bool = false
        let nm0: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        var nInst: int64 = 0
        if duckMeshOk and meshGpuReady and !impostorAll:
            let ni0: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
            DuckMeshInstancesBuild(w)
            let ni1: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
            nInst = ni1 - ni0
            DuckMeshInstancesMarkHidden(cam)
            var nv: int32 = 0
            var ci2: int32 = 0
            while ci2 < DuckMeshInstCount:
                if duckInstHidden[ci2] == 0:
                    if nv != ci2:
                        duckInstHandle[nv] = duckInstHandle[ci2]
                        duckInstPx[nv] = duckInstPx[ci2]
                        duckInstPy[nv] = duckInstPy[ci2]
                        duckInstPz[nv] = duckInstPz[ci2]
                        duckInstQw[nv] = duckInstQw[ci2]
                        duckInstQx[nv] = duckInstQx[ci2]
                        duckInstQy[nv] = duckInstQy[ci2]
                        duckInstQz[nv] = duckInstQz[ci2]
                        duckInstR[nv] = duckInstR[ci2]
                        duckInstG[nv] = duckInstG[ci2]
                        duckInstB[nv] = duckInstB[ci2]
                    nv = nv + 1
                ci2 = ci2 + 1
            let nc0: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
            if nv > 0:
                var mrc: int32 = 0 - 1
                if useSurfA:
                    mrc = mesh_render.MeshGpuBatchOrient(cam, nv, duckInstHandle, duckInstPx, duckInstPy, duckInstPz, duckInstQw, duckInstQx, duckInstQy, duckInstQz, duckInstR, duckInstG, duckInstB, rawbytes.BytesDataPtr(surfA.frame.bgra), rawbytes.BytesDataPtr(surfA.frame.zbuf))
                else:
                    mrc = mesh_render.MeshGpuBatchOrient(cam, nv, duckInstHandle, duckInstPx, duckInstPy, duckInstPz, duckInstQw, duckInstQx, duckInstQy, duckInstQz, duckInstR, duckInstG, duckInstB, rawbytes.BytesDataPtr(surfB.frame.bgra), rawbytes.BytesDataPtr(surfB.frame.zbuf))
                if mrc == 0:
                    meshesDone = true
                let nc1: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
                nCopy = nCopy + (nc1 - nc0)
                if mrc == 0:
                    let nd0: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
                    if useSurfA:
                        mesh_render.MeshGpuCopyOutBgraPtr(rawbytes.BytesDataPtr(surfA.frame.bgra))
                        mesh_render.MeshGpuCopyOutDepthPtr(rawbytes.BytesDataPtr(surfA.frame.zbuf))
                    else:
                        mesh_render.MeshGpuCopyOutBgraPtr(rawbytes.BytesDataPtr(surfB.frame.bgra))
                        mesh_render.MeshGpuCopyOutDepthPtr(rawbytes.BytesDataPtr(surfB.frame.zbuf))
                    let nd1: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
                    nCopy = nCopy + (nd1 - nd0)
                else:
                    meshGpuFails = meshGpuFails + 1
                    if meshGpuFails == 1:
                        echo("DUCKMODE mesh batch fail code=" + strings.IntToStr(mrc) + " (falling back to cpu mesh path)")
                    # undo the in-place compaction so the CPU fallback
                    # walks the full table again
                    DuckMeshInstancesBuild(w)
                    DuckMeshInstancesMarkHidden(cam)
        elif duckMeshOk and !impostorAll:
            DuckMeshInstancesBuild(w)
            DuckMeshInstancesMarkHidden(cam)
            meshesDone = false
        else:
            meshesDone = true
        let nm1: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        nsMesh = nsMesh + (nm1 - nm0)
        nInstTot = nInstTot + nInst
        mPerfA = mPerfA + mesh_render.mrPerfA
        mPerfB = mPerfB + mesh_render.mrPerfB
        mPerfC = mPerfC + mesh_render.mrPerfC
        mPerfD = mPerfD + mesh_render.mrPerfD
        mesh_render.mrPerfA = 0
        mesh_render.mrPerfB = 0
        mesh_render.mrPerfC = 0
        mesh_render.mrPerfD = 0
        # HUD fps: 0.5 s window closed before the paint
        fpsWinFrames = fpsWinFrames + 1
        if fpsWinStartNs == 0:
            fpsWinStartNs = nsRender1
        let winLen: int64 = nsRender1 - fpsWinStartNs
        if winLen >= 500000000:
            fpsShown = int32(int64(fpsWinFrames) * 1000000000 / winLen)
            fpsWinFrames = 0
            fpsWinStartNs = 0
        if useSurfA:
            DuckFrameBack(surfA, cam, w, ballSlot, dlist, canvas, hudSurvive, driftNow, sess.gameOver, camN, followOn, fpvOn, orbOn, fpsShown, meshesDone, impostorAll, vqw, vqx, vqy, vqz)
        else:
            DuckFrameBack(surfB, cam, w, ballSlot, dlist, canvas, hudSurvive, driftNow, sess.gameOver, camN, followOn, fpvOn, orbOn, fpsShown, meshesDone, impostorAll, vqw, vqx, vqy, vqz)
        if duckPpmPath.len > 0 and !duckPpmDumped:
            if useSurfA:
                raster.RasterWritePpm(surfA, duckPpmPath)
            else:
                raster.RasterWritePpm(surfB, duckPpmPath)
            duckPpmDumped = true
            echo("DUCKMODE ppm_dump=" + duckPpmPath)
        let nsRender2: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        nsPump = nsPump + (nsIntegrated - frameNs)
        nsPhys = nsPhys + (nsRender0 - nsIntegrated)
        nsGpu = nsGpu + (nsRender1 - nsRender0)
        nsDuck = nsDuck + (nsRender2 - nsRender1)
        fpsTotalFrames = fpsTotalFrames + 1
        fpsTotalNs = fpsTotalNs + (nsRender2 - frameNs)
        useSurfA = !useSurfA
        frame = frame + 1
    gui.WindowClosePtr(win)
    # ---- buffered trace out (the physics loop is done) ----
    var k: int32 = 0
    while k < sess.ti:
        echo("duckmode t=" + strings.Int64ToStr(recTick[k]) + " torsoZ_mm=" + DuckFmtMm(recTorsoZ[k] * 1000.0) + " headZ_mm=" + DuckFmtMm(recHeadZ[k] * 1000.0) + " drift_mm=" + DuckFmtMm(recDrift[k] * 1000.0) + " ballv=" + DuckFmtMm(recBallV[k]) + " slip=" + DuckFmtMm(recBallSlip[k]) + " hipL=" + DuckFmtMm(recHipL[k]) + " hipR=" + DuckFmtMm(recHipR[k]) + " kneeL=" + DuckFmtMm(recKneeL[k]) + " kneeR=" + DuckFmtMm(recKneeR[k]))
        k = k + 1
    if sess.restartReq:
        echo("duckmode restart requested at tick " + strings.Int64ToStr(w.tick))
        return 2
    if sess.fallTick < 0:
        sess.survivedFinal = w.tick
    echo("duckmode tzMax_mm=" + DuckFmtMm(tzMax * 1000.0) + " torsoZ0_mm=" + DuckFmtMm(sess.torsoZ0 * 1000.0) + " jump=" + strings.IntToStr(int32(jumpFired)))
    echo("duckmode survived=" + strings.Int64ToStr(sess.survivedFinal) + " rejected=" + strings.IntToStr(sess.rejected) + " firstRejectTick=" + strings.IntToStr(sess.firstRejectTick) + " fall_tick=" + strings.Int64ToStr(sess.fallTick) + " stall_tick=" + strings.Int64ToStr(sess.stallTick) + " drift_max_mm=" + DuckFmtMm(sess.driftMax * 1000.0) + " torsoZ0_mm=" + DuckFmtMm(sess.torsoZ0 * 1000.0) + " frames=" + strings.IntToStr(frame))
    if fpsTotalFrames > 0:
        let fAvg: float64 = float64(fpsTotalFrames) * 1000000000.0 / float64(fpsTotalNs)
        echo("duckmode fps_avg=" + DuckFmtMm(fAvg) + " frame_ms=" + DuckFmtMm(1000.0 / fAvg) + " pump_ms=" + DuckFmtMm(float64(nsPump) * 0.000001 / float64(fpsTotalFrames)) + " phys_ms=" + DuckFmtMm(float64(nsPhys) * 0.000001 / float64(fpsTotalFrames)) + " bg_ms=" + DuckFmtMm(float64(nsGpu) * 0.000001 / float64(fpsTotalFrames)) + " duck_ms=" + DuckFmtMm(float64(nsDuck) * 0.000001 / float64(fpsTotalFrames)) + " meshgpufail=" + strings.IntToStr(meshGpuFails) + " mesh_ms=" + DuckFmtMm(float64(nsMesh) * 0.000001 / float64(fpsTotalFrames)) + " mA=" + strings.Int64ToStr(mPerfA / 1000000) + " mB=" + strings.Int64ToStr(mPerfB / 1000000) + " mC=" + strings.Int64ToStr(mPerfC / 1000000) + " mD=" + strings.Int64ToStr(mPerfD / 1000000) + " inst=" + strings.Int64ToStr(nInstTot / 1000000) + " copy=" + strings.Int64ToStr(nCopy / 1000000))
        if w.tick > 0:
            echo("duckmode tick_us servo=" + strings.Int64ToStr(nsServo / w.tick) + " step=" + strings.Int64ToStr(nsStep / w.tick) + " ticks=" + strings.Int64ToStr(w.tick))
    if sess.stallTick >= 0:
        echo("FAIL duckmode engine stall at tick " + strings.Int64ToStr(sess.stallTick) + " rejected=" + strings.IntToStr(sess.rejected) + " firstReject=" + strings.IntToStr(sess.firstRejectTick))
        return 1
    # the verdict gates the assembly + engine contract only (zero
    # rejected steps, world validity); standing is data - the fall_tick
    # field above and in the tail line - the flat-stand contract stays
    # RED until the parallel physics3d friction fix lands
    let ok: bool = sess.rejected == 0 and world3d.World3dValid(w)
    if ok:
        echo("PASS duckmode survived=" + strings.Int64ToStr(sess.survivedFinal) + " drift=" + DuckFmtMm(driftNow * 1000.0) + " fall_tick=" + strings.Int64ToStr(sess.fallTick))
        return 0
    echo("FAIL duckmode survived=" + strings.Int64ToStr(sess.survivedFinal) + " drift=" + DuckFmtMm(driftNow * 1000.0) + " fall_tick=" + strings.Int64ToStr(sess.fallTick))
    return 1

# --duckmode: watch the machine duck stand-balancing on the size-7
# basketball. R restarts by ending the episode and building a fresh one
# (fresh world, servo and window — the probe one-build-per-owner shape).
# xorshift64 PRNG (std/random unavailable in the cold chain)
var cemRngState: int64 = 0x9E3779B97F4A7C15

fn CemRandNorm(): float64 =
    # xorshift64 -> uniform [-1, 1]
    cemRngState = cemRngState ^ (cemRngState << 13)
    cemRngState = cemRngState ^ (cemRngState >> 7)
    cemRngState = cemRngState ^ (cemRngState << 17)
    let u: float64 = float64(cemRngState & 0x1FFFFFFFFFFFFF) / 9007199254740992.0
    return u * 2.0 - 1.0

# One gait evaluation at the given milli-params: assemble a fresh
# ground episode, walk up to evalTicks, return (survived, dispMm).
@borrows
fn GaitCemEvaluate(w: var World3d,
                   freqM: int32,
                   hipM: int32,
                   kneeM: int32,
                   ankM: int32,
                   leadM: int32,
                   rollM: int32,
                   evalTicks: int64,
                   outSurvived: var int64,
                   outDisp: var float64) =
    var sess: DuckSession
    var ballSlot: int32 = 0
    if duckGroundSpawn:
        ballSlot = DuckAssemble(w, DuckGroundRootX, DuckGroundRootY, DuckGroundRootZ)
    else:
        ballSlot = DuckAssemble(w, DuckBallCenterX, DuckBallCenterY, DuckRootZ)
    gaitFreqHzM = freqM
    gaitHipAmpM = hipM
    gaitKneeSwingM = kneeM
    gaitAnkleAmpM = ankM
    gaitKneeLeadM = leadM
    gaitRollGainM = rollM
    physics3d.physics3dGaitMode = 1
    var phase: float64 = DuckGaitPhase0
    var x0: float64 = w.bodyPx[mm.MicroduckLinkTorso]
    var survived: int64 = 0
    var tors: int32 = mm.MicroduckLinkTorso
    var heads: int32 = mm.MicroduckAssemblyLinkHead
    while survived < evalTicks:
        DuckGaitTick(w, phase, 1.0 / 240.0)
        let r = physics3d.Physics3dStep(w, "gaitcem")
        if r.statusCode != physics3d.Physics3dStatusOk:
            survived = survived + 1
            if survived >= evalTicks:
                break
            # keep going: rollbacks don't end the episode, but count
            # a bounded number then stop
            var rr: int32 = 0
            while rr < 12:
                let r2 = physics3d.Physics3dStep(w, "gaitcem")
                survived = survived + 1
                if r2.statusCode == physics3d.Physics3dStatusOk:
                    break
                rr = rr + 1
            break
        if w.bodyPz[heads] < w.bodyPz[tors]:
            break
        let qx = w.bodyQuatX[tors]
        let qy = w.bodyQuatY[tors]
        let upz = 1.0 - 2.0 * (qx * qx + qy * qy)
        if upz < 0.5:
            break
        survived = survived + 1
    outDisp = m.absFloat(w.bodyPx[mm.MicroduckLinkTorso] - x0)
    outSurvived = survived
    physics3d.physics3dGaitMode = 0

# Gait CEM sweep: 6 dims (freq/hip/knee/ankle/lead/roll), pop 12,
# 3 generations, 300-tick evals, fitness = survivedTicks +
# 3000*netDisplacement. Prints the champion milli-params for
# pasting into the slots.
fn RunGaitCem(): int32 =
    let dims: int32 = 9
    var mean: int64[9]
    var stdev: int64[9]
    mean[0] = GaitEnvOverride("GAIT_FREQ", 1600)
    mean[1] = GaitEnvOverride("GAIT_HIP", 100)
    mean[2] = GaitEnvOverride("GAIT_KNEE", 220)
    mean[3] = GaitEnvOverride("GAIT_ANKLE", 180)
    mean[4] = GaitEnvOverride("GAIT_LEAD", 550)
    mean[5] = GaitEnvOverride("GAIT_ROLL", 900)
    mean[6] = GaitEnvOverride("GAIT_ANKPHASE", 0)
    mean[7] = GaitEnvOverride("GAIT_DSB", 150)
    mean[8] = GaitEnvOverride("GAIT_SWAY", 60)
    stdev[0] = 400
    stdev[1] = 60
    stdev[2] = 120
    stdev[3] = 90
    stdev[4] = 250
    stdev[5] = 400
    stdev[6] = 500
    stdev[7] = 100
    stdev[8] = 50
    let pop: int32 = 12
    var gens: int32 = 3
    var evalTicks: int64 = 300
    let genv: str = os.GetEnvDefault("GAITCEM_GENS", "")
    if genv.len > 0:
        gens = int32(ParseDigits(genv))
    let tenv: str = os.GetEnvDefault("GAITCEM_TICKS", "")
    if tenv.len > 0:
        evalTicks = int64(ParseDigits(tenv))
    cemRngState = 0x123456789ABCDEF
    let senv: str = os.GetEnvDefault("GAITCEM_SEED", "")
    if senv.len > 0:
        cemRngState = int64(ParseDigits(senv)) * 2654435761 + 12345
    var bestFit: float64 = 0.0 - 1.0
    var bestS: int64[9]
    var g: int32 = 0
    while g < gens:
        var bestThis: float64 = 0.0 - 1.0
        var k: int32 = 0
        while k < pop:
            var sample: int64[9]
            var d: int32 = 0
            while d < dims:
                var v: int64 = mean[d] + int64(CemRandNorm() * float64(stdev[d]))
                sample[d] = v
                d = d + 1
            if sample[0] < 400: sample[0] = 400
            if sample[0] > 3000: sample[0] = 3000
            if sample[1] < 30: sample[1] = 30
            if sample[1] > 250: sample[1] = 250
            if sample[2] < 80: sample[2] = 80
            if sample[2] > 400: sample[2] = 400
            if sample[3] < 40: sample[3] = 40
            if sample[3] > 350: sample[3] = 350
            if sample[4] < 100: sample[4] = 100
            if sample[4] > 900: sample[4] = 900
            if sample[5] < 200: sample[5] = 1600
            if sample[6] < 0 - 800: sample[6] = 0 - 800
            if sample[6] > 800: sample[6] = 800
            if sample[7] < 0: sample[7] = 0
            if sample[7] > 400: sample[7] = 400
            if sample[8] < 0: sample[8] = 0
            if sample[8] > 200: sample[8] = 200
            # triple-median fitness: 3 evals at jittered seeds, take median
            var fits: float64[3]
            var e: int32 = 0
            while e < 3:
                var w: world3d.World3d
                world3d.World3dReset(w, int64(977) + int64(e))
                var ballSlot: int32 = 0
                ballSlot = DuckAssemble(w, DuckGroundRootX, DuckGroundRootY, DuckGroundRootZ)
                gaitFreqHzM = int32(sample[0])
                gaitHipAmpM = int32(sample[1])
                gaitKneeSwingM = int32(sample[2])
                gaitAnkleAmpM = int32(sample[3])
                gaitKneeLeadM = int32(sample[4])
                gaitRollGainM = int32(sample[5])
                gaitAnkPhaseM = int32(sample[6])
                gaitDblSupM = int32(sample[7])
                gaitSwayAmpM = int32(sample[8])
                physics3d.physics3dGaitMode = 1
                var phase: float64 = DuckGaitPhase0
                let x0: float64 = w.bodyPx[mm.MicroduckLinkTorso]
                var tors: int32 = mm.MicroduckLinkTorso
                var heads: int32 = mm.MicroduckAssemblyLinkHead
                var survived: int64 = 0
                var fell: bool = false
                while survived < evalTicks:
                    DuckGaitTick(w, phase, 1.0 / 240.0)
                    let r = physics3d.Physics3dStep(w, "gaitcem")
                    if r.statusCode != physics3d.Physics3dStatusOk:
                        fell = true
                        break
                    if w.bodyPz[heads] < w.bodyPz[tors]:
                        fell = true
                        break
                    let qx = w.bodyQuatX[tors]
                    let qy = w.bodyQuatY[tors]
                    let upz = 1.0 - 2.0 * (qx * qx + qy * qy)
                    if upz < 0.5:
                        fell = true
                        break
                    survived = survived + 1
                var dp: float64 = m.absFloat(w.bodyPx[tors] - x0)
                if fell:
                    dp = dp * 0.2
                fits[e] = float64(survived) + 30000.0 * dp
                e = e + 1
            # median of 3
            var med: float64 = fits[0]
            if (fits[1] >= med and fits[1] <= fits[2]) or (fits[1] >= fits[2] and fits[1] <= med):
                med = fits[1]
            if (fits[2] >= med and fits[2] <= fits[1]) or (fits[2] >= fits[1] and fits[2] <= med):
                med = fits[2]
            if med > bestThis:
                bestThis = med
            if med > bestFit:
                bestFit = med
                var d2: int32 = 0
                while d2 < dims:
                    bestS[d2] = sample[d2]
                    d2 = d2 + 1
            echo("CEM g=" + strings.IntToStr(g) + " k=" + strings.IntToStr(k) + " med_fit=" + DuckFmtMm(med) + " f0=" + DuckFmtMm(fits[0]) + " f1=" + DuckFmtMm(fits[1]) + " f2=" + DuckFmtMm(fits[2]))
            k = k + 1
        var d3: int32 = 0
        while d3 < dims:
            mean[d3] = mean[d3] + (bestS[d3] - mean[d3]) / 2
            d3 = d3 + 1
        g = g + 1
    echo("CEM BEST fit=" + DuckFmtMm(bestFit) + " freqM=" + strings.Int64ToStr(bestS[0]) + " hipM=" + strings.Int64ToStr(bestS[1]) + " kneeM=" + strings.Int64ToStr(bestS[2]) + " ankM=" + strings.Int64ToStr(bestS[3]) + " leadM=" + strings.Int64ToStr(bestS[4]) + " rollM=" + strings.Int64ToStr(bestS[5]) + " ankphM=" + strings.Int64ToStr(bestS[6]) + " dsbM=" + strings.Int64ToStr(bestS[7]) + " swayM=" + strings.Int64ToStr(bestS[8]))
    return 0


    let dims: int32 = 6
    var mean: int64[6]
    var stdev: int64[6]
    # init means = champion, stdevs = spread
    mean[0] = GaitEnvOverride("GAIT_FREQ", 1600)
    mean[1] = GaitEnvOverride("GAIT_HIP", 100)
    mean[2] = GaitEnvOverride("GAIT_KNEE", 220)
    mean[3] = GaitEnvOverride("GAIT_ANKLE", 180)
    mean[4] = GaitEnvOverride("GAIT_LEAD", 550)
    mean[5] = GaitEnvOverride("GAIT_ROLL", 900)
    stdev[0] = 400
    stdev[1] = 60
    stdev[2] = 120
    stdev[3] = 90
    stdev[4] = 250
    stdev[5] = 400
    let pop: int32 = 12
    var gens: int32 = 3
    var evalTicks: int64 = 300
    let genv: str = os.GetEnvDefault("GAITCEM_GENS", "")
    if genv.len > 0:
        gens = int32(ParseDigits(genv))
    let tenv: str = os.GetEnvDefault("GAITCEM_TICKS", "")
    if tenv.len > 0:
        evalTicks = int64(ParseDigits(tenv))
    cemRngState = 0x123456789ABCDEF
    let senv: str = os.GetEnvDefault("GAITCEM_SEED", "")
    if senv.len > 0:
        cemRngState = int64(ParseDigits(senv)) * 2654435761 + 12345
    var bestFit: float64 = 0.0 - 1.0
    var bestS: int64[6]
    var g: int32 = 0
    while g < gens:
        var bestThis: float64 = 0.0 - 1.0
        var k: int32 = 0
        while k < pop:
            var sample: int64[6]
            var d: int32 = 0
            while d < dims:
                var v: int64 = mean[d] + int64(CemRandNorm() * float64(stdev[d]))
                sample[d] = v
                d = d + 1
            # clamp sane bounds
            if sample[0] < 400: sample[0] = 400
            if sample[0] > 3000: sample[0] = 3000
            if sample[1] < 30: sample[1] = 30
            if sample[1] > 250: sample[1] = 250
            if sample[2] < 80: sample[2] = 80
            if sample[2] > 400: sample[2] = 400
            if sample[3] < 40: sample[3] = 40
            if sample[3] > 350: sample[3] = 350
            if sample[4] < 100: sample[4] = 100
            if sample[4] > 900: sample[4] = 900
            if sample[5] < 200: sample[5] = 200
            if sample[5] > 1600: sample[5] = 1600
            # evaluate
            var w: world3d.World3d
            var sv: int64 = 0
            var dp: float64 = 0.0
            world3d.World3dReset(w, int64(977))
            var ballSlot: int32 = 0
            ballSlot = DuckAssemble(w, DuckGroundRootX, DuckGroundRootY, DuckGroundRootZ)
            gaitFreqHzM = int32(sample[0])
            gaitHipAmpM = int32(sample[1])
            gaitKneeSwingM = int32(sample[2])
            gaitAnkleAmpM = int32(sample[3])
            gaitKneeLeadM = int32(sample[4])
            gaitRollGainM = int32(sample[5])
            physics3d.physics3dGaitMode = 1
            var phase: float64 = DuckGaitPhase0
            let x0: float64 = w.bodyPx[mm.MicroduckLinkTorso]
            var tors: int32 = mm.MicroduckLinkTorso
            var heads: int32 = mm.MicroduckAssemblyLinkHead
            var survived: int64 = 0
            var fell: bool = false
            while survived < evalTicks:
                DuckGaitTick(w, phase, 1.0 / 240.0)
                let r = physics3d.Physics3dStep(w, "gaitcem")
                if r.statusCode != physics3d.Physics3dStatusOk:
                    fell = true
                    break
                if w.bodyPz[heads] < w.bodyPz[tors]:
                    fell = true
                    break
                let qx = w.bodyQuatX[tors]
                let qy = w.bodyQuatY[tors]
                let upz = 1.0 - 2.0 * (qx * qx + qy * qy)
                if upz < 0.5:
                    fell = true
                    break
                survived = survived + 1
            var dp: float64 = m.absFloat(w.bodyPx[tors] - x0)
            if fell:
                dp = dp * 0.2
            let fit: float64 = float64(survived) + 30000.0 * dp
            if fit > bestThis:
                bestThis = fit
            if fit > bestFit:
                bestFit = fit
                var d2: int32 = 0
                while d2 < dims:
                    bestS[d2] = sample[d2]
                    d2 = d2 + 1
            echo("CEM g=" + strings.IntToStr(g) + " k=" + strings.IntToStr(k) + " fit=" + DuckFmtMm(fit) + " survived=" + strings.Int64ToStr(survived) + " disp_mm=" + DuckFmtMm(dp * 1000.0))
            k = k + 1
        # update mean toward best (simple elite move)
        var d3: int32 = 0
        while d3 < dims:
            mean[d3] = mean[d3] + (bestS[d3] - mean[d3]) / 2
            d3 = d3 + 1
        g = g + 1
    echo("CEM BEST fit=" + DuckFmtMm(bestFit) + " freqM=" + strings.Int64ToStr(bestS[0]) + " hipM=" + strings.Int64ToStr(bestS[1]) + " kneeM=" + strings.Int64ToStr(bestS[2]) + " ankM=" + strings.Int64ToStr(bestS[3]) + " leadM=" + strings.Int64ToStr(bestS[4]) + " rollM=" + strings.Int64ToStr(bestS[5]))
    return 0

# ---- pure-cheng policy network (standing balance, recurrent v2) ----
var polW1: float64[PolicyObsN * PolicyHidN]
var polB1: float64[PolicyHidN]
var polW2: float64[PolicyHidN * PolicyOutN]
var polB2: float64[PolicyOutN]
var polCtx: float64[PolicyCtxN]
# v2: obs 16 (adds foot-pole heights L/R, foot span, ankle angles x2),
# hidden 12 WITH leaky-context memory (Elman: hid = 0.7*hid_prev +
# 0.3*new) — the memory lets the policy distinguish "same pose,
# different fall direction" which the stateless linear net could not
# (the 20-gen plateau verdict).
# v5: obs 16 -> 22 (cols 16-21 = per-driven-hinge axis-relative angular
# rate wrel/10), hidden 12 -> 24. PolicyObsLegacyN pins the v2..v4 obs
# count: the Elman context term is accumulated INSIDE the obs loop in
# both forward paths (trained that way), so the legacy 16 iterations —
# not PolicyObsN — define the context gain and must never move.
const PolicyObsN = 22
const PolicyObsLegacyN = 16
const PolicyHidN = 48
# v4: outputs 6 -> 8 (hip roll L/R added) — the passive-stand terminal
# cause is the slow static roll leak, and the v3 policy (pitch hips,
# knees, ankles only) plateaued at fit 1210 for 48 gens: without roll
# authority the policy can only fight the leak indirectly
const PolicyOutN = 8
# v5: ctx tracks HidN (Elman memory is per hidden unit; at 12==12 the
# coupling was invisible, HidN 24 made polCtx[12..23] a bounds trap)
const PolicyCtxN = 48
const PolicyParamN = 22 * 48 + 48 + 48 * 8 + 8
# DUCK_QTRACE=1: echo the torso quat norm every 16 rollout ticks (the
# 2.1e6 upright-saturation diagnosis entry point)
var duckQTraceOn: int32 = 0
# DUCK_POLICY=<paramfile>: interactive ground episode driven by the
# trained standing policy (goal side only)
var duckPolicyOn: int32 = 0
# DUCK_GOAL_ECHO=1: both policy paths (rollout + interactive) echo their
# goal stream for equivalence diffing
var duckGoalEchoOn: int32 = 0
# DUCK_SWEEP_ECHO=1: per-tick solver sweep count (base+refine burn) —
# the frame-time variance instrument
var duckSweepEchoOn: int32 = 0
# knee goal base captured on the first policy tick (the stance park has
# run by then); stored as int32 milli — float64 module vars are a cold
# compiler allergy. The policy writes base + delta, never accumulates.
var duckPolKneeBaseLm: int32 = 0
var duckPolKneeBaseRm: int32 = 0
var duckPolRollBaseLm: int32 = 0
var duckPolRollBaseRm: int32 = 0
var duckPolKneeBaseInit: int32 = 0

# One policy rollout: the policy writes ankle/knee delta-goals per
# tick on top of the stance goals; fitness = survived ticks + the
# upright-time integral.
@borrows
fn PolicyRollout(w: var World3d, evalTicks: int64, outSurvived: var int64, outUpright: var float64) =
    var phase: float64 = DuckGaitPhase0
    var t: int64 = 0
    var obs: float64[PolicyObsN]
    var out: float64[PolicyOutN]
    var hid: float64[PolicyHidN]
    let tors: int32 = mm.MicroduckLinkTorso
    let heads: int32 = mm.MicroduckAssemblyLinkHead
    # knee/roll goals parked by the stance setup before the rollout: the
    # policy writes base + delta, never accumulates on the live goal.
    # The bases go through the SAME int32-milli truncation as the
    # interactive path (duckPolKneeBaseLm) — a 1 mrad base offset
    # chaotic-amplifies into a totally different fall, and training
    # must gate bit-exactly.
    let kneeBaseL: float64 = float64(int32(w.conGoal[duckCiKneeL] * 1000.0)) / 1000.0
    let kneeBaseR: float64 = float64(int32(w.conGoal[duckCiKneeR] * 1000.0)) / 1000.0
    let rollBaseL: float64 = float64(int32(w.conGoal[duckCiYokeL] * 1000.0)) / 1000.0
    let rollBaseR: float64 = float64(int32(w.conGoal[duckCiYokeR] * 1000.0)) / 1000.0
    outUpright = 0.0
    outSurvived = 0
    # context reset per rollout: the Elman memory must not leak
    # between rollouts (gen1+ were all pinned to 118 by inherited
    # context)
    var zi: int32 = 0
    while zi < PolicyCtxN:
        polCtx[zi] = 0.0
        zi = zi + 1
    # local accumulator: a var float64 param read in `p = p + x` inside
    # an @borrows fn reads an uninitialized slot (cold backend RMW bug,
    # 2026-09-18) — the param is written exactly once, at the end
    var upAcc: float64 = 0.0
    while t < evalTicks:
        # --- observation vector ---
        let qw = w.bodyQuatW[tors]
        let qx = w.bodyQuatX[tors]
        let qy = w.bodyQuatY[tors]
        let qz = w.bodyQuatZ[tors]
        obs[0] = 2.0 * (qx * qz + qw * qy)
        obs[1] = 2.0 * (qy * qz - qw * qx)
        obs[2] = w.bodyVx[tors]
        obs[3] = w.bodyVy[tors]
        obs[4] = w.bodyAngVx[tors]
        obs[5] = w.bodyAngVy[tors]
        obs[6] = constraints3d.Constraints3dHingeAngle(w, duckCiHipL) * 57.29577951308232 / 90.0
        obs[7] = constraints3d.Constraints3dHingeAngle(w, duckCiHipR) * 57.29577951308232 / 90.0
        obs[8] = constraints3d.Constraints3dHingeAngle(w, duckCiKneeL) / 90.0
        obs[9] = constraints3d.Constraints3dHingeAngle(w, duckCiKneeR) / 90.0
        # v2 extended observations: foot-pole heights (support state),
        # foot span (lateral stability cue), ankle angles (sole camber)
        let hL = w.bodyCapsuleHalf[DuckLinkFootL]
        let axL = 2.0 * (w.bodyQuatX[DuckLinkFootL] * w.bodyQuatZ[DuckLinkFootL] + w.bodyQuatW[DuckLinkFootL] * w.bodyQuatY[DuckLinkFootL])
        let azL = 1.0 - 2.0 * (w.bodyQuatX[DuckLinkFootL] * w.bodyQuatX[DuckLinkFootL] + w.bodyQuatY[DuckLinkFootL] * w.bodyQuatY[DuckLinkFootL])
        let hR = w.bodyCapsuleHalf[DuckLinkFootR]
        let axR = 2.0 * (w.bodyQuatX[DuckLinkFootR] * w.bodyQuatZ[DuckLinkFootR] + w.bodyQuatW[DuckLinkFootR] * w.bodyQuatY[DuckLinkFootR])
        let azR = 1.0 - 2.0 * (w.bodyQuatX[DuckLinkFootR] * w.bodyQuatX[DuckLinkFootR] + w.bodyQuatY[DuckLinkFootR] * w.bodyQuatY[DuckLinkFootR])
        obs[10] = (w.bodyPz[DuckLinkFootL] - hL * m.absFloat(azL) - w.bodyRadius[DuckLinkFootL]) * 100.0
        obs[11] = (w.bodyPz[DuckLinkFootR] - hR * m.absFloat(azR) - w.bodyRadius[DuckLinkFootR]) * 100.0
        obs[12] = (w.bodyPy[DuckLinkFootL] - w.bodyPy[DuckLinkFootR]) * 10.0
        obs[13] = constraints3d.Constraints3dHingeAngle(w, duckCiAnkleL) * 57.29577951308232 / 90.0
        obs[14] = constraints3d.Constraints3dHingeAngle(w, duckCiAnkleR) * 57.29577951308232 / 90.0
        obs[15] = w.bodyAngVz[tors]
        # v5 obs 16-21: per-driven-hinge axis-relative angular rate
        # wrel = (wB - wA) . u_world, rad/s / 10; u = body-A quat
        # rotating the local hinge axis to world (same math as the
        # physics3d joint-damping wrel, inlined to keep the module
        # interface closed). Keep line-identical to DuckPolicyTick.
        let s16a: int32 = w.conA[duckCiHipL]
        let s16b: int32 = w.conB[duckCiHipL]
        let q16w: float64 = w.bodyQuatW[s16a]
        let q16x: float64 = w.bodyQuatX[s16a]
        let q16y: float64 = w.bodyQuatY[s16a]
        let q16z: float64 = w.bodyQuatZ[s16a]
        let l16x: float64 = w.conAxisAx[duckCiHipL]
        let l16y: float64 = w.conAxisAy[duckCiHipL]
        let l16z: float64 = w.conAxisAz[duckCiHipL]
        let u16x: float64 = (1.0 - 2.0 * (q16y * q16y + q16z * q16z)) * l16x + 2.0 * (q16x * q16y - q16z * q16w) * l16y + 2.0 * (q16x * q16z + q16y * q16w) * l16z
        let u16y: float64 = 2.0 * (q16x * q16y + q16z * q16w) * l16x + (1.0 - 2.0 * (q16x * q16x + q16z * q16z)) * l16y + 2.0 * (q16y * q16z - q16x * q16w) * l16z
        let u16z: float64 = 2.0 * (q16x * q16z - q16y * q16w) * l16x + 2.0 * (q16y * q16z + q16x * q16w) * l16y + (1.0 - 2.0 * (q16x * q16x + q16y * q16y)) * l16z
        obs[16] = ((w.bodyAngVx[s16b] - w.bodyAngVx[s16a]) * u16x + (w.bodyAngVy[s16b] - w.bodyAngVy[s16a]) * u16y + (w.bodyAngVz[s16b] - w.bodyAngVz[s16a]) * u16z) / 10.0
        let s17a: int32 = w.conA[duckCiHipR]
        let s17b: int32 = w.conB[duckCiHipR]
        let q17w: float64 = w.bodyQuatW[s17a]
        let q17x: float64 = w.bodyQuatX[s17a]
        let q17y: float64 = w.bodyQuatY[s17a]
        let q17z: float64 = w.bodyQuatZ[s17a]
        let l17x: float64 = w.conAxisAx[duckCiHipR]
        let l17y: float64 = w.conAxisAy[duckCiHipR]
        let l17z: float64 = w.conAxisAz[duckCiHipR]
        let u17x: float64 = (1.0 - 2.0 * (q17y * q17y + q17z * q17z)) * l17x + 2.0 * (q17x * q17y - q17z * q17w) * l17y + 2.0 * (q17x * q17z + q17y * q17w) * l17z
        let u17y: float64 = 2.0 * (q17x * q17y + q17z * q17w) * l17x + (1.0 - 2.0 * (q17x * q17x + q17z * q17z)) * l17y + 2.0 * (q17y * q17z - q17x * q17w) * l17z
        let u17z: float64 = 2.0 * (q17x * q17z - q17y * q17w) * l17x + 2.0 * (q17y * q17z + q17x * q17w) * l17y + (1.0 - 2.0 * (q17x * q17x + q17y * q17y)) * l17z
        obs[17] = ((w.bodyAngVx[s17b] - w.bodyAngVx[s17a]) * u17x + (w.bodyAngVy[s17b] - w.bodyAngVy[s17a]) * u17y + (w.bodyAngVz[s17b] - w.bodyAngVz[s17a]) * u17z) / 10.0
        let s18a: int32 = w.conA[duckCiKneeL]
        let s18b: int32 = w.conB[duckCiKneeL]
        let q18w: float64 = w.bodyQuatW[s18a]
        let q18x: float64 = w.bodyQuatX[s18a]
        let q18y: float64 = w.bodyQuatY[s18a]
        let q18z: float64 = w.bodyQuatZ[s18a]
        let l18x: float64 = w.conAxisAx[duckCiKneeL]
        let l18y: float64 = w.conAxisAy[duckCiKneeL]
        let l18z: float64 = w.conAxisAz[duckCiKneeL]
        let u18x: float64 = (1.0 - 2.0 * (q18y * q18y + q18z * q18z)) * l18x + 2.0 * (q18x * q18y - q18z * q18w) * l18y + 2.0 * (q18x * q18z + q18y * q18w) * l18z
        let u18y: float64 = 2.0 * (q18x * q18y + q18z * q18w) * l18x + (1.0 - 2.0 * (q18x * q18x + q18z * q18z)) * l18y + 2.0 * (q18y * q18z - q18x * q18w) * l18z
        let u18z: float64 = 2.0 * (q18x * q18z - q18y * q18w) * l18x + 2.0 * (q18y * q18z + q18x * q18w) * l18y + (1.0 - 2.0 * (q18x * q18x + q18y * q18y)) * l18z
        obs[18] = ((w.bodyAngVx[s18b] - w.bodyAngVx[s18a]) * u18x + (w.bodyAngVy[s18b] - w.bodyAngVy[s18a]) * u18y + (w.bodyAngVz[s18b] - w.bodyAngVz[s18a]) * u18z) / 10.0
        let s19a: int32 = w.conA[duckCiKneeR]
        let s19b: int32 = w.conB[duckCiKneeR]
        let q19w: float64 = w.bodyQuatW[s19a]
        let q19x: float64 = w.bodyQuatX[s19a]
        let q19y: float64 = w.bodyQuatY[s19a]
        let q19z: float64 = w.bodyQuatZ[s19a]
        let l19x: float64 = w.conAxisAx[duckCiKneeR]
        let l19y: float64 = w.conAxisAy[duckCiKneeR]
        let l19z: float64 = w.conAxisAz[duckCiKneeR]
        let u19x: float64 = (1.0 - 2.0 * (q19y * q19y + q19z * q19z)) * l19x + 2.0 * (q19x * q19y - q19z * q19w) * l19y + 2.0 * (q19x * q19z + q19y * q19w) * l19z
        let u19y: float64 = 2.0 * (q19x * q19y + q19z * q19w) * l19x + (1.0 - 2.0 * (q19x * q19x + q19z * q19z)) * l19y + 2.0 * (q19y * q19z - q19x * q19w) * l19z
        let u19z: float64 = 2.0 * (q19x * q19z - q19y * q19w) * l19x + 2.0 * (q19y * q19z + q19x * q19w) * l19y + (1.0 - 2.0 * (q19x * q19x + q19y * q19y)) * l19z
        obs[19] = ((w.bodyAngVx[s19b] - w.bodyAngVx[s19a]) * u19x + (w.bodyAngVy[s19b] - w.bodyAngVy[s19a]) * u19y + (w.bodyAngVz[s19b] - w.bodyAngVz[s19a]) * u19z) / 10.0
        let s20a: int32 = w.conA[duckCiAnkleL]
        let s20b: int32 = w.conB[duckCiAnkleL]
        let q20w: float64 = w.bodyQuatW[s20a]
        let q20x: float64 = w.bodyQuatX[s20a]
        let q20y: float64 = w.bodyQuatY[s20a]
        let q20z: float64 = w.bodyQuatZ[s20a]
        let l20x: float64 = w.conAxisAx[duckCiAnkleL]
        let l20y: float64 = w.conAxisAy[duckCiAnkleL]
        let l20z: float64 = w.conAxisAz[duckCiAnkleL]
        let u20x: float64 = (1.0 - 2.0 * (q20y * q20y + q20z * q20z)) * l20x + 2.0 * (q20x * q20y - q20z * q20w) * l20y + 2.0 * (q20x * q20z + q20y * q20w) * l20z
        let u20y: float64 = 2.0 * (q20x * q20y + q20z * q20w) * l20x + (1.0 - 2.0 * (q20x * q20x + q20z * q20z)) * l20y + 2.0 * (q20y * q20z - q20x * q20w) * l20z
        let u20z: float64 = 2.0 * (q20x * q20z - q20y * q20w) * l20x + 2.0 * (q20y * q20z + q20x * q20w) * l20y + (1.0 - 2.0 * (q20x * q20x + q20y * q20y)) * l20z
        obs[20] = ((w.bodyAngVx[s20b] - w.bodyAngVx[s20a]) * u20x + (w.bodyAngVy[s20b] - w.bodyAngVy[s20a]) * u20y + (w.bodyAngVz[s20b] - w.bodyAngVz[s20a]) * u20z) / 10.0
        let s21a: int32 = w.conA[duckCiAnkleR]
        let s21b: int32 = w.conB[duckCiAnkleR]
        let q21w: float64 = w.bodyQuatW[s21a]
        let q21x: float64 = w.bodyQuatX[s21a]
        let q21y: float64 = w.bodyQuatY[s21a]
        let q21z: float64 = w.bodyQuatZ[s21a]
        let l21x: float64 = w.conAxisAx[duckCiAnkleR]
        let l21y: float64 = w.conAxisAy[duckCiAnkleR]
        let l21z: float64 = w.conAxisAz[duckCiAnkleR]
        let u21x: float64 = (1.0 - 2.0 * (q21y * q21y + q21z * q21z)) * l21x + 2.0 * (q21x * q21y - q21z * q21w) * l21y + 2.0 * (q21x * q21z + q21y * q21w) * l21z
        let u21y: float64 = 2.0 * (q21x * q21y + q21z * q21w) * l21x + (1.0 - 2.0 * (q21x * q21x + q21z * q21z)) * l21y + 2.0 * (q21y * q21z - q21x * q21w) * l21z
        let u21z: float64 = 2.0 * (q21x * q21z - q21y * q21w) * l21x + 2.0 * (q21y * q21z + q21x * q21w) * l21y + (1.0 - 2.0 * (q21x * q21x + q21y * q21y)) * l21z
        obs[21] = ((w.bodyAngVx[s21b] - w.bodyAngVx[s21a]) * u21x + (w.bodyAngVy[s21b] - w.bodyAngVy[s21a]) * u21y + (w.bodyAngVz[s21b] - w.bodyAngVz[s21a]) * u21z) / 10.0
        # --- policy forward (inlined) ---
        var hi: int32 = 0
        while hi < PolicyHidN:
            var acc: float64 = polB1[hi]
            var ctxTerm: float64 = polCtx[hi] * 0.7
            var jj: int32 = 0
            # legacy cols 0-15 carry the context term INSIDE the obs
            # loop (the trained ctx gain is 16*0.7); the split keeps
            # the old FP summation order bit-exact while cols 16-21
            # stay pure (zero-weight for the 308 champion) obs inputs
            while jj < PolicyObsLegacyN:
                acc = acc + polW1[hi * PolicyObsN + jj] * obs[jj]
                acc = acc + ctxTerm
                jj = jj + 1
            while jj < PolicyObsN:
                acc = acc + polW1[hi * PolicyObsN + jj] * obs[jj]
                jj = jj + 1
            if acc > 3.0:
                acc = 3.0
            if acc < 0.0 - 3.0:
                acc = 0.0 - 3.0
            acc = acc - acc * acc * acc / 27.0
            # Elman context update: leaky integration of the hidden
            # state — the memory that distinguishes "same pose,
            # different fall direction"
            polCtx[hi] = polCtx[hi] * 0.7 + acc * 0.3
            hid[hi] = acc
            hi = hi + 1
        var oi: int32 = 0
        while oi < PolicyOutN:
            var acc: float64 = polB2[oi]
            var jj: int32 = 0
            while jj < PolicyHidN:
                acc = acc + polW2[oi * PolicyHidN + jj] * hid[jj]
                jj = jj + 1
            out[oi] = acc
            oi = oi + 1
        # --- apply as delta goals on hips + ankles ---
        # The fall is driven by HIP yield (hipL/hipR drift from stance
        # under gravity). The policy must actively correct the hips.
        # Knees stay passive (they fold naturally, the passive limits
        # prevent over-flexion).
        var dHipL: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[0]))
        var dHipR: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[1]))
        var dAnkL: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[2]))
        var dAnkR: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[3]))
        var dKneeL: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[4]))
        var dKneeR: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[5]))
        var dRollL: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[6]))
        var dRollR: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[7]))
        let st = mm.MicroduckStanceHipRad
        w.conGoal[duckCiHipL] = st + dHipL
        w.conGoal[duckCiHipR] = 0.0 - st + dHipR
        w.conGoal[duckCiAnkleL] = 0.0 - st + dAnkL
        w.conGoal[duckCiAnkleR] = st + dAnkR
        w.conGoal[duckCiKneeL] = kneeBaseL + dKneeL
        w.conGoal[duckCiKneeR] = kneeBaseR + dKneeR
        w.conGoal[duckCiYokeL] = rollBaseL + dRollL
        w.conGoal[duckCiYokeR] = rollBaseR + dRollR
        if duckGoalEchoOn == 1:
            if t % 16 == 0:
                let eHL: float64 = w.conGoal[duckCiHipL] + 0.0
                let eKL: float64 = w.conGoal[duckCiKneeL] + 0.0
                echo("GR t=" + strings.Int64ToStr(t) + " hL=" + DuckFmtMm(eHL) + " kL=" + DuckFmtMm(eKL))
        let r = physics3d.Physics3dStep(w, "policy")
        if r.statusCode != physics3d.Physics3dStatusOk:
            break
        if w.bodyPz[heads] < w.bodyPz[tors]:
            break
        # post-step quat: normalize FIRST. The upright ratio is only
        # bounded for a unit rotor, and |q|!=1 also scales every vector
        # a rotation applies to (q v q* carries |q|^2), so a drifting
        # norm is itself a stop condition, not just a metric artifact.
        let qw2 = w.bodyQuatW[tors]
        let qx2 = w.bodyQuatX[tors]
        let qy2 = w.bodyQuatY[tors]
        let qz2 = w.bodyQuatZ[tors]
        let qn2 = numerics.CsgSqrt(qw2 * qw2 + qx2 * qx2 + qy2 * qy2 + qz2 * qz2)
        if duckQTraceOn == 1:
            if t % 16 == 0:
                echo("QT t=" + strings.Int64ToStr(t) + " qn2=" + DuckFmtMm(qn2))
        # NaN-transparent guards are the v1 saturation root cause: once
        # the post-fall tumble drives the quat to NaN every `x < bound`
        # comparison is false and the poisoned ratio kept accumulating.
        # Negating the PASS side makes NaN fail closed.
        if !(qn2 > 0.5 and qn2 < 2.0):
            break
        let invN = 1.0 / qn2
        let ux = qx2 * invN
        let uy = qy2 * invN
        let upz = m.absFloat(1.0 - 2.0 * (ux * ux + uy * uy))
        if !(upz >= 0.0 and upz <= 1.0):
            break
        if upz < 0.5:
            break
        upAcc = upAcc + upz
        outSurvived = t + 1
        t = t + 1
    outUpright = upAcc + 0.0

# CEM trainer for the standing policy: perturb-reweight-resample
# over the 124 params, fitness = upright integral (survived ticks
# weighted by mean up-vector).
# Headless single-policy evaluation for the external parallel CEM
# coordinator: reads 256 newline-separated signed-milli policy params,
# runs one ground rollout, echoes "EVAL fit=<milli> survived=<ticks>"
# for the coordinator to collect. The deterministic engine makes every
# worker's fitness bit-reproducible.
fn RunStandEval(paramPath: str): int32 =
    let raw: str = os.ReadFile(paramPath)
    let qtenv: str = os.GetEnvDefault("DUCK_QTRACE", "")
    if qtenv.len > 0:
        duckQTraceOn = ParseDigits(qtenv)
    # the training plant MUST match the gate plant: the plate/servo envs
    # are also parsed in RunDuck (interactive) — without this block the
    # standeval children silently train on the bare-foot plant
    if os.GetEnvDefault("DUCK_FOOT_PLATE", "") == "1":
        duckFootPlate = true
    let somEnv: str = os.GetEnvDefault("DUCK_SERVO_OMEGA_M", "")
    if somEnv.len > 0:
        physics3d.physics3dServoOmegaM = ParseDigits(somEnv)
    let stmEnv: str = os.GetEnvDefault("DUCK_SERVO_TAUM_M", "")
    if stmEnv.len > 0:
        physics3d.physics3dServoTauM = ParseDigits(stmEnv)
    let gee: str = os.GetEnvDefault("DUCK_GOAL_ECHO", "")
    if gee.len > 0:
        duckGoalEchoOn = ParseDigits(gee)
    var vals: float64[PolicyParamN]
    var idx: int32 = 0
    var ci: int32 = 0
    var acc: int32 = 0
    var neg: bool = false
    var any: bool = false
    while ci < raw.len and idx < PolicyParamN:
        let cch: int32 = int32(raw[ci])
        if cch == 45:
            neg = true
        elif cch >= 48 and cch <= 57:
            acc = acc * 10 + (cch - 48)
            any = true
        elif cch == 10:
            if any:
                vals[idx] = float64(acc) / 1000.0
                if neg:
                    vals[idx] = 0.0 - vals[idx]
                idx = idx + 1
            acc = 0
            neg = false
            any = false
        ci = ci + 1
    if any and idx < PolicyParamN:
        vals[idx] = float64(acc) / 1000.0
        if neg:
            vals[idx] = 0.0 - vals[idx]
        idx = idx + 1
    if idx == 256:
        # v2 (4-output) champion: relocate B2 past the zeroed knee W2
        # rows — identical to the trainer's pad256_to_282
        var oldB0: float64 = vals[252]
        var oldB1: float64 = vals[253]
        var oldB2: float64 = vals[254]
        var oldB3: float64 = vals[255]
        var zi2: int32 = 252
        while zi2 < 276:
            vals[zi2] = 0.0
            zi2 = zi2 + 1
        vals[276] = oldB0
        vals[277] = oldB1
        vals[278] = oldB2
        vals[279] = oldB3
        idx = 282
    if idx == 282:
        # v3 champion pad: identical to DuckPolicyLoadFile's conversion
        var vB0: float64 = vals[276]
        var vB1: float64 = vals[277]
        var vB2: float64 = vals[278]
        var vB3: float64 = vals[279]
        var vB4: float64 = vals[280]
        var vB5: float64 = vals[281]
        var zi4: int32 = 276
        while zi4 < 300:
            vals[zi4] = 0.0
            zi4 = zi4 + 1
        vals[300] = vB0
        vals[301] = vB1
        vals[302] = vB2
        vals[303] = vB3
        vals[304] = vB4
        vals[305] = vB5
        idx = 308
    if idx == 308:
        # v5 champion relayout: obs 16->22, hidden 12->24. New W1 rows
        # 0-11 obs cols 0-15 = old W1 (192 in order), cols 16-21 = 0,
        # rows 12-23 all 0; new B1 = old B1 + 12 zeros; new W2 rows
        # (8) hidden cols 0-11 = old W2 (96 in order), cols 12-23 = 0;
        # new B2 = old B2. Zero-weight new obs cols + zero-weighted
        # silent new hidden units make the new net mathematically
        # identical to the old 308 layout.
        var nv: float64[PolicyParamN]
        var r5: int32 = 0
        while r5 < 12:
            var c5: int32 = 0
            while c5 < 16:
                nv[r5 * PolicyObsN + c5] = vals[r5 * 16 + c5]
                c5 = c5 + 1
            while c5 < PolicyObsN:
                nv[r5 * PolicyObsN + c5] = 0.0
                c5 = c5 + 1
            r5 = r5 + 1
        while r5 < PolicyHidN:
            var c5: int32 = 0
            while c5 < PolicyObsN:
                nv[r5 * PolicyObsN + c5] = 0.0
                c5 = c5 + 1
            r5 = r5 + 1
        var b5: int32 = 0
        while b5 < 12:
            nv[PolicyObsN * PolicyHidN + b5] = vals[192 + b5]
            b5 = b5 + 1
        while b5 < PolicyHidN:
            nv[PolicyObsN * PolicyHidN + b5] = 0.0
            b5 = b5 + 1
        var o5: int32 = 0
        while o5 < PolicyOutN:
            var h5: int32 = 0
            while h5 < 12:
                nv[PolicyObsN * PolicyHidN + PolicyHidN + o5 * PolicyHidN + h5] = vals[204 + o5 * 12 + h5]
                h5 = h5 + 1
            while h5 < PolicyHidN:
                nv[PolicyObsN * PolicyHidN + PolicyHidN + o5 * PolicyHidN + h5] = 0.0
                h5 = h5 + 1
            o5 = o5 + 1
        var z5: int32 = 0
        while z5 < PolicyOutN:
            nv[PolicyObsN * PolicyHidN + PolicyHidN + PolicyHidN * PolicyOutN + z5] = vals[300 + z5]
            z5 = z5 + 1
        var p5: int32 = 0
        while p5 < PolicyParamN:
            vals[p5] = nv[p5]
            p5 = p5 + 1
        idx = 752
    if idx == 752:
        # v5 (hid 24) champion relayout: hidden 24 -> 48. New W1 rows
        # 24-47 all 0, new B1 rows 24-47 = 0, new W2 hidden cols 24-47
        # = 0; rows/cols 0-23 verbatim. Silent new hidden units make
        # the 1496 net mathematically identical to the 752 layout.
        var nv6: float64[PolicyParamN]
        var z6: int32 = 0
        while z6 < PolicyParamN:
            nv6[z6] = 0.0
            z6 = z6 + 1
        var h6: int32 = 0
        while h6 < 24:
            var c6: int32 = 0
            while c6 < PolicyObsN:
                nv6[h6 * PolicyObsN + c6] = vals[h6 * PolicyObsN + c6]
                c6 = c6 + 1
            nv6[PolicyObsN * PolicyHidN + h6] = vals[PolicyObsN * 24 + h6]
            h6 = h6 + 1
        var o6: int32 = 0
        while o6 < PolicyOutN:
            var h6b: int32 = 0
            while h6b < 24:
                nv6[PolicyObsN * PolicyHidN + PolicyHidN + o6 * PolicyHidN + h6b] = vals[PolicyObsN * 24 + 24 + o6 * 24 + h6b]
                h6b = h6b + 1
            nv6[PolicyObsN * PolicyHidN + PolicyHidN + PolicyHidN * PolicyOutN + o6] = vals[PolicyObsN * 24 + 24 + 8 * 24 + o6]
            o6 = o6 + 1
        var p6: int32 = 0
        while p6 < PolicyParamN:
            vals[p6] = nv6[p6]
            p6 = p6 + 1
        idx = 1496
    var pi: int32 = 0
    while pi < PolicyObsN * PolicyHidN:
        polW1[pi] = vals[pi]
        pi = pi + 1
    while pi < PolicyObsN * PolicyHidN + PolicyHidN:
        polB1[pi - PolicyObsN * PolicyHidN] = vals[pi]
        pi = pi + 1
    let o2: int32 = PolicyObsN * PolicyHidN + PolicyHidN
    while pi < o2 + PolicyHidN * PolicyOutN:
        polW2[pi - o2] = vals[pi]
        pi = pi + 1
    let o3: int32 = o2 + PolicyHidN * PolicyOutN
    while pi < o3 + PolicyOutN:
        polB2[pi - o3] = vals[pi]
        pi = pi + 1
    var w: world3d.World3d
    world3d.World3dReset(w, int64(977))
    var ballSlot: int32 = 0
    # DUCK_EVAL_JITTER=<int>: deterministic horizontal spawn offset derived
    # from the seed via xorshift64 — multi-seed median fitness needs real
    # domain variation (the seed alone is just an instance label). x/y
    # only (±2 mm): a z offset is a spawn drop, the historical
    # launch-artifact. No env = no jitter = the gate contract untouched.
    var rootJx: float64 = DuckGroundRootX
    var rootJy: float64 = DuckGroundRootY
    let jitenv: str = os.GetEnvDefault("DUCK_EVAL_JITTER", "")
    if jitenv.len > 0:
        var rng: int64 = int64(DuckParseSignedEnv(jitenv))
        if rng == 0:
            rng = int64(88172645463325252)
        var rs: int32 = 0
        while rs < 3:
            rng = rng ^ (rng << 13)
            rng = rng ^ (rng >> 7)
            rng = rng ^ (rng << 17)
            rs = rs + 1
        let jx: int32 = int32(((rng >> 33) & 8191) % 4001)
        rng = rng ^ (rng << 13)
        rng = rng ^ (rng >> 7)
        rng = rng ^ (rng << 17)
        let jy: int32 = int32(((rng >> 33) & 8191) % 4001)
        rootJx = rootJx + float64(jx - 2000) / 1000000.0
        rootJy = rootJy + float64(jy - 2000) / 1000000.0
    ballSlot = DuckAssemble(w, rootJx, rootJy, DuckGroundRootZ)
    DuckPlateAttach(w)
    var ticks: int64 = 1200
    let tenv: str = os.GetEnvDefault("DUCK_EVAL_TICKS", "")
    if tenv.len > 0:
        ticks = int64(ParseDigits(tenv))
    var sv: int64 = 0
    var up: float64 = 0.0
    PolicyRollout(w, ticks, sv, up)
    var fit: float64 = float64(sv) + up
    let upx = 2.0 * (w.bodyQuatX[0] * w.bodyQuatZ[0] + w.bodyQuatW[0] * w.bodyQuatY[0])
    if upx > -1.0 and upx < 1.0:
        fit = fit + 200.0 * (1.0 - upx * upx)
    echo("EVAL fit=" + DuckFmtMm(fit) + " sv=" + strings.Int64ToStr(sv) + " up=" + DuckFmtMm(up) + " upx=" + DuckFmtMm(upx) + " survived=" + strings.Int64ToStr(sv))
    return 0

# DUCK_POLICY=<paramfile>: load a CEM-trained standing policy into the
# INTERACTIVE ground episode. Same 256 signed-milli layout as
# --standeval; the policy owns the goal side (stance + delta on hips/
# ankles every tick) while the engine stack stays exactly the validated
# passive one — identical decomposition to PolicyRollout, so a policy
# trained in standeval transfers bit-comparably.
fn DuckPolicyLoadFile(paramPath: str): int32 =
    let raw: str = os.ReadFile(paramPath)
    var vals: float64[PolicyParamN]
    var idx: int32 = 0
    var ci: int32 = 0
    var acc: int32 = 0
    var neg: bool = false
    var any: bool = false
    while ci < raw.len and idx < PolicyParamN:
        let cch: int32 = int32(raw[ci])
        if cch == 45:
            neg = true
        elif cch >= 48 and cch <= 57:
            acc = acc * 10 + (cch - 48)
            any = true
        elif cch == 10:
            if any:
                vals[idx] = float64(acc) / 1000.0
                if neg:
                    vals[idx] = 0.0 - vals[idx]
                idx = idx + 1
            acc = 0
            neg = false
            any = false
        ci = ci + 1
    if any and idx < PolicyParamN:
        vals[idx] = float64(acc) / 1000.0
        if neg:
            vals[idx] = 0.0 - vals[idx]
        idx = idx + 1
    if idx == 256:
        # v2 champion pad: identical to RunStandEval's conversion
        var oldB0: float64 = vals[252]
        var oldB1: float64 = vals[253]
        var oldB2: float64 = vals[254]
        var oldB3: float64 = vals[255]
        var zi3: int32 = 252
        while zi3 < 276:
            vals[zi3] = 0.0
            zi3 = zi3 + 1
        vals[276] = oldB0
        vals[277] = oldB1
        vals[278] = oldB2
        vals[279] = oldB3
        idx = 282
    if idx == 282:
        # v3 champion pad: relocate B2 (6 entries) past the zeroed roll
        # W2 rows — knee rows stay live, roll deltas start at 0
        var vB0: float64 = vals[276]
        var vB1: float64 = vals[277]
        var vB2: float64 = vals[278]
        var vB3: float64 = vals[279]
        var vB4: float64 = vals[280]
        var vB5: float64 = vals[281]
        var zi4: int32 = 276
        while zi4 < 300:
            vals[zi4] = 0.0
            zi4 = zi4 + 1
        vals[300] = vB0
        vals[301] = vB1
        vals[302] = vB2
        vals[303] = vB3
        vals[304] = vB4
        vals[305] = vB5
        idx = 308
    if idx == 308:
        # v5 champion relayout: identical to RunStandEval's conversion —
        # new W1 rows 0-11 obs cols 0-15 = old W1 (192 in order), cols
        # 16-21 = 0, rows 12-23 all 0; new B1 = old B1 + 12 zeros; new
        # W2 rows (8) hidden cols 0-11 = old W2 (96 in order), cols
        # 12-23 = 0; new B2 = old B2.
        var nv: float64[PolicyParamN]
        var r5: int32 = 0
        while r5 < 12:
            var c5: int32 = 0
            while c5 < 16:
                nv[r5 * PolicyObsN + c5] = vals[r5 * 16 + c5]
                c5 = c5 + 1
            while c5 < PolicyObsN:
                nv[r5 * PolicyObsN + c5] = 0.0
                c5 = c5 + 1
            r5 = r5 + 1
        while r5 < PolicyHidN:
            var c5: int32 = 0
            while c5 < PolicyObsN:
                nv[r5 * PolicyObsN + c5] = 0.0
                c5 = c5 + 1
            r5 = r5 + 1
        var b5: int32 = 0
        while b5 < 12:
            nv[PolicyObsN * PolicyHidN + b5] = vals[192 + b5]
            b5 = b5 + 1
        while b5 < PolicyHidN:
            nv[PolicyObsN * PolicyHidN + b5] = 0.0
            b5 = b5 + 1
        var o5: int32 = 0
        while o5 < PolicyOutN:
            var h5: int32 = 0
            while h5 < 12:
                nv[PolicyObsN * PolicyHidN + PolicyHidN + o5 * PolicyHidN + h5] = vals[204 + o5 * 12 + h5]
                h5 = h5 + 1
            while h5 < PolicyHidN:
                nv[PolicyObsN * PolicyHidN + PolicyHidN + o5 * PolicyHidN + h5] = 0.0
                h5 = h5 + 1
            o5 = o5 + 1
        var z5: int32 = 0
        while z5 < PolicyOutN:
            nv[PolicyObsN * PolicyHidN + PolicyHidN + PolicyHidN * PolicyOutN + z5] = vals[300 + z5]
            z5 = z5 + 1
        var p5: int32 = 0
        while p5 < PolicyParamN:
            vals[p5] = nv[p5]
            p5 = p5 + 1
        idx = 752
    if idx == 752:
        # v5 (hid 24) champion relayout: hidden 24 -> 48. New W1 rows
        # 24-47 all 0, new B1 rows 24-47 = 0, new W2 hidden cols 24-47
        # = 0; rows/cols 0-23 verbatim. Silent new hidden units make
        # the 1496 net mathematically identical to the 752 layout.
        var nv6: float64[PolicyParamN]
        var z6: int32 = 0
        while z6 < PolicyParamN:
            nv6[z6] = 0.0
            z6 = z6 + 1
        var h6: int32 = 0
        while h6 < 24:
            var c6: int32 = 0
            while c6 < PolicyObsN:
                nv6[h6 * PolicyObsN + c6] = vals[h6 * PolicyObsN + c6]
                c6 = c6 + 1
            nv6[PolicyObsN * PolicyHidN + h6] = vals[PolicyObsN * 24 + h6]
            h6 = h6 + 1
        var o6: int32 = 0
        while o6 < PolicyOutN:
            var h6b: int32 = 0
            while h6b < 24:
                nv6[PolicyObsN * PolicyHidN + PolicyHidN + o6 * PolicyHidN + h6b] = vals[PolicyObsN * 24 + 24 + o6 * 24 + h6b]
                h6b = h6b + 1
            nv6[PolicyObsN * PolicyHidN + PolicyHidN + PolicyHidN * PolicyOutN + o6] = vals[PolicyObsN * 24 + 24 + 8 * 24 + o6]
            o6 = o6 + 1
        var p6: int32 = 0
        while p6 < PolicyParamN:
            vals[p6] = nv6[p6]
            p6 = p6 + 1
        idx = 1496
    if idx < PolicyParamN:
        return 1
    var pi: int32 = 0
    while pi < PolicyObsN * PolicyHidN:
        polW1[pi] = vals[pi]
        pi = pi + 1
    while pi < PolicyObsN * PolicyHidN + PolicyHidN:
        polB1[pi - PolicyObsN * PolicyHidN] = vals[pi]
        pi = pi + 1
    let o2: int32 = PolicyObsN * PolicyHidN + PolicyHidN
    while pi < o2 + PolicyHidN * PolicyOutN:
        polW2[pi - o2] = vals[pi]
        pi = pi + 1
    let o3: int32 = o2 + PolicyHidN * PolicyOutN
    while pi < o3 + PolicyOutN:
        polB2[pi - o3] = vals[pi]
        pi = pi + 1
    var zi: int32 = 0
    while zi < PolicyCtxN:
        polCtx[zi] = 0.0
        zi = zi + 1
    return 0

# One interactive policy tick: observation -> Elman forward -> stance +
# clamped delta goals on hips/ankles. Mirrors the PolicyRollout inner
# loop exactly (obs scaling, tanh cage, memory leak 0.7/0.3) minus the
# stepping, which stays owned by the interactive loop.
@borrows
fn DuckPolicyTick(w: var World3d) =
    var obs: float64[PolicyObsN]
    var out: float64[PolicyOutN]
    var hid: float64[PolicyHidN]
    let tors: int32 = mm.MicroduckLinkTorso
    let qw = w.bodyQuatW[tors]
    let qx = w.bodyQuatX[tors]
    let qy = w.bodyQuatY[tors]
    let qz = w.bodyQuatZ[tors]
    obs[0] = 2.0 * (qx * qz + qw * qy)
    obs[1] = 2.0 * (qy * qz - qw * qx)
    obs[2] = w.bodyVx[tors]
    obs[3] = w.bodyVy[tors]
    obs[4] = w.bodyAngVx[tors]
    obs[5] = w.bodyAngVy[tors]
    obs[6] = constraints3d.Constraints3dHingeAngle(w, duckCiHipL) * 57.29577951308232 / 90.0
    obs[7] = constraints3d.Constraints3dHingeAngle(w, duckCiHipR) * 57.29577951308232 / 90.0
    obs[8] = constraints3d.Constraints3dHingeAngle(w, duckCiKneeL) / 90.0
    obs[9] = constraints3d.Constraints3dHingeAngle(w, duckCiKneeR) / 90.0
    let hL = w.bodyCapsuleHalf[DuckLinkFootL]
    let axL = 2.0 * (w.bodyQuatX[DuckLinkFootL] * w.bodyQuatZ[DuckLinkFootL] + w.bodyQuatW[DuckLinkFootL] * w.bodyQuatY[DuckLinkFootL])
    let azL = 1.0 - 2.0 * (w.bodyQuatX[DuckLinkFootL] * w.bodyQuatX[DuckLinkFootL] + w.bodyQuatY[DuckLinkFootL] * w.bodyQuatY[DuckLinkFootL])
    let hR = w.bodyCapsuleHalf[DuckLinkFootR]
    let axR = 2.0 * (w.bodyQuatX[DuckLinkFootR] * w.bodyQuatZ[DuckLinkFootR] + w.bodyQuatW[DuckLinkFootR] * w.bodyQuatY[DuckLinkFootR])
    let azR = 1.0 - 2.0 * (w.bodyQuatX[DuckLinkFootR] * w.bodyQuatX[DuckLinkFootR] + w.bodyQuatY[DuckLinkFootR] * w.bodyQuatY[DuckLinkFootR])
    obs[10] = (w.bodyPz[DuckLinkFootL] - hL * m.absFloat(azL) - w.bodyRadius[DuckLinkFootL]) * 100.0
    obs[11] = (w.bodyPz[DuckLinkFootR] - hR * m.absFloat(azR) - w.bodyRadius[DuckLinkFootR]) * 100.0
    obs[12] = (w.bodyPy[DuckLinkFootL] - w.bodyPy[DuckLinkFootR]) * 10.0
    obs[13] = constraints3d.Constraints3dHingeAngle(w, duckCiAnkleL) * 57.29577951308232 / 90.0
    obs[14] = constraints3d.Constraints3dHingeAngle(w, duckCiAnkleR) * 57.29577951308232 / 90.0
    obs[15] = w.bodyAngVz[tors]
    # v5 obs 16-21: per-driven-hinge axis-relative angular rate
    # wrel = (wB - wA) . u_world, rad/s / 10; u = body-A quat
    # rotating the local hinge axis to world (same math as the
    # physics3d joint-damping wrel, inlined to keep the module
    # interface closed). Keep line-identical to PolicyRollout.
    let s16a: int32 = w.conA[duckCiHipL]
    let s16b: int32 = w.conB[duckCiHipL]
    let q16w: float64 = w.bodyQuatW[s16a]
    let q16x: float64 = w.bodyQuatX[s16a]
    let q16y: float64 = w.bodyQuatY[s16a]
    let q16z: float64 = w.bodyQuatZ[s16a]
    let l16x: float64 = w.conAxisAx[duckCiHipL]
    let l16y: float64 = w.conAxisAy[duckCiHipL]
    let l16z: float64 = w.conAxisAz[duckCiHipL]
    let u16x: float64 = (1.0 - 2.0 * (q16y * q16y + q16z * q16z)) * l16x + 2.0 * (q16x * q16y - q16z * q16w) * l16y + 2.0 * (q16x * q16z + q16y * q16w) * l16z
    let u16y: float64 = 2.0 * (q16x * q16y + q16z * q16w) * l16x + (1.0 - 2.0 * (q16x * q16x + q16z * q16z)) * l16y + 2.0 * (q16y * q16z - q16x * q16w) * l16z
    let u16z: float64 = 2.0 * (q16x * q16z - q16y * q16w) * l16x + 2.0 * (q16y * q16z + q16x * q16w) * l16y + (1.0 - 2.0 * (q16x * q16x + q16y * q16y)) * l16z
    obs[16] = ((w.bodyAngVx[s16b] - w.bodyAngVx[s16a]) * u16x + (w.bodyAngVy[s16b] - w.bodyAngVy[s16a]) * u16y + (w.bodyAngVz[s16b] - w.bodyAngVz[s16a]) * u16z) / 10.0
    let s17a: int32 = w.conA[duckCiHipR]
    let s17b: int32 = w.conB[duckCiHipR]
    let q17w: float64 = w.bodyQuatW[s17a]
    let q17x: float64 = w.bodyQuatX[s17a]
    let q17y: float64 = w.bodyQuatY[s17a]
    let q17z: float64 = w.bodyQuatZ[s17a]
    let l17x: float64 = w.conAxisAx[duckCiHipR]
    let l17y: float64 = w.conAxisAy[duckCiHipR]
    let l17z: float64 = w.conAxisAz[duckCiHipR]
    let u17x: float64 = (1.0 - 2.0 * (q17y * q17y + q17z * q17z)) * l17x + 2.0 * (q17x * q17y - q17z * q17w) * l17y + 2.0 * (q17x * q17z + q17y * q17w) * l17z
    let u17y: float64 = 2.0 * (q17x * q17y + q17z * q17w) * l17x + (1.0 - 2.0 * (q17x * q17x + q17z * q17z)) * l17y + 2.0 * (q17y * q17z - q17x * q17w) * l17z
    let u17z: float64 = 2.0 * (q17x * q17z - q17y * q17w) * l17x + 2.0 * (q17y * q17z + q17x * q17w) * l17y + (1.0 - 2.0 * (q17x * q17x + q17y * q17y)) * l17z
    obs[17] = ((w.bodyAngVx[s17b] - w.bodyAngVx[s17a]) * u17x + (w.bodyAngVy[s17b] - w.bodyAngVy[s17a]) * u17y + (w.bodyAngVz[s17b] - w.bodyAngVz[s17a]) * u17z) / 10.0
    let s18a: int32 = w.conA[duckCiKneeL]
    let s18b: int32 = w.conB[duckCiKneeL]
    let q18w: float64 = w.bodyQuatW[s18a]
    let q18x: float64 = w.bodyQuatX[s18a]
    let q18y: float64 = w.bodyQuatY[s18a]
    let q18z: float64 = w.bodyQuatZ[s18a]
    let l18x: float64 = w.conAxisAx[duckCiKneeL]
    let l18y: float64 = w.conAxisAy[duckCiKneeL]
    let l18z: float64 = w.conAxisAz[duckCiKneeL]
    let u18x: float64 = (1.0 - 2.0 * (q18y * q18y + q18z * q18z)) * l18x + 2.0 * (q18x * q18y - q18z * q18w) * l18y + 2.0 * (q18x * q18z + q18y * q18w) * l18z
    let u18y: float64 = 2.0 * (q18x * q18y + q18z * q18w) * l18x + (1.0 - 2.0 * (q18x * q18x + q18z * q18z)) * l18y + 2.0 * (q18y * q18z - q18x * q18w) * l18z
    let u18z: float64 = 2.0 * (q18x * q18z - q18y * q18w) * l18x + 2.0 * (q18y * q18z + q18x * q18w) * l18y + (1.0 - 2.0 * (q18x * q18x + q18y * q18y)) * l18z
    obs[18] = ((w.bodyAngVx[s18b] - w.bodyAngVx[s18a]) * u18x + (w.bodyAngVy[s18b] - w.bodyAngVy[s18a]) * u18y + (w.bodyAngVz[s18b] - w.bodyAngVz[s18a]) * u18z) / 10.0
    let s19a: int32 = w.conA[duckCiKneeR]
    let s19b: int32 = w.conB[duckCiKneeR]
    let q19w: float64 = w.bodyQuatW[s19a]
    let q19x: float64 = w.bodyQuatX[s19a]
    let q19y: float64 = w.bodyQuatY[s19a]
    let q19z: float64 = w.bodyQuatZ[s19a]
    let l19x: float64 = w.conAxisAx[duckCiKneeR]
    let l19y: float64 = w.conAxisAy[duckCiKneeR]
    let l19z: float64 = w.conAxisAz[duckCiKneeR]
    let u19x: float64 = (1.0 - 2.0 * (q19y * q19y + q19z * q19z)) * l19x + 2.0 * (q19x * q19y - q19z * q19w) * l19y + 2.0 * (q19x * q19z + q19y * q19w) * l19z
    let u19y: float64 = 2.0 * (q19x * q19y + q19z * q19w) * l19x + (1.0 - 2.0 * (q19x * q19x + q19z * q19z)) * l19y + 2.0 * (q19y * q19z - q19x * q19w) * l19z
    let u19z: float64 = 2.0 * (q19x * q19z - q19y * q19w) * l19x + 2.0 * (q19y * q19z + q19x * q19w) * l19y + (1.0 - 2.0 * (q19x * q19x + q19y * q19y)) * l19z
    obs[19] = ((w.bodyAngVx[s19b] - w.bodyAngVx[s19a]) * u19x + (w.bodyAngVy[s19b] - w.bodyAngVy[s19a]) * u19y + (w.bodyAngVz[s19b] - w.bodyAngVz[s19a]) * u19z) / 10.0
    let s20a: int32 = w.conA[duckCiAnkleL]
    let s20b: int32 = w.conB[duckCiAnkleL]
    let q20w: float64 = w.bodyQuatW[s20a]
    let q20x: float64 = w.bodyQuatX[s20a]
    let q20y: float64 = w.bodyQuatY[s20a]
    let q20z: float64 = w.bodyQuatZ[s20a]
    let l20x: float64 = w.conAxisAx[duckCiAnkleL]
    let l20y: float64 = w.conAxisAy[duckCiAnkleL]
    let l20z: float64 = w.conAxisAz[duckCiAnkleL]
    let u20x: float64 = (1.0 - 2.0 * (q20y * q20y + q20z * q20z)) * l20x + 2.0 * (q20x * q20y - q20z * q20w) * l20y + 2.0 * (q20x * q20z + q20y * q20w) * l20z
    let u20y: float64 = 2.0 * (q20x * q20y + q20z * q20w) * l20x + (1.0 - 2.0 * (q20x * q20x + q20z * q20z)) * l20y + 2.0 * (q20y * q20z - q20x * q20w) * l20z
    let u20z: float64 = 2.0 * (q20x * q20z - q20y * q20w) * l20x + 2.0 * (q20y * q20z + q20x * q20w) * l20y + (1.0 - 2.0 * (q20x * q20x + q20y * q20y)) * l20z
    obs[20] = ((w.bodyAngVx[s20b] - w.bodyAngVx[s20a]) * u20x + (w.bodyAngVy[s20b] - w.bodyAngVy[s20a]) * u20y + (w.bodyAngVz[s20b] - w.bodyAngVz[s20a]) * u20z) / 10.0
    let s21a: int32 = w.conA[duckCiAnkleR]
    let s21b: int32 = w.conB[duckCiAnkleR]
    let q21w: float64 = w.bodyQuatW[s21a]
    let q21x: float64 = w.bodyQuatX[s21a]
    let q21y: float64 = w.bodyQuatY[s21a]
    let q21z: float64 = w.bodyQuatZ[s21a]
    let l21x: float64 = w.conAxisAx[duckCiAnkleR]
    let l21y: float64 = w.conAxisAy[duckCiAnkleR]
    let l21z: float64 = w.conAxisAz[duckCiAnkleR]
    let u21x: float64 = (1.0 - 2.0 * (q21y * q21y + q21z * q21z)) * l21x + 2.0 * (q21x * q21y - q21z * q21w) * l21y + 2.0 * (q21x * q21z + q21y * q21w) * l21z
    let u21y: float64 = 2.0 * (q21x * q21y + q21z * q21w) * l21x + (1.0 - 2.0 * (q21x * q21x + q21z * q21z)) * l21y + 2.0 * (q21y * q21z - q21x * q21w) * l21z
    let u21z: float64 = 2.0 * (q21x * q21z - q21y * q21w) * l21x + 2.0 * (q21y * q21z + q21x * q21w) * l21y + (1.0 - 2.0 * (q21x * q21x + q21y * q21y)) * l21z
    obs[21] = ((w.bodyAngVx[s21b] - w.bodyAngVx[s21a]) * u21x + (w.bodyAngVy[s21b] - w.bodyAngVy[s21a]) * u21y + (w.bodyAngVz[s21b] - w.bodyAngVz[s21a]) * u21z) / 10.0
    var hi: int32 = 0
    while hi < PolicyHidN:
        var acc: float64 = polB1[hi]
        var ctxTerm: float64 = polCtx[hi] * 0.7
        var jj: int32 = 0
        # legacy cols 0-15 carry the context term INSIDE the obs
        # loop (the trained ctx gain is 16*0.7); the split keeps
        # the old FP summation order bit-exact while cols 16-21
        # stay pure (zero-weight for the 308 champion) obs inputs
        while jj < PolicyObsLegacyN:
            acc = acc + polW1[hi * PolicyObsN + jj] * obs[jj]
            acc = acc + ctxTerm
            jj = jj + 1
        while jj < PolicyObsN:
            acc = acc + polW1[hi * PolicyObsN + jj] * obs[jj]
            jj = jj + 1
        if acc > 3.0:
            acc = 3.0
        if acc < 0.0 - 3.0:
            acc = 0.0 - 3.0
        acc = acc - acc * acc * acc / 27.0
        polCtx[hi] = polCtx[hi] * 0.7 + acc * 0.3
        hid[hi] = acc
        hi = hi + 1
    var oi: int32 = 0
    while oi < PolicyOutN:
        var acc: float64 = polB2[oi]
        var jj: int32 = 0
        while jj < PolicyHidN:
            acc = acc + polW2[oi * PolicyHidN + jj] * hid[jj]
            jj = jj + 1
        out[oi] = acc
        oi = oi + 1
    var dHipL: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[0]))
    var dHipR: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[1]))
    var dAnkL: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[2]))
    var dAnkR: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[3]))
    var dKneeL: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[4]))
    var dKneeR: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[5]))
    var dRollL: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[6]))
    var dRollR: float64 = m.maxFloat(0.0 - 0.35, m.minFloat(0.35, out[7]))
    if duckPolKneeBaseInit == 0:
        duckPolKneeBaseLm = int32(w.conGoal[duckCiKneeL] * 1000.0)
        duckPolKneeBaseRm = int32(w.conGoal[duckCiKneeR] * 1000.0)
        duckPolRollBaseLm = int32(w.conGoal[duckCiYokeL] * 1000.0)
        duckPolRollBaseRm = int32(w.conGoal[duckCiYokeR] * 1000.0)
        duckPolKneeBaseInit = 1
    let st = mm.MicroduckStanceHipRad
    w.conGoal[duckCiHipL] = st + dHipL
    w.conGoal[duckCiHipR] = 0.0 - st + dHipR
    w.conGoal[duckCiAnkleL] = 0.0 - st + dAnkL
    w.conGoal[duckCiAnkleR] = st + dAnkR
    w.conGoal[duckCiKneeL] = float64(duckPolKneeBaseLm) / 1000.0 + dKneeL
    w.conGoal[duckCiKneeR] = float64(duckPolKneeBaseRm) / 1000.0 + dKneeR
    w.conGoal[duckCiYokeL] = float64(duckPolRollBaseLm) / 1000.0 + dRollL
    w.conGoal[duckCiYokeR] = float64(duckPolRollBaseRm) / 1000.0 + dRollR
    if duckGoalEchoOn == 1:
        let et: int64 = w.tick + 0
        if et % 16 == 0:
            let eHL: float64 = w.conGoal[duckCiHipL] + 0.0
            let eKL: float64 = w.conGoal[duckCiKneeL] + 0.0
            echo("GP t=" + strings.Int64ToStr(et) + " hL=" + DuckFmtMm(eHL) + " kL=" + DuckFmtMm(eKL))

fn RunStandCem(): int32 =
    echo("SCEM start")
    # env-tunable scale (overnight budget): SCEM_POP/SCEM_GENS/SCEM_TICKS
    var pop: int32 = 8
    var gens: int32 = 4
    var ticks: int64 = 400
    let penv: str = os.GetEnvDefault("SCEM_POP", "")
    if penv.len > 0:
        let n: int32 = ParseDigits(penv)
        if n > 0 and n <= 8:
            pop = n
    let genv: str = os.GetEnvDefault("SCEM_GENS", "")
    if genv.len > 0:
        let n: int32 = ParseDigits(genv)
        if n > 0:
            gens = n
    let tenv: str = os.GetEnvDefault("SCEM_TICKS", "")
    if tenv.len > 0:
        let n: int32 = ParseDigits(tenv)
        if n > 0:
            ticks = int64(n)
    let eliteN: int32 = 2
    echo("SCEM stage1")
    var mean: float64[PolicyParamN]
    var stdev: float64[PolicyParamN]
    var pi: int32 = 0
    while pi < PolicyParamN:
        mean[pi] = 0.0
        stdev[pi] = 0.5
        pi = pi + 1
    echo("SCEM stage2")
    echo("SCEM stage3")
    var g: int32 = 0
    while g < gens:
        echo("SCEM stage4 g=" + strings.IntToStr(g))
        var fit: float64[8]
        var wts: float64[8 * PolicyParamN]
        var k: int32 = 0
        while k < pop:
            echo("SCEM stage5a sampling k=" + strings.IntToStr(k))
            # sample weights
            pi = 0
            while pi < PolicyParamN:
                # box-muller-free: sum of 3 uniforms ≈ gaussian-ish
                let r1: float64 = CemRandNorm()
                let r2: float64 = CemRandNorm()
                let r3: float64 = CemRandNorm()
                wts[k * PolicyParamN + pi] = mean[pi] + stdev[pi] * (r1 + r2 + r3) * 0.7071067811865476
                pi = pi + 1
            echo("SCEM stage5b sampled k=" + strings.IntToStr(k))
            # load into the policy arrays
            pi = 0
            while pi < PolicyObsN * PolicyHidN:
                polW1[pi] = wts[k * PolicyParamN + pi]
                pi = pi + 1
            while pi < PolicyObsN * PolicyHidN + PolicyHidN:
                polB1[pi - PolicyObsN * PolicyHidN] = wts[k * PolicyParamN + pi]
                pi = pi + 1
            let o2: int32 = PolicyObsN * PolicyHidN + PolicyHidN
            while pi < o2 + PolicyHidN * PolicyOutN:
                polW2[pi - o2] = wts[k * PolicyParamN + pi]
                pi = pi + 1
            let o3: int32 = o2 + PolicyHidN * PolicyOutN
            while pi < o3 + PolicyOutN:
                polB2[pi - o3] = wts[k * PolicyParamN + pi]
                pi = pi + 1
            # rollout
            echo("SCEM stage5 assembling")
            var w: world3d.World3d
            echo("SCEM assembling g=" + strings.IntToStr(g) + " k=" + strings.IntToStr(k))
            var sv: int64 = 0
            var up: float64 = 0.0
            world3d.World3dReset(w, int64(977) + int64(g) * 17 + int64(k))
            var ballSlot: int32 = 0
            ballSlot = DuckAssemble(w, DuckGroundRootX, DuckGroundRootY, DuckGroundRootZ)
            PolicyRollout(w, ticks, sv, up)
            # NaN guard: a single non-finite rollout must not poison
            # the elite statistics (the CEM mean/var update would
            # propagate NaN into every subsequent sample)
            var fitK: float64 = float64(sv) + up
            if !(fitK > 0.0 - 1000000000.0) or !(fitK < 1000000000.0):
                fitK = 0.0
            # 俯仰平衡奖励：躯干 pitch 接近零时额外加分，引导 CEM
            # 找到让髋保持在 stance 位（不前倾不后仰）的参数
            let upx = 2.0 * (w.bodyQuatX[0] * w.bodyQuatZ[0] + w.bodyQuatW[0] * w.bodyQuatY[0])
            if !(upx > 0.0 - 100.0) or !(upx < 100.0):
                upx = 0.0
            fitK = fitK + 200.0 * (1.0 - upx * upx)
            echo("SCEM g=" + strings.IntToStr(g) + " k=" + strings.IntToStr(k) + " fit=" + DuckFmtMm(fit[k]) + " survived=" + strings.Int64ToStr(sv))
            k = k + 1
        # rank: bubble the top eliteN by fitness
        var order: int32[8]
        var oi: int32 = 0
        while oi < pop:
            order[oi] = oi
            oi = oi + 1
        var a2: int32 = 0
        while a2 < pop:
            var b2: int32 = a2 + 1
            while b2 < pop:
                if fit[order[b2]] > fit[order[a2]]:
                    var tmp: int32 = order[a2]
                    order[a2] = order[b2]
                    order[b2] = tmp
                b2 = b2 + 1
            a2 = a2 + 1
        # update mean/stdev from elites
        pi = 0
        while pi < PolicyParamN:
            var mSum: float64 = 0.0
            var mSq: float64 = 0.0
            var ei: int32 = 0
            while ei < eliteN:
                let idx: int32 = order[ei]
                mSum = mSum + wts[idx * PolicyParamN + pi]
                mSq = mSq + wts[idx * PolicyParamN + pi] * wts[idx * PolicyParamN + pi]
                ei = ei + 1
            let newMean: float64 = mSum / float64(eliteN)
            let varr: float64 = mSq / float64(eliteN) - newMean * newMean
            mean[pi] = newMean
            if varr > 0.0:
                stdev[pi] = numerics.CsgSqrt(varr) * 0.9
            if stdev[pi] < 0.05:
                stdev[pi] = 0.01
            pi = pi + 1
        g = g + 1
    # echo the champion weights (mean after final update)
    echo("SCEM CHAMPION mean:")
    pi = 0
    var line: str = ""
    while pi < PolicyParamN:
        line = line + DuckFmtMm(mean[pi]) + ","
        pi = pi + 1
    echo(line)
    return 0

fn DuckParseSignedEnv(text: str): int32 =
    var acc: int32 = 0
    var neg: bool = false
    var i: int32 = 0
    while i < text.len:
        let c: int32 = int32(text[i])
        if c == 45:
            neg = true
        elif c >= 48 and c <= 57:
            acc = acc * 10 + (c - 48)
        i = i + 1
    if neg:
        acc = 0 - acc
    return acc

fn RunDuck(): int32 =
    # startup section (outside any physics loop): the official STL
    # handle table, once per process
    DuckMeshesLoad()
    DuckMeshInstTableInit()
    # DUCK_GROUND=1 / DUCK_WALK=1 env: deterministic acceptance latches
    # (ground spawn / gait on at episode start)
    if os.GetEnvDefault("DUCK_GROUND", "") == "1":
        duckGroundSpawn = true
    if os.GetEnvDefault("DUCK_WALK", "") == "1":
        duckWalkLatch = true
    if os.GetEnvDefault("DUCK_BALANCE", "") == "0":
        duckBalanceOn = false
    if os.GetEnvDefault("DUCK_RESID_ECHO", "") == "1":
        duckResidEcho = true
    if os.GetEnvDefault("DUCK_DV_ECHO", "") == "1":
        physics3d.physics3dDvEcho = 1
    if os.GetEnvDefault("DUCK_HEAD_FREE", "") == "1":
        duckHeadFree = true
    if os.GetEnvDefault("DUCK_HEAD_WELD", "") == "1":
        duckHeadWeld = true
    if os.GetEnvDefault("DUCK_FOOT_PLATE", "") == "1":
        duckFootPlate = true
    let polPath: str = os.GetEnvDefault("DUCK_POLICY", "")
    if polPath.len > 0:
        let prc: int32 = DuckPolicyLoadFile(polPath)
        if prc != 0:
            panic("duckmode: DUCK_POLICY param file incomplete")
        duckPolicyOn = 1
        let gee: str = os.GetEnvDefault("DUCK_GOAL_ECHO", "")
        if gee.len > 0:
            duckGoalEchoOn = ParseDigits(gee)
    let rgText: str = os.GetEnvDefault("DUCK_ROLL_GAIN", "")
    if rgText.len > 0:
        duckRollGainM = ParseDigits(rgText)
    let rcText: str = os.GetEnvDefault("DUCK_ROLL_CLAMP", "")
    if rcText.len > 0:
        duckRollClampM = ParseDigits(rcText)
    let ppText: str = os.GetEnvDefault("DUCK_PD_P", "")
    if ppText.len > 0:
        duckPdPM = ParseDigits(ppText)
    let pdText: str = os.GetEnvDefault("DUCK_PD_D", "")
    if pdText.len > 0:
        duckPdDM = ParseDigits(pdText)
    let rdText: str = os.GetEnvDefault("DUCK_ROLL_DIV", "")
    if rdText.len > 0:
        duckRollDivN = ParseDigits(rdText)
    if os.GetEnvDefault("DUCK_HINGE_ECHO", "") != "":
        constraints3d.constraints3dHingeEchoOn = 1
        constraints3d.constraints3dHingeEchoCi = ParseDigits(os.GetEnvDefault("DUCK_HINGE_ECHO", "9"))
    let axText: str = os.GetEnvDefault("DUCK_ANKLE_EXTRA_M", "")
    if axText.len > 0:
        duckAnkleExtraM = ParseDigits(axText)
    let pkText: str = os.GetEnvDefault("DUCK_PAD_K", "")
    if pkText.len > 0:
        physics3d.physics3dFootPadKN = ParseDigits(pkText)
    let raText: str = os.GetEnvDefault("DUCK_ROLL_ANKLE_M", "")
    if raText.len > 0:
        duckRollAnkleM = DuckParseSignedEnv(raText)
    let ytText: str = os.GetEnvDefault("DUCK_YOKE_TRUE_ROLL", "")
    if ytText.len > 0:
        let ytV: int32 = DuckParseSignedEnv(ytText)
        if ytV > 0:
            duckYokeTrueRollS = 1
        if ytV < 0:
            duckYokeTrueRollS = 0 - 1
    if os.GetEnvDefault("DUCK_BAL_FULL", "") == "1":
        duckBalFull = true
    let bkaText: str = os.GetEnvDefault("DUCK_BAL_KA", "")
    if bkaText.len > 0:
        duckBalKAM = ParseDigits(bkaText)
    let bkdText: str = os.GetEnvDefault("DUCK_BAL_KD", "")
    if bkdText.len > 0:
        duckBalKDM = ParseDigits(bkdText)
    if os.GetEnvDefault("DUCK_FOOT_PAD", "") == "1":
        physics3d.physics3dFootPadOn = 1
    if os.GetEnvDefault("DUCK_POLE_ECHO", "") == "1":
        physics3d.physics3dPoleEchoOn = 1
    if os.GetEnvDefault("DUCK_SUPPORT_STAND", "") == "1":
        constraints3d.constraints3dSupportStanding = 1
    let dtText: str = os.GetEnvDefault("DUCK_DT_DIV", "")
    if dtText.len > 0:
        physics3d.physics3dDtDivN = ParseDigits(dtText)
    if os.GetEnvDefault("DUCK_ROLL_REACTIVE", "") == "0":
        physics3d.physics3dRollReactiveOn = 0
    let gmText: str = os.GetEnvDefault("DUCK_GATE_MM", "")
    if gmText.len > 0:
        physics3d.physics3dGateScaleM = ParseDigits(gmText)
    if os.GetEnvDefault("DUCK_VPROJ", "") == "1":
        physics3d.physics3dVprojOn = 1
    if os.GetEnvDefault("DUCK_CONTACT_CHAIN", "") == "1":
        physics3d.physics3dContactChainOn = 1
    if os.GetEnvDefault("DUCK_SWEEP_ECHO", "") == "1":
        duckSweepEchoOn = 1
    let seText: str = os.GetEnvDefault("DUCK_SWEEP_EXIT_MM", "")
    if seText.len > 0:
        constraints3d.constraints3dBaseExitMm = ParseDigits(seText)
    let rmText: str = os.GetEnvDefault("DUCK_REFINE_MAX", "")
    if rmText.len > 0:
        physics3d.physics3dRefineMaxN = ParseDigits(rmText)
    if os.GetEnvDefault("DUCK_JOINT_DAMP", "") == "1":
        physics3d.physics3dJointDampOn = 1
    let jdText: str = os.GetEnvDefault("DUCK_JOINT_DAMP_CM", "")
    if jdText.len > 0:
        physics3d.physics3dJointDampCmM = ParseDigits(jdText)
    let kdText: str = os.GetEnvDefault("DUCK_SERVO_KD_M", "")
    if kdText.len > 0:
        physics3d.physics3dServoKdM = ParseDigits(kdText)
    # actuator authority probe: uniform hinge-servo cap overrides applied
    # to every servo (milli-rad-s / milli-Nm), 0 = assembled defaults
    let soText: str = os.GetEnvDefault("DUCK_SERVO_OMEGA_M", "")
    if soText.len > 0:
        physics3d.physics3dServoOmegaM = ParseDigits(soText)
    let stMText: str = os.GetEnvDefault("DUCK_SERVO_TAUM_M", "")
    if stMText.len > 0:
        physics3d.physics3dServoTauM = ParseDigits(stMText)
    if duckMeshOk:
        echo("DUCKMODE mesh_render=stl handles=" + strings.IntToStr(DuckMeshHandleCount))
    else:
        echo("DUCKMODE mesh_render unavailable, sphere impostor fallback")
    var rc: int32 = DuckEpisode()
    while rc == 2:
        rc = DuckEpisode()
    return rc

# ---- interactive play mode (--play:<world.csgworld>) ----
#
# The game: the live world runs in a real NSWindow at 240 Hz authority
# ticks; the keyboard injects verified behaviors — W walks 4 shuffling
# steps, J jumps (whole-figure ballistic hop, see PlayJump* constants),
# 1/2/3 switches the camera, C toggles the pelvis-follow camera
# (smoothed look-at with a fixed offset, see FollowOffset below),
# ESC/Q quits. Every interaction is
# recorded into a session file as (tick, verb, arg); on exit the session
# is deterministically replayed headless and the final chainCid is
# compared against the live run — same inputs, same world, provably.
# --script:<file> feeds the same event source from a file (acceptance
# runs without a human): lines of "<tick> WALK <n>" | "<tick> CAM <c>"
# | "<tick> JUMP" | "<tick> Q".

type
    PlaySchedule =
        count: int32
        ticks: int64[]
        kinds: int32[]   # 1 = WALK, 2 = CAM, 3 = Q, 4 = JUMP, 6 = LEAN
        args: int32[]

@borrows
fn PlayDigits(text: str, start: int32, len: int32): int32 =
    var v: int32 = 0
    var i: int32 = 0
    while i < len:
        let c: int32 = int32(text[start + i])
        if c < 48 or c > 57:
            return 0 - 1
        v = v * 10 + (c - 48)
        i = i + 1
    return v

# Signed integer token parse (optional '-' prefix): the LEAN dir
# argument is the only signed script/session field. -1 on empty or bad
# input, the same failure contract as PlayDigits.
fn PlaySignedDigits(text: str, start: int32, len: int32): int32 =
    if len <= 0:
        return 0 - 1
    if int32(text[start]) == 45:
        let v: int32 = PlayDigits(text, start + 1, len - 1)
        if v < 0:
            return 0 - 1
        return 0 - v
    return PlayDigits(text, start, len)

fn PlayScheduleAdd(sch: var PlaySchedule, tick: int64, kind: int32, arg: int32) =
    add(sch.ticks, tick)
    add(sch.kinds, kind)
    add(sch.args, arg)
    sch.count = sch.count + 1

fn PlayScheduleLoad(path: str, sch: var PlaySchedule, scriptSeed: var int64): bool =
    let text: str = os.ReadFile(path)
    if text.len == 0:
        return false
    var ls: int32[]
    setLen(ls, 0)
    var ll: int32[]
    setLen(ll, 0)
    var curStart: int32 = 0 - 1
    var ci: int32 = 0
    while ci <= text.len:
        var isSep: bool = ci == text.len
        if !isSep:
            if int32(text[ci]) == 10:
                isSep = true
        if isSep:
            if curStart >= 0:
                add(ls, curStart)
                add(ll, ci - curStart)
                curStart = 0 - 1
        else:
            if curStart < 0:
                curStart = ci
        ci = ci + 1
    var li: int32 = 0
    while li < ls.len:
        var trimmed: str = strings.CloneStrRange(text, ls[li], ll[li])
        if trimmed.len > 0:
            # "SEED <n>": ball-mode run seed override (deterministic ball
            # kick for scripted acceptance runs); not an event line
            if HasPrefix(trimmed, "SEED ") or HasPrefix(trimmed, "seed "):
                let sv: int32 = PlayDigits(trimmed, 5, trimmed.len - 5)
                if sv > 0:
                    scriptSeed = int64(sv)
            # tokens: tick verb [arg]
            var toks: int32[]
            setLen(toks, 0)
            var tlens: int32[]
            setLen(tlens, 0)
            var cs: int32 = 0 - 1
            var ti: int32 = 0
            while ti <= trimmed.len:
                var sp: bool = ti == trimmed.len
                if !sp:
                    if int32(trimmed[ti]) == 32:
                        sp = true
                if sp:
                    if cs >= 0:
                        add(toks, cs)
                        add(tlens, ti - cs)
                        cs = 0 - 1
                else:
                    if cs < 0:
                        cs = ti
                ti = ti + 1
            let tickV: int32 = PlayDigits(trimmed, toks[0], tlens[0])
            if tickV >= 0 and toks.len >= 2:
                var v0: int32 = int32(trimmed[toks[1]])
                if v0 >= 97:
                    if v0 <= 122:
                        v0 = v0 - 32
                var verb: int32 = 0
                if tlens[1] == 4:
                    var vk: int32 = int32(trimmed[toks[1] + 3])
                    if vk >= 97:
                        if vk <= 122:
                            vk = vk - 32
                    if v0 == 87 and vk == 75:
                        verb = 1
                    if v0 == 74 and vk == 80:
                        verb = 4
                    if v0 == 76 and vk == 78:
                        verb = 6
                elif tlens[1] == 3:
                    var vm: int32 = int32(trimmed[toks[1] + 2])
                    if vm >= 97:
                        if vm <= 122:
                            vm = vm - 32
                    if v0 == 67 and vm == 77:
                        verb = 2
                elif tlens[1] == 1:
                    if v0 == 81:
                        verb = 3
                if verb == 1 and toks.len >= 3:
                    let n: int32 = PlayDigits(trimmed, toks[2], tlens[2])
                    if n > 0:
                        PlayScheduleAdd(sch, int64(tickV), 1, n)
                elif verb == 2 and toks.len >= 3:
                    let c: int32 = PlayDigits(trimmed, toks[2], tlens[2])
                    if c >= 1 and c <= 3:
                        PlayScheduleAdd(sch, int64(tickV), 2, c)
                elif verb == 3:
                    PlayScheduleAdd(sch, int64(tickV), 3, 0)
                elif verb == 4:
                    PlayScheduleAdd(sch, int64(tickV), 4, 0)
                elif verb == 6 and toks.len >= 3:
                    let dv: int32 = PlaySignedDigits(trimmed, toks[2], tlens[2])
                    if dv == 0 - 1 or dv == 0 or dv == 1:
                        PlayScheduleAdd(sch, int64(tickV), 6, dv)
        li = li + 1
    return sch.count > 0

# One Lehmer RNG draw as a float in (0, 1): s = s * 16807 mod 2^31-1,
# the classic minimal-standard generator (int64 arithmetic only, no
# overflow). Inlined here because std/random's float path bit-casts
# through a local address, which this build's compiler rejects.
fn PlayBallRand(s: var int64): float64 =
    s = (s * 16807) % 2147483647
    return float64(s) / 2147483647.0

# Random ball kick at PlayBallKickTick (ball-mode game): one seeded
# common horizontal velocity on the ball, applied once — see the
# constant for the timing rationale. The seed fully determines both
# components (two draws), which is what makes a recorded session
# replayable bit-for-bit.
fn PlayBallKickApply(st: var execution.CsgExecutionState,
                     ballSlot: int32,
                     seed: int64) =
    var s: int64 = seed % 2147483647
    if s < 0:
        s = s + 2147483647
    if s == 0:
        s = 1
    let fx: float64 = PlayBallRand(s)
    let fy: float64 = PlayBallRand(s)
    st.w.bodyVx[ballSlot] = (fx * 2.0 - 1.0) * PlayBallKickMps
    st.w.bodyVy[ballSlot] = (fy * 2.0 - 1.0) * PlayBallKickMps

# One seeded gust (ball-mode survival pressure): a horizontal velocity
# increment on the ball, direction and magnitude drawn from (seed, tick)
# — see PlayGustEveryTick. The gust rolls the ball under the rider (the
# contact-gated rolling resistance bleeds it), which is the visible
# random roll the player counter-steers against. Called on every gust
# tick in the live run and the replay alike, before CsgExecutionTick.
fn PlayGustApply(st: var execution.CsgExecutionState,
                 ballSlot: int32,
                 seed: int64,
                 tick: int64) =
    var s: int64 = (seed + tick * 7919) % 2147483647
    if s < 0:
        s = s + 2147483647
    if s == 0:
        s = 1
    let fx: float64 = PlayBallRand(s)
    let fy: float64 = PlayBallRand(s)
    st.w.bodyVx[ballSlot] = st.w.bodyVx[ballSlot] + (fx * 2.0 - 1.0) * PlayGustMps
    st.w.bodyVy[ballSlot] = st.w.bodyVy[ballSlot] + (fy * 2.0 - 1.0) * PlayGustMps

# One play segment's world build: load (resets facts) -> validate ->
# materialize -> ball-mode: execution-side ball spawn with the probe
# timing (after Materialize, before CsgExecutionInit clones the world)
# -> execution init -> ball-mode: arm the N1 frozen ball-top servo and
# opt in the N2 creep-zero damper split (scrape brake off, contact-gated
# rolling resistance on — the probe's case C/D configuration). Shared by
# the live run, the R-restart and the headless replay so all three build
# byte-identical worlds. Returns false on any failure (caller fails
# loudly).
@borrows
fn PlayWorldBuild(worldPath: str,
                  ballMode: bool,
                  facts: var schema.CsgWorldFacts,
                  st: var execution.CsgExecutionState,
                  ballSlot: var int32): bool =
    ballSlot = 0 - 1
    let cid: str = csgworld.CsgWorldLoad(worldPath, facts)
    if cid == "":
        echo("FAIL cannot load csgworld " + worldPath)
        return false
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation status=" + strings.IntToStr(verdict.statusCode))
        return false
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return false
    var bs: int32 = 0 - 1
    if ballMode:
        # self-collision on (the ball_balance_probe contract): without it
        # the figure-ball pair resolves through nothing, the bodies
        # interpenetrate, the ball never feels the rider and the rider
        # topples straight through the sphere (measured: fall at tick 710)
        contacts3d.Contacts3dSelfCollisionSet(1)
        bs = world3d.World3dSpawnBody(w,
            producer.CsgBallBalanceBallCenterX,
            producer.CsgBallBalanceBallCenterY,
            producer.CsgBallBalanceBallRadiusM,
            producer.CsgBallBalanceBallMassKg,
            producer.CsgBallBalanceBallRadiusM,
            world3d.World3dBodyBallRigid)
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    if ballMode:
        execution.CsgBalanceSetBallMode(st,
            bs,
            producer.CsgBallBalanceBallRadiusM,
            execution.CsgBalanceBallGain,
            execution.CsgBalanceBallFootGain,
            execution.CsgBalanceBallDamp,
            execution.CsgBalanceBallTorsoCapMps,
            execution.CsgBalanceBallCorrCapMps)
        # N2 creep-zero configuration: contact-gated Coulomb rolling
        # resistance (a0 > the measured ~1.8 m/s^2 chase-pump drive)
        # makes rest the stable fixed point; the scrape brake stays at
        # its frozen N1 value (the probe's case C/D configuration)
        execution.CsgBalanceSetBallRollResist(st, execution.CsgBalanceBallRollResistMps2)
    ballSlot = bs
    return true

# Headless deterministic replay: advance the world from the same start,
# injecting the recorded events at the exact recorded ticks. ballMode
# replays rebuild the ball world (same probe-timed injection) and
# re-derive the seeded ball kick plus the lean trajectory from the
# recorded (tick, dir) events. Returns the final chainCid, or "" on any
# rejection / missed event.
@borrows
fn PlayReplayEvents(worldPath: str,
                    evTicks: int64[],
                    evKinds: int32[],
                    evArgs: int32[],
                    evCount: int32,
                    endTick: int64,
                    ballMode: bool,
                    seed: int64): str =
    var facts: schema.CsgWorldFacts
    var st: execution.CsgExecutionState
    var ballSlot: int32 = 0 - 1
    if !PlayWorldBuild(worldPath, ballMode, facts, st, ballSlot):
        return ""
    # JUMP verb flight state (mirrored tick-for-tick in the live run)
    var jumpCooldownUntil: int64
    var jumpServoOffUntil: int64
    var jumpTraceSlot: int32 = 0 - 1
    var jumpPzBeforeMm: int64
    var jumpApexMm: int64
    var jumpPzLandMm: int64
    var jumpTraceReady: bool
    var footLSlot: int32 = 0 - 1
    var footRSlot: int32 = 0 - 1
    var chestSlot: int32 = 0 - 1
    var headSlot: int32 = 0 - 1
    var rpi: int32 = 0
    while rpi < facts.partRole.len:
        if facts.partRole[rpi] == schema.CsgRoleFootL:
            footLSlot = execution.CsgExecutionPartSlot(st, rpi)
        if facts.partRole[rpi] == schema.CsgRoleFootR:
            footRSlot = execution.CsgExecutionPartSlot(st, rpi)
        if facts.partRole[rpi] == schema.CsgRoleChest:
            chestSlot = execution.CsgExecutionPartSlot(st, rpi)
        if facts.partRole[rpi] == schema.CsgRoleHead:
            headSlot = execution.CsgExecutionPartSlot(st, rpi)
        rpi = rpi + 1
    var evIdx: int32 = 0
    # ball-mode lean state, integrated tick-for-tick exactly like the
    # live run: the recorded (tick, dir) events set the direction, every
    # authority tick then ramps leanX by PlayBallLeanStep (clamped) and
    # pushes it through CsgBalanceSetUserLean before the physics step
    var leanDir: int32
    var leanX: float64
    var ballKicked: bool = false
    let cap: int64 = endTick
    while st.w.tick < cap:
        while evIdx < evCount and evTicks[evIdx] == st.w.tick:
            if evKinds[evIdx] == 1:
                let wrc = execution.CsgExecutionQueueWalk(st, facts, evArgs[evIdx])
                if wrc != 0:
                    echo("FAIL replay walk inject")
                    return ""
            elif evKinds[evIdx] == 5:
                let jrc: int32 = PlayJumpTry(st, facts, jumpCooldownUntil, jumpServoOffUntil, jumpTraceSlot, jumpPzBeforeMm, jumpApexMm)
                if jrc != 0:
                    echo("FAIL replay jump inject at tick " + strings.Int64ToStr(st.w.tick))
                    return ""
            elif evKinds[evIdx] == 6:
                leanDir = evArgs[evIdx]
            evIdx = evIdx + 1
        if evIdx < evCount and st.w.tick > evTicks[evIdx]:
            echo("FAIL replay missed event at tick " + strings.Int64ToStr(evTicks[evIdx]))
            return ""
        if ballMode:
            if !ballKicked:
                if st.w.tick == int64(PlayBallKickTick):
                    PlayBallKickApply(st, ballSlot, seed)
                    ballKicked = true
            if st.w.tick > int64(0):
                if st.w.tick % int64(PlayGustEveryTick) == 0:
                    PlayGustApply(st, ballSlot, seed, st.w.tick)
            leanX = leanX + float64(leanDir) * PlayBallLeanStep
            if leanX > execution.CsgBalanceUserLeanRangeM:
                leanX = execution.CsgBalanceUserLeanRangeM
            if leanX < 0.0 - execution.CsgBalanceUserLeanRangeM:
                leanX = 0.0 - execution.CsgBalanceUserLeanRangeM
            execution.CsgBalanceSetUserLean(st, leanX)
        PlayJumpTick(st, jumpServoOffUntil, jumpTraceSlot, footLSlot, footRSlot, chestSlot, headSlot, jumpApexMm, jumpPzLandMm, jumpTraceReady)
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL replay step rejected at tick " + strings.Int64ToStr(receipt.tick))
            return ""
    if evIdx != evCount:
        echo("FAIL replay unconsumed events")
        return ""
    return Fmt"{st.chainCid}"

# Free-walk preconditions: no hand is grasping (not hanging on the rope)
# and both feet are near the ground (standing, not mid-climb). Injecting
# a walking gait into a hanging figure fights the rope constraint and the
# authority step honestly rejects — which used to kill the whole session.
@borrows
fn PlayCanFreeWalk(st: execution.CsgExecutionState,
                   facts: schema.CsgWorldFacts): bool =
    var handL: int32 = 0 - 1
    var handR: int32 = 0 - 1
    var footL: int32 = 0 - 1
    var footR: int32 = 0 - 1
    var pi: int32 = 0
    while pi < facts.partRole.len:
        if facts.partRole[pi] == schema.CsgRoleHandL:
            handL = pi
        if facts.partRole[pi] == schema.CsgRoleHandR:
            handR = pi
        if facts.partRole[pi] == schema.CsgRoleFootL:
            footL = pi
        if facts.partRole[pi] == schema.CsgRoleFootR:
            footR = pi
        pi = pi + 1
    if handL < 0 or handR < 0 or footL < 0 or footR < 0:
        return false
    if execution.CsgExecutionGraspHeld(st, handL):
        return false
    if execution.CsgExecutionGraspHeld(st, handR):
        return false
    let slotL: int32 = execution.CsgExecutionPartSlot(st, footL)
    let slotR: int32 = execution.CsgExecutionPartSlot(st, footR)
    if st.w.bodyPz[slotL] > 0.25 or st.w.bodyPz[slotR] > 0.25:
        return false
    return true

# JUMP verb physics (play v0.3): see the PlayJump* constants. Guards, in
# order: the jump cooldown, the upright servo being live (never kick
# mid-flight), the capture-style standing predicate (every footstep slot
# — static and dynamic — finished, so a walking gait can never be jumped
# out of) and the free-walk preconditions (no grasp, feet on the ground).
# The impulse itself adds one constant +z velocity to EVERY figure body:
# equal per-mass pulses translate the jointed figure rigidly, so no
# constraint sees a violation and the authority step inherits the arc.
# Returns 0 = injected, 1 = cooling down, 2 = figure not free to jump.
# The window/trace scalars are only written on success (0).
@borrows
fn PlayJumpTry(st: var execution.CsgExecutionState,
               facts: schema.CsgWorldFacts,
               cooldownUntil: var int64,
               servoOffUntil: var int64,
               traceSlot: var int32,
               pzBeforeMm: var int64,
               apexMm: var int64): int32 =
    let at: int64 = st.w.tick
    if at < cooldownUntil:
        return 1
    if st.balOn == 0:
        return 2
    var si: int32 = 0
    while si < st.footCon.len:
        if st.footDone[si] != 2:
            return 2
        si = si + 1
    if !PlayCanFreeWalk(st, facts):
        return 2
    var pelvisPart: int32 = 0 - 1
    var pi: int32 = 0
    while pi < facts.partRole.len:
        if facts.partRole[pi] == schema.CsgRolePelvis:
            pelvisPart = pi
        pi = pi + 1
    var newTrace: int32 = 0 - 1
    if pelvisPart >= 0:
        newTrace = execution.CsgExecutionPartSlot(st, pelvisPart)
    if newTrace >= 0:
        pzBeforeMm = numerics.CsgQuantMm(st.w.bodyPz[newTrace])
        apexMm = pzBeforeMm
    traceSlot = newTrace
    pi = 0
    while pi < facts.partRole.len:
        let slot: int32 = execution.CsgExecutionPartSlot(st, pi)
        if slot >= 0:
            st.w.bodyVz[slot] = st.w.bodyVz[slot] + PlayJumpKickMps
        pi = pi + 1
    st.balOn = 0
    servoOffUntil = at + int64(PlayJumpAirTicks)
    cooldownUntil = at + int64(PlayJumpCooldownTicks)
    return 0

# Per-tick jump flight maintenance, called before CsgExecutionTick on
# every authority tick (live and replay alike, so the balOn schedule is
# bit-identical in both). Two phases while the jump recovery is open:
#   flight (tick < servoOffUntil): pure ballistic arc, apex tracking.
#   recovery (tick >= servoOffUntil, balOn still 0): the player layer
#   drives the controller's own upright servo every tick — the figure
#   lands under active stabilization while the capture reflex stays
#   gated off. balOn returns once the feet are down, the pelvis is near
#   rest and the capture-weighted CoM speed is back under the trigger;
#   servoOffUntil + extra is the hard cap.
fn PlayJumpTick(st: var execution.CsgExecutionState,
                servoOffUntil: var int64,
                traceSlot: int32,
                footLSlot: int32,
                footRSlot: int32,
                chestSlot: int32,
                headSlot: int32,
                apexMm: var int64,
                pzLandMm: var int64,
                traceReady: var bool) =
    if servoOffUntil > int64(0):
        if traceSlot >= 0:
            let mm: int64 = numerics.CsgQuantMm(st.w.bodyPz[traceSlot])
            if mm > apexMm:
                apexMm = mm
        if st.w.tick >= servoOffUntil:
            execution.CsgExecutionBalanceServo(st)
            let capTick: int64 = servoOffUntil + int64(PlayJumpRestoreExtraTicks)
            var quiet: bool = true
            if footLSlot >= 0:
                if footRSlot >= 0:
                    quiet = st.w.bodyPz[footLSlot] <= PlayJumpLandFootZM
                    if quiet:
                        quiet = st.w.bodyPz[footRSlot] <= PlayJumpLandFootZM
                    if quiet:
                        if traceSlot >= 0:
                            let vz: float64 = st.w.bodyVz[traceSlot]
                            if vz < 0.0:
                                quiet = (0.0 - vz) <= PlayJumpLandPelVzMps
                            else:
                                quiet = vz <= PlayJumpLandPelVzMps
                    if quiet:
                        if traceSlot >= 0:
                            if chestSlot >= 0:
                                if headSlot >= 0:
                                    let mP: float64 = 1.0 / st.w.bodyInvMass[traceSlot]
                                    let mC: float64 = 1.0 / st.w.bodyInvMass[chestSlot]
                                    let mH: float64 = 1.0 / st.w.bodyInvMass[headSlot]
                                    let comVx: float64 = (mP * st.w.bodyVx[traceSlot] + mC * st.w.bodyVx[chestSlot] + mH * st.w.bodyVx[headSlot]) / (mP + mC + mH)
                                    let comVy: float64 = (mP * st.w.bodyVy[traceSlot] + mC * st.w.bodyVy[chestSlot] + mH * st.w.bodyVy[headSlot]) / (mP + mC + mH)
                                    let speed2: float64 = comVx * comVx + comVy * comVy
                                    quiet = speed2 <= PlayJumpLandComVzMps * PlayJumpLandComVzMps
            if quiet or st.w.tick >= capTick:
                st.balOn = 1
                servoOffUntil = int64(0)
                if traceSlot >= 0:
                    pzLandMm = numerics.CsgQuantMm(st.w.bodyPz[traceSlot])
                traceReady = true

# Export one play segment's session file and prove it headlessly: the
# session text (world id, the ball-mode seed lines when ballmode, the
# recorded events, the final chain cid) is written to play_session.txt,
# then replayed from the same world file with the same events and the
# replayed chain cid must equal the live one. The event log arrays are
# borrowed: the live segment keeps recording after a mid-game export.
# Returns 0 on match.
@borrows
fn PlayExportAndProve(worldPath: str,
                      ballMode: bool,
                      seed: int64,
                      logTicks: int64[],
                      logKinds: int32[],
                      logArgs: int32[],
                      endTick: int64,
                      finalCid: str): int32 =
    var sess: str = ""
    sess = sess + "world " + strings.CloneStrRange(finalCid, 0, 8) + "\n"
    if ballMode:
        sess = sess + "ballmode 1\n"
        sess = sess + "seed " + strings.Int64ToStr(seed) + "\n"
    sess = sess + "ticks " + strings.Int64ToStr(endTick) + "\n"
    var ei: int32 = 0
    while ei < logTicks.len:
        if logKinds[ei] == 1:
            sess = sess + strings.Int64ToStr(logTicks[ei]) + " WALK " + strings.IntToStr(logArgs[ei]) + "\n"
        elif logKinds[ei] == 5:
            sess = sess + strings.Int64ToStr(logTicks[ei]) + " JUMP\n"
        elif logKinds[ei] == 6:
            sess = sess + strings.Int64ToStr(logTicks[ei]) + " LEAN " + strings.IntToStr(logArgs[ei]) + "\n"
        else:
            sess = sess + strings.Int64ToStr(logTicks[ei]) + " CAM " + strings.IntToStr(logArgs[ei]) + "\n"
        ei = ei + 1
    sess = sess + "final " + finalCid + "\n"
    os.WriteFile(PlayerOutDir + "/play_session.txt", sess)
    echo("session events=" + strings.IntToStr(logTicks.len) + " ticks=" + strings.Int64ToStr(endTick))
    var repTicks: int64[]
    setLen(repTicks, 0)
    var repKinds: int32[]
    setLen(repKinds, 0)
    var repArgs: int32[]
    setLen(repArgs, 0)
    var wi: int32 = 0
    while wi < logTicks.len:
        add(repTicks, logTicks[wi])
        add(repKinds, logKinds[wi])
        add(repArgs, logArgs[wi])
        wi = wi + 1
    let repCid: str = PlayReplayEvents(worldPath, repTicks, repKinds, repArgs, logTicks.len, endTick, ballMode, seed)
    if repCid == "":
        return 1
    if repCid != finalCid:
        echo("FAIL replay cid mismatch")
        echo("live=" + finalCid)
        echo("replay=" + repCid)
        return 1
    echo("replay cid match")
    return 0

fn RunPlay(worldPath: str, scriptPath: str, ballMode: bool): int32 =
    var facts: schema.CsgWorldFacts
    var st: execution.CsgExecutionState
    var ballSlot: int32 = 0 - 1
    if !PlayWorldBuild(worldPath, ballMode, facts, st, ballSlot):
        return 1
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    # pelvis part index (follow-camera target); -1 = world has no pelvis
    var pelvisPart: int32 = 0 - 1
    var pelvisSlot: int32 = 0 - 1
    # jump restore gate slots: feet + the capture-weighted torso set
    var footLSlot: int32 = 0 - 1
    var footRSlot: int32 = 0 - 1
    var chestSlot: int32 = 0 - 1
    var headSlot: int32 = 0 - 1
    ri = 0
    while ri < facts.partRole.len:
        if facts.partRole[ri] == schema.CsgRolePelvis:
            pelvisPart = ri
            pelvisSlot = execution.CsgExecutionPartSlot(st, ri)
        if facts.partRole[ri] == schema.CsgRoleFootL:
            footLSlot = execution.CsgExecutionPartSlot(st, ri)
        if facts.partRole[ri] == schema.CsgRoleFootR:
            footRSlot = execution.CsgExecutionPartSlot(st, ri)
        if facts.partRole[ri] == schema.CsgRoleChest:
            chestSlot = execution.CsgExecutionPartSlot(st, ri)
        if facts.partRole[ri] == schema.CsgRoleHead:
            headSlot = execution.CsgExecutionPartSlot(st, ri)
        ri = ri + 1
    # safe-injection window: the scene's own static action/step table owns
    # the world until its last endTick; injecting a dynamic gait inside
    # that window fights the scripted constraints and the authority step
    # honestly rejects (residual) — which used to take the whole session
    # down. Guard: refuse injections while busy, point at playground.
    var worldBusyUntil: int64 = int64(0)
    var bi: int32 = 0
    while bi < facts.stepEndTick.len:
        if facts.stepEndTick[bi] > worldBusyUntil:
            worldBusyUntil = facts.stepEndTick[bi]
        bi = bi + 1
    bi = 0
    while bi < facts.actionEndTick.len:
        if facts.actionEndTick[bi] > worldBusyUntil:
            worldBusyUntil = facts.actionEndTick[bi]
        bi = bi + 1
    echo("PLAY world busy until tick " + strings.Int64ToStr(worldBusyUntil) + " (free play worlds: playground.csgworld)")
    # interaction record (world events only; Q terminates, never recorded)
    var logTicks: int64[]
    setLen(logTicks, 0)
    var logKinds: int32[]
    setLen(logKinds, 0)
    var logArgs: int32[]
    setLen(logArgs, 0)
    # ball-mode game state: lean direction/target, the seeded ball kick,
    # and the survive/game-over bookkeeping (score = tick - release tick)
    var leanDir: int32
    var leanX: float64
    var ballKicked: bool = false
    var gameOver: bool = false
    var gameEnded: bool = false
    var survivedFinal: int64
    var restartReq: bool = false
    var sessionSeed: int64
    if ballMode:
        if ballSlot < 0:
            echo("FAIL ballmode world build produced no ball")
            return 1
        var mt = monotimes.GetMonoTime()
        var ns: int64 = monotimes.MonoTimeNs(mt)
        if ns < 0:
            ns = 0 - ns
        sessionSeed = ns
    var schedule: PlaySchedule
    var scripted: bool = false
    if scriptPath != "":
        var scriptSeed: int64
        if !PlayScheduleLoad(scriptPath, schedule, scriptSeed):
            echo("FAIL script empty or unparseable: " + scriptPath)
            return 1
        scripted = true
        if ballMode:
            if scriptSeed > 0:
                sessionSeed = scriptSeed
        echo("PLAY script events=" + strings.IntToStr(schedule.count))
    if ballMode:
        echo("PLAY ballmode ball_slot=" + strings.IntToStr(ballSlot) + " seed=" + strings.Int64ToStr(sessionSeed))
    gui.Init()
    let win: ptr = gui.WindowCreatePtr("csg play", PlayerWidth, PlayerHeight)
    let canvas: ptr = gui.DrawListCanvasCreatePtr(0, 0, PlayerWidth, PlayerHeight)
    let dlist: ptr = gui.DrawListNewPtr(4)
    gui.DrawListCanvasSetListPtr(canvas, dlist)
    gui.WindowAddViewPtr(win, canvas)
    gui.WindowShowPtr(win)
    let gpu: gpu_raster.GpuRaster = gpu_raster.GpuRasterInit(PlayerWidth, PlayerHeight)
    var gpuOk: bool = gpu.ok
    if gpuOk:
        echo("gpu raster ready")
    var surfA: raster.RasterTarget
    var surfB: raster.RasterTarget
    if gpuOk:
        surfA = raster.RasterAdoptViews(PlayerWidth, PlayerHeight, gpu_raster.GpuRasterBgraPtr(gpu, true), gpu_raster.GpuRasterDepthPtr(gpu, true))
        surfB = raster.RasterAdoptViews(PlayerWidth, PlayerHeight, gpu_raster.GpuRasterBgraPtr(gpu, false), gpu_raster.GpuRasterDepthPtr(gpu, false))
    else:
        echo("gpu raster unavailable stage=" + strings.IntToStr(gpu.failStage) + ", cpu path")
        surfA = raster.RasterMake(PlayerWidth, PlayerHeight)
        surfB = raster.RasterMake(PlayerWidth, PlayerHeight)
    var useSurfA: bool = false
    var fpsShown: int32 = 0
    var fpsWinFrames: int32 = 0
    var fpsWinStartNs: int64 = 0
    var camN: int32 = 1
    # follow-camera cross-frame state (exponential smoothing, 0.15/frame)
    var followOn: bool = false
    var followInit: bool = false
    var fTgtX: float64 = 0.0
    var fTgtY: float64 = 0.0
    var fTgtZ: float64 = 0.0
    var fCamX: float64 = 0.0
    var fCamY: float64 = 0.0
    var fCamZ: float64 = 0.0
    # JUMP verb flight state (mirrored tick-for-tick in the replay)
    var jumpCooldownUntil: int64
    var jumpServoOffUntil: int64
    var jumpTraceSlot: int32 = 0 - 1
    var jumpPzBeforeMm: int64
    var jumpApexMm: int64
    var jumpPzLandMm: int64
    var jumpTraceReady: bool
    var lastEventKind: int32
    var lastEventArg: int32
    var hudFramesLeft: int32
    var frame: int32 = 0
    var quit: bool = false
    os.MkdirAll(PlayerOutDir, 493)
    while !quit and st.w.tick < int64(PlayTickCap):
        gui.ProcessFrame()
        var ev: int32 = gui.NextEvent()
        while ev != gui.EVENT_NONE:
            if ev == gui.EVENT_KEY:
                let key: int32 = gui.EventKey()
                if key == 53 or key == 12:
                    quit = true
                if !scripted:
                    if key == 13:
                        let at: int64 = st.w.tick
                        if ballMode:
                            echo("walk refused at tick " + strings.Int64ToStr(at) + ": ballmode - steer with A/D lean")
                        elif facts.actionKind.len > 0:
                            lastEventKind = 4
                            lastEventArg = int32(worldBusyUntil / 240)
                            hudFramesLeft = 90
                            echo("walk refused: scripted scene - load playground.csgworld for free walk")
                        elif at < worldBusyUntil or !PlayCanFreeWalk(st, facts):
                            lastEventKind = 4
                            lastEventArg = int32(worldBusyUntil / 240)
                            hudFramesLeft = 90
                            echo("walk refused at tick " + strings.Int64ToStr(at) + ": figure not free to walk (busy or hanging)")
                        else:
                            let wrc = execution.CsgExecutionQueueWalk(st, facts, 4)
                            if wrc == 0:
                                add(logTicks, at)
                                add(logKinds, 1)
                                add(logArgs, 4)
                                echo("walk queued at tick " + strings.Int64ToStr(at))
                            lastEventKind = 1
                            lastEventArg = 4
                            hudFramesLeft = 60
                    if key == 38:
                        # kVK_ANSI_J: jump (see PlayJumpTry)
                        let atJ: int64 = st.w.tick
                        if ballMode:
                            echo("jump refused at tick " + strings.Int64ToStr(atJ) + ": ballmode - steer with A/D lean")
                        elif facts.actionKind.len > 0:
                            lastEventKind = 4
                            lastEventArg = int32(worldBusyUntil / 240)
                            hudFramesLeft = 90
                            echo("jump refused: scripted scene - load playground.csgworld for free walk")
                        elif atJ < worldBusyUntil:
                            lastEventKind = 4
                            lastEventArg = int32(worldBusyUntil / 240)
                            hudFramesLeft = 90
                            echo("jump refused at tick " + strings.Int64ToStr(atJ) + ": scene busy")
                        else:
                            let jrc: int32 = PlayJumpTry(st, facts, jumpCooldownUntil, jumpServoOffUntil, jumpTraceSlot, jumpPzBeforeMm, jumpApexMm)
                            if jrc == 0:
                                add(logTicks, atJ)
                                add(logKinds, 5)
                                add(logArgs, 0)
                                echo("jump queued at tick " + strings.Int64ToStr(atJ) + " pz_before_mm=" + strings.Int64ToStr(jumpPzBeforeMm))
                                lastEventKind = 5
                                lastEventArg = 0
                                hudFramesLeft = 60
                            elif jrc == 1:
                                lastEventKind = 4
                                lastEventArg = int32(worldBusyUntil / 240)
                                hudFramesLeft = 90
                                echo("jump refused at tick " + strings.Int64ToStr(atJ) + ": cooling down")
                            else:
                                lastEventKind = 4
                                lastEventArg = int32(worldBusyUntil / 240)
                                hudFramesLeft = 90
                                echo("jump refused at tick " + strings.Int64ToStr(atJ) + ": figure not free to jump (walking or hanging)")
                    if key == 18 or key == 19 or key == 20:
                        camN = key - 17
                        followOn = false
                        add(logTicks, st.w.tick)
                        add(logKinds, 2)
                        add(logArgs, camN)
                        echo("camera " + strings.IntToStr(camN))
                        lastEventKind = 2
                        lastEventArg = camN
                        hudFramesLeft = 60
                    if key == 8:
                        # kVK_ANSI_C: toggle the pelvis-follow camera
                        followOn = !followOn
                        followInit = false
                        add(logTicks, st.w.tick)
                        add(logKinds, 2)
                        add(logArgs, 4)
                        if followOn:
                            echo("camera follow on")
                        else:
                            echo("camera follow off")
                    if ballMode:
                        # kVK_ANSI_A / kVK_ANSI_D lean steering. The event
                        # bridge only delivers key-down (cocoa_bridge.m
                        # pushes NSEventTypeKeyDown and drops key-up), so
                        # the lean is tap-toggled instead of held: a press
                        # engages its direction, pressing it again centers,
                        # pressing the other key switches sides. Every
                        # state change is recorded as a (tick, dir) event,
                        # the exact replay format.
                        if !gameOver:
                            if key == 0:
                                var nd: int32 = 0 - 1
                                if leanDir == 0 - 1:
                                    nd = 0
                                leanDir = nd
                                add(logTicks, st.w.tick)
                                add(logKinds, 6)
                                add(logArgs, nd)
                                lastEventKind = 6
                                lastEventArg = nd
                                hudFramesLeft = 30
                                echo("lean " + strings.IntToStr(nd) + " at tick " + strings.Int64ToStr(st.w.tick))
                            if key == 2:
                                var nd2: int32 = 1
                                if leanDir == 1:
                                    nd2 = 0
                                leanDir = nd2
                                add(logTicks, st.w.tick)
                                add(logKinds, 6)
                                add(logArgs, nd2)
                                lastEventKind = 6
                                lastEventArg = nd2
                                hudFramesLeft = 30
                                echo("lean " + strings.IntToStr(nd2) + " at tick " + strings.Int64ToStr(st.w.tick))
                        if key == 15:
                            # kVK_ANSI_R: end the current segment (session
                            # + replay proof) and start a fresh game
                            restartReq = true
            gui.ConsumeEvent()
            ev = gui.NextEvent()
        # scripted events at this frame boundary
        if scripted:
            var si: int32 = 0
            while si < schedule.count:
                let at: int64 = st.w.tick
                if schedule.ticks[si] >= at and schedule.ticks[si] < at + int64(PlayerFrameStep):
                    if gameOver and schedule.kinds[si] != 3:
                        # the run is frozen at the game-over screen; only Q
                        # still means anything, gameplay input is dead
                        si = si + 1
                        continue
                    if schedule.kinds[si] == 1:
                        if ballMode:
                            echo("walk refused at tick " + strings.Int64ToStr(at) + ": ballmode - script LEAN lines instead")
                        elif facts.actionKind.len > 0:
                            lastEventKind = 4
                            lastEventArg = int32(worldBusyUntil / 240)
                            hudFramesLeft = 90
                            echo("walk refused at tick " + strings.Int64ToStr(at) + ": scripted scene - load playground.csgworld for free walk")
                        elif at < worldBusyUntil or !PlayCanFreeWalk(st, facts):
                            lastEventKind = 4
                            lastEventArg = int32(worldBusyUntil / 240)
                            hudFramesLeft = 90
                            echo("walk refused at tick " + strings.Int64ToStr(at) + ": figure not free to walk (busy or hanging)")
                        else:
                            let wrc = execution.CsgExecutionQueueWalk(st, facts, schedule.args[si])
                            if wrc == 0:
                                add(logTicks, at)
                                add(logKinds, 1)
                                add(logArgs, schedule.args[si])
                                echo("walk queued at tick " + strings.Int64ToStr(at))
                            lastEventKind = 1
                            lastEventArg = schedule.args[si]
                            hudFramesLeft = 60
                    elif schedule.kinds[si] == 2:
                        camN = schedule.args[si]
                        followOn = false
                        add(logTicks, at)
                        add(logKinds, 2)
                        add(logArgs, camN)
                        echo("camera " + strings.IntToStr(camN))
                        lastEventKind = 2
                        lastEventArg = camN
                        hudFramesLeft = 60
                    elif schedule.kinds[si] == 4:
                        if ballMode:
                            echo("jump refused at tick " + strings.Int64ToStr(at) + ": ballmode - script LEAN lines instead")
                        elif facts.actionKind.len > 0:
                            lastEventKind = 4
                            lastEventArg = int32(worldBusyUntil / 240)
                            hudFramesLeft = 90
                            echo("jump refused at tick " + strings.Int64ToStr(at) + ": scripted scene - load playground.csgworld for free walk")
                        elif at < worldBusyUntil:
                            lastEventKind = 4
                            lastEventArg = int32(worldBusyUntil / 240)
                            hudFramesLeft = 90
                            echo("jump refused at tick " + strings.Int64ToStr(at) + ": scene busy")
                        else:
                            let jrc: int32 = PlayJumpTry(st, facts, jumpCooldownUntil, jumpServoOffUntil, jumpTraceSlot, jumpPzBeforeMm, jumpApexMm)
                            if jrc == 0:
                                add(logTicks, at)
                                add(logKinds, 5)
                                add(logArgs, 0)
                                echo("jump queued at tick " + strings.Int64ToStr(at) + " pz_before_mm=" + strings.Int64ToStr(jumpPzBeforeMm))
                                lastEventKind = 5
                                lastEventArg = 0
                                hudFramesLeft = 60
                            elif jrc == 1:
                                lastEventKind = 4
                                lastEventArg = int32(worldBusyUntil / 240)
                                hudFramesLeft = 90
                                echo("jump refused at tick " + strings.Int64ToStr(at) + ": cooling down")
                            else:
                                lastEventKind = 4
                                lastEventArg = int32(worldBusyUntil / 240)
                                hudFramesLeft = 90
                                echo("jump refused at tick " + strings.Int64ToStr(at) + ": figure not free to jump (walking or hanging)")
                    elif schedule.kinds[si] == 3:
                        quit = true
                    elif schedule.kinds[si] == 6:
                        # "<tick> LEAN <dir>": set the lean direction for
                        # the authority ticks from `at` on — the recorded
                        # event is what the replay consumes, so the live
                        # log entry lands at the exact frame-boundary tick
                        if ballMode:
                            leanDir = schedule.args[si]
                            add(logTicks, at)
                            add(logKinds, 6)
                            add(logArgs, leanDir)
                            lastEventKind = 6
                            lastEventArg = leanDir
                            hudFramesLeft = 30
                            echo("lean " + strings.IntToStr(leanDir) + " at tick " + strings.Int64ToStr(at))
                        else:
                            echo("lean refused at tick " + strings.Int64ToStr(at) + ": not ballmode")
                si = si + 1
        if quit:
            break
        if restartReq:
            restartReq = false
            if !gameEnded:
                survivedFinal = st.w.tick - producer.CsgBallBalanceAnchorEndTick
                gameEnded = true
                let segCid: str = Fmt"{st.chainCid}"
                echo("PLAY restart segment survived=" + strings.Int64ToStr(survivedFinal))
                if PlayExportAndProve(worldPath, true, sessionSeed, logTicks, logKinds, logArgs, st.w.tick, segCid) != 0:
                    return 1
            if !PlayWorldBuild(worldPath, ballMode, facts, st, ballSlot):
                return 1
            setLen(logTicks, 0)
            setLen(logKinds, 0)
            setLen(logArgs, 0)
            leanDir = 0
            leanX = 0.0
            ballKicked = false
            gameOver = false
            survivedFinal = 0
            followInit = false
            if ballMode:
                var mtR = monotimes.GetMonoTime()
                var nsR: int64 = monotimes.MonoTimeNs(mtR)
                if nsR < 0:
                    nsR = 0 - nsR
                sessionSeed = nsR
                echo("PLAY ballmode restart seed=" + strings.Int64ToStr(sessionSeed))
        var tick: int32 = 0
        while tick < PlayerFrameStep:
            if ballMode:
                if !gameOver:
                    if !ballKicked:
                        if st.w.tick == int64(PlayBallKickTick):
                            PlayBallKickApply(st, ballSlot, sessionSeed)
                            ballKicked = true
                    if st.w.tick > int64(0):
                        if st.w.tick % int64(PlayGustEveryTick) == 0:
                            PlayGustApply(st, ballSlot, sessionSeed, st.w.tick)
                    leanX = leanX + float64(leanDir) * PlayBallLeanStep
                    if leanX > execution.CsgBalanceUserLeanRangeM:
                        leanX = execution.CsgBalanceUserLeanRangeM
                    if leanX < 0.0 - execution.CsgBalanceUserLeanRangeM:
                        leanX = 0.0 - execution.CsgBalanceUserLeanRangeM
                    execution.CsgBalanceSetUserLean(st, leanX)
            PlayJumpTick(st, jumpServoOffUntil, jumpTraceSlot, footLSlot, footRSlot, chestSlot, headSlot, jumpApexMm, jumpPzLandMm, jumpTraceReady)
            var receipt = execution.CsgExecutionTick(st, facts)
            if receipt.statusCode != physics3d.Physics3dStatusOk:
                echo("FAIL step rejected at tick " + strings.Int64ToStr(receipt.tick) + " rc=" + strings.IntToStr(receipt.statusCode))
                return 1
            if ballMode:
                if !gameOver:
                    if pelvisSlot >= 0:
                        if headSlot >= 0:
                            if st.w.bodyPz[headSlot] < st.w.bodyPz[pelvisSlot]:
                                gameOver = true
                                survivedFinal = st.w.tick - producer.CsgBallBalanceAnchorEndTick
            tick = tick + 1
        if gameOver:
            if !gameEnded:
                gameEnded = true
                echo("GAME OVER survived=" + strings.Int64ToStr(survivedFinal) + " fall_tick=" + strings.Int64ToStr(st.w.tick))
                let overCid: str = Fmt"{st.chainCid}"
                if PlayExportAndProve(worldPath, true, sessionSeed, logTicks, logKinds, logArgs, st.w.tick, overCid) != 0:
                    return 1
        if jumpTraceReady:
            jumpTraceReady = false
            echo("jump flight before_mm=" + strings.Int64ToStr(jumpPzBeforeMm) + " apex_mm=" + strings.Int64ToStr(jumpApexMm) + " land_mm=" + strings.Int64ToStr(jumpPzLandMm))
        var cam: camera.CinemaCamera
        if followOn and pelvisPart >= 0:
            # follow cam: target = pelvis world pos, position = pelvis +
            # fixed offset; cam and target each ease toward their target
            # by FollowSmooth per frame (no snap while walking)
            let pelSlot: int32 = execution.CsgExecutionPartSlot(st, pelvisPart)
            let pelX: float64 = st.w.bodyPx[pelSlot]
            let pelY: float64 = st.w.bodyPy[pelSlot]
            let pelZ: float64 = st.w.bodyPz[pelSlot]
            if !followInit:
                fTgtX = pelX
                fTgtY = pelY
                fTgtZ = pelZ
                fCamX = pelX + FollowOffsetX
                fCamY = pelY + FollowOffsetY
                fCamZ = pelZ + FollowOffsetZ
                followInit = true
            fTgtX = fTgtX + (pelX - fTgtX) * FollowSmooth
            fTgtY = fTgtY + (pelY - fTgtY) * FollowSmooth
            fTgtZ = fTgtZ + (pelZ - fTgtZ) * FollowSmooth
            fCamX = fCamX + (pelX + FollowOffsetX - fCamX) * FollowSmooth
            fCamY = fCamY + (pelY + FollowOffsetY - fCamY) * FollowSmooth
            fCamZ = fCamZ + (pelZ + FollowOffsetZ - fCamZ) * FollowSmooth
            cam = camera.CinemaCameraLookAt(fCamX, fCamY, fCamZ, fTgtX, fTgtY, fTgtZ, FollowFocal, PlayerWidth, PlayerHeight)
        else:
            cam = CameraFor(camN)
        if hudFramesLeft > 0:
            hudFramesLeft = hudFramesLeft - 1
        let fpsv: int32 = FpsWindowAdvance(fpsWinFrames, fpsWinStartNs, monotimes.MonoTimeNs(monotimes.GetMonoTime()))
        if fpsv >= 0:
            fpsShown = fpsv
        var hudSurvive: int64 = st.w.tick - producer.CsgBallBalanceAnchorEndTick
        if hudSurvive < 0:
            hudSurvive = 0
        if gameOver:
            hudSurvive = survivedFinal
        if gpuOk:
            gpu_raster.GpuRasterFrame(gpu, useSurfA, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
        if useSurfA:
            if gpuOk:
                RenderWindowFrameBackGpu(surfA, cam, st, partRoles, dlist, canvas, frame, ballSlot, lastEventKind, lastEventArg, hudFramesLeft, camN, followOn, fpsShown, ballMode, leanDir, gameOver, hudSurvive)
            else:
                RenderWindowFrameBack(surfA, cam, st, partRoles, dlist, canvas, frame, ballSlot, lastEventKind, lastEventArg, hudFramesLeft, camN, followOn, fpsShown, ballMode, leanDir, gameOver, hudSurvive)
        else:
            if gpuOk:
                RenderWindowFrameBackGpu(surfB, cam, st, partRoles, dlist, canvas, frame, ballSlot, lastEventKind, lastEventArg, hudFramesLeft, camN, followOn, fpsShown, ballMode, leanDir, gameOver, hudSurvive)
            else:
                RenderWindowFrameBack(surfB, cam, st, partRoles, dlist, canvas, frame, ballSlot, lastEventKind, lastEventArg, hudFramesLeft, camN, followOn, fpsShown, ballMode, leanDir, gameOver, hudSurvive)
        useSurfA = !useSurfA
        frame = frame + 1
    gui.WindowClosePtr(win)
    # ---- session export + deterministic replay proof ----
    let finalCid: str = Fmt"{st.chainCid}"
    if ballMode:
        if !gameEnded:
            survivedFinal = st.w.tick - producer.CsgBallBalanceAnchorEndTick
            if st.w.tick >= int64(PlayTickCap):
                echo("TIME UP survived=" + strings.Int64ToStr(survivedFinal))
            if PlayExportAndProve(worldPath, true, sessionSeed, logTicks, logKinds, logArgs, st.w.tick, finalCid) != 0:
                return 1
        echo("PASS play frames=" + strings.IntToStr(frame) + " survived=" + strings.Int64ToStr(survivedFinal) + " chainCid=" + finalCid)
        return 0
    if PlayExportAndProve(worldPath, false, sessionSeed, logTicks, logKinds, logArgs, st.w.tick, finalCid) != 0:
        return 1
    echo("PASS play frames=" + strings.IntToStr(frame) + " chainCid=" + finalCid)
    return 0

# --replay:<world> --session:<file>: verify a recorded session headlessly
fn RunReplay(args: str[]): int32 =
    var worldPath: str = ""
    var sessionPath: str = ""
    var ai: int32 = 1
    while ai < args.len:
        if HasPrefix(args[ai], "--replay:"):
            worldPath = strings.CloneStrRange(args[ai], 9, args[ai].len - 9)
        elif HasPrefix(args[ai], "--session:"):
            sessionPath = strings.CloneStrRange(args[ai], 10, args[ai].len - 10)
        ai = ai + 1
    if worldPath == "" or sessionPath == "":
        echo("usage: player --replay:<world.csgworld> --session:<play_session.txt>")
        return 2
    let text: str = os.ReadFile(sessionPath)
    if text.len == 0:
        echo("FAIL empty session")
        return 1
    var evTicks: int64[]
    setLen(evTicks, 0)
    var evKinds: int32[]
    setLen(evKinds, 0)
    var evArgs: int32[]
    setLen(evArgs, 0)
    var finalLine: str = ""
    var endTick: int64 = int64(PlayTickCap)
    var sessBall: bool = false
    var sessSeed: int64
    var ls: int32[]
    setLen(ls, 0)
    var ll: int32[]
    setLen(ll, 0)
    var curStart: int32 = 0 - 1
    var ci: int32 = 0
    while ci <= text.len:
        var isSep: bool = ci == text.len
        if !isSep:
            if int32(text[ci]) == 10:
                isSep = true
        if isSep:
            if curStart >= 0:
                add(ls, curStart)
                add(ll, ci - curStart)
                curStart = 0 - 1
        else:
            if curStart < 0:
                curStart = ci
        ci = ci + 1
    var li: int32 = 0
    while li < ls.len:
        var line: str = strings.CloneStrRange(text, ls[li], ll[li])
        if HasPrefix(line, "final "):
            finalLine = strings.CloneStrRange(line, 6, line.len - 6)
        elif HasPrefix(line, "ticks "):
            let tv: int32 = PlayDigits(line, 6, line.len - 6)
            if tv > 0:
                endTick = int64(tv)
        elif HasPrefix(line, "ballmode"):
            sessBall = true
        elif HasPrefix(line, "seed "):
            let sv: int32 = PlaySignedDigits(line, 5, line.len - 5)
            if sv > 0:
                sessSeed = int64(sv)
        elif line.len > 0 and !HasPrefix(line, "world "):
            var toks: int32[]
            setLen(toks, 0)
            var tlens: int32[]
            setLen(tlens, 0)
            var cs: int32 = 0 - 1
            var ti: int32 = 0
            while ti <= line.len:
                var sp: bool = ti == line.len
                if !sp:
                    if int32(line[ti]) == 32:
                        sp = true
                if sp:
                    if cs >= 0:
                        add(toks, cs)
                        add(tlens, ti - cs)
                        cs = 0 - 1
                else:
                    if cs < 0:
                        cs = ti
                ti = ti + 1
            if toks.len == 3:
                let tv: int32 = PlayDigits(line, toks[0], tlens[0])
                if tv >= 0:
                    var v0: int32 = int32(line[toks[1]])
                    if v0 >= 97:
                        if v0 <= 122:
                            v0 = v0 - 32
                    var verb: int32 = 0
                    if tlens[1] == 4:
                        var vk: int32 = int32(line[toks[1] + 3])
                        if vk >= 97:
                            if vk <= 122:
                                vk = vk - 32
                        if v0 == 87 and vk == 75:
                            verb = 1
                        if v0 == 76 and vk == 78:
                            verb = 6
                    elif tlens[1] == 3:
                        var vm: int32 = int32(line[toks[1] + 2])
                        if vm >= 97:
                            if vm <= 122:
                                vm = vm - 32
                        if v0 == 67 and vm == 77:
                            verb = 2
                    if verb == 1:
                        add(evTicks, int64(tv))
                        add(evKinds, 1)
                        add(evArgs, PlayDigits(line, toks[2], tlens[2]))
                    elif verb == 2:
                        add(evTicks, int64(tv))
                        add(evKinds, 2)
                        add(evArgs, PlayDigits(line, toks[2], tlens[2]))
                    elif verb == 6:
                        let dv: int32 = PlaySignedDigits(line, toks[2], tlens[2])
                        if dv == 0 - 1 or dv == 0 or dv == 1:
                            add(evTicks, int64(tv))
                            add(evKinds, 6)
                            add(evArgs, dv)
            elif toks.len == 2:
                # argument-less verbs: only JUMP is ever recorded ("T JUMP")
                let tj: int32 = PlayDigits(line, toks[0], tlens[0])
                if tj >= 0:
                    var j0: int32 = int32(line[toks[1]])
                    if j0 >= 97:
                        if j0 <= 122:
                            j0 = j0 - 32
                    if tlens[1] == 4:
                        var jk: int32 = int32(line[toks[1] + 3])
                        if jk >= 97:
                            if jk <= 122:
                                jk = jk - 32
                        if j0 == 74 and jk == 80:
                            add(evTicks, int64(tj))
                            add(evKinds, 5)
                            add(evArgs, 0)
        li = li + 1
    if finalLine == "":
        echo("FAIL session missing final cid")
        return 1
    echo("REPLAY events=" + strings.IntToStr(evTicks.len))
    let repCid: str = PlayReplayEvents(worldPath, evTicks, evKinds, evArgs, evTicks.len, endTick, sessBall, sessSeed)
    if repCid == "":
        return 1
    if repCid != finalLine:
        echo("FAIL cid mismatch")
        echo("session=" + finalLine)
        echo("replay=" + repCid)
        return 1
    echo("replay cid match")
    echo("PASS replay chainCid=" + repCid)
    return 0

# ---- basketball (--basketball): the standalone basketball physics mode ----
#
# One real size-7 ball (r = 0.121 m, m = 0.62 kg) on the ground plane,
# nothing else: the friction/rolling/restitution stack of physics3d
# observed with zero interference from the duck servo (whose linear
# channel drags the ball CENTER and is the standing-ball slide suspect).
# Interactive kicks expose the classic rigid-ball laws live:
#   1  slide test  v = 2 m/s, w = 0        -> must settle to 5/7*v = 1.43
#   2  pure roll   v = 2 m/s, w = +v/r     -> slip starts 0, stays 0
#   3  backspin    v = 2 m/s, w = -v/r     -> slip reversal lab
#   4  stop        v = w = 0
#   A/D nudge vx, W/S spin wy, R reset, ESC quit
# HUD carries live |v|, wy, contact slip |(vx - wy*r, vy + wx*r)| and the
# ROLL/SLIDE verdict; the slide-to-roll transition (slip < 5 mm/s) is
# sampled and echoed at exit against the 5/7 law.

const
    BbRadius: float64 = 0.121
    BbMass: float64 = 0.62
    BbHomeX: float64 = 0.0
    BbHomeY: float64 = 0.85
    BbKickV: float64 = 2.0
    BbRollSlipTol: float64 = 0.005
    BbFrameTicks: int32 = 10
    BbTickCap: int64 = 43200
    BbBudgetNs: int64 = 20000000
    BbStallRejectRun: int32 = 64
    BbSampleStride: int32 = 240
    BbSampleCount: int32 = 40

@borrows
fn DrawBbHud(t: raster.RasterTarget,
                   tickNow: int64,
                   vMag: float64,
                   wy: float64,
                   slip: float64,
                   rolling: bool,
                   dist: float64,
                   s2rDone: bool,
                   s2rV: float64) =
    gui_text.RasterText(t, 8, 8, 2, "1 SLIDE-TEST | 2 PURE-ROLL | 3 BACKSPIN | 4 STOP | A/D PUSH | W/S SPIN | R RESET | ESC QUIT", 255, 255, 255)
    let statusText: str = "T=" + strings.Int64ToStr(tickNow) + " V=" + DuckFmtMm(vMag) + " WY=" + DuckFmtMm(wy) + " SLIP=" + DuckFmtMm(slip)
    let statusW: int32 = gui_text.TextPixelWidth(statusText, 2)
    gui_text.RasterText(t, PlayerWidth - statusW - 8, 28, 2, statusText, 255, 255, 255)
    var stateText: str = "STATE SLIDING"
    if rolling:
        stateText = "STATE ROLLING"
    let stateW: int32 = gui_text.TextPixelWidth(stateText, 2)
    gui_text.RasterText(t, (PlayerWidth - stateW) / 2, 30, 2, stateText, 120, 255, 120)
    let distText: str = "DIST " + DuckFmtMm(dist) + " m"
    let distW: int32 = gui_text.TextPixelWidth(distText, 2)
    gui_text.RasterText(t, (PlayerWidth - distW) / 2, 52, 2, distText, 255, 255, 255)
    if s2rDone:
        let expect: float64 = BbKickV * 5.0 / 7.0
        let s2rText: str = "SLIDE->ROLL v=" + DuckFmtMm(s2rV) + " m/s (5/7 law " + DuckFmtMm(expect) + ")"
        let s2rW: int32 = gui_text.TextPixelWidth(s2rText, 2)
        gui_text.RasterText(t, (PlayerWidth - s2rW) / 2, 74, 2, s2rText, 120, 200, 255)

@borrows
fn BbFrameBack(t: raster.RasterTarget,
                 cam: camera.CinemaCamera,
                 w: world3d.World3d,
                 ballSlot: int32,
                 dlist: ptr,
                 canvas: ptr,
                 tickNow: int64,
                 vMag: float64,
                 wy: float64,
                 slip: float64,
                 rolling: bool,
                 dist: float64,
                 s2rDone: bool,
                 s2rV: float64,
                 fpsShown: int32,
                 vqw: float64,
                 vqx: float64,
                 vqy: float64,
                 vqz: float64) =
    raster.RasterBasketball(t, cam, w.bodyPx[ballSlot], w.bodyPy[ballSlot], w.bodyPz[ballSlot], w.bodyRadius[ballSlot], vqw, vqx, vqy, vqz, DuckBallBaseR, DuckBallBaseG, DuckBallBaseB, DuckBallGrooveR, DuckBallGrooveG, DuckBallGrooveB)
    DrawBbHud(t, tickNow, vMag, wy, slip, rolling, dist, s2rDone, s2rV)
    gui.DrawListClearPtr(dlist)
    gui.DrawListPushBGRAPtr(dlist, 0, 0, PlayerWidth, PlayerHeight, rawbytes.BytesDataPtr(t.frame.bgra))
    gui.DrawListCanvasSetListPtr(canvas, dlist)

fn RunBasketball(): int32 =
    var w: world3d.World3d
    world3d.World3dReset(w, int64(4242))
    let ballSlot: int32 = world3d.World3dSpawnBody(w, BbHomeX, BbHomeY, BbRadius, BbMass, BbRadius, world3d.World3dBodyBallRigid)
    echo("BASKETBALL bodies=" + strings.IntToStr(w.count) + " r_mm=" + DuckFmtMm(BbRadius * 1000.0) + " m_g=" + DuckFmtMm(BbMass * 1000.0))
    # deterministic acceptance: BASKETBALL_TICKS=<n> caps the run
    var tickCap: int64 = BbTickCap
    let capEnv: str = os.GetEnvDefault("BASKETBALL_TICKS", "")
    if capEnv.len > 0:
        let cv: int32 = ParseDigits(capEnv)
        if cv > 0:
            tickCap = int64(cv)
    gui.Init()
    let win: ptr = gui.WindowCreatePtr("csg ball", PlayerWidth, PlayerHeight)
    let canvas: ptr = gui.DrawListCanvasCreatePtr(0, 0, PlayerWidth, PlayerHeight)
    let dlist: ptr = gui.DrawListNewPtr(4)
    gui.DrawListCanvasSetListPtr(canvas, dlist)
    gui.WindowAddViewPtr(win, canvas)
    gui.WindowShowPtr(win)
    let gpu: gpu_raster.GpuRaster = gpu_raster.GpuRasterInit(PlayerWidth, PlayerHeight)
    var gpuOk: bool = gpu.ok
    if gpuOk:
        echo("gpu raster ready")
    else:
        echo("gpu raster unavailable stage=" + strings.IntToStr(gpu.failStage) + ", cpu path")
    var surfA: raster.RasterTarget
    var surfB: raster.RasterTarget
    if gpuOk:
        surfA = raster.RasterAdoptViews(PlayerWidth, PlayerHeight, gpu_raster.GpuRasterBgraPtr(gpu, true), gpu_raster.GpuRasterDepthPtr(gpu, true))
        surfB = raster.RasterAdoptViews(PlayerWidth, PlayerHeight, gpu_raster.GpuRasterBgraPtr(gpu, false), gpu_raster.GpuRasterDepthPtr(gpu, false))
    else:
        surfA = raster.RasterMake(PlayerWidth, PlayerHeight)
        surfB = raster.RasterMake(PlayerWidth, PlayerHeight)
    var useSurfA: bool = false
    # ball visual attitude (render-layer only)
    var vqw: float64 = 1.0
    var vqx: float64 = 0.0
    var vqy: float64 = 0.0
    var vqz: float64 = 0.0
    # follow camera state (eases toward ball + fixed offset)
    var fInit: bool = false
    var fCamX: float64 = 0.0
    var fCamY: float64 = 0.0
    var fCamZ: float64 = 0.0
    # slide->roll measurement state
    var s2rArmed: bool = false
    var s2rDone: bool = false
    var s2rV: float64 = 0.0
    var s2rTick: int64 = 0
    # per-240-tick trace buffers, echoed at exit
    var recTick: int64[]
    var recV: float64[]
    var recW: float64[]
    var recSlip: float64[]
    setLen(recTick, BbSampleCount)
    setLen(recV, BbSampleCount)
    setLen(recW, BbSampleCount)
    setLen(recSlip, BbSampleCount)
    var si: int32 = 0
    var rejectRun: int32 = 0
    var frame: int32 = 0
    var quit: bool = false
    var fpsShown: int32 = 0
    var fpsWinFrames: int32 = 0
    var fpsWinStartNs: int64 = 0
    # BASKETBALL_AUTO=1 fires the slide test at tick 0 (deterministic
    # acceptance of the 5/7 law without human keys)
    let autoEnv: str = os.GetEnvDefault("BASKETBALL_AUTO", "")
    if autoEnv == "1":
        w.bodyVx[ballSlot] = BbKickV
        w.bodyVy[ballSlot] = 0.0
        w.bodyVz[ballSlot] = 0.0
        w.bodyAngVx[ballSlot] = 0.0
        w.bodyAngVy[ballSlot] = 0.0
        w.bodyAngVz[ballSlot] = 0.0
        s2rArmed = true
        echo("BASKETBALL auto slide-test v0=" + DuckFmtMm(BbKickV) + " m/s w0=0")
    while !quit and w.tick < tickCap:
        let frameNs: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        let fpsv: int32 = FpsWindowAdvance(fpsWinFrames, fpsWinStartNs, frameNs)
        if fpsv >= 0:
            fpsShown = fpsv
        gui.ProcessFrame()
        var ev: int32 = gui.NextEvent()
        while ev != gui.EVENT_NONE:
            if ev == gui.EVENT_KEY:
                let key: int32 = gui.EventKey()
                if key == 53 or key == 12:
                    quit = true
                if key == 18:
                    # slide test: kick +x at 2 m/s with zero spin
                    w.bodyVx[ballSlot] = BbKickV
                    w.bodyVy[ballSlot] = 0.0
                    w.bodyVz[ballSlot] = 0.0
                    w.bodyAngVx[ballSlot] = 0.0
                    w.bodyAngVy[ballSlot] = 0.0
                    w.bodyAngVz[ballSlot] = 0.0
                    s2rArmed = true
                    s2rDone = false
                    s2rV = 0.0
                if key == 19:
                    # pure roll: v = 2 m/s, wy = +v/r
                    w.bodyVx[ballSlot] = BbKickV
                    w.bodyVy[ballSlot] = 0.0
                    w.bodyVz[ballSlot] = 0.0
                    w.bodyAngVx[ballSlot] = 0.0
                    w.bodyAngVy[ballSlot] = BbKickV / BbRadius
                    w.bodyAngVz[ballSlot] = 0.0
                    s2rArmed = false
                if key == 20:
                    # backspin: v = 2 m/s, wy = -v/r
                    w.bodyVx[ballSlot] = BbKickV
                    w.bodyVy[ballSlot] = 0.0
                    w.bodyVz[ballSlot] = 0.0
                    w.bodyAngVx[ballSlot] = 0.0
                    w.bodyAngVy[ballSlot] = 0.0 - BbKickV / BbRadius
                    w.bodyAngVz[ballSlot] = 0.0
                    s2rArmed = false
                if key == 21:
                    w.bodyVx[ballSlot] = 0.0
                    w.bodyVy[ballSlot] = 0.0
                    w.bodyVz[ballSlot] = 0.0
                    w.bodyAngVx[ballSlot] = 0.0
                    w.bodyAngVy[ballSlot] = 0.0
                    w.bodyAngVz[ballSlot] = 0.0
                if key == 0:
                    # rolling-consistent nudge: the velocity step rides
                    # with its matching w step (dw = dv/r). A bare dv
                    # injects a slip transient — repeated presses kept
                    # the ball skidding forever (the interactive face
                    # of the documented linear-servo wall).
                    w.bodyVx[ballSlot] = w.bodyVx[ballSlot] - 0.5
                    w.bodyAngVy[ballSlot] = w.bodyAngVy[ballSlot] - 0.5 / BbRadius
                if key == 2:
                    w.bodyVx[ballSlot] = w.bodyVx[ballSlot] + 0.5
                    w.bodyAngVy[ballSlot] = w.bodyAngVy[ballSlot] + 0.5 / BbRadius
                if key == 13:
                    w.bodyAngVy[ballSlot] = w.bodyAngVy[ballSlot] + 4.0
                if key == 1:
                    w.bodyAngVy[ballSlot] = w.bodyAngVy[ballSlot] - 4.0
                if key == 15:
                    w.bodyPx[ballSlot] = BbHomeX
                    w.bodyPy[ballSlot] = BbHomeY
                    w.bodyPz[ballSlot] = BbRadius
                    w.bodyVx[ballSlot] = 0.0
                    w.bodyVy[ballSlot] = 0.0
                    w.bodyVz[ballSlot] = 0.0
                    w.bodyAngVx[ballSlot] = 0.0
                    w.bodyAngVy[ballSlot] = 0.0
                    w.bodyAngVz[ballSlot] = 0.0
                    vqw = 1.0
                    vqx = 0.0
                    vqy = 0.0
                    vqz = 0.0
                    s2rArmed = false
                    s2rDone = false
                    si = 0
            gui.ConsumeEvent()
            ev = gui.NextEvent()
        if quit:
            break
        var tk: int32 = 0
        let tb0: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        while tk < BbFrameTicks:
            var r = physics3d.Physics3dStep(w, "ballmode")
            if r.statusCode != physics3d.Physics3dStatusOk:
                rejectRun = rejectRun + 1
                if rejectRun > BbStallRejectRun:
                    echo("FAIL basketball engine stall")
                    return 1
            else:
                rejectRun = 0
            tk = tk + 1
            if tk >= 2:
                let tbn: int64 = monotimes.MonoTimeNs(monotimes.GetMonoTime())
                if tbn - tb0 > BbBudgetNs:
                    break
        DuckBallVisualQuatStep(vqw, vqx, vqy, vqz, w.bodyAngVx[ballSlot], w.bodyAngVy[ballSlot], w.bodyAngVz[ballSlot], float64(tk) / 240.0)
        let vx: float64 = w.bodyVx[ballSlot]
        let vy: float64 = w.bodyVy[ballSlot]
        let slipX: float64 = vx - w.bodyAngVy[ballSlot] * BbRadius
        let slipY: float64 = vy + w.bodyAngVx[ballSlot] * BbRadius
        let slip: float64 = numerics.CsgSqrt(slipX * slipX + slipY * slipY)
        let vMag: float64 = numerics.CsgSqrt(vx * vx + vy * vy)
        let ddx: float64 = w.bodyPx[ballSlot] - BbHomeX
        let ddy: float64 = w.bodyPy[ballSlot] - BbHomeY
        let dist: float64 = numerics.CsgSqrt(ddx * ddx + ddy * ddy)
        if s2rArmed and !s2rDone:
            if slip < BbRollSlipTol:
                s2rDone = true
                s2rV = vMag
                s2rTick = w.tick
        if w.tick % int64(BbSampleStride) == 0:
            if si < BbSampleCount:
                recTick[si] = w.tick
                recV[si] = vMag
                recW[si] = w.bodyAngVy[ballSlot]
                recSlip[si] = slip
                si = si + 1
        # follow camera: eased ball + fixed offset
        var cam: camera.CinemaCamera
        let bx: float64 = w.bodyPx[ballSlot]
        let by: float64 = w.bodyPy[ballSlot]
        let bz: float64 = w.bodyPz[ballSlot]
        if !fInit:
            fCamX = bx - 1.9
            fCamY = by - 1.4
            fCamZ = bz + 0.75
            fInit = true
        fCamX = fCamX + (bx - 1.9 - fCamX) * 0.15
        fCamY = fCamY + (by - 1.4 - fCamY) * 0.15
        fCamZ = fCamZ + (bz + 0.75 - fCamZ) * 0.15
        cam = camera.CinemaCameraLookAt(fCamX, fCamY, fCamZ, bx, by, bz, 950.0, PlayerWidth, PlayerHeight)
        if gpuOk:
            gpu_raster.GpuRasterFrame(gpu, useSurfA, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
        else:
            if useSurfA:
                raster.RasterClear(surfA)
                raster.RasterGround(surfA, cam)
                raster.RasterWallFace(surfA, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
            else:
                raster.RasterClear(surfB)
                raster.RasterGround(surfB, cam)
                raster.RasterWallFace(surfB, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
        if useSurfA:
            BbFrameBack(surfA, cam, w, ballSlot, dlist, canvas, w.tick, vMag, w.bodyAngVy[ballSlot], slip, slip < BbRollSlipTol, dist, s2rDone, s2rV, fpsShown, vqw, vqx, vqy, vqz)
        else:
            BbFrameBack(surfB, cam, w, ballSlot, dlist, canvas, w.tick, vMag, w.bodyAngVy[ballSlot], slip, slip < BbRollSlipTol, dist, s2rDone, s2rV, fpsShown, vqw, vqx, vqy, vqz)
        useSurfA = !useSurfA
        frame = frame + 1
    # exit report: the trace plus the slide->roll verdict
    var ei: int32 = 0
    while ei < si:
        echo("basketball t=" + strings.Int64ToStr(recTick[ei]) + " v=" + DuckFmtMm(recV[ei]) + " wy=" + DuckFmtMm(recW[ei]) + " slip=" + DuckFmtMm(recSlip[ei]))
        ei = ei + 1
    if s2rDone:
        let expect2: float64 = BbKickV * 5.0 / 7.0
        let err: float64 = m.absFloat(s2rV - expect2) / expect2
        var verdict: str = "PASS"
        if err > 0.05:
            verdict = "FAIL"
        echo("basketball slide2roll v=" + DuckFmtMm(s2rV) + " expect=" + DuckFmtMm(expect2) + " err=" + DuckFmtMm(err * 100.0) + "% at_tick=" + strings.Int64ToStr(s2rTick) + " " + verdict)
    else:
        echo("basketball slide2roll not-run")
    gui.WindowClosePtr(win)
    echo("PASS basketball frames=" + strings.IntToStr(frame) + " ticks=" + strings.Int64ToStr(w.tick))
    return 0

fn main(): int32 =
    os.MkdirAll(PlayerOutDir, 493)
    var mode: str = ""
    if cmdline.paramCount() >= 1:
        mode = cmdline.paramStr(1)
    if mode == "--dump":
        return RunDump()
    if mode == "--game":
        return RunGame("artifacts/csg_world_video/csgworld/climb.csgworld", "artifacts/csg_world_video/player/game_cmds.txt")
    if HasPrefix(mode, "--game:"):
        let gpath: str = strings.CloneStrRange(mode, 7, mode.len - 7)
        return RunGame(gpath, "artifacts/csg_world_video/player/game_cmds.txt")
    if mode == "--duckmode":
        return RunDuck()
    if mode == "--gaitcem":
        return RunGaitCem()
    if mode == "--standeval":
        let pp: str = os.GetEnvDefault("DUCK_EVAL_PARAMS", "")
        if pp.len > 0:
            return RunStandEval(pp)
    if mode == "--standcem":
        return RunStandCem()
        return RunGaitCem()
    if mode == "--basketball":
        return RunBasketball()
    if HasPrefix(mode, "--play:"):
        let ppath: str = strings.CloneStrRange(mode, 7, mode.len - 7)
        var scriptPath: str = ""
        var ballMode: bool = false
        var argi: int32 = 2
        while argi <= cmdline.paramCount():
            let ap: str = cmdline.paramStr(argi)
            if HasPrefix(ap, "--script:"):
                scriptPath = strings.CloneStrRange(ap, 9, ap.len - 9)
            if ap == "--ballmode":
                ballMode = true
            argi = argi + 1
        return RunPlay(ppath, scriptPath, ballMode)
    if HasPrefix(mode, "--replay:"):
        var rargs: str[]
        setLen(rargs, 0)
        var rai: int32 = 0
        while rai <= cmdline.paramCount():
            add(rargs, cmdline.paramStr(rai))
            rai = rai + 1
        return RunReplay(rargs)
    if HasPrefix(mode, "--window:"):
        let wpath: str = strings.CloneStrRange(mode, 9, mode.len - 9)
        return RunWindow(wpath)
    if mode == "--window":
        if cmdline.paramCount() >= 2:
            return RunWindow(cmdline.paramStr(2))
        echo("usage: player --window:<world.csgworld>")
        return 2
    if HasPrefix(mode, "--world:"):
        let wp: str = strings.CloneStrRange(mode, 8, mode.len - 8)
        # remaining params parsed below for --frame/--cam
        var wf: int32 = 0
        var wc: int32 = 1
        var pj: int32 = 2
        while pj <= cmdline.paramCount():
            let pp: str = cmdline.paramStr(pj)
            if HasPrefix(pp, "--frame:"):
                wf = ParseDigits(strings.CloneStrRange(pp, 8, pp.len - 8))
            elif pp == "--frame":
                pj = pj + 1
                wf = ParseDigits(cmdline.paramStr(pj))
            elif HasPrefix(pp, "--cam:"):
                wc = ParseDigits(strings.CloneStrRange(pp, 6, pp.len - 6))
            elif pp == "--cam":
                pj = pj + 1
                wc = ParseDigits(cmdline.paramStr(pj))
            pj = pj + 1
        return RunWorld(wp, wf, wc)
    if mode == "--list":
        return RunList()
    if mode != "--all" and mode != "--frame" and mode != "":
        echo("usage: csg_player --dump | --list | --all [--cam:N] | --frame:N [--cam:N] | --play:<world> [--script:<file>] [--ballmode] | --replay:<world> --session:<file> | --game | --window:<world.csgworld> | --duckmode | --basketball")
        echo("  interactive keys: W walk / J jump / A,D lean + R restart (ballmode) / 1-3 camera / C follow cam / R restart + ESC quit (duckmode) / ESC quit")
        return 2
    var allMode: bool = false
    if mode == "--all":
        allMode = true
    var frameN: int32 = 0 - 1
    var camN: int32 = 0 - 1
    var pi: int32 = 1
    while pi <= cmdline.paramCount():
        let p: str = cmdline.paramStr(pi)
        if HasPrefix(p, "--frame:"):
            frameN = ParseDigits(strings.CloneStrRange(p, 8, p.len - 8))
        elif p == "--frame":
            pi = pi + 1
            frameN = ParseDigits(cmdline.paramStr(pi))
        elif HasPrefix(p, "--cam:"):
            camN = ParseDigits(strings.CloneStrRange(p, 6, p.len - 6))
        elif p == "--cam":
            pi = pi + 1
            camN = ParseDigits(cmdline.paramStr(pi))
        elif p == "FRAME":
            pi = pi + 1
            frameN = ParseDigits(cmdline.paramStr(pi))
        elif p == "CAM":
            pi = pi + 1
            camN = ParseDigits(cmdline.paramStr(pi))
        pi = pi + 1
    if camN > 3:
        echo("FAIL cam must be 1, 2 or 3, got " + strings.IntToStr(camN))
        return 2
    if allMode:
        return RunAll(camN)
    if camN < 0:
        camN = 1
    if frameN < 0:
        echo("usage: player --dump | player --list | player --all [--cam:<1|2|3>] | player --frame:<N> --cam:<1|2|3>")
        return 2
    return RunFrame(frameN, camN)
