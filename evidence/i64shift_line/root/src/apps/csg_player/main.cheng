# csg_player (v1): imperative frame renderer over the CSG climb scene.
#
# Two modes, selected by the first parameter:
#
#   player --dump
#       Builds the climb scene (produce -> validate -> materialize ->
#       execution init), runs 2400 authority ticks through
#       CsgExecutionTick, and saves one RenderState file every 10 ticks
#       (240 files) via render_state.RenderStateFramePath(dir, frame)
#       into artifacts/csg_world_video/player/.
#
#   player --frame:<N> --cam:<1|2|3>
#       Each flag may also be written as two separate parameters
#       ("--frame N", "--cam C") or as the bare-word form
#       "FRAME N CAM C". Loads render_state.RenderStateFramePath(dir, N)
#       with RenderStateLoad and renders one 1280x720 PPM frame with the
#       chosen world_cinema camera into
#       artifacts/csg_world_video/player/player_f<N>_c<C>.ppm.
#
#   player --all [--cam:<1|2|3>]
#       Loads every saved state frame (0..239) and renders one 1280x720
#       PPM per frame into
#       artifacts/csg_world_video/player/frames/player_f<N>.ppm.
#       With --cam the given camera is used for all frames; without it
#       the cameras rotate in three 80-frame segments (frames 0-79
#       cam1, 80-159 cam2, 160-239 cam3).
#
#   player --list
#       Scans artifacts/csg_world_video/player for state_f<N>.txt files
#       and prints the available frame range as
#       "PASS list first=<F> last=<L> count=<C> ...".
#
#   player --window:<world.csgworld>
#       Opens a real NSWindow (1280x720) and live-replays the world: the
#       Cocoa event pump and the deterministic physics share the main
#       thread, every frame advances 10 ticks, rasterizes on the CPU and
#       displays the frame through the drawlist IMAGE command. Escape or
#       closing the window quits early; 240 frames total.
#
#   player --duckmode
#       Machine-duck ball-balance spectator/interactive mode: the real-
#       parameter machine duck (the microduck_assembly_probe stance
#       assembly verbatim: 13 link capsules - trunk, per leg hip-yoke/
#       thigh/shin/foot plate, and the 4-body neck chain ending in the
#       172.6 g head shell, total mass 0.7443611 kg; 12 hinge servos,
#       one per assembly joint, every servo parked at its measured
#       stance angle) released standing on the real size-7 basketball
#       (BallRigid r = 0.121 m, m = 0.62 kg, resting on the ground
#       plane), with the csg/ball_servo_rigid ball-frame servo armed at
#       the release pose (the microduck_ball_probe caseB wiring: Init
#       after the ball spawn and before the first step, Tick every tick
#       immediately before the physics step; DuckBallServoOn is the
#       master switch). HUD: live SURVIVE tick counter + BALL DRIFT mm;
#       head-below-torso is game over (R reassembles, ESC quits); 1/2/3
#       preset cameras, C follow cam. DUCKMODE_TICKS=<n> caps the run
#       for deterministic acceptance: zero rejected steps + engine
#       liveness + world validity end with the tail line
#       "PASS duckmode survived=<ticks> drift=<mm> fall_tick=<k>" -
#       standing is reported as data (the flat-stand contract stays RED
#       until the parallel physics3d ground friction fix lands; the
#       assembly probe measures the same baseline).
#
#   cam1 = LookAt(-4.6, 3.2, 1.7 -> 0.0, 0.8, 1.35, f=950)
#   cam2 = LookAt( 3.0, 3.4, 1.5 -> 0.0, 0.85, 1.30, f=1150)
#   cam3 = LookAt(-1.8, 3.4, 4.6 -> 0.0, 0.85, 1.20, f=850)
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/csgworld
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/onnx_policy
import cheng/game/csg/numerics
import cheng/game/csg/prompt as prompt
import cheng/game/contacts3d
import cheng/game/constraints3d
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/csg/joint_motor
import cheng/game/csg/ball_servo_rigid as bsr
import cheng/game/csg/microduck_model as mm
import cheng/game/cinema/camera
import cheng/game/render/render_state
import cheng/game/render/cpu_raster as raster
import cheng/game/render/mesh_render
import cheng/game/render/gpu_raster
import cheng/game/render/character
import cheng/game/render/text as gui_text
import std/gui
import cheng/game/csg/csgworld
import std/cmdline
import std/strings as strings
import std/os
import std/gui
import std/rawbytes
import std/rawmem_support
import std/monotimes
import std/math as m
const
    PlayerSchema = "cheng.apps.csg_player.v1"
    PlayerOutDir = "artifacts/csg_world_video/player"
    PlayerWidth = 1280
    PlayerHeight = 720
    PlayerTicks = 2400
    PlayerFrameStep = 10
    PlayerFrames = 240
    PlayTickCap = 14400   # 60 s of authority ticks per play session
    # follow cam (C key): position = pelvis + offset, look-at = smoothed
    # pelvis; both converge at FollowSmooth per rendered frame.
    FollowOffsetX = -2.6
    FollowOffsetY = 2.2
    FollowOffsetZ = 0.9
    FollowFocal = 950.0
    FollowSmooth = 0.15
    # JUMP verb (play v0.3): whole-figure +z impulse. The QueueStep winch
    # can only pull a foot toward its static ground anchor (never lift),
    # so the jump rides the established direct-bodyV actuator channel
    # (the balance controller's own kick; balance_probe's shove is the
    # precedent): one constant upward velocity pulse on every figure
    # body — a rigid impulse with zero joint violation, inherited by the
    # Verlet-PBD authority step as a clean ballistic arc (apex = v^2/2g
    # ~ 130 mm at 1.6 m/s, flight ~77 ticks). 1.6 m/s keeps the touchdown
    # inside the disturbance envelope the balance controller provably
    # recovers from (the balance_probe 1.5 m/s shove class); a harder
    # kick lands into a sustained capture storm that collides with later
    # walk queues. The upright servo is
    # suspended for the flight window (its viscous -c*v term would eat
    # the arc; the capture reflex must not queue footsteps mid-air) and
    # restored after touchdown, before the cooldown ends.
    PlayJumpKickMps = 1.6
    PlayJumpCooldownTicks = 240
    PlayJumpAirTicks = 160
    # servo restore needs a real touchdown AND a quiet CoM. The landing
    # impact itself leaves ~0.5-0.7 m/s of horizontal torso-CoM noise
    # (wall-hand friction + asymmetric foot impulses). Restoring the
    # full controller above the 0.4 m/s capture trigger fires the
    # capture reflex immediately, and each capture gait anchors at the
    # feet' mid-motion positions — the winches then hold the feet
    # slightly off their standing spots, the sway rebuilds, and the
    # next capture fires: a storm whose windows collide with later
    # walk queues. Recovery is therefore servo-first: during the
    # recovery window the player layer drives the controller's own
    # upright servo every tick while balOn stays 0 (the capture reflex
    # stays gated off); balOn returns only once the feet are down, the
    # pelvis is near rest and the capture-weighted CoM speed is back
    # under the trigger (with margin). A hard cap (air window + extra)
    # backstops a pathological case.
    PlayJumpLandFootZM = 0.08
    PlayJumpLandPelVzMps = 0.5
    PlayJumpLandComVzMps = 0.35
    PlayJumpRestoreExtraTicks = 320
    # BALLMODE game (--play:<world> --ballmode, the ballbalance physics
    # milestone gamified): the player rides the rolling ball and A/D
    # tap-toggles the user lean offset (execution.CsgBalanceSetUserLean)
    # that steers the figure CoM target left/right. leanX ramps toward
    # the selected direction every authority tick (the clamp lives in
    # the execution setter); the session records the discrete (tick,
    # dir) events, so a replay reconstructs the exact lean trajectory.
    PlayBallLeanStep = 0.005
    # seeded common horizontal velocity on the ball, applied once at
    # PlayBallKickTick — after the 240-tick ball-servo soft-start ramp is
    # done (the full-strength spring is what absorbs the moving-surface
    # transient; kicking at the release tick itself, while the spring is
    # still easing in, was measured toppling the rider by tick ~700 even
    # with zero player input). 400 is the probe's own post-ramp injection
    # precedent (ProbeWalkQueueTick). The seed fully determines both
    # components, and it rides the session file, so the headless replay
    # reproduces the run bit-for-bit.
    PlayBallKickTick = 400
    PlayBallKickMps = 1.20
    # Survival pressure (the lose condition): every PlayGustEveryTick
    # authority ticks a gust rolls the ball — a seeded random horizontal
    # velocity increment on the sphere, the visible random roll the
    # player counter-steers against with A/D ("the ball rolls the way
    # the rider does not compensate"). The frozen N1/N2 ball-top
    # controller absorbs any single gust; the survival tension is the
    # continuous counter-steering and the unlucky gust series landing
    # while leaned out. Gusts derive from (seed, tick), no carried RNG
    # state, so the headless replay reproduces them bit-for-bit from the
    # session seed.
    PlayGustEveryTick = 480
    PlayGustMps = 1.20

# Manual digit parse (char - 48); returns -1 on empty or non-digit input.
fn ParseDigits(s: str): int32 =
    var v: int32 = 0
    var i: int32 = 0
    if s.len == 0:
        return 0 - 1
    while i < s.len:
        let c: int32 = int32(s[i])
        if c < 48 or c > 57:
            return 0 - 1
        v = v * 10 + (c - 48)
        i = i + 1
    return v

@borrows
fn HasPrefix(s: str, pre: str): bool =
    if s.len < pre.len:
        return false
    var k: int32 = 0
    while k < pre.len:
        if s[k] != pre[k]:
            return false
        k = k + 1
    return true

fn RunDump(): int32 =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation status=" + strings.IntToStr(verdict.statusCode))
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize: " + err)
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    var saved: int32 = 0
    var frame: int32 = 0
    var tick: int32 = 0
    while tick < PlayerTicks:
        if tick % PlayerFrameStep == 0:
            render_state.RenderStateSave(st.w, partRoles, render_state.RenderStateFramePath(PlayerOutDir, frame))
            saved = saved + 1
            frame = frame + 1
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL step rejected at tick " + strings.Int64ToStr(receipt.tick))
            return 1
        tick = tick + 1
    echo("PASS dump saved=" + strings.IntToStr(saved) + " frames -> " + PlayerOutDir)
    return 0

fn CameraFor(camN: int32): camera.CinemaCamera =
    if camN == 1:
        return camera.CinemaCameraLookAt(-4.6, 3.2, 1.7, 0.0, 0.8, 1.35, 950.0, PlayerWidth, PlayerHeight)
    elif camN == 2:
        return camera.CinemaCameraLookAt(3.0, 3.4, 1.5, 0.0, 0.85, 1.30, 1150.0, PlayerWidth, PlayerHeight)
    return camera.CinemaCameraLookAt(-1.8, 3.4, 4.6, 0.0, 0.85, 1.20, 850.0, PlayerWidth, PlayerHeight)

fn RunList(): int32 =
    let names: str[] = os.ListDir(PlayerOutDir)
    var first: int32 = 0 - 1
    var last: int32 = 0 - 1
    var count: int32 = 0
    var i: int32 = 0
    while i < names.len:
        let name: str = names[i]
        if HasPrefix(name, "state_f"):
            if strings.HasSuffix(name, ".txt"):
                let n: int32 = ParseDigits(strings.CloneStrRange(name, 7, name.len - 11))
                if n >= 0:
                    if first < 0 or n < first:
                        first = n
                    if n > last:
                        last = n
                    count = count + 1
        i = i + 1
    if count == 0:
        echo("FAIL no state_f<N>.txt files in " + PlayerOutDir)
        return 1
    echo("PASS list first=" + strings.IntToStr(first) + " last=" + strings.IntToStr(last) + " count=" + strings.IntToStr(count) + " dir=" + PlayerOutDir)
    return 0

fn RunAll(camN: int32): int32 =
    os.MkdirAll(PlayerOutDir + "/frames", 493)
    var rendered: int32 = 0
    var f: int32 = 0
    while f < PlayerFrames:
        var st = render_state.RenderStateLoad(render_state.RenderStateFramePath(PlayerOutDir, f))
        if st == nil:
            echo("FAIL cannot load " + render_state.RenderStateFramePath(PlayerOutDir, f))
            return 1
        var useCam: int32 = camN
        if useCam < 1:
            # rotating cameras: frames 0-79 cam1, 80-159 cam2, 160-239 cam3
            if f >= 160:
                useCam = 3
            elif f >= 80:
                useCam = 2
            else:
                useCam = 1
        var cam: camera.CinemaCamera
        cam = CameraFor(useCam)
        var t: raster.RasterTarget
        t = raster.RasterMake(PlayerWidth, PlayerHeight)
        raster.RasterGround(t, cam)
        raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
        character.RenderRopeState(t, cam, st)
        character.RenderCharacterState(t, cam, st)
        let outPath: str = PlayerOutDir + "/frames/player_f" + strings.IntToStr(f) + ".ppm"
        raster.RasterWritePpm(t, outPath)
        rendered = rendered + 1
        f = f + 1
    echo("PASS all rendered=" + strings.IntToStr(rendered) + " frames -> " + PlayerOutDir + "/frames")
    return 0

fn RunFrame(frameN: int32, camN: int32): int32 =
    var st = render_state.RenderStateLoad(render_state.RenderStateFramePath(PlayerOutDir, frameN))
    if st == nil:
        echo("FAIL cannot load " + render_state.RenderStateFramePath(PlayerOutDir, frameN))
        return 1
    var cam: camera.CinemaCamera
    cam = CameraFor(camN)
    var t: raster.RasterTarget
    t = raster.RasterMake(PlayerWidth, PlayerHeight)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRopeState(t, cam, st)
    character.RenderCharacterState(t, cam, st)
    let outPath: str = PlayerOutDir + "/player_f" + strings.IntToStr(frameN) + "_c" + strings.IntToStr(camN) + ".ppm"
    raster.RasterWritePpm(t, outPath)
    echo("PASS frame " + strings.IntToStr(frameN) + " cam " + strings.IntToStr(camN) + " -> " + outPath)
    return 0


# ---- pure-CSG delivery modes (G2) ----

# Load a .csgworld file, re-materialize the world, fast-forward the
# deterministic physics to frame N (N * 10 ticks) and render one frame
# with camera C. No pre-rendered state files are needed: the few-KB
# world description is the entire asset.
@borrows
fn RunWorld(worldPath: str, frameN: int32, camN: int32): int32 =
    var facts: schema.CsgWorldFacts
    let cid: str = csgworld.CsgWorldLoad(worldPath, facts)
    if cid == "":
        echo("FAIL cannot load csgworld " + worldPath)
        return 1
    let recomputed: str = Fmt"{schema.CsgWorldFactsCid(facts)}"
    if recomputed != cid:
        echo("FAIL csgworld cid mismatch")
        return 1
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation status=" + strings.IntToStr(verdict.statusCode))
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    var targetTick: int32 = frameN * PlayerFrameStep
    var tick: int32 = 0
    while tick < targetTick:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL step rejected at tick " + strings.Int64ToStr(receipt.tick))
            return 1
        tick = tick + 1
    var cam: camera.CinemaCamera
    cam = CameraFor(camN)
    var t: raster.RasterTarget
    t = raster.RasterMake(PlayerWidth, PlayerHeight)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    var worldRoles: int32[]
    setLen(worldRoles, 0)
    var wri: int32 = 0
    while wri < facts.partRole.len:
        add(worldRoles, facts.partRole[wri])
        wri = wri + 1
    character.RenderRope(t, cam, st.w)
    character.RenderCharacter(t, cam, st.w, worldRoles)
    let outPath: str = PlayerOutDir + "/world_f" + strings.IntToStr(frameN) + "_c" + strings.IntToStr(camN) + ".ppm"
    raster.RasterWritePpm(t, outPath)
    echo("PASS world frame " + strings.IntToStr(frameN) + " cam " + strings.IntToStr(camN) + " -> " + outPath)
    return 0


# Interactive game loop (pure CSG game v0.1): the world stays live in
# memory; stdin commands advance time or move the camera, every command
# that advances time also renders the current view.
#   S <ticks>   advance the world
#   CAM <1|2|3> switch camera
#   P           render the current view
#   Q           quit
fn RunGame(worldPath: str, cmdsPath: str): int32 =
    var facts: schema.CsgWorldFacts
    let cid: str = csgworld.CsgWorldLoad(worldPath, facts)
    if cid == "":
        echo("FAIL cannot load csgworld " + worldPath)
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    var camN: int32 = 1
    var gameFrame: int32 = 0
    var count2: int32 = 0
    os.MkdirAll(PlayerOutDir + "/game", 493)
    echo("GAME READY cid=" + cid + " (commands: S <ticks> | CAM <1-3> | P | Q)")
    var allCmds: str = os.ReadFile(cmdsPath)
    # split into lines (DoD spans) and execute in order
    var ls: int32[]
    setLen(ls, 0)
    var ll: int32[]
    setLen(ll, 0)
    var curStart: int32 = -1
    var ci: int32 = 0
    var cn: int32 = allCmds.len
    while ci <= cn:
        var isSep: bool = ci == cn
        if !isSep:
            let c: int32 = int32(allCmds[ci])
            if c == 10:
                isSep = true
        if isSep:
            if curStart >= 0:
                add(ls, curStart)
                add(ll, ci - curStart)
                count2 = count2 + 1
                curStart = -1
        else:
            if curStart < 0:
                curStart = ci
        ci = ci + 1
    var li: int32 = 0
    while li < count2:
        var trimmed: str = strings.CloneStrRange(allCmds, ls[li], ll[li])
        if HasPrefix(trimmed, "S ") or HasPrefix(trimmed, "s "):
            let n: int32 = ParseDigits(strings.CloneStrRange(trimmed, 2, trimmed.len - 2))
            if n > 0:
                var k: int32 = 0
                var rejected: bool = false
                var lastRc: int32
                while k < n:
                    var receipt = execution.CsgExecutionTick(st, facts)
                    if receipt.statusCode != physics3d.Physics3dStatusOk:
                        rejected = true
                        lastRc = receipt.statusCode
                    k = k + 1
                if rejected:
                    echo("FAIL physics rejected during advance rc=" + strings.IntToStr(lastRc))
                    return 1
                echo("advanced " + strings.IntToStr(n) + " ticks")
        elif HasPrefix(trimmed, "CAM ") or HasPrefix(trimmed, "cam "):
            let c: int32 = ParseDigits(strings.CloneStrRange(trimmed, 4, trimmed.len - 4))
            if c >= 1:
                if c <= 3:
                    camN = c
                    echo("camera " + strings.IntToStr(camN))
        elif trimmed == "P" or trimmed == "p":
            var cam: camera.CinemaCamera
            cam = CameraFor(camN)
            var t: raster.RasterTarget
            t = raster.RasterMake(PlayerWidth, PlayerHeight)
            raster.RasterGround(t, cam)
            raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
            character.RenderRope(t, cam, st.w)
            character.RenderCharacter(t, cam, st.w, partRoles)
            let outPath: str = PlayerOutDir + "/game/game_f" + strings.IntToStr(gameFrame) + "_c" + strings.IntToStr(camN) + ".ppm"
            raster.RasterWritePpm(t, outPath)
            echo("rendered " + outPath)
            gameFrame = gameFrame + 1
        elif trimmed == "Q" or trimmed == "q":
            echo("bye")
            li = count2
        elif trimmed != "":
            # prompt-grammar verbs (WALK <N> STEPS / STAND <N> SECONDS)
            # inject into the live world through the dynamic step queue;
            # any unrecognized span fails the game loudly
            var intent = prompt.PromptNewIntent()
            prompt.PromptParse(trimmed, intent)
            if !intent.parseOk:
                echo("FAIL unsupported prompt at " + strings.IntToStr(intent.unsupportedAt) + ": " + trimmed)
                return 1
            if intent.walkSteps > 0:
                let wrc = execution.CsgExecutionQueueWalk(st, facts, intent.walkSteps)
                if wrc != 0:
                    echo("FAIL walk: no foot parts in world")
                    return 1
                echo("queued walk " + strings.IntToStr(intent.walkSteps) + " steps")
            if intent.standSeconds > 0:
                var k2: int32
                var rejected2: bool
                var lastRc2: int32
                while k2 < intent.standSeconds * 240:
                    var receipt2 = execution.CsgExecutionTick(st, facts)
                    if receipt2.statusCode != physics3d.Physics3dStatusOk:
                        rejected2 = true
                        lastRc2 = receipt2.statusCode
                    k2 = k2 + 1
                if rejected2:
                    echo("FAIL physics rejected during stand rc=" + strings.IntToStr(lastRc2))
                    return 1
                echo("stood " + strings.IntToStr(intent.standSeconds) + " seconds")
            if intent.climbSeconds > 0:
                echo("FAIL climb is scene-level; load a climb world")
                return 1
        li = li + 1
    echo("PASS game loop frames=" + strings.IntToStr(gameFrame))
    return 0

# ---- window replay mode (--window:<world.csgworld>) ----

# Live replay in a real NSWindow. The Cocoa event pump and the physics
# share the main thread and run strictly sequentially: every iteration
# first pumps window events (ProcessFrame + queue drain), then advances
# PlayerFrameStep deterministic physics ticks, rasterizes the current
# state into the back display surface and pushes it (double-buffered:
# the front surface is never written while displayed). 240 frames total,
# cameras rotating per 80-frame segment.

# HUD overlay painted after the scene raster (screen-space text, no
# depth test): key hints top left, live tick/camera status top right,
# and the last injected event shown top center for 60 frames.
# Shared real-time FPS window: counts rendered frames over 0.5 s and
# returns the refreshed FPS, or -1 while the window is still open (the
# caller keeps painting the previous value). Every interactive mode's
# loop calls this once per rendered frame.
fn FpsWindowAdvance(fpsWinFrames: var int32, fpsWinStartNs: var int64, nowNs: int64): int32 =
    fpsWinFrames = fpsWinFrames + 1
    if fpsWinStartNs == 0:
        fpsWinStartNs = nowNs
    let winLen: int64 = nowNs - fpsWinStartNs
    if winLen >= 500000000:
        let v: int32 = int32(int64(fpsWinFrames) * 1000000000 / winLen)
        fpsWinFrames = 0
        fpsWinStartNs = 0
        return v
    return 0 - 1

@borrows
fn DrawPlayHud(t: raster.RasterTarget,
               tickNow: int64,
               lastEventKind: int32,
               lastEventArg: int32,
               hudFramesLeft: int32,
               camN: int32,
               followOn: bool,
               fpsShown: int32) =
    gui_text.RasterText(t, 8, 8, 2, "W WALK | J JUMP | 1-3 CAM | C FOLLOW | ESC QUIT", 255, 255, 255)
    var statusText: str = "FPS=" + strings.IntToStr(fpsShown) + " T=" + strings.Int64ToStr(tickNow) + " CAM=" + strings.IntToStr(camN)
    if followOn:
        statusText = statusText + " CAM-FOLLOW"
    let statusW: int32 = gui_text.TextPixelWidth(statusText, 2)
    gui_text.RasterText(t, PlayerWidth - statusW - 8, 8, 2, statusText, 255, 255, 255)
    if hudFramesLeft > 0:
        if lastEventKind == 1:
            let evText: str = "WALK QUEUED"
            let evW: int32 = gui_text.TextPixelWidth(evText, 2)
            gui_text.RasterText(t, (PlayerWidth - evW) / 2, 8, 2, evText, 255, 255, 255)
        elif lastEventKind == 2:
            let evText2: str = "CAM " + strings.IntToStr(lastEventArg)
            let evW2: int32 = gui_text.TextPixelWidth(evText2, 2)
            gui_text.RasterText(t, (PlayerWidth - evW2) / 2, 8, 2, evText2, 255, 255, 255)
        elif lastEventKind == 4:
            let evText3: str = "SCENE BUSY - USE PLAYGROUND FOR FREE WALK"
            let evW3: int32 = gui_text.TextPixelWidth(evText3, 2)
            gui_text.RasterText(t, (PlayerWidth - evW3) / 2, 8, 2, evText3, 255, 170, 90)
        elif lastEventKind == 5:
            let evText4: str = "JUMP"
            let evW4: int32 = gui_text.TextPixelWidth(evText4, 2)
            gui_text.RasterText(t, (PlayerWidth - evW4) / 2, 8, 2, evText4, 255, 255, 255)

# Ball-mode overlay: live survive score and lean direction top center;
# on game over the big center banner replaces them (screen-space text
# painted after the scene raster, same contract as DrawPlayHud).
@borrows
fn DrawBallHud(t: raster.RasterTarget,
               survived: int64,
               leanDir: int32,
               gameOver: bool) =
    if gameOver:
        let overText: str = "GAME OVER  survived=" + strings.Int64ToStr(survived)
        let overW: int32 = gui_text.TextPixelWidth(overText, 4)
        gui_text.RasterText(t, (PlayerWidth - overW) / 2, PlayerHeight / 2 - 30, 4, overText, 255, 80, 80)
        let hintText: str = "R RESTART | ESC QUIT"
        let hintW: int32 = gui_text.TextPixelWidth(hintText, 2)
        gui_text.RasterText(t, (PlayerWidth - hintW) / 2, PlayerHeight / 2 + 30, 2, hintText, 255, 255, 255)
    else:
        let survText: str = "SURVIVE " + strings.Int64ToStr(survived)
        let survW: int32 = gui_text.TextPixelWidth(survText, 2)
        gui_text.RasterText(t, (PlayerWidth - survW) / 2, 30, 2, survText, 120, 255, 120)
        var leanText: str = "LEAN -"
        if leanDir == 0 - 1:
            leanText = "LEAN <"
        if leanDir == 1:
            leanText = "LEAN >"
        let leanW: int32 = gui_text.TextPixelWidth(leanText, 2)
        gui_text.RasterText(t, (PlayerWidth - leanW) / 2, 52, 2, leanText, 255, 255, 255)

# clear + render + push one frame into the borrowed back surface
@borrows
fn RenderWindowFrameBack(t: raster.RasterTarget,
                         cam: camera.CinemaCamera,
                         st: execution.CsgExecutionState,
                         partRoles: int32[],
                         dlist: ptr,
                         canvas: ptr,
                         frame: int32,
                         ballSlot: int32,
                         lastEventKind: int32,
                         lastEventArg: int32,
                         hudFramesLeft: int32,
                         camN: int32,
                         followOn: bool,
                         fpsShown: int32,
                         ballMode: bool,
                         leanDir: int32,
                         gameOver: bool,
                         survived: int64) =
    raster.RasterClear(t)
    raster.RasterGround(t, cam)
    raster.RasterWallFace(t, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
    character.RenderRope(t, cam, st.w)
    character.RenderCharacter(t, cam, st.w, partRoles)
    DrawPlayHud(t, st.w.tick, lastEventKind, lastEventArg, hudFramesLeft, camN, followOn, fpsShown)
    if ballMode:
        DrawBallHud(t, survived, leanDir, gameOver)
    if frame % 60 == 0:
        raster.RasterWritePpm(t, PlayerOutDir + "/window/win_f" + strings.IntToStr(frame) + ".ppm")
    gui.DrawListClearPtr(dlist)
    gui.DrawListPushBGRAPtr(dlist, 0, 0, PlayerWidth, PlayerHeight, rawbytes.BytesDataPtr(t.frame.bgra))
    gui.DrawListCanvasSetListPtr(canvas, dlist)

# GPU-path frame: the Metal kernel has already painted ground+wall+depth
# into the borrowed back surface; the CPU adds rope+character on top
# (they are always camera-side of the wall, so painting order carries
# the occlusion) and pushes the surface.
@borrows
fn RenderWindowFrameBackGpu(t: raster.RasterTarget,
                            cam: camera.CinemaCamera,
                            st: execution.CsgExecutionState,
                            partRoles: int32[],
                            dlist: ptr,
                            canvas: ptr,
                            frame: int32,
                            ballSlot: int32,
                            lastEventKind: int32,
                            lastEventArg: int32,
                            hudFramesLeft: int32,
                            camN: int32,
                            followOn: bool,
                            fpsShown: int32,
                            ballMode: bool,
                            leanDir: int32,
                            gameOver: bool,
                            survived: int64) =
    character.RenderRope(t, cam, st.w)
    character.RenderCharacter(t, cam, st.w, partRoles)
    DrawPlayHud(t, st.w.tick, lastEventKind, lastEventArg, hudFramesLeft, camN, followOn, fpsShown)
    if ballMode:
        DrawBallHud(t, survived, leanDir, gameOver)
    if frame % 60 == 0:
        raster.RasterWritePpm(t, PlayerOutDir + "/window/win_f" + strings.IntToStr(frame) + ".ppm")
    gui.DrawListClearPtr(dlist)
    gui.DrawListPushBGRAPtr(dlist, 0, 0, PlayerWidth, PlayerHeight, rawbytes.BytesDataPtr(t.frame.bgra))
    gui.DrawListCanvasSetListPtr(canvas, dlist)

@borrows
fn RunWindow(worldPath: str): int32 =
    var facts: schema.CsgWorldFacts
    let cid: str = csgworld.CsgWorldLoad(worldPath, facts)
    if cid == "":
        echo("FAIL cannot load csgworld " + worldPath)
        return 1
    let recomputed: str = Fmt"{schema.CsgWorldFactsCid(facts)}"
    if recomputed != cid:
        echo("FAIL csgworld cid mismatch")
        return 1
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL facts validation status=" + strings.IntToStr(verdict.statusCode))
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL materialize")
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    var partRoles: int32[]
    setLen(partRoles, 0)
    var ri: int32 = 0
    while ri < facts.partRole.len:
        add(partRoles, facts.partRole[ri])
        ri = ri + 1
    gui.Init()
    let win: ptr = gui.WindowCreatePtr("csg player", PlayerWidth, PlayerHeight)
    let canvas: ptr = gui.DrawListCanvasCreatePtr(0, 0, PlayerWidth, PlayerHeight)
    let dlist: ptr = gui.DrawListNewPtr(4)
    gui.DrawListCanvasSetListPtr(canvas, dlist)
    gui.WindowAddViewPtr(win, canvas)
    gui.WindowShowPtr(win)
    # two raster targets rotating as display surfaces A/B. GPU path: the
    # Metal kernel paints ground+wall+depth into the back group's shared
    # MTLBuffers, adopted as zero-copy views; CPU adds rope+character.
    # Front surface is never written while displayed (pump-then-render
    # order: drawRect for frame N runs at pump N+1, before frame N+2
    # rewrites that surface group). CPU fallback targets keep the run
    # alive when no Metal device exists (headless/CI).
    let gpu: gpu_raster.GpuRaster = gpu_raster.GpuRasterInit(PlayerWidth, PlayerHeight)
    var gpuOk: bool = gpu.ok
    if gpuOk:
        echo("gpu raster ready")
    var surfA: raster.RasterTarget
    var surfB: raster.RasterTarget
    if gpuOk:
        surfA = raster.RasterAdoptViews(PlayerWidth, PlayerHeight, gpu_raster.GpuRasterBgraPtr(gpu, true), gpu_raster.GpuRasterDepthPtr(gpu, true))
        surfB = raster.RasterAdoptViews(PlayerWidth, PlayerHeight, gpu_raster.GpuRasterBgraPtr(gpu, false), gpu_raster.GpuRasterDepthPtr(gpu, false))
    else:
        echo("gpu raster unavailable stage=" + strings.IntToStr(gpu.failStage) + ", cpu path")
        surfA = raster.RasterMake(PlayerWidth, PlayerHeight)
        surfB = raster.RasterMake(PlayerWidth, PlayerHeight)
    var useSurfA: bool = false
    os.MkdirAll(PlayerOutDir + "/window", 493)
    var frame: int32 = 0
    var quit: bool = false
    var fpsShown: int32 = 0
    var fpsWinFrames: int32 = 0
    var fpsWinStartNs: int64 = 0
    while frame < PlayerFrames:
        gui.ProcessFrame()
        # cocoa_bridge 的 cheng_app_run_frame 在主循环未走 [NSApp run] 时
        # 每帧都推一个假 EVENT_QUIT（[NSApp isRunning]==NO），真实窗口仍在，
        # 因此 QUIT 不作为退出信号；退出走 ESC(53)/Q(12) 键与 240 帧上限。
        var ev: int32 = gui.NextEvent()
        while ev != gui.EVENT_NONE:
            if ev == gui.EVENT_KEY:
                let key: int32 = gui.EventKey()
                if key == 53 or key == 12:
                    quit = true
            gui.ConsumeEvent()
            ev = gui.NextEvent()
        if quit:
            break
        var tick: int32 = 0
        while tick < PlayerFrameStep:
            var receipt = execution.CsgExecutionTick(st, facts)
            if receipt.statusCode != physics3d.Physics3dStatusOk:
                echo("FAIL step rejected at tick " + strings.Int64ToStr(receipt.tick))
                return 1
            tick = tick + 1
        var useCam: int32 = 1
        if frame >= 160:
            useCam = 3
        elif frame >= 80:
            useCam = 2
        var cam: camera.CinemaCamera
        cam = CameraFor(useCam)
        let fpsv: int32 = FpsWindowAdvance(fpsWinFrames, fpsWinStartNs, monotimes.MonoTimeNs(monotimes.GetMonoTime()))
        if fpsv >= 0:
            fpsShown = fpsv
        if gpuOk:
            gpu_raster.GpuRasterFrame(gpu, useSurfA, cam, 0.5, -2.0, 2.0, 0.0, 4.0)
        if useSurfA:
            if gpuOk:
                RenderWindowFrameBackGpu(surfA, cam, st, partRoles, dlist, canvas, frame, 0 - 1, 0, 0, 0, useCam, false, fpsShown, false, 0, false, 0)
            else:
                RenderWindowFrameBack(surfA, cam, st, partRoles, dlist, canvas, frame, 0 - 1, 0, 0, 0, useCam, false, fpsShown, false, 0, false, 0)
        else:
            if gpuOk:
                RenderWindowFrameBackGpu(surfB, cam, st, partRoles, dlist, canvas, frame, 0 - 1, 0, 0, 0, useCam, false, fpsShown, false, 0, false, 0)
            else:
                RenderWindowFrameBack(surfB, cam, st, partRoles, dlist, canvas, frame, 0 - 1, 0, 0, 0, useCam, false, fpsShown, false, 0, false, 0)
        useSurfA = !useSurfA
        frame = frame + 1
    gui.WindowClosePtr(win)
    echo("PASS window frames=" + strings.IntToStr(frame) + " world=" + worldPath)
    return 0

# ---- duckmode (--duckmode): the machine-duck ball-balance mode ----
#
# The duck assembly is the microduck_assembly_probe buildDuck verbatim
# (the M6 real-parameter 13-link/12-joint table: trunk + per leg hip-
# yoke/thigh/shin/foot plate + the 4-body neck chain, total mass
# 0.7443611 kg - the verbatim MJCF inertial sum), spawned at the
# balanced stance (hips pitched +-0.43 rad about the real hip-pitch
# anchors, soles flat, root lifted by MicroduckStanceRootZLift) onto
# the ball top, then the ball injected after the assembly and before
# the first physics step (the probe injection window; the duck does not
# run through CsgExecutionInit/ExecutionInit - direct world3d assembly
# + Physics3dStep, like the probes). All 12 joints are hinge servos
# created from the model table (anchors/axes mapped into each body's
# spawn-local frame, MJCF flexion references, verbatim MJCF limits),
# every servo parked at its measured stance angle so tick 0 commands no
# step change.
#
# The ball is the real size-7 spec (r = 0.121 m, m = 0.62 kg): the old
# producer solid (r = 0.35, m = 30) belonged to the retired 1.44 kg M5a
# duck. The ball-frame servo (bsr, frozen N1 defaults) was tuned
# against that heavy ball; its fit to the real-ball + real-duck pair is
# measured data now - DuckBallServoOn is the master switch and the
# trace records the armed latch per sample.
#
# Standing honesty: the parallel physics3d friction fix is still in
# flight, so the flat-stand upright contract is RED at this baseline
# (the assembly probe measures the feet creeping out of the support on
# the provisioned per-end friction). The duckmode verdict therefore
# gates the assembly + engine contract only - zero rejected steps, no
# stall, world validity - and reports standing (fall_tick) as data.
#
# Physics-loop discipline (probe contract): the tick loop is scalar
# math only — no str construction, no echo, no allocation; the HUD is
# painted per rendered frame (10 ticks apart) and the numeric trace is
# buffered into preallocated arrays, echoed after the loop.

const
    # the ball: the real size-7 basketball spec (r = 0.121 m, m = 0.62
    # kg), resting on the ground plane at (0, 0.85, r); the duck root
    # pose stands the sole plane on the ball top = 2r.
    DuckBallRadiusM: float64 = 0.121
    DuckBallMassKg: float64 = 0.62
    DuckBallCenterX: float64 = 0.0
    DuckBallCenterY: float64 = 0.85
    DuckBallCenterZ: float64 = 0.121
    DuckRootZ: float64 = 0.242
    # ground-mode spawn: the duck stands on the FLOOR next to the ball
    # (G key), the ground-locomotion skill set home position. Root Z
    # 0.0 = sole plane exactly ON the floor: any spawn drop re-enters
    # the rigid solve as launch velocity (the Verlet rebuild reads the
    # settlement pushout as real motion) and the duck pogo-bounces off
    # the support poles — measured foot rebounds to 107 mm from an
    # 8 mm drop before the plank topple at t=136.
    DuckGroundRootX: float64 = 0.7
    DuckGroundRootY: float64 = 0.85
    DuckGroundRootZ: float64 = 0.0
    # -- ground gait (W key walks, A/D steer later; the stance hip is
    #    +-0.43 rad, MJCF flexion convention: positive = flexion) --
    DuckGaitFreqHz: float64 = 1.6
    DuckGaitHipAmpRad: float64 = 0.10
    DuckGaitKneeSwingRad: float64 = 0.22
    # ankle push-off amplitude: the stance-side plantarflexion burst
    # both propels and counter-pitches the torso (0.08 was invisible
    # against the 0.4579 counter-stance; the v1 topple was the
    # uncountered swing-reaction pitch)
    DuckGaitAnkleAmpRad: float64 = 0.18
    # swing knee phase lead: the knee lifts BEFORE the hip swings
    # forward (foot clearance precedes leg travel; simultaneous lift
    # scraped the ground)
    DuckGaitKneeLeadRad: float64 = 0.55
    # jump burst phases (Space): crouch knee flexion then a knee-
    # extension + ankle plantarflexion burst — the hop mechanics the
    # support-row solver now transmits faithfully
    DuckJumpCrouchKneeRad: float64 = 0.44
    DuckJumpAnkleBurstRad: float64 = 0.9
    # hip common-mode sway: both hips flex slightly with the swing —
    # the torso leans back into the swing reaction
    DuckGaitHipSwayRad: float64 = 0.06
    # swing-leg retraction: hip-yaw splay during swing (lateral
    # stabilizer — pulls the swing leg's mass out of the roll axis)
    DuckGaitRetractRad: float64 = 0.08
    DuckGaitPhase0: float64 = 0.0
    # ball-frame servo master switch (the frozen N1 caseB parameters
    # were tuned against the heavy producer ball; the switch disarms
    # without touching the probe wiring)
    DuckBallServoOn: bool = true
    # 13 duck bodies (slots 0-12, the assembly table order: trunk, L
    # yoke/thigh/shin/foot, R yoke/thigh/shin/foot, neck, head pitch
    # carrier, head yaw carrier, head) + 1 ball = the exact world
    # population, asserted at spawn
    # 15-link model: 15 links + ball; the ball slot moved 13 -> 15
    DuckBodyTotal: int32 = 16
    DuckBallSlot: int32 = 15
    # 10 authority ticks per rendered frame (24 fps at 240 Hz), the
    # play-mode frame step; DuckTickCapDefault bounds an interactive
    # session (60 s), DUCKMODE_TICKS overrides it for the
    # deterministic acceptance run
    DuckFrameTicks: int32 = 10
    DuckTickCapDefault: int32 = 14400
    DuckTraceStride: int32 = 300
    DuckTraceCount: int32 = 33
    # per-frame authority-tick budget: ticks run until this much wall
    # time is spent (minimum two), so a solver spike tick costs one long
    # frame instead of freezing the window; the sim then flows at the
    # delivered tick rate (slow-motion, not a slideshow)
    DuckFrameBudgetNs: int64 = 20000000
    # mesh LOD: beyond this squared camera-torso distance the duck draws
    # as cheap link impostors; inside it the (decimated) mesh batch runs.
    # The game loads the lod/ decimated meshes (~19k instance triangles,
    # 6x below the originals) so the batch prepass fits the frame budget
    # at the default camera distance. First-person forces impostors: the
    # eye rides the head link, the meshes are self-occluding there.
    DuckMeshLodDist2: float64 = 6.25
    # interactive lean: lateral velocity impulse per tick on the torso
    # body during the burst window after an A/D tap (a forever latch
    # turned any stray keystroke into a 240 Hz pump that drove the pair
    # off screen); the servo recovers, visible dynamic balance
    DuckLeanImpulseMps = 0.02
    DuckLeanBurstTicks: int32 = 24
    # a rejected step rolls back and never advances the tick, so 64
    # straight rejects at one tick is an engine stall (assembly-probe
    # guard), reported as data instead of being spun on silently
    DuckStallRejectRun: int32 = 64
    DuckAngleNeutralTolRad: float64 = 0.001
    DuckAnchorGapTolM: float64 = 0.001
    # follow camera (C key): position = torso + fixed offset, look-at =
    # smoothed torso; both converge at DuckFollowSmooth per frame
    DuckFollowOffX: float64 = -1.7
    DuckFollowOffY: float64 = 1.5
    DuckFollowOffZ: float64 = 0.9
    DuckFollowFocal: float64 = 950.0
    DuckFollowSmooth: float64 = 0.15
    # -- interactive cameras (WoW scheme: keyboard camera, key-repeat
    #    events drive rotation; the cocoa bridge delivers no mouse-up, so
    #    drag-look is not attempted) --
    # F (kVK_ANSI_F=3) first-person: eye rides the head link, view
    # direction (yaw,pitch). V (kVK_ANSI_V=9) orbit: full 360-degree
    # panorama around the torso pivot, W/S (13/1) dolly. Arrow keys
    # (kVK 123/124/125/126) steer whichever camera mode is active.
    DuckKeyF: int32 = 3
    DuckKeyV: int32 = 9
    DuckKeyLeft: int32 = 123
    DuckKeyRight: int32 = 124
    DuckKeyDown: int32 = 125
    DuckKeyUp: int32 = 126
    DuckKeyW: int32 = 13
    DuckKeyS: int32 = 1
    # per-second camera rates integrated per rendered frame from held-key
    # deadlines (refreshed by key-repeat events): a full 360-degree sweep
    # is frame-rate-continuous instead of bursty key-repeat steps
    DuckCamYawRateS: float64 = 2.2
    DuckCamPitchRateS: float64 = 1.6
    DuckCamPitchMax: float64 = 1.35
    DuckKeyHoldNs: int64 = 200000000
    # initial view faces -X: the side both the presets and the follow cam
    # watch from, so entering FPV/orbit continues the same sight line
    DuckCamYaw0: float64 = 3.141592653589793
    DuckCamPitch0: float64 = -0.12
    DuckOrbitDist0: float64 = 2.2
    DuckOrbitDistMin: float64 = 0.7
    DuckOrbitDistMax: float64 = 6.0
    DuckOrbitDollyRateS: float64 = 1.5
    # orbit eye never dips under the ground plane (the checker floor is
    # single-sided), so the panorama stays seamless through the full
    # 360 degrees at every pitch
    DuckOrbitGroundMargin: float64 = 0.06
    # -- MICRODUCK official STL meshes (binary STL, metres; loaded once
    #    at startup, see DuckMeshesLoad). Dock mapping = the duck_film
    #    DrawDuckMeshes table verbatim: trunk_base->torso,
    #    bearing_roll->hip yokes (official urdf asymmetry docked),
    #    upper_leg_left->thighs (mirror side = rigid yaw-pi
    #    approximation), foot_left+ankle_left->feet (same mirror rule),
    #    bottom_head_shell+face_part->head; both shins + the neck chain
    #    have no shipped mesh and stay dark capsule impostors.
    DuckMeshPathTrunk = "assets/microduck_meshes/lod/trunk_base.stl"
    DuckMeshPathBearing = "assets/microduck_meshes/lod/bearing_roll.stl"
    DuckMeshPathUpperLeg = "assets/microduck_meshes/lod/upper_leg_left.stl"
    DuckMeshPathFoot = "assets/microduck_meshes/lod/foot_left.stl"
    DuckMeshPathAnkle = "assets/microduck_meshes/lod/ankle_left.stl"
    DuckMeshPathHeadShell = "assets/microduck_meshes/lod/bottom_head_shell.stl"
    DuckMeshPathFace = "assets/microduck_meshes/lod/face_part.stl"
    # -- second wave (completeness pass): head top shell, the beak (jaw
    #    + soft mouth top), torso side shells, the hip shell, the XL330
    #    servo shells (thigh/shin joints), the real shin and the foot
    #    sole — all lod/ decimated; dock constants derived from the
    #    official URDF visual origins (frame map validated on the
    #    existing head pair)
    DuckMeshPathHeadTop = "assets/microduck_meshes/lod/top_head_shell.stl"
    DuckMeshPathMouth = "assets/microduck_meshes/lod/soft_mouth_top.stl"
    DuckMeshPathJaw = "assets/microduck_meshes/lod/jaw.stl"
    DuckMeshPathShellL = "assets/microduck_meshes/lod/left_shell.stl"
    DuckMeshPathShellR = "assets/microduck_meshes/lod/right_shell.stl"
    DuckMeshPathHip = "assets/microduck_meshes/lod/hip_l.stl"
    DuckMeshPathXl330 = "assets/microduck_meshes/lod/xl330.stl"
    DuckMeshPathLeg = "assets/microduck_meshes/lod/leg.stl"
    DuckMeshPathSole = "assets/microduck_meshes/lod/sole_right.stl"
    # handle-table slots (load order = the path order above)
    DuckMeshIdxTrunk = 0
    DuckMeshIdxBearing = 1
    DuckMeshIdxUpperLeg = 2
    DuckMeshIdxFoot = 3
    DuckMeshIdxAnkle = 4
    DuckMeshIdxHeadShell = 5
    DuckMeshIdxFace = 6
    DuckMeshIdxHeadTop = 7
    DuckMeshIdxMouth = 8
    DuckMeshIdxJaw = 9
    DuckMeshIdxShellL = 10
    DuckMeshIdxShellR = 11
    DuckMeshIdxHip = 12
    DuckMeshIdxXl330 = 13
    DuckMeshIdxLeg = 14
    DuckMeshIdxSole = 15
    DuckMeshHandleCount = 16
    # full-model link slots (the mm.MicroduckModelBuild order:
    # torso = 0, head = mm.MicroduckLinkHead = 14, ball = DuckBallSlot
    # = 15); the hip roll carriers at 2/7 are new in the 15-link model
    DuckLinkYokeL: int32 = 1
    DuckLinkRollL: int32 = 2
    DuckLinkThighL: int32 = 3
    DuckLinkShinL: int32 = 4
    DuckLinkFootL: int32 = 5
    DuckLinkYokeR: int32 = 6
    DuckLinkRollR: int32 = 7
    DuckLinkThighR: int32 = 8
    DuckLinkShinR: int32 = 9
    DuckLinkFootR: int32 = 10
    DuckLinkNeck: int32 = 11
    DuckLinkHeadPitch: int32 = 12
    DuckLinkHeadYaw: int32 = 13
    DuckLinkHead: int32 = 14
    # -- urdf official visual palette (0..255) for the docked meshes --
    DuckColorCreamR = 247
    DuckColorCreamG = 230
    DuckColorCreamB = 203
    DuckColorOrangeR = 248
    DuckColorOrangeG = 78
    DuckColorOrangeB = 5
    DuckColorGreyR = 82
    DuckColorGreyG = 82
    DuckColorGreyB = 86
    DuckColorMotorR = 40
    DuckColorMotorG = 40
    DuckColorMotorB = 44
    # basketball palette for the ball impostor (raster.RasterBasketball
    # base/groove): FIBA orange leather + dark seam grooves
    DuckBallBaseR: int32 = 224
    DuckBallBaseG: int32 = 116
    DuckBallBaseB: int32 = 50
    DuckBallGrooveR: int32 = 30
    DuckBallGrooveG: int32 = 26
    DuckBallGrooveB: int32 = 24

type
    DuckSession =
        rejected: int32
        firstRejectTick: int32
        rejectRun: int32
        stallTick: int64
        fallTick: int64
        gameOver: bool
        restartReq: bool
        driftMax: float64
        # release-pose scalars re-frozen at every (re)assembly
        torsoZ0: float64
        ballX0: float64
        ballY0: float64
        ti: int32
        survivedFinal: int64
        # interactive lean direction: -1 = lean left (A), +1 = lean right
        # (D), 0 = neutral. Each tick of the LEAN WINDOW the torso gets a
        # small lateral velocity impulse — a tap fires a bounded burst
        # instead of a forever latch (a stray keystroke used to pump the
        # pair off screen at 240 Hz).
        leanDir: int32
        leanTicks: int32
        # ground locomotion spawn (G key toggles at restart)
        groundSpawn: bool

fn DuckSessionReset(sess: var DuckSession) =
    sess.rejected = 0
    sess.firstRejectTick = 0 - 1
    sess.rejectRun = 0
    sess.stallTick = 0 - 1
    sess.fallTick = 0 - 1
    sess.gameOver = false
    sess.restartReq = false
    sess.driftMax = 0.0
    sess.leanDir = 0
    sess.leanTicks = 0
    sess.groundSpawn = false
    sess.torsoZ0 = 0.0
    sess.ballX0 = 0.0
    sess.ballY0 = 0.0
    sess.ti = 0
    sess.survivedFinal = 0
    sess.leanDir = 0

# Standing balance feedback (robotd IMU loop, scalar reduction): the
# torso tilt (pitch about world X, roll about world Y from the up
# vector) drives ankle and hip goal offsets. Gains are mild — the
# servo rate/torque caps do the rest.
fn DuckStandBalanceTick(w: var World3d, footL: int32, footR: int32) =
    # DELTA goals over the captured stance base: the ankle base includes
    # the -2 deg sole counter, the hips the stance pitch — the balance
    # writes ride ON TOP instead of resetting the stance (the original
    # absolute write also zeroed the knee goals every call, killing the
    # +4 deg knee preload — why this loop was left unwired)
    if duckCiYokeL < 0:
        return
    let qw = w.bodyQuatW[mm.MicroduckLinkTorso]
    let qx = w.bodyQuatX[mm.MicroduckLinkTorso]
    let qy = w.bodyQuatY[mm.MicroduckLinkTorso]
    let qz = w.bodyQuatZ[mm.MicroduckLinkTorso]
    let upxT = 2.0 * (qx * qz + qw * qy)
    let upyT = 2.0 * (qy * qz - qw * qx)
    let tiltX = upxT
    let tiltY = upyT
    let vx = w.bodyVx[mm.MicroduckLinkTorso]
    let vy = w.bodyVy[mm.MicroduckLinkTorso]
    let kA: float64 = float64(duckBalKAM) / 1000.0
    let kD: float64 = float64(duckBalKDM) / 1000.0
    var pitchCmd = kA * tiltX + kD * vx
    var rollCmd = kA * tiltY + kD * vy
    if !(pitchCmd > -1000.0) or !(pitchCmd < 1000.0):
        return
    if !(rollCmd > -1000.0) or !(rollCmd < 1000.0):
        return
    if pitchCmd > 0.3:
        pitchCmd = 0.3
    if pitchCmd < 0.0 - 0.3:
        pitchCmd = 0.0 - 0.3
    if rollCmd > 0.25:
        rollCmd = 0.25
    if rollCmd < 0.0 - 0.25:
        rollCmd = 0.0 - 0.25
    if !duckBalArmed:
        duckBalBaseAnkleLm = int32(w.conGoal[duckCiAnkleL] * 1000.0)
        duckBalBaseAnkleRm = int32(w.conGoal[duckCiAnkleR] * 1000.0)
        duckBalBaseHipLm = int32(w.conGoal[duckCiHipL] * 1000.0)
        duckBalBaseHipRm = int32(w.conGoal[duckCiHipR] * 1000.0)
        duckBalBaseYokeLm = int32(w.conGoal[duckCiYokeL] * 1000.0)
        duckBalBaseYokeRm = int32(w.conGoal[duckCiYokeR] * 1000.0)
        duckBalArmed = true
    let baseAL = float64(duckBalBaseAnkleLm) / 1000.0
    let baseAR = float64(duckBalBaseAnkleRm) / 1000.0
    let baseHL = float64(duckBalBaseHipLm) / 1000.0
    let baseHR = float64(duckBalBaseHipRm) / 1000.0
    let baseYL = float64(duckBalBaseYokeLm) / 1000.0
    let baseYR = float64(duckBalBaseYokeRm) / 1000.0
    let dP = pitchCmd - float64(duckBalLastPitchM) / 1000.0
    let dR = rollCmd - float64(duckBalLastRollM) / 1000.0
    if (numerics.CsgAbs(dP) > 0.002) or (numerics.CsgAbs(dR) > 0.002):
        w.conGoal[duckCiAnkleL] = baseAL - pitchCmd
        w.conGoal[duckCiAnkleR] = baseAR - pitchCmd
        w.conGoal[duckCiHipL] = baseHL + pitchCmd * 0.5
        w.conGoal[duckCiHipR] = baseHR - pitchCmd * 0.5
        w.conGoal[duckCiYokeL] = baseYL + rollCmd
        w.conGoal[duckCiYokeR] = baseYR - rollCmd
        duckBalLastPitchM = int32(pitchCmd * 1000.0)
        duckBalLastRollM = int32(rollCmd * 1000.0)

# Roll-only standing balance: the LATERAL lean (up_y, the torso
# up-vector's y component — the axis the slow rocking random walk
# lives on) drives the yoke goals; throttled (DUCK_ROLL_DIV),
# clamped, finite-guarded. The yokes have been the TRUE hip roll
# hinges since 13707ea4c (axis (0,1,0) = the model FORWARD axis,
# unmirrored L/R, +-22 deg) — which is exactly why they are the
# WRONG actuator for this loop: rotation about the model +y axis
# leaves up_y invariant, so the yokes can neither see nor move the
# sensed quantity, and their opposite-sign writes torque the torso
# from the two hips in opposite senses (a canceling leg-scissor
# noise source). The true lateral authority is the ANKLE WEDGE:
# the ankle axes are mirrored (L (1,0,0) / R (-1,0,0)), so opposite
# goal deltas rotate both feet the SAME world direction about x —
# shifting the sole contact along the +-y lean axis.
# Modes:
# - legacy default: yoke +-write + optional ankle wedge
#   (DUCK_ROLL_ANKLE_M, 0 = off).
# - DUCK_YOKE_TRUE_ROLL=1: yoke writes dropped, ankle wedge always
#   on (authority DUCK_ROLL_ANKLE_M if set, else the calibrated
#   default) — the roll loop becomes a pure lateral loop.
@borrows
fn DuckStandRollTick(w: var World3d) =
    if duckCiYokeL < 0:
        return
    let qx = w.bodyQuatX[mm.MicroduckLinkTorso]
    let qy = w.bodyQuatY[mm.MicroduckLinkTorso]
    let qz = w.bodyQuatZ[mm.MicroduckLinkTorso]
    let qw = w.bodyQuatW[mm.MicroduckLinkTorso]
    let upyT = 2.0 * (qy * qz - qw * qx)
    if !(upyT > -1000.0) or !(upyT < 1000.0):
        return
    var rollCmd = float64(duckRollGainM) / 1000.0 * upyT
    let rollClamp = float64(duckRollClampM) / 1000.0
    if rollCmd > rollClamp:
        rollCmd = rollClamp
    if rollCmd < 0.0 - rollClamp:
        rollCmd = 0.0 - rollClamp
    if duckYokeTrueRollS != 0:
        var wedgeM: int32 = duckRollAnkleM
        if wedgeM == 0:
            wedgeM = DuckRollWedgeDefaultM
        let d = float64(wedgeM) / 1000.0 * rollCmd
        w.conGoal[duckCiAnkleL] = w.conGoal[duckCiAnkleL] + d
        w.conGoal[duckCiAnkleR] = w.conGoal[duckCiAnkleR] - d
    else:
        w.conGoal[duckCiYokeL] = rollCmd
        w.conGoal[duckCiYokeR] = 0.0 - rollCmd
        if duckRollAnkleM != 0:
            let d = float64(duckRollAnkleM) / 1000.0 * rollCmd
            w.conGoal[duckCiAnkleL] = w.conGoal[duckCiAnkleL] + d
            w.conGoal[duckCiAnkleR] = w.conGoal[duckCiAnkleR] - d

# Ground gait oscillator: one tick of the walk skill. The two hips
# receive opposite-phase pitch oscillations about the stance angle (the
# swing leg flexes forward, the stance leg extends back), each knee
# lifts during its hip swing-forward half (phase lead pi/2 reads as the
# foot clearing), and the ankles counter-rotate to keep the soles near
# flat. Goals ride the engine's double-capped servo walk.
@borrows
fn DuckGaitTick(w: var World3d, phase: var float64, dt: float64) =
    let twoPi: float64 = 6.283185307179586
    var np: float64 = phase + twoPi * float64(gaitFreqHzM) * 0.001 * dt
    if np >= twoPi:
        np = np - twoPi
    phase = np
    # local snapshot: reading the var param after the write trips the
    # cold typed-let kind check (var param reads as kind 18)
    let ph: float64 = np + 0.0
    let st = mm.MicroduckStanceHipRad
    # L hip: stance angle + swing; R hip: stance angle - swing
    let phL: float64 = ph
    let phR: float64 = ph + 3.141592653589793
    let sw = float64(gaitHipAmpM) * 0.001 * m.sinFloat(phL)
    # pitch-rate sway damper: common-mode hip flexion against the
    # torso angular velocity y — the outer pitch loop the fixed goals
    # lack; clamped to the amp scale
    var sway = float64(gaitSwayAmpM) * 0.001 * w.bodyAngVy[mm.MicroduckLinkTorso]
    if sway > 0.12:
        sway = 0.12
    if sway < 0.0 - 0.12:
        sway = 0.0 - 0.12
    # swing-leg retraction: during each side's swing (same max(0,sin)
    # window as its knee lift) the hip yaw splays the foot outward,
    # pulling the swing leg's mass inward-out of the roll axis — the
    # lateral stabilizer the pitch-only oscillator lacked
    let swingL = m.maxFloat(0.0, m.sinFloat(phL))
    let swingR = m.maxFloat(0.0, m.sinFloat(phR))
    let retrL = DuckGaitRetractRad * swingL
    let retrR = DuckGaitRetractRad * swingR
    # weight transfer: the loaded side's hip carries a small extension
    # bias through its stance window (support stiffness follows load)
    let loadL = m.maxFloat(0.0, m.sinFloat(phL))
    let loadR = m.maxFloat(0.0, m.sinFloat(phR))
    let wtx: float64 = 0.05 * (loadL - loadR)
    # L hip parked at +st; R hip parked at -st (MJCF mirrored) — the
    # oscillation rides each side's own park base
    w.conGoal[duckCiHipL] = st + sw - sway + wtx
    w.conGoal[duckCiHipR] = 0.0 - st + sw - sway + wtx
    # yaws: retraction pull-IN during each side's own swing PLUS the
    # roll P term (the torso up-vector y component) — retraction alone
    # is symmetric and can't see asymmetric drift; the roll term
    # splays INTO the falling side and reloads that leg
    let upyG = 2.0 * (w.bodyQuatY[mm.MicroduckLinkTorso] * w.bodyQuatZ[mm.MicroduckLinkTorso] - w.bodyQuatW[mm.MicroduckLinkTorso] * w.bodyQuatX[mm.MicroduckLinkTorso])
    var rollCmd = 0.0 - float64(gaitRollGainM) * 0.001 * upyG
    if rollCmd > 0.15:
        rollCmd = 0.15
    if rollCmd < 0.0 - 0.15:
        rollCmd = 0.0 - 0.15
    let ank = float64(gaitAnkleAmpM) * 0.001 * m.sinFloat(phR)
    w.conGoal[duckCiYokeL] = 0.0 - retrL + rollCmd
    w.conGoal[duckCiYokeR] = retrR + rollCmd
    # ankles: push-off phase (tunable) + roll re-level + LATERAL
    # VELOCITY damper: the torso vy (sideways COM drift) drives a
    # differential ankle offset that plants the falling side — the
    # full-rate lateral reactivity the fixed goals lacked
    let ankPhase: float64 = float64(gaitAnkPhaseM) * 0.001
    let ank = DuckGaitAnkleAmpRad * m.sinFloat(phR + ankPhase)
    w.conGoal[duckCiAnkleL] = 0.0 - st + ank - rollCmd * 0.5
    w.conGoal[duckCiAnkleR] = st - ank - rollCmd * 0.5
    # double-support window: right after each side's push (sin crossing
    # down through 0) both knees hold a small transfer flexion
    let dblFlex: float64 = float64(gaitDblSupM) * 0.001 * 0.3
    # knees: lift with a phase LEAD ahead of the same-side hip swing
    let kneeL = float64(gaitKneeSwingM) * 0.001 * m.maxFloat(0.0, m.sinFloat(phL - float64(gaitKneeLeadM) * 0.001))
    let kneeR = float64(gaitKneeSwingM) * 0.001 * m.maxFloat(0.0, m.sinFloat(phR - float64(gaitKneeLeadM) * 0.001))
    w.conGoal[duckCiKneeL] = kneeL
    w.conGoal[duckCiKneeR] = kneeR
    # hips: side oscillation only (the sway common-mode rolled the
    # torso; the yaw splay over-rotated hipR past its -22 deg passive
    # limit band and stiffened the leg into a launch)
    w.conGoal[duckCiHipL] = st + sw
    w.conGoal[duckCiHipR] = 0.0 - st + sw


# Millimetres through the probe formatter (strings carries no float
# formatter): "-12.345" style, three decimals.
fn DuckFmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var sign: str = ""
    if neg:
        sign = "-"
    return sign + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)

# Park the servo command and goal at the measured standing flexion so
# tick 0 commands no step change; returns the measured angle.
fn DuckParkHingeServo(w: var World3d, ci: int32): float64 =
    let th0 = constraints3d.Constraints3dHingeAngle(w, ci)
    w.conCmd[ci] = th0
    w.conGoal[ci] = th0
    return th0

# One MJCF joint -> one hinge servo, the microduck_assembly_probe
# stanceHinge verbatim: the anchor/axis are mapped into each body's
# spawn-local frame (the inverse of the spawn pose rotation), the
# flexion reference vector (root frame, perpendicular to the axis,
# shared by both bodies so the measured angle is 0 at the zero pose and
# the MJCF sign convention is preserved), and the servo limits are the
# verbatim MJCF range.
@borrows
fn DuckStanceHinge(w: var World3d, mdl: mm.MicroduckModel, jointIdx: int32, refX: float64, refY: float64, refZ: float64, tauMax: float64, omegaRadS: float64): int32 =
    let jt = mdl.joints[jointIdx]
    let pl = mdl.links[jt.parentLink]
    let cl = mdl.links[jt.childLink]
    var anchAx: float64
    var anchAy: float64
    var anchAz: float64
    mm.MicroduckPointToLocal(pl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, pl.cx, pl.cy, pl.cz, anchAx, anchAy, anchAz)
    var axisAx: float64
    var axisAy: float64
    var axisAz: float64
    mm.MicroduckVecToLocal(pl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisAx, axisAy, axisAz)
    var anchBx: float64
    var anchBy: float64
    var anchBz: float64
    mm.MicroduckPointToLocal(cl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, cl.cx, cl.cy, cl.cz, anchBx, anchBy, anchBz)
    var axisBx: float64
    var axisBy: float64
    var axisBz: float64
    mm.MicroduckVecToLocal(cl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisBx, axisBy, axisBz)
    let ci = world3d.World3dAddHingeJoint(w, jt.parentLink, jt.childLink, world3d.World3dConHingeServo, anchAx, anchAy, anchAz, anchBx, anchBy, anchBz, axisAx, axisAy, axisAz, axisBx, axisBy, axisBz)
    var refAlX: float64
    var refAlY: float64
    var refAlZ: float64
    mm.MicroduckVecToLocal(pl.axisKind, refX, refY, refZ, refAlX, refAlY, refAlZ)
    var refBlX: float64
    var refBlY: float64
    var refBlZ: float64
    mm.MicroduckVecToLocal(cl.axisKind, refX, refY, refZ, refBlX, refBlY, refBlZ)
    world3d.World3dSetHingeRefs(w, ci, refAlX, refAlY, refAlZ, refBlX, refBlY, refBlZ)
    world3d.World3dSetHingeServo(w, ci, tauMax, omegaRadS, jt.minRad, jt.maxRad)
    if constraints3d.Constraints3dJointAnchorGap(w, ci) > DuckAnchorGapTolM:
        panic("duckmode: hinge pivot gap at " + jt.name)
    return ci

# Weld completion for a parked head-chain junction: two extra servo
# hinges co-located with the base hinge, axes perpendicular to it —
# three orthogonal locked rotations over the shared anchor pin = a
# rigid weld built entirely from the hinge primitive. The parked
# 4-joint head chain is kinematically one rigid body, but its light
# carrier (5.7 g) sandwiched between heavy neighbours gives the
# per-hinge Gauss-Seidel a spectral radius >= 1 (measured: the
# head-pitch anchor gap cycles 9->2->9 mm sweep over sweep); explicit
# welds remove the free DOF the GS cycled on.
@borrows
fn DuckWeldTwoAxis(w: var World3d, baseCi: int32, tau: float64, omegaRadS: float64) =
    let aSlot = w.conA[baseCi]
    let bSlot = w.conB[baseCi]
    let uW = constraints3d.constraints3dBodyQuatRot(w, aSlot, constraints3d.constraints3dVec(w.conAxisAx[baseCi], w.conAxisAy[baseCi], w.conAxisAz[baseCi]))
    # first perpendicular axis: uW x world-z (world-x fallback)
    var w2 = constraints3d.constraints3dVec(0.0 - uW.y, uW.x, 0.0)
    let m2 = numerics.CsgSqrt(w2.x * w2.x + w2.y * w2.y + w2.z * w2.z)
    if m2 < 0.001:
        w2 = constraints3d.constraints3dVec(1.0, 0.0, 0.0)
    else:
        w2 = constraints3d.constraints3dVec(w2.x / m2, w2.y / m2, w2.z / m2)
    # second perpendicular axis: uW x w2
    var w3 = constraints3d.constraints3dVec(uW.y * w2.z - uW.z * w2.y, uW.z * w2.x - uW.x * w2.z, uW.x * w2.y - uW.y * w2.x)
    # world -> body local: conjugate quaternion rotation per body
    let aqw = w.bodyQuatW[aSlot]
    let aqx = 0.0 - w.bodyQuatX[aSlot]
    let aqy = 0.0 - w.bodyQuatY[aSlot]
    let aqz = 0.0 - w.bodyQuatZ[aSlot]
    let bqwav = w.bodyQuatW[bSlot]
    let bqxb = 0.0 - w.bodyQuatX[bSlot]
    let bqyb = 0.0 - w.bodyQuatY[bSlot]
    let bqzb = 0.0 - w.bodyQuatZ[bSlot]
    var v2 = constraints3d.constraints3dQuatRot(aqw, aqx, aqy, aqz, w2)
    let l2Ax = v2.x
    let l2Ay = v2.y
    let l2Az = v2.z
    v2 = constraints3d.constraints3dQuatRot(bqwav, bqxb, bqyb, bqzb, w2)
    let l2Bx = v2.x
    let l2By = v2.y
    let l2Bz = v2.z
    var v3 = constraints3d.constraints3dQuatRot(aqw, aqx, aqy, aqz, w3)
    let l3Ax = v3.x
    let l3Ay = v3.y
    let l3Az = v3.z
    v3 = constraints3d.constraints3dQuatRot(bqwav, bqxb, bqyb, bqzb, w3)
    let l3Bx = v3.x
    let l3By = v3.y
    let l3Bz = v3.z
    # ref for each weld hinge = the OTHER perpendicular axis (mapped
    # per body); SetHingeRefs Gram-Schmidts and rejects parallel refs
    var vrA = constraints3d.constraints3dQuatRot(aqw, aqx, aqy, aqz, w3)
    var vrB = constraints3d.constraints3dQuatRot(bqwav, bqxb, bqyb, bqzb, w3)
    let ci2 = world3d.World3dAddHingeJoint(w, aSlot, bSlot, world3d.World3dConHingeServo, w.conAnchAx[baseCi], w.conAnchAy[baseCi], w.conAnchAz[baseCi], w.conAnchBx[baseCi], w.conAnchBy[baseCi], w.conAnchBz[baseCi], l2Ax, l2Ay, l2Az, l2Bx, l2By, l2Bz)
    world3d.World3dSetHingeRefs(w, ci2, vrA.x, vrA.y, vrA.z, vrB.x, vrB.y, vrB.z)
    world3d.World3dSetHingeServo(w, ci2, tau, omegaRadS, 0.0, 0.0)
    let _pk2 = DuckParkHingeServo(w, ci2)
    vrA = constraints3d.constraints3dQuatRot(aqw, aqx, aqy, aqz, w2)
    vrB = constraints3d.constraints3dQuatRot(bqwav, bqxb, bqyb, bqzb, w2)
    let ci3 = world3d.World3dAddHingeJoint(w, aSlot, bSlot, world3d.World3dConHingeServo, w.conAnchAx[baseCi], w.conAnchAy[baseCi], w.conAnchAz[baseCi], w.conAnchBx[baseCi], w.conAnchBy[baseCi], w.conAnchBz[baseCi], l3Ax, l3Ay, l3Az, l3Bx, l3By, l3Bz)
    world3d.World3dSetHingeRefs(w, ci3, vrA.x, vrA.y, vrA.z, vrB.x, vrB.y, vrB.z)
    world3d.World3dSetHingeServo(w, ci3, tau, omegaRadS, 0.0, 0.0)
    let _pk3 = DuckParkHingeServo(w, ci3)

# One sole pad: a small zero-half-length capsule body (contact behaves
# as a sphere) at the toe/heel of the foot, riding the foot's spawn
# quaternion, welded to the foot body with three orthogonal servo
# hinges. Four pads across both feet turn the capsule line contact
# into a true sole PLATE: pitch/roll restoring couples the round foot
# structurally lacks (the round foot's pitch drift had no in-geometry
# restoring torque — the last standing wall). Pad bottom lands exactly
# on the floor plane the foot capsule bottom already touches, so both
# contacts coexist and the weight splits.
fn DuckSpawnSolePad(w: var World3d,
                    footSlot: int32,
                    offY: float64,
                    tau: float64,
                    omegaRadS: float64): int32 =
    let fq = w.bodyQuatW[footSlot]
    let fx = w.bodyQuatX[footSlot]
    let fy = w.bodyQuatY[footSlot]
    let fz = w.bodyQuatZ[footSlot]
    # toe/heel offset: the foot spawns with the Forward-axis quat
    # (capsule +Z -> world +Y), so the world +-Y (forward) direction is
    # the foot's LOCAL +Z; the local Y axis rotates to world -Z (down),
    # so a local-Y offset buried both pads under the floor instead of
    # straddling the sole fore/aft. r=4 mm: the 8733120a5 pad stable
    # domain (k=500, T=4 mm) at 6.3 g per pad.
    let rot = constraints3d.constraints3dQuatRot(fq, fx, fy, fz, constraints3d.constraints3dVec(0.0, 0.0, offY))
    let px = w.bodyPx[footSlot] + rot.x
    let py = w.bodyPy[footSlot] + rot.y
    let pz = w.bodyPz[footSlot] + rot.z - (w.bodyRadius[footSlot] - 0.004)
    let padSlot = world3d.World3dSpawnCapsule(w, px, py, pz, 0.0063, 0.004, 0.0, fq, fx, fy, fz)
    # pad rides the foot's quaternion: matching frames make the weld
    # hinge local-parallel check pass and the sphere orientation is
    # contact-irrelevant
    w.bodyQuatW[padSlot] = fq
    w.bodyQuatX[padSlot] = fx
    w.bodyQuatY[padSlot] = fy
    w.bodyQuatZ[padSlot] = fz
    # base weld hinge: world x axis (mapped to the shared local frame)
    let cqw = fq
    let cqx = 0.0 - fx
    let cqy = 0.0 - fy
    let cqz = 0.0 - fz
    let axL = constraints3d.constraints3dQuatRot(cqw, cqx, cqy, cqz, constraints3d.constraints3dVec(1.0, 0.0, 0.0))
    let ayL = constraints3d.constraints3dQuatRot(cqw, cqx, cqy, cqz, constraints3d.constraints3dVec(0.0, 1.0, 0.0))
    let azL = constraints3d.constraints3dQuatRot(cqw, cqx, cqy, cqz, constraints3d.constraints3dVec(0.0, 0.0, 1.0))
    # foot-local anchor of the pad center: the world offset (rotated
    # y-offset plus the drop) conjugate-rotated into the foot frame
    let anchA = constraints3d.constraints3dQuatRot(cqw, cqx, cqy, cqz, constraints3d.constraints3dVec(rot.x, rot.y, rot.z - (w.bodyRadius[footSlot] - 0.004)))
    let baseCi = world3d.World3dAddHingeJoint(w, footSlot, padSlot, world3d.World3dConHingeServo, anchA.x, anchA.y, anchA.z, 0.0, 0.0, 0.0, axL.x, axL.y, axL.z, axL.x, axL.y, axL.z)
    world3d.World3dSetHingeRefs(w, baseCi, ayL.x, ayL.y, ayL.z, ayL.x, ayL.y, ayL.z)
    world3d.World3dSetHingeServo(w, baseCi, tau, omegaRadS, 0.0, 0.0)
    let _p1 = DuckParkHingeServo(w, baseCi)
    let ci2 = world3d.World3dAddHingeJoint(w, footSlot, padSlot, world3d.World3dConHingeServo, anchA.x, anchA.y, anchA.z, 0.0, 0.0, 0.0, ayL.x, ayL.y, ayL.z, ayL.x, ayL.y, ayL.z)
    world3d.World3dSetHingeRefs(w, ci2, axL.x, axL.y, axL.z, axL.x, axL.y, axL.z)
    world3d.World3dSetHingeServo(w, ci2, tau, omegaRadS, 0.0, 0.0)
    let _p2 = DuckParkHingeServo(w, ci2)
    let ci3 = world3d.World3dAddHingeJoint(w, footSlot, padSlot, world3d.World3dConHingeServo, anchA.x, anchA.y, anchA.z, 0.0, 0.0, 0.0, azL.x, azL.y, azL.z, azL.x, azL.y, azL.z)
    world3d.World3dSetHingeRefs(w, ci3, axL.x, axL.y, axL.z, axL.x, axL.y, axL.z)
    world3d.World3dSetHingeServo(w, ci3, tau, omegaRadS, 0.0, 0.0)
    let _p3 = DuckParkHingeServo(w, ci3)
    return padSlot

# Full episode assembly, world reset in place: the microduck_assembly_
# probe stance assembly at root (rootX, rootY, rootZ) yaw 0 + the real
# size-7 ball resting on the ground plane below it. The 13 link
# capsules spawn at the balanced stance (root lifted by
# MicroduckStanceRootZLift so the soles land exactly on the ball top),
# all 12 joints become hinge servos from the model table (probe
# verbatim), every servo parks at its measured stance angle, and every
# creation invariant is validated here (anchor gaps < 1 mm, stance th0
# exact, exact slot/count layout) — any miss is a pose-math bug and
# crashes loudly.
fn DuckAssemble(w: var World3d, rootX: float64, rootY: float64, rootZ: float64): int32 =
    world3d.World3dReset(w, int64(911))
    # the FULL 15-link/14-joint MJCF model: the hip roll DoF is real
    # (the 13-link assembly had dropped it, leaving the roll balance
    # driving hip YAW — a semantic mismatch measured as zero balance
    # authority)
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if mdl.links.len != 15:
        panic("duckmode: assembly link count")
    if mdl.joints.len != 14:
        panic("duckmode: assembly joint count")
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > 0.000000001:
        panic("duckmode: assembly total mass off the MJCF sum")
    # 13 link capsules at the balanced stance (soles on the ball top).
    let spawnZ = rootZ + mm.MicroduckStanceRootZLift
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, rootX, rootY, spawnZ, 0.0)
        let slot = world3d.World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("duckmode: link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    # ankle burst rate: 4x the base servo rate — the lateral fold
    # lives in ankle-yield accumulating at the rate cap (60 deg/s
    # lets a 4 deg yield walk in over 16 ticks); a faster ankle
    # closes each yield before it loads the next joint

    let tauHip = mm.MicroduckTauMaxHipNm
    let tauKnee = mm.MicroduckTauMaxKneeNm
    let tauAnkle = mm.MicroduckTauMaxAnkleNm
    let tauNeck = mm.MicroduckTauMaxNeckNm
    # 12 hinge servos, one per assembly joint (probe verbatim flexion
    # references: lateral yaw joints reference forward (0,1,0);
    # pitch/knee/ankle reference down (0,0,-1); the neck chain
    # references up (0,0,1) so every measured angle reads the MJCF
    # convention).
    let ciHipRollL = DuckStanceHinge(w, mdl, mm.MicroduckJointHipRollL, 1.0, 0.0, 0.0, tauHip, omegaRadS)
    let ciHipYawL = DuckStanceHinge(w, mdl, mm.MicroduckJointHipYawL, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipPitchL = DuckStanceHinge(w, mdl, mm.MicroduckJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeL = DuckStanceHinge(w, mdl, mm.MicroduckJointKneeL, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleL = DuckStanceHinge(w, mdl, mm.MicroduckJointAnklePitchL, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciHipRollR = DuckStanceHinge(w, mdl, mm.MicroduckJointHipRollR, 1.0, 0.0, 0.0, tauHip, omegaRadS)
    let ciHipYawR = DuckStanceHinge(w, mdl, mm.MicroduckJointHipYawR, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipPitchR = DuckStanceHinge(w, mdl, mm.MicroduckJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeR = DuckStanceHinge(w, mdl, mm.MicroduckJointKneeR, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleR = DuckStanceHinge(w, mdl, mm.MicroduckJointAnklePitchR, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciNeck = DuckStanceHinge(w, mdl, mm.MicroduckJointNeckPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadPitch = DuckStanceHinge(w, mdl, mm.MicroduckJointHeadPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadYaw = DuckStanceHinge(w, mdl, mm.MicroduckJointHeadYaw, 0.0, 1.0, 0.0, tauNeck, omegaRadS)
    let ciHeadRoll = DuckStanceHinge(w, mdl, mm.MicroduckJointHeadRoll, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    # create-time pose validation: every hinge pivot landed on one point
    # (checked at creation); the measured stance angles must equal the
    # exact stance FK (hip pitch +-0.43 rad, ankle the mirrored sign,
    # knees, hip yaws and the neck chain neutral). All 12 servos park at
    # their measured angle, so tick 0 commands no step change.
    let th = mm.MicroduckStanceHipRad
    let thHipYawL = DuckParkHingeServo(w, ciHipYawL)
    let thHipL = DuckParkHingeServo(w, ciHipPitchL)
    let thKneeL = DuckParkHingeServo(w, ciKneeL)
    let thAnkleL = DuckParkHingeServo(w, ciAnkleL)
    let thHipYawR = DuckParkHingeServo(w, ciHipYawR)
    let thHipR = DuckParkHingeServo(w, ciHipPitchR)
    let thKneeR = DuckParkHingeServo(w, ciKneeR)
    let thAnkleR = DuckParkHingeServo(w, ciAnkleR)
    let thNeck = DuckParkHingeServo(w, ciNeck)
    duckCiHipL = ciHipPitchL
    duckCiHipR = ciHipPitchR
    duckCiKneeL = ciKneeL
    duckCiKneeR = ciKneeR
    duckCiAnkleL = ciAnkleL
    duckCiAnkleR = ciAnkleR
    # yoke semantic fix: the roll balance must drive the TRUE hip roll
    # DoF (the 15-link model's hip roll hinges), not the yaw
    duckCiYokeL = ciHipRollL
    duckCiYokeR = ciHipRollR
    let thHeadPitch = DuckParkHingeServo(w, ciHeadPitch)
    let thHeadYaw = DuckParkHingeServo(w, ciHeadYaw)
    let thHeadRoll = DuckParkHingeServo(w, ciHeadRoll)
    if duckHeadWeld:
        DuckWeldTwoAxis(w, ciNeck, tauNeck, omegaRadS)
        DuckWeldTwoAxis(w, ciHeadPitch, tauNeck, omegaRadS)
        DuckWeldTwoAxis(w, ciHeadYaw, tauNeck, omegaRadS)
        DuckWeldTwoAxis(w, ciHeadRoll, tauNeck, omegaRadS)

    if duckHeadFree:
        # isolation experiment: FREEZE the head chain as static
        # decoration (invMass/inertia zeroed, constraints off) — its 4
        # compromised local-axis hinges cycle infeasibly under the
        # exact block solve (measured: the head-pitch anchor gap
        # oscillates 9->2->9 mm sweep over sweep, throwing the
        # 172.6 g head around and launching the stance). A frozen head
        # answers whether the TORSO stance stands on its own.
        w.conActive[ciNeck] = 0
        w.conActive[ciHeadPitch] = 0
        w.conActive[ciHeadYaw] = 0
        w.conActive[ciHeadRoll] = 0
        # assembly link slots: neck=9, headPitchCarrier=10,
        # headYawCarrier=11, head=12 (the assembly has no hip roll
        # carriers and no full-model index aliases)
        var hbs: int32 = 9
        while hbs <= 12:
            w.bodyInvMass[hbs] = 0.0
            w.bodyIxx[hbs] = 0.0
            w.bodyIzz[hbs] = 0.0
            hbs = hbs + 1
    # knee preload (ground stance): park the servo GOAL at +4 deg
    # flexion so the gravity load pushes the knee into its passive
    # limit band instead of hunting around the straight-pose zero —
    # the straight-knee hunt was the standing limit cycle (knee
    # +-1.5 deg at ~2 Hz, feet creeping up 1 mm per 10 ticks until
    # launch). The limit rows are one-sided: load-locked, no pump.
    w.conGoal[ciKneeL] = thKneeL + 0.06981317007977318
    w.conGoal[ciKneeR] = thKneeR + 0.06981317007977318
    # ankle counter-half: the fixed -2 deg keeps the sole nearest flat
    # with the +4 deg knee preload (measured pole tilt: -2 deg -> 12 mm
    # pole-2 up / 320 ticks; full knee tracking (-4 deg) flipped the
    # tilt to 15 mm pole-1 up / 286 ticks — the flat point sits between
    # and the residual tilt is part of the tap-escape wall, not the
    # whole of it)
    # ankle flat-point trim (DUCK_ANKLE_EXTRA_M, milli-deg): the sole
    # flat point sits between -2 and -4 deg of knee-preload counter —
    # sweep it against the pad (the residual tilt feeds the tap escape)
    var ankleExtra: float64 = 0.0
    if duckAnkleExtraM != 0:
        ankleExtra = float64(duckAnkleExtraM) / 1000.0 * 0.017453292519943295
    w.conGoal[ciAnkleL] = thAnkleL - 0.03490658503988659 - ankleExtra
    w.conGoal[ciAnkleR] = thAnkleR - 0.03490658503988659 - ankleExtra
    if numerics.CsgAbs(thHipL - th) > DuckAngleNeutralTolRad:
        panic("duckmode: hip pitch L th0 off the stance")
    if numerics.CsgAbs(thHipR + th) > DuckAngleNeutralTolRad:
        panic("duckmode: hip pitch R th0 off the stance")
    if numerics.CsgAbs(thAnkleL + th) > DuckAngleNeutralTolRad:
        panic("duckmode: ankle L th0 off the stance")
    if numerics.CsgAbs(thAnkleR - th) > DuckAngleNeutralTolRad:
        panic("duckmode: ankle R th0 off the stance")
    if numerics.CsgAbs(thHipYawL) > DuckAngleNeutralTolRad:
        panic("duckmode: hip yaw L th0 not neutral")
    if numerics.CsgAbs(thHipYawR) > DuckAngleNeutralTolRad:
        panic("duckmode: hip yaw R th0 not neutral")
    if numerics.CsgAbs(thKneeL) > DuckAngleNeutralTolRad:
        panic("duckmode: knee L th0 not neutral")
    if numerics.CsgAbs(thKneeR) > DuckAngleNeutralTolRad:
        panic("duckmode: knee R th0 not neutral")
    if numerics.CsgAbs(thNeck) > DuckAngleNeutralTolRad:
        panic("duckmode: neck th0 not neutral")
    if numerics.CsgAbs(thHeadPitch) > DuckAngleNeutralTolRad:
        panic("duckmode: head pitch th0 not neutral")
    if numerics.CsgAbs(thHeadYaw) > DuckAngleNeutralTolRad:
        panic("duckmode: head yaw th0 not neutral")
    if numerics.CsgAbs(thHeadRoll) > DuckAngleNeutralTolRad:
        panic("duckmode: head roll th0 not neutral")
    # the ball: the probe injection window — after the full assembly,
    # before the first physics step
    if w.count != DuckBodyTotal - 1:
        panic("duckmode: duck body count")
    let ballSlot = world3d.World3dSpawnBody(w, DuckBallCenterX, DuckBallCenterY, DuckBallCenterZ, DuckBallMassKg, DuckBallRadiusM, world3d.World3dBodyBallRigid)
    if ballSlot != DuckBallSlot:
        panic("duckmode: ball slot mismatch")
    if w.count != DuckBodyTotal:
        panic("duckmode: total body count")
    # 14 assembly hinges (yaw+roll+pitch+knee+ankle x2 + 4 head); the
    # head-weld mode adds 2 perpendicular servo hinges per head-chain
    # junction (4 junctions = +8); the sole-plate mode adds 3 weld
    # hinges per pad (2 pads x 2 feet = +12)
    var conExpect: int32 = 14
    if duckHeadWeld:
        conExpect = conExpect + 8
    if w.conCount != conExpect:
        panic("duckmode: constraint count")
    return ballSlot

# Duck-mode camera presets, framed on the ball-top scene at (0, 0.85)
# (ball top 0.242 m, stance head shell top ~0.50 m).
fn DuckCameraFor(camN: int32): camera.CinemaCamera =
    if camN == 1:
        return camera.CinemaCameraLookAt(-1.6, 2.0, 0.9, 0.0, 0.85, 0.38, 950.0, PlayerWidth, PlayerHeight)
    elif camN == 2:
        return camera.CinemaCameraLookAt(1.5, 1.8, 0.8, 0.0, 0.85, 0.36, 1150.0, PlayerWidth, PlayerHeight)
    return camera.CinemaCameraLookAt(-1.0, 2.3, 1.7, 0.0, 0.85, 0.34, 850.0, PlayerWidth, PlayerHeight)

# mesh handle table for the duckmode STL path, loaded once in RunDuck
# before the first episode (mesh_render keeps its own module SoA store;
# the handles are plain int32 indices). A failed load (handle < 0)
# leaves duckMeshOk false and DrawDuckBodies falls back to the
# multi-sphere impostor pass (reported at startup as data).
var duckMeshHandles: int32[]
var duckMeshOk: bool
# ground locomotion spawn toggle (G key): survives episode restarts
var duckGroundSpawn: bool = false
# leg hinge constraint indices (written by DuckAssemble, read by the
# gait oscillator; -1 until the first assembly)
var duckCiHipL: int32 = 0 - 1
var duckResidEcho: bool = false
var duckHeadFree: bool = false
var duckHeadWeld: bool = false
var duckFootPlate: bool = false
var duckAnkleExtraM: int32 = 0
# standing balance gains (env-tunable): roll yoke gain/clamp, torso PD
var duckRollGainM: int32 = 1200
var duckRollClampM: int32 = 200
var duckPdPM: int32 = 3000
var duckPdDM: int32 = 300
# full balance loop (DUCK_BAL_FULL): delta-goal pitch+roll feedback
var duckBalFull: bool = false
var duckBalArmed: bool = false
var duckBalBaseAnkleLm: int32 = 0
var duckBalBaseAnkleRm: int32 = 0
var duckBalBaseHipLm: int32 = 0
var duckBalBaseHipRm: int32 = 0
var duckBalBaseYokeLm: int32 = 0
var duckBalBaseYokeRm: int32 = 0
var duckBalLastPitchM: int32 = 0
var duckBalLastRollM: int32 = 0
var duckBalKAM: int32 = 2200
var duckBalKDM: int32 = 100
var duckRollAnkleM: int32 = 0
# DUCK_YOKE_TRUE_ROLL: 0 (default) keeps the legacy yoke +-write
# semantics; 1 turns the roll loop into a pure lateral loop (yoke
# writes dropped, ankle wedge on). The wedge authority comes from
# DUCK_ROLL_ANKLE_M if set, else DuckRollWedgeDefaultM (sign
# calibrated by the ground A/B: the ankle axes are mirrored, so
# opposite deltas = same world toe pitch; the sign that walks the
# sole contact back under a +y lean wins).
var duckYokeTrueRollS: int32 = 0
var DuckRollWedgeDefaultM: int32 = 0 - 250
# roll balance loop divisor (DUCK_ROLL_DIV): RollTick fires every N
# ticks; 24 = the original 10 Hz
var duckRollDivN: int32 = 24
var duckCiHipR: int32 = 0 - 1
var duckCiKneeL: int32 = 0 - 1
var duckCiKneeR: int32 = 0 - 1
var duckCiAnkleL: int32 = 0 - 1
var duckCiAnkleR: int32 = 0 - 1
var duckCiYokeL: int32 = 0 - 1
var duckCiYokeR: int32 = 0 - 1
# env latch: the gait starts at episode build (deterministic runs)
var duckWalkLatch: bool = false
# gait parameter slots (CEM-tunable per sample); int32 milli-units
var gaitFreqHzM: int32 = 1600
var gaitHipAmpM: int32 = 100
var gaitKneeSwingM: int32 = 220
var gaitAnkleAmpM: int32 = 180
var gaitKneeLeadM: int32 = 550
var gaitRollGainM: int32 = 900
var gaitAnkPhaseM: int32 = 0
var gaitDblSupM: int32 = 150
var gaitSwayAmpM: int32 = 60

fn GaitEnvOverride(name: str, cur: int32): int32 =
    let v: str = os.GetEnvDefault(name, "")
    if v.len > 0:
        let n: int32 = ParseDigits(v)
        if n > 0:
            return n
    return cur
# DUCK_BALANCE=0 disables the standing feedback (isolation switch)
var duckBalanceOn: bool = true

# -- docked mesh instance table: the DrawDuckBodies dock mapping as
#    data, shared by the GPU batch composite and the CPU fallback
#    (26 instances; the handle column indexes duckMeshHandles) --
const DuckMeshInstCount: int32 = 26
var duckInstHandle: int32[]
var duckInstLink: int32[]
var duckInstCx: float64[]
var duckInstCy: float64[]
var duckInstCz: float64[]
var duckInstTheta: float64[]
var duckInstR: int32[]
var duckInstG: int32[]
var duckInstB: int32[]
# per-frame world poses computed by DuckMeshInstancesBuild
var duckInstPx: float64[]
var duckInstPy: float64[]
var duckInstPz: float64[]
var duckInstQw: float64[]
var duckInstQx: float64[]
var duckInstQy: float64[]
var duckInstQz: float64[]
# per-frame frustum visibility (1 visible / 0 hidden), from
# DuckMeshInstancesMarkHidden
var duckInstHidden: int32[]

# Rotate one point by the unit quaternion (Hamilton rotation): docks
# the urdf mesh-pivot offsets (body frame) into world space.
fn DuckQuatRotatePoint(qw: float64,
                       qx: float64,
                       qy: float64,
                       qz: float64,
                       vx: float64,
                       vy: float64,
                       vz: float64,
                       outX: var float64,
                       outY: var float64,
                       outZ: var float64) =
    let tx = 2.0 * (qy * vz - qz * vy)
    let ty = 2.0 * (qz * vx - qx * vz)
    let tz = 2.0 * (qx * vy - qy * vx)
    outX = vx + qw * tx + (qy * tz - qz * ty)
    outY = vy + qw * ty + (qz * tx - qx * tz)
    outZ = vz + qw * tz + (qx * ty - qy * tx)

# Advance the ball's render-layer visual attitude by one step: dq =
# normalize(1, omega*dt/2) from the world-frame angular velocity, vq =
# dq (x) vq (world-frame left multiply, inlined Hamilton product),
# renormalized. Pure visual state — the ball's physical attitude columns
# stay untouched (the seam pattern only rides this quaternion through
# RasterBasketball).
fn DuckBallVisualQuatStep(vqw: var float64,
                          vqx: var float64,
                          vqy: var float64,
                          vqz: var float64,
                          avx: float64,
                          avy: float64,
                          avz: float64,
                          dt: float64) =
    let half: float64 = dt * 0.5
    var dw: float64 = 1.0
    var dx: float64 = avx * half
    var dy: float64 = avy * half
    var dz: float64 = avz * half
    let dn: float64 = numerics.CsgSqrt(dw * dw + dx * dx + dy * dy + dz * dz)
    dw = dw / dn
    dx = dx / dn
    dy = dy / dn
    dz = dz / dn
    let rw: float64 = dw * vqw - dx * vqx - dy * vqy - dz * vqz
    let rx: float64 = dw * vqx + dx * vqw + dy * vqz - dz * vqy
    let ry: float64 = dw * vqy - dx * vqz + dy * vqw + dz * vqx
    let rz: float64 = dw * vqz + dx * vqy - dy * vqx + dz * vqw
    let nn: float64 = numerics.CsgSqrt(rw * rw + rx * rx + ry * ry + rz * rz)
    vqw = rw / nn
    vqx = rx / nn
    vqy = ry / nn
    vqz = rz / nn

# Dark capsule impostor for the meshless links (both shins + the neck
# chain: no shipped mesh): spheres spaced <= 0.6r along the live body
# quaternion axis, the official dark servo-stack color.
@borrows
fn DuckDrawLinkImpostor(t: raster.RasterTarget,
                        cam: camera.CinemaCamera,
                        px: float64,
                        py: float64,
                        pz: float64,
                        qw: float64,
                        qx: float64,
                        qy: float64,
                        qz: float64,
                        r: float64,
                        h: float64) =
    let ax = 2.0 * (qx * qz + qw * qy)
    let ay = 2.0 * (qy * qz - qw * qx)
    let az = 1.0 - 2.0 * (qx * qx + qy * qy)
    let step: float64 = r * 0.6
    let nSteps: int32 = int32(h / step) + 1
    var k: int32 = 0 - nSteps
    while k <= nSteps:
        let t2: float64 = float64(k) * step
        if t2 <= h:
            raster.RasterSphere(t, cam, px - ax * t2, py - ay * t2, pz - az * t2, r, DuckColorMotorR, DuckColorMotorG, DuckColorMotorB)
        k = k + 1

# One-time: lay the 11 dock instances out in the DrawDuckBodies dock
# order (torso, yoke L/R, thigh L/R, foot L x2, foot R x2, head x2)
# with the same cvec (mm, mesh frame) / Rz dock angle / urdf palette.
fn DuckMeshInstTableInit() =
    let piRad: float64 = m.Pi
    setLen(duckInstHandle, DuckMeshInstCount)
    setLen(duckInstLink, DuckMeshInstCount)
    setLen(duckInstCx, DuckMeshInstCount)
    setLen(duckInstCy, DuckMeshInstCount)
    setLen(duckInstCz, DuckMeshInstCount)
    setLen(duckInstTheta, DuckMeshInstCount)
    setLen(duckInstR, DuckMeshInstCount)
    setLen(duckInstG, DuckMeshInstCount)
    setLen(duckInstB, DuckMeshInstCount)
    setLen(duckInstPx, DuckMeshInstCount)
    setLen(duckInstPy, DuckMeshInstCount)
    setLen(duckInstPz, DuckMeshInstCount)
    setLen(duckInstQw, DuckMeshInstCount)
    setLen(duckInstQx, DuckMeshInstCount)
    setLen(duckInstQy, DuckMeshInstCount)
    setLen(duckInstQz, DuckMeshInstCount)
    setLen(duckInstHidden, DuckMeshInstCount)
    # 0: trunk_base -> torso
    duckInstHandle[0] = DuckMeshIdxTrunk
    duckInstLink[0] = mm.MicroduckLinkTorso
    duckInstCx[0] = 0.0
    duckInstCy[0] = 22.419
    duckInstCz[0] = 0.0 - 19.875
    duckInstTheta[0] = piRad
    duckInstR[0] = DuckColorCreamR
    duckInstG[0] = DuckColorCreamG
    duckInstB[0] = DuckColorCreamB
    # 1/2: bearing_roll -> hip yokes (official asymmetry)
    duckInstHandle[1] = DuckMeshIdxBearing
    duckInstLink[1] = DuckLinkYokeL
