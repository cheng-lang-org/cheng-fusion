type
    DiamondObj126 =
        a: int32
        b: int32

fn pick(o: DiamondObj126, y: int32, output: var int64): bool =
    output = int64(o.a + o.b + y)
    return true

fn pick(o: DiamondObj126, y: int32, output: var str): bool =
    output = "x"
    return true

fn pick(o: DiamondObj126, y: int32, output: var Bytes): bool =
    return true

fn initObj(): DiamondObj126 =
    DiamondObj126(a: 5, b: 1)
