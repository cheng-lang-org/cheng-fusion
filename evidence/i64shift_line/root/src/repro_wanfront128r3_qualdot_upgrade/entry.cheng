import src/repro_wanfront128r3_qualdot_upgrade/lib as libAlias

fn addPenalty(base: float64, step: float64): float64 =
    return base - step

fn isBelowFloor(v: float64): bool =
    return v <= libAlias.floorThreshold

fn main(): int32 =
    # qualified name as call argument
    var callArgResult: float64 = addPenalty(0.0, libAlias.penaltyStep)
    if callArgResult != -2.5:
        echo("FAIL call-arg qualified const wrong")
        return 1

    # qualified name as comparison operand
    if !isBelowFloor(-20.0):
        echo("FAIL comparison operand qualified const wrong (should be below floor)")
        return 1
    if isBelowFloor(0.0):
        echo("FAIL comparison operand qualified const wrong (should NOT be below floor)")
        return 1

    # qualified name as decl RHS
    let declRhs: float64 = libAlias.floorThreshold
    if declRhs != -10.0:
        echo("FAIL decl RHS qualified const wrong")
        return 1

    echo("qualdot upgrade ok")
    return 0
