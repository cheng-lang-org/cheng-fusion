type S1 = str
type S2 = S1
type S3 = S2
type S4 = S3
type S5 = S4
type S6 = S5
type S7 = S6
type S8 = S7
type S9 = S8
type S10 = S9

fn makeGreetingDeep(v: int32): S10 =
    return "deepchain"

fn bumpDeep(v: int32): S10 =
    makeGreetingDeep(v)

fn main(): int32 =
    var r: S10 = bumpDeep(5)
    echo(Fmt"r={r}")
    return 0
