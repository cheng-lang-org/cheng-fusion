import std/result

fn makeBoolResultDeep(v: int32): Result[bool] =
    if v < 0:
        return Err[bool]("neg")
    return Ok[bool](true)

type L1 = Result[bool]
type L2 = L1
type L3 = L2
type L4 = L3
type L5 = L4
type L6 = L5
type L7 = L6
type L8 = L7
type L9 = L8
type L10 = L9

fn bumpDeepObj(v: int32): L10 =
    makeBoolResultDeep(v)

fn main(): int32 =
    var r: L10 = bumpDeepObj(5)
    echo(Fmt"deepobj ok={Value(r)}")
    return 0
