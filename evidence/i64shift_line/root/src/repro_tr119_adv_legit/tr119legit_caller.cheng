import std/result
import repro_tr119_adv_legit/tr119legit_lib

fn bumpBoxMulti(b: var Box, v: int32): Result[bool] =
    echo("about to bump")
    var extra: int32 = v + 1
    echo(Fmt"extra={extra}")
    addOne(b, v)

fn main(): int32 =
    var box: Box
    box.n = 10
    var r: Result[bool] = bumpBoxMulti(box, 5)
    if IsErr(r):
        echo("unexpected err")
        return 1
    if !Value(r):
        echo("unexpected ok=false")
        return 1
    if box.n != 15:
        echo(Fmt"unexpected n={box.n} want=15")
        return 1
    echo(Fmt"multi-stmt legit tail-call: n={box.n} ok={Value(r)}")
    return 0
