# Debug helpers(minimal).

import cheng/libp2p/peerstore
import cheng/libp2p/connmanager
fn dumpPeerStore(store: PeerStore): str =
    peerStoreDump(store)

fn dumpPeerStoreSorted(store: PeerStore): str =
    peerStoreDumpSorted(store)

fn dumpPeerStoreLimit(store: PeerStore, limit: int32): str =
    peerStoreDumpLimit(store, limit)

fn dumpPeerStoreSortedLimit(store: PeerStore, limit: int32): str =
    peerStoreDumpSortedLimit(store, limit)

fn dumpPeerStoreOffset(store: PeerStore, offset: int32, limit: int32): str =
    peerStoreDumpOffset(store, offset, limit)

