fn listText(listRes: Result[StringList]): Result[str] =
    if IsErr(listRes):
        return Err[str](Error(listRes))
    return Ok[str](StringListToLines(Value(listRes)))

fn listPeerIdsText(store: PeerStore): Result[str] =
    return listText(listPeerIds(store))

fn listPeerIdsSortedText(store: PeerStore): Result[str] =
    return listText(listPeerIdsSorted(store))

fn listPeerIdsByProtocolText(store: PeerStore, proto: str): Result[str] =
    return listText(listPeerIdsByProtocol(store, proto))

fn listPeerIdsByProtocolSortedText(store: PeerStore, proto: str): Result[str] =
    return listText(listPeerIdsByProtocolSorted(store, proto))

