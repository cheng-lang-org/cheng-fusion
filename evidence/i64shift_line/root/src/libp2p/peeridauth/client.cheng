# Peer ID auth client(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/stringlist
import cheng/libp2p/peerid
type
    PeerIdAuthConfig =
        enabled: bool
        requireAllowlist: bool

    PeerIdAuthClient =
        config: PeerIdAuthConfig
        allowlist: StringList

fn initPeerIdAuthConfig(): PeerIdAuthConfig =
    PeerIdAuthConfig(enabled: true, requireAllowlist: true)

fn initPeerIdAuthClient(): PeerIdAuthClient =
    PeerIdAuthClient(config: initPeerIdAuthConfig(), allowlist: InitStringList())

fn setPeerIdAuthConfig(client: var PeerIdAuthClient, config: PeerIdAuthConfig) =
    client.config = config

fn peerIdAuthAdd(client: var PeerIdAuthClient, peerText: str): Result[bool] =
    if len(peerText) <= 0:
        return Err[bool]("peeridauth: empty peer")
    let pidRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    return StringListAdd(client.allowlist, toString(Value(pidRes)))

fn peerIdAuthAllowed(client: PeerIdAuthClient, peerText: str): bool =
    return StringListContains(client.allowlist, peerText)

fn peerIdAuthCheck(client: PeerIdAuthClient, peerText: str): Result[bool] =
    if ! client.config.enabled:
        return Ok[bool](true)
    if len(peerText) <= 0:
        return Err[bool]("peeridauth: empty peer")
    let pidRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    if client.allowlist.count <= 0 && client.config.requireAllowlist:
        return Err[bool]("peeridauth: allowlist empty")
    let ok: bool = StringListContains(client.allowlist, toString(Value(pidRes)))
    return Ok[bool](ok)
