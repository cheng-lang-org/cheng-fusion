# Peer ID auth mock client(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
type
    PeerIdAuthMock =
        allowAll: bool
        lastPeer: str

fn initPeerIdAuthMock(): PeerIdAuthMock =
    PeerIdAuthMock(allowAll: true, lastPeer: "")

fn peerIdAuthMockCheck(mock: var PeerIdAuthMock, peerText: str): Result[bool] =
    if len(peerText) <= 0:
        return Err[bool]("peeridauth: empty peer")
    mock.lastPeer = peerText
    return Ok[bool](mock.allowAll)

fn peerIdAuthMockLastPeer(mock: PeerIdAuthMock): str =
    return mock.lastPeer
