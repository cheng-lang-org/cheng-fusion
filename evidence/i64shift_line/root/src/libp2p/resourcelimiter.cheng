# Overlay resource limiter(peer/protocol/subnet).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings

const
    maxOverlayCounterKeys = 256
    maxOverlayPeerConnKeys = maxOverlayCounterKeys
    maxOverlaySubnetConnKeys = maxOverlayCounterKeys
    maxOverlayPeerStreamKeys = maxOverlayCounterKeys
    maxOverlayProtocolStreamKeys = maxOverlayCounterKeys

type
    OverlayLimits =
        enabled: bool
        maxConnPerPeer: int32
        maxConnPerSubnet: int32
        maxStreamsPerPeer: int32
        maxStreamsPerProtocol: int32

    OverlayCounterEntry =
        key: str
        count: int32

    OverlayState =
        limits: OverlayLimits
        peerConnCount: int32
        peerConn: OverlayCounterEntry[maxOverlayCounterKeys]
        subnetConnCount: int32
        subnetConn: OverlayCounterEntry[maxOverlayCounterKeys]
        peerStreamCount: int32
        peerStream: OverlayCounterEntry[maxOverlayCounterKeys]
        protocolStreamCount: int32
        protocolStream: OverlayCounterEntry[maxOverlayCounterKeys]
        lastError: str

    OverlayCounterMutation =
        ok: bool
        changed: bool
        error: str
        count: int32
        entries: OverlayCounterEntry[maxOverlayCounterKeys]

fn initOverlayLimits(): OverlayLimits =
    OverlayLimits(
        enabled: false,
        maxConnPerPeer: 0,
        maxConnPerSubnet: 0,
        maxStreamsPerPeer: 0,
        maxStreamsPerProtocol: 0
    )

fn initOverlayState(): OverlayState =
    OverlayState(
        limits: initOverlayLimits(),
        peerConnCount: 0,
        subnetConnCount: 0,
        peerStreamCount: 0,
        protocolStreamCount: 0,
        lastError: ""
    )

var
    overlayState: OverlayState = initOverlayState()

fn resourceOverlayEnabled(): bool =
    return overlayState.limits.enabled

fn resourceOverlayLastError(): str =
    return overlayState.lastError

fn resourceOverlaySetError(msg: str) =
    overlayState.lastError = msg

fn resourceOverlayLimits(): OverlayLimits =
    return overlayState.limits

fn setResourceOverlayLimits(limits: OverlayLimits) =
    overlayState.limits = limits

fn resetOverlayEntries(entries: var OverlayCounterEntry[maxOverlayCounterKeys], count: var int32) =
    count = 0

fn resourceOverlayReset() =
    overlayState.peerConnCount = 0
    overlayState.subnetConnCount = 0
    overlayState.peerStreamCount = 0
    overlayState.protocolStreamCount = 0
    overlayState.lastError = ""

fn overlayFind(entries: OverlayCounterEntry[maxOverlayCounterKeys], count: int32, key: str): int32 =
    if len(key) <= 0:
        return -1
    for i in 0..<count:
        if (entries[i].key == key):
            return i
    return -1

fn overlayTryInc(
    entries: OverlayCounterEntry[maxOverlayCounterKeys],
    count: int32,
    maxEntries: int32,
    key: str,
    limit: int32,
    limitName: str
): OverlayCounterMutation =
    var out: OverlayCounterMutation
    out.ok = true
    out.entries = entries
    out.count = count
    if len(key) <= 0:
        return out
    let idx: int32 = overlayFind(out.entries, out.count, key)
    if idx >= 0:
        var entry: OverlayCounterEntry = out.entries[idx]
        if limit > 0 && entry.count >= limit:
            let msg: str = "overlay: " + limitName + " exceeded"
            resourceOverlaySetError(msg)
            out.ok = false
            out.error = msg
            return out
        entry.count = entry.count + 1
        out.entries[idx] = entry
        out.changed = true
        return out
    if out.count >= maxEntries:
        let msg: str = "overlay: counter table full"
        resourceOverlaySetError(msg)
        out.ok = false
        out.error = msg
        return out
    var newEntry: OverlayCounterEntry
    newEntry.key = key
    newEntry.count = 1
    out.entries[out.count] = newEntry
    out.count = out.count + 1
    out.changed = true
    if limit > 0 && 1 > limit:
        let msg: str = "overlay: " + limitName + " exceeded"
        resourceOverlaySetError(msg)
        out.ok = false
        out.error = msg
        return out
    return out

fn overlayDec(
    entries: OverlayCounterEntry[maxOverlayCounterKeys],
    count: int32,
    key: str
): OverlayCounterMutation =
    var out: OverlayCounterMutation
    out.ok = true
    out.entries = entries
    out.count = count
    if len(key) <= 0:
        return out
    let idx: int32 = overlayFind(out.entries, out.count, key)
    if idx < 0:
        return out
    var entry: OverlayCounterEntry = out.entries[idx]
    if entry.count > 0:
        entry.count = entry.count - 1
    if entry.count <= 0:
        let last: int32 = out.count - 1
        if idx != last:
            out.entries[idx] = out.entries[last]
        out.count = out.count - 1
    else:
        out.entries[idx] = entry
    out.changed = true
    return out

fn ipv4Subnet24(addrText: str): str =
    let pat: str = "/ip4/"
    var start: int32 = -1
    for i in 0..<len(addrText):
        if i + len(pat) > len(addrText):
            break
        var matched: bool = true
        var j: int32
        for j in 0..<len(pat):
            if addrText[i + j] != pat[j]:
                matched = false
                break
        if matched:
            start = i
            break
    if start < 0:
        return ""
    let ipStart: int32 = start + len(pat)
    if ipStart >= len(addrText):
        return ""
    var ipEnd: int32 = ipStart
    for scanIpEnd in ipEnd..<len(addrText):
        if addrText[scanIpEnd] == '/':
            ipEnd = scanIpEnd
            break
    if ipEnd <= ipStart:
        ipEnd = len(addrText)
    let ip: str = SliceBytes(addrText, ipStart, ipEnd - ipStart)
    var dotCount: int32
    var out: str
    for i in 0..<len(ip):
        if ip[i] == '.':
            dotCount = dotCount + 1
            if dotCount >= 3:
                break
        let chText: str = charToStr(ip[i])
        if len(out) == 0:
            out = chText
        else:
            out = out + chText
    if len(out) <= 0:
        return ""
    return out

fn reserveOverlayConnection(peerText: str, addrText: str): Result[bool] =
    if ! resourceOverlayEnabled():
        return Ok[bool](false)
    var state: OverlayState = overlayState
    let peerRes: OverlayCounterMutation = overlayTryInc(
        state.peerConn,
        state.peerConnCount,
        maxOverlayPeerConnKeys,
        peerText,
        state.limits.maxConnPerPeer,
        "peer connection limit"
    )
    if ! peerRes.ok:
        state.peerConn = peerRes.entries
        state.peerConnCount = peerRes.count
        state.lastError = peerRes.error
        overlayState = state
        return Err[bool](peerRes.error)
    let subnet: str = ipv4Subnet24(addrText)
    let subnetRes: OverlayCounterMutation = overlayTryInc(
        state.subnetConn,
        state.subnetConnCount,
        maxOverlaySubnetConnKeys,
        subnet,
        state.limits.maxConnPerSubnet,
        "subnet connection limit"
    )
    if ! subnetRes.ok:
        let peerRollback: OverlayCounterMutation = overlayDec(peerRes.entries, peerRes.count, peerText)
        state.peerConn = peerRollback.entries
        state.peerConnCount = peerRollback.count
        state.subnetConn = subnetRes.entries
        state.subnetConnCount = subnetRes.count
        state.lastError = subnetRes.error
        overlayState = state
        return Err[bool](subnetRes.error)
    state.peerConn = peerRes.entries
    state.peerConnCount = peerRes.count
    state.subnetConn = subnetRes.entries
    state.subnetConnCount = subnetRes.count
    overlayState = state
    return Ok[bool](true)

fn releaseOverlayConnection(peerText: str, addrText: str): Result[bool] =
    var state: OverlayState = overlayState
    let peerRes: OverlayCounterMutation = overlayDec(state.peerConn, state.peerConnCount, peerText)
    let subnet: str = ipv4Subnet24(addrText)
    let subnetRes: OverlayCounterMutation = overlayDec(state.subnetConn, state.subnetConnCount, subnet)
    state.peerConn = peerRes.entries
    state.peerConnCount = peerRes.count
    state.subnetConn = subnetRes.entries
    state.subnetConnCount = subnetRes.count
    overlayState = state
    return Ok[bool](true)

fn reserveOverlayProtocolStream(peerText: str, codec: str): Result[bool] =
    if ! resourceOverlayEnabled():
        return Ok[bool](false)
    var state: OverlayState = overlayState
    let peerRes: OverlayCounterMutation = overlayTryInc(
        state.peerStream,
        state.peerStreamCount,
        maxOverlayPeerStreamKeys,
        peerText,
        state.limits.maxStreamsPerPeer,
        "peer stream limit"
    )
    if ! peerRes.ok:
        state.peerStream = peerRes.entries
        state.peerStreamCount = peerRes.count
        state.lastError = peerRes.error
        overlayState = state
        return Err[bool](peerRes.error)
    let protoRes: OverlayCounterMutation = overlayTryInc(
        state.protocolStream,
        state.protocolStreamCount,
        maxOverlayProtocolStreamKeys,
        codec,
        state.limits.maxStreamsPerProtocol,
        "protocol stream limit"
    )
    if ! protoRes.ok:
        let peerRollback: OverlayCounterMutation = overlayDec(peerRes.entries, peerRes.count, peerText)
        state.peerStream = peerRollback.entries
        state.peerStreamCount = peerRollback.count
        state.protocolStream = protoRes.entries
        state.protocolStreamCount = protoRes.count
        state.lastError = protoRes.error
        overlayState = state
        return Err[bool](protoRes.error)
    state.peerStream = peerRes.entries
    state.peerStreamCount = peerRes.count
    state.protocolStream = protoRes.entries
    state.protocolStreamCount = protoRes.count
    overlayState = state
    return Ok[bool](true)

fn releaseOverlayProtocolStream(peerText: str, codec: str): Result[bool] =
    var state: OverlayState = overlayState
    let peerRes: OverlayCounterMutation = overlayDec(state.peerStream, state.peerStreamCount, peerText)
    let protoRes: OverlayCounterMutation = overlayDec(state.protocolStream, state.protocolStreamCount, codec)
    state.peerStream = peerRes.entries
    state.peerStreamCount = peerRes.count
    state.protocolStream = protoRes.entries
    state.protocolStreamCount = protoRes.count
    overlayState = state
    return Ok[bool](true)
