    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    var info: PeerInfo = newPeerInfo(Value(pidRes))
    let setRes: Result[bool] = setProtocolsText(info, protoText)
    if IsErr(setRes):
        return Err[bool](Error(setRes))
    return switchMergePeer(sw, info)

