fn hostAddPeerAddressText(sw: var Switch, peerText: str, addrText: str): Result[bool] =
    let pidRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    let addrRes: Result[multiaddress.MultiAddress] = parseMultiAddress(addrText)
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    var info: PeerInfo = newPeerInfo(Value(pidRes))
    let addRes: Result[bool] = addAddress(info, Value(addrRes))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    return switchMergePeer(sw, info)

