fn hostRelayReserve(sw: var Switch, peer: PeerId, ttlSeconds: int64): Result[RelayMessage] =
    return relayReserveRpc(sw, peer, ttlSeconds)

fn hostRelayReserveText(sw: var Switch, peerText: str, ttlSeconds: int64): Result[RelayMessage] =
    let peerRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(peerRes):
        return Err[RelayMessage](Error(peerRes))
    return relayReserveRpc(sw, Value(peerRes), ttlSeconds)

fn hostRelayConnect(sw: var Switch, relayPeer: PeerId, dstPeer: PeerId, token: Bytes): Result[RelayMessage] =
    return relayConnectRpc(sw, relayPeer, dstPeer, token)

fn hostRelayConnectText(sw: var Switch, relayPeerText: str, dstPeerText: str, token: Bytes): Result[RelayMessage] =
    let relayRes: Result[PeerId] = parsePeerId(relayPeerText)
    if IsErr(relayRes):
        return Err[RelayMessage](Error(relayRes))
    let dstRes: Result[PeerId] = parsePeerId(dstPeerText)
    if IsErr(dstRes):
        return Err[RelayMessage](Error(dstRes))
    return relayConnectRpc(sw, Value(relayRes), Value(dstRes), token)

fn hostDcutrRequest(sw: var Switch, peer: PeerId, req: DcutrRequest): Result[DcutrResponse] =
    return dcutrRequest(sw, peer, req)

fn hostDcutrRequestText(sw: var Switch, peerText: str, req: DcutrRequest): Result[DcutrResponse] =
    let peerRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(peerRes):
        return Err[DcutrResponse](Error(peerRes))
    return dcutrRequest(sw, Value(peerRes), req)

