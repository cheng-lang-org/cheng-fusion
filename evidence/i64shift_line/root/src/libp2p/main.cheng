fn hostSetSecureCodec(sw: var Switch, codec: str): Result[bool] =
    if ! ((codec == "plaintext") || (codec == "noise") || (codec == "tls")):
        return Err[bool]("host: unknown secure codec")
    var secure: Secure = initSecure(codec)
    if len(switchPeerIdText(sw)) > 0:
        setLocalPeerId(secure, switchPeerId(sw))
    setSecure(sw, secure)
    return Ok[bool](true)

