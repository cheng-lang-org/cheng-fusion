fn directionFromText(text: str): Result[streamconn.Direction] =
    if (text == "inbound") || (text == "in"):
        return Ok[streamconn.Direction](streamconn.Inbound)
    if (text == "outbound") || (text == "out"):
        return Ok[streamconn.Direction](streamconn.Outbound)
    return Err[streamconn.Direction]("host: unknown direction")

