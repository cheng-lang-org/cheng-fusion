fn hostNodeResourceQueryPeer(sw: var Switch, id: PeerId): Result[NodeResourceInfo] =
    let streamRes: Result[Stream] = hostOpenProtocolStreamToPeer(sw, id, nodeResourceCodec)
    if IsErr(streamRes):
        return Err[NodeResourceInfo](Error(streamRes))
    var stream: Stream = Value(streamRes)
    var req: NodeResourceRequest = initNodeResourceRequest()
    req.requestId = nodeResourceNextRequestId()
    let writeRes: Result[bool] = writeNodeResourceRequest(stream, req)
    if IsErr(writeRes):
        closeStream(stream)
        return Err[NodeResourceInfo](Error(writeRes))
    let respRes: Result[NodeResourceResponse] = readNodeResourceResponse(stream)
    if IsErr(respRes):
        closeStream(stream)
        return Err[NodeResourceInfo](Error(respRes))
    let closeRes: Result[bool] = closeStream(stream)
    if IsErr(closeRes):
        return Err[NodeResourceInfo](Error(closeRes))
    let resp: NodeResourceResponse = Value(respRes)
    if ! resp.ok:
        let msg: str = if len(resp.message) > 0: resp.message else: "node resource: ! ok"
        return Err[NodeResourceInfo](msg)
    if ! resp.hasInfo:
        return Err[NodeResourceInfo]("node resource: missing info")
    return Ok[NodeResourceInfo](resp.info)

fn hostNodeResourceUpdateAll(sw: var Switch, limit: int32): Result[int32] =
    let selfPeerId: PeerId = switchPeerId(sw)
    let selfRes: Result[bool] = nodeResourceUpdateSelf(selfPeerId)
    if IsErr(selfRes):
        return Err[int32](Error(selfRes))
    let listRes: Result[StringList] = switchListPeerIds(sw)
    if IsErr(listRes):
        return Err[int32](Error(listRes))
    var list: StringList = Value(listRes)
    var updated: int32
    for i in 0..<list.count:
        if ! (i < list.count):
            break
        if limit > 0 && updated >= limit:
            break
        let pidRes: Result[PeerId] = parsePeerId(list.items[i])
        if IsErr(pidRes):
            continue
        let pid: PeerId = Value(pidRes)
        let eqRes: Result[bool] = peerIdEqual(pid, selfPeerId)
        if IsErr(eqRes):
            return Err[int32](Error(eqRes))
        if Value(eqRes):
            continue
        let infoRes: Result[NodeResourceInfo] = hostNodeResourceQueryPeer(sw, pid)
        if IsOk(infoRes):
            let updateRes: Result[bool] = nodeResourceUpdatePeer(pid, Value(infoRes))
            if IsErr(updateRes):
                return Err[int32](Error(updateRes))
            updated = updated + 1
    return Ok[int32](updated)

fn mobileNodeResourceUpdateAll(sw: var Switch, limit: int32): Result[int32] =
    return hostNodeResourceUpdateAll(sw, limit)

fn hostNodeResourceTotals(): NodeResourceTotals =
    return nodeResourceTotals()

fn hostNodeResourceTotalsText(): str =
