fn hostOpenProtocolStreamToAddress(sw: var Switch, addr: multiaddress.MultiAddress, codec: str): Result[Stream] =
    let muxRes: Result[Muxer] = dial(sw, addr)
    if IsErr(muxRes):
        return Err[Stream](Error(muxRes))
    var mux: Muxer = Value(muxRes)
    return openProtocolStream(sw, mux, codec)

