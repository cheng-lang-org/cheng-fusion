fn buildHost(builder: SwitchBuilder): Result[Switch] =
    build(builder)

fn newHost(): Result[Switch] =
    var builder: SwitchBuilder = newSwitchBuilder()
    return build(builder)

fn newHostWithAddressText(text: str): Result[Switch] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let setRes: Result[bool] = withAddressText(builder, text)
    if IsErr(setRes):
        return Err[Switch](Error(setRes))
    return build(builder)

# Slim host: identify/ping/gossipsub/feed only (buildSlim → newSlimSwitch).
# Statically separate chain so slim-profile artifacts (feed .so) never reach
# the 26-protocol standard switch closure.
fn newHostWithAddressTextSlim(sw: var Switch, text: str): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    var setRes: Result[bool] = withAddressText(builder, text)
    if !setRes.ok:
        return setRes
    return buildSlim(builder, sw)

fn newHostWithAddress(addr: multiaddress.MultiAddress): Result[Switch] =
    var builder: SwitchBuilder = newSwitchBuilder()
    withAddress(builder, addr)
    return build(builder)

fn newHostWithPrivateKey(key: PrivateKey): Result[Switch] =
    var builder: SwitchBuilder = newSwitchBuilder()
    withPrivateKey(builder, key)
    return build(builder)

fn newHostWithPrivateKeyAndAddressText(key: PrivateKey, addrText: str): Result[Switch] =
    var builder: SwitchBuilder = newSwitchBuilder()
    withPrivateKey(builder, key)
    let setRes: Result[bool] = withAddressText(builder, addrText)
    if IsErr(setRes):
        return Err[Switch](Error(setRes))
    return build(builder)

