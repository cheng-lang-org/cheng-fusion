type
    MsQuicRunMode = enum
        msQuicRunModeFull = 0
        msQuicRunModeStub = 1

    VpnHostConfig =
        bootstrapPolicy: BootstrapPolicy
        globalScaleProfile: GlobalScaleProfile
        autoRolePromotionEnabled: bool
        msquicRunMode: MsQuicRunMode

fn initMsQuicRunMode(): MsQuicRunMode =
    return msQuicRunModeFull

fn msQuicRunModeText(mode: MsQuicRunMode): str =
    if mode == msQuicRunModeStub:
        return "stub"
    return "full"

fn parseMsQuicRunMode(text: str): Result[MsQuicRunMode] =
    let modeText: str = trimText(text)
    if len(modeText) <= 0 || modeText == "full":
        return Ok[MsQuicRunMode](msQuicRunModeFull)
    if modeText == "stub":
        return Ok[MsQuicRunMode](msQuicRunModeStub)
    return Err[MsQuicRunMode]("host: invalid msquic run mode (expected full|stub)")

fn initVpnHostConfig(): VpnHostConfig =
    VpnHostConfig(
        bootstrapPolicy: initBootstrapPolicy(),
        globalScaleProfile: initGlobalScaleProfileL2Routing(),
        autoRolePromotionEnabled: true,
        msquicRunMode: initMsQuicRunMode()
    )

fn normalizeVpnHostConfig(cfg: VpnHostConfig): VpnHostConfig =
    var out: VpnHostConfig = cfg
    out.bootstrapPolicy = normalizeBootstrapPolicy(cfg.bootstrapPolicy)
    setProfileAutoRolePromotionEnabled(out.globalScaleProfile, cfg.autoRolePromotionEnabled)
    return out

fn applyVpnHostConfig(builder: var SwitchBuilder, cfg: VpnHostConfig): Result[bool] =
    let normalized: VpnHostConfig = normalizeVpnHostConfig(cfg)
    withGlobalScaleProfile(builder, normalized.globalScaleProfile)
    withAutoRolePromotionEnabled(builder, normalized.autoRolePromotionEnabled)
    return Ok[bool](true)

fn hostBootstrapInitPolicy(): BootstrapPolicy =
    return initBootstrapPolicy()

fn hostBootstrapNormalizePolicy(policy: BootstrapPolicy): BootstrapPolicy =
    return normalizeBootstrapPolicy(policy)

