# Mobile FFI public wrappers. Lowercase host helpers stay internal to this
# module; mobile_ffi imports these exported names explicitly.
fn NewHostWithAddressText(text: str): Result[Switch] =
    return newHostWithAddressText(text)

fn NewHostWithAddressTextSlim(sw: var Switch, text: str): Result[bool] =
    return newHostWithAddressTextSlim(sw, text)

fn HostStart(sw: var Switch): Result[bool] =
    return hostStart(sw)

fn HostStartOwned(sw: Switch): Result[MobileSwitchBoolResult] =
    var working: Switch = sw
    let startRes: Result[bool] = hostStart(working)
    if IsErr(startRes):
        return Err[MobileSwitchBoolResult](Error(startRes))
    return Ok[MobileSwitchBoolResult](MobileSwitchBoolResult(sw: working, ok: Value(startRes)))

fn HostStop(sw: var Switch) =
    hostStop(sw)

fn HostStopOwned(sw: Switch): Switch =
    var working: Switch = sw
    hostStop(working)
    return working

