fn hostAccept(sw: var Switch): Result[Muxer] =
    return accept(sw)

fn hostAcceptStream(sw: var Switch): Result[Stream] =
    var prevErr: Option[str] = None[str]()
    var mux: Muxer
    let activeRes: Result[Muxer] = switchActiveMuxerGet(sw)
    if IsOk(activeRes):
        mux = Value(activeRes)
        let streamRes: Result[Stream] = acceptStream(mux)
        switchActiveMuxerSet(sw, mux)
        if IsOk(streamRes):
            return streamRes
        prevErr = Some[str](Error(streamRes))
    let muxRes: Result[Muxer] = accept(sw)
    if IsErr(muxRes):
        if prevErr.has:
            return Err[Stream](prevErr.value)
        return Err[Stream](Error(muxRes))
    mux = Value(muxRes)
    let streamRes: Result[Stream] = acceptStream(mux)
    switchActiveMuxerSet(sw, mux)
    if IsErr(streamRes):
        return Err[Stream](Error(streamRes))
    return streamRes

