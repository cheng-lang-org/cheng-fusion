fn hostDepinOrderbookPublish(sw: var Switch, cardRaw: DepinAskCard): Result[bool] =
    var card: DepinAskCard = cardRaw
    if len(card.peerId) <= 0:
        card.peerId = switchPeerIdText(sw)
    if len(card.peerId) <= 0:
        return Err[bool]("depin orderbook: missing peer_id")
    return depinOrderbookPublish(card)

