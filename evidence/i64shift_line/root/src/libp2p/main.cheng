fn hostDepinInferenceInit(
    req: DepinInferenceRequest,
    cfg: DepinInferenceConfig
): DepinInferenceSession =
    return depinInferenceInitSession(req, cfg)

fn hostDepinInferenceStart(
    session: var DepinInferenceSession,
    peers: str[]
): Result[DepinStageAssignment[]] =
    if session.started:
        return Err[DepinStageAssignment[]]("depin inference: session already started")
    if len(session.request.layerCids) <= 0:
        return Err[DepinStageAssignment[]]("depin inference: empty layer cids")
    var layerCids: str[]
    for i in 0..<len(session.request.layerCids):
        seqAdd(layerCids, session.request.layerCids[i])
    let assignments: DepinStageAssignment[] = depinSchedulerBuild(peers, layerCids)
    if len(assignments) <= 0:
        return Err[DepinStageAssignment[]]("depin inference: scheduler returned empty assignments")
    if !depinSchedulerValidate(assignments):
        return Err[DepinStageAssignment[]]("depin inference: invalid stage assignment")
    session.started = true
    session.finished = false
    session.failed = false
    session.failureReason = ""
    session.stageIndex = 0
    session.expectedSeqNo = uint64(0)
    session.lastStageAtMs = depinInferenceNowMs()
    return Ok[DepinStageAssignment[]](assignments)

fn hostDepinInferenceServeStage(
    session: var DepinInferenceSession,
    seqNo: uint64,
    payload: Bytes
): Result[bool] =
    return depinPipelineServeStage(session, seqNo, payload, depinInferenceNowMs())

fn hostDepinInferenceSubmitSettlement(
    adapter: var DepinRwadDispatcherAdapter,
    session: var DepinInferenceSession,
    plan: DepinSettlementPlan
): Result[bool] =
    let submitRes: Result[bool] = depinSettlementSubmit(adapter, session, plan)
    if IsErr(submitRes):
        return Err[bool](Error(submitRes))
    let finalizeRes: Result[bool] = depinSettlementFinalize(adapter, session, plan)
    if IsErr(finalizeRes):
        return Err[bool](Error(finalizeRes))
    return Ok[bool](true)

fn hostDepinInferenceChallenge(
    adapter: var DepinRwadDispatcherAdapter,
    session: var DepinInferenceSession,
    plan: DepinSettlementPlan,
    reason: str,
    proofPayload: Bytes
): Result[bool] =
    let decision: DepinAuditDecision = DepinAuditDecision(
        sampled: true,
        bps: session.config.auditHighRiskBps,
        reason: "challenge_forced"
    )
    return depinSettlementChallenge(adapter, session, plan, decision, reason, proofPayload)

