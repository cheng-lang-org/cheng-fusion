fn hostServeOnce(sw: var Switch): Result[bool] =
    let streamRes: Result[Stream] = hostAcceptStream(sw)
    if IsErr(streamRes):
        return Err[bool](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let runRes: Result[bool] = runProtocol(sw, stream, "")
    if IsErr(runRes):
        closeStream(stream)
        return Err[bool](Error(runRes))
    let closeRes: Result[bool] = closeStream(stream)
    if IsErr(closeRes):
        return Err[bool](Error(closeRes))
    return Ok[bool](true)

fn hostServe(sw: var Switch, maxStreams: int32): Result[int32] =
    if maxStreams <= 0:
        return Err[int32]("hostServe: maxStreams must be > 0")
    for _ in 0..<maxStreams:
        let res: Result[bool] = hostServeOnce(sw)
        if IsErr(res):
            return Err[int32](Error(res))
    return Ok[int32](maxStreams)

