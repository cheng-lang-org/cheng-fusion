# DNS resolver(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/stringlist
import cheng/libp2p/nameresolving/nameresolver
type
    DnsResolverConfig =
        protocol: str

var
    dnsResolverConfig: DnsResolverConfig = DnsResolverConfig(protocol: "dns")

fn initDnsResolverConfig(): DnsResolverConfig =
    DnsResolverConfig(protocol: "dns")

fn setDnsResolverConfig(config: DnsResolverConfig) =
    dnsResolverConfig = config

fn dnsResolverProtocol(): str =
    return dnsResolverConfig.protocol

fn dnsResolveName(name: str): Result[StringList] =
    if len(name) <= 0:
        return Err[StringList]("dns: empty name")
    var list: StringList = InitStringList()
    if name[0] == '/':
        StringListAdd(list, name)
        return Ok[StringList](list)
    var prefix: str = "/" + dnsResolverConfig.protocol
    prefix = prefix + "/"
    let addr: str = prefix + name
    StringListAdd(list, addr)
    return Ok[StringList](list)

fn dnsNameResolver(): NameResolver =
    return initNameResolver(dnsResolveName)
