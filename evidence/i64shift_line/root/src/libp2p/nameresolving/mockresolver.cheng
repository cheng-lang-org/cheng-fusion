# Mock resolver(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/stringlist
import cheng/libp2p/nameresolving/nameresolver
const
    maxMockEntries = 64

type
    MockEntry =
        name: str
        address: str

    MockResolver =
        count: int32
        items: MockEntry[maxMockEntries]

var
    mockResolver: MockResolver = MockResolver(count: 0)

fn initMockResolver(): MockResolver =
    MockResolver(count: 0)

fn mockReset() =
    mockResolver = initMockResolver()

fn mockIndex(name: str): int32 =
    if len(name) <= 0:
        return -1
    for i in 0..<mockResolver.count:
        if (mockResolver.items[i].name == name):
            return i
    return -1

fn mockAdd(name: str, address: str): Result[bool] =
    if len(name) <= 0:
        return Err[bool]("mock: empty name")
    if len(address) <= 0:
        return Err[bool]("mock: empty address")
    let idx: int32 = mockIndex(name)
    if idx >= 0:
        mockResolver.items[idx].address = address
        return Ok[bool](true)
    if mockResolver.count >= maxMockEntries:
        return Err[bool]("mock: full")
    mockResolver.items[mockResolver.count] = MockEntry(name: name, address: address)
    mockResolver.count = mockResolver.count + 1
    return Ok[bool](true)

fn mockResolveName(name: str): Result[StringList] =
    if len(name) <= 0:
        return Err[StringList]("mock: empty name")
    let idx: int32 = mockIndex(name)
    if idx < 0:
        return Err[StringList]("mock: ! found")
    var list: StringList = InitStringList()
    StringListAdd(list, mockResolver.items[idx].address)
    return Ok[StringList](list)

fn mockNameResolver(): NameResolver =
    return initNameResolver(mockResolveName)
