# Name resolver(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/stringlist
type
    NameResolver =
        hasResolve: bool
        resolve: fn(name: str): Result[StringList]

fn resolveNameMissing(name: str): Result[StringList] =
    name
    return Err[StringList]("resolver: ! set")

var
    nameResolver: NameResolver = NameResolver(hasResolve: false, resolve: resolveNameMissing)

fn initNameResolver(resolveProc: fn(name: str): Result[StringList]): NameResolver =
    NameResolver(hasResolve: true, resolve: resolveProc)

fn setNameResolver(resolver: NameResolver) =
    nameResolver = resolver

fn clearNameResolver() =
    nameResolver = NameResolver(hasResolve: false, resolve: resolveNameMissing)

fn resolveName(name: str): Result[StringList] =
    if len(name) <= 0:
        return Err[StringList]("resolver: empty name")
    if ! nameResolver.hasResolve:
        return Err[StringList]("resolver: ! set")
    return nameResolver.resolve(name)
