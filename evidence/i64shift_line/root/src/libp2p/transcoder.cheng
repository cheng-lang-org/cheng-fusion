# Transcoder interface.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/vbuffer
type
    Transcoder =
        stringToBuffer: fn(s: str, vb: var VBuffer): bool
        bufferToString: fn(vb: var VBuffer, s: var str): bool
        validateBuffer: fn(vb: var VBuffer): bool

fn initTranscoder(
    stringToBuffer: fn(s: str, vb: var VBuffer): bool,
    bufferToString: fn(vb: var VBuffer, s: var str): bool,
    validateBuffer: fn(vb: var VBuffer): bool
): Transcoder =
    Transcoder(
        stringToBuffer: stringToBuffer,
        bufferToString: bufferToString,
        validateBuffer: validateBuffer
    )

fn transcoderEncode(t: Transcoder, text: str): Result[Bytes] =
    var vb: VBuffer = newVBuffer()
    if ! t.stringToBuffer(text, vb):
        return Err[Bytes]("transcoder: encode failed")
    return Ok[Bytes](toBytes(vb))

fn transcoderDecode(t: Transcoder, data: Bytes): Result[str] =
    var vb: VBuffer = initVBuffer(data, 0)
    var out: str
    if ! t.bufferToString(vb, out):
        return Err[str]("transcoder: decode failed")
    return Ok[str](out)

fn transcoderValidate(t: Transcoder, data: Bytes): bool =
    var vb: VBuffer = initVBuffer(data, 0)
    return t.validateBuffer(vb)
