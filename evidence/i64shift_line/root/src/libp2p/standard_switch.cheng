# Standard switch helper(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/multiaddress
import cheng/libp2p/crypto/crypto
import cheng/libp2p/peerid
import cheng/libp2p/switch
import cheng/libp2p/protocols/secure/secure
import cheng/libp2p/protocols/identify
import cheng/libp2p/protocols/ping
import cheng/libp2p/protocols/kademlia
import cheng/libp2p/protocols/rendezvous
import cheng/libp2p/protocols/bitswap/bitswap
import cheng/libp2p/protocols/bitswap/store
import cheng/libp2p/protocols/bitswap/ledger
import cheng/libp2p/protocols/graphsync/graphsync
import cheng/libp2p/protocols/datatransfer/datatransfer
import cheng/libp2p/protocols/fetch/fetch
import cheng/libp2p/protocols/pubsub/floodsub
import cheng/libp2p/protocols/pubsub/gossipsub
import cheng/libp2p/protocols/pubsub/episub/episub
import cheng/libp2p/protocols/http/http
import cheng/libp2p/protocols/dm/dmservice
import cheng/libp2p/protocols/dm/dmenvelope
import cheng/libp2p/protocols/feed/feedservice
import cheng/libp2p/protocols/noderesource/noderesource
import cheng/libp2p/protocols/depin/inference_pipeline_protocol
import cheng/libp2p/protocols/synccast/control
import cheng/libp2p/protocols/synccast/media
import cheng/libp2p/protocols/livestream/livestream
import cheng/libp2p/protocols/mix/mix_protocol
import cheng/libp2p/protocols/connectivity/autonat/service as autonatservice
import cheng/libp2p/protocols/connectivity/autonat/server
import cheng/libp2p/protocols/connectivity/autonatv2/service as autonatv2service
import cheng/libp2p/protocols/connectivity/autonatv2/server
import cheng/libp2p/protocols/connectivity/relay/relay
import cheng/libp2p/protocols/connectivity/dcutr/server
import cheng/libp2p/delegatedrouting/server
fn newStandardSwitch(addr: MultiAddress, privKey: PrivateKey): Switch =
    let pidRes: Result[PeerId] = peerIdFromPrivateKey(privKey)
    var pid: PeerId
    if IsErr(pidRes):
        pid = peerIdFromTextUnchecked("")
    else:
        pid = Value(pidRes)
    var sw: Switch = initSwitch(privKey, pid)
    setListenAddr(sw, addr)
    var secure: Secure = initSecure("plaintext")
    if len(peerid.toString(pid)) > 0:
        setLocalPeerId(secure, pid)
    setSecure(sw, secure)
    registerProtocol(sw, identifyProtocol())
    registerProtocol(sw, identifyPushProtocol())
    registerProtocol(sw, pingProtocol())
    let kadRes: Result[KadState] = initKadState(pid)
    if IsOk(kadRes):
        setKademliaContext(Value(kadRes), sw.peerStore)
        registerProtocol(sw, kademliaProtocol())
    setRendezvousState(initRendezvousState())
    registerProtocol(sw, rendezvousProtocol())
    let bsStore: BitswapBlockStore = initBitswapStore()
    let bsLedger: BitswapLedger = initBitswapLedger()
    setBitswapStore(bsStore)
    setBitswapLedger(bsLedger)
    setBitswapConfig(initBitswapConfig())
    registerProtocol(sw, bitswapProtocol())
    setGraphsyncStore(bsStore)
    setGraphsyncConfig(initGraphsyncConfig())
    registerProtocol(sw, graphsyncProtocol())
    setDataTransferConfig(initDataTransferConfig())
    setDataTransferChannelManager(initDataTransferChannelManager())
    setDataTransferPersistence(initDataTransferPersistence())
    registerProtocol(sw, dataTransferProtocol())
    setFetchStore(bsStore)
    setFetchConfig(initFetchConfig())
    registerProtocol(sw, fetchProtocol())
    setFloodsubConfig(initFloodsubConfig())
    setFloodsubContext(initPubsubContext())
    registerProtocol(sw, floodsubProtocol())
    setGossipsubConfig(initGossipsubConfig())
    setGossipsubContext(initPubsubContext())
    registerProtocol(sw, gossipsubProtocol())
    setEpisubConfig(initEpisubConfig())
    setEpisubContext(initPubsubContext())
    registerProtocol(sw, episubProtocol())
    setHttpConfig(initHttpConfig())
    setHttpRouter(initHttpRouter())
    registerProtocol(sw, httpProtocol())
    setDmConfig(initDmConfig())
    registerProtocol(sw, dmProtocol())
    setDmEnvelopeConfig(initDmEnvelopeConfig())
    registerProtocol(sw, dmEnvelopeProtocol())
    setFeedConfig(initFeedConfig())
    registerProtocol(sw, feedProtocol())
    setNodeResourceConfig(initNodeResourceConfig())
    registerProtocol(sw, nodeResourceProtocol())
    registerProtocol(sw, depinInferencePipelineProtocol())
    setSynccastControlConfig(initSynccastControlConfig())
    registerProtocol(sw, synccastControlProtocol())
    setSynccastMediaConfig(initSynccastMediaConfig())
    registerProtocol(sw, synccastMediaProtocol())
    setLivestreamConfig(initLivestreamConfig())
    registerProtocol(sw, livestreamProtocol())
    setMixConfig(initMixConfig())
    registerProtocol(sw, mixProtocol())
    setAutonatConfig(initAutonatConfig())
    registerProtocol(sw, autonatProtocol())
    setAutonatv2Config(initAutonatv2Config())
    registerProtocol(sw, autonatv2Protocol())
    setRelayConfig(initRelayConfig())
    setRelayState(initRelayState())
    registerProtocol(sw, relayProtocol())
    setDcutrConfig(initDcutrConfig())
    registerProtocol(sw, dcutrProtocol())
    setDelegatedRoutingConfig(initDelegatedRoutingConfig())
    setDelegatedRoutingStore(initDelegatedStore())
    registerProtocol(sw, delegatedRoutingProtocol())
    return sw
