# Onionpay regression tests.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/onionpay
import cheng/libp2p/peerid
import cheng/libp2p/tests/test_utils
fn runOnionpayRegression(): Result[bool] =
    let seedRes: Result[bool] = seedTestRng("onionpay-regression")
    if IsErr(seedRes):
        return Err[bool](Error(seedRes))
    let peerRes: Result[PeerId] = randomPeerId()
    if IsErr(peerRes):
        return Err[bool](Error(peerRes))
    let secret: Bytes = fixedBytes(onionSecretSize, 9)
    var hops: OnionHopList = initHopList()
    let addRes: Result[bool] = hopListAdd(
        hops,
        OnionRouteHop(peer: Value(peerRes), secret: secret, ttl: 3)
    )
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    let route: OnionRoute = OnionRoute(id: randomRouteId(), hops: hops)
    let payload: Bytes = BytesFromString("hello")
    let packetRes: Result[OnionPacket] = buildOnionPacket(route, payload)
    if IsErr(packetRes):
        return Err[bool](Error(packetRes))
    var packet: OnionPacket = Value(packetRes)
    if BytesLen(packet.ephemeralPk) != 0:
        return Err[bool]("regression: onionpay epk ! empty")
    let peelRes: Result[OnionLayerResult] = peelOnionLayer(packet, secret)
    if IsErr(peelRes):
        return Err[bool](Error(peelRes))
    let peeled: OnionLayerResult = Value(peelRes)
    if ! peeled.isFinal:
        return Err[bool]("regression: onionpay final flag missing")
    if ! BytesEqual(peeled.payload, payload):
        return Err[bool]("regression: onionpay payload mismatch")
    return Ok[bool](true)
