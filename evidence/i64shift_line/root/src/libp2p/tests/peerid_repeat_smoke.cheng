# PeerId randomness smoke(should differ across calls).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/peerid

fn main(): int32 =
    let aRes: Result[PeerId] = randomPeerId()
    if IsErr(aRes):
        echo("peerid repeat smoke failed: " + Error(aRes))
        return 1
    let bRes: Result[PeerId] = randomPeerId()
    if IsErr(bRes):
        echo("peerid repeat smoke failed: " + Error(bRes))
        return 1
    let aText: str = peerid.toString(Value(aRes))
    let bText: str = peerid.toString(Value(bRes))
    echo("a=" + aText)
    echo("b=" + bText)
    echo("equalText=" + $((aText == bText)))
    return if (aText == bText): 2 else: 0

