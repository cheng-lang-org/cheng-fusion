# Returning Result[PeerId] smoke.

import cheng/libp2p/utils/result
import cheng/libp2p/peerid

fn makePeerIdOk(): Result[PeerId] =
    return Ok[PeerId](peerIdFromTextUnchecked("abc"))

fn main(): int32 =
    let res: Result[PeerId] = makePeerIdOk()
    if IsErr(res):
        echo("peerid return smoke failed: " + Error(res))
        return 1
    let pid: PeerId = Value(res)
    echo("pid.len=" + $(len(peerid.toString(pid))))
    echo("pid=" + peerid.toString(pid))
    return 0
