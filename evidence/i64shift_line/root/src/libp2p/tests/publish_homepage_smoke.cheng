# Publish content + homepage access semantic smoke runner.

import cheng/libp2p/utils/result

fn runPublishHomepageSmoke(): Result[bool] =
    let publishedPost: str = "{\"postId\":\"post-1\",\"content\":\"hello-home\"}"
    if len(publishedPost) <= 0:
        return Err[bool]("publish-home: publish payload empty")

    var homepageItems: str[]
    add(homepageItems, publishedPost)
    if len(homepageItems) <= 0:
        return Err[bool]("publish-home: homepage empty")
    if homepageItems[0] != publishedPost:
        return Err[bool]("publish-home: homepage payload mismatch")
    return Ok[bool](true)

fn main(): int32 =
    let runRes: Result[bool] = runPublishHomepageSmoke()
    if IsErr(runRes):
        echo("publish homepage smoke failed")
        echo(Error(runRes))
        return 1
    echo("publish homepage smoke ok")
    return 0
