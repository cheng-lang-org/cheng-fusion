# Observed address manager smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/observedaddrmanager
fn runObservedAddrSmoke(): Result[bool] =
    observedAddrReset()
    let addRes: Result[bool] = observedAddrAddText("/ip4/127.0.0.1/tcp/4001")
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    if observedAddrCount() != 1:
        return Err[bool]("smoke: observed addr count mismatch")
    let dump: str = observedAddrDump()
    if ! StrContains(dump, "/ip4/127.0.0.1/tcp/4001"):
        return Err[bool]("smoke: observed addr dump mismatch")
    return Ok[bool](true)
