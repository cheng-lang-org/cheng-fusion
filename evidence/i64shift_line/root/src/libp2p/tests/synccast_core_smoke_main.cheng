# Synccast core smoke test(main entry).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_core_smoke
fn main(): int32 =
    let res: Result[bool] = runSynccastCoreSmoke()
    if IsErr(res):
        echo("synccast core smoke failed: " + Error(res))
        return 1
    echo("synccast core smoke ok")
    return 0

