# Synccast focused verify runner(fast).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_core_smoke
import cheng/libp2p/tests/synccast_control_smoke
import cheng/libp2p/tests/synccast_media_smoke
import cheng/libp2p/tests/synccast_stream_fallback_smoke
fn runSynccastVerify(): Result[bool] =
    let coreRes: Result[bool] = runSynccastCoreSmoke()
    if IsErr(coreRes):
        return coreRes
    let controlRes: Result[bool] = runSynccastControlSmoke()
    if IsErr(controlRes):
        return controlRes
    let mediaRes: Result[bool] = runSynccastMediaSmoke()
    if IsErr(mediaRes):
        return mediaRes
    let fallbackRes: Result[bool] = runSynccastStreamFallbackSmoke()
    if IsErr(fallbackRes):
        return fallbackRes
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runSynccastVerify()
    if IsErr(res):
        echo("synccast verify failed")
        echo(Error(res))
        return 1
    echo("synccast verify ok")
    return 0
