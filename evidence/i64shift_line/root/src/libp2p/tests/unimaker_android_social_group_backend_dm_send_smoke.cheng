# Verifies group-create backend social_dm_send uses the same payload's
# seedAddrs/multiaddrs for the UDP MSG| frame (no registerPeerHint),
# fails closed on missing_route, and drains the send into social_feed_snapshot.

import std/system
import std/strings
import std/os
import std/rawbytes
import cheng/libp2p/mobile_ffi/unimaker_android_social_group_backend

@borrows
fn containsText(text: str, needle: str): bool =
    if len(needle) <= 0:
        return true
    var i: int32
    let last: int32 = len(text) - len(needle)
    while i <= last:
        var ok: bool = true
        var j: int32
        while j < len(needle):
            if text[i + j] != needle[j]:
                ok = false
                break
            j = j + 1
        if ok:
            return true
        i = i + 1
    return false

fn main(): int32 =
    let dataDir: str = "/data/user/0/com.unimaker.app.dmsend/files/libp2p"
    let cfg: str = "{\"dataDir\":\"" + dataDir + "\",\"data_dir\":\"" + dataDir + "\",\"runtimeProfile\":\"standard_android\"}"
    let handle: int64 = libp2p_node_init(cfg)
    if handle <= 0:
        return 11
    if libp2p_node_start(handle) != 0:
        return 12
    let localPeer: str = strFromCStringCopy(libp2p_get_local_peer_id(handle))
    if len(localPeer) <= 0:
        return 13

    let peer: str = "12D3KooWDmSendSmokePeerIdNotUsedForRoute"
    let conv: str = "node_thread:dm-smoke"
    let mid: str = "msg-dm-smoke-1"
    let noRoute: str =
        "{\"kind\":\"social\",\"entity\":\"dm\",\"op\":\"send\",\"messageId\":\"" +
        mid +
        "\",\"conversationId\":\"" +
        conv +
        "\",\"text\":\"hi\"}"
    if social_dm_send_text(handle, peer, conv, noRoute):
        return 21
    let missing: str = strFromCStringCopy(libp2p_get_last_error())
    if !containsText(missing, "missing_route"):
        return 22

    var listenFd: int32 = -1
    var listenPort: int32
    var listenFamily: int32
    var useLen: int32
    if os.udpBindHostPortBridge("127.0.0.1", 0, 0, listenFd, listenPort, listenFamily, useLen) != 0:
        return 31
    if listenFd < 0 || listenPort <= 0:
        return 32

    let addr: str = "/ip4/127.0.0.1/udp/" + strings.IntToStr(listenPort)
    let payload: str =
        "{\"kind\":\"social\",\"entity\":\"dm\",\"op\":\"send\",\"type\":\"text\",\"messageType\":\"text\",\"messageId\":\"" +
        mid +
        "\",\"mid\":\"" +
        mid +
        "\",\"id\":\"" +
        mid +
        "\",\"conversationId\":\"" +
        conv +
        "\",\"text\":\"hello-dm\",\"body\":\"hello-dm\",\"content\":\"hello-dm\",\"seedAddrs\":[\"" +
        addr +
        "\"],\"multiaddrs\":[\"" +
        addr +
        "\"],\"timestampMs\":1787610000000}"
    if !social_dm_send_text(handle, peer, conv, payload):
        return 41
    let afterSend: str = strFromCStringCopy(libp2p_get_last_error())
    if len(afterSend) > 0:
        return 42

    if os.fdWaitReadable(listenFd, 1500) <= 0:
        let _ = os.udpCloseFd(listenFd)
        return 51
    var buf: rawbytes.Bytes = rawbytes.BytesAlloc(4096)
    let n: int32 = os.udpRecvFromFd(listenFd, buf, 0)
    let _ = os.udpCloseFd(listenFd)
    if n <= 0:
        return 52
    let frame: str = rawbytes.BytesToString(rawbytes.BytesSlice(buf, 0, n))
    if !strings.HasPrefix(frame, "MSG|"):
        return 53
    if !containsText(frame, localPeer):
        return 54
    if !containsText(frame, conv):
        return 55
    if !containsText(frame, mid):
        return 56

    let snap: str = strFromCStringCopy(social_feed_snapshot(handle, "dm", "", 16))
    if !containsText(snap, "\"entity\":\"dm\""):
        return 61
    if !containsText(snap, conv):
        return 62
    if !containsText(snap, mid):
        return 63

    if social_dm_send_text(handle, "", conv, payload):
        return 71
    if social_dm_send_text(0, peer, conv, payload):
        return 72

    echo("unimaker_android_social_group_backend_dm_send_smoke=pass")
    return 0
