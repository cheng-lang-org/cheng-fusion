# Relay protocol smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/switch
import cheng/libp2p/builders
import cheng/libp2p/protocols/connectivity/relay/messages
import cheng/libp2p/protocols/connectivity/relay/relay
fn runRelaySmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/61")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    var cfg: RelayConfig = initRelayConfig()
    cfg.closeAfterResponse = false
    setRelayConfig(cfg)
    setRelayState(initRelayState())
    registerProtocol(sw, relayProtocol())
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openProtocolStream(sw, outboundMux, relayCodec)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    var reserve: RelayMessage = initRelayMessage()
    reserve.msgType = relayReserve
    reserve.hasSrc = true
    reserve.srcPeer = sw.peerId
    let reserveWriteRes: Result[int32] = writeLp(outStream, encodeRelayMessage(reserve))
    if IsErr(reserveWriteRes):
        return Err[bool](Error(reserveWriteRes))
    let handleRes: Result[bool] = relayHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let replyRes: Result[Bytes] = readLp(outStream, relayMaxControlBytes)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let replyMsgRes: Result[RelayMessage] = decodeRelayMessage(Value(replyRes))
    if IsErr(replyMsgRes):
        return Err[bool](Error(replyMsgRes))
    let reply: RelayMessage = Value(replyMsgRes)
    if reply.msgType != relayReserveResponse || ! reply.hasStatus || reply.status != relayOk:
        return Err[bool]("smoke: relay reserve failed")
    if ! reply.hasToken:
        return Err[bool]("smoke: relay missing token")
    var connect: RelayMessage = initRelayMessage()
    connect.msgType = relayConnect
    connect.hasSrc = true
    connect.srcPeer = sw.peerId
    connect.hasDst = true
    connect.dstPeer = sw.peerId
    connect.hasToken = true
    connect.token = reply.token
    let connectWriteRes: Result[int32] = writeLp(outStream, encodeRelayMessage(connect))
    if IsErr(connectWriteRes):
        return Err[bool](Error(connectWriteRes))
    let handle2Res: Result[bool] = relayHandler(inStream)
    if IsErr(handle2Res):
        return Err[bool](Error(handle2Res))
    let reply2Res: Result[Bytes] = readLp(outStream, relayMaxControlBytes)
    if IsErr(reply2Res):
        return Err[bool](Error(reply2Res))
    let reply2MsgRes: Result[RelayMessage] = decodeRelayMessage(Value(reply2Res))
    if IsErr(reply2MsgRes):
        return Err[bool](Error(reply2MsgRes))
    let reply2: RelayMessage = Value(reply2MsgRes)
    if reply2.msgType != relayConnectResponse || ! reply2.hasStatus || reply2.status != relayOk:
        return Err[bool]("smoke: relay connect failed")
    return Ok[bool](true)
