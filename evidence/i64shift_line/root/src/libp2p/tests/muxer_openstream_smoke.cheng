# Muxer openStream smoke(memory transport + mplex open/accept + write/read).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer

fn runMuxerOpenStreamSmoke(): Result[bool] =
    # Preflight: basic memory transport pipe should work before muxer use.
    let preAddrRes: Result[MultiAddress] = parseMultiAddress("/memory/65")
    if IsErr(preAddrRes):
        return Err[bool](Error(preAddrRes))
    let preAddr: MultiAddress = Value(preAddrRes)
    var preListener: MemoryTransport = initMemoryTransport()
    start(preListener, preAddr)
    var preDialer: MemoryTransport = initMemoryTransport()
    let preOutRes: Result[Connection] = dial(preDialer, preAddr)
    if IsErr(preOutRes):
        return Err[bool]("smoke: preflight dial failed: " + Error(preOutRes))
    let preInRes: Result[Connection] = accept(preListener)
    if IsErr(preInRes):
        return Err[bool]("smoke: preflight accept failed: " + Error(preInRes))
    var preOut: Connection = Value(preOutRes)
    var preIn: Connection = Value(preInRes)
    let prePayload: Bytes = BytesFromString("hi")
    let preWriteRes: Result[int32] = write(preOut, prePayload)
    if IsErr(preWriteRes):
        return Err[bool]("smoke: preflight write failed: " + Error(preWriteRes))
    let preReadRes: Result[Bytes] = read(preIn, BytesLen(prePayload))
    if IsErr(preReadRes):
        return Err[bool]("smoke: preflight read failed: " + Error(preReadRes))
    if ! BytesEqual(Value(preReadRes), prePayload):
        return Err[bool]("smoke: preflight payload mismatch")
    close(preOut)
    close(preIn)
    stop(preListener)

    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/66")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    var listener: MemoryTransport = initMemoryTransport()
    start(listener, addr)
    var dialer: MemoryTransport = initMemoryTransport()

    let outConnRes: Result[Connection] = dial(dialer, addr)
    if IsErr(outConnRes):
        return Err[bool](Error(outConnRes))
    let inConnRes: Result[Connection] = accept(listener)
    if IsErr(inConnRes):
        return Err[bool](Error(inConnRes))

    let outConn: Connection = Value(outConnRes)
    let inConn: Connection = Value(inConnRes)
    if inConn.pipeIdx != outConn.pipeIdx:
        return Err[bool]("smoke: out/in pipeIdx mismatch")
    if outConn.pipeSide != 0 || inConn.pipeSide != 1:
        return Err[bool]("smoke: out/in pipeSide mismatch")
    if outConn.pipeIdx < 0:
        return Err[bool]("smoke: outbound pipeIdx < 0")
    if outConn.pipeIdx >= pipeCount:
        return Err[bool]("smoke: outbound pipeIdx out of range")
    if pipes[outConn.pipeIdx].aToB.queue.count != 0 || pipes[outConn.pipeIdx].bToA.queue.count != 0:
        return Err[bool]("smoke: pipe queue not empty before muxer")

    var outMux: Muxer = newMuxer(outConn)
    if outMux.id < 0:
        return Err[bool]("smoke: outbound muxer alloc failed")
    if pipes[outConn.pipeIdx].aToB.queue.count != 0 || pipes[outConn.pipeIdx].bToA.queue.count != 0:
        return Err[bool]("smoke: pipe queue corrupted after newMuxer")
    var inMux: Muxer = newMuxer(inConn)
    if inMux.id < 0:
        return Err[bool]("smoke: inbound muxer alloc failed")
    let outMuxConn: Connection = muxerConnection(outMux)
    let inMuxConn: Connection = muxerConnection(inMux)
    if outMuxConn.pipeIdx != outConn.pipeIdx || inMuxConn.pipeIdx != inConn.pipeIdx:
        return Err[bool]("smoke: muxer connection pipeIdx mismatch")
    if outMuxConn.pipeSide != 0 || inMuxConn.pipeSide != 1:
        return Err[bool]("smoke: muxer connection pipeSide mismatch")

    let outStreamRes: Result[Stream] = openStream(outMux)
    if IsErr(outStreamRes):
        return Err[bool]("smoke: openStream failed: " + Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    if pipes[outConn.pipeIdx].aToB.queue.count <= 0:
        return Err[bool]("smoke: no data in pipe after openStream")
    if pipes[outConn.pipeIdx].bToA.queue.count != 0:
        return Err[bool]("smoke: unexpected data in reverse pipe after openStream")
    let inStreamRes: Result[Stream] = acceptStream(inMux)
    if IsErr(inStreamRes):
        return Err[bool]("smoke: acceptStream failed: " + Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)

    let payload: Bytes = BytesFromString("hello")
    let writeRes: Result[int32] = write(outStream, payload)
    if IsErr(writeRes):
        return Err[bool]("smoke: stream write failed: " + Error(writeRes))
    let readRes: Result[Bytes] = read(inStream, BytesLen(payload))
    if IsErr(readRes):
        return Err[bool]("smoke: stream read failed: " + Error(readRes))
    if ! BytesEqual(Value(readRes), payload):
        return Err[bool]("smoke: payload mismatch")

    closeStream(outStream)
    closeStream(inStream)
    stop(listener)
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runMuxerOpenStreamSmoke()
    if IsErr(res):
        echo("muxer openstream smoke failed: " + Error(res))
        return 1
    echo("muxer openstream smoke ok")
    return 0
