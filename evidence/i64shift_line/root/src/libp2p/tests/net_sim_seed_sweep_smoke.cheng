# net_sim 200-seed sweep gate: deterministic discrete-event simulator
# convergence over a wide seed space (v2 网络线 Wave 0 退出条件: net_sim_gate
# 200 seed PASS). Single compile + single run, internal loop over 200 seeds:
#   1. Reproducibility: runScenario(seed) twice -> identical fingerprint, all seeds.
#   2. Cross-seed diversity: distinct seeds yield mostly-distinct fingerprints
#      (collision count stays low; identical fingerprints across different seeds
#      would mean the LCG/event ordering ignores the seed).
#   3. Monotonic delivery: fingerprintDeliveries() never returns -1 (heap order
#      violation sentinel) for any seed.
# Mirrors net_sim_core_smoke's runScenario shape (three lossy/jittery links,
# 120 round-robin messages).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/sim/net_sim

fn payloadFor(i: int32): Bytes =
    var out: Bytes = BytesAlloc(4)
    BytesSet(out, 0, i & 255)
    BytesSet(out, 1, (i >> 8) & 255)
    BytesSet(out, 2, (i >> 16) & 255)
    BytesSet(out, 3, (i >> 24) & 255)
    return out

fn fpMix(h: int64, v: int64): int64 =
    return (h * 1000003 + (v & 1073741823)) & 1073741823

# Returns -1 when delivery times regress (heap order violation).
fn fingerprintDeliveries(): int64 =
    var h: int64
    var lastTime: int64
    var d: net_sim.SimDelivery
    while SimNextDeliveryGlobal(d):
        if d.time < lastTime:
            return -1
        lastTime = d.time
        h = fpMix(h, d.time)
        h = fpMix(h, int64(d.src))
        h = fpMix(h, int64(d.dst))
        let plen: int32 = BytesLen(d.payload)
        h = fpMix(h, int64(plen))
        for j in 0..<plen:
            h = fpMix(h, int64(BytesGet(d.payload, j)))
    return h

# Three nodes, lossy + jittery directed links, 120 messages round-robin.
fn runScenario(seed: int64): int64 =
    SimNew(seed)
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    let c: int32 = SimAddNode()
    SimSetLink(a, b, 1000, 300, 100)
    SimSetLink(b, a, 900, 200, 50)
    SimSetLink(b, c, 1100, 400, 150)
    SimSetLink(c, a, 800, 250, 80)
    for i in 0..<120:
        if i % 3 == 0:
            SimSend(a, b, payloadFor(i))
        elif i % 3 == 1:
            SimSend(b, c, payloadFor(i))
        else:
            SimSend(c, a, payloadFor(i))
    SimRun()
    return fingerprintDeliveries()

# A small open-addressed fingerprint table to count cross-seed collisions
# without dynamic containers: linear-probe into a fixed 1024-slot array.
fn fpSlotEmpty(): int64 =
    return -2

fn main(): int32 =
    let nSeeds: int32 = 200
    let cap: int32 = 1024
    var table: int64[1024]
    for s in 0..<cap:
        table[s] = fpSlotEmpty()
    var collisions: int32 = 0
    var monotonicFail: int32 = 0
    var reproduceFail: int32 = 0
    for seed in 0..<nSeeds:
        let fpA: int64 = runScenario(int64(seed))
        let fpB: int64 = runScenario(int64(seed))
        if fpA != fpB:
            reproduceFail = reproduceFail + 1
        if fpA == -1:
            monotonicFail = monotonicFail + 1
        # Open-addressed insert; count a collision only when a *different*
        # seed already parked an identical fingerprint in the table.
        var slot: int32 = int32(fpA & 1023)
        if fpA < 0:
            slot = 0
        var probes: int32 = 0
        while probes < cap:
            if table[slot] == fpSlotEmpty():
                table[slot] = fpA
                probes = cap
            elif table[slot] == fpA:
                collisions = collisions + 1
                probes = cap
            else:
                slot = (slot + 1) & 1023
                probes = probes + 1
    if reproduceFail != 0:
        echo(Fmt"net_sim seed-sweep FAIL: {reproduceFail} seeds not reproducible")
        return 1
    if monotonicFail != 0:
        echo(Fmt"net_sim seed-sweep FAIL: {monotonicFail} seeds with heap-order violation")
        return 1
    # 200 seeds over a 30-bit fingerprint space: collisions must be near zero.
    # Allow a tiny slack but reject a seed-insensitive simulator (which would
    # collapse all 200 fingerprints onto a handful of values).
    if collisions > 4:
        echo(Fmt"net_sim seed-sweep FAIL: {collisions} cross-seed fingerprint collisions (seed ignored?)")
        return 1
    echo(Fmt"net_sim seed-sweep ok: 200 seeds reproducible + monotonic, collisions={collisions}")
    return 0
