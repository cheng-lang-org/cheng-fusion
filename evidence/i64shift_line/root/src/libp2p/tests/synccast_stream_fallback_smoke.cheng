# Synccast stream fallback smoke test(frame-per-stream).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
import cheng/libp2p/protocols/synccast/session
import cheng/libp2p/protocols/synccast/media
import cheng/libp2p/protocols/synccast/datagram
import cheng/libp2p/protocols/synccast/core
import cheng/libp2p/tests/test_multistream
import cheng/libp2p/tests/test_utils
const
    synccastFallbackSessionId: int64 = 88

fn runSynccastStreamFallbackSmoke(): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/57")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    var listener: MemoryTransport = initMemoryTransport()
    start(listener, addr)
    var dialer: MemoryTransport = initMemoryTransport()
    let outConnRes: Result[Connection] = dial(dialer, addr)
    if IsErr(outConnRes):
        return Err[bool](Error(outConnRes))
    let inConnRes: Result[Connection] = accept(listener)
    if IsErr(inConnRes):
        return Err[bool](Error(inConnRes))
    var outboundMux: Muxer = newMuxer(Value(outConnRes))
    if outboundMux.id < 0:
        return Err[bool]("smoke: outbound muxer alloc failed")
    var inboundMux: Muxer = newMuxer(Value(inConnRes))
    if inboundMux.id < 0:
        return Err[bool]("smoke: inbound muxer alloc failed")

    var cfg: SynccastSessionConfig = initSynccastSessionConfig()
    cfg.sessionId = synccastFallbackSessionId
    cfg.targetLatencyMs = 0
    cfg.maxPayloadBytes = 1100
    cfg.cryptoKey = fixedBytes(32, 7)
    cfg.keyId = 1
    var sender: SynccastSession = initSynccastSession(cfg)
    var receiver: SynccastSession = initSynccastSession(cfg)

    let nowUs: int64 = synccastNowUs()
    let audioPayload: Bytes = BytesFromString("fallback-audio")
    let videoPayload: Bytes = BytesFromString("fallback-video")

    # Audio frame stream
    let outAudioRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outAudioRes):
        return Err[bool](Error(outAudioRes))
    var outAudio: Stream = Value(outAudioRes)
    let inAudioRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inAudioRes):
        return Err[bool](Error(inAudioRes))
    var inAudio: Stream = Value(inAudioRes)
    let selAudioRes: Result[bool] = multistreamSelectPair(outAudio, inAudio, synccastMediaCodec)
    if IsErr(selAudioRes):
        return Err[bool](Error(selAudioRes))
    let audioHead: SynccastDatagramHeader = synccastSessionBuildHeader(sender, synccastTrackAudio, 0, 1, nowUs, nowUs, synccastFlagDiscardable | synccastFlagEndOfFrame)
    var audioBody: Bytes = audioPayload
    if sender.crypto.enabled:
        let encRes: Result[Bytes] = synccastEncryptPayload(sender.crypto, audioHead, audioPayload)
        if IsErr(encRes):
            return Err[bool](Error(encRes))
        audioBody = Value(encRes)
    let audioPkt: SynccastMediaPacket = SynccastMediaPacket(header: audioHead, payload: audioBody)
    let writeAudioRes: Result[bool] = writeSynccastMediaPacket(outAudio, audioPkt)
    if IsErr(writeAudioRes):
        return Err[bool](Error(writeAudioRes))
    sender.nextSeq = sender.nextSeq + 1
    let readAudioRes: Result[SynccastMediaPacket] = readSynccastMediaPacket(inAudio)
    if IsErr(readAudioRes):
        return Err[bool](Error(readAudioRes))
    let recvAudio: SynccastMediaPacket = Value(readAudioRes)
    var recvAudioBody: Bytes = recvAudio.payload
    if receiver.crypto.enabled:
        let decRes: Result[Bytes] = synccastDecryptPayload(receiver.crypto, recvAudio.header, recvAudioBody)
        if IsErr(decRes):
            return Err[bool](Error(decRes))
        recvAudioBody = Value(decRes)
    let handleAudioRes: Result[bool] = synccastSessionHandlePayload(receiver, recvAudio.header, recvAudioBody, synccastNowUs())
    if IsErr(handleAudioRes):
        return Err[bool](Error(handleAudioRes))
    if !Value(handleAudioRes):
        return Err[bool]("smoke: fallback audio not handled")
    let popAudioRes: Result[SynccastFrame] = synccastSessionPopFrame(receiver)
    if IsErr(popAudioRes):
        return Err[bool](Error(popAudioRes))
    let audioFrame: SynccastFrame = Value(popAudioRes)
    if audioFrame.header.trackId != synccastTrackAudio:
        return Err[bool]("smoke: fallback audio track mismatch")
    if !BytesEqual(audioFrame.payload, audioPayload):
        return Err[bool]("smoke: fallback audio payload mismatch")

    # Video frame stream
    let outVideoRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outVideoRes):
        return Err[bool](Error(outVideoRes))
    var outVideo: Stream = Value(outVideoRes)
    let inVideoRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inVideoRes):
        return Err[bool](Error(inVideoRes))
    var inVideo: Stream = Value(inVideoRes)
    let selVideoRes: Result[bool] = multistreamSelectPair(outVideo, inVideo, synccastMediaCodec)
    if IsErr(selVideoRes):
        return Err[bool](Error(selVideoRes))
    let videoPtsUs: int64 = nowUs + 20000
    let videoHead: SynccastDatagramHeader = synccastSessionBuildHeader(sender, synccastTrackVideo, 0, 2, videoPtsUs, videoPtsUs, synccastFlagKeyframe | synccastFlagEndOfFrame)
    var videoBody: Bytes = videoPayload
    if sender.crypto.enabled:
        let encRes: Result[Bytes] = synccastEncryptPayload(sender.crypto, videoHead, videoPayload)
        if IsErr(encRes):
            return Err[bool](Error(encRes))
        videoBody = Value(encRes)
    let videoPkt: SynccastMediaPacket = SynccastMediaPacket(header: videoHead, payload: videoBody)
    let writeVideoRes: Result[bool] = writeSynccastMediaPacket(outVideo, videoPkt)
    if IsErr(writeVideoRes):
        return Err[bool](Error(writeVideoRes))
    sender.nextSeq = sender.nextSeq + 1
    let readVideoRes: Result[SynccastMediaPacket] = readSynccastMediaPacket(inVideo)
    if IsErr(readVideoRes):
        return Err[bool](Error(readVideoRes))
    let recvVideo: SynccastMediaPacket = Value(readVideoRes)
    var recvVideoBody: Bytes = recvVideo.payload
    if receiver.crypto.enabled:
        let decRes: Result[Bytes] = synccastDecryptPayload(receiver.crypto, recvVideo.header, recvVideoBody)
        if IsErr(decRes):
            return Err[bool](Error(decRes))
        recvVideoBody = Value(decRes)
    let handleVideoRes: Result[bool] = synccastSessionHandlePayload(receiver, recvVideo.header, recvVideoBody, synccastNowUs())
    if IsErr(handleVideoRes):
        return Err[bool](Error(handleVideoRes))
    if !Value(handleVideoRes):
        return Err[bool]("smoke: fallback video not handled")
    let popVideoRes: Result[SynccastFrame] = synccastSessionPopFrame(receiver)
    if IsErr(popVideoRes):
        return Err[bool](Error(popVideoRes))
    let videoFrame: SynccastFrame = Value(popVideoRes)
    if videoFrame.header.trackId != synccastTrackVideo:
        return Err[bool]("smoke: fallback video track mismatch")
    if !BytesEqual(videoFrame.payload, videoPayload):
        return Err[bool]("smoke: fallback video payload mismatch")
    if (videoFrame.header.flags & synccastFlagKeyframe) == 0:
        return Err[bool]("smoke: fallback video keyframe missing")

    return Ok[bool](true)
