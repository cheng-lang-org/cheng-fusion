# Graphsync smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multicodec
import cheng/libp2p/multihash
import cheng/libp2p/cid
import cheng/libp2p/protocols/graphsync/protobuf as graphsyncprotobuf
import cheng/libp2p/protocols/graphsync/graphsync
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runGraphsyncSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/12")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let data: Bytes = BytesFromString("graphsync-smoke-data")
    let mhRes: Result[MultiHash] = Digest(data, codecSha2_256)
    if IsErr(mhRes):
        return Err[bool](Error(mhRes))
    let root: Cid = Cid(version: 1, codec: codecRaw, multihash: Value(mhRes))
    let putRes: Result[bool] = graphsyncPutBlock(root, data)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    let rootBytesRes: Result[Bytes] = cidToBytes(root)
    if IsErr(rootBytesRes):
        return Err[bool](Error(rootBytesRes))
    var req: GraphsyncRequest = initGraphsyncRequest()
    req.hasId = true
    req.id = 1
    req.hasRoot = true
    req.root = Value(rootBytesRes)
    var msg: GraphsyncMessage = initGraphsyncMessage()
    msg.requestCount = 1
    msg.requests[0] = req
    let writeRes: Result[bool] = writeGraphsyncMessage(outStream, msg)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = graphsyncHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let replyRes: Result[GraphsyncMessage] = readGraphsyncMessage(outStream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let reply: GraphsyncMessage = Value(replyRes)
    if reply.responseCount <= 0:
        return Err[bool]("smoke: graphsync response missing")
    if reply.responses[0].status != int32(gsrsRequestCompletedFull):
        return Err[bool]("smoke: graphsync status mismatch")
    if reply.responses[0].metadataCount <= 0:
        return Err[bool]("smoke: graphsync metadata missing")
    if reply.responses[0].metadata[0].action != gslaPresent:
        return Err[bool]("smoke: graphsync metadata action mismatch")
    if reply.blockCount <= 0:
        return Err[bool]("smoke: graphsync block missing")
    if ! BytesEqual(reply.blocks[0].data, data):
        return Err[bool]("smoke: graphsync block mismatch")
    let missingData: Bytes = BytesFromString("graphsync-missing")
    let missingMhRes: Result[MultiHash] = Digest(missingData, codecSha2_256)
    if IsErr(missingMhRes):
        return Err[bool](Error(missingMhRes))
    let missingCid: Cid = Cid(version: 1, codec: codecRaw, multihash: Value(missingMhRes))
    let missingRootRes: Result[Bytes] = cidToBytes(missingCid)
    if IsErr(missingRootRes):
        return Err[bool](Error(missingRootRes))
    var missingReq: GraphsyncRequest = initGraphsyncRequest()
    missingReq.hasId = true
    missingReq.id = 2
    missingReq.hasRoot = true
    missingReq.root = Value(missingRootRes)
    var missingMsg: GraphsyncMessage = initGraphsyncMessage()
    missingMsg.requestCount = 1
    missingMsg.requests[0] = missingReq
    let writeMissingRes: Result[bool] = writeGraphsyncMessage(outStream, missingMsg)
    if IsErr(writeMissingRes):
        return Err[bool](Error(writeMissingRes))
    let handleMissingRes: Result[bool] = graphsyncHandler(inStream)
    if IsErr(handleMissingRes):
        return Err[bool](Error(handleMissingRes))
    let missingReplyRes: Result[GraphsyncMessage] = readGraphsyncMessage(outStream)
    if IsErr(missingReplyRes):
        return Err[bool](Error(missingReplyRes))
    let missingReply: GraphsyncMessage = Value(missingReplyRes)
    if missingReply.responseCount <= 0:
        return Err[bool]("smoke: graphsync missing response absent")
    if missingReply.responses[0].status != int32(gsrsRequestFailedContentNotFound):
        return Err[bool]("smoke: graphsync missing status mismatch")
    if missingReply.responses[0].metadataCount <= 0:
        return Err[bool]("smoke: graphsync missing metadata absent")
    if missingReply.responses[0].metadata[0].action != gslaMissing:
        return Err[bool]("smoke: graphsync missing metadata action mismatch")
    var cancelReq: GraphsyncRequest = initGraphsyncRequest()
    cancelReq.hasId = true
    cancelReq.id = 3
    cancelReq.hasRoot = true
    cancelReq.root = Value(rootBytesRes)
    cancelReq.cancel = true
    var cancelMsg: GraphsyncMessage = initGraphsyncMessage()
    cancelMsg.requestCount = 1
    cancelMsg.requests[0] = cancelReq
    let writeCancelRes: Result[bool] = writeGraphsyncMessage(outStream, cancelMsg)
    if IsErr(writeCancelRes):
        return Err[bool](Error(writeCancelRes))
    let handleCancelRes: Result[bool] = graphsyncHandler(inStream)
    if IsErr(handleCancelRes):
        return Err[bool](Error(handleCancelRes))
    let cancelReplyRes: Result[GraphsyncMessage] = readGraphsyncMessage(outStream)
    if IsErr(cancelReplyRes):
        return Err[bool](Error(cancelReplyRes))
    let cancelReply: GraphsyncMessage = Value(cancelReplyRes)
    if cancelReply.responseCount <= 0:
        return Err[bool]("smoke: graphsync cancel response absent")
    if cancelReply.responses[0].status != int32(gsrsRequestCancelled):
        return Err[bool]("smoke: graphsync cancel status mismatch")
    return Ok[bool](true)
