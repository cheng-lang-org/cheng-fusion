# CoinJoin onion smoke test.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/coinjoin/types
import cheng/libp2p/crypto/coinjoin/onion
import cheng/libp2p/tests/test_utils
fn runCoinjoinOnionSmoke(): Result[bool] =
    let seedRes: CoinJoinResult[OnionSeed] = makeOnionSeed(fixedBytes(32, 5))
    if ! seedRes.ok:
        return ErrInfo[bool](seedRes.err)
    let payload: Bytes = BytesFromString("ok")
    let ctxRes: CoinJoinResult[OnionRouteCtx] = onion.initRouteCtx(seedRes.value, 1, "smoke", 1, payload)
    if ! ctxRes.ok:
        return ErrInfo[bool](ctxRes.err)
    let routeCtx: OnionRouteCtx = ctxRes.value
    let packetRes: CoinJoinResult[CoinJoinOnionPacket] = onion.toOnionPacket(routeCtx, 1)
    if ! packetRes.ok:
        return ErrInfo[bool](packetRes.err)
    let peelRes: CoinJoinResult[CoinJoinOnionPacket] =
        onion.peelOnionLayer(packetRes.value, hopSecretListGet(routeCtx.hopSecrets, 0))
    if ! peelRes.ok:
        return ErrInfo[bool](peelRes.err)
    if ! BytesEqual(peelRes.value.payload, payload):
        return Err[bool]("smoke: coinjoin onion payload mismatch")
    return Ok[bool](true)
