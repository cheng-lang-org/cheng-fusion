# Mobile real-device full-stack hard-gate runner.
#
# Gate scope:
# 1) LAN mDNS discovery
# 2) BLE proximity discovery
# 3) QUIC direct link
# 4) connection migration setting + reconnect
# 5) Push-to-Punch wakeup recovery
# 6) DM message
# 7) video call frame publish
# 8) synccast live frame publish
# 9) publish content + homepage access

import cheng/libp2p/mobile_ffi/unimaker_compat_ffi_real_smoke

fn hasToken(text: str, token: str): bool =
    return indexOf(text, token, 0) >= 0

fn main(): int32 =
    NimMain()

    let cfgA: str = "{\"dataDir\":\"/tmp/mobile_device_fullstack_gate_a\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4201/quic-v1\"}"
    let cfgB: str = "{\"dataDir\":\"/tmp/mobile_device_fullstack_gate_b\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4202/quic-v1\"}"

    let nodeA: int64 = libp2p_node_init(cfgA)
    if nodeA <= 0:
        return 11
    if libp2p_node_start(nodeA) != 0:
        return 12

    let nodeB: int64 = libp2p_node_init(cfgB)
    if nodeB <= 0:
        return 13
    if libp2p_node_start(nodeB) != 0:
        return 14

    let peerA: str = trimText(libp2p_get_local_peer_id(nodeA))
    let peerB: str = trimText(libp2p_get_local_peer_id(nodeB))
    if len(peerA) <= 0 || len(peerB) <= 0:
        return 15

    let dialableBJson: str = libp2p_get_dialable_addresses(nodeB)
    let dialableB: str[] = parseQuotedValues(dialableBJson)
    if len(dialableB) <= 0:
        return 16
    if !hasToken(dialableBJson, "/quic-v1"):
        return 17

    if !libp2p_mdns_set_enabled(nodeA, true):
        return 18
    if !libp2p_mdns_probe(nodeA):
        return 19
    let policyJson: str = "{\"bootstrap_peers\":" + dialableBJson + ",\"bootstrap_tick_seconds\":3,\"bootstrap_random_n\":1}"
    if !libp2p_bootstrap_set_policy(nodeA, policyJson):
        return 20
    let tickJson: str = libp2p_bootstrap_tick(nodeA)
    if !hasToken(tickJson, "\"ok\":true"):
        return 21
    echo("gate.mdns_discovery.ok")

    if !libp2p_ble_set_enabled(nodeA, true):
        return 22
    if !libp2p_ble_set_enabled(nodeB, true):
        return 23
    if !libp2p_ble_probe(nodeA):
        return 24
    if !libp2p_ble_probe(nodeB):
        return 25
    let bleStatusJson: str = libp2p_bootstrap_get_status(nodeA)
    if !hasToken(bleStatusJson, "\"hintCount\":1") || !hasToken(bleStatusJson, "\"bootstrapCount\":1"):
        return 26
    let bleEventsJson: str = libp2p_poll_events(nodeA, 8)
    if !hasToken(bleEventsJson, "\"topic\":\"ble.discovery.updated\"") || !hasToken(bleEventsJson, peerB):
        return 27
    echo("gate.ble_discovery.ok")

    if libp2p_connect_peer(nodeA, peerB) != 0:
        return 28
    if libp2p_connect_multiaddr(nodeA, dialableB[0]) != 0:
        return 29
    if !libp2p_is_peer_connected(nodeA, peerB):
        return 30
    echo("gate.quic_direct.ok")

    if !libp2p_set_msquic_settings(nodeA, "{\"allowDatagram\":true,\"maxDatagram\":1400,\"minimumMtu\":1200,\"maximumMtu\":1500,\"migrationEnabled\":true,\"ecnEnabled\":false}"):
        return 31
    let settingsJson: str = libp2p_get_msquic_settings(nodeA)
    if !hasToken(settingsJson, "\"migrationEnabled\":true"):
        return 32
    if libp2p_disconnect_peer(nodeA, peerB) != 0:
        return 33
    if libp2p_connect_multiaddr(nodeA, dialableB[0]) != 0:
        return 34
    if !libp2p_is_peer_connected(nodeA, peerB):
        return 35
    echo("gate.connection_migration.ok")

    if !libp2p_register_push_token(nodeB, "push-token-b"):
        return 36
    if !libp2p_mark_peer_hibernated(nodeA, peerB):
        return 37
    if !libp2p_notify_push_wakeup(nodeA, peerB):
        return 38
    if !libp2p_push_to_punch(nodeA, peerB):
        return 39
    if !libp2p_is_peer_connected(nodeA, peerB):
        return 40
    let pushStatusJson: str = libp2p_bootstrap_get_status(nodeA)
    if !hasToken(pushStatusJson, "\"pushQueuedCount\":1") || !hasToken(pushStatusJson, "\"pushWakeupCount\":1"):
        return 41
    if !hasToken(pushStatusJson, "\"pushRecoveredCount\":1") || !hasToken(pushStatusJson, "\"pushFailedCount\":0"):
        return 42
    let pushEventsJson: str = libp2p_poll_events(nodeA, 16)
    if !hasToken(pushEventsJson, "\"topic\":\"push_to_punch.queued\"") || !hasToken(pushEventsJson, "\"topic\":\"push_to_punch.wakeup\""):
        return 43
    if !hasToken(pushEventsJson, "\"topic\":\"push_to_punch.recovered\""):
        return 44
    echo("gate.push_to_punch.ok")

    if !libp2p_send_direct_text(nodeA, peerB, "dm-msg-1", "hello-dm", "", true, 3000):
        return 45
    echo("gate.dm_message.ok")

    if !libp2p_upsert_livestream_cfg(nodeA, "video-call", "{\"kind\":\"video-call\",\"codec\":\"h264\"}"):
        return 46
    let videoPayload: str = "frame-video-1"
    if !libp2p_publish_livestream_frame_ffi(nodeA, "video-call", videoPayload, int64(len(videoPayload))):
        return 47
    echo("gate.video_call.ok")

    if !libp2p_upsert_livestream_cfg(nodeA, "synccast-live", "{\"kind\":\"synccast\",\"codec\":\"h264\"}"):
        return 48
    let syncPayload: str = "frame-synccast-1"
    if !libp2p_publish_livestream_frame_ffi(nodeA, "synccast-live", syncPayload, int64(len(syncPayload))):
        return 49
    echo("gate.synccast_live.ok")

    if !libp2p_feed_subscribe_peer(nodeB, peerA):
        return 50
    if !libp2p_feed_publish_entry(nodeA, "{\"postId\":\"post-1\",\"content\":\"hello-homepage\"}"):
        return 51
    let feedSnapshot: str = libp2p_fetch_feed_snapshot(nodeB)
    if !hasToken(feedSnapshot, "post-1"):
        return 52
    if !hasToken(feedSnapshot, "hello-homepage"):
        return 53
    echo("gate.publish_homepage.ok")

    if libp2p_node_stop(nodeB) != 0:
        return 54
    libp2p_node_free(nodeB)

    if libp2p_node_stop(nodeA) != 0:
        return 55
    libp2p_node_free(nodeA)

    return 0
