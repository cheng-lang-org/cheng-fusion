# X.509 smoke test(RSA chain + SAN hostname match).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/transports/tls/x509
import cheng/libp2p/tests/x509_vectors
fn hexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return int32(c) - int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + int32(c) - int32('a')
    if c >= 'A' && c <= 'F':
        return 10 + int32(c) - int32('A')
    return -1

fn hexDecode(text: str): Result[Bytes] =
    if len(text) % 2 != 0:
        return Err[Bytes]("x509: hex length must be even")
    let out: Bytes = BytesAlloc(len(text) / 2)
    var i: int32
    while i < len(text): # cheng-syntax-policy: allow-counting-while
        let hi: int32 = hexValue(text[i])
        let lo: int32 = hexValue(text[i + 1])
        if hi < 0 || lo < 0:
            return Err[Bytes]("x509: invalid hex")
        BytesSet(out, i / 2, (hi << 4) | lo)
        i = i + 2
    return Ok[Bytes](out)

fn runX509Smoke(): Result[bool] =
    let rootDerRes: Result[Bytes] = hexDecode(x509RootHex)
    if IsErr(rootDerRes):
        return Err[bool](Error(rootDerRes))
    let leafDerRes: Result[Bytes] = hexDecode(x509LeafHex)
    if IsErr(leafDerRes):
        return Err[bool](Error(leafDerRes))
    var root: X509Certificate = initX509Certificate()
    let rootRes: Result[bool] = x509ParseCertificateInto(root, Value(rootDerRes))
    if IsErr(rootRes):
        return Err[bool](Error(rootRes))
    var leaf: X509Certificate = initX509Certificate()
    let leafRes: Result[bool] = x509ParseCertificateInto(leaf, Value(leafDerRes))
    if IsErr(leafRes):
        return Err[bool](Error(leafRes))
    var roots: X509CertList = initX509CertList()
    let addRes: Result[bool] = x509CertListAddDer(roots, Value(rootDerRes))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    var inters: X509CertList = initX509CertList()
    let now: int64 = leaf.notBefore + 60
    let chainRes: Result[bool] = x509VerifyChain(&leaf, &inters, &roots, now)
    if IsErr(chainRes):
        return Err[bool](Error(chainRes))
    if ! x509VerifyHostname(&leaf, "example.com"):
        return Err[bool]("x509: hostname match failed")
    if ! x509VerifyHostname(&leaf, "alt.example.com"):
        return Err[bool]("x509: alt hostname match failed")
    if x509VerifyHostname(&leaf, "bad.example.com"):
        return Err[bool]("x509: invalid hostname accepted")
    var tampered: X509Certificate = leaf
    let sigCopy: Bytes = BytesSlice(tampered.signature, 0, BytesLen(tampered.signature))
    BytesSet(sigCopy, 0, BytesGet(sigCopy, 0) ^ 1)
    tampered.signature = sigCopy
    let sigRes: Result[bool] = x509VerifySignature(&tampered, &root)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    if Value(sigRes):
        return Err[bool]("x509: tampered signature accepted")
    let pssRootDerRes: Result[Bytes] = hexDecode(x509PssRootHex)
    if IsErr(pssRootDerRes):
        return Err[bool](Error(pssRootDerRes))
    let pssLeafDerRes: Result[Bytes] = hexDecode(x509PssLeafHex)
    if IsErr(pssLeafDerRes):
        return Err[bool](Error(pssLeafDerRes))
    var pssRoot: X509Certificate = initX509Certificate()
    let pssRootRes: Result[bool] = x509ParseCertificateInto(pssRoot, Value(pssRootDerRes))
    if IsErr(pssRootRes):
        return Err[bool](Error(pssRootRes))
    var pssLeaf: X509Certificate = initX509Certificate()
    let pssLeafRes: Result[bool] = x509ParseCertificateInto(pssLeaf, Value(pssLeafDerRes))
    if IsErr(pssLeafRes):
        return Err[bool](Error(pssLeafRes))
    var pssRoots: X509CertList = initX509CertList()
    let addPssRes: Result[bool] = x509CertListAddDer(pssRoots, Value(pssRootDerRes))
    if IsErr(addPssRes):
        return Err[bool](Error(addPssRes))
    var pssInters: X509CertList = initX509CertList()
    let pssNow: int64 = pssLeaf.notBefore + 60
    let pssChainRes: Result[bool] = x509VerifyChain(&pssLeaf, &pssInters, &pssRoots, pssNow)
    if IsErr(pssChainRes):
        return Err[bool](Error(pssChainRes))
    if ! x509VerifyHostname(&pssLeaf, "pss.example.com"):
        return Err[bool]("x509: pss hostname match failed")
    if ! x509VerifyHostname(&pssLeaf, "alt.pss.example.com"):
        return Err[bool]("x509: pss alt hostname match failed")
    if x509VerifyHostname(&pssLeaf, "bad.pss.example.com"):
        return Err[bool]("x509: pss invalid hostname accepted")
    return Ok[bool](true)
