# Mobile push-to-punch smoke runner.

import cheng/libp2p/mobile_ffi/unimaker_compat_ffi_real_smoke

fn hasToken(text: str, token: str): bool =
    return indexOf(text, token, 0) >= 0

fn runMobilePushToPunchSmoke(): int32 =
    NimMain()

    let cfgA: str = "{\"dataDir\":\"/tmp/mobile_push_to_punch_a\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4401/quic-v1\"}"
    let cfgB: str = "{\"dataDir\":\"/tmp/mobile_push_to_punch_b\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4402/quic-v1\"}"

    let nodeA: int64 = libp2p_node_init(cfgA)
    if nodeA <= 0:
        return 11
    let nodeB: int64 = libp2p_node_init(cfgB)
    if nodeB <= 0:
        return 12

    if libp2p_node_start(nodeA) != 0:
        return 13
    if libp2p_node_start(nodeB) != 0:
        return 14

    let peerB: str = trimText(libp2p_get_local_peer_id(nodeB))
    if len(peerB) <= 0:
        return 15

    if !libp2p_register_push_token(nodeB, "push-token-b"):
        return 16
    if !libp2p_mark_peer_hibernated(nodeA, peerB):
        return 17
    if !libp2p_notify_push_wakeup(nodeA, peerB):
        return 18
    if !libp2p_push_to_punch(nodeA, peerB):
        return 19
    if !libp2p_is_peer_connected(nodeA, peerB):
        return 20
    let pushStatusA: str = libp2p_bootstrap_get_status(nodeA)
    if !hasToken(pushStatusA, "\"pushQueuedCount\":1") || !hasToken(pushStatusA, "\"pushWakeupCount\":1"):
        return 21
    if !hasToken(pushStatusA, "\"pushRecoveredCount\":1") || !hasToken(pushStatusA, "\"pushFailedCount\":0"):
        return 22
    let pushEventsA: str = libp2p_poll_events(nodeA, 16)
    if !hasToken(pushEventsA, "\"topic\":\"push_to_punch.queued\""):
        return 23
    if !hasToken(pushEventsA, "\"topic\":\"push_to_punch.wakeup\""):
        return 24
    if !hasToken(pushEventsA, "\"topic\":\"push_to_punch.recovered\""):
        return 25

    if libp2p_node_stop(nodeB) != 0:
        return 26
    libp2p_node_free(nodeB)
    if libp2p_node_stop(nodeA) != 0:
        return 27
    libp2p_node_free(nodeA)
    return 0

fn main(): int32 =
    return runMobilePushToPunchSmoke()
