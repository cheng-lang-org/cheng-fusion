# Peer ID auth smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/peeridauth/client
import cheng/libp2p/peerid
fn runPeerIdAuthSmoke(): Result[bool] =
    let pidRes: Result[PeerId] = randomPeerId()
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    let pid: PeerId = Value(pidRes)
    let pidText: str = toString(pid)
    var client: PeerIdAuthClient = initPeerIdAuthClient()
    let addRes: Result[bool] = peerIdAuthAdd(client, pidText)
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    let okRes: Result[bool] = peerIdAuthCheck(client, pidText)
    if IsErr(okRes):
        return Err[bool](Error(okRes))
    if ! Value(okRes):
        return Err[bool]("smoke: peer ! authorized")
    return Ok[bool](true)
