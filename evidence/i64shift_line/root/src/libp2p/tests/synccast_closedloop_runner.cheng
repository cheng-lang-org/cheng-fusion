# Synccast closed-loop runner(mDNS -> QUIC direct -> DM -> Synccast -> Livestream + migration sanity).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/dm_envelope_smoke
import cheng/libp2p/tests/node_resource_sync_smoke
import cheng/libp2p/tests/mdns_host_synccast_call_smoke
import cheng/quic/tests/test_connection_migration
fn runSynccastClosedLoop(): Result[bool] =
    let nodeRes: Result[bool] = runNodeResourceSyncSmoke()
    if IsErr(nodeRes):
        return nodeRes
    let dmEnvRes: Result[bool] = runDmEnvelopeSmoke()
    if IsErr(dmEnvRes):
        return dmEnvRes
    let migRes: Result[bool] = runConnectionMigrationTest()
    if IsErr(migRes):
        return migRes
    let closedRes: Result[bool] = runMdnsHostSynccastCallSmoke()
    if IsErr(closedRes):
        return closedRes
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runSynccastClosedLoop()
    if IsErr(res):
        echo("synccast closed-loop failed")
        echo(Error(res))
        return 1
    echo("synccast closed-loop ok")
    return 0
