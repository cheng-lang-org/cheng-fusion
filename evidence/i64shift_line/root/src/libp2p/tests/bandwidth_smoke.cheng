# Bandwidth manager smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/bandwidthmanager
fn runBandwidthSmoke(): Result[bool] =
    var cfg: bandwidthmanager.BandwidthConfig = bandwidthmanager.initBandwidthConfig()
    cfg.maxInbound = 10
    cfg.maxOutbound = 10
    bandwidthmanager.setBandwidthConfig(cfg)
    bandwidthmanager.resetBandwidthStats()
    let inRes: Result[bool] = bandwidthmanager.recordInbound(5)
    if IsErr(inRes):
        return Err[bool](Error(inRes))
    let outRes: Result[bool] = bandwidthmanager.recordOutbound(6)
    if IsErr(outRes):
        return Err[bool](Error(outRes))
    if bandwidthmanager.bandwidthInboundTotal() != 5:
        return Err[bool]("smoke: inbound total mismatch")
    if bandwidthmanager.bandwidthOutboundTotal() != 6:
        return Err[bool]("smoke: outbound total mismatch")
    let overRes: Result[bool] = bandwidthmanager.recordInbound(6)
    if IsOk(overRes):
        return Err[bool]("smoke: inbound limit ! enforced")
    return Ok[bool](true)
