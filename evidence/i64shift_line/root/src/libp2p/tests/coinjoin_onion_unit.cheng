# CoinJoin onion unit tests.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/crypto/coinjoin/types
import cheng/libp2p/crypto/coinjoin/onion
import cheng/libp2p/tests/test_utils
fn isAllZero(data: Bytes): bool =
    if BytesLen(data) <= 0:
        return true
    for i in 0..<BytesLen(data):
        if BytesGet(data, i) != 0:
            return false
    return true

fn runCoinjoinOnionUnit(): Result[bool] =
    let seedRes: CoinJoinResult[OnionSeed] = makeOnionSeed(fixedBytes(32, 7))
    if ! seedRes.ok:
        return ErrInfo[bool](seedRes.err)
    let seed: OnionSeed = seedRes.value
    let secretsRes: CoinJoinResult[HopSecretList] = onion.deriveHopSecrets(seed, 1, "alice", 2)
    if ! secretsRes.ok:
        return ErrInfo[bool](secretsRes.err)
    let secrets: HopSecretList = secretsRes.value
    if hopSecretListCount(secrets) != 2:
        return Err[bool]("unit: hop secret count mismatch")
    let firstSecret: OnionSecret = hopSecretListGet(secrets, 0)
    if BytesLen(firstSecret) != coinJoinScalarSize || isAllZero(firstSecret):
        return Err[bool]("unit: hop secret invalid")

    let transcript: Bytes = BytesFromString("tx")
    let proofRes: CoinJoinResult[OnionProof] = onion.onionProof(secrets, transcript)
    if ! proofRes.ok:
        return ErrInfo[bool](proofRes.err)
    let proofRes2: CoinJoinResult[OnionProof] = onion.onionProof(secrets, transcript)
    if ! proofRes2.ok:
        return ErrInfo[bool](proofRes2.err)
    if ! BytesEqual(proofRes2.value, proofRes.value):
        return Err[bool]("unit: onion proof verify failed")

    let payload: Bytes = BytesFromString("data")
    let ctxRes: CoinJoinResult[OnionRouteCtx] = onion.initRouteCtx(seed, 2, "bob", 1, payload)
    if ! ctxRes.ok:
        return ErrInfo[bool](ctxRes.err)
    let routeCtx: OnionRouteCtx = ctxRes.value
    let packetRes: CoinJoinResult[CoinJoinOnionPacket] = onion.toOnionPacket(routeCtx, 7)
    if ! packetRes.ok:
        return ErrInfo[bool](packetRes.err)
    let peeledRes: CoinJoinResult[CoinJoinOnionPacket] =
        onion.peelOnionLayer(packetRes.value, hopSecretListGet(routeCtx.hopSecrets, 0))
    if ! peeledRes.ok:
        return ErrInfo[bool](peeledRes.err)
    if ! BytesEqual(peeledRes.value.payload, payload):
        return Err[bool]("unit: onion peel payload mismatch")
    return Ok[bool](true)
