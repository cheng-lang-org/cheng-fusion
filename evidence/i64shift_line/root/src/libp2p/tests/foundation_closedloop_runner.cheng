# Foundation closed-loop runner(real path).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_closedloop_runner
import cheng/libp2p/tests/mdns_host_synccast_call_smoke
fn runFoundationClosedLoop(): Result[bool] =
    let synccastRes: Result[bool] = runSynccastClosedLoop()
    if IsErr(synccastRes):
        return Err[bool]("foundation_closedloop: synccast: " + Error(synccastRes))
    let hostRes: Result[bool] = runMdnsHostSynccastCallSmoke()
    if IsErr(hostRes):
        return Err[bool]("foundation_closedloop: host_call: " + Error(hostRes))
    return Ok[bool](true)

fn main(): int32 =
    let runRes: Result[bool] = runFoundationClosedLoop()
    if IsErr(runRes):
        echo("foundation closed-loop failed")
        echo(Error(runRes))
        return 1
    echo("foundation closed-loop ok")
    return 0
