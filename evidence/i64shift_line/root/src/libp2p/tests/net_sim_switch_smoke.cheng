# net_sim transport smoke (Wave 0 batch 4): real libp2p QUIC transport
# dial/accept over /sim/ multiaddrs on the deterministic simulator.
#
# The Switch/builders/muxer stack is not compilable by the current stage3
# typed gate (pre-existing: unqualified imported record types classify as
# SLOT_VARIANT, muxer global-seq field reads fail to lower), so this smoke
# exercises the deepest compilable real path: qaddr /sim/ parsing ->
# msquictransport_native start/dial/accept sim branches -> SimAddNode /
# SimPipeOpen -> qconn.newSimConnectionPairForStreams, then the same
# multistream select negotiation the Switch upgrade performs at this
# layer (libp2p/transports/quic_transport helpers).
#
# 1. Two transport endpoints listen on /sim/1 and /sim/2, dial/accept
#    through the transport (not hand-built pairs); 20ms links: the
#    multistream request lands at exactly 20000us virtual time, the echo
#    at 40000us, payload exchanges at 60000/80000us.
# 2. Multistream select (gossipsub wire protocol) over the sim link is
#    byte-exact in both directions.
# 3. Two extra explicit-id stream pairs (4,4,4,4)/(9,9,9,9) on the dialed
#    pipe (the native quic_multistream_smoke shape) carry interleaved
#    chunked writes, per-stream FIFO byte-exact.
# 4. ConnClose propagates to the accepted endpoint; dialing a stopped
#    listener fails loudly.
# 5. Same seed -> identical rolling fingerprint (run twice in-process and
#    pinned for cross-process stability); different seed differs.

import std/result
import std/rawbytes
import cheng/quic/multiaddress as qaddr
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/core/multistream as lpms
import cheng/libp2p/transports/quic_transport
import cheng/libp2p/sim/net_sim
import cheng/libp2p/sim/net_sim_pipe as simpipe

const
    netSimSwitchPinnedFp = 138564126

fn genData(tag: int32, total: int32): Bytes =
    var out: Bytes = BytesAlloc(total)
    for i in 0..<total:
        BytesSet(out, i, (tag * 29 + i * 7 + 3) & 255)
    return out

fn fpMix(h: int64, v: int64): int64 =
    return (h * 1000003 + (v & 1073741823)) & 1073741823

fn fpMixBytes(h: int64, data: Bytes): int64 =
    var acc: int64 = h
    for i in 0..<BytesLen(data):
        acc = fpMix(acc, int64(BytesGet(data, i)))
    return acc

# Interleaved chunked writes on two explicit-id streams of one pipe side.
fn writeInterleaved(client4: var qconn.Connection, dataA: Bytes, client9: var qconn.Connection, dataB: Bytes): int32 =
    var offA: int32
    var offB: int32
    var k: int32
    let totalA: int32 = BytesLen(dataA)
    let totalB: int32 = BytesLen(dataB)
    while offA < totalA || offB < totalB:
        var pickA: bool = (k & 1) == 0
        if offA >= totalA:
            pickA = false
        if offB >= totalB:
            pickA = true
        if pickA:
            var n: int32 = k % 7 + 1
            if n > totalA - offA:
                n = totalA - offA
            let res: Result[int32] = qconn.connWrite(client4, BytesSlice(dataA, offA, n))
            if IsErr(res) || Value(res) != n:
                echo("netsim switch FAIL: interleaved write stream4")
                return 1
            offA = offA + n
        else:
            var n: int32 = k % 4 + 2
            if n > totalB - offB:
                n = totalB - offB
            let res: Result[int32] = qconn.connWrite(client9, BytesSlice(dataB, offB, n))
            if IsErr(res) || Value(res) != n:
                echo("netsim switch FAIL: interleaved write stream9")
                return 1
            offB = offB + n
        k = k + 1
    return 0

fn readCompare(conn: var qconn.Connection, expected: Bytes, fp: var int64): int32 =
    var off: int32
    var k: int32
    let total: int32 = BytesLen(expected)
    while off < total:
        var n: int32 = k % 5 + 1
        if n > total - off:
            n = total - off
        let res: Result[Bytes] = qconn.connRead(conn, n)
        if IsErr(res):
            let err: str = ErrorText(res)
            echo(Fmt"netsim switch FAIL: readCompare err {err}")
            return 1
        let got: Bytes = Value(res)
        if BytesLen(got) != n:
            echo("netsim switch FAIL: readCompare short read")
            return 1
        if ! BytesEqual(got, BytesSlice(expected, off, n)):
            echo(Fmt"netsim switch FAIL: readCompare mismatch off={off} n={n}")
            return 1
        fp = fpMixBytes(fp, got)
        off = off + n
        k = k + 1
    return 0

# Full transport-over-sim scenario; returns the rolling fingerprint or -1.
fn runScenario(seed: int64): int64 =
    SimNew(seed)
    simpipe.SimPipeReset()
    qtransport.MsQuicSimNetReset()
    var fp: int64 = seed & 1073741823
    let addrARes: Result[qaddr.MultiAddress] = qaddr.parseMultiAddress("/sim/1")
    if IsErr(addrARes):
        echo("netsim switch FAIL: parse /sim/1")
        return -1
    let addrBRes: Result[qaddr.MultiAddress] = qaddr.parseMultiAddress("/sim/2")
    if IsErr(addrBRes):
        echo("netsim switch FAIL: parse /sim/2")
        return -1
    let addrA: qaddr.MultiAddress = Value(addrARes)
    let addrB: qaddr.MultiAddress = Value(addrBRes)
    var listenerA = qtransport.InitMsQuicTransport()
    qtransport.start(listenerA, addrA)
    if ! listenerA.running:
        echo("netsim switch FAIL: listener A start")
        return -1
    var listenerB = qtransport.InitMsQuicTransport()
    qtransport.start(listenerB, addrB)
    if ! listenerB.running:
        echo("netsim switch FAIL: listener B start")
        return -1
    let nodeA: int32 = qtransport.MsQuicSimNodeForAddrNum(1)
    let nodeB: int32 = qtransport.MsQuicSimNodeForAddrNum(2)
    if nodeA < 0 || nodeB < 0:
        echo("netsim switch FAIL: node registry")
        return -1
    SimSetLink(nodeA, nodeB, 20000, 0, 0)
    SimSetLink(nodeB, nodeA, 20000, 0, 0)
    let dialRes: Result[qconn.Connection] = qtransport.dial(listenerA, addrB)
    if IsErr(dialRes):
        let err: str = ErrorText(dialRes)
        echo(Fmt"netsim switch FAIL: dial {err}")
        return -1
    var outConn = Value(dialRes)
    let acceptRes: Result[qconn.Connection] = qtransport.accept(listenerB)
    if IsErr(acceptRes):
        let err: str = ErrorText(acceptRes)
        echo(Fmt"netsim switch FAIL: accept {err}")
        return -1
    var inConn = Value(acceptRes)
    if SimNow() != 0:
        echo("netsim switch FAIL: clock not zero after dial/accept")
        return -1
    # Multistream select negotiation over the 20ms sim link (the same
    # request/echo exchange the Switch upgrade drives at this layer).
    let selectBytes: Bytes = lpms.Libp2pMultistreamSelectBytes(4)
    let writeSelRes: Result[bool] = quic_transport.Libp2pQuicWriteExact(listenerA, outConn, selectBytes)
    if IsErr(writeSelRes):
        let err: str = ErrorText(writeSelRes)
        echo(Fmt"netsim switch FAIL: multistream request write {err}")
        return -1
    let serverSelRes: Result[bool] = quic_transport.Libp2pQuicServerSelectProtocol(listenerB, inConn, 4)
    if IsErr(serverSelRes):
        let err: str = ErrorText(serverSelRes)
        echo(Fmt"netsim switch FAIL: multistream responder {err}")
        return -1
    if SimNow() != 20000:
        let t: int64 = SimNow()
        echo(Fmt"netsim switch FAIL: request virtual time {t} != 20000")
        return -1
    let echoRes: Result[Bytes] = quic_transport.Libp2pQuicReadExact(listenerA, outConn, BytesLen(selectBytes))
    if IsErr(echoRes):
        echo("netsim switch FAIL: multistream echo read")
        return -1
    if ! lpms.Libp2pMultistreamAccepts(Value(echoRes), 4):
        echo("netsim switch FAIL: multistream echo mismatch")
        return -1
    if SimNow() != 40000:
        let t: int64 = SimNow()
        echo(Fmt"netsim switch FAIL: echo virtual time {t} != 40000")
        return -1
    fp = fpMixBytes(fp, Value(echoRes))
    echo("netsim switch ok 1: dial/accept + multistream select at exact 20ms steps")
    # Bidirectional payload on the negotiated connection (stream ids 0/1).
    let fwd: Bytes = genData(1, 113)
    let writeFwdRes: Result[bool] = quic_transport.Libp2pQuicWriteExact(listenerA, outConn, fwd)
    if IsErr(writeFwdRes):
        echo("netsim switch FAIL: forward write")
        return -1
    let readFwdRes: Result[Bytes] = quic_transport.Libp2pQuicReadExact(listenerB, inConn, BytesLen(fwd))
    if IsErr(readFwdRes):
        echo("netsim switch FAIL: forward read")
        return -1
    if ! BytesEqual(Value(readFwdRes), fwd):
        echo("netsim switch FAIL: forward bytes mismatch")
        return -1
    if SimNow() != 60000:
        let t: int64 = SimNow()
        echo(Fmt"netsim switch FAIL: forward virtual time {t} != 60000")
        return -1
    fp = fpMixBytes(fp, Value(readFwdRes))
    let rev: Bytes = genData(2, 89)
    let writeRevRes: Result[bool] = quic_transport.Libp2pQuicWriteExact(listenerB, inConn, rev)
    if IsErr(writeRevRes):
        echo("netsim switch FAIL: reverse write")
        return -1
    let readRevRes: Result[Bytes] = quic_transport.Libp2pQuicReadExact(listenerA, outConn, BytesLen(rev))
    if IsErr(readRevRes):
        echo("netsim switch FAIL: reverse read")
        return -1
    if ! BytesEqual(Value(readRevRes), rev):
        echo("netsim switch FAIL: reverse bytes mismatch")
        return -1
    if SimNow() != 80000:
        let t: int64 = SimNow()
        echo(Fmt"netsim switch FAIL: reverse virtual time {t} != 80000")
        return -1
    fp = fpMixBytes(fp, Value(readRevRes))
    echo("netsim switch ok 2: bidirectional payload byte-exact at 60/80ms")
    # Explicit-id multi-stream pairs on the dialed pipe (native shape).
    let pair4Res = qconn.newSimConnectionPairForStreams(addrA, addrB, addrB, addrA, outConn.pipeIdx, 4, 4, 4, 4)
    if IsErr(pair4Res):
        echo("netsim switch FAIL: stream4 pair")
        return -1
    var client4 = Value(pair4Res).outbound
    var server4 = Value(pair4Res).inbound
    let pair9Res = qconn.newSimConnectionPairForStreams(addrA, addrB, addrB, addrA, outConn.pipeIdx, 9, 9, 9, 9)
    if IsErr(pair9Res):
        echo("netsim switch FAIL: stream9 pair")
        return -1
    var client9 = Value(pair9Res).outbound
    var server9 = Value(pair9Res).inbound
    let fwd4: Bytes = genData(3, 137)
    let fwd9: Bytes = genData(4, 101)
    if writeInterleaved(client4, fwd4, client9, fwd9) != 0:
        return -1
    if readCompare(server4, fwd4, fp) != 0:
        return -1
    if readCompare(server9, fwd9, fp) != 0:
        return -1
    let rev4: Bytes = genData(5, 53)
    let writeRev4Res: Result[int32] = qconn.connWrite(server4, rev4)
    if IsErr(writeRev4Res) || Value(writeRev4Res) != BytesLen(rev4):
        echo("netsim switch FAIL: reverse write stream4")
        return -1
    if readCompare(client4, rev4, fp) != 0:
        return -1
    echo("netsim switch ok 3: explicit-id multi-stream FIFO byte-exact")
    # Close propagation + dial-after-stop must fail loudly.
    if ! qconn.connIsOpen(outConn) || ! qconn.connIsOpen(inConn):
        echo("netsim switch FAIL: conns not open before close")
        return -1
    qconn.ConnClose(outConn)
    if qconn.connIsOpen(inConn):
        echo("netsim switch FAIL: close did not propagate")
        return -1
    qtransport.Stop(listenerB)
    let dialStoppedRes: Result[qconn.Connection] = qtransport.dial(listenerA, addrB)
    if ! IsErr(dialStoppedRes):
        echo("netsim switch FAIL: dial to stopped listener succeeded")
        return -1
    if ErrorText(dialStoppedRes) != "msquic sim: listener stopped":
        let err: str = ErrorText(dialStoppedRes)
        echo(Fmt"netsim switch FAIL: stopped-dial error mismatch {err}")
        return -1
    qtransport.Stop(listenerA)
    echo("netsim switch ok 4: close propagation + stopped-listener dial rejected")
    fp = fpMix(fp, SimNow())
    fp = fpMix(fp, SimDeliveredCount())
    return fp

fn main(): int32 =
    let fpA: int64 = runScenario(33)
    if fpA < 0:
        return 1
    let fpB: int64 = runScenario(33)
    if fpB < 0:
        return 1
    let fpC: int64 = runScenario(34)
    if fpC < 0:
        return 1
    echo(Fmt"netsim switch fingerprint seed33a={fpA} seed33b={fpB} seed34={fpC}")
    if fpA != fpB:
        echo("netsim switch FAIL: same-seed fingerprint mismatch")
        return 1
    if fpA == fpC:
        echo("netsim switch FAIL: different-seed fingerprint identical")
        return 1
    if fpA != netSimSwitchPinnedFp:
        echo("netsim switch FAIL: seed33 fingerprint drifted from pinned")
        return 1
    echo("netsim switch ok 5: deterministic fingerprint (pinned)")
    echo("netsim switch smoke: all 5 checks passed")
    return 0
