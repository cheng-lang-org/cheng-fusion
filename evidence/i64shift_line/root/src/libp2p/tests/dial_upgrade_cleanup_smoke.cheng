# Dial upgrade cleanup smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/multiaddress
import cheng/libp2p/upgrademngrs/upgrade
import cheng/libp2p/dial
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/transports/tcptransport
import cheng/libp2p/transports/wstransport
import cheng/libp2p/transports/webrtcdirecttransport
import cheng/libp2p/transports/webrtcstartransport
import cheng/libp2p/transports/tortransport
import cheng/quic/msquictransport
import cheng/libp2p/transports/memorymanager
fn runDialUpgradeCleanupSmoke(): Result[bool] =
    var cfg: TransportMemoryConfig = initTransportMemoryConfig()
    cfg.enabled = true
    cfg.limitBytes = 0
    setTransportMemoryConfig(cfg)
    resetTransportMemoryStats()
    var up: Upgrade = initUpgrade()
    var d: Dial = initDial()
    setUpgrade(d, up)

    let memAddrRes: Result[MultiAddress] = parseMultiAddress("/memory/1")
    if IsErr(memAddrRes):
        return Err[bool](Error(memAddrRes))
    let memAddr: MultiAddress = Value(memAddrRes)
    var mem: MemoryTransport = initMemoryTransport()
    start(mem, memAddr)
    addMemoryTransport(d, mem)
    let memMuxRes: Result[Muxer] = dialAndUpgrade(d, memAddr)
    if ! IsErr(memMuxRes):
        return Err[bool]("smoke: expected memory upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: memory pending queue ! released")
    let memAcceptRes: Result[Connection] = accept(mem)
    if ! IsErr(memAcceptRes):
        return Err[bool]("smoke: memory pending connection ! dropped")
    stop(mem)
    resetTransportMemoryStats()

    let tcpAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4001")
    if IsErr(tcpAddrRes):
        return Err[bool](Error(tcpAddrRes))
    let tcpAddr: MultiAddress = Value(tcpAddrRes)
    var tcp: TcpTransport = initTcpTransport()
    start(tcp, tcpAddr)
    addTcpTransport(d, tcp)
    let tcpMuxRes: Result[Muxer] = dialAndUpgrade(d, tcpAddr)
    if ! IsErr(tcpMuxRes):
        return Err[bool]("smoke: tcp expected upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: tcp pending queue ! released")
    let tcpAcceptRes: Result[Connection] = accept(tcp)
    if ! IsErr(tcpAcceptRes):
        return Err[bool]("smoke: tcp pending connection ! dropped")
    stop(tcp)
    resetTransportMemoryStats()

    let wsAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4002/ws")
    if IsErr(wsAddrRes):
        return Err[bool](Error(wsAddrRes))
    let wsAddr: MultiAddress = Value(wsAddrRes)
    var ws: WsTransport = initWsTransport()
    start(ws, wsAddr)
    addWsTransport(d, ws)
    let wsMuxRes: Result[Muxer] = dialAndUpgrade(d, wsAddr)
    if ! IsErr(wsMuxRes):
        return Err[bool]("smoke: ws expected upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: ws pending queue ! released")
    let wsAcceptRes: Result[Connection] = accept(ws)
    if ! IsErr(wsAcceptRes):
        return Err[bool]("smoke: ws pending connection ! dropped")
    stop(ws)
    resetTransportMemoryStats()

    let quicAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4003/quic")
    if IsErr(quicAddrRes):
        return Err[bool](Error(quicAddrRes))
    let quicAddr: MultiAddress = Value(quicAddrRes)
    var quicMsquic: MsQuicTransport = initMsQuicTransport()
    start(quicMsquic, quicAddr)
    addMsQuicTransport(d, quicMsquic)
    let quicMuxRes: Result[Muxer] = dialAndUpgrade(d, quicAddr)
    if ! IsErr(quicMuxRes):
        return Err[bool]("smoke: quic alias expected upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: quic alias pending queue ! released")
    let quicAcceptRes: Result[Connection] = accept(quicMsquic)
    if ! IsErr(quicAcceptRes):
        return Err[bool]("smoke: quic alias pending connection ! dropped")
    stop(quicMsquic)
    resetTransportMemoryStats()

    let opensslAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4004/quic-v1/tls")
    if IsErr(opensslAddrRes):
        return Err[bool](Error(opensslAddrRes))
    let opensslAddr: MultiAddress = Value(opensslAddrRes)
    var opensslMsquic: MsQuicTransport = initMsQuicTransport()
    start(opensslMsquic, opensslAddr)
    addMsQuicTransport(d, opensslMsquic)
    let opensslMuxRes: Result[Muxer] = dialAndUpgrade(d, opensslAddr)
    if ! IsErr(opensslMuxRes):
        return Err[bool]("smoke: quic-v1/tls alias expected upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: quic-v1/tls alias pending queue ! released")
    let opensslAcceptRes: Result[Connection] = accept(opensslMsquic)
    if ! IsErr(opensslAcceptRes):
        return Err[bool]("smoke: quic-v1/tls alias pending connection ! dropped")
    stop(opensslMsquic)
    resetTransportMemoryStats()

    let webrtcDirectAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4005/webrtc-direct")
    if IsErr(webrtcDirectAddrRes):
        return Err[bool](Error(webrtcDirectAddrRes))
    let webrtcDirectAddr: MultiAddress = Value(webrtcDirectAddrRes)
    var webrtcDirect: WebrtcDirectTransport = initWebrtcDirectTransport()
    start(webrtcDirect, webrtcDirectAddr)
    addWebrtcDirectTransport(d, webrtcDirect)
    let webrtcDirectMuxRes: Result[Muxer] = dialAndUpgrade(d, webrtcDirectAddr)
    if ! IsErr(webrtcDirectMuxRes):
        return Err[bool]("smoke: webrtc direct expected upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: webrtc direct pending queue ! released")
    let webrtcDirectAcceptRes: Result[Connection] = accept(webrtcDirect)
    if ! IsErr(webrtcDirectAcceptRes):
        return Err[bool]("smoke: webrtc direct pending connection ! dropped")
    stop(webrtcDirect)
    resetTransportMemoryStats()

    let webrtcStarAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4006/ws/p2p-webrtc-star")
    if IsErr(webrtcStarAddrRes):
        return Err[bool](Error(webrtcStarAddrRes))
    let webrtcStarAddr: MultiAddress = Value(webrtcStarAddrRes)
    var webrtcStar: WebrtcStarTransport = initWebrtcStarTransport()
    start(webrtcStar, webrtcStarAddr)
    addWebrtcStarTransport(d, webrtcStar)
    let webrtcStarMuxRes: Result[Muxer] = dialAndUpgrade(d, webrtcStarAddr)
    if ! IsErr(webrtcStarMuxRes):
        return Err[bool]("smoke: webrtc star expected upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: webrtc star pending queue ! released")
    let webrtcStarAcceptRes: Result[Connection] = accept(webrtcStar)
    if ! IsErr(webrtcStarAcceptRes):
        return Err[bool]("smoke: webrtc star pending connection ! dropped")
    stop(webrtcStar)
    resetTransportMemoryStats()

    let torAddrRes: Result[MultiAddress] = parseMultiAddress("/onion/aaaaaaaaaaaaaaaa:4007")
    if IsErr(torAddrRes):
        return Err[bool](Error(torAddrRes))
    let torAddr: MultiAddress = Value(torAddrRes)
    var tor: TorTransport = initTorTransport()
    start(tor, torAddr)
    addTorTransport(d, tor)
    let torMuxRes: Result[Muxer] = dialAndUpgrade(d, torAddr)
    if ! IsErr(torMuxRes):
        return Err[bool]("smoke: tor expected upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: tor pending queue ! released")
    let torAcceptRes: Result[Connection] = accept(tor)
    if ! IsErr(torAcceptRes):
        return Err[bool]("smoke: tor pending connection ! dropped")
    stop(tor)
    resetTransportMemoryStats()

    let msquicAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4008/quic-v1")
    if IsErr(msquicAddrRes):
        return Err[bool](Error(msquicAddrRes))
    let msquicAddr: MultiAddress = Value(msquicAddrRes)
    var msquic: MsQuicTransport = initMsQuicTransport()
    start(msquic, msquicAddr)
    addMsQuicTransport(d, msquic)
    let msquicMuxRes: Result[Muxer] = dialAndUpgrade(d, msquicAddr)
    if ! IsErr(msquicMuxRes):
        return Err[bool]("smoke: msquic expected upgrade failure")
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: msquic pending queue ! released")
    let msquicAcceptRes: Result[Connection] = accept(msquic)
    if ! IsErr(msquicAcceptRes):
        return Err[bool]("smoke: msquic pending connection ! dropped")
    stop(msquic)
    return Ok[bool](true)
