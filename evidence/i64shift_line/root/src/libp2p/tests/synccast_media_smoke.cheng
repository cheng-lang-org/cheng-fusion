# Synccast media plane smoke test(packet roundtrip).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/synccast/media
import cheng/libp2p/protocols/synccast/datagram
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/stream/connection
import cheng/libp2p/multiaddress
import cheng/libp2p/muxers/muxer
const
    synccastMediaSmokeSessionId: int64 = 9
    synccastSmokeTrackId = 2
    synccastSmokeSeq = 100
    synccastSmokeFrameId = 7
    synccastSmokeCaptureUs = 1000000
    synccastSmokePtsUs = 1000000

var
    expectedHeader: SynccastDatagramHeader
    expectedPayload: Bytes

fn synccastMediaSmokeHandler(pkt: SynccastMediaPacket): Result[bool] =
    if pkt.header.sessionId != expectedHeader.sessionId:
        return Err[bool]("smoke: media session mismatch")
    if pkt.header.trackId != expectedHeader.trackId:
        return Err[bool]("smoke: media track mismatch")
    if pkt.header.seq != expectedHeader.seq:
        return Err[bool]("smoke: media seq mismatch")
    if pkt.header.frameId != expectedHeader.frameId:
        return Err[bool]("smoke: media frame mismatch")
    if pkt.header.captureTsUs != expectedHeader.captureTsUs || pkt.header.ptsUs != expectedHeader.ptsUs:
        return Err[bool]("smoke: media timestamp mismatch")
    if pkt.header.flags != expectedHeader.flags:
        return Err[bool]("smoke: media flags mismatch")
    if pkt.header.fragIdx != expectedHeader.fragIdx || pkt.header.fragCount != expectedHeader.fragCount:
        return Err[bool]("smoke: media fragment mismatch")
    if ! BytesEqual(pkt.payload, expectedPayload):
        return Err[bool]("smoke: media payload mismatch")
    return Ok[bool](true)

fn runSynccastMediaSmoke(): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/56")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    var listener: MemoryTransport = initMemoryTransport()
    start(listener, addr)
    var dialer: MemoryTransport = initMemoryTransport()
    let outConnRes: Result[Connection] = dial(dialer, addr)
    if IsErr(outConnRes):
        return Err[bool](Error(outConnRes))
    let inConnRes: Result[Connection] = accept(listener)
    if IsErr(inConnRes):
        return Err[bool](Error(inConnRes))
    var outboundMux: Muxer = newMuxer(Value(outConnRes))
    if outboundMux.id < 0:
        return Err[bool]("smoke: outbound muxer alloc failed")
    var inboundMux: Muxer = newMuxer(Value(inConnRes))
    if inboundMux.id < 0:
        return Err[bool]("smoke: inbound muxer alloc failed")
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)

    expectedHeader = initSynccastDatagramHeader()
    expectedHeader.sessionId = synccastMediaSmokeSessionId
    expectedHeader.trackId = synccastSmokeTrackId
    expectedHeader.seq = synccastSmokeSeq
    expectedHeader.frameId = synccastSmokeFrameId
    expectedHeader.captureTsUs = synccastSmokeCaptureUs
    expectedHeader.ptsUs = synccastSmokePtsUs
    expectedHeader.flags = synccastFlagKeyframe | synccastFlagEndOfFrame
    expectedHeader.fragIdx = 0
    expectedHeader.fragCount = 1
    expectedPayload = BytesFromString("synccast-media-frame")

    setSynccastMediaHandler(synccastMediaSmokeHandler)

    let pkt: SynccastMediaPacket = SynccastMediaPacket(header: expectedHeader, payload: expectedPayload)
    let writeRes: Result[bool] = writeSynccastMediaPacket(outStream, pkt)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = synccastMediaHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    return Ok[bool](true)
