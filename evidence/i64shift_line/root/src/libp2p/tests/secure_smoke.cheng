# Secure handshake smoke tests(noise/tls, minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/crypto/rand
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/secure/noise
import cheng/libp2p/protocols/secure/tls
fn runNoiseHandshakeSmoke(): Result[bool] =
    setRandomSeed(BytesFromString("cheng-libp2p-noise-smoke"))
    let localRes: Result[PeerId] = randomPeerId()
    if IsErr(localRes):
        return Err[bool](Error(localRes))
    let remoteRes: Result[PeerId] = randomPeerId()
    if IsErr(remoteRes):
        return Err[bool](Error(remoteRes))
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/0")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    let pairRes: Result[ConnectionPair] =
        newConnectionPair(addr, addr, addr, addr)
    if IsErr(pairRes):
        return Err[bool](Error(pairRes))
    var outbound: Connection = Value(pairRes).outbound
    var inbound: Connection = Value(pairRes).inbound
    let payload: Bytes = encodeNoiseHandshake(toString(Value(remoteRes)))
    let seedRes: Result[int32] = writeLp(inbound, payload)
    if IsErr(seedRes):
        return Err[bool](Error(seedRes))
    let secRes: Result[Connection] = noiseSecure(outbound, Some[PeerId](Value(remoteRes)), Some[PeerId](Value(localRes)))
    if IsErr(secRes):
        return Err[bool](Error(secRes))
    let secured: Connection = Value(secRes)
    if (RemotePeerId(secured) != toString(Value(remoteRes))):
        return Err[bool]("noise smoke: remote peer mismatch")

    let outRes: Result[PeerId] = randomPeerId()
    if IsErr(outRes):
        return Err[bool](Error(outRes))
    let inRes: Result[PeerId] = randomPeerId()
    if IsErr(inRes):
        return Err[bool](Error(inRes))
    let pair2Res: Result[ConnectionPair] =
        newConnectionPair(addr, addr, addr, addr)
    if IsErr(pair2Res):
        return Err[bool](Error(pair2Res))
    var outbound2: Connection = Value(pair2Res).outbound
    var inbound2: Connection = Value(pair2Res).inbound
    let payload2: Bytes = encodeNoiseHandshake(toString(Value(outRes)))
    let seedRes2: Result[int32] = writeLp(outbound2, payload2)
    if IsErr(seedRes2):
        return Err[bool](Error(seedRes2))
    let secRes2: Result[Connection] = noiseSecure(inbound2, Some[PeerId](Value(outRes)), Some[PeerId](Value(inRes)))
    if IsErr(secRes2):
        return Err[bool](Error(secRes2))
    let secured2: Connection = Value(secRes2)
    if (RemotePeerId(secured2) != toString(Value(outRes))):
        return Err[bool]("noise smoke: inbound remote peer mismatch")
    return Ok[bool](true)

fn runTlsHandshakeSmoke(): Result[bool] =
    setRandomSeed(BytesFromString("cheng-libp2p-tls-smoke"))
    let localRes: Result[PeerId] = randomPeerId()
    if IsErr(localRes):
        return Err[bool](Error(localRes))
    let remoteRes: Result[PeerId] = randomPeerId()
    if IsErr(remoteRes):
        return Err[bool](Error(remoteRes))
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/0")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    let pairRes: Result[ConnectionPair] =
        newConnectionPair(addr, addr, addr, addr)
    if IsErr(pairRes):
        return Err[bool](Error(pairRes))
    var outbound: Connection = Value(pairRes).outbound
    var inbound: Connection = Value(pairRes).inbound
    let payload: Bytes = encodeTlsHandshake(toString(Value(remoteRes)))
    let seedRes: Result[int32] = writeLp(inbound, payload)
    if IsErr(seedRes):
        return Err[bool](Error(seedRes))
    let secRes: Result[Connection] = tlsSecure(outbound, Some[PeerId](Value(remoteRes)), Some[PeerId](Value(localRes)))
    if IsErr(secRes):
        return Err[bool](Error(secRes))
    let secured: Connection = Value(secRes)
    if (RemotePeerId(secured) != toString(Value(remoteRes))):
        return Err[bool]("tls smoke: remote peer mismatch")

    let outRes: Result[PeerId] = randomPeerId()
    if IsErr(outRes):
        return Err[bool](Error(outRes))
    let inRes: Result[PeerId] = randomPeerId()
    if IsErr(inRes):
        return Err[bool](Error(inRes))
    let pair2Res: Result[ConnectionPair] =
        newConnectionPair(addr, addr, addr, addr)
    if IsErr(pair2Res):
        return Err[bool](Error(pair2Res))
    var outbound2: Connection = Value(pair2Res).outbound
    var inbound2: Connection = Value(pair2Res).inbound
    let payload2: Bytes = encodeTlsHandshake(toString(Value(outRes)))
    let seedRes2: Result[int32] = writeLp(outbound2, payload2)
    if IsErr(seedRes2):
        return Err[bool](Error(seedRes2))
    let secRes2: Result[Connection] = tlsSecure(inbound2, Some[PeerId](Value(outRes)), Some[PeerId](Value(inRes)))
    if IsErr(secRes2):
        return Err[bool](Error(secRes2))
    let secured2: Connection = Value(secRes2)
    if (RemotePeerId(secured2) != toString(Value(outRes))):
        return Err[bool]("tls smoke: inbound remote peer mismatch")
    return Ok[bool](true)

fn runSecureSmoke(): Result[bool] =
    let noiseRes: Result[bool] = runNoiseHandshakeSmoke()
    if IsErr(noiseRes):
        return noiseRes
    return runTlsHandshakeSmoke()
