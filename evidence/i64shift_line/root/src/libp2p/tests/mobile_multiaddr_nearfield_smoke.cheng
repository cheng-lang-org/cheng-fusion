# Mobile nearfield multiaddr smoke runner.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress

fn roundTrip(text: str): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress(text)
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    let backRes: Result[MultiAddress] = parseMultiAddressBytes(addr.data)
    if IsErr(backRes):
        return Err[bool](Error(backRes))
    let back: MultiAddress = Value(backRes)
    if !BytesEqual(addr.data, back.data):
        return Err[bool]("mobile_multiaddr_nearfield: roundtrip bytes mismatch")
    if lpMultiAddressToString(addr) != lpMultiAddressToString(back):
        return Err[bool]("mobile_multiaddr_nearfield: roundtrip text mismatch")
    return Ok[bool](true)

fn runMobileMultiaddrNearfieldSmoke(): int32 =
    var res: Result[bool] = roundTrip("/awdl/mac-aa-bb/quic-v1")
    if IsErr(res):
        return 11
    res = roundTrip("/nan/id-123/quic-v1")
    if IsErr(res):
        return 12
    res = roundTrip("/nearlink/mac-cc-dd/quic-v1")
    if IsErr(res):
        return 13
    res = roundTrip("/nearfield/auto")
    if IsErr(res):
        return 14
    return 0

fn main(): int32 =
    return runMobileMultiaddrNearfieldSmoke()
