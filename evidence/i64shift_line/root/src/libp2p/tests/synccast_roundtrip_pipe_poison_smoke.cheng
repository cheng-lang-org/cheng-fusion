# Synccast protobuf roundtrips should not corrupt later pipe usage.

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_control_smoke
import cheng/libp2p/tests/connection_pipe_smoke

fn runSynccastRoundtripPipePoisonSmoke(): Result[bool] =
    let rtRes: Result[bool] = runSynccastControlRoundtrips()
    if IsErr(rtRes):
        return rtRes
    let pipeRes: Result[bool] = runConnectionPipeSmoke()
    if IsErr(pipeRes):
        return pipeRes
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runSynccastRoundtripPipePoisonSmoke()
    if IsErr(res):
        echo("synccast roundtrip pipe poison smoke failed: " + Error(res))
        return 1
    echo("synccast roundtrip pipe poison smoke ok")
    return 0
