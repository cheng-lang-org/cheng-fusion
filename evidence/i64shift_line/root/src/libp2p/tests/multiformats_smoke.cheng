# Multiformats smoke tests(manual runner).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/multibase
import cheng/libp2p/multihash
import cheng/libp2p/multicodec
import cheng/libp2p/cid
import cheng/libp2p/multiaddress
fn roundTripBase(codec: MultiBaseCodec, data: Bytes, label: str): Result[bool] =
    let encRes: Result[str] = encodeMultibase(codec, data)
    if IsErr(encRes):
        return Err[bool]("smoke: multibase encode " + label)
    let decRes: Result[Bytes] = decodeMultibase(Value(encRes))
    if IsErr(decRes):
        return Err[bool]("smoke: multibase decode " + label)
    if ! BytesEqual(data, Value(decRes)):
        return Err[bool]("smoke: multibase roundtrip " + label)
    return Ok[bool](true)

fn roundTripMultihash(codec: MultiCodec, data: Bytes, label: str): Result[bool] =
    let mhRes: Result[MultiHash] = Digest(data, codec)
    if IsErr(mhRes):
        return Err[bool]("smoke: multihash digest " + label)
    let mhBytes: Bytes = EncodeMultihash(Value(mhRes))
    if ! ValidateMultihashBytes(mhBytes):
        return Err[bool]("smoke: multihash validate " + label)
    let decRes: Result[MultiHash] = DecodeMultihash(mhBytes)
    if IsErr(decRes):
        return Err[bool]("smoke: multihash decode " + label)
    let mhBytes2: Bytes = EncodeMultihash(Value(decRes))
    if ! BytesEqual(mhBytes, mhBytes2):
        return Err[bool]("smoke: multihash roundtrip " + label)
    return Ok[bool](true)

fn roundTripCid(data: Bytes): Result[bool] =
    let mhRes: Result[MultiHash] = Digest(data, codecSha2_256)
    if IsErr(mhRes):
        return Err[bool](Error(mhRes))
    let mh: MultiHash = Value(mhRes)
    let cid0: Cid = Cid(version: 0, codec: codecDagPb, multihash: mh)
    let cid0TextRes: Result[str] = cidToString(cid0, baseBase32)
    if IsErr(cid0TextRes):
        return Err[bool](Error(cid0TextRes))
    let cid0ParsedRes: Result[Cid] = parseCid(Value(cid0TextRes))
    if IsErr(cid0ParsedRes):
        return Err[bool](Error(cid0ParsedRes))
    let cid0Parsed: Cid = Value(cid0ParsedRes)
    if cid0Parsed.version != 0:
        return Err[bool]("smoke: cidv0 version")
    if ! BytesEqual(EncodeMultihash(cid0Parsed.multihash), EncodeMultihash(cid0.multihash)):
        return Err[bool]("smoke: cidv0 multihash")

    let cid1: Cid = Cid(version: 1, codec: codecRaw, multihash: mh)
    let cid1TextRes: Result[str] = cidToString(cid1, baseBase32)
    if IsErr(cid1TextRes):
        return Err[bool](Error(cid1TextRes))
    let cid1ParsedRes: Result[Cid] = parseCid(Value(cid1TextRes))
    if IsErr(cid1ParsedRes):
        return Err[bool](Error(cid1ParsedRes))
    let cid1Parsed: Cid = Value(cid1ParsedRes)
    if cid1Parsed.version != 1:
        return Err[bool]("smoke: cidv1 version")
    if cid1Parsed.codec.code != codecRaw.code:
        return Err[bool]("smoke: cidv1 codec")
    if ! BytesEqual(EncodeMultihash(cid1Parsed.multihash), EncodeMultihash(cid1.multihash)):
        return Err[bool]("smoke: cidv1 multihash")
    return Ok[bool](true)

fn roundTripMultiaddr(text: str): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress(text)
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    let data: Bytes = addr.data
    let backRes: Result[MultiAddress] = parseMultiAddressBytes(data)
    if IsErr(backRes):
        return Err[bool](Error(backRes))
    let back: MultiAddress = Value(backRes)
    if ! BytesEqual(data, back.data):
        return Err[bool]("smoke: multiaddr roundtrip")
    return Ok[bool](true)

fn runMultiformatsSmoke(): Result[bool] =
    let data: Bytes = BytesFromString("hello")
    var res: Result[bool] = roundTripBase(baseIdentity, data, "identity")
    if IsErr(res): return res
    res = roundTripBase(baseBase16, data, "base16")
    if IsErr(res): return res
    res = roundTripBase(baseBase16Upper, data, "base16upper")
    if IsErr(res): return res
    res = roundTripBase(baseBase32, data, "base32")
    if IsErr(res): return res
    res = roundTripBase(baseBase32Upper, data, "base32upper")
    if IsErr(res): return res
    res = roundTripBase(baseBase32Pad, data, "base32pad")
    if IsErr(res): return res
    res = roundTripBase(baseBase32PadUpper, data, "base32padupper")
    if IsErr(res): return res
    res = roundTripBase(baseBase32Hex, data, "base32hex")
    if IsErr(res): return res
    res = roundTripBase(baseBase32HexUpper, data, "base32hexupper")
    if IsErr(res): return res
    res = roundTripBase(baseBase32HexPad, data, "base32hexpad")
    if IsErr(res): return res
    res = roundTripBase(baseBase32HexPadUpper, data, "base32hexpadupper")
    if IsErr(res): return res
    res = roundTripBase(baseBase32Z, data, "base32z")
    if IsErr(res): return res
    res = roundTripBase(baseBase36, data, "base36")
    if IsErr(res): return res
    res = roundTripBase(baseBase58Btc, data, "base58")
    if IsErr(res): return res
    res = roundTripBase(baseBase58Flickr, data, "base58flickr")
    if IsErr(res): return res
    res = roundTripBase(baseBase64, data, "base64")
    if IsErr(res): return res
    res = roundTripBase(baseBase64Pad, data, "base64pad")
    if IsErr(res): return res
    res = roundTripBase(baseBase64Url, data, "base64url")
    if IsErr(res): return res
    res = roundTripBase(baseBase64UrlPad, data, "base64urlpad")
    if IsErr(res): return res

    res = roundTripMultihash(codecIdentity, data, "identity")
    if IsErr(res): return res
    res = roundTripMultihash(codecSha1, data, "sha1")
    if IsErr(res): return res
    res = roundTripMultihash(codecSha2_256, data, "sha2-256")
    if IsErr(res): return res
    res = roundTripMultihash(codecSha2_512, data, "sha2-512")
    if IsErr(res): return res

    res = roundTripCid(data)
    if IsErr(res): return res

    res = roundTripMultiaddr("/ip4/127.0.0.1/tcp/4001")
    if IsErr(res): return res
    res = roundTripMultiaddr("/ip6/::1/tcp/4001")
    if IsErr(res): return res
    res = roundTripMultiaddr("/dns4/example.com/ws")
    if IsErr(res): return res
    res = roundTripMultiaddr("/awdl/device-a/quic-v1")
    if IsErr(res): return res
    res = roundTripMultiaddr("/nan/session-a/quic-v1")
    if IsErr(res): return res
    res = roundTripMultiaddr("/nearlink/link-a/quic-v1")
    if IsErr(res): return res
    res = roundTripMultiaddr("/nearfield/auto")
    if IsErr(res): return res

    let peerMhRes: Result[MultiHash] = Digest(data, codecSha2_256)
    if IsErr(peerMhRes):
        return Err[bool](Error(peerMhRes))
    let peerText: str = encodeBase58(EncodeMultihash(Value(peerMhRes)))
    res = roundTripMultiaddr("/p2p/" + peerText)
    if IsErr(res): return res

    let certTextRes: Result[str] = encodeMultibase(baseBase64Url, EncodeMultihash(Value(peerMhRes)))
    if IsErr(certTextRes):
        return Err[bool](Error(certTextRes))
    res = roundTripMultiaddr("/certhash/" + Value(certTextRes))
    if IsErr(res): return res
    return Ok[bool](true)
