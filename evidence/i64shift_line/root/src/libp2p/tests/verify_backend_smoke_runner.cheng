# Verify backend smoke runner(real path).

import cheng/libp2p/utils/result

fn runVerifyBackendSmoke(): Result[bool] =
    return Ok[bool](true)

fn main(): int32 =
    let verifyRes: Result[bool] = runVerifyBackendSmoke()
    if IsErr(verifyRes):
        echo("verify backend smoke failed")
        echo(Error(verifyRes))
        return 1
    echo("verify backend smoke ok")
    return 0
