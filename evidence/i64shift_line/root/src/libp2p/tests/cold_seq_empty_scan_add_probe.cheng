# Minimal repro: cold backend miscompile #7 (2026-06-12, net_sim_pipe batch).
#
# A function that both scans struct elements of a global seq
# (`let p: R3 = s3[i]` inside a loop) and `add`s to the same seq crashes in
# add (SIGSEGV/SIGBUS wild strb) when the seq is EMPTY at run time, even
# though the loop body never executes. Variants observed: crash inside add,
# or the add silently dropped (s3.len stays 0 -> wrong result, no signal).
#
# Passing controls (same build):
# - seq non-empty when the function runs -> correct.
# - scan-only function (no add)         -> correct.
# - add-only function (no element scan) -> correct.
# Avoidance structure (used by src/libp2p/sim/net_sim_pipe.cheng): keep every
# `add` in a leaf append helper, every scan in a find-only helper.
#
# Expected once fixed: prints "probe n=1", exit 0. Currently exit 139/138.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes

type
    R3 =
        a: int32
        b: int32
        c: int32

var
    s3: R3[]

fn w(x: int32): Result[int32] =
    let total: int32 = s3.len
    for i in 0..<total:
        let p: R3 = s3[i]
        if p.c != 0:
            if p.a == x && p.b == x:
                return Err[int32]("dup")
    var v: R3
    v.a = x
    v.b = x + 1
    v.c = 1
    add(s3, v)
    return Ok[int32](s3.len)

fn main(): int32 =
    setLen(s3, 0)
    let r1: Result[int32] = w(5)
    if IsErr(r1):
        return 1
    let n1: int32 = Value(r1)
    echo(Fmt"probe n={n1}")
    if n1 != 1:
        return 1
    return 0
