# Fetch smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multicodec
import cheng/libp2p/multihash
import cheng/libp2p/cid
import cheng/libp2p/protocols/fetch/protobuf
import cheng/libp2p/protocols/fetch/fetch
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runFetchSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/16")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let data: Bytes = BytesFromString("fetch-smoke-data")
    let mhRes: Result[MultiHash] = Digest(data, codecSha2_256)
    if IsErr(mhRes):
        return Err[bool](Error(mhRes))
    let cid: Cid = Cid(version: 1, codec: codecRaw, multihash: Value(mhRes))
    let putRes: Result[bool] = fetchPutBlock(cid, data)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    let rootBytesRes: Result[Bytes] = cidToBytes(cid)
    if IsErr(rootBytesRes):
        return Err[bool](Error(rootBytesRes))
    var req: FetchRequest = initFetchRequest()
    req.hasId = true
    req.id = 1
    req.hasRoot = true
    req.root = Value(rootBytesRes)
    var msg: FetchMessage = initFetchMessage()
    msg.requestCount = 1
    msg.requests[0] = req
    let writeRes: Result[bool] = writeFetchMessage(outStream, msg)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = fetchHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let replyRes: Result[FetchMessage] = readFetchMessage(outStream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let reply: FetchMessage = Value(replyRes)
    if reply.responseCount <= 0:
        return Err[bool]("smoke: fetch response missing")
    if reply.responses[0].status != fetchStatusOk:
        return Err[bool]("smoke: fetch status mismatch")
    if reply.blockCount <= 0:
        return Err[bool]("smoke: fetch block missing")
    if ! BytesEqual(reply.blocks[0].data, data):
        return Err[bool]("smoke: fetch block mismatch")
    let missingData: Bytes = BytesFromString("fetch-missing-data")
    let missingMhRes: Result[MultiHash] = Digest(missingData, codecSha2_256)
    if IsErr(missingMhRes):
        return Err[bool](Error(missingMhRes))
    let missingCid: Cid = Cid(version: 1, codec: codecRaw, multihash: Value(missingMhRes))
    let missingRootRes: Result[Bytes] = cidToBytes(missingCid)
    if IsErr(missingRootRes):
        return Err[bool](Error(missingRootRes))
    var missingReq: FetchRequest = initFetchRequest()
    missingReq.hasId = true
    missingReq.id = 2
    missingReq.hasRoot = true
    missingReq.root = Value(missingRootRes)
    var missingMsg: FetchMessage = initFetchMessage()
    missingMsg.requestCount = 1
    missingMsg.requests[0] = missingReq
    let writeMissingRes: Result[bool] = writeFetchMessage(outStream, missingMsg)
    if IsErr(writeMissingRes):
        return Err[bool](Error(writeMissingRes))
    let handleMissingRes: Result[bool] = fetchHandler(inStream)
    if IsErr(handleMissingRes):
        return Err[bool](Error(handleMissingRes))
    let missingReplyRes: Result[FetchMessage] = readFetchMessage(outStream)
    if IsErr(missingReplyRes):
        return Err[bool](Error(missingReplyRes))
    let missingReply: FetchMessage = Value(missingReplyRes)
    if missingReply.responseCount <= 0:
        return Err[bool]("smoke: fetch missing response absent")
    if missingReply.responses[0].status != fetchStatusNotFound:
        return Err[bool]("smoke: fetch missing status mismatch")
    if missingReply.blockCount > 0:
        return Err[bool]("smoke: fetch missing block unexpected")
    let invalidRoot: Bytes = BytesFromString("!-a-cid")
    var invalidReq: FetchRequest = initFetchRequest()
    invalidReq.hasId = true
    invalidReq.id = 3
    invalidReq.hasRoot = true
    invalidReq.root = invalidRoot
    var invalidMsg: FetchMessage = initFetchMessage()
    invalidMsg.requestCount = 1
    invalidMsg.requests[0] = invalidReq
    let writeInvalidRes: Result[bool] = writeFetchMessage(outStream, invalidMsg)
    if IsErr(writeInvalidRes):
        return Err[bool](Error(writeInvalidRes))
    let handleInvalidRes: Result[bool] = fetchHandler(inStream)
    if IsErr(handleInvalidRes):
        return Err[bool](Error(handleInvalidRes))
    let invalidReplyRes: Result[FetchMessage] = readFetchMessage(outStream)
    if IsErr(invalidReplyRes):
        return Err[bool](Error(invalidReplyRes))
    let invalidReply: FetchMessage = Value(invalidReplyRes)
    if invalidReply.responseCount <= 0:
        return Err[bool]("smoke: fetch invalid response absent")
    if invalidReply.responses[0].status != fetchStatusInvalid:
        return Err[bool]("smoke: fetch invalid status mismatch")
    if invalidReply.blockCount > 0:
        return Err[bool]("smoke: fetch invalid block unexpected")
    return Ok[bool](true)
