# Connection pipe smoke test(main entry).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/connection_pipe_smoke
fn main(): int32 =
    let res: Result[bool] = runConnectionPipeSmoke()
    if IsErr(res):
        echo("connection pipe smoke failed: " + Error(res))
        return 1
    echo("connection pipe smoke ok")
    return 0

