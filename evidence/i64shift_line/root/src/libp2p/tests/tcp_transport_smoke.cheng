# TCP transport smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/tcptransport
fn runTcpTransportSmoke(): Result[bool] =
    var t: TcpTransport = initTcpTransport()
    let addrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4001")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    start(t, addr)
    let dialRes: Result[Connection] = dial(t, addr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    let outbound: Connection = Value(dialRes)
    if ConnectionDirection(outbound) != Outbound:
        return Err[bool]("smoke: tcp outbound direction mismatch")
    if ! ConnectionIsOpen(outbound):
        return Err[bool]("smoke: tcp outbound ! open")
    let acceptRes: Result[Connection] = accept(t)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    let inbound: Connection = Value(acceptRes)
    if ConnectionDirection(inbound) != Inbound:
        return Err[bool]("smoke: tcp inbound direction mismatch")
    if ! ConnectionIsOpen(inbound):
        return Err[bool]("smoke: tcp inbound ! open")
    if ! StrContains(toString(LocalAddress(outbound)), "/tcp/"):
        return Err[bool]("smoke: tcp outbound local addr missing tcp")
    if ! StrContains(toString(RemoteAddress(outbound)), "/tcp/"):
        return Err[bool]("smoke: tcp outbound remote addr missing tcp")
    return Ok[bool](true)
