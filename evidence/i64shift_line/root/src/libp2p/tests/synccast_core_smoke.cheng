# Synccast core smoke test(fragment/jitter/crypto).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/synccast/core
import cheng/libp2p/protocols/synccast/datagram
fn fillBytes(value: int32, count: int32): Bytes =
    if count <= 0:
        return EmptyBytes()
    let out: Bytes = BytesAlloc(count)
    for i in 0..<count:
        BytesSet(out, i, value)
    return out

fn firstMismatch(a: Bytes, b: Bytes): int32 =
    let aLen: int32 = BytesLen(a)
    let bLen: int32 = BytesLen(b)
    let maxLen: int32 = if aLen < bLen: aLen else: bLen
    for i in 0..<maxLen:
        if BytesGet(a, i) != BytesGet(b, i):
            return i
    if aLen != bLen:
        return maxLen
    return -1

fn runSynccastCoreSmoke(): Result[bool] =
    var header: SynccastDatagramHeader = initSynccastDatagramHeader()
    header.sessionId = int64(7)
    header.trackId = 3
    header.seq = 100
    header.frameId = 9
    header.captureTsUs = 1000000
    header.ptsUs = 1000000
    let directHead: Bytes = encodeSynccastDatagramHeader(header)
    let directRes: Result[SynccastDatagramHeader] = decodeSynccastDatagramHeader(directHead)
    if IsErr(directRes):
        return Err[bool]("smoke: header roundtrip decode failed " + Error(directRes))
    let directHeader: SynccastDatagramHeader = Value(directRes)
    if directHeader.sessionId != header.sessionId || directHeader.trackId != header.trackId || directHeader.seq != header.seq || directHeader.frameId != header.frameId:
        return Err[bool]("smoke: header roundtrip mismatch got session=" + $(directHeader.sessionId) + " track=" + $(directHeader.trackId) + " seq=" + $(directHeader.seq) + " frame=" + $(directHeader.frameId) + " head " + BytesToHex(directHead))
    let payload: Bytes = BytesConcat(BytesFromString("synccast-smoke-"), fillBytes(42, 64))
    let fragments = synccastFragmentFrame(header, payload, 16)
    if fragments.count <= 1:
        return Err[bool]("smoke: fragment count too small")
    var reasm: SynccastReassembly = initSynccastReassembly(50000)
    var nowUs: int64 = 1000000
    var frame: SynccastFrame
    var gotFrame = false
    var lastErr = ""
    for i in 0..<fragments.count:
        let frag: Bytes = fragments.items[i]
        if BytesLen(frag) < synccastDatagramHeaderSize:
            return Err[bool]("smoke: fragment too small")
        let head = BytesSlice(frag, 0, synccastDatagramHeaderSize)
        let body = BytesSlice(frag, synccastDatagramHeaderSize, BytesLen(frag) - synccastDatagramHeaderSize)
        let headerRes: Result[SynccastDatagramHeader] = decodeSynccastDatagramHeader(head)
        if IsErr(headerRes):
            return Err[bool](Error(headerRes))
        let fragHeader: SynccastDatagramHeader = Value(headerRes)
        if fragHeader.fragCount != fragments.count:
            return Err[bool]("smoke: fragCount mismatch " + $(fragHeader.fragCount) + " vs " + $(fragments.count) + " head " + BytesToHex(head))
        if fragHeader.fragIdx != i:
            return Err[bool]("smoke: fragIdx mismatch " + $(fragHeader.fragIdx) + " vs " + $(i))
        let frameRes = synccastReassemblyPush(reasm, fragHeader, body, nowUs)
        if IsOk(frameRes):
            frame = Value(frameRes)
            gotFrame = true
        else:
            lastErr = Error(frameRes)
        nowUs = nowUs + 1000
    if ! gotFrame:
        let err = if len(lastErr) > 0: "smoke: reassembly missing last=" + lastErr else: "smoke: reassembly missing"
        return Err[bool](err)
    if BytesLen(frame.payload) != BytesLen(payload):
        return Err[bool]("smoke: reassembly length mismatch " + $(BytesLen(frame.payload)) + " vs " + $(BytesLen(payload)))
    if ! BytesEqual(frame.payload, payload):
        let mismatchIdx: int32 = firstMismatch(frame.payload, payload)
        let gotVal: int32 = if mismatchIdx >= 0 && mismatchIdx < BytesLen(frame.payload): BytesGet(frame.payload, mismatchIdx) else: -1
        let wantVal: int32 = if mismatchIdx >= 0 && mismatchIdx < BytesLen(payload): BytesGet(payload, mismatchIdx) else: -1
        return Err[bool]("smoke: reassembly payload mismatch at " + $(mismatchIdx) + " got " + $(gotVal) + " want " + $(wantVal))
    var jitter: SynccastJitterBuffer = initSynccastJitterBuffer(40000)
    if ! synccastJitterPush(jitter, frame, nowUs):
        return Err[bool]("smoke: jitter push failed")
    let popRes = synccastJitterPop(jitter, nowUs + 60000)
    if IsErr(popRes):
        return Err[bool]("smoke: jitter pop missing")
    let key: Bytes = fillBytes(7, 32)
    let ctx: SynccastCryptoContext = initSynccastCryptoContext(key)
    let encRes: Result[Bytes] = synccastEncryptPayload(ctx, header, payload)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let decRes: Result[Bytes] = synccastDecryptPayload(ctx, header, Value(encRes))
    if IsErr(decRes):
        return Err[bool](Error(decRes))
    if ! BytesEqual(Value(decRes), payload):
        return Err[bool]("smoke: decrypt payload mismatch")
    return Ok[bool](true)
