# mDNS -> host -> QUIC direct -> DM -> Synccast call -> Livestream smoke test.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/stringlist
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/option
import cheng/libp2p/discovery/mdns
import cheng/libp2p/discovery/discoverymngr
import cheng/libp2p/peerid
import cheng/libp2p/peerinfo
import cheng/libp2p/peerstore
import cheng/quic/msquictransport
import cheng/libp2p/muxers/muxer
import cheng/libp2p/stream/connection
import cheng/libp2p/multiaddress
import cheng/libp2p/protocols/dm/dmservice
import cheng/libp2p/protocols/synccast/control
import cheng/libp2p/protocols/synccast/protobuf
import cheng/libp2p/protocols/synccast/session
import cheng/libp2p/protocols/synccast/session_msquic
import cheng/libp2p/protocols/synccast/datagram
import cheng/libp2p/protocols/livestream/livestream
import cheng/libp2p/protocols/livestream/protobuf
import cheng/libp2p/tests/test_multistream
const
    mdnsHostSynccastSessionId = 4101

type
    TestHost =
        peerId: PeerId
        peerStore: PeerStore
        transport: MsQuicTransport
        listenAddr: MultiAddress

fn initTestHost(addrText: str): Result[TestHost] =
    let addrRes: Result[MultiAddress] = parseMultiAddress(addrText)
    if IsErr(addrRes):
        return Err[TestHost](Error(addrRes))
    let pidRes: Result[PeerId] = randomPeerId()
    if IsErr(pidRes):
        return Err[TestHost](Error(pidRes))
    return Ok[TestHost](TestHost(
        peerId: Value(pidRes),
        peerStore: initPeerStore(),
        transport: initMsQuicTransport(),
        listenAddr: Value(addrRes)
    ))

fn startTestHost(h: var TestHost): Result[bool] =
    var t: MsQuicTransport = h.transport
    start(t, h.listenAddr)
    h.transport = t
    if ! h.transport.running:
        return Err[bool]("smoke: msquic transport start failed")
    return Ok[bool](true)

fn stopTestHost(h: var TestHost) =
    var t: MsQuicTransport = h.transport
    stop(t)
    h.transport = t

fn hostMdnsAdvertise(h: TestHost, service: str, namespace: str): Result[bool] =
    var attrs: PeerAttributes = initPeerAttributes()
    let addPidRes: Result[bool] = peerAttributesAddPeerId(attrs, h.peerId)
    if IsErr(addPidRes):
        return Err[bool](Error(addPidRes))
    let addAddrRes: Result[bool] = peerAttributesAddAddress(attrs, h.listenAddr)
    if IsErr(addAddrRes):
        return Err[bool](Error(addAddrRes))
    if len(service) > 0:
        let addSvcRes: Result[bool] = peerAttributesAddService(attrs, service)
        if IsErr(addSvcRes):
            return Err[bool](Error(addSvcRes))
    if len(namespace) > 0:
        let addNsRes: Result[bool] = peerAttributesAddNamespace(attrs, namespace)
        if IsErr(addNsRes):
            return Err[bool](Error(addNsRes))
    return mdnsAdvertise(attrs)

fn hostMdnsDiscover(h: var TestHost, service: str, namespace: str, limit: int32): Result[int32] =
    var query: PeerAttributes = initPeerAttributes()
    if len(service) > 0:
        let addSvcRes: Result[bool] = peerAttributesAddService(query, service)
        if IsErr(addSvcRes):
            return Err[int32](Error(addSvcRes))
    if len(namespace) > 0:
        let addNsRes: Result[bool] = peerAttributesAddNamespace(query, namespace)
        if IsErr(addNsRes):
            return Err[int32](Error(addNsRes))
    var out: PeerAttributesList = initPeerAttributesList()
    let discRes: Result[bool] = mdnsDiscover(query, out)
    if IsErr(discRes):
        return Err[int32](Error(discRes))
    var filtered: PeerAttributesList = initPeerAttributesList()
    for i in 0..<out.count:
        var pid: PeerId
        if peerAttributesGetPeerId(out.items[i], pid):
            let eqRes: Result[bool] = peerIdEqual(pid, h.peerId)
            if IsErr(eqRes):
                return Err[int32](Error(eqRes))
            if ! Value(eqRes):
                let addRes: Result[bool] = peerAttributesListAdd(filtered, out.items[i])
                if IsErr(addRes):
                    return Err[int32](Error(addRes))
    var store: PeerStore = h.peerStore
    let mergeRes: Result[int32] = mergePeerAttributesList(store, filtered, limit)
    if IsErr(mergeRes):
        return Err[int32](Error(mergeRes))
    h.peerStore = store
    return mergeRes

fn hostHasPeerText(store: PeerStore, peerText: str): Result[bool] =
    let pidRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    return hasPeer(store, Value(pidRes))

fn hostDialPeer(h: var TestHost, peer: PeerId): Result[Muxer] =
    let infoRes: Result[PeerInfo] = getPeer(h.peerStore, peer)
    if IsErr(infoRes):
        return Err[Muxer](Error(infoRes))
    let info: PeerInfo = Value(infoRes)
    let addrOpt: Option[MultiAddress] = firstAddress(info)
    if ! addrOpt.has:
        return Err[Muxer]("smoke: peer missing address")
    var t: MsQuicTransport = h.transport
    let connRes: Result[Connection] = dial(t, addrOpt.value)
    h.transport = t
    if IsErr(connRes):
        return Err[Muxer](Error(connRes))
    var conn: Connection = Value(connRes)
    var mux: Muxer = newMuxer(conn)
    if mux.id < 0:
        return Err[Muxer]("smoke: muxer allocate failed")
    return Ok[Muxer](mux)

fn hostAccept(h: var TestHost): Result[Muxer] =
    var t: MsQuicTransport = h.transport
    let connRes: Result[Connection] = accept(t)
    h.transport = t
    if IsErr(connRes):
        return Err[Muxer](Error(connRes))
    var mux: Muxer = newMuxer(Value(connRes))
    if mux.id < 0:
        return Err[Muxer]("smoke: muxer allocate failed")
    return Ok[Muxer](mux)

fn dmEchoHandler(req: DmRequest): DmResponse =
    var resp: DmResponse = initDmResponse()
    resp.ok = true
    resp.message = "echo:" + req.text
    return resp

fn synccastHelloHandler(msg: SynccastControlMessage): Result[SynccastControlMessage] =
    if msg.protoMajor != synccastProtoMajor || msg.protoMinor != synccastProtoMinor:
        return Err[SynccastControlMessage]("smoke: synccast proto mismatch")
    if msg.msgId <= 0:
        return Err[SynccastControlMessage]("smoke: synccast missing msg id")
    if msg.kind != synccastHelloKind:
        return Err[SynccastControlMessage]("smoke: expected synccast hello")
    let helloRes: Result[SynccastHello] = decodeSynccastHello(msg.payload)
    if IsErr(helloRes):
        return Err[SynccastControlMessage](Error(helloRes))
    let hello: SynccastHello = Value(helloRes)
    if !hello.supportsDatagram:
        return Err[SynccastControlMessage]("smoke: synccast datagram flag missing")
    var negotiated: SynccastNegotiated = initSynccastNegotiated()
    negotiated.ok = true
    negotiated.sessionId = int64(mdnsHostSynccastSessionId)
    negotiated.targetLatencyMs = 0
    negotiated.message = "ok"
    let payloadRes: Result[Bytes] = encodeSynccastNegotiated(negotiated)
    if IsErr(payloadRes):
        return Err[SynccastControlMessage](Error(payloadRes))
    var resp: SynccastControlMessage = initSynccastControlMessage()
    resp.kind = synccastNegotiatedKind
    resp.sessionId = int64(mdnsHostSynccastSessionId)
    resp.payload = Value(payloadRes)
    return Ok[SynccastControlMessage](resp)

fn runMdnsHostSynccastCallSmoke(): Result[bool] =
    var cfg: MdnsConfig = initMdnsConfig()
    cfg.enableNetwork = false
    cfg.bindPort = 5536
    cfg.queryTimeoutMs = 50
    setMdnsConfig(cfg)
    setMdnsState(initMdnsState())

    let hostARes: Result[TestHost] = initTestHost("/ip4/127.0.0.1/udp/4031/quic-v1")
    if IsErr(hostARes):
        return Err[bool](Error(hostARes))
    var hostA: TestHost = Value(hostARes)
    let hostBRes: Result[TestHost] = initTestHost("/ip4/127.0.0.1/udp/4032/quic-v1")
    if IsErr(hostBRes):
        return Err[bool](Error(hostBRes))
    var hostB: TestHost = Value(hostBRes)

    let startARes: Result[bool] = startTestHost(hostA)
    if IsErr(startARes):
        return Err[bool](Error(startARes))
    let startBRes: Result[bool] = startTestHost(hostB)
    if IsErr(startBRes):
        return Err[bool](Error(startBRes))

    let advRes: Result[bool] = hostMdnsAdvertise(hostA, "synccast-call", "local")
    if IsErr(advRes):
        return Err[bool](Error(advRes))
    let discRes: Result[int32] = hostMdnsDiscover(hostB, "synccast-call", "local", 4)
    if IsErr(discRes):
        return Err[bool](Error(discRes))
    if Value(discRes) <= 0:
        return Err[bool]("smoke: mdns host discovery empty")
    let peerText: str = peerid.toString(hostA.peerId)
    let hasPeerRes: Result[bool] = hostHasPeerText(hostB.peerStore, peerText)
    if IsErr(hasPeerRes):
        return Err[bool](Error(hasPeerRes))
    if !Value(hasPeerRes):
        return Err[bool]("smoke: mdns host peer missing")

    let muxRes: Result[Muxer] = hostDialPeer(hostB, hostA.peerId)
    if IsErr(muxRes):
        return Err[bool](Error(muxRes))
    var outboundMux: Muxer = Value(muxRes)
    let acceptRes: Result[Muxer] = hostAccept(hostA)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outConn: Connection = muxerConnection(outboundMux)
    let inConn: Connection = muxerConnection(inboundMux)
    let outLocal: str = toString(LocalAddress(outConn))
    let outRemote: str = toString(RemoteAddress(outConn))
    let inLocal: str = toString(LocalAddress(inConn))
    let inRemote: str = toString(RemoteAddress(inConn))
    if ! StrContains(outLocal, "/udp/") || ! StrContains(outRemote, "/udp/"):
        return Err[bool]("smoke: quic-v1 outbound addr missing udp")
    if ! StrContains(inLocal, "/udp/") || ! StrContains(inRemote, "/udp/"):
        return Err[bool]("smoke: quic-v1 inbound addr missing udp")
    if ! StrContains(outLocal, "/quic-v1") || ! StrContains(outRemote, "/quic-v1"):
        return Err[bool]("smoke: quic-v1 outbound addr missing quic-v1")
    if ! StrContains(inLocal, "/quic-v1") || ! StrContains(inRemote, "/quic-v1"):
        return Err[bool]("smoke: quic-v1 inbound addr missing quic-v1")

    let dmOutRes: Result[Stream] = openStream(outboundMux)
    if IsErr(dmOutRes):
        return Err[bool](Error(dmOutRes))
    var dmOut: Stream = Value(dmOutRes)
    let dmInRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(dmInRes):
        return Err[bool](Error(dmInRes))
    var dmIn: Stream = Value(dmInRes)
    let dmSelRes: Result[bool] = multistreamSelectPair(dmOut, dmIn, dMCodec)
    if IsErr(dmSelRes):
        return Err[bool](Error(dmSelRes))
    var dmReq: DmRequest = initDmRequest()
    dmReq.text = "call:ping"
    let dmWriteRes: Result[bool] = writeDmRequest(dmOut, dmReq)
    if IsErr(dmWriteRes):
        return Err[bool](Error(dmWriteRes))
    let dmInboundReqRes: Result[DmRequest] = readDmRequest(dmIn)
    if IsErr(dmInboundReqRes):
        return Err[bool](Error(dmInboundReqRes))
    let dmInboundReq: DmRequest = Value(dmInboundReqRes)
    var dmOutboundResp: DmResponse = initDmResponse()
    dmOutboundResp.ok = true
    dmOutboundResp.message = "echo:" + dmInboundReq.text
    let dmInboundWriteRes: Result[bool] = writeDmResponse(dmIn, dmOutboundResp)
    if IsErr(dmInboundWriteRes):
        return Err[bool](Error(dmInboundWriteRes))
    let dmRespRes: Result[DmResponse] = readDmResponse(dmOut)
    if IsErr(dmRespRes):
        return Err[bool](Error(dmRespRes))
    let dmResp: DmResponse = Value(dmRespRes)
    if !dmResp.ok || (dmResp.message != "echo:call:ping"):
        return Err[bool]("smoke: dm response mismatch")
    let dmCloseRes: Result[bool] = closeStream(dmOut)
    if IsErr(dmCloseRes):
        return Err[bool](Error(dmCloseRes))
    let dmCloseInRes: Result[bool] = closeStream(dmIn)
    if IsErr(dmCloseInRes):
        return Err[bool](Error(dmCloseInRes))

    let scOutRes: Result[Stream] = openStream(outboundMux)
    if IsErr(scOutRes):
        return Err[bool](Error(scOutRes))
    var scOut: Stream = Value(scOutRes)
    let scInRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(scInRes):
        return Err[bool](Error(scInRes))
    var scIn: Stream = Value(scInRes)
    let scSelRes: Result[bool] = multistreamSelectPair(scOut, scIn, synccastControlCodec)
    if IsErr(scSelRes):
        return Err[bool](Error(scSelRes))
    var hello: SynccastHello = initSynccastHello()
    hello.supportsDatagram = true
    hello.maxDatagramBytes = 1200
    let addCodecRes: Result[bool] = StringListAdd(hello.codecs, "h264")
    if IsErr(addCodecRes):
        return Err[bool](Error(addCodecRes))
    hello.deviceClass = "desktop"
    let helloPayloadRes: Result[Bytes] = encodeSynccastHello(hello)
    if IsErr(helloPayloadRes):
        return Err[bool](Error(helloPayloadRes))
    var helloMsg: SynccastControlMessage = initSynccastControlMessage()
    helloMsg.kind = synccastHelloKind
    helloMsg.payload = Value(helloPayloadRes)
    helloMsg.sessionId = 0
    helloMsg.msgId = 1
    helloMsg.ackMsgId = 0
    helloMsg.timestampMonoUs = 1234
    let scWriteRes: Result[bool] = writeSynccastControlMessage(scOut, helloMsg)
    if IsErr(scWriteRes):
        return Err[bool](Error(scWriteRes))
    let scInboundReqRes: Result[SynccastControlMessage] = readSynccastControlMessage(scIn)
    if IsErr(scInboundReqRes):
        return Err[bool](Error(scInboundReqRes))
    let scInboundReq: SynccastControlMessage = Value(scInboundReqRes)
    if scInboundReq.kind != synccastHelloKind:
        return Err[bool]("smoke: expected synccast hello")
    let scHelloRes: Result[SynccastHello] = decodeSynccastHello(scInboundReq.payload)
    if IsErr(scHelloRes):
        return Err[bool](Error(scHelloRes))
    let scHello: SynccastHello = Value(scHelloRes)
    if !scHello.supportsDatagram:
        return Err[bool]("smoke: synccast datagram flag missing")
    var negotiated: SynccastNegotiated = initSynccastNegotiated()
    negotiated.ok = true
    negotiated.sessionId = int64(mdnsHostSynccastSessionId)
    negotiated.targetLatencyMs = 0
    negotiated.message = "ok"
    let negotiatedPayloadRes: Result[Bytes] = encodeSynccastNegotiated(negotiated)
    if IsErr(negotiatedPayloadRes):
        return Err[bool](Error(negotiatedPayloadRes))
    var scOutboundResp: SynccastControlMessage = initSynccastControlMessage()
    scOutboundResp.protoMajor = scInboundReq.protoMajor
    scOutboundResp.protoMinor = scInboundReq.protoMinor
    scOutboundResp.kind = synccastNegotiatedKind
    scOutboundResp.sessionId = int64(mdnsHostSynccastSessionId)
    scOutboundResp.msgId = scInboundReq.msgId + 1
    scOutboundResp.ackMsgId = scInboundReq.msgId
    scOutboundResp.payload = Value(negotiatedPayloadRes)
    let scInboundWriteRes: Result[bool] = writeSynccastControlMessage(scIn, scOutboundResp)
    if IsErr(scInboundWriteRes):
        return Err[bool](Error(scInboundWriteRes))
    let scRespRes: Result[SynccastControlMessage] = readSynccastControlMessage(scOut)
    if IsErr(scRespRes):
        return Err[bool](Error(scRespRes))
    let scResp: SynccastControlMessage = Value(scRespRes)
    if scResp.ackMsgId != helloMsg.msgId:
        return Err[bool]("smoke: synccast negotiated ack mismatch")
    if scResp.sessionId != int64(mdnsHostSynccastSessionId):
        return Err[bool]("smoke: synccast negotiated session in envelope mismatch")
    if scResp.kind != synccastNegotiatedKind:
        return Err[bool]("smoke: synccast negotiated kind mismatch")
    let scCloseRes: Result[bool] = closeStream(scOut)
    if IsErr(scCloseRes):
        return Err[bool](Error(scCloseRes))
    let scCloseInRes: Result[bool] = closeStream(scIn)
    if IsErr(scCloseInRes):
        return Err[bool](Error(scCloseInRes))

    var sessionCfg: SynccastSessionConfig = initSynccastSessionConfig()
    sessionCfg.sessionId = int64(mdnsHostSynccastSessionId)
    sessionCfg.targetLatencyMs = 0
    sessionCfg.maxPayloadBytes = 1100
    var sender: SynccastSession = initSynccastSession(sessionCfg)
    var receiver: SynccastSession = initSynccastSession(sessionCfg)
    var outConnVar: Connection = outConn
    var inConnVar: Connection = inConn
    let nowUs: int64 = synccastNowUs()
    let audioPayload: Bytes = BytesFromString("call-audio")
    var transportB: MsQuicTransport = hostB.transport
    let sendAudioRes: Result[int32] = session_msquic.synccastSessionSendAudio(transportB, outConnVar, sender, 1, nowUs, nowUs, audioPayload)
    hostB.transport = transportB
    if IsErr(sendAudioRes):
        return Err[bool](Error(sendAudioRes))
    let videoPayload: Bytes = BytesFromString("call-video")
    transportB = hostB.transport
    let sendVideoRes: Result[int32] = session_msquic.synccastSessionSendVideo(transportB, outConnVar, sender, 2, nowUs + 20000, nowUs + 20000, videoPayload, true)
    hostB.transport = transportB
    if IsErr(sendVideoRes):
        return Err[bool](Error(sendVideoRes))
    var received: int32
    var gotAudio: bool
    var gotVideo: bool
    let deadlineUs: int64 = synccastNowUs() + 2000000
    var transportA: MsQuicTransport = hostA.transport
    while received < 2 && synccastNowUs() < deadlineUs: # cheng-syntax-policy: allow-counting-while
        let handleRes: Result[bool] = session_msquic.synccastSessionHandleDatagram(transportA, inConnVar, receiver)
        hostA.transport = transportA
        if IsErr(handleRes):
            return Err[bool](Error(handleRes))
        if Value(handleRes):
            let frameRes: Result[SynccastFrame] = synccastSessionPopFrame(receiver)
            if IsErr(frameRes):
                return Err[bool](Error(frameRes))
            let frame: SynccastFrame = Value(frameRes)
            if frame.header.trackId == synccastTrackAudio:
                if !BytesEqual(frame.payload, audioPayload):
                    return Err[bool]("smoke: audio payload mismatch")
                gotAudio = true
            elif frame.header.trackId == synccastTrackVideo:
                if !BytesEqual(frame.payload, videoPayload):
                    return Err[bool]("smoke: video payload mismatch")
                if (frame.header.flags & synccastFlagKeyframe) == 0:
                    return Err[bool]("smoke: video keyframe missing")
                gotVideo = true
            received = received + 1
    if received < 2:
        return Err[bool]("smoke: synccast datagram timeout")
    if !gotAudio || !gotVideo:
        return Err[bool]("smoke: synccast audio/video missing")

    let liveOutRes: Result[Stream] = openStream(outboundMux)
    if IsErr(liveOutRes):
        return Err[bool](Error(liveOutRes))
    var liveOut: Stream = Value(liveOutRes)
    let liveInRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(liveInRes):
        return Err[bool](Error(liveInRes))
    var liveIn: Stream = Value(liveInRes)
    let liveSelRes: Result[bool] = multistreamSelectPair(liveOut, liveIn, livestreamCodec)
    if IsErr(liveSelRes):
        return Err[bool](Error(liveSelRes))
    var liveReq: LivestreamRequest = LivestreamRequest(
        streamId: "program",
        seq: 1,
        data: BytesFromString("frame-1"),
        endOfStream: false
    )
    let liveWriteRes: Result[bool] = writeLivestreamRequest(liveOut, liveReq)
    if IsErr(liveWriteRes):
        return Err[bool](Error(liveWriteRes))
    let liveHandleRes: Result[bool] = livestreamHandler(liveIn)
    if IsErr(liveHandleRes):
        return Err[bool](Error(liveHandleRes))
    let liveRespRes: Result[LivestreamResponse] = readLivestreamResponse(liveOut)
    if IsErr(liveRespRes):
        return Err[bool](Error(liveRespRes))
    let liveResp: LivestreamResponse = Value(liveRespRes)
    if !liveResp.ok:
        return Err[bool]("smoke: livestream response ! ok")
    if (liveResp.message != "ok"):
        return Err[bool]("smoke: livestream message mismatch")
    if liveResp.nextSeq != 2:
        return Err[bool]("smoke: livestream next seq mismatch")
    let liveCloseRes: Result[bool] = closeStream(liveOut)
    if IsErr(liveCloseRes):
        return Err[bool](Error(liveCloseRes))
    let liveCloseInRes: Result[bool] = closeStream(liveIn)
    if IsErr(liveCloseInRes):
        return Err[bool](Error(liveCloseInRes))

    closeMuxer(outboundMux)
    closeMuxer(inboundMux)
    stopTestHost(hostB)
    stopTestHost(hostA)
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runMdnsHostSynccastCallSmoke()
    if IsErr(res):
        echo("mdns host synccast call smoke failed: " + Error(res))
        return 1
    echo("mdns host synccast call smoke ok")
    return 0
