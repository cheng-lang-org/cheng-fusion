# mobile ffi network-state injection smoke.

import cheng/libp2p/mobile_ffi/unimaker_compat_ffi

fn hasToken(text: str, token: str): bool =
    return indexOf(text, token, 0) >= 0

fn countToken(text: str, token: str): int32 =
    if len(token) <= 0:
        return 0
    var count: int32
    var cursor: int32
    while true:
        let pos: int32 = indexOf(text, token, cursor)
        if pos < 0:
            break
        count = count + 1
        cursor = pos + len(token)
    return count

fn runNetworkStateSmoke(): int32 =
    NimMain()
    let handle: int64 = libp2p_node_init("")
    if handle <= 0:
        return 11

    if !libp2p_notify_network_state_json(handle, "{\"networkType\":\"wifi\",\"radio\":\"unknown\",\"ssid\":\"office\",\"metered\":false,\"updatedAtMs\":0}"):
        libp2p_node_free(handle)
        return 12
    if !libp2p_notify_network_state_json(handle, "{\"networkType\":\"cellular\",\"radio\":\"5g\",\"ssid\":\"\",\"metered\":true,\"updatedAtMs\":1}"):
        libp2p_node_free(handle)
        return 13
    if !libp2p_notify_network_state_json(handle, "{\"networkType\":\"wifi\",\"radio\":\"unknown\",\"ssid\":\"office\",\"metered\":false,\"updatedAtMs\":2}"):
        libp2p_node_free(handle)
        return 14

    let changedEvents: str = libp2p_poll_events(handle, 32)
    if countToken(changedEvents, "\"topic\":\"network.state.changed\"") != 3:
        libp2p_node_free(handle)
        return 15
    let firstWifiPos: int32 = indexOf(changedEvents, "\"networkType\":\"wifi\"", 0)
    let cellularPos: int32 = indexOf(changedEvents, "\"networkType\":\"cellular\"", if firstWifiPos >= 0: firstWifiPos + 1 else: 0)
    let secondWifiPos: int32 = indexOf(changedEvents, "\"networkType\":\"wifi\"", if cellularPos >= 0: cellularPos + 1 else: 0)
    if firstWifiPos < 0 || cellularPos < 0 || secondWifiPos < 0:
        libp2p_node_free(handle)
        return 16
    if countToken(changedEvents, "\"source\":\"host\"") < 3:
        libp2p_node_free(handle)
        return 17

    let snapshot: str = libp2p_get_network_state_json(handle)
    if !hasToken(snapshot, "\"networkType\":\"wifi\"") || !hasToken(snapshot, "\"radio\":\"unknown\""):
        libp2p_node_free(handle)
        return 18
    if !hasToken(snapshot, "\"ssid\":\"office\"") || !hasToken(snapshot, "\"metered\":false"):
        libp2p_node_free(handle)
        return 19

    if libp2p_notify_network_state_json(handle, "{\"networkType\":\"wifi\"}"):
        libp2p_node_free(handle)
        return 20
    let invalidA: str = libp2p_poll_events(handle, 8)
    if countToken(invalidA, "\"topic\":\"network.state.invalid\"") <= 0:
        libp2p_node_free(handle)
        return 21

    if libp2p_notify_network_state_json(handle, "{\"networkType\":\"satellite\",\"radio\":\"5g\",\"ssid\":\"x\",\"metered\":true,\"updatedAtMs\":1}"):
        libp2p_node_free(handle)
        return 22
    let invalidB: str = libp2p_poll_events(handle, 8)
    if countToken(invalidB, "\"topic\":\"network.state.invalid\"") <= 0:
        libp2p_node_free(handle)
        return 23

    var huge: str = "{\"networkType\":\"wifi\",\"radio\":\"5g\",\"ssid\":\""
    var padCount: int32
    while padCount < 5000:
        huge = huge + "a"
        padCount = padCount + 1
    huge = huge + "\",\"metered\":true,\"updatedAtMs\":1}"
    if libp2p_notify_network_state_json(handle, huge):
        libp2p_node_free(handle)
        return 24
    let invalidC: str = libp2p_poll_events(handle, 8)
    if countToken(invalidC, "\"topic\":\"network.state.invalid\"") <= 0:
        libp2p_node_free(handle)
        return 25

    libp2p_node_free(handle)
    return 0

fn main(): int32 =
    let rc: int32 = runNetworkStateSmoke()
    if rc != 0:
        echo("mobile ffi network state smoke failed: " + $rc)
        return 1
    echo("mobile ffi network state smoke ok")
    return 0
