# #98 三跳转手 repro: 数组声明层. r98BaseN 经 base -> mid2 -> mid1 -> 本文件 三跳转手,
# 本文件不直接 import base/mid2, 只 import mid1(转手链的最后一跳).
import cheng/libp2p/tests/constresidual98_mid1

var
    gConstResidual98Arr: int32[r98BaseN]

fn ConstResidual98ArraySize(): int32 =
    var i: int32 = 0
    for i in 0..<7:
        gConstResidual98Arr[i] = i + 1
    var s: int32 = 0
    var j: int32 = 0
    for j in 0..<7:
        s = s + gConstResidual98Arr[j]
    return s
