# net_sim_pipe smoke: qconn pipe semantics over the deterministic simulator.
#
# 1. Two nodes, two streams interleaved write/read in both directions:
#    per-stream FIFO and byte-exact against the send side.
# 2. Nonblocking read on empty queue -> Err("pipe: empty"); partial reads,
#    idx discrimination and close contract.
# 3. Zero-loss link, 1000 frames ping-pong -> virtual time exactly 500000us.
# 4. Partitioned link: blocking read drains the heap and returns
#    Err("pipe: underrun") without hanging; heals afterwards.
# 5. Same seed -> identical rolling-hash fingerprint of all read bytes
#    (pinned constant = cross-process stability); different seed differs.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/sim/net_sim
import cheng/libp2p/sim/net_sim_pipe

fn genByte(tag: int32, i: int32): int32 =
    return (tag * 29 + i * 7 + 3) & 255

fn genData(tag: int32, total: int32): Bytes =
    var out: Bytes = BytesAlloc(total)
    for i in 0..<total:
        BytesSet(out, i, genByte(tag, i))
    return out

fn fpMix(h: int64, v: int64): int64 =
    return (h * 1000003 + (v & 1073741823)) & 1073741823

# Writes dataA/dataB interleaved in chunks onto two streams of one side.
fn writeInterleaved(pipe: int32, side: int32, sidA: int64, dataA: Bytes, sidB: int64, dataB: Bytes): int32 =
    var offA: int32
    var offB: int32
    var k: int32
    let totalA: int32 = BytesLen(dataA)
    let totalB: int32 = BytesLen(dataB)
    while offA < totalA || offB < totalB:
        var pickA: bool = (k & 1) == 0
        if offA >= totalA:
            pickA = false
        if offB >= totalB:
            pickA = true
        if pickA:
            var n: int32 = k % 7 + 1
            if n > totalA - offA:
                n = totalA - offA
            let res: Result[int32] = SimPipeWrite(pipe, side, sidA, BytesSlice(dataA, offA, n))
            if IsErr(res) || Value(res) != n:
                echo("pipe FAIL: interleaved write A")
                return 1
            offA = offA + n
        else:
            var n: int32 = k % 4 + 2
            if n > totalB - offB:
                n = totalB - offB
            let res: Result[int32] = SimPipeWrite(pipe, side, sidB, BytesSlice(dataB, offB, n))
            if IsErr(res) || Value(res) != n:
                echo("pipe FAIL: interleaved write B")
                return 1
            offB = offB + n
        k = k + 1
    return 0

# Blocking-reads a stream in chunks and compares byte-exact with expected.
fn readCompare(pipe: int32, side: int32, sid: int64, expected: Bytes): int32 =
    var off: int32
    var k: int32
    let total: int32 = BytesLen(expected)
    while off < total:
        var n: int32 = k % 5 + 1
        if n > total - off:
            n = total - off
        let res: Result[Bytes] = SimPipeRead(pipe, side, sid, n)
        if IsErr(res):
            let err: str = ErrorText(res)
            echo(Fmt"pipe FAIL: readCompare err {err}")
            return 1
        let got: Bytes = Value(res)
        if BytesLen(got) != n:
            echo("pipe FAIL: readCompare short read")
            return 1
        if ! BytesEqual(got, BytesSlice(expected, off, n)):
            echo(Fmt"pipe FAIL: readCompare bytes mismatch off={off} n={n}")
            return 1
        off = off + n
        k = k + 1
    return 0

fn expectEmpty(pipe: int32, side: int32, sid: int64): int32 =
    let res: Result[Bytes] = SimPipeReadNonblocking(pipe, side, sid, 1)
    if ! IsErr(res):
        echo("pipe FAIL: expected empty queue")
        return 1
    let err: str = ErrorText(res)
    if err != "pipe: empty":
        echo(Fmt"pipe FAIL: expected pipe-empty, got {err}")
        return 1
    return 0

fn testInterleavedStreams(): int32 =
    SimNew(11)
    SimPipeReset()
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    SimSetLink(a, b, 1000, 0, 0)
    SimSetLink(b, a, 700, 0, 0)
    let openRes: Result[int32] = SimPipeOpen(a, b)
    if IsErr(openRes):
        echo("pipe FAIL: open")
        return 1
    let pipe: int32 = Value(openRes)
    let fwdA: Bytes = genData(1, 137)
    let fwdB: Bytes = genData(2, 101)
    let revA: Bytes = genData(3, 53)
    if writeInterleaved(pipe, 0, 4, fwdA, 9, fwdB) != 0:
        return 1
    # Reverse direction reuses stream id 4: must stay isolated from forward.
    let revRes: Result[int32] = SimPipeWrite(pipe, 1, 4, revA)
    if IsErr(revRes) || Value(revRes) != 53:
        echo("pipe FAIL: reverse write")
        return 1
    if readCompare(pipe, 1, 4, fwdA) != 0:
        return 1
    if readCompare(pipe, 1, 9, fwdB) != 0:
        return 1
    if readCompare(pipe, 0, 4, revA) != 0:
        return 1
    if expectEmpty(pipe, 1, 4) != 0 || expectEmpty(pipe, 1, 9) != 0 || expectEmpty(pipe, 0, 4) != 0:
        return 1
    echo("pipe ok 1: interleaved dual-stream FIFO byte-exact both directions")
    return 0

fn testNonblockingContract(): int32 =
    SimNew(2)
    SimPipeReset()
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    SimSetLink(a, b, 50, 0, 0)
    SimSetLink(b, a, 50, 0, 0)
    let openRes: Result[int32] = SimPipeOpen(a, b)
    if IsErr(openRes):
        echo("pipe FAIL: nb open")
        return 1
    let pipe: int32 = Value(openRes)
    if ! SimPipeIsIdx(pipe):
        echo("pipe FAIL: own idx not recognized")
        return 1
    if SimPipeIsIdx(1000001) || SimPipeIsIdx(0) || SimPipeIsIdx(pipe + 1):
        echo("pipe FAIL: idx segment leak")
        return 1
    if expectEmpty(pipe, 1, 1) != 0:
        return 1
    let payload: Bytes = genData(5, 3)
    let wRes: Result[int32] = SimPipeWrite(pipe, 0, 1, payload)
    if IsErr(wRes) || Value(wRes) != 3:
        echo("pipe FAIL: nb write")
        return 1
    SimRun()
    # Partial read: asks 10, gets the 3 delivered bytes.
    let pRes: Result[Bytes] = SimPipeReadNonblocking(pipe, 1, 1, 10)
    if IsErr(pRes):
        echo("pipe FAIL: nb partial read err")
        return 1
    let got: Bytes = Value(pRes)
    if BytesLen(got) != 3 || ! BytesEqual(got, payload):
        echo("pipe FAIL: nb partial read bytes")
        return 1
    if expectEmpty(pipe, 1, 1) != 0:
        return 1
    SimPipeClose(pipe)
    let cRes: Result[Bytes] = SimPipeReadNonblocking(pipe, 1, 1, 1)
    if ! IsErr(cRes):
        echo("pipe FAIL: read after close")
        return 1
    let cErr: str = ErrorText(cRes)
    if cErr != "pipe: closed":
        echo(Fmt"pipe FAIL: close contract, got {cErr}")
        return 1
    echo("pipe ok 2: nonblocking empty/partial, idx segment, close contract")
    return 0

fn testThousandRoundtrip(): int32 =
    SimNew(3)
    SimPipeReset()
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    SimSetLink(a, b, 250, 0, 0)
    SimSetLink(b, a, 250, 0, 0)
    let openRes: Result[int32] = SimPipeOpen(a, b)
    if IsErr(openRes):
        echo("pipe FAIL: rt open")
        return 1
    let pipe: int32 = Value(openRes)
    for r in 0..<1000:
        var msg: Bytes = BytesAlloc(8)
        for j in 0..<8:
            BytesSet(msg, j, (r * 13 + j * 5 + 1) & 255)
        let wRes: Result[int32] = SimPipeWrite(pipe, 0, 2, msg)
        if IsErr(wRes) || Value(wRes) != 8:
            echo("pipe FAIL: rt fwd write")
            return 1
        let fRes: Result[Bytes] = SimPipeRead(pipe, 1, 2, 8)
        if IsErr(fRes):
            echo("pipe FAIL: rt fwd read")
            return 1
        let fwd: Bytes = Value(fRes)
        if ! BytesEqual(fwd, msg):
            echo("pipe FAIL: rt fwd bytes")
            return 1
        let eRes: Result[int32] = SimPipeWrite(pipe, 1, 2, fwd)
        if IsErr(eRes) || Value(eRes) != 8:
            echo("pipe FAIL: rt echo write")
            return 1
        let bRes: Result[Bytes] = SimPipeRead(pipe, 0, 2, 8)
        if IsErr(bRes):
            echo("pipe FAIL: rt echo read")
            return 1
        if ! BytesEqual(Value(bRes), msg):
            echo("pipe FAIL: rt echo bytes")
            return 1
    let elapsed: int64 = SimNow()
    let pending: int32 = SimPendingCount()
    let delivered: int64 = SimDeliveredCount()
    echo(Fmt"pipe 3 roundtrip elapsedUs={elapsed} pending={pending} delivered={delivered}")
    if elapsed != 500000:
        echo("pipe FAIL: rt virtual time != 500000")
        return 1
    if pending != 0 || delivered != 2000:
        echo("pipe FAIL: rt event accounting")
        return 1
    echo("pipe ok 3: 1000-frame roundtrip exact virtual time")
    return 0

fn testPartitionUnderrun(): int32 =
    SimNew(4)
    SimPipeReset()
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    SimSetLink(a, b, 10, 0, 0)
    SimSetLink(b, a, 10, 0, 0)
    let cutRes: Result[bool] = SimSetPartitioned(a, b, true)
    if IsErr(cutRes):
        echo("pipe FAIL: partition set")
        return 1
    let openRes: Result[int32] = SimPipeOpen(a, b)
    if IsErr(openRes):
        echo("pipe FAIL: partition open")
        return 1
    let pipe: int32 = Value(openRes)
    for i in 0..<5:
        let wRes: Result[int32] = SimPipeWrite(pipe, 0, 6, genData(7, 4))
        if IsErr(wRes) || Value(wRes) != 4:
            echo("pipe FAIL: partition write")
            return 1
    let rRes: Result[Bytes] = SimPipeRead(pipe, 1, 6, 4)
    if ! IsErr(rRes):
        echo("pipe FAIL: partition read did not err")
        return 1
    let err: str = ErrorText(rRes)
    if err != "pipe: underrun":
        echo(Fmt"pipe FAIL: partition err text, got {err}")
        return 1
    let healRes: Result[bool] = SimSetPartitioned(a, b, false)
    if IsErr(healRes):
        echo("pipe FAIL: partition heal")
        return 1
    let healed: Bytes = genData(8, 4)
    let hwRes: Result[int32] = SimPipeWrite(pipe, 0, 6, healed)
    if IsErr(hwRes) || Value(hwRes) != 4:
        echo("pipe FAIL: healed write")
        return 1
    let hrRes: Result[Bytes] = SimPipeRead(pipe, 1, 6, 4)
    if IsErr(hrRes) || ! BytesEqual(Value(hrRes), healed):
        echo("pipe FAIL: healed read")
        return 1
    let now: int64 = SimNow()
    echo(Fmt"pipe 4 partition underrun=ok healedNowUs={now}")
    if now != 10:
        echo("pipe FAIL: healed delivery time != 10")
        return 1
    echo("pipe ok 4: partition underrun errs without hanging, then heals")
    return 0

fn fpChunk(tag: int32, i: int32, n: int32): Bytes =
    var out: Bytes = BytesAlloc(n)
    for j in 0..<n:
        BytesSet(out, j, (tag * 29 + i * 11 + j * 3) & 255)
    return out

fn fpWrite(pipe: int32, side: int32, sid: int64, tag: int32, i: int32, n: int32): int32 =
    let res: Result[int32] = SimPipeWrite(pipe, side, sid, fpChunk(tag, i, n))
    if IsErr(res) || Value(res) != n:
        return -1
    return n

fn fpReadLane(h: int64, pipe: int32, side: int32, sid: int64, total: int32): int64 =
    let res: Result[Bytes] = SimPipeRead(pipe, side, sid, total)
    if IsErr(res):
        return -1
    let got: Bytes = Value(res)
    var hh: int64 = fpMix(h, sid)
    for j in 0..<total:
        hh = fpMix(hh, int64(BytesGet(got, j)))
    return hh

# Two pipes off one hub node, jittery links: seed-dependent delivery order,
# rolling hash over every byte read plus final clock/delivery counters.
fn runPipeScenario(seed: int64): int64 =
    SimNew(seed)
    SimPipeReset()
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    let c: int32 = SimAddNode()
    SimSetLink(a, b, 300, 150, 0)
    SimSetLink(b, a, 450, 0, 0)
    SimSetLink(a, c, 200, 0, 0)
    SimSetLink(c, a, 350, 120, 0)
    let pabRes: Result[int32] = SimPipeOpen(a, b)
    let pacRes: Result[int32] = SimPipeOpen(a, c)
    if IsErr(pabRes) || IsErr(pacRes):
        return -1
    let pab: int32 = Value(pabRes)
    let pac: int32 = Value(pacRes)
    var totAB3: int32
    var totAB7: int32
    var totBA3: int32
    var totAC5: int32
    var totCA5: int32
    for i in 0..<60:
        let n: int32 = i % 6 + 1
        let w1: int32 = fpWrite(pab, 0, 3, 1, i, n)
        let w2: int32 = fpWrite(pab, 0, 7, 2, i, n)
        let w3: int32 = fpWrite(pab, 1, 3, 3, i, n)
        let w4: int32 = fpWrite(pac, 0, 5, 4, i, n)
        let w5: int32 = fpWrite(pac, 1, 5, 5, i, n)
        if w1 < 0 || w2 < 0 || w3 < 0 || w4 < 0 || w5 < 0:
            return -1
        totAB3 = totAB3 + w1
        totAB7 = totAB7 + w2
        totBA3 = totBA3 + w3
        totAC5 = totAC5 + w4
        totCA5 = totCA5 + w5
    var h: int64
    h = fpReadLane(h, pab, 1, 3, totAB3)
    if h < 0:
        return -1
    h = fpReadLane(h, pab, 1, 7, totAB7)
    if h < 0:
        return -1
    h = fpReadLane(h, pab, 0, 3, totBA3)
    if h < 0:
        return -1
    h = fpReadLane(h, pac, 1, 5, totAC5)
    if h < 0:
        return -1
    h = fpReadLane(h, pac, 0, 5, totCA5)
    if h < 0:
        return -1
    SimRun()
    let now: int64 = SimNow()
    let delivered: int64 = SimDeliveredCount()
    h = fpMix(h, now)
    h = fpMix(h, delivered)
    return h

fn testFingerprint(): int32 =
    let fpA: int64 = runPipeScenario(21)
    let fpB: int64 = runPipeScenario(21)
    let fpC: int64 = runPipeScenario(22)
    echo(Fmt"pipe 5 fingerprint seed21a={fpA} seed21b={fpB} seed22={fpC}")
    if fpA < 0 || fpC < 0:
        echo("pipe FAIL: fingerprint scenario error")
        return 1
    if fpA != fpB:
        echo("pipe FAIL: same-seed fingerprint mismatch")
        return 1
    if fpA == fpC:
        echo("pipe FAIL: different-seed fingerprint identical")
        return 1
    # Pinned value = cross-process determinism witness for seed 21.
    if fpA != 569752707:
        echo("pipe FAIL: seed21 fingerprint drifted from pinned 569752707")
        return 1
    echo("pipe ok 5: deterministic read-byte fingerprint")
    return 0

fn main(): int32 =
    if testInterleavedStreams() != 0:
        return 1
    if testNonblockingContract() != 0:
        return 1
    if testThousandRoundtrip() != 0:
        return 1
    if testPartitionUnderrun() != 0:
        return 1
    if testFingerprint() != 0:
        return 1
    echo("netsim pipe smoke: all 5 checks passed")
    return 0
