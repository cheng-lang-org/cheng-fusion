# Tor transport smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/tortransport
fn runTorTransportSmoke(): Result[bool] =
    var t: TorTransport = initTorTransport()
    let addrRes: Result[MultiAddress] = parseMultiAddress("/onion/aaaaaaaaaaaaaaaa:1234")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    start(t, addr)
    let dialRes: Result[Connection] = dial(t, addr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    let outbound: Connection = Value(dialRes)
    if ConnectionDirection(outbound) != Outbound:
        return Err[bool]("smoke: tor outbound direction mismatch")
    if ! ConnectionIsOpen(outbound):
        return Err[bool]("smoke: tor outbound ! open")
    let acceptRes: Result[Connection] = accept(t)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    let inbound: Connection = Value(acceptRes)
    if ConnectionDirection(inbound) != Inbound:
        return Err[bool]("smoke: tor inbound direction mismatch")
    if ! ConnectionIsOpen(inbound):
        return Err[bool]("smoke: tor inbound ! open")
    let localText: str = toString(LocalAddress(outbound))
    let remoteText: str = toString(RemoteAddress(outbound))
    if ! StrContains(localText, "/onion/"):
        return Err[bool]("smoke: tor outbound local addr missing onion")
    if ! StrContains(remoteText, "/onion/"):
        return Err[bool]("smoke: tor outbound remote addr missing onion")
    return Ok[bool](true)
