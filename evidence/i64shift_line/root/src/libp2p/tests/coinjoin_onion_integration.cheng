# CoinJoin onion + onionpay integration test.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/crypto/coinjoin/types
import cheng/libp2p/crypto/coinjoin/onion
import cheng/libp2p/protocols/onionpay
import cheng/libp2p/peerid
import cheng/libp2p/tests/test_utils
fn runCoinjoinOnionIntegration(): Result[bool] =
    let seedRes: Result[bool] = seedTestRng("coinjoin-onion-integration")
    if ! seedRes.ok:
        return ErrInfo[bool](seedRes.err)
    let seedRes32: CoinJoinResult[OnionSeed] = makeOnionSeed(fixedBytes(32, 3))
    if ! seedRes32.ok:
        return ErrInfo[bool](seedRes32.err)
    let payload: Bytes = BytesFromString("bridge")
    let ctxRes: CoinJoinResult[OnionRouteCtx] = onion.initRouteCtx(seedRes32.value, 9, "user", 2, payload)
    if ! ctxRes.ok:
        return ErrInfo[bool](ctxRes.err)

    let peer1Res: Result[PeerId] = randomPeerId()
    if ! peer1Res.ok:
        return ErrInfo[bool](peer1Res.err)
    let peer2Res: Result[PeerId] = randomPeerId()
    if ! peer2Res.ok:
        return ErrInfo[bool](peer2Res.err)

    var hops: OnionHopList = initHopList()
    let add1: Result[bool] = hopListAdd(
        hops,
        OnionRouteHop(peer: peer1Res.value, secret: EmptyBytes(), ttl: 5)
    )
    if ! add1.ok:
        return ErrInfo[bool](add1.err)
    let add2: Result[bool] = hopListAdd(
        hops,
        OnionRouteHop(peer: peer2Res.value, secret: EmptyBytes(), ttl: 5)
    )
    if ! add2.ok:
        return ErrInfo[bool](add2.err)

    let route: OnionRoute = OnionRoute(id: randomRouteId(), hops: hops)
    let packetRes: CoinJoinResult[OnionPacket] = onion.toOnionPacket(ctxRes.value, route)
    if ! packetRes.ok:
        return ErrInfo[bool](packetRes.err)
    let packet: OnionPacket = packetRes.value
    if BytesLen(packet.payload) <= 0:
        return Err[bool]("integration: onionpay payload empty")

    let cjRes: CoinJoinResult[CoinJoinOnionPacket] = onion.fromOnionPacket(packet)
    if ! cjRes.ok:
        return ErrInfo[bool](cjRes.err)
    let routeIdRes: CoinJoinResult[int64] = onion.fromProtocolRouteId(route.id)
    if ! routeIdRes.ok:
        return ErrInfo[bool](routeIdRes.err)
    if cjRes.value.routeId != routeIdRes.value:
        return Err[bool]("integration: route id mismatch")
    return Ok[bool](true)
