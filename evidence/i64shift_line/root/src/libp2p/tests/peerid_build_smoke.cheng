# PeerId build smoke(debug multihash/base58).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/crypto
import cheng/libp2p/multihash
import cheng/libp2p/multicodec
import cheng/libp2p/multibase
import cheng/libp2p/peerid

fn main(): int32 =
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        echo("peerid build smoke failed: " + Error(kpRes))
        return 1
    let kp: KeyPair = Value(kpRes)
    let pubBytesRes: Result[Bytes] = encodePublicKey(kp.publicKey)
    if IsErr(pubBytesRes):
        echo("peerid build smoke failed: " + Error(pubBytesRes))
        return 1
    let pubBytes: Bytes = Value(pubBytesRes)
    echo("pubBytes.len=" + $(BytesLen(pubBytes)))

    let mhRes: Result[MultiHash] = Digest(pubBytes, codecIdentity)
    if IsErr(mhRes):
        echo("peerid build smoke failed: " + Error(mhRes))
        return 1
    let mh: MultiHash = Value(mhRes)
    let mhBytes: Bytes = EncodeMultihash(mh)
    echo("mhBytes.len=" + $(BytesLen(mhBytes)))
    echo("mhBytes.hex=" + BytesToHex(mhBytes))

    let text: str = encodeBase58(mhBytes)
    echo("b58.len=" + $(len(text)))
    echo("b58=" + text)
    let directPid: PeerId = peerIdFromTextUnchecked(text)
    let directText: str = peerid.toString(directPid)
    echo("directPid.len=" + $(len(directText)))
    let wrapRes: Result[PeerId] = Ok[PeerId](directPid)
    let wrapText: str = peerid.toString(Value(wrapRes))
    echo("wrapPid.len=" + $(len(wrapText)))

    let pidRes: Result[PeerId] = peerIdFromPublicKey(kp.publicKey)
    if IsErr(pidRes):
        echo("peerid build smoke failed: " + Error(pidRes))
        return 1
    let pidText: str = peerid.toString(Value(pidRes))
    echo("peerId.len=" + $(len(pidText)))
    echo("peerId=" + pidText)
    return 0
