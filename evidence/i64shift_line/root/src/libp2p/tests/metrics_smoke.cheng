# Metrics smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/services/metricsservice
fn runMetricsSmoke(): Result[bool] =
    setMetricsConfig(initMetricsConfig())
    resetMetrics()
    let incRes: Result[bool] = metricsInc("requests_total", 3)
    if IsErr(incRes):
        return Err[bool](Error(incRes))
    let gaugeRes: Result[bool] = metricsSetGauge("inflight", 7)
    if IsErr(gaugeRes):
        return Err[bool](Error(gaugeRes))
    let getRes: Result[Metric] = metricsGet("requests_total")
    if IsErr(getRes):
        return Err[bool](Error(getRes))
    let metric: Metric = Value(getRes)
    if metric.value != 3:
        return Err[bool]("smoke: counter value mismatch")
    let dump: str = metricsDump()
    if ! StrContains(dump, "requests_total=counter:3"):
        return Err[bool]("smoke: counter dump mismatch")
    if ! StrContains(dump, "inflight=gauge:7"):
        return Err[bool]("smoke: gauge dump mismatch")
    return Ok[bool](true)
