# #98 poison companion: genuinely unresolvable bare identifier (not declared
# as a const anywhere reachable from this file's own three-hop import
# closure) used as a fixed-array size, at the same relay depth as
# constresidual98_lib.cheng's positive case. Must die loudly at compile
# time, never silently default to a wrong/zero length (mirrors
# constfor90_poison_lib.cheng's single-hop poison contract, extended to the
# three-hop relay topology).
import cheng/libp2p/tests/constresidual98_mid1

var
    gConstResidual98PoisonArr: int32[thisConstDoesNotExistAnywhereViaRelay98]

fn ConstResidual98PoisonArraySize(): int32 =
    var s: int32 = 0
    var i: int32 = 0
    for i in 0..<4:
        gConstResidual98PoisonArr[i] = i + 1
        s = s + gConstResidual98PoisonArr[i]
    return s
