# Pnet smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/pnet
fn runPnetSmoke(): Result[bool] =
    var key: Bytes = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(key, i, i)
    let setRes: Result[bool] = setPnetKey(key)
    if IsErr(setRes):
        return Err[bool](Error(setRes))
    let data: Bytes = BytesFromString("pnet")
    let encRes: Result[Bytes] = pnetProtect(data)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let decRes: Result[Bytes] = pnetUnprotect(Value(encRes))
    if IsErr(decRes):
        return Err[bool](Error(decRes))
    if ! BytesEqual(Value(decRes), data):
        return Err[bool]("smoke: pnet roundtrip mismatch")
    let token: Bytes = pnetToken()
    if ! pnetCheckToken(token):
        return Err[bool]("smoke: pnet token check failed")
    var bad: Bytes = BytesAlloc(16)
    BytesSet(bad, 0, 1)
    if pnetCheckToken(bad):
        return Err[bool]("smoke: pnet token accepted wrong")
    return Ok[bool](true)
