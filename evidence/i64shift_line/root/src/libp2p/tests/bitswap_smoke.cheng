# Bitswap smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multicodec
import cheng/libp2p/multihash
import cheng/libp2p/cid
import cheng/libp2p/protocols/bitswap/protobuf as bitswapprotobuf
import cheng/libp2p/protocols/bitswap/bitswap
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runBitswapSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/10")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    setBitswapLedger(initBitswapLedger())
    var cfg: BitswapConfig = initBitswapConfig()
    cfg.enableLedger = true
    setBitswapConfig(cfg)
    let data: Bytes = BytesFromString("bitswap-smoke-data")
    let mhRes: Result[MultiHash] = Digest(data, codecSha2_256)
    if IsErr(mhRes):
        return Err[bool](Error(mhRes))
    let cid: Cid = Cid(version: 1, codec: codecRaw, multihash: Value(mhRes))
    let putRes: Result[bool] = bitswapPutBlock(cid, data)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    var entry: WantEntry = initWantEntry()
    entry.hasCid = true
    entry.cid = cid
    entry.wantType = wtBlock
    entry.priority = 1
    entry.sendDontHave = true
    var list: Wantlist = initWantlist()
    list.entries[0] = entry
    list.entryCount = 1
    var msg: BitswapMessage = initBitswapMessage()
    msg.hasWantlist = true
    msg.wantlist = list
    let writeRes: Result[bool] = writeBitswapMessage(outStream, msg)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = bitswapHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let replyRes: Result[BitswapMessage] = readBitswapMessage(outStream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let reply: BitswapMessage = Value(replyRes)
    if reply.blockCount <= 0:
        return Err[bool]("smoke: bitswap reply missing block")
    if ! BytesEqual(reply.blocks[0], data):
        return Err[bool]("smoke: bitswap block mismatch")
    let peerText: str = RemotePeerId(muxerConnection(outboundMux))
    if len(peerText) <= 0:
        return Err[bool]("smoke: bitswap missing peer id")
    let peerRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(peerRes):
        return Err[bool](Error(peerRes))
    let ledgerRes: Result[BitswapPeerLedger] = bitswapLedgerEntry(Value(peerRes))
    if IsErr(ledgerRes):
        return Err[bool](Error(ledgerRes))
    let ledgerEntry: BitswapPeerLedger = Value(ledgerRes)
    if ledgerEntry.wantsSent <= 0 || ledgerEntry.wantsReceived <= 0:
        return Err[bool]("smoke: bitswap ledger wants mismatch")
    if ledgerEntry.bytesSent <= 0 || ledgerEntry.bytesReceived <= 0:
        return Err[bool]("smoke: bitswap ledger bytes mismatch")
    if ledgerEntry.blocksSent <= 0 || ledgerEntry.blocksReceived <= 0:
        return Err[bool]("smoke: bitswap ledger blocks mismatch")
    if ledgerEntry.haveSent <= 0 || ledgerEntry.haveReceived <= 0:
        return Err[bool]("smoke: bitswap ledger have mismatch")
    return Ok[bool](true)
