import std/strings

fn main(): int32 =
    echo(IntToStr(len("linux")))
    if len("linux") > 0:
        echo("gt=1")
    else:
        echo("gt=0")
    if len("linux") == 5:
        echo("eq=1")
    else:
        echo("eq=0")
    if len("linux") < 10:
        echo("lt=1")
    else:
        echo("lt=0")
    return 0
