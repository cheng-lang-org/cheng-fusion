# Synccast control smoke test(main entry).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_control_smoke
fn main(): int32 =
    let res: Result[bool] = runSynccastControlSmoke()
    if IsErr(res):
        echo("synccast control smoke failed: " + Error(res))
        return 1
    echo("synccast control smoke ok")
    return 0

