# Global scale profile smoke.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/builders
import cheng/libp2p/networkprofile
import cheng/libp2p/protocols/kademlia/consts
import cheng/libp2p/protocols/connectivity/relay/utils
import cheng/libp2p/switch

fn buildTier(addrText: str, tier: NodeTier): Result[Switch] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, addrText)
    if IsErr(addrRes):
        return Err[Switch](Error(addrRes))
    withNodeTier(builder, tier)
    return build(builder)

fn runGlobalScaleProfileSmoke(): Result[bool] =
    let l1Res: Result[Switch] = buildTier("/memory/310", ntL1Core)
    if IsErr(l1Res):
        return Err[bool](Error(l1Res))
    let l2Res: Result[Switch] = buildTier("/memory/311", ntL2Routing)
    if IsErr(l2Res):
        return Err[bool](Error(l2Res))
    let l3Res: Result[Switch] = buildTier("/memory/312", ntL3Edge)
    if IsErr(l3Res):
        return Err[bool](Error(l3Res))
    let l1: Switch = Value(l1Res)
    let l2: Switch = Value(l2Res)
    let l3: Switch = Value(l3Res)

    let l1Proto: str = supportedProtocols(l1)
    let l2Proto: str = supportedProtocols(l2)
    let l3Proto: str = supportedProtocols(l3)

    if ! StrContains(l1Proto, kadCodec):
        return Err[bool]("global-profile: L1 missing kad protocol")
    if ! StrContains(l1Proto, relayCodec):
        return Err[bool]("global-profile: L1 missing relay protocol")

    if ! StrContains(l2Proto, kadCodec):
        return Err[bool]("global-profile: L2 missing kad protocol")
    if StrContains(l2Proto, relayCodec):
        return Err[bool]("global-profile: L2 should disable relay server")

    if StrContains(l3Proto, kadCodec):
        return Err[bool]("global-profile: L3 should disable kad server path")
    if StrContains(l3Proto, relayCodec):
        return Err[bool]("global-profile: L3 should disable relay server")

    if switchNodeTier(l3) != ntL3Edge:
        return Err[bool]("global-profile: L3 tier mismatch")
    if switchKademliaMode(l3) != dhtClient:
        return Err[bool]("global-profile: L3 should be dht client")
    return Ok[bool](true)

fn main(): int32 =
    let smokeRes: Result[bool] = runGlobalScaleProfileSmoke()
    if IsErr(smokeRes):
        echo("global scale profile smoke failed")
        echo(Error(smokeRes))
        return 1
    echo("global scale profile smoke ok")
    return 0
