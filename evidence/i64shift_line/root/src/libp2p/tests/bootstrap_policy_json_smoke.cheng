# Bootstrap policy json smoke (mobile ffi json getter/setter path).

import cheng/runtime/json_ast as jsonast
import cheng/libp2p/mobile_ffi/unimaker_compat_ffi

fn jsonGetField(node: jsonast.JsonNode, key: str): jsonast.JsonNode =
    if node == nil || len(key) <= 0:
        return jsonast.jsonNil()
    if !jsonast.hasKey(node, key):
        return jsonast.jsonNil()
    return node[key]

fn jsonGetI64(node: jsonast.JsonNode, key: str, fallback: int64): int64 =
    let field: jsonast.JsonNode = jsonGetField(node, key)
    if field == nil:
        return fallback
    if field.kind == jsonast.JInt:
        return field.getInt()
    if field.kind == jsonast.JFloat:
        return int64(field.getFloat())
    return fallback

fn jsonGetBool(node: jsonast.JsonNode, key: str, fallback: bool): bool =
    let field: jsonast.JsonNode = jsonGetField(node, key)
    if field == nil:
        return fallback
    if field.kind == jsonast.JBool:
        return field.getBool()
    return fallback

fn jsonGetStr(node: jsonast.JsonNode, key: str, fallback: str): str =
    let field: jsonast.JsonNode = jsonGetField(node, key)
    if field == nil:
        return fallback
    if field.kind == jsonast.JString:
        return field.getStr()
    return fallback

fn jsonGetStrArray(node: jsonast.JsonNode, key: str): str[] =
    let field: jsonast.JsonNode = jsonGetField(node, key)
    if field == nil || field.kind != jsonast.JArray:
        var empty: str[]
        return empty
    var out: str[]
    let itemCount: int32 = len(field.a)
    for i in 0..<itemCount:
        let item: jsonast.JsonNode = field.a[i]
        if item == nil || item.kind != jsonast.JString:
            continue
        out.add(jsonast.getStr(item))
    return out

fn runBootstrapPolicyJsonSmokeCode(): int32 =
    let policyNode: jsonast.JsonNode = parseBootstrapPolicyNode(
        "{\"tick_seconds\":11,\"bootstrap_tick_seconds\":22,\"require_trusted_publisher\":true,\"trusted_publishers\":[\"p1\",\"p2\"]}"
    )
    if jsonGetI64(policyNode, "tick_seconds", -1) != 11:
        return 1
    if jsonGetI64(policyNode, "bootstrap_tick_seconds", -1) != 22:
        return 2
    if !jsonGetBool(policyNode, "require_trusted_publisher", false):
        return 3
    if jsonGetI64(policyNode, "missing", 7) != 7:
        return 4

    let trusted: str[] = jsonStringArrayField(policyNode, "trusted_publishers")
    if len(trusted) != 2 || trusted[0] != "p1" || trusted[1] != "p2":
        return 5
    let trustedStd: str[] = jsonGetStrArray(policyNode, "trusted_publishers")
    if len(trustedStd) != 2 || trustedStd[0] != "p1" || trustedStd[1] != "p2":
        return 8

    var eventNode: jsonast.JsonNode = jsonast.newJObject()
    eventNode["topic"] = "/unimaker/bootstrap/v1"
    eventNode["tickSeconds"] = int64(22)
    eventNode["requireTrustedPublisher"] = true
    if jsonGetI64(eventNode, "tickSeconds", 0) != 22:
        return 6
    if !jsonGetBool(eventNode, "requireTrustedPublisher", false):
        return 7
    let missingTrusted: str[] = jsonGetStrArray(eventNode, "trusted_publishers")
    if len(missingTrusted) != 0:
        return 9
    let invalidPolicyNode: jsonast.JsonNode = parseBootstrapPolicyNode("{\"tick_seconds\":}")
    if jsonGetI64(invalidPolicyNode, "tick_seconds", 19) != 19:
        return 10
    let invalidTrusted: str[] = jsonGetStrArray(invalidPolicyNode, "trusted_publishers")
    if len(invalidTrusted) != 0:
        return 11
    let announcementNode: jsonast.JsonNode = parseBootstrapAnnouncementNode("{\"publisher_peer_id\":\"pX\"}")
    if jsonGetStr(announcementNode, "publisher_peer_id", "") != "pX":
        return 12
    if parseBootstrapAnnouncementPublisherPeerId("{\"publisher_peer_id\":\"pY\"}") != "pY":
        return 13
    if parseBootstrapAnnouncementPublisherPeerId("{bad}") != "":
        return 14
    return 0

fn main(): int32 =
    return runBootstrapPolicyJsonSmokeCode()
