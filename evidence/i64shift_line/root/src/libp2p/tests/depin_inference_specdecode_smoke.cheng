# DePIN inference speculative decode smoke(accepted prefix + rollback).

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/depin/inference_manifest
import cheng/libp2p/protocols/depin/inference_specdecode

fn buildManualSpecdecodeSession(reqRaw: inference_manifest.DepinInferenceRequest,
                                cfgRaw: inference_manifest.DepinInferenceConfig): inference_manifest.DepinInferenceSession =
    var req: inference_manifest.DepinInferenceRequest = reqRaw
    var cfg: inference_manifest.DepinInferenceConfig = cfgRaw
    var session = inference_manifest.DepinInferenceInitSession(req, cfg)
    session.sessionId = "sid:depin:specdecode"
    session.started = true
    return session

fn runDepinInferenceSpecdecodeSmoke(): Result[bool] =
    var req = inference_manifest.DepinInferenceRequest(
        requestId: "req:depin:specdecode",
        modelCid: "cid:model:specdecode",
        promptRef: "prompt:specdecode",
        layerCids: ["cid:layer:specdecode"],
        preferredPeers: ["peer:specdecode"],
        riskLevel: "base"
    )
    var cfg = inference_manifest.DepinInferenceConfig(
        hiddenStateFrameBytes: 8192,
        stageTimeoutMs: 30000,
        specDraftWindow: 5,
        auditBaseBps: 100,
        auditHighRiskBps: 1000,
        mmapReadonlyPreferred: true
    )
    var session: inference_manifest.DepinInferenceSession = buildManualSpecdecodeSession(req, cfg)

    var draft: str[]
    add(draft, "a")
    add(draft, "b")
    add(draft, "c")
    add(draft, "d")
    add(draft, "e")

    var target: str[]
    add(target, "a")
    add(target, "b")
    add(target, "x")
    add(target, "d")
    add(target, "e")

    let verifyRes: inference_specdecode.DepinSpecDecodeResult =
        inference_specdecode.DepinSpecDecodeVerifyCounted(draft, 5, target, 5, 5)
    if ! verifyRes.mismatch:
        return Err[bool]("depin specdecode smoke: mismatch expected")
    if verifyRes.rollbackFrom != verifyRes.acceptedPrefixLen:
        return Err[bool]("depin specdecode smoke: rollback/prefix mismatch")
    if verifyRes.acceptedPrefixLen < 0 || verifyRes.acceptedPrefixLen >= len(draft):
        return Err[bool]("depin specdecode smoke: accepted prefix out of range")

    session.specDecodeCertifiedReceiptHash = int64(12345)
    let applyRes: inference_specdecode.DepinSpecDecodeResult =
        inference_specdecode.DepinSpecDecodeApplyCounted(session, draft, 5, target, 5)
    if ! applyRes.mismatch:
        return Err[bool]("depin specdecode smoke: apply mismatch")
    if applyRes.rollbackFrom != applyRes.acceptedPrefixLen:
        return Err[bool]("depin specdecode smoke: apply rollback/prefix mismatch")
    if session.acceptedPrefixLen != applyRes.acceptedPrefixLen || session.rollbackFrom != applyRes.rollbackFrom:
        return Err[bool]("depin specdecode smoke: session state mismatch")
    if session.specDecodeCertifiedReceiptHash != int64(0):
        return Err[bool]("depin specdecode smoke: legacy apply proof hash")

    var matchedDraft: str[]
    add(matchedDraft, "m")
    add(matchedDraft, "n")
    var matchedTarget: str[]
    add(matchedTarget, "m")
    add(matchedTarget, "n")
    let matchRes: inference_specdecode.DepinSpecDecodeResult =
        inference_specdecode.DepinSpecDecodeVerifyCounted(matchedDraft, 2, matchedTarget, 2, 5)
    if matchRes.mismatch:
        return Err[bool]("depin specdecode smoke: full match should not mismatch")
    if matchRes.acceptedPrefixLen != len(matchedDraft):
        return Err[bool]("depin specdecode smoke: full match prefix mismatch")
    if matchRes.rollbackFrom != len(matchedDraft):
        return Err[bool]("depin specdecode smoke: full match rollback mismatch")

    return Ok[bool](true)
