# DID auth routing gate smoke.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/builders
import cheng/libp2p/networkprofile
import cheng/libp2p/switch

fn runDidAuthRoutingGateSmoke(): Result[bool] =
    var routingBuilder: SwitchBuilder = newSwitchBuilder()
    let routingAddrRes: Result[bool] = withAddressText(routingBuilder, "/memory/370")
    if IsErr(routingAddrRes):
        return Err[bool](Error(routingAddrRes))
    withNodeTier(routingBuilder, ntL2Routing)
    let routingRes: Result[Switch] = build(routingBuilder)
    if IsErr(routingRes):
        return Err[bool](Error(routingRes))
    var routing: Switch = Value(routingRes)

    var edgeBuilder: SwitchBuilder = newSwitchBuilder()
    let edgeAddrRes: Result[bool] = withAddressText(edgeBuilder, "/memory/371")
    if IsErr(edgeAddrRes):
        return Err[bool](Error(edgeAddrRes))
    let edgeRes: Result[Switch] = build(edgeBuilder)
    if IsErr(edgeRes):
        return Err[bool](Error(edgeRes))
    var edge: Switch = Value(edgeRes)

    let startRoutingRes: Result[bool] = start(routing)
    if IsErr(startRoutingRes):
        return Err[bool](Error(startRoutingRes))
    let startEdgeRes: Result[bool] = start(edge)
    if IsErr(startEdgeRes):
        return Err[bool](Error(startEdgeRes))

    let dialRes: Result[Muxer] = dial(edge, routing.listenAddr)
    if IsErr(dialRes):
        if ! StrContains(Error(dialRes), "didauth"):
            return Err[bool]("didauth-gate: unexpected dial failure reason")
        return Ok[bool](true)

    let acceptRes: Result[Muxer] = accept(routing)
    if IsOk(acceptRes):
        return Err[bool]("didauth-gate: routing node should reject unauthenticated dial")
    if ! StrContains(Error(acceptRes), "didauth"):
        return Err[bool]("didauth-gate: unexpected accept failure reason")
    return Ok[bool](true)

fn main(): int32 =
    let smokeRes: Result[bool] = runDidAuthRoutingGateSmoke()
    if IsErr(smokeRes):
        echo("didauth routing gate smoke failed")
        echo(Error(smokeRes))
        return 1
    echo("didauth routing gate smoke ok")
    return 0
