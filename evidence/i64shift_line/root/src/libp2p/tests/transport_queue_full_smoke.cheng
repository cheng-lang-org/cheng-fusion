# Transport queue full cleanup smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/transports/memorymanager
const
    transportQueueFullConnCount = 64

fn runTransportQueueFullSmoke(): Result[bool] =
    var cfg: TransportMemoryConfig = initTransportMemoryConfig()
    cfg.enabled = true
    cfg.limitBytes = 0
    setTransportMemoryConfig(cfg)
    resetTransportMemoryStats()
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/2")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    var t: MemoryTransport = initMemoryTransport()
    start(t, addr)
    var outConns: Connection[transportQueueFullConnCount]
    for i in 0..<transportQueueFullConnCount:
        let dialRes: Result[Connection] = dial(t, addr)
        if IsErr(dialRes):
            return Err[bool](Error(dialRes))
        outConns[i] = Value(dialRes)
    let usedBefore: int64 = transportMemoryUsed()
    if usedBefore <= 0:
        return Err[bool]("smoke: queue memory ! reserved")
    let fullRes: Result[Connection] = dial(t, addr)
    if ! IsErr(fullRes):
        return Err[bool]("smoke: expected queue full")
    let usedAfter: int64 = transportMemoryUsed()
    if usedAfter != usedBefore:
        return Err[bool]("smoke: queue memory changed on full")
    stop(t)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: queue memory ! released on stop")
    for j in 0..<transportQueueFullConnCount:
        var conn: Connection = outConns[j]
        close(conn)
        outConns[j] = conn
    return Ok[bool](true)
