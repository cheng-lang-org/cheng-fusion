# mobile ffi bootstrap-first discovery smoke (real host path).

import cheng/libp2p/mobile_ffi/unimaker_compat_ffi_real_smoke

fn hasToken(text: str, token: str): bool =
    return indexOf(text, token, 0) >= 0

fn main(): int32 =
    NimMain()

    let cfg1: str = "{\"dataDir\":\"/tmp/mobile_ffi_bootstrap_real_1\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4101/quic-v1\"}"
    let cfg2: str = "{\"dataDir\":\"/tmp/mobile_ffi_bootstrap_real_2\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4102/quic-v1\"}"

    let node1: int64 = libp2p_node_init(cfg1)
    if node1 <= 0:
        return 11
    if libp2p_node_start(node1) != 0:
        return 12

    let node2: int64 = libp2p_node_init(cfg2)
    if node2 <= 0:
        return 13
    if libp2p_node_start(node2) != 0:
        return 14

    let peer2: str = trimText(libp2p_get_local_peer_id(node2))
    if len(peer2) <= 0:
        return 15

    let dialable2Json: str = libp2p_get_dialable_addresses(node2)
    if len(dialable2Json) <= 0 || !hasToken(dialable2Json, "/quic-v1"):
        return 16

    let policyJson: str = "{\"bootstrap_peers\":" + dialable2Json + ",\"bootstrap_tick_seconds\":5,\"bootstrap_random_n\":1}"
    if !libp2p_bootstrap_set_policy(node1, policyJson):
        return 17

    if !libp2p_mdns_set_enabled(node1, false):
        return 18
    let tickNoMdns: str = libp2p_bootstrap_tick(node1)
    if len(tickNoMdns) <= 0 || !hasToken(tickNoMdns, "\"ok\":true"):
        return 19

    if !libp2p_mdns_set_enabled(node1, true):
        return 20
    if !libp2p_mdns_probe(node1):
        return 21
    let tickWithMdns: str = libp2p_bootstrap_tick(node1)
    if len(tickWithMdns) <= 0 || !hasToken(tickWithMdns, "\"ok\":true"):
        return 22

    if libp2p_node_stop(node2) != 0:
        return 23
    libp2p_node_free(node2)

    if libp2p_node_stop(node1) != 0:
        return 24
    libp2p_node_free(node1)

    return 0
