# Gossipsub consumer mode smoke.

import cheng/libp2p/utils/result
import cheng/libp2p/builders
import cheng/libp2p/networkprofile
import cheng/libp2p/protocols/pubsub/gossipsub
import cheng/libp2p/switch
import cheng/libp2p/utils/bytes

fn runGossipsubConsumerModeSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/350")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    withNodeTier(builder, ntL3Edge)
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)

    if gossipsubRoutingEnabled():
        return Err[bool]("gossipsub-consumer: routing should be disabled for L3")
    let subRes: Result[bool] = gossipsubSubscribe("topic-consumer")
    if IsErr(subRes):
        return Err[bool](Error(subRes))
    let addRes: Result[bool] = gossipsubAddMeshPeer("topic-consumer", sw.peerId)
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    if Value(addRes):
        return Err[bool]("gossipsub-consumer: L3 should not join mesh routing")
    if gossipsubMeshPeerCountForTopic("topic-consumer") != 0:
        return Err[bool]("gossipsub-consumer: mesh peer count should remain zero")
    let pubRes: Result[bool] = gossipsubPublish(sw, "topic-consumer", BytesFromString("hello"))
    if IsOk(pubRes):
        return Err[bool]("gossipsub-consumer: publish should be blocked in consumer mode")
    return Ok[bool](true)

fn main(): int32 =
    let smokeRes: Result[bool] = runGossipsubConsumerModeSmoke()
    if IsErr(smokeRes):
        echo("gossipsub consumer mode smoke failed")
        echo(Error(smokeRes))
        return 1
    echo("gossipsub consumer mode smoke ok")
    return 0
