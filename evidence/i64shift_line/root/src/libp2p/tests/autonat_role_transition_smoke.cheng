# AutoNAT role transition smoke.

import cheng/libp2p/utils/result
import cheng/libp2p/builders
import cheng/libp2p/networkprofile
import cheng/libp2p/switch

fn runAutonatRoleTransitionSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/330")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    withNodeTier(builder, ntL3Edge)
    withAutoRolePromotionEnabled(builder, true)
    let hostRes: Result[Switch] = build(builder)
    if IsErr(hostRes):
        return Err[bool](Error(hostRes))
    var sw: Switch = Value(hostRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))

    for i in 0..<3:
        let stepRes: Result[NodeTier] = hostAutonatAssessAndApplyRole(sw, sw.peerId)
        if IsErr(stepRes):
            return Err[bool](Error(stepRes))
    if switchNodeTier(sw) != ntL2Routing:
        return Err[bool]("autonat-role: expected promotion to L2 after 3 public probes")

    sw.hasAddr = false
    for i in 0..<3:
        let stepRes: Result[NodeTier] = hostAutonatAssessAndApplyRole(sw, sw.peerId)
        if IsErr(stepRes):
            return Err[bool](Error(stepRes))
    if switchNodeTier(sw) != ntL2Routing:
        return Err[bool]("autonat-role: cooldown should prevent immediate demotion")

    sw.autoRoleState.lastTransitionMs = sw.autoRoleState.lastTransitionMs - sw.globalProfile.roleCooldownMs - 1
    for i in 0..<3:
        let stepRes: Result[NodeTier] = hostAutonatAssessAndApplyRole(sw, sw.peerId)
        if IsErr(stepRes):
            return Err[bool](Error(stepRes))
    if switchNodeTier(sw) != ntL3Edge:
        return Err[bool]("autonat-role: expected demotion to L3 after cooldown + 3 private probes")
    return Ok[bool](true)

fn main(): int32 =
    let smokeRes: Result[bool] = runAutonatRoleTransitionSmoke()
    if IsErr(smokeRes):
        echo("autonat role transition smoke failed")
        echo(Error(smokeRes))
        return 1
    echo("autonat role transition smoke ok")
    return 0
