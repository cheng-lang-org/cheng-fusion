# Smoke test entry runner (main wrapper).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/smoke_runner
fn main(): int32 =
    let res: Result[bool] = runAllSmokes()
    if IsErr(res):
        echo("smoke runner failed")
        echo(Error(res))
        return 1
    echo("smoke runner ok")
    return 0
