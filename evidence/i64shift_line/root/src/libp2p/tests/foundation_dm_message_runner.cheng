# Foundation DM message runner(real path).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/dm_smoke
import cheng/libp2p/tests/dm_envelope_smoke
import cheng/libp2p/tests/mdns_host_dm_smoke
fn runFoundationDmMessage(): Result[bool] =
    let dmRes: Result[bool] = runDmSmoke()
    if IsErr(dmRes):
        return Err[bool]("foundation_dm: dm_smoke: " + Error(dmRes))
    let envRes: Result[bool] = runDmEnvelopeSmoke()
    if IsErr(envRes):
        return Err[bool]("foundation_dm: envelope: " + Error(envRes))
    let hostRes: Result[bool] = runMdnsHostDmSmoke()
    if IsErr(hostRes):
        return Err[bool]("foundation_dm: host_dm: " + Error(hostRes))
    return Ok[bool](true)

fn main(): int32 =
    let runRes: Result[bool] = runFoundationDmMessage()
    if IsErr(runRes):
        echo("foundation dm message failed")
        echo(Error(runRes))
        return 1
    echo("foundation dm message ok")
    return 0
