# Services smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/services/metricsservice
import cheng/libp2p/services/autorelayservice
import cheng/libp2p/services/hpservice
import cheng/libp2p/services/wildcardresolverservice
fn runServicesSmoke(): Result[bool] =
    setMetricsConfig(initMetricsConfig())
    resetMetrics()
    let incRes: Result[bool] = metricsInc("svc_calls", 1)
    if IsErr(incRes):
        return Err[bool](Error(incRes))
    setAutoRelayConfig(initAutoRelayConfig())
    autoRelayReset()
    let addRes: Result[bool] = autoRelayAddPeer("peer-1")
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    if autoRelayCount() != 1:
        return Err[bool]("smoke: autorelay count mismatch")
    let hpRes: Result[bool] = hpAttempt()
    if IsErr(hpRes):
        return Err[bool](Error(hpRes))
    if hpAttemptCount() != 1:
        return Err[bool]("smoke: hp attempt mismatch")
    wildcardReset()
    let ruleRes: Result[bool] = wildcardAddRule(".example.com", "relay-1")
    if IsErr(ruleRes):
        return Err[bool](Error(ruleRes))
    let resRes: Result[str] = wildcardResolve("node.example.com")
    if IsErr(resRes):
        return Err[bool](Error(resRes))
    if (Value(resRes) != "relay-1"):
        return Err[bool]("smoke: wildcard resolve mismatch")
    return Ok[bool](true)
