# ConnManager watermark smoke.

import cheng/libp2p/utils/result
import cheng/libp2p/builders
import cheng/libp2p/networkprofile
import cheng/libp2p/connmanager
import cheng/libp2p/switch

fn runConnManagerWatermarkSmoke(): Result[bool] =
    var profile: GlobalScaleProfile = initGlobalScaleProfileL2Routing()
    profile.connLowWater = 1
    profile.connHighWater = 2

    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/360")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    withGlobalScaleProfile(builder, profile)
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))

    for i in 0..<3:
        let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
        if IsErr(dialRes):
            return Err[bool](Error(dialRes))
        let acceptRes: Result[Muxer] = accept(sw)
        if IsErr(acceptRes):
            return Err[bool](Error(acceptRes))
    if connManagerLowWater(sw.connManager) != 1 || connManagerHighWater(sw.connManager) != 2:
        return Err[bool]("connmanager-watermark: watermarks mismatch")
    if connManagerCountOpen(sw.connManager) > 1:
        return Err[bool]("connmanager-watermark: open connections should be trimmed to low-water")
    if connManagerCountClosed(sw.connManager) <= 0:
        return Err[bool]("connmanager-watermark: expected trimmed closed connections")
    return Ok[bool](true)

fn main(): int32 =
    let smokeRes: Result[bool] = runConnManagerWatermarkSmoke()
    if IsErr(smokeRes):
        echo("connmanager watermark smoke failed")
        echo(Error(smokeRes))
        return 1
    echo("connmanager watermark smoke ok")
    return 0
