import std/result

fn failDirect(): Result[bool] =
    return Err[bool]("direct_err")

fn failWrapped(): Result[bool] =
    let x: Result[int32] = Err[int32]("inner_err")
    if IsErr(x):
        return Err[bool](Error(x))
    return Ok[bool](true)

fn main(): int32 =
    let a: Result[bool] = failDirect()
    if IsErr(a):
        echo("direct=" + Error(a))
    let b: Result[bool] = failWrapped()
    if IsErr(b):
        echo("wrapped=" + Error(b))
    return 0
