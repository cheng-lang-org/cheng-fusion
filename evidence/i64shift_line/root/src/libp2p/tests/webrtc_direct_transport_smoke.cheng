# WebRTC direct transport smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/webrtcdirecttransport
fn runWebrtcDirectTransportSmoke(): Result[bool] =
    var t: WebrtcDirectTransport = initWebrtcDirectTransport()
    let addrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4005/webrtc-direct")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    start(t, addr)
    let dialRes: Result[Connection] = dial(t, addr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    let outbound: Connection = Value(dialRes)
    if ConnectionDirection(outbound) != Outbound:
        return Err[bool]("smoke: webrtc direct outbound direction mismatch")
    if ! ConnectionIsOpen(outbound):
        return Err[bool]("smoke: webrtc direct outbound ! open")
    let acceptRes: Result[Connection] = accept(t)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    let inbound: Connection = Value(acceptRes)
    if ConnectionDirection(inbound) != Inbound:
        return Err[bool]("smoke: webrtc direct inbound direction mismatch")
    if ! ConnectionIsOpen(inbound):
        return Err[bool]("smoke: webrtc direct inbound ! open")
    let localText: str = toString(LocalAddress(outbound))
    let remoteText: str = toString(RemoteAddress(outbound))
    if ! StrContains(localText, "/webrtc-direct"):
        return Err[bool]("smoke: webrtc direct local addr missing webrtc-direct")
    if ! StrContains(remoteText, "/webrtc-direct"):
        return Err[bool]("smoke: webrtc direct remote addr missing webrtc-direct")
    return Ok[bool](true)
