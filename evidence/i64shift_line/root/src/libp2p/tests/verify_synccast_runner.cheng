# Verify synccast runner(real path).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_verify_runner
fn main(): int32 =
    let verifyRes: Result[bool] = runSynccastVerify()
    if IsErr(verifyRes):
        echo("verify synccast failed")
        echo(Error(verifyRes))
        return 1
    echo("verify synccast ok")
    return 0
