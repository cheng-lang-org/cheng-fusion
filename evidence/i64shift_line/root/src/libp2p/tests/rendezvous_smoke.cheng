# Rendezvous smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/crypto
import cheng/libp2p/crypto/rand
import cheng/libp2p/multiaddress
import cheng/libp2p/routing_record
import cheng/libp2p/protocols/rendezvous/protobuf
import cheng/libp2p/protocols/rendezvous/rendezvous
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runRendezvousSmoke(): Result[bool] =
    setRandomSeed(BytesFromString("cheng-libp2p-rdv-smoke"))
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/9")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        return Err[bool](Error(kpRes))
    let kp: KeyPair = Value(kpRes)
    let pidRes: Result[PeerId] = peerIdFromPrivateKey(kp.privateKey)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    let pid: PeerId = Value(pidRes)
    let addr2Res: Result[MultiAddress] = parseMultiAddress("/memory/11")
    if IsErr(addr2Res):
        return Err[bool](Error(addr2Res))
    var rec: PeerRecord = newPeerRecord(pid, 1)
    if ! peerRecordAddAddress(rec, Value(addr2Res)):
        return Err[bool]("smoke: peer record address add failed")
    let sprRes: Result[SignedPeerRecord] = initSignedPeerRecord(kp.privateKey, rec)
    if IsErr(sprRes):
        return Err[bool](Error(sprRes))
    let sprBytesRes: Result[Bytes] = encodeSignedPeerRecord(Value(sprRes))
    if IsErr(sprBytesRes):
        return Err[bool](Error(sprBytesRes))
    let sprBytes: Bytes = Value(sprBytesRes)
    setRendezvousState(initRendezvousState())
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    var regReq: RendezvousMessage = initRendezvousMessage()
    regReq.msgType = rvRegister
    regReq.hasRegister = true
    regReq.register.namespace = "smoke"
    regReq.register.signedPeerRecord = sprBytes
    regReq.register.hasTtl = true
    regReq.register.ttlSeconds = 120
    let regWriteRes: Result[bool] = writeRendezvousMessage(outStream, regReq)
    if IsErr(regWriteRes):
        return Err[bool](Error(regWriteRes))
    let regHandleRes: Result[bool] = rendezvousHandler(inStream)
    if IsErr(regHandleRes):
        return Err[bool](Error(regHandleRes))
    let regReplyRes: Result[RendezvousMessage] = readRendezvousMessage(outStream)
    if IsErr(regReplyRes):
        return Err[bool](Error(regReplyRes))
    let regReply: RendezvousMessage = Value(regReplyRes)
    if regReply.msgType != rvRegisterResponse || ! regReply.hasRegisterResponse:
        return Err[bool]("smoke: register response missing")
    if regReply.registerResponse.status != rvOk:
        return Err[bool]("smoke: register status ! ok")
    var discoverReq: RendezvousMessage = initRendezvousMessage()
    discoverReq.msgType = rvDiscover
    discoverReq.hasDiscover = true
    discoverReq.discover.hasNamespace = true
    discoverReq.discover.namespace = "smoke"
    discoverReq.discover.hasLimit = true
    discoverReq.discover.limit = 10
    let discWriteRes: Result[bool] = writeRendezvousMessage(outStream, discoverReq)
    if IsErr(discWriteRes):
        return Err[bool](Error(discWriteRes))
    let discHandleRes: Result[bool] = rendezvousHandler(inStream)
    if IsErr(discHandleRes):
        return Err[bool](Error(discHandleRes))
    let discReplyRes: Result[RendezvousMessage] = readRendezvousMessage(outStream)
    if IsErr(discReplyRes):
        return Err[bool](Error(discReplyRes))
    let discReply: RendezvousMessage = Value(discReplyRes)
    if discReply.msgType != rvDiscoverResponse || ! discReply.hasDiscoverResponse:
        return Err[bool]("smoke: discover response missing")
    if discReply.discoverResponse.status != rvOk:
        return Err[bool]("smoke: discover status ! ok")
    if discReply.discoverResponse.registrationCount <= 0:
        return Err[bool]("smoke: discover empty")
    if ! BytesEqual(discReply.discoverResponse.registrations[0].signedPeerRecord, sprBytes):
        return Err[bool]("smoke: discover record mismatch")
    var unregReq: RendezvousMessage = initRendezvousMessage()
    unregReq.msgType = rvUnregister
    unregReq.hasUnregister = true
    unregReq.unregister.namespace = "smoke"
    let unregWriteRes: Result[bool] = writeRendezvousMessage(outStream, unregReq)
    if IsErr(unregWriteRes):
        return Err[bool](Error(unregWriteRes))
    let unregHandleRes: Result[bool] = rendezvousHandler(inStream)
    if IsErr(unregHandleRes):
        return Err[bool](Error(unregHandleRes))
    let disc2WriteRes: Result[bool] = writeRendezvousMessage(outStream, discoverReq)
    if IsErr(disc2WriteRes):
        return Err[bool](Error(disc2WriteRes))
    let disc2HandleRes: Result[bool] = rendezvousHandler(inStream)
    if IsErr(disc2HandleRes):
        return Err[bool](Error(disc2HandleRes))
    let disc2ReplyRes: Result[RendezvousMessage] = readRendezvousMessage(outStream)
    if IsErr(disc2ReplyRes):
        return Err[bool](Error(disc2ReplyRes))
    let disc2Reply: RendezvousMessage = Value(disc2ReplyRes)
    if disc2Reply.msgType != rvDiscoverResponse || ! disc2Reply.hasDiscoverResponse:
        return Err[bool]("smoke: discover response missing after unregister")
    if disc2Reply.discoverResponse.registrationCount != 0:
        return Err[bool]("smoke: unregister did ! clear namespace")
    return Ok[bool](true)
