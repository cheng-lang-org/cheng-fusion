# Host API smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/identify
import cheng/libp2p/main
fn runHostSmoke(): Result[bool] =
    let hostRes: Result[Switch] = newHostWithAddressText("/memory/2")
    if IsErr(hostRes):
        return Err[bool](Error(hostRes))
    var host: Switch = Value(hostRes)
    let startRes: Result[bool] = hostStart(host)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let streamRes: Result[Stream] = hostOpenProtocolStreamToAddressText(host, "/memory/2", identifyCodec)
    if IsErr(streamRes):
        return Err[bool](Error(streamRes))
    var outbound: Stream = Value(streamRes)
    let serveRes: Result[bool] = hostServeOnce(host)
    if IsErr(serveRes):
        closeStream(outbound)
        return Err[bool](Error(serveRes))
    let payloadRes: Result[Bytes] = readLp(outbound, 65536)
    if IsErr(payloadRes):
        closeStream(outbound)
        return Err[bool](Error(payloadRes))
    let payload: str = BytesToString(Value(payloadRes))
    if len(payload) <= 0 || ! StrContains(payload, "id="):
        closeStream(outbound)
        return Err[bool]("host smoke: identify payload missing id")
    let peerListRes: Result[str] = hostListPeerIdsText(host)
    if IsErr(peerListRes):
        closeStream(outbound)
        return Err[bool](Error(peerListRes))
    let peerListSortedRes: Result[str] = hostListPeerIdsSortedText(host)
    if IsErr(peerListSortedRes):
        closeStream(outbound)
        return Err[bool](Error(peerListSortedRes))
    let peerListLimitRes: Result[str] = hostListPeerIdsLimitText(host, 1)
    if IsErr(peerListLimitRes):
        closeStream(outbound)
        return Err[bool](Error(peerListLimitRes))
    let peerListOffsetRes: Result[str] = hostListPeerIdsOffsetText(host, 0, 1)
    if IsErr(peerListOffsetRes):
        closeStream(outbound)
        return Err[bool](Error(peerListOffsetRes))
    let peerListPageRes: Result[str] = hostListPeerIdsPageText(host, 1, 1)
    if IsErr(peerListPageRes):
        closeStream(outbound)
        return Err[bool](Error(peerListPageRes))
    let peerListProtoRes: Result[str] = hostListPeerIdsByProtocolText(host, identifyCodec)
    if IsErr(peerListProtoRes):
        closeStream(outbound)
        return Err[bool](Error(peerListProtoRes))
    let peerListProtoSortedTextRes: Result[str] = hostListPeerIdsByProtocolSortedText(host, identifyCodec)
    if IsErr(peerListProtoSortedTextRes):
        closeStream(outbound)
        return Err[bool](Error(peerListProtoSortedTextRes))
    let peerListProtoSortedRes: Result[str] = hostListPeerIdsByProtocolSortedLimitText(host, identifyCodec, 1)
    if IsErr(peerListProtoSortedRes):
        closeStream(outbound)
        return Err[bool](Error(peerListProtoSortedRes))
    let peerListProtoOffsetRes: Result[str] = hostListPeerIdsByProtocolOffsetText(host, identifyCodec, 0, 1)
    if IsErr(peerListProtoOffsetRes):
        closeStream(outbound)
        return Err[bool](Error(peerListProtoOffsetRes))
    let peerListProtoPageRes: Result[str] = hostListPeerIdsByProtocolPageText(host, identifyCodec, 1, 1)
    if IsErr(peerListProtoPageRes):
        closeStream(outbound)
        return Err[bool](Error(peerListProtoPageRes))
    let peerListAddrRes: Result[str] = hostListPeerIdsByAddressSubstringSortedPageText(host, "memory", 1, 2)
    if IsErr(peerListAddrRes):
        closeStream(outbound)
        return Err[bool](Error(peerListAddrRes))
    let peerListAddrSortedRes: Result[str] = hostListPeerIdsByAddressSubstringSortedText(host, "memory")
    if IsErr(peerListAddrSortedRes):
        closeStream(outbound)
        return Err[bool](Error(peerListAddrSortedRes))
    let peerListAddrOffsetRes: Result[str] = hostListPeerIdsByAddressSubstringOffsetText(host, "memory", 0, 1)
    if IsErr(peerListAddrOffsetRes):
        closeStream(outbound)
        return Err[bool](Error(peerListAddrOffsetRes))
    let peerListAddrPageRes: Result[str] = hostListPeerIdsByAddressSubstringPageText(host, "memory", 1, 1)
    if IsErr(peerListAddrPageRes):
        closeStream(outbound)
        return Err[bool](Error(peerListAddrPageRes))
    let peerListAddrSortedOffsetRes: Result[str] = hostListPeerIdsByAddressSubstringSortedOffsetText(host, "memory", 0, 1)
    if IsErr(peerListAddrSortedOffsetRes):
        closeStream(outbound)
        return Err[bool](Error(peerListAddrSortedOffsetRes))
    hostDumpPeersLimit(host, 1)
    hostDumpPeersSortedLimit(host, 1)
    hostDumpPeersOffset(host, 0, 1)
    hostDumpPeersPage(host, 1, 1)
    hostDumpPeersSortedOffset(host, 0, 1)
    hostDumpPeersSortedPage(host, 1, 1)
    hostDumpPeersByProtocolSortedLimit(host, identifyCodec, 1)
    hostDumpPeersByProtocolSortedOffset(host, identifyCodec, 0, 1)
    hostDumpPeersByProtocolSortedPage(host, identifyCodec, 1, 1)
    hostDumpPeersByAddressSubstringSortedLimit(host, "memory", 1)
    hostDumpPeersByAddressSubstringSortedOffset(host, "memory", 0, 1)
    hostDumpPeersByAddressSubstringSortedPage(host, "memory", 1, 1)
    hostDumpConnectionsLimit(host, 4)
    hostDumpConnectionsSortedLimit(host, 4)
    hostDumpConnectionsSorted(host)
    hostDumpConnectionsOffset(host, 0, 2)
    hostDumpConnectionsPage(host, 1, 2)
    hostDumpConnectionsSortedOffset(host, 0, 2)
    hostDumpConnectionsSortedPage(host, 1, 2)
    hostDumpConnectionsJsonLimit(host, 4)
    hostDumpConnectionsJsonSortedLimit(host, 4)
    hostDumpConnectionsJsonSorted(host)
    hostDumpConnectionsJsonOffset(host, 0, 2)
    hostDumpConnectionsJsonPage(host, 1, 2)
    hostDumpConnectionsJsonSortedOffset(host, 0, 2)
    hostDumpConnectionsJsonSortedPage(host, 1, 2)
    let connDirRes: Result[str] = hostDumpConnectionsByDirectionLimitText(host, "inbound", 4)
    if IsErr(connDirRes):
        closeStream(outbound)
        return Err[bool](Error(connDirRes))
    let connDirJsonRes: Result[str] = hostDumpConnectionsJsonByDirectionLimitText(host, "inbound", 4)
    if IsErr(connDirJsonRes):
        closeStream(outbound)
        return Err[bool](Error(connDirJsonRes))
    let connDirSortedRes: Result[str] = hostDumpConnectionsByDirectionSortedText(host, "inbound")
    if IsErr(connDirSortedRes):
        closeStream(outbound)
        return Err[bool](Error(connDirSortedRes))
    let connDirJsonSortedRes: Result[str] = hostDumpConnectionsJsonByDirectionSortedText(host, "inbound")
    if IsErr(connDirJsonSortedRes):
        closeStream(outbound)
        return Err[bool](Error(connDirJsonSortedRes))
    let connDirOffsetRes: Result[str] = hostDumpConnectionsByDirectionOffsetText(host, "inbound", 0, 4)
    if IsErr(connDirOffsetRes):
        closeStream(outbound)
        return Err[bool](Error(connDirOffsetRes))
    let connDirPageRes: Result[str] = hostDumpConnectionsByDirectionPageText(host, "inbound", 1, 4)
    if IsErr(connDirPageRes):
        closeStream(outbound)
        return Err[bool](Error(connDirPageRes))
    let connDirJsonOffsetRes: Result[str] = hostDumpConnectionsJsonByDirectionOffsetText(host, "inbound", 0, 4)
    if IsErr(connDirJsonOffsetRes):
        closeStream(outbound)
        return Err[bool](Error(connDirJsonOffsetRes))
    let connDirJsonPageRes: Result[str] = hostDumpConnectionsJsonByDirectionPageText(host, "inbound", 1, 4)
    if IsErr(connDirJsonPageRes):
        closeStream(outbound)
        return Err[bool](Error(connDirJsonPageRes))
    let connDirSortedOffsetRes: Result[str] = hostDumpConnectionsByDirectionSortedOffsetText(host, "inbound", 0, 4)
    if IsErr(connDirSortedOffsetRes):
        closeStream(outbound)
        return Err[bool](Error(connDirSortedOffsetRes))
    let connDirSortedPageRes: Result[str] = hostDumpConnectionsByDirectionSortedPageText(host, "inbound", 1, 4)
    if IsErr(connDirSortedPageRes):
        closeStream(outbound)
        return Err[bool](Error(connDirSortedPageRes))
    let connDirJsonSortedOffsetRes: Result[str] = hostDumpConnectionsJsonByDirectionSortedOffsetText(host, "inbound", 0, 4)
    if IsErr(connDirJsonSortedOffsetRes):
        closeStream(outbound)
        return Err[bool](Error(connDirJsonSortedOffsetRes))
    let connDirJsonSortedPageRes: Result[str] = hostDumpConnectionsJsonByDirectionSortedPageText(host, "inbound", 1, 4)
    if IsErr(connDirJsonSortedPageRes):
        closeStream(outbound)
        return Err[bool](Error(connDirJsonSortedPageRes))
    hostDumpConnectionsByOpenStateLimit(host, true, 4)
    hostDumpConnectionsJsonByOpenStateLimit(host, true, 4)
    hostDumpConnectionsByOpenStateSorted(host, true)
    hostDumpConnectionsJsonByOpenStateSorted(host, true)
    hostDumpConnectionsByOpenStateOffset(host, true, 0, 4)
    hostDumpConnectionsByOpenStatePage(host, true, 1, 4)
    hostDumpConnectionsByOpenStateSortedOffset(host, true, 0, 4)
    hostDumpConnectionsByOpenStateSortedPage(host, true, 1, 4)
    hostDumpConnectionsJsonByOpenStateOffset(host, true, 0, 4)
    hostDumpConnectionsJsonByOpenStatePage(host, true, 1, 4)
    hostDumpConnectionsJsonByOpenStateSortedOffset(host, true, 0, 4)
    hostDumpConnectionsJsonByOpenStateSortedPage(host, true, 1, 4)
    hostDumpConnectionsByAddressSubstringLimit(host, "memory", 4)
    hostDumpConnectionsJsonByAddressSubstringLimit(host, "memory", 4)
    hostDumpConnectionsByAddressSubstringSorted(host, "memory")
    hostDumpConnectionsJsonByAddressSubstringSorted(host, "memory")
    hostDumpConnectionsByAddressSubstringOffset(host, "memory", 0, 4)
    hostDumpConnectionsByAddressSubstringPage(host, "memory", 1, 4)
    hostDumpConnectionsByAddressSubstringSortedOffset(host, "memory", 0, 4)
    hostDumpConnectionsByAddressSubstringSortedPage(host, "memory", 1, 4)
    hostDumpConnectionsJsonByAddressSubstringOffset(host, "memory", 0, 4)
    hostDumpConnectionsJsonByAddressSubstringPage(host, "memory", 1, 4)
    hostDumpConnectionsJsonByAddressSubstringSortedOffset(host, "memory", 0, 4)
    hostDumpConnectionsJsonByAddressSubstringSortedPage(host, "memory", 1, 4)
    let closeRes: Result[bool] = closeStream(outbound)
    if IsErr(closeRes):
        return Err[bool](Error(closeRes))
    hostStop(host)
    return Ok[bool](true)
