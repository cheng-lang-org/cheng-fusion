# PeerIdFromBytes smoke(debug returning PeerId).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multihash
import cheng/libp2p/multicodec
import cheng/libp2p/multibase
import cheng/libp2p/peerid

fn main(): int32 =
    let digestBytes: Bytes = BytesFromString("hello")
    let mh: MultiHash = NewMultiHash(codecIdentity.code, digestBytes)
    let mhBytes: Bytes = EncodeMultihash(mh)
    echo("mhBytes.len=" + $(BytesLen(mhBytes)))
    let directText: str = encodeBase58(mhBytes)
    echo("direct.len=" + $(len(directText)))
    echo("direct=" + directText)
    let directPid: PeerId = peerIdFromTextUnchecked(directText)
    echo("directPid.len=" + $(len(peerid.toString(directPid))))
    let pidRes: Result[PeerId] = peerIdFromBytes(mhBytes)
    if IsErr(pidRes):
        echo("peerid frombytes smoke failed: " + Error(pidRes))
        return 1
    let pid: PeerId = Value(pidRes)
    echo("pid.len=" + $(len(peerid.toString(pid))))
    echo("pid=" + peerid.toString(pid))
    return 0
