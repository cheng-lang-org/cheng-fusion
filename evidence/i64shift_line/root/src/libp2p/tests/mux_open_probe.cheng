import std/result
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer

fn main(): int32 =
    let aRes: Result[MultiAddress] = parseMultiAddress("/memory/90")
    let bRes: Result[MultiAddress] = parseMultiAddress("/memory/91")
    let pairRes: Result[ConnectionPair] = newConnectionPair(Value(aRes), Value(bRes), Value(bRes), Value(aRes))
    var pair: ConnectionPair = Value(pairRes)
    var out: Muxer = newMuxer(pair.outbound)
    echo("before open")
    let sRes: Result[Stream] = openStream(out)
    if IsErr(sRes):
        echo("open err")
        echo(Error(sRes))
        return 1
    echo("open ok")
    return 0
