# Livestream smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/livestream/livestream
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runLivestreamSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/33")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    var req: LivestreamRequest = LivestreamRequest(
        streamId: "stream-1",
        seq: 1,
        data: BytesFromString("frame"),
        endOfStream: false
    )
    let writeRes: Result[bool] = writeLivestreamRequest(outStream, req)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = livestreamHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let replyRes: Result[LivestreamResponse] = readLivestreamResponse(outStream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let reply: LivestreamResponse = Value(replyRes)
    if ! reply.ok:
        return Err[bool]("smoke: livestream response ! ok")
    if (reply.message != "ok"):
        return Err[bool]("smoke: livestream message mismatch")
    if reply.nextSeq != 2:
        return Err[bool]("smoke: livestream next seq mismatch")
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runLivestreamSmoke()
    if IsErr(res):
        echo("livestream smoke failed: " + Error(res))
        return 1
    echo("livestream smoke ok")
    return 0
