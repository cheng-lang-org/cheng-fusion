# Verify synccast closed-loop runner(real path).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_closedloop_runner
fn main(): int32 =
    let verifyRes: Result[bool] = runSynccastClosedLoop()
    if IsErr(verifyRes):
        echo("verify synccast closed-loop failed")
        echo(Error(verifyRes))
        return 1
    echo("verify synccast closed-loop ok")
    return 0
