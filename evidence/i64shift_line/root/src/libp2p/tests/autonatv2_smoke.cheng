# AutoNAT v2 protocol smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/multiaddress
import cheng/libp2p/switch
import cheng/libp2p/builders
import cheng/libp2p/protocols/connectivity/autonatv2/types
import cheng/libp2p/protocols/connectivity/autonatv2/client
import cheng/libp2p/protocols/connectivity/autonatv2/server
import cheng/libp2p/protocols/connectivity/autonatv2/service as autonatv2service
fn runAutonatv2Smoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/71")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    registerProtocol(sw, autonatv2Protocol())
    setAutonatv2Config(initAutonatv2Config())
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openProtocolStream(sw, outboundMux, autonatv2Codec)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    let addr2Res: Result[MultiAddress] = parseMultiAddress("/memory/72")
    if IsErr(addr2Res):
        return Err[bool](Error(addr2Res))
    var req: Autonatv2Request = initAutonatv2Request()
    req.hasPeerId = true
    req.peerId = sw.peerId
    let addRes: Result[bool] = multiAddressListAdd(req.addrs, Value(addr2Res))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    let writeRes: Result[bool] = writeAutonatv2Request(outStream, req)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = autonatv2Handler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let respRes: Result[Autonatv2Response] = readAutonatv2Response(outStream, autonatv2MaxMessage)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: Autonatv2Response = Value(respRes)
    if resp.status != an2Ok:
        return Err[bool]("smoke: autonatv2 status ! ok")
    if ! resp.hasAddr:
        return Err[bool]("smoke: autonatv2 missing observed addr")
    return Ok[bool](true)
