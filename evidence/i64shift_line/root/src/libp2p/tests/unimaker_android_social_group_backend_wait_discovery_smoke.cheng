# Verifies group-create backend social_wait_discovery blocks on the same
# listen-drain + inbox as social_poll_events: bad handle returns -1, empty
# inbox times out 0, a real discovery/peer inbox item wakes with 1.

import std/system
import std/strings
import cheng/libp2p/mobile_ffi/unimaker_android_social_group_backend

@borrows
fn containsText(text: str, needle: str): bool =
    if len(needle) <= 0:
        return true
    var i: int32
    let last: int32 = len(text) - len(needle)
    while i <= last:
        var ok: bool = true
        var j: int32
        while j < len(needle):
            if text[i + j] != needle[j]:
                ok = false
                break
            j = j + 1
        if ok:
            return true
        i = i + 1
    return false

fn main(): int32 =
    if social_wait_discovery(0, 40) != -1:
        return 11
    if social_wait_discovery_cstr(99, 40) != -1:
        return 12

    let dataDir: str = "/data/user/0/com.unimaker.app.waitdisc/files/libp2p"
    let cfg: str = "{\"dataDir\":\"" + dataDir + "\",\"data_dir\":\"" + dataDir + "\",\"runtimeProfile\":\"standard_android\"}"
    let handle: int64 = libp2p_node_init(cfg)
    if handle <= 0:
        return 21
    if social_wait_discovery(0, 40) != -1:
        return 22
    if libp2p_node_start(handle) != 0:
        return 23

    if social_wait_discovery(handle, 80) != 0:
        return 31
    if social_wait_discovery_cstr(handle, 80) != 0:
        return 32

    sgInboxAppend("{\"entity\":\"discovery\",\"topic\":\"peer.connected\",\"peerId\":\"12D3KooWWaitDiscoverySmoke\"}")
    if social_wait_discovery(handle, 80) != 1:
        return 41
    let polled: str = strFromCStringCopy(social_poll_events(handle, 8))
    if !containsText(polled, "\"entity\":\"discovery\""):
        return 42
    if !containsText(polled, "peer.connected"):
        return 43
    if social_wait_discovery_cstr(handle, 80) != 1:
        return 44

    echo("unimaker_android_social_group_backend_wait_discovery_smoke=pass")
    return 0
