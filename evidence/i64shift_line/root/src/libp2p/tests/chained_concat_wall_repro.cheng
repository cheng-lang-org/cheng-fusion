# Minimal repro: cold_subset parser dies on a return-statement whose sole
# argument is a str expression built from 6 "+" concatenations mixing
# string literals and $-stringified locals, passed to a wrapper function
# call. Decoupled from any library file.
#
# Observed on: bootstrap/cheng_cold.c (cc -std=c11 -O2 build), driver
# `system-link-exec --emit:exe`.

fn wrap(v: str): str =
    return v

fn f(): str =
    let connected: int32 = 1
    let known: int32 = 2
    let tickMs: int64 = 3
    let reconnectAtMs: int64 = 4
    return wrap("{\"ok\":true,\"connected\":" + $connected + ",\"known\":" + $known + ",\"lastTickMs\":" + $tickMs + ",\"lastReconnectAtMs\":" + $reconnectAtMs + "}")

fn main(): int32 =
    let s: str = f()
    echo(s)
    return 0
