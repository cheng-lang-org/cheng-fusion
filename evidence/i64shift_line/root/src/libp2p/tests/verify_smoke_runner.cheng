# Verify smoke runner(real path).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/mdns_smoke
import cheng/libp2p/tests/dm_smoke
import cheng/libp2p/tests/pubsub_smoke
import cheng/libp2p/tests/livestream_smoke
import cheng/libp2p/tests/synccast_verify_runner
import cheng/libp2p/tests/mdns_quic_dm_synccast_smoke
fn runVerifySmoke(): Result[bool] =
    let mdnsRes: Result[bool] = runMdnsSmoke()
    if IsErr(mdnsRes):
        return Err[bool]("verify_smoke: mdns: " + Error(mdnsRes))
    let dmRes: Result[bool] = runDmSmoke()
    if IsErr(dmRes):
        return Err[bool]("verify_smoke: dm: " + Error(dmRes))
    let pubsubRes: Result[bool] = runPubsubSmoke()
    if IsErr(pubsubRes):
        return Err[bool]("verify_smoke: pubsub: " + Error(pubsubRes))
    let synccastRes: Result[bool] = runSynccastVerify()
    if IsErr(synccastRes):
        return Err[bool]("verify_smoke: synccast: " + Error(synccastRes))
    let liveRes: Result[bool] = runLivestreamSmoke()
    if IsErr(liveRes):
        return Err[bool]("verify_smoke: livestream: " + Error(liveRes))
    let closedRes: Result[bool] = runMdnsQuicDmSynccastSmoke()
    if IsErr(closedRes):
        return Err[bool]("verify_smoke: closedloop: " + Error(closedRes))
    return Ok[bool](true)

fn main(): int32 =
    let verifyRes: Result[bool] = runVerifySmoke()
    if IsErr(verifyRes):
        echo("verify smoke failed")
        echo(Error(verifyRes))
        return 1
    echo("verify smoke ok")
    return 0
