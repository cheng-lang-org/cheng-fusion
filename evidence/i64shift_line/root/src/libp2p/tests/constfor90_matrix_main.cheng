import std/strutils as strutil
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/kademlia/consts
import cheng/libp2p/tests/constfor90_matrix_lib

fn main(): int32 =
    echo(strutil.Join(["ForBound=", IntToStr(ConstFor90ForBound())], ""))
    echo(strutil.Join(["WhileCond=", IntToStr(ConstFor90WhileCond())], ""))
    echo(strutil.Join(["IfCmpTrue=", IntToStr(ConstFor90IfCmpTrue())], ""))
    echo(strutil.Join(["IfCmpFalse=", IntToStr(ConstFor90IfCmpFalse())], ""))
    echo(strutil.Join(["Arith=", IntToStr(ConstFor90Arith())], ""))
    echo(strutil.Join(["NestedArith=", IntToStr(ConstFor90NestedArith())], ""))
    echo(strutil.Join(["DeclRhs=", IntToStr(ConstFor90DeclRhs())], ""))
    echo(strutil.Join(["CallArg=", IntToStr(ConstFor90CallArg())], ""))
    echo(strutil.Join(["ArraySize=", IntToStr(ConstFor90ArraySize())], ""))
    return 0
