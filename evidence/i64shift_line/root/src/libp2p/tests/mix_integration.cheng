# Mix integration test.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/mix/mix_protocol
import cheng/libp2p/peerinfo
import cheng/libp2p/peerstore
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runMixIntegration(): Result[bool] =
    var builderA: SwitchBuilder = newSwitchBuilder()
    let addrARes: Result[bool] = withAddressText(builderA, "/memory/41")
    if IsErr(addrARes):
        return Err[bool](Error(addrARes))
    let swARes: Result[Switch] = build(builderA)
    if IsErr(swARes):
        return Err[bool](Error(swARes))
    var swA: Switch = Value(swARes)

    var builderB: SwitchBuilder = newSwitchBuilder()
    let addrBRes: Result[bool] = withAddressText(builderB, "/memory/42")
    if IsErr(addrBRes):
        return Err[bool](Error(addrBRes))
    let swBRes: Result[Switch] = build(builderB)
    if IsErr(swBRes):
        return Err[bool](Error(swBRes))
    var swB: Switch = Value(swBRes)

    let startARes: Result[bool] = start(swA)
    if IsErr(startARes):
        return Err[bool](Error(startARes))
    let startBRes: Result[bool] = start(swB)
    if IsErr(startBRes):
        return Err[bool](Error(startBRes))

    var info: PeerInfo = newPeerInfo(swB.peerId)
    let addAddrRes: Result[bool] = addAddress(info, swB.listenAddr)
    if IsErr(addAddrRes):
        return Err[bool](Error(addAddrRes))
    var store: PeerStore = swA.peerStore
    let mergeRes: Result[bool] = mergePeer(store, info)
    if IsErr(mergeRes):
        return Err[bool](Error(mergeRes))
    swA.peerStore = store

    var msg: MixMessage = initMixMessage()
    msg.codec = "/demo/1.0.0"
    msg.payload = BytesFromString("ping")
    let replyRes: Result[MixMessage] = mixRequest(swA, swB.peerId, msg)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let reply: MixMessage = Value(replyRes)
    if (reply.codec != "/demo/1.0.0"):
        return Err[bool]("integration: mix codec mismatch")
    if ! BytesEqual(reply.payload, BytesFromString("ping")):
        return Err[bool]("integration: mix payload mismatch")
    return Ok[bool](true)
