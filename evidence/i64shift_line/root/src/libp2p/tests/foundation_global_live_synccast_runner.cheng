# Foundation global live synccast runner(real path).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_verify_runner
import cheng/libp2p/tests/livestream_smoke
import cheng/libp2p/tests/mdns_host_synccast_call_smoke
fn runFoundationGlobalLiveSynccast(): Result[bool] =
    let synccastRes: Result[bool] = runSynccastVerify()
    if IsErr(synccastRes):
        return Err[bool]("foundation_global_live: synccast: " + Error(synccastRes))
    let liveRes: Result[bool] = runLivestreamSmoke()
    if IsErr(liveRes):
        return Err[bool]("foundation_global_live: livestream: " + Error(liveRes))
    let closedRes: Result[bool] = runMdnsHostSynccastCallSmoke()
    if IsErr(closedRes):
        return Err[bool]("foundation_global_live: host_synccast: " + Error(closedRes))
    return Ok[bool](true)

fn main(): int32 =
    let runRes: Result[bool] = runFoundationGlobalLiveSynccast()
    if IsErr(runRes):
        echo("foundation global live synccast failed")
        echo(Error(runRes))
        return 1
    echo("foundation global live synccast ok")
    return 0
