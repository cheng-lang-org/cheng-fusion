# Interop tooling smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/quic/tooling/common
import cheng/quic/tooling/interop_runner
import cheng/quic/tests/fuzz_smoke_runner
import cheng/quic/tests/tooling_misc_test
import cheng/quic/tests/tooling_release_pipeline_test
fn sampleInteropTest(): ToolResult =
    return toolOk("interop ok")

fn runInteropSmoke(): Result[bool] =
    let regRes: Result[bool] = registerInteropTest("sample", "sample interop", sampleInteropTest)
    if IsErr(regRes):
        return Err[bool](Error(regRes))
    let list: str = listInteropTests()
    if ! StrContains(list, "sample"):
        return Err[bool]("smoke: interop list missing sample")
    let runRes: Result[ToolResult] = runInteropTest("sample")
    if IsErr(runRes):
        return Err[bool](Error(runRes))
    if ! toolResultOk(Value(runRes)):
        return Err[bool]("smoke: interop run failed")
    let allRes: Result[ToolResult] = runInteropAll()
    if IsErr(allRes):
        return Err[bool](Error(allRes))
    if ! toolResultOk(Value(allRes)):
        return Err[bool]("smoke: interop all failed")
    let miscRes: Result[bool] = runToolingMiscTest()
    if IsErr(miscRes):
        return miscRes
    let toolingRes: Result[bool] = runToolingReleasePipelineTest()
    if IsErr(toolingRes):
        return toolingRes
    let fuzzRes: Result[bool] = runFuzzSmoke()
    if IsErr(fuzzRes):
        return fuzzRes
    return Ok[bool](true)
