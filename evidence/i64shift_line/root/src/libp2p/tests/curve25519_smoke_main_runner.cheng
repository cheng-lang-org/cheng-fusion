# Curve25519 standalone smoke runner (RFC 7748 vectors).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/curve25519_smoke

fn main(): int32 =
    echo("curve25519 smoke runner start")
    let res: Result[bool] = runCurve25519Smoke()
    if IsErr(res):
        echo("curve25519 smoke failed")
        echo(Error(res))
        return 1
    echo("curve25519 smoke ok")
    return 0
