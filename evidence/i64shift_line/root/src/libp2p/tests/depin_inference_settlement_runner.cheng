# DePIN inference settlement verify runner.

import cheng/libp2p/utils/result
import cheng/libp2p/tests/depin_inference_settlement_smoke

fn main(): int32 =
    let settleRes: Result[bool] = runDepinInferenceSettlementSmoke()
    if IsErr(settleRes):
        return 31
    if !Value(settleRes):
        return 32
    return 0
