# mDNS cache -> peerstore merge smoke(enableNetwork=false).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/discovery/mdns
import cheng/libp2p/discovery/discoverymngr
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import cheng/libp2p/peerstore

fn runMdnsPeerstoreMergeSmoke(): Result[bool] =
    setMdnsState(initMdnsState())
    var cfg: MdnsConfig = initMdnsConfig()
    cfg.enableNetwork = false
    setMdnsConfig(cfg)

    let addrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4031/quic-v1")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let pidARes: Result[PeerId] = randomPeerId()
    if IsErr(pidARes):
        return Err[bool](Error(pidARes))
    let pidBRes: Result[PeerId] = randomPeerId()
    if IsErr(pidBRes):
        return Err[bool](Error(pidBRes))
    let pidAText: str = peerid.toString(Value(pidARes))
    let pidBText: str = peerid.toString(Value(pidBRes))
    if (pidAText == pidBText):
        return Err[bool]("smoke: peerid collision(text)")

    var attrs: PeerAttributes = initPeerAttributes()
    let addPidRes: Result[bool] = peerAttributesAddPeerId(attrs, Value(pidARes))
    if IsErr(addPidRes):
        return Err[bool](Error(addPidRes))
    let addAddrRes: Result[bool] = peerAttributesAddAddress(attrs, Value(addrRes))
    if IsErr(addAddrRes):
        return Err[bool](Error(addAddrRes))
    let addSvcRes: Result[bool] = peerAttributesAddService(attrs, "synccast-call")
    if IsErr(addSvcRes):
        return Err[bool](Error(addSvcRes))
    let addNsRes: Result[bool] = peerAttributesAddNamespace(attrs, "local")
    if IsErr(addNsRes):
        return Err[bool](Error(addNsRes))

    let advRes: Result[bool] = mdnsAdvertise(attrs)
    if IsErr(advRes):
        return Err[bool](Error(advRes))

    var query: PeerAttributes = initPeerAttributes()
    let qSvcRes: Result[bool] = peerAttributesAddService(query, "synccast-call")
    if IsErr(qSvcRes):
        return Err[bool](Error(qSvcRes))
    let qNsRes: Result[bool] = peerAttributesAddNamespace(query, "local")
    if IsErr(qNsRes):
        return Err[bool](Error(qNsRes))

    var out: PeerAttributesList = initPeerAttributesList()
    let discRes: Result[bool] = mdnsDiscover(query, out)
    if IsErr(discRes):
        return Err[bool](Error(discRes))
    if out.count <= 0:
        return Err[bool]("smoke: mdns discovery empty")

    var filtered: PeerAttributesList = initPeerAttributesList()
    var missingPid: bool
    var firstOutText: str
    for i in 0..<out.count:
        var pid: PeerId
        if peerAttributesGetPeerId(out.items[i], pid):
            if len(firstOutText) <= 0:
                firstOutText = peerid.toString(pid)
            let eqRes: Result[bool] = peerIdEqual(pid, Value(pidBRes))
            if IsErr(eqRes):
                return Err[bool](Error(eqRes))
            if ! Value(eqRes):
                let addRes: Result[bool] = peerAttributesListAdd(filtered, out.items[i])
                if IsErr(addRes):
                    return Err[bool](Error(addRes))
        else:
            missingPid = true
    if filtered.count <= 0:
        var msg: str = "smoke: peerstore filter empty"
        msg = msg + " out.count=" + $(out.count)
        msg = msg + " missingPid=" + $(missingPid)
        msg = msg + " pidA=" + pidAText
        msg = msg + " pidB=" + pidBText
        if len(firstOutText) > 0:
            msg = msg + " outPid=" + firstOutText
        return Err[bool](msg)

    var store: PeerStore = initPeerStore()
    let mergeRes: Result[int32] = mergePeerAttributesList(store, filtered, 4)
    if IsErr(mergeRes):
        return Err[bool](Error(mergeRes))
    if Value(mergeRes) <= 0:
        return Err[bool]("smoke: peerstore merge empty")
    let hasRes: Result[bool] = hasPeer(store, Value(pidARes))
    if IsErr(hasRes):
        return Err[bool](Error(hasRes))
    if ! Value(hasRes):
        return Err[bool]("smoke: peerstore missing peer")
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runMdnsPeerstoreMergeSmoke()
    if IsErr(res):
        echo("mdns peerstore merge smoke failed: " + Error(res))
        return 1
    echo("mdns peerstore merge smoke ok")
    return 0
