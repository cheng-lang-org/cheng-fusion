# mDNS -> QUIC direct -> DM -> Synccast media closed-loop smoke test.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/stringlist
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/crypto/crypto
import cheng/libp2p/crypto/rand
import cheng/libp2p/discovery/mdns
import cheng/libp2p/discovery/discoverymngr
import cheng/quic/msquictransport
import cheng/libp2p/stream/connection
import cheng/libp2p/stream/lpstream
import cheng/libp2p/muxers/muxer
import cheng/libp2p/multistream
import cheng/libp2p/protocols/dm/dmservice
import cheng/libp2p/protocols/synccast/control
import cheng/libp2p/protocols/synccast/protobuf
import cheng/libp2p/protocols/synccast/session
import cheng/libp2p/protocols/synccast/session_msquic
import cheng/libp2p/protocols/synccast/datagram
const
    mdnsQuicSmokeSessionId = 3001

fn dmEchoHandler(req: DmRequest): DmResponse =
    var resp: DmResponse = initDmResponse()
    resp.ok = true
    resp.message = "echo:" + req.text
    return resp

fn synccastHelloHandler(msg: SynccastControlMessage): Result[SynccastControlMessage] =
    if msg.protoMajor != synccastProtoMajor || msg.protoMinor != synccastProtoMinor:
        return Err[SynccastControlMessage]("smoke: synccast proto mismatch")
    if msg.msgId <= 0:
        return Err[SynccastControlMessage]("smoke: synccast missing msg id")
    if msg.kind != synccastHelloKind:
        return Err[SynccastControlMessage]("smoke: expected synccast hello")
    let helloRes: Result[SynccastHello] = decodeSynccastHello(msg.payload)
    if IsErr(helloRes):
        return Err[SynccastControlMessage](Error(helloRes))
    let hello: SynccastHello = Value(helloRes)
    if !hello.supportsDatagram:
        return Err[SynccastControlMessage]("smoke: synccast datagram flag missing")
    var negotiated: SynccastNegotiated = initSynccastNegotiated()
    negotiated.ok = true
    negotiated.sessionId = int64(mdnsQuicSmokeSessionId)
    negotiated.targetLatencyMs = 0
    negotiated.message = "ok"
    let payloadRes: Result[Bytes] = encodeSynccastNegotiated(negotiated)
    if IsErr(payloadRes):
        return Err[SynccastControlMessage](Error(payloadRes))
    var resp: SynccastControlMessage = initSynccastControlMessage()
    resp.kind = synccastNegotiatedKind
    resp.sessionId = int64(mdnsQuicSmokeSessionId)
    resp.payload = Value(payloadRes)
    return Ok[SynccastControlMessage](resp)

fn multistreamSelectPair(dialer: var Stream, responder: var Stream, proto: str): Result[bool] =
    if len(proto) <= 0:
        return Err[bool]("multistream: empty protocol")
    let hello: str = ensureLine(codecV1)
    let helloWriteRes: Result[int32] = writeLp(dialer, hello)
    if IsErr(helloWriteRes):
        return Err[bool](Error(helloWriteRes))
    let reqRes: Result[Bytes] = readLp(responder, msgSize)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: str = BytesToString(Value(reqRes))
    let reqTrimRes: Result[str] = trimLine(req)
    if IsErr(reqTrimRes):
        return Err[bool](Error(reqTrimRes))
    let reqLine: str = Value(reqTrimRes)
    if (reqLine != codecV1) && (reqLine != codecV2):
        let naRes: Result[int32] = writeLp(responder, na)
        if IsErr(naRes):
            return Err[bool](Error(naRes))
        return Err[bool]("multistream: unsupported handshake")
    let respRes: Result[int32] = writeLp(responder, ensureLine(codecV1))
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let dialerRespRes: Result[Bytes] = readLp(dialer, msgSize)
    if IsErr(dialerRespRes):
        return Err[bool](Error(dialerRespRes))
    let dialerResp: str = BytesToString(Value(dialerRespRes))
    let dialerTrimRes: Result[str] = trimLine(dialerResp)
    if IsErr(dialerTrimRes):
        return Err[bool](Error(dialerTrimRes))
    if (Value(dialerTrimRes) != codecV1):
        return Err[bool]("multistream: handshake failed")
    let protoLine: str = ensureLine(proto)
    let protoWriteRes: Result[int32] = writeLp(dialer, protoLine)
    if IsErr(protoWriteRes):
        return Err[bool](Error(protoWriteRes))
    let protoReqRes: Result[Bytes] = readLp(responder, msgSize)
    if IsErr(protoReqRes):
        return Err[bool](Error(protoReqRes))
    let protoReq: str = BytesToString(Value(protoReqRes))
    let protoTrimRes: Result[str] = trimLine(protoReq)
    if IsErr(protoTrimRes):
        return Err[bool](Error(protoTrimRes))
    if (Value(protoTrimRes) != proto):
        let naRes: Result[int32] = writeLp(responder, na)
        if IsErr(naRes):
            return Err[bool](Error(naRes))
        return Err[bool]("multistream: protocol rejected")
    let ackRes: Result[int32] = writeLp(responder, ensureLine(proto))
    if IsErr(ackRes):
        return Err[bool](Error(ackRes))
    let dialerAckRes: Result[Bytes] = readLp(dialer, msgSize)
    if IsErr(dialerAckRes):
        return Err[bool](Error(dialerAckRes))
    let dialerAck: str = BytesToString(Value(dialerAckRes))
    let ackTrimRes: Result[str] = trimLine(dialerAck)
    if IsErr(ackTrimRes):
        return Err[bool](Error(ackTrimRes))
    if (Value(ackTrimRes) != proto):
        return Err[bool]("multistream: unexpected response")
    return Ok[bool](true)

fn runMdnsQuicDmSynccastSmoke(): Result[bool] =
    var mdnsCfg: MdnsConfig = initMdnsConfig()
    mdnsCfg.enableNetwork = false
    mdnsCfg.bindPort = 5534
    setMdnsConfig(mdnsCfg)
    setMdnsState(initMdnsState())

    setRandomSeed(BytesFromString("cheng-mdns-quic-synccast"))
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        return Err[bool](Error(kpRes))
    let kp: KeyPair = Value(kpRes)
    let pidRes: Result[PeerId] = peerIdFromPrivateKey(kp.privateKey)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    let pid: PeerId = Value(pidRes)

    let addrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4012/quic-v1")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)

    var attrs: PeerAttributes = initPeerAttributes()
    let addPidRes: Result[bool] = peerAttributesAddPeerId(attrs, pid)
    if IsErr(addPidRes):
        return Err[bool](Error(addPidRes))
    let addAddrRes: Result[bool] = peerAttributesAddAddress(attrs, addr)
    if IsErr(addAddrRes):
        return Err[bool](Error(addAddrRes))
    let addSvcRes: Result[bool] = peerAttributesAddService(attrs, "synccast")
    if IsErr(addSvcRes):
        return Err[bool](Error(addSvcRes))
    let addNsRes: Result[bool] = peerAttributesAddNamespace(attrs, "local")
    if IsErr(addNsRes):
        return Err[bool](Error(addNsRes))
    let advRes: Result[bool] = mdnsAdvertise(attrs)
    if IsErr(advRes):
        return Err[bool](Error(advRes))

    var query: PeerAttributes = initPeerAttributes()
    let addQueryRes: Result[bool] = peerAttributesAddService(query, "synccast")
    if IsErr(addQueryRes):
        return Err[bool](Error(addQueryRes))
    var out: PeerAttributesList = initPeerAttributesList()
    let discRes: Result[bool] = mdnsDiscover(query, out)
    if IsErr(discRes):
        return Err[bool](Error(discRes))
    if out.count != 1:
        return Err[bool]("smoke: mdns discovery count mismatch")
    var outPid: PeerId
    if !peerAttributesGetPeerId(out.items[0], outPid):
        return Err[bool]("smoke: mdns peer id missing")
    let eqRes: Result[bool] = peerIdEqual(pid, outPid)
    if IsErr(eqRes):
        return Err[bool](Error(eqRes))
    if !(Value(eqRes)):
        return Err[bool]("smoke: mdns peer id mismatch")

    var server: MsQuicTransport = initMsQuicTransport()
    var serverSettings: MsQuicSettings = msquicTransportSettings(server)
    serverSettings.allowDatagram = true
    serverSettings.maxDatagram = 1200
    let serverSetRes: Result[bool] = setMsQuicTransportSettings(server, serverSettings)
    if IsErr(serverSetRes):
        return Err[bool](Error(serverSetRes))
    start(server, addr)

    var client: MsQuicTransport = initMsQuicTransport()
    var clientSettings: MsQuicSettings = msquicTransportSettings(client)
    clientSettings.allowDatagram = true
    clientSettings.maxDatagram = 1200
    let clientSetRes: Result[bool] = setMsQuicTransportSettings(client, clientSettings)
    if IsErr(clientSetRes):
        return Err[bool](Error(clientSetRes))
    let outConnRes: Result[Connection] = dial(client, addr)
    if IsErr(outConnRes):
        return Err[bool](Error(outConnRes))
    let inConnRes: Result[Connection] = accept(server)
    if IsErr(inConnRes):
        return Err[bool](Error(inConnRes))
    var outConn: Connection = Value(outConnRes)
    var inConn: Connection = Value(inConnRes)

    var outboundMux: Muxer = newMuxer(outConn)
    if outboundMux.id < 0:
        return Err[bool]("smoke: outbound muxer alloc failed")
    var inboundMux: Muxer = newMuxer(inConn)
    if inboundMux.id < 0:
        return Err[bool]("smoke: inbound muxer alloc failed")

    let dmOutRes: Result[Stream] = openStream(outboundMux)
    if IsErr(dmOutRes):
        return Err[bool](Error(dmOutRes))
    var dmOut: Stream = Value(dmOutRes)
    let dmInRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(dmInRes):
        return Err[bool](Error(dmInRes))
    var dmIn: Stream = Value(dmInRes)
    let dmSelectRes: Result[bool] = multistreamSelectPair(dmOut, dmIn, dMCodec)
    if IsErr(dmSelectRes):
        return Err[bool](Error(dmSelectRes))
    var dmReq: DmRequest = initDmRequest()
    dmReq.text = "ping"
    let dmWriteRes: Result[bool] = writeDmRequest(dmOut, dmReq)
    if IsErr(dmWriteRes):
        return Err[bool](Error(dmWriteRes))
    let dmInboundReqRes: Result[DmRequest] = readDmRequest(dmIn)
    if IsErr(dmInboundReqRes):
        return Err[bool](Error(dmInboundReqRes))
    let dmInboundReq: DmRequest = Value(dmInboundReqRes)
    var dmOutboundResp: DmResponse = initDmResponse()
    dmOutboundResp.ok = true
    dmOutboundResp.message = "echo:" + dmInboundReq.text
    let dmInboundWriteRes: Result[bool] = writeDmResponse(dmIn, dmOutboundResp)
    if IsErr(dmInboundWriteRes):
        return Err[bool](Error(dmInboundWriteRes))
    let dmRespRes: Result[DmResponse] = readDmResponse(dmOut)
    if IsErr(dmRespRes):
        return Err[bool](Error(dmRespRes))
    let dmResp: DmResponse = Value(dmRespRes)
    if !dmResp.ok || (dmResp.message != "echo:ping"):
        return Err[bool]("smoke: dm response mismatch")

    let scOutRes: Result[Stream] = openStream(outboundMux)
    if IsErr(scOutRes):
        return Err[bool](Error(scOutRes))
    var scOut: Stream = Value(scOutRes)
    let scInRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(scInRes):
        return Err[bool](Error(scInRes))
    var scIn: Stream = Value(scInRes)
    let scDialRes: Result[bool] = multistreamSelectPair(scOut, scIn, synccastControlCodec)
    if IsErr(scDialRes):
        return Err[bool](Error(scDialRes))
    var hello: SynccastHello = initSynccastHello()
    hello.supportsDatagram = true
    hello.maxDatagramBytes = 1200
    let addCodecRes: Result[bool] = StringListAdd(hello.codecs, "h264")
    if IsErr(addCodecRes):
        return Err[bool](Error(addCodecRes))
    hello.deviceClass = "desktop"
    let helloPayloadRes: Result[Bytes] = encodeSynccastHello(hello)
    if IsErr(helloPayloadRes):
        return Err[bool](Error(helloPayloadRes))
    var helloMsg: SynccastControlMessage = initSynccastControlMessage()
    helloMsg.kind = synccastHelloKind
    helloMsg.payload = Value(helloPayloadRes)
    helloMsg.sessionId = 0
    helloMsg.msgId = 1
    helloMsg.ackMsgId = 0
    helloMsg.timestampMonoUs = 1234
    let scWriteRes: Result[bool] = writeSynccastControlMessage(scOut, helloMsg)
    if IsErr(scWriteRes):
        return Err[bool](Error(scWriteRes))
    let scInboundReqRes: Result[SynccastControlMessage] = readSynccastControlMessage(scIn)
    if IsErr(scInboundReqRes):
        return Err[bool](Error(scInboundReqRes))
    let scInboundReq: SynccastControlMessage = Value(scInboundReqRes)
    if scInboundReq.kind != synccastHelloKind:
        return Err[bool]("smoke: synccast hello kind mismatch")
    let scHelloRes: Result[SynccastHello] = decodeSynccastHello(scInboundReq.payload)
    if IsErr(scHelloRes):
        return Err[bool](Error(scHelloRes))
    let scHello: SynccastHello = Value(scHelloRes)
    if !scHello.supportsDatagram:
        return Err[bool]("smoke: synccast datagram flag missing")
    var negotiated: SynccastNegotiated = initSynccastNegotiated()
    negotiated.ok = true
    negotiated.sessionId = int64(mdnsQuicSmokeSessionId)
    negotiated.targetLatencyMs = 0
    negotiated.message = "ok"
    let negotiatedPayloadRes: Result[Bytes] = encodeSynccastNegotiated(negotiated)
    if IsErr(negotiatedPayloadRes):
        return Err[bool](Error(negotiatedPayloadRes))
    var scOutboundResp: SynccastControlMessage = initSynccastControlMessage()
    scOutboundResp.protoMajor = scInboundReq.protoMajor
    scOutboundResp.protoMinor = scInboundReq.protoMinor
    scOutboundResp.kind = synccastNegotiatedKind
    scOutboundResp.sessionId = int64(mdnsQuicSmokeSessionId)
    scOutboundResp.msgId = scInboundReq.msgId + 1
    scOutboundResp.ackMsgId = scInboundReq.msgId
    scOutboundResp.payload = Value(negotiatedPayloadRes)
    let scInboundWriteRes: Result[bool] = writeSynccastControlMessage(scIn, scOutboundResp)
    if IsErr(scInboundWriteRes):
        return Err[bool](Error(scInboundWriteRes))
    let scRespRes: Result[SynccastControlMessage] = readSynccastControlMessage(scOut)
    if IsErr(scRespRes):
        return Err[bool](Error(scRespRes))
    let scResp: SynccastControlMessage = Value(scRespRes)
    if scResp.ackMsgId != helloMsg.msgId:
        return Err[bool]("smoke: synccast negotiated ack mismatch")
    if scResp.sessionId != int64(mdnsQuicSmokeSessionId):
        return Err[bool]("smoke: synccast negotiated session in envelope mismatch")
    if scResp.kind != synccastNegotiatedKind:
        return Err[bool]("smoke: synccast negotiated kind mismatch")

    var cfg: SynccastSessionConfig = initSynccastSessionConfig()
    cfg.sessionId = int64(mdnsQuicSmokeSessionId)
    cfg.targetLatencyMs = 0
    cfg.maxPayloadBytes = 1100
    var sender: SynccastSession = initSynccastSession(cfg)
    var receiver: SynccastSession = initSynccastSession(cfg)
    let nowUs: int64 = synccastNowUs()
    let audioPayload: Bytes = BytesFromString("call-audio")
    let sendAudioRes: Result[int32] = session_msquic.synccastSessionSendAudio(client, outConn, sender, 1, nowUs, nowUs, audioPayload)
    if IsErr(sendAudioRes):
        return Err[bool](Error(sendAudioRes))
    let videoPayload: Bytes = BytesFromString("call-video")
    let sendVideoRes: Result[int32] = session_msquic.synccastSessionSendVideo(client, outConn, sender, 2, nowUs + 20000, nowUs + 20000, videoPayload, true)
    if IsErr(sendVideoRes):
        return Err[bool](Error(sendVideoRes))
    var received: int32
    var gotAudio: bool
    var gotVideo: bool
    let deadlineUs: int64 = synccastNowUs() + 2000000
    while received < 2 && synccastNowUs() < deadlineUs: # cheng-syntax-policy: allow-counting-while
        let handleRes: Result[bool] = session_msquic.synccastSessionHandleDatagram(server, inConn, receiver)
        if IsErr(handleRes):
            return Err[bool](Error(handleRes))
        if Value(handleRes):
            let frameRes: Result[SynccastFrame] = synccastSessionPopFrame(receiver)
            if IsErr(frameRes):
                return Err[bool](Error(frameRes))
            let frame: SynccastFrame = Value(frameRes)
            if frame.header.trackId == synccastTrackAudio:
                if !BytesEqual(frame.payload, audioPayload):
                    return Err[bool]("smoke: audio payload mismatch")
                gotAudio = true
            elif frame.header.trackId == synccastTrackVideo:
                if !BytesEqual(frame.payload, videoPayload):
                    return Err[bool]("smoke: video payload mismatch")
                if (frame.header.flags & synccastFlagKeyframe) == 0:
                    return Err[bool]("smoke: video keyframe missing")
                gotVideo = true
            received = received + 1
    if received < 2:
        return Err[bool]("smoke: synccast datagram timeout")
    if !gotAudio || !gotVideo:
        return Err[bool]("smoke: synccast audio/video missing")
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runMdnsQuicDmSynccastSmoke()
    if IsErr(res):
        echo("mdns quic dm synccast smoke failed: " + Error(res))
        return 1
    echo("mdns quic dm synccast smoke ok")
    return 0
