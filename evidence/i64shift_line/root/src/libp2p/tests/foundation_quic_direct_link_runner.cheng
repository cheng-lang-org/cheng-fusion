# Foundation QUIC direct-link runner(real path).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/mdns_quic_dm_synccast_smoke
fn main(): int32 =
    let runRes: Result[bool] = runMdnsQuicDmSynccastSmoke()
    if IsErr(runRes):
        echo("foundation quic direct-link failed")
        echo(Error(runRes))
        return 1
    echo("foundation quic direct-link ok")
    return 0
