# Delegated routing smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/delegatedrouting/store
import cheng/libp2p/delegatedrouting/server
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runDelegatedRoutingSmoke(): Result[bool] =
    var store: DelegatedStore = initDelegatedStore()
    let putRes: Result[bool] = delegatedStorePut(store, "key1", "value1")
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    setDelegatedRoutingStore(store)
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/40")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    var req: DelegatedRoutingRequest = DelegatedRoutingRequest(key: "key1")
    let writeRes: Result[bool] = writeDelegatedRoutingRequest(outStream, req)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = delegatedRoutingHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let replyRes: Result[DelegatedRoutingResponse] = readDelegatedRoutingResponse(outStream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let resp: DelegatedRoutingResponse = Value(replyRes)
    if ! resp.ok:
        return Err[bool]("smoke: delegated routing ! ok")
    if (resp.value != "value1"):
        return Err[bool]("smoke: delegated routing value mismatch")
    return Ok[bool](true)
