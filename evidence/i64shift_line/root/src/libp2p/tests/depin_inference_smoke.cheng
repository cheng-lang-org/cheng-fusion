# DePIN inference smoke(stage scheduling + strict ordered pipeline + fail-fast).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/depin/inference_manifest
import cheng/libp2p/protocols/depin/inference_pipeline
import cheng/libp2p/protocols/depin/inference_scheduler

fn newDepinInferenceSmokeSession(reqRaw: DepinInferenceRequest, cfgRaw: DepinInferenceConfig): inference_manifest.DepinInferenceSession =
    var req: DepinInferenceRequest = reqRaw
    var cfg: DepinInferenceConfig = cfgRaw
    var session = depinInferenceInitSession(req, cfg)
    session.sessionId = "sid:depin:smoke"
    session.started = true
    session.lastStageAtMs = depinInferenceNowMs()
    return session

fn runDepinInferenceSmoke(): Result[bool] =
    var req: DepinInferenceRequest = initDepinInferenceRequest()
    req.requestId = "req:depin:smoke"
    req.modelCid = "cid:model:smoke"
    req.promptRef = "prompt:smoke"
    req.riskLevel = "base"

    var layerCids: str[]
    add(layerCids, "cid:layer:0")
    add(layerCids, "cid:layer:1")
    add(layerCids, "cid:layer:2")
    req.layerCids = layerCids

    var peers: str[]
    add(peers, "peer:a")
    add(peers, "peer:b")

    var cfg: DepinInferenceConfig = initDepinInferenceConfig()
    cfg.stageTimeoutMs = 60
    cfg.hiddenStateFrameBytes = 8192

    let peerCount: int32 = 2
    let layerCount: int32 = 3
    if peerCount <= 0 || layerCount <= 0:
        return Err[bool]("depin inference smoke: scheduler inputs empty")
    let assignment0 = inference_scheduler.DepinSchedulerAssignmentAt(peers, peerCount, layerCids, layerCount, 0)
    let assignment1 = inference_scheduler.DepinSchedulerAssignmentAt(peers, peerCount, layerCids, layerCount, 1)
    let assignment2 = inference_scheduler.DepinSchedulerAssignmentAt(peers, peerCount, layerCids, layerCount, 2)
    if assignment0.stageIndex != 0 || assignment0.peerId != "peer:a" || assignment0.layerCid != "cid:layer:0":
        return Err[bool]("depin inference smoke: assignment0 mismatch")
    if assignment1.stageIndex != 1 || assignment1.peerId != "peer:b" || assignment1.layerCid != "cid:layer:1":
        return Err[bool]("depin inference smoke: assignment1 mismatch")
    if assignment2.stageIndex != 2 || assignment2.peerId != "peer:a" || assignment2.layerCid != "cid:layer:2":
        return Err[bool]("depin inference smoke: assignment2 mismatch")

    var tensorShardCids: str[]
    add(tensorShardCids, "cid:tensor:qkv:0")
    add(tensorShardCids, "cid:tensor:qkv:1")
    var expertShardCids: str[]
    add(expertShardCids, "cid:expert:0")
    add(expertShardCids, "cid:expert:1")
    var kernelProgramCids: str[]
    add(kernelProgramCids, "cid:kernel:gemm")
    add(kernelProgramCids, "cid:kernel:top2-router")
    let distributedManifest: inference_manifest.DepinDistributedInferenceManifest = inference_manifest.DepinBuildDistributedManifest(
        req.modelCid,
        "cid:partition:plan",
        tensorShardCids,
        expertShardCids,
        kernelProgramCids,
        "cid:weight-device:binding",
        "cid:kv:page-table",
        "cid:kv:state",
        "cid:kv:shard-receipt",
        "cid:kv:page_transfer_evidence:404",
        "cid:router:top2",
        int64(101),
        int64(202),
        int64(303),
        depinInferenceNowMs()
    )
    let manifestOk: Result[bool] = inference_manifest.DepinValidateDistributedManifest(distributedManifest)
    if IsErr(manifestOk):
        return Err[bool](Error(manifestOk))
    var hashDriftManifest: inference_manifest.DepinDistributedInferenceManifest = distributedManifest
    hashDriftManifest.transportFrameSetHash = hashDriftManifest.transportFrameSetHash + int64(1)
    let hashDriftOk: Result[bool] = inference_manifest.DepinValidateDistributedManifest(hashDriftManifest)
    if IsOk(hashDriftOk):
        return Err[bool]("depin inference smoke: distributed manifest hash drift should fail")
    let duplicateTensorManifest: inference_manifest.DepinDistributedInferenceManifest = inference_manifest.DepinBuildDistributedManifest(
        req.modelCid,
        "cid:partition:plan",
        ["cid:tensor:qkv:0", "cid:tensor:qkv:0"],
        expertShardCids,
        kernelProgramCids,
        "cid:weight-device:binding",
        "cid:kv:page-table",
        "cid:kv:state",
        "cid:kv:shard-receipt",
        "cid:kv:page_transfer_evidence:404",
        "cid:router:top2",
        int64(101),
        int64(202),
        int64(303),
        depinInferenceNowMs()
    )
    let duplicateTensorOk: Result[bool] = inference_manifest.DepinValidateDistributedManifest(duplicateTensorManifest)
    if IsOk(duplicateTensorOk):
        return Err[bool]("depin inference smoke: duplicate tensor shard should fail")

    var session: inference_manifest.DepinInferenceSession = newDepinInferenceSmokeSession(req, cfg)
    let frame: Bytes = BytesAlloc(cfg.hiddenStateFrameBytes)
    BytesSet(frame, 0, 7)
    BytesSet(frame, 1, 9)

    let stage0Res: Result[bool] = depinPipelineServeStage(session, uint64(0), frame, depinInferenceNowMs())
    if IsErr(stage0Res):
        return Err[bool](Error(stage0Res))
    let stage1Res: Result[bool] = depinPipelineServeStage(session, uint64(1), frame, depinInferenceNowMs())
    if IsErr(stage1Res):
        return Err[bool](Error(stage1Res))
    if session.stageIndex != 2 || session.expectedSeqNo != uint64(2):
        return Err[bool]("depin inference smoke: pipeline progress mismatch")

    var outOfOrderSession: inference_manifest.DepinInferenceSession = newDepinInferenceSmokeSession(req, cfg)
    let ooServeRes: Result[bool] = depinPipelineServeStage(
        outOfOrderSession,
        uint64(1),
        frame,
        depinInferenceNowMs()
    )
    if IsOk(ooServeRes):
        return Err[bool]("depin inference smoke: out-of-order stage should fail")
    if outOfOrderSession.failureReason != "out_of_order":
        return Err[bool]("depin inference smoke: out-of-order reason mismatch")

    var timeoutSession: inference_manifest.DepinInferenceSession = newDepinInferenceSmokeSession(req, cfg)
    timeoutSession.lastStageAtMs = depinInferenceNowMs() - int64(timeoutSession.config.stageTimeoutMs) - int64(1000)
    let timeoutServeRes: Result[bool] = depinPipelineServeStage(
        timeoutSession,
        uint64(0),
        frame,
        depinInferenceNowMs()
    )
    if IsOk(timeoutServeRes):
        return Err[bool]("depin inference smoke: timeout stage should fail")
    if timeoutSession.failureReason != "stage_timeout":
        return Err[bool]("depin inference smoke: timeout reason mismatch")

    return Ok[bool](true)
