# did-auth integration tests.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/stringlist
import std/times
import cheng/libp2p/crypto/crypto
import cheng/libp2p/peerid
import cheng/libp2p/did/types
import cheng/libp2p/did/identity_store
import cheng/libp2p/did/resolver
import cheng/libp2p/protocols/didauth
import cheng/libp2p/protocols/pubsub/gossipsub

fn didAuthTestCapabilities(): Result[StringList] =
    var out: StringList = InitStringList()
    let addFpRes: Result[bool] = StringListAdd(out, "fingerprint")
    if IsErr(addFpRes):
        return Err[StringList](Error(addFpRes))
    return Ok[StringList](out)

fn buildSecondDeviceIdentity(
    root: KeyPair,
    device: KeyPair,
    caps: StringList,
    document: DidDocumentV1,
    signedDocument: Bytes,
    delegationProof: Bytes
): Result[DidIdentity] =
    let rootPidRes: Result[PeerId] = peerIdFromPrivateKey(root.privateKey)
    if IsErr(rootPidRes):
        return Err[DidIdentity](Error(rootPidRes))
    let devicePidRes: Result[PeerId] = peerIdFromPrivateKey(device.privateKey)
    if IsErr(devicePidRes):
        return Err[DidIdentity](Error(devicePidRes))
    var identity: DidIdentity = initDidIdentity()
    identity.did = document.id
    identity.rootPrivateKey = root.privateKey
    identity.rootPublicKey = root.publicKey
    identity.rootPeerId = Value(rootPidRes)
    identity.devicePrivateKey = device.privateKey
    identity.devicePublicKey = device.publicKey
    identity.devicePeerId = Value(devicePidRes)
    identity.biometricCapabilities = caps
    identity.biometricClass = "local"
    identity.document = document
    identity.signedDocument = signedDocument
    identity.delegationProof = delegationProof
    return Ok[DidIdentity](identity)

fn runDidAuthRevocationGossipIntegration(): Result[bool] =
    didResolverReset()
    let rootRes: Result[KeyPair] = generateKeyPair()
    if IsErr(rootRes):
        return Err[bool](Error(rootRes))
    let deviceARes: Result[KeyPair] = generateKeyPair()
    if IsErr(deviceARes):
        return Err[bool](Error(deviceARes))
    let deviceBRes: Result[KeyPair] = generateKeyPair()
    if IsErr(deviceBRes):
        return Err[bool](Error(deviceBRes))
    let capsRes: Result[StringList] = didAuthTestCapabilities()
    if IsErr(capsRes):
        return Err[bool](Error(capsRes))
    let caps: StringList = Value(capsRes)
    let identityARes: Result[DidIdentity] = didIdentityFromKeypairs(
        Value(rootRes),
        Value(deviceARes),
        "local",
        caps
    )
    if IsErr(identityARes):
        return Err[bool](Error(identityARes))
    var identityA: DidIdentity = Value(identityARes)
    var proofB: Bytes = EmptyBytes()
    let enrollRes: Result[bool] = didIdentityEnrollDevice(
        identityA,
        Value(deviceBRes).publicKey,
        "local",
        caps,
        EpochTimeNs(),
        proofB
    )
    if IsErr(enrollRes):
        return Err[bool](Error(enrollRes))
    let identityBRes: Result[DidIdentity] = buildSecondDeviceIdentity(
        Value(rootRes),
        Value(deviceBRes),
        caps,
        identityA.document,
        identityA.signedDocument,
        proofB
    )
    if IsErr(identityBRes):
        return Err[bool](Error(identityBRes))
    let identityB: DidIdentity = Value(identityBRes)

    var cfg: DidAuthConfig = initDidAuthConfig()
    cfg.enabled = true
    cfg.required = true
    var verifier: DidAuthState = initDidAuthState()
    setDidAuthConfig(verifier, cfg)
    setDidAuthIdentity(verifier, identityA)

    let preInitRes: Result[DidAuthInitMessage] = didAuthBuildAndSignInit(identityB, BytesFromString("nonce-gossip-pre"), didAuthNowMs())
    if IsErr(preInitRes):
        return Err[bool](Error(preInitRes))
    let preValidateRes: Result[DeviceDelegationProofV1] = didAuthValidateInit(verifier, Value(preInitRes), didAuthNowMs())
    if IsErr(preValidateRes):
        return Err[bool](Error(preValidateRes))

    var revocation: Bytes = EmptyBytes()
    let revokeRes: Result[bool] = didIdentityRevokeDevice(identityA, toString(identityB.devicePeerId), EpochTimeNs(), revocation)
    if IsErr(revokeRes):
        return Err[bool](Error(revokeRes))
    let topicRes: Result[str] = didRevocationTopic(identityA.did)
    if IsErr(topicRes):
        return Err[bool](Error(topicRes))
    let applyRes: Result[bool] = gossipsubApplyDidRevocation(Value(topicRes), revocation)
    if IsErr(applyRes):
        return Err[bool](Error(applyRes))
    if ! Value(applyRes):
        return Err[bool]("integration: revocation gossip apply returned false")
    if ! didResolverIsDeviceRevoked(identityA.did, toString(identityB.devicePeerId)):
        return Err[bool]("integration: revocation cache not updated from gossip")

    let postInitRes: Result[DidAuthInitMessage] = didAuthBuildAndSignInit(identityB, BytesFromString("nonce-gossip-post"), didAuthNowMs())
    if IsErr(postInitRes):
        return Err[bool](Error(postInitRes))
    let postValidateRes: Result[DeviceDelegationProofV1] = didAuthValidateInit(verifier, Value(postInitRes), didAuthNowMs())
    if IsOk(postValidateRes):
        return Err[bool]("integration: gossip-applied revocation still passed didauth")
    return Ok[bool](true)

fn runDidAuthIntegration(): Result[bool] =
    didResolverReset()
    let rootRes: Result[KeyPair] = generateKeyPair()
    if IsErr(rootRes):
        return Err[bool](Error(rootRes))
    let deviceARes: Result[KeyPair] = generateKeyPair()
    if IsErr(deviceARes):
        return Err[bool](Error(deviceARes))
    let deviceBRes: Result[KeyPair] = generateKeyPair()
    if IsErr(deviceBRes):
        return Err[bool](Error(deviceBRes))
    let capsRes: Result[StringList] = didAuthTestCapabilities()
    if IsErr(capsRes):
        return Err[bool](Error(capsRes))
    let caps: StringList = Value(capsRes)
    let identityARes: Result[DidIdentity] = didIdentityFromKeypairs(
        Value(rootRes),
        Value(deviceARes),
        "local",
        caps
    )
    if IsErr(identityARes):
        return Err[bool](Error(identityARes))
    var identityA: DidIdentity = Value(identityARes)
    var proofB: Bytes = EmptyBytes()
    let enrollRes: Result[bool] = didIdentityEnrollDevice(
        identityA,
        Value(deviceBRes).publicKey,
        "local",
        caps,
        EpochTimeNs(),
        proofB
    )
    if IsErr(enrollRes):
        return Err[bool](Error(enrollRes))
    let identityBRes: Result[DidIdentity] = buildSecondDeviceIdentity(
        Value(rootRes),
        Value(deviceBRes),
        caps,
        identityA.document,
        identityA.signedDocument,
        proofB
    )
    if IsErr(identityBRes):
        return Err[bool](Error(identityBRes))
    let identityB: DidIdentity = Value(identityBRes)

    var cfg: DidAuthConfig = initDidAuthConfig()
    cfg.enabled = true
    cfg.required = true

    var stateA: DidAuthState = initDidAuthState()
    setDidAuthConfig(stateA, cfg)
    setDidAuthIdentity(stateA, identityA)
    var stateB: DidAuthState = initDidAuthState()
    setDidAuthConfig(stateB, cfg)
    setDidAuthIdentity(stateB, identityB)

    let nonceC: Bytes = BytesFromString("nonce-c-1")
    let nowMs: int64 = didAuthNowMs()
    let initRes: Result[DidAuthInitMessage] = didAuthBuildAndSignInit(identityA, nonceC, nowMs)
    if IsErr(initRes):
        return Err[bool](Error(initRes))
    let initValidateRes: Result[DeviceDelegationProofV1] = didAuthValidateInit(stateB, Value(initRes), nowMs)
    if IsErr(initValidateRes):
        return Err[bool](Error(initValidateRes))

    let nonceS: Bytes = BytesFromString("nonce-s-1")
    let respRes: Result[DidAuthRespMessage] = didAuthBuildAndSignResp(identityB, nonceS, nonceC, nowMs)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let respValidateRes: Result[DeviceDelegationProofV1] = didAuthValidateResp(stateA, Value(respRes), nonceC, nowMs)
    if IsErr(respValidateRes):
        return Err[bool](Error(respValidateRes))

    var stateBReject: DidAuthState = initDidAuthState()
    setDidAuthConfig(stateBReject, cfg)
    setDidAuthIdentity(stateBReject, identityB)
    let badNonce: Bytes = BytesFromString("nonce-c-2")
    let badInitRes: Result[DidAuthInitMessage] = didAuthBuildAndSignInit(identityA, badNonce, didAuthNowMs())
    if IsErr(badInitRes):
        return Err[bool](Error(badInitRes))
    var badInit: DidAuthInitMessage = Value(badInitRes)
    badInit.peerId = toString(identityB.devicePeerId)
    let badValidateRes: Result[DeviceDelegationProofV1] = didAuthValidateInit(stateBReject, badInit, didAuthNowMs())
    if IsOk(badValidateRes):
        return Err[bool]("integration: didauth accepted mismatched peer id")

    var revocation: Bytes = EmptyBytes()
    let revokeRes: Result[bool] = didAuthRevokeDevice(stateA, toString(identityB.devicePeerId), revocation)
    if IsErr(revokeRes):
        return Err[bool](Error(revokeRes))
    let afterRevokeInitRes: Result[DidAuthInitMessage] = didAuthBuildAndSignInit(identityB, BytesFromString("nonce-c-3"), didAuthNowMs())
    if IsErr(afterRevokeInitRes):
        return Err[bool](Error(afterRevokeInitRes))
    let revokedValidateRes: Result[DeviceDelegationProofV1] = didAuthValidateInit(stateA, Value(afterRevokeInitRes), didAuthNowMs())
    if IsOk(revokedValidateRes):
        return Err[bool]("integration: revoked device passed didauth")

    var requiredOnly: DidAuthState = initDidAuthState()
    var requiredCfg: DidAuthConfig = initDidAuthConfig()
    requiredCfg.required = true
    setDidAuthConfig(requiredOnly, requiredCfg)
    if ! didAuthShouldRun(requiredOnly):
        return Err[bool]("integration: required didauth should run")
    let requiredSummaryRes: Result[DidIdentitySummary] = didAuthIdentitySummary(requiredOnly)
    if IsOk(requiredSummaryRes):
        return Err[bool]("integration: required didauth should fail without identity")

    let gossipRes: Result[bool] = runDidAuthRevocationGossipIntegration()
    if IsErr(gossipRes):
        return Err[bool](Error(gossipRes))

    return Ok[bool](true)
