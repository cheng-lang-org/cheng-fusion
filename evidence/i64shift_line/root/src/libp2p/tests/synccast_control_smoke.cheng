# Synccast control smoke test(handshake + protobuf roundtrips).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/stringlist
import cheng/libp2p/protocols/synccast/control
import cheng/libp2p/protocols/synccast/protobuf
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/stream/connection
import cheng/libp2p/multiaddress
import cheng/libp2p/muxers/muxer
const
    synccastSmokeMaxDatagram = 1200
    synccastSmokeSessionId = 77
    synccastSmokeTargetLatency = 200
    synccastSmokeCodecAudio = "opus"
    synccastSmokeCodecVideo = "h264"
    synccastSmokeDeviceClass = "desktop"

fn synccastControlSmokeHandler(msg: SynccastControlMessage): Result[SynccastControlMessage] =
    if msg.protoMajor != synccastProtoMajor || msg.protoMinor != synccastProtoMinor:
        return Err[SynccastControlMessage]("smoke: proto version mismatch")
    if msg.msgId <= 0:
        return Err[SynccastControlMessage]("smoke: missing msg id")
    if msg.kind != synccastHelloKind:
        return Err[SynccastControlMessage]("smoke: expected hello")
    let helloRes: Result[SynccastHello] = decodeSynccastHello(msg.payload)
    if IsErr(helloRes):
        return Err[SynccastControlMessage](Error(helloRes))
    let hello: SynccastHello = Value(helloRes)
    if ! hello.supportsDatagram:
        return Err[SynccastControlMessage]("smoke: hello datagram flag missing")
    if hello.maxDatagramBytes != synccastSmokeMaxDatagram:
        return Err[SynccastControlMessage]("smoke: hello max datagram mismatch")
    if ! StringListContains(hello.codecs, synccastSmokeCodecAudio):
        return Err[SynccastControlMessage]("smoke: hello missing opus codec")
    if ! StringListContains(hello.codecs, synccastSmokeCodecVideo):
        return Err[SynccastControlMessage]("smoke: hello missing h264 codec")
    if (hello.deviceClass != synccastSmokeDeviceClass):
        return Err[SynccastControlMessage]("smoke: hello device class mismatch")
    var negotiated: SynccastNegotiated = initSynccastNegotiated()
    negotiated.ok = true
    negotiated.sessionId = int64(synccastSmokeSessionId)
    negotiated.targetLatencyMs = synccastSmokeTargetLatency
    negotiated.message = "ok"
    let payloadRes: Result[Bytes] = encodeSynccastNegotiated(negotiated)
    if IsErr(payloadRes):
        return Err[SynccastControlMessage](Error(payloadRes))
    var resp: SynccastControlMessage = initSynccastControlMessage()
    resp.kind = synccastNegotiatedKind
    resp.sessionId = int64(synccastSmokeSessionId)
    resp.payload = Value(payloadRes)
    return Ok[SynccastControlMessage](resp)

fn runSynccastControlRoundtrips(): Result[bool] =
    var hello: SynccastHello = initSynccastHello()
    hello.supportsDatagram = true
    hello.maxDatagramBytes = synccastSmokeMaxDatagram
    let addAudioRes: Result[bool] = StringListAdd(hello.codecs, synccastSmokeCodecAudio)
    if IsErr(addAudioRes):
        return Err[bool](Error(addAudioRes))
    let addVideoRes: Result[bool] = StringListAdd(hello.codecs, synccastSmokeCodecVideo)
    if IsErr(addVideoRes):
        return Err[bool](Error(addVideoRes))
    hello.deviceClass = synccastSmokeDeviceClass
    let encHelloRes: Result[Bytes] = encodeSynccastHello(hello)
    if IsErr(encHelloRes):
        return Err[bool](Error(encHelloRes))
    let decHelloRes: Result[SynccastHello] = decodeSynccastHello(Value(encHelloRes))
    if IsErr(decHelloRes):
        return Err[bool](Error(decHelloRes))
    let decHello: SynccastHello = Value(decHelloRes)
    if ! decHello.supportsDatagram:
        return Err[bool]("smoke: hello roundtrip supportsDatagram false")
    if decHello.maxDatagramBytes != synccastSmokeMaxDatagram:
        return Err[bool]("smoke: hello roundtrip max datagram mismatch")
    if ! StringListContains(decHello.codecs, synccastSmokeCodecAudio):
        return Err[bool]("smoke: hello roundtrip missing opus")
    if ! StringListContains(decHello.codecs, synccastSmokeCodecVideo):
        return Err[bool]("smoke: hello roundtrip missing h264")
    if (decHello.deviceClass != synccastSmokeDeviceClass):
        return Err[bool]("smoke: hello roundtrip device mismatch")

    var negotiated: SynccastNegotiated = initSynccastNegotiated()
    negotiated.ok = true
    negotiated.sessionId = int64(synccastSmokeSessionId)
    negotiated.targetLatencyMs = synccastSmokeTargetLatency
    negotiated.message = "ok"
    let encNegRes: Result[Bytes] = encodeSynccastNegotiated(negotiated)
    if IsErr(encNegRes):
        return Err[bool](Error(encNegRes))
    let decNegRes: Result[SynccastNegotiated] = decodeSynccastNegotiated(Value(encNegRes))
    if IsErr(decNegRes):
        return Err[bool](Error(decNegRes))
    let decNeg: SynccastNegotiated = Value(decNegRes)
    if ! decNeg.ok:
        return Err[bool]("smoke: negotiated roundtrip ok false")
    if decNeg.sessionId != int64(synccastSmokeSessionId):
        return Err[bool]("smoke: negotiated session mismatch")
    if decNeg.targetLatencyMs != synccastSmokeTargetLatency:
        return Err[bool]("smoke: negotiated latency mismatch")
    if (decNeg.message != "ok"):
        return Err[bool]("smoke: negotiated message mismatch")

    var sub: SynccastSubscribe = initSynccastSubscribe()
    let addTrackARes: Result[bool] = synccastTrackListAdd(sub.tracks, SynccastTrackRef(trackId: 10, layerId: 0))
    if IsErr(addTrackARes):
        return Err[bool](Error(addTrackARes))
    let addTrackBRes: Result[bool] = synccastTrackListAdd(sub.tracks, SynccastTrackRef(trackId: 11, layerId: 2))
    if IsErr(addTrackBRes):
        return Err[bool](Error(addTrackBRes))
    sub.wantsKeyframe = true
    let encSubRes: Result[Bytes] = encodeSynccastSubscribe(sub)
    if IsErr(encSubRes):
        return Err[bool](Error(encSubRes))
    let decSubRes: Result[SynccastSubscribe] = decodeSynccastSubscribe(Value(encSubRes))
    if IsErr(decSubRes):
        return Err[bool](Error(decSubRes))
    let decSub: SynccastSubscribe = Value(decSubRes)
    if decSub.tracks.count != 2:
        return Err[bool]("smoke: subscribe track count mismatch")
    if decSub.tracks.items[0].trackId != 10 || decSub.tracks.items[0].layerId != 0:
        return Err[bool]("smoke: subscribe track 0 mismatch")
    if decSub.tracks.items[1].trackId != 11 || decSub.tracks.items[1].layerId != 2:
        return Err[bool]("smoke: subscribe track 1 mismatch")
    if ! decSub.wantsKeyframe:
        return Err[bool]("smoke: subscribe wantsKeyframe false")

    var pub: SynccastPublish = initSynccastPublish()
    pub.trackId = 9
    pub.kind = "video"
    pub.codec = "h264"
    pub.priority = 5
    pub.maxBitrateKbps = 1500
    pub.targetLatencyMs = synccastSmokeTargetLatency
    let encPubRes: Result[Bytes] = encodeSynccastPublish(pub)
    if IsErr(encPubRes):
        return Err[bool](Error(encPubRes))
    let decPubRes: Result[SynccastPublish] = decodeSynccastPublish(Value(encPubRes))
    if IsErr(decPubRes):
        return Err[bool](Error(decPubRes))
    let decPub: SynccastPublish = Value(decPubRes)
    if decPub.trackId != pub.trackId:
        return Err[bool]("smoke: publish track mismatch")
    if (decPub.kind != pub.kind) || (decPub.codec != pub.codec):
        return Err[bool]("smoke: publish kind/codec mismatch")
    if decPub.priority != pub.priority:
        return Err[bool]("smoke: publish priority mismatch")
    if decPub.maxBitrateKbps != pub.maxBitrateKbps:
        return Err[bool]("smoke: publish bitrate mismatch")
    if decPub.targetLatencyMs != pub.targetLatencyMs:
        return Err[bool]("smoke: publish latency mismatch")

    var stats: SynccastStats = initSynccastStats()
    stats.lossPermille = 7
    stats.jitterMs = 13
    stats.e2eMs = 200
    stats.framesDropped = 2
    stats.bufferMs = 55
    stats.rttMs = 42
    let encStatsRes: Result[Bytes] = encodeSynccastStats(stats)
    if IsErr(encStatsRes):
        return Err[bool](Error(encStatsRes))
    let decStatsRes: Result[SynccastStats] = decodeSynccastStats(Value(encStatsRes))
    if IsErr(decStatsRes):
        return Err[bool](Error(decStatsRes))
    let decStats: SynccastStats = Value(decStatsRes)
    if decStats.lossPermille != stats.lossPermille || decStats.jitterMs != stats.jitterMs:
        return Err[bool]("smoke: stats loss/jitter mismatch")
    if decStats.e2eMs != stats.e2eMs || decStats.framesDropped != stats.framesDropped:
        return Err[bool]("smoke: stats e2e/dropped mismatch")
    if decStats.bufferMs != stats.bufferMs || decStats.rttMs != stats.rttMs:
        return Err[bool]("smoke: stats buffer/rtt mismatch")

    let wrapRes: Result[Bytes] = encodeSynccastMessage(synccastStatsKind, Value(encStatsRes))
    if IsErr(wrapRes):
        return Err[bool](Error(wrapRes))
    let msgRes: Result[SynccastControlMessage] = decodeSynccastControlMessage(Value(wrapRes))
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    let msg: SynccastControlMessage = Value(msgRes)
    if msg.protoMajor != synccastProtoMajor || msg.protoMinor != synccastProtoMinor:
        return Err[bool]("smoke: control message proto mismatch")
    if msg.msgId != 1 || msg.ackMsgId != 0 || msg.sessionId != 0:
        return Err[bool]("smoke: control message envelope mismatch")
    if msg.kind != synccastStatsKind:
        return Err[bool]("smoke: control message kind mismatch")
    if ! BytesEqual(msg.payload, Value(encStatsRes)):
        return Err[bool]("smoke: control message payload mismatch")

    var keyframe: SynccastKeyframeRequest = initSynccastKeyframeRequest()
    keyframe.trackId = 9
    keyframe.reason = "sync"
    let encKeyRes: Result[Bytes] = encodeSynccastKeyframeRequest(keyframe)
    if IsErr(encKeyRes):
        return Err[bool](Error(encKeyRes))
    let decKeyRes: Result[SynccastKeyframeRequest] = decodeSynccastKeyframeRequest(Value(encKeyRes))
    if IsErr(decKeyRes):
        return Err[bool](Error(decKeyRes))
    let decKey: SynccastKeyframeRequest = Value(decKeyRes)
    if decKey.trackId != keyframe.trackId || (decKey.reason != keyframe.reason):
        return Err[bool]("smoke: keyframe mismatch")

    var anchor: SynccastSyncAnchor = initSynccastSyncAnchor()
    anchor.senderTsUs = 1111
    anchor.recvTsUs = 2222
    anchor.driftPpm = 3
    let encAnchorRes: Result[Bytes] = encodeSynccastSyncAnchor(anchor)
    if IsErr(encAnchorRes):
        return Err[bool](Error(encAnchorRes))
    let decAnchorRes: Result[SynccastSyncAnchor] = decodeSynccastSyncAnchor(Value(encAnchorRes))
    if IsErr(decAnchorRes):
        return Err[bool](Error(decAnchorRes))
    let decAnchor: SynccastSyncAnchor = Value(decAnchorRes)
    if decAnchor.senderTsUs != anchor.senderTsUs || decAnchor.recvTsUs != anchor.recvTsUs:
        return Err[bool]("smoke: sync anchor ts mismatch")
    if decAnchor.driftPpm != anchor.driftPpm:
        return Err[bool]("smoke: sync anchor drift mismatch")

    var errMsg: SynccastError = initSynccastError()
    errMsg.code = 401
    errMsg.message = "denied"
    let encErrRes: Result[Bytes] = encodeSynccastError(errMsg)
    if IsErr(encErrRes):
        return Err[bool](Error(encErrRes))
    let decErrRes: Result[SynccastError] = decodeSynccastError(Value(encErrRes))
    if IsErr(decErrRes):
        return Err[bool](Error(decErrRes))
    let decErr: SynccastError = Value(decErrRes)
    if decErr.code != errMsg.code || (decErr.message != errMsg.message):
        return Err[bool]("smoke: error roundtrip mismatch")

    var joinBad: SynccastJoinRoom = initSynccastJoinRoom()
    let encJoinBadRes: Result[Bytes] = encodeSynccastJoinRoom(joinBad)
    if ! IsErr(encJoinBadRes):
        return Err[bool]("smoke: join room expected error")
    var join: SynccastJoinRoom = initSynccastJoinRoom()
    join.roomId = "room-1"
    let encJoinRes: Result[Bytes] = encodeSynccastJoinRoom(join)
    if IsErr(encJoinRes):
        return Err[bool](Error(encJoinRes))
    let decJoinRes: Result[SynccastJoinRoom] = decodeSynccastJoinRoom(Value(encJoinRes))
    if IsErr(decJoinRes):
        return Err[bool](Error(decJoinRes))
    let decJoin: SynccastJoinRoom = Value(decJoinRes)
    if (decJoin.roomId != join.roomId):
        return Err[bool]("smoke: join room mismatch")

    var leave: SynccastLeaveRoom = initSynccastLeaveRoom()
    leave.roomId = "room-1"
    let encLeaveRes: Result[Bytes] = encodeSynccastLeaveRoom(leave)
    if IsErr(encLeaveRes):
        return Err[bool](Error(encLeaveRes))
    let decLeaveRes: Result[SynccastLeaveRoom] = decodeSynccastLeaveRoom(Value(encLeaveRes))
    if IsErr(decLeaveRes):
        return Err[bool](Error(decLeaveRes))
    let decLeave: SynccastLeaveRoom = Value(decLeaveRes)
    if (decLeave.roomId != leave.roomId):
        return Err[bool]("smoke: leave room mismatch")

    var unpubBad: SynccastUnpublish = initSynccastUnpublish()
    let encUnpubBadRes: Result[Bytes] = encodeSynccastUnpublish(unpubBad)
    if ! IsErr(encUnpubBadRes):
        return Err[bool]("smoke: unpublish expected error")
    var unpub: SynccastUnpublish = initSynccastUnpublish()
    unpub.trackId = 7
    let encUnpubRes: Result[Bytes] = encodeSynccastUnpublish(unpub)
    if IsErr(encUnpubRes):
        return Err[bool](Error(encUnpubRes))
    let decUnpubRes: Result[SynccastUnpublish] = decodeSynccastUnpublish(Value(encUnpubRes))
    if IsErr(decUnpubRes):
        return Err[bool](Error(decUnpubRes))
    let decUnpub: SynccastUnpublish = Value(decUnpubRes)
    if decUnpub.trackId != unpub.trackId:
        return Err[bool]("smoke: unpublish mismatch")

    var unsub: SynccastUnsubscribe = initSynccastUnsubscribe()
    var addRes: Result[bool] = synccastTrackListAdd(unsub.tracks, SynccastTrackRef(trackId: 10, layerId: 0))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    addRes = synccastTrackListAdd(unsub.tracks, SynccastTrackRef(trackId: 11, layerId: 2))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    let encUnsubRes: Result[Bytes] = encodeSynccastUnsubscribe(unsub)
    if IsErr(encUnsubRes):
        return Err[bool](Error(encUnsubRes))
    let decUnsubRes: Result[SynccastUnsubscribe] = decodeSynccastUnsubscribe(Value(encUnsubRes))
    if IsErr(decUnsubRes):
        return Err[bool](Error(decUnsubRes))
    let decUnsub: SynccastUnsubscribe = Value(decUnsubRes)
    if decUnsub.tracks.count != 2:
        return Err[bool]("smoke: unsubscribe track count")
    if decUnsub.tracks.items[0].trackId != 10 || decUnsub.tracks.items[0].layerId != 0:
        return Err[bool]("smoke: unsubscribe track 0")
    if decUnsub.tracks.items[1].trackId != 11 || decUnsub.tracks.items[1].layerId != 2:
        return Err[bool]("smoke: unsubscribe track 1")

    var abr: SynccastAbrCommand = initSynccastAbrCommand()
    abr.trackId = 9
    abr.layerId = 2
    abr.maxBitrateKbps = 800
    abr.targetFps = 15
    abr.targetWidth = 640
    abr.targetHeight = 360
    let encAbrRes: Result[Bytes] = encodeSynccastAbrCommand(abr)
    if IsErr(encAbrRes):
        return Err[bool](Error(encAbrRes))
    let decAbrRes: Result[SynccastAbrCommand] = decodeSynccastAbrCommand(Value(encAbrRes))
    if IsErr(decAbrRes):
        return Err[bool](Error(decAbrRes))
    let decAbr: SynccastAbrCommand = Value(decAbrRes)
    if decAbr.trackId != abr.trackId || decAbr.layerId != abr.layerId:
        return Err[bool]("smoke: abr track/layer mismatch")
    if decAbr.maxBitrateKbps != abr.maxBitrateKbps || decAbr.targetFps != abr.targetFps:
        return Err[bool]("smoke: abr bitrate/fps mismatch")
    if decAbr.targetWidth != abr.targetWidth || decAbr.targetHeight != abr.targetHeight:
        return Err[bool]("smoke: abr size mismatch")

    var keyBad: SynccastKeyUpdate = initSynccastKeyUpdate()
    keyBad.keyId = 1
    keyBad.key = BytesFromString("short")
    let encKeyBadRes: Result[Bytes] = encodeSynccastKeyUpdate(keyBad)
    if ! IsErr(encKeyBadRes):
        return Err[bool]("smoke: key update expected error")
    var keyUpdate: SynccastKeyUpdate = initSynccastKeyUpdate()
    keyUpdate.keyId = 3
    keyUpdate.key = BytesFromString("0123456789abcdef0123456789abcdef")
    let encKeyUpdateRes: Result[Bytes] = encodeSynccastKeyUpdate(keyUpdate)
    if IsErr(encKeyUpdateRes):
        return Err[bool](Error(encKeyUpdateRes))
    let decKeyUpdateRes: Result[SynccastKeyUpdate] = decodeSynccastKeyUpdate(Value(encKeyUpdateRes))
    if IsErr(decKeyUpdateRes):
        return Err[bool](Error(decKeyUpdateRes))
    let decKeyUpdate: SynccastKeyUpdate = Value(decKeyUpdateRes)
    if decKeyUpdate.keyId != keyUpdate.keyId:
        return Err[bool]("smoke: key update id mismatch")
    if ! BytesEqual(decKeyUpdate.key, keyUpdate.key):
        return Err[bool]("smoke: key update bytes mismatch")

    var snap: SynccastRoomSnapshot = initSynccastRoomSnapshot()
    snap.roomId = "room-1"
    addRes = synccastTrackListAdd(snap.publishedTracks, SynccastTrackRef(trackId: 1, layerId: 0))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    addRes = synccastTrackListAdd(snap.publishedTracks, SynccastTrackRef(trackId: 2, layerId: 0))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    addRes = synccastTrackListAdd(snap.subscribedTracks, SynccastTrackRef(trackId: 2, layerId: 0))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    let encSnapRes: Result[Bytes] = encodeSynccastRoomSnapshot(snap)
    if IsErr(encSnapRes):
        return Err[bool](Error(encSnapRes))
    let decSnapRes: Result[SynccastRoomSnapshot] = decodeSynccastRoomSnapshot(Value(encSnapRes))
    if IsErr(decSnapRes):
        return Err[bool](Error(decSnapRes))
    let decSnap: SynccastRoomSnapshot = Value(decSnapRes)
    if (decSnap.roomId != snap.roomId):
        return Err[bool]("smoke: room snapshot room mismatch")
    if decSnap.publishedTracks.count != 2 || decSnap.subscribedTracks.count != 1:
        return Err[bool]("smoke: room snapshot track counts")

    return Ok[bool](true)

fn runSynccastControlSmoke(): Result[bool] =
    let rtRes: Result[bool] = runSynccastControlRoundtrips()
    if IsErr(rtRes):
        return rtRes
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/55")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    var listener: MemoryTransport = initMemoryTransport()
    start(listener, addr)
    var dialer: MemoryTransport = initMemoryTransport()
    let outConnRes: Result[Connection] = dial(dialer, addr)
    if IsErr(outConnRes):
        return Err[bool](Error(outConnRes))
    let inConnRes: Result[Connection] = accept(listener)
    if IsErr(inConnRes):
        return Err[bool](Error(inConnRes))
    var outboundMux: Muxer = newMuxer(Value(outConnRes))
    if outboundMux.id < 0:
        return Err[bool]("smoke: outbound muxer alloc failed")
    var inboundMux: Muxer = newMuxer(Value(inConnRes))
    if inboundMux.id < 0:
        return Err[bool]("smoke: inbound muxer alloc failed")
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool]("smoke: openStream failed: " + Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool]("smoke: acceptStream failed: " + Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)

    setSynccastControlHandler(synccastControlSmokeHandler)

    var hello: SynccastHello = initSynccastHello()
    hello.supportsDatagram = true
    hello.maxDatagramBytes = synccastSmokeMaxDatagram
    let addAudioRes: Result[bool] = StringListAdd(hello.codecs, synccastSmokeCodecAudio)
    if IsErr(addAudioRes):
        return Err[bool](Error(addAudioRes))
    let addVideoRes: Result[bool] = StringListAdd(hello.codecs, synccastSmokeCodecVideo)
    if IsErr(addVideoRes):
        return Err[bool](Error(addVideoRes))
    hello.deviceClass = synccastSmokeDeviceClass
    let helloPayloadRes: Result[Bytes] = encodeSynccastHello(hello)
    if IsErr(helloPayloadRes):
        return Err[bool](Error(helloPayloadRes))
    var helloMsg: SynccastControlMessage = initSynccastControlMessage()
    helloMsg.kind = synccastHelloKind
    helloMsg.payload = Value(helloPayloadRes)
    helloMsg.sessionId = 0
    helloMsg.msgId = 1
    helloMsg.ackMsgId = 0
    helloMsg.timestampMonoUs = 1234
    let writeRes: Result[bool] = writeSynccastControlMessage(outStream, helloMsg)
    if IsErr(writeRes):
        return Err[bool]("smoke: writeSynccastControlMessage failed: " + Error(writeRes))
    let handleRes: Result[bool] = synccastControlHandler(inStream)
    if IsErr(handleRes):
        return Err[bool]("smoke: synccastControlHandler failed: " + Error(handleRes))
    let respRes: Result[SynccastControlMessage] = readSynccastControlMessage(outStream)
    if IsErr(respRes):
        return Err[bool]("smoke: readSynccastControlMessage failed: " + Error(respRes))
    let resp: SynccastControlMessage = Value(respRes)
    if resp.ackMsgId != helloMsg.msgId:
        return Err[bool]("smoke: negotiated ack mismatch")
    if resp.sessionId != int64(synccastSmokeSessionId):
        return Err[bool]("smoke: negotiated session in envelope mismatch")
    if resp.kind != synccastNegotiatedKind:
        return Err[bool]("smoke: negotiated kind mismatch")
    let decRes: Result[SynccastNegotiated] = decodeSynccastNegotiated(resp.payload)
    if IsErr(decRes):
        return Err[bool](Error(decRes))
    let dec: SynccastNegotiated = Value(decRes)
    if ! dec.ok:
        return Err[bool]("smoke: negotiated ok false")
    if dec.sessionId != int64(synccastSmokeSessionId):
        return Err[bool]("smoke: negotiated session mismatch")
    if dec.targetLatencyMs != synccastSmokeTargetLatency:
        return Err[bool]("smoke: negotiated latency mismatch")
    if (dec.message != "ok"):
        return Err[bool]("smoke: negotiated message mismatch")
    return Ok[bool](true)
