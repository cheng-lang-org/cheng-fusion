# RSA big-int smoke test(PKCS#1 v1.5 + PSS).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/rsa
const
    rsaTestMessage = "cheng-rsa-smoke"
    rsaPrivDerHex = ""
    rsaPubDerHex = "30818902818100c55e89745403b302dff6e2b9264804a80c8fcb50e30ee5d39f37556f903efffe0afeff89b79962a81fc205f4ec358b6648ead365a170d76d77ecc8c94c367926c4331518a1b8f921867f564100de6b0c1a0e7b3a1cb103a6ec86f113850249095def66d4938a37852e6ce2ed73cfed4dca8b16560c91a524c46f33d90e6049e10203010001"
    rsaSigPkcs1Hex = "a28c95b8ce8b68b074d548e39322e1bdc36aceb9ea9df1602f28ba19587849182f18511cb1b797e2fc23ab71b116e3db3347efd3f86945503bb3dab47ce38d8f696b6de1456adcf90a7a2240ad214d5cebd97f99cd0f53b94731bb2f0c5757b0da0bf717b74f324adb357ad3df04d82dc4142e27043de5d1444bf4ef0abf0d1b"
    rsaSigPssHex = "8cebb9e2426f1a7e5cc672056bc4c3e53ec8c8b23cb016865960f569045e708ac19669a2210ed4cf1e980f803a8b669d9834a91a02fbd6ace7e9c0ad52c380a08c5cbb51350fd49206784971c7138e292d5b22c574f0b936a0d8a2151dd69c0c4a48c6fe2a7f0bd77e4e50403ac3fe156820bd86393f93c8c36ae36b85e7eb23"

fn hexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return int32(c) - int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + int32(c) - int32('a')
    if c >= 'A' && c <= 'F':
        return 10 + int32(c) - int32('A')
    return -1

fn hexDecode(text: str): Result[Bytes] =
    if len(text) % 2 != 0:
        return Err[Bytes]("rsa: hex length must be even")
    let out: Bytes = BytesAlloc(len(text) / 2)
    var i: int32
    while i < len(text): # cheng-syntax-policy: allow-counting-while
        let hi: int32 = hexValue(text[i])
        let lo: int32 = hexValue(text[i + 1])
        if hi < 0 || lo < 0:
            return Err[Bytes]("rsa: invalid hex")
        BytesSet(out, i / 2, (hi << 4) | lo)
        i = i + 2
    return Ok[Bytes](out)

fn runRsaBigIntSmoke(): Result[bool] =
    let msg: Bytes = BytesFromString(rsaTestMessage)
    let privDerRes: Result[Bytes] = hexDecode(rsaPrivDerHex)
    if IsErr(privDerRes):
        return Err[bool](Error(privDerRes))
    let pubDerRes: Result[Bytes] = hexDecode(rsaPubDerHex)
    if IsErr(pubDerRes):
        return Err[bool](Error(pubDerRes))
    let sigPkcs1Res: Result[Bytes] = hexDecode(rsaSigPkcs1Hex)
    if IsErr(sigPkcs1Res):
        return Err[bool](Error(sigPkcs1Res))
    let sigPssRes: Result[Bytes] = hexDecode(rsaSigPssHex)
    if IsErr(sigPssRes):
        return Err[bool](Error(sigPssRes))
    let privDer: Bytes = Value(privDerRes)
    let pubDer: Bytes = Value(pubDerRes)
    let sigPkcs1: Bytes = Value(sigPkcs1Res)
    let sigPss: Bytes = Value(sigPssRes)
    let privRes: Result[RsaBigPrivateKey] = rsaBigPrivateKeyFromBytes(privDer)
    if IsErr(privRes):
        return Err[bool](Error(privRes))
    let pubRes: Result[RsaBigPublicKey] = rsaBigPublicKeyFromBytes(pubDer)
    if IsErr(pubRes):
        return Err[bool](Error(pubRes))
    var pub: RsaBigPublicKey = Value(pubRes)
    if ! rsaVerifyPkcs1(pub, msg, sigPkcs1, false):
        return Err[bool]("rsa: pkcs1 verify failed")
    if ! rsaVerifyPss(pub, msg, sigPss, false):
        return Err[bool]("rsa: pss verify failed")
    if ! rsaVerifyBytes(pubDer, msg, sigPkcs1):
        return Err[bool]("rsa: verify bytes pkcs1 failed")
    if ! rsaVerifyBytes(pubDer, msg, sigPss):
        return Err[bool]("rsa: verify bytes pss failed")
    let signRes: Result[Bytes] = rsaSignBytes(privDer, msg)
    if IsErr(signRes):
        return Err[bool](Error(signRes))
    if ! rsaVerifyPkcs1(pub, msg, Value(signRes), false):
        return Err[bool]("rsa: sign/verify pkcs1 mismatch")
    let msgBad: Bytes = BytesFromString("cheng-rsa-smoke!")
    if rsaVerifyBytes(pubDer, msgBad, sigPkcs1):
        return Err[bool]("rsa: pkcs1 mismatch accepted")
    if rsaVerifyBytes(pubDer, msgBad, sigPss):
        return Err[bool]("rsa: pss mismatch accepted")
    let sigPkcs1Bad: Bytes = BytesSlice(sigPkcs1, 0, BytesLen(sigPkcs1))
    BytesSet(sigPkcs1Bad, 0, BytesGet(sigPkcs1Bad, 0) ^ 1)
    if rsaVerifyPkcs1(pub, msg, sigPkcs1Bad, false):
        return Err[bool]("rsa: pkcs1 tamper accepted")
    let sigPssBad: Bytes = BytesSlice(sigPss, 0, BytesLen(sigPss))
    let lastIdx: int32 = BytesLen(sigPssBad) - 1
    BytesSet(sigPssBad, lastIdx, BytesGet(sigPssBad, lastIdx) ^ 1)
    if rsaVerifyPss(pub, msg, sigPssBad, false):
        return Err[bool]("rsa: pss tamper accepted")
    let sigLong: Bytes = BytesAlloc(BytesLen(sigPkcs1) + 1)
    for i in 0..<BytesLen(sigPkcs1):
        BytesSet(sigLong, 1 + i, BytesGet(sigPkcs1, i))
    if rsaVerifyBytes(pubDer, msg, sigLong):
        return Err[bool]("rsa: long signature accepted")
    return Ok[bool](true)
