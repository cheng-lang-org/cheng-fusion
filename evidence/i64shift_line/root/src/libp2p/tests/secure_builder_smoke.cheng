# Secure builder selection smoke test(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/builders
fn runSecureBuilderSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/2")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let noiseRes: Result[bool] = withSecureCodec(builder, "noise")
    if IsErr(noiseRes):
        return Err[bool](Error(noiseRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    let sw: Switch = Value(swRes)
    if ! sw.upgrader.hasSecure:
        return Err[bool]("secure builder: missing secure manager")
    if (sw.upgrader.secureMgr.codec != "noise"):
        return Err[bool]("secure builder: codec mismatch(noise)")

    var builder2: SwitchBuilder = newSwitchBuilder()
    let addrRes2: Result[bool] = withAddressText(builder2, "/memory/3")
    if IsErr(addrRes2):
        return Err[bool](Error(addrRes2))
    let tlsRes: Result[bool] = withSecureCodec(builder2, "tls")
    if IsErr(tlsRes):
        return Err[bool](Error(tlsRes))
    let swRes2: Result[Switch] = build(builder2)
    if IsErr(swRes2):
        return Err[bool](Error(swRes2))
    let sw2: Switch = Value(swRes2)
    if ! sw2.upgrader.hasSecure:
        return Err[bool]("secure builder: missing secure manager(tls)")
    if (sw2.upgrader.secureMgr.codec != "tls"):
        return Err[bool]("secure builder: codec mismatch(tls)")
    return Ok[bool](true)
