# Crypto KeyType cross-module round-trip smoke.
#
# Regression guard for a compiler-frontend defect (see crypto/types.cheng's
# ktXxxValue() accessor comment for the full root-cause writeup): a real
# Ed25519 keypair generated via the production generateKeyPair() path (whose
# constructors live in ed25519.cheng, a different file from crypto/types.cheng
# where KeyType is declared) used to have its PublicKey/PrivateKey.keyType
# field silently written as ktRSA(0) instead of ktEd25519(1), which made
# validatePublicKey() run RSA-shaped byte-length checks on a genuine 32-byte
# Ed25519 key and reject it -- every single call, deterministically. This
# smoke exercises the exact real (non-test) generateKeyPair() ->
# validatePublicKey() -> encodePublicKey() production chain end-to-end and
# fails loudly if that regresses.
#
# Deliberately avoids `let kp: KeyPair = Value(kpRes)` (an explicit
# struct-typed let initializer) -- that specific pattern trips a separate,
# pre-existing "typed let kind mismatch declared=KeyPair declared_kind=2
# actual_kind=5" compiler defect that already blocks publickey_encode_smoke
# and peerid_build_smoke on an unmodified tree (reproduces before any of this
# slice's changes; out of this slice's scope). `let kp = Value(kpRes)`
# (untyped, inferred) does not hit it.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/crypto
import cheng/libp2p/crypto/ed25519/ed25519
import std/strings

fn main(): int32 =
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        echo("crypto keytype roundtrip smoke failed: keygen: " + Error(kpRes))
        return 1
    let kp = Value(kpRes)
    let pub = kp.publicKey
    let priv = kp.privateKey

    if int32(pub.keyType) != 1:
        echo("crypto keytype roundtrip smoke failed: pub.keyType=" + IntToStr(int32(pub.keyType)) + " want=1(ktEd25519)")
        return 1
    if int32(priv.keyType) != 1:
        echo("crypto keytype roundtrip smoke failed: priv.keyType=" + IntToStr(int32(priv.keyType)) + " want=1(ktEd25519)")
        return 1
    if BytesLen(pub.data) != 32:
        echo("crypto keytype roundtrip smoke failed: pub.data.len=" + IntToStr(BytesLen(pub.data)) + " want=32")
        return 1

    if ! validatePublicKey(pub):
        echo("crypto keytype roundtrip smoke failed: validatePublicKey rejected a real Ed25519 key")
        return 1
    if ! validatePrivateKey(priv):
        echo("crypto keytype roundtrip smoke failed: validatePrivateKey rejected a real Ed25519 key")
        return 1

    let encRes: Result[Bytes] = encodePublicKey(pub)
    if IsErr(encRes):
        echo("crypto keytype roundtrip smoke failed: encodePublicKey: " + Error(encRes))
        return 1
    echo("encodePublicKey ok, len=" + IntToStr(BytesLen(Value(encRes))))
    # NOTE: decodePublicKey()/decodeKeyProto() are deliberately not exercised
    # here -- they route through keyTypeFromId()'s `case id: int64` (id being
    # an int64 protobuf varint), which hits a separate, pre-existing cold
    # backend limitation ("cold case requires int32 scrutinee") that already
    # blocks on an unmodified tree, independent of this slice's fix. Out of
    # scope here; encodePublicKey (used above) does not go through that
    # `case`, only keyTypeId()'s plain `if` chain.

    let msg: Bytes = BytesFromString("cheng crypto keytype roundtrip smoke")
    let sigRes: Result[Signature] = sign(priv, msg)
    if IsErr(sigRes):
        echo("crypto keytype roundtrip smoke failed: sign: " + Error(sigRes))
        return 1
    let sig = Value(sigRes)
    if ! verify(pub, msg, sig):
        echo("crypto keytype roundtrip smoke failed: verify rejected a genuine signature")
        return 1
    if verify(pub, BytesFromString("tampered message"), sig):
        echo("crypto keytype roundtrip smoke failed: verify accepted a tampered message")
        return 1

    echo("crypto keytype roundtrip smoke ok: keyType=" + IntToStr(int32(pub.keyType)) + " pub.len=" + IntToStr(BytesLen(pub.data)))
    return 0
