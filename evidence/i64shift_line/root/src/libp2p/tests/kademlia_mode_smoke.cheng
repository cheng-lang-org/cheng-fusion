# Kademlia mode smoke.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/builders
import cheng/libp2p/networkprofile
import cheng/libp2p/protocols/kademlia/keys
import cheng/libp2p/protocols/kademlia/protobuf
import cheng/libp2p/protocols/kademlia/requests
import cheng/libp2p/protocols/kademlia
import cheng/libp2p/switch

fn buildTier(addrText: str, tier: NodeTier): Result[Switch] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, addrText)
    if IsErr(addrRes):
        return Err[Switch](Error(addrRes))
    withNodeTier(builder, tier)
    return build(builder)

fn runKademliaModeSmoke(): Result[bool] =
    let l3Res: Result[Switch] = buildTier("/memory/320", ntL3Edge)
    if IsErr(l3Res):
        return Err[bool](Error(l3Res))
    var l3: Switch = Value(l3Res)
    let key: Key = BytesFromString("kad-mode-key")
    var rec: KadRecord = initKadRecord()
    rec.hasKey = true
    rec.key = key
    rec.hasValue = true
    rec.value = BytesFromString("kad-mode-value")
    let putErr: Result[KadMessage] = kadPutValueRpc(l3, l3.peerId, key, rec)
    if IsOk(putErr):
        return Err[bool]("kad-mode: L3 client unexpectedly allowed put")
    if ! StrContains(Error(putErr), "forbids"):
        return Err[bool]("kad-mode: L3 put rejection reason mismatch")

    let l2Res: Result[Switch] = buildTier("/memory/321", ntL2Routing)
    if IsErr(l2Res):
        return Err[bool](Error(l2Res))
    var l2: Switch = Value(l2Res)
    let startRes: Result[bool] = start(l2)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let dialRes: Result[Muxer] = dial(l2, l2.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outbound: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(l2)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inbound: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outbound)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inbound)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)

    var putReq: KadMessage = initKadMessage()
    putReq.msgType = kadPutValue
    putReq.hasKey = true
    putReq.key = key
    putReq.hasRecord = true
    putReq.record = rec
    let writeRes: Result[bool] = writeKadMessage(outStream, putReq)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = kademliaHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let replyRes: Result[KadMessage] = readKadMessage(outStream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    if Value(replyRes).msgType != kadPutValue:
        return Err[bool]("kad-mode: L2 server put reply mismatch")
    return Ok[bool](true)

fn main(): int32 =
    let smokeRes: Result[bool] = runKademliaModeSmoke()
    if IsErr(smokeRes):
        echo("kademlia mode smoke failed")
        echo(Error(smokeRes))
        return 1
    echo("kademlia mode smoke ok")
    return 0
