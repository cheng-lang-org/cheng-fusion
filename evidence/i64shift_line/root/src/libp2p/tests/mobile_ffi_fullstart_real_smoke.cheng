# mobile ffi full-start real host smoke (for device matrix).

import cheng/libp2p/mobile_ffi/unimaker_compat_ffi_real_smoke

fn hasToken(text: str, token: str): bool =
    return indexOf(text, token, 0) >= 0

fn main(): int32 =
    NimMain()

    let cfg1: str = "{\"dataDir\":\"/tmp/mobile_ffi_fullstart_real_smoke_a\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4001/quic-v1\"}"
    let cfg2: str = "{\"dataDir\":\"/tmp/mobile_ffi_fullstart_real_smoke_b\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4002/quic-v1\"}"

    let node1: int64 = libp2p_node_init(cfg1)
    if node1 <= 0:
        return 11
    if libp2p_node_start(node1) != 0:
        return 12

    let peer1: str = trimText(libp2p_get_local_peer_id(node1))
    if len(peer1) <= 0:
        return 13

    let listenJson: str = libp2p_get_listen_addresses(node1)
    if len(listenJson) <= 0 || !hasToken(listenJson, "quic-v1"):
        return 14

    let dialableJson: str = libp2p_get_dialable_addresses(node1)
    if len(dialableJson) <= 0 || !hasToken(dialableJson, "/p2p/"):
        return 15

    if !libp2p_set_msquic_settings(node1, "{\"allowDatagram\":true,\"maxDatagram\":1400,\"minimumMtu\":1200,\"maximumMtu\":1400,\"migrationEnabled\":true,\"ecnEnabled\":false}"):
        return 16
    let settingsJson: str = libp2p_get_msquic_settings(node1)
    if len(settingsJson) <= 0 || !hasToken(settingsJson, "maxDatagram"):
        return 17

    if libp2p_node_stop(node1) != 0:
        return 18
    libp2p_node_free(node1)

    let node1Reload: int64 = libp2p_node_init(cfg1)
    if node1Reload <= 0:
        return 19
    if libp2p_node_start(node1Reload) != 0:
        return 20
    let peer1Reload: str = trimText(libp2p_get_local_peer_id(node1Reload))
    if peer1Reload != peer1:
        return 21

    let node2: int64 = libp2p_node_init(cfg2)
    if node2 <= 0:
        return 22
    if libp2p_node_start(node2) != 0:
        return 23
    let peer2: str = trimText(libp2p_get_local_peer_id(node2))
    if len(peer2) <= 0:
        return 24

    let dialable2Json: str = libp2p_get_dialable_addresses(node2)
    let dialable2Values: str[] = parseQuotedValues(dialable2Json)
    if len(dialable2Values) <= 0:
        return 25

    if libp2p_connect_peer(node1Reload, peer2) != 0:
        return 26
    if !libp2p_is_peer_connected(node1Reload, peer2):
        return 27

    if libp2p_connect_multiaddr(node1Reload, dialable2Values[0]) != 0:
        return 28

    if !libp2p_ble_set_enabled(node1Reload, true):
        return 29
    if !libp2p_ble_set_enabled(node2, true):
        return 30
    if !libp2p_ble_probe(node1Reload):
        return 31
    if !libp2p_ble_probe(node2):
        return 32
    let bleStatusJson: str = libp2p_bootstrap_get_status(node1Reload)
    if !hasToken(bleStatusJson, "\"hintCount\":1") || !hasToken(bleStatusJson, "\"bootstrapCount\":1"):
        return 33

    if !libp2p_register_push_token(node2, "push-token-node2"):
        return 34
    if !libp2p_mark_peer_hibernated(node1Reload, peer2):
        return 35
    if !libp2p_notify_push_wakeup(node1Reload, peer2):
        return 36
    if !libp2p_push_to_punch(node1Reload, peer2):
        return 37
    if !libp2p_is_peer_connected(node1Reload, peer2):
        return 38
    let pushStatusJson: str = libp2p_bootstrap_get_status(node1Reload)
    if !hasToken(pushStatusJson, "\"pushQueuedCount\":1") || !hasToken(pushStatusJson, "\"pushWakeupCount\":1"):
        return 39
    if !hasToken(pushStatusJson, "\"pushRecoveredCount\":1") || !hasToken(pushStatusJson, "\"pushFailedCount\":0"):
        return 40
    let eventsJson: str = libp2p_poll_events(node1Reload, 16)
    if !hasToken(eventsJson, "\"topic\":\"push_to_punch.queued\"") || !hasToken(eventsJson, "\"topic\":\"push_to_punch.wakeup\""):
        return 41
    if !hasToken(eventsJson, "\"topic\":\"push_to_punch.recovered\""):
        return 42

    if libp2p_node_stop(node2) != 0:
        return 43
    libp2p_node_free(node2)

    if libp2p_node_stop(node1Reload) != 0:
        return 44
    libp2p_node_free(node1Reload)

    return 0
