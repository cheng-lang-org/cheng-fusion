# AutoNAT protocol smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/switch
import cheng/libp2p/builders
import cheng/libp2p/protocols/connectivity/autonat/types
import cheng/libp2p/protocols/connectivity/autonat/client
import cheng/libp2p/protocols/connectivity/autonat/server
import cheng/libp2p/protocols/connectivity/autonat/service as autonatservice
fn runAutonatSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/41")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    registerProtocol(sw, autonatProtocol())
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    setAutonatConfig(initAutonatConfig())
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openProtocolStream(sw, outboundMux, autonatCodec)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    let addr2Res: Result[MultiAddress] = parseMultiAddress("/memory/42")
    if IsErr(addr2Res):
        return Err[bool](Error(addr2Res))
    var req: AutonatDialRequest = initAutonatDialRequest()
    req.hasPeerId = true
    req.peerId = sw.peerId
    let addRes: Result[bool] = multiAddressListAdd(req.addrs, Value(addr2Res))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    let writeRes: Result[bool] = writeAutonatDialRequest(outStream, req)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = autonatHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let respRes: Result[AutonatDialResponse] = readAutonatDialResponse(outStream, autonatMaxMessage)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: AutonatDialResponse = Value(respRes)
    if resp.status != anOk:
        return Err[bool]("smoke: autonat status ! ok")
    if ! resp.hasAddr:
        return Err[bool]("smoke: autonat missing observed addr")
    return Ok[bool](true)
