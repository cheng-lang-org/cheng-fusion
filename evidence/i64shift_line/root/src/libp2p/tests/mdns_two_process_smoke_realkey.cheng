# Real two-OS-process mDNS discovery smoke -- REAL generateKeyPair() identity
# variant of mdns_two_process_smoke.cheng.
#
# mdns_two_process_smoke.cheng deliberately used a role-derived text identity
# (peerIdFromInlineBytesUnchecked(BytesFromString("cheng-two-proc-" + role)))
# instead of a real Ed25519 keypair, per its file-level NOTE, citing a
# then-believed "importing cheng/libp2p/crypto/rand (or crypto/crypto)
# together with cheng/libp2p/discovery/mdns in the same entry-file closure
# corrupts the mdns module's global state" clash.
#
# That clash hypothesis is FALSE and has been root-caused away. The real,
# 100%-reproducible failure was a compiler-frontend defect entirely inside
# the crypto layer, with zero mdns involvement (isolated with crypto/rand +
# crypto/crypto only, no mdns import at all):
#
#   A function F whose signature (parameter or return type, including
#   transitively through a struct field) references an enum type E declared
#   in a file OTHER than F's own defining file has every bare
#   enum-member-literal reference of E inside F's body silently resolve to
#   ordinal 0, regardless of which member is actually named. Plain field
#   READS of an already-computed value (e.g. a parameter) are NOT affected --
#   only the symbolic literal lookup is broken, not value propagation through
#   calls/params.
#
#   cheng/libp2p/crypto/ed25519/ed25519.cheng's generateKeyPair() (and its
#   sibling constructors) all return KeyType-carrying PublicKey/PrivateKey/
#   KeyPair structs (KeyType declared in crypto/types.cheng, a different
#   file) and internally wrote `key.keyType = ktEd25519` -- so that literal
#   silently became ktRSA(0) right there at construction. Downstream,
#   crypto/crypto.cheng's own validatePublicKey() (also a foreign file
#   relative to types.cheng) compared `key.keyType == ktRSA`, whose OWN
#   `ktRSA` literal reference *also* resolved to 0 -- coincidentally matching
#   the corrupted stored value -- so a genuine 32-byte Ed25519 key was run
#   through RSA-shaped byte-length validation and rejected as
#   "crypto: invalid public key" on every single call, deterministically.
#
#   A second, independent, already-tracked compiler defect compounded this:
#   unqualified (no-module-prefix) references to a cross-module `const`
#   (e.g. ed25519PublicKeySize, declared in ed25519/constants.cheng, used
#   bare in both ed25519.cheng and crypto.cheng) silently read 0 instead of
#   the declared value in some expression positions (see project memory
#   cheng-const-crossmodule-miscompile.md -- a known, wave8/9-tracked defect
#   whose fix does not yet cover this exact conditional-comparison position).
#
# Library-layer workaround shipped alongside this file (crypto/types.cheng,
# crypto/crypto.cheng, crypto/ed25519/ed25519.cheng): every bare `ktXxx`
# enum-literal reference outside types.cheng was replaced with a call to a
# `ktXxxValue()` accessor function *defined inside types.cheng itself* (safe,
# since referencing a literal from within its own declaring file is
# unaffected), and every bare cross-module ed25519*Size const reference was
# qualified with its import alias (`ed25519constants.ed25519PublicKeySize`),
# which this compiler defect also does not corrupt. Both fixes were verified
# against isolated minimal repros before being applied here. A true
# compiler-frontend fix for the enum-literal binding rule above is a
# separate, tracked follow-up -- this is a deliberate, verified library
# rearrangement, not a heuristic patch.
#
# What THIS variant still does NOT use: peerIdFromPublicKey() /
# peerIdMatchesPublicKey() (peerid.cheng), because those two call
# multihash.Digest()+multihash.EncodeMultihash() across the multihash.cheng
# module boundary, which peerIdFromInlineBytesUnchecked's own file-level
# comment already documents as a separate, pre-existing, still-open
# constructor-pair miscompile ("the current stage3 seed miscompiles that
# struct-constructor pair when called across [a module boundary]") -- out of
# scope for this crypto-enum/const slice. This variant instead feeds the
# REAL 32-byte Ed25519 public key bytes from a REAL generateKeyPair() call
# into the same peerIdFromInlineBytesUnchecked() hand-rolled-safe helper the
# original smoke already used for its role-derived text, so the two
# processes now advertise genuinely distinct, cryptographically-generated
# identities instead of hardcoded role strings, while still not tripping the
# separate multihash bug.
#
# Usage: identical to mdns_two_process_smoke.cheng -- two processes, same
# host, each with ROLE=A / ROLE=B, optional MDNS_TWO_PROC_NS /
# MDNS_TWO_PROC_DEADLINE_MS. Exit 0 iff this process observed a peer attrs
# entry whose PeerId differs from its own (a REAL keypair-derived id, not the
# role string) within the deadline.

import cheng/libp2p/utils/result
import cheng/libp2p/discovery/mdns
import cheng/libp2p/multiaddress
import std/times
import cheng/libp2p/crypto/crypto
import cheng/libp2p/crypto/ed25519/ed25519
import cheng/libp2p/peerid
import std/parseutils
import std/strings

const
    twoProcDefaultNamespace = "cheng-two-proc-lab-realkey"
    roleEnv = "ROLE"
    nsEnv = "MDNS_TWO_PROC_NS"
    deadlineMsEnv = "MDNS_TWO_PROC_DEADLINE_MS"
    defaultDeadlineMs = 4000

@importc("getenv")
fn twoProcGetEnv(name: cstring): cstring

fn cstrToStr(v: cstring): str =
    if v == nil:
        return ""
    return strFromCStringBorrow(v)

fn envOr(name: str, fallback: str): str =
    let raw: str = cstrToStr(twoProcGetEnv(name))
    if len(raw) <= 0:
        return fallback
    return raw

fn envIntOr(name: str, fallback: int32): int32 =
    let raw: str = cstrToStr(twoProcGetEnv(name))
    if len(raw) <= 0:
        return fallback
    var parsed: int32
    if parseInt32(raw, parsed) <= 0:
        return fallback
    return parsed

fn runTwoProcessSmokeRealKey(): Result[bool] =
    let role: str = envOr(roleEnv, "")
    if role != "A" && role != "B":
        return Err[bool]("mdns two-process smoke(realkey): ROLE env must be A or B (got '" + role + "')")
    let namespace: str = envOr(nsEnv, twoProcDefaultNamespace)
    let deadlineMs: int32 = envIntOr(deadlineMsEnv, defaultDeadlineMs)
    let selfPort: str = if role == "A": "41501" else: "41502"

    setMdnsConfig(initMdnsConfig())

    # Real identity: a fresh Ed25519 keypair generated from real entropy at
    # process start (not derived from the ROLE string at all). Two
    # independent process launches get cryptographically-distinct keys, so
    # A and B are genuinely different peers by construction, same as any
    # real libp2p node.
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        return Err[bool]("mdns two-process smoke(realkey): keygen failed: " + Error(kpRes))
    let pub = Value(kpRes).publicKey
    if ! validatePublicKey(pub):
        return Err[bool]("mdns two-process smoke(realkey): generated public key failed validation")
    let selfPeer = peerIdFromInlineBytesUnchecked(pub.data)
    let selfAddrText: str = "/ip4/127.0.0.1/udp/" + selfPort + "/quic-v1"
    let selfAddrRes: Result[MultiAddress] = parseMultiAddress(selfAddrText)
    if IsErr(selfAddrRes):
        return Err[bool](Error(selfAddrRes))

    var selfAttrs = initPeerAttributes()
    let addPeerRes: Result[bool] = peerAttributesAddPeerId(selfAttrs, selfPeer)
    if IsErr(addPeerRes):
        return Err[bool](Error(addPeerRes))
    let addAddrRes: Result[bool] = peerAttributesAddAddress(selfAttrs, Value(selfAddrRes))
    if IsErr(addAddrRes):
        return Err[bool](Error(addAddrRes))
    let addNsRes: Result[bool] = peerAttributesAddNamespace(selfAttrs, namespace)
    if IsErr(addNsRes):
        return Err[bool](Error(addNsRes))

    echo("mdns two-proc smoke(realkey): role=" + role + " keyType=" + IntToStr(int32(pub.keyType)) + " peer=" + toString(selfPeer))

    let advRes: Result[bool] = mdnsAdvertise(selfAttrs)
    if IsErr(advRes):
        return Err[bool](Error(advRes))

    var query = initPeerAttributes()
    let addQueryNsRes: Result[bool] = peerAttributesAddNamespace(query, namespace)
    if IsErr(addQueryNsRes):
        return Err[bool](Error(addQueryNsRes))

    var out = initPeerAttributesList()
    let deadline: int64 = EpochTimeNs() + int64(deadlineMs) * 1000000
    while EpochTimeNs() < deadline: # cheng-syntax-policy: allow-counting-while
        out.count = 0
        let discRes: Result[bool] = mdnsDiscover(query, out)
        if IsErr(discRes):
            continue
        for i in 0..<out.count:
            var pid = selfPeer
            let item = out.items[i]
            if peerAttributesGetPeerId(item, pid):
                let eqRes: Result[bool] = peerIdEqual(pid, selfPeer)
                if IsOk(eqRes) && !(Value(eqRes)):
                    echo("mdns two-proc smoke(realkey): role=" + role + " discovered peer=" + toString(pid))
                    return Ok[bool](true)
        let readvRes: Result[bool] = mdnsAdvertise(selfAttrs)
        if IsErr(readvRes):
            return Err[bool](Error(readvRes))
    return Err[bool]("mdns two-proc smoke(realkey): role=" + role + " timed out with no foreign peer discovered")

fn main(): int32 =
    let res: Result[bool] = runTwoProcessSmokeRealKey()
    if IsErr(res):
        echo("mdns two-process smoke(realkey) failed: " + Error(res))
        return 1
    echo("mdns two-process smoke(realkey) ok")
    return 0
