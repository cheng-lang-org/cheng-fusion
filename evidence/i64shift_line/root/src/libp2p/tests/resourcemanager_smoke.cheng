# Resource manager smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/resourcemanager
fn runResourceManagerSmoke(): Result[bool] =
    var limits: ResourceLimits = initResourceLimits()
    limits.maxConns = 2
    limits.maxInboundConns = 1
    limits.maxOutboundConns = 1
    limits.maxStreams = 2
    limits.maxInboundStreams = 1
    limits.maxOutboundStreams = 1
    limits.maxMemoryBytes = 32
    limits.maxInboundBytes = 10
    limits.maxOutboundBytes = 10
    setResourceLimits(limits)
    resetResourceStats()

    let inConnRes: Result[bool] = reserveConnection(resourceDirInbound)
    if IsErr(inConnRes):
        return Err[bool](Error(inConnRes))
    let outConnRes: Result[bool] = reserveConnection(resourceDirOutbound)
    if IsErr(outConnRes):
        return Err[bool](Error(outConnRes))
    let overConnRes: Result[bool] = reserveConnection(resourceDirOutbound)
    if IsOk(overConnRes):
        return Err[bool]("smoke: connection limit ! enforced")
    if resourceTotalConnections() != 2:
        return Err[bool]("smoke: connection count mismatch")
    let relInRes: Result[bool] = releaseConnection(resourceDirInbound)
    if IsErr(relInRes):
        return Err[bool](Error(relInRes))
    let relOutRes: Result[bool] = releaseConnection(resourceDirOutbound)
    if IsErr(relOutRes):
        return Err[bool](Error(relOutRes))
    if resourceTotalConnections() != 0:
        return Err[bool]("smoke: connection release mismatch")

    let inStreamRes: Result[bool] = reserveStream(resourceDirInbound)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    let outStreamRes: Result[bool] = reserveStream(resourceDirOutbound)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    let overStreamRes: Result[bool] = reserveStream(resourceDirInbound)
    if IsOk(overStreamRes):
        return Err[bool]("smoke: stream limit ! enforced")
    if resourceTotalStreams() != 2:
        return Err[bool]("smoke: stream count mismatch")
    let relInStreamRes: Result[bool] = releaseStream(resourceDirInbound)
    if IsErr(relInStreamRes):
        return Err[bool](Error(relInStreamRes))
    let relOutStreamRes: Result[bool] = releaseStream(resourceDirOutbound)
    if IsErr(relOutStreamRes):
        return Err[bool](Error(relOutStreamRes))
    if resourceTotalStreams() != 0:
        return Err[bool]("smoke: stream release mismatch")

    let memRes: Result[bool] = resourceReserveMemoryBytes(16)
    if IsErr(memRes):
        return Err[bool](Error(memRes))
    let memOverRes: Result[bool] = resourceReserveMemoryBytes(20)
    if IsOk(memOverRes):
        return Err[bool]("smoke: memory limit ! enforced")
    let memReleaseRes: Result[bool] = resourceReleaseMemoryBytes(16)
    if IsErr(memReleaseRes):
        return Err[bool](Error(memReleaseRes))

    let bwInRes: Result[bool] = resourceRecordInboundBytes(5)
    if IsErr(bwInRes):
        return Err[bool](Error(bwInRes))
    let bwOutRes: Result[bool] = resourceRecordOutboundBytes(6)
    if IsErr(bwOutRes):
        return Err[bool](Error(bwOutRes))
    let bwOverRes: Result[bool] = resourceRecordInboundBytes(6)
    if IsOk(bwOverRes):
        return Err[bool]("smoke: bandwidth limit ! enforced")

    var disabled: ResourceLimits = initResourceLimits()
    disabled.enabled = false
    setResourceLimits(disabled)
    resetResourceStats()
    let relDisabledConn: Result[bool] = releaseConnection(resourceDirInbound)
    if IsErr(relDisabledConn):
        return Err[bool]("smoke: disabled connection release failed")
    let relDisabledStream: Result[bool] = releaseStream(resourceDirOutbound)
    if IsErr(relDisabledStream):
        return Err[bool]("smoke: disabled stream release failed")
    if resourceTotalConnections() != 0:
        return Err[bool]("smoke: disabled connection count changed")
    if resourceTotalStreams() != 0:
        return Err[bool]("smoke: disabled stream count changed")

    return Ok[bool](true)
