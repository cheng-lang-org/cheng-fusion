# Relay policy smoke.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/builders
import cheng/libp2p/networkprofile
import cheng/libp2p/protocols/connectivity/relay/utils
import cheng/libp2p/switch

fn runRelayPolicySmoke(): Result[bool] =
    var l1Builder: SwitchBuilder = newSwitchBuilder()
    let l1AddrRes: Result[bool] = withAddressText(l1Builder, "/memory/340")
    if IsErr(l1AddrRes):
        return Err[bool](Error(l1AddrRes))
    withNodeTier(l1Builder, ntL1Core)
    let l1Res: Result[Switch] = build(l1Builder)
    if IsErr(l1Res):
        return Err[bool](Error(l1Res))
    let l1: Switch = Value(l1Res)
    let l1Proto: str = supportedProtocols(l1)
    if ! StrContains(l1Proto, relayCodec):
        return Err[bool]("relay-policy: L1 should register relay server")
    let cfg: RelayConfig = getRelayConfig()
    if cfg.minTtlSeconds != 30 || cfg.maxTtlSeconds != 3600 || cfg.defaultTtlSeconds != 120:
        return Err[bool]("relay-policy: L1 relay ttl profile mismatch")
    if cfg.maxReservations != 400:
        return Err[bool]("relay-policy: L1 relay maxReservations mismatch")

    var l3Builder: SwitchBuilder = newSwitchBuilder()
    let l3AddrRes: Result[bool] = withAddressText(l3Builder, "/memory/341")
    if IsErr(l3AddrRes):
        return Err[bool](Error(l3AddrRes))
    withNodeTier(l3Builder, ntL3Edge)
    let l3Res: Result[Switch] = build(l3Builder)
    if IsErr(l3Res):
        return Err[bool](Error(l3Res))
    let l3: Switch = Value(l3Res)
    let l3Proto: str = supportedProtocols(l3)
    if StrContains(l3Proto, relayCodec):
        return Err[bool]("relay-policy: L3 should disable relay server")
    return Ok[bool](true)

fn main(): int32 =
    let smokeRes: Result[bool] = runRelayPolicySmoke()
    if IsErr(smokeRes):
        echo("relay policy smoke failed")
        echo(Error(smokeRes))
        return 1
    echo("relay policy smoke ok")
    return 0
