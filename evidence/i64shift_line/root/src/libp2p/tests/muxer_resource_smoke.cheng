# Muxer resource accounting smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/resourcemanager
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
fn runMuxerResourceSmoke(): Result[bool] =
    setResourceLimits(initResourceLimits())
    resetResourceStats()
    if resourceOutboundStreams() != 0:
        return Err[bool]("smoke: muxer outbound baseline ! zero")
    let pairRes: Result[ConnectionPair] = newConnectionPair(emptyMultiAddress(), emptyMultiAddress(), emptyMultiAddress(), emptyMultiAddress())
    if IsErr(pairRes):
        return Err[bool](Error(pairRes))
    let pair: ConnectionPair = Value(pairRes)
    let mplexOutRes: Result[Muxer] = newMuxerWithKind(pair.outbound, muxerKindMplex)
    if IsErr(mplexOutRes):
        return Err[bool](Error(mplexOutRes))
    let mplexInRes: Result[Muxer] = newMuxerWithKind(pair.inbound, muxerKindMplex)
    if IsErr(mplexInRes):
        return Err[bool](Error(mplexInRes))
    var mplexOut: Muxer = Value(mplexOutRes)
    var mplexIn: Muxer = Value(mplexInRes)
    let openMplexRes: Result[Stream] = openStream(mplexOut)
    if IsErr(openMplexRes):
        return Err[bool](Error(openMplexRes))
    if resourceOutboundStreams() != 1:
        return Err[bool]("smoke: mplex outbound reservation missing")
    let acceptMplexRes: Result[Stream] = acceptStream(mplexIn)
    if IsErr(acceptMplexRes):
        return Err[bool](Error(acceptMplexRes))
    if resourceInboundStreams() != 1:
        return Err[bool]("smoke: mplex inbound reservation missing")
    closeMuxer(mplexOut)
    closeMuxer(mplexIn)
    if resourceOutboundStreams() != 0:
        return Err[bool]("smoke: mplex outbound reservation ! released")
    if resourceInboundStreams() != 0:
        return Err[bool]("smoke: mplex inbound reservation ! released")
    let pairRes2: Result[ConnectionPair] = newConnectionPair(emptyMultiAddress(), emptyMultiAddress(), emptyMultiAddress(), emptyMultiAddress())
    if IsErr(pairRes2):
        return Err[bool](Error(pairRes2))
    let pair2: ConnectionPair = Value(pairRes2)
    let yamuxOutRes: Result[Muxer] = newMuxerWithKind(pair2.outbound, muxerKindYamux)
    if IsErr(yamuxOutRes):
        return Err[bool](Error(yamuxOutRes))
    let yamuxInRes: Result[Muxer] = newMuxerWithKind(pair2.inbound, muxerKindYamux)
    if IsErr(yamuxInRes):
        return Err[bool](Error(yamuxInRes))
    var yamuxOut: Muxer = Value(yamuxOutRes)
    var yamuxIn: Muxer = Value(yamuxInRes)
    let openYamuxRes: Result[Stream] = openStream(yamuxOut)
    if IsErr(openYamuxRes):
        return Err[bool](Error(openYamuxRes))
    if resourceOutboundStreams() != 1:
        return Err[bool]("smoke: yamux outbound reservation missing")
    let acceptYamuxRes: Result[Stream] = acceptStream(yamuxIn)
    if IsErr(acceptYamuxRes):
        return Err[bool](Error(acceptYamuxRes))
    if resourceInboundStreams() != 1:
        return Err[bool]("smoke: yamux inbound reservation missing")
    closeMuxer(yamuxOut)
    closeMuxer(yamuxIn)
    if resourceOutboundStreams() != 0:
        return Err[bool]("smoke: yamux outbound reservation ! released")
    if resourceInboundStreams() != 0:
        return Err[bool]("smoke: yamux inbound reservation ! released")
    return Ok[bool](true)
