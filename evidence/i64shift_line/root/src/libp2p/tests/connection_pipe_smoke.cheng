# Connection pipe smoke test(newConnectionPair + write/read).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection

fn runConnectionPipeSmoke(): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/0")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    let pairRes: Result[ConnectionPair] = newConnectionPair(addr, addr, addr, addr)
    if IsErr(pairRes):
        return Err[bool](Error(pairRes))
    var outbound: Connection = Value(pairRes).outbound
    var inbound: Connection = Value(pairRes).inbound

    let payload: Bytes = BytesFromString("hi")
    let writeRes: Result[int32] = write(outbound, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let readRes: Result[Bytes] = read(inbound, BytesLen(payload))
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if ! BytesEqual(Value(readRes), payload):
        return Err[bool]("smoke: payload mismatch")

    close(outbound)
    close(inbound)
    return Ok[bool](true)
