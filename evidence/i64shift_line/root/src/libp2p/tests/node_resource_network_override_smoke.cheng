# NodeResource networkType runtime override smoke.

import cheng/libp2p/protocols/noderesource/noderesource
import cheng/libp2p/protocols/noderesource/protobuf

fn main(): int32 =
    nodeResourceResetOverrides()
    nodeResourceSetNetworkTypeOverride("wifi")
    let wifiInfo: NodeResourceInfo = collectNodeResourceInfo()
    if wifiInfo.networkType != "wifi":
        echo("node_resource_network_override_smoke failed: wifi override mismatch")
        return 1
    nodeResourceSetNetworkTypeOverride("bad-value")
    let unknownInfo: NodeResourceInfo = collectNodeResourceInfo()
    if unknownInfo.networkType != "unknown":
        echo("node_resource_network_override_smoke failed: invalid fallback mismatch")
        return 1
    echo("node_resource_network_override_smoke ok")
    return 0
