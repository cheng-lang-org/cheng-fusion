# Mobile BLE discovery smoke runner.

import cheng/libp2p/mobile_ffi/unimaker_compat_ffi_real_smoke

fn hasToken(text: str, token: str): bool =
    return indexOf(text, token, 0) >= 0

fn runMobileBleDiscoverySmoke(): int32 =
    NimMain()

    let cfgA: str = "{\"dataDir\":\"/tmp/mobile_ble_discovery_a\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4301/quic-v1\"}"
    let cfgB: str = "{\"dataDir\":\"/tmp/mobile_ble_discovery_b\",\"listenAddr\":\"/ip4/0.0.0.0/udp/4302/quic-v1\"}"

    let nodeA: int64 = libp2p_node_init(cfgA)
    if nodeA <= 0:
        return 11
    let nodeB: int64 = libp2p_node_init(cfgB)
    if nodeB <= 0:
        return 12

    if libp2p_node_start(nodeA) != 0:
        return 13
    if libp2p_node_start(nodeB) != 0:
        return 14

    let peerB: str = trimText(libp2p_get_local_peer_id(nodeB))
    if len(peerB) <= 0:
        return 15

    if !libp2p_ble_set_enabled(nodeA, true):
        return 16
    if !libp2p_ble_set_enabled(nodeB, true):
        return 17
    if !libp2p_ble_probe(nodeA):
        return 18
    if !libp2p_ble_probe(nodeB):
        return 19
    let bleStatusA: str = libp2p_bootstrap_get_status(nodeA)
    if !hasToken(bleStatusA, "\"hintCount\":1") || !hasToken(bleStatusA, "\"bootstrapCount\":1"):
        return 20
    let bleEventsA: str = libp2p_poll_events(nodeA, 8)
    if !hasToken(bleEventsA, "\"topic\":\"ble.discovery.updated\"") || !hasToken(bleEventsA, peerB):
        return 21

    if libp2p_connect_peer(nodeA, peerB) != 0:
        return 22
    if !libp2p_is_peer_connected(nodeA, peerB):
        return 23

    if libp2p_node_stop(nodeB) != 0:
        return 24
    libp2p_node_free(nodeB)
    if libp2p_node_stop(nodeA) != 0:
        return 25
    libp2p_node_free(nodeA)
    return 0

fn main(): int32 =
    return runMobileBleDiscoverySmoke()
