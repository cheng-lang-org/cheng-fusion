# DePIN orderbook verify runner (runtime-safe subset).
# Marker for verify contract gate: runDepinOrderbookSmoke

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/depin/orderbook
import cheng/libp2p/tests/depin_orderbook_smoke

fn main(): int32 =
    let smokeRes: Result[bool] = runDepinOrderbookSmoke()
    if IsErr(smokeRes):
        return 1
    if depinOrderbookTopicName() != "cheng/depin/orderbook/v1":
        return 2
    if depinOrderbookAskCardSchema() != "cheng-depin-ask-card/v1":
        return 3
    return 0
