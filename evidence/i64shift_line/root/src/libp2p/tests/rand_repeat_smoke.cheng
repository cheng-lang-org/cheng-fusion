# RNG repeatability smoke(should differ across calls).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/rand

fn main(): int32 =
    let aRes: Result[Bytes] = randomBytes(32)
    if IsErr(aRes):
        echo("rand repeat smoke failed: " + Error(aRes))
        return 1
    let bRes: Result[Bytes] = randomBytes(32)
    if IsErr(bRes):
        echo("rand repeat smoke failed: " + Error(bRes))
        return 1
    let a: Bytes = Value(aRes)
    let b: Bytes = Value(bRes)
    echo("a.len=" + $(BytesLen(a)) + " a=" + BytesToHex(a))
    echo("b.len=" + $(BytesLen(b)) + " b=" + BytesToHex(b))
    echo("equal=" + $(BytesEqual(a, b)))
    if BytesEqual(a, b):
        return 2
    return 0

