# Mobile LAN full-stack gate runner:
# mDNS LAN discovery -> QUIC direct + DM + video call + synccast livestream -> migration -> publish/home index.

import cheng/libp2p/utils/result
import cheng/libp2p/tests/mdns_lan_two_node_smoke
import cheng/libp2p/tests/synccast_closedloop_runner
import cheng/libp2p/tests/publish_homepage_smoke

fn runMobileLanFullstackGate(): Result[bool] =
    let lanRes: Result[bool] = runLanMdnsTwoNodeSmoke()
    if IsErr(lanRes):
        return Err[bool]("mobile-fullstack: mdns-lan: " + Error(lanRes))

    let closedloopRes: Result[bool] = runSynccastClosedLoop()
    if IsErr(closedloopRes):
        return Err[bool]("mobile-fullstack: synccast-closedloop: " + Error(closedloopRes))

    let publishHomeRes: Result[bool] = runPublishHomepageSmoke()
    if IsErr(publishHomeRes):
        return Err[bool]("mobile-fullstack: publish-homepage: " + Error(publishHomeRes))

    return Ok[bool](true)

fn main(): int32 =
    let runRes: Result[bool] = runMobileLanFullstackGate()
    if IsErr(runRes):
        echo("mobile lan fullstack gate failed")
        echo(Error(runRes))
        return 1
    echo("mobile lan fullstack gate ok")
    return 0
