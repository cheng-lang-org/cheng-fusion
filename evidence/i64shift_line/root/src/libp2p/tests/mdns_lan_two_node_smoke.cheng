# Manual mDNS LAN two-node smoke (real network discovery enabled).

import cheng/libp2p/utils/result
import cheng/libp2p/crypto/crypto
import cheng/libp2p/crypto/rand
import cheng/libp2p/discovery/mdns
import cheng/libp2p/discovery/discoverymngr
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/utils/strings

const
    lanServiceName = "_cheng-lan._udp.local"
    lanService = "mdns-lan-lab"
    lanNamespace = "cheng-lan-lab"
    nodeADefaultPort = "41234"
    nodeBDefaultPort = "41235"
    lanIpEnv = "MDNS_LAN_IP"
    lanDefaultHost = "127.0.0.1"

@ importc("getenv")
fn mdnsGetEnv(name: cstring): cstring

fn cstrToStr(v: cstring): str =
    if v == nil:
        return ""
    return v

fn hasPrefix(text: str, prefix: str): bool =
    if len(prefix) <= 0 || len(text) < len(prefix):
        return false
    for i in 0..<len(prefix):
        if text[i] != prefix[i]:
            return false
    return true

fn isUsableLanIp(ip: str): bool =
    if len(ip) <= 0:
        return false
    if ip == "127.0.0.1":
        return false
    if hasPrefix(ip, "127."):
        return false
    if hasPrefix(ip, "169.254."):
        return false
    return true

fn mdnsLanIpFromEnv(): str =
    let raw: str = cstrToStr(mdnsGetEnv(lanIpEnv))
    if isUsableLanIp(raw):
        return raw
    return lanDefaultHost

fn buildListenAddr(host: str, port: str): str =
    return "/ip4/" + host + "/udp/" + port + "/quic-v1"

fn listContainsPeer(list: PeerAttributesList, peer: PeerId): bool =
    for i in 0..<list.count:
        var pid: PeerId
        if peerAttributesGetPeerId(list.items[i], pid):
            let eqRes: Result[bool] = peerIdEqual(pid, peer)
            if IsOk(eqRes) && Value(eqRes):
                return true
    return false

fn runLanMdnsTwoNodeSmoke(): Result[bool] =
    let host: str = mdnsLanIpFromEnv()
    var cfg: MdnsConfig = initMdnsConfig()
    cfg.enableNetwork = true
    cfg.bindPort = 5353
    cfg.bindIp = host
    cfg.queryTimeoutMs = 300
    cfg.serviceName = lanServiceName
    cfg.namespace = lanNamespace
    setMdnsConfig(cfg)
    setMdnsState(initMdnsState())

    setRandomSeed(BytesFromString("cheng-mdns-lan-smoke"))

    let kpARes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpARes):
        return Err[bool](Error(kpARes))
    let kpBRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpBRes):
        return Err[bool](Error(kpBRes))

    let kpA: KeyPair = Value(kpARes)
    let kpB: KeyPair = Value(kpBRes)
    let peerARes: Result[PeerId] = peerIdFromPrivateKey(kpA.privateKey)
    if IsErr(peerARes):
        return Err[bool](Error(peerARes))
    let peerBRes: Result[PeerId] = peerIdFromPrivateKey(kpB.privateKey)
    if IsErr(peerBRes):
        return Err[bool](Error(peerBRes))
    let peerA: PeerId = Value(peerARes)
    let peerB: PeerId = Value(peerBRes)
    let addrAText: str = buildListenAddr(host, nodeADefaultPort)
    let addrBText: str = buildListenAddr(host, nodeBDefaultPort)
    if host != lanDefaultHost:
        echo("mdns lan smoke: use MDNS_LAN_IP=" + host)
    else:
        echo("mdns lan smoke: MDNS_LAN_IP not set/invalid, fallback to " + host)

    let addrARes: Result[MultiAddress] = parseMultiAddress(addrAText)
    if IsErr(addrARes):
        return Err[bool](Error(addrARes))
    let addrBRes: Result[MultiAddress] = parseMultiAddress(addrBText)
    if IsErr(addrBRes):
        return Err[bool](Error(addrBRes))

    var attrsA: PeerAttributes = initPeerAttributes()
    let addPeerARes: Result[bool] = peerAttributesAddPeerId(attrsA, peerA)
    if IsErr(addPeerARes):
        return Err[bool](Error(addPeerARes))
    let addAddrARes: Result[bool] = peerAttributesAddAddress(attrsA, Value(addrARes))
    if IsErr(addAddrARes):
        return Err[bool](Error(addAddrARes))
    let addSvcARes: Result[bool] = peerAttributesAddService(attrsA, lanService)
    if IsErr(addSvcARes):
        return Err[bool](Error(addSvcARes))
    let addNsARes: Result[bool] = peerAttributesAddNamespace(attrsA, lanNamespace)
    if IsErr(addNsARes):
        return Err[bool](Error(addNsARes))

    var attrsB: PeerAttributes = initPeerAttributes()
    let addPeerBRes: Result[bool] = peerAttributesAddPeerId(attrsB, peerB)
    if IsErr(addPeerBRes):
        return Err[bool](Error(addPeerBRes))
    let addAddrBRes: Result[bool] = peerAttributesAddAddress(attrsB, Value(addrBRes))
    if IsErr(addAddrBRes):
        return Err[bool](Error(addAddrBRes))
    let addSvcBRes: Result[bool] = peerAttributesAddService(attrsB, lanService)
    if IsErr(addSvcBRes):
        return Err[bool](Error(addSvcBRes))
    let addNsBRes: Result[bool] = peerAttributesAddNamespace(attrsB, lanNamespace)
    if IsErr(addNsBRes):
        return Err[bool](Error(addNsBRes))

    let advARes: Result[bool] = mdnsAdvertise(attrsA)
    if IsErr(advARes):
        return Err[bool](Error(advARes))
    let advBRes: Result[bool] = mdnsAdvertise(attrsB)
    if IsErr(advBRes):
        return Err[bool](Error(advBRes))

    var query: PeerAttributes = initPeerAttributes()
    let addQuerySvcRes: Result[bool] = peerAttributesAddService(query, lanService)
    if IsErr(addQuerySvcRes):
        return Err[bool](Error(addQuerySvcRes))
    let addQueryNsRes: Result[bool] = peerAttributesAddNamespace(query, lanNamespace)
    if IsErr(addQueryNsRes):
        return Err[bool](Error(addQueryNsRes))

    var out: PeerAttributesList = initPeerAttributesList()
    let discRes: Result[bool] = mdnsDiscover(query, out)
    if IsErr(discRes):
        return Err[bool](Error(discRes))
    if out.count < 2:
        return Err[bool]("mdns lan smoke: expected both nodes in discovery list")
    if !listContainsPeer(out, peerA):
        return Err[bool]("mdns lan smoke: missing node A in discovery")
    if !listContainsPeer(out, peerB):
        return Err[bool]("mdns lan smoke: missing node B in discovery")
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runLanMdnsTwoNodeSmoke()
    if IsErr(res):
        echo("mdns lan two-node smoke failed: " + Error(res))
        return 1
    echo("mdns lan two-node smoke ok")
    return 0
