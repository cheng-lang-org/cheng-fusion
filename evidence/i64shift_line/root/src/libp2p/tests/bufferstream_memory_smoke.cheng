# BufferStream memory accounting smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/resourcemanager
import cheng/libp2p/memorymanager
import cheng/libp2p/stream/bufferstream
fn runBufferStreamMemorySmoke(): Result[bool] =
    setResourceLimits(initResourceLimits())
    resetMemoryStats()
    var s: BufferStream = newBufferStream()
    let payload: Bytes = BytesFromString("hello")
    let writeRes: Result[int32] = write(s, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if memoryUsed() != 5:
        return Err[bool]("smoke: bufferstream memory used mismatch after write")
    let readRes: Result[Bytes] = read(s, 2)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if BytesLen(Value(readRes)) != 2:
        return Err[bool]("smoke: bufferstream read size mismatch")
    if memoryUsed() != 3:
        return Err[bool]("smoke: bufferstream memory used mismatch after read")
    closeBufferStream(s)
    if memoryUsed() != 0:
        return Err[bool]("smoke: bufferstream memory used mismatch after close")
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runBufferStreamMemorySmoke()
    if IsErr(res):
        echo("bufferstream memory smoke failed: " + Error(res))
        return 1
    echo("bufferstream memory smoke ok")
    return 0
