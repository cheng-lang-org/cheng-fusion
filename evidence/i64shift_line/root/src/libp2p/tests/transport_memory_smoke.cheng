# Transport memory manager smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/transports/tcptransport
import cheng/libp2p/transports/wstransport
import cheng/libp2p/transports/webrtcdirecttransport
import cheng/libp2p/transports/webrtcstartransport
import cheng/libp2p/transports/tortransport
import cheng/quic/msquictransport
import cheng/libp2p/transports/memorymanager
fn runTransportMemorySmoke(): Result[bool] =
    var cfg: TransportMemoryConfig = initTransportMemoryConfig()
    cfg.enabled = true
    cfg.limitBytes = 0
    setTransportMemoryConfig(cfg)
    resetTransportMemoryStats()
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/1")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    var t: MemoryTransport = initMemoryTransport()
    start(t, addr)
    let dialRes: Result[Connection] = dial(t, addr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outbound: Connection = Value(dialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: transport memory ! reserved")
    let acceptRes: Result[Connection] = accept(t)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: transport memory ! released")
    close(outbound)
    stop(t)
    resetTransportMemoryStats()
    start(t, addr)
    let dialRes2: Result[Connection] = dial(t, addr)
    if IsErr(dialRes2):
        return Err[bool](Error(dialRes2))
    var outbound2: Connection = Value(dialRes2)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: transport memory ! reserved before stop")
    stop(t)
    close(outbound2)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: transport memory ! released on stop")
    resetTransportMemoryStats()

    let tcpAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4001")
    if IsErr(tcpAddrRes):
        return Err[bool](Error(tcpAddrRes))
    let tcpAddr: MultiAddress = Value(tcpAddrRes)
    var tcp: TcpTransport = initTcpTransport()
    start(tcp, tcpAddr)
    let tcpDialRes: Result[Connection] = dial(tcp, tcpAddr)
    if IsErr(tcpDialRes):
        return Err[bool](Error(tcpDialRes))
    var tcpOut: Connection = Value(tcpDialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: tcp transport memory ! reserved")
    stop(tcp)
    close(tcpOut)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: tcp transport memory ! released on stop")
    resetTransportMemoryStats()

    let wsAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4002/ws")
    if IsErr(wsAddrRes):
        return Err[bool](Error(wsAddrRes))
    let wsAddr: MultiAddress = Value(wsAddrRes)
    var ws: WsTransport = initWsTransport()
    start(ws, wsAddr)
    let wsDialRes: Result[Connection] = dial(ws, wsAddr)
    if IsErr(wsDialRes):
        return Err[bool](Error(wsDialRes))
    var wsOut: Connection = Value(wsDialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: ws transport memory ! reserved")
    stop(ws)
    close(wsOut)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: ws transport memory ! released on stop")
    resetTransportMemoryStats()

    let quicAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4003/quic")
    if IsErr(quicAddrRes):
        return Err[bool](Error(quicAddrRes))
    let quicAddr: MultiAddress = Value(quicAddrRes)
    var quic: MsQuicTransport = initMsQuicTransport()
    start(quic, quicAddr)
    let quicDialRes: Result[Connection] = dial(quic, quicAddr)
    if IsErr(quicDialRes):
        return Err[bool](Error(quicDialRes))
    var quicOut: Connection = Value(quicDialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: quic alias transport memory ! reserved")
    stop(quic)
    close(quicOut)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: quic alias transport memory ! released on stop")
    resetTransportMemoryStats()

    let opensslAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4004/quic-v1/tls")
    if IsErr(opensslAddrRes):
        return Err[bool](Error(opensslAddrRes))
    let opensslAddr: MultiAddress = Value(opensslAddrRes)
    var openssl: MsQuicTransport = initMsQuicTransport()
    start(openssl, opensslAddr)
    let opensslDialRes: Result[Connection] = dial(openssl, opensslAddr)
    if IsErr(opensslDialRes):
        return Err[bool](Error(opensslDialRes))
    var opensslOut: Connection = Value(opensslDialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: quic-v1/tls alias transport memory ! reserved")
    stop(openssl)
    close(opensslOut)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: quic-v1/tls alias transport memory ! released on stop")
    resetTransportMemoryStats()

    let webrtcDirectAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4005/webrtc-direct")
    if IsErr(webrtcDirectAddrRes):
        return Err[bool](Error(webrtcDirectAddrRes))
    let webrtcDirectAddr: MultiAddress = Value(webrtcDirectAddrRes)
    var webrtcDirect: WebrtcDirectTransport = initWebrtcDirectTransport()
    start(webrtcDirect, webrtcDirectAddr)
    let webrtcDirectDialRes: Result[Connection] = dial(webrtcDirect, webrtcDirectAddr)
    if IsErr(webrtcDirectDialRes):
        return Err[bool](Error(webrtcDirectDialRes))
    var webrtcDirectOut: Connection = Value(webrtcDirectDialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: webrtc direct transport memory ! reserved")
    stop(webrtcDirect)
    close(webrtcDirectOut)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: webrtc direct transport memory ! released on stop")
    resetTransportMemoryStats()

    let webrtcStarAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4006/ws/p2p-webrtc-star")
    if IsErr(webrtcStarAddrRes):
        return Err[bool](Error(webrtcStarAddrRes))
    let webrtcStarAddr: MultiAddress = Value(webrtcStarAddrRes)
    var webrtcStar: WebrtcStarTransport = initWebrtcStarTransport()
    start(webrtcStar, webrtcStarAddr)
    let webrtcStarDialRes: Result[Connection] = dial(webrtcStar, webrtcStarAddr)
    if IsErr(webrtcStarDialRes):
        return Err[bool](Error(webrtcStarDialRes))
    var webrtcStarOut: Connection = Value(webrtcStarDialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: webrtc star transport memory ! reserved")
    stop(webrtcStar)
    close(webrtcStarOut)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: webrtc star transport memory ! released on stop")
    resetTransportMemoryStats()

    let torAddrRes: Result[MultiAddress] = parseMultiAddress("/onion/aaaaaaaaaaaaaaaa:4007")
    if IsErr(torAddrRes):
        return Err[bool](Error(torAddrRes))
    let torAddr: MultiAddress = Value(torAddrRes)
    var tor: TorTransport = initTorTransport()
    start(tor, torAddr)
    let torDialRes: Result[Connection] = dial(tor, torAddr)
    if IsErr(torDialRes):
        return Err[bool](Error(torDialRes))
    var torOut: Connection = Value(torDialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: tor transport memory ! reserved")
    stop(tor)
    close(torOut)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: tor transport memory ! released on stop")
    resetTransportMemoryStats()

    let msquicAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4008/quic-v1")
    if IsErr(msquicAddrRes):
        return Err[bool](Error(msquicAddrRes))
    let msquicAddr: MultiAddress = Value(msquicAddrRes)
    var msquic: MsQuicTransport = initMsQuicTransport()
    start(msquic, msquicAddr)
    let msquicDialRes: Result[Connection] = dial(msquic, msquicAddr)
    if IsErr(msquicDialRes):
        return Err[bool](Error(msquicDialRes))
    var msquicOut: Connection = Value(msquicDialRes)
    if transportMemoryUsed() <= 0:
        return Err[bool]("smoke: msquic transport memory ! reserved")
    stop(msquic)
    close(msquicOut)
    if transportMemoryUsed() != 0:
        return Err[bool]("smoke: msquic transport memory ! released on stop")
    return Ok[bool](true)
