# DID unit tests.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/stringlist
import std/times
import cheng/libp2p/crypto/crypto
import cheng/libp2p/peerid
import cheng/libp2p/did/types
import cheng/libp2p/did/document
import cheng/libp2p/did/credential
import cheng/libp2p/did/biometric
import cheng/libp2p/did/identity_store

fn didTestCapabilities(): Result[StringList] =
    var out: StringList = InitStringList()
    let addFpRes: Result[bool] = StringListAdd(out, "fingerprint")
    if IsErr(addFpRes):
        return Err[StringList](Error(addFpRes))
    let addIrisRes: Result[bool] = StringListAdd(out, "iris")
    if IsErr(addIrisRes):
        return Err[StringList](Error(addIrisRes))
    return Ok[StringList](out)

fn runDidDocumentCredentialUnit(): Result[bool] =
    let rootKpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(rootKpRes):
        return Err[bool](Error(rootKpRes))
    let deviceKpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(deviceKpRes):
        return Err[bool](Error(deviceKpRes))
    let rootKp: KeyPair = Value(rootKpRes)
    let deviceKp: KeyPair = Value(deviceKpRes)
    let rootPidRes: Result[PeerId] = peerIdFromPrivateKey(rootKp.privateKey)
    if IsErr(rootPidRes):
        return Err[bool](Error(rootPidRes))
    let devicePidRes: Result[PeerId] = peerIdFromPrivateKey(deviceKp.privateKey)
    if IsErr(devicePidRes):
        return Err[bool](Error(devicePidRes))
    let capsRes: Result[StringList] = didTestCapabilities()
    if IsErr(capsRes):
        return Err[bool](Error(capsRes))

    var device: DeviceMethodV1 = initDeviceMethodV1()
    device.devicePeerId = toString(Value(devicePidRes))
    device.devicePubKey = deviceKp.publicKey
    device.status = didDeviceActive
    device.biometricCapabilities = Value(capsRes)
    device.biometricClass = "local"
    device.addedAtNs = EpochTimeNs()

    var doc: DidDocumentV1 = initDidDocumentV1()
    doc.id = didFromRootPeerId(Value(rootPidRes))
    doc.version = 1
    doc.updatedAtNs = device.addedAtNs
    doc.rootMethod = rootKp.publicKey
    doc.devices[0] = device
    doc.deviceCount = 1

    let signedDocRes: Result[Bytes] = signDidDocument(doc, rootKp.privateKey)
    if IsErr(signedDocRes):
        return Err[bool](Error(signedDocRes))
    let decodedDocRes: Result[DidDocumentV1] = decodeSignedDidDocument(Value(signedDocRes))
    if IsErr(decodedDocRes):
        return Err[bool](Error(decodedDocRes))
    let decodedDoc: DidDocumentV1 = Value(decodedDocRes)
    if (decodedDoc.id != doc.id):
        return Err[bool]("unit: did document id mismatch")
    if decodedDoc.deviceCount != 1:
        return Err[bool]("unit: did document device count mismatch")
    if (decodedDoc.devices[0].devicePeerId != device.devicePeerId):
        return Err[bool]("unit: did document device peer mismatch")

    let proofRes: Result[Bytes] = CreateAndSignDeviceDelegationProof(
        doc.id,
        doc.version,
        doc.updatedAtNs,
        device,
        rootKp.privateKey
    )
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    let verifiedRes: Result[DeviceDelegationProofV1] = VerifyDeviceDelegationProofWithDocument(Value(proofRes), decodedDoc)
    if IsErr(verifiedRes):
        return Err[bool](Error(verifiedRes))

    let badDidRes: Result[DeviceDelegationProofV1] = VerifyDeviceDelegationProofWithDid(Value(proofRes), "did:cheng:invalid")
    if IsOk(badDidRes):
        return Err[bool]("unit: expected bad did verification failure")

    var revokedDoc: DidDocumentV1 = decodedDoc
    let revokeRes: Result[bool] = revokeDeviceInDocument(revokedDoc, device.devicePeerId, EpochTimeNs() + 1)
    if IsErr(revokeRes):
        return Err[bool](Error(revokeRes))
    let revokedProofRes: Result[DeviceDelegationProofV1] = VerifyDeviceDelegationProofWithDocument(Value(proofRes), revokedDoc)
    if IsOk(revokedProofRes):
        return Err[bool]("unit: expected revoked device verification failure")

    var rev: DidRevocationV1 = initDidRevocationV1()
    rev.did = doc.id
    rev.version = doc.version + 1
    rev.revokedAtNs = EpochTimeNs()
    rev.devicePeerId = device.devicePeerId
    let signedRevRes: Result[Bytes] = SignDidRevocation(rev, rootKp.privateKey)
    if IsErr(signedRevRes):
        return Err[bool](Error(signedRevRes))
    let verifyRevRes: Result[DidRevocationV1] = VerifyDidRevocationWithDid(Value(signedRevRes), doc.id)
    if IsErr(verifyRevRes):
        return Err[bool](Error(verifyRevRes))
    var tamperedRev: Bytes = Value(signedRevRes)
    if BytesLen(tamperedRev) <= 0:
        return Err[bool]("unit: empty signed revocation")
    let lastIdx: int32 = BytesLen(tamperedRev) - 1
    BytesSet(tamperedRev, lastIdx, (BytesGet(tamperedRev, lastIdx) + 1) % 256)
    let tamperedVerifyRes: Result[DidRevocationV1] = VerifyDidRevocationWithDid(tamperedRev, doc.id)
    if IsOk(tamperedVerifyRes):
        return Err[bool]("unit: tampered revocation passed verification")

    return Ok[bool](true)

fn runDidMultiDeviceUnit(): Result[bool] =
    let rootKpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(rootKpRes):
        return Err[bool](Error(rootKpRes))
    let deviceAKpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(deviceAKpRes):
        return Err[bool](Error(deviceAKpRes))
    let deviceBKpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(deviceBKpRes):
        return Err[bool](Error(deviceBKpRes))
    let capsRes: Result[StringList] = didTestCapabilities()
    if IsErr(capsRes):
        return Err[bool](Error(capsRes))
    let idRes: Result[DidIdentity] = didIdentityFromKeypairs(
        Value(rootKpRes),
        Value(deviceAKpRes),
        "local",
        Value(capsRes)
    )
    if IsErr(idRes):
        return Err[bool](Error(idRes))
    var identity: DidIdentity = Value(idRes)
    var proofB: Bytes = EmptyBytes()
    let enrollRes: Result[bool] = didIdentityEnrollDevice(
        identity,
        Value(deviceBKpRes).publicKey,
        "local",
        Value(capsRes),
        EpochTimeNs(),
        proofB
    )
    if IsErr(enrollRes):
        return Err[bool](Error(enrollRes))
    if identity.document.deviceCount < 2:
        return Err[bool]("unit: expected second device in did document")
    let proofCheckRes: Result[DeviceDelegationProofV1] = VerifyDeviceDelegationProofWithDocument(proofB, identity.document)
    if IsErr(proofCheckRes):
        return Err[bool](Error(proofCheckRes))
    let deviceBPeerRes: Result[PeerId] = peerIdFromPrivateKey(Value(deviceBKpRes).privateKey)
    if IsErr(deviceBPeerRes):
        return Err[bool](Error(deviceBPeerRes))
    if (Value(proofCheckRes).device.devicePeerId != toString(Value(deviceBPeerRes))):
        return Err[bool]("unit: enrolled device delegation peer mismatch")
    return Ok[bool](true)

fn runDidBiometricUnit(): Result[bool] =
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        return Err[bool](Error(kpRes))
    let pidRes: Result[PeerId] = peerIdFromPrivateKey(Value(kpRes).privateKey)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    var modalities: StringList = InitStringList()
    let addRes: Result[bool] = StringListAdd(modalities, "fingerprint")
    if IsErr(addRes):
        return Err[bool](Error(addRes))

    let didText: str = didFromRootPeerId(Value(pidRes))
    let peerText: str = toString(Value(pidRes))
    let nonceA: Bytes = BytesFromString("nonce-a")
    let nonceB: Bytes = BytesFromString("nonce-b")
    let assertionRes: Result[BiometricAssertionV1] = buildBiometricAssertion(
        didText,
        peerText,
        nonceA,
        nonceB,
        EpochTimeNs(),
        modalities
    )
    if IsErr(assertionRes):
        return Err[bool](Error(assertionRes))
    let assertion: BiometricAssertionV1 = Value(assertionRes)
    let encRes: Result[Bytes] = encodeBiometricAssertion(assertion)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let decRes: Result[BiometricAssertionV1] = decodeBiometricAssertion(Value(encRes))
    if IsErr(decRes):
        return Err[bool](Error(decRes))
    let decoded: BiometricAssertionV1 = Value(decRes)
    if decoded.modalities.count != 1:
        return Err[bool]("unit: biometric modalities mismatch")
    if (decoded.modalities.items[0] != "fingerprint"):
        return Err[bool]("unit: biometric modality value mismatch")
    if ! verifyBiometricAssertion(decoded, didText, peerText, nonceA, nonceB):
        return Err[bool]("unit: biometric verification failed")
    var tampered: BiometricAssertionV1 = decoded
    tampered.localOnly = false
    if verifyBiometricAssertion(tampered, didText, peerText, nonceA, nonceB):
        return Err[bool]("unit: biometric localOnly policy bypassed")
    if StrContains(BytesToString(Value(encRes)), "template"):
        return Err[bool]("unit: biometric assertion leaked template marker")
    return Ok[bool](true)

fn runDidIdentityStoreUnit(): Result[bool] =
    let basePath: str = "/tmp/cheng-libp2p-did-unit-" + $(EpochTimeNs()) + ".bin"
    let id1Res: Result[DidIdentity] = didLoadOrCreateIdentity(basePath)
    if IsErr(id1Res):
        return Err[bool](Error(id1Res))
    let id2Res: Result[DidIdentity] = didLoadOrCreateIdentity(basePath)
    if IsErr(id2Res):
        return Err[bool](Error(id2Res))
    let id1: DidIdentity = Value(id1Res)
    let id2: DidIdentity = Value(id2Res)
    let eqStableRes: Result[bool] = peerIdEqual(id1.devicePeerId, id2.devicePeerId)
    if IsErr(eqStableRes):
        return Err[bool](Error(eqStableRes))
    if ! Value(eqStableRes):
        return Err[bool]("unit: device peer id changed without wipe")

    let wipeRes: Result[bool] = didIdentityWriteFile(basePath, BytesAlloc(0))
    if IsErr(wipeRes):
        return Err[bool](Error(wipeRes))
    let id3Res: Result[DidIdentity] = didLoadOrCreateIdentity(basePath)
    if IsErr(id3Res):
        return Err[bool](Error(id3Res))
    let eqWipeRes: Result[bool] = peerIdEqual(id1.devicePeerId, Value(id3Res).devicePeerId)
    if IsErr(eqWipeRes):
        return Err[bool](Error(eqWipeRes))
    if Value(eqWipeRes):
        return Err[bool]("unit: device peer id unchanged after identity wipe")
    return Ok[bool](true)

fn runDidUnit(): Result[bool] =
    let docRes: Result[bool] = runDidDocumentCredentialUnit()
    if IsErr(docRes):
        return docRes
    let multiRes: Result[bool] = runDidMultiDeviceUnit()
    if IsErr(multiRes):
        return multiRes
    let bioRes: Result[bool] = runDidBiometricUnit()
    if IsErr(bioRes):
        return bioRes
    let storeRes: Result[bool] = runDidIdentityStoreUnit()
    if IsErr(storeRes):
        return storeRes
    return Ok[bool](true)
