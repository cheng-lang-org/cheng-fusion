# Name resolving smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/stringlist
import cheng/libp2p/nameresolving/nameresolver
import cheng/libp2p/nameresolving/mockresolver
fn runNameResolvingSmoke(): Result[bool] =
    mockReset()
    let addRes: Result[bool] = mockAdd("peer.local", "/dns/peer.local")
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    setNameResolver(mockNameResolver())
    let res: Result[StringList] = resolveName("peer.local")
    if IsErr(res):
        return Err[bool](Error(res))
    let list: StringList = Value(res)
    if ! StringListContains(list, "/dns/peer.local"):
        return Err[bool]("smoke: resolved address missing")
    return Ok[bool](true)
