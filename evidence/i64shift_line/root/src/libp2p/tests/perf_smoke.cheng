# Perf protocol smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/switch
import cheng/libp2p/builders
import cheng/libp2p/protocols/perf/core
import cheng/libp2p/protocols/perf/client
import cheng/libp2p/protocols/perf/server
fn runPerfSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/31")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    var req: PerfRequest = initPerfRequest(64, 4)
    let sendRes: Result[int64] = perfClientSend(outStream, req)
    if IsErr(sendRes):
        return Err[bool](Error(sendRes))
    let handleRes: Result[bool] = perfServerHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let summaryRes: Result[PerfSummary] = readPerfSummary(outStream)
    if IsErr(summaryRes):
        return Err[bool](Error(summaryRes))
    let summary: PerfSummary = Value(summaryRes)
    if ! summary.ok:
        return Err[bool]("smoke: perf summary ! ok")
    if summary.count != req.messageCount:
        return Err[bool]("smoke: perf count mismatch")
    if summary.bytes != Value(sendRes):
        return Err[bool]("smoke: perf byte count mismatch")
    return Ok[bool](true)
