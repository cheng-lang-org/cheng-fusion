# Switch + ping smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/crypto/rand
import cheng/libp2p/stream/lpstream
import cheng/libp2p/builders
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/protocols/identify
import cheng/libp2p/protocols/ping
import cheng/libp2p/switch
fn stringCmpLocal(a: str, b: str): int32 =
    let alen: int32 = len(a)
    let blen: int32 = len(b)
    let minLen: int32 = if alen < blen: alen else: blen
    for i in 0..<minLen:
        let diff: int32 = int32(a[i]) - int32(b[i])
        if diff != 0:
            return diff
    return alen - blen

fn runSwitchSmoke(): Result[bool] =
    setRandomSeed(BytesFromString("cheng-libp2p-switch-smoke"))
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/1")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    sw.activeMuxer = Some[Muxer](outboundMux)
    let idOutRes: Result[Stream] = openStream(outboundMux)
    if IsErr(idOutRes):
        return Err[bool](Error(idOutRes))
    var idOut: Stream = Value(idOutRes)
    let idInRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(idInRes):
        return Err[bool](Error(idInRes))
    var idIn: Stream = Value(idInRes)
    let selIdRes: Result[str] = selectProtocolOnStreamAuto(sw, idOut)
    if IsErr(selIdRes):
        return Err[bool](Error(selIdRes))
    if (Value(selIdRes) != identifyCodec):
        return Err[bool]("smoke: unexpected identify codec")
    let idRes: Result[bool] = runProtocol(sw, idIn, "")
    if IsErr(idRes):
        return Err[bool](Error(idRes))
    let idPayloadRes: Result[Bytes] = readLp(idOut, 65536)
    if IsErr(idPayloadRes):
        return Err[bool](Error(idPayloadRes))
    let idPayload: str = BytesToString(Value(idPayloadRes))
    if len(idPayload) <= 0 || ! StrContains(idPayload, "id="):
        return Err[bool]("smoke: identify payload missing id")
    let updateRes: Result[PeerId] = updatePeerStoreFromIdentify(sw.peerStore, idPayload)
    if IsErr(updateRes):
        return Err[bool](Error(updateRes))
    let storedId: PeerId = Value(updateRes)
    let hasRes: Result[bool] = hasPeer(sw.peerStore, storedId)
    if IsErr(hasRes):
        return Err[bool](Error(hasRes))
    if ! Value(hasRes):
        return Err[bool]("smoke: peerstore missing identify peer")
    let peerRes: Result[PeerInfo] = getPeer(sw.peerStore, storedId)
    if IsErr(peerRes):
        return Err[bool](Error(peerRes))
    let peer: PeerInfo = Value(peerRes)
    if ! hasAddress(peer):
        return Err[bool]("smoke: peerstore missing listen address")
    let addrRes2: Result[MultiAddress] = parseMultiAddress("/memory/1")
    if IsErr(addrRes2):
        return Err[bool](Error(addrRes2))
    if ! addressesContain(peer, Value(addrRes2)):
        return Err[bool]("smoke: peerstore address mismatch")
    if ! protocolsContain(peer, pingCodec):
        return Err[bool]("smoke: peerstore missing ping protocol")
    let findRes: Result[Option[PeerId]] = findPeerByProtocol(sw.peerStore, pingCodec)
    if IsErr(findRes):
        return Err[bool](Error(findRes))
    let findOpt: Option[PeerId] = Value(findRes)
    if ! findOpt.has:
        return Err[bool]("smoke: missing peer by protocol")
    let eqRes: Result[bool] = peerIdEqual(findOpt.value, storedId)
    if IsErr(eqRes):
        return Err[bool](Error(eqRes))
    if ! Value(eqRes):
        return Err[bool]("smoke: protocol lookup mismatched peer")
    let otherIdRes: Result[PeerId] = randomPeerId()
    if IsErr(otherIdRes):
        return Err[bool](Error(otherIdRes))
    var other: PeerInfo = newPeerInfo(Value(otherIdRes))
    let tcpAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4001")
    if IsErr(tcpAddrRes):
        return Err[bool](Error(tcpAddrRes))
    let addRes: Result[bool] = addAddress(other, Value(tcpAddrRes))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    let wsAddrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4001/ws")
    if IsErr(wsAddrRes):
        return Err[bool](Error(wsAddrRes))
    let addWsRes: Result[bool] = addAddress(other, Value(wsAddrRes))
    if IsErr(addWsRes):
        return Err[bool](Error(addWsRes))
    let protoRes: Result[bool] = setProtocolsText(other, pingCodec)
    if IsErr(protoRes):
        return Err[bool](Error(protoRes))
    let mergeRes: Result[bool] = mergePeer(sw.peerStore, other)
    if IsErr(mergeRes):
        return Err[bool](Error(mergeRes))
    let selOpt: Option[MultiAddress] = selectDialAddress(sw, other)
    if ! selOpt.has:
        return Err[bool]("smoke: selectDialAddress returned none")
    let selText: str = toString(selOpt.value)
    if ! StrContains(selText, "/ws/"):
        return Err[bool]("smoke: selectDialAddress did ! prefer ws")
    let findRes2: Result[Option[PeerId]] = findPeerByProtocol(sw.peerStore, pingCodec)
    if IsErr(findRes2):
        return Err[bool](Error(findRes2))
    let findOpt2: Option[PeerId] = Value(findRes2)
    if ! findOpt2.has:
        return Err[bool]("smoke: missing peer by protocol after add")
    let eqRes2: Result[bool] = peerIdEqual(findOpt2.value, Value(otherIdRes))
    if IsErr(eqRes2):
        return Err[bool](Error(eqRes2))
    if ! Value(eqRes2):
        return Err[bool]("smoke: protocol lookup did ! prefer non-memory peer")
    let sortedRes: Result[StringList] = listPeerIdsSorted(sw.peerStore)
    if IsErr(sortedRes):
        return Err[bool](Error(sortedRes))
    let sorted: StringList = Value(sortedRes)
    if StringListCount(sorted) < 2:
        return Err[bool]("smoke: expected at least 2 peer ids")
    for k in 1..<sorted.count:
        if stringCmpLocal(sorted.items[k - 1], sorted.items[k]) > 0:
            return Err[bool]("smoke: peer id list ! sorted")
    let pageRes: Result[StringList] = listPeerIdsSortedPage(sw.peerStore, 1, 1)
    if IsErr(pageRes):
        return Err[bool](Error(pageRes))
    let pageList: StringList = Value(pageRes)
    if StringListCount(pageList) != 1:
        return Err[bool]("smoke: peer id page size mismatch")
    if (pageList.items[0] != sorted.items[0]):
        return Err[bool]("smoke: peer id page mismatch")
    let offsetRes: Result[StringList] = listPeerIdsSortedOffset(sw.peerStore, 1, 1)
    if IsErr(offsetRes):
        return Err[bool](Error(offsetRes))
    let offsetList: StringList = Value(offsetRes)
    if StringListCount(offsetList) != 1:
        return Err[bool]("smoke: peer id offset size mismatch")
    if (offsetList.items[0] != sorted.items[1]):
        return Err[bool]("smoke: peer id offset mismatch")
    let tcpListRes: Result[StringList] = listPeerIdsByAddressSubstringSorted(sw.peerStore, "/tcp/")
    if IsErr(tcpListRes):
        return Err[bool](Error(tcpListRes))
    let tcpList: StringList = Value(tcpListRes)
    if StringListCount(tcpList) != 1:
        return Err[bool]("smoke: tcp filtered peer list size mismatch")
    let otherIdText: str = toString(other.id)
    if (tcpList.items[0] != otherIdText):
        return Err[bool]("smoke: tcp filtered peer list mismatch")
    let payload: Bytes = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(payload, i, i)
    let pingOutRes: Result[Stream] = openStream(outboundMux)
    if IsErr(pingOutRes):
        return Err[bool](Error(pingOutRes))
    var pingOut: Stream = Value(pingOutRes)
    let pingInRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(pingInRes):
        return Err[bool](Error(pingInRes))
    var pingIn: Stream = Value(pingInRes)
    let selPingRes: Result[bool] = selectProtocolOnStream(sw, pingOut, pingCodec)
    if IsErr(selPingRes):
        return Err[bool](Error(selPingRes))
    let writeRes: Result[int32] = write(pingOut, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let runRes: Result[bool] = runProtocol(sw, pingIn, "")
    if IsErr(runRes):
        return Err[bool](Error(runRes))
    let echoRes: Result[Bytes] = readExact(pingOut, 32)
    if IsErr(echoRes):
        return Err[bool](Error(echoRes))
    if ! BytesEqual(Value(echoRes), payload):
        return Err[bool]("smoke: ping echo mismatch")
    let inboundConn: Connection = muxerConnection(inboundMux)
    let remoteText: str = RemotePeerId(inboundConn)
    if len(remoteText) <= 0:
        return Err[bool]("smoke: plaintext handshake missing peer id")
    let localText: str = peerid.toString(sw.peerId)
    if len(localText) > 0 && (remoteText != localText):
        return Err[bool]("smoke: plaintext handshake peer id mismatch")
    if count(sw.connManager) != 2:
        return Err[bool]("smoke: connmanager count mismatch")
    let outboundDump: str = dumpConnectionsByDirection(sw, Outbound)
    if len(outboundDump) <= 0 || ! StrContains(outboundDump, "outbound"):
        return Err[bool]("smoke: connmanager outbound dump missing")
    let inboundDump: str = dumpConnectionsByDirection(sw, Inbound)
    if len(inboundDump) <= 0 || ! StrContains(inboundDump, "inbound"):
        return Err[bool]("smoke: connmanager inbound dump missing")
    if connectionCountByDirection(sw, Outbound) != 1:
        return Err[bool]("smoke: connmanager outbound count mismatch")
    if connectionCountByDirection(sw, Inbound) != 1:
        return Err[bool]("smoke: connmanager inbound count mismatch")
    if connectionCountOpen(sw) != 2:
        return Err[bool]("smoke: connmanager open count mismatch")
    if connectionCountClosed(sw) != 0:
        return Err[bool]("smoke: connmanager closed count mismatch")
    if connectionCountByAddressSubstring(sw, "/memory/") != 2:
        return Err[bool]("smoke: connmanager address count mismatch")
    let addrDump: str = dumpConnectionsByAddressSubstring(sw, "/memory/")
    if len(addrDump) <= 0:
        return Err[bool]("smoke: connmanager address dump missing")
    let sortedDump: str = dumpConnectionsSorted(sw)
    if len(sortedDump) <= 0:
        return Err[bool]("smoke: connmanager sorted dump missing")
    let firstSorted: str = dumpConnectionsSortedLimit(sw, 1)
    if ! StrContains(firstSorted, "inbound"):
        return Err[bool]("smoke: connmanager sorted order mismatch")
    let closeRes: Result[bool] = closeActiveMuxer(sw)
    if IsErr(closeRes):
        return Err[bool](Error(closeRes))
    if connectionCountOpen(sw) != 1:
        return Err[bool]("smoke: connmanager open count after close mismatch")
    if connectionCountClosed(sw) != 1:
        return Err[bool]("smoke: connmanager closed count after close mismatch")
    let openDump: str = dumpConnectionsByOpenState(sw, true)
    if len(openDump) <= 0 || ! StrContains(openDump, "open"):
        return Err[bool]("smoke: connmanager open dump missing")
    let closedDump: str = dumpConnectionsByOpenState(sw, false)
    if len(closedDump) <= 0 || ! StrContains(closedDump, "closed"):
        return Err[bool]("smoke: connmanager closed dump missing")
    let jsonDump: str = dumpConnectionsJson(sw)
    if len(jsonDump) <= 0 || ! StrContains(jsonDump, "open") || ! StrContains(jsonDump, "dir"):
        return Err[bool]("smoke: connmanager json dump missing fields")
    let closedCount: int32 = closeAllConnections(sw)
    if closedCount != 1:
        return Err[bool]("smoke: closeAllConnections closed count mismatch")
    if connectionCountOpen(sw) != 0:
        return Err[bool]("smoke: connmanager open count after closeAll mismatch")
    if connectionCountClosed(sw) != 2:
        return Err[bool]("smoke: connmanager closed count after closeAll mismatch")
    stop(sw)

    var builder2: SwitchBuilder = newSwitchBuilder()
    let addr2Res: Result[bool] = withAddressText(builder2, "/memory/2")
    if IsErr(addr2Res):
        return Err[bool](Error(addr2Res))
    let muxRes: Result[bool] = withMuxerText(builder2, "auto")
    if IsErr(muxRes):
        return Err[bool](Error(muxRes))
    let sw2Res: Result[Switch] = build(builder2)
    if IsErr(sw2Res):
        return Err[bool](Error(sw2Res))
    var sw2: Switch = Value(sw2Res)
    let start2Res: Result[bool] = start(sw2)
    if IsErr(start2Res):
        return Err[bool](Error(start2Res))
    let dial2Res: Result[Muxer] = dial(sw2, sw2.listenAddr)
    if IsErr(dial2Res):
        return Err[bool](Error(dial2Res))
    var outMux2: Muxer = Value(dial2Res)
    let accept2Res: Result[Muxer] = accept(sw2)
    if IsErr(accept2Res):
        return Err[bool](Error(accept2Res))
    var inMux2: Muxer = Value(accept2Res)
    if muxerKind(outMux2) != muxerKindYamux:
        return Err[bool]("smoke: muxer auto did ! select yamux(outbound)")
    if muxerKind(inMux2) != muxerKindYamux:
        return Err[bool]("smoke: muxer auto did ! select yamux(inbound)")
    let outStreamRes: Result[Stream] = openStream(outMux2)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inMux2)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    let payload2: Bytes = BytesFromString("yamux-smoke")
    let write2Res: Result[int32] = write(outStream, payload2)
    if IsErr(write2Res):
        return Err[bool](Error(write2Res))
    let read2Res: Result[Bytes] = readExact(inStream, BytesLen(payload2))
    if IsErr(read2Res):
        return Err[bool](Error(read2Res))
    if ! BytesEqual(Value(read2Res), payload2):
        return Err[bool]("smoke: muxer auto payload mismatch")
    let closeOutRes: Result[bool] = closeStream(outStream)
    if IsErr(closeOutRes):
        return Err[bool](Error(closeOutRes))
    let closeInRes: Result[bool] = closeStream(inStream)
    if IsErr(closeInRes):
        return Err[bool](Error(closeInRes))
    let denyRes: Result[bool] = denyAddressSubstring(sw2.gater, "/memory/")
    if IsErr(denyRes):
        return Err[bool](Error(denyRes))
    setGaterEnabled(sw2.gater, true)
    let blockRes: Result[Muxer] = dial(sw2, sw2.listenAddr)
    if ! IsErr(blockRes):
        return Err[bool]("smoke: connection gater did ! block dial")
    stop(sw2)
    return Ok[bool](true)
