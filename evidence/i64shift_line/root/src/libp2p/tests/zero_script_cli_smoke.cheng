import std/os
import std/strutils as strutil
import cheng/libp2p/cli/zero_script_cli
import cheng/libp2p/utils/result

fn runZeroScriptCliSmoke(): Result[bool] =
    let preflightArgs: str[] = ["preflight", "--shell-env", "--skip-driver-probe", "--skip-gates"]
    let preflightRc: int32 = runZeroScriptCliArgs(preflightArgs)
    if preflightRc != 0:
        return Err[bool]("zero-script-cli: native preflight failed")

    let verifyMissingArgs: str[] = ["verify", "--mode:test", "--runner:src/tests/not_found_runner.cheng"]
    let verifyMissingRc: int32 = runZeroScriptCliArgs(verifyMissingArgs)
    if verifyMissingRc != 2:
        return Err[bool]("zero-script-cli: expected missing-runner rc=2")

    let verifyDryRunArgs: str[] = ["verify", "--mode:test", "--runner:src/tests/mobile_multiaddr_nearfield_smoke.cheng", "--dry-run", "--skip-driver-probe", "--skip-gates"]
    let verifyDryRunRc: int32 = runZeroScriptCliArgs(verifyDryRunArgs)
    if verifyDryRunRc != 0:
        return Err[bool]("zero-script-cli: dry-run verify failed")

    let outDir: str = zero_script_cli.cliAbsPath("artifacts/zero_script_cli_smoke")
    let report: str = cliJoinPath(outDir, "cstring.report.txt")
    let buildLog: str = cliJoinPath(outDir, "cstring.build.log")
    let probeArgs: str[] = ["cstring-probe", "--report:" + report, "--build-log:" + buildLog, "--dry-run", "--skip-driver-probe", "--skip-gates"]
    let probeRc: int32 = runZeroScriptCliArgs(probeArgs)
    if probeRc != 0:
        return Err[bool]("zero-script-cli: cstring probe failed")
    if os.fileExists(report):
        let reportText: str = os.readFile(report)
        if !strutil.contains(reportText, "[dry-run]"):
            return Err[bool]("zero-script-cli: cstring dry-run report missing marker")

    let mobileDryRunArgs: str[] = ["mobile-suite", "--dry-run", "--skip-driver-probe", "--skip-gates"]
    let mobileDryRunRc: int32 = runZeroScriptCliArgs(mobileDryRunArgs)
    if mobileDryRunRc != 0:
        return Err[bool]("zero-script-cli: mobile-suite dry-run failed")

    let matrixDryRunArgs: str[] = ["device-matrix", "--dry-run", "--skip-driver-probe", "--skip-gates"]
    let matrixDryRunRc: int32 = runZeroScriptCliArgs(matrixDryRunArgs)
    if matrixDryRunRc != 0:
        return Err[bool]("zero-script-cli: device-matrix dry-run failed")

    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runZeroScriptCliSmoke()
    if IsErr(res):
        echo(Error(res))
        return 1
    echo("zero_script_cli_smoke ok")
    return 0
