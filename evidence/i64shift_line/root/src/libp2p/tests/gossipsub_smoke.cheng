# Gossipsub smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/pubsub/gossipsub
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runGossipsubSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/20")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let subRes: Result[bool] = gossipsubSubscribe("topic-gs")
    if IsErr(subRes):
        return Err[bool](Error(subRes))
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    var sub: PubsubSubscription = initPubsubSubscription()
    sub.topic = "topic-gs"
    sub.subscribe = true
    var subRpc: PubsubRPC = initPubsubRPC()
    subRpc.subCount = 1
    subRpc.subs[0] = sub
    let writeSubRes: Result[bool] = writeGossipsubRpc(outStream, subRpc)
    if IsErr(writeSubRes):
        return Err[bool](Error(writeSubRes))
    let handleSubRes: Result[bool] = gossipsubHandler(inStream)
    if IsErr(handleSubRes):
        return Err[bool](Error(handleSubRes))
    let subReplyRes: Result[PubsubRPC] = readGossipsubRpc(outStream)
    if IsErr(subReplyRes):
        return Err[bool](Error(subReplyRes))
    let subReply: PubsubRPC = Value(subReplyRes)
    if ! subReply.hasControl || subReply.control.graftCount <= 0:
        return Err[bool]("smoke: gossipsub graft missing")
    if subReply.control.grafts[0].topic != "topic-gs":
        return Err[bool]("smoke: gossipsub graft topic mismatch")
    var msg: PubsubMessage = initPubsubMessage()
    msg.topic = "topic-gs"
    msg.data = BytesFromString("gossipsub-smoke-data")
    msg.hasSeqno = true
    msg.seqno = BytesFromString("seq-1")
    var rpc: PubsubRPC = initPubsubRPC()
    rpc.msgs[0] = msg
    rpc.msgCount = 1
    let writeRes: Result[bool] = writeGossipsubRpc(outStream, rpc)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = gossipsubHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    var inbox: PubsubInboxMessage
    if ! gossipsubNextMessage(inbox):
        return Err[bool]("smoke: gossipsub inbox empty")
    if inbox.topic != "topic-gs":
        return Err[bool]("smoke: gossipsub topic mismatch")
    if ! BytesEqual(inbox.data, BytesFromString("gossipsub-smoke-data")):
        return Err[bool]("smoke: gossipsub data mismatch")
    msg.data = BytesFromString("gossipsub-smoke-data-2")
    msg.seqno = BytesFromString("seq-2")
    rpc.msgs[0] = msg
    let writeRes2: Result[bool] = writeGossipsubRpc(outStream, rpc)
    if IsErr(writeRes2):
        return Err[bool](Error(writeRes2))
    let handleRes2: Result[bool] = gossipsubHandler(inStream)
    if IsErr(handleRes2):
        return Err[bool](Error(handleRes2))
    if ! gossipsubNextMessage(inbox):
        return Err[bool]("smoke: gossipsub inbox second message empty")
    if inbox.topic != "topic-gs":
        return Err[bool]("smoke: gossipsub second topic mismatch")
    if ! BytesEqual(inbox.data, BytesFromString("gossipsub-smoke-data-2")):
        return Err[bool]("smoke: gossipsub second data mismatch")
    var iwant: PubsubControlIWant = initPubsubControlIWant()
    iwant.topic = "topic-gs"
    iwant.msgIdCount = 2
    iwant.msgIds[0] = BytesFromString("seq-1")
    iwant.msgIds[1] = BytesFromString("seq-2")
    var control: PubsubControl = initPubsubControl()
    control.iwantCount = 1
    control.iwants[0] = iwant
    var ctrlRpc: PubsubRPC = initPubsubRPC()
    ctrlRpc.hasControl = true
    ctrlRpc.control = control
    let writeCtrlRes: Result[bool] = writeGossipsubRpc(outStream, ctrlRpc)
    if IsErr(writeCtrlRes):
        return Err[bool](Error(writeCtrlRes))
    let handleCtrlRes: Result[bool] = gossipsubHandler(inStream)
    if IsErr(handleCtrlRes):
        return Err[bool](Error(handleCtrlRes))
    let replyRes: Result[PubsubRPC] = readGossipsubRpc(outStream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let replyRpc: PubsubRPC = Value(replyRes)
    if replyRpc.msgCount <= 0:
        return Err[bool]("smoke: gossipsub iwant reply missing")
    if replyRpc.msgCount != 1:
        return Err[bool]("smoke: gossipsub stagger expected one msg")
    if replyRpc.msgs[0].topic != "topic-gs":
        return Err[bool]("smoke: gossipsub iwant topic mismatch")
    if ! replyRpc.hasControl || replyRpc.control.idontwantCount <= 0:
        return Err[bool]("smoke: gossipsub idontwant missing")
    var ihave: PubsubControlIHave = initPubsubControlIHave()
    ihave.topic = "topic-gs"
    ihave.msgIdCount = 1
    ihave.msgIds[0] = BytesFromString("seq-unknown")
    var ihaveCtrl: PubsubControl = initPubsubControl()
    ihaveCtrl.ihaveCount = 1
    ihaveCtrl.ihaves[0] = ihave
    var ihaveRpc: PubsubRPC = initPubsubRPC()
    ihaveRpc.hasControl = true
    ihaveRpc.control = ihaveCtrl
    let writeIhaveRes: Result[bool] = writeGossipsubRpc(outStream, ihaveRpc)
    if IsErr(writeIhaveRes):
        return Err[bool](Error(writeIhaveRes))
    let handleIhaveRes: Result[bool] = gossipsubHandler(inStream)
    if IsErr(handleIhaveRes):
        return Err[bool](Error(handleIhaveRes))
    let iwantReplyRes: Result[PubsubRPC] = readGossipsubRpc(outStream)
    if IsErr(iwantReplyRes):
        return Err[bool](Error(iwantReplyRes))
    let iwantReply: PubsubRPC = Value(iwantReplyRes)
    if ! iwantReply.hasControl || iwantReply.control.iwantCount <= 0:
        return Err[bool]("smoke: gossipsub iwant control missing")
    if iwantReply.control.iwants[0].msgIdCount <= 0:
        return Err[bool]("smoke: gossipsub iwant msgid missing")
    let dupWriteRes: Result[bool] = writeGossipsubRpc(outStream, rpc)
    if IsErr(dupWriteRes):
        return Err[bool](Error(dupWriteRes))
    let dupHandleRes: Result[bool] = gossipsubHandler(inStream)
    if IsErr(dupHandleRes):
        return Err[bool](Error(dupHandleRes))
    if gossipsubNextMessage(inbox):
        return Err[bool]("smoke: gossipsub duplicate delivered")
    return Ok[bool](true)
