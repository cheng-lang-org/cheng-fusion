# DePIN orderbook smoke (runtime path on the real orderbook module).

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/depin/orderbook

fn buildDepinAskCard(peerId: str, cpuPrice: int64, gpuPrice: int64, ioPrice: int64): DepinAskCard =
    var card: DepinAskCard = initDepinAskCard()
    card.peerId = peerId
    card.askPriceCpuNano = cpuPrice
    card.askPriceGpuNano = gpuPrice
    card.askPriceIoNano = ioPrice
    return card

fn depinOrderbookListHasPeer(list: DepinAskCardList, peerId: str): bool =
    for i in 0..<list.count:
        if list.cards[i].peerId == peerId:
            return true
    return false

fn depinOrderbookChooseBest(
    list: DepinAskCardList,
    cpuMs: int64,
    gpuMs: int64,
    ioBytes: int64,
    out: var DepinAskCard
): bool =
    var found: bool
    var bestCost: int64
    for i in 0..<list.count:
        let card: DepinAskCard = list.cards[i]
        let cost: int64 = depinOrderbookExpectedCostNano(card, cpuMs, gpuMs, ioBytes)
        if ! found:
            out = card
            bestCost = cost
            found = true
            continue
        if cost < bestCost || (cost == bestCost && card.peerId < out.peerId):
            out = card
            bestCost = cost
    return found

fn runDepinOrderbookSmoke(): Result[bool] =
    depinOrderbookReset()

    if depinOrderbookTopicName() != "cheng/depin/orderbook/v1":
        return Err[bool]("depin orderbook smoke: topic mismatch")
    if depinOrderbookAskCardSchema() != "cheng-depin-ask-card/v1":
        return Err[bool]("depin orderbook smoke: schema mismatch")

    let pushARes: Result[bool] = depinOrderbookPublish(buildDepinAskCard("node-a", 3000, 10000, 700))
    if IsErr(pushARes):
        return Err[bool](Error(pushARes))
    let pushBRes: Result[bool] = depinOrderbookPublish(buildDepinAskCard("node-b", 1200, 6000, 300))
    if IsErr(pushBRes):
        return Err[bool](Error(pushBRes))

    var nextA: DepinAskCard = initDepinAskCard()
    var nextB: DepinAskCard = initDepinAskCard()
    if ! depinOrderbookNextCard(nextA):
        return Err[bool]("depin orderbook smoke: next card missing #1")
    if ! depinOrderbookNextCard(nextB):
        return Err[bool]("depin orderbook smoke: next card missing #2")
    if nextA.peerId == nextB.peerId:
        return Err[bool]("depin orderbook smoke: next card duplication")

    let snapshot: DepinAskCardList = depinOrderbookReadSnapshot(16)
    if snapshot.count < 2:
        return Err[bool]("depin orderbook smoke: snapshot count < 2")
    if ! depinOrderbookListHasPeer(snapshot, "node-a") || ! depinOrderbookListHasPeer(snapshot, "node-b"):
        return Err[bool]("depin orderbook smoke: snapshot peer convergence failed")

    var best: DepinAskCard = initDepinAskCard()
    if ! depinOrderbookChooseBest(snapshot, 1000, 2000, 32768, best):
        return Err[bool]("depin orderbook smoke: deterministic choose failed")
    if best.peerId != "node-b":
        return Err[bool]("depin orderbook smoke: unexpected best peer (expected node-b)")

    return Ok[bool](true)
