# net_sim core smoke: deterministic discrete-event network simulator.
#
# 1. Same seed twice -> identical whole-run event fingerprint.
# 2. Different seed -> different fingerprint.
# 3. 1000 packets at 200 permille loss (seed 42) -> exactly 822 delivered
#    (LCG oracle: x=(x*1103515245+12345)&0x7fffffff, keep when x%1000>=200).
# 4. Partitioned link delivers 0; after healing, delivers all.
# 5. Two-node ping-pong, 100 rounds, 1500us one-way -> virtual time 300000us.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/sim/net_sim

fn payloadFor(i: int32): Bytes =
    var out: Bytes = BytesAlloc(4)
    BytesSet(out, 0, i & 255)
    BytesSet(out, 1, (i >> 8) & 255)
    BytesSet(out, 2, (i >> 16) & 255)
    BytesSet(out, 3, (i >> 24) & 255)
    return out

fn fpMix(h: int64, v: int64): int64 =
    return (h * 1000003 + (v & 1073741823)) & 1073741823

# Returns -1 when delivery times regress (heap order violation).
fn fingerprintDeliveries(): int64 =
    var h: int64
    var lastTime: int64
    var d: net_sim.SimDelivery
    while SimNextDeliveryGlobal(d):
        if d.time < lastTime:
            return -1
        lastTime = d.time
        h = fpMix(h, d.time)
        h = fpMix(h, int64(d.src))
        h = fpMix(h, int64(d.dst))
        let plen: int32 = BytesLen(d.payload)
        h = fpMix(h, int64(plen))
        for j in 0..<plen:
            h = fpMix(h, int64(BytesGet(d.payload, j)))
    return h

# Three nodes, lossy + jittery directed links, 120 messages round-robin.
fn runScenario(seed: int64): int64 =
    SimNew(seed)
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    let c: int32 = SimAddNode()
    SimSetLink(a, b, 1000, 300, 100)
    SimSetLink(b, a, 900, 200, 50)
    SimSetLink(b, c, 1100, 400, 150)
    SimSetLink(c, a, 800, 250, 80)
    for i in 0..<120:
        if i % 3 == 0:
            SimSend(a, b, payloadFor(i))
        elif i % 3 == 1:
            SimSend(b, c, payloadFor(i))
        else:
            SimSend(c, a, payloadFor(i))
    SimRun()
    return fingerprintDeliveries()

fn testFingerprint(): int32 =
    let fpA: int64 = runScenario(7)
    let fpB: int64 = runScenario(7)
    let fpC: int64 = runScenario(8)
    echo(Fmt"netsim 1+2 fingerprint seed7a={fpA} seed7b={fpB} seed8={fpC}")
    if fpA < 0 || fpC < 0:
        echo("netsim FAIL: delivery times not monotonic")
        return 1
    if fpA != fpB:
        echo("netsim FAIL: same-seed fingerprint mismatch")
        return 1
    if fpA == fpC:
        echo("netsim FAIL: different-seed fingerprint identical")
        return 1
    echo("netsim ok 1+2: deterministic fingerprint")
    return 0

fn testLossExact(): int32 =
    SimNew(42)
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    let cfgRes: Result[bool] = SimSetLink(a, b, 5, 0, 200)
    if IsErr(cfgRes):
        echo("netsim FAIL: loss setlink")
        return 1
    var scheduled: int32
    for i in 0..<1000:
        let sendRes: Result[bool] = SimSend(a, b, payloadFor(i))
        if IsErr(sendRes):
            echo("netsim FAIL: loss send error")
            return 1
        if Value(sendRes):
            scheduled = scheduled + 1
    SimRun()
    let delivered: int64 = SimDeliveredCount()
    echo(Fmt"netsim 3 loss scheduled={scheduled} delivered={delivered}")
    if delivered != 822:
        echo("netsim FAIL: loss delivered count != 822")
        return 1
    if int64(scheduled) != delivered:
        echo("netsim FAIL: scheduled/delivered mismatch")
        return 1
    var walked: int32
    var lastIdx: int32 = -1
    var d: net_sim.SimDelivery
    while SimNextDelivery(b, d):
        if BytesLen(d.payload) != 4:
            echo("netsim FAIL: loss payload length")
            return 1
        let pidx: int32 = BytesGet(d.payload, 0) | (BytesGet(d.payload, 1) << 8) | (BytesGet(d.payload, 2) << 16) | (BytesGet(d.payload, 3) << 24)
        if pidx <= lastIdx:
            echo("netsim FAIL: per-node delivery order")
            return 1
        lastIdx = pidx
        walked = walked + 1
    if walked != 822:
        echo("netsim FAIL: per-node walk count != 822")
        return 1
    echo("netsim ok 3: exact loss count and per-node FIFO order")
    return 0

fn testPartition(): int32 =
    SimNew(5)
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    let cfgRes: Result[bool] = SimSetLink(a, b, 10, 0, 0)
    if IsErr(cfgRes):
        echo("netsim FAIL: partition setlink")
        return 1
    let cutRes: Result[bool] = SimSetPartitioned(a, b, true)
    if IsErr(cutRes):
        echo("netsim FAIL: partition set")
        return 1
    for i in 0..<50:
        let sendRes: Result[bool] = SimSend(a, b, payloadFor(i))
        if IsErr(sendRes) || Value(sendRes):
            echo("netsim FAIL: partitioned send not dropped")
            return 1
    SimRun()
    let cutDelivered: int64 = SimDeliveredCount()
    if cutDelivered != 0 || SimPendingCount() != 0:
        echo("netsim FAIL: partition leaked packets")
        return 1
    let healRes: Result[bool] = SimSetPartitioned(a, b, false)
    if IsErr(healRes):
        echo("netsim FAIL: partition heal")
        return 1
    for i in 0..<50:
        let sendRes: Result[bool] = SimSend(a, b, payloadFor(i))
        if IsErr(sendRes) || ! Value(sendRes):
            echo("netsim FAIL: healed send rejected")
            return 1
    SimRun()
    let healedDelivered: int64 = SimDeliveredCount()
    echo(Fmt"netsim 4 partition cut={cutDelivered} healed={healedDelivered}")
    if healedDelivered != 50:
        echo("netsim FAIL: healed delivered count != 50")
        return 1
    echo("netsim ok 4: partition cut and recovery")
    return 0

# Pump loop lives in its own function: keeping `var d` inside an outer
# while-loop body puts the payload field projection on the outer back edge,
# which the ownership checker rejects (parent liveness lost at the merge).
fn pumpPingPongDeliveries(a: int32, b: int32, pongs: var int32) =
    var d: net_sim.SimDelivery
    while SimNextDeliveryGlobal(d):
        if d.dst == b:
            SimSend(b, a, BytesSlice(d.payload, 0, BytesLen(d.payload)))
        else:
            pongs = pongs + 1
            if pongs < 100:
                SimSend(a, b, BytesSlice(d.payload, 0, BytesLen(d.payload)))

fn testPingPong(): int32 =
    SimNew(1)
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    SimSetLink(a, b, 1500, 0, 0)
    SimSetLink(b, a, 1500, 0, 0)
    let firstRes: Result[bool] = SimSend(a, b, payloadFor(0))
    if IsErr(firstRes) || ! Value(firstRes):
        echo("netsim FAIL: pingpong first send")
        return 1
    var pongs: int32
    var more: bool = SimStep()
    while more:
        pumpPingPongDeliveries(a, b, pongs)
        more = SimStep()
    let elapsed: int64 = SimNow()
    echo(Fmt"netsim 5 pingpong pongs={pongs} elapsedUs={elapsed}")
    if pongs != 100:
        echo("netsim FAIL: pingpong rounds != 100")
        return 1
    if elapsed != 300000:
        echo("netsim FAIL: pingpong virtual time != 300000")
        return 1
    echo("netsim ok 5: pingpong exact virtual time")
    return 0

fn main(): int32 =
    if testFingerprint() != 0:
        return 1
    if testLossExact() != 0:
        return 1
    if testPartition() != 0:
        return 1
    if testPingPong() != 0:
        return 1
    echo("netsim core smoke: all 5 checks passed")
    return 0
