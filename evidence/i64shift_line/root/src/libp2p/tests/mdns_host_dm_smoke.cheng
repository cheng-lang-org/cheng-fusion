# mDNS -> host -> QUIC direct -> DM closed-loop smoke test.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/discovery/mdns
import cheng/libp2p/main
import cheng/libp2p/muxers/muxer
import cheng/libp2p/stream/lpstream
import cheng/libp2p/multistream
import cheng/libp2p/protocols/dm/dmservice
fn dmEchoHandler(req: DmRequest): DmResponse =
    var resp: DmResponse = initDmResponse()
    resp.ok = true
    resp.message = "echo:" + req.text
    return resp

fn multistreamSelectPair(dialer: var Stream, responder: var Stream, proto: str): Result[bool] =
    if len(proto) <= 0:
        return Err[bool]("multistream: empty protocol")
    let hello: str = ensureLine(codecV1)
    let helloWriteRes: Result[int32] = writeLp(dialer, hello)
    if IsErr(helloWriteRes):
        return Err[bool](Error(helloWriteRes))
    let reqRes: Result[Bytes] = readLp(responder, msgSize)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: str = BytesToString(Value(reqRes))
    let reqTrimRes: Result[str] = trimLine(req)
    if IsErr(reqTrimRes):
        return Err[bool](Error(reqTrimRes))
    let reqLine: str = Value(reqTrimRes)
    if (reqLine != codecV1) && (reqLine != codecV2):
        let naRes: Result[int32] = writeLp(responder, na)
        if IsErr(naRes):
            return Err[bool](Error(naRes))
        return Err[bool]("multistream: unsupported handshake")
    let respRes: Result[int32] = writeLp(responder, ensureLine(codecV1))
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let dialerRespRes: Result[Bytes] = readLp(dialer, msgSize)
    if IsErr(dialerRespRes):
        return Err[bool](Error(dialerRespRes))
    let dialerResp: str = BytesToString(Value(dialerRespRes))
    let dialerTrimRes: Result[str] = trimLine(dialerResp)
    if IsErr(dialerTrimRes):
        return Err[bool](Error(dialerTrimRes))
    if (Value(dialerTrimRes) != codecV1):
        return Err[bool]("multistream: handshake failed")
    let protoLine: str = ensureLine(proto)
    let protoWriteRes: Result[int32] = writeLp(dialer, protoLine)
    if IsErr(protoWriteRes):
        return Err[bool](Error(protoWriteRes))
    let protoReqRes: Result[Bytes] = readLp(responder, msgSize)
    if IsErr(protoReqRes):
        return Err[bool](Error(protoReqRes))
    let protoReq: str = BytesToString(Value(protoReqRes))
    let protoTrimRes: Result[str] = trimLine(protoReq)
    if IsErr(protoTrimRes):
        return Err[bool](Error(protoTrimRes))
    if (Value(protoTrimRes) != proto):
        let naRes: Result[int32] = writeLp(responder, na)
        if IsErr(naRes):
            return Err[bool](Error(naRes))
        return Err[bool]("multistream: protocol rejected")
    let ackRes: Result[int32] = writeLp(responder, ensureLine(proto))
    if IsErr(ackRes):
        return Err[bool](Error(ackRes))
    let dialerAckRes: Result[Bytes] = readLp(dialer, msgSize)
    if IsErr(dialerAckRes):
        return Err[bool](Error(dialerAckRes))
    let dialerAck: str = BytesToString(Value(dialerAckRes))
    let ackTrimRes: Result[str] = trimLine(dialerAck)
    if IsErr(ackTrimRes):
        return Err[bool](Error(ackTrimRes))
    if (Value(ackTrimRes) != proto):
        return Err[bool]("multistream: unexpected response")
    return Ok[bool](true)

fn runMdnsHostDmSmoke(): Result[bool] =
    var cfg: MdnsConfig = initMdnsConfig()
    cfg.enableNetwork = false
    cfg.bindPort = 5535
    cfg.queryTimeoutMs = 50
    setMdnsConfig(cfg)
    setMdnsState(initMdnsState())

    let hostARes: Result[Switch] = newHostWithAddressText("/ip4/127.0.0.1/udp/4021/quic-v1")
    if IsErr(hostARes):
        return Err[bool](Error(hostARes))
    var hostA: Switch = Value(hostARes)
    let hostBRes: Result[Switch] = newHostWithAddressText("/ip4/127.0.0.1/udp/4022/quic-v1")
    if IsErr(hostBRes):
        return Err[bool](Error(hostBRes))
    var hostB: Switch = Value(hostBRes)

    let startARes: Result[bool] = hostStart(hostA)
    if IsErr(startARes):
        return Err[bool](Error(startARes))
    let startBRes: Result[bool] = hostStart(hostB)
    if IsErr(startBRes):
        return Err[bool](Error(startBRes))

    let advRes: Result[bool] = hostMdnsAdvertise(hostA, "dm", "local")
    if IsErr(advRes):
        return Err[bool](Error(advRes))
    let discRes: Result[int32] = hostMdnsDiscover(hostB, "dm", "local", 4)
    if IsErr(discRes):
        return Err[bool](Error(discRes))
    if Value(discRes) <= 0:
        return Err[bool]("smoke: mdns host discovery empty")
    let peerText: str = hostPeerIdText(hostA)
    let hasPeerRes: Result[bool] = hostHasPeerText(hostB, peerText)
    if IsErr(hasPeerRes):
        return Err[bool](Error(hasPeerRes))
    if !Value(hasPeerRes):
        return Err[bool]("smoke: mdns host peer missing")

    let muxRes: Result[Muxer] = hostDialPeer(hostB, hostPeerId(hostA))
    if IsErr(muxRes):
        return Err[bool](Error(muxRes))
    var outboundMux: Muxer = Value(muxRes)
    let acceptRes: Result[Muxer] = hostAccept(hostA)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    let selectRes: Result[bool] = multistreamSelectPair(outStream, inStream, dMCodec)
    if IsErr(selectRes):
        return Err[bool](Error(selectRes))

    setDmHandler(dmEchoHandler)
    var req: DmRequest = initDmRequest()
    req.text = "ping"
    let writeRes: Result[bool] = writeDmRequest(outStream, req)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = dmHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let respRes: Result[DmResponse] = readDmResponse(outStream)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: DmResponse = Value(respRes)
    if !resp.ok || (resp.message != "echo:ping"):
        return Err[bool]("smoke: dm response mismatch")

    setDmHandler(defaultDmHandler)
    let closeOutRes: Result[bool] = closeStream(outStream)
    if IsErr(closeOutRes):
        return Err[bool](Error(closeOutRes))
    let closeInRes: Result[bool] = closeStream(inStream)
    if IsErr(closeInRes):
        return Err[bool](Error(closeInRes))
    closeMuxer(outboundMux)
    closeMuxer(inboundMux)
    hostStop(hostB)
    hostStop(hostA)
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runMdnsHostDmSmoke()
    if IsErr(res):
        echo("mdns host dm smoke failed: " + Error(res))
        return 1
    echo("mdns host dm smoke ok")
    return 0
