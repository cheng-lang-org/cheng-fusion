# net_sim qconn smoke: real qconn Connection/stream interface over the
# deterministic simulator pipe (Wave 0 batch 3, sim idx dispatch in
# src/quic/connection.cheng).
#
# 1. Two sim-backed stream pairs on one sim pipe idx, interleaved chunked
#    writes both directions through qconn.connWrite/connRead: per-stream
#    FIFO byte-exact; nonblocking empty contract surfaces "pipe: empty".
# 2. The same operation sequence over an in-process pipe pair
#    (qconn.newConnectionPair) and a sim pair yields identical read bytes
#    (qconn semantic equivalence across pipe backends).
# 3. 20ms link: one blocking qconn read advances virtual time to exactly
#    20000us, the roundtrip to 40000us; ConnClose propagates to the peer
#    endpoint via connIsOpen (pipeIsClosed sim dispatch).

import std/result
import std/rawbytes
import cheng/quic/multiaddress as qaddr
import cheng/quic/connection as qconn
import cheng/libp2p/sim/net_sim
import cheng/libp2p/sim/net_sim_pipe as simpipe

fn genData(tag: int32, total: int32): Bytes =
    var out: Bytes = BytesAlloc(total)
    for i in 0..<total:
        BytesSet(out, i, (tag * 29 + i * 7 + 3) & 255)
    return out

fn simAddr(text: str): qaddr.MultiAddress =
    var out: qaddr.MultiAddress
    out.raw = text
    out.data = BytesFromString(text)
    return out

# Blocking chunked reads through the qconn interface, byte-exact compare.
fn readCompare(conn: var qconn.Connection, expected: Bytes): int32 =
    var off: int32
    var k: int32
    let total: int32 = BytesLen(expected)
    while off < total:
        var n: int32 = k % 5 + 1
        if n > total - off:
            n = total - off
        let res: Result[Bytes] = qconn.connRead(conn, n)
        if IsErr(res):
            let err: str = ErrorText(res)
            echo(Fmt"qconn sim FAIL: readCompare err {err}")
            return 1
        let got: Bytes = Value(res)
        if BytesLen(got) != n:
            echo("qconn sim FAIL: readCompare short read")
            return 1
        if ! BytesEqual(got, BytesSlice(expected, off, n)):
            echo(Fmt"qconn sim FAIL: readCompare bytes mismatch off={off} n={n}")
            return 1
        off = off + n
        k = k + 1
    return 0

fn expectEmptyNonblocking(conn: var qconn.Connection): int32 =
    let res: Result[Bytes] = qconn.connReadNonblocking(conn, 1)
    if ! IsErr(res):
        echo("qconn sim FAIL: expected empty nonblocking read")
        return 1
    let err: str = ErrorText(res)
    if err != "pipe: empty":
        echo(Fmt"qconn sim FAIL: expected pipe-empty, got {err}")
        return 1
    return 0

fn testQconnDualStreamFifo(): int32 =
    SimNew(31)
    simpipe.SimPipeReset()
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    SimSetLink(a, b, 1000, 0, 0)
    SimSetLink(b, a, 700, 0, 0)
    let openRes: Result[int32] = simpipe.SimPipeOpen(a, b)
    if IsErr(openRes):
        echo("qconn sim FAIL: pipe open")
        return 1
    let simIdx: int32 = Value(openRes)
    let addr: qaddr.MultiAddress = simAddr("/sim/31")
    let pair4Res = qconn.newSimConnectionPairForStreams(addr, addr, addr, addr, simIdx, 4, 4, 4, 4)
    if IsErr(pair4Res):
        echo("qconn sim FAIL: pair stream4")
        return 1
    var client4 = Value(pair4Res).outbound
    var server4 = Value(pair4Res).inbound
    let pair9Res = qconn.newSimConnectionPairForStreams(addr, addr, addr, addr, simIdx, 9, 9, 9, 9)
    if IsErr(pair9Res):
        echo("qconn sim FAIL: pair stream9")
        return 1
    var client9 = Value(pair9Res).outbound
    var server9 = Value(pair9Res).inbound
    let fwd4: Bytes = genData(1, 137)
    let fwd9: Bytes = genData(2, 101)
    let rev4: Bytes = genData(3, 53)
    let total4: int32 = BytesLen(fwd4)
    let total9: int32 = BytesLen(fwd9)
    var off4: int32
    var off9: int32
    var k: int32
    while off4 < total4 || off9 < total9:
        var pick4: bool = (k & 1) == 0
        if off4 >= total4:
            pick4 = false
        if off9 >= total9:
            pick4 = true
        if pick4:
            var n: int32 = k % 7 + 1
            if n > total4 - off4:
                n = total4 - off4
            let wRes: Result[int32] = qconn.connWrite(client4, BytesSlice(fwd4, off4, n))
            if IsErr(wRes) || Value(wRes) != n:
                echo("qconn sim FAIL: interleaved write stream4")
                return 1
            off4 = off4 + n
        else:
            var n: int32 = k % 4 + 2
            if n > total9 - off9:
                n = total9 - off9
            let wRes: Result[int32] = qconn.connWrite(client9, BytesSlice(fwd9, off9, n))
            if IsErr(wRes) || Value(wRes) != n:
                echo("qconn sim FAIL: interleaved write stream9")
                return 1
            off9 = off9 + n
        k = k + 1
    # Reverse direction reuses stream id 4: must stay isolated from forward.
    let wRevRes: Result[int32] = qconn.connWrite(server4, rev4)
    if IsErr(wRevRes) || Value(wRevRes) != BytesLen(rev4):
        echo("qconn sim FAIL: reverse write stream4")
        return 1
    if readCompare(server4, fwd4) != 0:
        return 1
    if readCompare(server9, fwd9) != 0:
        return 1
    if readCompare(client4, rev4) != 0:
        return 1
    if expectEmptyNonblocking(server4) != 0:
        return 1
    if expectEmptyNonblocking(server9) != 0:
        return 1
    if expectEmptyNonblocking(client4) != 0:
        return 1
    echo("qconn sim ok 1: dual-stream interleaved FIFO byte-exact via qconn")
    return 0

# One fixed operation sequence; collects every byte read on both endpoints.
fn runScenario(client: var qconn.Connection, server: var qconn.Connection, collected: var Bytes): int32 =
    for r in 0..<16:
        let fwdLen: int32 = r % 7 + 1
        let fwd: Bytes = genData(r + 10, fwdLen)
        let wRes: Result[int32] = qconn.connWrite(client, fwd)
        if IsErr(wRes) || Value(wRes) != fwdLen:
            return 1
        let rRes: Result[Bytes] = qconn.connRead(server, fwdLen)
        if IsErr(rRes):
            return 1
        let got: Bytes = Value(rRes)
        if BytesLen(got) != fwdLen || ! BytesEqual(got, fwd):
            return 1
        collected = BytesConcat(collected, got)
        let revLen: int32 = r % 5 + 2
        let rev: Bytes = genData(r + 40, revLen)
        let wRes2: Result[int32] = qconn.connWrite(server, rev)
        if IsErr(wRes2) || Value(wRes2) != revLen:
            return 1
        let rRes2: Result[Bytes] = qconn.connRead(client, revLen)
        if IsErr(rRes2):
            return 1
        let got2: Bytes = Value(rRes2)
        if BytesLen(got2) != revLen || ! BytesEqual(got2, rev):
            return 1
        collected = BytesConcat(collected, got2)
    return 0

fn testBackendEquivalence(): int32 =
    # Run 1: in-process pipe pair.
    let inprocAddr: qaddr.MultiAddress = simAddr("/inproc/0")
    let inprocRes = qconn.newConnectionPair(inprocAddr, inprocAddr, inprocAddr, inprocAddr)
    if IsErr(inprocRes):
        echo("qconn sim FAIL: inproc pair")
        return 1
    var inprocClient = Value(inprocRes).outbound
    var inprocServer = Value(inprocRes).inbound
    var inprocBytes: Bytes = emptyBytes()
    if runScenario(inprocClient, inprocServer, inprocBytes) != 0:
        echo("qconn sim FAIL: inproc scenario")
        return 1
    # Run 2: sim pipe pair, same operation sequence.
    SimNew(5)
    simpipe.SimPipeReset()
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    SimSetLink(a, b, 500, 0, 0)
    SimSetLink(b, a, 300, 0, 0)
    let openRes: Result[int32] = simpipe.SimPipeOpen(a, b)
    if IsErr(openRes):
        echo("qconn sim FAIL: equivalence pipe open")
        return 1
    let simIdx: int32 = Value(openRes)
    let addr: qaddr.MultiAddress = simAddr("/sim/5")
    let pairRes = qconn.newSimConnectionPairForStreams(addr, addr, addr, addr, simIdx, 2, 2, 2, 2)
    if IsErr(pairRes):
        echo("qconn sim FAIL: equivalence sim pair")
        return 1
    var simClient = Value(pairRes).outbound
    var simServer = Value(pairRes).inbound
    var simBytes: Bytes = emptyBytes()
    if runScenario(simClient, simServer, simBytes) != 0:
        echo("qconn sim FAIL: sim scenario")
        return 1
    let inprocLen: int32 = BytesLen(inprocBytes)
    let simLen: int32 = BytesLen(simBytes)
    if inprocLen != simLen:
        echo(Fmt"qconn sim FAIL: equivalence length inproc={inprocLen} sim={simLen}")
        return 1
    if ! BytesEqual(inprocBytes, simBytes):
        echo("qconn sim FAIL: equivalence byte sequence mismatch")
        return 1
    echo(Fmt"qconn sim ok 2: inproc/sim identical read sequence bytes={simLen}")
    return 0

fn testLatencyVirtualTime(): int32 =
    SimNew(9)
    simpipe.SimPipeReset()
    let a: int32 = SimAddNode()
    let b: int32 = SimAddNode()
    SimSetLink(a, b, 20000, 0, 0)
    SimSetLink(b, a, 20000, 0, 0)
    let openRes: Result[int32] = simpipe.SimPipeOpen(a, b)
    if IsErr(openRes):
        echo("qconn sim FAIL: latency pipe open")
        return 1
    let simIdx: int32 = Value(openRes)
    let addr: qaddr.MultiAddress = simAddr("/sim/9")
    let pairRes = qconn.newSimConnectionPairForStreams(addr, addr, addr, addr, simIdx, 1, 1, 1, 1)
    if IsErr(pairRes):
        echo("qconn sim FAIL: latency pair")
        return 1
    var client = Value(pairRes).outbound
    var server = Value(pairRes).inbound
    if SimNow() != 0:
        echo("qconn sim FAIL: latency clock not at zero")
        return 1
    let ping: Bytes = genData(6, 8)
    let wRes: Result[int32] = qconn.connWrite(client, ping)
    if IsErr(wRes) || Value(wRes) != 8:
        echo("qconn sim FAIL: latency ping write")
        return 1
    let rRes: Result[Bytes] = qconn.connRead(server, 8)
    if IsErr(rRes) || ! BytesEqual(Value(rRes), ping):
        echo("qconn sim FAIL: latency ping read")
        return 1
    let oneWayUs: int64 = SimNow()
    if oneWayUs != 20000:
        echo(Fmt"qconn sim FAIL: one-way virtual time {oneWayUs} != 20000")
        return 1
    let pong: Bytes = genData(7, 8)
    let wRes2: Result[int32] = qconn.connWrite(server, pong)
    if IsErr(wRes2) || Value(wRes2) != 8:
        echo("qconn sim FAIL: latency pong write")
        return 1
    let rRes2: Result[Bytes] = qconn.connRead(client, 8)
    if IsErr(rRes2) || ! BytesEqual(Value(rRes2), pong):
        echo("qconn sim FAIL: latency pong read")
        return 1
    let roundTripUs: int64 = SimNow()
    if roundTripUs != 40000:
        echo(Fmt"qconn sim FAIL: roundtrip virtual time {roundTripUs} != 40000")
        return 1
    echo(Fmt"qconn sim 3 latency oneWayUs={oneWayUs} roundTripUs={roundTripUs}")
    # ConnClose on one endpoint closes the shared sim pipe: peer sees it
    # through connIsOpen (pipeIsClosed sim dispatch).
    if ! qconn.connIsOpen(client) || ! qconn.connIsOpen(server):
        echo("qconn sim FAIL: latency conns not open before close")
        return 1
    qconn.ConnClose(client)
    if qconn.connIsOpen(client):
        echo("qconn sim FAIL: closed client still open")
        return 1
    if qconn.connIsOpen(server):
        echo("qconn sim FAIL: peer open after shared pipe close")
        return 1
    echo("qconn sim ok 3: 20ms link exact virtual time, close propagates")
    return 0

fn main(): int32 =
    if testQconnDualStreamFifo() != 0:
        return 1
    if testBackendEquivalence() != 0:
        return 1
    if testLatencyVirtualTime() != 0:
        return 1
    echo("netsim qconn smoke: all 3 checks passed")
    return 0
