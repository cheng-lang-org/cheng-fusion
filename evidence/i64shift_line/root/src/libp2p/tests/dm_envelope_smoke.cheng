# DM envelope smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
import cheng/libp2p/protocols/dm/dmenvelope
fn dmEnvelopeEchoHandler(req: DmEnvelope): DmEnvelope =
    var resp: DmEnvelope = initDmEnvelope()
    resp.id = req.id
    resp.kind = dmEnvelopeKindResponse
    resp.ok = true
    resp.text = "echo:" + req.text
    resp.payload = req.payload
    return resp

fn runDmEnvelopeSmoke(): Result[bool] =
    let addrARes: Result[MultiAddress] = parseMultiAddress("/memory/32")
    if IsErr(addrARes):
        return Err[bool](Error(addrARes))
    let addrBRes: Result[MultiAddress] = parseMultiAddress("/memory/33")
    if IsErr(addrBRes):
        return Err[bool](Error(addrBRes))
    let pairRes: Result[ConnectionPair] =
        newConnectionPair(Value(addrARes), Value(addrBRes), Value(addrBRes), Value(addrARes))
    if IsErr(pairRes):
        return Err[bool](Error(pairRes))
    var pair: ConnectionPair = Value(pairRes)
    var outboundMux: Muxer = newMuxer(pair.outbound)
    if outboundMux.id < 0:
        return Err[bool]("smoke: muxer allocate failed")
    var inboundMux: Muxer = newMuxer(pair.inbound)
    if inboundMux.id < 0:
        closeMuxer(outboundMux)
        return Err[bool]("smoke: muxer allocate failed")
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)

    setDmEnvelopeHandler(dmEnvelopeEchoHandler)
    var env: DmEnvelope = initDmEnvelope()
    env.id = 7
    env.kind = dmEnvelopeKindRequest
    env.text = "ping"
    env.payload = BytesFromString("payload")
    let writeRes: Result[bool] = writeDmEnvelope(outStream, env)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = dmEnvelopeHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let respRes: Result[DmEnvelope] = readDmEnvelope(outStream)
    if IsErr(respRes):
        closeStream(inStream)
        closeStream(outStream)
        closeMuxer(outboundMux)
        closeMuxer(inboundMux)
        return Err[bool](Error(respRes))
    let resp: DmEnvelope = Value(respRes)
    if resp.id != 7 || resp.kind != dmEnvelopeKindResponse || ! resp.ok:
        closeStream(inStream)
        closeStream(outStream)
        closeMuxer(outboundMux)
        closeMuxer(inboundMux)
        return Err[bool]("smoke: dm envelope response invalid")
    if (resp.text != "echo:ping"):
        closeStream(inStream)
        closeStream(outStream)
        closeMuxer(outboundMux)
        closeMuxer(inboundMux)
        return Err[bool]("smoke: dm envelope text mismatch")
    if ! BytesEqual(resp.payload, env.payload):
        closeStream(inStream)
        closeStream(outStream)
        closeMuxer(outboundMux)
        closeMuxer(inboundMux)
        return Err[bool]("smoke: dm envelope payload mismatch")
    setDmEnvelopeHandler(defaultDmEnvelopeHandler)
    closeStream(inStream)
    closeStream(outStream)
    closeMuxer(outboundMux)
    closeMuxer(inboundMux)
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runDmEnvelopeSmoke()
    if IsErr(res):
        echo("dm envelope smoke failed: " + Error(res))
        return 1
    echo("dm envelope smoke ok")
    return 0
