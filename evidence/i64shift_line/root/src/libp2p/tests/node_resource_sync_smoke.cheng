# Node resource protocol + totals sync smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/heartbeat
import cheng/libp2p/utils/stringlist
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/peerinfo
import cheng/libp2p/peerstore
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
import cheng/libp2p/protocols/noderesource/noderesource
import cheng/libp2p/protocols/noderesource/protobuf
import cheng/libp2p/main as lp
import cheng/libp2p/tests/test_multistream
var
    nodeResourceTestInfo: NodeResourceInfo = initNodeResourceInfo()

fn nodeResourceTestHandler(req: NodeResourceRequest): NodeResourceResponse =
    var resp: NodeResourceResponse = initNodeResourceResponse()
    resp.ok = true
    resp.message = "ok"
    resp.requestId = req.requestId
    resp.info = nodeResourceTestInfo
    resp.hasInfo = true
    return resp

const
    nodeResourceSyncDefaultIntervalMs = 30000
    nodeResourceSyncDefaultSelfIntervalMs = 15000
    nodeResourceSyncDefaultPeerLimit = 8

type
    NodeResourceSyncConfig =
        enabled: bool
        intervalMs: int64
        selfIntervalMs: int64
        peerLimit: int32
        requireProtocol: bool

    NodeResourceSyncState =
        config: NodeResourceSyncConfig
        peerBeat: Heartbeat
        selfBeat: Heartbeat
        cursor: int32

fn initNodeResourceSyncConfig(): NodeResourceSyncConfig =
    NodeResourceSyncConfig(
        enabled: true,
        intervalMs: nodeResourceSyncDefaultIntervalMs,
        selfIntervalMs: nodeResourceSyncDefaultSelfIntervalMs,
        peerLimit: nodeResourceSyncDefaultPeerLimit,
        requireProtocol: true
    )

fn initNodeResourceSyncState(cfg: NodeResourceSyncConfig): Result[NodeResourceSyncState] =
    if cfg.intervalMs <= 0 || cfg.selfIntervalMs <= 0:
        return Err[NodeResourceSyncState]("node resource sync: interval must be positive")
    let peerBeatRes: Result[Heartbeat] = initHeartbeat(cfg.intervalMs)
    if IsErr(peerBeatRes):
        return Err[NodeResourceSyncState](Error(peerBeatRes))
    let selfBeatRes: Result[Heartbeat] = initHeartbeat(cfg.selfIntervalMs)
    if IsErr(selfBeatRes):
        return Err[NodeResourceSyncState](Error(selfBeatRes))
    return Ok[NodeResourceSyncState](
        NodeResourceSyncState(
            config: cfg,
            peerBeat: Value(peerBeatRes),
            selfBeat: Value(selfBeatRes),
            cursor: 0
        )
    )

fn nodeResourceQueryPeerOnMuxer(outMux: var Muxer, inMux: var Muxer): Result[NodeResourceInfo] =
    let outStreamRes: Result[Stream] = openStream(outMux)
    if IsErr(outStreamRes):
        return Err[NodeResourceInfo](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inMux)
    if IsErr(inStreamRes):
        closeStream(outStream)
        return Err[NodeResourceInfo](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    let selRes: Result[bool] = multistreamSelectPair(outStream, inStream, nodeResourceCodec)
    if IsErr(selRes):
        closeStream(outStream)
        closeStream(inStream)
        return Err[NodeResourceInfo](Error(selRes))
    var req: NodeResourceRequest = initNodeResourceRequest()
    req.requestId = nodeResourceNextRequestId()
    let writeRes: Result[bool] = writeNodeResourceRequest(outStream, req)
    if IsErr(writeRes):
        closeStream(outStream)
        closeStream(inStream)
        return Err[NodeResourceInfo](Error(writeRes))
    let handleRes: Result[bool] = nodeResourceHandler(inStream)
    if IsErr(handleRes):
        closeStream(outStream)
        return Err[NodeResourceInfo](Error(handleRes))
    closeStream(inStream)
    let respRes: Result[NodeResourceResponse] = readNodeResourceResponse(outStream)
    if IsErr(respRes):
        closeStream(outStream)
        return Err[NodeResourceInfo](Error(respRes))
    closeStream(outStream)
    let resp: NodeResourceResponse = Value(respRes)
    if ! resp.ok:
        let msg: str = if len(resp.message) > 0: resp.message else: "node resource: ! ok"
        return Err[NodeResourceInfo](msg)
    if ! resp.hasInfo:
        return Err[NodeResourceInfo]("node resource: missing info")
    return Ok[NodeResourceInfo](resp.info)

fn nodeResourceUpdateAll(
    store: PeerStore,
    selfId: PeerId,
    targetId: PeerId,
    outMux: var Muxer,
    inMux: var Muxer,
    limit: int32
): Result[int32] =
    let selfRes: Result[bool] = nodeResourceUpdateSelf(selfId)
    if IsErr(selfRes):
        return Err[int32](Error(selfRes))
    let listRes: Result[StringList] = listPeerIds(store)
    if IsErr(listRes):
        return Err[int32](Error(listRes))
    var list: StringList = Value(listRes)
    var updated: int32
    for i in 0..<list.count:
        if ! (i < list.count):
            break
        if limit > 0 && updated >= limit:
            break
        let pidRes: Result[PeerId] = parsePeerId(list.items[i])
        if IsErr(pidRes):
            continue
        let pid: PeerId = Value(pidRes)
        let eqRes: Result[bool] = peerIdEqual(pid, selfId)
        if IsErr(eqRes):
            return Err[int32](Error(eqRes))
        if Value(eqRes):
            continue
        let targetRes: Result[bool] = peerIdEqual(pid, targetId)
        if IsErr(targetRes):
            return Err[int32](Error(targetRes))
        if ! Value(targetRes):
            continue
        let infoRes: Result[NodeResourceInfo] = nodeResourceQueryPeerOnMuxer(outMux, inMux)
        if IsOk(infoRes):
            let updateRes: Result[bool] = nodeResourceUpdatePeer(pid, Value(infoRes))
            if IsErr(updateRes):
                return Err[int32](Error(updateRes))
            updated = updated + 1
    return Ok[int32](updated)

fn nodeResourceSyncTickSmoke(
    store: PeerStore,
    selfId: PeerId,
    targetId: PeerId,
    outMux: var Muxer,
    inMux: var Muxer,
    state: var NodeResourceSyncState
): Result[int32] =
    if ! state.config.enabled:
        return Ok[int32](0)
    if heartbeatTick(state.selfBeat):
        let selfRes: Result[bool] = nodeResourceUpdateSelf(selfId)
        if IsErr(selfRes):
            return Err[int32](Error(selfRes))
    if ! heartbeatTick(state.peerBeat):
        return Ok[int32](0)
    let listRes: Result[StringList] =
        if state.config.requireProtocol:
            listPeerIdsByProtocol(store, nodeResourceCodec)
        else:
            listPeerIds(store)
    if IsErr(listRes):
        return Err[int32](Error(listRes))
    var list: StringList = Value(listRes)
    if list.count <= 0:
        return Ok[int32](0)
    var limit: int32 = state.config.peerLimit
    if limit <= 0 || limit > list.count:
        limit = list.count
    var idx: int32 = state.cursor
    if idx < 0 || idx >= list.count:
        idx = 0
    var updated: int32
    for processed in 0..<list.count:
        if ! (processed < list.count && updated < limit):
            break
        let pidRes: Result[PeerId] = parsePeerId(list.items[idx])
        if IsOk(pidRes):
            let pid: PeerId = Value(pidRes)
            let eqRes: Result[bool] = peerIdEqual(pid, selfId)
            if IsErr(eqRes):
                return Err[int32](Error(eqRes))
            if ! Value(eqRes):
                let targetRes: Result[bool] = peerIdEqual(pid, targetId)
                if IsErr(targetRes):
                    return Err[int32](Error(targetRes))
                if Value(targetRes):
                    let infoRes: Result[NodeResourceInfo] = nodeResourceQueryPeerOnMuxer(outMux, inMux)
                    if IsOk(infoRes):
                        let updateRes: Result[bool] = nodeResourceUpdatePeer(pid, Value(infoRes))
                        if IsErr(updateRes):
                            return Err[int32](Error(updateRes))
                        updated = updated + 1
        idx = idx + 1
        if idx >= list.count:
            idx = 0
    state.cursor = idx
    return Ok[int32](updated)

fn runNodeResourceSyncSmoke(): Result[bool] =
    nodeResourceRegistryReset()
    var mainBadCfg = lp.initNodeResourceSyncConfig()
    mainBadCfg.intervalMs = 0
    let mainBadStateRes = lp.initNodeResourceSyncState(mainBadCfg)
    if IsOk(mainBadStateRes):
        return Err[bool]("sync smoke: main init should reject invalid interval")
    var mainCfg = lp.initNodeResourceSyncConfig()
    mainCfg.intervalMs = 1
    mainCfg.selfIntervalMs = 1
    let mainStateRes = lp.initNodeResourceSyncState(mainCfg)
    if IsErr(mainStateRes):
        return Err[bool]("sync smoke: main init failed " + Error(mainStateRes))
    let mainState = Value(mainStateRes)
    if mainState.cursor != 0:
        return Err[bool]("sync smoke: main init cursor mismatch")
    if mainState.peerBeat.intervalMs != mainCfg.intervalMs || mainState.selfBeat.intervalMs != mainCfg.selfIntervalMs:
        return Err[bool]("sync smoke: main init heartbeat mismatch")
    nodeResourceResetOverrides()
    nodeResourceOverrideOs("linux")
    nodeResourceOverrideCpuCores(8)
    nodeResourceOverrideMemoryBytes(16384)
    nodeResourceOverrideBandwidthInBytes(1234)
    nodeResourceOverrideBandwidthOutBytes(5678)
    nodeResourceOverrideGpuCount(2)
    nodeResourceOverrideGpuName("overridegpu")
    nodeResourceOverrideVramBytes(8192)
    let localInfo: NodeResourceInfo = collectNodeResourceInfo()
    if localInfo.os != "linux":
        return Err[bool]("sync smoke: local os override mismatch")
    if localInfo.cpuCores != 8:
        return Err[bool]("sync smoke: local cpu override mismatch")
    if localInfo.memoryBytes != 16384:
        return Err[bool]("sync smoke: local memory override mismatch")
    if localInfo.bandwidthInBytes != 1234 || localInfo.bandwidthOutBytes != 5678:
        return Err[bool]("sync smoke: local bandwidth override mismatch")
    if localInfo.gpuCount != 2 || localInfo.vramBytes != 8192 || (localInfo.gpuName != "overridegpu"):
        return Err[bool]("sync smoke: local gpu override mismatch")
    nodeResourceResetOverrides()

    let hostAIdRes: Result[PeerId] = randomPeerId()
    if IsErr(hostAIdRes):
        return Err[bool](Error(hostAIdRes))
    let hostBIdRes: Result[PeerId] = randomPeerId()
    if IsErr(hostBIdRes):
        return Err[bool](Error(hostBIdRes))
    let hostAId: PeerId = Value(hostAIdRes)
    let hostBId: PeerId = Value(hostBIdRes)
    let addrARes: Result[MultiAddress] = parseMultiAddress("/memory/90")
    if IsErr(addrARes):
        return Err[bool](Error(addrARes))
    let addrBRes: Result[MultiAddress] = parseMultiAddress("/memory/91")
    if IsErr(addrBRes):
        return Err[bool](Error(addrBRes))
    let pairRes: Result[ConnectionPair] =
        newConnectionPair(Value(addrARes), Value(addrBRes), Value(addrBRes), Value(addrARes))
    if IsErr(pairRes):
        return Err[bool](Error(pairRes))
    var pair: ConnectionPair = Value(pairRes)
    var outboundMux: Muxer = newMuxer(pair.outbound)
    if outboundMux.id < 0:
        return Err[bool]("sync smoke: muxer allocate failed")
    var inboundMux: Muxer = newMuxer(pair.inbound)
    if inboundMux.id < 0:
        closeMuxer(outboundMux)
        return Err[bool]("sync smoke: muxer allocate failed")
    var peerStore: PeerStore = initPeerStore()
    var hostAInfo: PeerInfo = newPeerInfo(hostAId)
    let addAddrRes: Result[bool] = addAddress(hostAInfo, Value(addrARes))
    if IsErr(addAddrRes):
        closeMuxer(outboundMux)
        closeMuxer(inboundMux)
        return Err[bool](Error(addAddrRes))
    let addProtoRes: Result[bool] = StringListAdd(hostAInfo.protocols, nodeResourceCodec)
    if IsErr(addProtoRes):
        closeMuxer(outboundMux)
        closeMuxer(inboundMux)
        return Err[bool](Error(addProtoRes))
    let mergeRes: Result[bool] = mergePeer(peerStore, hostAInfo)
    if IsErr(mergeRes):
        closeMuxer(outboundMux)
        closeMuxer(inboundMux)
        return Err[bool](Error(mergeRes))

    nodeResourceTestInfo = initNodeResourceInfo()
    nodeResourceTestInfo.os = "linux"
    nodeResourceTestInfo.cpuCores = 4
    nodeResourceTestInfo.memoryBytes = 8192
    nodeResourceTestInfo.bandwidthInBytes = 1000
    nodeResourceTestInfo.bandwidthOutBytes = 2000
    nodeResourceTestInfo.gpuCount = 1
    nodeResourceTestInfo.gpuName = "testgpu"
    nodeResourceTestInfo.vramBytes = 4096
    setNodeResourceHandler(nodeResourceTestHandler)

    let infoRes: Result[NodeResourceInfo] = nodeResourceQueryPeerOnMuxer(outboundMux, inboundMux)
    if IsErr(infoRes):
        closeMuxer(outboundMux)
        closeMuxer(inboundMux)
        return Err[bool](Error(infoRes))
    let respInfo: NodeResourceInfo = Value(infoRes)
    if respInfo.cpuCores != 4 || respInfo.memoryBytes != 8192:
        return Err[bool]("sync smoke: node resource info mismatch")

    let updateARes: Result[bool] = nodeResourceUpdatePeer(hostAId, respInfo)
    if IsErr(updateARes):
        return Err[bool](Error(updateARes))

    nodeResourceOverrideOs("linux")
    nodeResourceOverrideCpuCores(2)
    nodeResourceOverrideMemoryBytes(4096)
    nodeResourceOverrideBandwidthInBytes(500)
    nodeResourceOverrideBandwidthOutBytes(700)
    nodeResourceOverrideGpuCount(0)
    nodeResourceOverrideGpuName("")
    nodeResourceOverrideVramBytes(0)
    let updateAllRes: Result[int32] = nodeResourceUpdateAll(peerStore, hostBId, hostAId, outboundMux, inboundMux, 8)
    if IsErr(updateAllRes):
        return Err[bool](Error(updateAllRes))
    if Value(updateAllRes) <= 0:
        return Err[bool]("sync smoke: update all returned empty")

    var syncCfg: NodeResourceSyncConfig = initNodeResourceSyncConfig()
    syncCfg.intervalMs = 1
    syncCfg.selfIntervalMs = 1
    syncCfg.peerLimit = 1
    syncCfg.requireProtocol = true
    let syncStateRes: Result[NodeResourceSyncState] = initNodeResourceSyncState(syncCfg)
    if IsErr(syncStateRes):
        return Err[bool](Error(syncStateRes))
    var syncState: NodeResourceSyncState = Value(syncStateRes)
    syncState.selfBeat.lastTickMs = 0 - syncState.selfBeat.intervalMs
    syncState.peerBeat.lastTickMs = 0 - syncState.peerBeat.intervalMs
    let syncRes: Result[int32] = nodeResourceSyncTickSmoke(peerStore, hostBId, hostAId, outboundMux, inboundMux, syncState)
    if IsErr(syncRes):
        return Err[bool](Error(syncRes))
    if Value(syncRes) <= 0:
        return Err[bool]("sync smoke: sync tick returned empty")
    nodeResourceResetOverrides()

    let totals: NodeResourceTotals = nodeResourceTotals()
    if totals.nodeCount != 2:
        return Err[bool]("sync smoke: totals node count mismatch")
    if totals.cpuCores != 6 || totals.memoryBytes != 12288:
        return Err[bool]("sync smoke: totals compute mismatch")
    if totals.bandwidthInBytes != 1500 || totals.bandwidthOutBytes != 2700:
        return Err[bool]("sync smoke: totals bandwidth mismatch")
    if totals.gpuCount != 1 || totals.vramBytes != 4096:
        return Err[bool]("sync smoke: totals gpu mismatch")
    let totalsText: str = nodeResourceTotalsText()
    if len(totalsText) <= 0 || ! StrContains(totalsText, "nodes=2"):
        return Err[bool]("sync smoke: totals text missing")

    setNodeResourceHandler(defaultNodeResourceHandler)
    nodeResourceRegistryReset()
    closeMuxer(outboundMux)
    closeMuxer(inboundMux)
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runNodeResourceSyncSmoke()
    if IsErr(res):
        echo("node resource sync smoke failed:")
        echo(Error(res))
        return 1
    echo("node resource sync smoke ok")
    return 0
