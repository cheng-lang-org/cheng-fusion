# Synccast media plane smoke test(main entry).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_media_smoke
fn main(): int32 =
    let res: Result[bool] = runSynccastMediaSmoke()
    if IsErr(res):
        echo("synccast media smoke failed: " + Error(res))
        return 1
    echo("synccast media smoke ok")
    return 0

