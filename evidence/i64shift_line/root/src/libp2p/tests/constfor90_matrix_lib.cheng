import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/kademlia/consts

# Position matrix for cross-module unqualified const `idLength` (=32,
# declared in cheng/libp2p/protocols/kademlia/consts). Every function below
# is materialized via import (import_mode=1 while its body is parsed by the
# importing translation), exercising one distinct expression position each.

fn ConstFor90ForBound(): int32 =
    var cnt: int32 = 0
    for i in 0..<idLength:
        cnt = cnt + 1
    return cnt

fn ConstFor90WhileCond(): int32 =
    var i: int32 = 0
    while i < idLength:
        i = i + 1
    return i

fn ConstFor90IfCmpTrue(): int32 =
    if idLength == 32:
        return 1
    return 0

fn ConstFor90IfCmpFalse(): int32 =
    if idLength == 999:
        return 1
    return 0

fn ConstFor90Arith(): int32 =
    return idLength * 2

fn ConstFor90NestedArith(): int32 =
    let x: int32 = idLength * 2 - 1
    return x

fn ConstFor90DeclRhs(): int32 =
    let y: int32 = idLength
    return y

fn ConstFor90CallArgIdentity(v: int32): int32 =
    return v

fn ConstFor90CallArg(): int32 =
    return ConstFor90CallArgIdentity(idLength)

var
    gConstFor90Arr: int32[idLength]

fn ConstFor90ArraySize(): int32 =
    # Loop bound is a LITERAL (32), not idLength, so this isolates the
    # array-size position (`int32[idLength]` above) from the for-bound
    # position already covered by ConstFor90ForBound. If idLength resolved
    # to 0 at the array declaration, writing indices [0,32) is out of
    # bounds; if it resolved correctly the checksum below is exact.
    var i: int32 = 0
    for i in 0..<32:
        gConstFor90Arr[i] = i + 1
    var s: int32 = 0
    var j: int32 = 0
    for j in 0..<32:
        s = s + gConstFor90Arr[j]
    return s
