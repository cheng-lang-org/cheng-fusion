# Foundation mDNS discovery runner(real path).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/mdns_smoke
fn main(): int32 =
    let runRes: Result[bool] = runMdnsSmoke()
    if IsErr(runRes):
        echo("foundation mdns discovery failed")
        echo(Error(runRes))
        return 1
    echo("foundation mdns discovery ok")
    return 0
