# Kademlia smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/rand
import cheng/libp2p/multiaddress
import cheng/libp2p/peerinfo
import cheng/libp2p/peerstore
import cheng/libp2p/protocols/kademlia/keys
import cheng/libp2p/protocols/kademlia/protobuf
import cheng/libp2p/protocols/kademlia/requests
import cheng/libp2p/protocols/kademlia/kademlia
import cheng/libp2p/protocols/kademlia
import cheng/libp2p/switch
import cheng/libp2p/builders
fn kadPeerListContains(peers: KadPeer[maxKadPeers], count: int32, pid: PeerId): bool =
    let bytesRes: Result[Bytes] = toBytes(pid)
    if IsErr(bytesRes):
        return false
    let pidBytes: Bytes = Value(bytesRes)
    for i in 0..<count:
        if BytesEqual(peers[i].id, pidBytes):
            return true
    return false

fn runKademliaSmoke(): Result[bool] =
    setRandomSeed(BytesFromString("cheng-libp2p-kad-smoke"))
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/7")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let otherRes: Result[PeerId] = randomPeerId()
    if IsErr(otherRes):
        return Err[bool](Error(otherRes))
    let otherId: PeerId = Value(otherRes)
    var otherInfo: PeerInfo = newPeerInfo(otherId)
    let otherAddrRes: Result[MultiAddress] = parseMultiAddress("/memory/8")
    if IsErr(otherAddrRes):
        return Err[bool](Error(otherAddrRes))
    let addRes: Result[bool] = addAddress(otherInfo, Value(otherAddrRes))
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    let putRes: Result[bool] = putPeer(sw.peerStore, otherInfo)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    let kadRes: Result[KadState] = initKadState(sw.peerId)
    if IsErr(kadRes):
        return Err[bool](Error(kadRes))
    var state: KadState = Value(kadRes)
    let insRes: Result[bool] = kadInsertPeer(state, otherId)
    if IsErr(insRes):
        return Err[bool](Error(insRes))
    setKademliaContext(state, sw.peerStore)
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    let targetKeyRes: Result[Key] = keyFromPeerId(otherId)
    if IsErr(targetKeyRes):
        return Err[bool](Error(targetKeyRes))
    var findReq: KadMessage = initKadMessage()
    findReq.msgType = kadFindNode
    findReq.hasKey = true
    findReq.key = Value(targetKeyRes)
    let writeFindRes: Result[bool] = writeKadMessage(outStream, findReq)
    if IsErr(writeFindRes):
        return Err[bool](Error(writeFindRes))
    let findHandleRes: Result[bool] = kademliaHandler(inStream)
    if IsErr(findHandleRes):
        return Err[bool](Error(findHandleRes))
    let findRes: Result[KadMessage] = readKadMessage(outStream)
    if IsErr(findRes):
        return Err[bool](Error(findRes))
    let findMsg: KadMessage = Value(findRes)
    if findMsg.msgType != kadFindNode:
        return Err[bool]("smoke: find-node reply type mismatch")
    if findMsg.closerCount <= 0:
        return Err[bool]("smoke: find-node empty reply")
    if ! kadPeerListContains(findMsg.closerPeers, findMsg.closerCount, otherId):
        return Err[bool]("smoke: find-node missing peer")
    let key: Key = BytesFromString("kad-smoke-key")
    var record: KadRecord = initKadRecord()
    record.hasValue = true
    record.value = BytesFromString("kad-smoke-value")
    var putReq: KadMessage = initKadMessage()
    putReq.msgType = kadPutValue
    putReq.hasKey = true
    putReq.key = key
    record.hasKey = true
    record.key = key
    putReq.hasRecord = true
    putReq.record = record
    let writePutRes: Result[bool] = writeKadMessage(outStream, putReq)
    if IsErr(writePutRes):
        return Err[bool](Error(writePutRes))
    let putHandleRes: Result[bool] = kademliaHandler(inStream)
    if IsErr(putHandleRes):
        return Err[bool](Error(putHandleRes))
    let putMsgRes: Result[KadMessage] = readKadMessage(outStream)
    if IsErr(putMsgRes):
        return Err[bool](Error(putMsgRes))
    var getReq: KadMessage = initKadMessage()
    getReq.msgType = kadGetValue
    getReq.hasKey = true
    getReq.key = key
    let writeGetRes: Result[bool] = writeKadMessage(outStream, getReq)
    if IsErr(writeGetRes):
        return Err[bool](Error(writeGetRes))
    let getHandleRes: Result[bool] = kademliaHandler(inStream)
    if IsErr(getHandleRes):
        return Err[bool](Error(getHandleRes))
    let getMsgRes: Result[KadMessage] = readKadMessage(outStream)
    if IsErr(getMsgRes):
        return Err[bool](Error(getMsgRes))
    let getMsg: KadMessage = Value(getMsgRes)
    if ! getMsg.hasRecord:
        return Err[bool]("smoke: get-value missing record")
    if ! getMsg.record.hasValue:
        return Err[bool]("smoke: get-value missing value")
    if ! BytesEqual(getMsg.record.value, record.value):
        return Err[bool]("smoke: get-value mismatch")
    let provKey: Key = BytesFromString("kad-smoke-provider")
    let selfPeerRes: Result[KadPeer] = peerToKadPeer(sw.peerId, sw.peerStore)
    if IsErr(selfPeerRes):
        return Err[bool](Error(selfPeerRes))
    var addReq: KadMessage = initKadMessage()
    addReq.msgType = kadAddProvider
    addReq.hasKey = true
    addReq.key = provKey
    addReq.providerPeers[0] = Value(selfPeerRes)
    addReq.providerCount = 1
    let writeAddRes: Result[bool] = writeKadMessage(outStream, addReq)
    if IsErr(writeAddRes):
        return Err[bool](Error(writeAddRes))
    let addHandleRes: Result[bool] = kademliaHandler(inStream)
    if IsErr(addHandleRes):
        return Err[bool](Error(addHandleRes))
    let addProvRes: Result[KadMessage] = readKadMessage(outStream)
    if IsErr(addProvRes):
        return Err[bool](Error(addProvRes))
    var getProvReq: KadMessage = initKadMessage()
    getProvReq.msgType = kadGetProviders
    getProvReq.hasKey = true
    getProvReq.key = provKey
    let writeProvRes: Result[bool] = writeKadMessage(outStream, getProvReq)
    if IsErr(writeProvRes):
        return Err[bool](Error(writeProvRes))
    let provHandleRes: Result[bool] = kademliaHandler(inStream)
    if IsErr(provHandleRes):
        return Err[bool](Error(provHandleRes))
    let getProvRes: Result[KadMessage] = readKadMessage(outStream)
    if IsErr(getProvRes):
        return Err[bool](Error(getProvRes))
    let provMsg: KadMessage = Value(getProvRes)
    if provMsg.providerCount <= 0:
        return Err[bool]("smoke: get-providers empty")
    if ! kadPeerListContains(provMsg.providerPeers, provMsg.providerCount, sw.peerId):
        return Err[bool]("smoke: get-providers missing self")
    return Ok[bool](true)
