# Synccast stream fallback smoke test(main entry).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/synccast_stream_fallback_smoke
fn main(): int32 =
    let res: Result[bool] = runSynccastStreamFallbackSmoke()
    if IsErr(res):
        echo("synccast stream fallback smoke failed: " + Error(res))
        return 1
    echo("synccast stream fallback smoke ok")
    return 0

