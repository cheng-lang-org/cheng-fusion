# AutoTLS smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/autotls/service
import cheng/libp2p/autotls/mockservice
fn runAutoTlsSmoke(): Result[bool] =
    var cfg: AutoTlsConfig = initAutoTlsConfig()
    cfg.enabled = true
    cfg.email = "test@example.com"
    cfg.endpoint = "https://acme.test"
    setAutoTlsConfig(cfg)
    let reqRes: Result[bool] = autoTlsRequestCertificate("example.com")
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    if ! autoTlsLastOk():
        return Err[bool]("smoke: autotls ! ok")
    autoTlsMockReset()
    let mockRes: Result[bool] = autoTlsMockIssue("example.com")
    if IsErr(mockRes):
        return Err[bool](Error(mockRes))
    if ! autoTlsMockIssued():
        return Err[bool]("smoke: autotls mock ! issued")
    if (autoTlsMockLastDomain() != "example.com"):
        return Err[bool]("smoke: autotls mock domain mismatch")
    return Ok[bool](true)
