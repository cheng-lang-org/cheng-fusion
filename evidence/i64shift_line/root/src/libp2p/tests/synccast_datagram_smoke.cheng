# Synccast QUIC datagram smoke test(audio/video roundtrip).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/quic/msquictransport
import cheng/libp2p/stream/connection
import cheng/libp2p/protocols/synccast/session
import cheng/libp2p/protocols/synccast/session_msquic
import cheng/libp2p/protocols/synccast/datagram
const
    synccastDatagramSessionId: int64 = 77

fn runSynccastDatagramSmoke(): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4011/quic-v1")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)

    var server: MsQuicTransport = initMsQuicTransport()
    var serverSettings: MsQuicSettings = msquicTransportSettings(server)
    serverSettings.allowDatagram = true
    serverSettings.maxDatagram = 1200
    let serverSetRes: Result[bool] = setMsQuicTransportSettings(server, serverSettings)
    if IsErr(serverSetRes):
        return Err[bool](Error(serverSetRes))
    start(server, addr)

    var client: MsQuicTransport = initMsQuicTransport()
    var clientSettings: MsQuicSettings = msquicTransportSettings(client)
    clientSettings.allowDatagram = true
    clientSettings.maxDatagram = 1200
    let clientSetRes: Result[bool] = setMsQuicTransportSettings(client, clientSettings)
    if IsErr(clientSetRes):
        return Err[bool](Error(clientSetRes))
    let outConnRes: Result[Connection] = dial(client, addr)
    if IsErr(outConnRes):
        return Err[bool](Error(outConnRes))
    let inConnRes: Result[Connection] = accept(server)
    if IsErr(inConnRes):
        return Err[bool](Error(inConnRes))
    var outConn: Connection = Value(outConnRes)
    var inConn: Connection = Value(inConnRes)

    var cfg: SynccastSessionConfig = initSynccastSessionConfig()
    cfg.sessionId = synccastDatagramSessionId
    cfg.targetLatencyMs = 0
    cfg.maxPayloadBytes = 1100
    var sender: SynccastSession = initSynccastSession(cfg)
    var receiver: SynccastSession = initSynccastSession(cfg)

    let nowUs: int64 = synccastNowUs()
    let audioPayload: Bytes = BytesFromString("synccast-audio-frame")
    let audioSendRes: Result[int32] = session_msquic.synccastSessionSendAudio(client, outConn, sender, 1, nowUs, nowUs, audioPayload)
    if IsErr(audioSendRes):
        return Err[bool](Error(audioSendRes))
    let videoPayload: Bytes = BytesFromString("synccast-video-frame")
    let videoSendRes: Result[int32] = session_msquic.synccastSessionSendVideo(client, outConn, sender, 2, nowUs + 20000, nowUs + 20000, videoPayload, true)
    if IsErr(videoSendRes):
        return Err[bool](Error(videoSendRes))

    var gotAudio: bool
    var gotVideo: bool
    var handled: int32
    let deadlineUs: int64 = synccastNowUs() + 2000000
    while handled < 2 && synccastNowUs() < deadlineUs: # cheng-syntax-policy: allow-counting-while
        let handleRes: Result[bool] = session_msquic.synccastSessionHandleDatagram(server, inConn, receiver)
        if IsErr(handleRes):
            return Err[bool](Error(handleRes))
        if Value(handleRes):
            let frameRes: Result[SynccastFrame] = synccastSessionPopFrame(receiver)
            if IsErr(frameRes):
                return Err[bool](Error(frameRes))
            let frame: SynccastFrame = Value(frameRes)
            if frame.header.trackId == synccastTrackAudio:
                if !BytesEqual(frame.payload, audioPayload):
                    return Err[bool]("smoke: audio payload mismatch")
                gotAudio = true
            elif frame.header.trackId == synccastTrackVideo:
                if !BytesEqual(frame.payload, videoPayload):
                    return Err[bool]("smoke: video payload mismatch")
                if (frame.header.flags & synccastFlagKeyframe) == 0:
                    return Err[bool]("smoke: video keyframe flag missing")
                gotVideo = true
            else:
                return Err[bool]("smoke: unexpected track id")
            handled = handled + 1
    if handled < 2:
        return Err[bool]("smoke: synccast datagram timeout")
    if !gotAudio || !gotVideo:
        return Err[bool]("smoke: missing synccast audio/video")
    let stats: SynccastStats = synccastSessionStats(receiver)
    if stats.framesDropped != 0:
        return Err[bool]("smoke: unexpected frame drops")
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runSynccastDatagramSmoke()
    if IsErr(res):
        echo("synccast datagram smoke failed: " + Error(res))
        return 1
    echo("synccast datagram smoke ok")
    return 0
