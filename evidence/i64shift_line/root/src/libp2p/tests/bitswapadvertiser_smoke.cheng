# Bitswap advertiser smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/crypto
import cheng/libp2p/crypto/rand
import cheng/libp2p/multicodec
import cheng/libp2p/multihash
import cheng/libp2p/cid
import cheng/libp2p/switch
import cheng/libp2p/builders
import cheng/libp2p/protocols/bitswap/store
import cheng/libp2p/providers/bitswapadvertiser
import cheng/libp2p/protocols/kademlia
fn runBitswapAdvertiserSmoke(): Result[bool] =
    setRandomSeed(BytesFromString("bitswap-adv-smoke"))
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/81")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    let data: Bytes = BytesFromString("bitswap")
    let mhRes: Result[MultiHash] = Digest(data, codecSha2_256)
    if IsErr(mhRes):
        return Err[bool](Error(mhRes))
    let cid: Cid = Cid(version: 1, codec: codecRaw, multihash: Value(mhRes))
    var store: BitswapBlockStore = initBitswapStore()
    let putRes: Result[bool] = bitswapStorePut(store, cid, data)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    let advRes: Result[int32] = bitswapAdvertiseStoreLocal(sw.peerId, store)
    if IsErr(advRes):
        return Err[bool](Error(advRes))
    if Value(advRes) <= 0:
        return Err[bool]("smoke: no advertised entries")
    let keyRes: Result[Bytes] = cidToBytes(cid)
    if IsErr(keyRes):
        return Err[bool](Error(keyRes))
    let stateOpt = kademliaState()
    if ! stateOpt.has:
        return Err[bool]("smoke: missing kademlia state")
    let entryOpt = getKadProviders(stateOpt.value.store, Value(keyRes))
    if ! entryOpt.has:
        return Err[bool]("smoke: provider entry missing")
    return Ok[bool](true)
