# WebRTC star transport smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/webrtcstartransport
fn runWebrtcStarTransportSmoke(): Result[bool] =
    var t: WebrtcStarTransport = initWebrtcStarTransport()
    let addrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4006/p2p-webrtc-star")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    start(t, addr)
    let dialRes: Result[Connection] = dial(t, addr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    let outbound: Connection = Value(dialRes)
    if ConnectionDirection(outbound) != Outbound:
        return Err[bool]("smoke: webrtc star outbound direction mismatch")
    if ! ConnectionIsOpen(outbound):
        return Err[bool]("smoke: webrtc star outbound ! open")
    let acceptRes: Result[Connection] = accept(t)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    let inbound: Connection = Value(acceptRes)
    if ConnectionDirection(inbound) != Inbound:
        return Err[bool]("smoke: webrtc star inbound direction mismatch")
    if ! ConnectionIsOpen(inbound):
        return Err[bool]("smoke: webrtc star inbound ! open")
    let localText: str = toString(LocalAddress(outbound))
    let remoteText: str = toString(RemoteAddress(outbound))
    if ! StrContains(localText, "/p2p-webrtc-star"):
        return Err[bool]("smoke: webrtc star local addr missing p2p-webrtc-star")
    if ! StrContains(remoteText, "/p2p-webrtc-star"):
        return Err[bool]("smoke: webrtc star remote addr missing p2p-webrtc-star")
    return Ok[bool](true)
