# Memory manager smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/memorymanager
fn runMemoryManagerSmoke(): Result[bool] =
    var cfg: MemoryConfig = initMemoryConfig()
    cfg.limitBytes = 16
    setMemoryConfig(cfg)
    resetMemoryStats()
    let res1: Result[bool] = reserveMemory(8)
    if IsErr(res1):
        return Err[bool](Error(res1))
    let res2: Result[bool] = reserveMemory(4)
    if IsErr(res2):
        return Err[bool](Error(res2))
    if memoryUsed() != 12:
        return Err[bool]("smoke: memory used mismatch")
    if memoryPeak() != 12:
        return Err[bool]("smoke: memory peak mismatch")
    let overRes: Result[bool] = reserveMemory(8)
    if IsOk(overRes):
        return Err[bool]("smoke: memory limit ! enforced")
    let relRes: Result[bool] = releaseMemory(4)
    if IsErr(relRes):
        return Err[bool](Error(relRes))
    if memoryUsed() != 8:
        return Err[bool]("smoke: memory release mismatch")
    return Ok[bool](true)
