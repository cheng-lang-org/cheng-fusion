# Muxer resource accounting smoke test(main entry).

import cheng/libp2p/utils/result
import cheng/libp2p/tests/muxer_resource_smoke
fn main(): int32 =
    let res: Result[bool] = runMuxerResourceSmoke()
    if IsErr(res):
        echo("muxer resource smoke failed: " + Error(res))
        return 1
    echo("muxer resource smoke ok")
    return 0

