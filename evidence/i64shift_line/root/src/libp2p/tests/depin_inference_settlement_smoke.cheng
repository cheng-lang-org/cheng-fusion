# DePIN inference settlement smoke(local RWAD dispatcher adapter path).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/strings
import std/strutils as strutil
import std/os
import cheng/libp2p/protocols/depin/inference_manifest
import cheng/libp2p/protocols/depin/inference_audit
import cheng/libp2p/protocols/depin/inference_settlement
import cheng/libp2p/protocols/depin/rwad_dispatcher_adapter

fn buildDepinSettlementPlanFixture(): DepinSettlementPlan =
    return DepinSettlementPlanBuild(
        "batch:depin:1",
        "job:depin:1",
        "executor:depin:1",
        "escrow:depin:1",
        int64(100)
    )

fn buildDepinSettlementSessionFixture(): DepinInferenceSession =
    var session: DepinInferenceSession = DepinBuildStartedInferenceSession(
        "req:depin:settlement",
        "cid:model:settlement",
        "prompt:settlement",
        "high-risk"
    )
    session.sessionId = "sid:depin:settlement"
    session.kvResidencyStoreHash = int64(10101)
    session.kvResidencyStoreOperationHash = int64(10102)
    session.kvResidencyWalRecordHash = int64(10103)
    session.kvResidencyWalLogHash = int64(10104)
    session.kvResidencyWalAppendHash = int64(10105)
    session.kvResidencyServiceCommitHash = int64(10106)
    session.kvResidencyServiceApplyHash = int64(10107)
    return session

fn runDepinInferenceSettlementSmoke(): Result[bool] =
    var adapter: DepinRwadDispatcherAdapter = initDepinRwadDispatcherAdapter(
        "rwad-local",
        "did:executor:depin:1",
        "keyref:executor:depin:1",
        uint64(1)
    )
    let plan: DepinSettlementPlan = buildDepinSettlementPlanFixture()
    let ledgerPath = "/tmp/cheng_depin_inference_settlement_smoke.cset1"
    if os.FileExists(ledgerPath):
        if !os.RemoveFile(ledgerPath):
            return Err[bool]("depin settlement smoke: remove old ledger")

    var submitSession: DepinInferenceSession = buildDepinSettlementSessionFixture()
    let submitRes = DepinSettlementSubmitWithLedger(
        adapter,
        submitSession,
        plan,
        ledgerPath,
        int64(1000001)
    )
    if IsErr(submitRes):
        return Err[bool](Error(submitRes))
    let submitTxHash = submitSession.settlementTxHash
    if adapter.lastTxType != "rwad_inference_batch_submit" ||
       adapter.lastPayloadHash != DepinAdapterPayloadHash(adapter.lastPayload) ||
       !strings.StrContains(adapter.lastPayload, "kind=submit") ||
       !strings.StrContains(adapter.lastPayload, "kvServiceCommit=10106") ||
       !strings.StrContains(adapter.lastPayload, "kvServiceApply=10107"):
        return Err[bool]("depin settlement smoke: submit payload missing service proof")
    if Value(submitRes).recordCount != 1 ||
       Value(submitRes).headRecordHash <= int64(0) ||
       Value(submitRes).ledgerHash <= int64(0):
        return Err[bool]("depin settlement smoke: submit ledger")
    let submitLedgerOk = DepinSettlementValidateLedgerFileReceipt(Value(submitRes))
    if IsErr(submitLedgerOk):
        return Err[bool](Error(submitLedgerOk))
    let submitLedgerRead = DepinSettlementReadLedgerFile(ledgerPath)
    if IsErr(submitLedgerRead):
        return Err[bool](Error(submitLedgerRead))
    let submitLedger = Value(submitLedgerRead).ledger
    let submitRecord = submitLedger.records[0]
    if submitLedger.recordCount != 1 ||
       submitRecord.kindHash != DepinSettlementTextHash("submit") ||
       submitRecord.sessionProofHash != DepinSettlementSessionProofHash(plan, submitSession):
        return Err[bool]("depin settlement smoke: submit ledger record")

    let finalizeRes = DepinSettlementFinalizeWithLedger(
        adapter,
        submitSession,
        plan,
        ledgerPath,
        int64(1000002)
    )
    if IsErr(finalizeRes):
        return Err[bool](Error(finalizeRes))
    if ! submitSession.finished:
        return Err[bool]("depin settlement smoke: session should be finished after submit+finalize")
    if len(submitSession.settlementTxHash) <= 0:
        return Err[bool]("depin settlement smoke: empty settlement tx hash")
    if submitSession.settlementTxHash == submitTxHash:
        return Err[bool]("depin settlement smoke: finalize tx should be distinct")
    if adapter.lastTxType != "rwad_inference_batch_finalize" ||
       adapter.lastPayloadHash != DepinAdapterPayloadHash(adapter.lastPayload) ||
       !strings.StrContains(adapter.lastPayload, "kind=finalize") ||
       !strings.StrContains(adapter.lastPayload, submitTxHash) ||
       !strings.StrContains(adapter.lastPayload, "kvServiceApply=10107"):
        return Err[bool]("depin settlement smoke: finalize payload missing service proof")
    if Value(finalizeRes).recordCount != 2 ||
       Value(finalizeRes).ledgerHash == Value(submitRes).ledgerHash:
        return Err[bool]("depin settlement smoke: finalize ledger")
    let finalizeLedgerOk = DepinSettlementValidateLedgerFileReceipt(Value(finalizeRes))
    if IsErr(finalizeLedgerOk):
        return Err[bool](Error(finalizeLedgerOk))
    let replicaPath = DepinSettlementLedgerReplicaPathFromPrefix("/tmp/cheng_depin_inference_settlement_smoke", plan.executor)
    if os.FileExists(replicaPath):
        if !os.RemoveFile(replicaPath):
            return Err[bool]("depin settlement smoke: remove old replica")
    let replicaRes = DepinSettlementWriteLedgerReplicaReceiptFile(
        replicaPath,
        adapter.sender,
        plan.executor,
        Value(finalizeRes),
        int64(1234567),
        int64(1000004)
    )
    if IsErr(replicaRes):
        return Err[bool](Error(replicaRes))
    let replicaOk = DepinSettlementValidateLedgerReplicaReceipt(Value(replicaRes))
    if IsErr(replicaOk):
        return Err[bool](Error(replicaOk))
    let replicaRead = DepinSettlementReadLedgerReplicaReceiptFile(replicaPath)
    if IsErr(replicaRead):
        return Err[bool](Error(replicaRead))
    if Value(replicaRead).ledgerReceiptHash != Value(finalizeRes).receiptHash ||
       Value(replicaRead).ledgerHash != Value(finalizeRes).ledgerHash ||
       Value(replicaRead).sourcePeerHash != DepinSettlementTextHash(adapter.sender) ||
       Value(replicaRead).targetPeerHash != DepinSettlementTextHash(plan.executor):
        return Err[bool]("depin settlement smoke: replica receipt binding")
    var driftReplicaReceipt = Value(replicaRes)
    driftReplicaReceipt.ledgerHash = driftReplicaReceipt.ledgerHash + int64(1)
    if IsOk(DepinSettlementValidateLedgerReplicaReceipt(driftReplicaReceipt)):
        return Err[bool]("depin settlement smoke: replica receipt drift should fail")
    let finalizeLedgerRead = DepinSettlementReadLedgerFile(ledgerPath)
    if IsErr(finalizeLedgerRead):
        return Err[bool](Error(finalizeLedgerRead))
    let finalizeLedger = Value(finalizeLedgerRead).ledger
    let finalizeRecord = finalizeLedger.records[1]
    if finalizeLedger.recordCount != 2 ||
       finalizeRecord.kindHash != DepinSettlementTextHash("finalize") ||
       finalizeRecord.submitTxHashHash != DepinSettlementTextHash(submitTxHash) ||
       finalizeRecord.previousRecordHash != submitRecord.recordHash:
        return Err[bool]("depin settlement smoke: finalize ledger record")
    var driftLedgerReceipt = Value(finalizeRes)
    driftLedgerReceipt.ledgerHash = driftLedgerReceipt.ledgerHash + int64(1)
    if IsOk(DepinSettlementValidateLedgerFileReceipt(driftLedgerReceipt)):
        return Err[bool]("depin settlement smoke: ledger receipt drift should fail")
    var missingProofSession: DepinInferenceSession = buildDepinSettlementSessionFixture()
    missingProofSession.kvResidencyServiceApplyHash = int64(0)
    let missingProofSubmit = depinSettlementSubmit(adapter, missingProofSession, plan)
    if IsOk(missingProofSubmit):
        return Err[bool]("depin settlement smoke: missing service proof should fail")

    var challengeSession: DepinInferenceSession = buildDepinSettlementSessionFixture()
    challengeSession.settlementTxHash = submitTxHash
    let decision: DepinAuditDecision = DepinAuditDecisionBuild(
        true,
        challengeSession.config.auditHighRiskBps,
        "forced_sample"
    )
    let challengeProof = BytesFromString("proof:ok")
    let challengeRes = DepinSettlementChallengeWithLedger(
        adapter,
        challengeSession,
        plan,
        decision,
        "fraud:hash_mismatch",
        challengeProof,
        ledgerPath,
        int64(1000003)
    )
    if IsErr(challengeRes):
        return Err[bool](Error(challengeRes))
    if len(challengeSession.challengeTxHash) <= 0:
        return Err[bool]("depin settlement smoke: empty challenge tx hash")
    if Value(challengeRes).recordCount != 3:
        return Err[bool]("depin settlement smoke: challenge ledger")
    let challengeLedgerRead = DepinSettlementReadLedgerFile(ledgerPath)
    if IsErr(challengeLedgerRead):
        return Err[bool](Error(challengeLedgerRead))
    let challengeLedger = Value(challengeLedgerRead).ledger
    let challengeRecord = challengeLedger.records[2]
    if challengeRecord.kindHash != DepinSettlementTextHash("challenge") ||
       challengeRecord.proofHash != DepinSettlementProofPayloadHash(challengeProof) ||
       challengeRecord.previousRecordHash != finalizeRecord.recordHash:
        return Err[bool]("depin settlement smoke: challenge ledger record")

    var rejectedChallengeSession: DepinInferenceSession = buildDepinSettlementSessionFixture()
    let rejectedDecision: DepinAuditDecision = DepinAuditDecisionBuild(
        true,
        rejectedChallengeSession.config.auditHighRiskBps,
        "challenge_forced"
    )
    let rejectedChallengeRes: Result[bool] = depinSettlementChallenge(
        adapter,
        rejectedChallengeSession,
        plan,
        rejectedDecision,
        "fraud:proof_invalid",
        EmptyBytes()
    )
    if IsOk(rejectedChallengeRes):
        return Err[bool]("depin settlement smoke: empty challenge proof should fail")
    if len(rejectedChallengeSession.challengeTxHash) > 0:
        return Err[bool]("depin settlement smoke: failed challenge should not set tx hash")

    # A1: on-chain ledger anchor receipt proof face (submit + confirm + verify).
    # boundary: this closes the anchor submit/confirm/verify receipt proof face,
    # not a real external chain RPC landing.
    let anchorPath = DepinSettlementLedgerAnchorPathFromPrefix("/tmp/cheng_depin_inference_settlement_smoke")
    if os.FileExists(anchorPath):
        if !os.RemoveFile(anchorPath):
            return Err[bool]("depin settlement smoke: remove old anchor")
    let anchorLedgerRead = DepinSettlementReadLedgerFile(ledgerPath)
    if IsErr(anchorLedgerRead):
        return Err[bool](Error(anchorLedgerRead))
    let anchorLedgerReceipt = Value(anchorLedgerRead).receipt
    let anchorSubmissionText = strutil.Join([
        "anchor:ledger=",
        strings.Int64ToStr(anchorLedgerReceipt.ledgerHash),
        "|chain=",
        adapter.chainId,
        "|submitter=",
        plan.executor
    ], "")
    let anchorSubmission = BytesSlice(BytesFromString(anchorSubmissionText), 0, len(anchorSubmissionText))
    let anchorRes = DepinSettlementWriteLedgerAnchorReceiptFile(
        anchorPath,
        anchorLedgerReceipt,
        adapter.chainId,
        "0xanchortx:1",
        int64(1000),
        int32(3),
        int64(1000005),
        plan.executor,
        anchorSubmission
    )
    if IsErr(anchorRes):
        return Err[bool](Error(anchorRes))
    let anchorOk = DepinSettlementValidateLedgerAnchorReceipt(
        Value(anchorRes),
        anchorLedgerReceipt.ledgerHash,
        DepinSettlementTextHash(adapter.chainId),
        int32(1)
    )
    if IsErr(anchorOk):
        return Err[bool](Error(anchorOk))
    let anchorRead = DepinSettlementReadLedgerAnchorReceiptFile(anchorPath)
    if IsErr(anchorRead):
        return Err[bool](Error(anchorRead))
    if Value(anchorRead).ledgerHash != anchorLedgerReceipt.ledgerHash ||
       Value(anchorRead).ledgerReceiptHash != anchorLedgerReceipt.receiptHash ||
       Value(anchorRead).chainHash != DepinSettlementTextHash(adapter.chainId) ||
       Value(anchorRead).anchorTxHash != DepinSettlementTextHash("0xanchortx:1") ||
       Value(anchorRead).anchorBlockNumber != int64(1000) ||
       Value(anchorRead).blockConfirmations != int32(3) ||
       Value(anchorRead).submitterPeerHash != DepinSettlementTextHash(plan.executor) ||
       Value(anchorRead).submissionByteHash != Value(anchorRes).submissionByteHash ||
       Value(anchorRead).receiptHash != Value(anchorRes).receiptHash:
        return Err[bool]("depin settlement smoke: anchor receipt binding")
    var driftAnchorLedgerHash = Value(anchorRes)
    driftAnchorLedgerHash.ledgerHash = driftAnchorLedgerHash.ledgerHash + int64(1)
    if IsOk(DepinSettlementValidateLedgerAnchorReceipt(driftAnchorLedgerHash, anchorLedgerReceipt.ledgerHash, DepinSettlementTextHash(adapter.chainId), int32(1))):
        return Err[bool]("depin settlement smoke: anchor ledger hash drift should fail")
    var driftAnchorTx = Value(anchorRes)
    driftAnchorTx.anchorTxHash = driftAnchorTx.anchorTxHash + int64(1)
    if IsOk(DepinSettlementValidateLedgerAnchorReceipt(driftAnchorTx, anchorLedgerReceipt.ledgerHash, DepinSettlementTextHash(adapter.chainId), int32(1))):
        return Err[bool]("depin settlement smoke: anchor tx hash drift should fail")
    if IsOk(DepinSettlementValidateLedgerAnchorReceipt(Value(anchorRes), anchorLedgerReceipt.ledgerHash, DepinSettlementTextHash("chain:other"), int32(1))):
        return Err[bool]("depin settlement smoke: anchor chain id drift should fail")
    if IsOk(DepinSettlementValidateLedgerAnchorReceipt(Value(anchorRes), anchorLedgerReceipt.ledgerHash, DepinSettlementTextHash(adapter.chainId), int32(4))):
        return Err[bool]("depin settlement smoke: anchor confirmations insufficient should fail")
    var driftAnchorSub = Value(anchorRes)
    driftAnchorSub.submissionByteHash = driftAnchorSub.submissionByteHash + int64(1)
    if IsOk(DepinSettlementValidateLedgerAnchorReceipt(driftAnchorSub, anchorLedgerReceipt.ledgerHash, DepinSettlementTextHash(adapter.chainId), int32(1))):
        return Err[bool]("depin settlement smoke: anchor submission byte hash drift should fail")
    let badAnchor = DepinSettlementWriteLedgerAnchorReceiptFile(
        anchorPath,
        anchorLedgerReceipt,
        "",
        "0xanchortx:1",
        int64(1000),
        int32(3),
        int64(1000005),
        plan.executor,
        anchorSubmission
    )
    if IsOk(badAnchor):
        return Err[bool]("depin settlement smoke: anchor empty chain id should fail")
    var driftLedgerReceipt = anchorLedgerReceipt
    driftLedgerReceipt.ledgerHash = driftLedgerReceipt.ledgerHash + int64(1)
    let badAnchorLedger = DepinSettlementWriteLedgerAnchorReceiptFile(
        anchorPath,
        driftLedgerReceipt,
        adapter.chainId,
        "0xanchortx:1",
        int64(1000),
        int32(3),
        int64(1000005),
        plan.executor,
        anchorSubmission
    )
    if IsOk(badAnchorLedger):
        return Err[bool]("depin settlement smoke: anchor invalid ledger receipt should fail")

    return Ok[bool](true)
