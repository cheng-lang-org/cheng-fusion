# mDNS local cache smoke test(enableNetwork=false).

import cheng/libp2p/utils/result
import cheng/libp2p/discovery/mdns
import cheng/libp2p/discovery/discoverymngr
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress

fn runMdnsCacheSmoke(): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/udp/4031/quic-v1")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))

    # Scenario A: rely on mdnsState.config.namespace injection.
    setMdnsState(initMdnsState())
    var cfgA: MdnsConfig = initMdnsConfig()
    cfgA.enableNetwork = false
    cfgA.namespace = "local"
    setMdnsConfig(cfgA)

    let pidARes: Result[PeerId] = randomPeerId()
    if IsErr(pidARes):
        return Err[bool](Error(pidARes))
    var attrsA: PeerAttributes = initPeerAttributes()
    let addPidARes: Result[bool] = peerAttributesAddPeerId(attrsA, Value(pidARes))
    if IsErr(addPidARes):
        return Err[bool](Error(addPidARes))
    let addAddrARes: Result[bool] = peerAttributesAddAddress(attrsA, Value(addrRes))
    if IsErr(addAddrARes):
        return Err[bool](Error(addAddrARes))
    let addSvcARes: Result[bool] = peerAttributesAddService(attrsA, "synccast-call")
    if IsErr(addSvcARes):
        return Err[bool](Error(addSvcARes))
    let advARes: Result[bool] = mdnsAdvertise(attrsA)
    if IsErr(advARes):
        return Err[bool](Error(advARes))
    let findARes: Result[bool] = mdnsFindOne("local", "synccast-call", Value(pidARes))
    if IsErr(findARes):
        return Err[bool](Error(findARes))

    # Scenario B: match mdns_host_synccast_call_smoke ordering + explicit namespace.
    var cfgB: MdnsConfig = initMdnsConfig()
    cfgB.enableNetwork = false
    cfgB.bindPort = 5536
    cfgB.queryTimeoutMs = 50
    setMdnsConfig(cfgB)
    setMdnsState(initMdnsState())

    let pidBRes: Result[PeerId] = randomPeerId()
    if IsErr(pidBRes):
        return Err[bool](Error(pidBRes))
    var attrsB: PeerAttributes = initPeerAttributes()
    let addPidBRes: Result[bool] = peerAttributesAddPeerId(attrsB, Value(pidBRes))
    if IsErr(addPidBRes):
        return Err[bool](Error(addPidBRes))
    let addAddrBRes: Result[bool] = peerAttributesAddAddress(attrsB, Value(addrRes))
    if IsErr(addAddrBRes):
        return Err[bool](Error(addAddrBRes))
    let addSvcBRes: Result[bool] = peerAttributesAddService(attrsB, "synccast-call")
    if IsErr(addSvcBRes):
        return Err[bool](Error(addSvcBRes))
    let addNsBRes: Result[bool] = peerAttributesAddNamespace(attrsB, "local")
    if IsErr(addNsBRes):
        return Err[bool](Error(addNsBRes))
    let advBRes: Result[bool] = mdnsAdvertise(attrsB)
    if IsErr(advBRes):
        return Err[bool](Error(advBRes))
    return mdnsFindOne("local", "synccast-call", Value(pidBRes))

fn mdnsFindOne(namespace: str, service: str, target: PeerId): Result[bool] =
    var query: PeerAttributes = initPeerAttributes()
    let qSvcRes: Result[bool] = peerAttributesAddService(query, service)
    if IsErr(qSvcRes):
        return Err[bool](Error(qSvcRes))
    let qNsRes: Result[bool] = peerAttributesAddNamespace(query, namespace)
    if IsErr(qNsRes):
        return Err[bool](Error(qNsRes))
    var out: PeerAttributesList = initPeerAttributesList()
    let discRes: Result[bool] = mdnsDiscover(query, out)
    if IsErr(discRes):
        return Err[bool](Error(discRes))
    if out.count <= 0:
        return Err[bool]("smoke: mdns cache empty")

    var found: bool
    for i in 0..<out.count:
        var got: PeerId
        if peerAttributesGetPeerId(out.items[i], got):
            let eqRes: Result[bool] = peerIdEqual(got, target)
            if IsErr(eqRes):
                return Err[bool](Error(eqRes))
            if Value(eqRes):
                found = true
    if !found:
        return Err[bool]("smoke: mdns cache missing peer")
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runMdnsCacheSmoke()
    if IsErr(res):
        echo("mdns cache smoke failed: " + Error(res))
        return 1
    echo("mdns cache smoke ok")
    return 0
