# DataTransfer smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/datatransfer/protobuf
import cheng/libp2p/protocols/datatransfer/datatransfer
import cheng/libp2p/switch
import cheng/libp2p/builders
fn runDataTransferSmoke(): Result[bool] =
    var builder: SwitchBuilder = newSwitchBuilder()
    let addrRes: Result[bool] = withAddressText(builder, "/memory/14")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let swRes: Result[Switch] = build(builder)
    if IsErr(swRes):
        return Err[bool](Error(swRes))
    var sw: Switch = Value(swRes)
    let startRes: Result[bool] = start(sw)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    setDataTransferChannelManager(initDataTransferChannelManager())
    setDataTransferPersistence(initDataTransferPersistence())
    let dialRes: Result[Muxer] = dial(sw, sw.listenAddr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    var outboundMux: Muxer = Value(dialRes)
    let acceptRes: Result[Muxer] = accept(sw)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    var inboundMux: Muxer = Value(acceptRes)
    let outStreamRes: Result[Stream] = openStream(outboundMux)
    if IsErr(outStreamRes):
        return Err[bool](Error(outStreamRes))
    var outStream: Stream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inboundMux)
    if IsErr(inStreamRes):
        return Err[bool](Error(inStreamRes))
    var inStream: Stream = Value(inStreamRes)
    var req: DataTransferRequest = initDataTransferRequest()
    req.isPull = true
    var msg: DataTransferMessage = initDataTransferMessage()
    msg.transferId = 1
    msg.kind = dtmkRequest
    msg.hasRequest = true
    msg.request = req
    let writeRes: Result[bool] = writeDataTransferMessage(outStream, msg)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let handleRes: Result[bool] = dataTransferHandler(inStream)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    let replyRes: Result[DataTransferMessage] = readDataTransferMessage(outStream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let reply: DataTransferMessage = Value(replyRes)
    if reply.kind != dtmkResponse || ! reply.hasResponse:
        return Err[bool]("smoke: datatransfer missing response")
    if ! reply.response.accepted:
        return Err[bool]("smoke: datatransfer response ! accepted")
    if reply.response.hasStatus && (reply.response.status != "ok"):
        return Err[bool]("smoke: datatransfer response status mismatch")
    let applyRes: Result[Option[DataTransferChannel]] = dataTransferApplyMessage(reply)
    if IsErr(applyRes):
        return Err[bool](Error(applyRes))
    let managerOpt: Option[DataTransferChannelManager] = dataTransferChannelManagerState()
    if ! managerOpt.has:
        return Err[bool]("smoke: datatransfer missing manager")
    let chOpt: Option[DataTransferChannel] = dataTransferChannelGet(managerOpt.value, msg.transferId)
    if ! chOpt.has:
        return Err[bool]("smoke: datatransfer channel missing")
    if chOpt.value.messageCount < 2:
        return Err[bool]("smoke: datatransfer channel message count mismatch")
    if len(chOpt.value.status) <= 0:
        return Err[bool]("smoke: datatransfer channel status empty")
    let storeOpt: Option[DataTransferPersistence] = dataTransferPersistenceState()
    if ! storeOpt.has:
        return Err[bool]("smoke: datatransfer persistence missing")
    let snapOpt: Option[DataTransferChannel] = dataTransferPersistLoad(storeOpt.value, msg.transferId)
    if ! snapOpt.has:
        return Err[bool]("smoke: datatransfer snapshot missing")
    return Ok[bool](true)
