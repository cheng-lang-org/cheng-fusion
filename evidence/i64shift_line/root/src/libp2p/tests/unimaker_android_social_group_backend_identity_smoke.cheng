# Verifies the group-create stub backend (unimaker_android_social_group_backend.cheng)
# derives a real, device-stable libp2p peer id from configJson's "dataDir"
# seed instead of returning a hardcoded literal shared by every device.
#
# Assertions (>=5, each returns a distinct non-zero code on failure):
#   1. Same dataDir seed -> same peer id across two independent init/get
#      round trips (idempotent, no per-launch drift).
#   2. Different dataDir seed -> different peer id (per-device uniqueness).
#   3. Derived peer id is a syntactically valid libp2p peer id (52-char
#      base58 "12D3KooW..." identity-multihash, same shape peer_id.cheng
#      produces for every other libp2p identity in this codebase).
#   4. configJson with no "dataDir" key (seed genuinely unreachable) is
#      rejected loudly: init returns handle 0 (not a fabricated fallback
#      id) and get_last_error reports a non-empty reason.
#   5. nil configJson is rejected the same way (pre-existing contract kept).
#   6. Same dataDir seed run through mobile_capi's own underlying primitive
#      (cheng/libp2p/core/peer_id.Libp2pPeerIdFillFromSeed +
#      Libp2pPeerIdText, the exact functions MobileCapiPeerIdFromSeed calls)
#      yields the identical peer id text -- this stub reuses that production
#      derivation, it does not invent a parallel identity algorithm.

import std/system
import std/strings
import cheng/libp2p/mobile_ffi/unimaker_android_social_group_backend
import cheng/libp2p/core/types
import cheng/libp2p/core/peer_id

fn isValidLibp2pPeerIdShape(peerIdText: str): bool =
    let n: int32 = len(peerIdText)
    if n != 52:
        return false
    if !strings.HasPrefix(peerIdText, "12D3KooW"):
        return false
    return true

fn main(): int32 =
    let dataDirA: str = "/data/user/0/com.unimaker.app/files/libp2p"
    let dataDirB: str = "/data/user/0/com.unimaker.app.other/files/libp2p"
    let cfgA: str = "{\"dataDir\":\"" + dataDirA + "\",\"data_dir\":\"" + dataDirA + "\",\"runtimeProfile\":\"standard_android\"}"
    let cfgA2: str = "{\"dataDir\":\"" + dataDirA + "\",\"data_dir\":\"" + dataDirA + "\",\"runtimeProfile\":\"standard_android\"}"
    let cfgB: str = "{\"dataDir\":\"" + dataDirB + "\",\"data_dir\":\"" + dataDirB + "\",\"runtimeProfile\":\"standard_android\"}"
    let cfgNoDataDir: str = "{\"runtimeProfile\":\"standard_android\"}"

    # --- 1: idempotent across independent init/get round trips.
    let handle1: int64 = libp2p_node_init(cfgA)
    if handle1 <= 0:
        return 11
    # A copy is taken immediately (not a borrow) because the peer id text
    # lives in a process-env slot this stub reuses across init() calls --
    # a real Android caller reads it exactly once per process (Kotlin's
    # chengSocialBackendStarted guard calls node_init at most once), but
    # this smoke test deliberately drives multiple seeds in one process, so
    # it must snapshot each value before the next init() call overwrites
    # the same env slot with the next device's peer id.
    let peer1: str = strFromCStringCopy(libp2p_get_local_peer_id(handle1))
    if len(peer1) <= 0:
        return 12

    let handle1b: int64 = libp2p_node_init(cfgA2)
    if handle1b <= 0:
        return 13
    let peer1b: str = strFromCStringCopy(libp2p_get_local_peer_id(handle1b))
    if peer1b != peer1:
        return 14

    # --- 2: different seed -> different peer id.
    let handle2: int64 = libp2p_node_init(cfgB)
    if handle2 <= 0:
        return 21
    let peer2: str = strFromCStringCopy(libp2p_get_local_peer_id(handle2))
    if len(peer2) <= 0:
        return 22
    if peer2 == peer1:
        return 23

    # --- 3: peer id format is a real libp2p peer id, not a placeholder
    # slug ("cheng-android-local-video" was 26 chars and not base58/12D3KooW).
    if !isValidLibp2pPeerIdShape(peer1):
        return 31
    if !isValidLibp2pPeerIdShape(peer2):
        return 32

    # --- 4: seed genuinely unreachable (no dataDir key at all) -> loud
    # reject, not a silently fabricated id. (get_local_peer_id(0) itself is
    # not called here: its invalid-handle branch returns a bare cstring
    # literal, which trips a pre-existing, unrelated host-target-only cold
    # backend crash reproducible byte-for-byte on the untouched git HEAD
    # version of this same file -- see identity.patch notes. The handle-0
    # contract itself is unchanged by this patch.)
    let handleNoSeed: int64 = libp2p_node_init(cfgNoDataDir)
    if handleNoSeed != 0:
        return 41
    let lastError: str = strFromCStringCopy(libp2p_get_last_error())
    if len(lastError) <= 0:
        return 43

    # --- 5: nil configJson still rejected the same way as before.
    let handleNil: int64 = libp2p_node_init(nil)
    if handleNil != 0:
        return 51

    # --- 6: identical derivation to mobile_capi's own PeerIdFromSeed
    # primitive (peer_id.Libp2pPeerIdFillFromSeed / Libp2pPeerIdText) given
    # the same dataDir seed -- confirms this stub reuses the production
    # PeerIdFromSeed line rather than a parallel algorithm.
    var directPeerValue: types.Libp2pPeerId
    peer_id.Libp2pPeerIdFillFromSeed(directPeerValue, dataDirA)
    let directPeerText: str = peer_id.Libp2pPeerIdText(directPeerValue)
    if directPeerText != peer1:
        return 61

    return 0
