# Bootstrap gossip core smoke(shared logic only).

import cheng/libp2p/utils/result
import cheng/libp2p/discovery/bootstrap_gossip

fn runBootstrapGossipCoreSmoke(): Result[bool] =
    let normalized: BootstrapPolicy = normalizeBootstrapPolicy(
        BootstrapPolicy(
            topic: "",
            tickSeconds: 1,
            randomN: 999,
            candidateTtlMs: 1000,
            parallelDials: 0,
            publishPeerCap: 999,
            publishChancePercent: 999,
            publishMinIntervalMs: 1,
            publishSuppressionMs: 999999999,
            requireTrustedPublisher: true
        )
    )
    if normalized.topic != bootstrapTopicV1:
        return Err[bool]("bootstrap core smoke: default topic mismatch")
    if normalized.tickSeconds != 5:
        return Err[bool]("bootstrap core smoke: tick clamp mismatch")
    if normalized.randomN != bootstrapMaxTickSample:
        return Err[bool]("bootstrap core smoke: randomN clamp mismatch")
    if normalized.candidateTtlMs != 30000:
        return Err[bool]("bootstrap core smoke: ttl clamp mismatch")
    if normalized.parallelDials != 1:
        return Err[bool]("bootstrap core smoke: parallel clamp mismatch")
    if normalized.publishPeerCap != 64:
        return Err[bool]("bootstrap core smoke: publish cap clamp mismatch")
    if normalized.publishChancePercent != 100:
        return Err[bool]("bootstrap core smoke: publish chance clamp mismatch")
    if normalized.publishMinIntervalMs != 10000:
        return Err[bool]("bootstrap core smoke: publish min interval clamp mismatch")
    if normalized.publishSuppressionMs != 1800000:
        return Err[bool]("bootstrap core smoke: publish suppression clamp mismatch")
    if !normalized.requireTrustedPublisher:
        return Err[bool]("bootstrap core smoke: trusted publisher flag mismatch")

    let backoff1: int64 = bootstrapBackoffDelayMs(0)
    if backoff1 != bootstrapBackoffBaseMs:
        return Err[bool]("bootstrap core smoke: base backoff mismatch")
    let backoff2: int64 = bootstrapBackoffDelayMs(4)
    if backoff2 <= backoff1:
        return Err[bool]("bootstrap core smoke: backoff growth mismatch")

    if !bootstrapShouldAutoTick(0, 60, 1000):
        return Err[bool]("bootstrap core smoke: first tick should run")
    if bootstrapShouldAutoTick(1000, 60, 2000):
        return Err[bool]("bootstrap core smoke: tick fired too early")
    if !bootstrapShouldAutoTick(1000, 60, 62000):
        return Err[bool]("bootstrap core smoke: tick should run after interval")

    if !bootstrapShouldPublishNow(1, 0, 0, 1, 60000, 45000, 1000):
        return Err[bool]("bootstrap core smoke: small network should publish")
    if bootstrapShouldPublishNow(5, 500, 0, 100, 800, 0, 1000):
        return Err[bool]("bootstrap core smoke: min interval should suppress")
    if bootstrapShouldPublishNow(5, 0, 950, 100, 0, 100, 1000):
        return Err[bool]("bootstrap core smoke: heard suppression should suppress")
    if !bootstrapShouldPublishNow(5, 0, 0, 100, 0, 0, 1000):
        return Err[bool]("bootstrap core smoke: chance 100 should publish")

    return Ok[bool](true)
