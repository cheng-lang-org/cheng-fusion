# Mobile hardware transport smoke runner.

import cheng/libp2p/utils/result
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/mobilehwtransport

fn runMobileHwTransportSmoke(): int32 =
    let addrARes: Result[MultiAddress] = parseMultiAddress("/nearfield/node-a")
    if IsErr(addrARes):
        return 11
    let addrBRes: Result[MultiAddress] = parseMultiAddress("/nearfield/node-b")
    if IsErr(addrBRes):
        return 12
    let addrA: MultiAddress = Value(addrARes)
    let addrB: MultiAddress = Value(addrBRes)

    var ta: MobileHwTransport = initMobileHwTransport()
    var tb: MobileHwTransport = initMobileHwTransport()
    start(ta, addrA)
    start(tb, addrB)

    if !handles(ta, addrA):
        return 13
    if !handles(tb, addrB):
        return 14

    let abDialRes: Result[Connection] = dial(ta, addrB)
    if IsErr(abDialRes):
        return 15
    let abOut: Connection = Value(abDialRes)
    if ConnectionDirection(abOut) != Outbound:
        return 16
    if !ConnectionIsOpen(abOut):
        return 17

    let abAcceptRes: Result[Connection] = accept(tb)
    if IsErr(abAcceptRes):
        return 18
    let abIn: Connection = Value(abAcceptRes)
    if ConnectionDirection(abIn) != Inbound:
        return 19
    if !ConnectionIsOpen(abIn):
        return 20

    # Reverse dial acts as a simple ping-back path sanity check.
    let baDialRes: Result[Connection] = dial(tb, addrA)
    if IsErr(baDialRes):
        return 21
    let baOut: Connection = Value(baDialRes)
    if ConnectionDirection(baOut) != Outbound:
        return 22
    let baAcceptRes: Result[Connection] = accept(ta)
    if IsErr(baAcceptRes):
        return 23
    let baIn: Connection = Value(baAcceptRes)
    if ConnectionDirection(baIn) != Inbound:
        return 24

    var c1: Connection = abOut
    var c2: Connection = abIn
    var c3: Connection = baOut
    var c4: Connection = baIn
    close(c1)
    close(c2)
    close(c3)
    close(c4)
    stop(ta)
    stop(tb)
    return 0

fn main(): int32 =
    return runMobileHwTransportSmoke()
