# MemoryTransport pipe smoke(start + dial/accept + write/read).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/memorytransport

fn runMemoryTransportPipeSmoke(): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/55")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    var listener: MemoryTransport = initMemoryTransport()
    start(listener, addr)
    var dialer: MemoryTransport = initMemoryTransport()

    let outConnRes: Result[Connection] = dial(dialer, addr)
    if IsErr(outConnRes):
        return Err[bool](Error(outConnRes))
    let inConnRes: Result[Connection] = accept(listener)
    if IsErr(inConnRes):
        return Err[bool](Error(inConnRes))
    var outbound: Connection = Value(outConnRes)
    var inbound: Connection = Value(inConnRes)

    let payload: Bytes = BytesFromString("hi")
    let writeRes: Result[int32] = write(outbound, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let readRes: Result[Bytes] = read(inbound, BytesLen(payload))
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if ! BytesEqual(Value(readRes), payload):
        return Err[bool]("smoke: payload mismatch")

    close(outbound)
    close(inbound)
    stop(listener)
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runMemoryTransportPipeSmoke()
    if IsErr(res):
        echo("memorytransport pipe smoke failed: " + Error(res))
        return 1
    echo("memorytransport pipe smoke ok")
    return 0

