# BigInt smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/bigint
fn int64ToBytesBE(value: int64): Bytes =
    let out: Bytes = BytesAlloc(8)
    var v: int64 = value
    var i: int32 = 7
    let loop_start_i_1 = i
    for loop_rev_i_1 in 0..(loop_start_i_1 - (0)):
        i = loop_start_i_1 - loop_rev_i_1
        if ! (i >= 0):
            break
        BytesSet(out, i, int32(v & 255))
        v = v >> 8
    return out

fn bigToInt64(a: BigInt): int64 =
    if a.count <= 0:
        return 0
    var out: int64
    var i: int32 = a.count - 1
    let loop_start_i_2 = i
    for loop_rev_i_2 in 0..(loop_start_i_2 - (0)):
        i = loop_start_i_2 - loop_rev_i_2
        if ! (i >= 0):
            break
        let limb: int64 = int64(a.limbs[i]) & bigIntWordMask
        out = (out << bigIntWordBits) | limb
    return out

fn runBigIntSmoke(): Result[bool] =
    let aBytes: Bytes = int64ToBytesBE(1234567890)
    let bBytes: Bytes = int64ToBytesBE(987654321)
    let aRes: Result[BigInt] = bigFromBytes(aBytes)
    if IsErr(aRes):
        return Err[bool](Error(aRes))
    let bRes: Result[BigInt] = bigFromBytes(bBytes)
    if IsErr(bRes):
        return Err[bool](Error(bRes))
    let sumRes: Result[BigInt] = bigAdd(Value(aRes), Value(bRes))
    if IsErr(sumRes):
        return Err[bool](Error(sumRes))
    if bigToInt64(Value(sumRes)) != 2222222211:
        return Err[bool]("bigint: add mismatch")
    let subRes: Result[BigInt] = bigSub(Value(aRes), Value(bRes))
    if IsErr(subRes):
        return Err[bool](Error(subRes))
    if bigToInt64(Value(subRes)) != 246913569:
        return Err[bool]("bigint: sub mismatch")
    let modRes: Result[BigInt] = bigMod(Value(aRes), Value(bRes))
    if IsErr(modRes):
        return Err[bool](Error(modRes))
    if bigToInt64(Value(modRes)) != (1234567890 % 987654321):
        return Err[bool]("bigint: % mismatch")
    let baseRes: Result[BigInt] = bigFromBytes(int64ToBytesBE(4))
    if IsErr(baseRes):
        return Err[bool](Error(baseRes))
    let expRes: Result[BigInt] = bigFromBytes(int64ToBytesBE(13))
    if IsErr(expRes):
        return Err[bool](Error(expRes))
    let mod2Res: Result[BigInt] = bigFromBytes(int64ToBytesBE(497))
    if IsErr(mod2Res):
        return Err[bool](Error(mod2Res))
    let powRes: Result[BigInt] = bigModExp(Value(baseRes), Value(expRes), Value(mod2Res))
    if IsErr(powRes):
        return Err[bool](Error(powRes))
    if bigToInt64(Value(powRes)) != 445:
        return Err[bool]("bigint: modexp mismatch")
    return Ok[bool](true)
