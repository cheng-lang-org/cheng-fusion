import cheng/libp2p/utils/bytes

# Genuinely unresolvable bare identifier (not declared as a const anywhere
# reachable from this file's own import closure) used as a fixed-array
# size. Must die loudly at compile time, never silently default to a
# wrong/zero length.
var
    gConstFor90PoisonArr: int32[thisConstDoesNotExistAnywhere90]

fn ConstFor90PoisonArraySize(): int32 =
    var s: int32 = 0
    var i: int32 = 0
    for i in 0..<4:
        gConstFor90PoisonArr[i] = i + 1
        s = s + gConstFor90PoisonArr[i]
    return s
