# DID-focused test runner.

import cheng/libp2p/utils/result
import cheng/libp2p/tests/did_unit
import cheng/libp2p/tests/didauth_integration

fn runDidAll(): Result[bool] =
    let unitRes: Result[bool] = runDidUnit()
    if IsErr(unitRes):
        return unitRes
    let integRes: Result[bool] = runDidAuthIntegration()
    if IsErr(integRes):
        return integRes
    return Ok[bool](true)

fn main(): int32 =
    let res: Result[bool] = runDidAll()
    if IsErr(res):
        echo("did runner failed")
        echo(Error(res))
        return 1
    echo("did runner ok")
    return 0
