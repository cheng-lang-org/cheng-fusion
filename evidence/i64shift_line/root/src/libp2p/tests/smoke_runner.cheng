        return bsRes
    let gsRes: Result[bool] = runGraphsyncSmoke()
    if IsErr(gsRes):
        return gsRes
    let dtRes: Result[bool] = runDataTransferSmoke()
    if IsErr(dtRes):
        return dtRes
    let fetchRes: Result[bool] = runFetchSmoke()
    if IsErr(fetchRes):
        return fetchRes
    return Ok[bool](true)

