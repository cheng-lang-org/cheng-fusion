fn runCryptoSmoke(): Result[bool] =
    let sysSeedRes: Result[bool] = randomSeedFromSystem()
    if IsErr(sysSeedRes):
        return Err[bool](Error(sysSeedRes))
    let seed: Bytes = BytesFromString("cheng-libp2p-smoke-seed")
    setRandomSeed(seed)
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        return Err[bool](Error(kpRes))
    let kp: KeyPair = Value(kpRes)
    let msg: Bytes = BytesFromString("hello")
    let sigRes: Result[Signature] = sign(kp.privateKey, msg)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    let sig: Signature = Value(sigRes)
    if ! verify(kp.publicKey, msg, sig):
        return Err[bool]("smoke: ed25519 verify failed")
    let curveRes: Result[bool] = runCurve25519Smoke()
    if IsErr(curveRes):
        return curveRes
    let bigRes: Result[bool] = runBigIntSmoke()
    if IsErr(bigRes):
        return bigRes
    let rsaRes: Result[bool] = runRsaBigIntSmoke()
    if IsErr(rsaRes):
        return rsaRes
    let ecdsaRes: Result[bool] = runP256EcdsaSmoke()
    if IsErr(ecdsaRes):
        return ecdsaRes
    let x509Res: Result[bool] = runX509Smoke()
    if IsErr(x509Res):
        return x509Res
    return Ok[bool](true)

fn runCoreSmokes(): Result[bool] =
    let mfRes: Result[bool] = runMultiformatsSmoke()
    if IsErr(mfRes):
        return mfRes
    let cryptoRes: Result[bool] = runCryptoSmoke()
    if IsErr(cryptoRes):
        return cryptoRes
    let didRes: Result[bool] = runDidUnit()
    if IsErr(didRes):
        return didRes
    let switchRes: Result[bool] = runSwitchSmoke()
    if IsErr(switchRes):
        return switchRes
    let hostRes: Result[bool] = runHostSmoke()
    if IsErr(hostRes):
        return hostRes
    let kadRes: Result[bool] = runKademliaSmoke()
    if IsErr(kadRes):
        return kadRes
    let rdvRes: Result[bool] = runRendezvousSmoke()
    if IsErr(rdvRes):
