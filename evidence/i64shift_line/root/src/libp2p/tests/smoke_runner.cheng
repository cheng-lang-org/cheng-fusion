fn runAllSmokes(): Result[bool] =
    let bwRes: Result[bool] = runBandwidthSmoke()
    if IsErr(bwRes):
        return bwRes
    return Ok[bool](true)

fn smokeRunnerMain(): int32 =
    let res: Result[bool] = runAllSmokes()
    if IsErr(res):
        echo("smoke runner failed")
        echo(Error(res))
        return 1
    echo("smoke runner ok")
    return 0
