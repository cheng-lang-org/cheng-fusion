# PublicKey encode smoke(debug lengths).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/crypto

fn main(): int32 =
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        echo("publickey encode smoke failed: " + Error(kpRes))
        return 1
    let kp: KeyPair = Value(kpRes)
    let encRes: Result[Bytes] = encodePublicKey(kp.publicKey)
    if IsErr(encRes):
        echo("publickey encode smoke failed: " + Error(encRes))
        return 1
    let b: Bytes = Value(encRes)
    echo("pubBytes.len=" + $(BytesLen(b)))
    echo("pubBytes.hex=" + BytesToHex(b))
    return 0

