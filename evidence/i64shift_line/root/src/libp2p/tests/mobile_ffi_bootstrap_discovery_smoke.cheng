# mobile ffi bootstrap-first discovery smoke.

import cheng/libp2p/mobile_ffi/unimaker_compat_ffi_smoke

fn main(): int32 =
    NimMain()

    let cfg: str
    let node1: int64 = libp2p_node_init(cfg)
    if node1 <= 0:
        return 11
    if libp2p_node_start(node1) != resultOk:
        return 12

    if !libp2p_bootstrap_set_policy(node1, ""):
        return 13

    let node2: int64 = libp2p_node_init(cfg)
    if node2 <= 0:
        return 14
    if libp2p_node_start(node2) != resultOk:
        return 15

    let tickReachable: str = libp2p_bootstrap_tick(node1)
    if len(tickReachable) <= 0:
        return 16

    if !libp2p_mdns_set_enabled(node1, false):
        return 17
    if len(libp2p_bootstrap_tick(node1)) <= 0:
        return 18
    if !libp2p_mdns_set_enabled(node1, true):
        return 19
    if !libp2p_mdns_probe(node1):
        return 20

    if libp2p_node_stop(node2) != resultOk:
        return 21
    libp2p_node_free(node2)

    if libp2p_node_stop(node1) != resultOk:
        return 22
    libp2p_node_free(node1)

    return 0
