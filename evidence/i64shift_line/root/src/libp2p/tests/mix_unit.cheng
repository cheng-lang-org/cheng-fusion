# Mix unit tests.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/mix/mix_message
fn repeatChar(c: char, count: int32): str =
    if count <= 0:
        return ""
    var out: str
    for i in 0..<count:
        out = out + charToStr(c)
    return out

fn runMixUnit(): Result[bool] =
    var msg: MixMessage = initMixMessage()
    msg.codec = "/demo/1.0.0"
    msg.payload = BytesFromString("hello")
    let encRes: Result[Bytes] = encodeMixMessage(msg)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let decRes: Result[MixMessage] = decodeMixMessage(Value(encRes))
    if IsErr(decRes):
        return Err[bool](Error(decRes))
    let decoded: MixMessage = Value(decRes)
    if (decoded.codec != "/demo/1.0.0"):
        return Err[bool]("unit: mix codec mismatch")
    if ! BytesEqual(decoded.payload, BytesFromString("hello")):
        return Err[bool]("unit: mix payload mismatch")

    msg.codec = ""
    msg.payload = BytesFromString("ping")
    let emptyEncRes: Result[Bytes] = encodeMixMessage(msg)
    if IsErr(emptyEncRes):
        return Err[bool](Error(emptyEncRes))
    let emptyDecRes: Result[MixMessage] = decodeMixMessage(Value(emptyEncRes))
    if IsErr(emptyDecRes):
        return Err[bool](Error(emptyDecRes))
    let emptyDecoded: MixMessage = Value(emptyDecRes)
    if len(emptyDecoded.codec) != 0:
        return Err[bool]("unit: mix empty codec mismatch")
    if ! BytesEqual(emptyDecoded.payload, BytesFromString("ping")):
        return Err[bool]("unit: mix empty codec payload mismatch")

    msg.codec = repeatChar('a', 200)
    msg.payload = BytesFromString("ok")
    let longEncRes: Result[Bytes] = encodeMixMessage(msg)
    if IsErr(longEncRes):
        return Err[bool](Error(longEncRes))
    let longDecRes: Result[MixMessage] = decodeMixMessage(Value(longEncRes))
    if IsErr(longDecRes):
        return Err[bool](Error(longDecRes))
    let longDecoded: MixMessage = Value(longDecRes)
    if len(longDecoded.codec) != 200:
        return Err[bool]("unit: mix long codec length mismatch")

    var badVarint: Bytes = BytesAlloc(3)
    BytesSet(badVarint, 0, 0x81)
    BytesSet(badVarint, 1, 0x81)
    BytesSet(badVarint, 2, 0x01)
    let badRes: Result[MixMessage] = decodeMixMessage(badVarint)
    if IsOk(badRes):
        return Err[bool]("unit: mix expected varint failure")

    var shortData: Bytes = BytesAlloc(2)
    BytesSet(shortData, 0, 0x05)
    BytesSet(shortData, 1, 0x61)
    let shortRes: Result[MixMessage] = decodeMixMessage(shortData)
    if IsOk(shortRes):
        return Err[bool]("unit: mix expected truncated codec failure")

    return Ok[bool](true)
