# WebSocket transport smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
import cheng/libp2p/transports/wstransport
fn runWsTransportSmoke(): Result[bool] =
    var t: WsTransport = initWsTransport()
    let addrRes: Result[MultiAddress] = parseMultiAddress("/ip4/127.0.0.1/tcp/4001/ws")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    start(t, addr)
    let dialRes: Result[Connection] = dial(t, addr)
    if IsErr(dialRes):
        return Err[bool](Error(dialRes))
    let outbound: Connection = Value(dialRes)
    if ConnectionDirection(outbound) != Outbound:
        return Err[bool]("smoke: ws outbound direction mismatch")
    if ! ConnectionIsOpen(outbound):
        return Err[bool]("smoke: ws outbound ! open")
    let acceptRes: Result[Connection] = accept(t)
    if IsErr(acceptRes):
        return Err[bool](Error(acceptRes))
    let inbound: Connection = Value(acceptRes)
    if ConnectionDirection(inbound) != Inbound:
        return Err[bool]("smoke: ws inbound direction mismatch")
    if ! ConnectionIsOpen(inbound):
        return Err[bool]("smoke: ws inbound ! open")
    let localText: str = toString(LocalAddress(outbound))
    let remoteText: str = toString(RemoteAddress(outbound))
    if ! StrContains(localText, "/tcp/"):
        return Err[bool]("smoke: ws outbound local addr missing tcp")
    if ! StrContains(remoteText, "/tcp/"):
        return Err[bool]("smoke: ws outbound remote addr missing tcp")
    if ! (StrContains(localText, "/ws") || StrContains(localText, "/wss")):
        return Err[bool]("smoke: ws outbound local addr missing ws")
    if ! (StrContains(remoteText, "/ws") || StrContains(remoteText, "/wss")):
        return Err[bool]("smoke: ws outbound remote addr missing ws")
    return Ok[bool](true)
