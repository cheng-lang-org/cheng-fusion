# Connection bandwidth accounting smoke test(manual).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/bandwidthmanager
import cheng/libp2p/resourcemanager
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
fn runConnectionBandwidthSmoke(): Result[bool] =
    var limits: ResourceLimits = initResourceLimits()
    limits.maxInboundBytes = 10
    limits.maxOutboundBytes = 10
    setResourceLimits(limits)
    resetBandwidthStats()

    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/0")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr: MultiAddress = Value(addrRes)
    let pairRes: Result[ConnectionPair] =
        newConnectionPair(addr, addr, addr, addr)
    if IsErr(pairRes):
        return Err[bool](Error(pairRes))
    var outbound: Connection = Value(pairRes).outbound
    var inbound: Connection = Value(pairRes).inbound

    let payload: Bytes = BytesFromString("hello")
    let writeRes: Result[int32] = write(outbound, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let readRes: Result[Bytes] = read(inbound, BytesLen(payload))
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if BytesLen(Value(readRes)) != BytesLen(payload):
        return Err[bool]("smoke: payload length mismatch")
    if bandwidthOutboundTotal() != 5:
        return Err[bool]("smoke: outbound total mismatch")
    if bandwidthInboundTotal() != 5:
        return Err[bool]("smoke: inbound total mismatch")

    let bigPayload: Bytes = BytesFromString("abcdef")
    let overRes: Result[int32] = write(outbound, bigPayload)
    if IsOk(overRes):
        return Err[bool]("smoke: outbound limit ! enforced")
    if bandwidthOutboundTotal() != 5:
        return Err[bool]("smoke: outbound total changed on overflow")

    return Ok[bool](true)
