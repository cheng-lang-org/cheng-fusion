# DePIN inference verify runner (full runtime smoke).
# Marker for verify contract gate: runDepinInferenceSmoke

import cheng/libp2p/utils/result
import cheng/libp2p/tests/depin_inference_smoke
import cheng/libp2p/tests/depin_inference_specdecode_smoke
import cheng/tests/depin_inference_transport_smoke

fn main(): int32 =
    let stageRes: Result[bool] = runDepinInferenceSmoke()
    if IsErr(stageRes):
        echo(Error(stageRes))
        return 11
    if !Value(stageRes):
        echo("depin inference runner: stage smoke returned false")
        return 12
    let specRes: Result[bool] = runDepinInferenceSpecdecodeSmoke()
    if IsErr(specRes):
        echo(Error(specRes))
        return 21
    if !Value(specRes):
        echo("depin inference runner: specdecode smoke returned false")
        return 22
    let transportCode = RunDepinInferenceTransportSmoke()
    if transportCode != 0:
        echo("depin inference runner: transport smoke failed")
        return 30 + transportCode
    return 0
