# mobile ffi full-start smoke.

import cheng/libp2p/mobile_ffi/unimaker_compat_ffi_smoke

fn main(): int32 =
    NimMain()

    let cfg: str
    let node1: int64 = libp2p_node_init(cfg)
    if node1 <= 0:
        return 11
    if libp2p_node_start(node1) != resultOk:
        return 12

    let peer1: str = trimText(libp2p_get_local_peer_id(node1))
    if len(peer1) <= 0:
        return 13

    if !libp2p_set_msquic_settings(node1, ""):
        return 14
    let msquicJson: str = libp2p_get_msquic_settings(node1)
    if len(msquicJson) <= 0:
        return 15

    if libp2p_node_stop(node1) != resultOk:
        return 16
    libp2p_node_free(node1)

    let node1Reload: int64 = libp2p_node_init(cfg)
    if node1Reload <= 0:
        return 17
    if libp2p_node_start(node1Reload) != resultOk:
        return 18
    let peer1Reload: str = trimText(libp2p_get_local_peer_id(node1Reload))
    if peer1Reload != peer1:
        return 19

    let node2: int64 = libp2p_node_init(cfg)
    if node2 <= 0:
        return 20
    if libp2p_node_start(node2) != resultOk:
        return 21
    let peer2: str = trimText(libp2p_get_local_peer_id(node2))
    if len(peer2) <= 0:
        return 22

    let dialable2: str = libp2p_get_dialable_addresses(node2)
    let dialableValues: str[] = parseQuotedValues(dialable2)
    if len(dialableValues) <= 0:
        return 23

    if libp2p_connect_peer(node1Reload, peer2) != resultOk:
        return 24
    if !libp2p_is_peer_connected(node1Reload, peer2):
        return 25

    if libp2p_node_stop(node2) != resultOk:
        return 26
    libp2p_node_free(node2)

    if libp2p_node_stop(node1Reload) != resultOk:
        return 27
    libp2p_node_free(node1Reload)

    return 0
