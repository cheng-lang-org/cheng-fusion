# P-256 ECDSA smoke test(vector + sign/verify).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/ecnist
const
    ecdsaTestMessage = "cheng-ecdsa-smoke"
    ecdsaPrivHex = "08b98cbc3975eeab3e996249dcf3337294a697923def344bea683fd06c3d7e82"
    ecdsaPubHex = "048862569f3ddf7f54c48fb5ba5676403495fb2f403efaaa1a483658b70a0c74d7aba3a78a6cdd2e557a3ebd28cd1561ad5545111057f02d91b8f62e4a479322b9"
    ecdsaSigRHex = "b282cf5dc011fda96bc837673dbdac4740c4173ee80d9d9b644357f5245850f7"
    ecdsaSigSHex = "7da11740b9095698125c54dea86b3aeae9f3f4ba3d5f04ddf2d72a449ebe6276"

fn hexValue(c: char): int32 =
    if c >= '0' && c <= '9':
        return int32(c) - int32('0')
    if c >= 'a' && c <= 'f':
        return 10 + int32(c) - int32('a')
    if c >= 'A' && c <= 'F':
        return 10 + int32(c) - int32('A')
    return -1

fn hexDecode(text: str): Result[Bytes] =
    if len(text) % 2 != 0:
        return Err[Bytes]("ecdsa: hex length must be even")
    let out: Bytes = BytesAlloc(len(text) / 2)
    var i: int32
    while i < len(text): # cheng-syntax-policy: allow-counting-while
        let hi: int32 = hexValue(text[i])
        let lo: int32 = hexValue(text[i + 1])
        if hi < 0 || lo < 0:
            return Err[Bytes]("ecdsa: invalid hex")
        BytesSet(out, i / 2, (hi << 4) | lo)
        i = i + 2
    return Ok[Bytes](out)

fn runP256EcdsaSmoke(): Result[bool] =
    let msg: Bytes = BytesFromString(ecdsaTestMessage)
    let privRes: Result[Bytes] = hexDecode(ecdsaPrivHex)
    if IsErr(privRes):
        return Err[bool](Error(privRes))
    let pubRes: Result[Bytes] = hexDecode(ecdsaPubHex)
    if IsErr(pubRes):
        return Err[bool](Error(pubRes))
    let rRes: Result[Bytes] = hexDecode(ecdsaSigRHex)
    if IsErr(rRes):
        return Err[bool](Error(rRes))
    let sRes: Result[Bytes] = hexDecode(ecdsaSigSHex)
    if IsErr(sRes):
        return Err[bool](Error(sRes))
    let sig: Bytes = BytesAlloc(64)
    for i in 0..<32:
        BytesSet(sig, i, BytesGet(Value(rRes), i))
        BytesSet(sig, 32 + i, BytesGet(Value(sRes), i))
    if ! ecdsaVerifyBytes(Value(pubRes), msg, sig):
        return Err[bool]("ecdsa: vector verify failed")
    let pubFromPrivRes: Result[Bytes] = ecdsaPublicKeyFromPrivateBytes(Value(privRes))
    if IsErr(pubFromPrivRes):
        return Err[bool](Error(pubFromPrivRes))
    if ! BytesEqual(Value(pubFromPrivRes), Value(pubRes)):
        return Err[bool]("ecdsa: public key derivation mismatch")
    let sigRes: Result[Bytes] = ecdsaSignBytes(Value(privRes), msg)
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    if ! ecdsaVerifyBytes(Value(pubRes), msg, Value(sigRes)):
        return Err[bool]("ecdsa: sign/verify failed")
    let sigBad: Bytes = BytesSlice(Value(sigRes), 0, BytesLen(Value(sigRes)))
    BytesSet(sigBad, 0, BytesGet(sigBad, 0) ^ 1)
    if ecdsaVerifyBytes(Value(pubRes), msg, sigBad):
        return Err[bool]("ecdsa: tampered signature accepted")
    return Ok[bool](true)
