# Connection gater(allow/deny lists for peers && addresses).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/stringlist
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
type
    ConnectionGater =
        enabled: bool
        peerAllow: StringList
        peerDeny: StringList
        addrAllow: StringList
        addrDeny: StringList

fn initConnectionGater(): ConnectionGater =
    ConnectionGater(
        enabled: false,
        peerAllow: InitStringList(),
        peerDeny: InitStringList(),
        addrAllow: InitStringList(),
        addrDeny: InitStringList()
    )

fn setGaterEnabled(g: var ConnectionGater, enabled: bool) =
    g.enabled = enabled

fn gaterEnabled(g: ConnectionGater): bool =
    g.enabled

fn clearPeerAllow(g: var ConnectionGater) =
    g.peerAllow = InitStringList()

fn clearPeerDeny(g: var ConnectionGater) =
    g.peerDeny = InitStringList()

fn clearAddressAllow(g: var ConnectionGater) =
    g.addrAllow = InitStringList()

fn clearAddressDeny(g: var ConnectionGater) =
    g.addrDeny = InitStringList()

fn allowPeerText(g: var ConnectionGater, peerText: str): Result[bool] =
    return StringListAdd(g.peerAllow, peerText)

fn denyPeerText(g: var ConnectionGater, peerText: str): Result[bool] =
    return StringListAdd(g.peerDeny, peerText)

fn allowPeer(g: var ConnectionGater, id: PeerId): Result[bool] =
    return allowPeerText(g, peerid.toString(id))

fn denyPeer(g: var ConnectionGater, id: PeerId): Result[bool] =
    return denyPeerText(g, peerid.toString(id))

fn allowAddressSubstring(g: var ConnectionGater, needle: str): Result[bool] =
    return StringListAdd(g.addrAllow, needle)

fn denyAddressSubstring(g: var ConnectionGater, needle: str): Result[bool] =
    return StringListAdd(g.addrDeny, needle)

fn listContainsSubstring(list: StringList, text: str): bool =
    for i in 0..<list.count:
        if StrContains(text, list.items[i]):
            return true
    return false

fn peerAllowedText(g: ConnectionGater, peerText: str): bool =
    if ! g.enabled:
        return true
    if len(peerText) <= 0:
        return StringListIsEmpty(g.peerAllow)
    if StringListContains(g.peerDeny, peerText):
        return false
    if ! StringListIsEmpty(g.peerAllow):
        return StringListContains(g.peerAllow, peerText)
    return true

fn addressAllowedText(g: ConnectionGater, addrText: str): bool =
    if ! g.enabled:
        return true
    if len(addrText) <= 0:
        return StringListIsEmpty(g.addrAllow)
    if listContainsSubstring(g.addrDeny, addrText):
        return false
    if ! StringListIsEmpty(g.addrAllow):
        return listContainsSubstring(g.addrAllow, addrText)
    return true

fn allowDialPeer(g: ConnectionGater, id: PeerId): bool =
    return peerAllowedText(g, peerid.toString(id))

fn allowDialPeerText(g: ConnectionGater, peerText: str): bool =
    return peerAllowedText(g, peerText)

fn allowInboundPeer(g: ConnectionGater, id: PeerId): bool =
    return peerAllowedText(g, peerid.toString(id))

fn allowInboundPeerText(g: ConnectionGater, peerText: str): bool =
    return peerAllowedText(g, peerText)

fn allowDialAddress(g: ConnectionGater, addr: MultiAddress): bool =
    return addressAllowedText(g, lpMultiAddressToString(addr))

fn AllowDialAddress(g: ConnectionGater, addr: MultiAddress): bool =
    return allowDialAddress(g, addr)

fn allowDialAddressText(g: ConnectionGater, addrText: str): bool =
    return addressAllowedText(g, addrText)

fn allowInboundAddress(g: ConnectionGater, addr: MultiAddress): bool =
    return addressAllowedText(g, lpMultiAddressToString(addr))

fn allowInboundAddressText(g: ConnectionGater, addrText: str): bool =
    return addressAllowedText(g, addrText)
