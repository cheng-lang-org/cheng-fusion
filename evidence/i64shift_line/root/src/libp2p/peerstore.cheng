fn findPeerByProtocol(store: PeerStore, proto: str): Result[Option[PeerId]] =
    var fallback: Option[PeerId] = None[PeerId]()
    for i in 0..<store.count:
        if protocolsContain(store.items[i], proto):
            if hasNonMemoryAddress(store.items[i]):
                return Ok[Option[PeerId]](Some[PeerId](store.items[i].id))
            if ! fallback.has:
                fallback = Some[PeerId](store.items[i].id)
    return Ok[Option[PeerId]](fallback)

fn findPeerByAddress(store: PeerStore, addr: MultiAddress): Result[Option[PeerId]] =
    for i in 0..<store.count:
        if addressesContain(store.items[i], addr):
            return Ok[Option[PeerId]](Some[PeerId](store.items[i].id))
    return Ok[Option[PeerId]](None[PeerId]())

fn findPeerByAddressText(store: PeerStore, text: str): Result[Option[PeerId]] =
    let addrRes: Result[MultiAddress] = parseMultiAddress(text)
    if IsErr(addrRes):
        return Err[Option[PeerId]](Error(addrRes))
    return findPeerByAddress(store, Value(addrRes))
