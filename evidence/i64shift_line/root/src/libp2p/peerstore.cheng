fn appendPeerDump(out: var str, peer: PeerInfo) =
    out = stdstrings.ConcatStr(out, "peer\n")

fn pageOffset(page: int32, size: int32): int32 =
    if size <= 0:
        return 0
    if page <= 1:
        return 0
    return (page - 1) * size

fn stringCmp(a: str, b: str): int32 =
    let alen: int32 = len(a)
    let blen: int32 = len(b)
    let minLen: int32 = if alen < blen: alen else: blen
    for i in 0..<minLen:
        let diff: int32 = int32(a[i]) - int32(b[i])
        if diff != 0:
            return diff
    return alen - blen

fn sortStringList(list: var StringList) =
    if list.count <= 1:
        return
    for i in 0..<list.count:
        var minIdx: int32 = i
        for j in i + 1..<list.count:
            if ! (j < list.count):
                break
            if stringCmp(list.items[j], list.items[minIdx]) < 0:
                minIdx = j
        if minIdx != i:
            let tmp: str = list.items[i]
            list.items[i] = list.items[minIdx]
            list.items[minIdx] = tmp
fn peerStoreDump(store: PeerStore): str =
    return ""

fn peerStoreDumpLimit(store: PeerStore, limit: int32): str =
    return ""

fn peerStoreDumpOffset(store: PeerStore, offset: int32, limit: int32): str =
    return ""

fn peerStoreDumpPage(store: PeerStore, page: int32, size: int32): str =
    if size <= 0:
        return ""
    let offset: int32 = pageOffset(page, size)
    return peerStoreDumpOffset(store, offset, size)

