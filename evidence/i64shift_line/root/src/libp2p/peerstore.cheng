# PeerStore (seq, capped).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/strings
import std/strings as stdstrings
import std/stringlist
import std/seqs
import cheng/libp2p/peerid
import cheng/libp2p/peerinfo
import cheng/libp2p/multiaddress
import cheng/libp2p/discovery/discoverymngr
const
    maxPeers = 64

type
    PeerStore =
        count: int32
        items: PeerInfo[]

fn initPeerStore(): PeerStore =
    var out: PeerStore
    out.count = 0
    return out

fn peerCount(store: PeerStore): int32 =
    store.count

@borrows
fn findPeerIndex(store: PeerStore, id: PeerId): Result[int32] =
    for i in 0..<store.count:
        let eqRes: Result[bool] = peerIdEqual(store.items[i].id, id)
        if IsErr(eqRes):
            return Err[int32](Error(eqRes))
        if Value(eqRes):
            return Ok[int32](i)
    return Ok[int32](-1)

fn hasNonMemoryAddress(info: PeerInfo): bool =
    for i in 0..<info.addrs.count:
        let addr: MultiAddress = info.addrs.items[i]
        let text: str = multiaddress.lpMultiAddressToString(addr)
        if ! StrContains(text, "/memory/"):
            return true
    return false

fn putPeer(store: var PeerStore, info: PeerInfo): Result[bool] =
    return mergePeer(store, info)

fn mergePeer(store: var PeerStore, info: PeerInfo): Result[bool] =
    let idxRes: Result[int32] = findPeerIndex(store, info.id)
    if IsErr(idxRes):
        return Err[bool](Error(idxRes))
    let idx: int32 = Value(idxRes)
    if idx >= 0:
        var existing: PeerInfo = store.items[idx]
        let mergeRes: Result[bool] = mergePeerInfo(existing, info)
        if IsErr(mergeRes):
            return Err[bool](Error(mergeRes))
        store.items[idx] = existing
        return Ok[bool](true)
    if store.count >= maxPeers:
        return Err[bool]("peerstore: full")
    add(store.items, info)
    store.count = store.items.len
    return Ok[bool](true)

fn peerInfoFromAttributes(attrs: PeerAttributes): Result[PeerInfo] =
    var pid: PeerId
    if !peerAttributesGetPeerId(attrs, pid):
        return Err[PeerInfo]("peerstore: missing peer id")
    var info: PeerInfo = newPeerInfo(pid)
    for i in 0..<attrs.count:
        let item: PeerAttribute = attrs.items[i]
        if item.kind == attrAddress:
            let addRes: Result[bool] = addAddress(info, item.address)
            if IsErr(addRes):
                return Err[PeerInfo](Error(addRes))
        elif item.kind == attrService || item.kind == attrNamespace:
            let text: str = item.text
            if len(text) > 0 && text[0] == '/':
                let addProtoRes: Result[bool] = StringListAdd(info.protocols, text)
                if IsErr(addProtoRes):
                    return Err[PeerInfo](Error(addProtoRes))
    return Ok[PeerInfo](info)

fn mergePeerAttributes(store: var PeerStore, attrs: PeerAttributes): Result[bool] =
    let infoRes: Result[PeerInfo] = peerInfoFromAttributes(attrs)
    if IsErr(infoRes):
        return Err[bool](Error(infoRes))
    return mergePeer(store, Value(infoRes))

fn mergePeerAttributesList(store: var PeerStore, list: PeerAttributesList, limit: int32): Result[int32] =
    let maxCount: int32 = if limit > 0: limit else: list.count
    var merged: int32
    for i in 0..<list.count:
        if ! (i < list.count && merged < maxCount):
            break
        let mergeRes: Result[bool] = mergePeerAttributes(store, list.items[i])
        if IsErr(mergeRes):
            return Err[int32](Error(mergeRes))
        if Value(mergeRes):
            merged = merged + 1
    return Ok[int32](merged)

fn hasPeer(store: PeerStore, id: PeerId): Result[bool] =
    let idxRes: Result[int32] = findPeerIndex(store, id)
    if IsErr(idxRes):
        return Err[bool](Error(idxRes))
    return Ok[bool](Value(idxRes) >= 0)

fn getPeer(store: PeerStore, id: PeerId): Result[PeerInfo] =
    let idxRes: Result[int32] = findPeerIndex(store, id)
    if IsErr(idxRes):
        return Err[PeerInfo](Error(idxRes))
    let idx: int32 = Value(idxRes)
    if idx < 0:
        return Err[PeerInfo]("peerstore: ! found")
    return Ok[PeerInfo](store.items[idx])

fn getPeerAddresses(store: PeerStore, id: PeerId): Result[MultiAddressList] =
    let peerRes: Result[PeerInfo] = getPeer(store, id)
    if IsErr(peerRes):
        return Err[MultiAddressList](Error(peerRes))
    let info: PeerInfo = Value(peerRes)
    return Ok[MultiAddressList](info.addrs)

fn removePeer(store: var PeerStore, id: PeerId): Result[bool] =
    let idxRes: Result[int32] = findPeerIndex(store, id)
    if IsErr(idxRes):
        return Err[bool](Error(idxRes))
    let idx: int32 = Value(idxRes)
    if idx < 0:
        return Err[bool]("peerstore: ! found")
    let last: int32 = store.count - 1
    if idx != last:
        store.items[idx] = store.items[last]
    setLen(store.items, last)
    store.count = store.items.len
    return Ok[bool](true)

fn listPeerIds(store: PeerStore): Result[StringList] =
    var list: StringList = InitStringList()
    for i in 0..<store.count:
        let pid: PeerId = store.items[i].id
        let idText: str = peerid.toString(pid)
        let addRes: Result[bool] = StringListAdd(list, idText)
        if IsErr(addRes):
            return Err[StringList](Error(addRes))
    return Ok[StringList](list)

fn listPeerIdsByProtocol(store: PeerStore, proto: str): Result[StringList] =
    var list: StringList = InitStringList()
    for i in 0..<store.count:
        if protocolsContain(store.items[i], proto):
            let pid: PeerId = store.items[i].id
            let idText: str = peerid.toString(pid)
            let addRes: Result[bool] = StringListAdd(list, idText)
            if IsErr(addRes):
                return Err[StringList](Error(addRes))
    return Ok[StringList](list)

fn listPeerIdsByAddressSubstring(store: PeerStore, needle: str): Result[StringList] =
    var list: StringList = InitStringList()
    for i in 0..<store.count:
        let peer: PeerInfo = store.items[i]
        if StrContains(addressLines(peer), needle):
            let idText: str = peerid.toString(peer.id)
            let addRes: Result[bool] = StringListAdd(list, idText)
            if IsErr(addRes):
                return Err[StringList](Error(addRes))
    return Ok[StringList](list)

fn listPeerIdsSorted(store: PeerStore): Result[StringList] =
    let listRes: Result[StringList] = listPeerIds(store)
    if IsErr(listRes):
        return Err[StringList](Error(listRes))
    var list: StringList = Value(listRes)
    sortStringList(list)
    return Ok[StringList](list)

fn listPeerIdsByProtocolSorted(store: PeerStore, proto: str): Result[StringList] =
    let listRes: Result[StringList] = listPeerIdsByProtocol(store, proto)
