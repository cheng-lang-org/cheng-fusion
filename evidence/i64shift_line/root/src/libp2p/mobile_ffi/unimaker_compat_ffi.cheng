@borrows
fn StatusAckSendText(success: bool, statusText: str): str =
    if success:
        return ""
    return strings.CloneStr(statusText)

@borrows
fn DmConversationKey(conversationId: str, peerIdText: str): str =
    if len(conversationId) > 0:
        return strings.CloneStr(conversationId)
    return "dm:" + strings.CloneStr(peerIdText)

@exportc("social_dm_ack")
fn social_dm_ack(handle: int64, peerIdPtr: void*, conversationIdPtr: void*, messageIdPtr: void*, statusPtr: void*): bool =
    let peerIdText: str = strings.CloneStr(trimText(voidPtrText(peerIdPtr)))
    let conversationId: str = strings.CloneStr(trimText(voidPtrText(conversationIdPtr)))
    let messageId: str = strings.CloneStr(trimText(voidPtrText(messageIdPtr)))
    let statusText: str = strings.CloneStr(trimText(voidPtrText(statusPtr)))
    let success: bool = !StrContains(strLowerAscii(strings.CloneStr(statusText)), "fail")
    let peerIdTextPtr: cstring = dupCString(strings.CloneStr(peerIdText))
    let messageIdPtr2: cstring = dupCString(strings.CloneStr(messageId))
    let statusTextPtr: cstring = dupCString(StatusAckSendText(success, statusText))
    let ok: bool = libp2p_send_chat_ack_ffi(handle, void*(peerIdTextPtr), void*(messageIdPtr2), success, void*(statusTextPtr))
    c_free(peerIdTextPtr)
    c_free(messageIdPtr2)
    c_free(statusTextPtr)
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx >= 0 && node->used:
        let ackPayload: str = "{\"messageId\":" + toJsonStringValue(strings.CloneStr(messageId)) + ",\"status\":" + toJsonStringValue(strings.CloneStr(statusText)) + "}"
        emitSocialEvent(node, "dm", "ack", strings.CloneStr(ackPayload), DmConversationKey(conversationId, peerIdText), "", "")
    return ok

@exportc("social_contacts_send_request")
fn social_contacts_send_request(handle: int64, peerIdPtr: void*, helloTextPtr: void*): bool =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return false
    let peerIdText: str = strings.CloneStr(trimText(voidPtrText(peerIdPtr)))
    let helloText: str = strings.CloneStr(trimText(voidPtrText(helloTextPtr)))
    let requestPayload: str = "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"hello\":" + toJsonStringValue(strings.CloneStr(helloText)) + "}"
    let ok: bool = socialSendEnvelope(handle, strings.CloneStr(peerIdText), "contacts.request", strings.CloneStr(requestPayload))
    if !ok:
        return false
    emitSocialEvent(node, "contacts", "request", strings.CloneStr(requestPayload), "", "", "")
    return true

