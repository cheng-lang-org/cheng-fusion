@exportc("social_groups_invite")
fn social_groups_invite(handle: int64, groupIdPtr: void*, peerIdsJsonPtr: void*): bool =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return false
    let groupId: str = strings.CloneStr(trimText(voidPtrText(groupIdPtr)))
    let peerIdsJson: str = strings.CloneStr(trimText(voidPtrText(peerIdsJsonPtr)))
    var peers: str[]
    var peerCount: int32
    parseStringListPayloadInto(strings.CloneStr(peerIdsJson), peers, peerCount)
    var sent: int32
    var i: int32
    while i < peerCount:
        let targetPeer: str = strings.CloneStr(trimText(peers[i]))
        if len(targetPeer) > 0:
            let ok: bool = socialSendEnvelope(handle, strings.CloneStr(targetPeer), "groups.invite", "{\"groupId\":" + toJsonStringValue(strings.CloneStr(groupId)) + "}")
            if ok:
                sent = sent + 1
        i = i + 1
    if peerCount > 0 && sent <= 0:
        return false
    emitSocialEvent(node, "groups", "invite", JsonOrEmptyArray(peerIdsJson), "", groupId, "")
    return true

