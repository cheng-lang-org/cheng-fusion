fn mdnsDiscoverCountOrZero(raw: int32): int32 =
    if raw <= 0 || raw > maxMdnsDiscoverCount:
        return 0
    return raw

fn mdnsApplyNodeConfig(node: var NodeRuntime): bool =
    var serviceText: str = trimText(node.mdnsService)
    if len(serviceText) <= 0:
        serviceText = mdnsDefaultServiceText()
    var namespaceText: str = trimText(node.mdnsNamespace)
    if len(namespaceText) <= 0:
        namespaceText = mdnsDefaultNamespaceText()
    let preferredIpv4Text: str = trimText(node.mdnsPreferredIpv4)
    node.mdnsService = strings.CloneStr(serviceText)
    node.mdnsNamespace = strings.CloneStr(namespaceText)
    node.mdnsPreferredIpv4 = strings.CloneStr(preferredIpv4Text)
    var enabledText: str
    if node.mdnsEnabled:
        enabledText = "true"
    else:
        enabledText = "false"
    debugNodeStep(joinText(["[ffi] mdns_config_applied enabled=", enabledText, " service=", strings.CloneStr(serviceText), " namespace=", strings.CloneStr(namespaceText), " preferredIpv4=", strings.CloneStr(preferredIpv4Text)]))
    return true

fn bleDefaultServiceText(): str =
    return defaultBleService

fn bleDefaultNamespaceText(): str =
    return defaultBleNamespace

fn bleApplyNodeConfig(node: var NodeRuntime): bool =
    var serviceText: str = trimText(node.bleService)
    if len(serviceText) <= 0:
        serviceText = bleDefaultServiceText()
    var namespaceText: str = trimText(node.bleNamespace)
    if len(namespaceText) <= 0:
        namespaceText = bleDefaultNamespaceText()
    node.bleService = strings.CloneStr(serviceText)
    node.bleNamespace = strings.CloneStr(namespaceText)
    var enabledText: str
    if node.bleEnabled:
        enabledText = "true"
    else:
        enabledText = "false"
    debugNodeStep(joinText(["[ffi] ble_config_applied enabled=", enabledText, " service=", strings.CloneStr(serviceText), " namespace=", strings.CloneStr(namespaceText)]))
    return true

fn emptyPayload(): Bytes =
    var payload: Bytes
    return payload

@borrows
fn isNullText(text: str): bool =
    # J/8548 定谳: `void*(text)` 对 str 值做裸指针值转换违反
    # cheng-formal-spec.md string_abi_contract.abi.str_direct_c_abi=forbidden
    # (str 24 字节布局只在 @abi_internal 内可见, 源码路径无 SABI 例外)。
    # str 无 null 态, spec 判空唯一合法写法是 len(s)==0 (spec §"字符串 nil 语义")。
    # 原 raw==1 分支对本仓任何 str 构造路径 (StrFromCStringBorrow 等) 均不可达
    # (data 只会是 nil 或有效指针, 从不为字面量 1), 是死防御分支, 改写后行为等价。
    return len(text) <= 0

@borrows
fn cStr(text: str): cstring =
    let n: int32 = len(text)
    if n <= 0:
        return system.strToCStringTemp("")
    return system.strToCStringTemp(text)

@borrows
fn CloneDataDirOrRoot(dataDir: str): str =
    let owned: str = strings.CloneStr(dataDir)
    if len(trimText(strings.CloneStr(owned))) > 0:
        return strings.CloneStr(owned)
    return strings.CloneStr("/")


fn ptrText(ptrValue: cstring): str =
    if ptrValue == nil:
        return ""
    return trimText(system.strFromCStringCopy(ptrValue))

@borrows
fn voidPtrText(raw: void*): str =
    if raw == nil:
        return ""
    var boxed: void* = raw
    return ptrText(cstring(boxed))

fn dupCString(v: str): cstring =
    if isNullText(v):
        return c_strdup(cStr(""))
    return c_strdup(cStr(v))

fn dupOwnedCString(v: cstring): cstring =
    if v == nil:
        return dupCString("")
    let text: str = system.strFromCStringCopy(v)
    c_free(v)
    return dupCString(strings.CloneStr(text))

