@exportc("libp2p_wait_secure_channel_ffi")
fn libp2p_wait_secure_channel_ffi(handle: int64, peerIdPtr: void*, timeoutMs: int32): bool =
    timeoutMs
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("wait_secure_channel: invalid handle")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        return failWith("wait_secure_channel: missing peerId")
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    let peerTotal: int32 = safePeerCountPtr(node)
    var peerScan: int32
    while peerScan < peerTotal:
        let row: str = peerRowAtPtr(node, peerScan)
        if peerRowUsed(row) && peerRowPeerId(row) == target && peerRowConnected(row):
            return true
        peerScan = peerScan + 1
    if callHostDialPeerPtr(node, peerIdText):
        let swIdx: int32 = nodeSwitchIndexPtr(node)
        if swIdx >= 0:
            let swPtr: switch.Switch* = switchPtrAt(swIdx)
            if swPtr != nil:
                if um_hostHasPeerTextIndex(swIdx, peerIdText):
                    setPeerConnectedPtr(node, peerIdText, true)
                    return true
        setPeerConnectedPtr(node, peerIdText, true)
        return true
    return false

