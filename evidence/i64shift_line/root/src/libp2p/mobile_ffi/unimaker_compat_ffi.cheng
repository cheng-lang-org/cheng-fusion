@exportc("libp2p_resolve_ipns")
fn libp2p_resolve_ipns(handle: int64, nameOrUriPtr: void*): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("resolve_ipns: node_not_initialized")
        return dupCString("{\"error\":\"node_not_initialized\"}")
    let targetRaw: str = trimText(voidPtrText(nameOrUriPtr))
    if len(targetRaw) <= 0:
        setLastError("resolve_ipns: missing_target")
        return dupCString("{\"error\":\"missing_target\"}")
    var resolved: str
    if startsWith(targetRaw, "/ipns/"):
        resolved = targetRaw
    elif startsWith(targetRaw, "ipns://"):
        resolved = "/ipns/" + SliceBytes(targetRaw, len("ipns://"), len(targetRaw) - len("ipns://"))
    elif startsWith(targetRaw, "/ipfs/"):
        resolved = targetRaw
    elif startsWith(targetRaw, "ipfs://"):
        resolved = "/ipfs/" + SliceBytes(targetRaw, len("ipfs://"), len(targetRaw) - len("ipfs://"))
    elif startsWith(targetRaw, "cid://"):
        resolved = "/ipfs/" + SliceBytes(targetRaw, len("cid://"), len(targetRaw) - len("cid://"))
    elif startsWith(targetRaw, "cid:"):
        resolved = "/ipfs/" + SliceBytes(targetRaw, len("cid:"), len(targetRaw) - len("cid:"))
    else:
        resolved = "/ipns/" + targetRaw
    return dupCString("{\"value\":" + toJsonStringValue(strings.CloneStr(resolved)) + "}")

@exportc("libp2p_poll_events")
fn libp2p_poll_events(handle: int64, maxEventsRequested: int32): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("[]")
    let payload: str = DrainNodeEvents(node, maxEventsRequested)
    return dupCString(strings.CloneStr(payload))

@exportc("libp2p_poll_events_cstr")
fn libp2p_poll_events_cstr(handle: int64, maxEventsRequested: int32): cstring =
    return libp2p_poll_events(handle, maxEventsRequested)

# Blocking wait on the same EventQueue that libp2p_poll_events drains
# (peer.connected / mDNS / entity=discovery). Peek node->eventsCount only;
# drain stays in poll_events. 1 when count>0, 0 on timeout, -1 on bad handle.
# Poll-only queue, so the 25ms sleep is the honest wait granularity.
@exportc("libp2p_wait_events")
fn libp2p_wait_events(handle: int64, timeoutMs: int32): int32 =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return -1
    let deadlineMs: int64 = nowMs() + timeoutMs
    while true:
        if node->eventsCount > 0:
            return 1
        if nowMs() >= deadlineMs:
            return 0
        let _ = c_usleep(25000)
    return 0

@exportc("libp2p_wait_events_cstr")
fn libp2p_wait_events_cstr(handle: int64, timeoutMs: int32): int32 =
    return libp2p_wait_events(handle, timeoutMs)

