    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let safeLimit: int32 =
        if limit <= 0:
            nodeResourceRefreshPeerLimit
        elif limit > maxPeersPerNode:
            maxPeersPerNode
        else:
            limit
    node->nodeResourceLastRefreshAtMs = nowMs()
    return dupCString("{\"ok\":true,\"updated\":0,\"limit\":" + $safeLimit + "}")

