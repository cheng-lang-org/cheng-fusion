fn ListenAddrResolvedAt(index: int32, swIdx: int32, storeDefault: bool): str =
    let hostListen: str =
        if swIdx >= 0:
            trimText(um_hostListenAddrTextIndex(swIdx))
        else:
            ""
    if len(hostListen) > 0:
        StoreListenAddrAt(index, hostListen)
        return strings.CloneStr(hostListen)
    let existing: str = trimText(CloneListenAddrAt(index))
    if len(existing) > 0:
        return existing
    if storeDefault:
        StoreListenAddrAt(index, defaultListenAddr)
    return strings.CloneStr(defaultListenAddr)

