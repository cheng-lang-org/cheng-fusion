fn setSwitchUsed(index: int32, used: bool) =
    if used:
        setSwitchUsedTrue(index)
        return
    setSwitchUsedFalse(index)

fn switchValueAt(index: int32): switch.Switch =
    if index == 0:
        return gSwitch0
    if index == 1:
        return gSwitch1
    if index == 2:
        return gSwitch2
    if index == 3:
        return gSwitch3
    if index == 4:
        return gSwitch4
    if index == 5:
        return gSwitch5
    if index == 6:
        return gSwitch6
    if index == 7:
        return gSwitch7
    var empty: switch.Switch
    return empty

