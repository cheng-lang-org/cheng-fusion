@exportc("libp2p_update_host_network_status")
fn libp2p_update_host_network_status(handle: int64, payloadJsonPtr: void*): bool =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("update_host_network_status: invalid handle")
    let payloadJson: str = trimText(voidPtrText(payloadJsonPtr))
    if !isJsonObjectPayload(payloadJson):
        return failWith("update_host_network_status: invalid_json")
    StoreHostNetworkStatusAt(idx, payloadJson)
    emitNodeEvent(node, "host.network.status", strings.CloneStr(payloadJson))
    return true

@exportc("libp2p_get_host_network_status_json")
fn libp2p_get_host_network_status_json(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{}")
    return dupCString(normalizeJsonPayload(CloneHostNetworkStatusAt(idx)))

