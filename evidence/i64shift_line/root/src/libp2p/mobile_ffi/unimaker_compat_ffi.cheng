        return
    if index == 3:
        peerRecordMeasurement(gNode3, peerOwned, upBps, downBps, txBytes, rxBytes, latencyMs, relayed)
        return
    if index == 4:
        peerRecordMeasurement(gNode4, peerOwned, upBps, downBps, txBytes, rxBytes, latencyMs, relayed)
        return
    if index == 5:
