    return true

@exportc("libp2p_notify_push_wakeup")
fn libp2p_notify_push_wakeup(handle: int64, peerIdPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("notify_push_wakeup: invalid handle")
    let peerIdText: str =
        if peerIdPtr == nil:
            ""
        else:
            canonicalPeerIdOrEmpty(trimText(voidPtrText(peerIdPtr)))
    if len(peerIdText) <= 0:
        return failWith("notify_push_wakeup: missing peerId")
    StorePendingWakeupPeerAt(idx, peerIdText)
    node->pushWakeupCount = node->pushWakeupCount + 1
    emitNodeEvent(node, "push_to_punch.wakeup", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + "}")
    return true

@exportc("libp2p_push_to_punch")
fn libp2p_push_to_punch(handle: int64, peerIdPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("push_to_punch: invalid handle")
    if !(node->started):
        emitNodeEvent(node, "push_to_punch.failed", "{\"reason\":\"not_started\"}")
        return failWith("push_to_punch: not started")
    var peerIdText: str =
        if peerIdPtr == nil:
            ""
        else:
            canonicalPeerIdOrEmpty(trimText(voidPtrText(peerIdPtr)))
    if len(peerIdText) <= 0:
        peerIdText = canonicalPeerIdOrEmpty(ClonePendingWakeupPeerAt(idx))
    if len(peerIdText) <= 0:
        node->pushFailedCount = node->pushFailedCount + 1
        emitNodeEvent(node, "push_to_punch.failed", "{\"reason\":\"missing_peer\"}")
        return failWith("push_to_punch: missing peer")
    let recovered: bool = pushToPunchReconnectPtr(node, peerIdText)
    if recovered:
        setPeerHibernatedPtr(node, peerIdText, false)
        StorePendingWakeupPeerAt(idx, "")
        node->pushRecoveredCount = node->pushRecoveredCount + 1
        emitNodeEvent(node, "push_to_punch.recovered", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + "}")
        return true
    node->pushFailedCount = node->pushFailedCount + 1
    emitNodeEvent(node, "push_to_punch.failed", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"error\":" + toJsonStringValue(strings.CloneStr(gLastError)) + "}")
    return false

