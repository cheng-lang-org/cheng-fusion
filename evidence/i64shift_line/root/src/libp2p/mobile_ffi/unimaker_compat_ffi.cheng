@borrows
fn registerSharedFilePtr(node: NodeRuntime*, keyText: str, pathText: str, fileNameText: str, mimeTypeText: str, sha256Text: str, sizeBytes: int64): bool =
    let index: int32 = nodePtrIndex(node)
    let keyOwned: str = strings.CloneStr(keyText)
    let pathOwned: str = strings.CloneStr(pathText)
    let fileOwned: str = strings.CloneStr(fileNameText)
    let mimeOwned: str = strings.CloneStr(mimeTypeText)
    let shaOwned: str = strings.CloneStr(sha256Text)
    if index == 0:
        return registerSharedFile(gNode0, keyOwned, pathOwned, fileOwned, mimeOwned, shaOwned, sizeBytes)
    if index == 1:
        return registerSharedFile(gNode1, keyOwned, pathOwned, fileOwned, mimeOwned, shaOwned, sizeBytes)
    if index == 2:
        return registerSharedFile(gNode2, keyOwned, pathOwned, fileOwned, mimeOwned, shaOwned, sizeBytes)
    if index == 3:
        return registerSharedFile(gNode3, keyOwned, pathOwned, fileOwned, mimeOwned, shaOwned, sizeBytes)
    if index == 4:
        return registerSharedFile(gNode4, keyOwned, pathOwned, fileOwned, mimeOwned, shaOwned, sizeBytes)
    if index == 5:
        return registerSharedFile(gNode5, keyOwned, pathOwned, fileOwned, mimeOwned, shaOwned, sizeBytes)
    if index == 6:
        return registerSharedFile(gNode6, keyOwned, pathOwned, fileOwned, mimeOwned, shaOwned, sizeBytes)
    if index == 7:
        return registerSharedFile(gNode7, keyOwned, pathOwned, fileOwned, mimeOwned, shaOwned, sizeBytes)
    return false

@borrows
fn feedEntryTotal(node: var NodeRuntime): int32 =
    let count: int32 = node.feedEntryCount
    let n: int32 = len(node.feedEntries)
    if count < n:
        return count
    return n

fn feedItemsArrayJson(node: var NodeRuntime): str =
    var out: str = "["
    let total: int32 = if node.feedEntryCount < len(node.feedEntries): node.feedEntryCount else: len(node.feedEntries)
    var i: int32
    while i < total:
        if i > 0:
            out = out + ","
        out = out + normalizeJsonPayload(node.feedEntries[i])
        i = i + 1
    out = out + "]"
    return out

# Drain any pending gossip-inbox messages into the local feed, routing each by
# topic prefix to its store-and-dedup handler. Single shared consumer queue
# (lp.hostGossipsubNextMessageWire): social-publish and distributed-content
# wire messages are each unwrapped and stored; anything else is drained and
# dropped (unmatched topics were never delivered here, since receiving a topic
# requires having subscribed to it). Bounded so a flood cannot spin.
fn drainInboundGossipMessages(node: var NodeRuntime): int32 =
    let socialPrefix: str = socialPublishMetadataTopic + charToStr(chr(31))
    let contentPrefix: str = contentAnnounceTopic + charToStr(chr(31))
    var stored: int32
    var guard: int32
    while guard < 512:
        guard = guard + 1
        let wire: str = gossipsub.gossipsubNextMessageWire()
        if len(wire) <= 0:
            break
        if startsWith(wire, socialPrefix):
            let data: str = strings.CloneStr(SliceBytes(wire, len(socialPrefix), len(wire)))
            let storeRes: Result[str] = storeReceivedSocialPublishMetadata(node, data)
            if !IsErr(storeRes):
                stored = stored + 1
        elif startsWith(wire, contentPrefix):
            let data: str = strings.CloneStr(SliceBytes(wire, len(contentPrefix), len(wire)))
            let storeRes: Result[str] = storeReceivedContentAnnounce(node, data)
            if !IsErr(storeRes):
                stored = stored + 1
    return stored

# Native equivalent of the Kotlin reflection shell's chengNodeContentsRefreshFromNative:
# ensure the social-publish gossip subscription, dial the target peer, drain inbound
# announces into the local feed, then return the feed items under the `{ok,items}`
# envelope the retained scene's __csg_scene_apply_node_contents_refresh consumes.
@exportc("libp2p_feed_node_contents")
fn libp2p_feed_node_contents(handle: int64, peerIdPtr: void*, useNetwork: int32): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("feed_node_contents: node_not_initialized")
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    var subscribed: bool
    if useNetwork != 0:
        subscribed = um_hostGossipsubSubscribe(socialPublishMetadataTopic)
        let peerIdText: str = trimText(voidPtrText(peerIdPtr))
        if len(peerIdText) > 0:
            let _ = callHostDialPeerPtr(node, peerIdText)
    let _ = drainInboundGossipMessagesPtr(node)
    let itemsJson: str = feedItemsArrayJsonPtr(node)
    let total: int32 = feedEntryTotalPtr(node)
    let subFlag: str = if subscribed: "true" else: "false"
    return dupCString("{\"ok\":true,\"subscribed\":" + subFlag + ",\"items\":" + itemsJson + ",\"totalCount\":" + $total + "}")

@borrows
fn publishTasksJson(node: var NodeRuntime, limit: int32): str =
    let total: int32 = if node.publishTaskCount < len(node.publishTasks): node.publishTaskCount else: len(node.publishTasks)
    let cap: int32 = if limit <= 0 || limit > total: total else: limit
    var out: str = "{\"items\":["
    var i: int32
    while i < cap:
        if i > 0:
            out = out + ","
        out = out + normalizeJsonPayload(node.publishTasks[i])
        i = i + 1
    out = out + "],\"nextCursor\":\"\",\"hasMore\":false}"
    return out

@borrows
fn findPublishTaskJson(node: var NodeRuntime, taskId: str): str =
    let target: str = trimText(taskId)
    if len(target) <= 0:
        return ""
    let total: int32 = if node.publishTaskCount < len(node.publishTasks): node.publishTaskCount else: len(node.publishTasks)
    var i: int32
    while i < total:
        if i < len(node.publishTaskIds) && node.publishTaskIds[i] == target:
            return node.publishTasks[i]
        if i < len(node.publishContentIds) && node.publishContentIds[i] == target:
            return node.publishTasks[i]
        i = i + 1
    return ""

fn activeNodeForDmHandler(): NodeRuntime* =
    var i: int32
    while i < maxNodes:
        let node: NodeRuntime* = nodePtrAt(i)
        if node != nil && node->used && node->started:
            return node
        i = i + 1
    var j: int32
    while j < maxNodes:
        let node: NodeRuntime* = nodePtrAt(j)
        if node != nil && node->used:
            return node
        j = j + 1
    return nil

@borrows
fn sharedFileIndex(node: var NodeRuntime, keyText: str): int32 =
    let normalizedKey: str = trimText(keyText)
    if len(normalizedKey) <= 0:
        return -1
    let sharedLen: int32 = len(node.sharedFiles)
    var total: int32 = node.sharedFileCount
    if sharedLen < total:
        total = sharedLen
    var i: int32
    while i < total:
        if trimText(node.sharedFiles[i].key) == normalizedKey:
            return i
        i = i + 1
    return -1

@borrows
fn fileSizeBytes(path: str): int64 =
    let safePath: str = normalizeFsPath(trimText(path))
    if len(safePath) <= 0:
        return 0
    let f: int64 = c_cheng_fopen(cStr(safePath), cStr("rb"))
    if f == 0:
        return 0
    if c_cheng_fseek(f, 0, fileSeekEnd) != 0:
        c_cheng_fclose(f)
        return 0
    let size: int64 = c_cheng_ftell(f)
    c_cheng_fclose(f)
    if size > 0:
        return size
    return 0

@borrows
fn readFileChunk(path: str, offset: int64, maxBytes: int32): Result[Bytes] =
    let safePath: str = normalizeFsPath(trimText(path))
    if len(safePath) <= 0:
        return Err[Bytes]("shared_file_path_missing")
    let f: int64 = c_cheng_fopen(cStr(safePath), cStr("rb"))
    if f == 0:
        return Err[Bytes]("shared_file_open_failed")
    if c_cheng_fseek(f, 0, fileSeekEnd) != 0:
        c_cheng_fclose(f)
        return Err[Bytes]("shared_file_seek_end_failed")
    let totalSize: int64 = c_cheng_ftell(f)
    let safeOffset: int64 = if offset > 0: offset else: 0
    if safeOffset >= totalSize:
        c_cheng_fclose(f)
        var empty: Bytes
        return Ok[Bytes](empty)
    if c_cheng_fseek(f, safeOffset, fileSeekSet) != 0:
        c_cheng_fclose(f)
        return Err[Bytes]("shared_file_seek_failed")
    let remaining: int64 = totalSize - safeOffset
    var chunkSize: int32 =
        if maxBytes > 0:
            maxBytes
        elif remaining > 65536:
            65536
        else:
            int32(remaining)
    if remaining < int64(chunkSize):
        chunkSize = int32(remaining)
    if chunkSize <= 0:
        c_cheng_fclose(f)
        var empty: Bytes
        return Ok[Bytes](empty)
    var out: Bytes = BytesAlloc(chunkSize)
    let readCount: int32 = c_cheng_fread(out.data, 1, chunkSize, f)
    c_cheng_fclose(f)
    if readCount < 0:
        return Err[Bytes]("shared_file_read_failed")
    if readCount <= 0:
        var empty: Bytes
        return Ok[Bytes](empty)
    if readCount < out.len:
        out.len = readCount
    return Ok[Bytes](out)

fn registerSharedFile(
    node: var NodeRuntime,
    keyText: str,
    pathText: str,
    fileNameText: str,
    mimeTypeText: str,
    sha256Text: str,
    sizeBytes: int64
): bool =
    let normalizedKey: str = trimText(keyText)
    let normalizedPath: str = normalizeFsPath(trimText(pathText))
    if len(normalizedKey) <= 0 || len(normalizedPath) <= 0 || !fileExists(strings.CloneStr(normalizedPath)):
        return false
    var resolvedSizeBytes: int64 = sizeBytes
    if resolvedSizeBytes <= 0:
        resolvedSizeBytes = fileSizeBytes(strings.CloneStr(normalizedPath))
    var entry: SharedFileEntry
    entry.key = strings.CloneStr(normalizedKey)
    entry.path = strings.CloneStr(normalizedPath)
    entry.fileName = trimText(fileNameText)
    entry.mimeType = trimText(mimeTypeText)
    entry.sha256 = trimText(sha256Text)
    entry.sizeBytes = resolvedSizeBytes
    entry.registeredAtMs = nowMs()
    if len(entry.fileName) <= 0:
        entry.fileName = baseName(strings.CloneStr(normalizedPath))
    let existingIdx: int32 = sharedFileIndex(node, strings.CloneStr(normalizedKey))
    if existingIdx >= 0:
        node.sharedFiles[existingIdx] = entry
        node.sharedFileCount = len(node.sharedFiles)
        return true
    let sharedTotal: int32 = len(node.sharedFiles)
    if !(sharedTotal < maxSharedFiles):
        var nextEntries: SharedFileEntry[]
        var i: int32 = 1
        while i < len(node.sharedFiles):
            add(nextEntries, CloneSharedFileFromNode(node, i))
            i = i + 1
        add(nextEntries, entry)
        node.sharedFiles = nextEntries
        node.sharedFileCount = len(nextEntries)
        return true
    add(node.sharedFiles, entry)
    node.sharedFileCount = len(node.sharedFiles)
    return true

fn registerSharedFileProvider(node: var NodeRuntime, keyText: str) =
    let keyValue: str = trimText(keyText)
    if len(keyValue) <= 0:
        return
    keyValue

fn buildFileChunkMetaJson(entry: SharedFileEntry, offset: int64, chunkSize: int32): str =
    let pathText: str = strings.CloneStr(entry.path)
    let keyOwned: str = strings.CloneStr(entry.key)
    let mimeOwned: str = strings.CloneStr(entry.mimeType)
    let nameOwned: str = strings.CloneStr(entry.fileName)
    let shaOwned: str = strings.CloneStr(entry.sha256)
    let sizeBytes: int64 = entry.sizeBytes
    let totalSize: int64 = if sizeBytes > 0: sizeBytes else: fileSizeBytes(pathText)
    let eofText: str = if offset + int64(chunkSize) >= totalSize: "true" else: "false"
    return "{\"ok\":true,\"kind\":\"media_chunk\",\"key\":" + toJsonStringValue(strings.CloneStr(keyOwned)) +
        ",\"offset\":" + $offset +
        ",\"chunkSize\":" + $chunkSize +
        ",\"totalSize\":" + $totalSize +
        ",\"eof\":" + eofText +
        ",\"mimeType\":" + toJsonStringValue(strings.CloneStr(mimeOwned)) +
        ",\"fileName\":" + toJsonStringValue(strings.CloneStr(nameOwned)) +
        ",\"sha256\":" + toJsonStringValue(strings.CloneStr(shaOwned)) + "}"

@borrows
fn buildFileChunkErrorJson(keyText: str, errText: str): str =
    return "{\"ok\":false,\"kind\":\"media_chunk\",\"key\":" + toJsonStringValue(trimText(keyText)) +
        ",\"error\":" + toJsonStringValue(trimText(errText)) + "}"

fn boolJson(value: bool): str =
    if value:
        return "true"
    return "false"

fn nativeMoqStreamRequiredJson(): str =
    return joinText([
        "{\"ok\":false,\"error\":\"native_quic_moq_stream_required\",\"transport\":",
        toJsonStringValue(strings.CloneStr(nativeMoqStreamTransport)),
        "}"
    ])

fn nativeMoqStreamRequiredReasonJson(reasonText: str, peerIdText: str, addrText: str): str =
    var out: str = joinText([
        "{\"ok\":false,\"error\":\"native_quic_moq_stream_required\",\"transport\":",
        toJsonStringValue(strings.CloneStr(nativeMoqStreamTransport)),
        ",\"reason\":",
        toJsonStringValue(trimText(reasonText))
    ])
    let peerValue: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(peerValue) > 0:
        out = joinText([out, ",\"peerId\":", toJsonStringValue(strings.CloneStr(peerValue))])
    let addrValue: str = trimText(addrText)
    if len(addrValue) > 0:
        out = joinText([out, ",\"candidateAddr\":", toJsonStringValue(strings.CloneStr(addrValue))])
    return joinText([out, "}"])

fn nativeMoqStreamRequiredStateJson(reasonText: str,
                                    peerIdText: str,
                                    addrText: str,
                                    connectedValue: bool,
                                    dialedValue: bool,
                                    detailText: str): str =
    var out: str = joinText([
        "{\"ok\":false,\"error\":\"native_quic_moq_stream_required\",\"transport\":",
        toJsonStringValue(strings.CloneStr(nativeMoqStreamTransport)),
        ",\"reason\":",
        toJsonStringValue(trimText(reasonText)),
        ",\"connected\":",
        boolJson(connectedValue),
        ",\"dialed\":",
        boolJson(dialedValue)
    ])
    let peerValue: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(peerValue) > 0:
        out = joinText([out, ",\"peerId\":", toJsonStringValue(strings.CloneStr(peerValue))])
    let addrValue: str = trimText(addrText)
    if len(addrValue) > 0:
        out = joinText([out, ",\"candidateAddr\":", toJsonStringValue(strings.CloneStr(addrValue))])
    let detailValue: str = trimText(detailText)
    if len(detailValue) > 0:
        out = joinText([out, ",\"detail\":", toJsonStringValue(strings.CloneStr(detailValue))])
    return joinText([out, "}"])

fn moqStreamErrorJson(errorText: str): str =
    return joinText([
        "{\"ok\":false,\"error\":",
        toJsonStringValue(trimText(errorText)),
        ",\"transport\":",
        toJsonStringValue(strings.CloneStr(nativeMoqStreamTransport)),
        "}"
    ])

fn writeBytesToFile(path: str, data: Bytes): bool =
    let safePath: str = normalizeFsPath(trimText(path))
    if len(safePath) <= 0:
        return false
    let dataLen: int32 = BytesLen(data)
    if dataLen <= 0:
        return false
    let f: int64 = c_cheng_fopen(cStr(safePath), cStr("wb"))
    if f == 0:
        return false
    let wrote: int32 = c_cheng_fwrite(data.data, 1, dataLen, f)
    c_cheng_fclose(f)
    return wrote == dataLen

fn mobileMoqMinInt(left: int32, right: int32): int32 =
    if left < right:
        return left
    return right

fn mobileMoqWriteInt32(out: var Bytes, offset: int32, value: int32) =
    BytesSet(out, offset, (value >> 24) & 255)
    BytesSet(out, offset + 1, (value >> 16) & 255)
    BytesSet(out, offset + 2, (value >> 8) & 255)
    BytesSet(out, offset + 3, value & 255)

fn mobileMoqReadInt32(data: Bytes, offset: int32): Result[int32] =
    if offset < 0 || offset + 4 > BytesLen(data):
        return Err[int32]("moq stream ffi: int32 out of bounds")
    let b0: int32 = BytesGet(data, offset) & 255
    let b1: int32 = BytesGet(data, offset + 1) & 255
    let b2: int32 = BytesGet(data, offset + 2) & 255
    let b3: int32 = BytesGet(data, offset + 3) & 255
    return Ok[int32]((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)

fn mobileMoqCopyInto(dst: var Bytes, offset: int32, src: Bytes): Result[int32] =
    if offset < 0:
        return Err[int32]("moq stream ffi: negative copy offset")
    let srcLen: int32 = BytesLen(src)
    if srcLen <= 0:
        return Ok[int32](0)
    if offset + srcLen > BytesLen(dst):
        return Err[int32]("moq stream ffi: copy past end")
    var i: int32
    while i < srcLen:
        BytesSet(dst, offset + i, BytesGet(src, i))
        i = i + 1
    return Ok[int32](srcLen)

fn mobileMoqBytesEqual(left: Bytes, right: Bytes): bool =
    let leftLen: int32 = BytesLen(left)
    if leftLen != BytesLen(right):
        return false
    var i: int32
    while i < leftLen:
        if BytesGet(left, i) != BytesGet(right, i):
            return false
        i = i + 1
    return true

fn mobileMoqReadExact(conn: var qconn.Connection, byteCount: int32): Result[Bytes] =
    if byteCount < 0:
        return Err[Bytes]("moq stream ffi: negative exact read")
    if byteCount == 0:
        var empty: Bytes
        return Ok[Bytes](empty)
    var out: Bytes
    var readBytes: int32
    while readBytes < byteCount:
        let want: int32 = mobileMoqMinInt(byteCount - readBytes, mediaRpcBinaryChunkBytes)
        let readRes: Result[Bytes] = qconn.QuicConnRead(conn, want)
        if IsErr(readRes):
            return Err[Bytes](ErrorText(readRes))
        let chunk: Bytes = Value(readRes)
        let chunkLen: int32 = BytesLen(chunk)
        if chunkLen <= 0:
            return Err[Bytes]("moq stream ffi: empty exact read")
        out = BytesConcat(out, chunk)
        readBytes = readBytes + chunkLen
    return Ok[Bytes](out)

fn mobileMoqWriteFrame(conn: var qconn.Connection, payload: Bytes): Result[int32] =
    let payloadLen: int32 = BytesLen(payload)
    if payloadLen <= 0:
        return Err[int32]("moq stream ffi: empty frame")
    let frame: Bytes = BytesAlloc(payloadLen + 4)
    mobileMoqWriteInt32(frame, 0, payloadLen)
    let copyRes: Result[int32] = mobileMoqCopyInto(frame, 4, payload)
    if IsErr(copyRes):
        return Err[int32](ErrorText(copyRes))
    let writeRes: Result[int32] = qconn.QuicConnWrite(conn, frame)
    if IsErr(writeRes):
        return Err[int32](ErrorText(writeRes))
    if Value(writeRes) != BytesLen(frame):
        return Err[int32]("moq stream ffi: short frame write")
    return Ok[int32](payloadLen)

fn mobileMoqReadFrame(conn: var qconn.Connection, maxPayloadBytes: int32): Result[Bytes] =
    let headerRes: Result[Bytes] = mobileMoqReadExact(conn, 4)
    if IsErr(headerRes):
        return Err[Bytes](ErrorText(headerRes))
    let payloadLenRes: Result[int32] = mobileMoqReadInt32(Value(headerRes), 0)
    if IsErr(payloadLenRes):
        return Err[Bytes](ErrorText(payloadLenRes))
    let payloadLen: int32 = Value(payloadLenRes)
    if payloadLen <= 0:
        return Err[Bytes]("moq stream ffi: empty frame payload")
    if payloadLen > maxPayloadBytes:
        return Err[Bytes]("moq stream ffi: frame too large")
    return mobileMoqReadExact(conn, payloadLen)

fn mobileMoqClientNegotiate(conn: var qconn.Connection): Result[bool] =
    let selectBytes: Bytes = BytesFromString(nativeMoqStreamProtocolSelect)
    let writeRes: Result[int32] = qconn.QuicConnWrite(conn, selectBytes)
    if IsErr(writeRes):
        return Err[bool](ErrorText(writeRes))
    if Value(writeRes) != BytesLen(selectBytes):
        return Err[bool]("moq stream ffi: short negotiate write")
    let ackRes: Result[Bytes] = mobileMoqReadExact(conn, BytesLen(selectBytes))
    if IsErr(ackRes):
        return Err[bool](ErrorText(ackRes))
    if !mobileMoqBytesEqual(Value(ackRes), selectBytes):
        return Err[bool]("moq stream ffi: protocol negotiate mismatch")
    return Ok[bool](true)

fn mobileMoqServerNegotiate(conn: var qconn.Connection): Result[bool] =
    let selectBytes: Bytes = BytesFromString(nativeMoqStreamProtocolSelect)
    let selectRes: Result[Bytes] = mobileMoqReadExact(conn, BytesLen(selectBytes))
    if IsErr(selectRes):
        return Err[bool](ErrorText(selectRes))
    if !mobileMoqBytesEqual(Value(selectRes), selectBytes):
        return Err[bool]("moq stream ffi: protocol select mismatch")
    let writeRes: Result[int32] = qconn.QuicConnWrite(conn, selectBytes)
    if IsErr(writeRes):
        return Err[bool](ErrorText(writeRes))
    if Value(writeRes) != BytesLen(selectBytes):
        return Err[bool]("moq stream ffi: short negotiate ack write")
    return Ok[bool](true)

fn mobileMoqReadTextField(payload: Bytes, cursor: var int32): Result[str] =
    let lenRes: Result[int32] = mobileMoqReadInt32(payload, cursor)
    if IsErr(lenRes):
        return Err[str](ErrorText(lenRes))
    let fieldLen: int32 = Value(lenRes)
    cursor = cursor + 4
    if fieldLen <= 0:
        return Err[str]("moq stream ffi: empty text field")
    if cursor < 0 || cursor + fieldLen > BytesLen(payload):
        return Err[str]("moq stream ffi: text field out of bounds")
    let fieldBytes: Bytes = BytesSlice(payload, cursor, fieldLen)
    cursor = cursor + fieldLen
    return Ok[str](BytesToString(fieldBytes))

fn mobileMoqReadInt32Field(payload: Bytes, cursor: var int32): Result[int32] =
    let valueRes: Result[int32] = mobileMoqReadInt32(payload, cursor)
    if IsErr(valueRes):
        return Err[int32](ErrorText(valueRes))
    cursor = cursor + 4
    return valueRes

fn mobileMoqParseServeRequest(payload: Bytes): Result[MoqServeRequest] =
    var cursor: int32
    let magicRes: Result[str] = mobileMoqReadTextField(payload, cursor)
    if IsErr(magicRes):
        return Err[MoqServeRequest](ErrorText(magicRes))
    if Value(magicRes) != nativeMoqStreamWireMagic:
        return Err[MoqServeRequest]("moq stream ffi: magic mismatch")
    let streamKeyRes: Result[str] = mobileMoqReadTextField(payload, cursor)
    if IsErr(streamKeyRes):
        return Err[MoqServeRequest](ErrorText(streamKeyRes))
    let keyRes: Result[str] = mobileMoqReadTextField(payload, cursor)
    if IsErr(keyRes):
        return Err[MoqServeRequest](ErrorText(keyRes))
    let offsetRes: Result[int32] = mobileMoqReadInt32Field(payload, cursor)
    if IsErr(offsetRes):
        return Err[MoqServeRequest](ErrorText(offsetRes))
    let lengthRes: Result[int32] = mobileMoqReadInt32Field(payload, cursor)
    if IsErr(lengthRes):
        return Err[MoqServeRequest](ErrorText(lengthRes))
    let readChunkRes: Result[int32] = mobileMoqReadInt32Field(payload, cursor)
    if IsErr(readChunkRes):
        return Err[MoqServeRequest](ErrorText(readChunkRes))
    if cursor != BytesLen(payload):
        return Err[MoqServeRequest]("moq stream ffi: trailing request bytes")
    let request: MoqServeRequest = MoqServeRequest(
        streamKey: trimText(Value(streamKeyRes)),
        key: trimText(Value(keyRes)),
        offsetBytes: Value(offsetRes),
        lengthBytes: Value(lengthRes),
        readChunkBytes: Value(readChunkRes)
    )
    if len(request.streamKey) <= 0 || len(request.key) <= 0:
        return Err[MoqServeRequest]("moq stream ffi: missing request key")
    if request.offsetBytes < 0 || request.lengthBytes <= 0 || request.readChunkBytes <= 0:
        return Err[MoqServeRequest]("moq stream ffi: invalid request range")
    return Ok[MoqServeRequest](request)

fn mobileMoqRequestPayloadBytes(streamKeyText: str,
                                keyText: str,
                                offsetBytes: int32,
                                lengthBytes: int32,
                                readChunkBytes: int32): Result[Bytes] =
    if len(streamKeyText) <= 0:
        return Err[Bytes]("moq stream ffi: missing stream key")
    if len(keyText) <= 0:
        return Err[Bytes]("moq stream ffi: missing segment key")
    if offsetBytes < 0:
        return Err[Bytes]("moq stream ffi: negative offset")
    if lengthBytes <= 0:
        return Err[Bytes]("moq stream ffi: empty range")
    if readChunkBytes <= 0:
        return Err[Bytes]("moq stream ffi: empty read chunk")
    let magicBytes: Bytes = BytesFromString(nativeMoqStreamWireMagic)
    let streamBytes: Bytes = BytesFromString(streamKeyText)
    let keyBytes: Bytes = BytesFromString(keyText)
    let payloadLen: int32 = 4 + BytesLen(magicBytes) + 4 + BytesLen(streamBytes) + 4 + BytesLen(keyBytes) + 12
    if payloadLen > nativeMoqStreamMaxRequestBytes:
        return Err[Bytes]("moq stream ffi: request too large")
    let out: Bytes = BytesAlloc(payloadLen)
    var cursor: int32
    mobileMoqWriteInt32(out, cursor, BytesLen(magicBytes))
    cursor = cursor + 4
    let magicCopyRes: Result[int32] = mobileMoqCopyInto(out, cursor, magicBytes)
    if IsErr(magicCopyRes):
        return Err[Bytes](ErrorText(magicCopyRes))
    cursor = cursor + BytesLen(magicBytes)
    mobileMoqWriteInt32(out, cursor, BytesLen(streamBytes))
    cursor = cursor + 4
    let streamCopyRes: Result[int32] = mobileMoqCopyInto(out, cursor, streamBytes)
    if IsErr(streamCopyRes):
        return Err[Bytes](ErrorText(streamCopyRes))
    cursor = cursor + BytesLen(streamBytes)
    mobileMoqWriteInt32(out, cursor, BytesLen(keyBytes))
    cursor = cursor + 4
    let keyCopyRes: Result[int32] = mobileMoqCopyInto(out, cursor, keyBytes)
    if IsErr(keyCopyRes):
        return Err[Bytes](ErrorText(keyCopyRes))
    cursor = cursor + BytesLen(keyBytes)
    mobileMoqWriteInt32(out, cursor, offsetBytes)
    cursor = cursor + 4
    mobileMoqWriteInt32(out, cursor, lengthBytes)
    cursor = cursor + 4
    mobileMoqWriteInt32(out, cursor, readChunkBytes)
    return Ok[Bytes](out)

fn mobileMoqClientOpen(conn: var qconn.Connection,
                       streamKeyText: str,
                       keyText: str,
                       offsetBytes: int32,
                       lengthBytes: int32): Result[bool] =
    let payloadRes: Result[Bytes] = mobileMoqRequestPayloadBytes(streamKeyText, keyText, offsetBytes, lengthBytes, mediaRpcBinaryChunkBytes)
    if IsErr(payloadRes):
        return Err[bool](ErrorText(payloadRes))
    let frameRes: Result[int32] = mobileMoqWriteFrame(conn, Value(payloadRes))
    if IsErr(frameRes):
        return Err[bool](ErrorText(frameRes))
    return Ok[bool](true)

fn moqServeOnceErrorJson(errorText: str): str =
    return joinText([
        "{\"ok\":false,\"transport\":",
        toJsonStringValue(strings.CloneStr(nativeMoqStreamTransport)),
        ",\"error\":",
        toJsonStringValue(trimText(errorText)),
        "}"
    ])

fn moqServeOnceOkJson(request: MoqServeRequest, servedBytes: int32): str =
    return joinText([
        "{\"ok\":true,\"transport\":",
        toJsonStringValue(strings.CloneStr(nativeMoqStreamTransport)),
        ",\"streamKey\":",
        toJsonStringValue(request.streamKey),
        ",\"key\":",
        toJsonStringValue(request.key),
        ",\"offset\":",
        Int64ToStr(int64(request.offsetBytes)),
        ",\"length\":",
        Int64ToStr(int64(request.lengthBytes)),
        ",\"servedBytes\":",
        Int64ToStr(int64(servedBytes)),
        "}"
    ])

fn moqServeOnceNode(node: var NodeRuntime, waitMs: int32): cstring =
    if !node.used || !node.started:
        setLastError("moq_serve_once: node_not_initialized")
        return dupCString(moqServeOnceErrorJson("node_not_initialized"))
    waitMs
    setLastError("moq_serve_once: native_quic_moq_stream_handle_table_not_ready")
    return dupCString(moqServeOnceErrorJson("native_quic_moq_stream_handle_table_not_ready"))

fn moqStreamCloseJson(streamIdText: str): str =
    return joinText([
        "{\"ok\":true,\"transport\":",
        toJsonStringValue(strings.CloneStr(nativeMoqStreamTransport)),
        ",\"streamId\":",
        toJsonStringValue(trimText(streamIdText)),
        "}"
    ])

@borrows
fn CloneDmRequestText(req: DmEnvelope): str =
    if BytesLen(req.payload) > 0:
        return strings.CloneStr(BytesToString(req.payload))
    return strings.CloneStr(req.text)

fn mobileDmEnvelopeHandler(req: DmEnvelope): DmEnvelope =
    let requestText: str = CloneDmRequestText(req)
    let kindText: str = strLowerAscii(trimText(parseConfigQuotedValue(requestText, "kind")))
    if kindText != "media_chunk" && kindText != "file_chunk":
        return defaultDmEnvelopeHandler(req)
    var resp: DmEnvelope = initDmEnvelope()
    resp.id = req.id
    resp.kind = dmEnvelopeKindResponse
    let node: NodeRuntime* = activeNodeForDmHandler()
    if node == nil:
        resp.ok = false
        resp.errorMessage = "node_not_initialized"
        resp.text = buildFileChunkErrorJson("", resp.errorMessage)
        return resp
    let keyText: str = trimText(parseConfigQuotedValue(requestText, "key"))
    if len(keyText) <= 0:
        resp.ok = false
        resp.errorMessage = "shared_file_key_missing"
        resp.text = buildFileChunkErrorJson("", resp.errorMessage)
        return resp
    let offsetText: str = trimText(parseConfigQuotedValue(requestText, "offset"))
    let lengthText: str = trimText(parseConfigQuotedValue(requestText, "length"))
    let offset: int64 = if len(offsetText) > 0: parseFirstInt64(offsetText) else: 0
    let maxBytes: int32 = if len(lengthText) > 0: int32(parseFirstInt64(lengthText)) else: 65536
    let fileIdx: int32 = sharedFileIndexPtr(node, keyText)
    if fileIdx < 0:
        resp.ok = false
        resp.errorMessage = "shared_file_not_registered"
        resp.text = buildFileChunkErrorJson(keyText, resp.errorMessage)
        return resp
    let entry: SharedFileEntry = CloneSharedFileAt(nodePtrIndex(node), fileIdx)
    let chunkRes: Result[Bytes] = readFileChunk(entry.path, offset, maxBytes)
    if IsErr(chunkRes):
        resp.ok = false
        resp.errorMessage = strings.CloneStr(chunkRes.err.msg)
        resp.text = buildFileChunkErrorJson(keyText, resp.errorMessage)
        return resp
    let chunkBytes: Bytes = Value(chunkRes)
    resp.ok = true
    resp.payload = chunkBytes
    resp.text = buildFileChunkMetaJson(entry, offset, BytesLen(chunkBytes))
    return resp

@borrows
fn hasFeedSubscriber(node: var NodeRuntime, peerIdText: str): bool =
    let total: int32 = if node.feedSubscriberCount < len(node.feedSubscribers): node.feedSubscriberCount else: len(node.feedSubscribers)
    var i: int32
    while i < total:
        if node.feedSubscribers[i] == peerIdText:
            return true
        i = i + 1
    return false

fn addFeedSubscriber(node: var NodeRuntime, peerIdText: str): bool =
    if len(peerIdText) <= 0:
        return false
    if hasFeedSubscriber(node, peerIdText):
        return true
    if len(node.feedSubscribers) >= maxFeedSubs:
        return false
    add(node.feedSubscribers, strings.CloneStr(peerIdText))
    node.feedSubscriberCount = len(node.feedSubscribers)
    return true

fn removeFeedSubscriber(node: var NodeRuntime, peerIdText: str): bool =
    var next: str[]
    var removed: bool
    var i: int32
    let total: int32 = len(node.feedSubscribers)
    while i < total:
        let current: str = node.feedSubscribers[i]
        if !removed && current == peerIdText:
            removed = true
        else:
            add(next, strings.CloneStr(current))
        i = i + 1
    node.feedSubscribers = next
    node.feedSubscriberCount = len(next)
    return removed

fn addLiveStream(node: var NodeRuntime, streamKey: str): bool =
    if len(streamKey) <= 0:
        return false
    var i: int32
    let total: int32 = len(node.liveStreamKeys)
    while i < total:
        if node.liveStreamKeys[i] == streamKey:
            return true
        i = i + 1
    if total >= maxFeedSubs:
        return false
    add(node.liveStreamKeys, strings.CloneStr(streamKey))
    node.liveStreamCount = len(node.liveStreamKeys)
    return true

@borrows
fn hasLanGroup(node: var NodeRuntime, groupId: str): bool =
    let total: int32 = if node.lanGroupCount < len(node.lanGroups): node.lanGroupCount else: len(node.lanGroups)
    var i: int32
    while i < total:
        if node.lanGroups[i] == groupId:
            return true
        i = i + 1
    return false

fn addLanGroup(node: var NodeRuntime, groupId: str): bool =
    if len(groupId) <= 0:
        return false
    if hasLanGroup(node, groupId):
        return true
    if len(node.lanGroups) >= maxFeedSubs:
        return false
    add(node.lanGroups, strings.CloneStr(groupId))
    node.lanGroupCount = len(node.lanGroups)
    return true

fn removeLanGroup(node: var NodeRuntime, groupId: str): bool =
    var next: str[]
    var removed: bool
    var i: int32
    let total: int32 = len(node.lanGroups)
    while i < total:
        let current: str = node.lanGroups[i]
        if !removed && current == groupId:
            removed = true
        else:
            add(next, strings.CloneStr(current))
        i = i + 1
    node.lanGroups = next
    node.lanGroupCount = len(next)
    return removed

@exportc("NimMain")
fn NimMain() =
    debugNodeStep("[ffi] NimMain: enter")
    clearLastError()
    gLastNodePeerId = ""
    debugNodeStep("[ffi] NimMain: after clearLastError")
    var j: int32
    while j < maxNodes:
        debugNodeStep("[ffi] NimMain: loop=" + $j)
        let node: NodeRuntime* = ensureNodePtrAt(j)
        debugNodeStep("[ffi] NimMain: got slot ptr")
        if node != nil:
            markNodeUnused(node)
            debugNodeStep("[ffi] NimMain: cleared slot")
        setSwitchUsed(j, false)
        debugNodeStep("[ffi] NimMain: switch reset")
        j = j + 1
    debugNodeStep("[ffi] NimMain: done")

@exportc("nim_thread_attach")
fn nim_thread_attach() =
    0

@exportc("nim_thread_detach")
fn nim_thread_detach() =
    0

@exportc("libp2p_get_last_error")
fn libp2p_get_last_error(): cstring =
    return dupCString(cloneLastErrorText())

@exportc("libp2p_get_last_node_peer_id")
fn libp2p_get_last_node_peer_id(): cstring =
    return dupCString(trimText(strings.CloneStr(gLastNodePeerId)))

@exportc("libp2p_node_init")
fn libp2p_node_init(configJson: cstring): int64 =
    clearLastError()
    gLastInitStage = 10
    debugNodeStep("[ffi] node_init: begin")
    var slot: int32 = findFreeNodeSlot()
    if slot < 0:
        NimMain()
        slot = findFreeNodeSlot()
    if slot < 0:
        gLastInitStage = -10
        setLastError("node_init: no free slot")
        return 0
    debugNodeStep("[ffi] node_init: got slot")
    gLastInitStage = 20
    let configText: str =
        if configJson == nil:
            "{}"
        else:
            system.strFromCStringCopy(configJson)
    debugNodeStep("[ffi] node_init: parsed config text")
    var listenAddr: str = parseListenAddress(strings.CloneStr(configText))
    if len(trimText(listenAddr)) <= 0:
        listenAddr = defaultListenAddr
    debugNodeStep("[ffi] node_init: parsed listen addr")
    debugNodeStep("[ffi] node_init: before slot ptr")
    let slotNode: NodeRuntime* = ensureNodePtrAt(slot)
    if slotNode == nil:
        gLastInitStage = -20
        setLastError("node_init: slot ptr missing")
        return 0
    debugNodeStep("[ffi] node_init: slot ptr ok")
    debugNodeStep("[ffi] node_init: before clearNode")
    markNodeUnused(slotNode)
    debugNodeStep("[ffi] node_init: cleared node")
    slotNode->used = true
    debugNodeStep("[ffi] node_init: used=true")
    slotNode->started = false
    debugNodeStep("[ffi] node_init: state flags set")
    let swSlotPtr: switch.Switch* = switchPtrAt(slot)
    if swSlotPtr == nil:
        gLastInitStage = -30
        setLastError("node_init: switch slot missing")
        markNodeUnused(slotNode)
        return 0
    debugNodeStep("[ffi] node_init: switch ptr ok")
    let dataDir: str = parseDataDir(strings.CloneStr(configText))
    debugNodeStep("[ffi] node_init: dataDir=" + strings.CloneStr(dataDir))
    slotNode->dataDir = strings.CloneStr(dataDir)
    if len(trimText(dataDir)) > 0:
        if !ensureDirRecursive(dataDir):
            debugNodeStep("[ffi] node_init: ensureDirRecursive failed path=" + strings.CloneStr(dataDir))
    gLastInitStage = 30
    let hostOk: bool = initSwitchWithPersistentIdentity(swSlotPtr, listenAddr, dataDir)
    debugNodeStep("[ffi] node_init: after newHostWithAddressText")
    if !hostOk:
        gLastInitStage = -40
        setLastError("node_init: host init failed")
        markNodeUnused(slotNode)
        return 0
    gLastInitStage = 40
    setSwitchUsed(slot, true)
    debugNodeStep("[ffi] node_init: switch added")
    setDmEnvelopeHandler(mobileDmEnvelopeHandler)
    slotNode->switchIndex = slot
    var listenForHost: str = ownText(um_hostListenAddrTextIndex(slot))
    if len(listenForHost) <= 0:
        listenForHost = listenAddr
    slotNode->listenAddr = strings.CloneStr(listenForHost)
    debugNodeStep("[ffi] node_init: before host peer id")
    let hostPeerId: str = canonicalPeerIdOrEmpty(trimText(um_hostPeerIdTextIndex(slot)))
    debugNodeStep("[ffi] node_init: after host peer id len=" + $len(hostPeerId))
    let persistedPeerId: str = canonicalPeerIdOrEmpty(loadPersistedPeerId(dataDir))
    var peerForHost: str
    if len(persistedPeerId) > 0:
        peerForHost = ownText(persistedPeerId)
    elif len(hostPeerId) > 0:
        peerForHost = ownText(hostPeerId)
    else:
        peerForHost = ownText(forceDeterministicPeerId(slotNode))
    slotNode->localPeerId = strings.CloneStr(peerForHost)
    applyHostIdentityDirect(swSlotPtr, listenForHost, peerForHost)
    let hostPeerAfter: str = canonicalPeerIdOrEmpty(trimText(um_hostPeerIdTextIndex(slot)))
    if len(hostPeerAfter) > 0:
        peerForHost = ownText(hostPeerAfter)
        slotNode->localPeerId = strings.CloneStr(peerForHost)
    if len(canonicalPeerIdOrEmpty(strings.CloneStr(peerForHost))) <= 0:
        peerForHost = ownText(forceDeterministicPeerId(slotNode))
        slotNode->localPeerId = strings.CloneStr(peerForHost)
    if len(peerForHost) > 0:
        let _ = persistPeerId(dataDir, peerForHost)
    gLastNodePeerId = strings.CloneStr(peerForHost)
    debugNodeStep("[ffi] node_init: peer id done")
    syncMdnsConfig()
    debugNodeStep("[ffi] node_init: done")
    gLastInitStage = 50
    return int64(slot + 2)

# Slim-profile node init for feed/gossipsub-only artifacts (the S2 feed .so
# build wall: full node_init reaches newStandardSwitch's 26 protocols and the
# closure never finishes compiling). Same slot/identity/persistence handling;
# differences: slim host chain, and no DM envelope handler (DM is not in the
# slim protocol set). Artifacts choose this entry via export roots — full apps
# keep libp2p_node_init and never reach the slim chain.
@exportc("libp2p_node_init_slim")
fn libp2p_node_init_slim(configJson: cstring): int64 =
    clearLastError()
    gLastInitStage = 10
    debugNodeStep("[ffi] node_init_slim: begin")
    var slot: int32 = findFreeNodeSlot()
    if slot < 0:
        NimMain()
        slot = findFreeNodeSlot()
    if slot < 0:
        gLastInitStage = -10
        setLastError("node_init_slim: no free slot")
        return 0
    gLastInitStage = 20
    let configText: str =
        if configJson == nil:
            "{}"
        else:
            system.strFromCStringCopy(configJson)
    var listenAddr: str = parseListenAddress(strings.CloneStr(configText))
    if len(trimText(listenAddr)) <= 0:
        listenAddr = defaultListenAddrSlim
    let slotNode: NodeRuntime* = ensureNodePtrAt(slot)
    if slotNode == nil:
        gLastInitStage = -20
        setLastError("node_init_slim: slot ptr missing")
        return 0
    markNodeUnused(slotNode)
    slotNode->used = true
    slotNode->started = false
    let swSlotPtr: switch.Switch* = switchPtrAt(slot)
    if swSlotPtr == nil:
        gLastInitStage = -30
        setLastError("node_init_slim: switch slot missing")
        markNodeUnused(slotNode)
        return 0
    let dataDir: str = parseDataDir(strings.CloneStr(configText))
    slotNode->dataDir = strings.CloneStr(dataDir)
    if len(trimText(dataDir)) > 0:
        if !ensureDirRecursive(dataDir):
            debugNodeStep("[ffi] node_init_slim: ensureDirRecursive failed path=" + strings.CloneStr(dataDir))
    gLastInitStage = 30
    let hostOk: bool = initSwitchWithPersistentIdentitySlim(swSlotPtr, listenAddr, dataDir)
    if !hostOk:
        gLastInitStage = -40
        setLastError("node_init_slim: host init failed")
        markNodeUnused(slotNode)
        return 0
    gLastInitStage = 40
    setSwitchUsed(slot, true)
    slotNode->switchIndex = slot
    var listenForHost: str = ownText(um_hostListenAddrTextIndex(slot))
    if len(listenForHost) <= 0:
        listenForHost = listenAddr
    slotNode->listenAddr = strings.CloneStr(listenForHost)
    let hostPeerId: str = canonicalPeerIdOrEmpty(trimText(um_hostPeerIdTextIndex(slot)))
    let persistedPeerId: str = canonicalPeerIdOrEmpty(loadPersistedPeerId(dataDir))
    var peerForHost: str
    if len(persistedPeerId) > 0:
        peerForHost = ownText(persistedPeerId)
    elif len(hostPeerId) > 0:
        peerForHost = ownText(hostPeerId)
    else:
        peerForHost = ownText(forceDeterministicPeerId(slotNode))
    slotNode->localPeerId = strings.CloneStr(peerForHost)
    applyHostIdentityDirect(swSlotPtr, listenForHost, peerForHost)
    let hostPeerAfter: str = canonicalPeerIdOrEmpty(trimText(um_hostPeerIdTextIndex(slot)))
    if len(hostPeerAfter) > 0:
        peerForHost = ownText(hostPeerAfter)
        slotNode->localPeerId = strings.CloneStr(peerForHost)
    if len(canonicalPeerIdOrEmpty(strings.CloneStr(peerForHost))) <= 0:
        peerForHost = ownText(forceDeterministicPeerId(slotNode))
        slotNode->localPeerId = strings.CloneStr(peerForHost)
    if len(peerForHost) > 0:
        let _ = persistPeerId(dataDir, peerForHost)
    gLastNodePeerId = strings.CloneStr(peerForHost)
    syncMdnsConfig()
    debugNodeStep("[ffi] node_init_slim: done")
    gLastInitStage = 50
    return int64(slot + 2)

@exportc("libp2p_debug_last_init_stage")
fn libp2p_debug_last_init_stage(): int32 =
    return gLastInitStage

@exportc("libp2p_node_start")
fn libp2p_node_start(handle: int64): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("node_start: invalid handle")
        return resultError
    let swIdx: int32 = node->switchIndex
    if swIdx < 0:
        setLastError("node_start: switch missing")
        return resultError
    if switchPtrAt(swIdx) == nil:
        setLastError("node_start: switch ptr missing")
        return resultError
    let startedOk: bool = um_hostStartIndex(swIdx)
    if !startedOk:
        setLastError("node_start: host start failed")
        node->started = false
        return resultError
    node->started = true
    return resultOk

@exportc("libp2p_node_stop")
fn libp2p_node_stop(handle: int64): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("node_stop: invalid handle")
        return resultError
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx >= 0:
        let swPtr: switch.Switch* = switchPtrAt(swIdx)
        if swPtr != nil:
            um_hostStopIndex(swIdx)
    node->started = false
    return resultOk

@exportc("libp2p_node_free")
fn libp2p_node_free(handle: int64) =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx >= 0:
        let swPtr: switch.Switch* = switchPtrAt(swIdx)
        if swPtr != nil:
            um_hostStopIndex(swIdx)
        setSwitchUsed(swIdx, false)
    markNodeUnused(node)

@exportc("libp2p_node_is_started")
fn libp2p_node_is_started(handle: int64): bool =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return false
    return node->started

@exportc("libp2p_generate_identity_json")
fn libp2p_generate_identity_json(): cstring =
    clearLastError()
    let entropy: str = "identity:auto:" + $nowMs() + ":" + $nextSeq()
    let keyHex: str = textToHex(strings.CloneStr(entropy))
    var peerIdText: str = chooseLocalPeerId()
    if len(trimText(strings.CloneStr(peerIdText))) <= 0 || isStubPeerId(strings.CloneStr(peerIdText)):
        peerIdText = deterministicPeerIdFromSeed(strings.CloneStr(entropy))
    let payload: str = "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"privateKey\":" + toJsonStringValue(strings.CloneStr(keyHex)) + ",\"encoding\":\"hex\"}"
    return dupCString(strings.CloneStr(payload))

@exportc("libp2p_identity_from_seed")
fn libp2p_identity_from_seed(seed: void*, seedLen: int64): cstring =
    clearLastError()
    if seed == nil || seedLen <= 0:
        setLastError("identity_from_seed: seed invalid")
        return dupCString("{\"ok\":false,\"error\":\"seed_invalid\"}")
    let seedText: str = trimText(voidPtrText(seed))
    if len(seedText) <= 0:
        setLastError("identity_from_seed: seed text empty")
        return dupCString("{\"ok\":false,\"error\":\"seed_empty\"}")
    let material: str = seedText + ":" + $seedLen
    let keyHex: str = textToHex(strings.CloneStr(material))
    let peerIdText: str = deterministicPeerIdFromSeed(strings.CloneStr(material))
    let payload: str = "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"privateKey\":" + toJsonStringValue(strings.CloneStr(keyHex)) + ",\"encoding\":\"hex\"}"
    return dupCString(strings.CloneStr(payload))

@exportc("libp2p_get_local_peer_id")
fn libp2p_get_local_peer_id(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("get_local_peer_id: invalid handle")
        return dupCString("")
    var outPeerId: str = canonicalPeerIdOrEmpty(resolveNodePeerId(node))
    if len(outPeerId) <= 0:
        outPeerId = forceDeterministicPeerId(node)
    StoreLocalPeerIdAt(idx, outPeerId)
    let swIdx: int32 = node->switchIndex
    if swIdx >= 0:
        let swPtr: switch.Switch* = switchPtrAt(swIdx)
        if swPtr != nil:
            applyHostIdentityDirect(swPtr, CloneListenAddrAt(idx), CloneLocalPeerIdAt(idx))
    let dataDirText: str = CloneDataDirAt(idx)
    if len(trimText(strings.CloneStr(dataDirText))) > 0 && len(outPeerId) > 0:
        let _ = persistPeerId(dataDirText, strings.CloneStr(outPeerId))
    gLastNodePeerId = strings.CloneStr(outPeerId)
    if len(outPeerId) <= 0:
        setLastError("get_local_peer_id: empty")
        return dupCString(forceDeterministicPeerId(node))
    return dupCString(strings.CloneStr(outPeerId))

@exportc("libp2p_get_local_peer_id_quick")
fn libp2p_get_local_peer_id_quick(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("get_local_peer_id_quick: invalid handle")
        return dupCString("")
    var peerIdText: str = canonicalPeerIdOrEmpty(resolveNodePeerId(node))
    if len(peerIdText) <= 0:
        peerIdText = forceDeterministicPeerId(node)
    if len(peerIdText) <= 0:
        setLastError("get_local_peer_id_quick: empty")
        return dupCString(forceDeterministicPeerId(node))
    return dupCString(strings.CloneStr(peerIdText))

@exportc("libp2p_get_listen_addresses")
fn libp2p_get_listen_addresses(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("[]")
    let listenAddr: str = ListenAddrResolvedAt(idx, node->switchIndex, true)
    return dupCString("[" + toJsonStringValue(strings.CloneStr(listenAddr)) + "]")

@exportc("libp2p_get_dialable_addresses")
fn libp2p_get_dialable_addresses(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("[]")
    let peerIdText: str = canonicalPeerIdOrEmpty(resolveNodePeerId(node))
    if len(peerIdText) <= 0:
        return dupCString("[]")
    let listenAddr: str = ListenAddrResolvedAt(idx, node->switchIndex, false)
    let dialAddr: str = toDialAddressWithPeer(listenAddr, strings.CloneStr(peerIdText))
    if len(dialAddr) > 0:
        return dupCString("[" + toJsonStringValue(strings.CloneStr(dialAddr)) + "]")
    return dupCString("[]")

@exportc("libp2p_set_msquic_settings")
fn libp2p_set_msquic_settings(handle: int64, settingsJsonPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("set_msquic_settings: invalid handle")
    let settingsText: str =
        if settingsJsonPtr == nil:
            "{}"
        else:
            voidPtrText(settingsJsonPtr)

    var allowDatagram: bool = node->msquicAllowDatagram
    if parseConfigHasKey(settingsText, "allowDatagram"):
        allowDatagram = boolFromText(parseConfigQuotedValue(settingsText, "allowDatagram"), allowDatagram)
    if parseConfigHasKey(settingsText, "allow_datagram"):
        allowDatagram = boolFromText(parseConfigQuotedValue(settingsText, "allow_datagram"), allowDatagram)

    var maxDatagram: int32 = node->msquicMaxDatagram
    if parseConfigHasKey(settingsText, "maxDatagram"):
        maxDatagram = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maxDatagram")))
    if parseConfigHasKey(settingsText, "max_datagram"):
        maxDatagram = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "max_datagram")))

    var minMtu: int32 = node->msquicMinMtu
    if parseConfigHasKey(settingsText, "minimumMtu"):
        minMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "minimumMtu")))
    if parseConfigHasKey(settingsText, "minimum_mtu"):
        minMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "minimum_mtu")))

    var maxMtu: int32 = node->msquicMaxMtu
    if parseConfigHasKey(settingsText, "maximumMtu"):
        maxMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maximumMtu")))
    if parseConfigHasKey(settingsText, "maximum_mtu"):
        maxMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maximum_mtu")))

    var migrationEnabled: bool = node->msquicMigrationEnabled
    if parseConfigHasKey(settingsText, "migrationEnabled"):
        migrationEnabled = boolFromText(parseConfigQuotedValue(settingsText, "migrationEnabled"), migrationEnabled)
    if parseConfigHasKey(settingsText, "migration_enabled"):
        migrationEnabled = boolFromText(parseConfigQuotedValue(settingsText, "migration_enabled"), migrationEnabled)

    var ecnEnabled: bool = node->msquicEcnEnabled
    if parseConfigHasKey(settingsText, "ecnEnabled"):
        ecnEnabled = boolFromText(parseConfigQuotedValue(settingsText, "ecnEnabled"), ecnEnabled)
    if parseConfigHasKey(settingsText, "ecn_enabled"):
        ecnEnabled = boolFromText(parseConfigQuotedValue(settingsText, "ecn_enabled"), ecnEnabled)

    if maxDatagram < 0:
        return failWith("set_msquic_settings: maxDatagram must be non-negative")
    if minMtu < 0 || maxMtu < 0:
        return failWith("set_msquic_settings: mtu must be non-negative")
    if maxMtu > 0 && minMtu > 0 && maxMtu < minMtu:
        return failWith("set_msquic_settings: maximum mtu must be >= minimum mtu")

    node->msquicAllowDatagram = allowDatagram
    node->msquicMaxDatagram = maxDatagram
    node->msquicMinMtu = minMtu
    node->msquicMaxMtu = maxMtu
    node->msquicMigrationEnabled = migrationEnabled
    node->msquicEcnEnabled = ecnEnabled

    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx >= 0:
        if !um_hostApplyMsQuicNetworkSettingsIndex(
            swIdx,
            allowDatagram,
            maxDatagram,
            minMtu,
            maxMtu,
            migrationEnabled,
            ecnEnabled
        ):
            return failWith("set_msquic_settings: apply failed")
    return true

@exportc("libp2p_get_msquic_settings")
fn libp2p_get_msquic_settings(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{}")
    let out: str =
        "{" +
        "\"allowDatagram\":" + (if node->msquicAllowDatagram: "true" else: "false") + "," +
        "\"maxDatagram\":" + $node->msquicMaxDatagram + "," +
        "\"minimumMtu\":" + $node->msquicMinMtu + "," +
        "\"maximumMtu\":" + $node->msquicMaxMtu + "," +
        "\"migrationEnabled\":" + (if node->msquicMigrationEnabled: "true" else: "false") + "," +
        "\"ecnEnabled\":" + (if node->msquicEcnEnabled: "true" else: "false") +
        "}"
    return dupCString(strings.CloneStr(out))

@exportc("libp2p_connect_peer")
fn libp2p_connect_peer(handle: int64, peerIdPtr: void*): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("connect_peer: invalid handle")
        return resultError
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("connect_peer: missing peerId")
        return resultError
    if ensurePeerIndexPtr(node, strings.CloneStr(peerIdText)) < 0:
        setLastError("connect_peer: peer index failed")
        return resultError
    setPeerConnectedPtr(node, strings.CloneStr(peerIdText), true)
    emitNodeEvent(node, "peer.connected", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + "}")
    return resultOk

@exportc("libp2p_connect_multiaddr")
fn libp2p_connect_multiaddr(handle: int64, multiaddrPtr: void*): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("connect_multiaddr: invalid handle")
        return resultError
    let multiaddrText: str = trimText(voidPtrText(multiaddrPtr))
    if len(multiaddrText) <= 0:
        setLastError("connect_multiaddr: missing address")
        return resultError
    let peerIdText: str = extractPeerIdFromMultiaddr(multiaddrText)
    if len(peerIdText) <= 0:
        setLastError("connect_multiaddr: missing /p2p peer id")
        return resultError
    if !callHostDialPtr(node, multiaddrText):
        setLastError("connect_multiaddr: dial failed")
        return resultError
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx >= 0:
        let swPtr: switch.Switch* = switchPtrAt(swIdx)
        if swPtr != nil:
            um_hostAddPeerAddressTextIndex(swIdx, peerIdText, multiaddrText)
    # Rebuild from the explicit dial target to avoid stale/corrupted discovery cache entries.
    node->peerCount = 0
    StorePeerRowsTextAt(idx, "")
    addPeerAddressPtr(node, peerIdText, multiaddrText, sourceConnected | sourceWan)
    setPeerConnectedPtr(node, peerIdText, true)
    emitNodeEvent(node, "connect.multiaddr", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"multiaddr\":" + toJsonStringValue(strings.CloneStr(multiaddrText)) + "}")
    return resultOk

@exportc("libp2p_disconnect_peer")
fn libp2p_disconnect_peer(handle: int64, peerIdPtr: void*): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("disconnect_peer: invalid handle")
        return resultError
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("disconnect_peer: missing peerId")
        return resultError
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx >= 0:
        let swPtr: switch.Switch* = switchPtrAt(swIdx)
        if swPtr != nil:
            if !um_hostRemovePeerTextIndex(swIdx, peerIdText):
                setLastError("disconnect_peer: backend remove failed")
                return resultError
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(target) > 0:
        setPeerConnectedPtr(node, target, false)
    emitNodeEvent(node, "peer.disconnected", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + "}")
    return resultOk

@exportc("libp2p_register_peer_hints")
fn libp2p_register_peer_hints(handle: int64, peerIdPtr: void*, addressesJsonPtr: void*, sourcePtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("register_peer_hints: invalid handle")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        return failWith("register_peer_hints: missing peerId")
    let sourceText: str = trimText(voidPtrText(sourcePtr))
    let sourceMask: int32 = sourceMaskFromText(sourceText)
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    let swPtr: switch.Switch* = if swIdx >= 0: switchPtrAt(swIdx) else: nil
    let addressesText: str =
        if addressesJsonPtr == nil:
            "[]"
        else:
            voidPtrText(addressesJsonPtr)
    var values: str[]
    var count: int32
    parseStringListPayloadInto(addressesText, values, count)
    if count <= 0:
        addPeerAddressPtr(node, peerIdText, "", sourceMask)
        return true
    var i: int32
    while i < count:
        let addr: str = values[i]
        if len(addr) > 0 && addr[0] == '/':
            addPeerAddressPtr(node, peerIdText, addr, sourceMask)
            if swPtr != nil:
                if !um_hostAddPeerAddressTextIndex(swIdx, peerIdText, addr):
                    setLastError("register_peer_hints: host add address failed")
                    return false
        i = i + 1
    syncPeerstoreIntoNodePtr(node, sourceMask)
    return true

@exportc("libp2p_add_external_address")
fn libp2p_add_external_address(handle: int64, multiaddrPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("add_external_address: invalid handle")
    let addrText: str = trimText(voidPtrText(multiaddrPtr))
    if len(addrText) <= 0:
        return failWith("add_external_address: missing multiaddr")
    emitNodeEvent(node, "address.external", "{\"multiaddr\":" + toJsonStringValue(strings.CloneStr(addrText)) + "}")
    return true

@exportc("libp2p_is_peer_connected")
fn libp2p_is_peer_connected(handle: int64, peerIdPtr: void*): bool =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return false
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    let peerIdx: int32 = peerIndexOfPtr(node, target)
    if peerIdx < 0:
        if countConnectedPeersPtr(node) > 0:
            return true
        if len(peerIdText) <= 0:
            return false
        return callHostDialPeerPtr(node, peerIdText)
    if peerRowConnected(peerRowAtPtr(node, peerIdx)):
        return true
    if countConnectedPeersPtr(node) > 0:
        return true
    if len(peerIdText) <= 0:
        return false
    return callHostDialPeerPtr(node, peerIdText)

@exportc("libp2p_get_peer_multiaddrs_json")
fn libp2p_get_peer_multiaddrs_json(handle: int64, peerIdPtr: void*): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("[]")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    let peerIdx: int32 = peerIndexOfPtr(node, target)
    if peerIdx < 0:
        return dupCString("[]")
    return dupCString(peerAddrsJsonFromAddr(peerRowAddr(peerRowAtPtr(node, peerIdx))))

@exportc("libp2p_reconnect_bootstrap")
fn libp2p_reconnect_bootstrap(handle: int64): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("reconnect_bootstrap: invalid handle")
    node->bootstrapReconnectAtMs = nowMs()
    return true

@exportc("libp2p_get_random_bootstrap_peers")
fn libp2p_get_random_bootstrap_peers(handle: int64, limit: int32): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"peers\":[],\"selectedCount\":0,\"totalCount\":0}")
    return dupCString(bootstrapPeersJsonPtr(node, limit))

@exportc("libp2p_join_via_random_bootstrap")
fn libp2p_join_via_random_bootstrap(handle: int64, limit: int32): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"ok\":false,\"attemptCount\":0,\"connectedCount\":0,\"attempted\":[]}")
    syncPeerstoreIntoNodePtr(node, sourceDht | sourceWan)
    let peerTotal: int32 = safePeerCountPtr(node)
    let cap: int32 = if limit <= 0: 3 else: limit
    var attempted: str = "["
    var attempts: int32
    var connected: int32
    var i: int32
    while i < peerTotal && attempts < cap:
        let row: str = peerRowAtPtr(node, i)
        let peerIdText: str = peerRowPeerId(row)
        let addrText: str = peerRowAddr(row)
        if peerRowUsed(row) && len(addrText) > 0:
            if attempts > 0:
                attempted = attempted + ","
            attempted = attempted + toJsonStringValue(strings.CloneStr(peerIdText))
            attempts = attempts + 1
            if callHostDialPtr(node, addrText):
                setPeerConnectedPtr(node, peerIdText, true)
                connected = connected + 1
        i = i + 1
    attempted = attempted + "]"
    node->bootstrapReconnectAtMs = nowMs()
    syncPeerstoreIntoNodePtr(node, sourceConnected | sourceWan)
    let out: str = "{\"ok\":" + (if connected > 0: "true" else: "false") + ",\"attemptCount\":" + $attempts + ",\"connectedCount\":" + $connected + ",\"attempted\":" + attempted + "}"
    return dupCString(strings.CloneStr(out))

@exportc("libp2p_boost_connectivity")
fn libp2p_boost_connectivity(handle: int64): bool =
    return libp2p_reconnect_bootstrap(handle)

