    let bodyText: str = trimText(voidPtrText(bodyPtr))
    let targetText: str = trimText(voidPtrText(targetPtr))
    if len(peerIdText) <= 0 || len(opText) <= 0:
        return failWith("send_chat_control: invalid arguments")
    let payload: str = "{\"type\":\"control\",\"op\":" + toJsonStringValue(strings.CloneStr(opText)) + ",\"messageId\":" + toJsonStringValue(strings.CloneStr(messageId)) + ",\"body\":" + toJsonStringValue(strings.CloneStr(bodyText)) + ",\"target\":" + toJsonStringValue(strings.CloneStr(targetText)) + ",\"timestampMs\":" + $nowMs() + "}"
    let ok: bool = sendDmEnvelopePtr(node, peerIdText, dmRequestKind, payload, emptyPayload(), requestAck, timeoutMs)
    if ok:
        setPeerConnectedPtr(node, peerIdText, true)
        emitNodeEvent(node, "dm.control", payload)
    return ok

@exportc("libp2p_send_chat_ack_ffi")
fn libp2p_send_chat_ack_ffi(handle: int64, peerIdPtr: void*, messageIdPtr: void*, success: bool, errorMsgPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("send_chat_ack: invalid handle")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    let messageId: str = trimText(voidPtrText(messageIdPtr))
    let errorText: str = trimText(voidPtrText(errorMsgPtr))
    if len(peerIdText) <= 0 || len(messageId) <= 0:
        return failWith("send_chat_ack: invalid arguments")
    let ackPayload: str = "{\"type\":\"ack\",\"messageId\":" + toJsonStringValue(strings.CloneStr(messageId)) + ",\"success\":" + (if success: "true" else: "false") + ",\"error\":" + toJsonStringValue(strings.CloneStr(errorText)) + "}"
    if !sendDmEnvelopePtr(node, peerIdText, dmAckKind, ackPayload, emptyPayload(), false, 4000):
        StoreLastDirectErrorAt(idx, gLastError)
        setLastError("send_chat_ack: " + CloneLastDirectErrorAt(idx))
        return false
    setPeerConnectedPtr(node, peerIdText, true)
    emitNodeEvent(node, "dm.ack", ackPayload)
    return true

@exportc("libp2p_send_with_ack")
fn libp2p_send_with_ack(handle: int64, peerIdPtr: void*, payloadJsonPtr: void*, timeoutMs: int32): bool =
