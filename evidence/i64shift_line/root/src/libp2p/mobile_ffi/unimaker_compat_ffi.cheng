fn nodeSwitchIndex(node: var NodeRuntime): int32 =
    if node.switchIndex < 0 || node.switchIndex >= maxNodes:
        return -1
    if !switchUsed(node.switchIndex):
        return -1
    return node.switchIndex

fn findFreeNodeSlot(): int32 =
    var i: int32
    while i < maxNodes:
        let node: NodeRuntime* = ensureNodePtrAt(i)
        if node != nil && !(node->used):
            return i
        i = i + 1
    return -1

@borrows
fn peerNextRowSeparator(text: str, start: int32): int32 =
    let total: int32 = len(text)
    var i: int32 = start
    while i < total:
        if SliceBytes(text, i, 1) == peerRowSeparator:
            return i
        i = i + 1
    return -1

@borrows
fn peerNextFieldSeparator(text: str, start: int32): int32 =
    let total: int32 = len(text)
    var i: int32 = start
    while i < total:
        if SliceBytes(text, i, 1) == peerFieldSeparator:
            return i
        i = i + 1
    return -1

fn peerFlagText(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn peerFlagValue(text: str): bool =
    let normalized: str = trimText(text)
    return normalized == "1" || strLowerAscii(normalized) == "true"

@borrows
fn peerRowBuild(
    peerId: str,
    connected: bool,
    lastSeenAtMs: int64,
    sourceMask: int32,
    addr: str,
    latencyMs: int32,
    measuredUplinkBps: int64,
    measuredDownlinkBps: int64,
    uplinkTotalBytes: int64,
    downlinkTotalBytes: int64,
    relayBottleneckBps: int64,
    isRelayed: bool
): str =
    return "1" + "\x1f" +
        strings.CloneStr(canonicalPeerIdOrEmpty(peerId)) + "\x1f" +
        peerFlagText(connected) + "\x1f" +
        Int64ToStr(lastSeenAtMs) + "\x1f" +
        Int64ToStr(int64(sourceMask)) + "\x1f" +
        strings.CloneStr(trimText(addr)) + "\x1f" +
        Int64ToStr(int64(latencyMs)) + "\x1f" +
        Int64ToStr(measuredUplinkBps) + "\x1f" +
        Int64ToStr(measuredDownlinkBps) + "\x1f" +
        Int64ToStr(uplinkTotalBytes) + "\x1f" +
        Int64ToStr(downlinkTotalBytes) + "\x1f" +
        Int64ToStr(relayBottleneckBps) + "\x1f" +
        peerFlagText(isRelayed)

@borrows
fn peerFieldAt(row: str, targetField: int32): str =
    if targetField < 0:
        return ""
    var offset: int32
    var fieldIndex: int32
    while offset <= len(row):
        let sep: int32 = peerNextFieldSeparator(row, offset)
        let endPos: int32 = if sep >= 0: sep else: len(row)
        if fieldIndex == targetField:
            return SliceBytes(row, offset, endPos - offset)
        if sep < 0:
            break
        offset = sep + 1
        fieldIndex = fieldIndex + 1
    return ""

fn peerRowAt(node: var NodeRuntime, targetIndex: int32): str =
    if targetIndex < 0:
        return ""
    let source: str = node.peerRowsText
    if len(source) <= 0:
        return ""
    var offset: int32
    var rowIndex: int32
    while offset <= len(source):
        let sep: int32 = peerNextRowSeparator(source, offset)
        let endPos: int32 = if sep >= 0: sep else: len(source)
        if rowIndex == targetIndex:
            return SliceBytes(source, offset, endPos - offset)
        if sep < 0:
            break
        offset = sep + 1
        rowIndex = rowIndex + 1
    return ""

fn peerRowSetAt(node: var NodeRuntime, targetIndex: int32, row: str) =
    if targetIndex < 0:
        return
    let replacement: str = strings.CloneStr(row)
    let source: str = node.peerRowsText
    if len(source) <= 0:
        if targetIndex == 0 && len(replacement) > 0:
            node.peerRowsText = strings.CloneStr(replacement)
            node.peerCount = 1
        return
    var out: str
    var wrote: bool
    var offset: int32
    var rowIndex: int32
    while offset <= len(source):
        let sep: int32 = peerNextRowSeparator(source, offset)
        let endPos: int32 = if sep >= 0: sep else: len(source)
        if rowIndex == targetIndex:
            if len(replacement) > 0:
                if wrote:
                    out = out + "\x1e"
                out = out + strings.CloneStr(replacement)
                wrote = true
        else:
            let currentRow: str = SliceBytes(source, offset, endPos - offset)
            if len(currentRow) > 0:
                if wrote:
                    out = out + "\x1e"
                out = out + currentRow
                wrote = true
        if sep < 0:
            break
        offset = sep + 1
        rowIndex = rowIndex + 1
    node.peerRowsText = out

fn peerAppendRow(node: var NodeRuntime, row: str) =
    if len(row) <= 0:
        return
    let nextRow: str = strings.CloneStr(row)
    if node.peerCount >= maxPeersPerNode:
        return
    if node.peerCount <= 0 || len(node.peerRowsText) <= 0:
        node.peerRowsText = strings.CloneStr(nextRow)
    else:
        node.peerRowsText = node.peerRowsText + "\x1e" + strings.CloneStr(nextRow)
    node.peerCount = node.peerCount + 1

@borrows
fn peerRowUsed(row: str): bool =
    return len(row) > 0 && peerFieldAt(row, 0) == "1"

@borrows
fn peerRowPeerId(row: str): str =
    return canonicalPeerIdOrEmpty(peerFieldAt(row, 1))

@borrows
fn peerRowConnected(row: str): bool =
    return peerFlagValue(peerFieldAt(row, 2))

@borrows
fn peerRowLastSeenAtMs(row: str): int64 =
    return parseFirstInt64(peerFieldAt(row, 3))

@borrows
fn peerRowSourceMask(row: str): int32 =
    return int32(parseFirstInt64(peerFieldAt(row, 4)))

@borrows
fn peerRowAddr(row: str): str =
    return trimText(peerFieldAt(row, 5))

@borrows
fn peerRowLatencyMs(row: str): int32 =
    return int32(parseFirstInt64(peerFieldAt(row, 6)))

@borrows
fn peerRowMeasuredUplinkBps(row: str): int64 =
    return parseFirstInt64(peerFieldAt(row, 7))

@borrows
fn peerRowMeasuredDownlinkBps(row: str): int64 =
    return parseFirstInt64(peerFieldAt(row, 8))

@borrows
fn peerRowUplinkTotalBytes(row: str): int64 =
    return parseFirstInt64(peerFieldAt(row, 9))

@borrows
fn peerRowDownlinkTotalBytes(row: str): int64 =
    return parseFirstInt64(peerFieldAt(row, 10))

@borrows
fn peerRowRelayBottleneckBps(row: str): int64 =
    return parseFirstInt64(peerFieldAt(row, 11))

@borrows
fn peerRowRelayed(row: str): bool =
    return peerFlagValue(peerFieldAt(row, 12))

@borrows
fn peerIndexOf(node: var NodeRuntime, peerIdText: str): int32 =
    let normalizedPeerId: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(normalizedPeerId) <= 0:
        return -1
    let peerTotal: int32 = node.peerCount
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        if peerRowUsed(row) && peerRowPeerId(row) == normalizedPeerId:
            return i
        i = i + 1
    return -1

@borrows
fn ensurePeerIndex(node: var NodeRuntime, peerIdText: str): int32 =
    let normalizedPeerId: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(normalizedPeerId) <= 0:
        return -1
    let existingIndex: int32 = peerIndexOf(node, normalizedPeerId)
    if existingIndex >= 0:
        return existingIndex
    if node.peerCount >= maxPeersPerNode:
        return -1
    let row: str = peerRowBuild(strings.CloneStr(normalizedPeerId), false, nowMs(), 0, "", 0, 0, 0, 0, 0, 0, false)
    peerAppendRow(node, row)
    return node.peerCount - 1

@borrows
fn ensurePeerIndexPtr(node: NodeRuntime*, peerIdText: str): int32 =
    let index: int32 = nodePtrIndex(node)
    let peerOwned: str = strings.CloneStr(peerIdText)
    if index == 0:
        return ensurePeerIndex(gNode0, peerOwned)
    if index == 1:
        return ensurePeerIndex(gNode1, peerOwned)
    if index == 2:
        return ensurePeerIndex(gNode2, peerOwned)
    if index == 3:
        return ensurePeerIndex(gNode3, peerOwned)
    if index == 4:
        return ensurePeerIndex(gNode4, peerOwned)
    if index == 5:
        return ensurePeerIndex(gNode5, peerOwned)
    if index == 6:
        return ensurePeerIndex(gNode6, peerOwned)
    if index == 7:
        return ensurePeerIndex(gNode7, peerOwned)
    return -1

fn peerAddrsJsonFromAddr(addrText: str): str =
    let normalized: str = trimText(addrText)
    if len(normalized) <= 0:
        return "[]"
    return joinText(["[", toJsonStringValue(strings.CloneStr(normalized)), "]"])

@borrows
fn addPeerAddress(node: var NodeRuntime, peerIdText: str, addr: str, sourceMask: int32) =
    let normalizedPeerId: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(normalizedPeerId) <= 0:
        return
    let idx: int32 = ensurePeerIndex(node, normalizedPeerId)
    if idx < 0:
        return
    let row: str = peerRowAt(node, idx)
    let nextAddr: str =
        if len(addr) > 0:
            toDialAddressWithPeer(addr, normalizedPeerId)
        else:
            peerRowAddr(row)
    let nextRow: str = peerRowBuild(
        normalizedPeerId,
        peerRowConnected(row),
        nowMs(),
        peerRowSourceMask(row) | sourceMask,
        nextAddr,
        peerRowLatencyMs(row),
        peerRowMeasuredUplinkBps(row),
        peerRowMeasuredDownlinkBps(row),
        peerRowUplinkTotalBytes(row),
        peerRowDownlinkTotalBytes(row),
        peerRowRelayBottleneckBps(row),
        peerRowRelayed(row)
    )
    peerRowSetAt(node, idx, nextRow)

@borrows
fn setPeerConnected(node: var NodeRuntime, peerIdText: str, connected: bool) =
    let normalizedPeerId: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(normalizedPeerId) <= 0:
        return
    let idx: int32 = ensurePeerIndex(node, normalizedPeerId)
    if idx < 0:
        return
    let row: str = peerRowAt(node, idx)
    let nextMask: int32 =
        if connected:
            peerRowSourceMask(row) | sourceConnected
        else:
            peerRowSourceMask(row)
    let nextRow: str = peerRowBuild(
        normalizedPeerId,
        connected,
        nowMs(),
        nextMask,
        peerRowAddr(row),
        peerRowLatencyMs(row),
        peerRowMeasuredUplinkBps(row),
        peerRowMeasuredDownlinkBps(row),
        peerRowUplinkTotalBytes(row),
        peerRowDownlinkTotalBytes(row),
        peerRowRelayBottleneckBps(row),
        peerRowRelayed(row)
    )
    peerRowSetAt(node, idx, nextRow)

fn peerRecordTransfer(node: var NodeRuntime, peerIdText: str, txBytes: int64, rxBytes: int64) =
    let normalizedPeerId: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(normalizedPeerId) <= 0:
        return
    let idx: int32 = ensurePeerIndex(node, normalizedPeerId)
    if idx < 0:
        return
    let row: str = peerRowAt(node, idx)
    let nextRow: str = peerRowBuild(
        normalizedPeerId,
        true,
        nowMs(),
        peerRowSourceMask(row) | sourceConnected,
        peerRowAddr(row),
        peerRowLatencyMs(row),
        peerRowMeasuredUplinkBps(row),
        peerRowMeasuredDownlinkBps(row),
        peerRowUplinkTotalBytes(row) + txBytes,
        peerRowDownlinkTotalBytes(row) + rxBytes,
        peerRowRelayBottleneckBps(row),
        peerRowRelayed(row)
    )
    peerRowSetAt(node, idx, nextRow)

fn peerRecordMeasurement(
    node: var NodeRuntime,
    peerIdText: str,
    upBps: int64,
    downBps: int64,
    txBytes: int64,
    rxBytes: int64,
    latencyMs: int32,
    relayed: bool
) =
    let normalizedPeerId: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(normalizedPeerId) <= 0:
        return
    let idx: int32 = ensurePeerIndex(node, normalizedPeerId)
    if idx < 0:
        return
    let row: str = peerRowAt(node, idx)
    let relayBps: int64 =
        if relayed:
            minI64(upBps, downBps)
        else:
            0
    let nextRow: str = peerRowBuild(
        normalizedPeerId,
        true,
        nowMs(),
        peerRowSourceMask(row) | sourceConnected,
        peerRowAddr(row),
        latencyMs,
        upBps,
        downBps,
        peerRowUplinkTotalBytes(row) + txBytes,
        peerRowDownlinkTotalBytes(row) + rxBytes,
        relayBps,
        relayed
    )
    peerRowSetAt(node, idx, nextRow)

fn normalizeDialAddress(addr: str): str =
    var out: str = addr
    out = replaceFirst(out, "/ip4/0.0.0.0/", "/ip4/127.0.0.1/")
    out = replaceFirst(out, "/ip6/::/", "/ip6/::1/")
    return out

@borrows
fn extractPeerIdFromMultiaddr(addr: str): str =
    let marker: str = "/p2p/"
    let markerPos: int32 = indexOf(addr, marker, 0)
    if markerPos < 0:
        return ""
    let begin: int32 = markerPos + len(marker)
    if begin >= len(addr):
        return ""
    let endPos: int32 = indexOfChar(addr, '/', begin)
    if endPos < 0:
        let rawPeerId: str = SliceBytes(addr, begin, len(addr) - begin)
        return canonicalPeerIdOrEmpty(rawPeerId)
    if endPos <= begin:
        return ""
    let rawPeerId: str = SliceBytes(addr, begin, endPos - begin)
    return canonicalPeerIdOrEmpty(rawPeerId)

@borrows
fn toDialAddressWithPeer(addr: str, peerIdText: str): str =
    if len(addr) <= 0:
        return ""
    let normalized: str = normalizeDialAddress(strings.CloneStr(addr))
    if indexOf(normalized, "/p2p/", 0) >= 0:
        return normalized
    if len(peerIdText) <= 0:
        return normalized
    return normalized + "/p2p/" + strings.CloneStr(peerIdText)

@borrows
fn parseQuotedValuesInto(text: str, out: var str[], outCount: var int32) =
    out = []
    outCount = 0
    if isNullText(text):
        return
    let n: int32 = len(text)
    var i: int32
    while i < n:
        if text[i] == '"':
            i = i + 1
            let start: int32 = i
            while i < n && text[i] != '"':
                i = i + 1
            if i > start:
                if outCount < maxExtractValues:
                    add(out, decodeJsonEscapes(SliceBytes(text, start, i - start)))
                    outCount = outCount + 1
        i = i + 1

fn parseQuotedValues(text: str): str[] =
    var out: str[]
    var count: int32
    parseQuotedValuesInto(text, out, count)
    return out

@borrows
fn decodeJsonEscapes(text: str): str =
    if isNullText(text):
        return ""
    let total: int32 = len(text)
    if total <= 0:
        return ""
    var out: str
    var i: int32
    while i < total:
        let ch: char = text[i]
        if ch != '\\':
            out = out + charToStr(ch)
            i = i + 1
            continue
        if i + 1 >= total:
            i = i + 1
            continue
        let esc: char = text[i + 1]
        if esc == '\\' || esc == '"' || esc == '/':
            out = out + charToStr(esc)
        elif esc == 'n':
            out = out + charToStr('\n')
        elif esc == 'r':
            out = out + charToStr('\r')
        elif esc == 't':
            out = out + charToStr('\t')
        else:
            out = out + charToStr(esc)
        i = i + 2
    return out

@borrows
fn normalizeFsPath(pathText: str): str =
    let text: str = trimText(pathText)
    if len(text) <= 0:
        return ""
    var out: str
    var i: int32
    let total: int32 = len(text)
    while i < total:
        let ch: char = text[i]
        if ch == '\\':
            out = out + "/"
        else:
            out = out + charToStr(ch)
        i = i + 1
    return out

fn parseListenAddress(configText: str): str =
    var values: str[]
    var count: int32
    parseQuotedValuesInto(configText, values, count)
    if count <= 0:
        return defaultListenAddr
    var firstAny: str
    var firstQuic: str
    var i: int32
    while i < count:
        let candidate: str = strings.CloneStr(values[i])
        if len(candidate) > 0 && candidate[0] == '/':
            if len(firstAny) <= 0:
                firstAny = strings.CloneStr(candidate)
            if len(firstQuic) <= 0 && (StrContains(candidate, "/quic-v1/") || StrContains(candidate, "/quic-v1") || StrContains(candidate, "/quic/")):
                firstQuic = strings.CloneStr(candidate)
        i = i + 1
    if len(firstQuic) > 0:
        return firstQuic
    if len(firstAny) > 0:
        return firstAny
    return defaultListenAddr

@borrows
fn isLikelyDataDirPath(pathText: str): bool =
    let text: str = normalizeFsPath(trimText(pathText))
    if len(text) <= 0:
        return false
    if startsWith(text, "/") || startsWith(text, "./") || startsWith(text, "../"):
        return true
    if StrContains(text, ":/") || StrContains(text, ":\\"):
        return true
    return false

fn parseDataDir(configText: str): str =
    var quoted: str[]
    var n: int32
    parseQuotedValuesInto(configText, quoted, n)
    # Primary path: key-value extraction from quoted JSON tokens.
    var i: int32
    while i + 1 < n:
        let key: str = strLowerAscii(trimText(quoted[i]))
        if key == "datadir" || key == "data_dir":
            let direct: str = normalizeFsPath(decodeJsonEscapes(trimText(quoted[i + 1])))
            if isLikelyDataDirPath(direct):
                return strings.CloneStr(direct)
        i = i + 1

    # Fallback: pick an explicit libp2p path-like token if present.
    var i: int32
    while i < n:
        let candidate: str = normalizeFsPath(trimText(quoted[i]))
        if isLikelyDataDirPath(candidate) && StrContains(candidate, "/libp2p"):
            return candidate
        i = i + 1
    return ""

@borrows
fn joinPath(base: str, name: str): str =
    let left: str = trimText(base)
    let right: str = trimText(name)
    if len(left) <= 0:
        return right
    if len(right) <= 0:
        return left
    if left[len(left) - 1] == '/':
        return left + right
    return left + "/" + right

@borrows
fn parentPath(path: str): str =
    let text: str = trimText(path)
    let total: int32 = len(text)
    if total <= 0:
        return ""
    var end: int32 = total
    while end > 1 && text[end - 1] == '/':
        end = end - 1
    var i: int32 = end - 1
    while i >= 0:
        if text[i] == '/':
            if i <= 0:
                return "/"
            return SliceBytes(text, 0, i)
        i = i - 1
    return ""

@borrows
fn baseName(path: str): str =
    let text: str = trimText(path)
    let total: int32 = len(text)
    if total <= 0:
        return ""
    var end: int32 = total
    while end > 1 && text[end - 1] == '/':
        end = end - 1
    var i: int32 = end - 1
    while i >= 0:
        if text[i] == '/':
            if i + 1 >= end:
                return ""
            return SliceBytes(text, i + 1, end - i - 1)
        i = i - 1
    return SliceBytes(text, 0, end)

@borrows
fn readFileText(path: str): str =
    let trimmedPath: str = trimText(path)
    if len(trimmedPath) <= 0:
        return ""
    return system.strFromCStringCopy(c_cheng_read_file(cStr(trimmedPath)))

@borrows
fn fileExists(path: str): bool =
    let trimmedPath: str = trimText(path)
    if len(trimmedPath) <= 0:
        return false
    return c_cheng_file_exists(cStr(trimmedPath)) == 1

@borrows
fn dirExists(path: str): bool =
    let trimmedPath: str = trimText(path)
    if len(trimmedPath) <= 0:
        return false
    return c_cheng_dir_exists(cStr(trimmedPath)) == 1

@borrows
fn mkdirOne(path: str): bool =
    let trimmedPath: str = strings.CloneStr(trimText(path))
    if len(trimmedPath) <= 0:
        return false
    if dirExists(strings.CloneStr(trimmedPath)):
        return true
    if c_cheng_mkdir1(cStr(trimmedPath)) == 0:
        return true
    return dirExists(strings.CloneStr(trimmedPath))

@borrows
fn ensureDirRecursive(path: str): bool =
    let target: str = strings.CloneStr(trimText(path))
    if len(target) <= 0:
        return false
    if dirExists(strings.CloneStr(target)):
        return true
    if mkdirOne(strings.CloneStr(target)):
        return true
    let n: int32 = len(target)
    var i: int32
    if n > 0 && target[0] == '/':
        i = 1
    while i <= n:
        if i == n || target[i] == '/':
            if i > 0:
                let prefix: str = strings.CloneStr(SliceBytes(target, 0, i))
                if len(prefix) > 0:
                    if !dirExists(strings.CloneStr(prefix)):
                        if !mkdirOne(strings.CloneStr(prefix)):
                            return false
        i = i + 1
    return dirExists(strings.CloneStr(target))

@borrows
fn parseFirstInt64(text: str): int64 =
    let n: int32 = len(text)
    if n <= 0:
        return 0
    var i: int32
    while i < n:
        let ch: char = text[i]
        if ch >= '0' && ch <= '9':
            break
        i = i + 1
    if i >= n:
        return 0
    var value: int64
    while i < n:
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            break
        value = value * 10 + int64(ord(ch) - ord('0'))
        i = i + 1
    return value

@borrows
fn parseConfigHasKey(configText: str, keyName: str): bool =
    if len(configText) <= 0 || len(keyName) <= 0:
        return false
    let token: str = joinText(["\"", strings.CloneStr(keyName), "\""])
    return indexOf(configText, token, 0) >= 0

@borrows
fn parseConfigQuotedValue(configText: str, keyName: str): str =
    let token: str = joinText(["\"", strings.CloneStr(keyName), "\""])
    let start: int32 = indexOf(configText, token, 0)
    if start < 0:
        return ""
    let n: int32 = len(configText)
    var cursor: int32 = start + len(token)
    while cursor < n && configText[cursor] != ':':
        cursor = cursor + 1
    if cursor >= n:
        return ""
    cursor = cursor + 1
    while cursor < n:
        let ch: char = configText[cursor]
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r':
            break
        cursor = cursor + 1
    if cursor >= n:
        return ""
    if configText[cursor] == '"':
        let valueStart: int32 = cursor + 1
        var valueEnd: int32 = n
        for i in valueStart..<n:
            if configText[i] == '"' && configText[i - 1] != '\\':
                valueEnd = i
                break
        if valueEnd <= valueStart:
            return ""
        return strings.CloneStr(SliceBytes(configText, valueStart, valueEnd - valueStart))
    var valueEnd: int32 = cursor
    while valueEnd < n:
        let ch: char = configText[valueEnd]
        if ch == ',' || ch == '}' || ch == '\n' || ch == '\r':
            break
        valueEnd = valueEnd + 1
    if valueEnd <= cursor:
        return ""
    return trimText(strings.CloneStr(SliceBytes(configText, cursor, valueEnd - cursor)))

fn boolFromText(text: str, fallback: bool): bool =
    let lower: str = strLowerAscii(trimText(text))
    if lower == "true" || lower == "1" || lower == "yes" || lower == "on":
        return true
    if lower == "false" || lower == "0" || lower == "no" || lower == "off":
        return false
    return fallback

@borrows
fn lineValueByLowerPrefix(text: str, prefixLower: str): str =
    let total: int32 = len(text)
    if total <= 0 || len(prefixLower) <= 0:
        return ""
    var lineStart: int32
    var i: int32
    while i <= total:
        if i == total || text[i] == '\n':
            let rawLine: str = if i > lineStart: SliceBytes(text, lineStart, i - lineStart) else: ""
            let line: str = trimText(rawLine)
            if len(line) > 0:
                let lowerLine: str = strLowerAscii(line)
                if startsWith(lowerLine, prefixLower):
                    let colonPos: int32 = indexOfChar(line, ':', 0)
                    if colonPos >= 0 && colonPos + 1 < len(line):
                        return trimText(SliceBytes(line, colonPos + 1, len(line) - colonPos - 1))
                    return line
            lineStart = i + 1
        i = i + 1
    return ""

fn hexDigitValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return ord(ch) - ord('0')
    if ch >= 'a' && ch <= 'f':
        return 10 + ord(ch) - ord('a')
    if ch >= 'A' && ch <= 'F':
        return 10 + ord(ch) - ord('A')
    return -1

fn bytesFromHexText(text: str): Bytes =
    let raw: str = trimText(text)
    let n: int32 = len(raw)
    var start: int32
    if n >= 2 && raw[0] == '0' && (raw[1] == 'x' || raw[1] == 'X'):
        start = 2
    let hexLen: int32 = n - start
    if hexLen <= 0 || (hexLen % 2) != 0:
        var empty: Bytes
        return empty
    let outLen: int32 = hexLen / 2
    let out: Bytes = BytesAlloc(outLen)
    var i: int32
    while i < outLen:
        let hi: int32 = hexDigitValue(raw[start + i * 2])
        let lo: int32 = hexDigitValue(raw[start + i * 2 + 1])
        if hi < 0 || lo < 0:
            var empty: Bytes
            return empty
        BytesSet(out, i, hi * 16 + lo)
        i = i + 1
    return out

fn hexCharFromNibble(v: int32): char =
    if v < 10:
        return chr(ord('0') + v)
    return chr(ord('a') + (v - 10))

fn textToHex(text: str): str =
    let n: int32 = len(text)
    if n <= 0:
        return ""
    var out: str
    var i: int32
    while i < n:
        let raw: int32 = ord(text[i])
        let safe: int32 = raw & 255
        let hi: int32 = (safe / 16) & 15
        let lo: int32 = safe & 15
        out = out + charToStr(hexCharFromNibble(hi)) + charToStr(hexCharFromNibble(lo))
        i = i + 1
    return out

@borrows
fn peerIdStorePath(dataDir: str): str =
    let dirText: str = trimText(dataDir)
    if len(dirText) <= 0:
        return ""
    let peerIdFileName: str = "peer_id" + ".txt"
    if dirExists(dirText):
        return joinPath(dirText, peerIdFileName)
    let parent: str = parentPath(dirText)
    if len(parent) > 0 && dirExists(parent):
        let key: str = baseName(dirText)
        if len(key) > 0:
            return joinPath(parent, "peer_id_" + key + ".txt")
        return joinPath(parent, peerIdFileName)
    return joinPath(dirText, peerIdFileName)

@borrows
fn identityStorePath(dataDir: str): str =
    let dirText: str = trimText(dataDir)
    if len(dirText) <= 0:
        return ""
    return joinPath(dirText, didIdentityFileName)

@borrows
fn loadPersistedPeerId(dataDir: str): str =
    let path: str = peerIdStorePath(dataDir)
    if len(path) <= 0 || !fileExists(path):
        return ""
    let peerIdText: str = trimText(readFileText(path))
    if len(peerIdText) <= 0:
        return ""
    if isStubPeerId(peerIdText):
        return ""
    return peerIdText

@borrows
fn persistPeerId(dataDir: str, peerIdText: str): bool =
    let path: str = peerIdStorePath(dataDir)
    if len(path) <= 0:
        return false
    let normalized: str = trimText(peerIdText)
    if len(normalized) <= 0:
        return false
    if isStubPeerId(normalized):
        debugNodeStep("[ffi] peer_id_persist_skipped_invalid path=" + path)
        return false
    let writeOk: bool = c_cheng_write_file(cStr(path), cStr(normalized)) == 1
    if writeOk:
        debugNodeStep("[ffi] peer_id_persisted path=" + path + " peerId=" + normalized)
    else:
        debugNodeStep("[ffi] peer_id_persist_failed path=" + path)
    return writeOk

@borrows
fn initSwitchWithPersistentIdentity(swPtr: switch.Switch*, listenAddr: str, dataDir: str): bool =
    if swPtr == nil:
        gLastInitStage = -41
        setLastError("node_init: switch pointer nil")
        return false
    let addrRaw: str = trimText(listenAddr)
    let addrText: str =
        if len(addrRaw) > 0:
            addrRaw
        else:
            defaultListenAddr
    let hostOk: bool = um_newHostWithAddressText(addrText)
    if hostOk:
        applyHostIdentityDirect(swPtr, addrText, "")
        return true
    # Retry once with loopback-only address to avoid half-initialized switch.Switch state.
    let loopbackAddr: str = "/ip4/127.0.0.1/udp/0/quic-v1"
    if addrText != loopbackAddr:
        let retryOk: bool = um_newHostWithAddressText(loopbackAddr)
        if retryOk:
            applyHostIdentityDirect(swPtr, loopbackAddr, "")
            debugNodeStep("[ffi] node_init: host init fallback_addr_ok addr=" + loopbackAddr)
            return true
    gLastInitStage = -35
    let reasonText: str = trimText(gLastError)
    if len(reasonText) > 0:
        setLastError("node_init: host init failed: " + reasonText)
    else:
        setLastError("node_init: host init failed")
    return false

# Slim-profile twin of initSwitchWithPersistentIdentity: same address
# handling and loopback retry, but the host only registers
# identify/ping/gossipsub/feed. Reached only from libp2p_node_init_slim.
@borrows
fn initSwitchWithPersistentIdentitySlim(swPtr: switch.Switch*, listenAddr: str, dataDir: str): bool =
    if swPtr == nil:
        gLastInitStage = -41
        setLastError("node_init_slim: switch pointer nil")
        return false
    let addrRaw: str = trimText(listenAddr)
    let addrText: str =
        if len(addrRaw) > 0:
            addrRaw
        else:
            defaultListenAddrSlim
    if !um_newHostWithAddressTextSlim(addrText):
        return false
    applyHostIdentityDirect(swPtr, addrText, "")
    return true

fn readCpuModel(): str =
    let cpuInfo: str = readFileText("/proc/cpuinfo")
    if len(cpuInfo) <= 0:
        return "unknown"
    let byModelName: str = lineValueByLowerPrefix(cpuInfo, "model name")
    if len(byModelName) > 0:
        return byModelName
    let byHardware: str = lineValueByLowerPrefix(cpuInfo, "hardware")
    if len(byHardware) > 0:
        return byHardware
    let byCpuModel: str = lineValueByLowerPrefix(cpuInfo, "cpu model")
    if len(byCpuModel) > 0:
        return byCpuModel
    let byProcessor: str = lineValueByLowerPrefix(cpuInfo, "processor")
    if len(byProcessor) > 0:
        return byProcessor
    return "unknown"

fn readCpuFrequencyMHz(): int32 =
    var paths: str[]
    add(paths, "/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq")
    add(paths, "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq")
    add(paths, "/sys/devices/system/cpu/cpu0/cpufreq/base_frequency")
    var i: int32
    while i < len(paths):
        let raw: str = readFileText(paths[i])
        let value: int64 = parseFirstInt64(raw)
        if value > 0:
            if value > 10000:
                return int32(value / 1000)
            return int32(value)
        i = i + 1
    let cpuInfo: str = readFileText("/proc/cpuinfo")
    let mhzText: str = lineValueByLowerPrefix(cpuInfo, "cpu mhz")
    let mhz: int64 = parseFirstInt64(mhzText)
    if mhz > 0:
        return int32(mhz)
    return 0

fn readCpuCoreCount(): int32 =
    let cpuInfo: str = readFileText("/proc/cpuinfo")
    if len(cpuInfo) <= 0:
        let presentText: str = trimText(readFileText("/sys/devices/system/cpu/present"))
        let dashPos: int32 = indexOf(presentText, "-", 0)
        if dashPos >= 0:
            let endIndex: int64 = parseFirstInt64(SliceBytes(presentText, dashPos + 1, len(presentText) - dashPos - 1))
            if endIndex >= 0:
                return int32(endIndex + 1)
        return 0
    var count: int32
    let total: int32 = len(cpuInfo)
    var lineStart: int32
    var i: int32
    while i <= total:
        if i == total || cpuInfo[i] == '\n':
            let line: str = trimText(if i > lineStart: SliceBytes(cpuInfo, lineStart, i - lineStart) else: "")
            if startsWith(strLowerAscii(line), "processor"):
                count = count + 1
            lineStart = i + 1
        i = i + 1
    return count

fn readMemoryTotalBytes(): int64 =
    let memInfo: str = readFileText("/proc/meminfo")
    let totalText: str = lineValueByLowerPrefix(memInfo, "memtotal")
    let kb: int64 = parseFirstInt64(totalText)
    if kb > 0:
        return kb * 1024
    return 0

fn readMemoryAvailableBytes(): int64 =
    let memInfo: str = readFileText("/proc/meminfo")
    let availText: str = lineValueByLowerPrefix(memInfo, "memavailable")
    let kb: int64 = parseFirstInt64(availText)
    if kb > 0:
        return kb * 1024
    return readMemoryTotalBytes()

fn readMemoryFrequencyMHz(): int32 =
    return 0

fn readDiskType(): str =
    return "flash"

fn readGpuModel(): str =
    var paths: str[]
    add(paths, "/sys/class/kgsl/kgsl-3d0/gpu_model")
    add(paths, "/sys/class/kgsl/kgsl-3d0/device/model")
    add(paths, "/sys/class/misc/mali0/device/gpuinfo")
    add(paths, "/proc/gpuinfo")
    var i: int32
    while i < len(paths):
        let text: str = trimText(readFileText(paths[i]))
        if len(text) > 0:
            return text
        i = i + 1
    return "unknown"

fn readGpuMemoryBytes(): int64 =
    var paths: str[]
    add(paths, "/sys/class/kgsl/kgsl-3d0/gmem_size")
    add(paths, "/sys/class/kgsl/kgsl-3d0/memstore_size")
    add(paths, "/sys/class/misc/mali0/device/memory")
    var i: int32
    while i < len(paths):
        let value: int64 = parseFirstInt64(readFileText(paths[i]))
        if value > 0:
            return value
        i = i + 1
    return 0

fn readOsName(): str =
    return system.strFromCStringCopy(c_cheng_system_os_name_bridge())

fn readOsVersion(): str =
    return system.strFromCStringCopy(c_cheng_system_os_release_bridge())

fn refreshPassiveBandwidth(node: var NodeRuntime) =
    let peerTotal: int32 = safePeerCount(node)
    var totalUp: int64
    var totalDown: int64
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        if peerRowUsed(row):
            totalUp = totalUp + peerRowUplinkTotalBytes(row)
            totalDown = totalDown + peerRowDownlinkTotalBytes(row)
        i = i + 1
    let nowTs: int64 = nowMs()
    if node.bwLastSampleAtMs > 0 && nowTs > node.bwLastSampleAtMs:
        let elapsedMs: int64 = nowTs - node.bwLastSampleAtMs
        let deltaUp: int64 = if totalUp >= node.bwLastUplinkTotal: totalUp - node.bwLastUplinkTotal else: 0
        let deltaDown: int64 = if totalDown >= node.bwLastDownlinkTotal: totalDown - node.bwLastDownlinkTotal else: 0
        if elapsedMs > 0:
            node.bwPassiveUplinkBps = (deltaUp * 1000) / elapsedMs
            node.bwPassiveDownlinkBps = (deltaDown * 1000) / elapsedMs
    node.bwLastSampleAtMs = nowTs
    node.bwLastUplinkTotal = totalUp
    node.bwLastDownlinkTotal = totalDown

fn maybeRefreshNodeResources(node: var NodeRuntime) =
    let swIdxIgnored: int32 = nodeSwitchIndex(node)
    let startedIgnored: bool = node.started
    if swIdxIgnored < -1 && startedIgnored:
        debugNodeStep("[ffi] node_resource_refresh_noop")
    return

fn localSystemProfileJson(node: var NodeRuntime): str =
    refreshPassiveBandwidth(node)
    let diskPath: str = CloneDataDirOrRoot(node.dataDir)
    let diskTotal: int64 = c_um_sys_disk_total_bytes(cStr(diskPath))
    let diskAvailable: int64 = c_um_sys_disk_available_bytes(cStr(diskPath))
    var out: str = "{"
    out = out + "\"os\":{\"name\":" + toJsonStringValue(readOsName()) + ",\"version\":" + toJsonStringValue(readOsVersion()) + "}"
    out = out + ",\"cpu\":{\"model\":" + toJsonStringValue(readCpuModel()) + ",\"frequencyMHz\":" + $readCpuFrequencyMHz() + ",\"cores\":" + $readCpuCoreCount() + "}"
    out = out + ",\"memory\":{\"totalBytes\":" + $readMemoryTotalBytes() + ",\"frequencyMHz\":" + $readMemoryFrequencyMHz() + "}"
    out = out + ",\"disk\":{\"type\":" + toJsonStringValue(readDiskType()) + ",\"totalBytes\":" + $diskTotal + ",\"availableBytes\":" + $diskAvailable + "}"
    out = out + ",\"gpu\":{\"model\":" + toJsonStringValue(readGpuModel()) + ",\"vramBytes\":" + $readGpuMemoryBytes() + "}"
    out = out + ",\"bandwidth\":{"
    out = out + "\"uplinkBps\":" + $node.bwPassiveUplinkBps
    out = out + ",\"downlinkBps\":" + $node.bwPassiveDownlinkBps
    out = out + ",\"measuredUplinkBps\":" + $node.bwPassiveUplinkBps
    out = out + ",\"measuredDownlinkBps\":" + $node.bwPassiveDownlinkBps
    out = out + ",\"uplinkTotalBytes\":" + $node.bwLastUplinkTotal
    out = out + ",\"downlinkTotalBytes\":" + $node.bwLastDownlinkTotal
    out = out + ",\"totalTransferBytes\":" + $(node.bwLastUplinkTotal + node.bwLastDownlinkTotal)
    out = out + ",\"relayBottleneckBps\":0"
    out = out + ",\"isRelayed\":false"
    out = out + "}"
    out = out + "}"
    return out

fn networkResourcesSummaryJson(node: var NodeRuntime): str =
    refreshPassiveBandwidth(node)
    let localCpuCores: int64 = int64(readCpuCoreCount())
    let localMemoryBytes: int64 = readMemoryTotalBytes()
    let localMemoryAvailable: int64 = readMemoryAvailableBytes()
    let localGpuVramBytes: int64 = readGpuMemoryBytes()
    let diskPath: str = CloneDataDirOrRoot(node.dataDir)
    let localDiskAvailable: int64 = c_um_sys_disk_available_bytes(cStr(diskPath))
    let localDiskTotal: int64 = c_um_sys_disk_total_bytes(cStr(diskPath))
    let peerTotal: int32 = safePeerCount(node)
    var totalKnownPeers: int32
    var uplinkTotalBytes: int64 = node.bwLastUplinkTotal
    var downlinkTotalBytes: int64 = node.bwLastDownlinkTotal
    var uplinkBps: int64 = node.bwPassiveUplinkBps
    var downlinkBps: int64 = node.bwPassiveDownlinkBps
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        if peerRowUsed(row):
            totalKnownPeers = totalKnownPeers + 1
            uplinkTotalBytes = uplinkTotalBytes + peerRowUplinkTotalBytes(row)
            downlinkTotalBytes = downlinkTotalBytes + peerRowDownlinkTotalBytes(row)
            uplinkBps = uplinkBps + peerRowMeasuredUplinkBps(row)
            downlinkBps = downlinkBps + peerRowMeasuredDownlinkBps(row)
        i = i + 1
    let connectedCount: int32 = countConnectedPeers(node)
    var out: str = "{"
    out = out + "\"nodeCount\":" + $(totalKnownPeers + 1)
    out = out + ",\"onlineCount\":" + $(connectedCount + 1)
    out = out + ",\"connectedPeers\":" + $connectedCount
    out = out + ",\"cpuCoresTotal\":" + $localCpuCores
    out = out + ",\"memoryTotalBytes\":" + $localMemoryBytes
    out = out + ",\"memoryAvailableBytes\":" + $localMemoryAvailable
    out = out + ",\"diskTotalBytes\":" + $localDiskTotal
    out = out + ",\"diskAvailableBytes\":" + $localDiskAvailable
    out = out + ",\"gpuVramTotalBytes\":" + $localGpuVramBytes
    out = out + ",\"uplinkBps\":" + $uplinkBps
    out = out + ",\"downlinkBps\":" + $downlinkBps
    out = out + ",\"uplinkTotalBytes\":" + $uplinkTotalBytes
    out = out + ",\"downlinkTotalBytes\":" + $downlinkTotalBytes
    out = out + ",\"totalTransferBytes\":" + $(uplinkTotalBytes + downlinkTotalBytes)
    out = out + ",\"peersWithGpu\":" + $nres.nodeResourcePeersWithGpuCount()
    out = out + ",\"osBreakdown\":" + nres.nodeResourceOsBreakdownJson()
    out = out + "}"
    return out

fn sourceMaskFromText(sourceText: str): int32 =
    let lower: str = strLowerAscii(sourceText)
    if StrContains(lower, "ble"):
        return sourceBle | sourceLan
    if StrContains(lower, "mdns"):
        return sourceMdns | sourceLan
    if StrContains(lower, "dht"):
        return sourceDht | sourceWan
    if StrContains(lower, "rendez"):
        return sourceRendezvous | sourceWan
    if StrContains(lower, "lan"):
        return sourceLan
    if StrContains(lower, "wan"):
        return sourceWan
    if StrContains(lower, "bootstrap"):
        return sourceDht | sourceWan
    if StrContains(lower, "connected"):
        return sourceConnected
    return sourceWan

@borrows
fn isLikelyPeerId(value: str): bool =
    let text: str = trimText(value)
    if len(text) < 10:
        return false
    return isValidLibp2pPeerId(text)

@borrows
fn isLikelyMultiaddr(value: str): bool =
    let text: str = trimText(value)
    if len(text) <= 0:
        return false
    if text[0] != '/':
        return false
    let textLen: int32 = len(text)
    if textLen >= 5 && text[1] == 'i' && text[2] == 'p' && (text[3] == '4' || text[3] == '6') && text[4] == '/':
        return true
    if textLen >= 5 && text[1] == 'd' && text[2] == 'n' && text[3] == 's' && text[4] == '/':
        return true
    if textLen >= 6 && text[1] == 'd' && text[2] == 'n' && text[3] == 's' && (text[4] == '4' || text[4] == '6') && text[5] == '/':
        return true
    if textLen >= 9 && text[1] == 'd' && text[2] == 'n' && text[3] == 's' && text[4] == 'a' && text[5] == 'd' && text[6] == 'd' && text[7] == 'r' && text[8] == '/':
        return true
    if StrContains(text, "/p2p-circuit"):
        return true
    return false

fn syncPeerstoreIntoNode(node: var NodeRuntime, sourceMask: int32) =
    let swIdx: int32 = nodeSwitchIndex(node)
    if swIdx < 0:
        return
    let hostPeerId: str = canonicalPeerIdOrEmpty(um_hostPeerIdTextIndex(swIdx))
    if !isStubPeerId(hostPeerId):
        node.localPeerId = hostPeerId
    let localPeerIdText: str = trimText(node.localPeerId)
    let peersJson: str = um_hostDumpPeersLimitIndex(swIdx, 256)
    var values: str[]
    var valueCount: int32
    parseQuotedValuesInto(peersJson, values, valueCount)
    var currentPeerId: str
    var i: int32
    while i < valueCount:
        let token: str = trimText(values[i])
        if isLikelyPeerId(token):
            currentPeerId = canonicalPeerIdOrEmpty(token)
            if len(currentPeerId) > 0 && currentPeerId != localPeerIdText:
                addPeerAddress(node, currentPeerId, "", sourceMask)
        elif isLikelyMultiaddr(token):
            var peerIdText: str = extractPeerIdFromMultiaddr(token)
            if len(currentPeerId) > 0:
                peerIdText = strings.CloneStr(currentPeerId)
            if len(peerIdText) > 0 && peerIdText != localPeerIdText:
                addPeerAddress(node, peerIdText, token, sourceMask)
        i = i + 1

fn peerSourcesJson(mask: int32): str =
    var out: str = "["
    var first: bool = true
    if (mask & sourceMdns) != 0:
        if !first:
            out = out + ","
        out = out + toJsonStringValue("mDNS")
        first = false
    if (mask & sourceBle) != 0:
        if !first:
            out = out + ","
        out = out + toJsonStringValue("BLE")
        first = false
    if (mask & sourceDht) != 0:
        if !first:
            out = out + ","
        out = out + toJsonStringValue("DHT")
        first = false
    if (mask & sourceConnected) != 0:
        if !first:
            out = out + ","
        out = out + toJsonStringValue("Connected")
        first = false
    if (mask & sourceLan) != 0:
        if !first:
            out = out + ","
        out = out + toJsonStringValue("LAN")
        first = false
    if (mask & sourceWan) != 0:
        if !first:
            out = out + ","
        out = out + toJsonStringValue("WAN")
        first = false
    if (mask & sourceRendezvous) != 0:
        if !first:
            out = out + ","
        out = out + toJsonStringValue("Rendezvous")
        first = false
    out = out + "]"
    return out

fn safePeerCount(node: var NodeRuntime): int32 =
    if node.peerCount <= 0:
        return 0
    var bounded: int32 = node.peerCount
    if bounded > maxPeersPerNode:
        bounded = maxPeersPerNode
    if bounded > maxSafePeerScan:
        return maxSafePeerScan
    return bounded

fn connectedPeersJson(node: var NodeRuntime): str =
    let peerTotal: int32 = safePeerCount(node)
    var out: str = "["
    var first: bool = true
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && peerRowConnected(row) && isValidLibp2pPeerId(peerIdText):
            if !first:
                out = out + ","
            out = out + toJsonStringValue(strings.CloneStr(peerIdText))
            first = false
        i = i + 1
    out = out + "]"
    return out

fn countConnectedPeers(node: var NodeRuntime): int32 =
    let peerTotal: int32 = safePeerCount(node)
    var count: int32
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        if peerRowUsed(row) && peerRowConnected(row) && isValidLibp2pPeerId(peerRowPeerId(row)):
            count = count + 1
        i = i + 1
    return count

fn peersBySourceJson(node: var NodeRuntime, sourceMask: int32): str =
    let peerTotal: int32 = safePeerCount(node)
    var out: str = "["
    var first: bool = true
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && (peerRowSourceMask(row) & sourceMask) != 0 && isValidLibp2pPeerId(peerIdText):
            if !first:
                out = out + ","
            out = out + toJsonStringValue(strings.CloneStr(peerIdText))
            first = false
        i = i + 1
    out = out + "]"
    return out

@borrows
fn queuePeek(queue: var EventQueue, limit: int32): str =
    let total: int32 =
        if queue.count <= 0 || len(queue.itemsText) <= 0:
            0
        else:
            queue.count
    let cap: int32 =
        if limit <= 0 || limit > total:
            total
        else:
            limit
    var out: str = "["
    let source: str = strings.CloneStr(queue.itemsText)
    var offset: int32
    var wrote: bool
    var i: int32
    while i < cap && offset < len(source):
        let sep: int32 = queueNextSeparator(source, offset)
        let endPos: int32 = if sep >= 0: sep else: len(source)
        let item: str = strings.CloneStr(SliceBytes(source, offset, endPos - offset))
        if len(item) > 0:
            if wrote:
                out = out + ","
            out = out + strings.CloneStr(item)
            wrote = true
        if sep < 0:
            offset = len(source)
        else:
            offset = sep + 1
        i = i + 1
    out = out + "]"
    return out

# Real per-peer profile, sourced only from data this peer actually reported
# over the node-resource sync protocol (see nodeResourceSyncTick in
# cheng/libp2p/main). Returns "" when nothing has been received yet for this
# peer — the caller must omit the systemProfile field entirely rather than
# invent placeholder values for a peer we know nothing real about.
@borrows
fn peerSystemProfileJson(row: str, peerIdText: str): str =
    let idx: int32 = nres.nodeResourceFindPeerIndex(strings.CloneStr(peerIdText))
    if idx < 0:
        return ""
    if !nres.nodeResourceEntryHasData(idx):
        return ""
    return nres.nodeResourceEntrySystemProfileJson(idx, 0, 0, 0, 0, 0, false)

fn connectedPeersInfoJson(node: var NodeRuntime): str =
    let peerTotal: int32 = safePeerCount(node)
    var out: str = "["
    var first: bool = true
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && peerRowConnected(row) && isValidLibp2pPeerId(peerIdText):
            if !first:
                out = out + ","
            out = out + "{"
            out = out + "\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText))
            out = out + ",\"peer_id\":" + toJsonStringValue(strings.CloneStr(peerIdText))
            out = out + ",\"connectionCount\":1"
            out = out + ",\"latencyMs\":" + $peerRowLatencyMs(row)
            out = out + ",\"addresses\":" + peerAddrsJsonFromAddr(peerRowAddr(row))
            out = out + ",\"multiaddrs\":" + peerAddrsJsonFromAddr(peerRowAddr(row))
            out = out + ",\"sources\":" + peerSourcesJson(peerRowSourceMask(row))
            let profile: str = peerSystemProfileJson(row, peerIdText)
            if len(profile) > 0:
                out = out + ",\"systemProfile\":" + profile
            out = out + "}"
            first = false
        i = i + 1
    out = out + "]"
    return out

fn loadStoredPeersJson(node: var NodeRuntime): str =
    let peerTotal: int32 = safePeerCount(node)
    var out: str = "{\"peers\":["
    var first: bool = true
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        if peerRowUsed(row):
            if !first:
                out = out + ","
            out = out + "{"
            out = out + "\"peerId\":" + toJsonStringValue(peerRowPeerId(row))
            out = out + ",\"addresses\":" + peerAddrsJsonFromAddr(peerRowAddr(row))
            out = out + ",\"multiaddrs\":" + peerAddrsJsonFromAddr(peerRowAddr(row))
            out = out + "}"
            first = false
        i = i + 1
    out = out + "],\"totalCount\":" + $peerTotal + "}"
    return out

fn bootstrapPeersJson(node: var NodeRuntime, limit: int32): str =
    let totalPeers: int32 = safePeerCount(node)
    var out: str = "{\"peers\":["
    let cap: int32 =
        if limit <= 0 || limit > totalPeers:
            totalPeers
        else:
            limit
    var added: int32
    var i: int32
    while i < totalPeers && added < cap:
        let row: str = peerRowAt(node, i)
        let peerIdText: str = peerRowPeerId(row)
        let addrText: str = peerRowAddr(row)
        if peerRowUsed(row) && len(addrText) > 0 && peerIdText != node.localPeerId:
            if added > 0:
                out = out + ","
            out = out + "{"
            out = out + "\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText))
            out = out + ",\"multiaddrs\":" + peerAddrsJsonFromAddr(addrText)
            out = out + ",\"lastSeenAt\":" + $peerRowLastSeenAtMs(row)
            out = out + "}"
            added = added + 1
        i = i + 1
    out = out + "],\"selectedCount\":" + $added + ",\"totalCount\":" + $totalPeers + "}"
    return out

fn parseStringListPayload(text: str): str[] =
    return parseQuotedValues(text)

@borrows
fn parseStringListPayloadInto(text: str, out: var str[], outCount: var int32) =
    parseQuotedValuesInto(text, out, outCount)

@borrows
fn primaryAddressForPeer(node: var NodeRuntime, peerIdText: str): str =
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(target) <= 0:
        return ""
    let idx: int32 = peerIndexOf(node, target)
    if idx < 0:
        return ""
    let row: str = peerRowAt(node, idx)
    if !peerRowUsed(row):
        return ""
    return peerRowAddr(row)
    return ""

@borrows
fn hasBootstrapPeer(node: var NodeRuntime, peerIdText: str): bool =
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(target) <= 0:
        return false
    let total: int32 = if node.bootstrapCount < len(node.bootstrapPeers): node.bootstrapCount else: len(node.bootstrapPeers)
    var i: int32
    while i < total:
        if canonicalPeerIdOrEmpty(node.bootstrapPeers[i]) == target:
            return true
        i = i + 1
    return false

@borrows
fn hasHibernatedPeer(node: var NodeRuntime, peerIdText: str): bool =
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(target) <= 0:
        return false
    let total: int32 = if node.hibernatedCount < len(node.hibernatedPeers): node.hibernatedCount else: len(node.hibernatedPeers)
    var i: int32
    while i < total:
        if canonicalPeerIdOrEmpty(node.hibernatedPeers[i]) == target:
            return true
        i = i + 1
    return false

fn setPeerHibernated(node: var NodeRuntime, peerIdText: str, hibernated: bool) =
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(target) <= 0:
        return
    let total: int32 = if node.hibernatedCount < len(node.hibernatedPeers): node.hibernatedCount else: len(node.hibernatedPeers)
    var found: int32 = -1
    var i: int32
    while i < total:
        if canonicalPeerIdOrEmpty(node.hibernatedPeers[i]) == target:
            found = i
            break
        i = i + 1
    if hibernated:
        if found >= 0:
            return
        if len(node.hibernatedPeers) >= maxPeersPerNode:
            return
        add(node.hibernatedPeers, strings.CloneStr(target))
        node.hibernatedCount = len(node.hibernatedPeers)
        return
    if found < 0:
        return
    var next: str[]
    var j: int32
    while j < len(node.hibernatedPeers):
        if j != found:
            add(next, strings.CloneStr(node.hibernatedPeers[j]))
        j = j + 1
    node.hibernatedPeers = next
    node.hibernatedCount = len(next)

fn callHostDial(node: var NodeRuntime, addrText: str): bool =
    let swIdx: int32 = nodeSwitchIndex(node)
    if swIdx < 0:
        setLastError("dial: switch missing")
        return false
    let dialOk: bool = um_hostDialTextIndex(swIdx, addrText)
    if !dialOk:
        setLastError("dial: failed")
        return false
    return true

@borrows
fn callHostDialPeer(node: var NodeRuntime, peerText: str): bool =
    let owned: str = strings.CloneStr(peerText)
    let swIdx: int32 = nodeSwitchIndex(node)
    if swIdx < 0:
        setLastError("dial_peer: switch missing")
        return false
    let dialOk: bool = um_hostDialPeerTextIndex(swIdx, strings.CloneStr(owned))
    if dialOk:
        return true
    let fallbackAddr: str = primaryAddressForPeer(node, strings.CloneStr(owned))
    if len(fallbackAddr) > 0:
        let addrDialOk: bool = um_hostDialTextIndex(swIdx, fallbackAddr)
        if addrDialOk:
            setPeerConnected(node, strings.CloneStr(owned), true)
            return true
    let target: str = canonicalPeerIdOrEmpty(owned)
    if len(target) > 0:
        let peerTotal: int32 = safePeerCount(node)
        var i: int32
        while i < peerTotal:
            let row: str = peerRowAt(node, i)
            if peerRowUsed(row) && peerRowPeerId(row) == target && peerRowConnected(row):
                return true
            i = i + 1
    setLastError("dial_peer: failed")
    return false

fn pushToPunchReconnect(node: var NodeRuntime, peerIdText: str): bool =
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    if len(target) <= 0:
        setLastError("push_to_punch: missing peerId")
        return false
    let hintedAddr: str = primaryAddressForPeer(node, target)
    if len(hintedAddr) > 0:
        if callHostDial(node, hintedAddr):
            setPeerConnected(node, target, true)
            return true
    if hasBootstrapPeer(node, target):
        if callHostDialPeer(node, target):
            setPeerConnected(node, target, true)
            return true
    if callHostDialPeer(node, target):
        setPeerConnected(node, target, true)
        return true
    return false

@borrows
fn isJsonObjectText(text: str): bool =
    let trimmed: str = trimText(text)
    if len(trimmed) < 2:
        return false
    return trimmed[0] == '{' && trimmed[len(trimmed) - 1] == '}'

@borrows
fn isJsonArrayText(text: str): bool =
    let trimmed: str = trimText(text)
    if len(trimmed) < 2:
        return false
    return trimmed[0] == '[' && trimmed[len(trimmed) - 1] == ']'

fn parseRwadResponseText(text: str): str =
    let trimmed: str = trimText(text)
    if startsWith(trimmed, "ok:") && len(trimmed) > 3:
        return trimText(SliceBytes(trimmed, 3, len(trimmed) - 3))
    return trimmed

fn pickRwadServicePeer(node: var NodeRuntime): str =
    if len(node.rwadServiceNamespace) <= 0:
        node.rwadServiceNamespace = rwadDefaultNamespace
    if len(node.rwadServicePeerId) > 0:
        let cachedTarget: str = canonicalPeerIdOrEmpty(node.rwadServicePeerId)
        if peerIndexOf(node, cachedTarget) >= 0:
            return node.rwadServicePeerId

    syncPeerstoreIntoNode(node, sourceConnected | sourceRendezvous | sourceWan)
    let peerTotal: int32 = safePeerCount(node)
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && peerRowConnected(row) && (peerRowSourceMask(row) & sourceRendezvous) != 0:
            node.rwadServicePeerId = peerIdText
            return peerIdText
        i = i + 1
    i = 0
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && peerRowConnected(row):
            node.rwadServicePeerId = peerIdText
            return peerIdText
        i = i + 1
    i = 0
    while i < peerTotal:
        let row: str = peerRowAt(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && (peerRowSourceMask(row) & sourceRendezvous) != 0:
            node.rwadServicePeerId = peerIdText
            return peerIdText
        i = i + 1
    return ""

fn rwadRequestJson(method: str, paramsJson: str): str =
    let payload: str = normalizeJsonPayload(paramsJson)
    return "{\"rpc\":\"rwad.v1\",\"method\":" + toJsonStringValue(strings.CloneStr(method)) + ",\"params\":" + payload + ",\"ts\":" + $nowMs() + ",\"nonce\":" + toJsonStringValue("rwad-" + $nextSeq()) + "}"

fn rwadRpcRequest(node: var NodeRuntime, handle: int64, method: str, paramsJson: str): str =
    let peerIdText: str = pickRwadServicePeer(node)
    if len(peerIdText) <= 0:
        setLastError("rwad_service_peer_unavailable")
        return "{\"ok\":false,\"error\":\"rwad_service_peer_unavailable\"}"
    if !callHostDialPeer(node, peerIdText):
        return "{\"ok\":false,\"error\":\"rwad_service_dial_failed\",\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"reason\":" + toJsonStringValue(strings.CloneStr(gLastError)) + "}"
    let requestText: str = rwadRequestJson(method, paramsJson)
    emitNodeEvent(&node, "rwad.rpc", "{\"method\":" + toJsonStringValue(strings.CloneStr(method)) + ",\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"ok\":true,\"transport\":\"dial_only\",\"request\":" + normalizeJsonPayload(requestText) + "}")
    return "{\"ok\":true,\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"transport\":\"dial_only\",\"request\":" + normalizeJsonPayload(requestText) + "}"

fn ensureMdnsNetworkEnabled() =
    0

fn syncMdnsConfig() =
    ensureMdnsNetworkEnabled()

fn listDiscoveredPeersJson(node: var NodeRuntime, filterText: str, limit: int32): str =
    let totalPeers: int32 = safePeerCount(node)
    let lowerFilter: str = strLowerAscii(filterText)
    let useFilter: bool = len(trimText(lowerFilter)) > 0
    let maxCount: int32 = if limit <= 0 || limit > totalPeers: totalPeers else: limit
    var out: str = "{\"peers\":["
    var added: int32
    var matchedTotal: int32
    var i: int32
    while i < totalPeers:
        let row: str = peerRowAt(node, i)
        let canonicalPeerId: str = peerRowPeerId(row)
        if peerRowUsed(row) && len(canonicalPeerId) > 0 && canonicalPeerId != node.localPeerId:
            var include: bool = true
            if useFilter:
                include = false
                let sources: str = strLowerAscii(peerSourcesJson(peerRowSourceMask(row)))
                if StrContains(sources, lowerFilter):
                    include = true
            if include:
                matchedTotal = matchedTotal + 1
                if added < maxCount:
                    if added > 0:
                    out = out + ","
                out = out + "{"
                out = out + "\"peerId\":" + toJsonStringValue(strings.CloneStr(canonicalPeerId))
                out = out + ",\"multiaddrs\":" + peerAddrsJsonFromAddr(peerRowAddr(row))
                out = out + ",\"sources\":" + peerSourcesJson(peerRowSourceMask(row))
                out = out + ",\"lastSeenAt\":" + $peerRowLastSeenAtMs(row)
                out = out + "}"
                added = added + 1
        i = i + 1
    out = out + "],\"totalCount\":" + $matchedTotal + "}"
    return out

@borrows
fn isStubPeerId(peerIdText: str): bool =
    let normalized: str = trimText(peerIdText)
    if len(normalized) <= 0:
        return true
    let lowerPeer: str = strLowerAscii(normalized)
    if startsWith(lowerPeer, "did:"):
        return true
    if StrContains(lowerPeer, "stub"):
        return true
    if !isValidLibp2pPeerId(normalized):
        return true
    if startsWith(normalized, "12D3KooW"):
        let suffix: str = SliceBytes(normalized, 8, len(normalized) - 8)
        if len(suffix) >= 16 && isRepeatedText(suffix):
            return true
    return false

@borrows
fn isRepeatedText(text: str): bool =
    let n: int32 = len(text)
    if n <= 1:
        return false
    let first: char = text[0]
    var i: int32 = 1
    while i < n:
        if text[i] != first:
            return false
        i = i + 1
    return true

fn isAllSameChar(text: str, target: char): bool =
    let n: int32 = len(text)
    if n <= 0:
        return false
    var i: int32
    while i < n:
        if text[i] != target:
            return false
        i = i + 1
    return true

fn isBase58Char(ch: char): bool =
    if ch >= '1' && ch <= '9':
        return true
    if ch >= 'A' && ch <= 'H':
        return true
    if ch >= 'J' && ch <= 'N':
        return true
    if ch >= 'P' && ch <= 'Z':
        return true
    if ch >= 'a' && ch <= 'k':
        return true
    if ch >= 'm' && ch <= 'z':
        return true
    return false

fn base58TextFromIndex(index: int32): str =
    let base58Alphabet: str = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    let idx: int32 =
        if index < 0:
            0
        elif index > 57:
            57
        else:
            index
    return charToStr(base58Alphabet[idx])

@borrows
fn isValidLibp2pPeerId(peerIdText: str): bool =
    let normalized: str = trimText(peerIdText)
    let n: int32 = len(normalized)
    if n <= 0:
        return false
    if startsWith(strLowerAscii(normalized), "did:"):
        return false
    if n < 32 || n > 62:
        return false
    if startsWith(normalized, "12D3Koo"):
        if n != 52:
            return false
    elif startsWith(normalized, "16Uiu2"):
        if n < 52 || n > 62:
            return false
    elif startsWith(normalized, "Qm"):
        if n != 46:
            return false
    else:
        return false
    var i: int32
    while i < n:
        if !isBase58Char(normalized[i]):
            return false
        i = i + 1
    return true

@borrows
fn canonicalPeerIdOrEmpty(peerIdText: str): str =
    let normalized: str = trimText(peerIdText)
    if isValidLibp2pPeerId(normalized):
        return normalized
    return ""

fn deterministicPeerIdFromSeed(seedText: str): str =
    var seed: str = trimText(seedText)
    if len(seed) <= 0:
        seed = "unimaker:device"
    var stream: str = textToHex(seed + "|peer:v2")
    if len(stream) <= 0:
        stream = "abcdef123456789"
    let streamLen: int32 = len(stream)
    var rolling: int32 = 97
    var body: str
    var i: int32
    while i < 44:
        let idxA: int32 = (i * 5 + rolling) % streamLen
        let idxB: int32 = (i * 11 + 7 + rolling) % streamLen
        let a: int32 = ord(stream[idxA])
        let b: int32 = ord(stream[idxB])
        rolling = (rolling * 131 + a * 17 + b + i) % 104729
        let pick: int32 = (a + b + rolling + i * 13) % 58
        body = body + base58TextFromIndex(pick)
        i = i + 1
    var peerIdText: str = "12D3KooW" + body
    if isValidLibp2pPeerId(peerIdText):
        return peerIdText

    # Emergency fallback for unexpected runtime string/char lowering issues.
    let emergencySeed: str = textToHex(seed + "|peer:emergency|" + stream)
    let emergencyStream: str = if len(emergencySeed) > 0: emergencySeed else: "0123456789abcdef"
    let emergencyLen: int32 = len(emergencyStream)
    var emergencyBody: str
    var j: int32
    while j < 44:
        let pick: int32 = ord(emergencyStream[j % emergencyLen]) % 58
        emergencyBody = emergencyBody + base58TextFromIndex(pick)
        j = j + 1
    peerIdText = "12D3KooW" + emergencyBody
    if isValidLibp2pPeerId(peerIdText):
        return peerIdText
    return "12D3KooW123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijk"

fn fallbackSeedForNode(node: var NodeRuntime): str =
    let dataSeed: str = trimText(node.dataDir)
    if len(dataSeed) > 0:
        return "datadir:" + dataSeed
    let listenSeed: str = trimText(node.listenAddr)
    if len(listenSeed) > 0:
        return "listen:" + listenSeed
    return "slot:" + $node.switchIndex + "|seq:" + $gSeq

@borrows
fn fallbackSeedForNodePtr(node: NodeRuntime*): str =
    if node == nil:
        return "slot:nil"
    return "slot:" + $node->switchIndex + "|seq:" + $gSeq

fn forceDeterministicPeerId(node: NodeRuntime*): str =
    if node == nil:
        return "12D3KooW123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijk"
    let generated: str = canonicalPeerIdOrEmpty(deterministicPeerIdFromSeed(fallbackSeedForNodePtr(node)))
    if len(generated) > 0:
        return generated
    return "12D3KooW123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijk"

fn resolveNodePeerId(node: NodeRuntime*): str =
    let index: int32 = nodePtrIndex(node)
    if index < 0 || node == nil || !(node->used):
        return ""
    # Runtime query path must be non-blocking: avoid filesystem/system probing here.
    let localPeerId: str = CloneLocalPeerIdAt(index)
    if len(localPeerId) > 0:
        StoreLocalPeerIdAt(index, localPeerId)
        let localSwIdx: int32 = node->switchIndex
        if localSwIdx >= 0:
            let localSwPtr: switch.Switch* = switchPtrAt(localSwIdx)
            if localSwPtr != nil:
                applyHostIdentityDirect(localSwPtr, CloneListenAddrAt(index), CloneLocalPeerIdAt(index))
        return CloneLocalPeerIdAt(index)
    let persistedPeerId: str = canonicalPeerIdOrEmpty(loadPersistedPeerId(CloneDataDirAt(index)))
    if len(persistedPeerId) > 0:
        StoreLocalPeerIdAt(index, persistedPeerId)
        let persistedSwIdx: int32 = node->switchIndex
        if persistedSwIdx >= 0:
            let persistedSwPtr: switch.Switch* = switchPtrAt(persistedSwIdx)
            if persistedSwPtr != nil:
                applyHostIdentityDirect(persistedSwPtr, CloneListenAddrAt(index), CloneLocalPeerIdAt(index))
        return CloneLocalPeerIdAt(index)
    let swIdx: int32 = node->switchIndex
    if swIdx >= 0:
        let hostPeerId: str = canonicalPeerIdOrEmpty(trimText(um_hostPeerIdTextIndex(swIdx)))
        if len(hostPeerId) > 0:
            StoreLocalPeerIdAt(index, hostPeerId)
            let hostDir: str = CloneDataDirAt(index)
            if len(trimText(strings.CloneStr(hostDir))) > 0:
                let _ = persistPeerId(hostDir, CloneLocalPeerIdAt(index))
            return CloneLocalPeerIdAt(index)
    StoreLocalPeerIdAt(index, forceDeterministicPeerId(node))
    if swIdx >= 0:
        let swPtr: switch.Switch* = switchPtrAt(swIdx)
        if swPtr != nil:
            applyHostIdentityDirect(swPtr, CloneListenAddrAt(index), CloneLocalPeerIdAt(index))
    let dataDirText: str = CloneDataDirAt(index)
    if len(trimText(strings.CloneStr(dataDirText))) > 0:
        let _ = persistPeerId(dataDirText, CloneLocalPeerIdAt(index))
    return CloneLocalPeerIdAt(index)

fn chooseLocalPeerId(): str =
    var i: int32
    while i < maxNodes:
        let stable: str = CloneLocalPeerIdAt(i)
        if len(stable) > 0:
            return stable
        i = i + 1
    return ""

fn CloneLocalPeerIdAt(index: int32): str =
    if index == 0:
        if !gNode0.used:
            return ""
        return canonicalPeerIdOrEmpty(strings.CloneStr(gNode0.localPeerId))
    if index == 1:
        if !gNode1.used:
            return ""
        return canonicalPeerIdOrEmpty(strings.CloneStr(gNode1.localPeerId))
    if index == 2:
        if !gNode2.used:
            return ""
        return canonicalPeerIdOrEmpty(strings.CloneStr(gNode2.localPeerId))
    if index == 3:
        if !gNode3.used:
            return ""
        return canonicalPeerIdOrEmpty(strings.CloneStr(gNode3.localPeerId))
    if index == 4:
        if !gNode4.used:
            return ""
        return canonicalPeerIdOrEmpty(strings.CloneStr(gNode4.localPeerId))
    if index == 5:
        if !gNode5.used:
            return ""
        return canonicalPeerIdOrEmpty(strings.CloneStr(gNode5.localPeerId))
    if index == 6:
        if !gNode6.used:
            return ""
        return canonicalPeerIdOrEmpty(strings.CloneStr(gNode6.localPeerId))
    if index == 7:
        if !gNode7.used:
            return ""
        return canonicalPeerIdOrEmpty(strings.CloneStr(gNode7.localPeerId))
    return ""

