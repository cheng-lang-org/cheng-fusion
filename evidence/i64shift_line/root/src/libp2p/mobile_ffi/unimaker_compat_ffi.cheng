@exportc("social_query_presence")
fn social_query_presence(handle: int64, peerIdsJsonPtr: void*): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"peers\":[]}")
    let peersJson: str = trimText(voidPtrText(peerIdsJsonPtr))
    var values: str[]
    var count: int32
    parseStringListPayloadInto(peersJson, values, count)
    var out: str = "{\"peers\":["
    var i: int32
    while i < count:
        if i > 0:
            out = out + ","
        let peerIdText: str = values[i]
        let target: str = canonicalPeerIdOrEmpty(peerIdText)
        var online: bool
        var lastSeen: int64
        let peerTotal: int32 = safePeerCountPtr(node)
        var peerScan: int32
        while peerScan < peerTotal:
            let row: str = peerRowAtPtr(node, peerScan)
            if peerRowUsed(row) && peerRowPeerId(row) == target:
                online = peerRowConnected(row)
                lastSeen = peerRowLastSeenAtMs(row)
                break
            peerScan = peerScan + 1
        out = out + "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"online\":" + (if online: "true" else: "false") + ",\"lastSeenAt\":" + $lastSeen + "}"
        i = i + 1
    out = out + "]}"
    return dupCString(strings.CloneStr(out))

@exportc("social_poll_events")
fn social_poll_events(handle: int64, maxEventsRequested: int32): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("[]")
    # This is the only poll point every platform's live event loop already
    # calls on every wake cycle, so piggyback the shared gossip-inbox drain
    # here: it is what actually turns a subscribed topic's pending wire
    # messages into stored feed entries + the "moments"/"upsert" event this
    # same call reads back below, without requiring a dedicated per-platform
    # drain trigger. No-op (single empty-queue check) when nothing pending.
    let _ = drainInboundGossipMessagesPtr(node)
    return dupCString(DrainNodeSocialEvents(node, maxEventsRequested))

# Blocking feed-event wait for the Android generated shell's realtime home feed
# (gossipsub inbound -> cheng_app_distributed_contents_update_utf8). The shell's
# feed-event pump thread parks inside this call; it returns 1 the moment the
# shared gossip-inbox drain stores >=1 new publish-metadata/content-announce
# entry, 0 on timeout, -1 on an invalid handle. The pubsub inbox is a plain
# poll-only queue (no condvar anywhere in the gossipsub stack), so between
# checks the thread sleeps 25ms — that sleep IS the honest wait granularity of
# this transport, not a hidden busy-poll: one blocked thread, no Java-side
# timer, and the wake path carries no fabricated events (the caller re-reads
# the real queue via social_poll_events after rc==1).
@exportc("social_wait_feed_event")
fn social_wait_feed_event(handle: int64, timeoutMs: int32): int32 =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return -1
    let deadlineMs: int64 = nowMs() + timeoutMs
    while true:
        let stored: int32 = drainInboundGossipMessagesPtr(node)
        if stored > 0:
            return 1
        if nowMs() >= deadlineMs:
            return 0
        let _ = c_usleep(25000)
    return 0

@exportc("social_poll_events_without_dm_cstr")
fn social_poll_events_without_dm_cstr(handle: int64, maxEventsRequested: int32): cstring =
    return social_poll_events(handle, maxEventsRequested)

@exportc("libp2p_runtime_health_json")
fn libp2p_runtime_health_json(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        let out: str = "{\"native_ready\":true,\"host_loaded\":true,\"started\":false,\"peer_id\":\"\",\"last_error\":" + toJsonStringValue(trimText(gLastError)) + ",\"start_phase\":\"init_failed\",\"last_native_error\":" + toJsonStringValue(trimText(gLastError)) + "}"
        return dupCString(strings.CloneStr(out))
    let startedText: str = if node->started: "true" else: "false"
    let startPhase: str = if node->started: "started" else: "starting"
    var peerIdText: str = canonicalPeerIdOrEmpty(resolveNodePeerId(node))
    if len(peerIdText) <= 0:
        peerIdText = forceDeterministicPeerId(node)
        StoreLocalPeerIdAt(idx, ownText(peerIdText))
    let out: str = "{\"native_ready\":true,\"host_loaded\":true,\"started\":" + startedText + ",\"peer_id\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"last_error\":" + toJsonStringValue(trimText(gLastError)) + ",\"start_phase\":" + toJsonStringValue(strings.CloneStr(startPhase)) + ",\"last_native_error\":" + toJsonStringValue(trimText(gLastError)) + "}"
    return dupCString(strings.CloneStr(out))

