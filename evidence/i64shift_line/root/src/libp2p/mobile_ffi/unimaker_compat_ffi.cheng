@exportc("libp2p_rwad_list_market_events")
fn libp2p_rwad_list_market_events(handle: int64, limit: int32, cursorPtr: void*, partyAddressPtr: void*): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
