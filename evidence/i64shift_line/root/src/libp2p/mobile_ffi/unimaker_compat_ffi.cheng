@exportc("libp2p_join_via_seed_bootstrap_cstr")
fn libp2p_join_via_seed_bootstrap_cstr(handle: int64, peerIdPtr: void*, addressesJsonPtr: void*, sourcePtr: void*, limit: int32): cstring =
    limit
    let peerIdText: str = canonicalPeerIdOrEmpty(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("join_via_seed_bootstrap: peer id required")
        return dupCString("{\"ok\":false,\"error\":\"peer_id_required\",\"connected\":false}")
    let hintsOk: bool = libp2p_register_peer_hints(handle, peerIdPtr, addressesJsonPtr, sourcePtr)
    let connectOk: bool = libp2p_connect_peer(handle, peerIdPtr) == resultOk
    return dupCString("{\"ok\":" + (if connectOk: "true" else: "false") + ",\"connected\":" + (if connectOk: "true" else: "false") + ",\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"hintsStored\":" + (if hintsOk: "true" else: "false") + "}")

@exportc("libp2p_join_via_seed_bootstrap")
fn libp2p_join_via_seed_bootstrap(handle: int64, peerIdPtr: void*, addressesJsonPtr: void*, sourcePtr: void*, limit: int32): cstring =
    return libp2p_join_via_seed_bootstrap_cstr(handle, peerIdPtr, addressesJsonPtr, sourcePtr, limit)

