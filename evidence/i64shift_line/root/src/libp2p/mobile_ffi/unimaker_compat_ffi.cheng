@exportc("libp2p_vrf_generate_keypair")
fn libp2p_vrf_generate_keypair(): cstring =
    return dupOwnedCString(c_um_vrf_generate_keypair_json())

@exportc("libp2p_vrf_sign")
fn libp2p_vrf_sign(privateKeyHexPtr: void*, inputHexPtr: void*): cstring =
    let privateKeyHex: str = trimText(voidPtrText(privateKeyHexPtr))
    let inputHex: str = trimText(voidPtrText(inputHexPtr))
    if len(privateKeyHex) <= 0 || len(inputHex) <= 0:
        return dupCString("{\"ok\":false,\"error\":\"missing_input\"}")
    let privateKeyRaw: cstring = dupCString(strings.CloneStr(privateKeyHex))
    let inputRaw: cstring = dupCString(strings.CloneStr(inputHex))
    let signedRaw: cstring = c_um_vrf_sign_json(privateKeyRaw, inputRaw)
    c_free(privateKeyRaw)
    c_free(inputRaw)
    return dupOwnedCString(signedRaw)

@exportc("libp2p_vrf_verify")
fn libp2p_vrf_verify(publicKeyHexPtr: void*, inputHexPtr: void*, signatureHexPtr: void*): cstring =
    let publicKeyHex: str = trimText(voidPtrText(publicKeyHexPtr))
    let inputHex: str = trimText(voidPtrText(inputHexPtr))
    let signatureHex: str = trimText(voidPtrText(signatureHexPtr))
    if len(publicKeyHex) <= 0 || len(inputHex) <= 0 || len(signatureHex) <= 0:
        return dupCString("{\"ok\":false,\"error\":\"missing_input\"}")
    let publicKeyRaw: cstring = dupCString(strings.CloneStr(publicKeyHex))
    let inputRaw: cstring = dupCString(strings.CloneStr(inputHex))
    let signatureRaw: cstring = dupCString(strings.CloneStr(signatureHex))
    let verifyRaw: cstring = c_um_vrf_verify_json(publicKeyRaw, inputRaw, signatureRaw)
    c_free(publicKeyRaw)
    c_free(inputRaw)
    c_free(signatureRaw)
    return dupOwnedCString(verifyRaw)

@exportc("libp2p_string_free")
fn libp2p_string_free(value: void*) =
    if value != nil:
        c_free(value)
