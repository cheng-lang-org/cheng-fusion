@exportc("libp2p_measure_peer_bandwidth")
fn libp2p_measure_peer_bandwidth(handle: int64, peerIdPtr: void*, durationMs: int32, chunkBytes: int32): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        return dupCString("{\"ok\":false,\"error\":\"missing_peer_id\"}")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return dupCString("{\"ok\":false,\"error\":\"switch_missing\"}")
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        return dupCString("{\"ok\":false,\"error\":\"switch_ptr_missing\"}")
    if !callHostDialPeerPtr(node, peerIdText):
        return dupCString("{\"ok\":false,\"error\":\"dial_failed\"}")
    let peerIdx: int32 = ensurePeerIndexPtr(node, peerIdText)
    if peerIdx < 0:
        return dupCString("{\"ok\":false,\"error\":\"peer_not_found\"}")
    let ms: int32 = if durationMs > 0: durationMs else: 2500
    let chunk: int32 = if chunkBytes > 0: chunkBytes else: 8192
    var probePayload: Bytes = BytesAlloc(chunk)
    var fillIndex: int32
    while fillIndex < chunk:
        BytesSet(probePayload, fillIndex, (fillIndex % 251) + 1)
        fillIndex = fillIndex + 1
    let startedMs: int64 = nowMs()
    let deadlineMs: int64 = startedMs + int64(ms)
    var txBytes: int64
    var rxBytes: int64
    var sampleCount: int32
    while nowMs() < deadlineMs:
        if !um_hostPingPeerWithPayloadTextIndex(swIdx, peerIdText, probePayload):
            break
        txBytes = txBytes + int64(chunk)
        rxBytes = rxBytes + int64(chunk)
        sampleCount = sampleCount + 1
    let elapsedMsRaw: int64 = nowMs() - startedMs
    let elapsedMs: int64 = if elapsedMsRaw > 0: elapsedMsRaw else: int64(ms)
    if sampleCount <= 0:
        return dupCString("{\"ok\":false,\"error\":\"measure_failed\"}")
    let upBps: int64 = (txBytes * 1000) / elapsedMs
    let downBps: int64 = (rxBytes * 1000) / elapsedMs
    let beforeRow: str = peerRowAtPtr(node, peerIdx)
    let relayed: bool = StrContains(peerRowAddr(beforeRow), "/p2p-circuit")
    let latencyMs: int32 = int32(elapsedMs / int64(sampleCount))
    peerRecordMeasurementPtr(node, peerIdText, upBps, downBps, txBytes, rxBytes, latencyMs, relayed)
    let afterRow: str = peerRowAtPtr(node, peerIdx)
    let out: str = "{\"ok\":true,\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"durationMs\":" + $elapsedMs + ",\"chunkBytes\":" + $chunk + ",\"samples\":" + $sampleCount + ",\"measuredUplinkBps\":" + $upBps + ",\"measuredDownlinkBps\":" + $downBps + ",\"uplinkBps\":" + $upBps + ",\"downlinkBps\":" + $downBps + ",\"uplinkTotalBytes\":" + $peerRowUplinkTotalBytes(afterRow) + ",\"downlinkTotalBytes\":" + $peerRowDownlinkTotalBytes(afterRow) + ",\"totalTransferBytes\":" + $(peerRowUplinkTotalBytes(afterRow) + peerRowDownlinkTotalBytes(afterRow)) + ",\"relayBottleneckBps\":" + $peerRowRelayBottleneckBps(afterRow) + ",\"isRelayed\":" + (if peerRowRelayed(afterRow): "true" else: "false") + "}"
    emitNodeEvent(node, "bandwidth.measure", out)
    return dupCString(strings.CloneStr(out))

@exportc("libp2p_measure_peer_latency")
fn libp2p_measure_peer_latency(handle: int64, peerIdPtr: void*, sampleCount: int32, timeoutMs: int32): cstring =
    clearLastError()
    timeoutMs
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        return dupCString("{\"ok\":false,\"error\":\"missing_peer_id\"}")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return dupCString("{\"ok\":false,\"error\":\"switch_missing\"}")
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        return dupCString("{\"ok\":false,\"error\":\"switch_ptr_missing\"}")
    if !callHostDialPeerPtr(node, peerIdText):
        return dupCString("{\"ok\":false,\"error\":\"dial_failed\"}")
    let peerIdx: int32 = ensurePeerIndexPtr(node, peerIdText)
    if peerIdx < 0:
        return dupCString("{\"ok\":false,\"error\":\"peer_not_found\"}")
    let requestedSamples: int32 = if sampleCount > 0: sampleCount else: 3
    let cappedSamples: int32 = if requestedSamples > 64: 64 else: requestedSamples
    var probePayload: Bytes = BytesAlloc(1)
    BytesSet(probePayload, 0, 1)
    var samples: int32
    var totalLatencyMs: int64
    var minLatencyMs: int64 = 9223372036854775807
    var maxLatencyMs: int64
    while samples < cappedSamples:
        let startedMs: int64 = nowMs()
        if !um_hostPingPeerWithPayloadTextIndex(swIdx, peerIdText, probePayload):
            break
        let elapsedRaw: int64 = nowMs() - startedMs
        let elapsedMs: int64 = if elapsedRaw > 0: elapsedRaw else: 1
        totalLatencyMs = totalLatencyMs + elapsedMs
        if elapsedMs < minLatencyMs:
            minLatencyMs = elapsedMs
        if elapsedMs > maxLatencyMs:
            maxLatencyMs = elapsedMs
        samples = samples + 1
    if samples <= 0:
        return dupCString("{\"ok\":false,\"error\":\"measure_failed\"}")
    let avgLatencyMs: int64 = totalLatencyMs / int64(samples)
    let beforeRow: str = peerRowAtPtr(node, peerIdx)
    let relayed: bool = StrContains(peerRowAddr(beforeRow), "/p2p-circuit")
    peerRecordMeasurementPtr(node, peerIdText, peerRowMeasuredUplinkBps(beforeRow), peerRowMeasuredDownlinkBps(beforeRow), 0, 0, int32(avgLatencyMs), relayed)
    let out: str = joinText([
        "{\"ok\":true,\"peerId\":", toJsonStringValue(strings.CloneStr(peerIdText)),
        ",\"samples\":", Int64ToStr(int64(samples)),
        ",\"latencyMs\":", Int64ToStr(avgLatencyMs),
        ",\"avgLatencyMs\":", Int64ToStr(avgLatencyMs),
        ",\"minLatencyMs\":", Int64ToStr(minLatencyMs),
        ",\"maxLatencyMs\":", Int64ToStr(maxLatencyMs),
        "}"
    ])
    emitNodeEvent(node, "latency.measure", out)
    return dupCString(strings.CloneStr(out))

const
    base64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn bytesToBase64Text(data: Bytes): str =
    let total: int32 = BytesLen(data)
    if total <= 0:
        return ""
    var out: str
    var i: int32
    while i < total:
        let b0: int32 = BytesGet(data, i)
        let hasB1: bool = i + 1 < total
        let hasB2: bool = i + 2 < total
        let b1: int32 = if hasB1: BytesGet(data, i + 1) else: 0
        let b2: int32 = if hasB2: BytesGet(data, i + 2) else: 0
        let c0: int32 = (b0 / 4) % 64
        let c1: int32 = ((b0 % 4) * 16 + (b1 / 16)) % 64
        let c2: int32 = ((b1 % 16) * 4 + (b2 / 64)) % 64
        let c3: int32 = b2 % 64
        out = out + charToStr(base64Alphabet[c0])
        out = out + charToStr(base64Alphabet[c1])
        if hasB1:
            out = out + charToStr(base64Alphabet[c2])
        else:
            out = out + "="
        if hasB2:
            out = out + charToStr(base64Alphabet[c3])
        else:
            out = out + "="
        i = i + 3
    return out

fn libp2pFetchFileProvidersNode(node: var NodeRuntime, keyPtr: cstring, limit: int32): cstring =
    if !node.used:
        setLastError("fetch_file_providers: node_not_initialized")
        return dupCString("{\"providers\":[],\"count\":0}")
    let keyText: str = trimText(system.strFromCStringCopy(keyPtr))
    if len(keyText) <= 0:
        return dupCString("{\"providers\":[],\"count\":0}")
    var maxProviders: int32 = 16
    if limit > 0:
        maxProviders = limit
    syncPeerstoreIntoNode(node, sourceConnected | sourceWan | sourceLan | sourceMdns | sourceDht | sourceRendezvous)
    let total: int32 = safePeerCount(node)
    var out: str = "{\"providers\":["
    var i: int32
    var emitted: int32
    while i < total:
        if emitted >= maxProviders:
            break
        let row: str = peerRowAt(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && len(peerIdText) > 0:
            if emitted > 0:
                out = joinText([out, ","])
            out = joinText([out, toJsonStringValue(strings.CloneStr(peerIdText))])
            emitted = emitted + 1
        i = i + 1
    out = joinText([out, "],\"count\":", Int64ToStr(int64(emitted)), "}"])
    return dupCString(strings.CloneStr(out))

@exportc("libp2p_fetch_file_providers")
fn libp2p_fetch_file_providers(handle: int64, keyPtr: cstring, limit: int32): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx == 0:
        return libp2pFetchFileProvidersNode(gNode0, keyPtr, limit)
    if idx == 1:
        return libp2pFetchFileProvidersNode(gNode1, keyPtr, limit)
    if idx == 2:
        return libp2pFetchFileProvidersNode(gNode2, keyPtr, limit)
    if idx == 3:
        return libp2pFetchFileProvidersNode(gNode3, keyPtr, limit)
    if idx == 4:
        return libp2pFetchFileProvidersNode(gNode4, keyPtr, limit)
    if idx == 5:
        return libp2pFetchFileProvidersNode(gNode5, keyPtr, limit)
    if idx == 6:
        return libp2pFetchFileProvidersNode(gNode6, keyPtr, limit)
    if idx == 7:
        return libp2pFetchFileProvidersNode(gNode7, keyPtr, limit)
    setLastError("fetch_file_providers: node_not_initialized")
    return dupCString("{\"providers\":[],\"count\":0}")

@exportc("libp2p_register_local_file")
fn libp2p_register_local_file(handle: int64, keyPtr: void*, pathPtr: void*, metaJsonPtr: void*): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("register_local_file: node_not_initialized")
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let keyText: str = trimText(voidPtrText(keyPtr))
    let pathText: str = normalizeFsPath(trimText(voidPtrText(pathPtr)))
    if len(keyText) <= 0:
        setLastError("register_local_file: missing_key")
        return dupCString("{\"ok\":false,\"error\":\"missing_key\"}")
    if len(pathText) <= 0 || !fileExists(pathText):
        setLastError("register_local_file: file_missing")
        return dupCString("{\"ok\":false,\"error\":\"file_missing\"}")
    let metaJson: str = normalizeJsonPayload(voidPtrText(metaJsonPtr))
    let fileNameText: str = trimText(parseConfigQuotedValue(metaJson, "fileName"))
    let mimeTypeText: str = trimText(parseConfigQuotedValue(metaJson, "mimeType"))
    let sha256Text: str = trimText(parseConfigQuotedValue(metaJson, "sha256"))
    let sizeText: str = trimText(parseConfigQuotedValue(metaJson, "sizeBytes"))
    var sizeRaw: int64
    if len(sizeText) > 0:
        sizeRaw = parseFirstInt64(sizeText)
    var sizeBytes: int64 = fileSizeBytes(pathText)
    if sizeRaw > 0:
        sizeBytes = sizeRaw
    if !registerSharedFilePtr(node, keyText, pathText, fileNameText, mimeTypeText, sha256Text, sizeBytes):
        setLastError("register_local_file: register_failed")
        return dupCString("{\"ok\":false,\"error\":\"register_failed\"}")
    registerSharedFileProviderPtr(node, keyText)
    let out: str = "{\"ok\":true,\"key\":" + toJsonStringValue(strings.CloneStr(keyText)) +
        ",\"path\":" + toJsonStringValue(strings.CloneStr(pathText)) +
        ",\"sizeBytes\":" + $sizeBytes +
        ",\"fileName\":" + toJsonStringValue(if len(fileNameText) > 0: fileNameText else: baseName(pathText)) +
        ",\"mimeType\":" + toJsonStringValue(strings.CloneStr(mimeTypeText)) + "}"
    emitNodeEvent(&node, "file.register", out)
    return dupCString(strings.CloneStr(out))

fn registerLocalFileWireNode(node: var NodeRuntime, requestJsonPtr: cstring): cstring =
    if !node.used:
        setLastError("register_local_file: node_not_initialized")
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let requestText: str = normalizeJsonPayload(system.strFromCStringCopy(requestJsonPtr))
    let keyText: str = trimText(parseConfigQuotedValue(requestText, "key"))
    let pathText: str = normalizeFsPath(trimText(parseConfigQuotedValue(requestText, "path")))
    if len(keyText) <= 0:
        setLastError("register_local_file: missing_key")
        return dupCString("{\"ok\":false,\"error\":\"missing_key\"}")
    if len(pathText) <= 0 || !fileExists(pathText):
        setLastError("register_local_file: file_missing")
        return dupCString("{\"ok\":false,\"error\":\"file_missing\"}")
    let fileNameText: str = trimText(parseConfigQuotedValue(requestText, "fileName"))
    let mimeTypeText: str = trimText(parseConfigQuotedValue(requestText, "mimeType"))
    let sha256Text: str = trimText(parseConfigQuotedValue(requestText, "sha256"))
    let sizeText: str = trimText(parseConfigQuotedValue(requestText, "sizeBytes"))
    var sizeRaw: int64
    if len(sizeText) > 0:
        sizeRaw = parseFirstInt64(sizeText)
    var sizeBytes: int64 = fileSizeBytes(pathText)
    if sizeRaw > 0:
        sizeBytes = sizeRaw
    if !registerSharedFile(node, keyText, pathText, fileNameText, mimeTypeText, sha256Text, sizeBytes):
        setLastError("register_local_file: register_failed")
        return dupCString("{\"ok\":false,\"error\":\"register_failed\"}")
    registerSharedFileProvider(node, keyText)
    var resolvedFileName: str = fileNameText
    if len(resolvedFileName) <= 0:
        resolvedFileName = baseName(pathText)
    let out: str = joinText([
        "{\"ok\":true,\"key\":", toJsonStringValue(strings.CloneStr(keyText)),
        ",\"path\":", toJsonStringValue(strings.CloneStr(pathText)),
        ",\"sizeBytes\":", Int64ToStr(sizeBytes),
        ",\"fileName\":", toJsonStringValue(strings.CloneStr(resolvedFileName)),
        ",\"mimeType\":", toJsonStringValue(strings.CloneStr(mimeTypeText)),
        "}"
    ])
    emitNodeEvent(node, "file.register", out)
    return dupCString(strings.CloneStr(out))

@exportc("libp2p_register_local_file_wire")
fn libp2p_register_local_file_wire(handle: int64, requestJsonPtr: cstring): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx == 0:
        return registerLocalFileWireNode(gNode0, requestJsonPtr)
    if idx == 1:
        return registerLocalFileWireNode(gNode1, requestJsonPtr)
    if idx == 2:
        return registerLocalFileWireNode(gNode2, requestJsonPtr)
    if idx == 3:
        return registerLocalFileWireNode(gNode3, requestJsonPtr)
    if idx == 4:
        return registerLocalFileWireNode(gNode4, requestJsonPtr)
    if idx == 5:
        return registerLocalFileWireNode(gNode5, requestJsonPtr)
    if idx == 6:
        return registerLocalFileWireNode(gNode6, requestJsonPtr)
    if idx == 7:
        return registerLocalFileWireNode(gNode7, requestJsonPtr)
    setLastError("register_local_file: node_not_initialized")
    return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")

@borrows
fn fileChunkFailReason(errorMessage: str): str =
    if len(errorMessage) > 0:
        return strings.CloneStr(errorMessage)
    return strings.CloneStr("request_failed")

fn fileChunkEofText(flag: bool): str =
    if flag:
        return strings.CloneStr("true")
    return strings.CloneStr("false")

@borrows
fn fileChunkIntFieldText(raw: str): str =
    if len(raw) <= 0:
        return strings.CloneStr("0")
    return $parseFirstInt64(raw)

fn fileChunkDialErrorText(): str =
    let existing: str = cloneLastErrorText()
    if len(existing) <= 0:
        return strings.CloneStr("request_file_chunk: dial_failed")
    return "request_file_chunk: " + strings.CloneStr(existing)

@exportc("libp2p_request_file_chunk")
fn libp2p_request_file_chunk(handle: int64, peerIdPtr: void*, requestJsonPtr: void*, maxBytes: int32): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("request_file_chunk: node_not_initialized")
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    node->lastChunkSize = 0
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("request_file_chunk: missing_peer_id")
        return dupCString("{\"ok\":false,\"error\":\"missing_peer_id\"}")
    let payloadText: str = normalizeJsonPayload(voidPtrText(requestJsonPtr))
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        setLastError("request_file_chunk: switch_missing")
        return dupCString("{\"ok\":false,\"error\":\"switch_missing\"}")
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        setLastError("request_file_chunk: switch_ptr_missing")
        return dupCString("{\"ok\":false,\"error\":\"switch_ptr_missing\"}")
    if !callHostDialPeerPtr(node, peerIdText):
        setLastError(fileChunkDialErrorText())
        return dupCString("{\"ok\":false,\"error\":\"dial_failed\"}")
    let nowTs: int64 = nowMs()
    let requestId: int64 = if nowTs > 0: nowTs else: nextSeq()
    let requestText: str = "{\"kind\":\"file_chunk\",\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"request\":" + strings.CloneStr(payloadText) + "}"
    var requestPayload: Bytes
    let payloadN: int32 = len(payloadText)
    if payloadN > 0:
        let allocated: Bytes = BytesAlloc(payloadN)
        BytesCopyInto(allocated, 0, BytesFromString(payloadText))
        requestPayload = allocated
    let request: DmEnvelope = DmEnvelope(
        id: requestId,
        kind: dmRequestKind,
        text: requestText,
        payload: requestPayload,
        ok: true,
        errorMessage: "",
        timestampMs: nowTs
    )
    let responseRes: Result[DmEnvelope] = um_hostDmEnvelopeRequestTextIndex(swIdx, peerIdText, request)
    if IsErr(responseRes):
        let reason: str = strings.CloneStr(Error(responseRes))
        if len(reason) > 0:
            setLastError("request_file_chunk: " + strings.CloneStr(reason))
            return dupCString("{\"ok\":false,\"error\":" + toJsonStringValue(strings.CloneStr(reason)) + "}")
        setLastError("request_file_chunk: request_failed")
        return dupCString("{\"ok\":false,\"error\":\"request_failed\"}")
    let response: DmEnvelope = Value(responseRes)
    if !response.ok:
        let reason: str = fileChunkFailReason(response.errorMessage)
        setLastError("request_file_chunk: " + strings.CloneStr(reason))
        return dupCString("{\"ok\":false,\"error\":" + toJsonStringValue(strings.CloneStr(reason)) + ",\"meta\":" + normalizeJsonPayload(response.text) + "}")
    var chunkBytes: Bytes = response.payload
    if maxBytes > 0 && BytesLen(chunkBytes) > maxBytes:
        chunkBytes = BytesSlice(chunkBytes, 0, maxBytes)
    let chunkSize: int32 = BytesLen(chunkBytes)
    node->lastChunkSize = chunkSize
    if chunkSize <= 0:
        return dupCString("{\"ok\":false,\"chunkSize\":0,\"error\":\"chunk_not_available\"}")
    let payloadBase64: str = bytesToBase64Text(chunkBytes)
    if len(payloadBase64) <= 0:
        setLastError("request_file_chunk: base64_encode_failed")
        return dupCString("{\"ok\":false,\"chunkSize\":" + $chunkSize + ",\"error\":\"base64_encode_failed\"}")
    let responseMeta: str = normalizeJsonPayload(response.text)
    let keyText: str = trimText(parseConfigQuotedValue(responseMeta, "key"))
    let fileNameText: str = trimText(parseConfigQuotedValue(responseMeta, "fileName"))
    let mimeTypeText: str = trimText(parseConfigQuotedValue(responseMeta, "mimeType"))
    let sha256Text: str = trimText(parseConfigQuotedValue(responseMeta, "sha256"))
    let eofText: str = fileChunkEofText(boolFromText(parseConfigQuotedValue(responseMeta, "eof"), false))
    let offsetText: str = fileChunkIntFieldText(parseConfigQuotedValue(responseMeta, "offset"))
    let totalSizeText: str = fileChunkIntFieldText(parseConfigQuotedValue(responseMeta, "totalSize"))
    emitNodeEvent(node, "file.chunk", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"key\":" + toJsonStringValue(strings.CloneStr(keyText)) + ",\"chunkSize\":" + $chunkSize + "}")
    return dupCString(
        "{\"ok\":true,\"payloadBase64\":" + toJsonStringValue(strings.CloneStr(payloadBase64)) +
        ",\"chunkSize\":" + $chunkSize +
        ",\"key\":" + toJsonStringValue(strings.CloneStr(keyText)) +
        ",\"fileName\":" + toJsonStringValue(strings.CloneStr(fileNameText)) +
        ",\"mimeType\":" + toJsonStringValue(strings.CloneStr(mimeTypeText)) +
        ",\"sha256\":" + toJsonStringValue(strings.CloneStr(sha256Text)) +
        ",\"offset\":" + strings.CloneStr(offsetText) +
        ",\"totalSize\":" + strings.CloneStr(totalSizeText) +
        ",\"eof\":" + strings.CloneStr(eofText) +
        ",\"meta\":" + strings.CloneStr(responseMeta) + "}"
    )

fn closeRemoteMoqConn(conn: var qconn.Connection) =
    qconn.QuicConnClose(conn)

fn tryDialRemoteMoq(candidateAddr: str,
                    outConn: var qconn.Connection,
                    outErrorKind: var str,
                    outErrorText: var str): bool =
    let addrRes: Result[qaddr.MultiAddress] = qaddr.QuicParseMultiAddress(candidateAddr)
    if IsErr(addrRes):
        outErrorKind = "invalid_native_quic_multiaddr"
        outErrorText = ErrorText(addrRes)
        return false
    if !qtransport.MsQuicAndroidDialConnectionInto(outConn, Value(addrRes), outErrorText):
        outErrorKind = "native_quic_moq_dial_failed"
        return false
    return true

fn openRemoteMoqStreamNode(node: var NodeRuntime,
                           requestedPeerId: str,
                           candidateAddr: str,
                           keyText: str,
                           streamKeyText: str,
                           offsetBytes: int64,
                           lengthBytes: int64,
                           expectedBytes: int64,
                           peerWasConnected: bool): cstring =
    keyText
    streamKeyText
    offsetBytes
    lengthBytes
    expectedBytes
    setLastError("moq_stream_open: native_quic_moq_stream_handle_table_not_ready")
    return dupCString(nativeMoqStreamRequiredStateJson(
        "native_quic_moq_stream_handle_table_not_ready",
        requestedPeerId,
        candidateAddr,
        peerWasConnected,
        false,
        "native_quic_moq_stream_handle_table_not_ready"
    ))

fn moqStreamOpenNode(node: var NodeRuntime, requestJsonPtr: cstring): cstring =
    if !node.used || !node.started:
        setLastError("moq_stream_open: node_not_initialized")
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let requestText: str = trimText(system.strFromCStringCopy(requestJsonPtr))
    let transportText: str = trimText(parseConfigQuotedValue(requestText, "transport"))
    if transportText != nativeMoqStreamTransport:
        setLastError("moq_stream_open: invalid_transport")
        return dupCString(moqStreamErrorJson("invalid_transport"))
    var keyText: str = trimText(parseConfigQuotedValue(requestText, "key"))
    if len(keyText) <= 0:
        keyText = trimText(parseConfigQuotedValue(requestText, "streamKey"))
    if len(keyText) <= 0:
        setLastError("moq_stream_open: missing_key")
        return dupCString(moqStreamErrorJson("missing_key"))
    var streamKeyText: str = trimText(parseConfigQuotedValue(requestText, "streamKey"))
    if len(streamKeyText) <= 0:
        streamKeyText = keyText
    let requestedPeerId: str = canonicalPeerIdOrEmpty(parseConfigQuotedValue(requestText, "peerId"))
    if len(requestedPeerId) <= 0:
        setLastError("moq_stream_open: missing_peer")
        return dupCString(moqStreamErrorJson("missing_peer"))
    let expectedRaw: str = trimText(parseConfigQuotedValue(requestText, "expectedBytes"))
    var requestedExpectedBytes: int64
    if len(expectedRaw) > 0:
        requestedExpectedBytes = parseFirstInt64(expectedRaw)
    let offsetBytes: int64 = parseFirstInt64(parseConfigQuotedValue(requestText, "offset"))
    let lengthBytes: int64 = parseFirstInt64(parseConfigQuotedValue(requestText, "length"))
    var localPeerIdText: str = canonicalPeerIdOrEmpty(node.localPeerId)
    if len(localPeerIdText) <= 0 && node.switchIndex >= 0:
        localPeerIdText = canonicalPeerIdOrEmpty(um_hostPeerIdTextIndex(node.switchIndex))
    if len(localPeerIdText) > 0:
        node.localPeerId = ownText(localPeerIdText)
    if requestedPeerId != localPeerIdText:
        var peerSlot: int32 = -1
        let peerTotal: int32 = safePeerCount(node)
        var peerScan: int32
        while peerScan < peerTotal:
            let row: str = peerRowAt(node, peerScan)
            if peerRowUsed(row) && peerRowPeerId(row) == requestedPeerId:
                peerSlot = peerScan
                break
            peerScan = peerScan + 1
        if peerSlot < 0:
            setLastError("moq_stream_open: native_quic_moq_stream_required: peer_not_found")
            return dupCString(nativeMoqStreamRequiredReasonJson("peer_not_found", requestedPeerId, ""))
        let candidateAddr: str = primaryAddressForPeer(node, requestedPeerId)
        if len(candidateAddr) <= 0 || indexOf(candidateAddr, "/quic", 0) < 0:
            setLastError("moq_stream_open: native_quic_moq_stream_required: missing_native_quic_multiaddr")
            return dupCString(nativeMoqStreamRequiredReasonJson("missing_native_quic_multiaddr", requestedPeerId, candidateAddr))
        let peerWasConnected: bool = peerRowConnected(peerRowAt(node, peerSlot))
        if !peerWasConnected:
            emitNodeEvent(&node, "moq.native_quic.dial_requested", joinText([
                "{\"peerId\":",
                toJsonStringValue(strings.CloneStr(requestedPeerId)),
                ",\"candidateAddr\":",
                toJsonStringValue(strings.CloneStr(candidateAddr)),
                "}"
            ]))
        return openRemoteMoqStreamNode(
            node,
            requestedPeerId,
            candidateAddr,
            keyText,
            streamKeyText,
            offsetBytes,
            lengthBytes,
            requestedExpectedBytes,
            peerWasConnected
        )
    setLastError("moq_stream_open: native_quic_moq_stream_handle_table_not_ready")
    return dupCString(moqStreamErrorJson("native_quic_moq_stream_handle_table_not_ready"))

@exportc("libp2p_moq_stream_open")
fn libp2p_moq_stream_open(handle: int64, requestJsonPtr: cstring): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx == 0:
        return moqStreamOpenNode(gNode0, requestJsonPtr)
    if idx == 1:
        return moqStreamOpenNode(gNode1, requestJsonPtr)
    if idx == 2:
        return moqStreamOpenNode(gNode2, requestJsonPtr)
    if idx == 3:
        return moqStreamOpenNode(gNode3, requestJsonPtr)
    if idx == 4:
        return moqStreamOpenNode(gNode4, requestJsonPtr)
    if idx == 5:
        return moqStreamOpenNode(gNode5, requestJsonPtr)
    if idx == 6:
        return moqStreamOpenNode(gNode6, requestJsonPtr)
    if idx == 7:
        return moqStreamOpenNode(gNode7, requestJsonPtr)
    setLastError("moq_stream_open: node_not_initialized")
    return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")

