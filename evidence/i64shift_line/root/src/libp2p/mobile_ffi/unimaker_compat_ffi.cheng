@exportc("social_groups_send")
fn social_groups_send(handle: int64, groupIdPtr: void*, messageJsonPtr: void*): bool =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return false
    let groupId: str = trimText(voidPtrText(groupIdPtr))
    let messageJson: str = trimText(voidPtrText(messageJsonPtr))
    let payload: str = "{\"type\":\"group.message\",\"groupId\":" + toJsonStringValue(strings.CloneStr(groupId)) + ",\"message\":" + normalizeJsonPayload(messageJson) + "}"
    let payloadPtr: cstring = dupCString(strings.CloneStr(payload))
    let groupFeedOk: bool = libp2p_feed_publish_entry(handle, void*(payloadPtr))
    c_free(payloadPtr)
    if !groupFeedOk:
        return false
    let topicText: str = "group/" + groupId
    let topicTextPtr: cstring = dupCString(strings.CloneStr(topicText))
    let payloadTextPtr: cstring = dupCString(strings.CloneStr(payload))
    let publishRc: int32 = libp2p_pubsub_publish(handle, void*(topicTextPtr), void*(payloadTextPtr), len(payload), nil)
    c_free(topicTextPtr)
    c_free(payloadTextPtr)
    if publishRc != resultOk:
        return false
    emitSocialEvent(node, "groups", "send", JsonOrEmptyObject(messageJson), "", groupId, "")
    return true

