    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"peers\":[],\"totalCount\":0}")
    let filterText: str = trimText(voidPtrText(sourceFilterPtr))
    syncPeerstoreIntoNodePtr(node, sourceConnected | sourceWan | sourceLan | sourceMdns | sourceDht | sourceRendezvous)
    return dupCString(listDiscoveredPeersJsonPtr(node, filterText, limit))

@exportc("libp2p_network_discovery_snapshot")
fn libp2p_network_discovery_snapshot(handle: int64, sourceFilterPtr: void*, limit: int32, connectCap: int32): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\",\"peerId\":\"\",\"connectedPeers\":[],\"connectedPeersInfo\":[],\"discoveredPeers\":{\"peers\":[],\"totalCount\":0},\"mdnsDebug\":{},\"autoConnect\":{\"attempted\":0,\"connected\":0},\"mdnsProbeOk\":false,\"bootstrap\":{\"ok\":false}}")

    let filterText: str = trimText(voidPtrText(sourceFilterPtr))
    let safeConnectCap: int32 =
        if connectCap <= 0:
            7
        elif connectCap > 32:
            32
        else:
            connectCap

    filterText
    limit
    safeConnectCap
    var mdnsProbeOk: bool = node->mdnsEnabled
    let bootstrapText: str = "{\"ok\":false}"
    let discoveredText: str = "{\"peers\":[],\"totalCount\":0}"
    let connectedPeersText: str = "[]"
    let connectedInfoText: str = "[]"
    var mdnsDebugText: str
    if node->mdnsEnabled:
        mdnsDebugText = "{}"
    else:
        mdnsDebugText = "{\"enabled\":false,\"intervalSec\":0,\"service\":\"\",\"namespace\":\"\",\"preferredIpv4\":\"\",\"peerCount\":0,\"peers\":[]}"
    var attempted: int32
    var connected: int32
    var mdnsProbeOkText: str
    if mdnsProbeOk:
        mdnsProbeOkText = "true"
    else:
        mdnsProbeOkText = "false"
    let snapshotPeerId: str = ""
    let lastErrorText: str = cloneLastErrorText()
    var out: str
    out = "{"
    out = out + "\"ok\":true"
    out = out + ",\"peerId\":" + toJsonStringValue(strings.CloneStr(snapshotPeerId))
    out = out + ",\"connectedPeers\":" + connectedPeersText
    out = out + ",\"connectedPeersInfo\":" + connectedInfoText
    out = out + ",\"discoveredPeers\":" + discoveredText
    out = out + ",\"mdnsDebug\":" + mdnsDebugText
    out = out + ",\"autoConnect\":{\"attempted\":" + $attempted + ",\"connected\":" + $connected + "}"
    out = out + ",\"mdnsProbeOk\":" + mdnsProbeOkText
    out = out + ",\"bootstrap\":" + normalizeJsonPayload(bootstrapText)
    out = out + ",\"lastError\":" + toJsonStringValue(strings.CloneStr(lastErrorText))
    out = out + "}"
    return dupCString(strings.CloneStr(out))

@exportc("social_connect_peer")
fn social_connect_peer(handle: int64, peerIdPtr: void*, multiaddrPtr: void*): bool =
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    let multiaddrText: str = trimText(voidPtrText(multiaddrPtr))
    var ok: bool
    if len(multiaddrText) > 0:
        let multiaddrTextPtr: cstring = dupCString(strings.CloneStr(multiaddrText))
        ok = libp2p_connect_multiaddr(handle, void*(multiaddrTextPtr)) == resultOk
        c_free(multiaddrTextPtr)
    if !ok:
        let peerIdTextPtr: cstring = dupCString(strings.CloneStr(peerIdText))
        ok = libp2p_connect_peer(handle, void*(peerIdTextPtr)) == resultOk
        c_free(peerIdTextPtr)
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx >= 0 && node->used:
        emitSocialEvent(node, "discovery", "connect_peer", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"multiaddr\":" + toJsonStringValue(strings.CloneStr(multiaddrText)) + ",\"ok\":" + (if ok: "true" else: "false") + "}", "", "", "")
    return ok

@exportc("social_dm_send")
fn social_dm_send(handle: int64, peerIdPtr: void*, conversationIdPtr: void*, messageJsonPtr: void*): bool =
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    let conversationId: str = trimText(voidPtrText(conversationIdPtr))
    let messageJson: str = trimText(voidPtrText(messageJsonPtr))
    let peerIdTextPtr: cstring = dupCString(strings.CloneStr(peerIdText))
    let messageJsonTextPtr: cstring = dupCString(strings.CloneStr(messageJson))
    let ok: bool = libp2p_send_with_ack(handle, void*(peerIdTextPtr), void*(messageJsonTextPtr), 8000)
    c_free(peerIdTextPtr)
    c_free(messageJsonTextPtr)
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx >= 0 && node->used:
        emitSocialEvent(node, "dm", "send", JsonOrEmptyObject(messageJson), DmConversationKey(conversationId, peerIdText), "", "")
    return ok

@exportc("social_dm_edit")
fn social_dm_edit(handle: int64, peerIdPtr: void*, conversationIdPtr: void*, messageIdPtr: void*, patchJsonPtr: void*): bool =
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
