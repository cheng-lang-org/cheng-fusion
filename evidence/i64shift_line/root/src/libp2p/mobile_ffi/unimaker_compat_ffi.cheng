    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let safeLimit: int32 =
        if limit > 0:
            limit
        else:
            50
    let cursor: str = trimText(voidPtrText(cursorPtr))
    let partyAddress: str = trimText(voidPtrText(partyAddressPtr))
    var paramsJson: str = "{\"limit\":" + $safeLimit
    if len(cursor) > 0:
        paramsJson = paramsJson + ",\"cursor\":" + toJsonStringValue(strings.CloneStr(cursor))
    if len(partyAddress) > 0:
        paramsJson = paramsJson + ",\"partyAddress\":" + toJsonStringValue(strings.CloneStr(partyAddress))
    paramsJson = paramsJson + "}"
    let response: str = rwadRpcRequestPtr(node, handle, "list_market_events", paramsJson)
    return dupCString(strings.CloneStr(response))

@borrows
fn JsonOrEmptyObject(text: str): str =
    if len(text) > 0:
        return strings.CloneStr(text)
    return "{}"

@borrows
fn JsonOrEmptyArray(text: str): str =
    if len(text) > 0:
        return strings.CloneStr(text)
    return "[]"

@borrows
fn VisibleLocationFieldJson(postJson: str): str =
    let postParsed: json.JsonParseResult = json.ParseJsonSafe(postJson)
    if postParsed.success && postParsed.value.kind == json.JObject:
        var locationHint: str
        if json.JsonTryGetStr(postParsed.value, "locationHint", locationHint):
            let visibleLocationAddress: str = trimText(locationHint)
            if len(visibleLocationAddress) > 0:
                return ",\"visibleLocationAddress\":" + toJsonStringValue(strings.CloneStr(visibleLocationAddress))
    return ""

@borrows
fn socialSendEnvelope(handle: int64, peerIdText: str, eventType: str, payloadJson: str): bool =
    if len(peerIdText) <= 0:
        return false
    let envelope: str = "{\"kind\":\"social\",\"entity\":" + toJsonStringValue(strings.CloneStr(eventType)) + ",\"payload\":" + normalizeJsonPayload(payloadJson) + ",\"timestampMs\":" + $nowMs() + "}"
    let peerIdPtr: cstring = dupCString(strings.CloneStr(peerIdText))
    let envelopePtr: cstring = dupCString(strings.CloneStr(envelope))
    let ok: bool = libp2p_send_with_ack(handle, void*(peerIdPtr), void*(envelopePtr), 6000)
    c_free(peerIdPtr)
    c_free(envelopePtr)
    return ok

