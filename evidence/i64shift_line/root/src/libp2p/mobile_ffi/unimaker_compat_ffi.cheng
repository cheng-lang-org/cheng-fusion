@exportc("libp2p_pubsub_publish")
fn libp2p_pubsub_publish(handle: int64, topicPtr: void*, payloadPtr: void*, payloadLen: int64, deliveredOut: int64*): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("pubsub_publish: invalid handle")
        return resultError
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        setLastError("pubsub_publish: switch missing")
        return resultError
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        setLastError("pubsub_publish: switch ptr missing")
        return resultError
    let topicText: str = trimText(voidPtrText(topicPtr))
    if len(topicText) <= 0:
        setLastError("pubsub_publish: missing topic")
        return resultError
    if payloadPtr == nil || payloadLen <= 0:
        setLastError("pubsub_publish: empty payload")
        return resultError
    let payloadText: str = voidPtrText(payloadPtr)
    let payload: Bytes = BytesFromString(payloadText)
    let connectedBefore: int32 = countConnectedPeersPtr(node)
    if connectedBefore <= 0:
        if deliveredOut != nil:
            *deliveredOut = 0
        setLastError("pubsub_publish: no connected peers")
        return resultError
    if !um_hostGossipsubPublishIndex(swIdx, topicText, payload):
        if deliveredOut != nil:
            *deliveredOut = 0
        setLastError("pubsub_publish: backend publish failed")
        return resultError
    if deliveredOut != nil:
        *deliveredOut = int64(connectedBefore)
    emitNodeEvent(node, "pubsub.publish", "{\"topic\":" + toJsonStringValue(strings.CloneStr(topicText)) + ",\"size\":" + $payloadLen + ",\"delivered\":" + $connectedBefore + "}")
    return resultOk

@exportc("libp2p_pubsub_subscribe")
fn libp2p_pubsub_subscribe(handle: int64, topicPtr: void*, callback: void*, userData: void*): void* =
    clearLastError()
    callback
    userData
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("pubsub_subscribe: invalid handle")
        return nil
    let topicText: str = trimText(voidPtrText(topicPtr))
    if len(topicText) <= 0:
        setLastError("pubsub_subscribe: missing topic")
        return nil
    if idx > 0:
        return void*(dupCString(strings.CloneStr(topicText)))
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        setLastError("pubsub_subscribe: switch missing")
        return nil
    if !um_hostGossipsubSubscribe(strings.CloneStr(topicText)):
        setLastError("pubsub_subscribe: backend subscribe failed")
        return nil
    emitNodeEvent(node, "pubsub.subscribe", "{\"topic\":" + toJsonStringValue(strings.CloneStr(topicText)) + "}")
    let topicHandle: cstring = dupCString(strings.CloneStr(topicText))
    if topicHandle == nil:
        setLastError("pubsub_subscribe: alloc topic handle failed")
        return nil
    return void*(topicHandle)

@exportc("libp2p_pubsub_unsubscribe")
fn libp2p_pubsub_unsubscribe(handle: int64, subscription: void*): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("pubsub_unsubscribe: invalid handle")
        return resultError
    if subscription == nil:
        setLastError("pubsub_unsubscribe: missing subscription")
        return resultError
    var subBoxed: void* = subscription
    let topicPtrRaw: cstring = cstring(subBoxed)
    let topicText: str = trimText(system.strFromCStringCopy(topicPtrRaw))
    if idx > 0:
        c_free(topicPtrRaw)
        return resultOk
    if !um_hostGossipsubUnsubscribe(topicText):
        c_free(topicPtrRaw)
        setLastError("pubsub_unsubscribe: backend unsubscribe failed")
        return resultError
    c_free(topicPtrRaw)
    emitNodeEvent(node, "pubsub.unsubscribe", "{\"topic\":" + toJsonStringValue(strings.CloneStr(topicText)) + "}")
    return resultOk

fn sendDmEnvelope(node: var NodeRuntime, peerIdText: str, kind: int32, textPayload: str, binaryPayload: Bytes, ackExpected: bool, timeoutMs: int32): bool =
    timeoutMs
    kind
    ackExpected
    let swIdx: int32 = nodeSwitchIndex(node)
    if swIdx < 0:
        node.lastDirectError = "switch missing"
        setLastError("direct_send: " + node.lastDirectError)
        return false
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        node.lastDirectError = "switch ptr missing"
        setLastError("direct_send: " + node.lastDirectError)
        return false
    if !callHostDialPeer(node, strings.CloneStr(peerIdText)):
        node.lastDirectError = strings.CloneStr(gLastError)
        setLastError("direct_send: " + node.lastDirectError)
        return false
    var probePayload: Bytes = BytesAlloc(1)
    BytesSet(probePayload, 0, 1)
    if !um_hostPingPeerWithPayloadTextIndex(swIdx, strings.CloneStr(peerIdText), probePayload):
        let target: str = canonicalPeerIdOrEmpty(strings.CloneStr(peerIdText))
        var peerSeen: bool
        let peerTotal: int32 = safePeerCount(node)
        var peerScan: int32
        while peerScan < peerTotal:
            let row: str = peerRowAt(node, peerScan)
            if peerRowUsed(row) && peerRowPeerId(row) == target:
                peerSeen = true
                break
            peerScan = peerScan + 1
        if !peerSeen:
            node.lastDirectError = "dm ping failed"
            setLastError("direct_send: " + node.lastDirectError)
            return false
        setPeerConnected(node, peerIdText, true)
    let peerIdx: int32 = ensurePeerIndex(node, peerIdText)
    if peerIdx >= 0:
        let transferBytes: int64 = int64(BytesLen(probePayload))
        if transferBytes > 0:
            peerRecordTransfer(node, peerIdText, transferBytes, transferBytes)
        else:
            setPeerConnected(node, peerIdText, true)
    node.lastDirectError = ""
    return true

@exportc("libp2p_send_direct_text")
fn libp2p_send_direct_text(handle: int64, peerIdPtr: void*, messageIdPtr: void*, textPtr: void*, replyToPtr: void*, requestAck: bool, timeoutMs: int32): bool =
    clearLastError()
    replyToPtr
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("send_direct_text: invalid handle")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        return failWith("send_direct_text: missing peerId")
    let messageId: str = trimText(voidPtrText(messageIdPtr))
    let textPayload: str = trimText(voidPtrText(textPtr))
    if len(textPayload) <= 0:
        return failWith("send_direct_text: empty payload")
    let payload: str = "{\"type\":\"text\",\"messageId\":" + toJsonStringValue(strings.CloneStr(messageId)) + ",\"text\":" + toJsonStringValue(strings.CloneStr(textPayload)) + ",\"timestampMs\":" + $nowMs() + "}"
    let ok: bool = sendDmEnvelopePtr(node, peerIdText, dmRequestKind, payload, emptyPayload(), requestAck, timeoutMs)
    if ok:
        setPeerConnectedPtr(node, peerIdText, true)
        emitNodeEvent(node, "dm.send", payload)
    return ok

@exportc("libp2p_send_chat_control")
fn libp2p_send_chat_control(handle: int64, peerIdPtr: void*, opPtr: void*, messageIdPtr: void*, bodyPtr: void*, targetPtr: void*, requestAck: bool, timeoutMs: int32): bool =
    clearLastError()
