@exportc("social_publish_subscribe_cstr")
fn social_publish_subscribe_cstr(handle: int64): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("social_publish_subscribe: node_not_initialized")
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        setLastError("social_publish_subscribe: switch_missing")
        return dupCString("{\"ok\":false,\"error\":\"switch_missing\"}")
    if !um_hostGossipsubSubscribe(socialPublishMetadataTopic):
        let errText: str = trimText(gLastError)
        setLastError("social_publish_subscribe: metadata_subscribe_failed")
        if len(errText) > 0:
            return dupCString("{\"ok\":false,\"error\":\"metadata_subscribe_failed\",\"detail\":" + toJsonStringValue(strings.CloneStr(errText)) + "}")
        return dupCString("{\"ok\":false,\"error\":\"metadata_subscribe_failed\"}")
    emitNodeEvent(node, "social.publish.subscribe", "{\"topic\":" + toJsonStringValue(strings.CloneStr(socialPublishMetadataTopic)) + "}")
    return dupCString("{\"ok\":true,\"topic\":" + toJsonStringValue(strings.CloneStr(socialPublishMetadataTopic)) + "}")

@exportc("social_publish_receive_metadata_cstr")
fn social_publish_receive_metadata_cstr(handle: int64, payloadJsonPtr: void*): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("social_publish_receive_metadata: node_not_initialized")
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let payloadJson: str = voidPtrText(payloadJsonPtr)
    let storeRes: Result[str] = storeReceivedSocialPublishMetadataPtr(node, payloadJson)
    if IsErr(storeRes):
        let errText: str = strings.CloneStr(storeRes.err.msg)
        setLastError("social_publish_receive_metadata: " + errText)
        return dupCString("{\"ok\":false,\"error\":" + toJsonStringValue(strings.CloneStr(errText)) + "}")
    let contentId: str = Value(storeRes)
    emitNodeEvent(node, "social.publish.receive", "{\"topic\":" + toJsonStringValue(strings.CloneStr(socialPublishMetadataTopic)) + ",\"contentId\":" + toJsonStringValue(strings.CloneStr(contentId)) + "}")
    return dupCString("{\"ok\":true,\"topic\":" + toJsonStringValue(strings.CloneStr(socialPublishMetadataTopic)) + ",\"contentId\":" + toJsonStringValue(strings.CloneStr(contentId)) + "}")

@exportc("social_publish_enqueue_cstr")
fn social_publish_enqueue_cstr(handle: int64, postJsonPtr: void*): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        setLastError("social_publish_enqueue: node_not_initialized")
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    if !(node->started):
        setLastError("social_publish_enqueue: node_not_started")
        return dupCString("{\"ok\":false,\"error\":\"node_not_started\"}")
    let postJson: str = strings.CloneStr(trimText(voidPtrText(postJsonPtr)))
    if !isJsonObjectPayload(strings.CloneStr(postJson)):
        setLastError("social_publish_enqueue: invalid_json")
        return dupCString("{\"ok\":false,\"error\":\"invalid_json\"}")
    node->publishTaskSeq = node->publishTaskSeq + 1
    let createdAt: int64 = nowMs()
    let taskId: str = "cheng-publish-" + $createdAt + "-" + $node->publishTaskSeq
    let contentId: str = "content-" + $createdAt + "-" + $node->publishTaskSeq
    var authorPeerId: str = canonicalPeerIdOrEmpty(resolveNodePeerId(node))
    if len(authorPeerId) <= 0:
        authorPeerId = forceDeterministicPeerId(node)
        StoreLocalPeerIdAt(idx, ownText(authorPeerId))
    # Hoist the app-provided visible address (already display-level-governed by
    # the app) from the post payload to an announce top-level field, so feed
    # consumers read it flat off each item without digging into `payload`.
    # Absent/empty → no field at all: old receivers never query unknown keys.
    let postOwned: str = strings.CloneStr(postJson)
    let locationFieldJson: str = VisibleLocationFieldJson(strings.CloneStr(postOwned))
    let taskJson: str =
        "{" +
        "\"taskId\":" + toJsonStringValue(strings.CloneStr(taskId)) +
        ",\"contentId\":" + toJsonStringValue(strings.CloneStr(contentId)) +
        ",\"postId\":" + toJsonStringValue(strings.CloneStr(contentId)) +
        ",\"payload\":" + strings.CloneStr(postOwned) +
        ",\"createdAt\":" + $createdAt +
        ",\"timestampMs\":" + $createdAt +
        ",\"publishState\":\"published\"" +
        ",\"visibility\":\"public\"" +
        ",\"homeEligible\":true" +
        ",\"reasonCode\":\"cheng_libp2p_publish_broadcast\"" +
        ",\"authorPeerId\":" + toJsonStringValue(strings.CloneStr(authorPeerId)) +
        strings.CloneStr(locationFieldJson) +
        "}"
    let publishRc: int32 = publishSocialMetadata(handle, strings.CloneStr(taskJson))
    if publishRc != resultOk:
        let errText: str = trimText(strings.CloneStr(gLastError))
        setLastError("social_publish_enqueue: metadata_broadcast_failed")
        if len(errText) > 0:
            return dupCString("{\"ok\":false,\"error\":\"metadata_broadcast_failed\",\"detail\":" + toJsonStringValue(strings.CloneStr(errText)) + "}")
        return dupCString("{\"ok\":false,\"error\":\"metadata_broadcast_failed\"}")
    storePublishTaskPtr(node, strings.CloneStr(taskId), strings.CloneStr(contentId), strings.CloneStr(taskJson))
    storeFeedEntryLocalPtr(node, strings.CloneStr(taskJson))
    let deliveredCount: int32 = countConnectedPeersPtr(node)
    emitNodeEvent(node, "social.publish.broadcast", "{\"taskId\":" + toJsonStringValue(strings.CloneStr(taskId)) + ",\"contentId\":" + toJsonStringValue(strings.CloneStr(contentId)) + ",\"topic\":" + toJsonStringValue(strings.CloneStr(socialPublishMetadataTopic)) + ",\"delivered\":" + $deliveredCount + "}")
    return dupCString("{\"ok\":true,\"task\":" + taskJson + ",\"topic\":" + toJsonStringValue(strings.CloneStr(socialPublishMetadataTopic)) + ",\"delivered\":" + $deliveredCount + "}")

