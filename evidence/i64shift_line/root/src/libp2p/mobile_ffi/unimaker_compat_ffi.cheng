@exportc("libp2p_upsert_livestream_cfg")
fn libp2p_upsert_livestream_cfg(handle: int64, streamKeyPtr: void*, configJsonPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("upsert_livestream_cfg: invalid handle")
    let streamKey: str = trimText(voidPtrText(streamKeyPtr))
    let configJson: str = trimText(voidPtrText(configJsonPtr))
    if len(streamKey) <= 0:
        return failWith("upsert_livestream_cfg: missing streamKey")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return failWith("upsert_livestream_cfg: switch missing")
    let ok: bool = addLiveStreamPtr(node, streamKey)
    if !ok:
        return failWith("upsert_livestream_cfg: no slot")
    emitNodeEvent(node, "livestream.upsert", if len(configJson) > 0: configJson else: "{}")
    return true

@exportc("libp2p_publish_livestream_frame_ffi")
fn libp2p_publish_livestream_frame_ffi(handle: int64, streamKeyPtr: void*, payloadPtr: void*, payloadLen: int64): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("publish_livestream_frame: invalid handle")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return failWith("publish_livestream_frame: switch missing")
    let streamKey: str = trimText(voidPtrText(streamKeyPtr))
    if len(streamKey) <= 0:
        return failWith("publish_livestream_frame: missing streamKey")
    if payloadPtr == nil || payloadLen <= 0:
        return failWith("publish_livestream_frame: empty payload")
    if !addLiveStreamPtr(node, streamKey):
        return failWith("publish_livestream_frame: no stream slot")
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        return failWith("publish_livestream_frame: switch ptr missing")
    let peerTotal: int32 = safePeerCountPtr(node)
    var delivered: int32
    let payloadText: str = voidPtrText(payloadPtr)
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAtPtr(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && peerRowConnected(row):
            let payloadBytes: Bytes = BytesSlice(BytesFromString(payloadText), 0, len(payloadText))
            if um_hostPingPeerWithPayloadTextIndex(swIdx, peerIdText, payloadBytes):
                delivered = delivered + 1
        i = i + 1
    emitNodeEvent(node, "livestream.frame", "{\"streamKey\":" + toJsonStringValue(strings.CloneStr(streamKey)) + ",\"size\":" + $payloadLen + ",\"delivered\":" + $delivered + "}")
    return true

@exportc("libp2p_get_diagnostics_json")
fn libp2p_get_diagnostics_json(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{}")
    let connectedCount: int32 = countConnectedPeersPtr(node)
    let knownPeers: int32 = safePeerCountPtr(node)
    var out: str = "{"
    out = out + "\"peerId\":" + toJsonStringValue(CloneLocalPeerIdAt(idx))
    out = out + ",\"started\":" + (if node->started: "true" else: "false")
    out = out + ",\"connectedCount\":" + $connectedCount
    out = out + ",\"knownPeers\":" + $knownPeers
    out = out + ",\"systemProfile\":" + localSystemProfileJsonPtr(node)
    out = out + ",\"networkResources\":" + networkResourcesSummaryJsonPtr(node)
    out = out + ",\"connections\":" + connectedPeersInfoJsonPtr(node)
    out = out + ",\"social\":{\"conversations\":0,\"contacts\":0,\"groups\":0,\"moments\":0,\"notifications\":" + $node->socialEventsCount + ",\"pendingRetransmissions\":0,\"eventQueueDepth\":" + $node->eventsCount + "}"
    out = out + "}"
    return dupCString(strings.CloneStr(out))

