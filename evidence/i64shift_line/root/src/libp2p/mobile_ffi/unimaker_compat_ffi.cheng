    return true

@exportc("libp2p_mdns_probe")
fn libp2p_mdns_probe(handle: int64): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("mdns_probe: invalid handle")
    if !(node->mdnsEnabled):
        return failWith("mdns_probe: disabled")
    if !mdnsApplyNodeConfigPtr(node):
        return failWith("mdns_probe: apply config failed")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return failWith("mdns_probe: missing switch")
    let serviceText: str = cloneNodeMdnsServicePtr(node)
    let namespaceText: str = cloneNodeMdnsNamespacePtr(node)
    if !um_hostMdnsAdvertiseIndex(swIdx, serviceText, namespaceText):
        return failWith("mdns_probe: advertise failed")

    var knownMdnsPeers: str[]
    let beforeTotal: int32 = safePeerCountPtr(node)
    var beforeIdx: int32
    while beforeIdx < beforeTotal:
        let rowBefore: str = peerRowAtPtr(node, beforeIdx)
        let peerBeforeId: str = peerRowPeerId(rowBefore)
        if peerRowUsed(rowBefore) && len(peerBeforeId) > 0 && !nodeLocalPeerIdEqualsPtr(node, peerBeforeId) && (peerRowSourceMask(rowBefore) & sourceMdns) != 0:
            add(knownMdnsPeers, peerBeforeId)
        beforeIdx = beforeIdx + 1

    var discoveredTotal: int32
    var discoverSucceeded: bool
    let discoverPrimaryRaw: int32 = um_hostMdnsDiscoverIndex(swIdx, serviceText, namespaceText, maxMdnsDiscoverCount)
    if discoverPrimaryRaw >= 0:
        discoverSucceeded = true
        discoveredTotal = discoveredTotal + mdnsDiscoverCountOrZero(discoverPrimaryRaw)

    let discoverUnimakerServiceRaw: int32 = um_hostMdnsDiscoverIndex(swIdx, mdnsServiceUnimakerText(), namespaceText, maxMdnsDiscoverCount)
    if discoverUnimakerServiceRaw >= 0:
        discoverSucceeded = true
        discoveredTotal = discoveredTotal + mdnsDiscoverCountOrZero(discoverUnimakerServiceRaw)

    let discoverUnimakerServiceLocalRaw: int32 = um_hostMdnsDiscoverIndex(swIdx, mdnsServiceUnimakerLocalText(), namespaceText, maxMdnsDiscoverCount)
    if discoverUnimakerServiceLocalRaw >= 0:
        discoverSucceeded = true
        discoveredTotal = discoveredTotal + mdnsDiscoverCountOrZero(discoverUnimakerServiceLocalRaw)

    let discoverLibp2pServiceRaw: int32 = um_hostMdnsDiscoverIndex(swIdx, mdnsServiceLibp2pText(), namespaceText, maxMdnsDiscoverCount)
    if discoverLibp2pServiceRaw >= 0:
        discoverSucceeded = true
        discoveredTotal = discoveredTotal + mdnsDiscoverCountOrZero(discoverLibp2pServiceRaw)

    let discoverLibp2pServiceLocalRaw: int32 = um_hostMdnsDiscoverIndex(swIdx, mdnsServiceLibp2pLocalText(), namespaceText, maxMdnsDiscoverCount)
    if discoverLibp2pServiceLocalRaw >= 0:
        discoverSucceeded = true
        discoveredTotal = discoveredTotal + mdnsDiscoverCountOrZero(discoverLibp2pServiceLocalRaw)

    let discoverP2pServiceRaw: int32 = um_hostMdnsDiscoverIndex(swIdx, mdnsServiceP2pText(), namespaceText, maxMdnsDiscoverCount)
    if discoverP2pServiceRaw >= 0:
        discoverSucceeded = true
        discoveredTotal = discoveredTotal + mdnsDiscoverCountOrZero(discoverP2pServiceRaw)

    let discoverP2pServiceLocalRaw: int32 = um_hostMdnsDiscoverIndex(swIdx, mdnsServiceP2pLocalText(), namespaceText, maxMdnsDiscoverCount)
    if discoverP2pServiceLocalRaw >= 0:
        discoverSucceeded = true
        discoveredTotal = discoveredTotal + mdnsDiscoverCountOrZero(discoverP2pServiceLocalRaw)

    if !discoverSucceeded:
        return failWith("mdns_probe: discover failed")

    syncPeerstoreIntoNodePtr(node, sourceConnected | sourceWan | sourceLan | sourceMdns | sourceDht | sourceRendezvous)
    let visibleScanTotal: int32 = safePeerCountPtr(node)
    var visibleMdnsTotal: int32
    var visibleIdx: int32
    while visibleIdx < visibleScanTotal:
        let visibleRow: str = peerRowAtPtr(node, visibleIdx)
        let visiblePeerId: str = peerRowPeerId(visibleRow)
        if peerRowUsed(visibleRow) && len(visiblePeerId) > 0 && !nodeLocalPeerIdEqualsPtr(node, visiblePeerId) && (peerRowSourceMask(visibleRow) & sourceMdns) != 0:
            visibleMdnsTotal = visibleMdnsTotal + 1
        visibleIdx = visibleIdx + 1
    let discoveredReportTotal: int32 =
        if visibleMdnsTotal > discoveredTotal:
            visibleMdnsTotal
        else:
            discoveredTotal
    debugNodeStep("[ffi] mdns_probe discovered_total=" + $discoveredReportTotal + " discovered_new=" + $discoveredTotal + " service=" + serviceText + " namespace=" + namespaceText)

    let afterTotal: int32 = safePeerCountPtr(node)
    var afterIdx: int32
    while afterIdx < afterTotal:
        let rowAfter: str = peerRowAtPtr(node, afterIdx)
        let peerAfterId: str = peerRowPeerId(rowAfter)
        if peerRowUsed(rowAfter) && len(peerAfterId) > 0 && !nodeLocalPeerIdEqualsPtr(node, peerAfterId) && (peerRowSourceMask(rowAfter) & sourceMdns) != 0:
            var seen: bool
            var knownIdx: int32
            while knownIdx < len(knownMdnsPeers):
                if knownMdnsPeers[knownIdx] == peerAfterId:
                    seen = true
                    break
                knownIdx = knownIdx + 1
            if !seen:
                var payload: str = "{"
                payload = payload + "\"type\":\"MdnsPeerDiscovered\""
                payload = payload + ",\"peerId\":" + toJsonStringValue(strings.CloneStr(peerAfterId))
                payload = payload + ",\"peer_id\":" + toJsonStringValue(strings.CloneStr(peerAfterId))
                payload = payload + ",\"addresses\":" + peerAddrsJsonFromAddr(peerRowAddr(rowAfter))
                payload = payload + ",\"source\":\"mdns\""
                payload = payload + ",\"timestampMs\":" + $nowMs()
                payload = payload + "}"
                emitNodeEvent(node, "network_event", payload)
        afterIdx = afterIdx + 1
    return true

@exportc("libp2p_ble_set_enabled")
fn libp2p_ble_set_enabled(handle: int64, enabled: bool): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("ble_set_enabled: invalid handle")
    node->bleEnabled = enabled
    if enabled:
        StoreBleServiceAt(idx, bleDefaultServiceText())
        StoreBleNamespaceAt(idx, bleDefaultNamespaceText())
    if !bleApplyNodeConfigPtr(node):
        return false
    return true

@exportc("libp2p_ble_probe")
fn libp2p_ble_probe(handle: int64): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("ble_probe: invalid handle")
    if !(node->bleEnabled):
        return failWith("ble_probe: disabled")
    if !bleApplyNodeConfigPtr(node):
        return failWith("ble_probe: apply config failed")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return failWith("ble_probe: missing switch")
    let serviceText: str = CloneBleServiceAt(idx)
    let namespaceText: str = CloneBleNamespaceAt(idx)
    if !um_hostBleAdvertiseIndex(swIdx, serviceText, namespaceText):
        return failWith("ble_probe: advertise failed")

    var discoveredTotal: int32
    let discoverRaw: int32 = um_hostBleDiscoverIndex(swIdx, serviceText, namespaceText, maxMdnsDiscoverCount)
    if discoverRaw >= 0:
        discoveredTotal = mdnsDiscoverCountOrZero(discoverRaw)

    var i: int32
    while i < maxNodes:
        let other: NodeRuntime* = nodePtrAt(i)
        if other != nil && other->used && other->started && other->bleEnabled:
            if i != idx && bleApplyNodeConfig(*other):
                if other->bleService == serviceText && other->bleNamespace == namespaceText:
                    let peerIdText: str = canonicalPeerIdOrEmpty(resolveNodePeerId(other))
                    if len(peerIdText) > 0 && peerIdText != canonicalPeerIdOrEmpty(resolveNodePeerId(node)):
                        let dialAddr: str = toDialAddressWithPeer(other->listenAddr, peerIdText)
                        addPeerAddressPtr(node, peerIdText, dialAddr, sourceBle | sourceLan)
                        discoveredTotal = discoveredTotal + 1
        i = i + 1

    syncPeerstoreIntoNodePtr(node, sourceConnected | sourceWan | sourceLan | sourceMdns | sourceBle | sourceDht | sourceRendezvous)
    debugNodeStep("[ffi] ble_probe discovered_total=" + $discoveredTotal + " service=" + serviceText + " namespace=" + namespaceText)
    return true

@exportc("libp2p_mdns_debug")
fn libp2p_mdns_debug(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{}")
    if !(node->mdnsEnabled):
        return dupCString("{\"enabled\":false,\"intervalSec\":0,\"service\":\"\",\"namespace\":\"\",\"preferredIpv4\":\"\",\"peerCount\":0,\"peers\":[]}")
    syncPeerstoreIntoNodePtr(node, sourceConnected | sourceWan | sourceLan | sourceMdns | sourceDht | sourceRendezvous)
    let peerTotal: int32 = safePeerCountPtr(node)
    var mdnsPeerCount: int32
    var peersJson: str = "["
    var i: int32
    while i < peerTotal:
        let row: str = peerRowAtPtr(node, i)
        let peerIdText: str = peerRowPeerId(row)
        if peerRowUsed(row) && len(peerIdText) > 0 && !nodeLocalPeerIdEqualsPtr(node, peerIdText) && (peerRowSourceMask(row) & sourceMdns) != 0:
            mdnsPeerCount = mdnsPeerCount + 1
            if mdnsPeerCount > 1:
                peersJson = peersJson + ","
            peersJson = peersJson + "{"
            peersJson = peersJson + "\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText))
            peersJson = peersJson + ",\"peer_id\":" + toJsonStringValue(strings.CloneStr(peerIdText))
            peersJson = peersJson + ",\"addresses\":" + peerAddrsJsonFromAddr(peerRowAddr(row))
            peersJson = peersJson + ",\"multiaddrs\":" + peerAddrsJsonFromAddr(peerRowAddr(row))
            peersJson = peersJson + ",\"sources\":" + peerSourcesJson(peerRowSourceMask(row))
            peersJson = peersJson + ",\"lastSeenAt\":" + $peerRowLastSeenAtMs(row)
            peersJson = peersJson + "}"
        i = i + 1
    peersJson = peersJson + "]"
    let mdnsServiceText: str = cloneNodeMdnsServicePtr(node)
    let mdnsNamespaceText: str = cloneNodeMdnsNamespacePtr(node)
    let mdnsPreferredIpv4Text: str = cloneNodeMdnsPreferredIpv4Ptr(node)
    var out: str
    out = "{"
    out = out + "\"enabled\":" + (if node->mdnsEnabled: "true" else: "false")
    out = out + ",\"intervalSec\":" + $node->mdnsIntervalSec
    out = out + ",\"service\":" + toJsonStringValue(strings.CloneStr(mdnsServiceText))
    out = out + ",\"namespace\":" + toJsonStringValue(strings.CloneStr(mdnsNamespaceText))
    out = out + ",\"preferredIpv4\":" + toJsonStringValue(strings.CloneStr(mdnsPreferredIpv4Text))
    out = out + ",\"peerCount\":" + $mdnsPeerCount
    out = out + ",\"peers\":" + peersJson
    out = out + "}"
    return dupCString(strings.CloneStr(out))

