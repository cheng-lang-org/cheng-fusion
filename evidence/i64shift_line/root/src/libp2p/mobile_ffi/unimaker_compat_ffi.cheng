    let deleteOk: bool = libp2p_feed_publish_entry(handle, void*(publishPayloadPtr))
    c_free(publishPayloadPtr)
    if !deleteOk:
        return false
    emitSocialEvent(node, "moments", "delete", "{}", "", "", postId)
    return true

