        gNode3.peerRowsText = strings.CloneStr(text)
        return
    if index == 4:
        gNode4.peerRowsText = strings.CloneStr(text)
        return
    if index == 5:
        gNode5.peerRowsText = strings.CloneStr(text)
        return
    if index == 6:
        gNode6.peerRowsText = strings.CloneStr(text)
        return
    if index == 7:
        gNode7.peerRowsText = strings.CloneStr(text)
        return
    return

fn CloneSharedFileFromNode(node: var NodeRuntime, fileIdx: int32): SharedFileEntry =
    var entry: SharedFileEntry
    if fileIdx < 0 || fileIdx >= len(node.sharedFiles):
        return entry
    entry.key = strings.CloneStr(node.sharedFiles[fileIdx].key)
    entry.path = strings.CloneStr(node.sharedFiles[fileIdx].path)
    entry.fileName = strings.CloneStr(node.sharedFiles[fileIdx].fileName)
    entry.mimeType = strings.CloneStr(node.sharedFiles[fileIdx].mimeType)
    entry.sha256 = strings.CloneStr(node.sharedFiles[fileIdx].sha256)
    entry.sizeBytes = node.sharedFiles[fileIdx].sizeBytes
    entry.registeredAtMs = node.sharedFiles[fileIdx].registeredAtMs
    return entry

fn CloneSharedFileAt(index: int32, fileIdx: int32): SharedFileEntry =
    if index == 0:
        return CloneSharedFileFromNode(gNode0, fileIdx)
    if index == 1:
        return CloneSharedFileFromNode(gNode1, fileIdx)
    if index == 2:
        return CloneSharedFileFromNode(gNode2, fileIdx)
    if index == 3:
        return CloneSharedFileFromNode(gNode3, fileIdx)
    if index == 4:
        return CloneSharedFileFromNode(gNode4, fileIdx)
    if index == 5:
        return CloneSharedFileFromNode(gNode5, fileIdx)
    if index == 6:
        return CloneSharedFileFromNode(gNode6, fileIdx)
    if index == 7:
        return CloneSharedFileFromNode(gNode7, fileIdx)
    var empty: SharedFileEntry
    return empty

fn CloneDataDirAt(index: int32): str =
    if index == 0:
        return strings.CloneStr(gNode0.dataDir)
    if index == 1:
        return strings.CloneStr(gNode1.dataDir)
    if index == 2:
        return strings.CloneStr(gNode2.dataDir)
    if index == 3:
        return strings.CloneStr(gNode3.dataDir)
    if index == 4:
        return strings.CloneStr(gNode4.dataDir)
    if index == 5:
        return strings.CloneStr(gNode5.dataDir)
    if index == 6:
        return strings.CloneStr(gNode6.dataDir)
    if index == 7:
        return strings.CloneStr(gNode7.dataDir)
    return ""

@borrows
fn feedSnapshotJson(node: var NodeRuntime): str =
    var out: str = "{\"items\":["
    let total: int32 = if node.feedEntryCount < len(node.feedEntries): node.feedEntryCount else: len(node.feedEntries)
    var i: int32
    while i < total:
        if i > 0:
            out = out + ","
        out = out + normalizeJsonPayload(node.feedEntries[i])
        i = i + 1
    out = out + "],\"totalCount\":" + $total + "}"
    return out

fn storeFeedEntryLocal(node: var NodeRuntime, payloadJson: str) =
    let normalized: str = trimText(payloadJson)
    if len(normalized) <= 0:
        return
    if len(node.feedEntries) >= maxFeedEntries:
        var nextEntries: str[]
        var i: int32 = 1
        while i < len(node.feedEntries):
            add(nextEntries, strings.CloneStr(node.feedEntries[i]))
            i = i + 1
        add(nextEntries, strings.CloneStr(normalized))
        node.feedEntries = nextEntries
    else:
        add(node.feedEntries, strings.CloneStr(normalized))
    node.feedEntryCount = len(node.feedEntries)

fn storePublishTask(node: var NodeRuntime, taskId: str, contentId: str, taskJson: str) =
    if len(node.publishTasks) >= maxPublishTasks:
        var nextTasks: str[]
        var nextIds: str[]
        var nextContentIds: str[]
        var i: int32 = 1
        while i < len(node.publishTasks):
            add(nextTasks, strings.CloneStr(node.publishTasks[i]))
            if i < len(node.publishTaskIds):
                add(nextIds, strings.CloneStr(node.publishTaskIds[i]))
            else:
                add(nextIds, "")
            if i < len(node.publishContentIds):
                add(nextContentIds, strings.CloneStr(node.publishContentIds[i]))
            else:
                add(nextContentIds, "")
            i = i + 1
        add(nextTasks, strings.CloneStr(taskJson))
        add(nextIds, strings.CloneStr(taskId))
        add(nextContentIds, strings.CloneStr(contentId))
        node.publishTasks = nextTasks
        node.publishTaskIds = nextIds
        node.publishContentIds = nextContentIds
    else:
        add(node.publishTasks, strings.CloneStr(taskJson))
        add(node.publishTaskIds, strings.CloneStr(taskId))
        add(node.publishContentIds, strings.CloneStr(contentId))
    node.publishTaskCount = len(node.publishTasks)

@borrows
fn publishSocialMetadata(handle: int64, taskJson: str): int32 =
    let topicPtr: cstring = dupCString(strings.CloneStr(socialPublishMetadataTopic))
    let payloadPtr: cstring = dupCString(strings.CloneStr(taskJson))
    let rc: int32 = libp2p_pubsub_publish(handle, void*(topicPtr), void*(payloadPtr), int64(len(taskJson)), nil)
    c_free(topicPtr)
    c_free(payloadPtr)
    return rc

fn storeReceivedSocialPublishMetadata(node: var NodeRuntime, taskJson: str): Result[str] =
    let normalized: str = trimText(taskJson)
    if !isJsonObjectPayload(normalized):
        return Err[str]("invalid_publish_metadata_json")
    let parsed: json.JsonParseResult = json.ParseJsonSafe(normalized)
    if !parsed.success || parsed.value.kind != json.JObject:
        return Err[str]("invalid_publish_metadata_json")
    var taskId: str
    if !json.JsonTryGetStr(parsed.value, "taskId", taskId):
        return Err[str]("missing_publish_task_id")
    var contentId: str
    if !json.JsonTryGetStr(parsed.value, "contentId", contentId):
        return Err[str]("missing_publish_content_id")
    taskId = trimText(taskId)
    contentId = trimText(contentId)
    if len(taskId) <= 0:
        return Err[str]("missing_publish_task_id")
    if len(contentId) <= 0:
        return Err[str]("missing_publish_content_id")
    if len(findPublishTaskJson(node, taskId)) > 0 || len(findPublishTaskJson(node, contentId)) > 0:
        return Ok[str](contentId)
    storePublishTask(node, strings.CloneStr(taskId), strings.CloneStr(contentId), strings.CloneStr(normalized))
    storeFeedEntryLocal(node, strings.CloneStr(normalized))
    return Ok[str](contentId)

# Shared dedup key for feed entries (social publish tasks and distributed
# content announces alike): contentId, falling back to id, falling back to
# postId. Mirrors the web client's contentIdFromPayload fallback chain so the
# same entry arriving over different channels resolves to the same key.
@borrows
fn contentIdFromJsonValue(value: json.JsonNode): str =
    var contentId: str
    if json.JsonTryGetStr(value, "contentId", contentId) && len(trimText(contentId)) > 0:
        return trimText(contentId)
    var idVal: str
    if json.JsonTryGetStr(value, "id", idVal) && len(trimText(idVal)) > 0:
        return trimText(idVal)
    var postId: str
    if json.JsonTryGetStr(value, "postId", postId) && len(trimText(postId)) > 0:
        return trimText(postId)
    return ""

@borrows
fn feedEntryContentIdOrEmpty(entryJson: str): str =
    let parsed: json.JsonParseResult = json.ParseJsonSafe(entryJson)
    if !parsed.success || parsed.value.kind != json.JObject:
        return ""
    return contentIdFromJsonValue(parsed.value)

# Linear scan over the shared feed store for an existing entry with the same
# dedup key. feedEntries is bounded (maxFeedEntries), so this stays cheap and
# matches the existing O(n) lookup style used by findPublishTaskJson.
@borrows
fn findFeedEntryByContentId(node: var NodeRuntime, contentId: str): bool =
    let target: str = trimText(contentId)
    if len(target) <= 0:
        return false
    var i: int32
    while i < len(node.feedEntries):
        if feedEntryContentIdOrEmpty(node.feedEntries[i]) == target:
            return true
        i = i + 1
    return false

# Receiver-side handling for a gossip-delivered distributed content announce
# (unimaker/content/v1). Mirrors storeReceivedSocialPublishMetadata: parse,
# require a resolvable content id, dedup against whatever is already in the
# shared feed store (covers both re-delivery on this channel and prior arrival
# via ingress SSE), then store and notify the same "moments"/"upsert" entity
# the ingress content handler already emits on Android so a live poll cycle
# picks the new item up without waiting for a manual feed refresh.
fn storeReceivedContentAnnounce(node: var NodeRuntime, payloadJson: str): Result[str] =
    let normalized: str = trimText(payloadJson)
    if !isJsonObjectPayload(normalized):
        return Err[str]("invalid_content_announce_json")
    let parsed: json.JsonParseResult = json.ParseJsonSafe(normalized)
    if !parsed.success || parsed.value.kind != json.JObject:
        return Err[str]("invalid_content_announce_json")
    let contentId: str = contentIdFromJsonValue(parsed.value)
    if len(contentId) <= 0:
        return Err[str]("missing_content_id")
    if findFeedEntryByContentId(node, contentId):
        return Ok[str](contentId)
    storeFeedEntryLocal(node, strings.CloneStr(normalized))
    emitSocialEvent(&node, "moments", "upsert", strings.CloneStr(normalized), "", "", strings.CloneStr(contentId))
    return Ok[str](contentId)

# Serialize the node's local feed entries as a bare JSON array (the `items` value
# the retained scene's node-contents apply path expects). Mirrors feedSnapshotJson
# but without the wrapping object, so the FFI can embed it under an `ok` envelope.
@borrows
fn feedEntryTotalPtr(node: NodeRuntime*): int32 =
    if node == nil:
        return 0
    return node->feedEntryCount

@borrows
fn feedItemsArrayJsonPtr(node: NodeRuntime*): str =
    return "[]"

@borrows
fn drainInboundGossipMessagesPtr(node: NodeRuntime*): int32 =
    let index: int32 = nodePtrIndex(node)
    if index == 0:
        return drainInboundGossipMessages(gNode0)
    if index == 1:
        return drainInboundGossipMessages(gNode1)
    if index == 2:
        return drainInboundGossipMessages(gNode2)
    if index == 3:
        return drainInboundGossipMessages(gNode3)
    if index == 4:
        return drainInboundGossipMessages(gNode4)
    if index == 5:
        return drainInboundGossipMessages(gNode5)
    if index == 6:
        return drainInboundGossipMessages(gNode6)
    if index == 7:
        return drainInboundGossipMessages(gNode7)
    return 0

@borrows
fn callHostDialPeerPtr(node: NodeRuntime*, peerText: str): bool =
    let index: int32 = nodePtrIndex(node)
    let peerOwned: str = strings.CloneStr(peerText)
    if index == 0:
        return callHostDialPeer(gNode0, peerOwned)
    if index == 1:
        return callHostDialPeer(gNode1, peerOwned)
    if index == 2:
        return callHostDialPeer(gNode2, peerOwned)
    if index == 3:
        return callHostDialPeer(gNode3, peerOwned)
    if index == 4:
        return callHostDialPeer(gNode4, peerOwned)
    if index == 5:
        return callHostDialPeer(gNode5, peerOwned)
    if index == 6:
        return callHostDialPeer(gNode6, peerOwned)
    if index == 7:
        return callHostDialPeer(gNode7, peerOwned)
    return false

@borrows
fn peerRecordMeasurementPtr(node: NodeRuntime*, peerIdText: str, upBps: int64, downBps: int64, txBytes: int64, rxBytes: int64, latencyMs: int32, relayed: bool) =
    let index: int32 = nodePtrIndex(node)
