fn DrainNodeEvents(node: NodeRuntime*, maxOut: int32): str =
    let index: int32 = nodePtrIndex(node)
    var q: EventQueue
    q.count = 0
    q.itemsText = ""
    LoadNodeEventsInto(index, q)
    let payload: str = queueDrain(q, maxOut)
    WriteNodeEvents(index, q)
    return payload

fn DrainNodeSocialEvents(node: NodeRuntime*, maxOut: int32): str =
    let index: int32 = nodePtrIndex(node)
    var q: EventQueue
    q.count = 0
    q.itemsText = ""
    LoadNodeSocialEventsInto(index, q)
    let payload: str = queueDrain(q, maxOut)
    WriteNodeSocialEvents(index, q)
    return payload

fn PeekNodeSocialEvents(node: NodeRuntime*, limit: int32): str =
    let index: int32 = nodePtrIndex(node)
    var q: EventQueue
    q.count = 0
    q.itemsText = ""
    LoadNodeSocialEventsInto(index, q)
    return queuePeek(q, limit)

@borrows
fn emitNodeEvent(node: NodeRuntime*, topic: str, payload: str) =
    let index: int32 = nodePtrIndex(node)
    if index < 0:
        return
    var events: EventQueue
    events.count = 0
    events.itemsText = ""
    LoadNodeEventsInto(index, events)
    let eventJson: str = joinText(["{\"topic\":", toJsonStringValue(strings.CloneStr(topic)), ",\"payload\":", normalizeJsonPayload(payload), "}"])
    queuePush(events, eventJson)
    WriteNodeEvents(index, events)

@borrows
fn emitSocialEvent(node: NodeRuntime*, entity: str, op: str, payload: str, conversationId: str, groupId: str, postId: str) =
    if node == nil:
        return
    var eventJson: str = "{"
    eventJson = joinText([eventJson, "\"kind\":\"social\""])
    eventJson = joinText([eventJson, ",\"entity\":", toJsonStringValue(strings.CloneStr(entity))])
    eventJson = joinText([eventJson, ",\"op\":", toJsonStringValue(strings.CloneStr(op))])
    let traceSeq: int64 = nextSeq()
    let traceText: str = joinText(["trace-", Int64ToStr(traceSeq)])
    eventJson = joinText([eventJson, ",\"traceId\":", toJsonStringValue(strings.CloneStr(traceText))])
    let eventSeq: int64 = nextSeq()
    let eventNow: int64 = nowMs()
    eventJson = joinText([eventJson, ",\"seq\":", Int64ToStr(eventSeq)])
    eventJson = joinText([eventJson, ",\"timestampMs\":", Int64ToStr(eventNow)])
    if len(conversationId) > 0:
        eventJson = joinText([eventJson, ",\"conversationId\":", toJsonStringValue(strings.CloneStr(conversationId))])
    if len(groupId) > 0:
        eventJson = joinText([eventJson, ",\"groupId\":", toJsonStringValue(strings.CloneStr(groupId))])
    if len(postId) > 0:
        eventJson = joinText([eventJson, ",\"postId\":", toJsonStringValue(strings.CloneStr(postId))])
    eventJson = joinText([eventJson, ",\"payload\":", normalizeJsonPayload(payload)])
    eventJson = joinText([eventJson, "}"])
    var social: EventQueue
    social.count = 0
    social.itemsText = ""
    LoadNodeSocialEventsInto(nodePtrIndex(node), social)
    queuePush(social, strings.CloneStr(eventJson))
    WriteNodeSocialEvents(nodePtrIndex(node), social)
    var events: EventQueue
    events.count = 0
    events.itemsText = ""
    LoadNodeEventsInto(nodePtrIndex(node), events)
    queuePush(events, joinText(["{\"topic\":\"social_event\",\"payload\":", strings.CloneStr(eventJson), "}"]))
    WriteNodeEvents(nodePtrIndex(node), events)

fn markNodeUnused(node: NodeRuntime*) =
    if node == nil:
        return
    node->used = false
    node->started = false
    node->switchIndex = -1

fn clearNode(node: var NodeRuntime) =
    node.used = false
    node.started = false
    node.switchIndex = -1
    node.listenAddr = ""
    node.dataDir = ""
    node.localPeerId = ""
    node.hostNetworkStatusJson = "{}"
    node.bwLastSampleAtMs = 0
    node.bwLastUplinkTotal = 0
    node.bwLastDownlinkTotal = 0
    node.bwPassiveUplinkBps = 0
    node.bwPassiveDownlinkBps = 0
    node.nodeResourceLastRefreshAtMs = 0
    node.peerCount = 0
    node.peerRowsText = ""
    node.mdnsEnabled = false
    node.mdnsIntervalSec = 1
    node.mdnsPreferredIpv4 = ""
    node.mdnsService = ""
    node.mdnsNamespace = ""
    node.bleEnabled = false
    node.bleService = defaultBleService
    node.bleNamespace = defaultBleNamespace
    node.msquicAllowDatagram = true
    node.msquicMaxDatagram = 65535
    node.msquicMinMtu = 1200
    node.msquicMaxMtu = 0
    node.msquicMigrationEnabled = true
    node.msquicEcnEnabled = false
    node.bootstrapPeers = []
    node.bootstrapCount = 0
    node.bootstrapReconnectAtMs = 0
    node.pushToken = ""
    node.hibernatedPeers = []
    node.hibernatedCount = 0
    node.pendingWakeupPeer = ""
    node.pushQueuedCount = 0
    node.pushWakeupCount = 0
    node.pushRecoveredCount = 0
    node.pushFailedCount = 0
    node.eventsCount = 0
    node.eventsItemsText = ""
    node.socialEventsCount = 0
    node.socialEventsItemsText = ""
    node.lastDirectError = ""
    node.lastChunkSize = 0
    node.sharedFiles = []
    node.sharedFileCount = 0
    node.feedEntries = []
    node.feedEntryCount = 0
    node.publishTasks = []
    node.publishTaskIds = []
    node.publishContentIds = []
    node.publishTaskCount = 0
    node.publishTaskSeq = 0
    node.feedSubscribers = []
    node.feedSubscriberCount = 0
    node.liveStreamKeys = []
    node.liveStreamCount = 0
    node.lanGroups = []
    node.lanGroupCount = 0
    node.rwadServicePeerId = ""
    node.rwadServiceNamespace = rwadDefaultNamespace

fn nodeIndex(handle: int64): int32 =
    if handle <= 1:
        return -1
    let idx: int32 = int32(handle - 2)
    if idx < 0 || idx >= maxNodes:
        return -1
    return idx

fn nodePtrAt(index: int32): NodeRuntime* =
    if index == 0:
        return gNodePtr0
    if index == 1:
        return gNodePtr1
    if index == 2:
        return gNodePtr2
    if index == 3:
        return gNodePtr3
    if index == 4:
        return gNodePtr4
    if index == 5:
        return gNodePtr5
    if index == 6:
        return gNodePtr6
    if index == 7:
        return gNodePtr7
    return nil

fn setNodePtrAt(index: int32, node: NodeRuntime*) =
    if index == 0:
        gNodePtr0 = node
        return
    if index == 1:
        gNodePtr1 = node
        return
    if index == 2:
        gNodePtr2 = node
        return
    if index == 3:
        gNodePtr3 = node
        return
    if index == 4:
        gNodePtr4 = node
        return
    if index == 5:
        gNodePtr5 = node
        return
    if index == 6:
        gNodePtr6 = node
        return
    if index == 7:
        gNodePtr7 = node
        return

fn staticNodePtrAt(index: int32): NodeRuntime* =
    if index < 0 || index >= maxNodes:
        return nil
    if index == 0:
        return &gNode0
    if index == 1:
        return &gNode1
    if index == 2:
        return &gNode2
    if index == 3:
        return &gNode3
    if index == 4:
        return &gNode4
    if index == 5:
        return &gNode5
    if index == 6:
        return &gNode6
    if index == 7:
        return &gNode7
    return nil

fn ensureNodePtrAt(index: int32): NodeRuntime* =
    debugNodeStep(joinText(["[ffi] ensureNodePtrAt: index=", Int64ToStr(int64(index))]))
    let existing: NodeRuntime* = nodePtrAt(index)
    if existing != nil:
        debugNodeStep("[ffi] ensureNodePtrAt: hit")
        return existing
    if index < 0 || index >= maxNodes:
        debugNodeStep("[ffi] ensureNodePtrAt: index invalid")
        return nil
    let created: NodeRuntime* = staticNodePtrAt(index)
    if created == nil:
        debugNodeStep("[ffi] ensureNodePtrAt: static ptr missing")
        return nil
    markNodeUnused(created)
    setNodePtrAt(index, created)
    return created

fn switchPtrAt(index: int32): switch.Switch* =
    if index < 0 || index >= maxNodes:
        return nil
    return nodePtrAt(index)

fn switchUsed(index: int32): bool =
    if index == 0:
