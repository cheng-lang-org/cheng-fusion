@exportc("social_synccast_join")
fn social_synccast_join(handle: int64, roomIdPtr: void*, peerIdPtr: void*): bool =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return false
    let roomId: str = trimText(voidPtrText(roomIdPtr))
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    let topicText: str = "synccast/" + roomId
    let topicTextPtr: cstring = dupCString(strings.CloneStr(topicText))
    let subHandle: void* = libp2p_pubsub_subscribe(handle, void*(topicTextPtr), nil, nil)
    c_free(topicTextPtr)
    if subHandle == nil:
        return false
    if len(peerIdText) > 0:
        if !socialSendEnvelope(handle, strings.CloneStr(peerIdText), "synccast.join", "{\"roomId\":" + toJsonStringValue(strings.CloneStr(roomId)) + "}"):
            return false
    emitSocialEvent(node, "synccast", "join", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + "}", "", roomId, "")
    return true

