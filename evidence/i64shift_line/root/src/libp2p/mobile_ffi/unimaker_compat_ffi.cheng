@exportc("social_groups_create")
fn social_groups_create(handle: int64, groupMetaJsonPtr: void*): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"ok\":false,\"error\":\"node_not_initialized\"}")
    let groupId: str = "group-" + $nextSeq()
    let metaJson: str = trimText(voidPtrText(groupMetaJsonPtr))
    let publishPayload: str = "{\"type\":\"group.create\",\"groupId\":" + toJsonStringValue(strings.CloneStr(groupId)) + ",\"meta\":" + normalizeJsonPayload(metaJson) + "}"
    let publishPayloadPtr: cstring = dupCString(strings.CloneStr(publishPayload))
    let createOk: bool = libp2p_feed_publish_entry(handle, void*(publishPayloadPtr))
    c_free(publishPayloadPtr)
    if !createOk:
        return dupCString("{\"ok\":false,\"error\":\"group_create_publish_failed\"}")
    emitSocialEvent(node, "groups", "create", JsonOrEmptyObject(metaJson), "", groupId, "")
    return dupCString("{\"ok\":true,\"groupId\":" + toJsonStringValue(strings.CloneStr(groupId)) + "}")

