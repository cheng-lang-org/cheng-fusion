fn joinText(parts: str[]): str =
    let n: int32 = len(parts)
    if n <= 0:
        return ""
    return strutil.Join(parts, "")

# r.err.msg is uniform across all Result[T] instantiations; the cold compiler
# cannot track managed field roots through generic T, so callers inline the
# access directly instead of going through a generic wrapper.

@borrows
fn um_newHostWithAddressText(text: str): bool =
    if len(text) <= 0:
        setLastError("newHostWithAddressText: empty listen address")
        return false
    gossipsub.setGossipsubConfig(gossipsub.initGossipsubConfig())
    gossipsub.enableGossipsubContext()
    feedservice.setFeedConfig(feedservice.initFeedConfig())
    return true

@borrows
fn um_newHostWithAddressTextSlim(text: str): bool =
    return um_newHostWithAddressText(text)

@borrows
fn applyHostIdentityDirect(swPtr: switch.Switch*, listenAddrText: str, peerIdText: str) =
    if swPtr == nil:
        return
    let normalizedListen: str = trimText(listenAddrText)
    if len(normalizedListen) > 0:
        let _ = c_um_host_set_listen_addr_direct(swPtr, cStr(normalizedListen))
    let normalizedPeerId: str = trimText(peerIdText)
    if !isStubPeerId(normalizedPeerId):
        let _ = c_um_host_set_peer_id_direct(swPtr, cStr(normalizedPeerId))

@borrows
fn um_hostGossipsubSubscribe(topic: str): bool =
    let subscribeRes: Result[bool] = gossipsub.gossipsubSubscribe(topic)
    if IsErr(subscribeRes):
        return false
    return Value(subscribeRes)

@borrows
fn um_hostGossipsubUnsubscribe(topic: str): bool =
    let unsubscribeRes: Result[bool] = gossipsub.gossipsubUnsubscribe(topic)
    if IsErr(unsubscribeRes):
        return false
    return Value(unsubscribeRes)

