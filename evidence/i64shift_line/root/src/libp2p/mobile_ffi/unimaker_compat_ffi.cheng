@borrows
fn debugNodeStep(msg: str) =
    let _ = c_cheng_debug_log(cStr(msg))

fn failWith(msg: str): bool =
    setLastError(msg)
    return false

fn isWhitespace(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn trimText(text: str): str =
    if isNullText(text):
        return ""
    let n: int32 = len(text)
    if n <= 0:
        return ""
    var left: int32
    var right: int32 = n
    while left < right && isWhitespace(text[left]):
        left = left + 1
    while right > left && isWhitespace(text[right - 1]):
        right = right - 1
    if right <= left:
        return ""
    return SliceBytes(text, left, right - left)

@borrows
fn ownText(text: str): str =
    return strings.CloneStr(text)

@borrows
fn strLowerAscii(text: str): str =
    if isNullText(text):
        return ""
    let n: int32 = len(text)
    if n <= 0:
        return ""
    var out: str
    var i: int32
    while i < n:
        let ch: char = text[i]
        if ch >= 'A' && ch <= 'Z':
            out = out + charToStr(chr(ord(ch) + 32))
        else:
            out = out + charToStr(ch)
        i = i + 1
    return out

@borrows
fn startsWith(text: str, prefix: str): bool =
    if isNullText(text) || isNullText(prefix):
        return false
    let n: int32 = len(text)
    let m: int32 = len(prefix)
    if m <= 0:
        return true
    if n < m:
        return false
    var i: int32
    while i < m:
        if text[i] != prefix[i]:
            return false
        i = i + 1
    return true

@borrows
fn indexOf(text: str, needle: str, start: int32): int32 =
    if isNullText(text) || isNullText(needle):
        return -1
    let n: int32 = len(text)
    let m: int32 = len(needle)
    if m <= 0:
        if start < 0:
            return 0
        if start > n:
            return n
        return start
    if n < m:
        return -1
    var i: int32
    if start >= 0:
        i = start
    let last: int32 = n - m
    while i <= last:
        var ok: bool = true
        var j: int32
        while j < m:
            if text[i + j] != needle[j]:
                ok = false
                break
            j = j + 1
        if ok:
            return i
        i = i + 1
    return -1

@borrows
fn indexOfChar(text: str, ch: char, start: int32): int32 =
    if isNullText(text):
        return -1
    let n: int32 = len(text)
    var i: int32
    if start >= 0:
        i = start
    while i < n:
        if text[i] == ch:
            return i
        i = i + 1
    return -1

@borrows
fn replaceFirst(text: str, needle: str, replacement: str): str =
    let idx: int32 = indexOf(text, needle, 0)
    if idx < 0:
        return strings.CloneStr(text)
    var out: str
    var i: int32
    while i < idx:
        out = out + charToStr(text[i])
        i = i + 1
    out = out + strings.CloneStr(replacement)
    i = idx + len(needle)
    let n: int32 = len(text)
    while i < n:
        out = out + charToStr(text[i])
        i = i + 1
    return out

@borrows
fn jsonEscape(text: str): str =
    if isNullText(text):
        return ""
    let n: int32 = len(text)
    if n <= 0:
        return ""
    var out: str
    var i: int32
    while i < n:
        let ch: char = text[i]
        if ch == '"':
            out = out + "\\\""
        elif ch == '\\':
            out = out + "\\\\"
        elif ch == '\n':
            out = out + "\\n"
        elif ch == '\r':
            out = out + "\\r"
        elif ch == '\t':
            out = out + "\\t"
        else:
            out = out + charToStr(ch)
        i = i + 1
    return out

@borrows
fn toJsonStringValue(text: str): str =
    return joinText(["\"", jsonEscape(text), "\""])

@borrows
fn normalizeJsonPayload(payload: str): str =
    let trimmed: str = trimText(payload)
    if len(trimmed) <= 0:
        return "null"
    let first: char = trimmed[0]
    let last: char = trimmed[len(trimmed) - 1]
    if (first == '{' && last == '}') || (first == '[' && last == ']'):
        return strings.CloneStr(trimmed)
    return toJsonStringValue(strings.CloneStr(trimmed))

@borrows
fn isJsonObjectPayload(payload: str): bool =
    let trimmed: str = trimText(payload)
    if len(trimmed) < 2:
        return false
    return trimmed[0] == '{' && trimmed[len(trimmed) - 1] == '}'

fn queueClear(queue: var EventQueue) =
    queue.itemsText = ""
    queue.count = 0

@borrows
fn queueNextSeparator(text: str, start: int32): int32 =
    let total: int32 = len(text)
    var i: int32 = start
    while i < total:
        if SliceBytes(text, i, 1) == eventQueueSeparator:
            return i
        i = i + 1
    return -1

fn queueDropFirst(queue: var EventQueue) =
    if queue.count <= 1:
        queueClear(queue)
        return
    let sep: int32 = queueNextSeparator(queue.itemsText, 0)
    if sep < 0:
        queueClear(queue)
        return
    let nextStart: int32 = sep + 1
    queue.itemsText = SliceBytes(queue.itemsText, nextStart, len(queue.itemsText) - nextStart)
    queue.count = queue.count - 1

fn queuePush(queue: var EventQueue, eventJson: str) =
    let trimmed: str = trimText(eventJson)
    if len(trimmed) <= 0:
        return
    var normalized: str = strings.CloneStr(trimmed)
    if len(normalized) > maxEventJsonBytes:
        normalized = "{\"topic\":\"bridge.backpressure\",\"payload\":{\"reason\":\"event_too_large\"}}"
    if maxEvents <= 0:
        queueClear(queue)
        return
    if queue.count >= maxEvents:
        queueDropFirst(queue)
    if queue.count <= 0 || len(queue.itemsText) <= 0:
        queue.itemsText = normalized
    else:
        queue.itemsText = joinText([strings.CloneStr(queue.itemsText), eventQueueSeparator, strings.CloneStr(normalized)])
    queue.count = queue.count + 1

fn queueDrain(queue: var EventQueue, maxOut: int32): str =
    if queue.count <= 0 || len(queue.itemsText) <= 0:
        queueClear(queue)
        return "[]"
    var take: int32 = maxOut
    if take <= 0 || take > queue.count:
        take = queue.count
    let source: str = strings.CloneStr(queue.itemsText)
    var out: str = "["
    var wrote: bool
    var offset: int32
    var i: int32
    while i < take && offset < len(source):
        let sep: int32 = queueNextSeparator(source, offset)
        let endPos: int32 = if sep >= 0: sep else: len(source)
        let item: str = strings.CloneStr(SliceBytes(source, offset, endPos - offset))
        if len(item) > 0:
            if wrote:
                out = joinText([strings.CloneStr(out), ","])
            out = joinText([strings.CloneStr(out), strings.CloneStr(item)])
            wrote = true
        if sep < 0:
            offset = len(source)
        else:
            offset = sep + 1
        i = i + 1
    out = joinText([strings.CloneStr(out), "]"])
    if take >= queue.count || offset >= len(source):
        queueClear(queue)
    else:
        queue.itemsText = strings.CloneStr(SliceBytes(source, offset, len(source) - offset))
        queue.count = queue.count - take
    return out

fn nodePtrIndex(node: NodeRuntime*): int32 =
    if node == nil:
        return -1
    if node == gNodePtr0 || node == &gNode0:
        return 0
    if node == gNodePtr1 || node == &gNode1:
        return 1
    if node == gNodePtr2 || node == &gNode2:
        return 2
    if node == gNodePtr3 || node == &gNode3:
        return 3
    if node == gNodePtr4 || node == &gNode4:
        return 4
    if node == gNodePtr5 || node == &gNode5:
        return 5
    if node == gNodePtr6 || node == &gNode6:
        return 6
    if node == gNodePtr7 || node == &gNode7:
        return 7
    return -1

fn FeedSubscriberCountAt(index: int32): int32 =
    if index == 0:
        return gNode0.feedSubscriberCount
    if index == 1:
        return gNode1.feedSubscriberCount
    if index == 2:
        return gNode2.feedSubscriberCount
    if index == 3:
        return gNode3.feedSubscriberCount
    if index == 4:
        return gNode4.feedSubscriberCount
    if index == 5:
        return gNode5.feedSubscriberCount
    if index == 6:
        return gNode6.feedSubscriberCount
    if index == 7:
        return gNode7.feedSubscriberCount
    return 0

fn FeedSubscriberAt(index: int32, subIdx: int32): str =
    if subIdx < 0:
        return ""
    if index == 0:
        if subIdx >= gNode0.feedSubscriberCount || subIdx >= len(gNode0.feedSubscribers):
            return ""
        return strings.CloneStr(gNode0.feedSubscribers[subIdx])
    if index == 1:
        if subIdx >= gNode1.feedSubscriberCount || subIdx >= len(gNode1.feedSubscribers):
            return ""
        return strings.CloneStr(gNode1.feedSubscribers[subIdx])
    if index == 2:
        if subIdx >= gNode2.feedSubscriberCount || subIdx >= len(gNode2.feedSubscribers):
            return ""
        return strings.CloneStr(gNode2.feedSubscribers[subIdx])
    if index == 3:
        if subIdx >= gNode3.feedSubscriberCount || subIdx >= len(gNode3.feedSubscribers):
            return ""
        return strings.CloneStr(gNode3.feedSubscribers[subIdx])
    if index == 4:
        if subIdx >= gNode4.feedSubscriberCount || subIdx >= len(gNode4.feedSubscribers):
            return ""
        return strings.CloneStr(gNode4.feedSubscribers[subIdx])
    if index == 5:
        if subIdx >= gNode5.feedSubscriberCount || subIdx >= len(gNode5.feedSubscribers):
            return ""
        return strings.CloneStr(gNode5.feedSubscribers[subIdx])
    if index == 6:
        if subIdx >= gNode6.feedSubscriberCount || subIdx >= len(gNode6.feedSubscribers):
            return ""
        return strings.CloneStr(gNode6.feedSubscribers[subIdx])
    if index == 7:
        if subIdx >= gNode7.feedSubscriberCount || subIdx >= len(gNode7.feedSubscribers):
            return ""
        return strings.CloneStr(gNode7.feedSubscribers[subIdx])
    return ""


