@borrows
fn slimMdnsAdvertise(service: str, namespace: str): bool =
    if len(service) <= 0:
        return false
    add(gSlimMdnsServices, strings.CloneStr(service))
    add(gSlimMdnsNamespaces, strings.CloneStr(namespace))
    return true

@borrows
fn slimMdnsDiscover(service: str, namespace: str, limit: int32): int32 =
    var count: int32
    var i: int32
    let n: int32 = len(gSlimMdnsServices)
    let nsCount: int32 = len(gSlimMdnsNamespaces)
    while i < n && i < nsCount:
        if gSlimMdnsServices[i] == service && gSlimMdnsNamespaces[i] == namespace:
            count = count + 1
            if limit > 0 && count >= limit:
                return count
        i = i + 1
    return count

@borrows
fn um_hostMdnsAdvertiseIndex(swIdx: int32, service: str, namespace: str): bool =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        debugNodeStep("[ffi] mdns_advertise_err invalid_switch")
        return false
    if !slimMdnsAdvertise(service, namespace):
        debugNodeStep("[ffi] mdns_advertise_err empty_service")
        return false
    debugNodeStep(joinText(["[ffi] mdns_advertise_ok service=", strings.CloneStr(service), " namespace=", strings.CloneStr(namespace)]))
    return true

@borrows
fn um_hostMdnsDiscoverIndex(swIdx: int32, service: str, namespace: str, limit: int32): int32 =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        debugNodeStep("[ffi] mdns_discover_err invalid_switch")
        return -1
    let rawCount: int32 = slimMdnsDiscover(service, namespace, limit)
    let safeCount: int32 =
        if rawCount <= 0 || rawCount > maxMdnsDiscoverCount:
            0
        else:
            rawCount
    return safeCount

@borrows
fn um_hostBleAdvertiseIndex(swIdx: int32, service: str, namespace: str): bool =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        debugNodeStep("[ffi] ble_advertise_err invalid_switch")
        return false
    service
    namespace
    debugNodeStep("[ffi] ble_advertise_err slim_no_ble")
    return false

@borrows
fn um_hostBleDiscoverIndex(swIdx: int32, service: str, namespace: str, limit: int32): int32 =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        debugNodeStep("[ffi] ble_discover_err invalid_switch")
        return -1
    service
    namespace
    limit
    debugNodeStep("[ffi] ble_discover_err slim_no_ble")
    return -1

@borrows
fn um_hostGossipsubPublishIndex(swIdx: int32, topic: str, data: Bytes): bool =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        return false
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        return false
    var publishRes: Result[bool] = gossipsub.gossipsubPublishSlim(strings.CloneStr(topic), data)
    if IsErr(publishRes):
        return false
    return Value(publishRes)

@borrows
fn um_hostDumpPeersLimitIndex(swIdx: int32, limit: int32): str =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        return "{\"peers\":[],\"totalCount\":0}"
    if limit <= 0:
        return "{\"peers\":[],\"totalCount\":0}"
    if switchPtrAt(swIdx) == nil:
        return "{\"peers\":[],\"totalCount\":0}"
    return "{\"peers\":[],\"totalCount\":0}"

