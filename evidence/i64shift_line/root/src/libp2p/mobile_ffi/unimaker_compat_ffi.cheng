@exportc("libp2p_send_dm_payload_cstr")
fn libp2p_send_dm_payload_cstr(handle: int64, peerIdPtr: void*, payloadPtr: void*, payloadLen: int64): bool =
    if payloadPtr == nil || payloadLen <= 0:
        return false
    let payloadText: str = voidPtrText(payloadPtr)
    let payloadJson: str = "{\"type\":\"dm.payload\",\"size\":" + $payloadLen + ",\"body\":" + toJsonStringValue(strings.CloneStr(payloadText)) + "}"
    let payloadJsonPtr: cstring = dupCString(strings.CloneStr(payloadJson))
    let ok: bool = libp2p_send_with_ack(handle, peerIdPtr, void*(payloadJsonPtr), 8000)
    c_free(payloadJsonPtr)
    return ok

