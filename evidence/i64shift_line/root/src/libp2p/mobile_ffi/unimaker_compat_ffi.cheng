@exportc("libp2p_feed_subscribe_peer")
fn libp2p_feed_subscribe_peer(handle: int64, peerIdPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("feed_subscribe_peer: invalid handle")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        return failWith("feed_subscribe_peer: missing peerId")
    # Detached handles are used by smoke for request-path probing only.
    # Keep this path side-effect free to avoid unstable detached state mutation.
    if idx > 0:
        return true
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return failWith("feed_subscribe_peer: switch missing")
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        return failWith("feed_subscribe_peer: switch ptr missing")
    if !callHostDialPeerPtr(node, peerIdText):
        return failWith("feed_subscribe_peer: dial failed")
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    var knownPeerIdx: int32 = -1
    let peerTotal: int32 = safePeerCountPtr(node)
    var peerScan: int32
    while peerScan < peerTotal:
        let row: str = peerRowAtPtr(node, peerScan)
        if peerRowUsed(row) && peerRowPeerId(row) == target:
            knownPeerIdx = peerScan
            break
        peerScan = peerScan + 1
    let probe: Bytes = BytesFromString("feed-subscribe:" + peerIdText)
    if !um_hostPingPeerWithPayloadTextIndex(swIdx, peerIdText, probe):
        if knownPeerIdx >= 0:
            setPeerConnectedPtr(node, peerIdText, true)
    if knownPeerIdx >= 0:
        let knownAddr: str = primaryAddressForPeerPtr(node, peerIdText)
        if len(knownAddr) > 0:
            addPeerAddressPtr(node, peerIdText, knownAddr, sourceWan)
    let ok: bool = addFeedSubscriberPtr(node, peerIdText)
    if ok:
        emitNodeEvent(node, "feed.subscribe", "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + "}")
    return ok

@exportc("libp2p_feed_unsubscribe_peer")
fn libp2p_feed_unsubscribe_peer(handle: int64, peerIdPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("feed_unsubscribe_peer: invalid handle")
    let peerIdText: str = trimText(voidPtrText(peerIdPtr))
    if len(peerIdText) <= 0:
        return failWith("feed_unsubscribe_peer: missing peerId")
    if idx > 0:
        return true
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return failWith("feed_unsubscribe_peer: switch missing")
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        return failWith("feed_unsubscribe_peer: switch ptr missing")
    let target: str = canonicalPeerIdOrEmpty(peerIdText)
    var knownPeerIdx: int32 = -1
    let peerTotal: int32 = safePeerCountPtr(node)
    var peerScan: int32
    while peerScan < peerTotal:
        let row: str = peerRowAtPtr(node, peerScan)
        if peerRowUsed(row) && peerRowPeerId(row) == target:
            knownPeerIdx = peerScan
            break
        peerScan = peerScan + 1
    let probe: Bytes = BytesFromString("feed-unsubscribe:" + peerIdText)
    if !um_hostPingPeerWithPayloadTextIndex(swIdx, peerIdText, probe):
        if knownPeerIdx >= 0:
            setPeerConnectedPtr(node, peerIdText, true)
    let removed: bool = removeFeedSubscriberPtr(node, peerIdText)
    let removedText: str = if removed: "true" else: "false"
    emitNodeEvent(
        node,
        "feed.unsubscribe",
        "{\"peerId\":" + toJsonStringValue(strings.CloneStr(peerIdText)) + ",\"removed\":" + removedText + "}"
    )
    # Keep unsubscribe idempotent for cross-node retries.
    return true

@exportc("libp2p_feed_publish_entry")
fn libp2p_feed_publish_entry(handle: int64, payloadJsonPtr: void*): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return failWith("feed_publish_entry: invalid handle")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx < 0:
        return failWith("feed_publish_entry: switch missing")
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        return failWith("feed_publish_entry: switch ptr missing")
    let payloadJson: str = trimText(voidPtrText(payloadJsonPtr))
    if len(payloadJson) <= 0:
        return failWith("feed_publish_entry: empty payload")
    let dedupContentId: str = feedEntryContentIdOrEmpty(payloadJson)
    if len(dedupContentId) > 0 && findFeedEntryByContentIdPtr(node, strings.CloneStr(dedupContentId)):
        # Cross-channel dual delivery (e.g. ingress SSE and gossipsub both
        # carrying the same content id) is expected, not an error: skip the
        # duplicate store/forward and report the already-delivered success.
        return true
    storeFeedEntryLocalPtr(node, strings.CloneStr(payloadJson))
    var subIdx: int32
    var sentCount: int32
    let subCount: int32 = FeedSubscriberCountAt(nodePtrIndex(node))
    while subIdx < subCount:
        let targetPeer: str = FeedSubscriberAt(nodePtrIndex(node), subIdx)
        if callHostDialPeerPtr(node, strings.CloneStr(targetPeer)):
            let probeText: str = strings.CloneStr(payloadJson)
            let probe: Bytes = BytesFromString(probeText)
            if um_hostPingPeerWithPayloadTextIndex(swIdx, strings.CloneStr(targetPeer), probe):
                sentCount = sentCount + 1
                setPeerConnectedPtr(node, strings.CloneStr(targetPeer), true)
        subIdx = subIdx + 1
    emitNodeEvent(node, "feed.publish", "{\"payload\":" + normalizeJsonPayload(payloadJson) + ",\"delivered\":" + $sentCount + "}")
    return true

@exportc("libp2p_sync_peerstore_state")
fn libp2p_sync_peerstore_state(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"connected_peers\":[],\"total_count\":0}")
    syncPeerstoreIntoNodePtr(node, sourceDht | sourceWan)
    let payload: str = "{\"connected_peers\":" + connectedPeersJsonPtr(node) + ",\"total_count\":" + $safePeerCountPtr(node) + "}"
    return dupCString(strings.CloneStr(payload))

@exportc("libp2p_load_stored_peers")
fn libp2p_load_stored_peers(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("{\"peers\":[],\"totalCount\":0}")
    let swIdx: int32 = nodeSwitchIndexPtr(node)
    if swIdx >= 0:
        let swPtr: switch.Switch* = switchPtrAt(swIdx)
        if swPtr != nil:
            let dumped: str = trimText(um_hostDumpPeersLimitIndex(swIdx, 256))
            if isJsonObjectText(dumped):
                return dupCString(strings.CloneStr(dumped))
            if isJsonArrayText(dumped):
                return dupCString("{\"peers\":" + strings.CloneStr(dumped) + ",\"totalCount\":0}")
    return dupCString("{\"peers\":[],\"totalCount\":0}")

@exportc("libp2p_get_lan_endpoints_json")
fn libp2p_get_lan_endpoints_json(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    let node: NodeRuntime* = if idx >= 0: nodePtrAt(idx) else: nil
    if idx < 0 || node == nil || !(node->used):
        return dupCString("[]")
    # Keep this path crash-safe for smoke/bootstrap phases.
    return dupCString("[]")

