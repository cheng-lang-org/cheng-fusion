        return
    if index == 5:
        gSwitch5 = sw
        return
    if index == 6:
        gSwitch6 = sw
        return
    if index == 7:
        gSwitch7 = sw
        return

fn startMemoryOrTcpOnSwitch(sw: var switch.Switch, addrText: str): bool =
    if switch.switchAddressIsMemory(addrText):
        memorytransport.startRaw(sw.listener.memory, addrText)
        sw.started = true
        return true
    if switch.switchAddressIsTcp(addrText):
        tcptransport.startRaw(sw.listener.tcp, addrText)
        sw.started = true
        return true
    return false

fn dialMemoryOrTcpOnSwitch(sw: var switch.Switch, addrText: str): Result[bool] =
    if switch.switchAddressIsMemory(addrText):
        return memorytransport.dialRawOk(sw.listener.memory, addrText)
    if switch.switchAddressIsTcp(addrText):
        return tcptransport.dialRawOk(sw.listener.tcp, addrText)
    return Err[bool]("slim dial only memory/tcp")

@borrows
fn um_hostStartIndex(swIdx: int32): bool =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        setLastError("hostStart: invalid switch index")
        return false
    if switchPtrAt(swIdx) == nil:
        setLastError("hostStart: switch ptr missing")
        return false
    return true

@borrows
fn um_hostStopIndex(swIdx: int32) =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        return
    if switchPtrAt(swIdx) == nil:
        return

@borrows
fn um_hostDialTextIndex(swIdx: int32, addrText: str): bool =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        setLastError("hostDialText: invalid switch index")
        return false
    if switchPtrAt(swIdx) == nil:
        setLastError("hostDialText: switch ptr missing")
        return false
    addrText
    setLastError("hostDialText: slim dial uses host address book")
    return false

@borrows
fn um_hostDialPeerTextIndex(swIdx: int32, peerText: str): bool =
    if swIdx < 0 || swIdx >= maxNodes || !switchUsed(swIdx):
        setLastError("hostDialPeerText: invalid switch index")
        return false
    let swPtr: switch.Switch* = switchPtrAt(swIdx)
    if swPtr == nil:
        setLastError("hostDialPeerText: switch ptr missing")
        return false
    peerText
    swPtr
    setLastError("hostDialPeerText: slim dial peer needs address")
    return false

@borrows
fn um_hostListenAddrTextIndex(swIdx: int32): str =
