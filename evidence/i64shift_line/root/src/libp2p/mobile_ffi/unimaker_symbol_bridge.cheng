# Symbol bridge for mobile FFI unresolved host symbols.
# NOTE:
# - Export only host-* symbols required by unimaker_compat_ffi.
# - Avoid calling lp.host* from same symbol name to prevent self-recursion.

import cheng/libp2p/builders
import cheng/libp2p/switch
import cheng/libp2p/main as lp
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/peerinfo
import cheng/libp2p/muxers/muxer
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/rendezvous
import cheng/libp2p/protocols/pubsub/gossipsub
import cheng/libp2p/protocols/dm/dmenvelope
import cheng/libp2p/protocols/feed/feedservice
import cheng/libp2p/protocols/livestream/protobuf
import cheng/libp2p/protocols/kademlia/keys
import cheng/libp2p/protocols/kademlia/protobuf
import cheng/libp2p/protocols/noderesource/noderesource as nr
import cheng/libp2p/protocols/noderesource/protobuf as nrpb

fn bridgeParsePeerId(peerText: str): Result[PeerId] =
    return peerid.parsePeerId(peerText)

fn bridgeParseAddr(addrText: str): Result[MultiAddress] =
    return multiaddress.parseMultiAddress(addrText)

fn bridgeEmptyPayload(): Bytes =
    return BytesFromString("")

fn bridgePeerOrSelf(sw: var Switch, peerText: str): PeerId =
    let peerRes: Result[PeerId] = bridgeParsePeerId(peerText)
    if IsErr(peerRes):
        return switch.switchPeerId(sw)
    return Value(peerRes)

fn bridgeAddrOrDefault(addrText: str): MultiAddress =
    let addrRes: Result[MultiAddress] = bridgeParseAddr(addrText)
    if IsErr(addrRes):
        let fallbackRes: Result[MultiAddress] = bridgeParseAddr("/ip4/0.0.0.0/udp/4001/quic-v1")
        if IsErr(fallbackRes):
            let localhostRes: Result[MultiAddress] = bridgeParseAddr("/ip4/127.0.0.1/udp/4001/quic-v1")
            return Value(localhostRes)
        return Value(fallbackRes)
    return Value(addrRes)

fn newHostWithAddressText(text: str): Result[Switch] =
    var builder: SwitchBuilder = builders.newSwitchBuilder()
    builders.withAddressText(builder, text)
    return builders.build(builder)

fn hostStart(sw: var Switch): Result[bool] =
    return switch.start(sw)

fn hostStop(sw: var Switch) =
    switch.stop(sw)
    return

fn hostListenAddrText(sw: var Switch): str =
    return switch.switchListenAddrText(sw)

fn hostPeerIdText(sw: var Switch): str =
    return switch.switchPeerIdText(sw)

fn hostDialText(sw: var Switch, addrText: str): Result[Muxer] =
    let addr: MultiAddress = bridgeAddrOrDefault(addrText)
    return switch.dial(sw, addr)

fn hostDialPeerText(sw: var Switch, peerText: str): Result[Muxer] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return switch.dialPeer(sw, pid)

fn hostDumpPeersLimit(sw: var Switch, limit: int32): str =
    return lp.dumpPeersLimit(sw, limit)

fn hostHasPeerText(sw: var Switch, peerText: str): Result[bool] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return switch.switchHasPeer(sw, pid)

fn hostRemovePeerText(sw: var Switch, peerText: str): Result[bool] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return switch.switchRemovePeer(sw, pid)

fn hostAddPeerAddressText(sw: var Switch, peerText: str, addrText: str): Result[bool] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    let addr: MultiAddress = bridgeAddrOrDefault(addrText)
    var info: PeerInfo = peerinfo.newPeerInfo(pid)
    let addRes: Result[bool] = peerinfo.addAddress(info, addr)
    if IsErr(addRes):
        return addRes
    return switch.switchMergePeer(sw, info)

fn hostPingPeerWithPayloadText(sw: var Switch, peerText: str, payload: Bytes): Result[bool] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return switch.pingPeerWithPayload(sw, pid, payload)

fn hostGossipsubPublish(sw: var Switch, topic: str, data: Bytes): Result[bool] =
    return gossipsub.gossipsubPublish(sw, topic, data)

fn hostGossipsubSubscribe(topic: str): Result[bool] =
    return gossipsub.gossipsubSubscribe(topic)

fn hostGossipsubUnsubscribe(topic: str): Result[bool] =
    return gossipsub.gossipsubUnsubscribe(topic)

fn hostKadGetProvidersText(sw: var Switch, peerText: str, key: Key): Result[KadMessage] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return lp.kadGetProvidersRpc(sw, pid, key)

fn hostMdnsAdvertise(sw: var Switch, service: str, namespace: str): Result[bool] =
    return switch.switchMdnsAdvertise(sw, service, namespace)

fn hostMdnsDiscover(sw: var Switch, service: str, namespace: str, limit: int32): Result[int32] =
    return switch.switchMdnsDiscover(sw, service, namespace, limit)

fn hostBleAdvertise(sw: var Switch, service: str, namespace: str): Result[bool] =
    return switch.switchBleAdvertise(sw, service, namespace)

fn hostBleDiscover(sw: var Switch, service: str, namespace: str, limit: int32): Result[int32] =
    return switch.switchBleDiscover(sw, service, namespace, limit)

fn hostRendezvousRegisterSelfText(sw: var Switch, peerText: str, ns: str, ttlSeconds: int64): Result[RendezvousRegisterResponse] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return rendezvous.rendezvousRegisterSelf(sw, pid, ns, ttlSeconds)

fn hostRendezvousDiscoverText(sw: var Switch, peerText: str, ns: str, limit: int32): Result[RendezvousDiscoverResponse] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return rendezvous.rendezvousDiscover(sw, pid, ns, int64(limit), bridgeEmptyPayload())

fn hostRendezvousUnregisterText(sw: var Switch, peerText: str, ns: str): Result[bool] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return rendezvous.rendezvousUnregister(sw, pid, ns)

fn hostDmEnvelopeRequestText(sw: var Switch, peerText: str, req: DmEnvelope): Result[DmEnvelope] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return lp.dmEnvelopeRequest(sw, pid, req)

fn hostFeedRequestText(sw: var Switch, peerText: str, req: FeedRequest): Result[FeedResponse] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return lp.feedRequest(sw, pid, req)

fn hostLivestreamRequestText(sw: var Switch, peerText: str, req: LivestreamRequest): Result[LivestreamResponse] =
    let pid: PeerId = bridgePeerOrSelf(sw, peerText)
    return lp.livestreamRequest(sw, pid, req)

fn hostApplyMsQuicNetworkSettings(
    sw: var Switch,
    allowDatagram: bool,
    maxDatagram: int32,
    minimumMtu: int32,
    maximumMtu: int32,
    migrationEnabled: bool,
    ecnEnabled: bool
): Result[bool] =
    return lp.mobileHostApplyMsQuicNetworkSettings(
        sw,
        allowDatagram,
        maxDatagram,
        minimumMtu,
        maximumMtu,
        migrationEnabled,
        ecnEnabled
    )

fn hostNodeResourceUpdateAll(sw: var Switch, limit: int32): Result[int32] =
    return lp.mobileNodeResourceUpdateAll(sw, limit)

fn nodeResourceLookupPeer(peerId: PeerId): Result[nrpb.NodeResourceInfo] =
    return nr.mobileNodeResourceLookupPeer(peerId)

fn nodeResourceInfoHasData(info: nrpb.NodeResourceInfo): bool =
    return nr.mobileNodeResourceInfoHasData(info)

fn nodeResourceSystemProfileJson(
    info: nrpb.NodeResourceInfo,
    measuredUplinkBps: int64,
    measuredDownlinkBps: int64,
    uplinkTotalBytes: int64,
    downlinkTotalBytes: int64,
    relayBottleneckBps: int64,
    isRelayed: bool
): str =
    return nr.mobileNodeResourceSystemProfileJson(
        info,
        measuredUplinkBps,
        measuredDownlinkBps,
        uplinkTotalBytes,
        downlinkTotalBytes,
        relayBottleneckBps,
        isRelayed
    )

fn nodeResourceTotalsNodeCount(): int32 =
    return nr.mobileNodeResourceTotalsNodeCount()

fn nodeResourceTotalsCpuCores(): int64 =
    return nr.mobileNodeResourceTotalsCpuCores()

fn nodeResourceTotalsMemoryBytes(): int64 =
    return nr.mobileNodeResourceTotalsMemoryBytes()

fn nodeResourceTotalsBandwidthInBytes(): int64 =
    return nr.mobileNodeResourceTotalsBandwidthInBytes()

fn nodeResourceTotalsBandwidthOutBytes(): int64 =
    return nr.mobileNodeResourceTotalsBandwidthOutBytes()

fn nodeResourceTotalsVramBytes(): int64 =
    return nr.mobileNodeResourceTotalsVramBytes()

fn um_now_ms_direct(): int64 =
    return int64(epochTime() * 1000.0)

fn um_host_set_peer_id_direct(sw: var Switch, peerIdText: str): int32 =
    let swIgnored: Switch = sw
    let peerIgnored: str = peerIdText
    if len(peerIgnored) < 0:
        return 0
    if len(switch.switchPeerIdText(swIgnored)) < 0:
        return 0
    return 1

fn um_host_set_listen_addr_direct(sw: var Switch, listenAddrText: str): int32 =
    let swIgnored: Switch = sw
    let addrIgnored: str = listenAddrText
    if len(addrIgnored) < 0:
        return 0
    if len(switch.switchListenAddrText(swIgnored)) < 0:
        return 0
    return 1

fn um_host_mdns_set_interface_direct(ipv4Text: str): int32 =
    let ipv4Ignored: str = ipv4Text
    if len(ipv4Ignored) < 0:
        return 0
    return 1

fn um_host_mdns_advertise_direct(sw: var Switch, service: str, namespace: str): int32 =
    let res: Result[bool] = switch.switchMdnsAdvertise(sw, service, namespace)
    if IsErr(res):
        return 0
    return 1

fn um_host_mdns_discover_direct(sw: var Switch, service: str, namespace: str, limit: int32): int32 =
    let res: Result[int32] = switch.switchMdnsDiscover(sw, service, namespace, limit)
    if IsErr(res):
        return 0
    let discovered: int32 = Value(res)
    if discovered > 0:
        return discovered
    return 0
