# Production Android FFI slice for UniMaker local computer-use automation.
# P2P media/MoQ symbols are exported for ABI stability and return explicit
# unsupported/not-ready JSON instead of pretending that remote transfer works.

var
    stagedBlobPtr: ptr
    stagedBlobLen: int32
    stagedRequestWirePtr: ptr
    stagedRequestWireLen: int32

@importc("strdup")
fn c_strdup(s: cstring): cstring

fn cStr(text: str): cstring =
    return text

fn dupCString(text: str): cstring =
    return c_strdup(cStr(text))

@exportc("cheng_mobile_host_moq_set_request_path_bridge")
fn cheng_mobile_host_moq_set_request_path_bridge_export(pathText: cstring) =
    pathText

@exportc("cheng_mobile_host_moq_stage_bridge")
fn cheng_mobile_host_moq_stage_bridge_export(blobPtr: ptr,
                                             blobLen: int32,
                                             requestWirePtr: ptr,
                                             requestWireLen: int32) =
    stagedBlobPtr = blobPtr
    stagedBlobLen = blobLen
    stagedRequestWirePtr = requestWirePtr
    stagedRequestWireLen = requestWireLen

@exportc("cheng_mobile_host_moq_request_path_bridge")
fn cheng_mobile_host_moq_request_path_bridge_export(): ptr =
    return nil

@exportc("cheng_mobile_host_moq_blob_bridge")
fn cheng_mobile_host_moq_blob_bridge_export(): ptr =
    return stagedBlobPtr

@exportc("cheng_mobile_host_moq_blob_len_bridge")
fn cheng_mobile_host_moq_blob_len_bridge_export(): int32 =
    return stagedBlobLen

@exportc("cheng_mobile_host_moq_request_wire_bridge")
fn cheng_mobile_host_moq_request_wire_bridge_export(): ptr =
    return stagedRequestWirePtr

@exportc("cheng_mobile_host_moq_request_wire_len_bridge")
fn cheng_mobile_host_moq_request_wire_len_bridge_export(): int32 =
    return stagedRequestWireLen

@exportc("libp2p_fetch_file_providers")
fn libp2p_fetch_file_providers(handle: int64, keyPtr: cstring, limit: int32): cstring =
    handle
    keyPtr
    limit
    return dupCString("{\"providers\":[],\"count\":0,\"error\":\"unsupported_in_cheng_mobile_ffi\",\"feature\":\"fetch_file_providers\"}")

@exportc("libp2p_register_local_file_wire")
fn libp2p_register_local_file_wire(handle: int64, requestJsonPtr: cstring): cstring =
    handle
    requestJsonPtr
    return dupCString("{\"ok\":false,\"error\":\"unsupported_in_cheng_mobile_ffi\",\"feature\":\"register_local_file\"}")

@exportc("libp2p_moq_stream_open")
fn libp2p_moq_stream_open(handle: int64, requestJsonPtr: cstring): cstring =
    handle
    requestJsonPtr
    return dupCString("{\"ok\":false,\"error\":\"native_quic_moq_stream_handle_table_not_ready\",\"transport\":\"native_quic_moq_stream\"}")

@exportc("libp2p_moq_stream_read")
fn libp2p_moq_stream_read(handle: int64, streamIdPtr: cstring, maxBytes: int32): cstring =
    handle
    streamIdPtr
    maxBytes
    return dupCString("{\"ok\":false,\"error\":\"native_quic_moq_stream_handle_table_not_ready\",\"transport\":\"native_quic_moq_stream\"}")

@exportc("libp2p_moq_stream_close")
fn libp2p_moq_stream_close(handle: int64, streamIdPtr: cstring): cstring =
    handle
    streamIdPtr
    return dupCString("{\"ok\":false,\"error\":\"native_quic_moq_stream_handle_table_not_ready\",\"transport\":\"native_quic_moq_stream\"}")

@exportc("libp2p_moq_serve_once")
fn libp2p_moq_serve_once(handle: int64, waitMs: int32): cstring =
    handle
    waitMs
    return dupCString("{\"ok\":false,\"error\":\"native_quic_moq_stream_handle_table_not_ready\",\"transport\":\"native_quic_moq_stream\"}")

@exportc("libp2p_last_chunk_size")
fn libp2p_last_chunk_size(handle: int64): int32 =
    handle
    return 0
