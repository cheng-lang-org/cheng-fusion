import std/system

type
  NodeState =
    used: bool
    handle: int64
    hintCount: int32
    hintPeerIds: str[128]
    hintAddrs: str[128]

var
  nodes: NodeState[16]
  seqNo: int64 = 1

fn makeOne(i: int32) =
  seqNo = seqNo + 1
  nodes[i] = NodeState(used: true, handle: seqNo, hintCount: 0)

fn main(): int32 =
  makeOne(0)
  return 0
