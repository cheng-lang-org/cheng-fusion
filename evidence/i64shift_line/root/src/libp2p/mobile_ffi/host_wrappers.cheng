import cheng/libp2p/main as lp
import cheng/libp2p/switch
import cheng/libp2p/muxers/muxer
import cheng/libp2p/protocols/rendezvous
import cheng/libp2p/protocols/dm/dmenvelope
import cheng/libp2p/protocols/feed/feedservice
import cheng/libp2p/protocols/livestream/protobuf
import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes

const
    maxHostSlots = 16

var
    gHostUsed: bool[maxHostSlots]
    gHosts: Switch[maxHostSlots]

fn hostHandle(slotIdx: int32): int64 =
    return int64(slotIdx + 1)

fn hostIndex(handle: int64): int32 =
    if handle <= 0:
        return -1
    let idx: int32 = int32(handle) - 1
    if idx < 0 || idx >= maxHostSlots:
        return -1
    return idx

fn isHostSlotValid(idx: int32): bool =
    if idx < 0 || idx >= maxHostSlots:
        return false
    return gHostUsed[idx]

fn findFreeHostSlot(): int32 =
    for i in 0..<maxHostSlots:
        if !gHostUsed[i]:
            return i
    return -1

fn newHostWithAddressText(text: str): Result[int64] =
    let hostRes: Result[Switch] = lp.newHostWithAddressText(text)
    if IsErr(hostRes):
        return Err[int64](Error(hostRes))
    let slotIdx: int32 = findFreeHostSlot()
    if slotIdx < 0:
        return Err[int64]("host_slot_full")
    gHosts[slotIdx] = Value(hostRes)
    gHostUsed[slotIdx] = true
    return Ok[int64](hostHandle(slotIdx))

fn hostFree(swHandle: int64) =
    let idx: int32 = hostIndex(swHandle)
    if !isHostSlotValid(idx):
        return
    gHostUsed[idx] = false

fn hostStart(swHandle: int64): Result[bool] =
    let idx: int32 = hostIndex(swHandle)
    if !isHostSlotValid(idx):
        return Err[bool]("host_start_nil")
    var sw: Switch = gHosts[idx]
    let startRes: Result[bool] = lp.hostStart(sw)
    if IsErr(startRes):
        gHosts[idx] = sw
        return Err[bool](Error(startRes))
    let started: bool = Value(startRes)
    gHosts[idx] = sw
    return Ok[bool](started)

fn hostStop(swHandle: int64) =
    let idx: int32 = hostIndex(swHandle)
    if !isHostSlotValid(idx):
        return
    var sw: Switch = gHosts[idx]
    lp.hostStop(sw)
    gHosts[idx] = sw

fn hostDialText(swHandle: int64, addrText: str): Result[bool] =
    let idx: int32 = hostIndex(swHandle)
    if !isHostSlotValid(idx):
        return Err[bool]("host_dial_nil")
    var sw: Switch = gHosts[idx]
    let dialRes: Result[Muxer] = lp.hostDialText(sw, addrText)
    if IsErr(dialRes):
        gHosts[idx] = sw
        return Err[bool](Error(dialRes))
    gHosts[idx] = sw
    return Ok[bool](true)

