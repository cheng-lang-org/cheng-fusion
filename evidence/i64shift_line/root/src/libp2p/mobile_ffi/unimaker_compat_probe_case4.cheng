import std/system

type
  N =
    count: int32
    items: str[128]

var n: N

fn drain(cap: int32): str =
  var c: int32 = cap
  if c > n.count:
    c = n.count
  var out: str
  for i in 0..<c:
    out = out + n.items[i]
  if c > 0:
    for i in c..<n.count:
      n.items[i - c] = n.items[i]
    n.count = n.count - c
  return out

fn main(): int32 =
  return 0
