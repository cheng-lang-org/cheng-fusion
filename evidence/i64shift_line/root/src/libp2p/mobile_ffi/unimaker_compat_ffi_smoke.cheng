# Stable lightweight mobile FFI for smoke verification.
#
# This module intentionally keeps implementation deterministic so mobile smoke
# tests can validate public API semantics without importing the full host graph.

import std/system
import std/times

const
    resultOk = 0
    resultError = -1
    maxNodes = 8
    maxPeers = 64
    maxFiles = 128
    maxBootstrapTargets = 64


type
    NodeState =
        used: bool
        handle: int64
        started: bool

        dataDir: str
        listenAddr: str
        peerId: str
        privateKeyHex: str

        mdnsEnabled: bool

        msquicAllowDatagram: bool
        msquicMaxDatagram: int32
        msquicMinMtu: int32
        msquicMaxMtu: int32
        msquicMigrationEnabled: bool
        msquicEcnEnabled: bool

        hintCount: int32
        hintPeerIds: str[maxPeers]
        hintAddrs: str[maxPeers]

        bootstrapCount: int32
        bootstrapPeers: str[maxPeers]

        connectedCount: int32
        connectedPeers: str[maxPeers]

        bootstrapDialAttempted: int64
        bootstrapDialConnected: int64


var
    gLastError: str
    gHandleSeq: int64 = 1
    gKeySeq: int64 = 1
    gFileUsed: bool[maxFiles]
    gFilePath: str[maxFiles]
    gFileBody: str[maxFiles]
    gNodes: NodeState[maxNodes]


fn cStr(text: str): cstring =
    return text

fn smokeMarker(): int32 =
    return 4242

fn defaultDataDirText(): str =
    return charToStr('d')

fn defaultListenAddrText(): str =
    return charToStr('l')

fn setLastError(text: str) =
    gLastError = text

fn clearLastError() =
    gLastError = ""

fn trimText(text: str): str =
    let n: int32 = len(text)
    if n <= 0:
        return ""
    var left: int32
    while left < n:
        let ch: char = text[left]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        left = left + 1
    if left >= n:
        return ""
    var right: int32 = n
    while right > left:
        let ch: char = text[right - 1]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        right = right - 1
    return SliceBytes(text, left, right - left)

fn strLowerAscii(text: str): str =
    var out: str
    for i in 0..<len(text):
        let ch: char = text[i]
        if ch >= 'A' && ch <= 'Z':
            out = out + charToStr(chr(ord(ch) + 32))
        else:
            out = out + charToStr(ch)
    return out

fn indexOf(text: str, needle: str, start: int32): int32 =
    let n: int32 = len(text)
    let m: int32 = len(needle)
    if m <= 0:
        if start < 0:
            return 0
        if start > n:
            return n
        return start
    if n < m:
        return -1
    let begin: int32 =
        if start < 0:
            0
        else:
            start
    let last: int32 = n - m
    for i in begin..last:
        var ok: bool = true
        for j in 0..<m:
            if text[i + j] != needle[j]:
                ok = false
                break
        if ok:
            return i
    return -1

fn parseConfigQuotedValue(configText: str, keyName: str): str =
    let keyToken: str = "\"" + keyName + "\""
    let keyPos: int32 = indexOf(configText, keyToken, 0)
    if keyPos < 0:
        return ""
    var cursor: int32 = keyPos + len(keyToken)
    while cursor < len(configText) && configText[cursor] != ':':
        cursor = cursor + 1
    if cursor >= len(configText):
        return ""
    cursor = cursor + 1
    while cursor < len(configText):
        let ch: char = configText[cursor]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        cursor = cursor + 1
    if cursor >= len(configText):
        return ""
    var endPos: int32 = cursor
    if configText[cursor] == '"':
        endPos = cursor + 1
        while endPos < len(configText):
            if configText[endPos] == '"' && configText[endPos - 1] != '\\':
                break
            endPos = endPos + 1
        if endPos >= len(configText):
            return ""
        return trimText(SliceBytes(configText, cursor + 1, endPos - cursor - 1))
    while endPos < len(configText):
        let ch: char = configText[endPos]
        if ch == ',' || ch == '}' || ch == '\n' || ch == '\r':
            break
        endPos = endPos + 1
    if endPos <= cursor:
        return ""
    return trimText(SliceBytes(configText, cursor, endPos - cursor))

fn parseConfigHasKey(configText: str, keyName: str): bool =
    let keyToken: str = "\"" + keyName + "\""
    return indexOf(configText, keyToken, 0) >= 0

fn parseQuotedValues(text: str): str[] =
    var out: str[]
    let trimmed: str = trimText(text)
    if len(trimmed) <= 0:
        return out
    var i: int32
    while i < len(trimmed):
        if trimmed[i] == '"':
            let start: int32 = i + 1
            var endPos: int32 = start
            while endPos < len(trimmed):
                if trimmed[endPos] == '"' && trimmed[endPos - 1] != '\\':
                    break
                endPos = endPos + 1
            if endPos < len(trimmed) && endPos > start:
                add(out, SliceBytes(trimmed, start, endPos - start))
            i = endPos + 1
        else:
            i = i + 1
    return out

fn parseConfigArrayValues(configText: str, keyName: str): str[] =
    var out: str[]
    if len(configText) <= 0 || len(keyName) <= 0:
        return out
    let keyToken: str = "\"" + keyName + "\""
    let keyPos: int32 = indexOf(configText, keyToken, 0)
    if keyPos < 0:
        return out
    let colonPos: int32 = indexOf(configText, ":", keyPos + len(keyToken))
    if colonPos < 0:
        return out
    var openPos: int32 = -1
    for i in (colonPos + 1)..<len(configText):
        let ch: char = configText[i]
        if ch == '[':
            openPos = i
            break
        if ch == '{' || ch == '"' || (ch >= '0' && ch <= '9'):
            return out
    if openPos < 0:
        return out
    var closePos: int32 = -1
    var depth: int32
    for i in openPos..<len(configText):
        let ch: char = configText[i]
        if ch == '[':
            depth = depth + 1
        elif ch == ']':
            depth = depth - 1
            if depth == 0:
                closePos = i
                break
    if closePos <= openPos:
        return out
    let listText: str = SliceBytes(configText, openPos, closePos - openPos + 1)
    return parseQuotedValues(listText)

fn parseFirstInt64(text: str): int64 =
    let n: int32 = len(text)
    if n <= 0:
        return 0
    var sign: int64 = 1
    var start: int32 = -1
    for i in 0..<n:
        let ch: char = text[i]
        if ch == '-':
            sign = -1
            start = i + 1
            break
        if ch >= '0' && ch <= '9':
            start = i
            break
    if start < 0 || start >= n:
        return 0
    var out: int64
    for i in start..<n:
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            break
        out = out * 10 + int64(ord(ch) - ord('0'))
    return out * sign

fn boolFromText(text: str, fallback: bool): bool =
    let lower: str = strLowerAscii(trimText(text))
    if lower == "true" || lower == "1" || lower == "yes" || lower == "on":
        return true
    if lower == "false" || lower == "0" || lower == "no" || lower == "off":
        return false
    return fallback

fn toJsonStringValue(text: str): str =
    let q: str = charToStr('"')
    return q + text + q

fn isHexDigit(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'a' && ch <= 'f':
        return true
    if ch >= 'A' && ch <= 'F':
        return true
    return false

fn validatePrivateKeyHex(text: str): bool =
    let raw: str = trimText(text)
    let n: int32 = len(raw)
    if n < 64 || (n % 2) != 0:
        return false
    for i in 0..<n:
        if !isHexDigit(raw[i]):
            return false
    return true

fn hexNibble(v: int32): char =
    let x: int32 = v & 15
    if x < 10:
        return chr(ord('0') + x)
    return chr(ord('a') + (x - 10))

fn byteToHex(v: int32): str =
    let safe: int32 = v & 255
    return charToStr(hexNibble(safe / 16)) + charToStr(hexNibble(safe % 16))

fn mixSeed(seed: int64, extra: int64): int64 =
    return seed * int64(6364136223846793005) + extra + int64(1442695040888963407)

fn deterministicPrivateKeyHex(seedText: str): str =
    var seed: int64 = int64(len(seedText)) * int64(1469598103934665603)
    for i in 0..<len(seedText):
        seed = mixSeed(seed, int64(ord(seedText[i]) + i * 17 + 131))
    var out: str
    for i in 0..<64:
        seed = mixSeed(seed, int64(i * 41 + 7))
        let b: int32 = int32((seed >> 24) & int64(255))
        out = out + byteToHex(b)
    return out

fn generatePrivateKeyHex(seedTag: str): str =
    let seedText: str = seedTag + "|" + $gKeySeq + "|" + $int64(epochTime() * 1000.0)
    return deterministicPrivateKeyHex(seedText)

fn derivePrivateKeyHexFromSeedText(seedText: str): str =
    return deterministicPrivateKeyHex("seed|" + seedText)

fn derivePeerId(privateKeyHex: str): str =
    let lower: str = strLowerAscii(trimText(privateKeyHex))
    let body: str =
        if len(lower) > 44:
            SliceBytes(lower, 0, 44)
        else:
            lower
    return "12D3KooW" + body

fn findFile(path: str): int32 =
    let target: str = trimText(path)
    if len(target) <= 0:
        return -1
    for i in 0..<maxFiles:
        if gFileUsed[i] && gFilePath[i] == target:
            return i
    return -1

fn readFileText(path: str): str =
    let idx: int32 = findFile(path)
    if idx < 0:
        return ""
    return gFileBody[idx]

fn fileExists(path: str): bool =
    return findFile(path) >= 0

fn writeFileText(path: str, body: str): bool =
    let target: str = trimText(path)
    if len(target) <= 0:
        return false
    let existing: int32 = findFile(target)
    if existing >= 0:
        gFileBody[existing] = body
        return true
    for i in 0..<maxFiles:
        if !gFileUsed[i]:
            gFileUsed[i] = true
            gFilePath[i] = target
            gFileBody[i] = body
            return true
    return false

fn ensureDirRecursive(path: str): bool =
    let _ = path
    return true

fn joinPath(a: str, b: str): str =
    let left: str = trimText(a)
    if len(left) <= 0:
        return b
    if left[len(left) - 1] == '/':
        return left + b
    return left + "/" + b

fn peerKeyStorePath(dataDir: str): str =
    return joinPath(trimText(dataDir), "peer_key.hex")

fn c_cheng_write_file(path: cstring, content: cstring): int32 =
    let target: str =
        if path == nil:
            peerKeyStorePath(defaultDataDirText())
        else:
            trimText(path)
    let body: str =
        if content == nil:
            ""
        else:
            trimText(content)
    if writeFileText(target, body):
        return 1
    return 0

fn parseDataDir(configText: str): str =
    let dataDirA: str = trimText(parseConfigQuotedValue(configText, "dataDir"))
    if len(dataDirA) > 0:
        return dataDirA
    let dataDirB: str = trimText(parseConfigQuotedValue(configText, "data_dir"))
    if len(dataDirB) > 0:
        return dataDirB
    return defaultDataDirText()

fn parseListenAddr(configText: str): str =
    let addrA: str = trimText(parseConfigQuotedValue(configText, "listenAddr"))
    if len(addrA) > 0:
        return addrA
    let addrB: str = trimText(parseConfigQuotedValue(configText, "listen_addr"))
    if len(addrB) > 0:
        return addrB
    let addrC: str = trimText(parseConfigQuotedValue(configText, "listenAddress"))
    if len(addrC) > 0:
        return addrC
    let addrD: str = trimText(parseConfigQuotedValue(configText, "listen_address"))
    if len(addrD) > 0:
        return addrD
    let addrsA: str[] = parseConfigArrayValues(configText, "listenAddrs")
    if len(addrsA) > 0 && len(trimText(addrsA[0])) > 0:
        return trimText(addrsA[0])
    let addrsB: str[] = parseConfigArrayValues(configText, "listen_addrs")
    if len(addrsB) > 0 && len(trimText(addrsB[0])) > 0:
        return trimText(addrsB[0])
    return defaultListenAddrText()

fn parsePrivateKeyHex(configText: str): str =
    let keyA: str = trimText(parseConfigQuotedValue(configText, "private_key_hex"))
    if len(keyA) > 0:
        return keyA
    let keyB: str = trimText(parseConfigQuotedValue(configText, "privateKeyHex"))
    if len(keyB) > 0:
        return keyB
    let keyC: str = trimText(parseConfigQuotedValue(configText, "privateKey"))
    if len(keyC) > 0:
        return keyC
    return ""

fn parsePeerIdFromMultiaddr(addr: str): str =
    let marker: str = "/p2p/"
    let idx: int32 = indexOf(addr, marker, 0)
    if idx < 0:
        return ""
    let start: int32 = idx + len(marker)
    if start >= len(addr):
        return ""
    return trimText(SliceBytes(addr, start, len(addr) - start))

fn normalizeBootstrapTarget(text: str): str =
    let trimmed: str = trimText(text)
    if len(trimmed) <= 0:
        return ""
    let byAddr: str = parsePeerIdFromMultiaddr(trimmed)
    if len(byAddr) > 0:
        return byAddr
    return trimmed

fn parseBootstrapTargets(configText: str): str[] =
    var out: str[]
    let listA: str[] = parseConfigArrayValues(configText, "bootstrapPeers")
    for i in 0..<len(listA):
        let v: str = normalizeBootstrapTarget(listA[i])
        if len(v) > 0:
            add(out, v)
    let listB: str[] = parseConfigArrayValues(configText, "bootstrap_peers")
    for i in 0..<len(listB):
        let v: str = normalizeBootstrapTarget(listB[i])
        if len(v) > 0:
            add(out, v)
    return out

fn dialAddrWithPeer(addr: str, peerIdText: str): str =
    if indexOf(addr, "/p2p/", 0) >= 0:
        return addr
    if len(trimText(peerIdText)) <= 0:
        return addr
    return addr + "/p2p/" + peerIdText

fn initNodeState(): NodeState =
    return NodeState(
        used: false,
        handle: 0,
        started: false,
        dataDir: "",
        listenAddr: "",
        peerId: "",
        privateKeyHex: "",
        mdnsEnabled: true,
        msquicAllowDatagram: true,
        msquicMaxDatagram: 65535,
        msquicMinMtu: 1200,
        msquicMaxMtu: 0,
        msquicMigrationEnabled: true,
        msquicEcnEnabled: false,
        hintCount: 0,
        bootstrapCount: 0,
        connectedCount: 0,
        bootstrapDialAttempted: 0,
        bootstrapDialConnected: 0
    )

fn allocNodeSlot(): int32 =
    for i in 0..<maxNodes:
        if !gNodes[i].used:
            return i
    return -1

fn nodeIndex(handle: int64): int32 =
    if handle <= 0:
        return -1
    for i in 0..<maxNodes:
        if gNodes[i].used && gNodes[i].handle == handle:
            return i
    return -1

fn findNodeByPeerId(peerIdText: str): int32 =
    let target: str = trimText(peerIdText)
    if len(target) <= 0:
        return -1
    for i in 0..<maxNodes:
        if gNodes[i].used && gNodes[i].peerId == target:
            return i
    return -1

fn hasConnectedPeer(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    for i in 0..<gNodes[nodeIdx].connectedCount:
        if gNodes[nodeIdx].connectedPeers[i] == peerIdText:
            return true
    return false

fn addConnectedPeer(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    if hasConnectedPeer(nodeIdx, peerIdText):
        return true
    if gNodes[nodeIdx].connectedCount >= maxPeers:
        return false
    gNodes[nodeIdx].connectedPeers[gNodes[nodeIdx].connectedCount] = peerIdText
    gNodes[nodeIdx].connectedCount = gNodes[nodeIdx].connectedCount + 1
    return true

fn clearConnectedPeer(nodeIdx: int32, peerIdText: str) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    var next: int32
    for i in 0..<gNodes[nodeIdx].connectedCount:
        let current: str = gNodes[nodeIdx].connectedPeers[i]
        if current == peerIdText:
            continue
        gNodes[nodeIdx].connectedPeers[next] = current
        next = next + 1
    gNodes[nodeIdx].connectedCount = next

fn storePeerHint(nodeIdx: int32, peerIdText: str, addrText: str) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    let peerId: str = trimText(peerIdText)
    if len(peerId) <= 0:
        return
    for i in 0..<gNodes[nodeIdx].hintCount:
        if gNodes[nodeIdx].hintPeerIds[i] == peerId:
            if len(trimText(addrText)) > 0:
                gNodes[nodeIdx].hintAddrs[i] = trimText(addrText)
            return
    if gNodes[nodeIdx].hintCount >= maxPeers:
        return
    let next: int32 = gNodes[nodeIdx].hintCount
    gNodes[nodeIdx].hintPeerIds[next] = peerId
    gNodes[nodeIdx].hintAddrs[next] = trimText(addrText)
    gNodes[nodeIdx].hintCount = next + 1

fn clearBootstrapTargets(nodeIdx: int32) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    gNodes[nodeIdx].bootstrapCount = 0

fn addBootstrapTarget(nodeIdx: int32, peerIdText: str) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    let target: str = normalizeBootstrapTarget(peerIdText)
    if len(target) <= 0:
        return
    for i in 0..<gNodes[nodeIdx].bootstrapCount:
        if gNodes[nodeIdx].bootstrapPeers[i] == target:
            return
    if gNodes[nodeIdx].bootstrapCount >= maxPeers:
        return
    let next: int32 = gNodes[nodeIdx].bootstrapCount
    gNodes[nodeIdx].bootstrapPeers[next] = target
    gNodes[nodeIdx].bootstrapCount = next + 1

fn connectPeerInternal(srcIdx: int32, peerIdText: str): bool =
    if srcIdx < 0 || srcIdx >= maxNodes || !gNodes[srcIdx].used:
        return false
    let targetPeerId: str = trimText(peerIdText)
    if len(targetPeerId) <= 0:
        return false
    let dstIdx: int32 = findNodeByPeerId(targetPeerId)
    if dstIdx < 0:
        return false
    if !gNodes[dstIdx].started:
        return false
    if !addConnectedPeer(srcIdx, targetPeerId):
        return false
    let localPeerId: str = gNodes[srcIdx].peerId
    let _ = addConnectedPeer(dstIdx, localPeerId)
    return true

fn identityJson(privateKeyHex: str): str =
    let peerIdText: str = derivePeerId(privateKeyHex)
    return "{" +
        "\"ok\":true," +
        "\"peerId\":" + toJsonStringValue(peerIdText) + "," +
        "\"privateKeyHex\":" + toJsonStringValue(privateKeyHex) + "," +
        "\"private_key_hex\":" + toJsonStringValue(privateKeyHex) +
        "}"

fn msquicSettingsJson(node: NodeState): str =
    return "{" +
        "\"allowDatagram\":" + (if node.msquicAllowDatagram: "true" else: "false") + "," +
        "\"maxDatagram\":" + $node.msquicMaxDatagram + "," +
        "\"minimumMtu\":" + $node.msquicMinMtu + "," +
        "\"maximumMtu\":" + $node.msquicMaxMtu + "," +
        "\"migrationEnabled\":" + (if node.msquicMigrationEnabled: "true" else: "false") + "," +
        "\"ecnEnabled\":" + (if node.msquicEcnEnabled: "true" else: "false") +
        "}"


@exportc("NimMain")
fn NimMain() =
    clearLastError()
    gHandleSeq = 1
    gKeySeq = 1
    for i in 0..<maxNodes:
        gNodes[i] = initNodeState()
    for i in 0..<maxFiles:
        gFileUsed[i] = false
        gFilePath[i] = ""
        gFileBody[i] = ""

@exportc("libp2p_get_last_error")
fn libp2p_get_last_error(): cstring =
    return cStr(gLastError)

@exportc("libp2p_generate_identity_json")
fn libp2p_generate_identity_json(): cstring =
    gKeySeq = gKeySeq + 1
    let keyHex: str = generatePrivateKeyHex("generate")
    clearLastError()
    return cStr(identityJson(keyHex))

@exportc("libp2p_identity_from_seed")
fn libp2p_identity_from_seed(seed: cstring, seedLen: int64): cstring =
    if seed == nil || seedLen <= 0:
        setLastError("identity_from_seed: seed invalid")
        return cStr("{\"ok\":false,\"error\":\"seed_invalid\"}")
    let rawSeed: str = trimText(toString(seed))
    let seedText: str = rawSeed + "|" + $seedLen
    let keyHex: str = derivePrivateKeyHexFromSeedText(seedText)
    clearLastError()
    return cStr(identityJson(keyHex))

@exportc("libp2p_node_init")
fn libp2p_node_init(configJson: cstring): int64 =
    clearLastError()

    let configText: str =
        if configJson == nil:
            "{}"
        else:
            toString(configJson)

    let dataDir: str = parseDataDir(configText)
    let listenAddr: str = parseListenAddr(configText)

    if !ensureDirRecursive(dataDir):
        setLastError("node_init: data dir failed")
        return 0

    let keyPath: str = peerKeyStorePath(dataDir)
    let configuredKeyHex: str = trimText(parsePrivateKeyHex(configText))

    var selectedKeyHex: str
    if len(configuredKeyHex) > 0:
        if !validatePrivateKeyHex(configuredKeyHex):
            setLastError("node_init: invalid config private_key_hex")
            return 0
        selectedKeyHex = configuredKeyHex
    elif fileExists(keyPath):
        selectedKeyHex = trimText(readFileText(keyPath))
        if !validatePrivateKeyHex(selectedKeyHex):
            setLastError("node_init: persisted private key invalid")
            return 0
    else:
        gKeySeq = gKeySeq + 1
        selectedKeyHex = generatePrivateKeyHex("node|" + dataDir + "|" + listenAddr)

    if !validatePrivateKeyHex(selectedKeyHex):
        setLastError("node_init: selected private key invalid")
        return 0

    if !writeFileText(keyPath, selectedKeyHex):
        setLastError("node_init: key persist failed")
        return 0

    let slot: int32 = allocNodeSlot()
    if slot < 0:
        setLastError("node_init: slot full")
        return 0

    gHandleSeq = gHandleSeq + 1
    var node: NodeState = initNodeState()
    node.used = true
    node.handle = int64(slot + 1) * int64(4096) + gHandleSeq
    node.dataDir = dataDir
    node.listenAddr = listenAddr
    node.privateKeyHex = selectedKeyHex
    node.peerId = derivePeerId(selectedKeyHex)

    let bootstrapTargets: str[] = parseBootstrapTargets(configText)
    for i in 0..<len(bootstrapTargets):
        addBootstrapTarget(slot, bootstrapTargets[i])

    gNodes[slot] = node
    for i in 0..<len(bootstrapTargets):
        addBootstrapTarget(slot, bootstrapTargets[i])

    return gNodes[slot].handle

@exportc("libp2p_node_start")
fn libp2p_node_start(handle: int64): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("node_start: invalid handle")
        return resultError
    gNodes[idx].started = true
    return resultOk

@exportc("libp2p_node_stop")
fn libp2p_node_stop(handle: int64): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("node_stop: invalid handle")
        return resultError
    let localPeer: str = gNodes[idx].peerId
    gNodes[idx].started = false
    gNodes[idx].connectedCount = 0
    for i in 0..<maxNodes:
        if i != idx && gNodes[i].used:
            clearConnectedPeer(i, localPeer)
    return resultOk

@exportc("libp2p_node_free")
fn libp2p_node_free(handle: int64) =
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        return
    let localPeer: str = gNodes[idx].peerId
    for i in 0..<maxNodes:
        if i != idx && gNodes[i].used:
            clearConnectedPeer(i, localPeer)
    gNodes[idx] = initNodeState()

@exportc("libp2p_get_local_peer_id")
fn libp2p_get_local_peer_id(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        return cStr("")
    return cStr(gNodes[idx].peerId)

@exportc("libp2p_get_listen_addresses")
fn libp2p_get_listen_addresses(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        return cStr("[]")
    return cStr("[" + toJsonStringValue(gNodes[idx].listenAddr) + "]")

@exportc("libp2p_get_dialable_addresses")
fn libp2p_get_dialable_addresses(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        return cStr("[]")
    let dialAddr: str = dialAddrWithPeer(gNodes[idx].listenAddr, gNodes[idx].peerId)
    return cStr("[" + toJsonStringValue(dialAddr) + "]")

@exportc("libp2p_set_msquic_settings")
fn libp2p_set_msquic_settings(handle: int64, settingsJsonPtr: cstring): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("set_msquic_settings: invalid handle")
        return false

    let settingsText: str =
        if settingsJsonPtr == nil:
            "{}"
        else:
            toString(settingsJsonPtr)

    var allowDatagram: bool = gNodes[idx].msquicAllowDatagram
    if parseConfigHasKey(settingsText, "allowDatagram"):
        allowDatagram = boolFromText(parseConfigQuotedValue(settingsText, "allowDatagram"), allowDatagram)
    if parseConfigHasKey(settingsText, "allow_datagram"):
        allowDatagram = boolFromText(parseConfigQuotedValue(settingsText, "allow_datagram"), allowDatagram)

    var maxDatagram: int32 = gNodes[idx].msquicMaxDatagram
    if parseConfigHasKey(settingsText, "maxDatagram"):
        maxDatagram = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maxDatagram")))
    if parseConfigHasKey(settingsText, "max_datagram"):
        maxDatagram = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "max_datagram")))

    var minMtu: int32 = gNodes[idx].msquicMinMtu
    if parseConfigHasKey(settingsText, "minimumMtu"):
        minMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "minimumMtu")))
    if parseConfigHasKey(settingsText, "minimum_mtu"):
        minMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "minimum_mtu")))

    var maxMtu: int32 = gNodes[idx].msquicMaxMtu
    if parseConfigHasKey(settingsText, "maximumMtu"):
        maxMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maximumMtu")))
    if parseConfigHasKey(settingsText, "maximum_mtu"):
        maxMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maximum_mtu")))

    var migrationEnabled: bool = gNodes[idx].msquicMigrationEnabled
    if parseConfigHasKey(settingsText, "migrationEnabled"):
        migrationEnabled = boolFromText(parseConfigQuotedValue(settingsText, "migrationEnabled"), migrationEnabled)
    if parseConfigHasKey(settingsText, "migration_enabled"):
        migrationEnabled = boolFromText(parseConfigQuotedValue(settingsText, "migration_enabled"), migrationEnabled)

    var ecnEnabled: bool = gNodes[idx].msquicEcnEnabled
    if parseConfigHasKey(settingsText, "ecnEnabled"):
        ecnEnabled = boolFromText(parseConfigQuotedValue(settingsText, "ecnEnabled"), ecnEnabled)
    if parseConfigHasKey(settingsText, "ecn_enabled"):
        ecnEnabled = boolFromText(parseConfigQuotedValue(settingsText, "ecn_enabled"), ecnEnabled)

    if maxDatagram < 0:
        setLastError("set_msquic_settings: maxDatagram must be non-negative")
        return false
    if minMtu < 0 || maxMtu < 0:
        setLastError("set_msquic_settings: mtu must be non-negative")
        return false
    if maxMtu > 0 && minMtu > 0 && maxMtu < minMtu:
        setLastError("set_msquic_settings: maximum mtu must be >= minimum mtu")
        return false

    gNodes[idx].msquicAllowDatagram = allowDatagram
    gNodes[idx].msquicMaxDatagram = maxDatagram
    gNodes[idx].msquicMinMtu = minMtu
    gNodes[idx].msquicMaxMtu = maxMtu
    gNodes[idx].msquicMigrationEnabled = migrationEnabled
    gNodes[idx].msquicEcnEnabled = ecnEnabled

    return true

@exportc("libp2p_get_msquic_settings")
fn libp2p_get_msquic_settings(handle: int64): cstring =
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        return cStr(charToStr('m'))
    return cStr(charToStr('m'))

@exportc("libp2p_register_peer_hints")
fn libp2p_register_peer_hints(handle: int64, peerIdPtr: cstring, addressesJsonPtr: cstring, sourcePtr: cstring): bool =
    let _ = sourcePtr
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("register_peer_hints: invalid handle")
        return false

    var peerIdText: str =
        if peerIdPtr == nil:
            ""
        else:
            trimText(toString(peerIdPtr))

    let addressesText: str =
        if addressesJsonPtr == nil:
            "[]"
        else:
            toString(addressesJsonPtr)
    let addresses: str[] = parseQuotedValues(addressesText)

    var primaryAddr: str
    if len(addresses) > 0:
        primaryAddr = trimText(addresses[0])
    if len(peerIdText) <= 0:
        peerIdText = parsePeerIdFromMultiaddr(primaryAddr)

    if len(peerIdText) > 0:
        storePeerHint(idx, peerIdText, primaryAddr)
        addBootstrapTarget(idx, peerIdText)
        return true

    for i in 0..<maxNodes:
        if i != idx && gNodes[i].used:
            let peerId: str = gNodes[i].peerId
            let addr: str = dialAddrWithPeer(gNodes[i].listenAddr, peerId)
            storePeerHint(idx, peerId, addr)
            addBootstrapTarget(idx, peerId)
            return true

    return true

@exportc("libp2p_connect_peer")
fn libp2p_connect_peer(handle: int64, peerIdPtr: cstring): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("connect_peer: invalid handle")
        return resultError

    let peerIdText: str =
        if peerIdPtr == nil:
            ""
        else:
            trimText(toString(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("connect_peer: missing peerId")
        return resultError

    if connectPeerInternal(idx, peerIdText):
        return resultOk

    setLastError("connect_peer: dial failed")
    return resultError

@exportc("libp2p_connect_multiaddr")
fn libp2p_connect_multiaddr(handle: int64, multiaddrPtr: cstring): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("connect_multiaddr: invalid handle")
        return resultError

    let multiaddrText: str =
        if multiaddrPtr == nil:
            ""
        else:
            trimText(toString(multiaddrPtr))
    if len(multiaddrText) <= 0:
        setLastError("connect_multiaddr: missing address")
        return resultError

    let peerIdText: str = parsePeerIdFromMultiaddr(multiaddrText)
    if len(peerIdText) <= 0:
        setLastError("connect_multiaddr: missing /p2p peer id")
        return resultError

    storePeerHint(idx, peerIdText, multiaddrText)
    addBootstrapTarget(idx, peerIdText)

    if connectPeerInternal(idx, peerIdText):
        return resultOk

    setLastError("connect_multiaddr: dial failed")
    return resultError

@exportc("libp2p_disconnect_peer")
fn libp2p_disconnect_peer(handle: int64, peerIdPtr: cstring): int32 =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("disconnect_peer: invalid handle")
        return resultError
    let peerIdText: str =
        if peerIdPtr == nil:
            ""
        else:
            trimText(toString(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("disconnect_peer: missing peerId")
        return resultError
    clearConnectedPeer(idx, peerIdText)
    return resultOk

@exportc("libp2p_is_peer_connected")
fn libp2p_is_peer_connected(handle: int64, peerIdPtr: cstring): bool =
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        return false
    if peerIdPtr == nil:
        return gNodes[idx].connectedCount > 0
    let peerIdText: str = trimText(toString(peerIdPtr))
    if len(peerIdText) <= 0:
        return gNodes[idx].connectedCount > 0
    return hasConnectedPeer(idx, peerIdText)

@exportc("libp2p_mdns_set_enabled")
fn libp2p_mdns_set_enabled(handle: int64, enabled: bool): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("mdns_set_enabled: invalid handle")
        return false
    gNodes[idx].mdnsEnabled = enabled
    return true

@exportc("libp2p_mdns_probe")
fn libp2p_mdns_probe(handle: int64): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("mdns_probe: invalid handle")
        return false
    if !gNodes[idx].started:
        setLastError("mdns_probe: not_started")
        return false
    if !gNodes[idx].mdnsEnabled:
        setLastError("mdns_probe: disabled")
        return false
    return true

@exportc("libp2p_bootstrap_set_policy")
fn libp2p_bootstrap_set_policy(handle: int64, policyJsonPtr: cstring): bool =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("bootstrap_set_policy: invalid handle")
        return false

    let policyText: str =
        if policyJsonPtr == nil:
            "{}"
        else:
            toString(policyJsonPtr)

    if parseConfigHasKey(policyText, "bootstrapPeers") || parseConfigHasKey(policyText, "bootstrap_peers"):
        clearBootstrapTargets(idx)
        let targets: str[] = parseBootstrapTargets(policyText)
        for i in 0..<len(targets):
            addBootstrapTarget(idx, targets[i])

    return true

fn containsText(values: str[maxBootstrapTargets], count: int32, target: str): bool =
    if count <= 0:
        return false
    for i in 0..<count:
        if values[i] == target:
            return true
    return false

@exportc("libp2p_bootstrap_tick")
fn libp2p_bootstrap_tick(handle: int64): cstring =
    clearLastError()
    let idx: int32 = nodeIndex(handle)
    if idx < 0:
        setLastError("bootstrap_tick: invalid handle")
        return cStr(charToStr('e'))

    var attemptedPeerIds: str[maxBootstrapTargets]
    var attemptedUnique: int32
    var attempted: int32
    var connected: int32

    for i in 0..<gNodes[idx].bootstrapCount:
        let peerIdText: str = trimText(gNodes[idx].bootstrapPeers[i])
        if len(peerIdText) <= 0:
            continue
        if containsText(attemptedPeerIds, attemptedUnique, peerIdText):
            continue
        attemptedPeerIds[attemptedUnique] = peerIdText
        attemptedUnique = attemptedUnique + 1
        attempted = attempted + 1
        if connectPeerInternal(idx, peerIdText):
            connected = connected + 1

    for i in 0..<gNodes[idx].hintCount:
        let peerIdText: str = trimText(gNodes[idx].hintPeerIds[i])
        if len(peerIdText) <= 0:
            continue
        if containsText(attemptedPeerIds, attemptedUnique, peerIdText):
            continue
        if attemptedUnique >= maxBootstrapTargets:
            break
        attemptedPeerIds[attemptedUnique] = peerIdText
        attemptedUnique = attemptedUnique + 1
        attempted = attempted + 1
        if connectPeerInternal(idx, peerIdText):
            connected = connected + 1

    gNodes[idx].bootstrapDialAttempted = gNodes[idx].bootstrapDialAttempted + int64(attempted)
    gNodes[idx].bootstrapDialConnected = gNodes[idx].bootstrapDialConnected + int64(connected)

    let _ = attemptedUnique
    return cStr(charToStr('t'))
