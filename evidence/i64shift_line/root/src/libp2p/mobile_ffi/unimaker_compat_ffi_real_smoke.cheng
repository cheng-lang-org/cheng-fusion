@exportc("libp2p_mark_peer_hibernated")
fn libp2p_mark_peer_hibernated(handle: int64, peerIdPtr: str): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("mark_peer_hibernated: invalid handle")
        return false
    let peerIdText: str = trimText(cstrToText(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("mark_peer_hibernated: missing peerId")
        return false
    setPeerHibernated(idx, peerIdText, true)
    clearConnectedPeer(idx, peerIdText)
    gNodes[idx].pushQueuedCount = gNodes[idx].pushQueuedCount + 1
    emitNodeEvent(idx, "push_to_punch.queued", "{\"peerId\":" + toJsonStringValue(peerIdText) + "}")
    return true

@exportc("libp2p_notify_push_wakeup")
fn libp2p_notify_push_wakeup(handle: int64, peerIdPtr: str): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("notify_push_wakeup: invalid handle")
        return false
    let peerIdText: str = trimText(cstrToText(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("notify_push_wakeup: missing peerId")
        return false
    gNodes[idx].pendingWakeupPeer = peerIdText
    gNodes[idx].pushWakeupCount = gNodes[idx].pushWakeupCount + 1
    emitNodeEvent(idx, "push_to_punch.wakeup", "{\"peerId\":" + toJsonStringValue(peerIdText) + "}")
    return true

@exportc("libp2p_push_to_punch")
fn libp2p_push_to_punch(handle: int64, peerIdPtr: str): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("push_to_punch: invalid handle")
        return false
    if !gNodes[idx].started:
        setLastError("push_to_punch: not_started")
        emitNodeEvent(idx, "push_to_punch.failed", "{\"reason\":\"not_started\"}")
        return false
    var peerIdText: str = trimText(cstrToText(peerIdPtr))
    if len(peerIdText) <= 0:
        peerIdText = trimText(gNodes[idx].pendingWakeupPeer)
    if len(peerIdText) <= 0:
        setLastError("push_to_punch: missing peerId")
        gNodes[idx].pushFailedCount = gNodes[idx].pushFailedCount + 1
        emitNodeEvent(idx, "push_to_punch.failed", "{\"reason\":\"missing_peer\"}")
        return false
    let recovered: bool = pushToPunchTryConnect(idx, peerIdText)
    if recovered:
        setPeerHibernated(idx, peerIdText, false)
        gNodes[idx].pendingWakeupPeer = ""
        gNodes[idx].pushRecoveredCount = gNodes[idx].pushRecoveredCount + 1
        emitNodeEvent(idx, "push_to_punch.recovered", "{\"peerId\":" + toJsonStringValue(peerIdText) + "}")
        return true
    gNodes[idx].pushFailedCount = gNodes[idx].pushFailedCount + 1
    emitNodeEvent(idx, "push_to_punch.failed", "{\"peerId\":" + toJsonStringValue(peerIdText) + ",\"error\":" + toJsonStringValue(gLastError) + "}")
    return false

@exportc("libp2p_bootstrap_set_policy")
fn libp2p_bootstrap_set_policy(handle: int64, policyJsonPtr: str): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("bootstrap_set_policy: invalid handle")
        return false

    let policyTextRaw: str = cstrToText(policyJsonPtr)
    let policyText: str = if len(policyTextRaw) > 0: policyTextRaw else: "{}"
    if parseConfigHasKey(policyText, "bootstrapPeers") || parseConfigHasKey(policyText, "bootstrap_peers"):
        clearBootstrapTargets(idx)
        let targets: str[] = parseBootstrapTargets(policyText)
        for i in 0..<len(targets):
            addBootstrapTarget(idx, targets[i])
            let _ = ensureRuntimePeerHint(idx, targets[i])
    return true

@exportc("libp2p_bootstrap_tick")
fn libp2p_bootstrap_tick(handle: int64): str =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("bootstrap_tick: invalid handle")
        return cStr("{\"ok\":false}")
    if !gNodes[idx].started:
        setLastError("bootstrap_tick: not_started")
        return cStr("{\"ok\":false}")
    return cStr(bootstrapTickNode(idx))

@exportc("libp2p_bootstrap_get_status")
fn libp2p_bootstrap_get_status(handle: int64): str =
    let idx: int32 = findNodeByHandle(handle)
    return cStr(bootstrapStatusJson(idx))

@exportc("libp2p_poll_events")
fn libp2p_poll_events(handle: int64, maxEventsRequested: int32): str =
    let idx: int32 = findNodeByHandle(handle)
    return cStr(drainNodeEvents(idx, maxEventsRequested))

@exportc("libp2p_send_direct_text")
fn libp2p_send_direct_text(
    handle: int64,
    peerIdPtr: str,
    messageIdPtr: str,
    textPtr: str,
    replyToPtr: str,
    requestAck: bool,
    timeoutMs: int32
): bool =
    let _ = messageIdPtr
    let _ = replyToPtr
    let _ = requestAck
    let _ = timeoutMs
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gNodes[idx].used || !gNodes[idx].started:
        setLastError("send_direct_text: invalid handle or not started")
        return false
    let peerIdText: str = trimText(cstrToText(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("send_direct_text: missing peerId")
        return false
    if !hasConnectedPeer(idx, peerIdText):
        setLastError("send_direct_text: peer not connected")
        return false
    let text: str = trimText(cstrToText(textPtr))
    if len(text) <= 0:
        setLastError("send_direct_text: empty payload")
        return false
    gNodes[idx].dmSentCount = gNodes[idx].dmSentCount + 1
    return true

@exportc("libp2p_upsert_livestream_cfg")
fn libp2p_upsert_livestream_cfg(handle: int64, streamKeyPtr: str, configJsonPtr: str): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gNodes[idx].used || !gNodes[idx].started:
        setLastError("upsert_livestream_cfg: invalid handle or not started")
        return false
    let streamKey: str = trimText(cstrToText(streamKeyPtr))
    if len(streamKey) <= 0:
        setLastError("upsert_livestream_cfg: missing stream key")
        return false
    let cfgJsonRaw: str = cstrToText(configJsonPtr)
    let cfgJson: str = if len(cfgJsonRaw) > 0: cfgJsonRaw else: "{}"
    if !upsertLiveStreamLite(idx, streamKey, cfgJson):
        setLastError("upsert_livestream_cfg: stream update failed")
        return false
    return true

@exportc("libp2p_publish_livestream_frame_ffi")
fn libp2p_publish_livestream_frame_ffi(handle: int64, streamKeyPtr: str, payloadPtr: str, payloadLen: int64): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gNodes[idx].used || !gNodes[idx].started:
        setLastError("publish_livestream_frame: invalid handle or not started")
        return false
    let streamKey: str = trimText(cstrToText(streamKeyPtr))
    if len(streamKey) <= 0:
        setLastError("publish_livestream_frame: missing stream key")
        return false
    if len(gNodes[idx].liveStreamLastKey) <= 0 || gNodes[idx].liveStreamLastKey != streamKey:
        setLastError("publish_livestream_frame: stream not configured")
        return false
    let payloadText: str = cstrToText(payloadPtr)
    if len(payloadText) <= 0 || payloadLen <= 0:
        setLastError("publish_livestream_frame: empty payload")
        return false
    gNodes[idx].liveStreamFrameCount = gNodes[idx].liveStreamFrameCount + 1
    return true

