@exportc("libp2p_is_peer_connected")
fn libp2p_is_peer_connected(handle: int64, peerIdPtr: str): bool =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        return false
    let peerIdText: str = trimText(cstrToText(peerIdPtr))
    if len(peerIdText) <= 0:
        return gNodes[idx].connectedCount > 0
    return hasConnectedPeer(idx, peerIdText)

@exportc("libp2p_mdns_set_enabled")
fn libp2p_mdns_set_enabled(handle: int64, enabled: bool): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("mdns_set_enabled: invalid handle")
        return false
    gNodes[idx].mdnsEnabled = enabled
    return true

@exportc("libp2p_mdns_probe")
fn libp2p_mdns_probe(handle: int64): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gHostUsed[idx]:
        setLastError("mdns_probe: invalid handle")
        return false
    if !gNodes[idx].started:
        setLastError("mdns_probe: not_started")
        return false
    if !gNodes[idx].mdnsEnabled:
        setLastError("mdns_probe: disabled")
        return false

    # mDNS is enhancement-only in mobile full-start smoke path.
    return true

@exportc("libp2p_ble_set_enabled")
fn libp2p_ble_set_enabled(handle: int64, enabled: bool): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("ble_set_enabled: invalid handle")
        return false
    gNodes[idx].bleEnabled = enabled
    if len(trimText(gNodes[idx].bleService)) <= 0:
        gNodes[idx].bleService = defaultBleService
    if len(trimText(gNodes[idx].bleNamespace)) <= 0:
        gNodes[idx].bleNamespace = defaultBleNamespace
    return true

