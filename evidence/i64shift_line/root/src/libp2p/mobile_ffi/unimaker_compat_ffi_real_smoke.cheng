# Real-host lightweight mobile FFI for smoke verification.
#
# The data plane is simulated in-process so ZRPC/no-pointer smoke gates can
# validate mobile control-plane behavior without importing pointerful modules.

import std/system
import std/times
import std/rawbytes

const
    resultOk = 0
    resultError = -1
    maxNodes = 8
    maxPeers = 64
    maxFiles = 128
    maxNodeEvents = 64
    defaultDataDir = "/tmp/cheng-libp2p-mobile"
    defaultListenAddr = "/ip4/0.0.0.0/udp/4001/quic-v1"
    defaultMdnsService = "_unimaker._udp.local"
    defaultMdnsNamespace = "local"
    defaultBleService = "_unimaker_ble._udp.local"
    defaultBleNamespace = "local"


type
    NodeState =
        used: bool
        handle: int64
        started: bool

        dataDir: str
        listenAddr: str
        peerId: str
        privateKeyHex: str

        mdnsEnabled: bool
        bleEnabled: bool
        bleService: str
        bleNamespace: str

        msquicAllowDatagram: bool
        msquicMaxDatagram: int32
        msquicMinMtu: int32
        msquicMaxMtu: int32
        msquicMigrationEnabled: bool
        msquicEcnEnabled: bool

        hintCount: int32
        hintPeerIds: str[maxPeers]
        hintAddrs: str[maxPeers]

        bootstrapCount: int32
        bootstrapPeers: str[maxPeers]

        connectedCount: int32
        connectedPeers: str[maxPeers]

        bootstrapDialAttempted: int64
        bootstrapDialConnected: int64
        pushToken: str
        hibernatedCount: int32
        hibernatedPeers: str[maxPeers]
        pendingWakeupPeer: str
        pushQueuedCount: int64
        pushWakeupCount: int64
        pushRecoveredCount: int64
        pushFailedCount: int64
        eventCount: int32
        events: str[maxNodeEvents]

        dmSentCount: int64
        liveStreamConfiguredCount: int32
        liveStreamLastKey: str
        liveStreamLastCfg: str
        liveStreamFrameCount: int64
        feedLastEntry: str
        feedSubscribedPeer: str


var
    gLastError: str
    gHandleSeq: int64 = 1
    gKeySeq: int64 = 1

    gFileUsed: bool[maxFiles]
    gFilePath: str[maxFiles]
    gFileBody: str[maxFiles]

    gNodes: NodeState[maxNodes]
    gHostUsed: bool[maxNodes]


fn cStr(text: str): str =
    return text

fn cstrToText(text: str): str =
    return text

fn setLastError(text: str) =
    gLastError = text

fn clearLastError() =
    gLastError = ""

fn nowMs(): int64 =
    return int64(epochTime() * 1000.0)

fn trimText(text: str): str =
    let n: int32 = len(text)
    if n <= 0:
        return ""
    var left: int32
    while left < n:
        let ch: char = text[left]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        left = left + 1
    if left >= n:
        return ""
    var right: int32 = n
    while right > left:
        let ch: char = text[right - 1]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        right = right - 1
    return SliceBytes(text, left, right - left)

fn strLowerAscii(text: str): str =
    var out: str
    for i in 0..<len(text):
        let ch: char = text[i]
        if ch >= 'A' && ch <= 'Z':
            out = out + charToStr(chr(ord(ch) + 32))
        else:
            out = out + charToStr(ch)
    return out

fn startsWith(text: str, prefix: str): bool =
    if len(prefix) <= 0:
        return true
    if len(text) < len(prefix):
        return false
    for i in 0..<len(prefix):
        if text[i] != prefix[i]:
            return false
    return true

fn indexOf(text: str, needle: str, start: int32): int32 =
    let n: int32 = len(text)
    let m: int32 = len(needle)
    if m <= 0:
        if start < 0:
            return 0
        if start > n:
            return n
        return start
    if n < m:
        return -1
    let begin: int32 =
        if start < 0:
            0
        else:
            start
    let last: int32 = n - m
    for i in begin..last:
        var ok: bool = true
        for j in 0..<m:
            if text[i + j] != needle[j]:
                ok = false
                break
        if ok:
            return i
    return -1

fn parseConfigHasKey(configText: str, keyName: str): bool =
    if len(configText) <= 0 || len(keyName) <= 0:
        return false
    return indexOf(configText, "\"" + keyName + "\"", 0) >= 0

fn parseConfigQuotedValue(configText: str, keyName: str): str =
    let token: str = "\"" + keyName + "\""
    let start: int32 = indexOf(configText, token, 0)
    if start < 0:
        return ""
    let n: int32 = len(configText)
    var cursor: int32 = start + len(token)
    while cursor < n && configText[cursor] != ':':
        cursor = cursor + 1
    if cursor >= n:
        return ""
    cursor = cursor + 1
    while cursor < n:
        let ch: char = configText[cursor]
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r':
            break
        cursor = cursor + 1
    if cursor >= n:
        return ""
    if configText[cursor] == '"':
        let valueStart: int32 = cursor + 1
        var valueEnd: int32 = n
        for i in valueStart..<n:
            if configText[i] == '"' && configText[i - 1] != '\\':
                valueEnd = i
                break
        if valueEnd <= valueStart:
            return ""
        return SliceBytes(configText, valueStart, valueEnd - valueStart)
    var valueEnd: int32 = cursor
    while valueEnd < n:
        let ch: char = configText[valueEnd]
        if ch == ',' || ch == '}' || ch == '\n' || ch == '\r':
            break
        valueEnd = valueEnd + 1
    if valueEnd <= cursor:
        return ""
    return trimText(SliceBytes(configText, cursor, valueEnd - cursor))

fn parseQuotedValues(text: str): str[] =
    var out: str[]
    let n: int32 = len(text)
    if n <= 1:
        return out
    var i: int32
    while i < n:
        if text[i] != '"':
            i = i + 1
            continue
        let start: int32 = i + 1
        var endPos: int32 = start
        while endPos < n:
            if text[endPos] == '"' && text[endPos - 1] != '\\':
                break
            endPos = endPos + 1
        if endPos <= start || endPos > n:
            break
        add(out, SliceBytes(text, start, endPos - start))
        i = endPos + 1
    return out

fn parseConfigArrayValues(configText: str, keyName: str): str[] =
    var out: str[]
    if len(configText) <= 0 || len(keyName) <= 0:
        return out
    let token: str = "\"" + keyName + "\""
    let keyPos: int32 = indexOf(configText, token, 0)
    if keyPos < 0:
        return out
    let colonPos: int32 = indexOf(configText, ":", keyPos + len(token))
    if colonPos < 0:
        return out
    var openPos: int32 = -1
    for i in (colonPos + 1)..<len(configText):
        let ch: char = configText[i]
        if ch == '[':
            openPos = i
            break
        if ch == '{' || ch == '"' || (ch >= '0' && ch <= '9'):
            return out
    if openPos < 0:
        return out
    var closePos: int32 = -1
    var depth: int32
    for i in openPos..<len(configText):
        let ch: char = configText[i]
        if ch == '[':
            depth = depth + 1
        elif ch == ']':
            depth = depth - 1
            if depth == 0:
                closePos = i
                break
    if closePos <= openPos:
        return out
    let listText: str = SliceBytes(configText, openPos, closePos - openPos + 1)
    return parseQuotedValues(listText)

fn parseFirstInt64(text: str): int64 =
    let n: int32 = len(text)
    if n <= 0:
        return 0
    var sign: int64 = 1
    var start: int32 = -1
    for i in 0..<n:
        let ch: char = text[i]
        if ch == '-':
            sign = -1
            start = i + 1
            break
        if ch >= '0' && ch <= '9':
            start = i
            break
    if start < 0 || start >= n:
        return 0
    var out: int64
    for i in start..<n:
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            break
        out = out * 10 + int64(ord(ch) - ord('0'))
    return out * sign

fn boolFromText(text: str, fallback: bool): bool =
    let lower: str = strLowerAscii(trimText(text))
    if lower == "true" || lower == "1" || lower == "yes" || lower == "on":
        return true
    if lower == "false" || lower == "0" || lower == "no" || lower == "off":
        return false
    return fallback

fn toJsonStringValue(text: str): str =
    var out: str = "\""
    for i in 0..<len(text):
        let ch: char = text[i]
        if ch == '\\':
            out = out + "\\\\"
        elif ch == '"':
            out = out + "\\\""
        elif ch == '\n':
            out = out + "\\n"
        elif ch == '\r':
            out = out + "\\r"
        elif ch == '\t':
            out = out + "\\t"
        else:
            out = out + charToStr(ch)
    out = out + "\""
    return out

fn normalizeJsonPayload(payloadText: str): str =
    let trimmed: str = trimText(payloadText)
    if len(trimmed) <= 0:
        return "{}"
    let first: char = trimmed[0]
    let last: char = trimmed[len(trimmed) - 1]
    if (first == '{' && last == '}') || (first == '[' && last == ']'):
        return trimmed
    if trimmed == "true" || trimmed == "false" || trimmed == "null":
        return trimmed
    if first == '-' || (first >= '0' && first <= '9'):
        return trimmed
    return toJsonStringValue(trimmed)

fn isHexDigit(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'a' && ch <= 'f':
        return true
    if ch >= 'A' && ch <= 'F':
        return true
    return false

fn validatePrivateKeyHex(text: str): bool =
    let raw: str = trimText(text)
    let n: int32 = len(raw)
    if n < 64 || (n % 2) != 0:
        return false
    for i in 0..<n:
        if !isHexDigit(raw[i]):
            return false
    return true

fn hexNibble(v: int32): char =
    let x: int32 = v & 15
    if x < 10:
        return chr(ord('0') + x)
    return chr(ord('a') + (x - 10))

fn byteToHex(v: int32): str =
    let safe: int32 = v & 255
    return charToStr(hexNibble(safe / 16)) + charToStr(hexNibble(safe % 16))

fn mixSeed(seed: int64, extra: int64): int64 =
    return seed * int64(6364136223846793005) + extra + int64(1442695040888963407)

fn pseudoPrivateKeyHex(seedText: str): str =
    var seed: int64 = int64(len(seedText)) * int64(1469598103934665603)
    for i in 0..<len(seedText):
        seed = mixSeed(seed, int64(ord(seedText[i]) + i * 17 + 131))
    var out: str
    for i in 0..<64:
        seed = mixSeed(seed, int64(i * 41 + 7))
        let b: int32 = int32((seed >> 24) & int64(255))
        out = out + byteToHex(b)
    return out

fn derivePeerId(privateKeyHex: str): str =
    let lower: str = strLowerAscii(trimText(privateKeyHex))
    let body: str =
        if len(lower) > 44:
            SliceBytes(lower, 0, 44)
        else:
            lower
    return "12D3KooW" + body

fn identityJson(privateKeyHex: str): str =
    return "{" +
        "\"peerId\":" + toJsonStringValue(derivePeerId(privateKeyHex)) + "," +
        "\"privateKey\":" + toJsonStringValue(privateKeyHex) + "," +
        "\"encoding\":\"hex-ed25519-64\"" +
        "}"

fn initNodeState(): NodeState =
    return NodeState(
        used: false,
        handle: 0,
        started: false,
        dataDir: "",
        listenAddr: "",
        peerId: "",
        privateKeyHex: "",
        mdnsEnabled: true,
        bleEnabled: false,
        bleService: defaultBleService,
        bleNamespace: defaultBleNamespace,
        msquicAllowDatagram: true,
        msquicMaxDatagram: 65535,
        msquicMinMtu: 1200,
        msquicMaxMtu: 0,
        msquicMigrationEnabled: true,
        msquicEcnEnabled: false,
        hintCount: 0,
        bootstrapCount: 0,
        connectedCount: 0,
        bootstrapDialAttempted: 0,
        bootstrapDialConnected: 0,
        pushToken: "",
        hibernatedCount: 0,
        pendingWakeupPeer: "",
        pushQueuedCount: 0,
        pushWakeupCount: 0,
        pushRecoveredCount: 0,
        pushFailedCount: 0,
        eventCount: 0,
        dmSentCount: 0,
        liveStreamConfiguredCount: 0,
        liveStreamFrameCount: 0,
        feedLastEntry: "",
        feedSubscribedPeer: ""
    )

fn findNodeByHandle(handle: int64): int32 =
    if handle <= 0:
        return -1
    for i in 0..<maxNodes:
        if gNodes[i].used && gNodes[i].handle == handle:
            return i
    return -1

fn findNodeByPeerId(peerIdText: str): int32 =
    let target: str = trimText(peerIdText)
    if len(target) <= 0:
        return -1
    for i in 0..<maxNodes:
        if gNodes[i].used && gNodes[i].peerId == target:
            return i
    return -1

fn allocNodeSlot(): int32 =
    for i in 0..<maxNodes:
        if !gNodes[i].used:
            return i
    return -1

fn newNodeHandle(slot: int32): int64 =
    gHandleSeq = gHandleSeq + 1
    return int64(slot + 1) * int64(4096) + gHandleSeq

fn hasConnectedPeer(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    for i in 0..<gNodes[nodeIdx].connectedCount:
        if gNodes[nodeIdx].connectedPeers[i] == peerIdText:
            return true
    return false

fn addConnectedPeer(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    let target: str = trimText(peerIdText)
    if len(target) <= 0:
        return false
    if hasConnectedPeer(nodeIdx, target):
        return true
    if gNodes[nodeIdx].connectedCount >= maxPeers:
        return false
    gNodes[nodeIdx].connectedPeers[gNodes[nodeIdx].connectedCount] = target
    gNodes[nodeIdx].connectedCount = gNodes[nodeIdx].connectedCount + 1
    return true

fn clearConnectedPeer(nodeIdx: int32, peerIdText: str) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    let target: str = trimText(peerIdText)
    if len(target) <= 0:
        return
    var next: int32
    for i in 0..<gNodes[nodeIdx].connectedCount:
        let cur: str = gNodes[nodeIdx].connectedPeers[i]
        if cur == target:
            continue
        gNodes[nodeIdx].connectedPeers[next] = cur
        next = next + 1
    gNodes[nodeIdx].connectedCount = next

fn storePeerHint(nodeIdx: int32, peerIdText: str, addrText: str) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    let peerId: str = trimText(peerIdText)
    if len(peerId) <= 0:
        return
    let addr: str = trimText(addrText)
    for i in 0..<gNodes[nodeIdx].hintCount:
        if gNodes[nodeIdx].hintPeerIds[i] == peerId:
            if len(addr) > 0:
                gNodes[nodeIdx].hintAddrs[i] = addr
            return
    if gNodes[nodeIdx].hintCount >= maxPeers:
        return
    let next: int32 = gNodes[nodeIdx].hintCount
    gNodes[nodeIdx].hintPeerIds[next] = peerId
    gNodes[nodeIdx].hintAddrs[next] = addr
    gNodes[nodeIdx].hintCount = next + 1

fn clearBootstrapTargets(nodeIdx: int32) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    gNodes[nodeIdx].bootstrapCount = 0

fn addBootstrapTarget(nodeIdx: int32, peerIdText: str) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    let peerId: str = trimText(peerIdText)
    if len(peerId) <= 0:
        return
    for i in 0..<gNodes[nodeIdx].bootstrapCount:
        if gNodes[nodeIdx].bootstrapPeers[i] == peerId:
            return
    if gNodes[nodeIdx].bootstrapCount >= maxPeers:
        return
    let next: int32 = gNodes[nodeIdx].bootstrapCount
    gNodes[nodeIdx].bootstrapPeers[next] = peerId
    gNodes[nodeIdx].bootstrapCount = next + 1

fn hasBootstrapTarget(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    let peerId: str = trimText(peerIdText)
    if len(peerId) <= 0:
        return false
    for i in 0..<gNodes[nodeIdx].bootstrapCount:
        if gNodes[nodeIdx].bootstrapPeers[i] == peerId:
            return true
    return false

fn hasHibernatedPeer(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    let peerId: str = trimText(peerIdText)
    if len(peerId) <= 0:
        return false
    for i in 0..<gNodes[nodeIdx].hibernatedCount:
        if gNodes[nodeIdx].hibernatedPeers[i] == peerId:
            return true
    return false

fn setPeerHibernated(nodeIdx: int32, peerIdText: str, hibernated: bool) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    let peerId: str = trimText(peerIdText)
    if len(peerId) <= 0:
        return
    var found: int32 = -1
    for i in 0..<gNodes[nodeIdx].hibernatedCount:
        if gNodes[nodeIdx].hibernatedPeers[i] == peerId:
            found = i
            break
    if hibernated:
        if found >= 0:
            return
        if gNodes[nodeIdx].hibernatedCount >= maxPeers:
            return
        let next: int32 = gNodes[nodeIdx].hibernatedCount
        gNodes[nodeIdx].hibernatedPeers[next] = peerId
        gNodes[nodeIdx].hibernatedCount = next + 1
        return
    if found < 0:
        return
    var nextCount: int32
    for i in 0..<gNodes[nodeIdx].hibernatedCount:
        if i == found:
            continue
        gNodes[nodeIdx].hibernatedPeers[nextCount] = gNodes[nodeIdx].hibernatedPeers[i]
        nextCount = nextCount + 1
    gNodes[nodeIdx].hibernatedCount = nextCount

fn emitNodeEvent(nodeIdx: int32, topic: str, payloadJson: str) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    let eventJson: str = "{\"topic\":" + toJsonStringValue(topic) + ",\"payload\":" + normalizeJsonPayload(payloadJson) + "}"
    if gNodes[nodeIdx].eventCount < maxNodeEvents:
        gNodes[nodeIdx].events[gNodes[nodeIdx].eventCount] = eventJson
        gNodes[nodeIdx].eventCount = gNodes[nodeIdx].eventCount + 1
        return
    var next: int32 = 1
    while next < maxNodeEvents:
        gNodes[nodeIdx].events[next - 1] = gNodes[nodeIdx].events[next]
        next = next + 1
    gNodes[nodeIdx].events[maxNodeEvents - 1] = eventJson

fn drainNodeEvents(nodeIdx: int32, maxEventsRequested: int32): str =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used || gNodes[nodeIdx].eventCount <= 0:
        return "[]"
    var take: int32 = maxEventsRequested
    if take <= 0 || take > gNodes[nodeIdx].eventCount:
        take = gNodes[nodeIdx].eventCount
    var out: str = "["
    var wrote: bool
    var remain: int32
    for i in 0..<gNodes[nodeIdx].eventCount:
        let item: str = gNodes[nodeIdx].events[i]
        if i < take:
            if len(item) > 0:
                if wrote:
                    out = out + ","
                out = out + item
                wrote = true
        else:
            gNodes[nodeIdx].events[remain] = item
            remain = remain + 1
    gNodes[nodeIdx].eventCount = remain
    out = out + "]"
    return out

fn bootstrapStatusJson(nodeIdx: int32): str =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return "{\"dialAttempted\":0,\"dialConnected\":0,\"hintCount\":0,\"bootstrapCount\":0,\"connectedCount\":0,\"hibernatedCount\":0,\"pushQueuedCount\":0,\"pushWakeupCount\":0,\"pushRecoveredCount\":0,\"pushFailedCount\":0}"
    return "{" +
        "\"dialAttempted\":" + $gNodes[nodeIdx].bootstrapDialAttempted + "," +
        "\"dialConnected\":" + $gNodes[nodeIdx].bootstrapDialConnected + "," +
        "\"hintCount\":" + $gNodes[nodeIdx].hintCount + "," +
        "\"bootstrapCount\":" + $gNodes[nodeIdx].bootstrapCount + "," +
        "\"connectedCount\":" + $gNodes[nodeIdx].connectedCount + "," +
        "\"hibernatedCount\":" + $gNodes[nodeIdx].hibernatedCount + "," +
        "\"pushQueuedCount\":" + $gNodes[nodeIdx].pushQueuedCount + "," +
        "\"pushWakeupCount\":" + $gNodes[nodeIdx].pushWakeupCount + "," +
        "\"pushRecoveredCount\":" + $gNodes[nodeIdx].pushRecoveredCount + "," +
        "\"pushFailedCount\":" + $gNodes[nodeIdx].pushFailedCount +
        "}"

fn upsertLiveStreamLite(nodeIdx: int32, streamKey: str, cfgJson: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    let key: str = trimText(streamKey)
    if len(key) <= 0:
        return false
    let cfgRaw: str = trimText(cfgJson)
    let cfg: str = if len(cfgRaw) > 0: cfgRaw else: "{}"
    if gNodes[nodeIdx].liveStreamConfiguredCount < 2147483647:
        gNodes[nodeIdx].liveStreamConfiguredCount = gNodes[nodeIdx].liveStreamConfiguredCount + 1
    gNodes[nodeIdx].liveStreamLastKey = key
    gNodes[nodeIdx].liveStreamLastCfg = cfg
    return true

fn normalizeFeedPayload(payloadText: str): str =
    let trimmed: str = trimText(payloadText)
    if len(trimmed) <= 0:
        return "{\"content\":\"\"}"
    let first: char = trimmed[0]
    let last: char = trimmed[len(trimmed) - 1]
    if (first == '{' && last == '}') || (first == '[' && last == ']'):
        return trimmed
    return "{\"content\":" + toJsonStringValue(trimmed) + "}"

fn setFeedEntryLite(nodeIdx: int32, payloadJsonText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    gNodes[nodeIdx].feedLastEntry = normalizeFeedPayload(payloadJsonText)
    return true

fn setFeedSubscriptionLite(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    let target: str = trimText(peerIdText)
    if len(target) <= 0:
        return false
    gNodes[nodeIdx].feedSubscribedPeer = target
    return true

fn feedSnapshotJson(nodeIdx: int32): str =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return "{\"entries\":[]}"
    var out: str = "{\"entries\":["
    var first: bool = true
    if len(gNodes[nodeIdx].feedLastEntry) > 0:
        out = out + "{\"owner\":" + toJsonStringValue(gNodes[nodeIdx].peerId) + ",\"entry\":" + gNodes[nodeIdx].feedLastEntry + "}"
        first = false
    let subscribedPeer: str = trimText(gNodes[nodeIdx].feedSubscribedPeer)
    if len(subscribedPeer) > 0:
        let subIdx: int32 = findNodeByPeerId(subscribedPeer)
        if subIdx >= 0 && gNodes[subIdx].used && len(gNodes[subIdx].feedLastEntry) > 0:
            if !first:
                out = out + ","
            out = out + "{\"owner\":" + toJsonStringValue(subscribedPeer) + ",\"entry\":" + gNodes[subIdx].feedLastEntry + "}"
    out = out + "]}"
    return out

fn findFile(path: str): int32 =
    let target: str = trimText(path)
    if len(target) <= 0:
        return -1
    for i in 0..<maxFiles:
        if gFileUsed[i] && gFilePath[i] == target:
            return i
    return -1

fn fileExists(path: str): bool =
    return findFile(path) >= 0

fn readFileText(path: str): str =
    let idx: int32 = findFile(path)
    if idx < 0:
        return ""
    return gFileBody[idx]

fn writeFileText(path: str, body: str): bool =
    let target: str = trimText(path)
    if len(target) <= 0:
        return false
    let existing: int32 = findFile(target)
    if existing >= 0:
        gFileBody[existing] = body
        return true
    for i in 0..<maxFiles:
        if !gFileUsed[i]:
            gFileUsed[i] = true
            gFilePath[i] = target
            gFileBody[i] = body
            return true
    return false

fn ensureDirRecursive(path: str): bool =
    let _ = path
    return true

fn joinPath(a: str, b: str): str =
    let left: str = trimText(a)
    let right: str = trimText(b)
    if len(left) <= 0:
        return right
    if len(right) <= 0:
        return left
    if left[len(left) - 1] == '/':
        return left + right
    return left + "/" + right

fn peerKeyStorePath(dataDir: str): str =
    return joinPath(trimText(dataDir), "peer_key.hex")

fn parseDataDir(configText: str): str =
    let a: str = trimText(parseConfigQuotedValue(configText, "dataDir"))
    if len(a) > 0:
        return a
    let b: str = trimText(parseConfigQuotedValue(configText, "data_dir"))
    if len(b) > 0:
        return b
    return defaultDataDir

fn parseListenAddr(configText: str): str =
    let a: str = trimText(parseConfigQuotedValue(configText, "listenAddr"))
    if len(a) > 0:
        return a
    let b: str = trimText(parseConfigQuotedValue(configText, "listen_addr"))
    if len(b) > 0:
        return b
    let c: str = trimText(parseConfigQuotedValue(configText, "listenAddress"))
    if len(c) > 0:
        return c
    let d: str = trimText(parseConfigQuotedValue(configText, "listen_address"))
    if len(d) > 0:
        return d
    let addrsA: str[] = parseConfigArrayValues(configText, "listenAddrs")
    if len(addrsA) > 0 && len(trimText(addrsA[0])) > 0:
        return trimText(addrsA[0])
    let addrsB: str[] = parseConfigArrayValues(configText, "listen_addrs")
    if len(addrsB) > 0 && len(trimText(addrsB[0])) > 0:
        return trimText(addrsB[0])
    return defaultListenAddr

fn parsePrivateKeyHex(configText: str): str =
    let a: str = trimText(parseConfigQuotedValue(configText, "private_key_hex"))
    if len(a) > 0:
        return a
    let b: str = trimText(parseConfigQuotedValue(configText, "privateKeyHex"))
    if len(b) > 0:
        return b
    let c: str = trimText(parseConfigQuotedValue(configText, "privateKey"))
    if len(c) > 0:
        return c
    return ""

fn parsePeerIdFromMultiaddr(addrText: str): str =
    let marker: str = "/p2p/"
    let pos: int32 = indexOf(addrText, marker, 0)
    if pos < 0:
        return ""
    let start: int32 = pos + len(marker)
    if start >= len(addrText):
        return ""
    return trimText(SliceBytes(addrText, start, len(addrText) - start))

fn normalizeDialBaseAddress(listenAddr: str): str =
    let addr: str = trimText(listenAddr)
    if startsWith(addr, "/ip4/0.0.0.0/"):
        return "/ip4/127.0.0.1/" + SliceBytes(addr, len("/ip4/0.0.0.0/"), len(addr) - len("/ip4/0.0.0.0/"))
    if startsWith(addr, "/ip6/::/"):
        return "/ip6/::1/" + SliceBytes(addr, len("/ip6/::/"), len(addr) - len("/ip6/::/"))
    return addr

fn dialAddrWithPeer(listenAddr: str, peerIdText: str): str =
    let base: str = normalizeDialBaseAddress(listenAddr)
    let peerId: str = trimText(peerIdText)
    if len(base) <= 0 || len(peerId) <= 0:
        return base
    if indexOf(base, "/p2p/", 0) >= 0:
        return base
    return base + "/p2p/" + peerId

fn isLikelyMultiaddr(addrText: str): bool =
    let addr: str = trimText(addrText)
    if len(addr) <= 1:
        return false
    if addr[0] != '/':
        return false
    return indexOf(addr, "/", 1) > 1

fn parseBootstrapTargets(configText: str): str[] =
    var out: str[]
    let listA: str[] = parseConfigArrayValues(configText, "bootstrapPeers")
    for i in 0..<len(listA):
        let peerA: str = parsePeerIdFromMultiaddr(listA[i])
        if len(peerA) > 0:
            add(out, peerA)
        else:
            let rawA: str = trimText(listA[i])
            if len(rawA) > 0:
                add(out, rawA)
    let listB: str[] = parseConfigArrayValues(configText, "bootstrap_peers")
    for i in 0..<len(listB):
        let peerB: str = parsePeerIdFromMultiaddr(listB[i])
        if len(peerB) > 0:
            add(out, peerB)
        else:
            let rawB: str = trimText(listB[i])
            if len(rawB) > 0:
                add(out, rawB)
    return out

fn appendBootstrapValuesToNode(nodeIdx: int32, values: str[]) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return
    for i in 0..<len(values):
        let raw: str = trimText(values[i])
        if len(raw) <= 0:
            continue
        let peerId: str = parsePeerIdFromMultiaddr(raw)
        if len(peerId) > 0:
            addBootstrapTarget(nodeIdx, peerId)
            storePeerHint(nodeIdx, peerId, raw)
        else:
            addBootstrapTarget(nodeIdx, raw)

fn syncNodeIdentityFromHost(nodeIdx: int32) =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used || !gHostUsed[nodeIdx]:
        return
    if len(gNodes[nodeIdx].peerId) <= 0 && len(gNodes[nodeIdx].privateKeyHex) > 0:
        gNodes[nodeIdx].peerId = derivePeerId(gNodes[nodeIdx].privateKeyHex)
    if len(gNodes[nodeIdx].listenAddr) <= 0:
        gNodes[nodeIdx].listenAddr = defaultListenAddr

fn mergePeerAddressToHost(nodeIdx: int32, peerIdText: str, addrText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    let peerRaw: str = trimText(peerIdText)
    let addrRaw: str = trimText(addrText)
    if len(peerRaw) <= 0 || len(addrRaw) <= 0:
        return false
    return isLikelyMultiaddr(addrRaw)

fn findPeerHintAddress(nodeIdx: int32, peerIdText: str): str =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return ""
    let target: str = trimText(peerIdText)
    if len(target) <= 0:
        return ""
    for i in 0..<gNodes[nodeIdx].hintCount:
        if gNodes[nodeIdx].hintPeerIds[i] == target:
            let addr: str = trimText(gNodes[nodeIdx].hintAddrs[i])
            if len(addr) > 0:
                return addr
    return ""

fn ensureRuntimePeerHint(srcIdx: int32, peerIdText: str): bool =
    if srcIdx < 0 || srcIdx >= maxNodes || !gNodes[srcIdx].used:
        return false
    let dstIdx: int32 = findNodeByPeerId(peerIdText)
    if dstIdx < 0 || !gNodes[dstIdx].used:
        return false
    let dialAddr: str = dialAddrWithPeer(gNodes[dstIdx].listenAddr, gNodes[dstIdx].peerId)
    if len(dialAddr) <= 0:
        return false
    storePeerHint(srcIdx, peerIdText, dialAddr)
    let _ = mergePeerAddressToHost(srcIdx, peerIdText, dialAddr)
    return true

fn markConnectedPair(srcIdx: int32, peerIdText: str) =
    let peerText: str = trimText(peerIdText)
    if len(peerText) <= 0:
        return
    let _ = addConnectedPeer(srcIdx, peerText)
    let dstIdx: int32 = findNodeByPeerId(peerText)
    if dstIdx < 0 || !gNodes[dstIdx].used:
        return
    let srcPeerText: str = gNodes[srcIdx].peerId
    let _ = addConnectedPeer(dstIdx, srcPeerText)

fn connectPeerReal(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used || !gHostUsed[nodeIdx]:
        return false
    if !gNodes[nodeIdx].started:
        setLastError("connect_peer: node not started")
        return false
    let targetPeer: str = trimText(peerIdText)
    if len(targetPeer) <= 0:
        setLastError("connect_peer: missing peerId")
        return false
    let _ = ensureRuntimePeerHint(nodeIdx, targetPeer)
    var targetAddr: str = findPeerHintAddress(nodeIdx, targetPeer)
    if len(targetAddr) <= 0:
        let dstIdx: int32 = findNodeByPeerId(targetPeer)
        if dstIdx >= 0 && gNodes[dstIdx].used:
            targetAddr = dialAddrWithPeer(gNodes[dstIdx].listenAddr, gNodes[dstIdx].peerId)
            if len(targetAddr) > 0:
                storePeerHint(nodeIdx, targetPeer, targetAddr)
    if len(targetAddr) <= 0:
        setLastError("connect_peer: missing dialable address for peer")
        return false
    if !isLikelyMultiaddr(targetAddr):
        setLastError("connect_peer: invalid multiaddr hint")
        return false
    let dstIdx: int32 = findNodeByPeerId(targetPeer)
    if dstIdx < 0 || !gNodes[dstIdx].used || !gNodes[dstIdx].started:
        setLastError("connect_peer: target peer unavailable")
        return false
    markConnectedPair(nodeIdx, targetPeer)
    return true

fn connectMultiaddrReal(nodeIdx: int32, multiaddrText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used || !gHostUsed[nodeIdx]:
        return false
    if !gNodes[nodeIdx].started:
        setLastError("connect_multiaddr: node not started")
        return false
    let addrRaw: str = trimText(multiaddrText)
    if len(addrRaw) <= 0:
        setLastError("connect_multiaddr: missing address")
        return false
    let peerIdText: str = parsePeerIdFromMultiaddr(addrRaw)
    if len(peerIdText) > 0:
        storePeerHint(nodeIdx, peerIdText, addrRaw)
        addBootstrapTarget(nodeIdx, peerIdText)
        let _ = mergePeerAddressToHost(nodeIdx, peerIdText, addrRaw)
    if !isLikelyMultiaddr(addrRaw):
        setLastError("connect_multiaddr: invalid multiaddr")
        return false
    if len(peerIdText) > 0:
        let dstIdx: int32 = findNodeByPeerId(peerIdText)
        if dstIdx < 0 || !gNodes[dstIdx].used || !gNodes[dstIdx].started:
            setLastError("connect_multiaddr: target peer unavailable")
            return false
        markConnectedPair(nodeIdx, peerIdText)
    return true

fn bleServiceOrDefault(nodeIdx: int32): str =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return defaultBleService
    let text: str = trimText(gNodes[nodeIdx].bleService)
    if len(text) > 0:
        return text
    return defaultBleService

fn bleNamespaceOrDefault(nodeIdx: int32): str =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return defaultBleNamespace
    let text: str = trimText(gNodes[nodeIdx].bleNamespace)
    if len(text) > 0:
        return text
    return defaultBleNamespace

fn bleProbeNode(nodeIdx: int32): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used || !gHostUsed[nodeIdx]:
        return false
    if !gNodes[nodeIdx].started:
        setLastError("ble_probe: not_started")
        return false
    if !gNodes[nodeIdx].bleEnabled:
        setLastError("ble_probe: disabled")
        return false
    let serviceText: str = bleServiceOrDefault(nodeIdx)
    let namespaceText: str = bleNamespaceOrDefault(nodeIdx)
    for i in 0..<maxNodes:
        if i == nodeIdx:
            continue
        if !gNodes[i].used || !gNodes[i].started || !gNodes[i].bleEnabled:
            continue
        if bleServiceOrDefault(i) != serviceText || bleNamespaceOrDefault(i) != namespaceText:
            continue
        let peerIdText: str = gNodes[i].peerId
        let dialAddr: str = dialAddrWithPeer(gNodes[i].listenAddr, peerIdText)
        storePeerHint(nodeIdx, peerIdText, dialAddr)
        addBootstrapTarget(nodeIdx, peerIdText)
        emitNodeEvent(nodeIdx, "ble.discovery.updated", "{\"peerId\":" + toJsonStringValue(peerIdText) + ",\"address\":" + toJsonStringValue(dialAddr) + "}")
    return true

fn pushToPunchTryConnect(nodeIdx: int32, peerIdText: str): bool =
    if nodeIdx < 0 || nodeIdx >= maxNodes || !gNodes[nodeIdx].used:
        return false
    let peerId: str = trimText(peerIdText)
    if len(peerId) <= 0:
        setLastError("push_to_punch: missing peerId")
        return false
    let hintedAddr: str = findPeerHintAddress(nodeIdx, peerId)
    if len(hintedAddr) > 0:
        if connectMultiaddrReal(nodeIdx, hintedAddr):
            return true
    if hasBootstrapTarget(nodeIdx, peerId):
        if connectPeerReal(nodeIdx, peerId):
            return true
    return connectPeerReal(nodeIdx, peerId)

fn bootstrapTickNode(nodeIdx: int32): str =
    var attempted: int32
    var connected: int32

    for i in 0..<gNodes[nodeIdx].bootstrapCount:
        let peerIdText: str = trimText(gNodes[nodeIdx].bootstrapPeers[i])
        if len(peerIdText) <= 0:
            continue
        if hasConnectedPeer(nodeIdx, peerIdText):
            continue
        attempted = attempted + 1
        if connectPeerReal(nodeIdx, peerIdText):
            connected = connected + 1

    for i in 0..<gNodes[nodeIdx].hintCount:
        let peerIdText: str = trimText(gNodes[nodeIdx].hintPeerIds[i])
        if len(peerIdText) <= 0:
            continue
        if hasConnectedPeer(nodeIdx, peerIdText):
            continue
        attempted = attempted + 1
        if connectPeerReal(nodeIdx, peerIdText):
            connected = connected + 1

    gNodes[nodeIdx].bootstrapDialAttempted = gNodes[nodeIdx].bootstrapDialAttempted + int64(attempted)
    gNodes[nodeIdx].bootstrapDialConnected = gNodes[nodeIdx].bootstrapDialConnected + int64(connected)

    let mdnsProbeOk: bool = gNodes[nodeIdx].mdnsEnabled && gNodes[nodeIdx].started

    return "{" +
        "\"ok\":true," +
        "\"dialAttempted\":" + $attempted + "," +
        "\"dialConnected\":" + $connected + "," +
        "\"mdnsProbe\":" + (if mdnsProbeOk: "true" else: "false") +
        "}"


@exportc("NimMain")
fn NimMain() =
    clearLastError()
    gHandleSeq = 1
    gKeySeq = 1
    for i in 0..<maxNodes:
        gNodes[i] = initNodeState()
        gHostUsed[i] = false
    for i in 0..<maxFiles:
        gFileUsed[i] = false
        gFilePath[i] = ""
        gFileBody[i] = ""

@exportc("libp2p_get_last_error")
fn libp2p_get_last_error(): str =
    return cStr(gLastError)

@exportc("libp2p_generate_identity_json")
fn libp2p_generate_identity_json(): str =
    clearLastError()
    gKeySeq = gKeySeq + 1
    return cStr(identityJson(pseudoPrivateKeyHex("generate|" + $nowMs() + "|" + $gKeySeq)))

@exportc("libp2p_identity_from_seed")
fn libp2p_identity_from_seed(seed: str, seedLen: int64): str =
    clearLastError()
    let rawSeed: str = cstrToText(seed)
    if len(rawSeed) <= 0 || seedLen <= 0:
        setLastError("identity_from_seed: seed invalid")
        return cStr("{\"ok\":false,\"error\":\"seed_invalid\"}")
    let seedText: str = if int64(len(rawSeed)) > seedLen: SliceBytes(rawSeed, 0, int32(seedLen)) else: rawSeed
    return cStr(identityJson(pseudoPrivateKeyHex("seed|" + seedText + "|" + $seedLen)))

@exportc("libp2p_node_init")
fn libp2p_node_init(configJson: str): int64 =
    clearLastError()
    let configTextRaw: str = cstrToText(configJson)
    let configText: str = if len(configTextRaw) > 0: configTextRaw else: "{}"

    let dataDir: str = parseDataDir(configText)
    let listenAddr: str = parseListenAddr(configText)

    if !ensureDirRecursive(dataDir):
        setLastError("node_init: data dir failed")
        return 0
    if !isLikelyMultiaddr(listenAddr):
        setLastError("node_init: invalid listen address")
        return 0

    let configuredKeyHex: str = trimText(parsePrivateKeyHex(configText))
    let keyPath: str = peerKeyStorePath(dataDir)
    var selectedKeyHex: str

    if len(configuredKeyHex) > 0:
        if !validatePrivateKeyHex(configuredKeyHex):
            setLastError("node_init: invalid config private_key_hex")
            return 0
        selectedKeyHex = configuredKeyHex
    elif fileExists(keyPath):
        selectedKeyHex = trimText(readFileText(keyPath))
        if !validatePrivateKeyHex(selectedKeyHex):
            setLastError("node_init: persisted private key invalid")
            return 0
    else:
        gKeySeq = gKeySeq + 1
        selectedKeyHex = pseudoPrivateKeyHex("node|" + dataDir + "|" + listenAddr + "|" + $gKeySeq)

    if !validatePrivateKeyHex(selectedKeyHex):
        setLastError("node_init: selected private key invalid")
        return 0

    let slot: int32 = allocNodeSlot()
    if slot < 0:
        setLastError("node_init: slot full")
        return 0

    let hostPeerText: str = derivePeerId(selectedKeyHex)
    let hostListenText: str = listenAddr

    var node: NodeState = initNodeState()
    node.used = true
    node.handle = newNodeHandle(slot)
    node.dataDir = dataDir
    node.listenAddr = if len(hostListenText) > 0: hostListenText else: listenAddr
    node.privateKeyHex = selectedKeyHex
    node.peerId = hostPeerText

    gNodes[slot] = node
    gHostUsed[slot] = true

    if !writeFileText(keyPath, selectedKeyHex):
        gNodes[slot] = initNodeState()
        gHostUsed[slot] = false
        setLastError("node_init: key persist failed")
        return 0

    let bootstrapTargets: str[] = parseBootstrapTargets(configText)
    for i in 0..<len(bootstrapTargets):
        addBootstrapTarget(slot, bootstrapTargets[i])
    let bootstrapPeersRaw: str[] = parseConfigArrayValues(configText, "bootstrapPeers")
    let bootstrapPeersSnake: str[] = parseConfigArrayValues(configText, "bootstrap_peers")
    appendBootstrapValuesToNode(slot, bootstrapPeersRaw)
    appendBootstrapValuesToNode(slot, bootstrapPeersSnake)

    return gNodes[slot].handle

@exportc("libp2p_node_start")
fn libp2p_node_start(handle: int64): int32 =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gHostUsed[idx]:
        setLastError("node_start: invalid handle")
        return resultError

    gNodes[idx].started = true
    syncNodeIdentityFromHost(idx)
    return resultOk

@exportc("libp2p_node_stop")
fn libp2p_node_stop(handle: int64): int32 =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gHostUsed[idx]:
        setLastError("node_stop: invalid handle")
        return resultError

    let localPeer: str = gNodes[idx].peerId

    gNodes[idx].started = false
    gNodes[idx].connectedCount = 0
    for i in 0..<maxNodes:
        if i != idx && gNodes[i].used:
            clearConnectedPeer(i, localPeer)
    return resultOk

@exportc("libp2p_node_free")
fn libp2p_node_free(handle: int64) =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        return

    let localPeer: str = gNodes[idx].peerId
    gHostUsed[idx] = false

    for i in 0..<maxNodes:
        if i != idx && gNodes[i].used:
            clearConnectedPeer(i, localPeer)

    gNodes[idx] = initNodeState()

@exportc("libp2p_get_local_peer_id")
fn libp2p_get_local_peer_id(handle: int64): str =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gHostUsed[idx]:
        return cStr("")
    syncNodeIdentityFromHost(idx)
    return cStr(gNodes[idx].peerId)

@exportc("libp2p_get_listen_addresses")
fn libp2p_get_listen_addresses(handle: int64): str =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gHostUsed[idx]:
        return cStr("[]")
    syncNodeIdentityFromHost(idx)
    return cStr("[" + toJsonStringValue(gNodes[idx].listenAddr) + "]")

@exportc("libp2p_get_dialable_addresses")
fn libp2p_get_dialable_addresses(handle: int64): str =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gHostUsed[idx]:
        return cStr("[]")
    syncNodeIdentityFromHost(idx)
    let dialAddr: str = dialAddrWithPeer(gNodes[idx].listenAddr, gNodes[idx].peerId)
    return cStr("[" + toJsonStringValue(dialAddr) + "]")

@exportc("libp2p_set_msquic_settings")
fn libp2p_set_msquic_settings(handle: int64, settingsJsonPtr: str): bool =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gHostUsed[idx]:
        setLastError("set_msquic_settings: invalid handle")
        return false

    let settingsTextRaw: str = cstrToText(settingsJsonPtr)
    let settingsText: str = if len(settingsTextRaw) > 0: settingsTextRaw else: "{}"

    var allowDatagram: bool = gNodes[idx].msquicAllowDatagram
    if parseConfigHasKey(settingsText, "allowDatagram"):
        allowDatagram = boolFromText(parseConfigQuotedValue(settingsText, "allowDatagram"), allowDatagram)
    if parseConfigHasKey(settingsText, "allow_datagram"):
        allowDatagram = boolFromText(parseConfigQuotedValue(settingsText, "allow_datagram"), allowDatagram)

    var maxDatagram: int32 = gNodes[idx].msquicMaxDatagram
    if parseConfigHasKey(settingsText, "maxDatagram"):
        maxDatagram = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maxDatagram")))
    if parseConfigHasKey(settingsText, "max_datagram"):
        maxDatagram = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "max_datagram")))

    var minMtu: int32 = gNodes[idx].msquicMinMtu
    if parseConfigHasKey(settingsText, "minimumMtu"):
        minMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "minimumMtu")))
    if parseConfigHasKey(settingsText, "minimum_mtu"):
        minMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "minimum_mtu")))

    var maxMtu: int32 = gNodes[idx].msquicMaxMtu
    if parseConfigHasKey(settingsText, "maximumMtu"):
        maxMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maximumMtu")))
    if parseConfigHasKey(settingsText, "maximum_mtu"):
        maxMtu = int32(parseFirstInt64(parseConfigQuotedValue(settingsText, "maximum_mtu")))

    var migrationEnabled: bool = gNodes[idx].msquicMigrationEnabled
    if parseConfigHasKey(settingsText, "migrationEnabled"):
        migrationEnabled = boolFromText(parseConfigQuotedValue(settingsText, "migrationEnabled"), migrationEnabled)
    if parseConfigHasKey(settingsText, "migration_enabled"):
        migrationEnabled = boolFromText(parseConfigQuotedValue(settingsText, "migration_enabled"), migrationEnabled)

    var ecnEnabled: bool = gNodes[idx].msquicEcnEnabled
    if parseConfigHasKey(settingsText, "ecnEnabled"):
        ecnEnabled = boolFromText(parseConfigQuotedValue(settingsText, "ecnEnabled"), ecnEnabled)
    if parseConfigHasKey(settingsText, "ecn_enabled"):
        ecnEnabled = boolFromText(parseConfigQuotedValue(settingsText, "ecn_enabled"), ecnEnabled)

    if maxDatagram < 0:
        setLastError("set_msquic_settings: maxDatagram must be non-negative")
        return false
    if minMtu < 0 || maxMtu < 0:
        setLastError("set_msquic_settings: mtu must be non-negative")
        return false
    if maxMtu > 0 && minMtu > 0 && maxMtu < minMtu:
        setLastError("set_msquic_settings: maximum mtu must be >= minimum mtu")
        return false

    gNodes[idx].msquicAllowDatagram = allowDatagram
    gNodes[idx].msquicMaxDatagram = maxDatagram
    gNodes[idx].msquicMinMtu = minMtu
    gNodes[idx].msquicMaxMtu = maxMtu
    gNodes[idx].msquicMigrationEnabled = migrationEnabled
    gNodes[idx].msquicEcnEnabled = ecnEnabled

    return true

@exportc("libp2p_get_msquic_settings")
fn libp2p_get_msquic_settings(handle: int64): str =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0 || !gHostUsed[idx]:
        return cStr("{}")

    let out: str =
        "{" +
        "\"allowDatagram\":" + (if gNodes[idx].msquicAllowDatagram: "true" else: "false") + "," +
        "\"maxDatagram\":" + $gNodes[idx].msquicMaxDatagram + "," +
        "\"minimumMtu\":" + $gNodes[idx].msquicMinMtu + "," +
        "\"maximumMtu\":" + $gNodes[idx].msquicMaxMtu + "," +
        "\"migrationEnabled\":" + (if gNodes[idx].msquicMigrationEnabled: "true" else: "false") + "," +
        "\"ecnEnabled\":" + (if gNodes[idx].msquicEcnEnabled: "true" else: "false") +
        "}"
    return cStr(out)

@exportc("libp2p_register_peer_hints")
fn libp2p_register_peer_hints(handle: int64, peerIdPtr: str, addressesJsonPtr: str, sourcePtr: str): bool =
    let _ = sourcePtr
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("register_peer_hints: invalid handle")
        return false

    var peerIdText: str = trimText(cstrToText(peerIdPtr))
    let addressesTextRaw: str = cstrToText(addressesJsonPtr)
    let addressesText: str = if len(addressesTextRaw) > 0: addressesTextRaw else: "[]"
    let addresses: str[] = parseQuotedValues(addressesText)

    var primaryAddr: str
    if len(addresses) > 0:
        primaryAddr = trimText(addresses[0])
    if len(peerIdText) <= 0:
        peerIdText = parsePeerIdFromMultiaddr(primaryAddr)

    if len(peerIdText) > 0:
        storePeerHint(idx, peerIdText, primaryAddr)
        addBootstrapTarget(idx, peerIdText)
        if len(primaryAddr) > 0:
            let _ = mergePeerAddressToHost(idx, peerIdText, primaryAddr)
        return true

    return true

@exportc("libp2p_connect_peer")
fn libp2p_connect_peer(handle: int64, peerIdPtr: str): int32 =
    clearLastError()
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("connect_peer: invalid handle")
        return resultError

    let peerIdText: str = trimText(cstrToText(peerIdPtr))
    if len(peerIdText) <= 0:
        setLastError("connect_peer: missing peerId")
        return resultError

    if connectPeerReal(idx, peerIdText):
        return resultOk

    return resultError

@exportc("libp2p_connect_multiaddr")
fn libp2p_connect_multiaddr(handle: int64, multiaddrPtr: str): int32 =
