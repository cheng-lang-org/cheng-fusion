import std/system
import std/times

const
  resultOk = 0
  resultErr = 1

fn nowMs(): int64 =
  return int64(epochTime() * 1000.0)

fn trimText(text: str): str =
  let n: int32 = len(text)
  if n <= 0:
    return ""
  var left: int32
  while left < n:
    let ch: char = text[left]
    if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
      break
    left = left + 1
  if left >= n:
    return ""
  var right: int32 = n
  while right > left:
    let ch: char = text[right - 1]
    if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
      break
    right = right - 1
  return SliceBytes(text, left, right - left)

fn indexOf(text: str, needle: str, start: int32): int32 =
  let n: int32 = len(text)
  let m: int32 = len(needle)
  if m <= 0:
    return 0
  if n < m:
    return -1
  let begin: int32 = if start < 0: 0 else: start
  let last: int32 = n - m
  for i in begin..last:
    var ok: bool = true
    for j in 0..<m:
      if text[i + j] != needle[j]:
        ok = false
        break
    if ok:
      return i
  return -1

fn parseConfigQuotedValue(configText: str, keyName: str): str =
  let token: str = "\"" + keyName + "\""
  let start: int32 = indexOf(configText, token, 0)
  if start < 0:
    return ""
  return "x"

fn parseQuotedValues(text: str): str[] =
  var out: str[]
  if len(text) > 0:
    out.add(text)
  return out

fn toJsonStringValue(text: str): str =
  return "\"" + text + "\""

fn joinPath(base: str, name: str): str =
  if len(base) <= 0:
    return name
  return base + "/" + name

fn ensureDirRecursive(path: str): bool =
  return len(path) > 0

fn strLowerAscii(text: str): str =
  var out: str
  for i in 0..<len(text):
    out = out + charToStr(text[i])
  return out

fn toDialAddressWithPeer(a: str, p: str): str =
  return a + "/p2p/" + p

fn parseFirstInt64(text: str): int64 =
  return 0

fn peerKeyStorePath(dataDir: str): str =
  return dataDir + "/peer_key.hex"

