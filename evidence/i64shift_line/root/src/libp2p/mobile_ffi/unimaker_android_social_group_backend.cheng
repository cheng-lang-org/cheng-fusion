        return "{\"ok\":false,\"error\":\"invalid_node_handle\"}"
    if taskId == nil:
        return "{\"ok\":false,\"error\":\"task_required\"}"
    return "{\"ok\":false,\"error\":\"task_not_found\"}"

@exportc("social_publish_tasks")
fn social_publish_tasks(handle: int64, scope: cstring, cursor: cstring, limit: int32): cstring =
    if handle != GroupBackendHandle:
        return "{\"items\":[],\"nextCursor\":\"\",\"hasMore\":false,\"error\":\"invalid_node_handle\"}"
    return "{\"items\":[],\"nextCursor\":\"\",\"hasMore\":false,\"totalCount\":0}"

@exportc("social_feed_snapshot")
fn social_feed_snapshot(handle: int64, channel: cstring, cursor: cstring, limit: int32): cstring =
    if handle != GroupBackendHandle:
        return "{\"items\":[],\"nextCursor\":\"\",\"hasMore\":false,\"error\":\"invalid_node_handle\"}"
    let _ = channel
    let _ = cursor
    let _ = limit
    sgDrainListen()
    let items: str = sgInboxGet()
    let json: str =
        "{\"items\":" +
        items +
        ",\"nextCursor\":\"\",\"hasMore\":false,\"totalCount\":" +
        strings.IntToStr(sgJsonArrayCount(items)) +
        "}"
    return sgReturnEnvJson(GroupFeedSnapshotEnvKey, json)

@exportc("social_moments_timeline")
fn social_moments_timeline(handle: int64, cursor: cstring, limit: int32): cstring =
    if handle != GroupBackendHandle:
        return "{\"items\":[],\"nextCursor\":\"\",\"hasMore\":false,\"error\":\"invalid_node_handle\"}"
    return "{\"items\":[],\"nextCursor\":\"\",\"hasMore\":false}"

@exportc("social_content_detail")
fn social_content_detail(handle: int64, contentId: cstring): cstring =
    if handle != GroupBackendHandle:
        return "{\"ok\":false,\"error\":\"invalid_node_handle\"}"
    if contentId == nil:
        return "{\"ok\":false,\"error\":\"content_required\"}"
    return "{\"ok\":false,\"error\":\"content_not_found\"}"

@exportc("social_poll_events")
fn social_poll_events(handle: int64, maxEventsRequested: int32): cstring =
    if handle != GroupBackendHandle:
        return "[]"
    let _ = maxEventsRequested
    sgDrainListen()
    return sgReturnEnvJson(GroupPollEventsEnvKey, sgInboxGet())

# Blocking discovery wait for the Android nodes pump. Same inbox as
# social_poll_events: drain the listen socket, then return 1 when the
# inbox is no longer empty `[]`. 0 on timeout, -1 on a bad handle.
# The listen/inbox path is poll-only (no condvar), so between checks the
# thread sleeps 25ms — that sleep is the honest wait granularity, not a
# Java timer, and this call does not fabricate events.
@exportc("social_wait_discovery")
fn social_wait_discovery(handle: int64, timeoutMs: int32): int32 =
    if handle != GroupBackendHandle:
        return -1
    let deadlineMs: int64 = sgEpochMs() + timeoutMs
    while true:
        sgDrainListen()
        if sgInboxGet() != "[]":
            return 1
        if sgEpochMs() >= deadlineMs:
            return 0
        let _ = sgUsleep(25000)

@exportc("social_wait_discovery_cstr")
fn social_wait_discovery_cstr(handle: int64, timeoutMs: int32): int32 =
    return social_wait_discovery(handle, timeoutMs)

@borrows
fn social_dm_send_text(handle: int64, peerTextRaw: str, conversationTextRaw: str, payloadTextRaw: str): bool =
    if handle != GroupBackendHandle:
        sgSetLastError("social_dm_send: invalid_node_handle")
        return false
    let peerText: str = sgTrim(peerTextRaw)
    let conversationText: str = sgTrim(conversationTextRaw)
    let payloadText: str = sgTrim(payloadTextRaw)
    if len(peerText) <= 0:
        sgSetLastError("social_dm_send: peer_required")
        return false
    if len(conversationText) <= 0:
        sgSetLastError("social_dm_send: conversation_required")
        return false
    if len(payloadText) <= 0:
        sgSetLastError("social_dm_send: payload_required")
        return false
    let localPeer: str = sgGetenvText(GroupPeerIdEnvKey)
    if len(localPeer) <= 0:
        sgSetLastError("social_dm_send: local_peer_missing")
        return false
    var messageId: str = sgParseJsonStringField(payloadText, "messageId")
    if len(messageId) <= 0:
        messageId = sgParseJsonStringField(payloadText, "mid")
    if len(messageId) <= 0:
        messageId = sgParseJsonStringField(payloadText, "id")
    if len(messageId) <= 0:
        sgSetLastError("social_dm_send: message_id_required")
        return false
    var remoteIpv4: str = ""
    var remotePort: int32
    if !sgPayloadSeedRoute(payloadText, remoteIpv4, remotePort):
        sgSetLastError("social_dm_send: missing_route")
        return false
    var timestampMs: int64 = sgParseJsonInt64Field(payloadText, "timestampMs")
    if timestampMs <= 0:
        timestampMs = sgParseJsonInt64Field(payloadText, "timestamp_ms")
    if timestampMs <= 0:
        timestampMs = sgEpochMs()
    let frame: str =
        "MSG|" +
        localPeer +
        "|" +
        conversationText +
        "|" +
        messageId +
        "|" +
        sgHexEncodeText(payloadText) +
        "|" +
        strings.int64ToStr(timestampMs)
    if !sgSendDirectedFrame(remoteIpv4, remotePort, frame):
        sgSetLastError("social_dm_send: sendto_failed")
        return false
    sgAppendSendEvent(peerText, conversationText, messageId, payloadText)
    sgSetLastError("")
    return true

@exportc("social_dm_send")
fn social_dm_send(handle: int64, peerId: cstring, conversationId: cstring, messageJson: cstring): bool =
    if peerId == nil || conversationId == nil || messageJson == nil:
        sgSetLastError("social_dm_send: payload_required")
        return false
    return social_dm_send_text(handle, strFromCStringCopy(peerId), strFromCStringCopy(conversationId), strFromCStringCopy(messageJson))

@exportc("social_dm_send_cstr")
fn social_dm_send_cstr(handle: int64, peerId: cstring, conversationId: cstring, messageJson: cstring): bool =
    return social_dm_send(handle, peerId, conversationId, messageJson)

@exportc("libp2p_string_free")
fn libp2p_string_free(value: cstring) =
    return
