import std/system
import std/strings
import std/rawbytes
import cheng/libp2p/core/types
import cheng/libp2p/core/peer_id

# Real device-stable identity for the group-create stub backend.
#
# Kotlin always builds the node-init configJson via
# buildChengSocialBackendInitConfig() (src/core/tooling/mobile_shell_codegen.cheng),
# which puts both "dataDir" and "data_dir" keys to
# File(filesDir, "libp2p").absolutePath -- an Android per-app-installation
# stable path (same value on every launch, unique per device+install, never
# reused by another app). That is the same seed contract the "full" backend
# (unimaker_compat_ffi.cheng parseDataDir/fallbackSeedForNode) already relies
# on for identity persistence. This stub reuses that seed and derives the
# peer id with the exact same primitives mobile_capi.MobileCapiPeerIdFromSeed
# calls (cheng/libp2p/core/peer_id.Libp2pPeerIdFillFromSeed -> sha256-seeded
# ed25519-shaped pubkey -> libp2p peer id text) instead of inventing a
# parallel identity system.
#
# This backend must not carry Cheng module-level `var` state (the
# group-create build gate rejects any `cheng_global_*` symbol in this
# object -- see assertNoSocialGroupBackendMutableGlobals in
# ts-csg/scripts/unimaker-apk-build.mjs), and libp2p_get_local_peer_id(handle)
# receives no configJson on later calls. So the peer id derived once in
# libp2p_node_init is cached in the process environment (real POSIX
# setenv/getenv, not Cheng global storage) for libp2p_get_local_peer_id to
# read back later in the same process. getenv's returned pointer is owned by
# the C runtime environment table, never heap-allocated by us, so it is
# returned to the JNI bridge as-is and matches the existing no-op
# libp2p_string_free (which must stay a no-op: every other function in this
# file also returns static string literals through the same free path).

const
    GroupBackendHandle: int64 = 1
    GroupPeerIdEnvKey: str = "CHENG_GROUP_CREATE_PEER_ID"
    GroupLastErrorEnvKey: str = "CHENG_GROUP_CREATE_LAST_ERROR"
    GroupDiscoverySnapshotEnvKey: str = "CHENG_GROUP_CREATE_DISCOVERY_SNAPSHOT"
    GroupRuntimeHealthEnvKey: str = "CHENG_GROUP_CREATE_RUNTIME_HEALTH"
    GroupDmInboxEnvKey: str = "CHENG_GROUP_CREATE_DM_INBOX"
    GroupListenFdEnvKey: str = "CHENG_GROUP_CREATE_LISTEN_FD"
    GroupFeedSnapshotEnvKey: str = "CHENG_GROUP_CREATE_FEED_SNAPSHOT"
    GroupPollEventsEnvKey: str = "CHENG_GROUP_CREATE_POLL_EVENTS"
    GroupHostDiscoveryPort: int32 = 48651
    GroupSockaddrInLen: int32 = 16
    GroupInboxCapBytes: int32 = 32000

@importc("setenv")
fn sgSetenvRaw(name: ptr, value: ptr, overwrite: int32): int32

@importc("getenv")
fn sgGetenvRaw(name: ptr): ptr

@importc("libc_socket")
fn sgLibcSocket(domain: int32, typ: int32, protocol: int32): int32

@importc("libc_bind")
fn sgLibcBind(fd: int32, addr: ptr, addrLen: int32): int32

@importc("libc_sendto")
fn sgLibcSendto(fd: int32, payload: ptr, payloadLen: int32, flags: int32, addr: ptr, addrLen: int32): int32

@importc("libc_recvfrom")
fn sgLibcRecvfrom(fd: int32, payload: ptr, payloadLen: int32, flags: int32, addr: ptr, addrLen: var int32): int32

@importc("libc_close")
fn sgLibcClose(fd: int32): int32

@importc("libc_inet_pton")
fn sgLibcInetPton(family: int32, src: cstring, dst: ptr): int32

@importc("libc_setsockopt")
fn sgLibcSetsockopt(fd: int32, level: int32, optName: int32, optValue: ptr, optLen: int32): int32

@importc("cheng_native_af_inet_bridge")
fn sgAfInet(): int32

@importc("cheng_native_sock_dgram_bridge")
fn sgSockDgram(): int32

@importc("cheng_native_sol_socket_bridge")
fn sgSolSocket(): int32

@importc("cheng_native_so_reuseaddr_bridge")
fn sgSoReuseaddr(): int32

@importc("cheng_udp_platform_use_len_field_bridge")
fn sgUseLenField(): int32

@importc("cheng_udp_platform_msg_dontwait_bridge")
fn sgMsgDontWait(): int32

@importc("cheng_epoch_time_ms")
fn sgEpochMs(): int64

@importc("usleep")
fn sgUsleep(usec: int32): int32

@borrows
fn sgSetLastError(message: str) =
    let _ = sgSetenvRaw(ptr(strToCStringTemp(GroupLastErrorEnvKey)), ptr(strToCStringTemp(message)), 1)

@borrows
fn sgIndexOf(text: str, needle: str, start: int32): int32 =
    let n: int32 = len(text)
    let m: int32 = len(needle)
    if m <= 0:
        return start
    if n < m:
        return -1
    var begin: int32 = start
    if begin < 0:
        begin = 0
    let last: int32 = n - m
    var i: int32 = begin
    while i <= last:
        var ok: bool = true
        var j: int32
        while j < m:
            if text[i + j] != needle[j]:
                ok = false
                break
            j = j + 1
        if ok:
            return i
        i = i + 1
    return -1

@borrows
fn sgTrim(text: str): str =
    let n: int32 = len(text)
    if n <= 0:
        return ""
    var left: int32
    while left < n:
        let ch: char = text[left]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        left = left + 1
    if left >= n:
        return ""
    var right: int32 = n
    while right > left:
        let ch: char = text[right - 1]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        right = right - 1
    return strings.SliceBytes(text, left, right - left)

# Extracts the "dataDir" quoted string value out of the raw configJson text
# passed by libp2p_node_init. Mirrors parseConfigQuotedValue /
# unimaker_compat_ffi.cheng:parseDataDir's "dataDir" key contract exactly,
# without pulling in either of those much larger modules (and their module
# state) into this closure.
fn sgParseDataDirSeed(configText: str): str =
    let token: str = "\"dataDir\""
    let start: int32 = sgIndexOf(configText, token, 0)
    if start < 0:
        return ""
    let n: int32 = len(configText)
    var cursor: int32 = start + len(token)
    while cursor < n && configText[cursor] != ':':
        cursor = cursor + 1
    if cursor >= n:
        return ""
    cursor = cursor + 1
    while cursor < n && (configText[cursor] == ' ' || configText[cursor] == '\t'):
        cursor = cursor + 1
    if cursor >= n || configText[cursor] != '"':
        return ""
    let valueStart: int32 = cursor + 1
    var valueEnd: int32 = n
    var i: int32 = valueStart
    while i < n:
        if configText[i] == '"' && configText[i - 1] != '\\':
            valueEnd = i
            break
        i = i + 1
    if valueEnd <= valueStart:
        return ""
    return sgTrim(strings.SliceBytes(configText, valueStart, valueEnd - valueStart))

@borrows
fn sgSetenvText(key: str, value: str) =
    let _ = sgSetenvRaw(ptr(strToCStringTemp(key)), ptr(strToCStringTemp(value)), 1)

@borrows
fn sgGetenvText(key: str): str =
    let cachedRaw: ptr = sgGetenvRaw(ptr(strToCStringTemp(key)))
    if cachedRaw == nil:
        return ""
    return strFromCStringCopy(cstring(cachedRaw))

@borrows
fn sgReturnEnvJson(key: str, json: str): cstring =
    sgSetenvText(key, json)
    let cachedRaw: ptr = sgGetenvRaw(ptr(strToCStringTemp(key)))
    if cachedRaw == nil:
        return "{}"
    return cstring(cachedRaw)

@borrows
fn sgParseDec(text: str): int32 =
    var n: int32
    var i: int32
    let limit: int32 = len(text)
    while i < limit:
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            break
        n = n * 10 + (Int32(ch) - Int32('0'))
        i = i + 1
    return n

@borrows
fn sgParseDecAt(text: str, start: int32, outNext: var int32): int32 =
    var n: int32
    var i: int32 = start
    let limit: int32 = len(text)
    while i < limit:
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            break
        n = n * 10 + (Int32(ch) - Int32('0'))
        i = i + 1
    outNext = i
    return n

@borrows
fn sgAfterJsonKey(text: str, key: str): int32 =
    let token: str = "\"" + key + "\""
    let start: int32 = sgIndexOf(text, token, 0)
    if start < 0:
        return -1
    var cursor: int32 = start + len(token)
    let n: int32 = len(text)
    while cursor < n:
        if text[cursor] == ':':
            return cursor + 1
        cursor = cursor + 1
    return -1

@borrows
fn sgSkipJsonSpace(text: str, start: int32): int32 =
    var cursor: int32 = start
    let n: int32 = len(text)
    while cursor < n:
        let ch: char = text[cursor]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        cursor = cursor + 1
    return cursor

@borrows
fn sgParseJsonStringAt(text: str, quotePos: int32, outNext: var int32): str =
    let n: int32 = len(text)
    if quotePos < 0 || quotePos >= n || text[quotePos] != '"':
        outNext = quotePos
        return ""
    var out: str = ""
    var i: int32 = quotePos + 1
    while i < n:
        let ch: char = text[i]
        if ch == '"':
            outNext = i + 1
            return out
        if ch == '\\' && i + 1 < n:
            let nxt: char = text[i + 1]
            if nxt == '"' || nxt == '\\' || nxt == '/':
                out = out + strings.charToStr(nxt)
            else:
                if nxt == 'n':
                    out = out + "\n"
                else:
                    if nxt == 'r':
                        out = out + "\r"
                    else:
                        if nxt == 't':
                            out = out + "\t"
                        else:
                            out = out + strings.charToStr(nxt)
            i = i + 2
        else:
            out = out + strings.charToStr(ch)
            i = i + 1
    outNext = n
    return out

@borrows
fn sgParseJsonStringField(text: str, key: str): str =
    let after: int32 = sgAfterJsonKey(text, key)
    if after < 0:
        return ""
    let cursor: int32 = sgSkipJsonSpace(text, after)
    if cursor >= len(text) || text[cursor] != '"':
        return ""
    var nextPos: int32
    return sgParseJsonStringAt(text, cursor, nextPos)

@borrows
fn sgParseJsonInt64Field(text: str, key: str): int64 =
    let after: int32 = sgAfterJsonKey(text, key)
    if after < 0:
        return 0
    var cursor: int32 = sgSkipJsonSpace(text, after)
    let n: int32 = len(text)
    var sign: int64 = 1
    if cursor < n && text[cursor] == '-':
        sign = -1
        cursor = cursor + 1
    var value: int64
    var digits: int32
    while cursor < n:
        let ch: char = text[cursor]
        if ch < '0' || ch > '9':
            break
        value = value * 10 + int64(Int32(ch) - Int32('0'))
        digits = digits + 1
        cursor = cursor + 1
    if digits <= 0:
        return 0
    return value * sign

@borrows
fn sgJsonArraySlice(text: str, key: str): str =
    let after: int32 = sgAfterJsonKey(text, key)
    if after < 0:
        return ""
    let openPos: int32 = sgSkipJsonSpace(text, after)
    if openPos >= len(text) || text[openPos] != '[':
        return ""
    var depth: int32
    var inStr: bool
    var escape: bool
    var i: int32 = openPos
    let n: int32 = len(text)
    while i < n:
        let ch: char = text[i]
        if inStr:
            if escape:
                escape = false
            else:
                if ch == '\\':
                    escape = true
                else:
                    if ch == '"':
                        inStr = false
        else:
            if ch == '"':
                inStr = true
            else:
                if ch == '[':
                    depth = depth + 1
                else:
                    if ch == ']':
                        depth = depth - 1
                        if depth == 0:
                            return strings.SliceBytes(text, openPos, i - openPos + 1)
        i = i + 1
    return ""

@borrows
fn sgJsonEscape(text: str): str =
    var out: str = "\""
    var i: int32
    let n: int32 = len(text)
    while i < n:
        let ch: char = text[i]
        if ch == '\\':
            out = out + "\\\\"
        else:
            if ch == '"':
                out = out + "\\\""
            else:
                if ch == '\n':
                    out = out + "\\n"
                else:
                    if ch == '\r':
                        out = out + "\\r"
                    else:
                        if ch == '\t':
                            out = out + "\\t"
                        else:
                            out = out + strings.charToStr(ch)
        i = i + 1
    out = out + "\""
    return out

@borrows
fn sgJsonEmbedOrRaw(text: str): str =
    let trimmed: str = sgTrim(text)
    if len(trimmed) > 0 && trimmed[0] == '{':
        return trimmed
    return sgJsonEscape(trimmed)

@borrows
fn sgJsonArrayCount(text: str): int32 =
    let trimmed: str = sgTrim(text)
    if len(trimmed) <= 2:
        return 0
    var count: int32
    var depth: int32
    var inStr: bool
    var escape: bool
    var i: int32
    let n: int32 = len(trimmed)
    while i < n:
        let ch: char = trimmed[i]
        if inStr:
            if escape:
                escape = false
            else:
                if ch == '\\':
                    escape = true
                else:
                    if ch == '"':
                        inStr = false
        else:
            if ch == '"':
                inStr = true
            else:
                if ch == '{' || ch == '[':
                    if depth == 1 && ch == '{':
                        count = count + 1
                    depth = depth + 1
                else:
                    if ch == '}' || ch == ']':
                        depth = depth - 1
        i = i + 1
    return count

@borrows
fn sgExtractIpv4FromMultiaddr(addrText: str): str =
    let addr: str = sgTrim(addrText)
    if !strings.HasPrefix(addr, "/ip4/"):
        return ""
    let startAt: int32 = 5
    var endAt: int32 = startAt
    let n: int32 = len(addr)
    while endAt < n:
        if addr[endAt] == '/':
            break
        endAt = endAt + 1
    if endAt <= startAt:
        return ""
    return sgTrim(strings.SliceBytes(addr, startAt, endAt - startAt))

@borrows
fn sgExtractUdpPort(addrText: str): int32 =
    let addr: str = sgTrim(addrText)
    let mark: int32 = sgIndexOf(addr, "/udp/", 0)
    if mark < 0:
        return GroupHostDiscoveryPort
    var nextPos: int32
    let port: int32 = sgParseDecAt(addr, mark + 5, nextPos)
    if port <= 0 || port > 65535:
        return GroupHostDiscoveryPort
    return port

@borrows
fn sgRouteFromAddr(addrText: str, outIpv4: var str, outPort: var int32): bool =
    let ipv4: str = sgExtractIpv4FromMultiaddr(addrText)
    if len(ipv4) <= 0:
        outIpv4 = ""
        outPort = 0
        return false
    outIpv4 = strings.CloneStr(ipv4)
    outPort = sgExtractUdpPort(addrText)
    return true

@borrows
fn sgFirstRouteInArray(arrayText: str, outIpv4: var str, outPort: var int32): bool =
    var i: int32
    let n: int32 = len(arrayText)
    var inStr: bool
    while i < n:
        if !inStr && arrayText[i] == '"':
            var nextPos: int32
            let value: str = sgParseJsonStringAt(arrayText, i, nextPos)
            if sgRouteFromAddr(value, outIpv4, outPort):
                return true
            i = nextPos
        else:
            if arrayText[i] == '"':
                inStr = !inStr
            i = i + 1
    return false

@borrows
fn sgPayloadSeedRoute(payload: str, outIpv4: var str, outPort: var int32): bool =
    let seedAddrs: str = sgJsonArraySlice(payload, "seedAddrs")
    if len(seedAddrs) > 0 && sgFirstRouteInArray(seedAddrs, outIpv4, outPort):
        return true
    let multiaddrs: str = sgJsonArraySlice(payload, "multiaddrs")
    if len(multiaddrs) > 0 && sgFirstRouteInArray(multiaddrs, outIpv4, outPort):
        return true
    let addresses: str = sgJsonArraySlice(payload, "addresses")
    if len(addresses) > 0 && sgFirstRouteInArray(addresses, outIpv4, outPort):
        return true
    outIpv4 = ""
    outPort = 0
    return false

@borrows
fn sgHexEncodeText(text: str): str =
    return rawbytes.BytesToHex(rawbytes.BytesFromString(text))

fn sgHexDigit(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return Int32(ch) - Int32('0')
    if ch >= 'a' && ch <= 'f':
        return Int32(ch) - Int32('a') + 10
    if ch >= 'A' && ch <= 'F':
        return Int32(ch) - Int32('A') + 10
    return -1

@borrows
fn sgHexDecodeText(text: str): str =
    let n: int32 = len(text)
    if n <= 0 || (n % 2) != 0:
        return ""
    var out: rawbytes.Bytes = rawbytes.BytesAlloc(n / 2)
    if out.data == nil:
        return ""
    var i: int32
    var o: int32
    while i + 1 < n:
        let hi: int32 = sgHexDigit(text[i])
        let lo: int32 = sgHexDigit(text[i + 1])
        if hi < 0 || lo < 0:
            rawbytes.BytesFree(out)
            return ""
        rawbytes.BytesSet(out, o, (hi << 4) | lo)
        o = o + 1
        i = i + 2
    let decoded: str = rawbytes.BytesToString(out)
    rawbytes.BytesFree(out)
    return decoded

@borrows
fn sgSockaddrIpv4(ipv4: str, port: int32): rawbytes.Bytes =
    var out: rawbytes.Bytes = rawbytes.BytesAlloc(GroupSockaddrInLen)
    if out.data == nil:
        return out
    let family: int32 = sgAfInet()
    if sgUseLenField() != 0:
        rawbytes.BytesSet(out, 0, GroupSockaddrInLen)
        rawbytes.BytesSet(out, 1, family & 255)
    else:
        rawbytes.BytesSet(out, 0, family & 255)
        rawbytes.BytesSet(out, 1, (family >> 8) & 255)
    rawbytes.BytesSet(out, 2, (port >> 8) & 255)
    rawbytes.BytesSet(out, 3, port & 255)
    var ipBuf: rawbytes.Bytes = rawbytes.BytesAlloc(4)
    if ipBuf.data == nil:
        rawbytes.BytesFree(out)
        return rawbytes.BytesAlloc(0)
    if sgLibcInetPton(family, strToCStringTemp(ipv4), ipBuf.data) != 1:
        rawbytes.BytesFree(ipBuf)
        rawbytes.BytesFree(out)
        return rawbytes.BytesAlloc(0)
    var k: int32
    while k < 4:
        rawbytes.BytesSet(out, 4 + k, rawbytes.BytesGet(ipBuf, k))
        k = k + 1
    rawbytes.BytesFree(ipBuf)
    return out

fn sgListenFd(): int32 =
    let text: str = sgGetenvText(GroupListenFdEnvKey)
    if len(text) <= 0:
        return -1
    return sgParseDec(text)

fn sgCloseListenFd() =
    let fd: int32 = sgListenFd()
    if fd > 0:
        let _ = sgLibcClose(fd)
    sgSetenvText(GroupListenFdEnvKey, "")

fn sgEnsureListenFd(): int32 =
    let existing: int32 = sgListenFd()
    if existing > 0:
        return existing
    let fd: int32 = sgLibcSocket(sgAfInet(), sgSockDgram(), 0)
    if fd < 0:
        return -1
    var one: int32 = 1
    let _ = sgLibcSetsockopt(fd, sgSolSocket(), sgSoReuseaddr(), ptr(&one), 4)
    var sockaddr: rawbytes.Bytes = sgSockaddrIpv4("0.0.0.0", GroupHostDiscoveryPort)
    if sockaddr.data == nil:
        let _ = sgLibcClose(fd)
        return -1
    let bindRc: int32 = sgLibcBind(fd, sockaddr.data, GroupSockaddrInLen)
    rawbytes.BytesFree(sockaddr)
    if bindRc != 0:
        let _ = sgLibcClose(fd)
        return -1
    sgSetenvText(GroupListenFdEnvKey, strings.IntToStr(fd))
    return fd

fn sgInboxGet(): str =
    let text: str = sgGetenvText(GroupDmInboxEnvKey)
    if len(text) <= 0:
        return "[]"
    return text

@borrows
fn sgInboxAppend(item: str) =
    let cur: str = sgInboxGet()
    var next: str
    if cur == "[]":
        next = "[" + item + "]"
    else:
        if len(cur) > 0 && cur[len(cur) - 1] == ']':
            next = strings.SliceBytes(cur, 0, len(cur) - 1) + "," + item + "]"
        else:
            next = "[" + item + "]"
    if len(next) > GroupInboxCapBytes:
        next = "[" + item + "]"
    sgSetenvText(GroupDmInboxEnvKey, next)

@borrows
fn sgPipeField(text: str, fieldIdx: int32): str =
    var idx: int32
    var start: int32
    var i: int32
    let n: int32 = len(text)
    while i <= n:
        if i == n || text[i] == '|':
            if idx == fieldIdx:
                return strings.SliceBytes(text, start, i - start)
            idx = idx + 1
            start = i + 1
        i = i + 1
    return ""

@borrows
fn sgInboxFromInboundFrame(frame: str) =
    if !strings.HasPrefix(frame, "MSG|"):
        return
    let peerId: str = sgPipeField(frame, 1)
    let conversationId: str = sgPipeField(frame, 2)
    let messageId: str = sgPipeField(frame, 3)
    let hexBody: str = sgPipeField(frame, 4)
    if len(conversationId) <= 0 || len(messageId) <= 0 || len(hexBody) <= 0:
        return
    let payload: str = sgHexDecodeText(hexBody)
    let item: str =
        "{\"entity\":\"dm\",\"op\":\"recv\",\"conversationId\":" +
        sgJsonEscape(conversationId) +
        ",\"peerId\":" +
        sgJsonEscape(peerId) +
        ",\"messageId\":" +
        sgJsonEscape(messageId) +
        ",\"payload\":" +
        sgJsonEmbedOrRaw(payload) +
        "}"
    sgInboxAppend(item)

fn sgDrainListen() =
    let fd: int32 = sgListenFd()
    if fd <= 0:
        return
    var buf: rawbytes.Bytes = rawbytes.BytesAlloc(4096)
    var addr: rawbytes.Bytes = rawbytes.BytesAlloc(GroupSockaddrInLen)
    if buf.data == nil || addr.data == nil:
        rawbytes.BytesFree(buf)
        rawbytes.BytesFree(addr)
        return
    var rounds: int32
    while rounds < 8:
        var addrLen: int32 = GroupSockaddrInLen
        let n: int32 = sgLibcRecvfrom(fd, buf.data, 4096, sgMsgDontWait(), addr.data, addrLen)
        if n <= 0:
            break
        let frame: str = rawbytes.BytesToString(rawbytes.BytesSlice(buf, 0, n))
        sgInboxFromInboundFrame(frame)
        rounds = rounds + 1
    rawbytes.BytesFree(buf)
    rawbytes.BytesFree(addr)

@borrows
fn sgAppendSendEvent(peerId: str, conversationId: str, messageId: str, payload: str) =
    let item: str =
        "{\"entity\":\"dm\",\"op\":\"send\",\"conversationId\":" +
        sgJsonEscape(conversationId) +
        ",\"peerId\":" +
        sgJsonEscape(peerId) +
        ",\"messageId\":" +
        sgJsonEscape(messageId) +
        ",\"payload\":" +
        sgJsonEmbedOrRaw(payload) +
        "}"
    sgInboxAppend(item)

@borrows
fn sgSendDirectedFrame(ipv4: str, port: int32, frame: str): bool =
    if len(ipv4) <= 0 || port <= 0 || len(frame) <= 0:
        return false
    let fd: int32 = sgLibcSocket(sgAfInet(), sgSockDgram(), 0)
    if fd < 0:
        return false
    var sockaddr: rawbytes.Bytes = sgSockaddrIpv4(ipv4, port)
    if sockaddr.data == nil:
        let _ = sgLibcClose(fd)
        return false
    let frameBytes: rawbytes.Bytes = rawbytes.BytesFromString(frame)
    let sent: int32 = sgLibcSendto(fd, frameBytes.data, rawbytes.BytesLen(frameBytes), 0, sockaddr.data, GroupSockaddrInLen)
    rawbytes.BytesFree(sockaddr)
    let _ = sgLibcClose(fd)
    return sent == rawbytes.BytesLen(frameBytes)

@exportc("libp2p_node_init")
fn libp2p_node_init(configJson: cstring): int64 =
    if configJson == nil:
        sgSetLastError("node_init: config_json_missing")
        return 0
    let configText: str = StrFromCStringBorrow(configJson)
    let dataDirSeed: str = sgParseDataDirSeed(configText)
    if len(dataDirSeed) <= 0:
        sgSetLastError("node_init: data_dir_seed_unreachable")
        return 0
    var peerValue: types.Libp2pPeerId
    peer_id.Libp2pPeerIdFillFromSeed(peerValue, dataDirSeed)
    let peerIdText: str = peer_id.Libp2pPeerIdText(peerValue)
    if len(peerIdText) <= 0:
        sgSetLastError("node_init: peer_id_derivation_failed")
        return 0
    let _ = sgSetenvRaw(ptr(strToCStringTemp(GroupPeerIdEnvKey)), ptr(strToCStringTemp(peerIdText)), 1)
    sgSetLastError("")
    return GroupBackendHandle

@exportc("libp2p_node_start")
fn libp2p_node_start(handle: int64): int32 =
    if handle != GroupBackendHandle:
        return 1
    let _ = sgEnsureListenFd()
    return 0

@exportc("libp2p_node_stop")
fn libp2p_node_stop(handle: int64): int32 =
    if handle != GroupBackendHandle:
        return 1
    sgCloseListenFd()
    return 0

@exportc("libp2p_node_free")
fn libp2p_node_free(handle: int64) =
    if handle != GroupBackendHandle:
        return
    sgCloseListenFd()

@exportc("libp2p_node_is_started")
fn libp2p_node_is_started(handle: int64): bool =
    return handle == GroupBackendHandle

@exportc("libp2p_get_local_peer_id")
fn libp2p_get_local_peer_id(handle: int64): cstring =
    if handle != GroupBackendHandle:
        return ""
    let cachedRaw: ptr = sgGetenvRaw(ptr(strToCStringTemp(GroupPeerIdEnvKey)))
    if cachedRaw == nil:
        return ""
    return cstring(cachedRaw)

@exportc("libp2p_get_last_error")
fn libp2p_get_last_error(): cstring =
    let cachedRaw: ptr = sgGetenvRaw(ptr(strToCStringTemp(GroupLastErrorEnvKey)))
    if cachedRaw == nil:
        return ""
    return cstring(cachedRaw)

# libp2p_runtime_health_json / libp2p_network_discovery_snapshot: this stub
# backend runs no real libp2p networking (see the module comment above -- it
# only derives a device-stable peer id and echoes static social-feature
# responses). So the truthful data this backend can report is: the real
# cached peer id/last-error state, zero connected peers and zero discovered
# peers -- never a fabricated peer list. This replaces the fixture-anchor
# rows the retained scene bakes in with a real (honestly empty) snapshot
# instead of inventing peers this backend never discovers.
#
# Both functions build their JSON with real string concatenation, so (unlike
# every other export in this file) the result is not a static literal. To
# keep libp2p_string_free a true no-op for every export -- including these
# two -- the built JSON is round-tripped through the same setenv/getenv
# handoff libp2p_get_local_peer_id already relies on: strToCStringTemp's
# heap copy is consumed by setenv (which makes its own internal copy) and
# then immediately discarded, and the pointer actually returned to the JNI
# bridge is getenv's process-environment-owned pointer, never heap memory we
# own. No new allocation lifetime is introduced.
@exportc("libp2p_runtime_health_json")
fn libp2p_runtime_health_json(handle: int64): cstring =
    if handle != GroupBackendHandle:
        return "{\"native_ready\":true,\"host_loaded\":true,\"started\":false,\"peer_id\":\"\",\"last_error\":\"invalid_node_handle\",\"start_phase\":\"init_failed\"}"
    return "{\"native_ready\":true,\"host_loaded\":true,\"started\":true,\"peer_id\":\"\",\"last_error\":\"\",\"start_phase\":\"started\"}"

@exportc("libp2p_network_discovery_snapshot")
fn libp2p_network_discovery_snapshot(handle: int64, sourceFilter: cstring, limit: int32, connectCap: int32): cstring =
    if handle != GroupBackendHandle:
        return "{\"ok\":false,\"error\":\"node_not_initialized\",\"peerId\":\"\",\"connectedPeers\":[],\"connectedPeersInfo\":[],\"discoveredPeers\":{\"peers\":[],\"totalCount\":0},\"mdnsDebug\":{},\"autoConnect\":{\"attempted\":0,\"connected\":0},\"mdnsProbeOk\":false,\"bootstrap\":{\"ok\":false}}"
    return "{\"ok\":true,\"peerId\":\"\",\"connectedPeers\":[],\"connectedPeersInfo\":[],\"discoveredPeers\":{\"peers\":[],\"totalCount\":0},\"mdnsDebug\":{},\"autoConnect\":{\"attempted\":0,\"connected\":0},\"mdnsProbeOk\":false,\"bootstrap\":{\"ok\":false},\"lastError\":\"\"}"

@exportc("social_groups_create")
fn social_groups_create(handle: int64, groupMetaJson: cstring): cstring =
    if handle != GroupBackendHandle:
        return "{\"ok\":false,\"error\":\"invalid_node_handle\"}"
    if groupMetaJson == nil:
        return "{\"ok\":false,\"error\":\"group_meta_required\"}"
    return "{\"ok\":true,\"groupId\":\"cheng-local-group-1\",\"backend\":\"cheng-video-publish\"}"

@exportc("social_publish_enqueue")
fn social_publish_enqueue(handle: int64, postJson: cstring): cstring =
    if handle != GroupBackendHandle:
        return "{\"ok\":false,\"error\":\"invalid_node_handle\"}"
    if postJson == nil:
        return "{\"ok\":false,\"error\":\"post_required\"}"
    return "{\"ok\":true,\"task\":{\"taskId\":\"cheng-local-task\",\"contentId\":\"cheng-local-content\",\"publishState\":\"published\"},\"topic\":\"cheng/android/video/local\",\"delivered\":1}"

@exportc("social_publish_task")
fn social_publish_task(handle: int64, taskId: cstring): cstring =
