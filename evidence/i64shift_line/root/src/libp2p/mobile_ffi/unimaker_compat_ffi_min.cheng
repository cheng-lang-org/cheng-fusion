# Lightweight mobile ffi for smoke/verification paths.

import std/system
import std/times

const
    resultOk = 0
    resultErr = 1
    maxNodes = 16
    maxPeerHints = 128
    maxConnectedPeers = 128
    maxNodeEvents = 128
    maxPseudoFiles = 512
    defaultListenAddr = "/ip4/0.0.0.0/udp/4001/quic-v1"
    defaultDataDir = "/tmp/cheng-libp2p-mobile"

type
    NodeState =
        used: bool
        handle: int64
        started: bool
        dataDir: str
        listenAddr: str
        peerId: str
        privateKeyHex: str
        mdnsEnabled: bool

        msquicAllowDatagram: bool
        msquicMaxDatagram: int32
        msquicMinMtu: int32
        msquicMaxMtu: int32
        msquicMigrationEnabled: bool
        msquicEcnEnabled: bool

        hintCount: int32
        hintPeerIds: str[maxPeerHints]
        hintAddresses: str[maxPeerHints]

        connectedCount: int32
        connectedPeers: str[maxConnectedPeers]

        bootstrapDialAttempted: int64
        bootstrapDialConnected: int64

        eventCount: int32
        events: str[maxNodeEvents]

var
    lastErrorText: str
    nodeHandleSeq: int64 = 1
    keyGenSeq: int64 = 1
    nodes: NodeState[maxNodes]

    pseudoFileCount: int32
    pseudoFilePaths: str[maxPseudoFiles]
    pseudoFileBodies: str[maxPseudoFiles]

fn cStr(text: str): cstring =
    return text

fn setLastError(text: str) =
    lastErrorText = text

fn nowMs(): int64 =
    return int64(epochTime() * 1000.0)

fn trimText(text: str): str =
    let n: int32 = len(text)
    if n <= 0:
        return ""
    var left: int32
    while left < n:
        let ch: char = text[left]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        left = left + 1
    if left >= n:
        return ""
    var right: int32 = n
    while right > left:
        let ch: char = text[right - 1]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        right = right - 1
    return SliceBytes(text, left, right - left)

fn strLowerAscii(text: str): str =
    var out: str
    for i in 0..<len(text):
        let ch: char = text[i]
        if ch >= 'A' && ch <= 'Z':
            out = out + charToStr(chr(ord(ch) + 32))
        else:
            out = out + charToStr(ch)
    return out

fn indexOf(text: str, needle: str, start: int32): int32 =
    let n: int32 = len(text)
    let m: int32 = len(needle)
    if m <= 0:
        if start < 0:
            return 0
        if start > n:
            return n
        return start
    if n < m:
        return -1
    let begin: int32 =
        if start < 0:
            0
        else:
            start
    let last: int32 = n - m
    for i in begin..last:
        var ok: bool = true
        for j in 0..<m:
            if text[i + j] != needle[j]:
                ok = false
                break
        if ok:
            return i
    return -1

fn joinPath(base: str, name: str): str =
    let left: str = trimText(base)
    let right: str = trimText(name)
    if len(left) <= 0:
        return right
    if len(right) <= 0:
        return left
    if left[len(left) - 1] == '/':
        return left + right
    return left + "/" + right

fn isHexDigit(ch: char): bool =
    if ch >= '0' && ch <= '9':
        return true
    if ch >= 'a' && ch <= 'f':
        return true
    if ch >= 'A' && ch <= 'F':
        return true
    return false

fn validatePrivateKeyHex(text: str): bool =
    let raw: str = trimText(text)
    let n: int32 = len(raw)
    if n < 64 || (n % 2) != 0:
        return false
    for i in 0..<n:
        if !isHexDigit(raw[i]):
            return false
    return true

fn hexChar(v: int32): char =
    let x: int32 = v & 15
    if x < 10:
        return chr(ord('0') + x)
    return chr(ord('a') + (x - 10))

fn byteToHex(v: int32): str =
    let safe: int32 = v & 255
    return charToStr(hexChar(safe / 16)) + charToStr(hexChar(safe % 16))

fn pseudoPrivateKeyHex(seedText: str): str =
    var state: int64 = int64(1469598103934665603)
    let seedLen: int32 = len(seedText)
    for i in 0..<seedLen:
        state = state ^ int64(ord(seedText[i]))
        state = state * int64(1099511628211)
    var out: str
    for i in 0..<64:
        state = state * int64(1103515245) + int64(12345 + i)
        let b: int32 = int32((state >> 16) & 255)
        out = out + byteToHex(b)
    return out

fn derivePeerId(privateKeyHex: str): str =
    let raw: str = strLowerAscii(trimText(privateKeyHex))
    if len(raw) <= 0:
        return ""
    var body: str = raw
    if len(body) > 46:
        body = SliceBytes(body, 0, 46)
    return "12D3KooW" + body

fn toJsonStringValue(text: str): str =
    var out: str = "\""
    for i in 0..<len(text):
        let ch: char = text[i]
        if ch == '\\':
            out = out + "\\\\"
        elif ch == '"':
            out = out + "\\\""
        elif ch == '\n':
            out = out + "\\n"
        elif ch == '\r':
            out = out + "\\r"
        elif ch == '\t':
            out = out + "\\t"
        else:
            out = out + charToStr(ch)
    out = out + "\""
    return out

fn parseFirstInt64(text: str): int64 =
    let n: int32 = len(text)
    if n <= 0:
        return 0
    var start: int32 = -1
    for i in 0..<n:
        let ch: char = text[i]
        if ch >= '0' && ch <= '9':
            start = i
            break
    if start < 0:
        return 0
    var out: int64
    for i in start..<n:
        let ch: char = text[i]
        if ch < '0' || ch > '9':
            break
        out = out * 10 + int64(ord(ch) - ord('0'))
    return out

fn parseConfigHasKey(configText: str, keyName: str): bool =
    if len(configText) <= 0 || len(keyName) <= 0:
        return false
    return indexOf(configText, "\"" + keyName + "\"", 0) >= 0

fn parseConfigQuotedValue(configText: str, keyName: str): str =
    let text: str = configText
    let token: str = "\"" + keyName + "\""
    let start: int32 = indexOf(text, token, 0)
    if start < 0:
        return ""
    let n: int32 = len(text)
    var cursor: int32 = start + len(token)
    while cursor < n && text[cursor] != ':':
        cursor = cursor + 1
    if cursor >= n:
        return ""
    cursor = cursor + 1
    while cursor < n:
        let ch: char = text[cursor]
        if ch != ' ' && ch != '\t' && ch != '\n' && ch != '\r':
            break
        cursor = cursor + 1
    if cursor >= n:
        return ""
    if text[cursor] == '"':
        let valueStart: int32 = cursor + 1
        var valueEnd: int32 = n
        for i in valueStart..<n:
            if text[i] == '"' && text[i - 1] != '\\':
                valueEnd = i
                break
        if valueEnd <= valueStart:
            return ""
        return SliceBytes(text, valueStart, valueEnd - valueStart)
    var valueEnd: int32 = cursor
    while valueEnd < n:
        let ch: char = text[valueEnd]
        if ch == ',' || ch == '}' || ch == '\n' || ch == '\r':
            break
        valueEnd = valueEnd + 1
    if valueEnd <= cursor:
        return ""
    return trimText(SliceBytes(text, cursor, valueEnd - cursor))

fn parseQuotedValues(text: str): str[] =
    var values: str[]
    let n: int32 = len(text)
    if n <= 1:
        return values
    var i: int32
    while i < n:
        if text[i] != '"':
            i = i + 1
            continue
        let start: int32 = i + 1
        var endAt: int32 = start
        while endAt < n:
            if text[endAt] == '"' && text[endAt - 1] != '\\':
                break
            endAt = endAt + 1
        if endAt <= start || endAt > n:
            break
        values.add(SliceBytes(text, start, endAt - start))
        i = endAt + 1
    return values

fn toDialAddressWithPeer(listenAddr: str, peerId: str): str =
    let addr: str = trimText(listenAddr)
    let pid: str = trimText(peerId)
    if len(addr) <= 0 || len(pid) <= 0:
        return addr
    if indexOf(addr, "/p2p/", 0) >= 0:
        return addr
    return addr + "/p2p/" + pid

fn pseudoFileIndex(path: str): int32 =
    let p: str = trimText(path)
    if len(p) <= 0:
        return -1
    for i in 0..<pseudoFileCount:
        if pseudoFilePaths[i] == p:
            return i
    return -1

fn fileExists(path: str): bool =
    return pseudoFileIndex(path) >= 0

fn dirExists(path: str): bool =
    return len(trimText(path)) > 0

fn mkdirOne(path: str): bool =
    return len(trimText(path)) > 0

fn ensureDirRecursive(path: str): bool =
    return len(trimText(path)) > 0

fn readFileText(path: str): str =
    let idx: int32 = pseudoFileIndex(path)
    if idx < 0:
        return ""
    return pseudoFileBodies[idx]

fn c_cheng_read_file(path: cstring): cstring =
    return cStr(readFileText(toString(path)))

fn c_cheng_write_file(path: cstring, content: cstring): int32 =
    let p: str = trimText(toString(path))
    if len(p) <= 0:
        return 0
    let body: str = toString(content)
    let idx: int32 = pseudoFileIndex(p)
    if idx >= 0:
        pseudoFileBodies[idx] = body
        return 1
    if pseudoFileCount >= maxPseudoFiles:
        return 0
    pseudoFilePaths[pseudoFileCount] = p
    pseudoFileBodies[pseudoFileCount] = body
    pseudoFileCount = pseudoFileCount + 1
    return 1

fn c_cheng_file_exists(path: cstring): int32 =
    if fileExists(toString(path)):
        return 1
    return 0

fn c_cheng_dir_exists(path: cstring): int32 =
    if dirExists(toString(path)):
        return 1
    return 0

fn c_cheng_mkdir1(path: cstring): int32 =
    if mkdirOne(toString(path)):
        return 0
    return -1

fn peerKeyStorePath(dataDir: str): str =
    return joinPath(trimText(dataDir), "peer_key.hex")

fn findNodeByHandle(handle: int64): int32 =
    if handle <= 0:
        return -1
    for i in 0..<maxNodes:
        if nodes[i].used && nodes[i].handle == handle:
            return i
    return -1

fn findNodeByPeerId(peerId: str): int32 =
    let pid: str = trimText(peerId)
    if len(pid) <= 0:
        return -1
    for i in 0..<maxNodes:
        if nodes[i].used && nodes[i].peerId == pid:
            return i
    return -1

fn findNodeByDialAddr(addrText: str): int32 =
    let target: str = trimText(addrText)
    if len(target) <= 0:
        return -1
    for i in 0..<maxNodes:
        if !nodes[i].used:
            continue
        let candidate: str = toDialAddressWithPeer(nodes[i].listenAddr, nodes[i].peerId)
        if candidate == target:
            return i
    return -1

fn nodeHasConnectedPeer(node: NodeState, peerId: str): bool =
    let pid: str = trimText(peerId)
    if len(pid) <= 0:
        return false
    for i in 0..<node.connectedCount:
        if node.connectedPeers[i] == pid:
            return true
    return false

fn nodeAddConnectedPeer(index: int32, peerId: str): bool =
    if index < 0 || index >= maxNodes || !nodes[index].used:
        return false
    let pid: str = trimText(peerId)
    if len(pid) <= 0:
        return false
    if nodeHasConnectedPeer(nodes[index], pid):
        return true
    if nodes[index].connectedCount >= maxConnectedPeers:
        return false
    nodes[index].connectedPeers[nodes[index].connectedCount] = pid
    nodes[index].connectedCount = nodes[index].connectedCount + 1
    return true

fn nodeSetPeerHint(index: int32, peerId: str, address: str): bool =
    if index < 0 || index >= maxNodes || !nodes[index].used:
        return false
    let pid: str = trimText(peerId)
    let addr: str = trimText(address)
    if len(pid) <= 0 || len(addr) <= 0:
        return false
    for i in 0..<nodes[index].hintCount:
        if nodes[index].hintPeerIds[i] == pid:
            nodes[index].hintAddresses[i] = addr
            return true
    if nodes[index].hintCount >= maxPeerHints:
        return false
    nodes[index].hintPeerIds[nodes[index].hintCount] = pid
    nodes[index].hintAddresses[nodes[index].hintCount] = addr
    nodes[index].hintCount = nodes[index].hintCount + 1
    return true

fn nodeHintAddress(index: int32, peerId: str): str =
    if index < 0 || index >= maxNodes || !nodes[index].used:
        return ""
    let pid: str = trimText(peerId)
    for i in 0..<nodes[index].hintCount:
        if nodes[index].hintPeerIds[i] == pid:
            return nodes[index].hintAddresses[i]
    return ""

fn nodePushEvent(index: int32, name: str) =
    if index < 0 || index >= maxNodes || !nodes[index].used:
        return
    if nodes[index].eventCount >= maxNodeEvents:
        return
    nodes[index].events[nodes[index].eventCount] = name
    nodes[index].eventCount = nodes[index].eventCount + 1

fn jsonStringArray(values: str[], count: int32): str =
    var out: str = "["
    for i in 0..<count:
        if i > 0:
            out = out + ","
        out = out + toJsonStringValue(values[i])
    out = out + "]"
    return out

fn parsePeerIdFromMultiaddr(text: str): str =
    let addr: str = trimText(text)
    let marker: str = "/p2p/"
    let idx: int32 = indexOf(addr, marker, 0)
    if idx < 0:
        return ""
    let start: int32 = idx + len(marker)
    if start >= len(addr):
        return ""
    return trimText(SliceBytes(addr, start, len(addr) - start))

fn applyConnectByPeer(index: int32, peerId: str): bool =
    let peerIdx: int32 = findNodeByPeerId(peerId)
    if peerIdx < 0 || !nodes[peerIdx].started:
        return false
    if !nodeAddConnectedPeer(index, peerId):
        return false
    nodeAddConnectedPeer(peerIdx, nodes[index].peerId)
    return true

fn applyConnectByAddr(index: int32, addrText: str): bool =
    let peerId: str = parsePeerIdFromMultiaddr(addrText)
    if len(peerId) > 0:
        return applyConnectByPeer(index, peerId)
    let peerIdx: int32 = findNodeByDialAddr(addrText)
    if peerIdx < 0 || !nodes[peerIdx].started:
        return false
    if !nodeAddConnectedPeer(index, nodes[peerIdx].peerId):
        return false
    nodeAddConnectedPeer(peerIdx, nodes[index].peerId)
    return true

fn readConfigDataDir(configText: str): str =
    var out: str = trimText(parseConfigQuotedValue(configText, "dataDir"))
    if len(out) <= 0:
        out = trimText(parseConfigQuotedValue(configText, "data_dir"))
    if len(out) <= 0:
        out = defaultDataDir
    return out

fn readConfigListenAddr(configText: str): str =
    var out: str = trimText(parseConfigQuotedValue(configText, "listenAddr"))
    if len(out) <= 0:
        out = trimText(parseConfigQuotedValue(configText, "listen_addr"))
    if len(out) <= 0:
        out = defaultListenAddr
    return out

fn initDefaults(index: int32) =
    nodes[index].mdnsEnabled = true
    nodes[index].msquicAllowDatagram = true
    nodes[index].msquicMaxDatagram = 65535
    nodes[index].msquicMinMtu = 1200
    nodes[index].msquicMaxMtu = 0
    nodes[index].msquicMigrationEnabled = true
    nodes[index].msquicEcnEnabled = false

fn newHandleForSlot(slot: int32): int64 =
    nodeHandleSeq = nodeHandleSeq + 1
    return int64(slot + 1) * int64(1024) + nodeHandleSeq

fn identityJsonWithPrivateKey(privateKeyHex: str): str =
    let pid: str = derivePeerId(privateKeyHex)
    return "{" +
        "\"peerId\":" + toJsonStringValue(pid) + "," +
        "\"privateKey\":" + toJsonStringValue(privateKeyHex) +
        "}"

@exportc("NimMain")
fn NimMain() =
    lastErrorText = ""
    nodeHandleSeq = 1
    keyGenSeq = 1
    pseudoFileCount = 0
    for i in 0..<maxNodes:
        nodes[i] = NodeState()

fn libp2p_get_last_error(): cstring =
    return cStr(lastErrorText)

fn libp2p_generate_identity_json(): cstring =
    keyGenSeq = keyGenSeq + 1
    let keyHex: str = pseudoPrivateKeyHex("generate-" + $nowMs() + "-" + $keyGenSeq)
    setLastError("")
    return cStr(identityJsonWithPrivateKey(keyHex))

fn libp2p_identity_from_seed(seed: cstring, seedLen: int64): cstring =
    seed
    if seedLen <= 0:
        setLastError("identity seed empty")
        return cStr("{}")
    let keyHex: str = pseudoPrivateKeyHex("seed-" + $seedLen)
    setLastError("")
    return cStr(identityJsonWithPrivateKey(keyHex))

fn libp2p_node_init(configJson: cstring): int64 =
    let configText: str =
        if configJson == nil:
            ""
        else:
            trimText(toString(configJson))
    let dataDir: str = readConfigDataDir(configText)
    let listenAddr: str = readConfigListenAddr(configText)
    if !ensureDirRecursive(dataDir):
        setLastError("node init failed: ensure data dir failed")
        return 0

    let keyPath: str = peerKeyStorePath(dataDir)
    var chosenKeyHex: str = trimText(parseConfigQuotedValue(configText, "private_key_hex"))
    if len(chosenKeyHex) <= 0:
        chosenKeyHex = trimText(parseConfigQuotedValue(configText, "privateKeyHex"))

    if len(chosenKeyHex) <= 0 && fileExists(keyPath):
        chosenKeyHex = trimText(readFileText(keyPath))
        if !validatePrivateKeyHex(chosenKeyHex):
            setLastError("persisted private key invalid")
            return 0

    if len(chosenKeyHex) > 0:
        if !validatePrivateKeyHex(chosenKeyHex):
            if fileExists(keyPath):
                setLastError("persisted private key invalid")
            else:
                setLastError("private key invalid")
            return 0
    else:
        keyGenSeq = keyGenSeq + 1
        chosenKeyHex = pseudoPrivateKeyHex("node-" + dataDir + "-" + $keyGenSeq)

    if c_cheng_write_file(keyPath, chosenKeyHex) != 1:
        setLastError("node init failed: key persist failed")
        return 0

    let peerIdText: str = derivePeerId(chosenKeyHex)
    if len(peerIdText) <= 0:
        setLastError("node init failed: peer id derive failed")
        return 0

    var slot: int32 = -1
    for i in 0..<maxNodes:
        if !nodes[i].used:
            slot = i
            break
    if slot < 0:
        setLastError("node init failed: node table full")
        return 0

    nodes[slot] = NodeState(
        used: true,
        handle: newHandleForSlot(slot),
        started: false,
        dataDir: dataDir,
        listenAddr: listenAddr,
        peerId: peerIdText,
        privateKeyHex: chosenKeyHex
    )
    initDefaults(slot)
    setLastError("")
    return nodes[slot].handle

fn libp2p_node_start(handle: int64): int32 =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("node start failed: invalid handle")
        return resultErr
    if !nodes[idx].started:
        nodes[idx].started = true
        nodePushEvent(idx, "host_started")
    setLastError("")
    return resultOk

fn libp2p_node_stop(handle: int64): int32 =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("node stop failed: invalid handle")
        return resultErr
    nodes[idx].started = false
    setLastError("")
    return resultOk

fn libp2p_node_free(handle: int64) =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        return
    nodes[idx] = NodeState()

fn libp2p_get_local_peer_id(handle: int64): cstring =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return cStr("")
    setLastError("")
    return cStr(nodes[idx].peerId)

fn libp2p_get_listen_addresses(handle: int64): cstring =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return cStr("[]")
    var values: str[1]
    values[0] = nodes[idx].listenAddr
    setLastError("")
    return cStr(jsonStringArray(values, 1))

fn libp2p_get_dialable_addresses(handle: int64): cstring =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return cStr("[]")
    let dialAddr: str = toDialAddressWithPeer(nodes[idx].listenAddr, nodes[idx].peerId)
    var values: str[1]
    values[0] = dialAddr
    setLastError("")
    return cStr(jsonStringArray(values, 1))

fn libp2p_set_msquic_settings(handle: int64, settingsJsonPtr: cstring): bool =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return false
    let text: str = toString(settingsJsonPtr)
    if parseConfigHasKey(text, "allowDatagram"):
        nodes[idx].msquicAllowDatagram = strLowerAscii(parseConfigQuotedValue(text, "allowDatagram")) == "true"
    if parseConfigHasKey(text, "maxDatagram"):
        nodes[idx].msquicMaxDatagram = int32(parseFirstInt64(parseConfigQuotedValue(text, "maxDatagram")))
    if parseConfigHasKey(text, "minimumMtu"):
        nodes[idx].msquicMinMtu = int32(parseFirstInt64(parseConfigQuotedValue(text, "minimumMtu")))
    if parseConfigHasKey(text, "maximumMtu"):
        nodes[idx].msquicMaxMtu = int32(parseFirstInt64(parseConfigQuotedValue(text, "maximumMtu")))
    if parseConfigHasKey(text, "migrationEnabled"):
        nodes[idx].msquicMigrationEnabled = strLowerAscii(parseConfigQuotedValue(text, "migrationEnabled")) == "true"
    if parseConfigHasKey(text, "ecnEnabled"):
        nodes[idx].msquicEcnEnabled = strLowerAscii(parseConfigQuotedValue(text, "ecnEnabled")) == "true"
    setLastError("")
    return true

fn libp2p_get_msquic_settings(handle: int64): cstring =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return cStr("{}")
    let out: str =
        "{" +
        "\"allowDatagram\":" + (if nodes[idx].msquicAllowDatagram: "true" else: "false") + "," +
        "\"maxDatagram\":" + $nodes[idx].msquicMaxDatagram + "," +
        "\"minimumMtu\":" + $nodes[idx].msquicMinMtu + "," +
        "\"maximumMtu\":" + $nodes[idx].msquicMaxMtu + "," +
        "\"migrationEnabled\":" + (if nodes[idx].msquicMigrationEnabled: "true" else: "false") + "," +
        "\"ecnEnabled\":" + (if nodes[idx].msquicEcnEnabled: "true" else: "false") +
        "}"
    setLastError("")
    return cStr(out)

fn libp2p_register_peer_hints(handle: int64, peerIdPtr: cstring, addressesJsonPtr: cstring, sourcePtr: cstring): bool =
    sourcePtr
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return false
    let peerId: str = trimText(toString(peerIdPtr))
    let addressesJson: str = toString(addressesJsonPtr)
    let values: str[] = parseQuotedValues(addressesJson)
    if len(peerId) <= 0 || len(values) <= 0:
        setLastError("peer hints invalid")
        return false
    if !nodeSetPeerHint(idx, peerId, values[0]):
        setLastError("peer hints store failed")
        return false
    setLastError("")
    return true

fn libp2p_connect_multiaddr(handle: int64, multiaddrPtr: cstring): int32 =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return resultErr
    let addr: str = trimText(toString(multiaddrPtr))
    if len(addr) <= 0:
        setLastError("empty multiaddr")
        return resultErr
    if !applyConnectByAddr(idx, addr):
        setLastError("connect multiaddr failed")
        return resultErr
    setLastError("")
    return resultOk

fn libp2p_connect_peer(handle: int64, peerIdPtr: cstring): int32 =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return resultErr
    let peerId: str = trimText(toString(peerIdPtr))
    if len(peerId) <= 0:
        setLastError("empty peer id")
        return resultErr
    if nodeHasConnectedPeer(nodes[idx], peerId):
        return resultOk
    if applyConnectByPeer(idx, peerId):
        setLastError("")
        return resultOk
    let hinted: str = nodeHintAddress(idx, peerId)
    if len(hinted) > 0 && applyConnectByAddr(idx, hinted):
        setLastError("")
        return resultOk
    setLastError("connect peer failed")
    return resultErr

fn libp2p_is_peer_connected(handle: int64, peerIdPtr: cstring): bool =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        return false
    let peerId: str = trimText(toString(peerIdPtr))
    return nodeHasConnectedPeer(nodes[idx], peerId)

fn libp2p_mdns_set_enabled(handle: int64, enabled: bool): bool =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return false
    nodes[idx].mdnsEnabled = enabled
    setLastError("")
    return true

fn libp2p_mdns_probe(handle: int64): bool =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return false
    if !nodes[idx].started:
        setLastError("node not started")
        return false
    setLastError("")
    return true

fn libp2p_bootstrap_set_policy(handle: int64, policyJsonPtr: cstring): bool =
    policyJsonPtr
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return false
    setLastError("")
    return true

fn libp2p_bootstrap_tick(handle: int64): cstring =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return cStr("{\"ok\":false}")
    var attempted: int64
    var connected: int64
    for i in 0..<nodes[idx].hintCount:
        let peerId: str = nodes[idx].hintPeerIds[i]
        if nodeHasConnectedPeer(nodes[idx], peerId):
            continue
        attempted = attempted + 1
        if applyConnectByPeer(idx, peerId) || applyConnectByAddr(idx, nodes[idx].hintAddresses[i]):
            connected = connected + 1
    nodes[idx].bootstrapDialAttempted = nodes[idx].bootstrapDialAttempted + attempted
    nodes[idx].bootstrapDialConnected = nodes[idx].bootstrapDialConnected + connected
    setLastError("")
    let out: str =
        "{" +
        "\"ok\":true," +
        "\"dialAttempted\":" + $attempted + "," +
        "\"dialConnected\":" + $connected +
        "}"
    return cStr(out)

fn libp2p_bootstrap_get_status(handle: int64): cstring =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return cStr("{\"dialAttempted\":0,\"dialConnected\":0}")
    let out: str =
        "{" +
        "\"dialAttempted\":" + $nodes[idx].bootstrapDialAttempted + "," +
        "\"dialConnected\":" + $nodes[idx].bootstrapDialConnected +
        "}"
    setLastError("")
    return cStr(out)

fn libp2p_poll_events(handle: int64, maxEventsRequested: int32): cstring =
    let idx: int32 = findNodeByHandle(handle)
    if idx < 0:
        setLastError("invalid handle")
        return cStr("[]")
    let cap: int32 =
        if maxEventsRequested <= 0:
            0
        elif maxEventsRequested > nodes[idx].eventCount:
            nodes[idx].eventCount
        else:
            maxEventsRequested
    var out: str = "["
    for i in 0..<cap:
        if i > 0:
            out = out + ","
        out = out + toJsonStringValue(nodes[idx].events[i])
    out = out + "]"
    if cap > 0:
        for i in cap..<nodes[idx].eventCount:
            nodes[idx].events[i - cap] = nodes[idx].events[i]
        nodes[idx].eventCount = nodes[idx].eventCount - cap
    setLastError("")
    return cStr(out)

fn libp2p_string_free(value: cstring) =
    value
