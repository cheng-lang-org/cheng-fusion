# Dialer wrapper(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/muxers/muxer
import cheng/libp2p/dial as dialmod
import cheng/quic/msquictransport_native as msquictransport
import cheng/quic/msquicruntime
import cheng/quic/openssl_quic
import cheng/libp2p/transports/mobilehwtransport
import cheng/libp2p/transports/webrtcdirecttransport
import cheng/libp2p/transports/webrtcstartransport
import cheng/libp2p/stream/connection
import cheng/libp2p/stream/connection as streamconn
type
    Dialer =
        dial: dialmod.Dial

fn initDialer(): Dialer =
    Dialer(dial: dialmod.InitDial())

fn initDialerInto(d: var Dialer) =
    d.dial.hasUpgrader = false

fn setUpgrade(d: var Dialer, up: var Upgrade) =
    dialmod.SetUpgrade(d.dial, up)

fn addMemoryTransport(d: var Dialer, t: MemoryTransport) =
    dialmod.AddMemoryTransport(d.dial, t)

fn addTcpTransport(d: var Dialer, t: TcpTransport) =
    dialmod.AddTcpTransport(d.dial, t)

fn addWsTransport(d: var Dialer, t: WsTransport) =
    dialmod.AddWsTransport(d.dial, t)

fn addMobileHwTransport(d: var Dialer, t: MobileHwTransport) =
    dialmod.AddMobileHwTransport(d.dial, t)

fn addQuicTransport(d: var Dialer, t: QuicTransport) =
    dialmod.AddQuicTransport(d.dial, t)

fn addOpenSslQuicTransport(d: var Dialer, t: OpenSslQuicTransport) =
    dialmod.AddOpenSslQuicTransport(d.dial, t)

fn addWebrtcDirectTransport(d: var Dialer, t: WebrtcDirectTransport) =
    dialmod.AddWebrtcDirectTransport(d.dial, t)

fn addWebrtcStarTransport(d: var Dialer, t: WebrtcStarTransport) =
    dialmod.AddWebrtcStarTransport(d.dial, t)

fn addMsQuicTransport(d: var Dialer, t: msquictransport.MsQuicTransport) =
    dialmod.AddMsQuicTransport(d.dial, t)

fn dialerMsQuicSettings(d: Dialer): Result[msquicruntime.MsQuicSettings] =
    if !d.dial.msquic.has:
        return Err[msquicruntime.MsQuicSettings]("dialer: msquic ! configured")
    return Ok[msquicruntime.MsQuicSettings](msquictransport.msquicTransportSettings(d.dial.msquic.value))

fn dialerSetMsQuicSettings(d: var Dialer, settings: msquicruntime.MsQuicSettings): Result[bool] =
    if !d.dial.msquic.has:
        return Err[bool]("dialer: msquic ! configured")
    var t: msquictransport.MsQuicTransport = d.dial.msquic.value
    let setRes: Result[bool] = msquictransport.setMsQuicTransportSettings(t, settings)
    if IsErr(setRes):
        return Err[bool](Error(setRes))
    d.dial.msquic.has = true
    d.dial.msquic.value = t
    return Ok[bool](true)

fn addTorTransport(d: var Dialer, t: TorTransport) =
    dialmod.AddTorTransport(d.dial, t)

fn canDialAddress(d: Dialer, addr: multiaddress.MultiAddress): bool =
    dialmod.CanDial(d.dial, addr)

fn dialAddress(d: var Dialer, addr: multiaddress.MultiAddress): Result[muxer.Muxer] =
    var inner: dialmod.Dial = d.dial
    let res: Result[muxer.Muxer] = dialmod.DialAndUpgrade(inner, addr)
    d.dial = inner
    return res

fn dialerMsQuicDatagramWrite(d: var Dialer, conn: var streamconn.Connection, data: Bytes): Result[int32] =
    if ! d.dial.msquic.has:
        return Err[int32]("dialer: msquic ! configured")
    var t: msquictransport.MsQuicTransport = d.dial.msquic.value
    let res: Result[int32] = msquictransport.msquicTransportDatagramWrite(t, conn, data)
    d.dial.msquic.has = true
    d.dial.msquic.value = t
    return res

fn dialerMsQuicDatagramRead(d: var Dialer, conn: var streamconn.Connection): Result[Bytes] =
    if ! d.dial.msquic.has:
        return Err[Bytes]("dialer: msquic ! configured")
    var t: msquictransport.MsQuicTransport = d.dial.msquic.value
    let res: Result[Bytes] = msquictransport.msquicTransportDatagramRead(t, conn)
    d.dial.msquic.has = true
    d.dial.msquic.value = t
    return res
