# Identify protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/stringlist
import cheng/libp2p/utils/multiaddrlist
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import cheng/libp2p/peerinfo
import cheng/libp2p/peerstore
import cheng/libp2p/protocols/protocol
import cheng/libp2p/stream/lpstream
const
    identifyCodec = "/ipfs/id/1.0.0"
    identifyPushCodec = "/ipfs/id/push/1.0.0"

type
    IdentifyInfo =
        peerId: str
        addrs: MultiAddressList
        protocols: StringList
        hasPeerId: bool

var
    localIdentifyInfo: IdentifyInfo = IdentifyInfo(addrs: initMultiAddressList(), protocols: InitStringList())

fn hasPrefix(text: str, prefix: str): bool =
    let tlen: int32 = len(text)
    let plen: int32 = len(prefix)
    if plen <= 0:
        return true
    if tlen < plen:
        return false
    for i in 0..<plen:
        if text[i] != prefix[i]:
            return false
    return true

fn trimTrailingNewline(text: str): str =
    var endIdx: int32 = len(text)
    let loop_start_endIdx_2 = endIdx
    for loop_rev_endIdx_2 in 0..(loop_start_endIdx_2 - (0)):
        endIdx = loop_start_endIdx_2 - loop_rev_endIdx_2
        if ! (endIdx > 0 && text[endIdx - 1] == '\n'):
            break
    if endIdx <= 0:
        return ""
    if endIdx == len(text):
        return text
    return SliceBytes(text, 0, endIdx)

fn parseIdentifyPayload(payload: str): Result[IdentifyInfo] =
    if len(payload) <= 0:
        return Err[IdentifyInfo]("identify: empty payload")
    var info: IdentifyInfo = IdentifyInfo(addrs: initMultiAddressList(), protocols: InitStringList())
    var start: int32
    let total: int32 = len(payload)
    for i in 0..total:
        if i == total || payload[i] == '\n':
            let segLen: int32 = i - start
            if segLen > 0:
                let line: str = SliceBytes(payload, start, segLen)
                if hasPrefix(line, "id="):
                    let value: str = SliceBytes(line, 3, segLen - 3)
                    info.peerId = value
                    info.hasPeerId = len(value) > 0
                elif hasPrefix(line, "addrs="):
                    let value: str = SliceBytes(line, 6, segLen - 6)
                    let listRes: Result[MultiAddressList] = multiAddressListFromDelimited(value, ';')
                    if IsErr(listRes):
                        return Err[IdentifyInfo](Error(listRes))
                    info.addrs = Value(listRes)
                elif hasPrefix(line, "protocols="):
                    let restStart: int32 = start + 10
                    let restLen: int32 = total - restStart
                    var rest: str
                    if restLen > 0:
                        rest = SliceBytes(payload, restStart, restLen)
                        rest = trimTrailingNewline(rest)
                    let listRes: Result[StringList] = StringListFromLines(rest)
                    if IsErr(listRes):
                        return Err[IdentifyInfo](Error(listRes))
                    info.protocols = Value(listRes)
                    break
            start = i + 1
    if ! info.hasPeerId:
        return Err[IdentifyInfo]("identify: missing peer id")
    return Ok[IdentifyInfo](info)

fn updatePeerStoreFromIdentify(store: var PeerStore, payload: str): Result[PeerId] =
    let infoRes: Result[IdentifyInfo] = parseIdentifyPayload(payload)
    if IsErr(infoRes):
        return Err[PeerId](Error(infoRes))
    let info: IdentifyInfo = Value(infoRes)
    let pidRes: Result[PeerId] = parsePeerId(info.peerId)
    if IsErr(pidRes):
        return Err[PeerId](Error(pidRes))
    var pinfo: PeerInfo = newPeerInfo(Value(pidRes))
    if ! multiAddressListIsEmpty(info.addrs):
        let addRes: Result[bool] = addAddresses(pinfo, info.addrs)
        if IsErr(addRes):
            return Err[PeerId](Error(addRes))
    if ! StringListIsEmpty(info.protocols):
        setProtocols(pinfo, info.protocols)
    let putRes: Result[bool] = putPeer(store, pinfo)
    if IsErr(putRes):
        return Err[PeerId](Error(putRes))
    return Ok[PeerId](Value(pidRes))

fn setIdentifyPeerId(id: PeerId) =
    localIdentifyInfo.peerId = peerid.toString(id)
    localIdentifyInfo.hasPeerId = len(localIdentifyInfo.peerId) > 0

fn setIdentifyListenAddr(addr: MultiAddress) =
    var list: MultiAddressList = initMultiAddressList()
    multiAddressListAdd(list, addr)
    localIdentifyInfo.addrs = list

fn setIdentifyProtocols(list: str) =
    let listRes: Result[StringList] = StringListFromLines(list)
    if IsErr(listRes):
        localIdentifyInfo.protocols = InitStringList()
        return
    localIdentifyInfo.protocols = Value(listRes)

@borrows
fn buildIdentifyPayload(info: IdentifyInfo): str =
    var out: str
    if info.hasPeerId:
        out = out + "id="
        out = out + info.peerId
        out = out + "\n"
    if ! multiAddressListIsEmpty(info.addrs):
        out = out + "addrs="
        out = out + multiAddressListToDelimited(info.addrs, ';')
        out = out + "\n"
    if ! StringListIsEmpty(info.protocols):
        out = out + "protocols="
        out = out + StringListToLines(info.protocols)
        out = out + "\n"
    return out

fn identifyHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let payload: str = buildIdentifyPayload(localIdentifyInfo)
    if len(payload) <= 0:
        return Ok[bool](true)
    let data: Bytes = BytesFromString(payload)
    let writeRes: Result[int32] = writeLp(streamVar, data)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn identifyHandlerFn(): Lp2pProtocolHandler =
    return identifyHandler

fn identifyProtocol(proto: var Lp2pProtocol) =
    newProtocolInto(proto, identifyCodec, identifyHandler)

fn identifyPushProtocol(proto: var Lp2pProtocol) =
    newProtocolInto(proto, identifyPushCodec, identifyHandler)
