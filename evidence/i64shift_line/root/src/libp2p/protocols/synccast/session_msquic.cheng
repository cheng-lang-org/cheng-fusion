# Synccast QUIC datagram helpers(msquic transport integration).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/quic/msquictransport
import cheng/libp2p/stream/connection
import cheng/libp2p/protocols/synccast/session
import cheng/libp2p/protocols/synccast/datagram
import cheng/libp2p/protocols/synccast/core
fn synccastSessionSendFrame(
    t: var MsQuicTransport,
    conn: var Connection,
    sess: var SynccastSession,
    trackId: int32,
    layerId: int32,
    frameId: int32,
    captureTsUs: int64,
    ptsUs: int64,
    flags: int32,
    payload: Bytes
): Result[int32] =
    var maxPayload: int32 = synccastDefaultMaxPayload
    if sess.maxPayloadBytes > 0:
        maxPayload = sess.maxPayloadBytes
    if maxPayload > 0 && BytesLen(payload) > maxPayload * synccastMaxFragments:
        return Err[int32]("synccast: frame too large")
    let header: SynccastDatagramHeader = synccastSessionBuildHeader(sess, trackId, layerId, frameId, captureTsUs, ptsUs, flags)
    let frags: SynccastFragmentList = synccastFragmentFrame(header, payload, maxPayload)
    var sent: int32
    for i in 0..<frags.count:
        let frag: Bytes = frags.items[i]
        let encRes: Result[Bytes] = synccastEncryptFragment(sess, frag)
        if IsErr(encRes):
            return Err[int32](Error(encRes))
        let sendRes: Result[int32] = msquicTransportDatagramWrite(t, conn, Value(encRes))
        if IsErr(sendRes):
            return Err[int32](Error(sendRes))
        sent = sent + 1
    sess.nextSeq = sess.nextSeq + sent
    return Ok[int32](sent)

fn synccastSessionSendAudio(
    t: var MsQuicTransport,
    conn: var Connection,
    sess: var SynccastSession,
    frameId: int32,
    captureTsUs: int64,
    ptsUs: int64,
    payload: Bytes
): Result[int32] =
    return synccastSessionSendFrame(t, conn, sess, synccastTrackAudio, 0, frameId, captureTsUs, ptsUs, synccastFlagDiscardable, payload)

fn synccastSessionSendVideo(
    t: var MsQuicTransport,
    conn: var Connection,
    sess: var SynccastSession,
    frameId: int32,
    captureTsUs: int64,
    ptsUs: int64,
    payload: Bytes,
    keyframe: bool
): Result[int32] =
    var flags: int32
    if keyframe:
        flags = flags | synccastFlagKeyframe
    return synccastSessionSendFrame(t, conn, sess, synccastTrackVideo, 0, frameId, captureTsUs, ptsUs, flags, payload)

fn synccastSessionHandleDatagram(
    t: var MsQuicTransport,
    conn: var Connection,
    sess: var SynccastSession
): Result[bool] =
    let dataRes: Result[Bytes] = msquicTransportDatagramRead(t, conn)
    if IsErr(dataRes):
        let err: str = Error(dataRes)
        if (err == "msquic: datagram queue empty"):
            return Ok[bool](false)
        return Err[bool](err)
    let data: Bytes = Value(dataRes)
    if BytesLen(data) < synccastDatagramHeaderSize:
        return Err[bool]("synccast: datagram too small")
    let head: Bytes = BytesSlice(data, 0, synccastDatagramHeaderSize)
    var body: Bytes = BytesSlice(data, synccastDatagramHeaderSize, BytesLen(data) - synccastDatagramHeaderSize)
    let headerRes: Result[SynccastDatagramHeader] = decodeSynccastDatagramHeader(head)
    if IsErr(headerRes):
        return Err[bool](Error(headerRes))
    let header: SynccastDatagramHeader = Value(headerRes)
    if sess.crypto.enabled:
        let decRes: Result[Bytes] = synccastDecryptPayload(sess.crypto, header, body)
        if IsErr(decRes):
            return Err[bool](Error(decRes))
        body = Value(decRes)
    let nowUs: int64 = synccastNowUs()
    return synccastSessionHandlePayload(sess, header, body, nowUs)
