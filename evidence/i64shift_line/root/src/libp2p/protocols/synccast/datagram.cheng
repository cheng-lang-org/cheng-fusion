# Synccast datagram header helpers(fixed 56 bytes, little endian).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
const
    synccastDatagramHeaderSize = 56
    synccastDatagramVersion = 1
    synccastDatagramMagic0 = 83   # 'S'
    synccastDatagramMagic1 = 89   # 'Y'
    synccastDatagramMagic2 = 78   # 'N'
    synccastDatagramMagic3 = 67   # 'C'

    synccastFlagKeyframe = 1
    synccastFlagEndOfFrame = 2
    synccastFlagBaseLayer = 4
    synccastFlagFec = 8
    synccastFlagDiscardable = 16

type
    SynccastDatagramHeader =
        version: int32
        flags: int32
        keyId: int32
        sessionId: int64
        trackId: int32
        layerId: int32
        seq: int32
        frameId: int32
        captureTsUs: int64
        ptsUs: int64
        fragIdx: int32
        fragCount: int32

fn initSynccastDatagramHeader(): SynccastDatagramHeader =
    var h: SynccastDatagramHeader
    h.version = synccastDatagramVersion
    h.flags = 0
    h.keyId = 0
    h.sessionId = 0
    h.trackId = 0
    h.layerId = 0
    h.seq = 0
    h.frameId = 0
    h.captureTsUs = 0
    h.ptsUs = 0
    h.fragIdx = 0
    h.fragCount = 1
    return h

fn writeU16LE(b: Bytes, offset: int32, val: int32) =
    BytesSet(b, offset, val)
    BytesSet(b, offset + 1, val >> 8)

fn writeU32LE(b: Bytes, offset: int32, val: int32) =
    BytesSet(b, offset, val)
    BytesSet(b, offset + 1, val >> 8)
    BytesSet(b, offset + 2, val >> 16)
    BytesSet(b, offset + 3, val >> 24)

fn writeU64LE(b: Bytes, offset: int32, val: int64) =
    for i in 0..<8:
        let shift: int32 = i * 8
        let byteVal: int32 = int32(val >> int64(shift))
        BytesSet(b, offset + i, byteVal)
fn readU16LE(b: Bytes, offset: int32): int32 =
    let b0: int32 = BytesGet(b, offset)
    let b1: int32 = BytesGet(b, offset + 1)
    return b0 | (b1 << 8)

fn readU32LE(b: Bytes, offset: int32): int32 =
    let b0: int32 = BytesGet(b, offset)
    let b1: int32 = BytesGet(b, offset + 1)
    let b2: int32 = BytesGet(b, offset + 2)
    let b3: int32 = BytesGet(b, offset + 3)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn readU64LE(b: Bytes, offset: int32): int64 =
    var out: int64
    for i in 0..<8:
        let byteVal: int64 = int64(BytesGet(b, offset + i))
        out = out | (byteVal << int64(i * 8))
    return out

fn encodeSynccastDatagramHeader(h: SynccastDatagramHeader): Bytes =
    let out: Bytes = BytesAlloc(synccastDatagramHeaderSize)
    BytesSet(out, 0, synccastDatagramMagic0)
    BytesSet(out, 1, synccastDatagramMagic1)
    BytesSet(out, 2, synccastDatagramMagic2)
    BytesSet(out, 3, synccastDatagramMagic3)
    BytesSet(out, 4, h.version)
    BytesSet(out, 5, synccastDatagramHeaderSize)
    writeU16LE(out, 6, h.flags)
    writeU16LE(out, 8, h.keyId)
    writeU64LE(out, 10, h.sessionId)
    writeU32LE(out, 18, h.trackId)
    writeU16LE(out, 22, h.layerId)
    writeU16LE(out, 24, h.fragIdx)
    writeU16LE(out, 26, h.fragCount)
    writeU32LE(out, 28, h.seq)
    writeU32LE(out, 32, h.frameId)
    writeU64LE(out, 36, h.captureTsUs)
    writeU64LE(out, 44, h.ptsUs)
    return out

fn decodeSynccastDatagramHeader(data: Bytes): Result[SynccastDatagramHeader] =
    if BytesLen(data) < synccastDatagramHeaderSize:
        return Err[SynccastDatagramHeader]("synccast: datagram header too small")
    var h: SynccastDatagramHeader = initSynccastDatagramHeader()
    if BytesGet(data, 0) != synccastDatagramMagic0 || BytesGet(data, 1) != synccastDatagramMagic1 || BytesGet(data, 2) != synccastDatagramMagic2 || BytesGet(data, 3) != synccastDatagramMagic3:
        return Err[SynccastDatagramHeader]("synccast: invalid datagram magic")
    h.version = BytesGet(data, 4)
    let headerSize: int32 = BytesGet(data, 5)
    if headerSize != synccastDatagramHeaderSize:
        return Err[SynccastDatagramHeader]("synccast: unsupported datagram header size")
    h.flags = readU16LE(data, 6)
    h.keyId = readU16LE(data, 8)
    h.sessionId = readU64LE(data, 10)
    h.trackId = readU32LE(data, 18)
    h.layerId = readU16LE(data, 22)
    h.fragIdx = readU16LE(data, 24)
    h.fragCount = readU16LE(data, 26)
    h.seq = readU32LE(data, 28)
    h.frameId = readU32LE(data, 32)
    h.captureTsUs = readU64LE(data, 36)
    h.ptsUs = readU64LE(data, 44)
    if readU32LE(data, 52) != 0:
        return Err[SynccastDatagramHeader]("synccast: non-zero reserved bytes")
    if h.version != synccastDatagramVersion:
        return Err[SynccastDatagramHeader]("synccast: unsupported datagram version")
    if h.fragCount <= 0:
        return Err[SynccastDatagramHeader]("synccast: invalid fragment count")
    if h.fragIdx < 0 || h.fragIdx >= h.fragCount:
        return Err[SynccastDatagramHeader]("synccast: invalid fragment index")
    return Ok[SynccastDatagramHeader](h)
