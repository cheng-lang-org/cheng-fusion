# Synccast control plane protocol(stream, length-prefixed).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/times
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/synccast/protobuf as synccastprotobuf
import cheng/libp2p/muxers/muxer
import cheng/libp2p/multiaddress
const
    synccastControlCodec = "/cheng-synccast/control/1.0.0"
    synccastControlDefaultMaxMessage = 1048576

type
    SynccastControlConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    SynccastControlHandler = fn(msg: SynccastControlMessage): Result[SynccastControlMessage]

    SynccastControlContext =
        config: SynccastControlConfig
        hasHandler: bool
        handler: SynccastControlHandler
        remotePeer: str
        remoteAddr: str

var
    synccastControlContext: SynccastControlContext = SynccastControlContext(
        config: SynccastControlConfig(maxMessageBytes: synccastControlDefaultMaxMessage, closeAfterResponse: false),
        hasHandler: false,
        remotePeer: "",
        remoteAddr: ""
    )

fn initSynccastControlConfig(): SynccastControlConfig =
    SynccastControlConfig(maxMessageBytes: synccastControlDefaultMaxMessage, closeAfterResponse: false)

fn setSynccastControlConfig(config: SynccastControlConfig) =
    synccastControlContext.config = config

fn setSynccastControlHandler(handler: SynccastControlHandler) =
    synccastControlContext.handler = handler
    synccastControlContext.hasHandler = true

fn synccastControlRemotePeerId(): str =
    synccastControlContext.remotePeer

fn synccastControlRemoteAddr(): str =
    synccastControlContext.remoteAddr

fn readSynccastControlMessage(stream: var Stream): Result[SynccastControlMessage] =
    let dataRes: Result[Bytes] = readLp(stream, synccastControlContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[SynccastControlMessage](Error(dataRes))
    let data: Bytes = Value(dataRes)
    let owned: Bytes = BytesSlice(data, 0, BytesLen(data))
    return decodeSynccastControlMessage(owned)

fn writeSynccastControlMessage(stream: var Stream, msg: SynccastControlMessage): Result[bool] =
    let encRes: Result[Bytes] = encodeSynccastControlMessage(msg)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultSynccastControlHandler(msg: SynccastControlMessage): Result[SynccastControlMessage] =
    return Ok[SynccastControlMessage](initSynccastControlMessage())

fn synccastFinalizeControlResponse(req: SynccastControlMessage, resp: SynccastControlMessage): SynccastControlMessage =
    var out: SynccastControlMessage = resp
    out.protoMajor = req.protoMajor
    out.protoMinor = req.protoMinor
    if out.sessionId == 0:
        out.sessionId = req.sessionId
    if out.msgId <= 0:
        out.msgId = req.msgId + 1
    if out.ackMsgId == 0:
        out.ackMsgId = req.msgId
    if out.timestampMonoUs == 0:
        out.timestampMonoUs = EpochTimeNs() / 1000
    return out

fn synccastControlHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let mux: Muxer = Muxer(kind: streamVar.kind, id: streamVar.muxerId)
    var conn = muxerConnection(mux)
    synccastControlContext.remotePeer = RemotePeerId(conn)
    synccastControlContext.remoteAddr = toString(RemoteAddress(conn))
    let msgRes: Result[SynccastControlMessage] = readSynccastControlMessage(streamVar)
    if IsErr(msgRes):
        synccastControlContext.remotePeer = ""
        synccastControlContext.remoteAddr = ""
        return Err[bool](Error(msgRes))
    let msgIn: SynccastControlMessage = Value(msgRes)
    var msg: SynccastControlMessage = initSynccastControlMessage()
    msg.protoMajor = msgIn.protoMajor
    msg.protoMinor = msgIn.protoMinor
    msg.sessionId = msgIn.sessionId
    msg.msgId = msgIn.msgId
    msg.ackMsgId = msgIn.ackMsgId
    msg.timestampMonoUs = msgIn.timestampMonoUs
    msg.kind = msgIn.kind
    msg.payload = BytesSlice(msgIn.payload, 0, BytesLen(msgIn.payload))
    var resp: SynccastControlMessage
    var respRes: Result[SynccastControlMessage]
    if synccastControlContext.hasHandler:
        let handler: SynccastControlHandler = synccastControlContext.handler
        respRes = handler(msg)
    else:
        respRes = defaultSynccastControlHandler(msg)
    if IsErr(respRes):
        synccastControlContext.remotePeer = ""
        synccastControlContext.remoteAddr = ""
        return Err[bool](Error(respRes))
    resp = Value(respRes)
    resp = synccastFinalizeControlResponse(msg, resp)
    if resp.kind > 0:
        let writeRes: Result[bool] = writeSynccastControlMessage(streamVar, resp)
        if IsErr(writeRes):
            return Err[bool](Error(writeRes))
    if synccastControlContext.config.closeAfterResponse:
        closeStream(streamVar)
    synccastControlContext.remotePeer = ""
    synccastControlContext.remoteAddr = ""
    return Ok[bool](true)

fn synccastControlProtocol(): Lp2pProtocol =
    return newProtocol(synccastControlCodec, synccastControlHandler)
