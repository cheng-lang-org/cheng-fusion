# Synccast QUIC datagram session helpers(switch/muxer bindings).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/switch
import cheng/libp2p/muxers/muxer
import cheng/libp2p/stream/connection
import cheng/libp2p/protocols/synccast/session
import cheng/libp2p/protocols/synccast/datagram
import cheng/libp2p/protocols/synccast/core
fn synccastSessionSendFrameOnConnection(
    sw: var Switch,
    conn: var Connection,
    session: var SynccastSession,
    trackId: int32,
    layerId: int32,
    frameId: int32,
    captureTsUs: int64,
    ptsUs: int64,
    flags: int32,
    payload: Bytes
): Result[int32] =
    let maxPayload: int32 = if session.maxPayloadBytes > 0: session.maxPayloadBytes else: synccastDefaultMaxPayload
    if maxPayload > 0 && BytesLen(payload) > maxPayload * synccastMaxFragments:
        return Err[int32]("synccast: frame too large")
    let header: SynccastDatagramHeader = synccastSessionBuildHeader(session, trackId, layerId, frameId, captureTsUs, ptsUs, flags)
    let frags: SynccastFragmentList = synccastFragmentFrame(header, payload, maxPayload)
    var sent: int32
    for i in 0..<frags.count:
        let frag: Bytes = frags.items[i]
        let encRes: Result[Bytes] = synccastEncryptFragment(session, frag)
        if IsErr(encRes):
            return Err[int32](Error(encRes))
        let sendRes: Result[int32] = datagramWrite(sw, conn, Value(encRes))
        if IsErr(sendRes):
            return Err[int32](Error(sendRes))
        sent = sent + 1
    session.nextSeq = session.nextSeq + sent
    return Ok[int32](sent)

fn synccastSessionSendAudioOnConnection(
    sw: var Switch,
    conn: var Connection,
    session: var SynccastSession,
    frameId: int32,
    captureTsUs: int64,
    ptsUs: int64,
    payload: Bytes
): Result[int32] =
    return synccastSessionSendFrameOnConnection(sw, conn, session, synccastTrackAudio, 0, frameId, captureTsUs, ptsUs, synccastFlagDiscardable, payload)

fn synccastSessionSendVideoOnConnection(
    sw: var Switch,
    conn: var Connection,
    session: var SynccastSession,
    frameId: int32,
    captureTsUs: int64,
    ptsUs: int64,
    payload: Bytes,
    keyframe: bool
): Result[int32] =
    var flags: int32
    if keyframe:
        flags = flags | synccastFlagKeyframe
    return synccastSessionSendFrameOnConnection(sw, conn, session, synccastTrackVideo, 0, frameId, captureTsUs, ptsUs, flags, payload)

fn synccastSessionSendAudioOnMuxer(
    sw: var Switch,
    mux: Muxer,
    session: var SynccastSession,
    frameId: int32,
    captureTsUs: int64,
    ptsUs: int64,
    payload: Bytes
): Result[int32] =
    var conn: Connection = muxerConnection(mux)
    return synccastSessionSendAudioOnConnection(sw, conn, session, frameId, captureTsUs, ptsUs, payload)

fn synccastSessionSendVideoOnMuxer(
    sw: var Switch,
    mux: Muxer,
    session: var SynccastSession,
    frameId: int32,
    captureTsUs: int64,
    ptsUs: int64,
    payload: Bytes,
    keyframe: bool
): Result[int32] =
    var conn: Connection = muxerConnection(mux)
    return synccastSessionSendVideoOnConnection(sw, conn, session, frameId, captureTsUs, ptsUs, payload, keyframe)

fn synccastSessionHandleDatagramOnConnection(
    sw: var Switch,
    conn: var Connection,
    session: var SynccastSession
): Result[bool] =
    let dataRes: Result[Bytes] = datagramRead(sw, conn)
    if IsErr(dataRes):
        let err: str = Error(dataRes)
        if (err == "msquic: datagram queue empty"):
            return Ok[bool](false)
        return Err[bool](err)
    let data: Bytes = Value(dataRes)
    if BytesLen(data) < synccastDatagramHeaderSize:
        return Err[bool]("synccast: datagram too small")
    let head: Bytes = BytesSlice(data, 0, synccastDatagramHeaderSize)
    var body: Bytes = BytesSlice(data, synccastDatagramHeaderSize, BytesLen(data) - synccastDatagramHeaderSize)
    let headerRes: Result[SynccastDatagramHeader] = decodeSynccastDatagramHeader(head)
    if IsErr(headerRes):
        return Err[bool](Error(headerRes))
    let header: SynccastDatagramHeader = Value(headerRes)
    if session.crypto.enabled:
        let decRes: Result[Bytes] = synccastDecryptPayload(session.crypto, header, body)
        if IsErr(decRes):
            return Err[bool](Error(decRes))
        body = Value(decRes)
    let nowUs: int64 = synccastNowUs()
    return synccastSessionHandlePayload(session, header, body, nowUs)

fn synccastSessionHandleDatagramOnMuxer(
    sw: var Switch,
    mux: Muxer,
    session: var SynccastSession
): Result[bool] =
    var conn: Connection = muxerConnection(mux)
    return synccastSessionHandleDatagramOnConnection(sw, conn, session)
