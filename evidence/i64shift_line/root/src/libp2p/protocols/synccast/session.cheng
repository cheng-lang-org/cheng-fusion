# Synccast QUIC datagram session helpers(media plane).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/times
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/synccast/datagram
import cheng/libp2p/protocols/synccast/core
import cheng/libp2p/protocols/synccast/protobuf as synccastprotobuf
const
    synccastDefaultMaxPayload = 1100
    synccastDefaultReassemblyMs = 50
    synccastTrackAudio = 1
    synccastTrackVideo = 2
    synccastTrackScreen = 3
    synccastReplayWindowBits = 64
    synccastReplayMaxTracks = 32

type
    SynccastReplayEntry =
        active: bool
        trackId: int32
        layerId: int32
        maxSeq: int32
        seenMask: int64

    SynccastReplayWindow =
        entries: SynccastReplayEntry[synccastReplayMaxTracks]

    SynccastSessionConfig =
        sessionId: int64
        keyId: int32
        maxPayloadBytes: int32
        targetLatencyMs: int32
        reassemblyTimeoutMs: int32
        cryptoKey: Bytes

    SynccastSession =
        sessionId: int64
        keyId: int32
        nextSeq: int32
        maxPayloadBytes: int32
        reassembly: SynccastReassembly
        jitter: SynccastJitterBuffer
        stats: SynccastStatsState
        crypto: SynccastCryptoContext
        replay: SynccastReplayWindow

fn synccastInitReplayEntries(): SynccastReplayEntry[synccastReplayMaxTracks] =
    var out: SynccastReplayEntry[synccastReplayMaxTracks]
    for i in 0..<synccastReplayMaxTracks:
        out[i].active = false
        out[i].trackId = 0
        out[i].layerId = 0
        out[i].maxSeq = 0
        out[i].seenMask = 0
    return out

fn initSynccastReplayWindow(): SynccastReplayWindow =
    SynccastReplayWindow(entries: synccastInitReplayEntries())

fn synccastReplayAllow(win: var SynccastReplayWindow, trackId: int32, layerId: int32, seq: int32): bool =
    if trackId <= 0 || seq <= 0:
        return false
    var idx: int32 = -1
    for i in 0..<synccastReplayMaxTracks:
        if win.entries[i].active && win.entries[i].trackId == trackId && win.entries[i].layerId == layerId:
            idx = i
            break
    if idx < 0:
        for i in 0..<synccastReplayMaxTracks:
            if !win.entries[i].active:
                idx = i
                break
    if idx < 0:
        idx = 0
    if !win.entries[idx].active:
        win.entries[idx].active = true
        win.entries[idx].trackId = trackId
        win.entries[idx].layerId = layerId
        win.entries[idx].maxSeq = seq
        win.entries[idx].seenMask = int64(1)
        return true
    var entry: SynccastReplayEntry = win.entries[idx]
    if seq > entry.maxSeq:
        let diff: int32 = seq - entry.maxSeq
        if diff >= synccastReplayWindowBits:
            entry.seenMask = int64(1)
        else:
            entry.seenMask = (entry.seenMask << diff) | int64(1)
        entry.maxSeq = seq
        win.entries[idx] = entry
        return true
    let diff: int32 = entry.maxSeq - seq
    if diff >= synccastReplayWindowBits:
        return false
    let bit: int64 = int64(1) << diff
    if (entry.seenMask & bit) != 0:
        return false
    entry.seenMask = entry.seenMask | bit
    win.entries[idx] = entry
    return true

fn initSynccastSessionConfig(): SynccastSessionConfig =
    SynccastSessionConfig(
        sessionId: 0,
        keyId: 0,
        maxPayloadBytes: synccastDefaultMaxPayload,
        targetLatencyMs: 200,
        reassemblyTimeoutMs: synccastDefaultReassemblyMs,
        cryptoKey: EmptyBytes()
    )

fn initSynccastSession(config: SynccastSessionConfig): SynccastSession =
    var payload: int32 = synccastDefaultMaxPayload
    if config.maxPayloadBytes > 0:
        payload = config.maxPayloadBytes
    var reasmMs: int32 = synccastDefaultReassemblyMs
    if config.reassemblyTimeoutMs > 0:
        reasmMs = config.reassemblyTimeoutMs
    let reasmUs: int64 = int64(reasmMs) * 1000
    var latencyMs: int32
    if config.targetLatencyMs > 0:
        latencyMs = config.targetLatencyMs
    let latencyUs: int64 = int64(latencyMs) * 1000
    var keyId: int32
    if config.keyId != 0:
        keyId = config.keyId
    elif BytesLen(config.cryptoKey) == synccastCryptoKeySize:
        keyId = 1
    return SynccastSession(
        sessionId: config.sessionId,
        keyId: keyId,
        nextSeq: 1,
        maxPayloadBytes: payload,
        reassembly: initSynccastReassembly(reasmUs),
        jitter: initSynccastJitterBuffer(latencyUs),
        stats: SynccastStatsState(framesReceived: 0, framesDropped: 0, jitterMs: 0, bufferMs: 0, e2eMs: 0),
        crypto: initSynccastCryptoContext(config.cryptoKey),
        replay: initSynccastReplayWindow()
    )

fn synccastNowUs(): int64 =
    return EpochTimeNs() / 1000

fn synccastSessionBuildHeader(session: var SynccastSession, trackId: int32, layerId: int32, frameId: int32, captureTsUs: int64, ptsUs: int64, flags: int32): SynccastDatagramHeader =
    var header: SynccastDatagramHeader = initSynccastDatagramHeader()
    header.sessionId = session.sessionId
    header.keyId = session.keyId
    header.trackId = trackId
    header.layerId = layerId
    header.seq = session.nextSeq
    header.frameId = frameId
    header.captureTsUs = captureTsUs
    header.ptsUs = ptsUs
    header.flags = flags
    return header

fn synccastEncryptFragment(session: var SynccastSession, fragment: Bytes): Result[Bytes] =
    if !session.crypto.enabled:
        return Ok[Bytes](fragment)
    if BytesLen(fragment) < synccastDatagramHeaderSize:
        return Err[Bytes]("synccast: fragment too small")
    let head: Bytes = BytesSlice(fragment, 0, synccastDatagramHeaderSize)
    let body: Bytes = BytesSlice(fragment, synccastDatagramHeaderSize, BytesLen(fragment) - synccastDatagramHeaderSize)
    let headerRes: Result[SynccastDatagramHeader] = decodeSynccastDatagramHeader(head)
    if IsErr(headerRes):
        return Err[Bytes](Error(headerRes))
    let encRes: Result[Bytes] = synccastEncryptPayload(session.crypto, Value(headerRes), body)
    if IsErr(encRes):
        return Err[Bytes](Error(encRes))
    return Ok[Bytes](BytesConcat(head, Value(encRes)))

fn synccastSessionPopFrame(session: var SynccastSession): Result[SynccastFrame] =
    return synccastJitterPop(session.jitter, synccastNowUs())

fn synccastSessionHandlePayload(session: var SynccastSession, header: SynccastDatagramHeader, payload: Bytes, nowUs: int64): Result[bool] =
    if !synccastReplayAllow(session.replay, header.trackId, header.layerId, header.seq):
        return Ok[bool](false)
    let dropped: int32 = synccastReassemblyDropExpired(session.reassembly, nowUs)
    synccastStatsDrop(session.stats, dropped)
    let frameRes: Result[SynccastFrame] = synccastReassemblyPush(session.reassembly, header, payload, nowUs)
    if IsErr(frameRes):
        let err: str = Error(frameRes)
        if (err == "synccast: pending"):
            return Ok[bool](false)
        return Err[bool](err)
    let frame: SynccastFrame = Value(frameRes)
    if frame.header.ptsUs > 0 && session.jitter.targetLatencyUs > 0 && nowUs - frame.header.ptsUs > session.jitter.targetLatencyUs:
        synccastStatsDrop(session.stats, 1)
        return Ok[bool](false)
    let pushed: bool = synccastJitterPush(session.jitter, frame, nowUs)
    if !pushed:
        synccastStatsDrop(session.stats, 1)
        return Ok[bool](false)
    synccastUpdateStats(session.stats, session.jitter, frame, nowUs)
    return Ok[bool](true)

fn synccastSessionStats(session: SynccastSession): SynccastStats =
    var stats: SynccastStats = initSynccastStats()
    stats.lossPermille = synccastStatsLossPermille(session.stats)
    stats.jitterMs = session.stats.jitterMs
    stats.e2eMs = session.stats.e2eMs
    stats.framesDropped = session.stats.framesDropped
    stats.bufferMs = session.stats.bufferMs
    return stats
