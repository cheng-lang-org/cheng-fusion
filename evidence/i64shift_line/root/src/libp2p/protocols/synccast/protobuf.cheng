fn encodeSynccastAbrCommand(cmd: SynccastAbrCommand): Result[Bytes] =
    if cmd.trackId <= 0:
        return Err[Bytes]("synccast: missing track id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, synccastAbrTrackField, int64(cmd.trackId))
    if cmd.layerId != 0:
        writeVarint(pb, synccastAbrLayerField, int64(cmd.layerId))
    if cmd.maxBitrateKbps != 0:
        writeVarint(pb, synccastAbrMaxBitrateField, int64(cmd.maxBitrateKbps))
    if cmd.targetFps != 0:
        writeVarint(pb, synccastAbrFpsField, int64(cmd.targetFps))
    if cmd.targetWidth != 0:
        writeVarint(pb, synccastAbrWidthField, int64(cmd.targetWidth))
    if cmd.targetHeight != 0:
        writeVarint(pb, synccastAbrHeightField, int64(cmd.targetHeight))
    return Ok[Bytes](protoToBytes(pb))

