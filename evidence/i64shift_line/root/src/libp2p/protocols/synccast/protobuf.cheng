fn encodeSynccastKeyUpdate(msg: SynccastKeyUpdate): Result[Bytes] =
    if msg.keyId <= 0:
        return Err[Bytes]("synccast: missing key id")
    if BytesLen(msg.key) != synccastKeyUpdateKeyBytes:
        return Err[Bytes]("synccast: invalid key bytes")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, synccastKeyUpdateIdField, int64(msg.keyId))
    writeBytes(pb, synccastKeyUpdateKeyField, msg.key)
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastKeyUpdate(data: Bytes): Result[SynccastKeyUpdate] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: SynccastKeyUpdate = initSynccastKeyUpdate()
    var idVal: int64
    let idRes: Result[bool] = getRequiredField(pb, synccastKeyUpdateIdField, idVal)
    if IsErr(idRes):
        return Err[SynccastKeyUpdate](Error(idRes))
    msg.keyId = int32(idVal)
    var keyBytes: Bytes = EmptyBytes()
    let keyRes: Result[bool] = getRequiredField(pb, synccastKeyUpdateKeyField, keyBytes)
    if IsErr(keyRes):
        return Err[SynccastKeyUpdate](Error(keyRes))
    if BytesLen(keyBytes) != synccastKeyUpdateKeyBytes:
        return Err[SynccastKeyUpdate]("synccast: invalid key bytes")
    msg.key = keyBytes
    return Ok[SynccastKeyUpdate](msg)

fn encodeSynccastError(err: SynccastError): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if err.code != 0:
        writeVarint(pb, synccastErrorCodeField, int64(err.code))
    if strLen(err.message) > 0:
        writeString(pb, synccastErrorMessageField, err.message)
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastError(data: Bytes): Result[SynccastError] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var err: SynccastError = initSynccastError()
    var codeVal: int64
    let codeRes: Result[bool] = getField(pb, synccastErrorCodeField, codeVal)
    if IsErr(codeRes):
        return Err[SynccastError](Error(codeRes))
    if Value(codeRes):
        err.code = int32(codeVal)
    var msgVal: str
    let msgRes: Result[bool] = getField(pb, synccastErrorMessageField, msgVal)
    if IsErr(msgRes):
        return Err[SynccastError](Error(msgRes))
    if Value(msgRes):
        err.message = msgVal
    return Ok[SynccastError](err)

fn encodeSynccastRoomSnapshot(msg: SynccastRoomSnapshot): Result[Bytes] =
    if strLen(msg.roomId) <= 0:
        return Err[Bytes]("synccast: missing room id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, synccastSnapshotRoomField, msg.roomId)
    for i in 0..<msg.publishedTracks.count:
        let encRes: Result[Bytes] = encodeSynccastTrackRef(msg.publishedTracks.items[i])
        if IsErr(encRes):
            return Err[Bytes](Error(encRes))
        writeBytes(pb, synccastSnapshotPublishedField, Value(encRes))
    for i in 0..<msg.subscribedTracks.count:
        let encRes: Result[Bytes] = encodeSynccastTrackRef(msg.subscribedTracks.items[i])
        if IsErr(encRes):
            return Err[Bytes](Error(encRes))
        writeBytes(pb, synccastSnapshotSubscribedField, Value(encRes))
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastRoomSnapshot(data: Bytes): Result[SynccastRoomSnapshot] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: SynccastRoomSnapshot = initSynccastRoomSnapshot()
    var roomId: str
    let roomRes: Result[bool] = getRequiredField(pb, synccastSnapshotRoomField, roomId)
    if IsErr(roomRes):
        return Err[SynccastRoomSnapshot](Error(roomRes))
    msg.roomId = roomId
    var publishedBytes: RepeatedBytes = initRepeatedBytes()
    let pubRes: Result[bool] = getRepeatedField(pb, synccastSnapshotPublishedField, publishedBytes)
    if IsErr(pubRes):
        return Err[SynccastRoomSnapshot](Error(pubRes))
    if Value(pubRes):
        for i in 0..<publishedBytes.count:
            let decRes: Result[SynccastTrackRef] = decodeSynccastTrackRef(publishedBytes.items[i])
            if IsErr(decRes):
                return Err[SynccastRoomSnapshot](Error(decRes))
            let addRes: Result[bool] = synccastTrackListAdd(msg.publishedTracks, Value(decRes))
            if IsErr(addRes):
                return Err[SynccastRoomSnapshot](Error(addRes))
    var subscribedBytes: RepeatedBytes = initRepeatedBytes()
    let subRes: Result[bool] = getRepeatedField(pb, synccastSnapshotSubscribedField, subscribedBytes)
    if IsErr(subRes):
        return Err[SynccastRoomSnapshot](Error(subRes))
    if Value(subRes):
        for i in 0..<subscribedBytes.count:
            let decRes: Result[SynccastTrackRef] = decodeSynccastTrackRef(subscribedBytes.items[i])
            if IsErr(decRes):
                return Err[SynccastRoomSnapshot](Error(decRes))
            let addRes: Result[bool] = synccastTrackListAdd(msg.subscribedTracks, Value(decRes))
            if IsErr(addRes):
                return Err[SynccastRoomSnapshot](Error(addRes))
    return Ok[SynccastRoomSnapshot](msg)
