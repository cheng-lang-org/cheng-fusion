# Synccast control plane messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/stringlist
import std/multiformats/protobuf/minprotobuf
const
    synccastHelloKind = 1
    synccastNegotiatedKind = 2
    synccastSubscribeKind = 3
    synccastPublishKind = 4
    synccastStatsKind = 5
    synccastKeyframeKind = 6
    synccastSyncAnchorKind = 7
    synccastErrorKind = 8
    synccastJoinRoomKind = 9
    synccastLeaveRoomKind = 10
    synccastUnpublishKind = 11
    synccastUnsubscribeKind = 12
    synccastAbrKind = 13
    synccastKeyUpdateKind = 14
    synccastRoomSnapshotKind = 15

    synccastMsgKindField = 1
    synccastMsgPayloadField = 2
    synccastMsgProtoMajorField = 3
    synccastMsgProtoMinorField = 4
    synccastMsgSessionIdField = 5
    synccastMsgIdField = 6
    synccastMsgAckMsgIdField = 7
    synccastMsgTimestampMonoUsField = 8

    synccastProtoMajor = 1
    synccastProtoMinor = 0

    synccastHelloSupportsDatagramField = 1
    synccastHelloMaxDatagramField = 2
    synccastHelloCodecField = 3
    synccastHelloDeviceField = 4

    synccastNegotiatedOkField = 1
    synccastNegotiatedSessionField = 2
    synccastNegotiatedLatencyField = 3
    synccastNegotiatedMessageField = 4

    synccastTrackRefIdField = 1
    synccastTrackRefLayerField = 2

    synccastSubscribeTrackField = 1
    synccastSubscribeKeyframeField = 2

    synccastPublishTrackField = 1
    synccastPublishKindField = 2
    synccastPublishCodecField = 3
    synccastPublishPriorityField = 4
    synccastPublishMaxBitrateField = 5
    synccastPublishLatencyField = 6

    synccastStatsLossField = 1
    synccastStatsJitterField = 2
    synccastStatsE2EField = 3
    synccastStatsDroppedField = 4
    synccastStatsBufferField = 5
    synccastStatsRttField = 6

    synccastKeyframeTrackField = 1
    synccastKeyframeReasonField = 2

    synccastSyncSenderField = 1
    synccastSyncRecvField = 2
    synccastSyncDriftField = 3

    synccastErrorCodeField = 1
    synccastErrorMessageField = 2

    synccastJoinRoomIdField = 1
    synccastLeaveRoomIdField = 1

    synccastUnpublishTrackField = 1

    synccastUnsubscribeTrackField = 1

    synccastAbrTrackField = 1
    synccastAbrLayerField = 2
    synccastAbrMaxBitrateField = 3
    synccastAbrFpsField = 4
    synccastAbrWidthField = 5
    synccastAbrHeightField = 6

    synccastKeyUpdateIdField = 1
    synccastKeyUpdateKeyField = 2
    synccastKeyUpdateKeyBytes = 32

    synccastSnapshotRoomField = 1
    synccastSnapshotPublishedField = 2
    synccastSnapshotSubscribedField = 3

const
    maxSynccastTracks = 32

type
    SynccastControlMessage =
        protoMajor: int32
        protoMinor: int32
        sessionId: int64
        msgId: int64
        ackMsgId: int64
        timestampMonoUs: int64
        kind: int32
        payload: Bytes

    SynccastHello =
        supportsDatagram: bool
        maxDatagramBytes: int32
        codecs: StringList
        deviceClass: str

    SynccastNegotiated =
        ok: bool
        sessionId: int64
        targetLatencyMs: int32
        message: str

    SynccastJoinRoom =
        roomId: str

    SynccastLeaveRoom =
        roomId: str

    SynccastTrackRef =
        trackId: int32
        layerId: int32

    SynccastTrackList =
        count: int32
        items: SynccastTrackRef[maxSynccastTracks]

    SynccastSubscribe =
        tracks: SynccastTrackList
        wantsKeyframe: bool

    SynccastUnsubscribe =
        tracks: SynccastTrackList

    SynccastPublish =
        trackId: int32
        kind: str
        codec: str
        priority: int32
        maxBitrateKbps: int32
        targetLatencyMs: int32

    SynccastUnpublish =
        trackId: int32

    SynccastStats =
        lossPermille: int32
        jitterMs: int32
        e2eMs: int32
        framesDropped: int32
        bufferMs: int32
        rttMs: int32

    SynccastAbrCommand =
        trackId: int32
        layerId: int32
        maxBitrateKbps: int32
        targetFps: int32
        targetWidth: int32
        targetHeight: int32

    SynccastKeyframeRequest =
        trackId: int32
        reason: str

    SynccastSyncAnchor =
        senderTsUs: int64
        recvTsUs: int64
        driftPpm: int32

    SynccastKeyUpdate =
        keyId: int32
        key: Bytes

    SynccastError =
        code: int32
        message: str

    SynccastRoomSnapshot =
        roomId: str
        publishedTracks: SynccastTrackList
        subscribedTracks: SynccastTrackList

fn strLen(text: str): int32 =
    return BytesLen(BytesFromString(text))

fn initSynccastControlMessage(): SynccastControlMessage =
    SynccastControlMessage(
        protoMajor: synccastProtoMajor,
        protoMinor: synccastProtoMinor,
        sessionId: 0,
        msgId: 0,
        ackMsgId: 0,
        timestampMonoUs: 0,
        kind: 0,
        payload: EmptyBytes()
    )

fn initSynccastHello(): SynccastHello =
    SynccastHello(supportsDatagram: false, maxDatagramBytes: 0, codecs: InitStringList(), deviceClass: "")

fn initSynccastNegotiated(): SynccastNegotiated =
    SynccastNegotiated(ok: false, sessionId: 0, targetLatencyMs: 0, message: "")

fn initSynccastJoinRoom(): SynccastJoinRoom =
    SynccastJoinRoom(roomId: "")

fn initSynccastLeaveRoom(): SynccastLeaveRoom =
    SynccastLeaveRoom(roomId: "")

fn initSynccastTrackList(): SynccastTrackList =
    SynccastTrackList(count: 0)

fn synccastTrackListAdd(list: var SynccastTrackList, item: SynccastTrackRef): Result[bool] =
    if list.count >= maxSynccastTracks:
        return Err[bool]("synccast: track list full")
    list.items[list.count] = item
    list.count = list.count + 1
    return Ok[bool](true)

fn initSynccastSubscribe(): SynccastSubscribe =
    SynccastSubscribe(tracks: initSynccastTrackList(), wantsKeyframe: false)

fn initSynccastUnsubscribe(): SynccastUnsubscribe =
    SynccastUnsubscribe(tracks: initSynccastTrackList())

fn initSynccastPublish(): SynccastPublish =
    SynccastPublish(trackId: 0, kind: "", codec: "", priority: 0, maxBitrateKbps: 0, targetLatencyMs: 0)

fn initSynccastUnpublish(): SynccastUnpublish =
    SynccastUnpublish(trackId: 0)

fn initSynccastStats(): SynccastStats =
    SynccastStats(lossPermille: 0, jitterMs: 0, e2eMs: 0, framesDropped: 0, bufferMs: 0, rttMs: 0)

fn initSynccastAbrCommand(): SynccastAbrCommand =
    SynccastAbrCommand(trackId: 0, layerId: 0, maxBitrateKbps: 0, targetFps: 0, targetWidth: 0, targetHeight: 0)

fn initSynccastKeyframeRequest(): SynccastKeyframeRequest =
    SynccastKeyframeRequest(trackId: 0, reason: "")

fn initSynccastSyncAnchor(): SynccastSyncAnchor =
    SynccastSyncAnchor(senderTsUs: 0, recvTsUs: 0, driftPpm: 0)

fn initSynccastKeyUpdate(): SynccastKeyUpdate =
    SynccastKeyUpdate(keyId: 0, key: EmptyBytes())

fn initSynccastError(): SynccastError =
    SynccastError(code: 0, message: "")

fn initSynccastRoomSnapshot(): SynccastRoomSnapshot =
    SynccastRoomSnapshot(roomId: "", publishedTracks: initSynccastTrackList(), subscribedTracks: initSynccastTrackList())

fn encodeSynccastControlMessage(msg: SynccastControlMessage): Result[Bytes] =
    if msg.kind <= 0:
        return Err[Bytes]("synccast: missing message kind")
    if msg.protoMajor <= 0:
        return Err[Bytes]("synccast: missing proto major")
    if msg.msgId <= 0:
        return Err[Bytes]("synccast: missing msg id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, synccastMsgKindField, int64(msg.kind))
    writeVarint(pb, synccastMsgProtoMajorField, int64(msg.protoMajor))
    writeVarint(pb, synccastMsgProtoMinorField, int64(msg.protoMinor))
    writeVarint(pb, synccastMsgSessionIdField, msg.sessionId)
    writeVarint(pb, synccastMsgIdField, msg.msgId)
    writeVarint(pb, synccastMsgAckMsgIdField, msg.ackMsgId)
    writeVarint(pb, synccastMsgTimestampMonoUsField, msg.timestampMonoUs)
    if BytesLen(msg.payload) > 0:
        writeBytes(pb, synccastMsgPayloadField, msg.payload)
    return Ok[Bytes](protoToBytes(pb))

fn encodeSynccastMessage(kind: int32, payload: Bytes): Result[Bytes] =
    let msg: SynccastControlMessage = SynccastControlMessage(
        protoMajor: synccastProtoMajor,
        protoMinor: synccastProtoMinor,
        sessionId: 0,
        msgId: 1,
        ackMsgId: 0,
        timestampMonoUs: 0,
        kind: kind,
        payload: payload
    )
    return encodeSynccastControlMessage(msg)

fn decodeSynccastControlMessage(data: Bytes): Result[SynccastControlMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: SynccastControlMessage = initSynccastControlMessage()
    var kindVal: int64
    let kindRes: Result[bool] = getRequiredField(pb, synccastMsgKindField, kindVal)
    if IsErr(kindRes):
        return Err[SynccastControlMessage](Error(kindRes))
    msg.kind = int32(kindVal)
    var majorVal: int64
    let majorRes: Result[bool] = getRequiredField(pb, synccastMsgProtoMajorField, majorVal)
    if IsErr(majorRes):
        return Err[SynccastControlMessage](Error(majorRes))
    msg.protoMajor = int32(majorVal)
    var minorVal: int64
    let minorRes: Result[bool] = getRequiredField(pb, synccastMsgProtoMinorField, minorVal)
    if IsErr(minorRes):
        return Err[SynccastControlMessage](Error(minorRes))
    msg.protoMinor = int32(minorVal)
    var sessionVal: int64
    let sessionRes: Result[bool] = getRequiredField(pb, synccastMsgSessionIdField, sessionVal)
    if IsErr(sessionRes):
        return Err[SynccastControlMessage](Error(sessionRes))
    msg.sessionId = sessionVal
    var msgIdVal: int64
    let msgIdRes: Result[bool] = getRequiredField(pb, synccastMsgIdField, msgIdVal)
    if IsErr(msgIdRes):
        return Err[SynccastControlMessage](Error(msgIdRes))
    msg.msgId = msgIdVal
    var ackVal: int64
    let ackRes: Result[bool] = getField(pb, synccastMsgAckMsgIdField, ackVal)
    if IsErr(ackRes):
        return Err[SynccastControlMessage](Error(ackRes))
    if Value(ackRes):
        msg.ackMsgId = ackVal
    var tsVal: int64
    let tsRes: Result[bool] = getRequiredField(pb, synccastMsgTimestampMonoUsField, tsVal)
    if IsErr(tsRes):
        return Err[SynccastControlMessage](Error(tsRes))
    msg.timestampMonoUs = tsVal
    var payload: Bytes = EmptyBytes()
    let payloadRes: Result[bool] = getField(pb, synccastMsgPayloadField, payload)
    if IsErr(payloadRes):
        return Err[SynccastControlMessage](Error(payloadRes))
    if Value(payloadRes):
        msg.payload = payload
    if msg.kind <= 0:
        return Err[SynccastControlMessage]("synccast: missing message kind")
    if msg.protoMajor <= 0:
        return Err[SynccastControlMessage]("synccast: missing proto major")
    if msg.msgId <= 0:
        return Err[SynccastControlMessage]("synccast: missing msg id")
    return Ok[SynccastControlMessage](msg)

fn encodeSynccastHello(hello: SynccastHello): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if hello.supportsDatagram:
        writeVarint(pb, synccastHelloSupportsDatagramField, 1)
    if hello.maxDatagramBytes > 0:
        writeVarint(pb, synccastHelloMaxDatagramField, int64(hello.maxDatagramBytes))
    for i in 0..<hello.codecs.count:
        writeString(pb, synccastHelloCodecField, hello.codecs.items[i])
    if strLen(hello.deviceClass) > 0:
        writeString(pb, synccastHelloDeviceField, hello.deviceClass)
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastHello(data: Bytes): Result[SynccastHello] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var hello: SynccastHello = initSynccastHello()
    var supports: int64
    let supRes: Result[bool] = getField(pb, synccastHelloSupportsDatagramField, supports)
    if IsErr(supRes):
        return Err[SynccastHello](Error(supRes))
    if Value(supRes):
        hello.supportsDatagram = supports != 0
    var maxVal: int64
    let maxRes: Result[bool] = getField(pb, synccastHelloMaxDatagramField, maxVal)
    if IsErr(maxRes):
        return Err[SynccastHello](Error(maxRes))
    if Value(maxRes):
        hello.maxDatagramBytes = int32(maxVal)
    var codecBytes: RepeatedBytes = initRepeatedBytes()
    let codecRes: Result[bool] = getRepeatedField(pb, synccastHelloCodecField, codecBytes)
    if IsErr(codecRes):
        return Err[SynccastHello](Error(codecRes))
    if Value(codecRes):
        for i in 0..<codecBytes.count:
            let s: str = BytesToString(codecBytes.items[i])
            let addRes: Result[bool] = StringListAdd(hello.codecs, s)
            if IsErr(addRes):
                return Err[SynccastHello](Error(addRes))
    var device: str
    let devRes: Result[bool] = getField(pb, synccastHelloDeviceField, device)
    if IsErr(devRes):
        return Err[SynccastHello](Error(devRes))
    if Value(devRes):
        hello.deviceClass = device
    return Ok[SynccastHello](hello)

fn encodeSynccastNegotiated(resp: SynccastNegotiated): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if resp.ok:
        writeVarint(pb, synccastNegotiatedOkField, 1)
    if resp.sessionId != 0:
        writeVarint(pb, synccastNegotiatedSessionField, resp.sessionId)
    if resp.targetLatencyMs > 0:
        writeVarint(pb, synccastNegotiatedLatencyField, int64(resp.targetLatencyMs))
    if strLen(resp.message) > 0:
        writeString(pb, synccastNegotiatedMessageField, resp.message)
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastNegotiated(data: Bytes): Result[SynccastNegotiated] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: SynccastNegotiated = initSynccastNegotiated()
    var okVal: int64
    let okRes: Result[bool] = getField(pb, synccastNegotiatedOkField, okVal)
    if IsErr(okRes):
        return Err[SynccastNegotiated](Error(okRes))
    if Value(okRes):
        resp.ok = okVal != 0
    var sessionVal: int64
    let sessionRes: Result[bool] = getField(pb, synccastNegotiatedSessionField, sessionVal)
    if IsErr(sessionRes):
        return Err[SynccastNegotiated](Error(sessionRes))
    if Value(sessionRes):
        resp.sessionId = sessionVal
    var latencyVal: int64
    let latencyRes: Result[bool] = getField(pb, synccastNegotiatedLatencyField, latencyVal)
    if IsErr(latencyRes):
        return Err[SynccastNegotiated](Error(latencyRes))
    if Value(latencyRes):
        resp.targetLatencyMs = int32(latencyVal)
    var msg: str
    let msgRes: Result[bool] = getField(pb, synccastNegotiatedMessageField, msg)
    if IsErr(msgRes):
        return Err[SynccastNegotiated](Error(msgRes))
    if Value(msgRes):
        resp.message = msg
    return Ok[SynccastNegotiated](resp)

fn encodeSynccastJoinRoom(msg: SynccastJoinRoom): Result[Bytes] =
    if strLen(msg.roomId) <= 0:
        return Err[Bytes]("synccast: missing room id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, synccastJoinRoomIdField, msg.roomId)
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastJoinRoom(data: Bytes): Result[SynccastJoinRoom] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: SynccastJoinRoom = initSynccastJoinRoom()
    var roomId: str
    let roomRes: Result[bool] = getRequiredField(pb, synccastJoinRoomIdField, roomId)
    if IsErr(roomRes):
        return Err[SynccastJoinRoom](Error(roomRes))
    msg.roomId = roomId
    return Ok[SynccastJoinRoom](msg)

fn encodeSynccastLeaveRoom(msg: SynccastLeaveRoom): Result[Bytes] =
    if strLen(msg.roomId) <= 0:
        return Err[Bytes]("synccast: missing room id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, synccastLeaveRoomIdField, msg.roomId)
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastLeaveRoom(data: Bytes): Result[SynccastLeaveRoom] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: SynccastLeaveRoom = initSynccastLeaveRoom()
    var roomId: str
    let roomRes: Result[bool] = getRequiredField(pb, synccastLeaveRoomIdField, roomId)
    if IsErr(roomRes):
        return Err[SynccastLeaveRoom](Error(roomRes))
    msg.roomId = roomId
    return Ok[SynccastLeaveRoom](msg)

fn encodeSynccastTrackRef(track: SynccastTrackRef): Result[Bytes] =
    if track.trackId <= 0:
        return Err[Bytes]("synccast: missing track id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, synccastTrackRefIdField, int64(track.trackId))
    if track.layerId != 0:
        writeVarint(pb, synccastTrackRefLayerField, int64(track.layerId))
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastTrackRef(data: Bytes): Result[SynccastTrackRef] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var track: SynccastTrackRef = SynccastTrackRef(trackId: 0, layerId: 0)
    var idVal: int64
    let idRes: Result[bool] = getRequiredField(pb, synccastTrackRefIdField, idVal)
    if IsErr(idRes):
        return Err[SynccastTrackRef](Error(idRes))
    track.trackId = int32(idVal)
    var layerVal: int64
    let layerRes: Result[bool] = getField(pb, synccastTrackRefLayerField, layerVal)
    if IsErr(layerRes):
        return Err[SynccastTrackRef](Error(layerRes))
    if Value(layerRes):
        track.layerId = int32(layerVal)
    return Ok[SynccastTrackRef](track)

fn encodeSynccastSubscribe(sub: SynccastSubscribe): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    for i in 0..<sub.tracks.count:
        let encRes: Result[Bytes] = encodeSynccastTrackRef(sub.tracks.items[i])
        if IsErr(encRes):
            return Err[Bytes](Error(encRes))
        writeBytes(pb, synccastSubscribeTrackField, Value(encRes))
    if sub.wantsKeyframe:
        writeVarint(pb, synccastSubscribeKeyframeField, 1)
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastSubscribe(data: Bytes): Result[SynccastSubscribe] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var sub: SynccastSubscribe = initSynccastSubscribe()
    var trackBytes: RepeatedBytes = initRepeatedBytes()
    let trackRes: Result[bool] = getRepeatedField(pb, synccastSubscribeTrackField, trackBytes)
    if IsErr(trackRes):
        return Err[SynccastSubscribe](Error(trackRes))
    if Value(trackRes):
        for i in 0..<trackBytes.count:
            let decRes: Result[SynccastTrackRef] = decodeSynccastTrackRef(trackBytes.items[i])
            if IsErr(decRes):
                return Err[SynccastSubscribe](Error(decRes))
            let addRes: Result[bool] = synccastTrackListAdd(sub.tracks, Value(decRes))
            if IsErr(addRes):
                return Err[SynccastSubscribe](Error(addRes))
    var wantsVal: int64
    let wantsRes: Result[bool] = getField(pb, synccastSubscribeKeyframeField, wantsVal)
    if IsErr(wantsRes):
        return Err[SynccastSubscribe](Error(wantsRes))
    if Value(wantsRes):
        sub.wantsKeyframe = wantsVal != 0
    return Ok[SynccastSubscribe](sub)

fn encodeSynccastUnsubscribe(unsub: SynccastUnsubscribe): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    for i in 0..<unsub.tracks.count:
        let encRes: Result[Bytes] = encodeSynccastTrackRef(unsub.tracks.items[i])
        if IsErr(encRes):
            return Err[Bytes](Error(encRes))
        writeBytes(pb, synccastUnsubscribeTrackField, Value(encRes))
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastUnsubscribe(data: Bytes): Result[SynccastUnsubscribe] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var unsub: SynccastUnsubscribe = initSynccastUnsubscribe()
    var trackBytes: RepeatedBytes = initRepeatedBytes()
    let trackRes: Result[bool] = getRepeatedField(pb, synccastUnsubscribeTrackField, trackBytes)
    if IsErr(trackRes):
        return Err[SynccastUnsubscribe](Error(trackRes))
    if Value(trackRes):
        for i in 0..<trackBytes.count:
            let decRes: Result[SynccastTrackRef] = decodeSynccastTrackRef(trackBytes.items[i])
            if IsErr(decRes):
                return Err[SynccastUnsubscribe](Error(decRes))
            let addRes: Result[bool] = synccastTrackListAdd(unsub.tracks, Value(decRes))
            if IsErr(addRes):
                return Err[SynccastUnsubscribe](Error(addRes))
    return Ok[SynccastUnsubscribe](unsub)

fn encodeSynccastPublish(pub: SynccastPublish): Result[Bytes] =
    if pub.trackId <= 0:
        return Err[Bytes]("synccast: missing track id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, synccastPublishTrackField, int64(pub.trackId))
    if strLen(pub.kind) > 0:
        writeString(pb, synccastPublishKindField, pub.kind)
    if strLen(pub.codec) > 0:
        writeString(pb, synccastPublishCodecField, pub.codec)
    if pub.priority != 0:
        writeVarint(pb, synccastPublishPriorityField, int64(pub.priority))
    if pub.maxBitrateKbps > 0:
        writeVarint(pb, synccastPublishMaxBitrateField, int64(pub.maxBitrateKbps))
    if pub.targetLatencyMs > 0:
        writeVarint(pb, synccastPublishLatencyField, int64(pub.targetLatencyMs))
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastPublish(data: Bytes): Result[SynccastPublish] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var pub: SynccastPublish = initSynccastPublish()
    var trackVal: int64
    let trackRes: Result[bool] = getRequiredField(pb, synccastPublishTrackField, trackVal)
    if IsErr(trackRes):
        return Err[SynccastPublish](Error(trackRes))
    pub.trackId = int32(trackVal)
    var kindVal: str
    let kindRes: Result[bool] = getField(pb, synccastPublishKindField, kindVal)
    if IsErr(kindRes):
        return Err[SynccastPublish](Error(kindRes))
    if Value(kindRes):
        pub.kind = kindVal
    var codecVal: str
    let codecRes: Result[bool] = getField(pb, synccastPublishCodecField, codecVal)
    if IsErr(codecRes):
        return Err[SynccastPublish](Error(codecRes))
    if Value(codecRes):
        pub.codec = codecVal
    var priVal: int64
    let priRes: Result[bool] = getField(pb, synccastPublishPriorityField, priVal)
    if IsErr(priRes):
        return Err[SynccastPublish](Error(priRes))
    if Value(priRes):
        pub.priority = int32(priVal)
    var brVal: int64
    let brRes: Result[bool] = getField(pb, synccastPublishMaxBitrateField, brVal)
    if IsErr(brRes):
        return Err[SynccastPublish](Error(brRes))
    if Value(brRes):
        pub.maxBitrateKbps = int32(brVal)
    var latencyVal: int64
    let latRes: Result[bool] = getField(pb, synccastPublishLatencyField, latencyVal)
    if IsErr(latRes):
        return Err[SynccastPublish](Error(latRes))
    if Value(latRes):
        pub.targetLatencyMs = int32(latencyVal)
    return Ok[SynccastPublish](pub)

fn encodeSynccastUnpublish(unpub: SynccastUnpublish): Result[Bytes] =
    if unpub.trackId <= 0:
        return Err[Bytes]("synccast: missing track id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, synccastUnpublishTrackField, int64(unpub.trackId))
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastUnpublish(data: Bytes): Result[SynccastUnpublish] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var unpub: SynccastUnpublish = initSynccastUnpublish()
    var trackVal: int64
    let trackRes: Result[bool] = getRequiredField(pb, synccastUnpublishTrackField, trackVal)
    if IsErr(trackRes):
        return Err[SynccastUnpublish](Error(trackRes))
    unpub.trackId = int32(trackVal)
    return Ok[SynccastUnpublish](unpub)

fn encodeSynccastStats(stats: SynccastStats): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if stats.lossPermille > 0:
        writeVarint(pb, synccastStatsLossField, int64(stats.lossPermille))
    if stats.jitterMs > 0:
        writeVarint(pb, synccastStatsJitterField, int64(stats.jitterMs))
    if stats.e2eMs > 0:
        writeVarint(pb, synccastStatsE2EField, int64(stats.e2eMs))
    if stats.framesDropped > 0:
        writeVarint(pb, synccastStatsDroppedField, int64(stats.framesDropped))
    if stats.bufferMs > 0:
        writeVarint(pb, synccastStatsBufferField, int64(stats.bufferMs))
    if stats.rttMs > 0:
        writeVarint(pb, synccastStatsRttField, int64(stats.rttMs))
    return Ok[Bytes](protoToBytes(pb))

