fn encodeSynccastSyncAnchor(anchor: SynccastSyncAnchor): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if anchor.senderTsUs != 0:
        writeVarint(pb, synccastSyncSenderField, anchor.senderTsUs)
    if anchor.recvTsUs != 0:
        writeVarint(pb, synccastSyncRecvField, anchor.recvTsUs)
    if anchor.driftPpm != 0:
        writeVarint(pb, synccastSyncDriftField, int64(anchor.driftPpm))
    return Ok[Bytes](protoToBytes(pb))

fn decodeSynccastSyncAnchor(data: Bytes): Result[SynccastSyncAnchor] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var anchor: SynccastSyncAnchor = initSynccastSyncAnchor()
