# Synccast media plane protocol(frame-per-stream fallback).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/muxers/muxer
import cheng/libp2p/multiaddress
import cheng/libp2p/protocols/synccast/datagram
const
    synccastMediaCodec = "/cheng-synccast/media/1.0.0"
    synccastMediaDefaultMaxMessage = 65535

type
    SynccastMediaPacket =
        header: SynccastDatagramHeader
        payload: Bytes

    SynccastMediaConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    SynccastMediaHandler = fn(pkt: SynccastMediaPacket): Result[bool]

    SynccastMediaContext =
        config: SynccastMediaConfig
        hasHandler: bool
        handler: SynccastMediaHandler
        remotePeer: str
        remoteAddr: str

var
    synccastMediaContext: SynccastMediaContext = SynccastMediaContext(
        config: SynccastMediaConfig(maxMessageBytes: synccastMediaDefaultMaxMessage, closeAfterResponse: true),
        hasHandler: false,
        remotePeer: "",
        remoteAddr: ""
    )

fn initSynccastMediaConfig(): SynccastMediaConfig =
    SynccastMediaConfig(maxMessageBytes: synccastMediaDefaultMaxMessage, closeAfterResponse: true)

fn setSynccastMediaConfig(config: SynccastMediaConfig) =
    synccastMediaContext.config = config

fn setSynccastMediaHandler(handler: SynccastMediaHandler) =
    synccastMediaContext.handler = handler
    synccastMediaContext.hasHandler = true

fn synccastMediaRemotePeerId(): str =
    synccastMediaContext.remotePeer

fn synccastMediaRemoteAddr(): str =
    synccastMediaContext.remoteAddr

fn readSynccastMediaPacket(stream: var Stream): Result[SynccastMediaPacket] =
    let dataRes: Result[Bytes] = readLp(stream, synccastMediaContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[SynccastMediaPacket](Error(dataRes))
    let data: Bytes = Value(dataRes)
    if BytesLen(data) < synccastDatagramHeaderSize:
        return Err[SynccastMediaPacket]("synccast: media packet too small")
    let head: Bytes = BytesSlice(data, 0, synccastDatagramHeaderSize)
    let payload: Bytes = BytesSlice(data, synccastDatagramHeaderSize, BytesLen(data) - synccastDatagramHeaderSize)
    let headerRes: Result[SynccastDatagramHeader] = decodeSynccastDatagramHeader(head)
    if IsErr(headerRes):
        return Err[SynccastMediaPacket](Error(headerRes))
    return Ok[SynccastMediaPacket](SynccastMediaPacket(header: Value(headerRes), payload: payload))

fn writeSynccastMediaPacket(stream: var Stream, pkt: SynccastMediaPacket): Result[bool] =
    let head: Bytes = encodeSynccastDatagramHeader(pkt.header)
    let data: Bytes = BytesConcat(head, pkt.payload)
    let writeRes: Result[int32] = writeLp(stream, data)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn synccastMediaHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let mux: Muxer = Muxer(kind: streamVar.kind, id: streamVar.muxerId)
    var conn = muxerConnection(mux)
    synccastMediaContext.remotePeer = RemotePeerId(conn)
    synccastMediaContext.remoteAddr = toString(RemoteAddress(conn))
    let pktRes: Result[SynccastMediaPacket] = readSynccastMediaPacket(streamVar)
    if IsErr(pktRes):
        synccastMediaContext.remotePeer = ""
        synccastMediaContext.remoteAddr = ""
        return Err[bool](Error(pktRes))
    if synccastMediaContext.hasHandler:
        let handler: SynccastMediaHandler = synccastMediaContext.handler
        let handleRes: Result[bool] = handler(Value(pktRes))
        if IsErr(handleRes):
            synccastMediaContext.remotePeer = ""
            synccastMediaContext.remoteAddr = ""
            return Err[bool](Error(handleRes))
    if synccastMediaContext.config.closeAfterResponse:
        closeStream(streamVar)
    synccastMediaContext.remotePeer = ""
    synccastMediaContext.remoteAddr = ""
    return Ok[bool](true)

fn synccastMediaProtocol(): Lp2pProtocol =
    return newProtocol(synccastMediaCodec, synccastMediaHandler)
