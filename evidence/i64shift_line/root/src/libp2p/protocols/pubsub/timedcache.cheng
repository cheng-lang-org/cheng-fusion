# Timed cache(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/times
const
    maxTimedCacheEntries = 128

type
    TimedCacheEntry =
        used: bool
        key: str
        expiresAtNs: int64

    TimedCache =
        count: int32
        entries: TimedCacheEntry[maxTimedCacheEntries]

fn initTimedCache(): TimedCache =
    TimedCache(count: 0)

fn timedCachePrune(cache: var TimedCache) =
    let nowNs: int64 = EpochTimeNs()
    for i in 0..<cache.count:
        if cache.entries[i].used && cache.entries[i].expiresAtNs <= nowNs:
            cache.entries[i].used = false
fn timedCacheFind(cache: TimedCache, key: str): int32 =
    for i in 0..<cache.count:
        if cache.entries[i].used && (cache.entries[i].key == key):
            return i
    return -1

fn timedCacheHas(cache: var TimedCache, key: str): bool =
    timedCachePrune(cache)
    return timedCacheFind(cache, key) >= 0

fn timedCacheAdd(cache: var TimedCache, key: str, ttlNs: int64): Result[bool] =
    if len(key) <= 0:
        return Err[bool]("timedcache: empty key")
    timedCachePrune(cache)
    let idx: int32 = timedCacheFind(cache, key)
    let expiresAt: int64 = EpochTimeNs() + ttlNs
    if idx >= 0:
        cache.entries[idx].expiresAtNs = expiresAt
        cache.entries[idx].used = true
        return Ok[bool](true)
    if cache.count < maxTimedCacheEntries:
        cache.entries[cache.count] = TimedCacheEntry(used: true, key: key, expiresAtNs: expiresAt)
        cache.count = cache.count + 1
        return Ok[bool](true)
    return Err[bool]("timedcache: full")
