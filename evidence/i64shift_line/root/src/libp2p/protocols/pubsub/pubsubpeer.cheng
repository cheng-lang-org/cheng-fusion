# Pubsub peer tracking(minimal).

import cheng/libp2p/utils/strings
import cheng/libp2p/utils/result
import cheng/libp2p/peerid
import std/seqs
const
    maxPubsubPeerTopics = 32

type
    PubsubPeer =
        peerId: PeerId
        topicCount: int32
        topics: str[]

fn ensurePubsubPeerTopics(peer: var PubsubPeer) =
    if len(peer.topics) < maxPubsubPeerTopics:
        setLen(peer.topics, maxPubsubPeerTopics)

@borrows
fn initPubsubPeer(peerId: PeerId): PubsubPeer =
    var p: PubsubPeer
    p.peerId = peerId
    return p

@borrows
fn InitPubsubPeer(peerId: PeerId): PubsubPeer =
    return initPubsubPeer(peerId)

@borrows
fn pubsubPeerHasTopic(peer: PubsubPeer, topic: str): bool =
    for i in 0..<peer.topicCount:
        if (peer.topics[i] == topic):
            return true
    return false

@borrows
fn PubsubPeerHasTopic(peer: PubsubPeer, topic: str): bool =
    return pubsubPeerHasTopic(peer, topic)

@borrows
fn pubsubPeerAddTopic(peer: var PubsubPeer, topic: str): Result[bool] =
    ensurePubsubPeerTopics(peer)
    if len(topic) <= 0:
        return Err[bool]("pubsub: empty topic")
    if pubsubPeerHasTopic(peer, topic):
        return Ok[bool](true)
    if peer.topicCount >= maxPubsubPeerTopics:
        return Err[bool]("pubsub: peer topic limit")
    peer.topics[peer.topicCount] = strings.CloneStr(topic)
    peer.topicCount = peer.topicCount + 1
    return Ok[bool](true)

@borrows
fn PubsubPeerAddTopic(peer: var PubsubPeer, topic: str): Result[bool] =
    return pubsubPeerAddTopic(peer, topic)

@borrows
fn pubsubPeerRemoveTopic(peer: var PubsubPeer, topic: str): Result[bool] =
    var idx: int32 = -1
    for i in 0..<peer.topicCount:
        if (peer.topics[i] == topic):
            idx = i
            break
    if idx < 0:
        return Ok[bool](false)
    for j in idx..<((peer.topicCount) - 1):
        if ! (j + 1 < peer.topicCount):
            break
        peer.topics[j] = peer.topics[j + 1]
    peer.topicCount = peer.topicCount - 1
    return Ok[bool](true)

@borrows
fn PubsubPeerRemoveTopic(peer: var PubsubPeer, topic: str): Result[bool] =
    return pubsubPeerRemoveTopic(peer, topic)
