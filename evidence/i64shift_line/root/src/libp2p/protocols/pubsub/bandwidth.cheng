# Pubsub bandwidth accounting(minimal).

import std/times
type
    PubsubBandwidth =
        bytesIn: int64
        bytesOut: int64
        messagesIn: int64
        messagesOut: int64
        updatedAtNs: int64

fn initPubsubBandwidth(): PubsubBandwidth =
    PubsubBandwidth(bytesIn: 0, bytesOut: 0, messagesIn: 0, messagesOut: 0, updatedAtNs: 0)

fn pubsubRecordIn(bw: var PubsubBandwidth, bytes: int64) =
    bw.bytesIn = bw.bytesIn + bytes
    bw.messagesIn = bw.messagesIn + 1
    bw.updatedAtNs = EpochTimeNs()

fn pubsubRecordOut(bw: var PubsubBandwidth, bytes: int64) =
    bw.bytesOut = bw.bytesOut + bytes
    bw.messagesOut = bw.messagesOut + 1
    bw.updatedAtNs = EpochTimeNs()
