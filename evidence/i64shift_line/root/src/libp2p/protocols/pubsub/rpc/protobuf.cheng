# Pubsub RPC protobuf(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/protocols/pubsub/rpc/message
import cheng/libp2p/protocols/pubsub/rpc/messages
import std/seqs
const
    rpcSubField = 1
    rpcMsgField = 2
    rpcControlField = 3

    subTopicField = 1
    subSubscribeField = 2

    msgFromField = 1
    msgDataField = 2
    msgSeqnoField = 3
    msgTopicField = 4

    controlIHaveField = 1
    controlIWantField = 2
    controlGraftField = 3
    controlPruneField = 4
    controlIDontWantField = 5

    iHaveTopicField = 1
    iHaveMsgIdField = 2

    iWantTopicField = 1
    iWantMsgIdField = 2

    iDontWantTopicField = 1
    iDontWantMsgIdField = 2

    graftTopicField = 1
    pruneTopicField = 1

@borrows
fn encodePubsubSubscription(sub: PubsubSubscription): Result[Bytes] =
    if len(sub.topic) <= 0:
        return Err[Bytes]("pubsub: subscription missing topic")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, subTopicField, sub.topic)
    if sub.subscribe:
        writeVarint(pb, subSubscribeField, 1)
    return Ok[Bytes](protoToBytes(pb))

@borrows
fn decodePubsubSubscription(data: Bytes): Result[PubsubSubscription] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var sub: PubsubSubscription = initPubsubSubscription()
    var topic: str
    let topicRes: Result[bool] = protoGetStringField(pb, subTopicField, topic)
    if IsErr(topicRes):
        return Err[PubsubSubscription](Error(topicRes))
    if Value(topicRes):
        sub.topic = topic
    var subVal: int64
    let subRes: Result[bool] = protoGetInt64Field(pb, subSubscribeField, subVal)
    if IsErr(subRes):
        return Err[PubsubSubscription](Error(subRes))
    if Value(subRes):
        sub.subscribe = subVal != 0
    if len(sub.topic) <= 0:
        return Err[PubsubSubscription]("pubsub: subscription missing topic")
    return Ok[PubsubSubscription](sub)

@borrows
fn encodePubsubMessage(msg: PubsubMessage): Result[Bytes] =
    if len(msg.topic) <= 0:
        return Err[Bytes]("pubsub: message missing topic")
    var pb: ProtoBuffer = InitProtoBuffer()
    if msg.hasFrom && BytesLen(msg.from) > 0:
        writeBytes(pb, msgFromField, msg.from)
    if msg.hasSeqno && BytesLen(msg.seqno) > 0:
        writeBytes(pb, msgSeqnoField, msg.seqno)
    writeString(pb, msgTopicField, msg.topic)
    if BytesLen(msg.data) > 0:
        writeBytes(pb, msgDataField, msg.data)
    return Ok[Bytes](protoToBytes(pb))

@borrows
fn decodePubsubMessage(data: Bytes): Result[PubsubMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: PubsubMessage = initPubsubMessage()
    var fromBytes: Bytes = EmptyBytes()
    let fromRes: Result[bool] = protoGetBytesField(pb, msgFromField, fromBytes)
    if IsErr(fromRes):
        return Err[PubsubMessage](Error(fromRes))
    if Value(fromRes) && BytesLen(fromBytes) > 0:
        msg.hasFrom = true
        msg.from = fromBytes
    var seqnoBytes: Bytes = EmptyBytes()
    let seqnoRes: Result[bool] = protoGetBytesField(pb, msgSeqnoField, seqnoBytes)
    if IsErr(seqnoRes):
        return Err[PubsubMessage](Error(seqnoRes))
    if Value(seqnoRes) && BytesLen(seqnoBytes) > 0:
        msg.hasSeqno = true
        msg.seqno = seqnoBytes
    var topic: str
    let topicRes: Result[bool] = protoGetStringField(pb, msgTopicField, topic)
    if IsErr(topicRes):
        return Err[PubsubMessage](Error(topicRes))
    if Value(topicRes):
        msg.topic = topic
    var dataBytes: Bytes = EmptyBytes()
    let dataRes: Result[bool] = protoGetBytesField(pb, msgDataField, dataBytes)
    if IsErr(dataRes):
        return Err[PubsubMessage](Error(dataRes))
    if Value(dataRes):
        msg.data = dataBytes
    if len(msg.topic) <= 0:
        return Err[PubsubMessage]("pubsub: message missing topic")
    return Ok[PubsubMessage](msg)

@borrows
fn encodePubsubControlIHave(ihave: PubsubControlIHave): Result[Bytes] =
    if len(ihave.topic) <= 0:
        return Err[Bytes]("pubsub: ihave missing topic")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, iHaveTopicField, ihave.topic)
    for i in 0..<ihave.msgIdCount:
        if BytesLen(ihave.msgIds[i]) > 0:
            writeBytes(pb, iHaveMsgIdField, ihave.msgIds[i])
    return Ok[Bytes](protoToBytes(pb))

@borrows
fn decodePubsubControlIHave(data: Bytes): Result[PubsubControlIHave] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var ihave: PubsubControlIHave = initPubsubControlIHave()
    var topic: str
    let topicRes: Result[bool] = protoGetStringField(pb, iHaveTopicField, topic)
    if IsErr(topicRes):
        return Err[PubsubControlIHave](Error(topicRes))
    if Value(topicRes):
        ihave.topic = topic
    var msgIds: RepeatedBytes = initRepeatedBytes()
    let msgRes: Result[bool] = getRepeatedField(pb, iHaveMsgIdField, msgIds)
    if IsErr(msgRes):
        return Err[PubsubControlIHave](Error(msgRes))
    if Value(msgRes):
        for i in 0..<msgIds.count:
            if ihave.msgIdCount >= maxPubsubControlMsgIds:
                return Err[PubsubControlIHave]("pubsub: ihave msgid limit")
            add(ihave.msgIds, msgIds.items[i])
            ihave.msgIdCount = ihave.msgIds.len
    if len(ihave.topic) <= 0:
        return Err[PubsubControlIHave]("pubsub: ihave missing topic")
    return Ok[PubsubControlIHave](ihave)

