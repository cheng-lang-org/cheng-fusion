@borrows
fn encodePubsubControl(ctrl: PubsubControl): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    for i in 0..<ctrl.ihaveCount:
        let ihRes: Result[Bytes] = encodePubsubControlIHave(ctrl.ihaves[i])
        if IsErr(ihRes):
            return Err[Bytes](Error(ihRes))
        writeBytes(pb, controlIHaveField, Value(ihRes))
    for i in 0..<ctrl.iwantCount:
        let iwRes: Result[Bytes] = encodePubsubControlIWant(ctrl.iwants[i])
        if IsErr(iwRes):
            return Err[Bytes](Error(iwRes))
        writeBytes(pb, controlIWantField, Value(iwRes))
    for i in 0..<ctrl.graftCount:
        let gRes: Result[Bytes] = encodePubsubControlGraft(ctrl.grafts[i])
        if IsErr(gRes):
            return Err[Bytes](Error(gRes))
        writeBytes(pb, controlGraftField, Value(gRes))
    for i in 0..<ctrl.pruneCount:
        let pRes: Result[Bytes] = encodePubsubControlPrune(ctrl.prunes[i])
        if IsErr(pRes):
            return Err[Bytes](Error(pRes))
        writeBytes(pb, controlPruneField, Value(pRes))
    for i in 0..<ctrl.idontwantCount:
        let dRes: Result[Bytes] = encodePubsubControlIDontWant(ctrl.idontwants[i])
        if IsErr(dRes):
            return Err[Bytes](Error(dRes))
        writeBytes(pb, controlIDontWantField, Value(dRes))
    return Ok[Bytes](protoToBytes(pb))

@borrows
fn decodePubsubControl(data: Bytes): Result[PubsubControl] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var ctrl: PubsubControl = initPubsubControl()
    var ihBytes: RepeatedBytes = initRepeatedBytes()
    let ihRes: Result[bool] = getRepeatedField(pb, controlIHaveField, ihBytes)
    if IsErr(ihRes):
        return Err[PubsubControl](Error(ihRes))
    if Value(ihRes):
        for i in 0..<ihBytes.count:
            if ctrl.ihaveCount >= maxPubsubControlIHave:
                return Err[PubsubControl]("pubsub: ihave limit")
            let ihValRes: Result[PubsubControlIHave] = decodePubsubControlIHave(ihBytes.items[i])
            if IsErr(ihValRes):
                return Err[PubsubControl](Error(ihValRes))
            add(ctrl.ihaves, Value(ihValRes))
            ctrl.ihaveCount = ctrl.ihaves.len
    var iwBytes: RepeatedBytes = initRepeatedBytes()
    let iwRes: Result[bool] = getRepeatedField(pb, controlIWantField, iwBytes)
    if IsErr(iwRes):
        return Err[PubsubControl](Error(iwRes))
    if Value(iwRes):
        for i in 0..<iwBytes.count:
            if ctrl.iwantCount >= maxPubsubControlIWant:
                return Err[PubsubControl]("pubsub: iwant limit")
            let iwValRes: Result[PubsubControlIWant] = decodePubsubControlIWant(iwBytes.items[i])
            if IsErr(iwValRes):
                return Err[PubsubControl](Error(iwValRes))
            add(ctrl.iwants, Value(iwValRes))
            ctrl.iwantCount = ctrl.iwants.len
    var idwBytes: RepeatedBytes = initRepeatedBytes()
    let idwRes: Result[bool] = getRepeatedField(pb, controlIDontWantField, idwBytes)
    if IsErr(idwRes):
        return Err[PubsubControl](Error(idwRes))
    if Value(idwRes):
        for i in 0..<idwBytes.count:
            if ctrl.idontwantCount >= maxPubsubControlIDontWant:
                return Err[PubsubControl]("pubsub: idontwant limit")
            let idwValRes: Result[PubsubControlIDontWant] = decodePubsubControlIDontWant(idwBytes.items[i])
            if IsErr(idwValRes):
                return Err[PubsubControl](Error(idwValRes))
            add(ctrl.idontwants, Value(idwValRes))
            ctrl.idontwantCount = ctrl.idontwants.len
    var gBytes: RepeatedBytes = initRepeatedBytes()
    let gRes: Result[bool] = getRepeatedField(pb, controlGraftField, gBytes)
    if IsErr(gRes):
        return Err[PubsubControl](Error(gRes))
    if Value(gRes):
        for i in 0..<gBytes.count:
            if ctrl.graftCount >= maxPubsubControlGraft:
                return Err[PubsubControl]("pubsub: graft limit")
            let gValRes: Result[PubsubControlGraft] = decodePubsubControlGraft(gBytes.items[i])
            if IsErr(gValRes):
                return Err[PubsubControl](Error(gValRes))
            add(ctrl.grafts, Value(gValRes))
            ctrl.graftCount = ctrl.grafts.len
    var pBytes: RepeatedBytes = initRepeatedBytes()
    let pRes: Result[bool] = getRepeatedField(pb, controlPruneField, pBytes)
    if IsErr(pRes):
        return Err[PubsubControl](Error(pRes))
    if Value(pRes):
        for i in 0..<pBytes.count:
            if ctrl.pruneCount >= maxPubsubControlPrune:
                return Err[PubsubControl]("pubsub: prune limit")
            let pValRes: Result[PubsubControlPrune] = decodePubsubControlPrune(pBytes.items[i])
            if IsErr(pValRes):
                return Err[PubsubControl](Error(pValRes))
            add(ctrl.prunes, Value(pValRes))
            ctrl.pruneCount = ctrl.prunes.len
    return Ok[PubsubControl](ctrl)

@borrows
fn encodePubsubRPC(rpc: PubsubRPC): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    for i in 0..<rpc.subCount:
        let subRes: Result[Bytes] = encodePubsubSubscription(rpc.subs[i])
        if IsErr(subRes):
            return Err[Bytes](Error(subRes))
        writeBytes(pb, rpcSubField, Value(subRes))
    for i in 0..<rpc.msgCount:
        let msgRes: Result[Bytes] = encodePubsubMessage(rpc.msgs[i])
        if IsErr(msgRes):
            return Err[Bytes](Error(msgRes))
        writeBytes(pb, rpcMsgField, Value(msgRes))
    if rpc.hasControl:
        let ctrlRes: Result[Bytes] = encodePubsubControl(rpc.control)
        if IsErr(ctrlRes):
            return Err[Bytes](Error(ctrlRes))
        writeBytes(pb, rpcControlField, Value(ctrlRes))
    return Ok[Bytes](protoToBytes(pb))

@borrows
fn decodePubsubRPC(data: Bytes): Result[PubsubRPC] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var rpc: PubsubRPC = initPubsubRPC()
    var subBytes: RepeatedBytes = initRepeatedBytes()
    let subRes: Result[bool] = getRepeatedField(pb, rpcSubField, subBytes)
    if IsErr(subRes):
        return Err[PubsubRPC](Error(subRes))
    if Value(subRes):
        for i in 0..<subBytes.count:
            if rpc.subCount >= maxPubsubSubscriptions:
                return Err[PubsubRPC]("pubsub: too many subscriptions")
            let subValRes: Result[PubsubSubscription] = decodePubsubSubscription(subBytes.items[i])
            if IsErr(subValRes):
                return Err[PubsubRPC](Error(subValRes))
            add(rpc.subs, Value(subValRes))
            rpc.subCount = rpc.subs.len
    var msgBytes: RepeatedBytes = initRepeatedBytes()
    let msgRes: Result[bool] = getRepeatedField(pb, rpcMsgField, msgBytes)
    if IsErr(msgRes):
        return Err[PubsubRPC](Error(msgRes))
    if Value(msgRes):
        for i in 0..<msgBytes.count:
            if rpc.msgCount >= maxPubsubMessages:
                return Err[PubsubRPC]("pubsub: too many messages")
            let msgValRes: Result[PubsubMessage] = decodePubsubMessage(msgBytes.items[i])
            if IsErr(msgValRes):
                return Err[PubsubRPC](Error(msgValRes))
            add(rpc.msgs, Value(msgValRes))
            rpc.msgCount = rpc.msgs.len
    var ctrlBytes: Bytes = EmptyBytes()
    let ctrlRes: Result[bool] = protoGetBytesField(pb, rpcControlField, ctrlBytes)
    if IsErr(ctrlRes):
        return Err[PubsubRPC](Error(ctrlRes))
    if Value(ctrlRes) && BytesLen(ctrlBytes) > 0:
        let ctrlValRes: Result[PubsubControl] = decodePubsubControl(ctrlBytes)
        if IsErr(ctrlValRes):
            return Err[PubsubRPC](Error(ctrlValRes))
        rpc.hasControl = true
        rpc.control = Value(ctrlValRes)
    return Ok[PubsubRPC](rpc)
