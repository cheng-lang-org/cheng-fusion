# Pubsub RPC container(minimal).

import cheng/libp2p/protocols/pubsub/rpc/message
import std/seqs
const
    maxPubsubSubscriptions = 32
    maxPubsubMessages = 32

type
    PubsubRPC =
        subCount: int32
        subs: PubsubSubscription[]
        msgCount: int32
        msgs: PubsubMessage[]
        hasControl: bool
        control: PubsubControl

fn initPubsubRPC(): PubsubRPC =
    PubsubRPC(subCount: 0, msgCount: 0, hasControl: false, control: initPubsubControl())
