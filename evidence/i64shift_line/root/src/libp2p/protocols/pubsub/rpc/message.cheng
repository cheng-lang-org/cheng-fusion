# Pubsub RPC message types(minimal).

import cheng/libp2p/utils/bytes
import std/seqs
const
    maxPubsubControlMsgIds = 32
    maxPubsubControlIHave = 16
    maxPubsubControlIWant = 16
    maxPubsubControlIDontWant = 16
    maxPubsubControlGraft = 16
    maxPubsubControlPrune = 16

type
    PubsubSubscription =
        topic: str
        subscribe: bool

    PubsubMessage =
        hasFrom: bool
        from: Bytes
        hasSeqno: bool
        seqno: Bytes
        topic: str
        data: Bytes

    PubsubControlIHave =
        topic: str
        msgIdCount: int32
        msgIds: Bytes[]

    PubsubControlIWant =
        topic: str
        msgIdCount: int32
        msgIds: Bytes[]

    PubsubControlIDontWant =
        topic: str
        msgIdCount: int32
        msgIds: Bytes[]

    PubsubControlGraft =
        topic: str

    PubsubControlPrune =
        topic: str

    PubsubControl =
        ihaveCount: int32
        ihaves: PubsubControlIHave[]
        iwantCount: int32
        iwants: PubsubControlIWant[]
        idontwantCount: int32
        idontwants: PubsubControlIDontWant[]
        graftCount: int32
        grafts: PubsubControlGraft[]
        pruneCount: int32
        prunes: PubsubControlPrune[]

fn initPubsubSubscription(): PubsubSubscription =
    PubsubSubscription(topic: "", subscribe: false)

fn initPubsubMessage(): PubsubMessage =
    PubsubMessage(
        hasFrom: false,
        from: EmptyBytes(),
        hasSeqno: false,
        seqno: EmptyBytes(),
        topic: "",
        data: EmptyBytes()
    )

fn initPubsubControlIHave(): PubsubControlIHave =
    PubsubControlIHave(topic: "", msgIdCount: 0)

fn initPubsubControlIWant(): PubsubControlIWant =
    PubsubControlIWant(topic: "", msgIdCount: 0)

fn initPubsubControlIDontWant(): PubsubControlIDontWant =
    PubsubControlIDontWant(topic: "", msgIdCount: 0)

fn initPubsubControlGraft(): PubsubControlGraft =
    PubsubControlGraft(topic: "")

fn initPubsubControlPrune(): PubsubControlPrune =
    PubsubControlPrune(topic: "")

fn initPubsubControl(): PubsubControl =
    PubsubControl(ihaveCount: 0, iwantCount: 0, idontwantCount: 0, graftCount: 0, pruneCount: 0)
