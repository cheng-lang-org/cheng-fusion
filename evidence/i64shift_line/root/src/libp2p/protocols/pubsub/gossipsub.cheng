# Gossipsub protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/strings as stdstrings
import cheng/libp2p/peerid
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/pubsub/rpc/protobuf as rpcprotobuf
import cheng/libp2p/protocols/pubsub/pubsub
import cheng/libp2p/protocols/pubsub/gossipsub/types
import cheng/libp2p/protocols/pubsub/gossipsub/sharding
import cheng/libp2p/protocols/pubsub/gossipsub/scoring
import cheng/libp2p/did/types
import cheng/libp2p/did/resolver
import std/seqs
const
    gossipsubCodec = "/meshsub/1.1.0"
    gossipsubDefaultMaxMessage = 4194304
    maxGossipsubMeshTopics = 32
    maxGossipsubMeshPeers = 32
    didChengRevocationTopicPrefix = "/did/cheng/revocation/1.0.0/"

type
    GossipsubMeshTopic =
        topic: str
        peerCount: int32
        peers: PeerId[]

    GossipsubMeshTopicList =
        count: int32
        topics: str[]

    GossipsubConfig =
        maxMessageBytes: int32

    GossipsubContext =
        config: GossipsubConfig
        params: GossipsubParams
        routingEnabled: bool
        hasPubsub: bool
        pubsub: PubsubContext
        meshCount: int32
        mesh: GossipsubMeshTopic[]

var
    gossipsubContext: GossipsubContext = GossipsubContext(
        config: GossipsubConfig(maxMessageBytes: gossipsubDefaultMaxMessage),
        params: initGossipsubParams(),
        routingEnabled: true,
        hasPubsub: false,
        meshCount: 0
    )

@borrows
fn initGossipsubMeshTopic(topic: str): GossipsubMeshTopic =
    var t: GossipsubMeshTopic
    t.topic = strings.CloneStr(topic)
    return t

fn gossipsubMeshTopics(): GossipsubMeshTopicList =
    var list: GossipsubMeshTopicList
    if len(list.topics) < maxGossipsubMeshTopics:
        setLen(list.topics, maxGossipsubMeshTopics)
    for i in 0..<gossipsubContext.meshCount:
        if ! (i < gossipsubContext.meshCount && list.count < maxGossipsubMeshTopics):
            break
        let meshRow: GossipsubMeshTopic = gossipsubContext.mesh[i]
        list.topics[list.count] = strings.CloneStr(meshRow.topic)
        list.count = list.count + 1
    return list

@borrows
fn gossipsubMeshFind(ctx: var GossipsubContext, topic: str): int32 =
    for i in 0..<ctx.meshCount:
        let meshRow: GossipsubMeshTopic = ctx.mesh[i]
        if (meshRow.topic == topic):
            return i
    return -1

@borrows
fn gossipsubMeshEnsure(ctx: var GossipsubContext, topic: str): Result[int32] =
    let idx: int32 = gossipsubMeshFind(ctx, topic)
    if idx >= 0:
        return Ok[int32](idx)
    if ctx.meshCount >= maxGossipsubMeshTopics:
        return Err[int32]("gossipsub: mesh topic limit")
    add(ctx.mesh, initGossipsubMeshTopic(topic))
    ctx.meshCount = ctx.mesh.len
    return Ok[int32](ctx.meshCount - 1)

@borrows
fn gossipsubMeshDropTopic(ctx: var GossipsubContext, topic: str): Result[bool] =
    let idx: int32 = gossipsubMeshFind(ctx, topic)
    if idx < 0:
        return Ok[bool](false)
    for i in idx..<((ctx.meshCount) - 1):
        if ! (i + 1 < ctx.meshCount):
            break
        ctx.mesh[i] = ctx.mesh[i + 1]
    setLen(ctx.mesh, ctx.meshCount - 1)
    ctx.meshCount = ctx.mesh.len
    return Ok[bool](true)

@borrows
fn gossipsubMeshHasPeer(topic: GossipsubMeshTopic, peer: PeerId): bool =
    for i in 0..<topic.peerCount:
        let eqRes: Result[bool] = peerIdEqual(topic.peers[i], peer)
        if IsOk(eqRes) && Value(eqRes):
            return true
    return false

@borrows
fn gossipsubMeshAddPeer(ctx: var GossipsubContext, topic: str, peer: PeerId): Result[bool] =
    if ! ctx.routingEnabled:
        return Ok[bool](false)
    if len(topic) <= 0:
        return Err[bool]("gossipsub: empty topic")
    let idxRes: Result[int32] = gossipsubMeshEnsure(ctx, topic)
    if IsErr(idxRes):
        return Err[bool](Error(idxRes))
    let idx: int32 = Value(idxRes)
    var meshRow: GossipsubMeshTopic = ctx.mesh[idx]
    if gossipsubMeshHasPeer(meshRow, peer):
        return Ok[bool](true)
    if meshRow.peerCount >= maxGossipsubMeshPeers:
        return Err[bool]("gossipsub: mesh peer limit")
    add(meshRow.peers, share(peer))
    meshRow.peerCount = meshRow.peers.len
    ctx.mesh[idx] = meshRow
    return Ok[bool](true)

@borrows
fn gossipsubMeshRemovePeer(ctx: var GossipsubContext, topic: str, peer: PeerId): Result[bool] =
    var idx: int32 = -1
    for i in 0..<ctx.meshCount:
        let meshProbe: GossipsubMeshTopic = ctx.mesh[i]
        if meshProbe.topic == topic:
            idx = i
            break
    if idx < 0:
        return Ok[bool](false)
    var meshRow: GossipsubMeshTopic = ctx.mesh[idx]
    var j: int32 = -1
    for i in 0..<meshRow.peerCount:
        if meshRow.peers[i] == peer:
            j = i
            break
    if j < 0:
        return Ok[bool](false)
    let lastPeer: int32 = meshRow.peerCount - 1
    if j != lastPeer:
        meshRow.peers[j] = meshRow.peers[lastPeer]
    meshRow.peerCount = lastPeer
    ctx.mesh[idx] = meshRow
    return Ok[bool](true)

@borrows
fn gossipsubMeshPeers(ctx: var GossipsubContext, topic: str): PubsubPeerIdList =
    var list: PubsubPeerIdList = PubsubPeerIdList(count: 0)
    let idx: int32 = gossipsubMeshFind(ctx, topic)
    if idx < 0:
        return list
    let meshRow: GossipsubMeshTopic = ctx.mesh[idx]
    for i in 0..<meshRow.peerCount:
        if ! (i < meshRow.peerCount && list.count < maxPubsubPeers):
            break
        add(list.items, meshRow.peers[i])
        list.count = list.items.len
    return list

@borrows
fn gossipsubMeshPeerCount(ctx: var GossipsubContext, topic: str): int32 =
    let idx: int32 = gossipsubMeshFind(ctx, topic)
    if idx < 0:
        return 0
    let meshRow: GossipsubMeshTopic = ctx.mesh[idx]
    return meshRow.peerCount

@borrows
fn gossipsubMeshHasPeer(ctx: var GossipsubContext, topic: str, peer: PeerId): bool =
    let idx: int32 = gossipsubMeshFind(ctx, topic)
    if idx < 0:
        return false
    return gossipsubMeshHasPeer(ctx.mesh[idx], peer)

@borrows
fn gossipsubMeshPeerCountForTopic(topic: str): int32 =
    gossipsubMeshPeerCount(gossipsubContext, topic)

fn gossipsubPeerInMesh(topic: str, peer: PeerId): bool =
    gossipsubMeshHasPeer(gossipsubContext, topic, peer)

@borrows
fn gossipsubMeshPeersForTopic(topic: str): PubsubPeerIdList =
    gossipsubMeshPeers(gossipsubContext, topic)

@borrows
fn gossipsubAddMeshPeer(topic: str, peer: PeerId): Result[bool] =
    gossipsubMeshAddPeer(gossipsubContext, topic, peer)

@borrows
fn gossipsubRemoveMeshPeer(topic: str, peer: PeerId): Result[bool] =
    gossipsubMeshRemovePeer(gossipsubContext, topic, peer)

@borrows
fn gossipsubControlAddGraft(ctrl: var PubsubControl, topic: str): bool =
    if len(ctrl.grafts) < maxPubsubControlGraft:
        setLen(ctrl.grafts, maxPubsubControlGraft)
    if len(topic) <= 0:
        return false
    for i in 0..<ctrl.graftCount:
        if (ctrl.grafts[i].topic == topic):
            return true
    if ctrl.graftCount >= maxPubsubControlGraft:
        return false
    ctrl.grafts[ctrl.graftCount].topic = strings.CloneStr(topic)
    ctrl.graftCount = ctrl.graftCount + 1
    return true

@borrows
fn gossipsubControlAddPrune(ctrl: var PubsubControl, topic: str): bool =
    if len(ctrl.prunes) < maxPubsubControlPrune:
        setLen(ctrl.prunes, maxPubsubControlPrune)
    if len(topic) <= 0:
        return false
    for i in 0..<ctrl.pruneCount:
        if (ctrl.prunes[i].topic == topic):
            return true
    if ctrl.pruneCount >= maxPubsubControlPrune:
        return false
    ctrl.prunes[ctrl.pruneCount].topic = strings.CloneStr(topic)
    ctrl.pruneCount = ctrl.pruneCount + 1
    return true

@borrows
fn gossipsubControlAddIWant(ctrl: var PubsubControl, topic: str, msgId: Bytes): bool =
    if len(ctrl.iwants) < maxPubsubControlIWant:
        setLen(ctrl.iwants, maxPubsubControlIWant)
    if len(topic) <= 0 || BytesLen(msgId) <= 0:
        return false
    var idx: int32 = -1
    for i in 0..<ctrl.iwantCount:
        if (ctrl.iwants[i].topic == topic):
            idx = i
            break
    if idx < 0:
        if ctrl.iwantCount >= maxPubsubControlIWant:
            return false
        ctrl.iwants[ctrl.iwantCount].topic = strings.CloneStr(topic)
        idx = ctrl.iwantCount
        ctrl.iwantCount = ctrl.iwantCount + 1
    for j in 0..<ctrl.iwants[idx].msgIdCount:
        if BytesEqual(ctrl.iwants[idx].msgIds[j], msgId):
            return true
    if ctrl.iwants[idx].msgIdCount >= maxPubsubControlMsgIds:
        return false
    if len(ctrl.iwants[idx].msgIds) < maxPubsubControlMsgIds:
        setLen(ctrl.iwants[idx].msgIds, maxPubsubControlMsgIds)
    let n: int32 = BytesLen(msgId)
    let copied: Bytes = BytesAlloc(n)
    BytesCopyInto(copied, 0, msgId)
    ctrl.iwants[idx].msgIds[ctrl.iwants[idx].msgIdCount] = copied
    ctrl.iwants[idx].msgIdCount = ctrl.iwants[idx].msgIdCount + 1
    return true

@borrows
fn gossipsubControlHasIDontWant(ctrl: PubsubControl, topic: str, msgId: Bytes): bool =
    if len(topic) <= 0 || BytesLen(msgId) <= 0:
        return false
    for i in 0..<ctrl.idontwantCount:
        if (ctrl.idontwants[i].topic == topic):
            var j: int32
            for j in 0..<ctrl.idontwants[i].msgIdCount:
                if BytesEqual(ctrl.idontwants[i].msgIds[j], msgId):
                    return true
    return false

@borrows
fn gossipsubControlAddIDontWant(ctrl: var PubsubControl, topic: str, msgId: Bytes): bool =
    if len(ctrl.idontwants) < maxPubsubControlIDontWant:
        setLen(ctrl.idontwants, maxPubsubControlIDontWant)
    if len(topic) <= 0 || BytesLen(msgId) <= 0:
        return false
    var idx: int32 = -1
    for i in 0..<ctrl.idontwantCount:
        if (ctrl.idontwants[i].topic == topic):
            idx = i
            break
    if idx < 0:
        if ctrl.idontwantCount >= maxPubsubControlIDontWant:
            return false
        ctrl.idontwants[ctrl.idontwantCount].topic = strings.CloneStr(topic)
        idx = ctrl.idontwantCount
        ctrl.idontwantCount = ctrl.idontwantCount + 1
    for j in 0..<ctrl.idontwants[idx].msgIdCount:
        if BytesEqual(ctrl.idontwants[idx].msgIds[j], msgId):
            return true
    if ctrl.idontwants[idx].msgIdCount >= maxPubsubControlMsgIds:
        return false
    if len(ctrl.idontwants[idx].msgIds) < maxPubsubControlMsgIds:
        setLen(ctrl.idontwants[idx].msgIds, maxPubsubControlMsgIds)
    let n: int32 = BytesLen(msgId)
    let copied: Bytes = BytesAlloc(n)
    BytesCopyInto(copied, 0, msgId)
    ctrl.idontwants[idx].msgIds[ctrl.idontwants[idx].msgIdCount] = copied
    ctrl.idontwants[idx].msgIdCount = ctrl.idontwants[idx].msgIdCount + 1
    return true

fn initGossipsubConfig(): GossipsubConfig =
    GossipsubConfig(maxMessageBytes: gossipsubDefaultMaxMessage)

fn setGossipsubConfig(config: GossipsubConfig) =
    gossipsubContext.config = config

fn setGossipsubParams(params: GossipsubParams) =
    var normalized: GossipsubParams = params
    if normalized.staggerMs < 0:
        normalized.staggerMs = 0
    if normalized.shardCount <= 0:
        normalized.shardCount = 1
    if normalized.shardId < 0 || normalized.shardId >= normalized.shardCount:
        normalized.shardId = 0
    gossipsubContext.params = normalized

fn setGossipsubRoutingEnabled(enabled: bool) =
    gossipsubContext.routingEnabled = enabled
    if ! enabled:
        gossipsubContext.meshCount = 0

fn gossipsubRoutingEnabled(): bool =
    return gossipsubContext.routingEnabled

fn gossipsubParamsSnapshot(): GossipsubParams =
    gossipsubContext.params

fn enableGossipsubContext() =
    gossipsubContext.hasPubsub = true

fn setGossipsubContext(ctx: PubsubContext) =
    gossipsubContext.pubsub = ctx
    gossipsubContext.hasPubsub = true

fn gossipsubContextReady(): bool =
    gossipsubContext.hasPubsub

@borrows
fn gossipsubTopicAllowed(topic: str): bool =
    if len(topic) <= 0:
        return false
    return gossipsubTopicInShard(topic, gossipsubContext.params.shardCount, gossipsubContext.params.shardId)

@borrows
fn gossipsubSubscribe(topic: str): Result[bool] =
    if !gossipsubContext.hasPubsub:
        return Err[bool]("gossipsub: missing context")
    let res: Result[bool] = pubsubSubscribe(gossipsubContext.pubsub, topic)
    if IsErr(res):
        return Err[bool](Error(res))
    if gossipsubContext.routingEnabled:
        gossipsubMeshEnsure(gossipsubContext, topic)
    return Ok[bool](true)

@borrows
fn gossipsubUnsubscribe(topic: str): Result[bool] =
    if !gossipsubContext.hasPubsub:
        return Err[bool]("gossipsub: missing context")
    let res: Result[bool] = pubsubUnsubscribe(gossipsubContext.pubsub, topic)
    if IsErr(res):
        return Err[bool](Error(res))
    gossipsubMeshDropTopic(gossipsubContext, topic)
    return Ok[bool](true)

fn gossipsubAddPeer(peerId: PeerId): Result[bool] =
    if ! gossipsubContext.hasPubsub:
        return Err[bool]("gossipsub: missing context")
    var ctx: PubsubContext = gossipsubContext.pubsub
    let res: Result[bool] = pubsubAddPeer(ctx, peerId)
    if IsErr(res):
        return Err[bool](Error(res))
    gossipsubContext.pubsub = ctx
    return Ok[bool](true)

fn gossipsubRemovePeer(peerId: PeerId): Result[bool] =
    if ! gossipsubContext.hasPubsub:
        return Err[bool]("gossipsub: missing context")
    var ctx: PubsubContext = gossipsubContext.pubsub
    let res: Result[bool] = pubsubRemovePeer(ctx, peerId)
    if IsErr(res):
        return Err[bool](Error(res))
    gossipsubContext.pubsub = ctx
    return Ok[bool](true)

fn gossipsubPeers(): PubsubPeerIdList =
    if ! gossipsubContext.hasPubsub:
        return PubsubPeerIdList(count: 0)
    return pubsubPeerIds(gossipsubContext.pubsub)

fn gossipsubPeersForTopic(topic: str): PubsubPeerIdList =
    if ! gossipsubContext.hasPubsub:
        return PubsubPeerIdList(count: 0)
    let meshList: PubsubPeerIdList = gossipsubMeshPeers(gossipsubContext, topic)
    if meshList.count > 0:
        return meshList
    return pubsubPeerIdsForTopic(gossipsubContext.pubsub, topic)

fn gossipsubAllPeersForTopic(topic: str): PubsubPeerIdList =
    if ! gossipsubContext.hasPubsub:
        return PubsubPeerIdList(count: 0)
    return pubsubPeerIdsForTopic(gossipsubContext.pubsub, topic)

fn gossipsubCacheMessage(msg: PubsubMessage): Result[bool] =
    if ! gossipsubContext.hasPubsub:
        return Err[bool]("gossipsub: missing context")
    if ! msg.hasSeqno || BytesLen(msg.seqno) <= 0 || len(msg.topic) <= 0:
        return Ok[bool](false)
    var ctx: PubsubContext = gossipsubContext.pubsub
    let addRes: Result[bool] = pubsubCacheAdd(ctx.cache, msg)
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    gossipsubContext.pubsub = ctx
    return Ok[bool](true)

fn gossipsubDidRevocationDid(topic: str): Result[str] =
    let prefixLen: int32 = len(didChengRevocationTopicPrefix)
    if len(topic) <= prefixLen:
        return Err[str]("gossipsub: ! did revocation topic")
    for i in 0..<prefixLen:
        if topic[i] != didChengRevocationTopicPrefix[i]:
            return Err[str]("gossipsub: ! did revocation topic")
    let rootText: str = SliceBytes(topic, prefixLen, len(topic) - prefixLen)
    let rootPidRes: Result[PeerId] = parsePeerId(rootText)
    if IsErr(rootPidRes):
        return Err[str](Error(rootPidRes))
    return Ok[str](didFromRootPeerId(Value(rootPidRes)))

@borrows
fn gossipsubApplyDidRevocation(topic: str, data: Bytes): Result[bool] =
    let topicOwned: str = strings.CloneStr(topic)
    let n: int32 = BytesLen(data)
    if n <= 0:
        return Err[bool]("gossipsub: did revocation empty payload")
    let dataOwned: Bytes = BytesAlloc(n)
    BytesCopyInto(dataOwned, 0, data)
    let didRes: Result[str] = gossipsubDidRevocationDid(topicOwned)
    if IsErr(didRes):
        return Err[bool](Error(didRes))
    let revRes: Result[DidRevocationV1] = didResolverApplySignedRevocation(dataOwned)
    if IsErr(revRes):
        return Err[bool](Error(revRes))
    let rev: DidRevocationV1 = Value(revRes)
    let didText: str = Value(didRes)
    if rev.did != didText:
        return Err[bool]("gossipsub: did revocation topic mismatch")
    return Ok[bool](true)

fn gossipsubNextMessageWire(): str =
    return ""

fn readGossipsubRpc(stream: var Stream): Result[PubsubRPC] =
    let dataRes: Result[Bytes] = readLp(stream, gossipsubContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[PubsubRPC](Error(dataRes))
    return decodePubsubRPC(Value(dataRes))

fn writeGossipsubRpc(stream: var Stream, rpc: PubsubRPC): Result[bool] =
    let encRes: Result[Bytes] = encodePubsubRPC(rpc)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn gossipsubHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    if ! gossipsubContextReady():
        return Err[bool]("gossipsub: missing context")
    let rpcRes: Result[PubsubRPC] = readGossipsubRpc(streamVar)
    if IsErr(rpcRes):
        return Err[bool](Error(rpcRes))
    let rpc: PubsubRPC = Value(rpcRes)
    var peer: PeerId = peerIdFromTextUnchecked("")
    var peerText: str
    var hasPeer: bool
    let peerRes: Result[PeerId] = pubsubStreamPeerId(streamVar)
    if IsOk(peerRes):
        peer = Value(peerRes)
        hasPeer = true
        peerText = toString(peer)
    if hasPeer && peerScoreIsGraylisted(stdstrings.CloneStr(peerText)):
        let _ = gossipsubRemovePeer(peer)
        return Err[bool]("gossipsub: peer graylisted")
    for i in 0..<rpc.msgCount:
        if len(rpc.msgs[i].topic) <= 0 || BytesLen(rpc.msgs[i].data) <= 0:
            if hasPeer:
                let _ = peerScorePenaltyInvalidMessage(peerText)
                if peerScoreIsGraylisted(stdstrings.CloneStr(peerText)):
                    let _ = gossipsubRemovePeer(peer)
                    return Err[bool]("gossipsub: peer graylisted")
            continue
        if rpc.msgs[i].hasSeqno && BytesLen(rpc.msgs[i].seqno) > 0:
            var probe: PubsubMessage = initPubsubMessage()
            probe.topic = rpc.msgs[i].topic
            probe.hasSeqno = true
            probe.seqno = rpc.msgs[i].seqno
            if pubsubCacheHas(gossipsubContext.pubsub.cache, probe):
                if hasPeer:
                    let _ = peerScorePenaltyDuplicateMessage(peerText)
                    if peerScoreIsGraylisted(stdstrings.CloneStr(peerText)):
                        let _ = gossipsubRemovePeer(peer)
                        return Err[bool]("gossipsub: peer graylisted")
                continue
        # slim feed closure does not pull DID revocation decode/verify.
    var ctx: PubsubContext = gossipsubContext.pubsub
    let handleRes: Result[bool] = pubsubHandleRpcFromPeer(ctx, rpc, hasPeer, peer)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    gossipsubContext.pubsub = ctx
    if rpc.hasControl && hasPeer && gossipsubContext.routingEnabled:
        for i in 0..<rpc.control.graftCount:
            let topic: str = rpc.control.grafts[i].topic
            if len(topic) > 0:
                gossipsubMeshAddPeer(gossipsubContext, topic, peer)
        for i in 0..<rpc.control.pruneCount:
            let topic: str = rpc.control.prunes[i].topic
            if len(topic) > 0:
                gossipsubMeshRemovePeer(gossipsubContext, topic, peer)
    var reply: PubsubRPC = initPubsubRPC()
    var sendReply: bool
    if hasPeer && rpc.subCount > 0 && gossipsubContext.routingEnabled:
        for s in 0..<rpc.subCount:
            let sub: PubsubSubscription = rpc.subs[s]
            let topic: str = sub.topic
            if len(topic) > 0:
                if sub.subscribe:
                    let count: int32 = gossipsubMeshPeerCount(gossipsubContext, topic)
                    if count < gossipsubContext.params.meshLow:
                        let addRes: Result[bool] = gossipsubMeshAddPeer(gossipsubContext, topic, peer)
                        if IsOk(addRes) && gossipsubControlAddGraft(reply.control, topic):
                            sendReply = true
                else:
                    let removedRes: Result[bool] = gossipsubMeshRemovePeer(gossipsubContext, topic, peer)
                    if IsOk(removedRes) && Value(removedRes):
                        if gossipsubControlAddPrune(reply.control, topic):
                            sendReply = true
                if gossipsubMeshHasPeer(gossipsubContext, topic, peer):
                    let countHigh: int32 = gossipsubMeshPeerCount(gossipsubContext, topic)
                    if countHigh > gossipsubContext.params.meshHigh:
                        gossipsubMeshRemovePeer(gossipsubContext, topic, peer)
                        if gossipsubControlAddPrune(reply.control, topic):
                            sendReply = true
    if rpc.hasControl && rpc.control.iwantCount > 0:
        let staggerEnabled: bool = gossipsubContext.params.staggerMs > 0
        for i in 0..<rpc.control.iwantCount:
            if ! (i < rpc.control.iwantCount && reply.msgCount < maxPubsubMessages):
                break
            let iwant: PubsubControlIWant = rpc.control.iwants[i]
            if len(iwant.topic) > 0:
                var j: int32
                var sentForTopic: int32
                if gossipsubTopicAllowed(iwant.topic):
                    for j in j..<iwant.msgIdCount:
                        if ! (j < iwant.msgIdCount && reply.msgCount < maxPubsubMessages):
                            break
                        if ! gossipsubControlHasIDontWant(rpc.control, iwant.topic, iwant.msgIds[j]):
                            var msg: PubsubMessage
                            if pubsubCacheGet(gossipsubContext.pubsub.cache, iwant.topic, iwant.msgIds[j], msg):
                                if staggerEnabled && sentForTopic > 0:
                                    if gossipsubControlAddIDontWant(reply.control, iwant.topic, iwant.msgIds[j]):
                                        sendReply = true
                                else:
                                    reply.msgs[reply.msgCount] = msg
                                    reply.msgCount = reply.msgCount + 1
                                    sentForTopic = sentForTopic + 1
                else:
                    for j in j..<iwant.msgIdCount:
                        if gossipsubControlAddIDontWant(reply.control, iwant.topic, iwant.msgIds[j]):
                            sendReply = true
        if reply.msgCount > 0:
            sendReply = true
    if rpc.hasControl && rpc.control.ihaveCount > 0:
        for i in 0..<rpc.control.ihaveCount:
            let ihave: PubsubControlIHave = rpc.control.ihaves[i]
            var j: int32
            for j in 0..<ihave.msgIdCount:
                if ! (j < ihave.msgIdCount):
                    break
                if ! gossipsubControlHasIDontWant(rpc.control, ihave.topic, ihave.msgIds[j]):
                    if gossipsubTopicAllowed(ihave.topic):
                        var probe: PubsubMessage = initPubsubMessage()
                        probe.topic = ihave.topic
                        probe.hasSeqno = true
                        probe.seqno = ihave.msgIds[j]
                        if ! pubsubCacheHas(gossipsubContext.pubsub.cache, probe):
                            if gossipsubControlAddIWant(reply.control, ihave.topic, ihave.msgIds[j]):
                                sendReply = true
                    else:
                        if gossipsubControlAddIDontWant(reply.control, ihave.topic, ihave.msgIds[j]):
                            sendReply = true
    if reply.control.graftCount > 0 || reply.control.pruneCount > 0 || reply.control.idontwantCount > 0:
        reply.hasControl = true
    if reply.control.iwantCount > 0:
        reply.hasControl = true
    if sendReply:
        let writeRes: Result[bool] = writeGossipsubRpc(streamVar, reply)
        if IsErr(writeRes):
            return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn gossipsubHandlerFn(): Lp2pProtocolHandler =
    return gossipsubHandler

fn gossipsubPublishSlim(topic: str, data: Bytes): Result[bool] =
    if !gossipsubContext.hasPubsub:
        return Err[bool]("gossipsub: missing context")
    var emptySeq: Bytes
    let enqRes: Result[bool] = pubsubInboxEnqueueParts(gossipsubContext.pubsub, topic, data, false, "", false, emptySeq)
    if IsErr(enqRes):
        return Err[bool](Error(enqRes))
    return Ok[bool](true)

fn gossipsubHandlerSlim(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    if !gossipsubContextReady():
        return Err[bool]("gossipsub: missing context")
    let rpcRes: Result[PubsubRPC] = readGossipsubRpc(streamVar)
    if IsErr(rpcRes):
        return Err[bool](Error(rpcRes))
    let rpc: PubsubRPC = Value(rpcRes)
    var peer: PeerId
    var ctx: PubsubContext = gossipsubContext.pubsub
    let handleRes: Result[bool] = pubsubHandleRpcFromPeer(ctx, rpc, false, peer)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    gossipsubContext.pubsub = ctx
    return Ok[bool](true)

fn gossipsubHandlerFnSlim(): Lp2pProtocolHandler =
    return gossipsubHandlerSlim

fn gossipsubProtocol(proto: var Lp2pProtocol) =
    newProtocolInto(proto, gossipsubCodec, gossipsubHandler)
