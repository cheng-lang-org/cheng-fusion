# Pubsub peer table(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/peerid
import std/seqs
const
    maxPeerTableTopics = 32
    maxPeerTablePeers = 32

type
    PeerTablePeerList =
        count: int32
        items: PeerId[]

    PeerTableEntry =
        used: bool
        topic: str
        peers: PeerTablePeerList

    PubsubPeerTable =
        count: int32
        entries: PeerTableEntry[]

fn initPeerTablePeerList(): PeerTablePeerList =
    var out: PeerTablePeerList
    out.count = 0
    return out

fn initPubsubPeerTable(): PubsubPeerTable =
    var out: PubsubPeerTable
    out.count = 0
    return out

fn peerTableFind(table: PubsubPeerTable, topic: str): int32 =
    for i in 0..<table.count:
        if table.entries[i].used && (table.entries[i].topic == topic):
            return i
    return -1

fn peerTablePeerIndex(list: PeerTablePeerList, peerId: PeerId): int32 =
    for i in 0..<list.count:
        let eqRes: Result[bool] = peerIdEqual(list.items[i], peerId)
        if IsOk(eqRes) && Value(eqRes):
            return i
    return -1

fn peerTableAddPeer(table: var PubsubPeerTable, topic: str, peerId: PeerId): Result[bool] =
    if len(topic) <= 0:
        return Err[bool]("peertable: empty topic")
    var idx: int32 = peerTableFind(table, topic)
    if idx < 0:
        if table.count >= maxPeerTableTopics:
            return Err[bool]("peertable: topic limit")
        add(table.entries, PeerTableEntry(used: true, topic: topic, peers: initPeerTablePeerList()))
        idx = table.entries.len - 1
        table.count = table.entries.len
    var list: PeerTablePeerList = table.entries[idx].peers
    if peerTablePeerIndex(list, peerId) >= 0:
        return Ok[bool](true)
    if list.count >= maxPeerTablePeers:
        return Err[bool]("peertable: peer limit")
    add(list.items, peerId)
    list.count = list.items.len
    table.entries[idx].peers = list
    return Ok[bool](true)

fn peerTableRemovePeer(table: var PubsubPeerTable, topic: str, peerId: PeerId): Result[bool] =
    let idx: int32 = peerTableFind(table, topic)
    if idx < 0:
        return Ok[bool](false)
    var list: PeerTablePeerList = table.entries[idx].peers
    let pidx: int32 = peerTablePeerIndex(list, peerId)
    if pidx < 0:
        return Ok[bool](false)
    for j in pidx..<((list.count) - 1):
        if ! (j + 1 < list.count):
            break
        list.items[j] = list.items[j + 1]
    setLen(list.items, list.count - 1)
    list.count = list.items.len
    table.entries[idx].peers = list
    return Ok[bool](true)

fn peerTableList(table: PubsubPeerTable, topic: str): PeerTablePeerList =
    let idx: int32 = peerTableFind(table, topic)
    if idx < 0:
        return initPeerTablePeerList()
    return table.entries[idx].peers
