# Pubsub message cache(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/times
import cheng/libp2p/protocols/pubsub/rpc/message
import std/seqs
const
    maxPubsubCacheEntries = 128
    defaultPubsubCacheTtlNs = 60000000000

type
    PubsubCacheEntry =
        used: bool
        topic: str
        seqno: Bytes
        data: Bytes
        addedAtNs: int64

    PubsubMessageCache =
        count: int32
        entries: PubsubCacheEntry[]
        ttlNs: int64

fn ensurePubsubCacheEntries(cache: var PubsubMessageCache) =
    if len(cache.entries) < maxPubsubCacheEntries:
        setLen(cache.entries, maxPubsubCacheEntries)

fn initPubsubMessageCache(): PubsubMessageCache =
    var cache: PubsubMessageCache
    cache.ttlNs = defaultPubsubCacheTtlNs
    return cache

fn pubsubCachePrune(cache: var PubsubMessageCache) =
    let nowNs: int64 = EpochTimeNs()
    for i in 0..<cache.count:
        if cache.entries[i].used && cache.entries[i].addedAtNs + cache.ttlNs <= nowNs:
            cache.entries[i].used = false
@borrows
fn pubsubCacheFind(cache: PubsubMessageCache, topic: str, seqno: Bytes): int32 =
    for i in 0..<cache.count:
        if cache.entries[i].used && (cache.entries[i].topic == topic):
            if BytesEqual(cache.entries[i].seqno, seqno):
                return i
    return -1

@borrows
fn pubsubCacheHas(cache: var PubsubMessageCache, msg: PubsubMessage): bool =
    if len(msg.topic) <= 0:
        return false
    pubsubCachePrune(cache)
    return pubsubCacheFind(cache, msg.topic, msg.seqno) >= 0

@borrows
fn pubsubCacheAdd(cache: var PubsubMessageCache, msg: PubsubMessage): Result[bool] =
    ensurePubsubCacheEntries(cache)
    if len(msg.topic) <= 0:
        return Err[bool]("pubsub: cache missing topic")
    pubsubCachePrune(cache)
    let idx: int32 = pubsubCacheFind(cache, msg.topic, msg.seqno)
    let nowNs: int64 = EpochTimeNs()
    if idx >= 0:
        let dataN: int32 = BytesLen(msg.data)
        if dataN <= 0:
            cache.entries[idx].data = EmptyBytes()
        else:
            let dataCopy: Bytes = BytesAlloc(dataN)
            BytesCopyInto(dataCopy, 0, msg.data)
            cache.entries[idx].data = dataCopy
        cache.entries[idx].addedAtNs = nowNs
        cache.entries[idx].used = true
        return Ok[bool](true)
    if cache.count < maxPubsubCacheEntries:
        cache.entries[cache.count].used = true
        cache.entries[cache.count].topic = strings.CloneStr(msg.topic)
        let seqN: int32 = BytesLen(msg.seqno)
        if seqN <= 0:
            cache.entries[cache.count].seqno = EmptyBytes()
        else:
            let seqCopy: Bytes = BytesAlloc(seqN)
            BytesCopyInto(seqCopy, 0, msg.seqno)
            cache.entries[cache.count].seqno = seqCopy
        let dataN: int32 = BytesLen(msg.data)
        if dataN <= 0:
            cache.entries[cache.count].data = EmptyBytes()
        else:
            let dataCopy: Bytes = BytesAlloc(dataN)
            BytesCopyInto(dataCopy, 0, msg.data)
            cache.entries[cache.count].data = dataCopy
        cache.entries[cache.count].addedAtNs = nowNs
        cache.count = cache.count + 1
        return Ok[bool](true)
    return Err[bool]("pubsub: cache full")

@borrows
fn pubsubCacheGet(cache: PubsubMessageCache, topic: str, seqno: Bytes, out: var PubsubMessage): bool =
    if len(topic) <= 0 || BytesLen(seqno) <= 0:
        return false
    let idx: int32 = pubsubCacheFind(cache, topic, seqno)
    if idx < 0 || ! cache.entries[idx].used:
        return false
    out.topic = strings.CloneStr(cache.entries[idx].topic)
    let dataN: int32 = BytesLen(cache.entries[idx].data)
    if dataN <= 0:
        out.data = EmptyBytes()
    else:
        let dataCopy: Bytes = BytesAlloc(dataN)
        BytesCopyInto(dataCopy, 0, cache.entries[idx].data)
        out.data = dataCopy
    out.hasSeqno = true
    let seqN: int32 = BytesLen(cache.entries[idx].seqno)
    if seqN <= 0:
        out.seqno = EmptyBytes()
    else:
        let seqCopy: Bytes = BytesAlloc(seqN)
        BytesCopyInto(seqCopy, 0, cache.entries[idx].seqno)
        out.seqno = seqCopy
    return true
