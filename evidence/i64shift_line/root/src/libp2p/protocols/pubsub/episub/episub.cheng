# Episub protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/peerid
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/pubsub/rpc/messages
import cheng/libp2p/protocols/pubsub/pubsub
import cheng/libp2p/protocols/pubsub/episub/protobuf as episubprotobuf
const
    episubCodec = "/episub/1.0.0"
    episubDefaultMaxMessage = 4194304

type
    EpisubConfig =
        maxMessageBytes: int32

    EpisubContext =
        config: EpisubConfig
        hasPubsub: bool
        pubsub: PubsubContext

var
    episubContext: EpisubContext = EpisubContext(
        config: EpisubConfig(maxMessageBytes: episubDefaultMaxMessage),
        hasPubsub: false
    )

fn initEpisubConfig(): EpisubConfig =
    EpisubConfig(maxMessageBytes: episubDefaultMaxMessage)

fn setEpisubConfig(config: EpisubConfig) =
    episubContext.config = config

fn setEpisubContext(ctx: PubsubContext) =
    episubContext.pubsub = ctx
    episubContext.hasPubsub = true

fn episubContextReady(): bool =
    episubContext.hasPubsub

fn episubSubscribe(topic: str): Result[bool] =
    if ! episubContext.hasPubsub:
        return Err[bool]("episub: missing context")
    var ctx: PubsubContext = episubContext.pubsub
    let res: Result[bool] = pubsubSubscribe(ctx, topic)
    if IsErr(res):
        return Err[bool](Error(res))
    episubContext.pubsub = ctx
    return Ok[bool](true)

fn episubUnsubscribe(topic: str): Result[bool] =
    if ! episubContext.hasPubsub:
        return Err[bool]("episub: missing context")
    var ctx: PubsubContext = episubContext.pubsub
    let res: Result[bool] = pubsubUnsubscribe(ctx, topic)
    if IsErr(res):
        return Err[bool](Error(res))
    episubContext.pubsub = ctx
    return Ok[bool](true)

fn episubAddPeer(peerId: PeerId): Result[bool] =
    if ! episubContext.hasPubsub:
        return Err[bool]("episub: missing context")
    var ctx: PubsubContext = episubContext.pubsub
    let res: Result[bool] = pubsubAddPeer(ctx, peerId)
    if IsErr(res):
        return Err[bool](Error(res))
    episubContext.pubsub = ctx
    return Ok[bool](true)

fn episubRemovePeer(peerId: PeerId): Result[bool] =
    if ! episubContext.hasPubsub:
        return Err[bool]("episub: missing context")
    var ctx: PubsubContext = episubContext.pubsub
    let res: Result[bool] = pubsubRemovePeer(ctx, peerId)
    if IsErr(res):
        return Err[bool](Error(res))
    episubContext.pubsub = ctx
    return Ok[bool](true)

fn episubPeers(): PubsubPeerIdList =
    if ! episubContext.hasPubsub:
        return PubsubPeerIdList(count: 0)
    return pubsubPeerIds(episubContext.pubsub)

fn episubPeersForTopic(topic: str): PubsubPeerIdList =
    if ! episubContext.hasPubsub:
        return PubsubPeerIdList(count: 0)
    return pubsubPeerIdsForTopic(episubContext.pubsub, topic)

fn episubNextMessage(out: var PubsubInboxMessage): bool =
    if ! episubContext.hasPubsub:
        return false
    var ctx: PubsubContext = episubContext.pubsub
    let ok: bool = pubsubNextMessage(ctx, out)
    episubContext.pubsub = ctx
    return ok

fn readEpisubRpc(stream: var Stream): Result[PubsubRPC] =
    let dataRes: Result[Bytes] = readLp(stream, episubContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[PubsubRPC](Error(dataRes))
    return decodeEpisubRPC(Value(dataRes))

fn writeEpisubRpc(stream: var Stream, rpc: PubsubRPC): Result[bool] =
    let encRes: Result[Bytes] = encodeEpisubRPC(rpc)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn episubHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    if ! episubContextReady():
        return Err[bool]("episub: missing context")
    let rpcRes: Result[PubsubRPC] = readEpisubRpc(streamVar)
    if IsErr(rpcRes):
        return Err[bool](Error(rpcRes))
    var peer: PeerId = peerIdFromTextUnchecked("")
    var hasPeer: bool
    let peerRes: Result[PeerId] = pubsubStreamPeerId(streamVar)
    if IsOk(peerRes):
        peer = Value(peerRes)
        hasPeer = true
    var ctx: PubsubContext = episubContext.pubsub
    let handleRes: Result[bool] = pubsubHandleRpcFromPeer(ctx, Value(rpcRes), hasPeer, peer)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    episubContext.pubsub = ctx
    return Ok[bool](true)

fn episubProtocol(): Lp2pProtocol =
    return newProtocol(episubCodec, episubHandler)
