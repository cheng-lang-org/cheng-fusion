# Floodsub protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/option
import cheng/libp2p/peerid
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/pubsub/rpc/protobuf as rpcprotobuf
import cheng/libp2p/protocols/pubsub/pubsub
const
    floodsubCodec = "/floodsub/1.0.0"
    floodsubDefaultMaxMessage = 4194304

type
    FloodsubConfig =
        maxMessageBytes: int32

    FloodsubContext =
        config: FloodsubConfig
        hasPubsub: bool
        pubsub: PubsubContext

var
    floodsubContext: FloodsubContext = FloodsubContext(
        config: FloodsubConfig(maxMessageBytes: floodsubDefaultMaxMessage),
        hasPubsub: false
    )

fn initFloodsubConfig(): FloodsubConfig =
    FloodsubConfig(maxMessageBytes: floodsubDefaultMaxMessage)

fn setFloodsubConfig(config: FloodsubConfig) =
    floodsubContext.config = config

fn setFloodsubContext(ctx: PubsubContext) =
    floodsubContext.pubsub = ctx
    floodsubContext.hasPubsub = true

fn floodsubContextReady(): bool =
    floodsubContext.hasPubsub

fn floodsubSubscribe(topic: str): Result[bool] =
    if ! floodsubContext.hasPubsub:
        return Err[bool]("floodsub: missing context")
    var ctx: PubsubContext = floodsubContext.pubsub
    let res: Result[bool] = pubsubSubscribe(ctx, topic)
    if IsErr(res):
        return Err[bool](Error(res))
    floodsubContext.pubsub = ctx
    return Ok[bool](true)

fn floodsubUnsubscribe(topic: str): Result[bool] =
    if ! floodsubContext.hasPubsub:
        return Err[bool]("floodsub: missing context")
    var ctx: PubsubContext = floodsubContext.pubsub
    let res: Result[bool] = pubsubUnsubscribe(ctx, topic)
    if IsErr(res):
        return Err[bool](Error(res))
    floodsubContext.pubsub = ctx
    return Ok[bool](true)

fn floodsubAddPeer(peerId: PeerId): Result[bool] =
    if ! floodsubContext.hasPubsub:
        return Err[bool]("floodsub: missing context")
    var ctx: PubsubContext = floodsubContext.pubsub
    let res: Result[bool] = pubsubAddPeer(ctx, peerId)
    if IsErr(res):
        return Err[bool](Error(res))
    floodsubContext.pubsub = ctx
    return Ok[bool](true)

fn floodsubRemovePeer(peerId: PeerId): Result[bool] =
    if ! floodsubContext.hasPubsub:
        return Err[bool]("floodsub: missing context")
    var ctx: PubsubContext = floodsubContext.pubsub
    let res: Result[bool] = pubsubRemovePeer(ctx, peerId)
    if IsErr(res):
        return Err[bool](Error(res))
    floodsubContext.pubsub = ctx
    return Ok[bool](true)

fn floodsubPeers(): PubsubPeerIdList =
    if ! floodsubContext.hasPubsub:
        return PubsubPeerIdList(count: 0)
    return pubsubPeerIds(floodsubContext.pubsub)

fn floodsubPeersForTopic(topic: str): PubsubPeerIdList =
    if ! floodsubContext.hasPubsub:
        return PubsubPeerIdList(count: 0)
    return pubsubPeerIdsForTopic(floodsubContext.pubsub, topic)

fn floodsubNextMessage(out: var PubsubInboxMessage): bool =
    if ! floodsubContext.hasPubsub:
        return false
    var ctx: PubsubContext = floodsubContext.pubsub
    let ok: bool = pubsubNextMessage(ctx, out)
    floodsubContext.pubsub = ctx
    return ok

fn readFloodsubRpc(stream: var Stream): Result[PubsubRPC] =
    let dataRes: Result[Bytes] = readLp(stream, floodsubContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[PubsubRPC](Error(dataRes))
    return decodePubsubRPC(Value(dataRes))

fn writeFloodsubRpc(stream: var Stream, rpc: PubsubRPC): Result[bool] =
    let encRes: Result[Bytes] = encodePubsubRPC(rpc)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn floodsubHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    if ! floodsubContextReady():
        return Err[bool]("floodsub: missing context")
    let rpcRes: Result[PubsubRPC] = readFloodsubRpc(streamVar)
    if IsErr(rpcRes):
        return Err[bool](Error(rpcRes))
    var peer: PeerId = peerIdFromTextUnchecked("")
    var hasPeer: bool
    let peerRes: Result[PeerId] = pubsubStreamPeerId(streamVar)
    if IsOk(peerRes):
        peer = Value(peerRes)
        hasPeer = true
    var ctx: PubsubContext = floodsubContext.pubsub
    let handleRes: Result[bool] = pubsubHandleRpcFromPeer(ctx, Value(rpcRes), hasPeer, peer)
    if IsErr(handleRes):
        return Err[bool](Error(handleRes))
    floodsubContext.pubsub = ctx
    return Ok[bool](true)

fn floodsubProtocol(): Lp2pProtocol =
    return newProtocol(floodsubCodec, floodsubHandler)
