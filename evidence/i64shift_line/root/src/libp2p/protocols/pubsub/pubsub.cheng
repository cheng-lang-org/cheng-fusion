# Pubsub core(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/peerid
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
import cheng/libp2p/protocols/pubsub/pubsubpeer
import cheng/libp2p/protocols/pubsub/mcache
import cheng/libp2p/protocols/pubsub/rpc/message
import cheng/libp2p/protocols/pubsub/rpc/messages
import std/seqs
const
    maxPubsubTopics = 32
    maxPubsubPeers = 32
    maxPubsubInbox = 64

type
    PubsubPeerIdList =
        count: int32
        items: PeerId[]

    PubsubInboxMessage =
        topic: str
        data: Bytes
        hasFrom: bool
        from: PeerId
        hasSeqno: bool
        seqno: Bytes

    PubsubContext =
        topicCount: int32
        topics: str[]
        peerCount: int32
        peers: PubsubPeer[]
        inboxCount: int32
        inboxTopics: str[]
        inboxData: Bytes[]
        inboxHasFrom: bool[]
        inboxFrom: PeerId[]
        inboxHasSeqno: bool[]
        inboxSeqno: Bytes[]
        cache: PubsubMessageCache

fn ensurePubsubTopics(ctx: var PubsubContext) =
    if len(ctx.topics) < maxPubsubTopics:
        setLen(ctx.topics, maxPubsubTopics)

fn ensurePubsubInbox(ctx: var PubsubContext) =
    if len(ctx.inboxTopics) < maxPubsubInbox:
        setLen(ctx.inboxTopics, maxPubsubInbox)
    if len(ctx.inboxData) < maxPubsubInbox:
        setLen(ctx.inboxData, maxPubsubInbox)
    if len(ctx.inboxHasFrom) < maxPubsubInbox:
        setLen(ctx.inboxHasFrom, maxPubsubInbox)
    if len(ctx.inboxFrom) < maxPubsubInbox:
        setLen(ctx.inboxFrom, maxPubsubInbox)
    if len(ctx.inboxHasSeqno) < maxPubsubInbox:
        setLen(ctx.inboxHasSeqno, maxPubsubInbox)
    if len(ctx.inboxSeqno) < maxPubsubInbox:
        setLen(ctx.inboxSeqno, maxPubsubInbox)

fn initPubsubContext(): PubsubContext =
    var ctx: PubsubContext
    ctx.cache.ttlNs = defaultPubsubCacheTtlNs
    return ctx

@borrows
fn pubsubHasTopic(ctx: PubsubContext, topic: str): bool =
    for i in 0..<ctx.topicCount:
        if (ctx.topics[i] == topic):
            return true
    return false

@borrows
fn pubsubSubscribe(ctx: var PubsubContext, topic: str): Result[bool] =
    ensurePubsubTopics(ctx)
    if len(topic) <= 0:
        return Err[bool]("pubsub: empty topic")
    if pubsubHasTopic(ctx, topic):
        return Ok[bool](true)
    if ctx.topicCount >= maxPubsubTopics:
        return Err[bool]("pubsub: topic limit")
    ctx.topics[ctx.topicCount] = strings.CloneStr(topic)
    ctx.topicCount = ctx.topicCount + 1
    return Ok[bool](true)

@borrows
fn pubsubUnsubscribe(ctx: var PubsubContext, topic: str): Result[bool] =
    var idx: int32 = -1
    for i in 0..<ctx.topicCount:
        if (ctx.topics[i] == topic):
            idx = i
            break
    if idx < 0:
        return Ok[bool](false)
    for j in idx..<((ctx.topicCount) - 1):
        if ! (j + 1 < ctx.topicCount):
            break
        ctx.topics[j] = ctx.topics[j + 1]
    ctx.topicCount = ctx.topicCount - 1
    return Ok[bool](true)

@borrows
fn findPubsubPeer(ctx: var PubsubContext, peerId: PeerId): int32 =
    for i in 0..<ctx.peerCount:
        let peerRow: PubsubPeer = ctx.peers[i]
        let eqRes: Result[bool] = peerIdEqual(peerRow.peerId, peerId)
        if IsOk(eqRes) && Value(eqRes):
            return i
    return -1

@borrows
fn pubsubAddPeer(ctx: var PubsubContext, peerId: PeerId): Result[bool] =
    if findPubsubPeer(ctx, peerId) >= 0:
        return Ok[bool](true)
    if ctx.peerCount >= maxPubsubPeers:
        return Err[bool]("pubsub: peer limit")
    add(ctx.peers, pubsubpeer.InitPubsubPeer(peerId))
    ctx.peerCount = ctx.peers.len
    return Ok[bool](true)

fn pubsubRemovePeer(ctx: var PubsubContext, peerId: PeerId): Result[bool] =
    let idx: int32 = findPubsubPeer(ctx, peerId)
    if idx < 0:
        return Ok[bool](false)
    for j in idx..<((ctx.peerCount) - 1):
        if ! (j + 1 < ctx.peerCount):
            break
        ctx.peers[j] = ctx.peers[j + 1]
    setLen(ctx.peers, ctx.peerCount - 1)
    ctx.peerCount = ctx.peers.len
    return Ok[bool](true)

fn pubsubPeerIds(ctx: PubsubContext): PubsubPeerIdList =
    var list: PubsubPeerIdList = PubsubPeerIdList(count: 0)
    for i in 0..<ctx.peerCount:
        if ! (i < ctx.peerCount && list.count < maxPubsubPeers):
            break
        let peerRow: PubsubPeer = ctx.peers[i]
        add(list.items, peerRow.peerId)
        list.count = list.items.len
    return list

fn pubsubPeerIdsForTopic(ctx: PubsubContext, topic: str): PubsubPeerIdList =
    var list: PubsubPeerIdList = PubsubPeerIdList(count: 0)
    for i in 0..<ctx.peerCount:
        if ! (i < ctx.peerCount && list.count < maxPubsubPeers):
            break
        let peer: PubsubPeer = ctx.peers[i]
        if len(topic) <= 0 || peer.topicCount <= 0 || pubsubpeer.PubsubPeerHasTopic(peer, topic):
            add(list.items, peer.peerId)
            list.count = list.items.len
    return list

fn pubsubStreamPeerId(stream: Stream): Result[PeerId] =
    var mux: Muxer
    mux.kind = stream.kind
    mux.id = stream.muxerId
    let conn: Connection = muxerConnection(mux)
    let peerText: str = RemotePeerId(conn)
    if len(peerText) <= 0:
        return Err[PeerId]("pubsub: missing remote peer id")
    return parsePeerId(peerText)

fn pubsubInboxFromPeerText(hasFrom: bool, fromBytes: Bytes): str =
    if !hasFrom:
        return strings.CloneStr("")
    let pidRes: Result[PeerId] = peerIdFromBytes(fromBytes)
    if IsErr(pidRes):
        return strings.CloneStr("")
    return strings.CloneStr(Value(pidRes))

fn pubsubInboxEnqueueParts(ctx: var PubsubContext, topic: str, data: Bytes, hasFrom: bool, fromText: str, hasSeqno: bool, seqno: Bytes): Result[bool] =
    if ctx.inboxCount >= maxPubsubInbox:
        return Err[bool]("pubsub: inbox full")
    ensurePubsubInbox(ctx)
    let i: int32 = ctx.inboxCount
    ctx.inboxTopics[i] = strings.CloneStr(topic)
    ctx.inboxFrom[i] = strings.CloneStr(fromText)
    ctx.inboxHasFrom[i] = hasFrom
    ctx.inboxHasSeqno[i] = hasSeqno
    let dataN: int32 = BytesLen(data)
    if dataN > 0:
        let allocated: Bytes = BytesAlloc(dataN)
        BytesCopyInto(allocated, 0, data)
        ctx.inboxData[i] = allocated
    let seqN: int32 = BytesLen(seqno)
    if seqN > 0:
        let allocatedSeq: Bytes = BytesAlloc(seqN)
        BytesCopyInto(allocatedSeq, 0, seqno)
        ctx.inboxSeqno[i] = allocatedSeq
    ctx.inboxCount = i + 1
    return Ok[bool](true)

fn pubsubNextMessage(ctx: var PubsubContext, out: var PubsubInboxMessage): bool =
    if ctx.inboxCount <= 0 || len(ctx.inboxTopics) <= 0:
        return false
    let last: int32 = ctx.inboxCount - 1
    var topicCopy: str = strings.CloneStr(ctx.inboxTopics[last])
    out.topic = topicCopy
    let dataN: int32 = BytesLen(ctx.inboxData[last])
    if dataN > 0:
        let dataCopy: Bytes = BytesAlloc(dataN)
        BytesCopyInto(dataCopy, 0, ctx.inboxData[last])
        out.data = dataCopy
    out.hasFrom = ctx.inboxHasFrom[last]
    var fromCopy: str = strings.CloneStr(ctx.inboxFrom[last])
    out.from = fromCopy
    out.hasSeqno = ctx.inboxHasSeqno[last]
    let seqN: int32 = BytesLen(ctx.inboxSeqno[last])
    if seqN > 0:
        let seqCopy: Bytes = BytesAlloc(seqN)
        BytesCopyInto(seqCopy, 0, ctx.inboxSeqno[last])
        out.seqno = seqCopy
    ctx.inboxCount = last
    return true

@borrows
fn pubsubHandleRpcFromPeer(ctx: var PubsubContext, rpc: PubsubRPC, hasPeer: bool, peer: PeerId): Result[bool] =
    if hasPeer && rpc.subCount > 0:
        let addRes: Result[bool] = pubsubAddPeer(ctx, peer)
        if IsErr(addRes):
            return Err[bool](Error(addRes))
        let idx: int32 = findPubsubPeer(ctx, peer)
        if idx < 0:
            return Err[bool]("pubsub: peer ! found")
        var peerRec: PubsubPeer = ctx.peers[idx]
        for s in 0..<rpc.subCount:
            let sub: PubsubSubscription = rpc.subs[s]
            let updateRes: Result[bool] = if sub.subscribe: pubsubpeer.PubsubPeerAddTopic(peerRec, sub.topic) else: pubsubpeer.PubsubPeerRemoveTopic(peerRec, sub.topic)
            if IsErr(updateRes):
                return Err[bool](Error(updateRes))
        ctx.peers[idx] = peerRec
    for i in 0..<rpc.msgCount:
        if ! (i < rpc.msgCount):
            break
        let msg: PubsubMessage = rpc.msgs[i]
        if pubsubHasTopic(ctx, msg.topic):
            if msg.hasSeqno && BytesLen(msg.seqno) > 0:
                if pubsubCacheHas(ctx.cache, msg):
                    continue
            let topicOwned: str = strings.CloneStr(msg.topic)
            let dataN: int32 = BytesLen(msg.data)
            var dataCopy: Bytes
            if dataN > 0:
                let dataAlloc: Bytes = BytesAlloc(dataN)
                BytesCopyInto(dataAlloc, 0, msg.data)
                dataCopy = dataAlloc
            let fromOwned: str = pubsubInboxFromPeerText(msg.hasFrom, msg.from)
            let hasFromFlag: bool = msg.hasFrom && (len(fromOwned) > 0)
            var seqCopy: Bytes
            if msg.hasSeqno:
                let seqN: int32 = BytesLen(msg.seqno)
                if seqN > 0:
                    let seqAlloc: Bytes = BytesAlloc(seqN)
                    BytesCopyInto(seqAlloc, 0, msg.seqno)
                    seqCopy = seqAlloc
            let enqRes: Result[bool] = pubsubInboxEnqueueParts(ctx, topicOwned, dataCopy, hasFromFlag, fromOwned, msg.hasSeqno, seqCopy)
            if IsErr(enqRes):
                return Err[bool](Error(enqRes))
            if msg.hasSeqno && BytesLen(msg.seqno) > 0:
                pubsubCacheAdd(ctx.cache, msg)
    return Ok[bool](true)

@borrows
fn pubsubHandleRpc(ctx: var PubsubContext, rpc: PubsubRPC): Result[bool] =
    return pubsubHandleRpcFromPeer(ctx, rpc, false, peerIdFromTextUnchecked(""))
