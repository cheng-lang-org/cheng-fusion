# Gossipsub types(minimal).

import cheng/libp2p/utils/bytes
type
    GossipsubMessageId =
        topic: str
        seqno: Bytes

    GossipsubParams =
        meshLow: int32
        meshHigh: int32
        meshOutbound: int32
        heartbeatMs: int32
        staggerMs: int32
        shardCount: int32
        shardId: int32

fn initGossipsubMessageId(topic: str, seqno: Bytes): GossipsubMessageId =
    GossipsubMessageId(topic: topic, seqno: seqno)

fn initGossipsubParams(): GossipsubParams =
    GossipsubParams(meshLow: 4, meshHigh: 12, meshOutbound: 2, heartbeatMs: 1000, staggerMs: 15, shardCount: 1, shardId: 0)
