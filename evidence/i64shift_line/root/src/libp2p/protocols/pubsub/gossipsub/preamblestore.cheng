# Gossipsub preamble store(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/seqs
const
    maxGossipsubPreambles = 128

type
    GossipsubPreambleStore =
        count: int32
        items: Bytes[]

fn initGossipsubPreambleStore(): GossipsubPreambleStore =
    var out: GossipsubPreambleStore
    out.count = 0
    return out

fn gossipsubPreambleHas(store: GossipsubPreambleStore, preamble: Bytes): bool =
    for i in 0..<store.count:
        if BytesEqual(store.items[i], preamble):
            return true
    return false

fn gossipsubPreambleAdd(store: var GossipsubPreambleStore, preamble: Bytes): Result[bool] =
    if BytesLen(preamble) <= 0:
        return Err[bool]("gossipsub: empty preamble")
    if gossipsubPreambleHas(store, preamble):
        return Ok[bool](true)
    if store.count >= maxGossipsubPreambles:
        return Err[bool]("gossipsub: preamble store full")
    add(store.items, preamble)
    store.count = store.items.len
    return Ok[bool](true)
