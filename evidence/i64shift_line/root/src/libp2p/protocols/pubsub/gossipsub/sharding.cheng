# Gossipsub sharding helpers(minimal).

import cheng/libp2p/utils/strings
@borrows
fn gossipsubShardForTopic(topic: str, shardCount: int32): int32 =
    if shardCount <= 0:
        return 0
    var sum: int32
    for i in 0..<len(topic):
        sum = sum + int32(topic[i])
    let modVal: int32 = sum % shardCount
    if modVal < 0:
        return 0
    return modVal

@borrows
fn gossipsubShardForPeerTopic(peerIdText: str, topic: str, shardCount: int32): int32 =
    if shardCount <= 0:
        return 0
    return gossipsubShardForTopic(peerIdText + "|" + topic, shardCount)

@borrows
fn gossipsubTopicInShard(topic: str, shardCount: int32, shardId: int32): bool =
    if shardCount <= 1:
        return true
    let topicShard: int32 = gossipsubShardForTopic(topic, shardCount)
    return topicShard == shardId
