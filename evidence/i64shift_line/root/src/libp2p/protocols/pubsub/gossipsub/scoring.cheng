# Gossipsub scoring(minimal).

import std/times
import cheng/libp2p/utils/strings
import std/seqs

const
    maxPeerScoreEntries = 256
    defaultGraylistThreshold = -10.0
    invalidMessagePenalty = 4.0
    duplicateMessagePenalty = 1.5

type
    PeerScore =
        value: float64
        penalty: float64
        updatedAtNs: int64

    PeerScoreEntry =
        peerText: str
        score: PeerScore

var
    peerScoreTableCount: int32
    peerScoreTable: PeerScoreEntry[]
    peerScoreGraylistThreshold: float64 = defaultGraylistThreshold

fn ensurePeerScoreTable() =
    if len(peerScoreTable) < maxPeerScoreEntries:
        setLen(peerScoreTable, maxPeerScoreEntries)

fn initPeerScore(): PeerScore =
    PeerScore(value: 0.0, penalty: 0.0, updatedAtNs: 0)

fn peerScoreApplyPenalty(score: var PeerScore, penalty: float64) =
    score.penalty = score.penalty + penalty
    score.value = score.value - penalty
    score.updatedAtNs = EpochTimeNs()

fn peerScoreApplyReward(score: var PeerScore, reward: float64) =
    score.value = score.value + reward
    score.updatedAtNs = EpochTimeNs()

fn peerScoringReset() =
    peerScoreTableCount = 0
    peerScoreGraylistThreshold = defaultGraylistThreshold

fn peerScoreSetGraylistThreshold(threshold: float64) =
    peerScoreGraylistThreshold = threshold

@borrows
fn peerScoreFind(peerText: str): int32 =
    ensurePeerScoreTable()
    if len(peerText) <= 0:
        return -1
    var i: int32
    while i < peerScoreTableCount:
        if peerScoreTable[i].peerText == peerText:
            return i
        i = i + 1
    return -1

@borrows
fn peerScoreEnsure(peerText: str): int32 =
    ensurePeerScoreTable()
    if len(peerText) <= 0:
        return -1
    let idx: int32 = peerScoreFind(peerText)
    if idx >= 0:
        return idx
    if peerScoreTableCount >= maxPeerScoreEntries:
        return -1
    peerScoreTable[peerScoreTableCount].peerText = strings.CloneStr(peerText)
    peerScoreTable[peerScoreTableCount].score = initPeerScore()
    peerScoreTableCount = peerScoreTableCount + 1
    return peerScoreTableCount - 1

@borrows
fn peerScoreValue(peerText: str): float64 =
    let idx: int32 = peerScoreFind(peerText)
    if idx < 0:
        return 0.0
    return peerScoreTable[idx].score.value

fn peerScoreIsGraylisted(peerText: str): bool =
    var local: str = strings.CloneStr(peerText)
    ensurePeerScoreTable()
    if len(local) <= 0:
        return false
    var i: int32
    while i < peerScoreTableCount:
        if peerScoreTable[i].peerText == local:
            return peerScoreTable[i].score.value <= peerScoreGraylistThreshold
        i = i + 1
    return false

@borrows
fn peerScorePenalty(peerText: str, penalty: float64): float64 =
    let idx: int32 = peerScoreEnsure(peerText)
    if idx < 0:
        return 0.0
    var score: PeerScore = peerScoreTable[idx].score
    peerScoreApplyPenalty(score, penalty)
    peerScoreTable[idx].score = score
    return score.value

@borrows
fn peerScoreReward(peerText: str, reward: float64): float64 =
    let idx: int32 = peerScoreEnsure(peerText)
    if idx < 0:
        return 0.0
    var score: PeerScore = peerScoreTable[idx].score
    peerScoreApplyReward(score, reward)
    peerScoreTable[idx].score = score
    return score.value

@borrows
fn peerScorePenaltyInvalidMessage(peerText: str): float64 =
    return peerScorePenalty(peerText, invalidMessagePenalty)

@borrows
fn peerScorePenaltyDuplicateMessage(peerText: str): float64 =
    return peerScorePenalty(peerText, duplicateMessagePenalty)
