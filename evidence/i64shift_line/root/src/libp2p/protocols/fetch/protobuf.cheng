# Fetch protobuf messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/multiformats/protobuf/minprotobuf
const
    maxFetchRequests = 16
    maxFetchResponses = 16
    maxFetchBlocks = 16

    msgRequestField = 1
    msgResponseField = 2
    msgBlockField = 3

    reqIdField = 1
    reqRootField = 2

    respIdField = 1
    respStatusField = 2

    blockPrefixField = 1
    blockDataField = 2

type
    FetchRequest =
        hasId: bool
        id: int32
        hasRoot: bool
        root: Bytes

    FetchResponse =
        hasId: bool
        id: int32
        status: int32

    FetchBlock =
        prefix: Bytes
        data: Bytes

    FetchMessage =
        requestCount: int32
        requests: FetchRequest[maxFetchRequests]
        responseCount: int32
        responses: FetchResponse[maxFetchResponses]
        blockCount: int32
        blocks: FetchBlock[maxFetchBlocks]

fn initFetchRequest(): FetchRequest =
    FetchRequest(hasId: false, hasRoot: false)

fn initFetchResponse(): FetchResponse =
    FetchResponse(hasId: false, status: 0)

fn initFetchBlock(): FetchBlock =
    FetchBlock(prefix: EmptyBytes(), data: EmptyBytes())

fn initFetchMessage(): FetchMessage =
    FetchMessage(requestCount: 0, responseCount: 0, blockCount: 0)

fn encodeFetchRequest(req: FetchRequest): Result[Bytes] =
    if ! req.hasRoot:
        return Err[Bytes]("fetch: request missing root")
    var pb: ProtoBuffer = InitProtoBuffer()
    if req.hasId:
        writeVarint(pb, reqIdField, int64(req.id))
    writeBytes(pb, reqRootField, req.root)
    return Ok[Bytes](protoToBytes(pb))

fn decodeFetchRequest(data: Bytes): Result[FetchRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: FetchRequest = initFetchRequest()
    var idVal: int64
    let idRes: Result[bool] = getField(pb, reqIdField, idVal)
    if IsErr(idRes):
        return Err[FetchRequest](Error(idRes))
    if Value(idRes):
        req.hasId = true
        req.id = int32(idVal)
    var rootBytes: Bytes = EmptyBytes()
    let rootRes: Result[bool] = getField(pb, reqRootField, rootBytes)
    if IsErr(rootRes):
        return Err[FetchRequest](Error(rootRes))
    if Value(rootRes):
        req.hasRoot = true
        req.root = rootBytes
    if ! req.hasRoot:
        return Err[FetchRequest]("fetch: request missing root")
    return Ok[FetchRequest](req)

fn encodeFetchResponse(resp: FetchResponse): Result[Bytes] =
    if ! resp.hasId:
        return Err[Bytes]("fetch: response missing id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, respIdField, int64(resp.id))
    writeVarint(pb, respStatusField, int64(resp.status))
    return Ok[Bytes](protoToBytes(pb))

fn decodeFetchResponse(data: Bytes): Result[FetchResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: FetchResponse = initFetchResponse()
    var idVal: int64
    let idRes: Result[bool] = getField(pb, respIdField, idVal)
    if IsErr(idRes):
        return Err[FetchResponse](Error(idRes))
    if Value(idRes):
        resp.hasId = true
        resp.id = int32(idVal)
    var statusVal: int64
    let statusRes: Result[bool] = getField(pb, respStatusField, statusVal)
    if IsErr(statusRes):
        return Err[FetchResponse](Error(statusRes))
    if Value(statusRes):
        resp.status = int32(statusVal)
    if ! resp.hasId:
        return Err[FetchResponse]("fetch: response missing id")
    return Ok[FetchResponse](resp)

fn encodeFetchBlock(block: FetchBlock): Result[Bytes] =
    if BytesLen(block.data) <= 0:
        return Err[Bytes]("fetch: block missing data")
    var pb: ProtoBuffer = InitProtoBuffer()
    if BytesLen(block.prefix) > 0:
        writeBytes(pb, blockPrefixField, block.prefix)
    writeBytes(pb, blockDataField, block.data)
    return Ok[Bytes](protoToBytes(pb))

fn decodeFetchBlock(data: Bytes): Result[FetchBlock] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var blk: FetchBlock = initFetchBlock()
    var prefixBytes: Bytes = EmptyBytes()
    let prefixRes: Result[bool] = getField(pb, blockPrefixField, prefixBytes)
    if IsErr(prefixRes):
        return Err[FetchBlock](Error(prefixRes))
    if Value(prefixRes):
        blk.prefix = prefixBytes
    var dataBytes: Bytes = EmptyBytes()
    let dataRes: Result[bool] = getField(pb, blockDataField, dataBytes)
    if IsErr(dataRes):
        return Err[FetchBlock](Error(dataRes))
    if Value(dataRes):
        blk.data = dataBytes
    if BytesLen(blk.data) <= 0:
        return Err[FetchBlock]("fetch: block missing data")
    return Ok[FetchBlock](blk)

fn encodeFetchMessage(msg: FetchMessage): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    for i in 0..<msg.requestCount:
        let reqRes: Result[Bytes] = encodeFetchRequest(msg.requests[i])
        if IsErr(reqRes):
            return Err[Bytes](Error(reqRes))
        writeBytes(pb, msgRequestField, Value(reqRes))
    for i in 0..<msg.responseCount:
        let respRes: Result[Bytes] = encodeFetchResponse(msg.responses[i])
        if IsErr(respRes):
            return Err[Bytes](Error(respRes))
        writeBytes(pb, msgResponseField, Value(respRes))
    for i in 0..<msg.blockCount:
        let blockRes: Result[Bytes] = encodeFetchBlock(msg.blocks[i])
        if IsErr(blockRes):
            return Err[Bytes](Error(blockRes))
        writeBytes(pb, msgBlockField, Value(blockRes))
    return Ok[Bytes](protoToBytes(pb))

fn decodeFetchMessage(data: Bytes): Result[FetchMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: FetchMessage = initFetchMessage()
    var reqBytes: RepeatedBytes = initRepeatedBytes()
    let reqRes: Result[bool] = getRepeatedField(pb, msgRequestField, reqBytes)
    if IsErr(reqRes):
        return Err[FetchMessage](Error(reqRes))
    if Value(reqRes):
        for i in 0..<reqBytes.count:
            if msg.requestCount >= maxFetchRequests:
                return Err[FetchMessage]("fetch: too many requests")
            let reqValRes: Result[FetchRequest] = decodeFetchRequest(reqBytes.items[i])
            if IsErr(reqValRes):
                return Err[FetchMessage](Error(reqValRes))
            msg.requests[msg.requestCount] = Value(reqValRes)
            msg.requestCount = msg.requestCount + 1
    var respBytes: RepeatedBytes = initRepeatedBytes()
    let respRes: Result[bool] = getRepeatedField(pb, msgResponseField, respBytes)
    if IsErr(respRes):
        return Err[FetchMessage](Error(respRes))
    if Value(respRes):
        for i in 0..<respBytes.count:
            if msg.responseCount >= maxFetchResponses:
                return Err[FetchMessage]("fetch: too many responses")
            let respValRes: Result[FetchResponse] = decodeFetchResponse(respBytes.items[i])
            if IsErr(respValRes):
                return Err[FetchMessage](Error(respValRes))
            msg.responses[msg.responseCount] = Value(respValRes)
            msg.responseCount = msg.responseCount + 1
    var blockBytes: RepeatedBytes = initRepeatedBytes()
    let blockRes: Result[bool] = getRepeatedField(pb, msgBlockField, blockBytes)
    if IsErr(blockRes):
        return Err[FetchMessage](Error(blockRes))
    if Value(blockRes):
        for i in 0..<blockBytes.count:
            if msg.blockCount >= maxFetchBlocks:
                return Err[FetchMessage]("fetch: too many blocks")
            let blockValRes: Result[FetchBlock] = decodeFetchBlock(blockBytes.items[i])
            if IsErr(blockValRes):
                return Err[FetchMessage](Error(blockValRes))
            msg.blocks[msg.blockCount] = Value(blockValRes)
            msg.blockCount = msg.blockCount + 1
    return Ok[FetchMessage](msg)
