# Fetch protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
import cheng/libp2p/cid
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/bitswap/store
import cheng/libp2p/protocols/fetch/protobuf as fetchprotobuf
const
    fetchCodec = "/ipfs/fetch/1.0.0"
    fetchDefaultMaxMessage = 4194304
    fetchStatusOk = 0
    fetchStatusNotFound = 1
    fetchStatusInvalid = 2

type
    FetchConfig =
        maxMessageBytes: int32

    FetchContext =
        hasStore: bool
        store: BitswapBlockStore
        config: FetchConfig

    FetchResponseBundle =
        resp: FetchResponse
        block: FetchBlock
        hasBlock: bool

var
    fetchContext: FetchContext = FetchContext(
        hasStore: false,
        config: FetchConfig(maxMessageBytes: fetchDefaultMaxMessage)
    )

fn initFetchConfig(): FetchConfig =
    FetchConfig(maxMessageBytes: fetchDefaultMaxMessage)

fn setFetchStore(store: BitswapBlockStore) =
    fetchContext.store = store
    fetchContext.hasStore = true

fn setFetchConfig(config: FetchConfig) =
    fetchContext.config = config

fn fetchContextReady(): bool =
    fetchContext.hasStore

fn fetchPutBlock(cid: Cid, data: Bytes): Result[bool] =
    if ! fetchContext.hasStore:
        return Err[bool]("fetch: missing store")
    var store: BitswapBlockStore = fetchContext.store
    let putRes: Result[bool] = bitswapStorePut(store, cid, data)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    fetchContext.store = store
    return Ok[bool](true)

fn fetchGetBlock(cid: Cid): Result[Bytes] =
    if ! fetchContext.hasStore:
        return Err[Bytes]("fetch: missing store")
    return bitswapStoreGet(fetchContext.store, cid)

fn fetchHasBlock(cid: Cid): bool =
    if ! fetchContext.hasStore:
        return false
    return bitswapStoreHas(fetchContext.store, cid)

fn fetchCidPrefix(cid: Cid): Result[Bytes] =
    var buf: GrowByteBuffer = newByteBuffer()
    if cid.version == 1:
        appendBytes(buf, encodeUVarint(1))
        appendBytes(buf, encodeUVarint(cid.codec.code))
    appendBytes(buf, encodeUVarint(cid.multihash.code))
    appendBytes(buf, encodeUVarint(int64(cid.multihash.length)))
    return Ok[Bytes](toBytes(buf))

fn readFetchMessage(stream: var Stream): Result[FetchMessage] =
    let dataRes: Result[Bytes] = readLp(stream, fetchContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[FetchMessage](Error(dataRes))
    return decodeFetchMessage(Value(dataRes))

fn writeFetchMessage(stream: var Stream, msg: FetchMessage): Result[bool] =
    let encRes: Result[Bytes] = encodeFetchMessage(msg)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn buildFetchResponse(req: FetchRequest): Result[FetchResponseBundle] =
    var resp: FetchResponse = initFetchResponse()
    var blk: FetchBlock = initFetchBlock()
    var hasBlock: bool
    resp.hasId = true
    if req.hasId:
        resp.id = req.id
    else:
        resp.id = 0
    if ! req.hasRoot:
        resp.status = fetchStatusInvalid
        return Ok[FetchResponseBundle](FetchResponseBundle(resp: resp, block: blk, hasBlock: false))
    let cidRes: Result[Cid] = cidFromBytes(req.root)
    if IsErr(cidRes):
        resp.status = fetchStatusInvalid
        return Ok[FetchResponseBundle](FetchResponseBundle(resp: resp, block: blk, hasBlock: false))
    let cid: Cid = Value(cidRes)
    if fetchHasBlock(cid):
        let dataRes: Result[Bytes] = fetchGetBlock(cid)
        if IsOk(dataRes):
            let prefixRes: Result[Bytes] = fetchCidPrefix(cid)
            if IsOk(prefixRes):
                blk.prefix = Value(prefixRes)
            blk.data = Value(dataRes)
            hasBlock = true
            resp.status = fetchStatusOk
        else:
            resp.status = fetchStatusInvalid
    else:
        resp.status = fetchStatusNotFound
    return Ok[FetchResponseBundle](FetchResponseBundle(resp: resp, block: blk, hasBlock: hasBlock))

fn fetchHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    if ! fetchContextReady():
        return Err[bool]("fetch: missing store")
    let msgRes: Result[FetchMessage] = readFetchMessage(streamVar)
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    let msg: FetchMessage = Value(msgRes)
    var reply: FetchMessage = initFetchMessage()
    for i in 0..<msg.requestCount:
        if ! (i < msg.requestCount && reply.responseCount < maxFetchResponses):
            break
        let req: FetchRequest = msg.requests[i]
        let respRes = buildFetchResponse(req)
        if IsErr(respRes):
            return Err[bool](Error(respRes))
        let resp = Value(respRes)
        reply.responses[reply.responseCount] = resp.resp
        reply.responseCount = reply.responseCount + 1
        if resp.hasBlock && reply.blockCount < maxFetchBlocks:
            reply.blocks[reply.blockCount] = resp.block
            reply.blockCount = reply.blockCount + 1
    let writeRes: Result[bool] = writeFetchMessage(streamVar, reply)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn fetchProtocol(): Lp2pProtocol =
    return newProtocol(fetchCodec, fetchHandler)
