# Livestream protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/livestream/protobuf as livepb
const
    livestreamCodec = "/libp2p/livestream/1.0.0"
    livestreamDefaultMaxMessage = 4194304

type
    LivestreamConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    LivestreamContext =
        config: LivestreamConfig
        hasHandler: bool
        handler: fn(req: LivestreamRequest): LivestreamResponse

var
    livestreamContext: LivestreamContext = LivestreamContext(
        config: LivestreamConfig(maxMessageBytes: livestreamDefaultMaxMessage, closeAfterResponse: true),
        hasHandler: false
    )

fn initLivestreamConfig(): LivestreamConfig =
    LivestreamConfig(maxMessageBytes: livestreamDefaultMaxMessage, closeAfterResponse: true)

fn setLivestreamConfig(config: LivestreamConfig) =
    livestreamContext.config = config

fn setLivestreamHandler(handler: fn(req: LivestreamRequest): LivestreamResponse) =
    livestreamContext.handler = handler
    livestreamContext.hasHandler = true

fn readLivestreamRequest(stream: var Stream): Result[LivestreamRequest] =
    let dataRes: Result[Bytes] = readLp(stream, livestreamContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[LivestreamRequest](Error(dataRes))
    return decodeLivestreamRequest(Value(dataRes))

fn writeLivestreamRequest(stream: var Stream, req: LivestreamRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeLivestreamRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readLivestreamResponse(stream: var Stream): Result[LivestreamResponse] =
    let dataRes: Result[Bytes] = readLp(stream, livestreamContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[LivestreamResponse](Error(dataRes))
    return decodeLivestreamResponse(Value(dataRes))

fn writeLivestreamResponse(stream: var Stream, resp: LivestreamResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeLivestreamResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultLivestreamHandler(req: LivestreamRequest): LivestreamResponse =
    var resp: LivestreamResponse = initLivestreamResponse()
    resp.ok = true
    resp.message = "ok"
    resp.nextSeq = req.seq + 1
    return resp

fn livestreamHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[LivestreamRequest] = readLivestreamRequest(streamVar)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: LivestreamRequest = Value(reqRes)
    var resp: LivestreamResponse
    if livestreamContext.hasHandler:
        let handlerFn: fn(req: LivestreamRequest): LivestreamResponse = livestreamContext.handler
        resp = handlerFn(req)
    else:
        resp = defaultLivestreamHandler(req)
    let writeRes: Result[bool] = writeLivestreamResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if livestreamContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn livestreamProtocol(): Lp2pProtocol =
    return newProtocol(livestreamCodec, livestreamHandler)
