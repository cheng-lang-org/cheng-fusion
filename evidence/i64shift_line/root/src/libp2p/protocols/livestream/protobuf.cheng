# Livestream protobuf messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
const
    livestreamReqStreamIdField = 1
    livestreamReqSeqField = 2
    livestreamReqDataField = 3
    livestreamReqEndField = 4

    livestreamRespOkField = 1
    livestreamRespMessageField = 2
    livestreamRespNextSeqField = 3

type
    LivestreamRequest =
        streamId: str
        seq: int64
        data: Bytes
        endOfStream: bool

    LivestreamResponse =
        ok: bool
        message: str
        nextSeq: int64

fn initLivestreamRequest(): LivestreamRequest =
    LivestreamRequest(streamId: "", seq: 0, data: EmptyBytes(), endOfStream: false)

fn initLivestreamResponse(): LivestreamResponse =
    LivestreamResponse(ok: false, message: "", nextSeq: 0)

fn encodeLivestreamRequest(req: LivestreamRequest): Result[Bytes] =
    if len(req.streamId) <= 0:
        return Err[Bytes]("livestream: empty stream id")
    if BytesLen(req.data) <= 0 && ! req.endOfStream:
        return Err[Bytes]("livestream: empty payload")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, livestreamReqStreamIdField, req.streamId)
    if req.seq != 0:
        writeVarint(pb, livestreamReqSeqField, req.seq)
    if BytesLen(req.data) > 0:
        writeBytes(pb, livestreamReqDataField, req.data)
    if req.endOfStream:
        writeVarint(pb, livestreamReqEndField, 1)
    return Ok[Bytes](protoToBytes(pb))

fn decodeLivestreamRequest(data: Bytes): Result[LivestreamRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: LivestreamRequest = initLivestreamRequest()
    var streamId: str
    let idRes: Result[bool] = getField(pb, livestreamReqStreamIdField, streamId)
    if IsErr(idRes):
        return Err[LivestreamRequest](Error(idRes))
    if Value(idRes):
        req.streamId = streamId
    var seqVal: int64
    let seqRes: Result[bool] = getField(pb, livestreamReqSeqField, seqVal)
    if IsErr(seqRes):
        return Err[LivestreamRequest](Error(seqRes))
    if Value(seqRes):
        req.seq = seqVal
    var payload: Bytes = EmptyBytes()
    let dataRes: Result[bool] = getField(pb, livestreamReqDataField, payload)
    if IsErr(dataRes):
        return Err[LivestreamRequest](Error(dataRes))
    if Value(dataRes):
        req.data = payload
    var endVal: int64
    let endRes: Result[bool] = getField(pb, livestreamReqEndField, endVal)
    if IsErr(endRes):
        return Err[LivestreamRequest](Error(endRes))
    if Value(endRes):
        req.endOfStream = endVal != 0
    if len(req.streamId) <= 0:
        return Err[LivestreamRequest]("livestream: empty stream id")
    if BytesLen(req.data) <= 0 && ! req.endOfStream:
        return Err[LivestreamRequest]("livestream: empty payload")
    return Ok[LivestreamRequest](req)

fn encodeLivestreamResponse(resp: LivestreamResponse): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if resp.ok:
        writeVarint(pb, livestreamRespOkField, 1)
    if len(resp.message) > 0:
        writeString(pb, livestreamRespMessageField, resp.message)
    if resp.nextSeq != 0:
        writeVarint(pb, livestreamRespNextSeqField, resp.nextSeq)
    return Ok[Bytes](protoToBytes(pb))

fn decodeLivestreamResponse(data: Bytes): Result[LivestreamResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: LivestreamResponse = initLivestreamResponse()
    var okVal: int64
    let okRes: Result[bool] = getField(pb, livestreamRespOkField, okVal)
    if IsErr(okRes):
        return Err[LivestreamResponse](Error(okRes))
    if Value(okRes):
        resp.ok = okVal != 0
    var msg: str
    let msgRes: Result[bool] = getField(pb, livestreamRespMessageField, msg)
    if IsErr(msgRes):
        return Err[LivestreamResponse](Error(msgRes))
    if Value(msgRes):
        resp.message = msg
    var nextVal: int64
    let nextRes: Result[bool] = getField(pb, livestreamRespNextSeqField, nextVal)
    if IsErr(nextRes):
        return Err[LivestreamResponse](Error(nextRes))
    if Value(nextRes):
        resp.nextSeq = nextVal
    return Ok[LivestreamResponse](resp)
