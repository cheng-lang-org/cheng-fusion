# DM envelope protocol(robust, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import std/multiformats/protobuf/minprotobuf
const
    dmEnvelopeCodec = "/libp2p/dm/1.1.0"
    dmEnvelopeDefaultMaxMessage = 1048576

    dmEnvIdField = 1
    dmEnvKindField = 2
    dmEnvTextField = 3
    dmEnvPayloadField = 4
    dmEnvOkField = 5
    dmEnvErrorField = 6
    dmEnvTimestampField = 7

    dmEnvelopeKindRequest = 1
    dmEnvelopeKindResponse = 2
    dmEnvelopeKindAck = 3

type
    DmEnvelope =
        id: int64
        kind: int32
        text: str
        payload: Bytes
        ok: bool
        errorMessage: str
        timestampMs: int64

    DmEnvelopeConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    DmEnvelopeContext =
        config: DmEnvelopeConfig
        hasHandler: bool
        handler: fn(req: DmEnvelope): DmEnvelope

var
    dmEnvelopeContext: DmEnvelopeContext = DmEnvelopeContext(
        config: DmEnvelopeConfig(maxMessageBytes: dmEnvelopeDefaultMaxMessage, closeAfterResponse: true),
        hasHandler: false
    )

fn initDmEnvelopeConfig(): DmEnvelopeConfig =
    DmEnvelopeConfig(maxMessageBytes: dmEnvelopeDefaultMaxMessage, closeAfterResponse: true)

fn setDmEnvelopeConfig(config: DmEnvelopeConfig) =
    dmEnvelopeContext.config = config

fn setDmEnvelopeHandler(handler: fn(req: DmEnvelope): DmEnvelope) =
    dmEnvelopeContext.handler = handler
    dmEnvelopeContext.hasHandler = true

fn initDmEnvelope(): DmEnvelope =
    DmEnvelope(
        id: 0,
        kind: dmEnvelopeKindRequest,
        text: "",
        payload: EmptyBytes(),
        ok: false,
        errorMessage: "",
        timestampMs: 0
    )

fn encodeDmEnvelope(env: DmEnvelope): Result[Bytes] =
    if env.id <= 0:
        return Err[Bytes]("dm envelope: missing id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, dmEnvIdField, env.id)
    writeVarint(pb, dmEnvKindField, int64(env.kind))
    if len(env.text) > 0:
        writeString(pb, dmEnvTextField, env.text)
    if BytesLen(env.payload) > 0:
        writeBytes(pb, dmEnvPayloadField, env.payload)
    if env.ok:
        writeVarint(pb, dmEnvOkField, 1)
    if len(env.errorMessage) > 0:
        writeString(pb, dmEnvErrorField, env.errorMessage)
    if env.timestampMs > 0:
        writeVarint(pb, dmEnvTimestampField, env.timestampMs)
    let encoded: Bytes = protoToBytes(pb)
    let owned: Bytes = BytesSlice(encoded, 0, BytesLen(encoded))
    return Ok[Bytes](owned)

fn decodeDmEnvelope(data: Bytes): Result[DmEnvelope] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var env: DmEnvelope = initDmEnvelope()
    var idVal: int64
    let idRes: Result[bool] = getField(pb, dmEnvIdField, idVal)
    if IsErr(idRes):
        return Err[DmEnvelope](Error(idRes))
    if Value(idRes):
        env.id = idVal
    var kindVal: int64
    let kindRes: Result[bool] = getField(pb, dmEnvKindField, kindVal)
    if IsErr(kindRes):
        return Err[DmEnvelope](Error(kindRes))
    if Value(kindRes):
        if kindVal != int64(dmEnvelopeKindRequest) && kindVal != int64(dmEnvelopeKindResponse) && kindVal != int64(dmEnvelopeKindAck):
            return Err[DmEnvelope]("dm envelope: invalid kind")
        env.kind = int32(kindVal)
    var textVal: str
    let textRes: Result[bool] = getField(pb, dmEnvTextField, textVal)
    if IsErr(textRes):
        return Err[DmEnvelope](Error(textRes))
    if Value(textRes):
        env.text = textVal
    var payloadVal: Bytes = EmptyBytes()
    let payloadRes: Result[bool] = getField(pb, dmEnvPayloadField, payloadVal)
    if IsErr(payloadRes):
        return Err[DmEnvelope](Error(payloadRes))
    if Value(payloadRes):
        env.payload = payloadVal
    var okVal: int64
    let okRes: Result[bool] = getField(pb, dmEnvOkField, okVal)
    if IsErr(okRes):
        return Err[DmEnvelope](Error(okRes))
    if Value(okRes):
        env.ok = okVal != 0
    var errVal: str
    let errRes: Result[bool] = getField(pb, dmEnvErrorField, errVal)
    if IsErr(errRes):
        return Err[DmEnvelope](Error(errRes))
    if Value(errRes):
        env.errorMessage = errVal
    var tsVal: int64
    let tsRes: Result[bool] = getField(pb, dmEnvTimestampField, tsVal)
    if IsErr(tsRes):
        return Err[DmEnvelope](Error(tsRes))
    if Value(tsRes):
        env.timestampMs = tsVal
    if env.id <= 0:
        return Err[DmEnvelope]("dm envelope: missing id")
    if env.kind == dmEnvelopeKindRequest && len(env.text) <= 0 && BytesLen(env.payload) <= 0:
        return Err[DmEnvelope]("dm envelope: empty request")
    return Ok[DmEnvelope](env)

fn readDmEnvelope(stream: var Stream): Result[DmEnvelope] =
    let dataRes: Result[Bytes] = readLp(stream, dmEnvelopeContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[DmEnvelope](Error(dataRes))
    return decodeDmEnvelope(Value(dataRes))

fn writeDmEnvelope(stream: var Stream, env: DmEnvelope): Result[bool] =
    let encRes: Result[Bytes] = encodeDmEnvelope(env)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultDmEnvelopeHandler(req: DmEnvelope): DmEnvelope =
    var resp: DmEnvelope = initDmEnvelope()
    resp.id = req.id
    resp.kind = dmEnvelopeKindResponse
    resp.ok = true
    if len(req.text) > 0:
        resp.text = "ok:" + req.text
    else:
        resp.text = "ok"
    if BytesLen(req.payload) > 0:
        resp.payload = req.payload
    return resp

fn dmEnvelopeHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[DmEnvelope] = readDmEnvelope(streamVar)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: DmEnvelope = Value(reqRes)
    var resp: DmEnvelope = if dmEnvelopeContext.hasHandler: dmEnvelopeContext.handler(req) else: defaultDmEnvelopeHandler(req)
    resp.id = req.id
    resp.kind = dmEnvelopeKindResponse
    let writeRes: Result[bool] = writeDmEnvelope(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if dmEnvelopeContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn dmEnvelopeProtocol(): Lp2pProtocol =
    return newProtocol(dmEnvelopeCodec, dmEnvelopeHandler)
