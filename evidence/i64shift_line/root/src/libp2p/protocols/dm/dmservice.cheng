# DM service protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import std/multiformats/protobuf/minprotobuf
const
    dMCodec = "/libp2p/dm/1.0.0"
    dMDefaultMaxMessage = 1048576

    dmReqTextField = 1
    dmRespOkField = 1
    dmRespMessageField = 2

type
    DmRequest =
        text: str

    DmResponse =
        ok: bool
        message: str

    DmConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    DmContext =
        config: DmConfig
        hasHandler: bool
        handler: fn(req: DmRequest): DmResponse

var
    dmContext: DmContext = DmContext(
        config: DmConfig(maxMessageBytes: dMDefaultMaxMessage, closeAfterResponse: true),
        hasHandler: false
    )

fn initDmConfig(): DmConfig =
    DmConfig(maxMessageBytes: dMDefaultMaxMessage, closeAfterResponse: true)

fn setDmConfig(config: DmConfig) =
    dmContext.config = config

fn setDmHandler(handler: fn(req: DmRequest): DmResponse) =
    dmContext.handler = handler
    dmContext.hasHandler = true

fn initDmRequest(): DmRequest =
    DmRequest(text: "")

fn initDmResponse(): DmResponse =
    DmResponse(ok: false, message: "")

fn encodeDmRequest(req: DmRequest): Result[Bytes] =
    if len(req.text) <= 0:
        return Err[Bytes]("dm: empty request")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, dmReqTextField, req.text)
    return Ok[Bytes](protoToBytes(pb))

fn decodeDmRequest(data: Bytes): Result[DmRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: DmRequest = initDmRequest()
    var text: str
    let textRes: Result[bool] = getField(pb, dmReqTextField, text)
    if IsErr(textRes):
        return Err[DmRequest](Error(textRes))
    if Value(textRes):
        req.text = text
    if len(req.text) <= 0:
        return Err[DmRequest]("dm: empty request")
    return Ok[DmRequest](req)

fn encodeDmResponse(resp: DmResponse): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if resp.ok:
        writeVarint(pb, dmRespOkField, 1)
    if len(resp.message) > 0:
        writeString(pb, dmRespMessageField, resp.message)
    return Ok[Bytes](protoToBytes(pb))

fn decodeDmResponse(data: Bytes): Result[DmResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: DmResponse = initDmResponse()
    var okVal: int64
    let okRes: Result[bool] = getField(pb, dmRespOkField, okVal)
    if IsErr(okRes):
        return Err[DmResponse](Error(okRes))
    if Value(okRes):
        resp.ok = okVal != 0
    var msg: str
    let msgRes: Result[bool] = getField(pb, dmRespMessageField, msg)
    if IsErr(msgRes):
        return Err[DmResponse](Error(msgRes))
    if Value(msgRes):
        resp.message = msg
    return Ok[DmResponse](resp)

fn readDmRequest(stream: var Stream): Result[DmRequest] =
    let dataRes: Result[Bytes] = readLp(stream, dmContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[DmRequest](Error(dataRes))
    return decodeDmRequest(Value(dataRes))

fn writeDmRequest(stream: var Stream, req: DmRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeDmRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readDmResponse(stream: var Stream): Result[DmResponse] =
    let dataRes: Result[Bytes] = readLp(stream, dmContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[DmResponse](Error(dataRes))
    return decodeDmResponse(Value(dataRes))

fn writeDmResponse(stream: var Stream, resp: DmResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeDmResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultDmHandler(req: DmRequest): DmResponse =
    req
    var resp: DmResponse = initDmResponse()
    resp.ok = true
    resp.message = "ok"
    return resp

fn dmHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[DmRequest] = readDmRequest(streamVar)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: DmRequest = Value(reqRes)
    var resp: DmResponse
    if dmContext.hasHandler:
        let handlerFn: fn(req: DmRequest): DmResponse = dmContext.handler
        resp = handlerFn(req)
    else:
        resp = defaultDmHandler(req)
    let writeRes: Result[bool] = writeDmResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if dmContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn dmProtocol(): Lp2pProtocol =
    return newProtocol(dMCodec, dmHandler)
