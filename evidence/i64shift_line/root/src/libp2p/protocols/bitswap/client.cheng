# Bitswap client helpers(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/cid
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/bitswap/protobuf as bitswapprotobuf
import cheng/libp2p/protocols/bitswap/bitswap
fn buildBitswapWantMessage(cid: Cid, wantType: WantType, sendDontHave: bool): Result[BitswapMessage] =
    var entry: WantEntry = initWantEntry()
    entry.hasCid = true
    entry.cid = cid
    entry.wantType = wantType
    entry.priority = 1
    entry.sendDontHave = sendDontHave
    var list: Wantlist = initWantlist()
    list.entries[0] = entry
    list.entryCount = 1
    var msg: BitswapMessage = initBitswapMessage()
    msg.hasWantlist = true
    msg.wantlist = list
    return Ok[BitswapMessage](msg)

fn bitswapSendWant(stream: var Stream, cid: Cid, wantType: WantType, sendDontHave: bool): Result[bool] =
    let msgRes: Result[BitswapMessage] = buildBitswapWantMessage(cid, wantType, sendDontHave)
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    return writeBitswapMessage(stream, Value(msgRes))

fn bitswapRequestBlock(stream: var Stream, cid: Cid): Result[Bytes] =
    let sendRes: Result[bool] = bitswapSendWant(stream, cid, wtBlock, true)
    if IsErr(sendRes):
        return Err[Bytes](Error(sendRes))
    let replyRes: Result[BitswapMessage] = readBitswapMessage(stream)
    if IsErr(replyRes):
        return Err[Bytes](Error(replyRes))
    let reply: BitswapMessage = Value(replyRes)
    if reply.blockCount > 0:
        return Ok[Bytes](reply.blocks[0])
    if reply.payloadCount > 0:
        return Ok[Bytes](reply.payloads[0].data)
    if reply.presenceCount > 0 && reply.presences[0].presenceType == bpDontHave:
        return Err[Bytes]("bitswap: dont have")
    return Err[Bytes]("bitswap: missing block")

fn bitswapRequestHave(stream: var Stream, cid: Cid): Result[bool] =
    let sendRes: Result[bool] = bitswapSendWant(stream, cid, wtHave, true)
    if IsErr(sendRes):
        return Err[bool](Error(sendRes))
    let replyRes: Result[BitswapMessage] = readBitswapMessage(stream)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let reply: BitswapMessage = Value(replyRes)
    if reply.presenceCount > 0:
        return Ok[bool](reply.presences[0].presenceType == bpHave)
    if reply.blockCount > 0 || reply.payloadCount > 0:
        return Ok[bool](true)
    return Err[bool]("bitswap: missing presence")
