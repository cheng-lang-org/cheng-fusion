# Bitswap protobuf messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/cid
const
    maxBitswapWantEntries = 32
    maxBitswapBlocks = 32
    maxBitswapPayloads = 32
    maxBitswapPresences = 32

    msgWantlistField = 1
    msgBlocksField = 2
    msgPayloadField = 3
    msgBlockPresenceField = 4
    msgPendingBytesField = 5

    wantlistEntriesField = 1
    wantlistFullField = 2

    entryBlockField = 1
    entryPriorityField = 2
    entryCancelField = 3
    entryWantTypeField = 4
    entrySendDontHaveField = 5

    payloadPrefixField = 1
    payloadDataField = 2

    presenceCidField = 1
    presenceTypeField = 2

type
    WantType = enum
        wtBlock = 0
        wtHave = 1

    BlockPresenceType = enum
        bpHave = 0
        bpDontHave = 1

    WantEntry =
        hasCid: bool
        cid: Cid
        priority: int32
        cancel: bool
        wantType: WantType
        sendDontHave: bool

    Wantlist =
        entryCount: int32
        entries: WantEntry[maxBitswapWantEntries]
        full: bool

    BlockPayload =
        prefix: Bytes
        data: Bytes

    BlockPresence =
        hasCid: bool
        cid: Cid
        presenceType: BlockPresenceType

    BitswapMessage =
        hasWantlist: bool
        wantlist: Wantlist
        blockCount: int32
        blocks: Bytes[maxBitswapBlocks]
        payloadCount: int32
        payloads: BlockPayload[maxBitswapPayloads]
        presenceCount: int32
        presences: BlockPresence[maxBitswapPresences]
        hasPendingBytes: bool
        pendingBytes: int32

fn initWantEntry(): WantEntry =
    WantEntry(hasCid: false, priority: 1, cancel: false, wantType: wtBlock, sendDontHave: false)

fn initWantlist(): Wantlist =
    Wantlist(entryCount: 0, full: false)

fn initBlockPayload(): BlockPayload =
    BlockPayload(prefix: EmptyBytes(), data: EmptyBytes())

fn initBlockPresence(): BlockPresence =
    BlockPresence(hasCid: false, presenceType: bpHave)

fn initBitswapMessage(): BitswapMessage =
    BitswapMessage(
        hasWantlist: false,
        wantlist: initWantlist(),
        blockCount: 0,
        payloadCount: 0,
        presenceCount: 0,
        hasPendingBytes: false,
        pendingBytes: 0
    )

fn wantTypeFromInt(value: int64): Result[WantType] =
    if value == 0:
        return Ok[WantType](wtBlock)
    if value == 1:
        return Ok[WantType](wtHave)
    return Err[WantType]("bitswap: invalid want type")

fn presenceTypeFromInt(value: int64): Result[BlockPresenceType] =
    if value == 0:
        return Ok[BlockPresenceType](bpHave)
    if value == 1:
        return Ok[BlockPresenceType](bpDontHave)
    return Err[BlockPresenceType]("bitswap: invalid presence type")

fn encodeWantEntry(entry: WantEntry): Result[Bytes] =
    if ! entry.hasCid:
        return Err[Bytes]("bitswap: missing want cid")
    let cidBytesRes: Result[Bytes] = cidToBytes(entry.cid)
    if IsErr(cidBytesRes):
        return Err[Bytes](Error(cidBytesRes))
    var pb: ProtoBuffer = InitProtoBuffer()
    writeBytes(pb, entryBlockField, Value(cidBytesRes))
    writeVarint(pb, entryPriorityField, int64(entry.priority))
    if entry.cancel:
        writeVarint(pb, entryCancelField, 1)
    if entry.wantType != wtBlock:
        writeVarint(pb, entryWantTypeField, int64(entry.wantType))
    if entry.sendDontHave:
        writeVarint(pb, entrySendDontHaveField, 1)
    return Ok[Bytes](protoToBytes(pb))

fn decodeWantEntry(data: Bytes): Result[WantEntry] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var entry: WantEntry = initWantEntry()
    var cidBytes: Bytes = EmptyBytes()
    let cidRes: Result[bool] = getField(pb, entryBlockField, cidBytes)
    if IsErr(cidRes):
        return Err[WantEntry](Error(cidRes))
    if Value(cidRes):
        let cidValRes: Result[Cid] = cidFromBytes(cidBytes)
        if IsErr(cidValRes):
            return Err[WantEntry](Error(cidValRes))
        entry.hasCid = true
        entry.cid = Value(cidValRes)
    var priorityVal: int64 = 1
    let prioRes: Result[bool] = getField(pb, entryPriorityField, priorityVal)
    if IsErr(prioRes):
        return Err[WantEntry](Error(prioRes))
    if Value(prioRes):
        entry.priority = int32(priorityVal)
    var cancelVal: int64
    let cancelRes: Result[bool] = getField(pb, entryCancelField, cancelVal)
    if IsErr(cancelRes):
        return Err[WantEntry](Error(cancelRes))
    if Value(cancelRes):
        entry.cancel = cancelVal != 0
    var typeVal: int64
    let typeRes: Result[bool] = getField(pb, entryWantTypeField, typeVal)
    if IsErr(typeRes):
        return Err[WantEntry](Error(typeRes))
    if Value(typeRes):
        let wtRes: Result[WantType] = wantTypeFromInt(typeVal)
        if IsErr(wtRes):
            return Err[WantEntry](Error(wtRes))
        entry.wantType = Value(wtRes)
    var sendVal: int64
    let sendRes: Result[bool] = getField(pb, entrySendDontHaveField, sendVal)
    if IsErr(sendRes):
        return Err[WantEntry](Error(sendRes))
    if Value(sendRes):
        entry.sendDontHave = sendVal != 0
    if ! entry.hasCid:
        return Err[WantEntry]("bitswap: want entry missing cid")
    return Ok[WantEntry](entry)

fn encodeWantlist(list: Wantlist): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    for i in 0..<list.entryCount:
        let entryRes: Result[Bytes] = encodeWantEntry(list.entries[i])
        if IsErr(entryRes):
            return Err[Bytes](Error(entryRes))
        writeBytes(pb, wantlistEntriesField, Value(entryRes))
    if list.full:
        writeVarint(pb, wantlistFullField, 1)
    return Ok[Bytes](protoToBytes(pb))

fn decodeWantlist(data: Bytes): Result[Wantlist] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var list: Wantlist = initWantlist()
    var entries: RepeatedBytes = initRepeatedBytes()
    let entriesRes: Result[bool] = getRepeatedField(pb, wantlistEntriesField, entries)
    if IsErr(entriesRes):
        return Err[Wantlist](Error(entriesRes))
    if Value(entriesRes):
        for i in 0..<entries.count:
            if list.entryCount >= maxBitswapWantEntries:
                return Err[Wantlist]("bitswap: too many wantlist entries")
            let entryRes: Result[WantEntry] = decodeWantEntry(entries.items[i])
            if IsErr(entryRes):
                return Err[Wantlist](Error(entryRes))
            list.entries[list.entryCount] = Value(entryRes)
            list.entryCount = list.entryCount + 1
    var fullVal: int64
    let fullRes: Result[bool] = getField(pb, wantlistFullField, fullVal)
    if IsErr(fullRes):
        return Err[Wantlist](Error(fullRes))
    if Value(fullRes):
        list.full = fullVal != 0
    return Ok[Wantlist](list)

fn encodeBlockPayload(payload: BlockPayload): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    if BytesLen(payload.prefix) > 0:
        writeBytes(pb, payloadPrefixField, payload.prefix)
    if BytesLen(payload.data) > 0:
        writeBytes(pb, payloadDataField, payload.data)
    return protoToBytes(pb)

fn decodeBlockPayload(data: Bytes): Result[BlockPayload] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var out: BlockPayload = initBlockPayload()
    var prefix: Bytes = EmptyBytes()
    let prefixRes: Result[bool] = getField(pb, payloadPrefixField, prefix)
    if IsErr(prefixRes):
        return Err[BlockPayload](Error(prefixRes))
    if Value(prefixRes):
        out.prefix = prefix
    var body: Bytes = EmptyBytes()
    let bodyRes: Result[bool] = getField(pb, payloadDataField, body)
    if IsErr(bodyRes):
        return Err[BlockPayload](Error(bodyRes))
    if Value(bodyRes):
        out.data = body
    return Ok[BlockPayload](out)

fn encodeBlockPresence(pres: BlockPresence): Result[Bytes] =
    if ! pres.hasCid:
        return Err[Bytes]("bitswap: missing presence cid")
    let cidBytesRes: Result[Bytes] = cidToBytes(pres.cid)
    if IsErr(cidBytesRes):
        return Err[Bytes](Error(cidBytesRes))
    var pb: ProtoBuffer = InitProtoBuffer()
    writeBytes(pb, presenceCidField, Value(cidBytesRes))
    writeVarint(pb, presenceTypeField, int64(pres.presenceType))
    return Ok[Bytes](protoToBytes(pb))

fn decodeBlockPresence(data: Bytes): Result[BlockPresence] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var out: BlockPresence = initBlockPresence()
    var cidBytes: Bytes = EmptyBytes()
    let cidRes: Result[bool] = getField(pb, presenceCidField, cidBytes)
    if IsErr(cidRes):
        return Err[BlockPresence](Error(cidRes))
    if Value(cidRes):
        let cidValRes: Result[Cid] = cidFromBytes(cidBytes)
        if IsErr(cidValRes):
            return Err[BlockPresence](Error(cidValRes))
        out.hasCid = true
        out.cid = Value(cidValRes)
    var typeVal: int64
    let typeRes: Result[bool] = getField(pb, presenceTypeField, typeVal)
    if IsErr(typeRes):
        return Err[BlockPresence](Error(typeRes))
    if Value(typeRes):
        let presRes: Result[BlockPresenceType] = presenceTypeFromInt(typeVal)
        if IsErr(presRes):
            return Err[BlockPresence](Error(presRes))
        out.presenceType = Value(presRes)
    if ! out.hasCid:
        return Err[BlockPresence]("bitswap: missing presence cid")
    return Ok[BlockPresence](out)

fn encodeBitswapMessage(msg: BitswapMessage): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if msg.hasWantlist:
        let wantRes: Result[Bytes] = encodeWantlist(msg.wantlist)
        if IsErr(wantRes):
            return Err[Bytes](Error(wantRes))
        writeBytes(pb, msgWantlistField, Value(wantRes))
    for i in 0..<msg.blockCount:
        writeBytes(pb, msgBlocksField, msg.blocks[i])
    for i in 0..<msg.payloadCount:
        writeBytes(pb, msgPayloadField, encodeBlockPayload(msg.payloads[i]))
    for i in 0..<msg.presenceCount:
        let presRes: Result[Bytes] = encodeBlockPresence(msg.presences[i])
        if IsErr(presRes):
            return Err[Bytes](Error(presRes))
        writeBytes(pb, msgBlockPresenceField, Value(presRes))
    if msg.hasPendingBytes:
        writeVarint(pb, msgPendingBytesField, int64(msg.pendingBytes))
    return Ok[Bytes](protoToBytes(pb))

fn decodeBitswapMessage(data: Bytes): Result[BitswapMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: BitswapMessage = initBitswapMessage()
    var wantBytes: Bytes = EmptyBytes()
    let wantRes: Result[bool] = getField(pb, msgWantlistField, wantBytes)
    if IsErr(wantRes):
        return Err[BitswapMessage](Error(wantRes))
    if Value(wantRes):
        let wantValRes: Result[Wantlist] = decodeWantlist(wantBytes)
        if IsErr(wantValRes):
            return Err[BitswapMessage](Error(wantValRes))
        msg.hasWantlist = true
        msg.wantlist = Value(wantValRes)
    var blocks: RepeatedBytes = initRepeatedBytes()
    let blocksRes: Result[bool] = getRepeatedField(pb, msgBlocksField, blocks)
    if IsErr(blocksRes):
        return Err[BitswapMessage](Error(blocksRes))
    if Value(blocksRes):
        for i in 0..<blocks.count:
            if ! (i < blocks.count && msg.blockCount < maxBitswapBlocks):
                break
            msg.blocks[msg.blockCount] = blocks.items[i]
            msg.blockCount = msg.blockCount + 1
    var payloads: RepeatedBytes = initRepeatedBytes()
    let payloadRes: Result[bool] = getRepeatedField(pb, msgPayloadField, payloads)
    if IsErr(payloadRes):
        return Err[BitswapMessage](Error(payloadRes))
    if Value(payloadRes):
        for j in 0..<payloads.count:
            if msg.payloadCount >= maxBitswapPayloads:
                return Err[BitswapMessage]("bitswap: too many payloads")
            let payloadValRes: Result[BlockPayload] = decodeBlockPayload(payloads.items[j])
            if IsErr(payloadValRes):
                return Err[BitswapMessage](Error(payloadValRes))
            msg.payloads[msg.payloadCount] = Value(payloadValRes)
            msg.payloadCount = msg.payloadCount + 1
    var presences: RepeatedBytes = initRepeatedBytes()
    let presRes: Result[bool] = getRepeatedField(pb, msgBlockPresenceField, presences)
    if IsErr(presRes):
        return Err[BitswapMessage](Error(presRes))
    if Value(presRes):
        for k in 0..<presences.count:
            if msg.presenceCount >= maxBitswapPresences:
                return Err[BitswapMessage]("bitswap: too many presences")
            let presValRes: Result[BlockPresence] = decodeBlockPresence(presences.items[k])
            if IsErr(presValRes):
                return Err[BitswapMessage](Error(presValRes))
            msg.presences[msg.presenceCount] = Value(presValRes)
            msg.presenceCount = msg.presenceCount + 1
    var pendingVal: int64
    let pendingRes: Result[bool] = getField(pb, msgPendingBytesField, pendingVal)
    if IsErr(pendingRes):
        return Err[BitswapMessage](Error(pendingRes))
    if Value(pendingRes):
        msg.hasPendingBytes = true
        msg.pendingBytes = int32(pendingVal)
    return Ok[BitswapMessage](msg)
