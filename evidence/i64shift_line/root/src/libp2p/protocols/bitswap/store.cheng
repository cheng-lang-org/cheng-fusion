# Bitswap block store(minimal, in-memory + optional disk cache + readonly mmap-style view).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/times
import cheng/libp2p/cid
import std/os as bos
import std/strings

@importc("cheng_mkdir1")
fn bitswapStoreMkdir1(path: str): int32

@importc("cheng_dir_exists")
fn bitswapStoreDirExists(path: str): int32

const
    maxBitswapStoreEntries = 128
    bitswapDiskFileSuffix = ".blk"

type
    BitswapStoreEntry =
        used: bool
        key: Bytes
        data: Bytes
        updatedAtNs: int64

    BitswapMmapStats =
        hitCount: int32
        fallbackCount: int32

    BitswapMappedView =
        cidKeyHex: str
        data: Bytes
        mmapActive: bool
        degradedToCopy: bool

    BitswapBlockStore =
        count: int32
        entries: BitswapStoreEntry[maxBitswapStoreEntries]
        diskCacheEnabled: bool
        diskCacheDir: str
        mmapReadonlyPreferred: bool
        mmapHitCount: int32
        mmapFallbackCount: int32

fn initBitswapStore(): BitswapBlockStore =
    BitswapBlockStore(
        count: 0,
        diskCacheEnabled: false,
        diskCacheDir: "",
        mmapReadonlyPreferred: true,
        mmapHitCount: 0,
        mmapFallbackCount: 0
    )

fn cloneBytes(data: Bytes): Bytes =
    if BytesLen(data) <= 0:
        return EmptyBytes()
    return BytesSlice(data, 0, BytesLen(data))

fn cidKeyBytes(cid: Cid): Result[Bytes] =
    return cidToBytes(cid)

fn bitswapHexDigitToInt(ch: int32): int32 =
    if ch >= int32('0') && ch <= int32('9'):
        return ch - int32('0')
    if ch >= int32('a') && ch <= int32('f'):
        return 10 + (ch - int32('a'))
    if ch >= int32('A') && ch <= int32('F'):
        return 10 + (ch - int32('A'))
    return -1

fn bitswapHexToBytes(text: str): Bytes =
    let n: int32 = strings.len(text)
    if n <= 0 || (n % 2) != 0:
        return EmptyBytes()
    let out: Bytes = BytesAlloc(n / 2)
    var i: int32
    while i < n:
        let hi: int32 = bitswapHexDigitToInt(int32(text[i]))
        let lo: int32 = bitswapHexDigitToInt(int32(text[i + 1]))
        if hi < 0 || lo < 0:
            return EmptyBytes()
        BytesSet(out, i / 2, (hi << 4) | lo)
        i = i + 2
    return out

fn findBitswapEntry(store: BitswapBlockStore, key: Bytes): int32 =
    for i in 0..<store.count:
        if store.entries[i].used && BytesEqual(store.entries[i].key, key):
            return i
    return -1

fn findOldestBitswapEntry(store: BitswapBlockStore): int32 =
    if store.count <= 0:
        return -1
    var oldestIdx: int32 = -1
    var oldestTime: int64
    for i in 0..<store.count:
        if store.entries[i].used:
            if oldestIdx < 0 || store.entries[i].updatedAtNs < oldestTime:
                oldestIdx = i
                oldestTime = store.entries[i].updatedAtNs
    return oldestIdx

fn bitswapStoreFileExists(path: str): bool =
    if strings.len(path) <= 0:
        return false
    let f: File = bos.OpenRead(path)
    if f == nil:
        return false
    bos.Close(f)
    return true

fn bitswapStoreReadText(path: str): str =
    if strings.len(path) <= 0:
        return ""
    let f: File = bos.OpenRead(path)
    if f == nil:
        return ""
    let body: str = bos.ReadAll(f)
    bos.Close(f)
    return body

fn bitswapStoreWriteText(path: str, body: str): bool =
    if strings.len(path) <= 0:
        return false
    let f: File = bos.Open(path, bos.FmWrite)
    if f == nil:
        return false
    bos.Write(f, body)
    bos.Close(f)
    return true

fn bitswapStoreEnsureDir(path: str): bool =
    if strings.len(path) <= 0:
        return false
    if bitswapStoreDirExists(path) != 0:
        return true
    if bitswapStoreMkdir1(path) == 0:
        return true
    return bitswapStoreDirExists(path) != 0

fn bitswapStoreJoinPath(base: str, leaf: str): str =
    if strings.len(base) <= 0:
        return leaf
    let lastIdx: int32 = strings.len(base) - 1
    if lastIdx >= 0 && base[lastIdx] == '/':
        return base + leaf
    return base + "/" + leaf

fn bitswapStoreDiskPath(store: var BitswapBlockStore, key: Bytes): str =
    return bitswapStoreJoinPath(store.diskCacheDir, BytesToHex(key) + bitswapDiskFileSuffix)

fn bitswapStorePutDisk(store: var BitswapBlockStore, key: Bytes, data: Bytes): bool =
    if !store.diskCacheEnabled:
        return true
    let path: str = bitswapStoreDiskPath(store, key)
    if strings.len(path) <= 0:
        return false
    let encoded: str = BytesToHex(data)
    return bitswapStoreWriteText(path, encoded)

fn bitswapStoreGetDisk(store: var BitswapBlockStore, key: Bytes): Result[Bytes] =
    if !store.diskCacheEnabled:
        return Err[Bytes]("bitswap store: disk cache disabled")
    let path: str = bitswapStoreDiskPath(store, key)
    if !bitswapStoreFileExists(path):
        return Err[Bytes]("bitswap store: disk miss")
    let raw: str = bitswapStoreReadText(path)
    if strings.len(raw) <= 0:
        return Err[Bytes]("bitswap store: empty disk block")
    let decoded: Bytes = bitswapHexToBytes(raw)
    if BytesLen(decoded) <= 0:
        return Err[Bytes]("bitswap store: disk decode failed")
    return Ok[Bytes](decoded)

fn bitswapStoreEnableDiskCache(store: var BitswapBlockStore, dir: str, preferMmapReadonly: bool): Result[bool] =
    if strings.len(dir) <= 0:
        return Err[bool]("bitswap store: empty disk cache dir")
    if !bitswapStoreEnsureDir(dir):
        return Err[bool]("bitswap store: mkdir failed")
    store.diskCacheEnabled = true
    store.diskCacheDir = dir
    store.mmapReadonlyPreferred = preferMmapReadonly
    return Ok[bool](true)

fn bitswapStoreMmapStats(store: BitswapBlockStore): BitswapMmapStats =
    return BitswapMmapStats(
        hitCount: store.mmapHitCount,
        fallbackCount: store.mmapFallbackCount
    )

fn bitswapStoreHas(store: BitswapBlockStore, cid: Cid): bool =
    let keyRes: Result[Bytes] = cidKeyBytes(cid)
    if IsErr(keyRes):
        return false
    let key: Bytes = Value(keyRes)
    if findBitswapEntry(store, key) >= 0:
        return true
    if store.diskCacheEnabled:
        var storeCopy: BitswapBlockStore = store
        return bitswapStoreFileExists(bitswapStoreDiskPath(storeCopy, key))
    return false

fn bitswapStoreGet(store: BitswapBlockStore, cid: Cid): Result[Bytes] =
    let keyRes: Result[Bytes] = cidKeyBytes(cid)
    if IsErr(keyRes):
        return Err[Bytes](Error(keyRes))
    let key: Bytes = Value(keyRes)
    let idx: int32 = findBitswapEntry(store, key)
    if idx >= 0:
        return Ok[Bytes](cloneBytes(store.entries[idx].data))
    var storeCopy: BitswapBlockStore = store
    let diskRes: Result[Bytes] = bitswapStoreGetDisk(storeCopy, key)
    if IsErr(diskRes):
        return Err[Bytes]("bitswap store: ! found")
    return Ok[Bytes](cloneBytes(Value(diskRes)))

fn bitswapStorePut(store: var BitswapBlockStore, cid: Cid, data: Bytes): Result[bool] =
    let keyRes: Result[Bytes] = cidKeyBytes(cid)
    if IsErr(keyRes):
        return Err[bool](Error(keyRes))
    let key: Bytes = Value(keyRes)
    let nowNs: int64 = EpochTimeNs()
    let idx: int32 = findBitswapEntry(store, key)
    if idx >= 0:
        store.entries[idx] = BitswapStoreEntry(
            used: true,
            key: cloneBytes(key),
            data: cloneBytes(data),
            updatedAtNs: nowNs
        )
        bitswapStorePutDisk(store, key, data)
        return Ok[bool](true)
    if store.count < maxBitswapStoreEntries:
        store.entries[store.count] = BitswapStoreEntry(
            used: true,
            key: cloneBytes(key),
            data: cloneBytes(data),
            updatedAtNs: nowNs
        )
        store.count = store.count + 1
        bitswapStorePutDisk(store, key, data)
        return Ok[bool](true)
    let replaceIdx: int32 = findOldestBitswapEntry(store)
    if replaceIdx < 0:
        return Err[bool]("bitswap store: no slot")
    store.entries[replaceIdx] = BitswapStoreEntry(
        used: true,
        key: cloneBytes(key),
        data: cloneBytes(data),
        updatedAtNs: nowNs
    )
    bitswapStorePutDisk(store, key, data)
    return Ok[bool](true)

fn bitswapStoreMmapReadonlyBlock(store: var BitswapBlockStore, cid: Cid): Result[BitswapMappedView] =
    let keyRes: Result[Bytes] = cidKeyBytes(cid)
    if IsErr(keyRes):
        return Err[BitswapMappedView](Error(keyRes))
    let key: Bytes = Value(keyRes)
    let keyHex: str = BytesToHex(key)

    let idx: int32 = findBitswapEntry(store, key)
    if idx >= 0:
        if store.mmapReadonlyPreferred:
            store.mmapFallbackCount = store.mmapFallbackCount + 1
        return Ok[BitswapMappedView](BitswapMappedView(
            cidKeyHex: keyHex,
            data: cloneBytes(store.entries[idx].data),
            mmapActive: false,
            degradedToCopy: true
        ))

    let diskRes: Result[Bytes] = bitswapStoreGetDisk(store, key)
    if IsErr(diskRes):
        return Err[BitswapMappedView]("bitswap store: mmap view miss")

    if store.mmapReadonlyPreferred:
        store.mmapHitCount = store.mmapHitCount + 1
        return Ok[BitswapMappedView](BitswapMappedView(
            cidKeyHex: keyHex,
            data: cloneBytes(Value(diskRes)),
            mmapActive: true,
            degradedToCopy: false
        ))

    store.mmapFallbackCount = store.mmapFallbackCount + 1
    return Ok[BitswapMappedView](BitswapMappedView(
        cidKeyHex: keyHex,
        data: cloneBytes(Value(diskRes)),
        mmapActive: false,
        degradedToCopy: true
    ))
