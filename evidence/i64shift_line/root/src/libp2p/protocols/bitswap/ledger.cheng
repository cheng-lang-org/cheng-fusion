# Bitswap ledger(minimal).

import cheng/libp2p/utils/result
import std/times
import cheng/libp2p/peerid
const
    maxBitswapLedgerPeers = 64

type
    BitswapLedgerDirection = enum
        bldSent = 0
        bldReceived = 1

    BitswapLedgerDelta =
        bytes: int64
        blocks: int64
        haveCount: int64
        dontHaveCount: int64

    BitswapPeerLedger =
        peerId: PeerId
        bytesSent: int64
        bytesReceived: int64
        blocksSent: int64
        blocksReceived: int64
        haveSent: int64
        haveReceived: int64
        dontHaveSent: int64
        dontHaveReceived: int64
        wantsSent: int64
        wantsReceived: int64
        exchanges: int64
        lastExchangeNs: int64
        used: bool

    BitswapLedger =
        count: int32
        peers: BitswapPeerLedger[maxBitswapLedgerPeers]

fn initBitswapLedger(): BitswapLedger =
    BitswapLedger(count: 0)

fn findLedgerEntry(ledger: BitswapLedger, peer: PeerId): int32 =
    for i in 0..<ledger.count:
        if ledger.peers[i].used:
            let eqRes: Result[bool] = peerIdEqual(ledger.peers[i].peerId, peer)
            if IsOk(eqRes) && Value(eqRes):
                return i
    return -1

fn ensureLedgerEntry(ledger: var BitswapLedger, peer: PeerId): int32 =
    let idx: int32 = findLedgerEntry(ledger, peer)
    if idx >= 0:
        return idx
    if ledger.count >= maxBitswapLedgerPeers:
        return -1
    ledger.peers[ledger.count] = BitswapPeerLedger(
        peerId: peer,
        bytesSent: 0,
        bytesReceived: 0,
        blocksSent: 0,
        blocksReceived: 0,
        haveSent: 0,
        haveReceived: 0,
        dontHaveSent: 0,
        dontHaveReceived: 0,
        wantsSent: 0,
        wantsReceived: 0,
        exchanges: 0,
        lastExchangeNs: 0,
        used: true
    )
    ledger.count = ledger.count + 1
    return ledger.count - 1

fn bitswapLedgerRecordWants(
    ledger: var BitswapLedger,
    peer: PeerId,
    count: int32,
    direction: BitswapLedgerDirection
): bool =
    if count <= 0:
        return true
    let idx: int32 = ensureLedgerEntry(ledger, peer)
    if idx < 0:
        return false
    if direction == bldSent:
        ledger.peers[idx].wantsSent = ledger.peers[idx].wantsSent + count
    else:
        ledger.peers[idx].wantsReceived = ledger.peers[idx].wantsReceived + count
    ledger.peers[idx].lastExchangeNs = EpochTimeNs()
    return true

fn bitswapLedgerRecordDelta(
    ledger: var BitswapLedger,
    peer: PeerId,
    delta: BitswapLedgerDelta,
    direction: BitswapLedgerDirection
): bool =
    let idx: int32 = ensureLedgerEntry(ledger, peer)
    if idx < 0:
        return false
    if direction == bldSent:
        ledger.peers[idx].bytesSent = ledger.peers[idx].bytesSent + delta.bytes
        ledger.peers[idx].blocksSent = ledger.peers[idx].blocksSent + delta.blocks
        ledger.peers[idx].haveSent = ledger.peers[idx].haveSent + delta.haveCount
        ledger.peers[idx].dontHaveSent = ledger.peers[idx].dontHaveSent + delta.dontHaveCount
    else:
        ledger.peers[idx].bytesReceived = ledger.peers[idx].bytesReceived + delta.bytes
        ledger.peers[idx].blocksReceived = ledger.peers[idx].blocksReceived + delta.blocks
        ledger.peers[idx].haveReceived = ledger.peers[idx].haveReceived + delta.haveCount
        ledger.peers[idx].dontHaveReceived = ledger.peers[idx].dontHaveReceived + delta.dontHaveCount
    ledger.peers[idx].exchanges = ledger.peers[idx].exchanges + 1
    ledger.peers[idx].lastExchangeNs = EpochTimeNs()
    return true
