# Bitswap protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
import cheng/libp2p/peerid
import cheng/libp2p/cid
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/bitswap/protobuf as bitswapprotobuf
import cheng/libp2p/protocols/bitswap/store
import cheng/libp2p/protocols/bitswap/ledger
const
    bitswapCodec = "/ipfs/bitswap/1.2.0"
    bitswapDefaultMaxMessage = 4194304

type
    BitswapConfig =
        maxMessageBytes: int32
        sendDontHave: bool
        advertiseHave: bool
        enableLedger: bool

    BitswapContext =
        hasStore: bool
        store: BitswapBlockStore
        hasLedger: bool
        ledger: BitswapLedger
        config: BitswapConfig

var
    bitswapContext: BitswapContext = BitswapContext(
        hasStore: false,
        hasLedger: false,
        config: BitswapConfig(
            maxMessageBytes: bitswapDefaultMaxMessage,
            sendDontHave: true,
            advertiseHave: true,
            enableLedger: true
        )
    )

fn initBitswapConfig(): BitswapConfig =
    BitswapConfig(
        maxMessageBytes: bitswapDefaultMaxMessage,
        sendDontHave: true,
        advertiseHave: true,
        enableLedger: true
    )

fn setBitswapStore(store: BitswapBlockStore) =
    bitswapContext.store = store
    bitswapContext.hasStore = true

fn setBitswapLedger(ledger: BitswapLedger) =
    bitswapContext.ledger = ledger
    bitswapContext.hasLedger = true

fn setBitswapConfig(config: BitswapConfig) =
    bitswapContext.config = config

fn bitswapContextReady(): bool =
    bitswapContext.hasStore

fn bitswapLedgerEnabled(): bool =
    bitswapContext.hasLedger && bitswapContext.config.enableLedger

fn bitswapStreamPeerId(stream: Stream): Result[PeerId] =
    let mux: Muxer = Muxer(kind: stream.kind, id: stream.muxerId)
    let conn: Connection = muxerConnection(mux)
    let peerText: str = RemotePeerId(conn)
    if len(peerText) <= 0:
        return Err[PeerId]("bitswap: missing remote peer id")
    return parsePeerId(peerText)

fn bitswapWantEntryCount(list: Wantlist): int32 =
    var count: int32
    for i in 0..<list.entryCount:
        if ! list.entries[i].cancel:
            count = count + 1
    return count

fn bitswapMessageDelta(msg: BitswapMessage): BitswapLedgerDelta =
    var delta: BitswapLedgerDelta = BitswapLedgerDelta(bytes: 0, blocks: 0, haveCount: 0, dontHaveCount: 0)
    for i in 0..<msg.blockCount:
        delta.bytes = delta.bytes + int64(BytesLen(msg.blocks[i]))
        delta.blocks = delta.blocks + 1
    for i in 0..<msg.payloadCount:
        let payload: BlockPayload = msg.payloads[i]
        delta.bytes = delta.bytes + int64(BytesLen(payload.prefix))
        delta.bytes = delta.bytes + int64(BytesLen(payload.data))
        delta.blocks = delta.blocks + 1
    for i in 0..<msg.presenceCount:
        if msg.presences[i].presenceType == bpHave:
            delta.haveCount = delta.haveCount + 1
        else:
            delta.dontHaveCount = delta.dontHaveCount + 1
    return delta

fn bitswapUpdateLedger(stream: Stream, msg: BitswapMessage, direction: BitswapLedgerDirection) =
    if ! bitswapLedgerEnabled():
        return
    let peerRes: Result[PeerId] = bitswapStreamPeerId(stream)
    if IsErr(peerRes):
        return
    let peer: PeerId = Value(peerRes)
    var ledger: BitswapLedger = bitswapContext.ledger
    if msg.hasWantlist:
        let wantCount: int32 = bitswapWantEntryCount(msg.wantlist)
        if wantCount > 0:
            bitswapLedgerRecordWants(ledger, peer, wantCount, direction)
    let delta: BitswapLedgerDelta = bitswapMessageDelta(msg)
    if delta.bytes > 0 || delta.blocks > 0 || delta.haveCount > 0 || delta.dontHaveCount > 0:
        bitswapLedgerRecordDelta(ledger, peer, delta, direction)
    bitswapContext.ledger = ledger

fn bitswapPutBlock(cid: Cid, data: Bytes): Result[bool] =
    if ! bitswapContext.hasStore:
        return Err[bool]("bitswap: missing store")
    var store: BitswapBlockStore = bitswapContext.store
    let putRes: Result[bool] = bitswapStorePut(store, cid, data)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    bitswapContext.store = store
    return Ok[bool](true)

fn bitswapGetBlock(cid: Cid): Result[Bytes] =
    if ! bitswapContext.hasStore:
        return Err[Bytes]("bitswap: missing store")
    return bitswapStoreGet(bitswapContext.store, cid)

fn bitswapHasBlock(cid: Cid): bool =
    if ! bitswapContext.hasStore:
        return false
    return bitswapStoreHas(bitswapContext.store, cid)

fn cidPrefix(cid: Cid): Result[Bytes] =
    var buf: GrowByteBuffer = newByteBuffer()
    if cid.version == 1:
        appendBytes(buf, encodeUVarint(1))
        appendBytes(buf, encodeUVarint(cid.codec.code))
    appendBytes(buf, encodeUVarint(cid.multihash.code))
    appendBytes(buf, encodeUVarint(int64(cid.multihash.length)))
    return Ok[Bytes](toBytes(buf))

fn bitswapMessageHasData(msg: BitswapMessage): bool =
    if msg.blockCount > 0:
        return true
    if msg.payloadCount > 0:
        return true
    if msg.presenceCount > 0:
        return true
    if msg.hasPendingBytes:
        return true
    return false

fn buildBitswapResponse(wantlist: Wantlist): Result[BitswapMessage] =
    var resp: BitswapMessage = initBitswapMessage()
    for i in 0..<wantlist.entryCount:
        if ! (i < wantlist.entryCount):
            break
        let entry: WantEntry = wantlist.entries[i]
        if entry.cancel:
            continue
        let hasBlock: bool = if entry.hasCid: bitswapHasBlock(entry.cid) else: false
        if entry.wantType == wtHave:
            if hasBlock && bitswapContext.config.advertiseHave:
                if resp.presenceCount < maxBitswapPresences:
                    resp.presences[resp.presenceCount] = BlockPresence(
                        hasCid: entry.hasCid,
                        cid: entry.cid,
                        presenceType: bpHave
                    )
                    resp.presenceCount = resp.presenceCount + 1
            elif (! hasBlock) && entry.sendDontHave && bitswapContext.config.sendDontHave:
                if resp.presenceCount < maxBitswapPresences:
                    resp.presences[resp.presenceCount] = BlockPresence(
                        hasCid: entry.hasCid,
                        cid: entry.cid,
                        presenceType: bpDontHave
                    )
                    resp.presenceCount = resp.presenceCount + 1
        else:
            if hasBlock:
                let dataRes: Result[Bytes] = bitswapGetBlock(entry.cid)
                if IsOk(dataRes):
                    if resp.blockCount < maxBitswapBlocks:
                        resp.blocks[resp.blockCount] = Value(dataRes)
                        resp.blockCount = resp.blockCount + 1
                    let prefixRes: Result[Bytes] = cidPrefix(entry.cid)
                    if IsOk(prefixRes) && resp.payloadCount < maxBitswapPayloads:
                        resp.payloads[resp.payloadCount] = BlockPayload(
                            prefix: Value(prefixRes),
                            data: Value(dataRes)
                        )
                        resp.payloadCount = resp.payloadCount + 1
                    if resp.presenceCount < maxBitswapPresences:
                        resp.presences[resp.presenceCount] = BlockPresence(
                            hasCid: entry.hasCid,
                            cid: entry.cid,
                            presenceType: bpHave
                        )
                        resp.presenceCount = resp.presenceCount + 1
            elif entry.sendDontHave && bitswapContext.config.sendDontHave:
                if resp.presenceCount < maxBitswapPresences:
                    resp.presences[resp.presenceCount] = BlockPresence(
                        hasCid: entry.hasCid,
                        cid: entry.cid,
                        presenceType: bpDontHave
                    )
                    resp.presenceCount = resp.presenceCount + 1
    return Ok[BitswapMessage](resp)

fn readBitswapMessage(stream: var Stream): Result[BitswapMessage] =
    let dataRes: Result[Bytes] = readLp(stream, bitswapContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[BitswapMessage](Error(dataRes))
    let msgRes: Result[BitswapMessage] = decodeBitswapMessage(Value(dataRes))
    if IsErr(msgRes):
        return Err[BitswapMessage](Error(msgRes))
    let msg: BitswapMessage = Value(msgRes)
    bitswapUpdateLedger(stream, msg, bldReceived)
    return Ok[BitswapMessage](msg)

fn writeBitswapMessage(stream: var Stream, msg: BitswapMessage): Result[bool] =
    let encRes: Result[Bytes] = encodeBitswapMessage(msg)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    bitswapUpdateLedger(stream, msg, bldSent)
    return Ok[bool](true)

fn bitswapLedgerEntry(peer: PeerId): Result[BitswapPeerLedger] =
    if ! bitswapContext.hasLedger:
        return Err[BitswapPeerLedger]("bitswap: missing ledger")
    let idx: int32 = findLedgerEntry(bitswapContext.ledger, peer)
    if idx < 0:
        return Err[BitswapPeerLedger]("bitswap: ledger entry missing")
    return Ok[BitswapPeerLedger](bitswapContext.ledger.peers[idx])

fn bitswapHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    if ! bitswapContextReady():
        return Err[bool]("bitswap: missing store")
    let msgRes: Result[BitswapMessage] = readBitswapMessage(streamVar)
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    let msg: BitswapMessage = Value(msgRes)
    var reply: BitswapMessage = initBitswapMessage()
    if msg.hasWantlist:
        let respRes: Result[BitswapMessage] = buildBitswapResponse(msg.wantlist)
        if IsErr(respRes):
            return Err[bool](Error(respRes))
        reply = Value(respRes)
    let writeRes: Result[bool] = writeBitswapMessage(streamVar, reply)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn bitswapProtocol(): Lp2pProtocol =
    return newProtocol(bitswapCodec, bitswapHandler)
