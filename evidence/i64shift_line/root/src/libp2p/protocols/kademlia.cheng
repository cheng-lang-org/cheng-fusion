# Kademlia protocol(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/bytes
import cheng/libp2p/stream/lpstream
import cheng/libp2p/peerstore
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/kademlia/consts
import cheng/libp2p/protocols/kademlia/protobuf as kadpb
import cheng/libp2p/protocols/kademlia/requests
import cheng/libp2p/protocols/kademlia/kademlia
import cheng/libp2p/record
const
    kadMaxMessage = 1048576

type
    KadMode = enum
        kmServer = 0
        kmClient = 1

    KadContext =
        state: Option[KadState]
        peerStore: Option[PeerStore]
        mode: KadMode

var
    kadContext: KadContext

fn setKademliaState(state: KadState) =
    kadContext.state = Some[KadState](state)

fn setKademliaPeerStore(store: var PeerStore) =
    kadContext.peerStore.has = true
    kadContext.peerStore.value = store

fn setKademliaContext(state: KadState, store: var PeerStore) =
    setKademliaState(state)
    setKademliaPeerStore(store)

fn setKadMode(mode: KadMode) =
    kadContext.mode = mode

fn kadMode(): KadMode =
    return kadContext.mode

fn kademliaWriteEnabled(): bool =
    return kadContext.mode == kmServer

fn kademliaContextReady(): bool =
    return kadContext.state.has && kadContext.peerStore.has

fn kademliaState(): Option[KadState] =
    return kadContext.state

fn kademliaPeerStore(): Option[PeerStore] =
    return kadContext.peerStore

fn kademliaTryGetState(outState: var KadState): bool =
    if ! kadContext.state.has:
        return false
    outState = kadContext.state.value
    return true

fn kademliaTryGetPeerStore(outStore: var PeerStore): bool =
    if ! kadContext.peerStore.has:
        return false
    outStore = kadContext.peerStore.value
    return true

fn storeKadPeer(store: var PeerStore, peer: KadPeer): bool =
    let pidRes: Result[PeerId] = peerIdFromBytes(peer.id)
    if IsErr(pidRes):
        return false
    var info: PeerInfo = newPeerInfo(Value(pidRes))
    if ! multiAddressListIsEmpty(peer.addrs):
        let addRes: Result[bool] = addAddresses(info, peer.addrs)
        if IsErr(addRes):
            return false
    let mergeRes: Result[bool] = mergePeer(store, info)
    if IsErr(mergeRes):
        return false
    return true

fn fillCloserPeers(msg: var KadMessage, keys: KeyList, store: PeerStore) =
    for i in 0..<keys.count:
        if ! (i < keys.count && msg.closerCount < maxKadPeers):
            break
        let pidRes: Result[PeerId] = keyToPeerId(keys.items[i])
        if IsOk(pidRes):
            let peerRes: Result[KadPeer] = peerToKadPeer(Value(pidRes), store)
            if IsOk(peerRes):
                msg.closerPeers[msg.closerCount] = Value(peerRes)
                msg.closerCount = msg.closerCount + 1
fn handleFindNode(msg: KadMessage, stream: var Stream): Result[bool] =
    if ! msg.hasKey:
        return Err[bool]("kad: find node missing key")
    if ! kademliaContextReady():
        return Err[bool]("kad: missing context")
    let state: KadState = kadContext.state.value
    let store: PeerStore = kadContext.peerStore.value
    let keys: KeyList = findClosestKeys(state.routing, msg.key, defaultReplic)
    let replyRes: Result[Bytes] = encodeFindNodeReplyKeys(keys, store)
    if IsErr(replyRes):
        return Err[bool](Error(replyRes))
    let writeRes: Result[int32] = writeLp(stream, Value(replyRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn handleGetValue(msg: KadMessage, stream: var Stream): Result[bool] =
    if ! msg.hasKey:
        return Err[bool]("kad: get value missing key")
    if ! kademliaContextReady():
        return Err[bool]("kad: missing context")
    let state: KadState = kadContext.state.value
    let store: PeerStore = kadContext.peerStore.value
    var reply: KadMessage = initKadMessage()
    reply.msgType = kadGetValue
    reply.hasKey = true
    reply.key = msg.key
    let recOpt: Option[KadRecord] = getKadValue(state.store, msg.key)
    if recOpt.has:
        reply.hasRecord = true
        reply.record = recOpt.value
    else:
        let keys: KeyList = findClosestKeys(state.routing, msg.key, defaultReplic)
        fillCloserPeers(reply, keys, store)
    let replyBytes: Bytes = encodeKadMessage(reply)
    let writeRes: Result[int32] = writeLp(stream, replyBytes)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn handlePutValue(msg: KadMessage, stream: var Stream): Result[bool] =
    if ! kademliaWriteEnabled():
        return Err[bool]("kad: client mode forbids put value")
    if ! msg.hasRecord:
        return Err[bool]("kad: put value missing record")
    if ! kademliaContextReady():
        return Err[bool]("kad: missing context")
    var state: KadState = kadContext.state.value
    var rec: KadRecord = msg.record
    if msg.hasKey:
        rec.hasKey = true
        rec.key = msg.key
    if ! rec.hasKey:
        return Err[bool]("kad: put value missing key")
    if ! rec.hasValue:
        return Err[bool]("kad: put value missing value")
    var generic: Record = Record(
        key: BytesToString(rec.key),
        value: rec.value,
        signature: EmptyBytes(),
        timeReceived: if rec.hasTime: rec.timeReceived else: ""
    )
    if ! recordStoreValidate(state.records, generic):
        return Err[bool]("kad: put value validation failed")
    putKadValue(state.store, rec.key, rec)
    kadContext.state = Some[KadState](state)
    var reply: KadMessage = initKadMessage()
    reply.msgType = kadPutValue
    let replyBytes: Bytes = encodeKadMessage(reply)
    let writeRes: Result[int32] = writeLp(stream, replyBytes)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn handleAddProvider(msg: KadMessage, stream: var Stream): Result[bool] =
    if ! kademliaWriteEnabled():
        return Err[bool]("kad: client mode forbids add provider")
    if ! msg.hasKey:
        return Err[bool]("kad: add provider missing key")
    if ! kademliaContextReady():
        return Err[bool]("kad: missing context")
    var state: KadState = kadContext.state.value
    var store: PeerStore = kadContext.peerStore.value
    for i in 0..<msg.providerCount:
        let peer: KadPeer = msg.providerPeers[i]
        addKadProvider(state.store, msg.key, peer)
        storeKadPeer(store, peer)
    kadContext.state = Some[KadState](state)
    kadContext.peerStore = Some[PeerStore](store)
    var reply: KadMessage = initKadMessage()
    reply.msgType = kadAddProvider
    let replyBytes: Bytes = encodeKadMessage(reply)
    let writeRes: Result[int32] = writeLp(stream, replyBytes)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn handleGetProviders(msg: KadMessage, stream: var Stream): Result[bool] =
    if ! msg.hasKey:
        return Err[bool]("kad: get providers missing key")
    if ! kademliaContextReady():
        return Err[bool]("kad: missing context")
    let state: KadState = kadContext.state.value
    let store: PeerStore = kadContext.peerStore.value
    var reply: KadMessage = initKadMessage()
    reply.msgType = kadGetProviders
    reply.hasKey = true
    reply.key = msg.key
    let provOpt: Option[KadProviderEntry] = getKadProviders(state.store, msg.key)
    if provOpt.has:
        let entry: KadProviderEntry = provOpt.value
        for i in 0..<entry.count:
            if ! (i < entry.count && reply.providerCount < maxKadPeers):
                break
            reply.providerPeers[reply.providerCount] = entry.peers[i]
            reply.providerCount = reply.providerCount + 1
    let keys: KeyList = findClosestKeys(state.routing, msg.key, defaultReplic)
    fillCloserPeers(reply, keys, store)
    let replyBytes: Bytes = encodeKadMessage(reply)
    let writeRes: Result[int32] = writeLp(stream, replyBytes)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn kademliaHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let dataRes: Result[Bytes] = readLp(streamVar, kadMaxMessage)
    if IsErr(dataRes):
        return Err[bool](Error(dataRes))
    let msgRes: Result[KadMessage] = decodeKadMessage(Value(dataRes))
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    let msg: KadMessage = Value(msgRes)
    if msg.msgType == kadFindNode:
        return handleFindNode(msg, streamVar)
    if msg.msgType == kadGetValue:
        return handleGetValue(msg, streamVar)
    if msg.msgType == kadPutValue:
        if ! kademliaWriteEnabled():
            return Err[bool]("kad: client mode forbids put value")
        return handlePutValue(msg, streamVar)
    if msg.msgType == kadAddProvider:
        if ! kademliaWriteEnabled():
            return Err[bool]("kad: client mode forbids add provider")
        return handleAddProvider(msg, streamVar)
    if msg.msgType == kadGetProviders:
        return handleGetProviders(msg, streamVar)
    return Ok[bool](true)

fn kademliaProtocol(proto: var Lp2pProtocol) =
    newProtocolInto(proto, kadCodec, kademliaHandler)
