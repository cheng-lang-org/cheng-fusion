# Graphsync selector helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
type
    GraphsyncTraversalMode = enum
        gstTraverseAll = 0
        gstTraverseNone = 1

    GraphsyncTraversal =
        mode: GraphsyncTraversalMode
        depthLimit: int32

fn initTraverseAll(depthLimit: int32): GraphsyncTraversal =
    GraphsyncTraversal(mode: gstTraverseAll, depthLimit: depthLimit)

fn initTraverseNone(): GraphsyncTraversal =
    GraphsyncTraversal(mode: gstTraverseNone, depthLimit: 0)

fn selectorFromBytes(data: Bytes): Result[Bytes] =
    if BytesLen(data) < 0:
        return Err[Bytes]("graphsync: selector invalid")
    return Ok[Bytes](data)

fn selectorIsEmpty(data: Bytes): bool =
    return BytesLen(data) <= 0

fn selectorAll(): Bytes =
    return EmptyBytes()
