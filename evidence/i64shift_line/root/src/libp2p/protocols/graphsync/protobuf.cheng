# Graphsync protobuf messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
const
    maxGraphsyncRequests = 16
    maxGraphsyncResponses = 16
    maxGraphsyncBlocks = 32
    maxGraphsyncExtensions = 16
    maxGraphsyncMetadata = 32

    msgCompleteListField = 1
    msgRequestsField = 2
    msgResponsesField = 3
    msgBlocksField = 4

    requestIdField = 1
    requestRootField = 2
    requestSelectorField = 3
    requestExtensionsField = 4
    requestPriorityField = 5
    requestCancelField = 6
    requestUpdateField = 7

    responseIdField = 1
    responseStatusField = 2
    responseExtensionsField = 3
    responseMetadataField = 4

    blockPrefixField = 1
    blockDataField = 2

    entryKeyField = 1
    entryValueField = 2

    metadataLinkField = 1
    metadataActionField = 2

type
    GraphsyncLinkAction = enum
        gslaPresent = 0
        gslaDuplicateNotSent = 1
        gslaMissing = 2
        gslaDuplicateDagSkipped = 3

    GraphsyncExtensionEntry =
        key: str
        value: Bytes

    GraphsyncMetadataEntry =
        link: Bytes
        action: GraphsyncLinkAction

    GraphsyncRequest =
        hasId: bool
        id: int32
        hasRoot: bool
        root: Bytes
        hasSelector: bool
        selector: Bytes
        extensionCount: int32
        extensions: GraphsyncExtensionEntry[maxGraphsyncExtensions]
        priority: int32
        cancel: bool
        update: bool

    GraphsyncResponse =
        hasId: bool
        id: int32
        status: int32
        extensionCount: int32
        extensions: GraphsyncExtensionEntry[maxGraphsyncExtensions]
        metadataCount: int32
        metadata: GraphsyncMetadataEntry[maxGraphsyncMetadata]

    GraphsyncBlock =
        prefix: Bytes
        data: Bytes

    GraphsyncMessage =
        completeRequestList: bool
        requestCount: int32
        requests: GraphsyncRequest[maxGraphsyncRequests]
        responseCount: int32
        responses: GraphsyncResponse[maxGraphsyncResponses]
        blockCount: int32
        blocks: GraphsyncBlock[maxGraphsyncBlocks]

fn initGraphsyncRequest(): GraphsyncRequest =
    GraphsyncRequest(
        hasId: false,
        hasRoot: false,
        hasSelector: false,
        extensionCount: 0,
        priority: 0,
        cancel: false,
        update: false
    )

fn initGraphsyncResponse(): GraphsyncResponse =
    GraphsyncResponse(
        hasId: false,
        status: 0,
        extensionCount: 0,
        metadataCount: 0
    )

fn initGraphsyncBlock(): GraphsyncBlock =
    GraphsyncBlock(prefix: EmptyBytes(), data: EmptyBytes())

fn initGraphsyncMessage(): GraphsyncMessage =
    GraphsyncMessage(
        completeRequestList: false,
        requestCount: 0,
        responseCount: 0,
        blockCount: 0
    )

fn linkActionFromInt(value: int64): Result[GraphsyncLinkAction] =
    if value == 0:
        return Ok[GraphsyncLinkAction](gslaPresent)
    if value == 1:
        return Ok[GraphsyncLinkAction](gslaDuplicateNotSent)
    if value == 2:
        return Ok[GraphsyncLinkAction](gslaMissing)
    if value == 3:
        return Ok[GraphsyncLinkAction](gslaDuplicateDagSkipped)
    return Err[GraphsyncLinkAction]("graphsync: invalid link action")

fn encodeExtensionEntry(entry: GraphsyncExtensionEntry): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, entryKeyField, entry.key)
    writeBytes(pb, entryValueField, entry.value)
    return protoToBytes(pb)

fn decodeExtensionEntry(data: Bytes): Result[GraphsyncExtensionEntry] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var key: str
    let keyRes: Result[bool] = getField(pb, entryKeyField, key)
    if IsErr(keyRes):
        return Err[GraphsyncExtensionEntry](Error(keyRes))
    if ! Value(keyRes) || len(key) <= 0:
        return Err[GraphsyncExtensionEntry]("graphsync: missing extension key")
    var val: Bytes = EmptyBytes()
    let valRes: Result[bool] = getField(pb, entryValueField, val)
    if IsErr(valRes):
        return Err[GraphsyncExtensionEntry](Error(valRes))
    return Ok[GraphsyncExtensionEntry](GraphsyncExtensionEntry(key: key, value: val))

fn encodeMetadataEntry(entry: GraphsyncMetadataEntry): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeBytes(pb, metadataLinkField, entry.link)
    writeVarint(pb, metadataActionField, int64(entry.action))
    return Ok[Bytes](protoToBytes(pb))

fn decodeMetadataEntry(data: Bytes): Result[GraphsyncMetadataEntry] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var link: Bytes = EmptyBytes()
    let linkRes: Result[bool] = getField(pb, metadataLinkField, link)
    if IsErr(linkRes):
        return Err[GraphsyncMetadataEntry](Error(linkRes))
    if ! Value(linkRes) || BytesLen(link) <= 0:
        return Err[GraphsyncMetadataEntry]("graphsync: missing metadata link")
    var actionVal: int64
    let actionRes: Result[bool] = getField(pb, metadataActionField, actionVal)
    if IsErr(actionRes):
        return Err[GraphsyncMetadataEntry](Error(actionRes))
    var action: GraphsyncLinkAction = gslaPresent
    if Value(actionRes):
        let actRes: Result[GraphsyncLinkAction] = linkActionFromInt(actionVal)
        if IsErr(actRes):
            return Err[GraphsyncMetadataEntry](Error(actRes))
        action = Value(actRes)
    return Ok[GraphsyncMetadataEntry](GraphsyncMetadataEntry(link: link, action: action))

fn encodeGraphsyncRequest(req: GraphsyncRequest): Result[Bytes] =
    if ! req.hasId:
        return Err[Bytes]("graphsync: request missing id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, requestIdField, int64(req.id))
    if req.hasRoot:
        writeBytes(pb, requestRootField, req.root)
    if req.hasSelector:
        writeBytes(pb, requestSelectorField, req.selector)
    for i in 0..<req.extensionCount:
        writeBytes(pb, requestExtensionsField, encodeExtensionEntry(req.extensions[i]))
    if req.priority != 0:
        writeVarint(pb, requestPriorityField, int64(req.priority))
    if req.cancel:
        writeVarint(pb, requestCancelField, 1)
    if req.update:
        writeVarint(pb, requestUpdateField, 1)
    return Ok[Bytes](protoToBytes(pb))

fn decodeGraphsyncRequest(data: Bytes): Result[GraphsyncRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: GraphsyncRequest = initGraphsyncRequest()
    var idVal: int64
    let idRes: Result[bool] = getField(pb, requestIdField, idVal)
    if IsErr(idRes):
        return Err[GraphsyncRequest](Error(idRes))
    if Value(idRes):
        req.hasId = true
        req.id = int32(idVal)
    var root: Bytes = EmptyBytes()
    let rootRes: Result[bool] = getField(pb, requestRootField, root)
    if IsErr(rootRes):
        return Err[GraphsyncRequest](Error(rootRes))
    if Value(rootRes):
        req.hasRoot = true
        req.root = root
    var selector: Bytes = EmptyBytes()
    let selRes: Result[bool] = getField(pb, requestSelectorField, selector)
    if IsErr(selRes):
        return Err[GraphsyncRequest](Error(selRes))
    if Value(selRes):
        req.hasSelector = true
        req.selector = selector
    var extBytes: RepeatedBytes = initRepeatedBytes()
    let extRes: Result[bool] = getRepeatedField(pb, requestExtensionsField, extBytes)
    if IsErr(extRes):
        return Err[GraphsyncRequest](Error(extRes))
    if Value(extRes):
        for i in 0..<extBytes.count:
            if req.extensionCount >= maxGraphsyncExtensions:
                return Err[GraphsyncRequest]("graphsync: too many extensions")
            let entryRes: Result[GraphsyncExtensionEntry] = decodeExtensionEntry(extBytes.items[i])
            if IsErr(entryRes):
                return Err[GraphsyncRequest](Error(entryRes))
            req.extensions[req.extensionCount] = Value(entryRes)
            req.extensionCount = req.extensionCount + 1
    var priorityVal: int64
    let prioRes: Result[bool] = getField(pb, requestPriorityField, priorityVal)
    if IsErr(prioRes):
        return Err[GraphsyncRequest](Error(prioRes))
    if Value(prioRes):
        req.priority = int32(priorityVal)
    var cancelVal: int64
    let cancelRes: Result[bool] = getField(pb, requestCancelField, cancelVal)
    if IsErr(cancelRes):
        return Err[GraphsyncRequest](Error(cancelRes))
    if Value(cancelRes):
        req.cancel = cancelVal != 0
    var updateVal: int64
    let updateRes: Result[bool] = getField(pb, requestUpdateField, updateVal)
    if IsErr(updateRes):
        return Err[GraphsyncRequest](Error(updateRes))
    if Value(updateRes):
        req.update = updateVal != 0
    if ! req.hasId:
        return Err[GraphsyncRequest]("graphsync: request missing id")
    return Ok[GraphsyncRequest](req)

fn encodeGraphsyncResponse(resp: GraphsyncResponse): Result[Bytes] =
    if ! resp.hasId:
        return Err[Bytes]("graphsync: response missing id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, responseIdField, int64(resp.id))
    writeVarint(pb, responseStatusField, int64(resp.status))
    for i in 0..<resp.extensionCount:
        writeBytes(pb, responseExtensionsField, encodeExtensionEntry(resp.extensions[i]))
    for i in 0..<resp.metadataCount:
        let metaRes: Result[Bytes] = encodeMetadataEntry(resp.metadata[i])
        if IsErr(metaRes):
            return Err[Bytes](Error(metaRes))
        writeBytes(pb, responseMetadataField, Value(metaRes))
    return Ok[Bytes](protoToBytes(pb))

fn decodeGraphsyncResponse(data: Bytes): Result[GraphsyncResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: GraphsyncResponse = initGraphsyncResponse()
    var idVal: int64
    let idRes: Result[bool] = getField(pb, responseIdField, idVal)
    if IsErr(idRes):
        return Err[GraphsyncResponse](Error(idRes))
    if Value(idRes):
        resp.hasId = true
        resp.id = int32(idVal)
    var statusVal: int64
    let statusRes: Result[bool] = getField(pb, responseStatusField, statusVal)
    if IsErr(statusRes):
        return Err[GraphsyncResponse](Error(statusRes))
    if Value(statusRes):
        resp.status = int32(statusVal)
    var extBytes: RepeatedBytes = initRepeatedBytes()
    let extRes: Result[bool] = getRepeatedField(pb, responseExtensionsField, extBytes)
    if IsErr(extRes):
        return Err[GraphsyncResponse](Error(extRes))
    if Value(extRes):
        for i in 0..<extBytes.count:
            if resp.extensionCount >= maxGraphsyncExtensions:
                return Err[GraphsyncResponse]("graphsync: too many extensions")
            let entryRes: Result[GraphsyncExtensionEntry] = decodeExtensionEntry(extBytes.items[i])
            if IsErr(entryRes):
                return Err[GraphsyncResponse](Error(entryRes))
            resp.extensions[resp.extensionCount] = Value(entryRes)
            resp.extensionCount = resp.extensionCount + 1
    var metaBytes: RepeatedBytes = initRepeatedBytes()
    let metaRes: Result[bool] = getRepeatedField(pb, responseMetadataField, metaBytes)
    if IsErr(metaRes):
        return Err[GraphsyncResponse](Error(metaRes))
    if Value(metaRes):
        for j in 0..<metaBytes.count:
            if resp.metadataCount >= maxGraphsyncMetadata:
                return Err[GraphsyncResponse]("graphsync: too many metadata entries")
            let entryRes: Result[GraphsyncMetadataEntry] = decodeMetadataEntry(metaBytes.items[j])
            if IsErr(entryRes):
                return Err[GraphsyncResponse](Error(entryRes))
            resp.metadata[resp.metadataCount] = Value(entryRes)
            resp.metadataCount = resp.metadataCount + 1
    if ! resp.hasId:
        return Err[GraphsyncResponse]("graphsync: response missing id")
    return Ok[GraphsyncResponse](resp)

fn encodeGraphsyncBlock(block: GraphsyncBlock): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    if BytesLen(block.prefix) > 0:
        writeBytes(pb, blockPrefixField, block.prefix)
    if BytesLen(block.data) > 0:
        writeBytes(pb, blockDataField, block.data)
    return protoToBytes(pb)

fn decodeGraphsyncBlock(data: Bytes): Result[GraphsyncBlock] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var blk: GraphsyncBlock = initGraphsyncBlock()
    var prefix: Bytes = EmptyBytes()
    let prefixRes: Result[bool] = getField(pb, blockPrefixField, prefix)
    if IsErr(prefixRes):
        return Err[GraphsyncBlock](Error(prefixRes))
    if Value(prefixRes):
        blk.prefix = prefix
    var body: Bytes = EmptyBytes()
    let bodyRes: Result[bool] = getField(pb, blockDataField, body)
    if IsErr(bodyRes):
        return Err[GraphsyncBlock](Error(bodyRes))
    if Value(bodyRes):
        blk.data = body
    return Ok[GraphsyncBlock](blk)

fn encodeGraphsyncMessage(msg: GraphsyncMessage): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if msg.completeRequestList:
        writeVarint(pb, msgCompleteListField, 1)
    for i in 0..<msg.requestCount:
        let reqRes: Result[Bytes] = encodeGraphsyncRequest(msg.requests[i])
        if IsErr(reqRes):
            return Err[Bytes](Error(reqRes))
        writeBytes(pb, msgRequestsField, Value(reqRes))
    for i in 0..<msg.responseCount:
        let respRes: Result[Bytes] = encodeGraphsyncResponse(msg.responses[i])
        if IsErr(respRes):
            return Err[Bytes](Error(respRes))
        writeBytes(pb, msgResponsesField, Value(respRes))
    for i in 0..<msg.blockCount:
        writeBytes(pb, msgBlocksField, encodeGraphsyncBlock(msg.blocks[i]))
    return Ok[Bytes](protoToBytes(pb))

fn decodeGraphsyncMessage(data: Bytes): Result[GraphsyncMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: GraphsyncMessage = initGraphsyncMessage()
    var completeVal: int64
    let completeRes: Result[bool] = getField(pb, msgCompleteListField, completeVal)
    if IsErr(completeRes):
        return Err[GraphsyncMessage](Error(completeRes))
    if Value(completeRes):
        msg.completeRequestList = completeVal != 0
    var reqBytes: RepeatedBytes = initRepeatedBytes()
    let reqRes: Result[bool] = getRepeatedField(pb, msgRequestsField, reqBytes)
    if IsErr(reqRes):
        return Err[GraphsyncMessage](Error(reqRes))
    if Value(reqRes):
        for i in 0..<reqBytes.count:
            if msg.requestCount >= maxGraphsyncRequests:
                return Err[GraphsyncMessage]("graphsync: too many requests")
            let reqValRes: Result[GraphsyncRequest] = decodeGraphsyncRequest(reqBytes.items[i])
            if IsErr(reqValRes):
                return Err[GraphsyncMessage](Error(reqValRes))
            msg.requests[msg.requestCount] = Value(reqValRes)
            msg.requestCount = msg.requestCount + 1
    var respBytes: RepeatedBytes = initRepeatedBytes()
    let respRes: Result[bool] = getRepeatedField(pb, msgResponsesField, respBytes)
    if IsErr(respRes):
        return Err[GraphsyncMessage](Error(respRes))
    if Value(respRes):
        for j in 0..<respBytes.count:
            if msg.responseCount >= maxGraphsyncResponses:
                return Err[GraphsyncMessage]("graphsync: too many responses")
            let respValRes: Result[GraphsyncResponse] = decodeGraphsyncResponse(respBytes.items[j])
            if IsErr(respValRes):
                return Err[GraphsyncMessage](Error(respValRes))
            msg.responses[msg.responseCount] = Value(respValRes)
            msg.responseCount = msg.responseCount + 1
    var blockBytes: RepeatedBytes = initRepeatedBytes()
    let blockRes: Result[bool] = getRepeatedField(pb, msgBlocksField, blockBytes)
    if IsErr(blockRes):
        return Err[GraphsyncMessage](Error(blockRes))
    if Value(blockRes):
        for k in 0..<blockBytes.count:
            if msg.blockCount >= maxGraphsyncBlocks:
                return Err[GraphsyncMessage]("graphsync: too many blocks")
            let blockValRes: Result[GraphsyncBlock] = decodeGraphsyncBlock(blockBytes.items[k])
            if IsErr(blockValRes):
                return Err[GraphsyncMessage](Error(blockValRes))
            msg.blocks[msg.blockCount] = Value(blockValRes)
            msg.blockCount = msg.blockCount + 1
    return Ok[GraphsyncMessage](msg)
