# Graphsync protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
import cheng/libp2p/cid
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/bitswap/store
import cheng/libp2p/protocols/graphsync/protobuf as graphsyncprotobuf
import cheng/libp2p/protocols/graphsync/selector
const
    graphsyncCodec = "/ipfs/graphsync/1.0.0"
    graphsyncDefaultMaxMessage = 4194304

type
    GraphsyncResponseCode = enum
        gsrsRequestAcknowledged = 10
        gsrsAdditionalPeers = 11
        gsrsNotEnoughGas = 12
        gsrsOtherProtocol = 13
        gsrsPartialResponse = 14
        gsrsRequestPaused = 15
        gsrsRequestCompletedFull = 20
        gsrsRequestCompletedPartial = 21
        gsrsRequestRejected = 30
        gsrsRequestFailedBusy = 31
        gsrsRequestFailedUnknown = 32
        gsrsRequestFailedLegal = 33
        gsrsRequestFailedContentNotFound = 34
        gsrsRequestCancelled = 35

    GraphsyncConfig =
        maxMessageBytes: int32

    GraphsyncContext =
        hasStore: bool
        store: BitswapBlockStore
        config: GraphsyncConfig

    GraphsyncResponseBundle =
        resp: GraphsyncResponse
        blocks: GraphsyncBlock
        hasBlock: bool

var
    graphsyncContext: GraphsyncContext = GraphsyncContext(
        hasStore: false,
        config: GraphsyncConfig(maxMessageBytes: graphsyncDefaultMaxMessage)
    )

fn initGraphsyncConfig(): GraphsyncConfig =
    GraphsyncConfig(maxMessageBytes: graphsyncDefaultMaxMessage)

fn setGraphsyncStore(store: BitswapBlockStore) =
    graphsyncContext.store = store
    graphsyncContext.hasStore = true

fn setGraphsyncConfig(config: GraphsyncConfig) =
    graphsyncContext.config = config

fn graphsyncContextReady(): bool =
    graphsyncContext.hasStore

fn graphsyncPutBlock(cid: Cid, data: Bytes): Result[bool] =
    if ! graphsyncContext.hasStore:
        return Err[bool]("graphsync: missing store")
    var store: BitswapBlockStore = graphsyncContext.store
    let putRes: Result[bool] = bitswapStorePut(store, cid, data)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    graphsyncContext.store = store
    return Ok[bool](true)

fn graphsyncGetBlock(cid: Cid): Result[Bytes] =
    if ! graphsyncContext.hasStore:
        return Err[Bytes]("graphsync: missing store")
    return bitswapStoreGet(graphsyncContext.store, cid)

fn graphsyncHasBlock(cid: Cid): bool =
    if ! graphsyncContext.hasStore:
        return false
    return bitswapStoreHas(graphsyncContext.store, cid)

fn graphsyncCidPrefix(cid: Cid): Result[Bytes] =
    var buf: GrowByteBuffer = newByteBuffer()
    if cid.version == 1:
        appendBytes(buf, encodeUVarint(1))
        appendBytes(buf, encodeUVarint(cid.codec.code))
    appendBytes(buf, encodeUVarint(cid.multihash.code))
    appendBytes(buf, encodeUVarint(int64(cid.multihash.length)))
    return Ok[Bytes](toBytes(buf))

fn readGraphsyncMessage(stream: var Stream): Result[GraphsyncMessage] =
    let dataRes: Result[Bytes] = readLp(stream, graphsyncContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[GraphsyncMessage](Error(dataRes))
    return decodeGraphsyncMessage(Value(dataRes))

fn writeGraphsyncMessage(stream: var Stream, msg: GraphsyncMessage): Result[bool] =
    let encRes: Result[Bytes] = encodeGraphsyncMessage(msg)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn buildGraphsyncResponse(req: GraphsyncRequest): Result[GraphsyncResponseBundle] =
    var response: GraphsyncResponse = initGraphsyncResponse()
    response.hasId = true
    response.id = req.id
    var blk: GraphsyncBlock = initGraphsyncBlock()
    var hasBlock: bool
    var meta: GraphsyncMetadataEntry = GraphsyncMetadataEntry(link: req.root, action: gslaMissing)
    let hasMeta: bool = req.hasRoot && BytesLen(req.root) > 0
    if ! req.hasRoot:
        response.status = int32(gsrsRequestRejected)
        return Ok[GraphsyncResponseBundle](GraphsyncResponseBundle(resp: response, blocks: blk, hasBlock: false))
    if req.cancel:
        response.status = int32(gsrsRequestCancelled)
        if hasMeta:
            response.metadata[0] = meta
            response.metadataCount = 1
        return Ok[GraphsyncResponseBundle](GraphsyncResponseBundle(resp: response, blocks: blk, hasBlock: false))
    let cidRes: Result[Cid] = cidFromBytes(req.root)
    if IsErr(cidRes):
        response.status = int32(gsrsRequestFailedUnknown)
        if hasMeta:
            response.metadata[0] = meta
            response.metadataCount = 1
        return Ok[GraphsyncResponseBundle](GraphsyncResponseBundle(resp: response, blocks: blk, hasBlock: false))
    let cid: Cid = Value(cidRes)
    if graphsyncHasBlock(cid):
        let dataRes: Result[Bytes] = graphsyncGetBlock(cid)
        if IsOk(dataRes):
            let prefixRes: Result[Bytes] = graphsyncCidPrefix(cid)
            if IsOk(prefixRes):
                blk.prefix = Value(prefixRes)
            blk.data = Value(dataRes)
            hasBlock = true
            response.status = int32(gsrsRequestCompletedFull)
            meta.action = gslaPresent
        else:
            response.status = int32(gsrsRequestFailedUnknown)
    else:
        response.status = int32(gsrsRequestFailedContentNotFound)
    if hasMeta:
        response.metadata[0] = meta
        response.metadataCount = 1
    return Ok[GraphsyncResponseBundle](GraphsyncResponseBundle(resp: response, blocks: blk, hasBlock: hasBlock))

fn graphsyncHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    if ! graphsyncContextReady():
        return Err[bool]("graphsync: missing store")
    let msgRes: Result[GraphsyncMessage] = readGraphsyncMessage(streamVar)
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    let msg: GraphsyncMessage = Value(msgRes)
    var reply: GraphsyncMessage = initGraphsyncMessage()
    reply.completeRequestList = msg.completeRequestList
    for i in 0..<msg.requestCount:
        if ! (i < msg.requestCount && reply.responseCount < maxGraphsyncResponses):
            break
        let req: GraphsyncRequest = msg.requests[i]
        let respRes = buildGraphsyncResponse(req)
        if IsErr(respRes):
            return Err[bool](Error(respRes))
        let resp = Value(respRes)
        reply.responses[reply.responseCount] = resp.resp
        reply.responseCount = reply.responseCount + 1
        if resp.hasBlock && reply.blockCount < maxGraphsyncBlocks:
            reply.blocks[reply.blockCount] = resp.blocks
            reply.blockCount = reply.blockCount + 1
    let writeRes: Result[bool] = writeGraphsyncMessage(streamVar, reply)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn graphsyncProtocol(): Lp2pProtocol =
    return newProtocol(graphsyncCodec, graphsyncHandler)
