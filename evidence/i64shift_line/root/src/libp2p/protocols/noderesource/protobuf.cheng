# Node resource protobuf messages(minimal).
# v2 canonical field keys:
# platform_kind cpu_mips_measured npu_tops_x100 thermal_state battery_pct
# is_charging is_screen_off network_type cgroup_cpu_quota_us cgroup_cpu_period_us
# cgroup_mem_limit_bytes microbench_fp32_gflops_x100 microbench_duration_ms nat_type
# ask_price_cpu_nano ask_price_gpu_nano ask_price_io_nano ask_workload_mask

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
const
    nodeResInfoOsField = 1
    nodeResInfoCpuField = 2
    nodeResInfoMemField = 3
    nodeResInfoBandwidthInField = 4
    nodeResInfoBandwidthOutField = 5
    nodeResInfoGpuCountField = 6
    nodeResInfoGpuNameField = 7
    nodeResInfoVramField = 8
    nodeResInfoUpdatedAtField = 9
    nodeResInfoPlatformKindField = 10
    nodeResInfoCpuMipsMeasuredField = 11
    nodeResInfoNpuTopsX100Field = 12
    nodeResInfoThermalStateField = 13
    nodeResInfoBatteryPctField = 14
    nodeResInfoIsChargingField = 15
    nodeResInfoIsScreenOffField = 16
    nodeResInfoNetworkTypeField = 17
    nodeResInfoCgroupCpuQuotaUsField = 18
    nodeResInfoCgroupCpuPeriodUsField = 19
    nodeResInfoCgroupMemLimitBytesField = 20
    nodeResInfoMicrobenchFp32GflopsX100Field = 21
    nodeResInfoMicrobenchDurationMsField = 22
    nodeResInfoNatTypeField = 23
    nodeResInfoAskPriceCpuNanoField = 24
    nodeResInfoAskPriceGpuNanoField = 25
    nodeResInfoAskPriceIoNanoField = 26
    nodeResInfoAskWorkloadMaskField = 27

    nodeResReqIdField = 1

    nodeResRespOkField = 1
    nodeResRespMessageField = 2
    nodeResRespRequestIdField = 3
    nodeResRespInfoField = 4

    nodeResCpuCoresMax = 262144
    nodeResMemoryBytesMax = 1125899906842624
    nodeResBandwidthBytesMax = 1099511627776
    nodeResGpuCountMax = 16384
    nodeResVramBytesMax = 1125899906842624
    nodeResUpdatedAtMsMax = 4102444800000
    nodeResInt64Max = 9223372036854775807
    nodeResBatteryPctMax = 100
    nodeResMicrobenchDurationMsMax = 600000

type
    NodeResourceInfo =
        os: str
        cpuCores: int32
        memoryBytes: int64
        bandwidthInBytes: int64
        bandwidthOutBytes: int64
        gpuCount: int32
        gpuName: str
        vramBytes: int64
        updatedAtMs: int64
        platformKind: str
        cpuMipsMeasured: int64
        npuTopsX100: int64
        thermalState: str
        batteryPct: int32
        isCharging: bool
        isScreenOff: bool
        networkType: str
        cgroupCpuQuotaUs: int64
        cgroupCpuPeriodUs: int64
        cgroupMemLimitBytes: int64
        microbenchFp32GflopsX100: int64
        microbenchDurationMs: int32
        natType: str
        askPriceCpuNano: int64
        askPriceGpuNano: int64
        askPriceIoNano: int64
        askWorkloadMask: int64

    NodeResourceRequest =
        requestId: int64

    NodeResourceResponse =
        ok: bool
        message: str
        requestId: int64
        info: NodeResourceInfo
        hasInfo: bool

fn initNodeResourceInfo(): NodeResourceInfo =
    NodeResourceInfo(
        os: "",
        cpuCores: 0,
        memoryBytes: 0,
        bandwidthInBytes: 0,
        bandwidthOutBytes: 0,
        gpuCount: 0,
        gpuName: "",
        vramBytes: 0,
        updatedAtMs: 0,
        platformKind: "",
        cpuMipsMeasured: 0,
        npuTopsX100: 0,
        thermalState: "",
        batteryPct: 0,
        isCharging: false,
        isScreenOff: false,
        networkType: "",
        cgroupCpuQuotaUs: 0,
        cgroupCpuPeriodUs: 0,
        cgroupMemLimitBytes: 0,
        microbenchFp32GflopsX100: 0,
        microbenchDurationMs: 0,
        natType: "",
        askPriceCpuNano: 0,
        askPriceGpuNano: 0,
        askPriceIoNano: 0,
        askWorkloadMask: 0
    )

fn initNodeResourceRequest(): NodeResourceRequest =
    NodeResourceRequest(requestId: 0)

fn initNodeResourceResponse(): NodeResourceResponse =
    NodeResourceResponse(ok: false, message: "", requestId: 0, info: initNodeResourceInfo(), hasInfo: false)

fn nodeResourceInfoHasData(info: NodeResourceInfo): bool =
    if len(info.os) > 0:
        return true
    if info.cpuCores > 0:
        return true
    if info.memoryBytes > 0:
        return true
    if info.bandwidthInBytes > 0 || info.bandwidthOutBytes > 0:
        return true
    if info.gpuCount > 0 || len(info.gpuName) > 0 || info.vramBytes > 0:
        return true
    if info.updatedAtMs > 0:
        return true
    if len(info.platformKind) > 0:
        return true
    if info.cpuMipsMeasured > 0 || info.npuTopsX100 > 0:
        return true
    if len(info.thermalState) > 0:
        return true
    if info.batteryPct > 0 || info.isCharging || info.isScreenOff:
        return true
    if len(info.networkType) > 0:
        return true
    if info.cgroupCpuQuotaUs > 0 || info.cgroupCpuPeriodUs > 0 || info.cgroupMemLimitBytes > 0:
        return true
    if info.microbenchFp32GflopsX100 > 0 || info.microbenchDurationMs > 0:
        return true
    if len(info.natType) > 0:
        return true
    if info.askPriceCpuNano > 0 || info.askPriceGpuNano > 0 || info.askPriceIoNano > 0:
        return true
    if info.askWorkloadMask > 0:
        return true
    return false

fn nodeResourceValidateRange(name: str, value: int64, lower: int64, upper: int64): Result[bool] =
    if value < lower || value > upper:
        return Err[bool]("node resource protobuf: " + name + " out of range")
    return Ok[bool](true)

fn encodeNodeResourceInfo(info: NodeResourceInfo): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if len(info.os) > 0:
        writeString(pb, nodeResInfoOsField, info.os)
    if info.cpuCores > 0:
        writeVarint(pb, nodeResInfoCpuField, int64(info.cpuCores))
    if info.memoryBytes > 0:
        writeVarint(pb, nodeResInfoMemField, info.memoryBytes)
    if info.bandwidthInBytes > 0:
        writeVarint(pb, nodeResInfoBandwidthInField, info.bandwidthInBytes)
    if info.bandwidthOutBytes > 0:
        writeVarint(pb, nodeResInfoBandwidthOutField, info.bandwidthOutBytes)
    if info.gpuCount > 0:
        writeVarint(pb, nodeResInfoGpuCountField, int64(info.gpuCount))
    if len(info.gpuName) > 0:
        writeString(pb, nodeResInfoGpuNameField, info.gpuName)
    if info.vramBytes > 0:
        writeVarint(pb, nodeResInfoVramField, info.vramBytes)
    if info.updatedAtMs > 0:
        writeVarint(pb, nodeResInfoUpdatedAtField, info.updatedAtMs)
    if len(info.platformKind) > 0:
        writeString(pb, nodeResInfoPlatformKindField, info.platformKind)
    if info.cpuMipsMeasured > 0:
        writeVarint(pb, nodeResInfoCpuMipsMeasuredField, info.cpuMipsMeasured)
    if info.npuTopsX100 > 0:
        writeVarint(pb, nodeResInfoNpuTopsX100Field, info.npuTopsX100)
    if len(info.thermalState) > 0:
        writeString(pb, nodeResInfoThermalStateField, info.thermalState)
    if info.batteryPct > 0:
        writeVarint(pb, nodeResInfoBatteryPctField, int64(info.batteryPct))
    if info.isCharging:
        writeVarint(pb, nodeResInfoIsChargingField, 1)
    if info.isScreenOff:
        writeVarint(pb, nodeResInfoIsScreenOffField, 1)
    if len(info.networkType) > 0:
        writeString(pb, nodeResInfoNetworkTypeField, info.networkType)
    if info.cgroupCpuQuotaUs > 0:
        writeVarint(pb, nodeResInfoCgroupCpuQuotaUsField, info.cgroupCpuQuotaUs)
    if info.cgroupCpuPeriodUs > 0:
        writeVarint(pb, nodeResInfoCgroupCpuPeriodUsField, info.cgroupCpuPeriodUs)
    if info.cgroupMemLimitBytes > 0:
        writeVarint(pb, nodeResInfoCgroupMemLimitBytesField, info.cgroupMemLimitBytes)
    if info.microbenchFp32GflopsX100 > 0:
        writeVarint(pb, nodeResInfoMicrobenchFp32GflopsX100Field, info.microbenchFp32GflopsX100)
    if info.microbenchDurationMs > 0:
        writeVarint(pb, nodeResInfoMicrobenchDurationMsField, int64(info.microbenchDurationMs))
    if len(info.natType) > 0:
        writeString(pb, nodeResInfoNatTypeField, info.natType)
    if info.askPriceCpuNano > 0:
        writeVarint(pb, nodeResInfoAskPriceCpuNanoField, info.askPriceCpuNano)
    if info.askPriceGpuNano > 0:
        writeVarint(pb, nodeResInfoAskPriceGpuNanoField, info.askPriceGpuNano)
    if info.askPriceIoNano > 0:
        writeVarint(pb, nodeResInfoAskPriceIoNanoField, info.askPriceIoNano)
    if info.askWorkloadMask > 0:
        writeVarint(pb, nodeResInfoAskWorkloadMaskField, info.askWorkloadMask)
    return Ok[Bytes](protoToBytes(pb))

fn decodeNodeResourceInfo(data: Bytes): Result[NodeResourceInfo] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var info: NodeResourceInfo = initNodeResourceInfo()
    var osBytes: Bytes = EmptyBytes()
    let osRes: Result[bool] = getField(pb, nodeResInfoOsField, osBytes)
    if IsErr(osRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.os")
    if Value(osRes):
        info.os = BytesToString(osBytes)
    var cpuVal: int64
    let cpuRes: Result[bool] = getField(pb, nodeResInfoCpuField, cpuVal)
    if IsErr(cpuRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.cpuCores")
    if Value(cpuRes):
        let cpuRangeRes: Result[bool] = nodeResourceValidateRange("info.cpuCores", cpuVal, 0, nodeResCpuCoresMax)
        if IsErr(cpuRangeRes):
            return Err[NodeResourceInfo](Error(cpuRangeRes))
        info.cpuCores = int32(cpuVal)
    var memVal: int64
    let memRes: Result[bool] = getField(pb, nodeResInfoMemField, memVal)
    if IsErr(memRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.memoryBytes")
    if Value(memRes):
        let memRangeRes: Result[bool] = nodeResourceValidateRange("info.memoryBytes", memVal, 0, nodeResMemoryBytesMax)
        if IsErr(memRangeRes):
            return Err[NodeResourceInfo](Error(memRangeRes))
        info.memoryBytes = memVal
    var bwInVal: int64
    let bwInRes: Result[bool] = getField(pb, nodeResInfoBandwidthInField, bwInVal)
    if IsErr(bwInRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.bandwidthInBytes")
    if Value(bwInRes):
        let bwInRangeRes: Result[bool] = nodeResourceValidateRange("info.bandwidthInBytes", bwInVal, 0, nodeResBandwidthBytesMax)
        if IsErr(bwInRangeRes):
