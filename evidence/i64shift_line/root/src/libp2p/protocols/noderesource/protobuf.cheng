        info.isCharging = isChargingVal != 0
    var isScreenOffVal: int64
    let isScreenOffRes: Result[bool] = getField(pb, nodeResInfoIsScreenOffField, isScreenOffVal)
    if IsErr(isScreenOffRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.isScreenOff")
    if Value(isScreenOffRes):
        info.isScreenOff = isScreenOffVal != 0
    var networkTypeBytes: Bytes = EmptyBytes()
    let networkTypeRes: Result[bool] = getField(pb, nodeResInfoNetworkTypeField, networkTypeBytes)
