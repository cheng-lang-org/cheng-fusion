    if Value(cgroupCpuPeriodRes):
        info.cgroupCpuPeriodUs = cgroupCpuPeriodVal
    var cgroupMemLimitVal: int64
    let cgroupMemLimitRes: Result[bool] = getField(pb, nodeResInfoCgroupMemLimitBytesField, cgroupMemLimitVal)
    if IsErr(cgroupMemLimitRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.cgroupMemLimitBytes")
    if Value(cgroupMemLimitRes):
        info.cgroupMemLimitBytes = cgroupMemLimitVal
    var microbenchFpVal: int64
    let microbenchFpRes: Result[bool] = getField(pb, nodeResInfoMicrobenchFp32GflopsX100Field, microbenchFpVal)
    if IsErr(microbenchFpRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.microbenchFp32GflopsX100")
    if Value(microbenchFpRes):
        info.microbenchFp32GflopsX100 = microbenchFpVal
    var microbenchDurationVal: int64
    let microbenchDurationRes: Result[bool] = getField(pb, nodeResInfoMicrobenchDurationMsField, microbenchDurationVal)
    if IsErr(microbenchDurationRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.microbenchDurationMs")
    if Value(microbenchDurationRes):
        let microbenchDurationRangeRes: Result[bool] = nodeResourceValidateRange("info.microbenchDurationMs", microbenchDurationVal, 0, nodeResMicrobenchDurationMsMax)
        if IsErr(microbenchDurationRangeRes):
            return Err[NodeResourceInfo](Error(microbenchDurationRangeRes))
        info.microbenchDurationMs = int32(microbenchDurationVal)
    var natTypeBytes: Bytes = EmptyBytes()
