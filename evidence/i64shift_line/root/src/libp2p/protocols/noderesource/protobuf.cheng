        info.bandwidthInBytes = bwInVal
    var bwOutVal: int64
    let bwOutRes: Result[bool] = getField(pb, nodeResInfoBandwidthOutField, bwOutVal)
    if IsErr(bwOutRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.bandwidthOutBytes")
    if Value(bwOutRes):
        let bwOutRangeRes: Result[bool] = nodeResourceValidateRange("info.bandwidthOutBytes", bwOutVal, 0, nodeResBandwidthBytesMax)
        if IsErr(bwOutRangeRes):
            return Err[NodeResourceInfo](Error(bwOutRangeRes))
        info.bandwidthOutBytes = bwOutVal
    var gpuVal: int64
    let gpuRes: Result[bool] = getField(pb, nodeResInfoGpuCountField, gpuVal)
    if IsErr(gpuRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.gpuCount")
    if Value(gpuRes):
        let gpuRangeRes: Result[bool] = nodeResourceValidateRange("info.gpuCount", gpuVal, 0, nodeResGpuCountMax)
        if IsErr(gpuRangeRes):
            return Err[NodeResourceInfo](Error(gpuRangeRes))
        info.gpuCount = int32(gpuVal)
    var gpuNameBytes: Bytes = EmptyBytes()
    let gpuNameRes: Result[bool] = getField(pb, nodeResInfoGpuNameField, gpuNameBytes)
    if IsErr(gpuNameRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.gpuName")
    if Value(gpuNameRes):
        info.gpuName = BytesToString(gpuNameBytes)
    var vramVal: int64
    let vramRes: Result[bool] = getField(pb, nodeResInfoVramField, vramVal)
    if IsErr(vramRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.vramBytes")
    if Value(vramRes):
        let vramRangeRes: Result[bool] = nodeResourceValidateRange("info.vramBytes", vramVal, 0, nodeResVramBytesMax)
        if IsErr(vramRangeRes):
            return Err[NodeResourceInfo](Error(vramRangeRes))
        info.vramBytes = vramVal
    var updatedVal: int64
    let updatedRes: Result[bool] = getField(pb, nodeResInfoUpdatedAtField, updatedVal)
    if IsErr(updatedRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.updatedAtMs")
    if Value(updatedRes):
        let updatedRangeRes: Result[bool] = nodeResourceValidateRange("info.updatedAtMs", updatedVal, 0, nodeResUpdatedAtMsMax)
        if IsErr(updatedRangeRes):
            return Err[NodeResourceInfo](Error(updatedRangeRes))
