fn encodeNodeResourceRequest(req: NodeResourceRequest): Result[Bytes] =
    if req.requestId <= 0:
        return Err[Bytes]("node resource: missing request id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, nodeResReqIdField, req.requestId)
    return Ok[Bytes](protoToBytes(pb))

fn decodeNodeResourceRequest(data: Bytes): Result[NodeResourceRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: NodeResourceRequest = initNodeResourceRequest()
    var idVal: int64
    let idRes: Result[bool] = getField(pb, nodeResReqIdField, idVal)
    if IsErr(idRes):
        return Err[NodeResourceRequest](Error(idRes))
    if Value(idRes):
        req.requestId = idVal
    if req.requestId <= 0:
        return Err[NodeResourceRequest]("node resource: missing request id")
    return Ok[NodeResourceRequest](req)

fn encodeNodeResourceResponse(resp: NodeResourceResponse): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if resp.ok:
        writeVarint(pb, nodeResRespOkField, 1)
    if len(resp.message) > 0:
        writeString(pb, nodeResRespMessageField, resp.message)
    if resp.requestId > 0:
        writeVarint(pb, nodeResRespRequestIdField, resp.requestId)
    if resp.hasInfo || nodeResourceInfoHasData(resp.info):
        let infoRes: Result[Bytes] = encodeNodeResourceInfo(resp.info)
        if IsErr(infoRes):
            return Err[Bytes](Error(infoRes))
        writeBytes(pb, nodeResRespInfoField, Value(infoRes))
    return Ok[Bytes](protoToBytes(pb))

fn decodeNodeResourceResponse(data: Bytes): Result[NodeResourceResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: NodeResourceResponse = initNodeResourceResponse()
    var okVal: int64
    let okRes: Result[bool] = getField(pb, nodeResRespOkField, okVal)
    if IsErr(okRes):
        return Err[NodeResourceResponse]("node resource protobuf: response.ok")
    if Value(okRes):
        resp.ok = okVal != 0
    var msgBytes: Bytes = EmptyBytes()
    let msgRes: Result[bool] = getField(pb, nodeResRespMessageField, msgBytes)
    if IsErr(msgRes):
        return Err[NodeResourceResponse]("node resource protobuf: response.message")
    if Value(msgRes):
        resp.message = BytesToString(msgBytes)
    var idVal: int64
    let idRes: Result[bool] = getField(pb, nodeResRespRequestIdField, idVal)
    if IsErr(idRes):
        return Err[NodeResourceResponse]("node resource protobuf: response.requestId")
    if Value(idRes):
        resp.requestId = idVal
    var infoBytes: Bytes = EmptyBytes()
    let infoRes: Result[bool] = getField(pb, nodeResRespInfoField, infoBytes)
    if IsErr(infoRes):
        return Err[NodeResourceResponse]("node resource protobuf: response.info")
    if Value(infoRes):
        let infoDecRes: Result[NodeResourceInfo] = decodeNodeResourceInfo(infoBytes)
        if IsErr(infoDecRes):
            return Err[NodeResourceResponse]("node resource protobuf: response.info.decode")
        resp.info = Value(infoDecRes)
        resp.hasInfo = true
    return Ok[NodeResourceResponse](resp)
