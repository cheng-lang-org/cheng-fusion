    var thermalStateBytes: Bytes = EmptyBytes()
    let thermalStateRes: Result[bool] = getField(pb, nodeResInfoThermalStateField, thermalStateBytes)
    if IsErr(thermalStateRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.thermalState")
    if Value(thermalStateRes):
        info.thermalState = BytesToString(thermalStateBytes)
    var batteryPctVal: int64
    let batteryPctRes: Result[bool] = getField(pb, nodeResInfoBatteryPctField, batteryPctVal)
    if IsErr(batteryPctRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.batteryPct")
    if Value(batteryPctRes):
        let batteryPctRangeRes: Result[bool] = nodeResourceValidateRange("info.batteryPct", batteryPctVal, 0, nodeResBatteryPctMax)
        if IsErr(batteryPctRangeRes):
