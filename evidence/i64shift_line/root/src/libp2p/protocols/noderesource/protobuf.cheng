    var platformKindBytes: Bytes = EmptyBytes()
    let platformKindRes: Result[bool] = getField(pb, nodeResInfoPlatformKindField, platformKindBytes)
    if IsErr(platformKindRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.platformKind")
    if Value(platformKindRes):
        info.platformKind = BytesToString(platformKindBytes)
    var cpuMipsMeasuredVal: int64
    let cpuMipsMeasuredRes: Result[bool] = getField(pb, nodeResInfoCpuMipsMeasuredField, cpuMipsMeasuredVal)
    if IsErr(cpuMipsMeasuredRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.cpuMipsMeasured")
    if Value(cpuMipsMeasuredRes):
        let cpuMipsRangeRes: Result[bool] = nodeResourceValidateRange("info.cpuMipsMeasured", cpuMipsMeasuredVal, 0, nodeResInt64Max)
        if IsErr(cpuMipsRangeRes):
            return Err[NodeResourceInfo](Error(cpuMipsRangeRes))
        info.cpuMipsMeasured = cpuMipsMeasuredVal
    var npuTopsVal: int64
    let npuTopsRes: Result[bool] = getField(pb, nodeResInfoNpuTopsX100Field, npuTopsVal)
    if IsErr(npuTopsRes):
        return Err[NodeResourceInfo]("node resource protobuf: info.npuTopsX100")
