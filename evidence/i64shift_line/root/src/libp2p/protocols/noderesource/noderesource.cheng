# Node resource protocol + registry(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/system
import std/strings as stdstrings
import std/strutils as strutil
import std/times
import cheng/libp2p/stream/lpstream
import cheng/libp2p/stream/connection
import cheng/libp2p/protocols/protocol
import cheng/libp2p/peerid
import cheng/libp2p/resourcemanager
import cheng/libp2p/protocols/noderesource/protobuf as nrpb
@importc("cheng_host_getenv")
fn nodeResourceGetEnv(name: cstring): cstring
@importc("cheng_fopen")
fn nodeResourceFopen(filename, mode: cstring): int64
@importc("cheng_fclose")
fn nodeResourceFclose(f: int64): int32
@importc("cheng_fread")
fn nodeResourceFread(ptr: cstring, size, n: int, stream: int64): int32

const
    nodeResourceCodec = "/libp2p/node-resource/1.0.0"
    nodeResourceDefaultMaxMessage = 65536
    nodeResourceMaxEntries = 128
    nodeResourceDefaultTtlMs = 60000
    nodeResourceMaxGpuScan = 16
    nodeResourceMaxNetIfaces = 32
    nodeResourceInt64Max = 9223372036854775807
    nodeResourceInt64Min = -9223372036854775807 - 1
    nodeResourceWorkloadMaskTrain = 1
    nodeResourceWorkloadMaskInfer = 2
    nodeResourceWorkloadMaskOther = 4
    nodeResourceWorkloadMaskAll = nodeResourceWorkloadMaskTrain | nodeResourceWorkloadMaskInfer | nodeResourceWorkloadMaskOther

type
    NodeResourceConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    NodeResourceEntry =
        peerId: str
        info: NodeResourceInfo
        expiresAtMs: int64

    NodeResourceRegistry =
        count: int32
        entries: NodeResourceEntry[]

    NodeResourceTotals =
        nodeCount: int32
        cpuCores: int64
        memoryBytes: int64
        bandwidthInBytes: int64
        bandwidthOutBytes: int64
        gpuCount: int64
        vramBytes: int64

    NodeResourceOverrides =
        hasOs: bool
        os: str
        hasCpuCores: bool
        cpuCores: int32
        hasMemoryBytes: bool
        memoryBytes: int64
        hasBandwidthIn: bool
        bandwidthInBytes: int64
        hasBandwidthOut: bool
        bandwidthOutBytes: int64
        hasGpuCount: bool
        gpuCount: int32
        hasGpuName: bool
        gpuName: str
        hasVramBytes: bool
        vramBytes: int64
        hasNetworkType: bool
        networkType: str

    NodeResourceContext =
        config: NodeResourceConfig
        hasHandler: bool
        handler: fn(req: NodeResourceRequest): NodeResourceResponse
        registry: NodeResourceRegistry
        ttlMs: int64
        overrides: NodeResourceOverrides

    NodeResourceGpuAuto =
        count: int32
        name: str
        vramBytes: int64

    NodeResourceIfaceList =
        count: int32
        names: str[]

fn initNodeResourceConfig(): NodeResourceConfig =
    NodeResourceConfig(maxMessageBytes: nodeResourceDefaultMaxMessage, closeAfterResponse: true)

fn initNodeResourceRegistry(): NodeResourceRegistry =
    var reg: NodeResourceRegistry = NodeResourceRegistry(count: 0)
    setLen(reg.entries, nodeResourceMaxEntries)
    return reg

fn initNodeResourceTotals(): NodeResourceTotals =
    NodeResourceTotals(nodeCount: 0, cpuCores: 0, memoryBytes: 0, bandwidthInBytes: 0, bandwidthOutBytes: 0, gpuCount: 0, vramBytes: 0)

fn initNodeResourceOverrides(): NodeResourceOverrides =
    NodeResourceOverrides(
        hasOs: false,
        os: "",
        hasCpuCores: false,
        cpuCores: 0,
        hasMemoryBytes: false,
        memoryBytes: 0,
        hasBandwidthIn: false,
        bandwidthInBytes: 0,
        hasBandwidthOut: false,
        bandwidthOutBytes: 0,
        hasGpuCount: false,
        gpuCount: 0,
        hasGpuName: false,
        gpuName: "",
        hasVramBytes: false,
        vramBytes: 0,
        hasNetworkType: false,
        networkType: ""
    )

var
    nodeResourceContext: NodeResourceContext = NodeResourceContext(
        config: initNodeResourceConfig(),
        hasHandler: false,
        registry: initNodeResourceRegistry(),
        ttlMs: nodeResourceDefaultTtlMs,
        overrides: initNodeResourceOverrides()
    )
    nodeResourceRequestSeq: int64 = 1
    nodeResourceGpuAutoReady: bool
    nodeResourceGpuAutoCache: NodeResourceGpuAuto

fn nodeResourceNextRequestId(): int64 =
    let next: int64 = nodeResourceRequestSeq
    nodeResourceRequestSeq = nodeResourceRequestSeq + 1
    if nodeResourceRequestSeq <= 0:
        nodeResourceRequestSeq = 1
    return next

fn setNodeResourceConfig(config: NodeResourceConfig) =
    nodeResourceContext.config = config

fn setNodeResourceHandler(handler: fn(req: NodeResourceRequest): NodeResourceResponse) =
    nodeResourceContext.handler = handler
    nodeResourceContext.hasHandler = true

fn nodeResourceRegistryReset() =
    nodeResourceContext.registry.count = 0
    setLen(nodeResourceContext.registry.entries, 0)

fn nodeResourceSetTtl(ttlMs: int64) =
    nodeResourceContext.ttlMs = ttlMs

fn nodeResourceResetOverrides() =
    var fresh: NodeResourceOverrides = initNodeResourceOverrides()
    nodeResourceContext.overrides.hasOs = fresh.hasOs
    nodeResourceContext.overrides.os = fresh.os
    nodeResourceContext.overrides.hasCpuCores = fresh.hasCpuCores
    nodeResourceContext.overrides.cpuCores = fresh.cpuCores
    nodeResourceContext.overrides.memoryBytes = fresh.memoryBytes
    nodeResourceContext.overrides.bandwidthInBytes = fresh.bandwidthInBytes
    nodeResourceContext.overrides.bandwidthOutBytes = fresh.bandwidthOutBytes

fn nodeResourceOverridesStore(overrides: NodeResourceOverrides) =
    nodeResourceContext.overrides.hasOs = overrides.hasOs
    nodeResourceContext.overrides.os = overrides.os
    nodeResourceContext.overrides.hasCpuCores = overrides.hasCpuCores
    nodeResourceContext.overrides.cpuCores = overrides.cpuCores
    nodeResourceContext.overrides.hasMemoryBytes = overrides.hasMemoryBytes
    nodeResourceContext.overrides.memoryBytes = overrides.memoryBytes
    nodeResourceContext.overrides.hasBandwidthIn = overrides.hasBandwidthIn
    nodeResourceContext.overrides.bandwidthInBytes = overrides.bandwidthInBytes
    nodeResourceContext.overrides.hasBandwidthOut = overrides.hasBandwidthOut
    nodeResourceContext.overrides.bandwidthOutBytes = overrides.bandwidthOutBytes
    nodeResourceContext.overrides.hasGpuCount = overrides.hasGpuCount
    nodeResourceContext.overrides.gpuCount = overrides.gpuCount
    nodeResourceContext.overrides.hasGpuName = overrides.hasGpuName
    nodeResourceContext.overrides.gpuName = overrides.gpuName
    nodeResourceContext.overrides.hasVramBytes = overrides.hasVramBytes
    nodeResourceContext.overrides.vramBytes = overrides.vramBytes
    nodeResourceContext.overrides.hasNetworkType = overrides.hasNetworkType
    nodeResourceContext.overrides.networkType = overrides.networkType

fn nodeResourceOverrideOs(os: str) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasOs = len(os) > 0
    overrides.os = os
    nodeResourceOverridesStore(overrides)

fn nodeResourceOverrideCpuCores(cores: int32) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasCpuCores = cores >= 0
    if cores >= 0:
        overrides.cpuCores = cores
    else:
        overrides.cpuCores = 0
    nodeResourceOverridesStore(overrides)

fn nodeResourceOverrideMemoryBytes(bytes: int64) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasMemoryBytes = bytes >= 0
    if bytes >= 0:
        overrides.memoryBytes = bytes
    else:
        overrides.memoryBytes = 0
    nodeResourceOverridesStore(overrides)

fn nodeResourceOverrideBandwidthInBytes(bytes: int64) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasBandwidthIn = bytes >= 0
    if bytes >= 0:
        overrides.bandwidthInBytes = bytes
    else:
        overrides.bandwidthInBytes = 0
    nodeResourceOverridesStore(overrides)

fn nodeResourceOverrideBandwidthOutBytes(bytes: int64) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasBandwidthOut = bytes >= 0
    if bytes >= 0:
        overrides.bandwidthOutBytes = bytes
    else:
        overrides.bandwidthOutBytes = 0
    nodeResourceOverridesStore(overrides)

fn nodeResourceOverrideGpuCount(count: int32) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasGpuCount = count >= 0
    if count >= 0:
        overrides.gpuCount = count
    else:
        overrides.gpuCount = 0
    nodeResourceOverridesStore(overrides)

fn nodeResourceOverrideGpuName(name: str) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasGpuName = len(name) > 0
    overrides.gpuName = name
    nodeResourceOverridesStore(overrides)

fn nodeResourceOverrideVramBytes(bytes: int64) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasVramBytes = bytes >= 0
    if bytes >= 0:
        overrides.vramBytes = bytes
    else:
        overrides.vramBytes = 0
    nodeResourceOverridesStore(overrides)

fn nodeResourceNormalizeNetworkType(networkType: str): str =
    let normalized: str = strutil.toLowerAscii(strutil.strip(networkType))
    if normalized == "wifi":
        return "wifi"
    if normalized == "cellular":
        return "cellular"
    if normalized == "ethernet":
        return "ethernet"
    if normalized == "unknown":
        return "unknown"
    if len(normalized) <= 0:
        return "unknown"
    return "unknown"

fn nodeResourceSetNetworkTypeOverride(networkType: str) =
    var overrides: NodeResourceOverrides = nodeResourceContext.overrides
    overrides.hasNetworkType = true
    overrides.networkType = nodeResourceNormalizeNetworkType(networkType)
    nodeResourceOverridesStore(overrides)

fn nodeResourceEnv(name: str): str =
    let v: cstring = nodeResourceGetEnv(name)
    if v == nil:
        return ""
    let s: str = system.strFromCStringCopy(v)
    return s

fn nodeResourceParseInt64(text: str): Result[int64] =
    if len(text) <= 0:
        return Err[int64]("node resource: empty number")
    var i: int32
    var neg: bool
    if text[0] == '-':
        neg = true
        i = 1
    if i >= len(text):
        return Err[int64]("node resource: invalid number")
    var parsed: int64
    for pos in i..<len(text):
        let c: char = text[pos]
        if c < '0' || c > '9':
            return Err[int64]("node resource: invalid digit")
        parsed = parsed * 10 + int64(int32(c) - int32('0'))
    if neg:
        parsed = -parsed
    return Ok[int64](parsed)

fn nodeResourceParseInt32(text: str): Result[int32] =
    let res: Result[int64] = nodeResourceParseInt64(text)
    if IsErr(res):
        return Err[int32](Error(res))
    let v: int64 = Value(res)
    if v < -2147483648 || v > 2147483647:
        return Err[int32]("node resource: int32 overflow")
    return Ok[int32](int32(v))

@borrows
fn nodeResourceEnvInt64(name: str, out: var int64): bool =
    let raw: str = nodeResourceEnv(name)
    if len(raw) <= 0:
        return false
    let res: Result[int64] = nodeResourceParseInt64(raw)
    if IsErr(res):
        return false
    out = Value(res)
    return true

@borrows
fn nodeResourceEnvInt32(name: str, out: var int32): bool =
    let raw: str = nodeResourceEnv(name)
    if len(raw) <= 0:
        return false
    let res: Result[int32] = nodeResourceParseInt32(raw)
    if IsErr(res):
        return false
    out = Value(res)
    return true

@borrows
fn nodeResourceEnvBool(name: str, out: var bool): bool =
    let raw: str = nodeResourceEnv(name)
    if len(raw) <= 0:
        return false
    let normalized = strutil.toLowerAscii(strutil.strip(raw))
    if normalized == "1" || normalized == "true" || normalized == "yes" || normalized == "on":
        out = true
        return true
    if normalized == "0" || normalized == "false" || normalized == "no" || normalized == "off":
        out = false
        return true
    return false

@borrows
fn nodeResourceReadFileText(path: str, maxBytes: int32): Result[str] =
    if len(path) <= 0:
        return Err[str]("node resource: empty path")
    let mode: str = "rb"
    let f: int64 = nodeResourceFopen(path, mode)
    if f == 0:
        return Err[str]("node resource: open failed")
    var cap: int32 = maxBytes
    if cap <= 0:
        cap = 65536
    var buf: Bytes = BytesAlloc(cap)
    let n: int32 = nodeResourceFread(buf.data, 1, cap, f)
    nodeResourceFclose(f)
    if n <= 0:
        return Err[str]("node resource: read empty")
    if n < buf.len:
        buf.len = n
    return Ok[str](BytesToString(buf))

@borrows
fn nodeResourceHasPrefixAt(text: str, start: int32, prefix: str): bool =
    let plen: int32 = len(prefix)
    let tlen: int32 = len(text)
    if start < 0 || start + plen > tlen:
        return false
    for i in 0..<plen:
        if text[start + i] != prefix[i]:
            return false
    return true

@borrows
fn nodeResourceSkipSpaces(text: str, start: int32, limit: int32): int32 =
    var i: int32 = start
    var end: int32 = limit
    if end < 0:
        end = len(text)
    i = end
    for pos in start..<end:
        let c: char = text[pos]
        if c != ' ' && c != '\t' && c != '\r':
            i = pos
            break
        i = pos + 1
    return i

@borrows
fn nodeResourceParseUint32Slice(text: str, start: int32, limit: int32, out: var int32): bool =
    var i: int32 = nodeResourceSkipSpaces(text, start, limit)
    var end: int32 = limit
    if end < 0:
        end = len(text)
    if i >= end:
        return false
    var parsed: int32
    var has: bool
    for pos in i..<end:
        let c: char = text[pos]
        if c < '0' || c > '9':
            break
        has = true
        parsed = parsed * 10 + int32(c) - int32('0')
    if ! has:
        return false
    out = parsed
    return true

fn nodeResourceParseCpuinfoLogicalCores(text: str): int32 =
    if len(text) <= 0:
        return 0
    var count: int32
    var lineStart: int32
    for i in 0..len(text):
        if i == len(text) || text[i] == '\n':
            var start: int32 = nodeResourceSkipSpaces(text, lineStart, i)
            if nodeResourceHasPrefixAt(text, start, "processor"):
                count = count + 1
            lineStart = i + 1
    return count

fn nodeResourceParseCpuOnline(text: str): int32 =
    if len(text) <= 0:
        return 0
    var count: int32
    var tokenStart: int32
    for i in 0..len(text):
        if i == len(text) || text[i] == ',' || text[i] == '\n':
            var a: int32
            let hasA: bool = nodeResourceParseUint32Slice(text, tokenStart, i, a)
            if hasA:
                var j: int32 = nodeResourceSkipSpaces(text, tokenStart, i)
                while j < i && text[j] >= '0' && text[j] <= '9':
                    j = j + 1
                j = nodeResourceSkipSpaces(text, j, i)
                if j < i && text[j] == '-':
                    var b: int32
                    let hasB: bool = nodeResourceParseUint32Slice(text, j + 1, i, b)
                    if hasB && b >= a:
                        count = count + (b - a + 1)
                    else:
                        count = count + 1
                else:
                    count = count + 1
            tokenStart = i + 1
    return count

fn nodeResourceParseMeminfoTotalBytes(text: str): int64 =
    if len(text) <= 0:
        return 0
    var lineStart: int32
    for i in 0..len(text):
        if i == len(text) || text[i] == '\n':
            var start: int32 = nodeResourceSkipSpaces(text, lineStart, i)
            if nodeResourceHasPrefixAt(text, start, "MemTotal:"):
                var valStart: int32 = start + len("MemTotal:")
                var memTotalKb: int64
                var has: bool
                for idx in nodeResourceSkipSpaces(text, valStart, i)..<i:
                    if ! (idx < i):
                        break
                    let c: char = text[idx]
                    if c < '0' || c > '9':
                        break
                    has = true
                    memTotalKb = memTotalKb * 10 + int64(int32(c) - int32('0'))
                if has:
                    return memTotalKb * 1024
            lineStart = i + 1
    return 0

@borrows
fn nodeResourceTrimRight(text: str, start: int32, end: int32): int32 =
    var i: int32 = end
    let loop_start_i_8 = i
    for loop_rev_i_8 in 0..(loop_start_i_8 - (start)):
        i = loop_start_i_8 - loop_rev_i_8
        if ! (i > start):
            break
        let c: char = text[i - 1]
        if c != ' ' && c != '\t' && c != '\r':
            break
    return i

@borrows
fn nodeResourceParseLineValue(text: str, key: str): str =
    if len(text) <= 0 || len(key) <= 0:
        return ""
    var lineStart: int32
    for i in 0..len(text):
        if i == len(text) || text[i] == '\n':
            var start: int32 = nodeResourceSkipSpaces(text, lineStart, i)
            if nodeResourceHasPrefixAt(text, start, key):
                var idx: int32 = start + len(key)
                for pos in idx..<i:
                    let c: char = text[pos]
                    if c != ' ' && c != '\t' && c != ':':
                        idx = pos
                        break
                    idx = pos + 1
                let endIdx: int32 = nodeResourceTrimRight(text, idx, i)
                if endIdx > idx:
                    return SliceBytes(text, idx, endIdx - idx)
            lineStart = i + 1
    return ""

fn nodeResourceParseFirstInt64(text: str): int64 =
    if len(text) <= 0:
        return 0
    var i: int32
    for pos in 0..<len(text):
        let c: char = text[pos]
        if c >= '0' && c <= '9':
            i = pos
            break
        i = pos + 1
    if i >= len(text):
        return 0
    var parsed: int64
    for pos in i..<len(text):
        let c: char = text[pos]
        if c < '0' || c > '9':
            break
        parsed = parsed * 10 + int64(int32(c) - int32('0'))
    return parsed

fn initNodeResourceIfaceList(): NodeResourceIfaceList =
    var list: NodeResourceIfaceList = NodeResourceIfaceList(count: 0)
    setLen(list.names, nodeResourceMaxNetIfaces)
    return list

@borrows
fn nodeResourceIndexOfChar(text: str, ch: char): int32 =
    for i in 0..<len(text):
        if text[i] == ch:
            return i
    return -1

fn nodeResourceNormalizeIfaceName(name: str): str =
    if len(name) <= 0:
        return ""
    let idx: int32 = nodeResourceIndexOfChar(name, '@')
    if idx > 0:
        return SliceBytes(name, 0, idx)
    return name

fn nodeResourceParseNetIfaces(text: str): NodeResourceIfaceList =
    var list: NodeResourceIfaceList = initNodeResourceIfaceList()
    if len(text) <= 0:
        return list
    var lineStart: int32
    for i in 0..len(text):
        if ! (i <= len(text)):
            break
        if i == len(text) || text[i] == '\n':
            var start: int32 = nodeResourceSkipSpaces(text, lineStart, i)
            if nodeResourceHasPrefixAt(text, start, "Inter-") || nodeResourceHasPrefixAt(text, start, "face"):
                lineStart = i + 1
                continue
            var colon: int32 = -1
            for j in lineStart..<i:
                if text[j] == ':':
                    colon = j
                    break
            if colon > lineStart:
                var nameStart: int32 = nodeResourceSkipSpaces(text, lineStart, colon)
                var nameEnd: int32 = nodeResourceTrimRight(text, nameStart, colon)
                if nameEnd > nameStart && list.count < nodeResourceMaxNetIfaces:
                    var name: str = SliceBytes(text, nameStart, nameEnd - nameStart)
                    name = nodeResourceNormalizeIfaceName(name)
                    if len(name) > 0:
                        list.names[list.count] = name
                        list.count = list.count + 1
            lineStart = i + 1
    return list

fn nodeResourceDetectBandwidthAutoBytes(): int64 =
    let devRes: Result[str] = nodeResourceReadFileText("/proc/net/dev", 65536)
    if IsErr(devRes):
        return 0
    let list: NodeResourceIfaceList = nodeResourceParseNetIfaces(Value(devRes))
    if list.count <= 0:
        return 0
    var maxBytes: int64
    for i in 0..<list.count:
        if ! (i < list.count):
            break
        let name: str = list.names[i]
        if (name == "lo"):
            continue
        let speedPath: str = "/sys/class/net/" + name + "/speed"
        let speedRes: Result[str] = nodeResourceReadFileText(speedPath, 64)
        if IsOk(speedRes):
            let mbps: int64 = nodeResourceParseFirstInt64(Value(speedRes))
            if mbps > 0:
                let bytesPerSec: int64 = mbps * 1024 * 1024 / 8
                if bytesPerSec > maxBytes:
                    maxBytes = bytesPerSec
    return maxBytes

@borrows
fn nodeResourceParseSizeInLine(text: str, start: int32, end: int32): int64 =
    var i: int32 = start
    for pos in start..<end:
        let c: char = text[pos]
        if c >= '0' && c <= '9':
            i = pos
            break
        i = pos + 1
    if i >= end:
        return 0
    var parsedSize: int64
    var unitStart: int32 = i
    for pos in i..<end:
        let c: char = text[pos]
        if c < '0' || c > '9':
            unitStart = pos
            break
        parsedSize = parsedSize * 10 + int64(int32(c) - int32('0'))
        unitStart = pos + 1
    for pos in unitStart..<end:
        let c: char = text[pos]
        if c != ' ' && c != '\t' && c != ':':
            unitStart = pos
            break
        unitStart = pos + 1
    var unitEnd: int32 = unitStart
    for pos in unitStart..<end:
        let c: char = text[pos]
        if c == ' ' || c == '\t' || c == '\r':
            unitEnd = pos
            break
        unitEnd = pos + 1
    if unitEnd <= unitStart:
        return parsedSize
    let unit: str = SliceBytes(text, unitStart, unitEnd - unitStart)
    if (unit == "KiB") || (unit == "kB"):
        return parsedSize * 1024
    if (unit == "MiB") || (unit == "MB"):
        return parsedSize * 1024 * 1024
    if (unit == "GiB") || (unit == "GB"):
        return parsedSize * 1024 * 1024 * 1024
    return parsedSize

fn nodeResourceParseNvidiaVramBytes(text: str): int64 =
    if len(text) <= 0:
        return 0
    var lineStart: int32
    for i in 0..len(text):
        if i == len(text) || text[i] == '\n':
            var start: int32 = nodeResourceSkipSpaces(text, lineStart, i)
            if nodeResourceHasPrefixAt(text, start, "Total"):
                let size: int64 = nodeResourceParseSizeInLine(text, start, i)
                if size > 0:
                    return size
            lineStart = i + 1
    return 0

fn nodeResourceDetectGpuAuto(): NodeResourceGpuAuto =
    if !nodeResourceGpuAutoReady:
        nodeResourceGpuAutoCache = NodeResourceGpuAuto(count: 0, name: "", vramBytes: 0)
    if nodeResourceGpuAutoReady:
        return nodeResourceGpuAutoCache
    var info: NodeResourceGpuAuto = NodeResourceGpuAuto(count: 0, name: "", vramBytes: 0)
    for idx in 0..<nodeResourceMaxGpuScan:
        let idxText: str = nodeResourceInt64ToString(int64(idx))
        let infoPath: str = "/proc/driver/nvidia/gpus/" + idxText + "/information"
        let infoRes: Result[str] = nodeResourceReadFileText(infoPath, 8192)
        if IsOk(infoRes):
            info.count = info.count + 1
            if len(info.name) <= 0:
                let model: str = nodeResourceParseLineValue(Value(infoRes), "Model")
                if len(model) > 0:
                    info.name = model
            let memPath: str = "/proc/driver/nvidia/gpus/" + idxText + "/fb_memory_usage"
            let memRes: Result[str] = nodeResourceReadFileText(memPath, 8192)
            if IsOk(memRes):
                let bytes: int64 = nodeResourceParseNvidiaVramBytes(Value(memRes))
                if bytes > 0:
                    info.vramBytes = info.vramBytes + bytes
    if info.count <= 0:
        for idx in 0..<nodeResourceMaxGpuScan:
            let idxText: str = nodeResourceInt64ToString(int64(idx))
            let vramPath: str = "/sys/class/drm/card" + idxText + "/device/mem_info_vram_total"
            let vramRes: Result[str] = nodeResourceReadFileText(vramPath, 256)
            if IsOk(vramRes):
                info.count = info.count + 1
                let bytes: int64 = nodeResourceParseFirstInt64(Value(vramRes))
                if bytes > 0:
                    info.vramBytes = info.vramBytes + bytes
                if len(info.name) <= 0:
                    let ueventPath: str = "/sys/class/drm/card" + idxText + "/device/uevent"
                    let ueventRes: Result[str] = nodeResourceReadFileText(ueventPath, 2048)
                    if IsOk(ueventRes):
                        let driver: str = nodeResourceParseLineValue(Value(ueventRes), "DRIVER")
                        if len(driver) > 0:
                            info.name = driver
    nodeResourceGpuAutoCache = info
    nodeResourceGpuAutoReady = true
    return nodeResourceGpuAutoCache

fn nodeResourceNormalizeOs(raw: str): str =
    if len(raw) <= 0:
        return ""
    if StrContains(raw, "darwin") || StrContains(raw, "Darwin") || StrContains(raw, "mac") || StrContains(raw, "Mac"):
        return "macos"
    if StrContains(raw, "linux") || StrContains(raw, "Linux"):
        return "linux"
    if StrContains(raw, "windows") || StrContains(raw, "Windows") || StrContains(raw, "win") || StrContains(raw, "Win"):
        return "windows"
    return raw

fn nodeResourceDetectOs(): str =
    if nodeResourceContext.overrides.hasOs:
        return nodeResourceContext.overrides.os
    var raw: str = nodeResourceEnv("NODE_OS")
    if len(raw) <= 0:
        raw = nodeResourceEnv("OSTYPE")
    if len(raw) <= 0:
        raw = nodeResourceEnv("OS")
    if len(raw) <= 0:
        let procRes: Result[str] = nodeResourceReadFileText("/proc/sys/kernel/ostype", 256)
        if IsOk(procRes):
            raw = Value(procRes)
    let normalized: str = nodeResourceNormalizeOs(raw)
    if len(normalized) > 0:
        return normalized
    return "unknown"

fn nodeResourceDetectCpuCores(): int32 =
    if nodeResourceContext.overrides.hasCpuCores:
        return nodeResourceContext.overrides.cpuCores
    var cores: int32
    if nodeResourceEnvInt32("CPU_CORES", cores) && cores > 0:
        return cores
    if nodeResourceEnvInt32("NUMBER_OF_PROCESSORS", cores) && cores > 0:
        return cores
    let cpuInfoRes: Result[str] = nodeResourceReadFileText("/proc/cpuinfo", 1048576)
    if IsOk(cpuInfoRes):
        let count: int32 = nodeResourceParseCpuinfoLogicalCores(Value(cpuInfoRes))
        if count > 0:
            return count
    let onlineRes: Result[str] = nodeResourceReadFileText("/sys/devices/system/cpu/online", 4096)
    if IsOk(onlineRes):
        let count: int32 = nodeResourceParseCpuOnline(Value(onlineRes))
        if count > 0:
            return count
    return 0

fn nodeResourceDetectMemoryBytes(): int64 =
    if nodeResourceContext.overrides.hasMemoryBytes:
        return nodeResourceContext.overrides.memoryBytes
    var mem: int64
    if nodeResourceEnvInt64("MEMORY_BYTES", mem) && mem > 0:
        return mem
    if nodeResourceEnvInt64("MEM_BYTES", mem) && mem > 0:
        return mem
    if nodeResourceEnvInt64("MEMORY_MB", mem) && mem > 0:
        return mem * 1024 * 1024
    let memInfoRes: Result[str] = nodeResourceReadFileText("/proc/meminfo", 65536)
    if IsOk(memInfoRes):
        let bytes: int64 = nodeResourceParseMeminfoTotalBytes(Value(memInfoRes))
        if bytes > 0:
            return bytes
    let limits: ResourceLimits = resourceLimits()
    if limits.maxMemoryBytes > 0:
        return limits.maxMemoryBytes
    return 0

fn nodeResourceDetectBandwidthInBytes(): int64 =
    if nodeResourceContext.overrides.hasBandwidthIn:
        return nodeResourceContext.overrides.bandwidthInBytes
    var bw: int64
    if nodeResourceEnvInt64("BANDWIDTH_IN_BYTES", bw) && bw > 0:
        return bw
    if nodeResourceEnvInt64("BANDWIDTH_IN_MBPS", bw) && bw > 0:
        return bw * 1024 * 1024 / 8
    let limits: ResourceLimits = resourceLimits()
    if limits.maxInboundBytes > 0:
        return limits.maxInboundBytes
    let auto: int64 = nodeResourceDetectBandwidthAutoBytes()
    if auto > 0:
        return auto
    return 0

fn nodeResourceDetectBandwidthOutBytes(): int64 =
    if nodeResourceContext.overrides.hasBandwidthOut:
        return nodeResourceContext.overrides.bandwidthOutBytes
    var bw: int64
    if nodeResourceEnvInt64("BANDWIDTH_OUT_BYTES", bw) && bw > 0:
        return bw
    if nodeResourceEnvInt64("BANDWIDTH_OUT_MBPS", bw) && bw > 0:
        return bw * 1024 * 1024 / 8
    let limits: ResourceLimits = resourceLimits()
    if limits.maxOutboundBytes > 0:
        return limits.maxOutboundBytes
    let auto: int64 = nodeResourceDetectBandwidthAutoBytes()
    if auto > 0:
        return auto
    return 0

fn nodeResourceCountCsv(text: str): int32 =
    if len(text) <= 0:
        return 0
    if (text == "none") || (text == "void") || (text == "null") || (text == "-1"):
        return 0
    var count: int32
    var tokenLen: int32
    for i in 0..len(text):
        if i == len(text) || text[i] == ',':
            if tokenLen > 0:
                count = count + 1
            tokenLen = 0
        else:
            tokenLen = tokenLen + 1
    return count

fn nodeResourceDetectGpuCount(): int32 =
    if nodeResourceContext.overrides.hasGpuCount:
        return nodeResourceContext.overrides.gpuCount
    var count: int32
    if nodeResourceEnvInt32("GPU_COUNT", count) && count > 0:
        return count
    let visible: str = nodeResourceEnv("CUDA_VISIBLE_DEVICES")
    if len(visible) > 0:
        return nodeResourceCountCsv(visible)
    let auto: NodeResourceGpuAuto = nodeResourceDetectGpuAuto()
    if auto.count > 0:
        return auto.count
    return 0

fn nodeResourceDetectGpuName(): str =
    if nodeResourceContext.overrides.hasGpuName:
        return nodeResourceContext.overrides.gpuName
    let name: str = nodeResourceEnv("GPU_NAME")
    if len(name) > 0:
        return name
    let auto: NodeResourceGpuAuto = nodeResourceDetectGpuAuto()
    return auto.name

fn nodeResourceDetectVramBytes(): int64 =
    if nodeResourceContext.overrides.hasVramBytes:
        return nodeResourceContext.overrides.vramBytes
    var vram: int64
    if nodeResourceEnvInt64("GPU_VRAM_BYTES", vram) && vram > 0:
        return vram
    if nodeResourceEnvInt64("GPU_VRAM_MB", vram) && vram > 0:
        return vram * 1024 * 1024
    let auto: NodeResourceGpuAuto = nodeResourceDetectGpuAuto()
    return auto.vramBytes

fn nodeResourceReadInt64File(path: str): int64 =
    let fileRes: Result[str] = nodeResourceReadFileText(path, 256)
    if IsErr(fileRes):
        return 0
    return nodeResourceParseFirstInt64(Value(fileRes))

@borrows
fn nodeResourceParseCpuMaxFields(text: str, quotaUs: var int64, periodUs: var int64): bool =
    if len(text) <= 0:
        return false
    var tokenStart: int32
    var firstStart: int32 = -1
    var firstEnd: int32 = -1
    var secondStart: int32 = -1
    var secondEnd: int32 = -1
    for i in 0..len(text):
        if i == len(text) || text[i] == ' ' || text[i] == '\t' || text[i] == '\n' || text[i] == '\r':
            if tokenStart < i:
                if firstStart < 0:
                    firstStart = tokenStart
                    firstEnd = i
                elif secondStart < 0:
                    secondStart = tokenStart
                    secondEnd = i
                    break
            tokenStart = i + 1
    if firstStart < 0 || secondStart < 0 || firstEnd <= firstStart || secondEnd <= secondStart:
        return false
    let firstToken: str = SliceBytes(text, firstStart, firstEnd - firstStart)
    let secondToken: str = SliceBytes(text, secondStart, secondEnd - secondStart)
    var parsedQuota: int64
    if firstToken != "max":
        let quotaRes: Result[int64] = nodeResourceParseInt64(firstToken)
        if IsErr(quotaRes):
            return false
        parsedQuota = Value(quotaRes)
    let periodRes: Result[int64] = nodeResourceParseInt64(secondToken)
    if IsErr(periodRes):
        return false
    let parsedPeriod: int64 = Value(periodRes)
    if parsedPeriod <= 0:
        return false
    quotaUs = parsedQuota
    periodUs = parsedPeriod
    return true

fn nodeResourceDetectContainerized(): bool =
    var v: bool
    if nodeResourceEnvBool("NODE_RESOURCE_CONTAINER", v):
        return v
    let cgroupRes: Result[str] = nodeResourceReadFileText("/proc/1/cgroup", 16384)
    if IsErr(cgroupRes):
        return false
    let text = strutil.toLowerAscii(Value(cgroupRes))
    if StrContains(text, "docker") || StrContains(text, "kubepods") || StrContains(text, "containerd"):
        return true
    return false

fn nodeResourceDetectPlatformKind(osKind: str): str =
    let envPlatform = strutil.toLowerAscii(strutil.strip(nodeResourceEnv("PLATFORM_KIND")))
    if len(envPlatform) > 0:
        return envPlatform
    if StrContains(osKind, "android") || StrContains(osKind, "ios"):
        return "mobile"
    var mobileHint: bool
    if nodeResourceEnvBool("IS_MOBILE", mobileHint) && mobileHint:
        return "mobile"
    if nodeResourceDetectContainerized():
        return "container"
    return "desktop"

fn nodeResourceDetectCpuMipsMeasured(): int64 =
    var mips: int64
    if nodeResourceEnvInt64("CPU_MIPS_MEASURED", mips) && mips > 0:
        return mips
    return 0

fn nodeResourceDetectNpuTopsX100(): int64 =
    var tops: int64
    if nodeResourceEnvInt64("NPU_TOPS_X100", tops) && tops > 0:
        return tops
    return 0

fn nodeResourceDetectThermalState(): str =
    let thermal = strutil.toLowerAscii(strutil.strip(nodeResourceEnv("THERMAL_STATE")))
    if len(thermal) > 0:
        return thermal
    return "nominal"

fn nodeResourceDetectBatteryPct(): int32 =
    var pct: int32
    if nodeResourceEnvInt32("BATTERY_PCT", pct):
        if pct < 0:
            return 0
        if pct > 100:
            return 100
        return pct
    return 100

fn nodeResourceDetectIsCharging(): bool =
    var v: bool
    if nodeResourceEnvBool("IS_CHARGING", v):
        return v
    return false

fn nodeResourceDetectIsScreenOff(): bool =
    var v: bool
    if nodeResourceEnvBool("IS_SCREEN_OFF", v):
        return v
    return false

fn nodeResourceDetectNetworkType(): str =
    let overrides: NodeResourceOverrides = nodeResourceContext.overrides
    if overrides.hasNetworkType:
        if len(overrides.networkType) > 0:
            return overrides.networkType
        return "unknown"
    let t = strutil.toLowerAscii(strutil.strip(nodeResourceEnv("NETWORK_TYPE")))
    if len(t) > 0:
        return t
    return "ethernet"

fn nodeResourceDetectCgroupCpuQuotaUs(): int64 =
    var v: int64
    if nodeResourceEnvInt64("CGROUP_CPU_QUOTA_US", v) && v > 0:
        return v
    let cpuMaxRes: Result[str] = nodeResourceReadFileText("/sys/fs/cgroup/cpu.max", 128)
    if IsOk(cpuMaxRes):
        var quotaUs: int64
        var periodUs: int64
        if nodeResourceParseCpuMaxFields(Value(cpuMaxRes), quotaUs, periodUs):
            if quotaUs > 0:
                return quotaUs
    let v1Quota: int64 = nodeResourceReadInt64File("/sys/fs/cgroup/cpu/cpu.cfs_quota_us")
    if v1Quota > 0:
        return v1Quota
    return 0

fn nodeResourceDetectCgroupCpuPeriodUs(): int64 =
    var v: int64
    if nodeResourceEnvInt64("CGROUP_CPU_PERIOD_US", v) && v > 0:
        return v
    let cpuMaxRes: Result[str] = nodeResourceReadFileText("/sys/fs/cgroup/cpu.max", 128)
    if IsOk(cpuMaxRes):
        var quotaUs: int64
        var periodUs: int64
        if nodeResourceParseCpuMaxFields(Value(cpuMaxRes), quotaUs, periodUs):
            if periodUs > 0:
                return periodUs
    let v1Period: int64 = nodeResourceReadInt64File("/sys/fs/cgroup/cpu/cpu.cfs_period_us")
    if v1Period > 0:
        return v1Period
    return 0

fn nodeResourceDetectCgroupMemLimitBytes(): int64 =
    var v: int64
    if nodeResourceEnvInt64("CGROUP_MEM_LIMIT_BYTES", v) && v > 0:
        return v
    let v2 = nodeResourceReadInt64File("/sys/fs/cgroup/memory.max")
    if v2 > 0:
        return v2
    return nodeResourceReadInt64File("/sys/fs/cgroup/memory/memory.limit_in_bytes")

fn nodeResourceRunMicrobench(outGflopsX100: var int64, outDurationMs: var int32) =
    var targetMs: int32 = 100
    if nodeResourceEnvInt32("MICROBENCH_DURATION_MS", targetMs):
        if targetMs < 10:
            targetMs = 10
        if targetMs > 500:
            targetMs = 500
    let startNs = EpochTimeNs()
    let deadlineNs = startNs + int64(targetMs) * 1000000
    var x: float64 = 1.0000001
    var y: float64 = 0.9999997
    var ops: float64
    while EpochTimeNs() < deadlineNs:
        for i in 0..<2048:
            x = x * 1.0000003 + y
            y = y * 0.9999991 + x
            ops = ops + 4.0
    let endNs = EpochTimeNs()
    var elapsedNs: int64 = endNs - startNs
    if elapsedNs <= 0:
        elapsedNs = 1
    outDurationMs = int32(elapsedNs / 1000000)
    let seconds = float64(elapsedNs) / 1000000000.0
    var gflopsX100: float64 = (ops / seconds) / 1000000000.0 * 100.0
    if gflopsX100 < 0.0:
        gflopsX100 = 0.0
    outGflopsX100 = int64(gflopsX100)

fn nodeResourceDetectNatType(): str =
    let nat = strutil.toLowerAscii(strutil.strip(nodeResourceEnv("NAT_TYPE")))
    if len(nat) > 0:
        return nat
    return "unknown"

fn nodeResourceDetectAskPriceCpuNano(): int64 =
    var v: int64
    if nodeResourceEnvInt64("ASK_PRICE_CPU_NANO", v) && v > 0:
        return v
    return 1000

fn nodeResourceDetectAskPriceGpuNano(): int64 =
    var v: int64
    if nodeResourceEnvInt64("ASK_PRICE_GPU_NANO", v) && v > 0:
        return v
    return 10000

fn nodeResourceDetectAskPriceIoNano(): int64 =
    var v: int64
    if nodeResourceEnvInt64("ASK_PRICE_IO_NANO", v) && v > 0:
        return v
    return 100

fn nodeResourceDetectAskWorkloadMask(): int64 =
    var v: int64
    if nodeResourceEnvInt64("ASK_WORKLOAD_MASK", v):
        if v < 0:
            return 0
        return v
    return nodeResourceWorkloadMaskAll

@borrows
fn nodeResourceMobileAcceptable(info: NodeResourceInfo): bool =
    if info.platformKind != "mobile":
        return true
    let thermal = strutil.toLowerAscii(strutil.strip(info.thermalState))
    if ! info.isCharging:
        return false
    if info.networkType != "wifi":
        return false
    if ! info.isScreenOff:
        return false
    if thermal != "nominal" && thermal != "fair":
        return false
    if info.batteryPct < 35:
        return false
    return true

fn collectNodeResourceInfo(): NodeResourceInfo =
    var info: NodeResourceInfo = initNodeResourceInfo()
    info.os = nodeResourceDetectOs()
    info.cpuCores = nodeResourceDetectCpuCores()
    info.memoryBytes = nodeResourceDetectMemoryBytes()
    info.bandwidthInBytes = nodeResourceDetectBandwidthInBytes()
    info.bandwidthOutBytes = nodeResourceDetectBandwidthOutBytes()
    info.gpuCount = nodeResourceDetectGpuCount()
    info.gpuName = nodeResourceDetectGpuName()
    info.vramBytes = nodeResourceDetectVramBytes()
    info.platformKind = nodeResourceDetectPlatformKind(info.os)
    info.cpuMipsMeasured = nodeResourceDetectCpuMipsMeasured()
    info.npuTopsX100 = nodeResourceDetectNpuTopsX100()
    info.thermalState = nodeResourceDetectThermalState()
    info.batteryPct = nodeResourceDetectBatteryPct()
    info.isCharging = nodeResourceDetectIsCharging()
    info.isScreenOff = nodeResourceDetectIsScreenOff()
    info.networkType = nodeResourceDetectNetworkType()
    info.cgroupCpuQuotaUs = nodeResourceDetectCgroupCpuQuotaUs()
    info.cgroupCpuPeriodUs = nodeResourceDetectCgroupCpuPeriodUs()
    info.cgroupMemLimitBytes = nodeResourceDetectCgroupMemLimitBytes()
    if nodeResourceDetectContainerized():
        nodeResourceRunMicrobench(info.microbenchFp32GflopsX100, info.microbenchDurationMs)
    info.natType = nodeResourceDetectNatType()
    info.askPriceCpuNano = nodeResourceDetectAskPriceCpuNano()
    info.askPriceGpuNano = nodeResourceDetectAskPriceGpuNano()
    info.askPriceIoNano = nodeResourceDetectAskPriceIoNano()
    info.askWorkloadMask = nodeResourceDetectAskWorkloadMask()
    if ! nodeResourceMobileAcceptable(info):
        info.askWorkloadMask = 0
    info.updatedAtMs = EpochTimeNs() / 1000000
    return info

fn nodeResourceRegistryUpsert(reg: var NodeResourceRegistry, peerId: str, info: NodeResourceInfo, ttlMs: int64): Result[bool] =
    let nowMs: int64 = EpochTimeNs() / 1000000
    let ttl: int64 = if ttlMs > 0: ttlMs else: nodeResourceDefaultTtlMs
    let expires: int64 = nowMs + ttl
    nodeResourceRegistryPurgeExpired(reg, nowMs)
    for i in 0..<reg.count:
        var entry: NodeResourceEntry = reg.entries[i]
        if entry.peerId == peerId:
            entry.info = info
            entry.expiresAtMs = expires
            reg.entries[i] = entry
            return Ok[bool](true)
    if reg.count >= reg.entries.len:
        setLen(reg.entries, reg.count + 1)
    if reg.count >= nodeResourceMaxEntries:
        var evictIdx: int32
        var evictExpiresAt: int64 = reg.entries[0].expiresAtMs
        for i in 1..<reg.count:
            if reg.entries[i].expiresAtMs < evictExpiresAt:
                evictExpiresAt = reg.entries[i].expiresAtMs
                evictIdx = i
        reg.entries[evictIdx] = NodeResourceEntry(peerId: peerId, info: info, expiresAtMs: expires)
        return Ok[bool](true)
    reg.entries[reg.count] = NodeResourceEntry(peerId: peerId, info: info, expiresAtMs: expires)
    reg.count = reg.count + 1
    return Ok[bool](true)

fn nodeResourceRegistryPurgeExpired(reg: var NodeResourceRegistry, nowMs: int64): int32 =
    var writeIdx: int32
    var removed: int32
    for i in 0..<reg.count:
        if reg.entries[i].expiresAtMs <= 0 || reg.entries[i].expiresAtMs > nowMs:
            if writeIdx != i:
                reg.entries[writeIdx] = reg.entries[i]
            writeIdx = writeIdx + 1
        else:
            removed = removed + 1
    reg.count = writeIdx
    return removed

fn nodeResourceUpdateSelf(peerId: str): Result[bool] =
    let info: NodeResourceInfo = collectNodeResourceInfo()
    return nodeResourceRegistryUpsert(nodeResourceContext.registry, peerId, info, nodeResourceContext.ttlMs)

fn nodeResourceUpdatePeer(peerId: str, info: NodeResourceInfo): Result[bool] =
    return nodeResourceRegistryUpsert(nodeResourceContext.registry, peerId, info, nodeResourceContext.ttlMs)

fn nodeResourceInfoCloneOwned(info: NodeResourceInfo): NodeResourceInfo =
    var c: NodeResourceInfo = initNodeResourceInfo()
    c.os = strings.CloneStr(info.os)
    c.cpuCores = int32(info.cpuCores)
    c.memoryBytes = info.memoryBytes
    c.bandwidthInBytes = info.bandwidthInBytes
    c.bandwidthOutBytes = info.bandwidthOutBytes
    c.gpuCount = int32(info.gpuCount)
    c.gpuName = strings.CloneStr(info.gpuName)
    c.vramBytes = info.vramBytes
    c.updatedAtMs = info.updatedAtMs
    c.platformKind = strings.CloneStr(info.platformKind)
    c.cpuMipsMeasured = info.cpuMipsMeasured
    c.npuTopsX100 = info.npuTopsX100
    c.thermalState = strings.CloneStr(info.thermalState)
    c.batteryPct = int32(info.batteryPct)
    c.isCharging = info.isCharging
    c.isScreenOff = info.isScreenOff
    c.networkType = strings.CloneStr(info.networkType)
    c.cgroupCpuQuotaUs = info.cgroupCpuQuotaUs
    c.cgroupCpuPeriodUs = info.cgroupCpuPeriodUs
    c.cgroupMemLimitBytes = info.cgroupMemLimitBytes
    c.microbenchFp32GflopsX100 = info.microbenchFp32GflopsX100
    c.microbenchDurationMs = int32(info.microbenchDurationMs)
    c.natType = strings.CloneStr(info.natType)
    c.askPriceCpuNano = info.askPriceCpuNano
    c.askPriceGpuNano = info.askPriceGpuNano
    c.askPriceIoNano = info.askPriceIoNano
    c.askWorkloadMask = info.askWorkloadMask
    return c

fn nodeResourceLookupPeer(peerId: str): Result[NodeResourceInfo] =
    let nowMs: int64 = EpochTimeNs() / 1000000
    nodeResourceRegistryPurgeExpired(nodeResourceContext.registry, nowMs)
    for i in 0..<nodeResourceContext.registry.count:
        var entry: NodeResourceEntry = nodeResourceContext.registry.entries[i]
        if len(entry.peerId) > 0 && entry.peerId == peerId:
            let owned: NodeResourceInfo = nodeResourceInfoCloneOwned(entry.info)
            return Ok[NodeResourceInfo](owned)
    return Err[NodeResourceInfo]("node resource: peer ! found")

fn mobileNodeResourceLookupPeer(peerId: str): Result[NodeResourceInfo] =
    return nodeResourceLookupPeer(peerId)

fn nodeResourceFindPeerIndex(peerId: str): int32 =
    let nowMs: int64 = EpochTimeNs() / 1000000
    nodeResourceRegistryPurgeExpired(nodeResourceContext.registry, nowMs)
    for i in 0..<nodeResourceContext.registry.count:
        var entry: NodeResourceEntry = nodeResourceContext.registry.entries[i]
        if len(entry.peerId) > 0 && entry.peerId == peerId:
            return i
    return -1

fn nodeResourceEntryHasData(idx: int32): bool =
    if idx < 0 || idx >= nodeResourceContext.registry.count:
        return false
    var entry: NodeResourceEntry = nodeResourceContext.registry.entries[idx]
    if len(entry.info.os) > 0:
        return true
    if entry.info.cpuCores > 0:
        return true
    if entry.info.memoryBytes > 0:
        return true
    if entry.info.bandwidthInBytes > 0 || entry.info.bandwidthOutBytes > 0:
        return true
    if entry.info.gpuCount > 0 || len(entry.info.gpuName) > 0 || entry.info.vramBytes > 0:
        return true
    if entry.info.updatedAtMs > 0:
        return true
    if len(entry.info.platformKind) > 0:
        return true
    return false

fn nodeResourceEntrySystemProfileJson(
    idx: int32,
    measuredUplinkBps: int64,
    measuredDownlinkBps: int64,
    uplinkTotalBytes: int64,
    downlinkTotalBytes: int64,
    relayBottleneckBps: int64,
    isRelayed: bool
): str =
    if idx < 0 || idx >= nodeResourceContext.registry.count:
        return ""
    var entry: NodeResourceEntry = nodeResourceContext.registry.entries[idx]
    let osName: str =
        if len(strutil.strip(entry.info.os)) > 0:
            strutil.strip(entry.info.os)
        else:
            "unknown"
    let gpuName: str =
        if len(strutil.strip(entry.info.gpuName)) > 0:
            strutil.strip(entry.info.gpuName)
        else:
            "unknown"
    let uplinkBps: int64 =
        if entry.info.bandwidthOutBytes > 0:
            entry.info.bandwidthOutBytes
        else:
            measuredUplinkBps
    let downlinkBps: int64 =
        if entry.info.bandwidthInBytes > 0:
            entry.info.bandwidthInBytes
        else:
            measuredDownlinkBps
    var out: str
    out = "{"
    out = out + "\"os\":{\"name\":\"" + osName + "\",\"version\":\"--\"}"
    out = out + ",\"cpu\":{\"cores\":" + $entry.info.cpuCores + "}"
    out = out + ",\"memory\":{\"totalBytes\":" + $entry.info.memoryBytes + "}"
    out = out + ",\"gpu\":{\"model\":\"" + gpuName + "\",\"vramBytes\":" + $entry.info.vramBytes + "}"
    out = out + ",\"networkType\":\"" + entry.info.networkType + "\""
    out = out + ",\"bandwidth\":{"
    out = out + "\"measuredUplinkBps\":" + $uplinkBps
    out = out + ",\"measuredDownlinkBps\":" + $downlinkBps
    out = out + ",\"uplinkTotalBytes\":" + $uplinkTotalBytes
    out = out + ",\"downlinkTotalBytes\":" + $downlinkTotalBytes
    out = out + ",\"totalTransferBytes\":" + $(uplinkTotalBytes + downlinkTotalBytes)
    out = out + "}}"
    return out

fn mobileNodeResourcePeerSystemProfileJson(
    peerId: str,
    measuredUplinkBps: int64,
    measuredDownlinkBps: int64,
    uplinkTotalBytes: int64,
    downlinkTotalBytes: int64,
    relayBottleneckBps: int64,
    isRelayed: bool
): str =
    let idx: int32 = nodeResourceFindPeerIndex(peerId)
    if idx < 0:
        return ""
    if !nodeResourceEntryHasData(idx):
        return ""
    return nodeResourceEntrySystemProfileJson(
        idx,
        measuredUplinkBps,
        measuredDownlinkBps,
        uplinkTotalBytes,
        downlinkTotalBytes,
        relayBottleneckBps,
        isRelayed
    )

@borrows
fn mobileNodeResourceInfoHasData(info: NodeResourceInfo): bool =
    return nodeResourceInfoHasData(info)

@borrows
fn nodeResourceSystemProfileJson(
    info: NodeResourceInfo,
    measuredUplinkBps: int64,
    measuredDownlinkBps: int64,
    uplinkTotalBytes: int64,
    downlinkTotalBytes: int64,
    relayBottleneckBps: int64,
    isRelayed: bool
): str =
    let osName: str =
        if len(strutil.strip(info.os)) > 0:
            strutil.strip(info.os)
        else:
            "unknown"
    let gpuName: str =
        if len(strutil.strip(info.gpuName)) > 0:
            strutil.strip(info.gpuName)
        else:
            "unknown"
    let uplinkBps: int64 =
        if info.bandwidthOutBytes > 0:
            info.bandwidthOutBytes
        else:
            measuredUplinkBps
    let downlinkBps: int64 =
        if info.bandwidthInBytes > 0:
            info.bandwidthInBytes
        else:
            measuredDownlinkBps
    var out: str = "{"
    out = out + "\"os\":{\"name\":\"" + osName + "\",\"version\":\"--\"}"
    out = out + ",\"cpu\":{\"model\":\"unknown\",\"frequencyMHz\":0,\"cores\":" + $info.cpuCores + "}"
    out = out + ",\"memory\":{\"totalBytes\":" + $info.memoryBytes + ",\"frequencyMHz\":0}"
    out = out + ",\"disk\":{\"type\":\"unknown\",\"totalBytes\":0,\"availableBytes\":0}"
    out = out + ",\"gpu\":{\"model\":\"" + gpuName + "\",\"vramBytes\":" + $info.vramBytes + "}"
    out = out + ",\"bandwidth\":{"
    out = out + "\"measuredUplinkBps\":" + $uplinkBps
    out = out + ",\"measuredDownlinkBps\":" + $downlinkBps
    out = out + ",\"uplinkBps\":" + $uplinkBps
    out = out + ",\"downlinkBps\":" + $downlinkBps
    out = out + ",\"uplinkTotalBytes\":" + $uplinkTotalBytes
    out = out + ",\"downlinkTotalBytes\":" + $downlinkTotalBytes
    out = out + ",\"totalTransferBytes\":" + $(uplinkTotalBytes + downlinkTotalBytes)
    out = out + ",\"relayBottleneckBps\":" + $relayBottleneckBps
    out = out + ",\"isRelayed\":" + (if isRelayed: "true" else: "false")
    out = out + "}"
    out = out + "}"
    return out

@borrows
fn mobileNodeResourceSystemProfileJson(
    info: NodeResourceInfo,
    measuredUplinkBps: int64,
    measuredDownlinkBps: int64,
    uplinkTotalBytes: int64,
    downlinkTotalBytes: int64,
    relayBottleneckBps: int64,
    isRelayed: bool
): str =
    return nodeResourceSystemProfileJson(
        info,
        measuredUplinkBps,
        measuredDownlinkBps,
        uplinkTotalBytes,
        downlinkTotalBytes,
        relayBottleneckBps,
        isRelayed
    )

fn nodeResourceSafeAddInt64(a: int64, b: int64): int64 =
    if b > 0:
        if a > nodeResourceInt64Max - b:
            return nodeResourceInt64Max
    elif b < 0:
        if a < nodeResourceInt64Min - b:
            return nodeResourceInt64Min
    return a + b

fn nodeResourcePeersWithGpuCount(): int64 =
    let nowMs: int64 = EpochTimeNs() / 1000000
    nodeResourceRegistryPurgeExpired(nodeResourceContext.registry, nowMs)
    var n: int64
    for i in 0..<nodeResourceContext.registry.count:
        var entry: NodeResourceEntry = nodeResourceContext.registry.entries[i]
        if entry.info.gpuCount > 0:
            n = n + 1
    return n

fn nodeResourceOsBreakdownJson(): str =
    let nowMs: int64 = EpochTimeNs() / 1000000
    nodeResourceRegistryPurgeExpired(nodeResourceContext.registry, nowMs)
    var names: str[]
    var counts: int32[]
    for i in 0..<nodeResourceContext.registry.count:
        var entry: NodeResourceEntry = nodeResourceContext.registry.entries[i]
        let osName: str = stdstrings.CloneStr(entry.info.os)
        if len(osName) <= 0:
            continue
        var found: int32 = -1
        for j in 0..<names.len:
            if names[j] == osName:
                found = j
                break
        if found < 0:
            add(names, osName)
            add(counts, 1)
        else:
            counts[found] = counts[found] + 1
    var out: str = "{"
    for j in 0..<names.len:
        if j > 0:
            out = out + ","
        out = out + "\"" + names[j] + "\":" + $counts[j]
    out = out + "}"
    return out

fn nodeResourceTotalsFromRegistry(reg: NodeResourceRegistry): NodeResourceTotals =
    var totals: NodeResourceTotals = initNodeResourceTotals()
    totals.nodeCount = reg.count
    for i in 0..<reg.count:
        let info: NodeResourceInfo = reg.entries[i].info
        totals.cpuCores = nodeResourceSafeAddInt64(totals.cpuCores, int64(info.cpuCores))
        totals.memoryBytes = nodeResourceSafeAddInt64(totals.memoryBytes, info.memoryBytes)
        totals.bandwidthInBytes = nodeResourceSafeAddInt64(totals.bandwidthInBytes, info.bandwidthInBytes)
        totals.bandwidthOutBytes = nodeResourceSafeAddInt64(totals.bandwidthOutBytes, info.bandwidthOutBytes)
        totals.gpuCount = nodeResourceSafeAddInt64(totals.gpuCount, int64(info.gpuCount))
        totals.vramBytes = nodeResourceSafeAddInt64(totals.vramBytes, info.vramBytes)
    return totals

fn nodeResourceTotals(): NodeResourceTotals =
    let nowMs: int64 = EpochTimeNs() / 1000000
    nodeResourceRegistryPurgeExpired(nodeResourceContext.registry, nowMs)
    return nodeResourceTotalsFromRegistry(nodeResourceContext.registry)

fn nodeResourceTotalsNodeCount(): int32 =
    let totals: NodeResourceTotals = nodeResourceTotals()
    return totals.nodeCount

fn mobileNodeResourceTotalsNodeCount(): int32 =
    return nodeResourceTotalsNodeCount()

fn nodeResourceTotalsCpuCores(): int64 =
    let totals: NodeResourceTotals = nodeResourceTotals()
    return totals.cpuCores

fn mobileNodeResourceTotalsCpuCores(): int64 =
    return nodeResourceTotalsCpuCores()

fn nodeResourceTotalsMemoryBytes(): int64 =
    let totals: NodeResourceTotals = nodeResourceTotals()
    return totals.memoryBytes

fn mobileNodeResourceTotalsMemoryBytes(): int64 =
    return nodeResourceTotalsMemoryBytes()

fn nodeResourceTotalsBandwidthInBytes(): int64 =
    let totals: NodeResourceTotals = nodeResourceTotals()
    return totals.bandwidthInBytes

fn mobileNodeResourceTotalsBandwidthInBytes(): int64 =
    return nodeResourceTotalsBandwidthInBytes()

fn nodeResourceTotalsBandwidthOutBytes(): int64 =
    let totals: NodeResourceTotals = nodeResourceTotals()
    return totals.bandwidthOutBytes

fn mobileNodeResourceTotalsBandwidthOutBytes(): int64 =
    return nodeResourceTotalsBandwidthOutBytes()

fn nodeResourceTotalsGpuCount(): int64 =
    let totals: NodeResourceTotals = nodeResourceTotals()
    return totals.gpuCount

fn nodeResourceTotalsVramBytes(): int64 =
    let totals: NodeResourceTotals = nodeResourceTotals()
    return totals.vramBytes

fn mobileNodeResourceTotalsVramBytes(): int64 =
    return nodeResourceTotalsVramBytes()

fn nodeResourceInt64ToString(value: int64): str =
    if value == 0:
        return "0"
    var v: int64 = value
    var neg: bool
    if v < 0:
        neg = true
        v = -v
    var out: str
    while v > 0: # cheng-syntax-policy: allow-counting-while
        let digit: int32 = int32(v % 10)
        let ch: char = char(int32('0') + digit)
        out = charToStr(ch) + out
        v = v / 10
    if neg:
        out = "-" + out
    return out

fn nodeResourceTotalsText(): str =
    let totals: NodeResourceTotals = nodeResourceTotals()
    var out: str
    var line: str = "nodes=" + nodeResourceInt64ToString(int64(totals.nodeCount))
    out = line
    line = "cpu_cores_total=" + nodeResourceInt64ToString(totals.cpuCores)
    out = out + "\n" + line
    line = "memory_bytes_total=" + nodeResourceInt64ToString(totals.memoryBytes)
    out = out + "\n" + line
    line = "bandwidth_in_bytes_total=" + nodeResourceInt64ToString(totals.bandwidthInBytes)
    out = out + "\n" + line
    line = "bandwidth_out_bytes_total=" + nodeResourceInt64ToString(totals.bandwidthOutBytes)
    out = out + "\n" + line
    line = "gpu_count_total=" + nodeResourceInt64ToString(totals.gpuCount)
    out = out + "\n" + line
    line = "vram_bytes_total=" + nodeResourceInt64ToString(totals.vramBytes)
    out = out + "\n" + line
    return out

fn defaultNodeResourceHandler(req: NodeResourceRequest): NodeResourceResponse =
    var resp: NodeResourceResponse = initNodeResourceResponse()
    resp.ok = true
    resp.message = "ok"
    resp.requestId = req.requestId
    resp.info = collectNodeResourceInfo()
    resp.hasInfo = true
    return resp

fn readNodeResourceRequest(stream: var Stream): Result[NodeResourceRequest] =
    let dataRes: Result[Bytes] = readLp(stream, nodeResourceContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[NodeResourceRequest](Error(dataRes))
    return decodeNodeResourceRequest(Value(dataRes))

fn writeNodeResourceRequest(stream: var Stream, req: NodeResourceRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeNodeResourceRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readNodeResourceResponse(stream: var Stream): Result[NodeResourceResponse] =
    let dataRes: Result[Bytes] = readLp(stream, nodeResourceContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[NodeResourceResponse]("node resource: read response failed")
    let decRes: Result[NodeResourceResponse] = decodeNodeResourceResponse(Value(dataRes))
    if IsErr(decRes):
        return decRes
    return decRes

fn writeNodeResourceResponse(stream: var Stream, resp: NodeResourceResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeNodeResourceResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readNodeResourceRequestConn(conn: var Connection): Result[NodeResourceRequest] =
    let dataRes: Result[Bytes] = readLp(conn, nodeResourceContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[NodeResourceRequest](Error(dataRes))
    return decodeNodeResourceRequest(Value(dataRes))

fn writeNodeResourceRequestConn(conn: var Connection, req: NodeResourceRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeNodeResourceRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(conn, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readNodeResourceResponseConn(conn: var Connection): Result[NodeResourceResponse] =
    let dataRes: Result[Bytes] = readLp(conn, nodeResourceContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[NodeResourceResponse]("node resource: read response failed")
    let decRes: Result[NodeResourceResponse] = decodeNodeResourceResponse(Value(dataRes))
    if IsErr(decRes):
        return decRes
    return decRes

fn writeNodeResourceResponseConn(conn: var Connection, resp: NodeResourceResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeNodeResourceResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(conn, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn nodeResourceHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[NodeResourceRequest] = readNodeResourceRequest(streamVar)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: NodeResourceRequest = Value(reqRes)
    var resp: NodeResourceResponse = if nodeResourceContext.hasHandler: nodeResourceContext.handler(req) else: defaultNodeResourceHandler(req)
    let writeRes: Result[bool] = writeNodeResourceResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if nodeResourceContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn nodeResourceProtocol(): Lp2pProtocol =
    return newProtocol(nodeResourceCodec, nodeResourceHandler)
