# Protocol abstraction(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/strings as stdstrings
import cheng/libp2p/muxers/muxer
type
    Lp2pProtocolHandler = fn(stream: Stream): Result[bool]

    Lp2pProtocol =
        codec: str
        handler: Lp2pProtocolHandler
        hasHandler: bool

fn newProtocol(codec: str, handler: Lp2pProtocolHandler): Lp2pProtocol =
    Lp2pProtocol(codec: codec, handler: handler, hasHandler: true)

fn newProtocolInto(proto: var Lp2pProtocol, codec: str, handler: Lp2pProtocolHandler) =
    proto.codec = codec
    proto.handler = handler
    proto.hasHandler = true

@borrows
fn protocolCodec(p: Lp2pProtocol): str =
    return stdstrings.CloneStr(p.codec)

fn run(p: Lp2pProtocol, stream: var Stream): Result[bool] =
    if ! p.hasHandler:
        return Err[bool]("protocol: missing handler")
    let owned: Stream = Stream(kind: stream.kind, muxerId: stream.muxerId, streamId: stream.streamId, initiatorLocal: stream.initiatorLocal)
    let handler: Lp2pProtocolHandler = p.handler
    return handler(owned)
