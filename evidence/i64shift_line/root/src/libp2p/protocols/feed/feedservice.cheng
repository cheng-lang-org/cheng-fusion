# Feed service protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import std/multiformats/protobuf/minprotobuf
const
    feedCodec = "/libp2p/feed/1.0.0"
    feedDefaultMaxMessage = 1048576

    feedReqTopicField = 1
    feedReqDataField = 2
    feedRespOkField = 1
    feedRespDataField = 2

type
    FeedRequest =
        topic: str
        data: Bytes

    FeedResponse =
        ok: bool
        data: Bytes

    FeedConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    FeedContext =
        config: FeedConfig
        hasHandler: bool
        handler: fn(req: FeedRequest): FeedResponse

var
    feedContext: FeedContext = FeedContext(
        config: FeedConfig(maxMessageBytes: feedDefaultMaxMessage, closeAfterResponse: true),
        hasHandler: false
    )

fn initFeedConfig(): FeedConfig =
    FeedConfig(maxMessageBytes: feedDefaultMaxMessage, closeAfterResponse: true)

fn setFeedConfig(config: FeedConfig) =
    feedContext.config = config

fn setFeedHandler(handler: fn(req: FeedRequest): FeedResponse) =
    feedContext.handler = handler
    feedContext.hasHandler = true

fn initFeedRequest(): FeedRequest =
    var req: FeedRequest
    return req

fn initFeedResponse(): FeedResponse =
    var resp: FeedResponse
    return resp

fn encodeFeedRequest(req: FeedRequest): Result[Bytes] =
    if len(req.topic) <= 0:
        return Err[Bytes]("feed: empty topic")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, feedReqTopicField, req.topic)
    if BytesLen(req.data) > 0:
        writeBytes(pb, feedReqDataField, req.data)
    return Ok[Bytes](protoToBytes(pb))

fn decodeFeedRequest(data: Bytes): Result[FeedRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: FeedRequest = initFeedRequest()
    var topicBytes: Bytes
    let topicRes: Result[bool] = protoGetBytesField(pb, feedReqTopicField, topicBytes)
    if IsErr(topicRes):
        return Err[FeedRequest](Error(topicRes))
    if Value(topicRes):
        req.topic = BytesToString(topicBytes)
    var payload: Bytes
    let dataRes: Result[bool] = protoGetBytesField(pb, feedReqDataField, payload)
    if IsErr(dataRes):
        return Err[FeedRequest](Error(dataRes))
    if Value(dataRes):
        req.data = payload
    if len(req.topic) <= 0:
        return Err[FeedRequest]("feed: empty topic")
    return Ok[FeedRequest](req)

fn encodeFeedResponse(resp: FeedResponse): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if resp.ok:
        writeVarint(pb, feedRespOkField, 1)
    if BytesLen(resp.data) > 0:
        writeBytes(pb, feedRespDataField, resp.data)
    return Ok[Bytes](protoToBytes(pb))

fn decodeFeedResponse(data: Bytes): Result[FeedResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: FeedResponse = initFeedResponse()
    var okVal: int64
    let okRes: Result[bool] = protoGetInt64Field(pb, feedRespOkField, okVal)
    if IsErr(okRes):
        return Err[FeedResponse](Error(okRes))
    if Value(okRes):
        resp.ok = okVal != 0
    var payload: Bytes = EmptyBytes()
    let dataRes: Result[bool] = protoGetBytesField(pb, feedRespDataField, payload)
    if IsErr(dataRes):
        return Err[FeedResponse](Error(dataRes))
    if Value(dataRes):
        resp.data = payload
    return Ok[FeedResponse](resp)

fn readFeedRequest(stream: var Stream): Result[FeedRequest] =
    let dataRes: Result[Bytes] = readLp(stream, feedContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[FeedRequest](Error(dataRes))
    return decodeFeedRequest(Value(dataRes))

fn writeFeedRequest(stream: var Stream, req: FeedRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeFeedRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readFeedResponse(stream: var Stream): Result[FeedResponse] =
    let dataRes: Result[Bytes] = readLp(stream, feedContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[FeedResponse](Error(dataRes))
    return decodeFeedResponse(Value(dataRes))

fn writeFeedResponse(stream: var Stream, resp: FeedResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeFeedResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultFeedHandler(req: FeedRequest): FeedResponse =
    var resp: FeedResponse
    resp.ok = true
    resp.data = BytesSlice(BytesFromString(req.topic), 0, len(req.topic))
    return resp

fn feedHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[FeedRequest] = readFeedRequest(streamVar)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: FeedRequest = Value(reqRes)
    var resp: FeedResponse = if feedContext.hasHandler: feedContext.handler(req) else: defaultFeedHandler(req)
    let writeRes: Result[bool] = writeFeedResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if feedContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn feedHandlerFn(): Lp2pProtocolHandler =
    return feedHandler

fn feedProtocol(proto: var Lp2pProtocol) =
    newProtocolInto(proto, feedCodec, feedHandler)
