# Ping protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/protocol
import cheng/libp2p/stream/lpstream
const
    pingCodec = "/ipfs/ping/1.0.0"

fn pingHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let dataRes: Result[Bytes] = readExact(streamVar, 32)
    if IsErr(dataRes):
        return Err[bool](Error(dataRes))
    let data: Bytes = Value(dataRes)
    let writeRes: Result[int32] = write(streamVar, data)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn pingHandlerFn(): Lp2pProtocolHandler =
    return pingHandler

fn pingProtocol(proto: var Lp2pProtocol) =
    newProtocolInto(proto, pingCodec, pingHandler)
