# HTTP proxy helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/http/http
type
    HttpProxy =
        hasForward: bool
        forward: fn(req: HttpRequest): Result[HttpResponse]

fn initHttpProxy(): HttpProxy =
    HttpProxy(hasForward: false)

fn setHttpProxyForward(proxy: var HttpProxy, forward: fn(req: HttpRequest): Result[HttpResponse]) =
    proxy.forward = forward
    proxy.hasForward = true

fn httpProxyHandle(proxy: HttpProxy, req: HttpRequest): Result[HttpResponse] =
    if ! proxy.hasForward:
        return Err[HttpResponse]("http proxy: missing forward")
    return proxy.forward(req)
