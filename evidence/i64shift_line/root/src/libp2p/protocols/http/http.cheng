# HTTP over libp2p(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/option
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import std/multiformats/protobuf/minprotobuf
const
    httpCodec = "/libp2p/http/1.1"
    httpDefaultMaxMessage = 4194304
    maxHttpRoutes = 32

    reqMethodField = 1
    reqPathField = 2
    reqBodyField = 3

    respStatusField = 1
    respBodyField = 2

type
    HttpRequest =
        method: str
        path: str
        body: Bytes

    HttpResponse =
        status: int32
        body: Bytes

    HttpRoute =
        path: str
        status: int32
        body: Bytes

    HttpRouter =
        count: int32
        routes: HttpRoute[maxHttpRoutes]

    HttpConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    HttpContext =
        config: HttpConfig
        hasHandler: bool
        handler: fn(req: HttpRequest): HttpResponse
        hasRouter: bool
        router: HttpRouter

var
    httpContext: HttpContext = HttpContext(
        config: HttpConfig(
            maxMessageBytes: httpDefaultMaxMessage,
            closeAfterResponse: true
        ),
        hasHandler: false,
        hasRouter: false
    )

fn initHttpConfig(): HttpConfig =
    HttpConfig(maxMessageBytes: httpDefaultMaxMessage, closeAfterResponse: true)

fn setHttpConfig(config: HttpConfig) =
    httpContext.config = config

fn initHttpRouter(): HttpRouter =
    HttpRouter(count: 0)

fn setHttpRouter(router: HttpRouter) =
    httpContext.router = router
    httpContext.hasRouter = true

fn setHttpHandler(handler: fn(req: HttpRequest): HttpResponse) =
    httpContext.handler = handler
    httpContext.hasHandler = true

fn httpRouterAddRoute(router: var HttpRouter, path: str, status: int32, body: Bytes): Result[bool] =
    if len(path) <= 0:
        return Err[bool]("http: empty route path")
    if router.count >= maxHttpRoutes:
        return Err[bool]("http: route limit")
    router.routes[router.count] = HttpRoute(path: path, status: status, body: body)
    router.count = router.count + 1
    return Ok[bool](true)

fn httpRouterFind(router: HttpRouter, path: str): Option[HttpRoute] =
    for i in 0..<router.count:
        if (router.routes[i].path == path):
            return Some[HttpRoute](router.routes[i])
    return None[HttpRoute]()

fn encodeHttpRequest(req: HttpRequest): Result[Bytes] =
    if len(req.method) <= 0:
        return Err[Bytes]("http: missing method")
    if len(req.path) <= 0:
        return Err[Bytes]("http: missing path")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, reqMethodField, req.method)
    writeString(pb, reqPathField, req.path)
    if BytesLen(req.body) > 0:
        writeBytes(pb, reqBodyField, req.body)
    return Ok[Bytes](protoToBytes(pb))

fn decodeHttpRequest(data: Bytes): Result[HttpRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: HttpRequest = HttpRequest(method: "", path: "", body: EmptyBytes())
    var method: str
    let methodRes: Result[bool] = getField(pb, reqMethodField, method)
    if IsErr(methodRes):
        return Err[HttpRequest](Error(methodRes))
    if Value(methodRes):
        req.method = method
    var path: str
    let pathRes: Result[bool] = getField(pb, reqPathField, path)
    if IsErr(pathRes):
        return Err[HttpRequest](Error(pathRes))
    if Value(pathRes):
        req.path = path
    var body: Bytes = EmptyBytes()
    let bodyRes: Result[bool] = getField(pb, reqBodyField, body)
    if IsErr(bodyRes):
        return Err[HttpRequest](Error(bodyRes))
    if Value(bodyRes):
        req.body = body
    if len(req.method) <= 0 || len(req.path) <= 0:
        return Err[HttpRequest]("http: invalid request")
    return Ok[HttpRequest](req)

fn encodeHttpResponse(resp: HttpResponse): Result[Bytes] =
    if resp.status <= 0:
        return Err[Bytes]("http: missing status")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, respStatusField, int64(resp.status))
    if BytesLen(resp.body) > 0:
        writeBytes(pb, respBodyField, resp.body)
    return Ok[Bytes](protoToBytes(pb))

fn decodeHttpResponse(data: Bytes): Result[HttpResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: HttpResponse = HttpResponse(status: 0, body: EmptyBytes())
    var statusVal: int64
    let statusRes: Result[bool] = getField(pb, respStatusField, statusVal)
    if IsErr(statusRes):
        return Err[HttpResponse](Error(statusRes))
    if Value(statusRes):
        resp.status = int32(statusVal)
    var body: Bytes = EmptyBytes()
    let bodyRes: Result[bool] = getField(pb, respBodyField, body)
    if IsErr(bodyRes):
        return Err[HttpResponse](Error(bodyRes))
    if Value(bodyRes):
        resp.body = body
    if resp.status <= 0:
        return Err[HttpResponse]("http: invalid response")
    return Ok[HttpResponse](resp)

fn readHttpRequest(stream: var Stream): Result[HttpRequest] =
    let dataRes: Result[Bytes] = readLp(stream, httpContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[HttpRequest](Error(dataRes))
    return decodeHttpRequest(Value(dataRes))

fn writeHttpRequest(stream: var Stream, req: HttpRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeHttpRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readHttpResponse(stream: var Stream): Result[HttpResponse] =
    let dataRes: Result[Bytes] = readLp(stream, httpContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[HttpResponse](Error(dataRes))
    return decodeHttpResponse(Value(dataRes))

fn writeHttpResponse(stream: var Stream, resp: HttpResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeHttpResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultHttpResponse(status: int32): HttpResponse =
    HttpResponse(status: status, body: EmptyBytes())

fn defaultHttpHandler(req: HttpRequest): HttpResponse =
    req
    return defaultHttpResponse(404)

fn routeHttpHandler(req: HttpRequest): HttpResponse =
    if httpContext.hasRouter:
        let routeOpt: Option[HttpRoute] = httpRouterFind(httpContext.router, req.path)
        if routeOpt.has:
            let route: HttpRoute = routeOpt.value
            return HttpResponse(status: route.status, body: route.body)
    return defaultHttpHandler(req)

fn httpHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[HttpRequest] = readHttpRequest(streamVar)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: HttpRequest = Value(reqRes)
    var resp: HttpResponse
    if httpContext.hasHandler:
        resp = httpContext.handler(req)
    else:
        resp = routeHttpHandler(req)
    let writeRes: Result[bool] = writeHttpResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if httpContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn httpProtocol(): Lp2pProtocol =
    return newProtocol(httpCodec, httpHandler)
