# Mix exit layer(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
const
    exitLayerTargetField = 1
    exitLayerPayloadField = 2

type
    ExitLayer =
        target: str
        payload: Bytes

fn initExitLayer(): ExitLayer =
    ExitLayer(target: "", payload: EmptyBytes())

fn encodeExitLayer(layer: ExitLayer): Result[Bytes] =
    if BytesLen(layer.payload) <= 0:
        return Err[Bytes]("mix: empty exit payload")
    var pb: ProtoBuffer = InitProtoBuffer()
    if len(layer.target) > 0:
        writeString(pb, exitLayerTargetField, layer.target)
    writeBytes(pb, exitLayerPayloadField, layer.payload)
    return Ok[Bytes](protoToBytes(pb))

fn decodeExitLayer(data: Bytes): Result[ExitLayer] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var layer: ExitLayer = initExitLayer()
    var target: str
    let targetRes: Result[bool] = getField(pb, exitLayerTargetField, target)
    if IsErr(targetRes):
        return Err[ExitLayer](Error(targetRes))
    if Value(targetRes):
        layer.target = target
    var payload: Bytes = EmptyBytes()
    let payloadRes: Result[bool] = getField(pb, exitLayerPayloadField, payload)
    if IsErr(payloadRes):
        return Err[ExitLayer](Error(payloadRes))
    if Value(payloadRes):
        layer.payload = payload
    if BytesLen(layer.payload) <= 0:
        return Err[ExitLayer]("mix: empty exit payload")
    return Ok[ExitLayer](layer)
