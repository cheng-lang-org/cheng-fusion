# Mix reply connection(minimal).

import cheng/libp2p/utils/strings
type
    ReplyConnection =
        peer: str
        open: bool

fn initReplyConnection(peer: str): ReplyConnection =
    ReplyConnection(peer: peer, open: false)

fn replyConnectionOpen(conn: var ReplyConnection): bool =
    if len(conn.peer) <= 0:
        return false
    conn.open = true
    return true

fn replyConnectionClose(conn: var ReplyConnection): bool =
    conn.open = false
    return true

fn replyConnectionIsOpen(conn: ReplyConnection): bool =
    return conn.open
