# Mix sequence number generator(minimal).

type
    SeqnoGenerator =
        current: int64

fn initSeqnoGenerator(): SeqnoGenerator =
    SeqnoGenerator(current: 0)

fn nextSeqno(gen: var SeqnoGenerator): int64 =
    gen.current = gen.current + 1
    return gen.current

fn peekSeqno(gen: SeqnoGenerator): int64 =
    return gen.current

fn resetSeqno(gen: var SeqnoGenerator) =
    gen.current = 0
