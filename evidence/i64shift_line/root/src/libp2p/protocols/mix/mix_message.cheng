# Mix message(codec length varint + codec + payload).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/varint
type
    MixMessage =
        codec: str
        payload: Bytes

fn initMixMessage(): MixMessage =
    MixMessage(codec: "", payload: EmptyBytes())

fn encodeMixMessage(msg: MixMessage): Result[Bytes] =
    let codecLen: int32 = len(msg.codec)
    let lenBytes: Bytes = encodeUVarint(codecLen)
    if BytesLen(lenBytes) <= 0 || BytesLen(lenBytes) > 2:
        return Err[Bytes]("mix: codec length exceeds 2 bytes")
    let codecBytes: Bytes = BytesFromString(msg.codec)
    return Ok[Bytes](BytesConcat3(lenBytes, codecBytes, msg.payload))

fn decodeMixMessage(data: Bytes): Result[MixMessage] =
    if BytesLen(data) <= 0:
        return Err[MixMessage]("mix: empty data")
    let varRes: Result[VarintDecoded] = decodeUVarint(data, 0)
    if IsErr(varRes):
        return Err[MixMessage](Error(varRes))
    let decoded: VarintDecoded = Value(varRes)
    let varLen: int32 = decoded.next
    if varLen <= 0 || varLen > 2:
        return Err[MixMessage]("mix: codec length varint invalid")
    let codecLen64: int64 = decoded.value
    if codecLen64 > 16383:
        return Err[MixMessage]("mix: codec length out of range")
    let codecLen: int32 = int32(codecLen64)
    let offset: int32 = varLen
    if offset + codecLen > BytesLen(data):
        return Err[MixMessage]("mix: codec truncated")
    let codecBytes: Bytes = BytesSlice(data, offset, codecLen)
    let payloadOffset: int32 = offset + codecLen
    let payloadLen: int32 = BytesLen(data) - payloadOffset
    let payload: Bytes = if payloadLen > 0: BytesSlice(data, payloadOffset, payloadLen) else: EmptyBytes()
    var msg: MixMessage = initMixMessage()
    msg.codec = BytesToString(codecBytes)
    msg.payload = payload
    return Ok[MixMessage](msg)
