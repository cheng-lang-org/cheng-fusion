# Mix multiaddr helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
type
    MixMultiAddr =
        text: str

fn parseMixMultiAddr(text: str): Result[MixMultiAddr] =
    if len(text) <= 0:
        return Err[MixMultiAddr]("mix: empty address")
    return Ok[MixMultiAddr](MixMultiAddr(text: text))

fn mixMultiAddrToString(addr: MixMultiAddr): str =
    return addr.text
