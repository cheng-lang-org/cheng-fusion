# Mix serialization helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/mix/mix_message
fn mixMessageToBytes(msg: MixMessage): Result[Bytes] =
    return encodeMixMessage(msg)

fn mixMessageFromBytes(data: Bytes): Result[MixMessage] =
    return decodeMixMessage(data)
