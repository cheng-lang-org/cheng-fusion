# Mix tag manager(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
const
    maxMixTags = 64

type
    TagManager =
        count: int32
        items: str[maxMixTags]

fn initTagManager(): TagManager =
    TagManager(count: 0)

fn tagManagerHas(manager: TagManager, tag: str): bool =
    if len(tag) <= 0:
        return false
    for i in 0..<manager.count:
        if (manager.items[i] == tag):
            return true
    return false

fn tagManagerAdd(manager: var TagManager, tag: str): Result[bool] =
    if len(tag) <= 0:
        return Err[bool]("mix: empty tag")
    if tagManagerHas(manager, tag):
        return Ok[bool](true)
    if manager.count >= maxMixTags:
        return Err[bool]("mix: tag list full")
    manager.items[manager.count] = tag
    manager.count = manager.count + 1
    return Ok[bool](true)

fn tagManagerRemove(manager: var TagManager, tag: str): bool =
    if len(tag) <= 0:
        return false
    for i in 0..<manager.count:
        if (manager.items[i] == tag):
            for j in i..<((manager.count) - 1):
                if ! (j + 1 < manager.count):
                    break
                manager.items[j] = manager.items[j + 1]
            manager.count = manager.count - 1
            return true
    return false

fn tagManagerCount(manager: TagManager): int32 =
    return manager.count
