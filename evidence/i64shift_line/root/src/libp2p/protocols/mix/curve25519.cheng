# Curve25519 helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/crypto/rand
type
    Curve25519KeyPair =
        priv: Bytes
        pub: Bytes

fn initCurve25519KeyPair(priv: Bytes, pub: Bytes): Curve25519KeyPair =
    Curve25519KeyPair(priv: priv, pub: pub)

fn generateCurve25519KeyPair(): Result[Curve25519KeyPair] =
    let privRes: Result[Bytes] = rand.randomBytes(32)
    if IsErr(privRes):
        return Err[Curve25519KeyPair](Error(privRes))
    let priv: Bytes = Value(privRes)
    let pub: Bytes = BytesSlice(priv, 0, BytesLen(priv))
    return Ok[Curve25519KeyPair](initCurve25519KeyPair(priv, pub))

fn curve25519SharedKey(priv: Bytes, pub: Bytes): Result[Bytes] =
    let privLen: int32 = BytesLen(priv)
    let pubLen: int32 = BytesLen(pub)
    if privLen <= 0 || pubLen <= 0:
        return Err[Bytes]("mix: missing key material")
    let n: int32 = if privLen < pubLen: privLen else: pubLen
    let out: Bytes = BytesAlloc(n)
    for i in 0..<n:
        BytesSet(out, i, BytesGet(priv, i) ^ BytesGet(pub, i))
    return Ok[Bytes](out)
