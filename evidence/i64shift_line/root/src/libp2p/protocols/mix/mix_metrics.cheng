# Mix metrics(minimal).

type
    MixMetrics =
        inboundCount: int64
        outboundCount: int64
        errorCount: int64

fn initMixMetrics(): MixMetrics =
    MixMetrics(inboundCount: 0, outboundCount: 0, errorCount: 0)

fn mixMetricsInbound(metrics: var MixMetrics) =
    metrics.inboundCount = metrics.inboundCount + 1

fn mixMetricsOutbound(metrics: var MixMetrics) =
    metrics.outboundCount = metrics.outboundCount + 1

fn mixMetricsError(metrics: var MixMetrics) =
    metrics.errorCount = metrics.errorCount + 1

fn resetMixMetrics(metrics: var MixMetrics) =
    metrics.inboundCount = 0
    metrics.outboundCount = 0
    metrics.errorCount = 0
