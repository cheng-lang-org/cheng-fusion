# Mix crypto helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
type
    MixKey = Bytes

fn mixEncrypt(key: MixKey, data: Bytes): Result[Bytes] =
    let keyLen: int32 = BytesLen(key)
    let dataLen: int32 = BytesLen(data)
    if keyLen <= 0:
        return Err[Bytes]("mix: empty key")
    if dataLen <= 0:
        return Ok[Bytes](EmptyBytes())
    let out: Bytes = BytesAlloc(dataLen)
    for i in 0..<dataLen:
        let kpos: int32 = i - (i / keyLen) * keyLen
        let v: int32 = BytesGet(data, i) ^ BytesGet(key, kpos)
        BytesSet(out, i, v)
    return Ok[Bytes](out)

fn mixDecrypt(key: MixKey, data: Bytes): Result[Bytes] =
    return mixEncrypt(key, data)
