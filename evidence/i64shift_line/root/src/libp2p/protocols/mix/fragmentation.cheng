# Mix fragmentation helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
const
    maxMixFragments = 32

type
    FragmentList =
        count: int32
        items: Bytes[maxMixFragments]

fn initFragmentList(): FragmentList =
    FragmentList(count: 0)

fn fragmentBytes(data: Bytes, maxSize: int32): Result[FragmentList] =
    if maxSize <= 0:
        return Err[FragmentList]("mix: invalid fragment size")
    let total: int32 = BytesLen(data)
    if total <= 0:
        return Ok[FragmentList](initFragmentList())
    var list: FragmentList = initFragmentList()
    var offset: int32
    while offset < total: # cheng-syntax-policy: allow-counting-while
        if list.count >= maxMixFragments:
            return Err[FragmentList]("mix: too many fragments")
        var size: int32 = maxSize
        if offset + size > total:
            size = total - offset
        list.items[list.count] = BytesSlice(data, offset, size)
        list.count = list.count + 1
        offset = offset + size
    return Ok[FragmentList](list)

fn defragment(list: FragmentList): Bytes =
    if list.count <= 0:
        return EmptyBytes()
    var out: Bytes = EmptyBytes()
    for i in 0..<list.count:
        if BytesLen(out) <= 0:
            out = list.items[i]
        else:
            out = BytesConcat(out, list.items[i])
    return out
