# Mix protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/mix/mix_message
const
    mixCodec = "/mix/1.0.0"
    mixDefaultMaxMessage = 1048576

type
    MixConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    MixContext =
        config: MixConfig
        hasHandler: bool
        handler: fn(msg: MixMessage): MixMessage

var
    mixContext: MixContext = MixContext(
        config: MixConfig(maxMessageBytes: mixDefaultMaxMessage, closeAfterResponse: true),
        hasHandler: false
    )

fn initMixConfig(): MixConfig =
    MixConfig(maxMessageBytes: mixDefaultMaxMessage, closeAfterResponse: true)

fn setMixConfig(config: MixConfig) =
    mixContext.config = config

fn setMixHandler(handler: fn(msg: MixMessage): MixMessage) =
    mixContext.handler = handler
    mixContext.hasHandler = true

fn readMixMessage(stream: var Stream): Result[MixMessage] =
    let dataRes: Result[Bytes] = readLp(stream, mixContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[MixMessage](Error(dataRes))
    return decodeMixMessage(Value(dataRes))

fn writeMixMessage(stream: var Stream, msg: MixMessage): Result[bool] =
    let encRes: Result[Bytes] = encodeMixMessage(msg)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultMixHandler(msg: MixMessage): MixMessage =
    var reply: MixMessage = initMixMessage()
    reply.codec = msg.codec
    reply.payload = msg.payload
    return reply

fn mixHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let msgRes: Result[MixMessage] = readMixMessage(streamVar)
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    let msg: MixMessage = Value(msgRes)
    var reply: MixMessage = if mixContext.hasHandler: mixContext.handler(msg) else: defaultMixHandler(msg)
    let writeRes: Result[bool] = writeMixMessage(streamVar, reply)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if mixContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn mixProtocol(): Lp2pProtocol =
    return newProtocol(mixCodec, mixHandler)
