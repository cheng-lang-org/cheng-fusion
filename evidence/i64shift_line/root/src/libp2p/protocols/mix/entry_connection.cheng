# Mix entry connection(minimal).

import cheng/libp2p/utils/strings
type
    EntryConnection =
        peer: str
        open: bool

fn initEntryConnection(peer: str): EntryConnection =
    EntryConnection(peer: peer, open: false)

fn entryConnectionOpen(conn: var EntryConnection): bool =
    if len(conn.peer) <= 0:
        return false
    conn.open = true
    return true

fn entryConnectionClose(conn: var EntryConnection): bool =
    conn.open = false
    return true

fn entryConnectionIsOpen(conn: EntryConnection): bool =
    return conn.open
