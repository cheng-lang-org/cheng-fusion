# Mix node state(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/mix/mix_message
import cheng/libp2p/protocols/mix/seqno_generator
import cheng/libp2p/protocols/mix/tag_manager
import cheng/libp2p/protocols/mix/mix_metrics
type
    MixNode =
        id: str
        seqgen: SeqnoGenerator
        tags: TagManager
        metrics: MixMetrics

fn initMixNode(id: str): MixNode =
    MixNode(id: id, seqgen: initSeqnoGenerator(), tags: initTagManager(), metrics: initMixMetrics())

fn mixNodeNextSeq(node: var MixNode): int64 =
    return nextSeqno(node.seqgen)

fn mixNodeAddTag(node: var MixNode, tag: str): Result[bool] =
    return tagManagerAdd(node.tags, tag)

fn mixNodeHasTag(node: MixNode, tag: str): bool =
    return tagManagerHas(node.tags, tag)

fn mixNodeBuildMessage(node: var MixNode, codec: str, payload: Bytes): Result[MixMessage] =
    if BytesLen(payload) <= 0:
        return Err[MixMessage]("mix: empty payload")
    var msg: MixMessage = initMixMessage()
    mixNodeNextSeq(node)
    msg.codec = codec
    msg.payload = payload
    return Ok[MixMessage](msg)

fn mixNodeInbound(node: var MixNode) =
    mixMetricsInbound(node.metrics)

fn mixNodeOutbound(node: var MixNode) =
    mixMetricsOutbound(node.metrics)

fn mixNodeError(node: var MixNode) =
    mixMetricsError(node.metrics)
