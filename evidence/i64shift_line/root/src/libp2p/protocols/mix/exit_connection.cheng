# Mix exit connection(minimal).

import cheng/libp2p/utils/strings
type
    ExitConnection =
        peer: str
        open: bool

fn initExitConnection(peer: str): ExitConnection =
    ExitConnection(peer: peer, open: false)

fn exitConnectionOpen(conn: var ExitConnection): bool =
    if len(conn.peer) <= 0:
        return false
    conn.open = true
    return true

fn exitConnectionClose(conn: var ExitConnection): bool =
    conn.open = false
    return true

fn exitConnectionIsOpen(conn: ExitConnection): bool =
    return conn.open
