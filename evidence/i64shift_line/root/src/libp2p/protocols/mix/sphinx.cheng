# Sphinx packet helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
const
    sphinxRouteField = 1
    sphinxPayloadField = 2

type
    SphinxPacket =
        route: str
        payload: Bytes

fn initSphinxPacket(): SphinxPacket =
    SphinxPacket(route: "", payload: EmptyBytes())

fn encodeSphinxPacket(pkt: SphinxPacket): Result[Bytes] =
    if BytesLen(pkt.payload) <= 0:
        return Err[Bytes]("sphinx: empty payload")
    var pb: ProtoBuffer = InitProtoBuffer()
    if len(pkt.route) > 0:
        writeString(pb, sphinxRouteField, pkt.route)
    writeBytes(pb, sphinxPayloadField, pkt.payload)
    return Ok[Bytes](protoToBytes(pb))

fn decodeSphinxPacket(data: Bytes): Result[SphinxPacket] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var pkt: SphinxPacket = initSphinxPacket()
    var route: str
    let routeRes: Result[bool] = getField(pb, sphinxRouteField, route)
    if IsErr(routeRes):
        return Err[SphinxPacket](Error(routeRes))
    if Value(routeRes):
        pkt.route = route
    var payload: Bytes = EmptyBytes()
    let payloadRes: Result[bool] = getField(pb, sphinxPayloadField, payload)
    if IsErr(payloadRes):
        return Err[SphinxPacket](Error(payloadRes))
    if Value(payloadRes):
        pkt.payload = payload
    if BytesLen(pkt.payload) <= 0:
        return Err[SphinxPacket]("sphinx: empty payload")
    return Ok[SphinxPacket](pkt)
