# AutoNAT v2 service(minimal).

import cheng/libp2p/protocols/connectivity/autonatv2/types
import cheng/libp2p/protocols/connectivity/autonatv2/utils

type
    Autonatv2Config =
        maxMessageBytes: int32
        closeAfterResponse: bool

    Autonatv2Handler = fn(req: Autonatv2Request): Autonatv2Response

var
    autonatv2Config: Autonatv2Config = Autonatv2Config(
        maxMessageBytes: autonatv2DefaultMaxMessage,
        closeAfterResponse: true
    )
    autonatv2HasHandler: bool
    autonatv2HandlerImpl: Autonatv2Handler

fn initAutonatv2Config(): Autonatv2Config =
    Autonatv2Config(maxMessageBytes: autonatv2DefaultMaxMessage, closeAfterResponse: true)

fn setAutonatv2Config(cfg: Autonatv2Config) =
    autonatv2Config = cfg

fn getAutonatv2Config(): Autonatv2Config =
    autonatv2Config

fn setAutonatv2Handler(handler: Autonatv2Handler) =
    autonatv2HasHandler = true
    autonatv2HandlerImpl = handler

fn autonatv2ServiceResponse(req: Autonatv2Request): Autonatv2Response =
    if autonatv2HasHandler:
        return autonatv2HandlerImpl(req)
    return autonatv2DefaultResponse(req)
