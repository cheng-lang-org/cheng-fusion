# AutoNAT v2 client helpers(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/connectivity/autonatv2/types
fn autonatv2ProbeStream(stream: var Stream, req: Autonatv2Request): Result[Autonatv2Response] =
    let writeRes: Result[bool] = writeAutonatv2Request(stream, req)
    if IsErr(writeRes):
        return Err[Autonatv2Response](Error(writeRes))
    let respRes: Result[Autonatv2Response] = readAutonatv2Response(stream, autonatv2MaxMessage)
    if IsErr(respRes):
        return Err[Autonatv2Response](Error(respRes))
    let resp: Autonatv2Response = Value(respRes)
    if resp.status != an2Ok:
        if resp.hasText:
            return Err[Autonatv2Response](resp.text)
        return Err[Autonatv2Response]("autonatv2: probe failed")
    return Ok[Autonatv2Response](resp)
