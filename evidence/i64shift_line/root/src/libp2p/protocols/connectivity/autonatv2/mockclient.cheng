# AutoNAT v2 mock client.

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/connectivity/autonatv2/types
var
    autonatv2MockResponse: Autonatv2Response = initAutonatv2Response()
    autonatv2MockHasResponse: bool

fn setAutonatv2MockResponse(resp: Autonatv2Response) =
    autonatv2MockResponse = resp
    autonatv2MockHasResponse = true

fn autonatv2MockProbe(req: Autonatv2Request): Result[Autonatv2Response] =
    req
    if ! autonatv2MockHasResponse:
        return Err[Autonatv2Response]("autonatv2: mock response missing")
    return Ok[Autonatv2Response](autonatv2MockResponse)
