# AutoNAT v2 mock server.

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/connectivity/autonatv2/types
var
    autonatv2MockServerResponse: Autonatv2Response = initAutonatv2Response()
    autonatv2MockServerHasResponse: bool

fn setAutonatv2MockServerResponse(resp: Autonatv2Response) =
    autonatv2MockServerResponse = resp
    autonatv2MockServerHasResponse = true

fn autonatv2MockServerHandle(req: Autonatv2Request): Result[Autonatv2Response] =
    req
    if ! autonatv2MockServerHasResponse:
        return Err[Autonatv2Response]("autonatv2: mock server response missing")
    return Ok[Autonatv2Response](autonatv2MockServerResponse)
