# AutoNAT v2 server protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/connectivity/autonatv2/types
import cheng/libp2p/protocols/connectivity/autonatv2/service as autonatv2service
fn autonatv2Handler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let cfg: Autonatv2Config = getAutonatv2Config()
    let reqRes: Result[Autonatv2Request] = readAutonatv2Request(streamVar, cfg.maxMessageBytes)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: Autonatv2Request = Value(reqRes)
    let resp: Autonatv2Response = autonatv2ServiceResponse(req)
    let writeRes: Result[bool] = writeAutonatv2Response(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if cfg.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn autonatv2Protocol(): Lp2pProtocol =
    return newProtocol(autonatv2Codec, autonatv2Handler)
