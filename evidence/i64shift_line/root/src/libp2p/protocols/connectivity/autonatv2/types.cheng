# AutoNAT v2 types(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/multiaddrlist
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/stream/lpstream
const
    autonatv2Codec = "/libp2p/autonat/2.0.0"
    autonatv2MaxMessage = 1048576

    autonatv2ReqPeerField = 1
    autonatv2ReqAddrField = 2

    autonatv2RespStatusField = 1
    autonatv2RespAddrField = 2
    autonatv2RespTextField = 3

    autonatv2MaxControlBytes = 4096

type
    Autonatv2Status = enum
        an2Ok = 0
        an2DialError = 1
        an2Rejected = 2
        an2Internal = 3

    Autonatv2Request =
        hasPeerId: bool
        peerId: PeerId
        addrs: MultiAddressList

    Autonatv2Response =
        status: Autonatv2Status
        hasAddr: bool
        observedAddr: MultiAddress
        hasText: bool
        text: str

fn initAutonatv2Request(): Autonatv2Request =
    Autonatv2Request(hasPeerId: false, addrs: initMultiAddressList())

fn initAutonatv2Response(): Autonatv2Response =
    Autonatv2Response(status: an2Internal, hasAddr: false, hasText: false, text: "")

fn encodeAutonatv2Request(req: Autonatv2Request): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if req.hasPeerId:
        writeString(pb, autonatv2ReqPeerField, peerid.toString(req.peerId))
    for i in 0..<req.addrs.count:
        writeBytes(pb, autonatv2ReqAddrField, req.addrs.items[i].data)
    return Ok[Bytes](protoToBytes(pb))

fn decodeAutonatv2Request(data: Bytes): Result[Autonatv2Request] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: Autonatv2Request = initAutonatv2Request()
    var peerText: str
    let peerRes: Result[bool] = getField(pb, autonatv2ReqPeerField, peerText)
    if IsErr(peerRes):
        return Err[Autonatv2Request](Error(peerRes))
    if Value(peerRes):
        let pidRes: Result[PeerId] = parsePeerId(peerText)
        if IsErr(pidRes):
            return Err[Autonatv2Request](Error(pidRes))
        req.hasPeerId = true
        req.peerId = Value(pidRes)
    var addrList: RepeatedBytes = initRepeatedBytes()
    let addrRes: Result[bool] = getRepeatedField(pb, autonatv2ReqAddrField, addrList)
    if IsErr(addrRes):
        return Err[Autonatv2Request](Error(addrRes))
    if Value(addrRes):
        for i in 0..<addrList.count:
            let parseRes: Result[MultiAddress] = parseMultiAddressBytes(addrList.items[i])
            if IsErr(parseRes):
                return Err[Autonatv2Request](Error(parseRes))
            let addRes: Result[bool] = multiAddressListAdd(req.addrs, Value(parseRes))
            if IsErr(addRes):
                return Err[Autonatv2Request](Error(addRes))
    return Ok[Autonatv2Request](req)

fn encodeAutonatv2Response(resp: Autonatv2Response): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, autonatv2RespStatusField, int64(resp.status))
    if resp.hasAddr:
        writeBytes(pb, autonatv2RespAddrField, resp.observedAddr.data)
    if resp.hasText:
        writeString(pb, autonatv2RespTextField, resp.text)
    return Ok[Bytes](protoToBytes(pb))

fn decodeAutonatv2Response(data: Bytes): Result[Autonatv2Response] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: Autonatv2Response = initAutonatv2Response()
    var statusVal: int64 = -1
    let statusRes: Result[bool] = getField(pb, autonatv2RespStatusField, statusVal)
    if IsErr(statusRes):
        return Err[Autonatv2Response](Error(statusRes))
    if ! Value(statusRes):
        return Err[Autonatv2Response]("autonatv2: missing status")
    if statusVal < 0 || statusVal > 3:
        return Err[Autonatv2Response]("autonatv2: invalid status")
    resp.status = Autonatv2Status(statusVal)
    var addrBytes: Bytes = EmptyBytes()
    let addrRes: Result[bool] = getField(pb, autonatv2RespAddrField, addrBytes)
    if IsErr(addrRes):
        return Err[Autonatv2Response](Error(addrRes))
    if Value(addrRes):
        let parseRes: Result[MultiAddress] = parseMultiAddressBytes(addrBytes)
        if IsErr(parseRes):
            return Err[Autonatv2Response](Error(parseRes))
        resp.hasAddr = true
        resp.observedAddr = Value(parseRes)
    var textVal: str
    let textRes: Result[bool] = getField(pb, autonatv2RespTextField, textVal)
    if IsErr(textRes):
        return Err[Autonatv2Response](Error(textRes))
    if Value(textRes):
        resp.hasText = true
        resp.text = textVal
    return Ok[Autonatv2Response](resp)

fn readAutonatv2Request(stream: var Stream, maxBytes: int32): Result[Autonatv2Request] =
    let limit: int32 = if maxBytes > 0: maxBytes else: autonatv2MaxMessage
    let dataRes: Result[Bytes] = readLp(stream, limit)
    if IsErr(dataRes):
        return Err[Autonatv2Request](Error(dataRes))
    return decodeAutonatv2Request(Value(dataRes))

fn writeAutonatv2Request(stream: var Stream, req: Autonatv2Request): Result[bool] =
    let encRes: Result[Bytes] = encodeAutonatv2Request(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readAutonatv2Response(stream: var Stream, maxBytes: int32): Result[Autonatv2Response] =
    let limit: int32 = if maxBytes > 0: maxBytes else: autonatv2MaxMessage
    let dataRes: Result[Bytes] = readLp(stream, limit)
    if IsErr(dataRes):
        return Err[Autonatv2Response](Error(dataRes))
    return decodeAutonatv2Response(Value(dataRes))

fn writeAutonatv2Response(stream: var Stream, resp: Autonatv2Response): Result[bool] =
    let encRes: Result[Bytes] = encodeAutonatv2Response(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)
