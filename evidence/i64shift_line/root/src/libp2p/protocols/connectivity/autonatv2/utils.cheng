# AutoNAT v2 helpers(minimal).

import cheng/libp2p/protocols/connectivity/autonatv2/types
const
    autonatv2DefaultMaxMessage = 1048576

fn autonatv2StatusText(status: Autonatv2Status): str =
    if status == an2Ok:
        return "ok"
    if status == an2DialError:
        return "dial_error"
    if status == an2Rejected:
        return "rejected"
    return "internal"

fn autonatv2DefaultResponse(req: Autonatv2Request): Autonatv2Response =
    var resp: Autonatv2Response = initAutonatv2Response()
    if req.addrs.count <= 0:
        resp.status = an2DialError
        resp.hasText = true
        resp.text = "autonatv2: no address"
        return resp
    resp.status = an2Ok
    resp.hasAddr = true
    resp.observedAddr = req.addrs.items[0]
    resp.hasText = true
    resp.text = "ok"
    return resp
