# AutoNAT v2 mock helpers.

import cheng/libp2p/protocols/connectivity/autonatv2/types
import cheng/libp2p/utils/strings
fn mockAutonatv2Response(status: Autonatv2Status, addr: MultiAddress, text: str): Autonatv2Response =
    var resp: Autonatv2Response = initAutonatv2Response()
    resp.status = status
    if len(text) > 0:
        resp.hasText = true
        resp.text = text
    if len(lpMultiAddressToString(addr)) > 0:
        resp.hasAddr = true
        resp.observedAddr = addr
    return resp
