# AutoNAT client helpers(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/connectivity/autonat/types
fn autonatProbeStream(stream: var Stream, req: AutonatDialRequest): Result[AutonatDialResponse] =
    let writeRes: Result[bool] = writeAutonatDialRequest(stream, req)
    if IsErr(writeRes):
        return Err[AutonatDialResponse](Error(writeRes))
    let respRes: Result[AutonatDialResponse] = readAutonatDialResponse(stream, autonatMaxMessage)
    if IsErr(respRes):
        return Err[AutonatDialResponse](Error(respRes))
    let resp: AutonatDialResponse = Value(respRes)
    if resp.status != anOk:
        if resp.hasText:
            return Err[AutonatDialResponse](resp.text)
        return Err[AutonatDialResponse]("autonat: probe failed")
    return Ok[AutonatDialResponse](resp)
