# AutoNAT service state(minimal).

import cheng/libp2p/protocols/connectivity/autonat/types
const
    autonatDefaultMaxMessage = 1048576

type
    AutonatConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    AutonatHandler = fn(req: AutonatDialRequest): AutonatDialResponse

    AutonatService =
        config: AutonatConfig
        hasHandler: bool
        handler: AutonatHandler

var
    autonatService: AutonatService = AutonatService(
        config: AutonatConfig(
            maxMessageBytes: autonatDefaultMaxMessage,
            closeAfterResponse: true
        ),
        hasHandler: false
    )

fn initAutonatConfig(): AutonatConfig =
    AutonatConfig(maxMessageBytes: autonatDefaultMaxMessage, closeAfterResponse: true)

fn setAutonatConfig(config: AutonatConfig) =
    autonatService.config = config

fn getAutonatConfig(): AutonatConfig =
    autonatService.config

fn setAutonatHandler(handler: AutonatHandler) =
    autonatService.handler = handler
    autonatService.hasHandler = true

fn autonatDefaultResponse(req: AutonatDialRequest): AutonatDialResponse =
    var resp: AutonatDialResponse = initAutonatDialResponse()
    if req.addrs.count <= 0:
        resp.status = anDialError
        resp.hasText = true
        resp.text = "autonat: no address"
        return resp
    resp.status = anOk
    resp.hasAddr = true
    resp.observedAddr = req.addrs.items[0]
    resp.hasText = true
    resp.text = "ok"
    return resp

fn autonatServiceResponse(req: AutonatDialRequest): AutonatDialResponse =
    if autonatService.hasHandler:
        return autonatService.handler(req)
    return autonatDefaultResponse(req)
