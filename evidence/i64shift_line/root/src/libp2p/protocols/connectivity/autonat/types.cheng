# AutoNAT protocol types(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/multiaddrlist
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/stream/lpstream
const
    autonatCodec = "/libp2p/autonat/1.0.0"
    autonatMaxMessage = 1048576

    autonatReqPeerField = 1
    autonatReqAddrField = 2

    autonatRespStatusField = 1
    autonatRespAddrField = 2
    autonatRespTextField = 3

    autonatMaxControlBytes = 4096

type
    AutonatResponseStatus = enum
        anOk = 0
        anDialError = 1
        anRejected = 2
        anInternal = 3

    AutonatDialRequest =
        hasPeerId: bool
        peerId: PeerId
        addrs: MultiAddressList

    AutonatDialResponse =
        status: AutonatResponseStatus
        hasAddr: bool
        observedAddr: MultiAddress
        hasText: bool
        text: str

fn initAutonatDialRequest(): AutonatDialRequest =
    AutonatDialRequest(hasPeerId: false, addrs: initMultiAddressList())

fn initAutonatDialResponse(): AutonatDialResponse =
    AutonatDialResponse(status: anInternal, hasAddr: false, hasText: false, text: "")

fn autonatStatusText(status: AutonatResponseStatus): str =
    if status == anOk:
        return "ok"
    if status == anDialError:
        return "dial_error"
    if status == anRejected:
        return "rejected"
    return "internal"

fn encodeAutonatDialRequest(req: AutonatDialRequest): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if req.hasPeerId:
        writeString(pb, autonatReqPeerField, peerid.toString(req.peerId))
    for i in 0..<req.addrs.count:
        writeBytes(pb, autonatReqAddrField, req.addrs.items[i].data)
    return Ok[Bytes](protoToBytes(pb))

fn decodeAutonatDialRequest(data: Bytes): Result[AutonatDialRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: AutonatDialRequest = initAutonatDialRequest()
    var peerText: str
    let peerRes: Result[bool] = getField(pb, autonatReqPeerField, peerText)
    if IsErr(peerRes):
        return Err[AutonatDialRequest](Error(peerRes))
    if Value(peerRes):
        let pidRes: Result[PeerId] = parsePeerId(peerText)
        if IsErr(pidRes):
            return Err[AutonatDialRequest](Error(pidRes))
        req.hasPeerId = true
        req.peerId = Value(pidRes)
    var addrList: RepeatedBytes = initRepeatedBytes()
    let addrRes: Result[bool] = getRepeatedField(pb, autonatReqAddrField, addrList)
    if IsErr(addrRes):
        return Err[AutonatDialRequest](Error(addrRes))
    if Value(addrRes):
        for i in 0..<addrList.count:
            let parseRes: Result[MultiAddress] = parseMultiAddressBytes(addrList.items[i])
            if IsErr(parseRes):
                return Err[AutonatDialRequest](Error(parseRes))
            let addRes: Result[bool] = multiAddressListAdd(req.addrs, Value(parseRes))
            if IsErr(addRes):
                return Err[AutonatDialRequest](Error(addRes))
    return Ok[AutonatDialRequest](req)

fn encodeAutonatDialResponse(resp: AutonatDialResponse): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, autonatRespStatusField, int64(resp.status))
    if resp.hasAddr:
        writeBytes(pb, autonatRespAddrField, resp.observedAddr.data)
    if resp.hasText:
        writeString(pb, autonatRespTextField, resp.text)
    return Ok[Bytes](protoToBytes(pb))

fn decodeAutonatDialResponse(data: Bytes): Result[AutonatDialResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: AutonatDialResponse = initAutonatDialResponse()
    var statusVal: int64 = -1
    let statusRes: Result[bool] = getField(pb, autonatRespStatusField, statusVal)
    if IsErr(statusRes):
        return Err[AutonatDialResponse](Error(statusRes))
    if ! Value(statusRes):
        return Err[AutonatDialResponse]("autonat: missing status")
    if statusVal < 0 || statusVal > 3:
        return Err[AutonatDialResponse]("autonat: invalid status")
    resp.status = AutonatResponseStatus(statusVal)
    var addrBytes: Bytes = EmptyBytes()
    let addrRes: Result[bool] = getField(pb, autonatRespAddrField, addrBytes)
    if IsErr(addrRes):
        return Err[AutonatDialResponse](Error(addrRes))
    if Value(addrRes):
        let parseRes: Result[MultiAddress] = parseMultiAddressBytes(addrBytes)
        if IsErr(parseRes):
            return Err[AutonatDialResponse](Error(parseRes))
        resp.hasAddr = true
        resp.observedAddr = Value(parseRes)
    var textVal: str
    let textRes: Result[bool] = getField(pb, autonatRespTextField, textVal)
    if IsErr(textRes):
        return Err[AutonatDialResponse](Error(textRes))
    if Value(textRes):
        resp.hasText = true
        resp.text = textVal
    return Ok[AutonatDialResponse](resp)

fn readAutonatDialRequest(stream: var Stream, maxBytes: int32): Result[AutonatDialRequest] =
    let limit: int32 = if maxBytes > 0: maxBytes else: autonatMaxMessage
    let dataRes: Result[Bytes] = readLp(stream, limit)
    if IsErr(dataRes):
        return Err[AutonatDialRequest](Error(dataRes))
    return decodeAutonatDialRequest(Value(dataRes))

fn writeAutonatDialRequest(stream: var Stream, req: AutonatDialRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeAutonatDialRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readAutonatDialResponse(stream: var Stream, maxBytes: int32): Result[AutonatDialResponse] =
    let limit: int32 = if maxBytes > 0: maxBytes else: autonatMaxMessage
    let dataRes: Result[Bytes] = readLp(stream, limit)
    if IsErr(dataRes):
        return Err[AutonatDialResponse](Error(dataRes))
    return decodeAutonatDialResponse(Value(dataRes))

fn writeAutonatDialResponse(stream: var Stream, resp: AutonatDialResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeAutonatDialResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)
