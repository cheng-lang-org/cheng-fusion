# AutoNAT server protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/connectivity/autonat/types
import cheng/libp2p/protocols/connectivity/autonat/service as autonatservice
fn autonatHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let cfg: AutonatConfig = getAutonatConfig()
    let reqRes: Result[AutonatDialRequest] = readAutonatDialRequest(streamVar, cfg.maxMessageBytes)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: AutonatDialRequest = Value(reqRes)
    let resp: AutonatDialResponse = autonatServiceResponse(req)
    let writeRes: Result[bool] = writeAutonatDialResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if cfg.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn autonatProtocol(): Lp2pProtocol =
    return newProtocol(autonatCodec, autonatHandler)
