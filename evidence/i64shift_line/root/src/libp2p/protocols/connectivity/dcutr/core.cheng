# DCUtR protocol core(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/multiaddrlist
import cheng/libp2p/multiaddress
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/stream/lpstream
const
    dcutrCodec = "/libp2p/dcutr/1.0.0"
    dcutrMaxMessage = 1048576
    dcutrMaxControlBytes = 4096

    dcutrReqAddrField = 1
    dcutrRespStatusField = 1
    dcutrRespTextField = 2


type
    DcutrStatus = enum
        dcutrOk = 0
        dcutrError = 1

    DcutrRequest =
        addrs: MultiAddressList

    DcutrResponse =
        status: DcutrStatus
        hasText: bool
        text: str

fn initDcutrRequest(): DcutrRequest =
    DcutrRequest(addrs: initMultiAddressList())

fn initDcutrResponse(): DcutrResponse =
    DcutrResponse(status: dcutrError, hasText: false, text: "")

fn encodeDcutrRequest(req: DcutrRequest): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    for i in 0..<req.addrs.count:
        writeBytes(pb, dcutrReqAddrField, req.addrs.items[i].data)
    return protoToBytes(pb)

fn decodeDcutrRequest(data: Bytes): Result[DcutrRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: DcutrRequest = initDcutrRequest()
    var addrList: RepeatedBytes = initRepeatedBytes()
    let addrRes: Result[bool] = getRepeatedField(pb, dcutrReqAddrField, addrList)
    if IsErr(addrRes):
        return Err[DcutrRequest](Error(addrRes))
    if Value(addrRes):
        for i in 0..<addrList.count:
            let parseRes: Result[MultiAddress] = parseMultiAddressBytes(addrList.items[i])
            if IsErr(parseRes):
                return Err[DcutrRequest](Error(parseRes))
            let addRes: Result[bool] = multiAddressListAdd(req.addrs, Value(parseRes))
            if IsErr(addRes):
                return Err[DcutrRequest](Error(addRes))
    return Ok[DcutrRequest](req)

fn encodeDcutrResponse(resp: DcutrResponse): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, dcutrRespStatusField, int64(resp.status))
    if resp.hasText:
        writeString(pb, dcutrRespTextField, resp.text)
    return protoToBytes(pb)

fn decodeDcutrResponse(data: Bytes): Result[DcutrResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: DcutrResponse = initDcutrResponse()
    var statusVal: int64 = -1
    let statusRes: Result[bool] = getField(pb, dcutrRespStatusField, statusVal)
    if IsErr(statusRes):
        return Err[DcutrResponse](Error(statusRes))
    if ! Value(statusRes):
        return Err[DcutrResponse]("dcutr: missing status")
    if statusVal < 0 || statusVal > 1:
        return Err[DcutrResponse]("dcutr: invalid status")
    resp.status = DcutrStatus(statusVal)
    var textVal: str
    let textRes: Result[bool] = getField(pb, dcutrRespTextField, textVal)
    if IsErr(textRes):
        return Err[DcutrResponse](Error(textRes))
    if Value(textRes):
        resp.hasText = true
        resp.text = textVal
    let outResp: DcutrResponse = resp
    return Ok[DcutrResponse](outResp)

fn readDcutrRequest(stream: var Stream, maxBytes: int32): Result[DcutrRequest] =
    let limit: int32 = if maxBytes > 0: maxBytes else: dcutrMaxMessage
    let dataRes: Result[Bytes] = readLp(stream, limit)
    if IsErr(dataRes):
        return Err[DcutrRequest](Error(dataRes))
    return decodeDcutrRequest(Value(dataRes))

fn writeDcutrRequest(stream: var Stream, req: DcutrRequest): Result[bool] =
    let payload: Bytes = encodeDcutrRequest(req)
    let writeRes: Result[int32] = writeLp(stream, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readDcutrResponse(stream: var Stream, maxBytes: int32): Result[DcutrResponse] =
    let limit: int32 = if maxBytes > 0: maxBytes else: dcutrMaxMessage
    let dataRes: Result[Bytes] = readLp(stream, limit)
    if IsErr(dataRes):
        return Err[DcutrResponse](Error(dataRes))
    return decodeDcutrResponse(Value(dataRes))

fn writeDcutrResponse(stream: var Stream, resp: DcutrResponse): Result[bool] =
    let payload: Bytes = encodeDcutrResponse(resp)
    let writeRes: Result[int32] = writeLp(stream, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)
