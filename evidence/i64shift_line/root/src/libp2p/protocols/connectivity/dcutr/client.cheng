# DCUtR client helpers(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/connectivity/dcutr/core
fn dcutrRequestStream(stream: var Stream, req: DcutrRequest): Result[DcutrResponse] =
    let writeRes: Result[bool] = writeDcutrRequest(stream, req)
    if IsErr(writeRes):
        return Err[DcutrResponse](Error(writeRes))
    let respRes: Result[DcutrResponse] = readDcutrResponse(stream, dcutrMaxMessage)
    if IsErr(respRes):
        return Err[DcutrResponse](Error(respRes))
    return respRes
