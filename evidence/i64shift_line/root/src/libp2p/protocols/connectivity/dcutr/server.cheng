# DCUtR server(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/connectivity/dcutr/core
const
    dcutrDefaultMaxMessage = 1048576

type
    DcutrConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    DcutrHandler = fn(req: DcutrRequest): DcutrResponse

var
    dcutrConfig: DcutrConfig = DcutrConfig(maxMessageBytes: dcutrDefaultMaxMessage, closeAfterResponse: true)
    dcutrHasHandler: bool
    dcutrHandlerImpl: DcutrHandler

fn initDcutrConfig(): DcutrConfig =
    DcutrConfig(maxMessageBytes: dcutrDefaultMaxMessage, closeAfterResponse: true)

fn setDcutrConfig(cfg: DcutrConfig) =
    dcutrConfig = cfg

fn getDcutrConfig(): DcutrConfig =
    dcutrConfig

fn setDcutrHandler(handler: DcutrHandler) =
    dcutrHasHandler = true
    dcutrHandlerImpl = handler

fn dcutrDefaultResponse(req: DcutrRequest): DcutrResponse =
    var resp: DcutrResponse = initDcutrResponse()
    if req.addrs.count <= 0:
        resp.status = dcutrError
        resp.hasText = true
        resp.text = "dcutr: no address"
        return resp
    resp.status = dcutrOk
    resp.hasText = true
    resp.text = "ok"
    return resp

fn dcutrHandleRequest(req: DcutrRequest): DcutrResponse =
    if dcutrHasHandler:
        return dcutrHandlerImpl(req)
    return dcutrDefaultResponse(req)

fn dcutrHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[DcutrRequest] = readDcutrRequest(streamVar, dcutrConfig.maxMessageBytes)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: DcutrRequest = Value(reqRes)
    let resp: DcutrResponse = dcutrHandleRequest(req)
    let writeRes: Result[bool] = writeDcutrResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if dcutrConfig.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn dcutrProtocol(): Lp2pProtocol =
    return newProtocol(dcutrCodec, dcutrHandler)
