# Relay protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/connectivity/relay/messages
import cheng/libp2p/protocols/connectivity/relay/utils
var
    relayConfig: RelayConfig = initRelayConfig()
    relayState: RelayState = initRelayState()

fn setRelayConfig(cfg: RelayConfig) =
    relayConfig = cfg

fn getRelayConfig(): RelayConfig =
    relayConfig

fn setRelayState(state: RelayState) =
    relayState = state

fn getRelayState(): RelayState =
    relayState

fn relayReply(stream: var Stream, msg: RelayMessage): Result[bool] =
    let payload: Bytes = encodeRelayMessage(msg)
    let writeRes: Result[int32] = writeLp(stream, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn relayHandleReserve(stream: var Stream, msg: RelayMessage): Result[bool] =
    if ! msg.hasSrc:
        var resp: RelayMessage = initRelayMessage()
        resp.msgType = relayReserveResponse
        resp.hasStatus = true
        resp.status = relayInvalid
        resp.hasText = true
        resp.text = "relay: missing src"
        return relayReply(stream, resp)
    let ttlRes: Result[int64] = relayClampTtl(relayConfig, msg.ttlSeconds, msg.hasTtl)
    if IsErr(ttlRes):
        var resp: RelayMessage = initRelayMessage()
        resp.msgType = relayReserveResponse
        resp.hasStatus = true
        resp.status = relayInvalid
        resp.hasText = true
        resp.text = Error(ttlRes)
        return relayReply(stream, resp)
    let tokenRes: Result[Bytes] = relayTokenFromPeer(msg.srcPeer)
    if IsErr(tokenRes):
        var resp: RelayMessage = initRelayMessage()
        resp.msgType = relayReserveResponse
        resp.hasStatus = true
        resp.status = relayError
        resp.hasText = true
        resp.text = Error(tokenRes)
        return relayReply(stream, resp)
    let upsertRes: Result[RelayReservation] = relayUpsertReservation(relayState, msg.srcPeer, Value(tokenRes), Value(ttlRes))
    if IsErr(upsertRes):
        var resp: RelayMessage = initRelayMessage()
        resp.msgType = relayReserveResponse
        resp.hasStatus = true
        resp.status = relayError
        resp.hasText = true
        resp.text = Error(upsertRes)
        return relayReply(stream, resp)
    var resp: RelayMessage = initRelayMessage()
    resp.msgType = relayReserveResponse
    resp.hasStatus = true
    resp.status = relayOk
    resp.hasToken = true
    resp.token = Value(tokenRes)
    resp.hasTtl = true
    resp.ttlSeconds = Value(ttlRes)
    return relayReply(stream, resp)

fn relayHandleConnect(stream: var Stream, msg: RelayMessage): Result[bool] =
    if ! msg.hasDst:
        var resp: RelayMessage = initRelayMessage()
        resp.msgType = relayConnectResponse
        resp.hasStatus = true
        resp.status = relayInvalid
        resp.hasText = true
        resp.text = "relay: missing dst"
        return relayReply(stream, resp)
    let resvRes: Result[RelayReservation] = relayGetReservation(relayState, msg.dstPeer)
    if IsErr(resvRes):
        var resp: RelayMessage = initRelayMessage()
        resp.msgType = relayConnectResponse
        resp.hasStatus = true
        resp.status = relayNoReservation
        resp.hasText = true
        resp.text = Error(resvRes)
        return relayReply(stream, resp)
    var resp: RelayMessage = initRelayMessage()
    resp.msgType = relayConnectResponse
    resp.hasStatus = true
    resp.status = relayOk
    resp.hasToken = true
    resp.token = Value(resvRes).token
    return relayReply(stream, resp)

fn relayHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let dataRes: Result[Bytes] = readLp(streamVar, relayConfig.maxMessageBytes)
    if IsErr(dataRes):
        return Err[bool](Error(dataRes))
    let msgRes: Result[RelayMessage] = decodeRelayMessage(Value(dataRes))
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    let msg: RelayMessage = Value(msgRes)
    if msg.msgType == relayReserve:
        let res: Result[bool] = relayHandleReserve(streamVar, msg)
        if relayConfig.closeAfterResponse:
            closeStream(streamVar)
        return res
    if msg.msgType == relayConnect:
        let res: Result[bool] = relayHandleConnect(streamVar, msg)
        if relayConfig.closeAfterResponse:
            closeStream(streamVar)
        return res
    var resp: RelayMessage = initRelayMessage()
    resp.msgType = relayConnectResponse
    resp.hasStatus = true
    resp.status = relayInvalid
    resp.hasText = true
    resp.text = "relay: unsupported message"
    let writeRes: Result[bool] = relayReply(streamVar, resp)
    if relayConfig.closeAfterResponse:
        closeStream(streamVar)
    return writeRes

fn relayProtocol(proto: var Lp2pProtocol) =
    newProtocolInto(proto, relayCodec, relayHandler)
