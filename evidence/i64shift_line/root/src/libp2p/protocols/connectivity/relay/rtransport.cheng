# Relay transport helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
const
    relayCircuitComponent = "/p2p-circuit"

fn relayMultiaddrForPeer(relayAddr: MultiAddress, dstPeer: PeerId): Result[MultiAddress] =
    let base: str = toString(relayAddr)
    let peerText: str = toString(dstPeer)
    if len(base) <= 0 || len(peerText) <= 0:
        return Err[MultiAddress]("relay: invalid addr/peer")
    let text: str = base + relayCircuitComponent + "/p2p/" + peerText
    return parseMultiAddress(text)

fn relayMultiaddrForHop(relayAddr: MultiAddress): Result[MultiAddress] =
    let base: str = toString(relayAddr)
    if len(base) <= 0:
        return Err[MultiAddress]("relay: invalid addr")
    let text: str = base + relayCircuitComponent
    return parseMultiAddress(text)
