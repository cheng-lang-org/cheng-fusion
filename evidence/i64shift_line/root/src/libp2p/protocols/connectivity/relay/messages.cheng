# Relay protocol messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/multiaddrlist
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import std/multiformats/protobuf/minprotobuf
const
    relayMsgTypeField = 1
    relayStatusField = 2
    relaySrcPeerField = 3
    relayDstPeerField = 4
    relayAddrField = 5
    relayTokenField = 6
    relayTextField = 7
    relayTtlField = 8

    relayMaxControlBytes = 4096


type
    RelayMessageType = enum
        relayReserve = 0
        relayReserveResponse = 1
        relayConnect = 2
        relayConnectResponse = 3

    RelayStatus = enum
        relayOk = 0
        relayError = 1
        relayNoReservation = 2
        relayInvalid = 3

    RelayMessage =
        msgType: RelayMessageType
        hasStatus: bool
        status: RelayStatus
        hasSrc: bool
        srcPeer: PeerId
        hasDst: bool
        dstPeer: PeerId
        addrs: MultiAddressList
        hasToken: bool
        token: Bytes
        hasText: bool
        text: str
        hasTtl: bool
        ttlSeconds: int64

fn initRelayMessage(): RelayMessage =
    RelayMessage(
        msgType: relayReserve,
        hasStatus: false,
        hasSrc: false,
        hasDst: false,
        addrs: initMultiAddressList(),
        hasToken: false,
        hasText: false,
        hasTtl: false,
        ttlSeconds: 0
    )

fn relayStatusText(status: RelayStatus): str =
    if status == relayOk:
        return "ok"
    if status == relayNoReservation:
        return "no_reservation"
    if status == relayInvalid:
        return "invalid"
    return "error"

fn encodeRelayMessage(msg: RelayMessage): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, relayMsgTypeField, int64(msg.msgType))
    if msg.hasStatus:
        writeVarint(pb, relayStatusField, int64(msg.status))
    if msg.hasSrc:
        let srcBytesRes: Result[Bytes] = toBytes(msg.srcPeer)
        if IsOk(srcBytesRes):
            writeBytes(pb, relaySrcPeerField, Value(srcBytesRes))
    if msg.hasDst:
        let dstBytesRes: Result[Bytes] = toBytes(msg.dstPeer)
        if IsOk(dstBytesRes):
            writeBytes(pb, relayDstPeerField, Value(dstBytesRes))
    for i in 0..<msg.addrs.count:
        writeBytes(pb, relayAddrField, msg.addrs.items[i].data)
    if msg.hasToken:
        writeBytes(pb, relayTokenField, msg.token)
    if msg.hasText:
        writeString(pb, relayTextField, msg.text)
    if msg.hasTtl:
        writeVarint(pb, relayTtlField, msg.ttlSeconds)
    return protoToBytes(pb)

fn decodeRelayMessage(data: Bytes): Result[RelayMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: RelayMessage = initRelayMessage()
    var msgTypeVal: int64 = -1
    let msgTypeRes: Result[bool] = getField(pb, relayMsgTypeField, msgTypeVal)
    if IsErr(msgTypeRes):
        return Err[RelayMessage](Error(msgTypeRes))
    if ! Value(msgTypeRes):
        return Err[RelayMessage]("relay: missing message type")
    if msgTypeVal < 0 || msgTypeVal > 3:
        return Err[RelayMessage]("relay: invalid message type")
    msg.msgType = RelayMessageType(msgTypeVal)
    var statusVal: int64
    let statusRes: Result[bool] = getField(pb, relayStatusField, statusVal)
    if IsErr(statusRes):
        return Err[RelayMessage](Error(statusRes))
    if Value(statusRes):
        if statusVal < 0 || statusVal > 3:
            return Err[RelayMessage]("relay: invalid status")
        msg.hasStatus = true
        msg.status = RelayStatus(statusVal)
    var srcBytes: Bytes = EmptyBytes()
    let srcRes: Result[bool] = getField(pb, relaySrcPeerField, srcBytes)
    if IsErr(srcRes):
        return Err[RelayMessage](Error(srcRes))
    if Value(srcRes):
        let pidRes: Result[PeerId] = peerIdFromBytes(srcBytes)
        if IsErr(pidRes):
            return Err[RelayMessage](Error(pidRes))
        msg.hasSrc = true
        msg.srcPeer = Value(pidRes)
    var dstBytes: Bytes = EmptyBytes()
    let dstRes: Result[bool] = getField(pb, relayDstPeerField, dstBytes)
    if IsErr(dstRes):
        return Err[RelayMessage](Error(dstRes))
    if Value(dstRes):
        let pidRes: Result[PeerId] = peerIdFromBytes(dstBytes)
        if IsErr(pidRes):
            return Err[RelayMessage](Error(pidRes))
        msg.hasDst = true
        msg.dstPeer = Value(pidRes)
    var addrList: RepeatedBytes = initRepeatedBytes()
    let addrRes: Result[bool] = getRepeatedField(pb, relayAddrField, addrList)
    if IsErr(addrRes):
        return Err[RelayMessage](Error(addrRes))
    if Value(addrRes):
        for i in 0..<addrList.count:
            let parseRes: Result[multiaddress.MultiAddress] = multiaddress.parseMultiAddressBytes(addrList.items[i])
            if IsErr(parseRes):
                return Err[RelayMessage](Error(parseRes))
            let addRes: Result[bool] = multiAddressListAdd(msg.addrs, Value(parseRes))
            if IsErr(addRes):
                return Err[RelayMessage](Error(addRes))
    var token: Bytes = EmptyBytes()
    let tokenRes: Result[bool] = getField(pb, relayTokenField, token)
    if IsErr(tokenRes):
        return Err[RelayMessage](Error(tokenRes))
    if Value(tokenRes):
        msg.hasToken = true
        msg.token = token
    var textVal: str
    let textRes: Result[bool] = getField(pb, relayTextField, textVal)
    if IsErr(textRes):
        return Err[RelayMessage](Error(textRes))
    if Value(textRes):
        msg.hasText = true
        msg.text = textVal
    var ttlVal: int64
    let ttlRes: Result[bool] = getField(pb, relayTtlField, ttlVal)
    if IsErr(ttlRes):
        return Err[RelayMessage](Error(ttlRes))
    if Value(ttlRes):
        msg.hasTtl = true
        msg.ttlSeconds = ttlVal
    return Ok[RelayMessage](msg)
