# Relay helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/times
import std/seqs
import cheng/libp2p/peerid
import cheng/libp2p/protocols/connectivity/relay/messages
const
    relayDefaultTtlSeconds = 120
    relayMinTtlSeconds = 30
    relayMaxTtlSeconds = 3600
    relayMaxReservations = 64

    relayCodec = "/libp2p/circuit/relay/1.0.0"


type
    RelayConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool
        maxReservations: int32
        minTtlSeconds: int64
        maxTtlSeconds: int64
        defaultTtlSeconds: int64

    RelayReservation =
        peerId: PeerId
        token: Bytes
        expiresAtNs: int64

    RelayState =
        count: int32
        reservations: RelayReservation[]

fn initRelayConfig(): RelayConfig =
    RelayConfig(
        maxMessageBytes: relayMaxControlBytes,
        closeAfterResponse: true,
        maxReservations: relayMaxReservations,
        minTtlSeconds: relayMinTtlSeconds,
        maxTtlSeconds: relayMaxTtlSeconds,
        defaultTtlSeconds: relayDefaultTtlSeconds
    )

fn initRelayState(): RelayState =
    RelayState(count: 0)

fn relayClampTtl(cfg: RelayConfig, requested: int64, hasTtl: bool): Result[int64] =
    var ttl: int64 = cfg.defaultTtlSeconds
    if hasTtl:
        ttl = requested
    if ttl < cfg.minTtlSeconds || ttl > cfg.maxTtlSeconds:
        return Err[int64]("relay: ttl out of range")
    return Ok[int64](ttl)

fn relayTokenFromPeer(peer: PeerId): Result[Bytes] =
    let bytesRes: Result[Bytes] = toBytes(peer)
    if IsErr(bytesRes):
        return Err[Bytes](Error(bytesRes))
    return Ok[Bytes](BytesSlice(Value(bytesRes), 0, BytesLen(Value(bytesRes))))

fn relayFindReservation(state: RelayState, peer: PeerId): int32 =
    for i in 0..<state.count:
        let eqRes: Result[bool] = peerIdEqual(state.reservations[i].peerId, peer)
        if IsOk(eqRes) && Value(eqRes):
            return i
    return -1

fn relayCleanupExpired(state: var RelayState, nowNs: int64): int32 =
    var writeIdx: int32
    var removed: int32
    for i in 0..<state.count:
        if state.reservations[i].expiresAtNs > nowNs:
            if writeIdx != i:
                state.reservations[writeIdx] = state.reservations[i]
            writeIdx = writeIdx + 1
        else:
            removed = removed + 1
    state.count = writeIdx
    return removed

fn relayUpsertReservation(state: var RelayState, peer: PeerId, token: Bytes, ttlSeconds: int64): Result[RelayReservation] =
    let nowNs: int64 = EpochTimeNs()
    relayCleanupExpired(state, nowNs)
    let idx: int32 = relayFindReservation(state, peer)
    let entry: RelayReservation = RelayReservation(
        peerId: peer,
        token: BytesSlice(token, 0, BytesLen(token)),
        expiresAtNs: nowNs + (ttlSeconds * 1000000000)
    )
    if idx >= 0:
        state.reservations[idx] = entry
        return Ok[RelayReservation](entry)
    if state.count >= relayMaxReservations:
        return Err[RelayReservation]("relay: reservation limit reached")
    add(state.reservations, entry)
    state.count = len(state.reservations)
    return Ok[RelayReservation](entry)

fn relayGetReservation(state: RelayState, peer: PeerId): Result[RelayReservation] =
    let idx: int32 = relayFindReservation(state, peer)
    if idx < 0:
        return Err[RelayReservation]("relay: reservation missing")
    return Ok[RelayReservation](state.reservations[idx])
