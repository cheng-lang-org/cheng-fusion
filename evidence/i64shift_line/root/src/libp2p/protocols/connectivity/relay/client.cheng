# Relay client helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/connectivity/relay/messages
fn relayReserveStream(stream: var Stream, peer: PeerId, ttlSeconds: int64): Result[RelayMessage] =
    var msg: RelayMessage = initRelayMessage()
    msg.msgType = relayReserve
    msg.hasSrc = true
    msg.srcPeer = peer
    if ttlSeconds > 0:
        msg.hasTtl = true
        msg.ttlSeconds = ttlSeconds
    let payload: Bytes = encodeRelayMessage(msg)
    let writeRes: Result[int32] = writeLp(stream, payload)
    if IsErr(writeRes):
        return Err[RelayMessage](Error(writeRes))
    let replyRes: Result[Bytes] = readLp(stream, relayMaxControlBytes)
    if IsErr(replyRes):
        return Err[RelayMessage](Error(replyRes))
    return decodeRelayMessage(Value(replyRes))

fn relayConnectStream(stream: var Stream, src: PeerId, dst: PeerId, token: Bytes): Result[RelayMessage] =
    var msg: RelayMessage = initRelayMessage()
    msg.msgType = relayConnect
    msg.hasSrc = true
    msg.srcPeer = src
    msg.hasDst = true
    msg.dstPeer = dst
    if BytesLen(token) > 0:
        msg.hasToken = true
        msg.token = token
    let payload: Bytes = encodeRelayMessage(msg)
    let writeRes: Result[int32] = writeLp(stream, payload)
    if IsErr(writeRes):
        return Err[RelayMessage](Error(writeRes))
    let replyRes: Result[Bytes] = readLp(stream, relayMaxControlBytes)
    if IsErr(replyRes):
        return Err[RelayMessage](Error(replyRes))
    return decodeRelayMessage(Value(replyRes))
