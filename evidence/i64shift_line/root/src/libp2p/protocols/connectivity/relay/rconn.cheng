# Relay connection helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/peerid

type
    RelayConnection =
        relayPeer: PeerId
        dstPeer: PeerId
        hasToken: bool
        token: Bytes

fn initRelayConnection(relayPeer: PeerId, dstPeer: PeerId): RelayConnection =
    RelayConnection(relayPeer: relayPeer, dstPeer: dstPeer, hasToken: false, token: EmptyBytes())

fn setRelayToken(conn: var RelayConnection, token: Bytes) =
    conn.hasToken = BytesLen(token) > 0
    conn.token = BytesSlice(token, 0, BytesLen(token))

fn relayConnectionValid(conn: RelayConnection): bool =
    return len(toString(conn.relayPeer)) > 0 && len(toString(conn.dstPeer)) > 0
