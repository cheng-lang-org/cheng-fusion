# DePIN audit sampling + challenge verification.

import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/depin/inference_manifest

type
    DepinAuditDecision =
        sampled: bool
        bps: int32
        reason: str

    DepinAuditChallengeResult =
        accepted: bool
        keepPenaltyPath: bool
        reason: str

fn DepinAuditDecisionBuild(sampled: bool, bps: int32, reason: str): DepinAuditDecision =
    return DepinAuditDecision(
        sampled: sampled,
        bps: bps,
        reason: reason
    )

fn depinAuditNormalizeBps(raw: int32): int32 =
    if raw < 0:
        return 0
    if raw > 10000:
        return 10000
    return raw

fn depinAuditPick(session: DepinInferenceSession, entropy: int64): DepinAuditDecision =
    var bps: int32 = depinAuditNormalizeBps(session.config.auditBaseBps)
    let risk: str = session.request.riskLevel
    if risk == "high" || risk == "high-risk" || risk == "high_risk":
        bps = depinAuditNormalizeBps(session.config.auditHighRiskBps)
    var bucket: int64 = entropy % 10000
    if bucket < 0:
        bucket = 0 - bucket
    let sampled: bool = bucket < int64(bps)
    return DepinAuditDecision(
        sampled: sampled,
        bps: bps,
        reason: if sampled: "sample_hit" else: "sample_skip"
    )

fn depinAuditVerifyChallengeProof(proofPayload: Bytes): bool =
    return BytesLen(proofPayload) > 0

fn depinAuditApplyChallenge(decision: DepinAuditDecision, proofPayload: Bytes): DepinAuditChallengeResult =
    if !decision.sampled:
        return DepinAuditChallengeResult(
            accepted: false,
            keepPenaltyPath: true,
            reason: "not_sampled"
        )
    if !depinAuditVerifyChallengeProof(proofPayload):
        return DepinAuditChallengeResult(
            accepted: false,
            keepPenaltyPath: true,
            reason: "invalid_proof"
        )
    return DepinAuditChallengeResult(
        accepted: true,
        keepPenaltyPath: true,
        reason: "proof_ok"
    )
