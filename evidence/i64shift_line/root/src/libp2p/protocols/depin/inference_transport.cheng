fn DepinInferenceTransportReadExpectedKvPageTransferFrame(conn: var qconn.Connection,
                                                          expected: engine.DistributedKvPageTransferFrame): Result[pipe.DepinInferenceWireFrame] =
    let frameBytesRes = DepinInferenceTransportReadKvPageTransferFrameBytes(conn, expected)
    if IsErr(frameBytesRes):
        return Err[pipe.DepinInferenceWireFrame](ErrorText(frameBytesRes))
    var frameBytes: Bytes = Value(frameBytesRes)
    let decodedRes = pipe.DepinInferenceDecodeWireFrame(frameBytes)
    BytesFree(frameBytes)
