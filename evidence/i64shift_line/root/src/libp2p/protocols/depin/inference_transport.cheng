fn DepinInferenceTransportReadKvPageTransferFrameBytes(conn: var qconn.Connection,
                                                       expected: engine.DistributedKvPageTransferFrame): Result[Bytes] =
    let frameBytesRes = DepinInferenceTransportReadWireFrameBytes(conn)
