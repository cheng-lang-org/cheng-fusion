fn DepinInferenceTransportValidateKvPageTransferFrameSet(frames: engine.DistributedKvPageTransferFrameSet): Result[bool] =
    if frames.schema != engine.DistributedKvPageTransferFrameSetSchema:
        return Err[bool]("depin inference kv transfer frame set: schema")
    if frames.enginePlanHash <= int64(0) || frames.frames.len <= 0:
        return Err[bool]("depin inference kv transfer frame set: empty")
    if engine.DistributedKvPageTransferFrameSetHash(frames) != frames.frameSetHash:
        return Err[bool]("depin inference kv transfer frame set: hash")
    for i in 0..<frames.frames.len:
        if frames.frames[i].seqNo != uint64(i):
            return Err[bool]("depin inference kv transfer frame set: seq")
        let wireRes = engine.DistributedKvPageTransferFrameWireBytes(frames.frames[i])
        if IsErr(wireRes):
            return Err[bool](Error(wireRes))
        var wireBytes: Bytes = Value(wireRes)
        let validateRes = pipe.DepinInferenceValidateWireFrameBytes(wireBytes)
        BytesFree(wireBytes)
        if IsErr(validateRes):
            return Err[bool](Error(validateRes))
    return Ok[bool](true)

fn DepinInferenceTransportDispatchKvPageTransferFrameSetByTarget(links: var DepinInferenceTransportPeerLink[],
                                                                 frames: engine.DistributedKvPageTransferFrameSet): Result[int32] =
    let linkOk = DepinInferenceTransportValidatePeerLinks(links)
    if IsErr(linkOk):
        return Err[int32](Error(linkOk))
    let setOk = DepinInferenceTransportValidateKvPageTransferFrameSet(frames)
    if IsErr(setOk):
        return Err[int32](Error(setOk))
    var written: int32
    for i in 0..<frames.frames.len:
        let linkIndex = DepinInferenceTransportFindPeerLink(links, frames.frames[i].targetPeerId)
        if IsErr(linkIndex):
            return Err[int32](Error(linkIndex))
        var link = links[Value(linkIndex)]
        let writeRes = DepinInferenceTransportWriteKvPageTransferFrame(link.outbound, frames.frames[i])
        if IsErr(writeRes):
            return Err[int32](Error(writeRes))
        if Value(writeRes) != pipe.DepinInferenceWireFrameBytes:
            return Err[int32]("depin inference kv transfer dispatch: short write")
        links[Value(linkIndex)] = link
        written = written + Value(writeRes)
    return Ok[int32](written)

fn DepinInferenceTransportReadAllExpectedKvPageTransferFramesByTarget(links: var DepinInferenceTransportPeerLink[],
                                                                      frames: engine.DistributedKvPageTransferFrameSet): Result[int32] =
    let linkOk = DepinInferenceTransportValidatePeerLinks(links)
    if IsErr(linkOk):
        return Err[int32](Error(linkOk))
    let setOk = DepinInferenceTransportValidateKvPageTransferFrameSet(frames)
    if IsErr(setOk):
        return Err[int32](Error(setOk))
    var readBytes: int32
    for i in 0..<frames.frames.len:
        let linkIndex = DepinInferenceTransportFindPeerLink(links, frames.frames[i].targetPeerId)
        if IsErr(linkIndex):
            return Err[int32](Error(linkIndex))
        var link = links[Value(linkIndex)]
        let readRes = DepinInferenceTransportReadExpectedKvPageTransferFrame(link.inbound, frames.frames[i])
        if IsErr(readRes):
            return Err[int32](strutil.Join([
                "depin inference kv transfer dispatch: peer=",
                frames.frames[i].targetPeerId,
                " expected_kind=",
                frames.frames[i].frameKind,
                " expected_seq=",
                strings.Int64ToStr(int64(frames.frames[i].seqNo)),
                " ",
                Error(readRes)
            ], ""))
        if Value(readRes).frameHash != frames.frames[i].frameHash:
            return Err[int32]("depin inference kv transfer dispatch: sequence frame hash")
        links[Value(linkIndex)] = link
        readBytes = readBytes + pipe.DepinInferenceWireFrameBytes
    if readBytes != frames.frames.len * pipe.DepinInferenceWireFrameBytes:
        return Err[int32]("depin inference kv transfer dispatch: read count")
    return Ok[int32](readBytes)

fn DepinInferenceTransportFindPeerLink(links: DepinInferenceTransportPeerLink[],
                                       peerId: str): Result[int32] =
    if peerId == "":
        return Err[int32]("depin inference transport dispatch: empty peer")
    var found: int32 = -1
    for i in 0..<links.len:
        if links[i].peerId == peerId:
            if found >= 0:
                return Err[int32]("depin inference transport dispatch: duplicate peer link")
            found = i
    if found < 0:
        return Err[int32]("depin inference transport dispatch: missing peer link")
    return Ok[int32](found)

fn DepinInferenceTransportValidatePeerLinks(links: DepinInferenceTransportPeerLink[]): Result[bool] =
    if links.len <= 0:
        return Err[bool]("depin inference transport dispatch: empty links")
    for i in 0..<links.len:
        if links[i].peerId == "":
            return Err[bool]("depin inference transport dispatch: peer")
        for j in i + 1..<links.len:
            if links[i].peerId == links[j].peerId:
                return Err[bool]("depin inference transport dispatch: duplicate peer")
    return Ok[bool](true)

fn DepinInferenceTransportDispatchFrameSetByTarget(links: var DepinInferenceTransportPeerLink[],
                                                   frames: engine.DistributedShardTransportFrameSet): Result[int32] =
    let linkOk = DepinInferenceTransportValidatePeerLinks(links)
    if IsErr(linkOk):
        return Err[int32](Error(linkOk))
    let setOk = DepinInferenceTransportValidateDistributedFrameSet(frames)
    if IsErr(setOk):
        return Err[int32](Error(setOk))
    var written: int32
    for i in 0..<frames.frames.len:
        let linkIndex = DepinInferenceTransportFindPeerLink(links, frames.frames[i].targetPeerId)
        if IsErr(linkIndex):
            return Err[int32](Error(linkIndex))
        var link = links[Value(linkIndex)]
        let writeRes = DepinInferenceTransportWriteDistributedFrame(link.outbound, frames.frames[i])
        if IsErr(writeRes):
            return Err[int32](Error(writeRes))
        if Value(writeRes) != pipe.DepinInferenceWireFrameBytes:
            return Err[int32]("depin inference transport dispatch: short write")
        links[Value(linkIndex)] = link
        written = written + Value(writeRes)
    return Ok[int32](written)

fn DepinInferenceTransportReadPeerExpectedFrames(links: var DepinInferenceTransportPeerLink[],
                                                 peerId: str,
                                                 expected: engine.DistributedShardTransportFrame[]): Result[int32] =
    let linkIndex = DepinInferenceTransportFindPeerLink(links, peerId)
    if IsErr(linkIndex):
        return Err[int32](Error(linkIndex))
    var link = links[Value(linkIndex)]
    var readBytes: int32
    for i in 0..<expected.len:
        if expected[i].targetPeerId != peerId:
            return Err[int32]("depin inference transport dispatch: expected target")
        let readRes = DepinInferenceTransportReadExpectedDistributedFrame(link.inbound, expected[i])
        if IsErr(readRes):
            return Err[int32](strutil.Join([
                "depin inference transport dispatch: peer=",
                peerId,
                " expected_kind=",
                expected[i].frameKind,
                " expected_seq=",
                strings.Int64ToStr(int64(expected[i].seqNo)),
                " ",
                Error(readRes)
            ], ""))
        if Value(readRes).frameHash != expected[i].frameHash:
            return Err[int32]("depin inference transport dispatch: frame hash")
        readBytes = readBytes + pipe.DepinInferenceWireFrameBytes
    links[Value(linkIndex)] = link
    return Ok[int32](readBytes)

fn DepinInferenceTransportValidateManifestEvidenceBinding(distributedManifest: DepinDistributedInferenceManifest,
                                                          plan: engine.DistributedInferencePlan,
                                                          evidence: engine.DistributedActivationEvidence,
                                                          kvTransferEvidence: engine.DistributedKvPageTransferEvidence): Result[bool] =
    let manifestOk = DepinValidateDistributedManifestPlanFacts(
        distributedManifest,
        plan.partitionPlan,
        plan.kernelPrograms,
        plan.deviceWeightBindingHash,
        plan.kvReceipt,
        plan.kvStateHash,
        plan.kvShardReceipts.receiptSetHash,
        kvTransferEvidence.evidenceHash,
        plan.specDecodePlan.planHash,
        plan.routePlanSet
    )
    if IsErr(manifestOk):
        return Err[bool](Error(manifestOk))
    if distributedManifest.modelCid != plan.modelGraph.modelCid:
        return Err[bool]("depin inference dispatch session: manifest model")
    if evidence.enginePlanHash != plan.engineHash:
        return Err[bool]("depin inference dispatch session: evidence plan")
    if kvTransferEvidence.enginePlanHash != plan.engineHash:
        return Err[bool]("depin inference dispatch session: kv transfer evidence plan")
    if distributedManifest.requestSetHash != evidence.requests.requestSetHash:
        return Err[bool]("depin inference dispatch session: request set hash")
    if distributedManifest.transportFrameSetHash != evidence.transportFrames.frameSetHash:
        return Err[bool]("depin inference dispatch session: transport frame set hash")
    if distributedManifest.evidenceHash != evidence.evidenceHash:
        return Err[bool]("depin inference dispatch session: evidence hash")
    let expectedKvTransferCid = strutil.Join([
        "cid:kv:page_transfer_evidence:",
        strings.Int64ToStr(kvTransferEvidence.evidenceHash)
    ], "")
    if distributedManifest.kvPageTransferEvidenceCid != expectedKvTransferCid:
        return Err[bool]("depin inference dispatch session: kv transfer evidence hash")
    return Ok[bool](true)

fn DepinInferenceTransportExpectedFrameCountForPeer(frames: engine.DistributedShardTransportFrameSet,
                                                    peerId: str): int32 =
    var count: int32
    for i in 0..<frames.frames.len:
        if frames.frames[i].targetPeerId == peerId:
            count = count + 1
    return count

fn DepinInferenceTransportExpectedFramesForPeer(frames: engine.DistributedShardTransportFrameSet,
                                                peerId: str): engine.DistributedShardTransportFrame[] =
    var out: engine.DistributedShardTransportFrame[]
    for i in 0..<frames.frames.len:
        if frames.frames[i].targetPeerId == peerId:
            add(out, frames.frames[i])
    return out

fn depinInferenceTransportValidateSpecDecodeCertifiedReceiptBinding(plan: engine.DistributedInferencePlan,
                                                                   specDecodeCertifiedReceiptHash: int64): Result[bool] =
    let specOk = engine.DistributedValidateSpecDecodePlan(plan.specDecodePlan)
    if IsErr(specOk):
        return Err[bool](Error(specOk))
    if plan.specDecodePlan.algorithm == engine.DistributedSpecDecodeAlgorithmNone:
        if specDecodeCertifiedReceiptHash != int64(0):
            return Err[bool]("depin inference dispatch session: spec receipt supplied for ordinary decode")
    elif specDecodeCertifiedReceiptHash <= int64(0):
        return Err[bool]("depin inference dispatch session: spec certified receipt missing")
    return Ok[bool](true)

fn DepinInferenceTransportValidateSpecDecodeCertifiedReceiptForPlan(session: DepinInferenceSession,
                                                                    distributedManifest: DepinDistributedInferenceManifest,
                                                                    plan: engine.DistributedInferencePlan,
                                                                    receipt: specdecode.DepinSpecDecodeCertifiedReceipt): Result[int64] =
    let shapeOk = specdecode.DepinSpecDecodeValidateCertifiedReceiptShape(receipt)
    if IsErr(shapeOk):
        return Err[int64](Error(shapeOk))
    let bindingOk = depinInferenceTransportValidateSpecDecodeCertifiedReceiptBinding(plan, receipt.receiptHash)
    if IsErr(bindingOk):
        return Err[int64](Error(bindingOk))
    if session.sessionId != receipt.sessionId ||
       session.request.requestId != receipt.requestId ||
       session.request.modelCid != receipt.modelCid:
        return Err[int64]("depin inference dispatch session: spec receipt session")
    if distributedManifest.manifestHash != receipt.manifestHash ||
       distributedManifest.modelCid != receipt.modelCid:
        return Err[int64]("depin inference dispatch session: spec receipt manifest")
    if plan.engineHash != receipt.enginePlanHash ||
       plan.specDecodePlan.planHash != receipt.specDecodePlanHash ||
       plan.specDecodePlan.draftWindow != receipt.draftWindow ||
       plan.specDecodePlan.draftTokenCount != receipt.draftTokenCount ||
       plan.specDecodePlan.mtpLayerCount != receipt.mtpLayerCount:
        return Err[int64]("depin inference dispatch session: spec receipt plan")
    return Ok[int64](receipt.receiptHash)

fn DepinInferenceTransportReadAllExpectedFramesByTarget(links: var DepinInferenceTransportPeerLink[],
                                                        frames: engine.DistributedShardTransportFrameSet): Result[int32] =
    let linkOk = DepinInferenceTransportValidatePeerLinks(links)
    if IsErr(linkOk):
        return Err[int32](Error(linkOk))
    let setOk = DepinInferenceTransportValidateDistributedFrameSet(frames)
    if IsErr(setOk):
        return Err[int32](Error(setOk))
    var readBytes: int32
    for i in 0..<frames.frames.len:
        let linkIndex = DepinInferenceTransportFindPeerLink(links, frames.frames[i].targetPeerId)
        if IsErr(linkIndex):
            return Err[int32](Error(linkIndex))
        var link = links[Value(linkIndex)]
        let readRes = DepinInferenceTransportReadExpectedDistributedFrame(link.inbound, frames.frames[i])
        if IsErr(readRes):
            return Err[int32](strutil.Join([
                "depin inference transport dispatch: peer=",
                frames.frames[i].targetPeerId,
                " expected_kind=",
                frames.frames[i].frameKind,
                " expected_seq=",
                strings.Int64ToStr(int64(frames.frames[i].seqNo)),
                " ",
                Error(readRes)
            ], ""))
        if Value(readRes).frameHash != frames.frames[i].frameHash:
            return Err[int32]("depin inference transport dispatch: sequence frame hash")
        links[Value(linkIndex)] = link
        readBytes = readBytes + pipe.DepinInferenceWireFrameBytes
    if readBytes != frames.frames.len * pipe.DepinInferenceWireFrameBytes:
        return Err[int32]("depin inference transport dispatch: read count")
    return Ok[int32](readBytes)

fn DepinInferenceTransportRunCertifiedDispatchSession(session: var DepinInferenceSession,
                                                      links: var DepinInferenceTransportPeerLink[],
                                                      distributedManifest: DepinDistributedInferenceManifest,
                                                      plan: engine.DistributedInferencePlan,
                                                      peers: engine.DistributedInferencePeer[],
                                                      kvCache: paged_kv_cache.PagedKVCache,
                                                      kvSeq: paged_kv_cache.PagedKVSequence,
                                                      envelopes: activation_transport.ActivationEnvelope[],
                                                      activationStore: activation_transport.ActivationTensorStore,
                                                      evidence: engine.DistributedActivationEvidence,
                                                      kvTransferEvidence: engine.DistributedKvPageTransferEvidence,
                                                      baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                      residencyPathPrefix: str,
                                                      adapter: var DepinRwadDispatcherAdapter,
                                                      settlementPlan: DepinSettlementPlan): Result[DepinInferenceTransportDispatchSessionReceipt] =
    return depinInferenceTransportRunCertifiedDispatchSessionWithSpecDecodeReceiptHash(
        session,
        links,
        distributedManifest,
        plan,
        peers,
        kvCache,
        kvSeq,
        envelopes,
        activationStore,
        evidence,
        kvTransferEvidence,
        baseKvResidencyStore,
        residencyPathPrefix,
        int64(0),
        adapter,
        settlementPlan
    )

fn DepinInferenceTransportRunCertifiedDispatchSessionWithSpecDecodeReceipt(session: var DepinInferenceSession,
                                                                          links: var DepinInferenceTransportPeerLink[],
                                                                          distributedManifest: DepinDistributedInferenceManifest,
                                                                          plan: engine.DistributedInferencePlan,
                                                                          peers: engine.DistributedInferencePeer[],
                                                                          kvCache: paged_kv_cache.PagedKVCache,
                                                                          kvSeq: paged_kv_cache.PagedKVSequence,
                                                                          envelopes: activation_transport.ActivationEnvelope[],
                                                                          activationStore: activation_transport.ActivationTensorStore,
                                                                          evidence: engine.DistributedActivationEvidence,
                                                                          kvTransferEvidence: engine.DistributedKvPageTransferEvidence,
                                                                          baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                                          residencyPathPrefix: str,
                                                                          specDecodeReceipt: specdecode.DepinSpecDecodeCertifiedReceipt,
                                                                          adapter: var DepinRwadDispatcherAdapter,
                                                                          settlementPlan: DepinSettlementPlan): Result[DepinInferenceTransportDispatchSessionReceipt] =
    let specReceiptHash = DepinInferenceTransportValidateSpecDecodeCertifiedReceiptForPlan(
        session,
        distributedManifest,
        plan,
        specDecodeReceipt
    )
    if IsErr(specReceiptHash):
        return depinInferenceTransportFailSession(session, Error(specReceiptHash))
    return depinInferenceTransportRunCertifiedDispatchSessionWithSpecDecodeReceiptHash(
        session,
        links,
        distributedManifest,
        plan,
        peers,
        kvCache,
        kvSeq,
        envelopes,
        activationStore,
        evidence,
        kvTransferEvidence,
        baseKvResidencyStore,
        residencyPathPrefix,
        Value(specReceiptHash),
        adapter,
        settlementPlan
    )

fn depinInferenceTransportRunCertifiedDispatchSessionWithSpecDecodeReceiptHash(session: var DepinInferenceSession,
                                                                              links: var DepinInferenceTransportPeerLink[],
                                                                              distributedManifest: DepinDistributedInferenceManifest,
                                                                              plan: engine.DistributedInferencePlan,
                                                                              peers: engine.DistributedInferencePeer[],
                                                                              kvCache: paged_kv_cache.PagedKVCache,
                                                                              kvSeq: paged_kv_cache.PagedKVSequence,
                                                                              envelopes: activation_transport.ActivationEnvelope[],
                                                                              activationStore: activation_transport.ActivationTensorStore,
                                                                              evidence: engine.DistributedActivationEvidence,
                                                                              kvTransferEvidence: engine.DistributedKvPageTransferEvidence,
                                                                              baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                                              residencyPathPrefix: str,
                                                                              specDecodeCertifiedReceiptHash: int64,
                                                                              adapter: var DepinRwadDispatcherAdapter,
                                                                              settlementPlan: DepinSettlementPlan): Result[DepinInferenceTransportDispatchSessionReceipt] =
    if session.failed:
        return depinInferenceTransportFailSession(session, "session_already_failed")
    if !session.started:
        return depinInferenceTransportFailSession(session, "session_not_started")
    if session.finished:
        return depinInferenceTransportFailSession(session, "session_finished")
    if session.request.modelCid != distributedManifest.modelCid:
        return depinInferenceTransportFailSession(session, "manifest_model_mismatch")
    let specReceiptOk = depinInferenceTransportValidateSpecDecodeCertifiedReceiptBinding(plan, specDecodeCertifiedReceiptHash)
    if IsErr(specReceiptOk):
        return depinInferenceTransportFailSession(session, Error(specReceiptOk))
    let evidenceOk = engine.DistributedValidateActivationEvidence(plan, peers, envelopes, activationStore, evidence)
    if IsErr(evidenceOk):
        return depinInferenceTransportFailSession(session, Error(evidenceOk))
    let kvTransferOk = engine.DistributedValidateKvPageTransferEvidence(plan, peers, kvCache, kvSeq, kvTransferEvidence)
    if IsErr(kvTransferOk):
        return depinInferenceTransportFailSession(session, Error(kvTransferOk))
    let bindingOk = DepinInferenceTransportValidateManifestEvidenceBinding(distributedManifest, plan, evidence, kvTransferEvidence)
    if IsErr(bindingOk):
        return depinInferenceTransportFailSession(session, Error(bindingOk))
    let kvWrittenRes = DepinInferenceTransportDispatchKvPageTransferFrameSetByTarget(links, kvTransferEvidence.frames)
    if IsErr(kvWrittenRes):
        return depinInferenceTransportFailSession(session, Error(kvWrittenRes))
    let kvReadRes = DepinInferenceTransportReadAllExpectedKvPageTransferFramesByTarget(links, kvTransferEvidence.frames)
    if IsErr(kvReadRes):
        return depinInferenceTransportFailSession(session, Error(kvReadRes))
    let writtenRes = DepinInferenceTransportDispatchFrameSetByTarget(links, evidence.transportFrames)
    if IsErr(writtenRes):
        return depinInferenceTransportFailSession(session, Error(writtenRes))
    let readRes = DepinInferenceTransportReadAllExpectedFramesByTarget(links, evidence.transportFrames)
    if IsErr(readRes):
        return depinInferenceTransportFailSession(session, Error(readRes))
    let residencySinceNs = DepinInferenceNowMs() * int64(1000000)
    let residencyUntilNs = residencySinceNs + int64(session.config.stageTimeoutMs) * int64(1000000)
    let residencyReceiptRes = engine.DistributedBuildKvPageResidencyReceipt(
        plan,
        peers,
        kvTransferEvidence,
        residencySinceNs,
        residencyUntilNs
    )
    if IsErr(residencyReceiptRes):
        return depinInferenceTransportFailSession(session, Error(residencyReceiptRes))
    let residencyOk = engine.DistributedValidateKvPageResidencyReceipt(
        plan,
        peers,
        kvTransferEvidence,
        Value(residencyReceiptRes)
    )
    if IsErr(residencyOk):
        return depinInferenceTransportFailSession(session, Error(residencyOk))
    let baseStoreOk = engine.DistributedValidateKvResidencyStore(plan, peers, baseKvResidencyStore)
    if IsErr(baseStoreOk):
        return depinInferenceTransportFailSession(session, Error(baseStoreOk))
    if residencyPathPrefix == "":
        return depinInferenceTransportFailSession(session, "kv_residency_service_path_prefix_empty")
    let residencyStoreFilePath = strutil.Join([residencyPathPrefix, ".ckvs1"], "")
    let residencyWalFilePath = strutil.Join([residencyPathPrefix, ".cwal1"], "")
    let residencyHeadPath = strutil.Join([residencyPathPrefix, ".ckvh1"], "")
    let residencyHeadTempPath = strutil.Join([residencyPathPrefix, ".ckvh1.tmp"], "")
    let residencyLockDirPath = strutil.Join([residencyPathPrefix, ".ckvl1.lock"], "")
    var currentKvResidencyStore = baseKvResidencyStore
    var currentKvResidencyWalLog: engine.DistributedKvResidencyWalLog
    if os.FileExists(residencyHeadPath):
        let recoverRes = engine.DistributedRecoverKvResidencyStoreFromHeadFile(
            plan,
            peers,
            baseKvResidencyStore,
            residencyHeadPath,
            residencySinceNs
        )
        if IsErr(recoverRes):
            return depinInferenceTransportFailSession(session, Error(recoverRes))
        currentKvResidencyStore = Value(recoverRes).store
        currentKvResidencyWalLog = Value(recoverRes).log
    else:
        let emptyWalRes = engine.DistributedBuildEmptyKvResidencyWalLog(
            plan,
            peers,
            baseKvResidencyStore
        )
        if IsErr(emptyWalRes):
            return depinInferenceTransportFailSession(session, Error(emptyWalRes))
        currentKvResidencyWalLog = Value(emptyWalRes)
    let existingKvResidencyReceipts = engine.DistributedKvResidencyStoreExistingReceipts(currentKvResidencyStore)
    let residencyScheduleRes = engine.DistributedBuildKvResidencySchedule(
        plan,
        peers,
        kvCache,
        kvSeq,
        kvTransferEvidence,
        Value(residencyReceiptRes),
        existingKvResidencyReceipts,
        currentKvResidencyStore.maxResidentPages,
        residencySinceNs,
        residencyUntilNs
    )
    if IsErr(residencyScheduleRes):
        return depinInferenceTransportFailSession(session, Error(residencyScheduleRes))
    let residencyScheduleOk = engine.DistributedValidateKvResidencySchedule(
        plan,
        peers,
        kvCache,
        kvSeq,
        kvTransferEvidence,
        Value(residencyReceiptRes),
        existingKvResidencyReceipts,
        Value(residencyScheduleRes)
    )
    if IsErr(residencyScheduleOk):
        return depinInferenceTransportFailSession(session, Error(residencyScheduleOk))
    let residencyApplyRes = engine.DistributedApplyKvResidencyScheduleService(
        plan,
        peers,
        kvCache,
        kvSeq,
        kvTransferEvidence,
        Value(residencyReceiptRes),
        baseKvResidencyStore,
        Value(residencyScheduleRes),
        residencyStoreFilePath,
        residencyWalFilePath,
        residencyHeadPath,
        residencyHeadTempPath,
        residencyLockDirPath,
        session.sessionId,
        residencySinceNs,
        residencySinceNs,
        residencyUntilNs,
        residencySinceNs,
        residencySinceNs,
        residencySinceNs
    )
    if IsErr(residencyApplyRes):
        return depinInferenceTransportFailSession(session, Error(residencyApplyRes))
    let residencyApplyOk = engine.DistributedValidateKvResidencyServiceApplyReceipt(
        plan,
        peers,
        baseKvResidencyStore,
        currentKvResidencyStore,
        currentKvResidencyWalLog,
        Value(residencyApplyRes).update,
        Value(residencyApplyRes).append,
        Value(residencyApplyRes).serviceCommit,
        Value(residencyApplyRes).receipt
    )
    if IsErr(residencyApplyOk):
        return depinInferenceTransportFailSession(session, Error(residencyApplyOk))
    session.kvResidencyStoreOperationHash = Value(residencyApplyRes).update.operation.operationHash
    session.kvResidencyStoreHash = Value(residencyApplyRes).update.store.storeHash
    session.kvResidencyWalRecordHash = Value(residencyApplyRes).append.record.recordHash
    session.kvResidencyWalLogHash = Value(residencyApplyRes).append.log.logHash
    session.kvResidencyWalAppendHash = Value(residencyApplyRes).append.appendHash
    session.kvResidencyServiceCommitHash = Value(residencyApplyRes).serviceCommit.receipt.serviceCommitHash
    session.kvResidencyServiceApplyHash = Value(residencyApplyRes).receipt.applyHash
    let settlementLedgerPath = DepinSettlementLedgerPathFromPrefix(residencyPathPrefix)
    let submitRes = DepinSettlementSubmitWithLedger(
        adapter,
        session,
        settlementPlan,
        settlementLedgerPath,
        residencySinceNs
    )
    if IsErr(submitRes):
        return depinInferenceTransportFailSession(session, Error(submitRes))
    let finalizeRes = DepinSettlementFinalizeWithLedger(
        adapter,
        session,
        settlementPlan,
        settlementLedgerPath,
        residencySinceNs + int64(1)
    )
    if IsErr(finalizeRes):
        return depinInferenceTransportFailSession(session, Error(finalizeRes))
    if Value(finalizeRes).recordCount < 2 ||
       Value(finalizeRes).ledgerHash <= int64(0) ||
       Value(finalizeRes).receiptHash <= int64(0):
        return depinInferenceTransportFailSession(session, "depin settlement ledger receipt")
    let settlementLedgerQuorumRes = DepinInferenceTransportReplicateSettlementLedgerQuorum(
        links,
        plan,
        settlementPlan,
        adapter.sender,
        Value(finalizeRes),
        residencyPathPrefix,
        int64(evidence.transportFrames.frames.len + kvTransferEvidence.frames.frames.len),
        residencySinceNs + int64(2)
    )
    if IsErr(settlementLedgerQuorumRes):
        return depinInferenceTransportFailSession(session, Error(settlementLedgerQuorumRes))
    let settlementLedgerQuorumOk = DepinInferenceTransportValidateSettlementLedgerQuorumReceipt(Value(settlementLedgerQuorumRes))
    if IsErr(settlementLedgerQuorumOk):
        return depinInferenceTransportFailSession(session, Error(settlementLedgerQuorumOk))
    let settlementLedgerQuorumFileRes = DepinInferenceTransportWriteSettlementLedgerQuorumReceiptFile(
        DepinInferenceTransportSettlementLedgerQuorumPathFromPrefix(residencyPathPrefix),
        Value(settlementLedgerQuorumRes)
    )
    if IsErr(settlementLedgerQuorumFileRes):
        return depinInferenceTransportFailSession(session, Error(settlementLedgerQuorumFileRes))
    session.acceptedPrefixLen = evidence.responses.responses.len
    session.stageIndex = evidence.responses.responses.len
    session.expectedSeqNo = uint64(evidence.transportFrames.frames.len + kvTransferEvidence.frames.frames.len + Value(settlementLedgerQuorumRes).successfulReplicaCount)
    session.lastStageAtMs = DepinInferenceNowMs()
    session.specDecodeCertifiedReceiptHash = specDecodeCertifiedReceiptHash
    let receipt = DepinInferenceTransportDispatchSessionReceiptBuild(
        DepinInferenceTransportDispatchSessionReceipt(
            schema: "",
            sessionId: session.sessionId,
            manifestHash: distributedManifest.manifestHash,
            enginePlanHash: plan.engineHash,
            specDecodeAlgorithm: plan.specDecodePlan.algorithm,
            specDecodePlanHash: plan.specDecodePlan.planHash,
            specDecodeCertifiedReceiptHash: specDecodeCertifiedReceiptHash,
            requestSetHash: evidence.requests.requestSetHash,
            responseSetHash: evidence.responses.responseSetHash,
            receiptSetHash: evidence.receipts.receiptSetHash,
            transportFrameSetHash: evidence.transportFrames.frameSetHash,
            evidenceHash: evidence.evidenceHash,
            kvPageTransferEvidenceHash: kvTransferEvidence.evidenceHash,
            kvPageResidencyReceiptHash: Value(residencyReceiptRes).receiptHash,
            kvResidencyScheduleHash: Value(residencyScheduleRes).scheduleHash,
            kvResidencyStoreOperationHash: Value(residencyApplyRes).update.operation.operationHash,
            kvResidencyStoreHash: Value(residencyApplyRes).update.store.storeHash,
            kvResidencyWalRecordHash: Value(residencyApplyRes).append.record.recordHash,
            kvResidencyWalLogHash: Value(residencyApplyRes).append.log.logHash,
            kvResidencyWalAppendHash: Value(residencyApplyRes).append.appendHash,
            kvResidencyServiceCommitHash: Value(residencyApplyRes).serviceCommit.receipt.serviceCommitHash,
            kvResidencyServiceApplyHash: Value(residencyApplyRes).receipt.applyHash,
            bytesWritten: Value(kvWrittenRes) + Value(writtenRes) + Value(settlementLedgerQuorumRes).bytesWritten,
            bytesRead: Value(kvReadRes) + Value(readRes) + Value(settlementLedgerQuorumRes).bytesRead,
            settlementTxHash: session.settlementTxHash,
            settlementLedgerHash: Value(finalizeRes).ledgerHash,
            settlementLedgerReceiptHash: Value(finalizeRes).receiptHash,
            settlementLedgerReplicationHash: Value(settlementLedgerQuorumRes).receiptHash,
            settlementLedgerAckHash: Value(settlementLedgerQuorumRes).ackFrameSetHash,
            settlementLedgerReplicaCount: Value(settlementLedgerQuorumRes).successfulReplicaCount,
            settlementLedgerReplicaQuorum: Value(settlementLedgerQuorumRes).requiredReplicaCount,
            settlementLedgerQuorumFileReceiptHash: Value(settlementLedgerQuorumFileRes).receiptHash,
            settlementLedgerReplicaAttemptCount: Value(settlementLedgerQuorumRes).replicaAttemptCount,
            settlementLedgerReplicaAttemptSetHash: Value(settlementLedgerQuorumRes).replicaAttemptSetHash,
            receiptHash: int64(0)
        )
    )
    let receiptOk = DepinInferenceTransportValidateDispatchSessionReceipt(receipt)
    if IsErr(receiptOk):
        return depinInferenceTransportFailSession(session, Error(receiptOk))
    return Ok[DepinInferenceTransportDispatchSessionReceipt](receipt)

fn DepinInferenceTransportResidencySettlementDaemonRegisteredServicePathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csrg1"], "")

fn depinInferenceTransportResidencySettlementDaemonRegisteredServicePrefixFromReceiptPath(receiptPath: str): Result[str] =
    if !strings.HasSuffix(receiptPath, ".csrg1"):
        return Err[str]("depin residency settlement daemon registered service: receipt suffix")
    let n = strings.Len(receiptPath)
    if n <= 6:
        return Err[str]("depin residency settlement daemon registered service: receipt path")
    return Ok[str](strings.SliceBytes(receiptPath, 0, n - 6))

fn DepinInferenceTransportResidencySettlementDaemonRegisteredServiceHash(receipt: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt): int64 =
    var h: int64 = int64(293)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.serviceKindHash)
    h = engine.DistributedHashStep(h, receipt.serviceNameHash)
    h = engine.DistributedHashStep(h, receipt.executablePathHash)
    h = engine.DistributedHashStep(h, receipt.workingDirectoryHash)
    h = engine.DistributedHashStep(h, receipt.osServiceSpecReceiptHash)
    h = engine.DistributedHashStep(h, receipt.osServiceSpecSpecByteHash)
    h = engine.DistributedHashStep(h, receipt.osServiceSpecTriggerSpecByteHash)
    h = engine.DistributedHashStep(h, receipt.startupBundleReceiptHash)
    h = engine.DistributedHashStep(h, receipt.startupBundleByteHash)
    h = engine.DistributedHashStep(h, receipt.healthReceiptHash)
    h = engine.DistributedHashStep(h, receipt.heartbeatPid)
    h = engine.DistributedHashStep(h, receipt.healthCheckedAtNs)
    h = engine.DistributedHashStep(h, receipt.registeredAtNs)
    h = engine.DistributedHashStep(h, receipt.active ? int64(1) : int64(0))
    return h

fn DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceiptHash(receipt: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt): int64 =
    var h: int64 = int64(297)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.receiptPath)
    h = engine.DistributedHashTextWith(h, receipt.osServiceSpecReceiptPath)
    h = engine.DistributedHashTextWith(h, receipt.startupBundlePath)
    h = engine.DistributedHashTextWith(h, receipt.healthReceiptPath)
    h = engine.DistributedHashStep(h, receipt.configHash)
    h = engine.DistributedHashStep(h, receipt.daemonIdHash)
    h = engine.DistributedHashStep(h, receipt.eventStreamHash)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.baseStoreHash)
    h = engine.DistributedHashStep(h, receipt.serviceKindHash)
    h = engine.DistributedHashStep(h, receipt.serviceNameHash)
    h = engine.DistributedHashStep(h, receipt.executablePathHash)
    h = engine.DistributedHashStep(h, receipt.workingDirectoryHash)
    h = engine.DistributedHashStep(h, receipt.osServiceSpecReceiptHash)
    h = engine.DistributedHashStep(h, receipt.osServiceSpecSpecByteHash)
    h = engine.DistributedHashStep(h, receipt.osServiceSpecTriggerSpecByteHash)
    h = engine.DistributedHashStep(h, receipt.startupBundleReceiptHash)
    h = engine.DistributedHashStep(h, receipt.startupBundleByteHash)
    h = engine.DistributedHashStep(h, receipt.healthReceiptHash)
    h = engine.DistributedHashStep(h, receipt.heartbeatPid)
    h = engine.DistributedHashStep(h, receipt.healthCheckedAtNs)
    h = engine.DistributedHashStep(h, receipt.registeredAtNs)
    h = engine.DistributedHashStep(h, receipt.active ? int64(1) : int64(0))
    h = engine.DistributedHashStep(h, receipt.registeredServiceHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn depinInferenceTransportResidencySettlementDaemonRegisteredServiceFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(307), bytesRaw)

fn depinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWord(receipt: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt,
                                                                             index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileMagic)
    if index == 1:
        return int64(DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileVersion)
    if index == 2:
        return receipt.configHash
    if index == 3:
        return receipt.daemonIdHash
    if index == 4:
        return receipt.eventStreamHash
    if index == 5:
        return receipt.enginePlanHash
    if index == 6:
        return receipt.baseStoreHash
    if index == 7:
        return receipt.serviceKindHash
    if index == 8:
        return receipt.serviceNameHash
    if index == 9:
        return receipt.executablePathHash
    if index == 10:
        return receipt.workingDirectoryHash
    if index == 11:
        return DepinSettlementTextHash(receipt.osServiceSpecReceiptPath)
    if index == 12:
        return DepinSettlementTextHash(receipt.startupBundlePath)
    if index == 13:
        return DepinSettlementTextHash(receipt.healthReceiptPath)
    if index == 14:
        return receipt.osServiceSpecReceiptHash
    if index == 15:
        return receipt.osServiceSpecSpecByteHash
    if index == 16:
        return receipt.osServiceSpecTriggerSpecByteHash
    if index == 17:
        return receipt.startupBundleReceiptHash
    if index == 18:
        return receipt.startupBundleByteHash
    if index == 19:
        return receipt.healthReceiptHash
    if index == 20:
        return receipt.heartbeatPid
    if index == 21:
        return receipt.healthCheckedAtNs
    if index == 22:
        return receipt.registeredAtNs
    if index == 23:
        return receipt.active ? int64(1) : int64(0)
    if index == 24:
        return receipt.registeredServiceHash
    return int64(-1)

fn depinInferenceTransportResidencySettlementDaemonRegisteredServiceFileBytes(receipt: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt): Result[rawbytes.Bytes] =
    if receipt.registeredServiceHash <= int64(0):
        return Err[rawbytes.Bytes]("depin residency settlement daemon registered service: service hash")
    let byteCount = DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin residency settlement daemon registered service: allocation")
    for i in 0..<DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportResidencySettlementDaemonRegisteredServiceReceiptBuild(path: str,
                                                                                  bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWordCount * 8:
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileMagic) ||
       version != int64(DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileVersion):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: header")
    let kindHash = engine.DistributedReadI64LE(bytesRaw, 56)
    let kindRes = depinInferenceTransportResidencySettlementDaemonOsServiceKindFromHash(kindHash)
    if IsErr(kindRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(kindRes))
    let prefixRes = depinInferenceTransportResidencySettlementDaemonRegisteredServicePrefixFromReceiptPath(path)
    if IsErr(prefixRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(prefixRes))
    let activeRaw = engine.DistributedReadI64LE(bytesRaw, 184)
    if activeRaw != int64(0) && activeRaw != int64(1):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: active")
    var receipt = DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceSchema,
        receiptPath: path,
        serviceKind: Value(kindRes),
        serviceName: "",
        executablePath: "",
        workingDirectory: "",
        osServiceSpecReceiptPath: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptPathFromPrefix(Value(prefixRes)),
        startupBundlePath: DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(Value(prefixRes)),
        healthReceiptPath: DepinInferenceTransportResidencySettlementDaemonHealthReceiptPathFromPrefix(Value(prefixRes)),
        configHash: engine.DistributedReadI64LE(bytesRaw, 16),
        daemonIdHash: engine.DistributedReadI64LE(bytesRaw, 24),
        eventStreamHash: engine.DistributedReadI64LE(bytesRaw, 32),
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 40),
        baseStoreHash: engine.DistributedReadI64LE(bytesRaw, 48),
        serviceKindHash: kindHash,
        serviceNameHash: engine.DistributedReadI64LE(bytesRaw, 64),
        executablePathHash: engine.DistributedReadI64LE(bytesRaw, 72),
        workingDirectoryHash: engine.DistributedReadI64LE(bytesRaw, 80),
        osServiceSpecReceiptHash: engine.DistributedReadI64LE(bytesRaw, 112),
        osServiceSpecSpecByteHash: engine.DistributedReadI64LE(bytesRaw, 120),
        osServiceSpecTriggerSpecByteHash: engine.DistributedReadI64LE(bytesRaw, 128),
        startupBundleReceiptHash: engine.DistributedReadI64LE(bytesRaw, 136),
        startupBundleByteHash: engine.DistributedReadI64LE(bytesRaw, 144),
        healthReceiptHash: engine.DistributedReadI64LE(bytesRaw, 152),
        heartbeatPid: engine.DistributedReadI64LE(bytesRaw, 160),
        healthCheckedAtNs: engine.DistributedReadI64LE(bytesRaw, 168),
        registeredAtNs: engine.DistributedReadI64LE(bytesRaw, 176),
        active: activeRaw == int64(1),
        registeredServiceHash: engine.DistributedReadI64LE(bytesRaw, 192),
        byteCount: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWordCount * 8,
        byteHash: depinInferenceTransportResidencySettlementDaemonRegisteredServiceFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinInferenceTransportResidencySettlementDaemonRegisteredServiceHash(receipt) != receipt.registeredServiceHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: service hash")
    receipt.receiptHash = DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceiptHash(receipt)
    return Ok[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](receipt)

fn DepinInferenceTransportReadResidencySettlementDaemonRegisteredServiceReceiptFile(path: str): Result[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportResidencySettlementDaemonRegisteredServiceReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateResidencySettlementDaemonRegisteredServiceReceiptSelf(receipt: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportResidencySettlementDaemonRegisteredServiceSchema ||
       receipt.receiptPath == "" ||
       receipt.serviceKind == "" ||
       receipt.osServiceSpecReceiptPath == "" ||
       receipt.startupBundlePath == "" ||
       receipt.healthReceiptPath == "" ||
       receipt.configHash <= int64(0) ||
       receipt.daemonIdHash <= int64(0) ||
       receipt.eventStreamHash <= int64(0) ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.baseStoreHash <= int64(0) ||
       receipt.serviceKindHash <= int64(0) ||
       receipt.serviceNameHash <= int64(0) ||
       receipt.executablePathHash <= int64(0) ||
       receipt.workingDirectoryHash <= int64(0) ||
       receipt.osServiceSpecReceiptHash <= int64(0) ||
       receipt.osServiceSpecSpecByteHash <= int64(0) ||
       receipt.startupBundleReceiptHash <= int64(0) ||
       receipt.startupBundleByteHash <= int64(0) ||
       receipt.healthReceiptHash <= int64(0) ||
       receipt.healthCheckedAtNs <= int64(0) ||
       receipt.registeredAtNs <= int64(0) ||
       receipt.registeredServiceHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWordCount * 8:
        return Err[bool]("depin residency settlement daemon registered service: fields")
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(receipt.serviceKind)
    if IsErr(kindHash):
        return Err[bool](Error(kindHash))
    if Value(kindHash) != receipt.serviceKindHash:
        return Err[bool]("depin residency settlement daemon registered service: kind")
    let prefixRes = depinInferenceTransportResidencySettlementDaemonRegisteredServicePrefixFromReceiptPath(receipt.receiptPath)
    if IsErr(prefixRes):
        return Err[bool](Error(prefixRes))
    if receipt.osServiceSpecReceiptPath != DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptPathFromPrefix(Value(prefixRes)) ||
       receipt.startupBundlePath != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(Value(prefixRes)) ||
       receipt.healthReceiptPath != DepinInferenceTransportResidencySettlementDaemonHealthReceiptPathFromPrefix(Value(prefixRes)):
        return Err[bool]("depin residency settlement daemon registered service: paths")
    if DepinInferenceTransportResidencySettlementDaemonRegisteredServiceHash(receipt) != receipt.registeredServiceHash:
        return Err[bool]("depin residency settlement daemon registered service: service hash")
    if DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon registered service: receipt hash")
    let readRes = DepinInferenceTransportReadResidencySettlementDaemonRegisteredServiceReceiptFile(receipt.receiptPath)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).registeredServiceHash != receipt.registeredServiceHash ||
       Value(readRes).receiptHash != receipt.receiptHash ||
       Value(readRes).byteHash != receipt.byteHash:
        return Err[bool]("depin residency settlement daemon registered service: readback")
    let osSpecRead = DepinInferenceTransportReadResidencySettlementDaemonOsServiceSpecReceiptFile(receipt.osServiceSpecReceiptPath)
    if IsErr(osSpecRead):
        return Err[bool](Error(osSpecRead))
    let osSpec = Value(osSpecRead)
    if osSpec.receiptHash != receipt.osServiceSpecReceiptHash ||
       osSpec.specByteHash != receipt.osServiceSpecSpecByteHash ||
       osSpec.triggerSpecByteHash != receipt.osServiceSpecTriggerSpecByteHash ||
       osSpec.serviceKind != receipt.serviceKind ||
       osSpec.serviceKindHash != receipt.serviceKindHash ||
       osSpec.serviceNameHash != receipt.serviceNameHash ||
       osSpec.executablePathHash != receipt.executablePathHash ||
       osSpec.workingDirectoryHash != receipt.workingDirectoryHash ||
       osSpec.startupBundleReceiptHash != receipt.startupBundleReceiptHash ||
       osSpec.startupBundlePath != receipt.startupBundlePath ||
       osSpec.configHash != receipt.configHash ||
       osSpec.daemonIdHash != receipt.daemonIdHash ||
       osSpec.eventStreamHash != receipt.eventStreamHash ||
       osSpec.enginePlanHash != receipt.enginePlanHash ||
       osSpec.baseStoreHash != receipt.baseStoreHash:
        return Err[bool]("depin residency settlement daemon registered service: os service spec binding")
    let osSpecOk = DepinInferenceTransportValidateResidencySettlementDaemonOsServiceSpecReceipt(osSpec)
    if IsErr(osSpecOk):
        return Err[bool](Error(osSpecOk))
    let startupRead = DepinInferenceTransportReadResidencySettlementDaemonStartupBundleReceiptFile(receipt.startupBundlePath)
    if IsErr(startupRead):
        return Err[bool](Error(startupRead))
    let startup = Value(startupRead)
    if startup.receiptHash != receipt.startupBundleReceiptHash ||
       startup.byteHash != receipt.startupBundleByteHash ||
       startup.configHash != receipt.configHash ||
       startup.daemonIdHash != receipt.daemonIdHash ||
       startup.eventStreamHash != receipt.eventStreamHash ||
       startup.enginePlanHash != receipt.enginePlanHash ||
       startup.baseStoreHash != receipt.baseStoreHash:
        return Err[bool]("depin residency settlement daemon registered service: startup bundle binding")
    let startupOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startup)
    if IsErr(startupOk):
        return Err[bool](Error(startupOk))
    let healthRead = DepinInferenceTransportReadResidencySettlementDaemonHealthReceiptFile(receipt.healthReceiptPath)
    if IsErr(healthRead):
        return Err[bool](Error(healthRead))
    let health = Value(healthRead)
    if health.receiptHash != receipt.healthReceiptHash ||
       health.processPid != receipt.heartbeatPid ||
       health.checkedAtNs != receipt.healthCheckedAtNs ||
       health.startupBundleReceiptHash != receipt.startupBundleReceiptHash ||
       health.startupBundlePath != receipt.startupBundlePath ||
       health.configHash != receipt.configHash ||
       health.enginePlanHash != receipt.enginePlanHash:
        return Err[bool]("depin residency settlement daemon registered service: health binding")
    let healthOk = DepinInferenceTransportValidateResidencySettlementDaemonHealthReceiptSelf(health)
    if IsErr(healthOk):
        return Err[bool](Error(healthOk))
    return Ok[bool](true)

fn DepinInferenceTransportValidateResidencySettlementDaemonRegisteredServiceReceipt(receipt: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt,
                                                                                     expectedServiceKind: str,
                                                                                     expectedServiceName: str,
                                                                                     requireActive: bool): Result[bool] =
    let selfOk = DepinInferenceTransportValidateResidencySettlementDaemonRegisteredServiceReceiptSelf(receipt)
    if IsErr(selfOk):
        return Err[bool](Error(selfOk))
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(expectedServiceKind)
    if IsErr(kindHash):
        return Err[bool](Error(kindHash))
    if receipt.serviceKind != expectedServiceKind ||
       Value(kindHash) != receipt.serviceKindHash ||
       receipt.serviceNameHash != DepinSettlementTextHash(expectedServiceName):
        return Err[bool]("depin residency settlement daemon registered service: expected binding")
    if requireActive && !receipt.active:
        return Err[bool]("depin residency settlement daemon registered service: inactive")
    return Ok[bool](true)

fn DepinInferenceTransportWriteResidencySettlementDaemonRegisteredServiceReceiptFile(path: str,
                                                                                      draft: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt): Result[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportResidencySettlementDaemonRegisteredServiceSchema
    receipt.receiptPath = path
    receipt.byteCount = DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.registeredServiceHash = DepinInferenceTransportResidencySettlementDaemonRegisteredServiceHash(receipt)
    let bytesRes = depinInferenceTransportResidencySettlementDaemonRegisteredServiceFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       depinInferenceTransportResidencySettlementDaemonRegisteredServiceFileByteHash(readBytes) != depinInferenceTransportResidencySettlementDaemonRegisteredServiceFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: readback")
    let receiptRes = depinInferenceTransportResidencySettlementDaemonRegisteredServiceReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateResidencySettlementDaemonRegisteredServiceReceiptSelf(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportRegisterResidencySettlementDaemonService(plan: engine.DistributedInferencePlan,
                                                                    baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                                    config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                    startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                    osServiceSpec: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt,
                                                                    health: DepinInferenceTransportResidencySettlementDaemonHealthReceipt,
                                                                    serviceKind: str,
                                                                    serviceName: str,
                                                                    executablePath: str,
                                                                    workingDirectory: str,
                                                                    registeredAtNs: int64): Result[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(configOk))
    if baseKvResidencyStore.storeHash <= int64(0) || registeredAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: args")
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(serviceKind)
    if IsErr(kindHash):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(kindHash))
    let bundleOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startupBundle)
    if IsErr(bundleOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(bundleOk))
    let osSpecOk = DepinInferenceTransportValidateResidencySettlementDaemonOsServiceSpecReceipt(osServiceSpec)
    if IsErr(osSpecOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(osSpecOk))
    let healthOk = DepinInferenceTransportValidateResidencySettlementDaemonHealthReceiptSelf(health)
    if IsErr(healthOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(healthOk))
    if startupBundle.configHash != config.configHash ||
       startupBundle.enginePlanHash != plan.engineHash ||
       startupBundle.baseStoreHash != baseKvResidencyStore.storeHash ||
       startupBundle.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: startup bundle")
    if osServiceSpec.configHash != config.configHash ||
       osServiceSpec.enginePlanHash != plan.engineHash ||
       osServiceSpec.baseStoreHash != baseKvResidencyStore.storeHash ||
       osServiceSpec.startupBundlePath != startupBundle.path ||
       osServiceSpec.startupBundleReceiptHash != startupBundle.receiptHash ||
       osServiceSpec.serviceKind != serviceKind ||
       osServiceSpec.serviceKindHash != Value(kindHash) ||
       osServiceSpec.serviceNameHash != DepinSettlementTextHash(serviceName) ||
       osServiceSpec.executablePathHash != DepinSettlementTextHash(executablePath) ||
       osServiceSpec.workingDirectoryHash != DepinSettlementTextHash(workingDirectory) ||
       osServiceSpec.receiptPath != DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptPathFromPrefix(config.residencyPathPrefix):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: os service spec binding")
    if health.startupBundlePath != startupBundle.path ||
       health.startupBundleReceiptHash != startupBundle.receiptHash ||
       health.configHash != config.configHash ||
       health.enginePlanHash != plan.engineHash ||
       health.path != DepinInferenceTransportResidencySettlementDaemonHealthReceiptPathFromPrefix(config.residencyPathPrefix):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: health binding")
    let receiptPath = DepinInferenceTransportResidencySettlementDaemonRegisteredServicePathFromPrefix(config.residencyPathPrefix)
    var draft = DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceSchema,
        receiptPath: receiptPath,
        serviceKind: serviceKind,
        serviceName: serviceName,
        executablePath: executablePath,
        workingDirectory: workingDirectory,
        osServiceSpecReceiptPath: osServiceSpec.receiptPath,
        startupBundlePath: startupBundle.path,
        healthReceiptPath: health.path,
        configHash: config.configHash,
        daemonIdHash: DepinSettlementTextHash(config.daemonId),
        eventStreamHash: DepinSettlementTextHash(config.eventStreamId),
        enginePlanHash: plan.engineHash,
        baseStoreHash: baseKvResidencyStore.storeHash,
        serviceKindHash: Value(kindHash),
        serviceNameHash: DepinSettlementTextHash(serviceName),
        executablePathHash: DepinSettlementTextHash(executablePath),
        workingDirectoryHash: DepinSettlementTextHash(workingDirectory),
        osServiceSpecReceiptHash: osServiceSpec.receiptHash,
        osServiceSpecSpecByteHash: osServiceSpec.specByteHash,
        osServiceSpecTriggerSpecByteHash: osServiceSpec.triggerSpecByteHash,
        startupBundleReceiptHash: startupBundle.receiptHash,
        startupBundleByteHash: startupBundle.byteHash,
        healthReceiptHash: health.receiptHash,
        heartbeatPid: health.processPid,
        healthCheckedAtNs: health.checkedAtNs,
        registeredAtNs: registeredAtNs,
        active: true,
        registeredServiceHash: int64(0),
        byteCount: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWordCount * 8,
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteResidencySettlementDaemonRegisteredServiceReceiptFile(receiptPath, draft)

fn DepinInferenceTransportUnregisterResidencySettlementDaemonService(receiptPath: str): Result[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt] =
    let readRes = DepinInferenceTransportReadResidencySettlementDaemonRegisteredServiceReceiptFile(receiptPath)
    if IsErr(readRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(readRes))
    var receipt = Value(readRes)
    if !receipt.active:
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: already inactive")
    receipt.active = false
    return DepinInferenceTransportWriteResidencySettlementDaemonRegisteredServiceReceiptFile(receiptPath, receipt)

fn DepinInferenceTransportResidencyStoreNetworkReplicationPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csnr1"], "")

fn depinInferenceTransportResidencyStoreNetworkReplicationPrefixFromReceiptPath(receiptPath: str): Result[str] =
    if !strings.HasSuffix(receiptPath, ".csnr1"):
        return Err[str]("depin residency store network replication: receipt suffix")
    let n = strings.Len(receiptPath)
    if n <= 6:
        return Err[str]("depin residency store network replication: receipt path")
    return Ok[str](strings.SliceBytes(receiptPath, 0, n - 6))

fn DepinInferenceTransportResidencyStoreNetworkReplicationHash(receipt: DepinInferenceTransportResidencyStoreNetworkReplicationReceipt): int64 =
    var h: int64 = int64(311)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.storeRootByteHash)
    h = engine.DistributedHashStep(h, receipt.storeRootReceiptHash)
    h = engine.DistributedHashStep(h, receipt.ledgerHash)
    h = engine.DistributedHashStep(h, receipt.quorumReceiptHash)
    h = engine.DistributedHashStep(h, receipt.replicaPeerSetHash)
    h = engine.DistributedHashStep(h, receipt.replicaLedgerByteHashSetHash)
    h = engine.DistributedHashStep(h, receipt.replicationFrameSetHash)
    h = engine.DistributedHashStep(h, int64(receipt.replicationQuorum))
    h = engine.DistributedHashStep(h, int64(receipt.successfulReplicaCount))
    h = engine.DistributedHashStep(h, receipt.replicatedAtNs)
    return h

fn DepinInferenceTransportResidencyStoreNetworkReplicationReceiptHash(receipt: DepinInferenceTransportResidencyStoreNetworkReplicationReceipt): int64 =
    var h: int64 = int64(313)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.receiptPath)
    h = engine.DistributedHashTextWith(h, receipt.quorumReceiptPath)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.storeRootByteHash)
    h = engine.DistributedHashStep(h, receipt.storeRootReceiptHash)
    h = engine.DistributedHashStep(h, receipt.ledgerHash)
    h = engine.DistributedHashStep(h, receipt.quorumReceiptHash)
    h = engine.DistributedHashStep(h, receipt.replicaPeerSetHash)
    h = engine.DistributedHashStep(h, receipt.replicaLedgerByteHashSetHash)
    h = engine.DistributedHashStep(h, receipt.replicationFrameSetHash)
    h = engine.DistributedHashStep(h, int64(receipt.replicationQuorum))
    h = engine.DistributedHashStep(h, int64(receipt.successfulReplicaCount))
    h = engine.DistributedHashStep(h, receipt.replicatedAtNs)
    h = engine.DistributedHashStep(h, receipt.networkReplicationHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn depinInferenceTransportResidencyStoreNetworkReplicationFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(317), bytesRaw)

fn depinInferenceTransportResidencyStoreNetworkReplicationFileWord(receipt: DepinInferenceTransportResidencyStoreNetworkReplicationReceipt,
                                                                    index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportResidencyStoreNetworkReplicationFileMagic)
    if index == 1:
        return int64(DepinInferenceTransportResidencyStoreNetworkReplicationFileVersion)
    if index == 2:
        return receipt.enginePlanHash
    if index == 3:
        return receipt.storeRootByteHash
    if index == 4:
        return receipt.storeRootReceiptHash
    if index == 5:
        return receipt.ledgerHash
    if index == 6:
        return DepinSettlementTextHash(receipt.quorumReceiptPath)
    if index == 7:
        return receipt.quorumReceiptHash
    if index == 8:
        return receipt.replicaPeerSetHash
    if index == 9:
        return receipt.replicaLedgerByteHashSetHash
    if index == 10:
        return receipt.replicationFrameSetHash
    if index == 11:
        return int64(receipt.replicationQuorum)
    if index == 12:
        return int64(receipt.successfulReplicaCount)
    if index == 13:
        return receipt.replicatedAtNs
    if index == 14:
        return receipt.networkReplicationHash
    return int64(-1)

fn depinInferenceTransportResidencyStoreNetworkReplicationFileBytes(receipt: DepinInferenceTransportResidencyStoreNetworkReplicationReceipt): Result[rawbytes.Bytes] =
    if receipt.networkReplicationHash <= int64(0):
        return Err[rawbytes.Bytes]("depin residency store network replication: network hash")
    let byteCount = DepinInferenceTransportResidencyStoreNetworkReplicationFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin residency store network replication: allocation")
    for i in 0..<DepinInferenceTransportResidencyStoreNetworkReplicationFileWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportResidencyStoreNetworkReplicationFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportResidencyStoreNetworkReplicationReceiptBuild(path: str,
                                                                        bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportResidencyStoreNetworkReplicationFileWordCount * 8:
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportResidencyStoreNetworkReplicationFileMagic) ||
       version != int64(DepinInferenceTransportResidencyStoreNetworkReplicationFileVersion):
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: header")
    let prefixRes = depinInferenceTransportResidencyStoreNetworkReplicationPrefixFromReceiptPath(path)
    if IsErr(prefixRes):
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt](Error(prefixRes))
    let replicationQuorumRaw = engine.DistributedReadI64LE(bytesRaw, 88)
    let successfulReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 96)
    if replicationQuorumRaw <= int64(0) ||
       replicationQuorumRaw > int64(2147483647) ||
       successfulReplicaCountRaw < int64(0) ||
       successfulReplicaCountRaw > int64(2147483647):
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: ranges")
    var receipt = DepinInferenceTransportResidencyStoreNetworkReplicationReceipt(
        schema: DepinInferenceTransportResidencyStoreNetworkReplicationSchema,
        receiptPath: path,
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 16),
        storeRootByteHash: engine.DistributedReadI64LE(bytesRaw, 24),
        storeRootReceiptHash: engine.DistributedReadI64LE(bytesRaw, 32),
        ledgerHash: engine.DistributedReadI64LE(bytesRaw, 40),
        quorumReceiptPath: DepinInferenceTransportSettlementLedgerQuorumPathFromPrefix(Value(prefixRes)),
        quorumReceiptHash: engine.DistributedReadI64LE(bytesRaw, 56),
        replicaPeerSetHash: engine.DistributedReadI64LE(bytesRaw, 64),
        replicaLedgerByteHashSetHash: engine.DistributedReadI64LE(bytesRaw, 72),
        replicationFrameSetHash: engine.DistributedReadI64LE(bytesRaw, 80),
        replicationQuorum: int32(replicationQuorumRaw),
        successfulReplicaCount: int32(successfulReplicaCountRaw),
        replicatedAtNs: engine.DistributedReadI64LE(bytesRaw, 104),
        networkReplicationHash: engine.DistributedReadI64LE(bytesRaw, 112),
        byteCount: DepinInferenceTransportResidencyStoreNetworkReplicationFileWordCount * 8,
        byteHash: depinInferenceTransportResidencyStoreNetworkReplicationFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinInferenceTransportResidencyStoreNetworkReplicationHash(receipt) != receipt.networkReplicationHash:
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: network hash")
    receipt.receiptHash = DepinInferenceTransportResidencyStoreNetworkReplicationReceiptHash(receipt)
    return Ok[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt](receipt)

fn DepinInferenceTransportReadResidencyStoreNetworkReplicationReceiptFile(path: str): Result[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportResidencyStoreNetworkReplicationReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateResidencyStoreNetworkReplicationReceiptSelf(receipt: DepinInferenceTransportResidencyStoreNetworkReplicationReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportResidencyStoreNetworkReplicationSchema ||
       receipt.receiptPath == "" ||
       receipt.quorumReceiptPath == "" ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.storeRootByteHash <= int64(0) ||
       receipt.storeRootReceiptHash <= int64(0) ||
       receipt.ledgerHash <= int64(0) ||
       receipt.quorumReceiptHash <= int64(0) ||
       receipt.replicaPeerSetHash <= int64(0) ||
       receipt.replicaLedgerByteHashSetHash <= int64(0) ||
       receipt.replicationFrameSetHash <= int64(0) ||
       receipt.replicationQuorum <= 0 ||
       receipt.successfulReplicaCount < 0 ||
       receipt.replicatedAtNs <= int64(0) ||
       receipt.networkReplicationHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportResidencyStoreNetworkReplicationFileWordCount * 8:
        return Err[bool]("depin residency store network replication: fields")
    let prefixRes = depinInferenceTransportResidencyStoreNetworkReplicationPrefixFromReceiptPath(receipt.receiptPath)
    if IsErr(prefixRes):
        return Err[bool](Error(prefixRes))
    if receipt.quorumReceiptPath != DepinInferenceTransportSettlementLedgerQuorumPathFromPrefix(Value(prefixRes)):
        return Err[bool]("depin residency store network replication: quorum path")
    if DepinInferenceTransportResidencyStoreNetworkReplicationHash(receipt) != receipt.networkReplicationHash:
        return Err[bool]("depin residency store network replication: network hash")
    if DepinInferenceTransportResidencyStoreNetworkReplicationReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin residency store network replication: receipt hash")
    let readRes = DepinInferenceTransportReadResidencyStoreNetworkReplicationReceiptFile(receipt.receiptPath)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).networkReplicationHash != receipt.networkReplicationHash ||
       Value(readRes).receiptHash != receipt.receiptHash ||
       Value(readRes).byteHash != receipt.byteHash:
        return Err[bool]("depin residency store network replication: readback")
    let quorumRead = DepinInferenceTransportReadSettlementLedgerQuorumReceiptFile(receipt.quorumReceiptPath)
    if IsErr(quorumRead):
        return Err[bool](Error(quorumRead))
    let quorum = Value(quorumRead)
    if quorum.receiptHash != receipt.quorumReceiptHash ||
       quorum.enginePlanHash != receipt.enginePlanHash ||
       quorum.ledgerHash != receipt.ledgerHash ||
       quorum.ledgerReceiptHash != receipt.storeRootReceiptHash ||
       quorum.ledgerByteHash != receipt.storeRootByteHash ||
       quorum.targetPeerSetHash != receipt.replicaPeerSetHash ||
       quorum.replicaByteHashSetHash != receipt.replicaLedgerByteHashSetHash ||
       quorum.ackFrameSetHash != receipt.replicationFrameSetHash ||
       quorum.requiredReplicaCount != receipt.replicationQuorum ||
       quorum.successfulReplicaCount != receipt.successfulReplicaCount:
        return Err[bool]("depin residency store network replication: quorum binding")
    let quorumOk = DepinInferenceTransportValidateSettlementLedgerQuorumFileReceipt(quorum)
    if IsErr(quorumOk):
        return Err[bool](Error(quorumOk))
    return Ok[bool](true)

fn DepinInferenceTransportValidateResidencyStoreNetworkReplicationReceipt(receipt: DepinInferenceTransportResidencyStoreNetworkReplicationReceipt,
                                                                           expectedStoreRootByteHash: int64,
                                                                           requiredQuorum: int32): Result[bool] =
    let selfOk = DepinInferenceTransportValidateResidencyStoreNetworkReplicationReceiptSelf(receipt)
    if IsErr(selfOk):
        return Err[bool](Error(selfOk))
    if receipt.storeRootByteHash != expectedStoreRootByteHash:
        return Err[bool]("depin residency store network replication: store root")
    if receipt.replicationQuorum < requiredQuorum:
        return Err[bool]("depin residency store network replication: required quorum")
    if receipt.successfulReplicaCount < receipt.replicationQuorum:
        return Err[bool]("depin residency store network replication: successful replica count")
    return Ok[bool](true)

fn DepinInferenceTransportWriteResidencyStoreNetworkReplicationReceiptFile(path: str,
                                                                            draft: DepinInferenceTransportResidencyStoreNetworkReplicationReceipt): Result[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportResidencyStoreNetworkReplicationSchema
    receipt.receiptPath = path
    receipt.byteCount = DepinInferenceTransportResidencyStoreNetworkReplicationFileWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.networkReplicationHash = DepinInferenceTransportResidencyStoreNetworkReplicationHash(receipt)
    let bytesRes = depinInferenceTransportResidencyStoreNetworkReplicationFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       depinInferenceTransportResidencyStoreNetworkReplicationFileByteHash(readBytes) != depinInferenceTransportResidencyStoreNetworkReplicationFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: readback")
    let receiptRes = depinInferenceTransportResidencyStoreNetworkReplicationReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateResidencyStoreNetworkReplicationReceiptSelf(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportWriteResidencyStoreNetworkReplicationReceipt(prefix: str,
                                                                        plan: engine.DistributedInferencePlan,
                                                                        quorumFileReceipt: DepinInferenceTransportSettlementLedgerQuorumFileReceipt,
                                                                        replicatedAtNs: int64): Result[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt] =
    if prefix == "" || replicatedAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: args")
    let quorumOk = DepinInferenceTransportValidateSettlementLedgerQuorumFileReceipt(quorumFileReceipt)
    if IsErr(quorumOk):
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt](Error(quorumOk))
    if quorumFileReceipt.enginePlanHash != plan.engineHash ||
       quorumFileReceipt.ledgerByteHash <= int64(0) ||
       quorumFileReceipt.ledgerReceiptHash <= int64(0) ||
       quorumFileReceipt.requiredReplicaCount <= 0:
        return Err[DepinInferenceTransportResidencyStoreNetworkReplicationReceipt]("depin residency store network replication: quorum fields")
    let receiptPath = DepinInferenceTransportResidencyStoreNetworkReplicationPathFromPrefix(prefix)
    var draft = DepinInferenceTransportResidencyStoreNetworkReplicationReceipt(
        schema: DepinInferenceTransportResidencyStoreNetworkReplicationSchema,
        receiptPath: receiptPath,
        enginePlanHash: quorumFileReceipt.enginePlanHash,
        storeRootByteHash: quorumFileReceipt.ledgerByteHash,
        storeRootReceiptHash: quorumFileReceipt.ledgerReceiptHash,
        ledgerHash: quorumFileReceipt.ledgerHash,
        quorumReceiptPath: quorumFileReceipt.path,
        quorumReceiptHash: quorumFileReceipt.quorumReceiptHash,
        replicaPeerSetHash: quorumFileReceipt.targetPeerSetHash,
        replicaLedgerByteHashSetHash: quorumFileReceipt.replicaByteHashSetHash,
        replicationFrameSetHash: quorumFileReceipt.ackFrameSetHash,
        replicationQuorum: quorumFileReceipt.requiredReplicaCount,
        successfulReplicaCount: quorumFileReceipt.successfulReplicaCount,
        replicatedAtNs: replicatedAtNs,
        networkReplicationHash: int64(0),
        byteCount: DepinInferenceTransportResidencyStoreNetworkReplicationFileWordCount * 8,
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteResidencyStoreNetworkReplicationReceiptFile(receiptPath, draft)

fn depinInferenceTransportResidencySettlementDaemonRegisteredServiceDraft(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                           startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                           osServiceSpec: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt,
                                                                           health: DepinInferenceTransportResidencySettlementDaemonHealthReceipt,
                                                                           serviceKind: str,
                                                                           serviceName: str,
                                                                           executablePath: str,
                                                                           workingDirectory: str,
                                                                           registeredAtNs: int64): DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt =
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(serviceKind)
    let receiptPath = DepinInferenceTransportResidencySettlementDaemonRegisteredServicePathFromPrefix(config.residencyPathPrefix)
    return DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceSchema,
        receiptPath: receiptPath,
        serviceKind: serviceKind,
        serviceName: serviceName,
        executablePath: executablePath,
        workingDirectory: workingDirectory,
        osServiceSpecReceiptPath: osServiceSpec.receiptPath,
        startupBundlePath: startupBundle.path,
        healthReceiptPath: health.path,
        configHash: config.configHash,
        daemonIdHash: DepinSettlementTextHash(config.daemonId),
        eventStreamHash: DepinSettlementTextHash(config.eventStreamId),
        enginePlanHash: startupBundle.enginePlanHash,
        baseStoreHash: startupBundle.baseStoreHash,
        serviceKindHash: Value(kindHash),
        serviceNameHash: DepinSettlementTextHash(serviceName),
        executablePathHash: DepinSettlementTextHash(executablePath),
        workingDirectoryHash: DepinSettlementTextHash(workingDirectory),
        osServiceSpecReceiptHash: osServiceSpec.receiptHash,
        osServiceSpecSpecByteHash: osServiceSpec.specByteHash,
        osServiceSpecTriggerSpecByteHash: osServiceSpec.triggerSpecByteHash,
        startupBundleReceiptHash: startupBundle.receiptHash,
        startupBundleByteHash: startupBundle.byteHash,
        healthReceiptHash: health.receiptHash,
        heartbeatPid: health.processPid,
        healthCheckedAtNs: health.checkedAtNs,
        registeredAtNs: registeredAtNs,
        active: true,
        registeredServiceHash: int64(0),
        byteCount: DepinInferenceTransportResidencySettlementDaemonRegisteredServiceFileWordCount * 8,
        byteHash: int64(0),
        receiptHash: int64(0)
    )

fn DepinInferenceTransportRegisterResidencySettlementDaemonServiceFromReceipts(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                                startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                                osServiceSpec: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt,
                                                                                health: DepinInferenceTransportResidencySettlementDaemonHealthReceipt,
                                                                                serviceKind: str,
                                                                                serviceName: str,
                                                                                executablePath: str,
                                                                                workingDirectory: str,
                                                                                registeredAtNs: int64): Result[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(configOk))
    if registeredAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: args")
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(serviceKind)
    if IsErr(kindHash):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(kindHash))
    let bundleOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startupBundle)
    if IsErr(bundleOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(bundleOk))
    let osSpecOk = DepinInferenceTransportValidateResidencySettlementDaemonOsServiceSpecReceipt(osServiceSpec)
    if IsErr(osSpecOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(osSpecOk))
    let healthOk = DepinInferenceTransportValidateResidencySettlementDaemonHealthReceiptSelf(health)
    if IsErr(healthOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt](Error(healthOk))
    if startupBundle.configHash != config.configHash ||
       startupBundle.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: startup bundle")
    if osServiceSpec.configHash != config.configHash ||
       osServiceSpec.startupBundlePath != startupBundle.path ||
       osServiceSpec.startupBundleReceiptHash != startupBundle.receiptHash ||
       osServiceSpec.serviceKind != serviceKind ||
       osServiceSpec.serviceKindHash != Value(kindHash) ||
       osServiceSpec.serviceNameHash != DepinSettlementTextHash(serviceName) ||
       osServiceSpec.executablePathHash != DepinSettlementTextHash(executablePath) ||
       osServiceSpec.workingDirectoryHash != DepinSettlementTextHash(workingDirectory) ||
       osServiceSpec.receiptPath != DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptPathFromPrefix(config.residencyPathPrefix):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: os service spec binding")
    if health.startupBundlePath != startupBundle.path ||
       health.startupBundleReceiptHash != startupBundle.receiptHash ||
       health.configHash != config.configHash ||
       health.path != DepinInferenceTransportResidencySettlementDaemonHealthReceiptPathFromPrefix(config.residencyPathPrefix):
        return Err[DepinInferenceTransportResidencySettlementDaemonRegisteredServiceReceipt]("depin residency settlement daemon registered service: health binding")
    let draft = depinInferenceTransportResidencySettlementDaemonRegisteredServiceDraft(config, startupBundle, osServiceSpec, health, serviceKind, serviceName, executablePath, workingDirectory, registeredAtNs)
    return DepinInferenceTransportWriteResidencySettlementDaemonRegisteredServiceReceiptFile(draft.receiptPath, draft)
