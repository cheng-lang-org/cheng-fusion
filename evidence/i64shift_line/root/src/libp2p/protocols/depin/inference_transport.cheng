fn DepinInferenceTransportDispatchSessionReceiptHash(receipt: DepinInferenceTransportDispatchSessionReceipt): int64 =
    var h: int64 = int64(89)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.sessionId)
    h = engine.DistributedHashStep(h, receipt.manifestHash)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashTextWith(h, receipt.specDecodeAlgorithm)
    h = engine.DistributedHashStep(h, receipt.specDecodePlanHash)
    h = engine.DistributedHashStep(h, receipt.specDecodeCertifiedReceiptHash)
    h = engine.DistributedHashStep(h, receipt.requestSetHash)
    h = engine.DistributedHashStep(h, receipt.responseSetHash)
    h = engine.DistributedHashStep(h, receipt.receiptSetHash)
    h = engine.DistributedHashStep(h, receipt.transportFrameSetHash)
    h = engine.DistributedHashStep(h, receipt.evidenceHash)
    h = engine.DistributedHashStep(h, receipt.kvPageTransferEvidenceHash)
    h = engine.DistributedHashStep(h, receipt.kvPageResidencyReceiptHash)
    h = engine.DistributedHashStep(h, receipt.kvResidencyScheduleHash)
    h = engine.DistributedHashStep(h, receipt.kvResidencyStoreOperationHash)
    h = engine.DistributedHashStep(h, receipt.kvResidencyStoreHash)
    h = engine.DistributedHashStep(h, receipt.kvResidencyWalRecordHash)
    h = engine.DistributedHashStep(h, receipt.kvResidencyWalLogHash)
    h = engine.DistributedHashStep(h, receipt.kvResidencyWalAppendHash)
    h = engine.DistributedHashStep(h, receipt.kvResidencyServiceCommitHash)
    h = engine.DistributedHashStep(h, receipt.kvResidencyServiceApplyHash)
    h = engine.DistributedHashStep(h, int64(receipt.bytesWritten))
    h = engine.DistributedHashStep(h, int64(receipt.bytesRead))
    h = engine.DistributedHashTextWith(h, receipt.settlementTxHash)
    h = engine.DistributedHashStep(h, receipt.settlementLedgerHash)
    h = engine.DistributedHashStep(h, receipt.settlementLedgerReceiptHash)
    h = engine.DistributedHashStep(h, receipt.settlementLedgerReplicationHash)
    h = engine.DistributedHashStep(h, receipt.settlementLedgerAckHash)
    h = engine.DistributedHashStep(h, int64(receipt.settlementLedgerReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.settlementLedgerReplicaQuorum))
    h = engine.DistributedHashStep(h, receipt.settlementLedgerQuorumFileReceiptHash)
    h = engine.DistributedHashStep(h, int64(receipt.settlementLedgerReplicaAttemptCount))
    h = engine.DistributedHashStep(h, receipt.settlementLedgerReplicaAttemptSetHash)
    return h

fn DepinInferenceTransportDispatchSessionReceiptBuild(draft: DepinInferenceTransportDispatchSessionReceipt): DepinInferenceTransportDispatchSessionReceipt =
    var receipt = draft
    receipt.schema = DepinInferenceTransportDispatchSessionReceiptSchema
    receipt.receiptHash = int64(0)
    receipt.receiptHash = DepinInferenceTransportDispatchSessionReceiptHash(receipt)
    return receipt

fn DepinInferenceTransportValidateDispatchSessionReceipt(receipt: DepinInferenceTransportDispatchSessionReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportDispatchSessionReceiptSchema:
        return Err[bool]("depin inference dispatch session receipt: schema")
    if receipt.sessionId == "" || receipt.settlementTxHash == "" || receipt.specDecodeAlgorithm == "":
        return Err[bool]("depin inference dispatch session receipt: identity")
    if receipt.specDecodeAlgorithm != engine.DistributedSpecDecodeAlgorithmNone &&
       receipt.specDecodeAlgorithm != engine.DistributedSpecDecodeAlgorithmMtp &&
       receipt.specDecodeAlgorithm != engine.DistributedSpecDecodeAlgorithmEagleMtp:
        return Err[bool]("depin inference dispatch session receipt: spec algorithm")
    if receipt.specDecodeAlgorithm == engine.DistributedSpecDecodeAlgorithmNone:
        if receipt.specDecodeCertifiedReceiptHash != int64(0):
            return Err[bool]("depin inference dispatch session receipt: spec disabled receipt")
    elif receipt.specDecodeCertifiedReceiptHash <= int64(0):
        return Err[bool]("depin inference dispatch session receipt: spec certified receipt")
    if receipt.manifestHash <= int64(0) ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.specDecodePlanHash <= int64(0) ||
       receipt.requestSetHash <= int64(0) ||
       receipt.responseSetHash <= int64(0) ||
       receipt.receiptSetHash <= int64(0) ||
       receipt.transportFrameSetHash <= int64(0) ||
       receipt.evidenceHash <= int64(0) ||
       receipt.kvPageTransferEvidenceHash <= int64(0) ||
       receipt.kvPageResidencyReceiptHash <= int64(0) ||
       receipt.kvResidencyScheduleHash <= int64(0) ||
       receipt.kvResidencyStoreOperationHash <= int64(0) ||
       receipt.kvResidencyStoreHash <= int64(0) ||
       receipt.kvResidencyWalRecordHash <= int64(0) ||
       receipt.kvResidencyWalLogHash <= int64(0) ||
       receipt.kvResidencyWalAppendHash <= int64(0) ||
       receipt.kvResidencyServiceCommitHash <= int64(0) ||
       receipt.kvResidencyServiceApplyHash <= int64(0) ||
       receipt.settlementLedgerHash <= int64(0) ||
       receipt.settlementLedgerReceiptHash <= int64(0) ||
       receipt.settlementLedgerReplicationHash <= int64(0) ||
       receipt.settlementLedgerAckHash <= int64(0) ||
       receipt.settlementLedgerReplicaCount <= 0 ||
       receipt.settlementLedgerReplicaQuorum <= 0 ||
       receipt.settlementLedgerReplicaQuorum > receipt.settlementLedgerReplicaCount ||
       receipt.settlementLedgerQuorumFileReceiptHash <= int64(0) ||
       receipt.settlementLedgerReplicaAttemptCount <= 0 ||
       receipt.settlementLedgerReplicaAttemptSetHash <= int64(0):
        return Err[bool]("depin inference dispatch session receipt: hashes")
    if receipt.bytesWritten <= 0 || receipt.bytesRead <= 0:
        return Err[bool]("depin inference dispatch session receipt: io")
    if DepinInferenceTransportDispatchSessionReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin inference dispatch session receipt: hash mismatch")
    return Ok[bool](true)

fn DepinInferenceTransportSettlementFrameHash(frame: pipe.DepinInferenceWireFrame): int64 =
    var h: int64 = int64(269)
    h = engine.DistributedHashStep(h, frame.magic)
    h = engine.DistributedHashStep(h, frame.frameKind)
    h = engine.DistributedHashStep(h, frame.enginePlanHash)
    h = engine.DistributedHashStep(h, frame.seqNo)
    h = engine.DistributedHashStep(h, frame.coordinatorPeerHash)
    h = engine.DistributedHashStep(h, frame.sourcePeerHash)
    h = engine.DistributedHashStep(h, frame.targetPeerHash)
    h = engine.DistributedHashStep(h, frame.shardNameHash)
    h = engine.DistributedHashStep(h, frame.requestHash)
    h = engine.DistributedHashStep(h, frame.responseHash)
    h = engine.DistributedHashStep(h, frame.envelopeHash)
    h = engine.DistributedHashStep(h, frame.payloadHash)
    h = engine.DistributedHashStep(h, frame.receiptHash)
    h = engine.DistributedHashStep(h, frame.sentAtNs)
    return h

fn DepinInferenceTransportBuildSettlementLedgerRequestFrame(plan: engine.DistributedInferencePlan,
                                                            sourcePeerId: str,
                                                            targetPeerId: str,
                                                            receipt: DepinSettlementLedgerFileReceipt,
                                                            seqNo: int64,
                                                            sentAtNs: int64): Result[pipe.DepinInferenceWireFrame] =
    if sourcePeerId == "" || targetPeerId == "" || seqNo < int64(0) || sentAtNs <= int64(0):
        return Err[pipe.DepinInferenceWireFrame]("depin settlement ledger replication request: args")
    let ledgerOk = DepinSettlementValidateLedgerFileReceipt(receipt)
    if IsErr(ledgerOk):
        return Err[pipe.DepinInferenceWireFrame](Error(ledgerOk))
    var frame = pipe.DepinInferenceWireFrame(
        magic: int64(pipe.DepinInferenceWireFrameMagic),
        frameKind: int64(pipe.DepinInferenceWireFrameKindRequest),
        enginePlanHash: plan.engineHash,
        seqNo: seqNo,
        coordinatorPeerHash: DepinSettlementTextHash(sourcePeerId),
        sourcePeerHash: DepinSettlementTextHash(sourcePeerId),
        targetPeerHash: DepinSettlementTextHash(targetPeerId),
        shardNameHash: engine.DistributedTransportFrameTextHash(DepinInferenceTransportSettlementLedgerShardName),
        requestHash: receipt.receiptHash,
        responseHash: int64(0),
        envelopeHash: int64(0),
        payloadHash: receipt.ledgerHash,
        receiptHash: int64(0),
        sentAtNs: sentAtNs,
        frameHash: int64(0)
    )
    frame.frameHash = DepinInferenceTransportSettlementFrameHash(frame)
    let encodedRes = pipe.DepinInferenceEncodeWireFrame(frame)
    if IsErr(encodedRes):
        return Err[pipe.DepinInferenceWireFrame](Error(encodedRes))
    var encoded = Value(encodedRes)
    BytesFree(encoded)
    return Ok[pipe.DepinInferenceWireFrame](frame)

fn DepinInferenceTransportBuildSettlementLedgerAckFrame(plan: engine.DistributedInferencePlan,
                                                        request: pipe.DepinInferenceWireFrame,
                                                        receipt: DepinSettlementLedgerFileReceipt,
                                                        replicaReceipt: DepinSettlementLedgerReplicaReceipt,
                                                        ackedAtNs: int64): Result[pipe.DepinInferenceWireFrame] =
    if ackedAtNs <= int64(0):
        return Err[pipe.DepinInferenceWireFrame]("depin settlement ledger replication ack: time")
    let ledgerOk = DepinSettlementValidateLedgerFileReceipt(receipt)
    if IsErr(ledgerOk):
        return Err[pipe.DepinInferenceWireFrame](Error(ledgerOk))
    let replicaOk = DepinSettlementValidateLedgerReplicaReceipt(replicaReceipt)
    if IsErr(replicaOk):
        return Err[pipe.DepinInferenceWireFrame](Error(replicaOk))
    if request.frameKind != int64(pipe.DepinInferenceWireFrameKindRequest) ||
       request.enginePlanHash != plan.engineHash ||
       request.requestHash != receipt.receiptHash ||
       request.payloadHash != receipt.ledgerHash:
        return Err[pipe.DepinInferenceWireFrame]("depin settlement ledger replication ack: request")
    if replicaReceipt.sourcePeerHash != request.sourcePeerHash ||
       replicaReceipt.targetPeerHash != request.targetPeerHash ||
       replicaReceipt.ledgerHash != receipt.ledgerHash ||
       replicaReceipt.ledgerReceiptHash != receipt.receiptHash ||
       replicaReceipt.ledgerByteHash != receipt.byteHash ||
       replicaReceipt.ledgerByteCount != receipt.byteCount ||
       replicaReceipt.ledgerRecordCount != receipt.recordCount ||
       replicaReceipt.ledgerHeadRecordHash != receipt.headRecordHash ||
       replicaReceipt.ledgerRecordSetHash != receipt.recordSetHash ||
       replicaReceipt.requestFrameHash != request.frameHash:
        return Err[pipe.DepinInferenceWireFrame]("depin settlement ledger replication ack: replica")
    var frame = pipe.DepinInferenceWireFrame(
        magic: int64(pipe.DepinInferenceWireFrameMagic),
        frameKind: int64(pipe.DepinInferenceWireFrameKindResponse),
        enginePlanHash: plan.engineHash,
        seqNo: request.seqNo,
        coordinatorPeerHash: request.coordinatorPeerHash,
        sourcePeerHash: request.targetPeerHash,
        targetPeerHash: request.sourcePeerHash,
        shardNameHash: request.shardNameHash,
        requestHash: request.requestHash,
        responseHash: replicaReceipt.receiptHash,
        envelopeHash: request.frameHash,
        payloadHash: receipt.ledgerHash,
        receiptHash: replicaReceipt.receiptHash,
        sentAtNs: ackedAtNs,
        frameHash: int64(0)
    )
    frame.frameHash = DepinInferenceTransportSettlementFrameHash(frame)
    let encodedRes = pipe.DepinInferenceEncodeWireFrame(frame)
    if IsErr(encodedRes):
        return Err[pipe.DepinInferenceWireFrame](Error(encodedRes))
    var encoded = Value(encodedRes)
    BytesFree(encoded)
    return Ok[pipe.DepinInferenceWireFrame](frame)

fn DepinInferenceTransportValidateSettlementLedgerAck(plan: engine.DistributedInferencePlan,
                                                      request: pipe.DepinInferenceWireFrame,
                                                      ack: pipe.DepinInferenceWireFrame,
                                                      receipt: DepinSettlementLedgerFileReceipt,
                                                      replicaReceipt: DepinSettlementLedgerReplicaReceipt): Result[bool] =
    let expectedRes = DepinInferenceTransportBuildSettlementLedgerAckFrame(plan, request, receipt, replicaReceipt, ack.sentAtNs)
    if IsErr(expectedRes):
        return Err[bool](Error(expectedRes))
    let expected = Value(expectedRes)
    if ack.magic != expected.magic ||
       ack.frameKind != expected.frameKind ||
       ack.enginePlanHash != expected.enginePlanHash ||
       ack.seqNo != expected.seqNo ||
       ack.coordinatorPeerHash != expected.coordinatorPeerHash ||
       ack.sourcePeerHash != expected.sourcePeerHash ||
       ack.targetPeerHash != expected.targetPeerHash ||
       ack.shardNameHash != expected.shardNameHash ||
       ack.requestHash != expected.requestHash ||
       ack.responseHash != expected.responseHash ||
       ack.envelopeHash != expected.envelopeHash ||
       ack.payloadHash != expected.payloadHash ||
       ack.receiptHash != expected.receiptHash ||
       ack.frameHash != expected.frameHash:
        return Err[bool]("depin settlement ledger replication ack: mismatch")
    return Ok[bool](true)

fn DepinInferenceTransportSettlementLedgerReplicationReceiptHash(receipt: DepinInferenceTransportSettlementLedgerReplicationReceipt): int64 =
    var h: int64 = int64(271)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashTextWith(h, receipt.coordinatorPeerId)
    h = engine.DistributedHashTextWith(h, receipt.sourcePeerId)
    h = engine.DistributedHashTextWith(h, receipt.targetPeerId)
    h = engine.DistributedHashStep(h, receipt.ledgerHash)
    h = engine.DistributedHashStep(h, receipt.ledgerReceiptHash)
    h = engine.DistributedHashStep(h, receipt.ledgerByteHash)
    h = engine.DistributedHashStep(h, int64(receipt.ledgerRecordCount))
    h = engine.DistributedHashStep(h, receipt.replicaReceiptHash)
    h = engine.DistributedHashStep(h, receipt.replicaByteHash)
    h = engine.DistributedHashStep(h, receipt.requestFrameHash)
    h = engine.DistributedHashStep(h, receipt.ackFrameHash)
    h = engine.DistributedHashStep(h, receipt.replicatedAtNs)
    return h

fn DepinInferenceTransportBuildSettlementLedgerReplicationReceipt(plan: engine.DistributedInferencePlan,
                                                                  coordinatorPeerId: str,
                                                                  sourcePeerId: str,
                                                                  targetPeerId: str,
                                                                  ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                                                  replicaReceipt: DepinSettlementLedgerReplicaReceipt,
                                                                  requestFrame: pipe.DepinInferenceWireFrame,
                                                                  ackFrame: pipe.DepinInferenceWireFrame,
                                                                  replicatedAtNs: int64): Result[DepinInferenceTransportSettlementLedgerReplicationReceipt] =
    if coordinatorPeerId == "" || sourcePeerId == "" || targetPeerId == "" || replicatedAtNs <= int64(0):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt]("depin settlement ledger replication receipt: args")
    let ackOk = DepinInferenceTransportValidateSettlementLedgerAck(plan, requestFrame, ackFrame, ledgerReceipt, replicaReceipt)
    if IsErr(ackOk):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(ackOk))
    if requestFrame.coordinatorPeerHash != DepinSettlementTextHash(coordinatorPeerId) ||
       requestFrame.sourcePeerHash != DepinSettlementTextHash(sourcePeerId) ||
       requestFrame.targetPeerHash != DepinSettlementTextHash(targetPeerId) ||
       ackFrame.sourcePeerHash != requestFrame.targetPeerHash ||
       ackFrame.targetPeerHash != requestFrame.sourcePeerHash:
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt]("depin settlement ledger replication receipt: peer binding")
    if replicaReceipt.sourcePeerHash != requestFrame.sourcePeerHash ||
       replicaReceipt.targetPeerHash != requestFrame.targetPeerHash ||
       replicaReceipt.ledgerReceiptHash != ledgerReceipt.receiptHash ||
       replicaReceipt.requestFrameHash != requestFrame.frameHash ||
       replicaReceipt.receiptHash != ackFrame.receiptHash:
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt]("depin settlement ledger replication receipt: replica binding")
    var receipt = DepinInferenceTransportSettlementLedgerReplicationReceipt(
        schema: DepinInferenceTransportSettlementLedgerReplicationSchema,
        enginePlanHash: plan.engineHash,
        coordinatorPeerId: coordinatorPeerId,
        sourcePeerId: sourcePeerId,
        targetPeerId: targetPeerId,
        ledgerHash: ledgerReceipt.ledgerHash,
        ledgerReceiptHash: ledgerReceipt.receiptHash,
        ledgerByteHash: ledgerReceipt.byteHash,
        ledgerRecordCount: ledgerReceipt.recordCount,
        replicaReceiptHash: replicaReceipt.receiptHash,
        replicaByteHash: replicaReceipt.byteHash,
        requestFrameHash: requestFrame.frameHash,
        ackFrameHash: ackFrame.frameHash,
        replicatedAtNs: replicatedAtNs,
        receiptHash: int64(0)
    )
    receipt.receiptHash = DepinInferenceTransportSettlementLedgerReplicationReceiptHash(receipt)
    return Ok[DepinInferenceTransportSettlementLedgerReplicationReceipt](receipt)

fn DepinInferenceTransportValidateSettlementLedgerReplicationReceipt(receipt: DepinInferenceTransportSettlementLedgerReplicationReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportSettlementLedgerReplicationSchema ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.coordinatorPeerId == "" ||
       receipt.sourcePeerId == "" ||
       receipt.targetPeerId == "" ||
       receipt.ledgerHash <= int64(0) ||
       receipt.ledgerReceiptHash <= int64(0) ||
       receipt.ledgerByteHash <= int64(0) ||
       receipt.ledgerRecordCount <= 0 ||
       receipt.replicaReceiptHash <= int64(0) ||
       receipt.replicaByteHash <= int64(0) ||
       receipt.requestFrameHash <= int64(0) ||
       receipt.ackFrameHash <= int64(0) ||
       receipt.replicatedAtNs <= int64(0):
        return Err[bool]("depin settlement ledger replication receipt: fields")
    if DepinInferenceTransportSettlementLedgerReplicationReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin settlement ledger replication receipt: hash")
    return Ok[bool](true)

fn DepinInferenceTransportSettlementLedgerReplicationFailureHash(failure: DepinInferenceTransportSettlementLedgerReplicationFailure): int64 =
    var h: int64 = int64(277)
    h = engine.DistributedHashTextWith(h, failure.schema)
    h = engine.DistributedHashStep(h, failure.enginePlanHash)
    h = engine.DistributedHashTextWith(h, failure.sourcePeerId)
    h = engine.DistributedHashTextWith(h, failure.targetPeerId)
    h = engine.DistributedHashStep(h, failure.ledgerReceiptHash)
    h = engine.DistributedHashStep(h, failure.attemptedAtNs)
    h = engine.DistributedHashStep(h, failure.errorHash)
    return h

fn DepinInferenceTransportBuildSettlementLedgerReplicationFailure(plan: engine.DistributedInferencePlan,
                                                                  sourcePeerId: str,
                                                                  targetPeerId: str,
                                                                  ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                                                  errorText: str,
                                                                  attemptedAtNs: int64): DepinInferenceTransportSettlementLedgerReplicationFailure =
    var failure = DepinInferenceTransportSettlementLedgerReplicationFailure(
        schema: DepinInferenceTransportSettlementLedgerReplicationFailureSchema,
        enginePlanHash: plan.engineHash,
        sourcePeerId: sourcePeerId,
        targetPeerId: targetPeerId,
        ledgerReceiptHash: ledgerReceipt.receiptHash,
        attemptedAtNs: attemptedAtNs,
        errorHash: engine.DistributedHashTextWith(int64(281), errorText),
        failureHash: int64(0)
    )
    failure.failureHash = DepinInferenceTransportSettlementLedgerReplicationFailureHash(failure)
    return failure

fn DepinInferenceTransportValidateSettlementLedgerReplicationFailure(failure: DepinInferenceTransportSettlementLedgerReplicationFailure): Result[bool] =
    if failure.schema != DepinInferenceTransportSettlementLedgerReplicationFailureSchema ||
       failure.enginePlanHash <= int64(0) ||
       failure.sourcePeerId == "" ||
       failure.targetPeerId == "" ||
       failure.ledgerReceiptHash <= int64(0) ||
       failure.attemptedAtNs <= int64(0) ||
       failure.errorHash <= int64(0):
        return Err[bool]("depin settlement ledger replication failure: fields")
    if DepinInferenceTransportSettlementLedgerReplicationFailureHash(failure) != failure.failureHash:
        return Err[bool]("depin settlement ledger replication failure: hash")
    return Ok[bool](true)

fn DepinInferenceTransportSettlementLedgerReplicationAttemptHash(attempt: DepinInferenceTransportSettlementLedgerReplicationAttempt): int64 =
    var h: int64 = int64(297)
    h = engine.DistributedHashTextWith(h, attempt.schema)
    h = engine.DistributedHashStep(h, attempt.enginePlanHash)
    h = engine.DistributedHashTextWith(h, attempt.sourcePeerId)
    h = engine.DistributedHashTextWith(h, attempt.targetPeerId)
    h = engine.DistributedHashStep(h, attempt.ledgerReceiptHash)
    h = engine.DistributedHashStep(h, int64(attempt.attemptIndex))
    h = engine.DistributedHashStep(h, attempt.seqNo)
    h = engine.DistributedHashStep(h, attempt.attemptedAtNs)
    h = engine.DistributedHashStep(h, attempt.success ? int64(1) : int64(0))
    h = engine.DistributedHashStep(h, attempt.requestFrameHash)
    h = engine.DistributedHashStep(h, attempt.ackFrameHash)
    h = engine.DistributedHashStep(h, attempt.replicaReceiptHash)
    h = engine.DistributedHashStep(h, attempt.errorHash)
    return h

fn DepinInferenceTransportBuildSettlementLedgerReplicationAttempt(plan: engine.DistributedInferencePlan,
                                                                  sourcePeerId: str,
                                                                  targetPeerId: str,
                                                                  ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                                                  attemptIndex: int32,
                                                                  seqNo: int64,
                                                                  attemptedAtNs: int64,
                                                                  success: bool,
                                                                  requestFrameHash: int64,
                                                                  ackFrameHash: int64,
                                                                  replicaReceiptHash: int64,
                                                                  errorText: str): DepinInferenceTransportSettlementLedgerReplicationAttempt =
    var errorHash: int64
    if !success:
        errorHash = engine.DistributedHashTextWith(int64(299), errorText)
    var attempt = DepinInferenceTransportSettlementLedgerReplicationAttempt(
        schema: DepinInferenceTransportSettlementLedgerReplicationAttemptSchema,
        enginePlanHash: plan.engineHash,
        sourcePeerId: sourcePeerId,
        targetPeerId: targetPeerId,
        ledgerReceiptHash: ledgerReceipt.receiptHash,
        attemptIndex: attemptIndex,
        seqNo: seqNo,
        attemptedAtNs: attemptedAtNs,
        success: success,
        requestFrameHash: requestFrameHash,
        ackFrameHash: ackFrameHash,
        replicaReceiptHash: replicaReceiptHash,
        errorHash: errorHash,
        attemptHash: int64(0)
    )
    attempt.attemptHash = DepinInferenceTransportSettlementLedgerReplicationAttemptHash(attempt)
    return attempt

fn DepinInferenceTransportValidateSettlementLedgerReplicationAttempt(attempt: DepinInferenceTransportSettlementLedgerReplicationAttempt): Result[bool] =
    if attempt.schema != DepinInferenceTransportSettlementLedgerReplicationAttemptSchema ||
       attempt.enginePlanHash <= int64(0) ||
       attempt.sourcePeerId == "" ||
       attempt.targetPeerId == "" ||
       attempt.ledgerReceiptHash <= int64(0) ||
       attempt.attemptIndex < 0 ||
       attempt.seqNo < int64(0) ||
       attempt.attemptedAtNs <= int64(0):
        return Err[bool]("depin settlement ledger replication attempt: fields")
    if attempt.success:
        if attempt.requestFrameHash <= int64(0) ||
           attempt.ackFrameHash <= int64(0) ||
           attempt.replicaReceiptHash <= int64(0) ||
           attempt.errorHash != int64(0):
            return Err[bool]("depin settlement ledger replication attempt: success fields")
    else:
        if attempt.requestFrameHash != int64(0) ||
           attempt.ackFrameHash != int64(0) ||
           attempt.replicaReceiptHash != int64(0) ||
           attempt.errorHash <= int64(0):
            return Err[bool]("depin settlement ledger replication attempt: failure fields")
    if DepinInferenceTransportSettlementLedgerReplicationAttemptHash(attempt) != attempt.attemptHash:
        return Err[bool]("depin settlement ledger replication attempt: hash")
    return Ok[bool](true)

fn depinInferenceTransportSettlementLedgerAttemptSetHash(attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[]): int64 =
    var h: int64 = int64(301)
    h = engine.DistributedHashStep(h, int64(attempts.len))
    for i in 0..<attempts.len:
        h = engine.DistributedHashTextWith(h, attempts[i].targetPeerId)
        h = engine.DistributedHashStep(h, int64(attempts[i].attemptIndex))
        h = engine.DistributedHashStep(h, attempts[i].attemptHash)
    return h

fn depinInferenceTransportSettlementLedgerReplicationReceiptSetHash(receipts: DepinInferenceTransportSettlementLedgerReplicationReceipt[]): int64 =
    var h: int64 = int64(283)
    h = engine.DistributedHashStep(h, int64(receipts.len))
    for i in 0..<receipts.len:
        h = engine.DistributedHashTextWith(h, receipts[i].targetPeerId)
        h = engine.DistributedHashStep(h, receipts[i].receiptHash)
        h = engine.DistributedHashStep(h, receipts[i].replicaReceiptHash)
        h = engine.DistributedHashStep(h, receipts[i].ackFrameHash)
    return h

fn depinInferenceTransportSettlementLedgerReplicaByteHashSetHash(receipts: DepinInferenceTransportSettlementLedgerReplicationReceipt[]): int64 =
    var h: int64 = int64(285)
    h = engine.DistributedHashStep(h, int64(receipts.len))
    for i in 0..<receipts.len:
        h = engine.DistributedHashTextWith(h, receipts[i].targetPeerId)
        h = engine.DistributedHashStep(h, receipts[i].replicaByteHash)
    return h

fn depinInferenceTransportSettlementLedgerAckFrameSetHash(receipts: DepinInferenceTransportSettlementLedgerReplicationReceipt[]): int64 =
    var h: int64 = int64(287)
    h = engine.DistributedHashStep(h, int64(receipts.len))
    for i in 0..<receipts.len:
        h = engine.DistributedHashTextWith(h, receipts[i].targetPeerId)
        h = engine.DistributedHashStep(h, receipts[i].ackFrameHash)
    return h

fn depinInferenceTransportSettlementLedgerFailureSetHash(failures: DepinInferenceTransportSettlementLedgerReplicationFailure[]): int64 =
    var h: int64 = int64(289)
    h = engine.DistributedHashStep(h, int64(failures.len))
    for i in 0..<failures.len:
        h = engine.DistributedHashTextWith(h, failures[i].targetPeerId)
        h = engine.DistributedHashStep(h, failures[i].failureHash)
    return h

fn depinInferenceTransportSettlementQuorumReceiptHash(receipt: DepinInferenceTransportSettlementLedgerQuorumReceipt): int64 =
    var h: int64 = int64(291)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashTextWith(h, receipt.coordinatorPeerId)
    h = engine.DistributedHashTextWith(h, receipt.sourcePeerId)
    h = engine.DistributedHashStep(h, receipt.ledgerHash)
    h = engine.DistributedHashStep(h, receipt.ledgerReceiptHash)
    h = engine.DistributedHashStep(h, receipt.ledgerByteHash)
    h = engine.DistributedHashStep(h, int64(receipt.ledgerRecordCount))
    h = engine.DistributedHashStep(h, int64(receipt.plannedReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.requiredReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.successfulReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.failedReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.maxReplicaAttempts))
    h = engine.DistributedHashStep(h, int64(receipt.replicaAttemptCount))
    h = engine.DistributedHashStep(h, receipt.replicaAttemptSetHash)
    h = engine.DistributedHashStep(h, receipt.targetPeerSetHash)
    h = engine.DistributedHashStep(h, receipt.replicaReceiptSetHash)
    h = engine.DistributedHashStep(h, receipt.replicaByteHashSetHash)
    h = engine.DistributedHashStep(h, receipt.ackFrameSetHash)
    h = engine.DistributedHashStep(h, receipt.failureSetHash)
    h = engine.DistributedHashStep(h, int64(receipt.bytesWritten))
    h = engine.DistributedHashStep(h, int64(receipt.bytesRead))
    h = engine.DistributedHashStep(h, receipt.replicatedAtNs)
    return h

fn depinInferenceTransportSettlementReplicaTargetCount(targetPeerId: str,
                                                       receipts: DepinInferenceTransportSettlementLedgerReplicationReceipt[],
                                                       failures: DepinInferenceTransportSettlementLedgerReplicationFailure[]): int32 =
    var count: int32
    for i in 0..<receipts.len:
        if receipts[i].targetPeerId == targetPeerId:
            count = count + 1
    for i in 0..<failures.len:
        if failures[i].targetPeerId == targetPeerId:
            count = count + 1
    return count

fn depinInferenceTransportSettlementTargetAttemptCount(targetPeerId: str,
                                                       attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[]): int32 =
    var count: int32
    for i in 0..<attempts.len:
        if attempts[i].targetPeerId == targetPeerId:
            count = count + 1
    return count

fn depinInferenceTransportSettlementTargetAttemptIndexCount(targetPeerId: str,
                                                            attemptIndex: int32,
                                                            attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[]): int32 =
    var count: int32
    for i in 0..<attempts.len:
        if attempts[i].targetPeerId == targetPeerId &&
           attempts[i].attemptIndex == attemptIndex:
            count = count + 1
    return count

fn depinInferenceTransportSettlementReceiptSuccessAttemptCount(receipt: DepinInferenceTransportSettlementLedgerReplicationReceipt,
                                                               attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[]): int32 =
    var count: int32
    for i in 0..<attempts.len:
        if attempts[i].success &&
           attempts[i].targetPeerId == receipt.targetPeerId &&
           attempts[i].requestFrameHash == receipt.requestFrameHash &&
           attempts[i].ackFrameHash == receipt.ackFrameHash &&
           attempts[i].replicaReceiptHash == receipt.replicaReceiptHash:
            count = count + 1
    return count

fn depinInferenceTransportSettlementReceiptSuccessAttemptIndex(receipt: DepinInferenceTransportSettlementLedgerReplicationReceipt,
                                                               attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[]): int32 =
    var index: int32 = -1
    for i in 0..<attempts.len:
        if attempts[i].success &&
           attempts[i].targetPeerId == receipt.targetPeerId &&
           attempts[i].requestFrameHash == receipt.requestFrameHash &&
           attempts[i].ackFrameHash == receipt.ackFrameHash &&
           attempts[i].replicaReceiptHash == receipt.replicaReceiptHash:
            index = attempts[i].attemptIndex
    return index

fn depinInferenceTransportSettlementTargetSuccessAttemptCount(targetPeerId: str,
                                                              attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[]): int32 =
    var count: int32
    for i in 0..<attempts.len:
        if attempts[i].success &&
           attempts[i].targetPeerId == targetPeerId:
            count = count + 1
    return count

fn DepinInferenceTransportBuildSettlementLedgerQuorumReceipt(plan: engine.DistributedInferencePlan,
                                                             settlementPlan: DepinSettlementPlan,
                                                             coordinatorPeerId: str,
                                                             sourcePeerId: str,
                                                             ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                                             receipts: DepinInferenceTransportSettlementLedgerReplicationReceipt[],
                                                             failures: DepinInferenceTransportSettlementLedgerReplicationFailure[],
                                                             attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[],
                                                             replicatedAtNs: int64): Result[DepinInferenceTransportSettlementLedgerQuorumReceipt] =
    if coordinatorPeerId == "" || sourcePeerId == "" || replicatedAtNs <= int64(0):
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: args")
    let planOk = DepinSettlementValidatePlan(settlementPlan)
    if IsErr(planOk):
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt](Error(planOk))
    let ledgerOk = DepinSettlementValidateLedgerFileReceipt(ledgerReceipt)
    if IsErr(ledgerOk):
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt](Error(ledgerOk))
    if receipts.len < settlementPlan.replicaQuorum:
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: below quorum")
    if receipts.len + failures.len != settlementPlan.replicaPeers.len:
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: accounting")
    if attempts.len < receipts.len + failures.len ||
       attempts.len > settlementPlan.replicaPeers.len * settlementPlan.replicaMaxAttempts:
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: attempt count")
    for i in 0..<settlementPlan.replicaPeers.len:
        if depinInferenceTransportSettlementReplicaTargetCount(settlementPlan.replicaPeers[i], receipts, failures) != 1:
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: target accounting")
        let targetAttemptCount = depinInferenceTransportSettlementTargetAttemptCount(settlementPlan.replicaPeers[i], attempts)
        if targetAttemptCount <= 0 ||
           targetAttemptCount > settlementPlan.replicaMaxAttempts:
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: target attempts")
        for attemptIndex in 0..<settlementPlan.replicaMaxAttempts:
            if depinInferenceTransportSettlementTargetAttemptIndexCount(settlementPlan.replicaPeers[i], attemptIndex, attempts) > 1:
                return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: duplicate attempt")
    for i in 0..<receipts.len:
        let ok = DepinInferenceTransportValidateSettlementLedgerReplicationReceipt(receipts[i])
        if IsErr(ok):
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt](Error(ok))
        if receipts[i].enginePlanHash != plan.engineHash ||
           receipts[i].coordinatorPeerId != coordinatorPeerId ||
           receipts[i].sourcePeerId != sourcePeerId ||
           receipts[i].ledgerHash != ledgerReceipt.ledgerHash ||
           receipts[i].ledgerReceiptHash != ledgerReceipt.receiptHash ||
           receipts[i].ledgerByteHash != ledgerReceipt.byteHash ||
           receipts[i].ledgerRecordCount != ledgerReceipt.recordCount:
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: replication binding")
        if depinInferenceTransportSettlementReceiptSuccessAttemptCount(receipts[i], attempts) != 1:
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: success attempt binding")
        let successAttemptIndex = depinInferenceTransportSettlementReceiptSuccessAttemptIndex(receipts[i], attempts)
        if successAttemptIndex < 0 ||
           depinInferenceTransportSettlementTargetAttemptCount(receipts[i].targetPeerId, attempts) != successAttemptIndex + 1:
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: success attempt prefix")
        for attemptIndex in 0..<(successAttemptIndex + 1):
            if depinInferenceTransportSettlementTargetAttemptIndexCount(receipts[i].targetPeerId, attemptIndex, attempts) != 1:
                return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: success attempt gap")
    for i in 0..<failures.len:
        let ok = DepinInferenceTransportValidateSettlementLedgerReplicationFailure(failures[i])
        if IsErr(ok):
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt](Error(ok))
        if failures[i].enginePlanHash != plan.engineHash ||
           failures[i].sourcePeerId != sourcePeerId ||
           failures[i].ledgerReceiptHash != ledgerReceipt.receiptHash:
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: failure binding")
        if depinInferenceTransportSettlementTargetSuccessAttemptCount(failures[i].targetPeerId, attempts) != 0 ||
           depinInferenceTransportSettlementTargetAttemptCount(failures[i].targetPeerId, attempts) != settlementPlan.replicaMaxAttempts:
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: failure attempt binding")
    var successfulAttempts: int32
    for i in 0..<attempts.len:
        let ok = DepinInferenceTransportValidateSettlementLedgerReplicationAttempt(attempts[i])
        if IsErr(ok):
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt](Error(ok))
        if attempts[i].enginePlanHash != plan.engineHash ||
           attempts[i].sourcePeerId != sourcePeerId ||
           attempts[i].ledgerReceiptHash != ledgerReceipt.receiptHash ||
           attempts[i].attemptIndex >= settlementPlan.replicaMaxAttempts:
            return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: attempt binding")
        if attempts[i].success:
            successfulAttempts = successfulAttempts + 1
    if successfulAttempts != receipts.len:
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum receipt: attempt success count")
    var receipt = DepinInferenceTransportSettlementLedgerQuorumReceipt(
        schema: DepinInferenceTransportSettlementLedgerQuorumSchema,
        enginePlanHash: plan.engineHash,
        coordinatorPeerId: coordinatorPeerId,
        sourcePeerId: sourcePeerId,
        ledgerHash: ledgerReceipt.ledgerHash,
        ledgerReceiptHash: ledgerReceipt.receiptHash,
        ledgerByteHash: ledgerReceipt.byteHash,
        ledgerRecordCount: ledgerReceipt.recordCount,
        plannedReplicaCount: int32(settlementPlan.replicaPeers.len),
        requiredReplicaCount: settlementPlan.replicaQuorum,
        successfulReplicaCount: int32(receipts.len),
        failedReplicaCount: int32(failures.len),
        maxReplicaAttempts: settlementPlan.replicaMaxAttempts,
        replicaAttemptCount: int32(attempts.len),
        replicaAttemptSetHash: depinInferenceTransportSettlementLedgerAttemptSetHash(attempts),
        targetPeerSetHash: DepinSettlementPlanReplicaPeerSetHash(settlementPlan),
        replicaReceiptSetHash: depinInferenceTransportSettlementLedgerReplicationReceiptSetHash(receipts),
        replicaByteHashSetHash: depinInferenceTransportSettlementLedgerReplicaByteHashSetHash(receipts),
        ackFrameSetHash: depinInferenceTransportSettlementLedgerAckFrameSetHash(receipts),
        failureSetHash: depinInferenceTransportSettlementLedgerFailureSetHash(failures),
        bytesWritten: int32(receipts.len) * pipe.DepinInferenceWireFrameBytes,
        bytesRead: int32(receipts.len) * pipe.DepinInferenceWireFrameBytes,
        replicatedAtNs: replicatedAtNs,
        receiptHash: int64(0)
    )
    receipt.receiptHash = depinInferenceTransportSettlementQuorumReceiptHash(receipt)
    return Ok[DepinInferenceTransportSettlementLedgerQuorumReceipt](receipt)

fn DepinInferenceTransportValidateSettlementLedgerQuorumReceipt(receipt: DepinInferenceTransportSettlementLedgerQuorumReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportSettlementLedgerQuorumSchema ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.coordinatorPeerId == "" ||
       receipt.sourcePeerId == "" ||
       receipt.ledgerHash <= int64(0) ||
       receipt.ledgerReceiptHash <= int64(0) ||
       receipt.ledgerByteHash <= int64(0) ||
       receipt.ledgerRecordCount <= 0 ||
       receipt.plannedReplicaCount <= 0 ||
       receipt.requiredReplicaCount <= 0 ||
       receipt.successfulReplicaCount < receipt.requiredReplicaCount ||
       receipt.successfulReplicaCount + receipt.failedReplicaCount != receipt.plannedReplicaCount ||
       receipt.maxReplicaAttempts <= 0 ||
       receipt.replicaAttemptCount < receipt.plannedReplicaCount ||
       receipt.replicaAttemptSetHash <= int64(0) ||
       receipt.targetPeerSetHash <= int64(0) ||
       receipt.replicaReceiptSetHash <= int64(0) ||
       receipt.replicaByteHashSetHash <= int64(0) ||
       receipt.ackFrameSetHash <= int64(0) ||
       receipt.failureSetHash <= int64(0) ||
       receipt.bytesWritten <= 0 ||
       receipt.bytesRead <= 0 ||
       receipt.replicatedAtNs <= int64(0):
        return Err[bool]("depin settlement ledger quorum receipt: fields")
    if depinInferenceTransportSettlementQuorumReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin settlement ledger quorum receipt: hash")
    return Ok[bool](true)

fn DepinInferenceTransportSettlementLedgerQuorumFileByteHash(bytes: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(293), bytes)

fn DepinInferenceTransportSettlementLedgerQuorumFileReceiptHash(receipt: DepinInferenceTransportSettlementLedgerQuorumFileReceipt): int64 =
    var h: int64 = int64(295)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.coordinatorPeerHash)
    h = engine.DistributedHashStep(h, receipt.sourcePeerHash)
    h = engine.DistributedHashStep(h, receipt.ledgerHash)
    h = engine.DistributedHashStep(h, receipt.ledgerReceiptHash)
    h = engine.DistributedHashStep(h, receipt.ledgerByteHash)
    h = engine.DistributedHashStep(h, int64(receipt.ledgerRecordCount))
    h = engine.DistributedHashStep(h, int64(receipt.plannedReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.requiredReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.successfulReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.failedReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.maxReplicaAttempts))
    h = engine.DistributedHashStep(h, int64(receipt.replicaAttemptCount))
    h = engine.DistributedHashStep(h, receipt.replicaAttemptSetHash)
    h = engine.DistributedHashStep(h, receipt.targetPeerSetHash)
    h = engine.DistributedHashStep(h, receipt.replicaReceiptSetHash)
    h = engine.DistributedHashStep(h, receipt.replicaByteHashSetHash)
    h = engine.DistributedHashStep(h, receipt.ackFrameSetHash)
    h = engine.DistributedHashStep(h, receipt.failureSetHash)
    h = engine.DistributedHashStep(h, int64(receipt.bytesWritten))
    h = engine.DistributedHashStep(h, int64(receipt.bytesRead))
    h = engine.DistributedHashStep(h, receipt.replicatedAtNs)
    h = engine.DistributedHashStep(h, receipt.quorumReceiptHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn depinInferenceTransportSettlementLedgerQuorumFileWord(receipt: DepinInferenceTransportSettlementLedgerQuorumReceipt,
                                                         index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportSettlementLedgerQuorumFileMagic)
    if index == 1:
        return int64(DepinInferenceTransportSettlementLedgerQuorumFileVersion)
    if index == 2:
        return receipt.enginePlanHash
    if index == 3:
        return DepinSettlementTextHash(receipt.coordinatorPeerId)
    if index == 4:
        return DepinSettlementTextHash(receipt.sourcePeerId)
    if index == 5:
        return receipt.ledgerHash
    if index == 6:
        return receipt.ledgerReceiptHash
    if index == 7:
        return receipt.ledgerByteHash
    if index == 8:
        return int64(receipt.ledgerRecordCount)
    if index == 9:
        return int64(receipt.plannedReplicaCount)
    if index == 10:
        return int64(receipt.requiredReplicaCount)
    if index == 11:
        return int64(receipt.successfulReplicaCount)
    if index == 12:
        return int64(receipt.failedReplicaCount)
    if index == 13:
        return int64(receipt.maxReplicaAttempts)
    if index == 14:
        return int64(receipt.replicaAttemptCount)
    if index == 15:
        return receipt.replicaAttemptSetHash
    if index == 16:
        return receipt.targetPeerSetHash
    if index == 17:
        return receipt.replicaReceiptSetHash
    if index == 18:
        return receipt.replicaByteHashSetHash
    if index == 19:
        return receipt.ackFrameSetHash
    if index == 20:
        return receipt.failureSetHash
    if index == 21:
        return int64(receipt.bytesWritten)
    if index == 22:
        return int64(receipt.bytesRead)
    if index == 23:
        return receipt.replicatedAtNs
    if index == 24:
        return receipt.receiptHash
    return int64(-1)

fn depinInferenceTransportSettlementLedgerQuorumFileBytes(receipt: DepinInferenceTransportSettlementLedgerQuorumReceipt): Result[rawbytes.Bytes] =
    let receiptOk = DepinInferenceTransportValidateSettlementLedgerQuorumReceipt(receipt)
    if IsErr(receiptOk):
        return Err[rawbytes.Bytes](Error(receiptOk))
    let byteCount = DepinInferenceTransportSettlementLedgerQuorumFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin settlement ledger quorum file: allocation")
    for i in 0..<DepinInferenceTransportSettlementLedgerQuorumFileWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportSettlementLedgerQuorumFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportSettlementLedgerQuorumFileReceiptBuild(path: str,
                                                                 bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportSettlementLedgerQuorumFileReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt]("depin settlement ledger quorum file: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportSettlementLedgerQuorumFileWordCount * 8:
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt]("depin settlement ledger quorum file: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportSettlementLedgerQuorumFileMagic) ||
       version != int64(DepinInferenceTransportSettlementLedgerQuorumFileVersion):
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt]("depin settlement ledger quorum file: header")
    let ledgerRecordCountRaw = engine.DistributedReadI64LE(bytesRaw, 64)
    let plannedReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 72)
    let requiredReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 80)
    let successfulReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 88)
    let failedReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 96)
    let maxReplicaAttemptsRaw = engine.DistributedReadI64LE(bytesRaw, 104)
    let replicaAttemptCountRaw = engine.DistributedReadI64LE(bytesRaw, 112)
    let bytesWrittenRaw = engine.DistributedReadI64LE(bytesRaw, 168)
    let bytesReadRaw = engine.DistributedReadI64LE(bytesRaw, 176)
    if ledgerRecordCountRaw <= int64(0) ||
       ledgerRecordCountRaw > int64(2147483647) ||
       plannedReplicaCountRaw <= int64(0) ||
       plannedReplicaCountRaw > int64(2147483647) ||
       requiredReplicaCountRaw <= int64(0) ||
       requiredReplicaCountRaw > int64(2147483647) ||
       successfulReplicaCountRaw <= int64(0) ||
       successfulReplicaCountRaw > int64(2147483647) ||
       failedReplicaCountRaw < int64(0) ||
       failedReplicaCountRaw > int64(2147483647) ||
       maxReplicaAttemptsRaw <= int64(0) ||
       maxReplicaAttemptsRaw > int64(2147483647) ||
       replicaAttemptCountRaw <= int64(0) ||
       replicaAttemptCountRaw > int64(2147483647) ||
       bytesWrittenRaw <= int64(0) ||
       bytesWrittenRaw > int64(2147483647) ||
       bytesReadRaw <= int64(0) ||
       bytesReadRaw > int64(2147483647):
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt]("depin settlement ledger quorum file: ranges")
    var receipt = DepinInferenceTransportSettlementLedgerQuorumFileReceipt(
        schema: DepinInferenceTransportSettlementLedgerQuorumFileSchema,
        path: path,
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 16),
        coordinatorPeerHash: engine.DistributedReadI64LE(bytesRaw, 24),
        sourcePeerHash: engine.DistributedReadI64LE(bytesRaw, 32),
        ledgerHash: engine.DistributedReadI64LE(bytesRaw, 40),
        ledgerReceiptHash: engine.DistributedReadI64LE(bytesRaw, 48),
        ledgerByteHash: engine.DistributedReadI64LE(bytesRaw, 56),
        ledgerRecordCount: int32(ledgerRecordCountRaw),
        plannedReplicaCount: int32(plannedReplicaCountRaw),
        requiredReplicaCount: int32(requiredReplicaCountRaw),
        successfulReplicaCount: int32(successfulReplicaCountRaw),
        failedReplicaCount: int32(failedReplicaCountRaw),
        maxReplicaAttempts: int32(maxReplicaAttemptsRaw),
        replicaAttemptCount: int32(replicaAttemptCountRaw),
        replicaAttemptSetHash: engine.DistributedReadI64LE(bytesRaw, 120),
        targetPeerSetHash: engine.DistributedReadI64LE(bytesRaw, 128),
        replicaReceiptSetHash: engine.DistributedReadI64LE(bytesRaw, 136),
        replicaByteHashSetHash: engine.DistributedReadI64LE(bytesRaw, 144),
        ackFrameSetHash: engine.DistributedReadI64LE(bytesRaw, 152),
        failureSetHash: engine.DistributedReadI64LE(bytesRaw, 160),
        bytesWritten: int32(bytesWrittenRaw),
        bytesRead: int32(bytesReadRaw),
        replicatedAtNs: engine.DistributedReadI64LE(bytesRaw, 184),
        quorumReceiptHash: engine.DistributedReadI64LE(bytesRaw, 192),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportSettlementLedgerQuorumFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    receipt.receiptHash = DepinInferenceTransportSettlementLedgerQuorumFileReceiptHash(receipt)
    return Ok[DepinInferenceTransportSettlementLedgerQuorumFileReceipt](receipt)

fn DepinInferenceTransportWriteSettlementLedgerQuorumReceiptFile(path: str,
                                                                 quorumReceipt: DepinInferenceTransportSettlementLedgerQuorumReceipt): Result[DepinInferenceTransportSettlementLedgerQuorumFileReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt]("depin settlement ledger quorum file: path")
    let bytesRes = depinInferenceTransportSettlementLedgerQuorumFileBytes(quorumReceipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportSettlementLedgerQuorumFileByteHash(readBytes) != DepinInferenceTransportSettlementLedgerQuorumFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt]("depin settlement ledger quorum file: readback")
    let receiptRes = depinInferenceTransportSettlementLedgerQuorumFileReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let receiptOk = DepinInferenceTransportValidateSettlementLedgerQuorumFileReceipt(Value(receiptRes))
    if IsErr(receiptOk):
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt](Error(receiptOk))
    return receiptRes

fn DepinInferenceTransportReadSettlementLedgerQuorumReceiptFile(path: str): Result[DepinInferenceTransportSettlementLedgerQuorumFileReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt]("depin settlement ledger quorum file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportSettlementLedgerQuorumFileReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportSettlementLedgerQuorumFileReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateSettlementLedgerQuorumFileReceipt(receipt: DepinInferenceTransportSettlementLedgerQuorumFileReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportSettlementLedgerQuorumFileSchema ||
       receipt.path == "" ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.coordinatorPeerHash <= int64(0) ||
       receipt.sourcePeerHash <= int64(0) ||
       receipt.ledgerHash <= int64(0) ||
       receipt.ledgerReceiptHash <= int64(0) ||
       receipt.ledgerByteHash <= int64(0) ||
       receipt.ledgerRecordCount <= 0 ||
       receipt.plannedReplicaCount <= 0 ||
       receipt.requiredReplicaCount <= 0 ||
       receipt.successfulReplicaCount < receipt.requiredReplicaCount ||
       receipt.successfulReplicaCount + receipt.failedReplicaCount != receipt.plannedReplicaCount ||
       receipt.maxReplicaAttempts <= 0 ||
       receipt.replicaAttemptCount < receipt.plannedReplicaCount ||
       receipt.replicaAttemptSetHash <= int64(0) ||
       receipt.targetPeerSetHash <= int64(0) ||
       receipt.replicaReceiptSetHash <= int64(0) ||
       receipt.replicaByteHashSetHash <= int64(0) ||
       receipt.ackFrameSetHash <= int64(0) ||
       receipt.failureSetHash <= int64(0) ||
       receipt.bytesWritten <= 0 ||
       receipt.bytesRead <= 0 ||
       receipt.replicatedAtNs <= int64(0) ||
       receipt.quorumReceiptHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportSettlementLedgerQuorumFileWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin settlement ledger quorum file receipt: fields")
    if DepinInferenceTransportSettlementLedgerQuorumFileReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin settlement ledger quorum file receipt: hash")
    let readRes = DepinInferenceTransportReadSettlementLedgerQuorumReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).enginePlanHash != receipt.enginePlanHash ||
       Value(readRes).coordinatorPeerHash != receipt.coordinatorPeerHash ||
       Value(readRes).sourcePeerHash != receipt.sourcePeerHash ||
       Value(readRes).ledgerHash != receipt.ledgerHash ||
       Value(readRes).ledgerReceiptHash != receipt.ledgerReceiptHash ||
       Value(readRes).ledgerByteHash != receipt.ledgerByteHash ||
       Value(readRes).ledgerRecordCount != receipt.ledgerRecordCount ||
       Value(readRes).plannedReplicaCount != receipt.plannedReplicaCount ||
       Value(readRes).requiredReplicaCount != receipt.requiredReplicaCount ||
       Value(readRes).successfulReplicaCount != receipt.successfulReplicaCount ||
       Value(readRes).failedReplicaCount != receipt.failedReplicaCount ||
       Value(readRes).maxReplicaAttempts != receipt.maxReplicaAttempts ||
       Value(readRes).replicaAttemptCount != receipt.replicaAttemptCount ||
       Value(readRes).replicaAttemptSetHash != receipt.replicaAttemptSetHash ||
       Value(readRes).targetPeerSetHash != receipt.targetPeerSetHash ||
       Value(readRes).replicaReceiptSetHash != receipt.replicaReceiptSetHash ||
       Value(readRes).replicaByteHashSetHash != receipt.replicaByteHashSetHash ||
       Value(readRes).ackFrameSetHash != receipt.ackFrameSetHash ||
       Value(readRes).failureSetHash != receipt.failureSetHash ||
       Value(readRes).bytesWritten != receipt.bytesWritten ||
       Value(readRes).bytesRead != receipt.bytesRead ||
       Value(readRes).replicatedAtNs != receipt.replicatedAtNs ||
       Value(readRes).quorumReceiptHash != receipt.quorumReceiptHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin settlement ledger quorum file receipt: readback")
    return Ok[bool](true)

fn depinInferenceTransportSettlementLedgerReplicaFileReceiptSetHash(receipts: DepinSettlementLedgerReplicaReceipt[]): int64 =
    var h: int64 = int64(303)
    h = engine.DistributedHashStep(h, int64(receipts.len))
    for i in 0..<receipts.len:
        h = engine.DistributedHashStep(h, receipts[i].targetPeerHash)
        h = engine.DistributedHashStep(h, receipts[i].receiptHash)
        h = engine.DistributedHashStep(h, receipts[i].byteHash)
    return h

fn DepinInferenceTransportSettlementLedgerRepairHash(receipt: DepinInferenceTransportSettlementLedgerRepairReceipt): int64 =
    var h: int64 = int64(305)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.sourcePeerHash)
    h = engine.DistributedHashStep(h, receipt.ledgerHash)
    h = engine.DistributedHashStep(h, receipt.ledgerReceiptHash)
    h = engine.DistributedHashStep(h, receipt.ledgerByteHash)
    h = engine.DistributedHashStep(h, receipt.previousQuorumFileReceiptHash)
    h = engine.DistributedHashStep(h, int64(receipt.plannedReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.existingReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.repairedReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.failedReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.finalReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.maxRepairAttempts))
    h = engine.DistributedHashStep(h, int64(receipt.replicaAttemptCount))
    h = engine.DistributedHashStep(h, receipt.replicaAttemptSetHash)
    h = engine.DistributedHashStep(h, receipt.existingReplicaReceiptSetHash)
    h = engine.DistributedHashStep(h, receipt.repairedReplicaReceiptSetHash)
    h = engine.DistributedHashStep(h, receipt.failureSetHash)
    h = engine.DistributedHashStep(h, int64(receipt.bytesWritten))
    h = engine.DistributedHashStep(h, int64(receipt.bytesRead))
    h = engine.DistributedHashStep(h, receipt.repairedAtNs)
    h = engine.DistributedHashStep(h, receipt.complete ? int64(1) : int64(0))
    return h

fn DepinInferenceTransportSettlementLedgerRepairReceiptHash(receipt: DepinInferenceTransportSettlementLedgerRepairReceipt): int64 =
    var h: int64 = int64(307)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashStep(h, receipt.repairHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn DepinInferenceTransportSettlementLedgerRepairFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(309), bytesRaw)

fn depinInferenceTransportSettlementLedgerRepairFileWord(receipt: DepinInferenceTransportSettlementLedgerRepairReceipt,
                                                         index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportSettlementLedgerRepairFileMagic)
    if index == 1:
        return int64(DepinInferenceTransportSettlementLedgerRepairFileVersion)
    if index == 2:
        return receipt.enginePlanHash
    if index == 3:
        return receipt.sourcePeerHash
    if index == 4:
        return receipt.ledgerHash
    if index == 5:
        return receipt.ledgerReceiptHash
    if index == 6:
        return receipt.ledgerByteHash
    if index == 7:
        return receipt.previousQuorumFileReceiptHash
    if index == 8:
        return int64(receipt.plannedReplicaCount)
    if index == 9:
        return int64(receipt.existingReplicaCount)
    if index == 10:
        return int64(receipt.repairedReplicaCount)
    if index == 11:
        return int64(receipt.failedReplicaCount)
    if index == 12:
        return int64(receipt.finalReplicaCount)
    if index == 13:
        return int64(receipt.maxRepairAttempts)
    if index == 14:
        return int64(receipt.replicaAttemptCount)
    if index == 15:
        return receipt.replicaAttemptSetHash
    if index == 16:
        return receipt.existingReplicaReceiptSetHash
    if index == 17:
        return receipt.repairedReplicaReceiptSetHash
    if index == 18:
        return receipt.failureSetHash
    if index == 19:
        return int64(receipt.bytesWritten)
    if index == 20:
        return int64(receipt.bytesRead)
    if index == 21:
        return receipt.repairedAtNs
    if index == 22:
        return receipt.complete ? int64(1) : int64(0)
    if index == 23:
        return receipt.repairHash
    return int64(-1)

fn depinInferenceTransportSettlementLedgerRepairFileBytes(receipt: DepinInferenceTransportSettlementLedgerRepairReceipt): Result[rawbytes.Bytes] =
    if receipt.repairHash <= int64(0):
        return Err[rawbytes.Bytes]("depin settlement ledger repair file: repair hash")
    let byteCount = DepinInferenceTransportSettlementLedgerRepairFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin settlement ledger repair file: allocation")
    for i in 0..<DepinInferenceTransportSettlementLedgerRepairFileWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportSettlementLedgerRepairFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportSettlementLedgerRepairReceiptBuild(path: str,
                                                             bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportSettlementLedgerRepairReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair file: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportSettlementLedgerRepairFileWordCount * 8:
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair file: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportSettlementLedgerRepairFileMagic) ||
       version != int64(DepinInferenceTransportSettlementLedgerRepairFileVersion):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair file: header")
    let plannedReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 64)
    let existingReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 72)
    let repairedReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 80)
    let failedReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 88)
    let finalReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 96)
    let maxRepairAttemptsRaw = engine.DistributedReadI64LE(bytesRaw, 104)
    let replicaAttemptCountRaw = engine.DistributedReadI64LE(bytesRaw, 112)
    let bytesWrittenRaw = engine.DistributedReadI64LE(bytesRaw, 152)
    let bytesReadRaw = engine.DistributedReadI64LE(bytesRaw, 160)
    let completeRaw = engine.DistributedReadI64LE(bytesRaw, 176)
    if plannedReplicaCountRaw <= int64(0) ||
       plannedReplicaCountRaw > int64(2147483647) ||
       existingReplicaCountRaw < int64(0) ||
       existingReplicaCountRaw > int64(2147483647) ||
       repairedReplicaCountRaw < int64(0) ||
       repairedReplicaCountRaw > int64(2147483647) ||
       failedReplicaCountRaw < int64(0) ||
       failedReplicaCountRaw > int64(2147483647) ||
       finalReplicaCountRaw < int64(0) ||
       finalReplicaCountRaw > int64(2147483647) ||
       maxRepairAttemptsRaw <= int64(0) ||
       maxRepairAttemptsRaw > int64(2147483647) ||
       replicaAttemptCountRaw < int64(0) ||
       replicaAttemptCountRaw > int64(2147483647) ||
       bytesWrittenRaw < int64(0) ||
       bytesWrittenRaw > int64(2147483647) ||
       bytesReadRaw < int64(0) ||
       bytesReadRaw > int64(2147483647) ||
       (completeRaw != int64(0) && completeRaw != int64(1)):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair file: ranges")
    var receipt = DepinInferenceTransportSettlementLedgerRepairReceipt(
        schema: DepinInferenceTransportSettlementLedgerRepairReceiptSchema,
        path: path,
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 16),
        sourcePeerHash: engine.DistributedReadI64LE(bytesRaw, 24),
        ledgerHash: engine.DistributedReadI64LE(bytesRaw, 32),
        ledgerReceiptHash: engine.DistributedReadI64LE(bytesRaw, 40),
        ledgerByteHash: engine.DistributedReadI64LE(bytesRaw, 48),
        previousQuorumFileReceiptHash: engine.DistributedReadI64LE(bytesRaw, 56),
        plannedReplicaCount: int32(plannedReplicaCountRaw),
        existingReplicaCount: int32(existingReplicaCountRaw),
        repairedReplicaCount: int32(repairedReplicaCountRaw),
        failedReplicaCount: int32(failedReplicaCountRaw),
        finalReplicaCount: int32(finalReplicaCountRaw),
        maxRepairAttempts: int32(maxRepairAttemptsRaw),
        replicaAttemptCount: int32(replicaAttemptCountRaw),
        replicaAttemptSetHash: engine.DistributedReadI64LE(bytesRaw, 120),
        existingReplicaReceiptSetHash: engine.DistributedReadI64LE(bytesRaw, 128),
        repairedReplicaReceiptSetHash: engine.DistributedReadI64LE(bytesRaw, 136),
        failureSetHash: engine.DistributedReadI64LE(bytesRaw, 144),
        bytesWritten: int32(bytesWrittenRaw),
        bytesRead: int32(bytesReadRaw),
        repairedAtNs: engine.DistributedReadI64LE(bytesRaw, 168),
        complete: completeRaw == int64(1),
        repairHash: engine.DistributedReadI64LE(bytesRaw, 184),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportSettlementLedgerRepairFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinInferenceTransportSettlementLedgerRepairHash(receipt) != receipt.repairHash:
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair file: repair hash")
    receipt.receiptHash = DepinInferenceTransportSettlementLedgerRepairReceiptHash(receipt)
    return Ok[DepinInferenceTransportSettlementLedgerRepairReceipt](receipt)

fn DepinInferenceTransportWriteSettlementLedgerRepairReceiptFile(path: str,
                                                                 draft: DepinInferenceTransportSettlementLedgerRepairReceipt): Result[DepinInferenceTransportSettlementLedgerRepairReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair file: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportSettlementLedgerRepairReceiptSchema
    receipt.path = path
    receipt.byteCount = DepinInferenceTransportSettlementLedgerRepairFileWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.repairHash = int64(0)
    receipt.repairHash = DepinInferenceTransportSettlementLedgerRepairHash(receipt)
    let bytesRes = depinInferenceTransportSettlementLedgerRepairFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportSettlementLedgerRepairFileByteHash(readBytes) != DepinInferenceTransportSettlementLedgerRepairFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair file: readback")
    let receiptRes = depinInferenceTransportSettlementLedgerRepairReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateSettlementLedgerRepairReceipt(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportReadSettlementLedgerRepairReceiptFile(path: str): Result[DepinInferenceTransportSettlementLedgerRepairReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportSettlementLedgerRepairReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateSettlementLedgerRepairReceipt(receipt: DepinInferenceTransportSettlementLedgerRepairReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportSettlementLedgerRepairReceiptSchema ||
       receipt.path == "" ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.sourcePeerHash <= int64(0) ||
       receipt.ledgerHash <= int64(0) ||
       receipt.ledgerReceiptHash <= int64(0) ||
       receipt.ledgerByteHash <= int64(0) ||
       receipt.previousQuorumFileReceiptHash <= int64(0) ||
       receipt.plannedReplicaCount <= 0 ||
       receipt.existingReplicaCount < 0 ||
       receipt.repairedReplicaCount < 0 ||
       receipt.failedReplicaCount < 0 ||
       receipt.finalReplicaCount != receipt.existingReplicaCount + receipt.repairedReplicaCount ||
       receipt.finalReplicaCount + receipt.failedReplicaCount != receipt.plannedReplicaCount ||
       receipt.maxRepairAttempts <= 0 ||
       receipt.replicaAttemptCount < 0 ||
       receipt.replicaAttemptCount > receipt.failedReplicaCount * receipt.maxRepairAttempts + receipt.repairedReplicaCount * receipt.maxRepairAttempts ||
       receipt.replicaAttemptSetHash <= int64(0) ||
       receipt.existingReplicaReceiptSetHash <= int64(0) ||
       receipt.repairedReplicaReceiptSetHash <= int64(0) ||
       receipt.failureSetHash <= int64(0) ||
       receipt.bytesWritten < 0 ||
       receipt.bytesRead < 0 ||
       receipt.bytesWritten != receipt.bytesRead ||
       receipt.repairedAtNs <= int64(0) ||
       receipt.repairHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportSettlementLedgerRepairFileWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin settlement ledger repair receipt: fields")
    if receipt.complete != (receipt.finalReplicaCount == receipt.plannedReplicaCount):
        return Err[bool]("depin settlement ledger repair receipt: complete")
    if DepinInferenceTransportSettlementLedgerRepairHash(receipt) != receipt.repairHash:
        return Err[bool]("depin settlement ledger repair receipt: repair hash")
    if DepinInferenceTransportSettlementLedgerRepairReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin settlement ledger repair receipt: receipt hash")
    let readRes = DepinInferenceTransportReadSettlementLedgerRepairReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).repairHash != receipt.repairHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin settlement ledger repair receipt: readback")
    return Ok[bool](true)

fn DepinInferenceTransportSettlementLedgerRepairPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csrr1"], "")

fn DepinInferenceTransportSettlementRepairDaemonStateHash(receipt: DepinInferenceTransportSettlementRepairDaemonStateReceipt): int64 =
    var h: int64 = int64(311)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.sourcePeerHash)
    h = engine.DistributedHashStep(h, receipt.settlementPlanHash)
    h = engine.DistributedHashStep(h, receipt.targetPeerSetHash)
    h = engine.DistributedHashStep(h, receipt.previousQuorumFileReceiptHash)
    h = engine.DistributedHashStep(h, receipt.repairReceiptHash)
    h = engine.DistributedHashStep(h, receipt.repairHash)
    h = engine.DistributedHashStep(h, receipt.ledgerHash)
    h = engine.DistributedHashStep(h, receipt.ledgerReceiptHash)
    h = engine.DistributedHashStep(h, receipt.previousDaemonStateHash)
    h = engine.DistributedHashStep(h, receipt.tickSeq)
    h = engine.DistributedHashStep(h, receipt.tickedAtNs)
    h = engine.DistributedHashStep(h, receipt.nextEligibleAtNs)
    h = engine.DistributedHashStep(h, receipt.leaseUntilNs)
    h = engine.DistributedHashStep(h, receipt.intervalNs)
    h = engine.DistributedHashStep(h, int64(receipt.plannedReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.finalReplicaCount))
    h = engine.DistributedHashStep(h, int64(receipt.failedReplicaCount))
    h = engine.DistributedHashStep(h, receipt.repairComplete ? int64(1) : int64(0))
    h = engine.DistributedHashStep(h, int64(receipt.repairByteCount))
    h = engine.DistributedHashStep(h, receipt.repairByteHash)
    return h

fn DepinInferenceTransportSettlementRepairDaemonStateReceiptHash(receipt: DepinInferenceTransportSettlementRepairDaemonStateReceipt): int64 =
    var h: int64 = int64(313)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashStep(h, receipt.stateHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn DepinInferenceTransportSettlementRepairDaemonStateFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(315), bytesRaw)

fn depinInferenceTransportSettlementRepairDaemonStateFileWord(receipt: DepinInferenceTransportSettlementRepairDaemonStateReceipt,
                                                              index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportSettlementRepairDaemonStateFileMagic)
    if index == 1:
        return int64(DepinInferenceTransportSettlementRepairDaemonStateFileVersion)
    if index == 2:
        return receipt.enginePlanHash
    if index == 3:
        return receipt.sourcePeerHash
    if index == 4:
        return receipt.settlementPlanHash
    if index == 5:
        return receipt.targetPeerSetHash
    if index == 6:
        return receipt.previousQuorumFileReceiptHash
    if index == 7:
        return receipt.repairReceiptHash
    if index == 8:
        return receipt.repairHash
    if index == 9:
        return receipt.ledgerHash
    if index == 10:
        return receipt.ledgerReceiptHash
    if index == 11:
        return receipt.previousDaemonStateHash
    if index == 12:
        return receipt.tickSeq
    if index == 13:
        return receipt.tickedAtNs
    if index == 14:
        return receipt.nextEligibleAtNs
    if index == 15:
        return receipt.leaseUntilNs
    if index == 16:
        return receipt.intervalNs
    if index == 17:
        return int64(receipt.plannedReplicaCount)
    if index == 18:
        return int64(receipt.finalReplicaCount)
    if index == 19:
        return int64(receipt.failedReplicaCount)
    if index == 20:
        return receipt.repairComplete ? int64(1) : int64(0)
    if index == 21:
        return int64(receipt.repairByteCount)
    if index == 22:
        return receipt.repairByteHash
    if index == 23:
        return receipt.stateHash
    return int64(-1)

fn depinInferenceTransportSettlementRepairDaemonStateFileBytes(receipt: DepinInferenceTransportSettlementRepairDaemonStateReceipt): Result[rawbytes.Bytes] =
    if receipt.stateHash <= int64(0):
        return Err[rawbytes.Bytes]("depin settlement repair daemon state file: state hash")
    let byteCount = DepinInferenceTransportSettlementRepairDaemonStateFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin settlement repair daemon state file: allocation")
    for i in 0..<DepinInferenceTransportSettlementRepairDaemonStateFileWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportSettlementRepairDaemonStateFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportSettlementRepairDaemonStateReceiptBuild(path: str,
                                                                  bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportSettlementRepairDaemonStateReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon state file: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportSettlementRepairDaemonStateFileWordCount * 8:
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon state file: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportSettlementRepairDaemonStateFileMagic) ||
       version != int64(DepinInferenceTransportSettlementRepairDaemonStateFileVersion):
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon state file: header")
    let tickSeqRaw = engine.DistributedReadI64LE(bytesRaw, 96)
    let plannedReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 136)
    let finalReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 144)
    let failedReplicaCountRaw = engine.DistributedReadI64LE(bytesRaw, 152)
    let repairCompleteRaw = engine.DistributedReadI64LE(bytesRaw, 160)
    let repairByteCountRaw = engine.DistributedReadI64LE(bytesRaw, 168)
    if tickSeqRaw < int64(0) ||
       plannedReplicaCountRaw <= int64(0) ||
       plannedReplicaCountRaw > int64(2147483647) ||
       finalReplicaCountRaw < int64(0) ||
       finalReplicaCountRaw > int64(2147483647) ||
       failedReplicaCountRaw < int64(0) ||
       failedReplicaCountRaw > int64(2147483647) ||
       repairByteCountRaw <= int64(0) ||
       repairByteCountRaw > int64(2147483647) ||
       (repairCompleteRaw != int64(0) && repairCompleteRaw != int64(1)):
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon state file: ranges")
    var receipt = DepinInferenceTransportSettlementRepairDaemonStateReceipt(
        schema: DepinInferenceTransportSettlementRepairDaemonStateSchema,
        path: path,
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 16),
        sourcePeerHash: engine.DistributedReadI64LE(bytesRaw, 24),
        settlementPlanHash: engine.DistributedReadI64LE(bytesRaw, 32),
        targetPeerSetHash: engine.DistributedReadI64LE(bytesRaw, 40),
        previousQuorumFileReceiptHash: engine.DistributedReadI64LE(bytesRaw, 48),
        repairReceiptHash: engine.DistributedReadI64LE(bytesRaw, 56),
        repairHash: engine.DistributedReadI64LE(bytesRaw, 64),
        ledgerHash: engine.DistributedReadI64LE(bytesRaw, 72),
        ledgerReceiptHash: engine.DistributedReadI64LE(bytesRaw, 80),
        previousDaemonStateHash: engine.DistributedReadI64LE(bytesRaw, 88),
        tickSeq: tickSeqRaw,
        tickedAtNs: engine.DistributedReadI64LE(bytesRaw, 104),
        nextEligibleAtNs: engine.DistributedReadI64LE(bytesRaw, 112),
        leaseUntilNs: engine.DistributedReadI64LE(bytesRaw, 120),
        intervalNs: engine.DistributedReadI64LE(bytesRaw, 128),
        plannedReplicaCount: int32(plannedReplicaCountRaw),
        finalReplicaCount: int32(finalReplicaCountRaw),
        failedReplicaCount: int32(failedReplicaCountRaw),
        repairComplete: repairCompleteRaw == int64(1),
        repairByteCount: int32(repairByteCountRaw),
        repairByteHash: engine.DistributedReadI64LE(bytesRaw, 176),
        stateHash: engine.DistributedReadI64LE(bytesRaw, 184),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportSettlementRepairDaemonStateFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinInferenceTransportSettlementRepairDaemonStateHash(receipt) != receipt.stateHash:
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon state file: state hash")
    receipt.receiptHash = DepinInferenceTransportSettlementRepairDaemonStateReceiptHash(receipt)
    return Ok[DepinInferenceTransportSettlementRepairDaemonStateReceipt](receipt)

fn DepinInferenceTransportWriteSettlementRepairDaemonStateReceiptFile(path: str,
                                                                      draft: DepinInferenceTransportSettlementRepairDaemonStateReceipt): Result[DepinInferenceTransportSettlementRepairDaemonStateReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon state file: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportSettlementRepairDaemonStateSchema
    receipt.path = path
    receipt.byteCount = DepinInferenceTransportSettlementRepairDaemonStateFileWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.stateHash = int64(0)
    receipt.stateHash = DepinInferenceTransportSettlementRepairDaemonStateHash(receipt)
    let bytesRes = depinInferenceTransportSettlementRepairDaemonStateFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportSettlementRepairDaemonStateFileByteHash(readBytes) != DepinInferenceTransportSettlementRepairDaemonStateFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon state file: readback")
    let receiptRes = depinInferenceTransportSettlementRepairDaemonStateReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(path: str): Result[DepinInferenceTransportSettlementRepairDaemonStateReceipt] =
    if path == "":
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon state file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportSettlementRepairDaemonStateReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(receipt: DepinInferenceTransportSettlementRepairDaemonStateReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportSettlementRepairDaemonStateSchema ||
       receipt.path == "" ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.sourcePeerHash <= int64(0) ||
       receipt.settlementPlanHash <= int64(0) ||
       receipt.targetPeerSetHash <= int64(0) ||
       receipt.previousQuorumFileReceiptHash <= int64(0) ||
       receipt.repairReceiptHash <= int64(0) ||
       receipt.repairHash <= int64(0) ||
       receipt.ledgerHash <= int64(0) ||
       receipt.ledgerReceiptHash <= int64(0) ||
       receipt.tickSeq < int64(0) ||
       receipt.tickedAtNs <= int64(0) ||
       receipt.nextEligibleAtNs != receipt.tickedAtNs + receipt.intervalNs ||
       receipt.leaseUntilNs <= receipt.tickedAtNs ||
       receipt.intervalNs <= int64(0) ||
       receipt.plannedReplicaCount <= 0 ||
       receipt.finalReplicaCount < 0 ||
       receipt.failedReplicaCount < 0 ||
       receipt.finalReplicaCount + receipt.failedReplicaCount != receipt.plannedReplicaCount ||
       receipt.repairByteCount != DepinInferenceTransportSettlementLedgerRepairFileWordCount * 8 ||
       receipt.repairByteHash <= int64(0) ||
       receipt.stateHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportSettlementRepairDaemonStateFileWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin settlement repair daemon state receipt: fields")
    if receipt.tickSeq == int64(0) && receipt.previousDaemonStateHash != int64(0):
        return Err[bool]("depin settlement repair daemon state receipt: initial predecessor")
    if receipt.tickSeq > int64(0) && receipt.previousDaemonStateHash <= int64(0):
        return Err[bool]("depin settlement repair daemon state receipt: predecessor")
    if receipt.repairComplete != (receipt.finalReplicaCount == receipt.plannedReplicaCount):
        return Err[bool]("depin settlement repair daemon state receipt: complete")
    if DepinInferenceTransportSettlementRepairDaemonStateHash(receipt) != receipt.stateHash:
        return Err[bool]("depin settlement repair daemon state receipt: state hash")
    if DepinInferenceTransportSettlementRepairDaemonStateReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin settlement repair daemon state receipt: receipt hash")
    let readRes = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).stateHash != receipt.stateHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin settlement repair daemon state receipt: readback")
    return Ok[bool](true)

fn DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csrd1"], "")

fn DepinInferenceTransportResidencySettlementSupervisorStateHash(receipt: DepinInferenceTransportResidencySettlementSupervisorStateReceipt): int64 =
    var h: int64 = int64(317)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.kvTargetPeerHash)
    h = engine.DistributedHashStep(h, receipt.kvHeadHash)
    h = engine.DistributedHashStep(h, receipt.kvCurrentStoreHash)
    h = engine.DistributedHashStep(h, receipt.kvWalLogHash)
    h = engine.DistributedHashStep(h, int64(receipt.kvCommitSeq))
    h = engine.DistributedHashStep(h, receipt.settlementSourcePeerHash)
    h = engine.DistributedHashStep(h, receipt.settlementPlanHash)
    h = engine.DistributedHashStep(h, receipt.settlementTargetPeerSetHash)
    h = engine.DistributedHashStep(h, receipt.settlementRepairDaemonReceiptHash)
    h = engine.DistributedHashStep(h, receipt.settlementRepairDaemonStateHash)
    h = engine.DistributedHashStep(h, receipt.settlementRepairReceiptHash)
    h = engine.DistributedHashStep(h, receipt.settlementRepairHash)
    h = engine.DistributedHashStep(h, receipt.previousSupervisorStateHash)
    h = engine.DistributedHashStep(h, receipt.tickSeq)
    h = engine.DistributedHashStep(h, receipt.tickedAtNs)
    h = engine.DistributedHashStep(h, receipt.nextEligibleAtNs)
    h = engine.DistributedHashStep(h, receipt.leaseUntilNs)
    h = engine.DistributedHashStep(h, receipt.intervalNs)
    h = engine.DistributedHashStep(h, receipt.kvReady ? int64(1) : int64(0))
    h = engine.DistributedHashStep(h, receipt.settlementReady ? int64(1) : int64(0))
    h = engine.DistributedHashStep(h, receipt.complete ? int64(1) : int64(0))
    h = engine.DistributedHashStep(h, receipt.kvHeadByteHash)
    h = engine.DistributedHashStep(h, receipt.repairDaemonByteHash)
    h = engine.DistributedHashStep(h, receipt.repairByteHash)
    return h

fn DepinInferenceTransportResidencySettlementSupervisorStateReceiptHash(receipt: DepinInferenceTransportResidencySettlementSupervisorStateReceipt): int64 =
    var h: int64 = int64(319)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashStep(h, receipt.stateHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn DepinInferenceTransportResidencySettlementSupervisorStateFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(321), bytesRaw)

fn depinInferenceTransportResidencySettlementSupervisorStateFileWord(receipt: DepinInferenceTransportResidencySettlementSupervisorStateReceipt,
                                                                    index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportResidencySettlementSupervisorStateFileMagic)
    if index == 1:
        return int64(DepinInferenceTransportResidencySettlementSupervisorStateFileVersion)
    if index == 2:
        return receipt.enginePlanHash
    if index == 3:
        return receipt.kvTargetPeerHash
    if index == 4:
        return receipt.kvHeadHash
    if index == 5:
        return receipt.kvCurrentStoreHash
    if index == 6:
        return receipt.kvWalLogHash
    if index == 7:
        return int64(receipt.kvCommitSeq)
    if index == 8:
        return receipt.settlementSourcePeerHash
    if index == 9:
        return receipt.settlementPlanHash
    if index == 10:
        return receipt.settlementTargetPeerSetHash
    if index == 11:
        return receipt.settlementRepairDaemonReceiptHash
    if index == 12:
        return receipt.settlementRepairDaemonStateHash
    if index == 13:
        return receipt.settlementRepairReceiptHash
    if index == 14:
        return receipt.settlementRepairHash
    if index == 15:
        return receipt.previousSupervisorStateHash
    if index == 16:
        return receipt.tickSeq
    if index == 17:
        return receipt.tickedAtNs
    if index == 18:
        return receipt.nextEligibleAtNs
    if index == 19:
        return receipt.leaseUntilNs
    if index == 20:
        return receipt.intervalNs
    if index == 21:
        return receipt.kvReady ? int64(1) : int64(0)
    if index == 22:
        return receipt.settlementReady ? int64(1) : int64(0)
    if index == 23:
        return receipt.complete ? int64(1) : int64(0)
    if index == 24:
        return receipt.kvHeadByteHash
    if index == 25:
        return receipt.repairDaemonByteHash
    if index == 26:
        return receipt.repairByteHash
    if index == 27:
        return receipt.stateHash
    return int64(-1)

fn depinInferenceTransportResidencySettlementSupervisorStateFileBytes(receipt: DepinInferenceTransportResidencySettlementSupervisorStateReceipt): Result[rawbytes.Bytes] =
    if receipt.stateHash <= int64(0):
        return Err[rawbytes.Bytes]("depin residency settlement supervisor state file: state hash")
    let byteCount = DepinInferenceTransportResidencySettlementSupervisorStateFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin residency settlement supervisor state file: allocation")
    for i in 0..<DepinInferenceTransportResidencySettlementSupervisorStateFileWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportResidencySettlementSupervisorStateFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportResidencySettlementSupervisorStateReceiptBuild(path: str,
                                                                        bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportResidencySettlementSupervisorStateReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor state file: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportResidencySettlementSupervisorStateFileWordCount * 8:
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor state file: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportResidencySettlementSupervisorStateFileMagic) ||
       version != int64(DepinInferenceTransportResidencySettlementSupervisorStateFileVersion):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor state file: header")
    let kvCommitSeqRaw = engine.DistributedReadI64LE(bytesRaw, 56)
    let tickSeqRaw = engine.DistributedReadI64LE(bytesRaw, 128)
    let kvReadyRaw = engine.DistributedReadI64LE(bytesRaw, 168)
    let settlementReadyRaw = engine.DistributedReadI64LE(bytesRaw, 176)
    let completeRaw = engine.DistributedReadI64LE(bytesRaw, 184)
    if kvCommitSeqRaw < int64(0) ||
       kvCommitSeqRaw > int64(2147483647) ||
       tickSeqRaw < int64(0) ||
       (kvReadyRaw != int64(0) && kvReadyRaw != int64(1)) ||
       (settlementReadyRaw != int64(0) && settlementReadyRaw != int64(1)) ||
       (completeRaw != int64(0) && completeRaw != int64(1)):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor state file: ranges")
    var receipt = DepinInferenceTransportResidencySettlementSupervisorStateReceipt(
        schema: DepinInferenceTransportResidencySettlementSupervisorStateSchema,
        path: path,
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 16),
        kvTargetPeerHash: engine.DistributedReadI64LE(bytesRaw, 24),
        kvHeadHash: engine.DistributedReadI64LE(bytesRaw, 32),
        kvCurrentStoreHash: engine.DistributedReadI64LE(bytesRaw, 40),
        kvWalLogHash: engine.DistributedReadI64LE(bytesRaw, 48),
        kvCommitSeq: int32(kvCommitSeqRaw),
        settlementSourcePeerHash: engine.DistributedReadI64LE(bytesRaw, 64),
        settlementPlanHash: engine.DistributedReadI64LE(bytesRaw, 72),
        settlementTargetPeerSetHash: engine.DistributedReadI64LE(bytesRaw, 80),
        settlementRepairDaemonReceiptHash: engine.DistributedReadI64LE(bytesRaw, 88),
        settlementRepairDaemonStateHash: engine.DistributedReadI64LE(bytesRaw, 96),
        settlementRepairReceiptHash: engine.DistributedReadI64LE(bytesRaw, 104),
        settlementRepairHash: engine.DistributedReadI64LE(bytesRaw, 112),
        previousSupervisorStateHash: engine.DistributedReadI64LE(bytesRaw, 120),
        tickSeq: tickSeqRaw,
        tickedAtNs: engine.DistributedReadI64LE(bytesRaw, 136),
        nextEligibleAtNs: engine.DistributedReadI64LE(bytesRaw, 144),
        leaseUntilNs: engine.DistributedReadI64LE(bytesRaw, 152),
        intervalNs: engine.DistributedReadI64LE(bytesRaw, 160),
        kvReady: kvReadyRaw == int64(1),
        settlementReady: settlementReadyRaw == int64(1),
        complete: completeRaw == int64(1),
        kvHeadByteHash: engine.DistributedReadI64LE(bytesRaw, 192),
        repairDaemonByteHash: engine.DistributedReadI64LE(bytesRaw, 200),
        repairByteHash: engine.DistributedReadI64LE(bytesRaw, 208),
        stateHash: engine.DistributedReadI64LE(bytesRaw, 216),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportResidencySettlementSupervisorStateFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinInferenceTransportResidencySettlementSupervisorStateHash(receipt) != receipt.stateHash:
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor state file: state hash")
    receipt.receiptHash = DepinInferenceTransportResidencySettlementSupervisorStateReceiptHash(receipt)
    return Ok[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](receipt)

fn DepinInferenceTransportWriteResidencySettlementSupervisorStateReceiptFile(path: str,
                                                                            draft: DepinInferenceTransportResidencySettlementSupervisorStateReceipt): Result[DepinInferenceTransportResidencySettlementSupervisorStateReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor state file: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportResidencySettlementSupervisorStateSchema
    receipt.path = path
    receipt.byteCount = DepinInferenceTransportResidencySettlementSupervisorStateFileWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.stateHash = int64(0)
    receipt.stateHash = DepinInferenceTransportResidencySettlementSupervisorStateHash(receipt)
    let bytesRes = depinInferenceTransportResidencySettlementSupervisorStateFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportResidencySettlementSupervisorStateFileByteHash(readBytes) != DepinInferenceTransportResidencySettlementSupervisorStateFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor state file: readback")
    let receiptRes = depinInferenceTransportResidencySettlementSupervisorStateReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(path: str): Result[DepinInferenceTransportResidencySettlementSupervisorStateReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor state file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportResidencySettlementSupervisorStateReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(receipt: DepinInferenceTransportResidencySettlementSupervisorStateReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportResidencySettlementSupervisorStateSchema ||
       receipt.path == "" ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.kvTargetPeerHash <= int64(0) ||
       receipt.kvHeadHash <= int64(0) ||
       receipt.kvCurrentStoreHash <= int64(0) ||
       receipt.kvWalLogHash <= int64(0) ||
       receipt.kvCommitSeq < 0 ||
       receipt.settlementSourcePeerHash <= int64(0) ||
       receipt.settlementPlanHash <= int64(0) ||
       receipt.settlementTargetPeerSetHash <= int64(0) ||
       receipt.settlementRepairDaemonReceiptHash <= int64(0) ||
       receipt.settlementRepairDaemonStateHash <= int64(0) ||
       receipt.settlementRepairReceiptHash <= int64(0) ||
       receipt.settlementRepairHash <= int64(0) ||
       receipt.tickSeq < int64(0) ||
       receipt.tickedAtNs <= int64(0) ||
       receipt.nextEligibleAtNs != receipt.tickedAtNs + receipt.intervalNs ||
       receipt.leaseUntilNs <= receipt.tickedAtNs ||
       receipt.intervalNs <= int64(0) ||
       !receipt.kvReady ||
       !receipt.settlementReady ||
       !receipt.complete ||
       receipt.kvHeadByteHash <= int64(0) ||
       receipt.repairDaemonByteHash <= int64(0) ||
       receipt.repairByteHash <= int64(0) ||
       receipt.stateHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportResidencySettlementSupervisorStateFileWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin residency settlement supervisor state receipt: fields")
    if receipt.tickSeq == int64(0) && receipt.previousSupervisorStateHash != int64(0):
        return Err[bool]("depin residency settlement supervisor state receipt: initial predecessor")
    if receipt.tickSeq > int64(0) && receipt.previousSupervisorStateHash <= int64(0):
        return Err[bool]("depin residency settlement supervisor state receipt: predecessor")
    if DepinInferenceTransportResidencySettlementSupervisorStateHash(receipt) != receipt.stateHash:
        return Err[bool]("depin residency settlement supervisor state receipt: state hash")
    if DepinInferenceTransportResidencySettlementSupervisorStateReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin residency settlement supervisor state receipt: receipt hash")
    let readRes = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).stateHash != receipt.stateHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin residency settlement supervisor state receipt: readback")
    return Ok[bool](true)

fn DepinInferenceTransportResidencySettlementSupervisorStatePathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".cssv1"], "")

fn DepinInferenceTransportResidencySettlementDaemonRunReceiptPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csdl1"], "")

fn DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csdw1"], "")

fn DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csos1"], "")

fn DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csdb1"], "")

fn DepinInferenceTransportResidencySettlementDaemonHealthReceiptPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".cshl1"], "")

fn DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextPathFromPrefix(prefix: str,
                                                                                  serviceKind: str): Result[str] =
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd:
        return Ok[str](strutil.Join([prefix, ".plist"], ""))
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd:
        return Ok[str](strutil.Join([prefix, ".service"], ""))
    return Err[str]("depin residency settlement daemon os service spec: kind")

fn DepinInferenceTransportResidencySettlementDaemonOsServiceTriggerSpecTextPathFromPrefix(prefix: str,
                                                                                         serviceKind: str): Result[str] =
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd:
        return Ok[str]("")
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd:
        return Ok[str](strutil.Join([prefix, ".path"], ""))
    return Err[str]("depin residency settlement daemon os service spec: kind")

fn DepinInferenceTransportDistributedPeerSetHash(peers: engine.DistributedInferencePeer[]): int64 =
    var h: int64 = int64(377)
    h = engine.DistributedHashStep(h, int64(peers.len))
    for i in 0..<peers.len:
        h = engine.DistributedHashTextWith(h, peers[i].peerId)
        h = engine.DistributedHashTextWith(h, peers[i].deviceCapabilityHash)
        h = engine.DistributedHashStep(h, peers[i].online ? int64(1) : int64(0))
        h = engine.DistributedHashStep(h, int64(peers[i].tensorShardBudget))
        h = engine.DistributedHashStep(h, int64(peers[i].expertShardBudget))
    return h

fn DepinInferenceTransportResidencySettlementDaemonConfigHash(config: DepinInferenceTransportResidencySettlementDaemonConfig): int64 =
    var h: int64 = int64(331)
    h = engine.DistributedHashTextWith(h, config.schema)
    h = engine.DistributedHashTextWith(h, config.daemonId)
    h = engine.DistributedHashTextWith(h, config.eventStreamId)
    h = engine.DistributedHashTextWith(h, config.residencyPathPrefix)
    h = engine.DistributedHashTextWith(h, config.supervisorStatePath)
    h = engine.DistributedHashTextWith(h, config.daemonRunReceiptPath)
    h = engine.DistributedHashStep(h, config.intervalNs)
    h = engine.DistributedHashStep(h, config.leaseNs)
    h = engine.DistributedHashStep(h, int64(config.maxEvents))
    return h

fn DepinInferenceTransportBuildResidencySettlementDaemonConfig(daemonId: str,
                                                               eventStreamId: str,
                                                               residencyPathPrefix: str,
                                                               supervisorStatePath: str,
                                                               daemonRunReceiptPath: str,
                                                               intervalNs: int64,
                                                               leaseNs: int64,
                                                               maxEvents: int32): DepinInferenceTransportResidencySettlementDaemonConfig =
    var config = DepinInferenceTransportResidencySettlementDaemonConfig(
        schema: DepinInferenceTransportResidencySettlementDaemonConfigSchema,
        daemonId: daemonId,
        eventStreamId: eventStreamId,
        residencyPathPrefix: residencyPathPrefix,
        supervisorStatePath: supervisorStatePath,
        daemonRunReceiptPath: daemonRunReceiptPath,
        intervalNs: intervalNs,
        leaseNs: leaseNs,
        maxEvents: maxEvents,
        configHash: int64(0)
    )
    config.configHash = DepinInferenceTransportResidencySettlementDaemonConfigHash(config)
    return config

fn DepinInferenceTransportValidateResidencySettlementDaemonConfig(config: DepinInferenceTransportResidencySettlementDaemonConfig): Result[bool] =
    if config.schema != DepinInferenceTransportResidencySettlementDaemonConfigSchema ||
       config.daemonId == "" ||
       config.eventStreamId == "" ||
       config.residencyPathPrefix == "" ||
       config.supervisorStatePath == "" ||
       config.daemonRunReceiptPath == "" ||
       config.intervalNs <= int64(0) ||
       config.leaseNs <= int64(0) ||
       config.maxEvents <= 0 ||
       config.maxEvents > 1024 ||
       config.configHash <= int64(0):
        return Err[bool]("depin residency settlement daemon config: fields")
    if config.supervisorStatePath != DepinInferenceTransportResidencySettlementSupervisorStatePathFromPrefix(config.residencyPathPrefix):
        return Err[bool]("depin residency settlement daemon config: supervisor path")
    if config.daemonRunReceiptPath != DepinInferenceTransportResidencySettlementDaemonRunReceiptPathFromPrefix(config.residencyPathPrefix):
        return Err[bool]("depin residency settlement daemon config: run path")
    if DepinInferenceTransportResidencySettlementDaemonConfigHash(config) != config.configHash:
        return Err[bool]("depin residency settlement daemon config: hash")
    return Ok[bool](true)

fn DepinInferenceTransportResidencySettlementDaemonStartupBundleHash(receipt: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt): int64 =
    var h: int64 = int64(379)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.configHash)
    h = engine.DistributedHashStep(h, receipt.daemonIdHash)
    h = engine.DistributedHashStep(h, receipt.eventStreamHash)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.peerSetHash)
    h = engine.DistributedHashStep(h, receipt.baseStoreHash)
    h = engine.DistributedHashStep(h, receipt.kvHeadHash)
    h = engine.DistributedHashStep(h, receipt.kvHeadByteHash)
    h = engine.DistributedHashStep(h, receipt.kvTargetPeerTransportHash)
    h = engine.DistributedHashStep(h, receipt.kvTargetPeerHash)
    h = engine.DistributedHashStep(h, receipt.repairDaemonStateHash)
    h = engine.DistributedHashStep(h, receipt.repairDaemonByteHash)
    h = engine.DistributedHashStep(h, receipt.supervisorStateHash)
    h = engine.DistributedHashStep(h, receipt.supervisorByteHash)
    h = engine.DistributedHashStep(h, DepinSettlementTextHash(receipt.path))
    h = engine.DistributedHashStep(h, receipt.residencyPrefixHash)
    h = engine.DistributedHashStep(h, receipt.createdAtNs)
    h = engine.DistributedHashStep(h, receipt.complete ? int64(1) : int64(0))
    return h

fn DepinInferenceTransportResidencySettlementDaemonStartupBundleReceiptHash(receipt: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt): int64 =
    var h: int64 = int64(381)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashStep(h, receipt.bundleHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn DepinInferenceTransportResidencySettlementDaemonStartupBundleFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(383), bytesRaw)

fn depinInferenceTransportResidencySettlementDaemonStartupBundleFileWord(receipt: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                         index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportResidencySettlementDaemonStartupBundleMagic)
    if index == 1:
        return int64(DepinInferenceTransportResidencySettlementDaemonStartupBundleVersion)
    if index == 2:
        return receipt.configHash
    if index == 3:
        return receipt.daemonIdHash
    if index == 4:
        return receipt.eventStreamHash
    if index == 5:
        return receipt.enginePlanHash
    if index == 6:
        return receipt.peerSetHash
    if index == 7:
        return receipt.baseStoreHash
    if index == 8:
        return receipt.kvHeadHash
    if index == 9:
        return receipt.kvHeadByteHash
    if index == 10:
        return receipt.kvTargetPeerTransportHash
    if index == 11:
        return receipt.kvTargetPeerHash
    if index == 12:
        return receipt.repairDaemonStateHash
    if index == 13:
        return receipt.repairDaemonByteHash
    if index == 14:
        return receipt.supervisorStateHash
    if index == 15:
        return receipt.supervisorByteHash
    if index == 16:
        return DepinSettlementTextHash(receipt.path)
    if index == 17:
        return receipt.residencyPrefixHash
    if index == 18:
        return receipt.createdAtNs
    if index == 19:
        return receipt.complete ? int64(1) : int64(0)
    if index == 20:
        return receipt.bundleHash
    return int64(-1)

fn depinInferenceTransportResidencySettlementDaemonStartupBundleFileBytes(receipt: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt): Result[rawbytes.Bytes] =
    if receipt.bundleHash <= int64(0):
        return Err[rawbytes.Bytes]("depin residency settlement daemon startup bundle: bundle hash")
    let byteCount = DepinInferenceTransportResidencySettlementDaemonStartupBundleWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin residency settlement daemon startup bundle: allocation")
    for i in 0..<DepinInferenceTransportResidencySettlementDaemonStartupBundleWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportResidencySettlementDaemonStartupBundleFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportResidencySettlementDaemonStartupBundleReceiptBuild(path: str,
                                                                             bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportResidencySettlementDaemonStartupBundleWordCount * 8:
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportResidencySettlementDaemonStartupBundleMagic) ||
       version != int64(DepinInferenceTransportResidencySettlementDaemonStartupBundleVersion):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: header")
    let completeRaw = engine.DistributedReadI64LE(bytesRaw, 152)
    if completeRaw != int64(0) && completeRaw != int64(1):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: complete")
    var receipt = DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonStartupBundleSchema,
        path: path,
        configHash: engine.DistributedReadI64LE(bytesRaw, 16),
        daemonIdHash: engine.DistributedReadI64LE(bytesRaw, 24),
        eventStreamHash: engine.DistributedReadI64LE(bytesRaw, 32),
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 40),
        peerSetHash: engine.DistributedReadI64LE(bytesRaw, 48),
        baseStoreHash: engine.DistributedReadI64LE(bytesRaw, 56),
        kvHeadHash: engine.DistributedReadI64LE(bytesRaw, 64),
        kvHeadByteHash: engine.DistributedReadI64LE(bytesRaw, 72),
        kvTargetPeerTransportHash: engine.DistributedReadI64LE(bytesRaw, 80),
        kvTargetPeerHash: engine.DistributedReadI64LE(bytesRaw, 88),
        repairDaemonStateHash: engine.DistributedReadI64LE(bytesRaw, 96),
        repairDaemonByteHash: engine.DistributedReadI64LE(bytesRaw, 104),
        supervisorStateHash: engine.DistributedReadI64LE(bytesRaw, 112),
        supervisorByteHash: engine.DistributedReadI64LE(bytesRaw, 120),
        residencyPrefixHash: engine.DistributedReadI64LE(bytesRaw, 136),
        createdAtNs: engine.DistributedReadI64LE(bytesRaw, 144),
        complete: completeRaw == int64(1),
        bundleHash: engine.DistributedReadI64LE(bytesRaw, 160),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportResidencySettlementDaemonStartupBundleFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinSettlementTextHash(path) != engine.DistributedReadI64LE(bytesRaw, 128):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: path hash")
    if DepinInferenceTransportResidencySettlementDaemonStartupBundleHash(receipt) != receipt.bundleHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: hash")
    receipt.receiptHash = DepinInferenceTransportResidencySettlementDaemonStartupBundleReceiptHash(receipt)
    return Ok[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](receipt)

fn DepinInferenceTransportReadResidencySettlementDaemonStartupBundleReceiptFile(path: str): Result[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportResidencySettlementDaemonStartupBundleReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(receipt: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportResidencySettlementDaemonStartupBundleSchema ||
       receipt.path == "" ||
       receipt.configHash <= int64(0) ||
       receipt.daemonIdHash <= int64(0) ||
       receipt.eventStreamHash <= int64(0) ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.peerSetHash <= int64(0) ||
       receipt.baseStoreHash <= int64(0) ||
       receipt.kvHeadHash <= int64(0) ||
       receipt.kvHeadByteHash <= int64(0) ||
       receipt.kvTargetPeerTransportHash <= int64(0) ||
       receipt.kvTargetPeerHash <= int64(0) ||
       receipt.repairDaemonStateHash <= int64(0) ||
       receipt.repairDaemonByteHash <= int64(0) ||
       receipt.residencyPrefixHash <= int64(0) ||
       receipt.createdAtNs <= int64(0) ||
       !receipt.complete ||
       receipt.bundleHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportResidencySettlementDaemonStartupBundleWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin residency settlement daemon startup bundle receipt: fields")
    if (receipt.supervisorStateHash == int64(0)) != (receipt.supervisorByteHash == int64(0)):
        return Err[bool]("depin residency settlement daemon startup bundle receipt: supervisor")
    if DepinInferenceTransportResidencySettlementDaemonStartupBundleHash(receipt) != receipt.bundleHash:
        return Err[bool]("depin residency settlement daemon startup bundle receipt: bundle hash")
    if DepinInferenceTransportResidencySettlementDaemonStartupBundleReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon startup bundle receipt: receipt hash")
    let readRes = DepinInferenceTransportReadResidencySettlementDaemonStartupBundleReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).bundleHash != receipt.bundleHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon startup bundle receipt: readback")
    return Ok[bool](true)

fn DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceipt(plan: engine.DistributedInferencePlan,
                                                                               peers: engine.DistributedInferencePeer[],
                                                                               baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                                               config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                               receipt: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt): Result[bool] =
    let selfOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(receipt)
    if IsErr(selfOk):
        return Err[bool](Error(selfOk))
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[bool](Error(configOk))
    let baseOk = engine.DistributedValidateKvResidencyStore(plan, peers, baseKvResidencyStore)
    if IsErr(baseOk):
        return Err[bool](Error(baseOk))
    if receipt.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix) ||
       receipt.configHash != config.configHash ||
       receipt.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
       receipt.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.peerSetHash != DepinInferenceTransportDistributedPeerSetHash(peers) ||
       receipt.baseStoreHash != baseKvResidencyStore.storeHash ||
       receipt.residencyPrefixHash != DepinSettlementTextHash(config.residencyPathPrefix):
        return Err[bool]("depin residency settlement daemon startup bundle receipt: binding")
    let headPath = strutil.Join([config.residencyPathPrefix, ".ckvh1"], "")
    let headRead = engine.DistributedReadKvResidencyHeadFile(plan, peers, headPath)
    if IsErr(headRead):
        return Err[bool](Error(headRead))
    let head = Value(headRead).receipt
    let headOk = engine.DistributedValidateKvResidencyHeadFileReceipt(plan, peers, baseKvResidencyStore, head)
    if IsErr(headOk):
        return Err[bool](Error(headOk))
    if head.headHash != receipt.kvHeadHash ||
       head.byteHash != receipt.kvHeadByteHash ||
       engine.DistributedTransportFrameTextHash(head.targetPeerId) != receipt.kvTargetPeerTransportHash ||
       DepinSettlementTextHash(head.targetPeerId) != receipt.kvTargetPeerHash:
        return Err[bool]("depin residency settlement daemon startup bundle receipt: head drift")
    let repairDaemonPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(config.residencyPathPrefix)
    let repairRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(repairDaemonPath)
    if IsErr(repairRead):
        return Err[bool](Error(repairRead))
    let repairDaemon = Value(repairRead)
    let repairOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(repairDaemon)
    if IsErr(repairOk):
        return Err[bool](Error(repairOk))
    if repairDaemon.enginePlanHash != plan.engineHash ||
       repairDaemon.stateHash != receipt.repairDaemonStateHash ||
       repairDaemon.byteHash != receipt.repairDaemonByteHash:
        return Err[bool]("depin residency settlement daemon startup bundle receipt: repair drift")
    if os.FileExists(config.supervisorStatePath):
        let supervisorRead = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(config.supervisorStatePath)
        if IsErr(supervisorRead):
            return Err[bool](Error(supervisorRead))
        let supervisor = Value(supervisorRead)
        let supervisorOk = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(supervisor)
        if IsErr(supervisorOk):
            return Err[bool](Error(supervisorOk))
        if supervisor.enginePlanHash != plan.engineHash ||
           supervisor.stateHash != receipt.supervisorStateHash ||
           supervisor.byteHash != receipt.supervisorByteHash:
            return Err[bool]("depin residency settlement daemon startup bundle receipt: supervisor drift")
    elif receipt.supervisorStateHash != int64(0) || receipt.supervisorByteHash != int64(0):
        return Err[bool]("depin residency settlement daemon startup bundle receipt: supervisor missing")
    return Ok[bool](true)

fn DepinInferenceTransportWriteResidencySettlementDaemonStartupBundleReceiptFile(path: str,
                                                                                 draft: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt): Result[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportResidencySettlementDaemonStartupBundleSchema
    receipt.path = path
    receipt.byteCount = DepinInferenceTransportResidencySettlementDaemonStartupBundleWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.bundleHash = int64(0)
    receipt.bundleHash = DepinInferenceTransportResidencySettlementDaemonStartupBundleHash(receipt)
    let bytesRes = depinInferenceTransportResidencySettlementDaemonStartupBundleFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportResidencySettlementDaemonStartupBundleFileByteHash(readBytes) != DepinInferenceTransportResidencySettlementDaemonStartupBundleFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: readback")
    let receiptRes = depinInferenceTransportResidencySettlementDaemonStartupBundleReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportWriteResidencySettlementDaemonStartupBundle(plan: engine.DistributedInferencePlan,
                                                                      peers: engine.DistributedInferencePeer[],
                                                                      baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                                      config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                      createdAtNs: int64): Result[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(configOk))
    let baseOk = engine.DistributedValidateKvResidencyStore(plan, peers, baseKvResidencyStore)
    if IsErr(baseOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(baseOk))
    if createdAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: time")
    let headPath = strutil.Join([config.residencyPathPrefix, ".ckvh1"], "")
    let headRead = engine.DistributedReadKvResidencyHeadFile(plan, peers, headPath)
    if IsErr(headRead):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(headRead))
    let head = Value(headRead).receipt
    let headOk = engine.DistributedValidateKvResidencyHeadFileReceipt(plan, peers, baseKvResidencyStore, head)
    if IsErr(headOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(headOk))
    let repairDaemonPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(config.residencyPathPrefix)
    let repairRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(repairDaemonPath)
    if IsErr(repairRead):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(repairRead))
    let repairDaemon = Value(repairRead)
    let repairOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(repairDaemon)
    if IsErr(repairOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(repairOk))
    if repairDaemon.enginePlanHash != plan.engineHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: repair plan")
    var supervisorStateHash: int64
    var supervisorByteHash: int64
    if os.FileExists(config.supervisorStatePath):
        let supervisorRead = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(config.supervisorStatePath)
        if IsErr(supervisorRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(supervisorRead))
        let supervisor = Value(supervisorRead)
        let supervisorOk = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(supervisor)
        if IsErr(supervisorOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(supervisorOk))
        if supervisor.enginePlanHash != plan.engineHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt]("depin residency settlement daemon startup bundle: supervisor plan")
        supervisorStateHash = supervisor.stateHash
        supervisorByteHash = supervisor.byteHash
    let path = DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix)
    var draft = DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonStartupBundleSchema,
        path: path,
        configHash: config.configHash,
        daemonIdHash: DepinSettlementTextHash(config.daemonId),
        eventStreamHash: DepinSettlementTextHash(config.eventStreamId),
        enginePlanHash: plan.engineHash,
        peerSetHash: DepinInferenceTransportDistributedPeerSetHash(peers),
        baseStoreHash: baseKvResidencyStore.storeHash,
        kvHeadHash: head.headHash,
        kvHeadByteHash: head.byteHash,
        kvTargetPeerTransportHash: engine.DistributedTransportFrameTextHash(head.targetPeerId),
        kvTargetPeerHash: DepinSettlementTextHash(head.targetPeerId),
        repairDaemonStateHash: repairDaemon.stateHash,
        repairDaemonByteHash: repairDaemon.byteHash,
        supervisorStateHash: supervisorStateHash,
        supervisorByteHash: supervisorByteHash,
        residencyPrefixHash: DepinSettlementTextHash(config.residencyPathPrefix),
        createdAtNs: createdAtNs,
        complete: true,
        bundleHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    let writeRes = DepinInferenceTransportWriteResidencySettlementDaemonStartupBundleReceiptFile(path, draft)
    if IsErr(writeRes):
        return writeRes
    let ok = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceipt(plan, peers, baseKvResidencyStore, config, Value(writeRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt](Error(ok))
    return writeRes

fn depinInferenceTransportResidencySettlementDaemonPrefixFromStartupBundlePath(path: str): Result[str] =
    if !strings.HasSuffix(path, ".csdb1"):
        return Err[str]("depin residency settlement daemon health receipt: startup bundle suffix")
    let n = strings.Len(path)
    if n <= 6:
        return Err[str]("depin residency settlement daemon health receipt: startup bundle path")
    return Ok[str](strings.SliceBytes(path, 0, n - 6))

fn depinInferenceTransportResidencySettlementDaemonPrefixFromHealthReceiptPath(path: str): Result[str] =
    if !strings.HasSuffix(path, ".cshl1"):
        return Err[str]("depin residency settlement daemon health receipt: suffix")
    let n = strings.Len(path)
    if n <= 6:
        return Err[str]("depin residency settlement daemon health receipt: path")
    return Ok[str](strings.SliceBytes(path, 0, n - 6))

fn DepinInferenceTransportResidencySettlementDaemonHealthHash(receipt: DepinInferenceTransportResidencySettlementDaemonHealthReceipt): int64 =
    var h: int64 = int64(385)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashTextWith(h, receipt.startupBundlePath)
    h = engine.DistributedHashStep(h, receipt.configHash)
    h = engine.DistributedHashStep(h, receipt.daemonIdHash)
    h = engine.DistributedHashStep(h, receipt.eventStreamHash)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.peerSetHash)
    h = engine.DistributedHashStep(h, receipt.baseStoreHash)
    h = engine.DistributedHashStep(h, receipt.startupBundleReceiptHash)
    h = engine.DistributedHashStep(h, receipt.startupBundleByteHash)
    h = engine.DistributedHashStep(h, receipt.kvHeadByteHash)
    h = engine.DistributedHashStep(h, receipt.repairDaemonByteHash)
    h = engine.DistributedHashStep(h, receipt.supervisorByteHash)
    h = engine.DistributedHashStep(h, receipt.processPid)
    h = engine.DistributedHashStep(h, receipt.checkedAtNs)
    h = engine.DistributedHashStep(h, receipt.healthy ? int64(1) : int64(0))
    return h

fn DepinInferenceTransportResidencySettlementDaemonHealthReceiptHash(receipt: DepinInferenceTransportResidencySettlementDaemonHealthReceipt): int64 =
    var h: int64 = int64(387)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashTextWith(h, receipt.startupBundlePath)
    h = engine.DistributedHashStep(h, receipt.healthHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn DepinInferenceTransportResidencySettlementDaemonHealthFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(389), bytesRaw)

fn depinInferenceTransportResidencySettlementDaemonHealthFileWord(receipt: DepinInferenceTransportResidencySettlementDaemonHealthReceipt,
                                                                  index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportResidencySettlementDaemonHealthFileMagic)
    if index == 1:
        return int64(DepinInferenceTransportResidencySettlementDaemonHealthFileVersion)
    if index == 2:
        return receipt.configHash
    if index == 3:
        return receipt.daemonIdHash
    if index == 4:
        return receipt.eventStreamHash
    if index == 5:
        return receipt.enginePlanHash
    if index == 6:
        return receipt.peerSetHash
    if index == 7:
        return receipt.baseStoreHash
    if index == 8:
        return receipt.startupBundleReceiptHash
    if index == 9:
        return receipt.startupBundleByteHash
    if index == 10:
        return receipt.kvHeadByteHash
    if index == 11:
        return receipt.repairDaemonByteHash
    if index == 12:
        return receipt.supervisorByteHash
    if index == 13:
        return DepinSettlementTextHash(receipt.path)
    if index == 14:
        return DepinSettlementTextHash(receipt.startupBundlePath)
    if index == 15:
        return receipt.processPid
    if index == 16:
        return receipt.checkedAtNs
    if index == 17:
        return receipt.healthy ? int64(1) : int64(0)
    if index == 18:
        return receipt.healthHash
    return int64(-1)

fn depinInferenceTransportResidencySettlementDaemonHealthFileBytes(receipt: DepinInferenceTransportResidencySettlementDaemonHealthReceipt): Result[rawbytes.Bytes] =
    if receipt.healthHash <= int64(0):
        return Err[rawbytes.Bytes]("depin residency settlement daemon health receipt: health hash")
    let byteCount = DepinInferenceTransportResidencySettlementDaemonHealthFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin residency settlement daemon health receipt: allocation")
    for i in 0..<DepinInferenceTransportResidencySettlementDaemonHealthFileWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportResidencySettlementDaemonHealthFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportResidencySettlementDaemonHealthReceiptBuild(path: str,
                                                                      bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportResidencySettlementDaemonHealthReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportResidencySettlementDaemonHealthFileWordCount * 8:
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportResidencySettlementDaemonHealthFileMagic) ||
       version != int64(DepinInferenceTransportResidencySettlementDaemonHealthFileVersion):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: header")
    let prefixRes = depinInferenceTransportResidencySettlementDaemonPrefixFromHealthReceiptPath(path)
    if IsErr(prefixRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(prefixRes))
    let startupBundlePath = DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(Value(prefixRes))
    let healthyRaw = engine.DistributedReadI64LE(bytesRaw, 136)
    if healthyRaw != int64(0) && healthyRaw != int64(1):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: healthy")
    var receipt = DepinInferenceTransportResidencySettlementDaemonHealthReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonHealthReceiptSchema,
        path: path,
        startupBundlePath: startupBundlePath,
        configHash: engine.DistributedReadI64LE(bytesRaw, 16),
        daemonIdHash: engine.DistributedReadI64LE(bytesRaw, 24),
        eventStreamHash: engine.DistributedReadI64LE(bytesRaw, 32),
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 40),
        peerSetHash: engine.DistributedReadI64LE(bytesRaw, 48),
        baseStoreHash: engine.DistributedReadI64LE(bytesRaw, 56),
        startupBundleReceiptHash: engine.DistributedReadI64LE(bytesRaw, 64),
        startupBundleByteHash: engine.DistributedReadI64LE(bytesRaw, 72),
        kvHeadByteHash: engine.DistributedReadI64LE(bytesRaw, 80),
        repairDaemonByteHash: engine.DistributedReadI64LE(bytesRaw, 88),
        supervisorByteHash: engine.DistributedReadI64LE(bytesRaw, 96),
        processPid: engine.DistributedReadI64LE(bytesRaw, 120),
        checkedAtNs: engine.DistributedReadI64LE(bytesRaw, 128),
        healthy: healthyRaw == int64(1),
        healthHash: engine.DistributedReadI64LE(bytesRaw, 144),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportResidencySettlementDaemonHealthFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinSettlementTextHash(path) != engine.DistributedReadI64LE(bytesRaw, 104) ||
       DepinSettlementTextHash(startupBundlePath) != engine.DistributedReadI64LE(bytesRaw, 112):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: path hash")
    if DepinInferenceTransportResidencySettlementDaemonHealthHash(receipt) != receipt.healthHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: hash")
    receipt.receiptHash = DepinInferenceTransportResidencySettlementDaemonHealthReceiptHash(receipt)
    return Ok[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](receipt)

fn DepinInferenceTransportReadResidencySettlementDaemonHealthReceiptFile(path: str): Result[DepinInferenceTransportResidencySettlementDaemonHealthReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportResidencySettlementDaemonHealthReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateResidencySettlementDaemonHealthReceiptSelf(receipt: DepinInferenceTransportResidencySettlementDaemonHealthReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportResidencySettlementDaemonHealthReceiptSchema ||
       receipt.path == "" ||
       receipt.startupBundlePath == "" ||
       receipt.configHash <= int64(0) ||
       receipt.daemonIdHash <= int64(0) ||
       receipt.eventStreamHash <= int64(0) ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.peerSetHash <= int64(0) ||
       receipt.baseStoreHash <= int64(0) ||
       receipt.startupBundleReceiptHash <= int64(0) ||
       receipt.startupBundleByteHash <= int64(0) ||
       receipt.kvHeadByteHash <= int64(0) ||
       receipt.repairDaemonByteHash <= int64(0) ||
       receipt.supervisorByteHash < int64(0) ||
       receipt.processPid < int64(0) ||
       receipt.checkedAtNs <= int64(0) ||
       !receipt.healthy ||
       receipt.healthHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportResidencySettlementDaemonHealthFileWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin residency settlement daemon health receipt: fields")
    let prefixFromHealth = depinInferenceTransportResidencySettlementDaemonPrefixFromHealthReceiptPath(receipt.path)
    if IsErr(prefixFromHealth):
        return Err[bool](Error(prefixFromHealth))
    let prefixFromStartup = depinInferenceTransportResidencySettlementDaemonPrefixFromStartupBundlePath(receipt.startupBundlePath)
    if IsErr(prefixFromStartup):
        return Err[bool](Error(prefixFromStartup))
    if Value(prefixFromHealth) != Value(prefixFromStartup):
        return Err[bool]("depin residency settlement daemon health receipt: prefix")
    if DepinInferenceTransportResidencySettlementDaemonHealthHash(receipt) != receipt.healthHash:
        return Err[bool]("depin residency settlement daemon health receipt: health hash")
    if DepinInferenceTransportResidencySettlementDaemonHealthReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon health receipt: receipt hash")
    let readRes = DepinInferenceTransportReadResidencySettlementDaemonHealthReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).healthHash != receipt.healthHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon health receipt: readback")
    let startupRead = DepinInferenceTransportReadResidencySettlementDaemonStartupBundleReceiptFile(receipt.startupBundlePath)
    if IsErr(startupRead):
        return Err[bool](Error(startupRead))
    let startupOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(Value(startupRead))
    if IsErr(startupOk):
        return Err[bool](Error(startupOk))
    let startupBundle = Value(startupRead)
    if startupBundle.configHash != receipt.configHash ||
       startupBundle.daemonIdHash != receipt.daemonIdHash ||
       startupBundle.eventStreamHash != receipt.eventStreamHash ||
       startupBundle.enginePlanHash != receipt.enginePlanHash ||
       startupBundle.peerSetHash != receipt.peerSetHash ||
       startupBundle.baseStoreHash != receipt.baseStoreHash ||
       startupBundle.receiptHash != receipt.startupBundleReceiptHash ||
       startupBundle.byteHash != receipt.startupBundleByteHash:
        return Err[bool]("depin residency settlement daemon health receipt: startup bundle")
    let startupBytes = os.ReadFileBytesResult(receipt.startupBundlePath)
    if IsErr(startupBytes):
        return Err[bool](Error(startupBytes))
    var startupBytesRaw = Value(startupBytes)
    let startupByteHash = DepinInferenceTransportResidencySettlementDaemonStartupBundleFileByteHash(startupBytesRaw)
    rawbytes.BytesFree(startupBytesRaw)
    if startupByteHash != receipt.startupBundleByteHash:
        return Err[bool]("depin residency settlement daemon health receipt: startup bytes")
    let headPath = strutil.Join([Value(prefixFromHealth), ".ckvh1"], "")
    let headBytes = os.ReadFileBytesResult(headPath)
    if IsErr(headBytes):
        return Err[bool](Error(headBytes))
    var headBytesRaw = Value(headBytes)
    let headByteHash = engine.DistributedKvResidencyHeadFileByteHash(headBytesRaw)
    rawbytes.BytesFree(headBytesRaw)
    if headByteHash != receipt.kvHeadByteHash:
        return Err[bool]("depin residency settlement daemon health receipt: kv head")
    let repairPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(Value(prefixFromHealth))
    let repairRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(repairPath)
    if IsErr(repairRead):
        return Err[bool](Error(repairRead))
    let repairOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(Value(repairRead))
    if IsErr(repairOk):
        return Err[bool](Error(repairOk))
    if Value(repairRead).enginePlanHash != receipt.enginePlanHash:
        return Err[bool]("depin residency settlement daemon health receipt: repair plan")
    let repairBytes = os.ReadFileBytesResult(repairPath)
    if IsErr(repairBytes):
        return Err[bool](Error(repairBytes))
    var repairBytesRaw = Value(repairBytes)
    let repairByteHash = DepinInferenceTransportSettlementRepairDaemonStateFileByteHash(repairBytesRaw)
    rawbytes.BytesFree(repairBytesRaw)
    if repairByteHash != receipt.repairDaemonByteHash:
        return Err[bool]("depin residency settlement daemon health receipt: repair daemon")
    let supervisorPath = DepinInferenceTransportResidencySettlementSupervisorStatePathFromPrefix(Value(prefixFromHealth))
    if receipt.supervisorByteHash > int64(0):
        let supervisorRead = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(supervisorPath)
        if IsErr(supervisorRead):
            return Err[bool](Error(supervisorRead))
        let supervisorOk = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(Value(supervisorRead))
        if IsErr(supervisorOk):
            return Err[bool](Error(supervisorOk))
        if Value(supervisorRead).enginePlanHash != receipt.enginePlanHash:
            return Err[bool]("depin residency settlement daemon health receipt: supervisor plan")
        let supervisorBytes = os.ReadFileBytesResult(supervisorPath)
        if IsErr(supervisorBytes):
            return Err[bool](Error(supervisorBytes))
        var supervisorBytesRaw = Value(supervisorBytes)
        let supervisorByteHash = DepinInferenceTransportResidencySettlementSupervisorStateFileByteHash(supervisorBytesRaw)
        rawbytes.BytesFree(supervisorBytesRaw)
        if supervisorByteHash != receipt.supervisorByteHash:
            return Err[bool]("depin residency settlement daemon health receipt: supervisor")
    elif os.FileExists(supervisorPath):
        return Err[bool]("depin residency settlement daemon health receipt: unexpected supervisor")
    return Ok[bool](true)

fn DepinInferenceTransportWriteResidencySettlementDaemonHealthReceiptFile(path: str,
                                                                          draft: DepinInferenceTransportResidencySettlementDaemonHealthReceipt): Result[DepinInferenceTransportResidencySettlementDaemonHealthReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportResidencySettlementDaemonHealthReceiptSchema
    receipt.path = path
    receipt.byteCount = DepinInferenceTransportResidencySettlementDaemonHealthFileWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.healthHash = int64(0)
    receipt.healthHash = DepinInferenceTransportResidencySettlementDaemonHealthHash(receipt)
    let bytesRes = depinInferenceTransportResidencySettlementDaemonHealthFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportResidencySettlementDaemonHealthFileByteHash(readBytes) != DepinInferenceTransportResidencySettlementDaemonHealthFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: readback")
    let receiptRes = depinInferenceTransportResidencySettlementDaemonHealthReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateResidencySettlementDaemonHealthReceiptSelf(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportWriteResidencySettlementDaemonHealthReceiptFromStartupBundle(startupBundlePath: str,
                                                                                      processPid: int64,
                                                                                      checkedAtNs: int64): Result[DepinInferenceTransportResidencySettlementDaemonHealthReceipt] =
    if startupBundlePath == "" ||
       processPid < int64(0) ||
       checkedAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: args")
    let prefixRes = depinInferenceTransportResidencySettlementDaemonPrefixFromStartupBundlePath(startupBundlePath)
    if IsErr(prefixRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(prefixRes))
    let startupRead = DepinInferenceTransportReadResidencySettlementDaemonStartupBundleReceiptFile(startupBundlePath)
    if IsErr(startupRead):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(startupRead))
    let startupOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(Value(startupRead))
    if IsErr(startupOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(startupOk))
    let startupBundle = Value(startupRead)
    let startupBytes = os.ReadFileBytesResult(startupBundlePath)
    if IsErr(startupBytes):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(startupBytes))
    var startupBytesRaw = Value(startupBytes)
    let startupByteHash = DepinInferenceTransportResidencySettlementDaemonStartupBundleFileByteHash(startupBytesRaw)
    rawbytes.BytesFree(startupBytesRaw)
    if startupByteHash != startupBundle.byteHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: startup bytes")
    let headPath = strutil.Join([Value(prefixRes), ".ckvh1"], "")
    let headBytes = os.ReadFileBytesResult(headPath)
    if IsErr(headBytes):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(headBytes))
    var headBytesRaw = Value(headBytes)
    let headByteHash = engine.DistributedKvResidencyHeadFileByteHash(headBytesRaw)
    rawbytes.BytesFree(headBytesRaw)
    let repairPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(Value(prefixRes))
    let repairRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(repairPath)
    if IsErr(repairRead):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(repairRead))
    let repairOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(Value(repairRead))
    if IsErr(repairOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(repairOk))
    if Value(repairRead).enginePlanHash != startupBundle.enginePlanHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: repair plan")
    let repairBytes = os.ReadFileBytesResult(repairPath)
    if IsErr(repairBytes):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(repairBytes))
    var repairBytesRaw = Value(repairBytes)
    let repairByteHash = DepinInferenceTransportSettlementRepairDaemonStateFileByteHash(repairBytesRaw)
    rawbytes.BytesFree(repairBytesRaw)
    let supervisorPath = DepinInferenceTransportResidencySettlementSupervisorStatePathFromPrefix(Value(prefixRes))
    var supervisorByteHash: int64
    if os.FileExists(supervisorPath):
        let supervisorRead = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(supervisorPath)
        if IsErr(supervisorRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(supervisorRead))
        let supervisorOk = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(Value(supervisorRead))
        if IsErr(supervisorOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(supervisorOk))
        if Value(supervisorRead).enginePlanHash != startupBundle.enginePlanHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: supervisor plan")
        let supervisorBytes = os.ReadFileBytesResult(supervisorPath)
        if IsErr(supervisorBytes):
            return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt](Error(supervisorBytes))
        var supervisorBytesRaw = Value(supervisorBytes)
        supervisorByteHash = DepinInferenceTransportResidencySettlementSupervisorStateFileByteHash(supervisorBytesRaw)
        rawbytes.BytesFree(supervisorBytesRaw)
    elif startupBundle.supervisorByteHash > int64(0):
        return Err[DepinInferenceTransportResidencySettlementDaemonHealthReceipt]("depin residency settlement daemon health receipt: supervisor missing")
    let healthPath = DepinInferenceTransportResidencySettlementDaemonHealthReceiptPathFromPrefix(Value(prefixRes))
    var draft = DepinInferenceTransportResidencySettlementDaemonHealthReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonHealthReceiptSchema,
        path: healthPath,
        startupBundlePath: startupBundlePath,
        configHash: startupBundle.configHash,
        daemonIdHash: startupBundle.daemonIdHash,
        eventStreamHash: startupBundle.eventStreamHash,
        enginePlanHash: startupBundle.enginePlanHash,
        peerSetHash: startupBundle.peerSetHash,
        baseStoreHash: startupBundle.baseStoreHash,
        startupBundleReceiptHash: startupBundle.receiptHash,
        startupBundleByteHash: startupByteHash,
        kvHeadByteHash: headByteHash,
        repairDaemonByteHash: repairByteHash,
        supervisorByteHash: supervisorByteHash,
        processPid: processPid,
        checkedAtNs: checkedAtNs,
        healthy: true,
        healthHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteResidencySettlementDaemonHealthReceiptFile(healthPath, draft)

fn DepinInferenceTransportResidencySettlementDaemonEventHash(event: DepinInferenceTransportResidencySettlementDaemonEvent): int64 =
    var h: int64 = int64(337)
    h = engine.DistributedHashTextWith(h, event.schema)
    h = engine.DistributedHashTextWith(h, event.eventStreamId)
    h = engine.DistributedHashTextWith(h, event.eventKind)
    h = engine.DistributedHashTextWith(h, event.sourcePath)
    h = engine.DistributedHashStep(h, event.eventSeq)
    h = engine.DistributedHashStep(h, event.dueAtNs)
    return h

fn DepinInferenceTransportBuildResidencySettlementDaemonEvent(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                              eventKind: str,
                                                              sourcePath: str,
                                                              eventSeq: int64,
                                                              dueAtNs: int64): DepinInferenceTransportResidencySettlementDaemonEvent =
    var event = DepinInferenceTransportResidencySettlementDaemonEvent(
        schema: DepinInferenceTransportResidencySettlementDaemonEventSchema,
        eventStreamId: config.eventStreamId,
        eventKind: eventKind,
        sourcePath: sourcePath,
        eventSeq: eventSeq,
        dueAtNs: dueAtNs,
        eventHash: int64(0)
    )
    event.eventHash = DepinInferenceTransportResidencySettlementDaemonEventHash(event)
    return event

fn depinInferenceTransportResidencySettlementDaemonExpectedEventSourcePath(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                          eventKind: str): Result[str] =
    if eventKind == DepinInferenceTransportResidencySettlementDaemonEventStart:
        return Ok[str](config.residencyPathPrefix)
    if eventKind == DepinInferenceTransportResidencySettlementDaemonEventKvHeadUpdated:
        return Ok[str](strutil.Join([config.residencyPathPrefix, ".ckvh1"], ""))
    if eventKind == DepinInferenceTransportResidencySettlementDaemonEventRepairDaemonUpdated:
        return Ok[str](DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(config.residencyPathPrefix))
    if eventKind == DepinInferenceTransportResidencySettlementDaemonEventSupervisorDue:
        return Ok[str](config.supervisorStatePath)
    if eventKind == DepinInferenceTransportResidencySettlementDaemonEventStop:
        return Ok[str](config.daemonRunReceiptPath)
    return Err[str]("depin residency settlement daemon event: kind")

fn DepinInferenceTransportValidateResidencySettlementDaemonEvent(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                 event: DepinInferenceTransportResidencySettlementDaemonEvent,
                                                                 expectedSeq: int64): Result[bool] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[bool](Error(configOk))
    if event.schema != DepinInferenceTransportResidencySettlementDaemonEventSchema ||
       event.eventStreamId != config.eventStreamId ||
       event.eventKind == "" ||
       event.sourcePath == "" ||
       event.eventSeq != expectedSeq ||
       event.dueAtNs <= int64(0) ||
       event.eventHash <= int64(0):
        return Err[bool]("depin residency settlement daemon event: fields")
    let expectedSource = depinInferenceTransportResidencySettlementDaemonExpectedEventSourcePath(config, event.eventKind)
    if IsErr(expectedSource):
        return Err[bool](Error(expectedSource))
    if event.sourcePath != Value(expectedSource):
        return Err[bool]("depin residency settlement daemon event: source")
    if DepinInferenceTransportResidencySettlementDaemonEventHash(event) != event.eventHash:
        return Err[bool]("depin residency settlement daemon event: hash")
    return Ok[bool](true)

fn depinInferenceTransportResidencySettlementDaemonTriggerKindFromHash(kindHash: int64): Result[str] =
    if kindHash == DepinSettlementTextHash(DepinInferenceTransportResidencySettlementDaemonEventKvHeadUpdated):
        return Ok[str](DepinInferenceTransportResidencySettlementDaemonEventKvHeadUpdated)
    if kindHash == DepinSettlementTextHash(DepinInferenceTransportResidencySettlementDaemonEventRepairDaemonUpdated):
        return Ok[str](DepinInferenceTransportResidencySettlementDaemonEventRepairDaemonUpdated)
    if kindHash == DepinSettlementTextHash(DepinInferenceTransportResidencySettlementDaemonEventSupervisorDue):
        return Ok[str](DepinInferenceTransportResidencySettlementDaemonEventSupervisorDue)
    return Err[str]("depin residency settlement daemon file event batch: trigger kind hash")

fn DepinInferenceTransportRebuildResidencySettlementDaemonEventsFromBatchReceipt(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                                 receipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt): Result[DepinInferenceTransportResidencySettlementDaemonEvent[]] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonEvent[]](Error(configOk))
    let receiptOk = DepinInferenceTransportValidateResidencySettlementDaemonFileEventBatchReceipt(receipt)
    if IsErr(receiptOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonEvent[]](Error(receiptOk))
    if receipt.path != DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(config.residencyPathPrefix) ||
       receipt.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
       receipt.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
       receipt.configHash != config.configHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonEvent[]]("depin residency settlement daemon file event batch: config binding")
    var events: DepinInferenceTransportResidencySettlementDaemonEvent[]
    if receipt.emittedEventCount == 0:
        return Ok[DepinInferenceTransportResidencySettlementDaemonEvent[]](events)
    if receipt.emittedEventCount != 3 || config.maxEvents < 3:
        return Err[DepinInferenceTransportResidencySettlementDaemonEvent[]]("depin residency settlement daemon file event batch: event count")
    let triggerKindRes = depinInferenceTransportResidencySettlementDaemonTriggerKindFromHash(receipt.triggerKindHash)
    if IsErr(triggerKindRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonEvent[]](Error(triggerKindRes))
    let triggerSourceRes = depinInferenceTransportResidencySettlementDaemonExpectedEventSourcePath(config, Value(triggerKindRes))
    if IsErr(triggerSourceRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonEvent[]](Error(triggerSourceRes))
    let startEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
        config,
        DepinInferenceTransportResidencySettlementDaemonEventStart,
        config.residencyPathPrefix,
        int64(0),
        receipt.observedAtNs
    )
    let triggerEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
        config,
        Value(triggerKindRes),
        Value(triggerSourceRes),
        int64(1),
        receipt.observedAtNs
    )
    let stopEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
        config,
        DepinInferenceTransportResidencySettlementDaemonEventStop,
        config.daemonRunReceiptPath,
        int64(2),
        receipt.observedAtNs + int64(1)
    )
    events = [startEvent, triggerEvent, stopEvent]
    if startEvent.eventHash != receipt.firstEventHash ||
       triggerEvent.eventHash != receipt.triggerEventHash ||
       stopEvent.eventHash != receipt.lastEventHash ||
       DepinInferenceTransportResidencySettlementDaemonEventSetHash(events) != receipt.eventSetHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonEvent[]]("depin residency settlement daemon file event batch: event replay")
    return Ok[DepinInferenceTransportResidencySettlementDaemonEvent[]](events)

fn depinInferenceTransportKvResidencyHeadDigestFromBytes(path: str,
                                                         bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportKvResidencyHeadDigest] =
    let headerBytes = engine.DistributedKvResidencyHeadFileHeaderWordCount * 8
    if path == "" || rawbytes.BytesLen(bytesRaw) < headerBytes:
        return Err[DepinInferenceTransportKvResidencyHeadDigest]("depin residency settlement daemon kv head digest: short header")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(engine.DistributedKvResidencyHeadFileMagic) ||
       version != int64(engine.DistributedKvResidencyHeadFileVersion):
        return Err[DepinInferenceTransportKvResidencyHeadDigest]("depin residency settlement daemon kv head digest: header")
    let enginePlanHash = engine.DistributedReadI64LE(bytesRaw, 16)
    let targetPeerHash = engine.DistributedReadI64LE(bytesRaw, 24)
    let baseStoreHash = engine.DistributedReadI64LE(bytesRaw, 32)
    let currentStoreHash = engine.DistributedReadI64LE(bytesRaw, 40)
    let commitSeqRaw = engine.DistributedReadI64LE(bytesRaw, 48)
    let previousCommitHash = engine.DistributedReadI64LE(bytesRaw, 56)
    let commitHash = engine.DistributedReadI64LE(bytesRaw, 64)
    let storeFileReceiptHash = engine.DistributedReadI64LE(bytesRaw, 72)
    let walFileReceiptHash = engine.DistributedReadI64LE(bytesRaw, 80)
    let walLogHash = engine.DistributedReadI64LE(bytesRaw, 88)
    let walRecordCountRaw = engine.DistributedReadI64LE(bytesRaw, 96)
    let committedAtNs = engine.DistributedReadI64LE(bytesRaw, 104)
    let updatedAtNs = engine.DistributedReadI64LE(bytesRaw, 112)
    let storePathLenRaw = engine.DistributedReadI64LE(bytesRaw, 120)
    let walPathLenRaw = engine.DistributedReadI64LE(bytesRaw, 128)
    let storePathHash = engine.DistributedReadI64LE(bytesRaw, 136)
    let walPathHash = engine.DistributedReadI64LE(bytesRaw, 144)
    let headHash = engine.DistributedReadI64LE(bytesRaw, 152)
    if enginePlanHash <= int64(0) ||
       targetPeerHash <= int64(0) ||
       baseStoreHash <= int64(0) ||
       currentStoreHash <= int64(0) ||
       commitSeqRaw < int64(0) ||
       previousCommitHash < int64(0) ||
       commitHash <= int64(0) ||
       storeFileReceiptHash <= int64(0) ||
       walFileReceiptHash <= int64(0) ||
       walLogHash <= int64(0) ||
       walRecordCountRaw < int64(0) ||
       committedAtNs <= int64(0) ||
       updatedAtNs <= int64(0) ||
       storePathLenRaw <= int64(0) ||
       walPathLenRaw <= int64(0) ||
       storePathLenRaw > int64(65536) ||
       walPathLenRaw > int64(65536) ||
       storePathHash <= int64(0) ||
       walPathHash <= int64(0) ||
       headHash <= int64(0):
        return Err[DepinInferenceTransportKvResidencyHeadDigest]("depin residency settlement daemon kv head digest: fields")
    let storePathLen = int32(storePathLenRaw)
    let walPathLen = int32(walPathLenRaw)
    let wantBytes = headerBytes + storePathLen + walPathLen
    if rawbytes.BytesLen(bytesRaw) != wantBytes:
        return Err[DepinInferenceTransportKvResidencyHeadDigest]("depin residency settlement daemon kv head digest: byte length")
    let storePathRes = engine.DistributedReadStringFromFileBytes(bytesRaw, headerBytes, storePathLen)
    if IsErr(storePathRes):
        return Err[DepinInferenceTransportKvResidencyHeadDigest](Error(storePathRes))
    let walPathRes = engine.DistributedReadStringFromFileBytes(bytesRaw, headerBytes + storePathLen, walPathLen)
    if IsErr(walPathRes):
        return Err[DepinInferenceTransportKvResidencyHeadDigest](Error(walPathRes))
    if engine.DistributedTransportFrameTextHash(Value(storePathRes)) != storePathHash ||
       engine.DistributedTransportFrameTextHash(Value(walPathRes)) != walPathHash ||
       Value(storePathRes) == Value(walPathRes):
        return Err[DepinInferenceTransportKvResidencyHeadDigest]("depin residency settlement daemon kv head digest: path hash")
    let digest = DepinInferenceTransportKvResidencyHeadDigest(
        path: path,
        enginePlanHash: enginePlanHash,
        targetPeerHash: targetPeerHash,
        baseStoreHash: baseStoreHash,
        currentStoreHash: currentStoreHash,
        commitSeq: int32(commitSeqRaw),
        previousCommitHash: previousCommitHash,
        commitHash: commitHash,
        storeFilePath: Value(storePathRes),
        walFilePath: Value(walPathRes),
        storeFileReceiptHash: storeFileReceiptHash,
        walFileReceiptHash: walFileReceiptHash,
        walLogHash: walLogHash,
        walRecordCount: int32(walRecordCountRaw),
        committedAtNs: committedAtNs,
        updatedAtNs: updatedAtNs,
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: engine.DistributedKvResidencyHeadFileByteHash(bytesRaw),
        headHash: headHash
    )
    return Ok[DepinInferenceTransportKvResidencyHeadDigest](digest)

fn depinInferenceTransportReadKvResidencyHeadDigestFile(path: str): Result[DepinInferenceTransportKvResidencyHeadDigest] =
    if path == "":
        return Err[DepinInferenceTransportKvResidencyHeadDigest]("depin residency settlement daemon kv head digest: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportKvResidencyHeadDigest](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let digest = depinInferenceTransportKvResidencyHeadDigestFromBytes(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return digest

fn depinInferenceTransportOsServiceSafeText(text: str): bool =
    if text == "":
        return false
    for i in 0..<strings.Len(text):
        let ch = text[i]
        if ch == '\n' ||
           ch == '\r' ||
           ch == '\t' ||
           ch == '"' ||
           ch == '\'' ||
           ch == '<' ||
           ch == '>' ||
           ch == '&':
            return false
    return true

fn depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(serviceKind: str): Result[int64] =
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd ||
       serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd:
        return Ok[int64](DepinSettlementTextHash(serviceKind))
    return Err[int64]("depin residency settlement daemon os service spec: kind")

fn depinInferenceTransportResidencySettlementDaemonOsServiceKindFromHash(serviceKindHash: int64): Result[str] =
    if serviceKindHash == DepinSettlementTextHash(DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd):
        return Ok[str](DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd)
    if serviceKindHash == DepinSettlementTextHash(DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd):
        return Ok[str](DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd)
    return Err[str]("depin residency settlement daemon os service spec: kind hash")

fn depinInferenceTransportResidencySettlementDaemonOsServicePrefixFromReceiptPath(receiptPath: str): Result[str] =
    if !strings.HasSuffix(receiptPath, ".csos1"):
        return Err[str]("depin residency settlement daemon os service spec: receipt suffix")
    let n = strings.Len(receiptPath)
    if n <= 6:
        return Err[str]("depin residency settlement daemon os service spec: receipt path")
    return Ok[str](strings.SliceBytes(receiptPath, 0, n - 6))

fn DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextHash(specText: str): int64 =
    return engine.DistributedHashTextWith(int64(365), specText)

fn DepinInferenceTransportResidencySettlementDaemonOsServiceSpecFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(367), bytesRaw)

fn DepinInferenceTransportBuildResidencySettlementDaemonOsServiceSpecText(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                          serviceKind: str,
                                                                          serviceName: str,
                                                                          executablePath: str,
                                                                          workingDirectory: str,
                                                                          startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt): Result[str] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[str](Error(configOk))
    let bundleOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startupBundle)
    if IsErr(bundleOk):
        return Err[str](Error(bundleOk))
    if startupBundle.configHash != config.configHash ||
       startupBundle.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
       startupBundle.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
       startupBundle.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix):
        return Err[str]("depin residency settlement daemon os service spec: startup bundle")
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(serviceKind)
    if IsErr(kindHash):
        return Err[str](Error(kindHash))
    if !depinInferenceTransportOsServiceSafeText(serviceName) ||
       !depinInferenceTransportOsServiceSafeText(executablePath) ||
       !depinInferenceTransportOsServiceSafeText(workingDirectory) ||
       !depinInferenceTransportOsServiceSafeText(config.daemonId) ||
       !depinInferenceTransportOsServiceSafeText(config.eventStreamId) ||
       !depinInferenceTransportOsServiceSafeText(config.residencyPathPrefix) ||
       !depinInferenceTransportOsServiceSafeText(config.supervisorStatePath) ||
       !depinInferenceTransportOsServiceSafeText(config.daemonRunReceiptPath) ||
       !depinInferenceTransportOsServiceSafeText(startupBundle.path):
        return Err[str]("depin residency settlement daemon os service spec: unsafe text")
    if !os.FileExists(executablePath):
        return Err[str]("depin residency settlement daemon os service spec: executable")
    if !os.DirExists(workingDirectory):
        return Err[str]("depin residency settlement daemon os service spec: working directory")
    let watchPath = DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(config.residencyPathPrefix)
    let residencyHeadPath = strutil.Join([config.residencyPathPrefix, ".ckvh1"], "")
    let repairDaemonPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(config.residencyPathPrefix)
    let configHashText = strings.Int64ToStr(config.configHash)
    let intervalText = strings.Int64ToStr(config.intervalNs)
    let leaseText = strings.Int64ToStr(config.leaseNs)
    let maxEventsText = strings.IntToStr(config.maxEvents)
    let maxCyclesText = "8"
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd:
        return Ok[str](strutil.Join([
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n",
            "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n",
            "<plist version=\"1.0\">\n",
            "<dict>\n",
            "  <key>Label</key><string>", serviceName, "</string>\n",
            "  <key>ProgramArguments</key>\n",
            "  <array>\n",
            "    <string>", executablePath, "</string>\n",
            "    <string>depin-residency-settlement-daemon</string>\n",
            "    <string>--daemon-id</string><string>", config.daemonId, "</string>\n",
            "    <string>--event-stream-id</string><string>", config.eventStreamId, "</string>\n",
            "    <string>--residency-prefix</string><string>", config.residencyPathPrefix, "</string>\n",
            "    <string>--supervisor-state</string><string>", config.supervisorStatePath, "</string>\n",
            "    <string>--daemon-run-receipt</string><string>", config.daemonRunReceiptPath, "</string>\n",
            "    <string>--daemon-file-events</string><string>", watchPath, "</string>\n",
            "    <string>--daemon-startup-bundle</string><string>", startupBundle.path, "</string>\n",
            "    <string>--config-hash</string><string>", configHashText, "</string>\n",
            "    <string>--interval-ns</string><string>", intervalText, "</string>\n",
            "    <string>--lease-ns</string><string>", leaseText, "</string>\n",
            "    <string>--max-events</string><string>", maxEventsText, "</string>\n",
            "    <string>--run-until-idle</string>\n",
            "    <string>--max-cycles</string><string>", maxCyclesText, "</string>\n",
            "  </array>\n",
            "  <key>WorkingDirectory</key><string>", workingDirectory, "</string>\n",
            "  <key>RunAtLoad</key><true/>\n",
            "  <key>WatchPaths</key>\n",
            "  <array>\n",
            "    <string>", residencyHeadPath, "</string>\n",
            "    <string>", repairDaemonPath, "</string>\n",
            "    <string>", config.supervisorStatePath, "</string>\n",
            "  </array>\n",
            "</dict>\n",
            "</plist>\n"
        ], ""))
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd:
        return Ok[str](strutil.Join([
            "[Unit]\n",
            "Description=Cheng DePIN residency settlement daemon ", serviceName, "\n",
            "After=network-online.target\n",
            "Wants=network-online.target\n\n",
            "[Service]\n",
            "Type=oneshot\n",
            "WorkingDirectory=", workingDirectory, "\n",
            "ExecStart=", executablePath,
            " depin-residency-settlement-daemon",
            " --daemon-id ", config.daemonId,
            " --event-stream-id ", config.eventStreamId,
            " --residency-prefix ", config.residencyPathPrefix,
            " --supervisor-state ", config.supervisorStatePath,
            " --daemon-run-receipt ", config.daemonRunReceiptPath,
            " --daemon-file-events ", watchPath,
            " --daemon-startup-bundle ", startupBundle.path,
            " --config-hash ", configHashText,
            " --interval-ns ", intervalText,
            " --lease-ns ", leaseText,
            " --max-events ", maxEventsText,
            " --run-until-idle",
            " --max-cycles ", maxCyclesText, "\n",
            "NoNewPrivileges=true\n\n",
            "[Install]\n",
            "WantedBy=multi-user.target\n"
        ], ""))
    return Err[str]("depin residency settlement daemon os service spec: kind")

fn DepinInferenceTransportBuildResidencySettlementDaemonOsServiceTriggerSpecText(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                                 serviceKind: str,
                                                                                 serviceName: str,
                                                                                 startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt): Result[str] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[str](Error(configOk))
    let bundleOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startupBundle)
    if IsErr(bundleOk):
        return Err[str](Error(bundleOk))
    if startupBundle.configHash != config.configHash ||
       startupBundle.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
       startupBundle.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
       startupBundle.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix):
        return Err[str]("depin residency settlement daemon os service trigger spec: startup bundle")
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(serviceKind)
    if IsErr(kindHash):
        return Err[str](Error(kindHash))
    if !depinInferenceTransportOsServiceSafeText(serviceName) ||
       !depinInferenceTransportOsServiceSafeText(config.residencyPathPrefix) ||
       !depinInferenceTransportOsServiceSafeText(config.supervisorStatePath):
        return Err[str]("depin residency settlement daemon os service trigger spec: unsafe text")
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd:
        return Ok[str]("")
    if serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd:
        let residencyHeadPath = strutil.Join([config.residencyPathPrefix, ".ckvh1"], "")
        let repairDaemonPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(config.residencyPathPrefix)
        var serviceUnitName = serviceName
        if !strings.HasSuffix(serviceUnitName, ".service"):
            serviceUnitName = strutil.Join([serviceName, ".service"], "")
        return Ok[str](strutil.Join([
            "[Unit]\n",
            "Description=Cheng DePIN residency settlement daemon path trigger ", serviceName, "\n\n",
            "[Path]\n",
            "PathChanged=", residencyHeadPath, "\n",
            "PathChanged=", repairDaemonPath, "\n",
            "PathChanged=", config.supervisorStatePath, "\n",
            "Unit=", serviceUnitName, "\n\n",
            "[Install]\n",
            "WantedBy=multi-user.target\n"
        ], ""))
    return Err[str]("depin residency settlement daemon os service trigger spec: kind")

fn DepinInferenceTransportResidencySettlementDaemonOsServiceSpecHash(receipt: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt): int64 =
    var h: int64 = int64(369)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.configHash)
    h = engine.DistributedHashStep(h, receipt.daemonIdHash)
    h = engine.DistributedHashStep(h, receipt.eventStreamHash)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.baseStoreHash)
    h = engine.DistributedHashStep(h, receipt.serviceKindHash)
    h = engine.DistributedHashStep(h, receipt.serviceNameHash)
    h = engine.DistributedHashStep(h, receipt.executablePathHash)
    h = engine.DistributedHashStep(h, receipt.workingDirectoryHash)
    h = engine.DistributedHashStep(h, receipt.startupBundlePathHash)
    h = engine.DistributedHashStep(h, receipt.startupBundleReceiptHash)
    h = engine.DistributedHashStep(h, DepinSettlementTextHash(receipt.receiptPath))
    h = engine.DistributedHashStep(h, DepinSettlementTextHash(receipt.specPath))
    h = engine.DistributedHashStep(h, receipt.specTextHash)
    h = engine.DistributedHashStep(h, int64(receipt.specByteCount))
    h = engine.DistributedHashStep(h, receipt.specByteHash)
    if receipt.triggerSpecPath == "":
        h = engine.DistributedHashStep(h, int64(0))
    else:
        h = engine.DistributedHashStep(h, DepinSettlementTextHash(receipt.triggerSpecPath))
    h = engine.DistributedHashStep(h, receipt.triggerSpecTextHash)
    h = engine.DistributedHashStep(h, int64(receipt.triggerSpecByteCount))
    h = engine.DistributedHashStep(h, receipt.triggerSpecByteHash)
    h = engine.DistributedHashStep(h, receipt.createdAtNs)
    h = engine.DistributedHashStep(h, receipt.complete ? int64(1) : int64(0))
    return h

fn DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptHash(receipt: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt): int64 =
    var h: int64 = int64(371)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.receiptPath)
    h = engine.DistributedHashTextWith(h, receipt.specPath)
    h = engine.DistributedHashTextWith(h, receipt.triggerSpecPath)
    h = engine.DistributedHashStep(h, receipt.specHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(373), bytesRaw)

fn depinInferenceTransportResidencySettlementDaemonOsServiceSpecFileWord(receipt: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt,
                                                                         index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportResidencySettlementDaemonOsServiceSpecMagic)
    if index == 1:
        return int64(DepinInferenceTransportResidencySettlementDaemonOsServiceSpecVersion)
    if index == 2:
        return receipt.configHash
    if index == 3:
        return receipt.daemonIdHash
    if index == 4:
        return receipt.eventStreamHash
    if index == 5:
        return receipt.enginePlanHash
    if index == 6:
        return receipt.baseStoreHash
    if index == 7:
        return receipt.serviceKindHash
    if index == 8:
        return receipt.serviceNameHash
    if index == 9:
        return receipt.executablePathHash
    if index == 10:
        return receipt.workingDirectoryHash
    if index == 11:
        return receipt.startupBundlePathHash
    if index == 12:
        return receipt.startupBundleReceiptHash
    if index == 13:
        return DepinSettlementTextHash(receipt.receiptPath)
    if index == 14:
        return DepinSettlementTextHash(receipt.specPath)
    if index == 15:
        return receipt.specTextHash
    if index == 16:
        return int64(receipt.specByteCount)
    if index == 17:
        return receipt.specByteHash
    if index == 18:
        if receipt.triggerSpecPath == "":
            return int64(0)
        return DepinSettlementTextHash(receipt.triggerSpecPath)
    if index == 19:
        return receipt.triggerSpecTextHash
    if index == 20:
        return int64(receipt.triggerSpecByteCount)
    if index == 21:
        return receipt.triggerSpecByteHash
    if index == 22:
        return receipt.createdAtNs
    if index == 23:
        return receipt.complete ? int64(1) : int64(0)
    if index == 24:
        return receipt.specHash
    return int64(-1)

fn depinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptFileBytes(receipt: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt): Result[rawbytes.Bytes] =
    if receipt.specHash <= int64(0):
        return Err[rawbytes.Bytes]("depin residency settlement daemon os service spec: spec hash")
    let byteCount = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin residency settlement daemon os service spec: allocation")
    for i in 0..<DepinInferenceTransportResidencySettlementDaemonOsServiceSpecWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportResidencySettlementDaemonOsServiceSpecFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptBuild(path: str,
                                                                             bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportResidencySettlementDaemonOsServiceSpecWordCount * 8:
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportResidencySettlementDaemonOsServiceSpecMagic) ||
       version != int64(DepinInferenceTransportResidencySettlementDaemonOsServiceSpecVersion):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: header")
    let kindHash = engine.DistributedReadI64LE(bytesRaw, 56)
    let kindRes = depinInferenceTransportResidencySettlementDaemonOsServiceKindFromHash(kindHash)
    if IsErr(kindRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(kindRes))
    let prefixRes = depinInferenceTransportResidencySettlementDaemonOsServicePrefixFromReceiptPath(path)
    if IsErr(prefixRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(prefixRes))
    let specPathRes = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextPathFromPrefix(Value(prefixRes), Value(kindRes))
    if IsErr(specPathRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(specPathRes))
    let triggerSpecPathRes = DepinInferenceTransportResidencySettlementDaemonOsServiceTriggerSpecTextPathFromPrefix(Value(prefixRes), Value(kindRes))
    if IsErr(triggerSpecPathRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(triggerSpecPathRes))
    let startupBundlePath = DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(Value(prefixRes))
    let specByteCountRaw = engine.DistributedReadI64LE(bytesRaw, 128)
    let triggerSpecByteCountRaw = engine.DistributedReadI64LE(bytesRaw, 160)
    let completeRaw = engine.DistributedReadI64LE(bytesRaw, 184)
    if specByteCountRaw <= int64(0) ||
       specByteCountRaw > int64(2147483647) ||
       triggerSpecByteCountRaw < int64(0) ||
       triggerSpecByteCountRaw > int64(2147483647) ||
       (completeRaw != int64(0) && completeRaw != int64(1)):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: ranges")
    var receipt = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecSchema,
        receiptPath: path,
        specPath: Value(specPathRes),
        triggerSpecPath: Value(triggerSpecPathRes),
        serviceKind: Value(kindRes),
        serviceName: "",
        executablePath: "",
        workingDirectory: "",
        startupBundlePath: startupBundlePath,
        configHash: engine.DistributedReadI64LE(bytesRaw, 16),
        daemonIdHash: engine.DistributedReadI64LE(bytesRaw, 24),
        eventStreamHash: engine.DistributedReadI64LE(bytesRaw, 32),
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 40),
        baseStoreHash: engine.DistributedReadI64LE(bytesRaw, 48),
        serviceKindHash: kindHash,
        serviceNameHash: engine.DistributedReadI64LE(bytesRaw, 64),
        executablePathHash: engine.DistributedReadI64LE(bytesRaw, 72),
        workingDirectoryHash: engine.DistributedReadI64LE(bytesRaw, 80),
        startupBundlePathHash: engine.DistributedReadI64LE(bytesRaw, 88),
        startupBundleReceiptHash: engine.DistributedReadI64LE(bytesRaw, 96),
        specTextHash: engine.DistributedReadI64LE(bytesRaw, 120),
        specByteCount: int32(specByteCountRaw),
        specByteHash: engine.DistributedReadI64LE(bytesRaw, 136),
        triggerSpecTextHash: engine.DistributedReadI64LE(bytesRaw, 152),
        triggerSpecByteCount: int32(triggerSpecByteCountRaw),
        triggerSpecByteHash: engine.DistributedReadI64LE(bytesRaw, 168),
        createdAtNs: engine.DistributedReadI64LE(bytesRaw, 176),
        complete: completeRaw == int64(1),
        specHash: engine.DistributedReadI64LE(bytesRaw, 192),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    var expectedTriggerSpecPathHash: int64
    if receipt.triggerSpecPath != "":
        expectedTriggerSpecPathHash = DepinSettlementTextHash(receipt.triggerSpecPath)
    if DepinSettlementTextHash(receipt.startupBundlePath) != receipt.startupBundlePathHash ||
       DepinSettlementTextHash(path) != engine.DistributedReadI64LE(bytesRaw, 104) ||
       DepinSettlementTextHash(receipt.specPath) != engine.DistributedReadI64LE(bytesRaw, 112) ||
       expectedTriggerSpecPathHash != engine.DistributedReadI64LE(bytesRaw, 144):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: path hash")
    if DepinInferenceTransportResidencySettlementDaemonOsServiceSpecHash(receipt) != receipt.specHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: hash")
    receipt.receiptHash = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptHash(receipt)
    return Ok[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](receipt)

fn DepinInferenceTransportValidateResidencySettlementDaemonOsServiceSpecReceipt(receipt: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportResidencySettlementDaemonOsServiceSpecSchema ||
       receipt.receiptPath == "" ||
       receipt.specPath == "" ||
       receipt.startupBundlePath == "" ||
       receipt.configHash <= int64(0) ||
       receipt.daemonIdHash <= int64(0) ||
       receipt.eventStreamHash <= int64(0) ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.baseStoreHash <= int64(0) ||
       receipt.serviceKindHash <= int64(0) ||
       receipt.serviceNameHash <= int64(0) ||
       receipt.executablePathHash <= int64(0) ||
       receipt.workingDirectoryHash <= int64(0) ||
       receipt.startupBundlePathHash <= int64(0) ||
       receipt.startupBundleReceiptHash <= int64(0) ||
       receipt.specTextHash <= int64(0) ||
       receipt.specByteCount <= 0 ||
       receipt.specByteHash <= int64(0) ||
       receipt.createdAtNs <= int64(0) ||
       !receipt.complete ||
       receipt.specHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportResidencySettlementDaemonOsServiceSpecWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin residency settlement daemon os service spec receipt: fields")
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(receipt.serviceKind)
    if IsErr(kindHash):
        return Err[bool](Error(kindHash))
    if Value(kindHash) != receipt.serviceKindHash:
        return Err[bool]("depin residency settlement daemon os service spec receipt: kind")
    if DepinSettlementTextHash(receipt.startupBundlePath) != receipt.startupBundlePathHash:
        return Err[bool]("depin residency settlement daemon os service spec receipt: startup path")
    let prefixRes = depinInferenceTransportResidencySettlementDaemonOsServicePrefixFromReceiptPath(receipt.receiptPath)
    if IsErr(prefixRes):
        return Err[bool](Error(prefixRes))
    let expectedSpecPath = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextPathFromPrefix(Value(prefixRes), receipt.serviceKind)
    if IsErr(expectedSpecPath):
        return Err[bool](Error(expectedSpecPath))
    let expectedTriggerSpecPath = DepinInferenceTransportResidencySettlementDaemonOsServiceTriggerSpecTextPathFromPrefix(Value(prefixRes), receipt.serviceKind)
    if IsErr(expectedTriggerSpecPath):
        return Err[bool](Error(expectedTriggerSpecPath))
    if receipt.specPath != Value(expectedSpecPath) ||
       receipt.triggerSpecPath != Value(expectedTriggerSpecPath):
        return Err[bool]("depin residency settlement daemon os service spec receipt: paths")
    let startupBundleRead = DepinInferenceTransportReadResidencySettlementDaemonStartupBundleReceiptFile(receipt.startupBundlePath)
    if IsErr(startupBundleRead):
        return Err[bool](Error(startupBundleRead))
    let startupBundleOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(Value(startupBundleRead))
    if IsErr(startupBundleOk):
        return Err[bool](Error(startupBundleOk))
    if Value(startupBundleRead).receiptHash != receipt.startupBundleReceiptHash ||
       Value(startupBundleRead).configHash != receipt.configHash ||
       Value(startupBundleRead).daemonIdHash != receipt.daemonIdHash ||
       Value(startupBundleRead).eventStreamHash != receipt.eventStreamHash ||
       Value(startupBundleRead).enginePlanHash != receipt.enginePlanHash ||
       Value(startupBundleRead).baseStoreHash != receipt.baseStoreHash:
        return Err[bool]("depin residency settlement daemon os service spec receipt: startup bundle")
    if DepinInferenceTransportResidencySettlementDaemonOsServiceSpecHash(receipt) != receipt.specHash:
        return Err[bool]("depin residency settlement daemon os service spec receipt: spec hash")
    if DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon os service spec receipt: receipt hash")
    let specRead = os.ReadFileBytesResult(receipt.specPath)
    if IsErr(specRead):
        return Err[bool](Error(specRead))
    var specBytes = Value(specRead)
    let specText = rawbytes.BytesToString(specBytes)
    let specByteHash = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecFileByteHash(specBytes)
    if rawbytes.BytesLen(specBytes) != receipt.specByteCount ||
       specByteHash != receipt.specByteHash ||
       DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextHash(specText) != receipt.specTextHash:
        rawbytes.BytesFree(specBytes)
        return Err[bool]("depin residency settlement daemon os service spec receipt: spec readback")
    if !strutil.Contains(specText, "--run-until-idle") ||
       !strutil.Contains(specText, "--max-cycles"):
        rawbytes.BytesFree(specBytes)
        return Err[bool]("depin residency settlement daemon os service spec receipt: daemon mode")
    if receipt.serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceLaunchd:
        if !strutil.Contains(specText, "<key>WatchPaths</key>") ||
           strutil.Contains(specText, "<key>KeepAlive</key>") ||
           receipt.triggerSpecPath != "" ||
           receipt.triggerSpecTextHash != int64(0) ||
           receipt.triggerSpecByteCount != 0 ||
           receipt.triggerSpecByteHash != int64(0):
            rawbytes.BytesFree(specBytes)
            return Err[bool]("depin residency settlement daemon os service spec receipt: launchd watch")
    elif receipt.serviceKind == DepinInferenceTransportResidencySettlementDaemonOsServiceSystemd:
        if !strutil.Contains(specText, "Type=oneshot") ||
           strutil.Contains(specText, "Restart=always") ||
           receipt.triggerSpecPath == "" ||
           receipt.triggerSpecTextHash <= int64(0) ||
           receipt.triggerSpecByteCount <= 0 ||
           receipt.triggerSpecByteHash <= int64(0):
            rawbytes.BytesFree(specBytes)
            return Err[bool]("depin residency settlement daemon os service spec receipt: systemd trigger")
        let triggerRead = os.ReadFileBytesResult(receipt.triggerSpecPath)
        if IsErr(triggerRead):
            rawbytes.BytesFree(specBytes)
            return Err[bool](Error(triggerRead))
        var triggerBytes = Value(triggerRead)
        let triggerText = rawbytes.BytesToString(triggerBytes)
        let triggerByteHash = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecFileByteHash(triggerBytes)
        if rawbytes.BytesLen(triggerBytes) != receipt.triggerSpecByteCount ||
           triggerByteHash != receipt.triggerSpecByteHash ||
           DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextHash(triggerText) != receipt.triggerSpecTextHash:
            rawbytes.BytesFree(specBytes)
            rawbytes.BytesFree(triggerBytes)
            return Err[bool]("depin residency settlement daemon os service spec receipt: trigger readback")
        if !strutil.Contains(triggerText, "[Path]") ||
           !strutil.Contains(triggerText, "PathChanged=") ||
           !strutil.Contains(triggerText, ".ckvh1") ||
           !strutil.Contains(triggerText, ".csrd1") ||
           !strutil.Contains(triggerText, ".cssv1") ||
           !strutil.Contains(triggerText, "Unit=") ||
           !strutil.Contains(triggerText, ".service"):
            rawbytes.BytesFree(specBytes)
            rawbytes.BytesFree(triggerBytes)
            return Err[bool]("depin residency settlement daemon os service spec receipt: trigger text")
        rawbytes.BytesFree(triggerBytes)
    else:
        rawbytes.BytesFree(specBytes)
        return Err[bool]("depin residency settlement daemon os service spec receipt: kind")
    rawbytes.BytesFree(specBytes)
    let readRes = DepinInferenceTransportReadResidencySettlementDaemonOsServiceSpecReceiptFile(receipt.receiptPath)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).specHash != receipt.specHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon os service spec receipt: readback")
    return Ok[bool](true)

fn DepinInferenceTransportReadResidencySettlementDaemonOsServiceSpecReceiptFile(path: str): Result[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportWriteResidencySettlementDaemonOsServiceSpecReceiptFile(path: str,
                                                                                 draft: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt): Result[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecSchema
    receipt.receiptPath = path
    receipt.byteCount = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.specHash = int64(0)
    receipt.specHash = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecHash(receipt)
    let bytesRes = depinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptFileByteHash(readBytes) != DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: readback")
    let receiptRes = depinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateResidencySettlementDaemonOsServiceSpecReceipt(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportWriteResidencySettlementDaemonOsServiceSpec(plan: engine.DistributedInferencePlan,
                                                                      baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                                      config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                      startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                      serviceKind: str,
                                                                      serviceName: str,
                                                                      executablePath: str,
                                                                      workingDirectory: str,
                                                                      createdAtNs: int64): Result[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(configOk))
    if baseKvResidencyStore.storeHash <= int64(0) ||
       createdAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: args")
    let kindHash = depinInferenceTransportResidencySettlementDaemonOsServiceKindHash(serviceKind)
    if IsErr(kindHash):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(kindHash))
    let bundleOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startupBundle)
    if IsErr(bundleOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(bundleOk))
    if startupBundle.configHash != config.configHash ||
       startupBundle.enginePlanHash != plan.engineHash ||
       startupBundle.baseStoreHash != baseKvResidencyStore.storeHash ||
       startupBundle.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: startup bundle")
    let specTextRes = DepinInferenceTransportBuildResidencySettlementDaemonOsServiceSpecText(config, serviceKind, serviceName, executablePath, workingDirectory, startupBundle)
    if IsErr(specTextRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(specTextRes))
    let receiptPath = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptPathFromPrefix(config.residencyPathPrefix)
    let specPathRes = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextPathFromPrefix(config.residencyPathPrefix, serviceKind)
    if IsErr(specPathRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(specPathRes))
    let specText = Value(specTextRes)
    let specPath = Value(specPathRes)
    let writeSpec = os.WriteFileResult(specPath, specText)
    if IsErr(writeSpec):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(writeSpec))
    let specRead = os.ReadFileBytesResult(specPath)
    if IsErr(specRead):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(specRead))
    var specBytes = Value(specRead)
    let readText = rawbytes.BytesToString(specBytes)
    if readText != specText:
        rawbytes.BytesFree(specBytes)
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: text readback")
    let specByteHash = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecFileByteHash(specBytes)
    let specByteCount = rawbytes.BytesLen(specBytes)
    rawbytes.BytesFree(specBytes)
    let triggerSpecPathRes = DepinInferenceTransportResidencySettlementDaemonOsServiceTriggerSpecTextPathFromPrefix(config.residencyPathPrefix, serviceKind)
    if IsErr(triggerSpecPathRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(triggerSpecPathRes))
    let triggerSpecTextRes = DepinInferenceTransportBuildResidencySettlementDaemonOsServiceTriggerSpecText(config, serviceKind, serviceName, startupBundle)
    if IsErr(triggerSpecTextRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(triggerSpecTextRes))
    let triggerSpecPath = Value(triggerSpecPathRes)
    let triggerSpecText = Value(triggerSpecTextRes)
    var triggerSpecTextHash: int64
    var triggerSpecByteCount: int32
    var triggerSpecByteHash: int64
    if triggerSpecText == "":
        if triggerSpecPath != "":
            return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: trigger path")
    else:
        if triggerSpecPath == "":
            return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: trigger path")
        let writeTriggerSpec = os.WriteFileResult(triggerSpecPath, triggerSpecText)
        if IsErr(writeTriggerSpec):
            return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(writeTriggerSpec))
        let triggerRead = os.ReadFileBytesResult(triggerSpecPath)
        if IsErr(triggerRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt](Error(triggerRead))
        var triggerBytes = Value(triggerRead)
        let triggerReadText = rawbytes.BytesToString(triggerBytes)
        if triggerReadText != triggerSpecText:
            rawbytes.BytesFree(triggerBytes)
            return Err[DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt]("depin residency settlement daemon os service spec: trigger text readback")
        triggerSpecTextHash = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextHash(triggerSpecText)
        triggerSpecByteCount = rawbytes.BytesLen(triggerBytes)
        triggerSpecByteHash = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecFileByteHash(triggerBytes)
        rawbytes.BytesFree(triggerBytes)
    var draft = DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecSchema,
        receiptPath: receiptPath,
        specPath: specPath,
        triggerSpecPath: triggerSpecPath,
        serviceKind: serviceKind,
        serviceName: serviceName,
        executablePath: executablePath,
        workingDirectory: workingDirectory,
        startupBundlePath: startupBundle.path,
        configHash: config.configHash,
        daemonIdHash: DepinSettlementTextHash(config.daemonId),
        eventStreamHash: DepinSettlementTextHash(config.eventStreamId),
        enginePlanHash: plan.engineHash,
        baseStoreHash: baseKvResidencyStore.storeHash,
        serviceKindHash: Value(kindHash),
        serviceNameHash: DepinSettlementTextHash(serviceName),
        executablePathHash: DepinSettlementTextHash(executablePath),
        workingDirectoryHash: DepinSettlementTextHash(workingDirectory),
        startupBundlePathHash: DepinSettlementTextHash(startupBundle.path),
        startupBundleReceiptHash: startupBundle.receiptHash,
        specTextHash: DepinInferenceTransportResidencySettlementDaemonOsServiceSpecTextHash(specText),
        specByteCount: specByteCount,
        specByteHash: specByteHash,
        triggerSpecTextHash: triggerSpecTextHash,
        triggerSpecByteCount: triggerSpecByteCount,
        triggerSpecByteHash: triggerSpecByteHash,
        createdAtNs: createdAtNs,
        complete: true,
        specHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteResidencySettlementDaemonOsServiceSpecReceiptFile(receiptPath, draft)

fn DepinInferenceTransportResidencySettlementDaemonEventSetHash(events: DepinInferenceTransportResidencySettlementDaemonEvent[]): int64 =
    var h: int64 = int64(357)
    h = engine.DistributedHashStep(h, int64(events.len))
    for i in 0..<events.len:
        h = engine.DistributedHashStep(h, events[i].eventHash)
    return h

fn DepinInferenceTransportResidencySettlementDaemonFileEventBatchHash(receipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt): int64 =
    var h: int64 = int64(359)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.daemonIdHash)
    h = engine.DistributedHashStep(h, receipt.eventStreamHash)
    h = engine.DistributedHashStep(h, receipt.configHash)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.baseStoreHash)
    h = engine.DistributedHashStep(h, receipt.previousBatchReceiptHash)
    h = engine.DistributedHashStep(h, receipt.batchSeq)
    h = engine.DistributedHashStep(h, receipt.observedAtNs)
    h = engine.DistributedHashStep(h, receipt.triggerKindHash)
    h = engine.DistributedHashStep(h, receipt.triggerEventHash)
    h = engine.DistributedHashStep(h, int64(receipt.emittedEventCount))
    h = engine.DistributedHashStep(h, receipt.eventSetHash)
    h = engine.DistributedHashStep(h, receipt.firstEventHash)
    h = engine.DistributedHashStep(h, receipt.lastEventHash)
    h = engine.DistributedHashStep(h, receipt.kvHeadHash)
    h = engine.DistributedHashStep(h, receipt.kvHeadByteHash)
    h = engine.DistributedHashStep(h, receipt.kvTargetPeerHash)
    h = engine.DistributedHashStep(h, receipt.repairDaemonStateHash)
    h = engine.DistributedHashStep(h, receipt.repairDaemonByteHash)
    h = engine.DistributedHashStep(h, receipt.supervisorStateHash)
    h = engine.DistributedHashStep(h, receipt.supervisorByteHash)
    h = engine.DistributedHashStep(h, receipt.previousRunReceiptHash)
    h = engine.DistributedHashStep(h, receipt.previousSupervisorNextEligibleAtNs)
    h = engine.DistributedHashStep(h, receipt.previousSupervisorLeaseUntilNs)
    h = engine.DistributedHashStep(h, receipt.complete ? int64(1) : int64(0))
    return h

fn DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceiptHash(receipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt): int64 =
    var h: int64 = int64(361)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashStep(h, receipt.batchHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn DepinInferenceTransportResidencySettlementDaemonFileEventBatchFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(363), bytesRaw)

fn depinInferenceTransportResidencySettlementDaemonFileEventBatchFileWord(receipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt,
                                                                         index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportResidencySettlementDaemonFileEventBatchMagic)
    if index == 1:
        return int64(DepinInferenceTransportResidencySettlementDaemonFileEventBatchVersion)
    if index == 2:
        return receipt.daemonIdHash
    if index == 3:
        return receipt.eventStreamHash
    if index == 4:
        return receipt.configHash
    if index == 5:
        return receipt.enginePlanHash
    if index == 6:
        return receipt.baseStoreHash
    if index == 7:
        return receipt.previousBatchReceiptHash
    if index == 8:
        return receipt.batchSeq
    if index == 9:
        return receipt.observedAtNs
    if index == 10:
        return receipt.triggerKindHash
    if index == 11:
        return receipt.triggerEventHash
    if index == 12:
        return int64(receipt.emittedEventCount)
    if index == 13:
        return receipt.eventSetHash
    if index == 14:
        return receipt.firstEventHash
    if index == 15:
        return receipt.lastEventHash
    if index == 16:
        return receipt.kvHeadHash
    if index == 17:
        return receipt.kvHeadByteHash
    if index == 18:
        return receipt.kvTargetPeerHash
    if index == 19:
        return receipt.repairDaemonStateHash
    if index == 20:
        return receipt.repairDaemonByteHash
    if index == 21:
        return receipt.supervisorStateHash
    if index == 22:
        return receipt.supervisorByteHash
    if index == 23:
        return receipt.previousRunReceiptHash
    if index == 24:
        return receipt.previousSupervisorNextEligibleAtNs
    if index == 25:
        return receipt.previousSupervisorLeaseUntilNs
    if index == 26:
        return receipt.complete ? int64(1) : int64(0)
    if index == 27:
        return receipt.batchHash
    return int64(-1)

fn depinInferenceTransportResidencySettlementDaemonFileEventBatchFileBytes(receipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt): Result[rawbytes.Bytes] =
    if receipt.batchHash <= int64(0):
        return Err[rawbytes.Bytes]("depin residency settlement daemon file event batch: batch hash")
    let byteCount = DepinInferenceTransportResidencySettlementDaemonFileEventBatchWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin residency settlement daemon file event batch: allocation")
    for i in 0..<DepinInferenceTransportResidencySettlementDaemonFileEventBatchWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportResidencySettlementDaemonFileEventBatchFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportResidencySettlementDaemonFileEventBatchReceiptBuild(path: str,
                                                                              bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt]("depin residency settlement daemon file event batch: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportResidencySettlementDaemonFileEventBatchWordCount * 8:
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt]("depin residency settlement daemon file event batch: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportResidencySettlementDaemonFileEventBatchMagic) ||
       version != int64(DepinInferenceTransportResidencySettlementDaemonFileEventBatchVersion):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt]("depin residency settlement daemon file event batch: header")
    let batchSeqRaw = engine.DistributedReadI64LE(bytesRaw, 64)
    let emittedEventCountRaw = engine.DistributedReadI64LE(bytesRaw, 96)
    let completeRaw = engine.DistributedReadI64LE(bytesRaw, 208)
    if batchSeqRaw < int64(0) ||
       (emittedEventCountRaw != int64(0) && emittedEventCountRaw != int64(3)) ||
       (completeRaw != int64(0) && completeRaw != int64(1)):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt]("depin residency settlement daemon file event batch: ranges")
    var receipt = DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonFileEventBatchSchema,
        path: path,
        daemonIdHash: engine.DistributedReadI64LE(bytesRaw, 16),
        eventStreamHash: engine.DistributedReadI64LE(bytesRaw, 24),
        configHash: engine.DistributedReadI64LE(bytesRaw, 32),
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 40),
        baseStoreHash: engine.DistributedReadI64LE(bytesRaw, 48),
        previousBatchReceiptHash: engine.DistributedReadI64LE(bytesRaw, 56),
        batchSeq: batchSeqRaw,
        observedAtNs: engine.DistributedReadI64LE(bytesRaw, 72),
        triggerKindHash: engine.DistributedReadI64LE(bytesRaw, 80),
        triggerEventHash: engine.DistributedReadI64LE(bytesRaw, 88),
        emittedEventCount: int32(emittedEventCountRaw),
        eventSetHash: engine.DistributedReadI64LE(bytesRaw, 104),
        firstEventHash: engine.DistributedReadI64LE(bytesRaw, 112),
        lastEventHash: engine.DistributedReadI64LE(bytesRaw, 120),
        kvHeadHash: engine.DistributedReadI64LE(bytesRaw, 128),
        kvHeadByteHash: engine.DistributedReadI64LE(bytesRaw, 136),
        kvTargetPeerHash: engine.DistributedReadI64LE(bytesRaw, 144),
        repairDaemonStateHash: engine.DistributedReadI64LE(bytesRaw, 152),
        repairDaemonByteHash: engine.DistributedReadI64LE(bytesRaw, 160),
        supervisorStateHash: engine.DistributedReadI64LE(bytesRaw, 168),
        supervisorByteHash: engine.DistributedReadI64LE(bytesRaw, 176),
        previousRunReceiptHash: engine.DistributedReadI64LE(bytesRaw, 184),
        previousSupervisorNextEligibleAtNs: engine.DistributedReadI64LE(bytesRaw, 192),
        previousSupervisorLeaseUntilNs: engine.DistributedReadI64LE(bytesRaw, 200),
        complete: completeRaw == int64(1),
        batchHash: engine.DistributedReadI64LE(bytesRaw, 216),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportResidencySettlementDaemonFileEventBatchFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinInferenceTransportResidencySettlementDaemonFileEventBatchHash(receipt) != receipt.batchHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt]("depin residency settlement daemon file event batch: batch hash")
    receipt.receiptHash = DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceiptHash(receipt)
    return Ok[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt](receipt)

fn DepinInferenceTransportWriteResidencySettlementDaemonFileEventBatchReceiptFile(path: str,
                                                                                  draft: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt): Result[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt]("depin residency settlement daemon file event batch: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportResidencySettlementDaemonFileEventBatchSchema
    receipt.path = path
    receipt.byteCount = DepinInferenceTransportResidencySettlementDaemonFileEventBatchWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.batchHash = int64(0)
    receipt.batchHash = DepinInferenceTransportResidencySettlementDaemonFileEventBatchHash(receipt)
    let bytesRes = depinInferenceTransportResidencySettlementDaemonFileEventBatchFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportResidencySettlementDaemonFileEventBatchFileByteHash(readBytes) != DepinInferenceTransportResidencySettlementDaemonFileEventBatchFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt]("depin residency settlement daemon file event batch: readback")
    let receiptRes = depinInferenceTransportResidencySettlementDaemonFileEventBatchReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateResidencySettlementDaemonFileEventBatchReceipt(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportReadResidencySettlementDaemonFileEventBatchReceiptFile(path: str): Result[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt]("depin residency settlement daemon file event batch: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportResidencySettlementDaemonFileEventBatchReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateResidencySettlementDaemonFileEventBatchReceipt(receipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportResidencySettlementDaemonFileEventBatchSchema ||
       receipt.path == "" ||
       receipt.daemonIdHash <= int64(0) ||
       receipt.eventStreamHash <= int64(0) ||
       receipt.configHash <= int64(0) ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.baseStoreHash <= int64(0) ||
       receipt.batchSeq < int64(0) ||
       receipt.observedAtNs <= int64(0) ||
       (receipt.emittedEventCount != 0 && receipt.emittedEventCount != 3) ||
       receipt.eventSetHash <= int64(0) ||
       receipt.kvHeadHash <= int64(0) ||
       receipt.kvHeadByteHash <= int64(0) ||
       receipt.kvTargetPeerHash <= int64(0) ||
       receipt.repairDaemonStateHash <= int64(0) ||
       receipt.repairDaemonByteHash <= int64(0) ||
       receipt.previousRunReceiptHash < int64(0) ||
       receipt.previousSupervisorNextEligibleAtNs < int64(0) ||
       receipt.previousSupervisorLeaseUntilNs < int64(0) ||
       !receipt.complete ||
       receipt.batchHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportResidencySettlementDaemonFileEventBatchWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin residency settlement daemon file event batch receipt: fields")
    if receipt.batchSeq == int64(0) && receipt.previousBatchReceiptHash != int64(0):
        return Err[bool]("depin residency settlement daemon file event batch receipt: initial predecessor")
    if receipt.batchSeq > int64(0) && receipt.previousBatchReceiptHash <= int64(0):
        return Err[bool]("depin residency settlement daemon file event batch receipt: predecessor")
    if receipt.emittedEventCount == 0:
        if receipt.triggerKindHash != int64(0) ||
           receipt.triggerEventHash != int64(0) ||
           receipt.firstEventHash != int64(0) ||
           receipt.lastEventHash != int64(0):
            return Err[bool]("depin residency settlement daemon file event batch receipt: empty events")
        var expectedEmptyEventSetHash: int64 = int64(357)
        expectedEmptyEventSetHash = engine.DistributedHashStep(expectedEmptyEventSetHash, int64(0))
        if receipt.eventSetHash != expectedEmptyEventSetHash:
            return Err[bool]("depin residency settlement daemon file event batch receipt: empty event set")
    else:
        if receipt.triggerKindHash <= int64(0) ||
           receipt.triggerEventHash <= int64(0) ||
           receipt.firstEventHash <= int64(0) ||
           receipt.lastEventHash <= int64(0):
            return Err[bool]("depin residency settlement daemon file event batch receipt: emitted events")
        let kvTriggerHash = DepinSettlementTextHash(DepinInferenceTransportResidencySettlementDaemonEventKvHeadUpdated)
        let repairTriggerHash = DepinSettlementTextHash(DepinInferenceTransportResidencySettlementDaemonEventRepairDaemonUpdated)
        let dueTriggerHash = DepinSettlementTextHash(DepinInferenceTransportResidencySettlementDaemonEventSupervisorDue)
        if receipt.triggerKindHash != kvTriggerHash &&
           receipt.triggerKindHash != repairTriggerHash &&
           receipt.triggerKindHash != dueTriggerHash:
            return Err[bool]("depin residency settlement daemon file event batch receipt: trigger kind")
        var expectedEventSetHash: int64 = int64(357)
        expectedEventSetHash = engine.DistributedHashStep(expectedEventSetHash, int64(3))
        expectedEventSetHash = engine.DistributedHashStep(expectedEventSetHash, receipt.firstEventHash)
        expectedEventSetHash = engine.DistributedHashStep(expectedEventSetHash, receipt.triggerEventHash)
        expectedEventSetHash = engine.DistributedHashStep(expectedEventSetHash, receipt.lastEventHash)
        if receipt.eventSetHash != expectedEventSetHash:
            return Err[bool]("depin residency settlement daemon file event batch receipt: event set")
    if receipt.supervisorStateHash == int64(0):
        if receipt.supervisorByteHash != int64(0) ||
           receipt.previousSupervisorNextEligibleAtNs != int64(0) ||
           receipt.previousSupervisorLeaseUntilNs != int64(0):
            return Err[bool]("depin residency settlement daemon file event batch receipt: missing supervisor")
    else:
        if receipt.supervisorByteHash <= int64(0) ||
           receipt.previousSupervisorNextEligibleAtNs <= int64(0) ||
           receipt.previousSupervisorLeaseUntilNs <= int64(0):
            return Err[bool]("depin residency settlement daemon file event batch receipt: supervisor")
    if DepinInferenceTransportResidencySettlementDaemonFileEventBatchHash(receipt) != receipt.batchHash:
        return Err[bool]("depin residency settlement daemon file event batch receipt: batch hash")
    if DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon file event batch receipt: receipt hash")
    let readRes = DepinInferenceTransportReadResidencySettlementDaemonFileEventBatchReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).batchHash != receipt.batchHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon file event batch receipt: readback")
    return Ok[bool](true)

fn DepinInferenceTransportBuildResidencySettlementDaemonFileEventBatch(plan: engine.DistributedInferencePlan,
                                                                       peers: engine.DistributedInferencePeer[],
                                                                       baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                                       config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                       observedAtNs: int64): Result[DepinInferenceTransportResidencySettlementDaemonFileEventBatch] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(configOk))
    let baseOk = engine.DistributedValidateKvResidencyStore(plan, peers, baseKvResidencyStore)
    if IsErr(baseOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(baseOk))
    if observedAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch: observed time")
    let watchPath = DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(config.residencyPathPrefix)
    let headPath = strutil.Join([config.residencyPathPrefix, ".ckvh1"], "")
    let repairDaemonPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(config.residencyPathPrefix)
    let headRead = engine.DistributedReadKvResidencyHeadFile(plan, peers, headPath)
    if IsErr(headRead):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(headRead))
    let head = Value(headRead).receipt
    let headOk = engine.DistributedValidateKvResidencyHeadFileReceipt(plan, peers, baseKvResidencyStore, head)
    if IsErr(headOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(headOk))
    let repairRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(repairDaemonPath)
    if IsErr(repairRead):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(repairRead))
    let repairDaemon = Value(repairRead)
    let repairOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(repairDaemon)
    if IsErr(repairOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(repairOk))
    if repairDaemon.enginePlanHash != plan.engineHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch: repair plan")
    var supervisorStateHash: int64
    var supervisorByteHash: int64
    var supervisorNextEligibleAtNs: int64
    var supervisorLeaseUntilNs: int64
    let supervisorExists = os.FileExists(config.supervisorStatePath)
    if supervisorExists:
        let supervisorRead = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(config.supervisorStatePath)
        if IsErr(supervisorRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(supervisorRead))
        let supervisor = Value(supervisorRead)
        let supervisorOk = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(supervisor)
        if IsErr(supervisorOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(supervisorOk))
        if supervisor.enginePlanHash != plan.engineHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch: supervisor plan")
        supervisorStateHash = supervisor.stateHash
        supervisorByteHash = supervisor.byteHash
        supervisorNextEligibleAtNs = supervisor.nextEligibleAtNs
        supervisorLeaseUntilNs = supervisor.leaseUntilNs
    var previousBatchReceiptHash: int64
    var previousKvHeadHash: int64
    var previousKvHeadByteHash: int64
    var previousRepairDaemonStateHash: int64
    var previousRepairDaemonByteHash: int64
    var batchSeq: int64
    let previousBatchExists = os.FileExists(watchPath)
    if previousBatchExists:
        let previousRead = DepinInferenceTransportReadResidencySettlementDaemonFileEventBatchReceiptFile(watchPath)
        if IsErr(previousRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(previousRead))
        let previousOk = DepinInferenceTransportValidateResidencySettlementDaemonFileEventBatchReceipt(Value(previousRead))
        if IsErr(previousOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(previousOk))
        let previous = Value(previousRead)
        if previous.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
           previous.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
           previous.configHash != config.configHash ||
           previous.enginePlanHash != plan.engineHash ||
           previous.baseStoreHash != baseKvResidencyStore.storeHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch: previous binding")
        if observedAtNs <= previous.observedAtNs:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch: time regression")
        previousBatchReceiptHash = previous.receiptHash
        previousKvHeadHash = previous.kvHeadHash
        previousKvHeadByteHash = previous.kvHeadByteHash
        previousRepairDaemonStateHash = previous.repairDaemonStateHash
        previousRepairDaemonByteHash = previous.repairDaemonByteHash
        batchSeq = previous.batchSeq + int64(1)
    var previousRunReceiptHash: int64
    var previousRunStoppedAtNs: int64
    if os.FileExists(config.daemonRunReceiptPath):
        let previousRunRead = DepinInferenceTransportReadResidencySettlementDaemonRunReceiptFile(config.daemonRunReceiptPath)
        if IsErr(previousRunRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(previousRunRead))
        let previousRunOk = DepinInferenceTransportValidateResidencySettlementDaemonRunReceipt(Value(previousRunRead))
        if IsErr(previousRunOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(previousRunOk))
        let previousRun = Value(previousRunRead)
        if previousRun.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
           previousRun.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
           previousRun.configHash != config.configHash ||
           previousRun.enginePlanHash != plan.engineHash ||
           previousRun.baseStoreHash != baseKvResidencyStore.storeHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch: previous run binding")
        previousRunReceiptHash = previousRun.receiptHash
        previousRunStoppedAtNs = previousRun.stoppedAtNs
    var supervisorDue: bool
    if !supervisorExists:
        supervisorDue = true
    elif observedAtNs >= supervisorNextEligibleAtNs && observedAtNs >= supervisorLeaseUntilNs:
        supervisorDue = true
    var triggerKind: str
    if supervisorDue:
        if previousBatchExists &&
           (previousKvHeadHash != head.headHash || previousKvHeadByteHash != head.byteHash):
            triggerKind = DepinInferenceTransportResidencySettlementDaemonEventKvHeadUpdated
        elif previousBatchExists &&
             (previousRepairDaemonStateHash != repairDaemon.stateHash || previousRepairDaemonByteHash != repairDaemon.byteHash):
            triggerKind = DepinInferenceTransportResidencySettlementDaemonEventRepairDaemonUpdated
        else:
            triggerKind = DepinInferenceTransportResidencySettlementDaemonEventSupervisorDue
    var events: DepinInferenceTransportResidencySettlementDaemonEvent[]
    if triggerKind != "":
        if config.maxEvents < 3:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch: max events")
        if previousRunReceiptHash > int64(0) && observedAtNs <= previousRunStoppedAtNs:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch: previous run time")
        let triggerSourceRes = depinInferenceTransportResidencySettlementDaemonExpectedEventSourcePath(config, triggerKind)
        if IsErr(triggerSourceRes):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(triggerSourceRes))
        let startEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
            config,
            DepinInferenceTransportResidencySettlementDaemonEventStart,
            config.residencyPathPrefix,
            int64(0),
            observedAtNs
        )
        let triggerEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
            config,
            triggerKind,
            Value(triggerSourceRes),
            int64(1),
            observedAtNs
        )
        let stopEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
            config,
            DepinInferenceTransportResidencySettlementDaemonEventStop,
            config.daemonRunReceiptPath,
            int64(2),
            observedAtNs + int64(1)
        )
        events = [startEvent, triggerEvent, stopEvent]
    let eventSetHash = DepinInferenceTransportResidencySettlementDaemonEventSetHash(events)
    var firstEventHash: int64
    var triggerEventHash: int64
    var lastEventHash: int64
    if events.len > 0:
        firstEventHash = events[0].eventHash
        triggerEventHash = events[1].eventHash
        lastEventHash = events[events.len - 1].eventHash
    var triggerKindHash: int64
    if triggerKind != "":
        triggerKindHash = DepinSettlementTextHash(triggerKind)
    var draft = DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonFileEventBatchSchema,
        path: watchPath,
        daemonIdHash: DepinSettlementTextHash(config.daemonId),
        eventStreamHash: DepinSettlementTextHash(config.eventStreamId),
        configHash: config.configHash,
        enginePlanHash: plan.engineHash,
        baseStoreHash: baseKvResidencyStore.storeHash,
        previousBatchReceiptHash: previousBatchReceiptHash,
        batchSeq: batchSeq,
        observedAtNs: observedAtNs,
        triggerKindHash: triggerKindHash,
        triggerEventHash: triggerEventHash,
        emittedEventCount: int32(events.len),
        eventSetHash: eventSetHash,
        firstEventHash: firstEventHash,
        lastEventHash: lastEventHash,
        kvHeadHash: head.headHash,
        kvHeadByteHash: head.byteHash,
        kvTargetPeerHash: DepinSettlementTextHash(head.targetPeerId),
        repairDaemonStateHash: repairDaemon.stateHash,
        repairDaemonByteHash: repairDaemon.byteHash,
        supervisorStateHash: supervisorStateHash,
        supervisorByteHash: supervisorByteHash,
        previousRunReceiptHash: previousRunReceiptHash,
        previousSupervisorNextEligibleAtNs: supervisorNextEligibleAtNs,
        previousSupervisorLeaseUntilNs: supervisorLeaseUntilNs,
        complete: true,
        batchHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    let receiptRes = DepinInferenceTransportWriteResidencySettlementDaemonFileEventBatchReceiptFile(watchPath, draft)
    if IsErr(receiptRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(receiptRes))
    let out = DepinInferenceTransportResidencySettlementDaemonFileEventBatch(
        receipt: Value(receiptRes),
        events: events
    )
    return Ok[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](out)

fn DepinInferenceTransportBuildResidencySettlementDaemonFileEventBatchFromStartupBundle(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                                       startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                                       observedAtNs: int64): Result[DepinInferenceTransportResidencySettlementDaemonFileEventBatch] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(configOk))
    let startupOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startupBundle)
    if IsErr(startupOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(startupOk))
    if observedAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: observed time")
    if startupBundle.configHash != config.configHash ||
       startupBundle.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
       startupBundle.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
       startupBundle.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix) ||
       startupBundle.residencyPrefixHash != DepinSettlementTextHash(config.residencyPathPrefix):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: binding")
    let watchPath = DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(config.residencyPathPrefix)
    let headPath = strutil.Join([config.residencyPathPrefix, ".ckvh1"], "")
    let repairDaemonPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(config.residencyPathPrefix)
    let headDigestRes = depinInferenceTransportReadKvResidencyHeadDigestFile(headPath)
    if IsErr(headDigestRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(headDigestRes))
    let head = Value(headDigestRes)
    if head.enginePlanHash != startupBundle.enginePlanHash ||
       head.baseStoreHash != startupBundle.baseStoreHash ||
       head.targetPeerHash != startupBundle.kvTargetPeerTransportHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: kv head")
    let repairRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(repairDaemonPath)
    if IsErr(repairRead):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(repairRead))
    let repairDaemon = Value(repairRead)
    let repairOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(repairDaemon)
    if IsErr(repairOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(repairOk))
    if repairDaemon.enginePlanHash != startupBundle.enginePlanHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: repair plan")
    var supervisorStateHash: int64
    var supervisorByteHash: int64
    var supervisorNextEligibleAtNs: int64
    var supervisorLeaseUntilNs: int64
    let supervisorExists = os.FileExists(config.supervisorStatePath)
    if supervisorExists:
        let supervisorRead = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(config.supervisorStatePath)
        if IsErr(supervisorRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(supervisorRead))
        let supervisor = Value(supervisorRead)
        let supervisorOk = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(supervisor)
        if IsErr(supervisorOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(supervisorOk))
        if supervisor.enginePlanHash != startupBundle.enginePlanHash ||
           supervisor.kvTargetPeerHash != startupBundle.kvTargetPeerHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: supervisor binding")
        supervisorStateHash = supervisor.stateHash
        supervisorByteHash = supervisor.byteHash
        supervisorNextEligibleAtNs = supervisor.nextEligibleAtNs
        supervisorLeaseUntilNs = supervisor.leaseUntilNs
    var previousBatchReceiptHash: int64
    var previousKvHeadHash: int64
    var previousKvHeadByteHash: int64
    var previousRepairDaemonStateHash: int64
    var previousRepairDaemonByteHash: int64
    var batchSeq: int64
    let previousBatchExists = os.FileExists(watchPath)
    if previousBatchExists:
        let previousRead = DepinInferenceTransportReadResidencySettlementDaemonFileEventBatchReceiptFile(watchPath)
        if IsErr(previousRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(previousRead))
        let previousOk = DepinInferenceTransportValidateResidencySettlementDaemonFileEventBatchReceipt(Value(previousRead))
        if IsErr(previousOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(previousOk))
        let previous = Value(previousRead)
        if previous.daemonIdHash != startupBundle.daemonIdHash ||
           previous.eventStreamHash != startupBundle.eventStreamHash ||
           previous.configHash != startupBundle.configHash ||
           previous.enginePlanHash != startupBundle.enginePlanHash ||
           previous.baseStoreHash != startupBundle.baseStoreHash ||
           previous.kvTargetPeerHash != startupBundle.kvTargetPeerHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: previous binding")
        if observedAtNs <= previous.observedAtNs:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: time regression")
        previousBatchReceiptHash = previous.receiptHash
        previousKvHeadHash = previous.kvHeadHash
        previousKvHeadByteHash = previous.kvHeadByteHash
        previousRepairDaemonStateHash = previous.repairDaemonStateHash
        previousRepairDaemonByteHash = previous.repairDaemonByteHash
        batchSeq = previous.batchSeq + int64(1)
    var previousRunReceiptHash: int64
    var previousRunStoppedAtNs: int64
    if os.FileExists(config.daemonRunReceiptPath):
        let previousRunRead = DepinInferenceTransportReadResidencySettlementDaemonRunReceiptFile(config.daemonRunReceiptPath)
        if IsErr(previousRunRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(previousRunRead))
        let previousRunOk = DepinInferenceTransportValidateResidencySettlementDaemonRunReceipt(Value(previousRunRead))
        if IsErr(previousRunOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(previousRunOk))
        let previousRun = Value(previousRunRead)
        if previousRun.daemonIdHash != startupBundle.daemonIdHash ||
           previousRun.eventStreamHash != startupBundle.eventStreamHash ||
           previousRun.configHash != startupBundle.configHash ||
           previousRun.enginePlanHash != startupBundle.enginePlanHash ||
           previousRun.baseStoreHash != startupBundle.baseStoreHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: previous run binding")
        previousRunReceiptHash = previousRun.receiptHash
        previousRunStoppedAtNs = previousRun.stoppedAtNs
    var supervisorDue: bool
    if !supervisorExists:
        supervisorDue = true
    elif observedAtNs >= supervisorNextEligibleAtNs && observedAtNs >= supervisorLeaseUntilNs:
        supervisorDue = true
    var triggerKind: str
    if supervisorDue:
        if previousBatchExists &&
           (previousKvHeadHash != head.headHash || previousKvHeadByteHash != head.byteHash):
            triggerKind = DepinInferenceTransportResidencySettlementDaemonEventKvHeadUpdated
        elif previousBatchExists &&
             (previousRepairDaemonStateHash != repairDaemon.stateHash || previousRepairDaemonByteHash != repairDaemon.byteHash):
            triggerKind = DepinInferenceTransportResidencySettlementDaemonEventRepairDaemonUpdated
        else:
            triggerKind = DepinInferenceTransportResidencySettlementDaemonEventSupervisorDue
    var events: DepinInferenceTransportResidencySettlementDaemonEvent[]
    if triggerKind != "":
        if config.maxEvents < 3:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: max events")
        if previousRunReceiptHash > int64(0) && observedAtNs <= previousRunStoppedAtNs:
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch]("depin residency settlement daemon file event batch startup: previous run time")
        let triggerSourceRes = depinInferenceTransportResidencySettlementDaemonExpectedEventSourcePath(config, triggerKind)
        if IsErr(triggerSourceRes):
            return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(triggerSourceRes))
        let startEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
            config,
            DepinInferenceTransportResidencySettlementDaemonEventStart,
            config.residencyPathPrefix,
            int64(0),
            observedAtNs
        )
        let triggerEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
            config,
            triggerKind,
            Value(triggerSourceRes),
            int64(1),
            observedAtNs
        )
        let stopEvent = DepinInferenceTransportBuildResidencySettlementDaemonEvent(
            config,
            DepinInferenceTransportResidencySettlementDaemonEventStop,
            config.daemonRunReceiptPath,
            int64(2),
            observedAtNs + int64(1)
        )
        events = [startEvent, triggerEvent, stopEvent]
    let eventSetHash = DepinInferenceTransportResidencySettlementDaemonEventSetHash(events)
    var firstEventHash: int64
    var triggerEventHash: int64
    var lastEventHash: int64
    if events.len > 0:
        firstEventHash = events[0].eventHash
        triggerEventHash = events[1].eventHash
        lastEventHash = events[events.len - 1].eventHash
    var triggerKindHash: int64
    if triggerKind != "":
        triggerKindHash = DepinSettlementTextHash(triggerKind)
    var draft = DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonFileEventBatchSchema,
        path: watchPath,
        daemonIdHash: startupBundle.daemonIdHash,
        eventStreamHash: startupBundle.eventStreamHash,
        configHash: startupBundle.configHash,
        enginePlanHash: startupBundle.enginePlanHash,
        baseStoreHash: startupBundle.baseStoreHash,
        previousBatchReceiptHash: previousBatchReceiptHash,
        batchSeq: batchSeq,
        observedAtNs: observedAtNs,
        triggerKindHash: triggerKindHash,
        triggerEventHash: triggerEventHash,
        emittedEventCount: int32(events.len),
        eventSetHash: eventSetHash,
        firstEventHash: firstEventHash,
        lastEventHash: lastEventHash,
        kvHeadHash: head.headHash,
        kvHeadByteHash: head.byteHash,
        kvTargetPeerHash: startupBundle.kvTargetPeerHash,
        repairDaemonStateHash: repairDaemon.stateHash,
        repairDaemonByteHash: repairDaemon.byteHash,
        supervisorStateHash: supervisorStateHash,
        supervisorByteHash: supervisorByteHash,
        previousRunReceiptHash: previousRunReceiptHash,
        previousSupervisorNextEligibleAtNs: supervisorNextEligibleAtNs,
        previousSupervisorLeaseUntilNs: supervisorLeaseUntilNs,
        complete: true,
        batchHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    let receiptRes = DepinInferenceTransportWriteResidencySettlementDaemonFileEventBatchReceiptFile(watchPath, draft)
    if IsErr(receiptRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](Error(receiptRes))
    let out = DepinInferenceTransportResidencySettlementDaemonFileEventBatch(
        receipt: Value(receiptRes),
        events: events
    )
    return Ok[DepinInferenceTransportResidencySettlementDaemonFileEventBatch](out)

fn DepinInferenceTransportResidencySettlementDaemonRunHash(receipt: DepinInferenceTransportResidencySettlementDaemonRunReceipt): int64 =
    var h: int64 = int64(347)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashStep(h, receipt.daemonIdHash)
    h = engine.DistributedHashStep(h, receipt.eventStreamHash)
    h = engine.DistributedHashStep(h, receipt.configHash)
    h = engine.DistributedHashStep(h, receipt.enginePlanHash)
    h = engine.DistributedHashStep(h, receipt.baseStoreHash)
    h = engine.DistributedHashStep(h, receipt.previousRunReceiptHash)
    h = engine.DistributedHashStep(h, receipt.runSeq)
    h = engine.DistributedHashStep(h, receipt.firstEventHash)
    h = engine.DistributedHashStep(h, receipt.lastEventHash)
    h = engine.DistributedHashStep(h, int64(receipt.eventCount))
    h = engine.DistributedHashStep(h, int64(receipt.supervisorTickCount))
    h = engine.DistributedHashStep(h, receipt.lastSupervisorReceiptHash)
    h = engine.DistributedHashStep(h, receipt.lastSupervisorStateHash)
    h = engine.DistributedHashStep(h, receipt.lastKvHeadHash)
    h = engine.DistributedHashStep(h, receipt.lastRepairDaemonStateHash)
    h = engine.DistributedHashStep(h, receipt.lastRepairReceiptHash)
    h = engine.DistributedHashStep(h, receipt.startedAtNs)
    h = engine.DistributedHashStep(h, receipt.stoppedAtNs)
    h = engine.DistributedHashStep(h, receipt.lastEventAtNs)
    h = engine.DistributedHashStep(h, receipt.completed ? int64(1) : int64(0))
    return h

fn DepinInferenceTransportResidencySettlementDaemonRunReceiptHash(receipt: DepinInferenceTransportResidencySettlementDaemonRunReceipt): int64 =
    var h: int64 = int64(349)
    h = engine.DistributedHashTextWith(h, receipt.schema)
    h = engine.DistributedHashTextWith(h, receipt.path)
    h = engine.DistributedHashStep(h, receipt.runHash)
    h = engine.DistributedHashStep(h, int64(receipt.byteCount))
    h = engine.DistributedHashStep(h, receipt.byteHash)
    return h

fn DepinInferenceTransportResidencySettlementDaemonRunFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return engine.DistributedHashBytesWith(int64(353), bytesRaw)

fn depinInferenceTransportResidencySettlementDaemonRunFileWord(receipt: DepinInferenceTransportResidencySettlementDaemonRunReceipt,
                                                               index: int32): int64 =
    if index == 0:
        return int64(DepinInferenceTransportResidencySettlementDaemonRunFileMagic)
    if index == 1:
        return int64(DepinInferenceTransportResidencySettlementDaemonRunFileVersion)
    if index == 2:
        return receipt.daemonIdHash
    if index == 3:
        return receipt.eventStreamHash
    if index == 4:
        return receipt.configHash
    if index == 5:
        return receipt.enginePlanHash
    if index == 6:
        return receipt.baseStoreHash
    if index == 7:
        return receipt.previousRunReceiptHash
    if index == 8:
        return receipt.runSeq
    if index == 9:
        return receipt.firstEventHash
    if index == 10:
        return receipt.lastEventHash
    if index == 11:
        return int64(receipt.eventCount)
    if index == 12:
        return int64(receipt.supervisorTickCount)
    if index == 13:
        return receipt.lastSupervisorReceiptHash
    if index == 14:
        return receipt.lastSupervisorStateHash
    if index == 15:
        return receipt.lastKvHeadHash
    if index == 16:
        return receipt.lastRepairDaemonStateHash
    if index == 17:
        return receipt.lastRepairReceiptHash
    if index == 18:
        return receipt.startedAtNs
    if index == 19:
        return receipt.stoppedAtNs
    if index == 20:
        return receipt.lastEventAtNs
    if index == 21:
        return receipt.completed ? int64(1) : int64(0)
    if index == 22:
        return receipt.runHash
    return int64(-1)

fn depinInferenceTransportResidencySettlementDaemonRunFileBytes(receipt: DepinInferenceTransportResidencySettlementDaemonRunReceipt): Result[rawbytes.Bytes] =
    if receipt.runHash <= int64(0):
        return Err[rawbytes.Bytes]("depin residency settlement daemon run file: run hash")
    let byteCount = DepinInferenceTransportResidencySettlementDaemonRunFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin residency settlement daemon run file: allocation")
    for i in 0..<DepinInferenceTransportResidencySettlementDaemonRunFileWordCount:
        engine.DistributedWriteI64LE(out, i * 8, depinInferenceTransportResidencySettlementDaemonRunFileWord(receipt, i))
    return Ok[rawbytes.Bytes](out)

fn depinInferenceTransportResidencySettlementDaemonRunReceiptBuild(path: str,
                                                                   bytesRaw: rawbytes.Bytes): Result[DepinInferenceTransportResidencySettlementDaemonRunReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon run file: path")
    if rawbytes.BytesLen(bytesRaw) != DepinInferenceTransportResidencySettlementDaemonRunFileWordCount * 8:
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon run file: byte length")
    let magic = engine.DistributedReadI64LE(bytesRaw, 0)
    let version = engine.DistributedReadI64LE(bytesRaw, 8)
    if magic != int64(DepinInferenceTransportResidencySettlementDaemonRunFileMagic) ||
       version != int64(DepinInferenceTransportResidencySettlementDaemonRunFileVersion):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon run file: header")
    let runSeqRaw = engine.DistributedReadI64LE(bytesRaw, 64)
    let eventCountRaw = engine.DistributedReadI64LE(bytesRaw, 88)
    let supervisorTickCountRaw = engine.DistributedReadI64LE(bytesRaw, 96)
    let completedRaw = engine.DistributedReadI64LE(bytesRaw, 168)
    if runSeqRaw < int64(0) ||
       eventCountRaw <= int64(0) ||
       eventCountRaw > int64(2147483647) ||
       supervisorTickCountRaw <= int64(0) ||
       supervisorTickCountRaw > int64(2147483647) ||
       (completedRaw != int64(0) && completedRaw != int64(1)):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon run file: ranges")
    var receipt = DepinInferenceTransportResidencySettlementDaemonRunReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonRunReceiptSchema,
        path: path,
        daemonIdHash: engine.DistributedReadI64LE(bytesRaw, 16),
        eventStreamHash: engine.DistributedReadI64LE(bytesRaw, 24),
        configHash: engine.DistributedReadI64LE(bytesRaw, 32),
        enginePlanHash: engine.DistributedReadI64LE(bytesRaw, 40),
        baseStoreHash: engine.DistributedReadI64LE(bytesRaw, 48),
        previousRunReceiptHash: engine.DistributedReadI64LE(bytesRaw, 56),
        runSeq: runSeqRaw,
        firstEventHash: engine.DistributedReadI64LE(bytesRaw, 72),
        lastEventHash: engine.DistributedReadI64LE(bytesRaw, 80),
        eventCount: int32(eventCountRaw),
        supervisorTickCount: int32(supervisorTickCountRaw),
        lastSupervisorReceiptHash: engine.DistributedReadI64LE(bytesRaw, 104),
        lastSupervisorStateHash: engine.DistributedReadI64LE(bytesRaw, 112),
        lastKvHeadHash: engine.DistributedReadI64LE(bytesRaw, 120),
        lastRepairDaemonStateHash: engine.DistributedReadI64LE(bytesRaw, 128),
        lastRepairReceiptHash: engine.DistributedReadI64LE(bytesRaw, 136),
        startedAtNs: engine.DistributedReadI64LE(bytesRaw, 144),
        stoppedAtNs: engine.DistributedReadI64LE(bytesRaw, 152),
        lastEventAtNs: engine.DistributedReadI64LE(bytesRaw, 160),
        completed: completedRaw == int64(1),
        runHash: engine.DistributedReadI64LE(bytesRaw, 176),
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: DepinInferenceTransportResidencySettlementDaemonRunFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    if DepinInferenceTransportResidencySettlementDaemonRunHash(receipt) != receipt.runHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon run file: run hash")
    receipt.receiptHash = DepinInferenceTransportResidencySettlementDaemonRunReceiptHash(receipt)
    return Ok[DepinInferenceTransportResidencySettlementDaemonRunReceipt](receipt)

fn DepinInferenceTransportWriteResidencySettlementDaemonRunReceiptFile(path: str,
                                                                       draft: DepinInferenceTransportResidencySettlementDaemonRunReceipt): Result[DepinInferenceTransportResidencySettlementDaemonRunReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon run file: path")
    var receipt = draft
    receipt.schema = DepinInferenceTransportResidencySettlementDaemonRunReceiptSchema
    receipt.path = path
    receipt.byteCount = DepinInferenceTransportResidencySettlementDaemonRunFileWordCount * 8
    receipt.byteHash = int64(0)
    receipt.receiptHash = int64(0)
    receipt.runHash = int64(0)
    receipt.runHash = DepinInferenceTransportResidencySettlementDaemonRunHash(receipt)
    let bytesRes = depinInferenceTransportResidencySettlementDaemonRunFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       DepinInferenceTransportResidencySettlementDaemonRunFileByteHash(readBytes) != DepinInferenceTransportResidencySettlementDaemonRunFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon run file: readback")
    let receiptRes = depinInferenceTransportResidencySettlementDaemonRunReceiptBuild(path, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    if IsErr(receiptRes):
        return receiptRes
    let ok = DepinInferenceTransportValidateResidencySettlementDaemonRunReceipt(Value(receiptRes))
    if IsErr(ok):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(ok))
    return receiptRes

fn DepinInferenceTransportReadResidencySettlementDaemonRunReceiptFile(path: str): Result[DepinInferenceTransportResidencySettlementDaemonRunReceipt] =
    if path == "":
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon run file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinInferenceTransportResidencySettlementDaemonRunReceiptBuild(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinInferenceTransportValidateResidencySettlementDaemonRunReceipt(receipt: DepinInferenceTransportResidencySettlementDaemonRunReceipt): Result[bool] =
    if receipt.schema != DepinInferenceTransportResidencySettlementDaemonRunReceiptSchema ||
       receipt.path == "" ||
       receipt.daemonIdHash <= int64(0) ||
       receipt.eventStreamHash <= int64(0) ||
       receipt.configHash <= int64(0) ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.baseStoreHash <= int64(0) ||
       receipt.runSeq < int64(0) ||
       receipt.firstEventHash <= int64(0) ||
       receipt.lastEventHash <= int64(0) ||
       receipt.eventCount <= 0 ||
       receipt.supervisorTickCount <= 0 ||
       receipt.lastSupervisorReceiptHash <= int64(0) ||
       receipt.lastSupervisorStateHash <= int64(0) ||
       receipt.lastKvHeadHash <= int64(0) ||
       receipt.lastRepairDaemonStateHash <= int64(0) ||
       receipt.lastRepairReceiptHash <= int64(0) ||
       receipt.startedAtNs <= int64(0) ||
       receipt.stoppedAtNs <= int64(0) ||
       receipt.lastEventAtNs != receipt.stoppedAtNs ||
       receipt.stoppedAtNs < receipt.startedAtNs ||
       !receipt.completed ||
       receipt.runHash <= int64(0) ||
       receipt.byteCount != DepinInferenceTransportResidencySettlementDaemonRunFileWordCount * 8 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin residency settlement daemon run receipt: fields")
    if receipt.runSeq == int64(0) && receipt.previousRunReceiptHash != int64(0):
        return Err[bool]("depin residency settlement daemon run receipt: initial predecessor")
    if receipt.runSeq > int64(0) && receipt.previousRunReceiptHash <= int64(0):
        return Err[bool]("depin residency settlement daemon run receipt: predecessor")
    if DepinInferenceTransportResidencySettlementDaemonRunHash(receipt) != receipt.runHash:
        return Err[bool]("depin residency settlement daemon run receipt: run hash")
    if DepinInferenceTransportResidencySettlementDaemonRunReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon run receipt: receipt hash")
    let readRes = DepinInferenceTransportReadResidencySettlementDaemonRunReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).runHash != receipt.runHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin residency settlement daemon run receipt: readback")
    return Ok[bool](true)

fn DepinInferenceTransportSettlementLedgerQuorumPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csq1"], "")

fn DepinInferenceTransportReplicateSettlementLedgerToPeer(link: var DepinInferenceTransportPeerLink,
                                                          plan: engine.DistributedInferencePlan,
                                                          sourcePeerId: str,
                                                          ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                                          replicaPath: str,
                                                          seqNo: int64,
                                                          sentAtNs: int64): Result[DepinInferenceTransportSettlementLedgerReplicationReceipt] =
    let requestRes = DepinInferenceTransportBuildSettlementLedgerRequestFrame(
        plan,
        sourcePeerId,
        link.peerId,
        ledgerReceipt,
        seqNo,
        sentAtNs
    )
    if IsErr(requestRes):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(requestRes))
    let writeReq = DepinInferenceTransportWriteWireFrame(link.outbound, Value(requestRes))
    if IsErr(writeReq):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(writeReq))
    let readReq = DepinInferenceTransportReadWireFrame(link.inbound)
    if IsErr(readReq):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(readReq))
    if Value(readReq).frameHash != Value(requestRes).frameHash:
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt]("depin settlement ledger replication: request echo")
    let replicaRes = DepinSettlementWriteLedgerReplicaReceiptFile(
        replicaPath,
        sourcePeerId,
        link.peerId,
        ledgerReceipt,
        Value(readReq).frameHash,
        sentAtNs + int64(1)
    )
    if IsErr(replicaRes):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(replicaRes))
    let ackRes = DepinInferenceTransportBuildSettlementLedgerAckFrame(
        plan,
        Value(readReq),
        ledgerReceipt,
        Value(replicaRes),
        sentAtNs + int64(1)
    )
    if IsErr(ackRes):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(ackRes))
    let writeAck = DepinInferenceTransportWriteWireFrame(link.inbound, Value(ackRes))
    if IsErr(writeAck):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(writeAck))
    let readAck = DepinInferenceTransportReadWireFrame(link.outbound)
    if IsErr(readAck):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(readAck))
    let receiptRes = DepinInferenceTransportBuildSettlementLedgerReplicationReceipt(
        plan,
        sourcePeerId,
        sourcePeerId,
        link.peerId,
        ledgerReceipt,
        Value(replicaRes),
        Value(requestRes),
        Value(readAck),
        sentAtNs + int64(1)
    )
    if IsErr(receiptRes):
        return Err[DepinInferenceTransportSettlementLedgerReplicationReceipt](Error(receiptRes))
    return receiptRes

fn DepinInferenceTransportReplicateSettlementLedgerQuorum(links: var DepinInferenceTransportPeerLink[],
                                                          plan: engine.DistributedInferencePlan,
                                                          settlementPlan: DepinSettlementPlan,
                                                          sourcePeerId: str,
                                                          ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                                          replicaPathPrefix: str,
                                                          seqNoBase: int64,
                                                          sentAtNs: int64): Result[DepinInferenceTransportSettlementLedgerQuorumReceipt] =
    if sourcePeerId == "" || replicaPathPrefix == "" || seqNoBase < int64(0) || sentAtNs <= int64(0):
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt]("depin settlement ledger quorum: args")
    let planOk = DepinSettlementValidatePlan(settlementPlan)
    if IsErr(planOk):
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt](Error(planOk))
    let ledgerOk = DepinSettlementValidateLedgerFileReceipt(ledgerReceipt)
    if IsErr(ledgerOk):
        return Err[DepinInferenceTransportSettlementLedgerQuorumReceipt](Error(ledgerOk))
    var receipts: DepinInferenceTransportSettlementLedgerReplicationReceipt[]
    var failures: DepinInferenceTransportSettlementLedgerReplicationFailure[]
    var attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[]
    var successCount: int32
    var attemptSeqNo: int64
    for i in 0..<settlementPlan.replicaPeers.len:
        let targetPeerId = settlementPlan.replicaPeers[i]
        var targetSucceeded: bool
        var targetLastError: str
        var targetLastAttemptAtNs: int64
        for attemptIndex in 0..<settlementPlan.replicaMaxAttempts:
            if !targetSucceeded:
                let attemptAtNs = sentAtNs + int64(i * settlementPlan.replicaMaxAttempts + attemptIndex) + int64(1)
                let seqNo = seqNoBase + attemptSeqNo
                attemptSeqNo = attemptSeqNo + int64(1)
                targetLastAttemptAtNs = attemptAtNs
                let linkIndex = DepinInferenceTransportFindPeerLink(links, targetPeerId)
                if IsErr(linkIndex):
                    targetLastError = Error(linkIndex)
                    add(attempts, DepinInferenceTransportBuildSettlementLedgerReplicationAttempt(
                        plan,
                        sourcePeerId,
                        targetPeerId,
                        ledgerReceipt,
                        attemptIndex,
                        seqNo,
                        attemptAtNs,
                        false,
                        int64(0),
                        int64(0),
                        int64(0),
                        targetLastError
                    ))
                else:
                    var link = links[Value(linkIndex)]
                    let replicaRes = DepinInferenceTransportReplicateSettlementLedgerToPeer(
                        link,
                        plan,
                        sourcePeerId,
                        ledgerReceipt,
                        DepinSettlementLedgerReplicaPathFromPrefix(replicaPathPrefix, targetPeerId),
                        seqNo,
                        attemptAtNs
                    )
                    links[Value(linkIndex)] = link
                    if IsErr(replicaRes):
                        targetLastError = Error(replicaRes)
                        add(attempts, DepinInferenceTransportBuildSettlementLedgerReplicationAttempt(
                            plan,
                            sourcePeerId,
                            targetPeerId,
                            ledgerReceipt,
                            attemptIndex,
                            seqNo,
                            attemptAtNs,
                            false,
                            int64(0),
                            int64(0),
                            int64(0),
                            targetLastError
                        ))
                    else:
                        let replicaReceipt = Value(replicaRes)
                        add(attempts, DepinInferenceTransportBuildSettlementLedgerReplicationAttempt(
                            plan,
                            sourcePeerId,
                            targetPeerId,
                            ledgerReceipt,
                            attemptIndex,
                            seqNo,
                            attemptAtNs,
                            true,
                            replicaReceipt.requestFrameHash,
                            replicaReceipt.ackFrameHash,
                            replicaReceipt.replicaReceiptHash,
                            ""
                        ))
                        add(receipts, replicaReceipt)
                        successCount = successCount + 1
                        targetSucceeded = true
        if !targetSucceeded:
            add(failures, DepinInferenceTransportBuildSettlementLedgerReplicationFailure(
                plan,
                sourcePeerId,
                targetPeerId,
                ledgerReceipt,
                targetLastError,
                targetLastAttemptAtNs
            ))
    return DepinInferenceTransportBuildSettlementLedgerQuorumReceipt(
        plan,
        settlementPlan,
        sourcePeerId,
        sourcePeerId,
        ledgerReceipt,
        receipts,
        failures,
        attempts,
        sentAtNs + int64(settlementPlan.replicaPeers.len * settlementPlan.replicaMaxAttempts) + int64(1)
    )

fn depinInferenceTransportReplicaReceiptMatches(receipt: DepinSettlementLedgerReplicaReceipt,
                                                sourcePeerId: str,
                                                targetPeerId: str,
                                                ledgerReceipt: DepinSettlementLedgerFileReceipt): bool =
    return receipt.sourcePeerHash == DepinSettlementTextHash(sourcePeerId) &&
           receipt.targetPeerHash == DepinSettlementTextHash(targetPeerId) &&
           receipt.ledgerHash == ledgerReceipt.ledgerHash &&
           receipt.ledgerReceiptHash == ledgerReceipt.receiptHash &&
           receipt.ledgerByteHash == ledgerReceipt.byteHash &&
           receipt.ledgerByteCount == ledgerReceipt.byteCount &&
           receipt.ledgerRecordCount == ledgerReceipt.recordCount &&
           receipt.ledgerHeadRecordHash == ledgerReceipt.headRecordHash &&
           receipt.ledgerRecordSetHash == ledgerReceipt.recordSetHash

fn DepinInferenceTransportRunSettlementLedgerRepairServiceTick(links: var DepinInferenceTransportPeerLink[],
                                                               plan: engine.DistributedInferencePlan,
                                                               settlementPlan: DepinSettlementPlan,
                                                               sourcePeerId: str,
                                                               replicaPathPrefix: str,
                                                               previousQuorumPath: str,
                                                               repairReceiptPath: str,
                                                               seqNoBase: int64,
                                                               repairedAtNs: int64): Result[DepinInferenceTransportSettlementLedgerRepairReceipt] =
    if sourcePeerId == "" ||
       replicaPathPrefix == "" ||
       previousQuorumPath == "" ||
       repairReceiptPath == "" ||
       seqNoBase < int64(0) ||
       repairedAtNs <= int64(0):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair: args")
    let planOk = DepinSettlementValidatePlan(settlementPlan)
    if IsErr(planOk):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(planOk))
    let ledgerRead = DepinSettlementReadLedgerFile(DepinSettlementLedgerPathFromPrefix(replicaPathPrefix))
    if IsErr(ledgerRead):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(ledgerRead))
    let ledgerReceipt = Value(ledgerRead).receipt
    let ledgerOk = DepinSettlementValidateLedgerFileReceipt(ledgerReceipt)
    if IsErr(ledgerOk):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(ledgerOk))
    let previousQuorumRead = DepinInferenceTransportReadSettlementLedgerQuorumReceiptFile(previousQuorumPath)
    if IsErr(previousQuorumRead):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(previousQuorumRead))
    let previousQuorumOk = DepinInferenceTransportValidateSettlementLedgerQuorumFileReceipt(Value(previousQuorumRead))
    if IsErr(previousQuorumOk):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt](Error(previousQuorumOk))
    if Value(previousQuorumRead).enginePlanHash != plan.engineHash ||
       Value(previousQuorumRead).sourcePeerHash != DepinSettlementTextHash(sourcePeerId) ||
       Value(previousQuorumRead).ledgerHash != ledgerReceipt.ledgerHash ||
       Value(previousQuorumRead).ledgerReceiptHash != ledgerReceipt.receiptHash ||
       Value(previousQuorumRead).ledgerByteHash != ledgerReceipt.byteHash ||
       Value(previousQuorumRead).plannedReplicaCount != settlementPlan.replicaPeers.len ||
       Value(previousQuorumRead).requiredReplicaCount != settlementPlan.replicaQuorum ||
       Value(previousQuorumRead).maxReplicaAttempts != settlementPlan.replicaMaxAttempts ||
       Value(previousQuorumRead).targetPeerSetHash != DepinSettlementPlanReplicaPeerSetHash(settlementPlan):
        return Err[DepinInferenceTransportSettlementLedgerRepairReceipt]("depin settlement ledger repair: quorum binding")
    var existingReplicas: DepinSettlementLedgerReplicaReceipt[]
    var repairedReceipts: DepinInferenceTransportSettlementLedgerReplicationReceipt[]
    var failures: DepinInferenceTransportSettlementLedgerReplicationFailure[]
    var attempts: DepinInferenceTransportSettlementLedgerReplicationAttempt[]
    var attemptSeqNo: int64
    for i in 0..<settlementPlan.replicaPeers.len:
        let targetPeerId = settlementPlan.replicaPeers[i]
        let replicaPath = DepinSettlementLedgerReplicaPathFromPrefix(replicaPathPrefix, targetPeerId)
        let replicaRead = DepinSettlementReadLedgerReplicaReceiptFile(replicaPath)
        var alreadyReplicated: bool
        if IsOk(replicaRead):
            let replicaOk = DepinSettlementValidateLedgerReplicaReceipt(Value(replicaRead))
            if IsOk(replicaOk) &&
               depinInferenceTransportReplicaReceiptMatches(Value(replicaRead), sourcePeerId, targetPeerId, ledgerReceipt):
                add(existingReplicas, Value(replicaRead))
                alreadyReplicated = true
        if !alreadyReplicated:
            var targetSucceeded: bool
            var targetLastError: str
            var targetLastAttemptAtNs: int64
            for attemptIndex in 0..<settlementPlan.replicaMaxAttempts:
                if !targetSucceeded:
                    let attemptAtNs = repairedAtNs + int64(i * settlementPlan.replicaMaxAttempts + attemptIndex) + int64(1)
                    let seqNo = seqNoBase + attemptSeqNo
                    attemptSeqNo = attemptSeqNo + int64(1)
                    targetLastAttemptAtNs = attemptAtNs
                    let linkIndex = DepinInferenceTransportFindPeerLink(links, targetPeerId)
                    if IsErr(linkIndex):
                        targetLastError = Error(linkIndex)
                        add(attempts, DepinInferenceTransportBuildSettlementLedgerReplicationAttempt(
                            plan,
                            sourcePeerId,
                            targetPeerId,
                            ledgerReceipt,
                            attemptIndex,
                            seqNo,
                            attemptAtNs,
                            false,
                            int64(0),
                            int64(0),
                            int64(0),
                            targetLastError
                        ))
                    else:
                        var link = links[Value(linkIndex)]
                        let repairRes = DepinInferenceTransportReplicateSettlementLedgerToPeer(
                            link,
                            plan,
                            sourcePeerId,
                            ledgerReceipt,
                            replicaPath,
                            seqNo,
                            attemptAtNs
                        )
                        links[Value(linkIndex)] = link
                        if IsErr(repairRes):
                            targetLastError = Error(repairRes)
                            add(attempts, DepinInferenceTransportBuildSettlementLedgerReplicationAttempt(
                                plan,
                                sourcePeerId,
                                targetPeerId,
                                ledgerReceipt,
                                attemptIndex,
                                seqNo,
                                attemptAtNs,
                                false,
                                int64(0),
                                int64(0),
                                int64(0),
                                targetLastError
                            ))
                        else:
                            let repairReceipt = Value(repairRes)
                            add(attempts, DepinInferenceTransportBuildSettlementLedgerReplicationAttempt(
                                plan,
                                sourcePeerId,
                                targetPeerId,
                                ledgerReceipt,
                                attemptIndex,
                                seqNo,
                                attemptAtNs,
                                true,
                                repairReceipt.requestFrameHash,
                                repairReceipt.ackFrameHash,
                                repairReceipt.replicaReceiptHash,
                                ""
                            ))
                            add(repairedReceipts, repairReceipt)
                            targetSucceeded = true
            if !targetSucceeded:
                add(failures, DepinInferenceTransportBuildSettlementLedgerReplicationFailure(
                    plan,
                    sourcePeerId,
                    targetPeerId,
                    ledgerReceipt,
                    targetLastError,
                    targetLastAttemptAtNs
                ))
    var draft = DepinInferenceTransportSettlementLedgerRepairReceipt(
        schema: DepinInferenceTransportSettlementLedgerRepairReceiptSchema,
        path: repairReceiptPath,
        enginePlanHash: plan.engineHash,
        sourcePeerHash: DepinSettlementTextHash(sourcePeerId),
        ledgerHash: ledgerReceipt.ledgerHash,
        ledgerReceiptHash: ledgerReceipt.receiptHash,
        ledgerByteHash: ledgerReceipt.byteHash,
        previousQuorumFileReceiptHash: Value(previousQuorumRead).receiptHash,
        plannedReplicaCount: int32(settlementPlan.replicaPeers.len),
        existingReplicaCount: int32(existingReplicas.len),
        repairedReplicaCount: int32(repairedReceipts.len),
        failedReplicaCount: int32(failures.len),
        finalReplicaCount: int32(existingReplicas.len + repairedReceipts.len),
        maxRepairAttempts: settlementPlan.replicaMaxAttempts,
        replicaAttemptCount: int32(attempts.len),
        replicaAttemptSetHash: depinInferenceTransportSettlementLedgerAttemptSetHash(attempts),
        existingReplicaReceiptSetHash: depinInferenceTransportSettlementLedgerReplicaFileReceiptSetHash(existingReplicas),
        repairedReplicaReceiptSetHash: depinInferenceTransportSettlementLedgerReplicationReceiptSetHash(repairedReceipts),
        failureSetHash: depinInferenceTransportSettlementLedgerFailureSetHash(failures),
        bytesWritten: int32(repairedReceipts.len) * pipe.DepinInferenceWireFrameBytes,
        bytesRead: int32(repairedReceipts.len) * pipe.DepinInferenceWireFrameBytes,
        repairedAtNs: repairedAtNs,
        complete: existingReplicas.len + repairedReceipts.len == settlementPlan.replicaPeers.len,
        repairHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteSettlementLedgerRepairReceiptFile(repairReceiptPath, draft)

fn DepinInferenceTransportRunSettlementRepairDaemonSchedulerTick(links: var DepinInferenceTransportPeerLink[],
                                                                 plan: engine.DistributedInferencePlan,
                                                                 settlementPlan: DepinSettlementPlan,
                                                                 sourcePeerId: str,
                                                                 replicaPathPrefix: str,
                                                                 previousQuorumPath: str,
                                                                 repairReceiptPath: str,
                                                                 daemonStatePath: str,
                                                                 seqNoBase: int64,
                                                                 tickedAtNs: int64,
                                                                 intervalNs: int64,
                                                                 leaseNs: int64): Result[DepinInferenceTransportSettlementRepairDaemonStateReceipt] =
    if sourcePeerId == "" ||
       replicaPathPrefix == "" ||
       previousQuorumPath == "" ||
       repairReceiptPath == "" ||
       daemonStatePath == "" ||
       seqNoBase < int64(0) ||
       tickedAtNs <= int64(0) ||
       intervalNs <= int64(0) ||
       leaseNs <= int64(0):
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon scheduler: args")
    let planOk = DepinSettlementValidatePlan(settlementPlan)
    if IsErr(planOk):
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(planOk))
    let sourcePeerHash = DepinSettlementTextHash(sourcePeerId)
    let settlementPlanHash = DepinSettlementPlanHash(settlementPlan)
    let targetPeerSetHash = DepinSettlementPlanReplicaPeerSetHash(settlementPlan)
    var tickSeq: int64
    var previousDaemonStateHash: int64
    if os.FileExists(daemonStatePath):
        let previousRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(daemonStatePath)
        if IsErr(previousRead):
            return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(previousRead))
        let previousOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(Value(previousRead))
        if IsErr(previousOk):
            return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(previousOk))
        let previousState = Value(previousRead)
        if previousState.enginePlanHash != plan.engineHash ||
           previousState.sourcePeerHash != sourcePeerHash ||
           previousState.settlementPlanHash != settlementPlanHash ||
           previousState.targetPeerSetHash != targetPeerSetHash:
            return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon scheduler: previous binding")
        let previousRepairRead = DepinInferenceTransportReadSettlementLedgerRepairReceiptFile(repairReceiptPath)
        if IsErr(previousRepairRead):
            return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(previousRepairRead))
        let previousRepairOk = DepinInferenceTransportValidateSettlementLedgerRepairReceipt(Value(previousRepairRead))
        if IsErr(previousRepairOk):
            return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(previousRepairOk))
        if Value(previousRepairRead).receiptHash != previousState.repairReceiptHash ||
           Value(previousRepairRead).repairHash != previousState.repairHash ||
           Value(previousRepairRead).byteHash != previousState.repairByteHash:
            return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon scheduler: previous repair binding")
        if tickedAtNs < previousState.nextEligibleAtNs ||
           tickedAtNs < previousState.leaseUntilNs:
            return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt]("depin settlement repair daemon scheduler: not due")
        previousDaemonStateHash = previousState.receiptHash
        tickSeq = previousState.tickSeq + int64(1)
    let repairRes = DepinInferenceTransportRunSettlementLedgerRepairServiceTick(
        links,
        plan,
        settlementPlan,
        sourcePeerId,
        replicaPathPrefix,
        previousQuorumPath,
        repairReceiptPath,
        seqNoBase,
        tickedAtNs
    )
    if IsErr(repairRes):
        return Err[DepinInferenceTransportSettlementRepairDaemonStateReceipt](Error(repairRes))
    let repair = Value(repairRes)
    var draft = DepinInferenceTransportSettlementRepairDaemonStateReceipt(
        schema: DepinInferenceTransportSettlementRepairDaemonStateSchema,
        path: daemonStatePath,
        enginePlanHash: plan.engineHash,
        sourcePeerHash: sourcePeerHash,
        settlementPlanHash: settlementPlanHash,
        targetPeerSetHash: targetPeerSetHash,
        previousQuorumFileReceiptHash: repair.previousQuorumFileReceiptHash,
        repairReceiptHash: repair.receiptHash,
        repairHash: repair.repairHash,
        ledgerHash: repair.ledgerHash,
        ledgerReceiptHash: repair.ledgerReceiptHash,
        previousDaemonStateHash: previousDaemonStateHash,
        tickSeq: tickSeq,
        tickedAtNs: tickedAtNs,
        nextEligibleAtNs: tickedAtNs + intervalNs,
        leaseUntilNs: tickedAtNs + leaseNs,
        intervalNs: intervalNs,
        plannedReplicaCount: repair.plannedReplicaCount,
        finalReplicaCount: repair.finalReplicaCount,
        failedReplicaCount: repair.failedReplicaCount,
        repairComplete: repair.complete,
        repairByteCount: repair.byteCount,
        repairByteHash: repair.byteHash,
        stateHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteSettlementRepairDaemonStateReceiptFile(daemonStatePath, draft)

fn DepinInferenceTransportRunResidencySettlementSupervisorTick(plan: engine.DistributedInferencePlan,
                                                              peers: engine.DistributedInferencePeer[],
                                                              baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                              residencyPathPrefix: str,
                                                              supervisorStatePath: str,
                                                              tickedAtNs: int64,
                                                              intervalNs: int64,
                                                              leaseNs: int64): Result[DepinInferenceTransportResidencySettlementSupervisorStateReceipt] =
    if residencyPathPrefix == "" ||
       supervisorStatePath == "" ||
       tickedAtNs <= int64(0) ||
       intervalNs <= int64(0) ||
       leaseNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor: args")
    let baseOk = engine.DistributedValidateKvResidencyStore(plan, peers, baseKvResidencyStore)
    if IsErr(baseOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(baseOk))
    let residencyHeadPath = strutil.Join([residencyPathPrefix, ".ckvh1"], "")
    let headRead = engine.DistributedReadKvResidencyHeadFile(plan, peers, residencyHeadPath)
    if IsErr(headRead):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(headRead))
    let head = Value(headRead).receipt
    let headOk = engine.DistributedValidateKvResidencyHeadFileReceipt(plan, peers, baseKvResidencyStore, head)
    if IsErr(headOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(headOk))
    if tickedAtNs < head.updatedAtNs:
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor: head time")
    let repairDaemonPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(residencyPathPrefix)
    let repairDaemonRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(repairDaemonPath)
    if IsErr(repairDaemonRead):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(repairDaemonRead))
    let repairDaemon = Value(repairDaemonRead)
    let repairDaemonOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(repairDaemon)
    if IsErr(repairDaemonOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(repairDaemonOk))
    if repairDaemon.enginePlanHash != plan.engineHash ||
       !repairDaemon.repairComplete ||
       tickedAtNs < repairDaemon.tickedAtNs:
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor: repair daemon")
    let repairPath = DepinInferenceTransportSettlementLedgerRepairPathFromPrefix(residencyPathPrefix)
    let repairRead = DepinInferenceTransportReadSettlementLedgerRepairReceiptFile(repairPath)
    if IsErr(repairRead):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(repairRead))
    let repair = Value(repairRead)
    let repairOk = DepinInferenceTransportValidateSettlementLedgerRepairReceipt(repair)
    if IsErr(repairOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(repairOk))
    if repair.receiptHash != repairDaemon.repairReceiptHash ||
       repair.repairHash != repairDaemon.repairHash ||
       repair.byteHash != repairDaemon.repairByteHash ||
       !repair.complete:
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor: repair binding")
    let kvTargetPeerHash = DepinSettlementTextHash(head.targetPeerId)
    var tickSeq: int64
    var previousSupervisorStateHash: int64
    if os.FileExists(supervisorStatePath):
        let previousRead = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(supervisorStatePath)
        if IsErr(previousRead):
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(previousRead))
        let previousOk = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(Value(previousRead))
        if IsErr(previousOk):
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(previousOk))
        let previous = Value(previousRead)
        if previous.enginePlanHash != plan.engineHash ||
           previous.kvTargetPeerHash != kvTargetPeerHash ||
           previous.settlementSourcePeerHash != repairDaemon.sourcePeerHash ||
           previous.settlementPlanHash != repairDaemon.settlementPlanHash ||
           previous.settlementTargetPeerSetHash != repairDaemon.targetPeerSetHash:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor: previous binding")
        if head.commitSeq < previous.kvCommitSeq:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor: commit regression")
        if tickedAtNs < previous.nextEligibleAtNs ||
           tickedAtNs < previous.leaseUntilNs:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor: not due")
        previousSupervisorStateHash = previous.receiptHash
        tickSeq = previous.tickSeq + int64(1)
    var draft = DepinInferenceTransportResidencySettlementSupervisorStateReceipt(
        schema: DepinInferenceTransportResidencySettlementSupervisorStateSchema,
        path: supervisorStatePath,
        enginePlanHash: plan.engineHash,
        kvTargetPeerHash: kvTargetPeerHash,
        kvHeadHash: head.headHash,
        kvCurrentStoreHash: head.currentStoreHash,
        kvWalLogHash: head.walLogHash,
        kvCommitSeq: head.commitSeq,
        settlementSourcePeerHash: repairDaemon.sourcePeerHash,
        settlementPlanHash: repairDaemon.settlementPlanHash,
        settlementTargetPeerSetHash: repairDaemon.targetPeerSetHash,
        settlementRepairDaemonReceiptHash: repairDaemon.receiptHash,
        settlementRepairDaemonStateHash: repairDaemon.stateHash,
        settlementRepairReceiptHash: repair.receiptHash,
        settlementRepairHash: repair.repairHash,
        previousSupervisorStateHash: previousSupervisorStateHash,
        tickSeq: tickSeq,
        tickedAtNs: tickedAtNs,
        nextEligibleAtNs: tickedAtNs + intervalNs,
        leaseUntilNs: tickedAtNs + leaseNs,
        intervalNs: intervalNs,
        kvReady: true,
        settlementReady: true,
        complete: true,
        kvHeadByteHash: head.byteHash,
        repairDaemonByteHash: repairDaemon.byteHash,
        repairByteHash: repair.byteHash,
        stateHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteResidencySettlementSupervisorStateReceiptFile(supervisorStatePath, draft)

fn depinInferenceTransportRunResidencySettlementSupervisorTickFromStartupBundle(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                               startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                               batchReceipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt,
                                                                               tickedAtNs: int64): Result[DepinInferenceTransportResidencySettlementSupervisorStateReceipt] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(configOk))
    let startupOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startupBundle)
    if IsErr(startupOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(startupOk))
    let batchOk = DepinInferenceTransportValidateResidencySettlementDaemonFileEventBatchReceipt(batchReceipt)
    if IsErr(batchOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(batchOk))
    if startupBundle.configHash != config.configHash ||
       startupBundle.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
       startupBundle.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
       startupBundle.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix) ||
       batchReceipt.path != DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(config.residencyPathPrefix) ||
       batchReceipt.daemonIdHash != startupBundle.daemonIdHash ||
       batchReceipt.eventStreamHash != startupBundle.eventStreamHash ||
       batchReceipt.configHash != startupBundle.configHash ||
       batchReceipt.enginePlanHash != startupBundle.enginePlanHash ||
       batchReceipt.baseStoreHash != startupBundle.baseStoreHash ||
       tickedAtNs <= int64(0):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: binding")
    let residencyHeadPath = strutil.Join([config.residencyPathPrefix, ".ckvh1"], "")
    let headDigestRes = depinInferenceTransportReadKvResidencyHeadDigestFile(residencyHeadPath)
    if IsErr(headDigestRes):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(headDigestRes))
    let head = Value(headDigestRes)
    if head.enginePlanHash != startupBundle.enginePlanHash ||
       head.baseStoreHash != startupBundle.baseStoreHash ||
       head.headHash != batchReceipt.kvHeadHash ||
       head.byteHash != batchReceipt.kvHeadByteHash ||
       tickedAtNs < head.updatedAtNs:
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: kv head")
    let repairDaemonPath = DepinInferenceTransportSettlementRepairDaemonStatePathFromPrefix(config.residencyPathPrefix)
    let repairDaemonRead = DepinInferenceTransportReadSettlementRepairDaemonStateReceiptFile(repairDaemonPath)
    if IsErr(repairDaemonRead):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(repairDaemonRead))
    let repairDaemon = Value(repairDaemonRead)
    let repairDaemonOk = DepinInferenceTransportValidateSettlementRepairDaemonStateReceipt(repairDaemon)
    if IsErr(repairDaemonOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(repairDaemonOk))
    if repairDaemon.enginePlanHash != startupBundle.enginePlanHash ||
       repairDaemon.stateHash != batchReceipt.repairDaemonStateHash ||
       repairDaemon.byteHash != batchReceipt.repairDaemonByteHash ||
       !repairDaemon.repairComplete ||
       tickedAtNs < repairDaemon.tickedAtNs:
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: repair daemon")
    let repairPath = DepinInferenceTransportSettlementLedgerRepairPathFromPrefix(config.residencyPathPrefix)
    let repairRead = DepinInferenceTransportReadSettlementLedgerRepairReceiptFile(repairPath)
    if IsErr(repairRead):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(repairRead))
    let repair = Value(repairRead)
    let repairOk = DepinInferenceTransportValidateSettlementLedgerRepairReceipt(repair)
    if IsErr(repairOk):
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(repairOk))
    if repair.receiptHash != repairDaemon.repairReceiptHash ||
       repair.repairHash != repairDaemon.repairHash ||
       repair.byteHash != repairDaemon.repairByteHash ||
       !repair.complete:
        return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: repair binding")
    var tickSeq: int64
    var previousSupervisorStateHash: int64
    if os.FileExists(config.supervisorStatePath):
        let previousRead = DepinInferenceTransportReadResidencySettlementSupervisorStateReceiptFile(config.supervisorStatePath)
        if IsErr(previousRead):
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(previousRead))
        let previousOk = DepinInferenceTransportValidateResidencySettlementSupervisorStateReceipt(Value(previousRead))
        if IsErr(previousOk):
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt](Error(previousOk))
        let previous = Value(previousRead)
        if batchReceipt.supervisorStateHash <= int64(0):
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: previous state missing")
        if previous.stateHash != batchReceipt.supervisorStateHash:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: previous state hash")
        if previous.byteHash != batchReceipt.supervisorByteHash:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: previous byte hash")
        if previous.nextEligibleAtNs != batchReceipt.previousSupervisorNextEligibleAtNs ||
           previous.leaseUntilNs != batchReceipt.previousSupervisorLeaseUntilNs:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: previous time binding")
        if previous.enginePlanHash != startupBundle.enginePlanHash:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: previous plan")
        if previous.kvTargetPeerHash != batchReceipt.kvTargetPeerHash:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: previous kv target")
        if previous.settlementSourcePeerHash != repairDaemon.sourcePeerHash ||
           previous.settlementPlanHash != repairDaemon.settlementPlanHash ||
           previous.settlementTargetPeerSetHash != repairDaemon.targetPeerSetHash:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: previous settlement binding")
        if head.commitSeq < previous.kvCommitSeq:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: commit regression")
        if tickedAtNs < previous.nextEligibleAtNs ||
           tickedAtNs < previous.leaseUntilNs:
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: not due")
        previousSupervisorStateHash = previous.receiptHash
        tickSeq = previous.tickSeq + int64(1)
    else:
        if batchReceipt.supervisorStateHash != int64(0) ||
           batchReceipt.supervisorByteHash != int64(0) ||
           batchReceipt.previousSupervisorNextEligibleAtNs != int64(0) ||
           batchReceipt.previousSupervisorLeaseUntilNs != int64(0):
            return Err[DepinInferenceTransportResidencySettlementSupervisorStateReceipt]("depin residency settlement supervisor startup loop: missing previous")
    var draft = DepinInferenceTransportResidencySettlementSupervisorStateReceipt(
        schema: DepinInferenceTransportResidencySettlementSupervisorStateSchema,
        path: config.supervisorStatePath,
        enginePlanHash: startupBundle.enginePlanHash,
        kvTargetPeerHash: batchReceipt.kvTargetPeerHash,
        kvHeadHash: head.headHash,
        kvCurrentStoreHash: head.currentStoreHash,
        kvWalLogHash: head.walLogHash,
        kvCommitSeq: head.commitSeq,
        settlementSourcePeerHash: repairDaemon.sourcePeerHash,
        settlementPlanHash: repairDaemon.settlementPlanHash,
        settlementTargetPeerSetHash: repairDaemon.targetPeerSetHash,
        settlementRepairDaemonReceiptHash: repairDaemon.receiptHash,
        settlementRepairDaemonStateHash: repairDaemon.stateHash,
        settlementRepairReceiptHash: repair.receiptHash,
        settlementRepairHash: repair.repairHash,
        previousSupervisorStateHash: previousSupervisorStateHash,
        tickSeq: tickSeq,
        tickedAtNs: tickedAtNs,
        nextEligibleAtNs: tickedAtNs + config.intervalNs,
        leaseUntilNs: tickedAtNs + config.leaseNs,
        intervalNs: config.intervalNs,
        kvReady: true,
        settlementReady: true,
        complete: true,
        kvHeadByteHash: head.byteHash,
        repairDaemonByteHash: repairDaemon.byteHash,
        repairByteHash: repair.byteHash,
        stateHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteResidencySettlementSupervisorStateReceiptFile(config.supervisorStatePath, draft)

fn DepinInferenceTransportRunResidencySettlementDaemonEventLoopFromStartupBundle(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                                startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                                batchReceipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt,
                                                                                events: DepinInferenceTransportResidencySettlementDaemonEvent[]): Result[DepinInferenceTransportResidencySettlementDaemonRunReceipt] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(configOk))
    let startupOk = DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(startupBundle)
    if IsErr(startupOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(startupOk))
    let batchOk = DepinInferenceTransportValidateResidencySettlementDaemonFileEventBatchReceipt(batchReceipt)
    if IsErr(batchOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(batchOk))
    if startupBundle.configHash != config.configHash ||
       startupBundle.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
       startupBundle.eventStreamHash != DepinSettlementTextHash(config.eventStreamId) ||
       startupBundle.path != DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(config.residencyPathPrefix) ||
       batchReceipt.path != DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(config.residencyPathPrefix) ||
       batchReceipt.daemonIdHash != startupBundle.daemonIdHash ||
       batchReceipt.eventStreamHash != startupBundle.eventStreamHash ||
       batchReceipt.configHash != startupBundle.configHash ||
       batchReceipt.enginePlanHash != startupBundle.enginePlanHash ||
       batchReceipt.baseStoreHash != startupBundle.baseStoreHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: binding")
    if events.len <= 0 ||
       events.len > config.maxEvents ||
       int32(events.len) != batchReceipt.emittedEventCount ||
       DepinInferenceTransportResidencySettlementDaemonEventSetHash(events) != batchReceipt.eventSetHash ||
       events[0].eventHash != batchReceipt.firstEventHash ||
       events[events.len - 1].eventHash != batchReceipt.lastEventHash:
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: event batch")
    var previousRunReceiptHash: int64
    var previousStoppedAtNs: int64
    var runSeq: int64
    if os.FileExists(config.daemonRunReceiptPath):
        let previousRead = DepinInferenceTransportReadResidencySettlementDaemonRunReceiptFile(config.daemonRunReceiptPath)
        if IsErr(previousRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(previousRead))
        let previousOk = DepinInferenceTransportValidateResidencySettlementDaemonRunReceipt(Value(previousRead))
        if IsErr(previousOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(previousOk))
        let previous = Value(previousRead)
        if previous.configHash != config.configHash ||
           previous.enginePlanHash != startupBundle.enginePlanHash ||
           previous.baseStoreHash != startupBundle.baseStoreHash ||
           previous.daemonIdHash != startupBundle.daemonIdHash ||
           previous.eventStreamHash != startupBundle.eventStreamHash ||
           previous.receiptHash != batchReceipt.previousRunReceiptHash:
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: previous binding")
        previousRunReceiptHash = previous.receiptHash
        previousStoppedAtNs = previous.stoppedAtNs
        runSeq = previous.runSeq + int64(1)
    else:
        if batchReceipt.previousRunReceiptHash != int64(0):
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: missing previous")
    var firstEventHash: int64
    var lastEventHash: int64
    var lastEventAtNs: int64
    var startedAtNs: int64
    var stoppedAtNs: int64
    var startSeen: bool
    var completed: bool
    var supervisorTickCount: int32
    var lastSupervisorReceiptHash: int64
    var lastSupervisorStateHash: int64
    var lastKvHeadHash: int64
    var lastRepairDaemonStateHash: int64
    var lastRepairReceiptHash: int64
    for i in 0..<events.len:
        if completed:
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: event after stop")
        let event = events[i]
        let eventOk = DepinInferenceTransportValidateResidencySettlementDaemonEvent(config, event, int64(i))
        if IsErr(eventOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(eventOk))
        if i == 0:
            firstEventHash = event.eventHash
            if runSeq > int64(0) && event.dueAtNs <= previousStoppedAtNs:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: previous time")
        if lastEventAtNs > int64(0) && event.dueAtNs < lastEventAtNs:
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: time regression")
        lastEventHash = event.eventHash
        lastEventAtNs = event.dueAtNs
        if event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventStart:
            if i != 0 || startSeen:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: start")
            startSeen = true
            startedAtNs = event.dueAtNs
        elif event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventStop:
            if !startSeen || i != events.len - 1:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: stop")
            completed = true
            stoppedAtNs = event.dueAtNs
        elif event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventKvHeadUpdated ||
             event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventRepairDaemonUpdated ||
             event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventSupervisorDue:
            if !startSeen:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: missing start")
            if event.eventHash != batchReceipt.triggerEventHash:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: trigger")
            let tick = depinInferenceTransportRunResidencySettlementSupervisorTickFromStartupBundle(
                config,
                startupBundle,
                batchReceipt,
                event.dueAtNs
            )
            if IsErr(tick):
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(tick))
            let tickReceipt = Value(tick)
            supervisorTickCount = supervisorTickCount + 1
            lastSupervisorReceiptHash = tickReceipt.receiptHash
            lastSupervisorStateHash = tickReceipt.stateHash
            lastKvHeadHash = tickReceipt.kvHeadHash
            lastRepairDaemonStateHash = tickReceipt.settlementRepairDaemonStateHash
            lastRepairReceiptHash = tickReceipt.settlementRepairReceiptHash
        else:
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: kind")
    if !startSeen ||
       !completed ||
       supervisorTickCount <= 0:
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: incomplete")
    var draft = DepinInferenceTransportResidencySettlementDaemonRunReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonRunReceiptSchema,
        path: config.daemonRunReceiptPath,
        daemonIdHash: startupBundle.daemonIdHash,
        eventStreamHash: startupBundle.eventStreamHash,
        configHash: config.configHash,
        enginePlanHash: startupBundle.enginePlanHash,
        baseStoreHash: startupBundle.baseStoreHash,
        previousRunReceiptHash: previousRunReceiptHash,
        runSeq: runSeq,
        firstEventHash: firstEventHash,
        lastEventHash: lastEventHash,
        eventCount: int32(events.len),
        supervisorTickCount: supervisorTickCount,
        lastSupervisorReceiptHash: lastSupervisorReceiptHash,
        lastSupervisorStateHash: lastSupervisorStateHash,
        lastKvHeadHash: lastKvHeadHash,
        lastRepairDaemonStateHash: lastRepairDaemonStateHash,
        lastRepairReceiptHash: lastRepairReceiptHash,
        startedAtNs: startedAtNs,
        stoppedAtNs: stoppedAtNs,
        lastEventAtNs: lastEventAtNs,
        completed: completed,
        runHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteResidencySettlementDaemonRunReceiptFile(config.daemonRunReceiptPath, draft)

fn DepinInferenceTransportRunResidencySettlementDaemonFileEventBatchFromStartupBundle(config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                                                     startupBundle: DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                                                                     batchReceipt: DepinInferenceTransportResidencySettlementDaemonFileEventBatchReceipt): Result[DepinInferenceTransportResidencySettlementDaemonRunReceipt] =
    let eventsRes = DepinInferenceTransportRebuildResidencySettlementDaemonEventsFromBatchReceipt(config, batchReceipt)
    if IsErr(eventsRes):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(eventsRes))
    let events = Value(eventsRes)
    if events.len <= 0:
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon startup loop: empty batch")
    return DepinInferenceTransportRunResidencySettlementDaemonEventLoopFromStartupBundle(config, startupBundle, batchReceipt, events)

fn DepinInferenceTransportRunResidencySettlementDaemonEventLoop(plan: engine.DistributedInferencePlan,
                                                               peers: engine.DistributedInferencePeer[],
                                                               baseKvResidencyStore: engine.DistributedKvResidencyStore,
                                                               config: DepinInferenceTransportResidencySettlementDaemonConfig,
                                                               events: DepinInferenceTransportResidencySettlementDaemonEvent[]): Result[DepinInferenceTransportResidencySettlementDaemonRunReceipt] =
    let configOk = DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(configOk))
    let baseOk = engine.DistributedValidateKvResidencyStore(plan, peers, baseKvResidencyStore)
    if IsErr(baseOk):
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(baseOk))
    if events.len <= 0 ||
       events.len > config.maxEvents:
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: event count")
    var previousRunReceiptHash: int64
    var previousStoppedAtNs: int64
    var runSeq: int64
    if os.FileExists(config.daemonRunReceiptPath):
        let previousRead = DepinInferenceTransportReadResidencySettlementDaemonRunReceiptFile(config.daemonRunReceiptPath)
        if IsErr(previousRead):
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(previousRead))
        let previousOk = DepinInferenceTransportValidateResidencySettlementDaemonRunReceipt(Value(previousRead))
        if IsErr(previousOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(previousOk))
        let previous = Value(previousRead)
        if previous.configHash != config.configHash ||
           previous.enginePlanHash != plan.engineHash ||
           previous.baseStoreHash != baseKvResidencyStore.storeHash ||
           previous.daemonIdHash != DepinSettlementTextHash(config.daemonId) ||
           previous.eventStreamHash != DepinSettlementTextHash(config.eventStreamId):
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: previous binding")
        previousRunReceiptHash = previous.receiptHash
        previousStoppedAtNs = previous.stoppedAtNs
        runSeq = previous.runSeq + int64(1)
    var firstEventHash: int64
    var lastEventHash: int64
    var lastEventAtNs: int64
    var startedAtNs: int64
    var stoppedAtNs: int64
    var startSeen: bool
    var completed: bool
    var supervisorTickCount: int32
    var lastSupervisorReceiptHash: int64
    var lastSupervisorStateHash: int64
    var lastKvHeadHash: int64
    var lastRepairDaemonStateHash: int64
    var lastRepairReceiptHash: int64
    for i in 0..<events.len:
        if completed:
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: event after stop")
        let event = events[i]
        let eventOk = DepinInferenceTransportValidateResidencySettlementDaemonEvent(config, event, int64(i))
        if IsErr(eventOk):
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(eventOk))
        if i == 0:
            firstEventHash = event.eventHash
            if runSeq > int64(0) && event.dueAtNs <= previousStoppedAtNs:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: previous time")
        if lastEventAtNs > int64(0) && event.dueAtNs < lastEventAtNs:
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: time regression")
        lastEventHash = event.eventHash
        lastEventAtNs = event.dueAtNs
        if event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventStart:
            if i != 0 || startSeen:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: start")
            startSeen = true
            startedAtNs = event.dueAtNs
        elif event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventStop:
            if !startSeen || i != events.len - 1:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: stop")
            completed = true
            stoppedAtNs = event.dueAtNs
        elif event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventKvHeadUpdated ||
             event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventRepairDaemonUpdated ||
             event.eventKind == DepinInferenceTransportResidencySettlementDaemonEventSupervisorDue:
            if !startSeen:
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: missing start")
            let tick = DepinInferenceTransportRunResidencySettlementSupervisorTick(
                plan,
                peers,
                baseKvResidencyStore,
                config.residencyPathPrefix,
                config.supervisorStatePath,
                event.dueAtNs,
                config.intervalNs,
                config.leaseNs
            )
            if IsErr(tick):
                return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt](Error(tick))
            let tickReceipt = Value(tick)
            supervisorTickCount = supervisorTickCount + 1
            lastSupervisorReceiptHash = tickReceipt.receiptHash
            lastSupervisorStateHash = tickReceipt.stateHash
            lastKvHeadHash = tickReceipt.kvHeadHash
            lastRepairDaemonStateHash = tickReceipt.settlementRepairDaemonStateHash
            lastRepairReceiptHash = tickReceipt.settlementRepairReceiptHash
        else:
            return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: kind")
    if !startSeen ||
       !completed ||
       supervisorTickCount <= 0:
        return Err[DepinInferenceTransportResidencySettlementDaemonRunReceipt]("depin residency settlement daemon loop: incomplete")
    var draft = DepinInferenceTransportResidencySettlementDaemonRunReceipt(
        schema: DepinInferenceTransportResidencySettlementDaemonRunReceiptSchema,
        path: config.daemonRunReceiptPath,
        daemonIdHash: DepinSettlementTextHash(config.daemonId),
        eventStreamHash: DepinSettlementTextHash(config.eventStreamId),
        configHash: config.configHash,
        enginePlanHash: plan.engineHash,
        baseStoreHash: baseKvResidencyStore.storeHash,
        previousRunReceiptHash: previousRunReceiptHash,
        runSeq: runSeq,
        firstEventHash: firstEventHash,
        lastEventHash: lastEventHash,
        eventCount: int32(events.len),
        supervisorTickCount: supervisorTickCount,
        lastSupervisorReceiptHash: lastSupervisorReceiptHash,
        lastSupervisorStateHash: lastSupervisorStateHash,
        lastKvHeadHash: lastKvHeadHash,
        lastRepairDaemonStateHash: lastRepairDaemonStateHash,
        lastRepairReceiptHash: lastRepairReceiptHash,
        startedAtNs: startedAtNs,
        stoppedAtNs: stoppedAtNs,
        lastEventAtNs: lastEventAtNs,
        completed: completed,
        runHash: int64(0),
        byteCount: int32(0),
        byteHash: int64(0),
        receiptHash: int64(0)
    )
    return DepinInferenceTransportWriteResidencySettlementDaemonRunReceiptFile(config.daemonRunReceiptPath, draft)

fn depinInferenceTransportFailSession(session: var DepinInferenceSession,
                                      reason: str): Result[DepinInferenceTransportDispatchSessionReceipt] =
    session.failed = true
    session.failureReason = reason
    return Err[DepinInferenceTransportDispatchSessionReceipt](reason)

fn depinInferenceTransportAppendBytes(left: Bytes, right: Bytes): Bytes =
    let out = BytesAlloc(BytesLen(left) + BytesLen(right))
    for i in 0..<BytesLen(left):
        BytesSet(out, i, BytesGet(left, i))
    for j in 0..<BytesLen(right):
        BytesSet(out, BytesLen(left) + j, BytesGet(right, j))
    return out

fn depinInferenceTransportReadExact(conn: var qconn.Connection, byteCount: int32): Result[Bytes] =
    if byteCount < 0:
        return Err[Bytes]("depin inference transport: negative read")
    if byteCount == 0:
        return Ok[Bytes](emptyBytes())
    var out: Bytes = emptyBytes()
    var readBytes: int32
    var readRes: Result[Bytes]
    var chunk: Bytes
    var chunkLen: int32
    for _attempt in 0..<DepinInferenceTransportReadTimeoutMs:
        if readBytes == byteCount:
            return Ok[Bytes](out)
        readRes = qconn.connReadNonblocking(conn, byteCount - readBytes)
        if IsErr(readRes):
            if ErrorText(readRes) == "msquic udp: queue empty" ||
               ErrorText(readRes) == "pipe: empty" ||
               ErrorText(readRes) == "connection: empty":
                os.SleepMs(1)
            else:
                return Err[Bytes](ErrorText(readRes))
        else:
            chunk = Value(readRes)
            chunkLen = BytesLen(chunk)
            if chunkLen <= 0:
                os.SleepMs(1)
            else:
                if readBytes + chunkLen > byteCount:
                    return Err[Bytes]("depin inference transport: oversized frame read")
                out = depinInferenceTransportAppendBytes(out, chunk)
                readBytes = readBytes + chunkLen
    if readBytes == byteCount:
        return Ok[Bytes](out)
    return Err[Bytes]("depin inference transport: read timeout")

fn DepinInferenceTransportWriteWireFrame(conn: var qconn.Connection,
                                         frame: pipe.DepinInferenceWireFrame): Result[int32] =
    let encodedRes: Result[Bytes] = pipe.DepinInferenceEncodeWireFrame(frame)
    if IsErr(encodedRes):
        return Err[int32](ErrorText(encodedRes))
    let encoded: Bytes = Value(encodedRes)
    let writeRes: Result[int32] = qconn.connWrite(conn, encoded)
    if IsErr(writeRes):
        return Err[int32](ErrorText(writeRes))
    if Value(writeRes) != pipe.DepinInferenceWireFrameBytes:
        return Err[int32]("depin inference transport: short frame write")
    return Ok[int32](Value(writeRes))

fn DepinInferenceTransportReadWireFrameBytes(conn: var qconn.Connection): Result[Bytes] =
    let frameRes: Result[Bytes] = depinInferenceTransportReadExact(conn, pipe.DepinInferenceWireFrameBytes)
    if IsErr(frameRes):
        return Err[Bytes](ErrorText(frameRes))
    let validateRes: Result[bool] = pipe.DepinInferenceValidateWireFrameBytes(Value(frameRes))
    if IsErr(validateRes):
        return Err[Bytes](Error(validateRes))
    return frameRes

fn DepinInferenceTransportReadWireFrame(conn: var qconn.Connection): Result[pipe.DepinInferenceWireFrame] =
    let frameBytesRes: Result[Bytes] = DepinInferenceTransportReadWireFrameBytes(conn)
    if IsErr(frameBytesRes):
        return Err[pipe.DepinInferenceWireFrame](ErrorText(frameBytesRes))
    return pipe.DepinInferenceDecodeWireFrame(Value(frameBytesRes))

fn DepinInferenceTransportWireFrameFromDistributedFrame(frame: engine.DistributedShardTransportFrame): Result[pipe.DepinInferenceWireFrame] =
    let wireBytesRes = engine.DistributedShardTransportFrameWireBytes(frame)
    if IsErr(wireBytesRes):
        return Err[pipe.DepinInferenceWireFrame](ErrorText(wireBytesRes))
    var wireBytes: Bytes = Value(wireBytesRes)
    let validateRes = pipe.DepinInferenceValidateWireFrameBytes(wireBytes)
    if IsErr(validateRes):
        BytesFree(wireBytes)
        return Err[pipe.DepinInferenceWireFrame](Error(validateRes))
    let decodedRes = pipe.DepinInferenceDecodeWireFrame(wireBytes)
    BytesFree(wireBytes)
    if IsErr(decodedRes):
        return Err[pipe.DepinInferenceWireFrame](Error(decodedRes))
    return decodedRes

fn DepinInferenceTransportWriteDistributedFrame(conn: var qconn.Connection,
                                                frame: engine.DistributedShardTransportFrame): Result[int32] =
    let wireBytesRes = engine.DistributedShardTransportFrameWireBytes(frame)
    if IsErr(wireBytesRes):
        return Err[int32](ErrorText(wireBytesRes))
    var wireBytes: Bytes = Value(wireBytesRes)
    let validateRes = pipe.DepinInferenceValidateWireFrameBytes(wireBytes)
    if IsErr(validateRes):
        BytesFree(wireBytes)
        return Err[int32](Error(validateRes))
    let writeRes: Result[int32] = qconn.connWrite(conn, wireBytes)
    BytesFree(wireBytes)
    if IsErr(writeRes):
        return Err[int32](ErrorText(writeRes))
    if Value(writeRes) != pipe.DepinInferenceWireFrameBytes:
        return Err[int32]("depin inference transport: short distributed frame write")
    return Ok[int32](Value(writeRes))

fn DepinInferenceTransportReadDistributedFrameBytes(conn: var qconn.Connection,
                                                    expected: engine.DistributedShardTransportFrame): Result[Bytes] =
    let frameBytesRes = DepinInferenceTransportReadWireFrameBytes(conn)
    if IsErr(frameBytesRes):
        return Err[Bytes](ErrorText(frameBytesRes))
    let validateRes = engine.DistributedValidateShardTransportFrameWire(expected, Value(frameBytesRes))
    if IsErr(validateRes):
        return Err[Bytes](Error(validateRes))
    return frameBytesRes

fn DepinInferenceTransportReadExpectedDistributedFrame(conn: var qconn.Connection,
                                                       expected: engine.DistributedShardTransportFrame): Result[pipe.DepinInferenceWireFrame] =
    let frameBytesRes = DepinInferenceTransportReadDistributedFrameBytes(conn, expected)
    if IsErr(frameBytesRes):
        return Err[pipe.DepinInferenceWireFrame](ErrorText(frameBytesRes))
    var frameBytes: Bytes = Value(frameBytesRes)
    let decodedRes = pipe.DepinInferenceDecodeWireFrame(frameBytes)
    BytesFree(frameBytes)
    if IsErr(decodedRes):
        return Err[pipe.DepinInferenceWireFrame](Error(decodedRes))
    return decodedRes

fn DepinInferenceTransportValidateDistributedFrameSet(frames: engine.DistributedShardTransportFrameSet): Result[bool] =
    if frames.schema != engine.DistributedShardTransportFrameSetSchema:
        return Err[bool]("depin inference transport frame set: schema")
    if frames.enginePlanHash <= int64(0) || frames.frames.len <= 0:
        return Err[bool]("depin inference transport frame set: empty")
    if engine.DistributedShardTransportFrameSetHash(frames) != frames.frameSetHash:
        return Err[bool]("depin inference transport frame set: hash")
    for i in 0..<frames.frames.len:
        if frames.frames[i].seqNo != uint64(i):
            return Err[bool]("depin inference transport frame set: seq")
        let wireRes = engine.DistributedShardTransportFrameWireBytes(frames.frames[i])
        if IsErr(wireRes):
            return Err[bool](Error(wireRes))
        var wireBytes: Bytes = Value(wireRes)
        let validateRes = pipe.DepinInferenceValidateWireFrameBytes(wireBytes)
        BytesFree(wireBytes)
        if IsErr(validateRes):
            return Err[bool](Error(validateRes))
    return Ok[bool](true)

fn DepinInferenceTransportWriteDistributedFrameSet(conn: var qconn.Connection,
                                                   frames: engine.DistributedShardTransportFrameSet): Result[int32] =
    let setOk = DepinInferenceTransportValidateDistributedFrameSet(frames)
    if IsErr(setOk):
        return Err[int32](Error(setOk))
    var written: int32
    for i in 0..<frames.frames.len:
        let writeRes = DepinInferenceTransportWriteDistributedFrame(conn, frames.frames[i])
        if IsErr(writeRes):
            return Err[int32](Error(writeRes))
        if Value(writeRes) != pipe.DepinInferenceWireFrameBytes:
            return Err[int32]("depin inference transport frame set: short write")
        written = written + Value(writeRes)
    return Ok[int32](written)

fn DepinInferenceTransportReadExpectedDistributedFrameSet(conn: var qconn.Connection,
                                                          expected: engine.DistributedShardTransportFrameSet): Result[int32] =
    let setOk = DepinInferenceTransportValidateDistributedFrameSet(expected)
    if IsErr(setOk):
        return Err[int32](Error(setOk))
    var readBytes: int32
    for i in 0..<expected.frames.len:
        let readRes = DepinInferenceTransportReadExpectedDistributedFrame(conn, expected.frames[i])
        if IsErr(readRes):
            return Err[int32](Error(readRes))
        if Value(readRes).frameHash != expected.frames[i].frameHash:
            return Err[int32]("depin inference transport frame set: frame hash")
        readBytes = readBytes + pipe.DepinInferenceWireFrameBytes
    return Ok[int32](readBytes)

fn DepinInferenceTransportWireFrameFromKvPageTransferFrame(frame: engine.DistributedKvPageTransferFrame): Result[pipe.DepinInferenceWireFrame] =
    let wireBytesRes = engine.DistributedKvPageTransferFrameWireBytes(frame)
    if IsErr(wireBytesRes):
        return Err[pipe.DepinInferenceWireFrame](ErrorText(wireBytesRes))
    var wireBytes: Bytes = Value(wireBytesRes)
    let validateRes = pipe.DepinInferenceValidateWireFrameBytes(wireBytes)
    if IsErr(validateRes):
        BytesFree(wireBytes)
        return Err[pipe.DepinInferenceWireFrame](Error(validateRes))
    let decodedRes = pipe.DepinInferenceDecodeWireFrame(wireBytes)
    BytesFree(wireBytes)
    if IsErr(decodedRes):
        return Err[pipe.DepinInferenceWireFrame](Error(decodedRes))
    return decodedRes

fn DepinInferenceTransportWriteKvPageTransferFrame(conn: var qconn.Connection,
                                                   frame: engine.DistributedKvPageTransferFrame): Result[int32] =
    let wireBytesRes = engine.DistributedKvPageTransferFrameWireBytes(frame)
    if IsErr(wireBytesRes):
        return Err[int32](ErrorText(wireBytesRes))
    var wireBytes: Bytes = Value(wireBytesRes)
    let validateRes = pipe.DepinInferenceValidateWireFrameBytes(wireBytes)
    if IsErr(validateRes):
