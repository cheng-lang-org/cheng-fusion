# DePIN inference hidden-state pipeline (strict ordered relay + fail-fast).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/depin/inference_manifest

fn depinPipelineFail(session: var DepinInferenceSession, reason: str): Result[bool] =
    session.failed = true
    session.failureReason = reason
    return Err[bool]("depin pipeline failed")

fn depinPipelineServeStage(session: var DepinInferenceSession, seqNo: uint64,
                           payload: Bytes, nowMs: int64): Result[bool] =
    if session.failed:
        return Err[bool]("depin pipeline: already failed")
    if ! session.started:
        return depinPipelineFail(session, "session_not_started")
    if session.finished:
        return depinPipelineFail(session, "session_finished")
    if seqNo != session.expectedSeqNo:
        return depinPipelineFail(session, "out_of_order")
    if session.config.hiddenStateFrameBytes > 0 &&
       BytesLen(payload) != session.config.hiddenStateFrameBytes:
        return depinPipelineFail(session, "invalid_frame_size")
    if session.lastStageAtMs > 0 && session.config.stageTimeoutMs > 0:
        let idleMs: int64 = nowMs - session.lastStageAtMs
        if idleMs > int64(session.config.stageTimeoutMs):
            return depinPipelineFail(session, "stage_timeout")
    session.expectedSeqNo = seqNo + uint64(1)
    session.lastStageAtMs = nowMs
    session.stageIndex = session.stageIndex + 1
    return Ok[bool](true)
