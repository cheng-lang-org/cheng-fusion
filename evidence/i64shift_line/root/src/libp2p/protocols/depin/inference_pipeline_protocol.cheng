# DePIN inference pipeline protocol registration.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/depin/inference_manifest

const
    depinInferenceWireFrameMagic = 2026062501
    depinInferenceWireFrameWordCount = 15
    depinInferenceWireFrameBytes = 120
    depinInferenceWireFrameKindRequest = 1
    depinInferenceWireFrameKindResponse = 2
    DepinInferenceWireFrameMagic = 2026062501
    DepinInferenceWireFrameWordCount = 15
    DepinInferenceWireFrameBytes = 120
    DepinInferenceWireFrameKindRequest = 1
    DepinInferenceWireFrameKindResponse = 2

type
    DepinInferenceWireFrame =
        magic: int64
        frameKind: int64
        enginePlanHash: int64
        seqNo: int64
        coordinatorPeerHash: int64
        sourcePeerHash: int64
        targetPeerHash: int64
        shardNameHash: int64
        requestHash: int64
        responseHash: int64
        envelopeHash: int64
        payloadHash: int64
        receiptHash: int64
        sentAtNs: int64
        frameHash: int64

fn depinInferencePipelineCodec(): str =
    return depinInferenceProtocolCodec

fn depinInferenceReadI64LE(data: Bytes, offset: int32): int64 =
    var out: int64
    out = out + int64(BytesGet(data, offset) & 255)
    out = out + (int64(BytesGet(data, offset + 1) & 255) << 8)
    out = out + (int64(BytesGet(data, offset + 2) & 255) << 16)
    out = out + (int64(BytesGet(data, offset + 3) & 255) << 24)
    out = out + (int64(BytesGet(data, offset + 4) & 255) << 32)
    out = out + (int64(BytesGet(data, offset + 5) & 255) << 40)
    out = out + (int64(BytesGet(data, offset + 6) & 255) << 48)
    out = out + (int64(BytesGet(data, offset + 7) & 255) << 56)
    return out

fn depinInferenceWriteI64LE(buf: var Bytes, offset: int32, value: int64) =
    BytesSet(buf, offset, int32(value & int64(255)))
    BytesSet(buf, offset + 1, int32((value >> 8) & int64(255)))
    BytesSet(buf, offset + 2, int32((value >> 16) & int64(255)))
    BytesSet(buf, offset + 3, int32((value >> 24) & int64(255)))
    BytesSet(buf, offset + 4, int32((value >> 32) & int64(255)))
    BytesSet(buf, offset + 5, int32((value >> 40) & int64(255)))
    BytesSet(buf, offset + 6, int32((value >> 48) & int64(255)))
    BytesSet(buf, offset + 7, int32((value >> 56) & int64(255)))

fn depinInferenceDecodeWireFrame(data: Bytes): Result[DepinInferenceWireFrame] =
    if BytesLen(data) != depinInferenceWireFrameBytes:
        return Err[DepinInferenceWireFrame]("depin inference wire: frame length")
    return Ok[DepinInferenceWireFrame](DepinInferenceWireFrame(
        magic: depinInferenceReadI64LE(data, 0),
        frameKind: depinInferenceReadI64LE(data, 8),
        enginePlanHash: depinInferenceReadI64LE(data, 16),
        seqNo: depinInferenceReadI64LE(data, 24),
        coordinatorPeerHash: depinInferenceReadI64LE(data, 32),
        sourcePeerHash: depinInferenceReadI64LE(data, 40),
        targetPeerHash: depinInferenceReadI64LE(data, 48),
        shardNameHash: depinInferenceReadI64LE(data, 56),
        requestHash: depinInferenceReadI64LE(data, 64),
        responseHash: depinInferenceReadI64LE(data, 72),
        envelopeHash: depinInferenceReadI64LE(data, 80),
        payloadHash: depinInferenceReadI64LE(data, 88),
        receiptHash: depinInferenceReadI64LE(data, 96),
        sentAtNs: depinInferenceReadI64LE(data, 104),
        frameHash: depinInferenceReadI64LE(data, 112)
    ))

fn depinInferenceValidateWireFrame(frame: DepinInferenceWireFrame): Result[bool] =
    if frame.magic != int64(depinInferenceWireFrameMagic):
        return Err[bool]("depin inference wire: magic")
    if frame.frameKind != int64(depinInferenceWireFrameKindRequest) &&
       frame.frameKind != int64(depinInferenceWireFrameKindResponse):
        return Err[bool]("depin inference wire: frame kind")
    if frame.enginePlanHash <= int64(0) || frame.seqNo < int64(0):
        return Err[bool]("depin inference wire: plan sequence")
    if frame.coordinatorPeerHash <= int64(0) || frame.sourcePeerHash <= int64(0) ||
       frame.targetPeerHash <= int64(0) || frame.shardNameHash <= int64(0):
        return Err[bool]("depin inference wire: identity hashes")
    if frame.requestHash <= int64(0) || frame.payloadHash <= int64(0) ||
       frame.sentAtNs <= int64(0) || frame.frameHash <= int64(0):
        return Err[bool]("depin inference wire: common hashes")
    if frame.frameKind == int64(depinInferenceWireFrameKindRequest):
        if frame.responseHash != int64(0) || frame.envelopeHash != int64(0) ||
           frame.receiptHash != int64(0):
            return Err[bool]("depin inference wire: request carries response fields")
    if frame.frameKind == int64(depinInferenceWireFrameKindResponse):
        if frame.responseHash <= int64(0) || frame.envelopeHash <= int64(0) ||
           frame.receiptHash <= int64(0):
            return Err[bool]("depin inference wire: response fields")
    return Ok[bool](true)

fn depinInferenceValidateWireFrameBytes(data: Bytes): Result[bool] =
    let frameRes = depinInferenceDecodeWireFrame(data)
    if IsErr(frameRes):
        return Err[bool](Error(frameRes))
    return depinInferenceValidateWireFrame(Value(frameRes))

fn depinInferenceEncodeWireFrame(frame: DepinInferenceWireFrame): Result[Bytes] =
    let validateRes: Result[bool] = depinInferenceValidateWireFrame(frame)
    if IsErr(validateRes):
        return Err[Bytes](Error(validateRes))
    var out: Bytes = BytesAlloc(depinInferenceWireFrameBytes)
    depinInferenceWriteI64LE(out, 0, frame.magic)
    depinInferenceWriteI64LE(out, 8, frame.frameKind)
    depinInferenceWriteI64LE(out, 16, frame.enginePlanHash)
    depinInferenceWriteI64LE(out, 24, frame.seqNo)
    depinInferenceWriteI64LE(out, 32, frame.coordinatorPeerHash)
    depinInferenceWriteI64LE(out, 40, frame.sourcePeerHash)
    depinInferenceWriteI64LE(out, 48, frame.targetPeerHash)
    depinInferenceWriteI64LE(out, 56, frame.shardNameHash)
    depinInferenceWriteI64LE(out, 64, frame.requestHash)
    depinInferenceWriteI64LE(out, 72, frame.responseHash)
    depinInferenceWriteI64LE(out, 80, frame.envelopeHash)
    depinInferenceWriteI64LE(out, 88, frame.payloadHash)
    depinInferenceWriteI64LE(out, 96, frame.receiptHash)
    depinInferenceWriteI64LE(out, 104, frame.sentAtNs)
    depinInferenceWriteI64LE(out, 112, frame.frameHash)
    return Ok[Bytes](out)

fn DepinInferenceDecodeWireFrame(data: Bytes): Result[DepinInferenceWireFrame] =
    return depinInferenceDecodeWireFrame(data)

fn DepinInferenceValidateWireFrameBytes(data: Bytes): Result[bool] =
    return depinInferenceValidateWireFrameBytes(data)

fn DepinInferenceEncodeWireFrame(frame: DepinInferenceWireFrame): Result[Bytes] =
    return depinInferenceEncodeWireFrame(frame)

fn DepinInferencePipelineHandleFrameBytes(frameBytes: Bytes): Result[bool] =
    let validateRes: Result[bool] = depinInferenceValidateWireFrameBytes(frameBytes)
    if IsErr(validateRes):
        return Err[bool](Error(validateRes))
    return Ok[bool](true)

fn depinInferencePipelineHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let frameRes: Result[Bytes] = readLp(streamVar, depinInferenceWireFrameBytes)
    if IsErr(frameRes):
        return Err[bool](Error(frameRes))
    return DepinInferencePipelineHandleFrameBytes(Value(frameRes))

fn DepinInferencePipelineHandler(stream: Stream): Result[bool] =
    return depinInferencePipelineHandler(stream)

fn depinInferencePipelineProtocol(): Lp2pProtocol =
    return newProtocol(depinInferencePipelineCodec(), depinInferencePipelineHandler)

fn DepinInferencePipelineProtocol(): Lp2pProtocol =
    return depinInferencePipelineProtocol()
