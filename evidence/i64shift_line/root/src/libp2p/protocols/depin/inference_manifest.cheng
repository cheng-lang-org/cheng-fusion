# DePIN inference core types + manifest model.

import cheng/libp2p/utils/result
import std/times
import std/strings
import std/strutils
import cheng/inference/parallel_plan
import cheng/inference/kernel_ir
import cheng/inference/paged_kv_cache
import cheng/inference/moe_router

const
    depinInferenceProtocolCodec = "/cheng/depin/inference/1.0.0"
    depinInferenceDistributedManifestSchema = "cheng.depin.inference.distributed_manifest.v3"
    depinInferenceDefaultHiddenStateFrameBytes = 8192
    depinInferenceDefaultSpecDraftWindow = 5
    depinInferenceDefaultAuditBaseBps = 100
    depinInferenceDefaultAuditHighRiskBps = 1000

type
    DepinInferenceConfig =
        hiddenStateFrameBytes: int32
        stageTimeoutMs: int32
        specDraftWindow: int32
        auditBaseBps: int32
        auditHighRiskBps: int32
        mmapReadonlyPreferred: bool

    DepinInferenceRequest =
        requestId: str
        modelCid: str
        promptRef: str
        layerCids: str[]
        preferredPeers: str[]
        riskLevel: str

    DepinWeightShard =
        cid: str
        cachePath: str
        sizeBytes: int64

    DepinWeightManifest =
        modelCid: str
        cacheDir: str
        shards: DepinWeightShard[]
        createdAtMs: int64

    DepinDistributedInferenceManifest =
        schema: str
        modelCid: str
        partitionPlanCid: str
        tensorShardCids: str[]
        expertShardCids: str[]
        kernelProgramCids: str[]
        weightDeviceBindingCid: str
        kvPageTableCid: str
        kvStateCid: str
        kvShardReceiptCid: str
        kvPageTransferEvidenceCid: str
        specDecodeCid: str
        routerPlanCid: str
        requestSetHash: int64
        transportFrameSetHash: int64
        evidenceHash: int64
        createdAtMs: int64
        manifestHash: int64

    DepinInferenceSession =
        sessionId: str
        request: DepinInferenceRequest
        config: DepinInferenceConfig
        started: bool
        finished: bool
        failed: bool
        failureReason: str
        stageIndex: int32
        expectedSeqNo: uint64
        lastStageAtMs: int64
        acceptedPrefixLen: int32
        rollbackFrom: int32
        specDecodeCertifiedReceiptHash: int64
        auditSampleBps: int32
        settlementTxHash: str
        challengeTxHash: str
        kvResidencyStoreHash: int64
        kvResidencyStoreOperationHash: int64
        kvResidencyWalRecordHash: int64
        kvResidencyWalLogHash: int64
        kvResidencyWalAppendHash: int64
        kvResidencyServiceCommitHash: int64
        kvResidencyServiceApplyHash: int64

fn depinInferenceNowMs(): int64 =
    return EpochTimeNs() / 1000000

fn DepinInferenceNowMs(): int64 =
    return depinInferenceNowMs()

fn depinInferenceHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1048583) + value + int64(131)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

fn depinInferenceHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    var textLen: int32
    textLen = text.len
    for i in 0..<textLen:
        h = depinInferenceHashStep(h, int64(Int32(text[i])))
    return h

fn depinInferenceHashTextSeq(hashRaw: int64, items: str[]): int64 =
    var h: int64 = hashRaw
    var itemCount: int32
    itemCount = items.len
    h = depinInferenceHashStep(h, int64(itemCount))
    for i in 0..<itemCount:
        h = depinInferenceHashTextWith(h, items[i])
    return h

fn depinCloneStrSeq(items: str[]): str[] =
    var out: str[]
    var itemCount: int32
    itemCount = items.len
    for i in 0..<itemCount:
        add(out, items[i])
    return out

fn depinTensorShardCid(partitionPlanCid: str, shard: parallel_plan.TensorParallelShard): str =
    return strutils.Join([
        "cid:tensor:",
        partitionPlanCid,
        ":",
        strings.IntToStr(shard.shardId),
        ":",
        shard.axis,
        ":",
        strings.IntToStr(shard.start),
        ":",
        strings.IntToStr(shard.count),
        ":",
        shard.peerId
    ], "")

fn depinKernelProgramCid(program: kernel_ir.KernelProgram): str =
    return strutils.Join([
        "cid:kernel:",
        program.programName,
        ":",
        strings.Int64ToStr(program.kernelHash)
    ], "")

fn depinWeightDeviceBindingCid(bindingHash: int64): str =
    return strutils.Join([
        "cid:weight_device_binding:",
        strings.Int64ToStr(bindingHash)
    ], "")

fn depinKvPageTableCid(receipt: paged_kv_cache.PagedKVReceipt): str =
    return strutils.Join([
        "cid:kv:pagetable:",
        strings.Int64ToStr(receipt.pageTableHash)
    ], "")

fn depinKvStateCid(kvStateHash: int64): str =
    return strutils.Join([
        "cid:kv:state:",
        strings.Int64ToStr(kvStateHash)
    ], "")

fn depinKvShardReceiptCid(kvShardReceiptSetHash: int64): str =
    return strutils.Join([
        "cid:kv:shard_receipt:",
        strings.Int64ToStr(kvShardReceiptSetHash)
    ], "")

fn depinKvPageTransferEvidenceCid(kvPageTransferEvidenceHash: int64): str =
    return strutils.Join([
        "cid:kv:page_transfer_evidence:",
        strings.Int64ToStr(kvPageTransferEvidenceHash)
    ], "")

fn depinSpecDecodeCid(specDecodePlanHash: int64): str =
    return strutils.Join([
        "cid:specdecode:",
        strings.Int64ToStr(specDecodePlanHash)
    ], "")

fn depinSpecDecodeDisabledCid(): str =
    return "cid:specdecode:none"

fn depinRouterPlanCid(plan: moe_router.MoeRoutePlan): str =
    return strutils.Join([
        "cid:router:",
        strings.Int64ToStr(plan.routeHash)
    ], "")

fn depinRouterPlanSetCid(set: moe_router.MoeRoutePlanSet): str =
    return strutils.Join([
        "cid:router_set:",
        strings.Int64ToStr(set.routeSetHash)
    ], "")

fn depinTensorShardCids(partition: parallel_plan.InferencePartitionPlan): str[] =
    var out: str[]
    for i in 0..<partition.tensorShards.len:
        add(out, depinTensorShardCid(partition.planCid, partition.tensorShards[i]))
    return out

fn depinExpertShardCids(partition: parallel_plan.InferencePartitionPlan): str[] =
    var out: str[]
    for i in 0..<partition.expertShards.len:
        add(out, partition.expertShards[i].shardCid)
    return out

fn depinKernelProgramCids(programs: kernel_ir.KernelProgram[]): str[] =
    var out: str[]
    for i in 0..<programs.len:
        add(out, depinKernelProgramCid(programs[i]))
    return out

fn depinStrSeqEqual(left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

fn depinValidateCidSeq(label: str, items: str[]): Result[bool] =
    var itemCount: int32
    itemCount = items.len
    if itemCount <= 0:
        return Err[bool](label)
    for i in 0..<itemCount:
        if items[i] == "":
            return Err[bool](label)
        for j in i + 1..<itemCount:
            if items[i] == items[j]:
                return Err[bool](label)
    return Ok[bool](true)

fn depinDistributedManifestHash(manifest: DepinDistributedInferenceManifest): int64 =
    var h: int64 = int64(131)
    h = depinInferenceHashTextWith(h, manifest.schema)
    h = depinInferenceHashTextWith(h, manifest.modelCid)
    h = depinInferenceHashTextWith(h, manifest.partitionPlanCid)
    h = depinInferenceHashTextSeq(h, manifest.tensorShardCids)
    h = depinInferenceHashTextSeq(h, manifest.expertShardCids)
    h = depinInferenceHashTextSeq(h, manifest.kernelProgramCids)
    h = depinInferenceHashTextWith(h, manifest.weightDeviceBindingCid)
    h = depinInferenceHashTextWith(h, manifest.kvPageTableCid)
    h = depinInferenceHashTextWith(h, manifest.kvStateCid)
    h = depinInferenceHashTextWith(h, manifest.kvShardReceiptCid)
    h = depinInferenceHashTextWith(h, manifest.kvPageTransferEvidenceCid)
    h = depinInferenceHashTextWith(h, manifest.specDecodeCid)
    h = depinInferenceHashTextWith(h, manifest.routerPlanCid)
    h = depinInferenceHashStep(h, manifest.requestSetHash)
    h = depinInferenceHashStep(h, manifest.transportFrameSetHash)
    h = depinInferenceHashStep(h, manifest.evidenceHash)
    h = depinInferenceHashStep(h, manifest.createdAtMs)
    return h

fn depinBuildDistributedManifest(modelCid: str,
                                 partitionPlanCid: str,
                                 tensorShardCids: str[],
                                 expertShardCids: str[],
                                 kernelProgramCids: str[],
                                 weightDeviceBindingCid: str,
                                 kvPageTableCid: str,
                                 kvStateCid: str,
                                 kvShardReceiptCid: str,
                                 kvPageTransferEvidenceCid: str,
                                 specDecodeCid: str,
                                 routerPlanCid: str,
                                 requestSetHash: int64,
                                 transportFrameSetHash: int64,
                                 evidenceHash: int64,
                                 createdAtMs: int64): DepinDistributedInferenceManifest =
    var manifest = DepinDistributedInferenceManifest(
        schema: depinInferenceDistributedManifestSchema,
        modelCid: modelCid,
        partitionPlanCid: partitionPlanCid,
        tensorShardCids: depinCloneStrSeq(tensorShardCids),
        expertShardCids: depinCloneStrSeq(expertShardCids),
        kernelProgramCids: depinCloneStrSeq(kernelProgramCids),
        weightDeviceBindingCid: weightDeviceBindingCid,
        kvPageTableCid: kvPageTableCid,
        kvStateCid: kvStateCid,
        kvShardReceiptCid: kvShardReceiptCid,
        kvPageTransferEvidenceCid: kvPageTransferEvidenceCid,
        specDecodeCid: specDecodeCid,
        routerPlanCid: routerPlanCid,
        requestSetHash: requestSetHash,
        transportFrameSetHash: transportFrameSetHash,
        evidenceHash: evidenceHash,
        createdAtMs: createdAtMs,
        manifestHash: int64(0)
    )
    manifest.manifestHash = depinDistributedManifestHash(manifest)
    return manifest

fn DepinBuildDistributedManifest(modelCid: str,
                                 partitionPlanCid: str,
                                 tensorShardCids: str[],
                                 expertShardCids: str[],
                                 kernelProgramCids: str[],
                                 weightDeviceBindingCid: str,
                                 kvPageTableCid: str,
                                 kvStateCid: str,
                                 kvShardReceiptCid: str,
                                 kvPageTransferEvidenceCid: str,
                                 routerPlanCid: str,
                                 requestSetHash: int64,
                                 transportFrameSetHash: int64,
                                 evidenceHash: int64,
                                 createdAtMs: int64): DepinDistributedInferenceManifest =
    return depinBuildDistributedManifest(
        modelCid,
        partitionPlanCid,
        tensorShardCids,
        expertShardCids,
        kernelProgramCids,
        weightDeviceBindingCid,
        kvPageTableCid,
        kvStateCid,
        kvShardReceiptCid,
        kvPageTransferEvidenceCid,
        depinSpecDecodeDisabledCid(),
        routerPlanCid,
        requestSetHash,
        transportFrameSetHash,
        evidenceHash,
        createdAtMs
    )

fn DepinBuildDistributedManifestFromPlanFacts(modelCid: str,
                                              partition: parallel_plan.InferencePartitionPlan,
                                              kernelPrograms: kernel_ir.KernelProgram[],
                                              deviceWeightBindingHash: int64,
                                              kvReceipt: paged_kv_cache.PagedKVReceipt,
                                              kvStateHash: int64,
                                              kvShardReceiptSetHash: int64,
                                              kvPageTransferEvidenceHash: int64,
                                              specDecodePlanHash: int64,
                                              routePlanSet: moe_router.MoeRoutePlanSet,
                                              requestSetHash: int64,
                                              transportFrameSetHash: int64,
                                              evidenceHash: int64,
                                              createdAtMs: int64): DepinDistributedInferenceManifest =
    return depinBuildDistributedManifest(
        modelCid,
        partition.planCid,
        depinTensorShardCids(partition),
        depinExpertShardCids(partition),
        depinKernelProgramCids(kernelPrograms),
        depinWeightDeviceBindingCid(deviceWeightBindingHash),
        depinKvPageTableCid(kvReceipt),
        depinKvStateCid(kvStateHash),
        depinKvShardReceiptCid(kvShardReceiptSetHash),
        depinKvPageTransferEvidenceCid(kvPageTransferEvidenceHash),
        depinSpecDecodeCid(specDecodePlanHash),
        depinRouterPlanSetCid(routePlanSet),
        requestSetHash,
        transportFrameSetHash,
        evidenceHash,
        createdAtMs
    )

fn depinValidateDistributedManifest(manifest: DepinDistributedInferenceManifest): Result[bool] =
    if manifest.schema != depinInferenceDistributedManifestSchema:
        return Err[bool]("depin distributed manifest: schema")
    if manifest.modelCid == "" || manifest.partitionPlanCid == "" ||
       manifest.weightDeviceBindingCid == "" ||
       manifest.kvPageTableCid == "" || manifest.kvStateCid == "" ||
       manifest.kvShardReceiptCid == "" ||
       manifest.kvPageTransferEvidenceCid == "" ||
       manifest.specDecodeCid == "" || manifest.routerPlanCid == "":
        return Err[bool]("depin distributed manifest: identity")
    let tensorOk = depinValidateCidSeq("depin distributed manifest: tensor shards", manifest.tensorShardCids)
    if IsErr(tensorOk):
        return Err[bool](Error(tensorOk))
    let expertOk = depinValidateCidSeq("depin distributed manifest: expert shards", manifest.expertShardCids)
    if IsErr(expertOk):
        return Err[bool](Error(expertOk))
    let kernelOk = depinValidateCidSeq("depin distributed manifest: kernels", manifest.kernelProgramCids)
    if IsErr(kernelOk):
        return Err[bool](Error(kernelOk))
    if manifest.requestSetHash <= int64(0) ||
       manifest.transportFrameSetHash <= int64(0) ||
       manifest.evidenceHash <= int64(0) ||
       manifest.createdAtMs <= int64(0):
        return Err[bool]("depin distributed manifest: hashes")
    if depinDistributedManifestHash(manifest) != manifest.manifestHash:
        return Err[bool]("depin distributed manifest: hash mismatch")
    return Ok[bool](true)

fn DepinValidateDistributedManifest(manifest: DepinDistributedInferenceManifest): Result[bool] =
    return depinValidateDistributedManifest(manifest)

fn DepinValidateDistributedManifestPlanFacts(manifest: DepinDistributedInferenceManifest,
                                             partition: parallel_plan.InferencePartitionPlan,
                                             kernelPrograms: kernel_ir.KernelProgram[],
                                             deviceWeightBindingHash: int64,
                                             kvReceipt: paged_kv_cache.PagedKVReceipt,
                                             kvStateHash: int64,
                                             kvShardReceiptSetHash: int64,
                                             kvPageTransferEvidenceHash: int64,
                                             specDecodePlanHash: int64,
                                             routePlanSet: moe_router.MoeRoutePlanSet): Result[bool] =
    let manifestOk = depinValidateDistributedManifest(manifest)
    if IsErr(manifestOk):
        return Err[bool](Error(manifestOk))
    let partitionOk = parallel_plan.ParallelValidatePlan(partition)
    if IsErr(partitionOk):
        return Err[bool](Error(partitionOk))
    if manifest.partitionPlanCid != partition.planCid:
        return Err[bool]("depin distributed manifest: partition plan binding")
    let expectedTensorCids = depinTensorShardCids(partition)
    if !depinStrSeqEqual(manifest.tensorShardCids, expectedTensorCids):
        return Err[bool]("depin distributed manifest: tensor shard binding")
    let expectedExpertCids = depinExpertShardCids(partition)
    if !depinStrSeqEqual(manifest.expertShardCids, expectedExpertCids):
        return Err[bool]("depin distributed manifest: expert shard binding")
    if kernelPrograms.len <= 0:
        return Err[bool]("depin distributed manifest: empty kernels")
    for i in 0..<kernelPrograms.len:
        let kernelOk = kernel_ir.KernelIrValidateProgram(kernelPrograms[i])
        if IsErr(kernelOk):
            return Err[bool](Error(kernelOk))
    let expectedKernelCids = depinKernelProgramCids(kernelPrograms)
    if !depinStrSeqEqual(manifest.kernelProgramCids, expectedKernelCids):
        return Err[bool]("depin distributed manifest: kernel binding")
    if deviceWeightBindingHash <= int64(0) || manifest.weightDeviceBindingCid != depinWeightDeviceBindingCid(deviceWeightBindingHash):
        return Err[bool]("depin distributed manifest: weight device binding")
    if kvReceipt.pageTableHash <= int64(0) || manifest.kvPageTableCid != depinKvPageTableCid(kvReceipt):
        return Err[bool]("depin distributed manifest: kv binding")
    if kvStateHash <= int64(0) || manifest.kvStateCid != depinKvStateCid(kvStateHash):
        return Err[bool]("depin distributed manifest: kv state binding")
    if kvShardReceiptSetHash <= int64(0) || manifest.kvShardReceiptCid != depinKvShardReceiptCid(kvShardReceiptSetHash):
        return Err[bool]("depin distributed manifest: kv shard receipt binding")
    if kvPageTransferEvidenceHash <= int64(0) ||
       manifest.kvPageTransferEvidenceCid != depinKvPageTransferEvidenceCid(kvPageTransferEvidenceHash):
        return Err[bool]("depin distributed manifest: kv page transfer evidence binding")
    if specDecodePlanHash <= int64(0) || manifest.specDecodeCid != depinSpecDecodeCid(specDecodePlanHash):
        return Err[bool]("depin distributed manifest: spec decode binding")
    let routeOk = moe_router.MoeValidateRoutePlanSet(routePlanSet)
    if IsErr(routeOk):
        return Err[bool](Error(routeOk))
    if manifest.routerPlanCid != depinRouterPlanSetCid(routePlanSet):
        return Err[bool]("depin distributed manifest: router binding")
    return Ok[bool](true)

fn initDepinInferenceConfig(): DepinInferenceConfig =
    return DepinInferenceConfig(
        hiddenStateFrameBytes: depinInferenceDefaultHiddenStateFrameBytes,
        stageTimeoutMs: 30000,
        specDraftWindow: depinInferenceDefaultSpecDraftWindow,
        auditBaseBps: depinInferenceDefaultAuditBaseBps,
        auditHighRiskBps: depinInferenceDefaultAuditHighRiskBps,
        mmapReadonlyPreferred: true
    )

fn initDepinInferenceRequest(): DepinInferenceRequest =
    return DepinInferenceRequest(
        requestId: "",
        modelCid: "",
        promptRef: "",
        layerCids: [],
        preferredPeers: [],
        riskLevel: "base"
    )

fn depinInferenceInitSession(reqRaw: DepinInferenceRequest, cfgRaw: DepinInferenceConfig): DepinInferenceSession =
    var reqLayerCids: str[]
    var layerCount: int32
    layerCount = reqRaw.layerCids.len
    for i in 0..<layerCount:
        add(reqLayerCids, reqRaw.layerCids[i])
    var reqPreferredPeers: str[]
    var preferredCount: int32
    preferredCount = reqRaw.preferredPeers.len
    for i in 0..<preferredCount:
        add(reqPreferredPeers, reqRaw.preferredPeers[i])

    var requestId: str = reqRaw.requestId
    if requestId == "":
        requestId = "req:auto"
    var hiddenStateFrameBytes: int32 = cfgRaw.hiddenStateFrameBytes
    if hiddenStateFrameBytes <= 0:
        hiddenStateFrameBytes = depinInferenceDefaultHiddenStateFrameBytes
    var stageTimeoutMs: int32 = cfgRaw.stageTimeoutMs
    if stageTimeoutMs <= 0:
        stageTimeoutMs = 30000
    var specDraftWindow: int32 = cfgRaw.specDraftWindow
    if specDraftWindow <= 0:
        specDraftWindow = depinInferenceDefaultSpecDraftWindow
    var auditBaseBps: int32 = cfgRaw.auditBaseBps
    if auditBaseBps <= 0:
        auditBaseBps = depinInferenceDefaultAuditBaseBps
    var auditHighRiskBps: int32 = cfgRaw.auditHighRiskBps
    if auditHighRiskBps <= 0:
        auditHighRiskBps = depinInferenceDefaultAuditHighRiskBps

    let req: DepinInferenceRequest = DepinInferenceRequest(
        requestId: requestId,
        modelCid: reqRaw.modelCid,
        promptRef: reqRaw.promptRef,
        layerCids: reqLayerCids,
        preferredPeers: reqPreferredPeers,
        riskLevel: reqRaw.riskLevel
    )
    let cfg: DepinInferenceConfig = DepinInferenceConfig(
        hiddenStateFrameBytes: hiddenStateFrameBytes,
        stageTimeoutMs: stageTimeoutMs,
        specDraftWindow: specDraftWindow,
        auditBaseBps: auditBaseBps,
        auditHighRiskBps: auditHighRiskBps,
        mmapReadonlyPreferred: cfgRaw.mmapReadonlyPreferred
    )
    return DepinInferenceSession(
        sessionId: strutils.Join([req.requestId, ":session"], ""),
        request: req,
        config: cfg,
        started: false,
        finished: false,
        failed: false,
        failureReason: "",
        stageIndex: 0,
        expectedSeqNo: uint64(0),
        lastStageAtMs: 0,
        acceptedPrefixLen: 0,
        rollbackFrom: 0,
        specDecodeCertifiedReceiptHash: int64(0),
        auditSampleBps: cfg.auditBaseBps,
        settlementTxHash: "",
        challengeTxHash: "",
        kvResidencyStoreHash: int64(0),
        kvResidencyStoreOperationHash: int64(0),
        kvResidencyWalRecordHash: int64(0),
        kvResidencyWalLogHash: int64(0),
        kvResidencyWalAppendHash: int64(0),
        kvResidencyServiceCommitHash: int64(0),
        kvResidencyServiceApplyHash: int64(0)
    )

fn DepinInferenceInitSession(reqRaw: DepinInferenceRequest, cfgRaw: DepinInferenceConfig): DepinInferenceSession =
    return depinInferenceInitSession(reqRaw, cfgRaw)

fn DepinBuildStartedInferenceSession(requestId: str,
                                     modelCid: str,
                                     promptRef: str,
                                     riskLevel: str): DepinInferenceSession =
    var layerCids: str[]
    var preferredPeers: str[]
    let req = DepinInferenceRequest(
        requestId: requestId,
        modelCid: modelCid,
        promptRef: promptRef,
        layerCids: layerCids,
        preferredPeers: preferredPeers,
        riskLevel: riskLevel
    )
    let cfg = initDepinInferenceConfig()
    var session = depinInferenceInitSession(req, cfg)
    session.started = true
    return session

fn depinBuildWeightManifest(modelCid: str, layerCids: str[], cacheDir: str): DepinWeightManifest =
    var shards: DepinWeightShard[]
    var layerCount: int32
    layerCount = layerCids.len
    for i in 0..<layerCount:
        let cid: str = layerCids[i]
        add(shards, DepinWeightShard(
            cid: cid,
            cachePath: strutils.Join([cacheDir, "/", cid, ".blk"], ""),
            sizeBytes: 0
        ))
    return DepinWeightManifest(
        modelCid: modelCid,
        cacheDir: cacheDir,
        shards: shards,
        createdAtMs: depinInferenceNowMs()
    )

fn depinManifestShardCids(manifest: DepinWeightManifest): str[] =
    var out: str[]
    var shardCount: int32
    shardCount = manifest.shards.len
    for i in 0..<shardCount:
        add(out, manifest.shards[i].cid)
    return out
