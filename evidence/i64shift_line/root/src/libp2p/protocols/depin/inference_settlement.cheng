# DePIN inference settlement bridge (local dispatcher closed-loop).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/strings
import std/strutils as strutil
import std/rawbytes
import std/os
import cheng/libp2p/protocols/depin/inference_manifest
import cheng/libp2p/protocols/depin/inference_audit
import cheng/libp2p/protocols/depin/rwad_dispatcher_adapter

const
    DepinSettlementLedgerRecordSchema = "cheng.depin.inference.settlement_ledger_record.v1"
    DepinSettlementLedgerSchema = "cheng.depin.inference.settlement_ledger.v1"
    DepinSettlementLedgerFileReceiptSchema = "cheng.depin.inference.settlement_ledger_file_receipt.v1"
    DepinSettlementLedgerReplicaReceiptSchema = "cheng.depin.inference.settlement_ledger_replica_receipt.v1"
    DepinSettlementLedgerFileMagic = 2026062606
    DepinSettlementLedgerFileVersion = 1
    DepinSettlementLedgerFileHeaderWordCount = 10
    DepinSettlementLedgerFileRecordWordCount = 22
    DepinSettlementLedgerReplicaFileMagic = 2026062607
    DepinSettlementLedgerReplicaFileVersion = 1
    DepinSettlementLedgerReplicaFileWordCount = 13
    DepinSettlementLedgerAnchorReceiptSchema = "cheng.depin.inference.settlement_ledger_anchor_receipt.v1"
    DepinSettlementLedgerAnchorFileMagic = 2026062608
    DepinSettlementLedgerAnchorFileVersion = 1
    DepinSettlementLedgerAnchorFileWordCount = 11

type
    DepinSettlementPlan =
        batchId: str
        jobId: str
        executor: str
        escrowId: str
        challengePenalty: int64
        replicaPeers: str[]
        replicaQuorum: int32
        replicaMaxAttempts: int32

    DepinSettlementLedgerRecord =
        schema: str
        recordSeq: int32
        previousRecordHash: int64
        kindHash: int64
        txTypeHash: int64
        txHashHash: int64
        payloadHash: int64
        planHash: int64
        sessionProofHash: int64
        chainHash: int64
        senderHash: int64
        submitTxHashHash: int64
        reasonHash: int64
        proofHash: int64
        recordedAtNs: int64
        kvResidencyStoreHash: int64
        kvResidencyStoreOperationHash: int64
        kvResidencyWalRecordHash: int64
        kvResidencyWalLogHash: int64
        kvResidencyWalAppendHash: int64
        kvResidencyServiceCommitHash: int64
        kvResidencyServiceApplyHash: int64
        recordHash: int64

    DepinSettlementLedger =
        schema: str
        chainHash: int64
        senderHash: int64
        batchHash: int64
        sessionHash: int64
        recordCount: int32
        headRecordHash: int64
        recordSetHash: int64
        ledgerHash: int64
        records: DepinSettlementLedgerRecord[]

    DepinSettlementLedgerFileReceipt =
        schema: str
        path: str
        chainHash: int64
        senderHash: int64
        batchHash: int64
        sessionHash: int64
        recordCount: int32
        headRecordHash: int64
        recordSetHash: int64
        ledgerHash: int64
        byteCount: int32
        byteHash: int64
        receiptHash: int64

    DepinSettlementLedgerFileRead =
        ledger: DepinSettlementLedger
        receipt: DepinSettlementLedgerFileReceipt

    DepinSettlementLedgerReplicaReceipt =
        schema: str
        path: str
        sourcePeerHash: int64
        targetPeerHash: int64
        ledgerHash: int64
        ledgerReceiptHash: int64
        ledgerByteHash: int64
        ledgerByteCount: int32
        ledgerRecordCount: int32
        ledgerHeadRecordHash: int64
        ledgerRecordSetHash: int64
        requestFrameHash: int64
        replicatedAtNs: int64
        byteCount: int32
        byteHash: int64
        receiptHash: int64

    DepinSettlementLedgerAnchorReceipt =
        schema: str
        path: str
        ledgerHash: int64
        ledgerReceiptHash: int64
        chainHash: int64
        anchorTxHash: int64
        anchorBlockNumber: int64
        blockConfirmations: int32
        anchorTimestampNs: int64
        submitterPeerHash: int64
        submissionByteHash: int64
        byteCount: int32
        byteHash: int64
        receiptHash: int64

fn DepinSettlementPlanBuild(batchId: str,
                            jobId: str,
                            executor: str,
                            escrowId: str,
                            challengePenalty: int64): DepinSettlementPlan =
    return DepinSettlementPlanBuildWithReplicas(
        batchId,
        jobId,
        executor,
        escrowId,
        challengePenalty,
        [executor],
        1,
        1
    )

fn DepinSettlementPlanBuildWithReplicas(batchId: str,
                                        jobId: str,
                                        executor: str,
                                        escrowId: str,
                                        challengePenalty: int64,
                                        replicaPeers: str[],
                                        replicaQuorum: int32,
                                        replicaMaxAttempts: int32): DepinSettlementPlan =
    return DepinSettlementPlan(
        batchId: batchId,
        jobId: jobId,
        executor: executor,
        escrowId: escrowId,
        challengePenalty: challengePenalty,
        replicaPeers: replicaPeers,
        replicaQuorum: replicaQuorum,
        replicaMaxAttempts: replicaMaxAttempts
    )

fn depinSettlementHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1048583) + value + int64(131)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn depinSettlementHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<text.len:
        h = depinSettlementHashStep(h, int64(Int32(text[i])))
    return h

fn DepinSettlementTextHash(text: str): int64 =
    return depinSettlementHashTextWith(int64(211), text)

fn DepinSettlementValidatePlan(plan: DepinSettlementPlan): Result[bool] =
    if plan.batchId == "" ||
       plan.jobId == "" ||
       plan.executor == "" ||
       plan.escrowId == "" ||
       plan.challengePenalty <= int64(0) ||
       plan.replicaPeers.len <= 0 ||
       plan.replicaQuorum <= 0 ||
       plan.replicaQuorum > plan.replicaPeers.len ||
       plan.replicaMaxAttempts <= 0:
        return Err[bool]("depin settlement plan: fields")
    var executorFound = false
    for i in 0..<plan.replicaPeers.len:
        if plan.replicaPeers[i] == "":
            return Err[bool]("depin settlement plan: empty replica")
        if plan.replicaPeers[i] == plan.executor:
            executorFound = true
        for j in i + 1..<plan.replicaPeers.len:
            if plan.replicaPeers[i] == plan.replicaPeers[j]:
                return Err[bool]("depin settlement plan: duplicate replica")
    if !executorFound:
        return Err[bool]("depin settlement plan: executor replica")
    return Ok[bool](true)

fn DepinSettlementPlanReplicaPeerSetHash(plan: DepinSettlementPlan): int64 =
    var h: int64 = int64(229)
    h = depinSettlementHashStep(h, int64(plan.replicaPeers.len))
    h = depinSettlementHashStep(h, int64(plan.replicaQuorum))
    h = depinSettlementHashStep(h, int64(plan.replicaMaxAttempts))
    for i in 0..<plan.replicaPeers.len:
        h = depinSettlementHashTextWith(h, plan.replicaPeers[i])
    return h

fn depinSettlementHashBytesWith(hashRaw: int64, payload: Bytes): int64 =
    var h: int64 = depinSettlementHashStep(hashRaw, int64(BytesLen(payload)))
    for i in 0..<BytesLen(payload):
        h = depinSettlementHashStep(h, int64(rawbytes.BytesGet(payload, i) & 255))
    return h

fn DepinSettlementProofPayloadHash(proofPayload: Bytes): int64 =
    return depinSettlementHashBytesWith(int64(223), proofPayload)

fn DepinSettlementPlanHash(plan: DepinSettlementPlan): int64 =
    var h: int64 = int64(227)
    h = depinSettlementHashTextWith(h, plan.batchId)
    h = depinSettlementHashTextWith(h, plan.jobId)
    h = depinSettlementHashTextWith(h, plan.executor)
    h = depinSettlementHashTextWith(h, plan.escrowId)
    h = depinSettlementHashStep(h, plan.challengePenalty)
    h = depinSettlementHashStep(h, int64(plan.replicaQuorum))
    h = depinSettlementHashStep(h, int64(plan.replicaMaxAttempts))
    h = depinSettlementHashStep(h, DepinSettlementPlanReplicaPeerSetHash(plan))
    return h

fn depinPenaltyBucketText(penalty: int64): str =
    if penalty <= 0:
        return "0"
    if penalty < 100:
        return "lt100"
    if penalty < 1000:
        return "lt1000"
    return "ge1000"

fn depinProofTag(proofPayload: Bytes): str =
    if BytesLen(proofPayload) <= 0:
        return "empty"
    return "present"

fn DepinSettlementSessionProofHash(plan: DepinSettlementPlan,
                                   session: DepinInferenceSession): int64 =
    var h: int64 = DepinSettlementPlanHash(plan)
    h = depinSettlementHashTextWith(h, session.sessionId)
    h = depinSettlementHashTextWith(h, session.request.requestId)
    h = depinSettlementHashTextWith(h, session.request.modelCid)
    h = depinSettlementHashTextWith(h, session.request.riskLevel)
    h = depinSettlementHashStep(h, int64(session.stageIndex))
    h = depinSettlementHashStep(h, int64(session.acceptedPrefixLen))
    h = depinSettlementHashStep(h, session.kvResidencyStoreHash)
    h = depinSettlementHashStep(h, session.kvResidencyStoreOperationHash)
    h = depinSettlementHashStep(h, session.kvResidencyWalRecordHash)
    h = depinSettlementHashStep(h, session.kvResidencyWalLogHash)
    h = depinSettlementHashStep(h, session.kvResidencyWalAppendHash)
    h = depinSettlementHashStep(h, session.kvResidencyServiceCommitHash)
    h = depinSettlementHashStep(h, session.kvResidencyServiceApplyHash)
    return h

fn depinSettlementRequireSessionProof(session: DepinInferenceSession): Result[bool] =
    if session.sessionId == "" ||
       session.request.requestId == "" ||
       session.request.modelCid == "" ||
       session.kvResidencyStoreHash <= int64(0) ||
       session.kvResidencyStoreOperationHash <= int64(0) ||
       session.kvResidencyWalRecordHash <= int64(0) ||
       session.kvResidencyWalLogHash <= int64(0) ||
       session.kvResidencyWalAppendHash <= int64(0) ||
       session.kvResidencyServiceCommitHash <= int64(0) ||
       session.kvResidencyServiceApplyHash <= int64(0):
        return Err[bool]("depin settlement: missing session proof")
    return Ok[bool](true)

fn depinSettlementEncodeSessionProof(kind: str,
                                     plan: DepinSettlementPlan,
                                     session: DepinInferenceSession,
                                     submitTxHash: str): Result[str] =
    if kind == "" ||
       plan.batchId == "" ||
       plan.jobId == "" ||
       plan.executor == "" ||
       plan.escrowId == "":
        return Err[str]("depin settlement: payload args")
    let planOk = DepinSettlementValidatePlan(plan)
    if IsErr(planOk):
        return Err[str](Error(planOk))
    let sessionOk = depinSettlementRequireSessionProof(session)
    if IsErr(sessionOk):
        return Err[str](Error(sessionOk))
    return Ok[str](strutil.Join([
        "kind=", kind,
        "|batch=", plan.batchId,
        "|job=", plan.jobId,
        "|executor=", plan.executor,
        "|escrow=", plan.escrowId,
        "|replicaSet=", strings.Int64ToStr(DepinSettlementPlanReplicaPeerSetHash(plan)),
        "|replicaQuorum=", strings.IntToStr(plan.replicaQuorum),
        "|replicaMaxAttempts=", strings.IntToStr(plan.replicaMaxAttempts),
        "|session=", session.sessionId,
        "|request=", session.request.requestId,
        "|model=", session.request.modelCid,
        "|risk=", session.request.riskLevel,
        "|stage=", strings.IntToStr(session.stageIndex),
        "|accepted=", strings.IntToStr(session.acceptedPrefixLen),
        "|kvStore=", strings.Int64ToStr(session.kvResidencyStoreHash),
        "|kvStoreOp=", strings.Int64ToStr(session.kvResidencyStoreOperationHash),
        "|kvWalRecord=", strings.Int64ToStr(session.kvResidencyWalRecordHash),
        "|kvWalLog=", strings.Int64ToStr(session.kvResidencyWalLogHash),
        "|kvWalAppend=", strings.Int64ToStr(session.kvResidencyWalAppendHash),
        "|kvServiceCommit=", strings.Int64ToStr(session.kvResidencyServiceCommitHash),
        "|kvServiceApply=", strings.Int64ToStr(session.kvResidencyServiceApplyHash),
        "|submitTx=", submitTxHash
    ], ""))

fn depinSettlementEncodeSubmit(plan: DepinSettlementPlan,
                               session: DepinInferenceSession): Result[str] =
    return depinSettlementEncodeSessionProof("submit", plan, session, "")

fn depinSettlementEncodeFinalize(plan: DepinSettlementPlan,
                                 session: DepinInferenceSession): Result[str] =
    if session.settlementTxHash == "":
        return Err[str]("depin settlement: missing submit tx")
    return depinSettlementEncodeSessionProof("finalize", plan, session, session.settlementTxHash)

fn depinSettlementEncodeChallenge(plan: DepinSettlementPlan,
                                  session: DepinInferenceSession,
                                  auditDecision: DepinAuditDecision,
                                  reason: str,
                                  proofPayload: Bytes): Result[str] =
    if reason == "" || BytesLen(proofPayload) <= 0:
        return Err[str]("depin settlement challenge: missing proof")
    let planOk = DepinSettlementValidatePlan(plan)
    if IsErr(planOk):
        return Err[str](Error(planOk))
    let sessionOk = depinSettlementRequireSessionProof(session)
    if IsErr(sessionOk):
        return Err[str](Error(sessionOk))
    return Ok[str](strutil.Join([
        "kind=challenge",
        "|batch=", plan.batchId,
        "|job=", plan.jobId,
        "|executor=", plan.executor,
        "|escrow=", plan.escrowId,
        "|replicaSet=", strings.Int64ToStr(DepinSettlementPlanReplicaPeerSetHash(plan)),
        "|replicaQuorum=", strings.IntToStr(plan.replicaQuorum),
        "|replicaMaxAttempts=", strings.IntToStr(plan.replicaMaxAttempts),
        "|session=", session.sessionId,
        "|request=", session.request.requestId,
        "|model=", session.request.modelCid,
        "|risk=", session.request.riskLevel,
        "|sampled=", auditDecision.sampled ? "true" : "false",
        "|bps=", strings.IntToStr(auditDecision.bps),
        "|auditReason=", auditDecision.reason,
        "|challengeReason=", reason,
        "|proof=", depinProofTag(proofPayload),
        "|proofHash=", strings.Int64ToStr(DepinSettlementProofPayloadHash(proofPayload)),
        "|kvServiceApply=", strings.Int64ToStr(session.kvResidencyServiceApplyHash)
    ], ""))

fn depinSettlementRecordHash(record: DepinSettlementLedgerRecord): int64 =
    var h: int64 = int64(229)
    h = depinSettlementHashTextWith(h, record.schema)
    h = depinSettlementHashStep(h, int64(record.recordSeq))
    h = depinSettlementHashStep(h, record.previousRecordHash)
    h = depinSettlementHashStep(h, record.kindHash)
    h = depinSettlementHashStep(h, record.txTypeHash)
    h = depinSettlementHashStep(h, record.txHashHash)
    h = depinSettlementHashStep(h, record.payloadHash)
    h = depinSettlementHashStep(h, record.planHash)
    h = depinSettlementHashStep(h, record.sessionProofHash)
    h = depinSettlementHashStep(h, record.chainHash)
    h = depinSettlementHashStep(h, record.senderHash)
    h = depinSettlementHashStep(h, record.submitTxHashHash)
    h = depinSettlementHashStep(h, record.reasonHash)
    h = depinSettlementHashStep(h, record.proofHash)
    h = depinSettlementHashStep(h, record.recordedAtNs)
    h = depinSettlementHashStep(h, record.kvResidencyStoreHash)
    h = depinSettlementHashStep(h, record.kvResidencyStoreOperationHash)
    h = depinSettlementHashStep(h, record.kvResidencyWalRecordHash)
    h = depinSettlementHashStep(h, record.kvResidencyWalLogHash)
    h = depinSettlementHashStep(h, record.kvResidencyWalAppendHash)
    h = depinSettlementHashStep(h, record.kvResidencyServiceCommitHash)
    h = depinSettlementHashStep(h, record.kvResidencyServiceApplyHash)
    return h

fn depinSettlementLedgerRecordBuild(seqNo: int32,
                                    previousRecordHash: int64,
                                    kind: str,
                                    adapter: DepinRwadDispatcherAdapter,
                                    plan: DepinSettlementPlan,
                                    session: DepinInferenceSession,
                                    submitTxHash: str,
                                    reason: str,
                                    proofHash: int64,
                                    recordedAtNs: int64): Result[DepinSettlementLedgerRecord] =
    if seqNo < 0 ||
       kind == "" ||
       adapter.chainId == "" ||
       adapter.sender == "" ||
       adapter.lastTxType == "" ||
       adapter.lastTxHash == "" ||
       adapter.lastPayloadHash <= int64(0) ||
       recordedAtNs <= int64(0):
        return Err[DepinSettlementLedgerRecord]("depin settlement ledger record: args")
    if kind == "finalize" && submitTxHash == "":
        return Err[DepinSettlementLedgerRecord]("depin settlement ledger record: submit tx")
    let sessionOk = depinSettlementRequireSessionProof(session)
    if IsErr(sessionOk):
        return Err[DepinSettlementLedgerRecord](Error(sessionOk))
    var record = DepinSettlementLedgerRecord(
        schema: DepinSettlementLedgerRecordSchema,
        recordSeq: seqNo,
        previousRecordHash: previousRecordHash,
        kindHash: DepinSettlementTextHash(kind),
        txTypeHash: DepinSettlementTextHash(adapter.lastTxType),
        txHashHash: DepinSettlementTextHash(adapter.lastTxHash),
        payloadHash: adapter.lastPayloadHash,
        planHash: DepinSettlementPlanHash(plan),
        sessionProofHash: DepinSettlementSessionProofHash(plan, session),
        chainHash: DepinSettlementTextHash(adapter.chainId),
        senderHash: DepinSettlementTextHash(adapter.sender),
        submitTxHashHash: DepinSettlementTextHash(submitTxHash),
        reasonHash: DepinSettlementTextHash(reason),
        proofHash: proofHash,
        recordedAtNs: recordedAtNs,
        kvResidencyStoreHash: session.kvResidencyStoreHash,
        kvResidencyStoreOperationHash: session.kvResidencyStoreOperationHash,
        kvResidencyWalRecordHash: session.kvResidencyWalRecordHash,
        kvResidencyWalLogHash: session.kvResidencyWalLogHash,
        kvResidencyWalAppendHash: session.kvResidencyWalAppendHash,
        kvResidencyServiceCommitHash: session.kvResidencyServiceCommitHash,
        kvResidencyServiceApplyHash: session.kvResidencyServiceApplyHash,
        recordHash: int64(0)
    )
    record.recordHash = depinSettlementRecordHash(record)
    return Ok[DepinSettlementLedgerRecord](record)

fn depinSettlementValidateLedgerRecord(record: DepinSettlementLedgerRecord,
                                       expectedSeq: int32,
                                       expectedPreviousRecordHash: int64): Result[bool] =
    if record.schema != DepinSettlementLedgerRecordSchema ||
       record.recordSeq != expectedSeq ||
       record.previousRecordHash != expectedPreviousRecordHash ||
       record.kindHash <= int64(0) ||
       record.txTypeHash <= int64(0) ||
       record.txHashHash <= int64(0) ||
       record.payloadHash <= int64(0) ||
       record.planHash <= int64(0) ||
       record.sessionProofHash <= int64(0) ||
       record.chainHash <= int64(0) ||
       record.senderHash <= int64(0) ||
       record.recordedAtNs <= int64(0) ||
       record.kvResidencyStoreHash <= int64(0) ||
       record.kvResidencyStoreOperationHash <= int64(0) ||
       record.kvResidencyWalRecordHash <= int64(0) ||
       record.kvResidencyWalLogHash <= int64(0) ||
       record.kvResidencyWalAppendHash <= int64(0) ||
       record.kvResidencyServiceCommitHash <= int64(0) ||
       record.kvResidencyServiceApplyHash <= int64(0):
        return Err[bool]("depin settlement ledger record: invalid")
    if depinSettlementRecordHash(record) != record.recordHash:
        return Err[bool]("depin settlement ledger record: hash")
    return Ok[bool](true)

fn depinSettlementLedgerRecordSetHash(records: DepinSettlementLedgerRecord[]): int64 =
    if records.len <= 0:
        return int64(0)
    var h: int64 = int64(233)
    for i in 0..<records.len:
        h = depinSettlementHashStep(h, records[i].recordHash)
    return h

fn depinSettlementLedgerHash(ledger: DepinSettlementLedger): int64 =
    var h: int64 = int64(239)
    h = depinSettlementHashTextWith(h, ledger.schema)
    h = depinSettlementHashStep(h, ledger.chainHash)
    h = depinSettlementHashStep(h, ledger.senderHash)
    h = depinSettlementHashStep(h, ledger.batchHash)
    h = depinSettlementHashStep(h, ledger.sessionHash)
    h = depinSettlementHashStep(h, int64(ledger.recordCount))
    h = depinSettlementHashStep(h, ledger.headRecordHash)
    h = depinSettlementHashStep(h, ledger.recordSetHash)
    return h

fn depinSettlementLedgerBuild(chainHash: int64,
                              senderHash: int64,
                              batchHash: int64,
                              sessionHash: int64,
                              records: DepinSettlementLedgerRecord[]): Result[DepinSettlementLedger] =
    if chainHash <= int64(0) ||
       senderHash <= int64(0) ||
       batchHash <= int64(0) ||
       sessionHash <= int64(0):
        return Err[DepinSettlementLedger]("depin settlement ledger: identity")
    var expectedPrevious: int64
    for i in 0..<records.len:
        let recordOk = depinSettlementValidateLedgerRecord(records[i], i, expectedPrevious)
        if IsErr(recordOk):
            return Err[DepinSettlementLedger](Error(recordOk))
        if records[i].chainHash != chainHash ||
           records[i].senderHash != senderHash:
            return Err[DepinSettlementLedger]("depin settlement ledger: record identity")
        expectedPrevious = records[i].recordHash
    var headHash: int64
    if records.len > 0:
        headHash = records[records.len - 1].recordHash
    var ledger = DepinSettlementLedger(
        schema: DepinSettlementLedgerSchema,
        chainHash: chainHash,
        senderHash: senderHash,
        batchHash: batchHash,
        sessionHash: sessionHash,
        recordCount: records.len,
        headRecordHash: headHash,
        recordSetHash: depinSettlementLedgerRecordSetHash(records),
        ledgerHash: int64(0),
        records: records
    )
    ledger.ledgerHash = depinSettlementLedgerHash(ledger)
    return Ok[DepinSettlementLedger](ledger)

fn DepinSettlementValidateLedger(ledger: DepinSettlementLedger): Result[bool] =
    if ledger.schema != DepinSettlementLedgerSchema ||
       ledger.recordCount != ledger.records.len:
        return Err[bool]("depin settlement ledger: schema")
    let rebuilt = depinSettlementLedgerBuild(
        ledger.chainHash,
        ledger.senderHash,
        ledger.batchHash,
        ledger.sessionHash,
        ledger.records
    )
    if IsErr(rebuilt):
        return Err[bool](Error(rebuilt))
    if Value(rebuilt).headRecordHash != ledger.headRecordHash ||
       Value(rebuilt).recordSetHash != ledger.recordSetHash ||
       Value(rebuilt).ledgerHash != ledger.ledgerHash:
        return Err[bool]("depin settlement ledger: hash")
    return Ok[bool](true)

fn depinSettlementLedgerFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return depinSettlementHashBytesWith(int64(241), bytesRaw)

fn depinSettlementLedgerFileReceiptHash(receipt: DepinSettlementLedgerFileReceipt): int64 =
    var h: int64 = int64(251)
    h = depinSettlementHashTextWith(h, receipt.schema)
    h = depinSettlementHashTextWith(h, receipt.path)
    h = depinSettlementHashStep(h, receipt.chainHash)
    h = depinSettlementHashStep(h, receipt.senderHash)
    h = depinSettlementHashStep(h, receipt.batchHash)
    h = depinSettlementHashStep(h, receipt.sessionHash)
    h = depinSettlementHashStep(h, int64(receipt.recordCount))
    h = depinSettlementHashStep(h, receipt.headRecordHash)
    h = depinSettlementHashStep(h, receipt.recordSetHash)
    h = depinSettlementHashStep(h, receipt.ledgerHash)
    h = depinSettlementHashStep(h, int64(receipt.byteCount))
    h = depinSettlementHashStep(h, receipt.byteHash)
    return h

fn depinSettlementLedgerFileReceiptBuild(path: str,
                                         ledger: DepinSettlementLedger,
                                         bytesRaw: rawbytes.Bytes): DepinSettlementLedgerFileReceipt =
    var receipt = DepinSettlementLedgerFileReceipt(
        schema: DepinSettlementLedgerFileReceiptSchema,
        path: path,
        chainHash: ledger.chainHash,
        senderHash: ledger.senderHash,
        batchHash: ledger.batchHash,
        sessionHash: ledger.sessionHash,
        recordCount: ledger.recordCount,
        headRecordHash: ledger.headRecordHash,
        recordSetHash: ledger.recordSetHash,
        ledgerHash: ledger.ledgerHash,
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: depinSettlementLedgerFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    receipt.receiptHash = depinSettlementLedgerFileReceiptHash(receipt)
    return receipt

fn depinSettlementWriteI64LE(buf: var rawbytes.Bytes, offset: int32, value: int64) =
    rawbytes.BytesSet(buf, offset, int32(value & int64(255)))
    rawbytes.BytesSet(buf, offset + 1, int32((value >> 8) & int64(255)))
    rawbytes.BytesSet(buf, offset + 2, int32((value >> 16) & int64(255)))
    rawbytes.BytesSet(buf, offset + 3, int32((value >> 24) & int64(255)))
    rawbytes.BytesSet(buf, offset + 4, int32((value >> 32) & int64(255)))
    rawbytes.BytesSet(buf, offset + 5, int32((value >> 40) & int64(255)))
    rawbytes.BytesSet(buf, offset + 6, int32((value >> 48) & int64(255)))
    rawbytes.BytesSet(buf, offset + 7, int32((value >> 56) & int64(255)))

fn depinSettlementReadI64LE(buf: rawbytes.Bytes, offset: int32): int64 =
    var out: int64
    out = out + int64(rawbytes.BytesGet(buf, offset) & 255)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 1) & 255) << 8)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 2) & 255) << 16)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 3) & 255) << 24)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 4) & 255) << 32)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 5) & 255) << 40)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 6) & 255) << 48)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 7) & 255) << 56)
    return out

fn depinSettlementLedgerHeaderWord(ledger: DepinSettlementLedger,
                                   index: int32): int64 =
    if index == 0:
        return int64(DepinSettlementLedgerFileMagic)
    if index == 1:
        return int64(DepinSettlementLedgerFileVersion)
    if index == 2:
        return int64(ledger.recordCount)
    if index == 3:
        return ledger.headRecordHash
    if index == 4:
        return ledger.recordSetHash
    if index == 5:
        return ledger.ledgerHash
    if index == 6:
        return ledger.chainHash
    if index == 7:
        return ledger.senderHash
    if index == 8:
        return ledger.batchHash
    if index == 9:
        return ledger.sessionHash
    return int64(-1)

fn depinSettlementLedgerRecordWord(record: DepinSettlementLedgerRecord,
                                   index: int32): int64 =
    if index == 0:
        return int64(record.recordSeq)
    if index == 1:
        return record.previousRecordHash
    if index == 2:
        return record.kindHash
    if index == 3:
        return record.txTypeHash
    if index == 4:
        return record.txHashHash
    if index == 5:
        return record.payloadHash
    if index == 6:
        return record.planHash
    if index == 7:
        return record.sessionProofHash
    if index == 8:
        return record.chainHash
    if index == 9:
        return record.senderHash
    if index == 10:
        return record.submitTxHashHash
    if index == 11:
        return record.reasonHash
    if index == 12:
        return record.proofHash
    if index == 13:
        return record.recordedAtNs
    if index == 14:
        return record.kvResidencyStoreHash
    if index == 15:
        return record.kvResidencyStoreOperationHash
    if index == 16:
        return record.kvResidencyWalRecordHash
    if index == 17:
        return record.kvResidencyWalLogHash
    if index == 18:
        return record.kvResidencyWalAppendHash
    if index == 19:
        return record.kvResidencyServiceCommitHash
    if index == 20:
        return record.kvResidencyServiceApplyHash
    if index == 21:
        return record.recordHash
    return int64(-1)

fn depinSettlementLedgerFileBytes(ledger: DepinSettlementLedger): Result[rawbytes.Bytes] =
    let ledgerOk = DepinSettlementValidateLedger(ledger)
    if IsErr(ledgerOk):
        return Err[rawbytes.Bytes](Error(ledgerOk))
    let wordCount = DepinSettlementLedgerFileHeaderWordCount + ledger.records.len * DepinSettlementLedgerFileRecordWordCount
    let byteCount = wordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin settlement ledger file: allocation")
    for h in 0..<DepinSettlementLedgerFileHeaderWordCount:
        depinSettlementWriteI64LE(out, h * 8, depinSettlementLedgerHeaderWord(ledger, h))
    var offset = DepinSettlementLedgerFileHeaderWordCount * 8
    for r in 0..<ledger.records.len:
        for w in 0..<DepinSettlementLedgerFileRecordWordCount:
            depinSettlementWriteI64LE(out, offset + w * 8, depinSettlementLedgerRecordWord(ledger.records[r], w))
        offset = offset + DepinSettlementLedgerFileRecordWordCount * 8
    return Ok[rawbytes.Bytes](out)

fn depinSettlementLedgerFromFileBytes(bytesRaw: rawbytes.Bytes): Result[DepinSettlementLedger] =
    let headerBytes = DepinSettlementLedgerFileHeaderWordCount * 8
    if rawbytes.BytesLen(bytesRaw) < headerBytes:
        return Err[DepinSettlementLedger]("depin settlement ledger file: short header")
    let magic = depinSettlementReadI64LE(bytesRaw, 0)
    let version = depinSettlementReadI64LE(bytesRaw, 8)
    let recordCountRaw = depinSettlementReadI64LE(bytesRaw, 16)
    let headRecordHash = depinSettlementReadI64LE(bytesRaw, 24)
    let recordSetHash = depinSettlementReadI64LE(bytesRaw, 32)
    let ledgerHash = depinSettlementReadI64LE(bytesRaw, 40)
    let chainHash = depinSettlementReadI64LE(bytesRaw, 48)
    let senderHash = depinSettlementReadI64LE(bytesRaw, 56)
    let batchHash = depinSettlementReadI64LE(bytesRaw, 64)
    let sessionHash = depinSettlementReadI64LE(bytesRaw, 72)
    if magic != int64(DepinSettlementLedgerFileMagic) ||
       version != int64(DepinSettlementLedgerFileVersion) ||
       recordCountRaw < int64(0) ||
       recordCountRaw > int64(1000000):
        return Err[DepinSettlementLedger]("depin settlement ledger file: header")
    let recordCount = int32(recordCountRaw)
    let wantBytes = headerBytes + recordCount * DepinSettlementLedgerFileRecordWordCount * 8
    if rawbytes.BytesLen(bytesRaw) != wantBytes:
        return Err[DepinSettlementLedger]("depin settlement ledger file: byte length")
    var records: DepinSettlementLedgerRecord[]
    var expectedPrevious: int64
    var offset = headerBytes
    for i in 0..<recordCount:
        let seqRaw = depinSettlementReadI64LE(bytesRaw, offset)
        if seqRaw != int64(i):
            return Err[DepinSettlementLedger]("depin settlement ledger file: seq")
        let record = DepinSettlementLedgerRecord(
            schema: DepinSettlementLedgerRecordSchema,
            recordSeq: int32(seqRaw),
            previousRecordHash: depinSettlementReadI64LE(bytesRaw, offset + 8),
            kindHash: depinSettlementReadI64LE(bytesRaw, offset + 16),
            txTypeHash: depinSettlementReadI64LE(bytesRaw, offset + 24),
            txHashHash: depinSettlementReadI64LE(bytesRaw, offset + 32),
            payloadHash: depinSettlementReadI64LE(bytesRaw, offset + 40),
            planHash: depinSettlementReadI64LE(bytesRaw, offset + 48),
            sessionProofHash: depinSettlementReadI64LE(bytesRaw, offset + 56),
            chainHash: depinSettlementReadI64LE(bytesRaw, offset + 64),
            senderHash: depinSettlementReadI64LE(bytesRaw, offset + 72),
            submitTxHashHash: depinSettlementReadI64LE(bytesRaw, offset + 80),
            reasonHash: depinSettlementReadI64LE(bytesRaw, offset + 88),
            proofHash: depinSettlementReadI64LE(bytesRaw, offset + 96),
            recordedAtNs: depinSettlementReadI64LE(bytesRaw, offset + 104),
            kvResidencyStoreHash: depinSettlementReadI64LE(bytesRaw, offset + 112),
            kvResidencyStoreOperationHash: depinSettlementReadI64LE(bytesRaw, offset + 120),
            kvResidencyWalRecordHash: depinSettlementReadI64LE(bytesRaw, offset + 128),
            kvResidencyWalLogHash: depinSettlementReadI64LE(bytesRaw, offset + 136),
            kvResidencyWalAppendHash: depinSettlementReadI64LE(bytesRaw, offset + 144),
            kvResidencyServiceCommitHash: depinSettlementReadI64LE(bytesRaw, offset + 152),
            kvResidencyServiceApplyHash: depinSettlementReadI64LE(bytesRaw, offset + 160),
            recordHash: depinSettlementReadI64LE(bytesRaw, offset + 168)
        )
        let recordOk = depinSettlementValidateLedgerRecord(record, i, expectedPrevious)
        if IsErr(recordOk):
            return Err[DepinSettlementLedger](Error(recordOk))
        add(records, record)
        expectedPrevious = record.recordHash
        offset = offset + DepinSettlementLedgerFileRecordWordCount * 8
    let ledgerRes = depinSettlementLedgerBuild(chainHash, senderHash, batchHash, sessionHash, records)
    if IsErr(ledgerRes):
        return Err[DepinSettlementLedger](Error(ledgerRes))
    let ledger = Value(ledgerRes)
    if ledger.headRecordHash != headRecordHash ||
       ledger.recordSetHash != recordSetHash ||
       ledger.ledgerHash != ledgerHash:
        return Err[DepinSettlementLedger]("depin settlement ledger file: ledger hash")
    return Ok[DepinSettlementLedger](ledger)

fn DepinSettlementWriteLedgerFile(path: str,
                                  ledger: DepinSettlementLedger): Result[DepinSettlementLedgerFileReceipt] =
    if path == "":
        return Err[DepinSettlementLedgerFileReceipt]("depin settlement ledger file: path")
    let bytesRes = depinSettlementLedgerFileBytes(ledger)
    if IsErr(bytesRes):
        return Err[DepinSettlementLedgerFileReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinSettlementLedgerFileReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinSettlementLedgerFileReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       depinSettlementLedgerFileByteHash(readBytes) != depinSettlementLedgerFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinSettlementLedgerFileReceipt]("depin settlement ledger file: readback")
    let receipt = depinSettlementLedgerFileReceiptBuild(path, ledger, readBytes)
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    return Ok[DepinSettlementLedgerFileReceipt](receipt)

fn DepinSettlementReadLedgerFile(path: str): Result[DepinSettlementLedgerFileRead] =
    if path == "":
        return Err[DepinSettlementLedgerFileRead]("depin settlement ledger file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinSettlementLedgerFileRead](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let ledgerRes = depinSettlementLedgerFromFileBytes(bytesRaw)
    if IsErr(ledgerRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinSettlementLedgerFileRead](Error(ledgerRes))
    let receipt = depinSettlementLedgerFileReceiptBuild(path, Value(ledgerRes), bytesRaw)
    let out = DepinSettlementLedgerFileRead(
        ledger: Value(ledgerRes),
        receipt: receipt
    )
    rawbytes.BytesFree(bytesRaw)
    return Ok[DepinSettlementLedgerFileRead](out)

fn DepinSettlementValidateLedgerFileReceipt(receipt: DepinSettlementLedgerFileReceipt): Result[bool] =
    if receipt.schema != DepinSettlementLedgerFileReceiptSchema ||
       receipt.path == "" ||
       receipt.chainHash <= int64(0) ||
       receipt.senderHash <= int64(0) ||
       receipt.batchHash <= int64(0) ||
       receipt.sessionHash <= int64(0) ||
       receipt.recordCount <= 0 ||
       receipt.headRecordHash <= int64(0) ||
       receipt.recordSetHash <= int64(0) ||
       receipt.ledgerHash <= int64(0) ||
       receipt.byteCount <= 0 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin settlement ledger receipt: fields")
    if depinSettlementLedgerFileReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin settlement ledger receipt: hash")
    let readRes = DepinSettlementReadLedgerFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).receipt.chainHash != receipt.chainHash ||
       Value(readRes).receipt.senderHash != receipt.senderHash ||
       Value(readRes).receipt.batchHash != receipt.batchHash ||
       Value(readRes).receipt.sessionHash != receipt.sessionHash ||
       Value(readRes).receipt.recordCount != receipt.recordCount ||
       Value(readRes).receipt.headRecordHash != receipt.headRecordHash ||
       Value(readRes).receipt.recordSetHash != receipt.recordSetHash ||
       Value(readRes).receipt.ledgerHash != receipt.ledgerHash ||
       Value(readRes).receipt.byteCount != receipt.byteCount ||
       Value(readRes).receipt.byteHash != receipt.byteHash ||
       Value(readRes).receipt.receiptHash != receipt.receiptHash:
        return Err[bool]("depin settlement ledger receipt: readback")
    return Ok[bool](true)

fn depinSettlementLedgerReplicaFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return depinSettlementHashBytesWith(int64(257), bytesRaw)

fn depinSettlementLedgerReplicaReceiptHash(receipt: DepinSettlementLedgerReplicaReceipt): int64 =
    var h: int64 = int64(263)
    h = depinSettlementHashTextWith(h, receipt.schema)
    h = depinSettlementHashTextWith(h, receipt.path)
    h = depinSettlementHashStep(h, receipt.sourcePeerHash)
    h = depinSettlementHashStep(h, receipt.targetPeerHash)
    h = depinSettlementHashStep(h, receipt.ledgerHash)
    h = depinSettlementHashStep(h, receipt.ledgerReceiptHash)
    h = depinSettlementHashStep(h, receipt.ledgerByteHash)
    h = depinSettlementHashStep(h, int64(receipt.ledgerByteCount))
    h = depinSettlementHashStep(h, int64(receipt.ledgerRecordCount))
    h = depinSettlementHashStep(h, receipt.ledgerHeadRecordHash)
    h = depinSettlementHashStep(h, receipt.ledgerRecordSetHash)
    h = depinSettlementHashStep(h, receipt.requestFrameHash)
    h = depinSettlementHashStep(h, receipt.replicatedAtNs)
    h = depinSettlementHashStep(h, int64(receipt.byteCount))
    h = depinSettlementHashStep(h, receipt.byteHash)
    return h

fn depinSettlementLedgerReplicaFileBytes(sourcePeerHash: int64,
                                         targetPeerHash: int64,
                                         ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                         requestFrameHash: int64,
                                         replicatedAtNs: int64): Result[rawbytes.Bytes] =
    if sourcePeerHash <= int64(0) ||
       targetPeerHash <= int64(0) ||
       requestFrameHash <= int64(0) ||
       replicatedAtNs <= int64(0):
        return Err[rawbytes.Bytes]("depin settlement ledger replica file: args")
    let ledgerOk = DepinSettlementValidateLedgerFileReceipt(ledgerReceipt)
    if IsErr(ledgerOk):
        return Err[rawbytes.Bytes](Error(ledgerOk))
    let byteCount = DepinSettlementLedgerReplicaFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin settlement ledger replica file: allocation")
    depinSettlementWriteI64LE(out, 0, int64(DepinSettlementLedgerReplicaFileMagic))
    depinSettlementWriteI64LE(out, 8, int64(DepinSettlementLedgerReplicaFileVersion))
    depinSettlementWriteI64LE(out, 16, sourcePeerHash)
    depinSettlementWriteI64LE(out, 24, targetPeerHash)
    depinSettlementWriteI64LE(out, 32, ledgerReceipt.ledgerHash)
    depinSettlementWriteI64LE(out, 40, ledgerReceipt.receiptHash)
    depinSettlementWriteI64LE(out, 48, ledgerReceipt.byteHash)
    depinSettlementWriteI64LE(out, 56, int64(ledgerReceipt.byteCount))
    depinSettlementWriteI64LE(out, 64, int64(ledgerReceipt.recordCount))
    depinSettlementWriteI64LE(out, 72, ledgerReceipt.headRecordHash)
    depinSettlementWriteI64LE(out, 80, ledgerReceipt.recordSetHash)
    depinSettlementWriteI64LE(out, 88, requestFrameHash)
    depinSettlementWriteI64LE(out, 96, replicatedAtNs)
    return Ok[rawbytes.Bytes](out)

fn depinSettlementLedgerReplicaReceiptBuild(path: str,
                                            sourcePeerHash: int64,
                                            targetPeerHash: int64,
                                            ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                            requestFrameHash: int64,
                                            replicatedAtNs: int64,
                                            bytesRaw: rawbytes.Bytes): DepinSettlementLedgerReplicaReceipt =
    var receipt = DepinSettlementLedgerReplicaReceipt(
        schema: DepinSettlementLedgerReplicaReceiptSchema,
        path: path,
        sourcePeerHash: sourcePeerHash,
        targetPeerHash: targetPeerHash,
        ledgerHash: ledgerReceipt.ledgerHash,
        ledgerReceiptHash: ledgerReceipt.receiptHash,
        ledgerByteHash: ledgerReceipt.byteHash,
        ledgerByteCount: ledgerReceipt.byteCount,
        ledgerRecordCount: ledgerReceipt.recordCount,
        ledgerHeadRecordHash: ledgerReceipt.headRecordHash,
        ledgerRecordSetHash: ledgerReceipt.recordSetHash,
        requestFrameHash: requestFrameHash,
        replicatedAtNs: replicatedAtNs,
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: depinSettlementLedgerReplicaFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    receipt.receiptHash = depinSettlementLedgerReplicaReceiptHash(receipt)
    return receipt

fn depinSettlementLedgerReplicaReceiptFromFileBytes(path: str,
                                                    bytesRaw: rawbytes.Bytes): Result[DepinSettlementLedgerReplicaReceipt] =
    let byteCount = DepinSettlementLedgerReplicaFileWordCount * 8
    if path == "" || rawbytes.BytesLen(bytesRaw) != byteCount:
        return Err[DepinSettlementLedgerReplicaReceipt]("depin settlement ledger replica file: byte length")
    let magic = depinSettlementReadI64LE(bytesRaw, 0)
    let version = depinSettlementReadI64LE(bytesRaw, 8)
    let sourcePeerHash = depinSettlementReadI64LE(bytesRaw, 16)
    let targetPeerHash = depinSettlementReadI64LE(bytesRaw, 24)
    let ledgerHash = depinSettlementReadI64LE(bytesRaw, 32)
    let ledgerReceiptHash = depinSettlementReadI64LE(bytesRaw, 40)
    let ledgerByteHash = depinSettlementReadI64LE(bytesRaw, 48)
    let ledgerByteCountRaw = depinSettlementReadI64LE(bytesRaw, 56)
    let ledgerRecordCountRaw = depinSettlementReadI64LE(bytesRaw, 64)
    let ledgerHeadRecordHash = depinSettlementReadI64LE(bytesRaw, 72)
    let ledgerRecordSetHash = depinSettlementReadI64LE(bytesRaw, 80)
    let requestFrameHash = depinSettlementReadI64LE(bytesRaw, 88)
    let replicatedAtNs = depinSettlementReadI64LE(bytesRaw, 96)
    if magic != int64(DepinSettlementLedgerReplicaFileMagic) ||
       version != int64(DepinSettlementLedgerReplicaFileVersion) ||
       sourcePeerHash <= int64(0) ||
       targetPeerHash <= int64(0) ||
       ledgerHash <= int64(0) ||
       ledgerReceiptHash <= int64(0) ||
       ledgerByteHash <= int64(0) ||
       ledgerByteCountRaw <= int64(0) ||
       ledgerRecordCountRaw <= int64(0) ||
       ledgerHeadRecordHash <= int64(0) ||
       ledgerRecordSetHash <= int64(0) ||
       requestFrameHash <= int64(0) ||
       replicatedAtNs <= int64(0):
        return Err[DepinSettlementLedgerReplicaReceipt]("depin settlement ledger replica file: header")
    var receipt = DepinSettlementLedgerReplicaReceipt(
        schema: DepinSettlementLedgerReplicaReceiptSchema,
        path: path,
        sourcePeerHash: sourcePeerHash,
        targetPeerHash: targetPeerHash,
        ledgerHash: ledgerHash,
        ledgerReceiptHash: ledgerReceiptHash,
        ledgerByteHash: ledgerByteHash,
        ledgerByteCount: int32(ledgerByteCountRaw),
        ledgerRecordCount: int32(ledgerRecordCountRaw),
        ledgerHeadRecordHash: ledgerHeadRecordHash,
        ledgerRecordSetHash: ledgerRecordSetHash,
        requestFrameHash: requestFrameHash,
        replicatedAtNs: replicatedAtNs,
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: depinSettlementLedgerReplicaFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    receipt.receiptHash = depinSettlementLedgerReplicaReceiptHash(receipt)
    return Ok[DepinSettlementLedgerReplicaReceipt](receipt)

fn DepinSettlementWriteLedgerReplicaReceiptFile(path: str,
                                                sourcePeerId: str,
                                                targetPeerId: str,
                                                ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                                requestFrameHash: int64,
                                                replicatedAtNs: int64): Result[DepinSettlementLedgerReplicaReceipt] =
    if path == "" || sourcePeerId == "" || targetPeerId == "":
        return Err[DepinSettlementLedgerReplicaReceipt]("depin settlement ledger replica file: path")
    let sourcePeerHash = DepinSettlementTextHash(sourcePeerId)
    let targetPeerHash = DepinSettlementTextHash(targetPeerId)
    let bytesRes = depinSettlementLedgerReplicaFileBytes(
        sourcePeerHash,
        targetPeerHash,
        ledgerReceipt,
        requestFrameHash,
        replicatedAtNs
    )
    if IsErr(bytesRes):
        return Err[DepinSettlementLedgerReplicaReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinSettlementLedgerReplicaReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinSettlementLedgerReplicaReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       depinSettlementLedgerReplicaFileByteHash(readBytes) != depinSettlementLedgerReplicaFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinSettlementLedgerReplicaReceipt]("depin settlement ledger replica file: readback")
    let receipt = depinSettlementLedgerReplicaReceiptBuild(
        path,
        sourcePeerHash,
        targetPeerHash,
        ledgerReceipt,
        requestFrameHash,
        replicatedAtNs,
        readBytes
    )
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    let receiptOk = DepinSettlementValidateLedgerReplicaReceipt(receipt)
    if IsErr(receiptOk):
        return Err[DepinSettlementLedgerReplicaReceipt](Error(receiptOk))
    return Ok[DepinSettlementLedgerReplicaReceipt](receipt)

fn DepinSettlementReadLedgerReplicaReceiptFile(path: str): Result[DepinSettlementLedgerReplicaReceipt] =
    if path == "":
        return Err[DepinSettlementLedgerReplicaReceipt]("depin settlement ledger replica file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinSettlementLedgerReplicaReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinSettlementLedgerReplicaReceiptFromFileBytes(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinSettlementValidateLedgerReplicaReceipt(receipt: DepinSettlementLedgerReplicaReceipt): Result[bool] =
    if receipt.schema != DepinSettlementLedgerReplicaReceiptSchema ||
       receipt.path == "" ||
       receipt.sourcePeerHash <= int64(0) ||
       receipt.targetPeerHash <= int64(0) ||
       receipt.ledgerHash <= int64(0) ||
       receipt.ledgerReceiptHash <= int64(0) ||
       receipt.ledgerByteHash <= int64(0) ||
       receipt.ledgerByteCount <= 0 ||
       receipt.ledgerRecordCount <= 0 ||
       receipt.ledgerHeadRecordHash <= int64(0) ||
       receipt.ledgerRecordSetHash <= int64(0) ||
       receipt.requestFrameHash <= int64(0) ||
       receipt.replicatedAtNs <= int64(0) ||
       receipt.byteCount <= 0 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin settlement ledger replica receipt: fields")
    if depinSettlementLedgerReplicaReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin settlement ledger replica receipt: hash")
    let readRes = DepinSettlementReadLedgerReplicaReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).sourcePeerHash != receipt.sourcePeerHash ||
       Value(readRes).targetPeerHash != receipt.targetPeerHash ||
       Value(readRes).ledgerHash != receipt.ledgerHash ||
       Value(readRes).ledgerReceiptHash != receipt.ledgerReceiptHash ||
       Value(readRes).ledgerByteHash != receipt.ledgerByteHash ||
       Value(readRes).ledgerByteCount != receipt.ledgerByteCount ||
       Value(readRes).ledgerRecordCount != receipt.ledgerRecordCount ||
       Value(readRes).ledgerHeadRecordHash != receipt.ledgerHeadRecordHash ||
       Value(readRes).ledgerRecordSetHash != receipt.ledgerRecordSetHash ||
       Value(readRes).requestFrameHash != receipt.requestFrameHash ||
       Value(readRes).replicatedAtNs != receipt.replicatedAtNs ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin settlement ledger replica receipt: readback")
    return Ok[bool](true)

fn DepinSettlementLedgerPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".cset1"], "")

fn DepinSettlementLedgerReplicaPathFromPrefix(prefix: str, targetPeerId: str): str =
    return strutil.Join([
        prefix,
        "_replica_",
        strings.Int64ToStr(DepinSettlementTextHash(targetPeerId)),
        ".csrp1"
    ], "")

fn depinSettlementAppendLedgerRecord(path: str,
                                     plan: DepinSettlementPlan,
                                     session: DepinInferenceSession,
                                     adapter: DepinRwadDispatcherAdapter,
                                     kind: str,
                                     submitTxHash: str,
                                     reason: str,
                                     proofHash: int64,
                                     recordedAtNs: int64): Result[DepinSettlementLedgerFileReceipt] =
    if path == "":
        return Err[DepinSettlementLedgerFileReceipt]("depin settlement ledger append: path")
    let chainHash = DepinSettlementTextHash(adapter.chainId)
    let senderHash = DepinSettlementTextHash(adapter.sender)
    let batchHash = DepinSettlementTextHash(plan.batchId)
    let sessionHash = DepinSettlementTextHash(session.sessionId)
    let planHash = DepinSettlementPlanHash(plan)
    let sessionProofHash = DepinSettlementSessionProofHash(plan, session)
    var existingRecords: DepinSettlementLedgerRecord[]
    var previousHead: int64
    if os.FileExists(path):
        let readRes = DepinSettlementReadLedgerFile(path)
        if IsErr(readRes):
            return Err[DepinSettlementLedgerFileReceipt](Error(readRes))
        if Value(readRes).ledger.chainHash != chainHash ||
           Value(readRes).ledger.senderHash != senderHash ||
           Value(readRes).ledger.batchHash != batchHash ||
           Value(readRes).ledger.sessionHash != sessionHash:
            return Err[DepinSettlementLedgerFileReceipt]("depin settlement ledger append: identity")
        previousHead = Value(readRes).ledger.headRecordHash
        for i in 0..<Value(readRes).ledger.records.len:
            if Value(readRes).ledger.records[i].planHash != planHash ||
               Value(readRes).ledger.records[i].sessionProofHash != sessionProofHash:
                return Err[DepinSettlementLedgerFileReceipt]("depin settlement ledger append: proof")
            add(existingRecords, Value(readRes).ledger.records[i])
    let recordRes = depinSettlementLedgerRecordBuild(
        existingRecords.len,
        previousHead,
        kind,
        adapter,
        plan,
        session,
        submitTxHash,
        reason,
        proofHash,
        recordedAtNs
    )
    if IsErr(recordRes):
        return Err[DepinSettlementLedgerFileReceipt](Error(recordRes))
    add(existingRecords, Value(recordRes))
    let ledgerRes = depinSettlementLedgerBuild(chainHash, senderHash, batchHash, sessionHash, existingRecords)
    if IsErr(ledgerRes):
        return Err[DepinSettlementLedgerFileReceipt](Error(ledgerRes))
    let writeRes = DepinSettlementWriteLedgerFile(path, Value(ledgerRes))
    if IsErr(writeRes):
        return Err[DepinSettlementLedgerFileReceipt](Error(writeRes))
    let receiptOk = DepinSettlementValidateLedgerFileReceipt(Value(writeRes))
    if IsErr(receiptOk):
        return Err[DepinSettlementLedgerFileReceipt](Error(receiptOk))
    return writeRes

fn depinSettlementSubmit(adapter: var DepinRwadDispatcherAdapter,
                         session: var DepinInferenceSession,
                         plan: DepinSettlementPlan): Result[bool] =
    let payloadRes = depinSettlementEncodeSubmit(plan, session)
    if IsErr(payloadRes):
        return Err[bool](Error(payloadRes))
    let txRes: Result[str] = depinAdapterSubmit(
        adapter,
        "rwad_inference_batch_submit",
        Value(payloadRes)
    )
    if IsErr(txRes):
        return Err[bool](Error(txRes))
    session.settlementTxHash = Value(txRes)
    return Ok[bool](true)

fn DepinSettlementSubmit(adapter: var DepinRwadDispatcherAdapter,
                         session: var DepinInferenceSession,
                         plan: DepinSettlementPlan): Result[bool] =
    return depinSettlementSubmit(adapter, session, plan)

fn DepinSettlementSubmitWithLedger(adapter: var DepinRwadDispatcherAdapter,
                                   session: var DepinInferenceSession,
                                   plan: DepinSettlementPlan,
                                   ledgerPath: str,
                                   recordedAtNs: int64): Result[DepinSettlementLedgerFileReceipt] =
    let submitRes = depinSettlementSubmit(adapter, session, plan)
    if IsErr(submitRes):
        return Err[DepinSettlementLedgerFileReceipt](Error(submitRes))
    return depinSettlementAppendLedgerRecord(
        ledgerPath,
        plan,
        session,
        adapter,
        "submit",
        "",
        "",
        int64(0),
        recordedAtNs
    )

fn depinSettlementFinalize(adapter: var DepinRwadDispatcherAdapter,
                           session: var DepinInferenceSession,
                           plan: DepinSettlementPlan): Result[bool] =
    let payloadRes = depinSettlementEncodeFinalize(plan, session)
    if IsErr(payloadRes):
        return Err[bool](Error(payloadRes))
    let txRes: Result[str] = depinAdapterSubmit(
        adapter,
        "rwad_inference_batch_finalize",
        Value(payloadRes)
    )
    if IsErr(txRes):
        return Err[bool](Error(txRes))
    session.settlementTxHash = Value(txRes)
    session.finished = true
    return Ok[bool](true)

fn DepinSettlementFinalize(adapter: var DepinRwadDispatcherAdapter,
                           session: var DepinInferenceSession,
                           plan: DepinSettlementPlan): Result[bool] =
    return depinSettlementFinalize(adapter, session, plan)

fn DepinSettlementFinalizeWithLedger(adapter: var DepinRwadDispatcherAdapter,
                                     session: var DepinInferenceSession,
                                     plan: DepinSettlementPlan,
                                     ledgerPath: str,
                                     recordedAtNs: int64): Result[DepinSettlementLedgerFileReceipt] =
    let submitTxHash = session.settlementTxHash
    let finalizeRes = depinSettlementFinalize(adapter, session, plan)
    if IsErr(finalizeRes):
        return Err[DepinSettlementLedgerFileReceipt](Error(finalizeRes))
    return depinSettlementAppendLedgerRecord(
        ledgerPath,
        plan,
        session,
        adapter,
        "finalize",
        submitTxHash,
        "",
        int64(0),
        recordedAtNs
    )

fn depinSettlementChallenge(adapter: var DepinRwadDispatcherAdapter,
                            session: var DepinInferenceSession,
                            plan: DepinSettlementPlan,
                            auditDecision: DepinAuditDecision,
                            reason: str,
                            proofPayload: Bytes): Result[bool] =
    let auditRes: DepinAuditChallengeResult = depinAuditApplyChallenge(auditDecision, proofPayload)
    if !auditRes.accepted:
        return Err[bool]("depin settlement challenge rejected")
    let payloadRes = depinSettlementEncodeChallenge(plan, session, auditDecision, reason, proofPayload)
    if IsErr(payloadRes):
        return Err[bool](Error(payloadRes))
    let txRes: Result[str] = depinAdapterSubmit(
        adapter,
        "rwad_inference_batch_challenge",
        Value(payloadRes)
    )
    if IsErr(txRes):
        return Err[bool](Error(txRes))
    session.challengeTxHash = Value(txRes)
    return Ok[bool](true)

fn DepinSettlementChallengeWithLedger(adapter: var DepinRwadDispatcherAdapter,
                                      session: var DepinInferenceSession,
                                      plan: DepinSettlementPlan,
                                      auditDecision: DepinAuditDecision,
                                      reason: str,
                                      proofPayload: Bytes,
                                      ledgerPath: str,
                                      recordedAtNs: int64): Result[DepinSettlementLedgerFileReceipt] =
    let challengeRes = depinSettlementChallenge(adapter, session, plan, auditDecision, reason, proofPayload)
    if IsErr(challengeRes):
        return Err[DepinSettlementLedgerFileReceipt](Error(challengeRes))
    return depinSettlementAppendLedgerRecord(
        ledgerPath,
        plan,
        session,
        adapter,
        "challenge",
        session.settlementTxHash,
        reason,
        DepinSettlementProofPayloadHash(proofPayload),
        recordedAtNs
    )

fn DepinSettlementLedgerAnchorPathFromPrefix(prefix: str): str =
    return strutil.Join([prefix, ".csan1"], "")

fn depinSettlementLedgerAnchorSubmissionHash(submissionBytes: Bytes): int64 =
    return depinSettlementHashBytesWith(int64(277), submissionBytes)

fn depinSettlementLedgerAnchorFileByteHash(bytesRaw: rawbytes.Bytes): int64 =
    return depinSettlementHashBytesWith(int64(271), bytesRaw)

fn depinSettlementLedgerAnchorReceiptHash(receipt: DepinSettlementLedgerAnchorReceipt): int64 =
    var h: int64 = int64(269)
    h = depinSettlementHashTextWith(h, receipt.schema)
    h = depinSettlementHashTextWith(h, receipt.path)
    h = depinSettlementHashStep(h, receipt.ledgerHash)
    h = depinSettlementHashStep(h, receipt.ledgerReceiptHash)
    h = depinSettlementHashStep(h, receipt.chainHash)
    h = depinSettlementHashStep(h, receipt.anchorTxHash)
    h = depinSettlementHashStep(h, receipt.anchorBlockNumber)
    h = depinSettlementHashStep(h, int64(receipt.blockConfirmations))
    h = depinSettlementHashStep(h, receipt.anchorTimestampNs)
    h = depinSettlementHashStep(h, receipt.submitterPeerHash)
    h = depinSettlementHashStep(h, receipt.submissionByteHash)
    h = depinSettlementHashStep(h, int64(receipt.byteCount))
    h = depinSettlementHashStep(h, receipt.byteHash)
    return h

fn depinSettlementLedgerAnchorFileBytes(ledgerHash: int64,
                                         ledgerReceiptHash: int64,
                                         chainHash: int64,
                                         anchorTxHash: int64,
                                         anchorBlockNumber: int64,
                                         blockConfirmations: int32,
                                         anchorTimestampNs: int64,
                                         submitterPeerHash: int64,
                                         submissionByteHash: int64): Result[rawbytes.Bytes] =
    if ledgerHash <= int64(0) ||
       ledgerReceiptHash <= int64(0) ||
       chainHash <= int64(0) ||
       anchorTxHash <= int64(0) ||
       anchorBlockNumber <= int64(0) ||
       blockConfirmations < int32(0) ||
       anchorTimestampNs <= int64(0) ||
       submitterPeerHash <= int64(0) ||
       submissionByteHash <= int64(0):
        return Err[rawbytes.Bytes]("depin settlement ledger anchor file: fields")
    let byteCount = DepinSettlementLedgerAnchorFileWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("depin settlement ledger anchor file: allocation")
    depinSettlementWriteI64LE(out, 0, int64(DepinSettlementLedgerAnchorFileMagic))
    depinSettlementWriteI64LE(out, 8, int64(DepinSettlementLedgerAnchorFileVersion))
    depinSettlementWriteI64LE(out, 16, ledgerHash)
    depinSettlementWriteI64LE(out, 24, ledgerReceiptHash)
    depinSettlementWriteI64LE(out, 32, chainHash)
    depinSettlementWriteI64LE(out, 40, anchorTxHash)
    depinSettlementWriteI64LE(out, 48, anchorBlockNumber)
    depinSettlementWriteI64LE(out, 56, int64(blockConfirmations))
    depinSettlementWriteI64LE(out, 64, anchorTimestampNs)
    depinSettlementWriteI64LE(out, 72, submitterPeerHash)
    depinSettlementWriteI64LE(out, 80, submissionByteHash)
    return Ok[rawbytes.Bytes](out)

fn depinSettlementLedgerAnchorReceiptBuild(path: str,
                                            ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                            chainId: str,
                                            anchorTxId: str,
                                            anchorBlockNumber: int64,
                                            blockConfirmations: int32,
                                            anchorTimestampNs: int64,
                                            submitterPeerId: str,
                                            submissionBytes: Bytes,
                                            fileBytes: rawbytes.Bytes): DepinSettlementLedgerAnchorReceipt =
    var receipt = DepinSettlementLedgerAnchorReceipt(
        schema: DepinSettlementLedgerAnchorReceiptSchema,
        path: path,
        ledgerHash: ledgerReceipt.ledgerHash,
        ledgerReceiptHash: ledgerReceipt.receiptHash,
        chainHash: DepinSettlementTextHash(chainId),
        anchorTxHash: DepinSettlementTextHash(anchorTxId),
        anchorBlockNumber: anchorBlockNumber,
        blockConfirmations: blockConfirmations,
        anchorTimestampNs: anchorTimestampNs,
        submitterPeerHash: DepinSettlementTextHash(submitterPeerId),
        submissionByteHash: depinSettlementLedgerAnchorSubmissionHash(submissionBytes),
        byteCount: rawbytes.BytesLen(fileBytes),
        byteHash: depinSettlementLedgerAnchorFileByteHash(fileBytes),
        receiptHash: int64(0)
    )
    receipt.receiptHash = depinSettlementLedgerAnchorReceiptHash(receipt)
    return receipt

fn depinSettlementLedgerAnchorReceiptFromFileBytes(path: str,
                                                    bytesRaw: rawbytes.Bytes): Result[DepinSettlementLedgerAnchorReceipt] =
    let byteCount = DepinSettlementLedgerAnchorFileWordCount * 8
    if path == "" || rawbytes.BytesLen(bytesRaw) != byteCount:
        return Err[DepinSettlementLedgerAnchorReceipt]("depin settlement ledger anchor file: byte length")
    let magic = depinSettlementReadI64LE(bytesRaw, 0)
    let version = depinSettlementReadI64LE(bytesRaw, 8)
    let ledgerHash = depinSettlementReadI64LE(bytesRaw, 16)
    let ledgerReceiptHash = depinSettlementReadI64LE(bytesRaw, 24)
    let chainHash = depinSettlementReadI64LE(bytesRaw, 32)
    let anchorTxHash = depinSettlementReadI64LE(bytesRaw, 40)
    let anchorBlockNumber = depinSettlementReadI64LE(bytesRaw, 48)
    let blockConfirmationsRaw = depinSettlementReadI64LE(bytesRaw, 56)
    let anchorTimestampNs = depinSettlementReadI64LE(bytesRaw, 64)
    let submitterPeerHash = depinSettlementReadI64LE(bytesRaw, 72)
    let submissionByteHash = depinSettlementReadI64LE(bytesRaw, 80)
    if magic != int64(DepinSettlementLedgerAnchorFileMagic) ||
       version != int64(DepinSettlementLedgerAnchorFileVersion) ||
       ledgerHash <= int64(0) ||
       ledgerReceiptHash <= int64(0) ||
       chainHash <= int64(0) ||
       anchorTxHash <= int64(0) ||
       anchorBlockNumber <= int64(0) ||
       blockConfirmationsRaw < int64(0) ||
       anchorTimestampNs <= int64(0) ||
       submitterPeerHash <= int64(0) ||
       submissionByteHash <= int64(0):
        return Err[DepinSettlementLedgerAnchorReceipt]("depin settlement ledger anchor file: header")
    var receipt = DepinSettlementLedgerAnchorReceipt(
        schema: DepinSettlementLedgerAnchorReceiptSchema,
        path: path,
        ledgerHash: ledgerHash,
        ledgerReceiptHash: ledgerReceiptHash,
        chainHash: chainHash,
        anchorTxHash: anchorTxHash,
        anchorBlockNumber: anchorBlockNumber,
        blockConfirmations: int32(blockConfirmationsRaw),
        anchorTimestampNs: anchorTimestampNs,
        submitterPeerHash: submitterPeerHash,
        submissionByteHash: submissionByteHash,
        byteCount: rawbytes.BytesLen(bytesRaw),
        byteHash: depinSettlementLedgerAnchorFileByteHash(bytesRaw),
        receiptHash: int64(0)
    )
    receipt.receiptHash = depinSettlementLedgerAnchorReceiptHash(receipt)
    return Ok[DepinSettlementLedgerAnchorReceipt](receipt)

fn DepinSettlementWriteLedgerAnchorReceiptFile(path: str,
                                                ledgerReceipt: DepinSettlementLedgerFileReceipt,
                                                chainId: str,
                                                anchorTxId: str,
                                                anchorBlockNumber: int64,
                                                blockConfirmations: int32,
                                                anchorTimestampNs: int64,
                                                submitterPeerId: str,
                                                submissionBytes: Bytes): Result[DepinSettlementLedgerAnchorReceipt] =
    if path == "" ||
       chainId == "" ||
       anchorTxId == "" ||
       submitterPeerId == "" ||
       anchorBlockNumber <= int64(0) ||
       blockConfirmations < int32(0) ||
       anchorTimestampNs <= int64(0):
        return Err[DepinSettlementLedgerAnchorReceipt]("depin settlement ledger anchor file: args")
    let ledgerOk = DepinSettlementValidateLedgerFileReceipt(ledgerReceipt)
    if IsErr(ledgerOk):
        return Err[DepinSettlementLedgerAnchorReceipt](Error(ledgerOk))
    let chainHash = DepinSettlementTextHash(chainId)
    let anchorTxHash = DepinSettlementTextHash(anchorTxId)
    let submitterPeerHash = DepinSettlementTextHash(submitterPeerId)
    let submissionByteHash = depinSettlementLedgerAnchorSubmissionHash(submissionBytes)
    let bytesRes = depinSettlementLedgerAnchorFileBytes(
        ledgerReceipt.ledgerHash,
        ledgerReceipt.receiptHash,
        chainHash,
        anchorTxHash,
        anchorBlockNumber,
        blockConfirmations,
        anchorTimestampNs,
        submitterPeerHash,
        submissionByteHash
    )
    if IsErr(bytesRes):
        return Err[DepinSettlementLedgerAnchorReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytesRaw)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinSettlementLedgerAnchorReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytesRaw)
        return Err[DepinSettlementLedgerAnchorReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytesRaw) ||
       depinSettlementLedgerAnchorFileByteHash(readBytes) != depinSettlementLedgerAnchorFileByteHash(bytesRaw):
        rawbytes.BytesFree(bytesRaw)
        rawbytes.BytesFree(readBytes)
        return Err[DepinSettlementLedgerAnchorReceipt]("depin settlement ledger anchor file: readback")
    let receipt = depinSettlementLedgerAnchorReceiptBuild(
        path,
        ledgerReceipt,
        chainId,
        anchorTxId,
        anchorBlockNumber,
        blockConfirmations,
        anchorTimestampNs,
        submitterPeerId,
        submissionBytes,
        readBytes
    )
    rawbytes.BytesFree(bytesRaw)
    rawbytes.BytesFree(readBytes)
    let receiptOk = DepinSettlementValidateLedgerAnchorReceipt(
        receipt,
        ledgerReceipt.ledgerHash,
        chainHash,
        int32(0)
    )
    if IsErr(receiptOk):
        return Err[DepinSettlementLedgerAnchorReceipt](Error(receiptOk))
    return Ok[DepinSettlementLedgerAnchorReceipt](receipt)

fn DepinSettlementReadLedgerAnchorReceiptFile(path: str): Result[DepinSettlementLedgerAnchorReceipt] =
    if path == "":
        return Err[DepinSettlementLedgerAnchorReceipt]("depin settlement ledger anchor file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DepinSettlementLedgerAnchorReceipt](Error(bytesRes))
    var bytesRaw = Value(bytesRes)
    let receiptRes = depinSettlementLedgerAnchorReceiptFromFileBytes(path, bytesRaw)
    rawbytes.BytesFree(bytesRaw)
    return receiptRes

fn DepinSettlementValidateLedgerAnchorReceipt(receipt: DepinSettlementLedgerAnchorReceipt,
                                              expectedLedgerHash: int64,
                                              expectedChainHash: int64,
                                              requiredConfirmations: int32): Result[bool] =
    if receipt.schema != DepinSettlementLedgerAnchorReceiptSchema ||
       receipt.path == "" ||
       receipt.ledgerHash <= int64(0) ||
       receipt.ledgerReceiptHash <= int64(0) ||
       receipt.chainHash <= int64(0) ||
       receipt.anchorTxHash <= int64(0) ||
       receipt.anchorBlockNumber <= int64(0) ||
       receipt.anchorTimestampNs <= int64(0) ||
       receipt.submitterPeerHash <= int64(0) ||
       receipt.submissionByteHash <= int64(0) ||
       receipt.byteCount <= 0 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("depin settlement ledger anchor receipt: fields")
    if expectedLedgerHash > int64(0) && receipt.ledgerHash != expectedLedgerHash:
        return Err[bool]("depin settlement ledger anchor receipt: ledger hash drift")
    if expectedChainHash > int64(0) && receipt.chainHash != expectedChainHash:
        return Err[bool]("depin settlement ledger anchor receipt: chain hash drift")
    if requiredConfirmations > int32(0) && receipt.blockConfirmations < requiredConfirmations:
        return Err[bool]("depin settlement ledger anchor receipt: confirmations insufficient")
    if depinSettlementLedgerAnchorReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin settlement ledger anchor receipt: hash")
    let readRes = DepinSettlementReadLedgerAnchorReceiptFile(receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    if Value(readRes).ledgerHash != receipt.ledgerHash ||
       Value(readRes).ledgerReceiptHash != receipt.ledgerReceiptHash ||
       Value(readRes).chainHash != receipt.chainHash ||
       Value(readRes).anchorTxHash != receipt.anchorTxHash ||
       Value(readRes).anchorBlockNumber != receipt.anchorBlockNumber ||
       Value(readRes).blockConfirmations != receipt.blockConfirmations ||
       Value(readRes).anchorTimestampNs != receipt.anchorTimestampNs ||
       Value(readRes).submitterPeerHash != receipt.submitterPeerHash ||
       Value(readRes).submissionByteHash != receipt.submissionByteHash ||
       Value(readRes).byteCount != receipt.byteCount ||
       Value(readRes).byteHash != receipt.byteHash ||
       Value(readRes).receiptHash != receipt.receiptHash:
        return Err[bool]("depin settlement ledger anchor receipt: readback")
    return Ok[bool](true)

# ---- D6: DiLoCo 训练外步结算记录 (收据证明面; 不提交真链) ----
# 一次成功 outer merge 产生一条: jobBundleCid / outerStep / tokenCount 总和 /
# eval NLL 哈希 / versionCid。字段漂移 = 重算哈希不等 -> Validate 硬错。
# evalMetricHash 必须是 DepinDiLoCoTrainEvalNllHash(nllMicros)，禁止 MSE/toy。

const
    DepinDiLoCoTrainRecordSchema = "cheng.depin.diloco_train_settlement.v1"
    DepinDiLoCoTrainEvalNllTag = "cheng.depin.diloco_eval.nll_micros.v1"

type
    DepinDiLoCoTrainRecord =
        schema: str
        jobBundleCidHex: str
        versionCidHex: str
        outerStep: int32
        tokenCountSum: int64
        evalMetricHash: int64
        recordedAtNs: int64
        recordHash: int64

@borrows
fn depinDiLoCoTrainRecordHash(record: DepinDiLoCoTrainRecord): int64 =
    var h: int64 = int64(251)
    h = depinSettlementHashTextWith(h, record.schema)
    h = depinSettlementHashTextWith(h, record.jobBundleCidHex)
    h = depinSettlementHashTextWith(h, record.versionCidHex)
    h = depinSettlementHashStep(h, int64(record.outerStep))
    h = depinSettlementHashStep(h, record.tokenCountSum)
    h = depinSettlementHashStep(h, record.evalMetricHash)
    h = depinSettlementHashStep(h, record.recordedAtNs)
    return h

fn DepinDiLoCoTrainEvalNllHash(nllMicros: int64): Result[int64] =
    if nllMicros <= int64(0):
        return Err[int64]("depin diloco train eval: nll")
    var h: int64 = int64(251)
    h = depinSettlementHashTextWith(h, DepinDiLoCoTrainEvalNllTag)
    h = depinSettlementHashStep(h, nllMicros)
    if h <= int64(0):
        return Err[int64]("depin diloco train eval: hash")
    return Ok[int64](h)

fn DepinDiLoCoTrainRecordBuild(jobBundleCidHex: str,
                                 versionCidHex: str,
                                 outerStep: int32,
                                 tokenCountSum: int64,
                                 evalMetricHash: int64,
                                 recordedAtNs: int64): Result[DepinDiLoCoTrainRecord] =
    if jobBundleCidHex == "" ||
       versionCidHex == "" ||
       outerStep <= 0 ||
       tokenCountSum <= 0 ||
       evalMetricHash <= int64(0) ||
       recordedAtNs <= int64(0):
        return Err[DepinDiLoCoTrainRecord]("depin diloco train record: args")
    var record = DepinDiLoCoTrainRecord(
        schema: DepinDiLoCoTrainRecordSchema,
        jobBundleCidHex: jobBundleCidHex,
        versionCidHex: versionCidHex,
        outerStep: outerStep,
        tokenCountSum: tokenCountSum,
        evalMetricHash: evalMetricHash,
        recordedAtNs: recordedAtNs,
        recordHash: int64(0)
    )
    record.recordHash = depinDiLoCoTrainRecordHash(record)
    return Ok[DepinDiLoCoTrainRecord](record)

@borrows
fn DepinDiLoCoTrainRecordValidate(record: DepinDiLoCoTrainRecord): Result[bool] =
    if record.schema != DepinDiLoCoTrainRecordSchema ||
       record.jobBundleCidHex == "" ||
       record.versionCidHex == "" ||
       record.outerStep <= 0 ||
       record.tokenCountSum <= 0 ||
       record.evalMetricHash <= int64(0) ||
       record.recordedAtNs <= int64(0):
        return Err[bool]("depin diloco train record: invalid")
    if depinDiLoCoTrainRecordHash(record) != record.recordHash:
        return Err[bool]("depin diloco train record: hash drift")
    return Ok[bool](true)
