# DePIN orderbook topic + ask card codec and snapshot/inbox state.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/times
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/protocols/noderesource/protobuf as nrpb

const
    depinOrderbookTopic = "cheng/depin/orderbook/v1"
    depinAskCardSchema = "cheng-depin-ask-card/v1"
    depinOrderbookDefaultTtlMs = 60000
    maxDepinOrderbookCards = 256
    depinOrderbookWorkloadMaskAll = 7
    depinAskCardSchemaField = 1
    depinAskCardPeerIdField = 2
    depinAskCardTsMsField = 3
    depinAskCardTtlMsField = 4
    depinAskCardResourceField = 5
    depinAskCardAskPriceCpuNanoField = 6
    depinAskCardAskPriceGpuNanoField = 7
    depinAskCardAskPriceIoNanoField = 8
    depinAskCardAskWorkloadMaskField = 9
    depinOrderbookInt64Max = 9223372036854775807

type
    DepinAskCard =
        schemaVersion: str
        peerId: str
        tsMs: int64
        ttlMs: int64
        resource: NodeResourceInfo
        askPriceCpuNano: int64
        askPriceGpuNano: int64
        askPriceIoNano: int64
        askWorkloadMask: int64

    DepinAskCardList =
        count: int32
        cards: DepinAskCard[maxDepinOrderbookCards]

    DepinOrderbookState =
        snapshotCount: int32
        snapshot: DepinAskCard[maxDepinOrderbookCards]
        inboxCount: int32
        inbox: DepinAskCard[maxDepinOrderbookCards]

var
    depinOrderbookState: DepinOrderbookState = DepinOrderbookState(snapshotCount: 0, inboxCount: 0)

fn initDepinAskCard(): DepinAskCard =
    DepinAskCard(
        schemaVersion: depinAskCardSchema,
        peerId: "",
        tsMs: 0,
        ttlMs: depinOrderbookDefaultTtlMs,
        resource: initNodeResourceInfo(),
        askPriceCpuNano: 0,
        askPriceGpuNano: 0,
        askPriceIoNano: 0,
        askWorkloadMask: depinOrderbookWorkloadMaskAll
    )

fn initDepinAskCardList(): DepinAskCardList =
    DepinAskCardList(count: 0)

fn depinOrderbookTopicName(): str =
    return depinOrderbookTopic

fn depinOrderbookAskCardSchema(): str =
    return depinAskCardSchema

fn depinOrderbookNowMs(): int64 =
    return EpochTimeNs() / 1000000

fn depinOrderbookCardExpired(card: DepinAskCard, nowMs: int64): bool =
    if card.ttlMs <= 0 || card.tsMs <= 0:
        return false
    return nowMs > card.tsMs + card.ttlMs

fn depinOrderbookNormalizeCard(card: var DepinAskCard): bool =
    if len(card.schemaVersion) <= 0:
        card.schemaVersion = depinAskCardSchema
    if len(card.peerId) <= 0:
        card.peerId = ""
    if card.tsMs <= 0:
        card.tsMs = depinOrderbookNowMs()
    if card.ttlMs <= 0:
        card.ttlMs = depinOrderbookDefaultTtlMs
    if card.resource.updatedAtMs <= 0:
        card.resource.updatedAtMs = card.tsMs
    if card.askPriceCpuNano <= 0 && card.resource.askPriceCpuNano > 0:
        card.askPriceCpuNano = card.resource.askPriceCpuNano
    if card.askPriceGpuNano <= 0 && card.resource.askPriceGpuNano > 0:
        card.askPriceGpuNano = card.resource.askPriceGpuNano
    if card.askPriceIoNano <= 0 && card.resource.askPriceIoNano > 0:
        card.askPriceIoNano = card.resource.askPriceIoNano
    if card.askWorkloadMask <= 0 && card.resource.askWorkloadMask > 0:
        card.askWorkloadMask = card.resource.askWorkloadMask
    if card.askWorkloadMask <= 0:
        card.askWorkloadMask = depinOrderbookWorkloadMaskAll
    card.resource.askPriceCpuNano = card.askPriceCpuNano
    card.resource.askPriceGpuNano = card.askPriceGpuNano
    card.resource.askPriceIoNano = card.askPriceIoNano
    card.resource.askWorkloadMask = card.askWorkloadMask
    return len(card.peerId) > 0

fn depinOrderbookFindByPeer(cards: DepinAskCard[maxDepinOrderbookCards], count: int32, peerId: str): int32 =
    if len(peerId) <= 0:
        return -1
    for i in 0..<count:
        if cards[i].peerId == peerId:
            return i
    return -1

fn depinOrderbookPurgeExpired(state: var DepinOrderbookState, nowMs: int64) =
    var writeIdx: int32
    for i in 0..<state.snapshotCount:
        let card: DepinAskCard = state.snapshot[i]
        if ! depinOrderbookCardExpired(card, nowMs):
            if writeIdx != i:
                state.snapshot[writeIdx] = card
            writeIdx = writeIdx + 1
    state.snapshotCount = writeIdx

fn depinOrderbookUpsertSnapshot(card: DepinAskCard) =
    let nowMs: int64 = depinOrderbookNowMs()
    depinOrderbookPurgeExpired(depinOrderbookState, nowMs)
    let idx: int32 = depinOrderbookFindByPeer(depinOrderbookState.snapshot, depinOrderbookState.snapshotCount, card.peerId)
    if idx >= 0:
        depinOrderbookState.snapshot[idx] = card
        return
    if depinOrderbookState.snapshotCount < maxDepinOrderbookCards:
        depinOrderbookState.snapshot[depinOrderbookState.snapshotCount] = card
        depinOrderbookState.snapshotCount = depinOrderbookState.snapshotCount + 1
        return
    var evictIdx: int32
    var oldestTs: int64 = depinOrderbookState.snapshot[0].tsMs
    for i in 1..<depinOrderbookState.snapshotCount:
        if depinOrderbookState.snapshot[i].tsMs < oldestTs:
            oldestTs = depinOrderbookState.snapshot[i].tsMs
            evictIdx = i
    depinOrderbookState.snapshot[evictIdx] = card

fn depinOrderbookEnqueueInbox(card: DepinAskCard) =
    if depinOrderbookState.inboxCount < maxDepinOrderbookCards:
        depinOrderbookState.inbox[depinOrderbookState.inboxCount] = card
        depinOrderbookState.inboxCount = depinOrderbookState.inboxCount + 1
        return
    for i in 0..<((depinOrderbookState.inboxCount) - 1):
        if ! (i + 1 < depinOrderbookState.inboxCount):
            break
        depinOrderbookState.inbox[i] = depinOrderbookState.inbox[i + 1]
    depinOrderbookState.inbox[depinOrderbookState.inboxCount - 1] = card

fn depinOrderbookPopInbox(out: var DepinAskCard): bool =
    if depinOrderbookState.inboxCount <= 0:
        return false
    out = depinOrderbookState.inbox[0]
    for i in 0..<((depinOrderbookState.inboxCount) - 1):
        if ! (i + 1 < depinOrderbookState.inboxCount):
            break
        depinOrderbookState.inbox[i] = depinOrderbookState.inbox[i + 1]
    depinOrderbookState.inboxCount = depinOrderbookState.inboxCount - 1
    return true

fn depinOrderbookEncodeAskCard(cardRaw: DepinAskCard): Result[Bytes] =
    var card: DepinAskCard = cardRaw
    if ! depinOrderbookNormalizeCard(card):
        return Err[Bytes]("depin orderbook: empty peer_id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, depinAskCardSchemaField, card.schemaVersion)
    writeString(pb, depinAskCardPeerIdField, card.peerId)
    writeVarint(pb, depinAskCardTsMsField, card.tsMs)
    writeVarint(pb, depinAskCardTtlMsField, card.ttlMs)
    let resEnc: Result[Bytes] = encodeNodeResourceInfo(card.resource)
    if IsErr(resEnc):
        return Err[Bytes](Error(resEnc))
    writeBytes(pb, depinAskCardResourceField, Value(resEnc))
    if card.askPriceCpuNano > 0:
        writeVarint(pb, depinAskCardAskPriceCpuNanoField, card.askPriceCpuNano)
    if card.askPriceGpuNano > 0:
        writeVarint(pb, depinAskCardAskPriceGpuNanoField, card.askPriceGpuNano)
    if card.askPriceIoNano > 0:
        writeVarint(pb, depinAskCardAskPriceIoNanoField, card.askPriceIoNano)
    if card.askWorkloadMask > 0:
        writeVarint(pb, depinAskCardAskWorkloadMaskField, card.askWorkloadMask)
    return Ok[Bytes](protoToBytes(pb))

fn depinOrderbookDecodeAskCard(data: Bytes): Result[DepinAskCard] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var card: DepinAskCard = initDepinAskCard()
    var schemaBytes: Bytes = EmptyBytes()
    let schemaRes: Result[bool] = getField(pb, depinAskCardSchemaField, schemaBytes)
    if IsErr(schemaRes):
        return Err[DepinAskCard]("depin orderbook: invalid schema field")
    if Value(schemaRes):
        card.schemaVersion = BytesToString(schemaBytes)
    var peerBytes: Bytes = EmptyBytes()
    let peerRes: Result[bool] = getField(pb, depinAskCardPeerIdField, peerBytes)
    if IsErr(peerRes):
        return Err[DepinAskCard]("depin orderbook: invalid peer_id field")
    if Value(peerRes):
        card.peerId = BytesToString(peerBytes)
    var tsMsVal: int64
    let tsMsRes: Result[bool] = getField(pb, depinAskCardTsMsField, tsMsVal)
    if IsErr(tsMsRes):
        return Err[DepinAskCard]("depin orderbook: invalid ts_ms field")
    if Value(tsMsRes):
        card.tsMs = tsMsVal
    var ttlMsVal: int64
    let ttlMsRes: Result[bool] = getField(pb, depinAskCardTtlMsField, ttlMsVal)
    if IsErr(ttlMsRes):
        return Err[DepinAskCard]("depin orderbook: invalid ttl_ms field")
    if Value(ttlMsRes):
        card.ttlMs = ttlMsVal
    var resourceBytes: Bytes = EmptyBytes()
    let resourceRes: Result[bool] = getField(pb, depinAskCardResourceField, resourceBytes)
    if IsErr(resourceRes):
        return Err[DepinAskCard]("depin orderbook: invalid resource field")
    if Value(resourceRes):
        let decRes: Result[NodeResourceInfo] = decodeNodeResourceInfo(resourceBytes)
        if IsErr(decRes):
            return Err[DepinAskCard](Error(decRes))
        card.resource = Value(decRes)
    var askPriceCpuNanoVal: int64
    let askPriceCpuNanoRes: Result[bool] = getField(pb, depinAskCardAskPriceCpuNanoField, askPriceCpuNanoVal)
    if IsErr(askPriceCpuNanoRes):
        return Err[DepinAskCard]("depin orderbook: invalid ask_price_cpu_nano field")
    if Value(askPriceCpuNanoRes):
        card.askPriceCpuNano = askPriceCpuNanoVal
    var askPriceGpuNanoVal: int64
    let askPriceGpuNanoRes: Result[bool] = getField(pb, depinAskCardAskPriceGpuNanoField, askPriceGpuNanoVal)
    if IsErr(askPriceGpuNanoRes):
        return Err[DepinAskCard]("depin orderbook: invalid ask_price_gpu_nano field")
    if Value(askPriceGpuNanoRes):
        card.askPriceGpuNano = askPriceGpuNanoVal
    var askPriceIoNanoVal: int64
    let askPriceIoNanoRes: Result[bool] = getField(pb, depinAskCardAskPriceIoNanoField, askPriceIoNanoVal)
    if IsErr(askPriceIoNanoRes):
        return Err[DepinAskCard]("depin orderbook: invalid ask_price_io_nano field")
    if Value(askPriceIoNanoRes):
        card.askPriceIoNano = askPriceIoNanoVal
    var askWorkloadMaskVal: int64
    let askWorkloadMaskRes: Result[bool] = getField(pb, depinAskCardAskWorkloadMaskField, askWorkloadMaskVal)
    if IsErr(askWorkloadMaskRes):
        return Err[DepinAskCard]("depin orderbook: invalid ask_workload_mask field")
    if Value(askWorkloadMaskRes):
        card.askWorkloadMask = askWorkloadMaskVal
    if ! depinOrderbookNormalizeCard(card):
        return Err[DepinAskCard]("depin orderbook: missing peer_id")
    return Ok[DepinAskCard](card)

fn depinOrderbookProcessInbox(limit: int32): int32 =
    limit
    return 0

fn depinOrderbookSubscribe(): Result[bool] =
    return Ok[bool](true)

fn depinOrderbookPublish(cardRaw: DepinAskCard): Result[bool] =
    var card: DepinAskCard = cardRaw
    if ! depinOrderbookNormalizeCard(card):
        return Err[bool]("depin orderbook: empty peer_id")
    let encRes: Result[Bytes] = depinOrderbookEncodeAskCard(card)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    depinOrderbookUpsertSnapshot(card)
    depinOrderbookEnqueueInbox(card)
    return Ok[bool](true)

fn depinOrderbookNextCard(out: var DepinAskCard): bool =
    depinOrderbookProcessInbox(64)
    return depinOrderbookPopInbox(out)

fn depinOrderbookReadSnapshot(limit: int32): DepinAskCardList =
    depinOrderbookProcessInbox(128)
    let nowMs: int64 = depinOrderbookNowMs()
    depinOrderbookPurgeExpired(depinOrderbookState, nowMs)
    var out: DepinAskCardList = initDepinAskCardList()
    var maxCount: int32 = depinOrderbookState.snapshotCount
    if limit > 0 && limit < maxCount:
        maxCount = limit
    for i in 0..<maxCount:
        out.cards[out.count] = depinOrderbookState.snapshot[i]
        out.count = out.count + 1
    return out

fn depinOrderbookReset() =
    depinOrderbookState = DepinOrderbookState(snapshotCount: 0, inboxCount: 0)

fn depinSafeMul(a: int64, b: int64): int64 =
    if a <= 0 || b <= 0:
        return 0
    if a > depinOrderbookInt64Max / b:
        return depinOrderbookInt64Max
    return a * b

fn depinSafeAdd(a: int64, b: int64): int64 =
    if b > 0 && a > depinOrderbookInt64Max - b:
        return depinOrderbookInt64Max
    return a + b

fn depinCeilDiv(a: int64, b: int64): int64 =
    if a <= 0 || b <= 0:
        return 0
    return (a + b - 1) / b

fn depinOrderbookExpectedCostNano(card: DepinAskCard, cpuMs: int64, gpuMs: int64, ioBytes: int64): int64 =
    let cpuCost: int64 = depinSafeMul(cpuMs, card.askPriceCpuNano)
    let gpuCost: int64 = depinSafeMul(gpuMs, card.askPriceGpuNano)
    let ioCost: int64 = depinSafeMul(depinCeilDiv(ioBytes, 1024), card.askPriceIoNano)
    return depinSafeAdd(depinSafeAdd(cpuCost, gpuCost), ioCost)
