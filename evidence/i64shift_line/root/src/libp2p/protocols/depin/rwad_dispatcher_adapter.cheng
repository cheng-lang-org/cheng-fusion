# RWAD dispatcher adapter (BuildEnvelope -> SignEnvelope -> ApplyTx).
# This module keeps a deterministic local adapter contract so libp2p inference
# can submit settlement without depending on external RPC.

import cheng/libp2p/utils/result
import std/strings
import std/strutils as strutil

type
    DepinDispatcherEnvelope =
        chainId: str
        sender: str
        nonce: uint64
        txType: str
        payload: str
        signature: str
        signedAtMs: int64

    DepinRwadDispatcherAdapter =
        chainId: str
        sender: str
        privateKeyRef: str
        nextNonce: uint64
        lastTxHash: str
        lastTxType: str
        lastPayload: str
        lastPayloadHash: int64
        lastError: str

fn depinAdapterHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1048583) + value + int64(131)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

fn depinAdapterHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<text.len:
        h = depinAdapterHashStep(h, int64(Int32(text[i])))
    return h

fn depinAdapterEnvelopeHash(env: DepinDispatcherEnvelope): int64 =
    var h: int64 = int64(173)
    h = depinAdapterHashTextWith(h, env.chainId)
    h = depinAdapterHashTextWith(h, env.sender)
    h = depinAdapterHashStep(h, int64(env.nonce))
    h = depinAdapterHashTextWith(h, env.txType)
    h = depinAdapterHashTextWith(h, env.payload)
    h = depinAdapterHashTextWith(h, env.signature)
    h = depinAdapterHashStep(h, env.signedAtMs)
    return h

fn DepinAdapterPayloadHash(payload: str): int64 =
    return depinAdapterHashTextWith(int64(181), payload)

fn depinNonceBucketText(nonce: uint64): str =
    if nonce == uint64(0):
        return "0"
    if nonce == uint64(1):
        return "1"
    if nonce == uint64(2):
        return "2"
    if nonce == uint64(3):
        return "3"
    if nonce == uint64(4):
        return "4"
    if nonce == uint64(5):
        return "5"
    if nonce == uint64(6):
        return "6"
    if nonce == uint64(7):
        return "7"
    if nonce == uint64(8):
        return "8"
    if nonce == uint64(9):
        return "9"
    return "9+"

fn initDepinRwadDispatcherAdapter(chainId: str, sender: str,
                                  privateKeyRef: str, startNonce: uint64): DepinRwadDispatcherAdapter =
    return DepinRwadDispatcherAdapter(
        chainId: chainId,
        sender: sender,
        privateKeyRef: privateKeyRef,
        nextNonce: startNonce,
        lastTxHash: "",
        lastTxType: "",
        lastPayload: "",
        lastPayloadHash: int64(0),
        lastError: ""
    )

fn depinAdapterBuildEnvelope(adapter: var DepinRwadDispatcherAdapter,
                             txType: str, payload: str): Result[DepinDispatcherEnvelope] =
    if adapter.chainId == "" || adapter.sender == "":
        adapter.lastError = "adapter_missing_chain_or_sender"
        return Err[DepinDispatcherEnvelope](adapter.lastError)
    if txType == "":
        adapter.lastError = "adapter_missing_tx_type"
        return Err[DepinDispatcherEnvelope](adapter.lastError)
    return Ok[DepinDispatcherEnvelope](DepinDispatcherEnvelope(
        chainId: adapter.chainId,
        sender: adapter.sender,
        nonce: adapter.nextNonce,
        txType: txType,
        payload: payload,
        signature: "",
        signedAtMs: 0
    ))

fn depinAdapterSignEnvelope(adapter: var DepinRwadDispatcherAdapter,
                            env: var DepinDispatcherEnvelope): Result[bool] =
    if adapter.privateKeyRef == "":
        adapter.lastError = "adapter_missing_private_key"
        return Err[bool](adapter.lastError)
    env.signature = "sig"
    env.signedAtMs = 0
    return Ok[bool](true)

fn depinAdapterApplyTx(adapter: var DepinRwadDispatcherAdapter,
                       env: DepinDispatcherEnvelope): Result[str] =
    if env.signature == "":
        adapter.lastError = "adapter_missing_signature"
        return Err[str](adapter.lastError)
    let txHash: str = strutil.Join(["tx:", strings.Int64ToStr(depinAdapterEnvelopeHash(env))], "")
    adapter.lastTxHash = txHash
    adapter.lastTxType = env.txType
    adapter.lastPayload = env.payload
    adapter.lastPayloadHash = DepinAdapterPayloadHash(env.payload)
    adapter.nextNonce = adapter.nextNonce + uint64(1)
    adapter.lastError = ""
    return Ok[str](txHash)

fn depinAdapterSubmit(adapter: var DepinRwadDispatcherAdapter,
                      txType: str, payload: str): Result[str] =
    let envRes: Result[DepinDispatcherEnvelope] = depinAdapterBuildEnvelope(adapter, txType, payload)
    if IsErr(envRes):
        return Err[str](Error(envRes))
    var env: DepinDispatcherEnvelope = Value(envRes)
    let signRes: Result[bool] = depinAdapterSignEnvelope(adapter, env)
    if IsErr(signRes):
        return Err[str](Error(signRes))
    return depinAdapterApplyTx(adapter, env)
