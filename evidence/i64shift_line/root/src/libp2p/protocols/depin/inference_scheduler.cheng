# DePIN inference scheduler(stage assignment).

import std/result
import std/strings
import cheng/inference/distributed_engine
import cheng/libp2p/protocols/depin/inference_manifest
import cheng/libp2p/protocols/depin/orderbook

const
    DepinDistributedScheduleReceiptSchema = "cheng.depin.inference.distributed_schedule_receipt.v1"

type
    DepinStageAssignment =
        stageIndex: int32
        peerId: str
        layerCid: str

    DepinDistributedStageAssignment =
        stageIndex: int32
        peerId: str
        targetPeerId: str
        shardName: str
        shardHash: int64
        kvOwnerPeerId: str
        kvShardReceiptHash: int64
        requiresKvTransfer: bool
        assignmentHash: int64

    DepinDistributedScheduleReceipt =
        schema: str
        enginePlanHash: int64
        partitionPlanHash: int64
        deviceWeightBindingHash: int64
        kvPageTableHash: int64
        kvStateHash: int64
        kvShardReceiptSetHash: int64
        targetPeerId: str
        assignmentCount: int32
        kvOwnerSetHash: int64
        assignmentSetHash: int64
        requiresKvTransfer: bool
        scheduleHash: int64

    DepinDistributedSchedule =
        assignments: DepinDistributedStageAssignment[]
        receipt: DepinDistributedScheduleReceipt

fn depinSchedulerHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1048583) + value + int64(71)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

fn depinSchedulerHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = depinSchedulerHashStep(h, int64(Int32(text[i])))
    return h

fn depinSchedulerHashBool(hash: int64, value: bool): int64 =
    if value:
        return depinSchedulerHashStep(hash, int64(1))
    return depinSchedulerHashStep(hash, int64(0))

@borrows
fn DepinDistributedStageAssignmentHash(assignment: DepinDistributedStageAssignment): int64 =
    var h: int64 = int64(71)
    h = depinSchedulerHashStep(h, int64(assignment.stageIndex))
    h = depinSchedulerHashTextWith(h, assignment.peerId)
    h = depinSchedulerHashTextWith(h, assignment.targetPeerId)
    h = depinSchedulerHashTextWith(h, assignment.shardName)
    h = depinSchedulerHashStep(h, assignment.shardHash)
    h = depinSchedulerHashTextWith(h, assignment.kvOwnerPeerId)
    h = depinSchedulerHashStep(h, assignment.kvShardReceiptHash)
    h = depinSchedulerHashBool(h, assignment.requiresKvTransfer)
    return h

@borrows
fn DepinDistributedScheduleAssignmentSetHash(assignments: DepinDistributedStageAssignment[]): int64 =
    var h: int64 = int64(71)
    for i in 0..<assignments.len:
        h = depinSchedulerHashStep(h, assignments[i].assignmentHash)
    return h

@borrows
fn DepinDistributedScheduleKvOwnerSetHash(receipts: distributed_engine.DistributedKvShardReceipt[]): int64 =
    var h: int64 = int64(71)
    for i in 0..<receipts.len:
        h = depinSchedulerHashStep(h, int64(receipts[i].layerIndex))
        h = depinSchedulerHashTextWith(h, receipts[i].ownerPeerId)
        h = depinSchedulerHashStep(h, receipts[i].receiptHash)
    return h

@borrows
fn DepinDistributedScheduleReceiptHash(receipt: DepinDistributedScheduleReceipt): int64 =
    var h: int64 = int64(71)
    h = depinSchedulerHashTextWith(h, receipt.schema)
    h = depinSchedulerHashStep(h, receipt.enginePlanHash)
    h = depinSchedulerHashStep(h, receipt.partitionPlanHash)
    h = depinSchedulerHashStep(h, receipt.deviceWeightBindingHash)
    h = depinSchedulerHashStep(h, receipt.kvPageTableHash)
    h = depinSchedulerHashStep(h, receipt.kvStateHash)
    h = depinSchedulerHashStep(h, receipt.kvShardReceiptSetHash)
    h = depinSchedulerHashTextWith(h, receipt.targetPeerId)
    h = depinSchedulerHashStep(h, int64(receipt.assignmentCount))
    h = depinSchedulerHashStep(h, receipt.kvOwnerSetHash)
    h = depinSchedulerHashStep(h, receipt.assignmentSetHash)
    h = depinSchedulerHashBool(h, receipt.requiresKvTransfer)
    return h

@borrows
fn depinDistributedScheduleKvReceiptForStage(plan: distributed_engine.DistributedInferencePlan,
                                             stageIndex: int32): Result[distributed_engine.DistributedKvShardReceipt] =
    if plan.kvShardReceipts.receipts.len == 1:
        return Ok[distributed_engine.DistributedKvShardReceipt](plan.kvShardReceipts.receipts[0])
    if stageIndex < 0 || stageIndex >= plan.kvShardReceipts.receipts.len:
        return Err[distributed_engine.DistributedKvShardReceipt]("depin distributed scheduler: kv shard coverage")
    return Ok[distributed_engine.DistributedKvShardReceipt](plan.kvShardReceipts.receipts[stageIndex])

@borrows
fn DepinDistributedScheduleBuildAssignments(plan: distributed_engine.DistributedInferencePlan,
                                            peers: distributed_engine.DistributedInferencePeer[],
                                            targetPeerId: str,
                                            assignments: var DepinDistributedStageAssignment[]): Result[bool] =
    if assignments.len != 0:
        return Err[bool]("depin distributed scheduler: assignment output not empty")
    let planOk = distributed_engine.DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[bool](Error(planOk))
    if !distributed_engine.DistributedPeerReady(peers, targetPeerId):
        return Err[bool]("depin distributed scheduler: target peer")
    if plan.deviceWeightBindingHash <= int64(0) ||
       plan.kvReceipt.pageTableHash <= int64(0) ||
       plan.kvStateHash <= int64(0) ||
       plan.kvShardReceipts.receiptSetHash <= int64(0):
        return Err[bool]("depin distributed scheduler: proof roots")
    if plan.kvShardReceipts.receipts.len != 1 &&
       plan.kvShardReceipts.receipts.len != plan.activationShards.len:
        return Err[bool]("depin distributed scheduler: kv shard coverage")
    for i in 0..<plan.activationShards.len:
        let shard = plan.activationShards[i]
        if !distributed_engine.DistributedPeerReady(peers, shard.peerId):
            return Err[bool]("depin distributed scheduler: shard peer")
        let kvReceipt = depinDistributedScheduleKvReceiptForStage(plan, i)
        if IsErr(kvReceipt):
            return Err[bool](Error(kvReceipt))
        if !distributed_engine.DistributedPeerReady(peers, Value(kvReceipt).ownerPeerId):
            return Err[bool]("depin distributed scheduler: kv owner peer")
        var assignment = DepinDistributedStageAssignment(
            stageIndex: i,
            peerId: strings.CloneStr(shard.peerId),
            targetPeerId: strings.CloneStr(targetPeerId),
            shardName: strings.CloneStr(shard.shardName),
            shardHash: shard.shardHash,
            kvOwnerPeerId: strings.CloneStr(Value(kvReceipt).ownerPeerId),
            kvShardReceiptHash: Value(kvReceipt).receiptHash,
            requiresKvTransfer: Value(kvReceipt).ownerPeerId != targetPeerId,
            assignmentHash: int64(0)
        )
        assignment.assignmentHash = DepinDistributedStageAssignmentHash(assignment)
        if assignment.assignmentHash <= int64(0):
            return Err[bool]("depin distributed scheduler: assignment hash")
        add(assignments, assignment)
    return Ok[bool](true)

@borrows
fn DepinBuildDistributedScheduleReceipt(plan: distributed_engine.DistributedInferencePlan,
                                        peers: distributed_engine.DistributedInferencePeer[],
                                        targetPeerId: str,
                                        assignments: DepinDistributedStageAssignment[]): Result[DepinDistributedScheduleReceipt] =
    let planOk = distributed_engine.DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DepinDistributedScheduleReceipt](Error(planOk))
    if !distributed_engine.DistributedPeerReady(peers, targetPeerId):
        return Err[DepinDistributedScheduleReceipt]("depin distributed scheduler: target peer")
    if assignments.len != plan.activationShards.len:
        return Err[DepinDistributedScheduleReceipt]("depin distributed scheduler: assignment count")
    var requiresTransfer: bool
    for i in 0..<assignments.len:
        let kvReceipt = depinDistributedScheduleKvReceiptForStage(plan, i)
        if IsErr(kvReceipt):
            return Err[DepinDistributedScheduleReceipt](Error(kvReceipt))
        if assignments[i].stageIndex != i ||
           assignments[i].peerId != plan.activationShards[i].peerId ||
           assignments[i].targetPeerId != targetPeerId ||
           assignments[i].shardName != plan.activationShards[i].shardName ||
           assignments[i].shardHash != plan.activationShards[i].shardHash ||
           assignments[i].kvOwnerPeerId != Value(kvReceipt).ownerPeerId ||
           assignments[i].kvShardReceiptHash != Value(kvReceipt).receiptHash ||
           assignments[i].requiresKvTransfer != (Value(kvReceipt).ownerPeerId != targetPeerId):
            return Err[DepinDistributedScheduleReceipt]("depin distributed scheduler: assignment mismatch")
        if assignments[i].assignmentHash != DepinDistributedStageAssignmentHash(assignments[i]):
            return Err[DepinDistributedScheduleReceipt]("depin distributed scheduler: assignment hash")
        if assignments[i].requiresKvTransfer:
            requiresTransfer = true
    var receipt = DepinDistributedScheduleReceipt(
        schema: DepinDistributedScheduleReceiptSchema,
        enginePlanHash: plan.engineHash,
        partitionPlanHash: plan.partitionPlan.planHash,
        deviceWeightBindingHash: plan.deviceWeightBindingHash,
        kvPageTableHash: plan.kvReceipt.pageTableHash,
        kvStateHash: plan.kvStateHash,
        kvShardReceiptSetHash: plan.kvShardReceipts.receiptSetHash,
        targetPeerId: strings.CloneStr(targetPeerId),
        assignmentCount: assignments.len,
        kvOwnerSetHash: DepinDistributedScheduleKvOwnerSetHash(plan.kvShardReceipts.receipts),
        assignmentSetHash: DepinDistributedScheduleAssignmentSetHash(assignments),
        requiresKvTransfer: requiresTransfer,
        scheduleHash: int64(0)
    )
    receipt.scheduleHash = DepinDistributedScheduleReceiptHash(receipt)
    if receipt.scheduleHash <= int64(0):
        return Err[DepinDistributedScheduleReceipt]("depin distributed scheduler: schedule hash")
    return Ok[DepinDistributedScheduleReceipt](receipt)

@borrows
fn DepinSchedulerBuildDistributedSchedule(plan: distributed_engine.DistributedInferencePlan,
                                          peers: distributed_engine.DistributedInferencePeer[],
                                          targetPeerId: str): Result[DepinDistributedScheduleReceipt] =
    let schedule = DepinSchedulerBuildDistributedSchedulePlan(plan, peers, targetPeerId)
    if IsErr(schedule):
        return Err[DepinDistributedScheduleReceipt](Error(schedule))
    return Ok[DepinDistributedScheduleReceipt](Value(schedule).receipt)

@borrows
fn DepinSchedulerBuildDistributedSchedulePlan(plan: distributed_engine.DistributedInferencePlan,
                                              peers: distributed_engine.DistributedInferencePeer[],
                                              targetPeerId: str): Result[DepinDistributedSchedule] =
    var assignments: DepinDistributedStageAssignment[]
    let assignmentsOk = DepinDistributedScheduleBuildAssignments(plan, peers, targetPeerId, assignments)
    if IsErr(assignmentsOk):
        return Err[DepinDistributedSchedule](Error(assignmentsOk))
    let receipt = DepinBuildDistributedScheduleReceipt(plan, peers, targetPeerId, assignments)
    if IsErr(receipt):
        return Err[DepinDistributedSchedule](Error(receipt))
    return Ok[DepinDistributedSchedule](DepinDistributedSchedule(
        assignments: assignments,
        receipt: Value(receipt)
    ))

@borrows
fn DepinSchedulerValidateDistributedSchedule(plan: distributed_engine.DistributedInferencePlan,
                                             peers: distributed_engine.DistributedInferencePeer[],
                                             receipt: DepinDistributedScheduleReceipt): Result[bool] =
    if receipt.schema != DepinDistributedScheduleReceiptSchema:
        return Err[bool]("depin distributed scheduler: schema")
    let expected = DepinSchedulerBuildDistributedSchedule(plan, peers, receipt.targetPeerId)
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.enginePlanHash != want.enginePlanHash ||
       receipt.partitionPlanHash != want.partitionPlanHash ||
       receipt.deviceWeightBindingHash != want.deviceWeightBindingHash ||
       receipt.kvPageTableHash != want.kvPageTableHash ||
       receipt.kvStateHash != want.kvStateHash ||
       receipt.kvShardReceiptSetHash != want.kvShardReceiptSetHash ||
       receipt.targetPeerId != want.targetPeerId ||
       receipt.assignmentCount != want.assignmentCount ||
       receipt.kvOwnerSetHash != want.kvOwnerSetHash ||
       receipt.assignmentSetHash != want.assignmentSetHash ||
       receipt.requiresKvTransfer != want.requiresKvTransfer ||
       receipt.scheduleHash != want.scheduleHash:
        return Err[bool]("depin distributed scheduler: receipt mismatch")
    if DepinDistributedScheduleReceiptHash(receipt) != receipt.scheduleHash:
        return Err[bool]("depin distributed scheduler: receipt hash")
    return Ok[bool](true)

fn depinSchedulerBuild(peerIds: str[], layerCids: str[]): DepinStageAssignment[] =
    var out: DepinStageAssignment[]
    let fillOk = DepinSchedulerBuildFill(out, peerIds, layerCids)
    if !fillOk:
        return out
    return out

fn DepinSchedulerBuildFill(out: var DepinStageAssignment[],
                           peerIds: str[],
                           layerCids: str[]): bool =
    return DepinSchedulerBuildFillCounted(out, peerIds, len(peerIds), layerCids, len(layerCids))

fn DepinSchedulerBuildFillCounted(out: var DepinStageAssignment[],
                                  peerIds: str[],
                                  peerCount: int32,
                                  layerCids: str[],
                                  layerCount: int32): bool =
    if peerCount <= 0 || layerCount <= 0:
        return false
    for i in 0..<layerCount:
        add(out, DepinSchedulerAssignmentAt(peerIds, peerCount, layerCids, layerCount, i))
    return out.len == layerCount

fn DepinSchedulerBuild(peerIds: str[], layerCids: str[]): DepinStageAssignment[] =
    return depinSchedulerBuild(peerIds, layerCids)

fn DepinSchedulerAssignmentAt(peerIds: str[],
                              peerCount: int32,
                              layerCids: str[],
                              layerCount: int32,
                              stageIndex: int32): DepinStageAssignment =
    let peerIdx: int32 = stageIndex % peerCount
    return DepinStageAssignment(
        stageIndex: stageIndex,
        peerId: peerIds[peerIdx],
        layerCid: layerCids[stageIndex]
    )

fn depinSchedulerValidate(assignments: DepinStageAssignment[]): bool =
    for i in 0..<assignments.len:
        if assignments[i].stageIndex != i:
            return false
        if assignments[i].peerId == "" || assignments[i].layerCid == "":
            return false
    return true

fn DepinSchedulerValidate(assignments: DepinStageAssignment[]): bool =
    return depinSchedulerValidate(assignments)

fn depinSchedulerFromOrderbook(cards: DepinAskCardList, stageCount: int32): str[] =
    var out: str[]
    if stageCount <= 0:
        return out
    for i in 0..<cards.count:
        if cards.cards[i].peerId == "":
            continue
        add(out, cards.cards[i].peerId)
        if out.len >= stageCount:
            break
    return out

fn depinSchedulerAssignSession(session: DepinInferenceSession, peers: str[]): DepinStageAssignment[] =
    return depinSchedulerBuild(peers, session.request.layerCids)

fn DepinSchedulerAssignSession(session: inference_manifest.DepinInferenceSession,
                               peers: str[]): DepinStageAssignment[] =
    return depinSchedulerBuild(peers, session.request.layerCids)
