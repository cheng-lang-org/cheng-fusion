# DePIN distributed speculative decoding verifier.

import std/result
import cheng/libp2p/protocols/depin/inference_manifest
import cheng/inference/distributed_engine as engine
import cheng/inference/execution_receipt
import cheng/inference/kernel as infer

type
    DepinSpecDecodeResult =
        acceptedPrefixLen: int32
        rollbackFrom: int32
        mismatch: bool

    DepinSpecDecodeCertifiedReceipt =
        schema: str
        sessionId: str
        requestId: str
        modelCid: str
        manifestHash: int64
        enginePlanHash: int64
        draftEnginePlanHash: int64
        specDecodePlanHash: int64
        draftWindow: int32
        draftTokenCount: int32
        mtpLayerCount: int32
        contextTokenHash: int64
        draftTokenHash: int64
        draftLogitsHash: int64
        draftKvStateHash: int64
        draftReceiptHash: int64
        draftHash: int64
        verifyHash: int64
        verifyOutputTokenHash: int64
        verifyReceiptHash: int64
        acceptedPrefixLen: int32
        rollbackFrom: int32
        mismatch: bool
        receiptHash: int64

const
    DepinSpecDecodeCertifiedReceiptSchema = "cheng.depin.inference.spec_decode_certified_receipt.v1"

fn depinSpecDecodeHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1048583) + value + int64(197)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

fn depinSpecDecodeHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = depinSpecDecodeHashStep(h, int64(Int32(text[i])))
    return h

fn depinSpecDecodeHashBool(hashRaw: int64, value: bool): int64 =
    if value:
        return depinSpecDecodeHashStep(hashRaw, int64(1))
    return depinSpecDecodeHashStep(hashRaw, int64(0))

fn DepinSpecDecodeCertifiedReceiptHash(receipt: DepinSpecDecodeCertifiedReceipt): int64 =
    var h: int64 = int64(197)
    h = depinSpecDecodeHashTextWith(h, receipt.schema)
    h = depinSpecDecodeHashTextWith(h, receipt.sessionId)
    h = depinSpecDecodeHashTextWith(h, receipt.requestId)
    h = depinSpecDecodeHashTextWith(h, receipt.modelCid)
    h = depinSpecDecodeHashStep(h, receipt.manifestHash)
    h = depinSpecDecodeHashStep(h, receipt.enginePlanHash)
    h = depinSpecDecodeHashStep(h, receipt.draftEnginePlanHash)
    h = depinSpecDecodeHashStep(h, receipt.specDecodePlanHash)
    h = depinSpecDecodeHashStep(h, int64(receipt.draftWindow))
    h = depinSpecDecodeHashStep(h, int64(receipt.draftTokenCount))
    h = depinSpecDecodeHashStep(h, int64(receipt.mtpLayerCount))
    h = depinSpecDecodeHashStep(h, receipt.contextTokenHash)
    h = depinSpecDecodeHashStep(h, receipt.draftTokenHash)
    h = depinSpecDecodeHashStep(h, receipt.draftLogitsHash)
    h = depinSpecDecodeHashStep(h, receipt.draftKvStateHash)
    h = depinSpecDecodeHashStep(h, receipt.draftReceiptHash)
    h = depinSpecDecodeHashStep(h, receipt.draftHash)
    h = depinSpecDecodeHashStep(h, receipt.verifyHash)
    h = depinSpecDecodeHashStep(h, receipt.verifyOutputTokenHash)
    h = depinSpecDecodeHashStep(h, receipt.verifyReceiptHash)
    h = depinSpecDecodeHashStep(h, int64(receipt.acceptedPrefixLen))
    h = depinSpecDecodeHashStep(h, int64(receipt.rollbackFrom))
    h = depinSpecDecodeHashBool(h, receipt.mismatch)
    return h

fn depinSpecDecodeCertifiedReceiptShapeOk(receipt: DepinSpecDecodeCertifiedReceipt): Result[bool] =
    if receipt.schema != DepinSpecDecodeCertifiedReceiptSchema:
        return Err[bool]("depin spec decode certified receipt: schema")
    if receipt.sessionId == "" || receipt.requestId == "" || receipt.modelCid == "":
        return Err[bool]("depin spec decode certified receipt: identity")
    if receipt.manifestHash <= int64(0) ||
       receipt.enginePlanHash <= int64(0) ||
       receipt.draftEnginePlanHash <= int64(0) ||
       receipt.specDecodePlanHash <= int64(0) ||
       receipt.contextTokenHash <= int64(0) ||
       receipt.draftTokenHash <= int64(0) ||
       receipt.draftLogitsHash <= int64(0) ||
       receipt.draftKvStateHash <= int64(0) ||
       receipt.draftReceiptHash <= int64(0) ||
       receipt.draftHash <= int64(0) ||
       receipt.verifyHash <= int64(0) ||
       receipt.verifyOutputTokenHash <= int64(0) ||
       receipt.verifyReceiptHash <= int64(0):
        return Err[bool]("depin spec decode certified receipt: hashes")
    if receipt.draftWindow <= 0 ||
       receipt.draftTokenCount <= 0 ||
       receipt.mtpLayerCount <= 0 ||
       receipt.draftTokenCount > receipt.draftWindow:
        return Err[bool]("depin spec decode certified receipt: plan fields")
    if receipt.acceptedPrefixLen < 0 ||
       receipt.acceptedPrefixLen > receipt.draftTokenCount ||
       receipt.rollbackFrom < 0 ||
       receipt.rollbackFrom > receipt.draftTokenCount:
        return Err[bool]("depin spec decode certified receipt: result range")
    if receipt.mismatch:
        if receipt.rollbackFrom != receipt.acceptedPrefixLen ||
           receipt.acceptedPrefixLen >= receipt.draftTokenCount:
            return Err[bool]("depin spec decode certified receipt: mismatch range")
    else:
        if receipt.acceptedPrefixLen != receipt.draftTokenCount ||
           receipt.rollbackFrom != receipt.draftTokenCount:
            return Err[bool]("depin spec decode certified receipt: accepted range")
    if DepinSpecDecodeCertifiedReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("depin spec decode certified receipt: hash mismatch")
    return Ok[bool](true)

fn DepinSpecDecodeValidateCertifiedReceiptShape(receipt: DepinSpecDecodeCertifiedReceipt): Result[bool] =
    return depinSpecDecodeCertifiedReceiptShapeOk(receipt)

fn depinSpecDecodeValidateDraft(plan: engine.DistributedInferencePlan,
                                draft: engine.DistributedSpecDecodeDraftResult): Result[bool] =
    if draft.schema != engine.DistributedSpecDecodeDraftSchema:
        return Err[bool]("depin spec decode certified receipt: draft schema")
    if draft.draftTokenCount != plan.specDecodePlan.draftTokenCount ||
       draft.draftTokenCount <= 0:
        return Err[bool]("depin spec decode certified receipt: draft count")
    let draftTensorHash = engine.DistributedTensorOutputHash(draft.draftTokenIds)
    if IsErr(draftTensorHash):
        return Err[bool](Error(draftTensorHash))
    if Value(draftTensorHash) != draft.draftTokenHash:
        return Err[bool]("depin spec decode certified receipt: draft token hash")
    if draft.draftHash != engine.DistributedSpecDecodeDraftHash(draft):
        return Err[bool]("depin spec decode certified receipt: draft hash")
    if draft.draftKvStateHash != plan.kvStateHash:
        return Err[bool]("depin spec decode certified receipt: draft kv state")
    let draftReceiptOk = execution_receipt.InferenceExecutionReceiptValidate(draft.receipt)
    if IsErr(draftReceiptOk):
        return Err[bool](Error(draftReceiptOk))
    if draft.receipt.receiptHash != draft.receiptHash ||
       draft.receipt.enginePlanHash != plan.engineHash ||
       draft.receipt.outputHash <= int64(0):
        return Err[bool]("depin spec decode certified receipt: draft receipt")
    return Ok[bool](true)

fn depinSpecDecodeValidateVerify(plan: engine.DistributedInferencePlan,
                                 draft: engine.DistributedSpecDecodeDraftResult,
                                 verifierLogits: infer.TensorQ,
                                 contextTokenCount: int32,
                                 verify: engine.DistributedSpecDecodeVerifyResult,
                                 verifyRun: engine.DistributedInferenceRunResult): Result[bool] =
    let recomputedVerify = engine.DistributedVerifyDraftTokensFromLogits(
        verifierLogits,
        contextTokenCount,
        draft.draftTokenIds
    )
    if IsErr(recomputedVerify):
        return Err[bool](Error(recomputedVerify))
    if Value(recomputedVerify).verifyHash != verify.verifyHash:
        return Err[bool]("depin spec decode certified receipt: verify recompute")
    if verify.schema != engine.DistributedSpecDecodeVerifySchema:
        return Err[bool]("depin spec decode certified receipt: verify schema")
    if verify.verifyHash != engine.DistributedSpecDecodeVerifyHash(verify):
        return Err[bool]("depin spec decode certified receipt: verify hash")
    if verify.draftTokenHash != draft.draftTokenHash:
        return Err[bool]("depin spec decode certified receipt: verify draft binding")
    let outputTokenHash = engine.DistributedTensorOutputHash(verify.outputTokens)
    if IsErr(outputTokenHash):
        return Err[bool](Error(outputTokenHash))
    if Value(outputTokenHash) != verify.outputTokenHash:
        return Err[bool]("depin spec decode certified receipt: verify output token hash")
    if !verifyRun.accepted:
        return Err[bool]("depin spec decode certified receipt: verify run")
    let runReceiptOk = execution_receipt.InferenceExecutionReceiptValidate(verifyRun.receipt)
    if IsErr(runReceiptOk):
        return Err[bool](Error(runReceiptOk))
    if verifyRun.receipt.enginePlanHash != plan.engineHash ||
       verifyRun.receipt.outputHash != verify.verifyHash:
        return Err[bool]("depin spec decode certified receipt: verify receipt binding")
    if verify.acceptedDraftTokenCount < 0 ||
       verify.acceptedDraftTokenCount > draft.draftTokenCount ||
       verify.emittedTokenCount <= 0 ||
       verify.emittedTokenCount > draft.draftTokenCount:
        return Err[bool]("depin spec decode certified receipt: verify range")
    if verify.firstRejectedIndex >= 0:
        if verify.firstRejectedIndex != verify.acceptedDraftTokenCount ||
           verify.correctionToken < 0:
            return Err[bool]("depin spec decode certified receipt: rejected fields")
    else:
        if verify.acceptedDraftTokenCount != draft.draftTokenCount ||
           verify.correctionToken != -1:
            return Err[bool]("depin spec decode certified receipt: accepted fields")
    return Ok[bool](true)

fn DepinSpecDecodeBuildCertifiedReceipt(session: inference_manifest.DepinInferenceSession,
                                        manifest: inference_manifest.DepinDistributedInferenceManifest,
                                        draftPlan: engine.DistributedInferencePlan,
                                        plan: engine.DistributedInferencePlan,
                                        peers: engine.DistributedInferencePeer[],
                                        kvPageTransferEvidenceHash: int64,
                                        draft: engine.DistributedSpecDecodeDraftResult,
                                        verifierLogits: infer.TensorQ,
                                        contextTokenCount: int32,
                                        verify: engine.DistributedSpecDecodeVerifyResult,
                                        verifyRun: engine.DistributedInferenceRunResult): Result[DepinSpecDecodeCertifiedReceipt] =
    if !session.started || session.failed || session.sessionId == "":
        return Err[DepinSpecDecodeCertifiedReceipt]("depin spec decode certified receipt: session")
    if session.request.requestId == "" ||
       session.request.modelCid == "" ||
       session.request.modelCid != plan.modelGraph.modelCid ||
       session.request.modelCid != draftPlan.modelGraph.modelCid ||
       session.request.modelCid != manifest.modelCid:
        return Err[DepinSpecDecodeCertifiedReceipt]("depin spec decode certified receipt: request model")
    if session.config.specDraftWindow != plan.specDecodePlan.draftWindow ||
       session.config.specDraftWindow != draftPlan.specDecodePlan.draftWindow:
        return Err[DepinSpecDecodeCertifiedReceipt]("depin spec decode certified receipt: session window")
    let draftPlanOk = engine.DistributedValidatePlan(draftPlan, peers)
    if IsErr(draftPlanOk):
        return Err[DepinSpecDecodeCertifiedReceipt](Error(draftPlanOk))
    let planOk = engine.DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DepinSpecDecodeCertifiedReceipt](Error(planOk))
    if draftPlan.specDecodePlan.planHash != plan.specDecodePlan.planHash ||
       draftPlan.modelGraph.graphHash != plan.modelGraph.graphHash ||
       draftPlan.kvStateHash != plan.kvStateHash:
        return Err[DepinSpecDecodeCertifiedReceipt]("depin spec decode certified receipt: draft/verify plan binding")
    let manifestOk = inference_manifest.DepinValidateDistributedManifestPlanFacts(
        manifest,
        plan.partitionPlan,
        plan.kernelPrograms,
        plan.deviceWeightBindingHash,
        plan.kvReceipt,
        plan.kvStateHash,
        plan.kvShardReceipts.receiptSetHash,
        kvPageTransferEvidenceHash,
        plan.specDecodePlan.planHash,
        plan.routePlanSet
    )
    if IsErr(manifestOk):
        return Err[DepinSpecDecodeCertifiedReceipt](Error(manifestOk))
    let draftOk = depinSpecDecodeValidateDraft(draftPlan, draft)
    if IsErr(draftOk):
        return Err[DepinSpecDecodeCertifiedReceipt](Error(draftOk))
    let verifyOk = depinSpecDecodeValidateVerify(plan, draft, verifierLogits, contextTokenCount, verify, verifyRun)
    if IsErr(verifyOk):
        return Err[DepinSpecDecodeCertifiedReceipt](Error(verifyOk))
    var rollbackFrom = draft.draftTokenCount
    var mismatch: bool
    if verify.firstRejectedIndex >= 0:
        rollbackFrom = verify.acceptedDraftTokenCount
        mismatch = true
    var receipt = DepinSpecDecodeCertifiedReceipt(
        schema: DepinSpecDecodeCertifiedReceiptSchema,
        sessionId: session.sessionId,
        requestId: session.request.requestId,
        modelCid: session.request.modelCid,
        manifestHash: manifest.manifestHash,
        enginePlanHash: plan.engineHash,
        draftEnginePlanHash: draftPlan.engineHash,
        specDecodePlanHash: plan.specDecodePlan.planHash,
        draftWindow: plan.specDecodePlan.draftWindow,
        draftTokenCount: draft.draftTokenCount,
        mtpLayerCount: plan.specDecodePlan.mtpLayerCount,
        contextTokenHash: draft.contextTokenHash,
        draftTokenHash: draft.draftTokenHash,
        draftLogitsHash: draft.draftLogitsHash,
        draftKvStateHash: draft.draftKvStateHash,
        draftReceiptHash: draft.receiptHash,
        draftHash: draft.draftHash,
        verifyHash: verify.verifyHash,
        verifyOutputTokenHash: verify.outputTokenHash,
        verifyReceiptHash: verifyRun.receipt.receiptHash,
        acceptedPrefixLen: verify.acceptedDraftTokenCount,
        rollbackFrom: rollbackFrom,
        mismatch: mismatch,
        receiptHash: int64(0)
    )
    receipt.receiptHash = DepinSpecDecodeCertifiedReceiptHash(receipt)
    let shapeOk = depinSpecDecodeCertifiedReceiptShapeOk(receipt)
    if IsErr(shapeOk):
        return Err[DepinSpecDecodeCertifiedReceipt](Error(shapeOk))
    return Ok[DepinSpecDecodeCertifiedReceipt](receipt)

fn DepinSpecDecodeValidateCertifiedReceipt(session: inference_manifest.DepinInferenceSession,
                                           manifest: inference_manifest.DepinDistributedInferenceManifest,
                                           draftPlan: engine.DistributedInferencePlan,
                                           plan: engine.DistributedInferencePlan,
                                           peers: engine.DistributedInferencePeer[],
                                           kvPageTransferEvidenceHash: int64,
                                           draft: engine.DistributedSpecDecodeDraftResult,
                                           verifierLogits: infer.TensorQ,
                                           contextTokenCount: int32,
                                           verify: engine.DistributedSpecDecodeVerifyResult,
                                           verifyRun: engine.DistributedInferenceRunResult,
                                           receipt: DepinSpecDecodeCertifiedReceipt): Result[bool] =
    let expected = DepinSpecDecodeBuildCertifiedReceipt(
        session,
        manifest,
        draftPlan,
        plan,
        peers,
        kvPageTransferEvidenceHash,
        draft,
        verifierLogits,
        contextTokenCount,
        verify,
        verifyRun
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.receiptHash != want.receiptHash ||
       receipt.manifestHash != want.manifestHash ||
       receipt.enginePlanHash != want.enginePlanHash ||
       receipt.draftEnginePlanHash != want.draftEnginePlanHash ||
       receipt.specDecodePlanHash != want.specDecodePlanHash ||
       receipt.draftHash != want.draftHash ||
       receipt.verifyHash != want.verifyHash ||
       receipt.verifyReceiptHash != want.verifyReceiptHash ||
       receipt.acceptedPrefixLen != want.acceptedPrefixLen ||
       receipt.rollbackFrom != want.rollbackFrom ||
       receipt.mismatch != want.mismatch:
        return Err[bool]("depin spec decode certified receipt: mismatch")
    return depinSpecDecodeCertifiedReceiptShapeOk(receipt)

fn DepinSpecDecodeApplyCertifiedReceipt(session: var inference_manifest.DepinInferenceSession,
                                        receipt: DepinSpecDecodeCertifiedReceipt): Result[bool] =
    let receiptOk = depinSpecDecodeCertifiedReceiptShapeOk(receipt)
    if IsErr(receiptOk):
        return Err[bool](Error(receiptOk))
    if session.sessionId != receipt.sessionId ||
       session.request.requestId != receipt.requestId ||
       session.request.modelCid != receipt.modelCid:
        return Err[bool]("depin spec decode certified receipt: session binding")
    session.acceptedPrefixLen = receipt.acceptedPrefixLen
    session.rollbackFrom = receipt.rollbackFrom
    session.specDecodeCertifiedReceiptHash = receipt.receiptHash
    return Ok[bool](true)

fn depinSpecDecodeVerify(draftTokens: str[], targetTokens: str[], draftWindow: int32): DepinSpecDecodeResult =
    return depinSpecDecodeVerifyCounted(draftTokens, draftTokens.len, targetTokens, targetTokens.len, draftWindow)

fn depinSpecDecodeVerifyCounted(draftTokens: str[],
                                draftLen: int32,
                                targetTokens: str[],
                                targetLen: int32,
                                draftWindow: int32): DepinSpecDecodeResult =
    var limit: int32 = draftLen
    if targetLen < limit:
        limit = targetLen
    if draftWindow > 0:
        if draftWindow < limit:
            limit = draftWindow

    var accepted: int32
    var mismatch: bool
    for i in 0..<limit:
        if draftTokens[i] != targetTokens[i]:
            mismatch = true
            accepted = i
            break
        accepted = i + 1

    if !mismatch:
        if targetLen < draftLen:
            if accepted >= targetLen:
                mismatch = true

    let rollback: int32 = mismatch ? accepted : draftLen
    return DepinSpecDecodeResult(
        acceptedPrefixLen: accepted,
        rollbackFrom: rollback,
        mismatch: mismatch
    )

fn DepinSpecDecodeVerifyCounted(draftTokens: str[],
                                draftLen: int32,
                                targetTokens: str[],
                                targetLen: int32,
                                draftWindow: int32): DepinSpecDecodeResult =
    return depinSpecDecodeVerifyCounted(draftTokens, draftLen, targetTokens, targetLen, draftWindow)

fn depinSpecDecodeApply(session: var inference_manifest.DepinInferenceSession,
                        draftTokens: str[], targetTokens: str[]): DepinSpecDecodeResult =
    let res: DepinSpecDecodeResult = depinSpecDecodeVerifyCounted(
        draftTokens,
        draftTokens.len,
        targetTokens,
        targetTokens.len,
        session.config.specDraftWindow
    )
    session.acceptedPrefixLen = res.acceptedPrefixLen
    session.rollbackFrom = res.rollbackFrom
    session.specDecodeCertifiedReceiptHash = int64(0)
    return res

fn DepinSpecDecodeApplyCounted(session: var inference_manifest.DepinInferenceSession,
                               draftTokens: str[],
                               draftLen: int32,
                               targetTokens: str[],
                               targetLen: int32): DepinSpecDecodeResult =
    let res: DepinSpecDecodeResult = depinSpecDecodeVerifyCounted(
        draftTokens,
        draftLen,
        targetTokens,
        targetLen,
        session.config.specDraftWindow
    )
    session.acceptedPrefixLen = res.acceptedPrefixLen
    session.rollbackFrom = res.rollbackFrom
    session.specDecodeCertifiedReceiptHash = int64(0)
    return res
