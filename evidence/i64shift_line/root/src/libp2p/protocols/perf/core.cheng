# Perf protocol core(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/lpstream
import std/multiformats/protobuf/minprotobuf
const
    perfCodec = "/libp2p/perf/1.0.0"
    perfDefaultMessageSize = 1024
    perfDefaultMessageCount = 16
    perfMaxMessageSize = 1048576
    perfMaxMessageCount = 4096
    perfMaxControlBytes = 4096

    perfReqSizeField = 1
    perfReqCountField = 2

    perfRespOkField = 1
    perfRespBytesField = 2
    perfRespCountField = 3
    perfRespMessageField = 4

type
    PerfRequest =
        messageSize: int32
        messageCount: int32

    PerfSummary =
        ok: bool
        bytes: int64
        count: int32
        message: str

    PerfConfig =
        maxMessageSize: int32
        maxMessageCount: int32
        closeAfterResponse: bool

var
    perfConfig: PerfConfig = PerfConfig(
        maxMessageSize: perfMaxMessageSize,
        maxMessageCount: perfMaxMessageCount,
        closeAfterResponse: true
    )

fn initPerfConfig(): PerfConfig =
    PerfConfig(
        maxMessageSize: perfMaxMessageSize,
        maxMessageCount: perfMaxMessageCount,
        closeAfterResponse: true
    )

fn setPerfConfig(config: PerfConfig) =
    perfConfig = config

fn getPerfConfig(): PerfConfig =
    perfConfig

fn initPerfRequest(size: int32, count: int32): PerfRequest =
    PerfRequest(messageSize: size, messageCount: count)

fn normalizePerfRequest(req: PerfRequest): PerfRequest =
    var out: PerfRequest = req
    if out.messageSize <= 0:
        out.messageSize = perfDefaultMessageSize
    if out.messageCount <= 0:
        out.messageCount = perfDefaultMessageCount
    return out

fn validatePerfRequest(req: PerfRequest, config: PerfConfig): Result[bool] =
    if req.messageSize <= 0:
        return Err[bool]("perf: message size required")
    if req.messageCount <= 0:
        return Err[bool]("perf: message count required")
    if req.messageSize > config.maxMessageSize:
        return Err[bool]("perf: message size exceeds max")
    if req.messageCount > config.maxMessageCount:
        return Err[bool]("perf: message count exceeds max")
    return Ok[bool](true)

fn encodePerfRequest(req: PerfRequest): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, perfReqSizeField, int64(req.messageSize))
    writeVarint(pb, perfReqCountField, int64(req.messageCount))
    return Ok[Bytes](protoToBytes(pb))

fn decodePerfRequest(data: Bytes): Result[PerfRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: PerfRequest = initPerfRequest(0, 0)
    var sizeVal: int64
    let sizeRes: Result[bool] = getField(pb, perfReqSizeField, sizeVal)
    if IsErr(sizeRes):
        return Err[PerfRequest](Error(sizeRes))
    if Value(sizeRes):
        req.messageSize = int32(sizeVal)
    var countVal: int64
    let countRes: Result[bool] = getField(pb, perfReqCountField, countVal)
    if IsErr(countRes):
        return Err[PerfRequest](Error(countRes))
    if Value(countRes):
        req.messageCount = int32(countVal)
    return Ok[PerfRequest](req)

fn encodePerfSummary(summary: PerfSummary): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if summary.ok:
        writeVarint(pb, perfRespOkField, 1)
    writeVarint(pb, perfRespBytesField, summary.bytes)
    writeVarint(pb, perfRespCountField, int64(summary.count))
    if len(summary.message) > 0:
        writeString(pb, perfRespMessageField, summary.message)
    return Ok[Bytes](protoToBytes(pb))

fn decodePerfSummary(data: Bytes): Result[PerfSummary] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var summary: PerfSummary = PerfSummary(ok: false, bytes: 0, count: 0, message: "")
    var okVal: int64
    let okRes: Result[bool] = getField(pb, perfRespOkField, okVal)
    if IsErr(okRes):
        return Err[PerfSummary](Error(okRes))
    if Value(okRes):
        summary.ok = okVal != 0
    var bytesVal: int64
    let bytesRes: Result[bool] = getField(pb, perfRespBytesField, bytesVal)
    if IsErr(bytesRes):
        return Err[PerfSummary](Error(bytesRes))
    if Value(bytesRes):
        summary.bytes = bytesVal
    var countVal: int64
    let countRes: Result[bool] = getField(pb, perfRespCountField, countVal)
    if IsErr(countRes):
        return Err[PerfSummary](Error(countRes))
    if Value(countRes):
        summary.count = int32(countVal)
    var msgText: str
    let msgRes: Result[bool] = getField(pb, perfRespMessageField, msgText)
    if IsErr(msgRes):
        return Err[PerfSummary](Error(msgRes))
    if Value(msgRes):
        summary.message = msgText
    return Ok[PerfSummary](summary)

fn readPerfRequest(stream: var Stream): Result[PerfRequest] =
    let dataRes: Result[Bytes] = readLp(stream, perfMaxControlBytes)
    if IsErr(dataRes):
        return Err[PerfRequest](Error(dataRes))
    return decodePerfRequest(Value(dataRes))

fn writePerfRequest(stream: var Stream, req: PerfRequest): Result[bool] =
    let encRes: Result[Bytes] = encodePerfRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readPerfSummary(stream: var Stream): Result[PerfSummary] =
    let dataRes: Result[Bytes] = readLp(stream, perfMaxControlBytes)
    if IsErr(dataRes):
        return Err[PerfSummary](Error(dataRes))
    return decodePerfSummary(Value(dataRes))

fn writePerfSummary(stream: var Stream, summary: PerfSummary): Result[bool] =
    let encRes: Result[Bytes] = encodePerfSummary(summary)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn perfPayloadBytes(size: int32): Bytes =
    if size <= 0:
        return EmptyBytes()
    let out: Bytes = BytesAlloc(size)
    for i in 0..<size:
        BytesSet(out, i, i % 256)
    return out

fn perfSummaryOk(bytesCount: int64, msgCount: int32): PerfSummary =
    PerfSummary(ok: true, bytes: bytesCount, count: msgCount, message: "")

fn perfSummaryError(text: str): PerfSummary =
    PerfSummary(ok: false, bytes: 0, count: 0, message: text)
