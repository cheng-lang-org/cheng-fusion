# Perf protocol server(minimal, synchronous).

import cheng/libp2p/protocols/perf/core
import cheng/libp2p/protocols/protocol
fn perfServerHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[PerfRequest] = readPerfRequest(streamVar)
    if IsErr(reqRes):
        let summary: PerfSummary = perfSummaryError(Error(reqRes))
        writePerfSummary(streamVar, summary)
        return Err[bool](Error(reqRes))
    var req: PerfRequest = normalizePerfRequest(Value(reqRes))
    let validateRes: Result[bool] = validatePerfRequest(req, perfConfig)
    if IsErr(validateRes):
        let summary: PerfSummary = perfSummaryError(Error(validateRes))
        writePerfSummary(streamVar, summary)
        return Err[bool](Error(validateRes))
    var total: int64
    for i in 0..<req.messageCount:
        let dataRes: Result[Bytes] = readExact(streamVar, req.messageSize)
        if IsErr(dataRes):
            let summary: PerfSummary = perfSummaryError(Error(dataRes))
            writePerfSummary(streamVar, summary)
            return Err[bool](Error(dataRes))
        total = total + int64(BytesLen(Value(dataRes)))
    let summary: PerfSummary = perfSummaryOk(total, req.messageCount)
    let writeRes: Result[bool] = writePerfSummary(streamVar, summary)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if perfConfig.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn perfProtocol(): Lp2pProtocol =
    return newProtocol(perfCodec, perfServerHandler)
