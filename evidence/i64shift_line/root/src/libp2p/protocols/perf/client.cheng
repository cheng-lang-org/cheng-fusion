# Perf protocol client(minimal, synchronous).

import cheng/libp2p/protocols/perf/core
fn perfClientSend(stream: var Stream, req: PerfRequest): Result[int64] =
    var normalized: PerfRequest = normalizePerfRequest(req)
    let validateRes: Result[bool] = validatePerfRequest(normalized, perfConfig)
    if IsErr(validateRes):
        return Err[int64](Error(validateRes))
    let reqRes: Result[bool] = writePerfRequest(stream, normalized)
    if IsErr(reqRes):
        return Err[int64](Error(reqRes))
    let payload: Bytes = perfPayloadBytes(normalized.messageSize)
    var sent: int64
    for i in 0..<normalized.messageCount:
        let writeRes: Result[int32] = write(stream, payload)
        if IsErr(writeRes):
            return Err[int64](Error(writeRes))
        sent = sent + int64(Value(writeRes))
    return Ok[int64](sent)

fn perfClientRun(stream: var Stream, req: PerfRequest): Result[PerfSummary] =
    let sendRes: Result[int64] = perfClientSend(stream, req)
    if IsErr(sendRes):
        return Err[PerfSummary](Error(sendRes))
    let summaryRes: Result[PerfSummary] = readPerfSummary(stream)
    if IsErr(summaryRes):
        return Err[PerfSummary](Error(summaryRes))
    return summaryRes
