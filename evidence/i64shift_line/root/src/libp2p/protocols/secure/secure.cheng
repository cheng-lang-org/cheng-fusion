# Secure channel abstraction(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/connection
import cheng/libp2p/peerid
import cheng/libp2p/protocols/secure/plaintext
import cheng/libp2p/protocols/secure/noise
import cheng/libp2p/protocols/secure/tls
type
    Secure =
        codec: str
        localPeer: Option[PeerId]

fn initSecure(codec: str): Secure =
    var s: Secure
    s.codec = codec
    return s

fn initSecureInto(s: var Secure, codec: str) =
    s.codec = codec

fn setLocalPeerId(s: var Secure, id: PeerId) =
    s.localPeer.has = true
    s.localPeer.value = id

fn secure(s: Secure, conn: Connection, peer: Option[PeerId]): Result[Connection] =
    if (s.codec == "plaintext"):
        return plaintextSecure(conn, peer, s.localPeer)
    if (s.codec == "noise"):
        return noiseSecure(conn, peer, s.localPeer)
    if (s.codec == "tls"):
        return tlsSecure(conn, peer, s.localPeer)
    return Err[Connection]("secure: unknown codec")
