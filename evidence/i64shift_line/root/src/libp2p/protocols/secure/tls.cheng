# TLS secure channel(minimal metadata handshake; no encryption).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/varint
import cheng/libp2p/peerid
import cheng/libp2p/stream/connection
import cheng/libp2p/stream/lpstream
const
    tlsMagic = "tls/1.0.0"
    tlsMaxHandshake = 2048

fn encodeTlsHandshake(peerText: str): Bytes =
    let magicBytes: Bytes = BytesFromString(tlsMagic)
    let peerBytes: Bytes = BytesFromString(peerText)
    let magicLen: Bytes = encodeUVarint(int64(BytesLen(magicBytes)))
    let peerLen: Bytes = encodeUVarint(int64(BytesLen(peerBytes)))
    let head: Bytes = BytesConcat3(magicLen, magicBytes, peerLen)
    return BytesConcat(head, peerBytes)

fn decodeTlsHandshake(data: Bytes): Result[str] =
    let total: int32 = BytesLen(data)
    let magicLenRes: Result[VarintDecoded] = decodeUVarint(data, 0)
    if IsErr(magicLenRes):
        return Err[str](Error(magicLenRes))
    let magicLen64: int64 = Value(magicLenRes).value
    if magicLen64 < 0 || magicLen64 > 4096:
        return Err[str]("tls: invalid magic length")
    let magicLen: int32 = int32(magicLen64)
    var idx: int32 = Value(magicLenRes).next
    if idx + magicLen > total:
        return Err[str]("tls: truncated magic")
    let magicText: str = BytesToString(BytesSlice(data, idx, magicLen))
    if (magicText != tlsMagic):
        return Err[str]("tls: bad magic")
    idx = idx + magicLen
    let peerLenRes: Result[VarintDecoded] = decodeUVarint(data, idx)
    if IsErr(peerLenRes):
        return Err[str](Error(peerLenRes))
    let peerLen64: int64 = Value(peerLenRes).value
    if peerLen64 < 0 || peerLen64 > 4096:
        return Err[str]("tls: invalid peer length")
    let peerLen: int32 = int32(peerLen64)
    idx = Value(peerLenRes).next
    if idx + peerLen > total:
        return Err[str]("tls: truncated peer id")
    let peerText: str = BytesToString(BytesSlice(data, idx, peerLen))
    if len(peerText) > 0:
        let pidRes: Result[PeerId] = parsePeerId(peerText)
        if IsErr(pidRes):
            return Err[str](Error(pidRes))
    return Ok[str](peerText)

fn tlsSecure(conn: Connection, expected: Option[PeerId], local: Option[PeerId]): Result[Connection] =
    var next: Connection = conn
    let localText: str = if local.has: toString(local.value) else: ""
    if ConnectionDirection(next) == Outbound:
        let payload: Bytes = encodeTlsHandshake(localText)
        let writeRes: Result[int32] = writeLp(next, payload)
        if IsErr(writeRes):
            return Err[Connection](Error(writeRes))
        let readRes: Result[Bytes] = readLp(next, tlsMaxHandshake)
        if IsErr(readRes):
            return Err[Connection](Error(readRes))
        let data: Bytes = Value(readRes)
        if BytesLen(data) <= 0:
            return Err[Connection]("tls: missing handshake")
        let peerRes: Result[str] = decodeTlsHandshake(data)
        if IsErr(peerRes):
            return Err[Connection](Error(peerRes))
        let peerText: str = Value(peerRes)
        if len(peerText) > 0:
            next.remotePeer = peerText
        if expected.has && len(peerText) > 0:
            let gotRes: Result[PeerId] = parsePeerId(peerText)
            if IsErr(gotRes):
                return Err[Connection](Error(gotRes))
            let eqRes: Result[bool] = peerIdEqual(Value(gotRes), expected.value)
            if IsErr(eqRes):
                return Err[Connection](Error(eqRes))
            if ! Value(eqRes):
                return Err[Connection]("tls: peer id mismatch")
        return Ok[Connection](next)
    let readRes: Result[Bytes] = readLp(next, tlsMaxHandshake)
    if IsErr(readRes):
        return Err[Connection](Error(readRes))
    let data: Bytes = Value(readRes)
    if BytesLen(data) <= 0:
        return Err[Connection]("tls: missing handshake")
    let peerRes: Result[str] = decodeTlsHandshake(data)
    if IsErr(peerRes):
        return Err[Connection](Error(peerRes))
    let peerText: str = Value(peerRes)
    if len(peerText) > 0:
        next.remotePeer = peerText
    if expected.has && len(peerText) > 0:
        let gotRes: Result[PeerId] = parsePeerId(peerText)
        if IsErr(gotRes):
            return Err[Connection](Error(gotRes))
        let eqRes: Result[bool] = peerIdEqual(Value(gotRes), expected.value)
        if IsErr(eqRes):
            return Err[Connection](Error(eqRes))
        if ! Value(eqRes):
            return Err[Connection]("tls: peer id mismatch")
    let payload: Bytes = encodeTlsHandshake(localText)
    let writeRes: Result[int32] = writeLp(next, payload)
    if IsErr(writeRes):
        return Err[Connection](Error(writeRes))
    return Ok[Connection](next)
