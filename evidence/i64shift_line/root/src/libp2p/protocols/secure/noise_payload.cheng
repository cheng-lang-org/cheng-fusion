# libp2p Noise identity handshake payload (libp2p specs/noise/README.md,
# "The Noise Handshake Payload" section): binds the long-term libp2p identity
# key to the ephemeral Noise static (X25519) key so a peer can't be MITM'd
# by someone who merely has a valid Noise static key with no matching
# identity.
#
# Wire format (protobuf, field numbers per the libp2p spec):
#   message NoiseHandshakePayload {
#     bytes identity_key = 1;   // libp2p protobuf-encoded PublicKey: {type: varint = 1 (Ed25519), data: bytes = 2}
#     bytes identity_sig = 2;   // raw Ed25519 signature bytes, NOT protobuf-wrapped
#     // NoiseExtensions extensions = 3;  // not implemented here (optional in spec)
#   }
# identity_sig = Sign(identityPrivateKey, "noise-libp2p-static-key:" || noiseStaticPublicKey)
# per the spec's exact signature-payload construction.
#
# Scope: Ed25519 identity keys only (libp2p's default/most common key type;
# keyType id 1 per the multicodec key-type table crypto/types.cheng also
# uses). Composes existing production primitives only (cheng/libp2p/crypto/
# ed25519/ed25519's raw-bytes sign/verify, cheng/libp2p/protobuf/minprotobuf
# for the wire encoding) -- no hand-rolled signature scheme or protobuf here.
#
# Why not cheng/libp2p/crypto/crypto's generic multi-keytype PrivateKey/
# PublicKey/Sign/Verify (which would cover RSA/Secp256k1/ECDSA identities
# too): isolated a minimal repro during this slice showing
# cheng/libp2p/crypto/types.KeyType enum FIELD values written in one module
# (e.g. ed25519.keyPairFromSeed's `key.keyType = ktEd25519`) read back as 0
# (ktRSA) in a caller module -- reproduces with ~15 lines using only
# pre-existing ed25519.cheng/types.cheng code, no Noise code involved; not
# fixed here (a cross-module enum-field desync in shared plumbing, out of
# this slice's scope -- see the accompanying patch notes). The raw-bytes
# ed25519 API below never touches that field, so it isn't affected.
import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/ed25519/ed25519
import std/multiformats/protobuf/minprotobuf

const
    noiseLibp2pStaticKeyPrefix = "noise-libp2p-static-key:"
    ed25519KeyTypeId: int64 = 1

type
    NoiseIdentityPayload =
        identityKeyTypeId: int64
        identityKeyBytes: Bytes
        identitySig: Bytes

fn noiseStaticKeySignaturePayload(noiseStaticPub: Bytes): Bytes =
    return BytesConcat(BytesFromString(noiseLibp2pStaticKeyPrefix), noiseStaticPub)

# identityPriv/identityPub are raw Ed25519 key bytes (64-byte seed||pub
# private key, 32-byte public key -- ed25519.keyPairFromSeed's own
# .privateKey.data/.publicKey.data layout).
fn buildNoiseIdentityPayload(identityPriv: Bytes, identityPub: Bytes, noiseStaticPub: Bytes): Result[Bytes] =
    let sigRes: Result[Bytes] = ed25519.signEd25519Raw(identityPriv, noiseStaticKeySignaturePayload(noiseStaticPub))
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    var keyPb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeVarint(keyPb, 1, ed25519KeyTypeId)
    minprotobuf.writeBytes(keyPb, 2, identityPub)
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeBytes(pb, 1, minprotobuf.protoToBytes(keyPb))
    minprotobuf.writeBytes(pb, 2, Value(sigRes))
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

fn parseNoiseIdentityPayload(data: Bytes): Result[NoiseIdentityPayload] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var identityKeyRaw: Bytes = EmptyBytes()
    let r1: Result[bool] = minprotobuf.getField(pb, 1, identityKeyRaw)
    if IsErr(r1):
        return Err[NoiseIdentityPayload](Error(r1))
    if ! Value(r1):
        return Err[NoiseIdentityPayload]("noise: payload missing identity_key")
    var identitySig: Bytes = EmptyBytes()
    let r2: Result[bool] = minprotobuf.getField(pb, 2, identitySig)
    if IsErr(r2):
        return Err[NoiseIdentityPayload](Error(r2))
    if ! Value(r2):
        return Err[NoiseIdentityPayload]("noise: payload missing identity_sig")
    var keyPb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(identityKeyRaw, 0)
    var typeId: int64 = 0
    let r3: Result[bool] = minprotobuf.GetFieldInt64(keyPb, 1, typeId)
    if IsErr(r3):
        return Err[NoiseIdentityPayload](Error(r3))
    if ! Value(r3):
        return Err[NoiseIdentityPayload]("noise: identity_key missing type")
    var keyBytes: Bytes = EmptyBytes()
    let r4: Result[bool] = minprotobuf.getField(keyPb, 2, keyBytes)
    if IsErr(r4):
        return Err[NoiseIdentityPayload](Error(r4))
    if ! Value(r4):
        return Err[NoiseIdentityPayload]("noise: identity_key missing data")
    var out: NoiseIdentityPayload
    out.identityKeyTypeId = typeId
    out.identityKeyBytes = keyBytes
    out.identitySig = identitySig
    return Ok[NoiseIdentityPayload](out)

# Verifies that identitySig actually covers this exact noiseStaticPub (the
# binding the whole payload exists for) -- not just that identitySig is a
# well-formed signature under identityKeyBytes for some other message.
# Returns false (not an error) for any key type other than Ed25519: this
# module only implements that one signature scheme (see file header).
fn verifyNoiseIdentityPayload(payload: NoiseIdentityPayload, noiseStaticPub: Bytes): bool =
    if payload.identityKeyTypeId != ed25519KeyTypeId:
        return false
    return ed25519.verifyEd25519(payload.identityKeyBytes, noiseStaticKeySignaturePayload(noiseStaticPub), payload.identitySig)
