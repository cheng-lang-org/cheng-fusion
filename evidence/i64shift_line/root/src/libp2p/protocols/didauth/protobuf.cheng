# did-auth protobuf payloads.

import std/result
import cheng/libp2p/utils/bytes
import std/multiformats/protobuf/minprotobuf

const
    didAuthInitFieldDid = 1
    didAuthInitFieldPeerId = 2
    didAuthInitFieldNonceC = 3
    didAuthInitFieldTsMs = 4
    didAuthInitFieldDelegationProof = 5
    didAuthInitFieldBiometricAssertion = 6
    didAuthInitFieldSigC = 7

    didAuthRespFieldDid = 1
    didAuthRespFieldPeerId = 2
    didAuthRespFieldNonceS = 3
    didAuthRespFieldEchoNonceC = 4
    didAuthRespFieldTsMs = 5
    didAuthRespFieldDelegationProof = 6
    didAuthRespFieldBiometricAssertion = 7
    didAuthRespFieldSigS = 8


type
    DidAuthInitMessage =
        did: str
        peerId: str
        nonceC: Bytes
        tsMs: int64
        delegationProof: Bytes
        biometricAssertion: Bytes
        sigC: Bytes

    DidAuthRespMessage =
        did: str
        peerId: str
        nonceS: Bytes
        echoNonceC: Bytes
        tsMs: int64
        delegationProof: Bytes
        biometricAssertion: Bytes
        sigS: Bytes

fn DidAuthInitDid(msg: DidAuthInitMessage): str =
    return msg.did

fn DidAuthInitPeerId(msg: DidAuthInitMessage): str =
    return msg.peerId

fn DidAuthInitNonceC(msg: DidAuthInitMessage): Bytes =
    return msg.nonceC

fn DidAuthInitTsMs(msg: DidAuthInitMessage): int64 =
    return msg.tsMs

fn DidAuthInitDelegationProof(msg: DidAuthInitMessage): Bytes =
    return msg.delegationProof

fn DidAuthInitBiometricAssertion(msg: DidAuthInitMessage): Bytes =
    return msg.biometricAssertion

fn DidAuthInitSigC(msg: DidAuthInitMessage): Bytes =
    return msg.sigC

fn DidAuthRespDid(msg: DidAuthRespMessage): str =
    return msg.did

fn DidAuthRespPeerId(msg: DidAuthRespMessage): str =
    return msg.peerId

fn DidAuthRespNonceS(msg: DidAuthRespMessage): Bytes =
    return msg.nonceS

fn DidAuthRespEchoNonceC(msg: DidAuthRespMessage): Bytes =
    return msg.echoNonceC

fn DidAuthRespTsMs(msg: DidAuthRespMessage): int64 =
    return msg.tsMs

fn DidAuthRespDelegationProof(msg: DidAuthRespMessage): Bytes =
    return msg.delegationProof

fn DidAuthRespBiometricAssertion(msg: DidAuthRespMessage): Bytes =
    return msg.biometricAssertion

fn DidAuthRespSigS(msg: DidAuthRespMessage): Bytes =
    return msg.sigS

fn initDidAuthInitMessage(): DidAuthInitMessage =
    DidAuthInitMessage(
        did: "",
        peerId: "",
        nonceC: EmptyBytes(),
        tsMs: 0,
        delegationProof: EmptyBytes(),
        biometricAssertion: EmptyBytes(),
        sigC: EmptyBytes()
    )

fn initDidAuthRespMessage(): DidAuthRespMessage =
    DidAuthRespMessage(
        did: "",
        peerId: "",
        nonceS: EmptyBytes(),
        echoNonceC: EmptyBytes(),
        tsMs: 0,
        delegationProof: EmptyBytes(),
        biometricAssertion: EmptyBytes(),
        sigS: EmptyBytes()
    )

fn EncodeDidAuthInitMessage(msg: DidAuthInitMessage): Result[Bytes] =
    if len(msg.did) <= 0 || len(msg.peerId) <= 0:
        return Err[Bytes]("didauth: init missing did/peer")
    if BytesLen(msg.nonceC) <= 0:
        return Err[Bytes]("didauth: init missing nonce")
    if BytesLen(msg.delegationProof) <= 0:
        return Err[Bytes]("didauth: init missing delegation")
    if BytesLen(msg.biometricAssertion) <= 0:
        return Err[Bytes]("didauth: init missing biometric")
    if BytesLen(msg.sigC) <= 0:
        return Err[Bytes]("didauth: init missing signature")
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeString(pb, didAuthInitFieldDid, msg.did)
    minprotobuf.writeString(pb, didAuthInitFieldPeerId, msg.peerId)
    minprotobuf.writeBytes(pb, didAuthInitFieldNonceC, msg.nonceC)
    minprotobuf.writeVarint(pb, didAuthInitFieldTsMs, msg.tsMs)
    minprotobuf.writeBytes(pb, didAuthInitFieldDelegationProof, msg.delegationProof)
    minprotobuf.writeBytes(pb, didAuthInitFieldBiometricAssertion, msg.biometricAssertion)
    minprotobuf.writeBytes(pb, didAuthInitFieldSigC, msg.sigC)
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

fn DecodeDidAuthInitMessage(data: Bytes): Result[DidAuthInitMessage] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var out: DidAuthInitMessage
    let didRes: Result[bool] = minprotobuf.GetFieldString(pb, didAuthInitFieldDid, out.did)
    if IsErr(didRes):
        return Err[DidAuthInitMessage](Error(didRes))
    if ! Value(didRes):
        return Err[DidAuthInitMessage]("didauth: init missing did")
    let peerRes: Result[bool] = minprotobuf.GetFieldString(pb, didAuthInitFieldPeerId, out.peerId)
    if IsErr(peerRes):
        return Err[DidAuthInitMessage](Error(peerRes))
    if ! Value(peerRes):
        return Err[DidAuthInitMessage]("didauth: init missing peer")
    let nonceRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthInitFieldNonceC, out.nonceC)
    if IsErr(nonceRes):
        return Err[DidAuthInitMessage](Error(nonceRes))
    if ! Value(nonceRes):
        return Err[DidAuthInitMessage]("didauth: init missing nonce")
    let tsRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didAuthInitFieldTsMs, out.tsMs)
    if IsErr(tsRes):
        return Err[DidAuthInitMessage](Error(tsRes))
    if ! Value(tsRes):
        return Err[DidAuthInitMessage]("didauth: init missing ts")
    let proofRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthInitFieldDelegationProof, out.delegationProof)
    if IsErr(proofRes):
        return Err[DidAuthInitMessage](Error(proofRes))
    if ! Value(proofRes):
        return Err[DidAuthInitMessage]("didauth: init missing delegation")
    let bioRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthInitFieldBiometricAssertion, out.biometricAssertion)
    if IsErr(bioRes):
        return Err[DidAuthInitMessage](Error(bioRes))
    if ! Value(bioRes):
        return Err[DidAuthInitMessage]("didauth: init missing biometric")
    let sigRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthInitFieldSigC, out.sigC)
    if IsErr(sigRes):
        return Err[DidAuthInitMessage](Error(sigRes))
    if ! Value(sigRes):
        return Err[DidAuthInitMessage]("didauth: init missing signature")
    return Ok[DidAuthInitMessage](out)

fn EncodeDidAuthRespMessage(msg: DidAuthRespMessage): Result[Bytes] =
    if len(msg.did) <= 0 || len(msg.peerId) <= 0:
        return Err[Bytes]("didauth: resp missing did/peer")
    if BytesLen(msg.nonceS) <= 0 || BytesLen(msg.echoNonceC) <= 0:
        return Err[Bytes]("didauth: resp missing nonce")
    if BytesLen(msg.delegationProof) <= 0:
        return Err[Bytes]("didauth: resp missing delegation")
    if BytesLen(msg.biometricAssertion) <= 0:
        return Err[Bytes]("didauth: resp missing biometric")
    if BytesLen(msg.sigS) <= 0:
        return Err[Bytes]("didauth: resp missing signature")
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeString(pb, didAuthRespFieldDid, msg.did)
    minprotobuf.writeString(pb, didAuthRespFieldPeerId, msg.peerId)
    minprotobuf.writeBytes(pb, didAuthRespFieldNonceS, msg.nonceS)
    minprotobuf.writeBytes(pb, didAuthRespFieldEchoNonceC, msg.echoNonceC)
    minprotobuf.writeVarint(pb, didAuthRespFieldTsMs, msg.tsMs)
    minprotobuf.writeBytes(pb, didAuthRespFieldDelegationProof, msg.delegationProof)
    minprotobuf.writeBytes(pb, didAuthRespFieldBiometricAssertion, msg.biometricAssertion)
    minprotobuf.writeBytes(pb, didAuthRespFieldSigS, msg.sigS)
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

fn DecodeDidAuthRespMessage(data: Bytes): Result[DidAuthRespMessage] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var out: DidAuthRespMessage
    let didRes: Result[bool] = minprotobuf.GetFieldString(pb, didAuthRespFieldDid, out.did)
    if IsErr(didRes):
        return Err[DidAuthRespMessage](Error(didRes))
    if ! Value(didRes):
        return Err[DidAuthRespMessage]("didauth: resp missing did")
    let peerRes: Result[bool] = minprotobuf.GetFieldString(pb, didAuthRespFieldPeerId, out.peerId)
    if IsErr(peerRes):
        return Err[DidAuthRespMessage](Error(peerRes))
    if ! Value(peerRes):
        return Err[DidAuthRespMessage]("didauth: resp missing peer")
    let nonceRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthRespFieldNonceS, out.nonceS)
    if IsErr(nonceRes):
        return Err[DidAuthRespMessage](Error(nonceRes))
    if ! Value(nonceRes):
        return Err[DidAuthRespMessage]("didauth: resp missing nonce")
    let echoRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthRespFieldEchoNonceC, out.echoNonceC)
    if IsErr(echoRes):
        return Err[DidAuthRespMessage](Error(echoRes))
    if ! Value(echoRes):
        return Err[DidAuthRespMessage]("didauth: resp missing echo nonce")
    let tsRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didAuthRespFieldTsMs, out.tsMs)
    if IsErr(tsRes):
        return Err[DidAuthRespMessage](Error(tsRes))
    if ! Value(tsRes):
        return Err[DidAuthRespMessage]("didauth: resp missing ts")
    let proofRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthRespFieldDelegationProof, out.delegationProof)
    if IsErr(proofRes):
        return Err[DidAuthRespMessage](Error(proofRes))
    if ! Value(proofRes):
        return Err[DidAuthRespMessage]("didauth: resp missing delegation")
    let bioRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthRespFieldBiometricAssertion, out.biometricAssertion)
    if IsErr(bioRes):
        return Err[DidAuthRespMessage](Error(bioRes))
    if ! Value(bioRes):
        return Err[DidAuthRespMessage]("didauth: resp missing biometric")
    let sigRes: Result[bool] = minprotobuf.GetFieldBytes(pb, didAuthRespFieldSigS, out.sigS)
    if IsErr(sigRes):
        return Err[DidAuthRespMessage](Error(sigRes))
    if ! Value(sigRes):
        return Err[DidAuthRespMessage]("didauth: resp missing signature")
    return Ok[DidAuthRespMessage](out)

fn encodeDidAuthInitMessage(msg: DidAuthInitMessage): Result[Bytes] =
    return EncodeDidAuthInitMessage(msg)

fn decodeDidAuthInitMessage(data: Bytes): Result[DidAuthInitMessage] =
    return DecodeDidAuthInitMessage(data)

fn encodeDidAuthRespMessage(msg: DidAuthRespMessage): Result[Bytes] =
    return EncodeDidAuthRespMessage(msg)

fn decodeDidAuthRespMessage(data: Bytes): Result[DidAuthRespMessage] =
    return DecodeDidAuthRespMessage(data)
