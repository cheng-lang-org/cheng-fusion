# Rendezvous protobuf messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
const
    maxRendezvousRegistrations = 32

type
    RendezvousMessageType = enum
        rvRegister = 0
        rvRegisterResponse = 1
        rvUnregister = 2
        rvDiscover = 3
        rvDiscoverResponse = 4

    RendezvousResponseStatus = enum
        rvOk = 0
        rvInvalidNamespace = 100
        rvInvalidSignedPeerRecord = 101
        rvInvalidTtl = 102
        rvInvalidCookie = 103
        rvNotAuthorized = 200
        rvInternalError = 300
        rvUnavailable = 400

    RendezvousCookie =
        offset: int64
        hasNamespace: bool
        namespace: str

    RendezvousRegister =
        namespace: str
        signedPeerRecord: Bytes
        hasTtl: bool
        ttlSeconds: int64

    RendezvousRegisterResponse =
        status: RendezvousResponseStatus
        hasText: bool
        text: str
        hasTtl: bool
        ttlSeconds: int64

    RendezvousUnregister =
        namespace: str

    RendezvousDiscover =
        hasNamespace: bool
        namespace: str
        hasLimit: bool
        limit: int64
        hasCookie: bool
        cookie: Bytes

    RendezvousDiscoverResponse =
        registrationCount: int32
        registrations: RendezvousRegister[maxRendezvousRegistrations]
        hasCookie: bool
        cookie: Bytes
        status: RendezvousResponseStatus
        hasText: bool
        text: str

    RendezvousMessage =
        msgType: RendezvousMessageType
        hasRegister: bool
        register: RendezvousRegister
        hasRegisterResponse: bool
        registerResponse: RendezvousRegisterResponse
        hasUnregister: bool
        unregister: RendezvousUnregister
        hasDiscover: bool
        discover: RendezvousDiscover
        hasDiscoverResponse: bool
        discoverResponse: RendezvousDiscoverResponse

fn initRendezvousCookie(): RendezvousCookie =
    RendezvousCookie(offset: 0, hasNamespace: false, namespace: "")

fn initRendezvousRegister(): RendezvousRegister =
    RendezvousRegister(namespace: "", signedPeerRecord: EmptyBytes(), hasTtl: false, ttlSeconds: 0)

fn initRendezvousRegisterResponse(): RendezvousRegisterResponse =
    RendezvousRegisterResponse(
        status: rvOk,
        hasText: false,
        text: "",
        hasTtl: false,
        ttlSeconds: 0
    )

fn initRendezvousDiscover(): RendezvousDiscover =
    RendezvousDiscover(hasNamespace: false, namespace: "", hasLimit: false, limit: 0, hasCookie: false, cookie: EmptyBytes())

fn initRendezvousDiscoverResponse(): RendezvousDiscoverResponse =
    RendezvousDiscoverResponse(
        registrationCount: 0,
        hasCookie: false,
        cookie: EmptyBytes(),
        status: rvOk,
        hasText: false,
        text: ""
    )

fn initRendezvousMessage(): RendezvousMessage =
    RendezvousMessage(
        msgType: rvRegister,
        hasRegister: false,
        register: initRendezvousRegister(),
        hasRegisterResponse: false,
        registerResponse: initRendezvousRegisterResponse(),
        hasUnregister: false,
        unregister: RendezvousUnregister(namespace: ""),
        hasDiscover: false,
        discover: initRendezvousDiscover(),
        hasDiscoverResponse: false,
        discoverResponse: initRendezvousDiscoverResponse()
    )

fn rendezvousMessageTypeFromInt(value: int64): Result[RendezvousMessageType] =
    if value == 0:
        return Ok[RendezvousMessageType](rvRegister)
    if value == 1:
        return Ok[RendezvousMessageType](rvRegisterResponse)
    if value == 2:
        return Ok[RendezvousMessageType](rvUnregister)
    if value == 3:
        return Ok[RendezvousMessageType](rvDiscover)
    if value == 4:
        return Ok[RendezvousMessageType](rvDiscoverResponse)
    return Err[RendezvousMessageType]("rendezvous: invalid message type")

fn rendezvousStatusFromInt(value: int64): Result[RendezvousResponseStatus] =
    if value == 0:
        return Ok[RendezvousResponseStatus](rvOk)
    if value == 100:
        return Ok[RendezvousResponseStatus](rvInvalidNamespace)
    if value == 101:
        return Ok[RendezvousResponseStatus](rvInvalidSignedPeerRecord)
    if value == 102:
        return Ok[RendezvousResponseStatus](rvInvalidTtl)
    if value == 103:
        return Ok[RendezvousResponseStatus](rvInvalidCookie)
    if value == 200:
        return Ok[RendezvousResponseStatus](rvNotAuthorized)
    if value == 300:
        return Ok[RendezvousResponseStatus](rvInternalError)
    if value == 400:
        return Ok[RendezvousResponseStatus](rvUnavailable)
    return Err[RendezvousResponseStatus]("rendezvous: invalid status")

fn encodeRendezvousCookie(cookie: RendezvousCookie): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, 1, cookie.offset)
    if cookie.hasNamespace:
        writeString(pb, 2, cookie.namespace)
    return protoToBytes(pb)

fn decodeRendezvousCookie(data: Bytes): Result[RendezvousCookie] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var cookie: RendezvousCookie = initRendezvousCookie()
    var offsetVal: int64
    let offsetRes: Result[bool] = getRequiredField(pb, 1, offsetVal)
    if IsErr(offsetRes):
        return Err[RendezvousCookie](Error(offsetRes))
    cookie.offset = offsetVal
    var ns: str
    let nsRes: Result[bool] = getField(pb, 2, ns)
    if IsErr(nsRes):
        return Err[RendezvousCookie](Error(nsRes))
    if Value(nsRes):
        cookie.hasNamespace = true
        cookie.namespace = ns
    return Ok[RendezvousCookie](cookie)

fn encodeRendezvousRegister(reg: RendezvousRegister): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, 1, reg.namespace)
    writeBytes(pb, 2, reg.signedPeerRecord)
    if reg.hasTtl:
        writeVarint(pb, 3, reg.ttlSeconds)
    return protoToBytes(pb)

fn decodeRendezvousRegister(data: Bytes): Result[RendezvousRegister] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var reg: RendezvousRegister = initRendezvousRegister()
    var ns: str
    let nsRes: Result[bool] = getRequiredField(pb, 1, ns)
    if IsErr(nsRes):
        return Err[RendezvousRegister](Error(nsRes))
    reg.namespace = ns
    var spr: Bytes = EmptyBytes()
    let sprRes: Result[bool] = getRequiredField(pb, 2, spr)
    if IsErr(sprRes):
        return Err[RendezvousRegister](Error(sprRes))
    reg.signedPeerRecord = spr
    var ttlVal: int64
    let ttlRes: Result[bool] = getField(pb, 3, ttlVal)
    if IsErr(ttlRes):
        return Err[RendezvousRegister](Error(ttlRes))
    if Value(ttlRes):
        reg.hasTtl = true
        reg.ttlSeconds = ttlVal
    return Ok[RendezvousRegister](reg)

fn encodeRendezvousRegisterResponse(resp: RendezvousRegisterResponse): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, 1, int64(resp.status))
    if resp.hasText:
        writeString(pb, 2, resp.text)
    if resp.hasTtl:
        writeVarint(pb, 3, resp.ttlSeconds)
    return protoToBytes(pb)

fn decodeRendezvousRegisterResponse(data: Bytes): Result[RendezvousRegisterResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: RendezvousRegisterResponse = initRendezvousRegisterResponse()
    var statusVal: int64
    let statusRes: Result[bool] = getRequiredField(pb, 1, statusVal)
    if IsErr(statusRes):
        return Err[RendezvousRegisterResponse](Error(statusRes))
    let statusConv: Result[RendezvousResponseStatus] = rendezvousStatusFromInt(statusVal)
    if IsErr(statusConv):
        return Err[RendezvousRegisterResponse](Error(statusConv))
    resp.status = Value(statusConv)
    var textVal: str
    let textRes: Result[bool] = getField(pb, 2, textVal)
    if IsErr(textRes):
        return Err[RendezvousRegisterResponse](Error(textRes))
    if Value(textRes):
        resp.hasText = true
        resp.text = textVal
    var ttlVal: int64
    let ttlRes: Result[bool] = getField(pb, 3, ttlVal)
    if IsErr(ttlRes):
        return Err[RendezvousRegisterResponse](Error(ttlRes))
    if Value(ttlRes):
        resp.hasTtl = true
        resp.ttlSeconds = ttlVal
    return Ok[RendezvousRegisterResponse](resp)

fn encodeRendezvousUnregister(msg: RendezvousUnregister): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, 1, msg.namespace)
    return protoToBytes(pb)

fn decodeRendezvousUnregister(data: Bytes): Result[RendezvousUnregister] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var out: RendezvousUnregister = RendezvousUnregister(namespace: "")
    var ns: str
    let nsRes: Result[bool] = getRequiredField(pb, 1, ns)
    if IsErr(nsRes):
        return Err[RendezvousUnregister](Error(nsRes))
    out.namespace = ns
    return Ok[RendezvousUnregister](out)

fn encodeRendezvousDiscover(msg: RendezvousDiscover): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    if msg.hasNamespace:
        writeString(pb, 1, msg.namespace)
    if msg.hasLimit:
        writeVarint(pb, 2, msg.limit)
    if msg.hasCookie:
        writeBytes(pb, 3, msg.cookie)
    return protoToBytes(pb)

fn decodeRendezvousDiscover(data: Bytes): Result[RendezvousDiscover] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var out: RendezvousDiscover = initRendezvousDiscover()
    var ns: str
    let nsRes: Result[bool] = getField(pb, 1, ns)
    if IsErr(nsRes):
        return Err[RendezvousDiscover](Error(nsRes))
    if Value(nsRes):
        out.hasNamespace = true
        out.namespace = ns
    var limitVal: int64
    let limitRes: Result[bool] = getField(pb, 2, limitVal)
    if IsErr(limitRes):
        return Err[RendezvousDiscover](Error(limitRes))
    if Value(limitRes):
        out.hasLimit = true
        out.limit = limitVal
    var cookieVal: Bytes = EmptyBytes()
    let cookieRes: Result[bool] = getField(pb, 3, cookieVal)
    if IsErr(cookieRes):
        return Err[RendezvousDiscover](Error(cookieRes))
    if Value(cookieRes):
        out.hasCookie = true
        out.cookie = cookieVal
    return Ok[RendezvousDiscover](out)

fn encodeRendezvousDiscoverResponse(resp: RendezvousDiscoverResponse): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    for i in 0..<resp.registrationCount:
        writeBytes(pb, 1, encodeRendezvousRegister(resp.registrations[i]))
    if resp.hasCookie:
        writeBytes(pb, 2, resp.cookie)
    writeVarint(pb, 3, int64(resp.status))
    if resp.hasText:
        writeString(pb, 4, resp.text)
    return protoToBytes(pb)

fn decodeRendezvousDiscoverResponse(data: Bytes): Result[RendezvousDiscoverResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var out: RendezvousDiscoverResponse = initRendezvousDiscoverResponse()
    var regBytes: RepeatedBytes = initRepeatedBytes()
    let regsRes: Result[bool] = getRepeatedField(pb, 1, regBytes)
    if IsErr(regsRes):
        return Err[RendezvousDiscoverResponse](Error(regsRes))
    if Value(regsRes):
        for i in 0..<regBytes.count:
            if out.registrationCount >= maxRendezvousRegistrations:
                return Err[RendezvousDiscoverResponse]("rendezvous: too many registrations")
            let regRes: Result[RendezvousRegister] = decodeRendezvousRegister(regBytes.items[i])
            if IsErr(regRes):
                return Err[RendezvousDiscoverResponse](Error(regRes))
            out.registrations[out.registrationCount] = Value(regRes)
            out.registrationCount = out.registrationCount + 1
    var cookieVal: Bytes = EmptyBytes()
    let cookieRes: Result[bool] = getField(pb, 2, cookieVal)
    if IsErr(cookieRes):
        return Err[RendezvousDiscoverResponse](Error(cookieRes))
    if Value(cookieRes):
        out.hasCookie = true
        out.cookie = cookieVal
    var statusVal: int64
    let statusRes: Result[bool] = getRequiredField(pb, 3, statusVal)
    if IsErr(statusRes):
        return Err[RendezvousDiscoverResponse](Error(statusRes))
    let statusConv: Result[RendezvousResponseStatus] = rendezvousStatusFromInt(statusVal)
    if IsErr(statusConv):
        return Err[RendezvousDiscoverResponse](Error(statusConv))
    out.status = Value(statusConv)
    var textVal: str
    let textRes: Result[bool] = getField(pb, 4, textVal)
    if IsErr(textRes):
        return Err[RendezvousDiscoverResponse](Error(textRes))
    if Value(textRes):
        out.hasText = true
        out.text = textVal
    return Ok[RendezvousDiscoverResponse](out)

fn encodeRendezvousMessage(msg: RendezvousMessage): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, 1, int64(msg.msgType))
    if msg.hasRegister:
        writeBytes(pb, 2, encodeRendezvousRegister(msg.register))
    if msg.hasRegisterResponse:
        writeBytes(pb, 3, encodeRendezvousRegisterResponse(msg.registerResponse))
    if msg.hasUnregister:
        writeBytes(pb, 4, encodeRendezvousUnregister(msg.unregister))
    if msg.hasDiscover:
        writeBytes(pb, 5, encodeRendezvousDiscover(msg.discover))
    if msg.hasDiscoverResponse:
        writeBytes(pb, 6, encodeRendezvousDiscoverResponse(msg.discoverResponse))
    return protoToBytes(pb)

fn decodeRendezvousMessage(data: Bytes): Result[RendezvousMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: RendezvousMessage = initRendezvousMessage()
    var msgTypeVal: int64
    let typeRes: Result[bool] = getRequiredField(pb, 1, msgTypeVal)
    if IsErr(typeRes):
        return Err[RendezvousMessage](Error(typeRes))
    let typeConv: Result[RendezvousMessageType] = rendezvousMessageTypeFromInt(msgTypeVal)
    if IsErr(typeConv):
        return Err[RendezvousMessage](Error(typeConv))
    msg.msgType = Value(typeConv)
    var regBytes: Bytes = EmptyBytes()
    let regRes: Result[bool] = getField(pb, 2, regBytes)
    if IsErr(regRes):
        return Err[RendezvousMessage](Error(regRes))
    if Value(regRes):
        let regValRes: Result[RendezvousRegister] = decodeRendezvousRegister(regBytes)
        if IsErr(regValRes):
            return Err[RendezvousMessage](Error(regValRes))
        msg.hasRegister = true
        msg.register = Value(regValRes)
    var respBytes: Bytes = EmptyBytes()
    let respRes: Result[bool] = getField(pb, 3, respBytes)
    if IsErr(respRes):
        return Err[RendezvousMessage](Error(respRes))
    if Value(respRes):
        let respValRes: Result[RendezvousRegisterResponse] = decodeRendezvousRegisterResponse(respBytes)
        if IsErr(respValRes):
            return Err[RendezvousMessage](Error(respValRes))
        msg.hasRegisterResponse = true
        msg.registerResponse = Value(respValRes)
    var unregBytes: Bytes = EmptyBytes()
    let unregRes: Result[bool] = getField(pb, 4, unregBytes)
    if IsErr(unregRes):
        return Err[RendezvousMessage](Error(unregRes))
    if Value(unregRes):
        let unregValRes: Result[RendezvousUnregister] = decodeRendezvousUnregister(unregBytes)
        if IsErr(unregValRes):
            return Err[RendezvousMessage](Error(unregValRes))
        msg.hasUnregister = true
        msg.unregister = Value(unregValRes)
    var discoverBytes: Bytes = EmptyBytes()
    let discoverRes: Result[bool] = getField(pb, 5, discoverBytes)
    if IsErr(discoverRes):
        return Err[RendezvousMessage](Error(discoverRes))
    if Value(discoverRes):
        let discoverValRes: Result[RendezvousDiscover] = decodeRendezvousDiscover(discoverBytes)
        if IsErr(discoverValRes):
            return Err[RendezvousMessage](Error(discoverValRes))
        msg.hasDiscover = true
        msg.discover = Value(discoverValRes)
    var drBytes: Bytes = EmptyBytes()
    let drRes: Result[bool] = getField(pb, 6, drBytes)
    if IsErr(drRes):
        return Err[RendezvousMessage](Error(drRes))
    if Value(drRes):
        let drValRes: Result[RendezvousDiscoverResponse] = decodeRendezvousDiscoverResponse(drBytes)
        if IsErr(drValRes):
            return Err[RendezvousMessage](Error(drValRes))
        msg.hasDiscoverResponse = true
        msg.discoverResponse = Value(drValRes)
    return Ok[RendezvousMessage](msg)
