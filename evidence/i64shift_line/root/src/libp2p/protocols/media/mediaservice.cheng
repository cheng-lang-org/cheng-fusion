# Media service protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/media/protobuf
const
    mediaCodec = "/libp2p/media/1.0.0"
    mediaDefaultMaxMessage = 4194304

type
    MediaConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    MediaHandler = fn(req: MediaRequest): MediaResponse

    MediaContext =
        config: MediaConfig
        hasHandler: bool
        handler: MediaHandler

var
    mediaContext: MediaContext = MediaContext(
        config: MediaConfig(maxMessageBytes: mediaDefaultMaxMessage, closeAfterResponse: true),
        hasHandler: false
    )

fn initMediaConfig(): MediaConfig =
    MediaConfig(maxMessageBytes: mediaDefaultMaxMessage, closeAfterResponse: true)

fn setMediaConfig(config: MediaConfig) =
    mediaContext.config = config

fn setMediaHandler(handler: MediaHandler) =
    mediaContext.handler = handler
    mediaContext.hasHandler = true

fn readMediaRequest(stream: var Stream): Result[MediaRequest] =
    let dataRes: Result[Bytes] = readLp(stream, mediaContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[MediaRequest](Error(dataRes))
    return decodeMediaRequest(Value(dataRes))

fn writeMediaRequest(stream: var Stream, req: MediaRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeMediaRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readMediaResponse(stream: var Stream): Result[MediaResponse] =
    let dataRes: Result[Bytes] = readLp(stream, mediaContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[MediaResponse](Error(dataRes))
    return decodeMediaResponse(Value(dataRes))

fn writeMediaResponse(stream: var Stream, resp: MediaResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeMediaResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultMediaHandler(req: MediaRequest): MediaResponse =
    req
    var resp: MediaResponse = initMediaResponse()
    resp.ok = true
    resp.message = "ok"
    return resp

fn mediaHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[MediaRequest] = readMediaRequest(streamVar)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: MediaRequest = Value(reqRes)
    var resp: MediaResponse
    if mediaContext.hasHandler:
        let handler: MediaHandler = mediaContext.handler
        resp = handler(req)
    else:
        resp = defaultMediaHandler(req)
    let writeRes: Result[bool] = writeMediaResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if mediaContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn mediaProtocol(): Lp2pProtocol =
    return newProtocol(mediaCodec, mediaHandler)
