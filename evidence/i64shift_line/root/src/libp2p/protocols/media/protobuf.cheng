# Media protobuf messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
const
    mediaReqIdField = 1
    mediaReqOffsetField = 2
    mediaReqLimitField = 3

    mediaRespOkField = 1
    mediaRespMessageField = 2
    mediaRespDataField = 3
    mediaRespNextOffsetField = 4
    mediaRespEofField = 5
    mediaRespSizeField = 6

type
    MediaRequest =
        mediaId: str
        offset: int64
        limit: int32

    MediaResponse =
        ok: bool
        message: str
        data: Bytes
        nextOffset: int64
        eof: bool
        sizeBytes: int64

fn initMediaRequest(): MediaRequest =
    MediaRequest(mediaId: "", offset: 0, limit: 0)

fn initMediaResponse(): MediaResponse =
    MediaResponse(ok: false, message: "", data: EmptyBytes(), nextOffset: 0, eof: false, sizeBytes: 0)

fn encodeMediaRequest(req: MediaRequest): Result[Bytes] =
    if len(req.mediaId) <= 0:
        return Err[Bytes]("media: empty media id")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, mediaReqIdField, req.mediaId)
    if req.offset != 0:
        writeVarint(pb, mediaReqOffsetField, req.offset)
    if req.limit > 0:
        writeVarint(pb, mediaReqLimitField, int64(req.limit))
    return Ok[Bytes](protoToBytes(pb))

fn decodeMediaRequest(data: Bytes): Result[MediaRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: MediaRequest = initMediaRequest()
    var mediaId: str
    let idRes: Result[bool] = getField(pb, mediaReqIdField, mediaId)
    if IsErr(idRes):
        return Err[MediaRequest](Error(idRes))
    if Value(idRes):
        req.mediaId = mediaId
    var offsetVal: int64
    let offRes: Result[bool] = getField(pb, mediaReqOffsetField, offsetVal)
    if IsErr(offRes):
        return Err[MediaRequest](Error(offRes))
    if Value(offRes):
        req.offset = offsetVal
    var limitVal: int64
    let limRes: Result[bool] = getField(pb, mediaReqLimitField, limitVal)
    if IsErr(limRes):
        return Err[MediaRequest](Error(limRes))
    if Value(limRes):
        req.limit = int32(limitVal)
    if len(req.mediaId) <= 0:
        return Err[MediaRequest]("media: empty media id")
    return Ok[MediaRequest](req)

fn encodeMediaResponse(resp: MediaResponse): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if resp.ok:
        writeVarint(pb, mediaRespOkField, 1)
    if len(resp.message) > 0:
        writeString(pb, mediaRespMessageField, resp.message)
    if BytesLen(resp.data) > 0:
        writeBytes(pb, mediaRespDataField, resp.data)
    if resp.nextOffset != 0:
        writeVarint(pb, mediaRespNextOffsetField, resp.nextOffset)
    if resp.eof:
        writeVarint(pb, mediaRespEofField, 1)
    if resp.sizeBytes > 0:
        writeVarint(pb, mediaRespSizeField, resp.sizeBytes)
    return Ok[Bytes](protoToBytes(pb))

fn decodeMediaResponse(data: Bytes): Result[MediaResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: MediaResponse = initMediaResponse()
    var okVal: int64
    let okRes: Result[bool] = getField(pb, mediaRespOkField, okVal)
    if IsErr(okRes):
        return Err[MediaResponse](Error(okRes))
    if Value(okRes):
        resp.ok = okVal != 0
    var msg: str
    let msgRes: Result[bool] = getField(pb, mediaRespMessageField, msg)
    if IsErr(msgRes):
        return Err[MediaResponse](Error(msgRes))
    if Value(msgRes):
        resp.message = msg
    var payload: Bytes = EmptyBytes()
    let dataRes: Result[bool] = getField(pb, mediaRespDataField, payload)
    if IsErr(dataRes):
        return Err[MediaResponse](Error(dataRes))
    if Value(dataRes):
        resp.data = payload
    var nextVal: int64
    let nextRes: Result[bool] = getField(pb, mediaRespNextOffsetField, nextVal)
    if IsErr(nextRes):
        return Err[MediaResponse](Error(nextRes))
    if Value(nextRes):
        resp.nextOffset = nextVal
    var eofVal: int64
    let eofRes: Result[bool] = getField(pb, mediaRespEofField, eofVal)
    if IsErr(eofRes):
        return Err[MediaResponse](Error(eofRes))
    if Value(eofRes):
        resp.eof = eofVal != 0
    var sizeVal: int64
    let sizeRes: Result[bool] = getField(pb, mediaRespSizeField, sizeVal)
    if IsErr(sizeRes):
        return Err[MediaResponse](Error(sizeRes))
    if Value(sizeRes):
        resp.sizeBytes = sizeVal
    return Ok[MediaResponse](resp)
