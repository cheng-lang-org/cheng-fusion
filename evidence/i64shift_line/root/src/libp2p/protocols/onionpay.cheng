# Onion pay protocol helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
import cheng/libp2p/peerid
import cheng/libp2p/crypto/sha256
import std/crypto/rand
const
    onionCodec = "/onion/1.0.0"
    onionFlagFinal = 0x01
    onionNonceSize = 12
    onionRouteIdSize = 8
    onionSecretSize = 32
    onionEphemeralPkSize = 33
    maxOnionHops = 16

type
    OnionRouteId = Bytes

    OnionRouteHop =
        peer: PeerId
        secret: Bytes
        ttl: int32

    OnionHopList =
        count: int32
        items: OnionRouteHop[maxOnionHops]

    OnionRoute =
        id: OnionRouteId
        hops: OnionHopList

    PeerIdOpt =
        has: bool
        value: PeerId

    OnionPacket =
        routeId: OnionRouteId
        ephemeralPk: Bytes
        payload: Bytes

    OnionLayerResult =
        nextPeer: PeerIdOpt
        ttl: int32
        payload: Bytes
        isFinal: bool

fn nonePeerId(): PeerIdOpt =
    PeerIdOpt(has: false)

fn somePeerId(value: PeerId): PeerIdOpt =
    PeerIdOpt(has: true, value: value)

fn initHopList(): OnionHopList =
    OnionHopList(count: 0)

fn hopListAdd(list: var OnionHopList, hop: OnionRouteHop): Result[bool] =
    if list.count >= maxOnionHops:
        return Err[bool]("onion: hop list full")
    list.items[list.count] = hop
    list.count = list.count + 1
    return Ok[bool](true)

fn hopListCount(list: OnionHopList): int32 =
    list.count

fn hopListGet(list: OnionHopList, index: int32): OnionRouteHop =
    if index < 0 || index >= list.count:
        return OnionRouteHop(peer: peerIdFromTextUnchecked(""), secret: EmptyBytes(), ttl: 0)
    return list.items[index]

fn makeRouteId(data: Bytes): Result[OnionRouteId] =
    if BytesLen(data) != onionRouteIdSize:
        return Err[OnionRouteId]("onion: route id size")
    return Ok[OnionRouteId](data)

fn randomRouteId(): OnionRouteId =
    let res: Result[Bytes] = rand.randomBytes(onionRouteIdSize)
    if IsOk(res):
        let id: Bytes = Value(res)
        var nonZero: bool
        for i in 0..<BytesLen(id):
            if BytesGet(id, i) != 0:
                nonZero = true
                break
        if ! nonZero:
            BytesSet(id, 0, 0xAA)
        return id
    let digest: Bytes = Sha256Digest(BytesFromString("onion-route"))
    return BytesSlice(digest, 0, onionRouteIdSize)

fn encodeU16BE(value: int32): Bytes =
    let out: Bytes = BytesAlloc(2)
    BytesSet(out, 0, (value >> 8) & 0xFF)
    BytesSet(out, 1, value & 0xFF)
    return out

fn decodeU16BE(data: Bytes, offset: int32): Result[int32] =
    if offset + 1 >= BytesLen(data):
        return Err[int32]("onion: truncated")
    let high: int32 = BytesGet(data, offset)
    let low: int32 = BytesGet(data, offset + 1)
    return Ok[int32]((high << 8) | low)

fn deriveKeystream(secret: Bytes, nonce: Bytes, length: int32): Bytes =
    var produced: int32
    var counter: int64
    let out: Bytes = BytesAlloc(length)
    while produced < length: # cheng-syntax-policy: allow-counting-while
        var ctx: Bytes = BytesConcat(secret, nonce)
        let ctr: Bytes = encodeUVarint(counter)
        ctx = BytesConcat(ctx, ctr)
        let digest: Bytes = Sha256Digest(ctx)
        var i: int32
        while i < BytesLen(digest) && produced < length: # cheng-syntax-policy: allow-counting-while
            BytesSet(out, produced, BytesGet(digest, i))
            produced = produced + 1
            i = i + 1
        counter = counter + 1
    return out

fn sealLayer(secret: Bytes, plaintext: Bytes): Result[Bytes] =
    if BytesLen(secret) != onionSecretSize:
        return Err[Bytes]("onion: invalid secret size")
    var nonce: Bytes = EmptyBytes()
    let nonceRes: Result[Bytes] = rand.randomBytes(onionNonceSize)
    if IsOk(nonceRes):
        nonce = Value(nonceRes)
    else:
        let digest: Bytes = Sha256Digest(plaintext)
        nonce = BytesSlice(digest, 0, onionNonceSize)
    let keystream: Bytes = deriveKeystream(secret, nonce, BytesLen(plaintext))
    let out: Bytes = BytesAlloc(onionNonceSize + BytesLen(plaintext))
    for i in 0..<onionNonceSize:
        BytesSet(out, i, BytesGet(nonce, i))
    for i in 0..<BytesLen(plaintext):
        BytesSet(out, onionNonceSize + i, BytesGet(plaintext, i) ^ BytesGet(keystream, i))
    return Ok[Bytes](out)

fn openLayer(secret: Bytes, ciphertext: Bytes): Result[Bytes] =
    if BytesLen(secret) != onionSecretSize:
        return Err[Bytes]("onion: invalid secret size")
    if BytesLen(ciphertext) <= onionNonceSize:
        return Err[Bytes]("onion: layer too short")
    let nonce: Bytes = BytesSlice(ciphertext, 0, onionNonceSize)
    let dataLen: int32 = BytesLen(ciphertext) - onionNonceSize
    let keystream: Bytes = deriveKeystream(secret, nonce, dataLen)
    let plain: Bytes = BytesAlloc(dataLen)
    for i in 0..<dataLen:
        BytesSet(plain, i, BytesGet(ciphertext, onionNonceSize + i) ^ BytesGet(keystream, i))
    return Ok[Bytes](plain)

fn encodeHeader(routeId: OnionRouteId, nextPeer: PeerIdOpt, ttl: int32, isFinal: bool): Result[Bytes] =
    if BytesLen(routeId) != onionRouteIdSize:
        return Err[Bytes]("onion: invalid route id")
    var buf: GrowByteBuffer = newByteBuffer()
    let flags: int32 = if isFinal: onionFlagFinal else: 0
    appendByte(buf, flags)
    let ttlBytes: Bytes = encodeU16BE(ttl)
    appendBytes(buf, ttlBytes)
    appendBytes(buf, routeId)
    if nextPeer.has:
        let peerRes: Result[Bytes] = toBytes(nextPeer.value)
        if IsErr(peerRes):
            return Err[Bytes]("onion: peer id bytes")
        let peerBytes: Bytes = Value(peerRes)
        if BytesLen(peerBytes) > 0xFFFF:
            return Err[Bytes]("onion: peer id too long")
        appendBytes(buf, encodeU16BE(BytesLen(peerBytes)))
        appendBytes(buf, peerBytes)
    else:
        appendBytes(buf, encodeU16BE(0))
    return Ok[Bytes](toBytes(buf))

fn decodeHeader(routeId: OnionRouteId, plain: Bytes): Result[OnionLayerResult] =
    if BytesLen(plain) < 1 + 2 + onionRouteIdSize + 2:
        return Err[OnionLayerResult]("onion: layer too short")
    var offset: int32
    let flags: int32 = BytesGet(plain, offset)
    offset = offset + 1
    let ttlRes: Result[int32] = decodeU16BE(plain, offset)
    if IsErr(ttlRes):
        return Err[OnionLayerResult](Error(ttlRes))
    let ttl: int32 = Value(ttlRes)
    offset = offset + 2
    for i in 0..<onionRouteIdSize:
        if BytesGet(plain, offset + i) != BytesGet(routeId, i):
            return Err[OnionLayerResult]("onion: route mismatch")
    offset = offset + onionRouteIdSize
    let peerLenRes: Result[int32] = decodeU16BE(plain, offset)
    if IsErr(peerLenRes):
        return Err[OnionLayerResult](Error(peerLenRes))
    let peerLen: int32 = Value(peerLenRes)
    offset = offset + 2
    var nextPeer: PeerIdOpt = nonePeerId()
    if peerLen > 0:
        if offset + peerLen > BytesLen(plain):
            return Err[OnionLayerResult]("onion: peer id truncated")
        let peerBytes: Bytes = BytesSlice(plain, offset, peerLen)
        let pidRes: Result[PeerId] = peerIdFromBytes(peerBytes)
        if IsErr(pidRes):
            return Err[OnionLayerResult]("onion: peer id decode")
        nextPeer = somePeerId(Value(pidRes))
        offset = offset + peerLen
    let payload: Bytes = BytesSlice(plain, offset, BytesLen(plain) - offset)
    return Ok[OnionLayerResult](OnionLayerResult(
        nextPeer: nextPeer,
        ttl: ttl,
        payload: payload,
        isFinal: (flags && onionFlagFinal) != 0
    ))

fn buildOnionPacket(route: OnionRoute, ephemeralPk: Bytes, payload: Bytes): Result[OnionPacket] =
    if hopListCount(route.hops) <= 0:
        return Err[OnionPacket]("onion: empty route")
    if BytesLen(route.id) != onionRouteIdSize:
        return Err[OnionPacket]("onion: route id size")
    if BytesLen(ephemeralPk) > 0 && BytesLen(ephemeralPk) != onionEphemeralPkSize:
        return Err[OnionPacket]("onion: invalid ephemeral pk size")
    var envelope: Bytes = payload
    var downstream: PeerIdOpt = nonePeerId()
    var idx: int32 = hopListCount(route.hops) - 1
    let loop_start_idx_5 = idx
    for loop_rev_idx_5 in 0..(loop_start_idx_5 - (0)):
        idx = loop_start_idx_5 - loop_rev_idx_5
        if ! (idx >= 0):
            break
        let hop: OnionRouteHop = hopListGet(route.hops, idx)
        let headerRes: Result[Bytes] = encodeHeader(route.id, downstream, hop.ttl, idx == hopListCount(route.hops) - 1)
        if IsErr(headerRes):
            return Err[OnionPacket](Error(headerRes))
        let header: Bytes = Value(headerRes)
        let layer: Bytes = BytesConcat(header, envelope)
        let sealedRes: Result[Bytes] = sealLayer(hop.secret, layer)
        if IsErr(sealedRes):
            return Err[OnionPacket](Error(sealedRes))
        envelope = Value(sealedRes)
        downstream = somePeerId(hop.peer)
    return Ok[OnionPacket](OnionPacket(routeId: route.id, ephemeralPk: ephemeralPk, payload: envelope))

fn buildOnionPacket(route: OnionRoute, payload: Bytes): Result[OnionPacket] =
    return buildOnionPacket(route, EmptyBytes(), payload)

fn peelOnionLayer(packet: var OnionPacket, secret: Bytes): Result[OnionLayerResult] =
    let plainRes: Result[Bytes] = openLayer(secret, packet.payload)
    if IsErr(plainRes):
        return Err[OnionLayerResult](Error(plainRes))
    let decodedRes: Result[OnionLayerResult] =
        decodeHeader(packet.routeId, Value(plainRes))
    if IsErr(decodedRes):
        return Err[OnionLayerResult](Error(decodedRes))
    let decoded = Value(decodedRes)
    packet.payload = decoded.payload
    return Ok[OnionLayerResult](OnionLayerResult(
        nextPeer: decoded.nextPeer,
        ttl: decoded.ttl,
        payload: decoded.payload,
        isFinal: decoded.isFinal
    ))

fn isComplete(packet: OnionPacket): bool =
    BytesLen(packet.payload) == 0
