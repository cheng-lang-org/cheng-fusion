# Kademlia lookup state(fixed-size shortlist).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/bytes
import cheng/libp2p/peerid
import cheng/libp2p/peerinfo
import cheng/libp2p/peerstore
import cheng/libp2p/protocols/kademlia/consts
import cheng/libp2p/protocols/kademlia/keys
import cheng/libp2p/protocols/kademlia/xordistance
import cheng/libp2p/protocols/kademlia/protobuf as kadpb
import std/seqs
const
    maxLookupPeers = 64

type
    LookupNode =
        peerId: PeerId
        distance: XorDistance
        queried: bool
        pending: bool
        failed: bool

    LookupPeerList =
        count: int32
        items: PeerId[]

    LookupState =
        targetId: Key
        shortlistCount: int32
        shortlist: LookupNode[]
        activeQueries: int32
        alpha: int32
        repliCount: int32
        done: bool

fn initLookupPeerList(): LookupPeerList =
    var out: LookupPeerList
    out.count = 0
    return out

fn lookupPeerListAdd(list: var LookupPeerList, pid: PeerId): bool =
    if list.count >= maxLookupPeers:
        return false
    add(list.items, pid)
    list.count = list.items.len
    return true

fn peerIdEqualSafe(a: PeerId, b: PeerId): bool =
    let eqRes: Result[bool] = peerIdEqual(a, b)
    if IsErr(eqRes):
        return false
    return Value(eqRes)

fn lookupContainsPeer(state: LookupState, pid: PeerId): bool =
    for i in 0..<state.shortlistCount:
        if peerIdEqualSafe(state.shortlist[i].peerId, pid):
            return true
    return false

fn lookupContainsPeerBytes(state: LookupState, pidBytes: Bytes): bool =
    for i in 0..<state.shortlistCount:
        let bytesRes: Result[Bytes] = toBytes(state.shortlist[i].peerId)
        if IsOk(bytesRes):
            if BytesEqual(Value(bytesRes), pidBytes):
                return true
    return false

fn lookupInsert(state: var LookupState, node: LookupNode) =
    let limit: int32 = maxLookupPeers
    var pos: int32 = state.shortlistCount
    for scanPos in 0..<state.shortlistCount:
        if xorDistanceCmp(node.distance, state.shortlist[scanPos].distance) < 0:
            pos = scanPos
            break
    if state.shortlistCount < limit:
        setLen(state.shortlist, state.shortlistCount + 1)
        var i: int32 = state.shortlistCount
        let loop_start_i_4 = i
        for loop_rev_i_4 in 0..(loop_start_i_4 - (pos)):
            i = loop_start_i_4 - loop_rev_i_4
            if ! (i > pos):
                break
            state.shortlist[i] = state.shortlist[i - 1]
        state.shortlist[pos] = node
        state.shortlistCount = state.shortlist.len
        return
    if pos >= limit:
        return
    var j: int32 = limit - 1
    let loop_start_j_5 = j
    for loop_rev_j_5 in 0..(loop_start_j_5 - (pos)):
        j = loop_start_j_5 - loop_rev_j_5
        if ! (j > pos):
            break
        state.shortlist[j] = state.shortlist[j - 1]
    state.shortlist[pos] = node

fn kadPeerToPeerInfo(peer: KadPeer): Result[PeerInfo] =
    if BytesLen(peer.id) <= 0:
        return Err[PeerInfo]("kad: missing peer id")
    let pidRes: Result[PeerId] = peerIdFromBytes(peer.id)
    if IsErr(pidRes):
        return Err[PeerInfo](Error(pidRes))
    var info: PeerInfo = newPeerInfo(Value(pidRes))
    info.addrs = peer.addrs
    return Ok[PeerInfo](info)

fn updateShortlist(state: var LookupState, msg: KadMessage, peerStore: var PeerStore, hasher: Option[XorHasher]) =
    for i in 0..<msg.closerCount:
        let peer: KadPeer = msg.closerPeers[i]
        if BytesLen(peer.id) > 0 && ! lookupContainsPeerBytes(state, peer.id):
            let infoRes: Result[PeerInfo] = kadPeerToPeerInfo(peer)
            if IsOk(infoRes):
                let info: PeerInfo = Value(infoRes)
                mergePeer(peerStore, info)
                let keyRes: Result[Key] = keyFromPeerId(info.id)
                if IsOk(keyRes):
                    let dist: XorDistance = xorDistance(Value(keyRes), state.targetId, hasher)
                    let node: LookupNode = LookupNode(
                        peerId: info.id,
                        distance: dist,
                        queried: false,
                        pending: false,
                        failed: false
                    )
                    lookupInsert(state, node)
    if state.activeQueries > 0:
        state.activeQueries = state.activeQueries - 1

fn markFailed(state: var LookupState, peerId: PeerId) =
    for i in 0..<state.shortlistCount:
        if peerIdEqualSafe(state.shortlist[i].peerId, peerId):
            state.shortlist[i].failed = true
            state.shortlist[i].pending = false
            state.shortlist[i].queried = true
            if state.activeQueries > 0:
                state.activeQueries = state.activeQueries - 1
            break
fn markPending(state: var LookupState, peerId: PeerId) =
    for i in 0..<state.shortlistCount:
        if peerIdEqualSafe(state.shortlist[i].peerId, peerId):
            state.shortlist[i].pending = true
            state.shortlist[i].queried = true
            break
fn selectAlphaPeers(state: LookupState): LookupPeerList =
    var selected: LookupPeerList = initLookupPeerList()
    for i in 0..<state.shortlistCount:
        if ! (i < state.shortlistCount && selected.count < state.alpha):
            break
        let node: LookupNode = state.shortlist[i]
        if ! node.queried && ! node.failed && ! node.pending:
            lookupPeerListAdd(selected, node.peerId)
    return selected

fn initLookupState(targetId: Key, initialPeers: LookupPeerList, hasher: Option[XorHasher]): LookupState =
    var state: LookupState = LookupState(
        targetId: targetId,
        shortlistCount: 0,
        activeQueries: 0,
        alpha: alpha,
        repliCount: defaultReplic,
        done: false
    )
    for i in 0..<initialPeers.count:
        let pid: PeerId = initialPeers.items[i]
        if ! lookupContainsPeer(state, pid):
            let keyRes: Result[Key] = keyFromPeerId(pid)
            if IsOk(keyRes):
                let dist: XorDistance = xorDistance(Value(keyRes), targetId, hasher)
                let node: LookupNode = LookupNode(
                    peerId: pid,
                    distance: dist,
                    queried: false,
                    pending: false,
                    failed: false
                )
                lookupInsert(state, node)
    return state

fn selectClosestK(state: LookupState): LookupPeerList =
    var selected: LookupPeerList = initLookupPeerList()
    for i in 0..<state.shortlistCount:
        if ! (i < state.shortlistCount && selected.count < state.repliCount):
            break
        let node: LookupNode = state.shortlist[i]
        if ! node.failed:
            lookupPeerListAdd(selected, node.peerId)
    return selected
