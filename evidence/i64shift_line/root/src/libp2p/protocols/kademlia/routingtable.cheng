# Kademlia routing table(fixed-size).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/bytes
import std/times
import cheng/libp2p/peerid
import cheng/libp2p/protocols/kademlia/consts
import cheng/libp2p/protocols/kademlia/keys
import cheng/libp2p/protocols/kademlia/xordistance
import std/seqs
const
    maxClosestKeys = 64
    staleAfterNs = int64(1800) * int64(1000000000)

type
    NodeEntry =
        nodeId: Key
        lastSeenNs: int64

    Bucket =
        count: int32
        peers: NodeEntry[]

    RoutingTable =
        selfId: Key
        bucketCount: int32
        buckets: Bucket[]
        hasher: Option[XorHasher]

    ClosestEntry =
        key: Key
        dist: XorDistance

    ClosestList =
        count: int32
        items: ClosestEntry[]

    KeyList =
        count: int32
        items: Key[]

    PeerIdList =
        count: int32
        items: PeerId[]

fn initRoutingTable(selfId: Key): RoutingTable =
    var out: RoutingTable
    out.selfId = selfId
    out.bucketCount = 0
    out.hasher = None[XorHasher]()
    setLen(out.buckets, maxBuckets)
    return out

fn setHasher(rt: var RoutingTable, hasher: XorHasher) =
    rt.hasher = Some[XorHasher](hasher)

fn bucketIndex(selfId: Key, key: Key, hasher: Option[XorHasher]): int32 =
    let dist: XorDistance = xorDistance(selfId, key, hasher)
    let idx: int32 = leadingZeros(dist)
    if idx < 0:
        return 0
    if idx >= maxBuckets:
        return maxBuckets - 1
    return idx

fn bucketFindIndex(bucket: Bucket, nodeId: Key): int32 =
    for i in 0..<bucket.count:
        if keyEqual(bucket.peers[i].nodeId, nodeId):
            return i
    return -1

fn bucketOldestIndex(bucket: Bucket): int32 =
    if bucket.count <= 0:
        return -1
    var oldestIdx: int32
    var oldestTime: int64 = bucket.peers[0].lastSeenNs
    for i in 1..<bucket.count:
        if bucket.peers[i].lastSeenNs < oldestTime:
            oldestTime = bucket.peers[i].lastSeenNs
            oldestIdx = i
    return oldestIdx

fn bucketReplaceOldest(bucket: var Bucket, nodeId: Key, nowNs: int64): bool =
    if bucket.count < defaultReplic:
        return false
    let idx: int32 = bucketOldestIndex(bucket)
    if idx < 0:
        return false
    if keyEqual(bucket.peers[idx].nodeId, nodeId):
        return false
    bucket.peers[idx] = NodeEntry(nodeId: cloneKey(nodeId), lastSeenNs: nowNs)
    return true

fn insertKey(rt: var RoutingTable, nodeId: Key): bool =
    if keyEqual(nodeId, rt.selfId):
        return false
    let idx: int32 = bucketIndex(rt.selfId, nodeId, rt.hasher)
    if idx >= maxBuckets:
        return false
    if idx >= rt.bucketCount:
        rt.bucketCount = idx + 1
    var bucket: Bucket = rt.buckets[idx]
    let nowNs: int64 = EpochTimeNs()
    let existingIdx: int32 = bucketFindIndex(bucket, nodeId)
    if existingIdx >= 0:
        bucket.peers[existingIdx].lastSeenNs = nowNs
        rt.buckets[idx] = bucket
        return true
    if bucket.count < defaultReplic:
        add(bucket.peers, NodeEntry(nodeId: cloneKey(nodeId), lastSeenNs: nowNs))
        bucket.count = bucket.peers.len
        rt.buckets[idx] = bucket
        return true
    if bucketReplaceOldest(bucket, nodeId, nowNs):
        rt.buckets[idx] = bucket
        return true
    return false

fn insertPeer(rt: var RoutingTable, peerId: PeerId): Result[bool] =
    let keyRes: Result[Key] = keyFromPeerId(peerId)
    if IsErr(keyRes):
        return Err[bool](Error(keyRes))
    return Ok[bool](insertKey(rt, Value(keyRes)))

fn isBucketStale(bucket: Bucket, nowNs: int64): bool =
    if bucket.count <= 0:
        return true
    for i in 0..<bucket.count:
        let age: int64 = nowNs - bucket.peers[i].lastSeenNs
        if age > staleAfterNs:
            return true
    return false

fn insertClosest(list: var ClosestList, entry: ClosestEntry, limit: int32) =
    if limit <= 0:
        return
    var pos: int32 = list.count
    for scanPos in 0..<list.count:
        if xorDistanceCmp(entry.dist, list.items[scanPos].dist) < 0:
            pos = scanPos
            break
    if list.count < limit:
        setLen(list.items, list.count + 1)
        var i: int32 = list.count
        let loop_start_i_5 = i
        for loop_rev_i_5 in 0..(loop_start_i_5 - (pos)):
            i = loop_start_i_5 - loop_rev_i_5
            if ! (i > pos):
                break
            list.items[i] = list.items[i - 1]
        list.items[pos] = entry
        list.count = list.items.len
        return
    if pos >= limit:
        return
    var j: int32 = limit - 1
    let loop_start_j_6 = j
    for loop_rev_j_6 in 0..(loop_start_j_6 - (pos)):
        j = loop_start_j_6 - loop_rev_j_6
        if ! (j > pos):
            break
        list.items[j] = list.items[j - 1]
    list.items[pos] = entry

fn findClosestKeys(rt: RoutingTable, target: Key, count: int32): KeyList =
    var out: KeyList = KeyList(count: 0)
    var list: ClosestList = ClosestList(count: 0)
    let want: int32 = if count <= 0: defaultReplic else: count
    let limit: int32 = if want > maxClosestKeys: maxClosestKeys else: want
    for i in 0..<rt.bucketCount:
        let bucket: Bucket = rt.buckets[i]
        var j: int32
        for j in 0..<bucket.count:
            if ! (j < bucket.count):
                break
            let key: Key = bucket.peers[j].nodeId
            let dist: XorDistance = xorDistance(key, target, rt.hasher)
            insertClosest(list, ClosestEntry(key: key, dist: dist), limit)
    for k in 0..<list.count:
        if ! (k < list.count && k < limit):
            break
        add(out.items, list.items[k].key)
        out.count = out.items.len
    return out

fn keyListAt(list: KeyList, idx: int32): Key =
    return list.items[idx]

fn findClosestPeers(rt: RoutingTable, target: Key, count: int32): PeerIdList =
    var out: PeerIdList = PeerIdList(count: 0)
    var keys: KeyList = findClosestKeys(rt, target, count)
    for i in 0..<keys.count:
        let pidRes: Result[PeerId] = keyToPeerId(keyListAt(keys, i))
        if IsOk(pidRes):
            add(out.items, Value(pidRes))
            out.count = out.items.len
    return out
