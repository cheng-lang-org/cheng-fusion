# Kademlia XOR distance helpers.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/sha256
import cheng/libp2p/protocols/kademlia/consts
import cheng/libp2p/protocols/kademlia/keys
type
    XorDistance = Bytes
    XorHasher = fn(input: Bytes): Bytes

fn fitHash(data: Bytes): Bytes =
    if BytesLen(data) == idLength:
        return data
    let out: Bytes = BytesAlloc(idLength)
    let n: int32 = if BytesLen(data) < idLength: BytesLen(data) else: idLength
    for i in 0..<n:
        BytesSet(out, i, BytesGet(data, i))
    return out

fn defaultHasher(input: Bytes): Bytes =
    return fitHash(Sha256Digest(input))

fn noOpHasher(input: Bytes): Bytes =
    return fitHash(input)

fn hashFor(key: Key, hasher: Option[XorHasher]): Bytes =
    if hasher.has:
        return fitHash(hasher.value(key))
    return defaultHasher(key)

fn countLeadingZeroBits(value: int32): int32 =
    for i in 0..<8:
        let mask: int32x80 >> i
        if (value && mask) != 0:
            return i
    return 8

fn leadingZeros(dist: XorDistance): int32 =
    let total: int32 = BytesLen(dist)
    for i in 0..<total:
        let v: int32 = BytesGet(dist, i)
        if v != 0:
            return i * 8 + countLeadingZeroBits(v)
    return total * 8

fn xorDistance(a: Key, b: Key, hasher: Option[XorHasher]): XorDistance =
    let hashA: Bytes = hashFor(a, hasher)
    let hashB: Bytes = hashFor(b, hasher)
    let out: Bytes = BytesAlloc(idLength)
    for i in 0..<idLength:
        let v: int32 = BytesGet(hashA, i) ^ BytesGet(hashB, i)
        BytesSet(out, i, v)
    return out

fn xorDistanceCmp(a: XorDistance, b: XorDistance): int32 =
    for i in 0..<idLength:
        let av: int32 = BytesGet(a, i)
        let bv: int32 = BytesGet(b, i)
        if av < bv:
            return -1
        if av > bv:
            return 1
    return 0
