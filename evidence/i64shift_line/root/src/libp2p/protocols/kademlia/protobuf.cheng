# Kademlia protobuf messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/option
import cheng/libp2p/utils/multiaddrlist
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/multiaddress
const
    maxKadPeers = 32

type
    KadRecord =
        hasKey: bool
        key: Bytes
        hasValue: bool
        value: Bytes
        hasTime: bool
        timeReceived: str

    KadMessageType = enum
        kadPutValue = 0
        kadGetValue = 1
        kadAddProvider = 2
        kadGetProviders = 3
        kadFindNode = 4
        kadPing = 5

    KadConnectionType = enum
        kadNotConnected = 0
        kadConnected = 1
        kadCanConnect = 2
        kadCannotConnect = 3

    KadPeer =
        id: Bytes
        addrs: MultiAddressList
        hasConnection: bool
        connection: KadConnectionType

    KadMessage =
        msgType: KadMessageType
        hasKey: bool
        key: Bytes
        hasRecord: bool
        record: KadRecord
        closerCount: int32
        closerPeers: KadPeer[maxKadPeers]
        providerCount: int32
        providerPeers: KadPeer[maxKadPeers]

fn initKadRecord(): KadRecord =
    KadRecord(hasKey: false, hasValue: false, hasTime: false, key: EmptyBytes(), value: EmptyBytes())

fn initKadPeer(): KadPeer =
    KadPeer(id: EmptyBytes(), addrs: initMultiAddressList(), hasConnection: false, connection: kadNotConnected)

fn initKadMessage(): KadMessage =
    KadMessage(
        msgType: kadFindNode,
        hasKey: false,
        hasRecord: false,
        key: EmptyBytes(),
        record: initKadRecord(),
        closerCount: 0,
        providerCount: 0
    )

fn encodeKadRecord(rec: KadRecord): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    if rec.hasKey:
        writeBytes(pb, 1, rec.key)
    if rec.hasValue:
        writeBytes(pb, 2, rec.value)
    if rec.hasTime:
        writeString(pb, 5, rec.timeReceived)
    return protoToBytes(pb)

fn decodeKadRecord(data: Bytes): Result[KadRecord] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var rec: KadRecord = initKadRecord()
    var key: Bytes = EmptyBytes()
    let keyRes: Result[bool] = getField(pb, 1, key)
    if IsErr(keyRes):
        return Err[KadRecord](Error(keyRes))
    if Value(keyRes):
        rec.hasKey = true
        rec.key = key
    var value: Bytes = EmptyBytes()
    let valueRes: Result[bool] = getField(pb, 2, value)
    if IsErr(valueRes):
        return Err[KadRecord](Error(valueRes))
    if Value(valueRes):
        rec.hasValue = true
        rec.value = value
    var timeText: str
    let timeRes: Result[bool] = getField(pb, 5, timeText)
    if IsErr(timeRes):
        return Err[KadRecord](Error(timeRes))
    if Value(timeRes):
        rec.hasTime = true
        rec.timeReceived = timeText
    return Ok[KadRecord](rec)

fn encodeKadPeer(peer: KadPeer): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeBytes(pb, 1, peer.id)
    for i in 0..<peer.addrs.count:
        let addrBytes: Bytes = peer.addrs.items[i].data
        writeBytes(pb, 2, addrBytes)
    if peer.hasConnection:
        writeVarint(pb, 3, int64(peer.connection))
    return protoToBytes(pb)

fn decodeKadPeer(data: Bytes): Result[KadPeer] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var peer: KadPeer = initKadPeer()
    var idBytes: Bytes = EmptyBytes()
    let idRes: Result[bool] = getField(pb, 1, idBytes)
    if IsErr(idRes):
        return Err[KadPeer](Error(idRes))
    if ! Value(idRes):
        return Err[KadPeer]("kad: missing peer id")
    peer.id = idBytes
    var addrs: RepeatedBytes = initRepeatedBytes()
    let addRes: Result[bool] = getRepeatedField(pb, 2, addrs)
    if IsErr(addRes):
        return Err[KadPeer](Error(addRes))
    if Value(addRes):
        for i in 0..<addrs.count:
            let parseRes: Result[MultiAddress] = parseMultiAddressBytes(addrs.items[i])
            if IsErr(parseRes):
                return Err[KadPeer](Error(parseRes))
            let addAddrRes: Result[bool] = multiAddressListAdd(peer.addrs, Value(parseRes))
            if IsErr(addAddrRes):
                return Err[KadPeer](Error(addAddrRes))
    var connVal: int64
    let connRes: Result[bool] = getField(pb, 3, connVal)
    if IsErr(connRes):
        return Err[KadPeer](Error(connRes))
    if Value(connRes):
        if connVal < 0 || connVal > 3:
            return Err[KadPeer]("kad: invalid connection")
        peer.hasConnection = true
        peer.connection = KadConnectionType(connVal)
    return Ok[KadPeer](peer)

fn encodeKadMessage(msg: KadMessage): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, 1, int64(msg.msgType))
    if msg.hasKey:
        writeBytes(pb, 2, msg.key)
    if msg.hasRecord:
        writeBytes(pb, 3, encodeKadRecord(msg.record))
    for i in 0..<msg.closerCount:
        writeBytes(pb, 8, encodeKadPeer(msg.closerPeers[i]))
    for i in 0..<msg.providerCount:
        writeBytes(pb, 9, encodeKadPeer(msg.providerPeers[i]))
    return protoToBytes(pb)

fn decodeKadMessage(data: Bytes): Result[KadMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: KadMessage = initKadMessage()
    var msgTypeVal: int64 = -1
    let typeRes: Result[bool] = getField(pb, 1, msgTypeVal)
    if IsErr(typeRes):
        return Err[KadMessage](Error(typeRes))
    if ! Value(typeRes):
        return Err[KadMessage]("kad: missing message type")
    if msgTypeVal < 0 || msgTypeVal > 5:
        return Err[KadMessage]("kad: invalid message type")
    msg.msgType = KadMessageType(msgTypeVal)
    var keyBytes: Bytes = EmptyBytes()
    let keyRes: Result[bool] = getField(pb, 2, keyBytes)
    if IsErr(keyRes):
        return Err[KadMessage](Error(keyRes))
    if Value(keyRes):
        msg.hasKey = true
        msg.key = keyBytes
    var recBytes: Bytes = EmptyBytes()
    let recRes: Result[bool] = getField(pb, 3, recBytes)
    if IsErr(recRes):
        return Err[KadMessage](Error(recRes))
    if Value(recRes):
        let recValRes: Result[KadRecord] = decodeKadRecord(recBytes)
        if IsErr(recValRes):
            return Err[KadMessage](Error(recValRes))
        msg.hasRecord = true
        msg.record = Value(recValRes)
    var closer: RepeatedBytes = initRepeatedBytes()
    let closerRes: Result[bool] = getRepeatedField(pb, 8, closer)
    if IsErr(closerRes):
        return Err[KadMessage](Error(closerRes))
    if Value(closerRes):
        for i in 0..<closer.count:
            if msg.closerCount >= maxKadPeers:
                return Err[KadMessage]("kad: too many closer peers")
            let peerRes: Result[KadPeer] = decodeKadPeer(closer.items[i])
            if IsErr(peerRes):
                return Err[KadMessage](Error(peerRes))
            msg.closerPeers[msg.closerCount] = Value(peerRes)
            msg.closerCount = msg.closerCount + 1
    var providers: RepeatedBytes = initRepeatedBytes()
    let provRes: Result[bool] = getRepeatedField(pb, 9, providers)
    if IsErr(provRes):
        return Err[KadMessage](Error(provRes))
    if Value(provRes):
        for j in 0..<providers.count:
            if msg.providerCount >= maxKadPeers:
                return Err[KadMessage]("kad: too many provider peers")
            let peerRes: Result[KadPeer] = decodeKadPeer(providers.items[j])
            if IsErr(peerRes):
                return Err[KadMessage](Error(peerRes))
            msg.providerPeers[msg.providerCount] = Value(peerRes)
            msg.providerCount = msg.providerCount + 1
    return Ok[KadMessage](msg)
