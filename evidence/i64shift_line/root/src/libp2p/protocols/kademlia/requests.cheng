# Kademlia request helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/stream/lpstream
import cheng/libp2p/peerid
import cheng/libp2p/peerstore
import cheng/libp2p/utils/multiaddrlist
import cheng/libp2p/protocols/kademlia/keys
import cheng/libp2p/protocols/kademlia/routingtable
import cheng/libp2p/protocols/kademlia/protobuf as kadpb
const
    kadRequestMaxMessage = 1048576

fn peerToKadPeer(peerId: PeerId, store: PeerStore): Result[KadPeer] =
    let pidBytesRes: Result[Bytes] = toBytes(peerId)
    if IsErr(pidBytesRes):
        return Err[KadPeer](Error(pidBytesRes))
    let addrRes: Result[MultiAddressList] = getPeerAddresses(store, peerId)
    if IsErr(addrRes):
        return Err[KadPeer](Error(addrRes))
    let addrs: MultiAddressList = Value(addrRes)
    if addrs.count <= 0:
        return Err[KadPeer]("kad: missing peer addresses")
    var peer: KadPeer = initKadPeer()
    peer.id = Value(pidBytesRes)
    peer.addrs = addrs
    return Ok[KadPeer](peer)

fn encodeFindNodeReplyKeys(closer: KeyList, store: PeerStore): Result[Bytes] =
    var msg: KadMessage = initKadMessage()
    msg.msgType = kadFindNode
    for i in 0..<closer.count:
        if ! (i < closer.count && msg.closerCount < maxKadPeers):
            break
        let pidRes: Result[PeerId] = keyToPeerId(closer.items[i])
        if IsOk(pidRes):
            let peerRes: Result[KadPeer] = peerToKadPeer(Value(pidRes), store)
            if IsOk(peerRes):
                msg.closerPeers[msg.closerCount] = Value(peerRes)
                msg.closerCount = msg.closerCount + 1
    if msg.closerCount <= 0:
        return Err[Bytes]("kad: no peers to encode")
    return Ok[Bytes](encodeKadMessage(msg))

fn encodeFindNodeReplyPeers(closer: PeerIdList, store: PeerStore): Result[Bytes] =
    var msg: KadMessage = initKadMessage()
    msg.msgType = kadFindNode
    for i in 0..<closer.count:
        if ! (i < closer.count && msg.closerCount < maxKadPeers):
            break
        let peerRes: Result[KadPeer] = peerToKadPeer(closer.items[i], store)
        if IsOk(peerRes):
            msg.closerPeers[msg.closerCount] = Value(peerRes)
            msg.closerCount = msg.closerCount + 1
    if msg.closerCount <= 0:
        return Err[Bytes]("kad: no peers to encode")
    return Ok[Bytes](encodeKadMessage(msg))

fn writeKadMessage(stream: var Stream, msg: KadMessage): Result[bool] =
    let payload: Bytes = encodeKadMessage(msg)
    let writeRes: Result[int32] = writeLp(stream, payload)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readKadMessage(stream: var Stream): Result[KadMessage] =
    let dataRes: Result[Bytes] = readLp(stream, kadRequestMaxMessage)
    if IsErr(dataRes):
        return Err[KadMessage](Error(dataRes))
    return decodeKadMessage(Value(dataRes))

fn sendKadRequest(stream: var Stream, msg: KadMessage, expect: KadMessageType): Result[KadMessage] =
    let writeRes: Result[bool] = writeKadMessage(stream, msg)
    if IsErr(writeRes):
        return Err[KadMessage](Error(writeRes))
    let replyRes: Result[KadMessage] = readKadMessage(stream)
    if IsErr(replyRes):
        return Err[KadMessage](Error(replyRes))
    let reply: KadMessage = Value(replyRes)
    if reply.msgType != expect:
        return Err[KadMessage]("kad: unexpected reply type")
    return Ok[KadMessage](reply)

fn sendFindNode(stream: var Stream, target: Key): Result[KadMessage] =
    var msg: KadMessage = initKadMessage()
    msg.msgType = kadFindNode
    msg.hasKey = true
    msg.key = target
    return sendKadRequest(stream, msg, kadFindNode)

fn sendGetValue(stream: var Stream, key: Key): Result[KadMessage] =
    var msg: KadMessage = initKadMessage()
    msg.msgType = kadGetValue
    msg.hasKey = true
    msg.key = key
    return sendKadRequest(stream, msg, kadGetValue)

fn sendPutValue(stream: var Stream, key: Key, record: KadRecord): Result[KadMessage] =
    var msg: KadMessage = initKadMessage()
    msg.msgType = kadPutValue
    msg.hasKey = true
    msg.key = key
    var rec: KadRecord = record
    rec.hasKey = true
    rec.key = key
    msg.hasRecord = true
    msg.record = rec
    return sendKadRequest(stream, msg, kadPutValue)

fn sendAddProvider(stream: var Stream, key: Key, provider: KadPeer): Result[KadMessage] =
    var msg: KadMessage = initKadMessage()
    msg.msgType = kadAddProvider
    msg.hasKey = true
    msg.key = key
    msg.providerPeers[0] = provider
    msg.providerCount = 1
    return sendKadRequest(stream, msg, kadAddProvider)

fn sendGetProviders(stream: var Stream, key: Key): Result[KadMessage] =
    var msg: KadMessage = initKadMessage()
    msg.msgType = kadGetProviders
    msg.hasKey = true
    msg.key = key
    return sendKadRequest(stream, msg, kadGetProviders)
