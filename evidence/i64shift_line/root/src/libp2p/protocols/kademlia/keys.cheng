# Kademlia keys(PeerId-backed).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/peerid
type
    Key = Bytes

fn keyFromPeerId(peerId: PeerId): Result[Key] =
    return toBytes(peerId)

fn keyToPeerId(key: Key): Result[PeerId] =
    if BytesLen(key) <= 0:
        return Err[PeerId]("kademlia: empty key")
    return peerIdFromBytes(key)

fn cloneKey(key: Key): Key =
    if BytesLen(key) <= 0:
        return EmptyBytes()
    return BytesSlice(key, 0, BytesLen(key))

fn keyEqual(a: Key, b: Key): bool =
    return BytesEqual(a, b)

fn keyCmp(a: Key, b: Key): int32 =
    let aLen: int32 = BytesLen(a)
    let bLen: int32 = BytesLen(b)
    let minLen: int32 = if aLen < bLen: aLen else: bLen
    for i in 0..<minLen:
        let diff: int32 = BytesGet(a, i) - BytesGet(b, i)
        if diff != 0:
            return diff
    return aLen - bLen

fn keyHex(key: Key): str =
    return BytesToHex(key)
