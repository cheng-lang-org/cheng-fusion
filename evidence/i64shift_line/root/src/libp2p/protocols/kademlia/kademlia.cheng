# Kademlia state(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/bytes
import std/times
import cheng/libp2p/peerid
import cheng/libp2p/record
import cheng/libp2p/protocols/kademlia/keys
import cheng/libp2p/protocols/kademlia/routingtable
import cheng/libp2p/protocols/kademlia/protobuf as kadpb
import std/seqs
const
    maxKadValues = 64
    maxKadProviderKeys = 64
    maxKadProvidersPerKey = 16

type
    KadValueEntry =
        key: Key
        record: KadRecord
        updatedAtNs: int64

    KadProviderEntry =
        key: Key
        count: int32
        peers: KadPeer[]
        updatedAtNs: int64

    KadStore =
        valueCount: int32
        values: KadValueEntry[]
        providerCount: int32
        providers: KadProviderEntry[]

type
    KadState =
        selfId: PeerId
        routing: RoutingTable
        records: RecordStore
        store: KadStore

fn initKadStore(): KadStore =
    var out: KadStore
    out.valueCount = 0
    out.providerCount = 0
    return out

fn cloneBytesValue(data: Bytes): Bytes =
    if BytesLen(data) <= 0:
        return EmptyBytes()
    return BytesSlice(data, 0, BytesLen(data))

fn cloneKadRecord(rec: KadRecord): KadRecord =
    var out: KadRecord = initKadRecord()
    out.hasKey = rec.hasKey
    if rec.hasKey:
        out.key = cloneBytesValue(rec.key)
    out.hasValue = rec.hasValue
    if rec.hasValue:
        out.value = cloneBytesValue(rec.value)
    out.hasTime = rec.hasTime
    if rec.hasTime:
        out.timeReceived = rec.timeReceived
    return out

fn findValueIndex(store: KadStore, key: Key): int32 =
    for i in 0..<store.valueCount:
        if keyEqual(store.values[i].key, key):
            return i
    return -1

fn findProviderIndex(store: KadStore, key: Key): int32 =
    for i in 0..<store.providerCount:
        if keyEqual(store.providers[i].key, key):
            return i
    return -1

fn findOldestValueIndex(store: KadStore): int32 =
    if store.valueCount <= 0:
        return -1
    var oldestIdx: int32
    var oldestTime: int64 = store.values[0].updatedAtNs
    for i in 1..<store.valueCount:
        if store.values[i].updatedAtNs < oldestTime:
            oldestTime = store.values[i].updatedAtNs
            oldestIdx = i
    return oldestIdx

fn findOldestProviderIndex(store: KadStore): int32 =
    if store.providerCount <= 0:
        return -1
    var oldestIdx: int32
    var oldestTime: int64 = store.providers[0].updatedAtNs
    for i in 1..<store.providerCount:
        if store.providers[i].updatedAtNs < oldestTime:
            oldestTime = store.providers[i].updatedAtNs
            oldestIdx = i
    return oldestIdx

fn getKadValue(store: KadStore, key: Key): Option[KadRecord] =
    let idx: int32 = findValueIndex(store, key)
    if idx < 0:
        return None[KadRecord]()
    return Some[KadRecord](cloneKadRecord(store.values[idx].record))

fn putKadValue(store: var KadStore, key: Key, rec: KadRecord): bool =
    let nowNs: int64 = EpochTimeNs()
    let idx: int32 = findValueIndex(store, key)
    let entry: KadValueEntry = KadValueEntry(
        key: cloneKey(key),
        record: cloneKadRecord(rec),
        updatedAtNs: nowNs
    )
    if idx >= 0:
        store.values[idx] = entry
        return true
    if store.valueCount < maxKadValues:
        add(store.values, entry)
        store.valueCount = store.values.len
        return true
    let replaceIdx: int32 = findOldestValueIndex(store)
    if replaceIdx >= 0:
        store.values[replaceIdx] = entry
        return true
    return false

fn kadPeerIdEqual(a: KadPeer, b: KadPeer): bool =
    return BytesEqual(a.id, b.id)

fn addKadProvider(store: var KadStore, key: Key, peer: KadPeer): bool =
    let nowNs: int64 = EpochTimeNs()
    var idx: int32 = findProviderIndex(store, key)
    if idx < 0:
        if store.providerCount >= maxKadProviderKeys:
            let replaceIdx: int32 = findOldestProviderIndex(store)
            if replaceIdx < 0:
                return false
            idx = replaceIdx
            store.providers[idx] = KadProviderEntry(key: cloneKey(key), count: 0, updatedAtNs: nowNs)
        else:
            add(store.providers, KadProviderEntry(key: cloneKey(key), count: 0, updatedAtNs: nowNs))
            idx = store.providers.len - 1
            store.providerCount = store.providers.len
    var entry: KadProviderEntry = store.providers[idx]
    for i in 0..<entry.count:
        if kadPeerIdEqual(entry.peers[i], peer):
            entry.updatedAtNs = nowNs
            store.providers[idx] = entry
            return true
    if entry.count >= maxKadProvidersPerKey:
        entry.updatedAtNs = nowNs
        store.providers[idx] = entry
        return false
    add(entry.peers, peer)
    entry.count = entry.peers.len
    entry.updatedAtNs = nowNs
    store.providers[idx] = entry
    return true

fn getKadProviders(store: KadStore, key: Key): Option[KadProviderEntry] =
    let idx: int32 = findProviderIndex(store, key)
    if idx < 0:
        return None[KadProviderEntry]()
    return Some[KadProviderEntry](store.providers[idx])

fn initKadState(peerId: PeerId): Result[KadState] =
    let keyRes: Result[Key] = keyFromPeerId(peerId)
    if IsErr(keyRes):
        return Err[KadState](Error(keyRes))
    let rt: RoutingTable = initRoutingTable(Value(keyRes))
    let rs: RecordStore = initRecordStore()
    let store: KadStore = initKadStore()
    return Ok[KadState](KadState(selfId: peerId, routing: rt, records: rs, store: store))

fn kadInsertPeer(state: var KadState, peerId: PeerId): Result[bool] =
    return insertPeer(state.routing, peerId)

fn kadClosestPeers(state: KadState, target: PeerId, count: int32): Result[PeerIdList] =
    let keyRes: Result[Key] = keyFromPeerId(target)
    if IsErr(keyRes):
        return Err[PeerIdList](Error(keyRes))
    let peers: PeerIdList = findClosestPeers(state.routing, Value(keyRes), count)
    return Ok[PeerIdList](peers)
