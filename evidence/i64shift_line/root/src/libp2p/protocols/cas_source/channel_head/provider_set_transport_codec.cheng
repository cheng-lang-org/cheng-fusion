# libp2p P5-S2 发现层传输动词: provider-set 快照的网络请求/应答线格式 (设计 Part 2a)。
# SNAPSHOT_REQ / SNAPSHOT_RESP 是 cas-source 协议 (protocol id 25) 内的【新增动词】, 不是新协议:
# fresh node 取物前先经 SNAPSHOT_REQ(signerPubKey) 向 pinned 根索取该根签名的路由快照, 学到
# 更多 (channelId→endpoint) 后再走既有 HEAD_REQ/WANT/BLOCK。动词由帧首字节 tag 区分
# (WANT=0x01 / HEAD_REQ=0x11 / REVOKE_REQ=0x21 / DELEG_REQ=0x23 已占; SNAPSHOT_REQ=0x25 /
# SNAPSHOT_RESP=0x26 新增)。故 protocol id 复用 25, 不动 types.cheng。
#
# ★ 请求按 signerPubKey 索引 (镜像 HEAD_REQ 按 channelId 索引 head_store): fresh node 已 pin 根
#   公钥 (CHENG_CAS_BOOTSTRAP_KEYS), 向根请求"你那条由此 key 签的快照"; 应答方按 signerHex 查
#   provider_snapshots/<signerHex> 回快照线 (变长 ≥109B, tag 0x50), 缺记录回确定性 miss。
#
# 线格式 (big-endian):
#   SNAPSHOT_REQ:            [0x25][signerPubKey 32B]                     = 33 字节
#   SNAPSHOT_RESP (found):   [0x26][0x01][ snapshot_wire(变长 ≥109, tag 0x50) ]  ≥ 111 字节
#   SNAPSHOT_RESP (miss):    [0x26][0x00]                                 = 2 字节
#
# snapshot_wire 复用 provider_set_codec 的变长线格式 (ProviderSetEncode/Decode); 本模块只包一层
# 请求/应答信封, 不重解快照内部字段 (职责分离: 传输信封 vs 快照记录 codec)。外层 QUIC 帧已长度定界,
# 故 found 应答无需内嵌长度字段 (snapshot_wire = 应答体去掉 2B 头后的全部字节)。
#
# 生产纪律 (no fallback / let it crash): 畸形 (长度不符 / tag 错 / status 非 0-1 / found 但
# snapshot_wire < 109) 一律 Result Err, 绝不静默错解; 往返字节精确。

import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout

const
    CasSnapshotTagReq: int32 = 0x25
    CasSnapshotTagResp: int32 = 0x26
    casSnapshotReqWireLen: int32 = 33      # 1 tag + 32 signerPubKey
    casSnapshotPubKeyLen: int32 = 32
    casSnapshotRecordMinLen: int32 = 109   # provider-set 最小线长 (entryCount=0)
    casSnapshotRespMissWireLen: int32 = 2  # 1 tag + 1 status(0)

type
    CasSnapshotRespMsg =
        found: bool
        snapshotWire: Bytes   # found 时为变长快照记录线 (≥109B, tag 0x50); miss 时为空

# ---- SNAPSHOT_REQ: 请求方按 signerPubKey 索取该根签名的快照 ----

fn CasSnapshotReqEncode(signerPubKey: Bytes): Result[Bytes] =
    if BytesLen(signerPubKey) != casSnapshotPubKeyLen:
        return Err[Bytes]("cas_snapshot req: signerPubKey 必须 32B")
    var buf = layout.ByteBufInit(casSnapshotReqWireLen)
    layout.ByteBufAppendByte(buf, CasSnapshotTagReq)
    layout.ByteBufAppendBytes(buf, signerPubKey)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

fn CasSnapshotReqDecode(payload: Bytes): Result[Bytes] =
    if BytesLen(payload) != casSnapshotReqWireLen:
        return Err[Bytes]("cas_snapshot req: 线长非 33")
    if BytesGet(payload, 0) != CasSnapshotTagReq:
        return Err[Bytes]("cas_snapshot req: tag 不符 (非 SNAPSHOT_REQ)")
    return Ok[Bytes](BytesSlice(payload, 1, casSnapshotPubKeyLen))

# ---- SNAPSHOT_RESP: 应答方回签名快照记录 (found) 或缺记录标记 (miss) ----

fn CasSnapshotRespEncodeFound(snapshotWire: Bytes): Result[Bytes] =
    if BytesLen(snapshotWire) < casSnapshotRecordMinLen:
        return Err[Bytes]("cas_snapshot resp: snapshot_wire 长度不足 (< 109)")
    var buf = layout.ByteBufInit(BytesLen(snapshotWire) + 2)
    layout.ByteBufAppendByte(buf, CasSnapshotTagResp)
    layout.ByteBufAppendByte(buf, 1)
    layout.ByteBufAppendBytes(buf, snapshotWire)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

fn CasSnapshotRespEncodeMiss(): Bytes =
    var buf = layout.ByteBufInit(casSnapshotRespMissWireLen)
    layout.ByteBufAppendByte(buf, CasSnapshotTagResp)
    layout.ByteBufAppendByte(buf, 0)
    return layout.ByteBufToBytes(buf)

fn CasSnapshotRespDecode(payload: Bytes): Result[CasSnapshotRespMsg] =
    let total: int32 = BytesLen(payload)
    var msg: CasSnapshotRespMsg
    msg.found = false
    msg.snapshotWire = EmptyBytes()
    if total < 2:
        return Err[CasSnapshotRespMsg]("cas_snapshot resp: header 截断")
    if BytesGet(payload, 0) != CasSnapshotTagResp:
        return Err[CasSnapshotRespMsg]("cas_snapshot resp: tag 不符 (非 SNAPSHOT_RESP)")
    let status: int32 = BytesGet(payload, 1)
    if status == 0:
        if total != casSnapshotRespMissWireLen:
            return Err[CasSnapshotRespMsg]("cas_snapshot resp: miss 帧长非 2")
        msg.found = false
        return Ok[CasSnapshotRespMsg](msg)
    if status != 1:
        return Err[CasSnapshotRespMsg]("cas_snapshot resp: status 非 0/1")
    let bodyLen: int32 = total - 2
    if bodyLen < casSnapshotRecordMinLen:
        return Err[CasSnapshotRespMsg]("cas_snapshot resp: found 但 snapshot_wire < 109")
    msg.found = true
    msg.snapshotWire = BytesSlice(payload, 2, bodyLen)
    return Ok[CasSnapshotRespMsg](msg)
