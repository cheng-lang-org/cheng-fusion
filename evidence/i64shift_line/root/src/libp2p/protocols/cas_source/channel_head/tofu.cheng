# libp2p P3-prep TOFU (trust-on-first-use) channel 信任库 (正典 §11.6 P3)。
# 照 cas_store 的 lock 范式 (行式 key=value, '\n' 分隔, tmp+rename 原子写, 缺文件=空非错),
# 但语义关键区别: cas lock 是覆盖, TOFU 必须"首见记录+后续拒不覆盖"。
#
# 落盘: storeRoot + "/channel_trust.txt"; 行格式: channelIdHex=signerPubKeyHex,epochDec
#   (带 epoch 才能跨重启防回滚)。
#
# 双重门 (换钥 + 回滚新鲜度):
#   - 换钥: 同一 channelId 跨时间必须绑同一 signerPubKey; 不符 = 硬 Err (绝不静默覆盖)。
#   - 回滚: 新 epoch 必须严格 > 已存 epoch; 否则 = 硬 Err (重放/回滚拒)。
# channelId 自证 (=sha256(pubkey)) 已在 head_codec decode 层先绊一脚, TOFU 再加
# "跨时间同一 channelId 绑同一 pubkey" + 回滚新鲜度。let it crash, 不兜底。

import std/result
import std/rawbytes
import std/os
import std/strutils as strutil
import std/strings
import std/parseutils
import cheng/std/bytes_layout as layout

type
    TofuLookupResult =
        found: bool
        pubKeyHex: str
        epoch: int64

@borrows
fn TofuTrustPath(storeRoot: str): str =
    return storeRoot + "/channel_trust.txt"

@borrows
fn TofuLoad(storeRoot: str): Result[str[]] =
    var lines: str[]
    if storeRoot == "":
        return Ok[str[]](lines)
    let path = TofuTrustPath(storeRoot)
    if !os.FileExists(path):
        return Ok[str[]](lines)
    var readRes: Result[str] = os.ReadFileResult(path)
    if IsErr(readRes):
        return Err[str[]]("tofu: trust read failed: " + path)
    lines = strutil.Split(Value(readRes), '\n')
    return Ok[str[]](lines)

# 行式扫描: channelIdHex=pubKeyHex,epochDec; 跳过空行/畸形行 (parts!=2 / rhs 无逗号)。
@borrows
fn TofuLookup(lines: str[], channelIdHex: str): TofuLookupResult =
    var out: TofuLookupResult
    out.found = false
    out.pubKeyHex = ""
    out.epoch = 0
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        if line == "":
            continue
        let parts = strutil.Split(line, '=')
        if parts.len != 2:
            continue
        if strutil.Strip(parts[0]) != channelIdHex:
            continue
        let rhs = strutil.Strip(parts[1])
        let rparts = strutil.Split(rhs, ',')
        if rparts.len != 2:
            continue
        out.found = true
        out.pubKeyHex = strutil.Strip(rparts[0])
        var ep: int64
        let _consumed = parseutils.parseInt64(strutil.Strip(rparts[1]), ep)
        out.epoch = ep
        return out
    return out

# 首见 → 记录; 后续 → 换钥拒 + 回滚拒; 接受时原子重写该行 (tmp+rename)。
@borrows
fn TofuAdmit(storeRoot: str, channelId: layout.FixedBytes32, signerPubKey: Bytes, epoch: int64): Result[bool] =
    if storeRoot == "":
        return Err[bool]("tofu: empty storeRoot")
    if BytesLen(signerPubKey) != 32:
        return Err[bool]("tofu: signerPubKey 必须 32B")
    let channelIdHex = layout.FixedBytes32Hex(channelId)
    let pubKeyHex = rawbytes.BytesToHex(signerPubKey)
    var loadRes: Result[str[]] = TofuLoad(storeRoot)
    if IsErr(loadRes):
        return Err[bool](Error(loadRes))
    let existing = Value(loadRes)
    let prior = TofuLookup(existing, channelIdHex)
    if prior.found:
        if prior.pubKeyHex != pubKeyHex:
            return Err[bool]("tofu: channel key change rejected channel=" + channelIdHex)
        if epoch <= prior.epoch:
            return Err[bool]("tofu: epoch rollback rejected channel=" + channelIdHex + " have=" + strings.Int64ToStr(prior.epoch) + " got=" + strings.Int64ToStr(epoch))
    # 重建全部行 (found → 替换该 channelId 行; 未 found → 追加)
    var rebuilt = ""
    for i in 0..<existing.len:
        let line = strutil.Strip(existing[i])
        if line == "":
            continue
        let parts = strutil.Split(line, '=')
        if parts.len == 2 && strutil.Strip(parts[0]) != channelIdHex:
            rebuilt = rebuilt + strutil.Strip(parts[0]) + "=" + strutil.Strip(parts[1]) + "\n"
    rebuilt = rebuilt + channelIdHex + "=" + pubKeyHex + "," + strings.Int64ToStr(epoch) + "\n"
    os.MkdirAll(storeRoot, 493)
    let path = TofuTrustPath(storeRoot)
    let tmpPath = path + ".tmp"
    if os.FileExists(tmpPath):
        os.RemoveFile(tmpPath)
    var wr: Result[bool] = os.WriteFileResult(tmpPath, rebuilt)
    if !wr.ok:
        os.RemoveFile(tmpPath)
        return Err[bool]("tofu: tmp write failed: " + tmpPath)
    if os.RenameFile(tmpPath, path):
        return Ok[bool](true)
    os.RemoveFile(tmpPath)
    return Err[bool]("tofu: rename failed: " + path)
