# libp2p P3-prep 本地原语: 签名 channel-head 记录的线格式 codec + 签验 (正典 §11.6 P3)。
# compiler-world 栈 (照 S1 codec 先例): rawbytes.Bytes + layout.FixedBytes32 + 固定长 + 单 tag。
# 设计参考 signed_envelope 的域分离规范字节 (signatureBuffer 先写 domain), 但不复用其代码
# (signed_envelope 走 protobuf + crypto/crypto 的 case-int64, 编不进 stage3; 见 P3-prep 裁决)。
#
# 自证式身份: channelId = sha256(signerPubKey)。未 pin 的 import 经签名 head 解到 cid 时,
# channelId 把 head 钉死在授权签名者公钥上 (换钥/伪造 channelId 立即被 decode 层绊倒),
# 签名再证明持有对应私钥。
#
# 线格式 (固定 201 字节, big-endian, 单 tag 0x10):
#   [0x10][channelId 32][epoch u64-be 8][headCid 32][prevHeadCid 32][signerPubKey 32][sig 64]
#
# 签名输入 (域分离规范字节, 非随手拼接):
#   DOMAIN ++ channelId(32) ++ epoch(u64-be 8) ++ headCid(32) ++ prevHeadCid(32) ++ signerPubKey(32)
#   (除 sig 外全字段规范序; DOMAIN 固定 ASCII 前缀防跨协议签名重用)
#
# 生产纪律 (no fallback / let it crash): 畸形 (线长非 201 / tag 错 / channelId 不绑 pubkey)
#   一律 Result Err, 绝不静默错解; 往返字节精确。签名 = 真 ed25519 (非 stub)。
#
# ★ crypto 状态: ed25519 验签已实测健全 (2026-07-06 双门实证 REAL_VERIFY, D-1/D-2 已入
#   seed 六修世代); 历史退化案卷见 findings。ChannelHeadSign/ChannelHeadVerify 密码正确性
#   与结构层 (encode/decode/binding) 均生产可用。

import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/libp2p/crypto/ed25519/ed25519 as ed

const
    channelHeadTag: int32 = 0x10
    channelHeadWireLen: int32 = 201
    channelHeadPubKeyLen: int32 = 32
    channelHeadSigLen: int32 = 64
    channelHeadDomain: str = "cheng/libp2p/channel-head/v1"

type
    ChannelHeadRecord =
        channelId: layout.FixedBytes32     # = sha256(signerPubKey), 自证身份
        epoch: int64                       # u64 单调计数
        headCid: layout.FixedBytes32       # 指向 root manifest cid
        prevHeadCid: layout.FixedBytes32   # 链式回溯 (genesis 全 0)
        signerPubKey: Bytes                # 32B raw ed25519 公钥
        sig: Bytes                         # 64B raw ed25519 签名

# ---- 身份 / genesis 原语 ----

@borrows
fn ChannelIdForPubKey(pubKey: Bytes): layout.FixedBytes32 =
    return hash256.Sha256Fixed(layout.ByteSpanFromBytes(pubKey))

fn ChannelHeadGenesisPrev(): layout.FixedBytes32 =
    var z: layout.FixedBytes32
    return z

# ---- u64 big-endian 编解码 (照 sha512 已验证的 int64 移位口径) ----

fn channelHeadAppendU64BE(buf: var layout.ByteBuf, value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 56) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 48) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 40) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 32) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, int32(value & 255))

fn channelHeadReadU64BE(payload: Bytes, off: int32): int64 =
    let b0: int64 = int64(BytesGet(payload, off))
    let b1: int64 = int64(BytesGet(payload, off + 1))
    let b2: int64 = int64(BytesGet(payload, off + 2))
    let b3: int64 = int64(BytesGet(payload, off + 3))
    let b4: int64 = int64(BytesGet(payload, off + 4))
    let b5: int64 = int64(BytesGet(payload, off + 5))
    let b6: int64 = int64(BytesGet(payload, off + 6))
    let b7: int64 = int64(BytesGet(payload, off + 7))
    return (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7

# ---- 域分离规范签名输入 (除 sig 外全字段规范序) ----

fn channelHeadSigningInput(record: ChannelHeadRecord): Bytes =
    var buf = layout.ByteBufInit(channelHeadWireLen)
    layout.ByteBufAppendBytes(buf, rawbytes.BytesFromString(channelHeadDomain))
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(record.channelId))
    channelHeadAppendU64BE(buf, record.epoch)
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(record.headCid))
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(record.prevHeadCid))
    layout.ByteBufAppendBytes(buf, record.signerPubKey)
    return layout.ByteBufToBytes(buf)

# ---- 编码 (纯序列化, 无 crypto; 字段长硬校验) ----

@borrows
fn ChannelHeadEncode(record: ChannelHeadRecord): Result[Bytes] =
    if BytesLen(record.signerPubKey) != channelHeadPubKeyLen:
        return Err[Bytes]("channel_head: signerPubKey 必须 32B")
    if BytesLen(record.sig) != channelHeadSigLen:
        return Err[Bytes]("channel_head: sig 必须 64B")
    var buf = layout.ByteBufInit(channelHeadWireLen)
    layout.ByteBufAppendByte(buf, channelHeadTag)
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(record.channelId))
    channelHeadAppendU64BE(buf, record.epoch)
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(record.headCid))
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(record.prevHeadCid))
    layout.ByteBufAppendBytes(buf, record.signerPubKey)
    layout.ByteBufAppendBytes(buf, record.sig)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

# ---- 解码 (纯反序列化 + 自证绑定校验; 无签名验证, 签验是 ChannelHeadVerify) ----
# 结构层: 固定长/tag 校验 + channelId==sha256(signerPubKey) 绑定 (伪造 channelId 立拒)。
# 签名密码验证单独走 ChannelHeadVerify (gated on ed25519 修复)。

@borrows
fn ChannelHeadDecode(payload: Bytes): Result[ChannelHeadRecord] =
    if BytesLen(payload) != channelHeadWireLen:
        return Err[ChannelHeadRecord]("channel_head: 线长非 201")
    if BytesGet(payload, 0) != channelHeadTag:
        return Err[ChannelHeadRecord]("channel_head: tag 不符")
    var rec: ChannelHeadRecord
    var cidRes = layout.FixedBytes32FromBytes(BytesSlice(payload, 1, 32))
    if IsErr(cidRes):
        return Err[ChannelHeadRecord]("channel_head: channelId 非 32B")
    rec.channelId = Value(cidRes)
    rec.epoch = channelHeadReadU64BE(payload, 33)
    var headRes = layout.FixedBytes32FromBytes(BytesSlice(payload, 41, 32))
    if IsErr(headRes):
        return Err[ChannelHeadRecord]("channel_head: headCid 非 32B")
    rec.headCid = Value(headRes)
    var prevRes = layout.FixedBytes32FromBytes(BytesSlice(payload, 73, 32))
    if IsErr(prevRes):
        return Err[ChannelHeadRecord]("channel_head: prevHeadCid 非 32B")
    rec.prevHeadCid = Value(prevRes)
    rec.signerPubKey = BytesSlice(payload, 105, 32)
    rec.sig = BytesSlice(payload, 137, 64)
    # 自证绑定 (非 crypto, sha256 可靠): channelId 必须 == sha256(signerPubKey)
    let expect = ChannelIdForPubKey(rec.signerPubKey)
    if !layout.FixedBytes32Equal(expect, rec.channelId):
        return Err[ChannelHeadRecord]("channel_head: channelId 与 signerPubKey 不绑 (拒伪造 channelId)")
    return Ok[ChannelHeadRecord](rec)

# ---- 签名 (真 ed25519, 域分离规范字节) ----
# priv = 64B (seed||pub); channelId 由 signerPubKey 自证派生。
# ★ 密码正确性已实测健全 (ed25519 REAL_VERIFY, 2026-07-06 双门实证)。

fn ChannelHeadSign(priv: Bytes, epoch: int64, headCid: layout.FixedBytes32, prevHeadCid: layout.FixedBytes32, signerPubKey: Bytes): Result[ChannelHeadRecord] =
    if BytesLen(signerPubKey) != channelHeadPubKeyLen:
        return Err[ChannelHeadRecord]("channel_head: signerPubKey 必须 32B")
    if BytesLen(priv) != 64:
        return Err[ChannelHeadRecord]("channel_head: priv 必须 64B (seed||pub)")
    var rec: ChannelHeadRecord
    rec.channelId = ChannelIdForPubKey(signerPubKey)
    rec.epoch = epoch
    rec.headCid = headCid
    rec.prevHeadCid = prevHeadCid
    rec.signerPubKey = signerPubKey
    rec.sig = EmptyBytes()
    let input = channelHeadSigningInput(rec)
    var sigRes = ed.signEd25519Raw(priv, input)
    if IsErr(sigRes):
        return Err[ChannelHeadRecord](Error(sigRes))
    rec.sig = Value(sigRes)
    return Ok[ChannelHeadRecord](rec)

# ---- 验签 (真 ed25519 + 自证绑定 + 域分离规范字节重建) ----
# 拒: pubkey/sig 非法长 / channelId 不绑 pubkey / 签名不匹配规范字节。
# ★ 密码正确性已实测健全: verifyEd25519 = REAL_VERIFY (2026-07-06 双门实证, 翻转 sig
#   一字节即拒); 结构半 (长度 + channelId 绑定) 与签名半均生产可用, 历史退化案卷见 findings。

@borrows
fn ChannelHeadVerify(record: ChannelHeadRecord): bool =
    if BytesLen(record.signerPubKey) != channelHeadPubKeyLen:
        return false
    if BytesLen(record.sig) != channelHeadSigLen:
        return false
    let expect = ChannelIdForPubKey(record.signerPubKey)
    if !layout.FixedBytes32Equal(expect, record.channelId):
        return false
    let input = channelHeadSigningInput(record)
    return ed.verifyEd25519(record.signerPubKey, input, record.sig)
