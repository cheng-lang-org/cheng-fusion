# libp2p P3 正片: 应答方 (A) 的签名 channel-head 库 (正典 §11.6 P3)。
# "库里有 channel head 记录" 的具体落盘: channelIdHex → 201B head 记录线 (head_codec 编码)。
# 照 cas_store blob 的 tmp+rename 原子上位; 但语义是【可覆盖】 (A 推进 epoch 1→2 时重写该
# channel 的 head 记录, 覆盖旧 head) —— 与 tofu 的"首见不覆盖"相反, 这是发布方自己的库。
#
# 落盘: storeRoot + "/channel_heads/" + channelIdHex  (原始 201B 字节, 无二次封装)。
#
# 生产纪律 (no fallback / let it crash): storeRoot 空 / 记录编码非法 / 读回非 201B = 硬 Err。
# PutWire 存原始字节 (供应答方按发布策略写入任意 head 线, 客户端侧全权校验签名/绑定/TOFU)。

import std/result
import std/os
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head

fn ChannelHeadStoreDir(storeRoot: str): str =
    return storeRoot + "/channel_heads"

fn ChannelHeadStorePath(storeRoot: str, channelIdHex: str): str =
    return ChannelHeadStoreDir(storeRoot) + "/" + channelIdHex

# 原始 201B head 线写入 (可覆盖上位)。channelIdHex 是索引键, wire 是被索引的字节。
fn ChannelHeadStorePutWire(storeRoot: str, channelIdHex: str, wire: var Bytes): Result[bool] =
    if storeRoot == "":
        return Err[bool]("head store: empty storeRoot")
    if channelIdHex == "":
        return Err[bool]("head store: empty channelIdHex")
    if BytesLen(wire) != 201:
        return Err[bool]("head store: wire 必须 201B")
    let dir = ChannelHeadStoreDir(storeRoot)
    os.MkdirAll(dir, 493)
    let finalPath = ChannelHeadStorePath(storeRoot, channelIdHex)
    let tmpPath = finalPath + ".tmp"
    if os.FileExists(tmpPath):
        os.RemoveFile(tmpPath)
    var wr: Result[bool] = os.WriteFileBytesResult(tmpPath, wire)
    if !wr.ok:
        os.RemoveFile(tmpPath)
        return Err[bool]("head store: tmp write failed: " + tmpPath)
    if os.RenameFile(tmpPath, finalPath):
        return Ok[bool](true)
    os.RemoveFile(tmpPath)
    return Err[bool]("head store: rename failed: " + finalPath)

# 记录级写入 (先编码为 201B 线再存)。channelId 由记录自带, 索引键 = channelId hex。
fn ChannelHeadStorePut(storeRoot: str, record: head.ChannelHeadRecord): Result[bool] =
    var encRes = head.ChannelHeadEncode(record)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let channelIdHex = layout.FixedBytes32Hex(record.channelId)
    var wire = Value(encRes)
    return ChannelHeadStorePutWire(storeRoot, channelIdHex, wire)

# 按 channelIdHex 读回 201B head 线 (缺记录 = 硬 Err, 无磁盘兜底)。
fn ChannelHeadStoreGetWire(storeRoot: str, channelIdHex: str): Result[Bytes] =
    if storeRoot == "":
        return Err[Bytes]("head store: empty storeRoot")
    let path = ChannelHeadStorePath(storeRoot, channelIdHex)
    if !os.FileExists(path):
        return Err[Bytes]("head store: no head for channel=" + channelIdHex)
    var readRes: Result[Bytes] = os.ReadFileBytesResult(path)
    if IsErr(readRes):
        return Err[Bytes]("head store: read failed: " + path)
    var wire = Value(readRes)
    if BytesLen(wire) != 201:
        return Err[Bytes]("head store: stored wire 非 201B channel=" + channelIdHex)
    return Ok[Bytes](wire)

# 存在性预筛 (不读盘内容)。
fn ChannelHeadStoreHas(storeRoot: str, channelIdHex: str): bool =
    if storeRoot == "":
        return false
    return os.FileExists(ChannelHeadStorePath(storeRoot, channelIdHex))
