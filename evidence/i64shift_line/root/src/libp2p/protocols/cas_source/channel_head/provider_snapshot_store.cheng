# libp2p P5-S2 发现层落盘: pinned 根签名 provider-set 快照库 + per-根单调 epoch 基线 (设计 2c)。
# 镜像 head_store 落盘纪律 (tmp+rename 原子上位, 缺记录=硬 Err), 但快照线是变长 (≥109B, 非 201B)。
#
# 落盘:
#   <storeRoot>/provider_snapshots/<signerHex>          = 变长 provider-set 快照线 (0x50 记录原始字节)
#   <storeRoot>/provider_snapshots/<signerHex>.epoch    = 该根 last-seen epoch 十进制单调基线
# (signerHex 是 64 位十六进制无点, 与 ".epoch" 后缀不冲突。)
#
# epoch 基线语义 (照撤销/TOFU 严格单调 admit 先例): 收到快照 epoch 必须严格 > 已存基线才采纳,
#   否则拒为陈旧 (rollback 防护)。首见 (无基线文件) = 基线 0, 任何 epoch>0 首采。
#   —— 单调只保护路由不被回滚, 非硬安全门 (内容自证 + 撤销 UNION 仍在下游兜底, 设计 2c)。
#
# 生产纪律 (no fallback / let it crash): storeRoot 空 / 写失败 / 读回不足最小线长 / 基线文件非法
#   整数 = 硬 Err, 绝不静默兜底。

import std/result
import std/os
import std/strutils as strutil
import std/strings
import std/parseutils

fn ProviderSnapshotStoreDir(storeRoot: str): str =
    return storeRoot + "/provider_snapshots"

fn ProviderSnapshotStorePath(storeRoot: str, signerHex: str): str =
    return ProviderSnapshotStoreDir(storeRoot) + "/" + signerHex

fn ProviderSnapshotEpochPath(storeRoot: str, signerHex: str): str =
    return ProviderSnapshotStoreDir(storeRoot) + "/" + signerHex + ".epoch"

# ---- 变长快照线写入 (可覆盖上位; signerHex 是索引键) ----

fn ProviderSnapshotStorePutWire(storeRoot: str, signerHex: str, wire: var Bytes): Result[bool] =
    if storeRoot == "":
        return Err[bool]("provider snapshot store: empty storeRoot")
    if signerHex == "":
        return Err[bool]("provider snapshot store: empty signerHex")
    if BytesLen(wire) < 109:
        return Err[bool]("provider snapshot store: wire 长度不足 (< 109)")
    let dir = ProviderSnapshotStoreDir(storeRoot)
    os.MkdirAll(dir, 493)
    let finalPath = ProviderSnapshotStorePath(storeRoot, signerHex)
    let tmpPath = finalPath + ".wtmp"
    if os.FileExists(tmpPath):
        os.RemoveFile(tmpPath)
    var wr: Result[bool] = os.WriteFileBytesResult(tmpPath, wire)
    if !wr.ok:
        os.RemoveFile(tmpPath)
        return Err[bool]("provider snapshot store: tmp write failed: " + tmpPath)
    if os.RenameFile(tmpPath, finalPath):
        return Ok[bool](true)
    os.RemoveFile(tmpPath)
    return Err[bool]("provider snapshot store: rename failed: " + finalPath)

# ---- 按 signerHex 读回变长快照线 (缺记录 = 硬 Err, 无磁盘兜底) ----

fn ProviderSnapshotStoreGetWire(storeRoot: str, signerHex: str): Result[Bytes] =
    if storeRoot == "":
        return Err[Bytes]("provider snapshot store: empty storeRoot")
    let path = ProviderSnapshotStorePath(storeRoot, signerHex)
    if !os.FileExists(path):
        return Err[Bytes]("provider snapshot store: no snapshot for signer=" + signerHex)
    var readRes: Result[Bytes] = os.ReadFileBytesResult(path)
    if IsErr(readRes):
        return Err[Bytes]("provider snapshot store: read failed: " + path)
    var wire = Value(readRes)
    if BytesLen(wire) < 109:
        return Err[Bytes]("provider snapshot store: stored wire 长度不足 signer=" + signerHex)
    return Ok[Bytes](wire)

# ---- 存在性预筛 (不读盘内容) ----

fn ProviderSnapshotStoreHas(storeRoot: str, signerHex: str): bool =
    if storeRoot == "":
        return false
    return os.FileExists(ProviderSnapshotStorePath(storeRoot, signerHex))

# ---- per-根 last-seen epoch 基线: 读 (缺文件=0 首见; 文件存在但非法整数=硬 Err) ----

fn ProviderSnapshotEpochBaseline(storeRoot: str, signerHex: str): Result[int64] =
    if storeRoot == "":
        return Err[int64]("provider snapshot epoch: empty storeRoot")
    let path = ProviderSnapshotEpochPath(storeRoot, signerHex)
    if !os.FileExists(path):
        return Ok[int64](int64(0))
    var readRes: Result[str] = os.ReadFileResult(path)
    if IsErr(readRes):
        return Err[int64]("provider snapshot epoch: read failed: " + path)
    var parsed: int64 = 0
    let consumed = parseutils.parseInt64(strutil.Strip(Value(readRes)), parsed)
    if consumed <= 0:
        return Err[int64]("provider snapshot epoch: 基线文件非法整数: " + path)
    return Ok[int64](parsed)

# ---- per-根 epoch 严格单调 admit: epoch > 基线 → 写新基线 Ok; 否则拒为陈旧 (rollback 防护) ----

fn ProviderSnapshotEpochAdmit(storeRoot: str, signerHex: str, epoch: int64): Result[bool] =
    if storeRoot == "":
        return Err[bool]("provider snapshot epoch: empty storeRoot")
    if signerHex == "":
        return Err[bool]("provider snapshot epoch: empty signerHex")
    var baseRes: Result[int64] = ProviderSnapshotEpochBaseline(storeRoot, signerHex)
    if IsErr(baseRes):
        return Err[bool](Error(baseRes))
    let baseline = Value(baseRes)
    if epoch <= baseline:
        return Err[bool]("provider snapshot epoch: 陈旧快照拒 (epoch 非严格单调) signer=" + signerHex + " have=" + strings.Int64ToStr(baseline) + " got=" + strings.Int64ToStr(epoch))
    let dir = ProviderSnapshotStoreDir(storeRoot)
    os.MkdirAll(dir, 493)
    let path = ProviderSnapshotEpochPath(storeRoot, signerHex)
    let tmpPath = path + ".etmp"
    if os.FileExists(tmpPath):
        os.RemoveFile(tmpPath)
    var wr: Result[bool] = os.WriteFileResult(tmpPath, strings.Int64ToStr(epoch))
    if !wr.ok:
        os.RemoveFile(tmpPath)
        return Err[bool]("provider snapshot epoch: tmp write failed: " + tmpPath)
    if os.RenameFile(tmpPath, path):
        return Ok[bool](true)
    os.RemoveFile(tmpPath)
    return Err[bool]("provider snapshot epoch: rename failed: " + path)
