# libp2p P5-S2 发现层原语: 变长签名 provider-set 快照记录的线格式 codec + 签验 (设计 Part 1a)。
# compiler-world 栈 (照 head_codec/authz_codec 先例): rawbytes.Bytes + layout.FixedBytes32/ByteBuf。
#
# 与 head/authz 定长骨架不同点: provider-set 承载变长 (channelId, endpoint) 对列表, 装不进
# 定长线, 故新增变长线格式。但复用其三条签名纪律: ① 固定 record tag 判别防跨型混淆
# (head 0x10 / authz 0x20-0x40 之后下一可用 = 0x50); ② DOMAIN ASCII 前缀域分离 (只进签名输入,
# 不上线体, 防跨协议签名重用); ③ 签名输入 = 除 sig 外全字段规范序; ④ 真 ed25519 verifyEd25519。
#
# 语义: 签的是【路由】("channelId X 在 endpoint E 有服务"), 非内容。签名者 = pinned 根运营者
#   (signerPubKey), 不是 channel 所有者 —— 故【无】channelId==sha256(signer) 自证绑定 (那是内容
#   层的自证, 路由层无)。快照 endpoint 只喂 head/源 liveness-OR 取物, 绝不进撤销 UNION (设计 C1)。
#
# 线格式 (变长, big-endian, 单 record tag 0x50):
#   [0x50][signerPubKey:32][epoch u64-be:8][entryCount u32-be:4]
#   repeat entryCount: [channelId:32][endpointLen u16-be:2][endpoint: ASCII host:port]
#   [sig:64]
#   最小线长 (entryCount=0) = 1+32+8+4+64 = 109。
#
# 签名输入 (域分离规范字节, 除 sig 外全字段规范序):
#   DOMAIN ++ signerPubKey(32) ++ epoch(u64-be 8) ++ entryCount(u32-be 4)
#         ++ (channelId(32) ++ endpointLen(u16-be 2) ++ endpoint)*
#
# 生产纪律 (no fallback / let it crash): 畸形 (线长不足 / tag 错 / entry 越界 / endpoint 空或超
#   u16 / 尾部与 sig 偏移不符) 一律 Result Err, 绝不静默错解; 往返字节精确。签名 = 真 ed25519。

import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/crypto/ed25519/ed25519 as ed

const
    providerSetTag: int32 = 0x50
    providerSetPubKeyLen: int32 = 32
    providerSetSigLen: int32 = 64
    providerSetMinWireLen: int32 = 109        # 1 tag + 32 signer + 8 epoch + 4 count + 64 sig
    providerSetEndpointMaxLen: int32 = 65535  # u16 上限
    providerSetSignInputCap: int32 = 512
    providerSetDomain: str = "cheng/libp2p/provider-set/v1"

type
    ProviderSetEntry =
        channelId: layout.FixedBytes32     # 被路由的 channel (= sha256(owner pubkey))
        endpoint: str                      # ASCII "host:port" (与 S1 全网唯一 endpoint 表示一致)

    ProviderSetRecord =
        signerPubKey: Bytes                # 32B raw ed25519 公钥 (= pinned 根信任锚)
        epoch: int64                       # u64 单调新鲜度
        entries: ProviderSetEntry[]        # 扁平 (channelId, endpoint) 对; 同 channelId 可重复
        sig: Bytes                         # 64B raw ed25519 签名

# ---- u16/u32/u64 big-endian 编解码 (照 head_codec 已验证的 int64 移位口径) ----

fn providerSetAppendU16BE(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn providerSetAppendU32BE(buf: var layout.ByteBuf, value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, int32(value & 255))

fn providerSetAppendU64BE(buf: var layout.ByteBuf, value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 56) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 48) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 40) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 32) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, int32(value & 255))

fn providerSetReadU16BE(payload: Bytes, off: int32): int32 =
    let b0: int32 = BytesGet(payload, off) & 255
    let b1: int32 = BytesGet(payload, off + 1) & 255
    return (b0 << 8) | b1

fn providerSetReadU32BE(payload: Bytes, off: int32): int64 =
    let b0: int64 = int64(BytesGet(payload, off))
    let b1: int64 = int64(BytesGet(payload, off + 1))
    let b2: int64 = int64(BytesGet(payload, off + 2))
    let b3: int64 = int64(BytesGet(payload, off + 3))
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

fn providerSetReadU64BE(payload: Bytes, off: int32): int64 =
    let b0: int64 = int64(BytesGet(payload, off))
    let b1: int64 = int64(BytesGet(payload, off + 1))
    let b2: int64 = int64(BytesGet(payload, off + 2))
    let b3: int64 = int64(BytesGet(payload, off + 3))
    let b4: int64 = int64(BytesGet(payload, off + 4))
    let b5: int64 = int64(BytesGet(payload, off + 5))
    let b6: int64 = int64(BytesGet(payload, off + 6))
    let b7: int64 = int64(BytesGet(payload, off + 7))
    return (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7

# ---- 共享签名体序列化 (signerPubKey + epoch + entryCount + entries; 供 encode 与 signingInput 共用) ----

fn providerSetAppendSignedBody(buf: var layout.ByteBuf, record: ProviderSetRecord) =
    layout.ByteBufAppendBytes(buf, record.signerPubKey)
    providerSetAppendU64BE(buf, record.epoch)
    providerSetAppendU32BE(buf, int64(record.entries.len))
    for i in 0..<record.entries.len:
        layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(record.entries[i].channelId))
        let epBytes = rawbytes.BytesFromString(record.entries[i].endpoint)
        providerSetAppendU16BE(buf, BytesLen(epBytes))
        layout.ByteBufAppendBytes(buf, epBytes)

# ---- 域分离规范签名输入 (DOMAIN 前缀 + 除 sig 外全字段规范序) ----

fn providerSetSigningInput(record: ProviderSetRecord): Bytes =
    var buf = layout.ByteBufInit(providerSetSignInputCap)
    layout.ByteBufAppendBytes(buf, rawbytes.BytesFromString(providerSetDomain))
    providerSetAppendSignedBody(buf, record)
    return layout.ByteBufToBytes(buf)

# ---- 编码 (纯序列化, 无 crypto; 字段长 + endpoint 硬校验) ----

fn ProviderSetEncode(record: ProviderSetRecord): Result[Bytes] =
    if BytesLen(record.signerPubKey) != providerSetPubKeyLen:
        return Err[Bytes]("provider-set: signerPubKey 必须 32B")
    if BytesLen(record.sig) != providerSetSigLen:
        return Err[Bytes]("provider-set: sig 必须 64B")
    for i in 0..<record.entries.len:
        let epLen = BytesLen(rawbytes.BytesFromString(record.entries[i].endpoint))
        if epLen == 0:
            return Err[Bytes]("provider-set: endpoint 不可空")
        if epLen > providerSetEndpointMaxLen:
            return Err[Bytes]("provider-set: endpoint 超 u16 上限")
    var buf = layout.ByteBufInit(providerSetSignInputCap)
    layout.ByteBufAppendByte(buf, providerSetTag)
    providerSetAppendSignedBody(buf, record)
    layout.ByteBufAppendBytes(buf, record.sig)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

# ---- 解码 (纯反序列化 + 逐段边界硬校验; 无签名验证, 签验单独走 ProviderSetVerify) ----
# expectTag 硬钉 0x50: 喂 head(0x10)/authz(0x20-0x40) 记录立即被 tag 拒 (防跨型混淆)。
# 路由层【无】channelId==sha256(signer) 自证绑定 (与 head_codec:132-135 的内容层自证不同)。

fn ProviderSetDecode(payload: Bytes): Result[ProviderSetRecord] =
    let total = BytesLen(payload)
    if total < providerSetMinWireLen:
        return Err[ProviderSetRecord]("provider-set: 线长不足 (< 109)")
    if BytesGet(payload, 0) != providerSetTag:
        return Err[ProviderSetRecord]("provider-set: tag 不符 (拒跨型混淆)")
    var rec: ProviderSetRecord
    rec.signerPubKey = BytesSlice(payload, 1, 32)
    rec.epoch = providerSetReadU64BE(payload, 33)
    let entryCount = providerSetReadU32BE(payload, 41)
    let sigStart: int32 = total - providerSetSigLen
    var off: int32 = 45
    var i: int64 = 0
    while i < entryCount:
        if off + 34 > sigStart:
            return Err[ProviderSetRecord]("provider-set: entry 头越界 (声明 entryCount 超线体)")
        var cidRes = layout.FixedBytes32FromBytes(BytesSlice(payload, off, 32))
        if IsErr(cidRes):
            return Err[ProviderSetRecord]("provider-set: entry channelId 非 32B")
        off = off + 32
        let epLen = providerSetReadU16BE(payload, off)
        off = off + 2
        if epLen == 0:
            return Err[ProviderSetRecord]("provider-set: entry endpoint 不可空")
        if off + epLen > sigStart:
            return Err[ProviderSetRecord]("provider-set: entry endpoint 越界")
        var entry: ProviderSetEntry
        entry.channelId = Value(cidRes)
        entry.endpoint = rawbytes.BytesToString(BytesSlice(payload, off, epLen))
        off = off + epLen
        add(rec.entries, entry)
        i = i + 1
    if off != sigStart:
        return Err[ProviderSetRecord]("provider-set: entry 区尾与 sig 偏移不符 (尾部残留/短缺)")
    rec.sig = BytesSlice(payload, sigStart, providerSetSigLen)
    return Ok[ProviderSetRecord](rec)

# ---- 签名 (真 ed25519, 域分离规范字节; priv = 64B seed||pub) ----

fn ProviderSetSign(priv: Bytes, signerPubKey: Bytes, epoch: int64, entries: ProviderSetEntry[]): Result[ProviderSetRecord] =
    if BytesLen(signerPubKey) != providerSetPubKeyLen:
        return Err[ProviderSetRecord]("provider-set: signerPubKey 必须 32B")
    if BytesLen(priv) != 64:
        return Err[ProviderSetRecord]("provider-set: priv 必须 64B (seed||pub)")
    for i in 0..<entries.len:
        let epLen = BytesLen(rawbytes.BytesFromString(entries[i].endpoint))
        if epLen == 0:
            return Err[ProviderSetRecord]("provider-set: endpoint 不可空")
        if epLen > providerSetEndpointMaxLen:
            return Err[ProviderSetRecord]("provider-set: endpoint 超 u16 上限")
    var rec: ProviderSetRecord
    rec.signerPubKey = signerPubKey
    rec.epoch = epoch
    rec.entries = entries
    rec.sig = EmptyBytes()
    let input = providerSetSigningInput(rec)
    var sigRes = ed.signEd25519Raw(priv, input)
    if IsErr(sigRes):
        return Err[ProviderSetRecord](Error(sigRes))
    rec.sig = Value(sigRes)
    return Ok[ProviderSetRecord](rec)

# ---- 验签 (真 ed25519 + 域分离规范字节重建) ----
# 拒: pubkey/sig 非法长 / 签名不匹配规范字节。路由层不做 channelId 自证绑定 (signer 是 pinned 根钥)。

fn ProviderSetVerify(record: ProviderSetRecord): bool =
    if BytesLen(record.signerPubKey) != providerSetPubKeyLen:
        return false
    if BytesLen(record.sig) != providerSetSigLen:
        return false
    let input = providerSetSigningInput(record)
    return ed.verifyEd25519(record.signerPubKey, input, record.sig)
