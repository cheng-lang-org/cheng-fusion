# libp2p P5-S1: CAS 寻址 manifest-as-lock codec (正典 §11.6 P5, 设计案卷 §2b)。
# manifest blob = 该包依赖集的 lock 内容本身: 逐行 'modulePath=cidHex', 与 cas_store.cheng
# 的 index.lock.txt 行格式逐字节同构 (CasLockRecord 写法: modulePath + "=" + cidHex + "\n")。
# headCid == sha256(manifest bytes): head.headCid 是整依赖集的 Merkle 根, 一跳自证全套模块 cid。
#
# 装配主干 (设计 §2b):
#   channelId → FetchCasHead (host_quic:392) → head.headCid → fetch(headCid) 拉 manifest bytes
#     → 本 codec 解 → 逐 (modulePath, cidHex) → CasResolveDependencyPathWithFetch (cas_store:234) 拉源。
#
# import 面刻意收窄 (std/* + hash256/layout 纯件): 绝不拉 host_quic/QUIC 栈, 保 stage3 可编;
# 也不 import cas_store (避免耦合), cid 用 hash256.Sha256Fixed 直算 (与 CasContentCidBytes 同底层)。
#
# 生产纪律 (no fallback / let it crash):
#   - encode: modulePath/cidHex 空 / 含 '\n' / modulePath 含 '=' = 硬 Err (否则线不可 roundtrip)。
#   - decode: 非空行必须解成恰一对 key=value 且两侧非空, 否则硬 Err (绝不静默跳过畸形行);
#     空行 (末尾换行伪影 / 中间空行) 跳过, 与 cas_store lock 行语义一致。
#   - 校验入口: sha256(manifest bytes) 必须 == head.headCid, 不符硬 Err。

import std/result
import std/rawbytes
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

type
    ManifestLockEntry =
        modulePath: str
        cidHex: str
    ManifestLock =
        entries: ManifestLockEntry[]

# ---- 内容 cid (与 cas_store.CasContentCidBytes 同底层 hash256.Sha256Fixed) ----

fn ManifestLockCid(manifestBytes: Bytes): layout.FixedBytes32 =
    return hash256.Sha256Fixed(layout.ByteSpanFromBytes(manifestBytes))

# ---- 编码: ManifestLock → lock 行式字节 (逐字节同构 index.lock.txt) ----

fn ManifestLockEncode(lock: ManifestLock): Result[Bytes] =
    var text = ""
    for i in 0..<lock.entries.len:
        let mp = lock.entries[i].modulePath
        let cid = lock.entries[i].cidHex
        if mp == "":
            return Err[Bytes]("manifest: 空 modulePath")
        if cid == "":
            return Err[Bytes]("manifest: 空 cidHex modulePath=" + mp)
        if strutil.Contains(mp, "="):
            return Err[Bytes]("manifest: modulePath 含 '=' (破坏行式) modulePath=" + mp)
        if strutil.Contains(mp, "\n"):
            return Err[Bytes]("manifest: modulePath 含换行 modulePath=" + mp)
        if strutil.Contains(cid, "\n"):
            return Err[Bytes]("manifest: cidHex 含换行 modulePath=" + mp)
        text = text + mp + "=" + cid + "\n"
    return Ok[Bytes](
        rawbytes.BytesSlice(
            rawbytes.BytesFromString(text), 0, len(text)))

# ---- 解码: lock 行式字节 → ManifestLock (非法行硬错; 空行跳过) ----

fn ManifestLockDecode(manifestBytes: Bytes): Result[ManifestLock] =
    var out: ManifestLock
    let text = rawbytes.BytesToString(manifestBytes)
    let lines = strutil.Split(text, '\n')
    for i in 0..<lines.len:
        let line = strutil.Strip(lines[i])
        if line == "":
            continue
        let parts = strutil.Split(line, '=')
        if parts.len != 2:
            return Err[ManifestLock]("manifest: 非法行 (非恰一对 key=value): " + line)
        let mp = strutil.Strip(parts[0])
        let cid = strutil.Strip(parts[1])
        if mp == "":
            return Err[ManifestLock]("manifest: 非法行 (空 modulePath): " + line)
        if cid == "":
            return Err[ManifestLock]("manifest: 非法行 (空 cidHex): " + line)
        var e: ManifestLockEntry
        e.modulePath = mp
        e.cidHex = cid
        add(out.entries, e)
    return Ok[ManifestLock](out)

# ---- 校验入口: sha256(manifest bytes) == head.headCid (不符硬 Err) ----

fn ManifestLockVerifyHeadCid(manifestBytes: Bytes, headCid: layout.FixedBytes32): Result[bool] =
    let actual = ManifestLockCid(manifestBytes)
    if !layout.FixedBytes32Equal(actual, headCid):
        return Err[bool]("manifest: sha256(manifest) != head.headCid expect=" + layout.FixedBytes32Hex(headCid) + " actual=" + layout.FixedBytes32Hex(actual))
    return Ok[bool](true)
