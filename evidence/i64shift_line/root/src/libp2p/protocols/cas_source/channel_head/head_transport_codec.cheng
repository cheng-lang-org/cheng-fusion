# libp2p P3 正片: channel-head 网络传输动词线格式 (正典 §11.6 P3)。
# HEAD_REQ / HEAD_RESP 是 cas-source 协议 (protocol id 25) 内的【新增动词】, 不是新协议:
# 未 pin 的 import 先经 HEAD_REQ(channelId) 拿到签名 head 解出 headCid, 再走既有 WANT/BLOCK
# 拉源。动词由帧首字节 tag 区分 (WANT=0x01 / HAVE=0x02 / BLOCK=0x03 已占; HEAD_REQ=0x11 /
# HEAD_RESP=0x12 新增)。故 protocol id 复用 25, 不动 types.cheng 的 WireText (裁决: head 是
# cas-source 的 verb 而非独立 protocol; 帧 tag 就是 verb 判别位, 与 WANT/BLOCK 同一 tag 空间)。
#
# 线格式 (big-endian):
#   HEAD_REQ:            [0x11][channelId 32B]                       = 33 字节
#   HEAD_RESP (found):   [0x12][0x01][ head_wire(201B, tag 0x10) ]   = 203 字节
#   HEAD_RESP (miss):    [0x12][0x00]                                = 2 字节
#
# head_wire 复用 head_codec 的 201B 固定线格式 (ChannelHeadEncode/Decode); 本模块只包一层
# 请求/应答信封, 不重解 head 内部字段 (职责分离: 传输信封 vs head 记录 codec)。
#
# 生产纪律 (no fallback / let it crash): 畸形 (长度不符 / tag 错 / status 非 0-1 /
# found 但 head_wire 非 201) 一律 Result Err, 绝不静默错解; 往返字节精确。

import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout

const
    CasHeadTagReq: int32 = 0x11
    CasHeadTagResp: int32 = 0x12
    casHeadReqWireLen: int32 = 33
    casHeadRecordWireLen: int32 = 201
    casHeadRespFoundWireLen: int32 = 203   # 1 tag + 1 status + 201 record
    casHeadRespMissWireLen: int32 = 2      # 1 tag + 1 status(0)

type
    CasHeadRespMsg =
        found: bool
        headWire: Bytes   # found 时为 201B head 记录线; miss 时为空

# ---- HEAD_REQ: 请求方按 channelId 索取签名 head ----

fn CasHeadReqEncode(channelId: layout.FixedBytes32): Bytes =
    var buf = layout.ByteBufInit(casHeadReqWireLen)
    layout.ByteBufAppendByte(buf, CasHeadTagReq)
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(channelId))
    return layout.ByteBufToBytes(buf)

fn CasHeadReqDecode(payload: Bytes): Result[layout.FixedBytes32] =
    if BytesLen(payload) != casHeadReqWireLen:
        return Err[layout.FixedBytes32]("cas_head req: 线长非 33")
    if BytesGet(payload, 0) != CasHeadTagReq:
        return Err[layout.FixedBytes32]("cas_head req: tag 不符 (非 HEAD_REQ)")
    var cidRes = layout.FixedBytes32FromBytes(BytesSlice(payload, 1, 32))
    if IsErr(cidRes):
        return Err[layout.FixedBytes32]("cas_head req: channelId 非 32B")
    return Ok[layout.FixedBytes32](Value(cidRes))

# ---- HEAD_RESP: 应答方回签名 head 记录 (found) 或缺记录标记 (miss) ----

fn CasHeadRespEncodeFound(headWire: Bytes): Result[Bytes] =
    if BytesLen(headWire) != casHeadRecordWireLen:
        return Err[Bytes]("cas_head resp: head_wire 必须 201B")
    var buf = layout.ByteBufInit(casHeadRespFoundWireLen)
    layout.ByteBufAppendByte(buf, CasHeadTagResp)
    layout.ByteBufAppendByte(buf, 1)
    layout.ByteBufAppendBytes(buf, headWire)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

fn CasHeadRespEncodeMiss(): Bytes =
    var buf = layout.ByteBufInit(casHeadRespMissWireLen)
    layout.ByteBufAppendByte(buf, CasHeadTagResp)
    layout.ByteBufAppendByte(buf, 0)
    return layout.ByteBufToBytes(buf)

fn CasHeadRespDecode(payload: Bytes): Result[CasHeadRespMsg] =
    let total: int32 = BytesLen(payload)
    var msg: CasHeadRespMsg
    msg.found = false
    msg.headWire = EmptyBytes()
    if total < 2:
        return Err[CasHeadRespMsg]("cas_head resp: header 截断")
    if BytesGet(payload, 0) != CasHeadTagResp:
        return Err[CasHeadRespMsg]("cas_head resp: tag 不符 (非 HEAD_RESP)")
    let status: int32 = BytesGet(payload, 1)
    if status == 0:
        if total != casHeadRespMissWireLen:
            return Err[CasHeadRespMsg]("cas_head resp: miss 帧长非 2")
        msg.found = false
        return Ok[CasHeadRespMsg](msg)
    if status != 1:
        return Err[CasHeadRespMsg]("cas_head resp: status 非 0/1")
    if total != casHeadRespFoundWireLen:
        return Err[CasHeadRespMsg]("cas_head resp: found 帧长非 203")
    msg.found = true
    msg.headWire = BytesSlice(payload, 2, casHeadRecordWireLen)
    return Ok[CasHeadRespMsg](msg)
