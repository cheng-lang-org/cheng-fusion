# libp2p P3 收尾片: head 接受 resolver (先取撤销优先 → 授权 → 返回已验记录, 正典 §11.6 P3)。
# 纯逻辑 (库作 storeRoot 参数传入, 无网络): 本地可 smoke。链:
#   ① decode head (v1 自证 → channelId==sha256(signerPubKey); 长度/tag 透传 head_codec rejectReason)
#   ② verify head (真 ed25519 域分离签名)
#   ③ 先取撤销 (在授权前!): head.signerPubKey 在 (自证 channelId 或逻辑 L) 撤销集命中即硬拒
#   ④ 授权:
#      - 无 cert (直接根 head): head.channelId 必须 == currentRoot (= 逻辑 L 沿 rotation 链跟随终态);
#        不符 = 未授权 (含 SUPERSEDED 旧 channelId 直收 head 的 T8)
#      - 有 cert (委托 head): cert 验签 + 签发者自证为 currentRoot (depth-1) + A==currentRoot +
#        越权闸 (head.epoch <= cert.notAfterEpoch) + cert.delegatePubKey == head.signerPubKey
#   TOFU epoch/换钥 单调是调用方下一步 (tofu.TofuAdmit, 按 record.channelId), resolver 只回授权记录。
#
# 生产纪律 (no fallback / let it crash): 任一环失败 = 硬 Err 带独立 rejectReason; miss=硬拒不静默。

import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/authz_codec as authz
import cheng/libp2p/protocols/cas_source/channel_head/authz_store as store

@borrows
fn AuthzResolveHeadAccept(storeRoot: str,
                           logicalChannelId: layout.FixedBytes32,
                           headWire: Bytes,
                           hasCert: bool,
                           certWire: Bytes): Result[head.ChannelHeadRecord] =
    # ① decode (v1 自证绑定 + 长度/tag 在 head_codec 内)
    var decRes = head.ChannelHeadDecode(headWire)
    if IsErr(decRes):
        return Err[head.ChannelHeadRecord](Error(decRes))
    let record = Value(decRes)

    # ② verify (真 ed25519)
    if !head.ChannelHeadVerify(record):
        return Err[head.ChannelHeadRecord]("resolver: head 验签拒")

    # ③ 先取撤销 (授权前): signerPubKey 在自证 channelId 或逻辑 L 撤销集命中即拒
    if store.AuthzRevocationExists(storeRoot, record.channelId, record.signerPubKey):
        return Err[head.ChannelHeadRecord]("resolver: signer 已撤销 (先取撤销硬拒)")
    if store.AuthzRevocationExists(storeRoot, logicalChannelId, record.signerPubKey):
        return Err[head.ChannelHeadRecord]("resolver: signer 已撤销 (先取撤销硬拒)")

    # ④ 授权: currentRoot = 逻辑 L 沿 rotation 链跟随终态
    let currentRoot = store.AuthzRotationFollow(storeRoot, logicalChannelId)

    if !hasCert:
        # 直接根 head: channelId 必须 == currentRoot
        if !layout.FixedBytes32Equal(record.channelId, currentRoot):
            return Err[head.ChannelHeadRecord]("resolver: 未授权 signer channel")
        return Ok[head.ChannelHeadRecord](record)

    # 委托 head: cert 链验签 (depth-1)
    var certRes = authz.AuthzRecordDecode(certWire, authz.AuthzTagDelegate)
    if IsErr(certRes):
        return Err[head.ChannelHeadRecord](Error(certRes))
    let cert = Value(certRes)
    var delRes = authz.DelegationVerify(cert, currentRoot)
    if IsErr(delRes):
        return Err[head.ChannelHeadRecord](Error(delRes))
    # 越权闸: head epoch 不得越 cert 有效期上限
    if record.epoch > cert.epoch:
        return Err[head.ChannelHeadRecord]("resolver: delegate head epoch 越 cert 有效期 (越权拒)")
    # cert 授权的正是此 head 的 signer (delegatePubKey == head.signerPubKey)
    if !rawbytes.BytesEqual(layout.FixedBytes32ToBytes(cert.b), record.signerPubKey):
        return Err[head.ChannelHeadRecord]("resolver: cert 未授权此 head signer")
    return Ok[head.ChannelHeadRecord](record)
