# libp2p P3 收尾片: 撤销新鲜度网络动词线格式 (REVOKE_REQ/REVOKE_RESP, 正典 §11.6 P3)。
# cas-source 协议 (protocol id 25) 内新增动词 (镜像 HEAD_REQ/HEAD_RESP): 请求方接受 head 前
# 先查 "targetPubKey 在 channelId 撤销否", 让 B 能从网络拉撤销记录 (先取撤销)。
# 动词由帧首字节 tag 区分 (WANT 0x01 / HEAD_REQ 0x11 已占; REVOKE_REQ=0x21 / REVOKE_RESP=0x22 新增)。
#
# 线格式 (big-endian):
#   REVOKE_REQ:            [0x21][channelId 32B][targetPubKey 32B]        = 65 字节
#   REVOKE_RESP (found):   [0x22][0x01][ 撤销 wire(169B, tag 0x20) ]      = 171 字节
#   REVOKE_RESP (miss):    [0x22][0x00]                                   = 2 字节
#
# 撤销 wire 复用 authz_codec 的 169B 固定线格式; 本模块只包一层请求/应答信封, 不重解撤销记录
# 内部字段 (职责分离: 传输信封 vs 授权记录 codec)。
#
# 生产纪律 (no fallback / let it crash): 畸形 (长度不符 / tag 错 / status 非 0-1 /
# found 但撤销 wire 非 169) 一律 Result Err, 绝不静默错解; 往返字节精确。

import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout

const
    RevokeTagReq: int32 = 0x21
    RevokeTagResp: int32 = 0x22
    revokeReqWireLen: int32 = 65
    revokeRecordWireLen: int32 = 169
    revokeRespFoundWireLen: int32 = 171   # 1 tag + 1 status + 169 record
    revokeRespMissWireLen: int32 = 2      # 1 tag + 1 status(0)

type
    RevokeReqMsg =
        channelId: layout.FixedBytes32
        targetPubKey: layout.FixedBytes32

    RevokeRespMsg =
        found: bool
        recordWire: Bytes   # found 时为 169B 撤销记录线; miss 时为空

# ---- REVOKE_REQ: 请求方问 "targetPubKey 在 channelId 撤销否" ----

fn RevokeReqEncode(channelId: layout.FixedBytes32, targetPubKey: layout.FixedBytes32): Bytes =
    var buf = layout.ByteBufInit(revokeReqWireLen)
    layout.ByteBufAppendByte(buf, RevokeTagReq)
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(channelId))
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(targetPubKey))
    return layout.ByteBufToBytes(buf)

fn RevokeReqDecode(payload: Bytes): Result[RevokeReqMsg] =
    if BytesLen(payload) != revokeReqWireLen:
        return Err[RevokeReqMsg]("revoke req: 线长非 65")
    if BytesGet(payload, 0) != RevokeTagReq:
        return Err[RevokeReqMsg]("revoke req: tag 不符 (非 REVOKE_REQ)")
    var msg: RevokeReqMsg
    var cidRes = layout.FixedBytes32FromBytes(BytesSlice(payload, 1, 32))
    if IsErr(cidRes):
        return Err[RevokeReqMsg]("revoke req: channelId 非 32B")
    msg.channelId = Value(cidRes)
    var tgtRes = layout.FixedBytes32FromBytes(BytesSlice(payload, 33, 32))
    if IsErr(tgtRes):
        return Err[RevokeReqMsg]("revoke req: targetPubKey 非 32B")
    msg.targetPubKey = Value(tgtRes)
    return Ok[RevokeReqMsg](msg)

# ---- REVOKE_RESP: 应答方回撤销记录 (found) 或缺记录标记 (miss) ----

fn RevokeRespEncodeFound(recordWire: Bytes): Result[Bytes] =
    if BytesLen(recordWire) != revokeRecordWireLen:
        return Err[Bytes]("revoke resp: 撤销 wire 必须 169B")
    var buf = layout.ByteBufInit(revokeRespFoundWireLen)
    layout.ByteBufAppendByte(buf, RevokeTagResp)
    layout.ByteBufAppendByte(buf, 1)
    layout.ByteBufAppendBytes(buf, recordWire)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

fn RevokeRespEncodeMiss(): Bytes =
    var buf = layout.ByteBufInit(revokeRespMissWireLen)
    layout.ByteBufAppendByte(buf, RevokeTagResp)
    layout.ByteBufAppendByte(buf, 0)
    return layout.ByteBufToBytes(buf)

fn RevokeRespDecode(payload: Bytes): Result[RevokeRespMsg] =
    let total: int32 = BytesLen(payload)
    var msg: RevokeRespMsg
    msg.found = false
    msg.recordWire = EmptyBytes()
    if total < 2:
        return Err[RevokeRespMsg]("revoke resp: header 截断")
    if BytesGet(payload, 0) != RevokeTagResp:
        return Err[RevokeRespMsg]("revoke resp: tag 不符 (非 REVOKE_RESP)")
    let status: int32 = BytesGet(payload, 1)
    if status == 0:
        if total != revokeRespMissWireLen:
            return Err[RevokeRespMsg]("revoke resp: miss 帧长非 2")
        msg.found = false
        return Ok[RevokeRespMsg](msg)
    if status != 1:
        return Err[RevokeRespMsg]("revoke resp: status 非 0/1")
    if total != revokeRespFoundWireLen:
        return Err[RevokeRespMsg]("revoke resp: found 帧长非 171")
    msg.found = true
    msg.recordWire = BytesSlice(payload, 2, revokeRecordWireLen)
    return Ok[RevokeRespMsg](msg)
