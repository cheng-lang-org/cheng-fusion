# libp2p P3 收尾片: 委托 cert 网络分发动词线格式 (DELEG_REQ/DELEG_RESP, 正典 §11.6 P3)。
# cas-source 协议 (protocol id 25) 内新增动词 (镜像 REVOKE_REQ/REVOKE_RESP): B 只知逻辑 channel L,
# 发布方已把签发委托给 D (0x40 cert 记录在案), B 经此动词从网络拿到 "L→D 委托记录", 再自证取 D head,
# 交 resolver 委托授权后把 D 的 head 绑回 L 内容源。
# 动词由帧首字节 tag 区分 (WANT 0x01 / HEAD_REQ 0x11 / REVOKE_REQ 0x21 已占; DELEG_REQ=0x23 / DELEG_RESP=0x24 新增)。
#
# 线格式 (big-endian):
#   DELEG_REQ:            [0x23][channelId(L) 32B]                          = 33 字节
#   DELEG_RESP (found):   [0x24][0x01][ 委托 cert wire(169B, tag 0x40) ]    = 171 字节
#   DELEG_RESP (miss):    [0x24][0x00]                                      = 2 字节
#
# 委托 cert wire 复用 authz_codec 的 169B 固定线格式; 本模块只包一层请求/应答信封, 不重解 cert
# 内部字段 (职责分离: 传输信封 vs 授权记录 codec)。
#
# 生产纪律 (no fallback / let it crash): 畸形 (长度不符 / tag 错 / status 非 0-1 /
# found 但 cert wire 非 169) 一律 Result Err, 绝不静默错解; 往返字节精确。

import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout

const
    DelegTagReq: int32 = 0x23
    DelegTagResp: int32 = 0x24
    delegReqWireLen: int32 = 33
    delegRecordWireLen: int32 = 169
    delegRespFoundWireLen: int32 = 171   # 1 tag + 1 status + 169 record
    delegRespMissWireLen: int32 = 2      # 1 tag + 1 status(0)

type
    DelegReqMsg =
        channelId: layout.FixedBytes32

    DelegRespMsg =
        found: bool
        recordWire: Bytes   # found 时为 169B 委托 cert 线; miss 时为空

# ---- DELEG_REQ: 请求方问 "channelId(L) 的委托 cert 记录" ----

fn DelegReqEncode(channelId: layout.FixedBytes32): Bytes =
    var buf = layout.ByteBufInit(delegReqWireLen)
    layout.ByteBufAppendByte(buf, DelegTagReq)
    layout.ByteBufAppendBytes(buf, layout.FixedBytes32ToBytes(channelId))
    return layout.ByteBufToBytes(buf)

fn DelegReqDecode(payload: Bytes): Result[DelegReqMsg] =
    if BytesLen(payload) != delegReqWireLen:
        return Err[DelegReqMsg]("deleg req: 线长非 33")
    if BytesGet(payload, 0) != DelegTagReq:
        return Err[DelegReqMsg]("deleg req: tag 不符 (非 DELEG_REQ)")
    var msg: DelegReqMsg
    var cidRes = layout.FixedBytes32FromBytes(BytesSlice(payload, 1, 32))
    if IsErr(cidRes):
        return Err[DelegReqMsg]("deleg req: channelId 非 32B")
    msg.channelId = Value(cidRes)
    return Ok[DelegReqMsg](msg)

# ---- DELEG_RESP: 应答方回委托 cert 记录 (found) 或缺记录标记 (miss) ----

fn DelegRespEncodeFound(recordWire: Bytes): Result[Bytes] =
    if BytesLen(recordWire) != delegRecordWireLen:
        return Err[Bytes]("deleg resp: 委托 cert wire 必须 169B")
    var buf = layout.ByteBufInit(delegRespFoundWireLen)
    layout.ByteBufAppendByte(buf, DelegTagResp)
    layout.ByteBufAppendByte(buf, 1)
    layout.ByteBufAppendBytes(buf, recordWire)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

fn DelegRespEncodeMiss(): Bytes =
    var buf = layout.ByteBufInit(delegRespMissWireLen)
    layout.ByteBufAppendByte(buf, DelegTagResp)
    layout.ByteBufAppendByte(buf, 0)
    return layout.ByteBufToBytes(buf)

fn DelegRespDecode(payload: Bytes): Result[DelegRespMsg] =
    let total: int32 = BytesLen(payload)
    var msg: DelegRespMsg
    msg.found = false
    msg.recordWire = EmptyBytes()
    if total < 2:
        return Err[DelegRespMsg]("deleg resp: header 截断")
    if BytesGet(payload, 0) != DelegTagResp:
        return Err[DelegRespMsg]("deleg resp: tag 不符 (非 DELEG_RESP)")
    let status: int32 = BytesGet(payload, 1)
    if status == 0:
        if total != delegRespMissWireLen:
            return Err[DelegRespMsg]("deleg resp: miss 帧长非 2")
        msg.found = false
        return Ok[DelegRespMsg](msg)
    if status != 1:
        return Err[DelegRespMsg]("deleg resp: status 非 0/1")
    if total != delegRespFoundWireLen:
        return Err[DelegRespMsg]("deleg resp: found 帧长非 171")
    msg.found = true
    msg.recordWire = BytesSlice(payload, 2, delegRecordWireLen)
    return Ok[DelegRespMsg](msg)
