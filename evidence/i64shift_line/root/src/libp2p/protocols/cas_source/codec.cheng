# libp2p CAS-source S1 线格式 codec (正典 §11 P2 分层 S1: 纯编解码, 无网络无 CAS 状态)。
# compiler-world 栈: rawbytes.Bytes + layout.FixedBytes32 (32B 裸 sha256 cid) + 1 字节 tag。
# 帧层 (u32-be len + payload) 是 quic_transport 的事; 本模块只管 message payload 的 encode/decode。
#
# 三条线格式 (全 big-endian; cid = raw 32B):
#   WANT:  [0x01][u16 count][ cid(32B) × N ]
#   HAVE:  [0x02][u16 count][ (cid(32B), u8 have) × N ]
#   BLOCK: [0x03][u16 count][ (cid(32B), u32 len, bytes[len]) × N ]  ; len ≤ 16 MiB/块
#
# 生产纪律 (no fallback / let it crash): 畸形/越界 (count 溢出、len>16MiB、header 截断、
# tag 未知、have 非 0/1、尾部残字节) 一律 Result Err, 绝不静默错解。往返字节精确。

import std/result
import std/rawbytes
import cheng/std/bytes_layout as layout

const
    CasSourceTagWant: int32 = 0x01
    CasSourceTagHave: int32 = 0x02
    CasSourceTagBlock: int32 = 0x03
    CasSourceMaxCount: int32 = 65535
    CasSourceBlockMaxLen: int32 = 16777216   # 16 MiB / 块

type
    CasSourceWantMsg =
        cids: layout.FixedBytes32[]

    CasSourceHaveEntry =
        cid: layout.FixedBytes32
        have: bool

    CasSourceHaveMsg =
        entries: CasSourceHaveEntry[]

    CasSourceBlockEntry =
        cid: layout.FixedBytes32
        data: Bytes

    CasSourceBlockMsg =
        entries: CasSourceBlockEntry[]

# ---- 大端写入辅助 ----

fn casSourceAppendU16(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 8) & 0xff)
    layout.ByteBufAppendByte(buf, value & 0xff)

fn casSourceAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 0xff)
    layout.ByteBufAppendByte(buf, (value >> 16) & 0xff)
    layout.ByteBufAppendByte(buf, (value >> 8) & 0xff)
    layout.ByteBufAppendByte(buf, value & 0xff)

# ---- WANT ----

@borrows
fn CasSourceWantEncode(msg: CasSourceWantMsg): Result[Bytes] =
    let n: int32 = msg.cids.len
    if n > CasSourceMaxCount:
        return Err[Bytes]("cas_source want: count 溢出 (>65535)")
    var buf = layout.ByteBufInit(3 + n * 32)
    layout.ByteBufAppendByte(buf, CasSourceTagWant)
    casSourceAppendU16(buf, n)
    for i in 0..<n:
        var cidBytes = layout.FixedBytes32ToBytes(msg.cids[i])
        layout.ByteBufAppendBytes(buf, cidBytes)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

@borrows
fn CasSourceWantDecode(payload: Bytes): Result[CasSourceWantMsg] =
    let total: int32 = BytesLen(payload)
    var msg: CasSourceWantMsg
    if total < 3:
        return Err[CasSourceWantMsg]("cas_source want: header 截断")
    if BytesGet(payload, 0) != CasSourceTagWant:
        return Err[CasSourceWantMsg]("cas_source want: tag 不符")
    let count: int32 = (BytesGet(payload, 1) << 8) | BytesGet(payload, 2)
    let need: int32 = 3 + count * 32
    if total != need:
        return Err[CasSourceWantMsg]("cas_source want: count 与实际长度不符")
    var off: int32 = 3
    for i in 0..<count:
        var cidBytes = BytesSlice(payload, off, 32)
        var cidRes = layout.FixedBytes32FromBytes(cidBytes)
        if IsErr(cidRes):
            return Err[CasSourceWantMsg]("cas_source want: cid 非 32B")
        add(msg.cids, Value(cidRes))
        off = off + 32
    return Ok[CasSourceWantMsg](msg)

# ---- HAVE ----

@borrows
fn CasSourceHaveEncode(msg: CasSourceHaveMsg): Result[Bytes] =
    let n: int32 = msg.entries.len
    if n > CasSourceMaxCount:
        return Err[Bytes]("cas_source have: count 溢出 (>65535)")
    var buf = layout.ByteBufInit(3 + n * 33)
    layout.ByteBufAppendByte(buf, CasSourceTagHave)
    casSourceAppendU16(buf, n)
    for i in 0..<n:
        var entry = msg.entries[i]
        var cidBytes = layout.FixedBytes32ToBytes(entry.cid)
        layout.ByteBufAppendBytes(buf, cidBytes)
        if entry.have:
            layout.ByteBufAppendByte(buf, 1)
        else:
            layout.ByteBufAppendByte(buf, 0)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

@borrows
fn CasSourceHaveDecode(payload: Bytes): Result[CasSourceHaveMsg] =
    let total: int32 = BytesLen(payload)
    var msg: CasSourceHaveMsg
    if total < 3:
        return Err[CasSourceHaveMsg]("cas_source have: header 截断")
    if BytesGet(payload, 0) != CasSourceTagHave:
        return Err[CasSourceHaveMsg]("cas_source have: tag 不符")
    let count: int32 = (BytesGet(payload, 1) << 8) | BytesGet(payload, 2)
    let need: int32 = 3 + count * 33
    if total != need:
        return Err[CasSourceHaveMsg]("cas_source have: count 与实际长度不符")
    var off: int32 = 3
    for i in 0..<count:
        var cidBytes = BytesSlice(payload, off, 32)
        var cidRes = layout.FixedBytes32FromBytes(cidBytes)
        if IsErr(cidRes):
            return Err[CasSourceHaveMsg]("cas_source have: cid 非 32B")
        let haveByte: int32 = BytesGet(payload, off + 32)
        if haveByte != 0 && haveByte != 1:
            return Err[CasSourceHaveMsg]("cas_source have: have 位非 0/1")
        var entry: CasSourceHaveEntry
        entry.cid = Value(cidRes)
        entry.have = haveByte == 1
        add(msg.entries, entry)
        off = off + 33
    return Ok[CasSourceHaveMsg](msg)

# ---- BLOCK ----

@borrows
fn CasSourceBlockEncode(msg: CasSourceBlockMsg): Result[Bytes] =
    let n: int32 = msg.entries.len
    if n > CasSourceMaxCount:
        return Err[Bytes]("cas_source block: count 溢出 (>65535)")
    var buf = layout.ByteBufInit(64)
    layout.ByteBufAppendByte(buf, CasSourceTagBlock)
    casSourceAppendU16(buf, n)
    for i in 0..<n:
        var entry = msg.entries[i]
        let dataLen: int32 = BytesLen(entry.data)
        if dataLen < 0 || dataLen > CasSourceBlockMaxLen:
            return Err[Bytes]("cas_source block: 块长越界 (>16MiB)")
        var cidBytes = layout.FixedBytes32ToBytes(entry.cid)
        layout.ByteBufAppendBytes(buf, cidBytes)
        casSourceAppendU32(buf, dataLen)
        layout.ByteBufAppendBytes(buf, entry.data)
    return Ok[Bytes](layout.ByteBufToBytes(buf))

@borrows
fn CasSourceBlockDecode(payload: Bytes): Result[CasSourceBlockMsg] =
    let total: int32 = BytesLen(payload)
    var msg: CasSourceBlockMsg
    if total < 3:
        return Err[CasSourceBlockMsg]("cas_source block: header 截断")
    if BytesGet(payload, 0) != CasSourceTagBlock:
        return Err[CasSourceBlockMsg]("cas_source block: tag 不符")
    let count: int32 = (BytesGet(payload, 1) << 8) | BytesGet(payload, 2)
    var off: int32 = 3
    for i in 0..<count:
        # 每项至少 cid(32) + u32 len(4) = 36 字节头
        if total - off < 36:
            return Err[CasSourceBlockMsg]("cas_source block: 项头截断")
        var cidBytes = BytesSlice(payload, off, 32)
        var cidRes = layout.FixedBytes32FromBytes(cidBytes)
        if IsErr(cidRes):
            return Err[CasSourceBlockMsg]("cas_source block: cid 非 32B")
        let b0: int32 = BytesGet(payload, off + 32)
        let b1: int32 = BytesGet(payload, off + 33)
        let b2: int32 = BytesGet(payload, off + 34)
        let b3: int32 = BytesGet(payload, off + 35)
        let dataLen: int32 = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        if dataLen < 0 || dataLen > CasSourceBlockMaxLen:
            return Err[CasSourceBlockMsg]("cas_source block: 块长越界 (>16MiB)")
        off = off + 36
        if dataLen > total - off:
            return Err[CasSourceBlockMsg]("cas_source block: 块数据截断")
        var data: Bytes
        if dataLen > 0:
            data = BytesSlice(payload, off, dataLen)
        else:
            data = EmptyBytes()
        var entry: CasSourceBlockEntry
        entry.cid = Value(cidRes)
        entry.data = data
        add(msg.entries, entry)
        off = off + dataLen
    if off != total:
        return Err[CasSourceBlockMsg]("cas_source block: 尾部残字节")
    return Ok[CasSourceBlockMsg](msg)
