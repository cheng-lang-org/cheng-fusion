# Data transfer protocol(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/option
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import cheng/libp2p/protocols/datatransfer/persistence
const
    dataTransferCodec = "/p2p/datatransfer/1.2.0"
    defaultMaxDataTransferMessageBytes = 2097152

type
    DataTransferConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    DataTransferContext =
        config: DataTransferConfig
        hasHandler: bool
        handler: fn(msg: DataTransferMessage): Option[DataTransferMessage]
        hasManager: bool
        manager: DataTransferChannelManager
        hasPersistence: bool
        persistence: DataTransferPersistence

var
    dataTransferContext: DataTransferContext = DataTransferContext(
        config: DataTransferConfig(
            maxMessageBytes: defaultMaxDataTransferMessageBytes,
            closeAfterResponse: true
        ),
        hasHandler: false,
        hasManager: false,
        hasPersistence: false
    )

fn initDataTransferConfig(): DataTransferConfig =
    DataTransferConfig(
        maxMessageBytes: defaultMaxDataTransferMessageBytes,
        closeAfterResponse: true
    )

fn setDataTransferConfig(config: DataTransferConfig) =
    dataTransferContext.config = config

fn setDataTransferHandler(handler: fn(msg: DataTransferMessage): Option[DataTransferMessage]) =
    dataTransferContext.handler = handler
    dataTransferContext.hasHandler = true

fn setDataTransferChannelManager(manager: DataTransferChannelManager) =
    dataTransferContext.manager = manager
    dataTransferContext.hasManager = true

fn setDataTransferPersistence(persistence: DataTransferPersistence) =
    dataTransferContext.persistence = persistence
    dataTransferContext.hasPersistence = true

fn dataTransferChannelManagerState(): Option[DataTransferChannelManager] =
    if dataTransferContext.hasManager:
        return Some[DataTransferChannelManager](dataTransferContext.manager)
    return None[DataTransferChannelManager]()

fn dataTransferPersistenceState(): Option[DataTransferPersistence] =
    if dataTransferContext.hasPersistence:
        return Some[DataTransferPersistence](dataTransferContext.persistence)
    return None[DataTransferPersistence]()

fn dataTransferTryGetChannelManagerState(outManager: var DataTransferChannelManager): bool =
    if ! dataTransferContext.hasManager:
        return false
    outManager = dataTransferContext.manager
    return true

fn dataTransferTryGetPersistenceState(outPersistence: var DataTransferPersistence): bool =
    if ! dataTransferContext.hasPersistence:
        return false
    outPersistence = dataTransferContext.persistence
    return true

fn dataTransferApplyMessage(msg: DataTransferMessage): Result[Option[DataTransferChannel]] =
    if ! dataTransferContext.hasManager:
        return Ok[Option[DataTransferChannel]](None[DataTransferChannel]())
    var manager: DataTransferChannelManager = dataTransferContext.manager
    let applyRes: Result[Option[DataTransferChannel]] = dataTransferChannelApply(manager, msg)
    if IsErr(applyRes):
        return Err[Option[DataTransferChannel]](Error(applyRes))
    dataTransferContext.manager = manager
    if dataTransferContext.hasPersistence && Value(applyRes).has:
        var persistence: DataTransferPersistence = dataTransferContext.persistence
        let saveRes: Result[bool] = dataTransferPersistSave(persistence, Value(applyRes).value)
        if IsErr(saveRes):
            return Err[Option[DataTransferChannel]](Error(saveRes))
        dataTransferContext.persistence = persistence
    return applyRes

fn readDataTransferMessage(stream: var Stream): Result[DataTransferMessage] =
    let dataRes: Result[Bytes] = readLp(stream, dataTransferContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[DataTransferMessage](Error(dataRes))
    return decodeDataTransferMessage(Value(dataRes))

fn writeDataTransferMessage(stream: var Stream, msg: DataTransferMessage): Result[bool] =
    let encRes: Result[Bytes] = encodeDataTransferMessage(msg)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn defaultDataTransferHandler(msg: DataTransferMessage): Option[DataTransferMessage] =
    if msg.kind != dtmkRequest || ! msg.hasRequest:
        return None[DataTransferMessage]()
    var resp: DataTransferResponse = initDataTransferResponse()
    resp.accepted = true
    resp.hasStatus = true
    resp.status = "ok"
    var out: DataTransferMessage = initDataTransferMessage()
    out.transferId = msg.transferId
    out.kind = dtmkResponse
    out.hasResponse = true
    out.response = resp
    return Some[DataTransferMessage](out)

fn dataTransferHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let msgRes: Result[DataTransferMessage] = readDataTransferMessage(streamVar)
    if IsErr(msgRes):
        return Err[bool](Error(msgRes))
    let msg: DataTransferMessage = Value(msgRes)
    let applyRes: Result[Option[DataTransferChannel]] = dataTransferApplyMessage(msg)
    if IsErr(applyRes):
        return Err[bool](Error(applyRes))
    var replyOpt: Option[DataTransferMessage] = None[DataTransferMessage]()
    if dataTransferContext.hasHandler:
        replyOpt = dataTransferContext.handler(msg)
    else:
        replyOpt = defaultDataTransferHandler(msg)
    if replyOpt.has:
        let writeRes: Result[bool] = writeDataTransferMessage(streamVar, replyOpt.value)
        if IsErr(writeRes):
            return Err[bool](Error(writeRes))
    if dataTransferContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn dataTransferProtocol(): Lp2pProtocol =
    return newProtocol(dataTransferCodec, dataTransferHandler)
