# Data transfer channel manager(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/times
import cheng/libp2p/utils/option
import cheng/libp2p/cid
import cheng/libp2p/protocols/datatransfer/protobuf as datatransferprotobuf
const
    maxDataTransferChannels = 128
    dataTransferStatusRequested = "requested"
    dataTransferStatusAccepted = "accepted"
    dataTransferStatusOngoing = "ongoing"
    dataTransferStatusPaused = "paused"
    dataTransferStatusCompleted = "completed"
    dataTransferStatusFailed = "failed"
    dataTransferStatusCancelled = "cancelled"
    dataTransferStatusRejected = "rejected"

type
    DataTransferChannel =
        used: bool
        transferId: int64
        isPull: bool
        voucherType: str
        voucher: Bytes
        selector: Bytes
        hasBaseCid: bool
        baseCid: Cid
        status: str
        paused: bool
        errorCode: int32
        errorMessage: str
        createdAtNs: int64
        updatedAtNs: int64
        completedAtNs: int64
        messageCount: int32

    DataTransferChannelList =
        count: int32
        items: DataTransferChannel[maxDataTransferChannels]

    DataTransferChannelManager =
        count: int32
        channels: DataTransferChannel[maxDataTransferChannels]

fn initDataTransferChannelManager(): DataTransferChannelManager =
    DataTransferChannelManager(count: 0)

fn initDataTransferChannelList(): DataTransferChannelList =
    DataTransferChannelList(count: 0)

fn cloneBytes(data: Bytes): Bytes =
    if BytesLen(data) <= 0:
        return EmptyBytes()
    return BytesSlice(data, 0, BytesLen(data))

fn initDataTransferChannel(transferId: int64): DataTransferChannel =
    let nowNs: int64 = EpochTimeNs()
    DataTransferChannel(
        used: true,
        transferId: transferId,
        isPull: false,
        voucherType: "",
        voucher: EmptyBytes(),
        selector: EmptyBytes(),
        hasBaseCid: false,
        status: "",
        paused: false,
        errorCode: 0,
        errorMessage: "",
        createdAtNs: nowNs,
        updatedAtNs: nowNs,
        completedAtNs: 0,
        messageCount: 0
    )

fn dataTransferChannelHasStatus(ch: DataTransferChannel, status: str): bool =
    if len(status) <= 0:
        return false
    return (ch.status == status)

fn findDataTransferChannel(manager: DataTransferChannelManager, transferId: int64): int32 =
    for i in 0..<manager.count:
        if manager.channels[i].used && manager.channels[i].transferId == transferId:
            return i
    return -1

fn findOldestDataTransferChannel(manager: DataTransferChannelManager): int32 =
    var oldestIdx: int32 = -1
    var oldestTime: int64
    for i in 0..<manager.count:
        let ch: DataTransferChannel = manager.channels[i]
        if ch.used:
            if oldestIdx < 0 || ch.updatedAtNs < oldestTime:
                oldestIdx = i
                oldestTime = ch.updatedAtNs
    return oldestIdx

fn findFreeDataTransferChannel(manager: DataTransferChannelManager): int32 =
    for i in 0..<manager.count:
        if ! manager.channels[i].used:
            return i
    return -1

fn reserveDataTransferChannelIndex(manager: var DataTransferChannelManager): int32 =
    let freeIdx: int32 = findFreeDataTransferChannel(manager)
    if freeIdx >= 0:
        return freeIdx
    if manager.count < maxDataTransferChannels:
        let idx: int32 = manager.count
        manager.count = manager.count + 1
        return idx
    return findOldestDataTransferChannel(manager)

fn dataTransferChannelGet(manager: DataTransferChannelManager, transferId: int64): Option[DataTransferChannel] =
    let idx: int32 = findDataTransferChannel(manager, transferId)
    if idx < 0:
        return None[DataTransferChannel]()
    return Some[DataTransferChannel](manager.channels[idx])

fn dataTransferChannelRemove(manager: var DataTransferChannelManager, transferId: int64): Result[bool] =
    let idx: int32 = findDataTransferChannel(manager, transferId)
    if idx < 0:
        return Err[bool]("datatransfer: channel ! found")
    manager.channels[idx].used = false
    return Ok[bool](true)

fn dataTransferChannelList(manager: DataTransferChannelManager): DataTransferChannelList =
    var list: DataTransferChannelList = initDataTransferChannelList()
    for i in 0..<manager.count:
        if ! (i < manager.count && list.count < maxDataTransferChannels):
            break
        if manager.channels[i].used:
            list.items[list.count] = manager.channels[i]
            list.count = list.count + 1
    return list

fn dataTransferChannelApplyRequest(channel: var DataTransferChannel, req: DataTransferRequest) =
    channel.isPull = req.isPull
    channel.voucherType = req.voucherType
    channel.voucher = cloneBytes(req.voucher)
    channel.selector = cloneBytes(req.selector)
    channel.hasBaseCid = req.hasBaseCid
    if req.hasBaseCid:
        channel.baseCid = req.baseCid
    channel.status = dataTransferStatusRequested

fn dataTransferChannelApplyResponse(channel: var DataTransferChannel, resp: DataTransferResponse) =
    if resp.hasStatus && len(resp.status) > 0:
        channel.status = resp.status
    else:
        if resp.accepted:
            channel.status = dataTransferStatusAccepted
        else:
            channel.status = dataTransferStatusRejected
    if resp.pause:
        channel.paused = true

fn dataTransferChannelApplyControl(channel: var DataTransferChannel, ctrl: DataTransferControl) =
    if ctrl.hasStatus && len(ctrl.status) > 0:
        channel.status = ctrl.status
    else:
        if ctrl.controlType == dtctPause:
            channel.status = dataTransferStatusPaused
        elif ctrl.controlType == dtctResume:
            channel.status = dataTransferStatusOngoing
        elif ctrl.controlType == dtctCancel:
            channel.status = dataTransferStatusCancelled
        elif ctrl.controlType == dtctComplete:
            channel.status = dataTransferStatusCompleted
        else:
            channel.status = dataTransferStatusOngoing
    if ctrl.controlType == dtctPause:
        channel.paused = true
    elif ctrl.controlType == dtctResume:
        channel.paused = false

fn dataTransferChannelApplyError(channel: var DataTransferChannel, err: DataTransferError) =
    channel.status = dataTransferStatusFailed
    channel.errorCode = err.code
    channel.errorMessage = err.message

fn dataTransferChannelApply(
    manager: var DataTransferChannelManager,
    msg: DataTransferMessage
): Result[Option[DataTransferChannel]] =
    var idx: int32 = findDataTransferChannel(manager, msg.transferId)
    if idx < 0:
        idx = reserveDataTransferChannelIndex(manager)
        if idx < 0:
            return Err[Option[DataTransferChannel]]("datatransfer: channel limit reached")
        manager.channels[idx] = initDataTransferChannel(msg.transferId)
    var channel: DataTransferChannel = manager.channels[idx]
    let nowNs: int64 = EpochTimeNs()
    channel.updatedAtNs = nowNs
    channel.messageCount = channel.messageCount + 1
    if msg.paused:
        channel.paused = true
    if msg.kind == dtmkRequest:
        if msg.hasRequest:
            dataTransferChannelApplyRequest(channel, msg.request)
    elif msg.kind == dtmkResponse:
        if msg.hasResponse:
            dataTransferChannelApplyResponse(channel, msg.response)
            if ! msg.response.accepted:
                channel.completedAtNs = nowNs
    elif msg.kind == dtmkControl:
        if msg.hasControl:
            dataTransferChannelApplyControl(channel, msg.control)
            if dataTransferChannelHasStatus(channel, dataTransferStatusCompleted) ||
               dataTransferChannelHasStatus(channel, dataTransferStatusCancelled):
                channel.completedAtNs = nowNs
    elif msg.kind == dtmkError:
        if msg.hasError:
            dataTransferChannelApplyError(channel, msg.error)
            channel.completedAtNs = nowNs
    manager.channels[idx] = channel
    return Ok[Option[DataTransferChannel]](Some[DataTransferChannel](channel))
