# Data transfer graphsync adapter(minimal).

import cheng/libp2p/peerid
import cheng/libp2p/protocols/datatransfer/channelmanager
import cheng/libp2p/protocols/graphsync/graphsync
type
    GraphsyncRequestHook = fn(peer: PeerId, root: Cid, selector: Bytes): Result[GraphsyncMessage]

    DataTransferGraphsyncAdapter =
        hasRequest: bool
        request: GraphsyncRequestHook

fn initDataTransferGraphsyncAdapter(request: GraphsyncRequestHook): DataTransferGraphsyncAdapter =
    DataTransferGraphsyncAdapter(hasRequest: true, request: request)

fn dataTransferGraphsyncRequest(
    adapter: DataTransferGraphsyncAdapter,
    peer: PeerId,
    req: DataTransferRequest
): Result[GraphsyncMessage] =
    if ! adapter.hasRequest:
        return Err[GraphsyncMessage]("datatransfer: missing graphsync request hook")
    if ! req.hasBaseCid:
        return Err[GraphsyncMessage]("datatransfer: request missing base cid")
    return adapter.request(peer, req.baseCid, req.selector)

fn dataTransferGraphsyncRequestFromMessage(
    adapter: DataTransferGraphsyncAdapter,
    peer: PeerId,
    msg: DataTransferMessage
): Result[GraphsyncMessage] =
    if msg.kind != dtmkRequest || ! msg.hasRequest:
        return Err[GraphsyncMessage]("datatransfer: message is ! a request")
    return dataTransferGraphsyncRequest(adapter, peer, msg.request)

fn dataTransferStatusFromGraphsync(status: int32): str =
    if status == int32(gsrsRequestCompletedFull) || status == int32(gsrsRequestCompletedPartial):
        return dataTransferStatusCompleted
    if status == int32(gsrsRequestPaused):
        return dataTransferStatusPaused
    if status == int32(gsrsRequestCancelled):
        return dataTransferStatusCancelled
    if status == int32(gsrsRequestRejected) ||
       status == int32(gsrsRequestFailedBusy) ||
       status == int32(gsrsRequestFailedUnknown) ||
       status == int32(gsrsRequestFailedLegal) ||
       status == int32(gsrsRequestFailedContentNotFound):
        return dataTransferStatusFailed
    if status == int32(gsrsRequestAcknowledged) ||
       status == int32(gsrsAdditionalPeers) ||
       status == int32(gsrsPartialResponse):
        return dataTransferStatusOngoing
    return dataTransferStatusOngoing

fn dataTransferResponseFromGraphsync(resp: GraphsyncResponse): DataTransferResponse =
    var out: DataTransferResponse = initDataTransferResponse()
    let status: str = dataTransferStatusFromGraphsync(resp.status)
    out.hasStatus = true
    out.status = status
    out.accepted = (status != dataTransferStatusFailed) && (status != dataTransferStatusCancelled)
    if (status == dataTransferStatusPaused):
        out.pause = true
    return out

fn dataTransferResponseFromGraphsync(msg: GraphsyncMessage): DataTransferResponse =
    if msg.responseCount <= 0:
        var out: DataTransferResponse = initDataTransferResponse()
        out.hasStatus = true
        out.status = dataTransferStatusFailed
        out.accepted = false
        return out
    return dataTransferResponseFromGraphsync(msg.responses[0])
