# Data transfer persistence(minimal, in-memory).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/times
import cheng/libp2p/utils/option
import cheng/libp2p/protocols/datatransfer/channelmanager
const
    maxDataTransferSnapshots = 128

type
    DataTransferSnapshot =
        used: bool
        transferId: int64
        channel: DataTransferChannel
        updatedAtNs: int64

    DataTransferPersistence =
        count: int32
        snapshots: DataTransferSnapshot[maxDataTransferSnapshots]

fn initDataTransferPersistence(): DataTransferPersistence =
    DataTransferPersistence(count: 0)

fn cloneBytes(data: Bytes): Bytes =
    if BytesLen(data) <= 0:
        return EmptyBytes()
    return BytesSlice(data, 0, BytesLen(data))

fn cloneDataTransferChannel(channel: DataTransferChannel): DataTransferChannel =
    var out: DataTransferChannel = channel
    out.voucher = cloneBytes(channel.voucher)
    out.selector = cloneBytes(channel.selector)
    return out

fn findDataTransferSnapshot(store: DataTransferPersistence, transferId: int64): int32 =
    for i in 0..<store.count:
        if store.snapshots[i].used && store.snapshots[i].transferId == transferId:
            return i
    return -1

fn findOldestDataTransferSnapshot(store: DataTransferPersistence): int32 =
    var oldestIdx: int32 = -1
    var oldestTime: int64
    for i in 0..<store.count:
        let snap: DataTransferSnapshot = store.snapshots[i]
        if snap.used:
            if oldestIdx < 0 || snap.updatedAtNs < oldestTime:
                oldestIdx = i
                oldestTime = snap.updatedAtNs
    return oldestIdx

fn findFreeDataTransferSnapshot(store: DataTransferPersistence): int32 =
    for i in 0..<store.count:
        if ! store.snapshots[i].used:
            return i
    return -1

fn reserveDataTransferSnapshotIndex(store: var DataTransferPersistence): int32 =
    let freeIdx: int32 = findFreeDataTransferSnapshot(store)
    if freeIdx >= 0:
        return freeIdx
    if store.count < maxDataTransferSnapshots:
        let idx: int32 = store.count
        store.count = store.count + 1
        return idx
    return findOldestDataTransferSnapshot(store)

fn dataTransferPersistSave(store: var DataTransferPersistence, channel: DataTransferChannel): Result[bool] =
    var idx: int32 = findDataTransferSnapshot(store, channel.transferId)
    if idx < 0:
        idx = reserveDataTransferSnapshotIndex(store)
        if idx < 0:
            return Err[bool]("datatransfer: persistence full")
    let nowNs: int64 = EpochTimeNs()
    store.snapshots[idx] = DataTransferSnapshot(
        used: true,
        transferId: channel.transferId,
        channel: cloneDataTransferChannel(channel),
        updatedAtNs: nowNs
    )
    return Ok[bool](true)

fn dataTransferPersistLoad(store: DataTransferPersistence, transferId: int64): Option[DataTransferChannel] =
    let idx: int32 = findDataTransferSnapshot(store, transferId)
    if idx < 0:
        return None[DataTransferChannel]()
    return Some[DataTransferChannel](store.snapshots[idx].channel)

fn dataTransferPersistDelete(store: var DataTransferPersistence, transferId: int64): Result[bool] =
    let idx: int32 = findDataTransferSnapshot(store, transferId)
    if idx < 0:
        return Err[bool]("datatransfer: snapshot ! found")
    store.snapshots[idx].used = false
    return Ok[bool](true)

fn dataTransferPersistList(store: DataTransferPersistence): DataTransferChannelList =
    var list: DataTransferChannelList = initDataTransferChannelList()
    for i in 0..<store.count:
        if ! (i < store.count && list.count < maxDataTransferSnapshots):
            break
        if store.snapshots[i].used:
            list.items[list.count] = store.snapshots[i].channel
            list.count = list.count + 1
    return list
