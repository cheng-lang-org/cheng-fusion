# Data transfer protobuf messages(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/cid
const
    maxDataTransferExtensions = 16

    transferIdField = 1
    kindField = 2
    pausedField = 3
    requestField = 4
    responseField = 5
    controlField = 6
    errorField = 7
    extensionField = 8

    reqIsPullField = 1
    reqVoucherTypeField = 2
    reqVoucherField = 3
    reqSelectorField = 4
    reqBaseCidField = 5

    respAcceptedField = 1
    respStatusField = 2
    respPauseField = 3

    ctrlTypeField = 1
    ctrlStatusField = 2

    errCodeField = 1
    errMessageField = 2

    extNameField = 1
    extDataField = 2

type
    DataTransferMessageKind = enum
        dtmkRequest = 0
        dtmkResponse = 1
        dtmkControl = 2
        dtmkError = 3

    DataTransferControlType = enum
        dtctUnknown = 0
        dtctOpen = 1
        dtctRestart = 2
        dtctCancel = 3
        dtctComplete = 4
        dtctPause = 5
        dtctResume = 6

    DataTransferExtension =
        name: str
        data: Bytes

    DataTransferRequest =
        isPull: bool
        voucherType: str
        voucher: Bytes
        selector: Bytes
        hasBaseCid: bool
        baseCid: Cid

    DataTransferResponse =
        accepted: bool
        hasStatus: bool
        status: str
        pause: bool

    DataTransferControl =
        controlType: DataTransferControlType
        hasStatus: bool
        status: str

    DataTransferError =
        code: int32
        message: str

    DataTransferMessage =
        transferId: int64
        paused: bool
        kind: DataTransferMessageKind
        hasRequest: bool
        request: DataTransferRequest
        hasResponse: bool
        response: DataTransferResponse
        hasControl: bool
        control: DataTransferControl
        hasError: bool
        error: DataTransferError
        extensionCount: int32
        extensions: DataTransferExtension[maxDataTransferExtensions]

fn initDataTransferRequest(): DataTransferRequest =
    DataTransferRequest(
        isPull: false,
        voucherType: "",
        voucher: EmptyBytes(),
        selector: EmptyBytes(),
        hasBaseCid: false
    )

fn initDataTransferResponse(): DataTransferResponse =
    DataTransferResponse(accepted: false, hasStatus: false, status: "", pause: false)

fn initDataTransferControl(): DataTransferControl =
    DataTransferControl(controlType: dtctUnknown, hasStatus: false, status: "")

fn initDataTransferMessage(): DataTransferMessage =
    DataTransferMessage(
        transferId: 0,
        paused: false,
        kind: dtmkRequest,
        hasRequest: false,
        hasResponse: false,
        hasControl: false,
        hasError: false,
        extensionCount: 0
    )

fn dataTransferKindFromInt(value: int64): Result[DataTransferMessageKind] =
    if value == 0:
        return Ok[DataTransferMessageKind](dtmkRequest)
    if value == 1:
        return Ok[DataTransferMessageKind](dtmkResponse)
    if value == 2:
        return Ok[DataTransferMessageKind](dtmkControl)
    if value == 3:
        return Ok[DataTransferMessageKind](dtmkError)
    return Err[DataTransferMessageKind]("datatransfer: invalid kind")

fn dataTransferControlFromInt(value: int64): Result[DataTransferControlType] =
    if value == 0:
        return Ok[DataTransferControlType](dtctUnknown)
    if value == 1:
        return Ok[DataTransferControlType](dtctOpen)
    if value == 2:
        return Ok[DataTransferControlType](dtctRestart)
    if value == 3:
        return Ok[DataTransferControlType](dtctCancel)
    if value == 4:
        return Ok[DataTransferControlType](dtctComplete)
    if value == 5:
        return Ok[DataTransferControlType](dtctPause)
    if value == 6:
        return Ok[DataTransferControlType](dtctResume)
    return Err[DataTransferControlType]("datatransfer: invalid control type")

fn encodeDataTransferExtension(ext: DataTransferExtension): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    if len(ext.name) > 0:
        writeString(pb, extNameField, ext.name)
    if BytesLen(ext.data) > 0:
        writeBytes(pb, extDataField, ext.data)
    return protoToBytes(pb)

fn decodeDataTransferExtension(data: Bytes): Result[DataTransferExtension] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var name: str
    let nameRes: Result[bool] = getField(pb, extNameField, name)
    if IsErr(nameRes):
        return Err[DataTransferExtension](Error(nameRes))
    if ! Value(nameRes) || len(name) <= 0:
        return Err[DataTransferExtension]("datatransfer: missing extension name")
    var payload: Bytes = EmptyBytes()
    let payloadRes: Result[bool] = getField(pb, extDataField, payload)
    if IsErr(payloadRes):
        return Err[DataTransferExtension](Error(payloadRes))
    if ! Value(payloadRes):
        payload = EmptyBytes()
    return Ok[DataTransferExtension](DataTransferExtension(name: name, data: payload))

fn encodeDataTransferRequest(req: DataTransferRequest): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    if req.isPull:
        writeVarint(pb, reqIsPullField, 1)
    if len(req.voucherType) > 0:
        writeString(pb, reqVoucherTypeField, req.voucherType)
    if BytesLen(req.voucher) > 0:
        writeBytes(pb, reqVoucherField, req.voucher)
    if BytesLen(req.selector) > 0:
        writeBytes(pb, reqSelectorField, req.selector)
    if req.hasBaseCid:
        let baseRes: Result[Bytes] = cidToBytes(req.baseCid)
        if IsOk(baseRes):
            writeBytes(pb, reqBaseCidField, Value(baseRes))
    return protoToBytes(pb)

fn decodeDataTransferRequest(data: Bytes): Result[DataTransferRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: DataTransferRequest = initDataTransferRequest()
    var pullVal: int64
    let pullRes: Result[bool] = getField(pb, reqIsPullField, pullVal)
    if IsErr(pullRes):
        return Err[DataTransferRequest](Error(pullRes))
    if Value(pullRes):
        req.isPull = pullVal != 0
    var vtype: str
    let vtypeRes: Result[bool] = getField(pb, reqVoucherTypeField, vtype)
    if IsErr(vtypeRes):
        return Err[DataTransferRequest](Error(vtypeRes))
    if Value(vtypeRes):
        req.voucherType = vtype
    var voucher: Bytes = EmptyBytes()
    let voucherRes: Result[bool] = getField(pb, reqVoucherField, voucher)
    if IsErr(voucherRes):
        return Err[DataTransferRequest](Error(voucherRes))
    if Value(voucherRes):
        req.voucher = voucher
    var selector: Bytes = EmptyBytes()
    let selRes: Result[bool] = getField(pb, reqSelectorField, selector)
    if IsErr(selRes):
        return Err[DataTransferRequest](Error(selRes))
    if Value(selRes):
        req.selector = selector
    var baseBytes: Bytes = EmptyBytes()
    let baseRes: Result[bool] = getField(pb, reqBaseCidField, baseBytes)
    if IsErr(baseRes):
        return Err[DataTransferRequest](Error(baseRes))
    if Value(baseRes):
        let cidRes: Result[Cid] = cidFromBytes(baseBytes)
        if IsErr(cidRes):
            return Err[DataTransferRequest](Error(cidRes))
        req.hasBaseCid = true
        req.baseCid = Value(cidRes)
    return Ok[DataTransferRequest](req)

fn encodeDataTransferResponse(resp: DataTransferResponse): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    if resp.accepted:
        writeVarint(pb, respAcceptedField, 1)
    if resp.hasStatus && len(resp.status) > 0:
        writeString(pb, respStatusField, resp.status)
    if resp.pause:
        writeVarint(pb, respPauseField, 1)
    return protoToBytes(pb)

fn decodeDataTransferResponse(data: Bytes): Result[DataTransferResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: DataTransferResponse = initDataTransferResponse()
    var acceptedVal: int64
    let acceptedRes: Result[bool] = getField(pb, respAcceptedField, acceptedVal)
    if IsErr(acceptedRes):
        return Err[DataTransferResponse](Error(acceptedRes))
    if Value(acceptedRes):
        resp.accepted = acceptedVal != 0
    var statusVal: str
    let statusRes: Result[bool] = getField(pb, respStatusField, statusVal)
    if IsErr(statusRes):
        return Err[DataTransferResponse](Error(statusRes))
    if Value(statusRes):
        resp.hasStatus = true
        resp.status = statusVal
    var pauseVal: int64
    let pauseRes: Result[bool] = getField(pb, respPauseField, pauseVal)
    if IsErr(pauseRes):
        return Err[DataTransferResponse](Error(pauseRes))
    if Value(pauseRes):
        resp.pause = pauseVal != 0
    return Ok[DataTransferResponse](resp)

fn encodeDataTransferControl(ctrl: DataTransferControl): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    if ctrl.controlType != dtctUnknown:
        writeVarint(pb, ctrlTypeField, int64(ctrl.controlType))
    if ctrl.hasStatus && len(ctrl.status) > 0:
        writeString(pb, ctrlStatusField, ctrl.status)
    return protoToBytes(pb)

fn decodeDataTransferControl(data: Bytes): Result[DataTransferControl] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var ctrl: DataTransferControl = initDataTransferControl()
    var typeVal: int64
    let typeRes: Result[bool] = getField(pb, ctrlTypeField, typeVal)
    if IsErr(typeRes):
        return Err[DataTransferControl](Error(typeRes))
    if Value(typeRes):
        let ctrlRes: Result[DataTransferControlType] = dataTransferControlFromInt(typeVal)
        if IsErr(ctrlRes):
            return Err[DataTransferControl](Error(ctrlRes))
        ctrl.controlType = Value(ctrlRes)
    var statusVal: str
    let statusRes: Result[bool] = getField(pb, ctrlStatusField, statusVal)
    if IsErr(statusRes):
        return Err[DataTransferControl](Error(statusRes))
    if Value(statusRes):
        ctrl.hasStatus = true
        ctrl.status = statusVal
    return Ok[DataTransferControl](ctrl)

fn encodeDataTransferError(err: DataTransferError): Bytes =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, errCodeField, int64(err.code))
    if len(err.message) > 0:
        writeString(pb, errMessageField, err.message)
    return protoToBytes(pb)

fn decodeDataTransferError(data: Bytes): Result[DataTransferError] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var codeVal: int64
    let codeRes: Result[bool] = getField(pb, errCodeField, codeVal)
    if IsErr(codeRes):
        return Err[DataTransferError](Error(codeRes))
    if ! Value(codeRes):
        return Err[DataTransferError]("datatransfer: missing error code")
    var messageVal: str
    let msgRes: Result[bool] = getField(pb, errMessageField, messageVal)
    if IsErr(msgRes):
        return Err[DataTransferError](Error(msgRes))
    return Ok[DataTransferError](DataTransferError(code: int32(codeVal), message: messageVal))

fn encodeDataTransferMessage(msg: DataTransferMessage): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    writeVarint(pb, transferIdField, int64(msg.transferId))
    writeVarint(pb, kindField, int64(msg.kind))
    if msg.paused:
        writeVarint(pb, pausedField, 1)
    if msg.hasRequest:
        writeBytes(pb, requestField, encodeDataTransferRequest(msg.request))
    if msg.hasResponse:
        writeBytes(pb, responseField, encodeDataTransferResponse(msg.response))
    if msg.hasControl:
        writeBytes(pb, controlField, encodeDataTransferControl(msg.control))
    if msg.hasError:
        writeBytes(pb, errorField, encodeDataTransferError(msg.error))
    for i in 0..<msg.extensionCount:
        writeBytes(pb, extensionField, encodeDataTransferExtension(msg.extensions[i]))
    return Ok[Bytes](protoToBytes(pb))

fn decodeDataTransferMessage(data: Bytes): Result[DataTransferMessage] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var msg: DataTransferMessage = initDataTransferMessage()
    var transferVal: int64
    let transferRes: Result[bool] = getField(pb, transferIdField, transferVal)
    if IsErr(transferRes):
        return Err[DataTransferMessage](Error(transferRes))
    if ! Value(transferRes):
        return Err[DataTransferMessage]("datatransfer: missing transfer id")
    msg.transferId = transferVal
    var kindVal: int64
    let kindRes: Result[bool] = getField(pb, kindField, kindVal)
    if IsErr(kindRes):
        return Err[DataTransferMessage](Error(kindRes))
    if ! Value(kindRes):
        return Err[DataTransferMessage]("datatransfer: missing kind")
    let kindConv: Result[DataTransferMessageKind] = dataTransferKindFromInt(kindVal)
    if IsErr(kindConv):
        return Err[DataTransferMessage](Error(kindConv))
    msg.kind = Value(kindConv)
    var pausedVal: int64
    let pausedRes: Result[bool] = getField(pb, pausedField, pausedVal)
    if IsErr(pausedRes):
        return Err[DataTransferMessage](Error(pausedRes))
    if Value(pausedRes):
        msg.paused = pausedVal != 0
    var reqBytes: Bytes = EmptyBytes()
    let reqRes: Result[bool] = getField(pb, requestField, reqBytes)
    if IsErr(reqRes):
        return Err[DataTransferMessage](Error(reqRes))
    if Value(reqRes):
        let reqValRes: Result[DataTransferRequest] = decodeDataTransferRequest(reqBytes)
        if IsErr(reqValRes):
            return Err[DataTransferMessage](Error(reqValRes))
        msg.hasRequest = true
        msg.request = Value(reqValRes)
    var respBytes: Bytes = EmptyBytes()
    let respRes: Result[bool] = getField(pb, responseField, respBytes)
    if IsErr(respRes):
        return Err[DataTransferMessage](Error(respRes))
    if Value(respRes):
        let respValRes: Result[DataTransferResponse] = decodeDataTransferResponse(respBytes)
        if IsErr(respValRes):
            return Err[DataTransferMessage](Error(respValRes))
        msg.hasResponse = true
        msg.response = Value(respValRes)
    var ctrlBytes: Bytes = EmptyBytes()
    let ctrlRes: Result[bool] = getField(pb, controlField, ctrlBytes)
    if IsErr(ctrlRes):
        return Err[DataTransferMessage](Error(ctrlRes))
    if Value(ctrlRes):
        let ctrlValRes: Result[DataTransferControl] = decodeDataTransferControl(ctrlBytes)
        if IsErr(ctrlValRes):
            return Err[DataTransferMessage](Error(ctrlValRes))
        msg.hasControl = true
        msg.control = Value(ctrlValRes)
    var errBytes: Bytes = EmptyBytes()
    let errRes: Result[bool] = getField(pb, errorField, errBytes)
    if IsErr(errRes):
        return Err[DataTransferMessage](Error(errRes))
    if Value(errRes):
        let errValRes: Result[DataTransferError] = decodeDataTransferError(errBytes)
        if IsErr(errValRes):
            return Err[DataTransferMessage](Error(errValRes))
        msg.hasError = true
        msg.error = Value(errValRes)
    var extBytes: RepeatedBytes = initRepeatedBytes()
    let extRes: Result[bool] = getRepeatedField(pb, extensionField, extBytes)
    if IsErr(extRes):
        return Err[DataTransferMessage](Error(extRes))
    if Value(extRes):
        for i in 0..<extBytes.count:
            if msg.extensionCount >= maxDataTransferExtensions:
                return Err[DataTransferMessage]("datatransfer: too many extensions")
            let extValRes: Result[DataTransferExtension] = decodeDataTransferExtension(extBytes.items[i])
            if IsErr(extValRes):
                return Err[DataTransferMessage](Error(extValRes))
            msg.extensions[msg.extensionCount] = Value(extValRes)
            msg.extensionCount = msg.extensionCount + 1
    return Ok[DataTransferMessage](msg)
