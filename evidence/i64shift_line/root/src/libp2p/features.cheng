# Feature flags(compile-time in Nim, runtime constants in Cheng).

import cheng/libp2p/utils/strings
const
    libp2pFetchEnabled = true
    libp2pHttpEnabled = true
    libp2pEpisubEnabled = true
    libp2pDataTransferEnabled = true

fn disabledFeatureMessage(featureName: str, flag: str): str =
    let head: str = featureName + " feature disabled at compile time(use -d:"
    let mid: str = head + flag
    return mid + " to toggle)"
