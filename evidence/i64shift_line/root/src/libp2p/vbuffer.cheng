# Growable buffer(partial).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
type
    VBuffer =
        data: Bytes
        offset: int32

fn newVBuffer(): VBuffer =
    VBuffer(data: EmptyBytes(), offset: 0)

fn initVBuffer(data: Bytes, offset: int32): VBuffer =
    VBuffer(data: data, offset: offset)

fn len(buf: VBuffer): int32 =
    let remaining: int32 = BytesLen(buf.data) - buf.offset
    if remaining < 0:
        return 0
    return remaining

fn isEmpty(buf: VBuffer): bool =
    len(buf) <= 0

fn isEnough(buf: VBuffer, count: int32): bool =
    len(buf) >= count

fn appendBytes(buf: var VBuffer, data: Bytes) =
    let addLen: int32 = BytesLen(data)
    if addLen <= 0:
        return
    buf.data = BytesConcat(buf.data, data)
    buf.offset = BytesLen(buf.data)

fn appendBytes(buf: var VBuffer, data: str) =
    appendBytes(buf, BytesFromString(data))

fn writeVarint(buf: var VBuffer, value: int64) =
    appendBytes(buf, encodeUVarint(value))

fn writeSeq(buf: var VBuffer, data: Bytes) =
    appendBytes(buf, encodeUVarint(BytesLen(data)))
    appendBytes(buf, data)

fn writeSeq(buf: var VBuffer, data: str) =
    writeSeq(buf, BytesFromString(data))

fn writeArray(buf: var VBuffer, data: Bytes) =
    appendBytes(buf, data)

fn writeArray(buf: var VBuffer, data: str) =
    writeArray(buf, BytesFromString(data))

fn readVarint(buf: var VBuffer): Result[int64] =
    if isEmpty(buf):
        return Err[int64]("vbuffer: empty")
    let res: Result[VarintDecoded] = decodeUVarint(buf.data, buf.offset)
    if IsErr(res):
        return Err[int64](Error(res))
    let dec: VarintDecoded = Value(res)
    buf.offset = dec.next
    return Ok[int64](dec.value)

fn readSeq(buf: var VBuffer): Result[Bytes] =
    let lenRes: Result[VarintDecoded] = decodeUVarint(buf.data, buf.offset)
    if IsErr(lenRes):
        return Err[Bytes](Error(lenRes))
    let dec: VarintDecoded = Value(lenRes)
    let size: int32 = int32(dec.value)
    let start: int32 = dec.next
    if size < 0 || start + size > BytesLen(buf.data):
        return Err[Bytes]("vbuffer: seq out of range")
    buf.offset = start + size
    return Ok[Bytes](BytesSlice(buf.data, start, size))

fn readArray(buf: var VBuffer, size: int32): Result[Bytes] =
    if size < 0 || buf.offset + size > BytesLen(buf.data):
        return Err[Bytes]("vbuffer: array out of range")
    let start: int32 = buf.offset
    buf.offset = buf.offset + size
    return Ok[Bytes](BytesSlice(buf.data, start, size))

fn finish(buf: var VBuffer) =
    buf.offset = 0

fn toBytes(buf: VBuffer): Bytes =
    buf.data

fn toString(buf: VBuffer): str =
    BytesToString(buf.data)
