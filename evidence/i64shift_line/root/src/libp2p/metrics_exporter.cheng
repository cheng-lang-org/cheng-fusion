# Metrics exporter(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/services/metricsservice
fn exportMetricsText(): str =
    return metricsDump()

fn exportMetricsBytes(): Bytes =
    let text = metricsDump()
    return BytesSlice(BytesFromString(text), 0, len(text))

fn exportMetricsTextResult(): Result[str] =
    return Ok[str](metricsDump())
