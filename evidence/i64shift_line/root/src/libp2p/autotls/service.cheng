# AutoTLS service(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/autotls/utils
import cheng/libp2p/autotls/acme/client
import cheng/libp2p/autotls/acme/mockapi
type
    AutoTlsConfig =
        enabled: bool
        email: str
        endpoint: str

    AutoTlsState =
        config: AutoTlsConfig
        lastDomain: str
        lastOk: bool

var
    autoTlsState: AutoTlsState = AutoTlsState(
        config: AutoTlsConfig(enabled: false, email: "", endpoint: ""),
        lastDomain: "",
        lastOk: false
    )

fn initAutoTlsConfig(): AutoTlsConfig =
    AutoTlsConfig(enabled: false, email: "", endpoint: "")

fn setAutoTlsConfig(config: AutoTlsConfig) =
    autoTlsState.config = config

fn autoTlsEnabled(): bool =
    autoTlsState.config.enabled

fn autoTlsLastDomain(): str =
    return autoTlsState.lastDomain

fn autoTlsLastOk(): bool =
    return autoTlsState.lastOk

fn autoTlsRequestCertificate(domain: str): Result[bool] =
    if ! autoTlsEnabled():
        autoTlsState.lastOk = false
        return Err[bool]("autotls: disabled")
    let normalized: str = normalizeDomain(domain)
    if ! isValidDomain(normalized):
        autoTlsState.lastOk = false
        return Err[bool]("autotls: invalid domain")
    let client: AcmeClient = initAcmeClient(autoTlsState.config.email, autoTlsState.config.endpoint)
    let orderRes: Result[AcmeOrder] = acmeNewOrder(client, normalized)
    if IsErr(orderRes):
        autoTlsState.lastOk = false
        return Err[bool](Error(orderRes))
    autoTlsState.lastDomain = normalized
    autoTlsState.lastOk = true
    return Ok[bool](true)

fn autoTlsMockOrder(domain: str): Result[AcmeOrder] =
    return acmeMockCreateOrder(domain)
