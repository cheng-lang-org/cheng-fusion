# AutoTLS utils(minimal).

import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
fn isDomainWhitespace(c: char): bool =
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'

fn isDomainLabelChar(c: char): bool =
    if c >= 'a' && c <= 'z':
        return true
    if c >= '0' && c <= '9':
        return true
    return c == '-'

fn normalizeDomain(name: str): str =
    let total: int32 = len(name)
    if total <= 0:
        return ""
    var start: int32 = total
    var endPos: int32 = total
    for scanStart in 0..<endPos:
        if ! isDomainWhitespace(name[scanStart]):
            start = scanStart
            break
    let loop_start_endPos_2 = endPos
    for loop_rev_endPos_2 in 0..(loop_start_endPos_2 - (start)):
        endPos = loop_start_endPos_2 - loop_rev_endPos_2
        if ! (endPos > start && isDomainWhitespace(name[endPos - 1])):
            break
    if endPos > start && name[endPos - 1] == '.':
        endPos = endPos - 1
    let outLen: int32 = endPos - start
    if outLen <= 0:
        return ""
    let out: Bytes = BytesAlloc(outLen)
    for i in 0..<outLen:
        let c: char = name[start + i]
        var v: int32 = int32(c)
        if v >= int32('A') && v <= int32('Z'):
            v = v + 32
        BytesSet(out, i, v)
    return BytesToString(out)

fn isValidDomain(name: str): bool =
    let normalized: str = normalizeDomain(name)
    let total: int32 = len(normalized)
    if total <= 0 || total > 253:
        return false
    var labelStart: int32
    var labelLen: int32
    var labelIndex: int32
    var hasDot: bool
    var hasWildcard: bool
    for i in 0..<total:
        let c: char = normalized[i]
        if c == '.':
            if labelLen <= 0 || labelLen > 63:
                return false
            if labelIndex == 0 && labelLen == 1 && normalized[labelStart] == '*':
                hasWildcard = true
            else:
                if normalized[labelStart] == '-' || normalized[labelStart + labelLen - 1] == '-':
                    return false
                var j: int32
                for j in 0..<labelLen:
                    if ! (j < labelLen):
                        break
                    let lc: char = normalized[labelStart + j]
                    if lc == '*' || ! isDomainLabelChar(lc):
                        return false
            labelIndex = labelIndex + 1
            labelStart = i + 1
            labelLen = 0
            hasDot = true
        else:
            labelLen = labelLen + 1
    if labelLen <= 0 || labelLen > 63:
        return false
    if labelIndex == 0 && labelLen == 1 && normalized[labelStart] == '*':
        return false
    if hasWildcard && ! hasDot:
        return false
    if ! (labelIndex == 0 && labelLen == 1 && normalized[labelStart] == '*'):
        if normalized[labelStart] == '-' || normalized[labelStart + labelLen - 1] == '-':
            return false
        for k in 0..<labelLen:
            let lc: char = normalized[labelStart + k]
            if lc == '*' || ! isDomainLabelChar(lc):
                return false
    return true
