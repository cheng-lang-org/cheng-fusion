# AutoTLS mock service(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
type
    AutoTlsMock =
        lastDomain: str
        issued: bool

var
    autoTlsMock: AutoTlsMock = AutoTlsMock(lastDomain: "", issued: false)

fn autoTlsMockReset() =
    autoTlsMock = AutoTlsMock(lastDomain: "", issued: false)

fn autoTlsMockIssue(domain: str): Result[bool] =
    if len(domain) <= 0:
        return Err[bool]("autotls-mock: empty domain")
    autoTlsMock.lastDomain = domain
    autoTlsMock.issued = true
    return Ok[bool](true)

fn autoTlsMockIssued(): bool =
    return autoTlsMock.issued

fn autoTlsMockLastDomain(): str =
    return autoTlsMock.lastDomain
