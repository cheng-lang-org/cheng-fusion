# ACME mock API(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/autotls/acme/api
type
    AcmeMockState =
        lastOrder: AcmeOrder
        hasOrder: bool

var
    mockState: AcmeMockState = AcmeMockState(hasOrder: false)

fn acmeMockReset() =
    mockState.hasOrder = false

fn acmeMockCreateOrder(domain: str): Result[AcmeOrder] =
    let validRes: Result[bool] = acmeValidateDomain(domain)
    if IsErr(validRes):
        return Err[AcmeOrder](Error(validRes))
    var order: AcmeOrder = initAcmeOrder(domain)
    order.valid = true
    mockState.lastOrder = order
    mockState.hasOrder = true
    return Ok[AcmeOrder](order)

fn acmeMockLastOrder(): Result[AcmeOrder] =
    if ! mockState.hasOrder:
        return Err[AcmeOrder]("acme: no orders")
    return Ok[AcmeOrder](mockState.lastOrder)
