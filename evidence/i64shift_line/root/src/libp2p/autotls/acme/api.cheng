# ACME API types(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
type
    AcmeOrder =
        domain: str
        valid: bool

    AcmeAccount =
        email: str
        active: bool

fn initAcmeOrder(domain: str): AcmeOrder =
    AcmeOrder(domain: domain, valid: false)

fn initAcmeAccount(email: str): AcmeAccount =
    AcmeAccount(email: email, active: false)

fn acmeValidateDomain(domain: str): Result[bool] =
    if len(domain) <= 0:
        return Err[bool]("acme: empty domain")
    return Ok[bool](true)
