# ACME client(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/autotls/acme/api
import cheng/libp2p/autotls/acme/utils
type
    AcmeClient =
        email: str
        endpoint: str

fn initAcmeClient(email: str, endpoint: str): AcmeClient =
    AcmeClient(email: email, endpoint: endpoint)

fn acmeRegisterAccount(client: AcmeClient): Result[AcmeAccount] =
    if len(client.email) <= 0:
        return Err[AcmeAccount]("acme: empty email")
    var acct: AcmeAccount = initAcmeAccount(client.email)
    acct.active = true
    return Ok[AcmeAccount](acct)

fn acmeNewOrder(client: AcmeClient, domain: str): Result[AcmeOrder] =
    client
    let validRes: Result[bool] = acmeValidateDomain(domain)
    if IsErr(validRes):
        return Err[AcmeOrder](Error(validRes))
    var order: AcmeOrder = initAcmeOrder(domain)
    order.valid = true
    return Ok[AcmeOrder](order)

fn acmeClientUserAgent(client: AcmeClient): str =
    client
    return acmeUserAgent()
