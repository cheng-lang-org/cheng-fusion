# Global scale network profile(L1/L2/L3).

import std/stringlist
import cheng/libp2p/utils/strings

type
    NodeTier = enum
        ntL1Core = 0
        ntL2Routing = 1
        ntL3Edge = 2

    DhtMode = enum
        dhtServer = 0
        dhtClient = 1

    AutoRoleMode = enum
        armDisabled = 0
        armPromoteOnPublic = 1

    GlobalScaleProfile =
        enabled: bool
        tier: NodeTier
        dhtMode: DhtMode
        autoRoleMode: AutoRoleMode
        connLowWater: int32
        connHighWater: int32
        relayServiceEnabled: bool
        relayMinTtlSeconds: int64
        relayMaxTtlSeconds: int64
        relayDefaultTtlSeconds: int64
        gossipMeshLow: int32
        gossipMeshHigh: int32
        gossipMeshOutbound: int32
        gossipHeartbeatMs: int32
        gossipStaggerMs: int32
        gossipShardCount: int32
        gossipShardId: int32
        gossipIHaveFanout: int32
        gossipRoutingEnabled: bool
        requireDidForRouting: bool
        powRequired: bool
        powDifficultyBits: int32
        dhtWriteEnabled: bool
        dhtProvideEnabled: bool
        maxConnPerPeer: int32
        maxConnPerSubnet: int32
        maxStreamsPerPeer: int32
        maxStreamsPerProtocol: int32
        rolePromoteRequiredCount: int32
        roleDemoteRequiredCount: int32
        roleCooldownMs: int64

    AutoRoleState =
        consecutivePublic: int32
        consecutivePrivate: int32
        lastTransitionMs: int64

fn initAutoRoleState(): AutoRoleState =
    AutoRoleState(consecutivePublic: 0, consecutivePrivate: 0, lastTransitionMs: 0)

fn initGlobalScaleProfile(): GlobalScaleProfile =
    GlobalScaleProfile(
        enabled: false,
        tier: ntL2Routing,
        dhtMode: dhtServer,
        autoRoleMode: armDisabled,
        connLowWater: 64,
        connHighWater: 128,
        relayServiceEnabled: false,
        relayMinTtlSeconds: 30,
        relayMaxTtlSeconds: 3600,
        relayDefaultTtlSeconds: 120,
        gossipMeshLow: 6,
        gossipMeshHigh: 12,
        gossipMeshOutbound: 2,
        gossipHeartbeatMs: 1000,
        gossipStaggerMs: 15,
        gossipShardCount: 1,
        gossipShardId: 0,
        gossipIHaveFanout: 8,
        gossipRoutingEnabled: true,
        requireDidForRouting: false,
        powRequired: false,
        powDifficultyBits: 0,
        dhtWriteEnabled: true,
        dhtProvideEnabled: true,
        maxConnPerPeer: 16,
        maxConnPerSubnet: 64,
        maxStreamsPerPeer: 64,
        maxStreamsPerProtocol: 512,
        rolePromoteRequiredCount: 3,
        roleDemoteRequiredCount: 3,
        roleCooldownMs: 300000
    )

fn initGlobalScaleProfileL1Core(): GlobalScaleProfile =
    var p: GlobalScaleProfile = initGlobalScaleProfile()
    p.enabled = true
    p.tier = ntL1Core
    p.dhtMode = dhtServer
    p.relayServiceEnabled = true
    p.connLowWater = 200
    p.connHighWater = 400
    p.gossipMeshLow = 6
    p.gossipMeshHigh = 12
    p.gossipMeshOutbound = 2
    p.gossipIHaveFanout = 8
    p.requireDidForRouting = true
    p.maxConnPerPeer = 32
    p.maxConnPerSubnet = 128
    p.maxStreamsPerPeer = 256
    p.maxStreamsPerProtocol = 2048
    return p

fn initGlobalScaleProfileL2Routing(): GlobalScaleProfile =
    var p: GlobalScaleProfile = initGlobalScaleProfile()
    p.enabled = true
    p.tier = ntL2Routing
    p.dhtMode = dhtServer
    p.relayServiceEnabled = false
    p.connLowWater = 128
    p.connHighWater = 256
    p.gossipMeshLow = 6
    p.gossipMeshHigh = 10
    p.gossipMeshOutbound = 2
    p.gossipIHaveFanout = 8
    p.requireDidForRouting = true
    p.maxConnPerPeer = 24
    p.maxConnPerSubnet = 96
    p.maxStreamsPerPeer = 192
    p.maxStreamsPerProtocol = 1536
    return p

fn initGlobalScaleProfileL3Edge(): GlobalScaleProfile =
    var p: GlobalScaleProfile = initGlobalScaleProfile()
    p.enabled = true
    p.tier = ntL3Edge
    p.dhtMode = dhtClient
    p.relayServiceEnabled = false
    p.connLowWater = 24
    p.connHighWater = 64
    p.gossipMeshLow = 2
    p.gossipMeshHigh = 4
    p.gossipMeshOutbound = 1
    p.gossipIHaveFanout = 2
    p.gossipRoutingEnabled = false
    p.requireDidForRouting = false
    p.dhtWriteEnabled = false
    p.dhtProvideEnabled = false
    p.maxConnPerPeer = 8
    p.maxConnPerSubnet = 24
    p.maxStreamsPerPeer = 32
    p.maxStreamsPerProtocol = 256
    return p

fn globalScaleAddressPriorityInto(list: var StringList) =
    let _ = StringListAdd(list, "/quic-v1/tls")
    let _ = StringListAdd(list, "/quic-v1")
    let _ = StringListAdd(list, "/webrtc-direct")
    let _ = StringListAdd(list, "/p2p-webrtc-star")
    let _ = StringListAdd(list, "/wss")
    let _ = StringListAdd(list, "/ws")
    let _ = StringListAdd(list, "/tcp")

fn globalScaleAddressPriority(): StringList =
    var list: StringList = InitStringList()
    globalScaleAddressPriorityInto(list)
    return list

fn nodeTierText(tier: NodeTier): str =
    if tier == ntL1Core:
        return "l1-core"
    if tier == ntL2Routing:
        return "l2-routing"
    return "l3-edge"

fn dhtModeText(mode: DhtMode): str =
    if mode == dhtClient:
        return "client"
    return "server"

fn autoRoleModeText(mode: AutoRoleMode): str =
    if mode == armPromoteOnPublic:
        return "promote-on-public"
    return "disabled"

fn setProfileTier(p: var GlobalScaleProfile, tier: NodeTier) =
    if tier == ntL1Core:
        p = initGlobalScaleProfileL1Core()
        return
    if tier == ntL3Edge:
        p = initGlobalScaleProfileL3Edge()
        return
    p = initGlobalScaleProfileL2Routing()

fn setProfileAutoRolePromotionEnabled(p: var GlobalScaleProfile, enabled: bool) =
    p.autoRoleMode = if enabled: armPromoteOnPublic else: armDisabled
