# PeerInfo(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/strings
import std/stringlist
import cheng/libp2p/utils/multiaddrlist
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import std/strings as stdstrings
import cheng/libp2p/crypto/crypto
type
    PeerInfo =
        id: PeerId
        addrs: MultiAddressList
        pubKey: Option[PublicKey]
        protocols: StringList

fn newPeerInfo(id: PeerId): PeerInfo =
    var info: PeerInfo
    info.id = id
    info.addrs = initMultiAddressList()
    info.protocols = InitStringList()
    return info

fn addAddress(info: var PeerInfo, addr: MultiAddress): Result[bool] =
    multiAddressListAdd(info.addrs, addr)

fn addAddresses(info: var PeerInfo, list: MultiAddressList): Result[bool] =
    for i in 0..<list.count:
        var addrCopy: MultiAddress = multiAddressFromTextUnchecked(stdstrings.CloneStr(list.items[i].raw))
        let addRes: Result[bool] = addAddress(info, addrCopy)
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    return Ok[bool](true)

fn setAddress(info: var PeerInfo, addr: MultiAddress) =
    addAddress(info, addr)

fn setPublicKey(info: var PeerInfo, key: PublicKey) =
    info.pubKey = Some[PublicKey](key)

fn setProtocols(info: var PeerInfo, list: StringList) =
    info.protocols = list

fn setProtocolsText(info: var PeerInfo, text: str): Result[bool] =
    let listRes: Result[StringList] = StringListFromLines(text)
    if IsErr(listRes):
        return Err[bool](Error(listRes))
    info.protocols = Value(listRes)
    return Ok[bool](true)

fn hasAddress(info: PeerInfo): bool =
    ! multiAddressListIsEmpty(info.addrs)

fn hasPublicKey(info: PeerInfo): bool =
    info.pubKey.has

fn hasProtocols(info: PeerInfo): bool =
    ! StringListIsEmpty(info.protocols)

fn addressesContain(info: PeerInfo, addr: MultiAddress): bool =
    multiAddressListContains(info.addrs, addr)

fn protocolsContain(info: PeerInfo, proto: str): bool =
    StringListContains(info.protocols, proto)

fn addressLines(info: PeerInfo): str =
    multiAddressListToLines(info.addrs)

fn protocolLines(info: PeerInfo): str =
    return ""

fn firstAddress(info: PeerInfo): Option[MultiAddress] =
    if info.addrs.count <= 0:
        return None[MultiAddress]()
    return Some[MultiAddress](info.addrs.items[0])

fn mergePeerInfo(info: var PeerInfo, other: PeerInfo): Result[bool] =
    let eqRes: Result[bool] = peerIdEqual(info.id, other.id)
    if IsErr(eqRes):
        return Err[bool](Error(eqRes))
    if ! Value(eqRes):
        return Err[bool]("peerinfo: id mismatch")
    for i in 0..<other.addrs.count:
        var addrCopy: MultiAddress = multiAddressFromTextUnchecked(stdstrings.CloneStr(other.addrs.items[i].raw))
        let addRes: Result[bool] = addAddress(info, addrCopy)
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    for i in 0..<other.protocols.count:
        let addProtoRes: Result[bool] = StringListAdd(info.protocols, stdstrings.CloneStr(other.protocols.items[i]))
        if IsErr(addProtoRes):
            return Err[bool](Error(addProtoRes))
    if ! info.pubKey.has && other.pubKey.has:
        info.pubKey = other.pubKey
    return Ok[bool](true)
