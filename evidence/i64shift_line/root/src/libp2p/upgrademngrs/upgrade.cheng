# Upgrade manager(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
import cheng/libp2p/protocols/secure/secure
import cheng/libp2p/peerid
import cheng/libp2p/multistream
type
    Upgrade =
        secureMgr: Secure
        hasSecure: bool
        muxerKind: int32

fn initUpgrade(): Upgrade =
    var up: Upgrade
    up.secureMgr = initSecure("")
    up.hasSecure = false
    up.muxerKind = muxerKindMplex
    return up

fn initUpgradeInto(up: var Upgrade) =
    up.hasSecure = false
    up.muxerKind = muxerKindMplex

fn setSecure(up: var Upgrade, secure: Secure) =
    up.secureMgr = secure
    up.hasSecure = true

fn setSecureCodec(up: var Upgrade, codec: str) =
    up.secureMgr.codec = codec
    up.hasSecure = true

fn setMuxerKind(up: var Upgrade, kind: int32): Result[bool] =
    if kind != muxerKindMplex && kind != muxerKindYamux && kind != muxerKindAuto:
        return Err[bool]("upgrade: unknown muxer kind")
    up.muxerKind = kind
    return Ok[bool](true)

fn initMuxerSelect(kind: int32): MultistreamSelect =
    var ms: MultistreamSelect = newMultistreamSelect()
    if kind == muxerKindAuto:
        addProtocol(ms, yamuxCodec)
        addProtocol(ms, mplexCodec)
        return ms
    if kind == muxerKindYamux:
        addProtocol(ms, yamuxCodec)
        return ms
    addProtocol(ms, mplexCodec)
    return ms

fn negotiateMuxerKind(up: Upgrade, conn: var Connection): Result[int32] =
    if up.muxerKind == muxerKindAuto:
        let ms: MultistreamSelect = initMuxerSelect(muxerKindAuto)
        if ConnectionDirection(conn) == Outbound:
            let selRes: Result[str] = dialerSelectProtocolWithListPreferLocalConn(ms, conn)
            if IsErr(selRes):
                return Err[int32](Error(selRes))
            return muxerKindFromProtocol(Value(selRes))
        let selRes: Result[str] = responderSelectProtocolConn(ms, conn)
        if IsErr(selRes):
            return Err[int32](Error(selRes))
        return muxerKindFromProtocol(Value(selRes))
    let protoRes: Result[str] = muxerProtocol(up.muxerKind)
    if IsErr(protoRes):
        return Err[int32](Error(protoRes))
    let proto: str = Value(protoRes)
    if ConnectionDirection(conn) == Outbound:
        let selRes: Result[bool] = dialerSelectProtocolConn(conn, proto)
        if IsErr(selRes):
            return Err[int32](Error(selRes))
        return Ok[int32](up.muxerKind)
    var ms: MultistreamSelect = newMultistreamSelect()
    addProtocol(ms, proto)
    let selRes: Result[str] = responderSelectProtocolConn(ms, conn)
    if IsErr(selRes):
        return Err[int32](Error(selRes))
    return Ok[int32](up.muxerKind)

fn upgrade(up: Upgrade, conn: Connection, peer: Option[PeerId]): Result[Muxer] =
    if ! up.hasSecure:
        return Err[Muxer]("upgrade: no secure manager")
    let secRes: Result[Connection] = secure(up.secureMgr, conn, peer)
    if IsErr(secRes):
        return Err[Muxer](Error(secRes))
    var secConn: Connection = Value(secRes)
    let kindRes: Result[int32] = negotiateMuxerKind(up, secConn)
    if IsErr(kindRes):
        return Err[Muxer](Error(kindRes))
    return newMuxerWithKind(secConn, Value(kindRes))
