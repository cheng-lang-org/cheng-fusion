# Muxed upgrade helper(minimal wrapper).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
import cheng/libp2p/protocols/secure/secure
import cheng/libp2p/peerid
import cheng/libp2p/upgrademngrs/upgrade
type
    MuxedUpgrade =
        up: Upgrade

fn initMuxedUpgrade(): MuxedUpgrade =
    MuxedUpgrade(up: initUpgrade())

fn setSecure(up: var MuxedUpgrade, secure: Secure) =
    setSecure(up.up, secure)

fn setMuxerKind(up: var MuxedUpgrade, kind: int32): Result[bool] =
    return setMuxerKind(up.up, kind)

fn upgrade(up: MuxedUpgrade, conn: Connection, peer: Option[PeerId]): Result[Muxer] =
    return upgrade(up.up, conn, peer)
