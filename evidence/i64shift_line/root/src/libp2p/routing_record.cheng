# Routing records(partial: peer record).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/signed_envelope
const
    maxPeerRecordAddrs = 16

type
    AddressInfo =
        address: MultiAddress

    PeerRecord =
        peerId: PeerId
        seqNo: int64
        addresses: AddressInfo[maxPeerRecordAddrs]
        addressCount: int32

fn newPeerRecord(peerId: PeerId, seqNo: int64): PeerRecord =
    PeerRecord(peerId: peerId, seqNo: seqNo, addressCount: 0)

fn peerRecordAddAddress(rec: var PeerRecord, addr: MultiAddress): bool =
    if rec.addressCount >= maxPeerRecordAddrs:
        return false
    rec.addresses[rec.addressCount] = AddressInfo(address: addr)
    rec.addressCount = rec.addressCount + 1
    return true

fn encodePeerRecord(rec: PeerRecord): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    write(pb, 1, rec.peerId)
    writeVarint(pb, 2, rec.seqNo)
    for i in 0..<rec.addressCount:
        var addrPb: ProtoBuffer = InitProtoBuffer()
        writeBytes(addrPb, 1, rec.addresses[i].address.data)
        writeBytes(pb, 3, protoToBytes(addrPb))
    return Ok[Bytes](protoToBytes(pb))

fn decodePeerRecord(data: Bytes): Result[PeerRecord] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var rec: PeerRecord = PeerRecord(addressCount: 0)
    var pid: PeerId
    let pidRes: Result[bool] = getField(pb, 1, pid)
    if IsErr(pidRes):
        return Err[PeerRecord](Error(pidRes))
    if ! Value(pidRes):
        return Err[PeerRecord]("routing_record: missing peer id")
    rec.peerId = pid
    var seqNo: int64
    let seqRes: Result[bool] = getField(pb, 2, seqNo)
    if IsErr(seqRes):
        return Err[PeerRecord](Error(seqRes))
    if ! Value(seqRes):
        return Err[PeerRecord]("routing_record: missing seq no")
    rec.seqNo = seqNo
    var addrList: RepeatedBytes = initRepeatedBytes()
    let addrsRes: Result[bool] = getRepeatedField(pb, 3, addrList)
    if IsErr(addrsRes):
        return Err[PeerRecord](Error(addrsRes))
    if Value(addrsRes):
        for i in 0..<addrList.count:
            var sub: ProtoBuffer = InitProtoBufferFromBytes(addrList.items[i], 0)
            var addrBytes: Bytes = EmptyBytes()
            let addrRes: Result[bool] = getField(sub, 1, addrBytes)
            if IsErr(addrRes):
                return Err[PeerRecord](Error(addrRes))
            if Value(addrRes):
                let parseRes: Result[MultiAddress] = parseMultiAddressBytes(addrBytes)
                if IsErr(parseRes):
                    return Err[PeerRecord](Error(parseRes))
                if rec.addressCount >= maxPeerRecordAddrs:
                    return Err[PeerRecord]("routing_record: too many addresses")
                rec.addresses[rec.addressCount] = AddressInfo(address: Value(parseRes))
                rec.addressCount = rec.addressCount + 1
        if rec.addressCount == 0:
            return Err[PeerRecord]("routing_record: address missing")
    return Ok[PeerRecord](rec)

fn peerRecordPayloadDomain(): str =
    "libp2p-peer-record"

fn peerRecordPayloadType(): Bytes =
    let out: Bytes = BytesAlloc(2)
    BytesSet(out, 0, 3)
    BytesSet(out, 1, 1)
    return out

fn peerRecordMatchesEnvelope(rec: PeerRecord, env: Envelope): bool =
    return peerIdMatchesPublicKey(rec.peerId, env.publicKey)

type
    SignedPeerRecord =
        envelope: Envelope
        data: PeerRecord

fn initSignedPeerRecord(priv: PrivateKey, rec: PeerRecord): Result[SignedPeerRecord] =
    let payloadRes: Result[Bytes] = encodePeerRecord(rec)
    if IsErr(payloadRes):
        return Err[SignedPeerRecord](Error(payloadRes))
    let envRes: Result[Envelope] = InitEnvelope(
        priv,
        peerRecordPayloadType(),
        Value(payloadRes),
        peerRecordPayloadDomain()
    )
    if IsErr(envRes):
        return Err[SignedPeerRecord](Error(envRes))
    return Ok[SignedPeerRecord](SignedPeerRecord(envelope: Value(envRes), data: rec))

fn encodeSignedPeerRecord(rec: SignedPeerRecord): Result[Bytes] =
    return EncodeEnvelope(rec.envelope)

fn decodeSignedPeerRecord(data: Bytes): Result[SignedPeerRecord] =
    let envRes: Result[Envelope] = DecodeEnvelope(data, peerRecordPayloadDomain())
    if IsErr(envRes):
        return Err[SignedPeerRecord](Error(envRes))
    let env: Envelope = Value(envRes)
    if ! BytesEqual(env.payloadType, peerRecordPayloadType()):
        return Err[SignedPeerRecord]("routing_record: wrong payload type")
    let recRes: Result[PeerRecord] = decodePeerRecord(env.payload)
    if IsErr(recRes):
        return Err[SignedPeerRecord](Error(recRes))
    let out: SignedPeerRecord = SignedPeerRecord(envelope: env, data: Value(recRes))
    if ! peerRecordMatchesEnvelope(out.data, out.envelope):
        return Err[SignedPeerRecord]("routing_record: signature mismatch")
    return Ok[SignedPeerRecord](out)
