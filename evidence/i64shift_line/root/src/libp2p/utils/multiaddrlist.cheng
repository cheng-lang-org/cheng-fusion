# MultiAddress list helpers (seq, capped).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
const
    maxMultiAddrs = 16

type
    MultiAddressList =
        count: int32
        items: MultiAddress[]

fn initMultiAddressList(): MultiAddressList =
    var out: MultiAddressList
    out.count = 0
    return out

fn multiAddressListCount(list: MultiAddressList): int32 =
    list.count

@borrows
fn multiAddressListIsEmpty(list: MultiAddressList): bool =
    list.count <= 0

@borrows
fn multiAddressListContains(list: MultiAddressList, addr: MultiAddress): bool =
    for i in 0..<list.count:
        if BytesEqual(list.items[i].data, addr.data):
            return true
    return false

fn multiAddressListAdd(list: var MultiAddressList, addr: MultiAddress): Result[bool] =
    if multiAddressListContains(list, addr):
        return Ok[bool](true)
    if list.count >= maxMultiAddrs:
        return Err[bool]("multiaddrlist: full")
    add(list.items, addr)
    list.count = list.items.len
    return Ok[bool](true)

fn multiAddressListFromDelimited(text: str, delim: char): Result[MultiAddressList] =
    var list: MultiAddressList = initMultiAddressList()
    if len(text) <= 0:
        return Ok[MultiAddressList](list)
    var start: int32
    let total: int32 = len(text)
    for i in 0..total:
        if i == total || text[i] == delim:
            let segLen: int32 = i - start
            if segLen > 0:
                let item: str = SliceBytes(text, start, segLen)
                let addrRes: Result[MultiAddress] = parseMultiAddress(item)
                if IsErr(addrRes):
                    return Err[MultiAddressList](Error(addrRes))
                let addRes: Result[bool] = multiAddressListAdd(list, Value(addrRes))
                if IsErr(addRes):
                    return Err[MultiAddressList](Error(addRes))
            start = i + 1
    return Ok[MultiAddressList](list)

fn multiAddressListFromLines(text: str): Result[MultiAddressList] =
    multiAddressListFromDelimited(text, '\n')

@borrows
fn multiAddressListToDelimited(list: MultiAddressList, delim: char): str =
    if list.count <= 0:
        return ""
    var out: str
    let d: str = charToStr(delim)
    for i in 0..<list.count:
        let text: str = strings.CloneStr(list.items[i].raw)
        if len(out) == 0:
            out = text
        else:
            out = out + d
            out = out + text
    return out

fn multiAddressListToLines(list: MultiAddressList): str =
    multiAddressListToDelimited(list, '\n')
