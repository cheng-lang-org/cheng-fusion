# Semaphore helper(synchronous, counting).

import cheng/libp2p/utils/result
const
    maxInt32Value = 2147483647

type
    Semaphore =
        capacity: int32
        used: int32

fn initSemaphore(capacity: int32): Result[Semaphore] =
    if capacity < 0:
        return Err[Semaphore]("semaphore: negative capacity")
    return Ok[Semaphore](Semaphore(capacity: capacity, used: 0))

fn semaphoreCapacity(s: Semaphore): int32 =
    s.capacity

fn semaphoreUsed(s: Semaphore): int32 =
    s.used

fn semaphoreAvailable(s: Semaphore): int32 =
    if s.capacity <= 0:
        return maxInt32Value
    return s.capacity - s.used

fn tryAcquire(s: var Semaphore): Result[bool] =
    if s.capacity <= 0:
        return Ok[bool](true)
    if s.used >= s.capacity:
        return Err[bool]("semaphore: exhausted")
    s.used = s.used + 1
    return Ok[bool](true)

fn release(s: var Semaphore): Result[bool] =
    if s.capacity <= 0:
        return Ok[bool](true)
    if s.used <= 0:
        return Err[bool]("semaphore: underflow")
    s.used = s.used - 1
    return Ok[bool](true)

fn resetSemaphore(s: var Semaphore) =
    s.used = 0
