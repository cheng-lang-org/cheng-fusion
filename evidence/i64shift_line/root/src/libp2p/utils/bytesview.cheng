# Bytes view helpers(zero-copy window over Bytes).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
type
    BytesView =
        data: Bytes
        rpos: int32

fn initBytesView(data: Bytes): BytesView =
    BytesView(data: data, rpos: 0)

fn bytesViewLen(v: BytesView): int32 =
    let remaining: int32 = BytesLen(v.data) - v.rpos
    if remaining < 0:
        return 0
    return remaining

fn bytesViewConsume(v: var BytesView, n: int32): Result[bool] =
    if n < 0:
        return Err[bool]("bytesview: negative consume")
    if bytesViewLen(v) < n:
        return Err[bool]("bytesview: consume beyond length")
    v.rpos = v.rpos + n
    return Ok[bool](true)

fn bytesViewSlice(v: BytesView, start: int32, count: int32): Bytes =
    if start < 0:
        return EmptyBytes()
    let base: int32 = v.rpos + start
    return BytesSliceView(v.data, base, count)

fn bytesViewData(v: BytesView): Bytes =
    return BytesSliceView(v.data, v.rpos, bytesViewLen(v))

