# Heartbeat helper(interval-based, synchronous).

import cheng/libp2p/utils/result
import std/times
type
    Heartbeat =
        intervalMs: int64
        lastTickMs: int64

fn epochTimeMs(): int64 =
    EpochTimeNs() / 1000000

fn initHeartbeat(intervalMs: int64): Result[Heartbeat] =
    if intervalMs <= 0:
        return Err[Heartbeat]("heartbeat: interval must be positive")
    return Ok[Heartbeat](Heartbeat(intervalMs: intervalMs, lastTickMs: 0))

fn heartbeatIntervalMs(h: Heartbeat): int64 =
    h.intervalMs

fn heartbeatLastTickMs(h: Heartbeat): int64 =
    h.lastTickMs

fn heartbeatReady(h: Heartbeat): bool =
    if h.intervalMs <= 0:
        return false
    let now: int64 = epochTimeMs()
    return (now - h.lastTickMs) >= h.intervalMs

fn heartbeatTick(h: var Heartbeat): bool =
    if h.intervalMs <= 0:
        return false
    let now: int64 = epochTimeMs()
    if (now - h.lastTickMs) < h.intervalMs:
        return false
    h.lastTickMs = now
    return true

fn resetHeartbeat(h: var Heartbeat) =
    h.lastTickMs = 0

fn forceHeartbeat(h: var Heartbeat) =
    h.lastTickMs = epochTimeMs()
