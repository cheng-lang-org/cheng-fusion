# Minimal Future type (synchronous).

import cheng/libp2p/utils/result
type
    Future[T] =
        done: bool
        ok: bool
        value: T
        err: str

fn initFuture[T](): Future[T] =
    Future[T](done: false, ok: false, err: "")

fn futureDone[T](f: Future[T]): bool =
    f.done

fn futureOk[T](f: Future[T]): bool =
    f.done && f.ok

fn futureErr[T](f: Future[T]): bool =
    f.done && ! f.ok

fn futureError[T](f: Future[T]): str =
    f.err

fn completeFuture[T](f: var Future[T], value: T): Result[bool] =
    if f.done:
        return Err[bool]("future: already completed")
    f.done = true
    f.ok = true
    f.value = value
    f.err = ""
    return Ok[bool](true)

fn failFuture[T](f: var Future[T], msg: str): Result[bool] =
    if f.done:
        return Err[bool]("future: already completed")
    f.done = true
    f.ok = false
    f.err = msg
    return Ok[bool](true)

fn awaitFuture[T](f: Future[T]): Result[T] =
    if ! f.done:
        return Err[T]("future: ! completed")
    if ! f.ok:
        return Err[T](f.err)
    return Ok[T](f.value)

fn resetFuture[T](f: var Future[T]) =
    f.done = false
    f.ok = false
    f.err = ""
