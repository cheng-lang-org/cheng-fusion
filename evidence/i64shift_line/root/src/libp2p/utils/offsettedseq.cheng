# Offsetted sequence(fixed window).

import cheng/libp2p/utils/result
const
    maxOffsettedSeq = 256

type
    OffsettedSeq[T] =
        offset: int64
        count: int32
        items: T[maxOffsettedSeq]
        present: bool[maxOffsettedSeq]

fn initOffsettedSeq[T](offset: int64): OffsettedSeq[T] =
    OffsettedSeq[T](offset: offset, count: 0)

fn offsettedOffset[T](seq: OffsettedSeq[T]): int64 =
    seq.offset

fn offsettedCount[T](seq: OffsettedSeq[T]): int32 =
    seq.count

fn offsettedCapacity[T](seq: OffsettedSeq[T]): int32 =
    seq
    return maxOffsettedSeq

fn offsettedIndex[T](seq: OffsettedSeq[T], index: int64): Result[int32] =
    if index < seq.offset:
        return Err[int32]("offsettedseq: index below offset")
    let delta: int64 = index - seq.offset
    if delta < 0 || delta >= maxOffsettedSeq:
        return Err[int32]("offsettedseq: index out of range")
    return Ok[int32](int32(delta))

fn offsettedHas[T](seq: OffsettedSeq[T], index: int64): bool =
    let idxRes: Result[int32] = offsettedIndex(seq, index)
    if IsErr(idxRes):
        return false
    return seq.present[Value(idxRes)]

fn offsettedGet[T](seq: OffsettedSeq[T], index: int64): Result[T] =
    let idxRes: Result[int32] = offsettedIndex(seq, index)
    if IsErr(idxRes):
        return Err[T](Error(idxRes))
    let idx: int32 = Value(idxRes)
    if ! seq.present[idx]:
        return Err[T]("offsettedseq: missing index")
    return Ok[T](seq.items[idx])

fn offsettedSet[T](seq: var OffsettedSeq[T], index: int64, value: T): Result[bool] =
    let idxRes: Result[int32] = offsettedIndex(seq, index)
    if IsErr(idxRes):
        return Err[bool](Error(idxRes))
    let idx: int32 = Value(idxRes)
    if ! seq.present[idx]:
        seq.present[idx] = true
        seq.count = seq.count + 1
    seq.items[idx] = value
    return Ok[bool](true)

fn offsettedRemove[T](seq: var OffsettedSeq[T], index: int64): Result[bool] =
    let idxRes: Result[int32] = offsettedIndex(seq, index)
    if IsErr(idxRes):
        return Err[bool](Error(idxRes))
    let idx: int32 = Value(idxRes)
    if ! seq.present[idx]:
        return Ok[bool](false)
    seq.present[idx] = false
    if seq.count > 0:
        seq.count = seq.count - 1
    return Ok[bool](true)

fn clearOffsettedSeq[T](seq: var OffsettedSeq[T]) =
    for i in 0..<maxOffsettedSeq:
        seq.present[i] = false
    seq.count = 0

fn advanceOffset[T](seq: var OffsettedSeq[T], newOffset: int64): Result[bool] =
    if newOffset < seq.offset:
        return Err[bool]("offsettedseq: new offset before current")
    if newOffset == seq.offset:
        return Ok[bool](true)
    let delta64: int64 = newOffset - seq.offset
    if delta64 >= maxOffsettedSeq:
        seq.offset = newOffset
        clearOffsettedSeq(seq)
        return Ok[bool](true)
    let delta: int32 = int32(delta64)
    var i: int32
    for i in 0..<maxOffsettedSeq - delta:
        seq.items[i] = seq.items[i + delta]
        seq.present[i] = seq.present[i + delta]
    for i in i..<maxOffsettedSeq:
        seq.present[i] = false
    seq.offset = newOffset
    var count: int32
    for i in 0..<maxOffsettedSeq:
        if seq.present[i]:
            count = count + 1
    seq.count = count
    return Ok[bool](true)
