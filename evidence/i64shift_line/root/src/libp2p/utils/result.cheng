# Minimal Result type for cheng-libp2p (compatible with stdlib result).
#
# NOTE: This module is now a thin shim to std/result. We keep a few historical
# `Lp2p*` helper names to avoid a mass refactor in cheng-libp2p.

import std/result

fn Lp2pErrorOk(): ErrorInfo =
    var out: ErrorInfo
    ErrorOkInto(out)
    return out

fn Lp2pErrorNew(msg: str): ErrorInfo =
    var out: ErrorInfo
    ErrorNewInto(out, msg)
    return out

fn Lp2pErrorCode(code: int32, msg: str): ErrorInfo =
    var out: ErrorInfo
    out.code = code
    out.msg = msg
    return out

fn Lp2pIsError(e: ErrorInfo): bool =
    return IsError(e)

fn Lp2pErrorCodeOf(e: ErrorInfo): int32 =
    return ErrorCodeOf(e)

fn Lp2pErrorMessage(e: ErrorInfo): str =
    return ErrorMessage(e)

fn Lp2pErrorFormat(e: ErrorInfo): str =
    return ErrorFormat(e)

