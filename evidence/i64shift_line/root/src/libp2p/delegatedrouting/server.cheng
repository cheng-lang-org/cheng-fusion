# Delegated routing server(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/stream/lpstream
import cheng/libp2p/protocols/protocol
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/delegatedrouting/store
const
    delegatedRoutingCodec = "/libp2p/delegated-routing/1.0.0"
    delegatedRoutingDefaultMaxMessage = 1048576

    delegatedReqKeyField = 1
    delegatedRespOkField = 1
    delegatedRespValueField = 2
    delegatedRespMessageField = 3

type
    DelegatedRoutingRequest =
        key: str

    DelegatedRoutingResponse =
        ok: bool
        value: str
        message: str

    DelegatedRoutingConfig =
        maxMessageBytes: int32
        closeAfterResponse: bool

    DelegatedRoutingContext =
        config: DelegatedRoutingConfig
        hasStore: bool
        store: DelegatedStore

var
    delegatedRoutingContext: DelegatedRoutingContext = DelegatedRoutingContext(
        config: DelegatedRoutingConfig(maxMessageBytes: delegatedRoutingDefaultMaxMessage, closeAfterResponse: true),
        hasStore: false,
        store: initDelegatedStore()
    )

fn initDelegatedRoutingConfig(): DelegatedRoutingConfig =
    DelegatedRoutingConfig(maxMessageBytes: delegatedRoutingDefaultMaxMessage, closeAfterResponse: true)

fn setDelegatedRoutingConfig(config: DelegatedRoutingConfig) =
    delegatedRoutingContext.config = config

fn setDelegatedRoutingStore(store: DelegatedStore) =
    delegatedRoutingContext.store = store
    delegatedRoutingContext.hasStore = true

fn initDelegatedRoutingRequest(): DelegatedRoutingRequest =
    DelegatedRoutingRequest(key: "")

fn initDelegatedRoutingResponse(): DelegatedRoutingResponse =
    DelegatedRoutingResponse(ok: false, value: "", message: "")

fn encodeDelegatedRoutingRequest(req: DelegatedRoutingRequest): Result[Bytes] =
    if len(req.key) <= 0:
        return Err[Bytes]("delegated-routing: empty key")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, delegatedReqKeyField, req.key)
    return Ok[Bytes](protoToBytes(pb))

fn decodeDelegatedRoutingRequest(data: Bytes): Result[DelegatedRoutingRequest] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var req: DelegatedRoutingRequest = initDelegatedRoutingRequest()
    var key: str
    let keyRes: Result[bool] = getField(pb, delegatedReqKeyField, key)
    if IsErr(keyRes):
        return Err[DelegatedRoutingRequest](Error(keyRes))
    if Value(keyRes):
        req.key = key
    if len(req.key) <= 0:
        return Err[DelegatedRoutingRequest]("delegated-routing: empty key")
    return Ok[DelegatedRoutingRequest](req)

fn encodeDelegatedRoutingResponse(resp: DelegatedRoutingResponse): Result[Bytes] =
    var pb: ProtoBuffer = InitProtoBuffer()
    if resp.ok:
        writeVarint(pb, delegatedRespOkField, 1)
    if len(resp.value) > 0:
        writeString(pb, delegatedRespValueField, resp.value)
    if len(resp.message) > 0:
        writeString(pb, delegatedRespMessageField, resp.message)
    return Ok[Bytes](protoToBytes(pb))

fn decodeDelegatedRoutingResponse(data: Bytes): Result[DelegatedRoutingResponse] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var resp: DelegatedRoutingResponse = initDelegatedRoutingResponse()
    var okVal: int64
    let okRes: Result[bool] = getField(pb, delegatedRespOkField, okVal)
    if IsErr(okRes):
        return Err[DelegatedRoutingResponse](Error(okRes))
    if Value(okRes):
        resp.ok = okVal != 0
    var value: str
    let valueRes: Result[bool] = getField(pb, delegatedRespValueField, value)
    if IsErr(valueRes):
        return Err[DelegatedRoutingResponse](Error(valueRes))
    if Value(valueRes):
        resp.value = value
    var message: str
    let msgRes: Result[bool] = getField(pb, delegatedRespMessageField, message)
    if IsErr(msgRes):
        return Err[DelegatedRoutingResponse](Error(msgRes))
    if Value(msgRes):
        resp.message = message
    return Ok[DelegatedRoutingResponse](resp)

fn delegatedRoutingHandle(req: DelegatedRoutingRequest): DelegatedRoutingResponse =
    var resp: DelegatedRoutingResponse = initDelegatedRoutingResponse()
    if ! delegatedRoutingContext.hasStore:
        resp.ok = false
        resp.message = "delegated-routing: missing store"
        return resp
    let valueRes: Result[str] = delegatedStoreGet(delegatedRoutingContext.store, req.key)
    if IsErr(valueRes):
        resp.ok = false
        resp.message = "! found"
        return resp
    resp.ok = true
    resp.value = Value(valueRes)
    return resp

fn readDelegatedRoutingRequest(stream: var Stream): Result[DelegatedRoutingRequest] =
    let dataRes: Result[Bytes] = readLp(stream, delegatedRoutingContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[DelegatedRoutingRequest](Error(dataRes))
    return decodeDelegatedRoutingRequest(Value(dataRes))

fn writeDelegatedRoutingRequest(stream: var Stream, req: DelegatedRoutingRequest): Result[bool] =
    let encRes: Result[Bytes] = encodeDelegatedRoutingRequest(req)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn readDelegatedRoutingResponse(stream: var Stream): Result[DelegatedRoutingResponse] =
    let dataRes: Result[Bytes] = readLp(stream, delegatedRoutingContext.config.maxMessageBytes)
    if IsErr(dataRes):
        return Err[DelegatedRoutingResponse](Error(dataRes))
    return decodeDelegatedRoutingResponse(Value(dataRes))

fn writeDelegatedRoutingResponse(stream: var Stream, resp: DelegatedRoutingResponse): Result[bool] =
    let encRes: Result[Bytes] = encodeDelegatedRoutingResponse(resp)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    let writeRes: Result[int32] = writeLp(stream, Value(encRes))
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn delegatedRoutingHandler(stream: Stream): Result[bool] =
    var streamVar: Stream = stream
    let reqRes: Result[DelegatedRoutingRequest] = readDelegatedRoutingRequest(streamVar)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: DelegatedRoutingRequest = Value(reqRes)
    let resp: DelegatedRoutingResponse = delegatedRoutingHandle(req)
    let writeRes: Result[bool] = writeDelegatedRoutingResponse(streamVar, resp)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    if delegatedRoutingContext.config.closeAfterResponse:
        closeStream(streamVar)
    return Ok[bool](true)

fn delegatedRoutingProtocol(): Lp2pProtocol =
    return newProtocol(delegatedRoutingCodec, delegatedRoutingHandler)
