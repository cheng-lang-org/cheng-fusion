# Delegated routing store(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
const
    maxDelegatedRecords = 64

type
    DelegatedRecord =
        key: str
        value: str

    DelegatedStore =
        count: int32
        items: DelegatedRecord[maxDelegatedRecords]

fn initDelegatedStore(): DelegatedStore =
    DelegatedStore(count: 0)

fn delegatedStoreIndex(store: DelegatedStore, key: str): int32 =
    if len(key) <= 0:
        return -1
    for i in 0..<store.count:
        if (store.items[i].key == key):
            return i
    return -1

fn delegatedStoreHas(store: DelegatedStore, key: str): bool =
    return delegatedStoreIndex(store, key) >= 0

fn delegatedStorePut(store: var DelegatedStore, key: str, value: str): Result[bool] =
    if len(key) <= 0:
        return Err[bool]("delegated-store: empty key")
    let idx: int32 = delegatedStoreIndex(store, key)
    if idx >= 0:
        store.items[idx].value = value
        return Ok[bool](true)
    if store.count >= maxDelegatedRecords:
        return Err[bool]("delegated-store: full")
    store.items[store.count] = DelegatedRecord(key: key, value: value)
    store.count = store.count + 1
    return Ok[bool](true)

fn delegatedStoreGet(store: DelegatedStore, key: str): Result[str] =
    let idx: int32 = delegatedStoreIndex(store, key)
    if idx < 0:
        return Err[str]("delegated-store: ! found")
    return Ok[str](store.items[idx].value)

fn delegatedStoreRemove(store: var DelegatedStore, key: str): bool =
    let idx: int32 = delegatedStoreIndex(store, key)
    if idx < 0:
        return false
    for i in idx..<((store.count) - 1):
        if ! (i + 1 < store.count):
            break
        store.items[i] = store.items[i + 1]
    store.count = store.count - 1
    return true

fn delegatedStoreCount(store: DelegatedStore): int32 =
    return store.count

fn delegatedStoreDump(store: DelegatedStore): str =
    if store.count <= 0:
        return ""
    var out: str
    for i in 0..<store.count:
        var line: str = store.items[i].key + "="
        line = line + store.items[i].value
        if len(out) == 0:
            out = line
        else:
            out = out + "\n"
            out = out + line
    return out
