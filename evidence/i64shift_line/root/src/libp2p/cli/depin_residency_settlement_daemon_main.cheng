import std/cmdline
import std/os
import std/result
import std/strings
import std/strutils as strutil
import std/times
import cheng/libp2p/protocols/depin/inference_settlement
import cheng/libp2p/protocols/depin/inference_transport as transport

fn depinDaemonPrintOut(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn depinDaemonPrintErr(text: str) =
    os.WriteLine(os.Get_stderr(), text)

fn depinDaemonUsage(): str =
    return "usage: depin_residency_settlement_daemon depin-residency-settlement-daemon --daemon-id <id> --event-stream-id <id> --residency-prefix <prefix> --supervisor-state <path> --daemon-run-receipt <path> --daemon-file-events <path> --daemon-startup-bundle <path> --config-hash <hash> --interval-ns <ns> --lease-ns <ns> --max-events <n> [--checked-at-ns <ns>] [--process-pid <pid>] [--build-events] [--run-once] [--run-until-idle] [--max-cycles <n>] [--register-service --service-kind <launchd|systemd> --service-name <name> --executable-path <path> --working-directory <path>] [--unregister-service --registered-service-receipt <path>] [--heartbeat]"

fn depinDaemonReadRequiredFlag(flag: str, outValue: var str): Result[bool] =
    outValue = ""
    let raw = cmdline.ReadFlagOrDefault(flag, "")
    if raw == "":
        return Err[bool](strutil.Join(["depin daemon: missing ", flag], ""))
    outValue = strutil.Strip(raw)
    if outValue == "":
        return Err[bool](strutil.Join(["depin daemon: empty ", flag], ""))
    return Ok[bool](true)

fn depinDaemonParseInt64Text(raw: str): Result[int64] =
    let text = strutil.Strip(raw)
    if text == "":
        return Err[int64](strutil.Join(["depin daemon: invalid int64: ", raw], ""))
    var sign: int64 = int64(1)
    var i: int32
    if text[0] == '+':
        i = 1
    elif text[0] == '-':
        sign = int64(-1)
        i = 1
    if i >= strings.Len(text):
        return Err[int64](strutil.Join(["depin daemon: invalid int64: ", raw], ""))
    var value: int64
    for i in i..<strings.Len(text):
        let ch = text[i]
        if ch < '0' || ch > '9':
            return Err[int64](strutil.Join(["depin daemon: invalid int64: ", raw], ""))
        let digit = int64(int32(ch) - int32('0'))
        value = value * int64(10) + digit
    return Ok[int64](value * sign)

fn depinDaemonReadRequiredInt64Flag(flag: str, outValue: var int64): Result[bool] =
    var raw: str
    let readRes = depinDaemonReadRequiredFlag(flag, raw)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    let parsed = depinDaemonParseInt64Text(raw)
    if IsErr(parsed):
        return Err[bool](strutil.Join(["depin daemon: invalid ", flag, ": ", raw], ""))
    outValue = Value(parsed)
    return Ok[bool](true)

fn depinDaemonReadOptionalInt64Flag(flag: str, defaultValue: int64, outValue: var int64): Result[bool] =
    let raw = cmdline.ReadFlagOrDefault(flag, "")
    if raw == "":
        outValue = defaultValue
        return Ok[bool](true)
    let parsed = depinDaemonParseInt64Text(raw)
    if IsErr(parsed):
        return Err[bool](strutil.Join(["depin daemon: invalid ", flag, ": ", raw], ""))
    outValue = Value(parsed)
    return Ok[bool](true)

fn depinDaemonRunHealthProbe(): int32 =
    var daemonId: str
    var eventStreamId: str
    var residencyPrefix: str
    var supervisorStatePath: str
    var daemonRunReceiptPath: str
    var daemonFileEventsPath: str
    var startupBundlePath: str
    var configHash: int64
    var intervalNs: int64
    var leaseNs: int64
    var maxEventsRaw: int64
    let readDaemonId = depinDaemonReadRequiredFlag("--daemon-id", daemonId)
    if IsErr(readDaemonId):
        depinDaemonPrintErr(Error(readDaemonId))
        return 2
    let readEventStream = depinDaemonReadRequiredFlag("--event-stream-id", eventStreamId)
    if IsErr(readEventStream):
        depinDaemonPrintErr(Error(readEventStream))
        return 2
    let readPrefix = depinDaemonReadRequiredFlag("--residency-prefix", residencyPrefix)
    if IsErr(readPrefix):
        depinDaemonPrintErr(Error(readPrefix))
        return 2
    let readSupervisor = depinDaemonReadRequiredFlag("--supervisor-state", supervisorStatePath)
    if IsErr(readSupervisor):
        depinDaemonPrintErr(Error(readSupervisor))
        return 2
    let readRun = depinDaemonReadRequiredFlag("--daemon-run-receipt", daemonRunReceiptPath)
    if IsErr(readRun):
        depinDaemonPrintErr(Error(readRun))
        return 2
    let readFileEvents = depinDaemonReadRequiredFlag("--daemon-file-events", daemonFileEventsPath)
    if IsErr(readFileEvents):
        depinDaemonPrintErr(Error(readFileEvents))
        return 2
    let readStartup = depinDaemonReadRequiredFlag("--daemon-startup-bundle", startupBundlePath)
    if IsErr(readStartup):
        depinDaemonPrintErr(Error(readStartup))
        return 2
    let readConfigHash = depinDaemonReadRequiredInt64Flag("--config-hash", configHash)
    if IsErr(readConfigHash):
        depinDaemonPrintErr(Error(readConfigHash))
        return 2
    let readInterval = depinDaemonReadRequiredInt64Flag("--interval-ns", intervalNs)
    if IsErr(readInterval):
        depinDaemonPrintErr(Error(readInterval))
        return 2
    let readLease = depinDaemonReadRequiredInt64Flag("--lease-ns", leaseNs)
    if IsErr(readLease):
        depinDaemonPrintErr(Error(readLease))
        return 2
    let readMaxEvents = depinDaemonReadRequiredInt64Flag("--max-events", maxEventsRaw)
    if IsErr(readMaxEvents):
        depinDaemonPrintErr(Error(readMaxEvents))
        return 2
    if maxEventsRaw <= int64(0) || maxEventsRaw > int64(2147483647):
        depinDaemonPrintErr("depin daemon: invalid --max-events")
        return 2
    let config = transport.DepinInferenceTransportBuildResidencySettlementDaemonConfig(
        daemonId,
        eventStreamId,
        residencyPrefix,
        supervisorStatePath,
        daemonRunReceiptPath,
        intervalNs,
        leaseNs,
        int32(maxEventsRaw)
    )
    let configOk = transport.DepinInferenceTransportValidateResidencySettlementDaemonConfig(config)
    if IsErr(configOk):
        depinDaemonPrintErr(Error(configOk))
        return 1
    if config.configHash != configHash:
        depinDaemonPrintErr("depin daemon: config hash mismatch")
        return 1
    if startupBundlePath != transport.DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(residencyPrefix):
        depinDaemonPrintErr("depin daemon: startup bundle path mismatch")
        return 1
    if daemonFileEventsPath != transport.DepinInferenceTransportResidencySettlementDaemonFileEventBatchPathFromPrefix(residencyPrefix):
        depinDaemonPrintErr("depin daemon: file event path mismatch")
        return 1
    let startupRead = transport.DepinInferenceTransportReadResidencySettlementDaemonStartupBundleReceiptFile(startupBundlePath)
    if IsErr(startupRead):
        depinDaemonPrintErr(Error(startupRead))
        return 1
    let startupOk = transport.DepinInferenceTransportValidateResidencySettlementDaemonStartupBundleReceiptSelf(Value(startupRead))
    if IsErr(startupOk):
        depinDaemonPrintErr(Error(startupOk))
        return 1
    let startup = Value(startupRead)
    if startup.configHash != config.configHash ||
       startup.daemonIdHash != inference_settlement.DepinSettlementTextHash(daemonId) ||
       startup.eventStreamHash != inference_settlement.DepinSettlementTextHash(eventStreamId):
        depinDaemonPrintErr("depin daemon: startup bundle binding mismatch")
        return 1
    var checkedAtNs: int64
    let checkedDefault = times.EpochTimeNs()
    let checkedRead = depinDaemonReadOptionalInt64Flag("--checked-at-ns", checkedDefault, checkedAtNs)
    if IsErr(checkedRead):
        depinDaemonPrintErr(Error(checkedRead))
        return 2
    var processPid: int64
    let pidRead = depinDaemonReadOptionalInt64Flag("--process-pid", int64(0), processPid)
    if IsErr(pidRead):
        depinDaemonPrintErr(Error(pidRead))
        return 2
    var maxCyclesRaw: int64
    let maxCyclesRead = depinDaemonReadOptionalInt64Flag("--max-cycles", int64(8), maxCyclesRaw)
    if IsErr(maxCyclesRead):
        depinDaemonPrintErr(Error(maxCyclesRead))
        return 2
    if maxCyclesRaw <= int64(0) || maxCyclesRaw > int64(1024):
        depinDaemonPrintErr("depin daemon: invalid --max-cycles")
        return 2
    if cmdline.HasFlag("--register-service"):
        return depinDaemonRunRegisterService(config, startup, residencyPrefix, processPid, checkedAtNs)
    if cmdline.HasFlag("--unregister-service"):
        return depinDaemonRunUnregisterService()
    if cmdline.HasFlag("--heartbeat"):
        return depinDaemonRunHeartbeat(startupBundlePath, processPid, checkedAtNs)
    if cmdline.HasFlag("--run-until-idle"):
        if cmdline.HasFlag("--build-events") || cmdline.HasFlag("--run-once"):
            depinDaemonPrintErr("depin daemon: --run-until-idle conflicts with --build-events/--run-once")
            return 2
        var observedAtNs = checkedAtNs
        var cycle: int32
        while cycle < int32(maxCyclesRaw):
            let batchBuild = transport.DepinInferenceTransportBuildResidencySettlementDaemonFileEventBatchFromStartupBundle(
                config,
                startup,
                observedAtNs
            )
            if IsErr(batchBuild):
                depinDaemonPrintErr(Error(batchBuild))
                return 1
            depinDaemonPrintOut(strutil.Join(["daemon_file_event_batch_path=", Value(batchBuild).receipt.path], ""))
            depinDaemonPrintOut(strutil.Join(["daemon_file_event_batch_receipt_hash=", strings.Int64ToStr(Value(batchBuild).receipt.receiptHash)], ""))
            depinDaemonPrintOut(strutil.Join(["daemon_file_event_batch_hash=", strings.Int64ToStr(Value(batchBuild).receipt.batchHash)], ""))
            depinDaemonPrintOut(strutil.Join(["daemon_file_event_batch_cycle=", strings.IntToStr(cycle)], ""))
            if Value(batchBuild).receipt.emittedEventCount == 0:
                depinDaemonPrintOut("depin_residency_settlement_daemon_idle=1")
                return 0
            let runReceipt = transport.DepinInferenceTransportRunResidencySettlementDaemonFileEventBatchFromStartupBundle(
                config,
                startup,
                Value(batchBuild).receipt
            )
            if IsErr(runReceipt):
                depinDaemonPrintErr(Error(runReceipt))
                return 1
            depinDaemonPrintOut(strutil.Join(["daemon_run_receipt_path=", Value(runReceipt).path], ""))
            depinDaemonPrintOut(strutil.Join(["daemon_run_receipt_hash=", strings.Int64ToStr(Value(runReceipt).receiptHash)], ""))
            depinDaemonPrintOut(strutil.Join(["daemon_run_hash=", strings.Int64ToStr(Value(runReceipt).runHash)], ""))
            observedAtNs = Value(runReceipt).stoppedAtNs + int64(1)
            cycle = cycle + 1
        depinDaemonPrintErr("depin daemon: run-until-idle cycle limit")
        return 1
    if cmdline.HasFlag("--build-events"):
        let batchBuild = transport.DepinInferenceTransportBuildResidencySettlementDaemonFileEventBatchFromStartupBundle(
            config,
            startup,
            checkedAtNs
        )
        if IsErr(batchBuild):
            depinDaemonPrintErr(Error(batchBuild))
            return 1
        depinDaemonPrintOut(strutil.Join(["daemon_file_event_batch_path=", Value(batchBuild).receipt.path], ""))
        depinDaemonPrintOut(strutil.Join(["daemon_file_event_batch_receipt_hash=", strings.Int64ToStr(Value(batchBuild).receipt.receiptHash)], ""))
        depinDaemonPrintOut(strutil.Join(["daemon_file_event_batch_hash=", strings.Int64ToStr(Value(batchBuild).receipt.batchHash)], ""))
        depinDaemonPrintOut("depin_residency_settlement_daemon_events_ready=1")
        if !cmdline.HasFlag("--run-once"):
            return 0
    if cmdline.HasFlag("--run-once"):
        let batchRead = transport.DepinInferenceTransportReadResidencySettlementDaemonFileEventBatchReceiptFile(daemonFileEventsPath)
        if IsErr(batchRead):
            depinDaemonPrintErr(Error(batchRead))
            return 1
        let batchOk = transport.DepinInferenceTransportValidateResidencySettlementDaemonFileEventBatchReceipt(Value(batchRead))
        if IsErr(batchOk):
            depinDaemonPrintErr(Error(batchOk))
            return 1
        let runReceipt = transport.DepinInferenceTransportRunResidencySettlementDaemonFileEventBatchFromStartupBundle(
            config,
            startup,
            Value(batchRead)
        )
        if IsErr(runReceipt):
            depinDaemonPrintErr(Error(runReceipt))
            return 1
        depinDaemonPrintOut(strutil.Join(["daemon_run_receipt_path=", Value(runReceipt).path], ""))
        depinDaemonPrintOut(strutil.Join(["daemon_run_receipt_hash=", strings.Int64ToStr(Value(runReceipt).receiptHash)], ""))
        depinDaemonPrintOut(strutil.Join(["daemon_run_hash=", strings.Int64ToStr(Value(runReceipt).runHash)], ""))
        depinDaemonPrintOut("depin_residency_settlement_daemon_run_ready=1")
    else:
        let health = transport.DepinInferenceTransportWriteResidencySettlementDaemonHealthReceiptFromStartupBundle(
            startupBundlePath,
            processPid,
            checkedAtNs
        )
        if IsErr(health):
            depinDaemonPrintErr(Error(health))
            return 1
        depinDaemonPrintOut(strutil.Join(["health_receipt_path=", Value(health).path], ""))
        depinDaemonPrintOut(strutil.Join(["health_receipt_hash=", strings.Int64ToStr(Value(health).receiptHash)], ""))
        depinDaemonPrintOut(strutil.Join(["startup_bundle_receipt_hash=", strings.Int64ToStr(Value(health).startupBundleReceiptHash)], ""))
        depinDaemonPrintOut("depin_residency_settlement_daemon_health_ready=1")
    return 0

fn depinDaemonRunRegisterService(config: transport.DepinInferenceTransportResidencySettlementDaemonConfig,
                                 startup: transport.DepinInferenceTransportResidencySettlementDaemonStartupBundleReceipt,
                                 residencyPrefix: str,
                                 processPid: int64,
                                 checkedAtNs: int64): int32 =
    var serviceKind: str
    let readKind = depinDaemonReadRequiredFlag("--service-kind", serviceKind)
    if IsErr(readKind):
        depinDaemonPrintErr(Error(readKind))
        return 2
    var serviceName: str
    let readName = depinDaemonReadRequiredFlag("--service-name", serviceName)
    if IsErr(readName):
        depinDaemonPrintErr(Error(readName))
        return 2
    var executablePath: str
    let readExec = depinDaemonReadRequiredFlag("--executable-path", executablePath)
    if IsErr(readExec):
        depinDaemonPrintErr(Error(readExec))
        return 2
    var workingDirectory: str
    let readWork = depinDaemonReadRequiredFlag("--working-directory", workingDirectory)
    if IsErr(readWork):
        depinDaemonPrintErr(Error(readWork))
        return 2
    let osServiceSpecPath = transport.DepinInferenceTransportResidencySettlementDaemonOsServiceSpecReceiptPathFromPrefix(residencyPrefix)
    let osSpecRead = transport.DepinInferenceTransportReadResidencySettlementDaemonOsServiceSpecReceiptFile(osServiceSpecPath)
    if IsErr(osSpecRead):
        depinDaemonPrintErr(Error(osSpecRead))
        return 1
    let osSpec = Value(osSpecRead)
    if osSpec.serviceKind != serviceKind:
        depinDaemonPrintErr("depin daemon: register service kind mismatch")
        return 1
    let health = transport.DepinInferenceTransportWriteResidencySettlementDaemonHealthReceiptFromStartupBundle(
        transport.DepinInferenceTransportResidencySettlementDaemonStartupBundlePathFromPrefix(residencyPrefix),
        processPid,
        checkedAtNs
    )
    if IsErr(health):
        depinDaemonPrintErr(Error(health))
        return 1
    let registered = transport.DepinInferenceTransportRegisterResidencySettlementDaemonServiceFromReceipts(
        config,
        startup,
        osSpec,
        Value(health),
        serviceKind,
        serviceName,
        executablePath,
        workingDirectory,
        checkedAtNs
    )
    if IsErr(registered):
        depinDaemonPrintErr(Error(registered))
        return 1
    depinDaemonPrintOut(strutil.Join(["registered_service_receipt_path=", Value(registered).receiptPath], ""))
    depinDaemonPrintOut(strutil.Join(["registered_service_receipt_hash=", strings.Int64ToStr(Value(registered).receiptHash)], ""))
    depinDaemonPrintOut(strutil.Join(["registered_service_hash=", strings.Int64ToStr(Value(registered).registeredServiceHash)], ""))
    depinDaemonPrintOut("depin_residency_settlement_daemon_registered=1")
    return 0

fn depinDaemonRunUnregisterService(): int32 =
    var registeredReceiptPath: str
    let readPath = depinDaemonReadRequiredFlag("--registered-service-receipt", registeredReceiptPath)
    if IsErr(readPath):
        depinDaemonPrintErr(Error(readPath))
        return 2
    let unregister = transport.DepinInferenceTransportUnregisterResidencySettlementDaemonService(registeredReceiptPath)
    if IsErr(unregister):
        depinDaemonPrintErr(Error(unregister))
        return 1
    depinDaemonPrintOut(strutil.Join(["registered_service_receipt_path=", Value(unregister).receiptPath], ""))
    depinDaemonPrintOut(strutil.Join(["registered_service_receipt_hash=", strings.Int64ToStr(Value(unregister).receiptHash)], ""))
    depinDaemonPrintOut("depin_residency_settlement_daemon_unregistered=1")
    return 0

fn depinDaemonRunHeartbeat(startupBundlePath: str, processPid: int64, checkedAtNs: int64): int32 =
    let health = transport.DepinInferenceTransportWriteResidencySettlementDaemonHealthReceiptFromStartupBundle(
        startupBundlePath,
        processPid,
        checkedAtNs
    )
    if IsErr(health):
        depinDaemonPrintErr(Error(health))
        return 1
    depinDaemonPrintOut(strutil.Join(["health_receipt_path=", Value(health).path], ""))
    depinDaemonPrintOut(strutil.Join(["health_receipt_hash=", strings.Int64ToStr(Value(health).receiptHash)], ""))
    depinDaemonPrintOut(strutil.Join(["startup_bundle_receipt_hash=", strings.Int64ToStr(Value(health).startupBundleReceiptHash)], ""))
    depinDaemonPrintOut("depin_residency_settlement_daemon_heartbeat_ready=1")
    return 0

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    if cmdline.ParamCount() < 1:
        depinDaemonPrintErr(depinDaemonUsage())
        return 2
    let command = cmdline.ParamStr(1)
    if command != "depin-residency-settlement-daemon":
        depinDaemonPrintErr(depinDaemonUsage())
        return 2
    return depinDaemonRunHealthProbe()
