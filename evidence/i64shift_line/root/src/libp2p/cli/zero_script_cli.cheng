import std/os
import std/cmdline
import std/strutils as strutil
import std/strings

const
    cliDefaultRawptrSchemeId = "ZRPC"
    cliDefaultRawptrSchemeName = "zero_rawptr_production_closure"
    cliDefaultRawptrEnforceMode = "hard_fail"
    cliDefaultProfile = "stable"
    cliDefaultBuildTrack = "release"
    cliDefaultFeatureTokens = "gate.mdns_discovery.ok,gate.ble_discovery.ok,gate.quic_direct.ok,gate.connection_migration.ok,gate.push_to_punch.ok,gate.dm_message.ok,gate.video_call.ok,gate.synccast_live.ok,gate.publish_homepage.ok"
    cliDefaultMobilePlatforms = "android,harmony"
    cliDefaultMobileTimeoutFullstart = 900
    cliDefaultMobileTimeoutBootstrap = 900
    cliDefaultMobileTimeoutLanFullstack = 1800
    cliDefaultMobileTimeoutQuic = 1800
    cliDefaultMobileTimeoutDeviceMatrix = 3600
    cliExecCaptureMask = uint64(7)
    cliPreflightProbeTimeoutDefault = "20"
    cliStubAllowTag = "stub-gate: allow"
    cliSyntaxAllowCountingWhileTag = "cheng-syntax-policy: allow-counting-while"

type
    CliContext =
        repoRoot: str
        toolingBin: str
        toolchainRoot: str
        pkgRoots: str
        mobileRoot: str
        harmonyTemplateRoot: str
        harmonySignSource: str
        harmonyNodeBin: str
        harmonyHvigorJs: str
        harmonyExportsC: str
        harmonyExportsH: str

    CliPreflightState =
        canonicalDriver: str
        driverSource: str
        driverProbeLog: str
        driverProbeCategory: str
        pkgRoots: str
        toolchainRoot: str

    CliPreflightConfig =
        shellEnv: bool
        skipDriverProbe: bool
        skipGates: bool
        targetSubcommand: str

fn cliUsage(): str =
    return "Usage:\n" +
           "  zero-script-cli <subcommand> [options]\n\n" +
           "Subcommands:\n" +
           "  preflight      native driver/toolchain/docs gate preflight\n" +
           "  verify         compile+run a Cheng runner without shell scripts\n" +
           "  backend-build  compile a Cheng entry to an executable\n" +
           "  cstring-probe  run cstring materialization preflight\n" +
           "  mobile-suite   run the mobile full-start verification suite\n" +
           "  device-matrix  run the mobile real-device matrix gate\n" +
           "  list-modes     print verify mode -> runner mapping\n\n" +
           "Common preflight flags:\n" +
           "  --skip-driver-probe   skip canonical driver compile probe\n" +
           "  --skip-gates          skip syntax/docs/stub hard gates\n" +
           "  --probe:0|1           compatibility form of driver probe toggle\n" +
           "  --gates:0|1           compatibility form of hard gate toggle\n\n" +
           "Zero-script run example:\n" +
           "  cheng_tooling cheng --in:src/cli/zero_script_main.cheng --run -- verify --mode:test --runner:src/tests/mobile_multiaddr_nearfield_smoke.cheng\n"

fn cliBoolText(flag: bool): str =
    if flag:
        return "1"
    return "0"

fn cliStrNonEmpty(text: str): bool =
    return len(text) > 0

fn cliShellQuote(raw: str): str =
    if len(raw) == 0:
        return "\"\""
    var escaped: str = strutil.replace(raw, "\\", "\\\\")
    escaped = strutil.replace(escaped, "$", "\\$")
    escaped = strutil.replace(escaped, "`", "\\`")
    escaped = strutil.replace(escaped, "\"", "\\\"")
    return "\"" + escaped + "\""

fn cliEnvAssign(name: str, value: str): str =
    if !cliStrNonEmpty(name):
        return ""
    return name + "=" + cliShellQuote(value) + " "

fn cliTrim(raw: str): str =
    let n: int32 = len(raw)
    if n <= 0:
        return ""
    var start: int32
    while start < n:
        let ch: char = raw[start]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        start = start + 1
    if start >= n:
        return ""
    var stop: int32 = n
    while stop > start:
        let ch: char = raw[stop - 1]
        if ch != ' ' && ch != '\t' && ch != '\r' && ch != '\n':
            break
        stop = stop - 1
    return strings.SliceBytes(raw, start, stop - start)

fn cliLower(raw: str): str =
    return strutil.toLowerAscii(cliTrim(raw))

fn cliArgAt(args: str[], idx: int32): str =
    if idx < 0 || idx >= args.len:
        return ""
    return args[idx]

fn cliSliceArgs(args: str[], start: int32): str[] =
    var out: str[]
    if start < 0:
        return out
    for i in start..<args.len:
        add(out, args[i])
    return out

fn cliArgsFromEnv(): str[] =
    var out: str[]
    let countRaw: str = cliTrim(os.getEnvDefault("CHENG_LIBP2P_ZERO_SCRIPT_ARGC", "0"))
    let count: int32 = cliParseInt32Default(countRaw, 0)
    if count <= 0:
        return out
    for i in 0..<count:
        let key: str = "CHENG_LIBP2P_ZERO_SCRIPT_ARG_" + IntToStr(i)
        add(out, os.getEnvDefault(key, ""))
    return out

fn cliCurrentDir(): str =
    let pwd: str = cliTrim(os.getEnvDefault("PWD", ""))
    if len(pwd) > 0:
        return pwd
    let res: os.ExecCmdResult = cliExec(".", "pwd -P")
    if os.execCmdResultExitCode(res) != 0:
        return "."
    let out: str = cliTrim(os.execCmdResultOutput(res))
    if len(out) > 0:
        return out
    return "."

fn cliIsAbsolute(path: str): bool =
    if len(path) <= 0:
        return false
    if path[0] == '/' || path[0] == '\\':
        return true
    if len(path) > 1 && path[1] == ':':
        return true
    return false

fn cliAbsPath(pathRaw: str): str =
    let path: str = cliTrim(pathRaw)
    if len(path) <= 0:
        return cliCurrentDir()
    if cliIsAbsolute(path):
        return path
    return cliJoinPath(cliCurrentDir(), path)

fn cliJoinPath(aRaw: str, bRaw: str): str =
    let a: str = cliTrim(aRaw)
    let b: str = cliTrim(bRaw)
    if len(a) <= 0:
        return b
    if len(b) <= 0:
        return a
    let last: char = a[len(a) - 1]
    if last == '/' || last == '\\':
        return a + b
    return a + "/" + b

fn cliTryInlineFlagValue(arg: str, key: str, outValue: var str): bool =
    outValue = ""
    if len(arg) <= 0 || len(key) <= 0:
        return false
    let colonPrefix: str = key + ":"
    if strings.hasPrefix(arg, colonPrefix):
        outValue = strings.dropPrefix(arg, colonPrefix)
        return true
    let eqPrefix: str = key + "="
    if strings.hasPrefix(arg, eqPrefix):
        outValue = strings.dropPrefix(arg, eqPrefix)
        return true
    return false

fn cliReadFlagValueAt(args: str[], idx: int32, key: str, outValue: var str, outNextIndex: var int32): bool =
    if idx < 0 || idx >= args.len || len(key) <= 0:
        return false
    let arg: str = args[idx]
    let colonPrefix: str = key + ":"
    if strings.hasPrefix(arg, colonPrefix):
        outValue = strings.dropPrefix(arg, colonPrefix)
        outNextIndex = idx
        return true
    let eqPrefix: str = key + "="
    if strings.hasPrefix(arg, eqPrefix):
        outValue = strings.dropPrefix(arg, eqPrefix)
        outNextIndex = idx
        return true
    if arg != key:
        return false
    let nextIndex: int32 = idx + 1
    if nextIndex >= args.len:
        return false
    outValue = args[nextIndex]
    outNextIndex = nextIndex
    return true

fn cliReadLastFlagValue(args: str[], key: str, outValue: var str): bool =
    if len(key) <= 0:
        return false
    var found: bool
    var lastValue: str
    var i: int32
    while i < args.len:
        let arg: str = args[i]
        let colonPrefix: str = key + ":"
        let eqPrefix: str = key + "="
        if strings.hasPrefix(arg, colonPrefix):
            lastValue = strings.dropPrefix(arg, colonPrefix)
            found = true
            i = i + 1
            continue
        if strings.hasPrefix(arg, eqPrefix):
            lastValue = strings.dropPrefix(arg, eqPrefix)
            found = true
            i = i + 1
            continue
        if arg == key:
            let nextIndex: int32 = i + 1
            if nextIndex < args.len:
                lastValue = args[nextIndex]
                found = true
                i = nextIndex + 1
                continue
            found = true
            lastValue = ""
            i = i + 1
            continue
        i = i + 1
    if found:
        outValue = lastValue
    return found

fn cliHasFlag(args: str[], key: str): bool =
    for i in 0..<args.len:
        let arg: str = args[i]
        if arg == key:
            return true
        let inlinePrefixA: str = key + ":"
        let inlinePrefixB: str = key + "="
        if strings.hasPrefix(arg, inlinePrefixA) || strings.hasPrefix(arg, inlinePrefixB):
            return true
    return false

fn cliExec(root: str, command: str): os.ExecCmdResult =
    return os.execCmdEx(command, cliExecCaptureMask, root)

fn cliPrintOutput(raw: str) =
    if !cliStrNonEmpty(raw):
        return
    echo(raw)

fn cliParseInt32Default(raw: str, defaultValue: int32): int32 =
    let text: str = cliTrim(raw)
    if len(text) <= 0:
        return defaultValue
    return int32(strutil.parseInt(text))

fn cliTimestamp(root: str): str =
    let res: os.ExecCmdResult = cliExec(root, "date -u '+%Y%m%d-%H%M%S' 2>/dev/null || date '+%Y%m%d-%H%M%S'")
    if os.execCmdResultExitCode(res) != 0:
        return "00000000-000000"
    let text: str = cliTrim(os.execCmdResultOutput(res))
    if len(text) <= 0:
        return "00000000-000000"
    return text

fn cliSplitLines(raw: str): str[] =
    var out: str[]
    let n: int32 = len(raw)
    if n <= 0:
        return out
    var start: int32
    for i in 0..<n:
        if raw[i] == '\n':
            let piece: str = cliTrim(strings.SliceBytes(raw, start, i - start))
            if len(piece) > 0:
                add(out, piece)
            start = i + 1
    if start < n:
        let tail: str = cliTrim(strings.SliceBytes(raw, start, n - start))
        if len(tail) > 0:
            add(out, tail)
    return out

fn cliSplitRawLines(raw: str): str[] =
    var out: str[]
    let n: int32 = len(raw)
    if n <= 0:
        return out
    var start: int32
    for i in 0..<n:
        if raw[i] != '\n':
            continue
        var count: int32 = i - start
        if count > 0 && raw[i - 1] == '\r':
            count = count - 1
        add(out, count > 0 ? strings.SliceBytes(raw, start, count) : "")
        start = i + 1
    if start < n:
        add(out, strings.SliceBytes(raw, start, n - start))
    return out

fn cliPreviewText(raw: str, maxBytes: int32): str =
    if maxBytes <= 0 || len(raw) <= maxBytes:
        return raw
    return strings.SliceBytes(raw, 0, maxBytes) + "... [truncated]"

fn cliContainsAny(haystack: str, patterns: str[]): bool =
    for i in 0..<patterns.len:
        if strutil.contains(haystack, patterns[i]):
            return true
    return false

fn cliEndsWith(text: str, suffix: str): bool =
    if len(suffix) <= 0:
        return true
    if len(text) < len(suffix):
        return false
    let start: int32 = len(text) - len(suffix)
    return strings.SliceBytes(text, start, len(suffix)) == suffix

fn cliIndexOfFrom(text: str, sub: str, start: int32): int32 =
    if len(sub) <= 0:
        return start
    let n: int32 = len(text)
    let m: int32 = len(sub)
    if start < 0 || start >= n || m > n:
        return -1
    for i in start..<(n - m + 1):
        var matched: bool = true
        for j in 0..<m:
            if text[i + j] != sub[j]:
                matched = false
                break
        if matched:
            return i
    return -1

fn cliIndexOf(text: str, sub: str): int32 =
    return cliIndexOfFrom(text, sub, 0)

fn cliIsIdentChar(ch: char): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    return ch == '_'

fn cliLeadingSpaceCount(line: str): int32 =
    for i in 0..<len(line):
        if line[i] != ' ':
            return i
    return len(line)

fn cliTrimLeftSpaces(line: str): str =
    let offset: int32 = cliLeadingSpaceCount(line)
    if offset <= 0:
        return line
    if offset >= len(line):
        return ""
    return strings.SliceBytes(line, offset, len(line) - offset)

fn cliStripSpaces(line: str): str =
    let n: int32 = len(line)
    if n <= 0:
        return ""
    var out: str
    for i in 0..<n:
        let ch: char = line[i]
        if ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n':
            continue
        out = out + charToStr(ch)
    return out

fn cliAppendUnique(items: var str[], valueRaw: str) =
    let value: str = cliTrim(valueRaw)
    if len(value) <= 0:
        return
    for i in 0..<items.len:
        if items[i] == value:
            return
    add(items, value)

fn cliEnvFlagEnabled(name: str): bool =
    let raw: str = cliLower(os.getEnvDefault(name, "0"))
    return raw == "1" || raw == "true" || raw == "yes" || raw == "on"

fn cliLooksLikeToolchainRoot(pathRaw: str): bool =
    let path: str = cliAbsPath(pathRaw)
    return os.dirExists(cliJoinPath(path, "src")) && os.dirExists(cliJoinPath(path, "artifacts"))

fn cliRepoRootFrom(startRaw: str): str =
    var current: str = cliAbsPath(startRaw)
    if !os.dirExists(current):
        current = os.parentDir(current)
    while len(current) > 0:
        let manifest: str = cliJoinPath(current, "cheng-package.toml")
        if os.fileExists(manifest):
            return current
        let parent: str = os.parentDir(current)
        if parent == current || len(parent) <= 0:
            break
        current = parent
    return ""

fn cliResolveRepoRoot(): str =
    let explicit: str = cliTrim(os.getEnvDefault("CHENG_LIBP2P_REPO_ROOT", ""))
    if len(explicit) > 0 && os.dirExists(explicit):
        return cliAbsPath(explicit)
    let pwd: str = cliCurrentDir()
    let fromPwd: str = cliRepoRootFrom(pwd)
    if len(fromPwd) > 0:
        return fromPwd
    return cliRepoRootFrom(cliCurrentDir())

fn cliParentBySuffix(path: str, suffix: str): str =
    let full: str = cliAbsPath(path)
    let lowerSuffix: str = cliLower(suffix)
    let fullLen: int32 = len(full)
    let suffixLen: int32 = len(suffix)
    if fullLen <= suffixLen:
        return full
    let start: int32 = fullLen - suffixLen
    let tail: str = strings.SliceBytes(full, start, suffixLen)
    if cliLower(tail) != lowerSuffix:
        return full
    return strings.SliceBytes(full, 0, start)

fn cliDetectToolingBin(repoRoot: str): str =
    let explicit: str = cliTrim(os.getEnvDefault("CHENG_TOOLING_BIN", ""))
    if len(explicit) > 0 && os.fileExists(explicit):
        return cliAbsPath(explicit)
    let chengRootEnv: str = cliTrim(os.getEnvDefault("CHENG_ROOT", os.getEnvDefault("ROOT_DIR", "")))
    if len(chengRootEnv) > 0:
        let candA: str = cliJoinPath(cliAbsPath(chengRootEnv), "artifacts/tooling_cmd/cheng_tooling")
        if os.fileExists(candA):
            return candA
        let candB: str = cliJoinPath(cliAbsPath(chengRootEnv), "artifacts/tooling_cmdline/bin/cheng_tooling")
        if os.fileExists(candB):
            return candB
    let home: str = cliTrim(os.getEnvDefault("HOME", ""))
    var candidates: str[]
    add(candidates, "/Users/lbcheng/cheng-lang/artifacts/tooling_cmd/cheng_tooling")
    if len(home) > 0:
        add(candidates, home + "/.cheng/toolchain/cheng-lang/artifacts/tooling_cmd/cheng_tooling")
        add(candidates, home + "/cheng-lang/artifacts/tooling_cmd/cheng_tooling")
        add(candidates, home + "/.cheng/toolchain/cheng-lang/artifacts/tooling_cmdline/bin/cheng_tooling")
    let sibling: str = cliAbsPath(cliJoinPath(repoRoot, "../cheng-lang/artifacts/tooling_cmd/cheng_tooling"))
    add(candidates, sibling)
    for i in 0..<candidates.len:
        if os.fileExists(candidates[i]):
            return cliAbsPath(candidates[i])
    return ""

fn cliParseToolchainRootFromOutput(raw: str): str =
    let rows: str[] = cliSplitLines(raw)
    for i in 0..<rows.len:
        let line: str = rows[i]
        if strings.hasPrefix(line, "toolchain_root="):
            return cliTrim(strings.dropPrefix(line, "toolchain_root="))
    return ""

fn cliResolveToolchainRoot(repoRoot: str, toolingBin: str): str =
    if len(toolingBin) <= 0:
        return ""
    let explicit: str = cliTrim(os.getEnvDefault("CHENG_TOOLCHAIN_ROOT", ""))
    if len(explicit) > 0 && cliLooksLikeToolchainRoot(explicit):
        return cliAbsPath(explicit)
    let chengRootEnv: str = cliTrim(os.getEnvDefault("CHENG_ROOT", os.getEnvDefault("ROOT_DIR", "")))
    if len(chengRootEnv) > 0 && cliLooksLikeToolchainRoot(chengRootEnv):
        return cliAbsPath(chengRootEnv)
    let full: str = cliAbsPath(toolingBin)
    let suffixA: str = "/artifacts/tooling_cmd/cheng_tooling"
    let suffixB: str = "/artifacts/tooling_cmdline/bin/cheng_tooling"
    let lower: str = cliLower(full)
    if strutil.contains(lower, cliLower(suffixA)):
        let derivedA: str = cliParentBySuffix(full, suffixA)
        if cliLooksLikeToolchainRoot(derivedA):
            return derivedA
    if strutil.contains(lower, cliLower(suffixB)):
        let derivedB: str = cliParentBySuffix(full, suffixB)
        if cliLooksLikeToolchainRoot(derivedB):
            return derivedB
    let queryCmd: str = cliShellQuote(toolingBin) + " toolchain-root"
    let queryRes: os.ExecCmdResult = cliExec(repoRoot, queryCmd)
    if os.execCmdResultExitCode(queryRes) == 0:
        let parsed: str = cliParseToolchainRootFromOutput(os.execCmdResultOutput(queryRes))
        if len(parsed) > 0 && cliLooksLikeToolchainRoot(parsed):
            return cliAbsPath(parsed)
    let fallback: str = os.parentDir(os.parentDir(os.parentDir(full)))
    if cliLooksLikeToolchainRoot(fallback):
        return fallback
    return ""

fn cliAppendPkgRoot(current: str, itemRaw: str): str =
    let item: str = cliTrim(itemRaw)
    if len(item) <= 0 || !os.dirExists(item):
        return current
    let absItem: str = cliAbsPath(item)
    let parts: str[] = strutil.split(current, ':')
    for i in 0..<parts.len:
        if cliTrim(parts[i]) == absItem:
            return current
    if len(current) <= 0:
        return absItem
    return current + ":" + absItem

fn cliBuildPkgRoots(repoRoot: str, toolchainRoot: str): str =
    var roots: str = cliTrim(os.getEnvDefault("PKG_ROOTS", ""))
    roots = cliAppendPkgRoot(roots, repoRoot)
    roots = cliAppendPkgRoot(roots, toolchainRoot)
    roots = cliAppendPkgRoot(roots, cliJoinPath(repoRoot, "../cheng-quic"))
    roots = cliAppendPkgRoot(roots, cliJoinPath(repoRoot, "../cheng-observability"))
    let home: str = cliTrim(os.getEnvDefault("HOME", ""))
    if len(home) > 0:
        roots = cliAppendPkgRoot(roots, home + "/.cheng-packages")
        roots = cliAppendPkgRoot(roots, home + "/.cheng-packages/cheng-quic")
        roots = cliAppendPkgRoot(roots, home + "/.cheng-packages/cheng-observability")
    return roots

fn cliResolveContext(outCtx: var CliContext, outErr: var str): bool =
    let repoRoot: str = cliResolveRepoRoot()
    if len(repoRoot) <= 0:
        outErr = "zero-script-cli: failed to resolve repo root"
        return false
    let toolingBin: str = cliDetectToolingBin(repoRoot)
    if len(toolingBin) <= 0:
        outErr = "zero-script-cli: missing cheng_tooling binary; set CHENG_TOOLING_BIN"
        return false
    let toolchainRoot: str = cliResolveToolchainRoot(repoRoot, toolingBin)
    if len(toolchainRoot) <= 0:
        outErr = "zero-script-cli: failed to resolve toolchain root"
        return false
    outCtx.repoRoot = repoRoot
    outCtx.toolingBin = toolingBin
    outCtx.toolchainRoot = toolchainRoot
    outCtx.pkgRoots = cliBuildPkgRoots(repoRoot, toolchainRoot)
    outCtx.mobileRoot = ""
    outCtx.harmonyTemplateRoot = ""
    outCtx.harmonySignSource = ""
    outCtx.harmonyNodeBin = ""
    outCtx.harmonyHvigorJs = ""
    outCtx.harmonyExportsC = ""
    outCtx.harmonyExportsH = ""
    outErr = ""
    return true

fn cliCopyContext(dst: var CliContext, src: CliContext) =
    dst.repoRoot = src.repoRoot
    dst.toolingBin = src.toolingBin
    dst.toolchainRoot = src.toolchainRoot
    dst.pkgRoots = src.pkgRoots
    dst.mobileRoot = src.mobileRoot
    dst.harmonyTemplateRoot = src.harmonyTemplateRoot
    dst.harmonySignSource = src.harmonySignSource
    dst.harmonyNodeBin = src.harmonyNodeBin
    dst.harmonyHvigorJs = src.harmonyHvigorJs
    dst.harmonyExportsC = src.harmonyExportsC
    dst.harmonyExportsH = src.harmonyExportsH

fn cliResolveEntryPath(repoRoot: str, rawPath: str): str =
    let trimmed: str = cliTrim(rawPath)
    if len(trimmed) <= 0:
        return ""
    if os.fileExists(trimmed):
        return cliAbsPath(trimmed)
    let joined: str = cliJoinPath(repoRoot, trimmed)
    if os.fileExists(joined):
        return cliAbsPath(joined)
    return ""

fn cliDefaultRunnerForMode(repoRoot: str, modeRaw: str): str =
    let mode: str = cliLower(modeRaw)
    if mode == "backend_smoke":
        return cliResolveEntryPath(repoRoot, "src/tests/verify_backend_smoke_runner.cheng")
    if mode == "test":
        return cliResolveEntryPath(repoRoot, "src/tests/test_runner.cheng")
    if mode == "smoke":
        return cliResolveEntryPath(repoRoot, "src/tests/mobile_ffi_fullstart_real_smoke.cheng")
    if mode == "bootstrap":
        return cliResolveEntryPath(repoRoot, "src/tests/bootstrap_runner.cheng")
    if mode == "synccast":
        return cliResolveEntryPath(repoRoot, "src/tests/synccast_verify_runner.cheng")
    if mode == "synccast_closedloop" || mode == "synccast-closedloop":
        return cliResolveEntryPath(repoRoot, "src/tests/synccast_closedloop_runner.cheng")
    if mode == "depin_orderbook" || mode == "depin-orderbook":
        return cliResolveEntryPath(repoRoot, "src/tests/depin_orderbook_runner.cheng")
    if mode == "depin_inference" || mode == "depin-inference":
        return cliResolveEntryPath(repoRoot, "src/tests/depin_inference_runner.cheng")
    if mode == "msquic" || mode == "quic":
        let sibling: str = cliAbsPath(cliJoinPath(repoRoot, "../cheng-quic/src/tests/msquic_verify_runner.cheng"))
        if os.fileExists(sibling):
            return sibling
        let home: str = cliTrim(os.getEnvDefault("HOME", ""))
        if len(home) > 0:
            let cached: str = home + "/.cheng-packages/cheng-quic/src/tests/msquic_verify_runner.cheng"
            if os.fileExists(cached):
                return cached
        return ""
    return ""

fn cliListModes(ctx: CliContext): int32 =
    echo("verify modes:")
    let names: str[] = ["backend_smoke", "test", "smoke", "mobile", "bootstrap", "synccast", "synccast_closedloop", "depin_orderbook", "depin_inference", "msquic", "quic"]
    for i in 0..<names.len:
        let name: str = names[i]
        if name == "mobile":
            echo(name + ": builtin mobile-suite")
            continue
        let runner: str = cliDefaultRunnerForMode(ctx.repoRoot, name)
        if len(runner) > 0:
            echo(name + ": " + runner)
        else:
            echo(name + ": (runner not found)")
    return 0

fn cliKnownScenarioModes(): str[] =
    let modes: str[] = ["backend_smoke", "test", "smoke", "mobile", "bootstrap", "synccast", "synccast_closedloop", "depin_orderbook", "depin_inference", "msquic", "quic"]
    return modes

fn cliScenarioModeExpectedKind(modeRaw: str): str =
    let mode: str = cliLower(modeRaw)
    if mode == "mobile":
        return "builtin"
    if mode == "msquic" || mode == "quic":
        return "external"
    if len(cliDefaultRunnerForMode(".", mode)) > 0 || mode == "backend_smoke" || mode == "test" || mode == "smoke" || mode == "bootstrap" || mode == "synccast" || mode == "synccast_closedloop" || mode == "depin_orderbook" || mode == "depin_inference":
        return "runner"
    return ""

fn cliSubcommandNeedsPreflight(subcommandRaw: str): bool =
    let subcommand: str = cliLower(subcommandRaw)
    return subcommand == "preflight" || subcommand == "verify" || subcommand == "backend-build" || subcommand == "cstring-probe" || subcommand == "mobile-suite" || subcommand == "device-matrix"

fn cliShouldRunHardGates(subcommandRaw: str): bool =
    let subcommand: str = cliLower(subcommandRaw)
    return len(subcommand) > 0 && subcommand != "list-modes"

fn cliBuildPreflightConfig(subcommandRaw: str, args: str[]): CliPreflightConfig =
    var cfg: CliPreflightConfig
    cfg.shellEnv = cliHasFlag(args, "--shell-env")
    cfg.skipDriverProbe = cliEnvFlagEnabled("ZERO_SCRIPT_SKIP_DRIVER_PROBE") || cliHasFlag(args, "--skip-driver-probe")
    cfg.skipGates = cliEnvFlagEnabled("ZERO_SCRIPT_SKIP_GATES") || cliHasFlag(args, "--skip-gates")
    cfg.targetSubcommand = cliLower(subcommandRaw)
    if cfg.targetSubcommand == "preflight":
        var target: str
        if cliReadLastFlagValue(args, "--subcommand", target):
            cfg.targetSubcommand = cliLower(target)
    var probeToggle: str
    if cliReadLastFlagValue(args, "--probe", probeToggle):
        let toggle: str = cliLower(probeToggle)
        if toggle == "0" || toggle == "false" || toggle == "off":
            cfg.skipDriverProbe = true
        elif toggle == "1" || toggle == "true" || toggle == "on":
            cfg.skipDriverProbe = false
    var gateToggle: str
    if cliReadLastFlagValue(args, "--gates", gateToggle):
        let toggle: str = cliLower(gateToggle)
        if toggle == "0" || toggle == "false" || toggle == "off":
            cfg.skipGates = true
        elif toggle == "1" || toggle == "true" || toggle == "on":
            cfg.skipGates = false
    return cfg

fn cliCanonicalDriverPath(ctx: CliContext): str =
    return cliJoinPath(ctx.repoRoot, "artifacts/backend_driver/cheng")

fn cliProbeSourcePath(ctx: CliContext): str =
    return cliJoinPath(ctx.repoRoot, "src/tests/tmp_verify_cheng_probe.cheng")

fn cliPreflightDir(ctx: CliContext): str =
    return cliJoinPath(ctx.repoRoot, "artifacts/zero_script_preflight")

fn cliSanitizeLabel(raw: str): str =
    var out: str
    for i in 0..<len(raw):
        let ch: char = raw[i]
        if ch == '/' || ch == '\\' || ch == ':' || ch == ' ':
            out = out + "_"
        else:
            out = out + charToStr(ch)
    return out

fn cliFileExecutable(ctx: CliContext, pathRaw: str): bool =
    let path: str = cliAbsPath(pathRaw)
    if !os.fileExists(path):
        return false
    let probe: os.ExecCmdResult = cliExec(ctx.repoRoot, "test -x " + cliShellQuote(path))
    return os.execCmdResultExitCode(probe) == 0

fn cliCopyExecutableFile(ctx: CliContext, srcRaw: str, dstRaw: str): bool =
    let src: str = cliAbsPath(srcRaw)
    let dst: str = cliAbsPath(dstRaw)
    if len(src) <= 0 || len(dst) <= 0 || !os.fileExists(src):
        return false
    if src == dst:
        let chmodRes: os.ExecCmdResult = cliExec(ctx.repoRoot, "chmod +x " + cliShellQuote(dst))
        return os.execCmdResultExitCode(chmodRes) == 0
    let copyCmd: str = "mkdir -p " + cliShellQuote(os.parentDir(dst)) + " ; cp " + cliShellQuote(src) + " " + cliShellQuote(dst) + " ; chmod +x " + cliShellQuote(dst)
    let copyRes: os.ExecCmdResult = cliExec(ctx.repoRoot, copyCmd)
    return os.execCmdResultExitCode(copyRes) == 0

fn cliRemoveFileIfExists(path: str) =
    if os.fileExists(path):
        let _removed: bool = os.removeFile(path)

fn cliReadFirstLines(path: str, limit: int32): str[] =
    let text: str = os.readFile(path)
    let lines: str[] = cliSplitRawLines(text)
    var out: str[]
    let maxCount: int32 = lines.len < limit ? lines.len : limit
    for i in 0..<maxCount:
        add(out, lines[i])
    return out

fn cliExtractDocRefs(text: str): str[] =
    var refs: str[]
    var start: int32
    while true:
        let idx: int32 = cliIndexOfFrom(text, "docs/", start)
        if idx < 0:
            break
        var stop: int32 = idx
        while stop < len(text):
            let ch: char = text[stop]
            let allow: bool = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '.' || ch == '/' || ch == '-'
            if !allow:
                break
            stop = stop + 1
        let candidate: str = strings.SliceBytes(text, idx, stop - idx)
        if cliEndsWith(candidate, ".md"):
            cliAppendUnique(refs, candidate)
        start = idx + 5
    return refs

fn cliCollectTrackedChengFiles(ctx: CliContext): str[] =
    let gitCmd: str = "git -C " + cliShellQuote(ctx.repoRoot) + " ls-files '*.cheng'"
    var out: str[]
    let gitRes: os.ExecCmdResult = cliExec(ctx.repoRoot, gitCmd)
    if os.execCmdResultExitCode(gitRes) == 0:
        let rows: str[] = cliSplitLines(os.execCmdResultOutput(gitRes))
        for i in 0..<rows.len:
            let rel: str = cliTrim(rows[i])
            if len(rel) > 0:
                cliAppendUnique(out, cliJoinPath(ctx.repoRoot, rel))
    let extraCliDir: str = cliJoinPath(ctx.repoRoot, "src/cli")
    if os.dirExists(extraCliDir):
        let extraCliFiles: str[] = os.walkDirRec(extraCliDir)
        for i in 0..<extraCliFiles.len:
            if cliEndsWith(extraCliFiles[i], ".cheng"):
                cliAppendUnique(out, extraCliFiles[i])
    let extraSmoke: str = cliJoinPath(ctx.repoRoot, "src/tests/zero_script_cli_smoke.cheng")
    if os.fileExists(extraSmoke):
        cliAppendUnique(out, extraSmoke)
    if out.len > 0:
        return out
    let fallback: str[] = os.walkDirRec(cliJoinPath(ctx.repoRoot, "src"))
    for i in 0..<fallback.len:
        if cliEndsWith(fallback[i], ".cheng"):
            cliAppendUnique(out, fallback[i])
    return out

fn cliDetectCounterIncrement(lineRaw: str, expectIndent: int32): str =
    let indent: int32 = cliLeadingSpaceCount(lineRaw)
    if indent != expectIndent:
        return ""
    let compact: str = cliStripSpaces(lineRaw)
    let eqPos: int32 = cliIndexOf(compact, "=")
    if eqPos <= 0 || eqPos >= len(compact) - 1:
        return ""
    let name: str = strings.SliceBytes(compact, 0, eqPos)
    let rhs: str = strings.SliceBytes(compact, eqPos + 1, len(compact) - eqPos - 1)
    if rhs == name + "+1" || rhs == name + "-1":
        return name
    return ""

fn cliConditionUsesCounter(condRaw: str, name: str, expectStep: str): bool =
    let cond: str = cliStripSpaces(condRaw)
    var patterns: str[]
    if expectStep == "+":
        patterns = [name + "<=", name + "<", name + "+1<=", name + "+1<"]
    else:
        patterns = [name + ">=", name + ">", name + "+1>=", name + "+1>"]
    for i in 0..<patterns.len:
        let pat: str = patterns[i]
        var search: int32
        while true:
            let idx: int32 = cliIndexOfFrom(cond, pat, search)
            if idx < 0:
                break
            let prevOk: bool = idx == 0 || !cliIsIdentChar(cond[idx - 1])
            let endPos: int32 = idx + len(name)
            let nextOk: bool = endPos >= len(cond) || cond[endPos] == '+' || cond[endPos] == '<' || cond[endPos] == '>'
            if prevOk && nextOk:
                return true
            search = idx + 1
    return false

fn cliCheckSyntaxPolicy(ctx: CliContext): bool =
    let files: str[] = cliCollectTrackedChengFiles(ctx)
    if files.len <= 0:
        echo("[syntax-policy] no tracked .cheng files")
        return true
    var failures: str[]
    for i in 0..<files.len:
        let path: str = files[i]
        let rel: str = os.relativePath(path, ctx.repoRoot)
        let text: str = os.readFile(path)
        let lines: str[] = cliSplitRawLines(text)
        for lineNo in 0..<lines.len:
            let line: str = lines[lineNo]
            let trimmed: str = cliTrimLeftSpaces(line)
            if strutil.contains(line, "seq["):
                add(failures, rel + ":" + IntToStr(lineNo + 1) + ": forbidden pattern seq[T]")
            if strutil.contains(line, "array["):
                add(failures, rel + ":" + IntToStr(lineNo + 1) + ": forbidden pattern array[T,N]")
            if strutil.contains(line, "@["):
                add(failures, rel + ":" + IntToStr(lineNo + 1) + ": forbidden pattern @[...]")
            if strutil.contains(line, "newSeq["):
                add(failures, rel + ":" + IntToStr(lineNo + 1) + ": forbidden pattern newSeq[...]")
            if strutil.contains(line, "newSeqWithCap("):
                add(failures, rel + ":" + IntToStr(lineNo + 1) + ": forbidden pattern newSeqWithCap(...)")
            if strutil.contains(line, "cast["):
                add(failures, rel + ":" + IntToStr(lineNo + 1) + ": forbidden pattern cast[T](...)")
            if strings.hasPrefix(trimmed, "proc ") || strings.hasPrefix(trimmed, "method ") || strings.hasPrefix(trimmed, "converter "):
                add(failures, rel + ":" + IntToStr(lineNo + 1) + ": forbidden proc/method/converter declaration")
        for lineNo in 0..<lines.len:
            let line: str = lines[lineNo]
            let trimmed: str = cliTrimLeftSpaces(line)
            if !strings.hasPrefix(trimmed, "while ") || !cliEndsWith(trimmed, ":") || strutil.contains(line, cliSyntaxAllowCountingWhileTag):
                continue
            let cond: str = strings.SliceBytes(trimmed, 6, len(trimmed) - 7)
            let cmpTokens: str[] = ["<", ">", "<=", ">="]
            if !cliContainsAny(cond, cmpTokens):
                continue
            let baseIndent: int32 = cliLeadingSpaceCount(line)
            var blockEnd: int32 = lines.len
            for nextLine in (lineNo + 1)..<lines.len:
                let row: str = lines[nextLine]
                if len(cliTrim(row)) <= 0:
                    continue
                let rowIndent: int32 = cliLeadingSpaceCount(row)
                if rowIndent <= baseIndent:
                    blockEnd = nextLine
                    break
            var lastNonBlank: int32 = -1
            if blockEnd > lineNo + 1:
                let __for_start_back_1 = blockEnd - 1
                for __for_back_1 in 0..(__for_start_back_1 - (lineNo + 1)):
                    let idx: int32 = __for_start_back_1 - __for_back_1
                    if len(cliTrim(lines[idx])) > 0:
                        lastNonBlank = idx
                        break
            if lastNonBlank < 0:
                continue
            let incName: str = cliDetectCounterIncrement(lines[lastNonBlank], baseIndent + 4)
            if len(incName) <= 0:
                continue
            let incCompact: str = cliStripSpaces(lines[lastNonBlank])
            let expectStep: str = cliEndsWith(incCompact, "+1") ? "+" : "-"
            if cliConditionUsesCounter(cond, incName, expectStep):
                add(failures, rel + ":" + IntToStr(lineNo + 1) + ": " + cliTrim(line))
    if failures.len > 0:
        echo("[syntax-policy] counting while loops or removed syntax are not allowed")
        for i in 0..<failures.len:
            echo("[syntax-policy] " + failures[i])
        return false
    echo("[syntax-policy] ok")
    return true

fn cliCheckDocsDrift(ctx: CliContext): bool =
    let requiredDocs: str[] = [
        "docs/module_map.md",
        "docs/feature_matrix.md",
        "docs/mobile_full_p2p.md",
        "docs/满血P2P.md",
        "docs/roadmap.md",
        "docs/connmanager_dump_format.md",
        "docs/backlog.md"
    ]
    var failures: str[]
    for i in 0..<requiredDocs.len:
        let doc: str = cliJoinPath(ctx.repoRoot, requiredDocs[i])
        if !os.fileExists(doc):
            add(failures, "missing required doc: " + requiredDocs[i])
    let readmePath: str = cliJoinPath(ctx.repoRoot, "README.md")
    let backlogPath: str = cliJoinPath(ctx.repoRoot, "docs/backlog.md")
    let refs: str[] = cliExtractDocRefs(os.readFile(readmePath) + "\n" + os.readFile(backlogPath))
    for i in 0..<refs.len:
        if !os.fileExists(cliJoinPath(ctx.repoRoot, refs[i])):
            add(failures, "broken reference: " + refs[i])
    let backlogText: str = os.readFile(backlogPath)
    if !strutil.contains(backlogText, "Source: docs/module_map.md + docs/feature_matrix.md + docs/roadmap.md"):
        add(failures, "backlog source line drifted from module_map/feature_matrix/roadmap")
    let moduleMapText: str = os.readFile(cliJoinPath(ctx.repoRoot, "docs/module_map.md"))
    if !strutil.contains(moduleMapText, "Canonical source of truth: `docs/backlog.md`"):
        add(failures, "docs/module_map.md must point back to docs/backlog.md")
    let featureMatrixText: str = os.readFile(cliJoinPath(ctx.repoRoot, "docs/feature_matrix.md"))
    if !strutil.contains(featureMatrixText, "Canonical source of truth: `docs/backlog.md` + `docs/roadmap.md`"):
        add(failures, "docs/feature_matrix.md must point back to docs/backlog.md + docs/roadmap.md")
    let mobileDocText: str = os.readFile(cliJoinPath(ctx.repoRoot, "docs/mobile_full_p2p.md"))
    if !strutil.contains(mobileDocText, "Canonical design doc: `docs/满血P2P.md`"):
        add(failures, "docs/mobile_full_p2p.md must reference docs/满血P2P.md")
    if failures.len > 0:
        for i in 0..<failures.len:
            echo("[docs-drift] " + failures[i])
        return false
    echo("[docs-drift] ok")
    return true

fn cliCheckScenarioGateMap(ctx: CliContext): bool =
    let mapPath: str = cliJoinPath(ctx.repoRoot, "ci/scenario_gate_map.tsv")
    if !os.fileExists(mapPath):
        echo("[scenario-gate-map] missing map file: " + mapPath)
        return false
    let rows: str[] = cliSplitRawLines(os.readFile(mapPath))
    var seenModes: str[]
    var failures: str[]
    for i in 0..<rows.len:
        let line: str = rows[i]
        let trimmed: str = cliTrim(line)
        if len(trimmed) <= 0 || strings.hasPrefix(trimmed, "#") || strings.hasPrefix(trimmed, "mode\t"):
            continue
        let cols: str[] = strutil.split(line, '\t')
        if cols.len < 4:
            add(failures, "invalid row: " + line)
            continue
        let mode: str = cliTrim(cols[0])
        let kind: str = cliTrim(cols[1])
        let target: str = cliTrim(cols[2])
        let doc: str = cliTrim(cols[3])
        cliAppendUnique(seenModes, mode)
        let expectedKind: str = cliScenarioModeExpectedKind(mode)
        if len(mode) <= 0:
            add(failures, "empty mode entry in scenario map")
            continue
        if len(expectedKind) <= 0:
            add(failures, "mode missing from zero_script_cli: " + mode)
        elif kind != expectedKind:
            add(failures, "kind drift for mode " + mode + ": " + kind + " != " + expectedKind)
        if len(doc) <= 0:
            add(failures, "mode missing doc mapping: " + mode)
        elif !os.fileExists(cliJoinPath(ctx.repoRoot, doc)):
            add(failures, "doc not found for mode " + mode + ": " + doc)
        if kind == "runner":
            if len(target) <= 0:
                add(failures, "runner target missing for mode " + mode)
            elif len(cliResolveEntryPath(ctx.repoRoot, target)) <= 0:
                add(failures, "runner target missing for mode " + mode + ": " + target)
        elif kind == "builtin":
            if target != "mobile-suite":
                add(failures, "builtin target missing from CLI for mode " + mode + ": " + target)
        elif kind == "external":
            if len(target) <= 0:
                add(failures, "external target missing for mode " + mode)
        else:
            add(failures, "invalid kind for mode " + mode + ": " + kind)
    let knownModes: str[] = cliKnownScenarioModes()
    for i in 0..<knownModes.len:
        let mode: str = knownModes[i]
        var seen: bool
        for j in 0..<seenModes.len:
            if seenModes[j] == mode:
                seen = true
                break
        if !seen:
            add(failures, "mode missing from scenario map: " + mode)
    if failures.len > 0:
        for i in 0..<failures.len:
            echo("[scenario-gate-map] " + failures[i])
        return false
    echo("[scenario-gate-map] ok")
    return true

fn cliCollectPlaceholderRunners(root: str, prefix: str): str[] =
    if !os.dirExists(root):
        var empty: str[]
        return empty
    let files: str[] = os.walkDirRec(root)
    var out: str[]
    for i in 0..<files.len:
        let path: str = files[i]
        let base: str = os.extractFilename(path)
        if strings.hasPrefix(base, prefix) && cliEndsWith(base, "_runner.cheng"):
            cliAppendUnique(out, path)
    return out

fn cliCollectNamedFilesIfPresent(root: str, names: str[]): str[] =
    var out: str[]
    for i in 0..<names.len:
        let path: str = cliJoinPath(root, names[i])
        if os.fileExists(path):
            cliAppendUnique(out, path)
    return out

fn cliCheckNoPlaceholderRunner(ctx: CliContext): bool =
    var targets: str[]
    let localVerify: str[] = cliCollectPlaceholderRunners(cliJoinPath(ctx.repoRoot, "src/tests"), "verify")
    for i in 0..<localVerify.len:
        cliAppendUnique(targets, localVerify[i])
    let localFoundation: str[] = cliCollectPlaceholderRunners(cliJoinPath(ctx.repoRoot, "src/tests"), "foundation")
    for i in 0..<localFoundation.len:
        cliAppendUnique(targets, localFoundation[i])
    let quicNames: str[] = ["msquic_verify_runner.cheng", "connection_migration_runner.cheng"]
    let quicRoots: str[] = [
        cliJoinPath(ctx.repoRoot, "../cheng-quic/tests"),
        cliJoinPath(ctx.repoRoot, "../cheng-quic/src/tests"),
        cliJoinPath(os.getEnvDefault("HOME", ""), ".cheng-packages/cheng-quic/tests"),
        cliJoinPath(os.getEnvDefault("HOME", ""), ".cheng-packages/cheng-quic/src/tests")
    ]
    for i in 0..<quicRoots.len:
        let hits: str[] = cliCollectNamedFilesIfPresent(quicRoots[i], quicNames)
        for j in 0..<hits.len:
            cliAppendUnique(targets, hits[j])
    if targets.len <= 0:
        echo("[check_no_placeholder_runner] no runner targets found")
        return false
    var failures: str[]
    let placeholderPatterns: str[] = ["let a: int32 = 7", "if a + b != 11", "if a - b != 3", "if (a * b) != 28"]
    for i in 0..<targets.len:
        let path: str = targets[i]
        let body: str = os.readFile(path)
        if cliContainsAny(body, placeholderPatterns):
            add(failures, "placeholder arithmetic runner: " + path)
        let lines: str[] = cliSplitRawLines(body)
        var hasImport: bool
        for j in 0..<lines.len:
            if strings.hasPrefix(cliTrimLeftSpaces(lines[j]), "import "):
                hasImport = true
                break
        if !hasImport:
            add(failures, "runner has no real imports: " + path)
    if failures.len > 0:
        for i in 0..<failures.len:
            echo("[check_no_placeholder_runner] " + failures[i])
        return false
    echo("[check_no_placeholder_runner] ok")
    return true

fn cliCollectStubMarkerFiles(ctx: CliContext): str[] =
    var out: str[]
    let directFiles: str[] = [
        cliJoinPath(ctx.repoRoot, "src/main.cheng"),
        cliJoinPath(ctx.repoRoot, "src/builders.cheng"),
        cliJoinPath(ctx.repoRoot, "src/switch.cheng")
    ]
    for i in 0..<directFiles.len:
        if os.fileExists(directFiles[i]):
            cliAppendUnique(out, directFiles[i])
    let dirs: str[] = [
        cliJoinPath(ctx.repoRoot, "src/cli"),
        cliJoinPath(ctx.repoRoot, "src/transports"),
        cliJoinPath(ctx.repoRoot, "src/protocols/secure"),
        cliJoinPath(ctx.repoRoot, "src/tests")
    ]
    for i in 0..<dirs.len:
        let dir: str = dirs[i]
        if !os.dirExists(dir):
            continue
        let files: str[] = os.walkDirRec(dir)
        for j in 0..<files.len:
            let path: str = files[j]
            if !cliEndsWith(path, ".cheng"):
                continue
            let rel: str = os.relativePath(path, ctx.repoRoot)
            if strings.hasPrefix(rel, "src/tests/") && !strutil.contains(os.extractFilename(path), "runner"):
                continue
            cliAppendUnique(out, path)
    return out

fn cliCheckStubMarkers(ctx: CliContext): bool =
    let files: str[] = cliCollectStubMarkerFiles(ctx)
    var failures: str[]
    for i in 0..<files.len:
        let path: str = files[i]
        let rel: str = os.relativePath(path, ctx.repoRoot)
        let header: str[] = cliReadFirstLines(path, 5)
        var allow: bool
        for j in 0..<header.len:
            if strutil.contains(header[j], cliStubAllowTag):
                allow = true
                break
        if allow:
            continue
        for j in 0..<header.len:
            let lower: str = cliLower(header[j])
            if strutil.contains(lower, "minimal") || strutil.contains(lower, "stub") || strutil.contains(lower, "placeholder"):
                add(failures, rel + ":" + IntToStr(j + 1) + ":" + cliTrim(header[j]))
    if failures.len > 0:
        for i in 0..<failures.len:
            echo("[stub-markers] production marker forbidden: " + failures[i])
        return false
    echo("[stub-markers] ok")
    return true

fn cliCategorizeProbeLog(raw: str): str =
    if strutil.contains(raw, "driver sanity rejected main-only binary"):
        return "stage0_main_only"
    if strutil.contains(raw, "stage0 driver not found"):
        return "stage0_missing"
    if strutil.contains(raw, "Unable to read imported module: std/"):
        return "pkg_roots_incomplete"
    if strutil.contains(raw, "Undefined symbols for architecture"):
        return "link_undefined_symbols"
    if strutil.contains(raw, "compile failed rc=223") || strutil.contains(raw, "compile failed rc=139") || strutil.contains(raw, "kind=signal"):
        return "stage0_signal"
    if strutil.contains(raw, "ffi_out_ptrs lowering failed"):
        return "ffi_lowering_failure"
    return "compile_probe_failed"

fn cliPrintProbeHint(category: str, toolchainRoot: str) =
    if category == "stage0_main_only":
        echo("  hint: the candidate is not a backendMain-capable driver; prefer a stable release binary or rebuild in " + toolchainRoot)
        return
    if category == "stage0_missing":
        echo("  hint: prepare a canonical driver in " + toolchainRoot + " first, then resync this repo")
        return
    if category == "pkg_roots_incomplete":
        echo("  hint: toolchain root was resolved incorrectly; check CHENG_TOOLCHAIN_ROOT / CHENG_ROOT")
        return
    if category == "link_undefined_symbols":
        echo("  hint: toolchain runtime / driver does not match this repo; rebuild the stable toolchain driver in " + toolchainRoot)
        return
    if category == "stage0_signal":
        echo("  hint: the stage0 candidate crashes during compile; avoid selfhost stage2 and refresh the stable release driver")
        return
    if category == "ffi_lowering_failure":
        echo("  hint: this toolchain cannot lower the current repo probe; fix the toolchain or use a compatible release")
        return
    echo("  hint: inspect the probe log and repair the toolchain-side canonical driver before retrying")

fn cliProbeDriver(ctx: CliContext, canonicalDriver: str, candidate: str, outLog: var str): bool =
    let probeSrc: str = cliProbeSourcePath(ctx)
    if !os.fileExists(probeSrc):
        outLog = "missing probe source: " + probeSrc
        return false
    if !cliCopyExecutableFile(ctx, candidate, canonicalDriver):
        outLog = "failed to sync canonical driver from candidate: " + candidate
        return false
    let preflightRoot: str = cliPreflightDir(ctx)
    let safeLabel: str = cliSanitizeLabel(candidate)
    let outBin: str = cliJoinPath(preflightRoot, "probe_" + safeLabel)
    let logPath: str = cliJoinPath(preflightRoot, "probe_" + safeLabel + ".log")
    cliEnsureDir(ctx, preflightRoot)
    cliRemoveFileIfExists(outBin)
    cliRemoveFileIfExists(logPath)
    let timeoutRaw: str = cliTrim(os.getEnvDefault("TOOLING_COMPILE_TIMEOUT", cliPreflightProbeTimeoutDefault))
    var command: str = "env -u BACKEND_DRIVER -u CHENG_BACKEND_DRIVER "
    command = command + cliEnvAssign("PKG_ROOTS", ctx.pkgRoots)
    command = command + cliEnvAssign("TOOLING_COMPILE_TIMEOUT", timeoutRaw)
    command = command + cliShellQuote(ctx.toolingBin) + " release-compile " + cliShellQuote("--in:" + probeSrc) + " " + cliShellQuote("--out:" + outBin)
    command = command + " > " + cliShellQuote(logPath) + " 2>&1"
    let res: os.ExecCmdResult = cliExec(ctx.repoRoot, command)
    outLog = logPath
    if os.execCmdResultExitCode(res) == 0:
        return true
    return false

fn cliBuildDriverCandidates(ctx: CliContext, canonicalDriver: str): str[] =
    var out: str[]
    if cliFileExecutable(ctx, canonicalDriver):
        cliAppendUnique(out, canonicalDriver)
    let seed: str = cliTrim(os.getEnvDefault("ZERO_SCRIPT_DRIVER_SEED", ""))
    if cliFileExecutable(ctx, seed):
        cliAppendUnique(out, seed)
    let roots: str[] = [
        cliJoinPath(ctx.toolchainRoot, "dist/releases/current/cheng"),
        cliJoinPath(ctx.toolchainRoot, "artifacts/backend_selfhost_self_obj/cheng.stage2"),
        cliJoinPath(ctx.toolchainRoot, "artifacts/backend_selfhost_self_obj/cheng.stage1"),
        cliJoinPath(ctx.toolchainRoot, "artifacts/backend_driver/cheng"),
        cliJoinPath(ctx.toolchainRoot, "cheng")
    ]
    for i in 0..<roots.len:
        if cliFileExecutable(ctx, roots[i]):
            cliAppendUnique(out, roots[i])
    return out

fn cliRunHardGates(ctx: CliContext, targetSubcommand: str): bool =
    if !cliShouldRunHardGates(targetSubcommand):
        return true
    if !cliCheckSyntaxPolicy(ctx):
        return false
    if !cliCheckDocsDrift(ctx):
        return false
    if !cliCheckScenarioGateMap(ctx):
        return false
    if !cliCheckNoPlaceholderRunner(ctx):
        return false
    if !cliCheckStubMarkers(ctx):
        return false
    return true

fn cliRunPreflight(ctx: CliContext, subcommandRaw: str, args: str[], outState: var CliPreflightState, outErr: var str): bool =
    let cfg: CliPreflightConfig = cliBuildPreflightConfig(subcommandRaw, args)
    if !cfg.skipGates && !cliRunHardGates(ctx, cfg.targetSubcommand):
        outErr = "zero-script-cli: hard gate failed"
        return false
    let canonicalDriver: str = cliCanonicalDriverPath(ctx)
    let candidates: str[] = cliBuildDriverCandidates(ctx, canonicalDriver)
    if candidates.len <= 0:
        echo("[zero-script-preflight] no executable driver candidates found")
        echo("  toolchain_root=" + ctx.toolchainRoot)
        echo("  hint: build a stable driver in the toolchain first")
        outErr = "zero-script-cli: no executable driver candidates found"
        return false
    let preflightRoot: str = cliPreflightDir(ctx)
    cliEnsureDir(ctx, preflightRoot)
    let backupPath: str = cliJoinPath(preflightRoot, "canonical_driver.before")
    let hadOriginal: bool = os.fileExists(canonicalDriver)
    if hadOriginal:
        let _backupOk: bool = cliCopyExecutableFile(ctx, canonicalDriver, backupPath)
    else:
        cliRemoveFileIfExists(backupPath)
    var chosenSource: str
    var probeLog: str
    var probeCategory: str = cfg.skipDriverProbe ? "probe_skipped" : ""
    var failures: str[]
    for i in 0..<candidates.len:
        let candidate: str = candidates[i]
        chosenSource = candidate
        if cfg.skipDriverProbe:
            if !cliCopyExecutableFile(ctx, candidate, canonicalDriver):
                add(failures, candidate + "|copy_failed|")
                continue
            break
        if cliProbeDriver(ctx, canonicalDriver, candidate, probeLog):
            probeCategory = "ok"
            break
        let raw: str = os.fileExists(probeLog) ? os.readFile(probeLog) : ""
        probeCategory = cliCategorizeProbeLog(raw)
        add(failures, candidate + "|" + probeCategory + "|" + probeLog)
    if probeCategory != "ok" && probeCategory != "probe_skipped":
        if hadOriginal && os.fileExists(backupPath):
            let _restoreOk: bool = cliCopyExecutableFile(ctx, backupPath, canonicalDriver)
        else:
            cliRemoveFileIfExists(canonicalDriver)
        echo("[zero-script-preflight] canonical driver preflight failed")
        echo("  repo_root=" + ctx.repoRoot)
        echo("  tooling_bin=" + ctx.toolingBin)
        echo("  toolchain_root=" + ctx.toolchainRoot)
        echo("  canonical_driver=" + canonicalDriver)
        for i in 0..<failures.len:
            let cols: str[] = strutil.split(failures[i], '|')
            let failedCandidate: str = cols.len > 0 ? cols[0] : ""
            let failedCategory: str = cols.len > 1 ? cols[1] : "unknown"
            let failedLog: str = cols.len > 2 ? cols[2] : ""
            echo("  candidate=" + failedCandidate + " category=" + failedCategory + " log=" + failedLog)
            cliPrintProbeHint(failedCategory, ctx.toolchainRoot)
        echo("  hint: cd " + ctx.toolchainRoot + " && artifacts/tooling_cmd/cheng_tooling build-backend-driver --require-rebuild")
        outErr = "zero-script-cli: canonical driver preflight failed"
        return false
    outState.canonicalDriver = canonicalDriver
    outState.driverSource = chosenSource
    outState.driverProbeLog = probeLog
    outState.driverProbeCategory = probeCategory
    outState.pkgRoots = ctx.pkgRoots
    outState.toolchainRoot = ctx.toolchainRoot
    outErr = ""
    return true

fn cliPrintPreflightState(ctx: CliContext, state: CliPreflightState, shellEnv: bool) =
    if shellEnv:
        echo("ZERO_SCRIPT_TOOLING_BIN=" + cliShellQuote(ctx.toolingBin))
        echo("ZERO_SCRIPT_TOOLCHAIN_ROOT=" + cliShellQuote(state.toolchainRoot))
        echo("ZERO_SCRIPT_PKG_ROOTS=" + cliShellQuote(state.pkgRoots))
        echo("ZERO_SCRIPT_CANONICAL_DRIVER=" + cliShellQuote(state.canonicalDriver))
        echo("ZERO_SCRIPT_DRIVER_SOURCE=" + cliShellQuote(state.driverSource))
        echo("ZERO_SCRIPT_DRIVER_PROBE_LOG=" + cliShellQuote(state.driverProbeLog))
        echo("ZERO_SCRIPT_DRIVER_PROBE_CATEGORY=" + cliShellQuote(state.driverProbeCategory))
        return
    echo("repo_root=" + ctx.repoRoot)
    echo("tooling_bin=" + ctx.toolingBin)
    echo("toolchain_root=" + state.toolchainRoot)
    echo("pkg_roots=" + state.pkgRoots)
    echo("canonical_driver=" + state.canonicalDriver)
    echo("driver_source=" + state.driverSource)
    echo("driver_probe_category=" + state.driverProbeCategory)
    if len(state.driverProbeLog) > 0:
        echo("driver_probe_log=" + state.driverProbeLog)

fn cliEnsurePreflight(ctx: CliContext, subcommand: str, args: str[]): bool =
    var preflightState: CliPreflightState
    var preflightErr: str
    return cliRunPreflight(ctx, subcommand, args, preflightState, preflightErr)

fn cliNoPtrEnvPrefix(ctx: CliContext, includeRuntimeProbeOff: bool, featureTokens: str): str =
    let skipSem: str = cliTrim(os.getEnvDefault("STAGE1_SKIP_SEM", "0"))
    let schemeId: str = cliTrim(os.getEnvDefault("RAWPTR_CONTRACT_SCHEME_ID", cliDefaultRawptrSchemeId))
    let schemeName: str = cliTrim(os.getEnvDefault("RAWPTR_CONTRACT_SCHEME_NAME", cliDefaultRawptrSchemeName))
    let enforceMode: str = cliTrim(os.getEnvDefault("RAWPTR_CONTRACT_ENFORCE_MODE", cliDefaultRawptrEnforceMode))
    var prefix: str
    prefix = prefix + cliEnvAssign("STAGE1_SKIP_SEM", skipSem)
    prefix = prefix + cliEnvAssign("CHENG_STAGE1_SKIP_SEM", skipSem)
    prefix = prefix + cliEnvAssign("RAWPTR_CONTRACT_SCHEME_ID", schemeId)
    prefix = prefix + cliEnvAssign("CHENG_RAWPTR_CONTRACT_SCHEME_ID", schemeId)
    prefix = prefix + cliEnvAssign("RAWPTR_CONTRACT_SCHEME_NAME", schemeName)
    prefix = prefix + cliEnvAssign("CHENG_RAWPTR_CONTRACT_SCHEME_NAME", schemeName)
    prefix = prefix + cliEnvAssign("RAWPTR_CONTRACT_ENFORCE_MODE", enforceMode)
    prefix = prefix + cliEnvAssign("CHENG_RAWPTR_CONTRACT_ENFORCE_MODE", enforceMode)
    prefix = prefix + cliEnvAssign("PKG_ROOTS", ctx.pkgRoots)
    if includeRuntimeProbeOff:
        prefix = prefix + cliEnvAssign("VERIFY_RUNTIME_PROBE", "0")
    if len(featureTokens) > 0:
        prefix = prefix + cliEnvAssign("CHENG_MOBILE_REQUIRED_FEATURE_TOKENS", featureTokens)
    return prefix

fn cliWrapWithTimeout(ctx: CliContext, timeoutSec: int32, command: str): str =
    if timeoutSec <= 0 || len(command) <= 0:
        return command
    let probeTimeout: os.ExecCmdResult = cliExec(ctx.repoRoot, "command -v timeout >/dev/null 2>&1")
    if os.execCmdResultExitCode(probeTimeout) == 0:
        return "timeout " + IntToStr(timeoutSec) + "s sh -c " + cliShellQuote(command)
    let probeGtimeout: os.ExecCmdResult = cliExec(ctx.repoRoot, "command -v gtimeout >/dev/null 2>&1")
    if os.execCmdResultExitCode(probeGtimeout) == 0:
        return "gtimeout " + IntToStr(timeoutSec) + "s sh -c " + cliShellQuote(command)
    return command

fn cliEnsureDir(ctx: CliContext, path: str): bool =
    let cmd: str = "mkdir -p " + cliShellQuote(path)
    let res: os.ExecCmdResult = cliExec(ctx.repoRoot, cmd)
    return os.execCmdResultExitCode(res) == 0

fn cliWriteText(ctx: CliContext, path: str, body: str): bool =
    let cmd: str = "mkdir -p " + cliShellQuote(os.parentDir(path)) + " ; printf %s " + cliShellQuote(body) + " > " + cliShellQuote(path)
    let res: os.ExecCmdResult = cliExec(ctx.repoRoot, cmd)
    return os.execCmdResultExitCode(res) == 0

fn cliAppendText(ctx: CliContext, path: str, body: str): bool =
    let cmd: str = "mkdir -p " + cliShellQuote(os.parentDir(path)) + " ; printf %s " + cliShellQuote(body) + " >> " + cliShellQuote(path)
    let res: os.ExecCmdResult = cliExec(ctx.repoRoot, cmd)
    return os.execCmdResultExitCode(res) == 0

fn cliOutBinDir(ctx: CliContext): str =
    return cliJoinPath(ctx.repoRoot, "artifacts/zero_script/bin")

fn cliBaseNameWithoutExt(path: str): str =
    let pieces: os.SplitFileResult = os.splitFile(path)
    if len(pieces.name) > 0:
        return pieces.name
    let fallback: str = os.extractFilename(path)
    if len(fallback) > 0:
        return fallback
    return "cheng_cli_out"

fn cliBuildCompileCommand(ctx: CliContext, entry: str, outPath: str, buildTrackRaw: str, jobs: int32): str =
    let buildTrack: str = cliLower(buildTrackRaw)
    let compileCmd: str = buildTrack == "dev" ? "cheng" : "release-compile"
    var command: str = "set -e ; "
    command = command + "mkdir -p " + cliShellQuote(os.parentDir(outPath)) + " ; "
    command = command + cliNoPtrEnvPrefix(ctx, false, "")
    command = command + cliEnvAssign("BACKEND_JOBS", IntToStr(jobs))
    command = command + cliEnvAssign("BACKEND_BUILD_TRACK", buildTrack == "dev" ? "dev" : "release")
    command = command + cliShellQuote(ctx.toolingBin) + " " + compileCmd + " " + cliShellQuote("--in:" + entry) + " " + cliShellQuote("--out:" + outPath)
    return command

fn cliRunCapturedCommand(ctx: CliContext, command: str, timeoutSec: int32, logPath: str, dryRun: bool): int32 =
    let wrapped: str = cliWrapWithTimeout(ctx, timeoutSec, command)
    if dryRun:
        let preview: str = cliPreviewText(wrapped, 1024)
        echo("[dry-run] " + preview)
        if len(logPath) > 0:
            cliWriteText(ctx, logPath, "[dry-run] " + preview + "\n")
        return 0
    let res: os.ExecCmdResult = cliExec(ctx.repoRoot, wrapped)
    let output: str = os.execCmdResultOutput(res)
    if len(logPath) > 0:
        cliWriteText(ctx, logPath, output)
    cliPrintOutput(output)
    return os.execCmdResultExitCode(res)

fn cliBuildRunnerCommand(ctx: CliContext, runner: str, outPath: str, buildTrackRaw: str, jobs: int32): str =
    let compileCmd: str = cliBuildCompileCommand(ctx, runner, outPath, buildTrackRaw, jobs)
    return compileCmd + " ; " + cliShellQuote(outPath)

fn cliRunBackendBuild(ctx: CliContext, args: str[]): int32 =
    if cliHasFlag(args, "--help") || cliHasFlag(args, "-h"):
        echo("Usage: backend-build <entry.cheng> [--name:<binName>] [--target:<triple>] [--jobs:<n>] [--build-track:<dev|release>] [--dry-run]")
        return 0
    let entryRaw: str = cliArgAt(args, 0)
    let entry: str = cliResolveEntryPath(ctx.repoRoot, entryRaw)
    if len(entry) <= 0:
        echo("[backend-build] entry not found: " + entryRaw)
        return 2
    if !cliEnsurePreflight(ctx, "backend-build", args):
        return 1
    var buildTrack: str = cliDefaultBuildTrack
    cliReadLastFlagValue(args, "--build-track", buildTrack)
    var name: str
    cliReadLastFlagValue(args, "--name", name)
    var jobsRaw: str = "1"
    cliReadLastFlagValue(args, "--jobs", jobsRaw)
    let jobs: int32 = cliParseInt32Default(jobsRaw, 1)
    let dryRun: bool = cliHasFlag(args, "--dry-run")
    var outPath: str = name
    if len(outPath) <= 0:
        outPath = cliJoinPath(cliOutBinDir(ctx), cliBaseNameWithoutExt(entry))
    elif !strutil.contains(outPath, "/"):
        outPath = cliJoinPath(cliOutBinDir(ctx), outPath)
    else:
        outPath = cliAbsPath(outPath)
    let command: str = cliBuildCompileCommand(ctx, entry, outPath, buildTrack, jobs)
    let rc: int32 = cliRunCapturedCommand(ctx, command, 0, "", dryRun)
    if rc != 0:
        return rc
    echo("out_path=" + outPath)
    return 0

fn cliRunCStringProbe(ctx: CliContext, args: str[]): int32 =
    if cliHasFlag(args, "--help") || cliHasFlag(args, "-h"):
        echo("Usage: cstring-probe [--entry:<path>] [--name:<binary_name>] [--report:<path>] [--build-log:<path>] [--build-track:<dev|release>] [--dry-run]")
        return 0
    var entryRaw: str = cliJoinPath(ctx.repoRoot, "src/tests/char_index_probe_stage0.cheng")
    cliReadLastFlagValue(args, "--entry", entryRaw)
    let entry: str = cliResolveEntryPath(ctx.repoRoot, entryRaw)
    if len(entry) <= 0:
        echo("[verify_cstring] probe entry not found: " + entryRaw)
        return 2
    if !cliEnsurePreflight(ctx, "cstring-probe", args):
        return 1
    var name: str = "tmp_verify_cstring_probe"
    cliReadLastFlagValue(args, "--name", name)
    var report: str = cliJoinPath(ctx.repoRoot, "artifacts/verify/cstring_materialization.report.txt")
    cliReadLastFlagValue(args, "--report", report)
    var buildLog: str = cliJoinPath(ctx.repoRoot, "artifacts/verify/cstring_materialization.build.log")
    cliReadLastFlagValue(args, "--build-log", buildLog)
    var buildTrack: str = "release"
    cliReadLastFlagValue(args, "--build-track", buildTrack)
    let dryRun: bool = cliHasFlag(args, "--dry-run")
    let binPath: str = cliJoinPath(ctx.repoRoot, name)
    cliEnsureDir(ctx, os.parentDir(report))
    cliEnsureDir(ctx, os.parentDir(buildLog))
    let compileCmd: str = cliBuildCompileCommand(ctx, entry, binPath, buildTrack, 1)
    if dryRun:
        echo("[dry-run] " + compileCmd)
        return 0
    let buildRes: os.ExecCmdResult = cliExec(ctx.repoRoot, compileCmd)
    let buildOutput: str = os.execCmdResultOutput(buildRes)
    cliWriteText(ctx, buildLog, buildOutput)
    cliPrintOutput(buildOutput)
    let buildRc: int32 = os.execCmdResultExitCode(buildRes)
    if buildRc != 0:
        cliWriteText(ctx, report,
            "status: fail\n" +
            "reason: build_failed\n" +
            "build_rc: " + IntToStr(buildRc) + "\n" +
            "entry: " + entry + "\n" +
            "binary: " + binPath + "\n" +
            "build_log: " + buildLog + "\n" +
            "build_track: " + buildTrack + "\n")
        echo("[verify_cstring] build failed (rc=" + IntToStr(buildRc) + ")")
        echo("[verify_cstring] build log: " + buildLog)
        echo("[verify_cstring] report: " + report)
        return buildRc
    if !os.fileExists(binPath):
        cliWriteText(ctx, report,
            "status: fail\n" +
            "reason: binary_missing\n" +
            "build_rc: 0\n" +
            "entry: " + entry + "\n" +
            "binary: " + binPath + "\n" +
            "build_log: " + buildLog + "\n" +
            "build_track: " + buildTrack + "\n")
        echo("[verify_cstring] probe binary missing after build: " + binPath)
        echo("[verify_cstring] report: " + report)
        return 2
    let runCmd: str = cliShellQuote(binPath)
    let runRes: os.ExecCmdResult = cliExec(ctx.repoRoot, runCmd)
    let runRc: int32 = os.execCmdResultExitCode(runRes)
    if runRc != 0:
        cliWriteText(ctx, report,
            "status: fail\n" +
            "reason: runtime_probe_failed\n" +
            "build_rc: 0\n" +
            "run_rc: " + IntToStr(runRc) + "\n" +
            "entry: " + entry + "\n" +
            "binary: " + binPath + "\n" +
            "build_log: " + buildLog + "\n" +
            "build_track: " + buildTrack + "\n")
        echo("[verify_cstring] runtime probe failed (rc=" + IntToStr(runRc) + ")")
        echo("[verify_cstring] build log: " + buildLog)
        echo("[verify_cstring] report: " + report)
        return runRc
    cliWriteText(ctx, report,
        "status: ok\n" +
        "build_rc: 0\n" +
        "run_rc: 0\n" +
        "entry: " + entry + "\n" +
        "binary: " + binPath + "\n" +
        "build_log: " + buildLog + "\n" +
        "build_track: " + buildTrack + "\n" +
        "cstring_lowering_mode: always_on\n")
    echo("[verify_cstring] cstring materialization gate ok")
    echo("[verify_cstring] build log: " + buildLog)
    echo("[verify_cstring] report: " + report)
    return 0

fn cliRunVerifyRunner(ctx: CliContext, runner: str, buildTrack: str, timeoutSec: int32, dryRun: bool): int32 =
    let outPath: str = cliJoinPath(cliOutBinDir(ctx), cliBaseNameWithoutExt(runner))
    let command: str = cliBuildRunnerCommand(ctx, runner, outPath, buildTrack, 1)
    let rc: int32 = cliRunCapturedCommand(ctx, command, timeoutSec, "", dryRun)
    if rc != 0:
        echo("[verify] fail")
        return rc
    echo("[verify] ok")
    return 0

fn cliRunVerify(ctx: CliContext, args: str[]): int32 =
    if cliHasFlag(args, "--help") || cliHasFlag(args, "-h"):
        echo("Usage: verify [--mode:<backend_smoke|test|smoke|mobile|bootstrap|synccast|synccast_closedloop|depin_orderbook|depin_inference|msquic|quic>] [--profile:<stable|full>] [--runner:<path>] [--build-track:<dev|release>] [--dry-run]")
        return 0
    var mode: str = "backend_smoke"
    cliReadLastFlagValue(args, "--mode", mode)
    var profile: str = cliDefaultProfile
    cliReadLastFlagValue(args, "--profile", profile)
    var buildTrack: str = cliDefaultBuildTrack
    cliReadLastFlagValue(args, "--build-track", buildTrack)
    var runnerRaw: str
    cliReadLastFlagValue(args, "--runner", runnerRaw)
    let dryRun: bool = cliHasFlag(args, "--dry-run")
    let normalizedMode: str = cliLower(mode)
    if normalizedMode == "mobile":
        var mobileArgs: str[]
        add(mobileArgs, "--profile:" + profile)
        if dryRun:
            add(mobileArgs, "--dry-run")
        return cliRunMobileSuite(ctx, mobileArgs)
    let hasExplicitRunner: bool = len(cliTrim(runnerRaw)) > 0
    var runner: str = cliResolveEntryPath(ctx.repoRoot, runnerRaw)
    if hasExplicitRunner && len(runner) <= 0:
        echo("[verify] runner not found: " + runnerRaw)
        return 2
    if !hasExplicitRunner && len(runner) <= 0:
        runner = cliDefaultRunnerForMode(ctx.repoRoot, normalizedMode)
    if len(runner) <= 0:
        if normalizedMode == "test":
            echo("[verify] missing --runner for mode:test")
        else:
            echo("[verify] runner not found for mode: " + normalizedMode)
        return 2
    if !cliEnsurePreflight(ctx, "verify", args):
        return 1
    return cliRunVerifyRunner(ctx, runner, buildTrack, 0, dryRun)

fn cliDetectMobileRoots(ctx: var CliContext, platformList: str[], outErr: var str): bool =
    let home: str = cliTrim(os.getEnvDefault("HOME", ""))
    if len(ctx.mobileRoot) <= 0:
        let explicit: str = cliTrim(os.getEnvDefault("CHENG_MOBILE_ROOT", ""))
        if len(explicit) > 0 && os.dirExists(explicit):
            ctx.mobileRoot = cliAbsPath(explicit)
        else:
            let candidates: str[] = [
                home + "/.cheng-packages/cheng-mobile/src",
                cliJoinPath(ctx.repoRoot, "../cheng-mobile/src"),
                home + "/cheng-mobile/src",
                home + "/.cheng/toolchain/cheng-mobile/src"
            ]
            for i in 0..<candidates.len:
                let cand: str = candidates[i]
                if os.dirExists(cliJoinPath(cand, "android/project_template")) && os.dirExists(cliJoinPath(cand, "harmony")):
                    ctx.mobileRoot = cliAbsPath(cand)
                    break
    if len(ctx.mobileRoot) <= 0:
        outErr = "mobile root missing; set CHENG_MOBILE_ROOT"
        return false

    var needHarmony: bool
    for i in 0..<platformList.len:
        if platformList[i] == "harmony":
            needHarmony = true
    if !needHarmony:
        outErr = ""
        return true

    let explicitTemplate: str = cliTrim(os.getEnvDefault("CHENG_HARMONY_TEMPLATE_ROOT", ""))
    if len(explicitTemplate) > 0 && os.fileExists(cliJoinPath(explicitTemplate, "entry/src/main/cpp/CMakeLists.txt")):
        ctx.harmonyTemplateRoot = cliAbsPath(explicitTemplate)
    else:
        let candidatesA: str[] = [
            home + "/.cheng-packages/cheng-gui/src/build/harmony_napi_hap_test",
            home + "/cheng-gui/src/build/harmony_napi_hap_test"
        ]
        for i in 0..<candidatesA.len:
            let cand: str = candidatesA[i]
            if os.fileExists(cliJoinPath(cand, "entry/src/main/cpp/CMakeLists.txt")):
                ctx.harmonyTemplateRoot = cliAbsPath(cand)
                break
    if len(ctx.harmonyTemplateRoot) <= 0:
        outErr = "Harmony template root missing; set CHENG_HARMONY_TEMPLATE_ROOT"
        return false

    let explicitSign: str = cliTrim(os.getEnvDefault("CHENG_HARMONY_SIGN_PROJECT", ""))
    if len(explicitSign) > 0 && os.fileExists(cliJoinPath(explicitSign, "build-profile.json5")) && os.fileExists(cliJoinPath(explicitSign, "AppScope/app.json5")):
        ctx.harmonySignSource = cliAbsPath(explicitSign)
    else:
        let candidatesB: str[] = [
            home + "/UniMaker/hongmeng",
            home + "/DevEcoStudioProjects/UniMaker"
        ]
        for i in 0..<candidatesB.len:
            let cand: str = candidatesB[i]
            if os.fileExists(cliJoinPath(cand, "build-profile.json5")) && os.fileExists(cliJoinPath(cand, "AppScope/app.json5")):
                ctx.harmonySignSource = cliAbsPath(cand)
                break
    if len(ctx.harmonySignSource) <= 0:
        outErr = "Harmony signing source project missing; set CHENG_HARMONY_SIGN_PROJECT"
        return false

    ctx.harmonyNodeBin = cliTrim(os.getEnvDefault("CHENG_HARMONY_NODE_BIN", "/Applications/DevEco-Studio.app/Contents/tools/node/bin/node"))
    ctx.harmonyHvigorJs = cliTrim(os.getEnvDefault("CHENG_HARMONY_HVIGOR_JS", "/Applications/DevEco-Studio.app/Contents/tools/hvigor/bin/hvigorw.js"))
    ctx.harmonyExportsC = cliTrim(os.getEnvDefault("CHENG_HARMONY_EXPORTS_C", cliJoinPath(ctx.toolchainRoot, "src/runtime/mobile/cheng_mobile_exports.c")))
    ctx.harmonyExportsH = cliTrim(os.getEnvDefault("CHENG_HARMONY_EXPORTS_H", cliJoinPath(ctx.toolchainRoot, "src/runtime/mobile/cheng_mobile_exports.h")))
    if !os.fileExists(ctx.harmonyNodeBin) || !os.fileExists(ctx.harmonyHvigorJs):
        outErr = "Harmony toolchain entrypoints missing; set CHENG_HARMONY_NODE_BIN / CHENG_HARMONY_HVIGOR_JS"
        return false
    if !os.fileExists(ctx.harmonyExportsC) || !os.fileExists(ctx.harmonyExportsH):
        outErr = "Harmony runtime export sources missing under toolchain root"
        return false
    outErr = ""
    return true

fn cliNormalizePlatforms(raw: str, out: var str[], outErr: var str): bool =
    out = []
    let items: str[] = strutil.split(raw, ',')
    for i in 0..<items.len:
        let item: str = cliLower(items[i])
        if len(item) <= 0:
            continue
        if item != "android" && item != "ios" && item != "harmony":
            outErr = "invalid platform: " + item
            return false
        var exists: bool
        for j in 0..<out.len:
            if out[j] == item:
                exists = true
                break
        if !exists:
            add(out, item)
    if out.len <= 0:
        outErr = "empty platform set"
        return false
    outErr = ""
    return true

fn cliNormalizeTokens(raw: str): str[] =
    var out: str[]
    let items: str[] = strutil.split(raw, ',')
    for i in 0..<items.len:
        let item: str = cliTrim(items[i])
        if len(item) <= 0:
            continue
        var exists: bool
        for j in 0..<out.len:
            if out[j] == item:
                exists = true
                break
        if !exists:
            add(out, item)
    return out

fn cliAndroidDeviceSerial(ctx: CliContext): str =
    let explicit: str = cliTrim(os.getEnvDefault("ANDROID_SERIAL", ""))
    if len(explicit) > 0:
        return explicit
    let probe: os.ExecCmdResult = cliExec(ctx.repoRoot, "adb devices | awk 'NR>1 && $2 == \"device\" {print $1; exit}'")
    if os.execCmdResultExitCode(probe) != 0:
        return ""
    return cliTrim(os.execCmdResultOutput(probe))

fn cliAndroidSdkRoot(): str =
    let envA: str = cliTrim(os.getEnvDefault("ANDROID_SDK_ROOT", os.getEnvDefault("ANDROID_HOME", "")))
    if len(envA) > 0 && os.dirExists(envA):
        return cliAbsPath(envA)
    let home: str = cliTrim(os.getEnvDefault("HOME", ""))
    let candA: str = home + "/Library/Android/sdk"
    if os.dirExists(candA):
        return cliAbsPath(candA)
    let candB: str = home + "/Android/Sdk"
    if os.dirExists(candB):
        return cliAbsPath(candB)
    return ""

fn cliBuildMobileExportPrefix(ctx: CliContext, featureTokens: str): str =
    return cliNoPtrEnvPrefix(ctx, false, featureTokens)

fn cliBuildAndroidDirectCommand(ctx: CliContext, entry: str, outDir: str, outCmd: var str, outErr: var str): bool =
    let sdk: str = cliAndroidSdkRoot()
    if len(sdk) <= 0:
        outErr = "missing Android SDK (set ANDROID_SDK_ROOT or ANDROID_HOME)"
        return false
    let serial: str = cliAndroidDeviceSerial(ctx)
    if len(serial) <= 0:
        outErr = "no Android device detected (adb devices)"
        return false
    let exportOut: str = cliJoinPath(outDir, "android_export")
    let project: str = cliJoinPath(exportOut, "android_project")
    let apk: str = cliJoinPath(project, "app/build/outputs/apk/debug/app-debug.apk")
    let prefix: str = cliBuildMobileExportPrefix(ctx, "")
    var cmd: str = "set -e ; "
    cmd = cmd + "rm -rf " + cliShellQuote(exportOut) + " ; "
    cmd = cmd + prefix + cliShellQuote(ctx.toolingBin) + " build_mobile_export " + cliShellQuote(entry) + " " + cliShellQuote("--mobile-root:" + ctx.mobileRoot) + " --with-android-project " + cliShellQuote("--out:" + exportOut) + " ; "
    cmd = cmd + prefix + cliShellQuote(ctx.toolingBin) + " verify_android_kotlin_only " + cliShellQuote("--project:" + project) + " ; "
    cmd = cmd + "printf 'sdk.dir=%s\\n' " + cliShellQuote(sdk) + " > " + cliShellQuote(cliJoinPath(project, "local.properties")) + " ; "
    cmd = cmd + "cd " + cliShellQuote(project) + " && ./gradlew --no-daemon assembleDebug ; "
    cmd = cmd + "adb -s " + cliShellQuote(serial) + " install -r " + cliShellQuote(apk) + " ; "
    cmd = cmd + "adb -s " + cliShellQuote(serial) + " shell am force-stop com.cheng.mobile >/dev/null 2>&1 || true ; "
    cmd = cmd + "adb -s " + cliShellQuote(serial) + " shell am start -n com.cheng.mobile/.ChengActivity ; "
    cmd = cmd + "echo mobile_run_android ok"
    outCmd = cmd
    outErr = ""
    return true

fn cliBuildHarmonyDirectCommand(ctx: CliContext, entry: str, outDir: str, outCmd: var str, outErr: var str): bool =
    let exportOut: str = cliJoinPath(outDir, "harmony_export")
    let project: str = cliJoinPath(outDir, "harmony_project")
    let prefix: str = cliBuildMobileExportPrefix(ctx, "")
    var cmd: str = "set -e ; "
    cmd = cmd + "rm -rf " + cliShellQuote(exportOut) + " " + cliShellQuote(project) + " ; "
    cmd = cmd + prefix + cliShellQuote(ctx.toolingBin) + " build_mobile_export " + cliShellQuote(entry) + " " + cliShellQuote("--mobile-root:" + ctx.mobileRoot) + " --with-harmony-project " + cliShellQuote("--out:" + exportOut) + " ; "
    cmd = cmd + "cp -R " + cliShellQuote(ctx.harmonyTemplateRoot) + " " + cliShellQuote(project) + " ; "
    cmd = cmd + "cp " + cliShellQuote(cliJoinPath(ctx.harmonySignSource, "build-profile.json5")) + " " + cliShellQuote(cliJoinPath(project, "build-profile.json5")) + " ; "
    cmd = cmd + "mkdir -p " + cliShellQuote(cliJoinPath(project, "AppScope")) + " " + cliShellQuote(cliJoinPath(project, "entry/src/main/cpp/cheng")) + " ; "
    cmd = cmd + "cp " + cliShellQuote(cliJoinPath(ctx.harmonySignSource, "AppScope/app.json5")) + " " + cliShellQuote(cliJoinPath(project, "AppScope/app.json5")) + " ; "
    cmd = cmd + "rm -rf " + cliShellQuote(cliJoinPath(project, ".hvigor")) + " " + cliShellQuote(cliJoinPath(project, "entry/build")) + " ; "
    cmd = cmd + "cp " + cliShellQuote(cliJoinPath(exportOut, "harmony_project")) + "/*.c " + cliShellQuote(cliJoinPath(project, "entry/src/main/cpp/cheng/")) + " ; "
    cmd = cmd + "cp " + cliShellQuote(cliJoinPath(exportOut, "harmony_project")) + "/*.h " + cliShellQuote(cliJoinPath(project, "entry/src/main/cpp/cheng/")) + " ; "
    cmd = cmd + "cp " + cliShellQuote(cliJoinPath(exportOut, "harmony_project/native/cheng_mobile_harmony_napi.c")) + " " + cliShellQuote(cliJoinPath(project, "entry/src/main/cpp/cheng/")) + " ; "
    cmd = cmd + "cp " + cliShellQuote(ctx.harmonyExportsC) + " " + cliShellQuote(cliJoinPath(project, "entry/src/main/cpp/cheng/cheng_mobile_exports.c")) + " ; "
    cmd = cmd + "cp " + cliShellQuote(ctx.harmonyExportsH) + " " + cliShellQuote(cliJoinPath(project, "entry/src/main/cpp/cheng/cheng_mobile_exports.h")) + " ; "
    cmd = cmd + "cp " + cliShellQuote(cliJoinPath(exportOut, "harmony_project/example/Index.ets")) + " " + cliShellQuote(cliJoinPath(project, "entry/src/main/ets/pages/Index.ets")) + " ; "
    cmd = cmd + "cd " + cliShellQuote(project) + " && " + cliShellQuote(ctx.harmonyNodeBin) + " " + cliShellQuote(ctx.harmonyHvigorJs) + " assembleHap -p module=entry -p product=default -p buildMode=debug --no-daemon --no-parallel --no-incremental ; "
    cmd = cmd + "__hap=$(find " + cliShellQuote(cliJoinPath(project, "entry/build")) + " -name 'entry-default-signed.hap' | head -n 1) ; "
    cmd = cmd + "if [ -z \"$__hap\" ]; then __hap=$(find " + cliShellQuote(cliJoinPath(project, "entry/build")) + " -name 'entry-default-unsigned.hap' | head -n 1) ; fi ; "
    cmd = cmd + "if [ -z \"$__hap\" ]; then echo '[run-harmony] hap not found under entry/build' >&2 ; exit 1 ; fi ; "
    cmd = cmd + "__bundle=$(sed -n 's/.*\"bundleName\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' " + cliShellQuote(cliJoinPath(project, "AppScope/app.json5")) + " | head -n 1) ; "
    cmd = cmd + "if [ -z \"$__bundle\" ]; then echo '[run-harmony] failed to resolve bundleName' >&2 ; exit 1 ; fi ; "
    cmd = cmd + "hdc install -r \"$__hap\" ; "
    cmd = cmd + "hdc shell aa force-stop \"$__bundle\" >/dev/null 2>&1 || true ; "
    cmd = cmd + "hdc shell aa start -a EntryAbility -b \"$__bundle\" ; "
    cmd = cmd + "echo mobile_run_harmony ok"
    outCmd = cmd
    outErr = ""
    return true

fn cliBuildEmbeddedMobileRunnerCommand(ctx: CliContext, platform: str, entry: str, featureTokens: str): str =
    let prefix: str = cliNoPtrEnvPrefix(ctx, false, featureTokens)
    return prefix + cliShellQuote(ctx.toolingBin) + " mobile_run_" + platform + " " + cliShellQuote(entry)

fn cliLogContainsFile(logPath: str, token: str): bool =
    if !os.fileExists(logPath):
        return false
    let raw: str = os.readFile(logPath)
    return strutil.contains(raw, token)

fn cliRequireFeatureTokens(logPath: str, tokens: str[]): bool =
    if tokens.len <= 0:
        return true
    let raw: str = os.readFile(logPath)
    for i in 0..<tokens.len:
        if !strutil.contains(raw, tokens[i]):
            return false
    return true

fn cliAppendLine(ctx: CliContext, path: str, line: str) =
    cliAppendText(ctx, path, line + "\n")

fn cliAppendPlannedCase(ctx: CliContext, resultsPath: str, diagPath: str, name: str, ok: bool, detail: str) =
    let status: str = ok ? "PASS" : "FAIL"
    let rc: str = ok ? "0" : "1"
    let category: str = ok ? "pass" : "case_failed_unknown"
    cliAppendLine(ctx, resultsPath, name + "\t" + status + "\t" + rc + "\t[dry-run]")
    cliAppendLine(ctx, diagPath, name + "\t" + status + "\t" + rc + "\t" + category + "\t" + detail + "\t[dry-run]")

fn cliMobileCaseCategory(logPath: str, status: str, rc: int32): str =
    if status == "PASS":
        return "pass"
    if status == "TIMEOUT" || rc == 124:
        return "timeout"
    let raw: str = os.fileExists(logPath) ? os.readFile(logPath) : ""
    let compileOnlyPats: str[] = ["compile-only result is forbidden", "ok (compile-only)", "compile probe disabled"]
    if cliContainsAny(raw, compileOnlyPats):
        return "runtime_probe_rejected_compile_only"
    let cstringPats: str[] = ["cstring materialization preflight failed", "[verify_cstring] runtime probe failed"]
    if cliContainsAny(raw, cstringPats):
        return "cstring_materialization_failure"
    let rawptrPats: str[] = ["std policy: pointer types are forbidden in standard library", "ZRPC: zero_rawptr_production_closure"]
    if cliContainsAny(raw, rawptrPats):
        return "zero_rawptr_policy_violation"
    let segvPats: str[] = ["Segmentation fault", "Abort trap: 6"]
    if cliContainsAny(raw, segvPats):
        return "backend_driver_segfault"
    let semanticPats: str[] = ["mir_builder: stage1 errors", "unresolved call target", "duplicate function name", "Unable to read imported module"]
    if cliContainsAny(raw, semanticPats):
        return "backend_driver_stage2_semantic_error"
    let gatePats: str[] = ["missing runner success token", "missing feature token"]
    if cliContainsAny(raw, gatePats):
        return "device_matrix_gate_failed"
    return "case_failed_unknown"

fn cliRunSuiteCase(ctx: CliContext, name: str, command: str, timeoutSec: int32, resultsPath: str, diagPath: str, dryRun: bool): int32 =
    let logPath: str = cliJoinPath(os.parentDir(resultsPath), name + ".log")
    let rc: int32 = cliRunCapturedCommand(ctx, command, timeoutSec, logPath, dryRun)
    var status: str = "PASS"
    if rc == 124:
        status = "TIMEOUT"
    elif rc != 0:
        status = "FAIL"
    cliAppendLine(ctx, resultsPath, name + "\t" + status + "\t" + IntToStr(rc) + "\t" + logPath)
    let category: str = cliMobileCaseCategory(logPath, status, rc)
    let detail: str = status == "PASS" ? "ok" : "see log"
    cliAppendLine(ctx, diagPath, name + "\t" + status + "\t" + IntToStr(rc) + "\t" + category + "\t" + detail + "\t" + logPath)
    return rc

fn cliRunHostGate(ctx: CliContext, entry: str, logPath: str, featureTokens: str, dryRun: bool): int32 =
    let outPath: str = cliJoinPath(cliOutBinDir(ctx), cliBaseNameWithoutExt(entry) + "_host_gate")
    var command: str = cliBuildCompileCommand(ctx, entry, outPath, cliDefaultBuildTrack, 1)
    command = command + " ; " + cliNoPtrEnvPrefix(ctx, true, featureTokens) + cliShellQuote(outPath)
    return cliRunCapturedCommand(ctx, command, cliDefaultMobileTimeoutLanFullstack, logPath, dryRun)

fn cliRunDeviceMatrix(ctxInput: CliContext, args: str[]): int32 =
    if cliHasFlag(args, "--help") || cliHasFlag(args, "-h"):
        echo("Usage: device-matrix [--profile:<stable|full>] [--entry:<path>] [--timeout:<seconds>] [--platforms:<csv>] [--feature-tokens:<csv>] [--out-dir:<path>] [--dry-run]")
        return 0
    var ctx: CliContext
    cliCopyContext(ctx, ctxInput)
    var entryRaw: str = cliJoinPath(ctx.repoRoot, "src/tests/mobile_device_fullstack_hard_gate_runner.cheng")
    cliReadLastFlagValue(args, "--entry", entryRaw)
    let entry: str = cliResolveEntryPath(ctx.repoRoot, entryRaw)
    if len(entry) <= 0:
        echo("[mobile-matrix] entry not found: " + entryRaw)
        return 2
    if !cliEnsurePreflight(ctx, "device-matrix", args):
        return 1
    var timeoutRaw: str = IntToStr(cliDefaultMobileTimeoutDeviceMatrix)
    cliReadLastFlagValue(args, "--timeout", timeoutRaw)
    let timeoutSec: int32 = cliParseInt32Default(timeoutRaw, cliDefaultMobileTimeoutDeviceMatrix)
    var platformsRaw: str = cliDefaultMobilePlatforms
    cliReadLastFlagValue(args, "--platforms", platformsRaw)
    let dryRun: bool = cliHasFlag(args, "--dry-run")
    var outDir: str
    cliReadLastFlagValue(args, "--out-dir", outDir)
    if len(outDir) <= 0:
        outDir = cliJoinPath(ctx.repoRoot, "artifacts/mobile_devices/" + cliTimestamp(ctx.repoRoot))
    cliEnsureDir(ctx, outDir)
    let summary: str = cliJoinPath(outDir, "summary.txt")
    let results: str = cliJoinPath(outDir, "results.tsv")
    let diag: str = cliJoinPath(outDir, "diagnosis.tsv")
    cliWriteText(ctx, results, "platform\tstatus\trc\tlog\n")
    cliWriteText(ctx, diag, "platform\tstatus\trc\tcategory\tdetail\tlog\n")
    if dryRun:
        cliAppendLine(ctx, results, platformsRaw + "\tPASS\t0\t[dry-run]")
        cliAppendLine(ctx, diag, platformsRaw + "\tPASS\t0\tpass\tdry-run\t[dry-run]")
        cliWriteText(ctx, summary,
            "entry: " + entry + "\n" +
            "mode: dry-run\n" +
            "platforms: " + platformsRaw + "\n" +
            "timeout: " + IntToStr(timeoutSec) + "\n" +
            "pass: 1\n" +
            "fail: 0\n" +
            "timeout_count: 0\n")
        cliPrintOutput(os.readFile(summary))
        cliPrintOutput(os.readFile(results))
        cliPrintOutput(os.readFile(diag))
        return 0
    var platforms: str[]
    var platformsErr: str
    if !cliNormalizePlatforms(platformsRaw, platforms, platformsErr):
        echo("[mobile-matrix] " + platformsErr)
        return 2
    var featureTokensRaw: str = cliDefaultFeatureTokens
    cliReadLastFlagValue(args, "--feature-tokens", featureTokensRaw)
    let featureTokens: str[] = cliNormalizeTokens(featureTokensRaw)
    var rootsErr: str
    if !cliDetectMobileRoots(ctx, platforms, rootsErr):
        echo("[mobile-matrix] " + rootsErr)
        return 1
    let hostGateLog: str = cliJoinPath(outDir, "host_gate.log")
    let hostGateRc: int32 = cliRunHostGate(ctx, entry, hostGateLog, featureTokensRaw, dryRun)
    for i in 0..<platforms.len:
        let platform: str = platforms[i]
        let logPath: str = cliJoinPath(outDir, platform + ".log")
        var rc: int32 = hostGateRc
        if rc == 0:
            var command: str
            var commandErr: str
            var hasCommand: bool
            if platform == "android":
                hasCommand = cliBuildAndroidDirectCommand(ctx, entry, outDir, command, commandErr)
            elif platform == "harmony":
                hasCommand = cliBuildHarmonyDirectCommand(ctx, entry, outDir, command, commandErr)
            else:
                command = cliBuildEmbeddedMobileRunnerCommand(ctx, platform, entry, featureTokensRaw)
                hasCommand = true
            if !hasCommand:
                cliWriteText(ctx, logPath, commandErr + "\n")
                rc = 2
            else:
                rc = cliRunCapturedCommand(ctx, command, timeoutSec, logPath, dryRun)
                let successToken: str = platform == "android" ? "mobile_run_android ok" : (platform == "harmony" ? "mobile_run_harmony ok" : "mobile_run_ios ok")
                if rc == 0 && !dryRun:
                    if !cliLogContainsFile(logPath, successToken):
                        rc = 3
                        cliAppendLine(ctx, logPath, "missing runner success token")
                    elif !cliRequireFeatureTokens(logPath, featureTokens):
                        rc = 3
                        cliAppendLine(ctx, logPath, "missing feature token")
        else:
            if !os.fileExists(logPath):
                if os.fileExists(hostGateLog):
                    cliWriteText(ctx, logPath, os.readFile(hostGateLog))
                else:
                    cliWriteText(ctx, logPath, "host gate failed\n")
        var status: str = "PASS"
        if rc == 124:
            status = "TIMEOUT"
        elif rc != 0:
            status = "FAIL"
        cliAppendLine(ctx, results, platform + "\t" + status + "\t" + IntToStr(rc) + "\t" + logPath)
        let category: str = cliMobileCaseCategory(logPath, status, rc)
        cliAppendLine(ctx, diag, platform + "\t" + status + "\t" + IntToStr(rc) + "\t" + category + "\tsee log\t" + logPath)
    let resultBody: str = os.readFile(results)
    let rows: str[] = cliSplitLines(resultBody)
    var passCount: int32
    var failCount: int32
    var timeoutCount: int32
    for i in 0..<rows.len:
        if i == 0:
            continue
        let cols: str[] = strutil.split(rows[i], '\t')
        if cols.len < 4:
            continue
        if cols[1] == "PASS":
            passCount = passCount + 1
        elif cols[1] == "FAIL":
            failCount = failCount + 1
        elif cols[1] == "TIMEOUT":
            timeoutCount = timeoutCount + 1
    cliWriteText(ctx, summary,
        "entry: " + entry + "\n" +
        "mobile_root: " + ctx.mobileRoot + "\n" +
        "host_gate_log: " + hostGateLog + "\n" +
        "host_gate_status: " + IntToStr(hostGateRc) + "\n" +
        "pass: " + IntToStr(passCount) + "\n" +
        "fail: " + IntToStr(failCount) + "\n" +
        "timeout: " + IntToStr(timeoutCount) + "\n")
    cliPrintOutput(os.readFile(summary))
    cliPrintOutput(os.readFile(results))
    cliPrintOutput(os.readFile(diag))
    if failCount != 0 || timeoutCount != 0:
        return 1
    return 0

fn cliRunMobileSuite(ctxInput: CliContext, args: str[]): int32 =
    if cliHasFlag(args, "--help") || cliHasFlag(args, "-h"):
        echo("Usage: mobile-suite [--profile:<stable|full>] [--out-dir:<path>] [--dry-run]")
        return 0
    var ctx: CliContext
    cliCopyContext(ctx, ctxInput)
    var outDir: str
    cliReadLastFlagValue(args, "--out-dir", outDir)
    if len(outDir) <= 0:
        outDir = cliJoinPath(ctx.repoRoot, "artifacts/mobile_suite/" + cliTimestamp(ctx.repoRoot))
    let dryRun: bool = cliHasFlag(args, "--dry-run")
    if !cliEnsurePreflight(ctx, "mobile-suite", args):
        return 1
    cliEnsureDir(ctx, outDir)
    let summary: str = cliJoinPath(outDir, "summary.txt")
    let results: str = cliJoinPath(outDir, "results.tsv")
    let diag: str = cliJoinPath(outDir, "diagnosis.tsv")
    let cstringReport: str = cliJoinPath(outDir, "cstring_materialization.report.txt")
    let cstringBuildLog: str = cliJoinPath(outDir, "cstring_materialization.build.log")
    cliWriteText(ctx, results, "case\tstatus\trc\tlog\n")
    cliWriteText(ctx, diag, "case\tstatus\trc\tcategory\tdetail\tlog\n")
    var cstringArgs: str[]
    add(cstringArgs, "--report:" + cstringReport)
    add(cstringArgs, "--build-log:" + cstringBuildLog)
    add(cstringArgs, "--skip-driver-probe")
    add(cstringArgs, "--skip-gates")
    if dryRun:
        add(cstringArgs, "--dry-run")
    let cstringRc: int32 = cliRunCStringProbe(ctx, cstringArgs)
    if cstringRc != 0:
        cliAppendLine(ctx, results, "cstring_preflight\tFAIL\t" + IntToStr(cstringRc) + "\t" + cstringBuildLog)
        cliAppendLine(ctx, diag, "cstring_preflight\tFAIL\t" + IntToStr(cstringRc) + "\tcstring_materialization_failure\tsee log\t" + cstringBuildLog)
        return cstringRc
    if dryRun:
        var passCountDry: int32 = 1
        var failCountDry: int32
        cliAppendPlannedCase(ctx, results, diag, "cstring_preflight", true, "dry-run")
        let case1Entry: str = cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_multiaddr_nearfield_smoke.cheng")
        cliAppendPlannedCase(ctx, results, diag, "mobile_multiaddr_nearfield_smoke", len(case1Entry) > 0, "dry-run")
        if len(case1Entry) > 0:
            passCountDry = passCountDry + 1
        else:
            failCountDry = failCountDry + 1
        let case2Entry: str = cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_hw_transport_smoke.cheng")
        cliAppendPlannedCase(ctx, results, diag, "mobile_hw_transport_smoke", len(case2Entry) > 0, "dry-run")
        if len(case2Entry) > 0:
            passCountDry = passCountDry + 1
        else:
            failCountDry = failCountDry + 1
        let case3Entry: str = cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_ble_discovery_smoke.cheng")
        cliAppendPlannedCase(ctx, results, diag, "mobile_ble_discovery_smoke", len(case3Entry) > 0, "dry-run")
        if len(case3Entry) > 0:
            passCountDry = passCountDry + 1
        else:
            failCountDry = failCountDry + 1
        let case4Entry: str = cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_push_to_punch_smoke.cheng")
        cliAppendPlannedCase(ctx, results, diag, "mobile_push_to_punch_smoke", len(case4Entry) > 0, "dry-run")
        if len(case4Entry) > 0:
            passCountDry = passCountDry + 1
        else:
            failCountDry = failCountDry + 1
        let case5Entry: str = cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_ffi_fullstart_real_smoke.cheng")
        cliAppendPlannedCase(ctx, results, diag, "mobile_ffi_fullstart_real_smoke", len(case5Entry) > 0, "dry-run")
        if len(case5Entry) > 0:
            passCountDry = passCountDry + 1
        else:
            failCountDry = failCountDry + 1
        let case6Entry: str = cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_ffi_bootstrap_discovery_real_smoke.cheng")
        cliAppendPlannedCase(ctx, results, diag, "mobile_ffi_bootstrap_discovery_real_smoke", len(case6Entry) > 0, "dry-run")
        if len(case6Entry) > 0:
            passCountDry = passCountDry + 1
        else:
            failCountDry = failCountDry + 1
        let case7Entry: str = cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_device_fullstack_hard_gate_runner.cheng")
        cliAppendPlannedCase(ctx, results, diag, "mobile_device_fullstack_hard_gate_runner", len(case7Entry) > 0, "dry-run")
        if len(case7Entry) > 0:
            passCountDry = passCountDry + 1
        else:
            failCountDry = failCountDry + 1
        let quicRunner: str = cliDefaultRunnerForMode(ctx.repoRoot, "msquic")
        cliAppendPlannedCase(ctx, results, diag, "cheng_quic_msquic", len(quicRunner) > 0, "dry-run")
        if len(quicRunner) > 0:
            passCountDry = passCountDry + 1
        else:
            failCountDry = failCountDry + 1
        cliAppendPlannedCase(ctx, results, diag, "mobile_device_matrix", true, "dry-run")
        passCountDry = passCountDry + 1
        cliWriteText(ctx, summary,
            "total: 10\n" +
            "pass: " + IntToStr(passCountDry) + "\n" +
            "fail: " + IntToStr(failCountDry) + "\n" +
            "timeout: 0\n" +
            "mode: dry-run\n" +
            "cstring_preflight_report: " + cstringReport + "\n" +
            "cstring_preflight_build_log: " + cstringBuildLog + "\n")
        cliPrintOutput(os.readFile(summary))
        cliPrintOutput(os.readFile(results))
        cliPrintOutput(os.readFile(diag))
        return 0
    let case1: str = cliBuildRunnerCommand(ctx, cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_multiaddr_nearfield_smoke.cheng"), cliJoinPath(cliOutBinDir(ctx), "mobile_multiaddr_nearfield_smoke"), cliDefaultBuildTrack, 1)
    cliRunSuiteCase(ctx, "mobile_multiaddr_nearfield_smoke", case1, cliDefaultMobileTimeoutFullstart, results, diag, dryRun)
    let case2: str = cliBuildRunnerCommand(ctx, cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_hw_transport_smoke.cheng"), cliJoinPath(cliOutBinDir(ctx), "mobile_hw_transport_smoke"), cliDefaultBuildTrack, 1)
    cliRunSuiteCase(ctx, "mobile_hw_transport_smoke", case2, cliDefaultMobileTimeoutFullstart, results, diag, dryRun)
    let case3: str = cliBuildRunnerCommand(ctx, cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_ble_discovery_smoke.cheng"), cliJoinPath(cliOutBinDir(ctx), "mobile_ble_discovery_smoke"), cliDefaultBuildTrack, 1)
    cliRunSuiteCase(ctx, "mobile_ble_discovery_smoke", case3, cliDefaultMobileTimeoutFullstart, results, diag, dryRun)
    let case4: str = cliBuildRunnerCommand(ctx, cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_push_to_punch_smoke.cheng"), cliJoinPath(cliOutBinDir(ctx), "mobile_push_to_punch_smoke"), cliDefaultBuildTrack, 1)
    cliRunSuiteCase(ctx, "mobile_push_to_punch_smoke", case4, cliDefaultMobileTimeoutFullstart, results, diag, dryRun)
    let case5: str = cliBuildRunnerCommand(ctx, cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_ffi_fullstart_real_smoke.cheng"), cliJoinPath(cliOutBinDir(ctx), "mobile_ffi_fullstart_real_smoke"), cliDefaultBuildTrack, 1)
    cliRunSuiteCase(ctx, "mobile_ffi_fullstart_real_smoke", case5, cliDefaultMobileTimeoutFullstart, results, diag, dryRun)
    let case6: str = cliBuildRunnerCommand(ctx, cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_ffi_bootstrap_discovery_real_smoke.cheng"), cliJoinPath(cliOutBinDir(ctx), "mobile_ffi_bootstrap_discovery_real_smoke"), cliDefaultBuildTrack, 1)
    cliRunSuiteCase(ctx, "mobile_ffi_bootstrap_discovery_real_smoke", case6, cliDefaultMobileTimeoutBootstrap, results, diag, dryRun)
    let case7: str = cliBuildRunnerCommand(ctx, cliResolveEntryPath(ctx.repoRoot, "src/tests/mobile_device_fullstack_hard_gate_runner.cheng"), cliJoinPath(cliOutBinDir(ctx), "mobile_device_fullstack_hard_gate_runner"), cliDefaultBuildTrack, 1)
    cliRunSuiteCase(ctx, "mobile_device_fullstack_hard_gate_runner", case7, cliDefaultMobileTimeoutLanFullstack, results, diag, dryRun)
    let quicRunner: str = cliDefaultRunnerForMode(ctx.repoRoot, "msquic")
    if len(quicRunner) > 0:
        let case8Out: str = cliJoinPath(cliOutBinDir(ctx), "cheng_quic_msquic")
        var case8: str = cliBuildCompileCommand(ctx, quicRunner, case8Out, cliDefaultBuildTrack, 1)
        case8 = case8 + " ; " + cliNoPtrEnvPrefix(ctx, true, "") + cliShellQuote(case8Out)
        cliRunSuiteCase(ctx, "cheng_quic_msquic", case8, cliDefaultMobileTimeoutQuic, results, diag, dryRun)
    else:
        cliAppendLine(ctx, results, "cheng_quic_msquic\tFAIL\t1\tmissing ../cheng-quic/src/tests/msquic_verify_runner.cheng")
        cliAppendLine(ctx, diag, "cheng_quic_msquic\tFAIL\t1\tcase_failed_unknown\tmissing quic runner\tmissing ../cheng-quic/src/tests/msquic_verify_runner.cheng")
    var matrixArgs: str[]
    add(matrixArgs, "--entry:" + cliJoinPath(ctx.repoRoot, "src/tests/mobile_device_fullstack_hard_gate_runner.cheng"))
    add(matrixArgs, "--platforms:" + cliDefaultMobilePlatforms)
    add(matrixArgs, "--feature-tokens:" + cliDefaultFeatureTokens)
    if dryRun:
        add(matrixArgs, "--dry-run")
    let matrixRc: int32 = cliRunDeviceMatrix(ctx, matrixArgs)
    let matrixLog: str = cliJoinPath(ctx.repoRoot, "artifacts/mobile_devices")
    if matrixRc == 0:
        cliAppendLine(ctx, results, "mobile_device_matrix\tPASS\t0\t" + matrixLog)
        cliAppendLine(ctx, diag, "mobile_device_matrix\tPASS\t0\tpass\tok\t" + matrixLog)
    else:
        cliAppendLine(ctx, results, "mobile_device_matrix\tFAIL\t" + IntToStr(matrixRc) + "\t" + matrixLog)
        cliAppendLine(ctx, diag, "mobile_device_matrix\tFAIL\t" + IntToStr(matrixRc) + "\tdevice_matrix_gate_failed\tsee device matrix output\t" + matrixLog)
    let rows: str[] = cliSplitLines(os.readFile(results))
    var totalCount: int32
    var passCount: int32
    var failCount: int32
    var timeoutCount: int32
    for i in 0..<rows.len:
        if i == 0:
            continue
        let cols: str[] = strutil.split(rows[i], '\t')
        if cols.len < 4:
            continue
        totalCount = totalCount + 1
        if cols[1] == "PASS":
            passCount = passCount + 1
        elif cols[1] == "FAIL":
            failCount = failCount + 1
        elif cols[1] == "TIMEOUT":
            timeoutCount = timeoutCount + 1
    cliWriteText(ctx, summary,
        "total: " + IntToStr(totalCount) + "\n" +
        "pass: " + IntToStr(passCount) + "\n" +
        "fail: " + IntToStr(failCount) + "\n" +
        "timeout: " + IntToStr(timeoutCount) + "\n" +
        "cstring_preflight_report: " + cstringReport + "\n" +
        "cstring_preflight_build_log: " + cstringBuildLog + "\n")
    cliPrintOutput(os.readFile(summary))
    cliPrintOutput(os.readFile(results))
    cliPrintOutput(os.readFile(diag))
    if failCount != 0 || timeoutCount != 0:
        return 1
    return 0

fn cliRunPreflightSubcommand(ctx: CliContext, args: str[]): int32 =
    if cliHasFlag(args, "--help") || cliHasFlag(args, "-h"):
        echo("Usage: preflight [--subcommand:<name>] [--shell-env] [--skip-driver-probe] [--skip-gates] [--probe:0|1] [--gates:0|1]")
        return 0
    let cfg: CliPreflightConfig = cliBuildPreflightConfig("preflight", args)
    var preflightState: CliPreflightState
    var preflightErr: str
    if !cliRunPreflight(ctx, "preflight", args, preflightState, preflightErr):
        return 1
    cliPrintPreflightState(ctx, preflightState, cfg.shellEnv)
    return 0

fn runZeroScriptCliArgs(args: str[]): int32 =
    var ctx: CliContext
    var ctxErr: str
    if !cliResolveContext(ctx, ctxErr):
        echo(ctxErr)
        return 1
    if args.len <= 0:
        echo(cliUsage())
        return 0
    let subcommand: str = cliLower(args[0])
    let subArgs: str[] = cliSliceArgs(args, 1)
    if subcommand == "help" || subcommand == "--help" || subcommand == "-h":
        echo(cliUsage())
        return 0
    if subcommand == "preflight":
        return cliRunPreflightSubcommand(ctx, subArgs)
    if subcommand == "list-modes":
        return cliListModes(ctx)
    if subcommand == "backend-build":
        return cliRunBackendBuild(ctx, subArgs)
    if subcommand == "cstring-probe":
        return cliRunCStringProbe(ctx, subArgs)
    if subcommand == "verify":
        return cliRunVerify(ctx, subArgs)
    if subcommand == "mobile-suite":
        return cliRunMobileSuite(ctx, subArgs)
    if subcommand == "device-matrix":
        return cliRunDeviceMatrix(ctx, subArgs)
    echo("zero-script-cli: unknown subcommand: " + args[0])
    echo(cliUsage())
    return 2

fn runZeroScriptCliFromCmdline(): int32 =
    var args: str[] = os.commandLineParams()
    if args.len <= 0:
        args = cliArgsFromEnv()
    return runZeroScriptCliArgs(args)
