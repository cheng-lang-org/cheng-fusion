# Observed address manager(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/multiaddrlist
import cheng/libp2p/multiaddress
type
    ObservedAddrManager =
        addrs: MultiAddressList

var
    observedAddrManager: ObservedAddrManager = ObservedAddrManager(addrs: initMultiAddressList())

fn initObservedAddrManager(): ObservedAddrManager =
    ObservedAddrManager(addrs: initMultiAddressList())

fn observedAddrReset() =
    observedAddrManager = initObservedAddrManager()

fn observedAddrCount(): int32 =
    observedAddrManager.addrs.count

fn observedAddrAdd(addr: MultiAddress): Result[bool] =
    return multiAddressListAdd(observedAddrManager.addrs, addr)

fn observedAddrAddText(text: str): Result[bool] =
    if len(text) <= 0:
        return Err[bool]("observedaddr: empty address")
    let addrRes: Result[MultiAddress] = parseMultiAddress(text)
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    return observedAddrAdd(Value(addrRes))

fn observedAddrList(): MultiAddressList =
    return observedAddrManager.addrs

fn observedAddrDump(): str =
    return multiAddressListToLines(observedAddrManager.addrs)
