# Generic libp2p record(partial).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/stringlist
import std/times
import cheng/libp2p/vbuffer
import cheng/libp2p/peerid
import cheng/libp2p/crypto/crypto
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/routing_record
import cheng/libp2p/did/types
import cheng/libp2p/did/resolver
import std/seqs
type
    Record =
        key: str
        value: Bytes
        author: PeerId
        signature: Bytes
        timeReceived: str

    RecordValidator = fn(store: var RecordStore, key: str, value: Bytes): bool

fn recordHasAuthor(rec: Record): bool =
    len(toString(rec.author)) > 0

fn recordSignatureData(rec: Record): Result[Bytes] =
    var vb: VBuffer = newVBuffer()
    writeArray(vb, rec.key)
    writeArray(vb, rec.value)
    if recordHasAuthor(rec):
        let authorBytesRes: Result[Bytes] = toBytes(rec.author)
        if IsErr(authorBytesRes):
            return Err[Bytes](Error(authorBytesRes))
        let authorBytes: Bytes = Value(authorBytesRes)
        writeArray(vb, authorBytes)
    return Ok[Bytes](toBytes(vb))

fn encodeRecord(rec: Record): Result[Bytes] =
    if len(rec.key) <= 0:
        return Err[Bytes]("record: missing key")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, 1, rec.key)
    writeBytes(pb, 2, rec.value)
    if recordHasAuthor(rec):
        write(pb, 3, rec.author)
    if BytesLen(rec.signature) > 0:
        writeBytes(pb, 4, rec.signature)
    if len(rec.timeReceived) > 0:
        writeString(pb, 5, rec.timeReceived)
    return Ok[Bytes](protoToBytes(pb))

fn decodeRecord(data: Bytes): Result[Record] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var rec: Record = Record(value: EmptyBytes(), signature: EmptyBytes())
    var key: str
    let keyRes: Result[bool] = getField(pb, 1, key)
    if IsErr(keyRes):
        return Err[Record](Error(keyRes))
    if ! Value(keyRes):
        return Err[Record]("record: missing key")
    rec.key = key
    var value: Bytes = EmptyBytes()
    let valueRes: Result[bool] = getField(pb, 2, value)
    if IsErr(valueRes):
        return Err[Record](Error(valueRes))
    if ! Value(valueRes):
        return Err[Record]("record: missing value")
    rec.value = value
    var author: PeerId
    let authorRes: Result[bool] = getField(pb, 3, author)
    if IsErr(authorRes):
        return Err[Record](Error(authorRes))
    if Value(authorRes):
        rec.author = author
    var signature: Bytes = EmptyBytes()
    let sigRes: Result[bool] = getField(pb, 4, signature)
    if IsErr(sigRes):
        return Err[Record](Error(sigRes))
    if Value(sigRes):
        rec.signature = signature
    var timeText: str
    let timeRes: Result[bool] = getField(pb, 5, timeText)
    if IsErr(timeRes):
        return Err[Record](Error(timeRes))
    if Value(timeRes):
        rec.timeReceived = timeText
    return Ok[Record](rec)

fn signRecord(rec: var Record, priv: PrivateKey): Result[bool] =
    if ! recordHasAuthor(rec):
        let pidRes: Result[PeerId] = peerIdFromPrivateKey(priv)
        if IsErr(pidRes):
            return Err[bool](Error(pidRes))
        rec.author = Value(pidRes)
    let dataRes: Result[Bytes] = recordSignatureData(rec)
    if IsErr(dataRes):
        return Err[bool](Error(dataRes))
    let sigRes: Result[Signature] = sign(priv, Value(dataRes))
    if IsErr(sigRes):
        return Err[bool](Error(sigRes))
    rec.signature = encodeSignature(Value(sigRes))
    return Ok[bool](true)

fn verifyRecordSignature(rec: Record): bool =
    if BytesLen(rec.signature) <= 0:
        return true
    let pubRes: Result[PublicKey] = extractPublicKey(rec.author)
    if IsErr(pubRes):
        return false
    let dataRes: Result[Bytes] = recordSignatureData(rec)
    if IsErr(dataRes):
        return false
    let pub: PublicKey = Value(pubRes)
    let sig: Signature = decodeSignature(pub.keyType, rec.signature)
    if ! validateSignature(sig):
        return false
    return verify(pub, Value(dataRes), sig)

fn prepareRecord(key: str, value: Bytes, priv: PrivateKey, timeReceived: str): Result[Record] =
    var rec: Record = Record(
        key: key,
        value: value,
        signature: EmptyBytes(),
        timeReceived: timeReceived
    )
    let signRes: Result[bool] = signRecord(rec, priv)
    if IsErr(signRes):
        return Err[Record](Error(signRes))
    return Ok[Record](rec)

const
    maxIprsAllowedPeers = 32

type
    IpnsValidityType = enum
        ipnsUnknown = 0
        ipnsEol = 1
        ipnsTtl = 2

    IpnsRecord =
        value: Bytes
        signature: Bytes
        validity: Bytes
        validityType: IpnsValidityType
        validityTypeStr: str
        sequence: int64
        ttl: int64
        publicKey: Option[PublicKey]

    IpnsCacheEntry =
        key: str
        namespace: str
        record: IpnsRecord
        raw: Bytes
        seqNo: int64
        validUntilNs: int64
        cacheUntilNs: int64
        updatedAtNs: int64

    IprsCacheEntry =
        key: str
        namespace: str
        peerId: PeerId
        seqNo: int64
        record: SignedPeerRecord
        raw: Bytes
        updatedAtNs: int64
        expiresAtNs: int64

    IprsPeerIdList =
        count: int32
        items: PeerId[]

    IpnsNamespacePolicy =
        requirePeerId: bool
        requirePublicKey: bool
        maxRecordLifetimeNs: int64
        maxCacheDurationNs: int64

    IprsNamespacePolicy =
        acceptRecords: bool
        allowUnknownPeers: bool
        allowedPeers: IprsPeerIdList
        maxRecordAgeNs: int64

    IpnsNamespaceEntry =
        name: str
        policy: IpnsNamespacePolicy

    IprsNamespaceEntry =
        name: str
        policy: IprsNamespacePolicy

const
    recordMaxInt64Value = 9223372036854775807

fn parseUint64(text: str): Result[int64] =
    if len(text) <= 0:
        return Err[int64]("record: empty integer")
    var value: int64
    for i in 0..<len(text):
        let c: char = text[i]
        if c < '0' || c > '9':
            return Err[int64]("record: invalid integer")
        let digit: int64 = int64(int32(c) - int32('0'))
        if value > (recordMaxInt64Value - digit) / 10:
            return Err[int64]("record: integer overflow")
        value = value * 10 + digit
    return Ok[int64](value)

fn int64ToString(value: int64): str =
    if value <= 0:
        return "0"
    var v: int64 = value
    var out: str
    while v > 0: # cheng-syntax-policy: allow-counting-while
        let digit: int32 = int32(v % 10)
        let ch: char = char(int32('0') + digit)
        out = charToStr(ch) + out
        v = v / 10
    return out

fn isDigit(c: char): bool =
    return c >= '0' && c <= '9'

fn parseFixedInt(text: str, start: int32, count: int32): Result[int32] =
    if count <= 0 || start < 0:
        return Err[int32]("record: invalid integer span")
    if start + count > len(text):
        return Err[int32]("record: integer out of range")
    var value: int32
    for i in 0..<count:
        let c: char = text[start + i]
        if ! isDigit(c):
            return Err[int32]("record: invalid integer")
        value = value * 10 + (int32(c) - int32('0'))
    return Ok[int32](value)

fn isLeapYear(year: int32): bool =
    if year % 4 != 0:
        return false
    if year % 100 != 0:
        return true
    return year % 400 == 0

fn daysInMonth(year: int32, month: int32): int32 =
    if month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12:
        return 31
    if month == 4 || month == 6 || month == 9 || month == 11:
        return 30
    if month == 2:
        if isLeapYear(year):
            return 29
        return 28
    return 0

fn daysFromCivil(year: int32, month: int32, day: int32): Result[int64] =
    if month < 1 || month > 12:
        return Err[int64]("record: invalid month")
    let dim: int32 = daysInMonth(year, month)
    if dim <= 0 || day < 1 || day > dim:
        return Err[int64]("record: invalid day")
    var y: int64 = int64(year)
    let m: int64 = int64(month)
    let d: int64 = int64(day)
    if m <= 2:
        y = y - 1
    let era: int64 = if y >= 0: y / 400 else: (y - 399) / 400
    let yoe: int64 = y - era * 400
    let mp: int64 = if m > 2: m - 3 else: m + 9
    let doy: int64 = (153 * mp + 2) / 5 + d - 1
    let doe: int64 = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return Ok[int64](era * 146097 + doe - 719468)

fn parseRfc3339UnixNs(text: str): Result[int64] =
    if len(text) < 20:
        return Err[int64]("record: invalid time")
    var idx: int32
    let yearRes: Result[int32] = parseFixedInt(text, idx, 4)
    if IsErr(yearRes):
        return Err[int64](Error(yearRes))
    let year: int32 = Value(yearRes)
    idx = idx + 4
    if idx >= len(text) || text[idx] != '-':
        return Err[int64]("record: invalid time")
    idx = idx + 1
    let monthRes: Result[int32] = parseFixedInt(text, idx, 2)
    if IsErr(monthRes):
        return Err[int64](Error(monthRes))
    let month: int32 = Value(monthRes)
    idx = idx + 2
    if idx >= len(text) || text[idx] != '-':
        return Err[int64]("record: invalid time")
    idx = idx + 1
    let dayRes: Result[int32] = parseFixedInt(text, idx, 2)
    if IsErr(dayRes):
        return Err[int64](Error(dayRes))
    let day: int32 = Value(dayRes)
    idx = idx + 2
    if idx >= len(text) || text[idx] != 'T':
        return Err[int64]("record: invalid time")
    idx = idx + 1
    let hourRes: Result[int32] = parseFixedInt(text, idx, 2)
    if IsErr(hourRes):
        return Err[int64](Error(hourRes))
    let hour: int32 = Value(hourRes)
    idx = idx + 2
    if idx >= len(text) || text[idx] != ':':
        return Err[int64]("record: invalid time")
    idx = idx + 1
    let minuteRes: Result[int32] = parseFixedInt(text, idx, 2)
    if IsErr(minuteRes):
        return Err[int64](Error(minuteRes))
    let minute: int32 = Value(minuteRes)
    idx = idx + 2
    if idx >= len(text) || text[idx] != ':':
        return Err[int64]("record: invalid time")
    idx = idx + 1
    let secondRes: Result[int32] = parseFixedInt(text, idx, 2)
    if IsErr(secondRes):
        return Err[int64](Error(secondRes))
    let second: int32 = Value(secondRes)
    idx = idx + 2
    if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59:
        return Err[int64]("record: invalid time")
    var nanos: int64
    if idx < len(text) && text[idx] == '.':
        idx = idx + 1
        var digits: int32
        let fracStart: int32 = idx
        idx = len(text)
        for scanIdx in fracStart..<len(text):
            if ! isDigit(text[scanIdx]):
                idx = scanIdx
                break
            if digits < 9:
                nanos = nanos * 10 + int64(int32(text[scanIdx]) - int32('0'))
            digits = digits + 1
        if digits == 0:
            return Err[int64]("record: invalid time")
        for digits in digits..<9:
            nanos = nanos * 10
    if idx >= len(text):
        return Err[int64]("record: invalid time")
    var offsetSec: int64
    let tz: char = text[idx]
    if tz == 'Z' || tz == 'z':
        idx = idx + 1
    elif tz == '+' || tz == '-':
        let sign: int64 = if tz == '-': -1 else: 1
        idx = idx + 1
        let tzhRes: Result[int32] = parseFixedInt(text, idx, 2)
        if IsErr(tzhRes):
            return Err[int64](Error(tzhRes))
        let tzh: int32 = Value(tzhRes)
        idx = idx + 2
        if idx >= len(text) || text[idx] != ':':
            return Err[int64]("record: invalid time")
        idx = idx + 1
        let tzmRes: Result[int32] = parseFixedInt(text, idx, 2)
        if IsErr(tzmRes):
            return Err[int64](Error(tzmRes))
        let tzm: int32 = Value(tzmRes)
        idx = idx + 2
        if tzh < 0 || tzh > 23 || tzm < 0 || tzm > 59:
            return Err[int64]("record: invalid time")
        offsetSec = sign * int64(tzh * 3600 + tzm * 60)
    else:
        return Err[int64]("record: invalid time")
    if idx != len(text):
        return Err[int64]("record: invalid time")
    let daysRes: Result[int64] = daysFromCivil(year, month, day)
    if IsErr(daysRes):
        return Err[int64](Error(daysRes))
    let days: int64 = Value(daysRes)
    let daySecs: int64 = days * 86400
    let timeSecs: int64 = int64(hour * 3600 + minute * 60 + second)
    let totalSecs: int64 = daySecs + timeSecs - offsetSec
    return Ok[int64](totalSecs * 1000000000 + nanos)

fn parseDurationNs(text: str): Result[int64] =
    let valRes: Result[int64] = parseUint64(text)
    if IsErr(valRes):
        return Err[int64](Error(valRes))
    let value: int64 = Value(valRes)
    if value < 0:
        return Err[int64]("record: invalid duration")
    return Ok[int64](value)

fn parseDurationNsFromBytes(data: Bytes): Result[int64] =
    if BytesLen(data) <= 0:
        return Err[int64]("record: empty duration")
    return parseDurationNs(BytesToString(data))

fn initPeerIdList(): IprsPeerIdList =
    var out: IprsPeerIdList
    out.count = 0
    return out

fn peerIdListContains(list: IprsPeerIdList, pid: PeerId): bool =
    for i in 0..<list.count:
        let eqRes: Result[bool] = peerIdEqual(list.items[i], pid)
        if IsOk(eqRes) && Value(eqRes):
            return true
    return false

fn peerIdListAdd(list: var IprsPeerIdList, pid: PeerId): bool =
    if peerIdListContains(list, pid):
        return true
    if list.count >= maxIprsAllowedPeers:
        return false
    add(list.items, pid)
    list.count = list.items.len
    return true

fn peerIdListRemove(list: var IprsPeerIdList, pid: PeerId): bool =
    for i in 0..<list.count:
        let eqRes: Result[bool] = peerIdEqual(list.items[i], pid)
        if IsOk(eqRes) && Value(eqRes):
            let last: int32 = list.count - 1
            if i != last:
                list.items[i] = list.items[last]
            setLen(list.items, last)
            list.count = list.items.len
            return true
    return false

fn defaultIpnsPolicy(): IpnsNamespacePolicy =
    IpnsNamespacePolicy(
        requirePeerId: false,
        requirePublicKey: false,
        maxRecordLifetimeNs: -1,
        maxCacheDurationNs: -1
    )

fn defaultIprsPolicy(): IprsNamespacePolicy =
    IprsNamespacePolicy(
        acceptRecords: true,
        allowUnknownPeers: true,
        allowedPeers: initPeerIdList(),
        maxRecordAgeNs: -1
    )

fn ipnsValidityTypeFromString(text: str): IpnsValidityType =
    if (text == "EOL") || (text == "eol"):
        return ipnsEol
    if (text == "TTL") || (text == "ttl"):
        return ipnsTtl
    return ipnsUnknown

fn ipnsValidityTypeString(vt: IpnsValidityType): str =
    if vt == ipnsEol:
        return "EOL"
    if vt == ipnsTtl:
        return "TTL"
    return ""

fn ipnsDataForSignature(value: Bytes, validity: Bytes, validityType: str): Bytes =
    return BytesConcat3(value, validity, BytesFromString(validityType))

fn ipnsSignatureData(record: IpnsRecord): Bytes =
    let vtStr: str = if len(record.validityTypeStr) > 0: record.validityTypeStr else: ipnsValidityTypeString(record.validityType)
    return ipnsDataForSignature(record.value, record.validity, vtStr)

fn ipnsValidUntilNs(record: IpnsRecord, nowNs: int64): Result[int64] =
    if record.validityType == ipnsEol:
        if BytesLen(record.validity) <= 0:
            return Err[int64]("record: missing ipns validity")
        let validityText: str = BytesToString(record.validity)
        let tsRes: Result[int64] = parseRfc3339UnixNs(validityText)
        if IsErr(tsRes):
            return Err[int64](Error(tsRes))
        let ts: int64 = Value(tsRes)
        if ts <= nowNs:
            return Err[int64]("record: ipns expired")
        return Ok[int64](ts)
    if record.validityType == ipnsTtl:
        let ttlRes: Result[int64] = parseDurationNsFromBytes(record.validity)
        if IsErr(ttlRes):
            return Err[int64](Error(ttlRes))
        let ttlNs: int64 = Value(ttlRes)
        if ttlNs <= 0 || nowNs > recordMaxInt64Value - ttlNs:
            return Err[int64]("record: invalid ipns ttl")
        let ts: int64 = nowNs + ttlNs
        if ts <= nowNs:
            return Err[int64]("record: ipns expired")
        return Ok[int64](ts)
    return Err[int64]("record: invalid ipns validity")

fn ipnsCacheUntilNs(record: IpnsRecord, validUntilNs: int64, nowNs: int64): Result[int64] =
    var deadline: int64 = validUntilNs
    if record.ttl >= 0:
        let ttlNs: int64 = record.ttl
        if ttlNs <= 0 || nowNs > recordMaxInt64Value - ttlNs:
            return Err[int64]("record: invalid ipns ttl")
        let ttlUntil: int64 = nowNs + ttlNs
        if ttlUntil < deadline:
            deadline = ttlUntil
    if deadline > validUntilNs:
        deadline = validUntilNs
    if deadline <= nowNs:
        return Err[int64]("record: ipns expired")
    return Ok[int64](deadline)

fn decodeIpnsRecord(data: Bytes): Result[IpnsRecord] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var record: IpnsRecord = IpnsRecord(
        value: EmptyBytes(),
        signature: EmptyBytes(),
        validity: EmptyBytes(),
        validityType: ipnsUnknown,
        validityTypeStr: "",
        sequence: -1,
        ttl: -1,
        publicKey: None[PublicKey]()
    )
    let valueRes: Result[bool] = getField(pb, 1, record.value)
    if IsErr(valueRes):
        return Err[IpnsRecord](Error(valueRes))
    let sigRes: Result[bool] = getField(pb, 2, record.signature)
    if IsErr(sigRes):
        return Err[IpnsRecord](Error(sigRes))
    let vtRes: Result[bool] = getField(pb, 4, record.validityTypeStr)
    if IsErr(vtRes):
        return Err[IpnsRecord](Error(vtRes))
    if Value(vtRes):
        record.validityType = ipnsValidityTypeFromString(record.validityTypeStr)
    let validityRes: Result[bool] = getField(pb, 5, record.validity)
    if IsErr(validityRes):
        return Err[IpnsRecord](Error(validityRes))
    var seqText: str
    let seqRes: Result[bool] = getField(pb, 6, seqText)
    if IsErr(seqRes):
        return Err[IpnsRecord](Error(seqRes))
    if Value(seqRes):
        let seqVal: Result[int64] = parseUint64(seqText)
        if IsErr(seqVal):
            return Err[IpnsRecord](Error(seqVal))
        record.sequence = Value(seqVal)
    var ttlText: str
    let ttlRes: Result[bool] = getField(pb, 7, ttlText)
    if IsErr(ttlRes):
        return Err[IpnsRecord](Error(ttlRes))
    if Value(ttlRes):
        let ttlVal: Result[int64] = parseUint64(ttlText)
        if IsErr(ttlVal):
            return Err[IpnsRecord](Error(ttlVal))
        record.ttl = Value(ttlVal)
    var pubBytes: Bytes = EmptyBytes()
    let pubRes: Result[bool] = getField(pb, 8, pubBytes)
    if IsErr(pubRes):
        return Err[IpnsRecord](Error(pubRes))
    if Value(pubRes):
        let pubKeyRes: Result[PublicKey] = decodePublicKey(pubBytes)
        if IsErr(pubKeyRes):
            return Err[IpnsRecord](Error(pubKeyRes))
        record.publicKey = Some[PublicKey](Value(pubKeyRes))
    if BytesLen(record.value) <= 0 || BytesLen(record.signature) <= 0:
        return Err[IpnsRecord]("record: missing ipns fields")
    if record.validityType == ipnsUnknown:
        return Err[IpnsRecord]("record: invalid ipns validity type")
    if record.validityType == ipnsEol && BytesLen(record.validity) <= 0:
        return Err[IpnsRecord]("record: missing ipns validity")
    if record.validityType == ipnsTtl && BytesLen(record.validity) <= 0:
        return Err[IpnsRecord]("record: missing ipns validity")
    return Ok[IpnsRecord](record)

fn encodeIpnsRecord(record: IpnsRecord): Result[Bytes] =
    if BytesLen(record.value) <= 0 || BytesLen(record.signature) <= 0:
        return Err[Bytes]("record: missing ipns fields")
    var pb: ProtoBuffer = InitProtoBuffer()
    writeBytes(pb, 1, record.value)
    writeBytes(pb, 2, record.signature)
    let vtStr: str = if len(record.validityTypeStr) > 0: record.validityTypeStr else: ipnsValidityTypeString(record.validityType)
    if len(vtStr) <= 0:
        return Err[Bytes]("record: invalid ipns validity type")
    if (record.validityType == ipnsEol || record.validityType == ipnsTtl) && BytesLen(record.validity) <= 0:
        return Err[Bytes]("record: missing ipns validity")
    writeString(pb, 4, vtStr)
    if BytesLen(record.validity) > 0:
        writeBytes(pb, 5, record.validity)
    if record.sequence >= 0:
        writeString(pb, 6, int64ToString(record.sequence))
    if record.ttl >= 0:
        writeString(pb, 7, int64ToString(record.ttl))
    if record.publicKey.has:
        let pubBytesRes: Result[Bytes] = encodePublicKey(record.publicKey.value)
        if IsErr(pubBytesRes):
            return Err[Bytes](Error(pubBytesRes))
        writeBytes(pb, 8, Value(pubBytesRes))
    return Ok[Bytes](protoToBytes(pb))

fn verifyIpnsRecord(record: IpnsRecord, pub: PublicKey): bool =
    if ! validatePublicKey(pub):
        return false
    let sig: Signature = decodeSignature(pub.keyType, record.signature)
    if ! validateSignature(sig):
        return false
    let data: Bytes = ipnsSignatureData(record)
    return verify(pub, data, sig)

const
    maxRecordValidators = 16
    maxIpnsRecords = 32
    maxIprsRecords = 32
    maxIpnsNamespaces = 16
    maxIprsNamespaces = 16

type
    RecordValidatorEntry =
        prefix: str
        validator: RecordValidator

    RecordStore =
        count: int32
        validators: RecordValidatorEntry[maxRecordValidators]
        ipnsCount: int32
        ipnsRecords: IpnsCacheEntry[maxIpnsRecords]
        iprsCount: int32
        iprsRecords: IprsCacheEntry[maxIprsRecords]
        ipnsNamespaceCount: int32
        ipnsNamespaces: IpnsNamespaceEntry[maxIpnsNamespaces]
        defaultIpnsPolicy: IpnsNamespacePolicy
        iprsNamespaceCount: int32
        iprsNamespaces: IprsNamespaceEntry[maxIprsNamespaces]
        defaultIprsPolicy: IprsNamespacePolicy
        acceptUnregisteredIprsNamespaces: bool

fn normalizePath(path: str): str =
    var finish: int32 = len(path)
    var start: int32 = finish
    for scanStart in 0..<finish:
        if path[scanStart] != '/':
            start = scanStart
            break
    let loop_start_finish_8 = finish
    for loop_rev_finish_8 in 0..(loop_start_finish_8 - (start)):
        finish = loop_start_finish_8 - loop_rev_finish_8
        if ! (finish > start && path[finish - 1] == '/'):
            break
    if start >= finish:
        return ""
    return SliceBytes(path, start, finish - start)

fn splitPath(path: str): Result[StringList] =
    var list: StringList = InitStringList()
    if len(path) <= 0:
        return Ok[StringList](list)
    var start: int32
    let total: int32 = len(path)
    for i in 0..total:
        if i == total || path[i] == '/':
            let segLen: int32 = i - start
            if segLen > 0:
                let seg: str = SliceBytes(path, start, segLen)
                let addRes: Result[bool] = StringListAdd(list, seg)
                if IsErr(addRes):
                    return Err[StringList](Error(addRes))
            start = i + 1
    return Ok[StringList](list)

fn joinPathParts(parts: StringList, start: int32, finish: int32): str =
    if start < 0 || finish <= start || start >= parts.count:
        return ""
    var out: str
    let last: int32 = if finish > parts.count: parts.count else: finish
    for i in start..<last:
        if len(out) == 0:
            out = parts.items[i]
        else:
            out = out + "/"
            out = out + parts.items[i]
    return out

fn findValidatorIndex(store: RecordStore, prefix: str): int32 =
    for i in 0..<store.count:
        if (store.validators[i].prefix == prefix):
            return i
    return -1

fn findIpnsIndex(store: RecordStore, key: str): int32 =
    for i in 0..<store.ipnsCount:
        if (store.ipnsRecords[i].key == key):
            return i
    return -1

fn findIprsIndex(store: RecordStore, key: str): int32 =
    for i in 0..<store.iprsCount:
        if (store.iprsRecords[i].key == key):
            return i
    return -1

fn findIpnsNamespaceIndex(store: RecordStore, namespace: str): int32 =
    for i in 0..<store.ipnsNamespaceCount:
        if (store.ipnsNamespaces[i].name == namespace):
            return i
    return -1

fn findIprsNamespaceIndex(store: RecordStore, namespace: str): int32 =
    for i in 0..<store.iprsNamespaceCount:
        if (store.iprsNamespaces[i].name == namespace):
            return i
    return -1

fn getIpnsNamespacePolicy(store: RecordStore, namespace: str): Option[IpnsNamespacePolicy] =
    let normalized: str = normalizePath(namespace)
    if len(normalized) <= 0:
        return Some[IpnsNamespacePolicy](store.defaultIpnsPolicy)
    let idx: int32 = findIpnsNamespaceIndex(store, normalized)
    if idx < 0:
        return None[IpnsNamespacePolicy]()
    return Some[IpnsNamespacePolicy](store.ipnsNamespaces[idx].policy)

fn getIprsNamespacePolicy(store: RecordStore, namespace: str): Option[IprsNamespacePolicy] =
    let normalized: str = normalizePath(namespace)
    if len(normalized) <= 0:
        return Some[IprsNamespacePolicy](store.defaultIprsPolicy)
    let idx: int32 = findIprsNamespaceIndex(store, normalized)
    if idx >= 0:
        return Some[IprsNamespacePolicy](store.iprsNamespaces[idx].policy)
    if store.acceptUnregisteredIprsNamespaces:
        return Some[IprsNamespacePolicy](store.defaultIprsPolicy)
    return None[IprsNamespacePolicy]()

fn registerIpnsNamespace(
    store: var RecordStore,
    namespace: str,
    policy: IpnsNamespacePolicy
): Result[bool] =
    let normalized: str = normalizePath(namespace)
    if len(normalized) <= 0:
        store.defaultIpnsPolicy = policy
        return Ok[bool](true)
    let idx: int32 = findIpnsNamespaceIndex(store, normalized)
    if idx >= 0:
        store.ipnsNamespaces[idx].policy = policy
        return Ok[bool](true)
    if store.ipnsNamespaceCount >= maxIpnsNamespaces:
        return Err[bool]("record: ipns namespace list full")
    store.ipnsNamespaces[store.ipnsNamespaceCount] = IpnsNamespaceEntry(
        name: normalized,
        policy: policy
    )
    store.ipnsNamespaceCount = store.ipnsNamespaceCount + 1
    return Ok[bool](true)

fn unregisterIpnsNamespace(store: var RecordStore, namespace: str): Result[bool] =
    let normalized: str = normalizePath(namespace)
    if len(normalized) <= 0:
        store.defaultIpnsPolicy = defaultIpnsPolicy()
        return Ok[bool](true)
    let idx: int32 = findIpnsNamespaceIndex(store, normalized)
    if idx < 0:
        return Err[bool]("record: ipns namespace ! found")
    let last: int32 = store.ipnsNamespaceCount - 1
    if idx != last:
        store.ipnsNamespaces[idx] = store.ipnsNamespaces[last]
    store.ipnsNamespaceCount = store.ipnsNamespaceCount - 1
    return Ok[bool](true)

