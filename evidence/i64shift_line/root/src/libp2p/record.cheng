fn acceptIpnsEntry(
    store: var RecordStore,
    key: str,
    namespace: str,
    record: IpnsRecord,
    raw: Bytes,
    nowNs: int64,
    validUntilNs: int64,
    cacheUntilNs: int64
): bool =
    let normalized: str = normalizePath(key)
    let idx: int32 = findIpnsIndex(store, normalized)
    var existingActive: bool
    var existing: IpnsCacheEntry
    if idx >= 0:
        existing = store.ipnsRecords[idx]
        if existing.cacheUntilNs <= 0 || existing.cacheUntilNs > nowNs:
            existingActive = true
        else:
            store.ipnsRecords[idx] = store.ipnsRecords[store.ipnsCount - 1]
            store.ipnsCount = store.ipnsCount - 1
    if existingActive:
        let newSeq: int64 = record.sequence
        let oldSeq: int64 = existing.seqNo
        if newSeq >= 0 && oldSeq >= 0:
            if newSeq < oldSeq:
                return false
            if newSeq == oldSeq:
                if ! BytesEqual(existing.raw, raw):
                    return false
                if validUntilNs <= existing.validUntilNs && cacheUntilNs <= existing.cacheUntilNs:
                    return false
        elif BytesLen(existing.raw) > 0 && ! BytesEqual(existing.raw, raw):
            return false
        store.ipnsRecords[idx] = IpnsCacheEntry(
            key: normalized,
            namespace: namespace,
            record: record,
            raw: raw,
            seqNo: record.sequence,
            validUntilNs: validUntilNs,
            cacheUntilNs: cacheUntilNs,
            updatedAtNs: nowNs
        )
        return true
    if store.ipnsCount >= maxIpnsRecords:
        return false
    store.ipnsRecords[store.ipnsCount] = IpnsCacheEntry(
        key: normalized,
        namespace: namespace,
        record: record,
        raw: raw,
        seqNo: record.sequence,
        validUntilNs: validUntilNs,
        cacheUntilNs: cacheUntilNs,
        updatedAtNs: nowNs
    )
    store.ipnsCount = store.ipnsCount + 1
    return true

fn acceptIprsEntry(
    store: var RecordStore,
    key: str,
    namespace: str,
    record: SignedPeerRecord,
    raw: Bytes,
    nowNs: int64,
    expiresAtNs: int64
): bool =
    let normalized: str = normalizePath(key)
    let idx: int32 = findIprsIndex(store, normalized)
    let newSeq: int64 = record.data.seqNo
    var existingActive: bool
    var existing: IprsCacheEntry
    if idx >= 0:
        existing = store.iprsRecords[idx]
        if existing.expiresAtNs <= 0 || existing.expiresAtNs > nowNs:
            existingActive = true
        else:
            store.iprsRecords[idx] = store.iprsRecords[store.iprsCount - 1]
            store.iprsCount = store.iprsCount - 1
    if existingActive:
        if newSeq < existing.seqNo:
            return false
        if newSeq == existing.seqNo && ! BytesEqual(existing.raw, raw):
            return false
        store.iprsRecords[idx] = IprsCacheEntry(
            key: normalized,
            namespace: namespace,
            peerId: record.data.peerId,
            seqNo: newSeq,
            record: record,
            raw: raw,
            updatedAtNs: nowNs,
            expiresAtNs: expiresAtNs
        )
        return true
    if store.iprsCount >= maxIprsRecords:
        return false
    store.iprsRecords[store.iprsCount] = IprsCacheEntry(
        key: normalized,
        namespace: namespace,
        peerId: record.data.peerId,
        seqNo: newSeq,
        record: record,
        raw: raw,
        updatedAtNs: nowNs,
        expiresAtNs: expiresAtNs
    )
    store.iprsCount = store.iprsCount + 1
    return true

fn getIpnsRecord(store: RecordStore, key: str): Option[IpnsCacheEntry] =
    let normalized: str = normalizePath(key)
    let idx: int32 = findIpnsIndex(store, normalized)
    if idx < 0:
        return None[IpnsCacheEntry]()
    let entry: IpnsCacheEntry = store.ipnsRecords[idx]
    if entry.cacheUntilNs > 0:
        let nowNs: int64 = EpochTimeNs()
        if entry.cacheUntilNs <= nowNs:
            return None[IpnsCacheEntry]()
    return Some[IpnsCacheEntry](entry)

fn getIprsRecord(store: RecordStore, key: str): Option[IprsCacheEntry] =
    let normalized: str = normalizePath(key)
    let idx: int32 = findIprsIndex(store, normalized)
    if idx < 0:
        return None[IprsCacheEntry]()
    let entry: IprsCacheEntry = store.iprsRecords[idx]
    if entry.expiresAtNs > 0:
        let nowNs: int64 = EpochTimeNs()
        if entry.expiresAtNs <= nowNs:
            return None[IprsCacheEntry]()
    return Some[IprsCacheEntry](entry)

fn getIprsRecordByPeer(store: RecordStore, peerId: PeerId): Option[IprsCacheEntry] =
    let nowNs: int64 = EpochTimeNs()
    for i in 0..<store.iprsCount:
        if ! (i < store.iprsCount):
            break
        let entry: IprsCacheEntry = store.iprsRecords[i]
        if entry.expiresAtNs > 0 && entry.expiresAtNs <= nowNs:
            continue
        let eqRes: Result[bool] = peerIdEqual(entry.peerId, peerId)
        if IsOk(eqRes) && Value(eqRes):
            return Some[IprsCacheEntry](entry)
    return None[IprsCacheEntry]()

fn revokeIprsRecord(store: var RecordStore, namespace: str, peerId: PeerId): bool =
    var key: str = "iprs"
    let normalized: str = normalizePath(namespace)
    if len(normalized) > 0:
        key = key + "/"
        key = key + normalized
    key = key + "/"
    key = key + peerid.toString(peerId)
    let idx: int32 = findIprsIndex(store, normalizePath(key))
    if idx < 0:
        return false
    let last: int32 = store.iprsCount - 1
    if idx != last:
        store.iprsRecords[idx] = store.iprsRecords[last]
    store.iprsCount = store.iprsCount - 1
    return true

fn pruneIprsRecords(store: var RecordStore, nowNs: int64): int32 =
    var current: int64 = nowNs
    if current <= 0:
        current = EpochTimeNs()
    var removed: int32
    for i in 0..<store.iprsCount:
        if ! (i < store.iprsCount):
            break
        let entry: IprsCacheEntry = store.iprsRecords[i]
        if entry.expiresAtNs > 0 && entry.expiresAtNs <= current:
            let last: int32 = store.iprsCount - 1
            if i != last:
                store.iprsRecords[i] = store.iprsRecords[last]
            store.iprsCount = store.iprsCount - 1
            removed = removed + 1
            continue
    return removed

fn registerValidator(store: var RecordStore, prefix: str, validator: RecordValidator): Result[bool] =
    let normalized: str = normalizePath(prefix)
    let idx: int32 = findValidatorIndex(store, normalized)
    if idx >= 0:
        store.validators[idx].validator = validator
        return Ok[bool](true)
    if store.count >= maxRecordValidators:
        return Err[bool]("record: validator list full")
    store.validators[store.count] = RecordValidatorEntry(prefix: normalized, validator: validator)
    store.count = store.count + 1
    return Ok[bool](true)

fn unregisterValidator(store: var RecordStore, prefix: str): Result[bool] =
    let normalized: str = normalizePath(prefix)
    let idx: int32 = findValidatorIndex(store, normalized)
    if idx < 0:
        return Err[bool]("record: validator ! found")
    let last: int32 = store.count - 1
    if idx != last:
        store.validators[idx] = store.validators[last]
    store.count = store.count - 1
    return Ok[bool](true)

fn validatePeerRecord(store: var RecordStore, key: str, value: Bytes): bool =
    store
    let normalized: str = normalizePath(key)
    let partsRes: Result[StringList] = splitPath(normalized)
    if IsErr(partsRes):
        return false
    let parts: StringList = Value(partsRes)
    if parts.count < 2:
        return false
    if (parts.items[0] != "libp2p") || (parts.items[1] != "peer-record"):
        return false
    let signedRes: Result[SignedPeerRecord] = decodeSignedPeerRecord(value)
    if IsErr(signedRes):
        return false
    let signed: SignedPeerRecord = Value(signedRes)
    if parts.count >= 3 && len(parts.items[2]) > 0:
        let pidText: str = peerid.toString(signed.data.peerId)
        if (parts.items[2] != pidText):
            return false
    return true

fn validatePkRecord(store: var RecordStore, key: str, value: Bytes): bool =
    store
    let normalized: str = normalizePath(key)
    let partsRes: Result[StringList] = splitPath(normalized)
    if IsErr(partsRes):
        return false
    let parts: StringList = Value(partsRes)
    if parts.count != 2:
        return false
    if (parts.items[0] != "pk"):
        return false
    let pidRes: Result[PeerId] = parsePeerId(parts.items[1])
    if IsErr(pidRes):
        return false
    let pubRes: Result[PublicKey] = decodePublicKey(value)
    if IsErr(pubRes):
        return false
    return peerIdMatchesPublicKey(Value(pidRes), Value(pubRes))

fn validateIpnsRecord(store: var RecordStore, key: str, value: Bytes): bool =
    let normalized: str = normalizePath(key)
    let partsRes: Result[StringList] = splitPath(normalized)
    if IsErr(partsRes):
        return false
    let parts: StringList = Value(partsRes)
    if parts.count < 2:
        return false
    if (parts.items[0] != "ipns"):
        return false
    let namespaceRaw: str = if parts.count > 2: joinPathParts(parts, 1, parts.count - 1) else: ""
    let namespace: str = normalizePath(namespaceRaw)
    let policyOpt: Option[IpnsNamespacePolicy] = getIpnsNamespacePolicy(store, namespace)
    if ! policyOpt.has:
        return false
    let policy: IpnsNamespacePolicy = policyOpt.value
    let recordRes: Result[IpnsRecord] = decodeIpnsRecord(value)
    if IsErr(recordRes):
        return false
    let record: IpnsRecord = Value(recordRes)
    var pub: PublicKey
    var hasPub: bool
    var hasEmbedded: bool
    if record.publicKey.has:
        pub = record.publicKey.value
        hasPub = true
        hasEmbedded = true
    let name: str = parts.items[parts.count - 1]
    let pidRes: Result[PeerId] = parsePeerId(name)
    if IsOk(pidRes):
        let pid: PeerId = Value(pidRes)
        let derivedRes: Result[PublicKey] = extractPublicKey(pid)
        if IsOk(derivedRes):
            let derived: PublicKey = Value(derivedRes)
            if hasEmbedded && ! peerIdMatchesPublicKey(pid, pub):
                return false
            pub = derived
            hasPub = true
        elif ! hasEmbedded:
            return false
        if ! peerIdMatchesPublicKey(pid, pub):
            return false
    else:
        if policy.requirePeerId:
            return false
        if ! hasPub:
            return false
    if policy.requirePublicKey && ! hasEmbedded:
        return false
    if ! hasPub:
        return false
    if ! verifyIpnsRecord(record, pub):
        return false
    let nowNs: int64 = EpochTimeNs()
    let validRes: Result[int64] = ipnsValidUntilNs(record, nowNs)
    if IsErr(validRes):
        return false
    var validUntil: int64 = Value(validRes)
    if policy.maxRecordLifetimeNs > 0:
        if nowNs > recordMaxInt64Value - policy.maxRecordLifetimeNs:
            return false
        let maxValid: int64 = nowNs + policy.maxRecordLifetimeNs
        if validUntil > maxValid:
            validUntil = maxValid
    if validUntil <= nowNs:
        return false
    let cacheRes: Result[int64] = ipnsCacheUntilNs(record, validUntil, nowNs)
    if IsErr(cacheRes):
        return false
    var cacheUntil: int64 = Value(cacheRes)
    if policy.maxCacheDurationNs > 0:
        if nowNs > recordMaxInt64Value - policy.maxCacheDurationNs:
            return false
        let maxCache: int64 = nowNs + policy.maxCacheDurationNs
        if cacheUntil > maxCache:
            cacheUntil = maxCache
    if cacheUntil > validUntil:
        cacheUntil = validUntil
    if cacheUntil <= nowNs:
        return false
    return acceptIpnsEntry(
        store,
        normalized,
        namespace,
        record,
        value,
        nowNs,
        validUntil,
        cacheUntil
    )

fn validateIprsRecord(store: var RecordStore, key: str, value: Bytes): bool =
    let normalized: str = normalizePath(key)
    let partsRes: Result[StringList] = splitPath(normalized)
    if IsErr(partsRes):
        return false
    let parts: StringList = Value(partsRes)
    if parts.count < 2:
        return false
    if (parts.items[0] != "iprs"):
        return false
    let peerText: str = parts.items[parts.count - 1]
    let pidRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(pidRes):
        return false
    let namespaceRaw: str = if parts.count > 2: joinPathParts(parts, 1, parts.count - 1) else: ""
    let namespace: str = normalizePath(namespaceRaw)
    let policyOpt: Option[IprsNamespacePolicy] = getIprsNamespacePolicy(store, namespace)
    if ! policyOpt.has:
        return false
    let policy: IprsNamespacePolicy = policyOpt.value
    if ! policy.acceptRecords:
        return false
    let allowed: bool = peerIdListContains(policy.allowedPeers, Value(pidRes))
    if ! policy.allowUnknownPeers && ! allowed:
        return false
    let nowNs: int64 = EpochTimeNs()
    var expiresAtNs: int64 = -1
    if policy.maxRecordAgeNs > 0:
        if nowNs > recordMaxInt64Value - policy.maxRecordAgeNs:
            return false
        expiresAtNs = nowNs + policy.maxRecordAgeNs
    let signedRes: Result[SignedPeerRecord] = decodeSignedPeerRecord(value)
    if IsErr(signedRes):
        return false
    let signed: SignedPeerRecord = Value(signedRes)
    let eqRes: Result[bool] = peerIdEqual(Value(pidRes), signed.data.peerId)
    if IsErr(eqRes) || ! Value(eqRes):
        return false
    if ! peerIdMatchesPublicKey(Value(pidRes), signed.envelope.publicKey):
        return false
    return acceptIprsEntry(store, normalized, namespace, signed, value, nowNs, expiresAtNs)

fn validateDidChengRecord(store: var RecordStore, key: str, value: Bytes): bool =
    store
    if BytesLen(value) <= 0:
        return false
    let normalized: str = normalizePath(key)
    let partsRes: Result[StringList] = splitPath(normalized)
    if IsErr(partsRes):
        return false
    let parts: StringList = Value(partsRes)
    if parts.count < 4:
        return false
    if (parts.items[0] != "did") || (parts.items[1] != "cheng"):
        return false
    let rootPidRes: Result[PeerId] = parsePeerId(parts.items[2])
    if IsErr(rootPidRes):
        return false
    let didText: str = didFromRootPeerId(Value(rootPidRes))
    if parts.count == 4 && (parts.items[3] == "doc"):
        let docRes: Result[DidDocumentV1] = didResolverApplySignedDocument(value)
        if IsErr(docRes):
            return false
        return (Value(docRes).id == didText)
    if parts.count == 5 && (parts.items[3] == "rev"):
        let versionRes: Result[int64] = parseUint64(parts.items[4])
        if IsErr(versionRes):
            return false
        let revRes: Result[DidRevocationV1] = didResolverApplySignedRevocation(value)
        if IsErr(revRes):
            return false
        let rev: DidRevocationV1 = Value(revRes)
        if (rev.did != didText):
            return false
        return rev.version == Value(versionRes)
    return false

fn registerPeerRecordValidator(store: var RecordStore) =
    let _ = registerValidator(store, "libp2p/peer-record", validatePeerRecord)

fn registerPkValidator(store: var RecordStore) =
    let _ = registerValidator(store, "pk", validatePkRecord)

fn registerIpnsValidator(store: var RecordStore) =
    let _ = registerValidator(store, "ipns", validateIpnsRecord)

fn registerIprsValidator(store: var RecordStore) =
    let _ = registerValidator(store, "iprs", validateIprsRecord)

fn registerDidChengValidator(store: var RecordStore) =
    let _ = registerValidator(store, "did/cheng", validateDidChengRecord)

fn callBuiltinRecordValidator(
    prefix: str,
    store: var RecordStore,
    key: str,
    value: Bytes
): bool =
    if prefix == "libp2p/peer-record":
        return validatePeerRecord(store, key, value)
    if prefix == "pk":
        return validatePkRecord(store, key, value)
    if prefix == "ipns":
        return validateIpnsRecord(store, key, value)
    if prefix == "iprs":
        return validateIprsRecord(store, key, value)
    if prefix == "did/cheng":
        return validateDidChengRecord(store, key, value)
    return false

fn recordStoreValidate(store: var RecordStore, rec: Record): bool =
    if ! verifyRecordSignature(rec):
        return false
    let normalizedKey: str = normalizePath(rec.key)
    var candidate: str = normalizedKey
    while true:
        let idx: int32 = findValidatorIndex(store, candidate)
        if idx >= 0:
            let keyCopy: str = rec.key
            let valueCopy: Bytes = BytesSlice(rec.value, 0, BytesLen(rec.value))
            let entry: RecordValidatorEntry = store.validators[idx]
            return callBuiltinRecordValidator(entry.prefix, store, keyCopy, valueCopy)
        var i: int32 = len(candidate) - 1
        var slashIdx: int32 = -1
        let loop_start_i_validator = i
        for loop_rev_i_validator in 0..(loop_start_i_validator - (0)):
            i = loop_start_i_validator - loop_rev_i_validator
            if ! (i >= 0):
                break
            if candidate[i] == '/':
                slashIdx = i
                break
        if slashIdx < 0:
            break
        candidate = SliceBytes(candidate, 0, slashIdx)
    let emptyIdx: int32 = findValidatorIndex(store, "")
    if emptyIdx >= 0:
        let keyCopy: str = rec.key
        let valueCopy: Bytes = BytesSlice(rec.value, 0, BytesLen(rec.value))
        let entry: RecordValidatorEntry = store.validators[emptyIdx]
        return callBuiltinRecordValidator(entry.prefix, store, keyCopy, valueCopy)
    return true

fn initRecordStore(): RecordStore =
    var store: RecordStore = RecordStore(
        count: 0,
        ipnsCount: 0,
        iprsCount: 0,
        ipnsNamespaceCount: 0,
        iprsNamespaceCount: 0,
        defaultIpnsPolicy: defaultIpnsPolicy(),
        defaultIprsPolicy: defaultIprsPolicy(),
        acceptUnregisteredIprsNamespaces: true
    )
    registerPeerRecordValidator(store)
    registerPkValidator(store)
    registerIpnsValidator(store)
    registerIprsValidator(store)
    registerDidChengValidator(store)
    return store
