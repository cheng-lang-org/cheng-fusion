fn setIprsAcceptUnregisteredNamespaces(store: var RecordStore, accept: bool) =
    store.acceptUnregisteredIprsNamespaces = accept

fn addIprsAllowedPeer(store: var RecordStore, namespace: str, peerId: PeerId): Result[bool] =
    let normalized: str = normalizePath(namespace)
    if len(normalized) <= 0:
        if peerIdListAdd(store.defaultIprsPolicy.allowedPeers, peerId):
            return Ok[bool](true)
        return Err[bool]("record: iprs allow list full")
    var idx: int32 = findIprsNamespaceIndex(store, normalized)
    if idx < 0:
        if store.iprsNamespaceCount >= maxIprsNamespaces:
            return Err[bool]("record: iprs namespace list full")
        store.iprsNamespaces[store.iprsNamespaceCount] = IprsNamespaceEntry(
            name: normalized,
            policy: defaultIprsPolicy()
        )
        idx = store.iprsNamespaceCount
        store.iprsNamespaceCount = store.iprsNamespaceCount + 1
    if peerIdListAdd(store.iprsNamespaces[idx].policy.allowedPeers, peerId):
        return Ok[bool](true)
    return Err[bool]("record: iprs allow list full")

fn removeIprsAllowedPeer(store: var RecordStore, namespace: str, peerId: PeerId): bool =
    let normalized: str = normalizePath(namespace)
    if len(normalized) <= 0:
        return peerIdListRemove(store.defaultIprsPolicy.allowedPeers, peerId)
    let idx: int32 = findIprsNamespaceIndex(store, normalized)
    if idx < 0:
        return false
    return peerIdListRemove(store.iprsNamespaces[idx].policy.allowedPeers, peerId)

