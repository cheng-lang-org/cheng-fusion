# Bitswap advertiser(minimal, local provider updates).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/option
import cheng/libp2p/cid
import cheng/libp2p/peerid
import cheng/libp2p/peerstore
import cheng/libp2p/protocols/bitswap/store
import cheng/libp2p/protocols/kademlia
const
    maxBitswapAdvertise = 64

type
    BitswapAdvertiser =
        count: int32
        cids: Cid[maxBitswapAdvertise]

fn initBitswapAdvertiser(): BitswapAdvertiser =
    BitswapAdvertiser(count: 0)

fn bitswapAdvertiserClear(ad: var BitswapAdvertiser) =
    ad.count = 0

fn bitswapAdvertiserAdd(ad: var BitswapAdvertiser, cid: Cid): Result[bool] =
    if ad.count >= maxBitswapAdvertise:
        return Err[bool]("bitswapadvertiser: full")
    ad.cids[ad.count] = cid
    ad.count = ad.count + 1
    return Ok[bool](true)

fn bitswapAdvertiseKeyLocal(peerId: PeerId, key: Key): Result[bool] =
    if ! kademliaContextReady():
        return Err[bool]("bitswapadvertiser: kademlia context missing")
    var state: KadState
    var store: PeerStore
    if ! kademliaTryGetState(state) || ! kademliaTryGetPeerStore(store):
        return Err[bool]("bitswapadvertiser: missing kademlia state")
    let peerRes: Result[KadPeer] = peerToKadPeer(peerId, store)
    if IsErr(peerRes):
        return Err[bool](Error(peerRes))
    if ! addKadProvider(state.store, key, Value(peerRes)):
        return Err[bool]("bitswapadvertiser: add provider failed")
    setKademliaState(state)
    return Ok[bool](true)

fn bitswapAdvertiseCidLocal(peerId: PeerId, cid: Cid): Result[bool] =
    let keyRes: Result[Bytes] = cidToBytes(cid)
    if IsErr(keyRes):
        return Err[bool](Error(keyRes))
    return bitswapAdvertiseKeyLocal(peerId, Value(keyRes))

fn bitswapAdvertiseStoreLocal(peerId: PeerId, store: BitswapBlockStore): Result[int32] =
    var advertised: int32
    for i in 0..<store.count:
        if store.entries[i].used:
            let advRes: Result[bool] = bitswapAdvertiseKeyLocal(peerId, store.entries[i].key)
            if IsOk(advRes):
                advertised = advertised + 1
    return Ok[int32](advertised)

fn bitswapAdvertiseAll(ad: BitswapAdvertiser, peerId: PeerId): Result[int32] =
    var advertised: int32
    for i in 0..<ad.count:
        let advRes: Result[bool] = bitswapAdvertiseCidLocal(peerId, ad.cids[i])
        if IsOk(advRes):
            advertised = advertised + 1
    return Ok[int32](advertised)
