# Mplex muxer wrapper(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
type
    MplexMuxer =
        mux: Muxer

    MplexStream =
        stream: Stream

fn newMplexMuxer(conn: Connection): Result[MplexMuxer] =
    let muxRes: Result[Muxer] = newMuxerWithKind(conn, muxerKindMplex)
    if IsErr(muxRes):
        return Err[MplexMuxer](Error(muxRes))
    return Ok[MplexMuxer](MplexMuxer(mux: Value(muxRes)))

fn mplexIsOpen(m: MplexMuxer): bool =
    return MuxerIsOpen(m.mux)

fn mplexConnection(m: MplexMuxer): Connection =
    return muxerConnection(m.mux)

fn mplexOpenStream(m: var MplexMuxer): Result[MplexStream] =
    let streamRes: Result[Stream] = openStream(m.mux)
    if IsErr(streamRes):
        return Err[MplexStream](Error(streamRes))
    return Ok[MplexStream](MplexStream(stream: Value(streamRes)))

fn mplexAcceptStream(m: var MplexMuxer): Result[MplexStream] =
    let streamRes: Result[Stream] = acceptStream(m.mux)
    if IsErr(streamRes):
        return Err[MplexStream](Error(streamRes))
    return Ok[MplexStream](MplexStream(stream: Value(streamRes)))

fn mplexRead(s: var MplexStream, count: int32): Result[Bytes] =
    return read(s.stream, count)

fn mplexWrite(s: var MplexStream, data: Bytes): Result[int32] =
    return write(s.stream, data)

fn mplexStreamIsOpen(s: MplexStream): bool =
    return streamIsOpen(s.stream)

fn mplexCloseStream(s: var MplexStream): Result[bool] =
    return closeStream(s.stream)

fn mplexResetStream(s: var MplexStream): Result[bool] =
    return resetStream(s.stream)
