# Mplex frame encoder/decoder(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/varint
type
    MplexFrameDecode =
        streamId: int32
        msgType: int32
        payload: Bytes
        next: int32

const
    mplexTypeNew = 0
    mplexTypeMsgIn = 1
    mplexTypeMsgOut = 2
    mplexTypeCloseIn = 3
    mplexTypeCloseOut = 4
    mplexTypeResetIn = 5
    mplexTypeResetOut = 6
    mplexMaxPayload = 1048576

fn mplexEncodeFrame(streamId: int32, msgType: int32, payload: Bytes): Result[Bytes] =
    if streamId < 0:
        return Err[Bytes]("mplex: invalid stream id")
    if msgType < 0 || msgType > mplexTypeResetOut:
        return Err[Bytes]("mplex: invalid message type")
    let header: int64 = (int64(streamId) << 3) + int64(msgType)
    let headerBytes: Bytes = encodeUVarint(header)
    let lenBytes: Bytes = encodeUVarint(int64(BytesLen(payload)))
    let head: Bytes = BytesConcat(headerBytes, lenBytes)
    return Ok[Bytes](BytesConcat(head, payload))

fn mplexDecodeFrame(data: Bytes, offset: int32, maxPayload: int32): Result[MplexFrameDecode] =
    let headerRes: Result[VarintDecoded] = decodeUVarint(data, offset)
    if IsErr(headerRes):
        return Err[MplexFrameDecode](Error(headerRes))
    let header: int64 = Value(headerRes).value
    if header < 0:
        return Err[MplexFrameDecode]("mplex: invalid header")
    let msgType64: int64 = header % 8
    if msgType64 < 0 || msgType64 > mplexTypeResetOut:
        return Err[MplexFrameDecode]("mplex: invalid message type")
    let streamId64: int64 = header / 8
    if streamId64 < 0 || streamId64 > 2147483647:
        return Err[MplexFrameDecode]("mplex: stream id out of range")
    let lenRes: Result[VarintDecoded] = decodeUVarint(data, Value(headerRes).next)
    if IsErr(lenRes):
        return Err[MplexFrameDecode](Error(lenRes))
    let length64: int64 = Value(lenRes).value
    if length64 < 0 || length64 > 2147483647:
        return Err[MplexFrameDecode]("mplex: length out of range")
    let length: int32 = int32(length64)
    if maxPayload > 0 && length > maxPayload:
        return Err[MplexFrameDecode]("mplex: payload too large")
    if length > mplexMaxPayload:
        return Err[MplexFrameDecode]("mplex: payload exceeds limit")
    let start: int32 = Value(lenRes).next
    if start + length > BytesLen(data):
        return Err[MplexFrameDecode]("mplex: truncated frame")
    let payload: Bytes = if length > 0: BytesSlice(data, start, length) else: EmptyBytes()
    return Ok[MplexFrameDecode](
        MplexFrameDecode(streamId: int32(streamId64), msgType: int32(msgType64), payload: payload, next: start + length)
    )
