# Length-prefixed channel over BufferStream(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/varint
import cheng/libp2p/stream/bufferstream
const
    lpChannelReadChunk = 4096
    lpChannelMaxFrame = 1048576

type
    LpChannel =
        stream: BufferStream
        maxFrame: int32
        rxBuffer: Bytes

fn newLpChannel(maxFrame: int32): LpChannel =
    let cap: int32 = if maxFrame > 0: maxFrame else: lpChannelMaxFrame
    let stream: BufferStream = newBufferStream()
    let rx: Bytes = EmptyBytes()
    return LpChannel(stream: stream, maxFrame: cap, rxBuffer: rx)

fn lpChannelAvailable(ch: LpChannel): int32 =
    return available(ch.stream)

fn lpChannelIsClosed(ch: LpChannel): bool =
    return isClosed(ch.stream)

fn lpChannelClose(ch: var LpChannel) =
    close(ch.stream)

fn lpChannelWrite(ch: var LpChannel, payload: Bytes): Result[int32] =
    let size: int32 = BytesLen(payload)
    if size < 0:
        return Err[int32]("lpchannel: invalid length")
    if ch.maxFrame > 0 && size > ch.maxFrame:
        return Err[int32]("lpchannel: frame too large")
    let lenBytes: Bytes = encodeUVarint(int64(size))
    let frame: Bytes = BytesConcat(lenBytes, payload)
    return write(ch.stream, frame)

fn lpChannelFeed(ch: var LpChannel, data: Bytes): Result[int32] =
    return write(ch.stream, data)

fn decodeVarintPartial(data: Bytes, offset: int32, value: var int64, next: var int32): int32 =
    if offset < 0:
        return 2
    var mul: int64 = 1
    var result: int64
    for i in offset..<BytesLen(data):
        let b: int32 = BytesGet(data, i)
        let low: int32 = b % 128
        result = result + (int64(low) * mul)
        if b < 128:
            value = result
            next = i + 1
            return 0
        mul = mul * 128
        if mul <= 0:
            return 2
    return 1

fn dropFront(data: Bytes, count: int32): Bytes =
    if count <= 0:
        return data
    let total: int32 = BytesLen(data)
    if count >= total:
        return EmptyBytes()
    return BytesSlice(data, count, total - count)

fn lpChannelRead(ch: var LpChannel): Result[Bytes] =
    let chunkRes: Result[Bytes] = read(ch.stream, lpChannelReadChunk)
    if IsErr(chunkRes):
        return Err[Bytes](Error(chunkRes))
    let chunk: Bytes = Value(chunkRes)
    if BytesLen(chunk) > 0:
        ch.rxBuffer = BytesConcat(ch.rxBuffer, chunk)
    if BytesLen(ch.rxBuffer) <= 0:
        return Ok[Bytes](EmptyBytes())
    var length64: int64
    var idx: int32
    let st: int32 = decodeVarintPartial(ch.rxBuffer, 0, length64, idx)
    if st == 1:
        return Ok[Bytes](EmptyBytes())
    if st == 2:
        return Err[Bytes]("lpchannel: bad length varint")
    if length64 < 0 || length64 > 2147483647:
        return Err[Bytes]("lpchannel: length out of range")
    let length: int32 = int32(length64)
    if ch.maxFrame > 0 && length > ch.maxFrame:
        return Err[Bytes]("lpchannel: frame too large")
    if idx + length > BytesLen(ch.rxBuffer):
        return Ok[Bytes](EmptyBytes())
    let payload: Bytes = if length > 0: BytesSlice(ch.rxBuffer, idx, length) else: EmptyBytes()
    ch.rxBuffer = dropFront(ch.rxBuffer, idx + length)
    return Ok[Bytes](payload)
