# DID credentials: delegation proof && revocation record.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/stringlist
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/peerid
import cheng/libp2p/crypto/crypto
import cheng/libp2p/signed_envelope
import cheng/libp2p/did/types
import cheng/libp2p/did/document as diddocument

const
    didDelegationFieldDid = 1
    didDelegationFieldVersion = 2
    didDelegationFieldIssuedAtNs = 3
    didDelegationFieldDevice = 4

    didRevocationFieldDid = 1
    didRevocationFieldVersion = 2
    didRevocationFieldRevokedAtNs = 3
    didRevocationFieldDevicePeer = 4

fn didDelegationPayloadDomain(): str =
    return "did:cheng-delegation"

fn didDelegationPayloadType(): Bytes =
    let out: Bytes = BytesAlloc(2)
    BytesSet(out, 0, 0x65)
    BytesSet(out, 1, 0x01)
    return out

fn didRevocationPayloadDomain(): str =
    return "did:cheng-revocation"

fn didRevocationPayloadType(): Bytes =
    let out: Bytes = BytesAlloc(2)
    BytesSet(out, 0, 0x66)
    BytesSet(out, 1, 0x01)
    return out

@borrows
fn credentialRootPeerId(did: str): Result[PeerId] =
    let prefix: str = "did:cheng:"
    let prefixLen: int32 = len(prefix)
    if len(did) <= prefixLen:
        return Err[PeerId]("did: invalid")
    for i in 0..<prefixLen:
        if did[i] != prefix[i]:
            return Err[PeerId]("did: unsupported method")
    let peerText: str = SliceBytes(did, prefixLen, len(did) - prefixLen)
    return parsePeerId(peerText)

fn credentialFindDevice(doc: DidDocumentV1, peerText: str): Result[DeviceMethodV1] =
    if len(peerText) <= 0:
        return Err[DeviceMethodV1]("did: empty device peer")
    for i in 0..<doc.deviceCount:
        if doc.devices[i].devicePeerId == peerText:
            return Ok[DeviceMethodV1](doc.devices[i])
    return Err[DeviceMethodV1]("did: device ! found")

fn EncodeDeviceDelegationProofRaw(proof: DeviceDelegationProofV1): Result[Bytes] =
    if len(proof.did) <= 0:
        return Err[Bytes]("did: delegation missing did")
    let didRes: Result[PeerId] = credentialRootPeerId(proof.did)
    if IsErr(didRes):
        return Err[Bytes](Error(didRes))
    if proof.version <= 0:
        return Err[Bytes]("did: delegation invalid version")
    let devRes: Result[Bytes] = diddocument.EncodeDeviceMethodV1(proof.device)
    if IsErr(devRes):
        return Err[Bytes](Error(devRes))
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeString(pb, didDelegationFieldDid, proof.did)
    minprotobuf.writeVarint(pb, didDelegationFieldVersion, proof.version)
    if proof.issuedAtNs > 0:
        minprotobuf.writeVarint(pb, didDelegationFieldIssuedAtNs, proof.issuedAtNs)
    minprotobuf.writeBytes(pb, didDelegationFieldDevice, Value(devRes))
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

fn DecodeDeviceDelegationProofRaw(data: Bytes): Result[DeviceDelegationProofV1] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var out: DeviceDelegationProofV1
    var didText: str
    let didRes: Result[bool] = minprotobuf.getField(pb, didDelegationFieldDid, didText)
    if IsErr(didRes):
        return Err[DeviceDelegationProofV1](Error(didRes))
    if ! Value(didRes):
        return Err[DeviceDelegationProofV1]("did: delegation missing did")
    out.did = didText
    var version: int64
    let verRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didDelegationFieldVersion, version)
    if IsErr(verRes):
        return Err[DeviceDelegationProofV1](Error(verRes))
    if ! Value(verRes):
        return Err[DeviceDelegationProofV1]("did: delegation missing version")
    out.version = version
    var issued: int64
    let issuedRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didDelegationFieldIssuedAtNs, issued)
    if IsErr(issuedRes):
        return Err[DeviceDelegationProofV1](Error(issuedRes))
    if Value(issuedRes):
        out.issuedAtNs = issued
    var deviceBytes: Bytes = EmptyBytes()
    let devRes: Result[bool] = minprotobuf.getField(pb, didDelegationFieldDevice, deviceBytes)
    if IsErr(devRes):
        return Err[DeviceDelegationProofV1](Error(devRes))
    if ! Value(devRes):
        return Err[DeviceDelegationProofV1]("did: delegation missing device")
    let methodRes: Result[DeviceMethodV1] = diddocument.DecodeDeviceMethodV1(deviceBytes)
    if IsErr(methodRes):
        return Err[DeviceDelegationProofV1](Error(methodRes))
    out.device = Value(methodRes)
    return Ok[DeviceDelegationProofV1](out)

fn encodeDeviceDelegationProofRaw(proof: DeviceDelegationProofV1): Result[Bytes] =
    return EncodeDeviceDelegationProofRaw(proof)

fn decodeDeviceDelegationProofRaw(data: Bytes): Result[DeviceDelegationProofV1] =
    return DecodeDeviceDelegationProofRaw(data)

fn SignDeviceDelegationProof(proof: DeviceDelegationProofV1, rootPriv: PrivateKey): Result[Bytes] =
    let rawRes: Result[Bytes] = EncodeDeviceDelegationProofRaw(proof)
    if IsErr(rawRes):
        return Err[Bytes](Error(rawRes))
    let envRes: Result[Envelope] = InitEnvelope(
        rootPriv,
        didDelegationPayloadType(),
        Value(rawRes),
        didDelegationPayloadDomain()
    )
    if IsErr(envRes):
        return Err[Bytes](Error(envRes))
    return EncodeEnvelope(Value(envRes))

fn CreateAndSignDeviceDelegationProof(
    did: str,
    version: int64,
    issuedAtNs: int64,
    method: DeviceMethodV1,
    rootPriv: PrivateKey
): Result[Bytes] =
    var proof: DeviceDelegationProofV1
    proof.did = did
    proof.version = version
    proof.issuedAtNs = issuedAtNs
    proof.device = method
    return SignDeviceDelegationProof(proof, rootPriv)

fn DecodeSignedDeviceDelegationProof(data: Bytes): Result[DeviceDelegationProofV1] =
    let envRes: Result[Envelope] = DecodeEnvelope(data, didDelegationPayloadDomain())
    if IsErr(envRes):
        return Err[DeviceDelegationProofV1](Error(envRes))
    let env: Envelope = Value(envRes)
    if ! BytesEqual(env.payloadType, didDelegationPayloadType()):
        return Err[DeviceDelegationProofV1]("did: delegation wrong payload type")
    let proofRes: Result[DeviceDelegationProofV1] = DecodeDeviceDelegationProofRaw(env.payload)
    if IsErr(proofRes):
        return Err[DeviceDelegationProofV1](Error(proofRes))
    return Ok[DeviceDelegationProofV1](Value(proofRes))

fn VerifyDeviceDelegationProofWithRoot(
    data: Bytes,
    did: str,
    rootMethod: PublicKey
): Result[DeviceDelegationProofV1] =
    let envRes: Result[Envelope] = DecodeEnvelope(data, didDelegationPayloadDomain())
    if IsErr(envRes):
        return Err[DeviceDelegationProofV1](Error(envRes))
    let env: Envelope = Value(envRes)
    if ! BytesEqual(env.payloadType, didDelegationPayloadType()):
        return Err[DeviceDelegationProofV1]("did: delegation wrong payload type")
    if ! diddocument.DidPublicKeyEqual(env.publicKey, rootMethod):
        return Err[DeviceDelegationProofV1]("did: delegation signer mismatch")
    let proofRes: Result[DeviceDelegationProofV1] = DecodeDeviceDelegationProofRaw(env.payload)
    if IsErr(proofRes):
        return Err[DeviceDelegationProofV1](Error(proofRes))
    let proof: DeviceDelegationProofV1 = Value(proofRes)
    if (proof.did != did):
        return Err[DeviceDelegationProofV1]("did: delegation did mismatch")
    return Ok[DeviceDelegationProofV1](proof)

fn VerifyDeviceDelegationProofWithDid(data: Bytes, did: str): Result[DeviceDelegationProofV1] =
    let envRes: Result[Envelope] = DecodeEnvelope(data, didDelegationPayloadDomain())
    if IsErr(envRes):
        return Err[DeviceDelegationProofV1](Error(envRes))
    let env: Envelope = Value(envRes)
    if ! BytesEqual(env.payloadType, didDelegationPayloadType()):
        return Err[DeviceDelegationProofV1]("did: delegation wrong payload type")
    let rootPidRes: Result[PeerId] = credentialRootPeerId(did)
    if IsErr(rootPidRes):
        return Err[DeviceDelegationProofV1](Error(rootPidRes))
    if ! peerIdMatchesPublicKey(Value(rootPidRes), env.publicKey):
        return Err[DeviceDelegationProofV1]("did: delegation signer ! root")
    let proofRes: Result[DeviceDelegationProofV1] = DecodeDeviceDelegationProofRaw(env.payload)
    if IsErr(proofRes):
        return Err[DeviceDelegationProofV1](Error(proofRes))
    let proof: DeviceDelegationProofV1 = Value(proofRes)
    if (proof.did != did):
        return Err[DeviceDelegationProofV1]("did: delegation did mismatch")
    return Ok[DeviceDelegationProofV1](proof)

fn VerifyDeviceDelegationProofWithDocument(data: Bytes, doc: DidDocumentV1): Result[DeviceDelegationProofV1] =
    let proofRes: Result[DeviceDelegationProofV1] = VerifyDeviceDelegationProofWithRoot(data, doc.id, doc.rootMethod)
    if IsErr(proofRes):
        return Err[DeviceDelegationProofV1](Error(proofRes))
    let proof: DeviceDelegationProofV1 = Value(proofRes)
    let deviceRes: Result[DeviceMethodV1] = credentialFindDevice(doc, proof.device.devicePeerId)
    if IsErr(deviceRes):
        return Err[DeviceDelegationProofV1](Error(deviceRes))
    let docDevice: DeviceMethodV1 = Value(deviceRes)
    if docDevice.status != didDeviceActive:
        return Err[DeviceDelegationProofV1]("did: device revoked")
    if ! diddocument.DidPublicKeyEqual(docDevice.devicePubKey, proof.device.devicePubKey):
        return Err[DeviceDelegationProofV1]("did: device pub mismatch")
    return Ok[DeviceDelegationProofV1](proof)

fn EncodeDidRevocationRaw(rev: DidRevocationV1): Result[Bytes] =
    if len(rev.did) <= 0:
        return Err[Bytes]("did: revocation missing did")
    if len(rev.devicePeerId) <= 0:
        return Err[Bytes]("did: revocation missing device")
    let pidRes: Result[PeerId] = parsePeerId(rev.devicePeerId)
    if IsErr(pidRes):
        return Err[Bytes](Error(pidRes))
    if rev.version <= 0:
        return Err[Bytes]("did: revocation invalid version")
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeString(pb, didRevocationFieldDid, rev.did)
    minprotobuf.writeVarint(pb, didRevocationFieldVersion, rev.version)
    if rev.revokedAtNs > 0:
        minprotobuf.writeVarint(pb, didRevocationFieldRevokedAtNs, rev.revokedAtNs)
    minprotobuf.writeString(pb, didRevocationFieldDevicePeer, rev.devicePeerId)
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

@borrows
fn DecodeDidRevocationRaw(data: Bytes): Result[DidRevocationV1] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var rev: DidRevocationV1
    var didText: str
    let didRes: Result[bool] = minprotobuf.getField(pb, didRevocationFieldDid, didText)
    if IsErr(didRes):
        return Err[DidRevocationV1](Error(didRes))
    if ! Value(didRes):
        return Err[DidRevocationV1]("did: revocation missing did")
    rev.did = didText
    var version: int64
    let verRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didRevocationFieldVersion, version)
    if IsErr(verRes):
        return Err[DidRevocationV1](Error(verRes))
    if ! Value(verRes):
        return Err[DidRevocationV1]("did: revocation missing version")
    rev.version = version
    var revokedAt: int64
    let atRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didRevocationFieldRevokedAtNs, revokedAt)
    if IsErr(atRes):
        return Err[DidRevocationV1](Error(atRes))
    if Value(atRes):
        rev.revokedAtNs = revokedAt
    var peerText: str
    let peerRes: Result[bool] = minprotobuf.getField(pb, didRevocationFieldDevicePeer, peerText)
    if IsErr(peerRes):
        return Err[DidRevocationV1](Error(peerRes))
    if ! Value(peerRes):
        return Err[DidRevocationV1]("did: revocation missing device")
    rev.devicePeerId = peerText
    let pidRes: Result[PeerId] = parsePeerId(rev.devicePeerId)
    if IsErr(pidRes):
        return Err[DidRevocationV1](Error(pidRes))
    return Ok[DidRevocationV1](rev)

fn encodeDidRevocationRaw(rev: DidRevocationV1): Result[Bytes] =
    return EncodeDidRevocationRaw(rev)

fn decodeDidRevocationRaw(data: Bytes): Result[DidRevocationV1] =
    return DecodeDidRevocationRaw(data)

fn SignDidRevocation(rev: DidRevocationV1, rootPriv: PrivateKey): Result[Bytes] =
    let rawRes: Result[Bytes] = EncodeDidRevocationRaw(rev)
    if IsErr(rawRes):
        return Err[Bytes](Error(rawRes))
    let envRes: Result[Envelope] = InitEnvelope(
        rootPriv,
        didRevocationPayloadType(),
        Value(rawRes),
        didRevocationPayloadDomain()
    )
    if IsErr(envRes):
        return Err[Bytes](Error(envRes))
    return EncodeEnvelope(Value(envRes))

@borrows
fn DecodeSignedDidRevocation(data: Bytes): Result[DidRevocationV1] =
    let envRes: Result[Envelope] = DecodeEnvelope(data, didRevocationPayloadDomain())
    if IsErr(envRes):
        return Err[DidRevocationV1](Error(envRes))
    let env: Envelope = Value(envRes)
    if ! BytesEqual(env.payloadType, didRevocationPayloadType()):
        return Err[DidRevocationV1]("did: revocation wrong payload type")
    return DecodeDidRevocationRaw(env.payload)

@borrows
fn VerifyDidRevocationWithDid(data: Bytes, did: str): Result[DidRevocationV1] =
    let envRes: Result[Envelope] = DecodeEnvelope(data, didRevocationPayloadDomain())
    if IsErr(envRes):
        return Err[DidRevocationV1](Error(envRes))
    let env: Envelope = Value(envRes)
    if ! BytesEqual(env.payloadType, didRevocationPayloadType()):
        return Err[DidRevocationV1]("did: revocation wrong payload type")
    let rootPidRes: Result[PeerId] = credentialRootPeerId(did)
    if IsErr(rootPidRes):
        return Err[DidRevocationV1](Error(rootPidRes))
    if ! peerIdMatchesPublicKey(Value(rootPidRes), env.publicKey):
        return Err[DidRevocationV1]("did: revocation signer ! root")
    let revRes: Result[DidRevocationV1] = DecodeDidRevocationRaw(env.payload)
    if IsErr(revRes):
        return Err[DidRevocationV1](Error(revRes))
    let rev: DidRevocationV1 = Value(revRes)
    if (rev.did != did):
        return Err[DidRevocationV1]("did: revocation did mismatch")
    return Ok[DidRevocationV1](rev)

@borrows
fn VerifyDidRevocationWithDocument(data: Bytes, doc: DidDocumentV1): Result[DidRevocationV1] =
    let envRes: Result[Envelope] = DecodeEnvelope(data, didRevocationPayloadDomain())
    if IsErr(envRes):
        return Err[DidRevocationV1](Error(envRes))
    let env: Envelope = Value(envRes)
    if ! BytesEqual(env.payloadType, didRevocationPayloadType()):
        return Err[DidRevocationV1]("did: revocation wrong payload type")
    if ! diddocument.DidPublicKeyEqual(env.publicKey, doc.rootMethod):
        return Err[DidRevocationV1]("did: revocation signer mismatch")
    let revRes: Result[DidRevocationV1] = DecodeDidRevocationRaw(env.payload)
    if IsErr(revRes):
        return Err[DidRevocationV1](Error(revRes))
    let rev: DidRevocationV1 = Value(revRes)
    if (rev.did != doc.id):
        return Err[DidRevocationV1]("did: revocation did mismatch")
    return Ok[DidRevocationV1](rev)
