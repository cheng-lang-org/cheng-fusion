# Biometric assertion helpers(local-only claim model).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/stringlist
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/crypto/sha256
import cheng/libp2p/vbuffer
import cheng/libp2p/peerid
import cheng/libp2p/did/types

const
    bioFieldDevicePeer = 1
    bioFieldChallengeHash = 2
    bioFieldVerifiedAtNs = 3
    bioFieldModalities = 4
    bioFieldLocalOnly = 5

fn biometricAssertionHashInput(did: str, peerText: str, nonceA: Bytes, nonceB: Bytes): Bytes =
    var vb: VBuffer = newVBuffer()
    writeSeq(vb, did)
    writeSeq(vb, peerText)
    writeSeq(vb, nonceA)
    writeSeq(vb, nonceB)
    return toBytes(vb)

fn biometricChallengeHash(did: str, peerText: str, nonceA: Bytes, nonceB: Bytes): Bytes =
    return Sha256Digest(biometricAssertionHashInput(did, peerText, nonceA, nonceB))

fn EncodeBiometricAssertion(assertion: BiometricAssertionV1): Result[Bytes] =
    if len(assertion.devicePeerId) <= 0:
        return Err[Bytes]("did: biometric missing peer")
    let pidRes: Result[PeerId] = parsePeerId(assertion.devicePeerId)
    if IsErr(pidRes):
        return Err[Bytes](Error(pidRes))
    if BytesLen(assertion.challengeHash) <= 0:
        return Err[Bytes]("did: biometric missing challenge hash")
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeString(pb, bioFieldDevicePeer, assertion.devicePeerId)
    minprotobuf.writeBytes(pb, bioFieldChallengeHash, assertion.challengeHash)
    if assertion.verifiedAtNs > 0:
        minprotobuf.writeVarint(pb, bioFieldVerifiedAtNs, assertion.verifiedAtNs)
    for i in 0..<assertion.modalities.count:
        minprotobuf.writeBytes(pb, bioFieldModalities, BytesFromString(assertion.modalities.items[i]))
    if assertion.localOnly:
        minprotobuf.writeVarint(pb, bioFieldLocalOnly, 1)
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

fn DecodeBiometricAssertion(data: Bytes): Result[BiometricAssertionV1] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var out: BiometricAssertionV1
    out.challengeHash = EmptyBytes()
    out.modalities = InitStringList()
    out.localOnly = true
    var peerText: str
    let peerRes: Result[bool] = minprotobuf.getField(pb, bioFieldDevicePeer, peerText)
    if IsErr(peerRes):
        return Err[BiometricAssertionV1](Error(peerRes))
    if ! Value(peerRes):
        return Err[BiometricAssertionV1]("did: biometric missing peer")
    out.devicePeerId = peerText
    var hash: Bytes = EmptyBytes()
    let hashRes: Result[bool] = minprotobuf.getField(pb, bioFieldChallengeHash, hash)
    if IsErr(hashRes):
        return Err[BiometricAssertionV1](Error(hashRes))
    if ! Value(hashRes):
        return Err[BiometricAssertionV1]("did: biometric missing challenge hash")
    out.challengeHash = hash
    var verifiedAt: int64
    let verifiedRes: Result[bool] = minprotobuf.GetFieldInt64(pb, bioFieldVerifiedAtNs, verifiedAt)
    if IsErr(verifiedRes):
        return Err[BiometricAssertionV1](Error(verifiedRes))
    if Value(verifiedRes):
        out.verifiedAtNs = verifiedAt
    var modalityItems: minprotobuf.RepeatedBytes = minprotobuf.InitRepeatedBytes()
    let modsRes: Result[bool] = minprotobuf.GetRepeatedBytesField(pb, bioFieldModalities, modalityItems)
    if IsErr(modsRes):
        return Err[BiometricAssertionV1](Error(modsRes))
    if Value(modsRes):
        for i in 0..<modalityItems.count:
            let addRes: Result[bool] = StringListAdd(out.modalities, BytesToString(modalityItems.items[i]))
            if IsErr(addRes):
                return Err[BiometricAssertionV1](Error(addRes))
    var localOnlyVal: int64
    let localOnlyRes: Result[bool] = minprotobuf.GetFieldInt64(pb, bioFieldLocalOnly, localOnlyVal)
    if IsErr(localOnlyRes):
        return Err[BiometricAssertionV1](Error(localOnlyRes))
    if Value(localOnlyRes):
        out.localOnly = localOnlyVal != 0
    let pidRes: Result[PeerId] = parsePeerId(out.devicePeerId)
    if IsErr(pidRes):
        return Err[BiometricAssertionV1](Error(pidRes))
    return Ok[BiometricAssertionV1](out)

fn BuildBiometricAssertion(
    did: str,
    peerText: str,
    nonceA: Bytes,
    nonceB: Bytes,
    verifiedAtNs: int64,
    modalities: StringList
): Result[BiometricAssertionV1] =
    if len(peerText) <= 0:
        return Err[BiometricAssertionV1]("did: biometric missing peer")
    let pidRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(pidRes):
        return Err[BiometricAssertionV1](Error(pidRes))
    var out: BiometricAssertionV1
    out.devicePeerId = peerText
    out.challengeHash = biometricChallengeHash(did, peerText, nonceA, nonceB)
    out.verifiedAtNs = verifiedAtNs
    out.modalities = modalities
    out.localOnly = true
    return Ok[BiometricAssertionV1](out)

fn VerifyBiometricAssertion(
    assertion: BiometricAssertionV1,
    did: str,
    expectedPeerText: str,
    nonceA: Bytes,
    nonceB: Bytes
): bool =
    if ! assertion.localOnly:
        return false
    if len(expectedPeerText) <= 0:
        return false
    if assertion.devicePeerId != expectedPeerText:
        return false
    let expectedHash: Bytes = biometricChallengeHash(did, expectedPeerText, nonceA, nonceB)
    return BytesEqual(assertion.challengeHash, expectedHash)

fn encodeBiometricAssertion(assertion: BiometricAssertionV1): Result[Bytes] =
    return EncodeBiometricAssertion(assertion)

fn decodeBiometricAssertion(data: Bytes): Result[BiometricAssertionV1] =
    return DecodeBiometricAssertion(data)

fn buildBiometricAssertion(
    did: str,
    peerText: str,
    nonceA: Bytes,
    nonceB: Bytes,
    verifiedAtNs: int64,
    modalities: StringList
): Result[BiometricAssertionV1] =
    return BuildBiometricAssertion(did, peerText, nonceA, nonceB, verifiedAtNs, modalities)

fn verifyBiometricAssertion(
    assertion: BiometricAssertionV1,
    did: str,
    expectedPeerText: str,
    nonceA: Bytes,
    nonceB: Bytes
): bool =
    return VerifyBiometricAssertion(assertion, did, expectedPeerText, nonceA, nonceB)
