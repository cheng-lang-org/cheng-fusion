# DID resolver(cache + DHT key conventions).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/peerid
import cheng/libp2p/did/types
import cheng/libp2p/did/document
import cheng/libp2p/did/credential
import std/seqs

const
    didResolverMaxDocs = 64
    didResolverMaxRevocations = 256

type
    DidDocumentCacheEntry =
        did: str
        version: int64
        updatedAtNs: int64
        document: DidDocumentV1
        raw: Bytes

    DidRevocationCacheEntry =
        did: str
        version: int64
        revokedAtNs: int64
        devicePeerId: str

    DidResolverCache =
        docCount: int32
        docs: DidDocumentCacheEntry[]
        revCount: int32
        revocations: DidRevocationCacheEntry[]

var
    didResolverCache: DidResolverCache

fn ensureDidResolverTables() =
    if len(didResolverCache.docs) < didResolverMaxDocs:
        setLen(didResolverCache.docs, didResolverMaxDocs)
    if len(didResolverCache.revocations) < didResolverMaxRevocations:
        setLen(didResolverCache.revocations, didResolverMaxRevocations)

fn didDocumentDhtKeyFromDid(did: str): Result[str] =
    let rootRes: Result[str] = didRootPeerText(did)
    if IsErr(rootRes):
        return Err[str](Error(rootRes))
    return Ok[str]("/did/cheng/" + Value(rootRes) + "/doc")

fn didRevocationDhtKey(did: str, version: int64): Result[str] =
    let rootRes: Result[str] = didRootPeerText(did)
    if IsErr(rootRes):
        return Err[str](Error(rootRes))
    return Ok[str]("/did/cheng/" + Value(rootRes) + "/rev/" + $(version))

fn didRevocationTopic(did: str): Result[str] =
    let rootRes: Result[str] = didRootPeerText(did)
    if IsErr(rootRes):
        return Err[str](Error(rootRes))
    return Ok[str]("/did/cheng/revocation/1.0.0/" + Value(rootRes))

@borrows
fn didResolverFindDocIndex(did: str): int32 =
    ensureDidResolverTables()
    for i in 0..<didResolverCache.docCount:
        let entry: DidDocumentCacheEntry = didResolverCache.docs[i]
        if entry.did == did:
            return i
    return -1

@borrows
fn didResolverFindRevIndex(did: str, devicePeerId: str): int32 =
    ensureDidResolverTables()
    for i in 0..<didResolverCache.revCount:
        let entry: DidRevocationCacheEntry = didResolverCache.revocations[i]
        if entry.did == did && entry.devicePeerId == devicePeerId:
            return i
    return -1

fn didResolverFindDevice(doc: DidDocumentV1, peerText: str): Result[DeviceMethodV1] =
    if len(peerText) <= 0:
        return Err[DeviceMethodV1]("did: empty device peer")
    for i in 0..<doc.deviceCount:
        if doc.devices[i].devicePeerId == peerText:
            return Ok[DeviceMethodV1](doc.devices[i])
    return Err[DeviceMethodV1]("did: device ! found")

fn didResolverPutDocument(doc: DidDocumentV1, raw: Bytes) =
    let idx: int32 = didResolverFindDocIndex(doc.id)
    var entry: DidDocumentCacheEntry = DidDocumentCacheEntry(
        did: doc.id,
        version: doc.version,
        updatedAtNs: doc.updatedAtNs,
        document: doc,
        raw: raw
    )
    if idx >= 0:
        didResolverCache.docs[idx] = entry
        return
    if didResolverCache.docCount < didResolverMaxDocs:
        didResolverCache.docs[didResolverCache.docCount] = entry
        didResolverCache.docCount = didResolverCache.docCount + 1
        return
    var replaceIdx: int32
    for i in 1..<didResolverCache.docCount:
        let cur: DidDocumentCacheEntry = didResolverCache.docs[i]
        let rep: DidDocumentCacheEntry = didResolverCache.docs[replaceIdx]
        if cur.updatedAtNs < rep.updatedAtNs:
            replaceIdx = i
    didResolverCache.docs[replaceIdx] = entry

@borrows
fn didResolverTryGetDocument(did: str, outDoc: var DidDocumentV1): bool =
    let idx: int32 = didResolverFindDocIndex(did)
    if idx < 0:
        return false
    let entry: DidDocumentCacheEntry = didResolverCache.docs[idx]
    outDoc = entry.document
    return true

fn didResolverGetRawDocument(did: str): Option[Bytes] =
    let idx: int32 = didResolverFindDocIndex(did)
    if idx < 0:
        var none: Option[Bytes]
        return none
    let entry: DidDocumentCacheEntry = didResolverCache.docs[idx]
    var some: Option[Bytes]
    some.has = true
    some.value = entry.raw
    return some

@borrows
fn didResolverPutRevocation(rev: DidRevocationV1) =
    ensureDidResolverTables()
    let idx: int32 = didResolverFindRevIndex(rev.did, rev.devicePeerId)
    var entry: DidRevocationCacheEntry
    entry.did = strings.CloneStr(rev.did)
    entry.version = rev.version
    entry.revokedAtNs = rev.revokedAtNs
    entry.devicePeerId = strings.CloneStr(rev.devicePeerId)
    if idx >= 0:
        if didResolverCache.revocations[idx].version <= rev.version:
            didResolverCache.revocations[idx] = entry
        return
    if didResolverCache.revCount < didResolverMaxRevocations:
        didResolverCache.revocations[didResolverCache.revCount] = entry
        didResolverCache.revCount = didResolverCache.revCount + 1
        return
    var replaceIdx: int32
    for i in 1..<didResolverCache.revCount:
        let cur: DidRevocationCacheEntry = didResolverCache.revocations[i]
        let rep: DidRevocationCacheEntry = didResolverCache.revocations[replaceIdx]
        if cur.revokedAtNs < rep.revokedAtNs:
            replaceIdx = i
    didResolverCache.revocations[replaceIdx] = entry

@borrows
fn didResolverIsDeviceRevoked(did: str, devicePeerId: str): bool =
    if didResolverFindRevIndex(did, devicePeerId) >= 0:
        return true
    var doc: DidDocumentV1 = initDidDocumentV1()
    if didResolverTryGetDocument(did, doc):
        let deviceRes: Result[DeviceMethodV1] = didResolverFindDevice(doc, devicePeerId)
        if IsOk(deviceRes):
            return Value(deviceRes).status == didDeviceRevoked
    return false

fn didResolverApplySignedDocument(data: Bytes): Result[DidDocumentV1] =
    let docRes: Result[DidDocumentV1] = DecodeSignedDidDocument(data)
    if IsErr(docRes):
        return Err[DidDocumentV1](Error(docRes))
    let doc: DidDocumentV1 = Value(docRes)
    didResolverPutDocument(doc, data)
    return Ok[DidDocumentV1](doc)

fn didResolverApplySignedRevocation(data: Bytes): Result[DidRevocationV1] =
    let revRes: Result[DidRevocationV1] = DecodeSignedDidRevocation(data)
    if IsErr(revRes):
        return Err[DidRevocationV1](Error(revRes))
    let rev: DidRevocationV1 = Value(revRes)
    var doc: DidDocumentV1 = initDidDocumentV1()
    var verified: DidRevocationV1 = initDidRevocationV1()
    let didOwned: str = strings.CloneStr(rev.did)
    if didResolverTryGetDocument(didOwned, doc):
        let verifyRes: Result[DidRevocationV1] = VerifyDidRevocationWithDocument(data, doc)
        if IsErr(verifyRes):
            return Err[DidRevocationV1](Error(verifyRes))
        verified = Value(verifyRes)
    else:
        let verifyRes: Result[DidRevocationV1] = VerifyDidRevocationWithDid(data, didOwned)
        if IsErr(verifyRes):
            return Err[DidRevocationV1](Error(verifyRes))
        verified = Value(verifyRes)
    didResolverPutRevocation(verified)
    return Ok[DidRevocationV1](verified)

fn didResolverReset() =
    didResolverCache.docCount = 0
    didResolverCache.revCount = 0
