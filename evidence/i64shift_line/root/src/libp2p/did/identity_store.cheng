# Local DID identity persistence + device enrollment/revocation.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/stringlist
import std/times
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/peerid
import cheng/libp2p/crypto/crypto
import cheng/libp2p/did/types
import cheng/libp2p/did/document
import cheng/libp2p/did/credential

@importc("cheng_fopen")
fn didIdentityFopen(filename, mode: cstring): int64
@importc("cheng_fclose")
fn didIdentityFclose(f: int64): int32
@importc("cheng_fread")
fn didIdentityFread(ptr: cstring, size, n: int, stream: int64): int32
@importc("cheng_fwrite")
fn didIdentityFwrite(ptr: cstring, size, n: int, stream: int64): int32
@importc("cheng_fflush")
fn didIdentityFflush(stream: int64): int32

const
    didIdentityFieldDid = 1
    didIdentityFieldRootPriv = 2
    didIdentityFieldDevicePriv = 3
    didIdentityFieldBiometricClass = 4
    didIdentityFieldBiometricCaps = 5
    didIdentityFieldSignedDocument = 6
    didIdentityFieldDelegationProof = 7

fn defaultBiometricCapabilities(): StringList =
    var out: StringList = InitStringList()
    StringListAdd(out, "fingerprint")
    StringListAdd(out, "iris")
    return out

fn didIdentityFindDevice(doc: DidDocumentV1, peerText: str): Result[DeviceMethodV1] =
    if len(peerText) <= 0:
        return Err[DeviceMethodV1]("did: empty device peer")
    for i in 0..<doc.deviceCount:
        if doc.devices[i].devicePeerId == peerText:
            return Ok[DeviceMethodV1](doc.devices[i])
    return Err[DeviceMethodV1]("did: device ! found")

fn didIdentityFromKeypairs(
    root: KeyPair,
    device: KeyPair,
    bioClass: str,
    caps: StringList
): Result[DidIdentity] =
    let rootPidRes: Result[PeerId] = peerIdFromPrivateKey(root.privateKey)
    if IsErr(rootPidRes):
        return Err[DidIdentity](Error(rootPidRes))
    let devicePidRes: Result[PeerId] = peerIdFromPrivateKey(device.privateKey)
    if IsErr(devicePidRes):
        return Err[DidIdentity](Error(devicePidRes))
    let didText: str = didFromRootPeerId(Value(rootPidRes))
    let nowNs: int64 = EpochTimeNs()
    var deviceMethod: DeviceMethodV1 = initDeviceMethodV1()
    deviceMethod.devicePeerId = toString(Value(devicePidRes))
    deviceMethod.devicePubKey = device.publicKey
    deviceMethod.status = didDeviceActive
    deviceMethod.biometricCapabilities = caps
    deviceMethod.biometricClass = if len(bioClass) > 0: bioClass else: "local"
    deviceMethod.addedAtNs = nowNs

    var doc: DidDocumentV1 = initDidDocumentV1()
    doc.id = didText
    doc.version = 1
    doc.updatedAtNs = nowNs
    doc.rootMethod = root.publicKey
    doc.devices[0] = deviceMethod
    doc.deviceCount = 1

    let signedDocRes: Result[Bytes] = SignDidDocument(doc, root.privateKey)
    if IsErr(signedDocRes):
        return Err[DidIdentity](Error(signedDocRes))

    let proofRes: Result[Bytes] = CreateAndSignDeviceDelegationProof(
        didText,
        doc.version,
        nowNs,
        deviceMethod,
        root.privateKey
    )
    if IsErr(proofRes):
        return Err[DidIdentity](Error(proofRes))

    var identity: DidIdentity = initDidIdentity()
    identity.did = didText
    identity.rootPrivateKey = root.privateKey
    identity.rootPublicKey = root.publicKey
    identity.rootPeerId = Value(rootPidRes)
    identity.devicePrivateKey = device.privateKey
    identity.devicePublicKey = device.publicKey
    identity.devicePeerId = Value(devicePidRes)
    identity.biometricCapabilities = caps
    identity.biometricClass = deviceMethod.biometricClass
    identity.document = doc
    identity.signedDocument = Value(signedDocRes)
    identity.delegationProof = Value(proofRes)
    return Ok[DidIdentity](identity)

fn createDidIdentity(): Result[DidIdentity] =
    let rootRes: Result[KeyPair] = generateKeyPair()
    if IsErr(rootRes):
        return Err[DidIdentity](Error(rootRes))
    let deviceRes: Result[KeyPair] = generateKeyPair()
    if IsErr(deviceRes):
        return Err[DidIdentity](Error(deviceRes))
    return didIdentityFromKeypairs(Value(rootRes), Value(deviceRes), "local", defaultBiometricCapabilities())

fn encodeDidIdentity(identity: DidIdentity): Result[Bytes] =
    let rootPrivRes: Result[Bytes] = encodePrivateKey(identity.rootPrivateKey)
    if IsErr(rootPrivRes):
        return Err[Bytes](Error(rootPrivRes))
    let devPrivRes: Result[Bytes] = encodePrivateKey(identity.devicePrivateKey)
    if IsErr(devPrivRes):
        return Err[Bytes](Error(devPrivRes))
    var pb: ProtoBuffer = InitProtoBuffer()
    writeString(pb, didIdentityFieldDid, identity.did)
    writeBytes(pb, didIdentityFieldRootPriv, Value(rootPrivRes))
    writeBytes(pb, didIdentityFieldDevicePriv, Value(devPrivRes))
    if len(identity.biometricClass) > 0:
        writeString(pb, didIdentityFieldBiometricClass, identity.biometricClass)
    for i in 0..<identity.biometricCapabilities.count:
        writeBytes(pb, didIdentityFieldBiometricCaps, BytesFromString(identity.biometricCapabilities.items[i]))
    if BytesLen(identity.signedDocument) > 0:
        writeBytes(pb, didIdentityFieldSignedDocument, identity.signedDocument)
    if BytesLen(identity.delegationProof) > 0:
        writeBytes(pb, didIdentityFieldDelegationProof, identity.delegationProof)
    return Ok[Bytes](protoToBytes(pb))

fn decodeDidIdentity(data: Bytes): Result[DidIdentity] =
    var pb: ProtoBuffer = InitProtoBufferFromBytes(data, 0)
    var didText: str
    let didRes: Result[bool] = getField(pb, didIdentityFieldDid, didText)
    if IsErr(didRes):
        return Err[DidIdentity](Error(didRes))
    if ! Value(didRes):
        return Err[DidIdentity]("did: missing did")

    var rootPrivRaw: Bytes = EmptyBytes()
    let rootRes: Result[bool] = getField(pb, didIdentityFieldRootPriv, rootPrivRaw)
    if IsErr(rootRes):
        return Err[DidIdentity](Error(rootRes))
    if ! Value(rootRes):
        return Err[DidIdentity]("did: missing root private key")

    var devPrivRaw: Bytes = EmptyBytes()
    let devRes: Result[bool] = getField(pb, didIdentityFieldDevicePriv, devPrivRaw)
    if IsErr(devRes):
        return Err[DidIdentity](Error(devRes))
    if ! Value(devRes):
        return Err[DidIdentity]("did: missing device private key")

    let rootPrivRes: Result[PrivateKey] = decodePrivateKey(rootPrivRaw)
    if IsErr(rootPrivRes):
        return Err[DidIdentity](Error(rootPrivRes))
    let devPrivRes: Result[PrivateKey] = decodePrivateKey(devPrivRaw)
    if IsErr(devPrivRes):
        return Err[DidIdentity](Error(devPrivRes))

    let rootPubRes: Result[PublicKey] = publicKeyFromPrivateKey(Value(rootPrivRes))
    if IsErr(rootPubRes):
        return Err[DidIdentity](Error(rootPubRes))
    let devPubRes: Result[PublicKey] = publicKeyFromPrivateKey(Value(devPrivRes))
    if IsErr(devPubRes):
        return Err[DidIdentity](Error(devPubRes))

    let rootPidRes: Result[PeerId] = peerIdFromPrivateKey(Value(rootPrivRes))
    if IsErr(rootPidRes):
        return Err[DidIdentity](Error(rootPidRes))
    let devPidRes: Result[PeerId] = peerIdFromPrivateKey(Value(devPrivRes))
    if IsErr(devPidRes):
        return Err[DidIdentity](Error(devPidRes))

    let expectedDid: str = didFromRootPeerId(Value(rootPidRes))
    if (expectedDid != didText):
        return Err[DidIdentity]("did: identity did mismatch")

    var bioClass: str = "local"
    let classRes: Result[bool] = getField(pb, didIdentityFieldBiometricClass, bioClass)
    if IsErr(classRes):
        return Err[DidIdentity](Error(classRes))
    if ! Value(classRes):
        bioClass = "local"

    var caps: StringList = InitStringList()
    var capItems: RepeatedBytes = initRepeatedBytes()
    let capsRes: Result[bool] = getRepeatedField(pb, didIdentityFieldBiometricCaps, capItems)
    if IsErr(capsRes):
        return Err[DidIdentity](Error(capsRes))
    if Value(capsRes):
        for i in 0..<capItems.count:
            let addRes: Result[bool] = StringListAdd(caps, BytesToString(capItems.items[i]))
            if IsErr(addRes):
                return Err[DidIdentity](Error(addRes))
    if caps.count <= 0:
        caps = defaultBiometricCapabilities()

    var identity: DidIdentity = initDidIdentity()
    identity.did = didText
    identity.rootPrivateKey = Value(rootPrivRes)
    identity.rootPublicKey = Value(rootPubRes)
    identity.rootPeerId = Value(rootPidRes)
    identity.devicePrivateKey = Value(devPrivRes)
    identity.devicePublicKey = Value(devPubRes)
    identity.devicePeerId = Value(devPidRes)
    identity.biometricClass = bioClass
    identity.biometricCapabilities = caps

    var signedDoc: Bytes = EmptyBytes()
    let docRes: Result[bool] = getField(pb, didIdentityFieldSignedDocument, signedDoc)
    if IsErr(docRes):
        return Err[DidIdentity](Error(docRes))
    if Value(docRes):
        let parsedRes: Result[DidDocumentV1] = DecodeSignedDidDocument(signedDoc)
        if IsErr(parsedRes):
            return Err[DidIdentity](Error(parsedRes))
        identity.document = Value(parsedRes)
        identity.signedDocument = signedDoc

    var delegationProof: Bytes = EmptyBytes()
    let proofRes: Result[bool] = getField(pb, didIdentityFieldDelegationProof, delegationProof)
    if IsErr(proofRes):
        return Err[DidIdentity](Error(proofRes))
    if Value(proofRes):
        identity.delegationProof = delegationProof

    if BytesLen(identity.signedDocument) <= 0 || identity.document.deviceCount <= 0:
        let rebuiltRes: Result[DidIdentity] = didIdentityFromKeypairs(
            KeyPair(publicKey: identity.rootPublicKey, privateKey: identity.rootPrivateKey),
            KeyPair(publicKey: identity.devicePublicKey, privateKey: identity.devicePrivateKey),
            identity.biometricClass,
            identity.biometricCapabilities
        )
        if IsErr(rebuiltRes):
            return Err[DidIdentity](Error(rebuiltRes))
        identity.document = Value(rebuiltRes).document
        identity.signedDocument = Value(rebuiltRes).signedDocument
        identity.delegationProof = Value(rebuiltRes).delegationProof

    if BytesLen(identity.delegationProof) <= 0:
        let selfMethodRes: Result[DeviceMethodV1] = didIdentityFindDevice(identity.document, toString(identity.devicePeerId))
        if IsErr(selfMethodRes):
            return Err[DidIdentity](Error(selfMethodRes))
        let newProofRes: Result[Bytes] = CreateAndSignDeviceDelegationProof(
            identity.did,
            identity.document.version,
            identity.document.updatedAtNs,
            Value(selfMethodRes),
            identity.rootPrivateKey
        )
        if IsErr(newProofRes):
            return Err[DidIdentity](Error(newProofRes))
        identity.delegationProof = Value(newProofRes)

    return Ok[DidIdentity](identity)

fn didIdentityReadFile(path: str): Result[Bytes] =
    if len(path) <= 0:
        return Err[Bytes]("did: empty identity path")
    let mode: str = "rb"
    let f: int64 = didIdentityFopen(path, mode)
    if f == 0:
        return Err[Bytes]("did: identity open failed")
    var out: Bytes = BytesAlloc(1048576)
    let n: int32 = didIdentityFread(out.data, 1, out.len, f)
    didIdentityFclose(f)
    if n <= 0:
        return Err[Bytes]("did: identity read empty")
    if n < out.len:
        out.len = n
    return Ok[Bytes](out)

fn didIdentityWriteFile(path: str, data: Bytes): Result[bool] =
    if len(path) <= 0:
        return Err[bool]("did: empty identity path")
    let mode: str = "wb"
    let f: int64 = didIdentityFopen(path, mode)
    if f == 0:
        return Err[bool]("did: identity open write failed")
    let n: int32 = didIdentityFwrite(data.data, 1, BytesLen(data), f)
    didIdentityFflush(f)
    didIdentityFclose(f)
    if n != BytesLen(data):
        return Err[bool]("did: identity short write")
    return Ok[bool](true)

fn didLoadIdentity(path: str): Result[DidIdentity] =
    let rawRes: Result[Bytes] = didIdentityReadFile(path)
    if IsErr(rawRes):
        return Err[DidIdentity](Error(rawRes))
    return decodeDidIdentity(Value(rawRes))

fn didSaveIdentity(path: str, identity: DidIdentity): Result[bool] =
    let encRes: Result[Bytes] = encodeDidIdentity(identity)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    return didIdentityWriteFile(path, Value(encRes))

fn didLoadOrCreateIdentity(path: str): Result[DidIdentity] =
    let loadRes: Result[DidIdentity] = didLoadIdentity(path)
    if IsOk(loadRes):
        return loadRes
    let createRes: Result[DidIdentity] = createDidIdentity()
    if IsErr(createRes):
        return Err[DidIdentity](Error(createRes))
    let saveRes: Result[bool] = didSaveIdentity(path, Value(createRes))
    if IsErr(saveRes):
        return Err[DidIdentity](Error(saveRes))
    return createRes

fn didIdentityRefreshCurrentDeviceProof(identity: var DidIdentity): Result[bool] =
    let methodRes: Result[DeviceMethodV1] = didIdentityFindDevice(identity.document, toString(identity.devicePeerId))
    if IsErr(methodRes):
        return Err[bool](Error(methodRes))
    let proofRes: Result[Bytes] = CreateAndSignDeviceDelegationProof(
        identity.did,
        identity.document.version,
        identity.document.updatedAtNs,
        Value(methodRes),
        identity.rootPrivateKey
    )
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    identity.delegationProof = Value(proofRes)
    return Ok[bool](true)

fn didIdentityResignDocument(identity: var DidIdentity, updatedAtNs: int64): Result[bool] =
    identity.document.updatedAtNs = updatedAtNs
    let signedDocRes: Result[Bytes] = SignDidDocument(identity.document, identity.rootPrivateKey)
    if IsErr(signedDocRes):
        return Err[bool](Error(signedDocRes))
    identity.signedDocument = Value(signedDocRes)
    return didIdentityRefreshCurrentDeviceProof(identity)

fn didIdentityEnrollDevice(
    identity: var DidIdentity,
    devicePub: PublicKey,
    biometricClass: str,
    biometricCapabilities: StringList,
    nowNs: int64,
    outProof: var Bytes
): Result[bool] =
    let pidRes: Result[PeerId] = peerIdFromPublicKey(devicePub)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    var method: DeviceMethodV1 = initDeviceMethodV1()
    method.devicePeerId = toString(Value(pidRes))
    method.devicePubKey = devicePub
    method.status = didDeviceActive
    method.biometricClass = if len(biometricClass) > 0: biometricClass else: "local"
    method.biometricCapabilities = if biometricCapabilities.count > 0: biometricCapabilities else: defaultBiometricCapabilities()
    method.addedAtNs = nowNs

    let upRes: Result[bool] = UpsertDeviceInDocument(identity.document, method)
    if IsErr(upRes):
        return Err[bool](Error(upRes))
    identity.document.version = identity.document.version + 1

    let signRes: Result[bool] = didIdentityResignDocument(identity, nowNs)
    if IsErr(signRes):
        return Err[bool](Error(signRes))

    let proofRes: Result[Bytes] = CreateAndSignDeviceDelegationProof(
        identity.did,
        identity.document.version,
        nowNs,
        method,
        identity.rootPrivateKey
    )
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    outProof = Value(proofRes)
    return Ok[bool](true)

fn didIdentityRevokeDevice(
    identity: var DidIdentity,
    devicePeerText: str,
    nowNs: int64,
    outRevocation: var Bytes
): Result[bool] =
    let revokeRes: Result[bool] = RevokeDeviceInDocument(identity.document, devicePeerText, nowNs)
    if IsErr(revokeRes):
        return Err[bool](Error(revokeRes))
    identity.document.version = identity.document.version + 1
    let signRes: Result[bool] = didIdentityResignDocument(identity, nowNs)
    if IsErr(signRes):
        return Err[bool](Error(signRes))

    var rev: DidRevocationV1 = initDidRevocationV1()
    rev.did = identity.did
    rev.version = identity.document.version
    rev.revokedAtNs = nowNs
    rev.devicePeerId = devicePeerText
    let revRes: Result[Bytes] = SignDidRevocation(rev, identity.rootPrivateKey)
    if IsErr(revRes):
        return Err[bool](Error(revRes))
    outRevocation = Value(revRes)
    return Ok[bool](true)
