# DID core types && helpers for did:cheng.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/stringlist
import cheng/libp2p/utils/bytes
import cheng/libp2p/peerid
import cheng/libp2p/crypto/crypto
import std/seqs

const
    didChengPrefix = "did:cheng:"
    maxDidDevices = 32
    maxDidServices = 32


type
    DidDeviceStatus = enum
        didDeviceUnknown = 0
        didDeviceActive = 1
        didDeviceRevoked = 2

    DeviceMethodV1 =
        devicePeerId: str
        devicePubKey: PublicKey
        status: DidDeviceStatus
        biometricCapabilities: StringList
        biometricClass: str
        addedAtNs: int64
        revokedAtNs: int64

    DidDocumentV1 =
        id: str
        version: int64
        updatedAtNs: int64
        rootMethod: PublicKey
        deviceCount: int32
        devices: DeviceMethodV1[]
        serviceCount: int32
        services: str[]

    DeviceDelegationProofV1 =
        did: str
        version: int64
        issuedAtNs: int64
        device: DeviceMethodV1

    DidRevocationV1 =
        did: str
        version: int64
        revokedAtNs: int64
        devicePeerId: str

    BiometricAssertionV1 =
        devicePeerId: str
        challengeHash: Bytes
        verifiedAtNs: int64
        modalities: StringList
        localOnly: bool

    DidAuthConfig =
        enabled: bool
        required: bool
        maxSkewMs: int64
        nonceWindowMs: int64

    DidIdentity =
        did: str
        rootPrivateKey: PrivateKey
        rootPublicKey: PublicKey
        rootPeerId: PeerId
        devicePrivateKey: PrivateKey
        devicePublicKey: PublicKey
        devicePeerId: PeerId
        biometricCapabilities: StringList
        biometricClass: str
        document: DidDocumentV1
        signedDocument: Bytes
        delegationProof: Bytes

    DidIdentitySummary =
        did: str
        rootPeerId: str
        devicePeerId: str
        version: int64

fn initDeviceMethodV1(): DeviceMethodV1 =
    var out: DeviceMethodV1
    return out

fn initDidDocumentV1(): DidDocumentV1 =
    var out: DidDocumentV1
    out.version = 1
    return out

fn initDeviceDelegationProofV1(): DeviceDelegationProofV1 =
    DeviceDelegationProofV1(
        did: "",
        version: 0,
        issuedAtNs: 0,
        device: initDeviceMethodV1()
    )

fn initDidRevocationV1(): DidRevocationV1 =
    var out: DidRevocationV1
    return out

fn initBiometricAssertionV1(): BiometricAssertionV1 =
    BiometricAssertionV1(
        devicePeerId: "",
        challengeHash: EmptyBytes(),
        verifiedAtNs: 0,
        modalities: InitStringList(),
        localOnly: true
    )

fn initDidAuthConfig(): DidAuthConfig =
    DidAuthConfig(enabled: false, required: false, maxSkewMs: 120000, nonceWindowMs: 600000)

fn initDidIdentitySummary(): DidIdentitySummary =
    DidIdentitySummary(did: "", rootPeerId: "", devicePeerId: "", version: 0)

fn initDidIdentity(): DidIdentity =
    DidIdentity(
        did: "",
        biometricCapabilities: InitStringList(),
        biometricClass: "local",
        document: initDidDocumentV1(),
        signedDocument: EmptyBytes(),
        delegationProof: EmptyBytes()
    )

fn didDeviceStatusText(status: DidDeviceStatus): str =
    if status == didDeviceActive:
        return "active"
    if status == didDeviceRevoked:
        return "revoked"
    return "unknown"

fn didDeviceStatusFromText(text: str): DidDeviceStatus =
    if (text == "active"):
        return didDeviceActive
    if (text == "revoked"):
        return didDeviceRevoked
    return didDeviceUnknown

fn didFromRootPeerId(rootPeer: PeerId): str =
    return didChengPrefix + toString(rootPeer)

fn didRootPeerText(did: str): Result[str] =
    if len(did) <= len(didChengPrefix):
        return Err[str]("did: invalid")
    let prefixLen: int32 = len(didChengPrefix)
    for i in 0..<prefixLen:
        if did[i] != didChengPrefix[i]:
            return Err[str]("did: unsupported method")
    return Ok[str](SliceBytes(did, prefixLen, len(did) - prefixLen))

fn didRootPeerId(did: str): Result[PeerId] =
    let rootTextRes: Result[str] = didRootPeerText(did)
    if IsErr(rootTextRes):
        return Err[PeerId](Error(rootTextRes))
    return parsePeerId(Value(rootTextRes))

fn didDocumentHasDevice(doc: DidDocumentV1, peerText: str): bool =
    if len(peerText) <= 0:
        return false
    for i in 0..<doc.deviceCount:
        if (doc.devices[i].devicePeerId == peerText):
            return true
    return false

fn didDocumentFindDevice(doc: DidDocumentV1, peerText: str): Result[DeviceMethodV1] =
    if len(peerText) <= 0:
        return Err[DeviceMethodV1]("did: empty device peer")
    for i in 0..<doc.deviceCount:
        if (doc.devices[i].devicePeerId == peerText):
            return Ok[DeviceMethodV1](doc.devices[i])
    return Err[DeviceMethodV1]("did: device ! found")

fn didIdentitySummary(identity: DidIdentity): DidIdentitySummary =
    return DidIdentitySummary(
        did: identity.did,
        rootPeerId: toString(identity.rootPeerId),
        devicePeerId: toString(identity.devicePeerId),
        version: identity.document.version
    )

fn DeviceDelegationProofDevice(proof: DeviceDelegationProofV1): DeviceMethodV1 =
    let device: DeviceMethodV1 = proof.device
    return device

fn DeviceMethodPeerId(device: DeviceMethodV1): str =
    return device.devicePeerId

fn DeviceMethodPublicKey(device: DeviceMethodV1): PublicKey =
    let key: PublicKey = device.devicePubKey
    return key

fn DeviceMethodStatus(device: DeviceMethodV1): DidDeviceStatus =
    return device.status
