# DID document encode/decode/sign helpers.

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import std/stringlist
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/crypto/crypto
import cheng/libp2p/peerid
import cheng/libp2p/signed_envelope
import cheng/libp2p/did/types

const
    didDocDeviceMax = maxDidDevices
    didDocFieldId = 1
    didDocFieldVersion = 2
    didDocFieldUpdatedAtNs = 3
    didDocFieldRootMethod = 4
    didDocFieldDevices = 5
    didDocFieldServices = 6

    didDeviceFieldPeerId = 1
    didDeviceFieldPub = 2
    didDeviceFieldStatus = 3
    didDeviceFieldCaps = 4
    didDeviceFieldClass = 5
    didDeviceFieldAddedAtNs = 6
    didDeviceFieldRevokedAtNs = 7

fn didDocumentPayloadDomain(): str =
    return "did:cheng-document"

fn didDocumentPayloadType(): Bytes =
    let out: Bytes = BytesAlloc(2)
    BytesSet(out, 0, 0x64)
    BytesSet(out, 1, 0x01)
    return out

fn didDocumentRootPeerId(did: str): Result[PeerId] =
    let prefix: str = "did:cheng:"
    let prefixLen: int32 = len(prefix)
    if len(did) <= prefixLen:
        return Err[PeerId]("did: invalid")
    for i in 0..<prefixLen:
        if did[i] != prefix[i]:
            return Err[PeerId]("did: unsupported method")
    let peerText: str = SliceBytes(did, prefixLen, len(did) - prefixLen)
    return parsePeerId(peerText)

fn DidPublicKeyEqual(a: PublicKey, b: PublicKey): bool =
    let aRes: Result[Bytes] = encodePublicKey(a)
    if IsErr(aRes):
        return false
    let bRes: Result[Bytes] = encodePublicKey(b)
    if IsErr(bRes):
        return false
    return BytesEqual(Value(aRes), Value(bRes))

fn writeStringListBytes(pb: var minprotobuf.ProtoBuffer, field: int32, list: StringList) =
    for i in 0..<list.count:
        minprotobuf.writeBytes(pb, field, BytesFromString(list.items[i]))

fn readStringListBytes(pb: minprotobuf.ProtoBuffer, field: int32): Result[StringList] =
    var out: StringList = InitStringList()
    var items: minprotobuf.RepeatedBytes = minprotobuf.InitRepeatedBytes()
    let res: Result[bool] = minprotobuf.GetRepeatedBytesField(pb, field, items)
    if IsErr(res):
        return Err[StringList](Error(res))
    if ! Value(res):
        return Ok[StringList](out)
    for i in 0..<items.count:
        let addRes: Result[bool] = StringListAdd(out, BytesToString(items.items[i]))
        if IsErr(addRes):
            return Err[StringList](Error(addRes))
    return Ok[StringList](out)

fn EncodeDeviceMethodV1(method: DeviceMethodV1): Result[Bytes] =
    if len(method.devicePeerId) <= 0:
        return Err[Bytes]("did: missing device peer id")
    let pidRes: Result[PeerId] = parsePeerId(method.devicePeerId)
    if IsErr(pidRes):
        return Err[Bytes](Error(pidRes))
    if ! peerIdMatchesPublicKey(Value(pidRes), method.devicePubKey):
        return Err[Bytes]("did: device peer/pub mismatch")
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeString(pb, didDeviceFieldPeerId, method.devicePeerId)
    write(pb, didDeviceFieldPub, method.devicePubKey)
    minprotobuf.writeVarint(pb, didDeviceFieldStatus, int64(method.status))
    writeStringListBytes(pb, didDeviceFieldCaps, method.biometricCapabilities)
    if len(method.biometricClass) > 0:
        minprotobuf.writeString(pb, didDeviceFieldClass, method.biometricClass)
    if method.addedAtNs > 0:
        minprotobuf.writeVarint(pb, didDeviceFieldAddedAtNs, method.addedAtNs)
    if method.revokedAtNs > 0:
        minprotobuf.writeVarint(pb, didDeviceFieldRevokedAtNs, method.revokedAtNs)
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

fn DecodeDeviceMethodV1(data: Bytes): Result[DeviceMethodV1] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var out: DeviceMethodV1
    var peerText: str
    let pRes: Result[bool] = minprotobuf.getField(pb, didDeviceFieldPeerId, peerText)
    if IsErr(pRes):
        return Err[DeviceMethodV1](Error(pRes))
    if ! Value(pRes):
        return Err[DeviceMethodV1]("did: device peer missing")
    out.devicePeerId = peerText
    let pubRes: Result[bool] = getField(pb, didDeviceFieldPub, out.devicePubKey)
    if IsErr(pubRes):
        return Err[DeviceMethodV1](Error(pubRes))
    if ! Value(pubRes):
        return Err[DeviceMethodV1]("did: device pub missing")
    var statusVal: int64
    let statusRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didDeviceFieldStatus, statusVal)
    if IsErr(statusRes):
        return Err[DeviceMethodV1](Error(statusRes))
    if Value(statusRes):
        if statusVal < 0 || statusVal > 2:
            return Err[DeviceMethodV1]("did: invalid device status")
        if statusVal == 1:
            out.status = didDeviceActive
        elif statusVal == 2:
            out.status = didDeviceRevoked
        else:
            out.status = didDeviceUnknown
    else:
        out.status = didDeviceUnknown
    let capsRes: Result[StringList] = readStringListBytes(pb, didDeviceFieldCaps)
    if IsErr(capsRes):
        return Err[DeviceMethodV1](Error(capsRes))
    out.biometricCapabilities = Value(capsRes)
    var bioClass: str
    let classRes: Result[bool] = minprotobuf.getField(pb, didDeviceFieldClass, bioClass)
    if IsErr(classRes):
        return Err[DeviceMethodV1](Error(classRes))
    if Value(classRes):
        out.biometricClass = bioClass
    var addedAtNs: int64
    let addedRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didDeviceFieldAddedAtNs, addedAtNs)
    if IsErr(addedRes):
        return Err[DeviceMethodV1](Error(addedRes))
    if Value(addedRes):
        out.addedAtNs = addedAtNs
    var revokedAtNs: int64
    let revokedRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didDeviceFieldRevokedAtNs, revokedAtNs)
    if IsErr(revokedRes):
        return Err[DeviceMethodV1](Error(revokedRes))
    if Value(revokedRes):
        out.revokedAtNs = revokedAtNs
    let pidRes: Result[PeerId] = parsePeerId(out.devicePeerId)
    if IsErr(pidRes):
        return Err[DeviceMethodV1](Error(pidRes))
    if ! peerIdMatchesPublicKey(Value(pidRes), out.devicePubKey):
        return Err[DeviceMethodV1]("did: device peer/pub mismatch")
    return Ok[DeviceMethodV1](out)

fn validateDidDocumentV1(doc: DidDocumentV1): Result[bool] =
    let rootRes: Result[PeerId] = didDocumentRootPeerId(doc.id)
    if IsErr(rootRes):
        return Err[bool](Error(rootRes))
    if ! peerIdMatchesPublicKey(Value(rootRes), doc.rootMethod):
        return Err[bool]("did: root method mismatch")
    if doc.version <= 0:
        return Err[bool]("did: invalid version")
    if doc.deviceCount <= 0:
        return Err[bool]("did: empty devices")
    if doc.deviceCount > maxDidDevices:
        return Err[bool]("did: too many devices")
    for i in 0..<doc.deviceCount:
        let encRes: Result[Bytes] = EncodeDeviceMethodV1(doc.devices[i])
        if IsErr(encRes):
            return Err[bool](Error(encRes))
    if doc.serviceCount < 0 || doc.serviceCount > maxDidServices:
        return Err[bool]("did: invalid services")
    return Ok[bool](true)

fn EncodeDidDocumentRaw(doc: DidDocumentV1): Result[Bytes] =
    let validRes: Result[bool] = validateDidDocumentV1(doc)
    if IsErr(validRes):
        return Err[Bytes](Error(validRes))
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeString(pb, didDocFieldId, doc.id)
    minprotobuf.writeVarint(pb, didDocFieldVersion, doc.version)
    if doc.updatedAtNs > 0:
        minprotobuf.writeVarint(pb, didDocFieldUpdatedAtNs, doc.updatedAtNs)
    write(pb, didDocFieldRootMethod, doc.rootMethod)
    for i in 0..<doc.deviceCount:
        let methodRes: Result[Bytes] = EncodeDeviceMethodV1(doc.devices[i])
        if IsErr(methodRes):
            return Err[Bytes](Error(methodRes))
        minprotobuf.writeBytes(pb, didDocFieldDevices, Value(methodRes))
    for i in 0..<doc.serviceCount:
        if len(doc.services[i]) > 0:
            minprotobuf.writeBytes(pb, didDocFieldServices, BytesFromString(doc.services[i]))
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

fn DecodeDidDocumentRaw(data: Bytes): Result[DidDocumentV1] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var doc: DidDocumentV1 = initDidDocumentV1()
    var didText: str
    let idRes: Result[bool] = minprotobuf.getField(pb, didDocFieldId, didText)
    if IsErr(idRes):
        return Err[DidDocumentV1](Error(idRes))
    if ! Value(idRes):
        return Err[DidDocumentV1]("did: missing id")
    doc.id = didText
    var version: int64
    let verRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didDocFieldVersion, version)
    if IsErr(verRes):
        return Err[DidDocumentV1](Error(verRes))
    if ! Value(verRes):
        return Err[DidDocumentV1]("did: missing version")
    doc.version = version
    var updatedAt: int64
    let upRes: Result[bool] = minprotobuf.GetFieldInt64(pb, didDocFieldUpdatedAtNs, updatedAt)
    if IsErr(upRes):
        return Err[DidDocumentV1](Error(upRes))
    if Value(upRes):
        doc.updatedAtNs = updatedAt
    let rootRes: Result[bool] = getField(pb, didDocFieldRootMethod, doc.rootMethod)
    if IsErr(rootRes):
        return Err[DidDocumentV1](Error(rootRes))
    if ! Value(rootRes):
        return Err[DidDocumentV1]("did: missing root method")
    var deviceRaw: minprotobuf.RepeatedBytes = minprotobuf.InitRepeatedBytes()
    let devRes: Result[bool] = minprotobuf.GetRepeatedBytesField(pb, didDocFieldDevices, deviceRaw)
    if IsErr(devRes):
        return Err[DidDocumentV1](Error(devRes))
    if Value(devRes):
        for i in 0..<deviceRaw.count:
            if doc.deviceCount >= maxDidDevices:
                return Err[DidDocumentV1]("did: too many devices")
            let methodRes: Result[DeviceMethodV1] = DecodeDeviceMethodV1(deviceRaw.items[i])
            if IsErr(methodRes):
                return Err[DidDocumentV1](Error(methodRes))
            doc.devices[doc.deviceCount] = Value(methodRes)
            doc.deviceCount = doc.deviceCount + 1
    var serviceRaw: minprotobuf.RepeatedBytes = minprotobuf.InitRepeatedBytes()
    let svcRes: Result[bool] = minprotobuf.GetRepeatedBytesField(pb, didDocFieldServices, serviceRaw)
    if IsErr(svcRes):
        return Err[DidDocumentV1](Error(svcRes))
    if Value(svcRes):
        for j in 0..<serviceRaw.count:
            if doc.serviceCount >= maxDidServices:
                return Err[DidDocumentV1]("did: too many services")
            doc.services[doc.serviceCount] = BytesToString(serviceRaw.items[j])
            doc.serviceCount = doc.serviceCount + 1
    let validRes: Result[bool] = validateDidDocumentV1(doc)
    if IsErr(validRes):
        return Err[DidDocumentV1](Error(validRes))
    return Ok[DidDocumentV1](doc)

fn SignDidDocument(doc: DidDocumentV1, rootPriv: PrivateKey): Result[Bytes] =
    let rawRes: Result[Bytes] = EncodeDidDocumentRaw(doc)
    if IsErr(rawRes):
        return Err[Bytes](Error(rawRes))
    let envRes: Result[Envelope] = InitEnvelope(
        rootPriv,
        didDocumentPayloadType(),
        Value(rawRes),
        didDocumentPayloadDomain()
    )
    if IsErr(envRes):
        return Err[Bytes](Error(envRes))
    return EncodeEnvelope(Value(envRes))

fn DecodeSignedDidDocument(data: Bytes): Result[DidDocumentV1] =
    let envRes: Result[Envelope] = DecodeEnvelope(data, didDocumentPayloadDomain())
    if IsErr(envRes):
        return Err[DidDocumentV1](Error(envRes))
    let env: Envelope = Value(envRes)
    if ! BytesEqual(env.payloadType, didDocumentPayloadType()):
        return Err[DidDocumentV1]("did: wrong document payload type")
    let docRes: Result[DidDocumentV1] = DecodeDidDocumentRaw(env.payload)
    if IsErr(docRes):
        return Err[DidDocumentV1](Error(docRes))
    let doc: DidDocumentV1 = Value(docRes)
    if ! DidPublicKeyEqual(doc.rootMethod, env.publicKey):
        return Err[DidDocumentV1]("did: envelope/root mismatch")
    return Ok[DidDocumentV1](doc)

fn UpsertDeviceInDocument(doc: var DidDocumentV1, device: DeviceMethodV1): Result[bool] =
    let methodRes: Result[Bytes] = EncodeDeviceMethodV1(device)
    if IsErr(methodRes):
        return Err[bool](Error(methodRes))
    for i in 0..<doc.deviceCount:
        if (doc.devices[i].devicePeerId == device.devicePeerId):
            doc.devices[i] = device
            return Ok[bool](true)
    if doc.deviceCount >= maxDidDevices:
        return Err[bool]("did: device list full")
    doc.devices[doc.deviceCount] = device
    doc.deviceCount = doc.deviceCount + 1
    return Ok[bool](true)

fn RevokeDeviceInDocument(doc: var DidDocumentV1, devicePeerId: str, revokedAtNs: int64): Result[bool] =
    if len(devicePeerId) <= 0:
        return Err[bool]("did: empty device peer")
    for i in 0..<doc.deviceCount:
        if (doc.devices[i].devicePeerId == devicePeerId):
            doc.devices[i].status = didDeviceRevoked
            doc.devices[i].revokedAtNs = revokedAtNs
            return Ok[bool](true)
    return Err[bool]("did: device ! found")

fn didPublicKeyEqual(a: PublicKey, b: PublicKey): bool =
    return DidPublicKeyEqual(a, b)

fn encodeDeviceMethodV1(method: DeviceMethodV1): Result[Bytes] =
    return EncodeDeviceMethodV1(method)

fn decodeDeviceMethodV1(data: Bytes): Result[DeviceMethodV1] =
    return DecodeDeviceMethodV1(data)

fn encodeDidDocumentRaw(doc: DidDocumentV1): Result[Bytes] =
    return EncodeDidDocumentRaw(doc)

fn decodeDidDocumentRaw(data: Bytes): Result[DidDocumentV1] =
    return DecodeDidDocumentRaw(data)

fn signDidDocument(doc: DidDocumentV1, rootPriv: PrivateKey): Result[Bytes] =
    return SignDidDocument(doc, rootPriv)

fn decodeSignedDidDocument(data: Bytes): Result[DidDocumentV1] =
    return DecodeSignedDidDocument(data)

fn upsertDeviceInDocument(doc: var DidDocumentV1, device: DeviceMethodV1): Result[bool] =
    return UpsertDeviceInDocument(doc, device)

fn revokeDeviceInDocument(doc: var DidDocumentV1, devicePeerId: str, revokedAtNs: int64): Result[bool] =
    return RevokeDeviceInDocument(doc, devicePeerId, revokedAtNs)
