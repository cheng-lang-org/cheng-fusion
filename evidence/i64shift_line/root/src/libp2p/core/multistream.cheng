import std/rawbytes
import cheng/libp2p/core/types as coretypes
import std/strutils as strutil

fn Libp2pMultistreamHeaderText(): str =
    return "/multistream/1.0.0\n"

fn Libp2pMultistreamProtocolLine(protocol: int32): str =
    return strutil.Join([coretypes.Libp2pProtocolWireText(protocol), "\n"], "")

fn Libp2pMultistreamSelectBytes(protocol: int32): Bytes =
    let header = Libp2pMultistreamHeaderText()
    let line = Libp2pMultistreamProtocolLine(protocol)
    let text = strutil.Join([header, line], "")
    let payload = BytesFromString(text)
    return BytesSlice(payload, 0, BytesLen(payload))

fn Libp2pMultistreamAccepts(payload: Bytes,
                              protocol: int32): bool =
    var expected = Libp2pMultistreamSelectBytes(protocol)
    if BytesLen(payload) != BytesLen(expected):
        BytesFree(expected)
        return false
    for i in 0..<BytesLen(payload):
        if BytesGet(payload, i) != BytesGet(expected, i):
            BytesFree(expected)
            return false
    BytesFree(expected)
    return true
