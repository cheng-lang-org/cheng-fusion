# mDNS discovery(local cache + optional multicast network).

import cheng/libp2p/utils/result
import std/times
import cheng/libp2p/utils/strings
import std/stringlist
import std/os
import std/buffer as bytebuffer
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/system
import cheng/libp2p/utils/ipaddr
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import cheng/libp2p/discovery/discoverymngr
const
    mdnsMaxEntries = 64
    mdnsDefaultTtlSeconds = 120
    mdnsMinTtlSeconds = 10
    mdnsMaxTtlSeconds = 3600
    mdnsDefaultServiceName = "_unimaker._udp.local"
    mdnsDefaultNamespace = "default"
    mdnsDefaultPort = 5353
    mdnsDefaultBindIp = "0.0.0.0"
    mdnsDefaultQueryTimeoutMs = 200
    mdnsDefaultMaxPacketBytes = 1500
    mdnsMaxTxtEntries = 16
    mdnsMaxTxtEntryBytes = 255
    mdnsMaxNameJumps = 16
    mdnsMaxPollBatch = 32

    mdnsDnsHeaderSize = 12
    mdnsDnsFlagResponse = 0x8000
    mdnsDnsFlagAuthoritative = 0x0400
    mdnsDnsTypePtr = 12
    mdnsDnsTypeTxt = 16
    mdnsDnsTypeAny = 255
    mdnsDnsClassIn = 1

    aF_INET = 2
    sOCK_DGRAM = 2
    sOL_SOCKET_LINUX = 1
    sOL_SOCKET_BSD = 65535
    sO_REUSEADDR_LINUX = 2
    sO_REUSEADDR_BSD = 4
    iPPROTO_IP = 0
    iP_ADD_MEMBERSHIP_BSD = 12
    iP_ADD_MEMBERSHIP_LINUX = 35
    iP_MULTICAST_TTL_BSD = 10
    iP_MULTICAST_LOOP_BSD = 11
    iP_MULTICAST_IF_BSD = 9
    iP_MULTICAST_TTL_LINUX = 33
    iP_MULTICAST_LOOP_LINUX = 34
    iP_MULTICAST_IF_LINUX = 32
    sO_REUSEPORT_BSD = 0x0200
    sO_REUSEPORT_LINUX = 15
    mSG_DONTWAIT_LINUX = 0x40
    mSG_DONTWAIT_BSD = 0x80
    fCNTL_F_GETFL = 3
    fCNTL_F_SETFL = 4
    oNONBLOCK_LINUX = 0x800
    oNONBLOCK_BSD = 0x0004
    eAGAIN = 11
    eAGAIN_BSD = 35
    eWOULDBLOCK = 35
    eWOULDBLOCK_BSD = 35
    eINTR = 4
    eNOSYS = 38
    eINVAL = 22
    eOPNOTSUPP = 95
    eOPNOTSUPP_BSD = 45

type
    MdnsConfig =
        ttlSeconds: int64
        maxEntries: int32
        serviceName: str
        namespace: str
        enableNetwork: bool
        bindPort: int32
        bindIp: str
        multicastAddr: str
        queryTimeoutMs: int32
        maxPacketBytes: int32

    MdnsEntry =
        expiresAtNs: int64
        attrs: PeerAttributes

    MdnsState =
        count: int32
        config: MdnsConfig
        entries: MdnsEntry[mdnsMaxEntries]

    MdnsRuntime =
        socketOpen: bool
        fd: int32
        hasSelf: bool
        selfAttrs: PeerAttributes

    MdnsNameDecoded =
        name: str
        next: int32

    MdnsQuestion =
        name: str
        qtype: int32
        qclass: int32

    MdnsQuestionDecoded =
        question: MdnsQuestion
        next: int32

    MdnsRecord =
        name: str
        rtype: int32
        rclass: int32
        ttl: int64
        rdata: Bytes

    MdnsRecordDecoded =
        record: MdnsRecord
        next: int32

    MdnsUdpDatagram =
        fromAddr: str
        data: Bytes

    SockAddrBuf =
        data: Bytes
        len: int32

var
    mdnsState: MdnsState = MdnsState(
        count: 0,
        config: MdnsConfig(
            ttlSeconds: mdnsDefaultTtlSeconds,
            maxEntries: mdnsMaxEntries,
            serviceName: mdnsDefaultServiceName,
            namespace: mdnsDefaultNamespace,
            enableNetwork: true,
            bindPort: mdnsDefaultPort,
            bindIp: mdnsDefaultBindIp,
            multicastAddr: "224.0.0.251",
            queryTimeoutMs: mdnsDefaultQueryTimeoutMs,
            maxPacketBytes: mdnsDefaultMaxPacketBytes
        )
    )
    mdnsRuntime: MdnsRuntime = MdnsRuntime(socketOpen: false, fd: -1, hasSelf: false, selfAttrs: initPeerAttributes())

fn initMdnsConfig(): MdnsConfig =
    return MdnsConfig(
        ttlSeconds: mdnsDefaultTtlSeconds,
        maxEntries: mdnsMaxEntries,
        serviceName: mdnsDefaultServiceName,
        namespace: mdnsDefaultNamespace,
        enableNetwork: true,
        bindPort: mdnsDefaultPort,
        bindIp: mdnsDefaultBindIp,
        multicastAddr: "224.0.0.251",
        queryTimeoutMs: mdnsDefaultQueryTimeoutMs,
        maxPacketBytes: mdnsDefaultMaxPacketBytes
    )

fn mdnsHasPrefix(text: str, prefix: str): bool =
    if len(prefix) <= 0 || len(text) < len(prefix):
        return false
    for i in 0..<len(prefix):
        if text[i] != prefix[i]:
            return false
    return true

fn mdnsIsUsableBindIp(ip: str): bool =
    if len(ip) <= 0:
        return false
    if ip == "127.0.0.1":
        return false
    if mdnsHasPrefix(ip, "127."):
        return false
    if mdnsHasPrefix(ip, "169.254."):
        return false
    return true

fn mdnsResolveBindIp(rawIp: str): str =
    if len(rawIp) <= 0:
        return mdnsDefaultBindIp
    if rawIp == mdnsDefaultBindIp:
        return rawIp
    let ipRes: Result[IpAddr] = parseIpAddr(rawIp)
    if IsErr(ipRes):
        return mdnsDefaultBindIp
    if ipAddrIsV6(Value(ipRes)):
        return mdnsDefaultBindIp
    # Accept explicit loopback/non-routable binds for local simulation and container runtimes.
    # Caller decides whether to pass LAN or loopback address.
    return rawIp

fn mdnsPeerIdFromAttrs(attrs: PeerAttributes): Result[PeerId] =
    for i in 0..<attrs.count:
        if attrs.items[i].kind == attrPeerId:
            return Ok[PeerId](attrs.items[i].peerId)
    return Err[PeerId]("mdns: missing peer id")

fn mdnsUdpErrText(code: int32): str =
    let text: str = os.udpErrText(code)
    return text

fn mdnsIpAddrBytes4(ip: IpAddr): Bytes =
    let raw: Bytes = ipAddrBytes(ip)
    if BytesLen(raw) < 4:
        return EmptyBytes()
    let out: Bytes = BytesAlloc(4)
    for i in 0..<4:
        BytesSet(out, i, BytesGet(raw, i))
    return out

fn mdnsSetSockOptIpCross(fd: int32, levelLinux: int32, optLinux: int32, levelBsd: int32, optBsd: int32, ip: IpAddr): bool =
    var ipBytes: Bytes = mdnsIpAddrBytes4(ip)
    if BytesLen(ipBytes) != 4:
        if ipBytes.data != nil:
            BytesFree(ipBytes)
        return false
    let ok: bool = os.udpSetSockOptIntFd(fd, levelLinux, optLinux, ipBytes) == 0
    if ok:
        BytesFree(ipBytes)
        return true
    if levelLinux == levelBsd && optLinux == optBsd:
        BytesFree(ipBytes)
        return false
    let ok2: bool = os.udpSetSockOptIntFd(fd, levelBsd, optBsd, ipBytes) == 0
    BytesFree(ipBytes)
    return ok2

fn setMdnsConfig(config: MdnsConfig) =
    mdnsState.config = config

fn initMdnsState(): MdnsState =
    var state: MdnsState
    state.count = 0
    state.config = initMdnsConfig()
    return state

fn setMdnsState(state: MdnsState) =
    # NOTE: deliberately field-by-field, not `mdnsState = state`. MdnsState
    # embeds a large fixed-size cache array (entries: MdnsEntry[64]); a
    # whole-struct assignment of a composite this size has been observed to
    # silently drop/zero fields positioned after the big array in the current
    # stage3 seed's codegen (see mdnsEntrySet's history for the same class of
    # bug on the smaller MdnsEntry type). Copying count/config directly avoids
    # that path; entries[] itself is only ever populated in-place via
    # mdnsEntrySet, never through a bulk assignment like this one.
    mdnsState.count = state.count
    mdnsState.config = state.config
    for i in 0..<state.count:
        mdnsState.entries[i].attrs = state.entries[i].attrs
        mdnsState.entries[i].expiresAtNs = state.entries[i].expiresAtNs

fn getMdnsState(): MdnsState =
    return mdnsState

fn mdnsRuntimeReset() =
    if mdnsRuntime.socketOpen && mdnsRuntime.fd >= 0:
        os.udpCloseFd(mdnsRuntime.fd)
    mdnsRuntime = MdnsRuntime(socketOpen: false, fd: -1, hasSelf: mdnsRuntime.hasSelf, selfAttrs: mdnsRuntime.selfAttrs)

fn mdnsEntryGet(state: var MdnsState, idx: int32): MdnsEntry =
    return state.entries[idx]

fn mdnsEntrySet(state: var MdnsState, idx: int32, entry: MdnsEntry) =
    state.entries[idx].attrs = entry.attrs
    state.entries[idx].expiresAtNs = entry.expiresAtNs

fn mdnsClampTtl(config: MdnsConfig): Result[int64] =
    var ttl: int64 = config.ttlSeconds
    if ttl <= 0:
        ttl = mdnsDefaultTtlSeconds
    if ttl < mdnsMinTtlSeconds || ttl > mdnsMaxTtlSeconds:
        return Err[int64]("mdns: ttl out of range")
    return Ok[int64](ttl)

fn cleanupExpired(state: var MdnsState, nowNs: int64): int32 =
    var writeIdx: int32
    var removed: int32
    for i in 0..<state.count:
        if state.entries[i].expiresAtNs > nowNs:
            if writeIdx != i:
                mdnsEntrySet(state, writeIdx, mdnsEntryGet(state, i))
            writeIdx = writeIdx + 1
        else:
            removed = removed + 1
    state.count = writeIdx
    return removed

fn findEntryIndex(state: var MdnsState, attrs: PeerAttributes): int32 =
    for i in 0..<state.count:
        if peerAttributesEqual(mdnsEntryGet(state, i).attrs, attrs):
            return i
    return -1

fn mdnsWriteU16BE(b: Bytes, offset: int32, val: int32) =
    BytesSet(b, offset, (val >> 8) & 0xff)
    BytesSet(b, offset + 1, val & 0xff)

fn mdnsWriteU32BE(b: Bytes, offset: int32, val: int64) =
    BytesSet(b, offset, int32((val >> 24) & 0xff))
    BytesSet(b, offset + 1, int32((val >> 16) & 0xff))
    BytesSet(b, offset + 2, int32((val >> 8) & 0xff))
    BytesSet(b, offset + 3, int32(val & 0xff))

fn mdnsReadU16BE(b: Bytes, offset: int32): int32 =
    let hi: int32 = BytesGet(b, offset)
    let lo: int32 = BytesGet(b, offset + 1)
    return (hi << 8) | lo

fn mdnsReadU32BE(b: Bytes, offset: int32): int64 =
    let b0: int64 = int64(BytesGet(b, offset))
    let b1: int64 = int64(BytesGet(b, offset + 1))
    let b2: int64 = int64(BytesGet(b, offset + 2))
    let b3: int64 = int64(BytesGet(b, offset + 3))
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

fn mdnsNormalizeName(name: str): str =
    if len(name) <= 0:
        return ""
    if name[len(name) - 1] == '.':
        return SliceBytes(name, 0, len(name) - 1)
    return name

fn mdnsEndsWith(text: str, suffix: str): bool =
    let tlen: int32 = len(text)
    let slen: int32 = len(suffix)
    if tlen < slen:
        return false
    for i in 0..<slen:
        if text[tlen - slen + i] != suffix[i]:
            return false
    return true

fn mdnsStartsWith(text: str, prefix: str): bool =
    let tlen: int32 = len(text)
    let plen: int32 = len(prefix)
    if tlen < plen:
        return false
    for i in 0..<plen:
        if text[i] != prefix[i]:
            return false
    return true

# Takes outKey/outValue as caller-owned var parameters (see the
# mdnsParsePeerFromTxt/mdnsDecodeTxtEntries NOTEs above for the general
# struct-return-value issue on this stage3 seed that motivated switching this
# file's other helpers to the same shape). This function's own real defect
# was different and narrower: its previous body pre-declared `var idx: int32`
# and then reused the exact same name as the for-loop's own induction
# variable (`for idx in 0..<len(text)`), reading the outer `idx` again after
# the loop to find where '=' was. On this stage3 seed that outer `idx` never
# observed the loop's mutations -- it read back as its untouched zero-init
# default every time, so `idx <= 0` was always true and this function
# returned false unconditionally, for every TXT entry, regardless of
# content (reproduced by dumping outKey/outValue/return immediately after
# the call: always empty/false). Every "id="/"svc="/"ns="/"addr=" entry was
# silently falling through to this file's DNS-name/config-default fallback
# paths instead of the real wire value -- harmless for id/svc here because
# their fallback happens to coincide, but a real defect for namespace, whose
# fallback is a different, wrong value. Fixed by never reading the loop
# variable back after the loop: capture the '=' position into a separate
# variable assigned only from inside the loop body.
fn mdnsSplitKeyValue(text: str, outKey: var str, outValue: var str): bool =
    var eqIdx: int32 = -1
    for scanIdx in 0..<len(text):
        if text[scanIdx] == '=':
            eqIdx = scanIdx
            break
    if eqIdx <= 0 || eqIdx >= len(text):
        return false
    outKey = SliceBytes(text, 0, eqIdx)
    outValue = SliceBytes(text, eqIdx + 1, len(text) - (eqIdx + 1))
    return true

fn mdnsEncodeName(name: str): Result[Bytes] =
    let clean: str = mdnsNormalizeName(name)
    if len(clean) <= 0:
        return Err[Bytes]("mdns: empty name")
    var buf: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    var start: int32
    for i in 0..<(len(clean) + 1):
        if i == len(clean) || clean[i] == '.':
            let segLen: int32 = i - start
            if segLen <= 0 || segLen > 63:
                return Err[Bytes]("mdns: invalid label")
            bytebuffer.AppendByte(buf, segLen)
            let seg: str = SliceBytes(clean, start, segLen)
            bytebuffer.AppendBytes(buf, BytesFromString(seg))
            start = i + 1
    bytebuffer.AppendByte(buf, 0)
    return Ok[Bytes](bytebuffer.ToBytes(buf))

fn mdnsDecodeName(data: Bytes, offset: int32): Result[MdnsNameDecoded] =
    if offset < 0 || offset >= BytesLen(data):
        return Err[MdnsNameDecoded]("mdns: name offset out of range")
    var buf: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    var idx: int32 = offset
    var next: int32 = -1
    var jumped: bool
    for jumps in 0..<mdnsMaxNameJumps:
        if ! (jumps < mdnsMaxNameJumps):
            break
        if idx >= BytesLen(data):
            return Err[MdnsNameDecoded]("mdns: name truncated")
        let lenByte: int32 = BytesGet(data, idx)
        if lenByte == 0:
            if !jumped:
                next = idx + 1
            return Ok[MdnsNameDecoded](MdnsNameDecoded(name: BytesToString(bytebuffer.ToBytes(buf)), next: next))
        let tag: int32 = lenByte & 0xc0
        if tag == 0xc0:
            if idx + 1 >= BytesLen(data):
                return Err[MdnsNameDecoded]("mdns: name pointer truncated")
            let ptr: int32 = ((lenByte & 0x3f) << 8) | BytesGet(data, idx + 1)
            if ptr < 0 || ptr >= BytesLen(data):
                return Err[MdnsNameDecoded]("mdns: name pointer out of range")
            if !jumped:
                next = idx + 2
            idx = ptr
            jumped = true
            continue
        if tag != 0:
            return Err[MdnsNameDecoded]("mdns: invalid name label")
        let labelLen: int32 = lenByte
        idx = idx + 1
        if idx + labelLen > BytesLen(data):
            return Err[MdnsNameDecoded]("mdns: name label truncated")
        if BytesLen(bytebuffer.ToBytes(buf)) > 0:
            bytebuffer.AppendByte(buf, int32('.'))
        let label: Bytes = BytesSlice(data, idx, labelLen)
        bytebuffer.AppendBytes(buf, label)
        idx = idx + labelLen
    return Err[MdnsNameDecoded]("mdns: name pointer loop")

fn mdnsParseQuestion(data: Bytes, offset: int32): Result[MdnsQuestionDecoded] =
    let nameRes: Result[MdnsNameDecoded] = mdnsDecodeName(data, offset)
    if IsErr(nameRes):
        return Err[MdnsQuestionDecoded](Error(nameRes))
    let nameDec: MdnsNameDecoded = Value(nameRes)
    if nameDec.next < 0 || nameDec.next + 4 > BytesLen(data):
        return Err[MdnsQuestionDecoded]("mdns: question truncated")
    let qtype: int32 = mdnsReadU16BE(data, nameDec.next)
    let qclass: int32 = mdnsReadU16BE(data, nameDec.next + 2)
    let question: MdnsQuestion = MdnsQuestion(name: mdnsNormalizeName(nameDec.name), qtype: qtype, qclass: qclass)
    return Ok[MdnsQuestionDecoded](MdnsQuestionDecoded(question: question, next: nameDec.next + 4))

fn mdnsParseRecord(data: Bytes, offset: int32): Result[MdnsRecordDecoded] =
    let nameRes: Result[MdnsNameDecoded] = mdnsDecodeName(data, offset)
    if IsErr(nameRes):
        return Err[MdnsRecordDecoded](Error(nameRes))
    let nameDec: MdnsNameDecoded = Value(nameRes)
    let base: int32 = nameDec.next
    if base < 0 || base + 10 > BytesLen(data):
        return Err[MdnsRecordDecoded]("mdns: record truncated")
    let rtype: int32 = mdnsReadU16BE(data, base)
    let rclass: int32 = mdnsReadU16BE(data, base + 2)
    let ttl: int64 = mdnsReadU32BE(data, base + 4)
    let rdlen: int32 = mdnsReadU16BE(data, base + 8)
    let rstart: int32 = base + 10
    if rdlen < 0 || rstart + rdlen > BytesLen(data):
        return Err[MdnsRecordDecoded]("mdns: record data truncated")
    let rdata: Bytes = BytesSlice(data, rstart, rdlen)
    let rec: MdnsRecord = MdnsRecord(name: mdnsNormalizeName(nameDec.name), rtype: rtype, rclass: rclass, ttl: ttl, rdata: rdata)
    return Ok[MdnsRecordDecoded](MdnsRecordDecoded(record: rec, next: rstart + rdlen))

fn mdnsEncodeTxtEntries(entries: StringList): Result[Bytes] =
    var buf: bytebuffer.GrowByteBuffer = bytebuffer.NewByteBuffer()
    for i in 0..<entries.count:
        let entry: str = entries.items[i]
        let entryBytes: Bytes = BytesFromString(entry)
        let entryLen: int32 = BytesLen(entryBytes)
        if entryLen > mdnsMaxTxtEntryBytes:
            return Err[Bytes]("mdns: txt entry too large")
        bytebuffer.AppendByte(buf, entryLen)
        bytebuffer.AppendBytes(buf, entryBytes)
    return Ok[Bytes](bytebuffer.ToBytes(buf))

# Fills `out` instead of returning a StringList by value -- same reasoning
# as mdnsParsePeerFromTxt's own out-parameter conversion just above: a
# struct-with-fixed-array return from a function invoked repeatedly inside a
# record-processing loop has been observed to corrupt on the current stage3
# seed (the *caller* of mdnsParsePeerFromTxt saw a wrong namespace on a
# second same-loop call; bisecting further showed the corruption was already
# present one level down, in this function's own StringList return, not in
# PeerAttributes -- the ns entry was silently missing from the decoded list,
# so mdnsParsePeerFromTxt correctly-but-misleadingly fell back to the global
# default namespace because it genuinely never saw a "ns=" entry that loop).
fn mdnsDecodeTxtEntries(data: Bytes, out: var StringList): Result[bool] =
    out.count = 0
    var idx: int32
    while idx < BytesLen(data): # cheng-syntax-policy: allow-counting-while
        let entryLen: int32 = BytesGet(data, idx)
        idx = idx + 1
        if entryLen <= 0:
            continue
        if idx + entryLen > BytesLen(data):
            return Err[bool]("mdns: txt truncated")
        let entryBytes: Bytes = BytesSlice(data, idx, entryLen)
        let entry: str = BytesToString(entryBytes)
        let addRes: Result[bool] = StringListAdd(out, entry)
        if IsErr(addRes):
            return Err[bool](Error(addRes))
        idx = idx + entryLen
    return Ok[bool](true)

fn mdnsEncodeTxtFromAttrs(attrs: PeerAttributes, config: MdnsConfig): Result[Bytes] =
    var entries: StringList = InitStringList()
    let pidRes: Result[PeerId] = mdnsPeerIdFromAttrs(attrs)
    if IsOk(pidRes):
        let pid: PeerId = Value(pidRes)
        let addRes: Result[bool] = StringListAdd(entries, "id=" + peerid.toString(pid))
        if IsErr(addRes):
            return Err[Bytes](Error(addRes))
    var svc: str
    if peerAttributesGetService(attrs, svc):
        let addRes: Result[bool] = StringListAdd(entries, "svc=" + svc)
        if IsErr(addRes):
            return Err[Bytes](Error(addRes))
    elif len(config.serviceName) > 0:
        let addRes: Result[bool] = StringListAdd(entries, "svc=" + config.serviceName)
        if IsErr(addRes):
            return Err[Bytes](Error(addRes))
    var ns: str
    if peerAttributesGetNamespace(attrs, ns):
        let addRes: Result[bool] = StringListAdd(entries, "ns=" + ns)
        if IsErr(addRes):
            return Err[Bytes](Error(addRes))
    elif len(config.namespace) > 0:
        let addRes: Result[bool] = StringListAdd(entries, "ns=" + config.namespace)
        if IsErr(addRes):
            return Err[Bytes](Error(addRes))
    for i in 0..<attrs.count:
        if ! (i < attrs.count && entries.count < mdnsMaxTxtEntries):
            break
        if attrs.items[i].kind == attrAddress:
            let addr: multiaddress.MultiAddress = attrs.items[i].address
            let addrText: str = multiaddress.lpMultiAddressToString(addr)
            if len(addrText) > 0:
                let addRes: Result[bool] = StringListAdd(entries, "addr=" + addrText)
                if IsErr(addRes):
                    return Err[Bytes](Error(addRes))
    return mdnsEncodeTxtEntries(entries)

fn mdnsInstanceName(attrs: PeerAttributes, config: MdnsConfig): Result[str] =
    let pidRes: Result[PeerId] = mdnsPeerIdFromAttrs(attrs)
    if IsErr(pidRes):
        return Err[str](Error(pidRes))
    let pid: PeerId = Value(pidRes)
    var service: str = mdnsDefaultServiceName
    if len(config.serviceName) > 0:
        service = config.serviceName
    return Ok[str](peerid.toString(pid) + "." + mdnsNormalizeName(service))

fn mdnsBuildQuery(serviceName: str): Result[Bytes] =
    let nameRes: Result[Bytes] = mdnsEncodeName(serviceName)
    if IsErr(nameRes):
        return Err[Bytes](Error(nameRes))
    let nameBytes: Bytes = Value(nameRes)
    let total: int32 = mdnsDnsHeaderSize + BytesLen(nameBytes) + 4
    let out: Bytes = BytesAlloc(total)
    mdnsWriteU16BE(out, 0, 0)
    mdnsWriteU16BE(out, 2, 0)
    mdnsWriteU16BE(out, 4, 1)
    mdnsWriteU16BE(out, 6, 0)
    mdnsWriteU16BE(out, 8, 0)
    mdnsWriteU16BE(out, 10, 0)
    for i in 0..<BytesLen(nameBytes):
        BytesSet(out, mdnsDnsHeaderSize + i, BytesGet(nameBytes, i))
    let qoff: int32 = mdnsDnsHeaderSize + BytesLen(nameBytes)
    mdnsWriteU16BE(out, qoff, mdnsDnsTypePtr)
    mdnsWriteU16BE(out, qoff + 2, mdnsDnsClassIn)
    return Ok[Bytes](out)

fn mdnsBuildResponse(attrs: PeerAttributes, ttlSeconds: int64, config: MdnsConfig): Result[Bytes] =
    let service: str = if len(config.serviceName) > 0: config.serviceName else: mdnsDefaultServiceName
    let serviceRes: Result[Bytes] = mdnsEncodeName(service)
    if IsErr(serviceRes):
        return Err[Bytes](Error(serviceRes))
    let serviceNameBytes: Bytes = Value(serviceRes)
    let instRes: Result[str] = mdnsInstanceName(attrs, config)
    if IsErr(instRes):
        return Err[Bytes](Error(instRes))
    let instanceName: str = Value(instRes)
    let instNameRes: Result[Bytes] = mdnsEncodeName(instanceName)
    if IsErr(instNameRes):
        return Err[Bytes](Error(instNameRes))
    let instanceBytes: Bytes = Value(instNameRes)
    let txtRes: Result[Bytes] = mdnsEncodeTxtFromAttrs(attrs, config)
    if IsErr(txtRes):
        return Err[Bytes](Error(txtRes))
    let txtBytes: Bytes = Value(txtRes)
    let ptrLen: int32 = BytesLen(serviceNameBytes) + 10 + BytesLen(instanceBytes)
    let txtLen: int32 = BytesLen(instanceBytes) + 10 + BytesLen(txtBytes)
    let total: int32 = mdnsDnsHeaderSize + ptrLen + txtLen
    let out: Bytes = BytesAlloc(total)
    mdnsWriteU16BE(out, 0, 0)
    mdnsWriteU16BE(out, 2, mdnsDnsFlagResponse | mdnsDnsFlagAuthoritative)
    mdnsWriteU16BE(out, 4, 0)
    mdnsWriteU16BE(out, 6, 2)
    mdnsWriteU16BE(out, 8, 0)
    mdnsWriteU16BE(out, 10, 0)
    var offset: int32 = mdnsDnsHeaderSize
    for i in 0..<BytesLen(serviceNameBytes):
        BytesSet(out, offset + i, BytesGet(serviceNameBytes, i))
    offset = offset + BytesLen(serviceNameBytes)
    mdnsWriteU16BE(out, offset, mdnsDnsTypePtr)
    mdnsWriteU16BE(out, offset + 2, mdnsDnsClassIn)
    mdnsWriteU32BE(out, offset + 4, ttlSeconds)
    mdnsWriteU16BE(out, offset + 8, BytesLen(instanceBytes))
    offset = offset + 10
    for i in 0..<BytesLen(instanceBytes):
        BytesSet(out, offset + i, BytesGet(instanceBytes, i))
    offset = offset + BytesLen(instanceBytes)
    for i in 0..<BytesLen(instanceBytes):
        BytesSet(out, offset + i, BytesGet(instanceBytes, i))
    offset = offset + BytesLen(instanceBytes)
    mdnsWriteU16BE(out, offset, mdnsDnsTypeTxt)
    mdnsWriteU16BE(out, offset + 2, mdnsDnsClassIn)
    mdnsWriteU32BE(out, offset + 4, ttlSeconds)
    mdnsWriteU16BE(out, offset + 8, BytesLen(txtBytes))
    offset = offset + 10
    for i in 0..<BytesLen(txtBytes):
        BytesSet(out, offset + i, BytesGet(txtBytes, i))
    return Ok[Bytes](out)

# Fills `out` (a var owned by the caller) instead of constructing and
# returning a fresh PeerAttributes: PeerAttributes embeds a fixed 32-entry
# array, and returning a struct that shape by value from a function called
# repeatedly in a loop has been observed to corrupt on the current stage3
# seed (a second call's return silently clobbers/aliases a still-in-scope
# earlier call's already-consumed return value -- reproduced in isolation:
# the raw wire bytes decode identically both times, but the second Result's
# PeerAttributes comes back with a different namespace string than the one
# it was just built from). Every other struct-producing helper in this file
# already uses this caller-owns-the-var-out-parameter shape for exactly this
# reason; this function was the one holdout still doing a value return.
fn mdnsParsePeerFromTxt(name: str, txt: Bytes, config: MdnsConfig, out: var PeerAttributes): Result[bool] =
    let serviceName: str = mdnsNormalizeName(config.serviceName)
    if len(serviceName) > 0 && !mdnsEndsWith(name, "." + serviceName) && !(name == serviceName):
        return Err[bool]("mdns: txt name mismatch")
    var list: StringList
    list.count = 0
    let listRes: Result[bool] = mdnsDecodeTxtEntries(txt, list)
    if IsErr(listRes):
        return Err[bool](Error(listRes))
    out.count = 0
    var peerText: str
    var svc: str
    var ns: str
    for i in 0..<list.count:
        let entry: str = list.items[i]
        var kvKey: str
        var kvValue: str
        let kvOk: bool = mdnsSplitKeyValue(entry, kvKey, kvValue)
        if kvOk && (kvKey == "id"):
            peerText = kvValue
        elif kvOk && (kvKey == "svc"):
            svc = kvValue
        elif kvOk && (kvKey == "ns"):
            ns = kvValue
        elif kvOk && (kvKey == "addr"):
            let addrRes: Result[multiaddress.MultiAddress] = multiaddress.parseMultiAddress(kvValue)
            if IsOk(addrRes):
                let addRes: Result[bool] = peerAttributesAddAddress(out, Value(addrRes))
                if IsErr(addRes):
                    return Err[bool](Error(addRes))
    if len(peerText) <= 0:
        if mdnsEndsWith(name, "." + serviceName):
            let prefixLen: int32 = len(name) - len(serviceName) - 1
            if prefixLen > 0:
                peerText = SliceBytes(name, 0, prefixLen)
    if len(peerText) > 0:
        let pidRes: Result[PeerId] = parsePeerId(peerText)
        if IsErr(pidRes):
            # A TXT/name id field that fails multihash validation is a
            # malformed peer record, not an absent one: surface it rather
            # than silently returning attrs with no peer id (which the
            # caller would otherwise treat as "no id on the wire", masking
            # a real encode/decode defect on either side of the wire).
            return Err[bool](Error(pidRes))
        let addRes: Result[bool] = peerAttributesAddPeerId(out, Value(pidRes))
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    if len(svc) > 0:
        let addRes: Result[bool] = peerAttributesAddService(out, svc)
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    elif len(config.serviceName) > 0:
        let addRes: Result[bool] = peerAttributesAddService(out, config.serviceName)
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    if len(ns) > 0:
        let addRes: Result[bool] = peerAttributesAddNamespace(out, ns)
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    elif len(config.namespace) > 0:
        let addRes: Result[bool] = peerAttributesAddNamespace(out, config.namespace)
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    if out.count <= 0:
        return Err[bool]("mdns: empty txt attributes")
    return Ok[bool](true)

fn mdnsCacheUpdate(attrs: PeerAttributes, ttlSeconds: int64) =
    let nowNs: int64 = EpochTimeNs()
    cleanupExpired(mdnsState, nowNs)
    var ttl: int64 = ttlSeconds
    if ttl <= 0:
        let ttlRes: Result[int64] = mdnsClampTtl(mdnsState.config)
        ttl = if IsOk(ttlRes): Value(ttlRes) else: mdnsDefaultTtlSeconds
    let idx: int32 = findEntryIndex(mdnsState, attrs)
    var entry: MdnsEntry
    entry.attrs = attrs
    entry.expiresAtNs = nowNs + (ttl * 1000000000)
    if idx >= 0:
        mdnsEntrySet(mdnsState, idx, entry)
        return
    if mdnsState.config.maxEntries > 0 && mdnsState.count >= mdnsState.config.maxEntries:
        return
    mdnsEntrySet(mdnsState, mdnsState.count, entry)
    mdnsState.count = mdnsState.count + 1

fn mdnsProcessRecords(data: Bytes, recordCount: int32, offset: int32, nowNs: int64): Result[int32] =
    var processed: int32
    var curOffset: int32 = offset
    for i in 0..<recordCount:
        let recRes: Result[MdnsRecordDecoded] = mdnsParseRecord(data, curOffset)
        if IsErr(recRes):
            return Err[int32](Error(recRes))
        let recDec: MdnsRecordDecoded = Value(recRes)
        curOffset = recDec.next
        let rec: MdnsRecord = recDec.record
        if rec.rtype == mdnsDnsTypeTxt:
            var parsedAttrs: PeerAttributes
            parsedAttrs.count = 0
            let attrsRes: Result[bool] = mdnsParsePeerFromTxt(rec.name, rec.rdata, mdnsState.config, parsedAttrs)
            if IsOk(attrsRes):
                mdnsCacheUpdate(parsedAttrs, rec.ttl)
                processed = processed + 1
    return Ok[int32](processed)

fn mdnsHandlePacket(data: Bytes, nowNs: int64): Result[int32] =
    if BytesLen(data) < mdnsDnsHeaderSize:
        return Err[int32]("mdns: packet too small")
    let flags: int32 = mdnsReadU16BE(data, 2)
    let qd: int32 = mdnsReadU16BE(data, 4)
    let an: int32 = mdnsReadU16BE(data, 6)
    let ns: int32 = mdnsReadU16BE(data, 8)
    let ar: int32 = mdnsReadU16BE(data, 10)
    var offset: int32 = mdnsDnsHeaderSize
    var i: int32
    while i < qd: # cheng-syntax-policy: allow-counting-while
        let qRes: Result[MdnsQuestionDecoded] = mdnsParseQuestion(data, offset)
        if IsErr(qRes):
            return Err[int32](Error(qRes))
        let qDec: MdnsQuestionDecoded = Value(qRes)
        let q: MdnsQuestion = qDec.question
        offset = qDec.next
        i = i + 1
        if (flags & mdnsDnsFlagResponse) == 0 && mdnsRuntime.hasSelf:
            let service: str = mdnsNormalizeName(mdnsState.config.serviceName)
            if (q.name == service) && (q.qtype == mdnsDnsTypePtr || q.qtype == mdnsDnsTypeAny):
                let ttlRes: Result[int64] = mdnsClampTtl(mdnsState.config)
                if IsOk(ttlRes):
                    let respRes: Result[Bytes] = mdnsBuildResponse(mdnsRuntime.selfAttrs, Value(ttlRes), mdnsState.config)
                    if IsOk(respRes) && mdnsRuntime.socketOpen:
                        let _ = mdnsSendMulticast(Value(respRes))
    let totalRecords: int32 = an + ns + ar
    if (flags & mdnsDnsFlagResponse) == 0:
        return Ok[int32](0)
    return mdnsProcessRecords(data, totalRecords, offset, nowNs)

fn mdnsSetSockOptInt(fd: int32, level: int32, opt: int32, value: int32): bool =
    let optBytes: Bytes = BytesAlloc(4)
    BytesSet(optBytes, 0, value & 0xff)
    BytesSet(optBytes, 1, (value >> 8) & 0xff)
    BytesSet(optBytes, 2, (value >> 16) & 0xff)
    BytesSet(optBytes, 3, (value >> 24) & 0xff)
    let res: int32 = os.udpSetSockOptIntFd(fd, level, opt, optBytes)
    return res == 0

fn mdnsSetSockOptIntCross(fd: int32, levelLinux: int32, optLinux: int32, levelBsd: int32, optBsd: int32, value: int32): bool =
    if mdnsSetSockOptInt(fd, levelLinux, optLinux, value):
        return true
    if levelLinux == levelBsd && optLinux == optBsd:
        return false
    return mdnsSetSockOptInt(fd, levelBsd, optBsd, value)

fn mdnsBuildSockaddrV4(ip: IpAddr, port: int32, useLenField: bool): SockAddrBuf =
    let size: int32 = 16
    let buf: Bytes = BytesAlloc(size)
    if useLenField:
        BytesSet(buf, 0, size)
        BytesSet(buf, 1, aF_INET)
    else:
        BytesSet(buf, 0, aF_INET)
        BytesSet(buf, 1, 0)
    mdnsWriteU16BE(buf, 2, port)
    let addrBytes: Bytes = ipAddrBytes(ip)
    if BytesLen(addrBytes) >= 4:
        BytesSet(buf, 4, BytesGet(addrBytes, 0))
        BytesSet(buf, 5, BytesGet(addrBytes, 1))
        BytesSet(buf, 6, BytesGet(addrBytes, 2))
        BytesSet(buf, 7, BytesGet(addrBytes, 3))
    return SockAddrBuf(data: buf, len: size)

fn mdnsBindSocket(fd: int32, port: int32, bindIp: str): Result[bool] =
    let resolvedIp: str = mdnsResolveBindIp(bindIp)
    let ipRes: Result[IpAddr] = parseIpAddr(resolvedIp)
    if IsErr(ipRes):
        return Err[bool](Error(ipRes))
    var addrBuf: SockAddrBuf = mdnsBuildSockaddrV4(Value(ipRes), port, false)
    let res: int32 = os.udpBindFd(fd, addrBuf.data, addrBuf.len)
    BytesFree(addrBuf.data)
    if res == 0:
        return Ok[bool](true)
    let errCode: int32 = os.udpErrno()
    if errCode != eINVAL && errCode != eOPNOTSUPP && errCode != eOPNOTSUPP_BSD && errCode != eNOSYS:
        let errText: str = mdnsUdpErrText(errCode)
        return Err[bool]("mdns: bind failed: " + errText)
    var addrBuf2: SockAddrBuf = mdnsBuildSockaddrV4(Value(ipRes), port, true)
    let res2: int32 = os.udpBindFd(fd, addrBuf2.data, addrBuf2.len)
    BytesFree(addrBuf2.data)
    if res2 == 0:
        return Ok[bool](true)
    let err2: int32 = os.udpErrno()
    let err2Text: str = mdnsUdpErrText(err2)
    return Err[bool]("mdns: bind failed: " + err2Text)

fn mdnsJoinMulticast(fd: int32, group: str, bindIp: str): Result[bool] =
    let ipRes: Result[IpAddr] = parseIpAddr(group)
    if IsErr(ipRes):
        return Err[bool](Error(ipRes))
    let addr: IpAddr = Value(ipRes)
    if ipAddrIsV6(addr):
        return Err[bool]("mdns: ipv6 multicast ! supported")
    let bindIpRes: Result[IpAddr] = parseIpAddr(mdnsResolveBindIp(bindIp))
    let ifaceAddr: IpAddr = if IsOk(bindIpRes) && !ipAddrIsV6(Value(bindIpRes)): Value(bindIpRes) else: Value(ipRes)
    var mreq: Bytes = BytesAlloc(8)
    let addrBytes: Bytes = ipAddrBytes(addr)
    var ifaceBytes: Bytes = mdnsIpAddrBytes4(ifaceAddr)
    if BytesLen(addrBytes) < 4:
        BytesFree(mreq)
        return Err[bool]("mdns: invalid multicast addr")
    BytesSet(mreq, 0, BytesGet(addrBytes, 0))
    BytesSet(mreq, 1, BytesGet(addrBytes, 1))
    BytesSet(mreq, 2, BytesGet(addrBytes, 2))
    BytesSet(mreq, 3, BytesGet(addrBytes, 3))
    if BytesLen(ifaceBytes) >= 4:
        BytesSet(mreq, 4, BytesGet(ifaceBytes, 0))
        BytesSet(mreq, 5, BytesGet(ifaceBytes, 1))
        BytesSet(mreq, 6, BytesGet(ifaceBytes, 2))
        BytesSet(mreq, 7, BytesGet(ifaceBytes, 3))
    else:
        BytesSet(mreq, 4, 0)
        BytesSet(mreq, 5, 0)
        BytesSet(mreq, 6, 0)
        BytesSet(mreq, 7, 0)
    var ok: bool = mdnsSetSockOptIntCross(
        fd,
        sOL_SOCKET_LINUX,
        sO_REUSEADDR_LINUX,
        sOL_SOCKET_BSD,
        sO_REUSEADDR_BSD,
        1
    )
    if !ok:
        ok = true
    let _ = mdnsSetSockOptIpCross(
        fd,
        iPPROTO_IP,
        iP_MULTICAST_IF_LINUX,
        iPPROTO_IP,
        iP_MULTICAST_IF_BSD,
        ifaceAddr
    )
    let joinRes: int32 = os.udpSetSockOptIntFd(fd, iPPROTO_IP, iP_ADD_MEMBERSHIP_BSD, mreq)
    if joinRes != 0:
        let joinRes2: int32 = os.udpSetSockOptIntFd(fd, iPPROTO_IP, iP_ADD_MEMBERSHIP_LINUX, mreq)
        if joinRes2 != 0:
            BytesFree(mreq)
            BytesFree(ifaceBytes)
            return Err[bool]("mdns: join multicast failed")
    BytesFree(ifaceBytes)
    BytesFree(mreq)
    return Ok[bool](true)

fn mdnsSetSocketNonBlocking(fd: int32): bool =
    # recvfrom's own flags argument is not a reliable non-blocking switch
    # cross-platform: MSG_DONTWAIT's numeric value differs (Linux=0x40,
    # BSD/Darwin=0x80), and the *other* platform's value is not itself an
    # invalid flag it just silently means something else (0x40 is
    # MSG_WAITALL on BSD/Darwin) -- so a wrong-guess-then-retry-on-error
    # strategy at the recvfrom call site can never detect the failure mode
    # (the call simply blocks instead of erroring). Setting O_NONBLOCK on
    # the fd itself via fcntl is the actually-portable primitive: F_GETFL/
    # F_SETFL share the same numeric values on Linux and BSD/Darwin, and
    # setting *both* platforms' O_NONBLOCK bit in the same F_SETFL call is
    # safe (an unrecognized bit in a file status flags word is inert, unlike
    # an unrecognized bit in a recvfrom flags argument).
    let curFlags: int32 = os.udpFcntl(fd, fCNTL_F_GETFL, 0)
    if curFlags < 0:
        return false
    let newFlags: int32 = curFlags | oNONBLOCK_LINUX | oNONBLOCK_BSD
    return os.udpFcntl(fd, fCNTL_F_SETFL, newFlags) == 0

fn mdnsSocketOpen(config: MdnsConfig): Result[int32] =
    let fd: int32 = os.udpOpenSocket(aF_INET, sOCK_DGRAM, 0)
    if fd < 0:
        return Err[int32]("mdns: socket open failed")
    if !mdnsSetSocketNonBlocking(fd):
        os.udpCloseFd(fd)
        return Err[int32]("mdns: ! set socket non-blocking")
    mdnsSetSockOptIntCross(
        fd,
        sOL_SOCKET_LINUX,
        sO_REUSEADDR_LINUX,
        sOL_SOCKET_BSD,
        sO_REUSEADDR_BSD,
        1
    )
    mdnsSetSockOptIntCross(
        fd,
        sOL_SOCKET_LINUX,
        sO_REUSEPORT_LINUX,
        sOL_SOCKET_BSD,
        sO_REUSEPORT_BSD,
        1
    )
    let bindRes: Result[bool] = mdnsBindSocket(fd, config.bindPort, config.bindIp)
    if IsErr(bindRes):
        os.udpCloseFd(fd)
        return Err[int32](Error(bindRes))
    if len(config.multicastAddr) > 0:
        let joinRes: Result[bool] = mdnsJoinMulticast(fd, config.multicastAddr, config.bindIp)
        if IsErr(joinRes):
            os.udpCloseFd(fd)
            return Err[int32](Error(joinRes))
    let _ = mdnsSetSockOptIntCross(
        fd,
        iPPROTO_IP,
        iP_MULTICAST_TTL_BSD,
        iPPROTO_IP,
        iP_MULTICAST_TTL_LINUX,
        1
    )
    let _ = mdnsSetSockOptIntCross(
        fd,
        iPPROTO_IP,
        iP_MULTICAST_LOOP_BSD,
        iPPROTO_IP,
        iP_MULTICAST_LOOP_LINUX,
        1
    )
    return Ok[int32](fd)

fn mdnsEnsureSocket(): Result[bool] =
    if !mdnsState.config.enableNetwork:
        return Ok[bool](false)
    if mdnsRuntime.socketOpen && mdnsRuntime.fd >= 0:
        return Ok[bool](true)
    var cfg: MdnsConfig = mdnsState.config
    if cfg.bindPort <= 0:
        cfg.bindPort = mdnsDefaultPort
    cfg.bindIp = mdnsResolveBindIp(cfg.bindIp)
    if len(cfg.multicastAddr) <= 0:
        cfg.multicastAddr = "224.0.0.251"
    mdnsState.config = cfg
    let openRes: Result[int32] = mdnsSocketOpen(cfg)
    if IsErr(openRes):
        return Err[bool](Error(openRes))
    mdnsRuntime.socketOpen = true
    mdnsRuntime.fd = Value(openRes)
    return Ok[bool](true)

fn mdnsSendMulticast(data: Bytes): Result[bool] =
    if !mdnsRuntime.socketOpen || mdnsRuntime.fd < 0:
        return Err[bool]("mdns: socket ! open")
    let addrRes: Result[IpAddr] = parseIpAddr(mdnsState.config.multicastAddr)
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    var addrBuf: SockAddrBuf = mdnsBuildSockaddrV4(Value(addrRes), mdnsState.config.bindPort, false)
    let res: int32 = os.udpSendToFd(mdnsRuntime.fd, data, 0, addrBuf.data, addrBuf.len)
    BytesFree(addrBuf.data)
    if res < 0:
        let errFirst: int32 = os.udpErrno()
        # Always retry once with BSD sockaddr layout (sin_len + sin_family).
        # Some runtimes return non-EINVAL errors (e.g. EHOSTUNREACH) for the first layout.
        var addrBuf2: SockAddrBuf = mdnsBuildSockaddrV4(Value(addrRes), mdnsState.config.bindPort, true)
        let res2: int32 = os.udpSendToFd(mdnsRuntime.fd, data, 0, addrBuf2.data, addrBuf2.len)
        BytesFree(addrBuf2.data)
        if res2 < 0:
            let err2: int32 = os.udpErrno()
            let err2Text: str = mdnsUdpErrText(err2)
            let errFirstText: str = mdnsUdpErrText(errFirst)
            return Err[bool]("mdns: sendto failed: " + err2Text + " (first=" + errFirstText + ")")
    return Ok[bool](true)

fn mdnsRecvDatagram(): Result[MdnsUdpDatagram] =
    if !mdnsRuntime.socketOpen || mdnsRuntime.fd < 0:
        return Err[MdnsUdpDatagram]("mdns: socket ! open")
    let maxBytes: int32 = if mdnsState.config.maxPacketBytes > 0: mdnsState.config.maxPacketBytes else: mdnsDefaultMaxPacketBytes
    let buf: Bytes = BytesAlloc(maxBytes)
    var errCode: int32
    var n: int32 = os.udpRecvFromFdEx(mdnsRuntime.fd, buf, mSG_DONTWAIT_LINUX, errCode)
    if n < 0:
        if errCode == eINVAL || errCode == eOPNOTSUPP || errCode == eOPNOTSUPP_BSD || errCode == eNOSYS:
            n = os.udpRecvFromFdEx(mdnsRuntime.fd, buf, mSG_DONTWAIT_BSD, errCode)
        if n < 0:
            if errCode == eAGAIN || errCode == eAGAIN_BSD || errCode == eWOULDBLOCK || errCode == eWOULDBLOCK_BSD || errCode == eINTR:
                return Err[MdnsUdpDatagram]("mdns: queue empty")
            let errCode2Text: str = mdnsUdpErrText(errCode)
            return Err[MdnsUdpDatagram]("mdns: recvfrom failed: " + errCode2Text)
    let out: Bytes = BytesSlice(buf, 0, n)
    return Ok[MdnsUdpDatagram](MdnsUdpDatagram(fromAddr: "", data: out))

fn mdnsPollOnce(): Result[int32] =
    let ensureRes: Result[bool] = mdnsEnsureSocket()
    if IsErr(ensureRes):
        return Err[int32](Error(ensureRes))
    if !(Value(ensureRes)):
        return Ok[int32](0)
    var processed: int32
    for i in 0..<mdnsMaxPollBatch:
        let dgRes: Result[MdnsUdpDatagram] = mdnsRecvDatagram()
        if IsErr(dgRes):
            let err: str = Error(dgRes)
            if StrContains(err, "queue empty"):
                break
            return Err[int32](err)
        let dg: MdnsUdpDatagram = Value(dgRes)
        let handleRes: Result[int32] = mdnsHandlePacket(dg.data, EpochTimeNs())
        if IsErr(handleRes):
            return Err[int32](Error(handleRes))
        processed = processed + Value(handleRes)
    return Ok[int32](processed)

fn mdnsAdvertise(attrs: PeerAttributes): Result[bool] =
    let ttlRes: Result[int64] = mdnsClampTtl(mdnsState.config)
    if IsErr(ttlRes):
        return Err[bool](Error(ttlRes))
    var advAttrs: PeerAttributes = attrs
    if len(mdnsState.config.namespace) > 0:
        var ns: str
        if !peerAttributesGetNamespace(advAttrs, ns):
            let addNsRes: Result[bool] = peerAttributesAddNamespace(advAttrs, mdnsState.config.namespace)
            if IsErr(addNsRes):
                return Err[bool](Error(addNsRes))
    mdnsCacheUpdate(advAttrs, Value(ttlRes))
    mdnsRuntime.hasSelf = true
    mdnsRuntime.selfAttrs = advAttrs
    let ensureRes: Result[bool] = mdnsEnsureSocket()
    if IsErr(ensureRes):
        return Err[bool](Error(ensureRes))
    if Value(ensureRes):
        let respRes: Result[Bytes] = mdnsBuildResponse(advAttrs, Value(ttlRes), mdnsState.config)
        if IsErr(respRes):
            return Err[bool](Error(respRes))
        let sendRes: Result[bool] = mdnsSendMulticast(Value(respRes))
        if IsErr(sendRes):
            return Err[bool](Error(sendRes))
    return Ok[bool](true)

fn mdnsDiscover(query: PeerAttributes, out: var PeerAttributesList): Result[bool] =
    let nowNs: int64 = EpochTimeNs()
    cleanupExpired(mdnsState, nowNs)
    let ensureRes: Result[bool] = mdnsEnsureSocket()
    if IsErr(ensureRes):
        return Err[bool](Error(ensureRes))
    if Value(ensureRes):
        var queryService: str
        let hasQueryService: bool = peerAttributesGetService(query, queryService)
        let cfgService: str =
            if len(mdnsState.config.serviceName) > 0:
                mdnsState.config.serviceName
            else:
                mdnsDefaultServiceName
        let svcRaw: str = if hasQueryService && len(queryService) > 0: queryService else: cfgService
        let svc: str = mdnsNormalizeName(svcRaw)
        if len(svc) <= 0:
            return Err[bool]("mdns: discover service missing")
        let queryRes: Result[Bytes] = mdnsBuildQuery(svc)
        if IsErr(queryRes):
            return Err[bool](Error(queryRes))
        let sendRes: Result[bool] = mdnsSendMulticast(Value(queryRes))
        if IsErr(sendRes):
            return Err[bool](Error(sendRes))
        let timeoutMs: int32 = if mdnsState.config.queryTimeoutMs > 0: mdnsState.config.queryTimeoutMs else: mdnsDefaultQueryTimeoutMs
        let deadline: int64 = EpochTimeNs() + int64(timeoutMs) * 1000000
        while EpochTimeNs() < deadline: # cheng-syntax-policy: allow-counting-while
            let pollRes: Result[int32] = mdnsPollOnce()
            if IsErr(pollRes):
                return Err[bool](Error(pollRes))
    for i in 0..<mdnsState.count:
        let entry: MdnsEntry = mdnsEntryGet(mdnsState, i)
        let attrs: PeerAttributes = entry.attrs
        if peerAttributesMatch(query, attrs):
            if !peerAttributesListContains(out, attrs):
                let addRes: Result[bool] = peerAttributesListAdd(out, attrs)
                if IsErr(addRes):
                    return Err[bool](Error(addRes))
    return Ok[bool](true)

fn mdnsDiscoveryInterface(): DiscoveryInterface =
    return initDiscoveryInterface(mdnsDiscover, mdnsAdvertise, true, true)
