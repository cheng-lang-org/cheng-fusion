# Discovery manager(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/peerid
import cheng/libp2p/multiaddress
import std/seqs
const
    maxPeerAttributes = 32
    maxPeerAttributeList = 64
    maxDiscoveryInterfaces = 8

type
    PeerAttrKind = enum
        attrPeerId = 0
        attrAddress = 1
        attrService = 2
        attrNamespace = 3

    PeerAttribute =
        kind: PeerAttrKind
        peerId: PeerId
        address: MultiAddress
        text: str

    PeerAttributes =
        count: int32
        items: PeerAttribute[]

    PeerAttributesList =
        count: int32
        items: PeerAttributes[]

    DiscoveryRequest = fn(query: PeerAttributes, out: var PeerAttributesList): Result[bool]
    DiscoveryAdvertise = fn(attrs: PeerAttributes): Result[bool]

    DiscoveryInterface =
        hasRequest: bool
        hasAdvertise: bool
        request: DiscoveryRequest
        advertise: DiscoveryAdvertise

    DiscoveryManager =
        count: int32
        interfaces: DiscoveryInterface[]

fn discoveryRequestNoop(query: PeerAttributes, out: var PeerAttributesList): Result[bool] =
    query
    out
    return Ok[bool](true)

fn discoveryAdvertiseNoop(attrs: PeerAttributes): Result[bool] =
    attrs
    return Ok[bool](true)

fn initPeerAttributes(): PeerAttributes =
    var out: PeerAttributes
    out.count = 0
    return out

fn initPeerAttributesList(): PeerAttributesList =
    var out: PeerAttributesList
    out.count = 0
    return out

fn peerAttributesAddAttr(pa: var PeerAttributes, attr: PeerAttribute): Result[bool] =
    if pa.count >= maxPeerAttributes:
        return Err[bool]("discovery: peer attribute limit reached")
    add(pa.items, attr)
    pa.count = pa.items.len
    return Ok[bool](true)

fn peerAttributesAddPeerId(pa: var PeerAttributes, peerId: PeerId): Result[bool] =
    return peerAttributesAddAttr(pa, PeerAttribute(kind: attrPeerId, peerId: peerId))

fn peerAttributesAddAddress(pa: var PeerAttributes, addr: MultiAddress): Result[bool] =
    return peerAttributesAddAttr(pa, PeerAttribute(kind: attrAddress, address: addr))

fn peerAttributesAddService(pa: var PeerAttributes, service: str): Result[bool] =
    return peerAttributesAddAttr(pa, PeerAttribute(kind: attrService, text: service))

fn peerAttributesAddNamespace(pa: var PeerAttributes, ns: str): Result[bool] =
    return peerAttributesAddAttr(pa, PeerAttribute(kind: attrNamespace, text: ns))

fn peerAttributeEquals(a: PeerAttribute, b: PeerAttribute): bool =
    if a.kind != b.kind:
        return false
    if a.kind == attrPeerId:
        let eqRes: Result[bool] = peerIdEqual(a.peerId, b.peerId)
        return IsOk(eqRes) && Value(eqRes)
    if a.kind == attrAddress:
        return (a.address.raw == b.address.raw)
    return (a.text == b.text)

fn peerAttributesContains(pa: PeerAttributes, attr: PeerAttribute): bool =
    for i in 0..<pa.count:
        if peerAttributeEquals(pa.items[i], attr):
            return true
    return false

fn peerAttributesMatch(query: PeerAttributes, candidate: PeerAttributes): bool =
    for i in 0..<query.count:
        if ! peerAttributesContains(candidate, query.items[i]):
            return false
    return true

fn peerAttributesEqual(a: PeerAttributes, b: PeerAttributes): bool =
    if a.count != b.count:
        return false
    if ! peerAttributesMatch(a, b):
        return false
    return peerAttributesMatch(b, a)

fn peerAttributesGetPeerId(pa: PeerAttributes, out: var PeerId): bool =
    for i in 0..<pa.count:
        if pa.items[i].kind == attrPeerId:
            out = pa.items[i].peerId
            return true
    return false

fn peerAttributesGetService(pa: PeerAttributes, out: var str): bool =
    for i in 0..<pa.count:
        if pa.items[i].kind == attrService:
            out = pa.items[i].text
            return true
    return false

fn peerAttributesGetNamespace(pa: PeerAttributes, out: var str): bool =
    for i in 0..<pa.count:
        if pa.items[i].kind == attrNamespace:
            out = pa.items[i].text
            return true
    return false

fn peerAttributesGetAddress(pa: PeerAttributes, out: var MultiAddress): bool =
    for i in 0..<pa.count:
        if pa.items[i].kind == attrAddress:
            out = pa.items[i].address
            return true
    return false

fn peerAttributesListAdd(list: var PeerAttributesList, pa: PeerAttributes): Result[bool] =
    if list.count >= maxPeerAttributeList:
        return Err[bool]("discovery: peer list limit reached")
    add(list.items, pa)
    list.count = list.items.len
    return Ok[bool](true)

fn peerAttributesListContains(list: var PeerAttributesList, pa: PeerAttributes): bool =
    for i in 0..<list.count:
        if peerAttributesEqual(list.items[i], pa):
            return true
    return false

fn peerAttributesListCount(list: PeerAttributesList): int32 =
    return list.count

fn peerAttributesListGet(list: PeerAttributesList, idx: int32, out: var PeerAttributes): bool =
    if idx < 0 || idx >= list.count:
        return false
    out = list.items[idx]
    return true

fn initDiscoveryInterface(
    request: DiscoveryRequest,
    advertise: DiscoveryAdvertise,
    hasRequest: bool,
    hasAdvertise: bool
): DiscoveryInterface =
    DiscoveryInterface(
        hasRequest: hasRequest,
        hasAdvertise: hasAdvertise,
        request: request,
        advertise: advertise
    )

fn initRequestOnlyInterface(request: DiscoveryRequest): DiscoveryInterface =
    return initDiscoveryInterface(request, discoveryAdvertiseNoop, true, false)

fn initAdvertiseOnlyInterface(advertise: DiscoveryAdvertise): DiscoveryInterface =
    return initDiscoveryInterface(discoveryRequestNoop, advertise, false, true)

fn initDiscoveryManager(): DiscoveryManager =
    var out: DiscoveryManager
    out.count = 0
    return out

fn discoveryManagerAdd(dm: var DiscoveryManager, iface: DiscoveryInterface): Result[bool] =
    if dm.count >= maxDiscoveryInterfaces:
        return Err[bool]("discovery: interface limit reached")
    add(dm.interfaces, iface)
    dm.count = dm.interfaces.len
    return Ok[bool](true)

fn discoveryRequest(dm: DiscoveryManager, query: PeerAttributes): Result[PeerAttributesList] =
    var out: PeerAttributesList = initPeerAttributesList()
    for i in 0..<dm.count:
        let iface: DiscoveryInterface = dm.interfaces[i]
        if iface.hasRequest:
            var tmp: PeerAttributesList = initPeerAttributesList()
            let req: DiscoveryRequest = iface.request
            let reqRes: Result[bool] = req(query, &tmp)
            if IsErr(reqRes):
                return Err[PeerAttributesList](Error(reqRes))
            var j: int32
            for j in 0..<tmp.count:
                if ! (j < tmp.count):
                    break
                if ! peerAttributesListContains(out, tmp.items[j]):
                    let addRes: Result[bool] = peerAttributesListAdd(out, tmp.items[j])
                    if IsErr(addRes):
                        return Err[PeerAttributesList](Error(addRes))
    return Ok[PeerAttributesList](out)

fn discoveryAdvertise(dm: DiscoveryManager, attrs: PeerAttributes): Result[bool] =
    for i in 0..<dm.count:
        let iface: DiscoveryInterface = dm.interfaces[i]
        if iface.hasAdvertise:
            let adv: DiscoveryAdvertise = iface.advertise
            let advRes: Result[bool] = adv(attrs)
            if IsErr(advRes):
                return Err[bool](Error(advRes))
    return Ok[bool](true)
