# Bootstrap gossip helpers(shared core logic for mobile/runtime bridges).

import std/times
import std/seqs
import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/crypto/rand

const
    bootstrapTopicV1 = "/unimaker/bootstrap/v1"
    bootstrapTopicVersion = 1
    bootstrapDefaultTickSeconds = 60
    bootstrapDefaultRandomN = 7
    bootstrapDefaultCandidateTtlMs = 180000
    bootstrapDefaultParallelDials = 3
    bootstrapDefaultPublishPeerCap = 16
    bootstrapDefaultPublishChancePercent = 35
    bootstrapDefaultPublishMinIntervalMs = 60000
    bootstrapDefaultPublishSuppressionMs = 45000
    bootstrapDefaultRequireTrustedPublisher = false
    bootstrapBackoffBaseMs = 30000
    bootstrapBackoffMaxMs = 600000
    bootstrapMaxTickSample = 64
    bootstrapMaxAnnouncementScan = 256

type
    BootstrapPolicy =
        topic: str
        tickSeconds: int32
        randomN: int32
        candidateTtlMs: int64
        parallelDials: int32
        publishPeerCap: int32
        publishChancePercent: int32
        publishMinIntervalMs: int64
        publishSuppressionMs: int64
        requireTrustedPublisher: bool

    BootstrapRegionalSample =
        indexes: int32[]
        randomN: int32

fn bootstrapClampI32(value: int32, low: int32, high: int32): int32 =
    if value < low:
        return low
    if value > high:
        return high
    return value

fn bootstrapClampI64(value: int64, low: int64, high: int64): int64 =
    if value < low:
        return low
    if value > high:
        return high
    return value

fn initBootstrapPolicy(): BootstrapPolicy =
    BootstrapPolicy(
        topic: bootstrapTopicV1,
        tickSeconds: bootstrapDefaultTickSeconds,
        randomN: bootstrapDefaultRandomN,
        candidateTtlMs: bootstrapDefaultCandidateTtlMs,
        parallelDials: bootstrapDefaultParallelDials,
        publishPeerCap: bootstrapDefaultPublishPeerCap,
        publishChancePercent: bootstrapDefaultPublishChancePercent,
        publishMinIntervalMs: bootstrapDefaultPublishMinIntervalMs,
        publishSuppressionMs: bootstrapDefaultPublishSuppressionMs,
        requireTrustedPublisher: bootstrapDefaultRequireTrustedPublisher
    )

fn bootstrapTopicOrDefaultText(topic: str): str =
    let trimmed: str = trimText(topic)
    if len(trimmed) <= 0:
        return bootstrapTopicV1
    return trimmed

fn bootstrapTickSecondsOrDefault(value: int32): int32 =
    if value <= 0:
        return bootstrapDefaultTickSeconds
    return value

fn bootstrapRandomNOrDefault(value: int32): int32 =
    if value <= 0:
        return bootstrapDefaultRandomN
    return value

fn bootstrapCandidateTtlMsOrDefault(value: int64): int64 =
    if value <= 0:
        return bootstrapDefaultCandidateTtlMs
    return value

fn bootstrapParallelDialsOrDefault(value: int32): int32 =
    if value <= 0:
        return bootstrapDefaultParallelDials
    return value

fn bootstrapPublishPeerCapOrDefault(value: int32): int32 =
    if value <= 0:
        return bootstrapDefaultPublishPeerCap
    return value

fn bootstrapPublishChancePercentOrDefault(value: int32): int32 =
    if value <= 0:
        return bootstrapDefaultPublishChancePercent
    return value

fn bootstrapPublishMinIntervalMsOrDefault(value: int64): int64 =
    if value <= 0:
        return bootstrapDefaultPublishMinIntervalMs
    return value

fn bootstrapPublishSuppressionMsOrDefault(value: int64): int64 =
    if value <= 0:
        return bootstrapDefaultPublishSuppressionMs
    return value

fn normalizeBootstrapPolicy(policy: BootstrapPolicy): BootstrapPolicy =
    var out: BootstrapPolicy = policy
    out.topic = bootstrapTopicOrDefaultText(policy.topic)
    out.tickSeconds = bootstrapClampI32(bootstrapTickSecondsOrDefault(policy.tickSeconds), 5, 600)
    out.randomN = bootstrapClampI32(bootstrapRandomNOrDefault(policy.randomN), 1, bootstrapMaxTickSample)
    out.candidateTtlMs = bootstrapClampI64(bootstrapCandidateTtlMsOrDefault(policy.candidateTtlMs), 30000, 3600000)
    out.parallelDials = bootstrapClampI32(bootstrapParallelDialsOrDefault(policy.parallelDials), 1, 32)
    out.publishPeerCap = bootstrapClampI32(bootstrapPublishPeerCapOrDefault(policy.publishPeerCap), 1, 64)
    out.publishChancePercent = bootstrapClampI32(bootstrapPublishChancePercentOrDefault(policy.publishChancePercent), 1, 100)
    out.publishMinIntervalMs = bootstrapClampI64(bootstrapPublishMinIntervalMsOrDefault(policy.publishMinIntervalMs), 10000, 1800000)
    out.publishSuppressionMs = bootstrapClampI64(bootstrapPublishSuppressionMsOrDefault(policy.publishSuppressionMs), 0, 1800000)
    return out

fn bootstrapNowMs(): int64 =
    return int64(epochTime() * 1000.0)

fn bootstrapRandomIntBound(maxExclusive: int32): int32 =
    if maxExclusive <= 1:
        return 0
    let randRes: Result[Bytes] = rand.randomBytes(4)
    var raw: int64 = bootstrapNowMs()
    if IsOk(randRes):
        let data: Bytes = Value(randRes)
        if BytesLen(data) >= 4:
            raw = int64(BytesGet(data, 0))
            raw = raw + int64(BytesGet(data, 1)) * 256
            raw = raw + int64(BytesGet(data, 2)) * 65536
            raw = raw + int64(BytesGet(data, 3)) * 16777216
    if raw < 0:
        raw = -raw
    return int32(raw % int64(maxExclusive))

fn bootstrapRandomCountUpTo(maxInclusive: int32): int32 =
    let safeMax: int32 = bootstrapClampI32(maxInclusive, 1, bootstrapMaxTickSample)
    return bootstrapRandomIntBound(safeMax) + 1

fn bootstrapSeqLenI32(items: var int32[]): int32 =
    let snapshot: int32[] = items
    return len(snapshot)

fn bootstrapShuffleI32(items: var int32[]) =
    let total: int32 = bootstrapSeqLenI32(items)
    if total <= 1:
        return
    let loopStart_1: int32 = total - 1
    if loopStart_1 > 0:
        for loopStep_1 in 0..(loopStart_1 - 1):
            let i: int32 = loopStart_1 - loopStep_1
            let j: int32 = bootstrapRandomIntBound(i + 1)
            let tmp: int32 = items[i]
            items[i] = items[j]
            items[j] = tmp

fn bootstrapBackoffDelayMs(level: int32): int64 =
    let safeLevel: int32 = bootstrapClampI32(level, 0, 10)
    var delay: int64 = bootstrapBackoffBaseMs
    for i in 0..<safeLevel:
        if !(delay < bootstrapBackoffMaxMs):
            break
        delay = delay * 2
        if delay > bootstrapBackoffMaxMs:
            delay = bootstrapBackoffMaxMs
    return delay

fn bootstrapShouldAutoTick(lastTickMs: int64, tickSeconds: int32, nowAtMs: int64): bool =
    let intervalMs: int64 = int64(bootstrapTickSecondsOrDefault(tickSeconds)) * 1000
    if intervalMs <= 0:
        return false
    if lastTickMs <= 0:
        return true
    return nowAtMs - lastTickMs >= intervalMs

fn bootstrapShouldPublishNow(
    connectedCount: int32,
    lastPublishMs: int64,
    lastHeardAnnouncementMs: int64,
    publishChancePercent: int32,
    publishMinIntervalMs: int64,
    publishSuppressionMs: int64,
    nowAtMs: int64
): bool =
    if nowAtMs <= 0:
        return true
    let minInterval: int64 = bootstrapPublishMinIntervalMsOrDefault(publishMinIntervalMs)
    if lastPublishMs > 0 && nowAtMs - lastPublishMs < minInterval:
        return false
    if connectedCount <= 2:
        return true
    let suppressionMs: int64 = bootstrapPublishSuppressionMsOrDefault(publishSuppressionMs)
    if suppressionMs > 0 && lastHeardAnnouncementMs > 0 && nowAtMs - lastHeardAnnouncementMs < suppressionMs:
        return false
    let chance: int32 = bootstrapClampI32(bootstrapPublishChancePercentOrDefault(publishChancePercent), 1, 100)
    if chance >= 100:
        return true
    let roll: int32 = bootstrapRandomIntBound(100) + 1
    return roll <= chance

fn bootstrapEpochMinute(nowAtMs: int64): int64 =
    if nowAtMs <= 0:
        return 0
    return nowAtMs / 60000

fn bootstrapRegionSeen(regions: str[], value: str): bool =
    for i in 0..<len(regions):
        if regions[i] == value:
            return true
    return false

fn bootstrapSelectRegionalCandidateIndexes(regions: str[], randomN: int32): int32[] =
    var out: int32[]
    let total: int32 = len(regions)
    if total <= 0:
        return out
    let target: int32 = bootstrapClampI32(bootstrapRandomNOrDefault(randomN), 1, total)
    var chosen: bool[]
    for i in 0..<total:
        seqAdd(chosen, false)
    var seenRegions: str[]
    for i in 0..<total:
        if len(out) >= target:
            break
        let regionText: str = trimText(regions[i])
        if len(regionText) <= 0:
            continue
        if bootstrapRegionSeen(seenRegions, regionText):
            continue
        seqAdd(seenRegions, regionText)
        seqAdd(out, i)
        chosen[i] = true
    var remain: int32[]
    for i in 0..<total:
        if !chosen[i]:
            seqAdd(remain, i)
    bootstrapShuffleI32(remain)
    for i in 0..<len(remain):
        if len(out) >= target:
            break
        seqAdd(out, remain[i])
    return out

fn bootstrapRegionalSample(regions: str[], randomN: int32): BootstrapRegionalSample =
    var sample: BootstrapRegionalSample
    sample.randomN = bootstrapClampI32(bootstrapRandomNOrDefault(randomN), 1, bootstrapMaxTickSample)
    sample.indexes = bootstrapSelectRegionalCandidateIndexes(regions, sample.randomN)
    return sample
