import cheng/libp2p/core/types
import std/rawbytes

const
    Libp2pNodeSelectionRoleBootstrap: int32 = 1
    Libp2pNodeSelectionRoleIngress: int32 = 2

type
    Libp2pNodeSelectionRole = int32

    Libp2pNodeSelectionInput =
        peerId: types.Libp2pPeerId
        endpointText: str
        region: str
        resources: types.Libp2pNodeResource
        successPermille: int32
        latencyMs: int32
        loadPermille: int32
        capacityPermille: int32
        reputationPermille: int32
        sameOperatorPenaltyPermille: int32
        advertisedAtEpochSeconds: int64
        ttlSeconds: int32
        failureCooldownUntilEpochSeconds: int64

    Libp2pNodeSelectionCandidate =
        peerId: types.Libp2pPeerId
        endpointText: str
        region: str
        role: Libp2pNodeSelectionRole
        scorePermille: int32
        ticket: int64

    Libp2pNodeSelectionResult =
        count: int32
        firstInputIndex: int32
        firstScorePermille: int32
        firstTicket: int64
        secondInputIndex: int32
        secondScorePermille: int32
        secondTicket: int64
        thirdInputIndex: int32
        thirdScorePermille: int32
        thirdTicket: int64
        fourthInputIndex: int32
        fourthScorePermille: int32
        fourthTicket: int64

fn Libp2pNodeSelectionClampPermille(value: int32): int32 =
    if value < 0:
        return 0
    if value > 1000:
        return 1000
    return value

fn Libp2pNodeSelectionLatencyScore(latencyMs: int32): int32 =
    if latencyMs <= 0:
        return 500
    if latencyMs <= 30:
        return 1000
    if latencyMs <= 80:
        return 850
    if latencyMs <= 150:
        return 700
    if latencyMs <= 300:
        return 520
    if latencyMs <= 800:
        return 260
    return 80

fn Libp2pNodeSelectionResourceScore(resources: types.Libp2pNodeResource): int32 =
    var score: int32
    if resources.cpuLogicalCores >= 16:
        score = score + 260
    elif resources.cpuLogicalCores >= 8:
        score = score + 210
    elif resources.cpuLogicalCores >= 4:
        score = score + 140
    elif resources.cpuLogicalCores > 0:
        score = score + 70

    let gib = int64(1024) * int64(1024) * int64(1024)
    let memoryGiB = resources.memoryAvailableBytes / gib
    if memoryGiB >= int64(32):
        score = score + 260
    elif memoryGiB >= int64(16):
        score = score + 210
    elif memoryGiB >= int64(8):
        score = score + 150
    elif memoryGiB >= int64(4):
        score = score + 90
    elif memoryGiB > int64(0):
        score = score + 40

    let diskGiB = resources.diskAvailableBytes / gib
    if diskGiB >= int64(512):
        score = score + 180
    elif diskGiB >= int64(128):
        score = score + 130
    elif diskGiB >= int64(32):
        score = score + 80
    elif diskGiB > int64(0):
        score = score + 30

    if resources.gpuDeviceCount > 0 || resources.npuDeviceCount > 0:
        score = score + 140
    if resources.gpuCoreCount > 0 || resources.npuCoreCount > 0:
        score = score + 80
    if score > 1000:
        return 1000
    return score

fn Libp2pNodeSelectionActive(input: var Libp2pNodeSelectionInput, nowEpochSeconds: int64): bool =
    if len(input.endpointText) <= 0:
        return false
    if input.ttlSeconds <= 0:
        return false
    if input.advertisedAtEpochSeconds <= int64(0):
        return false
    if nowEpochSeconds < input.advertisedAtEpochSeconds:
        return false
    if nowEpochSeconds > input.advertisedAtEpochSeconds + int64(input.ttlSeconds):
        return false
    if input.failureCooldownUntilEpochSeconds > nowEpochSeconds:
        return false
    if Libp2pNodeSelectionClampPermille(input.successPermille) <= 0:
        return false
    if Libp2pNodeSelectionClampPermille(input.capacityPermille) <= 0:
        return false
    return true

fn Libp2pNodeSelectionScore(input: var Libp2pNodeSelectionInput,
                             role: Libp2pNodeSelectionRole,
                             nowEpochSeconds: int64): int32 =
    if !Libp2pNodeSelectionActive(input, nowEpochSeconds):
        return 0
    let success = Libp2pNodeSelectionClampPermille(input.successPermille)
    let capacity = Libp2pNodeSelectionClampPermille(input.capacityPermille)
    let idle = 1000 - Libp2pNodeSelectionClampPermille(input.loadPermille)
    let latency = Libp2pNodeSelectionLatencyScore(input.latencyMs)
    let resource = Libp2pNodeSelectionResourceScore(input.resources)
    let reputation = Libp2pNodeSelectionClampPermille(input.reputationPermille)
    let penalty = Libp2pNodeSelectionClampPermille(input.sameOperatorPenaltyPermille)

    var weighted: int32
    if role == Libp2pNodeSelectionRoleIngress:
        weighted = success * 30 + capacity * 30 + idle * 20 + latency * 10 + resource * 5 + reputation * 5
    else:
        weighted = success * 35 + capacity * 25 + idle * 10 + latency * 15 + resource * 10 + reputation * 5
    var score = weighted / 100
    score = score - penalty
    if score < 1:
        return 0
    if score > 1000:
        return 1000
    return score

fn Libp2pNodeSelectionHashStep(hash: int64, value: int32): int64 =
    let mixed = hash ^ int64(value & 255)
    return (mixed * int64(16777619)) % int64(2147483647)

fn Libp2pNodeSelectionHashText(hashIn: int64, text: str): int64 =
    let textBytes = BytesFromString(text)
    var hash = hashIn
    hash = Libp2pNodeSelectionHashStep(hash, BytesLen(textBytes))
    var i: int32
    while i < BytesLen(textBytes):
        hash = Libp2pNodeSelectionHashStep(hash, BytesGet(textBytes, i) & 255)
        i = i + 1
    return hash

fn Libp2pNodeSelectionHashPeer(hashIn: int64, peerId: types.Libp2pPeerId): int64 =
    var hash = hashIn
    for i in 0..<32:
        hash = Libp2pNodeSelectionHashStep(hash, int32(peerId.value.data[i]))
    if hash < int64(0):
        hash = -hash
    return hash

fn Libp2pNodeSelectionAlreadyPicked(out: Libp2pNodeSelectionCandidate[],
                                     selectedCount: int32,
                                     peerId: types.Libp2pPeerId): bool =
    var i: int32
    while i < selectedCount:
        if types.Libp2pPeerIdEqual(out[i].peerId, peerId):
            return true
        i = i + 1
    return false

fn Libp2pNodeSelectionResultInputIndex(result: Libp2pNodeSelectionResult, pickIndex: int32): int32 =
    if pickIndex == 0:
        return result.firstInputIndex
    if pickIndex == 1:
        return result.secondInputIndex
    if pickIndex == 2:
        return result.thirdInputIndex
    return result.fourthInputIndex

fn Libp2pNodeSelectionResultScore(result: Libp2pNodeSelectionResult, pickIndex: int32): int32 =
    if pickIndex == 0:
        return result.firstScorePermille
    if pickIndex == 1:
        return result.secondScorePermille
    if pickIndex == 2:
        return result.thirdScorePermille
    return result.fourthScorePermille

fn Libp2pNodeSelectionResultTicket(result: Libp2pNodeSelectionResult, pickIndex: int32): int64 =
    if pickIndex == 0:
        return result.firstTicket
    if pickIndex == 1:
        return result.secondTicket
    if pickIndex == 2:
        return result.thirdTicket
    return result.fourthTicket

fn Libp2pNodeSelectionResultHasInput(result: Libp2pNodeSelectionResult, inputIndex: int32): bool =
    if result.count > 0 && result.firstInputIndex == inputIndex:
        return true
    if result.count > 1 && result.secondInputIndex == inputIndex:
        return true
    if result.count > 2 && result.thirdInputIndex == inputIndex:
        return true
    if result.count > 3 && result.fourthInputIndex == inputIndex:
        return true
    return false

fn Libp2pNodeSelectionResultAppend(result: var Libp2pNodeSelectionResult,
                                    inputIndex: int32,
                                    scorePermille: int32,
                                    ticket: int64) =
    if result.count == 0:
        result.firstInputIndex = inputIndex
        result.firstScorePermille = scorePermille
        result.firstTicket = ticket
    elif result.count == 1:
        result.secondInputIndex = inputIndex
        result.secondScorePermille = scorePermille
        result.secondTicket = ticket
    elif result.count == 2:
        result.thirdInputIndex = inputIndex
        result.thirdScorePermille = scorePermille
        result.thirdTicket = ticket
    elif result.count == 3:
        result.fourthInputIndex = inputIndex
        result.fourthScorePermille = scorePermille
        result.fourthTicket = ticket
    else:
        return
    result.count = result.count + 1

fn Libp2pNodeSelectionTicket(input: var Libp2pNodeSelectionInput,
                              role: Libp2pNodeSelectionRole,
                              score: int32,
                              entropy: str): int64 =
    var hash = int64(2166136261)
    hash = Libp2pNodeSelectionHashText(hash, entropy)
    hash = Libp2pNodeSelectionHashStep(hash, role)
    hash = Libp2pNodeSelectionHashText(hash, input.endpointText)
    hash = Libp2pNodeSelectionHashText(hash, input.region)
    if hash < int64(0):
        hash = -hash
    let jitter = (hash % int64(1000000)) + int64(1)
    return jitter * int64(score)

fn Libp2pSelectNodesWithEntropy(inputs: var Libp2pNodeSelectionInput[],
                                 role: Libp2pNodeSelectionRole,
                                 limit: int32,
                                 entropy: str,
                                 nowEpochSeconds: int64,
                                 out: var Libp2pNodeSelectionCandidate[]): int32 =
    let result = Libp2pSelectNodeSetWithEntropy(inputs, role, limit, entropy, nowEpochSeconds)
    var i: int32
    while i < result.count:
        let sourceIndex = Libp2pNodeSelectionResultInputIndex(result, i)
        var candidate: Libp2pNodeSelectionCandidate
        candidate.peerId = inputs[sourceIndex].peerId
        candidate.endpointText = inputs[sourceIndex].endpointText
        candidate.region = inputs[sourceIndex].region
        candidate.role = role
        candidate.scorePermille = Libp2pNodeSelectionResultScore(result, i)
        candidate.ticket = Libp2pNodeSelectionResultTicket(result, i)
        add(out, candidate)
        i = i + 1
    return result.count

fn Libp2pSelectNodeSetWithEntropy(inputs: var Libp2pNodeSelectionInput[],
                                   role: Libp2pNodeSelectionRole,
                                   limit: int32,
                                   entropy: str,
                                   nowEpochSeconds: int64): Libp2pNodeSelectionResult =
    var result: Libp2pNodeSelectionResult
    if limit <= 0:
        return result
    var cappedLimit = limit
    if cappedLimit > 4:
        cappedLimit = 4
    while result.count < cappedLimit:
        var bestInputIndex: int32
        var bestScorePermille: int32
        var bestTicket: int64
        var hasBest: bool
        var inputIndex: int32
        while inputIndex < len(inputs):
            let i = inputIndex
            let score = Libp2pNodeSelectionScore(inputs[i], role, nowEpochSeconds)
            if score > 0 && !Libp2pNodeSelectionResultHasInput(result, i):
                let ticket = Libp2pNodeSelectionTicket(inputs[i], role, score, entropy)
                if !hasBest || ticket > bestTicket || (ticket == bestTicket && score > bestScorePermille):
                    bestInputIndex = i
                    bestScorePermille = score
                    bestTicket = ticket
                    hasBest = true
            inputIndex = inputIndex + 1
        if !hasBest:
            break
        Libp2pNodeSelectionResultAppend(result, bestInputIndex, bestScorePermille, bestTicket)
    return result

fn Libp2pSelectBootstrapNodesWithEntropy(inputs: var Libp2pNodeSelectionInput[],
                                          limit: int32,
                                          entropy: str,
                                          nowEpochSeconds: int64,
                                          out: var Libp2pNodeSelectionCandidate[]): int32 =
    return Libp2pSelectNodesWithEntropy(inputs,
                                        Libp2pNodeSelectionRoleBootstrap,
                                        limit,
                                        entropy,
                                        nowEpochSeconds,
                                        out)

fn Libp2pSelectIngressNodesWithEntropy(inputs: var Libp2pNodeSelectionInput[],
                                        limit: int32,
                                        entropy: str,
                                        nowEpochSeconds: int64,
                                        out: var Libp2pNodeSelectionCandidate[]): int32 =
    return Libp2pSelectNodesWithEntropy(inputs,
                                        Libp2pNodeSelectionRoleIngress,
                                        limit,
                                        entropy,
                                        nowEpochSeconds,
                                        out)

fn Libp2pSelectBootstrapNodeSetWithEntropy(inputs: var Libp2pNodeSelectionInput[],
                                            limit: int32,
                                            entropy: str,
                                            nowEpochSeconds: int64): Libp2pNodeSelectionResult =
    return Libp2pSelectNodeSetWithEntropy(inputs,
                                          Libp2pNodeSelectionRoleBootstrap,
                                          limit,
                                          entropy,
                                          nowEpochSeconds)

fn Libp2pSelectIngressNodeSetWithEntropy(inputs: var Libp2pNodeSelectionInput[],
                                          limit: int32,
                                          entropy: str,
                                          nowEpochSeconds: int64): Libp2pNodeSelectionResult =
    return Libp2pSelectNodeSetWithEntropy(inputs,
                                          Libp2pNodeSelectionRoleIngress,
                                          limit,
                                          entropy,
                                          nowEpochSeconds)
