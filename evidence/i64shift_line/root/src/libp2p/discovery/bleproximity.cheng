# BLE proximity discovery(local cache + probe injection).

import cheng/libp2p/utils/result
import std/times
import cheng/libp2p/utils/strings
import cheng/libp2p/discovery/discoverymngr

const
    bleMaxEntries = 64
    bleDefaultTtlSeconds = 90
    bleMinTtlSeconds = 5
    bleMaxTtlSeconds = 600
    bleDefaultServiceName = "_unimaker_ble._udp.local"
    bleDefaultNamespace = "local"

type
    BleProximityConfig =
        ttlSeconds: int64
        maxEntries: int32
        serviceName: str
        namespace: str

    BleEntry =
        attrs: PeerAttributes
        expiresAtNs: int64

    BleState =
        count: int32
        entries: BleEntry[bleMaxEntries]
        config: BleProximityConfig

var
    bleState: BleState = BleState(
        count: 0,
        config: BleProximityConfig(
            ttlSeconds: bleDefaultTtlSeconds,
            maxEntries: bleMaxEntries,
            serviceName: bleDefaultServiceName,
            namespace: bleDefaultNamespace
        )
    )

fn initBleProximityConfig(): BleProximityConfig =
    BleProximityConfig(
        ttlSeconds: bleDefaultTtlSeconds,
        maxEntries: bleMaxEntries,
        serviceName: bleDefaultServiceName,
        namespace: bleDefaultNamespace
    )

fn initBleState(): BleState =
    BleState(
        count: 0,
        config: initBleProximityConfig()
    )

fn setBleState(state: BleState) =
    bleState = state

fn getBleState(): BleState =
    return bleState

fn setBleConfig(config: BleProximityConfig) =
    bleState.config = config

fn normalizeBleText(text: str): str =
    let trimmed: str = trimText(text)
    if len(trimmed) <= 0:
        return ""
    return trimmed

fn clampBleTtlSeconds(ttlSeconds: int64): Result[int64] =
    var ttl: int64 = ttlSeconds
    if ttl <= 0:
        ttl = bleDefaultTtlSeconds
    if ttl < bleMinTtlSeconds || ttl > bleMaxTtlSeconds:
        return Err[int64]("ble: ttl out of range")
    return Ok[int64](ttl)

fn bleEntrySet(state: var BleState, idx: int32, entry: BleEntry) =
    state.entries[idx] = entry

fn bleEntryGet(state: BleState, idx: int32): BleEntry =
    return state.entries[idx]

fn bleEntryPeerId(attrs: PeerAttributes, out: var PeerId): bool =
    return peerAttributesGetPeerId(attrs, out)

fn bleSamePeer(lhs: PeerAttributes, rhs: PeerAttributes): bool =
    var lhsPeer: PeerId
    var rhsPeer: PeerId
    let lhsHas: bool = bleEntryPeerId(lhs, lhsPeer)
    let rhsHas: bool = bleEntryPeerId(rhs, rhsPeer)
    if !lhsHas || !rhsHas:
        return peerAttributesEqual(lhs, rhs)
    let eqRes: Result[bool] = peerIdEqual(lhsPeer, rhsPeer)
    if IsErr(eqRes):
        return false
    return Value(eqRes)

fn bleCleanupExpired(state: var BleState, nowNs: int64) =
    var next: int32
    for i in 0..<state.count:
        let entry: BleEntry = bleEntryGet(state, i)
        if entry.expiresAtNs > nowNs:
            bleEntrySet(state, next, entry)
            next = next + 1
    state.count = next

fn bleUpsert(attrs: PeerAttributes, ttlSeconds: int64): Result[bool] =
    let ttlRes: Result[int64] = clampBleTtlSeconds(ttlSeconds)
    if IsErr(ttlRes):
        return Err[bool](Error(ttlRes))
    let nowNs: int64 = EpochTimeNs()
    bleCleanupExpired(bleState, nowNs)
    var idx: int32 = -1
    for i in 0..<bleState.count:
        if bleSamePeer(bleState.entries[i].attrs, attrs):
            idx = i
            break
    var entry: BleEntry
    entry.attrs = attrs
    entry.expiresAtNs = nowNs + Value(ttlRes) * 1000000000
    if idx >= 0:
        bleEntrySet(bleState, idx, entry)
        return Ok[bool](true)
    let capacity: int32 =
        if bleState.config.maxEntries > 0 && bleState.config.maxEntries < bleMaxEntries:
            bleState.config.maxEntries
        else:
            bleMaxEntries
    if bleState.count >= capacity:
        return Err[bool]("ble: entry limit reached")
    bleEntrySet(bleState, bleState.count, entry)
    bleState.count = bleState.count + 1
    return Ok[bool](true)

fn ensureBleServiceAndNamespace(attrs: PeerAttributes): Result[PeerAttributes] =
    var out: PeerAttributes = attrs
    let serviceDefault: str =
        if len(normalizeBleText(bleState.config.serviceName)) > 0:
            normalizeBleText(bleState.config.serviceName)
        else:
            bleDefaultServiceName
    let namespaceDefault: str =
        if len(normalizeBleText(bleState.config.namespace)) > 0:
            normalizeBleText(bleState.config.namespace)
        else:
            bleDefaultNamespace
    var serviceText: str
    if !peerAttributesGetService(out, serviceText):
        let addSvcRes: Result[bool] = peerAttributesAddService(out, serviceDefault)
        if IsErr(addSvcRes):
            return Err[PeerAttributes](Error(addSvcRes))
    var namespaceText: str
    if !peerAttributesGetNamespace(out, namespaceText):
        let addNsRes: Result[bool] = peerAttributesAddNamespace(out, namespaceDefault)
        if IsErr(addNsRes):
            return Err[PeerAttributes](Error(addNsRes))
    return Ok[PeerAttributes](out)

fn bleAdvertise(attrs: PeerAttributes): Result[bool] =
    let attrsRes: Result[PeerAttributes] = ensureBleServiceAndNamespace(attrs)
    if IsErr(attrsRes):
        return Err[bool](Error(attrsRes))
    return bleUpsert(Value(attrsRes), bleState.config.ttlSeconds)

fn bleDiscover(query: PeerAttributes, out: var PeerAttributesList): Result[bool] =
    let nowNs: int64 = EpochTimeNs()
    bleCleanupExpired(bleState, nowNs)
    for i in 0..<bleState.count:
        let entry: BleEntry = bleState.entries[i]
        if peerAttributesMatch(query, entry.attrs):
            if !peerAttributesListContains(out, entry.attrs):
                let addRes: Result[bool] = peerAttributesListAdd(out, entry.attrs)
                if IsErr(addRes):
                    return Err[bool](Error(addRes))
    return Ok[bool](true)

fn bleProbeInject(attrs: PeerAttributes): Result[bool] =
    return bleAdvertise(attrs)

fn bleDiscoveryInterface(): DiscoveryInterface =
    return initDiscoveryInterface(bleDiscover, bleAdvertise, true, true)
