# Rendezvous discovery helpers(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/strings
import cheng/libp2p/peerid
import cheng/libp2p/peerinfo
import cheng/libp2p/routing_record
import cheng/libp2p/protocols/rendezvous/protobuf
import cheng/libp2p/discovery/discoverymngr
import cheng/libp2p/switch
const
    maxRendezvousPeers = 32

type
    RendezvousDiscoveryResult =
        count: int32
        peers: PeerInfo[maxRendezvousPeers]
        hasCookie: bool
        cookie: Bytes

    RendezvousInterface =
        sw: Switch
        serverPeer: PeerId
        defaultNamespace: str
        defaultTtlSeconds: int64
        defaultLimit: int64

fn peerInfoFromSignedPeerRecord(data: Bytes): Result[PeerInfo] =
    let sprRes: Result[SignedPeerRecord] = decodeSignedPeerRecord(data)
    if IsErr(sprRes):
        return Err[PeerInfo](Error(sprRes))
    let spr: SignedPeerRecord = Value(sprRes)
    var info: PeerInfo = newPeerInfo(spr.data.peerId)
    for i in 0..<spr.data.addressCount:
        let addRes: Result[bool] = addAddress(info, spr.data.addresses[i].address)
        if IsErr(addRes):
            return Err[PeerInfo](Error(addRes))
    return Ok[PeerInfo](info)

fn peerInfoToAttributes(info: PeerInfo, ns: str): Result[PeerAttributes] =
    var out: PeerAttributes = initPeerAttributes()
    let pidRes: Result[bool] = peerAttributesAddPeerId(out, info.id)
    if IsErr(pidRes):
        return Err[PeerAttributes](Error(pidRes))
    for i in 0..<info.addrs.count:
        let addRes: Result[bool] = peerAttributesAddAddress(out, info.addrs.items[i])
        if IsErr(addRes):
            return Err[PeerAttributes](Error(addRes))
    if len(ns) > 0:
        let svcRes: Result[bool] = peerAttributesAddService(out, ns)
        if IsErr(svcRes):
            return Err[PeerAttributes](Error(svcRes))
        let nsRes: Result[bool] = peerAttributesAddNamespace(out, ns)
        if IsErr(nsRes):
            return Err[PeerAttributes](Error(nsRes))
    return Ok[PeerAttributes](out)

fn discoverResponseToPeers(resp: RendezvousDiscoverResponse): Result[RendezvousDiscoveryResult] =
    if resp.status != rvOk:
        if resp.hasText:
            return Err[RendezvousDiscoveryResult](resp.text)
        return Err[RendezvousDiscoveryResult]("rendezvous: discover failed")
    var out: RendezvousDiscoveryResult = RendezvousDiscoveryResult(count: 0, hasCookie: resp.hasCookie, cookie: resp.cookie)
    for i in 0..<resp.registrationCount:
        if ! (i < resp.registrationCount && out.count < maxRendezvousPeers):
            break
        let infoRes: Result[PeerInfo] = peerInfoFromSignedPeerRecord(resp.registrations[i].signedPeerRecord)
        if IsErr(infoRes):
            return Err[RendezvousDiscoveryResult](Error(infoRes))
        out.peers[out.count] = Value(infoRes)
        out.count = out.count + 1
    return Ok[RendezvousDiscoveryResult](out)

fn rendezvousAdvertiseSelf(
    sw: var Switch,
    peer: PeerId,
    ns: str,
    ttlSeconds: int64
): Result[bool] =
    let respRes: Result[RendezvousRegisterResponse] = rendezvousRegisterSelf(sw, peer, ns, ttlSeconds)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: RendezvousRegisterResponse = Value(respRes)
    if resp.status != rvOk:
        if resp.hasText:
            return Err[bool](resp.text)
        return Err[bool]("rendezvous: register failed")
    return Ok[bool](true)

fn rendezvousDiscoverPeers(
    sw: var Switch,
    peer: PeerId,
    ns: str,
    limit: int64,
    cookie: Bytes
): Result[RendezvousDiscoveryResult] =
    let respRes: Result[RendezvousDiscoverResponse] = rendezvousDiscover(sw, peer, ns, limit, cookie)
    if IsErr(respRes):
        return Err[RendezvousDiscoveryResult](Error(respRes))
    return discoverResponseToPeers(Value(respRes))

fn initRendezvousInterface(
    sw: Switch,
    serverPeer: PeerId,
    defaultNamespace: str,
    defaultTtlSeconds: int64,
    defaultLimit: int64
): RendezvousInterface =
    RendezvousInterface(
        sw: sw,
        serverPeer: serverPeer,
        defaultNamespace: defaultNamespace,
        defaultTtlSeconds: defaultTtlSeconds,
        defaultLimit: defaultLimit
    )

fn rendezvousInterfaceDiscover(
    iface: var RendezvousInterface,
    query: PeerAttributes,
    out: var PeerAttributesList
): Result[bool] =
    var ns: str
    var pid: PeerId
    if ! peerAttributesGetNamespace(query, ns):
        if ! peerAttributesGetService(query, ns):
            if peerAttributesGetPeerId(query, pid):
                ns = toString(pid)
    if len(ns) <= 0:
        ns = iface.defaultNamespace
    let limit: int64 = if iface.defaultLimit > 0: iface.defaultLimit else: 0
    let respRes: Result[RendezvousDiscoveryResult] = rendezvousDiscoverPeers(
        iface.sw,
        iface.serverPeer,
        ns,
        limit,
        EmptyBytes()
    )
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: RendezvousDiscoveryResult = Value(respRes)
    for i in 0..<resp.count:
        let attrRes: Result[PeerAttributes] = peerInfoToAttributes(resp.peers[i], ns)
        if IsErr(attrRes):
            return Err[bool](Error(attrRes))
        let addRes: Result[bool] = peerAttributesListAdd(out, Value(attrRes))
        if IsErr(addRes):
            return Err[bool](Error(addRes))
    return Ok[bool](true)

fn rendezvousInterfaceAdvertise(
    iface: var RendezvousInterface,
    attrs: PeerAttributes
): Result[bool] =
    var usedDefault: bool = true
    for i in 0..<attrs.count:
        let item: PeerAttribute = attrs.items[i]
        if item.kind == attrNamespace || item.kind == attrService:
            let ttl: int64 = if iface.defaultTtlSeconds > 0: iface.defaultTtlSeconds else: 0
            let advRes: Result[bool] = rendezvousAdvertiseSelf(iface.sw, iface.serverPeer, item.text, ttl)
            if IsErr(advRes):
                return Err[bool](Error(advRes))
            usedDefault = false
        if item.kind == attrPeerId:
            let ttl: int64 = if iface.defaultTtlSeconds > 0: iface.defaultTtlSeconds else: 0
            let advRes: Result[bool] = rendezvousAdvertiseSelf(iface.sw, iface.serverPeer, peerid.toString(item.peerId), ttl)
            if IsErr(advRes):
                return Err[bool](Error(advRes))
            usedDefault = false
    if usedDefault && len(iface.defaultNamespace) > 0:
        let ttl: int64 = if iface.defaultTtlSeconds > 0: iface.defaultTtlSeconds else: 0
        let advRes: Result[bool] = rendezvousAdvertiseSelf(iface.sw, iface.serverPeer, iface.defaultNamespace, ttl)
        if IsErr(advRes):
            return Err[bool](Error(advRes))
    return Ok[bool](true)

fn rendezvousDiscoveryInterface(iface: var RendezvousInterface): DiscoveryInterface =
    return initDiscoveryInterface(
        fn(query: PeerAttributes, out: var PeerAttributesList): Result[bool] =
            return rendezvousInterfaceDiscover(iface, query, out),
        fn(attrs: PeerAttributes): Result[bool] =
            return rendezvousInterfaceAdvertise(iface, attrs),
        true,
        true
    )
