# Auto relay service(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import std/stringlist
type
    AutoRelayConfig =
        enabled: bool
        maxPeers: int32

    AutoRelayContext =
        config: AutoRelayConfig
        peers: StringList

var
    autoRelayContext: AutoRelayContext = AutoRelayContext(
        config: AutoRelayConfig(enabled: true, maxPeers: 8),
        peers: InitStringList()
    )

fn initAutoRelayConfig(): AutoRelayConfig =
    AutoRelayConfig(enabled: true, maxPeers: 8)

fn setAutoRelayConfig(config: AutoRelayConfig) =
    autoRelayContext.config = config

fn autoRelayEnabled(): bool =
    autoRelayContext.config.enabled

fn autoRelayReset() =
    autoRelayContext.peers = InitStringList()

fn autoRelayCount(): int32 =
    autoRelayContext.peers.count

fn autoRelayAddPeer(peer: str): Result[bool] =
    if ! autoRelayEnabled():
        return Err[bool]("autorelay: disabled")
    if len(peer) <= 0:
        return Err[bool]("autorelay: empty peer")
    if autoRelayContext.config.maxPeers > 0 && autoRelayContext.peers.count >= autoRelayContext.config.maxPeers:
        return Err[bool]("autorelay: max peers reached")
    return StringListAdd(autoRelayContext.peers, peer)

fn autoRelayPeers(): StringList =
    return autoRelayContext.peers

fn autoRelayDump(): str =
    return StringListToLines(autoRelayContext.peers)
