# Wildcard resolver service(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
const
    maxWildcardRules = 32

type
    WildcardRule =
        suffix: str
        target: str

    WildcardResolver =
        count: int32
        items: WildcardRule[maxWildcardRules]

var
    wildcardResolver: WildcardResolver = WildcardResolver(count: 0)

fn initWildcardResolver(): WildcardResolver =
    WildcardResolver(count: 0)

fn wildcardReset() =
    wildcardResolver = initWildcardResolver()

fn wildcardCount(): int32 =
    return wildcardResolver.count

fn endsWith(text: str, suffix: str): bool =
    let tlen: int32 = len(text)
    let slen: int32 = len(suffix)
    if slen <= 0:
        return false
    if tlen < slen:
        return false
    for i in 0..<slen:
        if text[tlen - slen + i] != suffix[i]:
            return false
    return true

fn wildcardAddRule(suffix: str, target: str): Result[bool] =
    if len(suffix) <= 0:
        return Err[bool]("wildcard: empty suffix")
    if len(target) <= 0:
        return Err[bool]("wildcard: empty target")
    if wildcardResolver.count >= maxWildcardRules:
        return Err[bool]("wildcard: rules full")
    wildcardResolver.items[wildcardResolver.count] = WildcardRule(suffix: suffix, target: target)
    wildcardResolver.count = wildcardResolver.count + 1
    return Ok[bool](true)

fn wildcardResolve(host: str): Result[str] =
    if len(host) <= 0:
        return Err[str]("wildcard: empty host")
    for i in 0..<wildcardResolver.count:
        let rule: WildcardRule = wildcardResolver.items[i]
        if endsWith(host, rule.suffix):
            return Ok[str](rule.target)
    return Err[str]("wildcard: no match")

fn wildcardDump(): str =
    if wildcardResolver.count <= 0:
        return ""
    var out: str
    for i in 0..<wildcardResolver.count:
        let rule: WildcardRule = wildcardResolver.items[i]
        var line: str = rule.suffix + "->"
        line = line + rule.target
        if len(out) == 0:
            out = line
        else:
            out = out + "\n"
            out = out + line
    return out
