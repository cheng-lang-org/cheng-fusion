# Hole punch service(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
type
    HpConfig =
        enabled: bool
        maxAttempts: int32
        timeoutMs: int32

    HpContext =
        config: HpConfig
        attempts: int32
        lastStatus: str

var
    hpContext: HpContext = HpContext(
        config: HpConfig(enabled: true, maxAttempts: 3, timeoutMs: 10000),
        attempts: 0,
        lastStatus: ""
    )

fn initHpConfig(): HpConfig =
    HpConfig(enabled: true, maxAttempts: 3, timeoutMs: 10000)

fn setHpConfig(config: HpConfig) =
    hpContext.config = config

fn hpEnabled(): bool =
    hpContext.config.enabled

fn hpReset() =
    hpContext.attempts = 0
    hpContext.lastStatus = ""

fn hpLastStatus(): str =
    return hpContext.lastStatus

fn hpAttempt(): Result[bool] =
    if ! hpEnabled():
        hpContext.lastStatus = "disabled"
        return Err[bool]("hp: disabled")
    if hpContext.config.maxAttempts > 0 && hpContext.attempts >= hpContext.config.maxAttempts:
        hpContext.lastStatus = "max attempts reached"
        return Err[bool]("hp: max attempts reached")
    hpContext.attempts = hpContext.attempts + 1
    hpContext.lastStatus = "ok"
    return Ok[bool](true)

fn hpAttemptCount(): int32 =
    return hpContext.attempts
