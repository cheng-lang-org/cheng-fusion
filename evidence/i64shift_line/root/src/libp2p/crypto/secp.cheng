# Secp256k1 helpers(minimal, toy curve).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/crypto/rand
import cheng/libp2p/crypto/sha256
const
    skRawPrivateKeySize = 32
    skRawPublicKeySize = 33
    skRawSignatureSize = 65

    secpP = 2147483647
    secpA = 0
    secpB = 7
    secpN = 2147483647
    secpGx = 2
    secpGy = 1393679181

type
    SkPoint =
        x: int64
        y: int64
        inf: bool

    SkPrivateKey =
        d: int64

    SkPublicKey =
        point: SkPoint

    SkSignature =
        r: int64
        s: int64

    SkKeyPair =
        seckey: SkPrivateKey
        pubkey: SkPublicKey

fn modp(x: int64): int64 =
    var v: int64 = x % secpP
    if v < 0:
        v = v + secpP
    return v

fn modn(x: int64): int64 =
    var v: int64 = x % secpN
    if v < 0:
        v = v + secpN
    return v

fn secpMulMod(a: int64, b: int64, modv: int64): int64 =
    var res: int64
    var x: int64 = a % modv
    var y: int64 = b
    while y > 0: # cheng-syntax-policy: allow-counting-while
        if (y & 1) != 0:
            res = (res + x) % modv
        x = (x << 1) % modv
        y = y >> 1
    return res

fn secpPowMod(base: int64, exp: int64, modv: int64): int64 =
    var result: int64 = 1 % modv
    var b: int64 = base % modv
    var e: int64 = exp
    while e > 0: # cheng-syntax-policy: allow-counting-while
        if (e & 1) != 0:
            result = secpMulMod(result, b, modv)
        b = secpMulMod(b, b, modv)
        e = e >> 1
    return result

fn secpModInv(a: int64, modv: int64): Result[int64] =
    var t: int64
    var newT: int64 = 1
    var r: int64 = modv
    var newR: int64 = a % modv
    while newR != 0:
        let q: int64 = r / newR
        let nextT: int64 = t - q * newT
        t = newT
        newT = nextT
        let nextR: int64 = r - q * newR
        r = newR
        newR = nextR
    if r != 1 && r != -1:
        return Err[int64]("secp: inverse ! found")
    if t < 0:
        t = t + modv
    return Ok[int64](t)

fn skPointIsInfinity(p: SkPoint): bool =
    return p.inf

fn skPointInfinity(): SkPoint =
    return SkPoint(x: 0, y: 0, inf: true)

fn skPointAdd(p1: SkPoint, p2: SkPoint): SkPoint =
    if skPointIsInfinity(p1):
        return p2
    if skPointIsInfinity(p2):
        return p1
    if p1.x == p2.x && modp(p1.y + p2.y) == 0:
        return skPointInfinity()
    if p1.x == p2.x && p1.y == p2.y:
        let num: int64 = modp(3 * secpMulMod(p1.x, p1.x, secpP) + secpA)
        let denom: int64 = modp(2 * p1.y)
        let invRes: Result[int64] = secpModInv(denom, secpP)
        if IsErr(invRes):
            return skPointInfinity()
        let lambda: int64 = secpMulMod(num, Value(invRes), secpP)
        let x3: int64 = modp(secpMulMod(lambda, lambda, secpP) - p1.x - p2.x)
        let y3: int64 = modp(secpMulMod(lambda, p1.x - x3, secpP) - p1.y)
        return SkPoint(x: x3, y: y3, inf: false)
    let num: int64 = modp(p2.y - p1.y)
    let denom: int64 = modp(p2.x - p1.x)
    let invRes: Result[int64] = secpModInv(denom, secpP)
    if IsErr(invRes):
        return skPointInfinity()
    let lambda: int64 = secpMulMod(num, Value(invRes), secpP)
    let x3: int64 = modp(secpMulMod(lambda, lambda, secpP) - p1.x - p2.x)
    let y3: int64 = modp(secpMulMod(lambda, p1.x - x3, secpP) - p1.y)
    return SkPoint(x: x3, y: y3, inf: false)

fn skPointMul(k: int64, p: SkPoint): SkPoint =
    var result: SkPoint = skPointInfinity()
    var addend: SkPoint = p
    var n: int64 = k
    while n > 0: # cheng-syntax-policy: allow-counting-while
        if (n & 1) != 0:
            result = skPointAdd(result, addend)
        addend = skPointAdd(addend, addend)
        n = n >> 1
    return result

fn int64ToBytesFixed(value: int64, size: int32): Bytes =
    let out: Bytes = BytesAlloc(size)
    var v: int64 = value
    var i: int32 = size - 1
    let loop_start_i_1 = i
    for loop_rev_i_1 in 0..(loop_start_i_1 - (0)):
        i = loop_start_i_1 - loop_rev_i_1
        if ! (i >= 0):
            break
        BytesSet(out, i, int32(v & 255))
        v = v >> 8
    return out

fn bytesToInt64Fixed(data: Bytes, offset: int32, size: int32): int64 =
    var v: int64
    for i in 0..<size:
        v = (v << 8) | int64(BytesGet(data, offset + i))
    return v

fn secpBytesToInt64Mod(data: Bytes, modv: int64): int64 =
    if modv <= 0:
        return 0
    var acc: int64
    for i in 0..<BytesLen(data):
        acc = (acc * 256 + int64(BytesGet(data, i))) % modv
    return acc

fn scalarFromBytes(data: Bytes): Result[int64] =
    if BytesLen(data) != skRawPrivateKeySize:
        return Err[int64]("secp: invalid private key length")
    let v: int64 = bytesToInt64Fixed(data, skRawPrivateKeySize - 8, 8)
    let d: int64 = modn(v)
    if d == 0:
        return Err[int64]("secp: invalid private key value")
    return Ok[int64](d)

fn scalarToBytes(value: int64): Bytes =
    let out: Bytes = BytesAlloc(skRawPrivateKeySize)
    let tail: Bytes = int64ToBytesFixed(value, 8)
    for i in 0..<8:
        BytesSet(out, skRawPrivateKeySize - 8 + i, BytesGet(tail, i))
    return out

fn publicKeyFromPrivate(priv: SkPrivateKey): Result[SkPublicKey] =
    if priv.d <= 0:
        return Err[SkPublicKey]("secp: invalid private key")
    let g: SkPoint = SkPoint(x: secpGx, y: secpGy, inf: false)
    let p: SkPoint = skPointMul(priv.d, g)
    return Ok[SkPublicKey](SkPublicKey(point: p))

fn generateSecpKeyPair(): Result[SkKeyPair] =
    let seedRes: Result[Bytes] = rand.randomBytes(skRawPrivateKeySize)
    if IsErr(seedRes):
        return Err[SkKeyPair](Error(seedRes))
    let dRes: Result[int64] = scalarFromBytes(Value(seedRes))
    if IsErr(dRes):
        return Err[SkKeyPair](Error(dRes))
    let priv: SkPrivateKey = SkPrivateKey(d: Value(dRes))
    let pubRes: Result[SkPublicKey] = publicKeyFromPrivate(priv)
    if IsErr(pubRes):
        return Err[SkKeyPair](Error(pubRes))
    return Ok[SkKeyPair](SkKeyPair(seckey: priv, pubkey: Value(pubRes)))

fn PrivateKeyFromBytes(data: Bytes): Result[SkPrivateKey] =
    let dRes: Result[int64] = scalarFromBytes(data)
    if IsErr(dRes):
        return Err[SkPrivateKey](Error(dRes))
    return Ok[SkPrivateKey](SkPrivateKey(d: Value(dRes)))

fn PublicKeyFromBytes(data: Bytes): Result[SkPublicKey] =
    if BytesLen(data) != skRawPublicKeySize:
        return Err[SkPublicKey]("secp: invalid public key length")
    let prefix: int32 = BytesGet(data, 0)
    if prefix != 0x02 && prefix != 0x03:
        return Err[SkPublicKey]("secp: invalid public key prefix")
    let x: int64 = bytesToInt64Fixed(data, 1 + (skRawPublicKeySize - 1 - 8), 8)
    let xmod: int64 = modp(x)
    let x2: int64 = modp(secpMulMod(xmod, xmod, secpP))
    let rhs: int64 = modp(secpMulMod(x2, xmod, secpP) + secpA * xmod + secpB)
    let y: int64 = secpPowMod(rhs, (secpP + 1) / 4, secpP)
    let ymod: int64 = modp(y)
    let parity: int32 = int32(ymod & 1)
    let wantOdd: bool = prefix == 0x03
    let yCandidate: int64 = secpP - ymod
    var yFinal: int64 = ymod
    if (parity == 1) != wantOdd:
        yFinal = modp(yCandidate)
    let y2: int64 = modp(secpMulMod(yFinal, yFinal, secpP))
    if y2 != rhs:
        return Err[SkPublicKey]("secp: point ! on curve")
    return Ok[SkPublicKey](SkPublicKey(point: SkPoint(x: xmod, y: yFinal, inf: false)))

fn SignatureFromBytes(data: Bytes): Result[SkSignature] =
    if BytesLen(data) != skRawSignatureSize:
        return Err[SkSignature]("secp: invalid signature length")
    let r: int64 = bytesToInt64Fixed(data, 1 + 32 - 8, 8)
    let s: int64 = bytesToInt64Fixed(data, 1 + 32 + (32 - 8), 8)
    let rr: int64 = modn(r)
    let ss: int64 = modn(s)
    if rr == 0 || ss == 0:
        return Err[SkSignature]("secp: invalid signature value")
    return Ok[SkSignature](SkSignature(r: rr, s: ss))

fn privateKeyFromBytes(data: Bytes): Result[SkPrivateKey] =
    return PrivateKeyFromBytes(data)

fn publicKeyFromBytes(data: Bytes): Result[SkPublicKey] =
    return PublicKeyFromBytes(data)

fn signatureFromBytes(data: Bytes): Result[SkSignature] =
    return SignatureFromBytes(data)

fn privateKeyToBytes(key: SkPrivateKey): Bytes =
    return scalarToBytes(key.d)

fn publicKeyToBytes(key: SkPublicKey): Bytes =
    let out: Bytes = BytesAlloc(skRawPublicKeySize)
    let prefix: int32 = if (key.point.y & 1) == 1: 0x03 else: 0x02
    BytesSet(out, 0, prefix)
    let xBytes: Bytes = scalarToBytes(key.point.x)
    let copyLen: int32 = skRawPublicKeySize - 1
    for i in 0..<copyLen:
        BytesSet(out, 1 + i, BytesGet(xBytes, i))
    return out

fn signatureToBytes(sig: SkSignature): Bytes =
    let out: Bytes = BytesAlloc(skRawSignatureSize)
    BytesSet(out, 0, 0)
    let rBytes: Bytes = scalarToBytes(sig.r)
    let sBytes: Bytes = scalarToBytes(sig.s)
    for i in 0..<32:
        BytesSet(out, 1 + i, BytesGet(rBytes, i))
        BytesSet(out, 1 + 32 + i, BytesGet(sBytes, i))
    return out

fn sign(key: SkPrivateKey, msg: Bytes): Result[SkSignature] =
    if key.d <= 0:
        return Err[SkSignature]("secp: invalid private key")
    let g: SkPoint = SkPoint(x: secpGx, y: secpGy, inf: false)
    let e: int64 = secpBytesToInt64Mod(Sha256Digest(msg), secpN)
    var attempt: int32
    while attempt < 100: # cheng-syntax-policy: allow-counting-while
        let kRes: Result[Bytes] = rand.randomBytes(skRawPrivateKeySize)
        if IsErr(kRes):
            return Err[SkSignature](Error(kRes))
        let kValRes: Result[int64] = scalarFromBytes(Value(kRes))
        if IsErr(kValRes):
            attempt = attempt + 1
            continue
        let k: int64 = Value(kValRes)
        let p: SkPoint = skPointMul(k, g)
        let r: int64 = modn(p.x)
        if r == 0:
            attempt = attempt + 1
            continue
        let kInvRes: Result[int64] = secpModInv(k, secpN)
        if IsErr(kInvRes):
            attempt = attempt + 1
            continue
        let kInv: int64 = Value(kInvRes)
        let s: int64 = modn(secpMulMod(kInv, modn(e + secpMulMod(r, key.d, secpN)), secpN))
        if s == 0:
            attempt = attempt + 1
            continue
        return Ok[SkSignature](SkSignature(r: r, s: s))
    return Err[SkSignature]("secp: sign failed")

fn verify(sig: SkSignature, msg: Bytes, key: SkPublicKey): bool =
    if sig.r <= 0 || sig.s <= 0:
        return false
    let e: int64 = secpBytesToInt64Mod(Sha256Digest(msg), secpN)
    let wRes: Result[int64] = secpModInv(sig.s, secpN)
    if IsErr(wRes):
        return false
    let w: int64 = Value(wRes)
    let u1: int64 = modn(secpMulMod(e, w, secpN))
    let u2: int64 = modn(secpMulMod(sig.r, w, secpN))
    let g: SkPoint = SkPoint(x: secpGx, y: secpGy, inf: false)
    let p1: SkPoint = skPointMul(u1, g)
    let p2: SkPoint = skPointMul(u2, key.point)
    let p: SkPoint = skPointAdd(p1, p2)
    if skPointIsInfinity(p):
        return false
    let v: int64 = modn(p.x)
    return v == sig.r

fn validateSecpPrivateKeyBytes(data: Bytes): bool =
    let res: Result[SkPrivateKey] = PrivateKeyFromBytes(data)
    return IsOk(res)

fn validateSecpPublicKeyBytes(data: Bytes): bool =
    let res: Result[SkPublicKey] = PublicKeyFromBytes(data)
    return IsOk(res)

fn validateSecpSignatureBytes(data: Bytes): bool =
    let res: Result[SkSignature] = SignatureFromBytes(data)
    return IsOk(res)

fn secpPublicKeyFromPrivateBytes(data: Bytes): Result[Bytes] =
    let privRes: Result[SkPrivateKey] = PrivateKeyFromBytes(data)
    if IsErr(privRes):
        return Err[Bytes](Error(privRes))
    let pubRes: Result[SkPublicKey] = publicKeyFromPrivate(Value(privRes))
    if IsErr(pubRes):
        return Err[Bytes](Error(pubRes))
    return Ok[Bytes](publicKeyToBytes(Value(pubRes)))

fn secpSignBytes(privData: Bytes, msg: Bytes): Result[Bytes] =
    let privRes: Result[SkPrivateKey] = PrivateKeyFromBytes(privData)
    if IsErr(privRes):
        return Err[Bytes](Error(privRes))
    let sigRes: Result[SkSignature] = sign(Value(privRes), msg)
    if IsErr(sigRes):
        return Err[Bytes](Error(sigRes))
    return Ok[Bytes](signatureToBytes(Value(sigRes)))

fn secpVerifyBytes(pubData: Bytes, msg: Bytes, sig: Bytes): bool =
    let pubRes: Result[SkPublicKey] = PublicKeyFromBytes(pubData)
    if IsErr(pubRes):
        return false
    let sigRes: Result[SkSignature] = SignatureFromBytes(sig)
    if IsErr(sigRes):
        return false
    return verify(Value(sigRes), msg, Value(pubRes))
