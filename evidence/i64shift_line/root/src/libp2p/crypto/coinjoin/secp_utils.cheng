# CoinJoin secp256k1 helpers(minimal, toy curve).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/varint
import cheng/libp2p/crypto/sha256
import cheng/libp2p/crypto/hkdf
import cheng/libp2p/crypto/secp
import cheng/libp2p/crypto/coinjoin/types
const
    pedersenLabel = "coinjoin-blind"

var pedersenBaseCached: SkPublicKey
var pedersenBaseInit: bool

fn appendString(buf: Bytes, text: str): Bytes =
    if len(text) <= 0:
        return buf
    return BytesConcat(buf, BytesFromString(text))

fn appendVarint(buf: Bytes, value: int64): Bytes =
    let enc: Bytes = encodeUVarint(value)
    return BytesConcat(buf, enc)

fn serializePoint(pk: SkPublicKey): CoinJoinPoint =
    publicKeyToBytes(pk)

fn deserializePoint(point: CoinJoinPoint): CoinJoinResult[SkPublicKey] =
    let res: Result[SkPublicKey] = publicKeyFromBytes(point)
    if IsErr(res):
        return Err[SkPublicKey](coinJoinErrorText(cjInvalidInput, Error(res)))
    return Ok[SkPublicKey](Value(res))

fn scalarToPub(scalar: CoinJoinAmount): CoinJoinResult[SkPublicKey] =
    let privRes: Result[SkPrivateKey] = privateKeyFromBytes(scalar)
    if IsErr(privRes):
        return Err[SkPublicKey](coinJoinErrorText(cjInvalidInput, Error(privRes)))
    let pubRes: Result[SkPublicKey] = publicKeyFromPrivate(Value(privRes))
    if IsErr(pubRes):
        return Err[SkPublicKey](coinJoinErrorText(cjInternal, Error(pubRes)))
    return Ok[SkPublicKey](Value(pubRes))

fn getPedersenBase(): CoinJoinResult[SkPublicKey] =
    if pedersenBaseInit:
        return Ok[SkPublicKey](pedersenBaseCached)
    for counter in 0..<1024:
        var ctx: Bytes = BytesFromString(pedersenLabel)
        ctx = appendVarint(ctx, counter)
        let digest: Bytes = Sha256Digest(ctx)
        let privRes: Result[SkPrivateKey] = privateKeyFromBytes(digest)
        if IsOk(privRes):
            let pubRes: Result[SkPublicKey] = publicKeyFromPrivate(Value(privRes))
            if IsOk(pubRes):
                pedersenBaseCached = Value(pubRes)
                pedersenBaseInit = true
                return Ok[SkPublicKey](pedersenBaseCached)
    return Err[SkPublicKey](coinJoinErrorText(cjInternal, "pedersen base ! found"))

fn publicKeyNegate(pk: SkPublicKey): CoinJoinResult[SkPublicKey] =
    let neg: SkPoint = SkPoint(x: pk.point.x, y: modp(-pk.point.y), inf: pk.point.inf)
    return Ok[SkPublicKey](SkPublicKey(point: neg))

fn publicKeyTweakMul(base: SkPublicKey, scalar: CoinJoinBlind): CoinJoinResult[SkPublicKey] =
    let sRes: Result[int64] = scalarFromBytes(scalar)
    if IsErr(sRes):
        return Err[SkPublicKey](coinJoinErrorText(cjInvalidInput, Error(sRes)))
    let p: SkPoint = skPointMul(Value(sRes), base.point)
    return Ok[SkPublicKey](SkPublicKey(point: p))

fn publicKeyCombine(keys: CommitmentList): CoinJoinResult[SkPublicKey] =
    if commitmentListCount(keys) <= 0:
        return Err[SkPublicKey](coinJoinErrorText(cjInvalidInput, "no keys to combine"))
    var acc: SkPoint = skPointInfinity()
    for i in 0..<commitmentListCount(keys):
        let keyRes: CoinJoinResult[SkPublicKey] = deserializePoint(commitmentListGet(keys, i).point)
        if IsErr(keyRes):
            return Err[SkPublicKey](Error(keyRes))
        acc = skPointAdd(acc, Value(keyRes).point)
    let out: SkPublicKey = SkPublicKey(point: acc)
    return Ok[SkPublicKey](out)

fn publicKeyCombineKeys(keys: SkPublicKey[maxCoinJoinParticipants], count: int32): CoinJoinResult[SkPublicKey] =
    if count <= 0:
        return Err[SkPublicKey](coinJoinErrorText(cjInvalidInput, "no keys to combine"))
    var acc: SkPoint = skPointInfinity()
    for i in 0..<count:
        acc = skPointAdd(acc, keys[i].point)
    let out: SkPublicKey = SkPublicKey(point: acc)
    return Ok[SkPublicKey](out)

fn scalarAdd(a: CoinJoinBlind, b: CoinJoinBlind): CoinJoinResult[CoinJoinBlind] =
    let aRes: Result[int64] = scalarFromBytes(a)
    if IsErr(aRes):
        return Err[CoinJoinBlind](coinJoinErrorText(cjInvalidInput, Error(aRes)))
    let bRes: Result[int64] = scalarFromBytes(b)
    if IsErr(bRes):
        return Err[CoinJoinBlind](coinJoinErrorText(cjInvalidInput, Error(bRes)))
    let sum: int64 = modn(Value(aRes) + Value(bRes))
    return Ok[CoinJoinBlind](scalarToBytes(sum))

fn scalarMul(a: CoinJoinBlind, b: CoinJoinBlind): CoinJoinResult[CoinJoinBlind] =
    let aRes: Result[int64] = scalarFromBytes(a)
    if IsErr(aRes):
        return Err[CoinJoinBlind](coinJoinErrorText(cjInvalidInput, Error(aRes)))
    let bRes: Result[int64] = scalarFromBytes(b)
    if IsErr(bRes):
        return Err[CoinJoinBlind](coinJoinErrorText(cjInvalidInput, Error(bRes)))
    let prod: int64 = modn(secpMulMod(Value(aRes), Value(bRes), secpN))
    return Ok[CoinJoinBlind](scalarToBytes(prod))

fn scalarNegate(value: CoinJoinBlind): CoinJoinResult[CoinJoinBlind] =
    let vRes: Result[int64] = scalarFromBytes(value)
    if IsErr(vRes):
        return Err[CoinJoinBlind](coinJoinErrorText(cjInvalidInput, Error(vRes)))
    let neg: int64 = modn(-Value(vRes))
    return Ok[CoinJoinBlind](scalarToBytes(neg))

fn scalarSub(a: CoinJoinBlind, b: CoinJoinBlind): CoinJoinResult[CoinJoinBlind] =
    let negRes: CoinJoinResult[CoinJoinBlind] = scalarNegate(b)
    if IsErr(negRes):
        return Err[CoinJoinBlind](Error(negRes))
    return scalarAdd(a, Value(negRes))

fn hkdfBlind(masterSeed: Bytes, sessionId: int64, nonce: int64): CoinJoinResult[CoinJoinBlind] =
    if BytesLen(masterSeed) <= 0:
        return Err[CoinJoinBlind](coinJoinErrorText(cjInvalidInput, "master seed required"))
    var info: Bytes = BytesFromString(pedersenLabel)
    info = appendVarint(info, sessionId)
    info = appendVarint(info, nonce)
    let outRes: Result[Bytes] = hkdfSha256(masterSeed, EmptyBytes(), info, coinJoinScalarSize)
    if IsErr(outRes):
        return Err[CoinJoinBlind](coinJoinErrorText(cjInternal, Error(outRes)))
    let out: Bytes = Value(outRes)
    var zero: bool = true
    for i in 0..<BytesLen(out):
        if BytesGet(out, i) != 0:
            zero = false
            break
    if zero:
        return Err[CoinJoinBlind](coinJoinErrorText(cjInternal, "hkdf produced zero blind"))
    return Ok[CoinJoinBlind](out)

fn encodeAmount(value: int64): CoinJoinAmount =
    let out: Bytes = BytesAlloc(coinJoinScalarSize)
    var v: int64 = value
    for i in 0..<8:
        BytesSet(out, coinJoinScalarSize - 1 - i, int32(v & 255))
        v = v >> 8
    return out

fn amountScalar(amount: CoinJoinAmount): CoinJoinAmount =
    amount

fn commitmentPoint(pub: SkPublicKey): CoinJoinPoint =
    serializePoint(pub)

fn commitmentPub(commitment: CoinJoinCommitment): CoinJoinResult[SkPublicKey] =
    deserializePoint(commitment.point)

fn pedersenBase(): CoinJoinResult[SkPublicKey] =
    getPedersenBase()

fn pedersenGeneratorMul(blind: CoinJoinBlind): CoinJoinResult[SkPublicKey] =
    let baseRes: CoinJoinResult[SkPublicKey] = getPedersenBase()
    if IsErr(baseRes):
        return Err[SkPublicKey](Error(baseRes))
    publicKeyTweakMul(Value(baseRes), blind)

fn generatorMul(amount: CoinJoinAmount): CoinJoinResult[SkPublicKey] =
    scalarToPub(amount)

fn addBlinds(a: CoinJoinBlind, b: CoinJoinBlind): CoinJoinResult[CoinJoinBlind] =
    scalarAdd(a, b)

fn subBlinds(a: CoinJoinBlind, b: CoinJoinBlind): CoinJoinResult[CoinJoinBlind] =
    scalarSub(a, b)

fn combineKeys(keys: SkPublicKey[maxCoinJoinParticipants], count: int32): CoinJoinResult[SkPublicKey] =
    publicKeyCombineKeys(keys, count)

fn mulScalars(a: CoinJoinBlind, b: CoinJoinBlind): CoinJoinResult[CoinJoinBlind] =
    scalarMul(a, b)

fn negateKey(key: SkPublicKey): CoinJoinResult[SkPublicKey] =
    publicKeyNegate(key)
