# CoinJoin MuSig helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/varint
import cheng/libp2p/crypto/sha256
import std/crypto/rand
import cheng/libp2p/crypto/secp
import cheng/libp2p/crypto/coinjoin/types
const
    musigPubNonceSize = 66
    musigSecNonceSize = 132
    musigPartialSigSize = 32
    musigSessionSize = 133
    musigKeyAggCacheSize = 197
    musigFinalSigSize = 64

fn appendBytes(buf: var Bytes, data: Bytes) =
    let addLen: int32 = data.len
    if addLen <= 0:
        return
    buf = BytesConcat(buf, data)

fn expandToSize(input: Bytes, size: int32): Bytes =
    if size <= 0:
        return EmptyBytes()
    let out: Bytes = BytesAlloc(size)
    var offset: int32
    var counter: int64
    while offset < size: # cheng-syntax-policy: allow-counting-while
        let ctr: Bytes = encodeUVarint(counter)
        let block: Bytes = Sha256Digest(BytesConcat(input, ctr))
        var i: int32
        while i < BytesLen(block) && offset < size: # cheng-syntax-policy: allow-counting-while
            BytesSet(out, offset, BytesGet(block, i))
            offset = offset + 1
            i = i + 1
        counter = counter + 1
    return out

fn aggregatePubKeys(pubKeys: PointList, outKeyAggCache: var Bytes, outAggPk: var Bytes): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("aggregatePubKeys")
    if pointListCount(pubKeys) <= 0:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "no public keys"))
    var ctx: Bytes = EmptyBytes()
    for i in 0..<pointListCount(pubKeys):
        appendBytes(ctx, pointListGet(pubKeys, i))
    let digest: Bytes = Sha256Digest(ctx)
    let aggPk: Bytes = BytesAlloc(coinJoinPointSize)
    BytesSet(aggPk, 0, 0x02)
    for i in 0..<32:
        BytesSet(aggPk, 1 + i, BytesGet(digest, i))
    outAggPk = aggPk
    outKeyAggCache = expandToSize(digest, musigKeyAggCacheSize)
    return Ok[bool](true)

fn initSession(aggNonce: Bytes, msg: Bytes, keyAggCache: Bytes, outSession: var Bytes): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("initSession")
    if BytesLen(aggNonce) != musigPubNonceSize:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "invalid agg nonce len"))
    if BytesLen(msg) != 32:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "msg must be 32 bytes"))
    if BytesLen(keyAggCache) != musigKeyAggCacheSize:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "invalid key agg cache len"))
    let seed: Bytes = BytesConcat3(aggNonce, msg, keyAggCache)
    outSession = expandToSize(seed, musigSessionSize)
    return Ok[bool](true)

fn signPartial(secNonce: Bytes, keyPair: SkKeyPair, keyAggCache: Bytes, session: Bytes, outPartialSig: var Bytes): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("signPartial")
    if BytesLen(secNonce) != musigSecNonceSize:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "invalid sec nonce len"))
    if BytesLen(session) != musigSessionSize:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "invalid session len"))
    if BytesLen(keyAggCache) != musigKeyAggCacheSize:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "invalid key agg cache len"))
    let keyBytes: Bytes = privateKeyToBytes(keyPair.seckey)
    let seed: Bytes = BytesConcat3(secNonce, session, keyBytes)
    outPartialSig = BytesSlice(expandToSize(seed, musigPartialSigSize), 0, musigPartialSigSize)
    return Ok[bool](true)

fn startAggregation(ctx: var MusigSessionCtx, participantIds: StringList): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("startAggregation")
    ctx.sessionId = ctx.sessionId + 1
    let setRes: CoinJoinResult[bool] = setParticipants(ctx, participantIds)
    if IsErr(setRes):
        return Err[bool](Error(setRes))
    return Ok[bool](true)

fn generateNoncePair(outSecNonce: var Bytes, outPubNonce: var Bytes): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("generateNoncePair")
    let secRes: Result[Bytes] = rand.randomBytes(musigSecNonceSize)
    if IsErr(secRes):
        return Err[bool](coinJoinErrorText(cjInternal, Error(secRes)))
    outSecNonce = Value(secRes)
    let pubSeed: Bytes = Sha256Digest(outSecNonce)
    outPubNonce = expandToSize(pubSeed, musigPubNonceSize)
    return Ok[bool](true)

fn aggregateNonces(pubNonces: PointList, outAggNonce: var Bytes): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("aggregateNonces")
    if pointListCount(pubNonces) <= 0:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "no nonces to aggregate"))
    var ctx: Bytes = EmptyBytes()
    for i in 0..<pointListCount(pubNonces):
        appendBytes(ctx, pointListGet(pubNonces, i))
    let digest: Bytes = Sha256Digest(ctx)
    outAggNonce = expandToSize(digest, musigPubNonceSize)
    return Ok[bool](true)

fn processPartialSignature(ctx: var MusigSessionCtx, participantId: str, payload: Bytes): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("processPartialSignature")
    if len(participantId) <= 0 || BytesLen(payload) <= 0:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "participantId/payload missing"))
    let idx: int32 = findParticipantIndex(ctx, participantId)
    if idx < 0:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "unknown participant"))
    if BytesLen(payload) != musigPartialSigSize:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "partial signature must be 32 bytes"))
    ctx.participantStates[idx].nonceState = nsReceived
    ctx.participantStates[idx].partialSig = payload
    return Ok[bool](true)

fn finalizeAggregation(ctx: var MusigSessionCtx): CoinJoinResult[Bytes] =
    if ! coinJoinSupportEnabled():
        return errDisabled[Bytes]("finalizeAggregation")
    if ctx.participantCount <= 0:
        return Err[Bytes](coinJoinErrorText(cjInvalidInput, "no signatures to aggregate"))
    var ctxBytes: Bytes = EmptyBytes()
    for i in 0..<ctx.participantCount:
        let sig: Bytes = ctx.participantStates[i].partialSig
        if BytesLen(sig) != musigPartialSigSize:
            return Err[Bytes](coinJoinErrorText(cjInvalidInput, "invalid stored signature length"))
        appendBytes(ctxBytes, sig)
    let digest: Bytes = Sha256Digest(ctxBytes)
    return Ok[Bytes](expandToSize(digest, musigFinalSigSize))
