# CoinJoin commitments(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/crypto/coinjoin/types
import cheng/libp2p/crypto/coinjoin/secp_utils
fn combineAmountAndBlind(amount: CoinJoinAmount, blind: CoinJoinBlind): CoinJoinResult[SkPublicKey] =
    let amountPubRes: CoinJoinResult[SkPublicKey] = generatorMul(amount)
    if IsErr(amountPubRes):
        return Err[SkPublicKey](Error(amountPubRes))
    let blindPubRes: CoinJoinResult[SkPublicKey] = pedersenGeneratorMul(blind)
    if IsErr(blindPubRes):
        return Err[SkPublicKey](Error(blindPubRes))
    var keys: SkPublicKey[maxCoinJoinParticipants]
    keys[0] = Value(amountPubRes)
    keys[1] = Value(blindPubRes)
    return combineKeys(keys, 2)

fn makeCommitment(pub: SkPublicKey, blind: CoinJoinBlind): CoinJoinCommitment =
    CoinJoinCommitment(point: serializePoint(pub), blind: blind)

fn pedersenCommit(amount: CoinJoinAmount, blind: CoinJoinBlind): CoinJoinResult[CoinJoinCommitment] =
    if ! coinJoinSupportEnabled():
        return errDisabled[CoinJoinCommitment]("pedersenCommit")
    let combined: CoinJoinResult[SkPublicKey] = combineAmountAndBlind(amount, blind)
    if IsErr(combined):
        return Err[CoinJoinCommitment](Error(combined))
    return Ok[CoinJoinCommitment](makeCommitment(Value(combined), blind))

fn verifyCommitment(commitment: CoinJoinCommitment, amount: CoinJoinAmount, blind: CoinJoinBlind): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("verifyCommitment")
    let expectedRes: CoinJoinResult[SkPublicKey] = combineAmountAndBlind(amount, blind)
    if IsErr(expectedRes):
        return Err[bool](Error(expectedRes))
    let storedRes: CoinJoinResult[SkPublicKey] = commitmentPub(commitment)
    if IsErr(storedRes):
        return Err[bool](Error(storedRes))
    let expected: CoinJoinPoint = serializePoint(Value(expectedRes))
    let stored: CoinJoinPoint = serializePoint(Value(storedRes))
    return Ok[bool](BytesEqual(expected, stored))

fn addCommitments(left: CoinJoinCommitment, right: CoinJoinCommitment): CoinJoinResult[CoinJoinCommitment] =
    if ! coinJoinSupportEnabled():
        return errDisabled[CoinJoinCommitment]("addCommitments")
    let leftRes: CoinJoinResult[SkPublicKey] = commitmentPub(left)
    if IsErr(leftRes):
        return Err[CoinJoinCommitment](Error(leftRes))
    let rightRes: CoinJoinResult[SkPublicKey] = commitmentPub(right)
    if IsErr(rightRes):
        return Err[CoinJoinCommitment](Error(rightRes))
    var keys: SkPublicKey[maxCoinJoinParticipants]
    keys[0] = Value(leftRes)
    keys[1] = Value(rightRes)
    let sumRes: CoinJoinResult[SkPublicKey] = combineKeys(keys, 2)
    if IsErr(sumRes):
        return Err[CoinJoinCommitment](Error(sumRes))
    let blindRes: CoinJoinResult[CoinJoinBlind] = addBlinds(left.blind, right.blind)
    if IsErr(blindRes):
        return Err[CoinJoinCommitment](Error(blindRes))
    return Ok[CoinJoinCommitment](makeCommitment(Value(sumRes), Value(blindRes)))

fn subtractCommitments(left: CoinJoinCommitment, right: CoinJoinCommitment): CoinJoinResult[CoinJoinCommitment] =
    if ! coinJoinSupportEnabled():
        return errDisabled[CoinJoinCommitment]("subtractCommitments")
    let leftRes: CoinJoinResult[SkPublicKey] = commitmentPub(left)
    if IsErr(leftRes):
        return Err[CoinJoinCommitment](Error(leftRes))
    let rightRes: CoinJoinResult[SkPublicKey] = commitmentPub(right)
    if IsErr(rightRes):
        return Err[CoinJoinCommitment](Error(rightRes))
    let negRes: CoinJoinResult[SkPublicKey] = negateKey(Value(rightRes))
    if IsErr(negRes):
        return Err[CoinJoinCommitment](Error(negRes))
    var keys: SkPublicKey[maxCoinJoinParticipants]
    keys[0] = Value(leftRes)
    keys[1] = Value(negRes)
    let sumRes: CoinJoinResult[SkPublicKey] = combineKeys(keys, 2)
    if IsErr(sumRes):
        return Err[CoinJoinCommitment](Error(sumRes))
    let blindRes: CoinJoinResult[CoinJoinBlind] = subBlinds(left.blind, right.blind)
    if IsErr(blindRes):
        return Err[CoinJoinCommitment](Error(blindRes))
    return Ok[CoinJoinCommitment](makeCommitment(Value(sumRes), Value(blindRes)))
