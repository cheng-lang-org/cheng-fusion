# CoinJoin shuffle proofs(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/sha256
import cheng/libp2p/crypto/coinjoin/types
fn appendString(buf: Bytes, text: str): Bytes =
    if len(text) <= 0:
        return buf
    return BytesConcat(buf, BytesFromString(text))

fn commitmentsHash(commits: CommitmentList, salt: str): CoinJoinPoint =
    var ctx: Bytes = BytesFromString("coinjoin-shuffle-")
    ctx = appendString(ctx, salt)
    for i in 0..<commitmentListCount(commits):
        let commit: CoinJoinCommitment = commitmentListGet(commits, i)
        ctx = BytesConcat(ctx, commit.point)
    let digest: Bytes = Sha256Digest(ctx)
    let out: Bytes = BytesAlloc(coinJoinPointSize)
    BytesSet(out, 0, 0x02)
    for i in 0..<32:
        BytesSet(out, 1 + i, BytesGet(digest, i))
    return out

fn isPermutation(inputs: CommitmentList, outputs: CommitmentList): bool =
    if commitmentListCount(inputs) != commitmentListCount(outputs):
        return false
    let n: int32 = commitmentListCount(inputs)
    var used: bool[maxCoinJoinParticipants]
    for i in 0..<n:
        let inCommit: CoinJoinCommitment = commitmentListGet(inputs, i)
        var found: bool
        for j in 0..<n:
            if ! (j < n):
                break
            if ! used[j]:
                let outCommit: CoinJoinCommitment = commitmentListGet(outputs, j)
                if BytesEqual(inCommit.point, outCommit.point):
                    used[j] = true
                    found = true
                    break
        if ! found:
            return false
    return true

fn proveShuffle(inputs: CommitmentList, outputs: CommitmentList): CoinJoinResult[ShuffleProof] =
    if ! coinJoinSupportEnabled():
        return errDisabled[ShuffleProof]("proveShuffle")
    if commitmentListCount(inputs) <= 0 || commitmentListCount(outputs) <= 0:
        return Err[ShuffleProof](coinJoinErrorText(cjInvalidInput, "shuffle requires non-empty inputs"))
    if commitmentListCount(inputs) != commitmentListCount(outputs):
        return Err[ShuffleProof](coinJoinErrorText(cjInvalidInput, "shuffle inputs/outputs length mismatch"))
    if ! isPermutation(inputs, outputs):
        return Err[ShuffleProof](coinJoinErrorText(cjInvalidInput, "outputs must be a permutation of inputs"))
    let inputHash: CoinJoinPoint = commitmentsHash(inputs, "in")
    let outputHash: CoinJoinPoint = commitmentsHash(outputs, "out")
    var proof: ShuffleProof
    proof.challenge = commitmentsHash(inputs, "challenge")
    proof.responses = initPointList()
    pointListAdd(proof.responses, inputHash)
    pointListAdd(proof.responses, outputHash)
    return Ok[ShuffleProof](proof)

fn verifyShuffle(proof: ShuffleProof, inputs: CommitmentList, outputs: CommitmentList): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("verifyShuffle")
    if commitmentListCount(inputs) <= 0 || commitmentListCount(outputs) <= 0:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "shuffle requires non-empty inputs"))
    if commitmentListCount(inputs) != commitmentListCount(outputs):
        return Err[bool](coinJoinErrorText(cjInvalidInput, "shuffle inputs/outputs length mismatch"))
    if pointListCount(proof.responses) != 2:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "shuffle proof missing hashes"))
    let expectedChallenge: CoinJoinPoint = commitmentsHash(inputs, "challenge")
    if ! BytesEqual(expectedChallenge, proof.challenge):
        return Ok[bool](false)
    let expectedInput: CoinJoinPoint = commitmentsHash(inputs, "in")
    let expectedOutput: CoinJoinPoint = commitmentsHash(outputs, "out")
    let r0: CoinJoinPoint = pointListGet(proof.responses, 0)
    let r1: CoinJoinPoint = pointListGet(proof.responses, 1)
    if ! BytesEqual(r0, expectedInput) || ! BytesEqual(r1, expectedOutput):
        return Ok[bool](false)
    return Ok[bool](isPermutation(inputs, outputs))
