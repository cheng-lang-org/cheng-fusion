# CoinJoin onion routing helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/protocols/onionpay
import cheng/libp2p/crypto/sha256
import cheng/libp2p/crypto/hkdf
import cheng/libp2p/crypto/coinjoin/types
import cheng/libp2p/utils/system
const
    onionHopLabel = "coinjoin-onion-hop"
    onionLayerLabel = "coinjoin-onion-layer"
    onionProofLabel = "coinjoin-onion-proof"

fn appendOwnedBytes(buf: var Bytes, data: Bytes) =
    let addLen: int32 = data.len
    if addLen <= 0:
        return
    buf = BytesConcat(buf, data)

fn appendOwnedString(buf: var Bytes, text: str) =
    if len(text) <= 0:
        return
    appendOwnedBytes(buf, BytesFromString(text))

fn encodeU64BE(value: int64): Bytes =
    let out: Bytes = BytesAlloc(8)
    var v: int64 = value
    var i: int32 = 7
    let loop_start_i_1 = i
    for loop_rev_i_1 in 0..(loop_start_i_1 - (0)):
        i = loop_start_i_1 - loop_rev_i_1
        if ! (i >= 0):
            break
        BytesSet(out, i, int32(v & 255))
        v = v >> 8
    return out

fn encodeU32BE(value: int32): Bytes =
    let out: Bytes = BytesAlloc(4)
    var v: int32 = value
    var i: int32 = 3
    let loop_start_i_2 = i
    for loop_rev_i_2 in 0..(loop_start_i_2 - (0)):
        i = loop_start_i_2 - loop_rev_i_2
        if ! (i >= 0):
            break
        BytesSet(out, i, v & 255)
        v = v >> 8
    return out

fn readByte(data: Bytes, idx: int32): int32 =
    if idx < 0 || idx >= data.len:
        return 0
    return BytesGet(data, idx)

fn hmacSha256(key: Bytes, data: Bytes): Bytes =
    return hmacDigest(key, data, sha256BlockSize, sha256Size, Sha256Digest)

fn toProtocolRouteId(routeId: int64): CoinJoinResult[OnionRouteId] =
    if routeId < 0:
        return Err[OnionRouteId](coinJoinErrorText(cjInvalidInput, "routeId must be >= 0"))
    let data: Bytes = encodeU64BE(routeId)
    if BytesLen(data) != onionRouteIdSize:
        return Err[OnionRouteId](coinJoinErrorText(cjInternal, "routeId size mismatch"))
    return Ok[OnionRouteId](data)

fn fromProtocolRouteId(routeId: OnionRouteId): CoinJoinResult[int64] =
    if BytesLen(routeId) != onionRouteIdSize:
        return Err[int64](coinJoinErrorText(cjInvalidInput, "routeId size mismatch"))
    var value: int64
    for i in 0..<onionRouteIdSize:
        let idx: int32 = i
        value = (value << 8) | int64(readByte(routeId, idx))
    return Ok[int64](value)

fn encodeLen32(length: int32): CoinJoinResult[Bytes] =
    if length < 0:
        return Err[Bytes](coinJoinErrorText(cjInvalidInput, "payload length"))
    let out: Bytes = BytesAlloc(4)
    var v: int32 = length
    var i: int32 = 3
    let loop_start_i_4 = i
    for loop_rev_i_4 in 0..(loop_start_i_4 - (0)):
        i = loop_start_i_4 - loop_rev_i_4
        if ! (i >= 0):
            break
        BytesSet(out, i, v & 255)
        v = v >> 8
    return Ok[Bytes](out)

fn decodeLen32(data: Bytes): CoinJoinResult[int32] =
    if BytesLen(data) < 4:
        return Err[int32](coinJoinErrorText(cjInvalidInput, "payload length truncated"))
    var v: int32
    for i in 0..<4:
        let idx: int32 = i
        v = (v << 8) | readByte(data, idx)
    return Ok[int32](v)

fn isZeroSecret(secret: OnionSecret): bool =
    for i in 0..<BytesLen(secret):
        let idx: int32 = i
        if readByte(secret, idx) != 0:
            return false
    return true

fn wrapEnvelope(envelope: Bytes): CoinJoinResult[Bytes] =
    let lenRes: CoinJoinResult[Bytes] = encodeLen32(BytesLen(envelope))
    if ! lenRes.ok:
        return ErrInfo[Bytes](lenRes.err)
    let prefix: Bytes = lenRes.value
    return Ok[Bytes](BytesConcat(prefix, envelope))

fn unwrapEnvelope(body: Bytes): CoinJoinResult[Bytes] =
    if BytesLen(body) < 4:
        return Err[Bytes](coinJoinErrorText(cjInvalidInput, "payload truncated"))
    let lenRes: CoinJoinResult[int32] = decodeLen32(body)
    if ! lenRes.ok:
        return ErrInfo[Bytes](lenRes.err)
    let declared: int32 = lenRes.value
    let remaining: int32 = BytesLen(body) - 4
    if declared != remaining:
        return Err[Bytes](coinJoinErrorText(cjInvalidInput, "payload length mismatch"))
    if remaining <= 0:
        return Ok[Bytes](EmptyBytes())
    return Ok[Bytes](BytesSlice(body, 4, remaining))

fn computeLayerMac(secret: OnionSecret, routeId: int64, downstream: Bytes): OnionMac =
    var ctx: Bytes = BytesFromString(onionLayerLabel)
    appendOwnedBytes(ctx, encodeU64BE(routeId))
    appendOwnedBytes(ctx, downstream)
    return hmacSha256(secret, ctx)

fn deriveHopSecrets(seed: OnionSeed, sessionId: int64, participantId: str, hopCount: int32): CoinJoinResult[HopSecretList] =
    if ! coinJoinSupportEnabled():
        return errDisabled[HopSecretList]("deriveHopSecrets")
    if hopCount <= 0:
        return Err[HopSecretList](coinJoinErrorText(cjInvalidInput, "hopCount must be > 0"))
    if len(participantId) <= 0:
        return Err[HopSecretList](coinJoinErrorText(cjInvalidInput, "participantId required"))
    if sessionId < 0:
        return Err[HopSecretList](coinJoinErrorText(cjInvalidInput, "sessionId must be >= 0"))
    if hopCount > 255:
        return Err[HopSecretList](coinJoinErrorText(cjInvalidInput, "hopCount too large"))
    var list: HopSecretList = initHopSecretList()
    for idx in 0..<hopCount:
        var info: Bytes = BytesFromString(onionHopLabel)
        appendOwnedBytes(info, encodeU64BE(sessionId))
        let lenRes: CoinJoinResult[Bytes] = encodeLen32(len(participantId))
        if ! lenRes.ok:
            return ErrInfo[HopSecretList](lenRes.err)
        appendOwnedBytes(info, lenRes.value)
        appendOwnedString(info, participantId)
        if idx > 255:
            return Err[HopSecretList](coinJoinErrorText(cjInvalidInput, "hop index too large"))
        let idxByte: Bytes = encodeU32BE(idx)
        appendOwnedBytes(info, BytesSlice(idxByte, 3, 1))
        let secretRes: Result[Bytes] = hkdfSha256(seed, EmptyBytes(), info, coinJoinScalarSize)
        if ! secretRes.ok:
            return Err[HopSecretList](coinJoinErrorText(cjInternal, Lp2pErrorMessage(secretRes.err)))
        var secret: Bytes = secretRes.value
        if isZeroSecret(secret):
            return Err[HopSecretList](coinJoinErrorText(cjInternal, "hkdf produced zero hop secret"))
        let addRes: CoinJoinResult[bool] = hopSecretListAdd(list, secret)
        if ! addRes.ok:
            return ErrInfo[HopSecretList](addRes.err)
    return Ok[HopSecretList](cloneHopSecretList(list))

fn initRouteCtx(seed: OnionSeed, sessionId: int64, participantId: str, hopCount: int32, payload: Bytes): CoinJoinResult[OnionRouteCtx] =
    if ! coinJoinSupportEnabled():
        return errDisabled[OnionRouteCtx]("initRouteCtx")
    let secretsRes: CoinJoinResult[HopSecretList] = deriveHopSecrets(seed, sessionId, participantId, hopCount)
    if ! secretsRes.ok:
        return ErrInfo[OnionRouteCtx](secretsRes.err)
    return Ok[OnionRouteCtx](
        OnionRouteCtx(
            seed: cloneBytes(seed),
            hopSecrets: cloneHopSecretList(secretsRes.value),
            payload: cloneBytes(payload),
            mac: EmptyBytes()
        )
    )

fn onionProof(hopSecrets: HopSecretList, transcript: Bytes): CoinJoinResult[OnionProof] =
    if ! coinJoinSupportEnabled():
        return errDisabled[OnionProof]("onionProof")
    if hopSecretListCount(hopSecrets) <= 0:
        return Err[OnionProof](coinJoinErrorText(cjInvalidInput, "hop secrets required"))
    var keyCtx: Bytes = BytesFromString(onionProofLabel)
    for i in 0..<hopSecretListCount(hopSecrets):
        appendOwnedBytes(keyCtx, hopSecretListGet(hopSecrets, i))
    let key: Bytes = Sha256Digest(keyCtx)
    return Ok[OnionProof](hmacSha256(key, transcript))

fn verifyOnionProof(hopSecrets: HopSecretList, transcript: Bytes, proof: OnionProof): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("verifyOnionProof")
    let proofRes: CoinJoinResult[OnionProof] = onionProof(hopSecrets, transcript)
    if ! proofRes.ok:
        return ErrInfo[bool](proofRes.err)
    var out: CoinJoinResult[bool]
    out.ok = true
    out.value = BytesEqual(proofRes.value, proof)
    out.err = Lp2pErrorOk()
    return out

fn buildOnionPacket(routeId: int64, payload: Bytes, hopSecrets: HopSecretList): CoinJoinResult[CoinJoinOnionPacket] =
    if ! coinJoinSupportEnabled():
        return errDisabled[CoinJoinOnionPacket]("buildOnionPacket")
    if hopSecretListCount(hopSecrets) <= 0:
        return Err[CoinJoinOnionPacket](coinJoinErrorText(cjInvalidInput, "missing hop secrets"))
    if routeId < 0:
        return Err[CoinJoinOnionPacket](coinJoinErrorText(cjInvalidInput, "routeId must be >= 0"))
    var envelope: Bytes = payload
    var mac: OnionMac = EmptyBytes()
    var idx: int32 = hopSecretListCount(hopSecrets) - 1
    let loop_start_idx_9 = idx
    for loop_rev_idx_9 in 0..(loop_start_idx_9 - (0)):
        idx = loop_start_idx_9 - loop_rev_idx_9
        if ! (idx >= 0):
            break
        let bodyRes: CoinJoinResult[Bytes] = wrapEnvelope(envelope)
        if ! bodyRes.ok:
            return ErrInfo[CoinJoinOnionPacket](bodyRes.err)
        let body: Bytes = bodyRes.value
        let secret: OnionSecret = hopSecretListGet(hopSecrets, idx)
        if BytesLen(secret) != coinJoinScalarSize:
            return Err[CoinJoinOnionPacket](coinJoinErrorText(cjInvalidInput, "hop secret size mismatch"))
        mac = computeLayerMac(secret, routeId, body)
        let layer: Bytes = BytesConcat(mac, body)
        envelope = layer
    return Ok[CoinJoinOnionPacket](CoinJoinOnionPacket(routeId: routeId, payload: envelope, mac: mac))

fn peelOnionLayer(packet: CoinJoinOnionPacket, hopSecret: OnionSecret): CoinJoinResult[CoinJoinOnionPacket] =
    if ! coinJoinSupportEnabled():
        return errDisabled[CoinJoinOnionPacket]("peelOnionLayer")
    if BytesLen(hopSecret) != coinJoinScalarSize:
        return Err[CoinJoinOnionPacket](coinJoinErrorText(cjInvalidInput, "hop secret size mismatch"))
    if BytesLen(packet.payload) < onionMacSize + 4:
        return Err[CoinJoinOnionPacket](coinJoinErrorText(cjInvalidInput, "payload truncated"))
    let mac: OnionMac = BytesSlice(packet.payload, 0, onionMacSize)
    let body: Bytes = BytesSlice(packet.payload, onionMacSize, BytesLen(packet.payload) - onionMacSize)
    let expected: OnionMac = computeLayerMac(hopSecret, packet.routeId, body)
    if ! BytesEqual(mac, expected):
        return Err[CoinJoinOnionPacket](coinJoinErrorText(cjInvalidInput, "layer mac mismatch"))
    let envRes: CoinJoinResult[Bytes] = unwrapEnvelope(body)
    if ! envRes.ok:
        return ErrInfo[CoinJoinOnionPacket](envRes.err)
    return Ok[CoinJoinOnionPacket](CoinJoinOnionPacket(routeId: packet.routeId, payload: envRes.value, mac: EmptyBytes()))

fn prepareRoute(route: OnionRoute, hopSecrets: HopSecretList): CoinJoinResult[OnionRoute] =
    if hopSecretListCount(hopSecrets) <= 0:
        return Err[OnionRoute](coinJoinErrorText(cjInvalidInput, "missing hop secrets"))
    if hopListCount(route.hops) <= 0:
        return Err[OnionRoute](coinJoinErrorText(cjInvalidInput, "missing route hops"))
    if hopSecretListCount(hopSecrets) != hopListCount(route.hops):
        return Err[OnionRoute](coinJoinErrorText(cjInvalidInput, "hop secrets && route hops length mismatch"))
    if BytesLen(route.id) != onionRouteIdSize:
        return Err[OnionRoute](coinJoinErrorText(cjInvalidInput, "routeId size mismatch"))
    var copy: OnionRoute = route
    for i in 0..<hopListCount(copy.hops):
        let secret: OnionSecret = hopSecretListGet(hopSecrets, i)
        if BytesLen(secret) != coinJoinScalarSize:
            return Err[OnionRoute](coinJoinErrorText(cjInvalidInput, "hop secret size mismatch"))
        copy.hops.items[i].secret = secret
    return Ok[OnionRoute](copy)

fn toOnionPacket(routeCtx: OnionRouteCtx, route: OnionRoute): CoinJoinResult[OnionPacket] =
    if ! coinJoinSupportEnabled():
        return errDisabled[OnionPacket]("toOnionPacket")
    let preparedRes: CoinJoinResult[OnionRoute] = prepareRoute(route, routeCtx.hopSecrets)
    if ! preparedRes.ok:
        return ErrInfo[OnionPacket](preparedRes.err)
    let packetRes: Result[OnionPacket] = buildOnionPacket(preparedRes.value, routeCtx.payload)
    if ! packetRes.ok:
        return Err[OnionPacket](coinJoinErrorText(cjInternal, "onionpay.buildOnionPacket: " + Lp2pErrorMessage(packetRes.err)))
    return Ok[OnionPacket](packetRes.value)

fn fromOnionPacket(packet: OnionPacket): CoinJoinResult[CoinJoinOnionPacket] =
    if ! coinJoinSupportEnabled():
        return errDisabled[CoinJoinOnionPacket]("fromOnionPacket")
    if BytesLen(packet.payload) < onionMacSize + 4:
        return Err[CoinJoinOnionPacket](coinJoinErrorText(cjInvalidInput, "onionpay packet truncated"))
    let routeRes: CoinJoinResult[int64] = fromProtocolRouteId(packet.routeId)
    if ! routeRes.ok:
        return ErrInfo[CoinJoinOnionPacket](routeRes.err)
    let mac: OnionMac = BytesSlice(packet.payload, 0, onionMacSize)
    return Ok[CoinJoinOnionPacket](CoinJoinOnionPacket(routeId: routeRes.value, payload: packet.payload, mac: mac))

fn toOnionPacket(routeCtx: OnionRouteCtx, routeId: int64): CoinJoinResult[CoinJoinOnionPacket] =
    if ! coinJoinSupportEnabled():
        return errDisabled[CoinJoinOnionPacket]("toOnionPacket")
    return buildOnionPacket(routeId, routeCtx.payload, routeCtx.hopSecrets)

fn fromOnionPacket(packet: CoinJoinOnionPacket): CoinJoinResult[CoinJoinOnionPacket] =
    if ! coinJoinSupportEnabled():
        return errDisabled[CoinJoinOnionPacket]("fromOnionPacket")
    return Ok[CoinJoinOnionPacket](packet)
