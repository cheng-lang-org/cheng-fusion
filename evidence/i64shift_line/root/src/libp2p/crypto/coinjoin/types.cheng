# CoinJoin types && helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/stringlist
const
    coinJoinScalarSize = 32
    coinJoinPointSize = 33
    onionMacSize = 32
    maxCoinJoinHops = 16
    maxCoinJoinParticipants = 16
    maxSessionEffects = 16
    maxShuffleResponses = 4

type
    CoinJoinErrorKind = enum
        cjDisabled
        cjNotImplemented
        cjInvalidInput
        cjInternal

    CoinJoinError =
        kind: CoinJoinErrorKind
        msg: str

    CoinJoinResult[T] = Result[T]

    CoinJoinAmount = Bytes
    CoinJoinBlind = Bytes
    CoinJoinPoint = Bytes
    OnionSeed = Bytes
    OnionSecret = Bytes
    OnionMac = Bytes
    OnionProof = Bytes

    CoinJoinCommitment =
        point: CoinJoinPoint
        blind: CoinJoinBlind

    HopSecretList =
        count: int32
        items: OnionSecret[maxCoinJoinHops]

    OnionRouteCtx =
        seed: OnionSeed
        hopSecrets: HopSecretList
        payload: Bytes
        mac: OnionMac

    PointList =
        count: int32
        items: CoinJoinPoint[maxCoinJoinParticipants]

    CommitmentList =
        count: int32
        items: CoinJoinCommitment[maxCoinJoinParticipants]

    NonceState = enum
        nsNone
        nsReceived
        nsUsed

    ParticipantState =
        id: str
        nonceState: NonceState
        partialSig: Bytes

    MusigSessionCtx =
        sessionId: int64
        participantIds: StringList
        participantStates: ParticipantState[maxCoinJoinParticipants]
        participantCount: int32
        aggregatedNonce: CoinJoinPoint
        sessionCache: Bytes
        keyAggCache: Bytes
        aggNonceBytes: Bytes

    CoinJoinOnionPacket =
        routeId: int64
        payload: Bytes
        mac: OnionMac

    CoinJoinPhase = enum
        cjpDiscovery
        cjpCommit
        cjpShuffle
        cjpSignature
        cjpFinalize

    SessionEffectKind = enum
        sekNone
        sekBroadcastMessage
        sekBlameReport
        sekFinalizeTx

    SessionEffect =
        kind: SessionEffectKind
        data: Bytes

    SessionEffectList =
        count: int32
        items: SessionEffect[maxSessionEffects]

    CoinJoinSessionState =
        id: int64
        phase: CoinJoinPhase
        participants: StringList
        pendingEffects: SessionEffectList

type
    ShuffleProof =
        challenge: CoinJoinPoint
        responses: PointList

fn coinJoinSupportEnabled(): bool =
    return true

fn coinJoinErrorText(kind: CoinJoinErrorKind, msg: str): str =
    let prefix: str =
        case kind:
        of cjDisabled: "coinjoin: disabled"
        of cjNotImplemented: "coinjoin: ! implemented"
        of cjInvalidInput: "coinjoin: invalid input"
        of cjInternal: "coinjoin: internal"
    if len(msg) == 0:
        return prefix
    return prefix + ": " + msg

fn newCoinJoinError(kind: CoinJoinErrorKind, msg: str): CoinJoinError =
    CoinJoinError(kind: kind, msg: msg)

fn errDisabled[T](feature: str): CoinJoinResult[T] =
    Err[T](coinJoinErrorText(cjDisabled, feature + " disabled"))

fn errNotImplemented[T](feature: str): CoinJoinResult[T] =
    Err[T](coinJoinErrorText(cjNotImplemented, feature + " ! implemented"))

fn ensureSize(data: Bytes, size: int32, label: str): CoinJoinResult[Bytes] =
    if BytesLen(data) != size:
        return Err[Bytes](coinJoinErrorText(cjInvalidInput, label + " size mismatch"))
    return Ok[Bytes](data)

fn cloneBytes(data: Bytes): Bytes =
    if BytesLen(data) <= 0:
        return EmptyBytes()
    return BytesSlice(data, 0, BytesLen(data))

fn cloneBytes(data: var Bytes): Bytes =
    var view: Bytes
    view.data = data.data
    view.len = data.len
    if view.len <= 0:
        return EmptyBytes()
    return BytesSlice(view, 0, view.len)

fn makeCoinJoinAmount(data: Bytes): CoinJoinResult[CoinJoinAmount] =
    let res: CoinJoinResult[Bytes] = ensureSize(data, coinJoinScalarSize, "amount")
    if ! res.ok:
        return ErrInfo[CoinJoinAmount](res.err)
    return Ok[CoinJoinAmount](res.value)

fn makeCoinJoinBlind(data: Bytes): CoinJoinResult[CoinJoinBlind] =
    let res: CoinJoinResult[Bytes] = ensureSize(data, coinJoinScalarSize, "blind")
    if ! res.ok:
        return ErrInfo[CoinJoinBlind](res.err)
    return Ok[CoinJoinBlind](res.value)

fn makeCoinJoinPoint(data: Bytes): CoinJoinResult[CoinJoinPoint] =
    let res: CoinJoinResult[Bytes] = ensureSize(data, coinJoinPointSize, "point")
    if ! res.ok:
        return ErrInfo[CoinJoinPoint](res.err)
    return Ok[CoinJoinPoint](res.value)

fn makeOnionSeed(data: Bytes): CoinJoinResult[OnionSeed] =
    let res: CoinJoinResult[Bytes] = ensureSize(data, coinJoinScalarSize, "seed")
    if ! res.ok:
        return ErrInfo[OnionSeed](res.err)
    return Ok[OnionSeed](res.value)

fn makeOnionSecret(data: Bytes): CoinJoinResult[OnionSecret] =
    let res: CoinJoinResult[Bytes] = ensureSize(data, coinJoinScalarSize, "secret")
    if ! res.ok:
        return ErrInfo[OnionSecret](res.err)
    return Ok[OnionSecret](res.value)

fn makeOnionMac(data: Bytes): CoinJoinResult[OnionMac] =
    let res: CoinJoinResult[Bytes] = ensureSize(data, onionMacSize, "mac")
    if ! res.ok:
        return ErrInfo[OnionMac](res.err)
    return Ok[OnionMac](res.value)

fn initHopSecretList(): HopSecretList =
    HopSecretList(count: 0)

fn hopSecretListAdd(list: var HopSecretList, secret: OnionSecret): CoinJoinResult[bool] =
    if list.count >= maxCoinJoinHops:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "hop secret list full"))
    list.items[list.count].data = secret.data
    list.items[list.count].len = secret.len
    list.count = list.count + 1
    return Ok[bool](true)

fn hopSecretListCount(list: HopSecretList): int32 =
    list.count

fn cloneHopSecretList(list: HopSecretList): HopSecretList =
    var out: HopSecretList = initHopSecretList()
    out.count = list.count
    for i in 0..<list.count:
        out.items[i] = cloneBytes(list.items[i])
    return out

fn hopSecretListGet(list: HopSecretList, index: int32): OnionSecret =
    if index < 0 || index >= list.count:
        return EmptyBytes()
    return cloneBytes(list.items[index])

fn initPointList(): PointList =
    PointList(count: 0)

fn pointListAdd(list: var PointList, point: CoinJoinPoint): CoinJoinResult[bool] =
    if list.count >= maxCoinJoinParticipants:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "point list full"))
    list.items[list.count] = cloneBytes(point)
    list.count = list.count + 1
    return Ok[bool](true)

fn pointListCount(list: PointList): int32 =
    list.count

fn pointListGet(list: PointList, index: int32): CoinJoinPoint =
    if index < 0 || index >= list.count:
        return EmptyBytes()
    return cloneBytes(list.items[index])

fn initCommitmentList(): CommitmentList =
    CommitmentList(count: 0)

fn commitmentListAdd(list: var CommitmentList, commit: CoinJoinCommitment): CoinJoinResult[bool] =
    if list.count >= maxCoinJoinParticipants:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "commitment list full"))
    list.items[list.count] = CoinJoinCommitment(
        point: cloneBytes(commit.point),
        blind: cloneBytes(commit.blind)
    )
    list.count = list.count + 1
    return Ok[bool](true)

fn commitmentListCount(list: CommitmentList): int32 =
    list.count

fn commitmentListGet(list: CommitmentList, index: int32): CoinJoinCommitment =
    if index < 0 || index >= list.count:
        return CoinJoinCommitment(point: EmptyBytes(), blind: EmptyBytes())
    let item: CoinJoinCommitment = list.items[index]
    return CoinJoinCommitment(point: cloneBytes(item.point), blind: cloneBytes(item.blind))

fn initSessionEffectList(): SessionEffectList =
    SessionEffectList(count: 0)

fn sessionEffectListAdd(list: var SessionEffectList, effect: SessionEffect): CoinJoinResult[bool] =
    if list.count >= maxSessionEffects:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "effect list full"))
    list.items[list.count] = SessionEffect(kind: effect.kind, data: cloneBytes(effect.data))
    list.count = list.count + 1
    return Ok[bool](true)

fn sessionEffectListCount(list: SessionEffectList): int32 =
    list.count

fn sessionEffectListGet(list: SessionEffectList, index: int32): SessionEffect =
    if index < 0 || index >= list.count:
        return SessionEffect(kind: sekNone, data: EmptyBytes())
    let item: SessionEffect = list.items[index]
    return SessionEffect(kind: item.kind, data: cloneBytes(item.data))

fn initMusigSessionCtx(): MusigSessionCtx =
    MusigSessionCtx(
        sessionId: 0,
        participantIds: InitStringList(),
        participantCount: 0,
        aggregatedNonce: EmptyBytes(),
        sessionCache: EmptyBytes(),
        keyAggCache: EmptyBytes(),
        aggNonceBytes: EmptyBytes()
    )

fn setParticipants(ctx: var MusigSessionCtx, participants: StringList): CoinJoinResult[bool] =
    ctx.participantIds = participants
    ctx.participantCount = StringListCount(participants)
    if ctx.participantCount > maxCoinJoinParticipants:
        return Err[bool](coinJoinErrorText(cjInvalidInput, "too many participants"))
    for i in 0..<ctx.participantCount:
        let id: str = participants.items[i]
        ctx.participantStates[i] = ParticipantState(
            id: id,
            nonceState: nsNone,
            partialSig: EmptyBytes()
        )
    return Ok[bool](true)

fn findParticipantIndex(ctx: var MusigSessionCtx, id: str): int32 =
    for i in 0..<ctx.participantCount:
        if ctx.participantStates[i].id == id:
            return i
    return -1
