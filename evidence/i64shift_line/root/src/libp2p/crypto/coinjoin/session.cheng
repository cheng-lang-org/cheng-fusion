# CoinJoin session state machine(minimal).

import cheng/libp2p/crypto/coinjoin/types
fn initSessionState(sessionId: int64, participants: StringList): CoinJoinSessionState =
    CoinJoinSessionState(
        id: sessionId,
        phase: cjpDiscovery,
        participants: participants,
        pendingEffects: initSessionEffectList()
    )

fn resetSession(state: var CoinJoinSessionState): CoinJoinResult[bool] =
    if ! coinJoinSupportEnabled():
        return errDisabled[bool]("resetSession")
    state.phase = cjpDiscovery
    state.pendingEffects = initSessionEffectList()
    return Ok[bool](true)

fn stepSession(state: var CoinJoinSessionState, effect: SessionEffect): CoinJoinResult[SessionEffect] =
    if ! coinJoinSupportEnabled():
        return errDisabled[SessionEffect]("stepSession")
    sessionEffectListAdd(state.pendingEffects, effect)
    case state.phase
    of cjpDiscovery:
        state.phase = cjpCommit
    of cjpCommit:
        state.phase = cjpShuffle
    of cjpShuffle:
        state.phase = cjpSignature
    of cjpSignature:
        if effect.kind == sekFinalizeTx:
            state.phase = cjpFinalize
    of cjpFinalize:
        0
    return Ok[SessionEffect](effect)
