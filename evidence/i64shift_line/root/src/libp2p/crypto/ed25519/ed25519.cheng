# Ed25519 crypto(partial: sizes + validation).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/types
import std/crypto/rand
import cheng/libp2p/crypto/ed25519/constants
import std/crypto/ed25519/ref10
import std/crypto/sha512
fn validatePublicKeyBytes(data: Bytes): bool =
    BytesLen(data) == ed25519PublicKeySize

fn validatePrivateKeyBytes(data: Bytes): bool =
    BytesLen(data) == ed25519PrivateKeySize

fn validateSignatureBytes(data: Bytes): bool =
    BytesLen(data) == ed25519SignatureSize

fn makePublicKey(data: Bytes): Result[PublicKey] =
    if ! validatePublicKeyBytes(data):
        return Err[PublicKey]("ed25519: invalid public key length")
    var key: PublicKey
    key.keyType = ktEd25519
    key.data = data
    return Ok[PublicKey](key)

fn makePrivateKey(data: Bytes): Result[PrivateKey] =
    if ! validatePrivateKeyBytes(data):
        return Err[PrivateKey]("ed25519: invalid private key length")
    var key: PrivateKey
    key.keyType = ktEd25519
    key.data = data
    return Ok[PrivateKey](key)

fn makeSignature(data: Bytes): Result[Signature] =
    if ! validateSignatureBytes(data):
        return Err[Signature]("ed25519: invalid signature length")
    var sig: Signature
    sig.keyType = ktEd25519
    sig.data = data
    return Ok[Signature](sig)

fn publicKeyFromPrivateKey(data: Bytes): Result[PublicKey] =
    if ! validatePrivateKeyBytes(data):
        return Err[PublicKey]("ed25519: invalid private key length")
    let pub: Bytes = BytesSlice(data, 32, 32)
    var key: PublicKey
    key.keyType = ktEd25519
    key.data = pub
    return Ok[PublicKey](key)

fn keyPairFromSeed(seedInput: Bytes): Result[KeyPair] =
    let seedLen: int32 = BytesLen(seedInput)
    if seedLen <= 0:
        return Err[KeyPair]("ed25519: seed empty")
    let seed: Bytes =
        if seedLen == 32:
            BytesSlice(seedInput, 0, 32)
        else:
            BytesSlice(sha512.Sha512Digest(seedInput), 0, 32)
    var digest: Bytes = sha512.Sha512Digest(seed)
    var h0: int32 = BytesGet(digest, 0)
    BytesSet(digest, 0, h0 & 248)
    var h31: int32 = BytesGet(digest, 31)
    BytesSet(digest, 31, (h31 & 63) | 64)
    let scalar: Bytes = BytesSlice(digest, 0, 32)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, scalar)
    let pub: Bytes = ref10.geP3ToBytes(r)
    let priv: Bytes = BytesConcat(seed, pub)
    var pubKey: PublicKey
    pubKey.keyType = ktEd25519
    pubKey.data = pub
    var privKey: PrivateKey
    privKey.keyType = ktEd25519
    privKey.data = priv
    var kp: KeyPair
    kp.publicKey = pubKey
    kp.privateKey = privKey
    return Ok[KeyPair](kp)

fn generateKeyPair(): Result[KeyPair] =
    let seedRes: Result[Bytes] = rand.randomBytes(32)
    if IsErr(seedRes):
        return Err[KeyPair](Error(seedRes))
    return keyPairFromSeed(Value(seedRes))

@borrows
fn signEd25519Raw(priv: Bytes, msg: Bytes): Result[Bytes] =
    if ! validatePrivateKeyBytes(priv):
        return Err[Bytes]("ed25519: invalid private key length")
    let seed: Bytes = BytesSlice(priv, 0, 32)
    let pub: Bytes = BytesSlice(priv, 32, 32)
    var digest: Bytes = sha512.Sha512Digest(seed)
    var h0: int32 = BytesGet(digest, 0)
    BytesSet(digest, 0, h0 & 248)
    var h31: int32 = BytesGet(digest, 31)
    BytesSet(digest, 31, (h31 & 63) | 64)
    let scalar: Bytes = BytesSlice(digest, 0, 32)
    let prefix: Bytes = BytesSlice(digest, 32, 32)
    let nonceDigest: Bytes = sha512.Sha512Digest2(prefix, msg)
    let nonce: Bytes = ref10.scReduce(nonceDigest)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, nonce)
    let rBytes: Bytes = ref10.geP3ToBytes(r)
    let hramDigest: Bytes = sha512.Sha512Digest3(rBytes, pub, msg)
    let hram: Bytes = ref10.scReduce(hramDigest)
    let s: Bytes = ref10.scMulAdd(hram, scalar, nonce)
    let sig: Bytes = BytesConcat(rBytes, s)
    return Ok[Bytes](sig)

# ---- key-epoch aware entries (ref10 migration step 1) ----------------
# epoch 0: legacy -B world (all existing identities); epoch 1: RFC 8032.
# Verify's negA decode is convention-independent and stays shared.

fn keyPairFromSeedEpoch(seedInput: Bytes, epoch: int32): Result[KeyPair] =
    let seedLen: int32 = BytesLen(seedInput)
    if seedLen <= 0:
        return Err[KeyPair]("ed25519: seed empty")
    let seed: Bytes =
        if seedLen == 32:
            BytesSlice(seedInput, 0, 32)
        else:
            BytesSlice(sha512.Sha512Digest(seedInput), 0, 32)
    var digest: Bytes = sha512.Sha512Digest(seed)
    var h0: int32 = BytesGet(digest, 0)
    BytesSet(digest, 0, h0 & 248)
    var h31: int32 = BytesGet(digest, 31)
    BytesSet(digest, 31, (h31 & 63) | 64)
    let scalar: Bytes = BytesSlice(digest, 0, 32)
    var r: ref10.GeP3
    if epoch == 1:
        ref10.geScalarMultBasePos(r, scalar)
    else:
        ref10.geScalarMultBase(r, scalar)
    let pub: Bytes = ref10.geP3ToBytes(r)
    let priv: Bytes = BytesConcat(seed, pub)
    var pubKey: PublicKey
    pubKey.keyType = ktEd25519
    pubKey.data = pub
    var privKey: PrivateKey
    privKey.keyType = ktEd25519
    privKey.data = priv
    var kp: KeyPair
    kp.publicKey = pubKey
    kp.privateKey = privKey
    return Ok[KeyPair](kp)

@borrows
fn signEd25519RawEpoch(priv: Bytes, msg: Bytes, epoch: int32): Result[Bytes] =
    if ! validatePrivateKeyBytes(priv):
        return Err[Bytes]("ed25519: invalid private key length")
    let seed: Bytes = BytesSlice(priv, 0, 32)
    let pub: Bytes = BytesSlice(priv, 32, 32)
    var digest: Bytes = sha512.Sha512Digest(seed)
    var h0: int32 = BytesGet(digest, 0)
    BytesSet(digest, 0, h0 & 248)
    var h31: int32 = BytesGet(digest, 31)
    BytesSet(digest, 31, (h31 & 63) | 64)
    let scalar: Bytes = BytesSlice(digest, 0, 32)
    let prefix: Bytes = BytesSlice(digest, 32, 32)
    let nonceDigest: Bytes = sha512.Sha512Digest2(prefix, msg)
    let nonce: Bytes = ref10.scReduce(nonceDigest)
    var r: ref10.GeP3
    if epoch == 1:
        ref10.geScalarMultBasePos(r, nonce)
    else:
        ref10.geScalarMultBase(r, nonce)
    let rBytes: Bytes = ref10.geP3ToBytes(r)
    let hramDigest: Bytes = sha512.Sha512Digest3(rBytes, pub, msg)
    let hram: Bytes = ref10.scReduce(hramDigest)
    let s: Bytes = ref10.scMulAdd(hram, scalar, nonce)
    let sig: Bytes = BytesConcat(rBytes, s)
    return Ok[Bytes](sig)

@borrows
fn verifyEd25519Epoch(pub: Bytes, msg: Bytes, sig: Bytes, epoch: int32): bool =
    if ! validatePublicKeyBytes(pub):
        return false
    if ! validateSignatureBytes(sig):
        return false
    if (BytesGet(sig, 63) & 0xE0) != 0:
        return false
    let s: Bytes = BytesSlice(sig, 32, 32)
    if ! ref10.CheckScalar(s):
        return false
    var negA: ref10.GeP3
    if ! ref10.geFromBytesNegateVartime(negA, pub):
        return false
    let rBytes: Bytes = BytesSlice(sig, 0, 32)
    let hramDigest: Bytes = sha512.Sha512Digest3(rBytes, pub, msg)
    let hram: Bytes = ref10.scReduce(hramDigest)
    var sB: ref10.GeP3
    if epoch == 1:
        ref10.geScalarMultBasePos(sB, s)
    else:
        ref10.geScalarMultBase(sB, s)
    var hA: ref10.GeP3
    ref10.geScalarMult(hA, hram, negA)
    var rCheck: ref10.GeP3
    ref10.geAdd(rCheck, sB, hA)
    let rCheckBytes: Bytes = ref10.geP3ToBytes(rCheck)
    return ref10.verify32(rBytes, rCheckBytes) == 0

fn signEd25519(priv: Bytes, msg: Bytes): Result[Signature] =
    let sigRes: Result[Bytes] = signEd25519Raw(priv, msg)
    if IsErr(sigRes):
        return Err[Signature](Error(sigRes))
    return makeSignature(Value(sigRes))

@borrows
fn verifyEd25519(pub: Bytes, msg: Bytes, sig: Bytes): bool =
    if ! validatePublicKeyBytes(pub):
        return false
    if ! validateSignatureBytes(sig):
        return false
    if (BytesGet(sig, 63) & 0xE0) != 0:
        return false
    let s: Bytes = BytesSlice(sig, 32, 32)
    if ! ref10.CheckScalar(s):
        return false
    var negA: ref10.GeP3
    if ! ref10.geFromBytesNegateVartime(negA, pub):
        return false
    let rBytes: Bytes = BytesSlice(sig, 0, 32)
    let hramDigest: Bytes = sha512.Sha512Digest3(rBytes, pub, msg)
    let hram: Bytes = ref10.scReduce(hramDigest)
    var sB: ref10.GeP3
    ref10.geScalarMultBase(sB, s)
    var hA: ref10.GeP3
    ref10.geScalarMult(hA, hram, negA)
    var rCheck: ref10.GeP3
    ref10.geAdd(rCheck, sB, hA)
    let rCheckBytes: Bytes = ref10.geP3ToBytes(rCheck)
    return ref10.verify32(rBytes, rCheckBytes) == 0
