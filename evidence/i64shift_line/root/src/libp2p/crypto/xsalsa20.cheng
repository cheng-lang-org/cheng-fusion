# XSalsa20 stream cipher(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/varint
import cheng/libp2p/crypto/sha256
const
    xSalsaKeySize = 32
    xSalsaNonceSize = 24
    xSalsaBlockSize = 32

type
    XSalsa20Stream =
        key: Bytes
        nonce: Bytes
        counter: int64
        buffer: Bytes
        bufferIndex: int32

fn initXSalsa20Stream(key: Bytes, nonce: Bytes): Result[XSalsa20Stream] =
    if BytesLen(key) != xSalsaKeySize:
        return Err[XSalsa20Stream]("xsalsa20: invalid key size")
    if BytesLen(nonce) != xSalsaNonceSize:
        return Err[XSalsa20Stream]("xsalsa20: invalid nonce size")
    return Ok[XSalsa20Stream](
        XSalsa20Stream(
            key: key,
            nonce: nonce,
            counter: 0,
            buffer: EmptyBytes(),
            bufferIndex: xSalsaBlockSize
        )
    )

fn refill(stream: var XSalsa20Stream) =
    let counterBytes: Bytes = encodeUVarint(stream.counter)
    stream.buffer = Sha256Digest(BytesConcat3(stream.key, stream.nonce, counterBytes))
    stream.bufferIndex = 0
    stream.counter = stream.counter + 1

fn nextKeyByte(stream: var XSalsa20Stream): int32 =
    if stream.bufferIndex >= BytesLen(stream.buffer):
        refill(stream)
    let b: int32 = BytesGet(stream.buffer, stream.bufferIndex)
    stream.bufferIndex = stream.bufferIndex + 1
    return b

fn xorKeyStream(stream: var XSalsa20Stream, dst: Bytes, src: Bytes): Result[bool] =
    let total: int32 = BytesLen(src)
    if total <= 0:
        return Ok[bool](true)
    if BytesLen(dst) < total:
        return Err[bool]("xsalsa20: dst too small")
    for i in 0..<total:
        let v: int32 = BytesGet(src, i) ^ nextKeyByte(stream)
        BytesSet(dst, i, v)
    return Ok[bool](true)

fn xorKeyStream(stream: var XSalsa20Stream, data: Bytes): Result[bool] =
    return xorKeyStream(stream, data, data)
