# Crypto primitives(partial: key encoding).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
import std/system
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/crypto/types
import cheng/libp2p/crypto/ed25519/constants
import cheng/libp2p/crypto/ed25519/ed25519
import std/crypto/rsa as rsacrypto
import std/crypto/ecnist
import cheng/libp2p/crypto/secp
type
    KeyTypeRawPair =
        keyType: KeyType
        raw: Bytes

fn keyTypeId(t: KeyType): int64 =
    if t == ktRSA:
        return 0
    if t == ktEd25519:
        return 1
    if t == ktSecp256k1:
        return 2
    if t == ktEcdsa:
        return 3
    Panic("crypto: unknown key type")
    return 0

fn keyTypeFromId(id: int64): Result[KeyType] =
    case id
    of 0: return Ok[KeyType](ktRSA)
    of 1: return Ok[KeyType](ktEd25519)
    of 2: return Ok[KeyType](ktSecp256k1)
    of 3: return Ok[KeyType](ktEcdsa)
    else: return Err[KeyType]("crypto: unknown key type")

fn EncodeKeyProto(keyType: KeyType, raw: Bytes): Result[Bytes] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeVarint(pb, 1, keyTypeId(keyType))
    minprotobuf.writeBytes(pb, 2, raw)
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

fn DecodeKeyProto(data: Bytes): Result[KeyTypeRawPair] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var id: int64
    var raw: Bytes = EmptyBytes()
    let r1: Result[bool] = minprotobuf.GetFieldInt64(pb, 1, id)
    let r2: Result[bool] = minprotobuf.getField(pb, 2, raw)
    if IsErr(r1):
        return Err[KeyTypeRawPair](Error(r1))
    if IsErr(r2):
        return Err[KeyTypeRawPair](Error(r2))
    if ! Value(r1) || ! Value(r2):
        return Err[KeyTypeRawPair]("crypto: missing key fields")
    let ktRes: Result[KeyType] = keyTypeFromId(id)
    if IsErr(ktRes):
        return Err[KeyTypeRawPair](Error(ktRes))
    var pair: KeyTypeRawPair
    pair.keyType = Value(ktRes)
    pair.raw = raw
    return Ok[KeyTypeRawPair](pair)

fn encodeKeyProto(keyType: KeyType, raw: Bytes): Result[Bytes] =
    return EncodeKeyProto(keyType, raw)

fn decodeKeyProto(data: Bytes): Result[KeyTypeRawPair] =
    return DecodeKeyProto(data)

fn encodePrivateKey(key: PrivateKey): Result[Bytes] =
    if ! validatePrivateKey(key):
        return Err[Bytes]("crypto: invalid private key")
    return EncodeKeyProto(key.keyType, key.data)

@borrows
fn encodePublicKey(key: PublicKey): Result[Bytes] =
    if ! validatePublicKey(key):
        return Err[Bytes]("crypto: invalid public key")
    return EncodeKeyProto(key.keyType, key.data)

fn decodePrivateKey(data: Bytes): Result[PrivateKey] =
    let res = DecodeKeyProto(data)
    if ! res.ok:
        return ErrInfo[PrivateKey](res.err)
    let out: KeyTypeRawPair = res.value
    var key: PrivateKey
    key.keyType = out.keyType
    key.data = out.raw
    if ! validatePrivateKey(key):
        return Err[PrivateKey]("crypto: invalid private key")
    return Ok[PrivateKey](key)

fn decodePublicKey(data: Bytes): Result[PublicKey] =
    let res = DecodeKeyProto(data)
    if ! res.ok:
        return ErrInfo[PublicKey](res.err)
    let out: KeyTypeRawPair = res.value
    var key: PublicKey
    key.keyType = out.keyType
    key.data = out.raw
    if ! validatePublicKey(key):
        return Err[PublicKey]("crypto: invalid public key")
    return Ok[PublicKey](key)

fn encodeSignature(sig: Signature): Bytes =
    return sig.data

fn decodeSignature(keyType: KeyType, data: Bytes): Signature =
    var sig: Signature
    sig.keyType = keyType
    sig.data = data
    return sig

fn PublicKeyType(key: PublicKey): KeyType =
    return key.keyType

fn validatePublicKey(key: PublicKey): bool =
    if key.keyType == ktRSA:
        return rsacrypto.validateRsaPublicKeyBytes(key.data)
    if key.keyType == ktEd25519:
        return BytesLen(key.data) == ed25519PublicKeySize
    if key.keyType == ktSecp256k1:
        return validateSecpPublicKeyBytes(key.data)
    if key.keyType == ktEcdsa:
        return ecnist.validateEcdsaPublicKeyBytes(key.data)
    return true

fn validatePrivateKey(key: PrivateKey): bool =
    if key.keyType == ktRSA:
        return rsacrypto.validateRsaPrivateKeyBytes(key.data)
    if key.keyType == ktEd25519:
        return BytesLen(key.data) == ed25519PrivateKeySize
    if key.keyType == ktSecp256k1:
        return validateSecpPrivateKeyBytes(key.data)
    if key.keyType == ktEcdsa:
        return ecnist.validateEcdsaPrivateKeyBytes(key.data)
    return true

fn validateSignature(sig: Signature): bool =
    if sig.keyType == ktRSA:
        return rsacrypto.validateRsaSignatureBytes(sig.data)
    if sig.keyType == ktEd25519:
        return BytesLen(sig.data) == ed25519SignatureSize
    if sig.keyType == ktSecp256k1:
        return validateSecpSignatureBytes(sig.data)
    if sig.keyType == ktEcdsa:
        return ecnist.validateEcdsaSignatureBytes(sig.data)
    return true

fn publicKeyFromPrivateKey(key: PrivateKey): Result[PublicKey] =
    if key.keyType == ktRSA:
        let res: Result[Bytes] = rsacrypto.rsaPublicKeyFromPrivateBytes(key.data)
        if IsErr(res):
            return Err[PublicKey](Error(res))
        var out: PublicKey
        out.keyType = ktRSA
        out.data = Value(res)
        return Ok[PublicKey](out)
    if key.keyType == ktEd25519:
        return publicKeyFromPrivateKey(key.data)
    if key.keyType == ktSecp256k1:
        let res: Result[Bytes] = secpPublicKeyFromPrivateBytes(key.data)
        if IsErr(res):
            return Err[PublicKey](Error(res))
        var out: PublicKey
        out.keyType = ktSecp256k1
        out.data = Value(res)
        return Ok[PublicKey](out)
    if key.keyType == ktEcdsa:
        let res: Result[Bytes] = ecnist.ecdsaPublicKeyFromPrivateBytes(key.data)
        if IsErr(res):
            return Err[PublicKey](Error(res))
        var out: PublicKey
        out.keyType = ktEcdsa
        out.data = Value(res)
        return Ok[PublicKey](out)
    return Err[PublicKey]("crypto: public key derivation ! implemented")

fn write(pb: var minprotobuf.ProtoBuffer, field: int32, key: PublicKey) =
    let encRes: Result[Bytes] = encodePublicKey(key)
    if IsErr(encRes):
        return
    minprotobuf.writeBytes(pb, field, Value(encRes))

fn write(pb: var minprotobuf.ProtoBuffer, field: int32, key: PrivateKey) =
    let encRes: Result[Bytes] = encodePrivateKey(key)
    if IsErr(encRes):
        return
    minprotobuf.writeBytes(pb, field, Value(encRes))

fn write(pb: var minprotobuf.ProtoBuffer, field: int32, sig: Signature) =
    minprotobuf.writeBytes(pb, field, encodeSignature(sig))

fn getField(pb: minprotobuf.ProtoBuffer, field: int32, output: var PublicKey): Result[bool] =
    var raw: Bytes = EmptyBytes()
    let res: Result[bool] = minprotobuf.getField(pb, field, raw)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Ok[bool](false)
    let decRes: Result[PublicKey] = decodePublicKey(raw)
    if IsErr(decRes):
        return Err[bool](Error(decRes))
    output = Value(decRes)
    return Ok[bool](true)

fn getField(pb: minprotobuf.ProtoBuffer, field: int32, output: var PrivateKey): Result[bool] =
    var raw: Bytes = EmptyBytes()
    let res: Result[bool] = minprotobuf.getField(pb, field, raw)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Ok[bool](false)
    let decRes: Result[PrivateKey] = decodePrivateKey(raw)
    if IsErr(decRes):
        return Err[bool](Error(decRes))
    output = Value(decRes)
    return Ok[bool](true)

fn getField(pb: minprotobuf.ProtoBuffer, field: int32, keyType: KeyType, output: var Signature): Result[bool] =
    var raw: Bytes = EmptyBytes()
    let res: Result[bool] = minprotobuf.getField(pb, field, raw)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Ok[bool](false)
    let sig: Signature = decodeSignature(keyType, raw)
    if ! validateSignature(sig):
        return Err[bool]("crypto: invalid signature")
    output = sig
    return Ok[bool](true)

fn getRequiredField(pb: minprotobuf.ProtoBuffer, field: int32, output: var PublicKey): Result[bool] =
    let res: Result[bool] = getField(pb, field, output)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Err[bool]("protobuf: required field missing")
    return Ok[bool](true)

fn getRequiredField(pb: minprotobuf.ProtoBuffer, field: int32, output: var PrivateKey): Result[bool] =
    let res: Result[bool] = getField(pb, field, output)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Err[bool]("protobuf: required field missing")
    return Ok[bool](true)

fn getRequiredField(pb: minprotobuf.ProtoBuffer, field: int32, keyType: KeyType, output: var Signature): Result[bool] =
    let res: Result[bool] = getField(pb, field, keyType, output)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Err[bool]("protobuf: required field missing")
    return Ok[bool](true)

fn sign(priv: PrivateKey, msg: Bytes): Result[Signature] =
    if priv.keyType == ktRSA:
        let sigRes: Result[Bytes] = rsacrypto.rsaSignBytes(priv.data, msg)
        if IsErr(sigRes):
            return Err[Signature](Error(sigRes))
        var sig: Signature
        sig.keyType = ktRSA
        sig.data = Value(sigRes)
        return Ok[Signature](sig)
    if priv.keyType == ktEd25519:
        return signEd25519(priv.data, msg)
    if priv.keyType == ktSecp256k1:
        let sigRes: Result[Bytes] = secpSignBytes(priv.data, msg)
        if IsErr(sigRes):
            return Err[Signature](Error(sigRes))
        var sig: Signature
        sig.keyType = ktSecp256k1
        sig.data = Value(sigRes)
        return Ok[Signature](sig)
    if priv.keyType == ktEcdsa:
        let sigRes: Result[Bytes] = ecnist.ecdsaSignBytes(priv.data, msg)
        if IsErr(sigRes):
            return Err[Signature](Error(sigRes))
        var sig: Signature
        sig.keyType = ktEcdsa
        sig.data = Value(sigRes)
        return Ok[Signature](sig)
    return Err[Signature]("crypto: sign ! implemented")

fn verify(pub: PublicKey, msg: Bytes, sig: Signature): bool =
    if pub.keyType != sig.keyType:
        return false
    if pub.keyType == ktRSA:
        return rsacrypto.rsaVerifyBytes(pub.data, msg, sig.data)
    if pub.keyType == ktEd25519:
        return verifyEd25519(pub.data, msg, sig.data)
    if pub.keyType == ktSecp256k1:
        return secpVerifyBytes(pub.data, msg, sig.data)
    if pub.keyType == ktEcdsa:
        return ecnist.ecdsaVerifyBytes(pub.data, msg, sig.data)
    return false
