# Crypto key types && containers(shared).

import cheng/libp2p/utils/bytes
type
    KeyType = enum
        ktRSA = 0
        ktEd25519 = 1
        ktSecp256k1 = 2
        ktEcdsa = 3

    PublicKey =
        keyType: KeyType
        data: Bytes

    PrivateKey =
        keyType: KeyType
        data: Bytes

    KeyPair =
        publicKey: PublicKey
        privateKey: PrivateKey

    Signature =
        keyType: KeyType
        data: Bytes
