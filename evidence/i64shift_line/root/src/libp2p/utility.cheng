# Utility helpers for cheng-libp2p(scaffold).

import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
const ShortDumpMax: int32 = 12

fn public() =
    0

fn shortLogBytes(data: str): str =
    if len(data) <= ShortDumpMax:
        return BytesToHex(BytesFromString(data))
    let split: int32 = ShortDumpMax / 2
    let head: str = SliceBytes(data, 0, split)
    let tail: str = SliceBytes(data, len(data) - split, split)
    let headHex: str = BytesToHex(BytesFromString(head))
    let tailHex: str = BytesToHex(BytesFromString(tail))
    return headHex + "..." + tailHex

fn shortLogStr(data: str): str =
    if len(data) <= ShortDumpMax:
        return data
    let split: int32 = ShortDumpMax / 2
    let head: str = SliceBytes(data, 0, split)
    let tail: str = SliceBytes(data, len(data) - split, split)
    return head + "..." + tail
