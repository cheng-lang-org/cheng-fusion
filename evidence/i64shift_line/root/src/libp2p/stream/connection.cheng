# Libp2p connection abstraction.

import std/result
import std/rawbytes
import std/net/stream/bufferstream
import std/net/resourcemanager
import cheng/libp2p/multiaddress
import std/seqs

type
    Direction = enum
        Inbound = 0
        Outbound = 1

    Pipe =
        aToB: bufferstream.BufferStream
        bToA: bufferstream.BufferStream
        closed: bool

    Connection =
        localAddr: multiaddress.MultiAddress
        remoteAddr: multiaddress.MultiAddress
        dir: Direction
        stream: bufferstream.BufferStream
        open: bool
        pipeIdx: int32
        pipeSide: int32
        remotePeer: str
        accounting: bool
        queueReserved: bool
        queueReservedBytes: int64

    ConnectionQueue =
        count: int32
        head: int32
        tail: int32
        items: Connection[]

    ConnectionPair =
        outbound: Connection
        inbound: Connection

const
    maxPipes = 128
    connectionQueueCapacity = 64
    connectionQueueFootprintBase = 128

var
    pipeCount: int32
    pipeUsed: bool[]
    pipeSlots: Pipe[]

fn ensurePipeTable() =
    if len(pipeSlots) < maxPipes:
        setLen(pipeSlots, maxPipes)
    if len(pipeUsed) < maxPipes:
        setLen(pipeUsed, maxPipes)

fn initConnectionQueue(): ConnectionQueue =
    var out: ConnectionQueue
    out.count = 0
    out.head = 0
    out.tail = 0
    setLen(out.items, connectionQueueCapacity)
    return out

@borrows
fn connectionQueueIsEmpty(q: ConnectionQueue): bool =
    return q.count <= 0

@borrows
fn connectionQueueIsFull(q: ConnectionQueue): bool =
    return q.count >= connectionQueueCapacity

fn enqueueConnection(q: var ConnectionQueue, conn: Connection): Result[bool] =
    if connectionQueueIsFull(q):
        return Err[bool]("connectionqueue: full")
    q.items[q.tail] = conn
    q.tail = (q.tail + 1) % connectionQueueCapacity
    q.count = q.count + 1
    return Ok[bool](true)

fn dequeueConnection(q: var ConnectionQueue): Result[Connection] =
    if connectionQueueIsEmpty(q):
        return Err[Connection]("connectionqueue: empty")
    let conn: Connection = q.items[q.head]
    q.head = (q.head + 1) % connectionQueueCapacity
    q.count = q.count - 1
    return Ok[Connection](conn)

fn resetPipe(idx: int32) =
    if idx < 0 || idx >= maxPipes:
        return
    ensurePipeTable()
    bufferstream.resetBufferStream(pipeSlots[idx].aToB)
    bufferstream.resetBufferStream(pipeSlots[idx].bToA)
    pipeSlots[idx].closed = false
    pipeUsed[idx] = true

fn allocPipe(): Result[int32] =
    for i in 0..<pipeCount:
        if pipeUsed[i] && pipeSlots[i].closed:
            resetPipe(i)
            return Ok[int32](i)
    if pipeCount >= maxPipes:
        return Err[int32]("pipe: full")
    let idx: int32 = pipeCount
    resetPipe(idx)
    pipeCount = pipeCount + 1
    return Ok[int32](idx)

fn pipeIsClosed(idx: int32): bool =
    if idx < 0 || idx >= maxPipes:
        return true
    if ! pipeUsed[idx]:
        return true
    return pipeSlots[idx].closed

fn pipeWrite(idx: int32, side: int32, data: Bytes): Result[int32] =
    ensurePipeTable()
    if idx < 0 || idx >= maxPipes || ! pipeUsed[idx]:
        return Err[int32]("pipe: invalid")
    if pipeSlots[idx].closed:
        return Err[int32]("pipe: closed")
    if side == 0:
        return bufferstream.write(pipeSlots[idx].aToB, data)
    return bufferstream.write(pipeSlots[idx].bToA, data)

fn pipeRead(idx: int32, side: int32, count: int32): Result[Bytes] =
    ensurePipeTable()
    if idx < 0 || idx >= maxPipes || ! pipeUsed[idx]:
        return Err[Bytes]("pipe: invalid")
    if pipeSlots[idx].closed:
        return Err[Bytes]("pipe: closed")
    if side == 0:
        return bufferstream.read(pipeSlots[idx].bToA, count)
    return bufferstream.read(pipeSlots[idx].aToB, count)

fn pipeClose(idx: int32) =
    if idx < 0 || idx >= maxPipes || ! pipeUsed[idx]:
        return
    if pipeSlots[idx].closed:
        return
    pipeSlots[idx].closed = true
    bufferstream.closeBufferStream(pipeSlots[idx].aToB)
    bufferstream.closeBufferStream(pipeSlots[idx].bToA)

fn newConnection(localAddr: multiaddress.MultiAddress, remoteAddr: multiaddress.MultiAddress, dir: Direction): Connection =
    var c: Connection
    c.localAddr = localAddr
    c.remoteAddr = remoteAddr
    c.dir = dir
    bufferstream.resetBufferStream(c.stream)
    c.open = true
    c.pipeIdx = -1
    c.pipeSide = 0
    c.accounting = true
    return c

fn NewConnection(localAddr: multiaddress.MultiAddress, remoteAddr: multiaddress.MultiAddress, dir: Direction): Connection =
    return newConnection(localAddr, remoteAddr, dir)

fn newConnectionPair(outLocal: multiaddress.MultiAddress, outRemote: multiaddress.MultiAddress, inLocal: multiaddress.MultiAddress, inRemote: multiaddress.MultiAddress): Result[ConnectionPair] =
    let pipeRes: Result[int32] = allocPipe()
    if IsErr(pipeRes):
        return Err[ConnectionPair](Error(pipeRes))
    let idx: int32 = Value(pipeRes)
    var outbound: Connection
    outbound.localAddr = outLocal
    outbound.remoteAddr = outRemote
    outbound.dir = Outbound
    bufferstream.resetBufferStream(outbound.stream)
    outbound.open = true
    outbound.pipeIdx = idx
    outbound.pipeSide = 0
    outbound.accounting = true
    var inbound: Connection
    inbound.localAddr = inLocal
    inbound.remoteAddr = inRemote
    inbound.dir = Inbound
    bufferstream.resetBufferStream(inbound.stream)
    inbound.open = true
    inbound.pipeIdx = idx
    inbound.pipeSide = 1
    inbound.accounting = true
    var pair: ConnectionPair
    pair.outbound = outbound
    pair.inbound = inbound
    return Ok[ConnectionPair](pair)

fn NewConnectionPair(outLocal: multiaddress.MultiAddress, outRemote: multiaddress.MultiAddress, inLocal: multiaddress.MultiAddress, inRemote: multiaddress.MultiAddress): Result[ConnectionPair] =
    return newConnectionPair(outLocal, outRemote, inLocal, inRemote)

fn setConnectionAccounting(c: var Connection, enabled: bool) =
    c.accounting = enabled

fn SetConnectionAccounting(c: var Connection, enabled: bool) =
    setConnectionAccounting(c, enabled)

@borrows
fn connectionQueueFootprintBytes(conn: Connection): int64 =
    var size: int64 = connectionQueueFootprintBase
    size = size + int64(BytesLen(conn.localAddr.data))
    size = size + int64(BytesLen(conn.remoteAddr.data))
    if size < 0:
        return 0
    return size

fn clearQueueReservation(c: var Connection) =
    c.queueReserved = false
    c.queueReservedBytes = 0

fn recordOutbound(c: var Connection, count: int32): Result[bool] =
    if ! c.accounting:
        return Ok[bool](false)
    if count <= 0:
        return Ok[bool](false)
    return resourceRecordOutboundBytes(int64(count))

fn recordInbound(c: var Connection, count: int32): Result[bool] =
    if ! c.accounting:
        return Ok[bool](false)
    if count <= 0:
        return Ok[bool](false)
    return resourceRecordInboundBytes(int64(count))

fn isOpen(c: Connection): bool =
    if ! c.open:
        return false
    if c.pipeIdx >= 0 && pipeIsClosed(c.pipeIdx):
        return false
    return true

fn ConnectionIsOpen(c: Connection): bool =
    return isOpen(c)

fn LocalAddress(c: Connection): multiaddress.MultiAddress =
    let out: multiaddress.MultiAddress = c.localAddr
    return out

fn RemoteAddress(c: Connection): multiaddress.MultiAddress =
    let out: multiaddress.MultiAddress = c.remoteAddr
    return out

fn ConnectionDirection(c: Connection): Direction =
    return c.dir

fn RemotePeerId(c: Connection): str =
    return c.remotePeer

fn write(c: var Connection, data: Bytes): Result[int32] =
    if ! c.open:
        return Err[int32]("connection: closed")
    if c.pipeIdx >= 0:
        let writeRes: Result[int32] = pipeWrite(c.pipeIdx, c.pipeSide, data)
        if IsErr(writeRes):
            return writeRes
        let count: int32 = Value(writeRes)
        if c.accounting && count > 0:
            let bwRes: Result[bool] = resourceRecordOutboundBytes(int64(count))
            if IsErr(bwRes):
                return Err[int32](Error(bwRes))
        return Ok[int32](count)
    let writeRes: Result[int32] = bufferstream.write(c.stream, data)
    if IsErr(writeRes):
        return writeRes
    let count: int32 = Value(writeRes)
    if c.accounting && count > 0:
        let bwRes: Result[bool] = resourceRecordOutboundBytes(int64(count))
        if IsErr(bwRes):
            return Err[int32](Error(bwRes))
    return Ok[int32](count)

fn read(c: var Connection, count: int32): Result[Bytes] =
    if ! c.open:
        return Err[Bytes]("connection: closed")
    if c.pipeIdx >= 0:
        let readRes: Result[Bytes] = pipeRead(c.pipeIdx, c.pipeSide, count)
        if IsErr(readRes):
            return readRes
        var payload: Bytes = Value(readRes)
        let got: int32 = BytesLen(payload)
        if c.accounting && got > 0:
            let bwRes: Result[bool] = resourceRecordInboundBytes(int64(got))
            if IsErr(bwRes):
                return Err[Bytes](Error(bwRes))
        return Ok[Bytes](payload)
    let readRes: Result[Bytes] = bufferstream.read(c.stream, count)
    if IsErr(readRes):
        return readRes
    var payload: Bytes = Value(readRes)
    let got: int32 = BytesLen(payload)
    if c.accounting && got > 0:
        let bwRes: Result[bool] = resourceRecordInboundBytes(int64(got))
        if IsErr(bwRes):
            return Err[Bytes](Error(bwRes))
    return Ok[Bytes](payload)

fn close(c: var Connection) =
    c.open = false
    if c.pipeIdx >= 0:
        pipeClose(c.pipeIdx)
    else:
        bufferstream.closeBufferStream(c.stream)

fn connWrite(c: var Connection, data: Bytes): Result[int32] =
    return write(c, data)

fn ConnWrite(c: var Connection, data: Bytes): Result[int32] =
    return connWrite(c, data)

fn connRead(c: var Connection, count: int32): Result[Bytes] =
    return read(c, count)

fn ConnRead(c: var Connection, count: int32): Result[Bytes] =
    return connRead(c, count)

fn connIsOpen(c: Connection): bool =
    return isOpen(c)

fn ConnIsOpen(c: Connection): bool =
    return connIsOpen(c)

fn connClose(c: var Connection) =
    close(c)

fn ConnClose(c: var Connection) =
    connClose(c)
