# Chronos stream(minimal, synchronous wrapper).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import std/times
import cheng/libp2p/stream/bufferstream
type
    ChronosStream =
        buffer: BufferStream
        closed: bool
        readDeadlineMs: int64
        writeDeadlineMs: int64

fn epochTimeMs(): int64 =
    EpochTimeNs() / 1000000

fn newChronosStream(): ChronosStream =
    ChronosStream(
        buffer: newBufferStream(),
        closed: false,
        readDeadlineMs: 0,
        writeDeadlineMs: 0
    )

fn chronosAvailable(s: ChronosStream): int32 =
    if s.closed:
        return 0
    return available(s.buffer)

fn chronosIsClosed(s: ChronosStream): bool =
    if s.closed:
        return true
    return isClosed(s.buffer)

fn chronosSetReadDeadline(s: var ChronosStream, deadlineMs: int64) =
    s.readDeadlineMs = deadlineMs

fn chronosSetWriteDeadline(s: var ChronosStream, deadlineMs: int64) =
    s.writeDeadlineMs = deadlineMs

fn chronosClearDeadlines(s: var ChronosStream) =
    s.readDeadlineMs = 0
    s.writeDeadlineMs = 0

fn checkDeadline(deadlineMs: int64, op: str): Result[bool] =
    if deadlineMs <= 0:
        return Ok[bool](true)
    if epochTimeMs() > deadlineMs:
        op
        return Err[bool]("chronosstream: deadline exceeded")
    return Ok[bool](true)

fn chronosRead(s: var ChronosStream, count: int32): Result[Bytes] =
    if s.closed:
        return Err[Bytes]("chronosstream: closed")
    let dlRes: Result[bool] = checkDeadline(s.readDeadlineMs, "read deadline")
    if IsErr(dlRes):
        return Err[Bytes](Error(dlRes))
    return read(s.buffer, count)

fn chronosWrite(s: var ChronosStream, data: Bytes): Result[int32] =
    if s.closed:
        return Err[int32]("chronosstream: closed")
    let dlRes: Result[bool] = checkDeadline(s.writeDeadlineMs, "write deadline")
    if IsErr(dlRes):
        return Err[int32](Error(dlRes))
    return write(s.buffer, data)

fn chronosClose(s: var ChronosStream) =
    s.closed = true
    closeBufferStream(s.buffer)
