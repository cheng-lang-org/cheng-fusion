# Bridge stream(duplex buffer adapter).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/stream/bufferstream
type
    BridgeStream =
        inbound: BufferStream
        outbound: BufferStream
        closed: bool

fn newBridgeStream(): BridgeStream =
    BridgeStream(inbound: newBufferStream(), outbound: newBufferStream(), closed: false)

fn bridgeIsClosed(s: BridgeStream): bool =
    if s.closed:
        return true
    return isClosed(s.inbound) || isClosed(s.outbound)

fn bridgeAvailableIn(s: BridgeStream): int32 =
    if s.closed:
        return 0
    return available(s.inbound)

fn bridgeAvailableOut(s: BridgeStream): int32 =
    if s.closed:
        return 0
    return available(s.outbound)

fn bridgeFeedInput(s: var BridgeStream, data: Bytes): Result[int32] =
    if s.closed:
        return Err[int32]("bridgestream: closed")
    return write(s.inbound, data)

fn bridgeDrainOutput(s: var BridgeStream, count: int32): Result[Bytes] =
    if s.closed:
        return Err[Bytes]("bridgestream: closed")
    return read(s.outbound, count)

fn bridgeRead(s: var BridgeStream, count: int32): Result[Bytes] =
    if s.closed:
        return Err[Bytes]("bridgestream: closed")
    return read(s.inbound, count)

fn bridgeWrite(s: var BridgeStream, data: Bytes): Result[int32] =
    if s.closed:
        return Err[int32]("bridgestream: closed")
    return write(s.outbound, data)

fn bridgeClose(s: var BridgeStream) =
    s.closed = true
    close(s.inbound)
    close(s.outbound)
