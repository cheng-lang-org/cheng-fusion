# Length-prefixed stream helpers(synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/varint
import cheng/libp2p/utils/buffer
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer
const
    maxVarintBytes = 10

fn readExact(c: var Connection, count: int32): Result[Bytes] =
    if count <= 0:
        return Ok[Bytes](EmptyBytes())
    var buf: GrowByteBuffer = newByteBuffer()
    var remaining: int32 = count
    while remaining > 0: # cheng-syntax-policy: allow-counting-while
        let readRes: Result[Bytes] = connRead(c, remaining)
        if IsErr(readRes):
            return Err[Bytes](Error(readRes))
        let chunk: Bytes = Value(readRes)
        let got: int32 = BytesLen(chunk)
        if got <= 0:
            return Err[Bytes]("lpstream: incomplete read")
        appendBytes(buf, chunk)
        remaining = remaining - got
    let collected: Bytes = toBytes(buf)
    let owned: Bytes = BytesSlice(collected, 0, BytesLen(collected))
    return Ok[Bytes](owned)

fn readVarint(c: var Connection): Result[int64] =
    var result: int64
    var mul: int64 = 1
    for i in 0..<maxVarintBytes:
        let readRes: Result[Bytes] = connRead(c, 1)
        if IsErr(readRes):
            return Err[int64](Error(readRes))
        let chunk: Bytes = Value(readRes)
        if BytesLen(chunk) <= 0:
            return Err[int64]("lpstream: truncated varint")
        let b: int32 = BytesGet(chunk, 0)
        let low: int32 = b % 128
        result = result + (int64(low) * mul)
        if b < 128:
            return Ok[int64](result)
        mul = mul * 128
        if mul <= 0:
            return Err[int64]("lpstream: varint overflow")
    return Err[int64]("lpstream: varint too long")

fn readLp(c: var Connection, maxSize: int32): Result[Bytes] =
    let lenRes: Result[int64] = readVarint(c)
    if IsErr(lenRes):
        return Err[Bytes](Error(lenRes))
    let length64: int64 = Value(lenRes)
    if length64 < 0 || length64 > 2147483647:
        return Err[Bytes]("lpstream: length out of range")
    let length: int32 = int32(length64)
    if maxSize > 0 && length > maxSize:
        return Err[Bytes]("lpstream: length exceeds limit")
    return readExact(c, length)

@borrows
fn writeLp(c: var Connection, payload: Bytes): Result[int32] =
    let size: int32 = BytesLen(payload)
    if size < 0:
        return Err[int32]("lpstream: invalid length")
    let lenBytes: Bytes = encodeUVarint(int64(size))
    let frame: Bytes = BytesConcat(lenBytes, payload)
    return connWrite(c, frame)

@borrows
fn writeLp(c: var Connection, payload: str): Result[int32] =
    return writeLp(c, BytesFromString(payload))

fn readExact(stream: var Stream, count: int32): Result[Bytes] =
    if count <= 0:
        return Ok[Bytes](EmptyBytes())
    var buf: GrowByteBuffer = newByteBuffer()
    var remaining: int32 = count
    while remaining > 0: # cheng-syntax-policy: allow-counting-while
        let readRes: Result[Bytes] = streamRead(stream, remaining)
        if IsErr(readRes):
            return Err[Bytes](Error(readRes))
        let chunk: Bytes = Value(readRes)
        let got: int32 = BytesLen(chunk)
        if got <= 0:
            return Err[Bytes]("lpstream: incomplete read")
        appendBytes(buf, chunk)
        remaining = remaining - got
    let collected: Bytes = toBytes(buf)
    let owned: Bytes = BytesSlice(collected, 0, BytesLen(collected))
    return Ok[Bytes](owned)

fn readVarint(stream: var Stream): Result[int64] =
    var result: int64
    var mul: int64 = 1
    for i in 0..<maxVarintBytes:
        let readRes: Result[Bytes] = streamRead(stream, 1)
        if IsErr(readRes):
            return Err[int64](Error(readRes))
        let chunk: Bytes = Value(readRes)
        if BytesLen(chunk) <= 0:
            return Err[int64]("lpstream: truncated varint")
        let b: int32 = BytesGet(chunk, 0)
        let low: int32 = b % 128
        result = result + (int64(low) * mul)
        if b < 128:
            return Ok[int64](result)
        mul = mul * 128
        if mul <= 0:
            return Err[int64]("lpstream: varint overflow")
    return Err[int64]("lpstream: varint too long")

fn readLp(stream: var Stream, maxSize: int32): Result[Bytes] =
    let lenRes: Result[int64] = readVarint(stream)
    if IsErr(lenRes):
        return Err[Bytes](Error(lenRes))
    let length64: int64 = Value(lenRes)
    if length64 < 0 || length64 > 2147483647:
        return Err[Bytes]("lpstream: length out of range")
    let length: int32 = int32(length64)
    if maxSize > 0 && length > maxSize:
        return Err[Bytes]("lpstream: length exceeds limit")
    return readExact(stream, length)

@borrows
fn writeLp(stream: var Stream, payload: Bytes): Result[int32] =
    let size: int32 = BytesLen(payload)
    if size < 0:
        return Err[int32]("lpstream: invalid length")
    let lenBytes: Bytes = encodeUVarint(int64(size))
    let frame: Bytes = BytesConcat(lenBytes, payload)
    return streamWrite(stream, frame)

@borrows
fn writeLp(stream: var Stream, payload: str): Result[int32] =
    return writeLp(stream, BytesFromString(payload))
