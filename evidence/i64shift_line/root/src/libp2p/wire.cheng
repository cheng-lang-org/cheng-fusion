# Wire framing helpers(varint length prefix).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/varint
import cheng/libp2p/stream/connection
import cheng/libp2p/stream/lpstream
type
    WireFrameDecode =
        payload: Bytes
        next: int32

const
    wireDefaultMaxFrame = 4194304

fn encodeWireFrame(payload: Bytes): Result[Bytes] =
    let size: int32 = BytesLen(payload)
    if size < 0:
        return Err[Bytes]("wire: invalid length")
    let lenBytes: Bytes = encodeUVarint(int64(size))
    return Ok[Bytes](BytesConcat(lenBytes, payload))

fn decodeWireFrame(data: Bytes, offset: int32, maxSize: int32): Result[WireFrameDecode] =
    let lenRes: Result[VarintDecoded] = decodeUVarint(data, offset)
    if IsErr(lenRes):
        return Err[WireFrameDecode](Error(lenRes))
    let decoded: VarintDecoded = Value(lenRes)
    let length64: int64 = decoded.value
    if length64 < 0 || length64 > 2147483647:
        return Err[WireFrameDecode]("wire: length out of range")
    let length: int32 = int32(length64)
    if maxSize > 0 && length > maxSize:
        return Err[WireFrameDecode]("wire: length exceeds limit")
    let start: int32 = decoded.next
    if start + length > BytesLen(data):
        return Err[WireFrameDecode]("wire: truncated frame")
    let payload: Bytes = BytesSlice(data, start, length)
    return Ok[WireFrameDecode](WireFrameDecode(payload: payload, next: start + length))

fn readWireFrame(conn: var Connection, maxSize: int32): Result[Bytes] =
    return readLp(conn, maxSize)

fn writeWireFrame(conn: var Connection, payload: Bytes): Result[int32] =
    return writeLp(conn, payload)

fn readWireFrame(stream: var Stream, maxSize: int32): Result[Bytes] =
    return readLp(stream, maxSize)

fn writeWireFrame(stream: var Stream, payload: Bytes): Result[int32] =
    return writeLp(stream, payload)
