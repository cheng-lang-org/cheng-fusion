# Switch builder(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import std/stringlist
import cheng/libp2p/utils/strings
import std/strings as stdstrings
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/crypto/crypto
import cheng/libp2p/protocols/secure/secure
import cheng/libp2p/did/types
import cheng/libp2p/did/identity_store
import cheng/libp2p/did/resolver
import cheng/libp2p/networkprofile
import cheng/libp2p/switch
import cheng/libp2p/standard_switch
import cheng/libp2p/slim_switch
import cheng/libp2p/muxers/muxer
type
    SwitchBuilder =
        privKey: Option[PrivateKey]
        addr: Option[MultiAddress]
        addrPriority: Option[StringList]
        muxerKind: Option[int32]
        secureCodec: Option[str]
        gaterEnabled: Option[bool]
        gaterAllowPeers: Option[StringList]
        gaterDenyPeers: Option[StringList]
        gaterAllowAddrs: Option[StringList]
        gaterDenyAddrs: Option[StringList]
        didAuthConfig: Option[DidAuthConfig]
        identityStorePath: Option[str]
        globalScaleProfile: Option[GlobalScaleProfile]

fn newSwitchBuilder(): SwitchBuilder =
    var b: SwitchBuilder
    return b

fn withPrivateKey(b: var SwitchBuilder, key: PrivateKey) =
    b.privKey = Some[PrivateKey](key)

fn withAddress(b: var SwitchBuilder, addr: MultiAddress) =
    b.addr = Some[MultiAddress](addr)

fn withAddressText(b: var SwitchBuilder, text: str): Result[bool] =
    var addrRes: Result[MultiAddress] = parseMultiAddress(text)
    var out: Result[bool]
    if !addrRes.ok:
        out.ok = false
        out.err.code = 1
        out.err.msg = stdstrings.CloneStr(addrRes.err.msg)
        return out
    b.addr.has = true
    b.addr.value = addrRes.value
    out.ok = true
    return out

fn withAddressPriority(b: var SwitchBuilder, list: StringList) =
    b.addrPriority = Some[StringList](list)

fn withAddressPriorityText(b: var SwitchBuilder, text: str): Result[bool] =
    let listRes: Result[StringList] = StringListFromLines(text)
    if IsErr(listRes):
        return Err[bool](Error(listRes))
    b.addrPriority = Some[StringList](Value(listRes))
    return Ok[bool](true)

fn withMuxerKind(b: var SwitchBuilder, kind: int32): Result[bool] =
    if kind != 0 && kind != 1 && kind != -1:
        return Err[bool]("builder: unknown muxer kind")
    b.muxerKind = Some[int32](kind)
    return Ok[bool](true)

fn withMuxerText(b: var SwitchBuilder, name: str): Result[bool] =
    if (name == "mplex"):
        return withMuxerKind(b, 0)
    if (name == "yamux"):
        return withMuxerKind(b, 1)
    if (name == "auto"):
        return withMuxerKind(b, -1)
    return Err[bool]("builder: unknown muxer")

fn withSecureCodec(b: var SwitchBuilder, codec: str): Result[bool] =
    if ! ((codec == "plaintext") || (codec == "noise") || (codec == "tls")):
        return Err[bool]("builder: unknown secure codec")
    b.secureCodec = Some[str](codec)
    return Ok[bool](true)

fn withGaterEnabled(b: var SwitchBuilder, enabled: bool) =
    b.gaterEnabled = Some[bool](enabled)

fn withGaterAllowPeerText(b: var SwitchBuilder, peerText: str): Result[bool] =
    var list: StringList = if b.gaterAllowPeers.has: b.gaterAllowPeers.value else: InitStringList()
    let addRes: Result[bool] = StringListAdd(list, peerText)
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    b.gaterAllowPeers = Some[StringList](list)
    return Ok[bool](true)

fn withGaterDenyPeerText(b: var SwitchBuilder, peerText: str): Result[bool] =
    var list: StringList = if b.gaterDenyPeers.has: b.gaterDenyPeers.value else: InitStringList()
    let addRes: Result[bool] = StringListAdd(list, peerText)
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    b.gaterDenyPeers = Some[StringList](list)
    return Ok[bool](true)

fn withGaterAllowAddressText(b: var SwitchBuilder, needle: str): Result[bool] =
    var list: StringList = if b.gaterAllowAddrs.has: b.gaterAllowAddrs.value else: InitStringList()
    let addRes: Result[bool] = StringListAdd(list, needle)
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    b.gaterAllowAddrs = Some[StringList](list)
    return Ok[bool](true)

fn withGaterDenyAddressText(b: var SwitchBuilder, needle: str): Result[bool] =
    var list: StringList = if b.gaterDenyAddrs.has: b.gaterDenyAddrs.value else: InitStringList()
    let addRes: Result[bool] = StringListAdd(list, needle)
    if IsErr(addRes):
        return Err[bool](Error(addRes))
    b.gaterDenyAddrs = Some[StringList](list)
    return Ok[bool](true)

fn withDidAuthConfig(b: var SwitchBuilder, config: DidAuthConfig) =
    b.didAuthConfig = Some[DidAuthConfig](config)

fn withIdentityStorePath(b: var SwitchBuilder, path: str): Result[bool] =
    if len(path) <= 0:
        return Err[bool]("builder: empty identity store path")
    b.identityStorePath = Some[str](path)
    return Ok[bool](true)

fn withGlobalScaleProfile(b: var SwitchBuilder, profile: GlobalScaleProfile) =
    b.globalScaleProfile = Some[GlobalScaleProfile](profile)

fn withNodeTier(b: var SwitchBuilder, tier: NodeTier) =
    var profile: GlobalScaleProfile = if b.globalScaleProfile.has: b.globalScaleProfile.value else: initGlobalScaleProfileL2Routing()
    setProfileTier(profile, tier)
    b.globalScaleProfile = Some[GlobalScaleProfile](profile)

fn withAutoRolePromotionEnabled(b: var SwitchBuilder, enabled: bool) =
    var profile: GlobalScaleProfile = if b.globalScaleProfile.has: b.globalScaleProfile.value else: initGlobalScaleProfileL2Routing()
    setProfileAutoRolePromotionEnabled(profile, enabled)
    b.globalScaleProfile = Some[GlobalScaleProfile](profile)

# Shared prelude: resolve the builder's key + listen address. Split out so
# build()/buildSlim() stay STATICALLY separate — a runtime slim/full branch
# inside one build() would keep both switch constructors reachable and defeat
# the closure pruning that is the slim profile's whole purpose.
fn resolveSwitchBuilderIdentity(b: var SwitchBuilder,
                                priv: var PrivateKey,
                                addr: var MultiAddress): Result[bool] =
    if b.privKey.has:
        priv = b.privKey.value
    else:
        var kpRes: Result[KeyPair] = generateKeyPair()
        if IsErr(kpRes):
            return Err[bool](stdstrings.CloneStr(Error(kpRes)))
        let kp: KeyPair = Value(kpRes)
        priv = kp.privateKey
    if b.addr.has:
        addr = b.addr.value
    else:
        var addrRes: Result[MultiAddress] = parseMultiAddress("/memory/0")
        if IsErr(addrRes):
            return Err[bool](stdstrings.CloneStr(Error(addrRes)))
        addr = Value(addrRes)
    return Ok[bool](true)

fn build(b: var SwitchBuilder): Result[Switch] =
    var priv: PrivateKey
    var addr: MultiAddress
    let idRes: Result[bool] = resolveSwitchBuilderIdentity(b, priv, addr)
    if IsErr(idRes):
        return Err[Switch](Error(idRes))
    var sw: Switch = newStandardSwitch(addr, priv)
    let optRes: Result[bool] = applySwitchBuilderOptionsFull(b, sw)
    if IsErr(optRes):
        return Err[Switch](Error(optRes))
    if b.muxerKind.has:
        var muxRes: Result[bool] = setMuxerKind(sw, b.muxerKind.value)
        if IsErr(muxRes):
            return Err[Switch](Error(muxRes))
    if b.globalScaleProfile.has:
        var profileRes: Result[bool] = applyGlobalScaleProfile(sw, b.globalScaleProfile.value)
        if IsErr(profileRes):
            return Err[Switch](Error(profileRes))
    return Ok[Switch](sw)

# Slim variant: identical option handling, but the switch only registers
# identify/ping/gossipsub/feed (slim_switch.cheng). Reached only from the
# *_slim init entries so full-profile consumers never pull it in and vice
# versa.
fn buildSlim(b: var SwitchBuilder, sw: var Switch): Result[bool] =
    var priv: PrivateKey
    var addr: MultiAddress
    var idRes: Result[bool] = resolveSwitchBuilderIdentity(b, priv, addr)
    if IsErr(idRes):
        return Err[bool](stdstrings.CloneStr(Error(idRes)))
    newSlimSwitch(sw, stdstrings.CloneStr(addr.raw))
    return Ok[bool](true)

fn applySwitchBuilderOptionsFull(b: var SwitchBuilder, sw: var Switch): Result[bool] =
    if b.secureCodec.has:
        var secure: Secure
        initSecureInto(secure, stdstrings.CloneStr(b.secureCodec.value))
        if len(peerid.toString(sw.peerId)) > 0:
            setLocalPeerId(secure, stdstrings.CloneStr(sw.peerId))
        setSecure(sw, secure)
    if b.identityStorePath.has:
        sw.didAuth.identityStorePath = stdstrings.CloneStr(b.identityStorePath.value)
    if b.didAuthConfig.has:
        sw.didAuth.config = b.didAuthConfig.value
    if b.addrPriority.has:
        var setRes: Result[bool] = setAddressPriority(sw, b.addrPriority.value)
        if IsErr(setRes):
            return Err[bool](stdstrings.CloneStr(Error(setRes)))
    var gaterConfigured: bool
    if b.gaterAllowPeers.has:
        if b.gaterAllowPeers.value.count > 0:
            gaterConfigured = true
        var i: int32
        while i < b.gaterAllowPeers.value.count:
            var addRes: Result[bool] = allowPeerText(sw.gater, stdstrings.CloneStr(b.gaterAllowPeers.value.items[i]))
            if IsErr(addRes):
                return Err[bool](stdstrings.CloneStr(Error(addRes)))
            i = i + 1
    if b.gaterDenyPeers.has:
        if b.gaterDenyPeers.value.count > 0:
            gaterConfigured = true
        var j: int32
        while j < b.gaterDenyPeers.value.count:
            var addRes: Result[bool] = denyPeerText(sw.gater, stdstrings.CloneStr(b.gaterDenyPeers.value.items[j]))
            if IsErr(addRes):
                return Err[bool](stdstrings.CloneStr(Error(addRes)))
            j = j + 1
    if b.gaterAllowAddrs.has:
        if b.gaterAllowAddrs.value.count > 0:
            gaterConfigured = true
        var k: int32
        while k < b.gaterAllowAddrs.value.count:
            var addRes: Result[bool] = allowAddressSubstring(sw.gater, stdstrings.CloneStr(b.gaterAllowAddrs.value.items[k]))
            if IsErr(addRes):
                return Err[bool](stdstrings.CloneStr(Error(addRes)))
            k = k + 1
    if b.gaterDenyAddrs.has:
        if b.gaterDenyAddrs.value.count > 0:
            gaterConfigured = true
        var n: int32
        while n < b.gaterDenyAddrs.value.count:
            var addRes: Result[bool] = denyAddressSubstring(sw.gater, stdstrings.CloneStr(b.gaterDenyAddrs.value.items[n]))
            if IsErr(addRes):
                return Err[bool](stdstrings.CloneStr(Error(addRes)))
            n = n + 1
    if b.gaterEnabled.has:
        setGaterEnabled(sw.gater, b.gaterEnabled.value)
    elif gaterConfigured:
        setGaterEnabled(sw.gater, true)
    return Ok[bool](true)
