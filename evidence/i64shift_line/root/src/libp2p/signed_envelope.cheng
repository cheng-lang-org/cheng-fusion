# Signed envelope helpers(partial).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/crypto/crypto
import std/multiformats/protobuf/minprotobuf
import cheng/libp2p/vbuffer
type
    Envelope =
        publicKey: PublicKey
        domain: str
        payloadType: Bytes
        payload: Bytes
        signature: Signature

fn signatureBuffer(env: Envelope): Bytes =
    var vb: VBuffer = newVBuffer()
    writeSeq(vb, env.domain)
    writeSeq(vb, env.payloadType)
    writeSeq(vb, env.payload)
    return toBytes(vb)

fn VerifyEnvelope(env: Envelope): bool =
    if ! validatePublicKey(env.publicKey):
        return false
    if ! validateSignature(env.signature):
        return false
    return verify(env.publicKey, signatureBuffer(env), env.signature)

fn InitEnvelope(priv: PrivateKey, payloadType: Bytes, payload: Bytes, domain: str): Result[Envelope] =
    let pubRes: Result[PublicKey] = publicKeyFromPrivateKey(priv)
    if IsErr(pubRes):
        return Err[Envelope](Error(pubRes))
    var env: Envelope = Envelope(
        publicKey: Value(pubRes),
        domain: domain,
        payloadType: payloadType,
        payload: payload
    )
    let sigRes: Result[Signature] = sign(priv, signatureBuffer(env))
    if IsErr(sigRes):
        return Err[Envelope](Error(sigRes))
    env.signature = Value(sigRes)
    return Ok[Envelope](env)

fn EncodeEnvelope(env: Envelope): Result[Bytes] =
    if ! validatePublicKey(env.publicKey):
        return Err[Bytes]("envelope: invalid public key")
    if ! validateSignature(env.signature):
        return Err[Bytes]("envelope: invalid signature")
    let pubRes: Result[Bytes] = encodePublicKey(env.publicKey)
    if IsErr(pubRes):
        return Err[Bytes](Error(pubRes))
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBuffer()
    minprotobuf.writeBytes(pb, 1, Value(pubRes))
    if BytesLen(env.payloadType) > 0:
        minprotobuf.writeBytes(pb, 2, env.payloadType)
    minprotobuf.writeBytes(pb, 3, env.payload)
    minprotobuf.writeBytes(pb, 5, encodeSignature(env.signature))
    return Ok[Bytes](minprotobuf.protoToBytes(pb))

@borrows
fn DecodeEnvelope(data: Bytes, domain: str): Result[Envelope] =
    var pb: minprotobuf.ProtoBuffer = minprotobuf.InitProtoBufferFromBytes(data, 0)
    var env: Envelope = Envelope(
        domain: domain,
        payloadType: EmptyBytes(),
        payload: EmptyBytes()
    )
    let pubRes: Result[bool] = getField(pb, 1, env.publicKey)
    if IsErr(pubRes):
        return Err[Envelope](Error(pubRes))
    if ! Value(pubRes):
        return Err[Envelope]("envelope: missing public key")
    var payloadType: Bytes = EmptyBytes()
    let typeRes: Result[bool] = minprotobuf.getField(pb, 2, payloadType)
    if IsErr(typeRes):
        return Err[Envelope](Error(typeRes))
    if Value(typeRes):
        env.payloadType = payloadType
    var payload: Bytes = EmptyBytes()
    let payloadRes: Result[bool] = minprotobuf.getField(pb, 3, payload)
    if IsErr(payloadRes):
        return Err[Envelope](Error(payloadRes))
    if ! Value(payloadRes):
        return Err[Envelope]("envelope: missing payload")
    env.payload = payload
    var sigBytes: Bytes = EmptyBytes()
    let sigRes: Result[bool] = minprotobuf.getField(pb, 5, sigBytes)
    if IsErr(sigRes):
        return Err[Envelope](Error(sigRes))
    if ! Value(sigRes):
        return Err[Envelope]("envelope: missing signature")
    let sig: Signature = decodeSignature(env.publicKey.keyType, sigBytes)
    if ! validateSignature(sig):
        return Err[Envelope]("envelope: invalid signature")
    env.signature = sig
    if ! VerifyEnvelope(env):
        return Err[Envelope]("envelope: signature mismatch")
    return Ok[Envelope](env)

fn verifyEnvelope(env: Envelope): bool =
    return VerifyEnvelope(env)

fn initEnvelope(priv: PrivateKey, payloadType: Bytes, payload: Bytes, domain: str): Result[Envelope] =
    return InitEnvelope(priv, payloadType, payload, domain)

fn encodeEnvelope(env: Envelope): Result[Bytes] =
    return EncodeEnvelope(env)

fn decodeEnvelope(data: Bytes, domain: str): Result[Envelope] =
    return DecodeEnvelope(data, domain)

fn envelopePayload(env: Envelope): Bytes =
    return env.payload

fn getField(pb: minprotobuf.ProtoBuffer, field: int32, output: var Envelope, domain: str): Result[bool] =
    var raw: Bytes = EmptyBytes()
    let res: Result[bool] = minprotobuf.getField(pb, field, raw)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Ok[bool](false)
    let envRes: Result[Envelope] = DecodeEnvelope(raw, domain)
    if IsErr(envRes):
        return Err[bool](Error(envRes))
    output = Value(envRes)
    return Ok[bool](true)

fn write(pb: var minprotobuf.ProtoBuffer, field: int32, env: Envelope): Result[bool] =
    let encRes: Result[Bytes] = EncodeEnvelope(env)
    if IsErr(encRes):
        return Err[bool](Error(encRes))
    minprotobuf.writeBytes(pb, field, Value(encRes))
    return Ok[bool](true)
