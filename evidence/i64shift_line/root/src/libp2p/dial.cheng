# Dial helpers(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/option
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/stream/connection
import cheng/libp2p/stream/connection as streamconn
import cheng/libp2p/muxers/muxer
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/transports/tcptransport
import cheng/libp2p/transports/wstransport
import cheng/libp2p/transports/mobilehwtransport
import cheng/quic/quictransport
import cheng/quic/openssl_quic
import cheng/libp2p/transports/webrtcdirecttransport
import cheng/libp2p/transports/webrtcstartransport
import cheng/quic/msquictransport_native as msquic
import cheng/libp2p/transports/tortransport
import cheng/libp2p/upgrademngrs/upgrade
type
    MsQuicTransportOption =
        has: bool
        value: msquic.MsQuicTransport

    Dial =
        memory: Option[MemoryTransport]
        tcp: Option[TcpTransport]
        ws: Option[WsTransport]
        mobileHw: Option[MobileHwTransport]
        quic: Option[QuicTransport]
        opensslQuic: Option[OpenSslQuicTransport]
        webrtcDirect: Option[WebrtcDirectTransport]
        webrtcStar: Option[WebrtcStarTransport]
        msquic: MsQuicTransportOption
        tor: Option[TorTransport]
        upgrader: Upgrade
        hasUpgrader: bool

fn initDial(): Dial =
    var out: Dial
    return out

fn setUpgrade(d: var Dial, up: var Upgrade) =
    d.upgrader.hasSecure = up.hasSecure
    d.upgrader.muxerKind = up.muxerKind
    d.hasUpgrader = true

fn addMemoryTransport(d: var Dial, t: MemoryTransport) =
    d.memory.has = true
    d.memory.value = t

fn addTcpTransport(d: var Dial, t: TcpTransport) =
    d.tcp.has = true
    d.tcp.value = t

fn addWsTransport(d: var Dial, t: WsTransport) =
    d.ws.has = true
    d.ws.value = t

fn addMobileHwTransport(d: var Dial, t: MobileHwTransport) =
    d.mobileHw.has = true
    d.mobileHw.value = t

fn addQuicTransport(d: var Dial, t: QuicTransport) =
    d.quic.has = true
    d.quic.value = t

fn addOpenSslQuicTransport(d: var Dial, t: OpenSslQuicTransport) =
    d.opensslQuic.has = true
    d.opensslQuic.value = t

fn addWebrtcDirectTransport(d: var Dial, t: WebrtcDirectTransport) =
    d.webrtcDirect.has = true
    d.webrtcDirect.value = t

fn addWebrtcStarTransport(d: var Dial, t: WebrtcStarTransport) =
    d.webrtcStar.has = true
    d.webrtcStar.value = t

fn addMsQuicTransport(d: var Dial, t: msquic.MsQuicTransport) =
    d.msquic.has = true
    d.msquic.value = t

fn addTorTransport(d: var Dial, t: TorTransport) =
    d.tor.has = true
    d.tor.value = t

fn canDial(d: Dial, addr: multiaddress.MultiAddress): bool =
    if d.memory.has:
        var mem: MemoryTransport = d.memory.value
        if memorytransport.handles(mem, addr):
            return true
    if d.tcp.has:
        var tcp: TcpTransport = d.tcp.value
        if tcptransport.handles(tcp, addr):
            return true
    if d.ws.has:
        var ws: WsTransport = d.ws.value
        if wstransport.handles(ws, addr):
            return true
    if d.mobileHw.has:
        var mobileHw: MobileHwTransport = d.mobileHw.value
        if mobilehwtransport.handles(mobileHw, addr):
            return true
    if d.msquic.has:
        var msq: msquic.MsQuicTransport = d.msquic.value
        if msquic.handles(msq, addr):
            return true
    if d.opensslQuic.has:
        var opensslQuic: OpenSslQuicTransport = d.opensslQuic.value
        if openssl_quic.handles(opensslQuic, addr):
            return true
    if d.quic.has:
        var quic: QuicTransport = d.quic.value
        if quictransport.handles(quic, addr):
            return true
    if d.webrtcDirect.has:
        var webrtcDirect: WebrtcDirectTransport = d.webrtcDirect.value
        if webrtcdirecttransport.handles(webrtcDirect, addr):
            return true
    if d.webrtcStar.has:
        var webrtcStar: WebrtcStarTransport = d.webrtcStar.value
        if webrtcstartransport.handles(webrtcStar, addr):
            return true
    if d.tor.has:
        var tor: TorTransport = d.tor.value
        if tortransport.handles(tor, addr):
            return true
    return false

fn DialAndUpgrade(d: var Dial, addr: multiaddress.MultiAddress): Result[muxer.Muxer] =
    if ! d.hasUpgrader:
        return Err[muxer.Muxer]("dial: upgrader ! set")
    if d.memory.has:
        var mem: MemoryTransport = d.memory.value
        if memorytransport.handles(mem, addr):
            let connRes: Result[streamconn.Connection] = memorytransport.dial(mem, addr)
            d.memory.has = true
            d.memory.value = mem
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                memorytransport.dropMemoryPendingByPipe(mem, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.ws.has:
        var ws: WsTransport = d.ws.value
        if wstransport.handles(ws, addr):
            let connRes: Result[streamconn.Connection] = wstransport.dial(ws, addr)
            d.ws.has = true
            d.ws.value = ws
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                wstransport.dropWsPendingByPipe(ws, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.mobileHw.has:
        var mobileHw: MobileHwTransport = d.mobileHw.value
        if mobilehwtransport.handles(mobileHw, addr):
            let connRes: Result[streamconn.Connection] = mobilehwtransport.dial(mobileHw, addr)
            d.mobileHw.has = true
            d.mobileHw.value = mobileHw
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                mobilehwtransport.dropPending(mobileHw, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.msquic.has:
        var msq: msquic.MsQuicTransport = d.msquic.value
        if msquic.handles(msq, addr):
            let connRes: Result[streamconn.Connection] = msquic.dial(msq, addr)
            d.msquic.has = true
            d.msquic.value = msq
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                msquic.dropMsQuicPendingByPipe(msq, addr, conn.pipeIdx)
                msquic.dropMsQuicConnectionsByPipe(conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.opensslQuic.has:
        var opensslQuic: OpenSslQuicTransport = d.opensslQuic.value
        if openssl_quic.handles(opensslQuic, addr):
            let connRes: Result[streamconn.Connection] = openssl_quic.dial(opensslQuic, addr)
            d.opensslQuic.has = true
            d.opensslQuic.value = opensslQuic
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                openssl_quic.dropOpenSslQuicPendingByPipe(opensslQuic, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.quic.has:
        var quic: QuicTransport = d.quic.value
        if quictransport.handles(quic, addr):
            let connRes: Result[streamconn.Connection] = quictransport.dial(quic, addr)
            d.quic.has = true
            d.quic.value = quic
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                quictransport.dropQuicPendingByPipe(quic, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.webrtcDirect.has:
        var webrtcDirect: WebrtcDirectTransport = d.webrtcDirect.value
        if webrtcdirecttransport.handles(webrtcDirect, addr):
            let connRes: Result[streamconn.Connection] = webrtcdirecttransport.dial(webrtcDirect, addr)
            d.webrtcDirect.has = true
            d.webrtcDirect.value = webrtcDirect
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                webrtcdirecttransport.dropWebrtcDirectPendingByPipe(webrtcDirect, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.webrtcStar.has:
        var webrtcStar: WebrtcStarTransport = d.webrtcStar.value
        if webrtcstartransport.handles(webrtcStar, addr):
            let connRes: Result[streamconn.Connection] = webrtcstartransport.dial(webrtcStar, addr)
            d.webrtcStar.has = true
            d.webrtcStar.value = webrtcStar
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                webrtcstartransport.dropWebrtcStarPendingByPipe(webrtcStar, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.tor.has:
        var tor: TorTransport = d.tor.value
        if tortransport.handles(tor, addr):
            let connRes: Result[streamconn.Connection] = tortransport.dial(tor, addr)
            d.tor.has = true
            d.tor.value = tor
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                tortransport.dropTorPendingByPipe(tor, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    if d.tcp.has:
        var tcp: TcpTransport = d.tcp.value
        if tcptransport.handles(tcp, addr):
            let connRes: Result[streamconn.Connection] = tcptransport.dial(tcp, addr)
            d.tcp.has = true
            d.tcp.value = tcp
            if IsErr(connRes):
                return Err[muxer.Muxer](Error(connRes))
            var conn: streamconn.Connection = Value(connRes)
            let muxRes: Result[muxer.Muxer] = upgrade(d.upgrader, conn, None[PeerId]())
            if IsErr(muxRes):
                tcptransport.dropTcpPendingByPipe(tcp, addr, conn.pipeIdx)
                close(conn)
                return Err[muxer.Muxer](Error(muxRes))
            return muxRes
    return Err[muxer.Muxer]("dial: no transport for address")

fn InitDial(): Dial =
    return initDial()

fn SetUpgrade(d: var Dial, up: var Upgrade) =
    setUpgrade(d, up)

fn AddMemoryTransport(d: var Dial, t: MemoryTransport) =
    addMemoryTransport(d, t)

fn AddTcpTransport(d: var Dial, t: TcpTransport) =
    addTcpTransport(d, t)

fn AddWsTransport(d: var Dial, t: WsTransport) =
    addWsTransport(d, t)

fn AddMobileHwTransport(d: var Dial, t: MobileHwTransport) =
    addMobileHwTransport(d, t)

fn AddQuicTransport(d: var Dial, t: QuicTransport) =
    addQuicTransport(d, t)

fn AddOpenSslQuicTransport(d: var Dial, t: OpenSslQuicTransport) =
    addOpenSslQuicTransport(d, t)

fn AddWebrtcDirectTransport(d: var Dial, t: WebrtcDirectTransport) =
    addWebrtcDirectTransport(d, t)

fn AddWebrtcStarTransport(d: var Dial, t: WebrtcStarTransport) =
    addWebrtcStarTransport(d, t)

fn AddMsQuicTransport(d: var Dial, t: msquic.MsQuicTransport) =
    addMsQuicTransport(d, t)

fn AddTorTransport(d: var Dial, t: TorTransport) =
    addTorTransport(d, t)

fn CanDial(d: Dial, addr: multiaddress.MultiAddress): bool =
    return canDial(d, addr)
