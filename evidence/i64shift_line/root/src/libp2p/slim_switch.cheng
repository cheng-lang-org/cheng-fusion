# Slim switch profile: only what the mobile social feed path needs
# (identify/ping liveness, gossipsub announce, feed snapshots).
# newStandardSwitch unconditionally registers 26 protocols; reachability
# then drags ~23k protocol lines (depin/inference_transport alone 11.4k)
# into every consumer closure — the S2 feed_core.o build wall. The switch
# dispatch is data-driven (registerProtocol appends a handler pointer), so
# a protocol whose registration never happens is pruned by reachability.
# This file imports only the light subset to keep the closure minimal.

import cheng/libp2p/utils/result
import std/strings as stdstrings
import cheng/libp2p/multiaddress
import cheng/libp2p/peerid
import cheng/libp2p/switch
import cheng/libp2p/protocols/pubsub/pubsub
import cheng/libp2p/protocols/pubsub/gossipsub
import cheng/libp2p/protocols/feed/feedservice

fn newSlimSwitch(sw: var Switch, addrText: str) =
    initSwitchIntoSlim(sw)
    setListenAddrTextSlim(sw, addrText)
    setSecureCodecOnSwitch(sw, "plaintext")
    registerProtocolPartsSlim(sw, "/ipfs/id/1.0.0")
    registerProtocolPartsSlim(sw, "/ipfs/id/push/1.0.0")
    registerProtocolPartsSlim(sw, "/ipfs/ping/1.0.0")
    setGossipsubConfig(initGossipsubConfig())
    enableGossipsubContext()
    registerProtocolPartsSlim(sw, gossipsubCodec)
    setFeedConfig(initFeedConfig())
    registerProtocolPartsSlim(sw, feedCodec)
