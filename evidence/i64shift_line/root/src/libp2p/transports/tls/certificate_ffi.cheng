# TLS certificate FFI placeholders(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
import cheng/libp2p/utils/strings
import cheng/libp2p/crypto/sha256
const
    cERT_SUCCESS = 0
    cERT_FORMAT_DER = 0
    cERT_FORMAT_PEM = 1

type
    cert_error_t = int32
    cert_format_t = int32

    cert_buffer =
        data: Bytes

    cert_parsed =
        signature: cert_buffer
        ident_pubk: cert_buffer
        cert_pubk: cert_buffer
        valid_from: str
        valid_to: str

    cert_context_t =
        seeded: bool
        seed: Bytes

    cert_key_t =
        priv: Bytes
        pub: Bytes

fn cert_init_drbg(seed: str, seed_len: int32, ctx: var cert_context_t): cert_error_t =
    let seedBytes: Bytes = if len(seed) > 0: BytesSlice(BytesFromString(seed), 0, len(seed)) else: EmptyBytes()
    BytesFree(ctx.seed)
    ctx.seeded = true
    ctx.seed = seedBytes
    return cERT_SUCCESS

fn cert_free_ctr_drbg(ctx: var cert_context_t) =
    BytesFree(ctx.seed)
    ctx.seeded = false
    ctx.seed = EmptyBytes()

fn cert_generate_key(ctx: cert_context_t, outKey: var cert_key_t): cert_error_t =
    let seed: Bytes = if BytesLen(ctx.seed) > 0: ctx.seed else: BytesFromString("libp2p_tls")
    let priv: Bytes = Sha256Digest(seed)
    let pub: Bytes = Sha256Digest(priv)
    outKey.priv = priv
    outKey.pub = pub
    return cERT_SUCCESS

fn cert_new_key_t(seckey: cert_buffer, outKey: var cert_key_t): cert_error_t =
    outKey.priv = seckey.data
    outKey.pub = Sha256Digest(seckey.data)
    return cERT_SUCCESS

fn cert_serialize_privk(key: cert_key_t, outBuf: var cert_buffer, format: cert_format_t): cert_error_t =
    format
    outBuf = cert_buffer(data: key.priv)
    return cERT_SUCCESS

fn cert_serialize_pubk(key: cert_key_t, outBuf: var cert_buffer, format: cert_format_t): cert_error_t =
    format
    outBuf = cert_buffer(data: key.pub)
    return cERT_SUCCESS

fn cert_generate(
    ctx: cert_context_t,
    key: cert_key_t,
    outBuf: var cert_buffer,
    signature: cert_buffer,
    ident_pubk: cert_buffer,
    cn: str,
    validFrom: str,
    validTo: str,
    format: cert_format_t
): cert_error_t =
    ctx
    cn
    format
    var buf: GrowByteBuffer = newByteBuffer()
    appendBytes(buf, BytesFromString("TLSCERT"))
    appendBytes(buf, encodeUVarint(BytesLen(key.pub)))
    appendBytes(buf, key.pub)
    appendBytes(buf, encodeUVarint(BytesLen(signature.data)))
    appendBytes(buf, signature.data)
    appendBytes(buf, encodeUVarint(BytesLen(ident_pubk.data)))
    appendBytes(buf, ident_pubk.data)
    appendBytes(buf, encodeUVarint(len(validFrom)))
    appendBytes(buf, BytesFromString(validFrom))
    appendBytes(buf, encodeUVarint(len(validTo)))
    appendBytes(buf, BytesFromString(validTo))
    outBuf = cert_buffer(data: toBytes(buf))
    return cERT_SUCCESS

fn cert_parse(cert: cert_buffer, format: cert_format_t, outCert: var cert_parsed): cert_error_t =
    format
    let data: Bytes = cert.data
    if BytesLen(data) <= 7:
        return 1
    let magic: Bytes = BytesSlice(data, 0, 7)
    if ! BytesEqual(magic, BytesFromString("TLSCERT")):
        return 1
    var offset: int32 = 7
    let pubLenRes: Result[VarintDecoded] = decodeUVarint(data, offset)
    if IsErr(pubLenRes):
        return 1
    let pubLen: int32 = int32(Value(pubLenRes).value)
    offset = Value(pubLenRes).next
    outCert.cert_pubk = cert_buffer(data: BytesSlice(data, offset, pubLen))
    offset = offset + pubLen
    let sigLenRes: Result[VarintDecoded] = decodeUVarint(data, offset)
    if IsErr(sigLenRes):
        return 1
    let sigLen: int32 = int32(Value(sigLenRes).value)
    offset = Value(sigLenRes).next
    outCert.signature = cert_buffer(data: BytesSlice(data, offset, sigLen))
    offset = offset + sigLen
    let idLenRes: Result[VarintDecoded] = decodeUVarint(data, offset)
    if IsErr(idLenRes):
        return 1
    let idLen: int32 = int32(Value(idLenRes).value)
    offset = Value(idLenRes).next
    outCert.ident_pubk = cert_buffer(data: BytesSlice(data, offset, idLen))
    offset = offset + idLen
    let fromLenRes: Result[VarintDecoded] = decodeUVarint(data, offset)
    if IsErr(fromLenRes):
        return 1
    let fromLen: int32 = int32(Value(fromLenRes).value)
    offset = Value(fromLenRes).next
    outCert.valid_from = BytesToString(BytesSlice(data, offset, fromLen))
    offset = offset + fromLen
    let toLenRes: Result[VarintDecoded] = decodeUVarint(data, offset)
    if IsErr(toLenRes):
        return 1
    let toLen: int32 = int32(Value(toLenRes).value)
    offset = Value(toLenRes).next
    outCert.valid_to = BytesToString(BytesSlice(data, offset, toLen))
    return cERT_SUCCESS

fn cert_free_key(key: var cert_key_t) =
    key.priv = EmptyBytes()
    key.pub = EmptyBytes()

fn cert_free_buffer(buffer: var cert_buffer) =
    buffer.data = EmptyBytes()

fn cert_free_parsed(cert: var cert_parsed) =
    cert.signature.data = EmptyBytes()
    cert.ident_pubk.data = EmptyBytes()
    cert.cert_pubk.data = EmptyBytes()
    cert.valid_from = ""
    cert.valid_to = ""

fn cert_signing_req(cn: str, key: cert_key_t, csr_buffer: var cert_buffer): cert_error_t =
    var buf: GrowByteBuffer = newByteBuffer()
    appendBytes(buf, BytesFromString("TLSCSR"))
    appendBytes(buf, encodeUVarint(len(cn)))
    appendBytes(buf, BytesFromString(cn))
    appendBytes(buf, encodeUVarint(BytesLen(key.pub)))
    appendBytes(buf, key.pub)
    csr_buffer = cert_buffer(data: toBytes(buf))
    return cERT_SUCCESS
