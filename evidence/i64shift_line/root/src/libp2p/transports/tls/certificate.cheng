# TLS certificate helpers(minimal).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
import std/times
import cheng/libp2p/crypto/crypto
import cheng/libp2p/peerid
const
    certMagic = "TLSC1"
    certMagicLen = 5

type
    EncodingFormat = enum
        DER
        PEM

    P2pExtension =
        publicKey: Bytes
        signature: Bytes

    P2pCertificate =
        extension: P2pExtension
        pubKeyDer: Bytes
        validFrom: int64
        validTo: int64

    CertificateX509 =
        certificate: Bytes
        privateKey: Bytes

fn makeSignatureMessage(pubKeyDer: Bytes): Bytes =
    let prefix: Bytes = BytesFromString("libp2p-tls-handshake:")
    return BytesConcat(prefix, pubKeyDer)

fn int64ToBytesBE(value: int64): Bytes =
    let out: Bytes = BytesAlloc(8)
    var v: int64 = value
    var i: int32 = 7
    let loop_start_i_1 = i
    for loop_rev_i_1 in 0..(loop_start_i_1 - (0)):
        i = loop_start_i_1 - loop_rev_i_1
        if ! (i >= 0):
            break
        BytesSet(out, i, int32(v & 255))
        v = v >> 8
    return out

fn bytesToInt64BE(data: Bytes, offset: int32): Result[int64] =
    if offset < 0 || offset + 7 >= BytesLen(data):
        return Err[int64]("tls: invalid int64 offset")
    var v: int64
    for i in 0..<8:
        v = (v << 8) | int64(BytesGet(data, offset + i))
    return Ok[int64](v)

fn appendVarBytes(buf: var GrowByteBuffer, data: Bytes) =
    appendBytes(buf, encodeUVarint(BytesLen(data)))
    appendBytes(buf, data)

fn decodeVarBytes(data: Bytes, offset: var int32): Result[Bytes] =
    let lenRes: Result[VarintDecoded] = decodeUVarint(data, offset)
    if IsErr(lenRes):
        return Err[Bytes](Error(lenRes))
    let length: int32 = int32(Value(lenRes).value)
    offset = Value(lenRes).next
    if length < 0 || offset + length > BytesLen(data):
        return Err[Bytes]("tls: var bytes out of range")
    let out: Bytes = BytesSlice(data, offset, length)
    offset = offset + length
    return Ok[Bytes](out)

fn encodeCertificate(cert: P2pCertificate): Bytes =
    var buf: GrowByteBuffer = newByteBuffer()
    appendBytes(buf, BytesFromString(certMagic))
    appendVarBytes(buf, cert.pubKeyDer)
    appendVarBytes(buf, cert.extension.publicKey)
    appendVarBytes(buf, cert.extension.signature)
    appendBytes(buf, int64ToBytesBE(cert.validFrom))
    appendBytes(buf, int64ToBytesBE(cert.validTo))
    return toBytes(buf)

fn decodeCertificate(data: Bytes): Result[P2pCertificate] =
    if BytesLen(data) < certMagicLen:
        return Err[P2pCertificate]("tls: certificate too short")
    let magic: Bytes = BytesSlice(data, 0, certMagicLen)
    if ! BytesEqual(magic, BytesFromString(certMagic)):
        return Err[P2pCertificate]("tls: invalid certificate magic")
    var offset: int32 = certMagicLen
    let pubRes: Result[Bytes] = decodeVarBytes(data, offset)
    if IsErr(pubRes):
        return Err[P2pCertificate](Error(pubRes))
    let idRes: Result[Bytes] = decodeVarBytes(data, offset)
    if IsErr(idRes):
        return Err[P2pCertificate](Error(idRes))
    let sigRes: Result[Bytes] = decodeVarBytes(data, offset)
    if IsErr(sigRes):
        return Err[P2pCertificate](Error(sigRes))
    let fromRes: Result[int64] = bytesToInt64BE(data, offset)
    if IsErr(fromRes):
        return Err[P2pCertificate](Error(fromRes))
    offset = offset + 8
    let toRes: Result[int64] = bytesToInt64BE(data, offset)
    if IsErr(toRes):
        return Err[P2pCertificate](Error(toRes))
    let cert: P2pCertificate = P2pCertificate(
        extension: P2pExtension(publicKey: Value(idRes), signature: Value(sigRes)),
        pubKeyDer: Value(pubRes),
        validFrom: Value(fromRes),
        validTo: Value(toRes)
    )
    return Ok[P2pCertificate](cert)

fn publicKey(cert: P2pCertificate): Result[PublicKey] =
    return decodePublicKey(cert.extension.publicKey)

fn peerId(cert: P2pCertificate): Result[PeerId] =
    let pubRes: Result[PublicKey] = publicKey(cert)
    if IsErr(pubRes):
        return Err[PeerId](Error(pubRes))
    return peerIdFromPublicKey(Value(pubRes))

fn generateX509(
    identityKeyPair: KeyPair,
    validFrom: int64,
    validTo: int64,
    encodingFormat: EncodingFormat
): Result[CertificateX509] =
    encodingFormat
    let certKeyRes: Result[KeyPair] = generateKeyPair()
    if IsErr(certKeyRes):
        return Err[CertificateX509](Error(certKeyRes))
    let certPubRes: Result[Bytes] = encodePublicKey(Value(certKeyRes).publicKey)
    if IsErr(certPubRes):
        return Err[CertificateX509](Error(certPubRes))
    let msg: Bytes = makeSignatureMessage(Value(certPubRes))
    let sigRes: Result[Signature] = sign(identityKeyPair.privateKey, msg)
    if IsErr(sigRes):
        return Err[CertificateX509](Error(sigRes))
    let identPubRes: Result[Bytes] = encodePublicKey(identityKeyPair.publicKey)
    if IsErr(identPubRes):
        return Err[CertificateX509](Error(identPubRes))
    let cert: P2pCertificate = P2pCertificate(
        extension: P2pExtension(publicKey: Value(identPubRes), signature: Value(sigRes).data),
        pubKeyDer: Value(certPubRes),
        validFrom: validFrom,
        validTo: validTo
    )
    let certBytes: Bytes = encodeCertificate(cert)
    let privRes: Result[Bytes] = encodePrivateKey(Value(certKeyRes).privateKey)
    if IsErr(privRes):
        return Err[CertificateX509](Error(privRes))
    return Ok[CertificateX509](CertificateX509(certificate: certBytes, privateKey: Value(privRes)))

fn generateX509(identityKeyPair: KeyPair): Result[CertificateX509] =
    let now: int64 = epochTimeSeconds()
    let from: int64 = now - 60
    let to: int64 = now + 31536000
    return generateX509(identityKeyPair, from, to, DER)

fn parse(certificateDer: Bytes): Result[P2pCertificate] =
    return decodeCertificate(certificateDer)

fn verify(self: P2pCertificate): bool =
    let now: int64 = epochTimeSeconds()
    if self.validFrom > 0 && now < self.validFrom:
        return false
    if self.validTo > 0 && now >= self.validTo:
        return false
    let pubRes: Result[PublicKey] = decodePublicKey(self.extension.publicKey)
    if IsErr(pubRes):
        return false
    let pub: PublicKey = Value(pubRes)
    let sig: Signature = Signature(keyType: pub.keyType, data: self.extension.signature)
    if ! validateSignature(sig):
        return false
    let msg: Bytes = makeSignatureMessage(self.pubKeyDer)
    return verify(pub, msg, sig)
