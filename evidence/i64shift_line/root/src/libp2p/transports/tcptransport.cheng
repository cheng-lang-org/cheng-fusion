# TCP transport(minimal, synchronous stub).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection as streamconn
import std/net/memorymanager
import std/seqs
type
    TcpTransport =
        running: bool
        addr: multiaddress.MultiAddress
        hasAddr: bool
        listenerId: int32

    TcpListener =
        addr: multiaddress.MultiAddress
        active: bool
        pending: streamconn.ConnectionQueue

const
    maxTcpListeners = 16

var
    tcpListeners: TcpListener[]

fn ensureTcpListeners() =
    if len(tcpListeners) < maxTcpListeners:
        setLen(tcpListeners, maxTcpListeners)

fn tcpListenerValid(idx: int32): bool =
    idx >= 0 && idx < maxTcpListeners

fn initTcpTransport(): TcpTransport =
    TcpTransport(running: false, hasAddr: false, listenerId: -1)

@borrows
fn findTcpListener(addr: multiaddress.MultiAddress): int32 =
    ensureTcpListeners()
    for i in 0..<maxTcpListeners:
        if tcpListeners[i].active && BytesEqual(addr.data, tcpListeners[i].addr.data):
            return i
    return -1

@borrows
fn findTcpListenerByRaw(addrText: str): int32 =
    ensureTcpListeners()
    var i: int32
    while i < maxTcpListeners:
        if tcpListeners[i].active && tcpListeners[i].addr.raw == addrText:
            return i
        i = i + 1
    return -1

fn registerTcpListenerByRaw(addrText: str): int32 =
    ensureTcpListeners()
    let existing: int32 = findTcpListenerByRaw(addrText)
    if existing >= 0:
        return existing
    var i: int32
    while i < maxTcpListeners:
        if !tcpListeners[i].active:
            tcpListeners[i].active = true
            tcpListeners[i].addr.raw = strings.CloneStr(addrText)
            tcpListeners[i].pending = streamconn.initConnectionQueue()
            return i
        i = i + 1
    return -1

fn startRaw(t: var TcpTransport, addrText: str) =
    t.addr.raw = strings.CloneStr(addrText)
    t.hasAddr = true
    t.listenerId = registerTcpListenerByRaw(addrText)
    t.running = t.listenerId >= 0

fn registerTcpListener(addr: multiaddress.MultiAddress): int32 =
    ensureTcpListeners()
    let existing: int32 = findTcpListener(addr)
    if existing >= 0:
        return existing
    for i in 0..<maxTcpListeners:
        if !tcpListeners[i].active:
            tcpListeners[i].active = true
            tcpListeners[i].addr.raw = strings.CloneStr(addr.raw)
            tcpListeners[i].pending = streamconn.initConnectionQueue()
            return i
    return -1

fn unregisterTcpListener(id: int32) =
    if !tcpListenerValid(id):
        return
    var listener: TcpListener = tcpListeners[id]
    while ! streamconn.connectionQueueIsEmpty(listener.pending):
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            break
        var conn: streamconn.Connection = Value(connRes)
        if conn.queueReserved && conn.queueReservedBytes > 0:
            memorymanager.releaseMemory(conn.queueReservedBytes)
            streamconn.clearQueueReservation(conn)
        streamconn.close(conn)
    listener.active = false
    listener.pending = streamconn.initConnectionQueue()
    tcpListeners[id] = listener

fn dropTcpListenerByPipe(id: int32, pipeIdx: int32): Result[bool] =
    if !tcpListenerValid(id):
        return Err[bool]("tcp: invalid listener")
    var listener: TcpListener = tcpListeners[id]
    if !listener.active:
        return Err[bool]("tcp: listener ! active")
    let total: int32 = listener.pending.count
    var found: bool
    for processed in 0..<total:
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            tcpListeners[id] = listener
            return Err[bool](Error(connRes))
        var conn: streamconn.Connection = Value(connRes)
        if !found && conn.pipeIdx == pipeIdx:
            if conn.queueReserved && conn.queueReservedBytes > 0:
                memorymanager.releaseMemory(conn.queueReservedBytes)
                streamconn.clearQueueReservation(conn)
            streamconn.close(conn)
            found = true
        else:
            let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, conn)
            if IsErr(enqRes):
                tcpListeners[id] = listener
                return Err[bool](Error(enqRes))
    tcpListeners[id] = listener
    return Ok[bool](found)

fn dropTcpPendingByPipe(t: TcpTransport, addr: multiaddress.MultiAddress, pipeIdx: int32): Result[bool] =
    t
    let listenerId: int32 = findTcpListener(addr)
    if listenerId < 0:
        return Ok[bool](false)
    return dropTcpListenerByPipe(listenerId, pipeIdx)

fn tcpListenerEnqueue(listener: var TcpListener, conn: streamconn.Connection): Result[bool] =
    if !listener.active:
        return Err[bool]("tcp: listener ! active")
    let memBytes: int64 = streamconn.connectionQueueFootprintBytes(conn)
    let reserveRes: Result[bool] = memorymanager.reserveMemory(memBytes)
    if IsErr(reserveRes):
        return Err[bool](Error(reserveRes))
    let reserved: bool = Value(reserveRes)
    var queued: streamconn.Connection = conn
    if reserved:
        queued.queueReserved = true
        queued.queueReservedBytes = memBytes
    else:
        queued.queueReserved = false
        queued.queueReservedBytes = 0
    let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, queued)
    if IsErr(enqRes):
        if reserved:
            memorymanager.releaseMemory(memBytes)
        return Err[bool](Error(enqRes))
    return Ok[bool](true)

fn enqueueTcpListener(id: int32, conn: streamconn.Connection): Result[bool] =
    if !tcpListenerValid(id):
        return Err[bool]("tcp: invalid listener")
    return tcpListenerEnqueue(tcpListeners[id], conn)

fn dequeueTcpListener(id: int32): Result[streamconn.Connection] =
    if !tcpListenerValid(id):
        return Err[streamconn.Connection]("tcp: invalid listener")
    var listener: TcpListener = tcpListeners[id]
    if !listener.active:
        return Err[streamconn.Connection]("tcp: listener ! active")
    let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
    if IsErr(connRes):
        tcpListeners[id] = listener
        return Err[streamconn.Connection](Error(connRes))
    var conn: streamconn.Connection = Value(connRes)
    if conn.queueReserved && conn.queueReservedBytes > 0:
        let relRes: Result[bool] = memorymanager.releaseMemory(conn.queueReservedBytes)
        if IsErr(relRes):
            tcpListeners[id] = listener
            return Err[streamconn.Connection](Error(relRes))
        streamconn.clearQueueReservation(conn)
    tcpListeners[id] = listener
    return Ok[streamconn.Connection](conn)

fn start(t: var TcpTransport, addr: multiaddress.MultiAddress) =
    t.addr.raw = strings.CloneStr(addr.raw)
    t.hasAddr = true
    t.listenerId = registerTcpListener(addr)
    t.running = t.listenerId >= 0

fn stop(t: var TcpTransport) =
    t.running = false
    if t.listenerId >= 0:
        unregisterTcpListener(t.listenerId)
    t.listenerId = -1

fn accept(t: var TcpTransport): Result[streamconn.Connection] =
    if ! t.running:
        return Err[streamconn.Connection]("tcp: ! running")
    let connRes: Result[streamconn.Connection] = dequeueTcpListener(t.listenerId)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    return connRes

@borrows
fn dialRawOk(t: var TcpTransport, addrText: str): Result[bool] =
    if !t.running:
        return Err[bool]("tcp: ! running")
    let listenerId: int32 = findTcpListenerByRaw(addrText)
    if listenerId < 0:
        return Err[bool]("tcp: no listener")
    let pipeRes: Result[int32] = streamconn.allocPipe()
    if IsErr(pipeRes):
        return Err[bool](Error(pipeRes))
    let idx: int32 = Value(pipeRes)
    var inbound: streamconn.Connection
    inbound.dir = streamconn.Inbound
    inbound.open = true
    inbound.pipeIdx = idx
    inbound.pipeSide = 1
    inbound.accounting = true
    inbound.localAddr.raw = strings.CloneStr(addrText)
    inbound.remoteAddr.raw = strings.CloneStr(addrText)
    let enqRes: Result[bool] = enqueueTcpListener(listenerId, inbound)
    if IsErr(enqRes):
        streamconn.pipeClose(idx)
        return Err[bool](Error(enqRes))
    return Ok[bool](true)

fn dial(t: var TcpTransport, addr: multiaddress.MultiAddress): Result[streamconn.Connection] =
    if ! handles(t, addr):
        return Err[streamconn.Connection]("tcp: unsupported address")
    var localAddr: multiaddress.MultiAddress = addr
    if t.hasAddr:
        localAddr = t.addr
    let listenerId: int32 = findTcpListener(addr)
    if listenerId < 0:
        return Err[streamconn.Connection]("tcp: no listener")
    let pairRes: Result[streamconn.ConnectionPair] = streamconn.newConnectionPair(localAddr, addr, addr, localAddr)
    if IsErr(pairRes):
        return Err[streamconn.Connection](Error(pairRes))
    let pair = Value(pairRes)
    let enqRes: Result[bool] = enqueueTcpListener(listenerId, pair.inbound)
    if IsErr(enqRes):
        var outConn: streamconn.Connection = pair.outbound
        var inConn: streamconn.Connection = pair.inbound
        streamconn.close(outConn)
        streamconn.close(inConn)
        return Err[streamconn.Connection](Error(enqRes))
    return Ok[streamconn.Connection](pair.outbound)

fn handles(t: TcpTransport, addr: multiaddress.MultiAddress): bool =
    t
    let text: str = lpMultiAddressToString(addr)
    if ! StrContains(text, "/tcp/"):
        return false
    if StrContains(text, "/wss") || StrContains(text, "/ws"):
        return false
    if StrContains(text, "/ip4/") || StrContains(text, "/ip6/"):
        return true
    if StrContains(text, "/dns/") || StrContains(text, "/dns4/") || StrContains(text, "/dns6/"):
        return true
    return false
