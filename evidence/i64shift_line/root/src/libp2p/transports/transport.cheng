# Transport abstraction(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection
type
    Transport =
        running: bool
        addr: MultiAddress
        hasAddr: bool

fn initTransport(): Transport =
    Transport(running: false, hasAddr: false)

fn start(t: var Transport, addr: MultiAddress) =
    t.addr = addr
    t.hasAddr = true
    t.running = true

fn stop(t: var Transport) =
    t.running = false

fn accept(t: var Transport): Result[Connection] =
    t
    return Err[Connection]("transport: accept ! implemented")

fn dial(t: var Transport, addr: MultiAddress): Result[Connection] =
    t
    addr
    return Err[Connection]("transport: dial ! implemented")

fn handles(t: Transport, addr: MultiAddress): bool =
    t
    addr
    return false
