# WebRTC direct transport(minimal, synchronous stub).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection as streamconn
import std/net/memorymanager
type
    WebrtcDirectTransport =
        running: bool
        addr: multiaddress.MultiAddress
        hasAddr: bool
        listenerId: int32

    WebrtcDirectListener =
        addr: multiaddress.MultiAddress
        active: bool
        pending: streamconn.ConnectionQueue

const
    maxWebrtcDirectListeners = 16

var
    webrtcDirectListeners: WebrtcDirectListener[maxWebrtcDirectListeners]

fn webrtcDirectListenerValid(idx: int32): bool =
    idx >= 0 && idx < maxWebrtcDirectListeners

fn initWebrtcDirectTransport(): WebrtcDirectTransport =
    WebrtcDirectTransport(running: false, hasAddr: false, listenerId: -1)

@borrows
fn findWebrtcDirectListener(addr: multiaddress.MultiAddress): int32 =
    let addrBytes: Bytes = addr.data
    for i in 0..<maxWebrtcDirectListeners:
        let listener: WebrtcDirectListener = webrtcDirectListeners[i]
        if listener.active && BytesEqual(addrBytes, listener.addr.data):
            return i
    return -1

fn registerWebrtcDirectListener(addr: multiaddress.MultiAddress): int32 =
    let existing: int32 = findWebrtcDirectListener(addr)
    if existing >= 0:
        return existing
    for i in 0..<maxWebrtcDirectListeners:
        var listener: WebrtcDirectListener = webrtcDirectListeners[i]
        if !listener.active:
            listener.active = true
            listener.addr = addr
            listener.pending = streamconn.initConnectionQueue()
            webrtcDirectListeners[i] = listener
            return i
    return -1

fn unregisterWebrtcDirectListener(id: int32) =
    if !webrtcDirectListenerValid(id):
        return
    var listener: WebrtcDirectListener = webrtcDirectListeners[id]
    while ! streamconn.connectionQueueIsEmpty(listener.pending):
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            break
        var conn: streamconn.Connection = Value(connRes)
        if conn.queueReserved && conn.queueReservedBytes > 0:
            memorymanager.releaseMemory(conn.queueReservedBytes)
            streamconn.clearQueueReservation(conn)
        streamconn.close(conn)
    listener.active = false
    listener.pending = streamconn.initConnectionQueue()
    webrtcDirectListeners[id] = listener

fn dropWebrtcDirectListenerByPipe(id: int32, pipeIdx: int32): Result[bool] =
    if !webrtcDirectListenerValid(id):
        return Err[bool]("webrtc direct: invalid listener")
    var listener: WebrtcDirectListener = webrtcDirectListeners[id]
    if !listener.active:
        return Err[bool]("webrtc direct: listener ! active")
    let total: int32 = listener.pending.count
    var found: bool
    for processed in 0..<total:
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            webrtcDirectListeners[id] = listener
            return Err[bool](Error(connRes))
        var conn: streamconn.Connection = Value(connRes)
        if !found && conn.pipeIdx == pipeIdx:
            if conn.queueReserved && conn.queueReservedBytes > 0:
                memorymanager.releaseMemory(conn.queueReservedBytes)
                streamconn.clearQueueReservation(conn)
            streamconn.close(conn)
            found = true
        else:
            let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, conn)
            if IsErr(enqRes):
                webrtcDirectListeners[id] = listener
                return Err[bool](Error(enqRes))
    webrtcDirectListeners[id] = listener
    return Ok[bool](found)

fn dropWebrtcDirectPendingByPipe(t: WebrtcDirectTransport, addr: multiaddress.MultiAddress, pipeIdx: int32): Result[bool] =
    t
    let listenerId: int32 = findWebrtcDirectListener(addr)
    if listenerId < 0:
        return Ok[bool](false)
    return dropWebrtcDirectListenerByPipe(listenerId, pipeIdx)

fn enqueueWebrtcDirectListener(id: int32, conn: streamconn.Connection): Result[bool] =
    if !webrtcDirectListenerValid(id):
        return Err[bool]("webrtc direct: invalid listener")
    var listener: WebrtcDirectListener = webrtcDirectListeners[id]
    if !listener.active:
        return Err[bool]("webrtc direct: listener ! active")
    let memBytes: int64 = streamconn.connectionQueueFootprintBytes(conn)
    let reserveRes: Result[bool] = memorymanager.reserveMemory(memBytes)
    if IsErr(reserveRes):
        return Err[bool](Error(reserveRes))
    let reserved: bool = Value(reserveRes)
    var queued: streamconn.Connection = conn
    if reserved:
        queued.queueReserved = true
        queued.queueReservedBytes = memBytes
    else:
        queued.queueReserved = false
        queued.queueReservedBytes = 0
    let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, queued)
    if IsErr(enqRes):
        if reserved:
            memorymanager.releaseMemory(memBytes)
        webrtcDirectListeners[id] = listener
        return Err[bool](Error(enqRes))
    webrtcDirectListeners[id] = listener
    return Ok[bool](true)

fn dequeueWebrtcDirectListener(id: int32): Result[streamconn.Connection] =
    if !webrtcDirectListenerValid(id):
        return Err[streamconn.Connection]("webrtc direct: invalid listener")
    var listener: WebrtcDirectListener = webrtcDirectListeners[id]
    if !listener.active:
        return Err[streamconn.Connection]("webrtc direct: listener ! active")
    let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
    if IsErr(connRes):
        webrtcDirectListeners[id] = listener
        return Err[streamconn.Connection](Error(connRes))
    var conn: streamconn.Connection = Value(connRes)
    if conn.queueReserved && conn.queueReservedBytes > 0:
        let relRes: Result[bool] = memorymanager.releaseMemory(conn.queueReservedBytes)
        if IsErr(relRes):
            webrtcDirectListeners[id] = listener
            return Err[streamconn.Connection](Error(relRes))
        streamconn.clearQueueReservation(conn)
    webrtcDirectListeners[id] = listener
    return Ok[streamconn.Connection](conn)

fn start(t: var WebrtcDirectTransport, addr: multiaddress.MultiAddress) =
    t.addr.raw = strings.CloneStr(addr.raw)
    t.hasAddr = true
    t.listenerId = registerWebrtcDirectListener(addr)
    t.running = t.listenerId >= 0

fn stop(t: var WebrtcDirectTransport) =
    t.running = false
    if t.listenerId >= 0:
        unregisterWebrtcDirectListener(t.listenerId)
    t.listenerId = -1

fn accept(t: var WebrtcDirectTransport): Result[streamconn.Connection] =
    if ! t.running:
        return Err[streamconn.Connection]("webrtc direct: ! running")
    let connRes: Result[streamconn.Connection] = dequeueWebrtcDirectListener(t.listenerId)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    return connRes

fn dial(t: var WebrtcDirectTransport, addr: multiaddress.MultiAddress): Result[streamconn.Connection] =
    if ! handles(t, addr):
        return Err[streamconn.Connection]("webrtc direct: unsupported address")
    var localAddr: multiaddress.MultiAddress = addr
    if t.hasAddr:
        localAddr = t.addr
    let listenerId: int32 = findWebrtcDirectListener(addr)
    if listenerId < 0:
        return Err[streamconn.Connection]("webrtc direct: no listener")
    let pairRes: Result[streamconn.ConnectionPair] = (
        streamconn.newConnectionPair(localAddr, addr, addr, localAddr)
    )
    if IsErr(pairRes):
        return Err[streamconn.Connection](Error(pairRes))
    let pair = Value(pairRes)
    let enqRes: Result[bool] = enqueueWebrtcDirectListener(listenerId, pair.inbound)
    if IsErr(enqRes):
        var outConn: streamconn.Connection = pair.outbound
        var inConn: streamconn.Connection = pair.inbound
        streamconn.close(outConn)
        streamconn.close(inConn)
        return Err[streamconn.Connection](Error(enqRes))
    return Ok[streamconn.Connection](pair.outbound)

fn handles(t: WebrtcDirectTransport, addr: multiaddress.MultiAddress): bool =
    t
    let text: str = lpMultiAddressToString(addr)
    if ! StrContains(text, "/webrtc-direct") && ! StrContains(text, "/p2p-webrtc-direct"):
        return false
    if ! StrContains(text, "/udp/"):
        return false
    if StrContains(text, "/ip4/") || StrContains(text, "/ip6/"):
        return true
    if StrContains(text, "/dns/") || StrContains(text, "/dns4/") || StrContains(text, "/dns6/"):
        return true
    return false
