# WebSocket transport(minimal, synchronous stub).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection as streamconn
import std/net/memorymanager
type
    WsTransport =
        running: bool
        addr: multiaddress.MultiAddress
        hasAddr: bool
        listenerId: int32

    WsListener =
        addr: multiaddress.MultiAddress
        active: bool
        pending: streamconn.ConnectionQueue

const
    maxWsListeners = 16

var
    wsListeners: WsListener[maxWsListeners]

fn wsListenerValid(idx: int32): bool =
    idx >= 0 && idx < maxWsListeners

fn initWsTransport(): WsTransport =
    WsTransport(running: false, hasAddr: false, listenerId: -1)

fn wsListenerMatches(listener: var WsListener, addrBytes: Bytes): bool =
    if !listener.active:
        return false
    return BytesEqual(addrBytes, listener.addr.data)

@borrows
fn findWsListener(addr: multiaddress.MultiAddress): int32 =
    let addrBytes: Bytes = addr.data
    for i in 0..<maxWsListeners:
        if wsListenerMatches(wsListeners[i], addrBytes):
            return i
    return -1

fn wsListenerIsActive(listener: var WsListener): bool =
    return listener.active

fn wsListenerResetPending(listener: var WsListener) =
    listener.pending.count = 0
    listener.pending.head = 0
    listener.pending.tail = 0

fn wsListenerActivate(listener: var WsListener, addr: multiaddress.MultiAddress) =
    listener.active = true
    listener.addr = addr
    wsListenerResetPending(listener)

fn registerWsListener(addr: multiaddress.MultiAddress): int32 =
    let existing: int32 = findWsListener(addr)
    if existing >= 0:
        return existing
    for i in 0..<maxWsListeners:
        if ! wsListenerIsActive(wsListeners[i]):
            wsListenerActivate(wsListeners[i], addr)
            return i
    return -1

fn wsListenerDeactivate(listener: var WsListener) =
    while listener.pending.count > 0:
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            break
        var conn: streamconn.Connection = Value(connRes)
        if conn.queueReserved && conn.queueReservedBytes > 0:
            memorymanager.releaseMemory(conn.queueReservedBytes)
            streamconn.clearQueueReservation(conn)
        streamconn.close(conn)
    listener.active = false
    wsListenerResetPending(listener)

fn unregisterWsListener(id: int32) =
    if !wsListenerValid(id):
        return
    wsListenerDeactivate(wsListeners[id])

fn wsListenerDropByPipe(listener: var WsListener, pipeIdx: int32): Result[bool] =
    if !listener.active:
        return Err[bool]("ws: listener ! active")
    let total: int32 = listener.pending.count
    var found: bool
    for processed in 0..<total:
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            return Err[bool](Error(connRes))
        var conn: streamconn.Connection = Value(connRes)
        if !found && conn.pipeIdx == pipeIdx:
            if conn.queueReserved && conn.queueReservedBytes > 0:
                memorymanager.releaseMemory(conn.queueReservedBytes)
                streamconn.clearQueueReservation(conn)
            streamconn.close(conn)
            found = true
        else:
            let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, conn)
            if IsErr(enqRes):
                return Err[bool](Error(enqRes))
    return Ok[bool](found)

fn dropWsListenerByPipe(id: int32, pipeIdx: int32): Result[bool] =
    if !wsListenerValid(id):
        return Err[bool]("ws: invalid listener")
    return wsListenerDropByPipe(wsListeners[id], pipeIdx)

fn dropWsPendingByPipe(t: WsTransport, addr: multiaddress.MultiAddress, pipeIdx: int32): Result[bool] =
    t
    let listenerId: int32 = findWsListener(addr)
    if listenerId < 0:
        return Ok[bool](false)
    return dropWsListenerByPipe(listenerId, pipeIdx)

fn wsListenerEnqueue(listener: var WsListener, conn: streamconn.Connection): Result[bool] =
    if !listener.active:
        return Err[bool]("ws: listener ! active")
    let memBytes: int64 = streamconn.connectionQueueFootprintBytes(conn)
    let reserveRes: Result[bool] = memorymanager.reserveMemory(memBytes)
    if IsErr(reserveRes):
        return Err[bool](Error(reserveRes))
    let reserved: bool = Value(reserveRes)
    var queued: streamconn.Connection = conn
    if reserved:
        queued.queueReserved = true
        queued.queueReservedBytes = memBytes
    else:
        queued.queueReserved = false
        queued.queueReservedBytes = 0
    let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, queued)
    if IsErr(enqRes):
        if reserved:
            memorymanager.releaseMemory(memBytes)
        return Err[bool](Error(enqRes))
    return Ok[bool](true)

fn enqueueWsListener(id: int32, conn: streamconn.Connection): Result[bool] =
    if !wsListenerValid(id):
        return Err[bool]("ws: invalid listener")
    return wsListenerEnqueue(wsListeners[id], conn)

fn wsListenerDequeue(listener: var WsListener): Result[streamconn.Connection] =
    if !listener.active:
        return Err[streamconn.Connection]("ws: listener ! active")
    let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    var conn: streamconn.Connection = Value(connRes)
    if conn.queueReserved && conn.queueReservedBytes > 0:
        let relRes: Result[bool] = memorymanager.releaseMemory(conn.queueReservedBytes)
        if IsErr(relRes):
            return Err[streamconn.Connection](Error(relRes))
        streamconn.clearQueueReservation(conn)
    return Ok[streamconn.Connection](conn)

fn dequeueWsListener(id: int32): Result[streamconn.Connection] =
    if !wsListenerValid(id):
        return Err[streamconn.Connection]("ws: invalid listener")
    return wsListenerDequeue(wsListeners[id])

fn start(t: var WsTransport, addr: multiaddress.MultiAddress) =
    t.addr.raw = strings.CloneStr(addr.raw)
    t.hasAddr = true
    t.listenerId = registerWsListener(addr)
    t.running = t.listenerId >= 0

fn stop(t: var WsTransport) =
    t.running = false
    if t.listenerId >= 0:
        unregisterWsListener(t.listenerId)
    t.listenerId = -1

fn accept(t: var WsTransport): Result[streamconn.Connection] =
    if ! t.running:
        return Err[streamconn.Connection]("ws: ! running")
    let connRes: Result[streamconn.Connection] = dequeueWsListener(t.listenerId)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    return connRes

fn dial(t: var WsTransport, addr: multiaddress.MultiAddress): Result[streamconn.Connection] =
    if ! handles(t, addr):
        return Err[streamconn.Connection]("ws: unsupported address")
    var localAddr: multiaddress.MultiAddress = addr
    if t.hasAddr:
        localAddr = t.addr
    let listenerId: int32 = findWsListener(addr)
    if listenerId < 0:
        return Err[streamconn.Connection]("ws: no listener")
    let pairRes: Result[streamconn.ConnectionPair] = streamconn.newConnectionPair(localAddr, addr, addr, localAddr)
    if IsErr(pairRes):
        return Err[streamconn.Connection](Error(pairRes))
    let pair = Value(pairRes)
    let enqRes: Result[bool] = enqueueWsListener(listenerId, pair.inbound)
    if IsErr(enqRes):
        var outConn: streamconn.Connection = pair.outbound
        var inConn: streamconn.Connection = pair.inbound
        streamconn.close(outConn)
        streamconn.close(inConn)
        return Err[streamconn.Connection](Error(enqRes))
    return Ok[streamconn.Connection](pair.outbound)

fn handles(t: WsTransport, addr: multiaddress.MultiAddress): bool =
    t
    let text: str = lpMultiAddressToString(addr)
    if ! StrContains(text, "/tcp/"):
        return false
    if ! (StrContains(text, "/wss") || StrContains(text, "/ws")):
        return false
    if StrContains(text, "/ip4/") || StrContains(text, "/ip6/"):
        return true
    if StrContains(text, "/dns/") || StrContains(text, "/dns4/") || StrContains(text, "/dns6/"):
        return true
    return false
