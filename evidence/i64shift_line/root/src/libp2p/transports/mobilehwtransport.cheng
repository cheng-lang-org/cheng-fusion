# Mobile hardware transport(minimal, synchronous stub).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection as streamconn
import std/net/memorymanager

type
    MobileHwTransport =
        running: bool
        addr: multiaddress.MultiAddress
        hasAddr: bool
        listenerId: int32

const
    maxMobileHwListeners = 8

var
    mobileHwActive0: bool
    mobileHwActive1: bool
    mobileHwActive2: bool
    mobileHwActive3: bool
    mobileHwActive4: bool
    mobileHwActive5: bool
    mobileHwActive6: bool
    mobileHwActive7: bool

    mobileHwAddr0: str
    mobileHwAddr1: str
    mobileHwAddr2: str
    mobileHwAddr3: str
    mobileHwAddr4: str
    mobileHwAddr5: str
    mobileHwAddr6: str
    mobileHwAddr7: str

    mobileHwPending0: streamconn.ConnectionQueue
    mobileHwPending1: streamconn.ConnectionQueue
    mobileHwPending2: streamconn.ConnectionQueue
    mobileHwPending3: streamconn.ConnectionQueue
    mobileHwPending4: streamconn.ConnectionQueue
    mobileHwPending5: streamconn.ConnectionQueue
    mobileHwPending6: streamconn.ConnectionQueue
    mobileHwPending7: streamconn.ConnectionQueue

fn mobileHwListenerValid(idx: int32): bool =
    idx >= 0 && idx < maxMobileHwListeners

fn initMobileHwTransport(): MobileHwTransport =
    MobileHwTransport(running: false, hasAddr: false, listenerId: -1)

fn mobileHwSlotActive(id: int32): bool =
    if id == 0: return mobileHwActive0
    if id == 1: return mobileHwActive1
    if id == 2: return mobileHwActive2
    if id == 3: return mobileHwActive3
    if id == 4: return mobileHwActive4
    if id == 5: return mobileHwActive5
    if id == 6: return mobileHwActive6
    if id == 7: return mobileHwActive7
    return false

fn mobileHwSlotAddr(id: int32): str =
    if id == 0: return mobileHwAddr0
    if id == 1: return mobileHwAddr1
    if id == 2: return mobileHwAddr2
    if id == 3: return mobileHwAddr3
    if id == 4: return mobileHwAddr4
    if id == 5: return mobileHwAddr5
    if id == 6: return mobileHwAddr6
    if id == 7: return mobileHwAddr7
    return ""

fn setMobileHwSlot(id: int32, active: bool, addrText: str) =
    if id == 0:
        mobileHwActive0 = active
        mobileHwAddr0 = addrText
        return
    if id == 1:
        mobileHwActive1 = active
        mobileHwAddr1 = addrText
        return
    if id == 2:
        mobileHwActive2 = active
        mobileHwAddr2 = addrText
        return
    if id == 3:
        mobileHwActive3 = active
        mobileHwAddr3 = addrText
        return
    if id == 4:
        mobileHwActive4 = active
        mobileHwAddr4 = addrText
        return
    if id == 5:
        mobileHwActive5 = active
        mobileHwAddr5 = addrText
        return
    if id == 6:
        mobileHwActive6 = active
        mobileHwAddr6 = addrText
        return
    if id == 7:
        mobileHwActive7 = active
        mobileHwAddr7 = addrText

fn resetMobileHwQueue(id: int32) =
    if id == 0:
        mobileHwPending0 = streamconn.initConnectionQueue()
        return
    if id == 1:
        mobileHwPending1 = streamconn.initConnectionQueue()
        return
    if id == 2:
        mobileHwPending2 = streamconn.initConnectionQueue()
        return
    if id == 3:
        mobileHwPending3 = streamconn.initConnectionQueue()
        return
    if id == 4:
        mobileHwPending4 = streamconn.initConnectionQueue()
        return
    if id == 5:
        mobileHwPending5 = streamconn.initConnectionQueue()
        return
    if id == 6:
        mobileHwPending6 = streamconn.initConnectionQueue()
        return
    if id == 7:
        mobileHwPending7 = streamconn.initConnectionQueue()

fn mobileHwQueueEmpty(id: int32): bool =
    if id == 0: return streamconn.connectionQueueIsEmpty(mobileHwPending0)
    if id == 1: return streamconn.connectionQueueIsEmpty(mobileHwPending1)
    if id == 2: return streamconn.connectionQueueIsEmpty(mobileHwPending2)
    if id == 3: return streamconn.connectionQueueIsEmpty(mobileHwPending3)
    if id == 4: return streamconn.connectionQueueIsEmpty(mobileHwPending4)
    if id == 5: return streamconn.connectionQueueIsEmpty(mobileHwPending5)
    if id == 6: return streamconn.connectionQueueIsEmpty(mobileHwPending6)
    if id == 7: return streamconn.connectionQueueIsEmpty(mobileHwPending7)
    return true

fn mobileHwQueueCount(id: int32): int32 =
    if id == 0: return mobileHwPending0.count
    if id == 1: return mobileHwPending1.count
    if id == 2: return mobileHwPending2.count
    if id == 3: return mobileHwPending3.count
    if id == 4: return mobileHwPending4.count
    if id == 5: return mobileHwPending5.count
    if id == 6: return mobileHwPending6.count
    if id == 7: return mobileHwPending7.count
    return 0

fn enqueueMobileHwQueue(id: int32, conn: streamconn.Connection): Result[bool] =
    if id == 0: return streamconn.enqueueConnection(mobileHwPending0, conn)
    if id == 1: return streamconn.enqueueConnection(mobileHwPending1, conn)
    if id == 2: return streamconn.enqueueConnection(mobileHwPending2, conn)
    if id == 3: return streamconn.enqueueConnection(mobileHwPending3, conn)
    if id == 4: return streamconn.enqueueConnection(mobileHwPending4, conn)
    if id == 5: return streamconn.enqueueConnection(mobileHwPending5, conn)
    if id == 6: return streamconn.enqueueConnection(mobileHwPending6, conn)
    if id == 7: return streamconn.enqueueConnection(mobileHwPending7, conn)
    return Err[bool]("mobile_hw: invalid listener")

fn dequeueMobileHwQueue(id: int32): Result[streamconn.Connection] =
    if id == 0: return streamconn.dequeueConnection(mobileHwPending0)
    if id == 1: return streamconn.dequeueConnection(mobileHwPending1)
    if id == 2: return streamconn.dequeueConnection(mobileHwPending2)
    if id == 3: return streamconn.dequeueConnection(mobileHwPending3)
    if id == 4: return streamconn.dequeueConnection(mobileHwPending4)
    if id == 5: return streamconn.dequeueConnection(mobileHwPending5)
    if id == 6: return streamconn.dequeueConnection(mobileHwPending6)
    if id == 7: return streamconn.dequeueConnection(mobileHwPending7)
    return Err[streamconn.Connection]("mobile_hw: invalid listener")

@borrows
fn findMobileHwListener(addr: multiaddress.MultiAddress): int32 =
    let addrText: str = lpMultiAddressToString(addr)
    for i in 0..<maxMobileHwListeners:
        if mobileHwSlotActive(i) && mobileHwSlotAddr(i) == addrText:
            return i
    return -1

fn registerMobileHwListener(addr: multiaddress.MultiAddress): int32 =
    let existing: int32 = findMobileHwListener(addr)
    if existing >= 0:
        return existing
    let addrText: str = lpMultiAddressToString(addr)
    for i in 0..<maxMobileHwListeners:
        if !mobileHwSlotActive(i):
            setMobileHwSlot(i, true, addrText)
            resetMobileHwQueue(i)
            return i
    return -1

fn unregisterMobileHwListener(id: int32) =
    if !mobileHwListenerValid(id):
        return
    while !mobileHwQueueEmpty(id):
        let connRes: Result[streamconn.Connection] = dequeueMobileHwQueue(id)
        if IsErr(connRes):
            break
        var conn: streamconn.Connection = Value(connRes)
        if conn.queueReserved && conn.queueReservedBytes > 0:
            memorymanager.releaseMemory(conn.queueReservedBytes)
            streamconn.clearQueueReservation(conn)
        streamconn.close(conn)
    setMobileHwSlot(id, false, "")
    resetMobileHwQueue(id)

fn dropMobileHwListenerByPipe(id: int32, pipeIdx: int32): Result[bool] =
    if !mobileHwListenerValid(id):
        return Err[bool]("mobile_hw: invalid listener")
    if !mobileHwSlotActive(id):
        return Err[bool]("mobile_hw: listener ! active")
    let total: int32 = mobileHwQueueCount(id)
    var found: bool
    for _ in 0..<total:
        let connRes: Result[streamconn.Connection] = dequeueMobileHwQueue(id)
        if IsErr(connRes):
            return Err[bool](Error(connRes))
        var conn: streamconn.Connection = Value(connRes)
        if !found && conn.pipeIdx == pipeIdx:
            if conn.queueReserved && conn.queueReservedBytes > 0:
                memorymanager.releaseMemory(conn.queueReservedBytes)
                streamconn.clearQueueReservation(conn)
            streamconn.close(conn)
            found = true
        else:
            let enqRes: Result[bool] = enqueueMobileHwQueue(id, conn)
            if IsErr(enqRes):
                return Err[bool](Error(enqRes))
    return Ok[bool](found)

fn dropPending(t: MobileHwTransport, addr: multiaddress.MultiAddress, pipeIdx: int32): Result[bool] =
    t
    let listenerId: int32 = findMobileHwListener(addr)
    if listenerId < 0:
        return Ok[bool](false)
    return dropMobileHwListenerByPipe(listenerId, pipeIdx)

fn enqueueMobileHwListener(id: int32, conn: streamconn.Connection): Result[bool] =
    if !mobileHwListenerValid(id):
        return Err[bool]("mobile_hw: invalid listener")
    if !mobileHwSlotActive(id):
        return Err[bool]("mobile_hw: listener ! active")
    let memBytes: int64 = streamconn.connectionQueueFootprintBytes(conn)
    let reserveRes: Result[bool] = memorymanager.reserveMemory(memBytes)
    if IsErr(reserveRes):
        return Err[bool](Error(reserveRes))
    let reserved: bool = Value(reserveRes)
    var queued: streamconn.Connection = conn
    if reserved:
        queued.queueReserved = true
        queued.queueReservedBytes = memBytes
    else:
        queued.queueReserved = false
        queued.queueReservedBytes = 0
    let enqRes: Result[bool] = enqueueMobileHwQueue(id, queued)
    if IsErr(enqRes):
        if reserved:
            memorymanager.releaseMemory(memBytes)
        return Err[bool](Error(enqRes))
    return Ok[bool](true)

fn dequeueMobileHwListener(id: int32): Result[streamconn.Connection] =
    if !mobileHwListenerValid(id):
        return Err[streamconn.Connection]("mobile_hw: invalid listener")
    if !mobileHwSlotActive(id):
        return Err[streamconn.Connection]("mobile_hw: listener ! active")
    let connRes: Result[streamconn.Connection] = dequeueMobileHwQueue(id)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    var conn: streamconn.Connection = Value(connRes)
    if conn.queueReserved && conn.queueReservedBytes > 0:
        let relRes: Result[bool] = memorymanager.releaseMemory(conn.queueReservedBytes)
        if IsErr(relRes):
            return Err[streamconn.Connection](Error(relRes))
        streamconn.clearQueueReservation(conn)
    return Ok[streamconn.Connection](conn)

fn start(t: var MobileHwTransport, addr: multiaddress.MultiAddress) =
    t.addr.raw = strings.CloneStr(addr.raw)
    t.hasAddr = true
    t.listenerId = registerMobileHwListener(addr)
    t.running = t.listenerId >= 0

fn stop(t: var MobileHwTransport) =
    t.running = false
    if t.listenerId >= 0:
        unregisterMobileHwListener(t.listenerId)
    t.listenerId = -1

fn accept(t: var MobileHwTransport): Result[streamconn.Connection] =
    if !t.running:
        return Err[streamconn.Connection]("mobile_hw: ! running")
    let connRes: Result[streamconn.Connection] = dequeueMobileHwListener(t.listenerId)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    return connRes

fn dial(t: var MobileHwTransport, addr: multiaddress.MultiAddress): Result[streamconn.Connection] =
    if !handles(t, addr):
        return Err[streamconn.Connection]("mobile_hw: unsupported address")
    var localAddr: multiaddress.MultiAddress = addr
    if t.hasAddr:
        localAddr = t.addr
    let listenerId: int32 = findMobileHwListener(addr)
    if listenerId < 0:
        return Err[streamconn.Connection]("mobile_hw: no listener")
    let pairRes: Result[streamconn.ConnectionPair] = streamconn.newConnectionPair(localAddr, addr, addr, localAddr)
    if IsErr(pairRes):
        return Err[streamconn.Connection](Error(pairRes))
    let pair: streamconn.ConnectionPair = Value(pairRes)
    let enqRes: Result[bool] = enqueueMobileHwListener(listenerId, pair.inbound)
    if IsErr(enqRes):
        var outConn: streamconn.Connection = pair.outbound
        var inConn: streamconn.Connection = pair.inbound
        streamconn.close(outConn)
        streamconn.close(inConn)
        return Err[streamconn.Connection](Error(enqRes))
    return Ok[streamconn.Connection](pair.outbound)

fn handles(t: MobileHwTransport, addr: multiaddress.MultiAddress): bool =
    t
    let text: str = lpMultiAddressToString(addr)
    if len(text) <= 0:
        return false
    if StrContains(text, "/awdl/"):
        return true
    if StrContains(text, "/nan/"):
        return true
    if StrContains(text, "/nearlink/"):
        return true
    if StrContains(text, "/nearfield/"):
        return true
    return false
