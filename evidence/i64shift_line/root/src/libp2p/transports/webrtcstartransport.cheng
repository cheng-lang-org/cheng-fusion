# WebRTC star transport(minimal, synchronous stub).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection as streamconn
import std/net/memorymanager
type
    WebrtcStarTransport =
        running: bool
        addr: multiaddress.MultiAddress
        hasAddr: bool
        listenerId: int32

    WebrtcStarListener =
        addr: multiaddress.MultiAddress
        active: bool
        pending: streamconn.ConnectionQueue

const
    maxWebrtcStarListeners = 16

var
    webrtcStarListeners: WebrtcStarListener[maxWebrtcStarListeners]

fn webrtcStarListenerValid(idx: int32): bool =
    idx >= 0 && idx < maxWebrtcStarListeners

fn initWebrtcStarTransport(): WebrtcStarTransport =
    WebrtcStarTransport(running: false, hasAddr: false, listenerId: -1)

@borrows
fn findWebrtcStarListener(addr: multiaddress.MultiAddress): int32 =
    let addrBytes: Bytes = addr.data
    for i in 0..<maxWebrtcStarListeners:
        let listener: WebrtcStarListener = webrtcStarListeners[i]
        if listener.active && BytesEqual(addrBytes, listener.addr.data):
            return i
    return -1

fn registerWebrtcStarListener(addr: multiaddress.MultiAddress): int32 =
    let existing: int32 = findWebrtcStarListener(addr)
    if existing >= 0:
        return existing
    for i in 0..<maxWebrtcStarListeners:
        var listener: WebrtcStarListener = webrtcStarListeners[i]
        if !listener.active:
            listener.active = true
            listener.addr = addr
            listener.pending = streamconn.initConnectionQueue()
            webrtcStarListeners[i] = listener
            return i
    return -1

fn unregisterWebrtcStarListener(id: int32) =
    if !webrtcStarListenerValid(id):
        return
    var listener: WebrtcStarListener = webrtcStarListeners[id]
    while ! streamconn.connectionQueueIsEmpty(listener.pending):
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            break
        var conn: streamconn.Connection = Value(connRes)
        if conn.queueReserved && conn.queueReservedBytes > 0:
            memorymanager.releaseMemory(conn.queueReservedBytes)
            streamconn.clearQueueReservation(conn)
        streamconn.close(conn)
    listener.active = false
    listener.pending = streamconn.initConnectionQueue()
    webrtcStarListeners[id] = listener

fn dropWebrtcStarListenerByPipe(id: int32, pipeIdx: int32): Result[bool] =
    if !webrtcStarListenerValid(id):
        return Err[bool]("webrtc star: invalid listener")
    var listener: WebrtcStarListener = webrtcStarListeners[id]
    if !listener.active:
        return Err[bool]("webrtc star: listener ! active")
    let total: int32 = listener.pending.count
    var found: bool
    for processed in 0..<total:
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            webrtcStarListeners[id] = listener
            return Err[bool](Error(connRes))
        var conn: streamconn.Connection = Value(connRes)
        if !found && conn.pipeIdx == pipeIdx:
            if conn.queueReserved && conn.queueReservedBytes > 0:
                memorymanager.releaseMemory(conn.queueReservedBytes)
                streamconn.clearQueueReservation(conn)
            streamconn.close(conn)
            found = true
        else:
            let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, conn)
            if IsErr(enqRes):
                webrtcStarListeners[id] = listener
                return Err[bool](Error(enqRes))
    webrtcStarListeners[id] = listener
    return Ok[bool](found)

fn dropWebrtcStarPendingByPipe(t: WebrtcStarTransport, addr: multiaddress.MultiAddress, pipeIdx: int32): Result[bool] =
    t
    let listenerId: int32 = findWebrtcStarListener(addr)
    if listenerId < 0:
        return Ok[bool](false)
    return dropWebrtcStarListenerByPipe(listenerId, pipeIdx)

fn enqueueWebrtcStarListener(id: int32, conn: streamconn.Connection): Result[bool] =
    if !webrtcStarListenerValid(id):
        return Err[bool]("webrtc star: invalid listener")
    var listener: WebrtcStarListener = webrtcStarListeners[id]
    if !listener.active:
        return Err[bool]("webrtc star: listener ! active")
    let memBytes: int64 = streamconn.connectionQueueFootprintBytes(conn)
    let reserveRes: Result[bool] = memorymanager.reserveMemory(memBytes)
    if IsErr(reserveRes):
        return Err[bool](Error(reserveRes))
    let reserved: bool = Value(reserveRes)
    var queued: streamconn.Connection = conn
    if reserved:
        queued.queueReserved = true
        queued.queueReservedBytes = memBytes
    else:
        queued.queueReserved = false
        queued.queueReservedBytes = 0
    let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, queued)
    if IsErr(enqRes):
        if reserved:
            memorymanager.releaseMemory(memBytes)
        webrtcStarListeners[id] = listener
        return Err[bool](Error(enqRes))
    webrtcStarListeners[id] = listener
    return Ok[bool](true)

fn dequeueWebrtcStarListener(id: int32): Result[streamconn.Connection] =
    if !webrtcStarListenerValid(id):
        return Err[streamconn.Connection]("webrtc star: invalid listener")
    var listener: WebrtcStarListener = webrtcStarListeners[id]
    if !listener.active:
        return Err[streamconn.Connection]("webrtc star: listener ! active")
    let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
    if IsErr(connRes):
        webrtcStarListeners[id] = listener
        return Err[streamconn.Connection](Error(connRes))
    var conn: streamconn.Connection = Value(connRes)
    if conn.queueReserved && conn.queueReservedBytes > 0:
        let relRes: Result[bool] = memorymanager.releaseMemory(conn.queueReservedBytes)
        if IsErr(relRes):
            webrtcStarListeners[id] = listener
            return Err[streamconn.Connection](Error(relRes))
        streamconn.clearQueueReservation(conn)
    webrtcStarListeners[id] = listener
    return Ok[streamconn.Connection](conn)

fn start(t: var WebrtcStarTransport, addr: multiaddress.MultiAddress) =
    t.addr.raw = strings.CloneStr(addr.raw)
    t.hasAddr = true
    t.listenerId = registerWebrtcStarListener(addr)
    t.running = t.listenerId >= 0

fn stop(t: var WebrtcStarTransport) =
    t.running = false
    if t.listenerId >= 0:
        unregisterWebrtcStarListener(t.listenerId)
    t.listenerId = -1

fn accept(t: var WebrtcStarTransport): Result[streamconn.Connection] =
    if ! t.running:
        return Err[streamconn.Connection]("webrtc star: ! running")
    let connRes: Result[streamconn.Connection] = dequeueWebrtcStarListener(t.listenerId)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    return connRes

fn dial(t: var WebrtcStarTransport, addr: multiaddress.MultiAddress): Result[streamconn.Connection] =
    if ! handles(t, addr):
        return Err[streamconn.Connection]("webrtc star: unsupported address")
    var localAddr: multiaddress.MultiAddress = addr
    if t.hasAddr:
        localAddr = t.addr
    let listenerId: int32 = findWebrtcStarListener(addr)
    if listenerId < 0:
        return Err[streamconn.Connection]("webrtc star: no listener")
    let pairRes: Result[streamconn.ConnectionPair] = (
        streamconn.newConnectionPair(localAddr, addr, addr, localAddr)
    )
    if IsErr(pairRes):
        return Err[streamconn.Connection](Error(pairRes))
    let pair = Value(pairRes)
    let enqRes: Result[bool] = enqueueWebrtcStarListener(listenerId, pair.inbound)
    if IsErr(enqRes):
        var outConn: streamconn.Connection = pair.outbound
        var inConn: streamconn.Connection = pair.inbound
        streamconn.close(outConn)
        streamconn.close(inConn)
        return Err[streamconn.Connection](Error(enqRes))
    return Ok[streamconn.Connection](pair.outbound)

fn handles(t: WebrtcStarTransport, addr: multiaddress.MultiAddress): bool =
    t
    let text: str = lpMultiAddressToString(addr)
    if ! StrContains(text, "/p2p-webrtc-star"):
        return false
    if StrContains(text, "/ip4/") || StrContains(text, "/ip6/"):
        return true
    if StrContains(text, "/dns/") || StrContains(text, "/dns4/") || StrContains(text, "/dns6/"):
        return true
    return false
