# Memory transport(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection as streamconn
import std/net/memorymanager
import std/seqs
type
    MemoryTransport =
        running: bool
        addr: multiaddress.MultiAddress
        hasAddr: bool
        listenerId: int32

    MemoryListener =
        addr: multiaddress.MultiAddress
        active: bool
        pending: streamconn.ConnectionQueue

const
    maxMemoryListeners = 16

var
    memoryListeners: MemoryListener[]

fn ensureMemoryListeners() =
    if len(memoryListeners) < maxMemoryListeners:
        setLen(memoryListeners, maxMemoryListeners)

fn memoryListenerValid(idx: int32): bool =
    return idx >= 0 && idx < maxMemoryListeners

fn initMemoryTransport(): MemoryTransport =
    MemoryTransport(running: false, hasAddr: false, listenerId: -1)

fn memoryListenerMatches(listener: var MemoryListener, addrBytes: Bytes): bool =
    if !listener.active:
        return false
    return BytesEqual(addrBytes, listener.addr.data)

@borrows
fn findMemoryListener(addr: multiaddress.MultiAddress): int32 =
    ensureMemoryListeners()
    for i in 0..<maxMemoryListeners:
        if memoryListeners[i].active && BytesEqual(addr.data, memoryListeners[i].addr.data):
            return i
    return -1

@borrows
fn findMemoryListenerByRaw(addrText: str): int32 =
    ensureMemoryListeners()
    var i: int32
    while i < maxMemoryListeners:
        if memoryListeners[i].active && memoryListeners[i].addr.raw == addrText:
            return i
        i = i + 1
    return -1

fn memoryListenerIsActive(listener: var MemoryListener): bool =
    return listener.active

fn memoryListenerResetPending(listener: var MemoryListener) =
    listener.pending.count = 0
    listener.pending.head = 0
    listener.pending.tail = 0

fn memoryListenerActivate(listener: var MemoryListener, addr: multiaddress.MultiAddress) =
    listener.active = true
    listener.addr = addr
    memoryListenerResetPending(listener)

fn registerMemoryListenerByRaw(addrText: str): int32 =
    ensureMemoryListeners()
    let existing: int32 = findMemoryListenerByRaw(addrText)
    if existing >= 0:
        return existing
    var i: int32
    while i < maxMemoryListeners:
        if !memoryListeners[i].active:
            memoryListeners[i].active = true
            memoryListeners[i].addr.raw = strings.CloneStr(addrText)
            memoryListeners[i].pending.count = 0
            memoryListeners[i].pending.head = 0
            memoryListeners[i].pending.tail = 0
            return i
        i = i + 1
    return -1

fn startRaw(t: var MemoryTransport, addrText: str) =
    t.addr.raw = strings.CloneStr(addrText)
    t.hasAddr = true
    t.listenerId = registerMemoryListenerByRaw(addrText)
    t.running = t.listenerId >= 0

fn registerMemoryListener(addr: multiaddress.MultiAddress): int32 =
    ensureMemoryListeners()
    let existing: int32 = findMemoryListener(addr)
    if existing >= 0:
        return existing
    for i in 0..<maxMemoryListeners:
        if !memoryListeners[i].active:
            memoryListeners[i].active = true
            memoryListeners[i].addr.raw = strings.CloneStr(addr.raw)
            memoryListeners[i].pending.count = 0
            memoryListeners[i].pending.head = 0
            memoryListeners[i].pending.tail = 0
            return i
    return -1

fn memoryListenerDeactivate(listener: var MemoryListener) =
    while listener.pending.count > 0:
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            break
        var conn: streamconn.Connection = Value(connRes)
        if conn.queueReserved && conn.queueReservedBytes > 0:
            memorymanager.releaseMemory(conn.queueReservedBytes)
            streamconn.clearQueueReservation(conn)
        streamconn.close(conn)
    listener.active = false
    memoryListenerResetPending(listener)

fn unregisterMemoryListener(id: int32) =
    if !memoryListenerValid(id):
        return
    memoryListenerDeactivate(memoryListeners[id])

fn memoryListenerDropByPipe(listener: var MemoryListener, pipeIdx: int32): Result[bool] =
    if !listener.active:
        return Err[bool]("memorytransport: listener ! active")
    let total: int32 = listener.pending.count
    var found: bool
    for processed in 0..<total:
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            return Err[bool](Error(connRes))
        var conn: streamconn.Connection = Value(connRes)
        if !found && conn.pipeIdx == pipeIdx:
            if conn.queueReserved && conn.queueReservedBytes > 0:
                memorymanager.releaseMemory(conn.queueReservedBytes)
                streamconn.clearQueueReservation(conn)
            streamconn.close(conn)
            found = true
        else:
            let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, conn)
            if IsErr(enqRes):
                return Err[bool](Error(enqRes))
    return Ok[bool](found)

fn dropMemoryListenerByPipe(id: int32, pipeIdx: int32): Result[bool] =
    if !memoryListenerValid(id):
        return Err[bool]("memorytransport: invalid listener")
    return memoryListenerDropByPipe(memoryListeners[id], pipeIdx)

fn dropMemoryPendingByPipe(t: MemoryTransport, addr: multiaddress.MultiAddress, pipeIdx: int32): Result[bool] =
    t
    let listenerId: int32 = findMemoryListener(addr)
    if listenerId < 0:
        return Ok[bool](false)
    return dropMemoryListenerByPipe(listenerId, pipeIdx)

fn memoryListenerEnqueue(listener: var MemoryListener, conn: streamconn.Connection): Result[bool] =
    if !listener.active:
        return Err[bool]("memorytransport: listener ! active")
    let memBytes: int64 = streamconn.connectionQueueFootprintBytes(conn)
    let reserveRes: Result[bool] = memorymanager.reserveMemory(memBytes)
    if IsErr(reserveRes):
        return Err[bool](Error(reserveRes))
    let reserved: bool = Value(reserveRes)
    var queued: streamconn.Connection = conn
    if reserved:
        queued.queueReserved = true
        queued.queueReservedBytes = memBytes
    else:
        queued.queueReserved = false
        queued.queueReservedBytes = 0
    let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, queued)
    if IsErr(enqRes):
        if reserved:
            memorymanager.releaseMemory(memBytes)
        return Err[bool](Error(enqRes))
    return Ok[bool](true)

fn enqueueMemoryListener(id: int32, conn: streamconn.Connection): Result[bool] =
    if !memoryListenerValid(id):
        return Err[bool]("memorytransport: invalid listener")
    return memoryListenerEnqueue(memoryListeners[id], conn)

fn memoryListenerDequeue(listener: var MemoryListener): Result[streamconn.Connection] =
    if !listener.active:
        return Err[streamconn.Connection]("memorytransport: listener ! active")
    let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    var conn: streamconn.Connection = Value(connRes)
    if conn.queueReserved && conn.queueReservedBytes > 0:
        let relRes: Result[bool] = memorymanager.releaseMemory(conn.queueReservedBytes)
        if IsErr(relRes):
            return Err[streamconn.Connection](Error(relRes))
        streamconn.clearQueueReservation(conn)
    return Ok[streamconn.Connection](conn)

fn dequeueMemoryListener(id: int32): Result[streamconn.Connection] =
    if !memoryListenerValid(id):
        return Err[streamconn.Connection]("memorytransport: invalid listener")
    return memoryListenerDequeue(memoryListeners[id])

fn start(t: var MemoryTransport, addr: multiaddress.MultiAddress) =
    t.addr.raw = strings.CloneStr(addr.raw)
    t.hasAddr = true
    t.listenerId = registerMemoryListener(addr)
    t.running = t.listenerId >= 0

fn stop(t: var MemoryTransport) =
    t.running = false
    if t.listenerId >= 0:
        unregisterMemoryListener(t.listenerId)
    t.listenerId = -1

fn accept(t: var MemoryTransport): Result[streamconn.Connection] =
    if ! t.running:
        return Err[streamconn.Connection]("memorytransport: ! running")
    let connRes: Result[streamconn.Connection] = dequeueMemoryListener(t.listenerId)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    return connRes

@borrows
fn dialRawOk(t: var MemoryTransport, addrText: str): Result[bool] =
    if !t.running:
        return Err[bool]("memorytransport: ! running")
    let listenerId: int32 = findMemoryListenerByRaw(addrText)
    if listenerId < 0:
        return Err[bool]("memorytransport: no listener")
    let pipeRes: Result[int32] = streamconn.allocPipe()
    if IsErr(pipeRes):
        return Err[bool](Error(pipeRes))
    let idx: int32 = Value(pipeRes)
    var inbound: streamconn.Connection
    inbound.dir = streamconn.Inbound
    inbound.open = true
    inbound.pipeIdx = idx
    inbound.pipeSide = 1
    inbound.accounting = true
    inbound.localAddr.raw = strings.CloneStr(addrText)
    inbound.remoteAddr.raw = strings.CloneStr(addrText)
    let enqRes: Result[bool] = enqueueMemoryListener(listenerId, inbound)
    if IsErr(enqRes):
        streamconn.pipeClose(idx)
        return Err[bool](Error(enqRes))
    return Ok[bool](true)

fn dial(t: var MemoryTransport, addr: multiaddress.MultiAddress): Result[streamconn.Connection] =
    let text: str = lpMultiAddressToString(addr)
    if ! StrContains(text, "/memory/"):
        return Err[streamconn.Connection]("memorytransport: unsupported address")
    let listenerId: int32 = findMemoryListener(addr)
    if listenerId < 0:
        return Err[streamconn.Connection]("memorytransport: no listener")
    var localAddr: multiaddress.MultiAddress = addr
    if t.hasAddr:
        localAddr = t.addr
    let pairRes: Result[streamconn.ConnectionPair] = streamconn.newConnectionPair(localAddr, addr, addr, localAddr)
    if IsErr(pairRes):
        return Err[streamconn.Connection](Error(pairRes))
    let pair = Value(pairRes)
    let enqRes: Result[bool] = enqueueMemoryListener(listenerId, pair.inbound)
    if IsErr(enqRes):
        var outConn: streamconn.Connection = pair.outbound
        var inConn: streamconn.Connection = pair.inbound
        streamconn.close(outConn)
        streamconn.close(inConn)
        return Err[streamconn.Connection](Error(enqRes))
    return Ok[streamconn.Connection](pair.outbound)

fn handles(t: MemoryTransport, addr: multiaddress.MultiAddress): bool =
    t
    let text: str = lpMultiAddressToString(addr)
    return StrContains(text, "/memory/")
