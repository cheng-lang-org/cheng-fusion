# Tor transport(minimal, synchronous stub).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection as streamconn
import std/net/memorymanager
import std/seqs
type
    TorTransport =
        running: bool
        addr: multiaddress.MultiAddress
        hasAddr: bool
        listenerId: int32

    TorListener =
        addr: multiaddress.MultiAddress
        active: bool
        pending: streamconn.ConnectionQueue

const
    maxTorListeners = 16

var
    torListeners: TorListener[]

fn ensureTorListeners() =
    if len(torListeners) < maxTorListeners:
        setLen(torListeners, maxTorListeners)

fn torListenerValid(idx: int32): bool =
    idx >= 0 && idx < maxTorListeners

fn initTorTransport(): TorTransport =
    TorTransport(running: false, hasAddr: false, listenerId: -1)

@borrows
fn findTorListener(addr: multiaddress.MultiAddress): int32 =
    ensureTorListeners()
    for i in 0..<maxTorListeners:
        if torListeners[i].active && BytesEqual(addr.data, torListeners[i].addr.data):
            return i
    return -1

fn registerTorListener(addr: multiaddress.MultiAddress): int32 =
    ensureTorListeners()
    let existing: int32 = findTorListener(addr)
    if existing >= 0:
        return existing
    for i in 0..<maxTorListeners:
        if !torListeners[i].active:
            torListeners[i].active = true
            torListeners[i].addr.raw = strings.CloneStr(addr.raw)
            torListeners[i].pending = streamconn.initConnectionQueue()
            return i
    return -1

fn unregisterTorListener(id: int32) =
    if !torListenerValid(id):
        return
    var listener: TorListener = torListeners[id]
    while ! streamconn.connectionQueueIsEmpty(listener.pending):
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            break
        var conn: streamconn.Connection = Value(connRes)
        if conn.queueReserved && conn.queueReservedBytes > 0:
            memorymanager.releaseMemory(conn.queueReservedBytes)
            streamconn.clearQueueReservation(conn)
        streamconn.close(conn)
    listener.active = false
    listener.pending = streamconn.initConnectionQueue()
    torListeners[id] = listener

fn dropTorListenerByPipe(id: int32, pipeIdx: int32): Result[bool] =
    if !torListenerValid(id):
        return Err[bool]("tortransport: invalid listener")
    var listener: TorListener = torListeners[id]
    if !listener.active:
        return Err[bool]("tortransport: listener ! active")
    let total: int32 = listener.pending.count
    var found: bool
    for processed in 0..<total:
        let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
        if IsErr(connRes):
            torListeners[id] = listener
            return Err[bool](Error(connRes))
        var conn: streamconn.Connection = Value(connRes)
        if !found && conn.pipeIdx == pipeIdx:
            if conn.queueReserved && conn.queueReservedBytes > 0:
                memorymanager.releaseMemory(conn.queueReservedBytes)
                streamconn.clearQueueReservation(conn)
            streamconn.close(conn)
            found = true
        else:
            let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, conn)
            if IsErr(enqRes):
                torListeners[id] = listener
                return Err[bool](Error(enqRes))
    torListeners[id] = listener
    return Ok[bool](found)

fn dropTorPendingByPipe(t: TorTransport, addr: multiaddress.MultiAddress, pipeIdx: int32): Result[bool] =
    t
    let listenerId: int32 = findTorListener(addr)
    if listenerId < 0:
        return Ok[bool](false)
    return dropTorListenerByPipe(listenerId, pipeIdx)

fn enqueueTorListener(id: int32, conn: streamconn.Connection): Result[bool] =
    if !torListenerValid(id):
        return Err[bool]("tortransport: invalid listener")
    var listener: TorListener = torListeners[id]
    if !listener.active:
        return Err[bool]("tortransport: listener ! active")
    let memBytes: int64 = streamconn.connectionQueueFootprintBytes(conn)
    let reserveRes: Result[bool] = memorymanager.reserveMemory(memBytes)
    if IsErr(reserveRes):
        return Err[bool](Error(reserveRes))
    let reserved: bool = Value(reserveRes)
    var queued: streamconn.Connection = conn
    if reserved:
        queued.queueReserved = true
        queued.queueReservedBytes = memBytes
    else:
        queued.queueReserved = false
        queued.queueReservedBytes = 0
    let enqRes: Result[bool] = streamconn.enqueueConnection(listener.pending, queued)
    if IsErr(enqRes):
        if reserved:
            memorymanager.releaseMemory(memBytes)
        torListeners[id] = listener
        return Err[bool](Error(enqRes))
    torListeners[id] = listener
    return Ok[bool](true)

fn dequeueTorListener(id: int32): Result[streamconn.Connection] =
    if !torListenerValid(id):
        return Err[streamconn.Connection]("tortransport: invalid listener")
    var listener: TorListener = torListeners[id]
    if !listener.active:
        return Err[streamconn.Connection]("tortransport: listener ! active")
    let connRes: Result[streamconn.Connection] = streamconn.dequeueConnection(listener.pending)
    if IsErr(connRes):
        torListeners[id] = listener
        return Err[streamconn.Connection](Error(connRes))
    var conn: streamconn.Connection = Value(connRes)
    if conn.queueReserved && conn.queueReservedBytes > 0:
        let relRes: Result[bool] = memorymanager.releaseMemory(conn.queueReservedBytes)
        if IsErr(relRes):
            torListeners[id] = listener
            return Err[streamconn.Connection](Error(relRes))
        streamconn.clearQueueReservation(conn)
    torListeners[id] = listener
    return Ok[streamconn.Connection](conn)

fn start(t: var TorTransport, addr: multiaddress.MultiAddress) =
    t.addr.raw = strings.CloneStr(addr.raw)
    t.hasAddr = true
    t.listenerId = registerTorListener(addr)
    t.running = t.listenerId >= 0

fn stop(t: var TorTransport) =
    t.running = false
    if t.listenerId >= 0:
        unregisterTorListener(t.listenerId)
    t.listenerId = -1

fn accept(t: var TorTransport): Result[streamconn.Connection] =
    if ! t.running:
        return Err[streamconn.Connection]("tortransport: ! running")
    let connRes: Result[streamconn.Connection] = dequeueTorListener(t.listenerId)
    if IsErr(connRes):
        return Err[streamconn.Connection](Error(connRes))
    return connRes

fn dial(t: var TorTransport, addr: multiaddress.MultiAddress): Result[streamconn.Connection] =
    if ! handles(t, addr):
        return Err[streamconn.Connection]("tortransport: unsupported address")
    var localAddr: multiaddress.MultiAddress = addr
    if t.hasAddr:
        localAddr = t.addr
    let listenerId: int32 = findTorListener(addr)
    if listenerId < 0:
        return Err[streamconn.Connection]("tortransport: no listener")
    let pairRes: Result[streamconn.ConnectionPair] = streamconn.newConnectionPair(localAddr, addr, addr, localAddr)
    if IsErr(pairRes):
        return Err[streamconn.Connection](Error(pairRes))
    let pair = Value(pairRes)
    let enqRes: Result[bool] = enqueueTorListener(listenerId, pair.inbound)
    if IsErr(enqRes):
        var outConn: streamconn.Connection = pair.outbound
        var inConn: streamconn.Connection = pair.inbound
        streamconn.close(outConn)
        streamconn.close(inConn)
        return Err[streamconn.Connection](Error(enqRes))
    return Ok[streamconn.Connection](pair.outbound)

fn handles(t: TorTransport, addr: multiaddress.MultiAddress): bool =
    t
    let text: str = lpMultiAddressToString(addr)
    if StrContains(text, "/onion3/") || StrContains(text, "/onion/"):
        return true
    return false
