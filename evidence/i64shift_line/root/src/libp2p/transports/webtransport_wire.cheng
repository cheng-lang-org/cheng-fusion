# Real (non-double-framed) HTTP/3 wire I/O for a single QUIC stream.
#
# src/tests/webtransport_connect_slice2_probe.cheng's writeHeadersFrame/
# readHeadersFields helpers additionally wrap every h3frame.Http3Encode*Frame()
# payload in libp2p/transports/quic_transport.cheng's Libp2pQuicEncodeFrame --
# an EXTRA, cheng-internal-only 4-byte length prefix that is not part of the
# real HTTP/3 wire format. That double-framing is invisible when both peers
# are this same cheng codebase, but is NOT understood by any independent
# HTTP/3/WebTransport implementation (a real browser or a real QUIC library):
# they expect the raw stream bytes to directly BE a sequence of standard
# HTTP/3 frames (type-varint + length-varint + payload) or, on a
# unidirectional stream, a leading stream-type varint followed by frames --
# nothing more. This module reads/writes exactly that real wire shape, with
# no extra wrapper, so a server built on top of it can interop with a
# genuine external client.

import std/result
import std/rawbytes
import std/os
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport
import cheng/quic/core/quic_varint as qvarint
import cheng/http3/frame as h3frame
import cheng/libp2p/transports/quic_transport

# Reads exactly one QUIC variable-length integer directly off a stream (RFC
# 9000 §16): one probe byte to learn the length tag from its top 2 bits, then
# the remaining (size-1) bytes if the tag says the varint is longer than 1
# byte. Used both for HTTP/3 frame headers (type, length) and for a
# unidirectional stream's leading stream-type varint.
fn Wth3ReadVarint(t: var qtransport.MsQuicTransport, conn: var qconn.Connection): Result[int64] =
    let firstRes: Result[Bytes] = quic_transport.Libp2pQuicReadExact(t, conn, 1)
    if IsErr(firstRes):
        return Err[int64](ErrorText(firstRes))
    let first: Bytes = Value(firstRes)
    let tag: int32 = BytesGet(first, 0) >> 6
    var size: int32 = 8
    if tag == 0:
        size = 1
    elif tag == 1:
        size = 2
    elif tag == 2:
        size = 4
    if size == 1:
        let decodedRes: Result[qvarint.QuicVarIntDecoded] = qvarint.quicVarIntDecode(first, 0)
        if IsErr(decodedRes):
            return Err[int64](ErrorText(decodedRes))
        return Ok[int64](Value(decodedRes).value)
    let restRes: Result[Bytes] = quic_transport.Libp2pQuicReadExact(t, conn, size - 1)
    if IsErr(restRes):
        return Err[int64](ErrorText(restRes))
    let full: Bytes = BytesConcat(first, Value(restRes))
    let decodedRes: Result[qvarint.QuicVarIntDecoded] = qvarint.quicVarIntDecode(full, 0)
    if IsErr(decodedRes):
        return Err[int64](ErrorText(decodedRes))
    return Ok[int64](Value(decodedRes).value)

# Reads one real HTTP/3 frame (type varint + length varint + exact payload)
# directly off a stream -- no outer wrapper.
fn Wth3ReadFrame(t: var qtransport.MsQuicTransport, conn: var qconn.Connection): Result[h3frame.Http3Frame] =
    let kindRes: Result[int64] = Wth3ReadVarint(t, conn)
    if IsErr(kindRes):
        return Err[h3frame.Http3Frame](ErrorText(kindRes))
    let lenRes: Result[int64] = Wth3ReadVarint(t, conn)
    if IsErr(lenRes):
        return Err[h3frame.Http3Frame](ErrorText(lenRes))
    let payloadLen: int32 = int32(Value(lenRes))
    if payloadLen < 0:
        return Err[h3frame.Http3Frame]("wt h3 wire: negative frame length")
    var payload: Bytes = EmptyBytes()
    if payloadLen > 0:
        let payloadRes: Result[Bytes] = quic_transport.Libp2pQuicReadExact(t, conn, payloadLen)
        if IsErr(payloadRes):
            return Err[h3frame.Http3Frame](ErrorText(payloadRes))
        payload = Value(payloadRes)
    return Ok[h3frame.Http3Frame](h3frame.Http3MakeFrame(Value(kindRes), payload))

# Writes already-encoded bytes (h3frame.Http3Encode*Frame /
# Http3EncodeUnidirectionalStream output) directly to a stream, raw, no
# outer wrapper.
fn Wth3WriteRaw(t: var qtransport.MsQuicTransport, conn: var qconn.Connection, data: Bytes): Result[bool] =
    return quic_transport.Libp2pQuicWriteExact(t, conn, data)

# Best-effort drain of whatever application bytes are currently available on
# a stream: waits for the first byte (bounded attempts), then keeps
# collecting while more keeps arriving, and treats a short quiet gap as the
# end of this write burst. There is no length prefix at the raw WebTransport
# byte-stream layer (same as a TCP socket) -- an app-level message boundary
# is a policy decision by the two endpoints, not a wire feature, so this is
# deliberately a "whatever came in during this window" read, not an
# "expect exactly N bytes" read.
fn Wth3ReadAvailable(t: var qtransport.MsQuicTransport,
                       conn: var qconn.Connection,
                       maxBytes: int32,
                       firstByteWaitMs: int32,
                       quietGapMs: int32): Result[Bytes] =
    var out: Bytes = EmptyBytes()
    var waited: int32
    while BytesLen(out) <= 0 && waited < firstByteWaitMs:
        let chunkRes: Result[Bytes] = qtransport.msquicTransportReadNonblocking(t, conn, maxBytes)
        if IsOk(chunkRes):
            let chunk: Bytes = Value(chunkRes)
            if BytesLen(chunk) > 0:
                out = chunk
            else:
                os.SleepMs(1)
                waited = waited + 1
        else:
            os.SleepMs(1)
            waited = waited + 1
    if BytesLen(out) <= 0:
        return Err[Bytes]("wt h3 wire: timed out waiting for first byte")
    var quiet: int32
    while quiet < quietGapMs && BytesLen(out) < maxBytes:
        let chunkRes: Result[Bytes] = qtransport.msquicTransportReadNonblocking(t, conn, maxBytes - BytesLen(out))
        if IsOk(chunkRes):
            let chunk: Bytes = Value(chunkRes)
            if BytesLen(chunk) > 0:
                out = BytesConcat(out, chunk)
                quiet = 0
            else:
                os.SleepMs(1)
                quiet = quiet + 1
        else:
            os.SleepMs(1)
            quiet = quiet + 1
    return Ok[Bytes](out)
