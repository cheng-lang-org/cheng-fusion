fn connManagerDumpByDirectionSorted(cm: ConnManager, dir: streamconn.Direction): str =
    var conns: ConnectionInfo[maxConnections]
    var count: int32
    collectConnectionsByDirection(cm, dir, conns, count)
    if count <= 1:
        var out: str
        for i in 0..<count:
            appendConnectionDump(out, conns[i])
        return out
    sortConnections(conns, count)
    var out: str
    for i in 0..<count:
        appendConnectionDump(out, conns[i])
    return out

fn connManagerDumpByDirectionSortedLimit(cm: ConnManager, dir: streamconn.Direction, limit: int32): str =
    if limit <= 0:
        return ""
    var conns: ConnectionInfo[maxConnections]
    var count: int32
    collectConnectionsByDirection(cm, dir, conns, count)
    if count <= 1:
        var out: str
        var remaining: int32 = limit
        for i in 0..<count:
            if ! (i < count && remaining > 0):
                break
            appendConnectionDumpWithLimit(out, conns[i], remaining)
        return out
    sortConnections(conns, count)
    var out: str
    var remaining: int32 = limit
    for i in 0..<count:
        if ! (i < count && remaining > 0):
            break
        appendConnectionDumpWithLimit(out, conns[i], remaining)
    return out

