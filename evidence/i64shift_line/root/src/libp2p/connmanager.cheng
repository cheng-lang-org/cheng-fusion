fn connManagerDumpJsonByDirectionSorted(cm: ConnManager, dir: streamconn.Direction): str =
    var conns: ConnectionInfo[maxConnections]
    var count: int32
    collectConnectionsByDirection(cm, dir, conns, count)
    if count <= 1:
        var out: str
        for i in 0..<count:
            appendConnJson(out, conns[i])
        return out
    sortConnections(conns, count)
    var out: str
    for i in 0..<count:
        appendConnJson(out, conns[i])
    return out

