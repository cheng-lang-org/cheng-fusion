fn connManagerHasConnection(cm: ConnManager, conn: streamconn.Connection): bool =
    return findConnectionIndex(cm, conn) >= 0

fn connManagerCountByDirection(cm: ConnManager, dir: streamconn.Direction): int32 =
    var total: int32
    for i in 0..<cm.count:
        if cm.items[i].dir == dir:
            total = total + 1
    return total

fn connManagerCountByAddressSubstring(cm: ConnManager, needle: str): int32 =
    var total: int32
    for i in 0..<cm.count:
        if connAddressContains(cm.items[i], needle):
            total = total + 1
    return total

fn connManagerCountOpen(cm: ConnManager): int32 =
    var total: int32
    for i in 0..<cm.count:
        if cm.items[i].open:
            total = total + 1
    return total

fn connManagerCountClosed(cm: ConnManager): int32 =
    var total: int32
    for i in 0..<cm.count:
        if ! cm.items[i].open:
            total = total + 1
    return total
