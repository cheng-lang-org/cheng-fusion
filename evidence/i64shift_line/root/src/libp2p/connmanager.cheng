fn boolText(value: bool): str =
    if value:
        return "true"
    return "false"

fn connInfoJson(info: ConnectionInfo): str =
    var out: str
    out = out + "{\"dir\":\""
    out = out + connDirectionText(info)
    out = out + "\",\"local\":\""
    out = out + toString(info.localAddr)
    out = out + "\",\"remote\":\""
    out = out + toString(info.remoteAddr)
    out = out + "\",\"open\":"
    out = out + boolText(info.open)
    out = out + "}"
    return out

fn appendConnJson(out: var str, info: ConnectionInfo) =
    if len(out) == 0:
        out = connInfoJson(info)
    else:
        out = out + "\n"
        out = out + connInfoJson(info)

fn connManagerDumpJson(cm: ConnManager): str =
    var out: str
    for i in 0..<cm.count:
        appendConnJson(out, cm.items[i])
    return out

fn connManagerDumpJsonLimit(cm: ConnManager, limit: int32): str =
    if limit <= 0:
        return ""
    var out: str
    var remaining: int32 = limit
    for i in 0..<cm.count:
        if ! (i < cm.count && remaining > 0):
            break
        appendConnJson(out, cm.items[i])
        remaining = remaining - 1
    return out

fn connManagerDumpJsonOffset(cm: ConnManager, offset: int32, limit: int32): str =
    if limit <= 0:
        return ""
    var out: str
    var remaining: int32 = limit
    var skip: int32 = if offset < 0: 0 else: offset
    for i in 0..<cm.count:
        if ! (i < cm.count && remaining > 0):
            break
        if skip > 0:
            skip = skip - 1
        else:
            appendConnJson(out, cm.items[i])
            remaining = remaining - 1
    return out

fn connManagerDumpJsonPage(cm: ConnManager, page: int32, size: int32): str =
    if size <= 0:
        return ""
    let offset: int32 = pageOffset(page, size)
    return connManagerDumpJsonOffset(cm, offset, size)

fn connManagerDumpJsonSorted(cm: ConnManager): str =
    if cm.count <= 1:
        return connManagerDumpJson(cm)
    var conns: ConnectionInfo[maxConnections]
    var count: int32 = cm.count
    for i in 0..<count:
        conns[i] = cm.items[i]
    sortConnections(conns, count)
    var out: str
    for i in 0..<count:
        appendConnJson(out, conns[i])
    return out

