# Connection manager(minimal, fixed-size list).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import std/times
import cheng/libp2p/multiaddress
import cheng/libp2p/stream/connection as streamconn
import std/seqs
const
    maxConnections = 64

type
    ConnectionInfo =
        localAddr: multiaddress.MultiAddress
        remoteAddr: multiaddress.MultiAddress
        dir: streamconn.Direction
        open: bool
        priority: int32
        score: float64
        lastActiveNs: int64

    ConnManager =
        count: int32
        items: ConnectionInfo[]
        lowWater: int32
        highWater: int32

fn initConnManager(): ConnManager =
    var out: ConnManager
    out.count = 0
    out.lowWater = 0
    out.highWater = 0
    return out

fn count(cm: ConnManager): int32 =
    return cm.count

fn connectionInfo(conn: streamconn.Connection): ConnectionInfo =
    let localAddr: multiaddress.MultiAddress = streamconn.LocalAddress(conn)
    let remoteAddr: multiaddress.MultiAddress = streamconn.RemoteAddress(conn)
    let dir: streamconn.Direction = streamconn.ConnectionDirection(conn)
    let open: bool = streamconn.ConnectionIsOpen(conn)
    var priority: int32 = 2
    if dir == streamconn.Inbound:
        priority = 1
    let score: float64
    let lastActiveNs: int64 = EpochTimeNs()
    return ConnectionInfo(
        localAddr: localAddr,
        remoteAddr: remoteAddr,
        dir: dir,
        open: open,
        priority: priority,
        score: score,
        lastActiveNs: lastActiveNs
    )

fn sameConnectionInfo(info: ConnectionInfo, conn: streamconn.Connection): bool =
    if info.dir != streamconn.ConnectionDirection(conn):
        return false
    if ! BytesEqual(info.localAddr.data, streamconn.LocalAddress(conn).data):
        return false
    if ! BytesEqual(info.remoteAddr.data, streamconn.RemoteAddress(conn).data):
        return false
    return true

fn findConnectionIndex(cm: ConnManager, conn: streamconn.Connection): int32 =
    for i in 0..<cm.count:
        if sameConnectionInfo(cm.items[i], conn):
            return i
    return -1

fn addConnection(cm: var ConnManager, conn: streamconn.Connection): Result[bool] =
    let idx: int32 = findConnectionIndex(cm, conn)
    if idx >= 0:
        var info: ConnectionInfo = cm.items[idx]
        info.open = streamconn.ConnectionIsOpen(conn)
        info.lastActiveNs = EpochTimeNs()
        cm.items[idx] = info
        return Ok[bool](true)
    if cm.count >= maxConnections:
        return Err[bool]("connmanager: full")
    add(cm.items, connectionInfo(conn))
    cm.count = cm.items.len
    return Ok[bool](true)

fn setConnManagerWatermarks(cm: var ConnManager, low: int32, high: int32): Result[bool] =
    let safeLow: int32 = if low < 0: 0 else: low
    let safeHigh: int32 = if high < 0: 0 else: high
    if safeHigh > 0 && safeLow > safeHigh:
        return Err[bool]("connmanager: low water > high water")
    if safeHigh > maxConnections:
        return Err[bool]("connmanager: high water exceeds capacity")
    cm.lowWater = safeLow
    cm.highWater = safeHigh
    return Ok[bool](true)

fn connManagerLowWater(cm: ConnManager): int32 =
    return cm.lowWater

fn connManagerHighWater(cm: ConnManager): int32 =
    return cm.highWater

fn connManagerOpenCount(cm: ConnManager): int32 =
    var openCount: int32
    for i in 0..<cm.count:
        if cm.items[i].open:
            openCount = openCount + 1
    return openCount

fn connManagerNeedsTrim(cm: ConnManager): bool =
    if cm.highWater <= 0:
        return false
    return connManagerOpenCount(cm) > cm.highWater

fn connManagerTrimCandidate(cm: ConnManager): int32 =
    var idx: int32 = -1
    for i in 0..<cm.count:
        if ! cm.items[i].open:
            continue
        if idx < 0:
            idx = i
            continue
        if cm.items[i].priority < cm.items[idx].priority:
            idx = i
            continue
        if cm.items[i].priority > cm.items[idx].priority:
            continue
        if cm.items[i].score < cm.items[idx].score:
            idx = i
            continue
        if cm.items[i].score > cm.items[idx].score:
            continue
        if cm.items[i].lastActiveNs < cm.items[idx].lastActiveNs:
            idx = i
    return idx

fn connManagerMarkClosedAt(cm: var ConnManager, idx: int32): bool =
    if idx < 0 || idx >= cm.count:
        return false
    var info: ConnectionInfo = cm.items[idx]
    if ! info.open:
        return false
    info.open = false
    info.lastActiveNs = EpochTimeNs()
    cm.items[idx] = info
    return true

fn removeConnection(cm: var ConnManager, conn: streamconn.Connection): Result[bool] =
    let idx: int32 = findConnectionIndex(cm, conn)
    if idx < 0:
        return Err[bool]("connmanager: ! found")
    let last: int32 = cm.count - 1
    if idx != last:
        cm.items[idx] = cm.items[last]
    cm.count = cm.count - 1
    return Ok[bool](true)

fn connManagerCloseAll(cm: var ConnManager): int32 =
    var closed: int32
    for i in 0..<cm.count:
        var info: ConnectionInfo = cm.items[i]
        if info.open:
            info.open = false
            cm.items[i] = info
            closed = closed + 1
    return closed

fn connDirectionText(info: ConnectionInfo): str =
    if info.dir == streamconn.Outbound:
        return "outbound"
    return "inbound"

fn appendConnectionDump(out: var str, info: ConnectionInfo) =
    out = out + "conn "
    out = out + connDirectionText(info)
    out = out + " "
    out = out + toString(info.localAddr)
    out = out + " -> "
    out = out + toString(info.remoteAddr)
    if info.open:
        out = out + " open"
    else:
        out = out + " closed"
    out = out + "\n"

fn appendConnectionDumpWithLimit(out: var str, info: ConnectionInfo, remaining: var int32): bool =
    if remaining <= 0:
        return false
    appendConnectionDump(out, info)
    remaining = remaining - 1
    return remaining > 0

fn appendConnectionDumpWithOffset(out: var str, info: ConnectionInfo, offset: var int32, remaining: var int32): bool =
    if remaining <= 0:
        return false
    if offset > 0:
        offset = offset - 1
        return true
    appendConnectionDump(out, info)
    remaining = remaining - 1
    return remaining > 0

fn pageOffset(page: int32, size: int32): int32 =
    if size <= 0:
        return 0
    if page <= 1:
        return 0
    return (page - 1) * size

fn stringCmp(a: str, b: str): int32 =
    let alen: int32 = len(a)
    let blen: int32 = len(b)
    let minLen: int32 = if alen < blen: alen else: blen
    for i in 0..<minLen:
        let diff: int32 = int32(a[i]) - int32(b[i])
        if diff != 0:
            return diff
    return alen - blen

fn connInfoLess(a: ConnectionInfo, b: ConnectionInfo): bool =
    let dirCmp: int32 = stringCmp(connDirectionText(a), connDirectionText(b))
    if dirCmp != 0:
        return dirCmp < 0
    let localCmp: int32 = stringCmp(toString(a.localAddr), toString(b.localAddr))
    if localCmp != 0:
        return localCmp < 0
    let remoteCmp: int32 = stringCmp(toString(a.remoteAddr), toString(b.remoteAddr))
    if remoteCmp != 0:
        return remoteCmp < 0
    if a.open != b.open:
        return a.open && ! b.open
    return false

fn sortConnections(conns: var ConnectionInfo[maxConnections], count: int32) =
    if count <= 1:
        return
    for i in 0..<count:
        var minIdx: int32 = i
        for j in i + 1..<count:
            if ! (j < count):
                break
            if connInfoLess(conns[j], conns[minIdx]):
                minIdx = j
        if minIdx != i:
            let tmp: ConnectionInfo = conns[i]
            conns[i] = conns[minIdx]
            conns[minIdx] = tmp
fn connManagerDump(cm: ConnManager): str =
    var out: str
    for i in 0..<cm.count:
        appendConnectionDump(out, cm.items[i])
    return out

fn connManagerDumpLimit(cm: ConnManager, limit: int32): str =
    if limit <= 0:
        return ""
    var out: str
    var remaining: int32 = limit
    for i in 0..<cm.count:
        if ! (i < cm.count && remaining > 0):
            break
        appendConnectionDumpWithLimit(out, cm.items[i], remaining)
    return out

fn connManagerDumpOffset(cm: ConnManager, offset: int32, limit: int32): str =
    if limit <= 0:
        return ""
    var out: str
    var remaining: int32 = limit
    var skip: int32 = if offset < 0: 0 else: offset
    for i in 0..<cm.count:
        if ! (i < cm.count && remaining > 0):
            break
        appendConnectionDumpWithOffset(out, cm.items[i], skip, remaining)
    return out

fn connManagerDumpPage(cm: ConnManager, page: int32, size: int32): str =
    if size <= 0:
        return ""
    let offset: int32 = pageOffset(page, size)
    return connManagerDumpOffset(cm, offset, size)

fn connManagerDumpSorted(cm: ConnManager): str =
    if cm.count <= 1:
        return connManagerDump(cm)
    var conns: ConnectionInfo[maxConnections]
    var count: int32 = cm.count
    for i in 0..<count:
        conns[i] = cm.items[i]
    sortConnections(conns, count)
    var out: str
    for i in 0..<count:
        appendConnectionDump(out, conns[i])
    return out

fn connManagerDumpSortedLimit(cm: ConnManager, limit: int32): str =
    if limit <= 0:
        return ""
    if cm.count <= 1:
        return connManagerDumpLimit(cm, limit)
    var conns: ConnectionInfo[maxConnections]
    var count: int32 = cm.count
    for i in 0..<count:
        conns[i] = cm.items[i]
    sortConnections(conns, count)
    var out: str
    var remaining: int32 = limit
    for i in 0..<count:
        if ! (i < count && remaining > 0):
            break
        appendConnectionDumpWithLimit(out, conns[i], remaining)
    return out

fn connManagerDumpSortedOffset(cm: ConnManager, offset: int32, limit: int32): str =
    if limit <= 0:
        return ""
    if cm.count <= 1:
        return connManagerDumpOffset(cm, offset, limit)
    var conns: ConnectionInfo[maxConnections]
    var count: int32 = cm.count
    for i in 0..<count:
        conns[i] = cm.items[i]
    sortConnections(conns, count)
    var out: str
    var remaining: int32 = limit
    var skip: int32 = if offset < 0: 0 else: offset
    for i in 0..<count:
        if ! (i < count && remaining > 0):
            break
        appendConnectionDumpWithOffset(out, conns[i], skip, remaining)
    return out

fn connManagerDumpSortedPage(cm: ConnManager, page: int32, size: int32): str =
    if size <= 0:
        return ""
    let offset: int32 = pageOffset(page, size)
    return connManagerDumpSortedOffset(cm, offset, size)

fn connAddressContains(info: ConnectionInfo, needle: str): bool =
    if StrContains(toString(info.localAddr), needle):
        return true
    if StrContains(toString(info.remoteAddr), needle):
        return true
    return false

fn collectConnectionsByDirection(cm: ConnManager, dir: streamconn.Direction, conns: var ConnectionInfo[maxConnections], count: var int32) =
    count = 0
    for i in 0..<cm.count:
        let info: ConnectionInfo = cm.items[i]
        if info.dir == dir:
            conns[count] = info
            count = count + 1
fn collectConnectionsByAddressSubstring(cm: ConnManager, needle: str, conns: var ConnectionInfo[maxConnections], count: var int32) =
    count = 0
    for i in 0..<cm.count:
        let info: ConnectionInfo = cm.items[i]
        if connAddressContains(info, needle):
            conns[count] = info
            count = count + 1
fn collectConnectionsByOpenState(cm: ConnManager, open: bool, conns: var ConnectionInfo[maxConnections], count: var int32) =
    count = 0
    for i in 0..<cm.count:
        let info: ConnectionInfo = cm.items[i]
        if info.open == open:
            conns[count] = info
            count = count + 1
fn connManagerDumpByDirection(cm: ConnManager, dir: streamconn.Direction): str =
    var out: str
    for i in 0..<cm.count:
        let info: ConnectionInfo = cm.items[i]
        if info.dir == dir:
            appendConnectionDump(out, info)
    return out

fn connManagerDumpByDirectionLimit(cm: ConnManager, dir: streamconn.Direction, limit: int32): str =
    if limit <= 0:
        return ""
    var out: str
    var remaining: int32 = limit
    for i in 0..<cm.count:
        if ! (i < cm.count && remaining > 0):
            break
        let info: ConnectionInfo = cm.items[i]
        if info.dir == dir:
            appendConnectionDumpWithLimit(out, info, remaining)
    return out

fn connManagerDumpByDirectionOffset(cm: ConnManager, dir: streamconn.Direction, offset: int32, limit: int32): str =
    if limit <= 0:
