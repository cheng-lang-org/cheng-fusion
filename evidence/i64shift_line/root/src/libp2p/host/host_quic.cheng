fn Libp2pQuicExchange(remoteHost: var host_base.Libp2pHost,
                        remoteAddr: types.Libp2pMultiaddr,
                        protocol: types.Libp2pProtocolId,
                        requestPayload: Bytes,
                        outPayload: var Bytes): Result[bool] =
    var pair: quic_transport.Libp2pQuicLoopbackPair
    let openRes = quic_transport.Libp2pQuicLoopbackOpenInto(pair, remoteAddr)
    if IsErr(openRes):
        return Err[bool](strutil.Join([" libp2p quic: open: ", ErrorText(openRes)], ""))
    let selectBytes = multistream.Libp2pMultistreamSelectBytes(protocol)
    let selectWriteRes = quic_transport.Libp2pQuicLoopbackWriteClient(pair, selectBytes)
    if IsErr(selectWriteRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: select write: ", ErrorText(selectWriteRes)], ""))
    let selectReadRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, BytesLen(selectBytes))
    if IsErr(selectReadRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: select read: ", ErrorText(selectReadRes)], ""))
    if !multistream.Libp2pMultistreamAccepts(Value(selectReadRes), protocol):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](" libp2p quic: select mismatch")
    let requestWriteRes = quic_transport.Libp2pQuicLoopbackWriteClient(pair, requestPayload)
    if IsErr(requestWriteRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: request write: ", ErrorText(requestWriteRes)], ""))
    let requestReadRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, BytesLen(requestPayload))
    if IsErr(requestReadRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: request read: ", ErrorText(requestReadRes)], ""))
    var serverRequestPayload: Bytes
    serverRequestPayload = Value(requestReadRes)
    let servePayloadRes = host_base.Libp2pServePayload(remoteHost, protocol, serverRequestPayload)
    if IsErr(servePayloadRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: serve: ", ErrorText(servePayloadRes)], ""))
    var responsePayload: Bytes
    responsePayload = Value(servePayloadRes)
    let responseWriteRes = quic_transport.Libp2pQuicLoopbackWriteServer(pair, responsePayload)
    if IsErr(responseWriteRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: response write: ", ErrorText(responseWriteRes)], ""))
    let responseReadRes = quic_transport.Libp2pQuicLoopbackReadClient(pair, BytesLen(responsePayload))
    quic_transport.Libp2pQuicLoopbackClose(pair)
    if IsErr(responseReadRes):
        return Err[bool](strutil.Join([" libp2p quic: response read: ", ErrorText(responseReadRes)], ""))
    var clientResponsePayload: Bytes
    clientResponsePayload = Value(responseReadRes)
    outPayload = clientResponsePayload
    return Ok[bool](true)

fn Libp2pHostQuicRequestResponse(localHost: var host_base.Libp2pHost,
                                   remoteHost: var host_base.Libp2pHost,
                                   remotePeerId: types.Libp2pPeerId,
                                   protocol: types.Libp2pProtocolId,
                                   requestPayload: Bytes,
                                   outPayload: var Bytes): Result[bool] =
    if !types.Libp2pPeerIdEqual(remoteHost.selfPeerId, remotePeerId):
        return Err[bool](" libp2p host: peer mismatch")
    if !host_base.Libp2pProtocolRegistered(remoteHost, protocol):
        return Err[bool](" libp2p host: remote protocol handler missing")
    var endpoint: ps.Libp2pPeerEndpoint
    let endpointRes = host_base.Libp2pSelectPeerEndpoint(localHost, remotePeerId, endpoint)
    if IsErr(endpointRes):
        return Err[bool](Error(endpointRes))
    let remoteAddr = multiaddr.Libp2pMultiaddrClone(endpoint.addr)
    if remoteAddr.transport != types.Libp2pTransportQuic:
        return host_base.Libp2pRequestResponse(localHost,
                                                 remoteHost,
                                                 remotePeerId,
                                                 protocol,
                                                 requestPayload,
                                                 outPayload)
    let streamRes = host_base.Libp2pOpenStream(localHost, remotePeerId, protocol)
    if IsErr(streamRes):
        return Err[bool](Error(streamRes))
    if protocol == types.Libp2pProtocolSync:
        localHost.syncRequestCount = localHost.syncRequestCount + 1
    return Libp2pQuicExchange(remoteHost, remoteAddr, protocol, requestPayload, outPayload)

fn Libp2pQuicSyncRequest(localHost: var host_base.Libp2pHost,
                           remoteHost: var host_base.Libp2pHost,
                           remotePeerId: types.Libp2pPeerId,
                           query: overlay.StoreQuery,
                           out: var overlay.IngressEnvelope[]): Result[bool] =
    if !types.Libp2pPeerIdEqual(remoteHost.selfPeerId, remotePeerId):
        return Err[bool](" libp2p host: sync peer mismatch")
    if !host_base.Libp2pProtocolRegistered(remoteHost, types.Libp2pProtocolSync):
        return Err[bool](" libp2p host: remote sync handler missing")
    let streamRes = host_base.Libp2pOpenStream(localHost, remotePeerId, types.Libp2pProtocolSync)
    if IsErr(streamRes):
        return Err[bool](Error(streamRes))
    localHost.syncRequestCount = localHost.syncRequestCount + 1
    let requestPayload = store_sync.Libp2pStoreQueryEncode(query)
    var endpoint: ps.Libp2pPeerEndpoint
    let endpointRes = host_base.Libp2pSelectPeerEndpoint(localHost, remotePeerId, endpoint)
    if IsErr(endpointRes):
        return Err[bool](Error(endpointRes))
    let remoteAddr = multiaddr.Libp2pMultiaddrClone(endpoint.addr)
    if remoteAddr.transport != types.Libp2pTransportQuic:
        return host_base.Libp2pSyncRequest(localHost, remoteHost, remotePeerId, query, out)
    var pair: quic_transport.Libp2pQuicLoopbackPair
    let openRes = quic_transport.Libp2pQuicLoopbackOpenInto(pair, remoteAddr)
    if IsErr(openRes):
        return Err[bool](strutil.Join([" libp2p quic: open: ", ErrorText(openRes)], ""))
    let selectRes = quic_transport.Libp2pQuicLoopbackSelectProtocol(pair, types.Libp2pProtocolSync)
    if IsErr(selectRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: select: ", ErrorText(selectRes)], ""))
    let requestWriteRes = quic_transport.Libp2pQuicLoopbackWriteClient(pair, requestPayload)
    if IsErr(requestWriteRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: request write: ", ErrorText(requestWriteRes)], ""))
    let requestReadRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, BytesLen(requestPayload))
    if IsErr(requestReadRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: request read: ", ErrorText(requestReadRes)], ""))
    var serverRequestPayload: Bytes
    serverRequestPayload = Value(requestReadRes)
    let servePayloadRes = host_base.Libp2pSyncServePayload(remoteHost, serverRequestPayload)
    if IsErr(servePayloadRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: serve: ", ErrorText(servePayloadRes)], ""))
    var servePayload: Bytes
    servePayload = Value(servePayloadRes)
    let responseWriteRes = quic_transport.Libp2pQuicLoopbackWriteServer(pair, servePayload)
    if IsErr(responseWriteRes):
        quic_transport.Libp2pQuicLoopbackClose(pair)
        return Err[bool](strutil.Join([" libp2p quic: response write: ", ErrorText(responseWriteRes)], ""))
    let responseReadRes = quic_transport.Libp2pQuicLoopbackReadClient(pair, BytesLen(servePayload))
    quic_transport.Libp2pQuicLoopbackClose(pair)
    if IsErr(responseReadRes):
        return Err[bool](strutil.Join([" libp2p quic: response read: ", ErrorText(responseReadRes)], ""))
    var responsePayload: Bytes
    responsePayload = Value(responseReadRes)
    out = []
    let decodeRes = store_sync.Libp2pStoreEntriesDecodeFill(responsePayload, out)
    if IsErr(decodeRes):
        return Err[bool](Error(decodeRes))
    return Ok[bool](true)

# ---- P2 S2: 真两进程 CAS-source 分发 (非 loopback; server 真 bind, client 真 UDP dial) ----
#
# 服务端: 收 WANT 帧 → CasSourceWantDecode → 逐 cid CasStoreGet(storeRoot) → 组 BLOCK
# (库有必进 BLOCK; 库无按 HAVE=0 语义省略, 不静默崩) → BLOCK 帧回。反应式 (每连按收到
# 的 WANT 动态查库应答), 非预置固定响应。畸形 WANT / 库损坏 = 硬错 (let it crash)。
#
# 客户端: WANT → RequestResponseNamed → BLOCK 解码 → 逐请求 cid 校验 sha256(data)==cid
# (内容寻址硬校验, 不符即崩) + 缺块即崩 (库无该 cid 不静默通过)。

fn casSourceServeWant(storeRoot: str, requestPayload: Bytes): Result[Bytes] =
    let wantRes = codec.CasSourceWantDecode(requestPayload)
    if IsErr(wantRes):
        return Err[Bytes](strutil.Join(["cas_source serve: want decode: ", Error(wantRes)], ""))
    let want = Value(wantRes)
    var block: codec.CasSourceBlockMsg
    for i in 0..<want.cids.len:
        let cidHex = layout.FixedBytes32Hex(want.cids[i])
        let getRes = cas_store.CasStoreGet(storeRoot, cidHex)
        if IsErr(getRes):
            continue
        var entry: codec.CasSourceBlockEntry
        entry.cid = want.cids[i]
        entry.data = Value(getRes)
        add(block.entries, entry)
    let encRes = codec.CasSourceBlockEncode(block)
    if IsErr(encRes):
        return Err[Bytes](strutil.Join(["cas_source serve: block encode: ", Error(encRes)], ""))
    return Ok[Bytes](Value(encRes))

fn Libp2pHostQuicServeCasSource(host: str,
                                  port: int32,
                                  serverName: str,
                                  storeRoot: str,
                                  readyPath: str,
                                  maxServeCount: int32,
                                  waitMs: int32): Result[int32] =
    var listener = qtransport.InitMsQuicTransport()
    let startRes = quic_transport.Libp2pQuicStartListenerNamed(listener, host, port, serverName)
    if IsErr(startRes):
        return Err[int32](Error(startRes))
    if !quic_transport.Libp2pQuicWriteReadyPort(readyPath, Value(startRes)):
        qtransport.Stop(listener)
        return Err[int32](" libp2p host quic cas: ready path write failed")
    var servedCount: int32 = 0
    while maxServeCount <= 0 || servedCount < maxServeCount:
        let acceptRes = qtransport.AcceptTimed(listener, waitMs)
        if IsErr(acceptRes):
            if ErrorText(acceptRes) == "msquic: accept timeout" ||
               quic_transport.Libp2pQuicRetryableAcceptError(ErrorText(acceptRes)):
                break
            qtransport.Stop(listener)
            return Err[int32](strutil.Join([" libp2p host quic cas: accept: ", ErrorText(acceptRes)], ""))
        var conn = Value(acceptRes)
        var dropConn = false
        let selectRes = quic_transport.Libp2pQuicServerSelectProtocol(listener, conn, types.Libp2pProtocolCasSource)
        if IsErr(selectRes):
            dropConn = true
        var requestPayload = EmptyBytes()
        if !dropConn:
            let requestRes = quic_transport.Libp2pQuicReadFrame(listener, conn)
            if IsErr(requestRes):
                dropConn = true
            else:
                requestPayload = Value(requestRes)
        if !dropConn:
            let respRes = casSourceServeWant(storeRoot, requestPayload)
            if IsErr(respRes):
                qconn.ConnClose(conn)
                qtransport.Stop(listener)
                return Err[int32](Error(respRes))
            let writeRes = quic_transport.Libp2pQuicWriteExact(listener, conn, quic_transport.Libp2pQuicEncodeFrame(Value(respRes)))
            if IsErr(writeRes):
                dropConn = true
        qconn.ConnClose(conn)
        if dropConn:
            continue
        servedCount = servedCount + 1
    qtransport.Stop(listener)
    return Ok[int32](servedCount)

fn Libp2pHostQuicFetchCasSource(host: str,
                                  port: int32,
                                  serverName: str,
                                  wantCids: layout.FixedBytes32[],
                                  outBlocks: var codec.CasSourceBlockEntry[]): Result[int32] =
    var want: codec.CasSourceWantMsg
    for i in 0..<wantCids.len:
        add(want.cids, wantCids[i])
    let wantEncRes = codec.CasSourceWantEncode(want)
    if IsErr(wantEncRes):
        return Err[int32](strutil.Join(["cas_source fetch: want encode: ", Error(wantEncRes)], ""))
    let respRes = casReqRespRetry(host, port, serverName, types.Libp2pProtocolCasSource, Value(wantEncRes))
    if IsErr(respRes):
        return Err[int32](strutil.Join([" libp2p host quic cas fetch: ", ErrorText(respRes)], ""))
    let blockRes = codec.CasSourceBlockDecode(Value(respRes))
    if IsErr(blockRes):
        return Err[int32](strutil.Join(["cas_source fetch: block decode: ", Error(blockRes)], ""))
    let block = Value(blockRes)
    outBlocks = []
    for i in 0..<wantCids.len:
        let wantHex = layout.FixedBytes32Hex(wantCids[i])
        var found = false
        for j in 0..<block.entries.len:
            if layout.FixedBytes32Equal(block.entries[j].cid, wantCids[i]):
                let actual = cas_store.CasContentCidBytes(block.entries[j].data)
                if !layout.FixedBytes32Equal(actual, wantCids[i]):
                    return Err[int32](strutil.Join(["cas_source fetch: cid 校验失败 (内容寻址不符) cid=", wantHex], ""))
                add(outBlocks, block.entries[j])
                found = true
                break
        if !found:
            return Err[int32](strutil.Join(["cas_source fetch: 缺块 (库无该 cid) cid=", wantHex], ""))
    return Ok[int32](outBlocks.len)

# ---- P3 正片: channel-head 传输动词 (HEAD_REQ/HEAD_RESP), cas-source 协议内新 verb ----
#
# 应答方 (A): 收 HEAD_REQ(channelId) → 查本地 head 库 → 命中回 HEAD_RESP(found, 201B head 线);
# 缺记录回 HEAD_RESP(miss) (不静默崩, 让客户端见 miss 硬错)。head 线原样透传, A 不重验自己的
# 签名 (发布方对自库负责); 全部验签/绑定/TOFU 在请求方 (B) 侧。
#
# 请求方 (B): HEAD_REQ(channelId) → RequestResponseNamed → HEAD_RESP 解 → miss 硬错 →
# found 则 ChannelHeadDecode (线长/tag/channelId==sha256(pubkey) 自证绑定) → ChannelHeadVerify
# (真 ed25519 签名) → 请求绑定校验 (返回记录.channelId 必须 == 请求的 channelId, 拒"换钥"served
# 的他人合法 head) → 出 record。任一环失败 = 硬错拒收, B 库零污染 (不落 TOFU 不拉源)。
#
# 协议 id 复用 25 (Libp2pProtocolCasSource); verb 由帧首字节 tag 判别 (HEAD_REQ=0x11)。

fn casHeadServeReq(storeRoot: str, requestPayload: Bytes): Result[Bytes] =
    let reqRes = htcodec.CasHeadReqDecode(requestPayload)
    if IsErr(reqRes):
        return Err[Bytes](strutil.Join(["cas_head serve: req decode: ", Error(reqRes)], ""))
    let channelId = Value(reqRes)
    let channelIdHex = layout.FixedBytes32Hex(channelId)
    if !headstore.ChannelHeadStoreHas(storeRoot, channelIdHex):
        return Ok[Bytes](htcodec.CasHeadRespEncodeMiss())
    let wireRes = headstore.ChannelHeadStoreGetWire(storeRoot, channelIdHex)
    if IsErr(wireRes):
        return Err[Bytes](strutil.Join(["cas_head serve: store get: ", Error(wireRes)], ""))
    let respRes = htcodec.CasHeadRespEncodeFound(Value(wireRes))
    if IsErr(respRes):
        return Err[Bytes](strutil.Join(["cas_head serve: resp encode: ", Error(respRes)], ""))
    return Ok[Bytes](Value(respRes))

# P5-S2 发现层应答方 (A): 收 SNAPSHOT_REQ(signerPubKey) → 按 signerHex 查本地快照库
# (provider_snapshots/<signerHex>) → 命中回 SNAPSHOT_RESP(found, 变长快照线); 缺记录回
# SNAPSHOT_RESP(miss) (确定性 miss, 不静默崩)。快照线原样透传, A 不重验自己的签名 (根对自库负责);
# 全部验签/绑定/新鲜度在请求方 (B) 侧。镜像 HEAD_REQ→head_store 查盘应答形态。
fn casSnapshotServeReq(storeRoot: str, requestPayload: Bytes): Result[Bytes] =
    let reqRes = pstcodec.CasSnapshotReqDecode(requestPayload)
    if IsErr(reqRes):
        return Err[Bytes](strutil.Join(["cas_snapshot serve: req decode: ", Error(reqRes)], ""))
    let signerKey = Value(reqRes)
    let signerHex = rawbytes.BytesToHex(signerKey)
    if !pstore.ProviderSnapshotStoreHas(storeRoot, signerHex):
        return Ok[Bytes](pstcodec.CasSnapshotRespEncodeMiss())
    let wireRes = pstore.ProviderSnapshotStoreGetWire(storeRoot, signerHex)
    if IsErr(wireRes):
        return Err[Bytes](strutil.Join(["cas_snapshot serve: store get: ", Error(wireRes)], ""))
    let respRes = pstcodec.CasSnapshotRespEncodeFound(Value(wireRes))
    if IsErr(respRes):
        return Err[Bytes](strutil.Join(["cas_snapshot serve: resp encode: ", Error(respRes)], ""))
    return Ok[Bytes](Value(respRes))

# 统一分发: 按帧首字节 verb tag 路由 (HEAD_REQ → head serve; 其余 → 既有 WANT serve)。
# 一个服务进程一条 accept 循环即可应答 head 与 source 两类请求 (同 protocol id 25)。
fn casUnifiedServeDispatch(storeRoot: str, requestPayload: Bytes): Result[Bytes] =
    if BytesLen(requestPayload) < 1:
        return Err[Bytes]("cas_unified serve: 空帧")
    if BytesGet(requestPayload, 0) == htcodec.CasHeadTagReq:
        return casHeadServeReq(storeRoot, requestPayload)
    if BytesGet(requestPayload, 0) == rtcodec.RevokeTagReq:
        return casRevokeServeReq(storeRoot, requestPayload)
    if BytesGet(requestPayload, 0) == dtcodec.DelegTagReq:
        return casDelegServeReq(storeRoot, requestPayload)
    if BytesGet(requestPayload, 0) == pstcodec.CasSnapshotTagReq:
        return casSnapshotServeReq(storeRoot, requestPayload)
    return casSourceServeWant(storeRoot, requestPayload)

fn Libp2pHostQuicServeCasUnified(host: str,
                                   port: int32,
                                   serverName: str,
                                   storeRoot: str,
                                   readyPath: str,
                                   maxServeCount: int32,
                                   waitMs: int32): Result[int32] =
    var listener = qtransport.InitMsQuicTransport()
    let startRes = quic_transport.Libp2pQuicStartListenerNamed(listener, host, port, serverName)
    if IsErr(startRes):
        return Err[int32](Error(startRes))
    if !quic_transport.Libp2pQuicWriteReadyPort(readyPath, Value(startRes)):
        qtransport.Stop(listener)
        return Err[int32](" libp2p host quic cas-unified: ready path write failed")
    var servedCount: int32 = 0
    while maxServeCount <= 0 || servedCount < maxServeCount:
        let acceptRes = qtransport.AcceptTimed(listener, waitMs)
        if IsErr(acceptRes):
            if ErrorText(acceptRes) == "msquic: accept timeout" ||
               quic_transport.Libp2pQuicRetryableAcceptError(ErrorText(acceptRes)):
                break
            qtransport.Stop(listener)
            return Err[int32](strutil.Join([" libp2p host quic cas-unified: accept: ", ErrorText(acceptRes)], ""))
        var conn = Value(acceptRes)
        var dropConn = false
        let selectRes = quic_transport.Libp2pQuicServerSelectProtocol(listener, conn, types.Libp2pProtocolCasSource)
        if IsErr(selectRes):
            dropConn = true
        var requestPayload = EmptyBytes()
        if !dropConn:
            let requestRes = quic_transport.Libp2pQuicReadFrame(listener, conn)
            if IsErr(requestRes):
                dropConn = true
            else:
                requestPayload = Value(requestRes)
        if !dropConn:
            let respRes = casUnifiedServeDispatch(storeRoot, requestPayload)
            if IsErr(respRes):
                qconn.ConnClose(conn)
                qtransport.Stop(listener)
                return Err[int32](Error(respRes))
            let writeRes = quic_transport.Libp2pQuicWriteExact(listener, conn, quic_transport.Libp2pQuicEncodeFrame(Value(respRes)))
            if IsErr(writeRes):
                dropConn = true
        qconn.ConnClose(conn)
        if dropConn:
            continue
        servedCount = servedCount + 1
    qtransport.Stop(listener)
    return Ok[int32](servedCount)

# cas-source 单次请求-应答 + transient QUIC 握手竞态有界重试 (head/撤销/委托 fetch 共用)。
# 单个编排器调用连发多个顺序 dial, 偶发 "handshake ! ready" (握手未在窗口内就绪, 服务端仍在
# AcceptTimed 等待) —— QUIC 握手本就可能需重试, 重发新 dial 会被仍等待的服务端接住。仅对 not-ready
# 类 transient 重试 (Contains "! ready"); 真错 (miss/decode/绑定/服务端 gone 超时) 立即上抛不重试。
fn casReqRespRetry(host: str, port: int32, serverName: str, protocol: int32, requestPayload: Bytes): Result[Bytes] =
    var attempt: int32 = 0
    var lastErr = ""
    while attempt < 12:
        let res = quic_transport.Libp2pQuicRequestResponseNamed(host, port, serverName, protocol, requestPayload)
        if !IsErr(res):
            return res
        lastErr = ErrorText(res)
        if !strutil.Contains(lastErr, "! ready"):
            return res
        attempt = attempt + 1
    return Err[Bytes](strutil.Join([" libp2p host quic req-resp: transient 握手竞态重试耗尽 (", IntToStr(attempt), "x): ", lastErr], ""))

# B 侧: 拉 head + 验签 + 自证绑定 + 请求绑定。成功回 true 并填 outRecord (已验证记录);
# 任一验证环失败 = 硬错 (Result Err), 调用方据此拒收不落库。
fn Libp2pHostQuicFetchCasHead(host: str,
                                port: int32,
                                serverName: str,
                                channelId: layout.FixedBytes32,
                                outRecord: var head.ChannelHeadRecord): Result[bool] =
    let reqPayload = htcodec.CasHeadReqEncode(channelId)
    let respRes = casReqRespRetry(host, port, serverName, types.Libp2pProtocolCasSource, reqPayload)
    if IsErr(respRes):
        return Err[bool](strutil.Join([" libp2p host quic cas-head fetch: ", ErrorText(respRes)], ""))
    let respMsgRes = htcodec.CasHeadRespDecode(Value(respRes))
    if IsErr(respMsgRes):
        return Err[bool](strutil.Join(["cas_head fetch: resp decode: ", Error(respMsgRes)], ""))
    let respMsg = Value(respMsgRes)
    if !respMsg.found:
        return Err[bool](strutil.Join(["cas_head fetch: 应答方无该 channel head channel=", layout.FixedBytes32Hex(channelId)], ""))
    var headWire = respMsg.headWire
    let decRes = head.ChannelHeadDecode(headWire)
    if IsErr(decRes):
        return Err[bool](strutil.Join(["cas_head fetch: head decode/绑定拒: ", Error(decRes)], ""))
    let record = Value(decRes)
    if !head.ChannelHeadVerify(record):
        return Err[bool](strutil.Join(["cas_head fetch: 验签拒 (签名不匹配规范字节) channel=", layout.FixedBytes32Hex(channelId)], ""))
    if !layout.FixedBytes32Equal(record.channelId, channelId):
        return Err[bool](strutil.Join(["cas_head fetch: 请求绑定拒 (返回 head 的 channelId != 请求, 拒他人 head) 请求=", layout.FixedBytes32Hex(channelId), " 返回=", layout.FixedBytes32Hex(record.channelId)], ""))
    outRecord = record
    return Ok[bool](true)

# P5-S2 发现层请求方 (B): 向一个 pinned 根 (host:port) 按 signerPubKey 索取该根签名的路由快照。
#   miss (根不持该 key 的快照) → outFound=false, Ok (发现层 fail-open, 缺席只是不扩宽, 调用方跳过);
#   found → 快照线 decode + ProviderSetVerify (真 ed25519 域分离验签) + 请求绑定 (返回记录.signerPubKey
#     必须 == 请求的 signerKey, 拒根拿【别的 key 签的】快照冒充) → outFound=true, 出 record;
#   验签失败 / 请求绑定失败 / decode 失败 / 网络失败 = 硬错 (Result Err), 调用方据此丢弃该快照。
# ★ 路由层【无】channelId==sha256(signer) 自证 (那是内容层): signer 的可信来自 B 侧 pinned-key 集
#   (调用方在把 record.signerPubKey 采纳前必须核其 ∈ CHENG_CAS_BOOTSTRAP_KEYS)。本函数只做"绑请求 key"
#   与"真验签"; "signer ∈ pinned 集"的策略判定在调用方 (cas_fetch_env 发现聚合)。
fn Libp2pHostQuicFetchSnapshot(host: str,
                                 port: int32,
                                 serverName: str,
                                 signerKey: Bytes,
                                 outFound: var bool,
                                 outRecord: var pset.ProviderSetRecord): Result[bool] =
    outFound = false
    let reqEncRes = pstcodec.CasSnapshotReqEncode(signerKey)
    if IsErr(reqEncRes):
        return Err[bool](strutil.Join(["cas_snapshot fetch: req encode: ", Error(reqEncRes)], ""))
    let respRes = casReqRespRetry(host, port, serverName, types.Libp2pProtocolCasSource, Value(reqEncRes))
    if IsErr(respRes):
        return Err[bool](strutil.Join([" libp2p host quic cas-snapshot fetch: ", ErrorText(respRes)], ""))
    let respMsgRes = pstcodec.CasSnapshotRespDecode(Value(respRes))
    if IsErr(respMsgRes):
        return Err[bool](strutil.Join(["cas_snapshot fetch: resp decode: ", Error(respMsgRes)], ""))
    let respMsg = Value(respMsgRes)
    if !respMsg.found:
        outFound = false
        return Ok[bool](true)
    let decRes = pset.ProviderSetDecode(respMsg.snapshotWire)
    if IsErr(decRes):
        return Err[bool](strutil.Join(["cas_snapshot fetch: 快照 decode: ", Error(decRes)], ""))
    let record = Value(decRes)
    if !pset.ProviderSetVerify(record):
        return Err[bool]("cas_snapshot fetch: 验签拒 (签名不匹配规范字节)")
    if !rawbytes.BytesEqual(record.signerPubKey, signerKey):
        return Err[bool]("cas_snapshot fetch: 请求绑定拒 (返回快照 signer != 请求 key, 拒他人快照)")
    outFound = true
    outRecord = record
    return Ok[bool](true)

# ---- P3 收尾片: 撤销新鲜度网络动词 (REVOKE_REQ/REVOKE_RESP), cas-source 协议内新 verb (先取撤销) ----
#
# 应答方 (A): 收 REVOKE_REQ(channelId,targetPubKey) → 查本地撤销库 (channel_revocations/<ch>/<target>)
# → 命中回 REVOKE_RESP(found, 169B 撤销 wire); 缺记录回 REVOKE_RESP(miss)。撤销 wire 原样透传, A 不
# 重验自己的库 (发布方对自库负责); 全部验签/授权/新鲜度在请求方 (B) 侧。
#
# 请求方 (B): REVOKE_REQ → RequestResponseNamed → REVOKE_RESP 解 → miss → revoked=false;
# found → 撤销 wire decode + 请求绑定 (A==channelId, B==targetPubKey) + RevocationVerify 授权 +
# 新鲜度 admit 入本地库 → revoked=true。接受任何 head 前对 head signer 调此 = 先取撤销闸。
#
# 协议 id 复用 25 (Libp2pProtocolCasSource); verb 由帧首字节 tag 判别 (REVOKE_REQ=0x21)。

fn casRevokeServeReq(storeRoot: str, requestPayload: Bytes): Result[Bytes] =
    let reqRes = rtcodec.RevokeReqDecode(requestPayload)
    if IsErr(reqRes):
        return Err[Bytes](strutil.Join(["cas_revoke serve: req decode: ", Error(reqRes)], ""))
    let req = Value(reqRes)
    let channelIdHex = layout.FixedBytes32Hex(req.channelId)
    let targetHex = layout.FixedBytes32Hex(req.targetPubKey)
    if !authzstore.AuthzRevocationExistsHex(storeRoot, channelIdHex, targetHex):
        return Ok[Bytes](rtcodec.RevokeRespEncodeMiss())
    let wireRes = authzstore.AuthzRevocationGetWire(storeRoot, channelIdHex, targetHex)
    if IsErr(wireRes):
        return Err[Bytes](strutil.Join(["cas_revoke serve: store get: ", Error(wireRes)], ""))
    let respRes = rtcodec.RevokeRespEncodeFound(Value(wireRes))
    if IsErr(respRes):
        return Err[Bytes](strutil.Join(["cas_revoke serve: resp encode: ", Error(respRes)], ""))
    return Ok[Bytes](Value(respRes))

# B 侧: 拉撤销状态。miss → outRevoked=false; found → 撤销 wire 三重验 (请求绑定 + 授权 + 新鲜度
# admit 入本地库) → outRevoked=true。任一验证环失败 = 硬错 (Result Err), 调用方据此拒收。
fn Libp2pHostQuicFetchRevocation(host: str,
                                   port: int32,
                                   serverName: str,
                                   storeRoot: str,
                                   channelId: layout.FixedBytes32,
                                   targetPubKey: layout.FixedBytes32,
                                   outRevoked: var bool): Result[bool] =
    outRevoked = false
    let reqPayload = rtcodec.RevokeReqEncode(channelId, targetPubKey)
    let respRes = casReqRespRetry(host, port, serverName, types.Libp2pProtocolCasSource, reqPayload)
    if IsErr(respRes):
        return Err[bool](strutil.Join([" libp2p host quic revoke fetch: ", ErrorText(respRes)], ""))
    let respMsgRes = rtcodec.RevokeRespDecode(Value(respRes))
    if IsErr(respMsgRes):
        return Err[bool](strutil.Join(["revoke fetch: resp decode: ", Error(respMsgRes)], ""))
    let respMsg = Value(respMsgRes)
    if !respMsg.found:
        outRevoked = false
        return Ok[bool](true)
    var wire = respMsg.recordWire
    let decRes = authz.AuthzRecordDecode(wire, authz.AuthzTagRevoke)
    if IsErr(decRes):
        return Err[bool](strutil.Join(["revoke fetch: 撤销 wire decode: ", Error(decRes)], ""))
    let record = Value(decRes)
    if !layout.FixedBytes32Equal(record.a, channelId) || !layout.FixedBytes32Equal(record.b, targetPubKey):
        return Err[bool](strutil.Join(["revoke fetch: 撤销记录 (channel,target) 不符请求 channel=", layout.FixedBytes32Hex(channelId)], ""))
    let admitRes = authzstore.AuthzRevocationAdmit(storeRoot, record)
    if IsErr(admitRes):
        return Err[bool](strutil.Join(["revoke fetch: ", Error(admitRes)], ""))
    outRevoked = true
    return Ok[bool](true)

# 严格端口解析 (mirror cas_fetch_env.casFetchEnvParsePort: 仅纯十进制且 1..65535; 任何非数字 /
# 越界 / 空串 = -1)。不用宽松 parseInt (吞尾垃圾), 与 let-it-crash 纪律一致。host_quic 不能 import
# cas_fetch_env (后者 import host_quic, 循环), 故此处独立镜像。
fn casRevokePeerParsePort(text: str): int32 =
    if text == "":
        return -1
    var acc: int32 = 0
    var i: int32 = 0
    while i < text.len:
        let c = text[i]
        if c < '0' || c > '9':
            return -1
        acc = acc * 10 + (Int32(c) - Int32('0'))
        if acc > 65535:
            return -1
        i = i + 1
    if acc <= 0:
        return -1
    return acc

# 撤销并集 (safety UNION, 绝非多数投票): 给定 bootstrap peer 列表 (各 "host:port", 与件2 OR 取物
# 同一列表来源 CHENG_CAS_BOOTSTRAP), 对 (channelId,targetPubKey) 向每个 peer 拉撤销状态并聚合:
#   - 任一 peer 回合法 + 请求绑定 + 授权验签 + 新鲜度 admit 通过的撤销记录 → outRevoked=true 立即
#     短路返回 (硬拒依据; 撤销 sticky, 已入本地库为合法缓存)。
#   - 任一 peer 回 miss 【绝不】作为放行依据 (一个陈旧/恶意 peer 回 miss 不能票掉另一 peer 持有的撤销)。
#   - 全部 peer 网络性失败 (非 miss) = 硬错 fail-closed: 取不到撤销状态 != 无撤销, 绝不当 miss 放行。
#   - 放行 (outRevoked=false, Ok) 仅当: 无任一 peer 命中撤销 且 ≥1 peer 给出确定性 miss (真答复)。
#
# ★ 为何 UNION 而非 quorum (第一性): 撤销是安全属性, 只要 ≥1 诚实 peer 持有即必须浮现, 故 peer 间取
#   并集。多数 quorum 在此【是安全 bug】: eclipse 多数能票掉唯一持撤销的诚实 peer, 与撤销并集语义相反
#   (对齐正典 §11.7 "≥N 独立 signer 是安全剧场")。恶意 peer 只能扣留 (回 miss / 网络错 / 伪造撤销被
#   请求绑定+ed25519 授权在 Libp2pHostQuicFetchRevocation 内拒), 不能票掉真撤销。故此口径击败少数扣留/
#   恶意 peer (撤销 ≥1 诚实持有即浮现), 【不】击败全 eclipse (所有 peer 合谋扣留 —— §11.7 未解纪律,
#   DHT 前无解), 不粉饰为抗 eclipse。
fn Libp2pHostQuicFetchRevocationUnion(peers: str[],
                                       serverName: str,
                                       storeRoot: str,
                                       channelId: layout.FixedBytes32,
                                       targetPubKey: layout.FixedBytes32,
                                       outRevoked: var bool): Result[bool] =
    outRevoked = false
    if peers.len == 0:
        return Err[bool]("revoke union: 无 bootstrap peer (需 ≥1 host:port), fail-closed 拒放行")
    var sawMiss = false
    var errs: str[]
    for i in 0..<peers.len:
        let peer = peers[i]
        let parts = strutil.Split(peer, ':')
        if parts.len != 2:
            add(errs, strutil.Join(["peer 非 host:port 形式: ", peer], ""))
            continue
        let host = strutil.Strip(parts[0])
        let portText = strutil.Strip(parts[1])
        if host == "":
            add(errs, strutil.Join(["peer host 为空: ", peer], ""))
            continue
        let port = casRevokePeerParsePort(portText)
        if port < 0:
            add(errs, strutil.Join(["peer 端口非法 (需 1..65535): ", peer], ""))
            continue
        var peerRevoked = false
        let r = Libp2pHostQuicFetchRevocation(host, port, serverName, storeRoot, channelId, targetPubKey, peerRevoked)
        if IsErr(r):
            # 网络性失败 / 伪造撤销被验证拒: 该 peer 撤销视图不可用, 记因跳过, 【绝不】据此放行。
            add(errs, strutil.Join(["peer=", peer, ": ", Error(r)], ""))
            continue
        if peerRevoked:
            # 并集命中: 任一诚实 peer 持有撤销即硬拒, 立即短路 (不必再问余下 peer)。
            outRevoked = true
            return Ok[bool](true)
        # 确定性 miss (真答复, 非网络错): 该 peer 视图 = 无撤销。
        sawMiss = true
    if !sawMiss:
        # 全部 peer 网络性失败, 零确定性 miss → fail-closed: 取不到撤销状态绝不当作无撤销放行。
        return Err[bool](strutil.Join(["revoke union: 全部 ", IntToStr(peers.len),
                                       " 个 bootstrap peer 均网络性失败 (零确定性 miss), fail-closed 拒放行 [",
                                       strutil.Join(errs, " | "), "]"], ""))
    # ≥1 peer 确定性 miss 且无任一命中 → 放行 (outRevoked 保持 false)。
    return Ok[bool](true)

# ---- P3 收尾片: 委托 head 网络分发 (DELEG_REQ/DELEG_RESP), cas-source 协议内新 verb ----
#
# 缺口: B 只知逻辑 channel L, 发布方已把签发委托给 D (0x40 cert 记录在案)。FetchCasHead 请求绑定对
# channelId=sha256(delegateKey)≠L 天然不适配, 需独立取路径。本组三件套 = 零新信任面编排 (委托 head
# 校验全部已 LIVE 在 authz_resolver, 编排器只搬字节 + 排序调用既有自证 FetchCasHead / FetchRevocation):
#
# 应答方 (A): 收 DELEG_REQ(L) → 查本地委托库 (channel_delegations/<L>) → 命中回 DELEG_RESP(found,
# 169B cert wire); 缺记录回 DELEG_RESP(miss)。cert wire 原样透传, A 对自库负责不重验。
#
# 请求方 (B) 编排器 Libp2pHostQuicResolveDelegatedHead:
#   ① 传输取 cert (FetchDelegation, 含请求绑定 cert.a==L 拒他人委托)
#   ② 先取撤销闸 (取 head 前!): 对 delegate (cert.b) 在 (L,D) 与 (sha256(D),D) 两键从网络拉撤销 → 命中即拒
#   ③ 自证取 D head (FetchCasHead 请求绑定 channelId=sha256(D); decode 自证 + 真 ed25519 验签 + 请求绑定)
#   ④ resolver 委托授权 (cert 链验签 depth-1 + notAfter 越权闸 + cert.b==head.signer; 本地撤销兜底)
# 任一环失败 = 硬错拒收 (绝不静默回落 L 直连), B 库零污染 (负路径不 TofuAdmit/不落 head 库/不拉源;
# 撤销记录网络落地是合法缓存) + 幂等 (撤销 sticky / cert 覆盖同字节 / 内容寻址)。
#
# 协议 id 复用 25 (Libp2pProtocolCasSource); verb 由帧首字节 tag 判别 (DELEG_REQ=0x23)。

fn casDelegServeReq(storeRoot: str, requestPayload: Bytes): Result[Bytes] =
    let reqRes = dtcodec.DelegReqDecode(requestPayload)
    if IsErr(reqRes):
        return Err[Bytes](strutil.Join(["cas_deleg serve: req decode: ", Error(reqRes)], ""))
    let req = Value(reqRes)
    let channelIdHex = layout.FixedBytes32Hex(req.channelId)
    if !authzstore.AuthzDelegationExistsHex(storeRoot, channelIdHex):
        return Ok[Bytes](dtcodec.DelegRespEncodeMiss())
    let wireRes = authzstore.AuthzDelegationGetWire(storeRoot, channelIdHex)
    if IsErr(wireRes):
        return Err[Bytes](strutil.Join(["cas_deleg serve: store get: ", Error(wireRes)], ""))
    let respRes = dtcodec.DelegRespEncodeFound(Value(wireRes))
    if IsErr(respRes):
        return Err[Bytes](strutil.Join(["cas_deleg serve: resp encode: ", Error(respRes)], ""))
    return Ok[Bytes](Value(respRes))

# B 侧: 取逻辑 L 的委托 cert。miss → 硬错 (无静默回落); found → cert decode + 请求绑定 (cert.a==L,
# 拒应答方塞他人 channel 的委托) → 填 outCertWire (原始 169B, 授权链在编排器/resolver)。
fn Libp2pHostQuicFetchDelegation(host: str,
                                   port: int32,
                                   serverName: str,
                                   logicalChannelId: layout.FixedBytes32,
                                   outCertWire: var Bytes): Result[bool] =
    outCertWire = EmptyBytes()
    let reqPayload = dtcodec.DelegReqEncode(logicalChannelId)
    let respRes = casReqRespRetry(host, port, serverName, types.Libp2pProtocolCasSource, reqPayload)
    if IsErr(respRes):
        return Err[bool](strutil.Join([" libp2p host quic deleg fetch: ", ErrorText(respRes)], ""))
    let respMsgRes = dtcodec.DelegRespDecode(Value(respRes))
    if IsErr(respMsgRes):
        return Err[bool](strutil.Join(["deleg fetch: resp decode: ", Error(respMsgRes)], ""))
    let respMsg = Value(respMsgRes)
    if !respMsg.found:
        return Err[bool](strutil.Join(["deleg fetch: 应答方无该 channel 委托记录 channel=", layout.FixedBytes32Hex(logicalChannelId)], ""))
    var certWire = respMsg.recordWire
    let decRes = authz.AuthzRecordDecode(certWire, authz.AuthzTagDelegate)
    if IsErr(decRes):
        return Err[bool](strutil.Join(["deleg fetch: cert decode: ", Error(decRes)], ""))
    let cert = Value(decRes)
    if !layout.FixedBytes32Equal(cert.a, logicalChannelId):
        return Err[bool](strutil.Join(["deleg fetch: 委托记录 A 不符请求 (cert.a≠L) 请求=", layout.FixedBytes32Hex(logicalChannelId), " cert.a=", layout.FixedBytes32Hex(cert.a)], ""))
    outCertWire = certWire
    return Ok[bool](true)

# 单-peer 公开入口 (向后兼容): ②先取撤销闸退化为对该单 peer 的并集 (1 元素列表 = 单点)。真多 peer
# 场景走 Libp2pHostQuicResolveDelegatedHeadWithPeers 传 bootstrap 列表, ②即跨全部 peer 撤销并集。
fn Libp2pHostQuicResolveDelegatedHead(host: str,
                                        port: int32,
                                        serverName: str,
                                        storeRoot: str,
                                        logicalChannelId: layout.FixedBytes32,
                                        outRecord: var head.ChannelHeadRecord): Result[bool] =
    var revocationPeers: str[]
    add(revocationPeers, strutil.Join([host, ":", IntToStr(port)], ""))
    return Libp2pHostQuicResolveDelegatedHeadWithPeers(host, port, serverName, revocationPeers, storeRoot, logicalChannelId, outRecord)

# B 侧编排器: 逻辑 L → 委托 D 的 head, 绑回 L 内容源。链 ①取cert→②先取撤销闸→③自证取head→④resolver授权。
# ①cert/③head 从主 peer (host,port) 自证取 (head/cert 伪造不出, 单点即安全; OR-liveness 属件2 取物层)。
# ②先取撤销闸【跨 revocationPeers 全部 bootstrap 并集】(任一命中即硬拒 / 全网络失败 fail-closed) —
#   撤销是安全属性, 必须对全部 bootstrap 取并集, 不因某 peer 回 miss 而放行 (见 FetchRevocationUnion)。
# 成功回 true 并填 outRecord (已验证的 D head 记录); 任一环失败 = 硬错拒收, B 库零污染。
fn Libp2pHostQuicResolveDelegatedHeadWithPeers(host: str,
                                        port: int32,
                                        serverName: str,
                                        revocationPeers: str[],
                                        storeRoot: str,
                                        logicalChannelId: layout.FixedBytes32,
                                        outRecord: var head.ChannelHeadRecord): Result[bool] =
    # ① 传输取 cert (含请求绑定 cert.a==L)
    var certWire = EmptyBytes()
    let fetchCertRes = Libp2pHostQuicFetchDelegation(host, port, serverName, logicalChannelId, certWire)
    if IsErr(fetchCertRes):
        return Err[bool](Error(fetchCertRes))
    let certDecRes = authz.AuthzRecordDecode(certWire, authz.AuthzTagDelegate)
    if IsErr(certDecRes):
        return Err[bool](strutil.Join(["deleg resolve: cert decode: ", Error(certDecRes)], ""))
    let cert = Value(certDecRes)
    let delegatePub = layout.FixedBytes32ToBytes(cert.b)
    let delegateChannel = head.ChannelIdForPubKey(delegatePub)   # = sha256(D), D 的自证 channelId

    # ② 先取撤销闸 (取 head 前短路): 对 delegate (cert.b) 在 (L,D) 与 (sha256(D),D) 两键【跨全部
    #    bootstrap peer 撤销并集】拉撤销状态 → 命中即硬拒 (不落 head/不 TofuAdmit); 全网络失败 fail-closed。
    var revokedL = false
    let fetchRevL = Libp2pHostQuicFetchRevocationUnion(revocationPeers, serverName, storeRoot, logicalChannelId, cert.b, revokedL)
    if IsErr(fetchRevL):
        return Err[bool](strutil.Join(["deleg resolve: 先取撤销(L): ", Error(fetchRevL)], ""))
    if revokedL:
        return Err[bool]("deleg resolve: delegate 已撤销 (先取撤销拒)")
    var revokedD = false
    let fetchRevD = Libp2pHostQuicFetchRevocationUnion(revocationPeers, serverName, storeRoot, delegateChannel, cert.b, revokedD)
    if IsErr(fetchRevD):
        return Err[bool](strutil.Join(["deleg resolve: 先取撤销(D): ", Error(fetchRevD)], ""))
    if revokedD:
        return Err[bool]("deleg resolve: delegate 已撤销 (先取撤销拒)")

    # ③ 自证取 D 的 head (FetchCasHead 请求绑定 channelId=sha256(D); 含 decode/自证/验签/请求绑定)
    var dRecord: head.ChannelHeadRecord
    let fetchHeadRes = Libp2pHostQuicFetchCasHead(host, port, serverName, delegateChannel, dRecord)
    if IsErr(fetchHeadRes):
        return Err[bool](Error(fetchHeadRes))

    # ④ resolver 委托授权: 把 D head 绑回逻辑 L (cert 链验签 depth-1 + notAfter 越权闸 + cert.b==head.signer
    #    + 本地撤销兜底)。resolver 吃 head wire, 用已验记录确定性重编码 (固定 201B, 字节等同)。
    var headEncRes = head.ChannelHeadEncode(dRecord)
    if IsErr(headEncRes):
        return Err[bool](strutil.Join(["deleg resolve: head 重编码: ", Error(headEncRes)], ""))
    var resolveRes = resolver.AuthzResolveHeadAccept(storeRoot, logicalChannelId, Value(headEncRes), true, certWire)
    if IsErr(resolveRes):
        return Err[bool](strutil.Join(["deleg resolve: ", Error(resolveRes)], ""))
    outRecord = Value(resolveRes)
    return Ok[bool](true)
