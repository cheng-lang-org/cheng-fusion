# Multistream protocol selection(minimal, synchronous).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import cheng/libp2p/utils/buffer
import cheng/libp2p/utils/varint
import std/stringlist
import cheng/libp2p/stream/lpstream
import cheng/libp2p/muxers/muxer
import cheng/libp2p/stream/connection as streamconn
const
    codecV1 = "/multistream/1.0.0"
    codecV2 = "/multistream/2.0.0"
    msgSize = 1024
    na = "na\n"
    ls = "ls\n"

type
    MultistreamSelect =
        supported: str

fn newMultistreamSelect(): MultistreamSelect =
    MultistreamSelect(supported: "")

fn addProtocol(ms: var MultistreamSelect, proto: str) =
    if len(proto) <= 0:
        return
    if len(ms.supported) == 0:
        ms.supported = proto
    else:
        ms.supported = ms.supported + "\n"
        ms.supported = ms.supported + proto

fn listContains(list: str, item: str): bool =
    if len(item) <= 0:
        return false
    var start: int32
    let total: int32 = len(list)
    for i in 0..total:
        if i == total || list[i] == '\n':
            let segLen: int32 = i - start
            if segLen > 0:
                let seg: str = SliceBytes(list, start, segLen)
                if (seg == item):
                    return true
            start = i + 1
    return false

fn supports(ms: MultistreamSelect, proto: str): bool =
    return listContains(ms.supported, proto)

fn selectProtocol(ms: MultistreamSelect, remoteList: str): Result[str] =
    var start: int32
    let total: int32 = len(remoteList)
    for i in 0..total:
        if i == total || remoteList[i] == '\n':
            let segLen: int32 = i - start
            if segLen > 0:
                let seg: str = SliceBytes(remoteList, start, segLen)
                if supports(ms, seg):
                    return Ok[str](seg)
            start = i + 1
    return Err[str]("multistream: no common protocol")

fn selectProtocolPreferLocal(ms: MultistreamSelect, remoteList: str): Result[str] =
    if len(ms.supported) <= 0:
        return Err[str]("multistream: no local protocols")
    let listRes: Result[StringList] = StringListFromLines(ms.supported)
    if IsErr(listRes):
        return Err[str](Error(listRes))
    let list: StringList = Value(listRes)
    for i in 0..<list.count:
        let proto: str = list.items[i]
        if listContains(remoteList, proto):
            return Ok[str](proto)
    return Err[str]("multistream: no common protocol")

fn ensureLine(text: str): str =
    if len(text) <= 0:
        return "\n"
    if text[len(text) - 1] == '\n':
        return text
    return text + "\n"

fn trimLine(text: str): Result[str] =
    if len(text) <= 0:
        return Err[str]("multistream: empty line")
    if text[len(text) - 1] != '\n':
        return Err[str]("multistream: missing newline")
    if len(text) == 1:
        return Ok[str]("")
    return Ok[str](SliceBytes(text, 0, len(text) - 1))

fn encodeProtocolListing(list: StringList): Bytes =
    var out: GrowByteBuffer = newByteBuffer()
    for i in 0..<list.count:
        let entry: str = ensureLine(list.items[i])
        let entryBytes: Bytes = BytesFromString(entry)
        appendBytes(out, encodeUVarint(int64(BytesLen(entryBytes))))
        appendBytes(out, entryBytes)
    appendByte(out, int32('\n'))
    return toBytes(out)

fn decodeProtocolListing(data: Bytes): StringList =
    var list: StringList = InitStringList()
    var idx: int32
    var ok: bool = true
    while idx < BytesLen(data) && ok: # cheng-syntax-policy: allow-counting-while
        if BytesGet(data, idx) == int32('\n'):
            while idx < BytesLen(data) && BytesGet(data, idx) == int32('\n'): # cheng-syntax-policy: allow-counting-while
                idx = idx + 1
            ok = idx == BytesLen(data)
            break
        let lenRes: Result[VarintDecoded] = decodeUVarint(data, idx)
        if IsErr(lenRes):
            ok = false
            break
        let dec: VarintDecoded = Value(lenRes)
        idx = dec.next
        if dec.value < 0 || dec.value > 2147483647:
            ok = false
            break
        let entryLen: int32 = int32(dec.value)
        if idx + entryLen > BytesLen(data):
            ok = false
            break
        let entryBytes: Bytes = BytesSlice(data, idx, entryLen)
        idx = idx + entryLen
        let entry: str = BytesToString(entryBytes)
        if len(entry) <= 0:
            continue
        if entry[len(entry) - 1] != '\n':
            ok = false
            break
        let proto: str = if len(entry) > 1: SliceBytes(entry, 0, len(entry) - 1) else: ""
        if len(proto) > 0:
            StringListAdd(list, proto)
    if ok && idx == BytesLen(data):
        return list
    list = InitStringList()
    let text: str = BytesToString(data)
    let listRes: Result[StringList] = StringListFromLines(text)
    if IsErr(listRes):
        return InitStringList()
    return Value(listRes)

fn handshakeDialer(stream: var Stream): Result[bool] =
    let hello: str = ensureLine(codecV1)
    let writeRes: Result[int32] = writeLp(stream, hello)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let respRes: Result[Bytes] = readLp(stream, msgSize)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: str = BytesToString(Value(respRes))
    let trimRes: Result[str] = trimLine(resp)
    if IsErr(trimRes):
        return Err[bool](Error(trimRes))
    if (Value(trimRes) != codecV1):
        return Err[bool]("multistream: handshake failed")
    return Ok[bool](true)

fn dialerHandshake(stream: var Stream): Result[bool] =
    return handshakeDialer(stream)

fn handshakeResponder(stream: var Stream): Result[bool] =
    let reqRes: Result[Bytes] = readLp(stream, msgSize)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: str = BytesToString(Value(reqRes))
    let trimRes: Result[str] = trimLine(req)
    if IsErr(trimRes):
        return Err[bool](Error(trimRes))
    if (Value(trimRes) != codecV1) && (Value(trimRes) != codecV2):
        let naRes: Result[int32] = writeLp(stream, na)
        if IsErr(naRes):
            return Err[bool](Error(naRes))
        return Err[bool]("multistream: unsupported handshake")
    let respRes: Result[int32] = writeLp(stream, ensureLine(codecV1))
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    return Ok[bool](true)

fn dialerSelectProtocol(ms: MultistreamSelect, stream: var Stream, proto: str): Result[bool] =
    let hsRes: Result[bool] = handshakeDialer(stream)
    if IsErr(hsRes):
        return Err[bool](Error(hsRes))
    let line: str = ensureLine(proto)
    let writeRes: Result[int32] = writeLp(stream, line)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let respRes: Result[Bytes] = readLp(stream, msgSize)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: str = BytesToString(Value(respRes))
    let trimRes: Result[str] = trimLine(resp)
    if IsErr(trimRes):
        return Err[bool](Error(trimRes))
    let answer: str = Value(trimRes)
    if (answer == "na"):
        return Err[bool]("multistream: protocol rejected")
    if (answer != proto):
        return Err[bool]("multistream: unexpected response")
    return Ok[bool](true)

fn dialerSelectProtocolAfterHandshake(stream: var Stream, proto: str): Result[bool] =
    if len(proto) <= 0:
        return Err[bool]("multistream: empty protocol")
    let line: str = ensureLine(proto)
    let writeRes: Result[int32] = writeLp(stream, line)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let respRes: Result[Bytes] = readLp(stream, msgSize)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: str = BytesToString(Value(respRes))
    let trimRes: Result[str] = trimLine(resp)
    if IsErr(trimRes):
        return Err[bool](Error(trimRes))
    let answer: str = Value(trimRes)
    if (answer == "na"):
        return Err[bool]("multistream: protocol rejected")
    if (answer != proto):
        return Err[bool]("multistream: unexpected response")
    return Ok[bool](true)

fn responderSelectProtocol(ms: MultistreamSelect, stream: var Stream): Result[str] =
    let hsRes: Result[bool] = handshakeResponder(stream)
    if IsErr(hsRes):
        return Err[str](Error(hsRes))
    var listRes: Result[StringList] = StringListFromLines(ms.supported)
    var supported: StringList = if IsErr(listRes): InitStringList() else: Value(listRes)
    while true:
        let msgRes: Result[Bytes] = readLp(stream, msgSize)
        if IsErr(msgRes):
            return Err[str](Error(msgRes))
        let msg: str = BytesToString(Value(msgRes))
        let trimRes: Result[str] = trimLine(msg)
        if IsErr(trimRes):
            return Err[str](Error(trimRes))
        let req: str = Value(trimRes)
        if (req == "ls"):
            let payload: Bytes = encodeProtocolListing(supported)
            let writeRes: Result[int32] = writeLp(stream, payload)
            if IsErr(writeRes):
                return Err[str](Error(writeRes))
            continue
        if StringListContains(supported, req):
            let ackRes: Result[int32] = writeLp(stream, ensureLine(req))
            if IsErr(ackRes):
                return Err[str](Error(ackRes))
            return Ok[str](req)
        let naRes: Result[int32] = writeLp(stream, na)
        if IsErr(naRes):
            return Err[str](Error(naRes))

fn dialerListProtocols(stream: var Stream): Result[StringList] =
    let writeRes: Result[int32] = writeLp(stream, ls)
    if IsErr(writeRes):
        return Err[StringList](Error(writeRes))
    let respRes: Result[Bytes] = readLp(stream, msgSize)
    if IsErr(respRes):
        return Err[StringList](Error(respRes))
    let list: StringList = decodeProtocolListing(Value(respRes))
    if StringListIsEmpty(list):
        return Err[StringList]("multistream: empty protocol list")
    return Ok[StringList](list)

fn dialerSelectProtocolWithList(ms: MultistreamSelect, stream: var Stream): Result[str] =
    let hsRes: Result[bool] = handshakeDialer(stream)
    if IsErr(hsRes):
        return Err[str](Error(hsRes))
    let listRes: Result[StringList] = dialerListProtocols(stream)
    if IsErr(listRes):
        return Err[str](Error(listRes))
    let remoteText: str = StringListToLines(Value(listRes))
    let selRes: Result[str] = selectProtocol(ms, remoteText)
    if IsErr(selRes):
        return Err[str](Error(selRes))
    let sel: str = Value(selRes)
    let sendRes: Result[bool] = dialerSelectProtocolAfterHandshake(stream, sel)
    if IsErr(sendRes):
        return Err[str](Error(sendRes))
    return Ok[str](sel)

fn dialerSelectProtocolWithListPreferLocal(ms: MultistreamSelect, stream: var Stream): Result[str] =
    let hsRes: Result[bool] = handshakeDialer(stream)
    if IsErr(hsRes):
        return Err[str](Error(hsRes))
    let listRes: Result[StringList] = dialerListProtocols(stream)
    if IsErr(listRes):
        return Err[str](Error(listRes))
    let remoteText: str = StringListToLines(Value(listRes))
    let selRes: Result[str] = selectProtocolPreferLocal(ms, remoteText)
    if IsErr(selRes):
        return Err[str](Error(selRes))
    let sel: str = Value(selRes)
    let sendRes: Result[bool] = dialerSelectProtocolAfterHandshake(stream, sel)
    if IsErr(sendRes):
        return Err[str](Error(sendRes))
    return Ok[str](sel)

fn listRemoteProtocols(ms: MultistreamSelect, stream: var Stream): Result[StringList] =
    let hsRes: Result[bool] = handshakeDialer(stream)
    if IsErr(hsRes):
        return Err[StringList](Error(hsRes))
    let writeRes: Result[int32] = writeLp(stream, ls)
    if IsErr(writeRes):
        return Err[StringList](Error(writeRes))
    let respRes: Result[Bytes] = readLp(stream, msgSize)
    if IsErr(respRes):
        return Err[StringList](Error(respRes))
    return Ok[StringList](decodeProtocolListing(Value(respRes)))

fn handshakeDialerConn(conn: var streamconn.Connection): Result[bool] =
    let hello: str = ensureLine(codecV1)
    let writeRes: Result[int32] = writeLp(conn, hello)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let respRes: Result[Bytes] = readLp(conn, msgSize)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: str = BytesToString(Value(respRes))
    let trimRes: Result[str] = trimLine(resp)
    if IsErr(trimRes):
        return Err[bool](Error(trimRes))
    if (Value(trimRes) != codecV1):
        return Err[bool]("multistream: handshake failed")
    return Ok[bool](true)

fn handshakeResponderConn(conn: var streamconn.Connection): Result[bool] =
    let reqRes: Result[Bytes] = readLp(conn, msgSize)
    if IsErr(reqRes):
        return Err[bool](Error(reqRes))
    let req: str = BytesToString(Value(reqRes))
    let trimRes: Result[str] = trimLine(req)
    if IsErr(trimRes):
        return Err[bool](Error(trimRes))
    if (Value(trimRes) != codecV1) && (Value(trimRes) != codecV2):
        let naRes: Result[int32] = writeLp(conn, na)
        if IsErr(naRes):
            return Err[bool](Error(naRes))
        return Err[bool]("multistream: unsupported handshake")
    let respRes: Result[int32] = writeLp(conn, ensureLine(codecV1))
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    return Ok[bool](true)

fn dialerSelectProtocolConn(conn: var streamconn.Connection, proto: str): Result[bool] =
    let hsRes: Result[bool] = handshakeDialerConn(conn)
    if IsErr(hsRes):
        return Err[bool](Error(hsRes))
    let line: str = ensureLine(proto)
    let writeRes: Result[int32] = writeLp(conn, line)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let respRes: Result[Bytes] = readLp(conn, msgSize)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: str = BytesToString(Value(respRes))
    let trimRes: Result[str] = trimLine(resp)
    if IsErr(trimRes):
        return Err[bool](Error(trimRes))
    let answer: str = Value(trimRes)
    if (answer == "na"):
        return Err[bool]("multistream: protocol rejected")
    if (answer != proto):
        return Err[bool]("multistream: unexpected response")
    return Ok[bool](true)

fn dialerSelectProtocolAfterHandshakeConn(conn: var streamconn.Connection, proto: str): Result[bool] =
    if len(proto) <= 0:
        return Err[bool]("multistream: empty protocol")
    let line: str = ensureLine(proto)
    let writeRes: Result[int32] = writeLp(conn, line)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    let respRes: Result[Bytes] = readLp(conn, msgSize)
    if IsErr(respRes):
        return Err[bool](Error(respRes))
    let resp: str = BytesToString(Value(respRes))
    let trimRes: Result[str] = trimLine(resp)
    if IsErr(trimRes):
        return Err[bool](Error(trimRes))
    let answer: str = Value(trimRes)
    if (answer == "na"):
        return Err[bool]("multistream: protocol rejected")
    if (answer != proto):
        return Err[bool]("multistream: unexpected response")
    return Ok[bool](true)

fn responderSelectProtocolConn(ms: MultistreamSelect, conn: var streamconn.Connection): Result[str] =
    let hsRes: Result[bool] = handshakeResponderConn(conn)
    if IsErr(hsRes):
        return Err[str](Error(hsRes))
    var listRes: Result[StringList] = StringListFromLines(ms.supported)
    var supported: StringList = if IsErr(listRes): InitStringList() else: Value(listRes)
    while true:
        let msgRes: Result[Bytes] = readLp(conn, msgSize)
        if IsErr(msgRes):
            return Err[str](Error(msgRes))
        let msg: str = BytesToString(Value(msgRes))
        let trimRes: Result[str] = trimLine(msg)
        if IsErr(trimRes):
            return Err[str](Error(trimRes))
        let req: str = Value(trimRes)
        if (req == "ls"):
            let payload: Bytes = encodeProtocolListing(supported)
            let writeRes: Result[int32] = writeLp(conn, payload)
            if IsErr(writeRes):
                return Err[str](Error(writeRes))
            continue
        if StringListContains(supported, req):
            let ackRes: Result[int32] = writeLp(conn, ensureLine(req))
            if IsErr(ackRes):
                return Err[str](Error(ackRes))
            return Ok[str](req)
        let naRes: Result[int32] = writeLp(conn, na)
        if IsErr(naRes):
            return Err[str](Error(naRes))

fn dialerListProtocolsConn(conn: var streamconn.Connection): Result[StringList] =
    let writeRes: Result[int32] = writeLp(conn, ls)
    if IsErr(writeRes):
        return Err[StringList](Error(writeRes))
    let respRes: Result[Bytes] = readLp(conn, msgSize)
    if IsErr(respRes):
        return Err[StringList](Error(respRes))
    let list: StringList = decodeProtocolListing(Value(respRes))
    if StringListIsEmpty(list):
        return Err[StringList]("multistream: empty protocol list")
    return Ok[StringList](list)

fn dialerSelectProtocolWithListPreferLocalConn(ms: MultistreamSelect, conn: var streamconn.Connection): Result[str] =
    let hsRes: Result[bool] = handshakeDialerConn(conn)
    if IsErr(hsRes):
        return Err[str](Error(hsRes))
    let listRes: Result[StringList] = dialerListProtocolsConn(conn)
    if IsErr(listRes):
        return Err[str](Error(listRes))
    let remoteText: str = StringListToLines(Value(listRes))
    let selRes: Result[str] = selectProtocolPreferLocal(ms, remoteText)
    if IsErr(selRes):
        return Err[str](Error(selRes))
    let sel: str = Value(selRes)
    let sendRes: Result[bool] = dialerSelectProtocolAfterHandshakeConn(conn, sel)
    if IsErr(sendRes):
        return Err[str](Error(sendRes))
    return Ok[str](sel)
