# Private network helper(minimal, XOR-based).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
const
    pnetKeyLength = 32
    pnetTokenLength = 16

type
    PnetConfig =
        enabled: bool
        key: Bytes
        token: Bytes

var
    pnetConfig: PnetConfig = PnetConfig(enabled: false, key: EmptyBytes(), token: EmptyBytes())

fn initPnetConfig(): PnetConfig =
    PnetConfig(enabled: false, key: EmptyBytes(), token: EmptyBytes())

fn pnetKeyValid(key: Bytes): bool =
    return BytesLen(key) == pnetKeyLength

fn pnetTokenFromKey(key: Bytes): Bytes =
    let out: Bytes = BytesAlloc(pnetTokenLength)
    for i in 0..<pnetTokenLength:
        let a: int32 = BytesGet(key, i)
        let b: int32 = BytesGet(key, i + pnetTokenLength)
        BytesSet(out, i, a ^ b)
    return out

fn setPnetKey(key: Bytes): Result[bool] =
    if ! pnetKeyValid(key):
        return Err[bool]("pnet: invalid key length")
    pnetConfig.enabled = true
    pnetConfig.key = BytesSlice(key, 0, BytesLen(key))
    pnetConfig.token = pnetTokenFromKey(key)
    return Ok[bool](true)

fn clearPnetKey() =
    pnetConfig = initPnetConfig()

fn getPnetConfig(): PnetConfig =
    pnetConfig

fn pnetEnabled(): bool =
    pnetConfig.enabled

fn pnetToken(): Bytes =
    if ! pnetConfig.enabled:
        return EmptyBytes()
    return BytesSlice(pnetConfig.token, 0, BytesLen(pnetConfig.token))

fn pnetCheckToken(token: Bytes): bool =
    if ! pnetConfig.enabled:
        return false
    if BytesLen(token) != BytesLen(pnetConfig.token):
        return false
    return BytesEqual(token, pnetConfig.token)

fn pnetXor(data: Bytes, key: Bytes): Bytes =
    if BytesLen(data) <= 0:
        return EmptyBytes()
    let out: Bytes = BytesAlloc(BytesLen(data))
    let klen: int32 = BytesLen(key)
    for i in 0..<BytesLen(data):
        let b: int32 = BytesGet(data, i)
        let k: int32 = BytesGet(key, i % klen)
        BytesSet(out, i, b ^ k)
    return out

fn pnetProtect(data: Bytes): Result[Bytes] =
    if ! pnetConfig.enabled:
        return Ok[Bytes](data)
    if ! pnetKeyValid(pnetConfig.key):
        return Err[Bytes]("pnet: invalid key")
    return Ok[Bytes](pnetXor(data, pnetConfig.key))

fn pnetUnprotect(data: Bytes): Result[Bytes] =
    return pnetProtect(data)
