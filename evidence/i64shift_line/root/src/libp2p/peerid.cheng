# PeerId(scaffold).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/strings
import cheng/libp2p/utils/bytes
import std/strings as stdstrings
import std/multiformats/multibase
import std/multiformats/multicodec
import std/multiformats/multihash
import std/varint
import cheng/libp2p/crypto/crypto
import std/multiformats/protobuf/minprotobuf

type
    PeerId = str

const
    maxInlineKeyLength = 42

fn okPeerId(id: PeerId): Result[PeerId] =
    return Ok[PeerId](id)

@borrows
fn parsePeerId(text: str): Result[PeerId] =
    if len(text) <= 0:
        return Err[PeerId]("peerid: empty")
    let mb: Result[Bytes] = decodeMultibase(stdstrings.CloneStr(text))
    if IsOk(mb):
        if ! multihash.ValidateMultihashBytes(Value(mb)):
            return Err[PeerId]("peerid: invalid multihash")
        return okPeerId(stdstrings.CloneStr(text))
    let b58: Result[Bytes] = decodeBase58(stdstrings.CloneStr(text))
    if IsErr(b58):
        return Err[PeerId]("peerid: invalid encoding")
    if ! multihash.ValidateMultihashBytes(Value(b58)):
        return Err[PeerId]("peerid: invalid multihash")
    return okPeerId(stdstrings.CloneStr(text))

fn mobileParsePeerId(text: str): Result[PeerId] =
    return parsePeerId(text)

@borrows
fn peerIdFromTextUnchecked(text: str): PeerId =
    return text

# Wraps arbitrary short bytes in an identity multihash and base58-encodes the
# result, exactly like peerIdFromPublicKey's own <= maxInlineKeyLength branch
# does for a real public key. Unlike peerIdFromTextUnchecked (which returns
# its input completely unencoded and therefore fails parsePeerId's multihash
# validation on any receiving peer), the PeerId this returns round-trips
# through parsePeerId/toBytes/ValidateMultihashBytes like any real peer id --
# it just does not assert that `data` is an actual public key, so callers
# that need discovery/wire-format correctness without running real key
# generation (e.g. crypto-free identity for a smoke test) can use it.
#
# Builds the identity-multihash bytes (varint(code=0) + varint(len) + data)
# by hand rather than via multihash.NewMultiHash/EncodeMultihash: the current
# stage3 seed miscompiles that struct-constructor pair when called across
# this module boundary (mh.code/mh.length/mh.digest all come back as
# unrelated garbage -- reproduced in isolation down to a 6-line repro,
# recvfrom-blocking-bug class, out of scope to fix the compiler here). code=0
# always fits a single varint byte; the length byte(s) come from
# std/varint's own encodeUVarint (a plain Bytes-returning function, not a
# multi-field struct constructor), which round-trips correctly.
fn peerIdFromInlineBytesUnchecked(data: Bytes): PeerId =
    let dataLen: int32 = BytesLen(data)
    let lenVarint: Bytes = encodeUVarint(int64(dataLen))
    let total: int32 = 1 + BytesLen(lenVarint) + dataLen
    let mhBytes: Bytes = BytesAlloc(total)
    BytesSet(mhBytes, 0, 0)
    for i in 0..<BytesLen(lenVarint):
        BytesSet(mhBytes, 1 + i, BytesGet(lenVarint, i))
    let base: int32 = 1 + BytesLen(lenVarint)
    for i in 0..<dataLen:
        BytesSet(mhBytes, base + i, BytesGet(data, i))
    return encodeBase58(mhBytes)

@borrows
fn toString(id: PeerId): str =
    return id

@borrows
fn toBytes(id: PeerId): Result[Bytes] =
    let mb: Result[Bytes] = decodeMultibase(id)
    if IsOk(mb):
        return mb
    return decodeBase58(id)

fn validatePeerId(id: PeerId): bool =
    let bytesRes: Result[Bytes] = toBytes(id)
    if IsErr(bytesRes):
        return false
    return multihash.ValidateMultihashBytes(Value(bytesRes))

@borrows
fn peerIdFromBytes(data: Bytes): Result[PeerId] =
    if !multihash.ValidateMultihashBytes(data):
        return Err[PeerId]("peerid: invalid multihash")
    return Ok[PeerId](encodeBase58(data))

fn hasPublicKey(id: PeerId): bool =
    let bytesRes: Result[Bytes] = toBytes(id)
    if IsErr(bytesRes):
        return false
    let mhRes: Result[multihash.MultiHash] = multihash.DecodeMultihash(Value(bytesRes))
    if IsErr(mhRes):
        return false
    return Value(mhRes).code == multicodec.CodecIdentity().code

fn extractPublicKey(id: PeerId): Result[PublicKey] =
    let bytesRes: Result[Bytes] = toBytes(id)
    if IsErr(bytesRes):
        return Err[PublicKey](Error(bytesRes))
    let mhRes: Result[multihash.MultiHash] = multihash.DecodeMultihash(Value(bytesRes))
    if IsErr(mhRes):
        return Err[PublicKey](Error(mhRes))
    let mh: multihash.MultiHash = Value(mhRes)
    if mh.code != multicodec.CodecIdentity().code:
        return Err[PublicKey]("peerid: no inline public key")
    return decodePublicKey(mh.digest)

fn peerIdFromPublicKey(pub: PublicKey): Result[PeerId] =
    let pubBytesRes: Result[Bytes] = encodePublicKey(pub)
    if IsErr(pubBytesRes):
        return Err[PeerId](Error(pubBytesRes))
    let pubBytes: Bytes = Value(pubBytesRes)
    var mhRes: Result[multihash.MultiHash]
    if BytesLen(pubBytes) <= maxInlineKeyLength:
        mhRes = multihash.Digest(pubBytes, multicodec.CodecIdentity())
    else:
        mhRes = multihash.Digest(pubBytes, multicodec.CodecSha2_256())
    if IsErr(mhRes):
        return Err[PeerId](Error(mhRes))
    let mhBytes: Bytes = multihash.EncodeMultihash(Value(mhRes))
    let text: str = encodeBase58(mhBytes)
    return okPeerId(text)

@borrows
fn peerIdMatchesPublicKey(id: PeerId, pub: PublicKey): bool =
    let idBytesRes: Result[Bytes] = toBytes(id)
    if IsErr(idBytesRes):
        return false
    let pubBytesRes: Result[Bytes] = encodePublicKey(pub)
    if IsErr(pubBytesRes):
        return false
    let pubBytes: Bytes = Value(pubBytesRes)
    var mhRes: Result[multihash.MultiHash]
    if BytesLen(pubBytes) <= maxInlineKeyLength:
        mhRes = multihash.Digest(pubBytes, multicodec.CodecIdentity())
    else:
        mhRes = multihash.Digest(pubBytes, multicodec.CodecSha2_256())
    if IsErr(mhRes):
        return false
    let mhBytes: Bytes = multihash.EncodeMultihash(Value(mhRes))
    return BytesEqual(Value(idBytesRes), mhBytes)

fn peerIdFromPrivateKey(priv: PrivateKey): Result[PeerId] =
    let pubRes: Result[PublicKey] = publicKeyFromPrivateKey(priv)
    if IsErr(pubRes):
        return Err[PeerId](Error(pubRes))
    return peerIdFromPublicKey(Value(pubRes))

fn peerIdMatchesPrivateKey(id: PeerId, priv: PrivateKey): bool =
    let pubRes: Result[PublicKey] = publicKeyFromPrivateKey(priv)
    if IsErr(pubRes):
        return false
    return peerIdMatchesPublicKey(id, Value(pubRes))

fn randomPeerId(): Result[PeerId] =
    let kpRes: Result[KeyPair] = generateKeyPair()
    if IsErr(kpRes):
        return Err[PeerId](Error(kpRes))
    return peerIdFromPublicKey(Value(kpRes).publicKey)

fn peerIdByteLen(id: PeerId): Result[int32] =
    let bytesRes: Result[Bytes] = toBytes(id)
    if IsErr(bytesRes):
        return Err[int32](Error(bytesRes))
    return Ok[int32](BytesLen(Value(bytesRes)))

fn peerIdHex(id: PeerId): Result[str] =
    let bytesRes: Result[Bytes] = toBytes(id)
    if IsErr(bytesRes):
        return Err[str](Error(bytesRes))
    return Ok[str](BytesToHex(Value(bytesRes)))

fn peerIdCmp(a: PeerId, b: PeerId): Result[int32] =
    let aBytesRes: Result[Bytes] = toBytes(a)
    if IsErr(aBytesRes):
        return Err[int32](Error(aBytesRes))
    let bBytesRes: Result[Bytes] = toBytes(b)
    if IsErr(bBytesRes):
        return Err[int32](Error(bBytesRes))
    let aBytes: Bytes = Value(aBytesRes)
    let bBytes: Bytes = Value(bBytesRes)
    let minLen: int32 = if BytesLen(aBytes) < BytesLen(bBytes): BytesLen(aBytes) else: BytesLen(bBytes)
    for i in 0..<minLen:
        let diff: int32 = BytesGet(aBytes, i) - BytesGet(bBytes, i)
        if diff != 0:
            return Ok[int32](diff)
    return Ok[int32](BytesLen(aBytes) - BytesLen(bBytes))

@borrows
fn peerIdEqual(a: PeerId, b: PeerId): Result[bool] =
    return Ok[bool](a == b)

fn write(pb: var minprotobuf.ProtoBuffer, field: int32, pid: PeerId) =
    let bytesRes: Result[Bytes] = toBytes(pid)
    if IsErr(bytesRes):
        return
    minprotobuf.writeBytes(pb, field, Value(bytesRes))

fn getField(pb: minprotobuf.ProtoBuffer, field: int32, output: var PeerId): Result[bool] =
    var raw: Bytes = EmptyBytes()
    let res: Result[bool] = minprotobuf.getField(pb, field, raw)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Ok[bool](false)
    let pidRes: Result[PeerId] = peerIdFromBytes(raw)
    if IsErr(pidRes):
        return Err[bool](Error(pidRes))
    output = Value(pidRes)
    return Ok[bool](true)

fn getRequiredField(pb: minprotobuf.ProtoBuffer, field: int32, output: var PeerId): Result[bool] =
    let res: Result[bool] = getField(pb, field, output)
    if IsErr(res):
        return Err[bool](Error(res))
    if ! Value(res):
        return Err[bool]("protobuf: required field missing")
    return Ok[bool](true)
