# #85 fix verification probe 4a: production type didauth.cheng's
# initDidAuthState() (bare-tail-expression object-constructor, no `return`
# keyword -- see didauth.cheng:43-44) called cross-module. Zero code changes
# to didauth.cheng. Mirrors revloop81_verdict.md probe12.
# Before fix: hasIdentity read back true (should be false), nonceCount
# garbage (should be 0). After fix: both correct.

import cheng/libp2p/protocols/didauth

fn main(): int32 =
    let state = initDidAuthState()
    let hasIdentityStr: str = if state.hasIdentity: "true" else: "false"
    echo("didauth probe: hasIdentity=" + hasIdentityStr + " nonceCount=" + IntToStr(state.nonceCount) + " (want false 0)")
    return 0
