fn accept(sw: var Switch): Result[muxer.Muxer] =
    if ! sw.started:
        return Err[muxer.Muxer]("switch: ! started")
    let connRes: Result[streamconn.Connection] = listenAccept(sw.listener)
    if IsErr(connRes):
        return Err[muxer.Muxer](Error(connRes))
    var conn: streamconn.Connection = Value(connRes)
    if ! allowInboundAddress(sw.gater, RemoteAddress(conn)):
        close(conn)
        return Err[muxer.Muxer]("switch: inbound address gated")
    let muxRes: Result[muxer.Muxer] = upgrade(sw.upgrader, conn, None[PeerId]())
    if IsErr(muxRes):
        close(conn)
        return Err[muxer.Muxer](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let authRes: Result[bool] = didAuthAccept(sw.didAuth, sw.peerId, mux)
    if IsErr(authRes):
        closeMuxer(mux)
        return Err[muxer.Muxer](Error(authRes))
    let peerText: str = RemotePeerId(muxerConnection(mux))
    if ! allowInboundPeerText(sw.gater, peerText):
        closeMuxer(mux)
        return Err[muxer.Muxer]("switch: inbound peer gated")
    let reserveRes: Result[bool] = reserveConnectionFor(muxerConnection(mux))
    if IsErr(reserveRes):
        closeMuxer(mux)
        return Err[muxer.Muxer](Error(reserveRes))
    let addRes: Result[bool] = addConnection(sw.connManager, muxerConnection(mux))
    if IsErr(addRes):
        releaseConnectionFor(muxerConnection(mux))
        closeMuxer(mux)
        return Err[muxer.Muxer](Error(addRes))
    let _ = switchTrimConnectionsIfNeeded(sw)
    switchRegisterPubsubPeer(peerText)
    sw.activeMuxer.has = true
    sw.activeMuxer.value = mux
    return Ok[muxer.Muxer](mux)

fn openStream(sw: var Switch): Result[Stream] =
    if ! sw.activeMuxer.has:
        return Err[Stream]("switch: no active muxer")
    var mux: muxer.Muxer = sw.activeMuxer.value
    let res: Result[Stream] = openStream(mux)
    sw.activeMuxer.has = true
    sw.activeMuxer.value = mux
    return res

fn closeActiveMuxer(sw: var Switch): Result[bool] =
    if ! sw.activeMuxer.has:
        return Err[bool]("switch: no active muxer")
    var mux: muxer.Muxer = sw.activeMuxer.value
    let conn: streamconn.Connection = muxerConnection(mux)
    closeMuxer(mux)
    var releaseErr: str
    let relRes: Result[bool] = releaseConnectionFor(conn)
    if IsErr(relRes):
        releaseErr = Error(relRes)
    let addRes: Result[bool] = addConnection(sw.connManager, conn)
    if IsErr(addRes):
        if len(releaseErr) > 0:
            return Err[bool](releaseErr)
        return Err[bool](Error(addRes))
    sw.activeMuxer = None[muxer.Muxer]()
    if len(releaseErr) > 0:
        return Err[bool](releaseErr)
    return Ok[bool](true)

fn closeAllConnections(sw: var Switch): int32 =
    if sw.activeMuxer.has:
        closeActiveMuxer(sw)
    var closed: int32
    for i in 0..<sw.connManager.count:
        if sw.connManager.items[i].open:
            let dir: int32 = if sw.connManager.items[i].dir == streamconn.Inbound: resourceDirInbound else: resourceDirOutbound
            if resourceEnabled():
                releaseConnection(dir)
            let _ = releaseOverlayConnection("", multiaddress.toString(sw.connManager.items[i].remoteAddr))
            sw.connManager.items[i].open = false
            closed = closed + 1
    return closed

