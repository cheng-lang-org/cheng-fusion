fn listenStartSlim(lt: var ListenTransport, addrText: str): Result[bool] =
    let kindRes: Result[int32] = listenKindForAddressSlim(addrText)
    if IsErr(kindRes):
        return Err[bool](Error(kindRes))
    let kind: int32 = Value(kindRes)
    var listenCopy: multiaddress.MultiAddress
    listenCopy.raw = stdstrings.CloneStr(addrText)
    if kind == listenKindMemory:
        memorytransport.start(lt.memory, listenCopy)
    elif kind == listenKindTcp:
        tcptransport.start(lt.tcp, listenCopy)
    else:
        return Err[bool]("switch: slim listen only memory/tcp")
    lt.kind = kind
    return Ok[bool](true)

fn startListenMemoryTcp(sw: var Switch): Result[bool] =
    if !sw.hasAddr:
        return Err[bool]("switch: missing listen address")
    var addrText: str
    addrText = stdstrings.CloneStr(sw.listenAddr.raw)
    let startRes: Result[bool] = listenStartSlim(sw.listener, addrText)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    sw.started = true
    return Ok[bool](true)
