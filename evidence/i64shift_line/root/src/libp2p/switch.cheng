const
    maxProtocols = 32
    identifyMaxPayload = 65536
    listenKindMemory = 0
    listenKindTcp = 1
    listenKindWs = 2
    listenKindQuic = 3
    listenKindMsQuic = 4
    listenKindTor = 5
    listenKindOpenSslQuic = 6
    listenKindWebrtcDirect = 7
    listenKindMobileHw = 8
    listenKindWebrtcStar = 9
    gossipsubIHaveFanout = 8

var
    gossipsubSeqnoCounter: int32
    gossipsubIHaveOffset: int32

type
    ProtocolList =
        count: int32
        codecs: str[]
        handlers: int32[]
        hasHandler: bool[]

    ListenTransport =
        kind: int32
        memory: MemoryTransport
        tcp: TcpTransport
        ws: WsTransport
        mobileHw: MobileHwTransport
        quic: QuicTransport
        opensslQuic: OpenSslQuicTransport
        webrtcDirect: WebrtcDirectTransport
        webrtcStar: WebrtcStarTransport
        msquic: msquictransport.MsQuicTransport
        tor: TorTransport

    Switch =
        peerId: PeerId
        privKey: PrivateKey
        listener: ListenTransport
        dialer: Dialer
        upgrader: Upgrade
        gater: ConnectionGater
        connManager: ConnManager
        peerStore: PeerStore
        started: bool
        activeMuxer: Option[muxer.Muxer]
        listenAddr: multiaddress.MultiAddress
        hasAddr: bool
        protocols: ProtocolList
        addrPriority: StringList
        didAuth: DidAuthState
        hasGlobalProfile: bool
        globalProfile: GlobalScaleProfile
        autoRoleState: AutoRoleState
        gossipIHaveFanout: int32

fn initProtocolList(): ProtocolList =
    var list: ProtocolList
    return list

fn initListenTransport(): ListenTransport =
    ListenTransport(
        kind: listenKindMemory,
        memory: initMemoryTransport(),
        tcp: initTcpTransport(),
        ws: initWsTransport(),
        mobileHw: initMobileHwTransport(),
        quic: initQuicTransport(),
        opensslQuic: initOpenSslQuicTransport(),
        webrtcDirect: initWebrtcDirectTransport(),
        webrtcStar: initWebrtcStarTransport(),
        msquic: msquictransport.InitMsQuicTransport(),
        tor: initTorTransport()
    )

@borrows
fn switchAddressHasIpOrDns(text: str): bool =
    if StrContains(text, "/ip4/") || StrContains(text, "/ip6/"):
        return true
    if StrContains(text, "/dns/") || StrContains(text, "/dns4/") || StrContains(text, "/dns6/"):
        return true
    return false

@borrows
fn switchAddressIsMemory(text: str): bool =
    return StrContains(text, "/memory/")

@borrows
fn switchAddressIsTcp(text: str): bool =
    if ! StrContains(text, "/tcp/"):
        return false
    if StrContains(text, "/wss") || StrContains(text, "/ws"):
        return false
    return switchAddressHasIpOrDns(text)

fn switchAddressIsWs(text: str): bool =
    if ! StrContains(text, "/tcp/"):
        return false
    if ! (StrContains(text, "/wss") || StrContains(text, "/ws")):
        return false
    return switchAddressHasIpOrDns(text)

fn switchAddressIsMsQuic(text: str): bool =
    if StrContains(text, "/quic-v1"):
        return true
    return StrContains(text, "/msquic")

fn switchAddressIsOpenSslQuic(text: str): bool =
    if StrContains(text, "/quic-v1/tls"):
        return true
    if StrContains(text, "/quic/tls"):
        return true
    return StrContains(text, "/tls") && StrContains(text, "/quic")

fn switchAddressIsQuic(text: str): bool =
    if StrContains(text, "/quic-v1"):
        return true
    return StrContains(text, "/quic/")

fn switchAddressIsWebrtcDirect(text: str): bool =
    if ! StrContains(text, "/webrtc-direct") && ! StrContains(text, "/p2p-webrtc-direct"):
        return false
    if ! StrContains(text, "/udp/"):
        return false
    return switchAddressHasIpOrDns(text)

fn switchAddressIsMobileHw(text: str): bool =
    if len(text) <= 0:
        return false
    if StrContains(text, "/awdl/"):
        return true
    if StrContains(text, "/nan/"):
        return true
    if StrContains(text, "/nearlink/"):
        return true
    if StrContains(text, "/nearfield/"):
        return true
    return false

fn switchAddressIsWebrtcStar(text: str): bool =
    if ! StrContains(text, "/p2p-webrtc-star"):
        return false
    return switchAddressHasIpOrDns(text)

fn switchAddressIsTor(text: str): bool =
    if StrContains(text, "/onion3/") || StrContains(text, "/onion/"):
        return true
    return false

@borrows
fn listenKindForAddress(lt: ListenTransport, addr: multiaddress.MultiAddress): Result[int32] =
    lt
    let text: str = lpMultiAddressToString(addr)
    if switchAddressIsMemory(text):
        return Ok[int32](listenKindMemory)
    if switchAddressIsWs(text):
        return Ok[int32](listenKindWs)
    if switchAddressIsMsQuic(text):
        return Ok[int32](listenKindMsQuic)
    if switchAddressIsOpenSslQuic(text):
        return Ok[int32](listenKindOpenSslQuic)
    if switchAddressIsQuic(text):
        return Ok[int32](listenKindQuic)
    if switchAddressIsWebrtcDirect(text):
        return Ok[int32](listenKindWebrtcDirect)
    if switchAddressIsMobileHw(text):
        return Ok[int32](listenKindMobileHw)
    if switchAddressIsWebrtcStar(text):
        return Ok[int32](listenKindWebrtcStar)
    if switchAddressIsTcp(text):
        return Ok[int32](listenKindTcp)
    if switchAddressIsTor(text):
        return Ok[int32](listenKindTor)
    return Err[int32]("switch: unsupported listen address")

@borrows
fn listenKindForAddressSlim(addrText: str): Result[int32] =
    if switchAddressIsMemory(addrText):
        return Ok[int32](listenKindMemory)
    if switchAddressIsTcp(addrText):
        return Ok[int32](listenKindTcp)
    return Err[int32]("switch: slim listen only memory/tcp")

@borrows
fn dialTextSlim(sw: var Switch, addrText: str): Result[bool] =
    if !sw.started:
        return Err[bool]("switch: ! started")
    if switchAddressIsMemory(addrText):
        return memorytransport.dialRawOk(sw.listener.memory, addrText)
    if switchAddressIsTcp(addrText):
        return tcptransport.dialRawOk(sw.listener.tcp, addrText)
    return Err[bool]("switch: slim dial only memory/tcp")

@borrows
fn dialPeerTextSlim(sw: var Switch, peerText: str): Result[bool] =
    return Err[bool]("switch: slim dial peer needs address")

fn listenStart(lt: var ListenTransport, addr: multiaddress.MultiAddress): Result[bool] =
    let kindRes: Result[int32] = listenKindForAddress(lt, addr)
    if IsErr(kindRes):
        return Err[bool](Error(kindRes))
    let kind: int32 = Value(kindRes)
    if kind == listenKindMemory:
        var mem: MemoryTransport = lt.memory
        memorytransport.start(mem, addr)
        lt.memory = mem
    elif kind == listenKindTcp:
        var tcp: TcpTransport = lt.tcp
        tcptransport.start(tcp, addr)
        lt.tcp = tcp
    elif kind == listenKindWs:
        var ws: WsTransport = lt.ws
        wstransport.start(ws, addr)
        lt.ws = ws
    elif kind == listenKindQuic:
        var quic: QuicTransport = lt.quic
        quictransport.start(quic, addr)
        lt.quic = quic
    elif kind == listenKindOpenSslQuic:
        var opensslQuic: OpenSslQuicTransport = lt.opensslQuic
        openssl_quic.start(opensslQuic, addr)
        lt.opensslQuic = opensslQuic
    elif kind == listenKindWebrtcDirect:
        var webrtcDirect: WebrtcDirectTransport = lt.webrtcDirect
        webrtcdirecttransport.start(webrtcDirect, addr)
        lt.webrtcDirect = webrtcDirect
    elif kind == listenKindMobileHw:
        var mobileHw: MobileHwTransport = lt.mobileHw
        mobilehwtransport.start(mobileHw, addr)
        lt.mobileHw = mobileHw
    elif kind == listenKindWebrtcStar:
        var webrtcStar: WebrtcStarTransport = lt.webrtcStar
        webrtcstartransport.start(webrtcStar, addr)
        lt.webrtcStar = webrtcStar
    elif kind == listenKindMsQuic:
        var msquic: msquictransport.MsQuicTransport = lt.msquic
        msquictransport.start(msquic, addr)
        lt.msquic = msquic
    elif kind == listenKindTor:
        var tor: TorTransport = lt.tor
        tortransport.start(tor, addr)
        lt.tor = tor
    lt.kind = kind
    return Ok[bool](true)

fn listenStop(lt: var ListenTransport) =
    if lt.kind == listenKindMemory:
        var mem: MemoryTransport = lt.memory
        stop(mem)
        lt.memory = mem
    elif lt.kind == listenKindTcp:
        var tcp: TcpTransport = lt.tcp
        stop(tcp)
        lt.tcp = tcp
    elif lt.kind == listenKindWs:
        var ws: WsTransport = lt.ws
        stop(ws)
        lt.ws = ws
    elif lt.kind == listenKindQuic:
        var quic: QuicTransport = lt.quic
        stop(quic)
        lt.quic = quic
    elif lt.kind == listenKindOpenSslQuic:
        var opensslQuic: OpenSslQuicTransport = lt.opensslQuic
        stop(opensslQuic)
        lt.opensslQuic = opensslQuic
    elif lt.kind == listenKindWebrtcDirect:
        var webrtcDirect: WebrtcDirectTransport = lt.webrtcDirect
        stop(webrtcDirect)
        lt.webrtcDirect = webrtcDirect
    elif lt.kind == listenKindMobileHw:
        var mobileHw: MobileHwTransport = lt.mobileHw
        stop(mobileHw)
        lt.mobileHw = mobileHw
    elif lt.kind == listenKindWebrtcStar:
        var webrtcStar: WebrtcStarTransport = lt.webrtcStar
        stop(webrtcStar)
        lt.webrtcStar = webrtcStar
    elif lt.kind == listenKindMsQuic:
        var msquic: msquictransport.MsQuicTransport = lt.msquic
        msquictransport.Stop(msquic)
        lt.msquic = msquic
    elif lt.kind == listenKindTor:
        var tor: TorTransport = lt.tor
        stop(tor)
        lt.tor = tor
    lt.kind = listenKindMemory

fn listenAccept(lt: var ListenTransport): Result[streamconn.Connection] =
    if lt.kind == listenKindMemory:
        var mem: MemoryTransport = lt.memory
        let res: Result[streamconn.Connection] = accept(mem)
        lt.memory = mem
        return res
    if lt.kind == listenKindTcp:
        var tcp: TcpTransport = lt.tcp
        let res: Result[streamconn.Connection] = accept(tcp)
        lt.tcp = tcp
        return res
    if lt.kind == listenKindWs:
        var ws: WsTransport = lt.ws
        let res: Result[streamconn.Connection] = accept(ws)
        lt.ws = ws
        return res
    if lt.kind == listenKindQuic:
        var quic: QuicTransport = lt.quic
        let res: Result[streamconn.Connection] = accept(quic)
        lt.quic = quic
        return res
    if lt.kind == listenKindOpenSslQuic:
        var opensslQuic: OpenSslQuicTransport = lt.opensslQuic
        let res: Result[streamconn.Connection] = accept(opensslQuic)
        lt.opensslQuic = opensslQuic
        return res
    if lt.kind == listenKindWebrtcDirect:
        var webrtcDirect: WebrtcDirectTransport = lt.webrtcDirect
        let res: Result[streamconn.Connection] = accept(webrtcDirect)
        lt.webrtcDirect = webrtcDirect
        return res
    if lt.kind == listenKindMobileHw:
        var mobileHw: MobileHwTransport = lt.mobileHw
        let res: Result[streamconn.Connection] = accept(mobileHw)
        lt.mobileHw = mobileHw
        return res
    if lt.kind == listenKindWebrtcStar:
        var webrtcStar: WebrtcStarTransport = lt.webrtcStar
        let res: Result[streamconn.Connection] = accept(webrtcStar)
        lt.webrtcStar = webrtcStar
        return res
    if lt.kind == listenKindMsQuic:
        var msquic: msquictransport.MsQuicTransport = lt.msquic
        let res: Result[streamconn.Connection] = msquictransport.accept(msquic)
        lt.msquic = msquic
        return res
    var tor: TorTransport = lt.tor
    let res: Result[streamconn.Connection] = accept(tor)
    lt.tor = tor
    return res

fn listenHandles(lt: ListenTransport, addr: multiaddress.MultiAddress): bool =
    let text: str = lpMultiAddressToString(addr)
    if lt.kind == listenKindMemory:
        return switchAddressIsMemory(text)
    if lt.kind == listenKindTcp:
        return switchAddressIsTcp(text)
    if lt.kind == listenKindWs:
        return switchAddressIsWs(text)
    if lt.kind == listenKindQuic:
        return switchAddressIsQuic(text)
    if lt.kind == listenKindOpenSslQuic:
        return switchAddressIsOpenSslQuic(text)
    if lt.kind == listenKindWebrtcDirect:
        return switchAddressIsWebrtcDirect(text)
    if lt.kind == listenKindMobileHw:
        return switchAddressIsMobileHw(text)
    if lt.kind == listenKindWebrtcStar:
        return switchAddressIsWebrtcStar(text)
    if lt.kind == listenKindMsQuic:
        return switchAddressIsMsQuic(text)
    if lt.kind == listenKindTor:
        return switchAddressIsTor(text)
    return false

fn listenDial(lt: var ListenTransport, addr: multiaddress.MultiAddress): Result[streamconn.Connection] =
    if lt.kind == listenKindMemory:
        var mem: MemoryTransport = lt.memory
        let res: Result[streamconn.Connection] = dial(mem, addr)
        lt.memory = mem
        return res
    if lt.kind == listenKindTcp:
        var tcp: TcpTransport = lt.tcp
        let res: Result[streamconn.Connection] = dial(tcp, addr)
        lt.tcp = tcp
        return res
    if lt.kind == listenKindWs:
        var ws: WsTransport = lt.ws
        let res: Result[streamconn.Connection] = dial(ws, addr)
        lt.ws = ws
        return res
    if lt.kind == listenKindQuic:
        var quic: QuicTransport = lt.quic
        let res: Result[streamconn.Connection] = dial(quic, addr)
        lt.quic = quic
        return res
    if lt.kind == listenKindOpenSslQuic:
        var opensslQuic: OpenSslQuicTransport = lt.opensslQuic
        let res: Result[streamconn.Connection] = dial(opensslQuic, addr)
        lt.opensslQuic = opensslQuic
        return res
    if lt.kind == listenKindWebrtcDirect:
        var webrtcDirect: WebrtcDirectTransport = lt.webrtcDirect
        let res: Result[streamconn.Connection] = dial(webrtcDirect, addr)
        lt.webrtcDirect = webrtcDirect
        return res
    if lt.kind == listenKindMobileHw:
        var mobileHw: MobileHwTransport = lt.mobileHw
        let res: Result[streamconn.Connection] = dial(mobileHw, addr)
        lt.mobileHw = mobileHw
        return res
    if lt.kind == listenKindWebrtcStar:
        var webrtcStar: WebrtcStarTransport = lt.webrtcStar
        let res: Result[streamconn.Connection] = dial(webrtcStar, addr)
        lt.webrtcStar = webrtcStar
        return res
    if lt.kind == listenKindMsQuic:
        var msquic: msquictransport.MsQuicTransport = lt.msquic
        let res: Result[streamconn.Connection] = msquictransport.dial(msquic, addr)
        lt.msquic = msquic
        return res
    var tor: TorTransport = lt.tor
    let res: Result[streamconn.Connection] = dial(tor, addr)
    lt.tor = tor
    return res

fn defaultAddressPriorityInto(list: var StringList) =
    StringListAdd(list, "/wss/")
    StringListAdd(list, "/ws/")
    StringListAdd(list, "/quic-v1/tls")
    StringListAdd(list, "/quic-v1/")
    StringListAdd(list, "/awdl/")
    StringListAdd(list, "/nan/")
    StringListAdd(list, "/nearlink/")
    StringListAdd(list, "/nearfield/")
    StringListAdd(list, "/webrtc-direct/")
    StringListAdd(list, "/p2p-webrtc-star/")
    StringListAdd(list, "/quic/")
    StringListAdd(list, "/tcp/")
    StringListAdd(list, "/udp/")
    StringListAdd(list, "/onion3/")
    StringListAdd(list, "/onion/")
    StringListAdd(list, "/memory/")

fn defaultAddressPriority(): StringList =
    var list: StringList = InitStringList()
    defaultAddressPriorityInto(list)
    return list

fn addressPriorityRank(list: StringList, text: str): int32 =
    for i in 0..<list.count:
        if StrContains(text, list.items[i]):
            return i
    return 9999

fn resourceDirForConnection(conn: streamconn.Connection): int32 =
    if ConnectionDirection(conn) == streamconn.Inbound:
        return resourceDirInbound
    return resourceDirOutbound

fn reserveConnectionFor(conn: streamconn.Connection): Result[bool] =
    let peerText: str = RemotePeerId(conn)
    let addrText: str = multiaddress.toString(RemoteAddress(conn))
    let overlayRes: Result[bool] = reserveOverlayConnection(peerText, addrText)
    if IsErr(overlayRes):
        return Err[bool](Error(overlayRes))
    if ! resourceEnabled():
        return Ok[bool](Value(overlayRes))
    let reserveRes: Result[bool] = reserveConnection(resourceDirForConnection(conn))
    if IsErr(reserveRes):
        let _ = releaseOverlayConnection(peerText, addrText)
        return Err[bool](Error(reserveRes))
    return Ok[bool](true)

fn releaseConnectionFor(conn: streamconn.Connection): Result[bool] =
    let peerText: str = RemotePeerId(conn)
    let addrText: str = multiaddress.toString(RemoteAddress(conn))
    let _ = releaseOverlayConnection(peerText, addrText)
    if ! resourceEnabled():
        return Ok[bool](true)
    return releaseConnection(resourceDirForConnection(conn))

fn switchTrimConnectionsIfNeeded(sw: var Switch): int32 =
    if ! connManagerNeedsTrim(sw.connManager):
        return 0
    let lowWater: int32 = connManagerLowWater(sw.connManager)
    var openCount: int32 = connManagerCountOpen(sw.connManager)
    var trimmed: int32
    for step in 0..<sw.connManager.count:
        if openCount <= lowWater:
            break
        let idx: int32 = connManagerTrimCandidate(sw.connManager)
        if idx < 0:
            break
        let addrText: str = multiaddress.toString(sw.connManager.items[idx].remoteAddr)
        let _ = releaseOverlayConnection("", addrText)
        if resourceEnabled():
            let dir: int32 = if sw.connManager.items[idx].dir == streamconn.Inbound: resourceDirInbound else: resourceDirOutbound
            let _ = releaseConnection(dir)
        if connManagerMarkClosedAt(sw.connManager, idx):
            trimmed = trimmed + 1
            openCount = openCount - 1
    return trimmed

@borrows
fn protocolListHasCodec(list: ProtocolList, codec: str): bool =
    if len(codec) <= 0:
        return false
    var i: int32
    while i < list.count:
        if list.codecs[i] == codec:
            return true
        i = i + 1
    return false

@borrows
fn protocolListText(list: ProtocolList): str =
    if list.count <= 0:
        return ""
    var out: str
    var i: int32
    while i < list.count:
        let codec: str = stdstrings.CloneStr(list.codecs[i])
        if len(out) == 0:
            out = codec
        else:
            out = out + "\n"
            out = out + codec
        i = i + 1
    return out

fn refreshSelfPeer(sw: var Switch) =
    var info: PeerInfo = newPeerInfo(stdstrings.CloneStr(sw.peerId))
    if sw.hasAddr:
        var listenCopy: MultiAddress = multiAddressFromTextUnchecked(stdstrings.CloneStr(sw.listenAddr.raw))
        addAddress(info, listenCopy)
    let protoText: str = protocolListText(sw.protocols)
    setProtocolsText(info, protoText)
    mergePeer(sw.peerStore, info)
    setKademliaPeerStore(sw.peerStore)

fn refreshIdentifyInfo(sw: var Switch) =
    setIdentifyPeerId(stdstrings.CloneStr(sw.peerId))
    if sw.hasAddr:
        var listenCopy: MultiAddress = multiAddressFromTextUnchecked(stdstrings.CloneStr(sw.listenAddr.raw))
        setIdentifyListenAddr(listenCopy)
    setIdentifyProtocols(protocolListText(sw.protocols))
    refreshSelfPeer(sw)

fn switchRegisterPubsubPeer(peerText: str) =
    if len(peerText) <= 0:
        return
    let pidRes: Result[PeerId] = parsePeerId(peerText)
    if IsErr(pidRes):
        return
    let pid: PeerId = Value(pidRes)
    let _ = floodsubAddPeer(pid)
    let _ = gossipsubAddPeer(pid)
    let _ = episubAddPeer(pid)

fn switchRemovePubsubPeer(peer: PeerId) =
    let _ = floodsubRemovePeer(peer)
    let _ = gossipsubRemovePeer(peer)
    let _ = episubRemovePeer(peer)

fn initSwitchIntoSlim(sw: var Switch) =
    initDialerInto(sw.dialer)
    initUpgradeInto(sw.upgrader)
    setUpgrade(sw.dialer, sw.upgrader)
    sw.started = false
    sw.hasAddr = false
    sw.protocols.count = 0
    defaultAddressPriorityInto(sw.addrPriority)
    sw.hasGlobalProfile = false
    sw.gossipIHaveFanout = gossipsubIHaveFanout

fn initSwitchInto(sw: var Switch, privKey: PrivateKey, peerId: PeerId) =
    var dialer: Dialer = initDialer()
    let upgrader: Upgrade = initUpgrade()
    setUpgrade(dialer, upgrader)
    addMemoryTransport(dialer, initMemoryTransport())
    addTcpTransport(dialer, initTcpTransport())
    addWsTransport(dialer, initWsTransport())
    addMobileHwTransport(dialer, initMobileHwTransport())
    addQuicTransport(dialer, initQuicTransport())
    addOpenSslQuicTransport(dialer, initOpenSslQuicTransport())
    addWebrtcDirectTransport(dialer, initWebrtcDirectTransport())
    addWebrtcStarTransport(dialer, initWebrtcStarTransport())
    addMsQuicTransport(dialer, msquictransport.InitMsQuicTransport())
    addTorTransport(dialer, initTorTransport())
    sw.peerId = peerId
    sw.privKey = privKey
    sw.listener = initListenTransport()
    sw.dialer = dialer
    sw.upgrader = upgrader
    sw.gater = initConnectionGater()
    sw.connManager = initConnManager()
    sw.peerStore = initPeerStore()
    sw.started = false
    sw.hasAddr = false
    sw.protocols = initProtocolList()
    defaultAddressPriorityInto(sw.addrPriority)
    sw.didAuth = initDidAuthState()
    sw.hasGlobalProfile = false
    sw.globalProfile = initGlobalScaleProfile()
    sw.autoRoleState = initAutoRoleState()
    sw.gossipIHaveFanout = gossipsubIHaveFanout
    refreshIdentifyInfo(sw)

fn initSwitch(privKey: PrivateKey, peerId: PeerId): Switch =
    var sw: Switch
    initSwitchInto(sw, privKey, peerId)
    return sw

fn setListenAddr(sw: var Switch, addr: multiaddress.MultiAddress) =
    sw.listenAddr = addr
    sw.hasAddr = true
    refreshIdentifyInfo(sw)

fn setListenAddrText(sw: var Switch, text: str) =
    sw.listenAddr.raw = text
    sw.hasAddr = true
    refreshIdentifyInfo(sw)

fn setListenAddrTextSlim(sw: var Switch, text: str) =
    sw.listenAddr.raw = strings.CloneStr(text)
    sw.hasAddr = true

fn setSecure(sw: var Switch, secure: var Secure) =
    var codec: str = stdstrings.CloneStr(secure.codec)
    upgrade.setSecureCodec(sw.upgrader, codec)
    setUpgrade(sw.dialer, sw.upgrader)

fn setSecureCodecOnSwitch(sw: var Switch, codec: str) =
    upgrade.setSecureCodec(sw.upgrader, codec)
    setUpgrade(sw.dialer, sw.upgrader)

fn switchMsQuicSettings(sw: var Switch): msquicruntime.MsQuicSettings =
    return msquictransport.msquicTransportSettings(sw.listener.msquic)

fn switchSetMsQuicSettings(sw: var Switch, settings: msquicruntime.MsQuicSettings): Result[bool] =
    var listenerMsQuic: msquictransport.MsQuicTransport = sw.listener.msquic
    let listenerSetRes: Result[bool] = msquictransport.setMsQuicTransportSettings(listenerMsQuic, settings)
    if IsErr(listenerSetRes):
        return Err[bool](Error(listenerSetRes))
    sw.listener.msquic = listenerMsQuic
    let dialerSetRes: Result[bool] = dialerSetMsQuicSettings(sw.dialer, settings)
    if IsErr(dialerSetRes):
        return Err[bool](Error(dialerSetRes))
    return Ok[bool](true)

fn switchApplyMsQuicNetworkSettings(
    sw: var Switch,
    allowDatagram: bool,
    maxDatagram: int32,
    minimumMtu: int32,
    maximumMtu: int32,
    migrationEnabled: bool,
    ecnEnabled: bool
): Result[bool] =
    var settings: msquicruntime.MsQuicSettings = switchMsQuicSettings(sw)
    settings.allowDatagram = allowDatagram
    settings.maxDatagram = maxDatagram
    settings.minimumMtu = minimumMtu
    settings.maximumMtu = maximumMtu
    settings.migrationEnabled = migrationEnabled
    settings.ecnEnabled = ecnEnabled
    return switchSetMsQuicSettings(sw, settings)

fn setDidAuthConfig(sw: var Switch, cfg: DidAuthConfig) =
    didauth.setDidAuthConfig(sw.didAuth, cfg)

fn setDidAuthIdentityStorePath(sw: var Switch, path: str) =
    didauth.setDidAuthIdentityStorePath(sw.didAuth, path)

fn setDidAuthIdentity(sw: var Switch, identity: DidIdentity) =
    didauth.setDidAuthIdentity(sw.didAuth, identity)
    let topicRes: Result[str] = didRevocationTopic(identity.did)
    if IsOk(topicRes):
        let _ = gossipsubSubscribe(Value(topicRes))

fn didSelf(sw: var Switch): Result[DidIdentitySummary] =
    return didAuthIdentitySummary(sw.didAuth)

fn setMuxerKind(sw: var Switch, kind: int32): Result[bool] =
    let setRes: Result[bool] = upgrade.setMuxerKind(sw.upgrader, kind)
    if IsErr(setRes):
        return Err[bool](Error(setRes))
    setUpgrade(sw.dialer, sw.upgrader)
    return Ok[bool](true)

fn setMuxerText(sw: var Switch, name: str): Result[bool] =
    if (name == "mplex"):
        return setMuxerKind(sw, muxerKindMplex)
    if (name == "yamux"):
        return setMuxerKind(sw, muxerKindYamux)
    if (name == "auto"):
        return setMuxerKind(sw, muxerKindAuto)
    return Err[bool]("switch: unknown muxer")

fn start(sw: var Switch): Result[bool] =
    if ! sw.hasAddr:
        return Err[bool]("switch: missing listen address")
    var listenCopy: multiaddress.MultiAddress
    listenCopy.raw = stdstrings.CloneStr(sw.listenAddr.raw)
    let startRes: Result[bool] = listenStart(sw.listener, listenCopy)
    if IsErr(startRes):
        return Err[bool](Error(startRes))
    sw.started = true
    return Ok[bool](true)

fn registerProtocolParts(sw: var Switch, codec: str, handler: Lp2pProtocolHandler): Result[bool] =
    if len(codec) <= 0:
        return Err[bool]("switch: empty protocol codec")
    if sw.protocols.count >= maxProtocols:
        return Err[bool]("switch: protocol limit reached")
    if protocolListHasCodec(sw.protocols, codec):
        return Err[bool]("switch: protocol already registered")
    add(sw.protocols.codecs, strings.CloneStr(codec))
    add(sw.protocols.hasHandler, true)
    sw.protocols.count = len(sw.protocols.codecs)
    handler
    refreshIdentifyInfo(sw)
    return Ok[bool](true)

fn registerProtocolPartsSlim(sw: var Switch, codec: str): Result[bool] =
    if len(codec) <= 0:
        return Err[bool]("switch: empty protocol codec")
    if sw.protocols.count >= maxProtocols:
        return Err[bool]("switch: protocol limit reached")
    if protocolListHasCodec(sw.protocols, codec):
        return Err[bool]("switch: protocol already registered")
    add(sw.protocols.codecs, strings.CloneStr(codec))
    add(sw.protocols.hasHandler, true)
    sw.protocols.count = len(sw.protocols.codecs)
    return Ok[bool](true)

fn registerProtocol(sw: var Switch, proto: var Lp2pProtocol): Result[bool] =
    let codec: str = protocolCodec(proto)
    return registerProtocolParts(sw, codec, proto.handler)

fn unregisterProtocolByCodec(sw: var Switch, codec: str): Result[bool] =
    if len(codec) <= 0:
        return Err[bool]("switch: empty protocol codec")
    var idx: int32 = -1
    var i: int32
    while i < sw.protocols.count:
        if sw.protocols.codecs[i] == codec:
            idx = i
            break
        i = i + 1
    if idx < 0:
        return Ok[bool](false)
    var j: int32 = idx
    while j + 1 < sw.protocols.count:
        sw.protocols.codecs[j] = stdstrings.CloneStr(sw.protocols.codecs[j + 1])
        sw.protocols.handlers[j] = sw.protocols.handlers[j + 1]
        sw.protocols.hasHandler[j] = sw.protocols.hasHandler[j + 1]
        j = j + 1
    let last: int32 = sw.protocols.count - 1
    sw.protocols.count = last
    setLen(sw.protocols.codecs, last)
    setLen(sw.protocols.handlers, last)
    setLen(sw.protocols.hasHandler, last)
    refreshIdentifyInfo(sw)
    return Ok[bool](true)

fn setAddressPriority(sw: var Switch, list: var StringList): Result[bool] =
    if StringListIsEmpty(list):
        return Err[bool]("switch: address priority empty")
    var i: int32
    while i < list.count:
        var addRes: Result[bool] = StringListAdd(sw.addrPriority, stdstrings.CloneStr(list.items[i]))
        if IsErr(addRes):
            return addRes
        i = i + 1
    return Ok[bool](true)

fn setAddressPriorityText(sw: var Switch, text: str): Result[bool] =
    var listRes: Result[StringList] = StringListFromLines(text)
    if !listRes.ok:
        return Err[bool]("switch: address priority parse failed")
    var list: StringList = listRes.value
    return setAddressPriority(sw, list)

fn setKademliaMode(sw: var Switch, mode: DhtMode): Result[bool] =
    if mode == dhtClient:
        setKadMode(kmClient)
        let _ = unregisterProtocolByCodec(sw, kadCodec)
    else:
        setKadMode(kmServer)
        if ! protocolListHasCodec(sw.protocols, kadCodec):
            var kadProto: Lp2pProtocol
            kademliaProtocol(kadProto)
            var regRes: Result[bool] = registerProtocol(sw, kadProto)
            if IsErr(regRes):
                return Err[bool](Error(regRes))
    if sw.hasGlobalProfile:
        sw.globalProfile.dhtMode = mode
    return Ok[bool](true)

fn switchNodeTier(sw: var Switch): NodeTier =
    if sw.hasGlobalProfile:
        return sw.globalProfile.tier
    return ntL2Routing

fn switchKademliaMode(sw: var Switch): DhtMode =
    if sw.hasGlobalProfile:
        return sw.globalProfile.dhtMode
    if kadMode() == kmClient:
        return dhtClient
    return dhtServer

fn applyGlobalScaleProfile(sw: var Switch, profile: var GlobalScaleProfile): Result[bool] =
    sw.hasGlobalProfile = profile.enabled
    if profile.enabled:
        var prio: StringList
        globalScaleAddressPriorityInto(prio)
        var priorityRes: Result[bool] = setAddressPriority(sw, prio)
        if IsErr(priorityRes):
            return Err[bool](Error(priorityRes))
    let kadRes: Result[bool] = setKademliaMode(sw, profile.dhtMode)
    if IsErr(kadRes):
        return Err[bool](Error(kadRes))
    var params: GossipsubParams = gossipsubParamsSnapshot()
    params.meshLow = profile.gossipMeshLow
    params.meshHigh = profile.gossipMeshHigh
    params.meshOutbound = profile.gossipMeshOutbound
    params.heartbeatMs = profile.gossipHeartbeatMs
    params.staggerMs = profile.gossipStaggerMs
    params.shardCount = profile.gossipShardCount
    params.shardId = profile.gossipShardId
    setGossipsubParams(params)
    setGossipsubRoutingEnabled(profile.gossipRoutingEnabled)
    peerScoringReset()
    sw.gossipIHaveFanout = if profile.gossipIHaveFanout > 0: profile.gossipIHaveFanout else: gossipsubIHaveFanout
    let waterRes: Result[bool] = setConnManagerWatermarks(sw.connManager, profile.connLowWater, profile.connHighWater)
    if IsErr(waterRes):
        return Err[bool](Error(waterRes))
    var limits: OverlayLimits = initOverlayLimits()
    limits.enabled = profile.enabled
    limits.maxConnPerPeer = profile.maxConnPerPeer
    limits.maxConnPerSubnet = profile.maxConnPerSubnet
    limits.maxStreamsPerPeer = profile.maxStreamsPerPeer
    limits.maxStreamsPerProtocol = profile.maxStreamsPerProtocol
    setResourceOverlayLimits(limits)
    resourceOverlayReset()
    var didCfg: DidAuthConfig = sw.didAuth.config
    if profile.requireDidForRouting:
        didCfg.enabled = true
        didCfg.required = true
    else:
        didCfg.required = false
    didauth.setDidAuthConfig(sw.didAuth, didCfg)
    if profile.tier == ntL1Core && profile.relayServiceEnabled:
        var relayCfg: RelayConfig = getRelayConfig()
        relayCfg.maxReservations = if profile.connHighWater > 0: profile.connHighWater else: relayCfg.maxReservations
        relayCfg.minTtlSeconds = profile.relayMinTtlSeconds
        relayCfg.maxTtlSeconds = profile.relayMaxTtlSeconds
        relayCfg.defaultTtlSeconds = profile.relayDefaultTtlSeconds
        setRelayConfig(relayCfg)
        if ! protocolListHasCodec(sw.protocols, relayCodec):
            var relayProto: Lp2pProtocol
            relayProtocol(relayProto)
            var relayReg: Result[bool] = registerProtocol(sw, relayProto)
            if IsErr(relayReg):
                return Err[bool](Error(relayReg))
    else:
        let _ = unregisterProtocolByCodec(sw, relayCodec)
    sw.globalProfile = profile
    return Ok[bool](true)

fn setNodeTier(sw: var Switch, tier: NodeTier): Result[bool] =
    var p: GlobalScaleProfile = if sw.hasGlobalProfile: sw.globalProfile else: initGlobalScaleProfileL2Routing()
    let mode: AutoRoleMode = p.autoRoleMode
    let promoteCount: int32 = p.rolePromoteRequiredCount
    let demoteCount: int32 = p.roleDemoteRequiredCount
    let cooldownMs: int64 = p.roleCooldownMs
    setProfileTier(p, tier)
    p.autoRoleMode = mode
    p.rolePromoteRequiredCount = promoteCount
    p.roleDemoteRequiredCount = demoteCount
    p.roleCooldownMs = cooldownMs
    return applyGlobalScaleProfile(sw, p)

fn setAutoRolePromotionEnabled(sw: var Switch, enabled: bool): Result[bool] =
    var p: GlobalScaleProfile = if sw.hasGlobalProfile: sw.globalProfile else: initGlobalScaleProfileL2Routing()
    setProfileAutoRolePromotionEnabled(p, enabled)
    return applyGlobalScaleProfile(sw, p)

fn supportedProtocols(sw: var Switch): str =
    return protocolListText(sw.protocols)

fn selectProtocol(sw: var Switch, remoteList: str): Result[Lp2pProtocol] =
    if sw.protocols.count <= 0:
        return Err[Lp2pProtocol]("switch: no protocol")
    var ms: MultistreamSelect = newMultistreamSelect()
    for i in 0..<sw.protocols.count:
        addProtocol(ms, protocolCodec(sw.protocols.items[i]))
    let selRes: Result[str] = selectProtocol(ms, remoteList)
    if IsErr(selRes):
        return Err[Lp2pProtocol](Error(selRes))
    let selected: str = Value(selRes)
    for i in 0..<sw.protocols.count:
        let proto: Lp2pProtocol = sw.protocols.items[i]
        if (selected == protocolCodec(proto)):
            return Ok[Lp2pProtocol](proto)
    return Err[Lp2pProtocol]("switch: selected protocol ! available")

fn selectProtocolOnStream(sw: var Switch, stream: var Stream, codec: str): Result[bool] =
    if len(codec) <= 0:
        return Err[bool]("switch: empty protocol codec")
    if sw.protocols.count <= 0:
        return Err[bool]("switch: no protocol")
    var ms: MultistreamSelect = newMultistreamSelect()
    for i in 0..<sw.protocols.count:
        addProtocol(ms, protocolCodec(sw.protocols.items[i]))
    if ! protocolListHasCodec(sw.protocols, codec):
        addProtocol(ms, codec)
    return dialerSelectProtocol(ms, stream, codec)

fn selectProtocolOnStreamAuto(sw: var Switch, stream: var Stream): Result[str] =
    if sw.protocols.count <= 0:
        return Err[str]("switch: no protocol")
    var ms: MultistreamSelect = newMultistreamSelect()
    for i in 0..<sw.protocols.count:
        addProtocol(ms, protocolCodec(sw.protocols.items[i]))
    return dialerSelectProtocolWithList(ms, stream)

fn runProtocol(sw: var Switch, stream: var Stream, remoteList: str): Result[bool] =
    remoteList
    if sw.protocols.count <= 0:
        return Err[bool]("switch: no protocol")
    var ms: MultistreamSelect = newMultistreamSelect()
    for i in 0..<sw.protocols.count:
        addProtocol(ms, protocolCodec(sw.protocols.items[i]))
    let selRes: Result[str] = responderSelectProtocol(ms, stream)
    if IsErr(selRes):
        return Err[bool](Error(selRes))
    let selected: str = Value(selRes)
    if len(selected) <= 0:
        return Err[bool]("switch: protocol selection failed")
    for i in 0..<sw.protocols.count:
        let proto: Lp2pProtocol = sw.protocols.items[i]
        if (selected == protocolCodec(proto)):
            return run(proto, stream)
    return Err[bool]("switch: selected protocol ! available")

fn openProtocolStream(sw: var Switch, mux: var muxer.Muxer, codec: str): Result[Stream] =
    let peerText: str = RemotePeerId(muxerConnection(mux))
    let overlayRes: Result[bool] = reserveOverlayProtocolStream(peerText, codec)
    if IsErr(overlayRes):
        return Err[Stream](Error(overlayRes))
    let streamRes: Result[Stream] = openStream(mux)
    if IsErr(streamRes):
        let _ = releaseOverlayProtocolStream(peerText, codec)
        return Err[Stream](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let selRes: Result[bool] = selectProtocolOnStream(sw, stream, codec)
    if IsErr(selRes):
        closeStream(stream)
        let _ = releaseOverlayProtocolStream(peerText, codec)
        return Err[Stream](Error(selRes))
    let _ = releaseOverlayProtocolStream(peerText, codec)
    return Ok[Stream](stream)

fn requestIdentify(sw: var Switch, mux: var muxer.Muxer): Result[PeerId] =
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, identifyCodec)
    if IsErr(streamRes):
        return Err[PeerId](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let payloadRes: Result[Bytes] = readLp(stream, identifyMaxPayload)
    if IsErr(payloadRes):
        closeStream(stream)
        return Err[PeerId](Error(payloadRes))
    let payload: str = BytesToString(Value(payloadRes))
    if len(payload) <= 0:
        closeStream(stream)
        return Err[PeerId]("switch: identify payload empty")
    let updateRes: Result[PeerId] = updatePeerStoreFromIdentify(sw.peerStore, payload)
    closeStream(stream)
    if IsErr(updateRes):
        return Err[PeerId](Error(updateRes))
    setKademliaPeerStore(sw.peerStore)
    return updateRes

fn pingOnMuxer(sw: var Switch, mux: var muxer.Muxer, payload: Bytes): Result[bool] =
    if BytesLen(payload) != 32:
        return Err[bool]("switch: ping payload must be 32 bytes")
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, pingCodec)
    if IsErr(streamRes):
        return Err[bool](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let writeRes: Result[int32] = muxer.write(stream, payload)
    if IsErr(writeRes):
        closeStream(stream)
        return Err[bool](Error(writeRes))
    let echoRes: Result[Bytes] = readExact(stream, 32)
    closeStream(stream)
    if IsErr(echoRes):
        return Err[bool](Error(echoRes))
    if ! BytesEqual(Value(echoRes), payload):
        return Err[bool]("switch: ping echo mismatch")
    return Ok[bool](true)

fn kadFindNodeRpc(sw: var Switch, peer: PeerId, target: Key): Result[KadMessage] =
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, peer)
    if IsErr(muxRes):
        return Err[KadMessage](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, kadCodec)
    if IsErr(streamRes):
        return Err[KadMessage](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let replyRes: Result[KadMessage] = sendFindNode(stream, target)
    closeStream(stream)
    if IsErr(replyRes):
        return Err[KadMessage](Error(replyRes))
    return replyRes

fn kadFindNodePeerId(sw: var Switch, peer: PeerId, target: PeerId): Result[KadMessage] =
    let keyRes: Result[Key] = keyFromPeerId(target)
    if IsErr(keyRes):
        return Err[KadMessage](Error(keyRes))
    return kadFindNodeRpc(sw, peer, Value(keyRes))

fn kadGetValueRpc(sw: var Switch, peer: PeerId, key: Key): Result[KadMessage] =
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, peer)
    if IsErr(muxRes):
        return Err[KadMessage](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, kadCodec)
    if IsErr(streamRes):
        return Err[KadMessage](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let replyRes: Result[KadMessage] = sendGetValue(stream, key)
    closeStream(stream)
    if IsErr(replyRes):
        return Err[KadMessage](Error(replyRes))
    return replyRes

fn kadPutValueRpc(sw: var Switch, peer: PeerId, key: Key, record: KadRecord): Result[KadMessage] =
    if kadMode() == kmClient:
        return Err[KadMessage]("kad: client mode forbids put value")
    if sw.hasGlobalProfile && ! sw.globalProfile.dhtWriteEnabled:
        return Err[KadMessage]("kad: profile forbids dht write")
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, peer)
    if IsErr(muxRes):
        return Err[KadMessage](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, kadCodec)
    if IsErr(streamRes):
        return Err[KadMessage](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let replyRes: Result[KadMessage] = sendPutValue(stream, key, record)
    closeStream(stream)
    if IsErr(replyRes):
        return Err[KadMessage](Error(replyRes))
    return replyRes

fn kadAddProviderRpc(sw: var Switch, peer: PeerId, key: Key, provider: KadPeer): Result[KadMessage] =
    if kadMode() == kmClient:
        return Err[KadMessage]("kad: client mode forbids add provider")
    if sw.hasGlobalProfile && ! sw.globalProfile.dhtProvideEnabled:
        return Err[KadMessage]("kad: profile forbids add provider")
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, peer)
    if IsErr(muxRes):
        return Err[KadMessage](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, kadCodec)
    if IsErr(streamRes):
        return Err[KadMessage](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let replyRes: Result[KadMessage] = sendAddProvider(stream, key, provider)
    closeStream(stream)
    if IsErr(replyRes):
        return Err[KadMessage](Error(replyRes))
    return replyRes

fn kadAddProviderSelf(sw: var Switch, peer: PeerId, key: Key): Result[KadMessage] =
    if kadMode() == kmClient:
        return Err[KadMessage]("kad: client mode forbids add provider self")
    if sw.hasGlobalProfile && ! sw.globalProfile.dhtProvideEnabled:
        return Err[KadMessage]("kad: profile forbids add provider self")
    let selfRes: Result[KadPeer] = peerToKadPeer(sw.peerId, sw.peerStore)
    if IsErr(selfRes):
        return Err[KadMessage](Error(selfRes))
    return kadAddProviderRpc(sw, peer, key, Value(selfRes))

fn kadGetProvidersRpc(sw: var Switch, peer: PeerId, key: Key): Result[KadMessage] =
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, peer)
    if IsErr(muxRes):
        return Err[KadMessage](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, kadCodec)
    if IsErr(streamRes):
        return Err[KadMessage](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let replyRes: Result[KadMessage] = sendGetProviders(stream, key)
    closeStream(stream)
    if IsErr(replyRes):
        return Err[KadMessage](Error(replyRes))
    return replyRes

fn didPutValueRpc(sw: var Switch, peer: PeerId, keyText: str, value: Bytes): Result[bool] =
    if len(keyText) <= 0:
        return Err[bool]("did: empty key")
    if BytesLen(value) <= 0:
        return Err[bool]("did: empty value")
    let key: Key = BytesFromString(keyText)
    var record: KadRecord = initKadRecord()
    record.hasKey = true
    record.key = key
    record.hasValue = true
    record.value = value
    let putRes: Result[KadMessage] = kadPutValueRpc(sw, peer, key, record)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    return Ok[bool](true)

fn didGetValueRpc(sw: var Switch, peer: PeerId, keyText: str): Result[Bytes] =
    if len(keyText) <= 0:
        return Err[Bytes]("did: empty key")
    let key: Key = BytesFromString(keyText)
    let getRes: Result[KadMessage] = kadGetValueRpc(sw, peer, key)
    if IsErr(getRes):
        return Err[Bytes](Error(getRes))
    let msg: KadMessage = Value(getRes)
    if ! msg.hasRecord:
        return Err[Bytes]("did: key ! found")
    if ! msg.record.hasValue:
        return Err[Bytes]("did: missing value")
    return Ok[Bytes](msg.record.value)

fn didPublishDocument(sw: var Switch, peer: PeerId): Result[bool] =
    let selfRes: Result[DidIdentitySummary] = didSelf(sw)
    if IsErr(selfRes):
        return Err[bool](Error(selfRes))
    let docKeyRes: Result[str] = didDocumentDhtKeyFromDid(Value(selfRes).did)
    if IsErr(docKeyRes):
        return Err[bool](Error(docKeyRes))
    let signedDocRes: Result[Bytes] = didAuthSignedDocument(sw.didAuth)
    if IsErr(signedDocRes):
        return Err[bool](Error(signedDocRes))
    let applyRes: Result[DidDocumentV1] = didResolverApplySignedDocument(Value(signedDocRes))
    if IsErr(applyRes):
        return Err[bool](Error(applyRes))
    return didPutValueRpc(sw, peer, Value(docKeyRes), Value(signedDocRes))

fn didResolve(sw: var Switch, peer: PeerId, did: str): Result[DidDocumentV1] =
    var cached: DidDocumentV1 = initDidDocumentV1()
    if didResolverTryGetDocument(did, cached):
        return Ok[DidDocumentV1](cached)
    let keyRes: Result[str] = didDocumentDhtKeyFromDid(did)
    if IsErr(keyRes):
        return Err[DidDocumentV1](Error(keyRes))
    let rawRes: Result[Bytes] = didGetValueRpc(sw, peer, Value(keyRes))
    if IsErr(rawRes):
        return Err[DidDocumentV1](Error(rawRes))
    return didResolverApplySignedDocument(Value(rawRes))

fn didEnrollDevice(
    sw: var Switch,
    peer: PeerId,
    devicePub: PublicKey,
    biometricClass: str,
    biometricCapabilities: StringList
): Result[Bytes] =
    var proof: Bytes = EmptyBytes()
    let enrollRes: Result[bool] = didAuthEnrollDevice(sw.didAuth, devicePub, biometricClass, biometricCapabilities, proof)
    if IsErr(enrollRes):
        return Err[Bytes](Error(enrollRes))
    let publishRes: Result[bool] = didPublishDocument(sw, peer)
    if IsErr(publishRes):
        return Err[Bytes](Error(publishRes))
    return Ok[Bytes](proof)

fn didRevokeDevice(sw: var Switch, peer: PeerId, devicePeerText: str): Result[bool] =
    var revocation: Bytes = EmptyBytes()
    let revokeRes: Result[bool] = didAuthRevokeDevice(sw.didAuth, devicePeerText, revocation)
    if IsErr(revokeRes):
        return Err[bool](Error(revokeRes))
    let publishRes: Result[bool] = didPublishDocument(sw, peer)
    if IsErr(publishRes):
        return Err[bool](Error(publishRes))
    let selfRes: Result[DidIdentitySummary] = didSelf(sw)
    if IsErr(selfRes):
        return Err[bool](Error(selfRes))
    let revKeyRes: Result[str] = didRevocationDhtKey(Value(selfRes).did, Value(selfRes).version)
    if IsErr(revKeyRes):
        return Err[bool](Error(revKeyRes))
    let putRes: Result[bool] = didPutValueRpc(sw, peer, Value(revKeyRes), revocation)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    let topicRes: Result[str] = didRevocationTopic(Value(selfRes).did)
    if IsErr(topicRes):
        return Err[bool](Error(topicRes))
    let pubRes: Result[bool] = gossipsubPublish(sw, Value(topicRes), revocation)
    if IsErr(pubRes):
        return Err[bool](Error(pubRes))
    return Ok[bool](true)

fn buildSignedPeerRecordForSwitch(sw: var Switch): Result[Bytes] =
    if ! sw.hasAddr:
        return Err[Bytes]("switch: missing listen address")
    var rec: PeerRecord = newPeerRecord(sw.peerId, 1)
    if ! peerRecordAddAddress(rec, sw.listenAddr):
        return Err[Bytes]("switch: peer record address limit reached")
    let sprRes: Result[SignedPeerRecord] = initSignedPeerRecord(sw.privKey, rec)
    if IsErr(sprRes):
        return Err[Bytes](Error(sprRes))
    return encodeSignedPeerRecord(Value(sprRes))

fn rendezvousRegister(sw: var Switch, peer: PeerId, ns: str, signedPeerRecord: Bytes, ttlSeconds: int64): Result[RendezvousRegisterResponse] =
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, peer)
    if IsErr(muxRes):
        return Err[RendezvousRegisterResponse](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, rendezvousCodec)
    if IsErr(streamRes):
        return Err[RendezvousRegisterResponse](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let useTtl: bool = ttlSeconds > 0
    let replyRes: Result[RendezvousRegisterResponse] = sendRendezvousRegister(
        stream,
        ns,
        signedPeerRecord,
        ttlSeconds,
        useTtl
    )
    closeStream(stream)
    if IsErr(replyRes):
        return Err[RendezvousRegisterResponse](Error(replyRes))
    return replyRes

fn rendezvousRegisterSelf(sw: var Switch, peer: PeerId, ns: str, ttlSeconds: int64): Result[RendezvousRegisterResponse] =
    let sprRes: Result[Bytes] = buildSignedPeerRecordForSwitch(sw)
    if IsErr(sprRes):
        return Err[RendezvousRegisterResponse](Error(sprRes))
    return rendezvousRegister(sw, peer, ns, Value(sprRes), ttlSeconds)

