fn switchRemovePeer(sw: var Switch, id: PeerId): Result[bool] =
    let remRes: Result[bool] = removePeer(sw.peerStore, id)
    if IsErr(remRes):
        return Err[bool](Error(remRes))
    if Value(remRes):
        switchRemovePubsubPeer(id)
    return Ok[bool](Value(remRes))

