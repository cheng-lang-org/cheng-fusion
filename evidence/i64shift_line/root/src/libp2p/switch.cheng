    if IsErr(rootBytesRes):
        return Err[GraphsyncMessage](Error(rootBytesRes))
    var req: GraphsyncRequest = initGraphsyncRequest()
    req.hasId = true
    req.id = 1
    req.hasRoot = true
    req.root = Value(rootBytesRes)
    if BytesLen(selector) > 0:
        req.hasSelector = true
        req.selector = selector
    var msg: GraphsyncMessage = initGraphsyncMessage()
    msg.requestCount = 1
    msg.requests[0] = req
    return graphsyncRequest(sw, peer, msg)

