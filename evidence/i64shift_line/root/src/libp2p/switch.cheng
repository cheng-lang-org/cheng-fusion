fn hostAutonatAssessAndApplyRole(sw: var Switch, peer: PeerId): Result[NodeTier] =
    if ! sw.hasGlobalProfile:
        return Err[NodeTier]("switch: global profile not enabled")
    let profile: GlobalScaleProfile = sw.globalProfile
    if profile.autoRoleMode != armPromoteOnPublic:
        return Ok[NodeTier](profile.tier)
    var isPublic: bool
    var hasAssessment: bool
    var req2: Autonatv2Request = initAutonatv2Request()
    req2.hasPeerId = true
    req2.peerId = sw.peerId
    if sw.hasAddr:
        let _ = multiAddressListAdd(req2.addrs, sw.listenAddr)
    let probeV2Res: Result[Autonatv2Response] = autonatv2Probe(sw, peer, req2)
    if IsOk(probeV2Res):
        hasAssessment = true
        isPublic = Value(probeV2Res).status == an2Ok
    if ! hasAssessment:
        var req1: AutonatDialRequest = initAutonatDialRequest()
        req1.hasPeerId = true
        req1.peerId = sw.peerId
        if sw.hasAddr:
            let _ = multiAddressListAdd(req1.addrs, sw.listenAddr)
        let probeV1Res: Result[AutonatDialResponse] = autonatProbe(sw, peer, req1)
        if IsOk(probeV1Res):
            hasAssessment = true
            isPublic = Value(probeV1Res).status == anOk
        else:
            hasAssessment = true
            isPublic = false
    var state: AutoRoleState = sw.autoRoleState
    if isPublic:
        state.consecutivePublic = state.consecutivePublic + 1
        state.consecutivePrivate = 0
    else:
        state.consecutivePrivate = state.consecutivePrivate + 1
        state.consecutivePublic = 0
    let nowMs: int64 = EpochTimeNs() / 1000000
    let cooldownMs: int64 = if profile.roleCooldownMs > 0: profile.roleCooldownMs else: 300000
    var inCooldown: bool
    if state.lastTransitionMs > 0 && cooldownMs > 0:
        inCooldown = (nowMs - state.lastTransitionMs) < cooldownMs
    if ! inCooldown:
        let promoteRequired: int32 = if profile.rolePromoteRequiredCount > 0: profile.rolePromoteRequiredCount else: 3
        let demoteRequired: int32 = if profile.roleDemoteRequiredCount > 0: profile.roleDemoteRequiredCount else: 3
        if profile.tier == ntL3Edge && state.consecutivePublic >= promoteRequired:
            let upRes: Result[bool] = setNodeTier(sw, ntL2Routing)
            if IsErr(upRes):
                return Err[NodeTier](Error(upRes))
            state.consecutivePublic = 0
            state.consecutivePrivate = 0
            state.lastTransitionMs = nowMs
        elif profile.tier == ntL2Routing && state.consecutivePrivate >= demoteRequired:
            let downRes: Result[bool] = setNodeTier(sw, ntL3Edge)
            if IsErr(downRes):
                return Err[NodeTier](Error(downRes))
            state.consecutivePublic = 0
            state.consecutivePrivate = 0
            state.lastTransitionMs = nowMs
    sw.autoRoleState = state
    return Ok[NodeTier](switchNodeTier(sw))

fn relayReserveRpc(sw: var Switch, peer: PeerId, ttlSeconds: int64): Result[RelayMessage] =
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, peer)
    if IsErr(muxRes):
        return Err[RelayMessage](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, relayCodec)
    if IsErr(streamRes):
        return Err[RelayMessage](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let replyRes: Result[RelayMessage] = relayReserveStream(stream, sw.peerId, ttlSeconds)
    closeStream(stream)
    if IsErr(replyRes):
        return Err[RelayMessage](Error(replyRes))
    return replyRes

fn relayConnectRpc(sw: var Switch, relayPeer: PeerId, dstPeer: PeerId, token: Bytes): Result[RelayMessage] =
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, relayPeer)
    if IsErr(muxRes):
        return Err[RelayMessage](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, relayCodec)
    if IsErr(streamRes):
        return Err[RelayMessage](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let replyRes: Result[RelayMessage] = relayConnectStream(stream, sw.peerId, dstPeer, token)
    closeStream(stream)
    if IsErr(replyRes):
        return Err[RelayMessage](Error(replyRes))
    return replyRes

