fn bitswapWantBlock(
    sw: var Switch,
    peer: PeerId,
    cid: Cid,
    priority: int32,
    sendDontHave: bool
): Result[BitswapMessage] =
    var entry: WantEntry = initWantEntry()
    entry.hasCid = true
    entry.cid = cid
    entry.priority = priority
    entry.cancel = false
    entry.wantType = wtBlock
    entry.sendDontHave = sendDontHave
    var list: Wantlist = initWantlist()
    list.entries[0] = entry
    list.entryCount = 1
    list.full = false
    var msg: BitswapMessage = initBitswapMessage()
    msg.hasWantlist = true
    msg.wantlist = list
    return bitswapRequest(sw, peer, msg)

