    return Ok[multiaddress.MultiAddress](sw.listenAddr)

fn switchMdnsAdvertise(sw: var Switch, service: str, namespace: str): Result[bool] =
    if ! sw.hasAddr:
        return Err[bool]("host: missing listen addr for mdns")
    var attrs: PeerAttributes = initPeerAttributes()
    let addPidRes: Result[bool] = peerAttributesAddPeerId(attrs, sw.peerId)
    if IsErr(addPidRes):
        return Err[bool](Error(addPidRes))
    let addAddrRes: Result[bool] = peerAttributesAddAddress(attrs, sw.listenAddr)
    if IsErr(addAddrRes):
        return Err[bool](Error(addAddrRes))
    if len(service) > 0:
        let addSvcRes: Result[bool] = peerAttributesAddService(attrs, service)
        if IsErr(addSvcRes):
            return Err[bool](Error(addSvcRes))
    if len(namespace) > 0:
        let addNsRes: Result[bool] = peerAttributesAddNamespace(attrs, namespace)
        if IsErr(addNsRes):
            return Err[bool](Error(addNsRes))
    return mdnsAdvertise(attrs)

fn switchMdnsDiscover(sw: var Switch, service: str, namespace: str, limit: int32): Result[int32] =
    var query: PeerAttributes = initPeerAttributes()
    if len(service) > 0:
        let addSvcRes: Result[bool] = peerAttributesAddService(query, service)
        if IsErr(addSvcRes):
            return Err[int32](Error(addSvcRes))
    if len(namespace) > 0:
        let addNsRes: Result[bool] = peerAttributesAddNamespace(query, namespace)
        if IsErr(addNsRes):
            return Err[int32](Error(addNsRes))
    var out: PeerAttributesList = initPeerAttributesList()
    let discRes: Result[bool] = mdnsDiscover(query, out)
    if IsErr(discRes):
        return Err[int32](Error(discRes))
    var filtered: PeerAttributesList = initPeerAttributesList()
    for i in 0..<out.count:
        var pid: PeerId
        if peerAttributesGetPeerId(out.items[i], pid):
            let eqRes: Result[bool] = peerIdEqual(pid, sw.peerId)
            if IsErr(eqRes):
                return Err[int32](Error(eqRes))
            if !Value(eqRes):
                let addRes: Result[bool] = peerAttributesListAdd(filtered, out.items[i])
                if IsErr(addRes):
                    return Err[int32](Error(addRes))
    return mergePeerAttributesList(sw.peerStore, filtered, limit)

fn switchBleAdvertise(sw: var Switch, service: str, namespace: str): Result[bool] =
    if !sw.hasAddr:
        return Err[bool]("host: missing listen addr for ble")
    var attrs: PeerAttributes = initPeerAttributes()
    let addPidRes: Result[bool] = peerAttributesAddPeerId(attrs, sw.peerId)
    if IsErr(addPidRes):
        return Err[bool](Error(addPidRes))
    let addAddrRes: Result[bool] = peerAttributesAddAddress(attrs, sw.listenAddr)
    if IsErr(addAddrRes):
        return Err[bool](Error(addAddrRes))
    if len(service) > 0:
        let addSvcRes: Result[bool] = peerAttributesAddService(attrs, service)
        if IsErr(addSvcRes):
            return Err[bool](Error(addSvcRes))
    if len(namespace) > 0:
        let addNsRes: Result[bool] = peerAttributesAddNamespace(attrs, namespace)
        if IsErr(addNsRes):
            return Err[bool](Error(addNsRes))
    return bleAdvertise(attrs)

fn switchBleDiscover(sw: var Switch, service: str, namespace: str, limit: int32): Result[int32] =
    var query: PeerAttributes = initPeerAttributes()
    if len(service) > 0:
        let addSvcRes: Result[bool] = peerAttributesAddService(query, service)
        if IsErr(addSvcRes):
            return Err[int32](Error(addSvcRes))
    if len(namespace) > 0:
        let addNsRes: Result[bool] = peerAttributesAddNamespace(query, namespace)
        if IsErr(addNsRes):
            return Err[int32](Error(addNsRes))
    var out: PeerAttributesList = initPeerAttributesList()
    let discRes: Result[bool] = bleDiscover(query, out)
    if IsErr(discRes):
        return Err[int32](Error(discRes))
    var filtered: PeerAttributesList = initPeerAttributesList()
    for i in 0..<out.count:
        var pid: PeerId
        if peerAttributesGetPeerId(out.items[i], pid):
            let eqRes: Result[bool] = peerIdEqual(pid, sw.peerId)
            if IsErr(eqRes):
                return Err[int32](Error(eqRes))
            if !Value(eqRes):
                let addRes: Result[bool] = peerAttributesListAdd(filtered, out.items[i])
                if IsErr(addRes):
                    return Err[int32](Error(addRes))
    return mergePeerAttributesList(sw.peerStore, filtered, limit)

