fn floodsubPublish(sw: var Switch, topic: str, data: Bytes): Result[bool] =
    var msg: PubsubMessage = initPubsubMessage()
    msg.topic = topic
    msg.data = data
    var rpc: PubsubRPC = initPubsubRPC()
    rpc.msgs[0] = msg
    rpc.msgCount = 1
    let peers: PubsubPeerIdList = floodsubPeersForTopic(topic)
    for i in 0..<peers.count:
        let sendRes: Result[bool] = floodsubSend(sw, peers.items[i], rpc)
        if IsErr(sendRes):
            return Err[bool](Error(sendRes))
    return Ok[bool](true)

