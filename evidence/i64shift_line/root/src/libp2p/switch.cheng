    if IsErr(muxRes):
        return Err[bool](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let streamRes: Result[Stream] = openProtocolStream(sw, mux, gossipsubCodec)
    if IsErr(streamRes):
        return Err[bool](Error(streamRes))
    var stream: Stream = Value(streamRes)
    let writeRes: Result[bool] = writeGossipsubRpc(stream, rpc)
    closeStream(stream)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    return Ok[bool](true)

fn gossipsubPublish(sw: var Switch, topic: str, data: Bytes): Result[bool] =
    if ! gossipsubRoutingEnabled():
        return Err[bool]("gossipsub: routing disabled")
    var msg: PubsubMessage = initPubsubMessage()
    msg.topic = topic
    msg.data = data
    if ! msg.hasSeqno || BytesLen(msg.seqno) <= 0:
        gossipsubSeqnoCounter = gossipsubSeqnoCounter + 1
        msg.hasSeqno = true
        let seqnoText = IntToStr(gossipsubSeqnoCounter)
        msg.seqno = BytesSlice(BytesFromString(seqnoText), 0, len(seqnoText))
    gossipsubCacheMessage(msg)
    var rpc: PubsubRPC = initPubsubRPC()
    rpc.msgs[0] = msg
    rpc.msgCount = 1
    let peers: PubsubPeerIdList = gossipsubPeersForTopic(topic)
    for i in 0..<peers.count:
        if peerScoreIsGraylisted(stdstrings.CloneStr(peerid.toString(peers.items[i]))):
            continue
        let sendRes: Result[bool] = gossipsubSend(sw, peers.items[i], rpc)
        if IsErr(sendRes):
            return Err[bool](Error(sendRes))
    let gossipPeers: PubsubPeerIdList = gossipsubAllPeersForTopic(topic)
    if msg.hasSeqno && BytesLen(msg.seqno) > 0:
        var ihave: PubsubControlIHave = initPubsubControlIHave()
        ihave.topic = topic
        ihave.msgIdCount = 1
        ihave.msgIds[0] = msg.seqno
        var control: PubsubControl = initPubsubControl()
        control.ihaveCount = 1
        control.ihaves[0] = ihave
        var ctrlRpc: PubsubRPC = initPubsubRPC()
        ctrlRpc.hasControl = true
        ctrlRpc.control = control
        var sent: int32
        var start: int32
        if gossipPeers.count > 0:
            start = gossipsubIHaveOffset % gossipPeers.count
            gossipsubIHaveOffset = gossipsubIHaveOffset + 1
        for iter in 0..<gossipPeers.count:
            if ! (iter < gossipPeers.count && sent < sw.gossipIHaveFanout):
                break
            let idx: int32 = (start + iter) % gossipPeers.count
            let peer: PeerId = gossipPeers.items[idx]
            if peerScoreIsGraylisted(stdstrings.CloneStr(peerid.toString(peer))):
                continue
            if ! gossipsubPeerInMesh(topic, peer):
                let sendRes: Result[bool] = gossipsubSend(sw, peer, ctrlRpc)
                if IsErr(sendRes):
                    return Err[bool](Error(sendRes))
                sent = sent + 1
    return Ok[bool](true)

fn gossipsubHeartbeat(sw: var Switch): Result[bool] =
    if ! gossipsubRoutingEnabled():
        return Ok[bool](true)
    let topics: GossipsubMeshTopicList = gossipsubMeshTopics()
    let params: GossipsubParams = gossipsubParamsSnapshot()
    for t in 0..<topics.count:
        let topic: str = topics.topics[t]
        var meshCount: int32 = gossipsubMeshPeerCountForTopic(topic)
        let allPeers: PubsubPeerIdList = gossipsubAllPeersForTopic(topic)
        var i: int32
        for i in 0..<allPeers.count:
            if ! (meshCount < params.meshLow && i < allPeers.count):
                break
            let peer: PeerId = allPeers.items[i]
            if peerScoreIsGraylisted(stdstrings.CloneStr(peerid.toString(peer))):
                continue
            if ! gossipsubPeerInMesh(topic, peer):
                let addRes: Result[bool] = gossipsubAddMeshPeer(topic, peer)
                if IsErr(addRes):
                    return Err[bool](Error(addRes))
                if Value(addRes):
                    var ctrl: PubsubControl = initPubsubControl()
                    ctrl.graftCount = 1
                    ctrl.grafts[0] = PubsubControlGraft(topic: topic)
                    var rpc: PubsubRPC = initPubsubRPC()
                    rpc.hasControl = true
                    rpc.control = ctrl
                    let sendRes: Result[bool] = gossipsubSend(sw, peer, rpc)
                    if IsErr(sendRes):
                        return Err[bool](Error(sendRes))
                    meshCount = meshCount + 1
        if meshCount > params.meshHigh:
            let meshPeers: PubsubPeerIdList = gossipsubMeshPeersForTopic(topic)
            var j: int32 = meshPeers.count - 1
            let loop_start_j_2 = j
            for loop_rev_j_2 in 0..(loop_start_j_2 - (0)):
                j = loop_start_j_2 - loop_rev_j_2
                if ! (meshCount > params.meshHigh && j >= 0):
                    break
                let peer: PeerId = meshPeers.items[j]
                let removeRes: Result[bool] = gossipsubRemoveMeshPeer(topic, peer)
                if IsErr(removeRes):
                    return Err[bool](Error(removeRes))
                if Value(removeRes):
                    var ctrl: PubsubControl = initPubsubControl()
                    ctrl.pruneCount = 1
                    ctrl.prunes[0] = PubsubControlPrune(topic: topic)
                    var rpc: PubsubRPC = initPubsubRPC()
                    rpc.hasControl = true
                    rpc.control = ctrl
                    let sendRes: Result[bool] = gossipsubSend(sw, peer, rpc)
                    if IsErr(sendRes):
                        return Err[bool](Error(sendRes))
                    meshCount = meshCount - 1
    return Ok[bool](true)

