fn lookupPeerListFromPeerIdList(list: PeerIdList): LookupPeerList =
    var out: LookupPeerList = initLookupPeerList()
    for i in 0..<list.count:
        if ! (i < list.count && out.count < maxLookupPeers):
            break
        lookupPeerListAdd(out, list.items[i])
    return out

fn lookupPeerListToPeerIdList(list: LookupPeerList): PeerIdList =
    var out: PeerIdList = PeerIdList(count: 0)
    for i in 0..<list.count:
        if ! (i < list.count && out.count < maxClosestKeys):
            break
        add(out.items, list.items[i])
        out.count = out.items.len
    return out

fn kadFindNodeIterative(sw: var Switch, target: Key, rounds: int32): Result[PeerIdList] =
    if ! kademliaContextReady():
        return Err[PeerIdList]("kad: missing context")
    var state: KadState
    if ! kademliaTryGetState(state):
        return Err[PeerIdList]("kad: missing state")
    let initialPeers: PeerIdList = findClosestPeers(state.routing, target, defaultReplic)
    var lookup: LookupState = initLookupState(target, lookupPeerListFromPeerIdList(initialPeers), state.routing.hasher)
    let maxRounds: int32 = if rounds <= 0: 1 else: rounds
    for step in 0..<maxRounds:
        if ! (step < maxRounds):
            break
        let batch: LookupPeerList = selectAlphaPeers(lookup)
        if batch.count <= 0:
            break
        var i: int32
        for i in 0..<batch.count:
            if ! (i < batch.count):
                break
            let pid: PeerId = batch.items[i]
            let eqRes: Result[bool] = peerIdEqual(pid, sw.peerId)
            if IsOk(eqRes) && Value(eqRes):
                continue
            markPending(lookup, pid)
            lookup.activeQueries = lookup.activeQueries + 1
            let replyRes: Result[KadMessage] = kadFindNodeRpc(sw, pid, target)
            if IsErr(replyRes):
                markFailed(lookup, pid)
            else:
                let reply: KadMessage = Value(replyRes)
                updateShortlist(lookup, reply, sw.peerStore, state.routing.hasher)
                setKademliaPeerStore(sw.peerStore)
    for j in 0..<lookup.shortlistCount:
        kadInsertPeer(state, lookup.shortlist[j].peerId)
    setKademliaState(state)
    let closest: LookupPeerList = selectClosestK(lookup)
    return Ok[PeerIdList](lookupPeerListToPeerIdList(closest))

fn kadFindNodeIterativePeerId(sw: var Switch, target: PeerId, rounds: int32): Result[PeerIdList] =
    let keyRes: Result[Key] = keyFromPeerId(target)
    if IsErr(keyRes):
        return Err[PeerIdList](Error(keyRes))
    return kadFindNodeIterative(sw, Value(keyRes), rounds)

fn identifyPeer(sw: var Switch, id: PeerId): Result[PeerId] =
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, id)
    if IsErr(muxRes):
        return Err[PeerId](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    return requestIdentify(sw, mux)

fn identifyPeerWithProtocol(sw: var Switch, proto: str): Result[PeerId] =
    let muxRes: Result[muxer.Muxer] = dialPeerWithProtocol(sw, proto)
    if IsErr(muxRes):
        return Err[PeerId](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    return requestIdentify(sw, mux)

fn pingPeerWithPayload(sw: var Switch, id: PeerId, payload: Bytes): Result[bool] =
    let muxRes: Result[muxer.Muxer] = dialPeer(sw, id)
    if IsErr(muxRes):
        return Err[bool](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    return pingOnMuxer(sw, mux, payload)

fn pingPeer(sw: var Switch, id: PeerId): Result[bool] =
    let payloadRes: Result[Bytes] = rand.randomBytes(32)
    if IsErr(payloadRes):
        return Err[bool](Error(payloadRes))
    return pingPeerWithPayload(sw, id, Value(payloadRes))

fn pingPeerWithProtocol(sw: var Switch, proto: str): Result[bool] =
    let muxRes: Result[muxer.Muxer] = dialPeerWithProtocol(sw, proto)
    if IsErr(muxRes):
        return Err[bool](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let payloadRes: Result[Bytes] = rand.randomBytes(32)
    if IsErr(payloadRes):
        return Err[bool](Error(payloadRes))
    return pingOnMuxer(sw, mux, Value(payloadRes))

fn stop(sw: var Switch) =
    listenStop(sw.listener)
    closeAllConnections(sw)
    sw.started = false
    sw.activeMuxer = None[muxer.Muxer]()

fn dial(sw: var Switch, addr: multiaddress.MultiAddress): Result[muxer.Muxer] =
    if ! sw.started:
        return Err[muxer.Muxer]("switch: ! started")
    if ! connectiongater.AllowDialAddress(sw.gater, addr):
        return Err[muxer.Muxer]("switch: dial address gated")
    if listenHandles(sw.listener, addr):
        let connRes: Result[streamconn.Connection] = listenDial(sw.listener, addr)
        if IsErr(connRes):
            return Err[muxer.Muxer](Error(connRes))
        var conn: streamconn.Connection = Value(connRes)
        let muxRes: Result[muxer.Muxer] = upgrade(sw.upgrader, conn, None[PeerId]())
        if IsErr(muxRes):
            close(conn)
            return Err[muxer.Muxer](Error(muxRes))
        var mux: muxer.Muxer = Value(muxRes)
        let authRes: Result[bool] = didAuthDial(sw.didAuth, sw.peerId, mux)
        if IsErr(authRes):
            closeMuxer(mux)
            return Err[muxer.Muxer](Error(authRes))
        let peerText: str = RemotePeerId(muxerConnection(mux))
        if ! allowDialPeerText(sw.gater, peerText):
            closeMuxer(mux)
            return Err[muxer.Muxer]("switch: dial peer gated")
        let reserveRes: Result[bool] = reserveConnectionFor(muxerConnection(mux))
        if IsErr(reserveRes):
            closeMuxer(mux)
            return Err[muxer.Muxer](Error(reserveRes))
        let addRes: Result[bool] = addConnection(sw.connManager, muxerConnection(mux))
        if IsErr(addRes):
            releaseConnectionFor(muxerConnection(mux))
            closeMuxer(mux)
            return Err[muxer.Muxer](Error(addRes))
        let _ = switchTrimConnectionsIfNeeded(sw)
        switchRegisterPubsubPeer(peerText)
        sw.activeMuxer.has = true
        sw.activeMuxer.value = mux
        return Ok[muxer.Muxer](mux)
    let muxRes: Result[muxer.Muxer] = dialAddress(sw.dialer, addr)
    if IsErr(muxRes):
        return Err[muxer.Muxer](Error(muxRes))
    var mux: muxer.Muxer = Value(muxRes)
    let authRes: Result[bool] = didAuthDial(sw.didAuth, sw.peerId, mux)
    if IsErr(authRes):
        closeMuxer(mux)
        return Err[muxer.Muxer](Error(authRes))
    let peerText: str = RemotePeerId(muxerConnection(mux))
    if ! allowDialPeerText(sw.gater, peerText):
        closeMuxer(mux)
        return Err[muxer.Muxer]("switch: dial peer gated")
    let reserveRes: Result[bool] = reserveConnectionFor(muxerConnection(mux))
    if IsErr(reserveRes):
        closeMuxer(mux)
        return Err[muxer.Muxer](Error(reserveRes))
    let addRes: Result[bool] = addConnection(sw.connManager, muxerConnection(mux))
    if IsErr(addRes):
        releaseConnectionFor(muxerConnection(mux))
        closeMuxer(mux)
        return Err[muxer.Muxer](Error(addRes))
    let _ = switchTrimConnectionsIfNeeded(sw)
    switchRegisterPubsubPeer(peerText)
    sw.activeMuxer.has = true
    sw.activeMuxer.value = mux
    return Ok[muxer.Muxer](mux)

fn datagramWrite(sw: var Switch, conn: var streamconn.Connection, data: Bytes): Result[int32] =
    if conn.dir == streamconn.Outbound:
        let dialRes: Result[int32] = dialerMsQuicDatagramWrite(sw.dialer, conn, data)
        if IsOk(dialRes):
            return dialRes
        if sw.listener.kind == listenKindMsQuic:
            var msq: msquictransport.MsQuicTransport = sw.listener.msquic
            let listenRes: Result[int32] = msquictransport.msquicTransportDatagramWrite(msq, conn, data)
            sw.listener.msquic = msq
            if IsOk(listenRes):
                return listenRes
        return dialRes
    if sw.listener.kind == listenKindMsQuic:
        var msq: msquictransport.MsQuicTransport = sw.listener.msquic
        let listenRes: Result[int32] = msquictransport.msquicTransportDatagramWrite(msq, conn, data)
        sw.listener.msquic = msq
        if IsOk(listenRes):
            return listenRes
    return dialerMsQuicDatagramWrite(sw.dialer, conn, data)

fn datagramRead(sw: var Switch, conn: var streamconn.Connection): Result[Bytes] =
    if conn.dir == streamconn.Outbound:
        let dialRes: Result[Bytes] = dialerMsQuicDatagramRead(sw.dialer, conn)
        if IsOk(dialRes):
            return dialRes
        if sw.listener.kind == listenKindMsQuic:
            var msq: msquictransport.MsQuicTransport = sw.listener.msquic
            let listenRes: Result[Bytes] = msquictransport.msquicTransportDatagramRead(msq, conn)
            sw.listener.msquic = msq
            if IsOk(listenRes):
                return listenRes
        return dialRes
    if sw.listener.kind == listenKindMsQuic:
        var msq: msquictransport.MsQuicTransport = sw.listener.msquic
        let listenRes: Result[Bytes] = msquictransport.msquicTransportDatagramRead(msq, conn)
        sw.listener.msquic = msq
        if IsOk(listenRes):
            return listenRes
    return dialerMsQuicDatagramRead(sw.dialer, conn)

fn trySelectDialAddress(sw: var Switch, peer: PeerInfo, outAddr: var multiaddress.MultiAddress): bool =
    var bestRank: int32 = 9999
    var bestFound: bool
    var bestAddr: multiaddress.MultiAddress
    for i in 0..<peer.addrs.count:
        let addr: multiaddress.MultiAddress = peer.addrs.items[i]
        if canDialAddress(sw.dialer, addr) && connectiongater.AllowDialAddress(sw.gater, addr):
            let text: str = lpMultiAddressToString(addr)
            let rank: int32 = addressPriorityRank(sw.addrPriority, text)
            if rank < bestRank:
                bestRank = rank
                bestFound = true
                bestAddr = addr
    if bestFound:
        outAddr = bestAddr
        return true
    for i in 0..<peer.addrs.count:
        let addr: multiaddress.MultiAddress = peer.addrs.items[i]
        if listenHandles(sw.listener, addr) && connectiongater.AllowDialAddress(sw.gater, addr):
            outAddr = addr
            return true
    return false

fn selectDialAddress(sw: var Switch, peer: PeerInfo): Option[multiaddress.MultiAddress] =
    var addr: multiaddress.MultiAddress
    if trySelectDialAddress(sw, peer, addr):
        var found: Option[multiaddress.MultiAddress]
        found.has = true
        found.value = addr
        return found
    return None[multiaddress.MultiAddress]()

fn dialPeer(sw: var Switch, id: PeerId): Result[muxer.Muxer] =
    if ! allowDialPeer(sw.gater, id):
        return Err[muxer.Muxer]("switch: dial peer gated")
    let peerRes: Result[PeerInfo] = getPeer(sw.peerStore, id)
    if IsErr(peerRes):
        return Err[muxer.Muxer](Error(peerRes))
    var addr: multiaddress.MultiAddress
    if ! trySelectDialAddress(sw, Value(peerRes), addr):
        return Err[muxer.Muxer]("switch: peer has no address")
    return dial(sw, addr)

fn dialPeerWithProtocol(sw: var Switch, proto: str): Result[muxer.Muxer] =
    var found: bool
    var bestRank: int32 = 9999
    var bestAddr: multiaddress.MultiAddress
    for i in 0..<sw.peerStore.count:
        if ! (i < sw.peerStore.count):
            break
        let peer: PeerInfo = sw.peerStore.items[i]
        if ! allowDialPeer(sw.gater, peer.id):
            continue
        if protocolsContain(peer, proto):
            var addr: multiaddress.MultiAddress
            if trySelectDialAddress(sw, peer, addr):
                let text: str = multiaddress.toString(addr)
                let rank: int32 = addressPriorityRank(sw.addrPriority, text)
                if ! found || rank < bestRank:
                    found = true
                    bestRank = rank
                    bestAddr = addr
    if ! found:
        return Err[muxer.Muxer]("switch: no dialable peer for protocol")
    return dial(sw, bestAddr)

