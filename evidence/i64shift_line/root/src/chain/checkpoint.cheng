# checkpoint.cheng - signed state checkpoints and median-of-last-K time.
#
# A checkpoint binds {commit sequence hash, state hash} under a committee
# certificate. The certificate's proposalHash field carries
#   CheckpointDigest = sha512("rwad.checkpoint" || commitHash || stateHash)
# truncated to 32 bytes, so a light client re-derives the digest from the
# advertised hashes and verifies the certificate against it: swapping either
# hash invalidates every signature.
#
# Block timestamps follow median-of-last-K (Ethereum rule): a proposer must
# stamp its block with the median of the previous K block timestamps, which
# caps single-validator manipulation at floor(K/2) slots of drift.

import std/system
import std/rawbytes
import std/result
import std/crypto/sha512 as sha512
import cheng/std/bytes_layout as layout
import cheng/chain/finality_certificate as fcert

const
    CkptSeedPrefix: str = "rwad.checkpoint"

# Digest that the committee signs for one checkpoint.
fn CheckpointDigest(commitHash: layout.FixedBytes32,
                    stateHash: layout.FixedBytes32): layout.FixedBytes32 =
    let prefix = BytesFromString(CkptSeedPrefix)
    let total: int32 = prefix.len + 64
    var buf = BytesAlloc(total)
    var i: int32
    while i < prefix.len:
        BytesSet(buf, i, BytesGet(prefix, i))
        i = i + 1
    let chBytes = layout.FixedBytes32ToBytes(commitHash)
    let stBytes = layout.FixedBytes32ToBytes(stateHash)
    var j: int32
    while j < 32:
        BytesSet(buf, prefix.len + j, BytesGet(chBytes, j))
        BytesSet(buf, prefix.len + 32 + j, BytesGet(stBytes, j))
        j = j + 1
    let d = sha512.Sha512Digest(buf)
    BytesFree(buf)
    let res = layout.FixedBytes32FromBytes(BytesSlice(d, 0, 32))
    return res.value

# Light-client check: re-derive the binding digest and verify the embedded
# certificate against it plus the committee set.
fn CheckpointVerifyBinding(certProposalHash: layout.FixedBytes32,
                           commitHash: layout.FixedBytes32,
                           stateHash: layout.FixedBytes32): bool =
    let expect = CheckpointDigest(commitHash, stateHash)
    return layout.FixedBytes32Equal(expect, certProposalHash)

# Median of the last k entries of the timestamp window (ascending order,
# upper-middle element). The input array is used read-only; a local copy is
# sorted so the caller's window is untouched.
@borrows
fn MedianOfLastK(timestamps: int64[], k: int32): Result[int64] =
    if k <= 0:
        return Err[int64]("ckpt: k must be positive")
    if timestamps.len < k:
        return Err[int64]("ckpt: window smaller than k")
    var win: int64[]
    var start: int32 = timestamps.len - k
    var i: int32 = start
    while i < timestamps.len:
        add(win, timestamps[i])
        i = i + 1
    # selection sort ascending, single-variable subscripts only
    i = 0
    while i < k:
        var bestPos: int32 = i
        var j: int32 = i + 1
        while j < k:
            if win[j] < win[bestPos]:
                bestPos = j
            j = j + 1
        if bestPos != i:
            let tmp: int64 = win[i]
            win[i] = win[bestPos]
            win[bestPos] = tmp
        i = i + 1
    return Ok[int64](win[k / 2])
