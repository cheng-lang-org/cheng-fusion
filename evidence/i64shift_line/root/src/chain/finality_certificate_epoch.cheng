# finality_certificate_epoch.cheng - epoch-aware thin layer over quorum certs.
#
# Thin layer ONLY: the original finality_certificate module stays untouched.
# An EpochCert binds a height and a payload hash to per-voter entries, each
# carrying its own signing epoch (epoch0 = legacy -B world, epoch1 =
# RFC 8032). Admission verifies the signature under the entry's stated
# epoch before appending; duplicates are rejected by voter cid. The
# light-client quorum check counts a vote only when its pubkey is on the
# committee list, its epoch clears minEpoch, AND its signature verifies
# under its own epoch over the payload hash bytes; below 2f+1 valid votes
# the check fails loudly instead of reporting a count.

import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/libp2p/crypto/ed25519/ed25519 as ed

type
    FcertEntry =
        voterCid: layout.FixedBytes32
        pubKey: Bytes
        sig: Bytes
        epoch: int32

    EpochCert =
        height: int64
        payloadHash: layout.FixedBytes32
        entries: FcertEntry[]

# Admit one vote after epoch-aware verification: the signature must verify
# under the stated epoch first ("bad signature" otherwise), a repeated
# voter cid is rejected, and only then is the entry appended.
@borrows
fn FcertAddEntry(cert: var EpochCert, voterCid: layout.FixedBytes32,
                 pub: Bytes, msg: Bytes, sig: Bytes,
                 epoch: int32): Result[bool] =
    if !ed.verifyEd25519Epoch(pub, msg, sig, epoch):
        return Err[bool]("bad signature")
    var i: int32
    while i < cert.entries.len:
        if layout.FixedBytes32Equal(cert.entries[i].voterCid, voterCid):
            return Err[bool]("duplicate voter cid")
        i = i + 1
    var e: FcertEntry
    e.voterCid = voterCid
    # borrowed params: the entry must own independent copies (ORC contract)
    var pubCopy = BytesAlloc(pub.len)
    var sigCopy = BytesAlloc(sig.len)
    var ci: int32
    while ci < pub.len:
        BytesSet(pubCopy, ci, BytesGet(pub, ci))
        ci = ci + 1
    ci = 0
    while ci < sig.len:
        BytesSet(sigCopy, ci, BytesGet(sig, ci))
        ci = ci + 1
    e.pubKey = pubCopy
    e.sig = sigCopy
    e.epoch = epoch
    add(cert.entries, e)
    return Ok[bool](true)

# Light-client verification across mixed epochs. A vote counts toward
# quorum only when all three gates hold: membership, minEpoch clearance,
# and a signature valid under the entry's own epoch. Fewer than 2f+1
# valid votes is an error, not a false verdict.
@borrows
fn FcertQuorumCheck(cert: EpochCert, committeePks: Bytes[],
                    f: int32, minEpoch: int32): Result[bool] =
    let need: int32 = 2 * f + 1
    let msg = layout.FixedBytes32ToBytes(cert.payloadHash)
    var valid: int32 = 0
    var i: int32
    while i < cert.entries.len:
        let ent = cert.entries[i]
        var member: bool = false
        var j: int32
        while j < committeePks.len:
            if BytesEqual(committeePks[j], ent.pubKey):
                member = true
            j = j + 1
        if member and ent.epoch >= minEpoch:
            if ed.verifyEd25519Epoch(ent.pubKey, msg, ent.sig, ent.epoch):
                valid = valid + 1
        i = i + 1
    if valid < need:
        return Err[bool]("quorum not reached")
    return Ok[bool](true)
