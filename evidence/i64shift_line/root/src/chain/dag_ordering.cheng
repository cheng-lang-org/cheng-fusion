# dag_ordering.cheng - deterministic total order over a DAG event view.
#
# Bullshark-style two-phase ordering:
#   phase 1: causal depth (topological round) = 1 + max(depth of referenced
#            parents present in the view); roots at depth 0.
#   phase 2: inside one depth, deterministic tie-break
#            epoch -> tick -> spaceSlot -> cid (ascending).
#
# Why not sort directly with chain.ConsensusLess: it mixes causal-reference
# and clock comparisons in one comparator; when both fire it is not
# antisymmetric (a<b and b<a can both hold), which makes sort results
# implementation-defined. Depth-first ordering removes that hazard.
#
# Input is plain parallel arrays on purpose: no dependency on any state
# machine type, so the same module orders chain events, settlement batches,
# or future certificate DAGs. Parents absent from the view are ignored
# (open-world view tolerance). Cycles cannot occur for parentCid-anchored
# event graphs (parents are strictly historical); a cycle returns an error
# rather than a silently wrong order.

import std/system
import std/rawbytes
import cheng/chain/lsmr_types as lt

const
    DagOrderNoParent: int32 = -1

type
    DagOrderView =
        count: int32
        cids: layout.FixedBytes32[]
        parentA: layout.FixedBytes32[]
        parentB: layout.FixedBytes32[]
        hasParentA: bool[]
        hasParentB: bool[]
        epochs: int32[]
        ticks: int64[]
        spaceSlots: int32[]

fn DagOrderPush(out: var DagOrderView, cid: layout.FixedBytes32,
                parentA: layout.FixedBytes32, hasA: bool,
                parentB: layout.FixedBytes32, hasB: bool,
                epoch: int32, tick: int64, spaceSlot: int32) =
    add(out.cids, cid)
    add(out.parentA, parentA)
    add(out.parentB, parentB)
    add(out.hasParentA, hasA)
    add(out.hasParentB, hasB)
    add(out.epochs, epoch)
    add(out.ticks, tick)
    add(out.spaceSlots, spaceSlot)
    out.count = out.count + 1

@borrows
fn DagOrderFind(view: DagOrderView, cid: layout.FixedBytes32): int32 =
    var i: int32
    while i < view.count:
        if layout.FixedBytes32Equal(view.cids[i], cid):
            return i
        i = i + 1
    return DagOrderNoParent

@borrows
fn DagOrderTieBreakLess(view: DagOrderView, a: int32, b: int32): bool =
    if view.epochs[a] != view.epochs[b]:
        return view.epochs[a] < view.epochs[b]
    if view.ticks[a] != view.ticks[b]:
        return view.ticks[a] < view.ticks[b]
    if view.spaceSlots[a] != view.spaceSlots[b]:
        return view.spaceSlots[a] < view.spaceSlots[b]
    return lt.FixedBytes32Less(view.cids[a], view.cids[b])

# Output: commit-order cid sequence. Deterministic for a given view
# regardless of insertion order. The view is consumed (value semantics).
@borrows
fn DagOrderCommitSequence(view: DagOrderView, outCids: var layout.FixedBytes32[]): int32 =
    # phase 1: iterative stratification. depths[i] valid iff known[i];
    # each pass resolves every node whose in-view parents are all known.
    var depths: int32[]
    var known: bool[]
    var i: int32
    while i < view.count:
        add(depths, 0)
        add(known, false)
        i = i + 1
    var resolved: int32 = 0
    while resolved < view.count:
        var progressed: bool = false
        i = 0
        while i < view.count:
            if !known[i]:
                var ready: bool = true
                var best: int32 = -1
                if view.hasParentA[i]:
                    let pa: int32 = DagOrderFind(view, view.parentA[i])
                    if pa >= 0:
                        if !known[pa]:
                            ready = false
                        else:
                            if depths[pa] > best:
                                best = depths[pa]
                if ready and view.hasParentB[i]:
                    let pb: int32 = DagOrderFind(view, view.parentB[i])
                    if pb >= 0:
                        if !known[pb]:
                            ready = false
                        else:
                            if depths[pb] > best:
                                best = depths[pb]
                if ready:
                    depths[i] = best + 1
                    known[i] = true
                    resolved = resolved + 1
                    progressed = true
            i = i + 1
        if !progressed:
            # remaining nodes sit on a cycle; parentCid graphs cannot have
            # one, so treat this as corrupted input rather than guessing.
            return 1
    # phase 2: selection sort keyed (depth, tie-break). Deterministic;
    # single-variable subscripts only: the compiler requires exact index
    # provenance for native sequence writes.
    var order: int32[]
    i = 0
    while i < view.count:
        add(order, i)
        i = i + 1
    i = 0
    while i < view.count:
        var bestPos: int32 = i
        var j: int32 = i + 1
        while j < view.count:
            let a = order[bestPos]
            let b = order[j]
            var less: bool = false
            if depths[b] != depths[a]:
                less = depths[b] < depths[a]
            else:
                less = DagOrderTieBreakLess(view, b, a)
            if less:
                bestPos = j
            j = j + 1
        if bestPos != i:
            let tmp: int32 = order[i]
            order[i] = order[bestPos]
            order[bestPos] = tmp
        i = i + 1
    i = 0
    while i < view.count:
        add(outCids, view.cids[order[i]])
        i = i + 1
    return 0
