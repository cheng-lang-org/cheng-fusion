# light_client.cheng - stateless light-client confirmation surface.
#
# A light node confirms a commit from a header plus the committee key list
# alone: it re-derives the binding digest over (appHash, commitSeqHash) and
# verifies the attached finality certificate against it. No DAG view, no
# state machine, no tx replay.

import std/system
import std/rawbytes
import std/result
import std/crypto/sha512 as sha512
import cheng/std/bytes_layout as layout
import cheng/chain/finality_certificate as fcert

const
    LcSeedPrefix: str = "rwad.lite"

type
    LiteCommitHeader =
        epoch: int32
        round: int32
        appHash: layout.FixedBytes32
        commitSeqHash: layout.FixedBytes32
        certProposalHash: layout.FixedBytes32

fn LiteBindDigest(appHash: layout.FixedBytes32,
                  commitSeqHash: layout.FixedBytes32): layout.FixedBytes32 =
    let prefix = BytesFromString(LcSeedPrefix)
    let total: int32 = prefix.len + 64
    var buf = BytesAlloc(total)
    var i: int32
    while i < prefix.len:
        BytesSet(buf, i, BytesGet(prefix, i))
        i = i + 1
    let ah = layout.FixedBytes32ToBytes(appHash)
    let ch = layout.FixedBytes32ToBytes(commitSeqHash)
    var j: int32
    while j < 32:
        BytesSet(buf, prefix.len + j, BytesGet(ah, j))
        BytesSet(buf, prefix.len + 32 + j, BytesGet(ch, j))
        j = j + 1
    let d = sha512.Sha512Digest(buf)
    BytesFree(buf)
    let res = layout.FixedBytes32FromBytes(BytesSlice(d, 0, 32))
    return res.value

fn LiteHeaderMake(epoch: int32, round: int32,
                  appHash: layout.FixedBytes32,
                  commitSeqHash: layout.FixedBytes32): LiteCommitHeader =
    var h: LiteCommitHeader
    h.epoch = epoch
    h.round = round
    h.appHash = appHash
    h.commitSeqHash = commitSeqHash
    h.certProposalHash = LiteBindDigest(appHash, commitSeqHash)
    return h

@borrows
fn LiteConfirm(header: LiteCommitHeader, committeePks: Bytes[],
               voterPks: Bytes[], sigs: Bytes[], f: int32): Result[bool] =
    let expect = LiteBindDigest(header.appHash, header.commitSeqHash)
    if !layout.FixedBytes32Equal(expect, header.certProposalHash):
        return Err[bool]("lite: binding drift")
    let cRes = fcert.FcertCreate(header.certProposalHash, header.epoch, header.round, voterPks, sigs)
    if !cRes.ok:
        return Err[bool](cRes.err.msg)
    return fcert.FcertVerify(cRes.value, committeePks, f)
