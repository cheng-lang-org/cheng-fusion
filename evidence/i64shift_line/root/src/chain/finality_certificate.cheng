# finality_certificate.cheng - portable quorum certificate over a proposal.
#
# A light client verifies a commit with ONLY this certificate plus the
# committee public key list and the fault bound f: no DAG view, no state.
# Verification re-checks every signature against sha512(proposal || pk),
# rejects duplicates and non-members, and requires >= 2f+1 valid votes.

import std/system
import std/rawbytes
import std/result
import std/crypto/sha512 as sha512
import cheng/std/bytes_layout as layout
import cheng/libp2p/crypto/ed25519/ed25519 as ed25519

const
    FcertMinVotesBase: int32 = 1

type
    FinalityCertificate =
        proposalHash: layout.FixedBytes32
        epoch: int32
        round: int32
        voterPks: Bytes[]
        sigs: Bytes[]

# Assemble a certificate from accepted votes (must already be filtered to
# the committee and deduplicated by the caller's tally path).
@borrows
fn FcertCreate(proposalHash: layout.FixedBytes32, epoch: int32, round: int32,
               voterPks: Bytes[], sigs: Bytes[]): Result[FinalityCertificate] =
    if voterPks.len != sigs.len:
        return Err[FinalityCertificate]("fcert: pk/sig count mismatch")
    if voterPks.len < FcertMinVotesBase:
        return Err[FinalityCertificate]("fcert: empty vote set")
    var outC: FinalityCertificate
    outC.proposalHash = proposalHash
    outC.epoch = epoch
    outC.round = round
    var i: int32
    while i < voterPks.len:
        add(outC.voterPks, voterPks[i])
        add(outC.sigs, sigs[i])
        i = i + 1
    return Ok[FinalityCertificate](outC)

# Light-client verification. Returns error string via ok=false on any
# structural or cryptographic failure.
@borrows
fn FcertVerify(cert: FinalityCertificate, committeePks: Bytes[], f: int32): Result[bool] =
    let need: int32 = 2 * f + 1
    var valid: int32 = 0
    let phBytes = layout.FixedBytes32ToBytes(cert.proposalHash)
    var i: int32
    while i < cert.voterPks.len:
        # membership
        var member: bool = false
        var j: int32
        while j < committeePks.len:
            if BytesEqual(committeePks[j], cert.voterPks[i]):
                member = true
            j = j + 1
        if !member:
            return Err[bool]("fcert: voter outside committee")
        # duplicate pubkey rejection
        var dup: bool = false
        var k: int32
        while k < i:
            if BytesEqual(cert.voterPks[k], cert.voterPks[i]):
                dup = true
            k = k + 1
        if dup:
            return Err[bool]("fcert: duplicate voter")
        # signature over sha512(proposal || voterPk)
        let msg = sha512.Sha512Digest2(phBytes, cert.voterPks[i])
        if ed25519.verifyEd25519(cert.voterPks[i], msg, cert.sigs[i]):
            valid = valid + 1
        i = i + 1
    if valid < need:
        return Err[bool]("fcert: quorum not reached")
    return Ok[bool](true)
