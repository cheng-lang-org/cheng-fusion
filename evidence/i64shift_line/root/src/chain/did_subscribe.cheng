# DID 订阅入账：席位写进 LSMR 账本格，节点快照同步。
# 资金门槛只校验事件里申报的资本额，链上看不到券商余额。

import std/result
import std/rawbytes
import std/strings as strings
import cheng/std/bytes_layout as layout
import cheng/chain/consensus as consensus
import cheng/libp2p/identity/did
import cheng/apps/chain_node/chain_node as chain

const
    DidSubscribePlanRise: int32 = 1
    DidSubscribePlanTop10: int32 = 2
    DidSubscribeAssetRise: int32 = 940001
    DidSubscribeAssetTop10: int32 = 940002
    DidSubscribeFirstPeriod: int32 = 1
    DidSubscribeFirstPeriodSeats: int32 = 100
    DidSubscribeCapitalRiseYuan: int64 = 10000
    DidSubscribeCapitalTop10Yuan: int64 = 100000

type
    DidSubscribeRecord =
        didText: str
        planId: int32
        period: int32
        untilMs: int64
        capitalYuan: int64
        accountId: int32
        eventCid: layout.FixedBytes32

fn DidSubscribeAssetId(planId: int32): Result[int32] =
    if planId == DidSubscribePlanRise:
        return Ok[int32](DidSubscribeAssetRise)
    if planId == DidSubscribePlanTop10:
        return Ok[int32](DidSubscribeAssetTop10)
    return Err[int32](" did_subscribe: unknown plan")

fn DidSubscribeCapitalFloor(planId: int32): Result[int64] =
    if planId == DidSubscribePlanRise:
        return Ok[int64](DidSubscribeCapitalRiseYuan)
    if planId == DidSubscribePlanTop10:
        return Ok[int64](DidSubscribeCapitalTop10Yuan)
    return Err[int64](" did_subscribe: unknown plan")

fn DidSubscribeSeatOpen(occupied: int32, period: int32): bool =
    if period != DidSubscribeFirstPeriod:
        return true
    return occupied < DidSubscribeFirstPeriodSeats

@borrows
fn DidSubscribeAccountId(didText: str): int32 =
    if strings.Len(didText) <= 0:
        return 0
    let digest = did.DidHashTagged("cheng.did.subscribe.account", didText)
    let value = int64(int32(digest.data[0]) & 255) * int64(16777216) +
                int64(int32(digest.data[1]) & 255) * int64(65536) +
                int64(int32(digest.data[2]) & 255) * int64(256) +
                int64(int32(digest.data[3]) & 255)
    return int32(value % int64(2147483646)) + 1

@borrows
fn DidSubscribeFirstPeriodOccupied(node: chain.ChainNode, assetId: int32): int32 =
    var n: int32 = 0
    for i in 0..<node.events.len:
        if node.events[i].kind != consensus.ConsensusKindMint:
            continue
        if node.events[i].assetId != assetId:
            continue
        if node.events[i].epoch != DidSubscribeFirstPeriod:
            continue
        n = n + 1
    return n

@borrows
fn DidSubscribeLatestForAccount(node: chain.ChainNode,
                                  assetId: int32,
                                  accountId: int32): Result[DidSubscribeRecord] =
    var found = false
    var out: DidSubscribeRecord
    for i in 0..<node.events.len:
        if node.events[i].kind != consensus.ConsensusKindMint:
            continue
        if node.events[i].assetId != assetId:
            continue
        if node.events[i].toAccount != accountId:
            continue
        found = true
        out.planId = 0
        if assetId == DidSubscribeAssetRise:
            out.planId = DidSubscribePlanRise
        if assetId == DidSubscribeAssetTop10:
            out.planId = DidSubscribePlanTop10
        out.period = node.events[i].epoch
        out.untilMs = node.events[i].tick
        out.capitalYuan = node.events[i].amount
        out.accountId = accountId
        out.eventCid = node.eventCids[i]
    if !found:
        return Err[DidSubscribeRecord](" did_subscribe: not found")
    return Ok[DidSubscribeRecord](out)

@borrows
fn DidSubscribeLookup(node: chain.ChainNode,
                        didText: str,
                        planId: int32): Result[DidSubscribeRecord] =
    let assetRes = DidSubscribeAssetId(planId)
    if IsErr(assetRes):
        return Err[DidSubscribeRecord](Error(assetRes))
    let accountId = DidSubscribeAccountId(didText)
    if accountId <= 0:
        return Err[DidSubscribeRecord](" did_subscribe: empty did")
    let recRes = DidSubscribeLatestForAccount(node, Value(assetRes), accountId)
    if IsErr(recRes):
        return recRes
    var rec = Value(recRes)
    rec.didText = strings.CloneStr(didText)
    return Ok[DidSubscribeRecord](rec)

fn DidSubscribeApply(node: var chain.ChainNode,
                       didText: str,
                       planId: int32,
                       period: int32,
                       untilMs: int64,
                       capitalYuan: int64,
                       nowMs: int64): Result[DidSubscribeRecord] =
    if strings.Len(didText) <= 0:
        return Err[DidSubscribeRecord](" did_subscribe: empty did")
    if period < DidSubscribeFirstPeriod:
        return Err[DidSubscribeRecord](" did_subscribe: invalid period")
    if untilMs <= nowMs:
        return Err[DidSubscribeRecord](" did_subscribe: until expired")
    let assetRes = DidSubscribeAssetId(planId)
    if IsErr(assetRes):
        return Err[DidSubscribeRecord](Error(assetRes))
    let floorRes = DidSubscribeCapitalFloor(planId)
    if IsErr(floorRes):
        return Err[DidSubscribeRecord](Error(floorRes))
    if capitalYuan < Value(floorRes):
        return Err[DidSubscribeRecord](" did_subscribe: capital below floor")
    let assetId = Value(assetRes)
    let occupied = DidSubscribeFirstPeriodOccupied(node, assetId)
    if !DidSubscribeSeatOpen(occupied, period):
        return Err[DidSubscribeRecord](" did_subscribe: first period seats full")
    let accountId = DidSubscribeAccountId(didText)
    let parentCid = chain.ChainNodeAccountHead(node.index, assetId, accountId)
    var event = consensus.ChainEventMint(
        assetId,
        accountId,
        parentCid,
        capitalYuan,
        period,
        node.nextGanzhi,
        chain.ChainNodeSpaceSlot(accountId, accountId),
        untilMs
    )
    event.epoch = period
    event.tick = untilMs
    event.amount = capitalYuan
    event.bodyCid = consensus.ChainEventBodyCid(event)
    let applyRes = chain.ChainNodeApplyEvent(node, event)
    if IsErr(applyRes):
        return Err[DidSubscribeRecord](Error(applyRes))
    var rec: DidSubscribeRecord
    rec.didText = strings.CloneStr(didText)
    rec.planId = planId
    rec.period = period
    rec.untilMs = untilMs
    rec.capitalYuan = capitalYuan
    rec.accountId = accountId
    rec.eventCid = Value(applyRes)
    return Ok[DidSubscribeRecord](rec)
