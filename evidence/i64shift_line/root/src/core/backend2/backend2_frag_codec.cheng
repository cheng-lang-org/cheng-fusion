        backend2CodecSizeWithWords(
            4, bodyIR.deferStatementRows.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.deferActivationSiteBlockIds.len))
    backend2CodecSizeAdd(
