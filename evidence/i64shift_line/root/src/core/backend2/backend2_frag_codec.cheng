    callOp.semanticCallExprNodeIndex =
        Backend2CodecReadU32(buf, cursor)
    callOp.consumeActionRow = Backend2CodecReadU32(buf, cursor)
    callOp.managedStoreKind = Backend2CodecReadU32(buf, cursor)
    callOp.relocWordOffset = Backend2CodecReadU32(buf, cursor)
    callOp.targetIsImportc = backend2BodyIrReadBool(
        buf, cursor, "backend2_bodyir_codec_importc_flag_invalid")
    callOp.inlineF64FromIntKind = Backend2CodecReadU32(buf, cursor)
    callOp.wholeCallF64FromIntRescue = backend2BodyIrReadBool(
        buf, cursor, "backend2_bodyir_codec_call_rescue_flag_invalid")
    callOp.inlineF64FromIntUnsigned = backend2BodyIrReadBool(
        buf, cursor, "backend2_bodyir_codec_call_unsigned_flag_invalid")
    return callOp

