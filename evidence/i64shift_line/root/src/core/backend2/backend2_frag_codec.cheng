@borrows
fn backend2BodyIrCleanupProjectionShapeValid(
        bodyIR: coreir.BodyIR): bool =
    let cleanupEmpty =
        coreir.BodyIRCleanupIntentSidecarIsCanonicalEmpty(
            bodyIR.cleanupIntent) &&
        coreir.BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
            bodyIR.cleanupSchedule) &&
        coreir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
            bodyIR.deferReplay)
    let projectionPresent =
        coreir.BodyIRTypeArenaArtifactCidValid(
            bodyIR.cleanupSourceProjectionCid)
    return (cleanupEmpty && !projectionPresent) ||
           (!cleanupEmpty && projectionPresent)

# [wall99] relocation identity 守卫判词富化（wall95/wall98 先例同款）：
# 判据零改动（BodyIRDataRelocationIdentityStrictValidate 原样），仅把失败
# 实况按 unsealed/sealed 两臂逐列入判词。列坐标全部条件化寻址：列长与
# 行数漂移时下标不可寻址取 -1，cid 列 0=零值 1=非零 -1=不可寻址，
# diag 自身永不 panic。
@borrows
fn backend2BodyIrDataRelocationIdentityDiagPanic(
        bodyIR: coreir.BodyIR) =
    var sealedFlag: int32
    if bodyIR.dataRelocationIdentitySealed:
        sealedFlag = 1
    var globalSlotCount: int32
    var badSlot: int32 = -1
    var badSlotPlace: int32 = -1
    var badSlotDomain: int32 = -1
    var badSlotRow: int32 = -1
    var badSlotCid: int32 = -1
    let localColsParallel =
        bodyIR.localAddressTargetDomainKinds.len ==
            bodyIR.localSlots.len &&
        bodyIR.localAddressTargetRows.len == bodyIR.localSlots.len &&
        bodyIR.localAddressTargetCids.len == bodyIR.localSlots.len
    for slotId in 0..<bodyIR.localSlots.len:
        let place = bodyIR.localSlots[slotId].placeKind
        if place == coreir.BodyPlaceGlobalAddressTag:
            globalSlotCount = globalSlotCount + 1
        var domain: int32 = -1
        var row: int32 = -1
        var cidState: int32 = -1
        if localColsParallel:
            domain = bodyIR.localAddressTargetDomainKinds[slotId]
            row = bodyIR.localAddressTargetRows[slotId]
            if layout.FixedBytes32Equal(
                   bodyIR.localAddressTargetCids[slotId],
                   layout.FixedBytes32()):
                cidState = 0
            else:
                cidState = 1
        var slotOk: bool
        if place == coreir.BodyPlaceGlobalAddressTag:
            slotOk = (domain ==
                          coreir.BodyDataRelocTargetDomainTypedGlobalTag ||
                      domain ==
                          coreir.BodyDataRelocTargetDomainFunctionTag) &&
                     row >= 0 && cidState == 1
        else:
            slotOk = domain == coreir.BodyDataRelocTargetDomainInvalidTag &&
                     row == -1 && cidState == 0
        if !slotOk && badSlot < 0:
            badSlot = slotId
            badSlotPlace = place
            badSlotDomain = domain
            badSlotRow = row
            badSlotCid = cidState
    let cstrColsParallel =
        bodyIR.cstringTargetRows.len == bodyIR.cstringLiterals.len &&
        bodyIR.cstringOwnerFunctionFragmentCids.len ==
            bodyIR.cstringLiterals.len
    var badLit: int32 = -1
    var badLitId: int32 = -1
    var badLitRow: int32 = -1
    var badLitCid: int32 = -1
    for literalRow in 0..<bodyIR.cstringLiterals.len:
        let literalId = bodyIR.cstringLiterals[literalRow].id
        var targetRow: int32 = -1
        var cidState: int32 = -1
        if cstrColsParallel:
            targetRow = bodyIR.cstringTargetRows[literalRow]
            if layout.FixedBytes32Equal(
                   bodyIR.cstringOwnerFunctionFragmentCids[literalRow],
                   layout.FixedBytes32()):
                cidState = 0
            else:
                cidState = 1
        let literalOk = literalId == literalRow &&
                        targetRow == literalRow && cidState == 1
        if !literalOk && badLit < 0:
            badLit = literalRow
            badLitId = literalId
            badLitRow = targetRow
            badLitCid = cidState
    panic(Fmt"backend2_bodyir_codec_data_relocation_identity_invalid sealed={sealedFlag} slots={bodyIR.localSlots.len} cstrings={bodyIR.cstringLiterals.len} len_d={bodyIR.localAddressTargetDomainKinds.len} len_r={bodyIR.localAddressTargetRows.len} len_c={bodyIR.localAddressTargetCids.len} len_tr={bodyIR.cstringTargetRows.len} len_oc={bodyIR.cstringOwnerFunctionFragmentCids.len} global_slots={globalSlotCount} bad_slot={badSlot} bad_place={badSlotPlace} bad_dom={badSlotDomain} bad_row={badSlotRow} bad_cid={badSlotCid} bad_lit={badLit} lit_id={badLitId} lit_trow={badLitRow} lit_ocid={badLitCid}")

@borrows
fn backend2BodyIrEncodedSizeExact(
        bodyIR: coreir.BodyIR,
        scrubLocalNames: bool): int32 =
    if !coreir.BodyIRDebugProvenanceShapeValid(bodyIR):
        panic("backend2_bodyir_codec_debug_provenance_invalid")
    if !coreir.BodyIRTypeArenaProofDomainValid(bodyIR):
        panic("backend2_bodyir_codec_type_arena_domain_invalid")
    if !coreir.BodyIRTypeArenaArtifactCidValid(
           bodyIR.typeArenaArtifactCid):
        panic("backend2_bodyir_codec_type_arena_cid_zero")
    if !coreir.BodyIRControlFlowShapeValid(bodyIR):
        panic("backend2_bodyir_codec_control_flow_shape_invalid")
    if !coreir.BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        panic("backend2_bodyir_codec_entry_definition_ownership_invalid")
    if !coreir.BodyIREntryParameterSlotsShapeValid(bodyIR):
        panic("backend2_bodyir_codec_entry_parameter_index_invalid")
    if !coreir.BodyIRLocalBindingValueDefinitionRowsShapeValid(
           bodyIR):
        panic("backend2_bodyir_codec_local_binding_definition_invalid")
    if !coreir.BodyIRDataRelocationIdentityStrictValidate(bodyIR):
        backend2BodyIrDataRelocationIdentityDiagPanic(bodyIR)
    if !coreir.BodyIRManualConsumeSidecarShapeValid(bodyIR):
        panic("backend2_bodyir_codec_manual_consume_shape_invalid")
    if !coreir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(bodyIR):
        panic("backend2_bodyir_codec_ffi_handle_capability_shape_invalid")
    if !coreir.BodyIRCleanupProofShapeValid(bodyIR):
        panic("backend2_bodyir_codec_cleanup_proof_shape_invalid")
    if !backend2BodyIrCleanupProjectionShapeValid(bodyIR):
        panic("backend2_bodyir_codec_cleanup_projection_shape_invalid")
    if !exactdef.BodyIrExactDefSidecarShapeValid(bodyIR):
        panic("backend2_bodyir_codec_exact_def_shape_invalid")
    var total: int32 = 8                                 # magic + fieldCount
    backend2CodecSizeAdd(total, 8)                        # tag=1 + ops.count
    for i in 0..<bodyIR.ops.len:
        backend2CodecSizeAdd(total, backend2BodyIrOpSize(bodyIR.ops[i]))
    backend2CodecSizeAdd(total, 8)                        # tag=2 + callSequence.count
    for i in 0..<bodyIR.callSequence.len:
        backend2CodecSizeAdd(total, backend2BodyIrCallOpSize(bodyIR, i))
    backend2CodecSizeAdd(total, 8)                        # tag=3 + localSlots.count
    for i in 0..<bodyIR.localSlots.len:
        backend2CodecSizeAdd(total,
                             backend2BodyIrLocalSlotSize(
                                 bodyIR.localSlots[i], scrubLocalNames))
    backend2CodecSizeAdd(total, 8)                        # tag=4 + blocks.count
    for i in 0..<bodyIR.blocks.len:
        backend2CodecSizeAdd(total, backend2BodyIrBlockSize(bodyIR.blocks[i]))
    backend2CodecSizeAdd(total, 8)                        # tag=5 + terms.count
    for i in 0..<bodyIR.terms.len:
        backend2CodecSizeAdd(total, backend2BodyIrTermSize(bodyIR.terms[i]))
    backend2CodecSizeAdd(total, 8)                        # tag=6 + cstringLiterals.count
    for i in 0..<bodyIR.cstringLiterals.len:
        backend2CodecSizeAdd(total,
                             backend2BodyIrCStringSize(bodyIR.cstringLiterals[i]))
    backend2CodecSizeAdd(total, 8)                        # tag=7 + entryIsCAbi
    backend2CodecSizeAdd(total, 16)                       # tag=8 + required + complete + functionId
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            8, bodyIR.debugOpIdsByOpIndex.len * 2))       # tag=9 + op provenance rows
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            8, bodyIR.debugOpIdsByTermIndex.len * 2))     # tag=10 + term provenance rows
    backend2CodecSizeAdd(total, 36)                       # tag=11 + FixedBytes32
    backend2CodecSizeAdd(total, 4)                        # tag=12
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.typeFactTypeIds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.typeFactStructuralKinds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.typeFactScalarKinds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.typeFactChildTypeIds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.typeFactFixedLengths.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.typeFactSizeBytes.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.typeFactAlignBytes.len))
    backend2CodecSizeAdd(total, backend2BodyIrControlFlowSize(bodyIR))
    backend2CodecSizeAdd(
        total, backend2BodyIrManualConsumeSize(bodyIR))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            12, bodyIR.entryDefinitionOwnershipKinds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.entryDefinitionSemanticRows.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.entryParameterSlotIds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            12, bodyIR.localBindingValueDefinitionRows.len))
    backend2CodecSizeAdd(
        total, backend2BodyIrExternFfiHandleCapabilitySize(bodyIR))
    backend2CodecSizeAdd(
        total, backend2BodyIrCleanupAuthoritySize(bodyIR))
    backend2CodecSizeAdd(
        total, backend2BodyIrDataRelocationIdentitySize(bodyIR))
    backend2CodecSizeAdd(
        total, backend2BodyIrExactDefSize(bodyIR))
    return total

@borrows
fn Backend2BodyIrEncodedSize(bodyIR: coreir.BodyIR): int32 =
    return backend2BodyIrEncodedSizeExact(bodyIR, false)

# ---- 编码 (第二遍) ----

@borrows
fn backend2BodyIrPutOp(buf: var rawbytes.Bytes,
                       cursor: var int32,
                       op: coreir.BodyOp) =
    Backend2CodecPutU32(buf, cursor, op.kind)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.target)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.valueDefSlot)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.valueDefExprNodeIndex)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.valueDefSemanticRow)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, int32(op.valueDefOwnership))
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, op.valueDefBorrowOwnerSemanticRow)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, op.valueDefBorrowOwnerDefinitionDomain)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, op.valueDefBorrowOwnerDefinitionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.valueDefConsumeOpIndexPlusOne)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.valueDefOriginKind)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.valueDefOriginId)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.sourceDefinitionDomain)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.sourceDefinitionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.consumeActionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, op.operands.len)
    cursor = cursor + 4
    for i in 0..<op.operands.len:
        Backend2CodecPutU32(buf, cursor, op.operands[i])
        cursor = cursor + 4

@borrows
fn backend2BodyIrPutCallOp(buf: var rawbytes.Bytes,
                           cursor: var int32,
                           bodyIR: coreir.BodyIR,
                           callIndex: int32) =
    backend2FragCodecPutStrBody(
        buf, cursor, bodyIR.callSequence[callIndex].targetSymbol)
    backend2FragCodecPutStrBody(
        buf, cursor, bodyIR.callSequence[callIndex].targetSourcePath)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.callSequence[callIndex].argSlots)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.callSequence[callIndex].argPassKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.callSequence[callIndex].argAbiSizes)
    Backend2CodecPutU32(
        buf, cursor, bodyIR.callSequence[callIndex].resultSlot)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.callSequence[callIndex].resultPassKind)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        int32(bodyIR.callSequence[callIndex].resultOwnership))
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.callSequence[callIndex].resultExprNodeIndex)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.callSequence[callIndex].resultValueDefinitionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.callSequence[callIndex].resultBorrowOwnerValueDefinitionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.callSequence[callIndex].resultBorrowOwnerDefinitionDomain)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.callSequence[callIndex].resultBorrowOwnerDefinitionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.callSequence[callIndex].resultDefinitionOriginKind)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.callSequence[callIndex].resultDefinitionOriginId)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.callSequence[callIndex].sourceDefinitionDomain)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.callSequence[callIndex].sourceDefinitionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.callSequence[callIndex].semanticCallExprNodeIndex)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.callSequence[callIndex].consumeActionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.callSequence[callIndex].managedStoreKind)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.callSequence[callIndex].relocWordOffset)
    cursor = cursor + 4
    var importcFlag: int32
    if bodyIR.callSequence[callIndex].targetIsImportc:
        importcFlag = 1
    Backend2CodecPutU32(buf, cursor, importcFlag)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.callSequence[callIndex].inlineF64FromIntKind)
    cursor = cursor + 4
    var wholeCallRescueFlag: int32
    if bodyIR.callSequence[callIndex].wholeCallF64FromIntRescue:
        wholeCallRescueFlag = 1
    Backend2CodecPutU32(buf, cursor, wholeCallRescueFlag)
    cursor = cursor + 4
    var inlineUnsignedFlag: int32
    if bodyIR.callSequence[callIndex].inlineF64FromIntUnsigned:
        inlineUnsignedFlag = 1
    Backend2CodecPutU32(buf, cursor, inlineUnsignedFlag)
    cursor = cursor + 4

@borrows
fn backend2BodyIrPutLocalSlot(buf: var rawbytes.Bytes,
                              cursor: var int32,
                              slot: coreir.LocalSlot,
                              scrubLocalName: bool) =
    Backend2CodecPutU32(buf, cursor, slot.id)
    cursor = cursor + 4
    if scrubLocalName &&
       slot.placeKind != coreir.BodyPlaceGlobalAddressTag:
        backend2FragCodecPutStrBody(buf, cursor, "")
    else:
        backend2FragCodecPutStrBody(buf, cursor, slot.name)
    Backend2CodecPutU32(buf, cursor, slot.typeKind)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, slot.typeArenaTypeId)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, slot.managedStorageKind)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, slot.placeKind)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, slot.stackOffset)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, slot.sizeBytes)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, slot.alignBytes)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, slot.auxValue)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, int32(slot.ownership))
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, int32(slot.aliasClass))
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, int32(slot.escapeKind))
    cursor = cursor + 4
    var noAliasAsI32: int32
    noAliasAsI32 = 0
    if slot.noAlias:
        noAliasAsI32 = 1
    Backend2CodecPutU32(buf, cursor, noAliasAsI32)
    cursor = cursor + 4

@borrows
fn backend2BodyIrPutBlock(buf: var rawbytes.Bytes,
                          cursor: var int32,
                          blk: coreir.BodyBlock) =
    Backend2CodecPutU32(buf, cursor, blk.id)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, blk.opStart)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, blk.opCount)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, blk.termIndex)
    cursor = cursor + 4

@borrows
fn backend2BodyIrPutTerm(buf: var rawbytes.Bytes,
                         cursor: var int32,
                         term: coreir.BodyTerm) =
    Backend2CodecPutU32(buf, cursor, term.kind)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, term.conditionKind)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, term.resultSlot)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, term.lhsSlot)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, term.rhsSlot)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, term.trueBlock)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, term.falseBlock)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, term.sourceDefinitionDomain)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, term.sourceDefinitionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, term.operands.len)
    cursor = cursor + 4
    for i in 0..<term.operands.len:
        Backend2CodecPutU32(buf, cursor, term.operands[i])
        cursor = cursor + 4

@borrows
fn backend2BodyIrPutCString(buf: var rawbytes.Bytes,
                            cursor: var int32,
                            entry: coreir.CStringLiteralEntry) =
    Backend2CodecPutU32(buf, cursor, entry.id)
    cursor = cursor + 4
    backend2FragCodecPutStrBody(buf, cursor, entry.text)
    backend2FragCodecPutStrBody(buf, cursor, entry.dataLabel)

@borrows
fn backend2BodyIrPutI32SeqBody(
        buf: var rawbytes.Bytes,
        cursor: var int32,
        items: int32[]) =
    Backend2CodecPutU32(buf, cursor, items.len)
    cursor = cursor + 4
    for index in 0..<items.len:
        Backend2CodecPutU32(buf, cursor, items[index])
        cursor = cursor + 4

@borrows
fn backend2BodyIrPutFixedBytes32SeqBody(
        buf: var rawbytes.Bytes,
        cursor: var int32,
        items: layout.FixedBytes32[]) =
    Backend2CodecPutU32(buf, cursor, items.len)
    cursor = cursor + 4
    for itemIndex in 0..<items.len:
        var itemBytes = layout.FixedBytes32ToBytes(items[itemIndex])
        if rawbytes.BytesLen(itemBytes) != 32:
            rawbytes.BytesFree(itemBytes)
            panic("backend2_bodyir_codec_fixed32_size_invalid")
        for byteIndex in 0..<32:
            if cursor < 0 || cursor >= buf.len:
                rawbytes.BytesFree(itemBytes)
                panic("backend2_bodyir_codec_fixed32_overrun")
            rawbytes.BytesSet(
                buf, cursor, rawbytes.BytesGet(itemBytes, byteIndex))
            cursor = cursor + 1
        rawbytes.BytesFree(itemBytes)

fn backend2BodyIrPutFixedBytes32(
        buf: var rawbytes.Bytes,
        cursor: var int32,
        item: layout.FixedBytes32) =
    var itemBytes = layout.FixedBytes32ToBytes(item)
    if rawbytes.BytesLen(itemBytes) != 32:
        rawbytes.BytesFree(itemBytes)
        panic("backend2_bodyir_codec_fixed32_size_invalid")
    for byteIndex in 0..<32:
        if cursor < 0 || cursor >= buf.len:
            rawbytes.BytesFree(itemBytes)
            panic("backend2_bodyir_codec_fixed32_overrun")
        rawbytes.BytesSet(
            buf, cursor, rawbytes.BytesGet(itemBytes, byteIndex))
        cursor = cursor + 1
    rawbytes.BytesFree(itemBytes)

@borrows
fn backend2BodyIrPutDataRelocationIdentity(
        buf: var rawbytes.Bytes,
        cursor: var int32,
        bodyIR: coreir.BodyIR) =
    backend2FragCodecPutTag(buf, cursor, 18)
    backend2BodyIrPutBool(
        buf, cursor, bodyIR.dataRelocationIdentitySealed)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.localAddressTargetDomainKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.localAddressTargetRows)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.localAddressTargetCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cstringTargetRows)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.cstringOwnerFunctionFragmentCids)

@borrows
fn backend2BodyIrPutExternFfiHandleCapabilities(
        buf: var rawbytes.Bytes,
        cursor: var int32,
        sidecar: coreir.BodyIRExternFfiHandleCapabilitySidecar) =
    backend2FragCodecPutTag(buf, cursor, 16)
    Backend2CodecPutU32(
        buf, cursor, if sidecar.sealed: 1 else: 0)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, sidecar.functionRow)
    cursor = cursor + 4
    backend2BodyIrPutFixedBytes32(
        buf, cursor, sidecar.snapshotProjectionAuthorityCid)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, sidecar.semanticCargoCid)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, sidecar.loweringBridgeCid)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.callOrdinals)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.callBodyOpRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.semanticCapabilityCallRows)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.resolvedCallRows)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.snapshotCallIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.semanticContractRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.snapshotContractRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.semanticEffectStarts)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.effectStarts)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.effectCounts)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.callCapabilityCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.contractCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.interfaceCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.callBridgeCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.semanticCapabilityEffectRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.contractEffectRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.snapshotEffectRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.snapshotEffectContractRows)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.effectKinds)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.targetKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.parameterOrdinals)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.argumentRows)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.argumentSlotIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.argumentValueNodeIndexes)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.valueDefinitionRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, sidecar.generationRootValueDefinitionRows)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.exactTypeIds)
    backend2BodyIrPutI32SeqBody(buf, cursor, sidecar.carrierKinds)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.argumentBindingCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.typeCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.generationCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.definitionLineageCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.effectCapabilityCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.contractEffectCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, sidecar.effectBridgeCids)
    backend2BodyIrPutFixedBytes32(buf, cursor, sidecar.rootCid)

fn backend2BodyIrPutBool(
        buf: var rawbytes.Bytes,
        cursor: var int32,
        value: bool) =
    Backend2CodecPutU32(
        buf, cursor, if value: 1 else: 0)
    cursor = cursor + 4

@borrows
fn backend2BodyIrPutCleanupAuthority(
        buf: var rawbytes.Bytes,
        cursor: var int32,
        bodyIR: coreir.BodyIR) =
    backend2FragCodecPutTag(buf, cursor, 17)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.cleanupSourceProjectionCid)
    backend2BodyIrPutBool(
        buf, cursor, bodyIR.cleanupIntent.building)
    backend2BodyIrPutBool(
        buf, cursor, bodyIR.cleanupIntent.sealed)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.cleanupIntent.rootCid)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.cleanupIntent.sourceControlCid)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.cleanupIntent.ownershipIrCid)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.cleanupIntent.ownershipAnalysisCid)
    Backend2CodecPutU32(
        buf, cursor, bodyIR.cleanupIntent.originalLocalCount)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.cleanupIntent.originalOpCount)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.cleanupIntent.originalCallCount)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.cleanupIntent.originalBlockCount)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.cleanupIntent.originalTermCount)
    cursor = cursor + 4
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.sourceBlockIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.sourceTermRows)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.sourceTermCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.sourceSuccessorOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.originalSuccessorCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.sourceExitKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.originalTargetBlockIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.originalEdgeKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.sourceScopeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.targetScopeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.exitOwnershipEdgeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.selectedDeferStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.selectedDeferCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.exitUnitStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.exitUnitCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.siteOriginalBlockIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.siteAfterOpOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.siteOwnershipOpStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.siteOwnershipOpCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.siteUnitStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.siteUnitCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.ownershipOpRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.selectedDeferIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitSemanticDomains)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitSemanticStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitSemanticCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitSnapshotSourceSlotStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitConditionStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitConditionCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitClearStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitClearCounts)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.unitAuthorityCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.snapshotSourceSlotIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.snapshotProjectionPolicies)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.snapshotSemanticRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.snapshotTypeArenaTypeIds)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.snapshotInterfaceCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.conditionKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.conditionInputSourceSlotIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.conditionSemanticRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.conditionSemanticOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.clearKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.clearTargetSourceSlotIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.clearSemanticRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupIntent.clearSemanticOrdinals)
    backend2BodyIrPutBool(
        buf, cursor, bodyIR.cleanupSchedule.building)
    backend2BodyIrPutBool(
        buf, cursor, bodyIR.cleanupSchedule.sealed)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.cleanupSchedule.rootCid)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.cleanupSchedule.finalControlCid)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.ownerSourceTermRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.cleanupSchedule.ownerSourceSuccessorOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.cleanupSchedule.ownerFinalContinuationBlockIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.ownerFinalEdgeKinds)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.ownerContinuationCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.opStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.opCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.callStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.callCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.blockStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.blockCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.termStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.termCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.unitLocalStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.unitLocalCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.unitEffectStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.unitEffectCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.effectSemanticRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.effectPhysicalDomains)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.effectPhysicalRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.effectRoles)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.payloadCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.cleanupSchedule.placementCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.cleanupSchedule.projectedSnapshotSlotIds)
    backend2BodyIrPutBool(
        buf, cursor, bodyIR.deferReplay.building)
    backend2BodyIrPutBool(
        buf, cursor, bodyIR.deferReplay.sealed)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.deferReplay.rootCid)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferReplay.templateOpMapStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferReplay.templateOpMapCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferReplay.templateOpRows)

@borrows
fn backend2BodyIrEncodeExact(bodyIR: coreir.BodyIR,
                             scrubLocalNames: bool): rawbytes.Bytes =
    let total = backend2BodyIrEncodedSizeExact(bodyIR, scrubLocalNames)
    var buf = rawbytes.BytesAlloc(total)
    if buf.data == nil:
        panic("backend2_bodyir_codec_encode_alloc_failed")
    var cursor: int32
    Backend2CodecPutU32(buf, cursor, backend2BodyIrCodecMagic)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, backend2BodyIrCodecFieldCount)
    cursor = cursor + 4
    backend2FragCodecPutTag(buf, cursor, 1)
    Backend2CodecPutU32(buf, cursor, bodyIR.ops.len)
    cursor = cursor + 4
    for i in 0..<bodyIR.ops.len:
        backend2BodyIrPutOp(buf, cursor, bodyIR.ops[i])
    backend2FragCodecPutTag(buf, cursor, 2)
    Backend2CodecPutU32(buf, cursor, bodyIR.callSequence.len)
    cursor = cursor + 4
    for i in 0..<bodyIR.callSequence.len:
        backend2BodyIrPutCallOp(buf, cursor, bodyIR, i)
    backend2FragCodecPutTag(buf, cursor, 3)
    Backend2CodecPutU32(buf, cursor, bodyIR.localSlots.len)
    cursor = cursor + 4
    for i in 0..<bodyIR.localSlots.len:
        backend2BodyIrPutLocalSlot(
            buf, cursor, bodyIR.localSlots[i], scrubLocalNames)
    backend2FragCodecPutTag(buf, cursor, 4)
    Backend2CodecPutU32(buf, cursor, bodyIR.blocks.len)
    cursor = cursor + 4
    for i in 0..<bodyIR.blocks.len:
        backend2BodyIrPutBlock(buf, cursor, bodyIR.blocks[i])
    backend2FragCodecPutTag(buf, cursor, 5)
    Backend2CodecPutU32(buf, cursor, bodyIR.terms.len)
    cursor = cursor + 4
    for i in 0..<bodyIR.terms.len:
        backend2BodyIrPutTerm(buf, cursor, bodyIR.terms[i])
    backend2FragCodecPutTag(buf, cursor, 6)
    Backend2CodecPutU32(buf, cursor, bodyIR.cstringLiterals.len)
    cursor = cursor + 4
    for i in 0..<bodyIR.cstringLiterals.len:
        backend2BodyIrPutCString(buf, cursor, bodyIR.cstringLiterals[i])
    backend2BodyIrPutDataRelocationIdentity(buf, cursor, bodyIR)
    backend2FragCodecPutTag(buf, cursor, 7)
    var entryCAbiFlag: int32
    if bodyIR.entryIsCAbi:
        entryCAbiFlag = 1
    Backend2CodecPutU32(buf, cursor, entryCAbiFlag)
    cursor = cursor + 4
    backend2FragCodecPutTag(buf, cursor, 8)
    var debugRequiredFlag: int32
    if bodyIR.debugProvenanceRequired:
        debugRequiredFlag = 1
    Backend2CodecPutU32(buf, cursor, debugRequiredFlag)
    cursor = cursor + 4
    var debugCompleteFlag: int32
    if bodyIR.debugProvenanceComplete:
        debugCompleteFlag = 1
    Backend2CodecPutU32(buf, cursor, debugCompleteFlag)
    cursor = cursor + 4
    var debugFunctionId: int32 = -1
    if bodyIR.debugProvenanceRequired:
        debugFunctionId = bodyIR.debugFunctionId
    Backend2CodecPutU32(buf, cursor, debugFunctionId)
    cursor = cursor + 4
    backend2FragCodecPutTag(buf, cursor, 9)
    Backend2CodecPutU32(buf, cursor, bodyIR.debugOpIdsByOpIndex.len)
    cursor = cursor + 4
    for index in 0..<bodyIR.debugOpIdsByOpIndex.len:
        Backend2CodecPutU32(
            buf, cursor, bodyIR.debugOpIdsByOpIndex[index])
        cursor = cursor + 4
        Backend2CodecPutU32(
            buf, cursor,
            bodyIR.debugSyntheticKindsByOpIndex[index])
        cursor = cursor + 4
    backend2FragCodecPutTag(buf, cursor, 10)
    Backend2CodecPutU32(buf, cursor, bodyIR.debugOpIdsByTermIndex.len)
    cursor = cursor + 4
    for index in 0..<bodyIR.debugOpIdsByTermIndex.len:
        Backend2CodecPutU32(
            buf, cursor, bodyIR.debugOpIdsByTermIndex[index])
        cursor = cursor + 4
        Backend2CodecPutU32(
            buf, cursor,
            bodyIR.debugSyntheticKindsByTermIndex[index])
        cursor = cursor + 4
    backend2FragCodecPutTag(buf, cursor, 12)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.typeFactTypeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.typeFactStructuralKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.typeFactScalarKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.typeFactChildTypeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.typeFactFixedLengths)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.typeFactSizeBytes)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.typeFactAlignBytes)
    backend2FragCodecPutTag(buf, cursor, 13)
    var controlFlowSealedFlag: int32
    if bodyIR.controlFlowSealed:
        controlFlowSealedFlag = 1
    Backend2CodecPutU32(buf, cursor, controlFlowSealedFlag)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, bodyIR.controlFunctionRow)
    cursor = cursor + 4
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.controlScopeParentIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.blockScopeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.termSuccessorStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.termSuccessorCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.successorBlockIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.successorEdgeKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.callTargetDomainKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.callTargetRows)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.callTargetInterfaceCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferDeclarationScopeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferSuiteScopeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferLexicalOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferFunctionRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferStatementRows)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.deferActionCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferActivationSiteBlockIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.deferActivationSiteAfterOpOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferActivationSiteStarts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferActivationSiteCounts)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.deferActivationRows)
    backend2FragCodecPutTag(buf, cursor, 14)
    var manualConsumeSealedFlag: int32
    if bodyIR.manualConsume.sealed:
        manualConsumeSealedFlag = 1
    Backend2CodecPutU32(
        buf, cursor, manualConsumeSealedFlag)
    cursor = cursor + 4
    var manualConsumeFunctionPresentFlag: int32
    if bodyIR.manualConsume.functionPresent:
        manualConsumeFunctionPresentFlag = 1
    Backend2CodecPutU32(
        buf, cursor, manualConsumeFunctionPresentFlag)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.manualConsume.functionRow)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.manualConsume.functionTargetParameterOrdinal)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.manualConsume.functionSourceParameterOrdinal)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.manualConsume.functionTargetSlotId)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.manualConsume.functionSourceSlotId)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.manualConsume.functionTargetTypeArenaTypeId)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor,
        bodyIR.manualConsume.functionSourceTypeArenaTypeId)
    cursor = cursor + 4
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.manualConsume.functionEffectCid)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.manualConsume.functionBodyProofCid)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.manualConsume.callOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.manualConsume.snapshotCallIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.targetArgumentOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.sourceArgumentOrdinals)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.manualConsume.targetPlaceSlotIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.manualConsume.targetOwnerSlotIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.manualConsume.sourcePlaceSlotIds)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.targetArgumentBindingCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.sourceArgumentBindingCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.manualConsume.targetProjectionCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.manualConsume.sourceProjectionCids)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.targetDefinitionDomains)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.manualConsume.targetDefinitionRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.sourceDefinitionDomains)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.manualConsume.sourceDefinitionRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.targetTypeArenaTypeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.sourceTypeArenaTypeIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor,
        bodyIR.manualConsume.postDefinitionDomains)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.manualConsume.postDefinitionRows)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.manualConsume.effectCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.manualConsume.linearTokenCids)
    backend2BodyIrPutFixedBytes32SeqBody(
        buf, cursor, bodyIR.manualConsume.bridgeCids)
    backend2BodyIrPutFixedBytes32(
        buf, cursor, bodyIR.manualConsume.rootCid)
    backend2FragCodecPutTag(buf, cursor, 15)
    var entryDefinitionOwnershipSealedFlag: int32
    if bodyIR.entryDefinitionOwnershipSealed:
        entryDefinitionOwnershipSealedFlag = 1
    Backend2CodecPutU32(
        buf, cursor, entryDefinitionOwnershipSealedFlag)
    cursor = cursor + 4
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.entryDefinitionOwnershipKinds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.entryDefinitionSemanticRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.entryParameterSlotIds)
    Backend2CodecPutU32(
        buf, cursor, bodyIR.localBindingValueDefinitionDomainStart)
    cursor = cursor + 4
    Backend2CodecPutU32(
        buf, cursor, bodyIR.localBindingValueDefinitionDomainCount)
    cursor = cursor + 4
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.localBindingValueDefinitionRows)
    backend2BodyIrPutExternFfiHandleCapabilities(
        buf, cursor, bodyIR.externFfiHandleCapabilities)
    backend2BodyIrPutCleanupAuthority(buf, cursor, bodyIR)
    backend2BodyIrPutExactDef(buf, cursor, bodyIR)
    backend2FragCodecPutTag(buf, cursor, 11)
    var typeArenaCidBytes =
        layout.FixedBytes32ToBytes(bodyIR.typeArenaArtifactCid)
    if rawbytes.BytesLen(typeArenaCidBytes) != 32:
        rawbytes.BytesFree(typeArenaCidBytes)
        panic("backend2_bodyir_codec_type_arena_cid_size_invalid")
    for index in 0..<32:
        if cursor < 0 || cursor >= buf.len:
            rawbytes.BytesFree(typeArenaCidBytes)
            panic("backend2_bodyir_codec_type_arena_cid_overrun")
        rawbytes.BytesSet(
            buf, cursor, rawbytes.BytesGet(typeArenaCidBytes, index))
        cursor = cursor + 1
    rawbytes.BytesFree(typeArenaCidBytes)
    if cursor != total:
        panic("backend2_bodyir_codec_encode_cursor_mismatch")
    return buf

@borrows
fn Backend2BodyIrEncode(bodyIR: coreir.BodyIR): rawbytes.Bytes =
    return backend2BodyIrEncodeExact(bodyIR, false)

@borrows
fn Backend2BodyIrEncodeExpectedManualConsumeAuthority(
        bodyIR: coreir.BodyIR,
        expectedManualConsumeRootCid:
            layout.FixedBytes32): rawbytes.Bytes =
    if !coreir.BodyIRManualConsumeExactValidateAgainst(
           bodyIR, expectedManualConsumeRootCid):
        panic(
            "backend2_bodyir_codec_manual_consume_authority_mismatch")
    return backend2BodyIrEncodeExact(bodyIR, false)

@borrows
fn Backend2BodyIrEncodeCanonicalHashIngress(
        bodyIR: coreir.BodyIR): rawbytes.Bytes =
    return backend2BodyIrEncodeExact(bodyIR, true)

# ---- 解码 (malformed = 硬崩) ----

@borrows
fn backend2BodyIrReadI32SeqBody(buf: rawbytes.Bytes, cursor: var int32): int32[] =
    let count = Backend2CodecReadU32(buf, cursor)
    if count < 0 || cursor < 0 || cursor > buf.len ||
       count > (buf.len - cursor) / 4:
        panic("backend2_bodyir_codec_i32_seq_overrun")
    var out: int32[]
    for i in 0..<count:
        add(out, Backend2CodecReadU32(buf, cursor))
    return out

@borrows
fn backend2BodyIrReadFixedBytes32(
        buf: rawbytes.Bytes,
        cursor: var int32): layout.FixedBytes32 =
    if cursor < 0 || cursor > buf.len || buf.len - cursor < 32:
        panic("backend2_bodyir_codec_fixed32_overrun")
    var itemBytes = rawbytes.BytesSlice(buf, cursor, 32)
    cursor = cursor + 32
    let parsed = layout.FixedBytes32FromBytes(itemBytes)
    rawbytes.BytesFree(itemBytes)
    if !IsOk(parsed):
        panic("backend2_bodyir_codec_fixed32_invalid")
    return Value(parsed)

@borrows
fn backend2BodyIrReadFixedBytes32SeqBody(
        buf: rawbytes.Bytes,
        cursor: var int32): layout.FixedBytes32[] =
    let count = Backend2CodecReadU32(buf, cursor)
    if count < 0 || cursor < 0 || cursor > buf.len ||
       count > (buf.len - cursor) / 32:
        panic("backend2_bodyir_codec_fixed32_seq_overrun")
    var out: layout.FixedBytes32[]
    for itemIndex in 0..<count:
        add(out, backend2BodyIrReadFixedBytes32(buf, cursor))
    return out

@borrows
fn backend2BodyIrReadBool(buf: rawbytes.Bytes,
                          cursor: var int32,
                          errorText: str): bool =
    let value = Backend2CodecReadU32(buf, cursor)
    if value != 0 && value != 1:
        panic(errorText)
    return value == 1

@borrows
fn backend2BodyIrReadDataRelocationIdentity(
        buf: rawbytes.Bytes,
        cursor: var int32,
        bodyIR: var coreir.BodyIR) =
    backend2FragCodecExpectTag(buf, cursor, 18)
    bodyIR.dataRelocationIdentitySealed =
        backend2BodyIrReadBool(
            buf, cursor,
            "backend2_bodyir_codec_data_relocation_sealed_invalid")
    bodyIR.localAddressTargetDomainKinds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.localAddressTargetRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.localAddressTargetCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.cstringTargetRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.cstringOwnerFunctionFragmentCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)

# ---- field 19 ExactDef 侧车 (批 1): sealed 标量 + 15 int32 列 + CID ----
# 线格式挂在 cleanup authority (field 17) 之后、TypeArena CID (field 11) 之前,
# 后者必须保持全载荷尾部。形状由 exactdef 校验封死 (canonical-empty 或
# sealed dense, 中间态不上线)。

@borrows
fn backend2BodyIrExactDefSize(bodyIR: coreir.BodyIR): int32 =
    var total: int32 = 8                             # tag=19 + sealed
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.opPlaceKinds.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.opExactTypeIds.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.opOriginIds.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.opProducerFunctionRows.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.opSourceDefOpRows.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.opReadADefOpRows.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.slotPlaceKinds.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.slotOriginIds.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.slotStorageKinds.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.callArgStarts.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.callArgCounts.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.argDefOpRows.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.argPlaceKinds.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.argOwnerships.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.exactDef.argOriginIds.len))
    backend2CodecSizeAdd(total, 32)                  # exactDefCid
    return total

@borrows
fn backend2BodyIrPutExactDef(buf: var rawbytes.Bytes,
                             cursor: var int32,
                             bodyIR: coreir.BodyIR) =
    backend2FragCodecPutTag(buf, cursor, 19)
    var sealedFlag: int32
    if bodyIR.exactDef.sealed:
        sealedFlag = 1
    Backend2CodecPutU32(buf, cursor, sealedFlag)
    cursor = cursor + 4
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.opPlaceKinds)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.opExactTypeIds)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.opOriginIds)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.exactDef.opProducerFunctionRows)
    backend2BodyIrPutI32SeqBody(
        buf, cursor, bodyIR.exactDef.opSourceDefOpRows)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.opReadADefOpRows)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.slotPlaceKinds)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.slotOriginIds)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.slotStorageKinds)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.callArgStarts)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.callArgCounts)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.argDefOpRows)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.argPlaceKinds)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.argOwnerships)
    backend2BodyIrPutI32SeqBody(buf, cursor, bodyIR.exactDef.argOriginIds)
    backend2BodyIrPutFixedBytes32(buf, cursor, bodyIR.exactDef.exactDefCid)

@borrows
fn backend2BodyIrReadExactDef(buf: rawbytes.Bytes,
                              cursor: var int32,
                              bodyIR: var coreir.BodyIR) =
    if !exactdef.BodyIrExactDefSidecarIsCanonicalEmpty(bodyIR.exactDef):
        panic("backend2_bodyir_codec_exact_def_destination_not_empty")
    backend2FragCodecExpectTag(buf, cursor, 19)
    bodyIR.exactDef.sealed = backend2BodyIrReadBool(
        buf, cursor, "backend2_bodyir_codec_exact_def_sealed_invalid")
    bodyIR.exactDef.opPlaceKinds =
