@borrows
fn backend2BodyIrReadBlock(buf: rawbytes.Bytes, cursor: var int32): coreir.BodyBlock =
    var blk: coreir.BodyBlock
    blk.id = Backend2CodecReadU32(buf, cursor)
    blk.opStart = Backend2CodecReadU32(buf, cursor)
    blk.opCount = Backend2CodecReadU32(buf, cursor)
    blk.termIndex = Backend2CodecReadU32(buf, cursor)
    return blk

@borrows
fn backend2BodyIrReadTerm(buf: rawbytes.Bytes, cursor: var int32): coreir.BodyTerm =
    var term: coreir.BodyTerm
    term.kind = Backend2CodecReadU32(buf, cursor)
    term.conditionKind = Backend2CodecReadU32(buf, cursor)
    term.resultSlot = Backend2CodecReadU32(buf, cursor)
    term.lhsSlot = Backend2CodecReadU32(buf, cursor)
    term.rhsSlot = Backend2CodecReadU32(buf, cursor)
    term.trueBlock = Backend2CodecReadU32(buf, cursor)
    term.falseBlock = Backend2CodecReadU32(buf, cursor)
    term.sourceDefinitionDomain =
        Backend2CodecReadU32(buf, cursor)
    term.sourceDefinitionRow = Backend2CodecReadU32(buf, cursor)
    term.operands = backend2BodyIrReadI32SeqBody(buf, cursor)
    return term

@borrows
fn backend2BodyIrReadCString(buf: rawbytes.Bytes, cursor: var int32): coreir.CStringLiteralEntry =
    var entry: coreir.CStringLiteralEntry
    entry.id = Backend2CodecReadU32(buf, cursor)
    entry.text = backend2FragCodecReadStrBody(buf, cursor)
    entry.dataLabel = backend2FragCodecReadStrBody(buf, cursor)
    return entry

@borrows
fn Backend2BodyIrDecode(buf: rawbytes.Bytes, cursor: var int32): coreir.BodyIR =
    if Backend2CodecReadU32(buf, cursor) != backend2BodyIrCodecMagic:
        panic("backend2_bodyir_codec_bad_magic")
    if Backend2CodecReadU32(buf, cursor) != backend2BodyIrCodecFieldCount:
        panic("backend2_bodyir_codec_bad_field_count")
    var bodyIR = coreir.BodyIRNew()
    backend2FragCodecExpectTag(buf, cursor, 1)
    let opsCount = backend2BodyIrReadCount(
        buf, cursor, 64, "backend2_bodyir_codec_ops_count_invalid")
    for i in 0..<opsCount:
        add(bodyIR.ops, backend2BodyIrReadOp(buf, cursor))
    backend2FragCodecExpectTag(buf, cursor, 2)
    let callCount = backend2BodyIrReadCount(
        buf, cursor, 100, "backend2_bodyir_codec_call_count_invalid")
    for i in 0..<callCount:
        add(bodyIR.callSequence, backend2BodyIrReadCallOp(buf, cursor))
    backend2FragCodecExpectTag(buf, cursor, 3)
    let slotsCount = backend2BodyIrReadCount(
        buf, cursor, 56, "backend2_bodyir_codec_slots_count_invalid")
    for i in 0..<slotsCount:
        add(bodyIR.localSlots, backend2BodyIrReadLocalSlot(buf, cursor))
    backend2FragCodecExpectTag(buf, cursor, 4)
    let blocksCount = backend2BodyIrReadCount(
        buf, cursor, 16, "backend2_bodyir_codec_blocks_count_invalid")
    for i in 0..<blocksCount:
        add(bodyIR.blocks, backend2BodyIrReadBlock(buf, cursor))
    backend2FragCodecExpectTag(buf, cursor, 5)
    let termsCount = backend2BodyIrReadCount(
        buf, cursor, 40, "backend2_bodyir_codec_terms_count_invalid")
    for i in 0..<termsCount:
        add(bodyIR.terms, backend2BodyIrReadTerm(buf, cursor))
    backend2FragCodecExpectTag(buf, cursor, 6)
    let cstrCount = backend2BodyIrReadCount(
        buf, cursor, 12, "backend2_bodyir_codec_cstr_count_invalid")
    for i in 0..<cstrCount:
        add(bodyIR.cstringLiterals, backend2BodyIrReadCString(buf, cursor))
    backend2BodyIrReadDataRelocationIdentity(buf, cursor, bodyIR)
    backend2FragCodecExpectTag(buf, cursor, 7)
    bodyIR.entryIsCAbi = backend2BodyIrReadBool(
        buf, cursor, "backend2_bodyir_codec_entry_cabi_flag_invalid")
    backend2FragCodecExpectTag(buf, cursor, 8)
    bodyIR.debugProvenanceRequired = backend2BodyIrReadBool(
        buf, cursor,
        "backend2_bodyir_codec_debug_required_flag_invalid")
    bodyIR.debugProvenanceComplete = backend2BodyIrReadBool(
        buf, cursor,
        "backend2_bodyir_codec_debug_complete_flag_invalid")
    bodyIR.debugFunctionId = Backend2CodecReadU32(buf, cursor)
    if !bodyIR.debugProvenanceRequired && bodyIR.debugFunctionId != -1:
        panic("backend2_bodyir_codec_debug_function_id_invalid")
    backend2FragCodecExpectTag(buf, cursor, 9)
    let debugOpCount = backend2BodyIrReadCount(
        buf, cursor, 8,
        "backend2_bodyir_codec_debug_op_count_invalid")
    for index in 0..<debugOpCount:
        add(bodyIR.debugOpIdsByOpIndex,
            Backend2CodecReadU32(buf, cursor))
        add(bodyIR.debugSyntheticKindsByOpIndex,
            Backend2CodecReadU32(buf, cursor))
    backend2FragCodecExpectTag(buf, cursor, 10)
    let debugTermCount = backend2BodyIrReadCount(
        buf, cursor, 8,
        "backend2_bodyir_codec_debug_term_count_invalid")
    for index in 0..<debugTermCount:
        add(bodyIR.debugOpIdsByTermIndex,
            Backend2CodecReadU32(buf, cursor))
        add(bodyIR.debugSyntheticKindsByTermIndex,
            Backend2CodecReadU32(buf, cursor))
    backend2FragCodecExpectTag(buf, cursor, 12)
    bodyIR.typeFactTypeIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.typeFactStructuralKinds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.typeFactScalarKinds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.typeFactChildTypeIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.typeFactFixedLengths =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.typeFactSizeBytes =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.typeFactAlignBytes =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    backend2FragCodecExpectTag(buf, cursor, 13)
    bodyIR.controlFlowSealed = backend2BodyIrReadBool(
        buf, cursor,
        "backend2_bodyir_codec_control_sealed_flag_invalid")
    bodyIR.controlFunctionRow = Backend2CodecReadU32(buf, cursor)
    bodyIR.controlScopeParentIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.blockScopeIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.termSuccessorStarts =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.termSuccessorCounts =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.successorBlockIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.successorEdgeKinds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.callTargetDomainKinds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.callTargetRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.callTargetInterfaceCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.deferDeclarationScopeIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferSuiteScopeIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferLexicalOrdinals =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferFunctionRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferStatementRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferActionCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.deferActivationSiteBlockIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferActivationSiteAfterOpOrdinals =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferActivationSiteStarts =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferActivationSiteCounts =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.deferActivationRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    backend2FragCodecExpectTag(buf, cursor, 14)
    bodyIR.manualConsume.sealed = backend2BodyIrReadBool(
        buf, cursor,
        "backend2_bodyir_codec_manual_consume_sealed_invalid")
    bodyIR.manualConsume.functionPresent =
        backend2BodyIrReadBool(
            buf, cursor,
            "backend2_bodyir_codec_manual_consume_function_present_invalid")
    bodyIR.manualConsume.functionRow =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.manualConsume.functionTargetParameterOrdinal =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.manualConsume.functionSourceParameterOrdinal =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.manualConsume.functionTargetSlotId =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.manualConsume.functionSourceSlotId =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.manualConsume.functionTargetTypeArenaTypeId =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.manualConsume.functionSourceTypeArenaTypeId =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.manualConsume.functionEffectCid =
        backend2BodyIrReadFixedBytes32(buf, cursor)
    bodyIR.manualConsume.functionBodyProofCid =
        backend2BodyIrReadFixedBytes32(buf, cursor)
    bodyIR.manualConsume.callOrdinals =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.snapshotCallIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.targetArgumentOrdinals =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.sourceArgumentOrdinals =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.targetPlaceSlotIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.targetOwnerSlotIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.sourcePlaceSlotIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.targetArgumentBindingCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.manualConsume.sourceArgumentBindingCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.manualConsume.targetProjectionCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.manualConsume.sourceProjectionCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.manualConsume.targetDefinitionDomains =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.targetDefinitionRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.sourceDefinitionDomains =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.sourceDefinitionRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.targetTypeArenaTypeIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.sourceTypeArenaTypeIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.postDefinitionDomains =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.postDefinitionRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.manualConsume.effectCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.manualConsume.linearTokenCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.manualConsume.bridgeCids =
        backend2BodyIrReadFixedBytes32SeqBody(buf, cursor)
    bodyIR.manualConsume.rootCid =
        backend2BodyIrReadFixedBytes32(buf, cursor)
    backend2FragCodecExpectTag(buf, cursor, 15)
    bodyIR.entryDefinitionOwnershipSealed =
        backend2BodyIrReadBool(
            buf, cursor,
            "backend2_bodyir_codec_entry_definition_ownership_sealed_invalid")
    bodyIR.entryDefinitionOwnershipKinds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.entryDefinitionSemanticRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.entryParameterSlotIds =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    bodyIR.localBindingValueDefinitionDomainStart =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.localBindingValueDefinitionDomainCount =
        Backend2CodecReadU32(buf, cursor)
    bodyIR.localBindingValueDefinitionRows =
        backend2BodyIrReadI32SeqBody(buf, cursor)
    backend2BodyIrReadExternFfiHandleCapabilities(
        buf, cursor, bodyIR.externFfiHandleCapabilities)
    backend2BodyIrReadCleanupAuthority(buf, cursor, bodyIR)
    backend2BodyIrReadExactDef(buf, cursor, bodyIR)
    backend2FragCodecExpectTag(buf, cursor, 11)
    if cursor < 0 || cursor > buf.len || buf.len - cursor < 32:
        panic("backend2_bodyir_codec_type_arena_cid_overrun")
    var typeArenaCidBytes = rawbytes.BytesSlice(buf, cursor, 32)
    cursor = cursor + 32
    let typeArenaCidResult =
        layout.FixedBytes32FromBytes(typeArenaCidBytes)
    rawbytes.BytesFree(typeArenaCidBytes)
    if !IsOk(typeArenaCidResult):
        panic("backend2_bodyir_codec_type_arena_cid_invalid")
    bodyIR.typeArenaArtifactCid = Value(typeArenaCidResult)
    if !coreir.BodyIRTypeArenaArtifactCidValid(
           bodyIR.typeArenaArtifactCid):
        panic("backend2_bodyir_codec_type_arena_cid_zero")
    if !coreir.BodyIRCanonicalTypeFactShapeValid(bodyIR):
        panic("backend2_bodyir_codec_type_fact_shape_invalid")
    if !coreir.BodyIRDebugProvenanceShapeValid(bodyIR):
        panic("backend2_bodyir_codec_debug_provenance_invalid")
    if !coreir.BodyIRControlFlowShapeValid(bodyIR):
        panic("backend2_bodyir_codec_control_flow_shape_invalid")
    if !coreir.BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        panic("backend2_bodyir_codec_entry_definition_ownership_invalid")
    if !coreir.BodyIREntryParameterSlotsShapeValid(bodyIR):
        panic("backend2_bodyir_codec_entry_parameter_index_invalid")
    if !coreir.BodyIRLocalBindingValueDefinitionRowsShapeValid(
           bodyIR):
        panic("backend2_bodyir_codec_local_binding_definition_invalid")
    if !coreir.BodyIRDataRelocationIdentityStrictValidate(bodyIR):
        backend2BodyIrDataRelocationIdentityDiagPanic(bodyIR)
    if !coreir.BodyIRManualConsumeSidecarShapeValid(bodyIR):
        panic("backend2_bodyir_codec_manual_consume_shape_invalid")
    if !coreir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(bodyIR):
        panic("backend2_bodyir_codec_ffi_handle_capability_shape_invalid")
    if !coreir.BodyIRCleanupProofShapeValid(bodyIR):
        panic("backend2_bodyir_codec_cleanup_proof_shape_invalid")
    if !backend2BodyIrCleanupProjectionShapeValid(bodyIR):
        panic("backend2_bodyir_codec_cleanup_projection_shape_invalid")
    if !coreir.BodyIRTypeArenaProofDomainValid(bodyIR):
        panic("backend2_bodyir_codec_type_arena_domain_invalid")
    if !exactdef.BodyIrExactDefSidecarShapeValid(bodyIR):
        panic("backend2_bodyir_codec_exact_def_shape_invalid")
    if cursor != buf.len:
        panic("backend2_bodyir_codec_trailing_bytes")
    return bodyIR

@borrows
fn Backend2BodyIrEncodedTypeArenaArtifactMatches(
        buf: rawbytes.Bytes,
        expected: layout.FixedBytes32): bool =
    if !coreir.BodyIRTypeArenaArtifactCidValid(expected) ||
       buf.len < 32:
        return false
    var cidBytes = rawbytes.BytesSlice(buf, buf.len - 32, 32)
    let parsed = layout.FixedBytes32FromBytes(cidBytes)
    rawbytes.BytesFree(cidBytes)
    return IsOk(parsed) &&
           layout.FixedBytes32Equal(Value(parsed), expected)

@borrows
fn Backend2BodyIrDecodeExpectedTypeArenaArtifact(
        buf: rawbytes.Bytes,
        cursor: var int32,
        expected: layout.FixedBytes32): coreir.BodyIR =
    if !Backend2BodyIrEncodedTypeArenaArtifactMatches(buf, expected):
        panic("backend2_bodyir_codec_type_arena_cid_mismatch")
    let bodyIR = Backend2BodyIrDecode(buf, cursor)
    if !layout.FixedBytes32Equal(
           bodyIR.typeArenaArtifactCid, expected):
        panic("backend2_bodyir_codec_type_arena_cid_decode_drift")
    return bodyIR

@borrows
fn Backend2BodyIrDecodeExpectedManualConsumeAuthority(
        buf: rawbytes.Bytes,
        cursor: var int32,
        expectedTypeArenaArtifactCid:
            layout.FixedBytes32,
        expectedManualConsumeRootCid:
            layout.FixedBytes32): coreir.BodyIR =
    let bodyIR =
        Backend2BodyIrDecodeExpectedTypeArenaArtifact(
            buf, cursor,
            expectedTypeArenaArtifactCid)
    if !coreir.BodyIRManualConsumeExactValidateAgainst(
           bodyIR, expectedManualConsumeRootCid):
        panic(
            "backend2_bodyir_codec_manual_consume_authority_mismatch")
    return bodyIR

# ---- round-trip: 编→解→再编逐字节等 (skip-lower 缓存 put 前自检, 封 enc/dec 不对称) ----

@borrows
fn Backend2BodyIrRoundTripAssert(bodyIR: coreir.BodyIR) =
    var enc1 = Backend2BodyIrEncode(bodyIR)
    var cursor: int32
    var decoded = Backend2BodyIrDecode(enc1, cursor)
    if cursor != enc1.len:
        panic("backend2_bodyir_codec_roundtrip_trailing_bytes")
    var enc2 = Backend2BodyIrEncode(decoded)
    if !rawbytes.BytesEqual(enc1, enc2):
        panic("backend2_bodyir_codec_roundtrip_byte_mismatch")
    rawbytes.BytesFree(enc1)
    rawbytes.BytesFree(enc2)
