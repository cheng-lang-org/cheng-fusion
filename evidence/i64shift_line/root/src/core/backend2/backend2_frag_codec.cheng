fn backend2BodyIrCleanupAllocationBudgetTake(
        budget: var int32,
        count: int32,
        itemBytes: int32) =
    if budget < 0 || count < 0 || itemBytes <= 0 ||
       count > budget / itemBytes:
        panic("backend2_bodyir_codec_cleanup_decode_allocation_budget_exceeded")
    budget = budget - count * itemBytes

@borrows
fn backend2BodyIrReadCleanupI32Column(
        buf: rawbytes.Bytes,
        cursor: var int32,
        allocationBudget: var int32): int32[] =
    let count = Backend2CodecReadU32(buf, cursor)
    if count < 0 || cursor < 0 || cursor > buf.len ||
       count > (buf.len - cursor) / 4:
        panic("backend2_bodyir_codec_cleanup_i32_column_overrun")
    backend2BodyIrCleanupAllocationBudgetTake(
        allocationBudget, count, 4)
    var out: int32[]
    setLen(out, count)
    for row in 0..<count:
        out[row] = Backend2CodecReadU32(buf, cursor)
    return out

@borrows
fn backend2BodyIrReadCleanupFixed32Column(
        buf: rawbytes.Bytes,
        cursor: var int32,
        allocationBudget: var int32): layout.FixedBytes32[] =
    let count = Backend2CodecReadU32(buf, cursor)
    if count < 0 || cursor < 0 || cursor > buf.len ||
       count > (buf.len - cursor) / 32:
        panic("backend2_bodyir_codec_cleanup_fixed32_column_overrun")
    backend2BodyIrCleanupAllocationBudgetTake(
        allocationBudget, count, 32)
    var out: layout.FixedBytes32[]
    setLen(out, count)
    for row in 0..<count:
        out[row] = backend2BodyIrReadFixedBytes32(buf, cursor)
    return out

@borrows
fn backend2BodyIrReadCleanupAuthority(
        buf: rawbytes.Bytes,
        cursor: var int32,
        bodyIR: var coreir.BodyIR) =
    if coreir.BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSourceProjectionCid) ||
       !coreir.BodyIRCleanupIntentSidecarIsCanonicalEmpty(
           bodyIR.cleanupIntent) ||
       !coreir.BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
           bodyIR.cleanupSchedule) ||
       !coreir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
           bodyIR.deferReplay):
        panic("backend2_bodyir_codec_cleanup_destination_not_empty")
    backend2FragCodecExpectTag(buf, cursor, 17)
    # The following tag11 + TypeArena CID is fixed at 36 bytes. The budget is
    # the maximum retained cleanup-column payload permitted by this input.
    if cursor < 0 || cursor > buf.len ||
       buf.len - cursor <
           backend2BodyIrCleanupFixedBytesAfterTag + 36:
        panic("backend2_bodyir_codec_cleanup_section_truncated")
    var allocationBudget =
        buf.len - cursor - 36 -
            backend2BodyIrCleanupFixedBytesAfterTag
    bodyIR.cleanupSourceProjectionCid =
        backend2BodyIrReadFixedBytes32(buf, cursor)
    bodyIR.cleanupIntent.building = backend2BodyIrReadBool(
        buf, cursor,
        "backend2_bodyir_codec_cleanup_intent_building_invalid")
    bodyIR.cleanupIntent.sealed = backend2BodyIrReadBool(
        buf, cursor,
        "backend2_bodyir_codec_cleanup_intent_sealed_invalid")
