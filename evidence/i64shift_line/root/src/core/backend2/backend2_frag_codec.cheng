@borrows
fn backend2BodyIrReadCount(buf: rawbytes.Bytes,
                           cursor: var int32,
                           minBytesPerItem: int32,
                           errorText: str): int32 =
    let count = Backend2CodecReadU32(buf, cursor)
    if count < 0 || minBytesPerItem <= 0 || cursor < 0 ||
       cursor > buf.len || count > (buf.len - cursor) / minBytesPerItem:
        panic(errorText)
    return count

@borrows
fn backend2BodyIrReadOp(buf: rawbytes.Bytes, cursor: var int32): coreir.BodyOp =
    var op: coreir.BodyOp
    op.kind = Backend2CodecReadU32(buf, cursor)
    op.target = Backend2CodecReadU32(buf, cursor)
    op.valueDefSlot = Backend2CodecReadU32(buf, cursor)
    op.valueDefExprNodeIndex = Backend2CodecReadU32(buf, cursor)
    op.valueDefSemanticRow = Backend2CodecReadU32(buf, cursor)
    op.valueDefOwnership = Backend2CodecReadU32(buf, cursor)
    op.valueDefBorrowOwnerSemanticRow =
        Backend2CodecReadU32(buf, cursor)
    op.valueDefBorrowOwnerDefinitionDomain =
        Backend2CodecReadU32(buf, cursor)
    op.valueDefBorrowOwnerDefinitionRow =
        Backend2CodecReadU32(buf, cursor)
    op.valueDefConsumeOpIndexPlusOne = Backend2CodecReadU32(buf, cursor)
    op.valueDefOriginKind = Backend2CodecReadU32(buf, cursor)
    op.valueDefOriginId = Backend2CodecReadU32(buf, cursor)
    op.sourceDefinitionDomain = Backend2CodecReadU32(buf, cursor)
    op.sourceDefinitionRow = Backend2CodecReadU32(buf, cursor)
    op.consumeActionRow = Backend2CodecReadU32(buf, cursor)
    op.operands = backend2BodyIrReadI32SeqBody(buf, cursor)
    return op

@borrows
fn backend2BodyIrReadCallOp(buf: rawbytes.Bytes, cursor: var int32): coreir.CallOp =
    var callOp: coreir.CallOp
    callOp.targetSymbol = backend2FragCodecReadStrBody(buf, cursor)
    callOp.targetSourcePath = backend2FragCodecReadStrBody(buf, cursor)
    callOp.argSlots = backend2BodyIrReadI32SeqBody(buf, cursor)
    callOp.argPassKinds = backend2BodyIrReadI32SeqBody(buf, cursor)
    callOp.argAbiSizes = backend2BodyIrReadI32SeqBody(buf, cursor)
    callOp.resultSlot = Backend2CodecReadU32(buf, cursor)
    callOp.resultPassKind = Backend2CodecReadU32(buf, cursor)
    callOp.resultOwnership = Backend2CodecReadU32(buf, cursor)
    callOp.resultExprNodeIndex = Backend2CodecReadU32(buf, cursor)
    callOp.resultValueDefinitionRow =
        Backend2CodecReadU32(buf, cursor)
    callOp.resultBorrowOwnerValueDefinitionRow =
        Backend2CodecReadU32(buf, cursor)
    callOp.resultBorrowOwnerDefinitionDomain =
        Backend2CodecReadU32(buf, cursor)
    callOp.resultBorrowOwnerDefinitionRow =
        Backend2CodecReadU32(buf, cursor)
    callOp.resultDefinitionOriginKind =
        Backend2CodecReadU32(buf, cursor)
