# backend2_frag_codec — FunctionFragment 扁平 LE 字节编解码 (slice-11 fork 管道线格式)。
# 纲领: docs/beat-c.md §4.B.② slice-11 — worker 子进程经 pipe 回传
# fragment, 本模块是唯一的线格式定义。铁律同 backend2_types: 零 import 编译器状态
# (只允许 std / b2t), 纯函数, 无模块级可变态。
#
# 线格式 (全 LE, u32 = int32 按位序列化):
#   header : magic(u32) fieldCount(u32=18)
#   fields : 按 b2t.FunctionFragment 声明序逐字段, 每字段前置 tag(u32 = 1-based 字段序),
#            str      → len(u32) + bytes
#            int32    → u32
#            int32[]  → count(u32) + count×u32
#            str[]    → count(u32) + count×(len(u32)+bytes)
#
# 完整性契约 (漏字段 = 静默缺 reloc, 双重封死):
#   ① Backend2FragmentRoundTripAssert: 编→解→再编逐字节等 (封 enc/dec 不对称);
#   ② round-trip 无法发现 enc/dec **双双**跳过的新增字段 —— 该洞由 jobs=1-vs-N 产物
#      SHA 等式门封 (tools/backend2_jobs_gate.sh): 缺字段 → fragment 内容缺失 → .o 漂移
#      → 门 FAIL。给 b2t.FunctionFragment 加字段时必须同步改本文件 3 处
#      (fieldCount 常量 / EncodedSize / Encode+Decode) 并重跑 jobs 门。

import std/strings
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/core/backend2/backend2_types as b2t
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_exact_def as exactdef

const
    backend2FragCodecMagic: int32 = 0x42324647          # "GF2B" (LE 字节序: 47 46 32 42)
    backend2FragCodecFieldCount: int32 = 18             # = b2t.FunctionFragment 字段数, 加字段必增

# ---- u32 LE 原语 (导出供 fork 池帧头复用) ----

fn Backend2CodecPutU32(buf: var rawbytes.Bytes, off: int32, value: int32) =
    if off < 0 || off > buf.len || buf.len - off < 4:
        panic("backend2_frag_codec_put_u32_out_of_bounds")
    rawbytes.BytesSet(buf, off, value & 255)
    rawbytes.BytesSet(buf, off + 1, (value >> 8) & 255)
    rawbytes.BytesSet(buf, off + 2, (value >> 16) & 255)
    rawbytes.BytesSet(buf, off + 3, (value >> 24) & 255)

@borrows
fn Backend2CodecReadU32(buf: rawbytes.Bytes, cursor: var int32): int32 =
    if cursor < 0 || cursor > buf.len || buf.len - cursor < 4:
        panic("backend2_frag_codec_read_u32_overrun")
    let off: int32 = cursor
    let b0 = rawbytes.BytesGet(buf, off)
    let b1 = rawbytes.BytesGet(buf, off + 1)
    let b2 = rawbytes.BytesGet(buf, off + 2)
    let b3 = rawbytes.BytesGet(buf, off + 3)
    cursor = off + 4
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

# ---- 编码尺寸 (两遍法第一遍: 精确字节数, 单次 alloc) ----

fn backend2CodecSizeAdd(total: var int32, delta: int32) =
    if total < 0 || delta < 0 || total > 2147483647 - delta:
        panic("backend2_codec_size_overflow")
    total = total + delta

fn backend2CodecSizeWithWords(base: int32, count: int32): int32 =
    if base < 0 || count < 0 || count > (2147483647 - base) / 4:
        panic("backend2_codec_word_count_overflow")
    return base + count * 4

@borrows
fn backend2FragCodecStrSize(s: str): int32 =
    var total: int32 = 8                                # tag + len
    backend2CodecSizeAdd(total, strings.Len(s))
    return total

fn backend2FragCodecStrSeqSize(items: var str[]): int32 =
    var total: int32 = 4 + 4                            # tag + count
    for i in 0..<items.len:
        backend2CodecSizeAdd(total, 4)
        backend2CodecSizeAdd(total, strings.Len(items[i]))
    return total

fn backend2FragCodecI32SeqSize(items: var int32[]): int32 =
    return backend2CodecSizeWithWords(8, items.len)     # tag + count + words

fn Backend2FragmentEncodedSize(
        frag: var b2t.FunctionFragment): int32 =
    var total: int32 = 8                                # magic + fieldCount
    backend2CodecSizeAdd(total, backend2FragCodecStrSize(frag.funcEmitCid))
    backend2CodecSizeAdd(total, backend2FragCodecStrSize(frag.functionSymbol))
    backend2CodecSizeAdd(total, 8)                       # tag + wordCount 标量
    backend2CodecSizeAdd(total, backend2FragCodecI32SeqSize(frag.words))
    backend2CodecSizeAdd(total, backend2FragCodecI32SeqSize(frag.relocWordOffsets))
    backend2CodecSizeAdd(total, backend2FragCodecStrSeqSize(frag.relocTargetSymbols))
    backend2CodecSizeAdd(total, backend2FragCodecStrSeqSize(frag.refSymbols))
    backend2CodecSizeAdd(total, backend2FragCodecStrSeqSize(frag.cstringLiterals))
    backend2CodecSizeAdd(total, backend2FragCodecStrSeqSize(frag.cstringDataLabels))
    backend2CodecSizeAdd(total, backend2FragCodecI32SeqSize(frag.cstringPayloadRawBytes))
    backend2CodecSizeAdd(total, backend2FragCodecI32SeqSize(frag.cstringPayloadRawByteCounts))
    backend2CodecSizeAdd(total, backend2FragCodecI32SeqSize(frag.dataRelocFnRelWordOffsets))
    backend2CodecSizeAdd(total, backend2FragCodecStrSeqSize(frag.dataRelocTargetLabels))
    backend2CodecSizeAdd(total, backend2FragCodecStrSeqSize(frag.globalDataLabelsRaw))
    backend2CodecSizeAdd(total, backend2FragCodecStrSeqSize(frag.globalDataPayloadTexts))
    backend2CodecSizeAdd(total, backend2FragCodecI32SeqSize(frag.globalDataPayloadByteCounts))
    backend2CodecSizeAdd(total, backend2FragCodecStrSize(frag.bodyIrPayload))
    backend2CodecSizeAdd(total, backend2FragCodecStrSize(frag.contentCid))
    return total

# ---- 编码 (第二遍: 游标填充, 终点等式断言封游标漂移) ----

@borrows
fn backend2FragCodecPutStrBody(buf: var rawbytes.Bytes, cursor: var int32, s: str) =
    let view = rawbytes.BytesFromString(s)              # 零拷贝视图, 勿 free
    if cursor < 0 || cursor > buf.len || view.len < 0 ||
       view.len > buf.len - cursor - 4:
        panic("backend2_frag_codec_put_str_out_of_bounds")
    Backend2CodecPutU32(buf, cursor, view.len)
    cursor = cursor + 4
    if view.len > 0:
        rawbytes.BytesCopyRangeInto(buf, cursor, view, 0, view.len)
        cursor = cursor + view.len

fn backend2FragCodecPutTag(buf: var rawbytes.Bytes, cursor: var int32, tag: int32) =
    Backend2CodecPutU32(buf, cursor, tag)
    cursor = cursor + 4

@borrows
fn backend2FragCodecPutStrField(buf: var rawbytes.Bytes, cursor: var int32, tag: int32, s: str) =
    backend2FragCodecPutTag(buf, cursor, tag)
    backend2FragCodecPutStrBody(buf, cursor, s)

fn backend2FragCodecPutStrSeqField(buf: var rawbytes.Bytes,
                                  cursor: var int32,
                                  tag: int32,
                                  items: var str[]) =
    backend2FragCodecPutTag(buf, cursor, tag)
    Backend2CodecPutU32(buf, cursor, items.len)
    cursor = cursor + 4
    for i in 0..<items.len:
        backend2FragCodecPutStrBody(buf, cursor, items[i])

fn backend2FragCodecPutI32SeqField(buf: var rawbytes.Bytes,
                                  cursor: var int32,
                                  tag: int32,
                                  items: var int32[]) =
    backend2FragCodecPutTag(buf, cursor, tag)
    Backend2CodecPutU32(buf, cursor, items.len)
    cursor = cursor + 4
    for i in 0..<items.len:
        Backend2CodecPutU32(buf, cursor, items[i])
        cursor = cursor + 4

fn backend2FragmentEncodeExact(
        frag: var b2t.FunctionFragment,
        scrubContentCidKeys: bool): rawbytes.Bytes =
    var total = Backend2FragmentEncodedSize(frag)
    if scrubContentCidKeys:
        total = total - strings.Len(frag.funcEmitCid) -
                strings.Len(frag.contentCid)
    var buf = rawbytes.BytesAlloc(total)
    if buf.data == nil:
        panic("backend2_frag_codec_encode_alloc_failed")
    var cursor: int32
    Backend2CodecPutU32(buf, cursor, backend2FragCodecMagic)
    cursor = cursor + 4
    Backend2CodecPutU32(buf, cursor, backend2FragCodecFieldCount)
    cursor = cursor + 4
    if scrubContentCidKeys:
        backend2FragCodecPutStrField(buf, cursor, 1, "")
    else:
        backend2FragCodecPutStrField(buf, cursor, 1, frag.funcEmitCid)
    backend2FragCodecPutStrField(buf, cursor, 2, frag.functionSymbol)
    backend2FragCodecPutTag(buf, cursor, 3)
    Backend2CodecPutU32(buf, cursor, frag.wordCount)
    cursor = cursor + 4
    backend2FragCodecPutI32SeqField(buf, cursor, 4, frag.words)
    backend2FragCodecPutI32SeqField(buf, cursor, 5, frag.relocWordOffsets)
    backend2FragCodecPutStrSeqField(buf, cursor, 6, frag.relocTargetSymbols)
    backend2FragCodecPutStrSeqField(buf, cursor, 7, frag.refSymbols)
    backend2FragCodecPutStrSeqField(buf, cursor, 8, frag.cstringLiterals)
    backend2FragCodecPutStrSeqField(buf, cursor, 9, frag.cstringDataLabels)
    backend2FragCodecPutI32SeqField(buf, cursor, 10, frag.cstringPayloadRawBytes)
    backend2FragCodecPutI32SeqField(buf, cursor, 11, frag.cstringPayloadRawByteCounts)
    backend2FragCodecPutI32SeqField(buf, cursor, 12, frag.dataRelocFnRelWordOffsets)
    backend2FragCodecPutStrSeqField(buf, cursor, 13, frag.dataRelocTargetLabels)
    backend2FragCodecPutStrSeqField(buf, cursor, 14, frag.globalDataLabelsRaw)
    backend2FragCodecPutStrSeqField(buf, cursor, 15, frag.globalDataPayloadTexts)
    backend2FragCodecPutI32SeqField(buf, cursor, 16, frag.globalDataPayloadByteCounts)
    backend2FragCodecPutStrField(buf, cursor, 17, frag.bodyIrPayload)
    if scrubContentCidKeys:
        backend2FragCodecPutStrField(buf, cursor, 18, "")
    else:
        backend2FragCodecPutStrField(buf, cursor, 18, frag.contentCid)
    if cursor != total:
        panic("backend2_frag_codec_encode_cursor_mismatch")
    return buf

fn Backend2FragmentEncode(
        frag: var b2t.FunctionFragment): rawbytes.Bytes =
    return backend2FragmentEncodeExact(frag, false)

fn Backend2FragmentEncodeForContentCid(
        frag: var b2t.FunctionFragment): rawbytes.Bytes =
    return backend2FragmentEncodeExact(frag, true)

# ---- 解码 (malformed = 硬崩, 绝不静默产垃圾) ----

@borrows
fn backend2FragCodecExpectTag(buf: rawbytes.Bytes, cursor: var int32, tag: int32) =
    if Backend2CodecReadU32(buf, cursor) != tag:
        panic("backend2_frag_codec_field_tag_mismatch")

@borrows
fn backend2FragCodecReadStrBody(buf: rawbytes.Bytes, cursor: var int32): str =
    let n = Backend2CodecReadU32(buf, cursor)
    if n < 0 || cursor < 0 || cursor > buf.len || n > buf.len - cursor:
        panic("backend2_frag_codec_str_len_overrun")
    if n <= 0:
        return ""
    let view = rawbytes.BytesSliceView(buf, cursor, n)
    cursor = cursor + n
    return rawbytes.BytesToString(view)

@borrows
fn backend2FragCodecReadStrField(buf: rawbytes.Bytes, cursor: var int32, tag: int32): str =
    backend2FragCodecExpectTag(buf, cursor, tag)
    return backend2FragCodecReadStrBody(buf, cursor)

@borrows
fn backend2FragCodecReadStrSeqField(buf: rawbytes.Bytes, cursor: var int32, tag: int32): str[] =
    backend2FragCodecExpectTag(buf, cursor, tag)
    let count = Backend2CodecReadU32(buf, cursor)
    if count < 0 || cursor < 0 || cursor > buf.len ||
       count > (buf.len - cursor) / 4:
        panic("backend2_frag_codec_str_seq_count_negative")
    var out: str[]
    for i in 0..<count:
        add(out, backend2FragCodecReadStrBody(buf, cursor))
    return out

@borrows
fn backend2FragCodecReadI32SeqField(buf: rawbytes.Bytes, cursor: var int32, tag: int32): int32[] =
    backend2FragCodecExpectTag(buf, cursor, tag)
    let count = Backend2CodecReadU32(buf, cursor)
    if count < 0 || cursor < 0 || cursor > buf.len ||
       count > (buf.len - cursor) / 4:
        panic("backend2_frag_codec_i32_seq_overrun")
    var out: int32[]
    for i in 0..<count:
        add(out, Backend2CodecReadU32(buf, cursor))
    return out

@borrows
fn Backend2FragmentDecode(buf: rawbytes.Bytes, cursor: var int32): b2t.FunctionFragment =
    if Backend2CodecReadU32(buf, cursor) != backend2FragCodecMagic:
        panic("backend2_frag_codec_bad_magic")
    if Backend2CodecReadU32(buf, cursor) != backend2FragCodecFieldCount:
        panic("backend2_frag_codec_bad_field_count")
    var frag: b2t.FunctionFragment
    frag.funcEmitCid = backend2FragCodecReadStrField(buf, cursor, 1)
    frag.functionSymbol = backend2FragCodecReadStrField(buf, cursor, 2)
    backend2FragCodecExpectTag(buf, cursor, 3)
    frag.wordCount = Backend2CodecReadU32(buf, cursor)
    frag.words = backend2FragCodecReadI32SeqField(buf, cursor, 4)
    frag.relocWordOffsets = backend2FragCodecReadI32SeqField(buf, cursor, 5)
    frag.relocTargetSymbols = backend2FragCodecReadStrSeqField(buf, cursor, 6)
    frag.refSymbols = backend2FragCodecReadStrSeqField(buf, cursor, 7)
    frag.cstringLiterals = backend2FragCodecReadStrSeqField(buf, cursor, 8)
    frag.cstringDataLabels = backend2FragCodecReadStrSeqField(buf, cursor, 9)
    frag.cstringPayloadRawBytes = backend2FragCodecReadI32SeqField(buf, cursor, 10)
    frag.cstringPayloadRawByteCounts = backend2FragCodecReadI32SeqField(buf, cursor, 11)
    frag.dataRelocFnRelWordOffsets = backend2FragCodecReadI32SeqField(buf, cursor, 12)
    frag.dataRelocTargetLabels = backend2FragCodecReadStrSeqField(buf, cursor, 13)
    frag.globalDataLabelsRaw = backend2FragCodecReadStrSeqField(buf, cursor, 14)
    frag.globalDataPayloadTexts = backend2FragCodecReadStrSeqField(buf, cursor, 15)
    frag.globalDataPayloadByteCounts = backend2FragCodecReadI32SeqField(buf, cursor, 16)
    frag.bodyIrPayload = backend2FragCodecReadStrField(buf, cursor, 17)
    frag.contentCid = backend2FragCodecReadStrField(buf, cursor, 18)
    return frag

# ---- round-trip 断言: 编→解→再编逐字节等 (worker 发送前每 fragment 常开自检) ----

fn Backend2FragmentRoundTripAssert(
        frag: var b2t.FunctionFragment) =
    var enc1 = Backend2FragmentEncode(frag)
    var cursor: int32
    var decoded = Backend2FragmentDecode(enc1, cursor)
    if cursor != enc1.len:
        panic("backend2_frag_codec_roundtrip_trailing_bytes")
    var enc2 = Backend2FragmentEncode(decoded)
    if !rawbytes.BytesEqual(enc1, enc2):
        panic("backend2_frag_codec_roundtrip_byte_mismatch")
    rawbytes.BytesFree(enc1)
    rawbytes.BytesFree(enc2)

# =============================================================================
# BodyIR 编解码 (warm-incremental skip-lower, spec §12.6 slice #1)。
# 复用 frag codec 的 LE u32 原语 (Backend2CodecPutU32/ReadU32) + str body helpers。
# 线格式 (全 LE):
#   header : magic(u32) fieldCount(u32=18)
#   field 1 ops            : tag(u32=1) count(u32) count×BodyOp{ kind(u32), target(u32),
#                                  canonical value-def authority(u32×10),
#                                  operands: count(u32)+count×u32 }
#   field 2 callSequence   : tag(u32=2) count(u32) count×CallOp{ targetSymbol(str),
#                                  targetSourcePath(str),
#                                  argSlots:count+u32s, argPassKinds:count+u32s,
#                                  argAbiSizes:count+u32s, resultSlot(u32),
#                                  resultPassKind(u32), result/source authority,
#                                  semanticCallExprNodeIndex(u32),
#                                  relocWordOffset(u32),
#                                  targetIsImportc(u32), inlineF64FromIntKind(u32),
#                                  wholeCallF64FromIntRescue(u32),
#                                  inlineF64FromIntUnsigned(u32) }
#   field 3 localSlots     : tag(u32=3) count(u32) count×LocalSlot{ id(u32), name(str),
#                                  typeKind(u32), typeArenaTypeId(u32),
#                                  managedStorageKind(u32), placeKind(u32),
#                                  stackOffset(u32), sizeBytes(u32),
#                                  alignBytes(u32), auxValue(u32),
#                                  ownership(u32), aliasClass(u32), escapeKind(u32),
#                                  noAlias(u32) }
#   field 4 blocks         : tag(u32=4) count(u32) count×BodyBlock{ id(u32), opStart(u32),
#                                  opCount(u32), termIndex(u32) }
#   field 5 terms          : tag(u32=5) count(u32) count×BodyTerm{ kind(u32),
#                                  conditionKind(u32), resultSlot(u32), lhsSlot(u32),
#                                  rhsSlot(u32), trueBlock(u32), falseBlock(u32),
#                                  sourceDefinitionDomain(u32),
#                                  sourceDefinitionRow(u32),
#                                  operands: count(u32)+count×u32 }
#   field 6 cstringLiterals: tag(u32=6) count(u32) count×CStringLiteralEntry{ id(u32),
#                                  text(str), dataLabel(str) }
#   field 7 entryIsCAbi    : tag(u32=7) bool(u32)
#   field 8 debug identity : tag(u32=8) required(u32), complete(u32), functionId(u32)
#   field 9 op provenance  : tag(u32=9) count(u32) count×{ debugOpId(u32),
#                                  syntheticKind(u32) }
#   field 10 term provenance: tag(u32=10) count(u32) count×{ debugOpId(u32),
#                                  syntheticKind(u32) }
#   field 12 canonical TypeArena facts : tag(u32=12) + 7 i32 sequences
#   field 13 structured control facts : tag(u32=13), sealed/function scalars,
#                                  18 i32 sequences, 2 FixedBytes32 sequences
#   field 14 manual-consume facts : tag(u32=14), sealed/function scalars,
#                                  15 i32 sequences, 7 FixedBytes32 sequences,
#                                  function/effect/body/root FixedBytes32 values
#   field 15 entry definition ownership : tag(u32=15), sealed(u32),
#                                  exact LocalSlot-row ownership sequence,
#                                  immutable function value-definition
#                                  domain start/count + exact slot binding rows
#   field 16 extern FFI handle capabilities : tag(u32=16), sealed/function
#                                  scalars, 24 i32 sequences,
#                                  11 FixedBytes32 sequences and four
#                                  authority/root FixedBytes32 values
#   field 17 cleanup authority atom : tag(u32=17), cleanupSourceProjectionCid,
#                                  Intent scalars + 47 SoA/CSR columns,
#                                  Schedule scalars + 27 SoA/CSR columns,
#                                  Replay scalars + 3 SoA/CSR columns
#   field 18 data relocation identity : tag(u32=18), sealed(u32),
#                                  LocalSlot-indexed target domain/row/CID and
#                                  CString-row/owner-function-fragment-CID
#   field 19 ExactDef 侧车 (批 1) : tag(u32=19), sealed(u32),
#                                  op/slot dense 9 + 3 i32 列, call-arg CSR
#                                  2 + 4 i32 列, exactDefCid 32 字节;
#                                  在 field 17 之后 field 11 之前
#   field 11 TypeArena CID : tag(u32=11) fixed 32 raw bytes, intentionally last
#                                  so the constant-time artifact matcher reads
#                                  the same canonical payload tail.
# 故意不序列化（旧 emitter 的派生状态）:
#   slotNameIndex (byte-neutral 加速器, 空=有效, Put 自动重建, verify-on-hit 保语义),
#   frameMetricsReady/frame*/layout*/loop* (canonical allocator 不读)。
# 完整性: round-trip (编→解→再编逐字节等) 封 enc/dec 不对称; 加字段必同步 3 处
# (fieldCount / EncodedSize / Encode+Decode) 并重跑 skip-lower 字节恒等门。
# =============================================================================

const
    backend2BodyIrCodecMagic: int32 = 0x42424956          # exact data relocation identity schema
    backend2BodyIrCodecFieldCount: int32 = 19
    backend2BodyIrCleanupFixedBytesAfterTag: int32 = 608

fn Backend2BodyIrCodecFieldCount(): int32 =
    return backend2BodyIrCodecFieldCount

fn Backend2BodyIrCodecMagic(): int32 =
    return backend2BodyIrCodecMagic

# ---- 编码尺寸 (两遍法第一遍) ----

@borrows
fn backend2BodyIrOpSize(op: coreir.BodyOp): int32 =
    return backend2CodecSizeWithWords(64, op.operands.len)

@borrows
fn backend2BodyIrCallOpSize(
        bodyIR: coreir.BodyIR,
        callIndex: int32): int32 =
    # str = len(u32)+bytes (无 tag; 结构内字段); 三 i32seq = count(u32)+words.
    var total: int32 = 4
    backend2CodecSizeAdd(
        total, strings.Len(bodyIR.callSequence[callIndex].targetSymbol))
    backend2CodecSizeAdd(total, 4)
    backend2CodecSizeAdd(
        total, strings.Len(bodyIR.callSequence[callIndex].targetSourcePath))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.callSequence[callIndex].argSlots.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.callSequence[callIndex].argPassKinds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.callSequence[callIndex].argAbiSizes.len))
    backend2CodecSizeAdd(total, 4 * 20)                  # twenty scalar fields
    return total

@borrows
fn backend2BodyIrLocalSlotSize(slot: coreir.LocalSlot,
                               scrubLocalName: bool): int32 =
    # id(u32) + name str(len+bytes) + 12×u32
    # (typeKind, semantic storage proof, physical slot fields).
    var total: int32 = 56
    if !scrubLocalName ||
       slot.placeKind == coreir.BodyPlaceGlobalAddressTag:
        backend2CodecSizeAdd(total, strings.Len(slot.name))
    return total

@borrows
fn backend2BodyIrBlockSize(blk: coreir.BodyBlock): int32 =
    return 4 * 4                                         # id + opStart + opCount + termIndex

@borrows
fn backend2BodyIrTermSize(term: coreir.BodyTerm): int32 =
    return backend2CodecSizeWithWords(40, term.operands.len)

@borrows
fn backend2BodyIrCStringSize(
        entry: coreir.CStringLiteralEntry): int32 =
    # id(u32) + text str(len+bytes) + dataLabel str(len+bytes)。
    var total: int32 = 12
    backend2CodecSizeAdd(total, strings.Len(entry.text))
    backend2CodecSizeAdd(total, strings.Len(entry.dataLabel))
    return total

fn backend2BodyIrFixedBytes32SeqSize(count: int32): int32 =
    if count < 0 || count > (2147483647 - 4) / 32:
        panic("backend2_bodyir_codec_fixed32_count_overflow")
    return 4 + count * 32

@borrows
fn backend2BodyIrDataRelocationIdentitySize(
        bodyIR: coreir.BodyIR): int32 =
    var total: int32 = 8
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.localAddressTargetDomainKinds.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.localAddressTargetRows.len))
    backend2CodecSizeAdd(
        total, backend2BodyIrFixedBytes32SeqSize(
            bodyIR.localAddressTargetCids.len))
    backend2CodecSizeAdd(
        total, backend2CodecSizeWithWords(
            4, bodyIR.cstringTargetRows.len))
    backend2CodecSizeAdd(
        total, backend2BodyIrFixedBytes32SeqSize(
            bodyIR.cstringOwnerFunctionFragmentCids.len))
    return total

@borrows
fn backend2BodyIrControlFlowSize(bodyIR: coreir.BodyIR): int32 =
    var total: int32 = 12
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.controlScopeParentIds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(4, bodyIR.blockScopeIds.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.termSuccessorStarts.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(
            4, bodyIR.termSuccessorCounts.len))
    backend2CodecSizeAdd(
        total,
        backend2CodecSizeWithWords(4, bodyIR.successorBlockIds.len))
    backend2CodecSizeAdd(
