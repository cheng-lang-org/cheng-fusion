# backend2_lower_stmt — lower 收割 W4 悬崖波后半 (manifest_w0: file=lower_stmt 全部
# 5fn/5,060 loc, 含主入口 B2PrimaryBuildBodyIrFromTypedStatements 4,849 行)。
# 函数体逐字复制自 src/core/backend/primary_object_plan.cheng (source_sha256 ee2cbff6…,
# 抽取时 5/5 body_sha256==manifest)。调用引用: 集内直名; lower/slots/util 档直名经下方三行
# alias-free import (DAG: stmt→lower→slots→util 无环); 调未收割 pobj fn = 0。
# 体文本编辑账 (仅一类: 协议 var 单侧化 accessor 接线, 逐行机器计数验证, 其余逐字):
#   (a) `primaryBodyIrNodeEvalMissOp = ""` → PrimaryBodyIrNodeEvalMissOpReset() ×14;
#       读位 token → PrimaryBodyIrNodeEvalMissOpText() ×9 (util 档 owner accessor);
#   (b) primaryBodyIrNodeEvalCallEmitCount 读位 → PrimaryBodyIrNodeEvalCallEmitCountNow() ×32;
#   (c) `(primaryAggCtorLastFailIndex << 8) | primaryAggCtorLastFailCode)` →
#       PrimaryBodyIrAggCtorLastFailDetail()) ×1 (slots 档 owner accessor, 写者全在 slots)。
# 动机同 backend2_lower 头注 (W4 一致性审计②)。分裂态全局 = 0, 不持副本。

import std/os
import std/cmdline
import std/result
import std/strings
import std/strutils as strutil
import std/strformat
import std/atomic
import std/thread
import std/hashmaps
import cheng/core/tooling/compiler_request as creq
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/target_matrix as tmat
import cheng/core/backend/data_payload_codec as payloadcodec
import cheng/core/tooling/path as chengpath
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_noalias as noalias
import cheng/core/ir/body_ir_egraph as egraph
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/intern as langintern
import cheng/core/runtime/arena as arenamod
import cheng/core/backend2/backend2_lower_util
import cheng/core/backend2/backend2_lower_slots
import cheng/core/backend2/backend2_lower

@borrows
fn B2PrimaryBodyIrAppendI32ConstReturn(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        currentBlockStart: var int32,
        value: int32) =
    let slot = PrimaryBodyIrFindOrCreateSlot(
        bodyIR,
        slotNames,
        Fmt"#i32_const_ret#{bodyIR.ops.len}",
        coreir.LocalI32Tag)
    if slot < 0:
        panic("backend2 i32 const return slot missing")
    var constOp: coreir.BodyOp
    constOp.kind = coreir.BodyOpLoadConstTag
    constOp.target = slot
    add(constOp.operands, coreir.LocalI32Tag)
    add(constOp.operands, value)
    let _ = coreir.BodyIRAppendOp(bodyIR, constOp)
    PrimaryBodyIrAppendReturnTerm(
        bodyIR,
        currentBlockStart,
        slot,
        coreir.LocalI32Tag,
        0,
        false)

@borrows
fn B2PrimaryBodyIrAppendReturnResultConstructFromSameLineStructured(
    bodyIR: var coreir.BodyIR,
    slotNames: var str[],
    varI32ParamNames: str[],
    lowering: lower.LoweringPlanStub,
    typedFn: texpr.TypedExprIrFunction,
    irFunction: var lower.PrimaryObjectIrFunction,
    stmtIndex: int32,
    sameLineOrder: int32[],
    sameLineLo: int32[],
    sameLineHi: int32[],
    currentBlockStart: var int32,
    callOrdinal: var int32
): bool =
    if stmtIndex < 0 || stmtIndex >= irFunction.statements.len:
        return false
    let stmt = irFunction.statements[stmtIndex]
    for scanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
        let scanIndex = sameLineOrder[scanP]
        if scanIndex < 0 || scanIndex >= irFunction.statements.len:
            continue
        let rcStmt = irFunction.statements[scanIndex]
        if rcStmt.kind != texpr.TypedExprIrStmtResultIntrinsic ||
           !rcStmt.returnRoot:
            continue
        if rcStmt.callCallee == "":
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         6101,
                                         int32(rcStmt.detailKind))
            return true
        if rcStmt.callCallee == "Ok" || rcStmt.callCallee == "Err":
            if !PrimaryBodyIrResultConstructorContract(lowering.typedIr,
                                                        typedFn,
                                                        irFunction,
                                                        rcStmt):
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             6101,
                                             int32(rcStmt.detailKind))
                return true
    return PrimaryBodyIrAppendReturnResultConstructFromSameLine(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,
                                                                 typedFn,
                                                                 irFunction,
                                                                 stmtIndex,
                                                                 sameLineOrder,
                                                                 sameLineLo,
                                                                 sameLineHi,
                                                                 currentBlockStart,
                                                                 callOrdinal)

fn PrimaryBodyIrRecordSeqAddReceipt(nodeEvalOnlyActive: bool,
                                    outcome: PrimaryBodyIrSeqAddOutcome,
                                    typedContract: bool,
                                    nodeProbeHit: bool,
                                    typeMismatch: bool,
                                    candidateCount: var int32,
                                    typedContractCount: var int32,
                                    structuredConsumeCount: var int32,
                                    nodeProbeHitCount: var int32,
                                    typeMismatchCount: var int32,
                                    legacyTextConsumeCount: var int32,
                                    nodeEvalGapCount: var int32) =
    candidateCount = candidateCount + 1
    if typedContract:
        typedContractCount = typedContractCount + 1
    if outcome == PrimaryBodyIrSeqAddOutcomeStructuredConsumed:
        if !typedContract || !nodeProbeHit || typeMismatch:
            panic("backend2_seq_add_structured_outcome_contract_mismatch")
        structuredConsumeCount = structuredConsumeCount + 1
    elif outcome == PrimaryBodyIrSeqAddOutcomeNotOwned:
        if typedContract || nodeProbeHit || typeMismatch:
            panic("backend2_seq_add_not_owned_outcome_contract_mismatch")
        if nodeEvalOnlyActive:
            nodeEvalGapCount = nodeEvalGapCount + 1
    elif outcome == PrimaryBodyIrSeqAddOutcomeHardFail:
        if (nodeProbeHit || typeMismatch) && !typedContract:
            panic("backend2_seq_add_hard_fail_outcome_contract_mismatch")
    else:
        panic("backend2_seq_add_unknown_outcome")
    if nodeProbeHit:
        nodeProbeHitCount = nodeProbeHitCount + 1
    if typeMismatch:
        typeMismatchCount = typeMismatchCount + 1

# 裸名全局 >=2 声明时 any-source 兜底诚实歧义返 -1 (T4B/T4D 案卷), 唯一赢面是
# SameSourceUnique 同文件优先; 本文件 4 处调用点须有字节级一致本地副本
# (与 backend2_lower_util:2013 / backend2_lower_slots:1245 同款, T4E 补齐)。
@borrows
fn PrimaryBodyIrTextIsStringLiteral(textRaw: str): bool =
    let text = strutil.Strip(share(textRaw))
    if len(text) < 2:
        return false
    if text[0] != '"':
        return false
    if text[len(text) - 1] != '"':
        return false
    return true

fn B2PrimaryBodyIrBeginPublishedDebugProvenance(
        bodyIR: var coreir.BodyIR,
        lowering: var lower.LoweringPlanStub,
        typedFunctionIndex: int32) =
    if !lowering.semanticDebugBound:
        return
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >=
           lowering.semanticDebugFunctionIdsByTypedFunctionIndex.len:
        let _ = coreir.BodyIRDebugProvenanceBegin(bodyIR, -1)
        return
    let _ = coreir.BodyIRDebugProvenanceBegin(
        bodyIR,
        lowering.semanticDebugFunctionIdsByTypedFunctionIndex[
            typedFunctionIndex])

@borrows
fn B2PrimaryBodyIrBindPublishedStatementDebugProvenance(
        bodyIR: var coreir.BodyIR,
        lowering: lower.LoweringPlanStub,
        stmt: lower.PrimaryObjectIrStatement) =
    if !bodyIR.debugProvenanceRequired:
        return
    var typedNodeIndex = stmt.rhsNodeIndex
    if typedNodeIndex < 0:
        typedNodeIndex = stmt.forStartNodeIndex
    if typedNodeIndex < 0:
        typedNodeIndex = stmt.assignIndexNodeIndex
    if typedNodeIndex < 0:
        let _ = coreir.BodyIRDebugProvenanceSetSynthetic(
            bodyIR, coreir.BodyDebugSyntheticControlFlow)
        return
    if typedNodeIndex >=
           lowering.semanticDebugOpIdsByTypedIrNodeIndex.len ||
       lowering.semanticDebugOpIdsByTypedIrNodeIndex[
           typedNodeIndex] < 0:
        coreir.BodyIRDebugProvenanceMarkIncomplete(bodyIR)
        return
    let _ = coreir.BodyIRDebugProvenanceSetExact(
        bodyIR,
        lowering.semanticDebugOpIdsByTypedIrNodeIndex[typedNodeIndex])

fn B2PrimaryBuildBodyIrFromTypedStatements(
    lowering: var lower.LoweringPlanStub,
    typedFnIndex: int32,
    irFunction: var lower.PrimaryObjectIrFunction,
    seqAddCandidateCountOut: var int32,
    seqAddTypedContractCountOut: var int32,
    structuredSeqAddConsumeCountOut: var int32,
    seqAddNodeProbeHitCountOut: var int32,
    seqAddTypeMismatchCountOut: var int32,
    seqAddLegacyTextConsumeCountOut: var int32,
    seqAddNodeEvalGapCountOut: var int32,
    structuredResultIntrinsicConsumeCountOut: var int32
): coreir.BodyIR =
    seqAddCandidateCountOut = 0
    seqAddTypedContractCountOut = 0
    structuredSeqAddConsumeCountOut = 0
    seqAddNodeProbeHitCountOut = 0
    seqAddTypeMismatchCountOut = 0
    seqAddLegacyTextConsumeCountOut = 0
    seqAddNodeEvalGapCountOut = 0
    structuredResultIntrinsicConsumeCountOut = 0
    let traceEnabled = B2PrimaryObjectPlanTraceActive()
    if traceEnabled:
        B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_from_typed_enter typed_index={typedFnIndex}")
    # combo C: 从 SoA/id 构造 typedFn (不再读 AoS functions[] 数组), 89 处用法不变
    var typedFn = texpr.TypedExprIrFunction(
        sourcePath: Value(langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_sourcePathIds[typedFnIndex])),
        functionName: Value(langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_functionNameIds[typedFnIndex])),
        returnType: Value(langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_returnTypeIds[typedFnIndex])),
        resultExprClass: lowering.typedIr.functions2_resultExprClasses[typedFnIndex],
        returnExpr: Value(langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_returnExprIds[typedFnIndex])),
        signatureLineNumber: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_signatureLineNumbers, typedFnIndex),
        endLineNumber: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_endLineNumbers, typedFnIndex),
        bodyLineNumber: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_bodyLineNumbers, typedFnIndex),
        statementStart: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_statementStarts, typedFnIndex),
        statementCount: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_statementCounts, typedFnIndex),
        nodeStart: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_nodeStarts, typedFnIndex),
        nodeCount: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_nodeCounts, typedFnIndex),
        returnNodeIndex: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_returnNodeIndexs, typedFnIndex),
        valueDefinitionStart: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_valueDefinitionStarts, typedFnIndex),
        valueDefinitionCount: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_valueDefinitionCounts, typedFnIndex),
    )
    if traceEnabled:
        B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_from_typed_after_typed_fn name={typedFn.functionName}")
    if os.GetEnv("CHENG_X64_DBG2") != "":
        os.WriteLine(os.GetStderr(), Fmt"x64dbg2 enter fn={typedFn.functionName} stmts={irFunction.statements.len} return_expr={typedFn.returnExpr} return_type={typedFn.returnType} body_line={typedFn.bodyLineNumber} ir_body_kind={irFunction.bodyKind}")
    # typed_expr 层把 LocalDecl 分组提前，带副作用初始化器的语句会越过
    # 先行语句（let raw = c_malloc(total) 先于 cheng_runtime_lock() 物化）。
    # 按源行号稳定排序恢复源序；同行/合成语句（line<=0）维持相对顺序。
    var stmtSortI = 1
    while stmtSortI < irFunction.statements.len:
        let stmtSortPick = irFunction.statements[stmtSortI]
        if stmtSortPick.lineNumber > 0:
            var stmtSortJ = stmtSortI - 1
            # 同行语句：控制流头（if/elif/else/ifcall/match/case/for/while）
            # 必须排在其体（return/assign/localdecl/...）之前。typed_expr 层
            # 把 match 臂重排为体先于头，稳定排序按行恢复后仍保留该逆序，
            # 导致 `A => return 1` 的 return 先于 `if k == A` 无条件执行。
            # 用头/体二级键破除同行逆序。
            let pickLine = stmtSortPick.lineNumber
            let pickPri = PrimaryBodyIrStmtHeaderSortPriority(stmtSortPick.kind)
            while stmtSortJ >= 0 &&
                  (irFunction.statements[stmtSortJ].lineNumber > pickLine ||
                   (irFunction.statements[stmtSortJ].lineNumber == pickLine &&
                    PrimaryBodyIrStmtHeaderSortPriority(irFunction.statements[stmtSortJ].kind) > pickPri)):
                irFunction.statements[stmtSortJ + 1] = irFunction.statements[stmtSortJ]
                stmtSortJ = stmtSortJ - 1
            irFunction.statements[stmtSortJ + 1] = stmtSortPick
        stmtSortI = stmtSortI + 1
    var stmtEnd = irFunction.statements.len
    if traceEnabled:
        B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_from_typed_after_stmt_end count={stmtEnd}")
    var bodyIR = coreir.BodyIRNew()
    if !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, lowering.typeArenaArtifactCid):
        panic("backend2 body ir: canonical TypeArena artifact CID missing")
    coreir.BodyIRBindLocalBindingValueDefinitionDomain(
        bodyIR,
        typedFn.valueDefinitionStart,
        typedFn.valueDefinitionCount)
    var localBindingProjection =
        coreir.BodyIRLocalBindingValueDefinitionProjectionNew(bodyIR)
    lower.LoweringBodyIrControlBegin(
        bodyIR, irFunction.deferScopeTransport, typedFnIndex)
    B2PrimaryBodyIrBeginPublishedDebugProvenance(
        bodyIR, lowering, typedFnIndex)
    if traceEnabled:
        B2PrimaryObjectPlanTrace("primary_body_ir_from_typed_after_body_new")
    var slotNames: str[]
    slotNames = []
    var callOrdinal: int32
    var nextOpIndex: int32
    var currentBlockStart: int32
    var pendingFalseTerm: int32
    var pendingIfFalseBodyEnd: int32
    var skipStatementUntilIndex: int32
    var completedReturnLineNumber: int32
    var pendingWhileHeaderBlock: int32
    var pendingWhileCbrTerm: int32
    var pendingWhileFalseTerms: int32[]
    var loopKindStk: int32[]
    var loopEndStk: int32[]
    var loopAStk: int32[]
    var loopBStk: int32[]
    var loopCStk: int32[]
    var loopFalseStartStk: int32[]
    var loopFalsePool: int32[]
    var loopBreakStartStk: int32[]
    var loopContinueStartStk: int32[]
    var loopSeqStk: int32[]
    var ifEndStk: int32[]
    var ifSeqStk: int32[]
    var ifIndentStk: int32[]
    var ifFalseStartStk: int32[]
    var ifFalsePool: int32[]
    var ifJoinStartStk: int32[]
    var ifJoinBrPool: int32[]
    var constructSeq: int32
    var pendingCompoundFalseTerms: int32[]
    var pendingLoopBreakTerms: int32[]
    var pendingLoopContinueTerms: int32[]
    var initializedLocalDeclLines: int32[]
    var initializedLocalDeclNames: str[]
    pendingFalseTerm = -1
    pendingIfFalseBodyEnd = -1
    pendingCompoundFalseTerms = []
    pendingLoopBreakTerms = []
    pendingLoopContinueTerms = []
    skipStatementUntilIndex = -1
    completedReturnLineNumber = -1
    pendingWhileHeaderBlock = -1
    pendingWhileCbrTerm = -1
    pendingWhileFalseTerms = []
    initializedLocalDeclLines = []
    initializedLocalDeclNames = []
    if traceEnabled:
        B2PrimaryObjectPlanTrace("primary_body_ir_from_typed_before_seed_params")
    PrimaryBodyIrSeedParamSlots(
        bodyIR,
        localBindingProjection,
        slotNames,
        lowering.typedIr,
        typedFn,
        irFunction)
    if traceEnabled:
        B2PrimaryObjectPlanTrace("primary_body_ir_from_typed_after_seed_params")
    var varI32ParamNames = PrimaryBodyIrCollectVarI32ParamNamesFromIrFunction(irFunction)
    if traceEnabled:
        B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_from_typed_after_var_i32 count={varI32ParamNames.len}")
    var callFeederEmittedIndexes: int32[]
    var sameLineOrder: int32[]
    var sameLineLo: int32[]
    var sameLineHi: int32[]
    PrimaryBodyIrBuildSameLineIndex(irFunction, sameLineOrder, sameLineLo, sameLineHi)
    for stmtIndex in 0..<stmtEnd:
        if bodyIR.debugProvenanceRequired:
            let _ = coreir.BodyIRDebugProvenanceSetSynthetic(
                bodyIR, coreir.BodyDebugSyntheticControlFlow)
        if traceEnabled:
            B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_stmt_index={stmtIndex} stmt_end={stmtEnd}")
        while true:
            var loopDue = false
            if loopKindStk.len > 0 && stmtIndex >= loopEndStk[loopKindStk.len - 1]:
                loopDue = true
            var ifDue = false
            if ifEndStk.len > 0 && stmtIndex >= ifEndStk[ifEndStk.len - 1]:
                ifDue = true
                let dueKind = irFunction.statements[stmtIndex].kind
                if (dueKind == texpr.TypedExprIrStmtElif || dueKind == texpr.TypedExprIrStmtElse) &&
                   irFunction.statements[stmtIndex].lineIndent == ifIndentStk[ifEndStk.len - 1]:
                    ifDue = false
            if !loopDue && !ifDue:
                break
            var closeIfTop = ifDue
            if loopDue && ifDue && loopSeqStk[loopKindStk.len - 1] > ifSeqStk[ifEndStk.len - 1]:
                closeIfTop = false
            if closeIfTop:
                PrimaryBodyIrCloseIfTop(bodyIR,
                                        currentBlockStart,
                                        ifEndStk,
                                        ifSeqStk,
                                        ifIndentStk,
                                        ifFalseStartStk,
                                        ifFalsePool,
                                        ifJoinStartStk,
                                        ifJoinBrPool)
                # CloseIfTop has bound the just-closed if's false edge(s) to its
                # join block. The if-without-else continuation patch below
                # (pendingFalseTerm / line ~25746) must NOT re-target an
                # already-bound false edge — doing so re-points an if-with-break
                # body's false edge from the loop latch to the loop EXIT, losing
                # an iteration. Clear the now-stale pending-if state once the
                # term it tracks has been bound, mirroring the for-loop reset.
                if pendingFalseTerm >= 0 &&
                   pendingFalseTerm < bodyIR.terms.len &&
                   bodyIR.terms[pendingFalseTerm].falseBlock >= 0:
                    pendingFalseTerm = -1
                    pendingCompoundFalseTerms = []
                    pendingIfFalseBodyEnd = -1
            else:
                let closedLoopKind = PrimaryBodyIrCloseLoopTop(bodyIR,
                                                           slotNames,
                                                           nextOpIndex,
                                                           currentBlockStart,
                                                           loopKindStk,
                                                           loopEndStk,
                                                           loopAStk,
                                                           loopBStk,
                                                           loopCStk,
                                                           loopFalseStartStk,
                                                           loopFalsePool,
                                                           loopBreakStartStk,
                                                           pendingLoopBreakTerms,
                                                           loopContinueStartStk,
                                                           pendingLoopContinueTerms)
                if closedLoopKind == 1:
                    pendingFalseTerm = -1
                    pendingCompoundFalseTerms = []
        if stmtIndex <= skipStatementUntilIndex:
            continue
        var stmt = irFunction.statements[stmtIndex]
        B2PrimaryBodyIrBindPublishedStatementDebugProvenance(
            bodyIR, lowering, stmt)
        if os.GetEnv("CHENG_X64_DBG2") != "":
            os.WriteLine(os.GetStderr(), Fmt"x64dbg2 fn={typedFn.functionName} idx={stmtIndex} kind={int32(stmt.kind)} indent={stmt.lineIndent} line={stmt.lineNumber} binding={stmt.bindingName} target={stmt.callTarget} surface={stmt.surfaceText}")
        if traceEnabled:
            B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_stmt_loaded index={stmtIndex} line={stmt.lineNumber} kind={int32(stmt.kind)}")
        # if-without-else: the first statement past the then-body starts the
        # continuation block. Patch the pending CBR false edge(s) to it here;
        # elif/else statements keep their dedicated handlers below. Without
        # this, the false edge stayed -1 and the late term-index fallback
        # collapsed it into the then-block (if-with-return always took then).
        if pendingFalseTerm >= 0 && pendingIfFalseBodyEnd >= 0 &&
           stmtIndex >= pendingIfFalseBodyEnd &&
           stmt.kind != texpr.TypedExprIrStmtIfCall &&
           stmt.kind != texpr.TypedExprIrStmtElif &&
           stmt.kind != texpr.TypedExprIrStmtElse:
            if bodyIR.ops.len > currentBlockStart:
                # then-body left its block open: terminate it with a branch
                # to the continuation so the false edge can skip the then ops.
                var ifJoinBr: coreir.BodyTerm
                ifJoinBr.kind = coreir.BodyTermBrTag
                ifJoinBr.trueBlock = bodyIR.blocks.len + 1
                ifJoinBr.falseBlock = -1
                ifJoinBr.conditionKind = coreir.BodyCondInvalidTag
                ifJoinBr.lhsSlot = -1
                ifJoinBr.rhsSlot = -1
                ifJoinBr.resultSlot = -1
                let ifJoinBrIdx = coreir.BodyIRAppendTerm(bodyIR, ifJoinBr)
                let ifJoinOpCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, ifJoinOpCount, ifJoinBrIdx)
                currentBlockStart = bodyIR.ops.len
            bodyIR.terms[pendingFalseTerm].falseBlock = bodyIR.blocks.len
            for pcti in 0..<pendingCompoundFalseTerms.len:
                if pendingCompoundFalseTerms[pcti] >= 0 &&
                   pendingCompoundFalseTerms[pcti] < bodyIR.terms.len:
                    bodyIR.terms[pendingCompoundFalseTerms[pcti]].falseBlock = bodyIR.blocks.len
            pendingCompoundFalseTerms = []
            pendingFalseTerm = -1
            pendingIfFalseBodyEnd = -1
        if B2PrimaryObjectPlanTraceActive() || B2PrimaryObjectPlanProgressEnabled() || traceEnabled:
            # Fmt 插值内调用对 exe 可达扫描不可见 (改名前靠 pobj 同名副本侥幸解析);
            # hoist 成直接调用让函数进 typed 表, 消 missing_call_target。
            let stmtKindCodeText = B2PrimaryObjectStatementKindCodeText(int32(stmt.kind))
            if B2PrimaryObjectPlanTraceActive():
                B2PrimaryObjectPlanTrace(Fmt"phase=statement function={typedFn.functionName} stmt_index={stmtIndex} line={stmt.lineNumber} kind={stmtKindCodeText} binding={stmt.bindingName} surface={stmt.surfaceText}")
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"statement_begin function={typedFn.functionName} stmt_index={stmtIndex} line={stmt.lineNumber} kind={stmtKindCodeText} surface={stmt.surfaceText}")
        if stmt.kind == texpr.TypedExprIrStmtUnsupported:
            # Comment-only lines (`// ...`) reach body-IR as Unsupported statements
            # that emit no IR; skip them as no-ops (mirrors break/continue skip).
            let commentTrimmed = strutil.Strip(stmt.surfaceText)
            if len(commentTrimmed) >= 2 &&
               commentTrimmed[0] == '/' &&
               commentTrimmed[1] == '/':
                continue
            # `block <label>:` is a pure label declaration: the marker line
            # emits no IR itself (its only IR effect lives in `break <label>`
            # statements, lowered via the loop-body break path). Treat the
            # marker as a no-op scope boundary so the wrapped body lowers.
            if len(commentTrimmed) > 7 &&
               commentTrimmed[0] == 'b' &&
               commentTrimmed[1] == 'l' &&
               commentTrimmed[2] == 'o' &&
               commentTrimmed[3] == 'c' &&
               commentTrimmed[4] == 'k' &&
               commentTrimmed[5] == ' ' &&
               commentTrimmed[len(commentTrimmed) - 1] == ':':
                continue
            if traceEnabled:
                B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_unsupported_enter stmt_index={stmtIndex} surface_len={stmt.surfaceText.len}")
            if stmt.surfaceText == "break":
                if traceEnabled:
                    B2PrimaryObjectPlanTrace("primary_body_ir_unsupported_break")
                var breakTerm: coreir.BodyTerm
                breakTerm.kind = coreir.BodyTermBrTag
                breakTerm.trueBlock = -1
                breakTerm.falseBlock = -1
                breakTerm.conditionKind = coreir.BodyCondInvalidTag
                breakTerm.lhsSlot = -1
                breakTerm.rhsSlot = -1
                breakTerm.resultSlot = -1
                let breakTermIndex = coreir.BodyIRAppendTerm(bodyIR, breakTerm)
                let breakBlockOpCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, breakBlockOpCount, breakTermIndex)
                currentBlockStart = bodyIR.ops.len
                add(pendingLoopBreakTerms, breakTermIndex)
            elif stmt.surfaceText == "continue":
                if traceEnabled:
                    B2PrimaryObjectPlanTrace("primary_body_ir_unsupported_continue")
                var continueTerm: coreir.BodyTerm
                continueTerm.kind = coreir.BodyTermBrTag
                continueTerm.trueBlock = -1
                continueTerm.falseBlock = -1
                continueTerm.conditionKind = coreir.BodyCondInvalidTag
                continueTerm.lhsSlot = -1
                continueTerm.rhsSlot = -1
                continueTerm.resultSlot = -1
                let continueTermIndex = coreir.BodyIRAppendTerm(bodyIR, continueTerm)
                let continueBlockOpCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, continueBlockOpCount, continueTermIndex)
                currentBlockStart = bodyIR.ops.len
                add(pendingLoopContinueTerms, continueTermIndex)
            elif stmt.surfaceText == "cmdline.CaptureCmdLine(argc, argv)":
                # The runtime entry bridge already captures argc/argv before invoking main.
                continue
            else:
                if traceEnabled:
                    B2PrimaryObjectPlanTrace("primary_body_ir_unsupported_general")
                let unsupportedConsumedByAssignTarget = PrimaryBodyIrHasSameLineAssignForCallTarget(irFunction.statements,
                                                                                                     stmt.lineNumber,
                                                                                                     stmt.callTarget,
                                                                                                     stmt.callArgsText)
                let unsupportedConsumedByAssignExpr = PrimaryBodyIrHasSameLineAssignForCallExpr(irFunction.statements,
                                                                                                 stmt.lineNumber,
                                                                                                 stmt.surfaceText)
                if unsupportedConsumedByAssignTarget:
                    continue
                if unsupportedConsumedByAssignExpr:
                    continue
                let unsupportedWholeCallAppended = PrimaryBodyIrAppendWholeCallStatement(bodyIR,
                                                                                        slotNames,
                                                                                        lowering,
                                                                                        typedFn,
                                                                                        irFunction,
                                                                                        varI32ParamNames,
                                                                                        stmt.surfaceText,
                                                                                        stmt.lineNumber,
                                                                                        stmt.rhsNodeIndex,
                                                                                        callOrdinal)
                if unsupportedWholeCallAppended:
                    nextOpIndex = nextOpIndex + 1
                    continue
                if PrimaryBodyIrAppendUnsupportedEchoFmtCall(bodyIR,
                                                             slotNames,
                                                             stmt.surfaceText,
                                                             stmt.lineNumber,
                                                             callOrdinal):
                    nextOpIndex = nextOpIndex + 1
                    continue
                var unsupportedWholeCallProbeCode: int32
                let unsupportedSurfaceHasCall = PrimaryBodyIrTextHasCallSurface(stmt.surfaceText)
                if unsupportedSurfaceHasCall:
                    unsupportedWholeCallProbeCode = PrimaryBodyIrWholeCallStatementProbeCode(lowering,
                                                                                            typedFn,
                                                                                            irFunction,
                                                                                            stmt.surfaceText)
                let unsupportedEqPos = texpr.TypedExprFindTopLevelTextToken(stmt.surfaceText, "=")
                if traceEnabled:
                    B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_unsupported_after_eq_pos pos={unsupportedEqPos}")
                if unsupportedEqPos > 0:
                    let unsupportedLhsRaw = strutil.Strip(strings.SliceBytes(stmt.surfaceText,
                                                                             0,
                                                                             unsupportedEqPos))
                    let unsupportedLhs = PrimaryBodyIrCanonicalAssignLhsName(unsupportedLhsRaw)
                    let unsupportedRhs = strutil.Strip(strings.SliceBytes(stmt.surfaceText,
                                                                          unsupportedEqPos + 1,
                                                                          len(stmt.surfaceText) - unsupportedEqPos - 1))
                    if traceEnabled:
                        B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_unsupported_assign lhs={unsupportedLhs} rhs_len={unsupportedRhs.len}")
                    if PrimaryBodyIrUInt64PtrDerefPointerText(unsupportedLhs) != "":
                        if PrimaryBodyIrAppendUInt64PtrDerefStore(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  stmt.sourcePath,
                                                                  unsupportedLhs,
                                                                  unsupportedRhs,
                                                                  callOrdinal):
                            nextOpIndex = nextOpIndex + 1
                            continue
                    if len(unsupportedLhs) > 1 && unsupportedLhs[0] == '*':
                        var unsupportedDerefInner = strutil.Strip(strings.SliceBytes(unsupportedLhs, 1, len(unsupportedLhs) - 1))
                        unsupportedDerefInner = PrimaryBodyIrStripOuterParens(unsupportedDerefInner)
                        let unsupportedDerefPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                                     slotNames,
                                                                                     varI32ParamNames,
                                                                                     lowering.typedIr,
                                                                                     stmt.sourcePath,
                                                                                     unsupportedDerefInner,
                                                                                     callOrdinal)
                        if unsupportedDerefPtrSlot >= 0:
                            var unsupportedDerefValueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, unsupportedRhs)
                            if unsupportedDerefValueSlot < 0:
                                unsupportedDerefValueSlot = PrimaryBodyIrU64ValueSlotForText(bodyIR,
                                                                                             slotNames,
                                                                                             varI32ParamNames,
                                                                                             lowering.typedIr,
                                                                                             stmt.sourcePath,
                                                                                             unsupportedRhs,
                                                                                             callOrdinal)
                            if unsupportedDerefValueSlot >= 0 &&
                               PrimaryBodyIrSlotType(bodyIR, unsupportedDerefValueSlot) != coreir.LocalI32Tag:
                                var unsupportedDerefStoreOp: coreir.BodyOp
                                unsupportedDerefStoreOp.kind = coreir.BodyOpIndexedStoreTag
                                unsupportedDerefStoreOp.target = unsupportedDerefPtrSlot
                                add(unsupportedDerefStoreOp.operands, unsupportedDerefPtrSlot)
                                add(unsupportedDerefStoreOp.operands, unsupportedDerefValueSlot)
                                let _ = coreir.BodyIRAppendOp(bodyIR, unsupportedDerefStoreOp)
                                nextOpIndex = nextOpIndex + 1
                                continue
                    var unsupportedLhsType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                            typedFn,
                                                                            irFunction,
                                                                            stmt.lineNumber,
                                                                            unsupportedLhs)
                    if traceEnabled:
                        B2PrimaryObjectPlanTrace(Fmt"primary_body_ir_unsupported_after_lhs_type len={unsupportedLhsType.len}")
                    var unsupportedRhsIsStringValue: bool
                    if PrimaryBodyIrTextIsStringLiteral(unsupportedRhs):
                        unsupportedRhsIsStringValue = true
                    elif PrimaryBodyIrFmtLiteralPayload(unsupportedRhs) != "":
                        unsupportedRhsIsStringValue = true
                    if unsupportedLhsType == "" &&
                       unsupportedRhsIsStringValue:
                        unsupportedLhsType = "str"
                    var unsupportedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                            slotNames,
                                                                            lowering.typedIr,
                                                                            stmt.sourcePath,
                                                                            unsupportedLhs,
                                                                            unsupportedLhsType)
                    var unsupportedFieldAssigned = false
                    if texpr.TypedExprTextIsSimpleFieldPath(unsupportedRhs):
                        var unsupportedFieldFailure0: int32
                        var unsupportedFieldFailure1: int32
                        let unsupportedFieldSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                                                       slotNames,
                                                                                       lowering.typedIr,
                                                                                       typedFn,
                                                                                       irFunction,
                                                                                       stmt.sourcePath,
                                                                                       stmt.lineNumber,
                                                                                       unsupportedRhs,
                                                                                       unsupportedFieldFailure0,
                                                                                       unsupportedFieldFailure1)
                        if unsupportedFieldSlot >= 0 &&
                           unsupportedFieldSlot < bodyIR.localSlots.len:
                            let unsupportedFieldTypeKind = PrimaryBodyIrSlotType(bodyIR, unsupportedFieldSlot)
                            let unsupportedFieldSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[unsupportedFieldSlot])
                            let unsupportedFieldAlign = bodyIR.localSlots[unsupportedFieldSlot].alignBytes
                            if unsupportedSlot < 0 ||
                               unsupportedSlot >= bodyIR.localSlots.len ||
                               PrimaryBodyIrSlotType(bodyIR, unsupportedSlot) != unsupportedFieldTypeKind ||
                               PrimaryLocalSlotSizeOf(bodyIR.localSlots[unsupportedSlot]) < unsupportedFieldSize:
                                unsupportedSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                                    slotNames,
                                                                                    unsupportedLhs,
                                                                                    unsupportedFieldTypeKind,
                                                                                    unsupportedFieldSize,
                                                                                    unsupportedFieldAlign)
                            if unsupportedSlot >= 0 &&
                               unsupportedSlot < bodyIR.localSlots.len &&
                               PrimaryBodyIrSlotType(bodyIR, unsupportedSlot) == unsupportedFieldTypeKind &&
                               PrimaryLocalSlotSizeOf(bodyIR.localSlots[unsupportedSlot]) >= unsupportedFieldSize:
                                if unsupportedSlot != unsupportedFieldSlot:
                                    var unsupportedFieldCopyOp: coreir.BodyOp
                                    unsupportedFieldCopyOp.kind = coreir.BodyOpCopyLocalTag
                                    unsupportedFieldCopyOp.target = unsupportedSlot
                                    add(unsupportedFieldCopyOp.operands, unsupportedFieldSlot)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, unsupportedFieldCopyOp)
                                unsupportedFieldAssigned = true
                    if unsupportedFieldAssigned:
                        nextOpIndex = nextOpIndex + 1
                        continue
                    var unsupportedStringAssigned = false
                    if unsupportedSlot >= 0 &&
                       PrimaryBodyIrSlotType(bodyIR, unsupportedSlot) == coreir.LocalStrTag:
                        if PrimaryBodyIrTextIsStringLiteral(unsupportedRhs):
                            unsupportedStringAssigned = PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                                                              slotNames,
                                                                                              unsupportedRhs,
                                                                                              unsupportedSlot,
                                                                                              callOrdinal)
                    if unsupportedStringAssigned:
                        nextOpIndex = nextOpIndex + 1
                        continue
                    if unsupportedSlot >= 0 &&
                       unsupportedSlot < bodyIR.localSlots.len &&
                       PrimaryBodyIrSlotType(bodyIR, unsupportedSlot) == coreir.LocalF64Tag &&
                       texpr.TypedExprFindTopLevelTextToken(unsupportedRhs, "?") > 0:
                        var unsupportedF64TernBlockStart = currentBlockStart
                        if PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering,
                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.sourcePath,
                                                                      stmt.lineNumber,
                                                                      stmt.rhsNodeIndex,
                                                                      unsupportedRhs,
                                                                      unsupportedSlot,
                                                                      coreir.LocalF64Tag,
                                                                      callOrdinal,
                                                                      unsupportedF64TernBlockStart):
                            currentBlockStart = unsupportedF64TernBlockStart
                            nextOpIndex = nextOpIndex + 1
                            continue
                let unsupportedBareIdent = strutil.Strip(stmt.surfaceText)
                let unsupportedBareIsIdent = unsupportedBareIdent != "" &&
                                             parser.ParserIdentPrefix(unsupportedBareIdent) == unsupportedBareIdent
                let unsupportedBareIsFieldPath = texpr.TypedExprTextIsSimpleFieldPath(unsupportedBareIdent)
                if !unsupportedSurfaceHasCall &&
                   unsupportedEqPos <= 0 &&
                   (unsupportedBareIsIdent || unsupportedBareIsFieldPath):
                    # Bare identifier / simple member-path expression statement
                    # (parameter/local discard, "touch unused" idiom) evaluates a
                    # known binding with no effect: own the node-eval gap and skip.
                    let unsupportedBareRoot = parser.ParserIdentPrefix(unsupportedBareIdent)
                    if PrimaryBodyIrFindArgSlot(bodyIR, slotNames, unsupportedBareRoot) >= 0 ||
                       PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       stmt.lineNumber,
                                                       unsupportedBareRoot) != "":
                        continue
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             64,
                                             unsupportedWholeCallProbeCode)
                nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtLocalDecl:
            var localDeclType = stmt.resultType
            let localDeclRhs = strutil.Strip(stmt.surfaceText)
            let localDeclOpenPos = texpr.TypedExprFindWholeCallOpenParen(localDeclRhs)
            if localDeclOpenPos > 0:
                let localDeclClosePos = texpr.TypedExprFindMatchingParen(localDeclRhs,
                                                                         localDeclOpenPos)
                if localDeclClosePos > localDeclOpenPos &&
                   localDeclClosePos + 1 == len(localDeclRhs):
                    if stmt.rhsNodeIndex < 0 ||
                       stmt.rhsNodeIndex >=
                           lowering.typedIr.nodes2_nodeIndexs.len ||
                       lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] !=
                           texpr.TypedExprIrOpCallExpr:
                        panic(Fmt"backend2: local declaration whole call lacks canonical CallExpr row statement={stmt.statementIndex}")
                    let localDeclCallType =
                        PrimaryBodyIrNodeResultTypeText(
                            lowering.typedIr, stmt.rhsNodeIndex)
                    if localDeclCallType == "":
                        panic(Fmt"backend2: local declaration CallExpr result type missing node={stmt.rhsNodeIndex}")
                    # 裸泛型类型参数（单大写字母，如 `Value[T](r): T` 的 T）不是
                    # 具体类型：用它覆盖已解析具体标量 localDeclType（int32）会把槽
                    # 误建成 ptr（首字母大写→PtrTag），与标量投影宽度不符而 miscompile。
                    var localDeclCallTypeIsBareGeneric: bool
                    if len(localDeclCallType) == 1 &&
                       localDeclCallType[0] >= 'A' &&
                       localDeclCallType[0] <= 'Z':
                        localDeclCallTypeIsBareGeneric = true
                    if localDeclCallType != "" &&
                       localDeclCallType != "unknown" &&
                       localDeclCallType != "void" &&
                       !localDeclCallTypeIsBareGeneric &&
                       B2PrimaryObjectMetadataTextStable(localDeclCallType):
                        localDeclType = localDeclCallType
            var shouldInferLocalDeclCallType: bool
            if PrimaryBodyIrTextHasCallSurface(localDeclRhs):
                if localDeclType == "":
                    shouldInferLocalDeclCallType = true
                elif localDeclType == "unknown":
                    shouldInferLocalDeclCallType = true
            if shouldInferLocalDeclCallType:
                var localDeclBinPos: int32 = -1
                var localDeclBinOpLen: int32
                localDeclBinOpLen = 1
                let localDeclAddPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, "+")
                let localDeclSubPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, "-")
                let localDeclMulPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, "*")
                let localDeclDivPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, "/")
                let localDeclShrPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, ">>")
                if localDeclAddPos > 0:
                    localDeclBinPos = localDeclAddPos
                elif localDeclSubPos > 0:
                    localDeclBinPos = localDeclSubPos
                elif localDeclMulPos > 0:
                    localDeclBinPos = localDeclMulPos
                elif localDeclDivPos > 0:
                    localDeclBinPos = localDeclDivPos
                elif localDeclShrPos > 0:
                    localDeclBinPos = localDeclShrPos
                    localDeclBinOpLen = 2
                if localDeclBinPos > 0 && localDeclBinPos + localDeclBinOpLen < len(localDeclRhs):
                    let localDeclLhsText = strutil.Strip(strings.SliceBytes(localDeclRhs,
                                                                            0,
                                                                            localDeclBinPos))
                    let localDeclRhsText = strutil.Strip(strings.SliceBytes(localDeclRhs,
                                                                            localDeclBinPos + localDeclBinOpLen,
                                                                            len(localDeclRhs) - localDeclBinPos - localDeclBinOpLen))
                    var localDeclCallOperandType = ""
                    var localDeclLhsNodeIndex: int32 = -1
                    var localDeclRhsNodeIndex: int32 = -1
                    if stmt.rhsNodeIndex >= 0 &&
                       stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                        localDeclLhsNodeIndex = arenamod.ArenaArrayInt32Get(
                            lowering.typedIr.arena,
                            lowering.typedIr.nodes2_operand0NodeIndexs,
                            stmt.rhsNodeIndex)
                        localDeclRhsNodeIndex = arenamod.ArenaArrayInt32Get(
                            lowering.typedIr.arena,
                            lowering.typedIr.nodes2_operand1NodeIndexs,
                            stmt.rhsNodeIndex)
                    if PrimaryBodyIrTextHasCallSurface(localDeclLhsText):
                        if localDeclLhsNodeIndex < 0 ||
                           localDeclLhsNodeIndex >=
                               lowering.typedIr.nodes2_nodeIndexs.len ||
                           lowering.typedIr.nodes2_opKinds[
                               localDeclLhsNodeIndex] !=
                               texpr.TypedExprIrOpCallExpr:
                            panic(Fmt"backend2: local declaration lhs call lacks canonical CallExpr row statement={stmt.statementIndex}")
                        localDeclCallOperandType =
                            PrimaryBodyIrNodeResultTypeText(
                                lowering.typedIr, localDeclLhsNodeIndex)
                    elif PrimaryBodyIrTextHasCallSurface(localDeclRhsText):
                        if localDeclRhsNodeIndex < 0 ||
                           localDeclRhsNodeIndex >=
                               lowering.typedIr.nodes2_nodeIndexs.len ||
                           lowering.typedIr.nodes2_opKinds[
                               localDeclRhsNodeIndex] !=
                               texpr.TypedExprIrOpCallExpr:
                            panic(Fmt"backend2: local declaration rhs call lacks canonical CallExpr row statement={stmt.statementIndex}")
                        localDeclCallOperandType =
                            PrimaryBodyIrNodeResultTypeText(
                                lowering.typedIr, localDeclRhsNodeIndex)
                    if localDeclCallOperandType == "int32" ||
                       localDeclCallOperandType == "uint32" ||
                       localDeclCallOperandType == "bool":
                        localDeclType = "int32"
                    elif localDeclCallOperandType == "int64" ||
                         localDeclCallOperandType == "uint64":
                        localDeclType = "int64"
            # Deref let twin (let x = [int32(]*(UInt8Ptr(call(...)))[)]) must type
            # the binding slot by its scalar declared type, never by the
            # pointer-producing call.
            var localDeclDerefExpr = share(localDeclRhs)
            var localDeclDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(localDeclDerefExpr, "int32")
            if localDeclDerefCastInner == "":
                localDeclDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(localDeclDerefExpr, "uint8")
            if localDeclDerefCastInner != "":
                localDeclDerefExpr = strutil.Strip(localDeclDerefCastInner)
            if PrimaryBodyIrUInt8PtrDerefPointerText(localDeclDerefExpr) != "" ||
               PrimaryBodyIrI32PtrDerefPointerText(localDeclDerefExpr) != "":
                # 裸 `*name` 宽形（无外层 int32/uint8 cast + 非 `*(` 包裹 + 声明形为
                # ptr/i64 8字节机器字）保留声明类型让 i64 槽承接 8 字节 deref；此前无
                # 条件强改 int32 → 4字节 `ldr w`，64 位指针/整数被截成 32 位（与 return
                # 位同族的隐性截断）。cast 形（`*(UInt8Ptr/Int32Ptr(...))`）与 i32-pointee
                # 裸形仍归一 int32。
                var localDeclDerefWide = false
                if localDeclDerefCastInner == "" &&
                   len(localDeclDerefExpr) > 1 &&
                   localDeclDerefExpr[1] != '(' &&
                   PrimaryBodyIrI32PtrDerefPointerText(localDeclDerefExpr) != "":
                    # ① 标注形 `let b: int64 = *slot`：声明型即宽。
                    var localDeclDerefWideKind: int32
                    var localDeclDerefWideSize: int32
                    var localDeclDerefWideAlign: int32
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   stmt.sourcePath,
                                                   localDeclType,
                                                   localDeclDerefWideKind,
                                                   localDeclDerefWideSize,
                                                   localDeclDerefWideAlign)
                    if localDeclDerefWideKind == coreir.LocalPtrTag ||
                       localDeclDerefWideKind == coreir.LocalI64Tag:
                        localDeclDerefWide = true
                    # ② 隐式 `let b = *slot`：前端常把绑定推成 i32，声明型不可信。
                    # 权威序: 已物化指针槽 aux pointee → BindingType 文本 pointee。
                    if !localDeclDerefWide:
                        let barePtrName = PrimaryBodyIrI32PtrDerefPointerText(localDeclDerefExpr)
                        let barePtrSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, barePtrName)
                        if barePtrSlot >= 0 && barePtrSlot < bodyIR.localSlots.len:
                            let barePtrPointeeKind = PrimaryBodyIrVarParamPointeeKind(bodyIR,
                                                                                     barePtrSlot)
                            if barePtrPointeeKind == coreir.LocalI64Tag ||
                               barePtrPointeeKind == coreir.LocalPtrTag:
                                localDeclType = "int64"
                                localDeclDerefWide = true
                        if !localDeclDerefWide:
                            var barePtrType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                              typedFn,
                                                                              irFunction,
                                                                              stmt.lineNumber,
                                                                              barePtrName)
                            if barePtrType == "":
                                barePtrType = texpr.TypedExprIrLookupLocalBindingTypeAnyLine(lowering.typedIr,
                                                                                             typedFn.sourcePath,
                                                                                             typedFn.functionName,
                                                                                             barePtrName)
                            let barePointee = PrimaryBodyIrPointeeTypeTextForSource(lowering.typedIr,
                                                                                   stmt.sourcePath,
                                                                                   barePtrType)
                            if barePointee != "":
                                var barePointeeKind: int32
                                var barePointeeSize: int32
                                var barePointeeAlign: int32
                                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                               stmt.sourcePath,
                                                               barePointee,
                                                               barePointeeKind,
                                                               barePointeeSize,
                                                               barePointeeAlign)
                                if barePointeeKind == coreir.LocalPtrTag ||
                                   barePointeeKind == coreir.LocalI64Tag:
                                    localDeclType = barePointee
                                    localDeclDerefWide = true
                if !localDeclDerefWide &&
                   PrimaryBodyIrTypeKindFromText(localDeclType) != coreir.LocalI32Tag:
                    localDeclType = "int32"
            # `var x = ir.functions[i].callTargets[0]`（纯 str 字段/索引深链 RHS）：
            # 前端类型推断会在中途停在 `ir.functions[i]`，把 x 的 resultType 误推成
            # 元素结构体类型 `PrimaryObjectIrFunction`（漏掉 `.callTargets[0]` 尾段）。
            # 这是稳定但错误的类型：下面 FindOrCreateTypedSlot 据此把 x 槽建成
            # Aggregate；str 值 node-eval 存储因槽形不符 store_shape miss，槽未初始化、
            # 行落 0 字 invalid op，后续 Fmt 拼接读 x 又拿到 Aggregate 片段 →
            # fmt_piece miss，整函数 wcz（G5 受害 sequenceText 等）。
            # RHS 节点求值探针逐级走真实字段/索引链，对纯路径（无调用面）是权威
            # 定型：探针返回 str 而声明类型不成 str 形时，以探针 str 纠正槽定型，
            # 根治前端深链推断漏尾。
            if !PrimaryBodyIrTextHasCallSurface(localDeclRhs) &&
               PrimaryBodyIrTextHasFieldOrIndex(localDeclRhs) &&
               stmt.rhsNodeIndex >= 0 &&
               stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               PrimaryBodyIrTypeKindFromText(localDeclType) != coreir.LocalStrTag:
                var localDeclDeclaredKind: int32
                var localDeclDeclaredSize: int32
                var localDeclDeclaredAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               localDeclType,
                                               localDeclDeclaredKind,
                                               localDeclDeclaredSize,
                                               localDeclDeclaredAlign)
                if localDeclDeclaredKind != coreir.LocalStrTag:
                    PrimaryBodyIrNodeEvalMissOpReset()
                    if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering.typedIr,
                                                  typedFn,
                                                  irFunction,
                                                  stmt.rhsNodeIndex) == coreir.LocalStrTag:
                        localDeclType = "str"
            # FIX 8: str-slice decl type detection. Front-end RhsIndexType types
            # any str[...] as char (single-byte index view); a range slice yields
            # str. char + slice syntax uniquely identifies a mis-typed str slice;
            # force str so the slot is sized 16B and the population block fires.
            if localDeclType == "char" &&
               PrimaryBodyIrTextIsStrSlice(localDeclRhs):
                localDeclType = "str"
            if os.GetEnv("CHENG_X64_DBG4") != "":
                os.WriteLine(os.GetStderr(), Fmt"x64dbg4 local_decl binding={stmt.bindingName} line={stmt.lineNumber} result_type=[{stmt.resultType}] decl_type=[{localDeclType}]")
            PrimaryBodyIrRetireIncompatibleAggregateRebind(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           stmt.sourcePath,
                                                           stmt.bindingName,
                                                           localDeclType)
            let localSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               stmt.sourcePath,
                                                               stmt.bindingName,
                                                               localDeclType)
            PrimaryBodyIrBindLocalSlotFromTypedProducerExact(
                bodyIR,
                localBindingProjection,
                lowering.typedIr,
                localSlot,
                stmt.rhsNodeIndex)
            if PrimaryBodyIrHasSameLineLetCallBinding(irFunction.statements,
                                                      stmt.lineNumber,
                                                      stmt.bindingName):
                continue
            if PrimaryBodyIrHasSameLineResultIntrinsicBinding(irFunction.statements,
                                                              stmt.lineNumber,
                                                              stmt.bindingName):
                continue
            # 批次2c：rhs 已节点化的本地声明先走节点求值器（绑定新槽），
            # 失败落回既有初始化路径（迁移窗口双轨）。
            var localInitialized = false
            # `let r = a && b` / `let r = a || b`: materializing a short-circuit
            if !localInitialized &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, localSlot) == coreir.LocalStrTag &&
               PrimaryBodyIrTextIsStrSlice(localDeclRhs):
                let declSliceTempSlot = PrimaryBodyIrLowerStrSliceToSlot(bodyIR, slotNames, varI32ParamNames, lowering.typedIr, typedFn, irFunction, stmt.sourcePath, stmt.lineNumber, localDeclRhs, stmt.bindingName, callOrdinal)
                if declSliceTempSlot >= 0:
                    if declSliceTempSlot != localSlot:
                        var declSliceCopyOp: coreir.BodyOp
                        declSliceCopyOp.kind = coreir.BodyOpCopyLocalTag
                        declSliceCopyOp.target = localSlot
                        add(declSliceCopyOp.operands, declSliceTempSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, declSliceCopyOp)
                    localInitialized = true

            # boolean into a local MUST preserve short-circuit semantics (the RHS
            # of `&&` skipped when the LHS is false, and vice-versa for `||`).
            # The eager node-eval / scalar paths below evaluate BOTH operands and
            # bitwise-combine them, running a side-effecting RHS even when it
            # should be skipped (the `false && bump(true)` miscompile). Route
            # bool-slot && / || initializers through the same CBR-chain assigner
            # the plain-assign path uses (AppendI32Assign:25095) before any eager
            # path can fire.
            # Only the call-bearing short-circuit decl must take the text CBR
            # assigner: when a `&&`/`||` operand contains a CallExpr the short-
            # circuit skip is observable (the eager bitwise node path would run
            # a side-effecting RHS even when LHS is false — lessons #37 dangling
            # reloc坑). Call-free `&&`/`||` are side-effect-equivalent to bitwise
            # AND/OR, so they fall through to the node-eval LogAnd path (24003,
            # itself guarded to miss on CallExpr operands).
            let declInitShortCircuitText = strutil.Strip(stmt.surfaceText)
            # T78: 门从"只探真调用"扩到 HasFaultingEagerSurface(调用或下标读)，
            # 理由见 primary_object_plan.cheng 同名镜像点注释。
            # T78 current（镜像）：gate 必须在剥括号后的文本上探 &&/||，理由见
            # primary_object_plan.cheng 同名镜像点注释。
            let declInitShortCircuitGateText = PrimaryBodyIrStripOuterParens(declInitShortCircuitText)
            if localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, localSlot) == coreir.LocalI32Tag &&
               declInitShortCircuitText != "" &&
               (PrimaryBodyIrConditionHasAnd(declInitShortCircuitGateText) ||
                PrimaryBodyIrConditionHasOr(declInitShortCircuitGateText)) &&
               stmt.rhsNodeIndex >= 0 &&
               PrimaryBodyIrNodeTreeHasFaultingEagerSurface(lowering.typedIr, stmt.rhsNodeIndex):
                var declBoolBlockStart: int32
                declBoolBlockStart = currentBlockStart
                if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                          slotNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          stmt.rhsNodeIndex,
                                                          declInitShortCircuitText,
                                                          localSlot,
                                                          callOrdinal,
                                                          declBoolBlockStart):
                    currentBlockStart = declBoolBlockStart
                    localInitialized = true
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_bool_condition_assign function={typedFn.functionName} line={stmt.lineNumber}")
                else:
                    # T78 current poison-on-miss（镜像 primary_object_plan.cheng
                    # 同名点): 这条门已确认是含故障性 eager 面(调用/下标)的真
                    # &&/|| decl-init, eager node-eval 臂同门必 miss；CBR 链
                    # 若也失败, 没有安全下降路径了, 严禁静默让 localInitialized
                    # 停在 false 悄悄流向其他 catch-all, 响亮 bail。
                    PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 9703, 0)
            # `var x = TypeName()` 零实参类型构造器（含限定 `mod.TypeName()`）：
            # 默认零初始化整聚合槽。镜像 assign 路径的 assign_zero_ctor
            # （31510-31529）：`AssignZeroConstructorMatches` 已校验 RHS 是零参
            # 复合 `Type()`、目标聚合、尺寸一致、且头名非函数（构造器不是函数）。
            # 前端为限定构造器建了 CallExpr 节点（ordinal 必失败落 call_ordinal
            # gap），此处在 CallExpr 发射器之前拦截，纯 setMem 清零（与 assign
            # 路径同款语义，无新增 op、无 ordinal）。
            if !localInitialized &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, localSlot) == coreir.LocalAggregateTag &&
               PrimaryBodyIrAssignZeroConstructorMatches(bodyIR,
                                                         lowering.typedIr,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         stmt.surfaceText,
                                                         localSlot):
                if PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                    slotNames,
                                                    localSlot,
                                                    callOrdinal):
                    localInitialized = true
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_zero_ctor function={typedFn.functionName} line={stmt.lineNumber}")
            if !localInitialized &&
               stmt.rhsNodeIndex >= 0 &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, localSlot) == coreir.LocalInvalidTag:
                let declNodeKind = PrimaryBodyIrSlotType(bodyIR, localSlot)
                # 批次5：本地声明 RHS 整为 CallExpr 节点时走 CallExpr 发射器
                #（标量/str 槽）；命中即已初始化，miss 落回既有初始化路径。
                var declRhsLit = ""
                if stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                    let declRhsLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                    if IsOk(declRhsLitRes):
                        declRhsLit = Value(declRhsLitRes)
                if !localInitialized &&
                   stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                   lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr &&
                   PrimaryBodyIrCastCallTargetKind(declRhsLit) == coreir.LocalInvalidTag &&
                   (declNodeKind == coreir.LocalI32Tag ||
                    declNodeKind == coreir.LocalI64Tag ||
                    declNodeKind == coreir.LocalF64Tag ||
                    declNodeKind == coreir.LocalStrTag ||
                    declNodeKind == coreir.LocalPtrTag ||
                    declNodeKind == coreir.LocalAggregateTag):
                    PrimaryBodyIrNodeEvalMissOpReset()
                    let declCallEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                    var declCallExprDone = false
                    # 批次6b：嵌套调用实参一旦发射不可落回文本路径，
                    # 发射前必须先过纯探针。
                    if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering.typedIr,
                                                  typedFn,
                                                  irFunction,
                                                  stmt.rhsNodeIndex) >= 0:
                        declCallExprDone = PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering,
                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 varI32ParamNames,
                                                                                 stmt.rhsNodeIndex,
                                                                                 localSlot,
                                                                                 stmt.lineNumber,
                                                                                 callOrdinal)
                    if declCallExprDone:
                        localInitialized = true
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
                    elif PrimaryBodyIrNodeEvalCallEmitCountNow() != declCallEmitMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        localInitialized = true
                    elif os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        var declCallExprMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                        if declCallExprMissOpText == "":
                            declCallExprMissOpText = "call_expr"
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={declCallExprMissOpText} function={typedFn.functionName} line={stmt.lineNumber}")
                if !localInitialized &&
                   declNodeKind == coreir.LocalF64Tag &&
                   texpr.TypedExprFindTopLevelTextToken(strutil.Strip(stmt.surfaceText), "?") > 0:
                    var declF64TernBlockStart = currentBlockStart
                    if PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.sourcePath,
                                                                  stmt.lineNumber,
                                                                  stmt.rhsNodeIndex,
                                                                  strutil.Strip(stmt.surfaceText),
                                                                  localSlot,
                                                                  coreir.LocalF64Tag,
                                                                  callOrdinal,
                                                                  declF64TernBlockStart):
                        currentBlockStart = declF64TernBlockStart
                        localInitialized = true
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_f64_ternary function={typedFn.functionName} line={stmt.lineNumber}")
                if !localInitialized &&
                   (declNodeKind == coreir.LocalI32Tag ||
                    declNodeKind == coreir.LocalI64Tag ||
                    declNodeKind == coreir.LocalF64Tag ||
                    declNodeKind == coreir.LocalStrTag ||
                    declNodeKind == coreir.LocalPtrTag ||
                    declNodeKind == coreir.LocalAggregateTag):
                    PrimaryBodyIrNodeEvalMissOpReset()
                    # 批次6b：子树含调用时先过纯探针并预检存储形态。
                    # 聚合 RHS（seq[i]/字段路径/本地聚合）始终先过探针——
                    # EvalNode 会精确按元素/字段宽物化，探针确认形状为聚合
                    # 才继续，避免发出部分聚合搬运后落回文本路径。
                    var declNodeReady = true
                    if declNodeKind == coreir.LocalAggregateTag ||
                       declNodeKind == coreir.LocalPtrTag ||
                       PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
                        let declNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           typedFn,
                                                                           irFunction,
                                                                           stmt.rhsNodeIndex)
                        if declNodeProbeKind < 0:
                            declNodeReady = false
                        elif declNodeKind == coreir.LocalStrTag:
                            declNodeReady = declNodeProbeKind == coreir.LocalStrTag
                        elif declNodeKind == coreir.LocalI32Tag:
                            declNodeReady = declNodeProbeKind == coreir.LocalI32Tag
                        elif declNodeKind == coreir.LocalI64Tag:
                            declNodeReady = declNodeProbeKind == coreir.LocalI32Tag ||
                                            declNodeProbeKind == coreir.LocalI64Tag
                        elif declNodeKind == coreir.LocalF64Tag:
                            declNodeReady = declNodeProbeKind == coreir.LocalF64Tag
                        elif declNodeKind == coreir.LocalPtrTag:
                            declNodeReady = declNodeProbeKind == coreir.LocalPtrTag
                        elif declNodeKind == coreir.LocalAggregateTag:
                            declNodeReady = declNodeProbeKind == coreir.LocalAggregateTag
                        else:
                            declNodeReady = false
                    let declNodeEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                    var declNodeValueSlot: int32 = -1
                    if declNodeReady:
                        declNodeValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.rhsNodeIndex,
                                                                  callOrdinal)
                    if declNodeValueSlot >= 0 && stmt.bindingName == "_":
                        # `let _ = RHS` 丢弃绑定：RHS 已求值（含调用副作用），值
                        # 被丢弃——聚合/by-ref 结果无需存进 `_` 槽（存储仅做形状
                        # 校验，丢弃语义下纯属多余且会因形不符误 miss）。镜像
                        # assign 路径 25708 `_` 丢弃语义：求值即认领，不发 store。
                        localInitialized = true
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_discard function={typedFn.functionName} line={stmt.lineNumber}")
                    elif declNodeValueSlot >= 0 &&
                       PrimaryBodyIrNodeEvalStore(bodyIR, slotNames, localSlot, declNodeValueSlot):
                        localInitialized = true
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
                    elif PrimaryBodyIrNodeEvalCallEmitCountNow() != declNodeEmitMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        localInitialized = true
                    elif os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        var declNodeMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                        if declNodeMissOpText == "":
                            declNodeMissOpText = "store_shape"
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={declNodeMissOpText} function={typedFn.functionName} line={stmt.lineNumber}")
            # str 三元 decl `let s = if cond: "a" else: "b"`(及 `cond ? a : b` 形)
            # 是 cbr 真分支的规范下降(与 let_call 孪生 str 三元路径 30816 同款);经
            # AppendStrTernaryDeclValue 消费后显式 Own,使节点求值口径认领该语句,
            # 而非由下游 AppendLocalDeclInitializer 文本路径(不 Own)留作 gap。
            if !localInitialized &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, localSlot) == coreir.LocalStrTag:
                let declStrTernRhs = strutil.Strip(parser.ParserStripLineComment(stmt.surfaceText))
                var declStrTernText = PrimaryBodyIrStripOuterParens(declStrTernRhs)
                if texpr.TypedExprFindTopLevelTextToken(declStrTernText, "?") <= 0:
                    declStrTernText = PrimaryBodyIrIfExprToTernaryText(declStrTernText)
                if declStrTernText != "" &&
                   texpr.TypedExprFindTopLevelTextToken(declStrTernText, "?") > 0 &&
                   PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          stmt,
                                                          stmt.rhsNodeIndex,
                                                          declStrTernText,
                                                          localSlot,
                                                          callOrdinal,
                                                          currentBlockStart):
                    localInitialized = true
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_str_ternary function={typedFn.functionName} line={stmt.lineNumber}")
            if !localInitialized:
                localInitialized = PrimaryBodyIrAppendLocalDeclInitializer(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering,
                                                                           typedFn,
                                                                           irFunction,
                                                                           stmt,
                                                                           localSlot,
                                                                           callOrdinal,
                                                                           currentBlockStart)
            if !localInitialized && PrimaryBodyIrTypeTextIsSeqStr(stmt.resultType):
                localInitialized = PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                                    slotNames,
                                                                    localSlot,
                                                                    callOrdinal)
            var localDeclBareDefaultInitialized = false
            if !localInitialized &&
               strutil.Strip(stmt.surfaceText) == "" &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len:
                # 裸 `var x: T` 声明的零值语义：标量槽必须 LoadConst 0，
                # 否则读到栈上垃圾（debug_cstrlen 的 var n 即此缺陷）。
                let bareDeclSlotKind = PrimaryBodyIrSlotType(bodyIR, localSlot)
                if bareDeclSlotKind == coreir.LocalI32Tag ||
                   bareDeclSlotKind == coreir.LocalI64Tag ||
                   bareDeclSlotKind == coreir.LocalPtrTag ||
                   bareDeclSlotKind == coreir.LocalF64Tag:
                    # f64 zero travels as raw bits through the i64 const path
                    var bareDeclZeroKind = bareDeclSlotKind
                    if bareDeclZeroKind == coreir.LocalF64Tag:
                        bareDeclZeroKind = coreir.LocalI64Tag
                    var bareDeclZeroOp: coreir.BodyOp
                    bareDeclZeroOp.kind = coreir.BodyOpLoadConstTag
                    bareDeclZeroOp.target = localSlot
                    add(bareDeclZeroOp.operands, bareDeclZeroKind)
                    add(bareDeclZeroOp.operands, 0)
                    let _ = coreir.BodyIRAppendOp(bodyIR, bareDeclZeroOp)
                    localInitialized = true
                    localDeclBareDefaultInitialized = true
                elif bareDeclSlotKind == coreir.LocalAggregateTag ||
                     bareDeclSlotKind == coreir.LocalStrTag:
                    localInitialized = PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                                        slotNames,
                                                                        localSlot,
                                                                        callOrdinal)
                    if localInitialized:
                        localDeclBareDefaultInitialized = true
            if !localInitialized &&
               strutil.Strip(stmt.surfaceText) != "" &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len:
                # 初始化器主路径失败时复用统一表达式机器（ptr cast/sizeof/二元/三元），
                # 静默跳过会留下未初始化槽（cheng_malloc_export 的 total 曾因此读垃圾）。
                let declInitRhs = strutil.Strip(stmt.surfaceText)
                let declInitKind = PrimaryBodyIrSlotType(bodyIR, localSlot)
                var declInitVarI32Names: str[]
                declInitVarI32Names = []
                var declInitFallbackSlot: int32 = -1
                if declInitKind == coreir.LocalPtrTag:
                    declInitFallbackSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                          slotNames,
                                                                          declInitVarI32Names,
                                                                          lowering.typedIr,
                                                                          stmt.sourcePath,
                                                                          declInitRhs,
                                                                          callOrdinal)
                elif declInitKind == coreir.LocalI64Tag:
                    declInitFallbackSlot = PrimaryBodyIrU64ValueSlotForText(bodyIR,
                                                                            slotNames,
                                                                            declInitVarI32Names,
                                                                            lowering.typedIr,
                                                                            stmt.sourcePath,
                                                                            declInitRhs,
                                                                            callOrdinal)
                    if declInitFallbackSlot < 0:
                        declInitFallbackSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                   slotNames,
                                                                                   declInitVarI32Names,
                                                                                   lowering.typedIr,
                                                                                   stmt.sourcePath,
                                                                                   declInitRhs,
                                                                                   coreir.LocalI64Tag,
                                                                                   callOrdinal)
                elif declInitKind == coreir.LocalI32Tag:
                    declInitFallbackSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                               slotNames,
                                                                               declInitVarI32Names,
                                                                               lowering.typedIr,
                                                                               stmt.sourcePath,
                                                                               declInitRhs,
                                                                               coreir.LocalI32Tag,
                                                                               callOrdinal)
                if declInitFallbackSlot < 0 &&
                   declInitKind != coreir.LocalF64Tag:
                    # 三元初始化器：cond 经 CmpTag 产 0/1，再用 cond*(t-f)+f 选择。
                    let declTernQ = texpr.TypedExprFindTopLevelTextToken(declInitRhs, "?")
                    if declTernQ > 0:
                        let declTernTail = strings.SliceBytes(declInitRhs,
                                                              declTernQ + 1,
                                                              len(declInitRhs) - declTernQ - 1)
                        let declTernColon = texpr.TypedExprFindTopLevelTextToken(declTernTail, ":")
                        if declTernColon > 0:
                            let declTernCond = strutil.Strip(strings.SliceBytes(declInitRhs, 0, declTernQ))
                            let declTernTrue = strutil.Strip(strings.SliceBytes(declTernTail, 0, declTernColon))
                            let declTernFalse = strutil.Strip(strings.SliceBytes(declTernTail,
                                                                                 declTernColon + 1,
                                                                                 len(declTernTail) - declTernColon - 1))
                            var declTernArithKind = declInitKind
                            if declInitKind == coreir.LocalPtrTag:
                                declTernArithKind = coreir.LocalI64Tag
                            var declTernCondSlot: int32 = -1
                            if declTernCond != "" && declTernTrue != "" && declTernFalse != "":
                                declTernCondSlot = PrimaryBodyIrCondValue01Slot(bodyIR,
                                                                                slotNames,
                                                                                lowering,
                                                                                typedFn,
                                                                                irFunction,
                                                                                stmt.sourcePath,
                                                                                stmt.lineNumber,
                                                                                declTernCond,
                                                                                Fmt"{stmt.bindingName}#tern_cond#{stmt.lineNumber}",
                                                                                callOrdinal)
                                # T78 current（镜像 primary_object_plan.cheng 同名点）：
                                # CondValue01Slot bails(-1) on a ternary `cond`
                                # whose `&&`/`||` operand has a faulting eager
                                # surface — fall to the real CBR-chain assigner
                                # instead of leaving declTernCondSlot at -1
