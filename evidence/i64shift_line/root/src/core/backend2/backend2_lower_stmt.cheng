            let tailCallOrdinal = lastOp.operands[0]
            if tailCallOrdinal >= 0 && tailCallOrdinal < bodyIR.callSequence.len:
                if PrimaryCallTargetTailName(bodyIR.callSequence[tailCallOrdinal].targetSymbol) == "panic":
                    voidTailNeedsReturn = true
    elif bodyIR.terms.len > 0 &&
         bodyIR.terms[bodyIR.terms.len - 1].kind != coreir.BodyTermReturnTag:
        # Mirror primary non-void join landing: leftover if-without-else
        # patches false to bodyIR.blocks.len expecting a subsequent block
        # that materializes the fallthrough return (here `return 0` → a0).
        for joinTi in 0..<bodyIR.terms.len:
            let joinTerm = bodyIR.terms[joinTi]
            if joinTerm.kind != coreir.BodyTermCbrTag &&
               joinTerm.kind != coreir.BodyTermBrTag:
                continue
            if joinTerm.trueBlock == bodyIR.blocks.len ||
               joinTerm.falseBlock == bodyIR.blocks.len:
                nonVoidJoinLanding = true
                break
    if voidTailNeedsReturn:
        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                      currentBlockStart,
                                      -1,
                                      coreir.LocalInvalidTag,
                                      0,
                                      false)
    elif nonVoidJoinLanding:
        let landingRetType = texpr.TypedExprNormalizeTypeText(typedFn.returnType)
        if landingRetType == "bool" ||
           landingRetType == "int32" ||
           landingRetType == "int" ||
           landingRetType == "char":
            B2PrimaryBodyIrAppendI32ConstReturn(
                bodyIR,
                slotNames,
                currentBlockStart,
                0)
        elif landingRetType == "int64":
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalI64Tag,
                                          0,
                                          false)
        else:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         irFunction.signatureLineNumber,
                                         int32(texpr.TypedExprIrStmtUnsupported),
                                         94,
                                         bodyIR.blocks.len)
    if bodyIR.ops.len > currentBlockStart:
        if bodyIR.blocks.len <= 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         irFunction.signatureLineNumber,
                                         int32(texpr.TypedExprIrStmtUnsupported),
                                         91,
                                         bodyIR.ops.len)
            var missingTerm: coreir.BodyTerm
            missingTerm.kind = coreir.BodyTermInvalidTag
            missingTerm.resultSlot = -1
            let missingTermIndex = coreir.BodyIRAppendTerm(bodyIR, missingTerm)
            let _ = coreir.BodyIRAppendBlock(bodyIR, 0, bodyIR.ops.len, missingTermIndex)
        else:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         irFunction.signatureLineNumber,
                                         int32(texpr.TypedExprIrStmtUnsupported),
                                         92,
                                         bodyIR.ops.len - currentBlockStart)
            let remainingOpCount = bodyIR.ops.len - currentBlockStart
            if remainingOpCount > 0:
                var remainTerm: coreir.BodyTerm
                remainTerm.kind = coreir.BodyTermInvalidTag
                remainTerm.resultSlot = -1
                let remainTermIndex = coreir.BodyIRAppendTerm(bodyIR, remainTerm)
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, remainingOpCount, remainTermIndex)
    for ti in 0..<bodyIR.terms.len:
        let t = bodyIR.terms[ti]
        if t.kind == coreir.BodyTermCbrTag:
            if t.trueBlock < 0:
                if t.falseBlock < 0:
                    bodyIR.terms[ti].trueBlock = ti + 1
                    if ti + 2 < bodyIR.terms.len:
                        bodyIR.terms[ti].falseBlock = ti + 2
                    else:
                        bodyIR.terms[ti].falseBlock = ti + 1
                else:
                    bodyIR.terms[ti].trueBlock = ti + 1
            else:
                if t.falseBlock < 0:
                    var falseCand: int32
                    if ti + 2 < bodyIR.terms.len:
                        falseCand = ti + 2
                    elif ti + 1 < bodyIR.terms.len:
                        falseCand = ti + 1
                    else:
                        falseCand = ti
                    if falseCand == bodyIR.terms[ti].trueBlock:
                        if bodyIR.blocks.len > 0 &&
                           bodyIR.blocks.len - 1 != bodyIR.terms[ti].trueBlock:
                            falseCand = bodyIR.blocks.len - 1
                        else:
                            falseCand = -1
                    bodyIR.terms[ti].falseBlock = falseCand
    for ti in 0..<bodyIR.terms.len:
        if bodyIR.terms[ti].kind != coreir.BodyTermCbrTag:
            continue
        if bodyIR.terms[ti].trueBlock >= 0 &&
           bodyIR.terms[ti].trueBlock < bodyIR.blocks.len &&
           bodyIR.terms[ti].falseBlock >= 0 &&
           bodyIR.terms[ti].falseBlock < bodyIR.blocks.len:
            continue
        let tailBlock = bodyIR.blocks.len
        if bodyIR.terms[ti].falseBlock < 0 ||
           bodyIR.terms[ti].falseBlock >= bodyIR.blocks.len:
            bodyIR.terms[ti].falseBlock = tailBlock
        if bodyIR.terms[ti].trueBlock < 0 ||
           bodyIR.terms[ti].trueBlock >= bodyIR.blocks.len:
            bodyIR.terms[ti].trueBlock = tailBlock
        if typedFn.returnType == "int32" || typedFn.returnType == "int" ||
           typedFn.returnType == "bool" || typedFn.returnType == "char":
            B2PrimaryBodyIrAppendI32ConstReturn(
                bodyIR,
                slotNames,
                currentBlockStart,
                0)
        else:
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalInvalidTag,
                                          0,
                                          false)
        currentBlockStart = bodyIR.ops.len
        break
    if bodyIR.blocks.len <= 0:
        if typedFn.returnType != "" && typedFn.returnType != "void":
            if !PrimaryBodyIrAppendReturnWholeCall(bodyIR,
                                                   slotNames,
                                                   lowering,
                                                   typedFn,
                                                   irFunction,
                                                   varI32ParamNames,
                                                   PrimaryBodyIrFunctionTailCallNode(
                                                       lowering.typedIr,
                                                       irFunction),
                                                   currentBlockStart,
                                                   callOrdinal):
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             irFunction.signatureLineNumber,
                                             int32(texpr.TypedExprIrStmtUnsupported),
                                             93,
                                             0)
                var emptyMissingTerm: coreir.BodyTerm
                emptyMissingTerm.kind = coreir.BodyTermInvalidTag
                emptyMissingTerm.resultSlot = -1
                let emptyMissingTermIndex = coreir.BodyIRAppendTerm(bodyIR, emptyMissingTerm)
                let _ = coreir.BodyIRAppendBlock(bodyIR,
                                                 currentBlockStart,
                                                 bodyIR.ops.len - currentBlockStart,
                                                 emptyMissingTermIndex)
        else:
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalInvalidTag,
                                          0,
                                          false)
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, 0)
    if bodyIR.callTargetDomainKinds.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetRows.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetInterfaceCids.len !=
           bodyIR.callSequence.len:
        panic("backend2 body ir control: exact call target coverage missing")
    var controlBreakTermIndexes: int32[]
    var controlContinueTermIndexes: int32[]
    var controlLoopBackTermIndexes: int32[]
    lower.LoweringBodyIrControlSeal(
        bodyIR,
        irFunction.deferScopeTransport,
        controlBreakTermIndexes,
        controlContinueTermIndexes,
        controlLoopBackTermIndexes)
    return bodyIR


@borrows
fn B2PrimaryBodyIrGlobalSlotZeroPayload(slot: coreir.LocalSlot): str =
    if slot.sizeBytes > 0:
        return Fmt"zero:{slot.sizeBytes}"
    return "zero:8"

@borrows
fn B2PrimaryBodyIrGlobalDataPayloadText(lowering: lower.LoweringPlanStub,
                                       slot: coreir.LocalSlot): str =
    if slot.typeKind != coreir.LocalI32Tag || slot.sizeBytes != 4:
        return B2PrimaryBodyIrGlobalSlotZeroPayload(slot)
    # Split slot.name `{sourcePath}::{name}` at its LAST `::`.
    var sepPos: int32 = -1
    for i in 0..<len(slot.name):
        if i + 1 < len(slot.name) && slot.name[i] == ':' && slot.name[i + 1] == ':':
            sepPos = i
    if sepPos < 0:
        return B2PrimaryBodyIrGlobalSlotZeroPayload(slot)
    let sourcePath = strings.SliceBytes(slot.name, 0, sepPos)
    let globalName = strings.SliceBytes(slot.name, sepPos + 2, len(slot.name) - sepPos - 2)
    let initText = texpr.TypedExprIrLookupGlobalInitValue(
        lowering.typedIr, sourcePath, globalName)
    if !texpr.TypedExprIrIsI32ConstLiteral(initText):
        return B2PrimaryBodyIrGlobalSlotZeroPayload(slot)
    let value = texpr.TypedExprIrParseI32Const(initText)
    if value == 0:
        return B2PrimaryBodyIrGlobalSlotZeroPayload(slot)
    return Fmt"hex:{payloadcodec.BackendDataPayloadU32LeHex(value)}"

@borrows
fn B2PrimaryTypeTextHasGenericPlaceholder(typeRaw: str): bool =
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        return false
    var tokenStart: int32 = -1
    var i: int32
    while i <= len(typeText):
        var isBoundary = true
        if i < len(typeText):
            let ch = typeText[i]
            if (ch >= 'A' && ch <= 'Z') ||
               (ch >= 'a' && ch <= 'z') ||
               (ch >= '0' && ch <= '9') ||
               ch == '_' || ch == '.':
                isBoundary = false
        if isBoundary:
            if tokenStart >= 0:
                let token = chengpath.TextSlice(typeText, tokenStart, i - tokenStart)
                if texpr.TypedExprTypeIsGenericPlaceholder(token):
                    return true
                tokenStart = -1
        else:
            if tokenStart < 0:
                tokenStart = i
        i = i + 1
    return false

# A function is an uninstantiated generic template when its return type or any of
# its declared param types still carries a generic placeholder (sizeof(T) is
# unknown, so it cannot be lowered to machine code). Such a template has no
# meaningful standalone object-code body: every concrete call site is intrinsified
# inline (Ok[T]/Err[T] construct, Value/Error/IsErr/ErrorInfoOf projections), so
# no real call edge references the template symbol. It must NOT be seeded as an
# emit root nor lowered — otherwise its unloweable body poisons bodySemanticsMissing
# and forces the whole compilation unit to the cold backend (the wcz cliff).
# b2 侧门与老侧判定的一处刻意分歧 (实测定谳, aggregate_copy 夹具):
# 老侧文本启发式把任何单大写字母类型 (如具体声明的 `type P`) 也判成占位符, 但老侧
# 只挡 emit-root 播种 —— 被真实调用边引用的误判函数 (fn bump(p: P): P) 仍经
# reachability BFS 标记并正常 lower。b2 无 BFS (emit-all 模型), 无条件套用老判定会
# 把 bump 的 fragment 静默丢掉 (call reloc 悬空 = 链接期错编)。b2 的等价语义 =
# 占位符 token 仅当**不是作用域内已声明类型**时才算模板占位符: "T" (无声明) → 模板;
# "P" (夹具内声明 aggregate, shape 可解) → 具体函数照常发射。声明存在性用
# PrimaryBodyIrTypeShapeFromText (util 档, ctor-head 检测同款 miss=size0 静默语义)。
@borrows
fn Backend2PlaceholderTokenIsDeclaredType(typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          token: str): bool =
    # 前置: token 已通过 TypedExprTypeIsGenericPlaceholder (len==1 单大写字母,
    # 或 len==4 的 ref/var+大写字母)。取裸字母查声明 shape。
    var bareType = token
    if len(token) == 4:
        bareType = chengpath.TextSlice(token, 3, 1)
    var declKind: int32
    var declSize: int32
    var declAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, bareType, declKind, declSize, declAlign)
    return declSize > 0

@borrows
fn Backend2TypeTextHasUnresolvedGenericPlaceholder(typedIr: texpr.TypedExprIr,
                                                   sourcePath: str,
                                                   typeRaw: str): bool =
    # 快路径: 老启发式全无占位符命中 → 必非模板 (绝大多数函数零额外开销)。
    if !B2PrimaryTypeTextHasGenericPlaceholder(typeRaw):
        return false
    # 慢路径: 重走同款 token 边界扫描, 对每个占位符命中做声明类型救回。
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    var tokenStart: int32 = -1
    var i: int32
    while i <= len(typeText):
        var isBoundary = true
        if i < len(typeText):
            let ch = typeText[i]
            if (ch >= 'A' && ch <= 'Z') ||
               (ch >= 'a' && ch <= 'z') ||
               (ch >= '0' && ch <= '9') ||
               ch == '_' || ch == '.':
                isBoundary = false
        if isBoundary:
            if tokenStart >= 0:
                let token = chengpath.TextSlice(typeText, tokenStart, i - tokenStart)
                if texpr.TypedExprTypeIsGenericPlaceholder(token) &&
                   !Backend2PlaceholderTokenIsDeclaredType(typedIr, sourcePath, token):
                    return true
                tokenStart = -1
        else:
            if tokenStart < 0:
                tokenStart = i
        i = i + 1
    return false

# (结构收割自 primary_object_plan.cheng PrimaryObjectPlanFunctionIsGenericTemplate
# @49853, 占位符判定替换为上方带声明救回的版本; 老侧调用点 = emit-root 播种门
# @50161。b2 侧调用点 = backend2BuildFragmentForFunction 入口 skip 门。)
fn Backend2FunctionIsUninstantiatedGenericTemplate(lowering: var lower.LoweringPlanStub,
                                                   irIndex: int32): bool =
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return false
    let typedFnIndex = lowering.primaryObjectIr.functions[irIndex].typedFunctionIndex
    let sourcePath = strings.CloneStr(lowering.primaryObjectIr.functions[irIndex].sourcePath)
    if typedFnIndex >= 0 && typedFnIndex < lowering.typedIr.functions2_functionNameIds.len:
        let figtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_returnTypeIds[typedFnIndex])
        if IsOk(figtRes) && Backend2TypeTextHasUnresolvedGenericPlaceholder(lowering.typedIr,
                                                                            sourcePath,
                                                                            Value(figtRes)):
            return true
    let paramCount = lowering.primaryObjectIr.functions[irIndex].paramTypes.len
    for paramI in 0..<paramCount:
        let paramType = strings.CloneStr(
            lowering.primaryObjectIr.functions[irIndex].paramTypes[paramI])
        if Backend2TypeTextHasUnresolvedGenericPlaceholder(lowering.typedIr,
                                                           sourcePath,
                                                           paramType):
            return true
    return false

@borrows
fn B2PrimaryObjectCallTargetIsBuiltin(target: str): bool =
    let targetTail = PrimaryCallTargetTailName(target)
    if targetTail != target:
        return false
    if target == "len":
        return true
    if target == "Len":
        return true
    if target == "elemSize":
        return true
    if target == "elemSize[T]":
        return true
    if strings.HasPrefix(target, "elemSize["):
        return true
    if target == "assert":
        return true
    if target == "echo":
        return true
    if target == "Echo":
        return true
    if target == "setLen":
        return true
    if target == "SetLen":
        return true
    if target == "setLenPtr":
        return true
    if target == "reserve":
        return true
    if target == "Reserve":
        return true
    if target == "reservePtr":
        return true
    if target == "clear":
        return true
    if target == "Clear":
        return true
    if target == "add":
        return true
    if target == "Add":
        return true
    if target == "int32":
        return true
    if target == "Int32":
        return true
    if target == "int64":
        return true
    if target == "Int64":
        return true
    if target == "uint64":
        return true
    if target == "UInt64":
        return true
    if target == "uint32":
        return true
    if target == "UInt32":
        return true
    if target == "uint8":
        return true
    if target == "UInt8":
        return true
    if target == "int8":
        return true
    if target == "Int8":
        return true
    if target == "uint":
        return true
    if target == "UInt":
        return true
    if target == "ParamCount":
        return true
    if target == "paramCount":
        return true
    if target == "IntToStr":
        return true
    if target == "Int64ToStr":
        return true
    if target == "cheng_i32_to_str_bridge":
        return true
    if target == "cheng_i64_to_str_bridge":
        return true
    if target == "cheng_str_store_managed":
        return true
    if target == "cheng_seq_store_plain_managed":
        return true
    if target == "cheng_str_move_store_managed":
        return true
    if target == "cheng_seq_move_store_plain_managed":
        return true
    if target == "StrDataPtr":
        return true
