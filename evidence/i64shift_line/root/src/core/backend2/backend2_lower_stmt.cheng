                                # 目标槽从未写入, 读到邻位残留值).
                                if declTernCondSlot < 0:
                                    let declTernCbrScratchSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                               slotNames,
                                                                                               Fmt"{stmt.bindingName}#tern_cond_cbr#{stmt.lineNumber}",
                                                                                               coreir.LocalI32Tag)
                                    if declTernCbrScratchSlot >= 0:
                                        var declTernCbrBlockStart = currentBlockStart
                                        if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                                                  slotNames,
                                                                                  lowering,
                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt.sourcePath,
                                                                                  stmt.lineNumber,
                                                                                  -1,
                                                                                  declTernCond,
                                                                                  declTernCbrScratchSlot,
                                                                                  callOrdinal,
                                                                                  declTernCbrBlockStart):
                                            currentBlockStart = declTernCbrBlockStart
                                            declTernCondSlot = declTernCbrScratchSlot
                                # T78 current poison-on-miss（镜像
                                # primary_object_plan.cheng 同名点): 确认含
                                # 短路 &&/|| 的三元 cond 若两条路都失败, 严禁
                                # 静默悬空 -1, 响亮 bail。
                                if declTernCondSlot < 0 &&
                                   (PrimaryBodyIrConditionHasAnd(PrimaryBodyIrStripOuterParens(declTernCond)) ||
                                    PrimaryBodyIrConditionHasOr(PrimaryBodyIrStripOuterParens(declTernCond))):
                                    PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 9702, 0)
                            if declTernCondSlot >= 0:
                                var declTernValueSlot: int32 = -1
                                var declTernFalseSlot: int32 = -1
                                if declTernCondSlot >= 0:
                                    if declInitKind == coreir.LocalPtrTag:
                                        declTernValueSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                                           slotNames,
                                                                                           declInitVarI32Names,
                                                                                           lowering.typedIr,
                                                                                           stmt.sourcePath,
                                                                                           declTernTrue,
                                                                                           callOrdinal)
                                        if declTernValueSlot < 0:
                                            declTernValueSlot = PrimaryBodyIrCondCmpOperandSlot(bodyIR,
                                                                                                slotNames,
                                                                                                lowering.typedIr,
                                                                                                stmt.sourcePath,
                                                                                                declTernTrue,
                                                                                                Fmt"{stmt.bindingName}#tern_t#{stmt.lineNumber}",
                                                                                                callOrdinal)
                                        declTernFalseSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                                           slotNames,
                                                                                           declInitVarI32Names,
                                                                                           lowering.typedIr,
                                                                                           stmt.sourcePath,
                                                                                           declTernFalse,
                                                                                           callOrdinal)
                                        if declTernFalseSlot < 0:
                                            declTernFalseSlot = PrimaryBodyIrCondCmpOperandSlot(bodyIR,
                                                                                                slotNames,
                                                                                                lowering.typedIr,
                                                                                                stmt.sourcePath,
                                                                                                declTernFalse,
                                                                                                Fmt"{stmt.bindingName}#tern_f#{stmt.lineNumber}",
                                                                                                callOrdinal)
                                    else:
                                        declTernValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                                slotNames,
                                                                                                declInitVarI32Names,
                                                                                                lowering.typedIr,
                                                                                                stmt.sourcePath,
                                                                                                declTernTrue,
                                                                                                declTernArithKind,
                                                                                                callOrdinal)
                                        declTernFalseSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                                slotNames,
                                                                                                declInitVarI32Names,
                                                                                                lowering.typedIr,
                                                                                                stmt.sourcePath,
                                                                                                declTernFalse,
                                                                                                declTernArithKind,
                                                                                                callOrdinal)
                                if declTernCondSlot >= 0 && declTernValueSlot >= 0 && declTernFalseSlot >= 0:
                                    let declTernDelta = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                      slotNames,
                                                                                      Fmt"{stmt.bindingName}#tern_delta#{stmt.lineNumber}",
                                                                                      declTernArithKind)
                                    let declTernScaled = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                       slotNames,
                                                                                       Fmt"{stmt.bindingName}#tern_scaled#{stmt.lineNumber}",
                                                                                       declTernArithKind)
                                    if declTernDelta >= 0 && declTernScaled >= 0:
                                        var declTernSubOp: coreir.BodyOp
                                        declTernSubOp.kind = coreir.BodyOpBinOpTag
                                        declTernSubOp.target = declTernDelta
                                        add(declTernSubOp.operands, declTernArithKind)
                                        add(declTernSubOp.operands, int32(texpr.TypedExprIrOpI32Sub))
                                        add(declTernSubOp.operands, declTernValueSlot)
                                        add(declTernSubOp.operands, declTernFalseSlot)
                                        let _ = coreir.BodyIRAppendOp(bodyIR, declTernSubOp)
                                        var declTernMulOp: coreir.BodyOp
                                        declTernMulOp.kind = coreir.BodyOpBinOpTag
                                        declTernMulOp.target = declTernScaled
                                        add(declTernMulOp.operands, declTernArithKind)
                                        add(declTernMulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
                                        add(declTernMulOp.operands, declTernDelta)
                                        add(declTernMulOp.operands, declTernCondSlot)
                                        let _ = coreir.BodyIRAppendOp(bodyIR, declTernMulOp)
                                        if declInitKind == coreir.LocalPtrTag:
                                            let declTernSum = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                            slotNames,
                                                                                            Fmt"{stmt.bindingName}#tern_sum#{stmt.lineNumber}",
                                                                                            coreir.LocalI64Tag)
                                            if declTernSum >= 0:
                                                var declTernAddOp: coreir.BodyOp
                                                declTernAddOp.kind = coreir.BodyOpBinOpTag
                                                declTernAddOp.target = declTernSum
                                                add(declTernAddOp.operands, coreir.LocalI64Tag)
                                                add(declTernAddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                                                add(declTernAddOp.operands, declTernScaled)
                                                add(declTernAddOp.operands, declTernFalseSlot)
                                                let _ = coreir.BodyIRAppendOp(bodyIR, declTernAddOp)
                                                var declTernPtrCopyOp: coreir.BodyOp
                                                declTernPtrCopyOp.kind = coreir.BodyOpCopyLocalTag
                                                declTernPtrCopyOp.target = localSlot
                                                add(declTernPtrCopyOp.operands, declTernSum)
                                                let _ = coreir.BodyIRAppendOp(bodyIR, declTernPtrCopyOp)
                                                localInitialized = true
                                        else:
                                            var declTernAddOp: coreir.BodyOp
                                            declTernAddOp.kind = coreir.BodyOpBinOpTag
                                            declTernAddOp.target = localSlot
                                            add(declTernAddOp.operands, declTernArithKind)
                                            add(declTernAddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                                            add(declTernAddOp.operands, declTernScaled)
                                            add(declTernAddOp.operands, declTernFalseSlot)
                                            let _ = coreir.BodyIRAppendOp(bodyIR, declTernAddOp)
                                            localInitialized = true
                if declInitFallbackSlot >= 0 &&
                   declInitFallbackSlot < bodyIR.localSlots.len &&
                   PrimaryBodyIrSlotType(bodyIR, declInitFallbackSlot) == declInitKind:
                    if declInitFallbackSlot == localSlot:
                        localInitialized = true
                    else:
                        var declInitCopyOp: coreir.BodyOp
                        declInitCopyOp.kind = coreir.BodyOpCopyLocalTag
                        declInitCopyOp.target = localSlot
                        add(declInitCopyOp.operands, declInitFallbackSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, declInitCopyOp)
                        localInitialized = true
            if localInitialized:
                add(initializedLocalDeclLines, stmt.lineNumber)
                add(initializedLocalDeclNames, share(stmt.bindingName))
        elif stmt.kind == texpr.TypedExprIrStmtResultIntrinsic:
            let resultIntrinsicName = stmt.callCallee
            let resultIntrinsicIsProjection = resultIntrinsicName == "Value" ||
                resultIntrinsicName == "Error" ||
                resultIntrinsicName == "ErrorInfoOf" ||
                resultIntrinsicName == "IsOk" ||
                resultIntrinsicName == "IsErr"
            let resultIntrinsicIsConstructor = resultIntrinsicName == "Ok" ||
                resultIntrinsicName == "Err"
            if resultIntrinsicIsConstructor:
                if !PrimaryBodyIrResultConstructorContract(lowering.typedIr,
                                                            typedFn,
                                                            irFunction,
                                                            stmt):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 61,
                                                 int32(stmt.detailKind))
                    nextOpIndex = nextOpIndex + 1
                    continue
                var resultConstructorDriverIndex: int32 = -1
                for resultDriverP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let resultDriverIndex = sameLineOrder[resultDriverP]
                    if resultDriverIndex == stmtIndex:
                        continue
                    let resultDriverStmt = irFunction.statements[resultDriverIndex]
                    if resultDriverStmt.kind == texpr.TypedExprIrStmtReturn ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtIf ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtElif ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtWhile ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtLetCall ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtAssign ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtCall:
                        resultConstructorDriverIndex = resultDriverIndex
                        break
                if resultConstructorDriverIndex >= 0:
                    nextOpIndex = nextOpIndex + 1
                    continue
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(stmt.detailKind))
                nextOpIndex = nextOpIndex + 1
                continue
            if !resultIntrinsicIsProjection:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(stmt.detailKind))
                nextOpIndex = nextOpIndex + 1
                continue
            var resultSourceNodeIndex: int32
            var resultSourceBinding = ""
            var resultSourceType = ""
            var resultSourceInner = ""
            var resultContractProjectKind = coreir.BodyResultProjectInvalidTag
            let resultProjectionContractOk = PrimaryBodyIrDispatchResultIntrinsicConsumer(
                lowering.typedIr,
                typedFn,
                irFunction,
                stmt,
                resultSourceNodeIndex,
                resultSourceBinding,
                resultSourceType,
                resultSourceInner,
                resultContractProjectKind)
            if !resultProjectionContractOk:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(parser.ParserResultIntrinsicDetailKind(resultIntrinsicName)))
                nextOpIndex = nextOpIndex + 1
                continue
            var sourceSlot: int32 = -1
            sourceSlot = PrimaryBodyIrFindArgSlot(bodyIR,
                                                   slotNames,
                                                   resultSourceBinding)
            if sourceSlot < 0:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(parser.ParserResultIntrinsicDetailKind(resultIntrinsicName)))
                nextOpIndex = nextOpIndex + 1
                continue
            var targetSlot: int32 = -1
            if stmt.bindingName != "":
                targetSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                slotNames,
                                                                lowering.typedIr,
                                                                stmt.sourcePath,
                                                                stmt.bindingName,
                                                                stmt.resultType)
            var projectKind = resultContractProjectKind
            var projectOffset: int32
            var projectByteCount: int32
            # F14b(backend2): Err->Value() must panic, never silently return a
            # zero value (result.cheng:80-83 source guard). valueErrMsgLayoutOk
            # gates the guard emission right before the value-copy op below; a
            # miss here poisons the whole statement (same as any other
            # ResultIntrinsic precondition miss) rather than falling through
            # unguarded. Byte-identical port of primary_object_plan.cheng's
            # equivalent StmtResultIntrinsic Value arm fix.
            var valueErrMsgOffset: int32
            var valueErrMsgLayoutOk = false
            if resultIntrinsicName == "Value":
                var valueTypeKind: int32
                var valueSizeBytes: int32
                var valueAlignBytes: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               stmt.resultType,
                                               valueTypeKind,
                                               valueSizeBytes,
                                               valueAlignBytes)
                projectOffset = PrimaryBodyIrAlignedOffset(1, valueAlignBytes)
                projectByteCount = valueSizeBytes
                var valueErrValueKind: int32
                var valueErrValueSize: int32
                var valueErrValueOffset: int32
                var valueErrCodeOffset: int32
                var valueErrTotalSize: int32
                valueErrMsgLayoutOk = PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                                                          stmt.sourcePath,
                                                                          resultSourceInner,
                                                                          valueErrValueKind,
                                                                          valueErrValueSize,
                                                                          valueErrValueOffset,
                                                                          valueErrCodeOffset,
                                                                          valueErrMsgOffset,
                                                                          valueErrTotalSize)
            elif resultIntrinsicName == "Error":
                # errmsg 偏移随源 Result 内型解算（标量内型落 < 40）；源内型
                # 取首实参绑定类型→Result[T] 解 T→构造布局算偏移。解不出即
                # 保持 InvalidTag（projectByteCount=0）触发同行驱动孪生降级。
                var errTextValueKind: int32
                var errTextValueSize: int32
                var errTextValueOffset: int32
                var errTextErrCodeOffset: int32
                var errTextErrMsgOffset: int32
                var errTextTotalSize: int32
                if PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                                       stmt.sourcePath,
                                                       resultSourceInner,
                                                       errTextValueKind,
                                                       errTextValueSize,
                                                       errTextValueOffset,
                                                       errTextErrCodeOffset,
                                                       errTextErrMsgOffset,
                                                       errTextTotalSize):
                    projectOffset = errTextErrMsgOffset
                    projectByteCount = 24
            elif resultIntrinsicName == "ErrorInfoOf":
                # ErrorInfoOf[T](r) 内征：把源 Result 聚合里的整块 err{code,msg}
                # 子聚合（32B = ErrorInfo 布局）投影到 ErrorInfo 结果槽。err 块
                # 偏移随源内型 T 解算（与 Error 投影同源：取首实参 Result[T] 解
                # T→构造布局算 errCodeOffset）。解不出即保持 InvalidTag 触发同行
                # 驱动孪生降级。
                var errInfoValueKind: int32
                var errInfoValueSize: int32
                var errInfoValueOffset: int32
                var errInfoErrCodeOffset: int32
                var errInfoErrMsgOffset: int32
                var errInfoTotalSize: int32
                if PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                                       stmt.sourcePath,
                                                       resultSourceInner,
                                                       errInfoValueKind,
                                                       errInfoValueSize,
                                                       errInfoValueOffset,
                                                       errInfoErrCodeOffset,
                                                       errInfoErrMsgOffset,
                                                       errInfoTotalSize):
                    projectOffset = errInfoErrCodeOffset
                    projectByteCount = errInfoTotalSize - errInfoErrCodeOffset
            var resultProjectionLayoutOk = projectKind != coreir.BodyResultProjectInvalidTag
            if projectKind != coreir.BodyResultProjectIsErrTag &&
               projectKind != coreir.BodyResultProjectIsOkTag &&
               projectByteCount <= 0:
                resultProjectionLayoutOk = false
            if projectKind == coreir.BodyResultProjectValueStrTag &&
               !valueErrMsgLayoutOk:
                resultProjectionLayoutOk = false
            if !resultProjectionLayoutOk:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(parser.ParserResultIntrinsicDetailKind(resultIntrinsicName)))
                nextOpIndex = nextOpIndex + 1
                continue
            if targetSlot < 0 &&
               (projectKind == coreir.BodyResultProjectIsErrTag ||
                projectKind == coreir.BodyResultProjectIsOkTag):
                targetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#result_intrinsic_bool_{stmt.lineNumber}_{stmtIndex}",
                                                           coreir.LocalI32Tag)
            # `return IsOk(r)`/`return IsErr(r)` 的孪生 result_intrinsic:同行 return 驱动
            # 已通过 AppendReturnBoolCondition→EmitConditionOps 的 IsOk 分支物化该布尔投影并
            # 终结块(completedReturnLineNumber==stmt.lineNumber 仅 return 成功路径置位),孪生
            # 此处再发 ResultProject 必落在 return 终结符之后=不可达 dead op → 未归块 bail_92。
            # 跳过孪生(镜像下方 sameLine-driver skip 的 Own+continue)。三重门控防误跳独立
            # let 的投影:① 仅 IsOk/IsErr(布尔投影,return 自物化;Value/Error 不自物化不跳);
            # ② 同行 return 已成功;③ 无 let 绑定(stmt.bindingName==""),独立 let b=IsOk(r2)
            # 的孪生带绑定不跳、正常发射供 let 用。
            if PrimaryBodyIrCommitCompletedReturnResultIntrinsic(
                completedReturnLineNumber,
                stmt.lineNumber,
                stmt.bindingName,
                projectKind,
                structuredResultIntrinsicConsumeCountOut):
                nextOpIndex = nextOpIndex + 1
                continue
            if targetSlot < 0:
                targetSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                 slotNames,
                                                                 lowering.typedIr,
                                                                 stmt.sourcePath,
                                                                 Fmt"#result_intrinsic_temp_{stmt.lineNumber}_{stmtIndex}",
                                                                 stmt.resultType)
            if targetSlot < 0:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(parser.ParserResultIntrinsicDetailKind(resultIntrinsicName)))
                nextOpIndex = nextOpIndex + 1
                continue
            # F14b(backend2): Err->Value() must panic, never silently return a
            # zero value.
            if projectKind == coreir.BodyResultProjectValueStrTag:
                if !PrimaryBodyIrAppendResultValuePanicGuard(bodyIR,
                                                             slotNames,
                                                             sourceSlot,
                                                             valueErrMsgOffset,
                                                             24,
                                                             callOrdinal):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 61,
                                                 projectKind)
                    nextOpIndex = nextOpIndex + 1
                    continue
            if !PrimaryBodyIrDispatchResultIntrinsicStatementOp(
                bodyIR,
                slotNames,
                lowering.typedIr,
                typedFn,
                irFunction,
                stmt,
                targetSlot,
                projectOffset,
                projectByteCount,
                structuredResultIntrinsicConsumeCountOut
            ):
                nextOpIndex = nextOpIndex + 1
                continue
            nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtLetCall:
            if traceEnabled:
                B2PrimaryObjectPlanTrace(Fmt"phase=let_call_enter function={typedFn.functionName} line={stmt.lineNumber} binding={stmt.bindingName} target={stmt.callTarget} callee={stmt.callCallee} result={stmt.resultType} surface={stmt.surfaceText}")
            if PrimaryBodyIrHasPreviousDuplicateWholeLetCall(irFunction.statements, stmtIndex):
                nextOpIndex = nextOpIndex + 1
                continue
            var letCallLineHasReturn = false
            for lineStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                let lineStmtIndex = sameLineOrder[lineStmtIndexP]
                let lineStmt = irFunction.statements[lineStmtIndex]
                if lineStmt.kind == texpr.TypedExprIrStmtReturn:
                    letCallLineHasReturn = true
                    break
            if letCallLineHasReturn:
                nextOpIndex = nextOpIndex + 1
                continue
            var slotId: int32 = -1
            # Deref let twin (let x: uint8 = *(UInt8Ptr(call(...)))): the LocalDecl
            # twin carries the deref surface; this LetCall must emit the call into
            # a ptr temp and deref into the declared-type binding slot.
            var letCallDerefWidth: int32
            if len(stmt.bindingName) > 0:
                for letCallDerefScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallDerefScan = sameLineOrder[letCallDerefScanP]
                    let letCallDerefStmt = irFunction.statements[letCallDerefScan]
                    if letCallDerefStmt.kind == texpr.TypedExprIrStmtLocalDecl &&
                       letCallDerefStmt.bindingName == stmt.bindingName:
                        var letCallDerefSurface = strutil.Strip(letCallDerefStmt.surfaceText)
                        var letCallDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(letCallDerefSurface, "int32")
                        if letCallDerefCastInner == "":
                            letCallDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(letCallDerefSurface, "uint8")
                        if letCallDerefCastInner != "":
                            letCallDerefSurface = strutil.Strip(letCallDerefCastInner)
                        if PrimaryBodyIrUInt8PtrDerefPointerText(letCallDerefSurface) != "":
                            letCallDerefWidth = 1
                        elif PrimaryBodyIrI32PtrDerefPointerText(letCallDerefSurface) != "":
                            letCallDerefWidth = 4
                        break
            if len(stmt.bindingName) > 0:
                var resultTypeText = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                var letCallF64FromIntMismatch = false
                if letCallDerefWidth > 0:
                    var letCallDerefBindingType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt.lineNumber,
                                                                                  stmt.bindingName)
                    if letCallDerefBindingType == "" ||
                       PrimaryBodyIrTypeKindFromText(letCallDerefBindingType) != coreir.LocalI32Tag:
                        letCallDerefBindingType = "int32"
                    resultTypeText = letCallDerefBindingType
                if resultTypeText != "str":
                    for conditionStmtIndex in 0..<stmtEnd:
                        let conditionStmt = irFunction.statements[conditionStmtIndex]
                        if conditionStmt.lineNumber <= stmt.lineNumber:
                            continue
                        if conditionStmt.kind != texpr.TypedExprIrStmtIf &&
                           conditionStmt.kind != texpr.TypedExprIrStmtElif:
                            continue
                        if conditionStmt.conditionKind != texpr.TypedExprIrCondStrEqLiteral &&
                           conditionStmt.conditionKind != texpr.TypedExprIrCondStrNeLiteral:
                            continue
                        if conditionStmt.conditionLhsText == stmt.bindingName:
                            resultTypeText = "str"
                            break
                if resultTypeText != "str":
                    # Cast-wrapped let-call (let x = int32(f())): the LetCall twin
                    # loses the cast head, so the binding slot must use the declared
                    # binding type; the call result store narrows by slot width.
                    let declaredBindingType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                              typedFn,
                                                                              irFunction,
                                                                              stmt.lineNumber,
                                                                              stmt.bindingName)
                    if declaredBindingType != "" && declaredBindingType != resultTypeText:
                        let declaredBindingKind = PrimaryBodyIrTypeKindFromText(declaredBindingType)
                        let callResultKind = PrimaryBodyIrTypeKindFromText(resultTypeText)
                        var declaredBindingCtorHead = stmt.callTarget
                        if declaredBindingCtorHead == "":
                            declaredBindingCtorHead = stmt.callCallee
                        let declaredBindingIsCtor = PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                                                 stmt.sourcePath,
                                                                                                 declaredBindingCtorHead)
                        if declaredBindingKind == coreir.LocalAggregateTag &&
                           (callResultKind != coreir.LocalAggregateTag || declaredBindingIsCtor):
                            resultTypeText = declaredBindingType
                        elif (declaredBindingKind == coreir.LocalI32Tag ||
                              declaredBindingKind == coreir.LocalI64Tag) &&
                           (callResultKind == coreir.LocalI32Tag ||
                            callResultKind == coreir.LocalI64Tag) &&
                           declaredBindingKind != callResultKind:
                            resultTypeText = declaredBindingType
                    # #95 wave5 根修 gen2 镜像 (pobj 三镜像铁律, 补 wave5 补丁
                    # 自身遗漏的第三份拷贝 backend2_lower_stmt.cheng, 与 gen1
                    # primary_object_plan.cheng 同函数同一插入点一字不差同步):
                    # `let f: float64 = float64(realCall())` 被 typed_expr 前端
                    # 拆成 let_call+local_decl 双语句, 同行声明查不到
                    # declaredBindingType, 上面的窄化分支从不命中——用
                    # stmt.resultType(callee 实际返回类型)与外层声明类型比较,
                    # int32/int64 结果误配 float64 声明时诚实 poison, 不静默把
                    # 整型返回值原始位当 float64 位重解读。
                    let letCallStmtResultKind = PrimaryBodyIrTypeKindFromText(stmt.resultType)
                    let letCallCalleeResultKind = PrimaryBodyIrTypeKindFromText(resultTypeText)
                    if letCallStmtResultKind == coreir.LocalF64Tag &&
                       (letCallCalleeResultKind == coreir.LocalI32Tag ||
                        letCallCalleeResultKind == coreir.LocalI64Tag):
                        letCallF64FromIntMismatch = true
                if letCallF64FromIntMismatch:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        B2PrimaryObjectPlanTrace(Fmt"phase=let_call_f64_from_int_mismatch_poison function={typedFn.functionName} line={stmt.lineNumber} binding={stmt.bindingName}")
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 818,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
                slotId = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                            slotNames,
                                                            lowering.typedIr,
                                                            PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                            stmt.bindingName,
                                                            resultTypeText)
                # Postfix chain over a whole call (`let n = f(...).len` / `.field` /
                # `[i]`): the LetCall classifier sized the slot from the leading call's
                # aggregate/str return type, but the binding is the scalar the postfix
                # reduces to (str[].len -> int32). The binding-type lookup also infers
                # the aggregate (it sees the call), so the scalar can only be recovered
                # from the node-tree twin's root result type. When a same-line decl/
                # assign twin carries a FieldGet/IndexGet-over-call tree whose result is
                # a concrete scalar, retype the binding slot to that scalar so the i32/
                # i64 store-shape readiness check passes (FindOrCreateSlotSized converts
                # the existing aggregate slot in place). No effect on plain aggregate
                # let-calls — they have no scalar-rooted twin.
                if slotId >= 0 && slotId < bodyIR.localSlots.len:
                    var letCallSlotRetypeTreeIndex: int32 = -1
                    for letCallSlotScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                        let letCallSlotScan = sameLineOrder[letCallSlotScanP]
                        let letCallSlotStmt = irFunction.statements[letCallSlotScan]
                        if (letCallSlotStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                            letCallSlotStmt.kind == texpr.TypedExprIrStmtAssign) &&
                           letCallSlotStmt.bindingName == stmt.bindingName &&
                           letCallSlotStmt.rhsNodeIndex >= 0 &&
                           letCallSlotStmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                           lowering.typedIr.nodes2_opKinds[letCallSlotStmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr &&
                           PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, letCallSlotStmt.rhsNodeIndex):
                            letCallSlotRetypeTreeIndex = letCallSlotStmt.rhsNodeIndex
                            break
                    if letCallSlotRetypeTreeIndex >= 0:
                        let lcsrtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[letCallSlotRetypeTreeIndex])
                        # form59 residual: hoist Value(Result[str]) before StripVarType
                        let lcsrt_f59: str = Value(lcsrtRes)
                        let letCallSlotNodeType = texpr.TypedExprStripVarType(lcsrt_f59)
                        let letCallSlotNodeKind = PrimaryBodyIrTypeKindFromText(letCallSlotNodeType)
                        let letCallSlotCurrentKind = PrimaryBodyIrSlotType(bodyIR, slotId)
                        if (letCallSlotNodeKind == coreir.LocalI32Tag ||
                            letCallSlotNodeKind == coreir.LocalI64Tag ||
                            letCallSlotNodeKind == coreir.LocalF64Tag ||
                            letCallSlotNodeKind == coreir.LocalStrTag) &&
                           letCallSlotCurrentKind != letCallSlotNodeKind:
                            slotId = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                                        stmt.bindingName,
                                                                        letCallSlotNodeType)
                if traceEnabled:
                    B2PrimaryObjectPlanTrace(Fmt"phase=let_call_slot function={typedFn.functionName} line={stmt.lineNumber} binding={stmt.bindingName} result={resultTypeText} slot={slotId}")
            # 批次6b：letcall 行的面是"调用+尾部表达式"（var x = F(a) + 1）
            # 时文本路径只降调用、尾部静默丢弃。same-line 孪生 decl/assign
            # 行（已让位）携带完整 rhs 节点树（根非纯 CallExpr 且含调用）
            # 且探针可降时，整树经节点路径降入绑定槽并消费本行。
            var letCallNodeTreeIndex: int32 = -1
            var letCallTwinSurfaceText = ""
            if slotId >= 0 &&
               slotId < bodyIR.localSlots.len &&
               len(stmt.bindingName) > 0 &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalInvalidTag:
                for letCallNodeScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallNodeScan = sameLineOrder[letCallNodeScanP]
                    let letCallNodeStmt = irFunction.statements[letCallNodeScan]
                    if (letCallNodeStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                        letCallNodeStmt.kind == texpr.TypedExprIrStmtAssign) &&
                       letCallNodeStmt.bindingName == stmt.bindingName &&
                       letCallNodeStmt.rhsNodeIndex >= 0 &&
                       letCallNodeStmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                       lowering.typedIr.nodes2_opKinds[letCallNodeStmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr &&
                       PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, letCallNodeStmt.rhsNodeIndex):
                        letCallNodeTreeIndex = letCallNodeStmt.rhsNodeIndex
                        letCallTwinSurfaceText = strutil.Strip(letCallNodeStmt.surfaceText)
                        break
            # `let r = a && f()` / `let r = a || f()` with a call in the RHS: the
            # twin decl carries the whole short-circuit tree (root is log_and /
            # log_or, not a CallExpr). Node-eval of that tree runs the call operand
            # eagerly and bitwise-combines (the `false && bump(true)` miscompile —
            # bump ran even though `false &&` short-circuits). Materialize the bool
            # via the CBR-chain assigner so the call operand only runs in the block
            # that the short-circuit actually reaches. Mirrors the plain-assign gate
            # (AppendI32Assign:25095) and consumes the line on success.
            if letCallNodeTreeIndex >= 0 &&
               letCallTwinSurfaceText != "" &&
               PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag &&
               (PrimaryBodyIrConditionHasAnd(letCallTwinSurfaceText) ||
                PrimaryBodyIrConditionHasOr(letCallTwinSurfaceText)):
                var letCallBoolBlockStart: int32
                letCallBoolBlockStart = currentBlockStart
                if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                          slotNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          letCallNodeTreeIndex,
                                                          letCallTwinSurfaceText,
                                                          slotId,
                                                          callOrdinal,
                                                          letCallBoolBlockStart):
                    currentBlockStart = letCallBoolBlockStart
                    nextOpIndex = nextOpIndex + 1
                    continue
            if letCallNodeTreeIndex >= 0:
                PrimaryBodyIrNodeEvalMissOpReset()
                let letCallSlotKind = PrimaryBodyIrSlotType(bodyIR, slotId)
                var letCallNodeReady = false
                let letCallProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  letCallNodeTreeIndex)
                if letCallProbeKind >= 0:
                    if letCallSlotKind == coreir.LocalStrTag:
                        letCallNodeReady = letCallProbeKind == coreir.LocalStrTag
                    elif letCallSlotKind == coreir.LocalI32Tag:
                        letCallNodeReady = letCallProbeKind == coreir.LocalI32Tag
                    elif letCallSlotKind == coreir.LocalI64Tag:
                        letCallNodeReady = letCallProbeKind == coreir.LocalI32Tag ||
                                           letCallProbeKind == coreir.LocalI64Tag
                    elif letCallSlotKind == coreir.LocalF64Tag:
                        letCallNodeReady = letCallProbeKind == coreir.LocalF64Tag
                let letCallEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                var letCallNodeStored = false
                if letCallNodeReady:
                    let letCallNodeValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,
                                                                     typedFn,
                                                                     irFunction,
                                                                     letCallNodeTreeIndex,
                                                                     callOrdinal)
                    if letCallNodeValueSlot >= 0:
                        letCallNodeStored = PrimaryBodyIrNodeEvalStore(bodyIR,
                                                                       slotNames,
                                                                       slotId,
                                                                       letCallNodeValueSlot)
                if letCallNodeStored:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
                    nextOpIndex = nextOpIndex + 1
                    continue
                if PrimaryBodyIrNodeEvalCallEmitCountNow() != letCallEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var letCallMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                    if letCallMissOpText == "":
                        letCallMissOpText = "letcall_tail_shape"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={letCallMissOpText} function={typedFn.functionName} line={stmt.lineNumber}")
            var letCallRootCastIndex: int32 = -1
            if slotId >= 0 &&
               slotId < bodyIR.localSlots.len &&
               len(stmt.bindingName) > 0 &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalInvalidTag:
                var letCallRootRhsLit = ""
                if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                    let lcrLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                    if IsOk(lcrLitRes):
                        letCallRootRhsLit = Value(lcrLitRes)
                if stmt.rhsNodeIndex >= 0 &&
                   stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                   PrimaryBodyIrCastCallTargetKind(letCallRootRhsLit) != coreir.LocalInvalidTag &&
                   PrimaryBodyIrCastCallArgNodeIndex(lowering.typedIr, stmt.rhsNodeIndex) >= 0:
                    letCallRootCastIndex = stmt.rhsNodeIndex
                if letCallRootCastIndex < 0:
                    for letCallCastScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                        let letCallCastScan = sameLineOrder[letCallCastScanP]
                        let letCallCastStmt = irFunction.statements[letCallCastScan]
                        var castRhsLit = ""
                        if letCallCastStmt.rhsNodeIndex >= 0 && letCallCastStmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                            let castRhsLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[letCallCastStmt.rhsNodeIndex])
                            if IsOk(castRhsLitRes):
                                castRhsLit = Value(castRhsLitRes)
                        if (letCallCastStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                            letCallCastStmt.kind == texpr.TypedExprIrStmtAssign) &&
                           letCallCastStmt.bindingName == stmt.bindingName &&
                           letCallCastStmt.rhsNodeIndex >= 0 &&
                           letCallCastStmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                           PrimaryBodyIrCastCallTargetKind(castRhsLit) != coreir.LocalInvalidTag &&
                           PrimaryBodyIrCastCallArgNodeIndex(lowering.typedIr, letCallCastStmt.rhsNodeIndex) >= 0:
                            letCallRootCastIndex = letCallCastStmt.rhsNodeIndex
                            break
            if letCallRootCastIndex >= 0:
                PrimaryBodyIrNodeEvalMissOpReset()
                let letCallCastSlotKind = PrimaryBodyIrSlotType(bodyIR, slotId)
                let letCallCastProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering.typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      letCallRootCastIndex)
                var letCallCastReady = false
                if letCallCastProbeKind == coreir.LocalI32Tag:
                    letCallCastReady = letCallCastSlotKind == coreir.LocalI32Tag
                elif letCallCastProbeKind == coreir.LocalI64Tag:
                    letCallCastReady = letCallCastSlotKind == coreir.LocalI32Tag ||
                                       letCallCastSlotKind == coreir.LocalI64Tag
                elif letCallCastProbeKind == coreir.LocalF64Tag:
                    letCallCastReady = letCallCastSlotKind == coreir.LocalF64Tag
                let letCallCastEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                var letCallCastStored = false
                if letCallCastReady:
                    let letCallCastValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,
                                                                     typedFn,
                                                                     irFunction,
                                                                     letCallRootCastIndex,
                                                                     callOrdinal)
                    if letCallCastValueSlot >= 0:
                        let letCallCastValueKind = PrimaryBodyIrSlotType(bodyIR, letCallCastValueSlot)
                        if letCallCastSlotKind == coreir.LocalI32Tag &&
                           letCallCastValueKind == coreir.LocalI64Tag:
                            # cast 产 i64 值、绑定槽是 i32(readiness 31291 已放行此收窄:
                            # `let x = int64(intrinsic-i32-call)` 的值本 fits i32 无损)。
                            # NodeEvalStore 无标量收窄分支会落 store_shape_l1_v6,故此处
                            # 直接 CopyLocal 存低 32 位(与文本路径 i64→i32 绑定同款)。
                            var letCallCastCopyOp: coreir.BodyOp
                            letCallCastCopyOp.kind = coreir.BodyOpCopyLocalTag
                            letCallCastCopyOp.target = slotId
                            add(letCallCastCopyOp.operands, letCallCastValueSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, letCallCastCopyOp)
                            letCallCastStored = true
                        else:
                            letCallCastStored = PrimaryBodyIrNodeEvalStore(bodyIR,
                                                                           slotNames,
                                                                           slotId,
                                                                           letCallCastValueSlot)
                if letCallCastStored:
                    nextOpIndex = nextOpIndex + 1
                    continue
                if PrimaryBodyIrNodeEvalCallEmitCountNow() != letCallCastEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
            let targetStr = strings.CloneStr(stmt.callTarget)
            if PrimaryObjectCallTargetIsPureCast(targetStr):
                if slotId >= 0 && stmt.callArgCount == 1:
                    let castResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                    let castTypeKind = PrimaryBodyIrTypeKindFromText(castResultType)
                    var castValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                  slotNames,
                                                                                  varI32ParamNames,
                                                                                  lowering.typedIr,
                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt.sourcePath,
                                                                                  stmt.lineNumber,
                                                                                  stmt.callArgsText,
                                                                                  castTypeKind)
                    if castValueSlot < 0 && castTypeKind == coreir.LocalI32Tag:
                        castValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                   slotNames,
                                                                                   varI32ParamNames,
                                                                                   lowering.typedIr,
                                                                                   typedFn,
                                                                                   irFunction,
                                                                                   stmt.sourcePath,
                                                                                   stmt.lineNumber,
                                                                                   stmt.callArgsText,
                                                                                   coreir.LocalI64Tag)
                    if castValueSlot >= 0:
                        if castValueSlot != slotId:
                            var castCopyOp: coreir.BodyOp
                            castCopyOp.kind = coreir.BodyOpCopyLocalTag
                            castCopyOp.target = slotId
                            add(castCopyOp.operands, castValueSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, castCopyOp)
                        nextOpIndex = nextOpIndex + 1
                        continue
                continue
            if slotId >= 0 &&
               slotId < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalAggregateTag &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalInvalidTag:
                var letCallCtorHead = strings.CloneStr(targetStr)
                if letCallCtorHead == "":
                    letCallCtorHead = stmt.callCallee
                if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, stmt.sourcePath, letCallCtorHead):
                    var letCallCtorType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                          typedFn,
                                                                          irFunction,
                                                                          stmt.lineNumber,
                                                                          stmt.bindingName)
                    if letCallCtorType == "":
                        letCallCtorType = letCallCtorHead
                    if PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,
                                                                     typedFn,
                                                                     irFunction,
                                                                     PrimaryBodyIrCallFullText(stmt),
                                                                     stmt.rhsNodeIndex,
                                                                     letCallCtorType,
                                                                     stmt.sourcePath,
                                                                     stmt.lineNumber,
                                                                     slotId,
                                                                     stmt.lineNumber,
                                                                     callOrdinal):
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_agg_ctor function={typedFn.functionName} line={stmt.lineNumber}")
                        nextOpIndex = nextOpIndex + 1
                        continue
            # 标量三元 `let x = cond ? a : f()`(i32/i64)：let_call 孪生把 callTarget
            # 当成被选中臂的调用，真正的三元体在同行 local_decl/assign 孪生上
            # (assignValueOpKind=LocalBoolEnumTernary，surfaceText 完整三元)。找到孪生
            # 即用其完整 surface 路由到真分支下降——只执行被选中臂，根除"急切两臂求值"
            # miscompile(未被选中臂的调用不再无条件执行、不冲掉 cond 槽)。
            if slotId >= 0 &&
               len(stmt.bindingName) > 0 &&
               (PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI64Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalF64Tag):
                var letCallScalarTernText = ""
                var letCallScalarTernNodeIndex: int32 = -1
                for letCallScalarTernScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallScalarTernScan = sameLineOrder[letCallScalarTernScanP]
                    let letCallScalarTernTwin = irFunction.statements[letCallScalarTernScan]
                    if letCallScalarTernTwin.bindingName == stmt.bindingName &&
                       letCallScalarTernTwin.assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary &&
                       texpr.TypedExprFindTopLevelTextToken(strutil.Strip(letCallScalarTernTwin.surfaceText), "?") > 0 &&
                       PrimaryBodyIrTextHasRealCallSurface(strutil.Strip(letCallScalarTernTwin.surfaceText)):
                        letCallScalarTernText = strutil.Strip(letCallScalarTernTwin.surfaceText)
                        letCallScalarTernNodeIndex = letCallScalarTernTwin.rhsNodeIndex
                        break
                if letCallScalarTernText != "" &&
                   PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,
                                                              typedFn,
                                                              irFunction,
                                                              stmt.sourcePath,
                                                              stmt.lineNumber,
                                                              letCallScalarTernNodeIndex,
                                                              letCallScalarTernText,
                                                              slotId,
                                                              PrimaryBodyIrSlotType(bodyIR, slotId),
                                                              callOrdinal,
                                                              currentBlockStart):
                    nextOpIndex = nextOpIndex + 1
                    continue
            # str 三元 `let x = Len(s) > 0 ? a : b`：let_call 孪生把 callTarget 当成 Len，
            # 而真正的三元体在同行 local_decl 孪生上（assignValueOpKind=LocalBoolEnumTernary，
            # surfaceText 是完整三元，arms 在 assignValue*/conditionRhsText）。slotId 此时已
            # 按绑定真实类型 str 建好；找到该孪生即用其完整 surface 路由到 str 三元 select
            # 处理器（条件 Len(s)>0 由 EmitConditionOps 正常下降），而不是当成 Len 取长度。
            if slotId >= 0 &&
               len(stmt.bindingName) > 0 &&
               PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalStrTag:
                var letCallStrTernText = ""
                var letCallStrTernNodeIndex: int32 = -1
                for letCallStrTernScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallStrTernScan = sameLineOrder[letCallStrTernScanP]
                    let letCallStrTernTwin = irFunction.statements[letCallStrTernScan]
                    if letCallStrTernTwin.bindingName == stmt.bindingName &&
                       letCallStrTernTwin.assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary &&
                       texpr.TypedExprFindTopLevelTextToken(strutil.Strip(letCallStrTernTwin.surfaceText), "?") > 0:
                        letCallStrTernText = strutil.Strip(letCallStrTernTwin.surfaceText)
                        letCallStrTernNodeIndex =
                            letCallStrTernTwin.rhsNodeIndex
                        break
                if letCallStrTernText != "" &&
                   PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          stmt,
                                                          letCallStrTernNodeIndex,
                                                          letCallStrTernText,
                                                          slotId,
                                                          callOrdinal,
                                                          currentBlockStart):
                    nextOpIndex = nextOpIndex + 1
                    continue
            if slotId >= 0 &&
               stmt.callArgCount == 1 &&
               PrimaryBodyIrCallTargetIsLen(stmt.callCallee,
                                            stmt.callTarget,
                                            stmt.surfaceText):
                if !PrimaryBodyIrAppendStrLenArgValue(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering.typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      stmt.sourcePath,
                                                      stmt.lineNumber,
                                                      stmt.callArgsText,
                                                      slotId):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 622,
                                                 0)
                else:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_strlen function={typedFn.functionName} line={stmt.lineNumber}")
                nextOpIndex = nextOpIndex + 1
                continue
            if stmt.callCallee == "StrDataPtr" ||
               stmt.callCallee == "RawmemAsVoid" ||
               stmt.callTarget == "StrDataPtr" ||
               stmt.callTarget == "RawmemAsVoid" ||
               PrimaryCallTargetTailName(stmt.callTarget) == "StrDataPtr" ||
               PrimaryCallTargetTailName(stmt.callTarget) == "RawmemAsVoid" ||
               stmt.surfaceText == "StrDataPtr" ||
               stmt.surfaceText == "RawmemAsVoid":
                var strDataArgText = stmt.callArgsText
                var strDataIndexRoot = ""
                var strDataIndexText = ""
                if PrimaryBodyIrIndexExprParts(stmt.callArgsText,
                                               strDataIndexRoot,
                                               strDataIndexText):
                    let strDataRootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strDataIndexRoot)
                    if strDataRootSlot >= 0 &&
                       strDataRootSlot < bodyIR.localSlots.len &&
                       bodyIR.localSlots[strDataRootSlot].typeKind == coreir.LocalAggregateTag:
                        let strDataIndexSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                         slotNames,
                                                                                         varI32ParamNames,
                                                                                         lowering.typedIr,
                                                                                         typedFn,
                                                                                         irFunction,
                                                                                         stmt.sourcePath,
                                                                                         stmt.lineNumber,
                                                                                         strDataIndexText,
                                                                                         coreir.LocalI32Tag)
                        let strDataValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                             slotNames,
                                                                             stmt.callArgsText,
                                                                             coreir.LocalStrTag)
                        if strDataIndexSlot >= 0 && strDataValueSlot >= 0:
                            var strDataLoadOp: coreir.BodyOp
                            strDataLoadOp.kind = coreir.BodyOpIndexedLoadTag
                            strDataLoadOp.target = strDataValueSlot
                            add(strDataLoadOp.operands, strDataRootSlot)
                            add(strDataLoadOp.operands, strDataValueSlot)
                            add(strDataLoadOp.operands, strDataIndexSlot)
                            add(strDataLoadOp.operands, 24)
                            add(strDataLoadOp.operands, 1)
                            let _ = coreir.BodyIRAppendOp(bodyIR, strDataLoadOp)
                            strDataArgText = stmt.callArgsText
                var strDataPtrOk = false
                if stmt.callCallee == "RawmemAsVoid" ||
                   stmt.callTarget == "RawmemAsVoid" ||
                   PrimaryCallTargetTailName(stmt.callTarget) == "RawmemAsVoid" ||
                   stmt.surfaceText == "RawmemAsVoid":
                    strDataPtrOk = PrimaryBodyIrAppendRawmemAsVoidValue(bodyIR,
                                                                        slotNames,
                                                                        strDataArgText,
                                                                        slotId)
                else:
                    strDataPtrOk = PrimaryBodyIrAppendStrDataPtrValue(bodyIR,
                                                                      slotNames,
                                                                      strDataArgText,
                                                                      slotId)
                if !strDataPtrOk:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 621,
                                                 0)
                else:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_strdataptr function={typedFn.functionName} line={stmt.lineNumber}")
                nextOpIndex = nextOpIndex + 1
                continue
            if letCallDerefWidth > 0 &&
               slotId >= 0 &&
               len(targetStr) > 0 &&
               !PrimaryObjectCallTargetIsPureCast(targetStr):
                let letCallDerefPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                        slotNames,
                                                                        Fmt"{stmt.bindingName}#deref_ptr#{stmt.lineNumber}",
                                                                        coreir.LocalPtrTag)
                if letCallDerefPtrSlot >= 0:
                    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                      slotNames,
                                                      lowering,
                                                      typedFn,
                                                      irFunction,
                                                      stmt,
                                                      letCallDerefPtrSlot,
                                                      varI32ParamNames,
                                                      callOrdinal,
                                                      currentBlockStart)
                    var letCallDerefOp: coreir.BodyOp
                    letCallDerefOp.kind = coreir.BodyOpLoadLocalTag
                    letCallDerefOp.target = slotId
                    if letCallDerefWidth == 1:
                        add(letCallDerefOp.operands, coreir.BodyLoadLocalPtrDerefU8Tag)
                    else:
                        add(letCallDerefOp.operands, coreir.BodyLoadLocalPtrDerefI32Tag)
                    add(letCallDerefOp.operands, letCallDerefPtrSlot)
                    add(letCallDerefOp.operands, letCallDerefWidth)
                    let _ = coreir.BodyIRAppendOp(bodyIR, letCallDerefOp)
                    nextOpIndex = nextOpIndex + 1
                    continue
            if len(targetStr) > 0 &&
               !PrimaryObjectCallTargetIsPureCast(targetStr) &&
               slotId >= 0 &&
               slotId < bodyIR.localSlots.len &&
               stmt.rhsNodeIndex >= 0 &&
               stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalInvalidTag:
                PrimaryBodyIrNodeEvalMissOpReset()
                let letCallExprSlotKind = PrimaryBodyIrSlotType(bodyIR, slotId)
                let letCallExprProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering.typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.rhsNodeIndex)
                var letCallExprReady = false
                if letCallExprProbeKind >= 0:
                    if letCallExprSlotKind == coreir.LocalStrTag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalStrTag
                    elif letCallExprSlotKind == coreir.LocalI32Tag:
                        # 探针对跨模块标量返回 call 保守把结果定成 I64(probeKind=6,
                        # 对真返 i32 的 bytesLen/elfAlign 亦然);而绑定槽 kind(来自
                        # 绑定类型推断)是权威类型——`let x = BytesLen(buf)` 的 x 实为
                        # i32。AppendCallExprNodeToSlot 按槽 kind 存(i32 槽存结果寄存器
                        # 低 32 位=正确收窄,与文本路径 i64→i32 绑定同款)。故 I32 槽
                        # 接受 I64 探针,镜像下方 I64 槽接受 I32 widening 的对称放行,
                        # 否则 `let textSize = BytesLen(...)` 整条落 letcall_call_shape。
                        letCallExprReady = letCallExprProbeKind == coreir.LocalI32Tag ||
                                           letCallExprProbeKind == coreir.LocalI64Tag
                    elif letCallExprSlotKind == coreir.LocalI64Tag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalI32Tag ||
                                           letCallExprProbeKind == coreir.LocalI64Tag
                    elif letCallExprSlotKind == coreir.LocalF64Tag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalF64Tag
                    elif letCallExprSlotKind == coreir.LocalPtrTag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalPtrTag ||
                                           letCallExprProbeKind == coreir.LocalI64Tag
                    elif letCallExprSlotKind == coreir.LocalAggregateTag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalAggregateTag
                let letCallExprEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                var letCallExprDone = false
                if letCallExprReady:
                    letCallExprDone = PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                            slotNames,
                                                                            lowering,
                                                                            typedFn,
                                                                            irFunction,
                                                                            varI32ParamNames,
                                                                            stmt.rhsNodeIndex,
                                                                            slotId,
                                                                            stmt.lineNumber,
                                                                            callOrdinal)
                if letCallExprDone:
                    nextOpIndex = nextOpIndex + 1
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call function={typedFn.functionName} line={stmt.lineNumber}")
                    continue
                if PrimaryBodyIrNodeEvalCallEmitCountNow() != letCallExprEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var letCallExprMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                    if letCallExprMissOpText == "":
                        letCallExprMissOpText = "letcall_call_shape"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={letCallExprMissOpText} entry=let_call function={typedFn.functionName} line={stmt.lineNumber}")
            # let_call 把 callTarget 设成内联算术表达式里的"第一个调用"(如
            # `let r = (c?f():g()) + (c?f():g())` 的 callTarget=f)，下面的
            # AppendCallOp 兜底只发首个调用、静默丢掉其余操作数与 `+`(广谱
            # miscompile)。同行 local_decl/assign 孪生携带**完整 surface**且
            # callTarget 为空；当该完整面根为顶层二元算术(非整调用)且含真调用
            # 时，经真分支臂值求值器(独立栈槽承载跨调用活值)整体降入 slotId，
            # 根除"内联三元-调用相加只返回左操作数"。
            if slotId >= 0 &&
               len(stmt.bindingName) > 0 &&
               (PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI64Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalF64Tag):
                var letCallBinSurface = ""
                var letCallBinNodeIndex: int32 = -1
                for letCallBinScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallBinScan = sameLineOrder[letCallBinScanP]
                    let letCallBinTwin = irFunction.statements[letCallBinScan]
                    if letCallBinTwin.bindingName != stmt.bindingName:
                        continue
                    if letCallBinTwin.kind != texpr.TypedExprIrStmtLocalDecl &&
                       letCallBinTwin.kind != texpr.TypedExprIrStmtAssign:
                        continue
                    let letCallBinText = strutil.Strip(letCallBinTwin.surfaceText)
                    if letCallBinText == "":
                        continue
                    if !PrimaryBodyIrTextHasRealCallSurface(letCallBinText):
                        continue
                    if texpr.TypedExprFindTopLevelTextToken(letCallBinText, "?") > 0:
                        continue
                    let letCallBinStripped = PrimaryBodyIrStripOuterParens(letCallBinText)
                    if texpr.TypedExprFindTopLevelBitwiseTextToken(letCallBinStripped, "|") <= 0 &&
                       texpr.TypedExprFindTopLevelBitwiseTextToken(letCallBinStripped, "^") <= 0 &&
                       texpr.TypedExprFindTopLevelBitwiseTextToken(letCallBinStripped, "&") <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '+') <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '-') <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '*') <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '/') <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '%') <= 0:
                        continue
                    letCallBinSurface = letCallBinStripped
                    letCallBinNodeIndex = letCallBinTwin.rhsNodeIndex
                    break
                if letCallBinSurface != "" &&
                   PrimaryBodyIrAppendScalarTernaryArmValue(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,
                                                            typedFn,
                                                            irFunction,
                                                            stmt.sourcePath,
                                                            stmt.lineNumber,
                                                            letCallBinNodeIndex,
                                                            letCallBinSurface,
                                                            slotId,
                                                            PrimaryBodyIrSlotType(bodyIR, slotId),
                                                            callOrdinal,
                                                            currentBlockStart):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_bin_arith function={typedFn.functionName} line={stmt.lineNumber}")
                    nextOpIndex = nextOpIndex + 1
                    continue
            # `let r = f((cond ? call() : call()), ...)`：let_call 的 callTarget 取成
            # 三元臂里的内层调用，AppendCallOp 兜底只发首个内层调用、丢掉整个三元实
            # 参（外层调用首实参槽未写=栈垃圾，nested_ternary_call_arg）。同行孪生
            # decl/assign 携带完整外层调用面：把含真调用臂的三元实参以 CBR 块三元
            # （仅跑被选中臂）物化进临时槽、按名替换，再整调用下降入 slotId。
            if slotId >= 0 &&
               len(stmt.bindingName) > 0 &&
               (PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI64Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalF64Tag):
                var letCallTernArgSurface = ""
                var letCallTernArgNodeIndex: int32 = -1
                for letCallTernScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallTernScan = sameLineOrder[letCallTernScanP]
                    let letCallTernTwin = irFunction.statements[letCallTernScan]
                    if letCallTernTwin.bindingName != stmt.bindingName:
                        continue
                    if letCallTernTwin.kind != texpr.TypedExprIrStmtLocalDecl &&
                       letCallTernTwin.kind != texpr.TypedExprIrStmtAssign:
                        continue
                    let letCallTernText = strutil.Strip(letCallTernTwin.surfaceText)
                    if letCallTernText == "":
                        continue
                    if texpr.TypedExprFindTopLevelTextToken(letCallTernText, "?") > 0:
                        continue
                    letCallTernArgSurface = letCallTernText
                    letCallTernArgNodeIndex =
                        letCallTernTwin.rhsNodeIndex
                    break
                if letCallTernArgSurface != "":
                    var letCallTernArgChanged = false
                    let letCallTernArgRewritten = PrimaryBodyIrHoistCallArmedTernaryArgs(bodyIR,
                                                                                         slotNames,
                                                                                         varI32ParamNames,
                                                                                         lowering,
                                                                                         typedFn,
                                                                                         irFunction,
                                                                                         stmt.sourcePath,
                                                                                         stmt.lineNumber,
                                                                                         letCallTernArgNodeIndex,
                                                                                         letCallTernArgSurface,
                                                                                         callOrdinal,
                                                                                         currentBlockStart,
                                                                                         letCallTernArgChanged)
                    if letCallTernArgChanged &&
                       PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                              slotNames,
                                                              lowering,
                                                              typedFn,
                                                              irFunction,
                                                              varI32ParamNames,
                                                              letCallTernArgRewritten,
                                                              slotId,
                                                              stmt.lineNumber,
                                                              letCallTernArgNodeIndex,
                                                              callOrdinal):
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_tern_arg function={typedFn.functionName} line={stmt.lineNumber}")
                        nextOpIndex = nextOpIndex + 1
                        continue
            if len(targetStr) > 0 &&
               stmt.callArgCount == 0 &&
               slotId >= 0 &&
               PrimaryBodyIrAssignZeroConstructorMatches(bodyIR,
                                                         lowering.typedIr,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         PrimaryBodyIrCallFullText(stmt),
                                                         slotId) &&
               PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                slotNames,
                                                slotId,
                                                callOrdinal):
                nextOpIndex = nextOpIndex + 1
                continue
            if len(targetStr) > 0:
                if PrimaryObjectCallTargetIsPureCast(targetStr):
                    continue
                let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                  slotNames,
                                                  lowering,
                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  slotId,
                                                  varI32ParamNames,
                                                  callOrdinal,
                                                  currentBlockStart)
                nextOpIndex = nextOpIndex + 1
            else:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             62,
                                             0)
                nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtCall:
            if PrimaryBodyIrIntInList(callFeederEmittedIndexes, stmtIndex):
                continue
            if PrimaryBodyIrHasPreviousDuplicateWholeCall(irFunction.statements, stmtIndex):
                nextOpIndex = nextOpIndex + 1
                continue
            if stmt.callKind == texpr.TypedExprCallBuiltin &&
               (stmt.callCallee == "add" || stmt.callCallee == "Add"):
                var seqAddTypedContract: bool
                var seqAddNodeProbeHit: bool
                var seqAddTypeMismatch: bool
                let seqAddOutcome = PrimaryBodyIrAppendSeqGeneralAddBuiltin(bodyIR,
                                                                             slotNames,
                                                                             lowering,
                                                                             typedFn,
                                                                             irFunction,
                                                                             varI32ParamNames,
                                                                             stmt,
                                                                             callOrdinal,
                                                                             seqAddTypedContract,
                                                                             seqAddNodeProbeHit,
                                                                             seqAddTypeMismatch)
                let seqAddOwned = seqAddOutcome != PrimaryBodyIrSeqAddOutcomeNotOwned
                PrimaryBodyIrRecordSeqAddReceipt(B2PrimaryBodyIrNodeEvalOnlyActive(),
                                                 seqAddOutcome,
                                                 seqAddTypedContract,
                                                 seqAddNodeProbeHit,
                                                 seqAddTypeMismatch,
                                                 seqAddCandidateCountOut,
                                                 seqAddTypedContractCountOut,
                                                 structuredSeqAddConsumeCountOut,
                                                 seqAddNodeProbeHitCountOut,
                                                 seqAddTypeMismatchCountOut,
                                                 seqAddLegacyTextConsumeCountOut,
                                                 seqAddNodeEvalGapCountOut)
                if !seqAddOwned:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 631,
                                                 0)
                if seqAddNodeProbeHit:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=seq_add function={typedFn.functionName} line={stmt.lineNumber}")
                elif !seqAddOwned:
                    let _ = PrimaryBodyIrNodeEvalMissAt("seq_add_emit")
                nextOpIndex = nextOpIndex + 1
                continue
            # seqs.Add(seq, val): the qualified std/seqs.cheng `Add` overload
            # resolves as a plain call (callKind != Builtin, callee/tail == "Add"),
            # unlike the lowercase `add` builtin. The cold path inlines the
            # seq-append builtin at the call site (stage3 output carries no
            # std_seqs symbol); mirror that here so the emit does not reference a
            # non-existent _std_seqs__Add symbol. Anchored on callTargetSourcePath
            # == std/seqs.cheng so a user-defined Add in another module is NOT
            # captured. The structured contract owns both successful lowering and
            # hard failure; only NotOwned may fall through to the generic call.
            if (stmt.callCallee == "Add" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "Add") &&
               stmt.callArgCount == 2 &&
               strings.HasSuffix(stmt.callTargetSourcePath, "std/seqs.cheng"):
                var seqsAddTypedContract: bool
                var seqsAddNodeProbeHit: bool
                var seqsAddTypeMismatch: bool
                let seqsAddOutcome = PrimaryBodyIrAppendSeqGeneralAddBuiltin(bodyIR,
                                                                              slotNames,
                                                                              lowering,
                                                                              typedFn,
                                                                              irFunction,
                                                                              varI32ParamNames,
                                                                              stmt,
                                                                              callOrdinal,
                                                                              seqsAddTypedContract,
                                                                              seqsAddNodeProbeHit,
                                                                              seqsAddTypeMismatch)
                let seqsAddOwned = seqsAddOutcome != PrimaryBodyIrSeqAddOutcomeNotOwned
                PrimaryBodyIrRecordSeqAddReceipt(B2PrimaryBodyIrNodeEvalOnlyActive(),
                                                 seqsAddOutcome,
                                                 seqsAddTypedContract,
                                                 seqsAddNodeProbeHit,
                                                 seqsAddTypeMismatch,
                                                 seqAddCandidateCountOut,
                                                 seqAddTypedContractCountOut,
                                                 structuredSeqAddConsumeCountOut,
                                                 seqAddNodeProbeHitCountOut,
                                                 seqAddTypeMismatchCountOut,
                                                 seqAddLegacyTextConsumeCountOut,
                                                 seqAddNodeEvalGapCountOut)
                if seqsAddOwned:
                    if seqsAddNodeProbeHit:
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=seq_add function={typedFn.functionName} line={stmt.lineNumber}")
                    nextOpIndex = nextOpIndex + 1
                    continue
            # setLen(seq, n): a seq-resize builtin. Like add, it can reach the
            # dispatch either tagged TypedExprCallBuiltin or — when it resolved
            # against the std/seqs.cheng setLen overload — as a plain call whose
            # callee/target tail is "setLen"; both forms lower to the same bridge.
            # The seq lowering is attempted inside the guard so a non-seq target
            # named setLen falls through to the generic call path (mirrors add).
            if (stmt.callCallee == "setLen" ||
                stmt.callCallee == "SetLen" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "setLen" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "SetLen") &&
               stmt.callArgCount == 2 &&
               PrimaryBodyIrAppendSeqSetLenBuiltin(bodyIR,
                                                   slotNames,
                                                   lowering,
                                                   typedFn,
                                                   irFunction,
                                                   varI32ParamNames,
                                                   stmt,
                                                   callOrdinal):
                if PrimaryBodyIrSeqSetLenNodeProbe(lowering.typedIr, stmt.rhsNodeIndex):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=seq_setlen function={typedFn.functionName} line={stmt.lineNumber}")
                nextOpIndex = nextOpIndex + 1
                continue
            # reserve(seq, cap): a seq capacity-grow builtin. Mirrors the setLen
            # arm exactly — it can reach the dispatch tagged TypedExprCallBuiltin or,
            # when it resolved against the std/seqs.cheng reserve overload, as a plain
            # call whose callee/target tail is "reserve"/"Reserve". The seq lowering is
            # attempted inside the guard so a non-seq target named reserve falls
            # through to the generic call path (mirrors add/setLen). Without this arm
            # Reserve fell to the generic path and named the never-emitted generic
            # template, yielding an empty reloc target.
            if (stmt.callCallee == "reserve" ||
                stmt.callCallee == "Reserve" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "reserve" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "Reserve") &&
               stmt.callArgCount == 2 &&
               PrimaryBodyIrAppendSeqReserveBuiltin(bodyIR,
                                                    slotNames,
                                                    lowering,
                                                    typedFn,
                                                    irFunction,
                                                    varI32ParamNames,
                                                    stmt,
                                                    callOrdinal):
                if PrimaryBodyIrSeqReserveNodeProbe(lowering.typedIr, stmt.rhsNodeIndex):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=seq_reserve function={typedFn.functionName} line={stmt.lineNumber}")
                nextOpIndex = nextOpIndex + 1
                continue
            let targetStr = strings.CloneStr(stmt.callTarget)
            if len(targetStr) > 0:
                if PrimaryObjectCallTargetIsPureCast(targetStr):
                    continue
                if stmt.returnRoot:
                    continue
                var callLineHasReturn = false
                for lineStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let lineStmtIndex = sameLineOrder[lineStmtIndexP]
                    let lineStmt = irFunction.statements[lineStmtIndex]
                    if lineStmt.kind == texpr.TypedExprIrStmtReturn:
                        callLineHasReturn = true
                        break
                if callLineHasReturn:
                    continue
                var resultSlot: int32
                resultSlot = -1
                let fullCallText = PrimaryBodyIrCallFullText(stmt)
                var feedsSameLineAssign = false
                for assignStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let assignStmtIndex = sameLineOrder[assignStmtIndexP]
                    let assignStmt = irFunction.statements[assignStmtIndex]
                    if assignStmt.kind != texpr.TypedExprIrStmtAssign:
                        continue
                    if assignStmt.callTarget == stmt.callTarget &&
                       assignStmt.callTargetImportc == stmt.callTargetImportc &&
                       PrimaryPathNormalizedEquals(assignStmt.callTargetSourcePath,
                                                   stmt.callTargetSourcePath) &&
                       assignStmt.callArgCount == stmt.callArgCount &&
                       assignStmt.callArgsText == stmt.callArgsText:
                        feedsSameLineAssign = true
                        break
                    if strutil.Contains(assignStmt.surfaceText, fullCallText):
                        feedsSameLineAssign = true
                        break
                    # Pointer-deref store `*(... call(...)) = value`: the feeding
                    # call lives in the assign LHS (bindingName), not the RHS
                    # (surfaceText). The assign's own deref-store path re-emits the
                    # pointer call; this bare call must yield or it double-emits.
                    if fullCallText != "" &&
                       strutil.Contains(assignStmt.bindingName, fullCallText):
                        feedsSameLineAssign = true
                        break
                    if assignStmt.callTarget == stmt.callTarget &&
                       stmt.surfaceText != "" &&
                       strutil.Contains(assignStmt.surfaceText, stmt.surfaceText):
                        feedsSameLineAssign = true
                        break
                    if assignStmt.callTarget == stmt.callTarget &&
                       stmt.callTarget != "" &&
                       strutil.Contains(assignStmt.surfaceText, stmt.callTarget):
                        feedsSameLineAssign = true
                        break
                if feedsSameLineAssign:
                    continue
                # 同行 let 绑定（其 RHS 表达式文本含本调用完整文本）：该裸
                # 调用是 LocalDecl 二元/布尔表达式树的 feeder，由 LocalDecl
                # 文本路径整树降级时一次性发射。节点路径登记其为已消费并
                # 标 Own（纯 census 归属，不改 codegen），不得二次发射。
                var feedsSameLineLocalDecl = false
                for localDeclStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let localDeclStmtIndex = sameLineOrder[localDeclStmtIndexP]
                    let localDeclConsumerStmt = irFunction.statements[localDeclStmtIndex]
                    if localDeclConsumerStmt.kind != texpr.TypedExprIrStmtLocalDecl:
                        continue
                    if fullCallText != "" &&
                       strutil.Contains(localDeclConsumerStmt.surfaceText, fullCallText):
                        feedsSameLineLocalDecl = true
                        break
                if feedsSameLineLocalDecl:
                    continue
                var feedsSameLineCall = false
                var feedsSameLineCallConsumerIndex = -1
                for lineStmtIndex2P in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let lineStmtIndex2 = sameLineOrder[lineStmtIndex2P]
                    let lineStmt2 = irFunction.statements[lineStmtIndex2]
                    if lineStmtIndex2 == stmtIndex:
                        continue
                    if lineStmt2.kind != texpr.TypedExprIrStmtCall &&
                       lineStmt2.kind != texpr.TypedExprIrStmtLetCall:
                        continue
                    if strutil.Contains(lineStmt2.callArgsText, fullCallText):
                        feedsSameLineCall = true
                        feedsSameLineCallConsumerIndex = lineStmtIndex2
                        break
                if feedsSameLineCall:
                    if B2PrimaryObjectCallTargetIsBuiltin(stmt.callTarget):
                        # Builtin feeders (Len/StrDataPtr/...) inline at the
                        # consumer's arg resolution; a real call op would
                        # have no reloc target.
                        continue
                    if feedsSameLineCallConsumerIndex < stmtIndex:
                        continue
                    let callResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                    resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                                    fullCallText,
                                                                    callResultType)
                # 批次6e：独立裸调用（结果丢弃且本行无其他调用语句——嵌套
                # 实参调用由节点树整体求值，孪生 feeder 行存在时让位文本
                # 路径以保调用单发）已节点化且裸调用探针可降时，经节点
                # CallExpr 发射器降（resultSlot=-1 丢弃协议）。
                if resultSlot < 0 &&
                   stmt.rhsNodeIndex >= 0 &&
                   stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                   lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr:
                    var bareCallHasSiblingCall = false
                    var bareCallCoveredFeederIndexes: int32[]
                    bareCallCoveredFeederIndexes = []
                    for bareCallScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                        let bareCallScan = sameLineOrder[bareCallScanP]
                        if bareCallScan == stmtIndex:
                            continue
                        let bareCallScanStmt = irFunction.statements[bareCallScan]
                        if bareCallScanStmt.kind == texpr.TypedExprIrStmtCall ||
                           bareCallScanStmt.kind == texpr.TypedExprIrStmtLetCall:
                            var bareCallSiblingCovered = false
                            if bareCallScanStmt.kind == texpr.TypedExprIrStmtCall &&
                               !PrimaryBodyIrIntInList(callFeederEmittedIndexes, bareCallScan):
                                let bareCallSiblingFullText = PrimaryBodyIrCallFullText(bareCallScanStmt)
                                if bareCallSiblingFullText != "" &&
                                   strutil.Contains(stmt.callArgsText, bareCallSiblingFullText):
                                    bareCallSiblingCovered = true
                            if bareCallSiblingCovered:
                                add(bareCallCoveredFeederIndexes, bareCallScan)
                            else:
                                bareCallHasSiblingCall = true
                                break
                    if !bareCallHasSiblingCall:
                        PrimaryBodyIrNodeEvalMissOpReset()
                        let bareCallEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                        var bareCallDone = false
                        if PrimaryBodyIrBareCallNodeEvalProbe(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,
                                                              typedFn,
                                                              irFunction,
                                                              stmt.rhsNodeIndex):
                            bareCallDone = PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering,
                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 varI32ParamNames,
                                                                                 stmt.rhsNodeIndex,
                                                                                 -1,
                                                                                 stmt.lineNumber,
                                                                                 callOrdinal)
                        if bareCallDone:
                            for bareCallCoveredIndex in 0..<bareCallCoveredFeederIndexes.len:
                                if !PrimaryBodyIrIntInList(callFeederEmittedIndexes, bareCallCoveredFeederIndexes[bareCallCoveredIndex]):
                                    add(callFeederEmittedIndexes, bareCallCoveredFeederIndexes[bareCallCoveredIndex])
                            nextOpIndex = nextOpIndex + 1
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=bare_call function={typedFn.functionName} line={stmt.lineNumber}")
                            continue
                        if PrimaryBodyIrNodeEvalCallEmitCountNow() != bareCallEmitMark:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         6101,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                            continue
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            var bareCallMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                            if bareCallMissOpText == "":
                                bareCallMissOpText = "bare_call_shape"
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={bareCallMissOpText} entry=bare_call function={typedFn.functionName} line={stmt.lineNumber}")
                # Same-line feeder calls must land before the consumer:
                # the consumer's args reference their result slots.
                for feederIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let feederIndex = sameLineOrder[feederIndexP]
                    if PrimaryBodyIrIntInList(callFeederEmittedIndexes, feederIndex):
                        continue
                    if feederIndex == stmtIndex:
                        continue
                    let feederStmt = irFunction.statements[feederIndex]
                    if feederStmt.kind != texpr.TypedExprIrStmtCall:
                        continue
                    if len(feederStmt.callTarget) <= 0:
                        continue
                    if PrimaryObjectCallTargetIsPureCast(feederStmt.callTarget):
                        continue
                    if B2PrimaryObjectCallTargetIsBuiltin(feederStmt.callTarget):
                        # Builtin feeders (Len/StrDataPtr/...) inline at the
                        # consumer's arg resolution; a real call here would
                        # have no reloc target.
                        continue
                    let feederFullText = PrimaryBodyIrCallFullText(feederStmt)
                    if feederFullText == "":
                        continue
                    if !strutil.Contains(stmt.callArgsText, feederFullText):
                        continue
                    let feederResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, feederStmt)
                    let feederResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              PrimaryBodyIrCallResultLayoutSourcePath(feederStmt),
                                                                              feederFullText,
                                                                              feederResultType)
                    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                      slotNames,
                                                      lowering,
                                                      typedFn,
                                                      irFunction,
                                                      feederStmt,
                                                      feederResultSlot,
                                                      varI32ParamNames,
                                                      callOrdinal,
                                                      currentBlockStart)
                    nextOpIndex = nextOpIndex + 1
                    add(callFeederEmittedIndexes, feederIndex)
                let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                  slotNames,
                                                  lowering,
                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  resultSlot,
                                                  varI32ParamNames,
                                                  callOrdinal,
                                                  currentBlockStart)
                # 到达此点即已由节点路径的 PrimaryBodyIrAppendCallOp 为该裸调用发射
                # 真 call op 并存入 resultSlot(同行 feeder 被同行 consumer 按同名槽
                # 引用,不二次发射)。登记节点路径已消费本语句(纯 census 归属,不改
                # codegen),否则 flush 误报 node_path_skip。镜像 feedsSameLineAssign/
                # LocalDecl 的 Own。
                nextOpIndex = nextOpIndex + 1
            else:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             63,
                                             0)
                nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtAssign:
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"assign_branch_begin function={typedFn.functionName} stmt_index={stmtIndex} line={stmt.lineNumber} field={stmt.assignFieldName}")
            var duplicateInitializedLocalDecl = false
            if stmt.assignFieldName == "":
                for initializedIndex in 0..<initializedLocalDeclNames.len:
                    if initializedIndex >= initializedLocalDeclLines.len:
                        continue
                    if initializedLocalDeclLines[initializedIndex] == stmt.lineNumber &&
                       initializedLocalDeclNames[initializedIndex] == stmt.bindingName:
                        duplicateInitializedLocalDecl = true
                        break
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"assign_duplicate_check_done function={typedFn.functionName} stmt_index={stmtIndex} duplicate={duplicateInitializedLocalDecl}")
            if duplicateInitializedLocalDecl:
                nextOpIndex = nextOpIndex + 1
                continue
            var assignLineHasReturn = false
            for checkIdxP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                let checkIdx = sameLineOrder[checkIdxP]
                let checkStmt = irFunction.statements[checkIdx]
                if checkStmt.kind == texpr.TypedExprIrStmtReturn:
                    assignLineHasReturn = true
                    break
            if assignLineHasReturn:
                nextOpIndex = nextOpIndex + 1
                continue
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"assign_append_begin function={typedFn.functionName} stmt_index={stmtIndex}")
            # Pointer-deref store LHS (`*(UInt8Ptr(...)) = v` / `*ptr = v`): never
            # mint a local slot named after the deref text. Doing so makes the
            # later FindSlotIndex in AppendI32Assign resolve a phantom local and
            # node-eval the value into it, silently dropping the store-through-
            # pointer. Skip straight to AppendI32Assign's deref-store path.
            var assignLhsIsPtrDeref = false
            if PrimaryBodyIrUInt8PtrDerefPointerText(stmt.bindingName) != "":
                assignLhsIsPtrDeref = true
            elif len(stmt.bindingName) > 1 && stmt.bindingName[0] == '*':
                assignLhsIsPtrDeref = true
            # Indexed / field LHS (`grid[0] = row`, `x.f = agg`): the aggregate
            # fast-copy below mints a phantom local named after the WHOLE LHS text
            # (`grid[0]`) and copies the RHS into it — which silently drops the
            # real element/field store (the seq-of-seq `grid[i] = row` element
            # never lands in grid.buffer). Only plain-local aggregate copies
            # (`x = y`) may take the fast path; an indexed/field destination must
            # fall through to AppendI32Assign's IndexedStore/FieldStore lowering.
            var assignLhsHasFieldOrIndex = PrimaryBodyIrTextHasFieldOrIndex(stmt.bindingName)
            if stmt.assignFieldName == "" && stmt.bindingName != "" &&
               !assignLhsIsPtrDeref && !assignLhsHasFieldOrIndex:
                let rhsExistingSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                               strutil.Strip(stmt.surfaceText))
                if rhsExistingSlot >= 0 &&
                   (PrimaryBodyIrSlotType(bodyIR, rhsExistingSlot) == coreir.LocalStrTag ||
                    PrimaryBodyIrSlotType(bodyIR, rhsExistingSlot) == coreir.LocalAggregateTag):
                    var copyTypeText = stmt.resultType
                    if copyTypeText == "" || copyTypeText == "unknown" ||
                       !B2PrimaryObjectMetadataTextStable(copyTypeText):
                        if PrimaryBodyIrSlotType(bodyIR, rhsExistingSlot) == coreir.LocalStrTag:
                            copyTypeText = "str"
                    let copyAssignSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                            slotNames,
                                                                            lowering.typedIr,
                                                                            stmt.sourcePath,
                                                                            stmt.bindingName,
                                                                            copyTypeText)
                    if copyAssignSlot >= 0 &&
                       PrimaryBodyIrSlotType(bodyIR, copyAssignSlot) == PrimaryBodyIrSlotType(bodyIR, rhsExistingSlot):
                        if copyAssignSlot != rhsExistingSlot:
                            var directCopyOp: coreir.BodyOp
                            directCopyOp.kind = coreir.BodyOpCopyLocalTag
                            directCopyOp.target = copyAssignSlot
                            add(directCopyOp.operands, rhsExistingSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, directCopyOp)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_copy_local function={typedFn.functionName} line={stmt.lineNumber}")
                        nextOpIndex = nextOpIndex + 1
                        continue
                var stringAssignSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, stmt.bindingName)
                if stringAssignSlot < 0:
                    # Only create the lhs staging slot for local bindings and
                    # params. A global lhs must not get a same-named local
                    # slot: later rhs reads of the global would resolve to the
                    # uninitialized staging slot instead of a global load.
                    var stringAssignLhsIsGlobal = false
                    if PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       stmt.lineNumber,
                                                       stmt.bindingName) == "":
                        if stmt.assignRootGlobalFlag ||
                           PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt.sourcePath, stmt.bindingName) != "" ||
                           PrimaryBodyIrTypedGlobalTypeExact(lowering.typedIr, stmt.sourcePath, stmt.bindingName) != "":
                            stringAssignLhsIsGlobal = true
                    if !stringAssignLhsIsGlobal:
                        stringAssignSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              stmt.sourcePath,
                                                                              stmt.bindingName,
                                                                              stmt.resultType)
                if stringAssignSlot >= 0 &&
                   PrimaryBodyIrSlotType(bodyIR, stringAssignSlot) == coreir.LocalStrTag:
                    var stringAssigned = false
                    if stmt.rhsNodeIndex >= 0 &&
                       stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                       !PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
                        PrimaryBodyIrNodeEvalMissOpReset()
                        if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering.typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      stmt.rhsNodeIndex) == coreir.LocalStrTag:
                            let stringAssignNodeValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                                  slotNames,
                                                                                  varI32ParamNames,
                                                                                  lowering,
                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt.rhsNodeIndex,
                                                                                  callOrdinal)
                            if stringAssignNodeValueSlot >= 0 &&
                               PrimaryBodyIrNodeEvalStore(bodyIR,
                                                          slotNames,
                                                          stringAssignSlot,
                                                          stringAssignNodeValueSlot):
                                stringAssigned = true
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_str function={typedFn.functionName} line={stmt.lineNumber}")
                    if !stringAssigned && PrimaryBodyIrTextIsStringLiteral(stmt.surfaceText):
                        stringAssigned = PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                                               slotNames,
                                                                               stmt.surfaceText,
                                                                               stringAssignSlot,
                                                                               callOrdinal)
                    elif !stringAssigned && PrimaryBodyIrTextIsStrSlice(stmt.surfaceText):
                        let sliceTempSlot = PrimaryBodyIrLowerStrSliceToSlot(bodyIR, slotNames, varI32ParamNames, lowering.typedIr, typedFn, irFunction, stmt.sourcePath, stmt.lineNumber, stmt.surfaceText, stmt.bindingName, callOrdinal)
                        if sliceTempSlot >= 0:
                            if sliceTempSlot != stringAssignSlot:
                                var sliceCopyOp: coreir.BodyOp
                                sliceCopyOp.kind = coreir.BodyOpCopyLocalTag
                                sliceCopyOp.target = stringAssignSlot
                                add(sliceCopyOp.operands, sliceTempSlot)
                                let _ = coreir.BodyIRAppendOp(bodyIR, sliceCopyOp)
                            stringAssigned = true

                    elif !stringAssigned:
                        let rhsStringSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                                     strutil.Strip(stmt.surfaceText))
                        if rhsStringSlot >= 0 &&
                           PrimaryBodyIrSlotType(bodyIR, rhsStringSlot) == coreir.LocalStrTag:
                            if rhsStringSlot != stringAssignSlot:
                                var stringCopyOp: coreir.BodyOp
                                stringCopyOp.kind = coreir.BodyOpCopyLocalTag
                                stringCopyOp.target = stringAssignSlot
                                add(stringCopyOp.operands, rhsStringSlot)
                                let _ = coreir.BodyIRAppendOp(bodyIR, stringCopyOp)
                            stringAssigned = true
                    if stringAssigned:
                        nextOpIndex = nextOpIndex + 1
                        continue
                let aggregateAssignSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, stmt.bindingName)
                # `gAgg = TypeName()` zero-constructor assign to a module GLOBAL:
                # the global has no local slot, so materialize its own slot
                # (aggregate-typed, exact size, placeKind=GlobalAddress). The
                # zero-init writer (PrimaryBodyIrAppendZeroLocalSlot) already
                # passes a GlobalAddress slot to setMem via adrp+add, so the
                # global data label — not a frame copy — is zeroed. Restricted to
                # the zero-constructor form (rhs `TypeName()`); the sret-call and
                # aggregate-copy global stores keep their honest gaps because the
                # whole-aggregate sret/copy writers below address the destination
                # stack-relatively (x8/CopyLocal), which would miss the global.
                var globalZeroCtorDestSlot = -1
                if aggregateAssignSlot < 0 &&
                   stmt.assignFieldName == "" &&
                   !PrimaryBodyIrTextHasFieldOrIndex(stmt.bindingName) &&
                   PrimaryBodyIrFindArgSlot(bodyIR, slotNames, stmt.bindingName) < 0:
                    let globalAggDestSlot = PrimaryBodyIrGlobalAggregateDestSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering.typedIr,
                                                                                 stmt.sourcePath,
                                                                                 stmt.bindingName)
                    if globalAggDestSlot >= 0 &&
                       PrimaryBodyIrSlotType(bodyIR, globalAggDestSlot) == coreir.LocalAggregateTag &&
                       PrimaryBodyIrAssignZeroConstructorMatches(bodyIR,
                                                                 lowering.typedIr,
                                                                 irFunction,
                                                                 stmt.sourcePath,
                                                                 stmt.surfaceText,
                                                                 globalAggDestSlot):
                        globalZeroCtorDestSlot = globalAggDestSlot
                if globalZeroCtorDestSlot >= 0:
                    if PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                        slotNames,
                                                        globalZeroCtorDestSlot,
                                                        callOrdinal):
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_zero_ctor_global function={typedFn.functionName} line={stmt.lineNumber}")
                        nextOpIndex = nextOpIndex + 1
                        continue
                if aggregateAssignSlot >= 0 &&
                   PrimaryBodyIrSlotType(bodyIR, aggregateAssignSlot) == coreir.LocalAggregateTag:
                    # `lhs = TypeName()` 零实参类型构造器：默认零初始化整聚合槽
                    #（含 var 形参，AppendZeroLocalSlot 经形参地址清零）。文本路径，
                    # 因 `Type()` 构造器 RHS 在前端不建节点（rhsNodeIndex==-1）。
                    if PrimaryBodyIrAssignZeroConstructorMatches(bodyIR,
                                                                 lowering.typedIr,
                                                                 irFunction,
                                                                 stmt.sourcePath,
                                                                 stmt.surfaceText,
                                                                 aggregateAssignSlot):
                        if PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                            slotNames,
                                                            aggregateAssignSlot,
                                                            callOrdinal):
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_zero_ctor function={typedFn.functionName} line={stmt.lineNumber}")
                            nextOpIndex = nextOpIndex + 1
                            continue
                    # `lhs = Ctor()/aggregateCall()` 进 LHS 本地聚合槽（非形参）：
                    # 经 CallExpr 节点发射器物化（含 Ok/Err Result 构造、sret 聚合返回）。
                    elif !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[aggregateAssignSlot]) &&
                         stmt.rhsNodeIndex >= 0 &&
                         stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                         lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr:
                        PrimaryBodyIrNodeEvalMissOpReset()
                        let aggregateAssignProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                                  slotNames,
                                                                                  varI32ParamNames,
                                                                                  lowering.typedIr,
                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt.rhsNodeIndex)
                        if aggregateAssignProbeKind == coreir.LocalAggregateTag:
                            let aggregateAssignEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                            if PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                     slotNames,
                                                                     lowering,
                                                                     typedFn,
                                                                     irFunction,
                                                                     varI32ParamNames,
                                                                     stmt.rhsNodeIndex,
                                                                     aggregateAssignSlot,
                                                                     stmt.lineNumber,
                                                                     callOrdinal):
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_ctor function={typedFn.functionName} line={stmt.lineNumber}")
                                nextOpIndex = nextOpIndex + 1
                                continue
                            if PrimaryBodyIrNodeEvalCallEmitCountNow() != aggregateAssignEmitMark:
                                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                             stmt.lineNumber,
                                                             int32(stmt.kind),
                                                             6101,
                                                             0)
                                nextOpIndex = nextOpIndex + 1
                                continue
                    # `lhs = seq[i]/字段路径/本地聚合` 聚合整体拷贝（非调用 RHS）：
                    # EvalNode 按元素/字段宽精确物化源聚合，NodeEvalStore 按精确
                    # 宽搬进 LHS 槽（本地拷贝；var 形参经地址 FieldStore）。
                    elif stmt.rhsNodeIndex >= 0 &&
                         stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                         lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr:
                        PrimaryBodyIrNodeEvalMissOpReset()
                        let aggregateCopyProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                                slotNames,
                                                                                varI32ParamNames,
                                                                                lowering.typedIr,
                                                                                typedFn,
                                                                                irFunction,
                                                                                stmt.rhsNodeIndex)
                        if aggregateCopyProbeKind == coreir.LocalAggregateTag:
                            let aggregateCopyEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                            let aggregateCopyValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                               slotNames,
                                                                               varI32ParamNames,
                                                                               lowering,
                                                                               typedFn,
                                                                               irFunction,
                                                                               stmt.rhsNodeIndex,
                                                                               callOrdinal)
                            if aggregateCopyValueSlot >= 0 &&
                               PrimaryBodyIrNodeEvalStore(bodyIR,
                                                          slotNames,
                                                          aggregateAssignSlot,
                                                          aggregateCopyValueSlot):
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_agg_copy function={typedFn.functionName} line={stmt.lineNumber}")
                                nextOpIndex = nextOpIndex + 1
                                continue
                            if PrimaryBodyIrNodeEvalCallEmitCountNow() != aggregateCopyEmitMark:
                                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                             stmt.lineNumber,
                                                             int32(stmt.kind),
                                                             6101,
                                                             0)
                                nextOpIndex = nextOpIndex + 1
                                continue
            if PrimaryBodyIrLowerJsonNestedBracketAssign(bodyIR,
                                                          slotNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          varI32ParamNames,
                                                          stmt,
                                                          stmt.lineNumber,
                                                          callOrdinal):
                nextOpIndex = nextOpIndex + 1
                continue
            if PrimaryBodyIrLowerJsonBracketAssign(bodyIR,
                                                    slotNames,
                                                    lowering,
                                                    typedFn,
                                                    irFunction,
                                                    varI32ParamNames,
                                                    stmt,
                                                    stmt.lineNumber,
                                                    callOrdinal):
                nextOpIndex = nextOpIndex + 1
                continue
            let assignI32Lowered = PrimaryBodyIrAppendI32Assign(bodyIR,
                                                                localBindingProjection,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering,
                                                                typedFn,
                                                                irFunction,
                                                                stmt,
                                                                callOrdinal,
                                                                currentBlockStart)
            if !assignI32Lowered:
                var assignDetail = 0
                if PrimaryBodyIrUInt8PtrDerefPointerText(stmt.bindingName) != "":
                    assignDetail = 701
                elif stmt.bindingName == "":
                    assignDetail = 703
                elif stmt.surfaceText == "":
                    assignDetail = 704
                # bail=0 STEP 1 诊断细化 (阶段 8 工作流):零行为变化,把 14 条 bail=0
                # 拆成 705..709 子族, 解锁下一轮按子族定向 spot-fix。所有 branch
                # 只设 assignDetail, 不改 codegen 输出。
                elif stmt.assignFieldName != "":
                    assignDetail = 705
                elif PrimaryBodyIrTextHasFieldOrIndex(stmt.bindingName):
                    assignDetail = 706
                elif PrimaryBodyIrTextHasCallSurface(stmt.surfaceText):
                    assignDetail = 707
                elif stmt.rhsNodeIndex >= 0:
                    assignDetail = 708
                else:
                    assignDetail = 709
                let assignAddPos = texpr.TypedExprFindTopLevelTextToken(stmt.surfaceText, "+")
                var assignCallRhsText = "0"
                let assignLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, stmt.bindingName)
                let assignRhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strutil.Strip(stmt.surfaceText))
                var assignLhsSlotType: int32
                var assignRhsSlotType: int32
                if assignLhsSlot >= 0:
                    assignLhsSlotType = PrimaryBodyIrSlotType(bodyIR, assignLhsSlot)
                if assignRhsSlot >= 0:
                    assignRhsSlotType = PrimaryBodyIrSlotType(bodyIR, assignRhsSlot)
                B2PrimaryObjectPlanTrace(strutil.Join(["phase=assign_fail function=",
                                                     strings.CloneStr(typedFn.functionName),
                                                     " line=",
                                                     strings.IntToStr(stmt.lineNumber),
                                                     " detail=",
                                                     strings.IntToStr(assignDetail),
                                                     " lhs=",
                                                     strings.CloneStr(stmt.bindingName),
                                                     " rhs=",
                                                     strings.CloneStr(stmt.surfaceText),
                                                     " add_pos=",
                                                     strings.IntToStr(assignAddPos),
                                                     " call_rhs=",
                                                     share(assignCallRhsText),
                                                     " lhs_slot=",
                                                     strings.IntToStr(assignLhsSlot),
                                                     " lhs_slot_type=",
                                                     strings.IntToStr(assignLhsSlotType),
                                                     " rhs_slot=",
                                                     strings.IntToStr(assignRhsSlot),
                                                     " rhs_slot_type=",
                                                     strings.IntToStr(assignRhsSlotType)], ""))
                if os.GetEnv("CHENG_X64_DBG3") != "":
                    var dbg3FieldOrIndex: int32
                    if PrimaryBodyIrTextHasFieldOrIndex(stmt.bindingName):
                        dbg3FieldOrIndex = 1
                    var dbg3IdxRoot = ""
                    var dbg3IdxText = ""
                    var dbg3IdxParts: int32
                    if PrimaryBodyIrIndexExprParts(PrimaryBodyIrCanonicalAssignLhsName(stmt.bindingName), dbg3IdxRoot, dbg3IdxText):
                        dbg3IdxParts = 1
                    let dbg3RootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, dbg3IdxRoot)
                    var dbg3FieldLen: int32 = stmt.assignFieldName.len
                    var dbg3RootLen: int32 = stmt.assignRootName.len
                    os.WriteLine(os.GetStderr(), Fmt"x64dbg3 assign_fail line={stmt.lineNumber} fn={typedFn.functionName} op={int32(stmt.assignValueOpKind)} lhs=[{stmt.bindingName}] rhs=[{stmt.surfaceText}] vlhs=[{stmt.assignValueLhsText}] vrhs=[{stmt.assignValueRhsText}] lhs_slot={assignLhsSlot} lhs_slot_type={assignLhsSlotType} foi={dbg3FieldOrIndex} idx_parts={dbg3IdxParts} idx_root=[{dbg3IdxRoot}] root_slot={dbg3RootSlot} field_len={dbg3FieldLen} aroot_len={dbg3RootLen} call_target=[{stmt.callTarget}]")
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             assignDetail,
                                             0)
            nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtReturn:
            if stmt.lineNumber == completedReturnLineNumber:
                continue
            var handledReturnCall = false
            let returnText = strings.CloneStr(stmt.surfaceText)
            var valText = ""
            if len(returnText) > 0:
                if PrimaryStartsWith(returnText, "return "):
                    let returnTextLen = len(returnText)
                    valText = strings.SliceBytes(strings.CloneStr(returnText), 7, returnTextLen - 7)
                else:
                    valText = strings.CloneStr(returnText)
                valText = strutil.Strip(valText)
            var returnDerefText = strings.CloneStr(valText)
            let returnDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(valText, "int32")
            if returnDerefCastInner != "":
                returnDerefText = strutil.Strip(returnDerefCastInner)
            # 裸 `*name` 返回按函数返回形分派宽度：ptr/i64 形让路给下方通用
            # 8 字节 deref 臂；此前无条件走 4 字节 I32 臂，64 位指针/整数被
            # 截成 32 位（gen2 驱动 argv 指针高位丢失 SIGSEGV 根因）。显式
            # int32(...) 壳与 Int32Ptr/UInt8Ptr cast 形保持原语义不动。
            var returnDerefWide = false
            if returnDerefCastInner == "" &&
               len(returnDerefText) > 1 &&
               returnDerefText[1] != '(' &&
               PrimaryBodyIrI32PtrDerefPointerText(returnDerefText) != "":
                var rdwKind: int32
                var rdwSize: int32
                var rdwAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               typedFn.returnType,
                                               rdwKind,
                                               rdwSize,
                                               rdwAlign)
                if rdwKind == coreir.LocalPtrTag || rdwKind == coreir.LocalI64Tag:
                    returnDerefWide = true
            if !returnDerefWide &&
               (PrimaryBodyIrUInt8PtrDerefPointerText(returnDerefText) != "" ||
                PrimaryBodyIrI32PtrDerefPointerText(returnDerefText) != ""):
                let returnDerefSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"#return_deref#{bodyIR.ops.len}",
                                                                    coreir.LocalI32Tag)
                var returnDerefOk = false
                if returnDerefSlot >= 0:
                    if PrimaryBodyIrUInt8PtrDerefPointerText(returnDerefText) != "":
                        returnDerefOk = PrimaryBodyIrAppendUInt8PtrDerefLoad(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             lowering.typedIr,
                                                                             stmt.sourcePath,
                                                                             returnDerefText,
                                                                             returnDerefSlot,
                                                                             callOrdinal)
                    else:
                        returnDerefOk = PrimaryBodyIrAppendI32PtrDerefLoad(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           stmt.sourcePath,
                                                                           returnDerefText,
                                                                           returnDerefSlot,
                                                                           callOrdinal)
                if returnDerefOk:
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  returnDerefSlot,
                                                  coreir.LocalI32Tag,
                                                  0,
                                                  false)
                    completedReturnLineNumber = stmt.lineNumber
                    continue
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             803,
                                             0)
                nextOpIndex = nextOpIndex + 1
                continue
            # 通用指针解引用返回：return *(call()/name)，返回类型为指针形态时
            # 发 64 位 deref load；此前该形态静默丢解引用（slot_get 返回地址而非值）。
            var returnPtrDerefInner = ""
            if len(returnDerefText) > 3 && returnDerefText[0] == '*' &&
               returnDerefText[1] == '(' &&
               returnDerefText[len(returnDerefText) - 1] == ')':
                let rpdClose = texpr.TypedExprFindMatchingParen(returnDerefText, 1)
                if rpdClose == len(returnDerefText) - 1:
                    returnPtrDerefInner = strutil.Strip(strings.SliceBytes(returnDerefText, 2, len(returnDerefText) - 3))
            if returnPtrDerefInner == "" && returnDerefWide:
                # 裸 `*name` 宽返回形（上方 I32 臂已让路）直取指针文本
                returnPtrDerefInner = PrimaryBodyIrI32PtrDerefPointerText(returnDerefText)
            if returnPtrDerefInner != "" &&
               PrimaryBodyIrWholeCallInnerForHeadSuffix(returnPtrDerefInner, "UInt64Ptr") == "":
                var rpdRetKind: int32
                var rpdRetSize: int32
                var rpdRetAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               typedFn.returnType,
                                               rpdRetKind,
                                               rpdRetSize,
                                               rpdRetAlign)
                # ptr 与 i64 同为 8 字节机器字：return *(ptrExpr)（返回 ptr）和
                # return uint64(*(ptrExpr))（int32-cast 头剥离后返回 uint64/int64）
                # 都是同一条 8 字节 deref-load，返回 term 用各自返回形态的 kind。
                if rpdRetKind == coreir.LocalPtrTag || rpdRetKind == coreir.LocalI64Tag:
                    let rpdPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                    slotNames,
                                                                    varI32ParamNames,
                                                                    lowering.typedIr,
                                                                    stmt.sourcePath,
                                                                    returnPtrDerefInner,
                                                                    callOrdinal)
                    if rpdPtrSlot >= 0:
                        let rpdValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#return_deref#{bodyIR.ops.len}",
                                                                         rpdRetKind)
                        if rpdValueSlot >= 0:
                            var rpdOp: coreir.BodyOp
                            rpdOp.kind = coreir.BodyOpLoadLocalTag
                            rpdOp.target = rpdValueSlot
                            add(rpdOp.operands, coreir.BodyLoadLocalPtrDerefU64Tag)
                            add(rpdOp.operands, rpdPtrSlot)
                            add(rpdOp.operands, 8)
                            let _ = coreir.BodyIRAppendOp(bodyIR, rpdOp)
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          rpdValueSlot,
                                                          rpdRetKind,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                            continue
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 804,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
            if len(returnText) > 0:
                # 批次6e：返回表达式已节点化且探针类标与函数返回形一致
                # （i32→i64 允许加宽）时经节点求值器产出值槽，直接接既有
                # 返回 term 管线。探针失败落回文本路径；求值在调用已发射
                # 后失败禁止落回。
                if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                    var returnNodeTypeKind: int32
                    var returnNodeTypeSize: int32
                    var returnNodeTypeAlign: int32
                    # 返回类型形状由 TypeShapeFromText 统一求（限定标量 typedef 如
                    # langintern.InternId → int32 已在 TypeShapeFromTextImpl 的限定
                    # leaf 回退里解析）。此前在这里按限定 leaf 预归一会把 seq/array
                    # 返回类型 langintern.InternId[] 的 [] 一并剥掉（leaf="InternId"
                    # →"int32"），误把聚合 seq 当标量 → 探针 Aggregate 与期望 I32 不
                    # 符整段 miss。去掉预归一,seq/标量都交给 TypeShapeFromText。
                    let returnNodeShapeType = typedFn.returnType
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   typedFn.sourcePath,
                                                   returnNodeShapeType,
                                                   returnNodeTypeKind,
                                                   returnNodeTypeSize,
                                                   returnNodeTypeAlign)
                    if returnNodeTypeKind == coreir.LocalI32Tag ||
                       returnNodeTypeKind == coreir.LocalI64Tag ||
                       returnNodeTypeKind == coreir.LocalPtrTag ||
                       returnNodeTypeKind == coreir.LocalStrTag ||
                       returnNodeTypeKind == coreir.LocalAggregateTag:
                        PrimaryBodyIrNodeEvalMissOpReset()
                        let returnNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             lowering.typedIr,
                                                                             typedFn,
                                                                             irFunction,
                                                                             stmt.rhsNodeIndex)
                        var returnNodeReady = false
                        if returnNodeProbeKind == returnNodeTypeKind:
                            returnNodeReady = true
                        elif returnNodeTypeKind == coreir.LocalI64Tag &&
                             returnNodeProbeKind == coreir.LocalI32Tag:
                            returnNodeReady = true
                        let returnNodeEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                        var returnNodeDone = false
                        # 值位短路 log-chain：return 的 LogOr/LogAnd 根含 CallExpr 时
                        # 标准探针/求值器 bail（非短路位运算会破坏短路语义）。当返回
                        # 形为 i32（bool）且整链可下降时，用短路 CBR 链发射 0/1 bool
                        # 结果槽，再接既有返回 term，避免落回文本路径。
                        if !returnNodeReady &&
                           returnNodeTypeKind == coreir.LocalI32Tag &&
                           (lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpLogAnd ||
                            lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpLogOr) &&
                           PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,
                                                           typedFn,
                                                           irFunction,
                                                           stmt.rhsNodeIndex):
                            let returnBoolChainSlot = PrimaryBodyIrAppendNodeBoolConditionChain(bodyIR,
                                                                                               slotNames,
                                                                                               varI32ParamNames,
                                                                                               lowering,
                                                                                               typedFn,
                                                                                               irFunction,
                                                                                               stmt.rhsNodeIndex,
                                                                                               callOrdinal,
                                                                                               currentBlockStart)
                            if returnBoolChainSlot >= 0:
                                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                              currentBlockStart,
                                                              returnBoolChainSlot,
                                                              returnNodeTypeKind,
                                                              0,
                                                              false)
                                returnNodeDone = true
                        if !returnNodeDone &&
                           returnNodeReady:
                            var returnNodeValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering,
                                                                            typedFn,
                                                                            irFunction,
                                                                            stmt.rhsNodeIndex,
                                                                            callOrdinal)
                            if returnNodeValueSlot >= 0 &&
                               returnNodeTypeKind == coreir.LocalI64Tag &&
                               PrimaryBodyIrSlotType(bodyIR, returnNodeValueSlot) == coreir.LocalI32Tag:
                                returnNodeValueSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                                      slotNames,
                                                                                      returnNodeValueSlot,
                                                                                      stmt.rhsNodeIndex,
                                                                                      3)
                            if returnNodeValueSlot >= 0:
                                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                              currentBlockStart,
                                                              returnNodeValueSlot,
                                                              returnNodeTypeKind,
                                                              0,
                                                              false)
                                returnNodeDone = true
                        if returnNodeDone:
                            completedReturnLineNumber = stmt.lineNumber
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=return function={typedFn.functionName} line={stmt.lineNumber}")
                            continue
                        if PrimaryBodyIrNodeEvalCallEmitCountNow() != returnNodeEmitMark:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         6101,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                            completedReturnLineNumber = stmt.lineNumber
                            continue
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            var returnNodeMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                            if returnNodeMissOpText == "":
                                returnNodeMissOpText = "return_shape"
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={returnNodeMissOpText} entry=return function={typedFn.functionName} line={stmt.lineNumber}")
                # 801 解封：`return cond ? s : "-"`（str 三元返回）。节点求值器对
                # str 三元诚实 miss（表达式层无分块上下文），此处在语句层（有
                # currentBlockStart）复用 decl 侧同款 cbr 三元下降
                # AppendStrTernaryDeclValue（真分支、仅选中臂求值、str 值按 24B
                # 整头写入目标槽——与 local_decl_str_ternary 路径值/宽语义完全同
                # 源），产值槽后接既有返回 term。嵌套 else 臂（classify 形
                # `a ? x : (b ? y : z)`）由该 helper 递归覆盖。不支持的臂形态由
                # helper 发 InvalidOp 毒标（805/806/807/809，与 decl 侧同契约），
                # 绝不落穿更弱文本路径。
                var retStrTernTypeKind: int32
                var retStrTernTypeSize: int32
                var retStrTernTypeAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               typedFn.sourcePath,
                                               typedFn.returnType,
                                               retStrTernTypeKind,
                                               retStrTernTypeSize,
                                               retStrTernTypeAlign)
                if retStrTernTypeKind == coreir.LocalStrTag:
                    let retStrTernRhs = strutil.Strip(parser.ParserStripLineComment(valText))
                    var retStrTernText = PrimaryBodyIrStripOuterParens(retStrTernRhs)
                    if texpr.TypedExprFindTopLevelTextToken(retStrTernText, "?") <= 0:
                        retStrTernText = PrimaryBodyIrIfExprToTernaryText(retStrTernText)
                    if retStrTernText != "" &&
                       texpr.TypedExprFindTopLevelTextToken(retStrTernText, "?") > 0:
                        let retStrTernSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                           slotNames,
                                                                           Fmt"#ret_str_tern#{stmt.lineNumber}",
                                                                           coreir.LocalStrTag)
                        if retStrTernSlot >= 0 &&
                           PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt,
                                                                  stmt.rhsNodeIndex,
                                                                  retStrTernText,
                                                                  retStrTernSlot,
                                                                  callOrdinal,
                                                                  currentBlockStart):
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          retStrTernSlot,
                                                          coreir.LocalStrTag,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=return_str_ternary function={typedFn.functionName} line={stmt.lineNumber}")
                            continue
                var returnRcNodeClaimsConstructor = false
                var returnRcIsErr = false
                var returnRcInnerType = ""
                var returnRcUseStmtArgs = false
                var returnRcArgStart = -1
                var returnRcArgCount = 0
                var returnRcSourcePath = strings.CloneStr(typedFn.sourcePath)
                var returnRcHead = ""
                var returnRcResultType = strings.CloneStr(typedFn.returnType)
                var returnRcContractRejected = false
                if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                    let returnRcStmtLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                    if IsOk(returnRcStmtLitRes) &&
                       PrimaryBodyIrResultConstructHead(Value(returnRcStmtLitRes), returnRcIsErr):
                        returnRcNodeClaimsConstructor = true
                for returnRcScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let returnRcScan = sameLineOrder[returnRcScanP]
                    let returnRcStmt = irFunction.statements[returnRcScan]
                    if returnRcStmt.kind != texpr.TypedExprIrStmtResultIntrinsic ||
                       !returnRcStmt.returnRoot:
                        continue
                    let returnRcDetailIsConstructor =
                        returnRcStmt.detailKind == parser.NormalizedExprDetailResultOk ||
                        returnRcStmt.detailKind == parser.NormalizedExprDetailResultErr
                    if !returnRcDetailIsConstructor:
                        continue
                    if !PrimaryBodyIrResultConstructorContract(lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                returnRcStmt):
                        returnRcContractRejected = true
                        break
                    let returnRcLit = returnRcStmt.callCallee
                    var returnRcLineInner = texpr.TypedExprResultSuccessType(returnRcStmt.resultType)
                    if returnRcLineInner == "":
                        returnRcLineInner = texpr.TypedExprResultSuccessType(typedFn.returnType)
                    if returnRcLineInner != "":
                        returnRcIsErr = returnRcLit == "Err"
                        returnRcInnerType = strings.CloneStr(returnRcLineInner)
                        returnRcUseStmtArgs = true
                        returnRcArgStart = returnRcStmt.callArgNodeStart
                        returnRcArgCount = returnRcStmt.callArgCount
                        returnRcSourcePath = strings.CloneStr(returnRcStmt.sourcePath)
                        returnRcHead = strings.CloneStr(returnRcLit)
                        returnRcResultType = strings.CloneStr(returnRcStmt.resultType)
                        if returnRcResultType == "":
                            returnRcResultType = strings.CloneStr(typedFn.returnType)
                        break
                if returnRcNodeClaimsConstructor && !returnRcUseStmtArgs:
                    returnRcContractRejected = true
                if returnRcContractRejected:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    continue
                if returnRcUseStmtArgs:
                    var returnRcTypeKind: int32
                    var returnRcTypeSizeBytes: int32
                    var returnRcTypeAlignBytes: int32
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   typedFn.sourcePath,
                                                   returnRcResultType,
                                                   returnRcTypeKind,
                                                   returnRcTypeSizeBytes,
                                                   returnRcTypeAlignBytes)
                    if returnRcTypeKind != coreir.LocalAggregateTag:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     returnRcTypeKind)
                        continue
                    let returnRcSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                          slotNames,
                                                                          lowering.typedIr,
                                                                          typedFn.sourcePath,
                                                                          Fmt"#return_result_construct#{stmt.lineNumber}",
                                                                          returnRcResultType)
                    if returnRcSlot < 0:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        continue
                    let returnRcEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                    if PrimaryBodyIrAppendResultConstructFromArgLinks(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering,
                                                                       typedFn,
                                                                       irFunction,
                                                                       returnRcSourcePath,
                                                                       stmt.lineNumber,
                                                                       returnRcHead,
                                                                       returnRcSlot,
                                                                       returnRcIsErr,
                                                                       returnRcInnerType,
                                                                       returnRcArgStart,
                                                                       returnRcArgCount,
                                                                       callOrdinal):
                        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                      currentBlockStart,
                                                      returnRcSlot,
                                                      returnRcTypeKind,
                                                      0,
                                                      false)
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    var returnRcFailureDetail: int32
                    if PrimaryBodyIrNodeEvalCallEmitCountNow() != returnRcEmitMark:
                        returnRcFailureDetail = 1
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 returnRcFailureDetail)
                    continue
            var returnRootStmtIndex: int32
            returnRootStmtIndex = -1
            for lookaheadIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                let lookaheadIndex = sameLineOrder[lookaheadIndexP]
                let lookaheadStmt = irFunction.statements[lookaheadIndex]
                if lookaheadStmt.kind != texpr.TypedExprIrStmtCall &&
                   lookaheadStmt.kind != texpr.TypedExprIrStmtLetCall:
                    continue
                if len(lookaheadStmt.callTarget) <= 0:
                    continue
                var lookaheadName = lookaheadStmt.bindingName
                if len(lookaheadName) <= 0:
                    lookaheadName = PrimaryBodyIrCallFullText(lookaheadStmt)
                if len(valText) > 0 && lookaheadName == valText:
                    returnRootStmtIndex = lookaheadIndex
                    break
                if returnRootStmtIndex < 0 && lookaheadStmt.returnRoot:
                    # Only treat the call as the return root when the whole
                    # return expression is a single call; wrapped expressions
                    # (derefs, arithmetic) must lower the full expression.
                    let rootWholeOpen = texpr.TypedExprFindWholeCallOpenParen(valText)
                    if rootWholeOpen > 0 &&
                       texpr.TypedExprFindMatchingParen(valText, rootWholeOpen) == len(valText) - 1:
                        returnRootStmtIndex = lookaheadIndex
            if returnRootStmtIndex >= 0:
                let rootStmt = irFunction.statements[returnRootStmtIndex]
                for callStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let callStmtIndex = sameLineOrder[callStmtIndexP]
                    let callStmt = irFunction.statements[callStmtIndex]
                    if callStmtIndex == returnRootStmtIndex:
                        continue
                    if callStmt.kind != texpr.TypedExprIrStmtCall &&
                       callStmt.kind != texpr.TypedExprIrStmtLetCall:
                        continue
                    var primaryColdCond17: bool
                    var primaryColdCond17Clause0: bool
                    if len(callStmt.callTarget) <= 0:
                        if len(callStmt.surfaceText) <= 0:
                            primaryColdCond17Clause0 = true
                    if primaryColdCond17Clause0:
                        primaryColdCond17 = true
                    if primaryColdCond17:
                        continue
                    var dependencyName = callStmt.bindingName
                    if len(dependencyName) <= 0:
                        dependencyName = PrimaryBodyIrCallFullText(callStmt)
                    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        callStmt.sourcePath,
                                                                        dependencyName,
                                                                        callStmt.resultType)
                    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                      slotNames,
                                                      lowering,
                                                      typedFn,
                                                      irFunction,
                                                      callStmt,
                                                      resultSlot,
                                                      varI32ParamNames,
                                                      callOrdinal,
                                                      currentBlockStart)
                    nextOpIndex = nextOpIndex + 1
                for assignDepIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let assignDepIndex = sameLineOrder[assignDepIndexP]
                    let assignDepStmt = irFunction.statements[assignDepIndex]
                    if assignDepStmt.kind != texpr.TypedExprIrStmtAssign:
                        continue
                    if assignDepStmt.assignValueOpKind == texpr.TypedExprIrOpUnsupported:
                        continue
                    var assignDepName = assignDepStmt.bindingName
                    if len(assignDepName) <= 0:
                        assignDepName = assignDepStmt.surfaceText
                    if len(assignDepName) <= 0:
                        continue
                    let lhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                           assignDepStmt.assignValueLhsText)
                    if lhsSlot < 0:
                        continue
                    let rhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                           assignDepStmt.assignValueRhsText)
                    if rhsSlot < 0:
                        continue
                    var opTypeKind = bodyIR.localSlots[lhsSlot].typeKind
                    let rhsTypeKind = bodyIR.localSlots[rhsSlot].typeKind
                    if opTypeKind != rhsTypeKind:
                        if opTypeKind == coreir.LocalI32Tag && rhsTypeKind == coreir.LocalI64Tag:
                            opTypeKind = coreir.LocalI64Tag
                        elif opTypeKind == coreir.LocalI64Tag && rhsTypeKind == coreir.LocalI32Tag:
                            opTypeKind = coreir.LocalI64Tag
                    let assignResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              assignDepStmt.sourcePath,
                                                                              assignDepName,
                                                                              assignDepStmt.resultType)
                    var binOp: coreir.BodyOp
                    binOp.kind = coreir.BodyOpBinOpTag
                    binOp.target = assignResultSlot
                    add(binOp.operands, opTypeKind)
                    add(binOp.operands, int32(assignDepStmt.assignValueOpKind))
                    add(binOp.operands, lhsSlot)
                    add(binOp.operands, rhsSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
                    nextOpIndex = nextOpIndex + 1
                var rootResultTypeKind: int32
                var rootResultTypeSizeBytes: int32
                var rootResultTypeAlignBytes: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               rootStmt.sourcePath,
                                               rootStmt.resultType,
                                               rootResultTypeKind,
                                               rootResultTypeSizeBytes,
                                               rootResultTypeAlignBytes)
                var rootResultName = rootStmt.bindingName
                if len(rootResultName) <= 0:
                    rootResultName = PrimaryBodyIrCallFullText(rootStmt)
                let rootResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        rootStmt.sourcePath,
                                                                        rootResultName,
                                                                        rootStmt.resultType)
                let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                  slotNames,
                                                  lowering,
                                                  typedFn,
                                                  irFunction,
                                                  rootStmt,
                                                  rootResultSlot,
                                                  varI32ParamNames,
                                                  callOrdinal,
                                                  currentBlockStart)
                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                              currentBlockStart,
                                              rootResultSlot,
                                              rootResultTypeKind,
                                              0,
                                              false)
                nextOpIndex = nextOpIndex + 1
                completedReturnLineNumber = stmt.lineNumber
                handledReturnCall = true
            if handledReturnCall:
                continue
            if len(returnText) <= 0:
                # Bare `return` in a void function: surface text is empty.
                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                              currentBlockStart,
                                              -1,
                                              coreir.LocalInvalidTag,
                                              0,
                                              false)
                continue
            if len(returnText) > 0:
                if PrimaryBodyIrTextHasCallSurface(valText):
                    var statementReturnFn = texpr.TypedExprIrFunction(
                        sourcePath: strings.CloneStr(typedFn.sourcePath),
                        functionName: strings.CloneStr(typedFn.functionName),
                        returnType: strings.CloneStr(typedFn.returnType),
                        resultExprClass: typedFn.resultExprClass,
                        returnExpr: strings.CloneStr(valText),
                        signatureLineNumber: typedFn.signatureLineNumber,
                        endLineNumber: typedFn.endLineNumber,
                        bodyLineNumber: stmt.lineNumber,
                        statementStart: typedFn.statementStart,
                        statementCount: typedFn.statementCount,
                        nodeStart: typedFn.nodeStart,
                        nodeCount: typedFn.nodeCount,
                        returnNodeIndex: typedFn.returnNodeIndex,
                        valueDefinitionStart: typedFn.valueDefinitionStart,
                        valueDefinitionCount: typedFn.valueDefinitionCount,
                    )
                    if PrimaryBodyIrAppendReturnCallCompareZero(bodyIR,
                                                                slotNames,
                                                                lowering,
                                                                statementReturnFn,
                                                                irFunction,
                                                                varI32ParamNames,
                                                                valText,
                                                                stmt.lineNumber,
                                                                stmt.rhsNodeIndex,
                                                                currentBlockStart,
                                                                callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    if PrimaryBodyIrAppendReturnWholeCall(bodyIR,
                                                          slotNames,
                                                          lowering,
                                                          statementReturnFn,
                                                          irFunction,
                                                          varI32ParamNames,
                                                          stmt.rhsNodeIndex,
                                                          currentBlockStart,
                                                          callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    if B2PrimaryBodyIrAppendReturnResultConstructFromSameLineStructured(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering,
                                                                            typedFn,
                                                                            irFunction,
                                                                            stmtIndex,
                                                                            sameLineOrder,
                                                                            sameLineLo,
                                                                            sameLineHi,
                                                                            currentBlockStart,
                                                                            callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    if PrimaryBodyIrAppendReturnAggregateConstructor(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,
                                                                     statementReturnFn,
                                                                     irFunction,
                                                                     valText,
                                                                     stmt.rhsNodeIndex,
                                                                     currentBlockStart,
                                                                     callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                let constVal = PrimaryBodyIrExtractIntFromText(valText)
                # The i32-const return terminator carries only a 32-bit value and
                # is materialized via a 16-bit movz; a wide literal (i64 return,
                # value outside int32 range) must NOT collapse into it or the
                # upper 16-bit groups (the movz+movk chain) are dropped. Detect
                # the full 64-bit value and route wide ones to the type-aware
                # slot path (real i64 LoadConst, 4-chunk materialize) below.
                var returnConstVal64: int64
                var returnConstFitsI32 = true
                if PrimaryBodyIrExtractInt64FromText(valText, returnConstVal64):
                    if returnConstVal64 > int64(2147483647) ||
                       returnConstVal64 < int64(0) - int64(2147483648):
                        returnConstFitsI32 = false
                if valText == "" || valText == "return":
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalInvalidTag,
                                                  0,
                                                  false)
                elif valText == "nil":
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalPtrTag,
                                                  0,
                                                  false)
                elif valText == "false":
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalI32Tag,
                                                  0,
                                                  true)
                elif valText == "true":
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalI32Tag,
                                                  1,
                                                  true)
                elif returnConstFitsI32 &&
                     (constVal != 0 || PrimaryBodyIrTextIsI32Zero(valText)):
                    B2PrimaryBodyIrAppendI32ConstReturn(
                        bodyIR,
                        slotNames,
                        currentBlockStart,
                        constVal)
                else:
                    var returnTypeKind: int32
                    var returnTypeSizeBytes: int32
                    var returnTypeAlignBytes: int32
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   typedFn.sourcePath,
                                                   typedFn.returnType,
                                                   returnTypeKind,
                                                   returnTypeSizeBytes,
                                                   returnTypeAlignBytes)
                    if B2PrimaryObjectPlanTraceActive():
                        B2PrimaryObjectPlanTrace(Fmt"phase=return_shape function={typedFn.functionName} return_type={typedFn.returnType} type_kind={returnTypeKind} ir_enum_count={lowering.typedIr.enumValueTypes.len} val={valText}")
                    let initReturnSlot = PrimaryBodyIrLocalInitValueSlot(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         typedFn.sourcePath,
                                                                         typedFn.returnType,
                                                                         returnTypeKind,
                                                                         valText, callOrdinal)
                    if initReturnSlot >= 0:
                        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                      currentBlockStart,
                                                      initReturnSlot,
                                                      returnTypeKind,
                                                      0,
                                                      false)
                    elif (returnTypeKind == coreir.LocalI32Tag ||
                          returnTypeKind == coreir.LocalI64Tag ||
                          returnTypeKind == coreir.LocalF64Tag) &&
                         texpr.TypedExprFindTopLevelTextToken(valText, "?") > 0:
                        # return cond ? a : b：eager 无分支路径(initReturnSlot)只能处理
                        # cond 是纯 i32 值的三元；cond 是比较式(a > b)或臂含真调用时
                        # 它返回 -1 落到此处。这些一律走真分支 cbr 下降——
                        # PrimaryBodyIrEmitConditionOps 正确产 cmp+csel/cbr，只执行被
                        # 选中臂，根除"return 读未初始化槽"与"急切两臂求值"两类 miscompile。
                        let retTernSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                        slotNames,
                                                                        Fmt"#return_ternary#{stmt.lineNumber}",
                                                                        returnTypeKind)
                        if retTernSlot >= 0 &&
                           PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering,
                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.sourcePath,
                                                                      stmt.lineNumber,
                                                                      stmt.rhsNodeIndex,
                                                                      valText,
                                                                      retTernSlot,
                                                                      returnTypeKind,
                                                                      callOrdinal,
                                                                      currentBlockStart):
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          retTernSlot,
                                                          returnTypeKind,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                        else:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         817,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                    elif returnTypeKind == coreir.LocalStrTag &&
                         PrimaryBodyIrTextIsStringLiteral(valText):
                        let litRetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                       slotNames,
                                                                       Fmt"#return#str_literal#{bodyIR.cstringLiterals.len}",
                                                                       coreir.LocalStrTag)
                        if litRetSlot < 0 ||
                           !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                                  slotNames,
                                                                  valText,
                                                                  litRetSlot,
                                                                  callOrdinal):
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         802,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                        else:
                            nextOpIndex = nextOpIndex + 1
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          litRetSlot,
                                                          returnTypeKind,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                    elif returnTypeKind == coreir.LocalStrTag &&
                         texpr.TypedExprFindTopLevelTextToken(PrimaryBodyIrStripOuterParens(valText), "?") > 0:
                        # return cond ? a : b(str 臂)：与 str-ternary decl(:16739)同款 cbr
                        # 真分支下降,只执行被选中臂,写 targetSlot 后 return 该槽。一并关三洞:
                        # ①Len-cond(现 bail=801)②标量-cond 泄漏(旧 else 建未初始化槽 miscompile)
                        # ③无 paren `flag ? "a" : "b"`(不进 TextHasCallSurface,旧 else 同样建空槽)。
                        # helper 遇不支持臂形态时内部 poison(805)并返 true;返 false 则本层 poison 801。
                        let retStrTernText = PrimaryBodyIrStripOuterParens(valText)
                        let retStrTernSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                           slotNames,
                                                                           Fmt"#return_str_ternary#{stmt.lineNumber}",
                                                                           coreir.LocalStrTag)
                        if retStrTernSlot >= 0 &&
                           PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt,
                                                                  stmt.rhsNodeIndex,
                                                                  retStrTernText,
                                                                  retStrTernSlot,
                                                                  callOrdinal,
                                                                  currentBlockStart):
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          retStrTernSlot,
                                                          returnTypeKind,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                        else:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         801,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                    elif PrimaryBodyIrAppendReturnScalarContext(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                stmt.sourcePath,
                                                                stmt.lineNumber,
                                                                valText,
                                                                returnTypeKind,
                                                                currentBlockStart):
                        completedReturnLineNumber = stmt.lineNumber
                    elif PrimaryBodyIrAppendReturnBoolCondition(bodyIR,
                                                                slotNames,
                                                                lowering,
                                                                typedFn,
                                                                irFunction,
                                                                stmt.sourcePath,
                                                                stmt.lineNumber,
                                                                stmt.rhsNodeIndex,
                                                                valText,
                                                                currentBlockStart,
                                                                callOrdinal,
                                                                nextOpIndex):
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    elif PrimaryBodyIrTextHasCallSurface(valText):
                        if B2PrimaryBodyIrAppendReturnResultConstructFromSameLineStructured(bodyIR,
                                                                                slotNames,
                                                                                varI32ParamNames,
                                                                                lowering,
                                                                                typedFn,
                                                                                irFunction,
                                                                                stmtIndex,
                                                                                sameLineOrder,
                                                                                sameLineLo,
                                                                                sameLineHi,
                                                                                currentBlockStart,
                                                                                callOrdinal):
                            nextOpIndex = nextOpIndex + 1
                            completedReturnLineNumber = stmt.lineNumber
                            continue
                        # bail=801 STEP 1 scaffold: encode (failIndex<<8)|failCode into detail1.
                        # STEP 1 only sets reset values at function entry; STEP 2 will populate
                        # primaryAggCtorLastFailIndex/Code at the 20 return-false sites.
                        # Until STEP 2 lands, detail1 reads (-1<<8)|0 = -256 (sentinel = scaffold active).
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     801,
                                                     PrimaryBodyIrAggCtorLastFailDetail())
                        nextOpIndex = nextOpIndex + 1
                        continue
                    else:
                        # Resolve through the context-aware scalar resolver
                        # first (ptr->field reads etc. emit their loads
                        # there); a bare find-or-create would hand the
                        # return term an uninitialized slot.
                        var valSlot: int32 = -1
                        if returnTypeKind == coreir.LocalI32Tag ||
                           returnTypeKind == coreir.LocalI64Tag ||
                           returnTypeKind == coreir.LocalF64Tag ||
                           returnTypeKind == coreir.LocalPtrTag:
                            valSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                 slotNames,
                                                                                 varI32ParamNames,
                                                                                 lowering.typedIr,
                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 stmt.sourcePath,
                                                                                 stmt.lineNumber,
                                                                                 valText,
                                                                                 returnTypeKind)
                        if valSlot < 0:
                            valSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                         slotNames,
                                                                         lowering.typedIr,
                                                                         typedFn.sourcePath,
                                                                         valText,
                                                                         typedFn.returnType)
                        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                      currentBlockStart,
                                                      valSlot,
                                                      returnTypeKind,
                                                      0,
                                                      false)
        elif stmt.kind == texpr.TypedExprIrStmtIf:
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"if_branch_begin function={typedFn.functionName} line={stmt.lineNumber} surface_len={stmt.surfaceText.len}")
            # 批次6e：条件已节点化且探针可降（i32/bool）时经节点求值器
            # 产出条件槽，分支结构复用文本路径同款单 Cbr（nonzero）管线。
            # 探针失败落回文本路径；求值在调用已发射后失败禁止落回。
            if stmt.rhsNodeIndex >= 0:
                PrimaryBodyIrNodeEvalMissOpReset()
                let ifNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering.typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 stmt.rhsNodeIndex)
                if ifNodeProbeKind == coreir.LocalI32Tag:
                    let ifNodeEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                    let ifNodeSuccessBlock = bodyIR.blocks.len + 1
                    let ifNodeCondSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering,
                                                               typedFn,
                                                               irFunction,
                                                               stmt.rhsNodeIndex,
                                                               callOrdinal)
                    if ifNodeCondSlot >= 0:
                        var ifNodeCbrTerm: coreir.BodyTerm
                        ifNodeCbrTerm.kind = coreir.BodyTermCbrTag
                        ifNodeCbrTerm.conditionKind = coreir.BodyCondLocalNonZeroTag
                        ifNodeCbrTerm.lhsSlot = ifNodeCondSlot
                        ifNodeCbrTerm.rhsSlot = -1
                        ifNodeCbrTerm.trueBlock = ifNodeSuccessBlock
                        ifNodeCbrTerm.falseBlock = -1
                        ifNodeCbrTerm.resultSlot = -1
                        let ifNodeTermIndex = coreir.BodyIRAppendTerm(bodyIR, ifNodeCbrTerm)
                        let ifNodeBlockOpCount = bodyIR.ops.len - currentBlockStart
                        let _ = coreir.BodyIRAppendBlock(bodyIR,
                                                         currentBlockStart,
                                                         ifNodeBlockOpCount,
                                                         ifNodeTermIndex)
                        currentBlockStart = bodyIR.ops.len
                        pendingCompoundFalseTerms = []
                        add(pendingCompoundFalseTerms, ifNodeTermIndex)
                        pendingFalseTerm = ifNodeTermIndex
                        pendingIfFalseBodyEnd = PrimaryBodyIrIfBodyEnd(irFunction,
                                                                               stmtIndex,
                                                                               stmtEnd)
                        add(ifEndStk, PrimaryBodyIrStructuredBodyEnd(irFunction, stmtIndex, stmtEnd))
                        add(ifSeqStk, constructSeq)
                        constructSeq = constructSeq + 1
                        add(ifIndentStk, stmt.lineIndent)
                        add(ifFalseStartStk, ifFalsePool.len)
                        add(ifFalsePool, ifNodeTermIndex)
                        add(ifJoinStartStk, ifJoinBrPool.len)
                        PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction,
                                                                       stmtIndex,
                                                                       stmtEnd,
                                                                       strings.CloneStr(PrimaryBodyIrConditionText(stmt.surfaceText)),
                                                                       callFeederEmittedIndexes)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=if_cond function={typedFn.functionName} line={stmt.lineNumber}")
                        continue
                    if PrimaryBodyIrNodeEvalCallEmitCountNow() != ifNodeEmitMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        continue
                let ifNodeRootOp = lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex]
                if ifNodeRootOp == texpr.TypedExprIrOpLogAnd ||
                   ifNodeRootOp == texpr.TypedExprIrOpLogOr ||
                   ifNodeRootOp == texpr.TypedExprIrOpLogNot:
                    if PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,
                                                       typedFn,
                                                       irFunction,
                                                       stmt.rhsNodeIndex):
                        let ifChainCount = PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, stmt.rhsNodeIndex)
                        if ifChainCount > 1:
                            let ifChainEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                            let ifChainBlocksMark = bodyIR.blocks.len
                            let ifChainSuccessBlock = bodyIR.blocks.len + ifChainCount
                            pendingCompoundFalseTerms = []
                            if PrimaryBodyIrNodeEmitCondCbrChain(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,
                                                                 typedFn,
                                                                 irFunction,
                                                                 stmt.rhsNodeIndex,
                                                                 ifChainSuccessBlock,
                                                                 -1,
                                                                 callOrdinal,
                                                                 currentBlockStart,
                                                                 pendingCompoundFalseTerms):
                                if pendingCompoundFalseTerms.len > 0:
                                    pendingFalseTerm = pendingCompoundFalseTerms[pendingCompoundFalseTerms.len - 1]
                                pendingIfFalseBodyEnd = PrimaryBodyIrIfBodyEnd(irFunction,
                                                                               stmtIndex,
                                                                               stmtEnd)
                                add(ifEndStk, PrimaryBodyIrStructuredBodyEnd(irFunction, stmtIndex, stmtEnd))
                                add(ifSeqStk, constructSeq)
                                constructSeq = constructSeq + 1
                                add(ifIndentStk, stmt.lineIndent)
                                add(ifFalseStartStk, ifFalsePool.len)
                                for ifci in 0..<pendingCompoundFalseTerms.len:
                                    add(ifFalsePool, pendingCompoundFalseTerms[ifci])
                                add(ifJoinStartStk, ifJoinBrPool.len)
                                PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction,
                                                                               stmtIndex,
                                                                               stmtEnd,
                                                                               strings.CloneStr(PrimaryBodyIrConditionText(stmt.surfaceText)),
                                                                               callFeederEmittedIndexes)
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=if_cond_chain function={typedFn.functionName} line={stmt.lineNumber}")
                                continue
                            if PrimaryBodyIrNodeEvalCallEmitCountNow() != ifChainEmitMark ||
                               bodyIR.blocks.len != ifChainBlocksMark:
                                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                             stmt.lineNumber,
                                                             int32(stmt.kind),
                                                             6101,
                                                             0)
                                continue
                            pendingCompoundFalseTerms = []
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var ifNodeMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                    if ifNodeMissOpText == "":
                        ifNodeMissOpText = "cond_shape"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={ifNodeMissOpText} entry=if_cond function={typedFn.functionName} line={stmt.lineNumber}")
            if PrimaryBodyIrAppendTypedStrLiteralCondition(bodyIR,
                                                           slotNames,
                                                           stmt,
                                                           currentBlockStart,
                                                           pendingFalseTerm):
                pendingIfFalseBodyEnd = PrimaryBodyIrIfBodyEnd(irFunction,
                                                                       stmtIndex,
                                                                       stmtEnd)
                B2PrimaryObjectPlanGuardTick()
                if B2PrimaryObjectPlanProgressEnabled():
                    B2PrimaryObjectPlanProgress(Fmt"if_branch_str_literal_done function={typedFn.functionName} line={stmt.lineNumber}")
                continue
            let condText = PrimaryBodyIrConditionText(stmt.surfaceText)
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"if_branch_cond_text function={typedFn.functionName} line={stmt.lineNumber} cond_len={condText.len}")
            let condBlockCount = PrimaryBodyIrConditionCbrBlockCount(condText)
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"if_branch_cond_blocks function={typedFn.functionName} line={stmt.lineNumber} blocks={condBlockCount}")
            if condBlockCount > 0:
                let successBlock = bodyIR.blocks.len + condBlockCount
                pendingCompoundFalseTerms = []
                if PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                                      slotNames,
                                                      lowering,
                                                      typedFn,
                                                      irFunction,
                                                      stmt.sourcePath,
                                                      stmt.lineNumber,
                                                      stmt.rhsNodeIndex,
                                                      condText,
                                                      successBlock,
                                                      -1,
                                                      callOrdinal,
                                                      nextOpIndex,
                                                      currentBlockStart,
                                                      pendingCompoundFalseTerms):
                    if pendingCompoundFalseTerms.len > 0:
                        pendingFalseTerm = pendingCompoundFalseTerms[pendingCompoundFalseTerms.len - 1]
                    pendingIfFalseBodyEnd = PrimaryBodyIrIfBodyEnd(irFunction,
                                                                           stmtIndex,
                                                                           stmtEnd)
                    B2PrimaryObjectPlanGuardTick()
                    if B2PrimaryObjectPlanProgressEnabled():
                        B2PrimaryObjectPlanProgress(Fmt"if_branch_cbr_done function={typedFn.functionName} line={stmt.lineNumber} pending={pendingFalseTerm}")
                    add(ifEndStk, PrimaryBodyIrStructuredBodyEnd(irFunction, stmtIndex, stmtEnd))
                    add(ifSeqStk, constructSeq)
                    constructSeq = constructSeq + 1
                    add(ifIndentStk, stmt.lineIndent)
                    add(ifFalseStartStk, ifFalsePool.len)
                    for ifi in 0..<pendingCompoundFalseTerms.len:
                        add(ifFalsePool, pendingCompoundFalseTerms[ifi])
                    add(ifJoinStartStk, ifJoinBrPool.len)
                    continue
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"if_branch_invalid_begin function={typedFn.functionName} line={stmt.lineNumber}")
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         83,
                                         0)
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"if_branch_invalid_done function={typedFn.functionName} line={stmt.lineNumber}")
            continue
        elif stmt.kind == texpr.TypedExprIrStmtElif:
            if ifEndStk.len > 0:
                var elifJoinBr: coreir.BodyTerm
                elifJoinBr.kind = coreir.BodyTermBrTag
                elifJoinBr.conditionKind = coreir.BodyCondInvalidTag
                elifJoinBr.lhsSlot = -1
                elifJoinBr.rhsSlot = -1
                elifJoinBr.resultSlot = -1
                elifJoinBr.trueBlock = -1
                elifJoinBr.falseBlock = -1
                let elifJoinBrIdx = coreir.BodyIRAppendTerm(bodyIR, elifJoinBr)
                let elifPrevCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, elifPrevCount, elifJoinBrIdx)
                currentBlockStart = bodyIR.ops.len
                add(ifJoinBrPool, elifJoinBrIdx)
                let elifTop = ifEndStk.len - 1
                for efi in ifFalseStartStk[elifTop]..<ifFalsePool.len:
                    if ifFalsePool[efi] >= 0 &&
                       ifFalsePool[efi] < bodyIR.terms.len &&
                       bodyIR.terms[ifFalsePool[efi]].falseBlock < 0:
                        bodyIR.terms[ifFalsePool[efi]].falseBlock = bodyIR.blocks.len
                setLen(ifFalsePool, ifFalseStartStk[elifTop])
                pendingCompoundFalseTerms = []
                pendingFalseTerm = -1
                var elifHandled = false
                if PrimaryBodyIrAppendTypedStrLiteralCondition(bodyIR,
                                                               slotNames,
                                                               stmt,
                                                               currentBlockStart,
                                                               pendingFalseTerm):
                    elifHandled = true
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=elif_str_literal function={typedFn.functionName} line={stmt.lineNumber}")
                if !elifHandled:
                    let condText = PrimaryBodyIrConditionText(stmt.surfaceText)
                    var lhsSlot: int32
                    var rhsSlot: int32
                    var cmpTag: int32
                    var elifCondReady = false
                    var elifCondPoisoned = false
                    if stmt.rhsNodeIndex >= 0:
                        PrimaryBodyIrNodeEvalMissOpReset()
                        let elifNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           typedFn,
                                                                           irFunction,
                                                                           stmt.rhsNodeIndex)
                        if elifNodeProbeKind == coreir.LocalI32Tag:
                            let elifNodeEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                            let elifNodeCondSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering,
                                                                         typedFn,
                                                                         irFunction,
                                                                         stmt.rhsNodeIndex,
                                                                         callOrdinal)
                            if elifNodeCondSlot >= 0:
                                lhsSlot = elifNodeCondSlot
                                rhsSlot = -1
                                cmpTag = coreir.BodyCondLocalNonZeroTag
                                elifCondReady = true
                                PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction,
                                                                               stmtIndex,
                                                                               stmtEnd,
                                                                               strings.CloneStr(condText),
                                                                               callFeederEmittedIndexes)
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
