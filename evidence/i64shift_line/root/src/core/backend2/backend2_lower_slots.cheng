                return PrimaryBodyIrNodeEvalMissAt("cast_arg_kind")
            return coreir.LocalPtrTag
        if probeCallHead == "IsErr" || probeCallHead == "result.IsErr":
            # IsErr 内征：纯 ok-flag 投影（无 call、无 ordinal），单一聚合实参
