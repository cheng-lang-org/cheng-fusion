                                                     probeRvKind,
                                                     probeRvSize,
                                                     probeRvOffset):
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=probe function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex)} node_type={npRt} arg_name={probeRvArgName} inner={probeRvInner}")
                return PrimaryBodyIrNodeEvalMissAt("result_project")
            if PrimaryLocalSlotSizeOf(bodyIR.localSlots[probeRvSrcSlot]) < probeRvOffset + probeRvSize:
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=probe reason=src_size function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex)} src_size={PrimaryLocalSlotSizeOf(bodyIR.localSlots[probeRvSrcSlot])} need={probeRvOffset + probeRvSize}")
                return PrimaryBodyIrNodeEvalMissAt("result_project")
