            var probeCastSourceWidth: int32
            var probeCastSourceSignedness: int32
            var probeCastTargetWidth: int32
            var probeCastTargetSignedness: int32
            var probeCastEvidenceKind: int32
            let probeCastEvidence = PrimaryBodyIrIntegerCastNodeEvidence(
                typedIr,
                nodeIndex,
                probeCastEvidenceArg,
                probeCastSourceWidth,
                probeCastSourceSignedness,
                probeCastTargetWidth,
                probeCastTargetSignedness,
                probeCastEvidenceKind)
            if probeCastEvidence < 0:
                return PrimaryBodyIrNodeEvalMissAt("cast_type_evidence")
            if probeCastEvidence > 0:
                let probeCastEvidenceArgKind = PrimaryBodyIrNodeEvalProbe(
                    bodyIR,
                    slotNames,
                    varI32ParamNames,
                    typedIr,
                    typedFn,
                    irFunction,
                    probeCastEvidenceArg)
                var probeCastExpectedArgKind = coreir.LocalI32Tag
                if probeCastSourceSignedness == 3:
                    probeCastExpectedArgKind = coreir.LocalPtrTag
                elif probeCastSourceWidth == 64:
                    probeCastExpectedArgKind = coreir.LocalI64Tag
                if probeCastEvidenceArgKind != probeCastExpectedArgKind ||
                   probeCastEvidenceKind != probeCastKind:
                    return PrimaryBodyIrNodeEvalMissAt("cast_type_evidence")
                return probeCastKind
            let probeCastArgNode = PrimaryBodyIrCastCallArgNodeIndex(typedIr, nodeIndex)
            if probeCastArgNode < 0:
                return PrimaryBodyIrNodeEvalMissAt("cast_arg_shape")
            let probeCastArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              probeCastArgNode)
            if probeCastArgKind < 0:
                return -1
