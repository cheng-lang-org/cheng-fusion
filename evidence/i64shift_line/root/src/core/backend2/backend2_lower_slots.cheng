        return coreir.LocalI32Tag
    if opKind == texpr.TypedExprIrOpLogNot:
        let probeNotKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeNotKind < 0:
            return -1
        if probeNotKind != coreir.LocalI32Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return coreir.LocalI32Tag
    if opKind == texpr.TypedExprIrOpNeg:
        var probeNegTag = coreir.LocalI32Tag
        let probeNegType = texpr.TypedExprStripVarType(npRt)
        if probeNegType == "int64":
            probeNegTag = coreir.LocalI64Tag
        elif probeNegType == "float64" || probeNegType == "f64":
            probeNegTag = coreir.LocalF64Tag
        elif probeNegType != "int32":
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let probeNegInner = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeNegInner < 0:
            return -1
        if probeNegTag == coreir.LocalI64Tag:
            if probeNegInner != coreir.LocalI32Tag && probeNegInner != coreir.LocalI64Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        elif probeNegTag == coreir.LocalF64Tag:
            if probeNegInner != coreir.LocalF64Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        elif probeNegInner != coreir.LocalI32Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return probeNegTag
    var probeBinTypeTag: int32
    var probeBinBaseOp: int32
    var probeBinIsMod: bool
    var probeBinModDiv: int32
    if PrimaryBodyIrNodeEvalBinOpMeta(opKind, probeBinTypeTag, probeBinBaseOp, probeBinIsMod, probeBinModDiv):
        let probeBinLhsKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeBinLhsKind < 0:
            return -1
        let probeBinRhsKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex))
        if probeBinRhsKind < 0:
            return -1
        if probeBinTypeTag == coreir.LocalI64Tag:
            if probeBinLhsKind != coreir.LocalI32Tag && probeBinLhsKind != coreir.LocalI64Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            if probeBinRhsKind != coreir.LocalI32Tag && probeBinRhsKind != coreir.LocalI64Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        elif probeBinTypeTag == coreir.LocalF64Tag:
            if probeBinLhsKind != coreir.LocalF64Tag || probeBinRhsKind != coreir.LocalF64Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        else:
            if probeBinLhsKind != coreir.LocalI32Tag || probeBinRhsKind != coreir.LocalI32Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return probeBinTypeTag
    if opKind == texpr.TypedExprIrOpFmt:
        var fmtProbePieceNodes: int32[]
        if !PrimaryBodyIrCollectArgLinkValueNodes(
            typedIr,
            arenamod.ArenaArrayInt32Get(typedIr.arena,
                                         typedIr.nodes2_operand0NodeIndexs,
                                         nodeIndex),
            fmtProbePieceNodes):
            return PrimaryBodyIrNodeEvalMissAt("fmt_piece_chain")
        for fmtProbePieceIndex in 0..<fmtProbePieceNodes.len:
            let fmtProbePieceKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               fmtProbePieceNodes[fmtProbePieceIndex])
            if fmtProbePieceKind < 0:
                return -1
            if fmtProbePieceKind != coreir.LocalStrTag &&
               fmtProbePieceKind != coreir.LocalI32Tag &&
               fmtProbePieceKind != coreir.LocalI64Tag:
                return PrimaryBodyIrNodeEvalMissAt("fmt_piece_kind")
        return coreir.LocalStrTag
    if opKind == texpr.TypedExprIrOpStrAdd:
        let probeStrAddLhsKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            typedFn,
                                                            irFunction,
                                                            arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeStrAddLhsKind < 0:
            return -1
        if probeStrAddLhsKind != coreir.LocalStrTag:
            return PrimaryBodyIrNodeEvalMissAt("str_add_lhs_kind")
        let probeStrAddRhsKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            typedFn,
                                                            irFunction,
                                                            arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex))
        if probeStrAddRhsKind < 0:
            return -1
        if probeStrAddRhsKind != coreir.LocalStrTag:
            return PrimaryBodyIrNodeEvalMissAt("str_add_rhs_kind")
        return coreir.LocalStrTag
    if opKind == texpr.TypedExprIrOpCallExpr:
        let probeCallHead = strings.CloneStr(npLit)
        var probeLoadTargetKind: int32
        var probeLoadKind: int32
        var probeLoadSize: int32
        if PrimaryBodyIrStdSystemLoadNodeTypeContract(typedIr,
                                                      nodeIndex,
                                                      probeLoadTargetKind,
                                                      probeLoadKind,
                                                      probeLoadSize):
            let probeLoadArgNode = PrimaryBodyIrStdSystemLoadArgNodeIndex(typedIr,
                                                                          nodeIndex)
            if probeLoadArgNode < 0 ||
               PrimaryBodyIrNodeEvalProbe(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          typedIr,
                                          typedFn,
                                          irFunction,
