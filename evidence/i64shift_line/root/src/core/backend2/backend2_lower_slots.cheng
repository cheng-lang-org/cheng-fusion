                                                         probeRvCallKindOut,
                                                         probeRvCallSize,
                                                         probeRvCallOffset):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=probe reason=call_arg function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex)} inner={probeRvCallInner}")
                    return PrimaryBodyIrNodeEvalMissAt("result_project")
                return probeRvCallKindOut
