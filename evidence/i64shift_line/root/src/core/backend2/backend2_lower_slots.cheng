            # BytesLen(b)：rawbytes.Bytes 聚合的 len@8 字段读（同款纯 FieldLoad）。
            let probeLenArgNode = PrimaryBodyIrLenCallArgNodeIndex(typedIr, nodeIndex)
            if probeLenArgNode < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let probeLenRtRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[probeLenArgNode])
            if !IsOk(probeLenRtRes) || PrimaryBodyIrLenFieldOffsetForType(Value(probeLenRtRes)) < 0:
