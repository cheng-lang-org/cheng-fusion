            if probeStrDataArgNode < 0 || probeStrDataArgNode >= typedIr.nodes2_nodeIndexs.len:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let probeStrDataArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 probeStrDataArgNode)
