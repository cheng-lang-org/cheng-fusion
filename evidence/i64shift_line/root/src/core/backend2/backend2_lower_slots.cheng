            if probeCmpLhsKind == coreir.LocalF64Tag && probeCmpRhsKind == coreir.LocalF64Tag:
                return coreir.LocalI32Tag
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if probeCmpLhsKind != coreir.LocalI32Tag && probeCmpLhsKind != coreir.LocalI64Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if probeCmpRhsKind != coreir.LocalI32Tag && probeCmpRhsKind != coreir.LocalI64Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return coreir.LocalI32Tag
