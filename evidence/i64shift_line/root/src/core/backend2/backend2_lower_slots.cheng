                    os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=probe reason=layout function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex)} call_head={npLit} inner={probeRcInner}")
                return PrimaryBodyIrNodeEvalMissAt("result_construct")
