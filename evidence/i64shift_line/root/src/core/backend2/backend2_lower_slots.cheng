            let probeIsErrArg = PrimaryBodyIrResultIsErrArgNodeIndex(typedIr, nodeIndex)
            if probeIsErrArg >= 0 && typedIr.nodes2_opKinds[probeIsErrArg] == texpr.TypedExprIrOpCallExpr:
                let probeIsErrCallKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   probeIsErrArg)
                if probeIsErrCallKind < 0:
                    return -1
                if probeIsErrCallKind != coreir.LocalAggregateTag:
                    return PrimaryBodyIrNodeEvalMissAt("call_special_head")
                return coreir.LocalI32Tag
            if PrimaryBodyIrResultIsErrSourceSlot(bodyIR, slotNames, typedIr, nodeIndex) >= 0:
                return coreir.LocalI32Tag
            return PrimaryBodyIrNodeEvalMissAt("call_special_head")
        if probeCallHead == "IsOk" || probeCallHead == "result.IsOk":
            # IsOk 内征：与 IsErr 同形态的 ok-flag 投影，单一聚合实参解析成功
            # 即降为 i32 布尔；否则落回 call_special_head。
            let probeIsOkArg = PrimaryBodyIrResultIsOkArgNodeIndex(typedIr, nodeIndex)
            if probeIsOkArg >= 0 && typedIr.nodes2_opKinds[probeIsOkArg] == texpr.TypedExprIrOpCallExpr:
                let probeIsOkCallKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  probeIsOkArg)
                if probeIsOkCallKind < 0:
                    return -1
                if probeIsOkCallKind != coreir.LocalAggregateTag:
                    return PrimaryBodyIrNodeEvalMissAt("call_special_head")
                return coreir.LocalI32Tag
            if PrimaryBodyIrResultIsOkSourceSlot(bodyIR, slotNames, typedIr, nodeIndex) >= 0:
                return coreir.LocalI32Tag
            return PrimaryBodyIrNodeEvalMissAt("call_special_head")
        if probeCallHead == "Error" || probeCallHead == "result.Error":
            # Error 内征：纯 errmsg 投影（无 call、无 ordinal），单一聚合实参
            # 解析成功即降为 str；否则落回 call_special_head。
            # call-arg 臂：errmsg 偏移先解（镜像发射器），解不出即 miss；实参调用
            # 递归探针必产 Result[T] 聚合槽再投影 errmsg。
            let probeErrorArg = PrimaryBodyIrResultErrorArgNodeIndex(typedIr, nodeIndex)
            if probeErrorArg >= 0 && typedIr.nodes2_opKinds[probeErrorArg] == texpr.TypedExprIrOpCallExpr:
                if PrimaryBodyIrResultErrorSourceErrMsgOffset(typedIr, nodeIndex) < 0:
                    return PrimaryBodyIrNodeEvalMissAt("call_special_head")
