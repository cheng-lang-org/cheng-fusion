                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 probeRcArgNodes[0])
                if probeEcCodeKind < 0:
                    return -1
                if probeEcCodeKind != coreir.LocalI32Tag:
                    return PrimaryBodyIrNodeEvalMissAt("result_construct")
