        # 字段)的 Eq/Ne 经 BodyOpCmp 降,FillCmpOp 对 Ptr 操作数置 cmpIs64(arm64
        # 35423 / x86_64 1507)发 64 位 CMP+CSET。序比较(Lt/Le/Gt/Ge)对裸指针语义
        # 无意义,仍只接受整型落 MissAt。
        if probeCmpLhsKind == coreir.LocalPtrTag && probeCmpRhsKind == coreir.LocalPtrTag &&
           (opKind == texpr.TypedExprIrOpCmpEq || opKind == texpr.TypedExprIrOpCmpNe):
            return coreir.LocalI32Tag
