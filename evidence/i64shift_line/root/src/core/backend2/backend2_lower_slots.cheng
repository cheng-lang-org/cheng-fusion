        # T78: 门从"只探真调用"扩到"调用或下标读", 理由见 HasFaultingEagerSurface。
        if PrimaryBodyIrNodeTreeHasFaultingEagerSurface(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)) ||
           PrimaryBodyIrNodeTreeHasFaultingEagerSurface(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex)):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let probeLogLhsKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeLogLhsKind < 0:
            return -1
        let probeLogRhsKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex))
        if probeLogRhsKind < 0:
            return -1
        if probeLogLhsKind != coreir.LocalI32Tag || probeLogRhsKind != coreir.LocalI32Tag:
