            var probeErrInfoBlockOffset: int32
            var probeErrInfoBlockSize: int32
            if PrimaryBodyIrResultErrInfoSourceSlot(bodyIR, slotNames, typedIr, nodeIndex) >= 0 &&
               PrimaryBodyIrResultErrInfoSourceBlock(typedIr, nodeIndex, probeErrInfoBlockOffset, probeErrInfoBlockSize):
                return coreir.LocalAggregateTag
            return PrimaryBodyIrNodeEvalMissAt("call_special_head")
