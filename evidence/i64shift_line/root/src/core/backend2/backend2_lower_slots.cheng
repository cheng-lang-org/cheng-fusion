            let probeStrDataArgLink = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)
            if probeStrDataArgLink < 0 ||
               probeStrDataArgLink >= typedIr.nodes2_nodeIndexs.len ||
               typedIr.nodes2_opKinds[probeStrDataArgLink] != texpr.TypedExprIrOpArgLink ||
               arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, probeStrDataArgLink) >= 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
