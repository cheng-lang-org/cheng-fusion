        if PrimaryBodyIrResultConstructHead(enLit, callExprIsErrHead):
            # Ok[T]/Err[T]：node.resultType 是泛型 Result[T]，临时槽须按调用头
            # 显式类型实参定形为具体 Result[innerT]（64B）。
            let callExprRcInner = PrimaryBodyIrResultConstructInnerType(enLit)
            if callExprRcInner != "":
                callExprSlotType = Fmt"Result[{callExprRcInner}]"
        let callExprValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                   slotNames,
                                                                   lowering.typedIr,
                                                                   enSrc,
                                                                   Fmt"#nev{nodeIndex}",
                                                                   callExprSlotType)
        if callExprValueSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if !PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                  slotNames,
                                                  lowering,
                                                  typedFn,
                                                  irFunction,
                                                  varI32ParamNames,
                                                  nodeIndex,
                                                  callExprValueSlot,
                                                  arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex),
                                                  callOrdinal):
            return -1
        return callExprValueSlot
    if opKind == texpr.TypedExprIrOpLocalBoolEnumTernary:
        # `cond ? then : else` 标量 select：守卫与 probe 一致（任一臂含真调用 STOP，
        # 避免 eager 求值破坏副作用/短路）。比较 op 现成产 0/1，照搬既有 declTern
        # 回退码（~11286）：delta=Sub(then,else)、scaled=Mul(cond,delta)、
        # result=Add(else,scaled)，三条 BodyOpBinOpTag。arithKind 由臂槽类（I32/I64）
        # 定，无新增 op-kind/BodyTerm。str 臂需分块（无 currentBlockStart 上下文）→
        # 诚实落 miss。
        if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)) ||
           PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex)):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let ternCondSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,
                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                 callOrdinal)
        if ternCondSlot < 0:
            return -1
        if PrimaryBodyIrSlotType(bodyIR, ternCondSlot) != coreir.LocalI32Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let ternThenSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,
                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                 callOrdinal)
        if ternThenSlot < 0:
            return -1
        let ternElseSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,
                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex),
                                                 callOrdinal)
        if ternElseSlot < 0:
            return -1
        let ternThenKind = PrimaryBodyIrSlotType(bodyIR, ternThenSlot)
        let ternElseKind = PrimaryBodyIrSlotType(bodyIR, ternElseSlot)
        if ternThenKind != ternElseKind:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if ternThenKind != coreir.LocalI32Tag && ternThenKind != coreir.LocalI64Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let ternDeltaSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}#ternd",
                                                          ternThenKind)
        let ternScaledSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#nev{nodeIndex}#terns",
                                                           ternThenKind)
        let ternResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#nev{nodeIndex}#ternr",
                                                           ternThenKind)
        if ternDeltaSlot < 0 || ternScaledSlot < 0 || ternResultSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var ternDeltaOp: coreir.BodyOp
        ternDeltaOp.kind = coreir.BodyOpBinOpTag
        ternDeltaOp.target = ternDeltaSlot
        add(ternDeltaOp.operands, ternThenKind)
        add(ternDeltaOp.operands, int32(texpr.TypedExprIrOpI32Sub))
        add(ternDeltaOp.operands, ternThenSlot)
        add(ternDeltaOp.operands, ternElseSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, ternDeltaOp)
        var ternScaledOp: coreir.BodyOp
        ternScaledOp.kind = coreir.BodyOpBinOpTag
        ternScaledOp.target = ternScaledSlot
        add(ternScaledOp.operands, ternThenKind)
        add(ternScaledOp.operands, int32(texpr.TypedExprIrOpI32Mul))
        add(ternScaledOp.operands, ternCondSlot)
        add(ternScaledOp.operands, ternDeltaSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, ternScaledOp)
        var ternResultOp: coreir.BodyOp
        ternResultOp.kind = coreir.BodyOpBinOpTag
        ternResultOp.target = ternResultSlot
        add(ternResultOp.operands, ternThenKind)
        add(ternResultOp.operands, int32(texpr.TypedExprIrOpI32Add))
        add(ternResultOp.operands, ternElseSlot)
        add(ternResultOp.operands, ternScaledSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, ternResultOp)
        return ternResultSlot
    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))

# 短路条件链：log_and/log_or 根节点按文本路径同款 Cbr 链降。每个叶子
# 在独立块内求值（含调用恰好执行一次且仅在其分支可达时执行），&& 假边
# 汇入 falseTerms（-1 哨兵延迟补丁），|| 真边直跳 successBlock。块数静态
# 可数（每叶恰一块），successBlock = 起始块号 + 链块数。
@borrows
fn PrimaryBodyIrNodeCondCbrBlockCount(typedIr: texpr.TypedExprIr,
                                       nodeIndex: int32): int32 =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return 0
    let opKind = typedIr.nodes2_opKinds[nodeIndex]
    if opKind == texpr.TypedExprIrOpLogNot:
        return PrimaryBodyIrNodeCondCbrBlockCount(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
    if opKind == texpr.TypedExprIrOpLogAnd ||
       opKind == texpr.TypedExprIrOpLogOr:
        let lhsCount = PrimaryBodyIrNodeCondCbrBlockCount(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if lhsCount <= 0:
            return 0
        let rhsCount = PrimaryBodyIrNodeCondCbrBlockCount(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex))
        if rhsCount <= 0:
            return 0
        return lhsCount + rhsCount
    return 1

@borrows
fn PrimaryBodyIrNodeCondChainProbe(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    varI32ParamNames: str[],
                                    lowering: lower.LoweringPlanStub,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        return false
    let opKind = lowering.typedIr.nodes2_opKinds[nodeIndex]
    if opKind == texpr.TypedExprIrOpLogNot:
        return PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex))
    if opKind == texpr.TypedExprIrOpLogAnd ||
       opKind == texpr.TypedExprIrOpLogOr:
        if !PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                            slotNames,
                                            varI32ParamNames,
                                            lowering,
                                            typedFn,
                                            irFunction,
                                            arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)):
            return false
        return PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex))
    return PrimaryBodyIrNodeEvalProbe(bodyIR,
                                      slotNames,
                                      varI32ParamNames,
                                      lowering.typedIr,
                                      typedFn,
                                      irFunction,
                                      nodeIndex) == coreir.LocalI32Tag

@borrows
fn PrimaryBodyIrNodeEmitCondCbrChain(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      varI32ParamNames: str[],
                                      lowering: lower.LoweringPlanStub,
                                      typedFn: texpr.TypedExprIrFunction,
                                      irFunction: lower.PrimaryObjectIrFunction,
                                      nodeIndex: int32,
                                      trueTarget: int32,
                                      falseTarget: int32,
                                      callOrdinal: var int32,
                                      currentBlockStart: var int32,
                                      falseTerms: var int32[]): bool =
    return PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                                slotNames,
                                                varI32ParamNames,
                                                lowering,
                                                typedFn,
                                                irFunction,
                                                nodeIndex,
                                                trueTarget,
                                                falseTarget,
                                                callOrdinal,
                                                currentBlockStart,
                                                falseTerms,
                                                false)

# `!(a && b)` 作 if/elif 条件:LogNot 根进不去 cond-chain 派发(门禁只认 LogAnd/LogOr),
# 落文本路径标 log_and。这里用 De Morgan 下推:negate 沿 AND/OR 互换路由下传,叶条件
# NonZero↔Zero 翻转,`-1` 哨兵恒留 falseBlock(不交换目标块,patch 不变量不破),CFG 块
# 几何对 negate 不变(BlockCount 对称),字节等价于文本路径既有正确下降。公开壳零体委托
# negate=false,5 个外部派发调用点一字不改。
@borrows
fn PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         varI32ParamNames: str[],
                                         lowering: lower.LoweringPlanStub,
                                         typedFn: texpr.TypedExprIrFunction,
                                         irFunction: lower.PrimaryObjectIrFunction,
                                         nodeIndex: int32,
                                         trueTarget: int32,
                                         falseTarget: int32,
                                         callOrdinal: var int32,
                                         currentBlockStart: var int32,
                                         falseTerms: var int32[],
                                         negate: bool): bool =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        return false
    let opKind = lowering.typedIr.nodes2_opKinds[nodeIndex]
    if opKind == texpr.TypedExprIrOpLogNot:
        return PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,
                                                    typedFn,
                                                    irFunction,
                                                    arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                    trueTarget,
                                                    falseTarget,
                                                    callOrdinal,
                                                    currentBlockStart,
                                                    falseTerms,
                                                    !negate)
    let chainTreatAsAnd = (opKind == texpr.TypedExprIrOpLogAnd && !negate) ||
                          (opKind == texpr.TypedExprIrOpLogOr && negate)
    let chainTreatAsOr = (opKind == texpr.TypedExprIrOpLogOr && !negate) ||
                         (opKind == texpr.TypedExprIrOpLogAnd && negate)
    if chainTreatAsAnd:
        let andRhsFirstBlock = bodyIR.blocks.len +
                               PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if !PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering,
                                              typedFn,
                                              irFunction,
                                              arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                              andRhsFirstBlock,
                                              falseTarget,
                                              callOrdinal,
                                              currentBlockStart,
                                              falseTerms,
                                              negate):
            return false
        return PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,
                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                 trueTarget,
                                                 falseTarget,
                                                 callOrdinal,
                                                 currentBlockStart,
                                                 falseTerms,
                                                 negate)
    if chainTreatAsOr:
        let orRhsFirstBlock = bodyIR.blocks.len +
                              PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if !PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering,
                                              typedFn,
                                              irFunction,
                                              arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                              trueTarget,
                                              orRhsFirstBlock,
                                              callOrdinal,
                                              currentBlockStart,
                                              falseTerms,
                                              negate):
            return false
        return PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,
                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                 trueTarget,
                                                 falseTarget,
                                                 callOrdinal,
                                                 currentBlockStart,
                                                 falseTerms,
                                                 negate)
    let chainLeafSlot = PrimaryBodyIrEvalNode(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering,
                                              typedFn,
                                              irFunction,
                                              nodeIndex,
                                              callOrdinal)
    if chainLeafSlot < 0:
        return false
    if PrimaryBodyIrSlotType(bodyIR, chainLeafSlot) != coreir.LocalI32Tag:
        return false
    var chainLeafTerm: coreir.BodyTerm
    chainLeafTerm.kind = coreir.BodyTermCbrTag
    if negate:
        chainLeafTerm.conditionKind = coreir.BodyCondLocalZeroTag
    else:
        chainLeafTerm.conditionKind = coreir.BodyCondLocalNonZeroTag
    chainLeafTerm.lhsSlot = chainLeafSlot
    chainLeafTerm.rhsSlot = -1
    chainLeafTerm.resultSlot = -1
    chainLeafTerm.trueBlock = trueTarget
    chainLeafTerm.falseBlock = falseTarget
    let chainLeafTermIndex = coreir.BodyIRAppendTerm(bodyIR, chainLeafTerm)
    let chainLeafOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR,
                                     currentBlockStart,
                                     chainLeafOpCount,
                                     chainLeafTermIndex)
    currentBlockStart = bodyIR.ops.len
    if falseTarget < 0:
        add(falseTerms, chainLeafTermIndex)
    return true

# 值位短路 log-chain bool 发射器：return/store 位的 LogOr/LogAnd 含 CallExpr
# 操作数不能用非短路位运算（短路语义可能跳过调用）。这里把整条链下降成
# CBR 链 → true 块存 1、false 块存 0、汇合块，返回承载 0/1 的 i32 结果槽。
# 复用 NodeEmitCondCbrChain（短路 CBR 链）+ store-1/store-0/join 模式，与文本
# 路径 PrimaryBodyIrAppendBoolConditionAssign 镜像，但全程走节点（含调用叶）。
@borrows
fn PrimaryBodyIrAppendNodeBoolConditionChain(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              lowering: lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              nodeIndex: int32,
                                              callOrdinal: var int32,
                                              currentBlockStart: var int32): int32 =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        return -1
    let chainRootOp = lowering.typedIr.nodes2_opKinds[nodeIndex]
    if chainRootOp != texpr.TypedExprIrOpLogAnd &&
       chainRootOp != texpr.TypedExprIrOpLogOr &&
       chainRootOp != texpr.TypedExprIrOpLogNot:
        return -1
    if !PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                        slotNames,
                                        varI32ParamNames,
                                        lowering,
                                        typedFn,
                                        irFunction,
                                        nodeIndex):
        return -1
    let chainBlockCount = PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, nodeIndex)
    if chainBlockCount <= 0:
        return -1
    let resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"#nev_bool{nodeIndex}",
                                                   coreir.LocalI32Tag)
    if resultSlot < 0:
        return -1
    let successBlock = bodyIR.blocks.len + chainBlockCount
    let failureBlock = successBlock + 1
    let joinBlock = successBlock + 2
    var chainFalseTerms: int32[]
    chainFalseTerms = []
    if !PrimaryBodyIrNodeEmitCondCbrChain(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          lowering,
                                          typedFn,
                                          irFunction,
                                          nodeIndex,
                                          successBlock,
                                          failureBlock,
                                          callOrdinal,
                                          currentBlockStart,
                                          chainFalseTerms):
        return -1
    var trueOp: coreir.BodyOp
    trueOp.kind = coreir.BodyOpLoadConstTag
    trueOp.target = resultSlot
    add(trueOp.operands, coreir.LocalI32Tag)
    add(trueOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, trueOp)
    var trueBr: coreir.BodyTerm
    trueBr.kind = coreir.BodyTermBrTag
    trueBr.conditionKind = coreir.BodyCondInvalidTag
    trueBr.lhsSlot = -1
    trueBr.rhsSlot = -1
    trueBr.resultSlot = -1
    trueBr.trueBlock = joinBlock
    trueBr.falseBlock = -1
    let trueTermIndex = coreir.BodyIRAppendTerm(bodyIR, trueBr)
    let trueBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, trueBlockOpCount, trueTermIndex)
    currentBlockStart = bodyIR.ops.len

    var falseOp: coreir.BodyOp
    falseOp.kind = coreir.BodyOpLoadConstTag
    falseOp.target = resultSlot
    add(falseOp.operands, coreir.LocalI32Tag)
    add(falseOp.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, falseOp)
    var falseBr: coreir.BodyTerm
    falseBr.kind = coreir.BodyTermBrTag
    falseBr.conditionKind = coreir.BodyCondInvalidTag
    falseBr.lhsSlot = -1
    falseBr.rhsSlot = -1
    falseBr.resultSlot = -1
    falseBr.trueBlock = joinBlock
    falseBr.falseBlock = -1
    let falseTermIndex = coreir.BodyIRAppendTerm(bodyIR, falseBr)
    let falseBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, falseBlockOpCount, falseTermIndex)
    currentBlockStart = bodyIR.ops.len
    return resultSlot

@borrows
fn PrimaryObjectTypedIrFieldCount(typedIr: texpr.TypedExprIr,
                                   ownerType: str,
                                   fieldName: str): int32 =
    var count: int32
    for i in 0..<typedIr.typeFieldOwnerTypes.len:
        if i >= typedIr.typeFieldNames.len:
            continue
        if typedIr.typeFieldOwnerTypes[i] == ownerType &&
           typedIr.typeFieldNames[i] == fieldName:
            count = count + 1
    return count

@borrows
fn PrimaryObjectTypedIrFieldMetric(typedIr: texpr.TypedExprIr,
                                    ownerType: str,
                                    fieldName: str,
                                    metric: str): int32 =
    for i in 0..<typedIr.typeFieldOwnerTypes.len:
        if i >= typedIr.typeFieldNames.len:
            continue
        if typedIr.typeFieldOwnerTypes[i] != ownerType:
            continue
        if typedIr.typeFieldNames[i] != fieldName:
            continue
        if metric == "type" && i < typedIr.typeFieldTypes.len:
            return 1
        if metric == "offset" && i < typedIr.typeFieldOffsetBytes.len:
            return typedIr.typeFieldOffsetBytes[i]
        if metric == "size" && i < typedIr.typeFieldSizeBytes.len:
            return typedIr.typeFieldSizeBytes[i]
        if metric == "align" && i < typedIr.typeFieldAlignBytes.len:
            return typedIr.typeFieldAlignBytes[i]
        return -1
    return -1

@borrows
fn PrimaryObjectTypedIrFieldTypeText(typedIr: texpr.TypedExprIr,
                                      ownerType: str,
                                      fieldName: str): str =
    for i in 0..<typedIr.typeFieldOwnerTypes.len:
        if i >= typedIr.typeFieldNames.len:
            continue
        if typedIr.typeFieldOwnerTypes[i] != ownerType:
            continue
        if typedIr.typeFieldNames[i] != fieldName:
            continue
        if i < typedIr.typeFieldTypes.len:
            return strings.CloneStr(typedIr.typeFieldTypes[i])
        return ""
    return ""

@borrows
fn PrimaryObjectCallTargetIsPureCast(targetRaw: str): bool =
    let target = PrimaryCallTargetTailName(targetRaw)
    if target == "int32" || target == "Int32" || target == "i32":
        return true
    if target == "int64" || target == "Int64" || target == "i64":
        return true
    if target == "uint64" || target == "UInt64" || target == "u64":
        return true
    if target == "uint32" || target == "UInt32" || target == "u32":
        return true
    if target == "uint8" || target == "UInt8" || target == "u8":
        return true
    if target == "int8" || target == "Int8" || target == "i8":
        return true
    if target == "uint16" || target == "UInt16" || target == "u16":
        return true
    if target == "int16" || target == "Int16" || target == "i16":
        return true
    if target == "int" || target == "Int":
        return true
    if target == "uint" || target == "UInt":
        return true
    if target == "char" || target == "Char":
        return true
    return false
