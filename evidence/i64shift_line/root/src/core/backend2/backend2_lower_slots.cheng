            if probeRvArgName == "":
                return PrimaryBodyIrNodeEvalMissAt("result_project")
            let probeRvSrcSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, probeRvArgName)
            if probeRvSrcSlot < 0 || probeRvSrcSlot >= bodyIR.localSlots.len:
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=probe reason=src_slot function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex)} arg={probeRvArgName}")
                return PrimaryBodyIrNodeEvalMissAt("result_project")
