                                                                slotNames,
                                                                varI32ParamNames,
                                                                typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                probeRcArgNodes[0])
            if probeRcPayloadKind < 0:
                return -1
            if probeCallHeadIsErr:
