        let probeOrdinal = PrimaryBodyIrExactCallNodeOrdinal(irFunction,
                                                              typedIr,
                                                              nodeIndex,
                                                              probeArgNodes.len)
        if probeOrdinal < 0 ||
           probeOrdinal >= irFunction.callTargets.len ||
           probeOrdinal >= irFunction.callTargetSourcePaths.len ||
           probeOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
           probeOrdinal >= irFunction.callTargetImportcFlags.len:
            return PrimaryBodyIrNodeEvalMissAt("call_ordinal")
        if irFunction.callTargets[probeOrdinal] != probeTargetName ||
           !texpr.TypedExprSourcePathsEquivalent(
               irFunction.callTargetSourcePaths[probeOrdinal],
               probeTargetSourcePath) ||
           irFunction.callTargetSignatureLineNumbers[probeOrdinal] !=
               probeTargetSignatureLine ||
           irFunction.callTargetImportcFlags[probeOrdinal] != probeTargetImportc:
            panic(Fmt"backend2: call-node/ordinal authority drift node={nodeIndex} ordinal={probeOrdinal} node_source={probeTargetSourcePath} node_target={probeTargetName} node_signature={probeTargetSignatureLine}")
        if probeResultType == "void":
            return PrimaryBodyIrNodeEvalMissAt("call_result_type")
        let probeRetSourcePath = strings.CloneStr(probeTargetSourcePath)
        var probeRetKind: int32
        var probeRetSize: int32
        var probeRetAlign: int32
        PrimaryBodyIrNodeTypeShape(typedIr,
                                   probeRetSourcePath,
                                   probeResultType,
                                   probeRetKind,
                                   probeRetSize,
                                   probeRetAlign)
        if probeRetKind != coreir.LocalI32Tag &&
           probeRetKind != coreir.LocalI64Tag &&
           probeRetKind != coreir.LocalF64Tag &&
           probeRetKind != coreir.LocalStrTag &&
           probeRetKind != coreir.LocalPtrTag &&
           probeRetKind != coreir.LocalAggregateTag:
            return PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
        if (probeRetKind == coreir.LocalAggregateTag ||
            probeRetKind == coreir.LocalStrTag) &&
           (probeRetSize <= 0 || probeRetAlign <= 0):
            return PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
        var probeStmt: lower.PrimaryObjectIrStatement
        probeStmt.sourcePath = typedFn.sourcePath
        probeStmt.callTarget = probeTargetName
        probeStmt.callTargetSourcePath = probeTargetSourcePath
        probeStmt.callTargetSignatureLineNumber = probeTargetSignatureLine
        probeStmt.callTargetImportc = probeTargetImportc
        for probeArgIndex in 0..<probeArgNodes.len:
            let probeArgNodeIndex = probeArgNodes[probeArgIndex]
            if probeArgNodeIndex < 0 || probeArgNodeIndex >= typedIr.nodes2_nodeIndexs.len:
                let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_chain")
                return -1
            let npArgParamRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_paramNameIds[probeArgNodeIndex])
            let npArgSurfRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_surfaceTextIds[probeArgNodeIndex])
            let npArgSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[probeArgNodeIndex])
            if !IsOk(npArgParamRes) || !IsOk(npArgSurfRes) || !IsOk(npArgSrcRes):
                let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_chain")
                return -1
            let npArgParam = Value(npArgParamRes)
            let npArgSurf = Value(npArgSurfRes)
            let npArgSrc = Value(npArgSrcRes)
            let probeParamType = PrimaryBodyIrCallArgTypeAt(probeStmt, probeArgIndex)
            let probeNeedsAddress = PrimaryBodyIrTypeTextIsVarParam(probeParamType)
            if typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpParamRef ||
               typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpLocalRef:
                var probeArgName = npArgParam
                if probeArgName == "":
                    probeArgName = strutil.Strip(npArgSurf)
                if probeArgName == "":
                    let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_name")
                    return -1
                if PrimaryBodyIrFindArgSlot(bodyIR, slotNames, probeArgName) < 0 &&
                   !PrimaryBodyIrNameInList(varI32ParamNames, probeArgName):
                    var probeGlobalArgOk = false
                    if typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpLocalRef && !probeNeedsAddress:
                        let probeGlobalArgType = PrimaryBodyIrTypedGlobalTypeExact(typedIr,
                                                                                   npArgSrc,
                                                                                   probeArgName)
                        if probeGlobalArgType != "":
                            var probeGlobalArgKind: int32
                            var probeGlobalArgSize: int32
                            var probeGlobalArgAlign: int32
                            PrimaryBodyIrNodeTypeShape(typedIr,
                                                       npArgSrc,
                                                       probeGlobalArgType,
                                                       probeGlobalArgKind,
                                                       probeGlobalArgSize,
                                                       probeGlobalArgAlign)
                            if probeGlobalArgKind == coreir.LocalI32Tag ||
                               probeGlobalArgKind == coreir.LocalI64Tag ||
                               probeGlobalArgKind == coreir.LocalF64Tag ||
                               probeGlobalArgKind == coreir.LocalPtrTag ||
                               probeGlobalArgKind == coreir.LocalStrTag ||
                               probeGlobalArgKind == coreir.LocalAggregateTag:
                                probeGlobalArgOk = true
                    elif typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpLocalRef && probeNeedsAddress:
                        # `var` param fed a module-global aggregate (seq/struct):
                        # the emit path materializes the global's address into a
                        # Ptr slot (PrimaryBodyIrGlobalAggregateDestSlot, which
                        # requires LocalAggregateTag). Mirror that feasibility in
                        # the probe so the call isn't rejected before emit runs.
                        let probeGlobalAddrType = PrimaryBodyIrTypedGlobalTypeExact(typedIr,
                                                                                    npArgSrc,
                                                                                    probeArgName)
                        if probeGlobalAddrType != "":
                            var probeGlobalAddrKind: int32
                            var probeGlobalAddrSize: int32
                            var probeGlobalAddrAlign: int32
                            PrimaryBodyIrNodeTypeShape(typedIr,
                                                       npArgSrc,
                                                       probeGlobalAddrType,
                                                       probeGlobalAddrKind,
                                                       probeGlobalAddrSize,
                                                       probeGlobalAddrAlign)
                            if probeGlobalAddrKind == coreir.LocalAggregateTag:
                                probeGlobalArgOk = true
                    if !probeGlobalArgOk:
                        let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_slot")
                        return -1
            elif typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpStrLit ||
                 typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpBoolLit:
                if probeNeedsAddress:
                    let _ = PrimaryBodyIrNodeEvalMissAt("call_var_arg")
                    return -1
            elif probeNeedsAddress:
                var probeVarArgRootSlot: int32
                var probeVarArgTotalOffset: int32
                if !PrimaryBodyIrVarArgFieldPathInfo(bodyIR,
                                                     slotNames,
                                                     typedIr,
                                                     probeArgNodeIndex,
                                                     probeVarArgRootSlot,
                                                     probeVarArgTotalOffset):
                    var probeVarIdxRootSlot: int32
                    var probeVarIdxHeaderOffset: int32
                    var probeVarIdxElemSize: int32
                    var probeVarIdxNode: int32
                    var probeVarIdxOk = false
                    if PrimaryBodyIrVarArgIndexInfo(bodyIR,
                                                    slotNames,
                                                    typedIr,
                                                    probeArgNodeIndex,
                                                    probeVarIdxRootSlot,
                                                    probeVarIdxHeaderOffset,
                                                    probeVarIdxElemSize,
                                                    probeVarIdxNode):
                        let _ = probeVarIdxHeaderOffset
                        probeVarIdxOk = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   probeVarIdxNode) == coreir.LocalI32Tag
                    if !probeVarIdxOk:
                        var probeVifRootSlot: int32
                        var probeVifHeaderOffset: int32
                        var probeVifElemSize: int32
                        var probeVifIdxNode: int32
                        var probeVifFieldOffset: int32
                        if PrimaryBodyIrVarArgIndexedFieldInfo(bodyIR,
                                                               slotNames,
                                                               typedIr,
                                                               probeArgNodeIndex,
                                                               probeVifRootSlot,
                                                               probeVifHeaderOffset,
                                                               probeVifElemSize,
                                                               probeVifIdxNode,
                                                               probeVifFieldOffset):
                            let _ = probeVifRootSlot
                            let _ = probeVifHeaderOffset
                            let _ = probeVifElemSize
                            let _ = probeVifFieldOffset
                            probeVarIdxOk = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       typedIr,
                                                                       typedFn,
                                                                       irFunction,
                                                                       probeVifIdxNode) == coreir.LocalI32Tag
                    if !probeVarIdxOk:
                        # 双下标链 var seq 实参纯校验：镜像 emit 的 SeqRefIndexedChain
                        # 覆盖，保 probe/emit 对称（探针放行必蕴含 emit 成功）。
                        if PrimaryBodyIrSeqRefIndexedChainProbe(bodyIR,
                                                                slotNames,
                                                                typedIr,
                                                                irFunction,
                                                                npArgSrc,
                                                                npArgSurf):
                            probeVarIdxOk = true
                    if !probeVarIdxOk:
                        let _ = PrimaryBodyIrNodeEvalMissAt("call_var_arg")
                        return -1
            else:
                let probeArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              probeArgNodeIndex)
                if probeArgKind < 0:
                    return -1
        return probeRetKind
    if opKind == texpr.TypedExprIrOpLocalBoolEnumTernary:
        # `cond ? then : else`：前端建 operand0=cond/operand1=then/operand2=else，
        # 全臂为纯常量/枚举/cast（无副作用）。守卫镜像 LogAnd（~22368）：任一臂子树
        # 含真调用（标量宽度 cast 不算，NodeTreeHasCallExpr 递归进 cast 内参）则
        # 诚实 STOP——臂含调用会被 eager 求值破坏短路/副作用语义。标量臂经算术
        # select（delta/scaled/result）降，then==else 且同属 I32/I64 时放行。
        if PrimaryBodyIrNodeTreeHasCallExpr(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex)) ||
           PrimaryBodyIrNodeTreeHasCallExpr(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand2NodeIndexs, nodeIndex)):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let probeTernCondKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           typedIr,
                                                           typedFn,
                                                           irFunction,
                                                           arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeTernCondKind < 0:
            return -1
        if probeTernCondKind != coreir.LocalI32Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let probeTernThenKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           typedIr,
                                                           typedFn,
                                                           irFunction,
                                                           arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex))
        if probeTernThenKind < 0:
            return -1
        let probeTernElseKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           typedIr,
                                                           typedFn,
                                                           irFunction,
                                                           arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand2NodeIndexs, nodeIndex))
        if probeTernElseKind < 0:
            return -1
        if probeTernThenKind != probeTernElseKind:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if probeTernThenKind != coreir.LocalI32Tag &&
           probeTernThenKind != coreir.LocalI64Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return probeTernThenKind
    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))

# 批次6e：裸调用语句（返回值丢弃，targetSlot=-1）的纯前置探针。镜像
# AppendCallExprNodeToSlot 丢弃模式的全部可失败检查但不发射：void/寄存
# 器标量返回可丢，sret 形（str/聚合）拒绝。
@borrows
fn PrimaryBodyIrCastCallTargetKind(head: str): int32 =
    if head == "int8" || head == "Int8" ||
       head == "int16" || head == "Int16" ||
       head == "int32" || head == "Int32" ||
       head == "uint8" || head == "UInt8" ||
       head == "uint16" || head == "UInt16" ||
       head == "uint32" || head == "UInt32" ||
       head == "char" || head == "Char":
        return coreir.LocalI32Tag
    if head == "int64" || head == "Int64" ||
       head == "uint64" || head == "UInt64":
        return coreir.LocalI64Tag
    return coreir.LocalInvalidTag

@borrows
fn PrimaryBodyIrCastCallArgNodeIndex(typedIr: texpr.TypedExprIr,
                                      nodeIndex: int32): int32 =
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let ccaLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(ccaLitRes):
        return -1
    if PrimaryBodyIrCastCallTargetKind(Value(ccaLitRes)) == coreir.LocalInvalidTag:
        return -1
    let castArgLink = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)
    if castArgLink < 0 ||
       castArgLink >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[castArgLink] != texpr.TypedExprIrOpArgLink ||
       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, castArgLink) >= 0:
        return -1
    return arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, castArgLink)

@borrows
fn PrimaryBodyIrTypeTextIsPointerLikeForNode(typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             typeRaw: str): bool =
    let typeText = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    if typeText == "":
        return false
    if typeText == "cstring" ||
       typeText == "owned_cstring" ||
       typeText == "ptr" ||
       typeText == "void*":
        return true
    if PrimaryStartsWith(typeText, "ref[") ||
       PrimaryStartsWith(typeText, "ref ") ||
       PrimaryStartsWith(typeText, "ptr[") ||
       PrimaryStartsWith(typeText, "pointer[") ||
       PrimaryStartsWith(typeText, "Pointer["):
        return true
    if len(typeText) > 0 && typeText[len(typeText) - 1] == '*':
        return true
    let aliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                    sourcePath,
                                                                    typeText)
    if aliasTarget != "" &&
       texpr.TypedExprNormalizeTypeText(aliasTarget) != typeText:
        return PrimaryBodyIrTypeTextIsPointerLikeForNode(typedIr,
                                                         sourcePath,
                                                         aliasTarget)
    return false

@borrows
fn PrimaryBodyIrIntegerTypeEvidence(typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     typeRaw: str,
                                     widthBitsOut: var int32,
                                     signednessOut: var int32): bool =
    widthBitsOut = 0
    signednessOut = 0
    let typeText = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    if typeText == "int8" || typeText == "i8" || typeText == "Int8":
        widthBitsOut = 8
        signednessOut = 1
        return true
    if typeText == "uint8" || typeText == "u8" || typeText == "UInt8" ||
       typeText == "bool":
        widthBitsOut = 8
        signednessOut = 2
        return true
    if typeText == "int16" || typeText == "i16" || typeText == "Int16":
        widthBitsOut = 16
        signednessOut = 1
        return true
    if typeText == "uint16" || typeText == "u16" || typeText == "UInt16":
        widthBitsOut = 16
        signednessOut = 2
        return true
    if typeText == "int32" || typeText == "i32" || typeText == "Int32" ||
       typeText == "int":
        widthBitsOut = 32
        signednessOut = 1
        return true
    if typeText == "uint32" || typeText == "u32" || typeText == "UInt32" ||
       typeText == "uint" || typeText == "char" || typeText == "Char":
        widthBitsOut = 32
        signednessOut = 2
        return true
    if typeText == "int64" || typeText == "i64" || typeText == "Int64":
        widthBitsOut = 64
        signednessOut = 1
        return true
    if typeText == "uint64" || typeText == "u64" || typeText == "UInt64":
        widthBitsOut = 64
        signednessOut = 2
        return true
    if sourcePath != "" && texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, typeRaw):
        widthBitsOut = 32
        signednessOut = 1
        return true
    return false

# 0 = not an integer cast, 1 = complete structural evidence, -1 = claimed
# integer cast with incomplete/conflicting evidence.  A -1 result is terminal.
@borrows
fn PrimaryBodyIrIntegerCastNodeEvidence(typedIr: texpr.TypedExprIr,
                                         nodeIndex: int32,
                                         argNodeIndexOut: var int32,
                                         sourceWidthBitsOut: var int32,
                                         sourceSignednessOut: var int32,
                                         targetWidthBitsOut: var int32,
                                         targetSignednessOut: var int32,
                                         targetKindOut: var int32): int32 =
    argNodeIndexOut = -1
    sourceWidthBitsOut = 0
    sourceSignednessOut = 0
    targetWidthBitsOut = 0
    targetSignednessOut = 0
    targetKindOut = coreir.LocalInvalidTag
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return 0
    let castHeadRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                           typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(castHeadRes):
        return -1
    let castHead: str = Value(castHeadRes)
    targetKindOut = PrimaryBodyIrCastCallTargetKind(castHead)
    if targetKindOut == coreir.LocalInvalidTag:
        return 0
    argNodeIndexOut = PrimaryBodyIrCastCallArgNodeIndex(typedIr, nodeIndex)
    if argNodeIndexOut < 0 || argNodeIndexOut >= typedIr.nodes2_nodeIndexs.len:
        return -1
    if !PrimaryBodyIrIntegerTypeEvidence(typedIr,
                                         "",
                                         castHead,
                                         targetWidthBitsOut,
                                         targetSignednessOut):
        return -1
    let castResultType = PrimaryBodyIrNodeResultTypeText(typedIr, nodeIndex)
    var resultWidthBits: int32
    var resultSignedness: int32
    if !PrimaryBodyIrIntegerTypeEvidence(typedIr,
                                         "",
                                         castResultType,
                                         resultWidthBits,
                                         resultSignedness) ||
       resultWidthBits != targetWidthBitsOut ||
       resultSignedness != targetSignednessOut:
        return -1
    let sourceType = PrimaryBodyIrNodeResultTypeText(typedIr, argNodeIndexOut)
    var sourcePath = ""
    let sourcePathRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                             typedIr.nodes2_sourcePathIds[argNodeIndexOut])
    if IsOk(sourcePathRes):
        sourcePath = Value(sourcePathRes)
    if PrimaryBodyIrIntegerTypeEvidence(typedIr,
                                        sourcePath,
                                        sourceType,
                                        sourceWidthBitsOut,
                                        sourceSignednessOut):
        return 1
    let sourceTypeNorm = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(sourceType))
    if sourceTypeNorm == "float64" || sourceTypeNorm == "f64":
        return 0
    if PrimaryBodyIrTypeTextIsPointerLikeForNode(typedIr, sourcePath, sourceType):
        if targetWidthBitsOut != 64:
            return -1
        sourceWidthBitsOut = 64
        sourceSignednessOut = 3
        return 1
    return -1

@borrows
fn PrimaryBodyIrNodeEvalCopyScalarKind(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        valueSlot: int32,
                                        targetKind: int32,
                                        nodeIndex: int32,
                                        suffix: str): int32 =
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return -1
    let targetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#nev{nodeIndex}#icast{suffix}",
                                                    targetKind)
    if targetSlot < 0:
        return -1
    var copyOp: coreir.BodyOp
    copyOp.kind = coreir.BodyOpCopyLocalTag
    copyOp.target = targetSlot
    add(copyOp.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
    return targetSlot

@borrows
fn PrimaryBodyIrNodeEvalCanonicalI32(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      valueSlot: int32,
                                      widthBits: int32,
                                      signedness: int32,
                                      nodeIndex: int32,
                                      lane: int32): int32 =
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, valueSlot) != coreir.LocalI32Tag:
        return -1
    if widthBits == 32:
        return valueSlot
    if widthBits != 8 && widthBits != 16:
        return -1
    let shiftBits = 32 - widthBits
    if signedness == 2:
        var maskValue = 255
        if widthBits == 16:
            maskValue = 65535
        let maskSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#nev{nodeIndex}#icast{lane}mask",
                                                       coreir.LocalI32Tag,
                                                       maskValue)
        let resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"#nev{nodeIndex}#icast{lane}u",
                                                        coreir.LocalI32Tag)
        if maskSlot < 0 || resultSlot < 0:
            return -1
        var maskOp: coreir.BodyOp
        maskOp.kind = coreir.BodyOpBinOpTag
        maskOp.target = resultSlot
        add(maskOp.operands, coreir.LocalI32Tag)
        add(maskOp.operands, int32(texpr.TypedExprIrOpI32BitAnd))
        add(maskOp.operands, valueSlot)
        add(maskOp.operands, maskSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, maskOp)
        return resultSlot
    if signedness != 1:
        return -1
    let shiftSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#nev{nodeIndex}#icast{lane}shift",
                                                    coreir.LocalI32Tag,
                                                    shiftBits)
    let leftSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#nev{nodeIndex}#icast{lane}left",
                                                  coreir.LocalI32Tag)
    let resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#nev{nodeIndex}#icast{lane}s",
                                                    coreir.LocalI32Tag)
    if shiftSlot < 0 || leftSlot < 0 || resultSlot < 0:
        return -1
    var leftOp: coreir.BodyOp
    leftOp.kind = coreir.BodyOpBinOpTag
    leftOp.target = leftSlot
    add(leftOp.operands, coreir.LocalI32Tag)
    add(leftOp.operands, int32(texpr.TypedExprIrOpI32Lsl))
    add(leftOp.operands, valueSlot)
    add(leftOp.operands, shiftSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, leftOp)
    var rightOp: coreir.BodyOp
    rightOp.kind = coreir.BodyOpBinOpTag
    rightOp.target = resultSlot
    add(rightOp.operands, coreir.LocalI32Tag)
    add(rightOp.operands, int32(texpr.TypedExprIrOpI32Asr))
    add(rightOp.operands, leftSlot)
    add(rightOp.operands, shiftSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, rightOp)
    return resultSlot

@borrows
fn PrimaryBodyIrNodeEvalZeroExtendU32ToI64(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           valueSlot: int32,
                                           nodeIndex: int32): int32 =
    let wideSlot = PrimaryBodyIrNodeEvalCopyScalarKind(bodyIR,
                                                       slotNames,
                                                       valueSlot,
                                                       coreir.LocalI64Tag,
                                                       nodeIndex,
                                                       "u32wide")
    if wideSlot < 0:
        return -1
    let maskSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#nev{nodeIndex}#icastu32mask",
                                                 coreir.LocalI64Tag)
    let resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"#nev{nodeIndex}#icastu32",
                                                   coreir.LocalI64Tag)
    if maskSlot < 0 || resultSlot < 0:
        return -1
    var maskConst: coreir.BodyOp
    maskConst.kind = coreir.BodyOpLoadConstTag
    maskConst.target = maskSlot
    add(maskConst.operands, coreir.LocalI64Tag)
    add(maskConst.operands, 65535)
    add(maskConst.operands, 65535)
    add(maskConst.operands, 0)
    add(maskConst.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, maskConst)
    var maskOp: coreir.BodyOp
    maskOp.kind = coreir.BodyOpBinOpTag
    maskOp.target = resultSlot
    add(maskOp.operands, coreir.LocalI64Tag)
    add(maskOp.operands, int32(texpr.TypedExprIrOpI32BitAnd))
    add(maskOp.operands, wideSlot)
    add(maskOp.operands, maskSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, maskOp)
    return resultSlot

@borrows
fn PrimaryBodyIrEvalProvenIntegerCastNode(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           varI32ParamNames: str[],
                                           lowering: lower.LoweringPlanStub,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           nodeIndex: int32,
                                           callOrdinal: var int32,
                                           claimedOut: var bool): int32 =
    claimedOut = false
    var argNodeIndex: int32
    var sourceWidthBits: int32
    var sourceSignedness: int32
    var targetWidthBits: int32
    var targetSignedness: int32
    var targetKind: int32
    let evidence = PrimaryBodyIrIntegerCastNodeEvidence(lowering.typedIr,
                                                         nodeIndex,
                                                         argNodeIndex,
                                                         sourceWidthBits,
                                                         sourceSignedness,
                                                         targetWidthBits,
                                                         targetSignedness,
                                                         targetKind)
    if evidence == 0:
        return -1
    claimedOut = true
    if evidence < 0:
        return -1
    var expectedSourceKind = coreir.LocalI32Tag
    if sourceSignedness == 3:
        expectedSourceKind = coreir.LocalPtrTag
    elif sourceWidthBits == 64:
        expectedSourceKind = coreir.LocalI64Tag
    let probeSourceKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering.typedIr,
                                                     typedFn,
                                                     irFunction,
                                                     argNodeIndex)
    if probeSourceKind != expectedSourceKind:
        return -1
    let sourceSlot = PrimaryBodyIrEvalNode(bodyIR,
                                           slotNames,
                                           varI32ParamNames,
                                           lowering,
                                           typedFn,
                                           irFunction,
                                           argNodeIndex,
                                           callOrdinal)
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, sourceSlot) != expectedSourceKind:
        return -1
    if sourceSignedness == 3:
        return PrimaryBodyIrNodeEvalCopyScalarKind(bodyIR,
                                                   slotNames,
                                                   sourceSlot,
                                                   coreir.LocalI64Tag,
                                                   nodeIndex,
                                                   "ptr")
    var canonicalSource = sourceSlot
    if sourceWidthBits < 32:
        canonicalSource = PrimaryBodyIrNodeEvalCanonicalI32(bodyIR,
                                                            slotNames,
                                                            sourceSlot,
                                                            sourceWidthBits,
                                                            sourceSignedness,
                                                            nodeIndex,
                                                            0)
        if canonicalSource < 0:
            return -1
    if targetWidthBits <= 32:
        var narrowSource = canonicalSource
        if PrimaryBodyIrSlotType(bodyIR, narrowSource) == coreir.LocalI64Tag:
            narrowSource = PrimaryBodyIrNodeEvalCopyScalarKind(bodyIR,
                                                               slotNames,
                                                               narrowSource,
                                                               coreir.LocalI32Tag,
                                                               nodeIndex,
                                                               "low32")
        if narrowSource < 0:
            return -1
        if targetWidthBits < 32:
            return PrimaryBodyIrNodeEvalCanonicalI32(bodyIR,
                                                     slotNames,
                                                     narrowSource,
                                                     targetWidthBits,
                                                     targetSignedness,
                                                     nodeIndex,
                                                     1)
        return narrowSource
    if targetWidthBits != 64:
        return -1
    if PrimaryBodyIrSlotType(bodyIR, canonicalSource) == coreir.LocalI64Tag:
        return canonicalSource
    if sourceWidthBits == 32 && sourceSignedness == 2:
        return PrimaryBodyIrNodeEvalZeroExtendU32ToI64(bodyIR,
                                                       slotNames,
                                                       canonicalSource,
                                                       nodeIndex)
    return PrimaryBodyIrNodeEvalCopyScalarKind(bodyIR,
                                               slotNames,
                                               canonicalSource,
                                               coreir.LocalI64Tag,
                                               nodeIndex,
                                               "wide")

# cstring(x)/owned_cstring(x) is a pure pointer reinterpret: the result machine
# word IS the single inner pointer-width argument (no runtime op, no call
# ordinal). Returns true for the recognized heads so the node path can pass the
# inner value through instead of routing it to the unresolvable whole-call path.
@borrows
fn PrimaryBodyIrPtrReinterpretCastHead(head: str): bool =
    if head == "ptr" || head == "cstring" || head == "owned_cstring":
        return true
    return false

# The single inner argument node of a cstring(x)/owned_cstring(x) reinterpret;
# -1 if the call shape is not exactly one ArgLink.
@borrows
fn PrimaryBodyIrPtrReinterpretCastArgNodeIndex(typedIr: texpr.TypedExprIr,
                                                nodeIndex: int32): int32 =
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let prcLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(prcLitRes):
        return -1
    if !PrimaryBodyIrPtrReinterpretCastHead(Value(prcLitRes)):
        return -1
    let castArgLink = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)
    if castArgLink < 0 ||
       castArgLink >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[castArgLink] != texpr.TypedExprIrOpArgLink ||
       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, castArgLink) >= 0:
        return -1
    return arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, castArgLink)

# A pointer-type-alias cast (StrPtr(x), Int32Ptr(x), ChengSeqHeaderPtr(x), …) is
# a pure pointer-width reinterpret: the cast head is a typedef whose target is
# `T *`. Recognizing it lets `let p = StrPtr(call(...))` stay on the node-eval
# path (full field-load context) instead of falling to the text synth path,
# which cannot lower arrow-field call arguments.
@borrows
fn PrimaryBodyIrPtrAliasReinterpretCastHead(typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             head: str): bool =
    if head == "" || !texpr.TypedExprCallHeadIsPlainQualifiedIdent(head):
        return false
    if PrimaryBodyIrCastCallTargetKind(head) != coreir.LocalInvalidTag:
        return false
    if PrimaryBodyIrPtrReinterpretCastHead(head):
        return false
    if PrimaryBodyIrPointeeTypeTextForSource(typedIr, sourcePath, head) != "":
        return true
    # 命名 ref 句柄类型作单实参构造头 `RefType(ptrArg)`：ref 句柄恒为指针宽度
    # (定形 LocalPtrTag 8B)，对指针实参是纯位重解释——结果机器字即内层指针。它不是
    # 函数（构造器不是函数，ordinal 必失败落 call_ordinal），也不是 `T *` typedef
    # （pointee text 为空），故走与 typedef 别名同一指针重解释发射路径（EvalNode
    # 物化内层 ptr → 槽 copy）。pointee 文本为空但 ref 注册表如实命中。
    return texpr.TypedExprIrTypeIsRef(typedIr, sourcePath, head)

# The single inner argument node of a pointer-type-alias reinterpret cast;
# -1 if the call shape is not exactly one ArgLink with the recognized head.
@borrows
fn PrimaryBodyIrPtrAliasReinterpretCastArgNodeIndex(typedIr: texpr.TypedExprIr,
                                                     sourcePath: str,
                                                     nodeIndex: int32): int32 =
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let parcLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(parcLitRes):
        return -1
    if !PrimaryBodyIrPtrAliasReinterpretCastHead(typedIr, sourcePath, Value(parcLitRes)):
        return -1
    let castArgLink = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)
    if castArgLink < 0 ||
       castArgLink >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[castArgLink] != texpr.TypedExprIrOpArgLink ||
       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, castArgLink) >= 0:
        return -1
    return arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, castArgLink)

@borrows
fn PrimaryBodyIrNodeEvalIntConvert(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    valueSlot: int32,
                                    targetKind: int32,
                                    nodeIndex: int32): int32 =
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return -1
    let valueKind = PrimaryBodyIrSlotType(bodyIR, valueSlot)
    # uint64(ptr)/int64(ptr): ptr 与 i64 同为 8 字节机器字，纯位重解释，经
    # i64 槽 CopyLocal 透传（cstring 路径 i64→ptr 的镜像形态）。仅 i64 目标成立；
    # ptr→i32 是截断，需真 narrow op，保持 miss。
    if valueKind == coreir.LocalPtrTag && targetKind != coreir.LocalI64Tag:
        return -1
    if valueKind != coreir.LocalI32Tag &&
       valueKind != coreir.LocalI64Tag &&
       valueKind != coreir.LocalPtrTag:
        return -1
    if valueKind == targetKind:
        return valueSlot
    # Stage-8 const-widen fold: `int64(<i32 literal>)` lowers as `LoadConst i32`
    # (str w; into a fresh #nev slot) immediately followed here by an I32->I64
    # CopyLocal (ldrsw x; str x). When the value slot was produced by the op we
    # JUST emitted (last op, LoadConst targeting valueSlot with an I32 const) and
    # the widen target is I64, retype that LoadConst to materialize the constant
    # straight into an I64 slot — the i64 LoadConst is the SAME mov word count for
    # this value (sf bit only) and the i64 slot store is one `str x`, so the whole
    # `str w; ldrsw x; str x` cast round-trip collapses to a single `str x`. This
    # is a pure IR-build constant fold: it removes the CopyLocal op from
    # bodyIR.ops, so both the size predictor and the filler see the shorter list
    # automatically (no two-pass symmetry array needed). The #nev const slot is
    # single-use by construction (only this cast reads it), and being the last op
    # makes it adjacent — both safety conditions hold. Sign-correct: a non-negative
    # i32 literal zero-extends == sign-extends; a negative i32 literal stays in
    # i32 range so the i64 LoadConst movn/movz+movk reproduce the same 64-bit value.
    if targetKind == coreir.LocalI64Tag &&
       valueKind == coreir.LocalI32Tag &&
       bodyIR.ops.len > 0:
        let lastIdx = bodyIR.ops.len - 1
        if bodyIR.ops[lastIdx].kind == coreir.BodyOpLoadConstTag &&
           bodyIR.ops[lastIdx].target == valueSlot &&
           bodyIR.ops[lastIdx].operands.len == 2 &&
           bodyIR.ops[lastIdx].operands[0] == coreir.LocalI32Tag:
            bodyIR.ops[lastIdx].operands[0] = coreir.LocalI64Tag
            bodyIR.localSlots[valueSlot].typeKind = coreir.LocalI64Tag
            bodyIR.localSlots[valueSlot].sizeBytes = 8
            if bodyIR.localSlots[valueSlot].alignBytes < 8:
                bodyIR.localSlots[valueSlot].alignBytes = 8
            return valueSlot
    let convertSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#nev{nodeIndex}#cast",
                                                    targetKind)
    if convertSlot < 0:
        return -1
    var convertOp: coreir.BodyOp
    convertOp.kind = coreir.BodyOpCopyLocalTag
    convertOp.target = convertSlot
    add(convertOp.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, convertOp)
    return convertSlot

@borrows
fn PrimaryBodyIrEvalNode(bodyIR: var coreir.BodyIR,
                          slotNames: var str[],
                          varI32ParamNames: str[],
                          lowering: lower.LoweringPlanStub,
                          typedFn: texpr.TypedExprIrFunction,
                          irFunction: lower.PrimaryObjectIrFunction,
                          nodeIndex: int32,
                          callOrdinal: var int32): int32 =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        return PrimaryBodyIrNodeEvalMissAt("bad_node_index")
    let enLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[nodeIndex])
    let enParamRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_paramNameIds[nodeIndex])
    let enRtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[nodeIndex])
    let enSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[nodeIndex])
    let enSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[nodeIndex])
    if !IsOk(enLitRes) || !IsOk(enParamRes) || !IsOk(enRtRes) || !IsOk(enSrcRes) || !IsOk(enSurfRes):
        return PrimaryBodyIrNodeEvalMissAt("intern_lookup")
    let enLit = Value(enLitRes)
    let enParam = Value(enParamRes)
    let enRt = Value(enRtRes)
    let enSrc = Value(enSrcRes)
    let enSurf = Value(enSurfRes)
    let opKind = lowering.typedIr.nodes2_opKinds[nodeIndex]
    let arithBinOpKind = PrimaryBodyIrNodeEvalArithBinOpResultKind(opKind)
    if arithBinOpKind != coreir.LocalInvalidTag:
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let binLhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                               callOrdinal)
        if binLhsSlot < 0:
            return -1
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let binRhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                               callOrdinal)
        if binRhsSlot < 0:
            return -1
        let binResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}",
                                                          arithBinOpKind)
        if binResultSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # Fold the opKind to the I32 base op the arm64 FillBinOp dispatches on;
        # operands[0] (arithBinOpKind) already carries the width via the type
        # tag. Storing the raw I64 variant here (e.g. TypedExprIrOpI64Sub) breaks
        # the fill arm, which only matches I32-flavoured constants -> it falls
        # through to the unsupported `else` and emits a zero-valued word (census
        # 0-op). Mirrors PrimaryBodyIrNodeEvalBinOpMeta's I64→I32 folding used
        # by every other BinOp emitter; for I32 ops the fold is a no-op.
        var binBaseFoldType: int32
        var binBaseFoldOp: int32
        var binBaseFoldIsMod: bool
        var binBaseFoldModDiv: int32
        var binBaseOpForFill = int32(opKind)
        if PrimaryBodyIrNodeEvalBinOpMeta(opKind,
                                          binBaseFoldType,
                                          binBaseFoldOp,
                                          binBaseFoldIsMod,
                                          binBaseFoldModDiv):
            binBaseOpForFill = binBaseFoldOp
        var binOp: coreir.BodyOp
        binOp.kind = coreir.BodyOpBinOpTag
        binOp.target = binResultSlot
        add(binOp.operands, arithBinOpKind)
        add(binOp.operands, binBaseOpForFill)
        add(binOp.operands, binLhsSlot)
        add(binOp.operands, binRhsSlot)
        if opKind == texpr.TypedExprIrOpI32Madd:
            if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            let binMaddSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,
                                                    typedFn,
                                                    irFunction,
                                                    arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex),
                                                    callOrdinal)
            if binMaddSlot < 0:
                return -1
            add(binOp.operands, binMaddSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
        return binResultSlot
    if opKind == texpr.TypedExprIrOpI32Const:
        let constVal = PrimaryBodyIrExtractIntFromText(enLit)
        if constVal == 0 && !PrimaryBodyIrTextIsI32Zero(enLit):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let constSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                      slotNames,
                                                      Fmt"#nev{nodeIndex}",
                                                      coreir.LocalI32Tag)
        if constSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var constOp: coreir.BodyOp
        constOp.kind = coreir.BodyOpLoadConstTag
        constOp.target = constSlot
        add(constOp.operands, coreir.LocalI32Tag)
        add(constOp.operands, constVal)
        let _ = coreir.BodyIRAppendOp(bodyIR, constOp)
        return constSlot
    if opKind == texpr.TypedExprIrOpI64Const:
        var const64Val: int64
        if !PrimaryBodyIrExtractInt64FromText(enLit, const64Val):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let const64Slot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"#nev{nodeIndex}",
                                                        coreir.LocalI64Tag)
        if const64Slot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var const64Op: coreir.BodyOp
        const64Op.kind = coreir.BodyOpLoadConstTag
        const64Op.target = const64Slot
        add(const64Op.operands, coreir.LocalI64Tag)
        if const64Val > int64(2147483647) || const64Val < int64(0) - int64(2147483648):
            add(const64Op.operands, Int32(const64Val & int64(65535)))
            add(const64Op.operands, Int32((const64Val >> 16) & int64(65535)))
            add(const64Op.operands, Int32((const64Val >> 32) & int64(65535)))
            add(const64Op.operands, Int32((const64Val >> 48) & int64(65535)))
        else:
            add(const64Op.operands, Int32(const64Val))
        let _ = coreir.BodyIRAppendOp(bodyIR, const64Op)
        return const64Slot
    if opKind == texpr.TypedExprIrOpF64Const:
        let constF64Slot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"#nev{nodeIndex}",
                                                         coreir.LocalF64Tag)
        if constF64Slot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var constF64Op: coreir.BodyOp
        constF64Op.kind = coreir.BodyOpLoadConstTag
        constF64Op.target = constF64Slot
        if !PrimaryBodyIrAppendF64ConstOperands(constF64Op, enLit):
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_f64_const_fail stage=eval function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)} lit={enLit} surf={enSurf} rt={enRt}")
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let _ = coreir.BodyIRAppendOp(bodyIR, constF64Op)
        return constF64Slot
    if opKind == texpr.TypedExprIrOpBoolLit:
        var boolVal: int32
        if enLit == "true":
            boolVal = 1
        let boolSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#nev{nodeIndex}",
                                                     coreir.LocalI32Tag)
        if boolSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var boolOp: coreir.BodyOp
        boolOp.kind = coreir.BodyOpLoadConstTag
        boolOp.target = boolSlot
        add(boolOp.operands, coreir.LocalI32Tag)
        add(boolOp.operands, boolVal)
        let _ = coreir.BodyIRAppendOp(bodyIR, boolOp)
        return boolSlot
    if opKind == texpr.TypedExprIrOpCharLit:
        let charVal = PrimaryBodyIrCharLiteralValue(enLit)
        if charVal < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let charSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#nev{nodeIndex}",
                                                     coreir.LocalI32Tag)
        if charSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var charOp: coreir.BodyOp
        charOp.kind = coreir.BodyOpLoadConstTag
        charOp.target = charSlot
        add(charOp.operands, coreir.LocalI32Tag)
        add(charOp.operands, charVal)
        let _ = coreir.BodyIRAppendOp(bodyIR, charOp)
        return charSlot
    if opKind == texpr.TypedExprIrOpNilPtr:
        let nilPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#nev{nodeIndex}",
                                                       coreir.LocalPtrTag)
        if nilPtrSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var nilPtrOp: coreir.BodyOp
        nilPtrOp.kind = coreir.BodyOpLoadConstTag
        nilPtrOp.target = nilPtrSlot
        add(nilPtrOp.operands, coreir.LocalPtrTag)
        add(nilPtrOp.operands, 0)
        let _ = coreir.BodyIRAppendOp(bodyIR, nilPtrOp)
        return nilPtrSlot
    if opKind == texpr.TypedExprIrOpAddrOf:
        # `&FunctionName` 取顶层函数符号地址：operand0 是 FuncRef 叶子。建函数
        # 地址 GlobalAddress 槽（名 __cheng_function_address#N），emit 经
        # adrp+add（PAGE/PAGEOFF reloc against 该函数符号）把入口地址物化进 Ptr
        # 槽。与 call-arg 取址发射同款协议，复用既有函数符号 reloc 机制。
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) >= 0 &&
           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpFuncRef:
            let enAddrFuncLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)])
            if !IsOk(enAddrFuncLitRes):
                return PrimaryBodyIrNodeEvalMissAt("addr_of_func_ref")
            let funcRefEvalSlot = PrimaryBodyIrFuncRefAddressSlot(bodyIR,
                                                                  slotNames,
                                                                  lowering,
                                                                  enSrc,
                                                                  Value(enAddrFuncLitRes))
            if funcRefEvalSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt("addr_of_func_ref")
            return funcRefEvalSlot
        # `&place` 取址独立求值：operand0 是字段路径子节点，求 root 槽 + 偏移，
        # 发 base+offset 进 Ptr 槽（与 call-arg 取址发射同款协议）。
        var addrEvalRootSlot: int32
        var addrEvalTotalOffset: int32
        if !PrimaryBodyIrAddrOfPlaceRootInfo(bodyIR,
                                             slotNames,
                                             lowering.typedIr,
                                             arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                             addrEvalRootSlot,
                                             addrEvalTotalOffset):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let addrEvalSlot = PrimaryBodyIrMaterializeAddrOfPlaceSlot(
            bodyIR,
            slotNames,
            lowering.typedIr,
            arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
            addrEvalRootSlot,
            addrEvalTotalOffset,
            Fmt"#nev{nodeIndex}")
        if addrEvalSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return addrEvalSlot
    if opKind == texpr.TypedExprIrOpStrLit:
        let strLitSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#nev{nodeIndex}",
                                                       coreir.LocalStrTag)
        let strLitInitSlot = PrimaryBodyIrFindOrCreateSlot(
            bodyIR,
            slotNames,
            Fmt"#nev{nodeIndex}#owned_init",
            coreir.LocalStrTag)
        if strLitSlot < 0 || strLitInitSlot < 0 ||
           !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                  slotNames,
                                                  enLit,
                                                  strLitInitSlot,
                                                  callOrdinal):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var strLitDefOp: coreir.BodyOp
        strLitDefOp.kind = coreir.BodyOpCopyLocalTag
        strLitDefOp.target = strLitSlot
        add(strLitDefOp.operands, strLitInitSlot)
        PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
            bodyIR, lowering.typedIr, enSrc, enRt,
            nodeIndex, strLitDefOp)
        let _ = coreir.BodyIRAppendOp(bodyIR, strLitDefOp)
        return strLitSlot
    if opKind == texpr.TypedExprIrOpEmptySeqInit:
        let emptySeqSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                              slotNames,
                                                              Fmt"#nev{nodeIndex}",
                                                              coreir.LocalAggregateTag,
                                                              16,
                                                              8)
        let emptySeqInitSlot = PrimaryBodyIrFindOrCreateSlotSized(
            bodyIR,
            slotNames,
            Fmt"#nev{nodeIndex}#owned_init",
            coreir.LocalAggregateTag,
            16,
            8)
        if emptySeqSlot < 0 || emptySeqInitSlot < 0 ||
           !PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                             slotNames,
                                             emptySeqInitSlot,
                                             callOrdinal):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var emptySeqDefOp: coreir.BodyOp
        emptySeqDefOp.kind = coreir.BodyOpCopyLocalTag
        emptySeqDefOp.target = emptySeqSlot
        add(emptySeqDefOp.operands, emptySeqInitSlot)
        PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
            bodyIR, lowering.typedIr, enSrc, enRt,
            nodeIndex, emptySeqDefOp)
        let _ = coreir.BodyIRAppendOp(bodyIR, emptySeqDefOp)
        return emptySeqSlot
    if opKind == texpr.TypedExprIrOpSeqLiteral:
        let seqLitElemSize = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                                         lowering.typedIr.nodes2_elemSizeBytes,
                                                         nodeIndex)
        var seqLitExpectedKind: int32
        var seqLitShapeSize: int32
        var seqLitShapeAlign: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       enSrc,
                                       enLit,
                                       seqLitExpectedKind,
                                       seqLitShapeSize,
                                       seqLitShapeAlign)
        let seqLitI32 = seqLitExpectedKind == coreir.LocalI32Tag &&
                        (seqLitElemSize == 1 ||
                         seqLitElemSize == 2 ||
                         seqLitElemSize == 4)
        let seqLitWide = (seqLitExpectedKind == coreir.LocalI64Tag ||
                          seqLitExpectedKind == coreir.LocalF64Tag) &&
                         seqLitElemSize == 8
        let seqLitStr = seqLitExpectedKind == coreir.LocalStrTag &&
                        seqLitElemSize == 24
        if seqLitShapeSize <= 0 || seqLitShapeAlign <= 0 ||
           (!seqLitI32 && !seqLitWide && !seqLitStr):
            return PrimaryBodyIrNodeEvalMissAt("seq_literal_elem_shape")
        let seqLitSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                            slotNames,
                                                            Fmt"#nev{nodeIndex}",
                                                            coreir.LocalAggregateTag,
                                                            16,
                                                            8)
        if seqLitSlot < 0 ||
           !PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                             slotNames,
                                             seqLitSlot,
                                             callOrdinal):
            return PrimaryBodyIrNodeEvalMissAt("seq_literal")
        var seqLitElemNodes: int32[]
        if !PrimaryBodyIrCollectArgLinkValueNodes(
            lowering.typedIr,
            arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                         lowering.typedIr.nodes2_operand0NodeIndexs,
                                         nodeIndex),
            seqLitElemNodes):
            return PrimaryBodyIrNodeEvalMissAt("seq_literal_chain")
        for seqLitElemIndex in 0..<seqLitElemNodes.len:
            let seqLitElemSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,
                                                       typedFn,
                                                       irFunction,
                                                       seqLitElemNodes[seqLitElemIndex],
                                                       callOrdinal)
            if seqLitElemSlot < 0:
                return -1
            let seqLitElemKind = PrimaryBodyIrSlotType(bodyIR, seqLitElemSlot)
            if seqLitElemKind != seqLitExpectedKind:
                return PrimaryBodyIrNodeEvalMissAt("seq_literal_elem_kind")
            if seqLitExpectedKind == coreir.LocalStrTag:
                if !PrimaryBodyIrAppendSeqStrAddValueSlot(bodyIR,
                                                          slotNames,
                                                          seqLitSlot,
                                                          seqLitElemSlot,
                                                          callOrdinal):
                    return PrimaryBodyIrNodeEvalMissAt("seq_literal_append")
            elif !PrimaryBodyIrAppendSeqScalarValueSlot(bodyIR,
                                                        slotNames,
                                                        seqLitSlot,
                                                        seqLitElemSlot,
                                                        seqLitExpectedKind,
                                                        seqLitElemSize,
                                                        callOrdinal):
                return PrimaryBodyIrNodeEvalMissAt("seq_literal_append")
        if seqLitElemNodes.len <= 0:
            return PrimaryBodyIrNodeEvalMissAt("seq_literal_empty")
        return seqLitSlot
    if opKind == texpr.TypedExprIrOpParamRef || opKind == texpr.TypedExprIrOpLocalRef:
        var refName = enParam
        if refName == "":
            refName = strutil.Strip(enSurf)
        if refName == "":
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let refSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, refName)
        if refSlot < 0 || refSlot >= bodyIR.localSlots.len:
            if opKind == texpr.TypedExprIrOpLocalRef:
                let refGlobalSlot = PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        enSrc,
                                                                        refName)
                if refGlobalSlot >= 0:
                    return PrimaryBodyIrMaterializeManagedBorrowedNodeValueExact(
                        bodyIR,
                        slotNames,
                        lowering.typedIr,
                        enSrc,
                        enRt,
                        refGlobalSlot,
                        nodeIndex)
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if PrimaryBodyIrNameInList(varI32ParamNames, refName):
            let refI32ValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                PrimaryBodyIrVarI32ValueSlotName(refName),
                                                                coreir.LocalI32Tag)
            PrimaryBodyIrAppendVarI32Load(bodyIR, refSlot, refI32ValueSlot)
            return refI32ValueSlot
        let refPointee = PrimaryBodyIrVarParamPointeeKind(bodyIR, refSlot)
        if refPointee == coreir.LocalI64Tag:
            let refI64ValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                PrimaryBodyIrVarI64ValueSlotName(refName),
                                                                coreir.LocalI64Tag)
            PrimaryBodyIrAppendVarI64Load(bodyIR, refSlot, refI64ValueSlot)
            return refI64ValueSlot
        if refPointee == coreir.LocalI32Tag:
            let refI32PointeeSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                  slotNames,
                                                                  PrimaryBodyIrVarI32ValueSlotName(refName),
                                                                  coreir.LocalI32Tag)
            PrimaryBodyIrAppendVarI32Load(bodyIR, refSlot, refI32PointeeSlot)
            return refI32PointeeSlot
        if refPointee != coreir.LocalInvalidTag:
            # 其他指针形参的值读取留给文本路径
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # var str 形参槽按源布局建成 Aggregate(24)+aux=Str+param（VarParamPointeeKind
        # 只认 Ptr 槽，故 refPointee==Invalid）：槽存目的地址，值经 FieldLoad 物化其
        # 指向的 str（offset 0，24 字节），与 var-str 赋值存路径(22037 一带)同款
        # 协议。此前留给文本路径，文本路径在 seq-literal/通用表达式中对该形态落
        # bail_44 cold。
        if PrimaryBodyIrSlotType(bodyIR, refSlot) == coreir.LocalAggregateTag &&
           bodyIR.localSlots[refSlot].auxValue == coreir.LocalStrTag &&
           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[refSlot]):
            let refStrValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                Fmt"#nev_var_str#{nodeIndex}",
                                                                coreir.LocalStrTag)
            if refStrValueSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            var refStrLoadOp: coreir.BodyOp
            refStrLoadOp.kind = coreir.BodyOpFieldLoadTag
            refStrLoadOp.target = refStrValueSlot
            add(refStrLoadOp.operands, refSlot)
            add(refStrLoadOp.operands, refStrValueSlot)
            add(refStrLoadOp.operands, 0)
            add(refStrLoadOp.operands, 24)
            PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
                bodyIR, lowering.typedIr, enSrc, enRt,
                nodeIndex, refStrLoadOp)
            let _ = coreir.BodyIRAppendOp(bodyIR, refStrLoadOp)
            return refStrValueSlot
        return PrimaryBodyIrMaterializeManagedBorrowedNodeValueExact(
            bodyIR,
            slotNames,
            lowering.typedIr,
            enSrc,
            enRt,
            refSlot,
            nodeIndex)
    if opKind == texpr.TypedExprIrOpFieldGet:
        # 动态 seq `.len` 快路径：node 路径的通用 FieldLoad 协议只为 str/scalar
        # pointee 接线 param-地址-deref（见下方 24828 注释），对 `var bool[]` /
        # `var Plan` 形参的 aggregate-seq 槽取 `.len` 无 seq-header 感知 → EvalNode
        # miss 返回 -1（整条 Fmt void-call 语句零 op）。这里镜像已验证的文本路径
        # PrimaryBodyIrSeqLenValueSlot/SeqRefForText（len@header offset0 宽4，含
        # var-param 存地址→正确 deref、nested struct.field 路径），按 node.surfaceText
        # 的完整 `base.len` 表达式物化 i32。与文本路径同一 header 布局，零占位。
        if enLit == "len" &&
           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) >= 0 &&
           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) < lowering.typedIr.nodes2_nodeIndexs.len:
            let seqLenBaseRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)])
            if !IsOk(seqLenBaseRes):
                return PrimaryBodyIrNodeEvalMissAt("intern_lookup")
            # form59 residual: hoist Value(Result[str]) before StripVarType
            let seqLenBase_f59: str = Value(seqLenBaseRes)
            let seqLenBaseType = texpr.TypedExprStripVarType(seqLenBase_f59)
            if PrimaryBodyIrTypeTextIsDynamicSeq(seqLenBaseType):
                let seqLenFastSlot = PrimaryBodyIrSeqLenValueSlot(bodyIR,
                                                                  slotNames,
                                                                  lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  enSrc,
                                                                  arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex),
                                                                  enSurf)
                if seqLenFastSlot >= 0:
                    return seqLenFastSlot
        # ── FieldGet 链原子化（findings b13e304a）：发射任何 op 前沿整条 FieldGet 递归链
        # 预解字段 meta。递归 base 已发射 inner FieldLoad 后外层 MissAt = partial-emission
        # poison（亲手制造 invalid_op，违反 4b）。任一层 fieldOffset/Size 不可解 → 零发射
        # 干净返回 miss（调用方落文本臂 = 今日行为）。emit 前置条件同下方 fieldOffset/Size
        # 门，故今日成功发射的链每层 meta 均合法，预验必过（零漂移）。
        if !PrimaryBodyIrCtorFieldNodeTreeResolvable(lowering.typedIr, nodeIndex):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let fieldRootSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,
                                                  typedFn,
                                                  irFunction,
                                                  arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                  callOrdinal)
        if fieldRootSlot < 0:
            return -1
        # FieldLoad 对 Aggregate/Ptr/Str 根（含 param 槽存地址语义）由填充器
        # 统一处理（str 根经 LoadStrValueAddressToReg，覆盖 str.len/data/
        # store_id/flags 内建字段，offset 由 typed 层 ResolveFieldMeta 填好）；
        # 其他槽形态走文本路径。
        let fieldRootKind = PrimaryBodyIrSlotType(bodyIR, fieldRootSlot)
        if fieldRootKind != coreir.LocalAggregateTag &&
           fieldRootKind != coreir.LocalPtrTag &&
           fieldRootKind != coreir.LocalStrTag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let fieldLoadBytes = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldSizeBytes, nodeIndex)
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldOffsetBytes, nodeIndex) < 0 || fieldLoadBytes <= 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var fieldValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                slotNames,
                                                                lowering.typedIr,
                                                                enSrc,
                                                                Fmt"#nev{nodeIndex}",
                                                                texpr.TypedExprStripVarType(enRt))
        # 两跳/多跳聚合字段（`a.b.c` 里中间跳 b 是内嵌值聚合）：中间跳结果类型是聚合结构体，
        # 其类型文本跨模块常是裸名，经 TypeShapeFromText/SourceObjectLayoutAtDepth 解不出尺寸
        # → typed-slot 退化成 8 字节，装不下真实 fieldSize（实测 needsz=360 slotsz=8）→ 整条
        # 两跳链 miss → bail_631（dispatch_min:1775 `er.bodyIrDetail.X`）。前端已把该内嵌聚合的
        # 真实尺寸填进 nodes2_fieldSizeBytes（上方 fieldLoadBytes，原子化探针已验证 >0），据它直接
        # 建定尺寸聚合槽；FieldLoad 逐字节把内嵌聚合拷进该槽，外层跳再从中读 leaf，语义即浅层复合。
        # 仅当 typed-slot 欠配时触发（标量/str/ptr leaf 的 typed-slot 尺寸恒 >= fieldSize，现绿路径
        # 零漂移），poison-on-miss 保持。孪生 pobjp。
        if fieldValueSlot >= 0 &&
           fieldValueSlot < bodyIR.localSlots.len &&
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[fieldValueSlot]) < fieldLoadBytes:
            fieldValueSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                slotNames,
                                                                Fmt"#nev{nodeIndex}#agg",
                                                                coreir.LocalAggregateTag,
                                                                fieldLoadBytes,
                                                                8)
        if fieldValueSlot < 0 ||
           fieldValueSlot >= bodyIR.localSlots.len ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[fieldValueSlot]) < fieldLoadBytes:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var fieldLoadOp: coreir.BodyOp
        fieldLoadOp.kind = coreir.BodyOpFieldLoadTag
        fieldLoadOp.target = fieldValueSlot
        add(fieldLoadOp.operands, fieldRootSlot)
        add(fieldLoadOp.operands, fieldValueSlot)
        add(fieldLoadOp.operands, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldOffsetBytes, nodeIndex))
        add(fieldLoadOp.operands, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldSizeBytes, nodeIndex))
        var fieldResultHasManaged: bool
        if !texpr.TypedExprIrTypeContainsManagedStorage(lowering.typedIr,
                                                        enSrc,
                                                        enRt,
                                                        fieldResultHasManaged):
            panic("backend2: field result managed-storage authority unavailable")
        if fieldResultHasManaged:
            PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
                bodyIR, lowering.typedIr, enSrc, enRt,
                nodeIndex, fieldLoadOp)
        let _ = coreir.BodyIRAppendOp(bodyIR, fieldLoadOp)
        return fieldValueSlot
    if opKind == texpr.TypedExprIrOpIndexGet:
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let idxBaseRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)])
        if !IsOk(idxBaseRes):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # form59 residual: hoist Value(Result[str]) before StripVarType
        let idxBase_f59: str = Value(idxBaseRes)
        let idxBaseType = texpr.TypedExprStripVarType(idxBase_f59)
        if idxBaseType == "str":
            # str 下标 = 取字节：既有 BodyLoadLocalStrIndexU8 机器
            #（data ptr 间接 + 字节加载，param/local str 根均由填充器处理）。
            let strIdxRootSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,
                                                       typedFn,
                                                       irFunction,
                                                       arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                       callOrdinal)
            if strIdxRootSlot < 0:
                return -1
            if PrimaryBodyIrSlotType(bodyIR, strIdxRootSlot) != coreir.LocalStrTag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            let strIdxSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering,
                                                   typedFn,
                                                   irFunction,
                                                   arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                   callOrdinal)
            if strIdxSlot < 0:
                return -1
            if PrimaryBodyIrSlotType(bodyIR, strIdxSlot) != coreir.LocalI32Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            let strIdxValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                Fmt"#nev{nodeIndex}",
                                                                coreir.LocalI32Tag)
            if strIdxValueSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            var strIdxOp: coreir.BodyOp
            strIdxOp.kind = coreir.BodyOpLoadLocalTag
            strIdxOp.target = strIdxValueSlot
            add(strIdxOp.operands, coreir.BodyLoadLocalStrIndexU8Tag)
            add(strIdxOp.operands, strIdxRootSlot)
            add(strIdxOp.operands, strIdxSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, strIdxOp)
            return strIdxValueSlot
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex) <= 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # 下标基底两形态：动态 seq 头布局（len@0/buf@8，元素在堆 buf 后）与定长
        # fixed array（元素内联于聚合槽，base = 聚合首地址 off=0）。Bytes 下标布局
        # 不同，留文本路径。其余形态拒绝。
        let idxBaseIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(idxBaseType)
        var idxBaseFixedArrayCtx: texpr.TypedExprSourceContext
        idxBaseFixedArrayCtx.sourcePath = typedFn.sourcePath
        let idxBaseIsFixedArray = texpr.TypedExprIrTypeTextIsFixedArray(idxBaseFixedArrayCtx, idxBaseType)
        if !idxBaseIsDynamicSeq && !idxBaseIsFixedArray:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # Fast path: g.field[i] where field is a fixed-size array inside a struct.
        # Instead of materializing the entire array to a stack aggregate via FieldGet
        # (O(array_size) per access), compute element address directly:
        #   addr = struct_base + field_offset + i * elem_stride
        # This turns O(N) per element read into O(1).
        let idxBaseNodeIndex = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
        if idxBaseIsFixedArray && lowering.typedIr.nodes2_opKinds[idxBaseNodeIndex] == texpr.TypedExprIrOpFieldGet &&
           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldOffsetBytes, idxBaseNodeIndex) >= 0 && arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldSizeBytes, idxBaseNodeIndex) > 0 &&
           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, idxBaseNodeIndex) >= 0 && arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, idxBaseNodeIndex) < lowering.typedIr.nodes2_nodeIndexs.len:
            let fldRootSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering,
                                                     typedFn,
                                                     irFunction,
                                                     arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, idxBaseNodeIndex),
                                                     callOrdinal)
            if fldRootSlot >= 0:
                let fldRootKind = PrimaryBodyIrSlotType(bodyIR, fldRootSlot)
                if fldRootKind == coreir.LocalAggregateTag || fldRootKind == coreir.LocalPtrTag:
                    let fldIdxSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,
                                                           typedFn,
                                                           irFunction,
                                                           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                           callOrdinal)
                    if fldIdxSlot >= 0:
                        let fldIdxKind = PrimaryBodyIrSlotType(bodyIR, fldIdxSlot)
                        if fldIdxKind == coreir.LocalI32Tag || fldIdxKind == coreir.LocalI64Tag:
                            let fldElemTypeText = PrimaryBodyIrIndexedElementTypeText(idxBaseType)
                            if fldElemTypeText != "":
                                var fldElemShapeKind: int32
                                var fldElemShapeSize: int32
                                var fldElemShapeAlign: int32
                                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                               enSrc,
                                                               fldElemTypeText,
                                                               fldElemShapeKind,
                                                               fldElemShapeSize,
                                                               fldElemShapeAlign)
                                # Scalar-element fast path only: the element address
                                # feeds a single FieldLoad of width node.elemSizeBytes.
                                # When the element is an aggregate (shape size > load
                                # width, e.g. struct[N] read by value) the whole-field
                                # materialize path below is required — a width-elemSizeBytes
                                # load from a computed #faddr ptr would truncate it.
                                # T78 v4: require only shape>=load-width, not equality.
                                # A FIXED bool[N] struct field's front-end elemSizeBytes
                                # (node.elemSizeBytes) is the packed logical width (1B,
                                # TypedExprTypeLayout convention), but its true inline
                                # stride is the backend's aligned register width
                                # (fldElemShapeSize, bool=4B, TypeShapeFromText — same
                                # family as every other fixed-array elemSize consumer in
                                # this T78 series). The old `==` gate rejected this
                                # (4 != 1) and fell through to the whole-field-materialize
                                # path below, which copies only node.elemSizeBytes*count
                                # bytes (front-end packed size) into the temp aggregate
                                # slot and then indexes it at the ALIGNED stride computed
                                # further down (idxElemStride) — walking off the end of
                                # the undersized copy for index>0 (silent wrong value /
                                # stack-garbage read, adv_struct_field_arr_if/
                                # adv_struct_field_arr_noand). Taking this direct-address
                                # fast path instead (struct_base+field_offset+idx*aligned
                                # stride) sidesteps the undersized copy entirely; the
                                # FieldLoad below keeps the narrower node.elemSizeBytes
                                # width, which is correct at the aligned address (the
                                # logical value lives in the low bytes of each
                                # register-width-aligned slot, matching the store side).
                                let idxNodeElemSizeBytes = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex)
                                # T78 v5: the >= widening above only re-derives the
                                # element stride; it says nothing about whether
                                # fldRootSlot (g in g.field[i]) is actually a simple,
                                # single-address root. When idxBaseNodeIndex's own
                                # base is an IndexGet (array-of-struct: xs[i].arr[j],
                                # confirmed via node inspection to hold even for a
                                # literal index like xs[0] — the front end does not
                                # constant-fold it away), the recursive eval below
                                # still returns an Aggregate/Ptr slot, but it is not
                                # guaranteed to be the per-index element address this
                                # fast path assumes — this combination was never in
                                # the verified fixture set and produced a
                                # data-independent constant (adv_nested_arrstruct_*
                                # regression) because the paired array-of-struct
                                # WRITE path stores at a different location (task
                                # #10, separately tracked). Require the base to be a
                                # bare identifier (ParamRef/LocalRef) or a
                                # single-hop FieldGet chain (s.t.arr[i], already
                                # verified to generalize correctly); anything else,
                                # in particular IndexGet, falls through to the
                                # existing whole-field-materialize path below.
                                let idxBaseFieldRootKind = lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, idxBaseNodeIndex)]
                                if fldElemShapeSize > 0 && fldElemShapeSize >= idxNodeElemSizeBytes &&
                                   (idxNodeElemSizeBytes == 1 || idxNodeElemSizeBytes == 2 ||
                                    idxNodeElemSizeBytes == 4 || idxNodeElemSizeBytes == 8) &&
                                   (idxBaseFieldRootKind == texpr.TypedExprIrOpParamRef ||
                                    idxBaseFieldRootKind == texpr.TypedExprIrOpLocalRef ||
                                    idxBaseFieldRootKind == texpr.TypedExprIrOpFieldGet):
                                    let fldBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                                                       slotNames,
                                                                                       arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex),
                                                                                       fldRootSlot,
                                                                                       arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldOffsetBytes, idxBaseNodeIndex))
                                    if fldBaseSlot >= 0:
                                        let fldStrideSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                                            slotNames,
                                                                                            Fmt"#nev{nodeIndex}#fesz",
                                                                                            coreir.LocalI64Tag,
                                                                                            fldElemShapeSize)
                                        if fldStrideSlot >= 0:
                                            let fldAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                            slotNames,
                                                                                            Fmt"#nev{nodeIndex}#faddr",
                                                                                            coreir.LocalPtrTag)
                                            if fldAddrSlot >= 0:
                                                var fldMaddOp: coreir.BodyOp
                                                fldMaddOp.kind = coreir.BodyOpBinOpTag
                                                fldMaddOp.target = fldAddrSlot
                                                add(fldMaddOp.operands, coreir.LocalI64Tag)
                                                add(fldMaddOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                                                add(fldMaddOp.operands, fldIdxSlot)
                                                add(fldMaddOp.operands, fldStrideSlot)
                                                add(fldMaddOp.operands, fldBaseSlot)
                                                let _ = coreir.BodyIRAppendOp(bodyIR, fldMaddOp)
                                                let fldValSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                                    slotNames,
                                                                                                    lowering.typedIr,
                                                                                                    enSrc,
                                                                                                    Fmt"#nev{nodeIndex}",
                                                                                                    texpr.TypedExprStripVarType(enRt))
                                                if fldValSlot >= 0 &&
                                                   fldValSlot < bodyIR.localSlots.len &&
                                                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[fldValSlot]) >= arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex):
                                                    var fldLoadOp: coreir.BodyOp
                                                    fldLoadOp.kind = coreir.BodyOpFieldLoadTag
                                                    fldLoadOp.target = fldValSlot
                                                    add(fldLoadOp.operands, fldAddrSlot)
                                                    add(fldLoadOp.operands, fldValSlot)
                                                    add(fldLoadOp.operands, 0)
                                                    add(fldLoadOp.operands, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex))
                                                    var fldValueHasManaged: bool
                                                    if !texpr.TypedExprIrTypeContainsManagedStorage(lowering.typedIr, enSrc, enRt, fldValueHasManaged):
                                                        panic("backend2: indexed field result managed-storage authority unavailable")
                                                    if fldValueHasManaged:
                                                        PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
                                                            bodyIR, lowering.typedIr, enSrc, enRt,
                                                            nodeIndex, fldLoadOp)
                                                    let _ = coreir.BodyIRAppendOp(bodyIR, fldLoadOp)
                                                    return fldValSlot
        let idxRootSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                slotNames,
                                                varI32ParamNames,
                                                lowering,
                                                typedFn,
                                                irFunction,
                                                arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                callOrdinal)
        if idxRootSlot < 0:
            return -1
        let idxRootKind = PrimaryBodyIrSlotType(bodyIR, idxRootSlot)
        if idxRootKind != coreir.LocalAggregateTag &&
           idxRootKind != coreir.LocalPtrTag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # 定长数组根两形态：Aggregate 栈内联(其首地址即元素 0 地址,下方 off=0 取槽址);
        # Ptr=全局/按指针定长数组,该 Ptr 持有数组首元素地址(GlobalSeqAddressSlot 的
        # adrp+add 值),直接作元素基址(下方分流)。25529 已确保根为 Aggregate 或 Ptr。
        let idxSlot = PrimaryBodyIrEvalNode(bodyIR,
                                            slotNames,
                                            varI32ParamNames,
                                            lowering,
                                            typedFn,
                                            irFunction,
                                            arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                            callOrdinal)
        if idxSlot < 0:
            return -1
        let idxKind = PrimaryBodyIrSlotType(bodyIR, idxSlot)
        if idxKind != coreir.LocalI32Tag && idxKind != coreir.LocalI64Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # 元素步长/读宽：动态 seq 的 buf 按 typed 层逻辑宽紧致打包，沿用
        # node.elemSizeBytes。定长内联数组的元素槽按后端 TypeShapeFromText 的
        # 对齐槽宽布局（bool 槽 4B 而非逻辑 1B；存路径 `flags[i]=v` 即按 ×4 步长
        # 全字存），必须取同款槽宽，否则读步长/读宽与存不一致 → 读到错位元素。
        var idxElemStride = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex)
        if idxBaseIsFixedArray:
            let idxElemTypeText = PrimaryBodyIrIndexedElementTypeText(idxBaseType)
            if idxElemTypeText == "":
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            var idxElemShapeKind: int32
            var idxElemShapeSize: int32
            var idxElemShapeAlign: int32
            PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                           enSrc,
                                           idxElemTypeText,
                                           idxElemShapeKind,
                                           idxElemShapeSize,
                                           idxElemShapeAlign)
            if idxElemShapeSize <= 0 || idxElemShapeSize < arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex):
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            idxElemStride = idxElemShapeSize
        elif idxBaseIsDynamicSeq:
            # 动态 seq 的 buf 对聚合元素按真 struct size 连续打包（与 store 侧
            # PrimaryBodyIrTypeShapeFromText 取真 elemSize 一致），但前端
            # TypedExprTypeLayout 对跨模块未载入上下文的聚合类型退化返
            # sizeBytes=4，灌进 node.elemSizeBytes → 地址步长与 FieldLoad 读宽
            # 都只覆盖首 4 字节，余字节留未初始化 0x0 空洞。这里取后端真元素
            # shape：仅当为聚合且 > node.elemSizeBytes 时令 idxElemStride=真宽
            # （地址 Madd 步长 + FieldLoad byteCount 同时用真宽）。标量/紧致
            # 元素（bool 1B、int32 4B 等）保持 node.elemSizeBytes 不变，与
            # 24746-24749 逻辑紧致打包语义对齐。shape 解析失败也保持退化值，
            # 标量场景常态不应被拒。
            let idxSeqElemTypeText = PrimaryBodyIrIndexedElementTypeText(idxBaseType)
            if idxSeqElemTypeText != "":
                var idxSeqElemShapeKind: int32
                var idxSeqElemShapeSize: int32
                var idxSeqElemShapeAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               enSrc,
                                               idxSeqElemTypeText,
                                               idxSeqElemShapeKind,
                                               idxSeqElemShapeSize,
                                               idxSeqElemShapeAlign)
                if idxSeqElemShapeKind == coreir.LocalAggregateTag &&
                   idxSeqElemShapeSize > arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex):
                    idxElemStride = idxSeqElemShapeSize
        var idxBufSlot: int32 = -1
        if idxBaseIsFixedArray:
            if idxRootKind == coreir.LocalPtrTag:
                # 全局/按指针定长数组：idxRootSlot 已持有数组首元素地址(GlobalSeqAddressSlot
                # adrp+add 值),直接作元素基址,不再取槽地址(取槽址会得到持指针的栈槽地址=错)。
                idxBufSlot = idxRootSlot
            else:
                # 聚合栈内联：base = 聚合首地址（off=0），元素内联，无 buf 间接。
                idxBufSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                              slotNames,
                                                              arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex),
                                                              idxRootSlot,
                                                              0)
            if idxBufSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        else:
            idxBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#nev{nodeIndex}#buf",
                                                       coreir.LocalPtrTag)
            if idxBufSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            var idxBufLoadOp: coreir.BodyOp
            idxBufLoadOp.kind = coreir.BodyOpFieldLoadTag
            idxBufLoadOp.target = idxBufSlot
            add(idxBufLoadOp.operands, idxRootSlot)
            add(idxBufLoadOp.operands, idxBufSlot)
            add(idxBufLoadOp.operands, 8)
            add(idxBufLoadOp.operands, 8)
            let _ = coreir.BodyIRAppendOp(bodyIR, idxBufLoadOp)
        let idxEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"#nev{nodeIndex}#esz",
                                                         coreir.LocalI64Tag,
                                                         idxElemStride)
        if idxEszSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let idxAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"#nev{nodeIndex}#addr",
                                                        coreir.LocalPtrTag)
        if idxAddrSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var idxAddrOp: coreir.BodyOp
        idxAddrOp.kind = coreir.BodyOpBinOpTag
        idxAddrOp.target = idxAddrSlot
        add(idxAddrOp.operands, coreir.LocalI64Tag)
        add(idxAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
        add(idxAddrOp.operands, idxSlot)
        add(idxAddrOp.operands, idxEszSlot)
        add(idxAddrOp.operands, idxBufSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, idxAddrOp)
        let idxValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              enSrc,
                                                              Fmt"#nev{nodeIndex}",
                                                              texpr.TypedExprStripVarType(enRt))
        # 读宽必须取 idxElemStride（定长数组 = 后端真 shape；动态 seq = 逻辑紧致宽），
        # 不能用前端退化的 node.elemSizeBytes：跨模块聚合元素（如 NormalizedExpr[N]）
        # 前端类型布局会退化成 4，但后端槽与地址步长是真 shape（272B）。若仍用
        # elemSizeBytes 当 FieldLoad byteCount，对 272B 聚合元素只拷首 4 字节，余下
        # 268 字节留未初始化 → 按值拷贝/sret 时机器字层面出现 0x0 空洞。槽宽守卫
        # 同步按全元素宽度（idxElemStride）校验，匹配 g.field[i] 快路径的整字段读语义。
        if idxValueSlot < 0 ||
           idxValueSlot >= bodyIR.localSlots.len ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[idxValueSlot]) < idxElemStride:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var idxElemLoadOp: coreir.BodyOp
        idxElemLoadOp.kind = coreir.BodyOpFieldLoadTag
        idxElemLoadOp.target = idxValueSlot
        add(idxElemLoadOp.operands, idxAddrSlot)
        add(idxElemLoadOp.operands, idxValueSlot)
        add(idxElemLoadOp.operands, 0)
        add(idxElemLoadOp.operands, idxElemStride)
        var idxValueHasManaged: bool
        if !texpr.TypedExprIrTypeContainsManagedStorage(lowering.typedIr, enSrc, enRt, idxValueHasManaged):
            panic("backend2: indexed result managed-storage authority unavailable")
        if idxValueHasManaged:
            PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
                bodyIR, lowering.typedIr, enSrc, enRt,
                nodeIndex, idxElemLoadOp)
        let _ = coreir.BodyIRAppendOp(bodyIR, idxElemLoadOp)
        return idxValueSlot
    let cmpCondTag = PrimaryBodyIrNodeEvalCmpCondTag(opKind)
    if cmpCondTag >= 0:
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len ||
           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # str 比较是值语义（Cmp 是指针/整型寄存器比较）。等值比较且一侧
        # 为字符串字面量时经 BodyOpStrEqLiteral 降，两侧均为 str 槽时经
        # BodyOpStrEq 双槽比较降（!= 经 XOR 1 取反）；其余 str 形状先于
        # 操作数求值拒绝，避免发出死字符串物化调用。
        let enOp0RtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)])
        let enOp0LitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)])
        let enOp1RtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)])
        let enOp1LitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)])
        if !IsOk(enOp0RtRes) || !IsOk(enOp0LitRes) || !IsOk(enOp1RtRes) || !IsOk(enOp1LitRes):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let enOp0Rt = Value(enOp0RtRes)
        let enOp0Lit = Value(enOp0LitRes)
        let enOp1Rt = Value(enOp1RtRes)
        let enOp1Lit = Value(enOp1LitRes)
        if texpr.TypedExprStripVarType(enOp0Rt) == "str" ||
           texpr.TypedExprStripVarType(enOp1Rt) == "str":
            if opKind != texpr.TypedExprIrOpCmpEq && opKind != texpr.TypedExprIrOpCmpNe:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            var strCmpValueNode = -1
            var strCmpLiteralText = ""
            if lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpStrLit:
                if PrimaryBodyIrTextIsStringLiteral(enOp1Lit):
                    strCmpValueNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
                    strCmpLiteralText = enOp1Lit
            if strCmpValueNode < 0 &&
               lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpStrLit:
                if PrimaryBodyIrTextIsStringLiteral(enOp0Lit):
                    strCmpValueNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)
                    strCmpLiteralText = enOp0Lit
            var strCmpEqSlot = -1
            if strCmpValueNode < 0:
                let strCmpLhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                          callOrdinal)
                if strCmpLhsSlot < 0:
                    return -1
                if PrimaryBodyIrSlotType(bodyIR, strCmpLhsSlot) != coreir.LocalStrTag:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                let strCmpRhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                          callOrdinal)
                if strCmpRhsSlot < 0:
                    return -1
                if PrimaryBodyIrSlotType(bodyIR, strCmpRhsSlot) != coreir.LocalStrTag:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                strCmpEqSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#nev{nodeIndex}",
                                                             coreir.LocalI32Tag)
                if strCmpEqSlot < 0:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                var strCmpTwoSlotOp: coreir.BodyOp
                strCmpTwoSlotOp.kind = coreir.BodyOpStrEqTag
                strCmpTwoSlotOp.target = strCmpEqSlot
                add(strCmpTwoSlotOp.operands, strCmpLhsSlot)
                add(strCmpTwoSlotOp.operands, strCmpRhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, strCmpTwoSlotOp)
            else:
                let strCmpValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,
                                                            typedFn,
                                                            irFunction,
                                                            strCmpValueNode,
                                                            callOrdinal)
                if strCmpValueSlot < 0:
                    return -1
                if PrimaryBodyIrSlotType(bodyIR, strCmpValueSlot) != coreir.LocalStrTag:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                let strCmpLiteralId = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                                                        PrimaryBodyIrStringLiteralPayload(strCmpLiteralText),
                                                                        "")
                strCmpEqSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#nev{nodeIndex}",
                                                             coreir.LocalI32Tag)
                if strCmpEqSlot < 0:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                var strCmpEqOp: coreir.BodyOp
                strCmpEqOp.kind = coreir.BodyOpStrEqLiteralTag
                strCmpEqOp.target = strCmpEqSlot
                add(strCmpEqOp.operands, strCmpValueSlot)
                add(strCmpEqOp.operands, strCmpLiteralId)
                let _ = coreir.BodyIRAppendOp(bodyIR, strCmpEqOp)
            if opKind == texpr.TypedExprIrOpCmpEq:
                return strCmpEqSlot
            let strCmpOneSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                slotNames,
                                                                Fmt"#nev{nodeIndex}#one",
                                                                coreir.LocalI32Tag,
                                                                1)
            if strCmpOneSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            let strCmpNeSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#nev{nodeIndex}#ne",
                                                             coreir.LocalI32Tag)
            if strCmpNeSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            var strCmpNeOp: coreir.BodyOp
            strCmpNeOp.kind = coreir.BodyOpBinOpTag
            strCmpNeOp.target = strCmpNeSlot
            add(strCmpNeOp.operands, coreir.LocalI32Tag)
            add(strCmpNeOp.operands, int32(texpr.TypedExprIrOpI32BitXor))
            add(strCmpNeOp.operands, strCmpEqSlot)
            add(strCmpNeOp.operands, strCmpOneSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, strCmpNeOp)
            return strCmpNeSlot
        if opKind == texpr.TypedExprIrOpCmpEq || opKind == texpr.TypedExprIrOpCmpNe:
            var nilCmpValueNode = -1
            var nilCmpNilNode = -1
            if lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpNilPtr:
                nilCmpNilNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
                nilCmpValueNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)
            elif lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpNilPtr:
                nilCmpNilNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)
                nilCmpValueNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
            if nilCmpValueNode >= 0 && nilCmpNilNode >= 0:
                # 指针形态由值侧求值槽类标(Ptr/I64)判定,与探针同款。文本指针
                # 判定漏命名 ref 记录类型,改以求值后的槽类标为准。
                let nilCmpValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,
                                                            typedFn,
                                                            irFunction,
                                                            nilCmpValueNode,
                                                            callOrdinal)
                if nilCmpValueSlot < 0:
                    return -1
                let nilCmpValueKind = PrimaryBodyIrSlotType(bodyIR, nilCmpValueSlot)
                if nilCmpValueKind != coreir.LocalPtrTag &&
                   nilCmpValueKind != coreir.LocalI64Tag:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                let nilCmpNilSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          nilCmpNilNode,
                                                          callOrdinal)
                if nilCmpNilSlot < 0:
                    return -1
                if PrimaryBodyIrSlotType(bodyIR, nilCmpNilSlot) != coreir.LocalPtrTag:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                let nilCmpResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                     slotNames,
                                                                     Fmt"#nev{nodeIndex}",
                                                                     coreir.LocalI32Tag)
                if nilCmpResultSlot < 0:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                var nilCmpOp: coreir.BodyOp
                nilCmpOp.kind = coreir.BodyOpCmpTag
                nilCmpOp.target = nilCmpResultSlot
                add(nilCmpOp.operands, cmpCondTag)
                add(nilCmpOp.operands, nilCmpValueSlot)
                add(nilCmpOp.operands, nilCmpNilSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, nilCmpOp)
                return nilCmpResultSlot
        let cmpLhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                               callOrdinal)
        if cmpLhsSlot < 0:
            return -1
        let cmpRhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                               callOrdinal)
        if cmpRhsSlot < 0:
            return -1
        let cmpLhsKind = PrimaryBodyIrSlotType(bodyIR, cmpLhsSlot)
        let cmpRhsKind = PrimaryBodyIrSlotType(bodyIR, cmpRhsSlot)
        var cmpKindsOk = true
        # 指针相等(==/!=)良定义:两侧均 Ptr 时 FillCmpOp 发 64 位 CMP(arm64/x86_64
        # 均置 cmpIs64)。kinds 相等故跳过 widen(下方 cmpLhsKind!=cmpRhsKind)、ptr
        # 非无符号整型故跳过 unsigned-cond 分支,发出标量 BodyOpCmp 正确。
        let cmpPtrEq = cmpLhsKind == coreir.LocalPtrTag && cmpRhsKind == coreir.LocalPtrTag &&
                       (opKind == texpr.TypedExprIrOpCmpEq || opKind == texpr.TypedExprIrOpCmpNe)
        let cmpF64 = cmpLhsKind == coreir.LocalF64Tag && cmpRhsKind == coreir.LocalF64Tag
        if !cmpPtrEq && !cmpF64 && cmpLhsKind != coreir.LocalI32Tag && cmpLhsKind != coreir.LocalI64Tag:
            cmpKindsOk = false
        if !cmpPtrEq && !cmpF64 && cmpRhsKind != coreir.LocalI32Tag && cmpRhsKind != coreir.LocalI64Tag:
            cmpKindsOk = false
        if !cmpKindsOk:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var cmpLhsFinal = cmpLhsSlot
        var cmpRhsFinal = cmpRhsSlot
        if cmpLhsKind != cmpRhsKind:
            cmpLhsFinal = PrimaryBodyIrNodeEvalWidenToI64(bodyIR, slotNames, cmpLhsSlot, nodeIndex, 0)
            cmpRhsFinal = PrimaryBodyIrNodeEvalWidenToI64(bodyIR, slotNames, cmpRhsSlot, nodeIndex, 1)
            if cmpLhsFinal < 0 || cmpRhsFinal < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let cmpResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}",
                                                          coreir.LocalI32Tag)
        if cmpResultSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # 无符号操作数的序比较必须发无符号条件码(hi/hs/lo/ls)。仅当两侧
        # 操作数静态类型都是无符号整型时提升 tag；否则维持有符号(int32
        # 负数比较等仍正确)。U32/U64 由最终比较槽宽决定。
        var cmpEmitCondTag = cmpCondTag
        let cmpLhsUnsigned = PrimaryBodyIrTypeTextIsUnsignedInt(
            texpr.TypedExprStripVarType(enOp0Rt))
        let cmpRhsUnsigned = PrimaryBodyIrTypeTextIsUnsignedInt(
            texpr.TypedExprStripVarType(enOp1Rt))
        if cmpF64:
            cmpEmitCondTag = PrimaryBodyIrNodeEvalF64CmpCondTag(cmpCondTag)
            if cmpEmitCondTag < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        elif cmpLhsUnsigned && cmpRhsUnsigned:
            let cmpFinalKind = PrimaryBodyIrSlotType(bodyIR, cmpLhsFinal)
            let cmpRhsFinalKind = PrimaryBodyIrSlotType(bodyIR, cmpRhsFinal)
            var cmpIsWide = false
            if cmpFinalKind == coreir.LocalI64Tag || cmpRhsFinalKind == coreir.LocalI64Tag:
                cmpIsWide = true
            cmpEmitCondTag = PrimaryBodyIrNodeEvalUnsignedCmpCondTag(cmpCondTag, cmpIsWide)
        var cmpOp: coreir.BodyOp
        cmpOp.kind = coreir.BodyOpCmpTag
        cmpOp.target = cmpResultSlot
        add(cmpOp.operands, cmpEmitCondTag)
        add(cmpOp.operands, cmpLhsFinal)
        add(cmpOp.operands, cmpRhsFinal)
        let _ = coreir.BodyIRAppendOp(bodyIR, cmpOp)
        return cmpResultSlot
    if opKind == texpr.TypedExprIrOpLogAnd || opKind == texpr.TypedExprIrOpLogOr:
        # 非短路位运算等价仅在操作数无副作用/无故障风险时成立：含 CallExpr 的
        # 操作数必须留给文本路径；下标读(IndexGet)同理(T78, eager 位与/位或
        # 无分支保护地读, 越界即 SIGSEGV)。
        if PrimaryBodyIrNodeTreeHasFaultingEagerSurface(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)) ||
           PrimaryBodyIrNodeTreeHasFaultingEagerSurface(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let logLhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                               callOrdinal)
        if logLhsSlot < 0:
            return -1
        let logRhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                               callOrdinal)
        if logRhsSlot < 0:
            return -1
        if PrimaryBodyIrSlotType(bodyIR, logLhsSlot) != coreir.LocalI32Tag ||
           PrimaryBodyIrSlotType(bodyIR, logRhsSlot) != coreir.LocalI32Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var logBaseOp = int32(texpr.TypedExprIrOpI32BitAnd)
        if opKind == texpr.TypedExprIrOpLogOr:
            logBaseOp = int32(texpr.TypedExprIrOpI32BitOr)
        let logResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}",
                                                          coreir.LocalI32Tag)
        if logResultSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var logOp: coreir.BodyOp
        logOp.kind = coreir.BodyOpBinOpTag
        logOp.target = logResultSlot
        add(logOp.operands, coreir.LocalI32Tag)
        add(logOp.operands, logBaseOp)
        add(logOp.operands, logLhsSlot)
        add(logOp.operands, logRhsSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, logOp)
        return logResultSlot
    if opKind == texpr.TypedExprIrOpLogNot:
        let notInnerSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,
                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                 callOrdinal)
        if notInnerSlot < 0:
            return -1
        if PrimaryBodyIrSlotType(bodyIR, notInnerSlot) != coreir.LocalI32Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let notOneSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"#nev{nodeIndex}#one",
                                                         coreir.LocalI32Tag,
                                                         1)
        if notOneSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let notResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}",
                                                          coreir.LocalI32Tag)
        if notResultSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var notOp: coreir.BodyOp
        notOp.kind = coreir.BodyOpBinOpTag
        notOp.target = notResultSlot
        add(notOp.operands, coreir.LocalI32Tag)
        add(notOp.operands, int32(texpr.TypedExprIrOpI32BitXor))
        add(notOp.operands, notInnerSlot)
        add(notOp.operands, notOneSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, notOp)
        return notResultSlot
    if opKind == texpr.TypedExprIrOpNeg:
        var negTypeTag = coreir.LocalI32Tag
        let negTypeText = texpr.TypedExprStripVarType(enRt)
        if negTypeText == "int64":
            negTypeTag = coreir.LocalI64Tag
        elif negTypeText == "float64" || negTypeText == "f64":
            negTypeTag = coreir.LocalF64Tag
        elif negTypeText != "int32":
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var negInnerSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,
                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                 callOrdinal)
        if negInnerSlot < 0:
            return -1
        if negTypeTag == coreir.LocalI64Tag:
            negInnerSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR, slotNames, negInnerSlot, nodeIndex, 0)
            if negInnerSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        elif negTypeTag == coreir.LocalF64Tag:
            if PrimaryBodyIrSlotType(bodyIR, negInnerSlot) != coreir.LocalF64Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        elif PrimaryBodyIrSlotType(bodyIR, negInnerSlot) != coreir.LocalI32Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var negZeroSlot: int32
        var negOpKind = int32(texpr.TypedExprIrOpI32Sub)
        if negTypeTag == coreir.LocalF64Tag:
            negZeroSlot = PrimaryBodyIrLocalInitF64ConstSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"#nev{nodeIndex}#zero",
                                                            "0.0")
            negOpKind = int32(texpr.TypedExprIrOpF64Sub)
        else:
            negZeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}#zero",
                                                          negTypeTag,
                                                          0)
        if negZeroSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let negResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}",
                                                          negTypeTag)
        if negResultSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var negOp: coreir.BodyOp
        negOp.kind = coreir.BodyOpBinOpTag
        negOp.target = negResultSlot
        add(negOp.operands, negTypeTag)
        add(negOp.operands, negOpKind)
        add(negOp.operands, negZeroSlot)
        add(negOp.operands, negInnerSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, negOp)
        return negResultSlot
    var binTypeTag: int32
    var binBaseOp: int32
    var binIsMod: bool
    var binModDivBaseOp: int32
    if PrimaryBodyIrNodeEvalBinOpMeta(opKind, binTypeTag, binBaseOp, binIsMod, binModDivBaseOp):
        var binLhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                               callOrdinal)
        if binLhsSlot < 0:
            return -1
        var binRhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                               callOrdinal)
        if binRhsSlot < 0:
            return -1
        if binTypeTag == coreir.LocalF64Tag:
            if PrimaryBodyIrSlotType(bodyIR, binLhsSlot) != coreir.LocalF64Tag ||
               PrimaryBodyIrSlotType(bodyIR, binRhsSlot) != coreir.LocalF64Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        elif binTypeTag == coreir.LocalI64Tag:
            binLhsSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR, slotNames, binLhsSlot, nodeIndex, 0)
            binRhsSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR, slotNames, binRhsSlot, nodeIndex, 1)
            if binLhsSlot < 0 || binRhsSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        else:
            if PrimaryBodyIrSlotType(bodyIR, binLhsSlot) != coreir.LocalI32Tag ||
               PrimaryBodyIrSlotType(bodyIR, binRhsSlot) != coreir.LocalI32Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let binResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}",
                                                          binTypeTag)
        if binResultSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if binIsMod:
            # mod = lhs - (lhs / rhs) * rhs（既有 -100 三连模式同款）
            let modQuotientSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                Fmt"#nev{nodeIndex}#q",
                                                                binTypeTag)
            let modProductSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                               slotNames,
                                                               Fmt"#nev{nodeIndex}#p",
                                                               binTypeTag)
            if modQuotientSlot < 0 || modProductSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            var modDivOp: coreir.BodyOp
            modDivOp.kind = coreir.BodyOpBinOpTag
            modDivOp.target = modQuotientSlot
            add(modDivOp.operands, binTypeTag)
            add(modDivOp.operands, binModDivBaseOp)
            add(modDivOp.operands, binLhsSlot)
            add(modDivOp.operands, binRhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, modDivOp)
            var modMulOp: coreir.BodyOp
            modMulOp.kind = coreir.BodyOpBinOpTag
            modMulOp.target = modProductSlot
            add(modMulOp.operands, binTypeTag)
            add(modMulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
            add(modMulOp.operands, modQuotientSlot)
            add(modMulOp.operands, binRhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, modMulOp)
            var modRemOp: coreir.BodyOp
            modRemOp.kind = coreir.BodyOpBinOpTag
            modRemOp.target = binResultSlot
            add(modRemOp.operands, binTypeTag)
            add(modRemOp.operands, int32(texpr.TypedExprIrOpI32Sub))
            add(modRemOp.operands, binLhsSlot)
            add(modRemOp.operands, modProductSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, modRemOp)
            return binResultSlot
        var binOp: coreir.BodyOp
        binOp.kind = coreir.BodyOpBinOpTag
        binOp.target = binResultSlot
        add(binOp.operands, binTypeTag)
        add(binOp.operands, binBaseOp)
        add(binOp.operands, binLhsSlot)
        add(binOp.operands, binRhsSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
        return binResultSlot
    if opKind == texpr.TypedExprIrOpStrAdd:
        let strAddLhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,
                                                  typedFn,
                                                  irFunction,
                                                  arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                  callOrdinal)
        if strAddLhsSlot < 0:
            return -1
        if PrimaryBodyIrSlotType(bodyIR, strAddLhsSlot) != coreir.LocalStrTag:
            return PrimaryBodyIrNodeEvalMissAt("str_add_lhs_kind")
        let strAddRhsSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,
                                                  typedFn,
                                                  irFunction,
                                                  arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                  callOrdinal)
        if strAddRhsSlot < 0:
            return -1
        if PrimaryBodyIrSlotType(bodyIR, strAddRhsSlot) != coreir.LocalStrTag:
            return PrimaryBodyIrNodeEvalMissAt("str_add_rhs_kind")
        let strAddTargetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#nev{nodeIndex}",
                                                             coreir.LocalStrTag)
        if strAddTargetSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var strAddConcatCall: coreir.CallOp
        strAddConcatCall.targetSymbol = "driver_c_str_concat_bridge"
        strAddConcatCall.resultSlot = strAddTargetSlot
        strAddConcatCall.resultPassKind = coreir.BodyCallPassSretResultTag
        add(strAddConcatCall.argSlots, strAddLhsSlot)
        add(strAddConcatCall.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(strAddConcatCall.argSlots, strAddRhsSlot)
        add(strAddConcatCall.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(bodyIR.callSequence, strAddConcatCall)
        var strAddConcatOp: coreir.BodyOp
        strAddConcatOp.kind = coreir.BodyOpCallTag
        strAddConcatOp.target = strAddTargetSlot
        add(strAddConcatOp.operands, callOrdinal)
        let _ = coreir.BodyIRAppendOp(bodyIR, strAddConcatOp)
        callOrdinal = callOrdinal + 1
        return strAddTargetSlot
    if opKind == texpr.TypedExprIrOpFmt:
        var fmtPieceNodes: int32[]
        if !PrimaryBodyIrCollectArgLinkValueNodes(
            lowering.typedIr,
            arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                         lowering.typedIr.nodes2_operand0NodeIndexs,
                                         nodeIndex),
            fmtPieceNodes):
            return PrimaryBodyIrNodeEvalMissAt("fmt_piece_chain")
        let fmtTargetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}",
                                                          coreir.LocalStrTag)
        if fmtTargetSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let fmtSeqSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                            slotNames,
                                                            Fmt"#nev{nodeIndex}#fmt_parts",
                                                            coreir.LocalAggregateTag,
                                                            16,
                                                            8)
        if fmtSeqSlot < 0 ||
           !PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                             slotNames,
                                             fmtSeqSlot,
                                             callOrdinal):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        for fmtPieceIndex in 0..<fmtPieceNodes.len:
            let fmtValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering,
                                                     typedFn,
                                                     irFunction,
                                                     fmtPieceNodes[fmtPieceIndex],
                                                     callOrdinal)
            if fmtValueSlot < 0:
                return -1
            if !PrimaryBodyIrAppendFmtExprValueSlot(bodyIR,
                                                    slotNames,
                                                    fmtTargetSlot,
                                                    fmtSeqSlot,
                                                    fmtValueSlot,
                                                    fmtPieceIndex,
                                                    callOrdinal):
                return PrimaryBodyIrNodeEvalMissAt("fmt_piece_append")
        let fmtSepSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#nev{nodeIndex}#fmt_sep",
                                                       coreir.LocalStrTag)
        if fmtSepSlot < 0 ||
           !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                  slotNames,
                                                  "\"\"",
                                                  fmtSepSlot,
                                                  callOrdinal):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var fmtJoinCall: coreir.CallOp
        fmtJoinCall.targetSymbol = "cheng_strutils_join_bridge"
        fmtJoinCall.resultSlot = fmtTargetSlot
        fmtJoinCall.resultPassKind = coreir.BodyCallPassSretResultTag
        add(fmtJoinCall.argSlots, fmtSeqSlot)
        add(fmtJoinCall.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(fmtJoinCall.argSlots, fmtSepSlot)
        add(fmtJoinCall.argPassKinds, coreir.BodyCallPassStackValueTag)
        if !PrimaryBodyIrRewriteStrutilsJoinBridgeAddressArgs(fmtJoinCall):
            return PrimaryBodyIrNodeEvalMissAt("fmt_join_arg_abi")
        PrimaryBodyIrFillPendingCallArgAbiSizes(fmtJoinCall, bodyIR)
        add(bodyIR.callSequence, fmtJoinCall)
        var fmtJoinOp: coreir.BodyOp
        fmtJoinOp.kind = coreir.BodyOpCallTag
        fmtJoinOp.target = fmtTargetSlot
        add(fmtJoinOp.operands, callOrdinal)
