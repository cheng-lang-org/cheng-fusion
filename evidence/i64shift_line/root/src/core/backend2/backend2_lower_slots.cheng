                    os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=probe reason=src_kind function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex)} arg={probeRvArgName} kind={PrimaryBodyIrSlotType(bodyIR, probeRvSrcSlot)}")
                return PrimaryBodyIrNodeEvalMissAt("result_project")
