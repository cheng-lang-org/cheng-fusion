            if probeCastArgKind == coreir.LocalPtrTag:
                if probeCastKind != coreir.LocalI64Tag:
                    return PrimaryBodyIrNodeEvalMissAt("cast_arg_kind")
                return probeCastKind
            if probeCastArgKind != coreir.LocalI32Tag &&
               probeCastArgKind != coreir.LocalI64Tag:
                return PrimaryBodyIrNodeEvalMissAt("cast_arg_kind")
            return probeCastKind
        if PrimaryBodyIrPtrReinterpretCastHead(probeCallHead):
            let probeReinterpretArgNode = PrimaryBodyIrPtrReinterpretCastArgNodeIndex(typedIr, nodeIndex)
            if probeReinterpretArgNode < 0:
                return PrimaryBodyIrNodeEvalMissAt("cast_arg_shape")
            let probeReinterpretArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     typedIr,
                                                                     typedFn,
                                                                     irFunction,
                                                                     probeReinterpretArgNode)
            if probeReinterpretArgKind < 0:
                return -1
            if probeReinterpretArgKind != coreir.LocalPtrTag &&
               probeReinterpretArgKind != coreir.LocalI64Tag:
                return PrimaryBodyIrNodeEvalMissAt("cast_arg_kind")
            return coreir.LocalPtrTag
        if PrimaryBodyIrPtrAliasReinterpretCastHead(typedIr, npSrc, probeCallHead):
            let probeAliasArgNode = PrimaryBodyIrPtrAliasReinterpretCastArgNodeIndex(typedIr,
                                                                                    npSrc,
                                                                                    nodeIndex)
            if probeAliasArgNode < 0:
                return PrimaryBodyIrNodeEvalMissAt("cast_arg_shape")
            let probeAliasArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               probeAliasArgNode)
            if probeAliasArgKind < 0:
                return -1
            if probeAliasArgKind != coreir.LocalPtrTag &&
