    B2PrimaryObjectPlanPhaseState =
        allSymbolNames: str[]
        itemIds: int32[]
        symbolNames: str[]
        functionWordOffsets: int32[]
        functionWordCounts: int32[]
        functionBodyKinds: str[]
        functionInstructionBodyKinds: str[]
        functionStatementReturnModes: int32[]
        functionStatementReturnI32Values: int32[]
        functionStatementCallCounts: int32[]
        functionIrIndexes: int32[]
        functionBodyIRs: coreir.BodyIR[]
        relocSourceItemIds: int32[]
        relocWordOffsets: int32[]
        relocTargetSymbols: str[]
        # Step B (call-BL emit-first): parallel to relocWordOffsets. For a call-BL reloc entry this
        # holds the callOrdinal; FillAndCheck joins (itemId -> realFunctionBase, callOrdinal) against
        # the fill record table to write relocWordOffsets directly from the emit. -1 marks every
        # non-call-BL reloc entry (special / x64 / wasm), whose word offset is the predicted value.
        relocCallOrdinal: int32[]
        dataLabels: str[]
        dataPayloadTexts: str[]
        dataPayloadRawBytes: int32[]
        dataPayloadRawByteCounts: int32[]
        dataRelocSourceItemIds: int32[]
        dataRelocWordOffsets: int32[]
        # Phase 2.5: parallel to dataRelocWordOffsets, the UN-perturbed predicted absolute word
        # offset of each data reloc, used as the stable lookup key when FillAndCheck rewrites the
        # consumed dataRelocWordOffsets to the real fill positions. Kept separate from the consumed
        # value so the negative test (which corrupts only dataRelocWordOffsets) still recovers the
        # real offset via this key — proving the offset is sourced from the emit, not the predictor.
        dataRelocPredictedKey: int32[]
        # Step B-data (data reloc emit-first): parallel to dataRelocWordOffsets. The STRUCTURAL key
        # (oi, subIndex) of each data reloc, computed identically by BuildItems and the serial fill
        # so FillAndCheck joins (itemId -> realFunctionBase, oi, subIndex) against the fill record
        # table to write dataRelocWordOffsets DIRECTLY from the emit — no predictor / predicted-abs.
        # dataRelocOpIndex = the anchoring BodyIR op index; dataRelocSubIndex = the reloc's position
        # within that op's emission walk (0 for a single-reloc bare cstring / global load-store op;
        # 0,1,2,... for the cstring-args + sret-global of one call op, in arg-walk order). -1 in
        # dataRelocOpIndex marks every non-emit-first entry (x64 / wasm / debug zero-scan / fail-trace),
        # whose word offset stays the predicted value rewritten via dataRelocPredictedKey.
        dataRelocOpIndex: int32[]
        dataRelocSubIndex: int32[]
        dataRelocTargetSymbols: str[]
        irIndexes: int32[]
        wordCounts: int32[]
        tempBodyIRs: coreir.BodyIR[]
        # Parallel to tempBodyIRs/wordCounts: true once PrimaryBuildBodyIrForFunction
        # has fully built a real body (ops/terms > 0, wordCounts > 0) for index i.
        # Explicit flag — NOT inferred from wordCounts, because an empty-body
        # StatementSequence legally lowers to wordCounts=0. EnsureFunctionLowered's
        # StatementSequence re-entry branch short-circuits on this flag to keep the
        # already-built body instead of zeroing wordCounts and re-lowering wholesale.
        bodyIrLowered: bool[]
        # C5 Step2 (object_all_lazy 独占): 每个 primaryObjectIr 行的 plan 行引用数。
        # 同源同名重载 (symbol 行 line=0) 在 LinkPhase AtLine 映射下共享同一 ir 行,
        # statements 释放必须等最后一个消费者 BodyIR 建成 — 首个消费者建成即释放会
        # 让共享行的后续 BodyIR 读空 statements → 假 wcz。非 lazy 模式不填 (空)。
        lazyIrConsumerCounts: int32[]
        reachable: bool[]
        frontier: int32[]
        totalWordCount: int32
        entryFunctionSymbol: str
        bodySemanticsMissing: bool
        error: B2PrimaryObjectError
        # Phase 3b: every not_ready function seen this build (deduped by name).
        # `error` keeps the first-only detailed record; `errors` collects all.
        errors: B2PrimaryObjectError[]
        needsRuntimeCommandData: bool
        exportedFunctionCount: int32
        entryFunctionCount: int32
        emitObjectRootsAllFunctions: bool
        bodyIROrcRetainReleasePairElidedCount: int32
        bodyIROrcDiagObserverPresent: bool
        bodyIRNoAliasFunctionCount: int32
        bodyIRNoAliasAppliedFunctionCount: int32
        bodyIRNoAliasLocalCount: int32
        bodyIRNoAliasForwardRewriteCount: int32
        bodyIRNoAliasDodSoAAllOk: bool
        bodyIRPhaseArenaResetCount: int32
        bodyIRPhaseArenaReserveCount: int32
        bodyIRPhaseArenaCapacityBytes: int64
        bodyIRPhaseArenaUsedBytes: int64
        bodyIRPhaseArenaPeakBytes: int64
        bodyIRPhaseArenaSpillCount: int32
        bodyIREGraphFunctionCount: int32
        bodyIREGraphAppliedFunctionCount: int32
        bodyIREGraphSkippedFunctionCount: int32
        bodyIREGraphHardFailFunctionCount: int32
        bodyIREGraphBlockCount: int32
        bodyIREGraphCandidateBlockCount: int32
        bodyIREGraphChangedBlockCount: int32
        bodyIREGraphSkippedBlockCount: int32
        bodyIREGraphUnsafeOpCount: int32
        bodyIREGraphClassCount: int32
        bodyIREGraphRoundCount: int32
        bodyIREGraphRuleHitCount: int32
        bodyIREGraphExtractedCount: int32
        bodyIREGraphOpDelta: int32
        bodyIREGraphMs: int32
        bodyIREGraphReason: str
        fillCheckBeginRssBytes: int64
        fillCheckAfterDodRssBytes: int64
        fillCheckAfterInstructionAllocRssBytes: int64
        fillCheckAfterWordFillRssBytes: int64
        fillCheckAfterBodyIrReleaseRssBytes: int64
        fillCheckAfterZeroScanRssBytes: int64
        fillCheckReleasedBodyIrFunctionCount: int32
        fillCheckReleasedBodyIrPayloadItemCount: int32
        wordFillSchedule: str
