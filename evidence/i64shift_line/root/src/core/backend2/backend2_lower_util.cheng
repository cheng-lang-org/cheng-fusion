@borrows
fn PrimaryObjectPlanSetPackedStackArgsForTriple(targetTriple: str) =
    primaryDarwinPackedStackArgs = false
    if targetTriple == "arm64-apple-darwin":
        primaryDarwinPackedStackArgs = true
    elif targetTriple == "aarch64-apple-ios":
        primaryDarwinPackedStackArgs = true
    elif targetTriple == "arm64-apple-ios":
        primaryDarwinPackedStackArgs = true

fn B2PrimaryObjectPlanTraceInit() =
    if primaryObjectPlanTraceInitialized:
        return
    primaryObjectPlanTraceInitialized = true
    primaryObjectPlanTracePath = strutil.Strip(os.GetEnv("CHENG_PRIMARY_OBJECT_TRACE"))
    primaryObjectPlanTraceFilter = strutil.Strip(os.GetEnv("CHENG_PRIMARY_OBJECT_TRACE_FILTER"))

@borrows
fn B2PrimaryObjectPlanTrace(line: str) =
    B2PrimaryObjectPlanTraceInit()
    if len(primaryObjectPlanTracePath) <= 0:
        return
    if len(primaryObjectPlanTraceFilter) > 0 && !strutil.Contains(line, primaryObjectPlanTraceFilter):
        return
    var openRes = os.OpenAppendResult(primaryObjectPlanTracePath)
    if !result.IsOk(openRes):
        panic("primary_object_trace_open_failed")
    let handle = result.Value(openRes)
    var bytes = rawbytes.BytesFromString(Fmt"{line}\n")
    var writeRes = os.WriteAllBytesResult(handle, bytes)
    if !result.IsOk(writeRes):
        panic("primary_object_trace_write_failed")
    var closeRes = os.CloseFileResult(handle)
    if !result.IsOk(closeRes):
        panic("primary_object_trace_close_failed")

@borrows
fn B2PrimaryObjectPlanTraceActive(): bool =
    B2PrimaryObjectPlanTraceInit()
    return len(primaryObjectPlanTracePath) > 0

var primaryObjectPlanProgressInitialized: bool
var primaryObjectPlanProgressEnabledFlag: bool

@borrows
fn B2PrimaryObjectPlanProgressEnabled(): bool =
    if !primaryObjectPlanProgressInitialized:
        primaryObjectPlanProgressInitialized = true
        let primaryProgress = strutil.Strip(os.GetEnv("CHENG_PRIMARY_OBJECT_PROGRESS"))
        let globalProgress = strutil.Strip(os.GetEnv("CHENG_PROGRESS"))
        primaryObjectPlanProgressEnabledFlag = false
        if primaryProgress != "":
            primaryObjectPlanProgressEnabledFlag = true
        elif globalProgress == "primary_object_detail":
            primaryObjectPlanProgressEnabledFlag = true
    return primaryObjectPlanProgressEnabledFlag

@borrows
fn B2PrimaryObjectPlanGuardTick() =
    os.ProcessResourceGuardCheck()

@borrows
fn B2PrimaryObjectPlanProgress(label: str) =
    os.ProcessResourceGuardCheck()
    if !B2PrimaryObjectPlanProgressEnabled():
        return
    os.WriteLine(os.GetStderr(), Fmt"compile_progress phase=primary_object_plan detail={label}")

var primaryObjectPlanDebugInitialized: bool
var primaryObjectPlanDebugEnabledFlag: bool

@borrows
fn B2PrimaryObjectMetadataTextStable(text: str): bool =
    return metadataauthority.MetadataTextStable(text)

@borrows
fn B2PrimaryObjectStatementKindCodeText(kind: int32): str =
    if kind == int32(texpr.TypedExprIrStmtLocalDecl):
        return "local_decl"
    if kind == int32(texpr.TypedExprIrStmtLetCall):
        return "let_call"
    if kind == int32(texpr.TypedExprIrStmtIfCall):
        return "if_call"
    if kind == int32(texpr.TypedExprIrStmtCall):
        return "call"
    if kind == int32(texpr.TypedExprIrStmtResultIntrinsic):
        return "result_intrinsic"
    if kind == int32(texpr.TypedExprIrStmtReturn):
        return "return"
    if kind == int32(texpr.TypedExprIrStmtAssign):
        return "assign"
    if kind == int32(texpr.TypedExprIrStmtIf):
        return "if"
    if kind == int32(texpr.TypedExprIrStmtElif):
        return "elif"
    if kind == int32(texpr.TypedExprIrStmtElse):
        return "else"
    if kind == int32(texpr.TypedExprIrStmtFor):
        return "for"
    if kind == int32(texpr.TypedExprIrStmtMatch):
        return "match"
    if kind == int32(texpr.TypedExprIrStmtCase):
        return "case"
    if kind == int32(texpr.TypedExprIrStmtWhile):
        return "while"
    return "unsupported"

# W5 仪表 strip (2026-07-05): W0 收割期 NodeEvalOnly census 仪表 (EnterFunction/Begin/
# Flush/Own/WiredKind/EntryText/CensusedIndex 7 fn + 11 状态全局 + stmt/lower 93 调用点)
# 已删 — env 旗 OFF 时全部为死代码 (Begin/Flush 调用点均在 Active() 门内, Own() 为死存储),
# 产物 .o 逐字节不受影响; env=1 的 census/毒标协议由 pobj 腿保留 (CHENG_BACKEND2 未设时)。
# Active 本身保留: slots seq-add value 实参物化的节点模式行为门仍读它 (非仪表, 见
# backend2_lower_slots "NODE_EVAL_ONLY:文本取值助手" 注)。
fn B2PrimaryBodyIrNodeEvalOnlyActive(): bool =
    if !primaryBodyIrNodeEvalOnlyInitialized:
        primaryBodyIrNodeEvalOnlyInitialized = true
        primaryBodyIrNodeEvalOnlyFlag = os.GetEnv("CHENG_NODE_EVAL_ONLY") == "1"
    return primaryBodyIrNodeEvalOnlyFlag

