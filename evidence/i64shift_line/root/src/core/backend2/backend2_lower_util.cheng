# Canonical data-reloc mutation hook. False in production; focused mutation gates flip it to
# prove the structural real-record consumer rejects a perturbed consumed offset.
var primaryDataRelocPerturb: bool
# Phase 2.5+ call-internal data reloc negative-test source escape hatches (call-cstring-arg /
# sret-global). All false in every steady/production build; flipped by hand for the manual A/B
# negative test then reverted before the clean gate run (os.GetEnv returns empty inside the
# selfhost compiler binary, so env gates cannot reach this code).
#   primaryCallDataRelocPerturb : +1 the COVERED call-cstring-arg / sret-global consumed offset
#                                 (dataRelocWordOffsets) while leaving the predicted key true.
var primaryCallDataRelocPerturb: bool
var primaryCallDataRelocCStringArgClassOnly: bool
var primaryCallDataRelocSretGlobalClassOnly: bool
@borrows
fn PrimaryTargetSymbolName(targetTriple: str,
                             raw: str): str =
    var symbolRaw = raw
    if symbolRaw == "std/system::assert":
        symbolRaw = "assert"
    elif symbolRaw == "std/system::Assert":
        symbolRaw = "Assert"
    if targetTriple == "arm64-apple-darwin" ||
       targetTriple == "aarch64-apple-ios" ||
       targetTriple == "arm64-apple-ios":
        if len(symbolRaw) >= 2 && symbolRaw[0] == 'L' && symbolRaw[1] == '_':
            return symbolRaw
        return Fmt"_{symbolRaw}"
    return symbolRaw

@borrows
fn Backend2SanitizeSymbolPart(text: str): str =
    var out = ""
    for i in 0..<len(text):
        let ch = text[i]
        var digit: bool
        if int32(ch) >= '0':
            if int32(ch) <= '9':
                digit = true
        var upper: bool
        if int32(ch) >= 'A':
            if int32(ch) <= 'Z':
                upper = true
        var lower: bool
        if int32(ch) >= 'a':
            if int32(ch) <= 'z':
                lower = true
        if digit:
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        elif upper:
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        elif lower:
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        elif ch == '_':
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        else:
            out = Fmt"{out}_"
    return out


@borrows
fn PrimaryStartsWith(text: str,
                      prefix: str): bool =
    if len(prefix) > len(text):
        return false
    for i in 0..<len(prefix):
        if text[i] != prefix[i]:
            return false
    return true

@borrows
fn PrimaryBodyIrCanonicalAssignLhsName(lhsRaw: str): str =
    let lhs = strutil.Strip(lhsRaw)
    var prefixLen: int32
    if PrimaryStartsWith(lhs, "let "):
        prefixLen = 4
    elif PrimaryStartsWith(lhs, "var "):
        prefixLen = 4
    elif PrimaryStartsWith(lhs, "const "):
        prefixLen = 6
    if prefixLen <= 0:
        return lhs
    var cursor = prefixLen
    while cursor < len(lhs):
        let code = Int32(lhs[cursor])
        if code == 32 || code == 9:
            cursor = cursor + 1
            continue
        break
    let start = cursor
    while cursor < len(lhs):
        let code = Int32(lhs[cursor])
        var digit: bool
        if code >= int32('0'):
            if code <= int32('9'):
                digit = true
        var upper: bool
        if code >= int32('A'):
            if code <= int32('Z'):
                upper = true
        var lower: bool
        if code >= int32('a'):
            if code <= int32('z'):
                lower = true
        var underscore: bool
        if code == int32('_'):
            underscore = true
        var valid: bool
        if digit:
            valid = true
        elif upper:
            valid = true
        elif lower:
            valid = true
        elif underscore:
            valid = true
        if !valid:
            break
        cursor = cursor + 1
    if cursor <= start:
        return lhs
    let normalizedLhs = strings.SliceBytes(lhs, start, cursor - start)
    return normalizedLhs

@borrows
fn PrimaryPathTrimStart(text: str): int32 =
    var start: int32
    while start < len(text):
        let code = Int32(text[start])
        if code != 32 && code != 9 && code != 10 && code != 13:
            break
        start = start + 1
    return start


@borrows
fn PrimaryPathTrimStop(text: str,
                         start: int32): int32 =
    var stop = len(text)
    while stop > start:
        let code = Int32(text[stop - 1])
        if code != 32 && code != 9 && code != 10 && code != 13:
            break
        stop = stop - 1
    return stop


@borrows
fn PrimaryPathNormalizedStop(text: str,
                               start: int32,
                               stopRaw: int32): int32 =
    var stop = stopRaw
    while stop > start + 1:
        let last = text[stop - 1]
        if last != '/' && last != '\\':
            break
        stop = stop - 1
    return stop


@borrows
fn PrimaryPathNormalizedEquals(left: str,
                                 right: str): bool =
    let leftStart = PrimaryPathTrimStart(left)
    let rightStart = PrimaryPathTrimStart(right)
    let leftStop = PrimaryPathNormalizedStop(left, leftStart, PrimaryPathTrimStop(left, leftStart))
    let rightStop = PrimaryPathNormalizedStop(right, rightStart, PrimaryPathTrimStop(right, rightStart))
    let leftLen = leftStop - leftStart
    let rightLen = rightStop - rightStart
    if leftLen == rightLen:
        for i in 0..<leftLen:
            if left[leftStart + i] != right[rightStart + i]:
                return false
        return true
    # mixed absolute/relative forms of the same source: match the relative
    # side as a /-anchored suffix of the absolute side
    if leftLen <= 0 || rightLen <= 0:
        return false
    let leftAbs = left[leftStart] == '/'
    let rightAbs = right[rightStart] == '/'
    if leftAbs == rightAbs:
        return false
    var absText = left
    var absStart = leftStart
    var absLen = leftLen
    var relText = right
    var relStart = rightStart
    var relLen = rightLen
    if rightAbs:
        absText = right
        absStart = rightStart
        absLen = rightLen
        relText = left
        relStart = leftStart
        relLen = leftLen
    if absLen <= relLen:
        return false
    if absText[absStart + absLen - relLen - 1] != '/':
        return false
    for i in 0..<relLen:
        if absText[absStart + absLen - relLen + i] != relText[relStart + i]:
            return false
    return true


@borrows
fn PrimaryFunctionTailName(functionName: str): str =
    var tailStart = 0
    for i in 0..<len(functionName):
        if functionName[i] == '.':
            tailStart = i + 1
    if len(functionName) >= 2:
        for j in 0..<(len(functionName) - 1):
            if functionName[j] == ':' && functionName[j + 1] == ':':
                tailStart = j + 2
    if tailStart > 0 && tailStart < len(functionName):
        return strings.CloneStr(strings.SliceBytes(functionName, tailStart, len(functionName) - tailStart))
    return strings.CloneStr(functionName)


@borrows
fn PrimaryCallTargetTailName(targetText: str): str =
    var tailStart = 0
    for i in 0..<len(targetText):
        if targetText[i] == '.':
            tailStart = i + 1
    if len(targetText) >= 2:
        for j in 0..<(len(targetText) - 1):
            if targetText[j] == ':' && targetText[j + 1] == ':':
                tailStart = j + 2
    if tailStart > 0 && tailStart < len(targetText):
        return strings.CloneStr(strings.SliceBytes(targetText, tailStart, len(targetText) - tailStart))
    return strings.CloneStr(targetText)

fn PrimaryBodyIrResetLookupCaches() =
    primaryBodyIrConstCacheSourcePaths = []
    primaryBodyIrConstCacheSourceIndexes = []
    primaryBodyIrConstCacheNames = []
    primaryBodyIrConstCacheValues = []
    primaryBodyIrImportAliasCacheSourcePaths = []
    primaryBodyIrImportAliasCacheQualifiers = []
    primaryBodyIrImportAliasCacheTargets = []
    primaryBodyIrEnumCacheSourcePaths = []
    primaryBodyIrEnumCacheSourceIndexes = []
    primaryBodyIrEnumCacheNames = []
    primaryBodyIrSourceBindingCacheBuiltSourcePaths = []
    primaryBodyIrSourceBindingCacheBuiltFunctionNames = []
    primaryBodyIrSourceBindingCacheSourcePaths = []
    primaryBodyIrSourceBindingCacheFunctionNames = []
    primaryBodyIrSourceBindingCacheLineNumbers = []
    primaryBodyIrSourceBindingCacheNames = []
    primaryBodyIrSourceBindingCacheTypes = []
    primaryBodyIrFunctionLookupSourcePaths = []
    primaryBodyIrFunctionSourceIndexes = []
    primaryBodyIrFunctionTailNames = []
    primaryBodyIrFunctionTailBucketHeads = []
    primaryBodyIrFunctionTailEntryTails = []
    primaryBodyIrFunctionTailEntryFnIndexes = []
    primaryBodyIrFunctionTailEntryNext = []
    primaryObjectIrFunctionIndexBucketHeads = []
    primaryObjectIrFunctionIndexEntryNames = []
    primaryObjectIrFunctionIndexEntryFunctionIndexes = []
    primaryObjectIrFunctionIndexEntryNext = []
    primaryPlanResolveSymbolTailBucketHeads = []
    primaryPlanResolveSymbolTailEntryTails = []
    primaryPlanResolveSymbolTailEntryFnIndexes = []
    primaryPlanResolveSymbolTailEntryNext = []
    primaryPlanResolveNameTailBucketHeads = []
    primaryPlanResolveNameTailEntryTails = []
    primaryPlanResolveNameTailEntryFnIndexes = []
    primaryPlanResolveNameTailEntryNext = []
    primaryPlanResolveBuiltCount = 0
    primaryObjectIrFunctionIndexBuiltCount = -1
    primaryObjectIrFunctionIndexFingerprint = 0
    primaryBodyIrFieldMetaCacheSourcePaths = []
    primaryBodyIrFieldMetaCacheOwnerTypes = []
    primaryBodyIrFieldMetaCacheFieldNames = []
    primaryBodyIrFieldMetaCacheFieldTypes = []
    primaryBodyIrFieldMetaCacheOffsets = []
    primaryBodyIrFieldMetaCacheSizes = []
    primaryBodyIrFieldMetaCacheAligns = []
    primaryBodyIrFieldMetaCacheBucketHeads = []
    primaryBodyIrFieldMetaCacheEntryNext = []

@borrows
fn PrimaryBodyIrFunctionLookupSourcePathIndex(sourcePath: str): int32 =
    if sourcePath == "":
        return -1
    for i in 0..<primaryBodyIrFunctionLookupSourcePaths.len:
        if PrimaryPathNormalizedEquals(primaryBodyIrFunctionLookupSourcePaths[i], sourcePath):
            return i
    return -1

@borrows
fn PrimaryBodyIrPrepareFunctionLookupCache(typedIr: texpr.TypedExprIr) =
    if primaryBodyIrFunctionTailNames.len == typedIr.functions2_functionNameIds.len &&
       primaryBodyIrFunctionSourceIndexes.len == typedIr.functions2_functionNameIds.len &&
       primaryBodyIrFunctionTailBucketHeads.len > 0:
        return
    primaryBodyIrFunctionTailNames = []
    primaryBodyIrFunctionLookupSourcePaths = []
    primaryBodyIrFunctionSourceIndexes = []
    primaryBodyIrFunctionTailEntryTails = []
    primaryBodyIrFunctionTailEntryFnIndexes = []
    primaryBodyIrFunctionTailEntryNext = []
    primaryBodyIrFunctionTailBucketHeads = []
    for bucketIndex in 0..<16384:
        add(primaryBodyIrFunctionTailBucketHeads, -1)
    for i in 0..<typedIr.functions2_functionNameIds.len:
        let fnNameRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_functionNameIds[i])
        let fnSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_sourcePathIds[i])
        let fnName = Value(fnNameRes)
        let fnSrc = Value(fnSrcRes)
        let candidateTail = PrimaryCallTargetTailName(fnName)
        add(primaryBodyIrFunctionTailNames, share(candidateTail))
        var sourceIndex = PrimaryBodyIrFunctionLookupSourcePathIndex(fnSrc)
        if sourceIndex < 0:
            sourceIndex = primaryBodyIrFunctionLookupSourcePaths.len
            add(primaryBodyIrFunctionLookupSourcePaths, fnSrc)
        add(primaryBodyIrFunctionSourceIndexes, sourceIndex)
        # Index by tail name with head insertion (O(1)); the lookup tracks the
        # minimum matching function index so chain order is irrelevant.
        let tailBucket = PrimaryObjectIrFunctionIndexHash(candidateTail,
                                                          primaryBodyIrFunctionTailBucketHeads.len)
        if tailBucket >= 0:
            let entryIndex = primaryBodyIrFunctionTailEntryFnIndexes.len
            add(primaryBodyIrFunctionTailEntryTails, candidateTail)
            add(primaryBodyIrFunctionTailEntryFnIndexes, i)
            add(primaryBodyIrFunctionTailEntryNext, primaryBodyIrFunctionTailBucketHeads[tailBucket])
            primaryBodyIrFunctionTailBucketHeads[tailBucket] = entryIndex

@borrows
fn PrimaryBodyIrFieldMetaCacheIndex(sourcePath: str,
                                     ownerType: str,
                                     fieldName: str): int32 =
    if sourcePath == "" || ownerType == "" || fieldName == "":
        return -1
    if primaryBodyIrFieldMetaCacheBucketHeads.len > 0:
        let bucket = PrimaryObjectIrFunctionIndexHash(fieldName, primaryBodyIrFieldMetaCacheBucketHeads.len)
        if bucket < 0:
            return -1
        var e = primaryBodyIrFieldMetaCacheBucketHeads[bucket]
        while e >= 0:
            if e < primaryBodyIrFieldMetaCacheFieldNames.len &&
               e < primaryBodyIrFieldMetaCacheSourcePaths.len &&
               e < primaryBodyIrFieldMetaCacheOwnerTypes.len &&
               primaryBodyIrFieldMetaCacheFieldNames[e] == fieldName &&
               primaryBodyIrFieldMetaCacheOwnerTypes[e] == ownerType &&
               PrimaryPathNormalizedEquals(primaryBodyIrFieldMetaCacheSourcePaths[e], sourcePath):
                return e
            e = primaryBodyIrFieldMetaCacheEntryNext[e]
        return -1
    for i in 0..<primaryBodyIrFieldMetaCacheFieldNames.len:
        if i >= primaryBodyIrFieldMetaCacheSourcePaths.len ||
           i >= primaryBodyIrFieldMetaCacheOwnerTypes.len:
            continue
        if primaryBodyIrFieldMetaCacheFieldNames[i] != fieldName:
            continue
        if primaryBodyIrFieldMetaCacheOwnerTypes[i] != ownerType:
            continue
        if PrimaryPathNormalizedEquals(primaryBodyIrFieldMetaCacheSourcePaths[i], sourcePath):
            return i
    return -1

@borrows
fn PrimaryBodyIrFieldMetaCacheStore(sourcePath: str,
                                     ownerType: str,
                                     fieldName: str,
                                     fieldType: str,
                                     fieldOffsetBytes: int32,
                                     fieldSizeBytes: int32,
                                     fieldAlignBytes: int32) =
    if sourcePath == "" || ownerType == "" || fieldName == "" || fieldType == "":
        return
    if fieldOffsetBytes < 0 || fieldSizeBytes <= 0 || fieldAlignBytes <= 0:
        return
    let existingIndex = PrimaryBodyIrFieldMetaCacheIndex(sourcePath, ownerType, fieldName)
    if existingIndex >= 0:
        return
    add(primaryBodyIrFieldMetaCacheSourcePaths, share(sourcePath))
    add(primaryBodyIrFieldMetaCacheOwnerTypes, share(ownerType))
    add(primaryBodyIrFieldMetaCacheFieldNames, share(fieldName))
    add(primaryBodyIrFieldMetaCacheFieldTypes, share(fieldType))
    add(primaryBodyIrFieldMetaCacheOffsets, fieldOffsetBytes)
    add(primaryBodyIrFieldMetaCacheSizes, fieldSizeBytes)
    add(primaryBodyIrFieldMetaCacheAligns, fieldAlignBytes)
    if primaryBodyIrFieldMetaCacheBucketHeads.len <= 0:
        for b in 0..<16384:
            add(primaryBodyIrFieldMetaCacheBucketHeads, -1)
    let fieldMetaNewIndex = primaryBodyIrFieldMetaCacheFieldNames.len - 1
    let fieldMetaBucket = PrimaryObjectIrFunctionIndexHash(fieldName, primaryBodyIrFieldMetaCacheBucketHeads.len)
    add(primaryBodyIrFieldMetaCacheEntryNext, primaryBodyIrFieldMetaCacheBucketHeads[fieldMetaBucket])
    primaryBodyIrFieldMetaCacheBucketHeads[fieldMetaBucket] = fieldMetaNewIndex

@borrows
fn PrimaryObjectIrFunctionIndexHash(name: str, bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(name):
        h = h * 31 + int32(name[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

@borrows
fn PrimaryObjectIrFunctionIndexFingerprintText(seed: int32, text: str): int32 =
    var h = seed
    h = h * 31 + len(text)
    for i in 0..<len(text):
        h = h * 131 + int32(text[i])
    return h

@borrows
fn PrimaryObjectIrFunctionIndexFingerprint(ir: lower.PrimaryObjectIr): int32 =
    var h: int32
    h = 17
    h = h * 31 + ir.functions.len
    for i in 0..<ir.functions.len:
        h = PrimaryObjectIrFunctionIndexFingerprintText(h, ir.functions[i].sourcePath)
        h = PrimaryObjectIrFunctionIndexFingerprintText(h, ir.functions[i].functionName)
    if h == 0:
        h = 1
    return h

@borrows
fn PrimaryObjectIrFunctionIndexPrepare(ir: lower.PrimaryObjectIr) =
    # census perf 真根因(profiling 实测 ~40% CPU):此 Prepare 每次 lookup 都被调,原本每次
    # 重算 O(函数数×名长) 的 Fingerprint 来判缓存过期 → 整体 O(语句×函数) = O(n²) 主峰。
    # fingerprint 只哈希 sourcePath+functionName,这俩在 lowering 期 in-place mutation 下不变,
    # 故 length 未变即可断定哈希仍有效——先廉价 length 早返回,跳过昂贵 fingerprint。
    if primaryObjectIrFunctionIndexBuiltCount == ir.functions.len &&
       primaryObjectIrFunctionIndexBucketHeads.len > 0:
        return
    let fingerprint = PrimaryObjectIrFunctionIndexFingerprint(ir)
    if primaryObjectIrFunctionIndexBuiltCount == ir.functions.len &&
       primaryObjectIrFunctionIndexFingerprint == fingerprint &&
       primaryObjectIrFunctionIndexBucketHeads.len > 0:
        return
    primaryObjectIrFunctionIndexBucketHeads = []
    primaryObjectIrFunctionIndexEntryNames = []
    primaryObjectIrFunctionIndexEntryFunctionIndexes = []
    primaryObjectIrFunctionIndexEntryNext = []
    for bucketIndex in 0..<16384:
        add(primaryObjectIrFunctionIndexBucketHeads, -1)
    for i in 0..<ir.functions.len:
        let storedName = ir.functions[i].functionName
        let bucket = PrimaryObjectIrFunctionIndexHash(storedName,
                                                      primaryObjectIrFunctionIndexBucketHeads.len)
        if bucket < 0:
            continue
        let entryIndex = primaryObjectIrFunctionIndexEntryFunctionIndexes.len
        add(primaryObjectIrFunctionIndexEntryFunctionIndexes, i)
        # The global index outlives this borrowed view of `ir`; retain the
        # immutable name explicitly instead of consuming the source row.
        add(primaryObjectIrFunctionIndexEntryNames, share(storedName))
        add(primaryObjectIrFunctionIndexEntryNext, primaryObjectIrFunctionIndexBucketHeads[bucket])
        primaryObjectIrFunctionIndexBucketHeads[bucket] = entryIndex
    primaryObjectIrFunctionIndexBuiltCount = ir.functions.len
    primaryObjectIrFunctionIndexFingerprint = fingerprint

@borrows
fn PrimaryObjectIrFunctionIndexBucketUnique(ir: lower.PrimaryObjectIr,
                                             sourcePath: str,
                                             matchName: str): int32 =
    let bucket = PrimaryObjectIrFunctionIndexHash(matchName,
                                                  primaryObjectIrFunctionIndexBucketHeads.len)
    if bucket < 0:
        return -1
    var result: int32 = -1
    var entryIndex = primaryObjectIrFunctionIndexBucketHeads[bucket]
    while entryIndex >= 0:
        if primaryObjectIrFunctionIndexEntryNames[entryIndex] == matchName:
            let candidate = primaryObjectIrFunctionIndexEntryFunctionIndexes[entryIndex]
            if candidate >= 0:
                if candidate < ir.functions.len:
                    if ir.functions[candidate].functionName == matchName:
                        if PrimaryPathNormalizedEquals(ir.functions[candidate].sourcePath, sourcePath):
                            if result >= 0 && result != candidate:
                                return -2
                            result = candidate
        entryIndex = primaryObjectIrFunctionIndexEntryNext[entryIndex]
    return result

@borrows
fn PrimaryObjectIrFunctionIndex(ir: lower.PrimaryObjectIr,
                                  sourcePath: str,
                                  functionName: str): int32 =
    if sourcePath == "" || functionName == "":
        return -1
    let tailName = PrimaryFunctionTailName(functionName)
    PrimaryObjectIrFunctionIndexPrepare(ir)
    if primaryObjectIrFunctionIndexBucketHeads.len > 0 &&
       primaryObjectIrFunctionIndexBuiltCount == ir.functions.len:
        let exact = PrimaryObjectIrFunctionIndexBucketUnique(ir, sourcePath, functionName)
        if exact >= 0:
            return exact
        if exact == -2:
            return -1
        if tailName == functionName:
            return -1
        let tail = PrimaryObjectIrFunctionIndexBucketUnique(ir, sourcePath, tailName)
        if tail >= 0:
            return tail
        return -1
    var exact: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath):
            continue
        if ir.functions[i].functionName == functionName:
            if exact >= 0:
                return -1
            exact = i
    if exact >= 0 || tailName == functionName:
        return exact
    var tail: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath):
            continue
        if ir.functions[i].functionName == tailName:
            if tail >= 0:
                return -1
            tail = i
    return tail

@borrows
fn PrimaryObjectIrFunctionIndexAtLine(ir: lower.PrimaryObjectIr,
                                       sourcePath: str,
                                       functionName: str,
                                       signatureLineNumber: int32): int32 =
    if sourcePath == "" || functionName == "" ||
       signatureLineNumber <= 0:
        return -1
    let tailName = PrimaryFunctionTailName(functionName)
    var exact: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath) ||
           ir.functions[i].functionName != functionName ||
           ir.functions[i].signatureLineNumber != signatureLineNumber:
            continue
        if exact >= 0:
            return -1
        exact = i
    if exact >= 0 || tailName == functionName:
        return exact
    var tail: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath) ||
           ir.functions[i].functionName != tailName ||
           ir.functions[i].signatureLineNumber != signatureLineNumber:
            continue
        if tail >= 0:
            return -1
        tail = i
    return tail

@borrows
fn PrimaryFunctionTargetIndex(functionSymbolTexts: str[],
                               functionSourcePaths: str[],
                               targetSourcePath: str,
                               targetText: str): int32 =
    let targetTail = PrimaryCallTargetTailName(targetText)
    for i in 0..<functionSymbolTexts.len:
        if i >= functionSourcePaths.len:
            continue
        if !PrimaryPathNormalizedEquals(functionSourcePaths[i], targetSourcePath):
            continue
        if functionSymbolTexts[i] == targetText ||
           PrimaryFunctionTailName(functionSymbolTexts[i]) == targetTail:
            return i
    var found: int32
    found = -1
    for i in 0..<functionSymbolTexts.len:
        if functionSymbolTexts[i] != targetText &&
           PrimaryFunctionTailName(functionSymbolTexts[i]) != targetTail:
            continue
        if found >= 0:
            return -1
        found = i
    return found

@borrows
fn PrimaryStatementReturnModeI32Const(): int32 =
    return 1

@borrows
fn PrimaryBodyIrCharLiteralValue(textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    if len(text) < 3 || text[0] != '\'' || text[len(text) - 1] != '\'':
        return -1
    let payloadLen = len(text) - 2
    if payloadLen == 1:
        return int32(text[1])
    if payloadLen == 2 && text[1] == '\\':
        let esc = text[2]
        if esc == 'n':
            return 10
        if esc == 'r':
            return 13
        if esc == 't':
            return 9
        if esc == '0':
            return 0
        return int32(esc)
    return -1

@borrows
fn PrimaryBodyIrExtractIntFromText(textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    let charValue = PrimaryBodyIrCharLiteralValue(text)
    if charValue >= 0:
        return charValue
    let int32Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int32")
    if int32Inner != "":
        return PrimaryBodyIrExtractIntFromText(int32Inner)
    let int32Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int32")
    if int32Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(int32Inner2)
    let int64Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int64")
    if int64Inner != "":
        return PrimaryBodyIrExtractIntFromText(int64Inner)
    let int64Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int64")
    if int64Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(int64Inner2)
    let uint8Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint8")
    if uint8Inner != "":
        return PrimaryBodyIrExtractIntFromText(uint8Inner)
    let uint8Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt8")
    if uint8Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(uint8Inner2)
    let uint64Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint64")
    if uint64Inner != "":
        return PrimaryBodyIrExtractIntFromText(uint64Inner)
    let uint64Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt64")
    if uint64Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(uint64Inner2)
    # uint32/uint16/int16/int8 casts wrap a value that fits the i32 word — strip
    # them too (the i64 extractor already did). Without these, e.g.
    # `uint32(0xFFFFFFFF)` fell through to the digit parser, returned the 0
    # failure-sentinel, and the const was never materialized (uninitialized slot).
    let uint32Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint32")
    if uint32Inner != "":
        return PrimaryBodyIrExtractIntFromText(uint32Inner)
    let uint32Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt32")
    if uint32Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(uint32Inner2)
    let uint16Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint16")
    if uint16Inner != "":
        return PrimaryBodyIrExtractIntFromText(uint16Inner)
    let uint16Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt16")
    if uint16Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(uint16Inner2)
    let int16Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int16")
    if int16Inner != "":
        return PrimaryBodyIrExtractIntFromText(int16Inner)
    let int16Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int16")
    if int16Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(int16Inner2)
    let int8Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int8")
    if int8Inner != "":
        return PrimaryBodyIrExtractIntFromText(int8Inner)
    let int8Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int8")
    if int8Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(int8Inner2)
    let sizeofInner = PrimaryBodyIrWholeCallInnerForHead(text, "sizeof")
    if sizeofInner != "":
        let sizeofType = texpr.TypedExprNormalizeTypeText(strutil.Strip(sizeofInner))
        if sizeofType == "int8" || sizeofType == "uint8" || sizeofType == "bool" || sizeofType == "char":
            return 1
        if sizeofType == "int16" || sizeofType == "uint16":
            return 2
        if sizeofType == "int32" || sizeofType == "uint32" || sizeofType == "f32":
            return 4
        if sizeofType == "int64" || sizeofType == "uint64" || sizeofType == "f64" ||
           sizeofType == "ptr" || sizeofType == "cstring":
            return 8
        return 0
    if text == "":
        return 0
    if len(text) > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X'):
        var hexOut: int32
        for hi in 2..<len(text):
            let hch = text[hi]
            var hv: int32 = -1
            if hch >= '0' && hch <= '9':
                hv = int32(hch) - int32('0')
            elif hch >= 'a' && hch <= 'f':
                hv = int32(hch) - int32('a') + 10
            elif hch >= 'A' && hch <= 'F':
                hv = int32(hch) - int32('A') + 10
            if hv < 0:
                return 0
            hexOut = hexOut * 16 + hv
        return hexOut
    var sign: int32 = 1
    var start: int32
    if text[0] == '-':
        sign = -1
        start = 1
    if start >= len(text):
        return 0
    # hex literal (0x.. / 0X..): parse base-16, reject int32 overflow
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'x' || text[start + 1] == 'X'):
        let hexStart = start + 2
        if hexStart >= len(text):
            return 0
        var outHex: int32
        for i in hexStart..<len(text):
            let ch = text[i]
            if ch == '_':
                continue
            var digit: int32 = -1
            if ch >= '0' && ch <= '9':
                digit = int32(ch) - int32('0')
            elif ch >= 'a' && ch <= 'f':
                digit = 10 + int32(ch) - int32('a')
            elif ch >= 'A' && ch <= 'F':
                digit = 10 + int32(ch) - int32('A')
            else:
                return 0
            # reject int32 overflow instead of silently wrapping
            if outHex > 134217727:
                return 0
            if outHex == 134217727 && digit > 15:
                return 0
            outHex = outHex * 16 + digit
        if sign < 0:
            return 0 - outHex
        return outHex
    # binary literal (0b.. / 0B..): parse base-2, reject int32 overflow
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'b' || text[start + 1] == 'B'):
        let binStart = start + 2
        if binStart >= len(text):
            return 0
        var outBin: int32
        for i in binStart..<len(text):
            let ch = text[i]
            if ch == '_':
                continue
            if ch != '0' && ch != '1':
                return 0
            let digit = int32(ch) - int32('0')
            if outBin > 1073741823:
                return 0
            outBin = outBin * 2 + digit
        if sign < 0:
            return 0 - outBin
        return outBin
    # Accumulate in 64 bits so a decimal literal in the uint32 range (i.e.
    # > INT32_MAX up to 4294967295) is materialized by wrapping into the i32
    # word — the same as the hex path (0xFFFFFFFE -> -2). The previous code
    # bailed to the 0 failure-sentinel once `out` crossed INT32_MAX, so a
    # compare-RHS like `uint32(4294967294)` was never stored and `cmp` read an
    # uninitialized slot (DRIVER miscompile #40). Reject only when the magnitude
    # exceeds the uint32 range; genuinely-wider literals are handled by the i64
    # extractor elsewhere.
    var out64: int64
    for i in start..<len(text):
        let ch = text[i]
        if ch == '_':
            continue
        if ch < '0' || ch > '9':
            return 0
        let digit = int64(int32(ch) - int32('0'))
        # reject beyond the uint32 range (4294967295) instead of wrapping
        if out64 > int64(429496729):
            return 0
        if out64 == int64(429496729) && digit > int64(5):
            return 0
        out64 = out64 * int64(10) + digit
    if sign < 0:
        return 0 - int32(out64)
    return int32(out64)

@borrows
fn PrimaryBodyIrExtractInt64FromDigits(text: str, valueOut: var int64): bool =
    if text == "":
        return false
    var sign: int64 = 1
    var start: int32
    if text[0] == '-':
        sign = int64(0) - int64(1)
        start = 1
    if start >= len(text):
        return false
    # hex literal (0x.. / 0X..): parse base-16 with uint64-range acceptance
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'x' || text[start + 1] == 'X'):
        let hexStart = start + 2
        if hexStart >= len(text):
            return false
        var outHex: int64
        var hexDigits: int32
        for i in hexStart..<len(text):
            let ch = text[i]
            if ch == '_':
                continue
            var digit: int64 = int64(-1)
            if ch >= '0' && ch <= '9':
                digit = int64(int32(ch) - int32('0'))
            elif ch >= 'a' && ch <= 'f':
                digit = int64(10 + int32(ch) - int32('a'))
            elif ch >= 'A' && ch <= 'F':
                digit = int64(10 + int32(ch) - int32('A'))
            else:
                return false
            hexDigits = hexDigits + 1
            # cap at 16 hex digits (64 bits); reject wider literals
            if hexDigits > 16:
                return false
            outHex = outHex * int64(16) + digit
        if hexDigits == 0:
            return false
        valueOut = outHex * sign
        return true
    # binary literal (0b.. / 0B..): parse base-2
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'b' || text[start + 1] == 'B'):
        let binStart = start + 2
        if binStart >= len(text):
            return false
        var outBin: int64
        var binDigits: int32
        for i in binStart..<len(text):
            let ch = text[i]
            if ch == '_':
                continue
            if ch != '0' && ch != '1':
                return false
            binDigits = binDigits + 1
            if binDigits > 64:
                return false
            outBin = outBin * int64(2) + int64(int32(ch) - int32('0'))
        if binDigits == 0:
            return false
        valueOut = outBin * sign
        return true
    var out: int64
    for i in start..<len(text):
        let ch = text[i]
        if ch == '_':
            continue
        if ch < '0' || ch > '9':
            return false
        let digit = int64(int32(ch) - int32('0'))
        if out > int64(922337203685477580):
            return false
        if out == int64(922337203685477580) && digit > int64(7):
            return false
        out = out * int64(10) + digit
    valueOut = out * sign
    return true

@borrows
fn PrimaryBodyIrExtractInt64FromText(textRaw: str,
                                      valueOut: var int64): bool =
    let text = strutil.Strip(textRaw)
    if text == "":
        return false
    # strip primitive integer cast wrappers (int64(..)/uint64(..)/int32(..)/...)
    # Fast path: plain numeric literals (first char digit/sign) skip the seven
    # head probes — this runs per numeric token and dominated compile time.
    let firstCh = text[0]
    if (firstCh >= '0' && firstCh <= '9') || firstCh == '-' || firstCh == '+':
        return PrimaryBodyIrExtractInt64FromDigits(text, valueOut)
    let int64Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int64")
    if int64Inner != "":
        return PrimaryBodyIrExtractInt64FromText(int64Inner, valueOut)
    let int64Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int64")
    if int64Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(int64Inner2, valueOut)
    let uint64Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint64")
    if uint64Inner != "":
        return PrimaryBodyIrExtractInt64FromText(uint64Inner, valueOut)
    let uint64Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt64")
    if uint64Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(uint64Inner2, valueOut)
    let int32Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int32")
    if int32Inner != "":
        return PrimaryBodyIrExtractInt64FromText(int32Inner, valueOut)
    let int32Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int32")
    if int32Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(int32Inner2, valueOut)
    let uint32Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint32")
    if uint32Inner != "":
        return PrimaryBodyIrExtractInt64FromText(uint32Inner, valueOut)
    let uint32Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt32")
    if uint32Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(uint32Inner2, valueOut)
    let int8Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int8")
    if int8Inner != "":
        return PrimaryBodyIrExtractInt64FromText(int8Inner, valueOut)
    let int8Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int8")
    if int8Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(int8Inner2, valueOut)
    let uint8Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint8")
    if uint8Inner != "":
        return PrimaryBodyIrExtractInt64FromText(uint8Inner, valueOut)
    let uint8Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt8")
    if uint8Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(uint8Inner2, valueOut)
    return PrimaryBodyIrExtractInt64FromDigits(text, valueOut)

@borrows
fn PrimaryBodyIrTextIsF64Literal(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if text.len < 3:
        return false
    var start: int32
    if text[0] == '-':
        if text.len < 4:
            return false
        start = 1
    var dotCount: int32
    var digitsBefore: int32
    var digitsAfter: int32
    for i in start..<text.len:
        let ch = text[i]
        if ch == '.':
            dotCount = dotCount + 1
            if dotCount > 1:
                return false
            continue
        if ch < '0' || ch > '9':
            return false
        if dotCount == 0:
            digitsBefore = digitsBefore + 1
        else:
            digitsAfter = digitsAfter + 1
    return dotCount == 1 && digitsBefore > 0 && digitsAfter > 0

@borrows
fn PrimaryBodyIrPow2U64(exp: int32,
                         out: var uint64): bool =
    if exp < 0 || exp >= 64:
        return false
    out = uint64(1)
    for _ in 0..<exp:
        out = out * uint64(2)
    return true

@borrows
fn PrimaryBodyIrF64LiteralFail(literalRaw: str,
                                reason: str): bool =
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        os.WriteLine(os.GetStderr(), Fmt"phase=f64_literal_bits_guard_fail lit={literalRaw} reason={reason}")
    return false

# DECIMAL_F64_EXACT_BEGIN. Keep this block byte-identical in backend2_lower_util.
# std/system ParseF64Bits repeatedly rounds binary64 multiply/add/div steps, so
# it is not a correctly-rounded compiler-literal oracle. This path keeps the
# decimal numerator/denominator exact until one ties-to-even rounding step.
const
    PrimaryBodyIrDecimalBigBase: uint64 = uint64(1000000000)
    PrimaryBodyIrDecimalBigShiftChunk: int32 = 29
    PrimaryBodyIrDecimalBigShiftFactor: uint64 = uint64(536870912)

type
    PrimaryBodyIrDecimalBig =
        limbs: uint64[]

@borrows
fn PrimaryBodyIrDecimalBigNormalize(value: var PrimaryBodyIrDecimalBig) =
    var count = value.limbs.len
    while count > 0 && value.limbs[count - 1] == uint64(0):
        count = count - 1
    if count != value.limbs.len:
        setLen(value.limbs, count)

@borrows
fn PrimaryBodyIrDecimalBigCopyInto(value: PrimaryBodyIrDecimalBig,
                                    out: var PrimaryBodyIrDecimalBig) =
    out.limbs = []
    for i in 0..<value.limbs.len:
        add(out.limbs, value.limbs[i])

@borrows
fn PrimaryBodyIrDecimalBigCompare(lhs: PrimaryBodyIrDecimalBig,
                                   rhs: PrimaryBodyIrDecimalBig): int32 =
    if lhs.limbs.len < rhs.limbs.len:
        return -1
    if lhs.limbs.len > rhs.limbs.len:
        return 1
    var i = lhs.limbs.len - 1
    while i >= 0:
        if lhs.limbs[i] < rhs.limbs[i]:
            return -1
        if lhs.limbs[i] > rhs.limbs[i]:
            return 1
        i = i - 1
    return 0

@borrows
fn PrimaryBodyIrDecimalBigMulSmall(value: var PrimaryBodyIrDecimalBig,
                                    factor: uint64): bool =
    if factor == uint64(0) || value.limbs.len == 0:
        value.limbs = []
        return true
    var carry: uint64
    for i in 0..<value.limbs.len:
        let wide = value.limbs[i] * factor + carry
        value.limbs[i] = wide % PrimaryBodyIrDecimalBigBase
        carry = wide / PrimaryBodyIrDecimalBigBase
    while carry > uint64(0):
        add(value.limbs, carry % PrimaryBodyIrDecimalBigBase)
        carry = carry / PrimaryBodyIrDecimalBigBase
    return true

@borrows
fn PrimaryBodyIrDecimalBigShiftLeft(value: var PrimaryBodyIrDecimalBig,
                                     bitCount: int32): bool =
    if bitCount < 0:
        return false
    var remaining = bitCount
    while remaining >= PrimaryBodyIrDecimalBigShiftChunk:
        if !PrimaryBodyIrDecimalBigMulSmall(value,
                                            PrimaryBodyIrDecimalBigShiftFactor):
            return false
        remaining = remaining - PrimaryBodyIrDecimalBigShiftChunk
    if remaining > 0:
        var factor = uint64(1)
        for _ in 0..<remaining:
            factor = factor * uint64(2)
        if !PrimaryBodyIrDecimalBigMulSmall(value, factor):
            return false
    return true

@borrows
fn PrimaryBodyIrDecimalBigShiftRightOne(value: var PrimaryBodyIrDecimalBig) =
    var carry: uint64
    var i = value.limbs.len - 1
    while i >= 0:
        let wide = value.limbs[i] + carry * PrimaryBodyIrDecimalBigBase
        value.limbs[i] = wide / uint64(2)
        carry = wide % uint64(2)
        i = i - 1
    PrimaryBodyIrDecimalBigNormalize(value)

@borrows
fn PrimaryBodyIrDecimalBigSubInPlace(value: var PrimaryBodyIrDecimalBig,
                                      rhs: PrimaryBodyIrDecimalBig): bool =
    if PrimaryBodyIrDecimalBigCompare(value, rhs) < 0:
        return false
    var borrow: uint64
    for i in 0..<value.limbs.len:
        var rhsLimb: uint64
        if i < rhs.limbs.len:
            rhsLimb = rhs.limbs[i]
        let subtrahend = rhsLimb + borrow
        let current = value.limbs[i]
        if current >= subtrahend:
            value.limbs[i] = current - subtrahend
            borrow = uint64(0)
        else:
            value.limbs[i] = current + PrimaryBodyIrDecimalBigBase - subtrahend
            borrow = uint64(1)
    if borrow != uint64(0):
        return false
    PrimaryBodyIrDecimalBigNormalize(value)
    return true

@borrows
fn PrimaryBodyIrDecimalPow10Into(scale: int32,
                                  out: var PrimaryBodyIrDecimalBig): bool =
    if scale < 0:
        return false
    out.limbs = []
    let fullLimbs = scale / 9
    let tailDigits = scale % 9
    for _ in 0..<fullLimbs:
        add(out.limbs, uint64(0))
    var high = uint64(1)
    for _ in 0..<tailDigits:
        high = high * uint64(10)
    add(out.limbs, high)
    return true

@borrows
fn PrimaryBodyIrParseDecimalBig(literalRaw: str,
                                 negativeOut: var bool,
                                 numeratorOut: var PrimaryBodyIrDecimalBig,
                                 scaleOut: var int32,
                                 decimalExponentOut: var int32): bool =
    let text = strutil.Strip(literalRaw)
    negativeOut = false
    numeratorOut.limbs = []
    scaleOut = 0
    decimalExponentOut = 0
    if !PrimaryBodyIrTextIsF64Literal(text):
        return false
    var start: int32
    if text[0] == '-':
        negativeOut = true
        start = 1
    var dotIndex: int32 = -1
    var digitIndex: int32
    var firstNonZeroDigit: int32 = -1
    for i in start..<text.len:
        let ch = text[i]
        if ch == '.':
            dotIndex = i
            continue
        if firstNonZeroDigit < 0 && ch != '0':
            firstNonZeroDigit = digitIndex
        digitIndex = digitIndex + 1
        if dotIndex >= 0:
            scaleOut = scaleOut + 1
    if dotIndex < 0:
        return false
    if firstNonZeroDigit < 0:
        return true
    let digitsBeforeDot = dotIndex - start
    decimalExponentOut = digitsBeforeDot - firstNonZeroDigit - 1

    var groupValue: uint64
    var groupFactor = uint64(1)
    var groupDigits: int32
    var i = text.len - 1
    while i >= start:
        let ch = text[i]
        if ch != '.':
            let digit = uint64(int32(ch) - int32('0'))
            groupValue = groupValue + digit * groupFactor
            groupDigits = groupDigits + 1
            if groupDigits == 9:
                add(numeratorOut.limbs, groupValue)
                groupValue = uint64(0)
                groupFactor = uint64(1)
                groupDigits = 0
            else:
                groupFactor = groupFactor * uint64(10)
        i = i - 1
    if groupDigits > 0:
        add(numeratorOut.limbs, groupValue)
    PrimaryBodyIrDecimalBigNormalize(numeratorOut)
    return numeratorOut.limbs.len > 0

@borrows
fn PrimaryBodyIrDecimalRatioComparePow2(numerator: PrimaryBodyIrDecimalBig,
                                         denominator: PrimaryBodyIrDecimalBig,
                                         exponent: int32): int32 =
    var scaled: PrimaryBodyIrDecimalBig
    if exponent >= 0:
        PrimaryBodyIrDecimalBigCopyInto(denominator, scaled)
        if !PrimaryBodyIrDecimalBigShiftLeft(scaled, exponent):
            return -2
        return PrimaryBodyIrDecimalBigCompare(numerator, scaled)
    PrimaryBodyIrDecimalBigCopyInto(numerator, scaled)
    if !PrimaryBodyIrDecimalBigShiftLeft(scaled, 0 - exponent):
        return -2
    return PrimaryBodyIrDecimalBigCompare(scaled, denominator)

@borrows
fn PrimaryBodyIrDecimalBinaryExponent(numerator: PrimaryBodyIrDecimalBig,
                                       denominator: PrimaryBodyIrDecimalBig,
                                       decimalExponent: int32,
                                       exponentOut: var int32): bool =
    let scaledDecimalExponent = decimalExponent * 3321928
    if scaledDecimalExponent >= 0:
        exponentOut = scaledDecimalExponent / 1000000
    else:
        exponentOut = 0 - ((0 - scaledDecimalExponent + 999999) / 1000000)
    var settled = false
    for _ in 0..<8:
        let cmp = PrimaryBodyIrDecimalRatioComparePow2(numerator,
                                                       denominator,
                                                       exponentOut)
        if cmp == -2:
            return false
        if cmp >= 0:
            settled = true
            break
        exponentOut = exponentOut - 1
    if !settled:
        return false
    settled = false
    for _ in 0..<8:
        let cmp = PrimaryBodyIrDecimalRatioComparePow2(numerator,
                                                       denominator,
                                                       exponentOut + 1)
        if cmp == -2:
            return false
        if cmp < 0:
            settled = true
            break
        exponentOut = exponentOut + 1
    return settled

@borrows
fn PrimaryBodyIrDecimalQuotientRemainder(numerator: PrimaryBodyIrDecimalBig,
                                          denominator: PrimaryBodyIrDecimalBig,
                                          quotientOut: var uint64,
                                          remainderOut: var PrimaryBodyIrDecimalBig): bool =
    quotientOut = uint64(0)
    PrimaryBodyIrDecimalBigCopyInto(numerator, remainderOut)
    if denominator.limbs.len == 0:
        return false
    if PrimaryBodyIrDecimalBigCompare(remainderOut, denominator) < 0:
        return true
    var shifted: PrimaryBodyIrDecimalBig
    PrimaryBodyIrDecimalBigCopyInto(denominator, shifted)
    var topBit: int32
    while topBit < 63 &&
          PrimaryBodyIrDecimalBigCompare(shifted, remainderOut) <= 0:
        if !PrimaryBodyIrDecimalBigMulSmall(shifted, uint64(2)):
            return false
        topBit = topBit + 1
    if PrimaryBodyIrDecimalBigCompare(shifted, remainderOut) <= 0:
        return false
    PrimaryBodyIrDecimalBigShiftRightOne(shifted)
    topBit = topBit - 1
    var bit = topBit
    while bit >= 0:
        if PrimaryBodyIrDecimalBigCompare(remainderOut, shifted) >= 0:
            if !PrimaryBodyIrDecimalBigSubInPlace(remainderOut, shifted):
                return false
            var bitValue: uint64
            if !PrimaryBodyIrPow2U64(bit, bitValue):
                return false
            quotientOut = quotientOut + bitValue
        if bit > 0:
            PrimaryBodyIrDecimalBigShiftRightOne(shifted)
        bit = bit - 1
    return true

@borrows
fn PrimaryBodyIrDecimalRoundedQuotient(numerator: PrimaryBodyIrDecimalBig,
                                        denominator: PrimaryBodyIrDecimalBig,
                                        quotientOut: var uint64): bool =
    var remainder: PrimaryBodyIrDecimalBig
    if !PrimaryBodyIrDecimalQuotientRemainder(numerator,
                                              denominator,
                                              quotientOut,
                                              remainder):
        return false
    var twiceRemainder: PrimaryBodyIrDecimalBig
    PrimaryBodyIrDecimalBigCopyInto(remainder, twiceRemainder)
    if !PrimaryBodyIrDecimalBigMulSmall(twiceRemainder, uint64(2)):
        return false
    let roundCmp = PrimaryBodyIrDecimalBigCompare(twiceRemainder, denominator)
    if roundCmp > 0 ||
       (roundCmp == 0 && (quotientOut & uint64(1)) == uint64(1)):
        quotientOut = quotientOut + uint64(1)
    return true

@borrows
fn PrimaryBodyIrF64LiteralBits(literalRaw: str,
                                bitsOut: var uint64): bool =
    var negative: bool
    var numerator: PrimaryBodyIrDecimalBig
    var scale: int32
    var decimalExponent: int32
    if !PrimaryBodyIrParseDecimalBig(literalRaw,
                                     negative,
                                     numerator,
                                     scale,
                                     decimalExponent):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "parse")
    var signBit: uint64
    if negative && !PrimaryBodyIrPow2U64(63, signBit):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "sign_pow2")
    if numerator.limbs.len == 0:
        bitsOut = uint64(0)
        if negative:
            bitsOut = signBit
        return true
    var hiddenBit: uint64
    if !PrimaryBodyIrPow2U64(52, hiddenBit):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "hidden_pow2")

    # Decimal exponents outside these bounds are unambiguous without building
    # 10^scale: >=1e309 rounds to infinity; <1e-324 is below half min-subnormal.
    if decimalExponent >= 309:
        bitsOut = uint64(0x7ff) * hiddenBit
        if negative:
            bitsOut = bitsOut | signBit
        return true
    if decimalExponent < -324:
        bitsOut = uint64(0)
        if negative:
            bitsOut = signBit
        return true

    var denominator: PrimaryBodyIrDecimalBig
    if !PrimaryBodyIrDecimalPow10Into(scale, denominator):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "pow10")
    var exponent: int32
    if !PrimaryBodyIrDecimalBinaryExponent(numerator,
                                           denominator,
                                           decimalExponent,
                                           exponent):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "binary_exponent")
    if exponent > 1023:
        bitsOut = uint64(0x7ff) * hiddenBit
        if negative:
            bitsOut = bitsOut | signBit
        return true

    var scaledNumerator: PrimaryBodyIrDecimalBig
    var scaledDenominator: PrimaryBodyIrDecimalBig
    PrimaryBodyIrDecimalBigCopyInto(numerator, scaledNumerator)
    PrimaryBodyIrDecimalBigCopyInto(denominator, scaledDenominator)
    if exponent < -1022:
        if !PrimaryBodyIrDecimalBigShiftLeft(scaledNumerator, 1074):
            return PrimaryBodyIrF64LiteralFail(literalRaw, "subnormal_shift")
        var subnormal: uint64
        if !PrimaryBodyIrDecimalRoundedQuotient(scaledNumerator,
                                                scaledDenominator,
                                                subnormal):
            return PrimaryBodyIrF64LiteralFail(literalRaw, "subnormal_round")
        if subnormal >= hiddenBit:
            bitsOut = hiddenBit
        else:
            bitsOut = subnormal
        if negative:
            bitsOut = bitsOut | signBit
        return true

    let significandShift = 52 - exponent
    if significandShift >= 0:
        if !PrimaryBodyIrDecimalBigShiftLeft(scaledNumerator,
                                             significandShift):
            return PrimaryBodyIrF64LiteralFail(literalRaw, "normal_num_shift")
    else:
        if !PrimaryBodyIrDecimalBigShiftLeft(scaledDenominator,
                                             0 - significandShift):
            return PrimaryBodyIrF64LiteralFail(literalRaw, "normal_den_shift")
    var significand: uint64
    if !PrimaryBodyIrDecimalRoundedQuotient(scaledNumerator,
                                            scaledDenominator,
                                            significand):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "normal_round")
    var overflowBit: uint64
    if !PrimaryBodyIrPow2U64(53, overflowBit):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "overflow_pow2")
    if significand >= overflowBit:
        significand = significand / uint64(2)
        exponent = exponent + 1
    if exponent > 1023:
        bitsOut = uint64(0x7ff) * hiddenBit
    else:
        if significand < hiddenBit:
            return PrimaryBodyIrF64LiteralFail(literalRaw, "normal_significand")
        bitsOut = uint64(exponent + 1023) * hiddenBit +
                  (significand - hiddenBit)
    if negative:
        bitsOut = bitsOut | signBit
    return true
# DECIMAL_F64_EXACT_END
@borrows
fn PrimaryBodyIrAppendF64ConstOperands(op: var coreir.BodyOp,
                                        literalRaw: str): bool =
    var bits: uint64
    if !PrimaryBodyIrF64LiteralBits(literalRaw, bits):
        return false
    let chunk = uint64(65536)
    let chunk2 = chunk * chunk
    let chunk3 = chunk2 * chunk
    add(op.operands, coreir.LocalF64Tag)
    add(op.operands, int32(bits % chunk))
    add(op.operands, int32((bits / chunk) % chunk))
    add(op.operands, int32((bits / chunk2) % chunk))
    add(op.operands, int32((bits / chunk3) % chunk))
    return true


@borrows
fn PrimaryBodyIrPrimitiveCastConstTypeKind(textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    if PrimaryBodyIrWholeCallInnerForHead(text, "int8") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "Int8") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "uint8") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "UInt8") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "uint32") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "UInt32") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "int32") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "Int32") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "uint64") != "":
        return coreir.LocalI64Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "UInt64") != "":
        return coreir.LocalI64Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "int64") != "":
        return coreir.LocalI64Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "Int64") != "":
        return coreir.LocalI64Tag
    return coreir.LocalInvalidTag

@borrows
fn PrimaryBodyIrCanonicalConstI32(typedIr: texpr.TypedExprIr,
                                  sourcePath: str,
                                  nameRaw: str,
                                  found: var bool): int32 =
    found = false
    let name = strutil.Strip(nameRaw)
    if sourcePath == "" || name == "":
        return 0
    var visitedOwners: str[]
    var visitedNames: str[]
    var recognized = false
    var value: int64
    if !texpr.TypedExprIrCallConstIntValue(typedIr,
                                           sourcePath,
                                           name,
                                           visitedOwners,
                                           visitedNames,
                                           recognized,
                                           value):
        if recognized:
            panic(Fmt"backend2: structured int const is invalid or cyclic source={sourcePath} name={name}")
        return 0
    if !recognized:
        return 0
    if value < Int64(-2147483648) || value > Int64(2147483647):
        panic(Fmt"backend2: structured int const out of int32 range source={sourcePath} name={name}")
    found = true
    return int32(value)

@borrows
fn PrimaryBodyIrCanonicalQualifiedConstI32(typedIr: texpr.TypedExprIr,
                                           sourcePath: str,
                                           nameRaw: str,
                                           found: var bool): int32 =
    found = false
    let nameText = strutil.Strip(nameRaw)
    if !texpr.TypedExprTextIsSimpleFieldPath(nameText):
        return 0
    return PrimaryBodyIrCanonicalConstI32(typedIr,
                                          sourcePath,
                                          nameText,
                                          found)

@borrows
fn PrimaryBodyIrTextIsStringLiteral(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if len(text) < 2:
        return false
    if text[0] != '"':
        return false
    if text[len(text) - 1] != '"':
        return false
    return true

@borrows
fn PrimaryBodyIrCanonicalConstStrLiteral(typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         nameRaw: str): str =
    var ownerSourcePath = parser.ParserNormalizePath(sourcePath)
    var name = strutil.Strip(nameRaw)
    if ownerSourcePath == "" || name == "":
        return ""
    var visitedOwners: str[]
    var visitedNames: str[]
    while true:
        var targetOwnerSourcePath = ""
        var literal = ""
        var found = false
        var cycle = false
        if !texpr.TypedExprIrCallConstTarget(typedIr,
                                             ownerSourcePath,
                                             name,
                                             visitedOwners,
                                             visitedNames,
                                             targetOwnerSourcePath,
                                             literal,
                                             found,
                                             cycle):
            if cycle:
                panic(Fmt"backend2: structured string const cycle source={ownerSourcePath} name={name}")
            if found:
                panic(Fmt"backend2: structured string const payload invalid source={ownerSourcePath} name={name}")
            return ""
        let literalText = strutil.Strip(literal)
        if PrimaryBodyIrTextIsStringLiteral(literalText):
            return literalText
        if parser.ParserIdentPrefix(literalText) == literalText ||
           texpr.TypedExprTextIsSimpleFieldPath(literalText):
            ownerSourcePath = targetOwnerSourcePath
            name = literalText
            continue
        return ""

@borrows
fn PrimaryBodyIrCanonicalQualifiedConstStrLiteral(typedIr: texpr.TypedExprIr,
                                                  sourcePath: str,
                                                  nameRaw: str): str =
    let nameText = strutil.Strip(nameRaw)
    if !texpr.TypedExprTextIsSimpleFieldPath(nameText):
        return ""
    return PrimaryBodyIrCanonicalConstStrLiteral(typedIr,
                                                  sourcePath,
                                                  nameText)

# bail=44 C4: 跨模块限定枚举成员 (os.pcDir / parser.NormalizedExprSurfaceCallLocal)
# 作标量 call-arg。const 缓存查不到 (枚举成员不在 const 块), 由 typedIr 合并枚举表
# (metadataContexts 预灌, 早于函数 IR 构建) 解 ordinal。qualifier → 目标模块路径
# 解析与上面 const 路径同口径; 查不到返回 found=false 让位既有路径 (poison 不变)。
@borrows
fn PrimaryBodyIrLookupQualifiedSourceEnumI32(typedIr: texpr.TypedExprIr,
                                              sourcePath: str,
                                              nameRaw: str,
                                              found: var bool): int32 =
    found = false
    let nameText = strutil.Strip(nameRaw)
    if !texpr.TypedExprTextIsSimpleFieldPath(nameText):
        return 0
    let qualifier = texpr.TypedExprAssignLhsRootName(nameText)
    let memberName = texpr.TypedExprAssignFieldPath(nameText)
    if qualifier == "" || memberName == "":
        return 0
    if PrimaryBodyIrTextHasFieldOrIndex(memberName):
        return 0
    var targetSourcePath = texpr.TypedExprIrLookupTypeAliasTargetSourcePath(typedIr,
                                                                           sourcePath,
                                                                           qualifier)
    if targetSourcePath == "":
        targetSourcePath = PrimaryBodyIrImportAliasTargetSourcePath(typedIr,
                                                                    sourcePath,
                                                                    qualifier)
    # bail=44 同模块: qualifier 非 import/type 别名, 但确为【本源】定义的枚举类型
    # (enum_value/nested_match/r15/r16 全族根)。链尾补一手, 严等 qualifier 是本源
    # enum 类型才把 targetSourcePath 定回本源; 非枚举 qualifier 保持 "" → return 0
    # (poison 不变), 与既有跨模块/别名路径形态严不重叠。
    if targetSourcePath == "" &&
       texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, qualifier):
        targetSourcePath = sourcePath
    if targetSourcePath == "":
        return 0
    var enumTypeName = ""
    var enumOrdinal: int32
    if !texpr.TypedExprIrLookupEnumConstValue(typedIr,
                                              targetSourcePath,
                                              memberName,
                                              enumTypeName,
                                              enumOrdinal):
        return 0
    found = true
    return enumOrdinal

@borrows
fn PrimaryBodyIrNextLocalStackOffset(bodyIR: coreir.BodyIR,
                                      sizeBytes: int32,
                                      alignBytes: int32): int32 =
    var offset: int32 = 16
    for i in 0..<bodyIR.localSlots.len:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[i]):
            continue
        let slotSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[i])
        if slotSize <= 0:
            continue
        let slotEnd = bodyIR.localSlots[i].stackOffset + slotSize
        if slotEnd > offset:
            offset = slotEnd
    var align = alignBytes
    if align <= 0:
        align = 1
    if align > 16:
        align = 16
    return ((offset + align - 1) / align) * align

fn PrimaryBodyIrReflowLocalStackOffsets(bodyIR: var coreir.BodyIR) =
    # Two passes: scalar slots (<= 8 bytes, accessed with single scaled-imm
    # ldr/str whose range is 16380/32760 bytes) first so they keep small
    # offsets; wide slots (str 24B, aggregates) after — they are accessed
    # through materialized address registers that handle any offset.
    var offset: int32 = 16
    for i in 0..<bodyIR.localSlots.len:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[i]):
            continue
        let slotSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[i])
        if slotSize <= 0 || slotSize > 8:
            continue
        var align = bodyIR.localSlots[i].alignBytes
        if align <= 0:
            align = 1
        if align > 16:
            align = 16
        offset = ((offset + align - 1) / align) * align
        bodyIR.localSlots[i].stackOffset = offset
        offset = offset + slotSize
    for i in 0..<bodyIR.localSlots.len:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[i]):
            continue
        let slotSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[i])
        if slotSize <= 8:
            continue
        var align = bodyIR.localSlots[i].alignBytes
        if align <= 0:
            align = 1
        if align > 16:
            align = 16
        offset = ((offset + align - 1) / align) * align
        bodyIR.localSlots[i].stackOffset = offset
        offset = offset + slotSize

@borrows
fn PrimaryBodyIrDefaultSlotSizeBytes(typeKind: int32): int32 =
    if typeKind == coreir.LocalI32Tag:
        return 4
    if typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalF64Tag ||
       typeKind == coreir.LocalPtrTag:
        return 8
    if typeKind == coreir.LocalStrTag:
        return 24
    if typeKind == coreir.LocalAggregateTag:
        return coreir.ResultStrSizeBytes
    return 0

fn PrimaryBodyIrDefaultSlotAlignBytes(typeKind: int32): int32 =
    if typeKind == coreir.LocalI32Tag:
        return 4
    if typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalF64Tag ||
       typeKind == coreir.LocalPtrTag:
        return 8
    if typeKind == coreir.LocalStrTag:
        return 8
    if typeKind == coreir.LocalAggregateTag:
        return coreir.ResultStrAlignBytes
    return 0

@borrows
fn PrimaryBodyIrNormalizeSlotSizeBytes(typeKind: int32, sizeBytes: int32): int32 =
    let defaultSize = PrimaryBodyIrDefaultSlotSizeBytes(typeKind)
    if sizeBytes <= 0:
        return defaultSize
    if typeKind != coreir.LocalAggregateTag && defaultSize > 0 && sizeBytes < defaultSize:
        return defaultSize
    return sizeBytes

# Aggregate slots are copied with 8-byte scaled loads (sret return copy,
# slot-to-slot copies), whose encodings require 8-aligned stack offsets, so
# the per-type alignment (e.g. FixedBytes32 align 1) is only a lower bound.
@borrows
fn PrimaryBodyIrNormalizeSlotAlignBytes(typeKind: int32, alignBytes: int32): int32 =
    let defaultAlign = PrimaryBodyIrDefaultSlotAlignBytes(typeKind)
    if alignBytes <= 0:
        return defaultAlign
    if defaultAlign > 0 && alignBytes < defaultAlign:
        return defaultAlign
    return alignBytes

@borrows
fn PrimaryBodyIrNodeResultTypeText(typedIr: texpr.TypedExprIr, nodeIndex: int32): str =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return ""
    let resultTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                             typedIr.nodes2_resultTypeIds[nodeIndex])
    if IsOk(resultTypeRes):
        return Value(resultTypeRes)
    return ""

@borrows
fn PrimaryBodyIrScalarRetypeKind(kind: int32): bool =
    return kind == coreir.LocalI32Tag ||
           kind == coreir.LocalI64Tag ||
           kind == coreir.LocalF64Tag

@borrows
fn PrimaryBodyIrRetypeLocalScalarSlotForType(bodyIR: var coreir.BodyIR,
                                             typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             slotId: int32,
                                             typeRaw: str): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return false
    var desiredKind: int32
    var desiredSize: int32
    var desiredAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, typeRaw, desiredKind, desiredSize, desiredAlign)
    if !PrimaryBodyIrScalarRetypeKind(desiredKind) && desiredKind != coreir.LocalStrTag:
        return false
    var slot = bodyIR.localSlots[slotId]
    if PrimaryBodyIrLocalIsParam(slot):
        return false
    if !PrimaryBodyIrScalarRetypeKind(slot.typeKind):
        return false
    if slot.typeKind == desiredKind:
        return true
    slot.typeKind = desiredKind
    slot.sizeBytes = PrimaryBodyIrNormalizeSlotSizeBytes(desiredKind, desiredSize)
    slot.alignBytes = PrimaryBodyIrNormalizeSlotAlignBytes(desiredKind, desiredAlign)
    slot.auxValue = 0
    bodyIR.localSlots[slotId] = slot
    PrimaryBodyIrReflowLocalStackOffsets(bodyIR)
    return true

@borrows
fn PrimaryBodyIrLocalSlotNewSized(bodyIR: var coreir.BodyIR,
                                   slotId: int32,
                                   name: str,
                                   typeKind: int32,
                                   sizeBytes: int32,
                                   alignBytes: int32) =
    var ls: coreir.LocalSlot
    ls.id = slotId
    ls.name = name
    ls.typeKind = typeKind
    ls.placeKind = coreir.BodyPlaceStackValueTag
    ls.auxValue = 0
    ls.ownership = coreir.OwnPlainTag
    ls.aliasClass = coreir.AliasUnknownTag
    ls.escapeKind = coreir.EscapeNoneTag
    ls.noAlias = false
    coreir.BodyIRApplyLocalSlotDefaultProof(ls)
    if typeKind == coreir.LocalI32Tag:
        ls.sizeBytes = 4
        ls.alignBytes = 4
    elif typeKind == coreir.LocalI64Tag:
        ls.sizeBytes = 8
        ls.alignBytes = 8
    elif typeKind == coreir.LocalF64Tag:
        ls.sizeBytes = 8
        ls.alignBytes = 8
    elif typeKind == coreir.LocalStrTag:
        ls.sizeBytes = 24
        ls.alignBytes = 8
    elif typeKind == coreir.LocalPtrTag:
        ls.sizeBytes = 8
        ls.alignBytes = 8
    elif typeKind == coreir.LocalAggregateTag:
        ls.sizeBytes = coreir.ResultStrSizeBytes
        ls.alignBytes = coreir.ResultStrAlignBytes
    let desiredSize = PrimaryBodyIrNormalizeSlotSizeBytes(typeKind, sizeBytes)
    let desiredAlign = PrimaryBodyIrNormalizeSlotAlignBytes(typeKind, alignBytes)
    if desiredSize > 0:
        ls.sizeBytes = desiredSize
    if desiredAlign > 0:
        ls.alignBytes = desiredAlign
    ls.stackOffset = PrimaryBodyIrNextLocalStackOffset(bodyIR, ls.sizeBytes, ls.alignBytes)
    add(bodyIR.localSlots, ls)
    coreir.BodyIRAppendUnboundLocalBindingValueDefinitionRow(
        bodyIR, slotId)

@borrows
fn PrimaryBodyIrLocalSlotNew(bodyIR: var coreir.BodyIR,
                              slotId: int32,
                              name: str,
                              typeKind: int32) =
    PrimaryBodyIrLocalSlotNewSized(bodyIR, slotId, name, typeKind, 0, 0)

@borrows
fn PrimaryBodyIrTypeKindFromText(typeRaw: str): int32 =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if PrimaryStartsWith(normType, "var"):
        return coreir.LocalPtrTag
    if PrimaryStartsWith(normType, "ref"):
        return coreir.LocalPtrTag
    if len(normType) > 0 && normType[len(normType) - 1] == '*':
        return coreir.LocalPtrTag
    if normType == "int64" || normType == "uint64" || normType == "u64" || normType == "i64":
        return coreir.LocalI64Tag
    if normType == "float64" || normType == "f64":
        return coreir.LocalF64Tag
    if normType == "str":
        return coreir.LocalStrTag
    if normType == "cstring" || normType == "ptr" || normType == "void*":
        return coreir.LocalPtrTag
    if normType == "Bytes" ||
       normType == "bytes.Bytes" ||
       normType == "rawbytes.Bytes" ||
       normType == "ByteBuffer" ||
       normType == "GrowByteBuffer" ||
       normType == "buffer.GrowByteBuffer":
        return coreir.LocalAggregateTag
    if PrimaryStartsWith(normType, "Result["):
        return coreir.LocalAggregateTag
    # Option[T] = { has: bool@0; value: T } builtin generic aggregate. Without
    # this branch the `Option`-leaf (uppercase first char) falls to the
    # LocalPtrTag default below, so a local `var opt: Option[Inner]` is minted
    # as an 8-byte pointer slot and every `opt.has`/`opt.value` store dereferences
    # an uninitialised handle -> SIGSEGV. Mirror the Result[ aggregate classification.
    if PrimaryStartsWith(normType, "Option["):
        return coreir.LocalAggregateTag
    # Qualified `<mod>.Option[Inner]` (import std/option records the binding
    # type qualified) must classify like the bare `Option[` prefix. Without
    # this the uppercase-leaf default below mints the local as a pointer slot
    # while the write side (field-meta path, which handles the qualified form)
    # stores the aggregate in place -> the `.has` read derefs struct content
    # (x9 = value<<32|has) -> SIGSEGV/SIGBUS. Top-level token search keeps
    # nested generics (`Foo[option.Option[X]]`) out.
    if len(normType) > 0 &&
       normType[len(normType) - 1] == ']' &&
       texpr.TypedExprFindTopLevelTextToken(normType, ".Option[") >= 0:
        return coreir.LocalAggregateTag
    if PrimaryStartsWith(normType, "seq[") ||
       (len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]"):
        return coreir.LocalAggregateTag
    if len(normType) > 0:
        var leafStart = 0
        for ci in 0..<len(normType):
            if normType[ci] == '.':
                leafStart = ci + 1
        let firstCh = normType[leafStart]
        if firstCh >= 'A':
            if firstCh <= 'Z':
                return coreir.LocalPtrTag
    return coreir.LocalI32Tag

@borrows
fn PrimaryBodyIrPointeeTypeText(typeRaw: str): str =
    let typeText = texpr.TypedExprStripVarType(typeRaw)
    if typeText == "":
        return ""
    if len(typeText) > 0 && typeText[len(typeText) - 1] == '*':
        return strutil.Strip(strings.SliceBytes(typeText, 0, len(typeText) - 1))
    var primaryColdCond1: bool
    var primaryColdCond1Clause0: bool
    if len(typeText) > 3:
        if strings.SliceBytes(typeText, 0, 3) == "ref":
            if typeText[3] >= 'A':
                if typeText[3] <= 'Z':
                    primaryColdCond1Clause0 = true
    if primaryColdCond1Clause0:
        primaryColdCond1 = true
    if primaryColdCond1:
        return strutil.Strip(strings.SliceBytes(typeText, 3, len(typeText) - 3))
    return ""

@borrows
fn PrimaryBodyIrPointeeTypeTextForSource(typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          typeRaw: str): str =
    let aliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                    sourcePath,
                                                                    typeRaw)
    if aliasTarget != "":
        let aliasPointee = PrimaryBodyIrPointeeTypeText(aliasTarget)
        if aliasPointee != "":
            return aliasPointee
    return PrimaryBodyIrPointeeTypeText(typeRaw)

@borrows
fn PrimaryBodyIrFixedArrayLengthFromText(typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         countRaw: str): int32 =
    let countText = strutil.Strip(countRaw)
    if countText == "":
        return 0
    let directValue = PrimaryBodyIrExtractIntFromText(countText)
    if directValue > 0:
        return directValue
    var found = false
    let constValue = PrimaryBodyIrCanonicalConstI32(typedIr,
                                                   sourcePath,
                                                   countText,
                                                   found)
    if !found:
        return 0
    if constValue <= 0:
        return 0
    return constValue

@borrows
fn PrimaryBodyIrFixedArrayShapeFromText(typedIr: texpr.TypedExprIr,
                                        sourcePath: str,
                                        typeRaw: str,
                                        sizeBytes: var int32,
                                        alignBytes: var int32): bool =
    sizeBytes = 0
    alignBytes = 0
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    if typeText == "" ||
       PrimaryStartsWith(typeText, "seq[") ||
       PrimaryStartsWith(typeText, "array[") ||
       PrimaryStartsWith(typeText, "Result["):
        return false
    if len(typeText) < 4 || typeText[len(typeText) - 1] != ']':
        return false
    let openPos = parser.ParserFindText(typeText, "[")
    if openPos <= 0:
        return false
    let elemType = strings.SliceBytes(typeText, 0, openPos)
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   elemType,
                                   elemKind,
                                   elemSize,
                                   elemAlign)
    if elemSize <= 0:
        return false
    if elemAlign <= 0:
        return false
    # Multi-dimensional fixed arrays `T[d0][d1]...` lay out row-major as one
    # flat block of (d0*d1*...) elements. Walk every `[N]` group and accumulate
    # the product so the slot size (and thus the zero-init fill) covers all
    # cells. A single group reduces to the 1-D case.
    var total: int32
    total = 1
    var groupCount: int32
    groupCount = 0
    var pos = openPos
    while pos < len(typeText):
        if typeText[pos] != '[':
            return false
        var closePos: int32
        closePos = -1
        for j in pos..<len(typeText):
            if typeText[j] == ']':
                closePos = j
                break
        if closePos < 0:
            return false
        let countText = strutil.Strip(strings.SliceBytes(typeText, pos + 1, closePos - pos - 1))
        let count = PrimaryBodyIrFixedArrayLengthFromText(typedIr,
                                                          sourcePath,
                                                          countText)
        if count <= 0:
            return false
        total = total * count
        groupCount = groupCount + 1
        pos = closePos + 1
    if groupCount <= 0:
        return false
    sizeBytes = PrimaryBodyIrAlignedOffset(elemSize * total, elemAlign)
    alignBytes = elemAlign
    return true

@borrows
fn PrimaryBodyIrTypeTextIsGenericPointer(typeRaw: str): bool =
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    if typeText == "ptr":
        return true
    if typeText == "void*":
        return true
    return false

var primaryBodyIrTypeShapeActiveSourcePaths: str[]
var primaryBodyIrTypeShapeActiveTypes: str[]

# Option[T] = { has: bool@0; value: T@align(1,alignT) } builtin generic aggregate
# shape. Split out of PrimaryBodyIrTypeShapeFromTextImpl to keep that large
# function's frame small (an inline block there desyncs the self-baked driver's
# codegen layout). Returns true and fills the shape when `normType` is a concrete
# `Option[Inner]` whose inner shape resolves; false otherwise. Layout mirrors the
# front-end TypedExprTypeLayoutImpl Option handler byte-for-byte (has flag first,
# value aligned to its own alignment, whole struct aligned to the value's).
@borrows
fn PrimaryBodyIrOptionShapeFromText(typedIr: texpr.TypedExprIr,
                                    sourcePath: str,
                                    normType: str,
                                    typeKind: var int32,
                                    sizeBytes: var int32,
                                    alignBytes: var int32): bool =
    # Accept both the bare `Option[Inner]` text and the module-qualified
    # `<mod>.Option[Inner]` form (import std/option records the binding type
    # qualified); mirror PrimaryBodyIrLookupOptionFieldMeta's qualifier strip
    # so slot sizing and field metadata stay byte-consistent.
    var optionType = normType
    if !PrimaryStartsWith(optionType, "Option["):
        let optionDotPos = texpr.TypedExprFindTopLevelTextToken(optionType, ".Option[")
        if optionDotPos < 0:
            return false
        optionType = strings.SliceBytes(optionType,
                                        optionDotPos + 1,
                                        len(optionType) - optionDotPos - 1)
    if len(optionType) <= 8:
        return false
    if strings.SliceBytes(optionType, len(optionType) - 1, 1) != "]":
        return false
    let optInner = strings.SliceBytes(optionType, 7, len(optionType) - 8)
    var optValueKind: int32
    var optValueSize: int32
    var optValueAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   optInner,
                                   optValueKind,
                                   optValueSize,
                                   optValueAlign)
    if optValueSize <= 0:
        return false
    if optValueAlign <= 0:
        return false
    let optValueOffset = PrimaryBodyIrAlignedOffset(1, optValueAlign)
    typeKind = coreir.LocalAggregateTag
    sizeBytes = PrimaryBodyIrAlignedOffset(optValueOffset + optValueSize, optValueAlign)
    alignBytes = optValueAlign
    return true

@borrows
fn PrimaryBodyIrTypeShapeFromText(typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   typeRaw: str,
                                   typeKind: var int32,
                                   sizeBytes: var int32,
                                   alignBytes: var int32) =
    # Type expansion is a graph walk, not a bounded-depth approximation. Track
    # the exact (declaring source, normalized type) states on the active path:
    # arbitrarily deep acyclic layouts remain valid, while an alias/layout cycle
    # fails closed at the first repeated state.
    let activeType = texpr.TypedExprNormalizeTypeText(typeRaw)
    for activeIndex in 0..<primaryBodyIrTypeShapeActiveTypes.len:
        if primaryBodyIrTypeShapeActiveTypes[activeIndex] == activeType &&
           PrimaryPathNormalizedEquals(primaryBodyIrTypeShapeActiveSourcePaths[activeIndex],
                                       sourcePath):
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=recursion_cycle helper=type_shape text=",
                                                       strings.CloneStr(typeRaw),
                                                       " source=",
                                                       strings.CloneStr(sourcePath)], ""))
            typeKind = coreir.LocalInvalidTag
            sizeBytes = 0
            alignBytes = 0
            return
    add(primaryBodyIrTypeShapeActiveSourcePaths, strings.CloneStr(sourcePath))
    add(primaryBodyIrTypeShapeActiveTypes, activeType)
    PrimaryBodyIrTypeShapeFromTextImpl(typedIr,
                                       sourcePath,
                                       typeRaw,
                                       typeKind,
                                       sizeBytes,
                                       alignBytes)
    setLen(primaryBodyIrTypeShapeActiveSourcePaths,
           primaryBodyIrTypeShapeActiveSourcePaths.len - 1)
    setLen(primaryBodyIrTypeShapeActiveTypes,
           primaryBodyIrTypeShapeActiveTypes.len - 1)

@borrows
fn PrimaryBodyIrTypeShapeFromTextImpl(typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   typeRaw: str,
                                   typeKind: var int32,
                                   sizeBytes: var int32,
                                   alignBytes: var int32) =
    typeKind = PrimaryBodyIrTypeKindFromText(typeRaw)
    sizeBytes = 0
    alignBytes = 0
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "uint8" || normType == "int8" || normType == "u8" || normType == "i8":
        typeKind = coreir.LocalI32Tag
        sizeBytes = 1
        alignBytes = 1
        return
    if normType == "uint16" || normType == "int16" || normType == "u16" || normType == "i16":
        typeKind = coreir.LocalI32Tag
        sizeBytes = 2
        alignBytes = 2
        return
    if normType == "bool" || normType == "int32" || normType == "i32":
        typeKind = coreir.LocalI32Tag
        sizeBytes = 4
        alignBytes = 4
        return
    if normType == "int64" || normType == "uint64" || normType == "u64" || normType == "i64":
        typeKind = coreir.LocalI64Tag
        sizeBytes = 8
        alignBytes = 8
        return
    # f64 shape mirror of the i64 branch above. TypeKindFromText already maps
    # float64/f64 -> LocalF64Tag, but without this branch sizeBytes/alignBytes
    # stay 0, so any field-read scalar resolver that probes a float64 field via
    # TypeShapeFromText (ConditionFieldOperandSlot direct `root.field` path)
    # rejects it on `fieldSize <= 0` and the cast-arm f64 rescue can't mint the
    # arg slot -> bail=803 on `out = int64(node.f)` direct field reads. The
    # indexed-field path (node.ovalues[i].f) sizes f64 through
    # SeqElementShapeFromText, which is why the indexed form clears.
    if normType == "float64" || normType == "f64":
        typeKind = coreir.LocalF64Tag
        sizeBytes = 8
        alignBytes = 8
        return
    if normType == "str":
        typeKind = coreir.LocalStrTag
        sizeBytes = 24
        alignBytes = 8
        return
    if normType == "FixedBytes32" || normType == "layout.FixedBytes32" || normType == "bytes_layout.FixedBytes32":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 32
        alignBytes = 1
        return
    if normType == "FixedBytes64" || normType == "layout.FixedBytes64" || normType == "bytes_layout.FixedBytes64":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 64
        alignBytes = 1
        return
    if normType == "FixedBytes65" || normType == "layout.FixedBytes65" || normType == "bytes_layout.FixedBytes65":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 65
        alignBytes = 1
        return
    if normType == "ErrorInfo":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 32
        alignBytes = 8
        return
    # Keep cross-module nested layout congruent with primary_object_plan.
    # TypedExprFactTable's live Cheng type is the unique source of truth.
    if normType == "Arena" || normType == "arenamod.Arena" || normType == "arena.Arena":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 24
        alignBytes = 8
        return
    if normType == "ArenaArrayInt32" || normType == "arenamod.ArenaArrayInt32" ||
       normType == "arena.ArenaArrayInt32":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 16
        alignBytes = 4
        return
    if normType == "TypedExprFactTable" || normType == "texpr.TypedExprFactTable" ||
       normType == "typed_expr.TypedExprFactTable":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = Int32(sizeof(texpr.TypedExprFactTable))
        alignBytes = 8
        return
    if normType == "NormalizedExprLookup" || normType == "parser.NormalizedExprLookup":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 32
        alignBytes = 8
        return
    if normType == "NormalizedExprLayer" || normType == "parser.NormalizedExprLayer":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 80
        alignBytes = 8
        return
    if normType == "SystemLinkPlanStub" || normType == "slplan.SystemLinkPlanStub" || normType == "system_link_plan.SystemLinkPlanStub":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 744
        alignBytes = 8
        return
    if normType == "cstring" || normType == "owned_cstring" ||
       normType == "ptr" || normType == "void*":
        typeKind = coreir.LocalPtrTag
        sizeBytes = 8
        alignBytes = 8
        return
    # bigint.BigInt cross-module: {count: int32(4) + limbs: int32[256](1024)} = 1028.
    # Layout registered only in bigint.cheng sourcePath-scoped table, so cross-module
    # callers (rsa.cheng) can't resolve via TypeShapeFromText. Hard-code like ErrorInfo.
    if normType == "BigInt" || normType == "bigint.BigInt":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 1028
        alignBytes = 4
        return
    # p256_fixed.P256Fixed cross-module: {limbs: int32[8]} = 32 bytes.
    if normType == "P256Fixed" || normType == "p256_fixed.P256Fixed" ||
       normType == "pfix.P256Fixed":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 32
        alignBytes = 4
        return
    # ecnist.EcPointFixed cross-module: {x: P256Fixed(32) + y: P256Fixed(32) + inf: bool(4)} = 68.
    if normType == "EcPointFixed" || normType == "ecnist.EcPointFixed":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 68
        alignBytes = 4
        return
    # Function-pointer types (`fn(...)`) — directly or as an alias target like
    # `IoMeterHook = fn(...)` — lower to a raw 8-byte code pointer. Without this
    # the `fn(`-leaf recurses to the lowercase-leaf default (I32, size 0) and
    # truncates the slot, so `hook == nil` probes mis-classify the value side.
    if texpr.TypedExprTypeTextIsFnPtr(normType):
        typeKind = coreir.LocalPtrTag
        sizeBytes = 8
        alignBytes = 8
        return
    var shapeAliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                         sourcePath,
                                                                         normType)
    if shapeAliasTarget == "" &&
       texpr.TypedExprQualifiedCallDot(normType) >= 0 &&
       !PrimaryStartsWith(normType, "seq[") &&
       !PrimaryStartsWith(normType, "array[") &&
       !PrimaryStartsWith(normType, "Result[") &&
       !(len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]"):
        # 限定标量 typedef（如 langintern.InternId = int32）：别名表按未限定 leaf
        # 建键，但 lookup 内部 ParserIdentPrefix 把限定名截到限定符（"langintern"）
        # 而 miss，导致大写-leaf 标量 typedef 默认落 8 字节指针。限定全名 miss 时按
        # 限定 leaf 重试，使其归一到底层标量。seq/array/Result 形不走此回退（由后续
        # 分支按聚合定形），避免 InternId[] 被误折成 int32。
        let shapeAliasLeaf = texpr.TypedExprQualifiedCallLeaf(normType)
        if shapeAliasLeaf != "" && shapeAliasLeaf != normType:
            shapeAliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                             sourcePath,
                                                                             shapeAliasLeaf)
    # Dynamic seq (`T[]`), `seq[...]`, fixed `array[...]`, and `Result[...]`
    # forms are shaped by their own branches below, never by the element/alias
    # target. The alias lookup strips the `[]` suffix and resolves the element
    # name (e.g. `TypedExprFact[]` → `texpr.TypedExprFact`), so without this
    # guard a seq-of-alias field would be mis-shaped as the bare element (8B for
    # a cross-module struct alias) instead of the 16B seq header — collapsing
    # `csg.typedExprFacts.len` (header off0 w4) at the node path. Mirrors the
    # qualified-leaf retry guard above.
    var shapeNormIsSeqLike: bool
    if PrimaryStartsWith(normType, "seq[") ||
       PrimaryStartsWith(normType, "array[") ||
       PrimaryStartsWith(normType, "Result[") ||
       (len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]"):
        shapeNormIsSeqLike = true
    if !shapeNormIsSeqLike &&
       shapeAliasTarget != "" &&
       texpr.TypedExprNormalizeTypeText(shapeAliasTarget) != normType:
        # Type alias (e.g. File = ptr): shape by the alias target, or an
        # 8-byte pointer would be classified as an aggregate and loaded
        # with the wrong width. Pointer-target aliases (T = U *) are
        # always pointer-shaped.
        if PrimaryBodyIrPointeeTypeText(shapeAliasTarget) != "":
            typeKind = coreir.LocalPtrTag
            sizeBytes = 8
            alignBytes = 8
            return
        # `Name = ref` / `ref object` / `ref Other` 声明在解析期同时落入 ref-object
        # 注册表和 typedef-alias 表(别名目标文本恒为 `ref`...)。此处通用别名整形
        # 分支先于下方 line~2739 的权威 ref 判定触发,会把字面串 `ref` 递归整形为
        # size 0,使 Result[<ref>] 的 Ok/Err 构造布局门失败而落 result_construct 缺口。
        # 命名 ref 句柄恒为 8 字节指针:在递归前按 ref 注册表如实定形。
        if texpr.TypedExprIrTypeIsRef(typedIr, sourcePath, typeRaw):
            typeKind = coreir.LocalPtrTag
            sizeBytes = 8
            alignBytes = 8
            return
        let shapeAliasNorm = texpr.TypedExprNormalizeTypeText(shapeAliasTarget)
        var shapeIsVarOrPtrType: bool
        if PrimaryStartsWith(normType, "var"):
            shapeIsVarOrPtrType = true
        elif len(normType) > 0:
            if normType[len(normType) - 1] == '*':
                shapeIsVarOrPtrType = true
        if !shapeIsVarOrPtrType &&
           (texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, typeRaw) ||
            shapeAliasNorm == "enum" ||
            PrimaryStartsWith(shapeAliasNorm, "enum ")):
            typeKind = coreir.LocalI32Tag
            sizeBytes = 4
            alignBytes = 4
            return
        PrimaryBodyIrTypeShapeFromText(typedIr,
                                       sourcePath,
                                       shapeAliasTarget,
                                       typeKind,
                                       sizeBytes,
                                       alignBytes)
        return
    var fixedArraySize: int32
    var fixedArrayAlign: int32
    if PrimaryBodyIrFixedArrayShapeFromText(typedIr,
                                           sourcePath,
                                           normType,
                                           fixedArraySize,
                                           fixedArrayAlign):
        typeKind = coreir.LocalAggregateTag
        sizeBytes = fixedArraySize
        alignBytes = fixedArrayAlign
        return
    # Anonymous tuple literal `array<name:type,...>`:非 seq 形(用 <>),非命名类型 →
    # 布局注册表 miss,sizeBytes 留 0,破坏每个 seq-of-anon-tuple 元素形状门(bail_44)。
    # 解析字段列表按 C 对齐求和(同 Result[..] 规则)。
    if PrimaryStartsWith(normType, "array<") &&
       len(normType) > 7 &&
       normType[len(normType) - 1] == '>':
        var atFType = ""
        var atOff: int32
        var atSize: int32
        var atAlign: int32
        var atWholeSize: int32
        var atWholeAlign: int32
        if PrimaryBodyIrAnonTupleFieldMeta(typedIr, sourcePath, normType, "",
                                           atFType, atOff, atSize, atAlign,
                                           atWholeSize, atWholeAlign) &&
           atWholeSize > 0:
            typeKind = coreir.LocalAggregateTag
            sizeBytes = atWholeSize
            alignBytes = atWholeAlign
            if alignBytes <= 0:
                alignBytes = 8
            return
    if PrimaryStartsWith(normType, "seq[") ||
       (len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]"):
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 16
        alignBytes = 8
        return
    if PrimaryStartsWith(normType, "Result[") &&
       len(normType) > 8 &&
       strings.SliceBytes(normType, len(normType) - 1, 1) == "]":
        let innerType = strings.SliceBytes(normType, 7, len(normType) - 8)
        var valueKind: int32
        var valueSize: int32
        var valueAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr,
                                       sourcePath,
                                       innerType,
                                       valueKind,
                                       valueSize,
                                       valueAlign)
        if valueSize <= 0:
            return
        if valueAlign <= 0:
            return
        let valueOffset = PrimaryBodyIrAlignedOffset(1, valueAlign)
        let errOffset = PrimaryBodyIrAlignedOffset(valueOffset + valueSize, 8)
        var resultAlign = valueAlign
        if resultAlign < 8:
            resultAlign = 8
        typeKind = coreir.LocalAggregateTag
        sizeBytes = PrimaryBodyIrAlignedOffset(errOffset + 32, resultAlign)
        alignBytes = resultAlign
        return
    # Option[T] = { has: bool@0; value: T@align(1,alignT) } builtin generic.
    # Sizing is delegated to PrimaryBodyIrOptionShapeFromText (a small sibling
    # helper) so this already-large function's frame does not grow — the full
    # inline block here tips the self-baked driver into a codegen layout desync.
    # Byte-consistent with the front-end TypedExprTypeLayoutImpl Option handler so
    # a local `var opt: Option[Inner]` gets a right-sized aggregate slot instead
    # of the size-0 fallthrough (which mis-frames the slot -> SIGSEGV on store).
    if PrimaryBodyIrOptionShapeFromText(typedIr, sourcePath, normType,
                                        typeKind, sizeBytes, alignBytes):
        return
    let aliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                    sourcePath,
                                                                    typeRaw)
    if PrimaryBodyIrPointeeTypeText(aliasTarget) != "":
        typeKind = coreir.LocalPtrTag
        sizeBytes = 8
        alignBytes = 8
        return
    # ref-object types (`Name = ref`, e.g. atomic.I32) are 8-byte pointers.
    # Must precede the layout-registry lookup, which would otherwise inline
    # the ref's pointee struct and load the handle at the wrong width.
    if texpr.TypedExprIrTypeIsRef(typedIr, sourcePath, typeRaw):
        typeKind = coreir.LocalPtrTag
        sizeBytes = 8
        alignBytes = 8
        return
    # named struct types resolve through the typed-ir layout registry
    var layoutSizeBytes: int32
    var layoutAlignBytes: int32
    var layoutFieldCount: int32
    if texpr.TypedExprIrLookupTypeLayout(typedIr,
                                         sourcePath,
                                         normType,
                                         layoutSizeBytes,
                                         layoutAlignBytes,
                                         layoutFieldCount):
        if layoutSizeBytes > 0 && layoutFieldCount > 0:
            typeKind = coreir.LocalAggregateTag
            sizeBytes = layoutSizeBytes
            alignBytes = layoutAlignBytes
            if alignBytes <= 0:
                alignBytes = 8
            return
    # Enum types lower as int32-class scalars; everything else keeps the
    # legacy fallthrough (kind from text, size 0, align 8) that downstream
    # aggregate/let-call paths are tuned to.
    var isVarOrPtrType: bool
    if PrimaryStartsWith(normType, "var"):
        isVarOrPtrType = true
    elif len(normType) > 0:
        if normType[len(normType) - 1] == '*':
            isVarOrPtrType = true
    if !isVarOrPtrType && texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, typeRaw):
        typeKind = coreir.LocalI32Tag
        sizeBytes = 4
        alignBytes = 4
        return
    alignBytes = 8

@borrows
fn PrimaryBodyIrSeqElementShapeFromText(typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         seqTypeRaw: str,
                                         elemKind: var int32,
                                         elemSize: var int32): bool =
    elemKind = coreir.LocalInvalidTag
    elemSize = 0
    let normType = texpr.TypedExprNormalizeTypeText(seqTypeRaw)
    var innerType = ""
    if PrimaryStartsWith(normType, "seq[") &&
       len(normType) > 5 &&
       strings.SliceBytes(normType, len(normType) - 1, 1) == "]":
        innerType = strings.SliceBytes(normType, 4, len(normType) - 5)
    elif len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]":
        innerType = strings.SliceBytes(normType, 0, len(normType) - 2)
    elif len(normType) >= 4 &&
         strings.SliceBytes(normType, len(normType) - 1, 1) == "]" &&
         !PrimaryStartsWith(normType, "array[") &&
         !PrimaryStartsWith(normType, "Result["):
        let openPos = parser.ParserFindText(normType, "[")
        if openPos > 0:
            let countText = strings.SliceBytes(normType,
                                               openPos + 1,
                                               len(normType) - openPos - 2)
            if strutil.Strip(countText) != "":
                innerType = strings.SliceBytes(normType, 0, openPos)
    if innerType == "":
        return false
    var innerKind: int32
    var innerSize: int32
    var innerAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   innerType,
                                   innerKind,
                                   innerSize,
                                   innerAlign)
    if innerKind == coreir.LocalInvalidTag || innerSize <= 0:
        return false
    # bool values occupy 4-byte local slots, but growable sequence storage is
    # packed and follows elemSize[bool]() == 1. Fixed arrays widen explicitly
    # at their call sites; dynamic sequence consumers must keep this width.
    if texpr.TypedExprNormalizeTypeText(innerType) == "bool":
        innerSize = 1
    elemKind = innerKind
    elemSize = innerSize
    return true

@borrows
fn PrimaryBodyIrIndexedElementTypeText(typeRaw: str): str =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if PrimaryStartsWith(normType, "seq[") &&
       len(normType) > 5 &&
       strings.SliceBytes(normType, len(normType) - 1, 1) == "]":
        return strutil.Strip(strings.SliceBytes(normType, 4, len(normType) - 5))
    if len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]":
        return strutil.Strip(strings.SliceBytes(normType, 0, len(normType) - 2))
    if len(normType) >= 4 &&
       strings.SliceBytes(normType, len(normType) - 1, 1) == "]" &&
       !PrimaryStartsWith(normType, "array[") &&
       !PrimaryStartsWith(normType, "Result["):
        let openPos = parser.ParserFindText(normType, "[")
        if openPos > 0:
            let countText = strings.SliceBytes(normType,
                                               openPos + 1,
                                               len(normType) - openPos - 2)
            if strutil.Strip(countText) != "":
                return strutil.Strip(strings.SliceBytes(normType, 0, openPos))
    return ""

@borrows
fn PrimaryBodyIrTypeTextIsDynamicSeq(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if PrimaryStartsWith(normType, "seq["):
        return true
    if len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]":
        return true
    return false

@borrows
fn PrimaryBodyIrTypeTextIsVarI32(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if !PrimaryStartsWith(normType, "var"):
        return false
    let pointeeType = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    if normType == "varint32":
        return true
    if normType == "vari32":
        return true
    if normType == "varbool":
        return true
    if pointeeType == "int32":
        return true
    if pointeeType == "i32":
        return true
    if pointeeType == "bool":
        return true
    return false

@borrows
fn PrimaryBodyIrVarPointeeTypeKindFromText(typedIr: texpr.TypedExprIr,
                                            sourcePath: str,
                                            typeRaw: str): int32 =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    let pointeeType = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    if normType == "varint32":
        return coreir.LocalI32Tag
    if normType == "vari32":
        return coreir.LocalI32Tag
    if normType == "varbool":
        return coreir.LocalI32Tag
    if pointeeType == "int32":
        return coreir.LocalI32Tag
    if pointeeType == "i32":
        return coreir.LocalI32Tag
    if pointeeType == "bool":
        return coreir.LocalI32Tag
    if normType == "varint64":
        return coreir.LocalI64Tag
    if normType == "vari64":
        return coreir.LocalI64Tag
    if normType == "varuint64":
        return coreir.LocalI64Tag
    if normType == "varu64":
        return coreir.LocalI64Tag
    if pointeeType == "int64":
        return coreir.LocalI64Tag
    if pointeeType == "i64":
        return coreir.LocalI64Tag
    if pointeeType == "uint64":
        return coreir.LocalI64Tag
    if pointeeType == "u64":
        return coreir.LocalI64Tag
    if normType == "varfloat64":
        return coreir.LocalF64Tag
    if normType == "varf64":
        return coreir.LocalF64Tag
    if pointeeType == "float64":
        return coreir.LocalF64Tag
    if pointeeType == "f64":
        return coreir.LocalF64Tag
    if normType == "varstr":
        return coreir.LocalStrTag
    if pointeeType == "str":
        return coreir.LocalStrTag
    # `var <Enum>` 形参：枚举底层即 i32，指向 i32 槽。前置标量映射不识别
    # 具名枚举类型，遂经类型系统判定后归并入 i32 指针指代，使 var-enum
    # 形参的 `out = EnumConst` 经指针写回路径下降（此前静默落 cold）。
    if texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, typeRaw):
        return coreir.LocalI32Tag
    return coreir.LocalInvalidTag

@borrows
fn PrimaryBodyIrMarkVarPointeeKind(bodyIR: var coreir.BodyIR,
                                    typedIr: texpr.TypedExprIr,
                                    sourcePath: str,
                                    slotId: int32,
                                    typeRaw: str) =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return
    # pointee kind is only consulted for ptr slots (var params); writing it on
    # plain scalar slots collides with the packed bool ABI marker in auxValue
    if bodyIR.localSlots[slotId].typeKind == coreir.LocalAggregateTag:
        # var str 形参槽按源布局建成 Aggregate(24)：补 aux=Str 标记，
        # 使既有 Aggregate+aux=Str+param 地址间接协议可判别。
        let normVarType = texpr.TypedExprNormalizeTypeText(typeRaw)
        if PrimaryStartsWith(normVarType, "var") &&
           PrimaryBodyIrVarPointeeTypeKindFromText(typedIr, sourcePath, typeRaw) == coreir.LocalStrTag:
            bodyIR.localSlots[slotId].auxValue = coreir.LocalStrTag
        return
    if bodyIR.localSlots[slotId].typeKind != coreir.LocalPtrTag:
        return
    let pointeeKind = PrimaryBodyIrVarPointeeTypeKindFromText(typedIr, sourcePath, typeRaw)
    if pointeeKind != coreir.LocalInvalidTag:
        bodyIR.localSlots[slotId].auxValue = pointeeKind

@borrows
fn PrimaryBodyIrVarParamPointeeKind(bodyIR: coreir.BodyIR,
                                     slotId: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return coreir.LocalInvalidTag
    let slot = bodyIR.localSlots[slotId]
    if slot.typeKind != coreir.LocalPtrTag:
        return coreir.LocalInvalidTag
    if slot.auxValue == coreir.LocalI32Tag ||
       slot.auxValue == coreir.LocalI64Tag ||
       slot.auxValue == coreir.LocalF64Tag ||
       slot.auxValue == coreir.LocalStrTag:
        return slot.auxValue
    return coreir.LocalInvalidTag

@borrows
fn PrimaryBodyIrIntInList(values: int32[], value: int32): bool =
    for i in 0..<values.len:
        if values[i] == value:
            return true
    return false

@borrows
fn PrimaryBodyIrNameInList(names: str[], name: str): bool =
    for i in 0..<names.len:
        if names[i] == name:
            return true
    return false

@borrows
fn PrimaryBodyIrReturnTypeIsVoid(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "":
        return true
    if normType == "void":
        return true
    return false

@borrows
fn PrimaryBodyIrTypeTextIsSeqStr(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "str[]":
        return true
    if normType == "seq[str]":
        return true
    return false

@borrows
fn PrimaryBodyIrCallFullText(stmt: lower.PrimaryObjectIrStatement): str =
    if stmt.callArgCount > 0:
        return Fmt"{stmt.surfaceText}({stmt.callArgsText})"
    return Fmt"{stmt.surfaceText}()"

@borrows
fn PrimaryBodyIrHasSameLineCallForRhs(statements: var lower.PrimaryObjectIrStatement[],
                                       lineNumber: int32,
                                       rhsText: str): bool =
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtCall &&
           scanStmt.kind != texpr.TypedExprIrStmtLetCall &&
           scanStmt.kind != texpr.TypedExprIrStmtIfCall &&
           scanStmt.kind != texpr.TypedExprIrStmtResultIntrinsic:
            continue
        if os.GetEnv("CHENG_PRIMARY_OBJECT_CALL_SURFACE_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=same_line_call_for_rhs line={lineNumber} surface_kind={int32(scanStmt.callSurfaceKind)}")
        if strutil.Strip(scanStmt.surfaceText) == rhsText:
            return true
        if PrimaryBodyIrCallFullText(scanStmt) == rhsText:
            return true
    return false

@borrows
fn PrimaryBodyIrHasSameLineAssignForCallExpr(statements: var lower.PrimaryObjectIrStatement[],
                                              lineNumber: int32,
                                              callExprRaw: str): bool =
    let callExpr = strutil.Strip(callExprRaw)
    if callExpr == "":
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return false
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    let callTail = PrimaryCallTargetTailName(callHead)
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtAssign:
            continue
        if strutil.Contains(scanStmt.surfaceText, callExpr):
            return true
        if scanStmt.callTarget == callHead ||
           PrimaryCallTargetTailName(scanStmt.callTarget) == callTail:
            if strutil.Contains(scanStmt.surfaceText, callHead):
                return true
            if callTail != "" && strutil.Contains(scanStmt.surfaceText, callTail):
                return true
    return false

@borrows
fn PrimaryBodyIrHasSameLineAssignForCallTarget(statements: var lower.PrimaryObjectIrStatement[],
                                                lineNumber: int32,
                                                callTargetRaw: str,
                                                callArgsRaw: str): bool =
    let callTarget = strutil.Strip(callTargetRaw)
    if callTarget == "":
        return false
    let callTail = PrimaryCallTargetTailName(callTarget)
    let callArgs = strutil.Strip(callArgsRaw)
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtAssign:
            continue
        let scanTargetTail = PrimaryCallTargetTailName(scanStmt.callTarget)
        if scanStmt.callTarget != callTarget &&
           scanTargetTail != callTarget &&
           scanTargetTail != callTail:
            continue
        if callArgs != "" &&
           strutil.Strip(scanStmt.callArgsText) == callArgs:
            return true
        if strutil.Contains(scanStmt.surfaceText, callTarget):
            return true
        if callTail != "" && strutil.Contains(scanStmt.surfaceText, callTail):
            return true
    return false

@borrows
fn PrimaryBodyIrHasSameLineLetCallBinding(statements: var lower.PrimaryObjectIrStatement[],
                                           lineNumber: int32,
                                           bindingName: str): bool =
    if bindingName == "":
        return false
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtLetCall:
            continue
        if scanStmt.bindingName == bindingName:
            return true
    return false

@borrows
fn PrimaryBodyIrHasSameLineResultIntrinsicBinding(statements: var lower.PrimaryObjectIrStatement[],
                                                  lineNumber: int32,
                                                  bindingName: str): bool =
    if bindingName == "":
        return false
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtResultIntrinsic:
            continue
        if scanStmt.bindingName == bindingName:
            return true
    return false

@borrows
fn PrimaryBodyIrHasPreviousDuplicateWholeLetCall(statements: var lower.PrimaryObjectIrStatement[],
                                                 stmtIndex: int32): bool =
    if stmtIndex < 0 || stmtIndex >= statements.len:
        return false
    let stmt = statements[stmtIndex]
    if stmt.kind != texpr.TypedExprIrStmtLetCall:
        return false
    if stmt.bindingName == "" || stmt.callTarget == "":
        return false
    for scanIndex in 0..<statements.len:
        if scanIndex == stmtIndex:
            continue
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != stmt.lineNumber:
            continue
        if scanStmt.bindingName != stmt.bindingName:
            continue
        if scanStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
           scanStmt.kind == texpr.TypedExprIrStmtAssign:
            if !PrimaryBodyIrTextIsBareWholeCall(scanStmt.surfaceText):
                return false
    for scanIndex in 0..<stmtIndex:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != stmt.lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtLetCall:
            continue
        if scanStmt.bindingName == stmt.bindingName &&
           scanStmt.callTarget == stmt.callTarget &&
           scanStmt.callTargetSourcePath == stmt.callTargetSourcePath &&
           scanStmt.callTargetImportc == stmt.callTargetImportc &&
           scanStmt.callArgCount == stmt.callArgCount &&
           scanStmt.callArgsText == stmt.callArgsText &&
           scanStmt.surfaceText == stmt.surfaceText &&
           scanStmt.resultType == stmt.resultType:
            return true
    return false

@borrows
fn PrimaryBodyIrHasPreviousDuplicateWholeCall(statements: var lower.PrimaryObjectIrStatement[],
                                              stmtIndex: int32): bool =
    if stmtIndex < 0 || stmtIndex >= statements.len:
        return false
    let stmt = statements[stmtIndex]
    if stmt.kind != texpr.TypedExprIrStmtCall:
        return false
    if stmt.callTarget == "":
        return false
    for scanIndex in 0..<statements.len:
        if scanIndex == stmtIndex:
            continue
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != stmt.lineNumber:
            continue
        if scanStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
           scanStmt.kind == texpr.TypedExprIrStmtAssign:
            if !PrimaryBodyIrTextIsBareWholeCall(scanStmt.surfaceText):
                return false
    for scanIndex in 0..<stmtIndex:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != stmt.lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtCall:
            continue
        if scanStmt.callKind == stmt.callKind &&
           scanStmt.callCallee == stmt.callCallee &&
           scanStmt.callTarget == stmt.callTarget &&
           scanStmt.callTargetSourcePath == stmt.callTargetSourcePath &&
           scanStmt.callTargetImportc == stmt.callTargetImportc &&
           scanStmt.callArgCount == stmt.callArgCount &&
           scanStmt.callArgsText == stmt.callArgsText &&
           scanStmt.surfaceText == stmt.surfaceText &&
           scanStmt.resultType == stmt.resultType:
            return true
    return false

@borrows
fn PrimaryBodyIrVarI32ValueSlotName(name: str): str =
    return Fmt"{name}#var_i32_value"

@borrows
fn PrimaryBodyIrVarI64ValueSlotName(name: str): str =
    return Fmt"{name}#var_i64_value"

@borrows
fn PrimaryBodyIrFindOrCreateSlot(bodyIR: var coreir.BodyIR,
                                  slotNames: var str[],
                                  name: str,
                                  typeKind: int32): int32 =
    var slotFound: bool
    let slotHit = hashmaps.HashMapStrIntGetMutEx(bodyIR.slotNameIndex, name, slotFound)
    if slotFound && slotHit >= 0 && slotHit < slotNames.len && slotNames[slotHit] == name:
        let i = slotHit
        if i < bodyIR.localSlots.len:
            var slot = bodyIR.localSlots[i]
            let desiredSize = PrimaryBodyIrNormalizeSlotSizeBytes(typeKind, 0)
            let desiredAlign = PrimaryBodyIrNormalizeSlotAlignBytes(typeKind, 0)
            var changed = false
            if desiredSize > 0 && PrimaryLocalSlotSizeOf(slot) < desiredSize:
                slot.sizeBytes = desiredSize
                changed = true
            if desiredAlign > 0 && slot.alignBytes < desiredAlign:
                slot.alignBytes = desiredAlign
                changed = true
            if slot.typeKind != typeKind &&
               (slot.typeKind == coreir.LocalI32Tag ||
                slot.typeKind == coreir.LocalAggregateTag ||
                typeKind == coreir.LocalAggregateTag):
                slot.typeKind = typeKind
                changed = true
            if changed:
                bodyIR.localSlots[i] = slot
        return i
    let newSlot = slotNames.len
    add(slotNames, share(name))
    PrimaryBodyIrLocalSlotNew(bodyIR, newSlot, name, typeKind)
    hashmaps.HashMapStrIntPut(bodyIR.slotNameIndex, strings.CloneStr(name), newSlot)
    return newSlot

@borrows
fn PrimaryBodyIrFindOrCreateSlotSized(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       name: str,
                                       typeKind: int32,
                                       sizeBytes: int32,
                                       alignBytes: int32): int32 =
    let desiredSize = PrimaryBodyIrNormalizeSlotSizeBytes(typeKind, sizeBytes)
    let desiredAlign = PrimaryBodyIrNormalizeSlotAlignBytes(typeKind, alignBytes)
    var slotFound: bool
    let slotHit = hashmaps.HashMapStrIntGetMutEx(bodyIR.slotNameIndex, name, slotFound)
    if slotFound && slotHit >= 0 && slotHit < slotNames.len && slotNames[slotHit] == name:
        let i = slotHit
        if i < bodyIR.localSlots.len:
            var slot = bodyIR.localSlots[i]
            let currentSize = PrimaryLocalSlotSizeOf(slot)
            var changed = false
            if desiredSize > 0 && currentSize < desiredSize:
                slot.sizeBytes = desiredSize
                changed = true
            if desiredAlign > 0 && slot.alignBytes < desiredAlign:
                slot.alignBytes = desiredAlign
                changed = true
            if slot.typeKind != typeKind &&
               (slot.typeKind == coreir.LocalI32Tag ||
                slot.typeKind == coreir.LocalAggregateTag ||
                typeKind == coreir.LocalAggregateTag):
                slot.typeKind = typeKind
                changed = true
            if changed:
                bodyIR.localSlots[i] = slot
        return i
    let newSlot = slotNames.len
    add(slotNames, share(name))
    PrimaryBodyIrLocalSlotNewSized(bodyIR, newSlot, name, typeKind, desiredSize, desiredAlign)
    hashmaps.HashMapStrIntPut(bodyIR.slotNameIndex, strings.CloneStr(name), newSlot)
    return newSlot

@borrows
fn PrimaryBodyIrTypedSlotShape(typedIr: texpr.TypedExprIr,
                                sourcePath: str,
                                typeRaw: str,
                                typeKindOut: var int32,
                                sizeBytesOut: var int32,
                                alignBytesOut: var int32) =
    var typeKind: int32
    var sizeBytes: int32
    var alignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, typeRaw, typeKind, sizeBytes, alignBytes)
    var needsSourceLayout: bool
    if sourcePath != "":
        if sizeBytes <= 0:
            needsSourceLayout = true
        elif alignBytes <= 0:
            needsSourceLayout = true
    if needsSourceLayout:
        var sourceSizeBytes: int32
        var sourceAlignBytes: int32
        if PrimaryBodyIrCanonicalTypeLayout(typedIr,
                                                  sourcePath,
                                                  "",
                                                  typeRaw,
                                                  0,
                                                  sourceSizeBytes,
                                                  sourceAlignBytes):
            typeKind = coreir.LocalAggregateTag
            sizeBytes = sourceSizeBytes
            alignBytes = sourceAlignBytes
    typeKindOut = typeKind
    sizeBytesOut = sizeBytes
    alignBytesOut = alignBytes

@borrows
fn PrimaryBodyIrFindOrCreateTypedSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       name: str,
                                       typeRaw: str): int32 =
    var typeKind: int32
    var sizeBytes: int32
    var alignBytes: int32
    PrimaryBodyIrTypedSlotShape(typedIr, sourcePath, typeRaw, typeKind, sizeBytes, alignBytes)
    return PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                              slotNames,
                                              name,
                                              typeKind,
                                              sizeBytes,
                                              alignBytes)

@borrows
fn PrimaryBodyIrBindLocalSlotValueDefinitionExact(
        bodyIR: var coreir.BodyIR,
        bindingProjection:
            var coreir.BodyIRLocalBindingValueDefinitionProjection,
        typedIr: texpr.TypedExprIr,
        slotId: int32,
        definitionRow: int32,
        expectedOrigin: texpr.TypedExprValueDefinitionOriginKind) =
    if slotId < 0 || slotId >= bodyIR.localSlots.len ||
       definitionRow < 0 ||
       definitionRow >=
           texpr.TypedExprValueDefinitionAuthorityCount(typedIr) ||
       texpr.TypedExprValueDefinitionOriginKindAt(
           typedIr, definitionRow) != expectedOrigin:
        panic("backend2 body ir local binding: value-definition row invalid")
    let definingNodeIndex =
        texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
            typedIr, definitionRow)
    if definingNodeIndex < 0 ||
       definingNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        panic("backend2 body ir local binding: defining node invalid")
    let exactTypeId =
        texpr.TypedExprValueDefinitionExactTypeIdAt(
            typedIr, definitionRow)
    if exactTypeId < 0 ||
       exactTypeId !=
           texpr.TypedExprIrNodeStructuralTypeIdAt(
               typedIr, definingNodeIndex) ||
       exactTypeId != arenamod.ArenaArrayInt32Get(
           typedIr.arena,
           typedIr.nodes2_exactTypeArenaIds,
           definingNodeIndex) ||
       !typedIr.valueDefinitionTypeArenaBound ||
       !typedIr.nodeAuthorityTypeArenaBound ||
       !layout.FixedBytes32Equal(
           typedIr.valueDefinitionTypeArenaArtifactCid,
           typedIr.nodeAuthorityTypeArenaArtifactCid):
        panic("backend2 body ir local binding: immutable TypeId proof missing")
    let managedStorageKind =
        typedIr.nodes2_resultTypeManagedFlags[definingNodeIndex] ?
            coreir.BodyManagedStorageManagedTag :
            coreir.BodyManagedStorageUnmanagedTag
    coreir.BodyIRBindLocalBindingValueDefinitionRow(
        bodyIR, bindingProjection, slotId, definitionRow)
    if !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           slotId,
           typedIr.nodeAuthorityTypeArenaArtifactCid,
           exactTypeId,
           managedStorageKind):
        panic("backend2 body ir local binding: slot TypeId bind failed")

@borrows
fn PrimaryBodyIrBindLocalSlotFromTypedProducerExact(
        bodyIR: var coreir.BodyIR,
        bindingProjection:
            var coreir.BodyIRLocalBindingValueDefinitionProjection,
        typedIr: texpr.TypedExprIr,
        slotId: int32,
        producerNodeIndex: int32) =
    if producerNodeIndex < 0 ||
       producerNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        panic("backend2 body ir local binding: producer node invalid")
    let definitionRow =
        texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
            typedIr, producerNodeIndex)
    if definitionRow < 0 ||
       definitionRow >=
           texpr.TypedExprValueDefinitionAuthorityCount(typedIr) ||
       texpr.TypedExprValueDefinitionOriginKindAt(
           typedIr, definitionRow) !=
           texpr.TypedExprValueDefinitionOriginBindingInitializer ||
       texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
           typedIr, definitionRow) != producerNodeIndex:
        panic("backend2 body ir local binding: immutable producer proof missing")
    PrimaryBodyIrBindLocalSlotValueDefinitionExact(
        bodyIR,
        bindingProjection,
        typedIr,
        slotId,
        definitionRow,
        texpr.TypedExprValueDefinitionOriginBindingInitializer)

# Scope-aware rebind shadowing for a `let`/`var` local declaration. node-eval slots
# are keyed by binding name only (no lexical scope) and grow monotonically, so a
# same-name re-declaration in a DIFFERENT lexical block whose new aggregate size
# differs from the existing slot is forced to share one over-grown slot — the
# store of the smaller value into the larger slot is an honest shape mismatch
# (store_shape_agg_l<big>_v<small>). Because statement lowering is strictly
# single-pass in source order and emitted ops reference slots by integer index,
# the prior scope's reads are already lowered against the existing slot index
# before this re-declaration is reached. Renaming that existing slot to a dead
# synthetic name here lets the new declaration allocate a fresh slot under the
# original binding name, so every subsequent read of the name (this new scope)
# resolves to the new slot via FindSlotIndex first-match — precise read-side
# shadowing without touching the hot name resolver. Strictly scoped to the
# incompatible aggregate-size rebind: compatible same-name reuse is untouched.
@borrows
fn PrimaryBodyIrRetireIncompatibleAggregateRebind(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   typedIr: texpr.TypedExprIr,
                                                   sourcePath: str,
                                                   name: str,
                                                   typeRaw: str) =
    var newKind: int32
    var newSize: int32
    var newAlign: int32
    PrimaryBodyIrTypedSlotShape(typedIr, sourcePath, typeRaw, newKind, newSize, newAlign)
    if newKind != coreir.LocalAggregateTag || newSize <= 0:
        return
    for i in 0..<slotNames.len:
        if slotNames[i] != name:
            continue
        if i >= bodyIR.localSlots.len:
            return
        var existing = bodyIR.localSlots[i]
        if existing.typeKind != coreir.LocalAggregateTag:
            return
        if PrimaryBodyIrLocalIsParam(existing):
            return
        let existingSize = PrimaryLocalSlotSizeOf(existing)
        if existingSize <= 0 || existingSize == newSize:
            return
        let deadName = Fmt"{name}#shadowed{i}#{bodyIR.ops.len}"
        slotNames[i] = strings.CloneStr(deadName)
        existing.name = deadName
        bodyIR.localSlots[i] = existing
        return

@borrows
fn PrimaryBodyIrFindSlotIndex(bodyIR: var coreir.BodyIR, slotNamesRaw: var str[], name: str): int32 =
    if len(name) < 0:
        add(slotNamesRaw, share(name))
    var idxFound: bool
    let idxHit = hashmaps.HashMapStrIntGetMutEx(bodyIR.slotNameIndex, name, idxFound)
    if idxFound && idxHit >= 0 && idxHit < slotNamesRaw.len && slotNamesRaw[idxHit] == name:
        return idxHit
    return -1

@borrows
fn PrimaryBodyIrVisibleGlobalRow(typedIr: texpr.TypedExprIr,
                                  sourcePathRaw: str,
                                  nameRaw: str,
                                  definingSourcePathOut: var str): int32 =
    definingSourcePathOut = ""
    let nameText = chengpath.PathTrim(nameRaw)
    let name = parser.ParserIdentPrefix(nameText)
    if name == "" || name != nameText:
        return -1
    var rowIndex: int32
    let state = texpr.TypedExprIrVisibleSourceRowState(
        typedIr,
        "ir_global_source",
        sourcePathRaw,
        name,
        "",
        rowIndex,
        definingSourcePathOut)
    if state == texpr.TypedExprBuildIndexAmbiguous:
        panic(Fmt"backend2: ambiguous visible global source={sourcePathRaw} name={name}")
    if state != texpr.TypedExprBuildIndexUnique:
        definingSourcePathOut = ""
        return -1
    if rowIndex < 0 || rowIndex >= typedIr.globalNames.len ||
       rowIndex >= typedIr.globalSourcePaths.len ||
       rowIndex >= typedIr.globalTypes.len ||
       rowIndex >= typedIr.globalProducerSourceIndexes.len ||
       rowIndex >= typedIr.globalDeclarationSourceLocalRows.len ||
       typedIr.globalNames[rowIndex] != name ||
       typedIr.globalProducerSourceIndexes[rowIndex] < 0 ||
       typedIr.globalDeclarationSourceLocalRows[rowIndex] < 0 ||
       !PrimaryPathNormalizedEquals(typedIr.globalSourcePaths[rowIndex],
                                    definingSourcePathOut):
        panic("backend2: visible global index payload mismatch")
    return rowIndex


@borrows
fn PrimaryBodyIrExactGlobalRow(typedIr: texpr.TypedExprIr,
                                sourcePathRaw: str,
                                nameRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let nameText = chengpath.PathTrim(nameRaw)
    let name = parser.ParserIdentPrefix(nameText)
    if sourcePath == "" || name == "" || name != nameText:
        return -1
    var rowIndex: int32
    let state = texpr.TypedExprIrExactGlobalRowState(typedIr,
                                                     sourcePath,
                                                     name,
                                                     rowIndex)
    if state == texpr.TypedExprBuildIndexAmbiguous:
        panic(Fmt"backend2: ambiguous exact global source={sourcePath} name={name}")
    if state != texpr.TypedExprBuildIndexUnique:
        return -1
    if rowIndex < 0 || rowIndex >= typedIr.globalNames.len ||
       rowIndex >= typedIr.globalSourcePaths.len ||
       rowIndex >= typedIr.globalTypes.len ||
       rowIndex >= typedIr.globalProducerSourceIndexes.len ||
       rowIndex >= typedIr.globalDeclarationSourceLocalRows.len ||
       typedIr.globalNames[rowIndex] != name ||
       typedIr.globalProducerSourceIndexes[rowIndex] < 0 ||
       typedIr.globalDeclarationSourceLocalRows[rowIndex] < 0 ||
       !PrimaryPathNormalizedEquals(typedIr.globalSourcePaths[rowIndex],
                                    sourcePath):
        panic("backend2: exact global index payload mismatch")
    return rowIndex


@borrows
fn PrimaryBodyIrTypedGlobalType(typedIr: texpr.TypedExprIr,
                                 sourcePath: str,
                                 name: str): str =
    var definingSourcePath = ""
    let rowIndex = PrimaryBodyIrVisibleGlobalRow(typedIr,
                                                 sourcePath,
                                                 name,
                                                 definingSourcePath)
    if rowIndex < 0:
        return ""
    return strings.CloneStr(typedIr.globalTypes[rowIndex])

@borrows
fn PrimaryBodyIrTypedGlobalSlotName(typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     name: str): str =
    var definingSourcePath = ""
    let rowIndex = PrimaryBodyIrVisibleGlobalRow(typedIr,
                                                 sourcePath,
                                                 name,
                                                 definingSourcePath)
    if rowIndex < 0:
        return ""
    return Fmt"{definingSourcePath}::{typedIr.globalNames[rowIndex]}"

@borrows
fn PrimaryBodyIrTypedGlobalTypeExact(typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      name: str): str =
    let rowIndex = PrimaryBodyIrExactGlobalRow(typedIr, sourcePath, name)
    if rowIndex >= 0:
        return strings.CloneStr(typedIr.globalTypes[rowIndex])
    return ""

@borrows
fn PrimaryBodyIrTypedGlobalSlotNameExact(typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          name: str): str =
    let rowIndex = PrimaryBodyIrExactGlobalRow(typedIr, sourcePath, name)
    if rowIndex >= 0:
        return Fmt"{typedIr.globalSourcePaths[rowIndex]}::{typedIr.globalNames[rowIndex]}"
    return ""

# canonical visibility 索引返回模块全局的真实定义源路径；二义直接 fail。
@borrows
fn PrimaryBodyIrTypedGlobalSourcePath(typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       name: str): str =
    var definingSourcePath = ""
    let rowIndex = PrimaryBodyIrVisibleGlobalRow(typedIr,
                                                 sourcePath,
                                                 name,
                                                 definingSourcePath)
    if rowIndex < 0:
        return ""
    return definingSourcePath

@borrows
fn PrimaryBodyIrCanonicalArgName(argRaw: str): str =
    let arg = strutil.Strip(argRaw)
    var openPos: int32 = -1
    for i in 0..<len(arg):
        if arg[i] == '(':
            openPos = i
            break
    if openPos <= 0:
        return arg
    var tailStart: int32
    for i in 0..<openPos:
        if arg[i] == '.':
            tailStart = i + 1
    if tailStart <= 0:
        return arg
    return strings.SliceBytes(arg, tailStart, len(arg) - tailStart)

@borrows
fn PrimaryBodyIrFindArgSlot(bodyIR: var coreir.BodyIR, slotNames: var str[], argName: str): int32 =
    let exact = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, argName)
    if exact >= 0:
        return exact
    let canonical = PrimaryBodyIrCanonicalArgName(argName)
    if canonical != argName:
        return PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, canonical)
    return -1

@borrows
fn PrimaryBodyIrNodeTypeShape(typedIr: texpr.TypedExprIr,
                              sourcePath: str,
                              typeRaw: str,
                              kindOut: var int32,
                              sizeOut: var int32,
                              alignOut: var int32) =
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, typeRaw, kindOut, sizeOut, alignOut)
    var needsSourceLayout: bool
    if sourcePath != "":
        if sizeOut <= 0:
            needsSourceLayout = true
        elif alignOut <= 0:
            needsSourceLayout = true
    if needsSourceLayout:
        var sourceSize: int32
        var sourceAlign: int32
        if PrimaryBodyIrCanonicalTypeLayout(typedIr,
                                                  sourcePath,
                                                  "",
                                                  typeRaw,
                                                  0,
                                                  sourceSize,
                                                  sourceAlign):
            kindOut = coreir.LocalAggregateTag
            sizeOut = sourceSize
            alignOut = sourceAlign

@borrows
fn PrimaryBodyIrNodeValueTypeShape(typedIr: texpr.TypedExprIr,
                                   nodeIndex: int32,
                                   kindOut: var int32,
                                   sizeOut: var int32,
                                   alignOut: var int32) =
    let nvsSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[nodeIndex])
    let nvsTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[nodeIndex])
    # form59: hoist Value(Result[str]) before StripVarType — nested Value-as-call-arg
    # is miscompiled by gen1 as 32-bit ldr (should pass struct address).
    let nvsSrc: str = Value(nvsSrcRes)
    let nvsType: str = Value(nvsTypeRes)
    let nvsTypeStripped: str = texpr.TypedExprStripVarType(nvsType)
    PrimaryBodyIrNodeTypeShape(typedIr,
                               nvsSrc,
                               nvsTypeStripped,
                               kindOut,
                               sizeOut,
                               alignOut)

@borrows
fn PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       nameRaw: str): int32 =
    let name = strutil.Strip(nameRaw)
    if sourcePath == "" || name == "":
        return -1
    if PrimaryBodyIrTextHasFieldOrIndex(name):
        return -1
    let globalType = PrimaryBodyIrTypedGlobalTypeExact(typedIr, sourcePath, name)
    if globalType == "":
        return -1
    var globalKind: int32
    var globalSize: int32
    var globalAlign: int32
    PrimaryBodyIrNodeTypeShape(typedIr,
                               sourcePath,
                               globalType,
                               globalKind,
                               globalSize,
                               globalAlign)
    if globalKind != coreir.LocalI32Tag &&
       globalKind != coreir.LocalI64Tag &&
       globalKind != coreir.LocalPtrTag &&
       globalKind != coreir.LocalStrTag &&
       globalKind != coreir.LocalAggregateTag:
        return -1
    if globalKind == coreir.LocalAggregateTag:
        # 聚合/seq 全局头内联在数据标号；按标量值加载得 size 0（无标量 GlobalLoad
        # 分支）会截断函数体。物化其地址到 Ptr 槽，下游 FieldLoad/IndexGet 经指针读头。
        return PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                 slotNames,
                                                 typedIr,
                                                 sourcePath,
                                                 name)
    let globalSlotName = PrimaryBodyIrTypedGlobalSlotNameExact(typedIr, sourcePath, name)
    if globalSlotName == "":
        return -1
    let globalSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                        slotNames,
                                                        globalSlotName,
                                                        globalKind,
                                                        globalSize,
                                                        globalAlign)
    if globalSlot < 0 || globalSlot >= bodyIR.localSlots.len:
        return -1
    bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    let valueSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                       slotNames,
                                                       Fmt"{globalSlotName}#global_value",
                                                       globalKind,
                                                       globalSize,
                                                       globalAlign)
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return -1
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpGlobalLoadTag
    op.target = valueSlot
    add(op.operands, globalSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return valueSlot

@borrows
fn PrimaryBodyIrValueArgSlotForCall(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     argName: str,
                                     slotId: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return -1
    if bodyIR.localSlots[slotId].placeKind != coreir.BodyPlaceGlobalAddressTag:
        return slotId
    return PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                               slotNames,
                                               typedIr,
                                               sourcePath,
                                               argName)

@borrows
fn PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           typedIr: texpr.TypedExprIr,
                                           sourcePath: str,
                                           rootName: str,
                                           rootTypeRaw: str): int32 =
    if rootTypeRaw != "" && !B2PrimaryObjectMetadataTextStable(rootTypeRaw):
        return -1
    let rootType = texpr.TypedExprNormalizeTypeText(rootTypeRaw)
    if rootName == "":
        return -1
    # A multi-part field-arg chain (e.g. `buf.storage.data`) materializes each
    # intermediate value into a synthetic slot named `<prefix>#field_arg`. When
    # the next part loads off that slot, rootName carries the synthetic name
    # (which contains a '.'), so the field/index bail below would reject it.
    # The intermediate value already lives in an exact-named slot; address the
    # next field-load off it directly.
    let existingChainSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, rootName)
    if existingChainSlot >= 0 &&
       (PrimaryBodyIrSlotType(bodyIR, existingChainSlot) == coreir.LocalAggregateTag ||
        PrimaryBodyIrSlotType(bodyIR, existingChainSlot) == coreir.LocalPtrTag):
        return existingChainSlot
    # A same-named SCALAR slot is NOT a valid field/index base. Module-global seq
    # element by value (`loweringParallelResults[i]`, PrimaryObjectIrFunction[]): an
    # earlier scalar resolver mis-materializes a bare-name `loweringParallelResults`
    # I32 shadow slot (the global's correct slot is the SOURCE-PATH-QUALIFIED
    # `<path>::loweringParallelResults` aggregate). The original unconditional
    # existingChainSlot return picked up that I32 shadow → the indexed-member
    # field-base kind check rejected (Aggregate/Ptr only) → the address walk bailed
    # before the seq header / element-address arithmetic → bail_44 → BodyOpInvalidTag
    # → word_count=0 → not_ready. Only short-circuit to a pre-existing slot when it is
    # an aggregate/ptr (a real field/index base); a scalar shadow falls through to the
    # module-global GlobalSeqAddressSlot path (adrp+add real symbol) below, or to
    # FindOrCreateTypedSlot (which upgrades the slot kind for a genuine local aggregate).
    if rootType == "" || PrimaryStartsWith(rootType, "var"):
        let varArgSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootName)
        if varArgSlot >= 0:
            return varArgSlot
        # var param aggregate (var bigint.BigInt) not in slotNames via FindArgSlot —
        # the param slot may use a different naming. Fall back to FindOrCreateTypedSlot
        # with the var-stripped type, creating an aggregate slot enabling field/index
        # addressing for a.limbs[idx] as call-arg (bail=44 fix 2026-06-30).
        let varStrippedType = texpr.TypedExprStripVarType(rootTypeRaw)
        if varStrippedType != "" && B2PrimaryObjectMetadataTextStable(varStrippedType):
            let typedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       sourcePath,
                                                       rootName,
                                                       varStrippedType)
            if typedSlot >= 0:
                return typedSlot
            # Cross-module type (bigint.BigInt registered under bigint.cheng sourcePath,
            # not the caller's rsa.cheng). Retry with empty sourcePath for global lookup.
            return PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       "",
                                                       rootName,
                                                       varStrippedType)
        return -1
    # A GLOBAL aggregate's fields must be addressed off the global symbol
    # (adrp+add), not a fresh stack slot. Without this `gAcc.total` reads/writes
    # land on a frame-local copy (stack garbage init, writeback invisible to
    # other calls). Materialize the global's address into a Ptr slot; the
    # FieldLoad/FieldStore emitters already address fields through a Ptr base.
    if PrimaryBodyIrTextHasFieldOrIndex(rootName):
        return -1
    if PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootName) < 0:
        var globalType = PrimaryBodyIrTypedGlobalTypeExact(typedIr, sourcePath, rootName)
        if globalType == "":
            # Same root as c857: a module-global whose registration sourcePath does
            # NOT PrimaryPathNormalizedEquals the caller's sourcePath (the reason c857
            # had to drop to the non-exact TypedGlobalType for the root-type step).
            # The exact lookup returns "" here, so without this the aggregate global
            # falls through to a fresh STACK slot below (stack garbage, writeback
            # invisible). Fall back to the non-exact global type (nonExactCount%2==1
            # uniqueness, identical to c857) so the aggregate global routes through
            # GlobalSeqAddressSlot (adrp+add real symbol). Still gated to bare-name
            # aggregate globals (field/index roots already rejected above; plain
            # scalar globals fail the LocalAggregateTag check and never enter).
            globalType = PrimaryBodyIrTypedGlobalType(typedIr, sourcePath, rootName)
        if globalType != "":
            var globalTypeKind: int32
            var globalSizeBytes: int32
            var globalAlignBytes: int32
            PrimaryBodyIrTypeShapeFromText(typedIr,
                                           sourcePath,
                                           globalType,
                                           globalTypeKind,
                                           globalSizeBytes,
                                           globalAlignBytes)
            if globalTypeKind != coreir.LocalAggregateTag:
                # type-shape may be 0 under the caller sourcePath when the type is
                # registered in the global's declaring module; re-resolve under the
                # global's true registration sourcePath before giving up.
                let baseGlobalSource = PrimaryBodyIrTypedGlobalSourcePath(typedIr,
                                                                          sourcePath,
                                                                          rootName)
                if baseGlobalSource != "" && baseGlobalSource != sourcePath:
                    PrimaryBodyIrTypeShapeFromText(typedIr,
                                                   baseGlobalSource,
                                                   globalType,
                                                   globalTypeKind,
                                                   globalSizeBytes,
                                                   globalAlignBytes)
            if globalTypeKind == coreir.LocalAggregateTag:
                let globalAddrSlot = PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                                       slotNames,
                                                                       typedIr,
                                                                       sourcePath,
                                                                       rootName)
                if globalAddrSlot >= 0:
                    return globalAddrSlot
    return PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                              slotNames,
                                              typedIr,
                                              sourcePath,
                                              rootName,
                                              rootType)

@borrows
fn PrimaryBodyIrAppendFieldLoadToSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       rootName: str,
                                       rootTypeRaw: str,
                                       fieldOffsetBytes: int32,
                                       fieldSizeBytes: int32,
                                       targetSlot: int32): bool =
    if rootName == "" ||
       targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len:
        return false
    let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                          slotNames,
                                                          typedIr,
                                                          sourcePath,
                                                          rootName,
                                                          rootTypeRaw)
    var primaryColdCond2: bool
    if baseSlot < 0:
        primaryColdCond2 = true
    if fieldOffsetBytes < 0:
        primaryColdCond2 = true
    if fieldSizeBytes <= 0:
        primaryColdCond2 = true
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < fieldSizeBytes:
        primaryColdCond2 = true
    if primaryColdCond2:
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpFieldLoadTag
    op.target = targetSlot
    add(op.operands, baseSlot)
    add(op.operands, targetSlot)
    add(op.operands, fieldOffsetBytes)
    add(op.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return true

@borrows
fn PrimaryBodyIrShiftRightLhsIsUnsignedCast(lhsTextRaw: str): bool =
    let lhsText = strutil.Strip(lhsTextRaw)
    if PrimaryBodyIrWholeCallInnerForHead(lhsText, "uint64") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "u64") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "UInt64") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "uint32") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "u32") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "UInt32") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "uint16") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "uint8") != "":
        return true
    return false

@borrows
fn PrimaryBodyIrTypeTextIsUnsignedInt(typeTextRaw: str): bool =
    let typeText = texpr.TypedExprNormalizeTypeText(typeTextRaw)
    return typeText == "uint64" || typeText == "u64" ||
           typeText == "uint32" || typeText == "u32" ||
           typeText == "uint16" || typeText == "uint8"

# Publish the function currently being lowered so the context-less base scalar
# slot builder can resolve `>>` LHS signedness (params + locals).
@borrows
fn PrimaryBodyIrSetCurrentShiftContext(typedFn: texpr.TypedExprIrFunction,
                                        irFunction: lower.PrimaryObjectIrFunction) =
    primaryBodyIrCurrentShiftCtxValid = true
    primaryBodyIrCurrentShiftCtxSourcePath = typedFn.sourcePath
    primaryBodyIrCurrentShiftCtxFunctionName = typedFn.functionName
    primaryBodyIrCurrentShiftCtxEndLine = typedFn.endLineNumber
    primaryBodyIrCurrentShiftCtxParamNames = irFunction.paramNames
    primaryBodyIrCurrentShiftCtxParamTypes = irFunction.paramTypes

# Resolve whether the `>>` LHS (a bare param or local name) is unsigned using the
# published current-function context. Mirrors PrimaryBodyIrShiftRightOpKind's
# type sources but without needing the typedFn/irFunction passed in.
@borrows
fn PrimaryBodyIrCurrentShiftLhsIsUnsigned(typedIr: texpr.TypedExprIr,
                                           lhsTextRaw: str): bool =
    if !primaryBodyIrCurrentShiftCtxValid:
        return false
    let lhsText = strutil.Strip(lhsTextRaw)
    if lhsText == "":
        return false
    for i in 0..<primaryBodyIrCurrentShiftCtxParamNames.len:
        if i >= primaryBodyIrCurrentShiftCtxParamTypes.len:
            break
        if primaryBodyIrCurrentShiftCtxParamNames[i] == lhsText:
            return PrimaryBodyIrTypeTextIsUnsignedInt(primaryBodyIrCurrentShiftCtxParamTypes[i])
    let localType = texpr.TypedExprIrLookupLocalBindingType(typedIr,
                                                            primaryBodyIrCurrentShiftCtxSourcePath,
                                                            primaryBodyIrCurrentShiftCtxFunctionName,
                                                            primaryBodyIrCurrentShiftCtxEndLine,
                                                            lhsText)
    if localType != "":
        return PrimaryBodyIrTypeTextIsUnsignedInt(localType)
    return false

@borrows
fn PrimaryBodyIrShiftRightOpKind(typedIr: texpr.TypedExprIr,
                                  typedFn: texpr.TypedExprIrFunction,
                                  irFunction: lower.PrimaryObjectIrFunction,
                                  lineNumber: int32,
                                  lhsTextRaw: str): int32 =
    # uint 左操作数的 >> 必须发逻辑右移；查不到类型则维持算术右移（现状不变）。
    let lhsText = strutil.Strip(lhsTextRaw)
    if PrimaryBodyIrShiftRightLhsIsUnsignedCast(lhsText):
        return int32(texpr.TypedExprIrOpI32Lsr)
    let lhsTypeText = texpr.TypedExprNormalizeTypeText(
        PrimaryBodyIrBindingTypeForName(typedIr, typedFn, irFunction, lineNumber, lhsText))
    if lhsTypeText == "uint64" || lhsTypeText == "u64" ||
       lhsTypeText == "uint32" || lhsTypeText == "u32" ||
       lhsTypeText == "uint16" || lhsTypeText == "uint8":
        return int32(texpr.TypedExprIrOpI32Lsr)
    return int32(texpr.TypedExprIrOpI32Asr)

var primaryBindingTierProbeTotal: int64
var primaryBindingTierProbeParam: int64
var primaryBindingTierProbeLocalHash: int64
var primaryBindingTierProbeTypedScan: int64
var primaryBindingTierProbeReparse: int64
var primaryBindingTierProbeIrScan: int64
var primaryBindingTierProbeMiss: int64

@borrows
fn PrimaryBodyIrRangeNodeBelongsToStatement(typedIr: texpr.TypedExprIr,
                                             typedFn: texpr.TypedExprIrFunction,
                                             irFunction: lower.PrimaryObjectIrFunction,
                                             stmt: lower.PrimaryObjectIrStatement,
                                             nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       nodeIndex >= typedIr.nodes2_lineNumbers.len ||
       nodeIndex >= typedIr.nodes2_opKinds.len ||
       nodeIndex >= typedIr.nodes2_sourcePathIds.len ||
       nodeIndex >= typedIr.nodes2_functionNameIds.len ||
       nodeIndex >= typedIr.nodes2_resultTypeIds.len ||
       nodeIndex >= typedIr.nodes2_paramNameIds.len ||
       nodeIndex >= typedIr.nodes2_literalTextIds.len:
        return false
    if arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_nodeIndexs,
                                    nodeIndex) != nodeIndex ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_lineNumbers,
                                    nodeIndex) != stmt.lineNumber:
        return false
    let sourceRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.nodes2_sourcePathIds[nodeIndex])
    let functionRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.nodes2_functionNameIds[nodeIndex])
    let resultTypeRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.nodes2_resultTypeIds[nodeIndex])
    if !IsOk(sourceRes) || !IsOk(functionRes) || !IsOk(resultTypeRes):
        return false
    let nodeResultType = Value(resultTypeRes)
    if parser.ParserNormalizePath(Value(sourceRes)) !=
           parser.ParserNormalizePath(stmt.sourcePath) ||
       Value(functionRes) != stmt.functionName ||
       Value(functionRes) != typedFn.functionName || nodeResultType == "":
        return false
    let opKind = typedIr.nodes2_opKinds[nodeIndex]
    if opKind == texpr.TypedExprIrOpLocalRef ||
       opKind == texpr.TypedExprIrOpParamRef:
        let bindingNameRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.nodes2_paramNameIds[nodeIndex])
        if !IsOk(bindingNameRes) || Value(bindingNameRes) == "":
            return false
        let bindingType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                           typedFn,
                                                           irFunction,
                                                           stmt.lineNumber,
                                                           Value(bindingNameRes))
        if bindingType == "" ||
           texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(bindingType)) !=
               texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(nodeResultType)):
            return false
    return texpr.TypedExprNormalizeTypeText(nodeResultType) == "int32"

@borrows
fn PrimaryBodyIrForBindingElementType(typedIr: texpr.TypedExprIr,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       lineNumber: int32,
                                       name: str): str =
    var foundType = ""
    var foundLine: int32 = -1
    var foundIndex: int32 = -1
    for i in 0..<irFunction.statements.len:
        let stmt = irFunction.statements[i]
        if stmt.lineNumber >= lineNumber ||
           stmt.kind != texpr.TypedExprIrStmtFor ||
           stmt.bindingName != name ||
           stmt.forStartNodeIndex < 0 || stmt.rhsNodeIndex < 0:
            continue
        if !PrimaryBodyIrRangeNodeBelongsToStatement(typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      stmt,
                                                      stmt.forStartNodeIndex) ||
           !PrimaryBodyIrRangeNodeBelongsToStatement(typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      stmt,
                                                      stmt.rhsNodeIndex):
            continue
        if stmt.lineNumber < foundLine ||
           (stmt.lineNumber == foundLine && i <= foundIndex):
            continue
        foundLine = stmt.lineNumber
        foundIndex = i
        foundType = "int32"
    return foundType

@borrows
fn PrimaryBodyIrStructuredStatementBindingType(irFunction: lower.PrimaryObjectIrFunction,
                                                lineNumber: int32,
                                                nameRaw: str,
                                                bindingNameGlobalType: str): str =
    let name = strutil.Strip(nameRaw)
    if name == "":
        return ""
    var foundType = ""
    var foundLine: int32 = -1
    var foundIndex: int32 = -1
    for i in 0..<irFunction.statements.len:
        let stmt = irFunction.statements[i]
        if stmt.lineNumber >= lineNumber || stmt.bindingName != name:
            continue
        if bindingNameGlobalType != "" &&
           stmt.kind != texpr.TypedExprIrStmtLocalDecl:
            continue
        if stmt.resultType == "" || stmt.resultType == "unknown" ||
           stmt.resultType == "call_expr" ||
           !B2PrimaryObjectMetadataTextStable(stmt.resultType):
            continue
        if stmt.lineNumber < foundLine ||
           (stmt.lineNumber == foundLine && i <= foundIndex):
            continue
        if foundType != "" &&
           !PrimaryBodyIrTypeTextIsGenericPointer(foundType) &&
           PrimaryBodyIrTypeTextIsGenericPointer(stmt.resultType):
            continue
        foundLine = stmt.lineNumber
        foundIndex = i
        foundType = stmt.resultType
    return foundType

@borrows
fn PrimaryBodyIrLazyTypedStatementBindingType(typedIr: texpr.TypedExprIr,
                                               typedFn: texpr.TypedExprIrFunction,
                                               lineNumber: int32,
                                               nameRaw: str,
                                               bindingNameGlobalType: str): str =
    let name = strutil.Strip(nameRaw)
    let statementCount = typedIr.statements2_statementIndexs.len
    if name == "" || statementCount <= 0 || typedFn.statementStart < 0 ||
       typedFn.statementStart >= statementCount || typedFn.statementCount <= 0:
        return ""
    var statementEnd = typedFn.statementStart + typedFn.statementCount
    if statementEnd > statementCount:
        statementEnd = statementCount
    var foundType = ""
    var foundLine: int32 = -1
    var foundIndex: int32 = -1
    for statementIndex in typedFn.statementStart..<statementEnd:
        let bindingNameRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.statements2_bindingNameIds[statementIndex])
        let resultTypeRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.statements2_resultTypeIds[statementIndex])
        if !IsOk(bindingNameRes) || !IsOk(resultTypeRes):
            continue
        let statementLine = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.statements2_lineNumbers,
            statementIndex)
        let resultType = Value(resultTypeRes)
        if statementLine >= lineNumber || Value(bindingNameRes) != name:
            continue
        if bindingNameGlobalType != "" &&
           typedIr.statements2_kinds[statementIndex] != texpr.TypedExprIrStmtLocalDecl:
            continue
        if resultType == "" || resultType == "unknown" ||
           resultType == "call_expr" ||
           !B2PrimaryObjectMetadataTextStable(resultType):
            continue
        if statementLine < foundLine ||
           (statementLine == foundLine && statementIndex <= foundIndex):
            continue
        if foundType != "" &&
           !PrimaryBodyIrTypeTextIsGenericPointer(foundType) &&
           PrimaryBodyIrTypeTextIsGenericPointer(resultType):
            continue
        foundLine = statementLine
        foundIndex = statementIndex
        foundType = resultType
    return foundType

@borrows
fn PrimaryBodyIrBindingTypeForName(typedIr: texpr.TypedExprIr,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    lineNumber: int32,
                                    nameRaw: str): str =
    let name = strutil.Strip(nameRaw)
    if name == "":
        return ""
    primaryBindingTierProbeTotal = primaryBindingTierProbeTotal + 1
    var traceFunction: bool
    if typedFn.functionName == "PureSystemLinkExecRunFull":
        traceFunction = true
    elif typedFn.functionName == "PureSystemLinkExecFixedOrdinaryRequest":
        traceFunction = true
    var traceName: bool
    if name == "parsedReq":
        traceName = true
    elif name == "req":
        traceName = true
    var traceMiss: bool
    if traceFunction:
        if traceName:
            traceMiss = true
    for i in 0..<irFunction.paramNames.len:
        if i >= irFunction.paramTypes.len:
            continue
        if irFunction.paramNames[i] == name:
            primaryBindingTierProbeParam = primaryBindingTierProbeParam + 1
            return irFunction.paramTypes[i]
    let localBindingType = texpr.TypedExprIrLookupLocalBindingType(typedIr,
                                                                   typedFn.sourcePath,
                                                                   typedFn.functionName,
                                                                   lineNumber,
                                                                   name)
    if localBindingType != "":
        primaryBindingTierProbeLocalHash = primaryBindingTierProbeLocalHash + 1
        if localBindingType == "range":
            return PrimaryBodyIrForBindingElementType(typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       lineNumber,
                                                       name)
        return localBindingType
    # 模块全局：对全局的赋值语句不是本地绑定证据（误判会让调用方给
    # 全局造同名未初始化本地槽，读取绕过 GlobalLoad）。仅 local_decl
    # （真实遮蔽声明）可作为绑定类型来源。
    let bindingNameGlobalType = PrimaryBodyIrTypedGlobalType(typedIr,
                                                             typedFn.sourcePath,
                                                             name)
    if traceMiss:
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"binding_type_lookup_local_miss function={typedFn.functionName} line={lineNumber} name={name} typed_start={typedFn.statementStart} typed_count={typedFn.statementCount} ir_stmt_count={irFunction.statements.len}")
    var foundType = PrimaryBodyIrStructuredStatementBindingType(irFunction,
                                                                 lineNumber,
                                                                 name,
                                                                 bindingNameGlobalType)
    if foundType != "":
        primaryBindingTierProbeIrScan = primaryBindingTierProbeIrScan + 1
    elif irFunction.statements.len <= 0:
        foundType = PrimaryBodyIrLazyTypedStatementBindingType(typedIr,
                                                               typedFn,
                                                               lineNumber,
                                                               name,
                                                               bindingNameGlobalType)
        if foundType != "":
            primaryBindingTierProbeTypedScan = primaryBindingTierProbeTypedScan + 1
    if traceMiss && foundType == "":
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"binding_type_lookup_miss function={typedFn.functionName} line={lineNumber} name={name}")
    if foundType == "":
        primaryBindingTierProbeMiss = primaryBindingTierProbeMiss + 1
        return ""
    if traceMiss:
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"binding_type_lookup_structured_candidate function={typedFn.functionName} line={lineNumber} result_len={foundType.len} stable={B2PrimaryObjectMetadataTextStable(foundType)}")
    if foundType == "range":
        return PrimaryBodyIrForBindingElementType(typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   lineNumber,
                                                   name)
    return foundType

@borrows
fn PrimaryBodyIrTextHasDot(text: str): bool =
    for i in 0..<len(text):
        if text[i] == '.':
            return true
    return false

# Byte offset (into the STRIPPED text) just past the leading root identifier of a
# member-access text — the position of the first '.' or '[', or 0 when the text is
# empty / starts with a separator (no usable root). Mirrors the root parse in
# PrimaryBodyIrIndexedMemberAddressSlot so callers can recover the root name.
@borrows
fn PrimaryBodyIrTextRootIdentifierEnd(textRaw: str): int32 =
    let stripped = strutil.Strip(textRaw)
    if stripped == "":
        return 0
    var rootEnd = len(stripped)
    var scan = 0
    while scan < len(stripped):
        let ch = stripped[scan]
        if ch == '.' || ch == '[':
            rootEnd = scan
            break
        scan = scan + 1
    if rootEnd <= 0 || rootEnd > len(stripped):
        return 0
    return rootEnd

@borrows
fn PrimaryBodyIrSourceRootFromPath(sourcePath: str): str =
    let marker = "/src/"
    for i in 0..<len(sourcePath):
        if i + len(marker) > len(sourcePath):
            break
        if strings.SliceBytes(sourcePath, i, len(marker)) == marker:
            return strings.SliceBytes(sourcePath, 0, i)
    return ""

@borrows
fn PrimaryBodyIrModuleSourcePath(currentSourcePath: str,
                                  moduleNameRaw: str): str =
    var moduleName = strutil.Strip(moduleNameRaw)
    if moduleName == "":
        return ""
    if PrimaryStartsWith(moduleName, "cheng/"):
        moduleName = strings.SliceBytes(moduleName, 6, len(moduleName) - 6)
    let root = PrimaryBodyIrSourceRootFromPath(currentSourcePath)
    if root == "":
        return ""
    var workspaceRoot = strings.CloneStr(root)
    let rootBase = chengpath.PathBaseName(root)
    if rootBase == "codex" || rootBase == "rust-csg-core":
        let parentRoot = chengpath.PathParentDir(root)
        if parentRoot != "":
            workspaceRoot = parentRoot
    if PrimaryStartsWith(moduleName, "codex/"):
        let packageModule = strings.SliceBytes(moduleName, 6, len(moduleName) - 6)
        return Fmt"{workspaceRoot}/codex/src/{packageModule}.cheng"
    if PrimaryStartsWith(moduleName, "rust-csg-core/"):
        let packageModule = strings.SliceBytes(moduleName, 14, len(moduleName) - 14)
        return Fmt"{workspaceRoot}/rust-csg-core/src/{packageModule}.cheng"
    if (rootBase == "codex" || rootBase == "rust-csg-core") &&
       (PrimaryStartsWith(moduleName, "std/") ||
        PrimaryStartsWith(moduleName, "core/")):
        return Fmt"{workspaceRoot}/src/{moduleName}.cheng"
    return Fmt"{root}/src/{moduleName}.cheng"

@borrows
fn PrimaryBodyIrImportAliasTargetSourcePath(typedIr: texpr.TypedExprIr,
                                             currentSourcePath: str,
                                             qualifierRaw: str): str =
    var targetSourcePath = ""
    let state = texpr.TypedExprIrImportAliasTargetState(typedIr,
                                                        currentSourcePath,
                                                        qualifierRaw,
                                                        targetSourcePath)
    if state == texpr.TypedExprBuildIndexAmbiguous:
        panic(Fmt"backend2: ambiguous IR import alias source={currentSourcePath} qualifier={qualifierRaw}")
    if state != texpr.TypedExprBuildIndexUnique:
        return ""
    return targetSourcePath

# bail=644 patch:Implicit builtin source-path lookup for bare-ident calls that
# historically resolve to std/system(Assert, Panic)。Returns abs path to
# std/system.cheng when callHead matches a known builtin (with expected
# callArgCount), "" otherwise. Caller must still verify typedIr has the
# function registered before trusting the lookup; this helper only locates
# the module path, never loads sources nor fabricates a call target.
@borrows
fn PrimaryBodyIrBuiltinBareCallSourcePath(currentSourcePath: str,
                                          callHead: str,
                                          callArgCount: int32): str =
    if currentSourcePath == "" || callHead == "":
        return ""
    if callHead == "Assert" && callArgCount == 2:
        return PrimaryBodyIrModuleSourcePath(currentSourcePath, "std/system")
    if callHead == "Panic" && callArgCount == 1:
        return PrimaryBodyIrModuleSourcePath(currentSourcePath, "std/system")
    return ""

# Split the top-level (bracket-depth 0) comma-separated arguments inside the
# first `[...]` of a type text into a list. `Result[bool]` → ["bool"];
# `Map[str,int32]` → ["str","int32"]; non-bracketed type → empty list. Used to
# bind a generic instance's concrete type arguments to the template's declared
# parameter names so that field types carrying a placeholder (`value: T`) can be
# substituted to a concrete layout before sizing.
@borrows
fn PrimaryBodyIrTypeBracketArgs(typeTextRaw: str): str[] =
    var argsOut: str[]
    let typeText = chengpath.PathTrim(typeTextRaw)
    let openPos = parser.ParserFindText(typeText, "[")
    if openPos <= 0:
        return argsOut
    let closePos = texpr.TypedExprFindMatchingBracket(typeText, openPos)
    if closePos <= openPos:
        return argsOut
    let inner = chengpath.TextSlice(typeText, openPos + 1, closePos - openPos - 1)
    if chengpath.PathTrim(inner) == "":
        return argsOut
    var depth: int32
    var partStart: int32
    for i in 0..<inner.len:
        let ch = inner[i]
        if ch == '[':
            depth = depth + 1
        elif ch == ']':
            depth = depth - 1
        elif ch == ',' && depth == 0:
            add(argsOut, chengpath.PathTrim(chengpath.TextSlice(inner, partStart, i - partStart)))
            partStart = i + 1
    add(argsOut, chengpath.PathTrim(chengpath.TextSlice(inner, partStart, inner.len - partStart)))
    return argsOut

@borrows
fn PrimaryBodyIrCanonicalTypeLayout(typedIr: texpr.TypedExprIr,
                                    sourcePathRaw: str,
                                    _sourceTextRaw: str,
                                    typeRaw: str,
                                    _depth: int32,
                                    sizeBytes: var int32,
                                    alignBytes: var int32): bool =
    var fieldCount: int32
    if !texpr.TypedExprIrLookupTypeLayout(typedIr,
                                         sourcePathRaw,
                                         typeRaw,
                                         sizeBytes,
                                         alignBytes,
                                         fieldCount):
        sizeBytes = 0
        alignBytes = 0
        return false
    if sizeBytes <= 0 || alignBytes <= 0:
        panic(Fmt"backend2: canonical type layout invalid source={sourcePathRaw} type={typeRaw} size={sizeBytes} align={alignBytes}")
    return true

@borrows
fn PrimaryBodyIrCanonicalFieldShape(typedIr: texpr.TypedExprIr,
                                    sourcePath: str,
                                    _sourceText: str,
                                    fieldTypeRaw: str,
                                    _depth: int32,
                                    fieldSizeBytes: var int32,
                                    fieldAlignBytes: var int32): bool =
    var fieldCount: int32
    if texpr.TypedExprIrLookupTypeLayout(typedIr,
                                        sourcePath,
                                        fieldTypeRaw,
                                        fieldSizeBytes,
                                        fieldAlignBytes,
                                        fieldCount):
        if fieldSizeBytes <= 0 || fieldAlignBytes <= 0:
            panic(Fmt"backend2: canonical field shape invalid source={sourcePath} type={fieldTypeRaw} size={fieldSizeBytes} align={fieldAlignBytes}")
        return true
    if texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, fieldTypeRaw):
        fieldSizeBytes = 4
        fieldAlignBytes = 4
        return true
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    return false

@borrows
fn PrimaryBodyIrAnonTupleFieldMeta(typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   typeRaw: str,
                                   fieldNameRaw: str,
                                   fieldTypeOut: var str,
                                   fieldOffsetOut: var int32,
                                   fieldSizeOut: var int32,
                                   fieldAlignOut: var int32,
                                   wholeSizeOut: var int32,
                                   wholeAlignOut: var int32): bool =
    fieldTypeOut = ""
    fieldOffsetOut = 0
    fieldSizeOut = 0
    fieldAlignOut = 0
    wholeSizeOut = 0
    wholeAlignOut = 0
    let t = texpr.TypedExprStripVarType(typeRaw)
    if len(t) < 7 || !PrimaryStartsWith(t, "array<") || t[len(t) - 1] != '>':
        return false
    let inner = strings.SliceBytes(t, 6, len(t) - 7)
    if inner == "":
        return false
    var pos: int32
    var offset: int32
    var maxAlign: int32
    var found: bool
    while pos < len(inner):
        var nameEnd: int32 = pos
        var depth: int32
        while nameEnd < len(inner):
            let ch = inner[nameEnd]
            if ch == '<' || ch == '[' || ch == '(':
                depth = depth + 1
            elif ch == '>' || ch == ']' || ch == ')':
                depth = depth - 1
            elif ch == ':' && depth == 0:
                break
            nameEnd = nameEnd + 1
        let fName = strutil.Strip(strings.SliceBytes(inner, pos, nameEnd - pos))
        var typeEnd: int32 = nameEnd + 1
        depth = 0
        while typeEnd < len(inner):
            let ch = inner[typeEnd]
            if ch == '<' || ch == '[' || ch == '(':
                depth = depth + 1
            elif ch == '>' || ch == ']' || ch == ')':
                depth = depth - 1
            elif ch == ',' && depth == 0:
                break
            typeEnd = typeEnd + 1
        let fType = strutil.Strip(strings.SliceBytes(inner, nameEnd + 1, typeEnd - nameEnd - 1))
        pos = typeEnd + 1
        if fName == "" || fType == "":
            return false
        var fKind: int32
        var fSize: int32
        var fAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, fType, fKind, fSize, fAlign)
        if fSize <= 0:
            return false
        if fAlign <= 0:
            fAlign = 1
        if fAlign > maxAlign:
            maxAlign = fAlign
        offset = PrimaryBodyIrAlignedOffset(offset, fAlign)
        if fName == fieldNameRaw && !found:
            fieldTypeOut = fType
            fieldOffsetOut = offset
            fieldSizeOut = fSize
            fieldAlignOut = fAlign
            found = true
        offset = offset + fSize
    if maxAlign <= 0:
        return false
    wholeSizeOut = PrimaryBodyIrAlignedOffset(offset, maxAlign)
    wholeAlignOut = maxAlign
    return found || fieldNameRaw == ""

@borrows
fn PrimaryBodyIrTypeDefinitionSourcePath(typedIr: texpr.TypedExprIr,
                                          sourcePathRaw: str,
                                          typeRaw: str): str =
    let typeText = texpr.TypedExprStripVarType(typeRaw)
    let dotPos = texpr.TypedExprQualifiedTypeDot(typeText)
    if dotPos <= 0:
        return sourcePathRaw
    let qualifier = strutil.Strip(strings.SliceBytes(typeText, 0, dotPos))
    if qualifier == "":
        return sourcePathRaw
    var targetSourcePath = texpr.TypedExprIrLookupTypeAliasTargetSourcePath(typedIr,
                                                                           sourcePathRaw,
                                                                           qualifier)
    if targetSourcePath == "":
        targetSourcePath = PrimaryBodyIrImportAliasTargetSourcePath(typedIr,
                                                                    sourcePathRaw,
                                                                    qualifier)
    if targetSourcePath == "":
        return sourcePathRaw
    return targetSourcePath

@borrows
fn PrimaryBodyIrAlignedOffset(offset: int32, alignRaw: int32): int32 =
    var align = alignRaw
    if align <= 0:
        align = 1
    return ((offset + align - 1) / align) * align

@borrows
fn PrimaryBodyIrLocalIsParam(slot: coreir.LocalSlot): bool =
    if slot.stackOffset < 0:
        return true
    return false

@borrows
fn PrimaryBodyIrSlotType(bodyIR: coreir.BodyIR, slotId: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return coreir.LocalI32Tag
    return bodyIR.localSlots[slotId].typeKind

# A str-valued root for FieldLoad-through-str protocols: either a plain str
# slot (24-byte str record inline) or a `var str` param slot (Aggregate(24)+
# aux=Str holding the str record address). Both feed BodyOpFieldLoad, which
# already derefs the param-aggregate address indirection (see the len read at
# the I32Tag branch and x64BodyFillFieldLoadOp's LocalAggregateTag+param arm).
@borrows
fn PrimaryLocalSlotSizeOf(slot: coreir.LocalSlot): int32 =
    if slot.sizeBytes > 0:
        return slot.sizeBytes
    if slot.typeKind == coreir.LocalI32Tag:
        return 4
    if slot.typeKind == coreir.LocalF64Tag ||
       slot.typeKind == coreir.LocalI64Tag ||
       slot.typeKind == coreir.LocalPtrTag:
        return 8
    if slot.typeKind == coreir.LocalStrTag:
        return 24
    if slot.typeKind == coreir.LocalAggregateTag:
        return coreir.ResultStrSizeBytes
    return 0

# Number of ldr/str instruction PAIRS to copy exactly `byteCount` bytes of an
# sret aggregate, choosing the widest exact chunk: 8-byte words when 8-aligned
# (str=24B→3, Result[str]=64B→8), else 4-byte words when 4-aligned (Row 12B→3).
# A precise count is mandatory: rounding up to 8-byte words over-writes the
# caller's adjacent (tightly packed) stack slot — e.g. add(seq, helper()) sret
# clobbers the seq header pointer → segfault.
@borrows
fn PrimaryBodyIrIntLiteralInner(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    if text == "":
        return ""
    if PrimaryBodyIrCharLiteralValue(text) >= 0:
        return text
    let castHeads = ["int32", "Int32", "int64", "Int64",
                     "uint8", "UInt8", "uint16", "UInt16",
                     "uint32", "UInt32", "uint64", "UInt64"]
    for ci in 0..<castHeads.len:
        let castInner = PrimaryBodyIrWholeCallInnerForHead(text, castHeads[ci])
        if castInner != "":
            return PrimaryBodyIrIntLiteralInner(castInner)
    var start: int32
    if text[0] == '-' || text[0] == '+':
        start = 1
    if start >= len(text):
        return ""
    # 0x / 0b prefixed literals: at least one base digit must follow the prefix.
    var digitBase: int32 = 10
    var digitStart = start
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'x' || text[start + 1] == 'X'):
        digitBase = 16
        digitStart = start + 2
    elif start + 1 < len(text) && text[start] == '0' &&
         (text[start + 1] == 'b' || text[start + 1] == 'B'):
        digitBase = 2
        digitStart = start + 2
    if digitStart >= len(text):
        return ""
    var sawDigit = false
    for i in digitStart..<len(text):
        let ch = text[i]
        if ch == '_':
            continue
        var ok = false
        if digitBase == 16:
            ok = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')
        elif digitBase == 2:
            ok = ch == '0' || ch == '1'
        else:
            ok = ch >= '0' && ch <= '9'
        if !ok:
            return ""
        sawDigit = true
    if !sawDigit:
        return ""
    return text

@borrows
fn PrimaryBodyIrTextIsI32Zero(textRaw: str): bool =
    let inner = PrimaryBodyIrIntLiteralInner(textRaw)
    if inner == "":
        return false
    # Use the 64-bit extractor on the bare token: the int32 extractor maps any
    # >int32 literal to its 0 overflow-sentinel, which would mis-tag a wide
    # nonzero value (e.g. uint64(1099511627776)) as zero.
    var innerValue64: int64
    if !PrimaryBodyIrExtractInt64FromText(inner, innerValue64):
        return false
    return innerValue64 == int64(0)

@borrows
fn PrimaryBodyIrWholeCallInnerForHead(textRaw: str,
                                       headRaw: str): str =
    let text = strutil.Strip(textRaw)
    let head = strutil.Strip(headRaw)
    if text == "" || head == "":
        return ""
    let openPos = len(head)
    if len(text) <= openPos + 1:
        return ""
    if !PrimaryStartsWith(text, head):
        return ""
    if text[openPos] != '(':
        return ""
    if text[len(text) - 1] != ')':
        return ""
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos != len(text) - 1:
        return ""
    return strutil.Strip(strings.SliceBytes(text, openPos + 1, len(text) - openPos - 2))

@borrows
fn PrimaryBodyIrAppendInvalidOp(bodyIR: var coreir.BodyIR,
                                lineNumber: int32,
                                statementKind: int32,
                                detail0: int32,
                                detail1: int32) =
    if os.GetEnv("CHENG_X64_DBG3") != "":
        os.WriteLine(os.GetStderr(), Fmt"x64dbg3 invalid_op line={lineNumber} kind={statementKind} detail0={detail0} detail1={detail1}")
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpInvalidTag
    op.target = lineNumber
    add(op.operands, statementKind)
    add(op.operands, detail0)
    add(op.operands, detail1)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)

@borrows
fn PrimaryBodyIrGlobalSeqAddressSlot(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      rootName: str): int32 =
    # exact source-path match preferred; c857 non-exact uniqueness fallback for a
    # module-global whose registration sourcePath normalizes differently from the
    # caller's (e.g. `loweringParallelResults`). The slot name is keyed off the SAME
    # registered sourcePath as the type so the emitted global symbol stays correct.
    let globalSource = PrimaryBodyIrTypedGlobalSourcePath(typedIr, sourcePath, rootName)
    if globalSource == "":
        return -1
    var globalType = PrimaryBodyIrTypedGlobalTypeExact(typedIr, sourcePath, rootName)
    if globalType == "":
        globalType = PrimaryBodyIrTypedGlobalType(typedIr, sourcePath, rootName)
    if globalType == "":
        return -1
    var globalTypeKind: int32
    var globalSizeBytes: int32
    var globalAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   globalSource,
                                   globalType,
                                   globalTypeKind,
                                   globalSizeBytes,
                                   globalAlignBytes)
    if globalTypeKind != coreir.LocalAggregateTag:
        return -1
    var globalSlotName = PrimaryBodyIrTypedGlobalSlotNameExact(typedIr, sourcePath, rootName)
    if globalSlotName == "":
        globalSlotName = PrimaryBodyIrTypedGlobalSlotName(typedIr, sourcePath, rootName)
    if globalSlotName == "":
        return -1
    let globalSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                        slotNames,
                                                        globalSlotName,
                                                        globalTypeKind,
                                                        globalSizeBytes,
                                                        globalAlignBytes)
    if globalSlot < 0 || globalSlot >= bodyIR.localSlots.len:
        return -1
    bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"{globalSlotName}#global_seq_addr",
                                                 coreir.LocalPtrTag)
    if addrSlot < 0 || addrSlot >= bodyIR.localSlots.len:
        return -1
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpGlobalLoadTag
    addrOp.target = addrSlot
    add(addrOp.operands, globalSlot)
    add(addrOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    return addrSlot

# Resolve a seq reference text (plain name or nested field path) into its
# root slot, header byte offset, and seq type text.
@borrows
fn PrimaryBodyIrTextIsPlainArrowField(textRaw: str): bool =
    # 只将单层 `ptr->field` 交给箭头字段物化器。整调用如
    # `cheng_seq_set(seqInst->buffer, ...)` 内含箭头但不是该形态，必须留给
    # whole-call realizer。
    let text = strutil.Strip(textRaw)
    let n = len(text)
    if n < 4:
        return false
    var arrowPos: int32 = -1
    var i = 0
    while i + 1 < n:
        if text[i] == '-' && text[i + 1] == '>':
            if arrowPos >= 0:
                return false
            arrowPos = i
            i = i + 2
            continue
        i = i + 1
    if arrowPos <= 0 || arrowPos + 2 >= n:
        return false
    let rootName = strutil.Strip(strings.SliceBytes(text, 0, arrowPos))
    let fieldName = strutil.Strip(
        strings.SliceBytes(text, arrowPos + 2, n - arrowPos - 2))
    return texpr.TypedExprTextIsSimpleIdent(rootName) &&
           texpr.TypedExprTextIsSimpleIdent(fieldName)

@borrows
fn PrimaryBodyIrTextHasFieldOrIndex(text: str): bool =
    var i = 0
    while i < len(text):
        if text[i] == '.':
            return true
        if text[i] == '-' && i + 1 < len(text) && text[i + 1] == '>':
            return true
        if text[i] == '[':
            # 排除泛型/数组类型占位符 [T]/[K,V]/[T;N]: '[' 后首个非空字符为大写字母
            # (真 index 首字符为数字或小写变量名), 此类 [...] 不计为 index.
            var j = i + 1
            while j < len(text) && text[j] == ' ':
                j = j + 1
            if j < len(text) && text[j] >= 'A' && text[j] <= 'Z':
                var depth = 1
                j = j + 1
                while j < len(text) && depth > 0:
                    if text[j] == '[':
                        depth = depth + 1
                    elif text[j] == ']':
                        depth = depth - 1
                    j = j + 1
                i = j
                continue
            return true
        if text[i] == ']':
            return true
        i = i + 1
    return false

@borrows
fn PrimaryBodyIrTextIsBareWholeCall(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if text == "" || text[len(text) - 1] != ')':
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos != len(text) - 1:
        return false
    let head = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    return texpr.TypedExprCallHeadIsPlainQualifiedIdent(head)

# Indexed-root field LHS, e.g. `xs[i].field`. The typed layer splits the root
# index off into stmt.assignRootName="xs" (the bare ident) so the structured
# fields carry NO index — only the full LHS in stmt.bindingName has it. Recover
# the index expression text from bindingName: split at the top-level `.`
# (bracket-aware), then peel the `[...]` off the root segment. Returns true and
# fills indexOut with the inner index text when the root segment is subscripted.

# ==== W4 悬崖波接线 (backend2_lower / backend2_lower_stmt 收割配套) ====
# (i) MissOp 协议 var 单侧归口本档 (Begin/Flush 本来就在本档直触): 高档 (slots/lower/stmt)
#     写读全部经下方 accessor, 消除跨模块 var 写 bail (710/631) 与分裂副本 desync (审计②)。
fn PrimaryBodyIrNodeEvalMissOpReset() =
    primaryBodyIrNodeEvalMissOp = ""

fn PrimaryBodyIrNodeEvalMissOpText(): str =
    return primaryBodyIrNodeEvalMissOp

# (iii) FieldMetaCache 同侧化 accessor (W5, slots 头注账本③ 清账): 读者 (slots
#     LookupSourceFieldMeta 命中臂) 经此读本档填充态 (writer=本档 FieldMetaCacheStore/
#     Index, 同侧数组), slots 4 空副本致 len 合取门恒假=恒 miss 重算的面消除。
#     语义 = pobjp 原命中臂逐字等价: 界检合取 (cachedIndex>=0 && < 4 数组 len, De Morgan
#     反写) 过→4 出参同序赋值返 true; 不过→出参不触返 false (调用方保留原有效性内检
#     与 miss 落穿重扫, 含"命中但载荷无效→出参已赋值落穿"边缘语义)。
fn PrimaryBodyIrFieldMetaCacheEntryAt(entryIndex: int32,
                                       fieldType: var str,
                                       fieldOffsetBytes: var int32,
                                       fieldSizeBytes: var int32,
                                       fieldAlignBytes: var int32): bool =
    if entryIndex < 0 ||
       entryIndex >= primaryBodyIrFieldMetaCacheFieldTypes.len ||
       entryIndex >= primaryBodyIrFieldMetaCacheOffsets.len ||
       entryIndex >= primaryBodyIrFieldMetaCacheSizes.len ||
       entryIndex >= primaryBodyIrFieldMetaCacheAligns.len:
        return false
    fieldType = primaryBodyIrFieldMetaCacheFieldTypes[entryIndex]
    fieldOffsetBytes = primaryBodyIrFieldMetaCacheOffsets[entryIndex]
    fieldSizeBytes = primaryBodyIrFieldMetaCacheSizes[entryIndex]
    fieldAlignBytes = primaryBodyIrFieldMetaCacheAligns[entryIndex]
    return true

# ==== W4 fn 移档 ×4 (lower_slots → 本档; 体逐字, body_sha256==manifest 逐一验) ====
# 移档原因: 4 fn 读 FunctionTail*/FunctionSourceIndexes/TailNames/MissOp 的填充态 (writer
# 全在本档 PrepareFunctionLookupCache/MissAt 协议), 留在 slots 读空副本 = sameSource 恒假 /
# 桶路径恒死 (TargetFunctionIndexWithKind 5515 谓词是调用目标解析载荷, 行为面非仅性能)。
# callee 闭包全在本档 (脚本验证: TargetFunctionIndex→WithKind; WithKind/ResolvedCallResultType
# →util only; MissAt 零 callee), 移档零文本编辑。slots/lower/stmt 调用点直名经 alias-free
# import 解析至此 (W3 三变体实测绿的同款模式)。

@borrows
fn PrimaryBodyIrTargetFunctionIndex(typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     functionName: str): int32 =
    # P2 atomic thin wrapper: existing 22+ callers don't care about resolution
    # kind detail (they're surface predicates: index >= 0 ↔ visible). Sites
    # :11059 / :11102 (the 2 path-decision consumers identified in the design)
    # call PrimaryBodyIrTargetFunctionIndexWithKind directly.
    var kindDiscard: texpr.CallTargetResolutionKind
    kindDiscard = texpr.CallTargetUnresolved
    return PrimaryBodyIrTargetFunctionIndexWithKind(typedIr,
                                                    sourcePath,
                                                    functionName,
                                                    kindDiscard)

@borrows
fn PrimaryBodyIrTargetFunctionIndexAtLine(
        typedIr: texpr.TypedExprIr,
        sourcePathRaw: str,
        functionNameRaw: str,
        signatureLineNumber: int32): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = strutil.Strip(functionNameRaw)
    let tailName = PrimaryCallTargetTailName(functionName)
    if sourcePath == "" || functionName == "" ||
       signatureLineNumber <= 0:
        return -1
    var foundIndex: int32 = -1
    for fnIndex in 0..<typedIr.functions2_functionNameIds.len:
        let sourceRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.functions2_sourcePathIds[fnIndex])
        let nameRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.functions2_functionNameIds[fnIndex])
        if !IsOk(sourceRes) || !IsOk(nameRes) ||
           parser.ParserNormalizePath(Value(sourceRes)) != sourcePath ||
           (Value(nameRes) != functionName && Value(nameRes) != tailName) ||
           arenamod.ArenaArrayInt32Get(
               typedIr.arena,
               typedIr.functions2_signatureLineNumbers,
               fnIndex) != signatureLineNumber:
            continue
        if foundIndex >= 0:
            return -1
        foundIndex = fnIndex
    return foundIndex

@borrows
fn PrimaryBodyIrTargetFunctionIndexWithKind(typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             functionName: str,
                                             kindOut: var texpr.CallTargetResolutionKind): int32 =
    # P2 atomic producer (sealed 10-case CallTargetResolutionKind):
    # init out kind, then assign at each return path so consumers never have
    # to reverse-guess "missing vs ambiguous" from foundQualifiedAnySource
    # {-1/-2/>=0} × PrimaryFunctionTargetCountAnySource {0/1/>=2} 6-state旁路.
    kindOut = texpr.CallTargetUnresolved
    PrimaryBodyIrPrepareFunctionLookupCache(typedIr)
    let tailName = PrimaryCallTargetTailName(functionName)
    let qualifier = texpr.TypedExprQualifiedCallQualifier(functionName)
    # P2 atomic producer site #9 (TailLeafSplitFail): targetText contains '.' or
    # '::' but the split silently fell back to the full string (PrimaryCallTargetTailName
    # at :1260-1271 returns functionName unchanged when tailStart >= len(targetText)).
    # Detect at producer entry so consumer reads kind and early-bails before any
    # tail consumer (3541/3565/19267/19619 + lowering_plan:1398) uses the wrong leaf.
    if tailName == functionName && len(functionName) > 0:
        var hasDot = false
        for i in 0..<len(functionName):
            if functionName[i] == '.':
                hasDot = true
        if !hasDot && len(functionName) >= 2:
            for j in 0..<(len(functionName) - 1):
                if functionName[j] == ':' && functionName[j + 1] == ':':
                    hasDot = true
        if hasDot:
            # Trailing separator (e.g. "Err[layout.FixedBytes32]") collapsed
            # tailStart back to 0 — the silent path of design CallTargetTailLeafSplitFail.
            kindOut = texpr.CallTargetTailLeafSplitFail
            return -1
    # Call metadata must carry the declaration owner selected by TypedExpr.
    # Compilation-unit uniqueness is not a visibility or ownership rule.
    if sourcePath == "" || tailName == "":
        kindOut = texpr.CallTargetMissing
        return -1
    let exactSourceIndex = PrimaryBodyIrFunctionLookupSourcePathIndex(sourcePath)
    if exactSourceIndex < 0:
        kindOut = texpr.CallTargetMissing
        return -1
    let exactTailBucket = PrimaryObjectIrFunctionIndexHash(
        tailName, primaryBodyIrFunctionTailBucketHeads.len)
    if exactTailBucket < 0:
        kindOut = texpr.CallTargetMissing
        return -1
    var exactEntryIndex = primaryBodyIrFunctionTailBucketHeads[exactTailBucket]
    var exactMatchIndex: int32 = -1
    var exactMatchCount: int32
    while exactEntryIndex >= 0:
        if primaryBodyIrFunctionTailEntryTails[exactEntryIndex] == tailName:
            let exactCandidateIndex =
                primaryBodyIrFunctionTailEntryFnIndexes[exactEntryIndex]
            if exactCandidateIndex >= 0 &&
               exactCandidateIndex < primaryBodyIrFunctionSourceIndexes.len &&
               primaryBodyIrFunctionSourceIndexes[exactCandidateIndex] ==
                   exactSourceIndex:
                let exactNameRes: Result[str] = langintern.LookupIntern(
                    typedIr.internPool,
                    typedIr.functions2_functionNameIds[exactCandidateIndex])
                if !IsOk(exactNameRes):
                    panic("backend2: corrupt typed function name row")
                let exactCandidateName = Value(exactNameRes)
                let exactCandidateTail =
                    PrimaryCallTargetTailName(exactCandidateName)
                if exactCandidateName == functionName ||
                   exactCandidateTail == functionName ||
                   exactCandidateTail == tailName:
                    exactMatchCount = exactMatchCount + 1
                    if exactMatchIndex < 0 ||
                       exactCandidateIndex < exactMatchIndex:
                        exactMatchIndex = exactCandidateIndex
        exactEntryIndex = primaryBodyIrFunctionTailEntryNext[exactEntryIndex]
    if exactMatchCount == 0:
        kindOut = texpr.CallTargetMissing
        return -1
    if exactMatchCount == 1:
        kindOut = texpr.CallTargetSameSourceUnique
    else:
        kindOut = texpr.CallTargetSameSourceAmbiguous
    return exactMatchIndex

@borrows
fn PrimaryBodyIrResolvedCallResultType(typedIr: texpr.TypedExprIr,
                                        stmt: lower.PrimaryObjectIrStatement): str =
    # TypedExpr owns result typing. Backend2 may consult an exact importc row,
    # but must never infer a result from a same-named function in another file.
    if stmt.callTargetImportc && stmt.callTargetSourcePath != "":
        let importcResultType = texpr.TypedExprIrLookupImportcReturnType(
            typedIr, stmt.callTargetSourcePath, stmt.callTarget)
        if importcResultType != "":
            return importcResultType
    return stmt.resultType

fn PrimaryBodyIrNodeEvalMissAt(opText: str): int32 =
    if primaryBodyIrNodeEvalMissOp == "":
        primaryBodyIrNodeEvalMissOp = opText
    return -1

# Arithmetic BinOp (i32/i64/f64 add/sub/mul/madd/sdiv/bitwise/shift) result type
# kind for the node-eval path, or LocalInvalidTag if opKind isn't one the node
# path handles. The node path previously bailed on BinOp index expressions
# (e.g. `curSlot*count+idx` = I32Add): the probe had no BinOp branch → returned
# -1 → IndexGet probe failed → node path skipped → text path couldn't lower
# nested `g[binop].field` aggregate (Bytes) returns, blocking 44
# gClientAppStream/gServerAppStream accessors (and the 2 full-slot getters).
# Handling BinOps here lets the node path evaluate computed indices — mirrors
# the text-path BinOp emission (8879-8886) and the IndexGet address Madd
# (25189-25195). Madd is 3-operand (a*b+c, operand2=c). Set limited to opKinds
# the backend BodyOpBinOpTag already executes (text-path-proven i32 set + i64
# counterparts + Madd); Udiv/Mod/Umod/I32Lsr/Neg/StrAdd stay text-path for now.
# I64Lsr admitted (707 解封): BinOpMeta already folds I64Lsr→I32Lsr and the
# arm64 filler dispatches A64EncLsrv with opIs64 — only this gate was missing,
# so `u64expr >> u64(shift)` trees (rsa.cheng:743 rsaBigToBytesLocalFill) fell
# to the text path, which can't lower imported-struct indexed reads → bail 707.
