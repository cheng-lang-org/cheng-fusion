    backend2AssemblerTempRecordSequence(
        out, value.callReachable.cap, int64(sizeof(bool)))
    backend2AssemblerTempRecordSequence(
        out, value.blockEntryPositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.blockExitPositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.bodyOpKinds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.bodyOpOperandCounts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.opBeforePositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.opAfterPositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.termBeforePositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.termAfterPositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueDefPositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueDefFactIndices.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueDefBlocks.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueDefIsEntry.cap, int64(sizeof(bool)))
    backend2AssemblerTempRecordSequence(
        out, value.valueEndPositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueSlotIndices.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueTypeKinds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueClasses.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueMemoryHomes.cap, int64(sizeof(bool)))
    backend2AssemblerTempRecordSequence(
        out, value.valueAssignedRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueUseOffsets.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueUsePositions.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueUseFactIndices.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueUseKinds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueUseSourceBlocks.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.valueUseTargetBlocks.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
