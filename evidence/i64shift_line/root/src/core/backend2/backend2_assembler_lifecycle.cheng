# backend2_assembler_lifecycle
#
# Invocation-local ownership for backend2 assembler scratch storage.  Resolver
# rows move to the canonical emitter, complete emission payloads move to the
# publisher, and every terminal path physically releases nested Seq/string
# storage before consuming the ledger receipt.

import std/rawbytes
import std/os
import std/seqs
import std/system
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_production_emitter as regprod
import cheng/core/tooling/lifetime_ledger as lifetime
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const
    Backend2AssemblerTempPhaseEmpty = 0
    Backend2AssemblerTempPhaseInvocation = 1
    Backend2AssemblerTempPhaseResolved = 2
    Backend2AssemblerTempPhaseEmission = 3
    Backend2AssemblerTempPhasePublished = 4
    Backend2AssemblerTempPhaseReleased = 5

    Backend2AssemblerTempOutcomeSuccess = 1
    Backend2AssemblerTempOutcomeFailure = 2

type
    Backend2AssemblerTempRetainedReport =
        retainedBytes: int64
        physicalBufferCount: int32
        managedStringValueCount: int32
        managedStringBytes: int64

    Backend2AssemblerTempLifecycle =
        ledger: lifetime.LifetimeLedger
        resolvedCategoryId: int32
        emissionCategoryId: int32
        aggregateBufferCategoryId: int32
        aggregateStringCategoryId: int32
        allSymbolBufferCategoryId: int32
        allSymbolStringCategoryId: int32
        workerBufferCategoryId: int32
        resolverOwnerId: int32
        emitterOwnerId: int32
        publisherOwnerId: int32
        aggregateOwnerId: int32
        pipelineOwnerId: int32
        assemblerInputOwnerId: int32
        workerSchedulerOwnerId: int32
        workerReceiverOwnerId: int32
        phase: int32
        activeFunctionRow: int32 = -1
        completedFunctionCount: int32
        failedFunctionCount: int32
        resolvedObjectId: int32
        emissionObjectId: int32
        resolvedOwnerToken: layout.FixedBytes32
        emissionOwnerToken: layout.FixedBytes32
        resolvedRetained: Backend2AssemblerTempRetainedReport
        emissionRetained: Backend2AssemblerTempRetainedReport
        resolvedCallTargets: str[]
        resolvedDataTargets: str[]
        resolvedCStringTargets: str[]
        emission: regprod.RegallocProductionFunctionEmission
        seenFunctionSymbols: str[]
        seenGlobalLabels: str[]
        seenDataLabels: str[]
        seenGlobalSlotNames: str[]
        seenGlobalPayloadTexts: str[]
        seenGlobalPayloadByteCounts: int32[]
        allSymbolNames: str[]
        workerPids: int32[]
        workerReadFds: int32[]
        seenFunctionSymbolsBufferObjectId: int32
        seenGlobalLabelsBufferObjectId: int32
        seenDataLabelsBufferObjectId: int32
        seenGlobalSlotNamesBufferObjectId: int32
        seenGlobalPayloadTextsBufferObjectId: int32
        seenGlobalPayloadByteCountsBufferObjectId: int32
        allSymbolNamesBufferObjectId: int32
        workerPidsBufferObjectId: int32
        workerReadFdsBufferObjectId: int32
        allSymbolOwnerToken: layout.FixedBytes32
        workerOwnerToken: layout.FixedBytes32
        allSymbolsMovedToAssembler: bool
        workerArraysBound: bool
        workerArraysMovedToReceiver: bool
        workerArraysReleased: bool
        workerEndpointsClosedAndReaped: bool
        observedPhysicalBufferCount: int64
        observedPhysicalBytes: int64
        releasedPhysicalBufferCount: int32
        releasedPhysicalBytes: int64
        releasedManagedStringValueCount: int32
        releasedManagedStringBytes: int64
        aggregateOwnerToken: layout.FixedBytes32
        terminalOutcome: int32
        terminalLedgerStorageReleasedBufferCount: int32
        terminalLedgerStorageReleasedBytes: int64
        terminalReceiptConsumed: bool

    Backend2AssemblerTempReleaseReceipt =
        aggregateOwnerToken: layout.FixedBytes32
        allSymbolOwnerToken: layout.FixedBytes32
        workerOwnerToken: layout.FixedBytes32
        outcome: int32
        completedFunctionCount: int32
        failedFunctionCount: int32
        allocated: int64
        released: int64
        live: int64
        allocatedBytes: int64
        releasedBytes: int64
        liveBytes: int64
        ownerTransferCount: int64
        physicalBufferCount: int64
        physicalBytes: int64
        releasedPhysicalBufferCount: int32
        releasedPhysicalBytes: int64
        releasedManagedStringValueCount: int32
        releasedManagedStringBytes: int64
        rowStorageReleased: bool
        aggregateStorageReleased: bool
        allSymbolStorageReleased: bool
        workerStorageReleased: bool
        workerEndpointsClosedAndReaped: bool
        ledgerStorageReleased: bool
        ledgerStorageReleasedSequenceCount: int32
        ledgerStorageReleasedBufferCount: int32
        ledgerStorageReleasedBytes: int64

fn backend2AssemblerTempDropOwnedString(value: var str) =
    os.ReleaseStr(value)

fn backend2AssemblerTempFail(message: str) =
    panic(message)

fn backend2AssemblerTempCheckedAdd(
        total: var int64,
        value: int64) =
    if value < int64(0) ||
       total < int64(0) ||
       total > int64(9223372036854775807) - value:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: retained byte overflow")
    total = total + value

fn backend2AssemblerTempRecordSequence(
        out: var Backend2AssemblerTempRetainedReport,
        capacity: int32,
        elementBytes: int64) =
    if capacity < 0 || elementBytes <= int64(0):
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid sequence shape")
    if capacity == 0:
        return
    if int64(capacity) >
       int64(9223372036854775807) / elementBytes:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: sequence byte overflow")
    out.physicalBufferCount =
        out.physicalBufferCount + 1
    backend2AssemblerTempCheckedAdd(
        out.retainedBytes, int64(capacity) * elementBytes)

@borrows
fn backend2AssemblerTempRecordString(
        out: var Backend2AssemblerTempRetainedReport,
        value: str) =
    if len(value) <= 0:
        return
    out.managedStringValueCount =
        out.managedStringValueCount + 1
    backend2AssemblerTempCheckedAdd(
        out.managedStringBytes, int64(len(value)))
    backend2AssemblerTempCheckedAdd(
        out.retainedBytes, int64(len(value)))

fn backend2AssemblerTempRecordStrings(
        out: var Backend2AssemblerTempRetainedReport,
        values: var str[]) =
    backend2AssemblerTempRecordSequence(
        out, values.cap, int64(sizeof(str)))
    for index in 0..<values.len:
        backend2AssemblerTempRecordString(out, values[index])

fn backend2AssemblerTempMergeRetained(
        out: var Backend2AssemblerTempRetainedReport,
        value: Backend2AssemblerTempRetainedReport) =
    backend2AssemblerTempCheckedAdd(
        out.retainedBytes, value.retainedBytes)
    out.physicalBufferCount =
        out.physicalBufferCount + value.physicalBufferCount
    out.managedStringValueCount =
        out.managedStringValueCount +
            value.managedStringValueCount
    backend2AssemblerTempCheckedAdd(
        out.managedStringBytes, value.managedStringBytes)

fn backend2AssemblerTempRecordRelocs(
        out: var Backend2AssemblerTempRetainedReport,
        values: var contract.RegallocA64ActionReloc[]) =
    backend2AssemblerTempRecordSequence(
        out,
        values.cap,
        int64(sizeof(contract.RegallocA64ActionReloc)))
    for index in 0..<values.len:
        backend2AssemblerTempRecordString(
            out, values[index].targetSymbol)

fn backend2AssemblerTempRecordActionEmissions(
        out: var Backend2AssemblerTempRetainedReport,
        values: var alloc.RegallocValueActionEmission[]) =
    backend2AssemblerTempRecordSequence(
        out,
        values.cap,
        int64(sizeof(alloc.RegallocValueActionEmission)))
    for index in 0..<values.len:
        backend2AssemblerTempRecordString(
            out, values[index].emittedBytesSha256)
        backend2AssemblerTempRecordString(
            out, values[index].ownerPlanSha256)
        backend2AssemblerTempRecordString(
            out, values[index].emissionOwnerSha256)
        backend2AssemblerTempRecordString(
            out, values[index].actionSemanticSha256)
        backend2AssemblerTempRecordString(
            out, values[index].bindingSha256)

fn backend2AssemblerTempRecordConstraints(
        out: var Backend2AssemblerTempRetainedReport,
        value: var alloc.RegallocTargetConstraints) =
    backend2AssemblerTempRecordSequence(
        out, value.registerUniverse.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.allocatableCallerRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.allocatableCalleeRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.reservedRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.callClobberRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.fixedArgRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.gprTypeKinds.cap, int64(sizeof(int32)))

