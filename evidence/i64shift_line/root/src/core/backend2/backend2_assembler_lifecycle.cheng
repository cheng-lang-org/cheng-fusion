fn backend2AssemblerTempReleaseRecipes(
        value: var contract.RegallocA64FunctionRecipes) =
    seqs.chengSeqFreeTyped(value.parameterValueIds)
    seqs.chengSeqFreeTyped(value.parameterWidths)
    seqs.chengSeqFreeTyped(value.parameterHomeOffsets)
    seqs.chengSeqFreeTyped(value.localStackOffsets)
    seqs.chengSeqFreeTyped(value.calleeSavedRegs)
    seqs.chengSeqFreeTyped(value.calleeSavedOffsets)
    seqs.chengSeqFreeTyped(value.prologueWords)
    seqs.chengSeqFreeTyped(value.epilogueWords)
    seqs.chengSeqFreeTyped(value.abiIngressRegs)
    seqs.chengSeqFreeTyped(value.abiIngressOffsets)
    seqs.chengSeqFreeTyped(value.abiIngressParamOrdinals)
    seqs.chengSeqFreeTyped(value.abiIngressValueIds)
    seqs.chengSeqFreeTyped(value.abiIngressWidths)
    seqs.chengSeqFreeTyped(value.abiIngressWordIndices)
    seqs.chengSeqFreeTyped(value.abiIngressWordCounts)
    for index in 0..<value.machineFragments.len:
        backend2AssemblerTempReleaseMachineFragment(
