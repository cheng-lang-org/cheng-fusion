fn backend2AssemblerTempRecordActionRecipe(
        out: var Backend2AssemblerTempRetainedReport,
        value: var contract.RegallocA64ActionRecipe) =
    backend2AssemblerTempRecordSequence(
        out, value.writtenRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.words.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordRelocs(out, value.relocs)

fn backend2AssemblerTempRecordSiteRecipe(
        out: var Backend2AssemblerTempRetainedReport,
        value: var contract.RegallocA64SiteRecipe) =
    backend2AssemblerTempRecordSequence(
        out, value.writtenRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.words.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordRelocs(out, value.relocs)
    backend2AssemblerTempRecordSequence(
        out, value.branchWordIndices.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.branchTargetBlocks.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.branchConditionCodes.cap, int64(sizeof(int32)))

fn backend2AssemblerTempRecordMachineFragment(
        out: var Backend2AssemblerTempRetainedReport,
        value: var contract.RegallocA64MachineFragment) =
    backend2AssemblerTempRecordSequence(
        out, value.writtenRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out,
        value.allocatorClobberFactIndices.cap,
        int64(sizeof(int32)))
    backend2AssemblerTempRecordRelocs(out, value.relocs)
    backend2AssemblerTempRecordSequence(
        out, value.branchWordIndices.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.branchTargetBlocks.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.branchTargetWordStarts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.branchByteOffsets.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.branchTargetByteOffsets.cap, int64(sizeof(int32)))

fn backend2AssemblerTempRecordRecipes(
        out: var Backend2AssemblerTempRetainedReport,
        value: var contract.RegallocA64FunctionRecipes) =
    backend2AssemblerTempRecordSequence(
        out, value.parameterValueIds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.parameterWidths.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.parameterHomeOffsets.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.localStackOffsets.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.calleeSavedRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.calleeSavedOffsets.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.prologueWords.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.epilogueWords.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.abiIngressRegs.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.abiIngressOffsets.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.abiIngressParamOrdinals.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.abiIngressValueIds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.abiIngressWidths.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.abiIngressWordIndices.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.abiIngressWordCounts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out,
        value.machineFragments.cap,
        int64(sizeof(contract.RegallocA64MachineFragment)))
    for index in 0..<value.machineFragments.len:
        backend2AssemblerTempRecordMachineFragment(
            out, value.machineFragments[index])
    backend2AssemblerTempRecordSequence(
        out,
        value.recipes.cap,
        int64(sizeof(contract.RegallocA64ActionRecipe)))
    for index in 0..<value.recipes.len:
        backend2AssemblerTempRecordActionRecipe(
            out, value.recipes[index])
    backend2AssemblerTempRecordSequence(
        out,
        value.opRecipes.cap,
        int64(sizeof(contract.RegallocA64SiteRecipe)))
    for index in 0..<value.opRecipes.len:
        backend2AssemblerTempRecordSiteRecipe(
            out, value.opRecipes[index])
    backend2AssemblerTempRecordSequence(
        out,
        value.termRecipes.cap,
        int64(sizeof(contract.RegallocA64SiteRecipe)))
    for index in 0..<value.termRecipes.len:
        backend2AssemblerTempRecordSiteRecipe(
            out, value.termRecipes[index])
    backend2AssemblerTempRecordSequence(
        out, value.blockEmissionOrder.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.blockWordStarts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.opWordStarts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.opWordCounts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.termWordStarts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.termWordCounts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.edgeSplitWordStarts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.actionWordStarts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.actionWordCounts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.functionWords.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordRelocs(out, value.functionRelocs)
    backend2AssemblerTempRecordSequence(
        out, value.encoderEventBuilder.wordRows.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEventBuilder.kinds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEventBuilder.operandCounts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEventBuilder.operand0s.cap, int64(sizeof(int64)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEventBuilder.operand1s.cap, int64(sizeof(int64)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEventBuilder.operand2s.cap, int64(sizeof(int64)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEventBuilder.operand3s.cap, int64(sizeof(int64)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEventBuilder.encodedWords.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEvents.kinds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEvents.operandCounts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEvents.operand0s.cap, int64(sizeof(int64)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEvents.operand1s.cap, int64(sizeof(int64)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEvents.operand2s.cap, int64(sizeof(int64)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEvents.operand3s.cap, int64(sizeof(int64)))
    backend2AssemblerTempRecordSequence(
        out, value.encoderEvents.encodedWords.cap, int64(sizeof(int32)))

fn backend2AssemblerTempRecordReceipt(
        out: var Backend2AssemblerTempRetainedReport,
        value: var alloc.RegallocValueEmissionReceipt) =
    backend2AssemblerTempRecordString(out, value.symbolName)
    backend2AssemblerTempRecordString(out, value.symbolBytesSha256)
    backend2AssemblerTempRecordString(
        out, value.debugProvenanceSha256)
    backend2AssemblerTempRecordString(out, value.frozenSemanticSha256)
    backend2AssemblerTempRecordString(
        out, value.actionSemanticRootSha256)
    backend2AssemblerTempRecordString(
        out, value.actionBindingRootSha256)
    backend2AssemblerTempRecordString(
        out, value.machineFragmentRootSha256)
    backend2AssemblerTempRecordString(
        out, value.riscvEncoderEventRootSha256)
    backend2AssemblerTempRecordString(out, value.abiIngressRootSha256)
    backend2AssemblerTempRecordString(out, value.receiptSha256)
    backend2AssemblerTempRecordActionEmissions(
        out, value.actionEmissions)

fn Backend2AssemblerEmissionRetained(
        value: var regprod.RegallocProductionFunctionEmission):
        Backend2AssemblerTempRetainedReport =
    var out: Backend2AssemblerTempRetainedReport
    backend2AssemblerTempRecordString(out, value.bodyIrSha256)
    backend2AssemblerTempRecordString(out, value.targetTriple)
    backend2AssemblerTempRecordString(out, value.recipeOrigin)
    backend2AssemblerTempRecordString(out, value.frozenSnapshotPayload)
    backend2AssemblerTempRecordString(
        out, value.frozenSnapshotPayloadSha256)
    backend2AssemblerTempRecordPlan(out, value.plan)
    backend2AssemblerTempRecordRecipes(out, value.recipes)
    backend2AssemblerTempRecordReceipt(out, value.receipt)
    backend2AssemblerTempRecordString(
        out, value.debugMachineFragmentRootSha256)
    backend2AssemblerTempRecordSequence(
        out, value.debugFragmentOpIds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.debugFragmentSyntheticKinds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.debugFragmentSiteKinds.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.debugFragmentSiteIndexes.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out,
        value.debugFragmentMachineOwnerKinds.cap,
        int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out,
        value.debugFragmentMachineOwnerOrdinals.cap,
        int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out,
        value.debugFragmentActionConsumerOrdinals.cap,
        int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.debugFragmentTextByteStarts.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.debugFragmentByteLengths.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordStrings(
        out, value.debugFragmentBytesSha256s)
    backend2AssemblerTempRecordSequence(
        out, value.deferFunctionRows.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out, value.deferStatementRows.cap, int64(sizeof(int32)))
    backend2AssemblerTempRecordSequence(
        out,
        value.deferActionCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    backend2AssemblerTempRecordSequence(
        out,
        value.deferFragmentCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    return out

fn backend2AssemblerTempReleaseRelocs(
        values: var contract.RegallocA64ActionReloc[]) =
    for index in 0..<values.len:
        backend2AssemblerTempDropOwnedString(
            values[index].targetSymbol)
    seqs.chengSeqFreeTyped(values)

fn backend2AssemblerTempReleaseActionEmissions(
        values: var alloc.RegallocValueActionEmission[]) =
    for index in 0..<values.len:
        backend2AssemblerTempDropOwnedString(
            values[index].emittedBytesSha256)
        backend2AssemblerTempDropOwnedString(
            values[index].ownerPlanSha256)
        backend2AssemblerTempDropOwnedString(
            values[index].emissionOwnerSha256)
        backend2AssemblerTempDropOwnedString(
            values[index].actionSemanticSha256)
        backend2AssemblerTempDropOwnedString(
            values[index].bindingSha256)
    seqs.chengSeqFreeTyped(values)

fn backend2AssemblerTempReleaseConstraints(
