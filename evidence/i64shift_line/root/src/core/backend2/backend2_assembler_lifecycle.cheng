        out: var Backend2AssemblerTempRetainedReport,
        value: var alloc.RegallocSinglePassValuePlan) =
    backend2AssemblerTempRecordString(out, value.bodyIrIngressSha256)
    backend2AssemblerTempRecordString(out, value.debugProvenanceSha256)
    backend2AssemblerTempRecordString(out, value.emissionSymbolName)
    backend2AssemblerTempRecordString(out, value.emissionSymbolBytesSha256)
    backend2AssemblerTempRecordString(out, value.frozenSemanticSha256)
    backend2AssemblerTempRecordString(out, value.actionSemanticRootSha256)
    backend2AssemblerTempRecordString(out, value.emissionOwnerSha256)
    backend2AssemblerTempRecordString(out, value.actionBindingRootSha256)
    backend2AssemblerTempRecordString(out, value.machineFragmentRootSha256)
