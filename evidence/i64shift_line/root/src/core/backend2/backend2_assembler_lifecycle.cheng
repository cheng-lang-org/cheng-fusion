    seqs.chengSeqFreeTyped(value.termRecipes)
    seqs.chengSeqFreeTyped(value.blockEmissionOrder)
    seqs.chengSeqFreeTyped(value.blockWordStarts)
    seqs.chengSeqFreeTyped(value.opWordStarts)
    seqs.chengSeqFreeTyped(value.opWordCounts)
    seqs.chengSeqFreeTyped(value.termWordStarts)
    seqs.chengSeqFreeTyped(value.termWordCounts)
    seqs.chengSeqFreeTyped(value.edgeSplitWordStarts)
    seqs.chengSeqFreeTyped(value.actionWordStarts)
    seqs.chengSeqFreeTyped(value.actionWordCounts)
    seqs.chengSeqFreeTyped(value.functionWords)
    backend2AssemblerTempReleaseRelocs(value.functionRelocs)
    seqs.chengSeqFreeTyped(value.encoderEventBuilder.wordRows)
    seqs.chengSeqFreeTyped(value.encoderEventBuilder.kinds)
    seqs.chengSeqFreeTyped(value.encoderEventBuilder.operandCounts)
    seqs.chengSeqFreeTyped(value.encoderEventBuilder.operand0s)
    seqs.chengSeqFreeTyped(value.encoderEventBuilder.operand1s)
    seqs.chengSeqFreeTyped(value.encoderEventBuilder.operand2s)
    seqs.chengSeqFreeTyped(value.encoderEventBuilder.operand3s)
    seqs.chengSeqFreeTyped(value.encoderEventBuilder.encodedWords)
    seqs.chengSeqFreeTyped(value.encoderEvents.kinds)
    seqs.chengSeqFreeTyped(value.encoderEvents.operandCounts)
    seqs.chengSeqFreeTyped(value.encoderEvents.operand0s)
    seqs.chengSeqFreeTyped(value.encoderEvents.operand1s)
    seqs.chengSeqFreeTyped(value.encoderEvents.operand2s)
    seqs.chengSeqFreeTyped(value.encoderEvents.operand3s)
    seqs.chengSeqFreeTyped(value.encoderEvents.encodedWords)
    value = contract.RegallocA64FunctionRecipes()

fn backend2AssemblerTempReleaseReceipt(
        value: var alloc.RegallocValueEmissionReceipt) =
    backend2AssemblerTempDropOwnedString(value.symbolName)
    backend2AssemblerTempDropOwnedString(value.symbolBytesSha256)
    backend2AssemblerTempDropOwnedString(value.debugProvenanceSha256)
    backend2AssemblerTempDropOwnedString(value.frozenSemanticSha256)
    backend2AssemblerTempDropOwnedString(
        value.actionSemanticRootSha256)
    backend2AssemblerTempDropOwnedString(
        value.actionBindingRootSha256)
    backend2AssemblerTempDropOwnedString(
        value.machineFragmentRootSha256)
    backend2AssemblerTempDropOwnedString(
        value.riscvEncoderEventRootSha256)
    backend2AssemblerTempDropOwnedString(value.abiIngressRootSha256)
    backend2AssemblerTempDropOwnedString(value.receiptSha256)
    backend2AssemblerTempReleaseActionEmissions(value.actionEmissions)
    value = alloc.RegallocValueEmissionReceipt()

fn Backend2AssemblerEmissionRelease(
        value: var regprod.RegallocProductionFunctionEmission) =
    backend2AssemblerTempDropOwnedString(value.bodyIrSha256)
    backend2AssemblerTempDropOwnedString(value.targetTriple)
    backend2AssemblerTempDropOwnedString(value.recipeOrigin)
    backend2AssemblerTempDropOwnedString(value.frozenSnapshotPayload)
    backend2AssemblerTempDropOwnedString(
        value.frozenSnapshotPayloadSha256)
    backend2AssemblerTempReleasePlan(value.plan)
    backend2AssemblerTempReleaseRecipes(value.recipes)
    backend2AssemblerTempReleaseReceipt(value.receipt)
    backend2AssemblerTempDropOwnedString(
        value.debugMachineFragmentRootSha256)
    seqs.chengSeqFreeTyped(value.debugFragmentOpIds)
    seqs.chengSeqFreeTyped(value.debugFragmentSyntheticKinds)
    seqs.chengSeqFreeTyped(value.debugFragmentSiteKinds)
    seqs.chengSeqFreeTyped(value.debugFragmentSiteIndexes)
    seqs.chengSeqFreeTyped(value.debugFragmentMachineOwnerKinds)
    seqs.chengSeqFreeTyped(value.debugFragmentMachineOwnerOrdinals)
    seqs.chengSeqFreeTyped(
        value.debugFragmentActionConsumerOrdinals)
    seqs.chengSeqFreeTyped(value.debugFragmentTextByteStarts)
    seqs.chengSeqFreeTyped(value.debugFragmentByteLengths)
    seqs.freeSeqStrRelease(value.debugFragmentBytesSha256s)
    seqs.chengSeqFreeTyped(value.deferFunctionRows)
    seqs.chengSeqFreeTyped(value.deferStatementRows)
    seqs.chengSeqFreeTyped(value.deferActionCids)
    seqs.chengSeqFreeTyped(value.deferFragmentCids)
    value = regprod.RegallocProductionFunctionEmission()

fn Backend2AssemblerEmissionStorageReleased(
        value: var regprod.RegallocProductionFunctionEmission): bool =
    let retained = Backend2AssemblerEmissionRetained(value)
    return retained.retainedBytes == int64(0) &&
           retained.physicalBufferCount == 0 &&
           retained.managedStringValueCount == 0 &&
           retained.managedStringBytes == int64(0)

fn backend2AssemblerTempAppendU32(
        bytes: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(bytes, value & 255)
    layout.ByteBufAppendByte(bytes, (value >> 8) & 255)
    layout.ByteBufAppendByte(bytes, (value >> 16) & 255)
    layout.ByteBufAppendByte(bytes, (value >> 24) & 255)

fn backend2AssemblerTempAppendI64(
        bytes: var layout.ByteBuf,
        value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(
        bytes, Int32(raw & UInt64(255)))
    layout.ByteBufAppendByte(
        bytes, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(
        bytes, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(
        bytes, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(
        bytes, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(
        bytes, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(
        bytes, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(
        bytes, Int32((raw >> UInt64(56)) & UInt64(255)))

@borrows
fn backend2AssemblerTempAppendText(
        bytes: var layout.ByteBuf,
        value: str) =
    backend2AssemblerTempAppendU32(bytes, len(value))
    for index in 0..<len(value):
        layout.ByteBufAppendByte(bytes, Int32(value[index]) & 255)

fn backend2AssemblerTempAppendStrings(
        bytes: var layout.ByteBuf,
        values: var str[]) =
    backend2AssemblerTempAppendU32(bytes, values.len)
    backend2AssemblerTempAppendU32(bytes, values.cap)
    for index in 0..<values.len:
        backend2AssemblerTempAppendText(bytes, values[index])

fn backend2AssemblerTempResolvedRetained(
        state: var Backend2AssemblerTempLifecycle):
        Backend2AssemblerTempRetainedReport =
    var out: Backend2AssemblerTempRetainedReport
    backend2AssemblerTempRecordStrings(
        out, state.resolvedCallTargets)
    backend2AssemblerTempRecordStrings(
        out, state.resolvedDataTargets)
    backend2AssemblerTempRecordStrings(
        out, state.resolvedCStringTargets)
    return out

fn backend2AssemblerTempResolvedOwnerToken(
        state: var Backend2AssemblerTempLifecycle):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(128)
    let domain = rawbytes.BytesFromString(
        "cheng.compiler.backend2.assembler.resolved.row")
    layout.ByteBufAppendBytes(bytes, domain)
    backend2AssemblerTempAppendU32(
        bytes, state.activeFunctionRow)
    backend2AssemblerTempAppendStrings(
        bytes, state.resolvedCallTargets)
    backend2AssemblerTempAppendStrings(
        bytes, state.resolvedDataTargets)
    backend2AssemblerTempAppendStrings(
        bytes, state.resolvedCStringTargets)
    let retained = backend2AssemblerTempResolvedRetained(state)
    backend2AssemblerTempAppendI64(bytes, retained.retainedBytes)
    backend2AssemblerTempAppendU32(
        bytes, retained.physicalBufferCount)
    backend2AssemblerTempAppendU32(
        bytes, retained.managedStringValueCount)
    backend2AssemblerTempAppendI64(
        bytes, retained.managedStringBytes)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn backend2AssemblerTempEmissionOwnerToken(
        state: var Backend2AssemblerTempLifecycle):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(256)
    let domain = rawbytes.BytesFromString(
        "cheng.compiler.backend2.assembler.emission.row")
    layout.ByteBufAppendBytes(bytes, domain)
    backend2AssemblerTempAppendU32(
        bytes, state.activeFunctionRow)
    backend2AssemblerTempAppendText(
        bytes, state.emission.bodyIrSha256)
    backend2AssemblerTempAppendText(
        bytes, state.emission.targetTriple)
    backend2AssemblerTempAppendText(
        bytes, state.emission.recipeOrigin)
    backend2AssemblerTempAppendText(
        bytes, state.emission.plan.sealedReceiptSha256)
    backend2AssemblerTempAppendText(
        bytes, state.emission.plan.actionSemanticRootSha256)
    backend2AssemblerTempAppendText(
        bytes, state.emission.plan.actionBindingRootSha256)
    backend2AssemblerTempAppendText(
        bytes, state.emission.plan.machineFragmentRootSha256)
    backend2AssemblerTempAppendText(
        bytes, state.emission.plan.abiIngressRootSha256)
    backend2AssemblerTempAppendText(
        bytes, state.emission.receipt.receiptSha256)
    backend2AssemblerTempAppendText(
        bytes, state.emission.debugMachineFragmentRootSha256)
    backend2AssemblerTempAppendU32(
        bytes, state.emission.publishedWordStart)
    backend2AssemblerTempAppendU32(
        bytes, state.emission.publishedWordCount)
    backend2AssemblerTempAppendU32(
        bytes, state.emission.publishedRelocStart)
    backend2AssemblerTempAppendU32(
        bytes, state.emission.publishedRelocCount)
    backend2AssemblerTempAppendU32(
        bytes, state.emission.plan.actions.len)
    backend2AssemblerTempAppendU32(
        bytes, state.emission.recipes.machineFragments.len)
    backend2AssemblerTempAppendU32(
        bytes, state.emission.receipt.actionEmissions.len)
    let retained = Backend2AssemblerEmissionRetained(state.emission)
    backend2AssemblerTempAppendI64(bytes, retained.retainedBytes)
    backend2AssemblerTempAppendU32(
        bytes, retained.physicalBufferCount)
    backend2AssemblerTempAppendU32(
        bytes, retained.managedStringValueCount)
    backend2AssemblerTempAppendI64(
        bytes, retained.managedStringBytes)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn backend2AssemblerTempAggregateOwnerToken(
        state: var Backend2AssemblerTempLifecycle):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(256)
    let domain = rawbytes.BytesFromString(
        "cheng.compiler.backend2.assembler.aggregate")
    layout.ByteBufAppendBytes(bytes, domain)
    backend2AssemblerTempAppendStrings(
        bytes, state.seenFunctionSymbols)
    backend2AssemblerTempAppendStrings(
        bytes, state.seenGlobalLabels)
    backend2AssemblerTempAppendStrings(
        bytes, state.seenDataLabels)
    backend2AssemblerTempAppendStrings(
        bytes, state.seenGlobalSlotNames)
    backend2AssemblerTempAppendStrings(
        bytes, state.seenGlobalPayloadTexts)
    backend2AssemblerTempAppendU32(
        bytes, state.seenGlobalPayloadByteCounts.len)
    backend2AssemblerTempAppendU32(
        bytes, state.seenGlobalPayloadByteCounts.cap)
    for index in 0..<state.seenGlobalPayloadByteCounts.len:
        backend2AssemblerTempAppendU32(
            bytes, state.seenGlobalPayloadByteCounts[index])
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn Backend2AssemblerTempLifecycleBeginInvocation(
        state: var Backend2AssemblerTempLifecycle) =
    if state.phase != Backend2AssemblerTempPhaseEmpty ||
       state.terminalReceiptConsumed:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid begin")
    lifetime.LifetimeLedgerInit(state.ledger)
    state.resolvedCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            state.ledger, "backend2_assembler_resolved_targets")
    state.emissionCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            state.ledger, "backend2_assembler_regalloc_emission")
    state.aggregateBufferCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            state.ledger, "backend2_assembler_seen_buffer")
    state.aggregateStringCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            state.ledger, "backend2_assembler_seen_string")
    state.allSymbolBufferCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            state.ledger, "backend2_pipeline_all_symbol_buffer")
    state.allSymbolStringCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            state.ledger, "backend2_pipeline_all_symbol_string")
    state.workerBufferCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            state.ledger, "backend2_pipeline_worker_buffer")
    state.resolverOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "backend2_resolver")
    state.emitterOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "backend2_regalloc_emitter")
    state.publisherOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "backend2_plan_publisher")
    state.aggregateOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "backend2_assembler_aggregate")
    state.pipelineOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "backend2_pipeline")
    state.assemblerInputOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "backend2_assembler_input")
    state.workerSchedulerOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "backend2_worker_scheduler")
    state.workerReceiverOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "backend2_worker_receiver")
    state.phase = Backend2AssemblerTempPhaseInvocation

fn Backend2AssemblerTempLifecycleBeginRow(
        state: var Backend2AssemblerTempLifecycle,
        functionRow: int32) =
    if state.phase != Backend2AssemblerTempPhaseInvocation ||
       functionRow < 0 ||
       state.activeFunctionRow >= 0:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid row begin")
    state.activeFunctionRow = functionRow

fn Backend2AssemblerTempLifecycleBindResolved(
        state: var Backend2AssemblerTempLifecycle) =
    if state.phase != Backend2AssemblerTempPhaseInvocation ||
       state.activeFunctionRow < 0 ||
       state.resolvedObjectId != 0:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid resolved bind")
    state.resolvedRetained =
        backend2AssemblerTempResolvedRetained(state)
    state.observedPhysicalBufferCount =
        state.observedPhysicalBufferCount +
            int64(state.resolvedRetained.physicalBufferCount)
    backend2AssemblerTempCheckedAdd(
        state.observedPhysicalBytes,
        state.resolvedRetained.retainedBytes -
            state.resolvedRetained.managedStringBytes)
    state.resolvedOwnerToken =
        backend2AssemblerTempResolvedOwnerToken(state)
    if state.resolvedRetained.retainedBytes > int64(0):
        state.resolvedObjectId =
            lifetime.LifetimeLedgerReserveObject(
                state.ledger,
                state.resolvedCategoryId,
                state.resolvedRetained.retainedBytes)
        lifetime.LifetimeLedgerOwn(
            state.ledger,
            state.resolvedObjectId,
            state.resolverOwnerId)
    state.phase = Backend2AssemblerTempPhaseResolved

fn Backend2AssemblerTempLifecycleAttachEmission(
        state: var Backend2AssemblerTempLifecycle) =
    if state.phase == Backend2AssemblerTempPhaseInvocation:
        Backend2AssemblerTempLifecycleBindResolved(state)
    if state.phase != Backend2AssemblerTempPhaseResolved ||
       state.activeFunctionRow < 0 ||
       state.emissionObjectId != 0:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid emission attach")
    if !regprod.RegallocProductionEmissionPublishedPayloadExact(
           state.emission):
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid published payload range")
    state.emissionRetained =
        Backend2AssemblerEmissionRetained(state.emission)
    state.observedPhysicalBufferCount =
        state.observedPhysicalBufferCount +
            int64(state.emissionRetained.physicalBufferCount)
    backend2AssemblerTempCheckedAdd(
        state.observedPhysicalBytes,
        state.emissionRetained.retainedBytes -
            state.emissionRetained.managedStringBytes)
    state.emissionOwnerToken =
        backend2AssemblerTempEmissionOwnerToken(state)
    if state.resolvedObjectId > 0:
        lifetime.LifetimeLedgerMove(
            state.ledger,
            state.resolvedObjectId,
            state.resolverOwnerId,
            state.emitterOwnerId)
    if state.emissionRetained.retainedBytes > int64(0):
        state.emissionObjectId =
            lifetime.LifetimeLedgerReserveObject(
                state.ledger,
                state.emissionCategoryId,
                state.emissionRetained.retainedBytes)
        lifetime.LifetimeLedgerOwn(
            state.ledger,
            state.emissionObjectId,
            state.emitterOwnerId)
    state.phase = Backend2AssemblerTempPhaseEmission

fn Backend2AssemblerTempLifecycleMoveToPublisher(
        state: var Backend2AssemblerTempLifecycle) =
    if state.phase != Backend2AssemblerTempPhaseEmission ||
       state.activeFunctionRow < 0:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid publisher move")
    if state.resolvedObjectId > 0:
        lifetime.LifetimeLedgerMove(
            state.ledger,
            state.resolvedObjectId,
            state.emitterOwnerId,
            state.publisherOwnerId)
    if state.emissionObjectId > 0:
        lifetime.LifetimeLedgerMove(
            state.ledger,
            state.emissionObjectId,
            state.emitterOwnerId,
            state.publisherOwnerId)
    state.phase = Backend2AssemblerTempPhasePublished

fn backend2AssemblerTempRowStorageReleased(
        state: var Backend2AssemblerTempLifecycle): bool =
    return state.resolvedCallTargets.len == 0 &&
           state.resolvedCallTargets.cap == 0 &&
           state.resolvedDataTargets.len == 0 &&
           state.resolvedDataTargets.cap == 0 &&
           state.resolvedCStringTargets.len == 0 &&
           state.resolvedCStringTargets.cap == 0 &&
           Backend2AssemblerEmissionStorageReleased(state.emission)

fn Backend2AssemblerTempLifecycleReleaseRow(
        state: var Backend2AssemblerTempLifecycle,
        success: bool) =
    if state.activeFunctionRow < 0 ||
       state.phase < Backend2AssemblerTempPhaseInvocation ||
       state.phase > Backend2AssemblerTempPhasePublished:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid row release")
    if state.phase == Backend2AssemblerTempPhaseInvocation:
        Backend2AssemblerTempLifecycleBindResolved(state)
    if !layout.FixedBytes32Equal(
           backend2AssemblerTempResolvedOwnerToken(state),
           state.resolvedOwnerToken):
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: resolved identity changed")
    if state.phase >= Backend2AssemblerTempPhaseEmission &&
       !layout.FixedBytes32Equal(
           backend2AssemblerTempEmissionOwnerToken(state),
           state.emissionOwnerToken):
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: emission identity changed")
    let resolvedNow = backend2AssemblerTempResolvedRetained(state)
    if resolvedNow.retainedBytes != state.resolvedRetained.retainedBytes ||
       resolvedNow.physicalBufferCount !=
           state.resolvedRetained.physicalBufferCount ||
       resolvedNow.managedStringValueCount !=
           state.resolvedRetained.managedStringValueCount ||
       resolvedNow.managedStringBytes !=
           state.resolvedRetained.managedStringBytes:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: resolved storage changed")
    var emissionAttached =
        state.phase >= Backend2AssemblerTempPhaseEmission
    if !emissionAttached &&
       !Backend2AssemblerEmissionStorageReleased(state.emission):
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: unbound emission payload")
    if emissionAttached:
        let emissionNow =
            Backend2AssemblerEmissionRetained(state.emission)
        if emissionNow.retainedBytes !=
               state.emissionRetained.retainedBytes ||
           emissionNow.physicalBufferCount !=
               state.emissionRetained.physicalBufferCount ||
           emissionNow.managedStringValueCount !=
               state.emissionRetained.managedStringValueCount ||
           emissionNow.managedStringBytes !=
               state.emissionRetained.managedStringBytes:
            backend2AssemblerTempFail(
                "backend2 assembler temp lifecycle: emission storage changed")

    seqs.freeSeqStrRelease(state.resolvedCallTargets)
    seqs.freeSeqStrRelease(state.resolvedDataTargets)
    seqs.freeSeqStrRelease(state.resolvedCStringTargets)
    if emissionAttached:
        Backend2AssemblerEmissionRelease(state.emission)
    if !backend2AssemblerTempRowStorageReleased(state):
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: row physical release incomplete")

    state.releasedPhysicalBufferCount =
        state.releasedPhysicalBufferCount +
            state.resolvedRetained.physicalBufferCount
    backend2AssemblerTempCheckedAdd(
        state.releasedPhysicalBytes,
        state.resolvedRetained.retainedBytes -
            state.resolvedRetained.managedStringBytes)
    state.releasedManagedStringValueCount =
        state.releasedManagedStringValueCount +
            state.resolvedRetained.managedStringValueCount
    backend2AssemblerTempCheckedAdd(
        state.releasedManagedStringBytes,
        state.resolvedRetained.managedStringBytes)
    if emissionAttached:
        state.releasedPhysicalBufferCount =
            state.releasedPhysicalBufferCount +
                state.emissionRetained.physicalBufferCount
        backend2AssemblerTempCheckedAdd(
            state.releasedPhysicalBytes,
            state.emissionRetained.retainedBytes -
                state.emissionRetained.managedStringBytes)
        state.releasedManagedStringValueCount =
            state.releasedManagedStringValueCount +
                state.emissionRetained.managedStringValueCount
        backend2AssemblerTempCheckedAdd(
            state.releasedManagedStringBytes,
            state.emissionRetained.managedStringBytes)

    var releasingOwner = state.resolverOwnerId
    if state.phase == Backend2AssemblerTempPhaseEmission:
        releasingOwner = state.emitterOwnerId
    elif state.phase == Backend2AssemblerTempPhasePublished:
        releasingOwner = state.publisherOwnerId
    if state.resolvedObjectId > 0:
        lifetime.LifetimeLedgerRelease(
            state.ledger,
            state.resolvedObjectId,
            releasingOwner)
    if state.emissionObjectId > 0:
        lifetime.LifetimeLedgerRelease(
            state.ledger,
            state.emissionObjectId,
            releasingOwner)
    if success:
        state.completedFunctionCount =
            state.completedFunctionCount + 1
    else:
        state.failedFunctionCount =
            state.failedFunctionCount + 1
    state.activeFunctionRow = -1
    state.resolvedObjectId = 0
    state.emissionObjectId = 0
    state.resolvedOwnerToken = layout.FixedBytes32()
    state.emissionOwnerToken = layout.FixedBytes32()
    state.resolvedRetained = Backend2AssemblerTempRetainedReport()
    state.emissionRetained = Backend2AssemblerTempRetainedReport()
    state.emission = regprod.RegallocProductionFunctionEmission()
    state.phase = Backend2AssemblerTempPhaseInvocation

fn backend2AssemblerTempTrackBufferResize(
        state: var Backend2AssemblerTempLifecycle,
        oldCapacity: int32,
        newCapacity: int32,
        elementBytes: int64,
        categoryId: int32,
        ownerId: int32,
        objectId: int32): int32 =
    if newCapacity == oldCapacity:
        return objectId
    if oldCapacity < 0 || newCapacity <= oldCapacity ||
       elementBytes <= int64(0):
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid aggregate resize")
    if objectId > 0:
        let oldBytes = int64(oldCapacity) * elementBytes
        lifetime.LifetimeLedgerRelease(
            state.ledger, objectId, ownerId)
        state.releasedPhysicalBufferCount =
            state.releasedPhysicalBufferCount + 1
        backend2AssemblerTempCheckedAdd(
            state.releasedPhysicalBytes, oldBytes)
    let newObjectId = lifetime.LifetimeLedgerReserveObject(
        state.ledger,
        categoryId,
        int64(newCapacity) * elementBytes)
    lifetime.LifetimeLedgerOwn(
        state.ledger, newObjectId, ownerId)
    state.observedPhysicalBufferCount =
        state.observedPhysicalBufferCount + int64(1)
    backend2AssemblerTempCheckedAdd(
        state.observedPhysicalBytes,
        int64(newCapacity) * elementBytes)
    return newObjectId

fn backend2AssemblerTempTrackAggregateResize(
        state: var Backend2AssemblerTempLifecycle,
        oldCapacity: int32,
        newCapacity: int32,
        elementBytes: int64,
        objectId: int32): int32 =
    return backend2AssemblerTempTrackBufferResize(
        state,
        oldCapacity,
        newCapacity,
        elementBytes,
        state.aggregateBufferCategoryId,
        state.aggregateOwnerId,
        objectId)

@borrows
fn backend2AssemblerTempOwnAggregateString(
        state: var Backend2AssemblerTempLifecycle,
        value: str) =
    if len(value) <= 0:
        return
    let objectId = lifetime.LifetimeLedgerReserveObject(
        state.ledger,
        state.aggregateStringCategoryId,
        int64(len(value)))
    lifetime.LifetimeLedgerOwn(
        state.ledger, objectId, state.aggregateOwnerId)

@borrows
fn Backend2AssemblerTempAppendSeenFunctionSymbol(
        state: var Backend2AssemblerTempLifecycle,
        value: str) =
    let oldCapacity = state.seenFunctionSymbols.cap
    add(state.seenFunctionSymbols,
        system.NewStringCopy(system.StrDataPtr(value), len(value)))
    state.seenFunctionSymbolsBufferObjectId =
        backend2AssemblerTempTrackAggregateResize(
        state,
        oldCapacity,
        state.seenFunctionSymbols.cap,
        int64(sizeof(str)),
        state.seenFunctionSymbolsBufferObjectId)
    backend2AssemblerTempOwnAggregateString(state, value)

@borrows
fn Backend2AssemblerTempAppendSeenGlobalLabel(
        state: var Backend2AssemblerTempLifecycle,
        value: str) =
    let oldCapacity = state.seenGlobalLabels.cap
    add(state.seenGlobalLabels,
        system.NewStringCopy(system.StrDataPtr(value), len(value)))
    state.seenGlobalLabelsBufferObjectId =
        backend2AssemblerTempTrackAggregateResize(
        state,
        oldCapacity,
        state.seenGlobalLabels.cap,
        int64(sizeof(str)),
        state.seenGlobalLabelsBufferObjectId)
    backend2AssemblerTempOwnAggregateString(state, value)

@borrows
fn Backend2AssemblerTempAppendSeenDataLabel(
        state: var Backend2AssemblerTempLifecycle,
        value: str) =
    let oldCapacity = state.seenDataLabels.cap
    add(state.seenDataLabels,
        system.NewStringCopy(system.StrDataPtr(value), len(value)))
    state.seenDataLabelsBufferObjectId =
        backend2AssemblerTempTrackAggregateResize(
        state,
        oldCapacity,
        state.seenDataLabels.cap,
        int64(sizeof(str)),
        state.seenDataLabelsBufferObjectId)
    backend2AssemblerTempOwnAggregateString(state, value)

@borrows
fn Backend2AssemblerTempAppendSeenGlobalSlotName(
        state: var Backend2AssemblerTempLifecycle,
        value: str) =
    let oldCapacity = state.seenGlobalSlotNames.cap
    add(state.seenGlobalSlotNames,
        system.NewStringCopy(system.StrDataPtr(value), len(value)))
    state.seenGlobalSlotNamesBufferObjectId =
        backend2AssemblerTempTrackAggregateResize(
        state,
        oldCapacity,
        state.seenGlobalSlotNames.cap,
        int64(sizeof(str)),
        state.seenGlobalSlotNamesBufferObjectId)
    backend2AssemblerTempOwnAggregateString(state, value)

@borrows
fn Backend2AssemblerTempAppendSeenGlobalPayloadText(
        state: var Backend2AssemblerTempLifecycle,
        value: str) =
    let oldCapacity = state.seenGlobalPayloadTexts.cap
    add(state.seenGlobalPayloadTexts,
        system.NewStringCopy(system.StrDataPtr(value), len(value)))
    state.seenGlobalPayloadTextsBufferObjectId =
        backend2AssemblerTempTrackAggregateResize(
        state,
        oldCapacity,
        state.seenGlobalPayloadTexts.cap,
        int64(sizeof(str)),
        state.seenGlobalPayloadTextsBufferObjectId)
    backend2AssemblerTempOwnAggregateString(state, value)

fn Backend2AssemblerTempAppendSeenGlobalPayloadByteCount(
        state: var Backend2AssemblerTempLifecycle,
        value: int32) =
    let oldCapacity = state.seenGlobalPayloadByteCounts.cap
    add(state.seenGlobalPayloadByteCounts, value)
    state.seenGlobalPayloadByteCountsBufferObjectId =
        backend2AssemblerTempTrackAggregateResize(
        state,
        oldCapacity,
        state.seenGlobalPayloadByteCounts.cap,
        int64(sizeof(int32)),
        state.seenGlobalPayloadByteCountsBufferObjectId)

fn backend2AssemblerAllSymbolOwnerToken(
        state: var Backend2AssemblerTempLifecycle):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(256)
    let domain = rawbytes.BytesFromString(
        "cheng.compiler.backend2.pipeline.all-symbols")
    layout.ByteBufAppendBytes(bytes, domain)
    backend2AssemblerTempAppendStrings(bytes, state.allSymbolNames)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn backend2AssemblerWorkerOwnerToken(
        state: var Backend2AssemblerTempLifecycle):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(128)
    let domain = rawbytes.BytesFromString(
        "cheng.compiler.backend2.pipeline.worker-endpoints")
    layout.ByteBufAppendBytes(bytes, domain)
    backend2AssemblerTempAppendU32(bytes, state.workerPids.len)
    backend2AssemblerTempAppendU32(bytes, state.workerPids.cap)
    backend2AssemblerTempAppendU32(bytes, state.workerReadFds.len)
    backend2AssemblerTempAppendU32(bytes, state.workerReadFds.cap)
    for row in 0..<state.workerPids.len:
        backend2AssemblerTempAppendU32(bytes, row)
        backend2AssemblerTempAppendU32(
            bytes, state.workerPids[row])
        backend2AssemblerTempAppendU32(
            bytes, state.workerReadFds[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn Backend2AssemblerLifecycleAppendAllSymbolName(
        state: var Backend2AssemblerTempLifecycle,
        value: str) =
    if state.phase != Backend2AssemblerTempPhaseInvocation ||
       state.allSymbolsMovedToAssembler ||
       value == "":
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: invalid all-symbol append")
    let oldCapacity = state.allSymbolNames.cap
    add(state.allSymbolNames,
        system.NewStringCopy(system.StrDataPtr(value), len(value)))
    state.allSymbolNamesBufferObjectId =
        backend2AssemblerTempTrackBufferResize(
        state,
        oldCapacity,
        state.allSymbolNames.cap,
        int64(sizeof(str)),
        state.allSymbolBufferCategoryId,
        state.pipelineOwnerId,
        state.allSymbolNamesBufferObjectId)
    let objectId = lifetime.LifetimeLedgerReserveObject(
        state.ledger,
        state.allSymbolStringCategoryId,
        int64(len(value)))
    lifetime.LifetimeLedgerOwn(
        state.ledger, objectId, state.pipelineOwnerId)

fn Backend2AssemblerLifecycleAppendWorkerEndpoint(
        state: var Backend2AssemblerTempLifecycle,
        pid: int32,
        readFd: int32) =
    if state.phase != Backend2AssemblerTempPhaseInvocation ||
       state.workerArraysBound ||
       state.workerArraysMovedToReceiver ||
       pid <= 0 ||
       readFd < 0:
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: invalid worker endpoint")
    let oldPidCapacity = state.workerPids.cap
    let oldFdCapacity = state.workerReadFds.cap
    add(state.workerPids, pid)
    add(state.workerReadFds, readFd)
    state.workerPidsBufferObjectId =
        backend2AssemblerTempTrackBufferResize(
        state,
        oldPidCapacity,
        state.workerPids.cap,
        int64(sizeof(int32)),
        state.workerBufferCategoryId,
        state.workerSchedulerOwnerId,
        state.workerPidsBufferObjectId)
    state.workerReadFdsBufferObjectId =
        backend2AssemblerTempTrackBufferResize(
        state,
        oldFdCapacity,
        state.workerReadFds.cap,
        int64(sizeof(int32)),
        state.workerBufferCategoryId,
        state.workerSchedulerOwnerId,
        state.workerReadFdsBufferObjectId)

fn Backend2AssemblerLifecycleBindWorkerArrays(
        state: var Backend2AssemblerTempLifecycle) =
    if state.phase != Backend2AssemblerTempPhaseInvocation ||
       state.workerArraysBound ||
       state.workerArraysMovedToReceiver ||
       state.workerPids.len <= 0 ||
       state.workerPids.len != state.workerReadFds.len:
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: invalid worker bind")
    state.workerOwnerToken =
        backend2AssemblerWorkerOwnerToken(state)
    state.workerArraysBound = true

fn Backend2AssemblerLifecycleMoveWorkerArraysToReceiver(
        state: var Backend2AssemblerTempLifecycle) =
    if !state.workerArraysBound:
        Backend2AssemblerLifecycleBindWorkerArrays(state)
    if state.workerArraysMovedToReceiver:
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: duplicate worker move")
    if state.workerPidsBufferObjectId > 0:
        lifetime.LifetimeLedgerMove(
            state.ledger,
            state.workerPidsBufferObjectId,
            state.workerSchedulerOwnerId,
            state.workerReceiverOwnerId)
    if state.workerReadFdsBufferObjectId > 0:
        lifetime.LifetimeLedgerMove(
            state.ledger,
            state.workerReadFdsBufferObjectId,
            state.workerSchedulerOwnerId,
            state.workerReceiverOwnerId)
    state.workerArraysMovedToReceiver = true

fn Backend2AssemblerLifecycleReleaseWorkerArrays(
        state: var Backend2AssemblerTempLifecycle,
        endpointsClosedAndReaped: bool) =
    if !state.workerArraysBound ||
       state.workerArraysReleased ||
       !layout.FixedBytes32Equal(
           backend2AssemblerWorkerOwnerToken(state),
           state.workerOwnerToken):
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: invalid worker release")
    let pidCapacity = state.workerPids.cap
    let fdCapacity = state.workerReadFds.cap
    seqs.chengSeqFreeTyped(state.workerPids)
    seqs.chengSeqFreeTyped(state.workerReadFds)
    var ownerId = state.workerSchedulerOwnerId
    if state.workerArraysMovedToReceiver:
        ownerId = state.workerReceiverOwnerId
    if state.workerPidsBufferObjectId > 0:
        lifetime.LifetimeLedgerRelease(
            state.ledger,
            state.workerPidsBufferObjectId,
            ownerId)
        state.releasedPhysicalBufferCount =
            state.releasedPhysicalBufferCount + 1
        backend2AssemblerTempCheckedAdd(
            state.releasedPhysicalBytes,
            int64(pidCapacity) * int64(sizeof(int32)))
        state.workerPidsBufferObjectId = 0
    if state.workerReadFdsBufferObjectId > 0:
        lifetime.LifetimeLedgerRelease(
            state.ledger,
            state.workerReadFdsBufferObjectId,
            ownerId)
        state.releasedPhysicalBufferCount =
            state.releasedPhysicalBufferCount + 1
        backend2AssemblerTempCheckedAdd(
            state.releasedPhysicalBytes,
            int64(fdCapacity) * int64(sizeof(int32)))
        state.workerReadFdsBufferObjectId = 0
    state.workerArraysReleased = true
    state.workerEndpointsClosedAndReaped =
        endpointsClosedAndReaped

fn Backend2AssemblerLifecycleMoveAllSymbolsToAssembler(
        state: var Backend2AssemblerTempLifecycle) =
    if state.phase != Backend2AssemblerTempPhaseInvocation ||
       state.allSymbolsMovedToAssembler:
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: invalid all-symbol move")
    state.allSymbolOwnerToken =
        backend2AssemblerAllSymbolOwnerToken(state)
    if state.allSymbolNamesBufferObjectId > 0:
        lifetime.LifetimeLedgerMove(
            state.ledger,
            state.allSymbolNamesBufferObjectId,
            state.pipelineOwnerId,
            state.assemblerInputOwnerId)
    for objectIndex in 0..<state.ledger.objects.len:
        let object = state.ledger.objects[objectIndex]
        if object.state == lifetime.LifetimeLedgerStateOwned &&
           object.categoryId == state.allSymbolStringCategoryId:
            lifetime.LifetimeLedgerMove(
                state.ledger,
                object.objectId,
                state.pipelineOwnerId,
                state.assemblerInputOwnerId)
    state.allSymbolsMovedToAssembler = true

fn backend2AssemblerAllSymbolStorageReleased(
        state: var Backend2AssemblerTempLifecycle): bool =
    return state.allSymbolNames.len == 0 &&
           state.allSymbolNames.cap == 0 &&
           state.allSymbolNamesBufferObjectId == 0

fn backend2AssemblerWorkerStorageReleased(
        state: var Backend2AssemblerTempLifecycle): bool =
    return state.workerPids.len == 0 &&
           state.workerPids.cap == 0 &&
           state.workerReadFds.len == 0 &&
           state.workerReadFds.cap == 0 &&
           state.workerPidsBufferObjectId == 0 &&
           state.workerReadFdsBufferObjectId == 0 &&
           (!state.workerArraysBound ||
            state.workerArraysReleased)

fn backend2AssemblerReleaseAllSymbols(
        state: var Backend2AssemblerTempLifecycle) =
    let currentToken =
        backend2AssemblerAllSymbolOwnerToken(state)
    if layout.FixedBytes32Equal(
           state.allSymbolOwnerToken,
           layout.FixedBytes32()):
        state.allSymbolOwnerToken = currentToken
    elif !layout.FixedBytes32Equal(
             currentToken, state.allSymbolOwnerToken):
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: all-symbol identity changed")
    var ownerId = state.pipelineOwnerId
    if state.allSymbolsMovedToAssembler:
        ownerId = state.assemblerInputOwnerId
    for objectIndex in 0..<state.ledger.objects.len:
        let object = state.ledger.objects[objectIndex]
        if object.state == lifetime.LifetimeLedgerStateOwned &&
           object.categoryId == state.allSymbolStringCategoryId:
            lifetime.LifetimeLedgerRelease(
                state.ledger, object.objectId, ownerId)
            state.releasedManagedStringValueCount =
                state.releasedManagedStringValueCount + 1
            backend2AssemblerTempCheckedAdd(
                state.releasedManagedStringBytes,
                object.byteCount)
    let symbolCapacity = state.allSymbolNames.cap
    seqs.freeSeqStrRelease(state.allSymbolNames)
    if state.allSymbolNamesBufferObjectId > 0:
        lifetime.LifetimeLedgerRelease(
            state.ledger,
            state.allSymbolNamesBufferObjectId,
            ownerId)
        state.releasedPhysicalBufferCount =
            state.releasedPhysicalBufferCount + 1
        backend2AssemblerTempCheckedAdd(
            state.releasedPhysicalBytes,
            int64(symbolCapacity) * int64(sizeof(str)))
        state.allSymbolNamesBufferObjectId = 0
    if !backend2AssemblerAllSymbolStorageReleased(state):
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: all-symbol release incomplete")

fn backend2AssemblerTempReleaseAggregateBuffer(
        state: var Backend2AssemblerTempLifecycle,
        objectId: int32,
        capacity: int32,
        elementBytes: int64) =
    if objectId <= 0:
        if capacity != 0:
            backend2AssemblerTempFail(
                "backend2 assembler temp lifecycle: untracked aggregate buffer")
        return
    lifetime.LifetimeLedgerRelease(
        state.ledger, objectId, state.aggregateOwnerId)
    state.releasedPhysicalBufferCount =
        state.releasedPhysicalBufferCount + 1
    backend2AssemblerTempCheckedAdd(
        state.releasedPhysicalBytes,
        int64(capacity) * elementBytes)

fn backend2AssemblerTempAggregateStorageReleased(
        state: var Backend2AssemblerTempLifecycle): bool =
    return state.seenFunctionSymbols.len == 0 &&
           state.seenFunctionSymbols.cap == 0 &&
           state.seenGlobalLabels.len == 0 &&
           state.seenGlobalLabels.cap == 0 &&
           state.seenDataLabels.len == 0 &&
           state.seenDataLabels.cap == 0 &&
           state.seenGlobalSlotNames.len == 0 &&
           state.seenGlobalSlotNames.cap == 0 &&
           state.seenGlobalPayloadTexts.len == 0 &&
           state.seenGlobalPayloadTexts.cap == 0 &&
           state.seenGlobalPayloadByteCounts.len == 0 &&
           state.seenGlobalPayloadByteCounts.cap == 0

fn backend2AssemblerTempReleaseAggregate(
        state: var Backend2AssemblerTempLifecycle) =
    state.aggregateOwnerToken =
        backend2AssemblerTempAggregateOwnerToken(state)
    let functionCapacity = state.seenFunctionSymbols.cap
    let globalCapacity = state.seenGlobalLabels.cap
    let dataCapacity = state.seenDataLabels.cap
    let slotCapacity = state.seenGlobalSlotNames.cap
    let payloadCapacity = state.seenGlobalPayloadTexts.cap
    let byteCountCapacity =
        state.seenGlobalPayloadByteCounts.cap
    for objectIndex in 0..<state.ledger.objects.len:
        let object = state.ledger.objects[objectIndex]
        if object.state == lifetime.LifetimeLedgerStateOwned &&
           object.categoryId == state.aggregateStringCategoryId:
            lifetime.LifetimeLedgerRelease(
                state.ledger,
                object.objectId,
                state.aggregateOwnerId)
            state.releasedManagedStringValueCount =
                state.releasedManagedStringValueCount + 1
            backend2AssemblerTempCheckedAdd(
                state.releasedManagedStringBytes,
                object.byteCount)
    seqs.freeSeqStrRelease(state.seenFunctionSymbols)
    seqs.freeSeqStrRelease(state.seenGlobalLabels)
    seqs.freeSeqStrRelease(state.seenDataLabels)
    seqs.freeSeqStrRelease(state.seenGlobalSlotNames)
    seqs.freeSeqStrRelease(state.seenGlobalPayloadTexts)
    seqs.chengSeqFreeTyped(state.seenGlobalPayloadByteCounts)
    backend2AssemblerTempReleaseAggregateBuffer(
        state,
        state.seenFunctionSymbolsBufferObjectId,
        functionCapacity,
        int64(sizeof(str)))
    state.seenFunctionSymbolsBufferObjectId = 0
    backend2AssemblerTempReleaseAggregateBuffer(
        state,
        state.seenGlobalLabelsBufferObjectId,
        globalCapacity,
        int64(sizeof(str)))
    state.seenGlobalLabelsBufferObjectId = 0
    backend2AssemblerTempReleaseAggregateBuffer(
        state,
        state.seenDataLabelsBufferObjectId,
        dataCapacity,
        int64(sizeof(str)))
    state.seenDataLabelsBufferObjectId = 0
    backend2AssemblerTempReleaseAggregateBuffer(
        state,
        state.seenGlobalSlotNamesBufferObjectId,
        slotCapacity,
        int64(sizeof(str)))
    state.seenGlobalSlotNamesBufferObjectId = 0
    backend2AssemblerTempReleaseAggregateBuffer(
        state,
        state.seenGlobalPayloadTextsBufferObjectId,
        payloadCapacity,
        int64(sizeof(str)))
    state.seenGlobalPayloadTextsBufferObjectId = 0
    backend2AssemblerTempReleaseAggregateBuffer(
        state,
        state.seenGlobalPayloadByteCountsBufferObjectId,
        byteCountCapacity,
        int64(sizeof(int32)))
    state.seenGlobalPayloadByteCountsBufferObjectId = 0
    if !backend2AssemblerTempAggregateStorageReleased(state):
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: aggregate physical release incomplete")

fn backend2AssemblerTempOutcomeValid(outcome: int32): bool =
    return outcome == Backend2AssemblerTempOutcomeSuccess ||
           outcome == Backend2AssemblerTempOutcomeFailure

fn Backend2AssemblerTempLifecycleFinalizeStrictInto(
        state: var Backend2AssemblerTempLifecycle,
        outcome: int32,
        receipt: var Backend2AssemblerTempReleaseReceipt,
        err: var str): bool =
    err = ""
    if !backend2AssemblerTempOutcomeValid(outcome) ||
       state.terminalReceiptConsumed ||
       state.phase < Backend2AssemblerTempPhaseInvocation ||
       state.phase >= Backend2AssemblerTempPhaseReleased:
        backend2AssemblerTempFail(
            "backend2 assembler temp lifecycle: invalid finalization")
    if state.activeFunctionRow >= 0:
        Backend2AssemblerTempLifecycleReleaseRow(
            state, false)
    if state.workerArraysBound &&
       !state.workerArraysReleased:
        backend2AssemblerTempFail(
            "backend2 assembler lifecycle: live worker endpoints at finalization")
    backend2AssemblerReleaseAllSymbols(state)
    backend2AssemblerTempReleaseAggregate(state)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.resolverOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.emitterOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.publisherOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.aggregateOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.pipelineOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.assemblerInputOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.workerSchedulerOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.workerReceiverOwnerId)
    lifetime.LifetimeLedgerAssertClosed(state.ledger)
    var metrics: lifetime.LifetimeLedgerMetrics
    lifetime.LifetimeLedgerReadTotalMetrics(state.ledger, metrics)
    receipt.aggregateOwnerToken = state.aggregateOwnerToken
    receipt.allSymbolOwnerToken = state.allSymbolOwnerToken
    receipt.workerOwnerToken = state.workerOwnerToken
    receipt.outcome = outcome
    receipt.completedFunctionCount =
        state.completedFunctionCount
    receipt.failedFunctionCount = state.failedFunctionCount
    receipt.allocated = metrics.allocated
    receipt.released = metrics.released
    receipt.live = metrics.live
    receipt.allocatedBytes = metrics.allocatedBytes
    receipt.releasedBytes = metrics.releasedBytes
    receipt.liveBytes = metrics.liveBytes
    receipt.ownerTransferCount = metrics.ownerTransferCount
    receipt.physicalBufferCount =
        state.observedPhysicalBufferCount
    receipt.physicalBytes =
        state.observedPhysicalBytes
    receipt.releasedPhysicalBufferCount =
        state.releasedPhysicalBufferCount
    receipt.releasedPhysicalBytes =
        state.releasedPhysicalBytes
    receipt.releasedManagedStringValueCount =
        state.releasedManagedStringValueCount
    receipt.releasedManagedStringBytes =
        state.releasedManagedStringBytes
    receipt.rowStorageReleased =
        backend2AssemblerTempRowStorageReleased(state)
    receipt.aggregateStorageReleased =
        backend2AssemblerTempAggregateStorageReleased(state)
    receipt.allSymbolStorageReleased =
        backend2AssemblerAllSymbolStorageReleased(state)
    receipt.workerStorageReleased =
        backend2AssemblerWorkerStorageReleased(state)
    receipt.workerEndpointsClosedAndReaped =
        !state.workerArraysBound ||
        state.workerEndpointsClosedAndReaped
    let ledgerStorageRelease =
        lifetime.LifetimeLedgerReleaseStorage(state.ledger)
    receipt.ledgerStorageReleased =
        ledgerStorageRelease.storageReleased
    receipt.ledgerStorageReleasedSequenceCount =
        ledgerStorageRelease.releasedSequenceCount
    receipt.ledgerStorageReleasedBufferCount =
        ledgerStorageRelease.releasedSequenceBufferCount
    receipt.ledgerStorageReleasedBytes =
        ledgerStorageRelease.releasedSequenceCapacityBytes
    if metrics.allocated != metrics.released ||
       metrics.live != int64(0) ||
       metrics.allocatedBytes != metrics.releasedBytes ||
       metrics.liveBytes != int64(0) ||
       receipt.physicalBufferCount !=
           int64(receipt.releasedPhysicalBufferCount) ||
       receipt.physicalBytes != receipt.releasedPhysicalBytes ||
       !receipt.rowStorageReleased ||
       !receipt.aggregateStorageReleased ||
       !receipt.allSymbolStorageReleased ||
       !receipt.workerStorageReleased ||
       !receipt.workerEndpointsClosedAndReaped ||
       !receipt.ledgerStorageReleased ||
       receipt.ledgerStorageReleasedSequenceCount != 6 ||
       receipt.ledgerStorageReleasedBufferCount <= 0 ||
       receipt.ledgerStorageReleasedBytes <= int64(0):
        err =
            "backend2 assembler temp lifecycle: terminal ledger mismatch"
        return false
    state.terminalOutcome = outcome
    state.terminalLedgerStorageReleasedBufferCount =
        receipt.ledgerStorageReleasedBufferCount
    state.terminalLedgerStorageReleasedBytes =
        receipt.ledgerStorageReleasedBytes
    state.phase = Backend2AssemblerTempPhaseReleased
    state.terminalReceiptConsumed = true
    return true
