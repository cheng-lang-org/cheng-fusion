    seqs.chengSeqFreeTyped(value.valueEndPositions)
    seqs.chengSeqFreeTyped(value.valueSlotIndices)
    seqs.chengSeqFreeTyped(value.valueTypeKinds)
    seqs.chengSeqFreeTyped(value.valueClasses)
    seqs.chengSeqFreeTyped(value.valueMemoryHomes)
    seqs.chengSeqFreeTyped(value.valueAssignedRegs)
    seqs.chengSeqFreeTyped(value.valueUseOffsets)
    seqs.chengSeqFreeTyped(value.valueUsePositions)
    seqs.chengSeqFreeTyped(value.valueUseFactIndices)
    seqs.chengSeqFreeTyped(value.valueUseKinds)
    seqs.chengSeqFreeTyped(value.valueUseSourceBlocks)
    seqs.chengSeqFreeTyped(value.valueUseTargetBlocks)
