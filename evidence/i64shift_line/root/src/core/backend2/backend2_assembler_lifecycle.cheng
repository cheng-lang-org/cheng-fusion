    seqs.chengSeqFreeTyped(value.regIntervalValues)
    seqs.chengSeqFreeTyped(value.operandRegByFact)
    seqs.chengSeqFreeTyped(value.accessFactRegisters)
    seqs.chengSeqFreeTyped(value.accessFactIsAllocatorClobber)
    seqs.chengSeqFreeTyped(value.accessFactBlockIndices)
    seqs.chengSeqFreeTyped(value.accessFactOpIndices)
    seqs.chengSeqFreeTyped(value.accessFactTermIndices)
    seqs.chengSeqFreeTyped(value.accessFactEdgeIndices)
    seqs.chengSeqFreeTyped(value.opActionStarts)
    seqs.chengSeqFreeTyped(value.opActionCounts)
