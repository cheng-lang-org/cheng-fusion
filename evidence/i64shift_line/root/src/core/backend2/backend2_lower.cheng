                    # 槽(镜像 seq-add str literal 13353-13365),indexed-store 按 24B str header 拷贝。
                    let strLitSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"{rhsText}#idx_str_lit#{bodyIR.cstringLiterals.len}",
                                                                    coreir.LocalStrTag)
                    if strLitSlot >= 0 &&
                       PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                              slotNames,
                                                              rhsText,
                                                              strLitSlot,
                                                              callOrdinal):
                        indexedValueSlot = strLitSlot
                elif rhsIndexedAggCtor:
                    # 构造器 RHS(`arr[i] = Chunk(...)`):逐字段物化到 indexedElemType 槽,
                    # AppendAggregateConstructorToSlot 零初始化+全字段 FieldStore(含嵌套调用实参),
                    # 全结构写满 indexedElemSize,无高字节 garbage。miss 时 indexedValueSlot 保持 -1
                    # 落既有 717 bail(毒标非静默)。
                    let indexedCtorSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              stmt.sourcePath,
                                                                              Fmt"{indexedValueText}#indexed_ctor_value#{stmt.lineNumber}",
                                                                              indexedElemTypeText)
                    if indexedCtorSlot >= 0 &&
                       PrimaryLocalSlotSizeOf(bodyIR.localSlots[indexedCtorSlot]) >= indexedElemSize &&
                       PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering,
                                                                      typedFn,
                                                                      irFunction,
                                                                      indexedValueText,
                                                                      stmt.rhsNodeIndex,
                                                                      indexedElemTypeText,
                                                                      stmt.sourcePath,
                                                                      stmt.lineNumber,
                                                                      indexedCtorSlot,
                                                                      stmt.lineNumber,
                                                                      callOrdinal):
                        indexedValueSlot = indexedCtorSlot
                elif stmt.callTarget != "" && indexedElemTypeText != "":
                    var indexedCallResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                    if indexedCallResultType == "" || indexedCallResultType == "unknown":
                        indexedCallResultType = indexedElemTypeText
                    indexedValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                          slotNames,
                                                                          lowering.typedIr,
                                                                          PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                                          Fmt"{indexedValueText}#indexed_call_value#{stmt.lineNumber}",
                                                                          indexedCallResultType)
                    if indexedValueSlot >= 0 &&
                       PrimaryLocalSlotSizeOf(bodyIR.localSlots[indexedValueSlot]) >= indexedElemSize:
                        let _indexedCallSlot = PrimaryBodyIrAppendCallOp(bodyIR,
                                                                         slotNames,
                                                                         lowering,
                                                                         typedFn,
                                                                         irFunction,
                                                                         stmt,
                                                                         indexedValueSlot,
                                                                         varI32ParamNames,
                                                                         callOrdinal,
                                                                         currentBlockStart)
                    else:
                        indexedValueSlot = -1
                elif PrimaryBodyIrTextHasCallSurface(indexedValueText) && indexedElemTypeText != "":
                    indexedValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                          slotNames,
                                                                          lowering.typedIr,
                                                                          stmt.sourcePath,
                                                                          Fmt"{indexedValueText}#indexed_whole_call_value#{stmt.lineNumber}",
                                                                          indexedElemTypeText)
                    if indexedValueSlot < 0 ||
                       PrimaryLocalSlotSizeOf(bodyIR.localSlots[indexedValueSlot]) < indexedElemSize ||
                       !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                               slotNames,
                                                               lowering,
                                                               typedFn,
                                                               irFunction,
                                                               varI32ParamNames,
                                                               indexedValueText,
                                                               indexedValueSlot,
                                                               stmt.lineNumber,
                                                               -1,
                                                               callOrdinal):
                        indexedValueSlot = -1
                else:
                    indexedValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           stmt.sourcePath,
                                                                           indexedValueText,
                                                                           indexedValueKind, callOrdinal)
                    # RHS is a struct-field read (`node.paramName`): the plain text
                    # resolver has no typedFn/line context to resolve the field
                    # load, so it returns -1. Retry with the context-aware resolver.
                    if indexedValueSlot < 0:
                        indexedValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                      slotNames,
                                                                                      varI32ParamNames,
                                                                                      lowering.typedIr,
                                                                                      typedFn,
                                                                                      irFunction,
                                                                                      stmt.sourcePath,
                                                                                      stmt.lineNumber,
                                                                                      indexedValueText,
                                                                                      indexedValueKind)
                    # RHS 跨模块 const 维定长数组字段索引 `src.limbs[i]`:plain/Context
                    # 标量解析器不解(同 bail=44 读路根因——链式地址 walker 才支持定长
                    # 数组字段索引),回退 IndexedMemberValueSlot 解出该读值。
                    if indexedValueSlot < 0:
                        indexedValueSlot = PrimaryBodyIrIndexedMemberValueSlot(bodyIR,
                                                                               slotNames,
                                                                               varI32ParamNames,
                                                                               lowering.typedIr,
                                                                               typedFn,
                                                                               irFunction,
                                                                               stmt.sourcePath,
                                                                               stmt.lineNumber,
                                                                               indexedValueText,
                                                                               callOrdinal)
                if indexedSlot < 0 || indexedValueSlot < 0:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 717,
                                                 indexedElemSize)
                    return true
                var indexedFieldStoreOp: coreir.BodyOp
                indexedFieldStoreOp.kind = coreir.BodyOpIndexedStoreTag
                indexedFieldStoreOp.target = indexedSeqSlot
                add(indexedFieldStoreOp.operands, indexedSeqSlot)
                add(indexedFieldStoreOp.operands, indexedValueSlot)
                add(indexedFieldStoreOp.operands, indexedSlot)
                add(indexedFieldStoreOp.operands, indexedElemSize)
                if indexedFieldIsDynamicSeq:
                    add(indexedFieldStoreOp.operands, 1)
                let _ = coreir.BodyIRAppendOp(bodyIR, indexedFieldStoreOp)
                if !indexedFieldIsDynamicSeq:
                    var indexedFieldWritebackOp: coreir.BodyOp
                    indexedFieldWritebackOp.kind = coreir.BodyOpFieldStoreTag
                    indexedFieldWritebackOp.target = baseSlot
                    add(indexedFieldWritebackOp.operands, baseSlot)
                    add(indexedFieldWritebackOp.operands, indexedSeqSlot)
                    add(indexedFieldWritebackOp.operands, indexedFieldOffsetBytes)
                    add(indexedFieldWritebackOp.operands, indexedFieldSizeBytes)
                    let _ = coreir.BodyIRAppendOp(bodyIR, indexedFieldWritebackOp)
                return true
            if PrimaryStartsWith(texpr.TypedExprNormalizeTypeText(indexedFieldType), "uint8["):
                # Fixed uint8[N] array field byte store: root.field[idx] = v.
                let fixedU8BaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering.typedIr,
                                                                             stmt.sourcePath,
                                                                             stmt.assignRootName,
                                                                             assignRootType)
                var fixedU8IdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         stmt.sourcePath,
                                                                         indexedFieldIndexText,
                                                                         coreir.LocalI32Tag, callOrdinal)
                if fixedU8IdxSlot >= 0 && indexedFieldOffsetBytes > 0:
                    let fixedU8OffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#fixed_u8_off#{bodyIR.ops.len}",
                                                                         coreir.LocalI32Tag,
                                                                         indexedFieldOffsetBytes)
                    let fixedU8AdjSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                       slotNames,
                                                                       Fmt"#fixed_u8_adj#{bodyIR.ops.len}",
                                                                       coreir.LocalI32Tag)
                    if fixedU8OffSlot < 0 || fixedU8AdjSlot < 0:
                        fixedU8IdxSlot = -1
                    else:
                        var fixedU8AddOp: coreir.BodyOp
                        fixedU8AddOp.kind = coreir.BodyOpBinOpTag
                        fixedU8AddOp.target = fixedU8AdjSlot
                        add(fixedU8AddOp.operands, coreir.LocalI32Tag)
                        add(fixedU8AddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                        add(fixedU8AddOp.operands, fixedU8IdxSlot)
                        add(fixedU8AddOp.operands, fixedU8OffSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, fixedU8AddOp)
                        fixedU8IdxSlot = fixedU8AdjSlot
                var fixedU8ValueText = strings.CloneStr(rhsText)
                let fixedU8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
                if fixedU8Inner != "":
                    fixedU8ValueText = strutil.Strip(fixedU8Inner)
                let fixedU8ValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           stmt.sourcePath,
                                                                           fixedU8ValueText,
                                                                           coreir.LocalI32Tag, callOrdinal)
                if fixedU8BaseSlot < 0 || fixedU8IdxSlot < 0 || fixedU8ValueSlot < 0:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 717,
                                                 1)
                    return true
                var fixedU8StoreOp: coreir.BodyOp
                fixedU8StoreOp.kind = coreir.BodyOpIndexedStoreTag
                fixedU8StoreOp.target = fixedU8BaseSlot
                add(fixedU8StoreOp.operands, fixedU8BaseSlot)
                add(fixedU8StoreOp.operands, fixedU8ValueSlot)
                add(fixedU8StoreOp.operands, fixedU8IdxSlot)
                add(fixedU8StoreOp.operands, 1)
                let _ = coreir.BodyIRAppendOp(bodyIR, fixedU8StoreOp)
                return true
        var valueSlot: int32
        valueSlot = -1
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_value_begin function={typedFn.functionName} line={stmt.lineNumber} byte_count={byteCount}")
        if stmt.callTarget != "":
            let callResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
            valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                           rhsText,
                                                           callResultType)
            if valueSlot < 0 ||
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < byteCount:
                return false
            let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                              slotNames,
                                              lowering,
                                              typedFn,
                                              irFunction,
                                              stmt,
                                              valueSlot,
                                              varI32ParamNames,
                                              callOrdinal,
                                              currentBlockStart)
        elif stmt.assignValueFieldName != "":
            let valueBaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                                       slotNames,
                                                                       lowering.typedIr,
                                                                       stmt.sourcePath,
                                                                       stmt.assignValueRootName,
                                                                       stmt.assignValueRootType)
            let valueByteCount = stmt.assignValueFieldSizeBytes
            if valueBaseSlot < 0:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             714,
                                             0)
                return true
            if valueByteCount <= 0:
                valueByteCount = byteCount
            if valueByteCount != byteCount:
                return false
            valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           stmt.sourcePath,
                                                           Fmt"{stmt.assignValueRootName}.{stmt.assignValueFieldName}#field_value",
                                                           stmt.assignValueFieldType)
            if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < valueByteCount:
                return false
            var loadOp: coreir.BodyOp
            loadOp.kind = coreir.BodyOpFieldLoadTag
            loadOp.target = valueSlot
            add(loadOp.operands, valueBaseSlot)
            add(loadOp.operands, valueSlot)
            add(loadOp.operands, stmt.assignValueFieldOffsetBytes)
            add(loadOp.operands, valueByteCount)
            let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
        else:
            var byteCountFitsI32: bool
            if byteCount > 0:
                if byteCount <= 4:
                    byteCountFitsI32 = true
            if byteCountFitsI32:
                valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering.typedIr,
                                                                       typedFn,
                                                                       irFunction,
                                                                       stmt.sourcePath,
                                                                       stmt.lineNumber,
                                                                       rhsText,
                                                                       coreir.LocalI32Tag)
        if valueSlot < 0:
            var byteCountFitsPtr: bool
            if byteCount == 8:
                if assignFieldType == "ptr":
                    byteCountFitsPtr = true
                elif assignFieldType == "cstring":
                    byteCountFitsPtr = true
                elif PrimaryBodyIrTypeKindFromText(assignFieldType) == coreir.LocalPtrTag:
                    byteCountFitsPtr = true
            if byteCountFitsPtr:
                valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering.typedIr,
                                                                       typedFn,
                                                                       irFunction,
                                                                       stmt.sourcePath,
                                                                       stmt.lineNumber,
                                                                       rhsText,
                                                                       coreir.LocalPtrTag)
        elif byteCount == 8:
            valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering.typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.sourcePath,
                                                                   stmt.lineNumber,
                                                                   rhsText,
                                                                   coreir.LocalI64Tag)
        else:
            if rhsText == "[]" || rhsText == "{}":
                valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"{stmt.assignFieldName}_zero",
                                                           coreir.LocalAggregateTag)
            else:
                valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        let rhsBindingType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                             typedFn,
                                                             irFunction,
                                                             stmt.lineNumber,
                                                             rhsText)
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_binding_done function={typedFn.functionName} line={stmt.lineNumber} rhs_type={rhsBindingType} value_slot={valueSlot}")
        if rhsBindingType != "" &&
           !PrimaryBodyIrTextHasCallSurface(rhsText) &&
           !PrimaryBodyIrTextHasFieldOrIndex(rhsText) &&
           !strutil.Contains(rhsText, "->") &&
           (len(rhsText) <= 0 || (rhsText[0] != '*' && rhsText[0] != '&')):
            # Binding-typed override only for plain local/param names; for
            # deref/field/call expressions a find-or-create here would alias
            # an uninitialized slot over the resolved value.
            let typedValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    stmt.sourcePath,
                                                                    rhsText,
                                                                    rhsBindingType)
            if typedValueSlot >= 0:
                valueSlot = typedValueSlot
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_value_done function={typedFn.functionName} line={stmt.lineNumber} value_slot={valueSlot}")
        # field = <ZeroArgCtor()> where stmt.callTarget is unset (e.g. namespaced
        # ctor `obj.field = parser.NormalizedExprLayer()`): the resolved-call
        # branch above is skipped (it keys on stmt.callTarget), so AppendCallOp's
        # ctor_call_zeroinit path is unreachable. Decode the call head from the
        # RHS text and, for a genuine zero-arg aggregate constructor, zero-init a
        # typed temp slot (mirrors AppendCallOp lines ~17446). The empty-args gate
        # is load-bearing: a named-field ctor `Type(field: v)` also has empty
        # positional args and must NOT be zeroed.
        if valueSlot < 0 &&
           PrimaryBodyIrTextHasCallSurface(rhsText) &&
           assignFieldType != "" &&
           assignFieldType != "unknown":
            let ctorOpenPos = texpr.TypedExprFindWholeCallOpenParen(rhsText)
            if ctorOpenPos > 0:
                let ctorClosePos = texpr.TypedExprFindMatchingParen(rhsText, ctorOpenPos)
                if ctorClosePos > ctorOpenPos && ctorClosePos + 1 == len(rhsText):
                    let ctorHead = strutil.Strip(strings.SliceBytes(rhsText, 0, ctorOpenPos))
                    let ctorArgsInner = strutil.Strip(strings.SliceBytes(rhsText,
                                                                         ctorOpenPos + 1,
                                                                         ctorClosePos - ctorOpenPos - 1))
                    if ctorHead != "" &&
                       ctorArgsInner == "" &&
                       PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, stmt.sourcePath, ctorHead):
                        let ctorCallSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              stmt.sourcePath,
                                                                              Fmt"{stmt.assignFieldName}_rhs_ctor#{bodyIR.ops.len}",
                                                                              ctorHead)
                        if ctorCallSlot >= 0 &&
                           PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, ctorCallSlot, callOrdinal):
                            valueSlot = ctorCallSlot
        if valueSlot < 0 && PrimaryBodyIrTextIsStrSlice(rhsText):
            valueSlot = PrimaryBodyIrLowerStrSliceToSlot(bodyIR, slotNames, varI32ParamNames, lowering.typedIr, typedFn, irFunction, stmt.sourcePath, stmt.lineNumber, rhsText, stmt.assignFieldName, callOrdinal)
        if valueSlot < 0:
            let selfFieldArithName = Fmt"{stmt.assignRootName}.{stmt.assignFieldName}"
            let selfFieldArithTypeKind = PrimaryBodyIrTypeKindFromText(assignFieldType)
            valueSlot = PrimaryBodyIrLowerSelfFieldArithRhsToSlot(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.sourcePath,
                                                                  stmt.lineNumber,
                                                                  rhsText,
                                                                  baseSlot,
                                                                  assignFieldOffsetBytes,
                                                                  byteCount,
                                                                  selfFieldArithName,
                                                                  selfFieldArithTypeKind)

        # 字段赋值 RHS 为复杂表达式(二元式如 `gArr[idx].field + d`、含索引全局元素字段读)
        # 时,plain/Context 标量解析器解不出 → 落 bail_712。该字段赋值的 LHS 元素地址存储
        # 已正确(storeScalar 反汇编实证 madd=base+idx*elemSize),故 RHS 用 node-eval 解出
        # 标量值后照常 store 是安全的。probe 放行 i32/i64,EvalNode poison-on-miss 不落穿。
        if valueSlot < 0 && stmt.rhsNodeIndex >= 0:
            PrimaryBodyIrNodeEvalMissOpReset()
            let rhsAssignEvalProbe = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                stmt.rhsNodeIndex)
            if rhsAssignEvalProbe == coreir.LocalI32Tag || rhsAssignEvalProbe == coreir.LocalI64Tag:
                valueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,
                                                  typedFn,
                                                  irFunction,
                                                  stmt.rhsNodeIndex,
                                                  callOrdinal)
        # bool 短路 RHS 直存字段(`f = a && Pred(call)`):node-eval 探针拒短路逻辑算符
        # (非短路位运算会破坏短路语义),须用 CBR 链把 0/1 物化到 i32 结果槽再 store,
        # 与 return 位的 log-chain 镜像。poison-on-miss:probe 不过或链返 -1 时 valueSlot
        # 保持 <0,照落 bail_712,绝不落穿。
        if valueSlot < 0 && stmt.rhsNodeIndex >= 0 &&
           stmt.rhsNodeIndex < lowering.typedIr.nodes2_opKinds.len &&
           PrimaryBodyIrTypeKindFromText(assignFieldType) == coreir.LocalI32Tag &&
           (lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpLogAnd ||
            lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpLogOr) &&
           PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                           slotNames,
                                           varI32ParamNames,
                                           lowering,
                                           typedFn,
                                           irFunction,
                                           stmt.rhsNodeIndex):
            let assignBoolChainSlot = PrimaryBodyIrAppendNodeBoolConditionChain(bodyIR,
                                                                               slotNames,
                                                                               varI32ParamNames,
                                                                               lowering,
                                                                               typedFn,
                                                                               irFunction,
                                                                               stmt.rhsNodeIndex,
                                                                               callOrdinal,
                                                                               currentBlockStart)
            if assignBoolChainSlot >= 0:
                valueSlot = assignBoolChainSlot

        if valueSlot < 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         712,
                                         0)
            return true
        if rhsText != "[]" && rhsText != "{}" &&
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < byteCount:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         713,
                                         PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]))
            return true
        var storeOp: coreir.BodyOp
        storeOp.kind = coreir.BodyOpFieldStoreTag
        storeOp.target = baseSlot
        add(storeOp.operands, baseSlot)
        add(storeOp.operands, valueSlot)
        add(storeOp.operands, assignFieldOffsetBytes)
        add(storeOp.operands, byteCount)
        let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
        return true
    if PrimaryBodyIrTextHasFieldOrIndex(lhsName):
        var indexRoot = ""
        var indexText = ""
        if PrimaryBodyIrIndexExprParts(lhsName, indexRoot, indexText):
            let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, indexRoot)
            if rootSlot < 0 && PrimaryBodyIrTextHasDot(indexRoot):
                # Fixed uint8[N] array field byte store via dotted root:
                # root.field[idx] = v.
                let dotFieldRootName = texpr.TypedExprAssignLhsRootName(indexRoot)
                let dotFieldPath = texpr.TypedExprAssignFieldPath(indexRoot)
                var dotRootType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.lineNumber,
                                                                  dotFieldRootName)
                var dotFieldType = ""
                var dotFieldOffsetBytes: int32
                var dotFieldSizeBytes: int32
                var dotFieldAlignBytes: int32
                if dotFieldRootName != "" &&
                   dotFieldPath != "" &&
                   dotRootType != "" &&
                   PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                      stmt.sourcePath,
                                                      dotRootType,
                                                      dotFieldPath,
                                                      dotFieldType,
                                                      dotFieldOffsetBytes,
                                                      dotFieldSizeBytes,
                                                      dotFieldAlignBytes) &&
                   PrimaryStartsWith(texpr.TypedExprNormalizeTypeText(dotFieldType), "uint8["):
                    let dotBaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering.typedIr,
                                                                             stmt.sourcePath,
                                                                             dotFieldRootName,
                                                                             dotRootType)
                    var dotIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         stmt.sourcePath,
                                                                         indexText,
                                                                         coreir.LocalI32Tag, callOrdinal)
                    if dotIdxSlot >= 0 && dotFieldOffsetBytes > 0:
                        let dotOffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#dot_u8_off#{bodyIR.ops.len}",
                                                                         coreir.LocalI32Tag,
                                                                         dotFieldOffsetBytes)
                        let dotAdjSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                       slotNames,
                                                                       Fmt"#dot_u8_adj#{bodyIR.ops.len}",
                                                                       coreir.LocalI32Tag)
                        if dotOffSlot < 0 || dotAdjSlot < 0:
                            dotIdxSlot = -1
                        else:
                            var dotAddOp: coreir.BodyOp
                            dotAddOp.kind = coreir.BodyOpBinOpTag
                            dotAddOp.target = dotAdjSlot
                            add(dotAddOp.operands, coreir.LocalI32Tag)
                            add(dotAddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                            add(dotAddOp.operands, dotIdxSlot)
                            add(dotAddOp.operands, dotOffSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, dotAddOp)
                            dotIdxSlot = dotAdjSlot
                    var dotValueText = strings.CloneStr(rhsText)
                    let dotU8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
                    if dotU8Inner != "":
                        dotValueText = strutil.Strip(dotU8Inner)
                    let dotValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           stmt.sourcePath,
                                                                           dotValueText,
                                                                           coreir.LocalI32Tag, callOrdinal)
                    if dotBaseSlot >= 0 && dotIdxSlot >= 0 && dotValueSlot >= 0:
                        var dotStoreOp: coreir.BodyOp
                        dotStoreOp.kind = coreir.BodyOpIndexedStoreTag
                        dotStoreOp.target = dotBaseSlot
                        add(dotStoreOp.operands, dotBaseSlot)
                        add(dotStoreOp.operands, dotValueSlot)
                        add(dotStoreOp.operands, dotIdxSlot)
                        add(dotStoreOp.operands, 1)
                        let _ = coreir.BodyIRAppendOp(bodyIR, dotStoreOp)
                        return true
            if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
                return false
            var elemKind = coreir.LocalI32Tag
            var elemSize = 4
            var indexedStoreIsSeq: bool
            var seqElemKind: int32
            var seqElemSize: int32
            var indexedRootType = texpr.TypedExprStripVarType(stmt.assignRootType)
            if PrimaryBodyIrSeqElementShapeFromText(lowering.typedIr,
                                                    stmt.sourcePath,
                                                    indexedRootType,
                                                    seqElemKind,
                                                    seqElemSize):
                elemKind = seqElemKind
                elemSize = seqElemSize
                indexedStoreIsSeq = PrimaryBodyIrTypeTextIsDynamicSeq(indexedRootType)
            # var seq params hold the header address in a ptr slot; the seq
            # deref flag makes the fill resolve the data pointer for both
            # aggregate locals and ptr params.
            if bodyIR.localSlots[rootSlot].typeKind != coreir.LocalAggregateTag &&
               !(bodyIR.localSlots[rootSlot].typeKind == coreir.LocalPtrTag && indexedStoreIsSeq):
                return false
            let indexSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                stmt.sourcePath,
                                                                indexText,
                                                                coreir.LocalI32Tag, callOrdinal)
            var valueText = strings.CloneStr(rhsText)
            if elemSize == 1:
                let u8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
                if u8Inner != "":
                    valueText = u8Inner
            var valueKind = elemKind
            if elemSize == 1:
                valueKind = coreir.LocalI32Tag
            let indexedElemTypeText = PrimaryBodyIrIndexedElementTypeText(indexedRootType)
            var valueSlot: int32 = -1
            # bail=706 (R-C): `raw[int(i)] = uint8(call(...) & 255)` — value 含
            # 调用+尾算术, whole-call 臂只认整调用文本必 miss → return false →
            # bail_706;callTarget 臂又会把语句首个 call(可能是索引里的 cast)误当
            # 值调用。node-primary: 先 NodeEvalProbe 零发射预检 rhs 节点可解且槽
            # 形严等 valueKind, 命中再 EvalNode 物化(cast/binop/CallExpr/str-index
            # 全形, 调用经节点位 ordinal 与 call-sequence 对齐)。miss 不动, 落回
            # 既有文本臂链(行为不变)。
            if stmt.rhsNodeIndex >= 0 &&
               stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               (valueKind == coreir.LocalI32Tag ||
                valueKind == coreir.LocalI64Tag ||
                valueKind == coreir.LocalPtrTag):
                let idxStoreProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering.typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.rhsNodeIndex)
                if idxStoreProbeKind == valueKind:
                    let idxStoreEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                    let idxStoreNodeSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,
                                                                 typedFn,
                                                                 irFunction,
                                                                 stmt.rhsNodeIndex,
                                                                 callOrdinal)
                    if idxStoreNodeSlot >= 0 &&
                       idxStoreNodeSlot < bodyIR.localSlots.len &&
                       PrimaryBodyIrSlotType(bodyIR, idxStoreNodeSlot) == valueKind:
                        valueSlot = idxStoreNodeSlot
                    elif PrimaryBodyIrNodeEvalCallEmitCountNow() != idxStoreEmitMark:
                        # 调用已发射后失败: 落文本臂会重复发调用(call-sequence
                        # drift)。poison(镜像 6101 样板), 绝不静默落穿。
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     7061,
                                                     0)
                        return true
            if valueSlot < 0 && elemKind == coreir.LocalStrTag && rhsText == "nil":
                valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                stmt.sourcePath,
                                                                "nil",
                                                                coreir.LocalPtrTag, callOrdinal)
            elif valueSlot < 0 && stmt.callTarget != "" && indexedElemTypeText != "":
                var indexedCallResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                if indexedCallResultType == "" || indexedCallResultType == "unknown":
                    indexedCallResultType = indexedElemTypeText
                valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                               Fmt"{valueText}#indexed_call_value#{stmt.lineNumber}",
                                                               indexedCallResultType)
                if valueSlot >= 0 &&
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) >= elemSize:
                    let _indexedCallSlot = PrimaryBodyIrAppendCallOp(bodyIR,
                                                                     slotNames,
                                                                     lowering,
                                                                     typedFn,
                                                                     irFunction,
                                                                     stmt,
                                                                     valueSlot,
                                                                     varI32ParamNames,
                                                                     callOrdinal,
                                                                     currentBlockStart)
                else:
                    valueSlot = -1
            elif valueSlot < 0 && PrimaryBodyIrTextHasCallSurface(valueText) && indexedElemTypeText != "":
                valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               stmt.sourcePath,
                                                               Fmt"{valueText}#indexed_whole_call_value#{stmt.lineNumber}",
                                                               indexedElemTypeText)
                if valueSlot < 0 ||
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < elemSize ||
                   !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                           slotNames,
                                                           lowering,
                                                           typedFn,
                                                           irFunction,
                                                           varI32ParamNames,
                                                           valueText,
                                                           valueSlot,
                                                           stmt.lineNumber,
                                                           -1,
                                                           callOrdinal):
                    valueSlot = -1
            elif valueSlot < 0:
                # Context variant (not the bare one): the stored value may itself
                # contain multi-dimensional fixed-array reads, e.g.
                # `grid[i][j] = grid[a][b] + grid[c][d]`. Only the context path
                # row-major-flattens those `[i][j]` operands (it has the function
                # binding scope to resolve the dimension strides); the bare path
                # would degrade each multi-bracket operand to a phantom slot.
                valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering.typedIr,
                                                                       typedFn,
                                                                       irFunction,
                                                                       stmt.sourcePath,
                                                                       stmt.lineNumber,
                                                                       valueText,
                                                                       valueKind)
            if indexSlot < 0 || valueSlot < 0:
                return false
            var indexedStoreOp: coreir.BodyOp
            indexedStoreOp.kind = coreir.BodyOpIndexedStoreTag
            indexedStoreOp.target = rootSlot
            add(indexedStoreOp.operands, rootSlot)
            add(indexedStoreOp.operands, valueSlot)
            add(indexedStoreOp.operands, indexSlot)
            add(indexedStoreOp.operands, elemSize)
            if indexedStoreIsSeq:
                add(indexedStoreOp.operands, 1)
            let _ = coreir.BodyIRAppendOp(bodyIR, indexedStoreOp)
            return true
        var dotPos: int32
        dotPos = -1
        for ci in 0..<len(lhsName):
            if lhsName[ci] == '.':
                dotPos = ci
        if dotPos < 0:
            return false
        let rootName = strutil.Strip(strings.SliceBytes(lhsName, 0, dotPos))
        var baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              stmt.sourcePath,
                                                              rootName,
                                                              stmt.assignRootType)
        if baseSlot < 0:
            return false
        var valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        if valueSlot < 0:
            valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           stmt.sourcePath,
                                                           rhsText,
                                                           stmt.resultType)
        if valueSlot < 0:
            return false
        var storeOp: coreir.BodyOp
        storeOp.kind = coreir.BodyOpFieldStoreTag
        storeOp.target = baseSlot
        add(storeOp.operands, baseSlot)
        add(storeOp.operands, valueSlot)
        add(storeOp.operands, 0)
        add(storeOp.operands, 8)
        let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
        return true
    var lhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
    if lhsSlot < 0 &&
       stmt.resultType != "" &&
       stmt.resultType != "unknown" &&
       stmt.assignFieldName == "" &&
       !PrimaryBodyIrTextHasFieldOrIndex(lhsName):
        lhsSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                     slotNames,
                                                     lowering.typedIr,
                                                     stmt.sourcePath,
                                                     lhsName,
                                                     stmt.resultType)
    if lhsSlot < 0:
        B2PrimaryObjectPlanTrace(strutil.Join(["phase=assign_lhs_slot_missing function=",
                                             strings.CloneStr(typedFn.functionName),
                                             " line=",
                                             strings.IntToStr(stmt.lineNumber),
                                             " lhs=",
                                             strings.CloneStr(lhsName),
                                             " rhs=",
                                             strings.CloneStr(rhsText)], ""))
        return false
    if stmt.assignFieldName == "" &&
       !PrimaryBodyIrTextHasFieldOrIndex(lhsName) &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[lhsSlot]):
        var assignLhsType = strings.CloneStr(stmt.resultType)
        if assignLhsType == "" || assignLhsType == "unknown" || assignLhsType == "call_expr":
            assignLhsType = PrimaryBodyIrNodeResultTypeText(lowering.typedIr, stmt.rhsNodeIndex)
        let _ = PrimaryBodyIrRetypeLocalScalarSlotForType(bodyIR,
                                                          lowering.typedIr,
                                                          stmt.sourcePath,
                                                          lhsSlot,
                                                          assignLhsType)
    if PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalI32Tag &&
       (PrimaryBodyIrConditionHasAnd(rhsText) ||
        PrimaryBodyIrConditionHasOr(rhsText)):
        var boolConditionBlockStart: int32
        boolConditionBlockStart = currentBlockStart
        let boolConditionAssigned = PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                                          slotNames,
                                                                          lowering,
                                                                          typedFn,
                                                                          irFunction,
                                                                          stmt.sourcePath,
                                                                          stmt.lineNumber,
                                                                          stmt.rhsNodeIndex,
                                                                          rhsText,
                                                                          lhsSlot,
                                                                          callOrdinal,
                                                                          boolConditionBlockStart)
        currentBlockStart = boolConditionBlockStart
        return boolConditionAssigned
    let lhsIsVarI32 = PrimaryBodyIrNameInList(varI32ParamNames, lhsName)
    var lhsVarPointeeKind = PrimaryBodyIrVarParamPointeeKind(bodyIR, lhsSlot)
    if lhsVarPointeeKind == coreir.LocalInvalidTag &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalPtrTag:
        let lhsBindingTypeForVar = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.lineNumber,
                                                                   lhsName)
        lhsVarPointeeKind = PrimaryBodyIrVarPointeeTypeKindFromText(lowering.typedIr, stmt.sourcePath, lhsBindingTypeForVar)
    if stmt.callTarget == "" &&
       PrimaryBodyIrTextHasCallSurface(rhsText):
        let lhsSlotType = PrimaryBodyIrSlotType(bodyIR, lhsSlot)
        let lhsIsAggregateParamSlot = PrimaryBodyIrSlotIsAggregateParam(bodyIR, lhsSlot)
        if lhsSlotType == coreir.LocalStrTag ||
           lhsSlotType == coreir.LocalAggregateTag:
            if !lhsIsAggregateParamSlot &&
               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                       slotNames,
                                                       lowering,
                                                       typedFn,
                                                       irFunction,
                                                       varI32ParamNames,
                                                       rhsText,
                                                       lhsSlot,
                                                       stmt.lineNumber,
                                                       -1,
                                                       callOrdinal):
                return true
            var wholeCallResultType = strings.CloneStr(stmt.resultType)
            if wholeCallResultType == "" || wholeCallResultType == "unknown":
                wholeCallResultType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.lineNumber,
                                                                      lhsName)
            if wholeCallResultType == "" || wholeCallResultType == "unknown":
                if lhsSlotType == coreir.LocalStrTag:
                    wholeCallResultType = "str"
            if wholeCallResultType != "" && wholeCallResultType != "unknown":
                let wholeCallResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering.typedIr,
                                                                             stmt.sourcePath,
                                                                             Fmt"{lhsName}#whole_call_result#{stmt.lineNumber}",
                                                                             wholeCallResultType)
                if wholeCallResultSlot >= 0 &&
                   PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                          slotNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          varI32ParamNames,
                                                          rhsText,
                                                          wholeCallResultSlot,
                                                          stmt.lineNumber,
                                                          -1,
                                                          callOrdinal):
                    if lhsIsAggregateParamSlot:
                        if !PrimaryBodyIrAppendAggregateParamStoreIfNeeded(bodyIR,
                                                                           lhsSlot,
                                                                           wholeCallResultSlot):
                            return false
                    else:
                        var wholeCallCopyOp: coreir.BodyOp
                        wholeCallCopyOp.kind = coreir.BodyOpCopyLocalTag
                        wholeCallCopyOp.target = lhsSlot
                        add(wholeCallCopyOp.operands, wholeCallResultSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, wholeCallCopyOp)
                    return true
        elif PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                    slotNames,
                                                    lowering,
                                                    typedFn,
                                                    irFunction,
                                                    varI32ParamNames,
                                                    rhsText,
                                                    lhsSlot,
                                                    stmt.lineNumber,
                                                    -1,
                                                    callOrdinal):
            return true
    if lhsVarPointeeKind == coreir.LocalI64Tag && stmt.callTarget == "":
        let valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering.typedIr,
                                                            stmt.sourcePath,
                                                            rhsText,
                                                            coreir.LocalI64Tag, callOrdinal)
        if valueSlot < 0:
            return false
        PrimaryBodyIrAppendVarI64Store(bodyIR, lhsSlot, valueSlot)
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=assign_store_var_i64 lhs={lhsName} address_slot={lhsSlot} value_slot={valueSlot}")
        return true
    if lhsVarPointeeKind == coreir.LocalStrTag && stmt.callTarget == "":
        var valueSlot: int32
        valueSlot = -1
        if PrimaryBodyIrTextIsStringLiteral(rhsText):
            valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"{lhsName}#var_str_value#{stmt.lineNumber}",
                                                       coreir.LocalStrTag)
            if valueSlot < 0 ||
               !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                      slotNames,
                                                      rhsText,
                                                      valueSlot,
                                                      callOrdinal):
                return false
        else:
            valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
            if valueSlot < 0:
                valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               stmt.sourcePath,
                                                               rhsText,
                                                               "str")
        if valueSlot < 0 ||
           PrimaryBodyIrSlotType(bodyIR, valueSlot) != coreir.LocalStrTag:
            return false
        PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                             lhsSlot,
                                             valueSlot,
                                             PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]))
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=assign_store_var_str lhs={lhsName} address_slot={lhsSlot} value_slot={valueSlot}")
        return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_M function={typedFn.functionName} line={stmt.lineNumber}")
    if stmt.callTarget != "":
        var resultSlot = lhsSlot
        var copyCallResultToLhs = false
        let resultTypeText = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
        if lhsIsVarI32:
            resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       PrimaryBodyIrVarI32ValueSlotName(lhsName),
                                                       coreir.LocalI32Tag)
        elif lhsVarPointeeKind == coreir.LocalStrTag:
            var tempResultType = resultTypeText
            if tempResultType == "" || tempResultType == "unknown":
                tempResultType = stmt.resultType
            if tempResultType == "" || tempResultType == "unknown":
                return false
            resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                            slotNames,
                                                            lowering.typedIr,
                                                            PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                            Fmt"{lhsName}#var_str_call_result#{stmt.lineNumber}",
                                                            tempResultType)
            if resultSlot < 0 ||
               PrimaryBodyIrSlotType(bodyIR, resultSlot) != coreir.LocalStrTag:
                return false
        elif PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalStrTag ||
             PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalAggregateTag:
            var tempResultType = resultTypeText
            if tempResultType == "" || tempResultType == "unknown":
                tempResultType = stmt.resultType
            if tempResultType == "" || tempResultType == "unknown":
                return false
            resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                            slotNames,
                                                            lowering.typedIr,
                                                            PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                            Fmt"{lhsName}#call_result#{stmt.lineNumber}",
                                                            tempResultType)
            if resultSlot < 0:
                return false
            copyCallResultToLhs = true
        elif resultTypeText != "":
            var resultTypeKind: int32
            var resultSizeBytes: int32
            var resultAlignBytes: int32
            PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                           PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                           resultTypeText,
                                           resultTypeKind,
                                           resultSizeBytes,
                                           resultAlignBytes)
            if resultTypeKind != PrimaryBodyIrSlotType(bodyIR, lhsSlot):
                return false
        let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                          slotNames,
                                          lowering,
                                          typedFn,
                                          irFunction,
                                          stmt,
                                          resultSlot,
                                          varI32ParamNames,
                                          callOrdinal,
                                          currentBlockStart)
        if lhsIsVarI32:
            PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, resultSlot)
        elif lhsVarPointeeKind == coreir.LocalStrTag:
            PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                 lhsSlot,
                                                 resultSlot,
                                                 PrimaryLocalSlotSizeOf(bodyIR.localSlots[resultSlot]))
        elif copyCallResultToLhs:
            if PrimaryBodyIrSlotIsAggregateParam(bodyIR, lhsSlot):
                if !PrimaryBodyIrAppendAggregateParamStoreIfNeeded(bodyIR,
                                                                   lhsSlot,
                                                                   resultSlot):
                    return false
            else:
                var copyOp: coreir.BodyOp
                copyOp.kind = coreir.BodyOpCopyLocalTag
                copyOp.target = lhsSlot
                add(copyOp.operands, resultSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
        return true
    if os.GetEnv("CHENG_X64_DBG4") != "" && PrimaryBodyIrTextIsStringLiteral(rhsText):
        var dbg4StrPointee: int32 = lhsVarPointeeKind
        var dbg4StrIsVar: int32
        if lhsIsVarI32:
            dbg4StrIsVar = 1
        os.WriteLine(os.GetStderr(), Fmt"x64dbg4 str_lit_assign lhs=[{lhsName}] slot_type={PrimaryBodyIrSlotType(bodyIR, lhsSlot)} pointee={dbg4StrPointee} is_var_i32={dbg4StrIsVar}")
    if !lhsIsVarI32 &&
       lhsVarPointeeKind != coreir.LocalStrTag &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalStrTag &&
       PrimaryBodyIrTextIsStringLiteral(rhsText):
        return PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                     slotNames,
                                                     rhsText,
                                                     lhsSlot,
                                                     callOrdinal)
    if !lhsIsVarI32 &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalAggregateTag &&
       bodyIR.localSlots[lhsSlot].auxValue == coreir.LocalStrTag &&
       PrimaryBodyIrLocalIsParam(bodyIR.localSlots[lhsSlot]) &&
       PrimaryBodyIrTextIsStringLiteral(rhsText) &&
       stmt.callTarget == "":
        # var str param assign: build the literal into a temp str value and
        # copy it through the param address.
        let varStrLitSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"{lhsName}#var_str_lit#{stmt.lineNumber}",
                                                          coreir.LocalStrTag)
        if varStrLitSlot >= 0 &&
           PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                 slotNames,
                                                 rhsText,
                                                 varStrLitSlot,
                                                 callOrdinal):
            PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                 lhsSlot,
                                                 varStrLitSlot,
                                                 24)
            return true
    if !lhsIsVarI32 &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalPtrTag &&
       PrimaryBodyIrVarParamPointeeKind(bodyIR, lhsSlot) == coreir.LocalInvalidTag &&
       PrimaryBodyIrTextIsStringLiteral(rhsText) &&
       stmt.callTarget == "":
        # cstring literal assign: lhs = "..." with a pointer-typed lhs takes the
        # address of the NUL-terminated literal in the function's literal pool.
        let cstrLiteralId = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                                              PrimaryBodyIrStringLiteralPayload(rhsText),
                                                              "")
        if cstrLiteralId >= 0:
            var cstrOp: coreir.BodyOp
            cstrOp.kind = coreir.BodyOpLoadLocalTag
            cstrOp.target = lhsSlot
            add(cstrOp.operands, coreir.BodyLoadLocalCStringTag)
            add(cstrOp.operands, cstrLiteralId)
            let _ = coreir.BodyIRAppendOp(bodyIR, cstrOp)
            return true
    if !lhsIsVarI32 && PrimaryBodyIrSlotType(bodyIR, lhsSlot) != coreir.LocalI32Tag:
        let nonI32LhsKind = PrimaryBodyIrSlotType(bodyIR, lhsSlot)
        var scalarValueSlot: int32 = -1
        if nonI32LhsKind == coreir.LocalF64Tag:
            scalarValueSlot = PrimaryBodyIrCallBinOpTernaryAwareSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,
                                                                     typedFn,
                                                                     irFunction,
                                                                     stmt.sourcePath,
                                                                     stmt.lineNumber,
                                                                     stmt.rhsNodeIndex,
                                                                     rhsText,
                                                                     nonI32LhsKind,
                                                                     callOrdinal,
                                                                     currentBlockStart)
        else:
            scalarValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  stmt.sourcePath,
                                                                  rhsText,
                                                                  nonI32LhsKind,
                                                                  callOrdinal)
        if scalarValueSlot >= 0:
            if scalarValueSlot != lhsSlot:
                var scalarCopyOp: coreir.BodyOp
                scalarCopyOp.kind = coreir.BodyOpCopyLocalTag
                scalarCopyOp.target = lhsSlot
                add(scalarCopyOp.operands, scalarValueSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, scalarCopyOp)
            return true
        let rhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        if rhsSlot >= 0:
            var copyOp: coreir.BodyOp
            copyOp.kind = coreir.BodyOpCopyLocalTag
            copyOp.target = lhsSlot
            add(copyOp.operands, rhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
            return true
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=assign_non_i32_value_missing function={typedFn.functionName} line={stmt.lineNumber} lhs={lhsName} lhs_slot={lhsSlot} lhs_slot_type={PrimaryBodyIrSlotType(bodyIR, lhsSlot)} rhs={rhsText}")
        return false
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_N function={typedFn.functionName} line={stmt.lineNumber}")
    var targetSlot = lhsSlot
    if lhsIsVarI32:
        targetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  PrimaryBodyIrVarI32ValueSlotName(lhsName),
                                                  coreir.LocalI32Tag)
    if stmt.assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary:
        let ternTypeKind = PrimaryBodyIrSlotType(bodyIR, targetSlot)
        # 真分支下降：仅执行被选中臂（含调用臂时根除急切求值 miscompile）。
        if PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering,
                                                      typedFn,
                                                      irFunction,
                                                      stmt.sourcePath,
                                                      stmt.lineNumber,
                                                      stmt.rhsNodeIndex,
                                                      rhsText,
                                                      targetSlot,
                                                      ternTypeKind,
                                                      callOrdinal,
                                                      currentBlockStart):
            if lhsIsVarI32:
                PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
            return true
        # call-free 常量臂：急切快路径（与 ScalarValueSlotForTextImpl 11325 一致）。
        let ternTrueText = strutil.Strip(stmt.assignValueRhsText)
        let ternFalseText = strutil.Strip(stmt.conditionRhsText)
        if PrimaryBodyIrTextHasRealCallSurface(ternTrueText) ||
           PrimaryBodyIrTextHasRealCallSurface(ternFalseText):
            return false
        let ternarySlot = PrimaryBodyIrTernaryValueSlotForStmt(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering.typedIr,
                                                              stmt,
                                                              ternTypeKind)
        if ternarySlot < 0:
            return false
        if ternarySlot != targetSlot:
            var ternaryCopyOp: coreir.BodyOp
            ternaryCopyOp.kind = coreir.BodyOpCopyLocalTag
            ternaryCopyOp.target = targetSlot
            add(ternaryCopyOp.operands, ternarySlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, ternaryCopyOp)
        if lhsIsVarI32:
            PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
        return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_O function={typedFn.functionName} line={stmt.lineNumber}")
    if stmt.assignValueOpKind == texpr.TypedExprIrOpI32Add ||
       stmt.assignValueOpKind == texpr.TypedExprIrOpI32Sub ||
       stmt.assignValueOpKind == texpr.TypedExprIrOpI32Mul ||
       stmt.assignValueOpKind == texpr.TypedExprIrOpI32Sdiv ||
       stmt.assignValueOpKind == texpr.TypedExprIrOpI32Asr ||
       stmt.assignValueOpKind == texpr.TypedExprIrOpI32BitAnd ||
       stmt.assignValueOpKind == texpr.TypedExprIrOpI32BitOr ||
       stmt.assignValueOpKind == texpr.TypedExprIrOpI32BitXor:
        if stmt.assignValueLhsText == "" || stmt.assignValueRhsText == "":
            if B2PrimaryObjectPlanTraceActive():
                B2PrimaryObjectPlanTrace(Fmt"phase=assign_typed_bin_text_missing function={typedFn.functionName} line={stmt.lineNumber} lhs_text={stmt.assignValueLhsText} rhs_text={stmt.assignValueRhsText}")
            return false
        let lhsValueSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.sourcePath,
                                                                   stmt.lineNumber,
                                                                   stmt.assignValueLhsText,
                                                                   PrimaryBodyIrSlotType(bodyIR, targetSlot),
                                                                   callOrdinal)
        let rhsValueSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.sourcePath,
                                                                   stmt.lineNumber,
                                                                   stmt.assignValueRhsText,
                                                                   PrimaryBodyIrSlotType(bodyIR, targetSlot),
                                                                   callOrdinal)
        if lhsValueSlot < 0 || rhsValueSlot < 0:
            if os.GetEnv("CHENG_X64_DBG3") != "":
                os.WriteLine(os.GetStderr(), Fmt"x64dbg3 typed_bin_missing line={stmt.lineNumber} vlhs=[{stmt.assignValueLhsText}] slot_l={lhsValueSlot} vrhs=[{stmt.assignValueRhsText}] slot_r={rhsValueSlot}")
            B2PrimaryObjectPlanTrace(strutil.Join(["phase=assign_typed_bin_slot_missing function=",
                                                 strings.CloneStr(typedFn.functionName),
                                                 " line=",
                                                 strings.IntToStr(stmt.lineNumber),
                                                 " lhs=",
                                                 strings.CloneStr(stmt.assignValueLhsText),
                                                 " lhs_slot=",
                                                 strings.IntToStr(lhsValueSlot),
                                                 " rhs=",
                                                 strings.CloneStr(stmt.assignValueRhsText),
                                                 " rhs_slot=",
                                                 strings.IntToStr(rhsValueSlot)], ""))
            return false
        var typedBinOp: coreir.BodyOp
        typedBinOp.kind = coreir.BodyOpBinOpTag
        typedBinOp.target = targetSlot
        add(typedBinOp.operands, PrimaryBodyIrSlotType(bodyIR, targetSlot))
        add(typedBinOp.operands, int32(stmt.assignValueOpKind))
        add(typedBinOp.operands, lhsValueSlot)
        add(typedBinOp.operands, rhsValueSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, typedBinOp)
        if lhsIsVarI32:
            PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
        return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_P function={typedFn.functionName} line={stmt.lineNumber}")
    let directScalarSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.sourcePath,
                                                                   stmt.lineNumber,
                                                                   rhsText,
                                                                   PrimaryBodyIrSlotType(bodyIR, targetSlot),
                                                                   callOrdinal)
    if directScalarSlot >= 0:
        if directScalarSlot != targetSlot:
            var directCopyOp: coreir.BodyOp
            directCopyOp.kind = coreir.BodyOpCopyLocalTag
            directCopyOp.target = targetSlot
            add(directCopyOp.operands, directScalarSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, directCopyOp)
        if lhsIsVarI32:
            PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
        return true
    if stmt.rhsNodeIndex >= 0:
        let rhsNodeTargetKind = PrimaryBodyIrSlotType(bodyIR, targetSlot)
        let rhsNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering.typedIr,
                                                          typedFn,
                                                          irFunction,
                                                          stmt.rhsNodeIndex)
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            var rhsNodeOpText = ""
            var rhsNodeResultType = ""
            if stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                rhsNodeOpText = texpr.TypedExprIrOpKindText(lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex])
                let rhsNodeRtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                                         lowering.typedIr.nodes2_resultTypeIds[stmt.rhsNodeIndex])
                if IsOk(rhsNodeRtRes):
                    rhsNodeResultType = Value(rhsNodeRtRes)
            os.WriteLine(os.GetStderr(), Fmt"phase=assign_node_probe function={typedFn.functionName} line={stmt.lineNumber} lhs={lhsName} rhs={rhsText} node={stmt.rhsNodeIndex} op={rhsNodeOpText} result_type={rhsNodeResultType} target_slot={targetSlot} target_kind={rhsNodeTargetKind} probe_kind={rhsNodeProbeKind} miss={PrimaryBodyIrNodeEvalMissOpText()}")
        if rhsNodeProbeKind == rhsNodeTargetKind:
            let rhsNodeSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,
                                                    typedFn,
                                                    irFunction,
                                                    stmt.rhsNodeIndex,
                                                    callOrdinal)
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                var rhsNodeSlotKind: int32
                if rhsNodeSlot >= 0 && rhsNodeSlot < bodyIR.localSlots.len:
                    rhsNodeSlotKind = PrimaryBodyIrSlotType(bodyIR, rhsNodeSlot)
                os.WriteLine(os.GetStderr(), Fmt"phase=assign_node_eval function={typedFn.functionName} line={stmt.lineNumber} node={stmt.rhsNodeIndex} slot={rhsNodeSlot} slot_kind={rhsNodeSlotKind} target_kind={rhsNodeTargetKind} miss={PrimaryBodyIrNodeEvalMissOpText()}")
            if rhsNodeSlot >= 0 &&
               rhsNodeSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, rhsNodeSlot) == rhsNodeTargetKind:
                if rhsNodeSlot != targetSlot:
                    var rhsNodeCopyOp: coreir.BodyOp
                    rhsNodeCopyOp.kind = coreir.BodyOpCopyLocalTag
                    rhsNodeCopyOp.target = targetSlot
                    add(rhsNodeCopyOp.operands, rhsNodeSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, rhsNodeCopyOp)
                if lhsIsVarI32:
                    PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
                return true
    # 顶层二元算术 RHS（var - call() - call() 这类多调用链）：前端对 3+ 操作数
    # 链不填 assignValueLhs/RhsText(:32331 binop 分支够不到)，整个 RHS 也不是
    # 单一 call surface(:32388 directScalar 够不到)。此处按 + 优先于 - 优先于 *
    # 取【最后一个】顶层算子切分(左结合：与 CallScalarValueSlotForTextImpl 的
    # FindTopLevelBinOpTokenLast 语义一致,a-b-c 切成 (a-b)-c 而非 a-(b-c))，
    # 两侧经 CallScalarValueSlotForText 物化(单调用侧复用既有 AppendCallOp 范式，
    # 多调用侧 helper 内递归)，发对应 BinOp；切不动或侧槽缺失则落回下方标量兜底
    # （不静默 miscompile）。
    let addPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(rhsText, 43)
    let subPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(rhsText, 45)
    let mulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(rhsText, 42)
    var binOpPos: int32 = -1
    var binOpKind: int32
    if addPos > 0:
        binOpPos = addPos
        binOpKind = int32(texpr.TypedExprIrOpI32Add)
    elif subPos > 0:
        binOpPos = subPos
        binOpKind = int32(texpr.TypedExprIrOpI32Sub)
    elif mulPos > 0:
        binOpPos = mulPos
        binOpKind = int32(texpr.TypedExprIrOpI32Mul)
    if binOpPos > 0 && binOpKind != 0:
        let rhsLhs = strutil.Strip(strings.SliceBytes(rhsText, 0, binOpPos))
        let rhsRhs = strutil.Strip(strings.SliceBytes(rhsText,
                                                     binOpPos + 1,
                                                     len(rhsText) - binOpPos - 1))
        let lhsValueSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.sourcePath,
                                                                   stmt.lineNumber,
                                                                   rhsLhs,
                                                                   coreir.LocalI32Tag,
                                                                   callOrdinal)
        let rhsValueSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.sourcePath,
                                                                   stmt.lineNumber,
                                                                   rhsRhs,
                                                                   coreir.LocalI32Tag,
                                                                   callOrdinal)
        if lhsValueSlot < 0 || rhsValueSlot < 0:
            # 文本 binop 切分侧槽缺失:侧子表达式本身含 binop+call(如 `a - f() - g()`
            # 切末位算子后左侧仍是 `a - f()`,CallScalarValueSlotForText 不认此形)。
            # 对整棵 RHS 节点走 EvalNode 物化进临时槽再 CopyLocal 到 targetSlot——
            # 镜像 call-arg 的 Fmt/field 路径(17999/18043)把 EvalNode 当纯物化器用,
            # 无 census claim、无 NodeEvalOnlyOwn。文本 binop 路径两侧槽缺失时不发
            # 射任何 op,故无 double-emit。poison-on-miss 仍落下方 return false。
            if stmt.rhsNodeIndex >= 0:
                let binFallbackSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,
                                                            typedFn,
                                                            irFunction,
                                                            stmt.rhsNodeIndex,
                                                            callOrdinal)
                if binFallbackSlot >= 0 &&
                   binFallbackSlot < bodyIR.localSlots.len &&
                   PrimaryBodyIrSlotType(bodyIR, binFallbackSlot) == PrimaryBodyIrSlotType(bodyIR, targetSlot):
                    # G1 严等门:挡 i64→i32 / aggregate→i32 静默截断(对抗审计 current)
                    if binFallbackSlot != targetSlot:
                        var binFallbackCopyOp: coreir.BodyOp
                        binFallbackCopyOp.kind = coreir.BodyOpCopyLocalTag
                        binFallbackCopyOp.target = targetSlot
                        add(binFallbackCopyOp.operands, binFallbackSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, binFallbackCopyOp)
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_binop_fallback function={typedFn.functionName} line={stmt.lineNumber}")
                    return true
            B2PrimaryObjectPlanTrace(strutil.Join(["phase=assign_add_slot_missing function=",
                                                 strings.CloneStr(typedFn.functionName),
                                                 " line=",
                                                 strings.IntToStr(stmt.lineNumber),
                                                 " lhs=",
                                                 strings.CloneStr(lhsName),
                                                 " left=",
                                                 strings.CloneStr(rhsLhs),
                                                 " left_slot=",
                                                 strings.IntToStr(lhsValueSlot),
                                                 " right=",
                                                 strings.CloneStr(rhsRhs),
                                                 " right_slot=",
                                                 strings.IntToStr(rhsValueSlot)], ""))
            return false
        var op: coreir.BodyOp
        op.kind = coreir.BodyOpBinOpTag
        op.target = targetSlot
        add(op.operands, coreir.LocalI32Tag)
        add(op.operands, binOpKind)
        add(op.operands, lhsValueSlot)
        add(op.operands, rhsValueSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, op)
    else:
        let valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering.typedIr,
                                                            stmt.sourcePath,
                                                            rhsText,
                                                            PrimaryBodyIrSlotType(bodyIR, targetSlot), callOrdinal)
        if valueSlot < 0:
            B2PrimaryObjectPlanTrace(strutil.Join(["phase=assign_value_slot_missing function=",
                                                 strings.CloneStr(typedFn.functionName),
                                                 " line=",
                                                 strings.IntToStr(stmt.lineNumber),
                                                 " lhs=",
                                                 strings.CloneStr(lhsName),
                                                 " rhs=",
                                                 strings.CloneStr(rhsText)], ""))
            return false
        if valueSlot != targetSlot:
            var copyOp: coreir.BodyOp
            copyOp.kind = coreir.BodyOpCopyLocalTag
            copyOp.target = targetSlot
            add(copyOp.operands, valueSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
    if lhsIsVarI32:
        PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
    return true

@borrows
fn PrimaryBodyIrStructuredBodyEnd(irFunction: lower.PrimaryObjectIrFunction,
                                   stmtIndex: int32,
                                   stmtEndRaw: int32): int32 =
    var stmtEnd = stmtEndRaw
    if stmtEnd > irFunction.statements.len:
        stmtEnd = irFunction.statements.len
    if stmtIndex < 0 || stmtIndex >= stmtEnd:
        return stmtEnd
    let stmt = irFunction.statements[stmtIndex]
    var bodyEnd = stmtEnd
    for si in stmtIndex + 1..<stmtEnd:
        let scanStmt = irFunction.statements[si]
        var primaryColdCond15: bool
        var primaryColdCond15Clause0: bool
        if scanStmt.lineIndent > 0:
            if scanStmt.lineIndent <= stmt.lineIndent:
                primaryColdCond15Clause0 = true
        if primaryColdCond15Clause0:
            primaryColdCond15 = true
        if stmt.lineNumber > 0 && scanStmt.lineNumber == stmt.lineNumber:
            # Twin statements emitted for the same header line (If + IfCall)
            # are part of the construct head, not the end of its body.
            primaryColdCond15 = false
        if primaryColdCond15:
            bodyEnd = si
            break
    return bodyEnd

# Body extent of an if statement. Unlike the generic structured scan this
# skips the same-line IfCall pseudo statement that a call condition surfaces
# as (it belongs to the if header, not the then-body).
@borrows
fn PrimaryBodyIrIfBodyEnd(irFunction: lower.PrimaryObjectIrFunction,
                           stmtIndex: int32,
                           stmtEndRaw: int32): int32 =
    var stmtEnd = stmtEndRaw
    if stmtEnd > irFunction.statements.len:
        stmtEnd = irFunction.statements.len
    if stmtIndex < 0 || stmtIndex >= stmtEnd:
        return stmtEnd
    let stmt = irFunction.statements[stmtIndex]
    var bodyEnd = stmtEnd
    for si in stmtIndex + 1..<stmtEnd:
        let scanStmt = irFunction.statements[si]
        if scanStmt.kind == texpr.TypedExprIrStmtIfCall:
            continue
        if scanStmt.lineNumber == stmt.lineNumber:
            continue
        var pastBody: bool
        if scanStmt.lineIndent > 0:
            if scanStmt.lineIndent <= stmt.lineIndent:
                pastBody = true
        if pastBody:
            bodyEnd = si
            break
    return bodyEnd

# 头语句条件经节点求值器降级后，同行 Call 孪生语句（其完整调用文本含
# 于条件文本）即为已消费的 feeder：登记进 callFeederEmittedIndexes，
# 防止裸调用入口在循环体/then 体内二次发射（调用必须恰好执行一次）。
@borrows
fn PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction: lower.PrimaryObjectIrFunction,
                                                   stmtIndex: int32,
                                                   stmtEndRaw: int32,
                                                   conditionText: str,
                                                   callFeederEmittedIndexes: var int32[]) =
    if conditionText == "":
        return
    var stmtEnd = stmtEndRaw
    if stmtEnd > irFunction.statements.len:
        stmtEnd = irFunction.statements.len
    if stmtIndex < 0 || stmtIndex >= stmtEnd:
        return
    let headerStmt = irFunction.statements[stmtIndex]
    for feederIndex in 0..<stmtEnd:
        if feederIndex == stmtIndex:
            continue
        let feederStmt = irFunction.statements[feederIndex]
        if feederStmt.lineNumber != headerStmt.lineNumber:
            continue
        if feederStmt.kind != texpr.TypedExprIrStmtCall:
            continue
        let feederFullText = PrimaryBodyIrCallFullText(feederStmt)
        if feederFullText == "":
            continue
        if !strutil.Contains(conditionText, feederFullText):
            continue
        if PrimaryBodyIrIntInList(callFeederEmittedIndexes, feederIndex):
            continue
        add(callFeederEmittedIndexes, feederIndex)

@borrows
fn PrimaryBodyIrBuildForRangeLoop(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    varI32ParamNames: str[],
                                    lowering: lower.LoweringPlanStub,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    nextOpIndex: var int32,
                                    currentBlockStart: var int32,
                                    stmt: lower.PrimaryObjectIrStatement,
                                    stmtIndex: int32,
                                    stmtEnd: int32,
                                    pendingFalseTerm: var int32,
                                    callOrdinal: var int32,
                                    callFeederEmittedIndexes: var int32[]): int32 =
    let headerText = strutil.Strip(stmt.surfaceText)
    let forBodyEnd = PrimaryBodyIrStructuredBodyEnd(irFunction, stmtIndex, stmtEnd)
    var inPos = -1
    var endCheckN = len(headerText) - 3
    for ci in 0..<endCheckN:
        if headerText[ci] == ' ' && headerText[ci + 1] == 'i' && headerText[ci + 2] == 'n' && headerText[ci + 3] == ' ':
            inPos = ci
            break
    var rangeText = strings.CloneStr(headerText)
    if inPos > 0:
        var afterIn = inPos + 4
        var rangeLen = len(headerText) - afterIn
        rangeText = strings.SliceBytes(headerText, afterIn, rangeLen)
        var rLen = len(rangeText)
        if rLen > 0:
            var lastCh = rangeText[rLen - 1]
            if lastCh == ':':
                rangeText = strings.SliceBytes(rangeText, 0, rLen - 1)
        rangeText = strutil.Strip(rangeText)
    var rangeStart: int32
    var rangeEnd = strings.CloneStr(rangeText)
    var exclPos = -1
    var exclHasLe = false
    var exclCheckN = len(rangeText) - 2
    for ci in 0..<exclCheckN:
        if rangeText[ci] == '.' && rangeText[ci + 1] == '.' && rangeText[ci + 2] == '<':
            exclPos = ci
            break
    if exclPos > 0:
        var startText = strings.SliceBytes(rangeText, 0, exclPos)
        var stripped = strutil.Strip(startText)
        rangeStart = PrimaryBodyIrExtractIntFromText(stripped)
        var afterExcl = exclPos + 3
        if exclPos + 3 < len(rangeText) && rangeText[exclPos + 3] == '=':
            exclHasLe = true
            afterExcl = exclPos + 4
        var endLen = len(rangeText) - afterExcl
        rangeEnd = strings.SliceBytes(rangeText, afterExcl, endLen)
        rangeEnd = strutil.Strip(rangeEnd)
    let idxSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, stmt.bindingName, coreir.LocalI32Tag)
    # for-range 节点路径：止界为前端已建节点（rhsNodeIndex），起界须为
    # 整型字面量（与文本路径同 LoadConst 初始化）。止界探针→求值，求值
    # op 全落 preheader（恰好执行一次），header 仅单 Cbr（..< 用 Lt，..
    # 用 Le）。探针失败落回文本路径；求值在调用已发射后失败禁止落回
    #（6101 毒标）。
    if stmt.rhsNodeIndex >= 0 && idxSlot >= 0 && stmt.bindingName != "":
        var forRangeInclusive = false
        var forStartText = ""
        let forRangeCallInner = PrimaryBodyIrWholeCallInnerForHead(rangeText, "range")
        if forRangeCallInner != "":
            let forRangeArgs = texpr.TypedExprSplitTopLevelCsv(forRangeCallInner)
            if forRangeArgs.len == 1:
                forStartText = "0"
            elif forRangeArgs.len == 2:
                forStartText = strutil.Strip(forRangeArgs[0])
        elif exclPos > 0:
            forStartText = strutil.Strip(strings.SliceBytes(rangeText, 0, exclPos))
            if exclHasLe:
                forRangeInclusive = true
        else:
            var forDotPos = -1
            var forDotCheckN = len(rangeText) - 1
            for ci in 0..<forDotCheckN:
                if rangeText[ci] == '.' && rangeText[ci + 1] == '.':
                    forDotPos = ci
                    break
            if forDotPos > 0:
                forRangeInclusive = true
                forStartText = strutil.Strip(strings.SliceBytes(rangeText, 0, forDotPos))
        var forStartConst = 0
        var forStartOk = false
        var forStartNeedsSlot = false
        if forStartText != "":
            forStartConst = PrimaryBodyIrExtractIntFromText(forStartText)
            if forStartConst != 0 || PrimaryBodyIrTextIsI32Zero(forStartText):
                forStartOk = true
            elif !PrimaryBodyIrTextHasCallSurface(forStartText):
                forStartNeedsSlot = true
                forStartOk = true
            elif stmt.forStartNodeIndex >= 0:
                forStartNeedsSlot = true
                forStartOk = true
        var forEndProbeKind = -1
        if forStartOk:
            forEndProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering.typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         stmt.rhsNodeIndex)
        var forStartSlot: int32
        forStartSlot = -1
        if (forEndProbeKind == coreir.LocalI32Tag || forEndProbeKind == coreir.LocalI64Tag) && forStartNeedsSlot:
            # 阶段1 迁移：for-range 起界从文本派发 PrimaryBodyIrScalarValueSlotForText
            # 改为节点求值器 PrimaryBodyIrEvalNode。前端两处（typed_expr 17033/19768）
            # 必以 expected int32 为 range 起界建 forStartNodeIndex；纯 ref/算术起界
            # EvalNode 与文本同槽（25117 直接返回形参/局部槽）。探针放行 i32（起界
            # 节点恒以 int32 建），求值在调用已发射后失败禁止落回（6101 毒标）。
            if stmt.forStartNodeIndex >= 0 &&
               PrimaryBodyIrNodeEvalProbe(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          lowering.typedIr,
                                          typedFn,
                                          irFunction,
                                          stmt.forStartNodeIndex) == coreir.LocalI32Tag:
                let forStartEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                forStartSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering,
                                                     typedFn,
                                                     irFunction,
                                                     stmt.forStartNodeIndex,
                                                     callOrdinal)
                if forStartSlot < 0 &&
                   PrimaryBodyIrNodeEvalCallEmitCountNow() != forStartEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    pendingFalseTerm = -1
                    return forBodyEnd
            if forStartSlot < 0:
                forEndProbeKind = -1
                let _ = PrimaryBodyIrNodeEvalMissAt("for_start_shape")
        # task#18 for-range-i64-bound: 上界是 uint64(maxSize/n)时 probe 出 LocalI64Tag,原门禁
        # 只收 i32 → node_path_skip 落文本。idx 仍 i32、cbr BodyCondI32Lt 读低 32 位(与文本对
        # uint64 上界同款,buffer 尺寸 < INT32_MAX 实际正确),故接 i64 上界走同一发射路径。
        if forEndProbeKind == coreir.LocalI32Tag || forEndProbeKind == coreir.LocalI64Tag:
            let forNodeEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
            let forBoundSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering,
                                                     typedFn,
                                                     irFunction,
                                                     stmt.rhsNodeIndex,
                                                     callOrdinal)
            if forBoundSlot < 0:
                if PrimaryBodyIrNodeEvalCallEmitCountNow() != forNodeEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    pendingFalseTerm = -1
                    return forBodyEnd
            else:
                if forStartSlot >= 0:
                    if !PrimaryBodyIrNodeEvalStore(bodyIR,
                                                   slotNames,
                                                   idxSlot,
                                                   forStartSlot):
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        pendingFalseTerm = -1
                        return forBodyEnd
                else:
                    var forIdxInitOp: coreir.BodyOp
                    forIdxInitOp.kind = coreir.BodyOpLoadConstTag
                    forIdxInitOp.target = idxSlot
                    add(forIdxInitOp.operands, coreir.LocalI32Tag)
                    add(forIdxInitOp.operands, forStartConst)
                    let _ = coreir.BodyIRAppendOp(bodyIR, forIdxInitOp)
                nextOpIndex = nextOpIndex + 1
                var forNodePreBr: coreir.BodyTerm
                forNodePreBr.kind = coreir.BodyTermBrTag
                forNodePreBr.conditionKind = coreir.BodyCondInvalidTag
                forNodePreBr.lhsSlot = -1
                forNodePreBr.rhsSlot = -1
                forNodePreBr.resultSlot = -1
                forNodePreBr.trueBlock = bodyIR.blocks.len + 1
                forNodePreBr.falseBlock = -1
                let forNodePreBrIdx = coreir.BodyIRAppendTerm(bodyIR, forNodePreBr)
                let forNodePreCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, forNodePreCount, forNodePreBrIdx)
                currentBlockStart = bodyIR.ops.len
                var forNodeCbr: coreir.BodyTerm
                forNodeCbr.kind = coreir.BodyTermCbrTag
                forNodeCbr.conditionKind = coreir.BodyCondI32LtTag
                if forRangeInclusive:
                    forNodeCbr.conditionKind = coreir.BodyCondI32LeTag
                forNodeCbr.lhsSlot = idxSlot
                forNodeCbr.rhsSlot = forBoundSlot
                forNodeCbr.resultSlot = -1
                forNodeCbr.trueBlock = -1
                forNodeCbr.falseBlock = -1
                let forNodeCbrIdx = coreir.BodyIRAppendTerm(bodyIR, forNodeCbr)
                let forNodeHdrCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, forNodeHdrCount, forNodeCbrIdx)
                currentBlockStart = bodyIR.ops.len
                pendingFalseTerm = forNodeCbrIdx
                PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction,
                                                               stmtIndex,
                                                               stmtEnd,
                                                               strings.CloneStr(rangeText),
                                                               callFeederEmittedIndexes)
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=for_range function={typedFn.functionName} line={stmt.lineNumber}")
                return forBodyEnd
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            var forNodeMissOpText = PrimaryBodyIrNodeEvalMissOpText()
            if forNodeMissOpText == "":
                forNodeMissOpText = "for_header_shape"
            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={forNodeMissOpText} entry=for function={typedFn.functionName} line={stmt.lineNumber}")
    var initOp: coreir.BodyOp
    initOp.kind = coreir.BodyOpLoadConstTag
    initOp.target = idxSlot
    add(initOp.operands, coreir.LocalI32Tag)
    add(initOp.operands, rangeStart)
    let _ = coreir.BodyIRAppendOp(bodyIR, initOp)
    nextOpIndex = nextOpIndex + 1
    # 循环边界先经标量解析：全局变量需 GlobalLoad 物化，
    # 裸 FindOrCreateSlot 会造出永不写入的孤儿槽（读到随机栈垃圾）。
    var boundSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        lowering.typedIr,
                                                        stmt.sourcePath,
                                                        rangeEnd,
                                                        coreir.LocalI32Tag,
                                                        callOrdinal)
    if boundSlot < 0:
        boundSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, rangeEnd, coreir.LocalI32Tag)
    # preheader: 初始化只执行一次，回边只回到纯检查的 header 块
    var preBrTerm: coreir.BodyTerm
    preBrTerm.kind = coreir.BodyTermBrTag
    preBrTerm.conditionKind = coreir.BodyCondInvalidTag
    preBrTerm.lhsSlot = -1
    preBrTerm.rhsSlot = -1
    preBrTerm.resultSlot = -1
    preBrTerm.trueBlock = bodyIR.blocks.len + 1
    preBrTerm.falseBlock = -1
    let preBrIdx = coreir.BodyIRAppendTerm(bodyIR, preBrTerm)
    let preBlockCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, preBlockCount, preBrIdx)
    currentBlockStart = bodyIR.ops.len
    var cbrTerm: coreir.BodyTerm
    cbrTerm.kind = coreir.BodyTermCbrTag
    cbrTerm.conditionKind = coreir.BodyCondI32LtTag
    if exclHasLe:
        cbrTerm.conditionKind = coreir.BodyCondI32LeTag
    cbrTerm.lhsSlot = idxSlot
    cbrTerm.rhsSlot = boundSlot
    cbrTerm.resultSlot = -1
    cbrTerm.trueBlock = -1
    cbrTerm.falseBlock = -1
    let cbrIdx = coreir.BodyIRAppendTerm(bodyIR, cbrTerm)
    let blockCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, blockCount, cbrIdx)
    currentBlockStart = bodyIR.ops.len
    pendingFalseTerm = cbrIdx
    return forBodyEnd

@borrows
fn PrimaryBodyIrBuildWhileLoopHeader(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      varI32ParamNames: str[],
                                      lowering: lower.LoweringPlanStub,
                                      nextOpIndex: var int32,
                                      currentBlockStart: var int32,
                                      typedFn: texpr.TypedExprIrFunction,
                                      irFunction: lower.PrimaryObjectIrFunction,
                                      stmt: lower.PrimaryObjectIrStatement,
                                      stmtIndex: int32,
                                      stmtEnd: int32,
                                      callOrdinal: var int32,
                                      pendingWhileHeaderBlock: var int32,
                                      pendingWhileCbrTerm: var int32,
                                      pendingWhileFalseTerms: var int32[],
                                      callFeederEmittedIndexes: var int32[]): int32 =
    let whileBodyEnd = PrimaryBodyIrStructuredBodyEnd(irFunction, stmtIndex, stmtEnd)
    let condText = PrimaryBodyIrConditionText(stmt.surfaceText)
    # preheader: 把循环前的 op 关进独立块，header 只含条件求值，回边才安全
    var whilePreBr: coreir.BodyTerm
    whilePreBr.kind = coreir.BodyTermBrTag
    whilePreBr.conditionKind = coreir.BodyCondInvalidTag
    whilePreBr.lhsSlot = -1
    whilePreBr.rhsSlot = -1
    whilePreBr.resultSlot = -1
    whilePreBr.trueBlock = bodyIR.blocks.len + 1
    whilePreBr.falseBlock = -1
    let whilePreBrIdx = coreir.BodyIRAppendTerm(bodyIR, whilePreBr)
    let whilePreCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, whilePreCount, whilePreBrIdx)
    currentBlockStart = bodyIR.ops.len
    if condText == "true":
        let trueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"while_true#{stmt.lineNumber}",
                                                     coreir.LocalI32Tag)
        var trueOp: coreir.BodyOp
        trueOp.kind = coreir.BodyOpLoadConstTag
        trueOp.target = trueSlot
        add(trueOp.operands, coreir.LocalI32Tag)
        add(trueOp.operands, 1)
        let _ = coreir.BodyIRAppendOp(bodyIR, trueOp)
        nextOpIndex = nextOpIndex + 1
        var cbrTermTrue: coreir.BodyTerm
        cbrTermTrue.kind = coreir.BodyTermCbrTag
        cbrTermTrue.conditionKind = coreir.BodyCondLocalNonZeroTag
        cbrTermTrue.lhsSlot = trueSlot
        cbrTermTrue.rhsSlot = -1
        cbrTermTrue.resultSlot = -1
        cbrTermTrue.trueBlock = -1
        cbrTermTrue.falseBlock = -1
        let cbrTermTrueIndex = coreir.BodyIRAppendTerm(bodyIR, cbrTermTrue)
        let cbrTrueBlockOpCount = bodyIR.ops.len - currentBlockStart
        pendingWhileHeaderBlock = coreir.BodyIRAppendBlock(bodyIR,
                                                           currentBlockStart,
                                                           cbrTrueBlockOpCount,
                                                           cbrTermTrueIndex)
        pendingWhileCbrTerm = cbrTermTrueIndex
        currentBlockStart = bodyIR.ops.len
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=while_true function={typedFn.functionName} line={stmt.lineNumber}")
        return whileBodyEnd
    # 批次6e：条件已节点化且探针可降（i32/bool）时经节点求值器产出条件
    # 槽，header 单块单 Cbr（nonzero），回边/出口补丁走既有 CloseWhileLoop
    # 管线。探针失败落回文本路径；求值在调用已发射后失败禁止落回。
    if stmt.rhsNodeIndex >= 0:
        PrimaryBodyIrNodeEvalMissOpReset()
        let whileNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering.typedIr,
                                                            typedFn,
                                                            irFunction,
                                                            stmt.rhsNodeIndex)
        if whileNodeProbeKind == coreir.LocalI32Tag:
            let whileNodeEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
            let whileNodeCondSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          stmt.rhsNodeIndex,
                                                          callOrdinal)
            if whileNodeCondSlot >= 0:
                pendingWhileFalseTerms = []
                var whileNodeCbrTerm: coreir.BodyTerm
                whileNodeCbrTerm.kind = coreir.BodyTermCbrTag
                whileNodeCbrTerm.conditionKind = coreir.BodyCondLocalNonZeroTag
                whileNodeCbrTerm.lhsSlot = whileNodeCondSlot
                whileNodeCbrTerm.rhsSlot = -1
                whileNodeCbrTerm.resultSlot = -1
                whileNodeCbrTerm.trueBlock = -1
                whileNodeCbrTerm.falseBlock = -1
                let whileNodeTermIndex = coreir.BodyIRAppendTerm(bodyIR, whileNodeCbrTerm)
                let whileNodeBlockOpCount = bodyIR.ops.len - currentBlockStart
                pendingWhileHeaderBlock = coreir.BodyIRAppendBlock(bodyIR,
                                                                   currentBlockStart,
                                                                   whileNodeBlockOpCount,
                                                                   whileNodeTermIndex)
                pendingWhileCbrTerm = whileNodeTermIndex
                currentBlockStart = bodyIR.ops.len
                PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction,
                                                               stmtIndex,
                                                               stmtEnd,
                                                               strings.CloneStr(condText),
                                                               callFeederEmittedIndexes)
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=while_cond function={typedFn.functionName} line={stmt.lineNumber}")
                return whileBodyEnd
            if PrimaryBodyIrNodeEvalCallEmitCountNow() != whileNodeEmitMark:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             6101,
                                             0)
                pendingWhileHeaderBlock = -1
                pendingWhileCbrTerm = -1
                return whileBodyEnd
        let whileNodeRootOp = lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex]
        if whileNodeRootOp == texpr.TypedExprIrOpLogAnd ||
           whileNodeRootOp == texpr.TypedExprIrOpLogOr:
            if PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               stmt.rhsNodeIndex):
                let whileChainCount = PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, stmt.rhsNodeIndex)
                if whileChainCount > 1:
                    let whileChainEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                    let whileChainBlocksMark = bodyIR.blocks.len
                    pendingWhileFalseTerms = []
                    pendingWhileHeaderBlock = bodyIR.blocks.len
                    let whileChainSuccessBlock = bodyIR.blocks.len + whileChainCount
                    if PrimaryBodyIrNodeEmitCondCbrChain(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,
                                                         typedFn,
                                                         irFunction,
                                                         stmt.rhsNodeIndex,
                                                         whileChainSuccessBlock,
                                                         -1,
                                                         callOrdinal,
                                                         currentBlockStart,
                                                         pendingWhileFalseTerms):
                        if pendingWhileFalseTerms.len > 0:
                            pendingWhileCbrTerm = pendingWhileFalseTerms[pendingWhileFalseTerms.len - 1]
                        PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction,
                                                                       stmtIndex,
                                                                       stmtEnd,
                                                                       strings.CloneStr(condText),
                                                                       callFeederEmittedIndexes)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=while_cond_chain function={typedFn.functionName} line={stmt.lineNumber}")
                        return whileBodyEnd
                    if PrimaryBodyIrNodeEvalCallEmitCountNow() != whileChainEmitMark ||
                       bodyIR.blocks.len != whileChainBlocksMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        pendingWhileHeaderBlock = -1
                        pendingWhileCbrTerm = -1
                        return whileBodyEnd
                    pendingWhileHeaderBlock = -1
                    pendingWhileFalseTerms = []
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            var whileNodeMissOpText = PrimaryBodyIrNodeEvalMissOpText()
            if whileNodeMissOpText == "":
                whileNodeMissOpText = "cond_shape"
            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={whileNodeMissOpText} entry=while_cond function={typedFn.functionName} line={stmt.lineNumber}")
    pendingWhileFalseTerms = []
    let conditionBlockCount = PrimaryBodyIrConditionCbrBlockCount(condText)
    if conditionBlockCount > 0:
        pendingWhileHeaderBlock = bodyIR.blocks.len
        let successBlock = bodyIR.blocks.len + conditionBlockCount
        if PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                             slotNames,
                                             lowering,
                                             typedFn,
                                             irFunction,
                                             stmt.sourcePath,
                                             stmt.lineNumber,
                                             stmt.rhsNodeIndex,
                                             condText,
                                             successBlock,
                                             -1,
                                             callOrdinal,
                                             nextOpIndex,
                                             currentBlockStart,
                                             pendingWhileFalseTerms):
            if pendingWhileFalseTerms.len > 0:
                pendingWhileCbrTerm = pendingWhileFalseTerms[pendingWhileFalseTerms.len - 1]
            return whileBodyEnd
    var lhsSlot: int32
    var rhsSlot: int32
    var cmpTag: int32
    if !PrimaryBodyIrEmitConditionOps(bodyIR,
                                      slotNames,
                                      lowering,
                                      typedFn,
                                      irFunction,
                                      stmt.sourcePath,
                                      stmt.lineNumber,
                                      stmt.rhsNodeIndex,
                                      condText,
                                      lhsSlot,
                                      rhsSlot,
                                      cmpTag,
                                      callOrdinal,
                                      nextOpIndex):
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     81,
                                     0)
        pendingWhileHeaderBlock = -1
        pendingWhileCbrTerm = -1
        return whileBodyEnd
    var cbrTerm: coreir.BodyTerm
    cbrTerm.kind = coreir.BodyTermCbrTag
    cbrTerm.conditionKind = cmpTag
    cbrTerm.lhsSlot = lhsSlot
    cbrTerm.rhsSlot = rhsSlot
    cbrTerm.resultSlot = -1
    cbrTerm.trueBlock = -1
    cbrTerm.falseBlock = -1
    let cbrTermIndex = coreir.BodyIRAppendTerm(bodyIR, cbrTerm)
    let cbrBlockOpCount = bodyIR.ops.len - currentBlockStart
    pendingWhileHeaderBlock = coreir.BodyIRAppendBlock(bodyIR,
                                                       currentBlockStart,
                                                       cbrBlockOpCount,
                                                       cbrTermIndex)
    pendingWhileCbrTerm = cbrTermIndex
    currentBlockStart = bodyIR.ops.len
    return whileBodyEnd

@borrows
fn PrimaryBodyIrCloseWhileLoop(bodyIR: var coreir.BodyIR,
                                currentBlockStart: var int32,
                                pendingWhileHeaderBlock: int32,
                                pendingWhileCbrTerm: int32,
                                pendingWhileFalseTerms: var int32[]): bool =
    if pendingWhileHeaderBlock < 0 ||
       pendingWhileHeaderBlock >= bodyIR.blocks.len ||
       pendingWhileCbrTerm < 0 ||
       pendingWhileCbrTerm >= bodyIR.terms.len:
        return false
    var brTerm: coreir.BodyTerm
    brTerm.kind = coreir.BodyTermBrTag
    brTerm.trueBlock = pendingWhileHeaderBlock
    brTerm.falseBlock = -1
    brTerm.conditionKind = coreir.BodyCondInvalidTag
    brTerm.lhsSlot = -1
    brTerm.rhsSlot = -1
    brTerm.resultSlot = -1
    let brTermIndex = coreir.BodyIRAppendTerm(bodyIR, brTerm)
    let backBlockCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, backBlockCount, brTermIndex)
    currentBlockStart = bodyIR.ops.len
    if bodyIR.terms[pendingWhileCbrTerm].trueBlock < 0:
        bodyIR.terms[pendingWhileCbrTerm].trueBlock = pendingWhileHeaderBlock + 1
    if bodyIR.terms[pendingWhileCbrTerm].falseBlock < 0:
        bodyIR.terms[pendingWhileCbrTerm].falseBlock = bodyIR.blocks.len
    for ti in 0..<pendingWhileFalseTerms.len:
        let falseTermIndex = pendingWhileFalseTerms[ti]
        if falseTermIndex >= 0 && falseTermIndex < bodyIR.terms.len:
            if bodyIR.terms[falseTermIndex].falseBlock < 0:
                bodyIR.terms[falseTermIndex].falseBlock = bodyIR.blocks.len
    return true

fn PrimaryBodyIrCloseIfTop(bodyIR: var coreir.BodyIR,
                            currentBlockStart: var int32,
                            ifEndStk: var int32[],
                            ifSeqStk: var int32[],
                            ifIndentStk: var int32[],
                            ifFalseStartStk: var int32[],
                            ifFalsePool: var int32[],
                            ifJoinStartStk: var int32[],
                            ifJoinBrPool: var int32[]) =
    let top = ifEndStk.len - 1
    if top < 0:
        return
    var joinBr: coreir.BodyTerm
    joinBr.kind = coreir.BodyTermBrTag
    joinBr.conditionKind = coreir.BodyCondInvalidTag
    joinBr.lhsSlot = -1
    joinBr.rhsSlot = -1
    joinBr.resultSlot = -1
    joinBr.trueBlock = bodyIR.blocks.len + 1
    joinBr.falseBlock = -1
    let joinBrIdx = coreir.BodyIRAppendTerm(bodyIR, joinBr)
    let tailCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, tailCount, joinBrIdx)
    currentBlockStart = bodyIR.ops.len
    let joinBlock = bodyIR.blocks.len
    for fi in ifFalseStartStk[top]..<ifFalsePool.len:
        if ifFalsePool[fi] >= 0 &&
           ifFalsePool[fi] < bodyIR.terms.len &&
           bodyIR.terms[ifFalsePool[fi]].falseBlock < 0:
            bodyIR.terms[ifFalsePool[fi]].falseBlock = joinBlock
    for ji in ifJoinStartStk[top]..<ifJoinBrPool.len:
        if ifJoinBrPool[ji] >= 0 &&
           ifJoinBrPool[ji] < bodyIR.terms.len &&
           bodyIR.terms[ifJoinBrPool[ji]].trueBlock < 0:
            bodyIR.terms[ifJoinBrPool[ji]].trueBlock = joinBlock
    setLen(ifFalsePool, ifFalseStartStk[top])
    setLen(ifJoinBrPool, ifJoinStartStk[top])
    setLen(ifEndStk, top)
    setLen(ifSeqStk, top)
    setLen(ifIndentStk, top)
    setLen(ifFalseStartStk, top)
    setLen(ifJoinStartStk, top)

fn PrimaryBodyIrCloseLoopTop(bodyIR: var coreir.BodyIR,
                              slotNames: var str[],
                              nextOpIndex: var int32,
                              currentBlockStart: var int32,
                              loopKindStk: var int32[],
                              loopEndStk: var int32[],
                              loopAStk: var int32[],
                              loopBStk: var int32[],
                              loopCStk: var int32[],
                              loopFalseStartStk: var int32[],
                              loopFalsePool: var int32[],
                              loopBreakStartStk: var int32[],
                              loopBreakPool: var int32[],
                              loopContinueStartStk: var int32[],
                              loopContinuePool: var int32[]): int32 =
    let top = loopKindStk.len - 1
    if top < 0:
        return 0
    let kind = loopKindStk[top]
    let breakStart = loopBreakStartStk[top]
    let continueStart = loopContinueStartStk[top]
    let falseStart = loopFalseStartStk[top]
    if kind == 1:
        let idxSlot = loopAStk[top]
        let hdrBlk = loopBStk[top]
        let cbrTerm = loopCStk[top]
        # The loop latch (increment + back-branch) must be its OWN block so that
        # `continue` lands ONLY on the increment, not on the trailing body
        # statements that precede it. Previously the trailing body ops and the
        # increment shared one block, so `continue` (targeting that block) re-ran
        # the trailing statements (`for i: if c: continue; hits=hits+1` counted
        # the skipped iterations). Close the trailing body block first with a Br
        # into the fresh latch block.
        var bodyToLatchTerm: coreir.BodyTerm
        bodyToLatchTerm.kind = coreir.BodyTermBrTag
        bodyToLatchTerm.trueBlock = bodyIR.blocks.len + 1
        bodyToLatchTerm.falseBlock = -1
        bodyToLatchTerm.conditionKind = coreir.BodyCondInvalidTag
        bodyToLatchTerm.lhsSlot = -1
        bodyToLatchTerm.rhsSlot = -1
        bodyToLatchTerm.resultSlot = -1
        let bodyToLatchIdx = coreir.BodyIRAppendTerm(bodyIR, bodyToLatchTerm)
        let bodyTrailingCount = bodyIR.ops.len - currentBlockStart
        let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, bodyTrailingCount, bodyToLatchIdx)
        currentBlockStart = bodyIR.ops.len
        let continueBlock = bodyIR.blocks.len
        var oneSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, "_for_one", coreir.LocalI32Tag)
        var oneInit: coreir.BodyOp
        oneInit.kind = coreir.BodyOpLoadConstTag
        oneInit.target = oneSlot
        add(oneInit.operands, coreir.LocalI32Tag)
        add(oneInit.operands, 1)
        let _ = coreir.BodyIRAppendOp(bodyIR, oneInit)
        nextOpIndex = nextOpIndex + 1
        var incOp: coreir.BodyOp
        incOp.kind = coreir.BodyOpBinOpTag
        incOp.target = idxSlot
        add(incOp.operands, coreir.LocalI32Tag)
        add(incOp.operands, int32(texpr.TypedExprIrOpI32Add))
        add(incOp.operands, idxSlot)
        add(incOp.operands, oneSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, incOp)
        nextOpIndex = nextOpIndex + 1
        var brTerm: coreir.BodyTerm
        brTerm.kind = coreir.BodyTermBrTag
        brTerm.trueBlock = hdrBlk
        brTerm.falseBlock = -1
        brTerm.conditionKind = coreir.BodyCondInvalidTag
        brTerm.lhsSlot = -1
        brTerm.rhsSlot = -1
        brTerm.resultSlot = -1
        let brIdx = coreir.BodyIRAppendTerm(bodyIR, brTerm)
        let backCount = bodyIR.ops.len - currentBlockStart
        let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, backCount, brIdx)
        currentBlockStart = bodyIR.ops.len
        if cbrTerm >= 0 && cbrTerm < bodyIR.terms.len:
            bodyIR.terms[cbrTerm].falseBlock = bodyIR.blocks.len
        let exitBlock = bodyIR.blocks.len
        for bti in breakStart..<loopBreakPool.len:
            if loopBreakPool[bti] >= 0 && loopBreakPool[bti] < bodyIR.terms.len:
                bodyIR.terms[loopBreakPool[bti]].trueBlock = exitBlock
        for cti in continueStart..<loopContinuePool.len:
            if loopContinuePool[cti] >= 0 && loopContinuePool[cti] < bodyIR.terms.len:
                bodyIR.terms[loopContinuePool[cti]].trueBlock = continueBlock
    else:
        let headerBlock = loopAStk[top]
        let whileCbrTerm = loopBStk[top]
        let lineNumber = loopCStk[top]
        var whileFalseSlice: int32[]
        for fi in falseStart..<loopFalsePool.len:
            add(whileFalseSlice, loopFalsePool[fi])
        let closedWhile = PrimaryBodyIrCloseWhileLoop(bodyIR,
                                                      currentBlockStart,
                                                      headerBlock,
                                                      whileCbrTerm,
                                                      whileFalseSlice)
        if !closedWhile:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         lineNumber,
                                         int32(texpr.TypedExprIrStmtWhile),
                                         82,
                                         0)
        else:
            let whileExitBlock = bodyIR.blocks.len
            for bti in breakStart..<loopBreakPool.len:
                if loopBreakPool[bti] >= 0 && loopBreakPool[bti] < bodyIR.terms.len:
                    bodyIR.terms[loopBreakPool[bti]].trueBlock = whileExitBlock
            for cti in continueStart..<loopContinuePool.len:
                if loopContinuePool[cti] >= 0 && loopContinuePool[cti] < bodyIR.terms.len:
                    bodyIR.terms[loopContinuePool[cti]].trueBlock = headerBlock
    setLen(loopBreakPool, breakStart)
    setLen(loopContinuePool, continueStart)
    setLen(loopFalsePool, falseStart)
    setLen(loopKindStk, top)
    setLen(loopEndStk, top)
    setLen(loopAStk, top)
    setLen(loopBStk, top)
    setLen(loopCStk, top)
    setLen(loopFalseStartStk, top)
    setLen(loopBreakStartStk, top)
    setLen(loopContinueStartStk, top)
    return kind

# Same-line statement index (CSR layout). The body-IR builder runs ~21
# per-statement scans of the form `for X in 0..<stmtEnd: if
# statements[X].lineNumber != stmt.lineNumber: continue` — each O(N), so the
# whole loop is O(N²) per function (the second NODE_EVAL_ONLY census O(n²)
# hotspot). Build, once per function in O(N log N), an order array sorting
# statement indices by (lineNumber, originalIndex) plus, for every statement,
# the [lo,hi) range into that order array covering its line group. A same-line
# scan then iterates `for p in lineLo[i]..<lineHi[i]: let X = lineOrder[p]`,
# visiting exactly the same indices in the same ascending order — identical IR.
@borrows
fn PrimaryBodyIrSameLineOrderLess(irFunction: lower.PrimaryObjectIrFunction,
                                  a: int32,
                                  b: int32): bool =
    let la = irFunction.statements[a].lineNumber
    let lb = irFunction.statements[b].lineNumber
    if la != lb:
        return la < lb
    return a < b

@borrows
fn PrimaryBodyIrSameLineOrderMergePass(irFunction: lower.PrimaryObjectIrFunction,
                                       src: var int32[],
                                       dst: var int32[],
                                       width: int32) =
    let count = src.len
    var leftStart: int32
    while leftStart < count:
        if leftStart % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let midRaw = leftStart + width
        var mid = count
        if midRaw < count:
            mid = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = mid
        for outIndex in leftStart..<rightEnd:
            if outIndex % 4096 == 0:
                os.ProcessResourceGuardCheck()
            if left < mid &&
               (right >= rightEnd ||
                !PrimaryBodyIrSameLineOrderLess(irFunction, src[right], src[left])):
                dst[outIndex] = src[left]
                left = left + 1
            else:
                dst[outIndex] = src[right]
                right = right + 1
        leftStart = leftStart + width * 2

# Builds lineOrder (statement indices sorted by line) plus lineLo/lineHi
# (length stmtEnd) giving each statement the [lo,hi) range in lineOrder that
# covers all statements sharing its lineNumber. lineLo/lineHi are indexed by
# the ORIGINAL statement index (not the sorted position) so callers key them
# with stmtIndex directly.
@borrows
fn PrimaryBodyIrBuildSameLineIndex(irFunction: lower.PrimaryObjectIrFunction,
                                   lineOrder: var int32[],
                                   lineLo: var int32[],
                                   lineHi: var int32[]) =
    let count = irFunction.statements.len
    lineOrder = []
    lineLo = []
    lineHi = []
    for i in 0..<count:
        add(lineOrder, i)
        add(lineLo, 0)
        add(lineHi, 0)
    if count <= 1:
        if count == 1:
            lineLo[0] = 0
            lineHi[0] = 1
        return
    var scratch: int32[]
    for i in 0..<count:
        add(scratch, lineOrder[i])
    var width: int32 = 1
    var readScratch = false
    while width < count:
        if readScratch:
            PrimaryBodyIrSameLineOrderMergePass(irFunction, scratch, lineOrder, width)
        else:
            PrimaryBodyIrSameLineOrderMergePass(irFunction, lineOrder, scratch, width)
        readScratch = !readScratch
        if width > count / 2:
            width = count
        else:
            width = width * 2
    if readScratch:
        for i in 0..<count:
            lineOrder[i] = scratch[i]
    # Walk the sorted order assigning each contiguous same-line run its
    # [lo,hi) range, keyed back to the original statement index.
    var runStart: int32
    while runStart < count:
        var runEnd = runStart + 1
        let runLine = irFunction.statements[lineOrder[runStart]].lineNumber
        while runEnd < count && irFunction.statements[lineOrder[runEnd]].lineNumber == runLine:
            runEnd = runEnd + 1
        for p in runStart..<runEnd:
            lineLo[lineOrder[p]] = runStart
            lineHi[lineOrder[p]] = runEnd
        runStart = runEnd

# 同行语句排序二级键：控制流头返回 0（靠前），体/其他返回 1。
# 用于源行稳定排序时确保 `if/elif/...` 头排在其同行体（return/assign）之前。
@borrows
fn PrimaryBodyIrStmtHeaderSortPriority(kind: texpr.TypedExprIrStatementKind): int32 =
    if kind == texpr.TypedExprIrStmtIf ||
       kind == texpr.TypedExprIrStmtElif ||
       kind == texpr.TypedExprIrStmtElse ||
       kind == texpr.TypedExprIrStmtIfCall ||
       kind == texpr.TypedExprIrStmtMatch ||
       kind == texpr.TypedExprIrStmtCase ||
       kind == texpr.TypedExprIrStmtFor ||
       kind == texpr.TypedExprIrStmtWhile:
        return 0
    return 1
