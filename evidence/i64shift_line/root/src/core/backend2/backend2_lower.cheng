# backend2_lower — lower 收割 W4 悬崖波前半 (manifest_w0: file=lower 全部 44fn/7,916 loc)。
# 函数体逐字复制自 src/core/backend/primary_object_plan.cheng (source_sha256 ee2cbff6…,
# 抽取时 44/44 body_sha256==manifest)。调用引用: 集内直名; slots/util 档直名经下方两行
# alias-free import; 调未收割 pobj fn = 0 (manifest 闭包完备, 本档零 pobj import)。
# 体文本编辑账 (仅一类: 协议 var 单侧化 accessor 接线, 逐行机器计数验证, 其余逐字):
#   (a) `primaryBodyIrNodeEvalMissOp = ""` → PrimaryBodyIrNodeEvalMissOpReset() ×12;
#       读位 token → PrimaryBodyIrNodeEvalMissOpText() ×7 (util 档 owner accessor);
#   (b) primaryBodyIrNodeEvalCallEmitCount 读位 token → PrimaryBodyIrNodeEvalCallEmitCountNow()
#       ×28 (slots 档 owner accessor; 本档对该 var 零写, 断言过)。
# 编辑动机 (W4 一致性审计②): 跨模块 var 写 bail=710/631 (W1 实测); 无本地 decl 的读走
# pobjp GlobalNameResolve nonExactCount%2 奇偶绑定 (不可依赖) → 分裂副本对控制流载荷
# (MissOp/callEmitCount 是 node-eval 成败判据) 必 desync → 唯一严谨解 = 单侧归口 + accessor。
# 分裂态全局 = 0: 本档触达的 4 个协议 var 全 accessor 化, 不持副本。

import std/os
import std/cmdline
import std/result
import std/strings
import std/strutils as strutil
import std/strformat
import std/atomic
import std/thread
import std/hashmaps
import cheng/core/tooling/compiler_request as creq
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/target_matrix as tmat
import cheng/core/tooling/path as chengpath
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_noalias as noalias
import cheng/core/ir/body_ir_egraph as egraph
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/lang/intern as langintern
import cheng/core/runtime/arena as arenamod
import cheng/core/backend2/backend2_lower_util
import cheng/core/backend2/backend2_lower_slots

@borrows
fn PrimaryBodyIrPatchCallTargetSymbols(bodyIR: var coreir.BodyIR,
                                         callTargets: str[],
                                         callImportcSymbols: str[]) =
    var sourceOrdinal: int32
    for ci in 0..<bodyIR.callSequence.len:
        let existingSymbol = bodyIR.callSequence[ci].targetSymbol
        var expectedTarget = ""
        if sourceOrdinal < callTargets.len:
            expectedTarget = callTargets[sourceOrdinal]
        var expectedImportc = ""
        if sourceOrdinal < callImportcSymbols.len:
            expectedImportc = callImportcSymbols[sourceOrdinal]
        if PrimaryBodyIrDirectExternalCallTarget(existingSymbol):
            # @importc call: BodyIR has Cheng alias (e.g. socketConnect),
            # lowering has C symbol (e.g. libc_connect).
            # Patch targetSymbol to match lowering convention,
            # and always advance sourceOrdinal.
            if len(expectedImportc) > 0:
                if expectedImportc != existingSymbol:
                    bodyIR.callSequence[ci].targetSymbol = share(expectedImportc)
                sourceOrdinal = sourceOrdinal + 1
            continue
        if !PrimaryBodyIrPatchTargetMatchesExisting(existingSymbol,
                                                    expectedTarget,
                                                    expectedImportc):
            var matchedOrdinal: int32
            matchedOrdinal = -1
            for scanOrdinal in sourceOrdinal..<callTargets.len:
                var scanTarget = ""
                var scanImportc = ""
                if scanOrdinal < callTargets.len:
                    scanTarget = callTargets[scanOrdinal]
                if scanOrdinal < callImportcSymbols.len:
                    scanImportc = callImportcSymbols[scanOrdinal]
                if PrimaryBodyIrPatchTargetMatchesExisting(existingSymbol,
                                                           scanTarget,
                                                           scanImportc):
                    matchedOrdinal = scanOrdinal
                    break
            if matchedOrdinal < 0:
                for scanOrdinal in 0..<sourceOrdinal:
                    var scanTarget = ""
                    var scanImportc = ""
                    if scanOrdinal < callTargets.len:
                        scanTarget = callTargets[scanOrdinal]
                    if scanOrdinal < callImportcSymbols.len:
                        scanImportc = callImportcSymbols[scanOrdinal]
                    if PrimaryBodyIrPatchTargetMatchesExisting(existingSymbol,
                                                               scanTarget,
                                                               scanImportc):
                        matchedOrdinal = scanOrdinal
                        break
            if matchedOrdinal < 0:
                continue
            sourceOrdinal = matchedOrdinal
            expectedTarget = callTargets[sourceOrdinal]
            if sourceOrdinal < callImportcSymbols.len:
                expectedImportc = callImportcSymbols[sourceOrdinal]
        var targetSymbol = ""
        if len(expectedImportc) > 0:
            targetSymbol = expectedImportc
        elif len(expectedTarget) > 0:
            targetSymbol = expectedTarget
        if targetSymbol == "assert" && (existingSymbol == "assertPtrBridge" || existingSymbol == "assertPtrBridgeRuntime" || existingSymbol == "std/system::assert"):
            targetSymbol = "assert"
        if targetSymbol == "Assert" && (existingSymbol == "AssertPtrBridge" || existingSymbol == "assertPtrBridgeRuntime" || existingSymbol == "std/system::Assert"):
            targetSymbol = "Assert"
        if (targetSymbol == "echo" || targetSymbol == "Echo") && existingSymbol == "puts":
            targetSymbol = existingSymbol
        if targetSymbol == "StrDataPtr" && existingSymbol == "std/system::StrDataPtr":
            targetSymbol = existingSymbol
        if len(targetSymbol) > 0:
            bodyIR.callSequence[ci].targetSymbol = share(targetSymbol)
        if sourceOrdinal < callTargets.len:
            sourceOrdinal = sourceOrdinal + 1

@borrows
fn PrimaryBodyIrAppendReturnTerm(bodyIR: var coreir.BodyIR,
                                  currentBlockStart: var int32,
                                  resultSlot: int32,
                                  resultTypeKind: int32,
                                  constValue: int32,
                                  hasConst: bool) =
    var retTerm: coreir.BodyTerm
    retTerm.kind = coreir.BodyTermReturnTag
    retTerm.resultSlot = resultSlot
    if hasConst:
        add(retTerm.operands, PrimaryStatementReturnModeI32Const())
        add(retTerm.operands, constValue)
    else:
        add(retTerm.operands, resultTypeKind)
    let retTermIndex = coreir.BodyIRAppendTerm(bodyIR, retTerm)
    let blockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, blockOpCount, retTermIndex)
    currentBlockStart = bodyIR.ops.len

@borrows
fn PrimaryBodyIrAppendUnsupportedEchoFmtCall(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             callExprRaw: str,
                                             lineNumber: int32,
                                             callOrdinal: var int32): bool =
    let callExpr = strutil.Strip(callExprRaw)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    if closePos <= openPos || closePos + 1 != len(callExpr):
        return false
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if callHead != "echo" && callHead != "Echo" && callHead != "puts":
        return false
    let callArgsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let argNames = PrimaryBodyIrCallArgNames(callArgsText)
    if argNames.len != 1:
        return false
    let fmtArgText = strutil.Strip(argNames[0])
    var echoPayload = PrimaryBodyIrFmtLiteralPayload(fmtArgText)
    if echoPayload == "":
        # 普通字符串字面量臂: exe_entry typed_ir 子集无 std/system::echo 记录时,
        # "..." 字面量自包含落地(与 Fmt 纯文本共用 puts 路径); plain string 不插值,
        # 左花括号按字面落地, 不做花括号判定。非字面量实参仍 return false → poison。
        if !PrimaryBodyIrTextIsStringLiteral(fmtArgText):
            return false
        echoPayload = PrimaryBodyIrStringLiteralPayload(fmtArgText)
    elif strutil.Contains(echoPayload, "{"):
        # 仅纯文本 Fmt(无 {expr} 插值)落地;含插值需 EvalNode 而本路径
        # rhsNodeIndex 缺失,让其落回 InvalidOp bail(poison-on-miss)。
        return false
    let echoLiteralId = coreir.BodyIRAppendCStringLiteral(bodyIR, echoPayload, "")
    let echoVoidSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#echo_fmt_void#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalI32Tag)
    if echoVoidSlot < 0:
        return false
    var echoCall: coreir.CallOp
    echoCall.targetSymbol = "puts"
    echoCall.resultSlot = echoVoidSlot
    echoCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(echoCall.argSlots, coreir.CallArgSlotCString(echoLiteralId))
    add(echoCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, echoCall)
    var echoOp: coreir.BodyOp
    echoOp.kind = coreir.BodyOpCallTag
    echoOp.target = echoVoidSlot
    add(echoOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, echoOp)
    callOrdinal = callOrdinal + 1
    return true

@borrows
fn PrimaryBodyIrAppendWholeCallStatement(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          lowering: lower.LoweringPlanStub,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: var lower.PrimaryObjectIrFunction,
                                          varI32ParamNames: str[],
                                          callExprRaw: str,
                                          lineNumber: int32,
                                          callNodeIndex: int32,
                                          callOrdinal: var int32): bool =
    let callExpr = strutil.Strip(callExprRaw)
    if B2PrimaryObjectPlanTraceActive():
        B2PrimaryObjectPlanTrace(Fmt"whole_call_statement_probe function={typedFn.functionName} line={lineNumber} expr={callExpr}")
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"whole_call_statement_skip function={typedFn.functionName} line={lineNumber} reason=open")
        return false
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    if closePos <= openPos || closePos + 1 != len(callExpr):
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"whole_call_statement_skip function={typedFn.functionName} line={lineNumber} reason=close close={closePos} len={callExpr.len}")
        return false
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"whole_call_statement_skip function={typedFn.functionName} line={lineNumber} reason=head head={callHead}")
        return false
    let callArgsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let callArgCount = PrimaryBodyIrCallArgNames(callArgsText).len
    var callResultType = ""
    let resolvedOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                            lowering,
                                                                            callNodeIndex,
                                                                            callArgCount,
                                                                            callResultType)
    if resolvedOrdinal < 0 ||
       resolvedOrdinal >= irFunction.callTargets.len ||
       resolvedOrdinal >= irFunction.callTargetSourcePaths.len ||
       resolvedOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
       resolvedOrdinal >= irFunction.callTargetImportcFlags.len:
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"whole_call_statement_skip function={typedFn.functionName} line={lineNumber} reason=resolve head={callHead} argc={callArgCount} ordinal={resolvedOrdinal} targets={irFunction.callTargets.len}")
        return false
    if callResultType == "" || callResultType == "unknown":
        callResultType = "void"
    var stmt: lower.PrimaryObjectIrStatement
    stmt.sourcePath = typedFn.sourcePath
    stmt.functionName = typedFn.functionName
    stmt.lineNumber = lineNumber
    stmt.lineIndent = 0
    stmt.kind = texpr.TypedExprIrStmtCall
    stmt.callKind = texpr.TypedExprCallNone
    stmt.rhsNodeIndex = -1
    # `callHead`/`callResultType` remain live below for the qualified-leaf
    # projection and trace.  The statement owns its persisted copies.
    stmt.surfaceText = strings.CloneStr(callHead)
    stmt.resultType = strings.CloneStr(callResultType)
    stmt.callCallee = texpr.TypedExprQualifiedCallLeaf(callHead)
    stmt.callTarget = irFunction.callTargets[resolvedOrdinal]
    stmt.callTargetSourcePath = irFunction.callTargetSourcePaths[resolvedOrdinal]
    stmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[resolvedOrdinal]
    stmt.callTargetImportc = irFunction.callTargetImportcFlags[resolvedOrdinal]
    stmt.callArgCount = callArgCount
    stmt.callArgsText = callArgsText
    var wholeCallBlockStart: int32 = -1
    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                      slotNames,
                                      lowering,
                                      typedFn,
                                      irFunction,
                                      stmt,
                                      -1,
                                      varI32ParamNames,
                                      callOrdinal,
                                      wholeCallBlockStart)
    if B2PrimaryObjectPlanTraceActive():
        B2PrimaryObjectPlanTrace(Fmt"whole_call_statement_emit function={typedFn.functionName} line={lineNumber} head={callHead} target={stmt.callTarget} target_source={stmt.callTargetSourcePath} argc={callArgCount}")
    return true

@borrows
fn PrimaryBodyIrResolveReturnCallOrdinal(irFunction: lower.PrimaryObjectIrFunction,
                                          callHead: str,
                                          callArgCount: int32): int32 =
    let callTail = PrimaryCallTargetTailName(callHead)
    var foundIndex: int32
    foundIndex = -1
    for i in 0..<irFunction.callTargets.len:
        if i >= irFunction.callArgCounts.len ||
           i >= irFunction.callTargetSourcePaths.len ||
           i >= irFunction.callTargetSignatureLineNumbers.len ||
           i >= irFunction.callTargetImportcFlags.len ||
           i >= irFunction.callImportcSymbols.len:
            return -1
        if irFunction.callArgCounts[i] != callArgCount:
            continue
        let targetTail = PrimaryCallTargetTailName(irFunction.callTargets[i])
        let importcTail = PrimaryCallTargetTailName(irFunction.callImportcSymbols[i])
        if irFunction.callTargets[i] != callHead &&
           targetTail != callHead &&
           targetTail != callTail &&
           irFunction.callImportcSymbols[i] != callHead &&
           importcTail != callHead &&
           importcTail != callTail:
            continue
        if foundIndex >= 0:
            if irFunction.callTargets[i] == irFunction.callTargets[foundIndex] &&
               irFunction.callTargetSourcePaths[i] == irFunction.callTargetSourcePaths[foundIndex] &&
               irFunction.callTargetSignatureLineNumbers[i] ==
                   irFunction.callTargetSignatureLineNumbers[foundIndex] &&
               irFunction.callTargetImportcFlags[i] == irFunction.callTargetImportcFlags[foundIndex] &&
               irFunction.callImportcSymbols[i] == irFunction.callImportcSymbols[foundIndex]:
                continue
            return -1
        foundIndex = i
    return foundIndex

@borrows
fn PrimaryBodyIrWholeCallStatementProbeCode(lowering: lower.LoweringPlanStub,
                                             typedFn: texpr.TypedExprIrFunction,
                                             irFunction: lower.PrimaryObjectIrFunction,
                                             callExprRaw: str): int32 =
    let callExpr = strutil.Strip(callExprRaw)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return 641
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    if closePos <= openPos || closePos + 1 != len(callExpr):
        return 642
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return 643
    let callArgsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let callArgCount = PrimaryBodyIrCallArgNames(callArgsText).len
    let resolvedOrdinal = PrimaryBodyIrResolveReturnCallOrdinal(irFunction,
                                                                callHead,
                                                                callArgCount)
    if resolvedOrdinal >= 0:
        return 650
    let targetIndex = PrimaryBodyIrVisibleFunctionIndex(lowering.typedIr,
                                                       typedFn.sourcePath,
                                                       callHead)
    if targetIndex >= 0:
        return 651
    # bail=644 probe 镜像:同 resolver bare-ident builtin bridge,避免 probe 把
    # 可解析的 Assert/Panic bare call 误分类为 644(no qualifier)。653 仅当
    # lowering.typedIr 真有 std/system fn record 才触发,同 resolver 的 poison-on-miss
    # 纪律——probe 和 emit 路径绝不可对"是否可解析"产生分歧。Miss 落原
    # qualifier/leaf 分支。
    let probeBuiltinSourcePath = PrimaryBodyIrBuiltinBareCallSourcePath(typedFn.sourcePath,
                                                                       callHead,
                                                                       callArgCount)
    if probeBuiltinSourcePath != "":
        let probeBuiltinIndex = PrimaryBodyIrTargetFunctionIndex(lowering.typedIr,
                                                                 probeBuiltinSourcePath,
                                                                 callHead)
        if probeBuiltinIndex >= 0 && probeBuiltinIndex < lowering.typedIr.functions2_functionNameIds.len:
            return 653
    let qualifier = texpr.TypedExprQualifiedCallQualifier(callHead)
    let leaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if qualifier == "" || leaf == "":
        return 644
    let importedSourcePath = PrimaryBodyIrImportAliasTargetSourcePath(lowering.typedIr,
                                                                      typedFn.sourcePath,
                                                                      qualifier)
    if importedSourcePath != "":
        let importedTargetIndex = PrimaryBodyIrTargetFunctionIndex(lowering.typedIr,
                                                                   importedSourcePath,
                                                                   leaf)
        if importedTargetIndex >= 0:
            return 652
    return 645

@borrows
fn PrimaryBodyIrLowerFieldReadChainSlot(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        varI32ParamNames: str[],
        lowering: lower.LoweringPlanStub,
        typedFn: texpr.TypedExprIrFunction,
        irFunction: var lower.PrimaryObjectIrFunction,
        chainNodeIndex: int32,
        callOrdinal: var int32): int32 =
    let nodeCount = lowering.typedIr.nodes2_nodeIndexs.len
    if chainNodeIndex < 0 || chainNodeIndex >= nodeCount:
        return -1
    if lowering.typedIr.nodes2_opKinds[chainNodeIndex] !=
           texpr.TypedExprIrOpFieldGet &&
       lowering.typedIr.nodes2_opKinds[chainNodeIndex] !=
           texpr.TypedExprIrOpIndexGet:
        return -1
    let typeCount = lowering.typeArenaStructuralKinds.len
    if !lowering.typedIr.nodeAuthorityTypeArenaBound ||
       !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, lowering.typedIr.nodeAuthorityTypeArenaArtifactCid) ||
       lowering.typeArenaScalarKinds.len != typeCount ||
       lowering.typeArenaChildTypeIds.len != typeCount ||
       lowering.typeArenaFixedLengths.len != typeCount ||
       lowering.typeArenaSizeBytes.len != typeCount ||
       lowering.typeArenaAlignBytes.len != typeCount ||
       lowering.typeArenaLayoutPresent.len != typeCount:
        panic("field chain: frozen TypeArena authority unavailable")
    var visited: bool[]
    setLen(visited, nodeCount)
    var requiredTypeIds: int32[]
    var current = chainNodeIndex
    while current >= 0:
        if current >= nodeCount || visited[current]:
            panic("field chain: node coordinate cycle or overflow")
        visited[current] = true
        let typeId = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_exactTypeArenaIds,
            current)
        if typeId < 0 || typeId >= typeCount ||
           lowering.typeArenaLayoutPresent[typeId] != 1 ||
           lowering.typeArenaSizeBytes[typeId] < 0 ||
           lowering.typeArenaAlignBytes[typeId] <= 0:
            panic("field chain: exact TypeArena fact missing")
        add(requiredTypeIds, typeId)
        let opKind = lowering.typedIr.nodes2_opKinds[current]
        if opKind == texpr.TypedExprIrOpParamRef ||
           opKind == texpr.TypedExprIrOpLocalRef:
            break
        let baseNode = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_operand0NodeIndexs,
            current)
        if baseNode < 0 || baseNode >= current:
            panic("field chain: owner node identity invalid")
        if opKind == texpr.TypedExprIrOpFieldGet:
            let offset = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldOffsetBytes,
                current)
            let size = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldSizeBytes,
                current)
            let align = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldAlignBytes,
                current)
            let sourceId = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldProducerSourceIndexes,
                current)
            let ownerDeclarationRow =
                arenamod.ArenaArrayInt32Get(
                    lowering.typedIr.arena,
                    lowering.typedIr.nodes2_fieldOwnerDeclarationSourceLocalRows,
                    current)
            let fieldDeclarationRow =
                arenamod.ArenaArrayInt32Get(
                    lowering.typedIr.arena,
                    lowering.typedIr.nodes2_fieldDeclarationSourceLocalRows,
                    current)
            let ordinal = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldOrdinals,
                current)
            let builtin = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldBuiltinKinds,
                current)
            if offset < 0 || size <= 0 || align <= 0 ||
               sourceId < 0 || ordinal < 0 ||
               Int64(offset) + Int64(size) >
                   Int64(2147483647) ||
               offset % align != 0:
                panic("field chain: field layout overflow")
            var ownerLayoutRow: int32 = -1
            var exactFieldRow: int32 = -1
            if builtin ==
                   Int32(texpr.TypedExprLayoutBuiltinNone):
                if sourceId + 1 >=
                       lowering.typedIr.exactLayoutIndexSourceStarts.len:
                    panic("field chain: declaration source invalid")
                let sourceStart =
                    lowering.typedIr.exactLayoutIndexSourceStarts[sourceId]
                let sourceStop =
                    lowering.typedIr.exactLayoutIndexSourceStarts[
                        sourceId + 1]
                if ownerDeclarationRow < 0 ||
                   fieldDeclarationRow < 0 ||
                   ownerDeclarationRow >=
                       sourceStop - sourceStart ||
                   fieldDeclarationRow >=
                       sourceStop - sourceStart:
                    panic("field chain: declaration coordinate invalid")
                ownerLayoutRow =
                    lowering.typedIr.exactLayoutTypeDeclarationRows[
                        sourceStart + ownerDeclarationRow]
                exactFieldRow =
                    lowering.typedIr.exactLayoutFieldDeclarationRows[
                        sourceStart + fieldDeclarationRow]
            else:
                let ownerIndex = sourceId * 4 + builtin
                let fieldIndex =
                    sourceId * 16 + builtin * 4 + ordinal
                if ownerIndex < 0 ||
                   ownerIndex >=
                       lowering.typedIr.exactLayoutTypeBuiltinRows.len ||
                   fieldIndex < 0 ||
                   fieldIndex >=
                       lowering.typedIr.exactLayoutFieldBuiltinRows.len:
                    panic("field chain: builtin coordinate invalid")
                ownerLayoutRow =
                    lowering.typedIr.exactLayoutTypeBuiltinRows[ownerIndex]
                exactFieldRow =
                    lowering.typedIr.exactLayoutFieldBuiltinRows[fieldIndex]
            if ownerLayoutRow < 0 ||
               ownerLayoutRow >= lowering.typedIr.typeLayoutSizeBytes.len ||
               exactFieldRow < 0 ||
               exactFieldRow >=
                   lowering.typedIr.typeFieldOffsetBytes.len ||
               lowering.typedIr.typeFieldOffsetBytes[exactFieldRow] != offset ||
               lowering.typedIr.typeFieldSizeBytes[exactFieldRow] != size ||
               lowering.typedIr.typeFieldAlignBytes[exactFieldRow] != align ||
               Int64(offset) + Int64(size) >
                   Int64(lowering.typedIr.typeLayoutSizeBytes[
                       ownerLayoutRow]):
                panic("field chain: exact field row drift")
        elif opKind == texpr.TypedExprIrOpIndexGet:
            let indexNode = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand1NodeIndexs,
                current)
            let baseTypeId = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_exactTypeArenaIds,
                baseNode)
            if indexNode < 0 || indexNode >= current ||
               baseTypeId < 0 || baseTypeId >= typeCount:
                panic("field chain: index coordinate invalid")
            let baseKind =
                lowering.typeArenaStructuralKinds[baseTypeId]
            let isString =
                baseKind ==
                    Int32(typearena.TypedExprStructuralTypeScalar) &&
                lowering.typeArenaScalarKinds[baseTypeId] ==
                    Int32(typearena.TypedExprStructuralScalarStr)
            if !isString &&
               baseKind !=
                   Int32(typearena.TypedExprStructuralTypeSequence) &&
               baseKind !=
                   Int32(typearena.TypedExprStructuralTypeFixedArray):
                panic("field chain: indexed owner structural kind invalid")
            if !isString &&
               (lowering.typeArenaChildTypeIds[baseTypeId] !=
                    typeId ||
                arenamod.ArenaArrayInt32Get(
                    lowering.typedIr.arena,
                    lowering.typedIr.nodes2_elemSizeBytes,
                    current) !=
                    lowering.typeArenaSizeBytes[typeId]):
                panic("field chain: indexed element TypeId/layout drift")
        else:
            panic("field chain: unsupported structural hop")
        current = baseNode
    if current < 0:
        panic("field chain: root binding missing")
    for i in 1..<requiredTypeIds.len:
        let picked = requiredTypeIds[i]
        var j = i - 1
        while j >= 0 && requiredTypeIds[j] > picked:
            requiredTypeIds[j + 1] = requiredTypeIds[j]
            j = j - 1
        requiredTypeIds[j + 1] = picked
    var previousTypeId: int32 = -1
    for requiredIndex in 0..<requiredTypeIds.len:
        let typeId = requiredTypeIds[requiredIndex]
        if typeId == previousTypeId:
            continue
        if !coreir.BodyIRBindCanonicalTypeFact(
               bodyIR,
               lowering.typeArenaArtifactCid,
               typeId,
               lowering.typeArenaStructuralKinds[typeId],
               lowering.typeArenaScalarKinds[typeId],
               lowering.typeArenaChildTypeIds[typeId],
               lowering.typeArenaFixedLengths[typeId],
               lowering.typeArenaSizeBytes[typeId],
               lowering.typeArenaAlignBytes[typeId]):
            panic("field chain: BodyIR TypeArena fact bind failed")
        previousTypeId = typeId
    let resultSlot = PrimaryBodyIrEvalNode(
        bodyIR, slotNames, varI32ParamNames, lowering,
        typedFn, irFunction, chainNodeIndex, callOrdinal)
    if resultSlot < 0 || resultSlot >= bodyIR.localSlots.len:
        panic("field chain: structured lowering failed")
    let resultTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        chainNodeIndex)
    let managedKind =
        lowering.typedIr.nodes2_resultTypeManagedFlags[chainNodeIndex] ?
            coreir.BodyManagedStorageManagedTag :
            coreir.BodyManagedStorageUnmanagedTag
    if !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           resultSlot,
           lowering.typeArenaArtifactCid,
           resultTypeId,
           managedKind):
        panic("field chain: result slot exact TypeId bind failed")
    return resultSlot

# 裸名全局 >=2 声明时 any-source 兜底诚实歧义返 -1 (T4B/T4D 案卷), 唯一赢面是
# SameSourceUnique 同文件优先; 本文件 17 处调用点须有字节级一致本地副本
# (与 backend2_lower_util:2013 / backend2_lower_slots:1245 同款, T4E 补齐)。
@borrows
fn PrimaryBodyIrTextIsStringLiteral(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if len(text) < 2:
        return false
    if text[0] != '"':
        return false
    if text[len(text) - 1] != '"':
        return false
    return true

@borrows
fn PrimaryBodyIrLowerJsonBracketKeyArgText(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            lowering: lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: var lower.PrimaryObjectIrFunction,
                                            sourcePath: str,
                                            lineNumber: int32,
                                            keyTextRaw: str,
                                            keyNodeIndex: int32,
                                            callOrdinal: var int32): str =
    let keyText = strutil.Strip(keyTextRaw)
    if keyText == "":
        return ""
    if PrimaryBodyIrTextIsStringLiteral(keyText):
        return keyText
    let keySlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, keyText)
    if keySlot >= 0 && keySlot < bodyIR.localSlots.len && PrimaryBodyIrSlotType(bodyIR, keySlot) == coreir.LocalStrTag:
        return slotNames[keySlot]
    if PrimaryBodyIrTextHasFieldOrIndex(keyText):
        let chainSlot = PrimaryBodyIrLowerFieldReadChainSlot(
            bodyIR, slotNames, varI32ParamNames, lowering,
            typedFn, irFunction, keyNodeIndex, callOrdinal)
        if chainSlot >= 0 && chainSlot < bodyIR.localSlots.len && PrimaryBodyIrSlotType(bodyIR, chainSlot) == coreir.LocalStrTag:
            return slotNames[chainSlot]
    return ""

@borrows
fn PrimaryBodyIrEmitJsonSetterCall(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    lowering: lower.LoweringPlanStub,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: var lower.PrimaryObjectIrFunction,
                                    varI32ParamNames: str[],
                                    sourcePath: str,
                                    functionName: str,
                                    lineNumber: int32,
                                    setterHead: str,
                                    setterArgText: str,
                                    callOrdinal: var int32): bool =
    let setterArgCount = PrimaryBodyIrCallArgNames(setterArgText).len
    if setterArgCount <= 0:
        return false
    panic(Fmt"backend2: synthesized JSON setter lacks canonical CallExpr row source={sourcePath} function={functionName} line={lineNumber} target={setterHead}")
    return false

@borrows
fn PrimaryBodyIrLowerJsonNestedBracketAssign(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              lowering: lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: var lower.PrimaryObjectIrFunction,
                                              varI32ParamNames: str[],
                                              stmt: lower.PrimaryObjectIrStatement,
                                              lineNumber: int32,
                                              callOrdinal: var int32): bool =
    let lhsText = PrimaryBodyIrCanonicalAssignLhsName(stmt.bindingName)
    var rootText = ""
    var dims: str[]
    let dimCount = PrimaryBodyIrMultiIndexParts(lhsText, rootText, dims)
    if dimCount != 2:
        return false
    var baseTypeText = strings.CloneStr(stmt.assignRootType)
    if baseTypeText == "" || baseTypeText == "unknown" || !B2PrimaryObjectMetadataTextStable(baseTypeText):
        baseTypeText = PrimaryBodyIrBindingTypeForName(lowering.typedIr, typedFn, irFunction, lineNumber, rootText)
    if !PrimaryBodyIrTypeTextIsJsonNode(baseTypeText):
        return false
    let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootText)
    if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, rootSlot) != coreir.LocalAggregateTag:
        return false
    let dim0 = dims[0]
    let dim1 = dims[1]
    if !PrimaryBodyIrTextIsStringLiteral(dim0):
        return false
    let innerExpr = Fmt"{rootText}[{dim0}]"
    let innerSlot = PrimaryBodyIrSubscriptOpCallArgSlot(bodyIR, slotNames, varI32ParamNames, lowering, typedFn, irFunction, stmt.sourcePath, lineNumber, innerExpr, -1, callOrdinal)
    if innerSlot < 0 || innerSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, innerSlot) != coreir.LocalAggregateTag:
        return false
    let innerName = slotNames[innerSlot]
    let outerKeyArg = PrimaryBodyIrLowerJsonBracketKeyArgText(
        bodyIR, slotNames, varI32ParamNames, lowering,
        typedFn, irFunction, stmt.sourcePath, lineNumber, dim1,
        stmt.assignIndexNodeIndex, callOrdinal)
    if outerKeyArg == "":
        return false
    let rhsText = strings.CloneStr(strutil.Strip(stmt.surfaceText))
    if rhsText == "":
        return false
    var mutateHead = ""
    var mutateArgText = ""
    if PrimaryBodyIrTextIsStringLiteral(rhsText):
        mutateHead = "json.JsonSetFieldStr"
        mutateArgText = strutil.Join([strings.CloneStr(innerName), strings.CloneStr(outerKeyArg), strings.CloneStr(rhsText)], ", ")
    elif rhsText == "true" || rhsText == "false":
        mutateHead = "json.JsonSetFieldBool"
        mutateArgText = strutil.Join([strings.CloneStr(innerName), strings.CloneStr(outerKeyArg), strings.CloneStr(rhsText)], ", ")
    elif PrimaryBodyIrTextIsIntLiteral(rhsText):
        mutateHead = "json.JsonSetFieldInt64"
        mutateArgText = strutil.Join([strings.CloneStr(innerName), strings.CloneStr(outerKeyArg), strings.CloneStr(rhsText)], ", ")
    else:
        let rhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        if rhsSlot < 0 || rhsSlot >= bodyIR.localSlots.len:
            return false
        let rhsKind = PrimaryBodyIrSlotType(bodyIR, rhsSlot)
        if rhsKind == coreir.LocalAggregateTag:
            mutateHead = "json.JsonSetField"
        elif rhsKind == coreir.LocalStrTag:
            mutateHead = "json.JsonSetFieldStr"
        elif rhsKind == coreir.LocalI32Tag:
            mutateHead = "json.JsonSetFieldInt32"
        elif rhsKind == coreir.LocalI64Tag:
            mutateHead = "json.JsonSetFieldInt64"
        elif rhsKind == coreir.LocalF64Tag:
            mutateHead = "json.JsonSetFieldFloat64"
        else:
            return false
        mutateArgText = strutil.Join([strings.CloneStr(innerName), strings.CloneStr(outerKeyArg), strings.CloneStr(slotNames[rhsSlot])], ", ")
    if !PrimaryBodyIrEmitJsonSetterCall(bodyIR, slotNames, lowering, typedFn, irFunction, varI32ParamNames, stmt.sourcePath, stmt.functionName, lineNumber, mutateHead, mutateArgText, callOrdinal):
        return false
    let writebackArgText = strutil.Join([strings.CloneStr(rootText), strings.CloneStr(dim0), strings.CloneStr(innerName)], ", ")
    if !PrimaryBodyIrEmitJsonSetterCall(bodyIR, slotNames, lowering, typedFn, irFunction, varI32ParamNames, stmt.sourcePath, stmt.functionName, lineNumber, "json.JsonSetField", writebackArgText, callOrdinal):
        return false
    return true

@borrows
fn PrimaryBodyIrTypeTextIsJsonNode(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "JsonNode":
        return true
    let suffix = ".JsonNode"
    let suffixLen = len(suffix)
    if len(normType) > suffixLen &&
       PrimaryStartsWith(strings.SliceBytes(normType, len(normType) - suffixLen, suffixLen), suffix):
        return true
    return false

@borrows
fn PrimaryBodyIrLowerJsonBracketAssign(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       lowering: lower.LoweringPlanStub,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: var lower.PrimaryObjectIrFunction,
                                       varI32ParamNames: str[],
                                       stmt: lower.PrimaryObjectIrStatement,
                                       lineNumber: int32,
                                       callOrdinal: var int32): bool =
    let lhsText = PrimaryBodyIrCanonicalAssignLhsName(stmt.bindingName)
    var baseName = ""
    var keyText = ""
    if !PrimaryBodyIrIndexExprParts(lhsText, baseName, keyText):
        return false
    if baseName == "" || PrimaryBodyIrTextHasFieldOrIndex(baseName):
        return false
    # Group G 子形 5:key 非串字面量(field-read 链 / bare-ident str)物化进 str 槽。
    let keyArgText = PrimaryBodyIrLowerJsonBracketKeyArgText(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,
                                                              typedFn,
                                                              irFunction,
                                                              stmt.sourcePath,
                                                              lineNumber,
                                                              keyText,
                                                              stmt.assignIndexNodeIndex,
                                                              callOrdinal)
    if keyArgText == "":
        return false
    var baseTypeText = strings.CloneStr(stmt.assignRootType)
    if baseTypeText == "" || baseTypeText == "unknown" ||
       !B2PrimaryObjectMetadataTextStable(baseTypeText):
        baseTypeText = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       lineNumber,
                                                       baseName)
    if !PrimaryBodyIrTypeTextIsJsonNode(baseTypeText):
        return false
    let baseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, baseName)
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, baseSlot) != coreir.LocalAggregateTag:
        return false
    let rhsText = strutil.Strip(stmt.surfaceText)
    if rhsText == "":
        return false
    var setterHead = ""
    var setterCallee = ""
    var setterArgText = ""
    if PrimaryBodyIrTextIsStringLiteral(rhsText):
        setterHead = "json.JsonSetFieldStr"
        setterCallee = "JsonSetFieldStr"
        setterArgText = Fmt"{baseName}, {keyArgText},{rhsText}"
    elif rhsText == "true" || rhsText == "false":
        setterHead = "json.JsonSetFieldBool"
        setterCallee = "JsonSetFieldBool"
        setterArgText = Fmt"{baseName}, {keyArgText},{rhsText}"
    elif PrimaryBodyIrTextIsIntLiteral(rhsText):
        setterHead = "json.JsonSetFieldInt64"
        setterCallee = "JsonSetFieldInt64"
        setterArgText = Fmt"{baseName}, {keyArgText},{rhsText}"
    else:
        var rhsSlotTypeKind = coreir.LocalInvalidTag
        var rhsArgName = ""
        if PrimaryBodyIrTextHasCallSurface(rhsText):
            let rhsCallSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                  slotNames,
                                                                  lowering.typedIr,
                                                                  stmt.sourcePath,
                                                                  Fmt"#json_rhs_call#{lineNumber}#{bodyIR.ops.len}",
                                                                  "json.JsonNode")
            if rhsCallSlot < 0:
                return false
            if !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                       slotNames,
                                                       lowering,
                                                       typedFn,
                                                       irFunction,
                                                       varI32ParamNames,
                                                       rhsText,
                                                       rhsCallSlot,
                                                       lineNumber,
                                                       -1,
                                                       callOrdinal):
                return false
            rhsSlotTypeKind = coreir.LocalAggregateTag
            rhsArgName = bodyIR.localSlots[rhsCallSlot].name
        else:
            let rhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
            if rhsSlot < 0 || rhsSlot >= bodyIR.localSlots.len:
                let resolvedFieldReadSlot =
                    PrimaryBodyIrLowerFieldReadChainSlot(
                        bodyIR,
                        slotNames,
                        varI32ParamNames,
                        lowering,
                        typedFn,
                        irFunction,
                        stmt.rhsNodeIndex,
                        callOrdinal)
                if resolvedFieldReadSlot < 0:
                    return false
                rhsSlotTypeKind = PrimaryBodyIrSlotType(bodyIR, resolvedFieldReadSlot)
                rhsArgName = slotNames[resolvedFieldReadSlot]
            else:
                rhsSlotTypeKind = PrimaryBodyIrSlotType(bodyIR, rhsSlot)
                rhsArgName = slotNames[rhsSlot]
        if rhsSlotTypeKind == coreir.LocalAggregateTag:
            setterHead = "json.JsonSetField"
            setterCallee = "JsonSetField"
        elif rhsSlotTypeKind == coreir.LocalStrTag:
            setterHead = "json.JsonSetFieldStr"
            setterCallee = "JsonSetFieldStr"
        elif rhsSlotTypeKind == coreir.LocalI32Tag:
            setterHead = "json.JsonSetFieldInt32"
            setterCallee = "JsonSetFieldInt32"
        elif rhsSlotTypeKind == coreir.LocalI64Tag:
            setterHead = "json.JsonSetFieldInt64"
            setterCallee = "JsonSetFieldInt64"
        elif rhsSlotTypeKind == coreir.LocalF64Tag:
            setterHead = "json.JsonSetFieldFloat64"
            setterCallee = "JsonSetFieldFloat64"
        else:
            return false
        setterArgText = Fmt"{baseName}, {keyArgText},{rhsArgName}"
    var setterResultType = ""
    let setterArgCount = PrimaryBodyIrCallArgNames(setterArgText).len
    let setterOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                          lowering,
                                                                          stmt.rhsNodeIndex,
                                                                          setterArgCount,
                                                                          setterResultType)
    if setterOrdinal < 0 || setterOrdinal >= irFunction.callTargets.len ||
       setterOrdinal >= irFunction.callTargetSourcePaths.len ||
       setterOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
       setterOrdinal >= irFunction.callTargetImportcFlags.len:
        return false
    var setterStmt: lower.PrimaryObjectIrStatement
    setterStmt.sourcePath = stmt.sourcePath
    setterStmt.functionName = stmt.functionName
    setterStmt.lineNumber = lineNumber
    setterStmt.lineIndent = 0
    setterStmt.kind = texpr.TypedExprIrStmtCall
    setterStmt.callKind = texpr.TypedExprCallNone
    setterStmt.rhsNodeIndex = -1
    setterStmt.surfaceText = strings.CloneStr(setterHead)
    setterStmt.bindingName = ""
    setterStmt.resultType = "void"
    setterStmt.conditionKind = texpr.TypedExprIrCondNone
    setterStmt.assignPlaceKind = texpr.TypedExprPlaceTemporary
    setterStmt.assignValueOpKind = texpr.TypedExprIrOpUnsupported
    setterStmt.callCallee = setterCallee
    setterStmt.callTarget = irFunction.callTargets[setterOrdinal]
    setterStmt.callTargetSourcePath = irFunction.callTargetSourcePaths[setterOrdinal]
    setterStmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[setterOrdinal]
    setterStmt.callTargetImportc = irFunction.callTargetImportcFlags[setterOrdinal]
    setterStmt.callArgCount = setterArgCount
    setterStmt.callArgsText = setterArgText
    setterStmt.returnRoot = false
    var nestedSetterBlockStart: int32 = -1
    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                      slotNames,
                                      lowering,
                                      typedFn,
                                      irFunction,
                                      setterStmt,
                                      -1,
                                      varI32ParamNames,
                                      callOrdinal,
                                      nestedSetterBlockStart)
    return true
# 沿 ArgLink 链取实参值节点：引用实参（param/local）按名字直传（保留
# var 形参地址协议），字面量串/bool 按文本直传（保留 cstring/str 字面
# 量协议），其余实参经节点求值器物化为槽后按槽名传入；调用发射复用
# PrimaryBodyIrAppendCallOp（槽传参+callOrdinal 协议），不经文本
# WholeCall 解析层。标量/str 返回进 targetSlot；聚合返回、var 形参的
# 非引用实参、特殊投影头（StrDataPtr/IsErr/int 铸型）本批 miss 落回。
# 纪律：所有可失败的门一律在 AppendCallOp 之前判定——一旦发射调用即
# 不可回落（避免文本路径重复发射产生双副作用）。
@borrows
fn PrimaryBodyIrAppendReturnAggregateConstructor(bodyIR: var coreir.BodyIR,
                                                  slotNames: var str[],
                                                  varI32ParamNames: str[],
                                                  lowering: lower.LoweringPlanStub,
                                                  typedFn: texpr.TypedExprIrFunction,
                                                  irFunction: var lower.PrimaryObjectIrFunction,
                                                  returnExprRaw: str,
                                                  returnExprNodeIndex: int32,
                                                  currentBlockStart: var int32,
                                                  callOrdinal: var int32): bool =
    let returnExpr = strutil.Strip(returnExprRaw)
    if len(returnExpr) <= 0:
        return false
    # 返回型须为聚合（return term 需其 typeKind）。
    var retTypeKind: int32
    var retSizeBytes: int32
    var retAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   typedFn.sourcePath,
                                   typedFn.returnType,
                                   retTypeKind,
                                   retSizeBytes,
                                   retAlignBytes)
    if retTypeKind != coreir.LocalAggregateTag || retSizeBytes <= 0:
        return false
    # result 槽：sret 关联的返回聚合槽。共享核心负责形状校验+零初始化+字段写入。
    let resultSlotName = strutil.Join(["#return_ctor#",
                                       strings.CloneStr(typedFn.functionName),
                                       "#",
                                       strings.IntToStr(currentBlockStart)], "")
    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        typedFn.sourcePath,
                                                        resultSlotName,
                                                        typedFn.returnType)
    if resultSlot < 0:
        return false
    if !PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering,
                                                      typedFn,
                                                      irFunction,
                                                      returnExpr,
                                                      returnExprNodeIndex,
                                                      typedFn.returnType,
                                                      typedFn.sourcePath,
                                                      typedFn.bodyLineNumber,
                                                      resultSlot,
                                                      currentBlockStart,
                                                      callOrdinal):
        return false
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  resultSlot,
                                  retTypeKind,
                                  0,
                                  false)
    return true

@borrows
fn PrimaryBodyIrAppendReturnFnPtrSretAgg1Call(bodyIR: var coreir.BodyIR,
                                               slotNames: var str[],
                                               typedIr: texpr.TypedExprIr,
                                               typedFn: texpr.TypedExprIrFunction,
                                               irFunction: var lower.PrimaryObjectIrFunction,
                                               callHead: str,
                                               callArgsText: str,
                                               currentBlockStart: var int32,
                                               callOrdinal: var int32): bool =
    let fnPtrType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                    typedFn,
                                                    irFunction,
                                                    typedFn.bodyLineNumber,
                                                    callHead)
    if !texpr.TypedExprTypeTextIsFnPtr(fnPtrType):
        return false
    let fnParamTypes: str[] = PrimaryBodyIrFnPtrParamTypes(fnPtrType)
    let callArgs: str[] = PrimaryBodyIrCallArgNames(callArgsText)
    if fnParamTypes.len != 1 || callArgs.len != 1:
        return false
    let resultType = PrimaryBodyIrFnPtrReturnType(fnPtrType)
    if resultType == "" || resultType == "void":
        return false
    var resultTypeKind: int32
    var resultTypeSizeBytes: int32
    var resultTypeAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   typedFn.sourcePath,
                                   resultType,
                                   resultTypeKind,
                                   resultTypeSizeBytes,
                                   resultTypeAlignBytes)
    if resultTypeKind != coreir.LocalAggregateTag &&
       resultTypeKind != coreir.LocalStrTag:
        return false
    if resultTypeSizeBytes <= 0:
        return false
    let resultSlotName = strutil.Join(["#return_fnptr_sret#",
                                       strings.CloneStr(typedFn.functionName),
                                       "#",
                                       strings.IntToStr(currentBlockStart),
                                       "#",
                                       strings.IntToStr(callOrdinal)], "")
    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        typedIr,
                                                        typedFn.sourcePath,
                                                        resultSlotName,
                                                        resultType)
    if resultSlot < 0 ||
       resultSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, resultSlot) != resultTypeKind ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[resultSlot]) < resultTypeSizeBytes:
        return false
    if !PrimaryBodyIrAppendFnPtrSretAgg1CallToSlot(bodyIR,
                                                   slotNames,
                                                   typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   callHead,
                                                   callArgsText,
                                                   resultSlot,
                                                   typedFn.bodyLineNumber,
                                                   callOrdinal):
        return false
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  resultSlot,
                                  resultTypeKind,
                                  0,
                                  false)
    return true

@borrows
fn PrimaryBodyIrFunctionTailExprNode(
        irFunction: lower.PrimaryObjectIrFunction): int32 =
    var tailExprNodeIndex: int32 = -1
    for statementIndex in 0..<irFunction.statements.len:
        let stmt = irFunction.statements[statementIndex]
        if !stmt.returnRoot ||
           stmt.rhsNodeIndex < 0:
            continue
        tailExprNodeIndex = stmt.rhsNodeIndex
    return tailExprNodeIndex

@borrows
fn PrimaryBodyIrFunctionTailCallNode(
        typedIr: texpr.TypedExprIr,
        irFunction: lower.PrimaryObjectIrFunction): int32 =
    let tailExprNodeIndex =
        PrimaryBodyIrFunctionTailExprNode(irFunction)
    if tailExprNodeIndex < 0 ||
       tailExprNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[tailExprNodeIndex] !=
           texpr.TypedExprIrOpCallExpr:
        return -1
    return tailExprNodeIndex

@borrows
fn PrimaryBodyIrAppendReturnWholeCall(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       lowering: lower.LoweringPlanStub,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: var lower.PrimaryObjectIrFunction,
                                       varI32ParamNames: str[],
                                       returnCallNodeIndex: int32,
                                       currentBlockStart: var int32,
                                       callOrdinal: var int32): bool =
    let typedFnName = typedFn.functionName
    let typedFnSourcePath = typedFn.sourcePath
    let typedFnReturnType = typedFn.returnType
    let typedFnReturnExpr = typedFn.returnExpr
    let returnExpr = strings.CloneStr(strutil.Strip(typedFnReturnExpr))
    if B2PrimaryObjectPlanTraceActive():
        B2PrimaryObjectPlanTrace(Fmt"phase=return_call_probe function={typedFnName} expr={returnExpr} lowering_calls={irFunction.callTargets.len}")
    if len(returnExpr) <= 0:
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(returnExpr)
    if openPos <= 0:
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=no_whole_call_open expr={returnExpr}")
        return false
    let closePos = texpr.TypedExprFindMatchingParen(returnExpr, openPos)
    var primaryColdCond8: bool
    if closePos <= openPos:
        primaryColdCond8 = true
    if closePos + 1 != len(returnExpr):
        primaryColdCond8 = true
    if primaryColdCond8:
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=not_whole_call expr={returnExpr} close={closePos}")
        return false
    let callHead = strings.CloneStr(strutil.Strip(strings.SliceBytes(returnExpr, 0, openPos)))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=bad_call_head head={callHead}")
        return false
    # bail=0 C3: 构造器不是调用。命名字段 seq 别名构造器（如 hashmaps.cheng
    # `hashMap_seq_int32(len: ...)`）的 head 是类型别名（非函数），但 lowering 把它
    # 登记成 callTargets 行 → 下方 ordinal 解析命中并发射 call，命名字段实参走
    # AppendCallArgs 必败（bail_44 毒标）。让位给两处调用点（39127/40139）紧随的
    # AppendReturnAggregateConstructor 逐字段物化；零实参 `return Type()` 亦由其
    # 零初始化臂等价处理（同 AppendCallOp ctor_call_zeroinit 语义）。
    if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, typedFnSourcePath, callHead):
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=aggregate_ctor_head head={callHead}")
        return false
    var callArgsText = strutil.Strip(strings.SliceBytes(returnExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let returnCallArgs = PrimaryBodyIrCallArgNames(callArgsText)
    if returnCallArgs.len > 0:
        var materializedArgs: str[]
        var changedArgs = false
        for argIndex in 0..<returnCallArgs.len:
            var argText = returnCallArgs[argIndex]
            let argOpenPos = texpr.TypedExprFindWholeCallOpenParen(argText)
            if argOpenPos > 0:
                let argClosePos = texpr.TypedExprFindMatchingParen(argText, argOpenPos)
                if argClosePos > argOpenPos && argClosePos + 1 == len(argText):
                    let argCallHead = strutil.Strip(strings.SliceBytes(argText, 0, argOpenPos))
                    if texpr.TypedExprCallHeadIsPlainQualifiedIdent(argCallHead):
                        var nestedResultType = ""
                        let nestedCallNodeIndex =
                            PrimaryBodyIrCallArgNodeIndexAt(
                                lowering.typedIr,
                                returnCallNodeIndex,
                                argIndex)
                        if nestedCallNodeIndex >= 0 &&
                           nestedCallNodeIndex <
                               lowering.typedIr.nodes2_nodeIndexs.len &&
                           lowering.typedIr.nodes2_opKinds[nestedCallNodeIndex] ==
                               texpr.TypedExprIrOpCallExpr:
                            let nestedResultTypeRes: Result[str] =
                                langintern.LookupIntern(
                                    lowering.typedIr.internPool,
                                    lowering.typedIr.nodes2_resultTypeIds[
                                        nestedCallNodeIndex])
                            if IsOk(nestedResultTypeRes):
                                nestedResultType =
                                    Value(nestedResultTypeRes)
                        if nestedResultType != "" && nestedResultType != "unknown":
                            let nestedSlotName = strutil.Join(["#return_call_arg#",
                                                               strings.IntToStr(typedFn.bodyLineNumber),
                                                               "_",
                                                               strings.IntToStr(argIndex),
                                                               "_",
                                                               strings.IntToStr(callOrdinal)], "")
                            let nestedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering.typedIr,
                                                                                 typedFnSourcePath,
                                                                                 nestedSlotName,
                                                                                 nestedResultType)
                            if nestedSlot >= 0 &&
                               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                       slotNames,
                                                                       lowering,
                                                                       typedFn,
                                                                       irFunction,
                                                                       varI32ParamNames,
                                                                       argText,
                                                                       nestedSlot,
                                                                       typedFn.bodyLineNumber,
                                                                       nestedCallNodeIndex,
                                                                       callOrdinal):
                                argText = nestedSlotName
                                changedArgs = true
            add(materializedArgs, argText)
        if changedArgs:
            callArgsText = strutil.Join(materializedArgs, ",")
    let callArgCount = PrimaryBodyIrCallArgNames(callArgsText).len
    if PrimaryBodyIrAppendReturnFnPtrSretAgg1Call(bodyIR,
                                                  slotNames,
                                                  lowering.typedIr,
                                                  typedFn,
                                                  irFunction,
                                                  callHead,
                                                  callArgsText,
                                                  currentBlockStart,
                                                  callOrdinal):
        return true
    var callResultType = ""
    let resolvedOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                            lowering,
                                                                            returnCallNodeIndex,
                                                                            callArgCount,
                                                                            callResultType)
    if resolvedOrdinal < 0:
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=target_unresolved head={callHead} argc={callArgCount}")
        return false
    if B2PrimaryObjectPlanTraceActive():
        B2PrimaryObjectPlanTrace(Fmt"phase=return_call_resolved function={typedFnName} target={irFunction.callTargets[resolvedOrdinal]} argc={callArgCount}")
    if callResultType == "" || callResultType == "void":
        callResultType = typedFnReturnType
    var stmt: lower.PrimaryObjectIrStatement
    stmt.sourcePath = strings.CloneStr(typedFnSourcePath)
    stmt.functionName = strings.CloneStr(typedFnName)
    stmt.lineNumber = typedFn.bodyLineNumber
    if stmt.lineNumber <= 0:
        stmt.lineNumber = irFunction.bodyLineNumber
    stmt.lineIndent = 0
    stmt.kind = texpr.TypedExprIrStmtLetCall
    stmt.callKind = texpr.TypedExprCallNone
    stmt.rhsNodeIndex = -1
    stmt.surfaceText = strings.CloneStr(callHead)
    stmt.bindingName = "#return_call"
    stmt.resultType = strings.CloneStr(callResultType)
    stmt.conditionKind = texpr.TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = texpr.TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueOpKind = texpr.TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.callCallee = strings.CloneStr(texpr.TypedExprQualifiedCallLeaf(callHead))
    stmt.callTarget = irFunction.callTargets[resolvedOrdinal]
    stmt.callTargetSourcePath = irFunction.callTargetSourcePaths[resolvedOrdinal]
    stmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[resolvedOrdinal]
    stmt.callTargetImportc = irFunction.callTargetImportcFlags[resolvedOrdinal]
    stmt.callArgCount = callArgCount
    stmt.callArgsText = strings.CloneStr(callArgsText)
    stmt.returnRoot = true
    let resultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                        "#return_call",
                                                        resultType)
    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                      slotNames,
                                      lowering,
                                      typedFn,
                                      irFunction,
                                      stmt,
                                      resultSlot,
                                      varI32ParamNames,
                                      callOrdinal,
                                      currentBlockStart)
    if B2PrimaryObjectPlanTraceActive():
        B2PrimaryObjectPlanTrace(Fmt"phase=return_call_appended function={typedFnName} target={stmt.callTarget} call_count={bodyIR.callSequence.len} ops={bodyIR.ops.len}")
    var resultTypeKind: int32
    var resultTypeSizeBytes: int32
    var resultTypeAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                   resultType,
                                   resultTypeKind,
                                   resultTypeSizeBytes,
                                   resultTypeAlignBytes)
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  resultSlot,
                                  resultTypeKind,
                                  0,
                                  false)
    return true

@borrows
fn PrimaryBodyIrExactI32ZeroNode(
        typedIr: texpr.TypedExprIr,
        nodeIndex: int32): bool =
    if nodeIndex < 0 ||
       nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] !=
           texpr.TypedExprIrOpI32Const:
        return false
    let literalResult: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.nodes2_literalTextIds[nodeIndex])
    return IsOk(literalResult) &&
           strutil.Strip(Value(literalResult)) == "0"

@borrows
fn PrimaryBodyIrAppendReturnCallCompareZero(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            lowering: lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: var lower.PrimaryObjectIrFunction,
                                            varI32ParamNames: str[],
                                            returnExprRaw: str,
                                            lineNumber: int32,
                                            returnExprNodeIndex: int32,
                                            currentBlockStart: var int32,
                                            callOrdinal: var int32): bool =
    let returnExpr = strutil.Strip(returnExprRaw)
    var cmpPos = texpr.TypedExprFindTopLevelTextToken(returnExpr, "==")
    var trueWhenZero = true
    if cmpPos < 0:
        cmpPos = texpr.TypedExprFindTopLevelTextToken(returnExpr, "!=")
        trueWhenZero = false
    if cmpPos < 0:
        return false
    let lhsText = strings.CloneStr(strutil.Strip(strings.SliceBytes(returnExpr, 0, cmpPos)))
    let rhsText = strings.CloneStr(strutil.Strip(strings.SliceBytes(returnExpr, cmpPos + 2, len(returnExpr) - cmpPos - 2)))
    var callExpr = strings.CloneStr(lhsText)
    if PrimaryBodyIrTextIsI32Zero(lhsText):
        callExpr = strings.CloneStr(rhsText)
    elif !PrimaryBodyIrTextIsI32Zero(rhsText):
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    var primaryColdCond9: bool
    if closePos <= openPos:
        primaryColdCond9 = true
    if closePos + 1 != len(callExpr):
        primaryColdCond9 = true
    if primaryColdCond9:
        return false
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return false
    if returnExprNodeIndex < 0 ||
       returnExprNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        panic(Fmt"backend2: return call comparison lacks canonical comparison node line={lineNumber}")
    let returnCmpOpKind =
        lowering.typedIr.nodes2_opKinds[returnExprNodeIndex]
    if returnCmpOpKind != texpr.TypedExprIrOpCmpEq &&
       returnCmpOpKind != texpr.TypedExprIrOpCmpNe:
        panic(Fmt"backend2: return call comparison node kind mismatch node={returnExprNodeIndex}")
    let returnCmpLhsNode = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand0NodeIndexs,
        returnExprNodeIndex)
    let returnCmpRhsNode = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand1NodeIndexs,
        returnExprNodeIndex)
    let returnCmpLhsIsZero =
        PrimaryBodyIrExactI32ZeroNode(lowering.typedIr, returnCmpLhsNode)
    let returnCmpRhsIsZero =
        PrimaryBodyIrExactI32ZeroNode(lowering.typedIr, returnCmpRhsNode)
    if returnCmpLhsIsZero == returnCmpRhsIsZero:
        panic(Fmt"backend2: return call comparison exact zero operand missing or ambiguous node={returnExprNodeIndex}")
    var callNodeIndex = returnCmpLhsNode
    if returnCmpLhsIsZero:
        callNodeIndex = returnCmpRhsNode
    if callNodeIndex < 0 ||
       callNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[callNodeIndex] !=
           texpr.TypedExprIrOpCallExpr:
        panic(Fmt"backend2: return comparison call operand lacks canonical CallExpr row node={returnExprNodeIndex}")
    trueWhenZero = returnCmpOpKind ==
        texpr.TypedExprIrOpCmpEq
    # f64 CALL wave3 adversarial-review poison (backend2 mirror, third mirror
    # point): see the sibling primary_object_plan.cheng definition for the
    # full rationale -- this fast path hardcodes an int32 result slot and an
    # integer CBR for `== 0`/`!= 0`, which silently narrows a float64
    # callee's real result via a raw low-32-bit truncating copy instead of an
    # FCMP. Decline for float64 callees so the caller falls through instead
    # of silently miscompiling.
    var returnCmpHeadResultType = ""
    let returnCmpHeadRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.nodes2_resultTypeIds[callNodeIndex])
    if IsOk(returnCmpHeadRes):
        returnCmpHeadResultType = Value(returnCmpHeadRes)
    if returnCmpHeadResultType == "float64":
        return false
    var callArgsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let callArgs = PrimaryBodyIrCallArgNames(callArgsText)
    if callArgs.len > 0:
        var materializedArgs: str[]
        var changedArgs = false
        for argIndex in 0..<callArgs.len:
            var argText = callArgs[argIndex]
            let argOpenPos = texpr.TypedExprFindWholeCallOpenParen(argText)
            if argOpenPos > 0:
                let argClosePos = texpr.TypedExprFindMatchingParen(argText, argOpenPos)
                if argClosePos > argOpenPos && argClosePos + 1 == len(argText):
                    let argCallHead = strutil.Strip(strings.SliceBytes(argText, 0, argOpenPos))
                    if texpr.TypedExprCallHeadIsPlainQualifiedIdent(argCallHead):
                        var nestedResultType = ""
                        let nestedCallNodeIndex =
                            PrimaryBodyIrCallArgNodeIndexAt(
                                lowering.typedIr,
                                callNodeIndex,
                                argIndex)
                        if nestedCallNodeIndex >= 0 &&
                           nestedCallNodeIndex <
                               lowering.typedIr.nodes2_nodeIndexs.len &&
                           lowering.typedIr.nodes2_opKinds[nestedCallNodeIndex] ==
                               texpr.TypedExprIrOpCallExpr:
                            let nestedResultTypeRes: Result[str] =
                                langintern.LookupIntern(
                                    lowering.typedIr.internPool,
                                    lowering.typedIr.nodes2_resultTypeIds[
                                        nestedCallNodeIndex])
                            if IsOk(nestedResultTypeRes):
                                nestedResultType =
                                    Value(nestedResultTypeRes)
                        if nestedResultType != "" && nestedResultType != "unknown":
                            let nestedSlotName = strutil.Join(["#return_call_cmp_arg#",
                                                               strings.IntToStr(lineNumber),
                                                               "_",
                                                               strings.IntToStr(argIndex),
                                                               "_",
                                                               strings.IntToStr(callOrdinal)], "")
                            let nestedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering.typedIr,
                                                                                 typedFn.sourcePath,
                                                                                 nestedSlotName,
                                                                                 nestedResultType)
                            if nestedSlot >= 0 &&
                               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                       slotNames,
                                                                       lowering,
                                                                       typedFn,
                                                                       irFunction,
                                                                       varI32ParamNames,
                                                                       argText,
                                                                       nestedSlot,
                                                                       lineNumber,
                                                                       nestedCallNodeIndex,
                                                                       callOrdinal):
                                argText = nestedSlotName
                                changedArgs = true
            add(materializedArgs, argText)
        if changedArgs:
            callArgsText = strutil.Join(materializedArgs, ",")
            callExpr = strutil.Join([callHead, "(", callArgsText, ")"], "")
    let callResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#return_call_cmp_result#{lineNumber}",
                                                       coreir.LocalI32Tag)
    if callResultSlot < 0 ||
       !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                               slotNames,
                                               lowering,
                                               typedFn,
                                               irFunction,
                                               varI32ParamNames,
                                               callExpr,
                                               callResultSlot,
                                               lineNumber,
                                               callNodeIndex,
                                               callOrdinal):
        return false
    let zeroSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#return_call_cmp_zero#{lineNumber}",
                                                 coreir.LocalI32Tag)
    if zeroSlot < 0:
        return false
    var zeroOp: coreir.BodyOp
    zeroOp.kind = coreir.BodyOpLoadConstTag
    zeroOp.target = zeroSlot
    add(zeroOp.operands, coreir.LocalI32Tag)
    add(zeroOp.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, zeroOp)
    var cbrTerm: coreir.BodyTerm
    cbrTerm.kind = coreir.BodyTermCbrTag
    cbrTerm.conditionKind = coreir.BodyCondI32EqTag
    cbrTerm.lhsSlot = callResultSlot
    cbrTerm.rhsSlot = zeroSlot
    cbrTerm.resultSlot = -1
    cbrTerm.trueBlock = bodyIR.blocks.len + 1
    cbrTerm.falseBlock = bodyIR.blocks.len + 2
    let cbrTermIndex = coreir.BodyIRAppendTerm(bodyIR, cbrTerm)
    let cbrBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, cbrBlockOpCount, cbrTermIndex)
    currentBlockStart = bodyIR.ops.len
    if trueWhenZero:
        PrimaryBodyIrAppendReturnTerm(bodyIR, currentBlockStart, -1, coreir.LocalI32Tag, 1, true)
        PrimaryBodyIrAppendReturnTerm(bodyIR, currentBlockStart, -1, coreir.LocalI32Tag, 0, true)
    else:
        PrimaryBodyIrAppendReturnTerm(bodyIR, currentBlockStart, -1, coreir.LocalI32Tag, 0, true)
        PrimaryBodyIrAppendReturnTerm(bodyIR, currentBlockStart, -1, coreir.LocalI32Tag, 1, true)
    return true

@borrows
fn PrimaryBodyIrAppendReturnScalarContext(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          typedIr: texpr.TypedExprIr,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          sourcePath: str,
                                          lineNumber: int32,
                                          valText: str,
                                          returnTypeKind: int32,
                                          currentBlockStart: var int32): bool =
    # Scalar return values resolve through the context-aware resolver first
    # so ptr->field reads emit their loads; otherwise the bool-condition
    # lowering would clamp arbitrary int returns to 0/1.
    if returnTypeKind != coreir.LocalI32Tag &&
       returnTypeKind != coreir.LocalI64Tag &&
       returnTypeKind != coreir.LocalPtrTag:
        return false
    # 仅真 bl 调用面才不可经此急切求值；内联数值/指针 cast（uint64(...)）与
    # 分组括号无副作用，可在上下文标量求值器内安全下降，否则
    # `(uint64(p->f) << n) | uint64(x)` 这类 u64 位运算 return 会被
    # 粗粒度括号探测误判为调用面而 bail 回退 cold（wcz）。
    if PrimaryBodyIrTextHasRealCallSurface(valText):
        return false
    if !strutil.Contains(valText, "->"):
        return false
    var returnScalarOrdinal: int32 = -1
    let returnScalarSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      sourcePath,
                                                                      lineNumber,
                                                                      valText,
                                                                      returnTypeKind)
    if returnScalarSlot < 0:
        return false
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  returnScalarSlot,
                                  returnTypeKind,
                                  0,
                                  false)
    return true

@borrows
fn PrimaryBodyIrAppendReturnBoolCondition(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          lowering: lower.LoweringPlanStub,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: var lower.PrimaryObjectIrFunction,
                                          sourcePath: str,
                                          lineNumber: int32,
                                          returnExprNodeIndex: int32,
                                          returnExprRaw: str,
                                          currentBlockStart: var int32,
                                          callOrdinal: var int32,
                                          nextOpIndex: var int32): bool =
    let returnExpr = PrimaryBodyIrStripOuterParens(returnExprRaw)
    if returnExpr == "":
        return false
    if texpr.TypedExprNormalizeTypeText(typedFn.returnType) != "bool":
        if B2PrimaryObjectPlanTraceActive():
            B2PrimaryObjectPlanTrace(Fmt"phase=return_bool_cond_skip function={typedFn.functionName} return_type={typedFn.returnType} expr={returnExpr}")
        return false
    let conditionBlockCount = PrimaryBodyIrConditionCbrBlockCount(returnExpr)
    if conditionBlockCount <= 0:
        return false
    let successBlock = bodyIR.blocks.len + conditionBlockCount
    var pendingFailureTerms: int32[]
    if !PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                          slotNames,
                                          lowering,
                                          typedFn,
                                          irFunction,
                                          sourcePath,
                                          lineNumber,
                                          returnExprNodeIndex,
                                          returnExpr,
                                          successBlock,
                                          -1,
                                          callOrdinal,
                                          nextOpIndex,
                                          currentBlockStart,
                                          pendingFailureTerms):
        return false
    let failureBlock = successBlock + 1
    for failureIndex in 0..<pendingFailureTerms.len:
        let termIndex = pendingFailureTerms[failureIndex]
        if termIndex >= 0 && termIndex < bodyIR.terms.len:
            bodyIR.terms[termIndex].falseBlock = failureBlock
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  -1,
                                  coreir.LocalI32Tag,
                                  1,
                                  true)
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  -1,
                                  coreir.LocalI32Tag,
                                  0,
                                  true)
    return true

@borrows
fn PrimaryBodyIrAssignLhsRootIndexText(bindingNameRaw: str,
                                        rootIdent: str,
                                        indexOut: var str): bool =
    indexOut = ""
    let bindingName = strutil.Strip(bindingNameRaw)
    if bindingName == "" || rootIdent == "":
        return false
    # Top-level (bracket-aware) `.` separates the root segment from the field
    # tail. The root segment is everything before it.
    var depth = 0
    var dotPos = -1
    var i = 0
    while i < len(bindingName):
        let ch = bindingName[i]
        if ch == '[' || ch == '(':
            depth = depth + 1
        elif ch == ']' || ch == ')':
            if depth > 0:
                depth = depth - 1
        elif depth == 0 && ch == '.':
            dotPos = i
            break
        i = i + 1
    if dotPos <= 0:
        return false
    let rootSegment = strutil.Strip(strings.SliceBytes(bindingName, 0, dotPos))
    # Root segment must be exactly `rootIdent[<index>]` (subscripted root). A
    # bare `rootIdent` (no subscript) or a `rootIdent.sub` chain is not this
    # form and must be left to the existing field-store path.
    if !PrimaryStartsWith(rootSegment, rootIdent):
        return false
    let afterRoot = strings.SliceBytes(rootSegment, len(rootIdent), len(rootSegment) - len(rootIdent))
    if len(afterRoot) < 3 || afterRoot[0] != '[':
        return false
    if strings.SliceBytes(afterRoot, len(afterRoot) - 1, 1) != "]":
        return false
    let inner = strutil.Strip(strings.SliceBytes(afterRoot, 1, len(afterRoot) - 2))
    if inner == "" ||
       parser.ParserFindText(inner, "[") >= 0 ||
       parser.ParserFindText(inner, "]") >= 0:
        return false
    indexOut = inner
    return true

# Real element-address field store for `xs[i].field = v` where `xs` is a
# fixed-length array of structs (root type `Elem[N]`). The array storage is
# inline, so the element address is `base_addr + idx*elemStride`; we then
# FieldStore the value at `elemAddr + fieldOffset`. Without this the index is
# dropped and every `xs[k].field` writes element 0's field (a real miscompile).
# Returns false (leaving bodyIR untouched of a committed store) when the shape
# is not a fixed-array indexed-root field store, so callers can fall through.
@borrows
fn PrimaryBodyIrAppendFixedArrayIndexedFieldStore(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   typedIr: texpr.TypedExprIr,
                                                   sourcePath: str,
                                                   lineNumber: int32,
                                                   rootType: str,
                                                   indexText: str,
                                                   baseSlot: int32,
                                                   valueSlot: int32,
                                                   fieldOffsetBytes: int32,
                                                   fieldSizeBytes: int32,
                                                   varI32ParamNames: str[],
                                                   callOrdinal: var int32): bool =
    if baseSlot < 0 || valueSlot < 0 || fieldSizeBytes <= 0 || indexText == "":
        return false
    let elemType = PrimaryBodyIrIndexedElementTypeText(rootType)
    if elemType == "":
        return false
    # Reject dynamic seqs — their element buffer is behind a header pointer; only
    # fixed `Elem[N]` arrays have inline storage addressed off the base slot.
    if PrimaryBodyIrTypeTextIsDynamicSeq(rootType):
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize <= 0:
        return false
    if fieldOffsetBytes < 0 || fieldOffsetBytes + fieldSizeBytes > elemSize:
        return false
    # base address ptr: aggregate local slot value already yields its address,
    # so `base + 0` materializes the array start as a ptr.
    let baseAddrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR, slotNames, lineNumber, baseSlot, 0)
    if baseAddrSlot < 0:
        return false
    let idxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      typedIr,
                                                      sourcePath,
                                                      indexText,
                                                      coreir.LocalI32Tag,
                                                      callOrdinal)
    if idxSlot < 0:
        return false
    let eszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#fae_esz#{lineNumber}#{bodyIR.ops.len}",
                                                  coreir.LocalI64Tag,
                                                  elemSize)
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#fae_addr#{lineNumber}#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if eszSlot < 0 || addrSlot < 0:
        return false
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = addrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, idxSlot)
    add(addrOp.operands, eszSlot)
    add(addrOp.operands, baseAddrSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = addrSlot
    add(storeOp.operands, addrSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, fieldOffsetBytes)
    add(storeOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    return true

# Nested indexed-field store `arr[i].field[j] = v` where `arr` is a fixed array
# of structs and `field` is itself a fixed inline scalar array inside the struct.
# The structured root name kept only `arr` and the field tail kept only `field[j]`,
# so the existing indexed-field arm stores at the bare root base + fieldOffset,
# SILENTLY DROPPING the outer `[i]` — every element writes element 0's field-array
# (a real miscompile). Recover the outer index and build the full inline address:
#   &arr           = base
#   &arr[i]        = base + i*elemSize          (madd)
#   &arr[i].field  = &arr[i] + fieldOffset      (add)
#   &arr[i].f[j]   = &arr[i].field + j*fElemSz  (madd)
# then FieldStore v there (offset 0, width fElemSz). Returns false — no store
# committed — when the shape is not this clean fixed/fixed nesting with a scalar
# inner element, so the caller can honestly poison rather than drop the index.
# Twin of primary_object_plan.cheng PrimaryBodyIrAppendNestedFixedArrayIndexedFieldStore.
@borrows
fn PrimaryBodyIrAppendNestedFixedArrayIndexedFieldStore(bodyIR: var coreir.BodyIR,
                                                        slotNames: var str[],
                                                        typedIr: texpr.TypedExprIr,
                                                        typedFn: texpr.TypedExprIrFunction,
                                                        irFunction: lower.PrimaryObjectIrFunction,
                                                        sourcePath: str,
                                                        lineNumber: int32,
                                                        rootName: str,
                                                        rootTypeHint: str,
                                                        outerIndexText: str,
                                                        fieldName: str,
                                                        innerIndexText: str,
                                                        rhsText: str,
                                                        baseSlot: int32,
                                                        varI32ParamNames: str[],
                                                        callOrdinal: var int32): bool =
    if baseSlot < 0 || outerIndexText == "" || innerIndexText == "" || fieldName == "":
        return false
    # Prefer the stmt-resolved array-type hint (resolves both global and local
    # roots); fall back to the binding lookup only when it is not an indexable array.
    var rootType = texpr.TypedExprStripVarType(rootTypeHint)
    if rootType == "" ||
       PrimaryBodyIrTypeTextIsDynamicSeq(rootType) ||
       PrimaryBodyIrIndexedElementTypeText(rootType) == "":
        rootType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                               typedFn,
                                                                               irFunction,
                                                                               lineNumber,
                                                                               rootName))
    if rootType == "" || PrimaryBodyIrTypeTextIsDynamicSeq(rootType):
        return false
    let elemType = PrimaryBodyIrIndexedElementTypeText(rootType)
    if elemType == "":
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize <= 0:
        return false
    var fieldType = ""
    var fieldOffsetBytes: int32
    var fieldSizeBytes: int32
    var fieldAlignBytes: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           elemType,
                                           fieldName,
                                           fieldType,
                                           fieldOffsetBytes,
                                           fieldSizeBytes,
                                           fieldAlignBytes):
        return false
    if fieldOffsetBytes < 0 || fieldSizeBytes <= 0 || fieldOffsetBytes + fieldSizeBytes > elemSize:
        return false
    if PrimaryBodyIrTypeTextIsDynamicSeq(fieldType):
        return false
    var fieldElemKind: int32
    var fieldElemSize: int32
    if !PrimaryBodyIrSeqElementShapeFromText(typedIr, sourcePath, fieldType, fieldElemKind, fieldElemSize):
        return false
    if fieldElemSize <= 0 || fieldOffsetBytes + fieldElemSize > elemSize:
        return false
    var valueKind = fieldElemKind
    if fieldElemSize == 1:
        valueKind = coreir.LocalI32Tag
    if valueKind != coreir.LocalI32Tag &&
       valueKind != coreir.LocalI64Tag &&
       valueKind != coreir.LocalPtrTag:
        return false
    var valueText = strings.CloneStr(rhsText)
    if fieldElemSize == 1:
        let u8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
        if u8Inner != "":
            valueText = u8Inner
    var valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        typedIr,
                                                        sourcePath,
                                                        valueText,
                                                        valueKind,
                                                        callOrdinal)
    if valueSlot < 0:
        valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               sourcePath,
                                                               lineNumber,
                                                               valueText,
                                                               valueKind)
    if valueSlot < 0 || PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < fieldElemSize:
        return false
    let baseAddrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR, slotNames, lineNumber, baseSlot, 0)
    if baseAddrSlot < 0:
        return false
    let outerIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          typedIr,
                                                          sourcePath,
                                                          outerIndexText,
                                                          coreir.LocalI32Tag,
                                                          callOrdinal)
    if outerIdxSlot < 0:
        return false
    let elemSzSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#nfae_esz#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalI64Tag,
                                                    elemSize)
    let elemAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#nfae_eaddr#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalPtrTag)
    if elemSzSlot < 0 || elemAddrSlot < 0:
        return false
    var elemAddrOp: coreir.BodyOp
    elemAddrOp.kind = coreir.BodyOpBinOpTag
    elemAddrOp.target = elemAddrSlot
    add(elemAddrOp.operands, coreir.LocalI64Tag)
    add(elemAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(elemAddrOp.operands, outerIdxSlot)
    add(elemAddrOp.operands, elemSzSlot)
    add(elemAddrOp.operands, baseAddrSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, elemAddrOp)
    let fieldArrAddrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR, slotNames, lineNumber, elemAddrSlot, fieldOffsetBytes)
    if fieldArrAddrSlot < 0:
        return false
    let innerIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          typedIr,
                                                          sourcePath,
                                                          innerIndexText,
                                                          coreir.LocalI32Tag,
                                                          callOrdinal)
    if innerIdxSlot < 0:
        return false
    let felemSzSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#nfae_fesz#{lineNumber}#{bodyIR.ops.len}",
                                                     coreir.LocalI64Tag,
                                                     fieldElemSize)
    let innerAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#nfae_iaddr#{lineNumber}#{bodyIR.ops.len}",
                                                     coreir.LocalPtrTag)
    if felemSzSlot < 0 || innerAddrSlot < 0:
        return false
    var innerAddrOp: coreir.BodyOp
    innerAddrOp.kind = coreir.BodyOpBinOpTag
    innerAddrOp.target = innerAddrSlot
    add(innerAddrOp.operands, coreir.LocalI64Tag)
    add(innerAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(innerAddrOp.operands, innerIdxSlot)
    add(innerAddrOp.operands, felemSzSlot)
    add(innerAddrOp.operands, fieldArrAddrSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, innerAddrOp)
    var nestedStoreOp: coreir.BodyOp
    nestedStoreOp.kind = coreir.BodyOpFieldStoreTag
    nestedStoreOp.target = innerAddrSlot
    add(nestedStoreOp.operands, innerAddrSlot)
    add(nestedStoreOp.operands, valueSlot)
    add(nestedStoreOp.operands, 0)
    add(nestedStoreOp.operands, fieldElemSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, nestedStoreOp)
    return true

# Element-address field store for `xs[i].field = v` where `xs` is a *dynamic
# seq* of structs (root type `Elem[]` / `seq[Elem]`). Unlike the fixed-array
# form the element storage lives behind the seq header's data pointer, so the
# element address is `*(base + 8) + idx*elemSize`; we then FieldStore the value
# at `elemAddr + fieldOffset`. The header layout is {len: i64 @0, data: ptr @8}.
# Returns false (no store committed) when the shape does not apply.
@borrows
fn PrimaryBodyIrAppendDynamicSeqIndexedFieldStore(bodyIR: var coreir.BodyIR,
                                                  slotNames: var str[],
                                                  typedIr: texpr.TypedExprIr,
                                                  sourcePath: str,
                                                  lineNumber: int32,
                                                  rootType: str,
                                                  indexText: str,
                                                  baseSlot: int32,
                                                  valueSlot: int32,
                                                  fieldOffsetBytes: int32,
                                                  fieldSizeBytes: int32,
                                                  varI32ParamNames: str[],
                                                  callOrdinal: var int32): bool =
    if baseSlot < 0 || valueSlot < 0 || fieldSizeBytes <= 0 || indexText == "":
        return false
    if !PrimaryBodyIrTypeTextIsDynamicSeq(rootType):
        return false
    let elemType = PrimaryBodyIrIndexedElementTypeText(rootType)
    if elemType == "":
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize <= 0:
        return false
    if fieldOffsetBytes < 0 || fieldOffsetBytes + fieldSizeBytes > elemSize:
        return false
    # Load the seq buffer pointer from the header (base + 8).
    let bufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                slotNames,
                                                Fmt"#dsfs_buf#{lineNumber}#{bodyIR.ops.len}",
                                                coreir.LocalPtrTag)
    if bufSlot < 0:
        return false
    var bufLoadOp: coreir.BodyOp
    bufLoadOp.kind = coreir.BodyOpFieldLoadTag
    bufLoadOp.target = bufSlot
    add(bufLoadOp.operands, baseSlot)
    add(bufLoadOp.operands, bufSlot)
    add(bufLoadOp.operands, 8)
    add(bufLoadOp.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, bufLoadOp)
    let idxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      typedIr,
                                                      sourcePath,
                                                      indexText,
                                                      coreir.LocalI32Tag,
                                                      callOrdinal)
    if idxSlot < 0:
        return false
    let eszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#dsfs_esz#{lineNumber}#{bodyIR.ops.len}",
                                                  coreir.LocalI64Tag,
                                                  elemSize)
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#dsfs_addr#{lineNumber}#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if eszSlot < 0 || addrSlot < 0:
        return false
    # elemAddr = idx*elemSize + buf (Madd: a*b + c).
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = addrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, idxSlot)
    add(addrOp.operands, eszSlot)
    add(addrOp.operands, bufSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = addrSlot
    add(storeOp.operands, addrSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, fieldOffsetBytes)
    add(storeOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    return true

# Element-address field load for `xs[i].field` where `xs` is a fixed-length
# array of structs. Mirror of the store path: elemAddr = base_addr + idx*stride,
# then FieldLoad at elemAddr + fieldOffset into a typed value slot. Returns the
# value slot, or -1 when the shape does not apply.
@borrows
fn PrimaryBodyIrAppendFieldArrayIndexedSubFieldStore(bodyIR: var coreir.BodyIR,
                                                     slotNames: var str[],
                                                     varI32ParamNames: str[],
                                                     typedIr: texpr.TypedExprIr,
                                                     typedFn: texpr.TypedExprIrFunction,
                                                     irFunction: lower.PrimaryObjectIrFunction,
                                                     sourcePath: str,
                                                     lineNumber: int32,
                                                     rootName: str,
                                                     rootType: str,
                                                     fieldPath: str,
                                                     valueSlot: int32,
                                                     callOrdinal: var int32): bool =
    if valueSlot < 0:
        return false
    var arrayFieldName = ""
    var indexText = ""
    var subFieldName = ""
    if !PrimaryBodyIrFieldArrayIndexedSubFieldParts(fieldPath,
                                                    arrayFieldName,
                                                    indexText,
                                                    subFieldName):
        return false
    var elemType = ""
    var elemSize: int32
    let addrSlot = PrimaryBodyIrFieldArrayIndexedElemAddrSlot(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              sourcePath,
                                                              lineNumber,
                                                              rootName,
                                                              rootType,
                                                              arrayFieldName,
                                                              indexText,
                                                              elemType,
                                                              elemSize,
                                                              callOrdinal)
    if addrSlot < 0 || elemType == "" || elemSize <= 0:
        return false
    # Resolve the scalar subfield within the element type.
    var subFieldType = ""
    var subFieldOffset: int32
    var subFieldSize: int32
    var subFieldAlign: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           elemType,
                                           subFieldName,
                                           subFieldType,
                                           subFieldOffset,
                                           subFieldSize,
                                           subFieldAlign):
        return false
    if subFieldOffset < 0 || subFieldSize <= 0 || subFieldOffset + subFieldSize > elemSize:
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < subFieldSize:
        return false
    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = addrSlot
    add(storeOp.operands, addrSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, subFieldOffset)
    add(storeOp.operands, subFieldSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    return true

# Read path for `root.arrayField[idx].subField` (fixed array of structs as a
# struct field). Mirror of the store; FieldLoad the scalar subfield into a typed
# value slot. Returns the value slot, or -1 when the shape does not apply.
@borrows
fn PrimaryBodyIrAppendSimpleFieldAssignFast(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            lowering: lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: var lower.PrimaryObjectIrFunction,
                                            stmt: lower.PrimaryObjectIrStatement,
                                            rhsText: str,
                                            callOrdinal: var int32,
                                            currentBlockStart: var int32): bool =
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        # P1 consumer expand: 4→15 case label dispatch via helper (assign_field).
        let reasonLabel = texpr.TypedExprIrRhsBailReasonLabel(stmt.rhsBailReason)
        os.WriteLine(os.GetStderr(), Fmt"phase=assign_field_fast_entry fn={typedFn.functionName} line={stmt.lineNumber} reason_label={reasonLabel}")
    if stmt.assignFieldName == "" || stmt.assignRootName == "":
        return false
    var rootType = strings.CloneStr(stmt.assignRootType)
    B2PrimaryObjectPlanGuardTick()
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_meta_begin function={typedFn.functionName} line={stmt.lineNumber} root={stmt.assignRootName} root_type_len={rootType.len} field={stmt.assignFieldName} field_type_len={stmt.assignFieldType.len} field_size={stmt.assignFieldSizeBytes}")
    if rootType == "" || rootType == "unknown" || !B2PrimaryObjectMetadataTextStable(rootType):
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_root_lookup_begin function={typedFn.functionName} line={stmt.lineNumber} root={stmt.assignRootName}")
        rootType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   stmt.lineNumber,
                                                   stmt.assignRootName)
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_root_lookup_done function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len}")
    if rootType == "" || rootType == "unknown" || !B2PrimaryObjectMetadataTextStable(rootType):
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_root_unstable function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len}")
        return false
    var fieldType = strings.CloneStr(stmt.assignFieldType)
    var fieldOffsetBytes = stmt.assignFieldOffsetBytes
    var fieldSizeBytes = stmt.assignFieldSizeBytes
    var fieldAlignBytes: int32
    # G6/G7: `root.arrayField[idx].subField = v` — the seq/array lives behind a
    # struct FIELD, so the field path is dotted *and* indexed (e.g.
    # `localSlots[si].noAlias`, `statements[i].statementIndex`). The stmt carries
    # no leaf meta (the cumulative probe only sees the seq-header field), and the
    # plain dotted-path guard below would bail to cold. Resolve the LEAF subfield
    # meta now (arrayField -> element type -> subField), so `fieldType`/size are
    # the scalar subfield and the value materialization + faisIsShape element
    # store fire instead of the cold drop. The element store itself
    # (AppendFieldArrayIndexedSubFieldStore) re-resolves the same meta, so this
    # only unblocks the value path; offsets remain authoritative there.
    var faisEarlyArrayField = ""
    var faisEarlyIndexText = ""
    var faisEarlySubField = ""
    if (fieldType == "" || fieldSizeBytes <= 0) &&
       PrimaryBodyIrFieldArrayIndexedSubFieldParts(stmt.assignFieldName,
                                                   faisEarlyArrayField,
                                                   faisEarlyIndexText,
                                                   faisEarlySubField):
        var faisArrayFieldType = ""
        var faisArrayFieldOffset: int32
        var faisArrayFieldSize: int32
        var faisArrayFieldAlign: int32
        if PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                              stmt.sourcePath,
                                              rootType,
                                              faisEarlyArrayField,
                                              faisArrayFieldType,
                                              faisArrayFieldOffset,
                                              faisArrayFieldSize,
                                              faisArrayFieldAlign):
            let faisArrayFieldNorm = texpr.TypedExprNormalizeTypeText(faisArrayFieldType)
            var faisLeafElemType = ""
            if PrimaryStartsWith(faisArrayFieldNorm, "seq[") &&
               len(faisArrayFieldNorm) > 5 &&
               strings.SliceBytes(faisArrayFieldNorm, len(faisArrayFieldNorm) - 1, 1) == "]":
                faisLeafElemType = strings.SliceBytes(faisArrayFieldNorm, 4, len(faisArrayFieldNorm) - 5)
            elif len(faisArrayFieldNorm) >= 2 &&
                 strings.SliceBytes(faisArrayFieldNorm, len(faisArrayFieldNorm) - 2, 2) == "[]":
                faisLeafElemType = strings.SliceBytes(faisArrayFieldNorm, 0, len(faisArrayFieldNorm) - 2)
            if faisLeafElemType != "":
                var faisSubType = ""
                var faisSubOffset: int32
                var faisSubSize: int32
                var faisSubAlign: int32
                if PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                      stmt.sourcePath,
                                                      faisLeafElemType,
                                                      faisEarlySubField,
                                                      faisSubType,
                                                      faisSubOffset,
                                                      faisSubSize,
                                                      faisSubAlign):
                    if faisSubSize > 0 && faisSubOffset >= 0:
                        fieldType = faisSubType
                        fieldOffsetBytes = faisSubOffset
                        fieldSizeBytes = faisSubSize
    # Authoritative field meta first: stmt-provided offsets may be unset (0)
    # even when type/size are present, which would silently store every
    # field at offset 0. 多跳路径（a.b.c）除外：单字段查询按 IdentPrefix
    # 只解析首跳，覆写会把叶子累计 meta 换成首跳 meta（offset/size 全错）；
    # 点路径以 stmt 累计 meta 为准（同 4280 处实参机器的点路径守卫）。
    var fieldMetaProbeType = ""
    var fieldMetaProbeOffset: int32
    var fieldMetaProbeSize: int32
    var fieldMetaProbeAlign: int32
    if !PrimaryBodyIrTextHasDot(stmt.assignFieldName) &&
       PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                          stmt.sourcePath,
                                          rootType,
                                          stmt.assignFieldName,
                                          fieldMetaProbeType,
                                          fieldMetaProbeOffset,
                                          fieldMetaProbeSize,
                                          fieldMetaProbeAlign):
        if fieldMetaProbeSize > 0 && fieldMetaProbeOffset >= 0:
            fieldType = fieldMetaProbeType
            fieldOffsetBytes = fieldMetaProbeOffset
            fieldSizeBytes = fieldMetaProbeSize
            fieldAlignBytes = fieldMetaProbeAlign
    var primaryColdCond10: bool
    if fieldType == "":
        primaryColdCond10 = true
    if fieldType == "unknown":
        primaryColdCond10 = true
    if !B2PrimaryObjectMetadataTextStable(fieldType):
        primaryColdCond10 = true
    if fieldSizeBytes <= 0:
        primaryColdCond10 = true
    if primaryColdCond10:
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_field_lookup_begin function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len} field={stmt.assignFieldName}")
        if PrimaryBodyIrTextHasDot(stmt.assignFieldName):
            # 点路径无 stmt 累计 meta 时不可用首跳单字段查询补——留文本路径
            return false
        if !PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                               stmt.sourcePath,
                                               rootType,
                                               stmt.assignFieldName,
                                               fieldType,
                                               fieldOffsetBytes,
                                               fieldSizeBytes,
                                               fieldAlignBytes):
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_field_lookup_miss function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len} field={stmt.assignFieldName}")
            return false
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_field_lookup_done function={typedFn.functionName} line={stmt.lineNumber} field_type={fieldType} size={fieldSizeBytes}")
    var primaryColdCond11: bool
    if fieldType == "":
        primaryColdCond11 = true
    if fieldType == "unknown":
        primaryColdCond11 = true
    if !B2PrimaryObjectMetadataTextStable(fieldType):
        primaryColdCond11 = true
    if fieldSizeBytes <= 0:
        primaryColdCond11 = true
    if primaryColdCond11:
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_field_unstable function={typedFn.functionName} line={stmt.lineNumber} field_type_len={fieldType.len} size={fieldSizeBytes}")
        return false
    B2PrimaryObjectPlanGuardTick()
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_begin function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len} field={stmt.assignFieldName} field_type={fieldType} size={fieldSizeBytes}")
    # `root.arrayField[idx].subField = v` (fixed array of structs as a struct
    # field). The mid-path index means the stmt-resolved field offset collapsed
    # the index out (every element wrote elem 0), and the field-tail-index block
    # below only fires when the field path ENDS with `]`. Route to the real
    # element-address store: base + arrayFieldOffset + idx*elemStride, then
    # FieldStore the subfield at its offset. `fieldType`/`fieldSizeBytes` already
    # describe the scalar subfield (resolved via the field-path meta), so the
    # value materialized below is the subfield value.
    var faisArrayField = ""
    var faisIndexText = ""
    var faisSubField = ""
    let faisIsShape = PrimaryBodyIrFieldArrayIndexedSubFieldParts(stmt.assignFieldName,
                                                                  faisArrayField,
                                                                  faisIndexText,
                                                                  faisSubField)
    # 批次6b：LHS 形态拆解。字段元数据描述的是字段本体（seq 字段=16 字节
    # 头），路径尾下标（a.b[i]/a.b.c[i]）必须按动态 seq 元素店降（buf 间接
    # + 元素地址 + 元素宽 FieldStore）；其余含下标形态留文本路径——直接
    # FieldStore 会覆写 seq 头。
    var fieldIndexText = ""
    var fieldElemKind = coreir.LocalInvalidTag
    var fieldElemSize: int32
    var storeSizeBytes = fieldSizeBytes
    let fieldBracketPos = parser.ParserFindText(stmt.assignFieldName, "[")
    if fieldBracketPos >= 0 && !faisIsShape:
        var fieldClosePos = -1
        var fieldScan = fieldBracketPos
        var fieldDepth: int32
        while fieldScan < len(stmt.assignFieldName):
            if stmt.assignFieldName[fieldScan] == '[':
                fieldDepth = fieldDepth + 1
            elif stmt.assignFieldName[fieldScan] == ']':
                fieldDepth = fieldDepth - 1
                if fieldDepth == 0:
                    fieldClosePos = fieldScan
                    break
            fieldScan = fieldScan + 1
        if fieldBracketPos <= 0 ||
           fieldClosePos != len(stmt.assignFieldName) - 1:
            return false
        fieldIndexText = strutil.Strip(strings.SliceBytes(stmt.assignFieldName,
                                                          fieldBracketPos + 1,
                                                          fieldClosePos - fieldBracketPos - 1))
        if fieldIndexText == "":
            return false
        var fieldElemInner = ""
        let fieldTypeNorm = texpr.TypedExprNormalizeTypeText(fieldType)
        if PrimaryStartsWith(fieldTypeNorm, "seq[") &&
           len(fieldTypeNorm) > 5 &&
           strings.SliceBytes(fieldTypeNorm, len(fieldTypeNorm) - 1, 1) == "]":
            fieldElemInner = strings.SliceBytes(fieldTypeNorm, 4, len(fieldTypeNorm) - 5)
        elif len(fieldTypeNorm) >= 2 &&
             strings.SliceBytes(fieldTypeNorm, len(fieldTypeNorm) - 2, 2) == "[]":
            fieldElemInner = strings.SliceBytes(fieldTypeNorm, 0, len(fieldTypeNorm) - 2)
        if fieldElemInner == "":
            return false
        fieldElemKind = PrimaryBodyIrNodeEvalTypedSlotShape(lowering.typedIr,
                                                            stmt.sourcePath,
                                                            fieldElemInner,
                                                            fieldElemSize)
        if fieldElemKind == coreir.LocalInvalidTag || fieldElemSize <= 0:
            return false
        storeSizeBytes = fieldElemSize
    var storeValueKind = PrimaryBodyIrTypeKindFromText(fieldType)
    if fieldIndexText != "":
        storeValueKind = fieldElemKind
    let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          stmt.sourcePath,
                                                          stmt.assignRootName,
                                                          rootType)
    if baseSlot < 0:
        return false
    # 批次3：rhs 已节点化时先经节点求值器物化字段值槽（FieldStore 值源）；
    # 形态不符落回既有文本值查找（迁移窗口双轨）。批次6b：子树含调用时
    # 先过纯探针并预检值形态——调用一旦发射不可落回文本路径。
    var valueSlot: int32 = -1
    # Comparison-condition ternary field store `r.v = a > b ? x : y` (Lane 2,
    # the field-store sibling of Lane B's return form). The eager/branchless
    # text scalar evaluators below cannot produce a cond slot from a compare, so
    # they would either decline (whole fill bails / SKIP) or — worse — collapse
    # the ternary into an unconditional value (silent miscompile: every store
    # took one fixed arm). Route the cmp-cond ternary through the real cbr
    # lowering (cmp + branch, only the selected arm runs) into a value slot, then
    # FieldStore that. Only the plain scalar i32/i64 field form (no field index,
    # no indexed root) is handled here; an `&&`/`||` condition is refused by
    # EmitConditionOps -> AppendScalarTernaryBlockValue returns false and we
    # honestly STOP (return false, no fallback to the miscompiling text path).
    if stmt.assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary &&
       fieldIndexText == "" &&
       !PrimaryBodyIrTextHasDot(stmt.assignFieldName) &&
       (storeValueKind == coreir.LocalI32Tag || storeValueKind == coreir.LocalI64Tag):
        var fternRootIndexText = ""
        # Indexed-root field LHS (`xs[i].v = ...`) needs element-address store;
        # combining it with a cbr ternary value is out of this surgical scope —
        # leave it to STOP rather than store at the wrong element.
        if !PrimaryBodyIrAssignLhsRootIndexText(stmt.bindingName, stmt.assignRootName, fternRootIndexText):
            let fternValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                               slotNames,
                                                               Fmt"#fstern#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                               storeValueKind)
            if fternValueSlot < 0:
                return false
            if !PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,
                                                           typedFn,
                                                           irFunction,
                                                           stmt.sourcePath,
                                                           stmt.lineNumber,
                                                           stmt.rhsNodeIndex,
                                                           rhsText,
                                                           fternValueSlot,
                                                           storeValueKind,
                                                           callOrdinal,
                                                           currentBlockStart):
                # Cmp-cond ternary recognized but its condition is unsupported
                # here (e.g. `&&`/`||`, refused by EmitConditionOps). Returning
                # false would let the statement fall through and be silently
                # DROPPED (the field keeps its zero-init -> a fresh miscompile).
                # Append an explicit InvalidOp so the function becomes
                # unencodable and the driver honestly bails (no .o) instead.
                PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 817, 0)
                return true
            valueSlot = fternValueSlot
    # G7: field/element store of a boolean `&&`/`||` value, e.g.
    #   xs[i].flag = proofBacked && refCount[i] <= 1
    # The scalar/node evaluators below cannot lower a top-level `&&`/`||` (the
    # comparison sub-token would make EmitConditionOps bail), so the statement
    # used to fall to the InvalidOp(718) cold drop. When the whole RHS is
    # call-free both operands are side-effect-free, so the non-short-circuit
    # CondValue01Slot (bitwise-AND/OR of the two 0/1 sub-values) is byte-exact
    # with short-circuit `&&`/`||`. A real call surface on either side could
    # need short-circuit skipping, so we restrict to the pure form and otherwise
    # leave the later handlers to STOP rather than risk an eager-eval miscompile.
    if valueSlot < 0 &&
       storeValueKind == coreir.LocalI32Tag &&
       (PrimaryBodyIrConditionHasAnd(rhsText) || PrimaryBodyIrConditionHasOr(rhsText)):
        var boolValueSlot = PrimaryBodyIrCondValue01Slot(bodyIR,
                                                         slotNames,
                                                         lowering,
                                                         typedFn,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         stmt.lineNumber,
                                                         rhsText,
                                                         Fmt"#fstore_bool#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                         callOrdinal)
        # T78 current (镜像 primary_object_plan.cheng 同名点): CondValue01Slot
        # honestly bails(-1) on a faulting eager surface (call/下标) operand —
        # fall to the real CBR-chain assigner instead of dropping to
        # InvalidOp(718).
        if boolValueSlot < 0:
            let fstoreBoolScratchSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                      slotNames,
                                                                      Fmt"#fstore_bool_cbr#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                                      coreir.LocalI32Tag)
            if fstoreBoolScratchSlot >= 0:
                var fstoreBoolBlockStart = currentBlockStart
                if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                          slotNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          stmt.rhsNodeIndex,
                                                          rhsText,
                                                          fstoreBoolScratchSlot,
                                                          callOrdinal,
                                                          fstoreBoolBlockStart):
                    currentBlockStart = fstoreBoolBlockStart
                    boolValueSlot = fstoreBoolScratchSlot
        if boolValueSlot >= 0:
            valueSlot = boolValueSlot
    if valueSlot < 0 && stmt.rhsNodeIndex >= 0:
        PrimaryBodyIrNodeEvalMissOpReset()
        var nodeFieldReady = true
        if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
            let nodeFieldProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                stmt.rhsNodeIndex)
            if nodeFieldProbeKind < 0:
                nodeFieldReady = false
            elif storeSizeBytes <= 4 && nodeFieldProbeKind == coreir.LocalI32Tag:
                nodeFieldReady = true
            elif storeSizeBytes == 8 &&
                 (nodeFieldProbeKind == coreir.LocalI64Tag ||
                  nodeFieldProbeKind == coreir.LocalPtrTag ||
                  (nodeFieldProbeKind == coreir.LocalI32Tag &&
                   storeValueKind == coreir.LocalI64Tag)):
                nodeFieldReady = true
            elif storeSizeBytes == 24 && nodeFieldProbeKind == coreir.LocalStrTag:
                nodeFieldReady = true
            elif nodeFieldProbeKind == coreir.LocalAggregateTag:
                # 聚合预检尺寸：Value 内征投影按 Result 内型算（node.resultType
                # 对泛型内征不可靠），其余按节点返回类型形状。
                var nodeFieldProbeSize: int32
                var nodeFieldShapeDone = false
                if lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr:
                    let nodeFieldRhsLiteralRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                                                       lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                    if IsOk(nodeFieldRhsLiteralRes) &&
                       Value(nodeFieldRhsLiteralRes) == "Value":
                        let nodeFieldRvArgIndex = PrimaryBodyIrResultValueArgNodeIndex(lowering.typedIr, stmt.rhsNodeIndex)
                        if nodeFieldRvArgIndex >= 0:
                            var nodeFieldRvKind: int32
                            var nodeFieldRvOffset: int32
                            let nodeFieldRhsSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                                                           lowering.typedIr.nodes2_sourcePathIds[stmt.rhsNodeIndex])
                            var nodeFieldRhsSourcePath = ""
                            if IsOk(nodeFieldRhsSrcRes):
                                nodeFieldRhsSourcePath = Value(nodeFieldRhsSrcRes)
                            if PrimaryBodyIrResultValueProjectShape(lowering.typedIr,
                                                                    nodeFieldRhsSourcePath,
                                                                    PrimaryBodyIrResultValueInnerTypeText(lowering.typedIr,
                                                                                                          stmt.rhsNodeIndex,
                                                                                                          nodeFieldRvArgIndex),
                                                                    nodeFieldRvKind,
                                                                    nodeFieldProbeSize,
                                                                    nodeFieldRvOffset):
                                nodeFieldShapeDone = true
                if !nodeFieldShapeDone:
                    var safSrc = ""
                    var safType = ""
                    if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                        let safSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[stmt.rhsNodeIndex])
                        let safTypeRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[stmt.rhsNodeIndex])
                        if IsOk(safSrcRes) && IsOk(safTypeRes):
                            safSrc = Value(safSrcRes)
                            safType = Value(safTypeRes)
                    let _ = PrimaryBodyIrNodeEvalTypedSlotShape(lowering.typedIr,
                                                                safSrc,
                                                                texpr.TypedExprStripVarType(safType),
                                                                nodeFieldProbeSize)
                nodeFieldReady = nodeFieldProbeSize >= storeSizeBytes
            else:
                nodeFieldReady = false
        var nodeFieldValueSlot: int32 = -1
        if nodeFieldReady:
            nodeFieldValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,
                                                       typedFn,
                                                       irFunction,
                                                       stmt.rhsNodeIndex,
                                                       callOrdinal)
        if nodeFieldValueSlot >= 0:
            var nodeFieldValueKind = PrimaryBodyIrSlotType(bodyIR, nodeFieldValueSlot)
            if storeSizeBytes == 8 &&
               storeValueKind == coreir.LocalI64Tag &&
               nodeFieldValueKind == coreir.LocalI32Tag:
                # i64 字段 + i32 值：显式 sign-extend（与 NodeEvalStore 同语义）
                let nodeFieldWideSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                        slotNames,
                                                                        nodeFieldValueSlot,
                                                                        stmt.rhsNodeIndex,
                                                                        3)
                if nodeFieldWideSlot >= 0:
                    nodeFieldValueSlot = nodeFieldWideSlot
                    nodeFieldValueKind = coreir.LocalI64Tag
            var nodeFieldKindOk = false
            if storeSizeBytes <= 4 && nodeFieldValueKind == coreir.LocalI32Tag:
                nodeFieldKindOk = true
            elif storeSizeBytes == 8 &&
                 (nodeFieldValueKind == coreir.LocalI64Tag ||
                  nodeFieldValueKind == coreir.LocalPtrTag):
                nodeFieldKindOk = true
            elif storeSizeBytes == 24 && nodeFieldValueKind == coreir.LocalStrTag:
                nodeFieldKindOk = true
            elif nodeFieldValueKind == coreir.LocalAggregateTag && storeSizeBytes > 0:
                # 聚合值（seq 头/结构体）按宽拷贝：FieldStore 任意字节宽
                nodeFieldKindOk = true
            if nodeFieldKindOk &&
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[nodeFieldValueSlot]) >= storeSizeBytes:
                # FieldStore 值源读栈上槽：param 槽（保存区/地址语义）先物化本地副本
                if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeFieldValueSlot]):
                    var nodeFieldTmpSlot: int32 = -1
                    if nodeFieldValueKind == coreir.LocalAggregateTag:
                        nodeFieldTmpSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                              slotNames,
                                                                              Fmt"#nff{stmt.rhsNodeIndex}#{bodyIR.ops.len}",
                                                                              coreir.LocalAggregateTag,
                                                                              storeSizeBytes,
                                                                              8)
                    else:
                        nodeFieldTmpSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#nff{stmt.rhsNodeIndex}#{bodyIR.ops.len}",
                                                                         nodeFieldValueKind)
                    if nodeFieldTmpSlot >= 0:
                        if nodeFieldValueKind == coreir.LocalStrTag ||
                           nodeFieldValueKind == coreir.LocalAggregateTag:
                            var nodeFieldMatSize = storeSizeBytes
                            if nodeFieldValueKind == coreir.LocalStrTag:
                                nodeFieldMatSize = 24
                            var nodeFieldStrMatOp: coreir.BodyOp
                            nodeFieldStrMatOp.kind = coreir.BodyOpFieldLoadTag
                            nodeFieldStrMatOp.target = nodeFieldTmpSlot
                            add(nodeFieldStrMatOp.operands, nodeFieldValueSlot)
                            add(nodeFieldStrMatOp.operands, nodeFieldTmpSlot)
                            add(nodeFieldStrMatOp.operands, 0)
                            add(nodeFieldStrMatOp.operands, nodeFieldMatSize)
                            let _ = coreir.BodyIRAppendOp(bodyIR, nodeFieldStrMatOp)
                        else:
                            var nodeFieldCopyOp: coreir.BodyOp
                            nodeFieldCopyOp.kind = coreir.BodyOpCopyLocalTag
                            nodeFieldCopyOp.target = nodeFieldTmpSlot
                            add(nodeFieldCopyOp.operands, nodeFieldValueSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, nodeFieldCopyOp)
                        nodeFieldValueSlot = nodeFieldTmpSlot
                        valueSlot = nodeFieldValueSlot
                else:
                    valueSlot = nodeFieldValueSlot
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            if valueSlot >= 0:
                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
            else:
                var nodeFieldMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                if nodeFieldMissOpText == "":
                    nodeFieldMissOpText = "store_field_shape"
                var nodeFieldTraceKind: int32 = -1
                if nodeFieldValueSlot >= 0:
                    nodeFieldTraceKind = PrimaryBodyIrSlotType(bodyIR, nodeFieldValueSlot)
                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={nodeFieldMissOpText} function={typedFn.functionName} line={stmt.lineNumber} detail=s{storeSizeBytes}_v{nodeFieldTraceKind}")
    if valueSlot < 0:
        valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
    if valueSlot < 0 && (rhsText == "[]" || rhsText == "{}"):
        valueSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                       slotNames,
                                                       Fmt"{stmt.assignFieldName}_zero",
                                                       coreir.LocalAggregateTag,
                                                       storeSizeBytes,
                                                       8)
    if valueSlot < 0 && PrimaryBodyIrTextIsStringLiteral(rhsText):
        valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"{stmt.assignFieldName}#str_value#{stmt.lineNumber}",
                                                  coreir.LocalStrTag)
        if valueSlot < 0 ||
           !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                  slotNames,
                                                  rhsText,
                                                  valueSlot,
                                                  callOrdinal):
            return false
    if valueSlot < 0:
        valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        lowering.typedIr,
                                                        stmt.sourcePath,
                                                        rhsText,
                                                        storeValueKind, callOrdinal)
    if valueSlot < 0:
        valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               stmt.sourcePath,
                                                               stmt.lineNumber,
                                                               rhsText,
                                                               storeValueKind)
    if valueSlot < 0 &&
       PrimaryBodyIrTextHasFieldOrIndex(rhsText) &&
       texpr.TypedExprTextIsSimpleFieldPath(rhsText):
        # 字段路径值（str/聚合元素店源）：按元数据 FieldLoad 物化值槽
        var fieldValueFail0: int32
        var fieldValueFail1: int32
        valueSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                         slotNames,
                                                         lowering.typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         stmt.lineNumber,
                                                         rhsText,
                                                         fieldValueFail0,
                                                         fieldValueFail1)
    if valueSlot < 0:
        # Last resort only for names with an existing slot: a fresh slot
        # here would feed the field store uninitialized bytes.
        valueSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, rhsText)
    if valueSlot < 0 || PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < storeSizeBytes:
        return false
    if faisIsShape:
        if !PrimaryBodyIrAppendFieldArrayIndexedSubFieldStore(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering.typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              stmt.sourcePath,
                                                              stmt.lineNumber,
                                                              stmt.assignRootName,
                                                              rootType,
                                                              stmt.assignFieldName,
                                                              valueSlot,
                                                              callOrdinal):
            # Indexed struct-field element store but not a clean fixed-array
            # element store: refuse rather than silently dropping the index.
            return false
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_struct_array_done function={typedFn.functionName} line={stmt.lineNumber} field={stmt.assignFieldName} idx={faisIndexText}")
        return true
    if fieldIndexText != "":
        # 动态 seq 元素店：buf@offset+8 间接 + madd 元素地址 + 元素宽 FieldStore
        var fieldIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               stmt.sourcePath,
                                                               fieldIndexText,
                                                               coreir.LocalI32Tag, callOrdinal)
        if fieldIdxSlot < 0:
            # 字段路径下标（fnIr.paramNames[node.paramSlot]）走上下文解析
            fieldIdxSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering.typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.sourcePath,
                                                                      stmt.lineNumber,
                                                                      fieldIndexText,
                                                                      coreir.LocalI32Tag)
        if fieldIdxSlot < 0 && PrimaryBodyIrTextHasFieldOrIndex(fieldIndexText):
            fieldIdxSlot = PrimaryBodyIrIndexedMemberValueSlot(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               stmt.sourcePath,
                                                               stmt.lineNumber,
                                                               fieldIndexText,
                                                               callOrdinal)
        if fieldIdxSlot < 0:
            return false
        let fieldBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#buf",
                                                         coreir.LocalPtrTag)
        let fieldEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#esz",
                                                           coreir.LocalI64Tag,
                                                           storeSizeBytes)
        let fieldAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#addr",
                                                          coreir.LocalPtrTag)
        if fieldBufSlot < 0 || fieldEszSlot < 0 || fieldAddrSlot < 0:
            return false
        var fieldBufLoadOp: coreir.BodyOp
        fieldBufLoadOp.kind = coreir.BodyOpFieldLoadTag
        fieldBufLoadOp.target = fieldBufSlot
        add(fieldBufLoadOp.operands, baseSlot)
        add(fieldBufLoadOp.operands, fieldBufSlot)
        add(fieldBufLoadOp.operands, fieldOffsetBytes + 8)
        add(fieldBufLoadOp.operands, 8)
        let _ = coreir.BodyIRAppendOp(bodyIR, fieldBufLoadOp)
        var fieldAddrOp: coreir.BodyOp
        fieldAddrOp.kind = coreir.BodyOpBinOpTag
        fieldAddrOp.target = fieldAddrSlot
        add(fieldAddrOp.operands, coreir.LocalI64Tag)
        add(fieldAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
        add(fieldAddrOp.operands, fieldIdxSlot)
        add(fieldAddrOp.operands, fieldEszSlot)
        add(fieldAddrOp.operands, fieldBufSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, fieldAddrOp)
        var fieldElemStoreOp: coreir.BodyOp
        fieldElemStoreOp.kind = coreir.BodyOpFieldStoreTag
        fieldElemStoreOp.target = fieldAddrSlot
        add(fieldElemStoreOp.operands, fieldAddrSlot)
        add(fieldElemStoreOp.operands, valueSlot)
        add(fieldElemStoreOp.operands, 0)
        add(fieldElemStoreOp.operands, storeSizeBytes)
        let _ = coreir.BodyIRAppendOp(bodyIR, fieldElemStoreOp)
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot}")
        return true
    # Indexed-root field LHS (`xs[i].field`): the structured root name dropped
    # the `[i]`, so a plain base+offset FieldStore would write element 0. Recover
    # the index from bindingName and store at the real element address.
    var rootIndexText = ""
    if PrimaryBodyIrAssignLhsRootIndexText(stmt.bindingName, stmt.assignRootName, rootIndexText):
        if PrimaryBodyIrAppendFixedArrayIndexedFieldStore(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          rootType,
                                                          rootIndexText,
                                                          baseSlot,
                                                          valueSlot,
                                                          fieldOffsetBytes,
                                                          fieldSizeBytes,
                                                          varI32ParamNames,
                                                          callOrdinal):
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_indexed_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot} idx={rootIndexText}")
            return true
        # Dynamic seq of structs (`xs[i].field` where `xs: Elem[]`): element
        # storage is behind the seq header data pointer; the fixed-array path
        # above refuses it. Store at `*(base+8) + idx*elemSize + fieldOffset`.
        if PrimaryBodyIrAppendDynamicSeqIndexedFieldStore(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          rootType,
                                                          rootIndexText,
                                                          baseSlot,
                                                          valueSlot,
                                                          fieldOffsetBytes,
                                                          fieldSizeBytes,
                                                          varI32ParamNames,
                                                          callOrdinal):
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_seq_indexed_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot} idx={rootIndexText}")
            return true
        # Indexed root but not a clean element store: refuse rather than
        # silently dropping the index into a base+offset store.
        return false
    # [wall148] 借用视图/引用中跳 store 臂：仅接管 var 形参 ref 根与含 ref
    # 中跳的点路径；其余形态返回 false，原样走下方既有 FieldStore（零漂移）。
    if PrimaryBodyIrAppendBorrowViewFieldStore(bodyIR,
                                                slotNames,
                                                lowering.typedIr,
                                                stmt.sourcePath,
                                                rootType,
                                                baseSlot,
                                                stmt.assignFieldName,
                                                valueSlot):
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot} borrow_view=1")
        return true
    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = baseSlot
    add(storeOp.operands, baseSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, fieldOffsetBytes)
    add(storeOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    B2PrimaryObjectPlanGuardTick()
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_field_fast_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot}")
    return true

# Global array element-address: returns a LocalPtr slot holding the byte
# address of `g[idxText]` for a bare global array `g`. For a fixed array
# (`Elem[N]`) the base is &g; for a dynamic seq (`Elem[]`/`seq[Elem]`) the base
# is the seq data pointer at *(&g + 8). In both cases the element address is
# base + idx*elemSize. Sets elemKindOut/elemSizeOut from the element type;
# returns -1 (size 0) for dotted roots, non-globals, or non-scalar element
# widths. Both the indexed store and read build on this so one scaled-address
# protocol drives writes and reads.
@borrows
fn PrimaryBodyIrAppendGlobalU8ArrayStore(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          lhsName: str,
                                          rhsText: str,
                                          callOrdinal: var int32): bool =
    # Global array indexed store: g[idx] = v (fixed `Elem[N]` or dynamic
    # `Elem[]` seq). Handles any scalar element width — the element address is
    # base + idx*elemSize (base = &g for fixed, *(&g+8) for seq), and the store
    # width is picked from the element slot type (i32 -> 4-byte, i64 -> 8-byte
    # store). uint8 keeps its byte path (elemSize 1, explicit U8 store tag).
    var gArrRoot = ""
    var gArrIdxText = ""
    if !PrimaryBodyIrIndexExprParts(lhsName, gArrRoot, gArrIdxText):
        return false
    var gArrElemKind: int32
    var gArrElemSize: int32
    let gArrElemAddrSlot = PrimaryBodyIrGlobalFixedArrayElemAddrSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     typedIr,
                                                                     sourcePath,
                                                                     gArrRoot,
                                                                     gArrIdxText,
                                                                     gArrElemKind,
                                                                     gArrElemSize,
                                                                     callOrdinal,
                                                                     false)
    if gArrElemAddrSlot < 0:
        return false
    var gArrValueText = strings.CloneStr(rhsText)
    # element value slot width follows the element type: byte path strips the
    # uint8(...) cast and stores via an i32 slot; wider elements materialize an
    # i32 (4-byte) or i64 (8-byte) slot so the IndexedStore picks the right
    # store width from the value slot type.
    var gArrValueKind = coreir.LocalI32Tag
    if gArrElemSize == 1:
        let gArrU8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
        if gArrU8Inner != "":
            gArrValueText = strutil.Strip(gArrU8Inner)
    elif gArrElemSize == 8:
        gArrValueKind = coreir.LocalI64Tag
    let gArrValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            sourcePath,
                                                            gArrValueText,
                                                            gArrValueKind, callOrdinal)
    if gArrValueSlot < 0:
        return false
    var gArrStoreOp: coreir.BodyOp
    gArrStoreOp.kind = coreir.BodyOpIndexedStoreTag
    gArrStoreOp.target = gArrElemAddrSlot
    add(gArrStoreOp.operands, gArrElemAddrSlot)
    add(gArrStoreOp.operands, gArrValueSlot)
    # elemSize 1: explicit byte store tag; wider elements drop the tag so the
    # IndexedStore picks its store width from the value slot type.
    if gArrElemSize == 1:
        add(gArrStoreOp.operands, coreir.BodyStoreLocalPtrDerefU8Tag)
    let _ = coreir.BodyIRAppendOp(bodyIR, gArrStoreOp)
    return true

# 全局定长数组元素**整槽 struct** 存储 `gArr[idx] = slot`(slot 为本地 struct 变量)。
# AppendGlobalU8ArrayStore 只处理标量元素(1/4/8 字节);struct 元素(>8 字节,如
# MsQuicNativeAppStreamSlot)的整槽存储走这里:GlobalFixedArrayElemAddrSlot 算元素地址
# (base + idx*elemSize 的 adrp+add+madd),AppendVarAggregateStore 发 FieldStore 聚合拷贝
# (byteCount=elemSize) 从本地 struct 槽到该地址。仅当 RHS 是已命名的本地 struct 变量
# (FindArgSlot)且槽宽≥elemSize 时放行;构造器/字段读 RHS 维持 bail_0(不冒险物化)。
@borrows
fn PrimaryBodyIrAppendGlobalFixedArrayElemStructStore(bodyIR: var coreir.BodyIR,
                                                      slotNames: var str[],
                                                      varI32ParamNames: str[],
                                                      typedIr: texpr.TypedExprIr,
                                                      sourcePath: str,
                                                      lhsName: str,
                                                      rhsText: str,
                                                      callOrdinal: var int32): bool =
    var gStructRoot = ""
    var gStructIdxText = ""
    if !PrimaryBodyIrIndexExprParts(lhsName, gStructRoot, gStructIdxText):
        return false
    var gStructElemKind: int32
    var gStructElemSize: int32
    let gStructElemAddrSlot = PrimaryBodyIrGlobalFixedArrayElemAddrSlot(bodyIR,
                                                                        slotNames,
                                                                        varI32ParamNames,
                                                                        typedIr,
                                                                        sourcePath,
                                                                        gStructRoot,
                                                                        gStructIdxText,
                                                                        gStructElemKind,
                                                                        gStructElemSize,
                                                                        callOrdinal,
                                                                        true)
    # elemSize<=8 是标量,归 AppendGlobalU8ArrayStore;这里只接聚合(>8)。
    if gStructElemAddrSlot < 0 || gStructElemSize <= 8:
        return false
    let gStructValueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
    if gStructValueSlot < 0 || gStructValueSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[gStructValueSlot]) < gStructElemSize:
        return false
    PrimaryBodyIrAppendVarAggregateStore(bodyIR, gStructElemAddrSlot, gStructValueSlot, gStructElemSize)
    return true

# Non-emitting probe: element kind/size for a bare global scalar array `g[...]`
# (fixed `Elem[N]` or dynamic seq `Elem[]`). Returns false (size 0) for dotted
# roots, non-globals, or element widths the IndexedLoad/Store op cannot
# materialize directly.
@borrows
fn PrimaryBodyIrAppendResultConstructFromArgLinks(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   varI32ParamNames: str[],
                                                   lowering: lower.LoweringPlanStub,
                                                   typedFn: texpr.TypedExprIrFunction,
                                                   irFunction: var lower.PrimaryObjectIrFunction,
                                                   sourcePath: str,
                                                   lineNumber: int32,
                                                   resultHead: str,
                                                   targetSlot: int32,
                                                   isErr: bool,
                                                   innerTypeRaw: str,
                                                   argLinkStart: int32,
                                                   argCount: int32,
                                                   callOrdinal: var int32): bool =
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalAggregateTag:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let innerType = strutil.Strip(innerTypeRaw)
    if innerType == "":
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var valueKind: int32
    var valueSize: int32
    var valueOffset: int32
    var errCodeOffset: int32
    var errMsgOffset: int32
    var totalSize: int32
    if !PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                           sourcePath,
                                           innerType,
                                           valueKind,
                                           valueSize,
                                           valueOffset,
                                           errCodeOffset,
                                           errMsgOffset,
                                           totalSize):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=stmt_arg reason=layout function={typedFn.functionName} line={lineNumber} call_head={resultHead} inner={innerType}")
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < totalSize:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=stmt_arg reason=target_size function={typedFn.functionName} line={lineNumber} target_size={PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot])} need={totalSize}")
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var payloadArgNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(lowering.typedIr,
                                              argLinkStart,
                                              payloadArgNodes):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if payloadArgNodes.len != argCount:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if payloadArgNodes.len != 1:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let payloadNodeIndex = payloadArgNodes[0]
    # bail=801 P2 亚族: payload 是跨模块限定 str 常量 (Ok[str](yamuxmod.YamuxCodec))。
    # 节点探针对该形态无形状 (payload_kind=-1) → 恒 miss。仅当期望形状为 str
    # (Err payload 或 valueKind==str) 且 payload 字面文本经目标模块 const 块解析
    # 为纯字符串字面量时, 以字面量物化器建 str 槽绕过探针+求值; 解析不出走原
    # 路径 (poison 不变, 形态严等不重叠)。
    var payloadConstStrSlot: int32 = -1
    var payloadExpectsStr = isErr
    if !payloadExpectsStr && valueKind == coreir.LocalStrTag:
        payloadExpectsStr = true
    if payloadExpectsStr &&
       payloadNodeIndex >= 0 &&
       payloadNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
        # FieldGet 节点 literalText 只存字段叶名, 全限定路径在 surfaceText
        # (yamuxmod.YamuxCodec); surface 优先, 空则回落 literalText。
        var payloadConstText = ""
        let payloadSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[payloadNodeIndex])
        if IsOk(payloadSurfRes):
            payloadConstText = strutil.Strip(Value(payloadSurfRes))
        if payloadConstText == "":
            let payloadLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[payloadNodeIndex])
            if IsOk(payloadLitRes):
                payloadConstText = strutil.Strip(Value(payloadLitRes))
        if payloadConstText != "":
            let payloadConstLit = PrimaryBodyIrCanonicalQualifiedConstStrLiteral(lowering.typedIr,
                                                                                    sourcePath,
                                                                                    payloadConstText)
            if payloadConstLit != "":
                let payloadConstSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                     slotNames,
                                                                     Fmt"#rc_const_str#{lineNumber}#{bodyIR.ops.len}",
                                                                     coreir.LocalStrTag)
                if payloadConstSlot >= 0 &&
                   PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                         slotNames,
                                                         payloadConstLit,
                                                         payloadConstSlot,
                                                         callOrdinal):
                    payloadConstStrSlot = payloadConstSlot
    # bail=801 P1 亚族: Ok payload 是 inner 型值构造器字面量
    # (Ok[T](T(field: v, ...)), HostDialTextOwned/quicPacketHeaderDecode 根)。
    # 节点探针对构造器整调用无形状 → 恒 miss。复用值聚合构造核心
    # AggregateConstructorToSlot: 头名=聚合类型/非可见函数/形状严等/字段全套门
    # 内置, 任一不过整体让位; 过门即物化进 inner 定形临时槽作 payload。
    if payloadConstStrSlot < 0 &&
       !isErr &&
       valueKind == coreir.LocalAggregateTag &&
       payloadNodeIndex >= 0 &&
       payloadNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
        let payloadCtorLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[payloadNodeIndex])
        if IsOk(payloadCtorLitRes) &&
           strutil.Strip(Value(payloadCtorLitRes)) != "":
            let payloadCtorSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                     slotNames,
                                                                     lowering.typedIr,
                                                                     sourcePath,
                                                                     Fmt"#rc_ctor_payload#{lineNumber}#{bodyIR.ops.len}",
                                                                     innerType)
            if payloadCtorSlot >= 0 &&
               PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             lowering,
                                                             typedFn,
                                                             irFunction,
                                                             Value(payloadCtorLitRes),
                                                             payloadNodeIndex,
                                                             innerType,
                                                             sourcePath,
                                                             lineNumber,
                                                             payloadCtorSlot,
                                                             lineNumber * 31 + payloadNodeIndex,
                                                             callOrdinal):
                payloadConstStrSlot = payloadCtorSlot
    if payloadConstStrSlot < 0:
        if isErr:
            let errProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering.typedIr,
                                                          typedFn,
                                                          irFunction,
                                                          payloadNodeIndex)
            if errProbeKind != coreir.LocalStrTag:
                let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
                return false
        else:
            let okProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering.typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         payloadNodeIndex)
            if okProbeKind != valueKind:
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=stmt_arg reason=payload_kind function={typedFn.functionName} line={lineNumber} payload_kind={okProbeKind} value_kind={valueKind}")
                let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
                return false
    var payloadSlot = payloadConstStrSlot
    if payloadSlot < 0:
        payloadSlot = PrimaryBodyIrEvalNode(bodyIR,
                                            slotNames,
                                            varI32ParamNames,
                                            lowering,
                                            typedFn,
                                            irFunction,
                                            payloadNodeIndex,
                                            callOrdinal)
    if payloadSlot < 0 || payloadSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var payloadByteCount = valueSize
    var payloadWriteOffset = valueOffset
    if isErr:
        payloadByteCount = 24
        payloadWriteOffset = errMsgOffset
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[payloadSlot]) < payloadByteCount:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if !PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, targetSlot, callOrdinal):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var okFlagValue = 1
    if isErr:
        okFlagValue = 0
    let okFlagSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#rc{lineNumber}#{bodyIR.ops.len}#ok",
                                                     coreir.LocalI32Tag,
                                                     okFlagValue)
    if okFlagSlot < 0:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var okStoreOp: coreir.BodyOp
    okStoreOp.kind = coreir.BodyOpFieldStoreTag
    okStoreOp.target = targetSlot
    add(okStoreOp.operands, targetSlot)
    add(okStoreOp.operands, okFlagSlot)
    add(okStoreOp.operands, coreir.ResultStrOkOffset)
    add(okStoreOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, okStoreOp)
    if isErr:
        let errCodeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#rc{lineNumber}#{bodyIR.ops.len}#code",
                                                          coreir.LocalI32Tag,
                                                          1)
        if errCodeSlot < 0:
            let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
            return false
        var errCodeStoreOp: coreir.BodyOp
        errCodeStoreOp.kind = coreir.BodyOpFieldStoreTag
        errCodeStoreOp.target = targetSlot
        add(errCodeStoreOp.operands, targetSlot)
        add(errCodeStoreOp.operands, errCodeSlot)
        add(errCodeStoreOp.operands, errCodeOffset)
        add(errCodeStoreOp.operands, 4)
        let _ = coreir.BodyIRAppendOp(bodyIR, errCodeStoreOp)
    var payloadStoreOp: coreir.BodyOp
    payloadStoreOp.kind = coreir.BodyOpFieldStoreTag
    payloadStoreOp.target = targetSlot
    add(payloadStoreOp.operands, targetSlot)
    add(payloadStoreOp.operands, payloadSlot)
    add(payloadStoreOp.operands, payloadWriteOffset)
    add(payloadStoreOp.operands, payloadByteCount)
    let _ = coreir.BodyIRAppendOp(bodyIR, payloadStoreOp)
    return true

@borrows
fn PrimaryBodyIrAppendReturnResultConstructFromSameLine(bodyIR: var coreir.BodyIR,
                                                         slotNames: var str[],
                                                         varI32ParamNames: str[],
                                                         lowering: lower.LoweringPlanStub,
                                                         typedFn: texpr.TypedExprIrFunction,
                                                         irFunction: var lower.PrimaryObjectIrFunction,
                                                         stmtIndex: int32,
                                                         sameLineOrder: int32[],
                                                         sameLineLo: int32[],
                                                         sameLineHi: int32[],
                                                         currentBlockStart: var int32,
                                                         callOrdinal: var int32): bool =
    if stmtIndex < 0 || stmtIndex >= irFunction.statements.len:
        return false
    let stmt = irFunction.statements[stmtIndex]
    for scanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
        let scanIndex = sameLineOrder[scanP]
        if scanIndex < 0 || scanIndex >= irFunction.statements.len:
            continue
        let rcStmt = irFunction.statements[scanIndex]
        if rcStmt.kind != texpr.TypedExprIrStmtResultIntrinsic ||
           !rcStmt.returnRoot:
            continue
        var rcHead = strutil.Strip(rcStmt.callCallee)
        if rcHead == "":
            rcHead = strutil.Strip(rcStmt.surfaceText)
        if rcHead != "Ok" && rcHead != "Err":
            continue
        var rcResultType = rcStmt.resultType
        if rcResultType == "":
            rcResultType = stmt.resultType
        if rcResultType == "":
            rcResultType = typedFn.returnType
        let rcInnerType = texpr.TypedExprResultSuccessType(rcResultType)
        if rcInnerType == "":
            continue
        var rcReturnKind: int32
        var rcReturnSize: int32
        var rcReturnAlign: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       rcStmt.sourcePath,
                                       rcResultType,
                                       rcReturnKind,
                                       rcReturnSize,
                                       rcReturnAlign)
        if rcReturnKind != coreir.LocalAggregateTag:
            continue
        let rcSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        rcStmt.sourcePath,
                                                        Fmt"#return_result_construct#{stmt.lineNumber}",
                                                        rcResultType)
        if rcSlot < 0:
            continue
        let rcEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
        let rcIsErr = rcHead == "Err"
        if PrimaryBodyIrAppendResultConstructFromArgLinks(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,
                                                          typedFn,
                                                          irFunction,
                                                          rcStmt.sourcePath,
                                                          stmt.lineNumber,
                                                          rcHead,
                                                          rcSlot,
                                                          rcIsErr,
                                                          rcInnerType,
                                                          rcStmt.callArgNodeStart,
                                                          rcStmt.callArgCount,
                                                          callOrdinal):
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          rcSlot,
                                          rcReturnKind,
                                          0,
                                          false)
            return true
        if PrimaryBodyIrNodeEvalCallEmitCountNow() != rcEmitMark:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         6101,
                                         0)
            return true
    return false

# ErrCode[T](code,msg) 构造发射：双参 Err 变体。ok=0，err.code=code(int32@
# errCodeOffset)，err.msg=msg(str 24B@errMsgOffset)，value 不写（零初始化）。
# 所有可失败判定（参数数、形状探针、payload 求值、槽宽）在零初始化前完成，
# 零初始化后必发射成功（已发 setMem/store 不可回落，let-it-crash）。
@borrows
fn PrimaryBodyIrSeqAddNodeProbe(typedIr: texpr.TypedExprIr,
                                 nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_add_node")
        return false
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_add_node")
        return false
    let sanLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(sanLitRes) || Value(sanLitRes) != "add":
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_add_node")
        return false
    var seqAddArgNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
        typedIr,
        arenamod.ArenaArrayInt32Get(typedIr.arena,
                                     typedIr.nodes2_operand0NodeIndexs,
                                     nodeIndex),
        seqAddArgNodes) ||
       seqAddArgNodes.len != 2:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_add_node")
        return false
    return true

# Node-eval ownership gate for setLen(seq, n): mirrors the add probe — confirms
# the rhs node is a 2-arg setLen call so node-eval can claim the statement.
@borrows
fn PrimaryBodyIrSeqSetLenNodeProbe(typedIr: texpr.TypedExprIr,
                                    nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_setlen_node")
        return false
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_setlen_node")
        return false
    let sslLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(sslLitRes) || Value(sslLitRes) != "setLen":
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_setlen_node")
        return false
    var seqSetLenArgNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
        typedIr,
        arenamod.ArenaArrayInt32Get(typedIr.arena,
                                     typedIr.nodes2_operand0NodeIndexs,
                                     nodeIndex),
        seqSetLenArgNodes) ||
       seqSetLenArgNodes.len != 2:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_setlen_node")
        return false
    return true

@borrows
fn PrimaryBodyIrSeqReserveNodeProbe(typedIr: texpr.TypedExprIr,
                                     nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_reserve_node")
        return false
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_reserve_node")
        return false
    let srvLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(srvLitRes) || Value(srvLitRes) != "reserve":
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_reserve_node")
        return false
    var seqReserveArgNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
        typedIr,
        arenamod.ArenaArrayInt32Get(typedIr.arena,
                                     typedIr.nodes2_operand0NodeIndexs,
                                     nodeIndex),
        seqReserveArgNodes) ||
       seqReserveArgNodes.len != 2:
        let _ = PrimaryBodyIrNodeEvalMissAt("seq_reserve_node")
        return false
    return true

@borrows
fn PrimaryBodyIrBareCallNodeEvalProbe(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       varI32ParamNames: str[],
                                       lowering: lower.LoweringPlanStub,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: var lower.PrimaryObjectIrFunction,
                                       nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("bad_node_index")
        return false
    if lowering.typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        let _ = PrimaryBodyIrNodeEvalMissAt("call_node_shape")
        return false
    let probeCallHeadRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(probeCallHeadRes):
        return false
    let probeCallHead = Value(probeCallHeadRes)
    if probeCallHead == "" ||
       probeCallHead == "StrDataPtr" ||
       probeCallHead == "IsErr" ||
       probeCallHead == "result.IsErr" ||
       probeCallHead == "IsOk" ||
       probeCallHead == "result.IsOk" ||
       probeCallHead == "int" ||
       probeCallHead == "Int":
        let _ = PrimaryBodyIrNodeEvalMissAt("call_special_head")
        return false
    var probeArgNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
        lowering.typedIr,
        arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                     lowering.typedIr.nodes2_operand0NodeIndexs,
                                     nodeIndex),
        probeArgNodes):
        let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_chain")
        return false
    var probeTargetSourcePath = ""
    var probeTargetName = ""
    var probeTargetSignatureLine: int32
    var probeTargetImportc: bool
    var probeResultType = ""
    if !PrimaryBodyIrExactCallNodeAuthority(lowering.typedIr,
                                            nodeIndex,
                                            probeTargetSourcePath,
                                            probeTargetName,
                                            probeTargetSignatureLine,
                                            probeTargetImportc,
                                            probeResultType):
        let _ = PrimaryBodyIrNodeEvalMissAt("call_authority")
        return false
    let probeOrdinal = PrimaryBodyIrExactCallNodeOrdinal(irFunction,
                                                          lowering.typedIr,
                                                          nodeIndex,
                                                          probeArgNodes.len)
    if probeOrdinal < 0 ||
       probeOrdinal >= irFunction.callTargets.len ||
       probeOrdinal >= irFunction.callTargetSourcePaths.len ||
       probeOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
       probeOrdinal >= irFunction.callTargetImportcFlags.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("call_ordinal")
        return false
    if probeResultType != "void":
        var probeRetSourcePath = irFunction.callTargetSourcePaths[probeOrdinal]
        if probeRetSourcePath == "":
            probeRetSourcePath = typedFn.sourcePath
        var probeRetKind: int32
        var probeRetSize: int32
        var probeRetAlign: int32
        PrimaryBodyIrNodeTypeShape(lowering.typedIr,
                                   probeRetSourcePath,
                                   probeResultType,
                                   probeRetKind,
                                   probeRetSize,
                                   probeRetAlign)
        # sret 形（str/聚合）丢弃返回：发射器物化一次性 sret 缓冲承接，
        # 仅要求 size 有效（与 AppendCallExprNodeToSlot discard 路径镜像）。
        if probeRetKind == coreir.LocalStrTag ||
           probeRetKind == coreir.LocalAggregateTag:
            if probeRetSize <= 0:
                let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
                return false
        elif probeRetKind != coreir.LocalI32Tag &&
             probeRetKind != coreir.LocalI64Tag &&
             probeRetKind != coreir.LocalPtrTag:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
            return false
    var probeStmt: lower.PrimaryObjectIrStatement
    probeStmt.sourcePath = typedFn.sourcePath
    probeStmt.callTarget = irFunction.callTargets[probeOrdinal]
    probeStmt.callTargetSourcePath = irFunction.callTargetSourcePaths[probeOrdinal]
    probeStmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[probeOrdinal]
    probeStmt.callTargetImportc = irFunction.callTargetImportcFlags[probeOrdinal]
    for probeArgIndex in 0..<probeArgNodes.len:
        let probeArgNodeIndex = probeArgNodes[probeArgIndex]
        if probeArgNodeIndex < 0 || probeArgNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_chain")
            return false
        let probeArgParamNameRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_paramNameIds[probeArgNodeIndex])
        let probeArgSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[probeArgNodeIndex])
        let probeArgSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[probeArgNodeIndex])
        if !IsOk(probeArgParamNameRes) || !IsOk(probeArgSurfRes) || !IsOk(probeArgSrcRes):
            return false
        let probeArgParamName = Value(probeArgParamNameRes)
        let probeArgSurfaceText = Value(probeArgSurfRes)
        let probeArgSourcePath = Value(probeArgSrcRes)
        let probeParamType = PrimaryBodyIrTargetParamType(lowering, probeStmt, probeArgIndex)
        let probeNeedsAddress = PrimaryBodyIrTypeTextIsVarParam(probeParamType)
        if lowering.typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpParamRef ||
           lowering.typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpLocalRef:
            var probeArgName = probeArgParamName
            if probeArgName == "":
                probeArgName = strutil.Strip(probeArgSurfaceText)
            if probeArgName == "":
                let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_name")
                return false
            if PrimaryBodyIrFindArgSlot(bodyIR, slotNames, probeArgName) < 0 &&
               !PrimaryBodyIrNameInList(varI32ParamNames, probeArgName):
                var probeGlobalArgOk = false
                if lowering.typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpLocalRef && !probeNeedsAddress:
                    let probeGlobalArgType = PrimaryBodyIrTypedGlobalTypeExact(lowering.typedIr,
                                                                               probeArgSourcePath,
                                                                               probeArgName)
                    if probeGlobalArgType != "":
                        var probeGlobalArgKind: int32
                        var probeGlobalArgSize: int32
                        var probeGlobalArgAlign: int32
                        PrimaryBodyIrNodeTypeShape(lowering.typedIr,
                                                   probeArgSourcePath,
                                                   probeGlobalArgType,
                                                   probeGlobalArgKind,
                                                   probeGlobalArgSize,
                                                   probeGlobalArgAlign)
                        if probeGlobalArgKind == coreir.LocalI32Tag ||
                           probeGlobalArgKind == coreir.LocalI64Tag ||
                           probeGlobalArgKind == coreir.LocalPtrTag ||
                           probeGlobalArgKind == coreir.LocalStrTag ||
                           probeGlobalArgKind == coreir.LocalAggregateTag:
                            probeGlobalArgOk = true
                elif lowering.typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpLocalRef && probeNeedsAddress:
                    # `var` param fed a module-global aggregate (seq/struct):
                    # the emit path materializes the global's address into a Ptr
                    # slot (PrimaryBodyIrGlobalAggregateDestSlot, requires
                    # LocalAggregateTag). Mirror that feasibility here so the
                    # bare call isn't rejected before emit runs.
                    let probeGlobalAddrType = PrimaryBodyIrTypedGlobalTypeExact(lowering.typedIr,
                                                                                probeArgSourcePath,
                                                                                probeArgName)
                    if probeGlobalAddrType != "":
                        var probeGlobalAddrKind: int32
                        var probeGlobalAddrSize: int32
                        var probeGlobalAddrAlign: int32
                        PrimaryBodyIrNodeTypeShape(lowering.typedIr,
                                                   probeArgSourcePath,
                                                   probeGlobalAddrType,
                                                   probeGlobalAddrKind,
                                                   probeGlobalAddrSize,
                                                   probeGlobalAddrAlign)
                        if probeGlobalAddrKind == coreir.LocalAggregateTag:
                            probeGlobalArgOk = true
                if !probeGlobalArgOk:
                    let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_slot")
                    return false
        elif lowering.typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpStrLit ||
             lowering.typedIr.nodes2_opKinds[probeArgNodeIndex] == texpr.TypedExprIrOpBoolLit:
            if probeNeedsAddress:
                let _ = PrimaryBodyIrNodeEvalMissAt("call_var_arg")
                return false
        elif probeNeedsAddress:
            var probeVarArgRootSlot: int32
            var probeVarArgTotalOffset: int32
            if !PrimaryBodyIrVarArgFieldPathInfo(bodyIR,
                                                 slotNames,
                                                 lowering.typedIr,
                                                 probeArgNodeIndex,
                                                 probeVarArgRootSlot,
                                                 probeVarArgTotalOffset):
                var probeVarIdxRootSlot: int32
                var probeVarIdxHeaderOffset: int32
                var probeVarIdxElemSize: int32
                var probeVarIdxNode: int32
                var probeVarIdxOk = false
                if PrimaryBodyIrVarArgIndexInfo(bodyIR,
                                                slotNames,
                                                lowering.typedIr,
                                                probeArgNodeIndex,
                                                probeVarIdxRootSlot,
                                                probeVarIdxHeaderOffset,
                                                probeVarIdxElemSize,
                                                probeVarIdxNode):
                    let _ = probeVarIdxHeaderOffset
                    probeVarIdxOk = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               probeVarIdxNode) == coreir.LocalI32Tag
                if !probeVarIdxOk:
                    var probeVifRootSlot: int32
                    var probeVifHeaderOffset: int32
                    var probeVifElemSize: int32
                    var probeVifIdxNode: int32
                    var probeVifFieldOffset: int32
                    if PrimaryBodyIrVarArgIndexedFieldInfo(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           probeArgNodeIndex,
                                                           probeVifRootSlot,
                                                           probeVifHeaderOffset,
                                                           probeVifElemSize,
                                                           probeVifIdxNode,
                                                           probeVifFieldOffset):
                        let _ = probeVifRootSlot
                        let _ = probeVifHeaderOffset
                        let _ = probeVifElemSize
                        let _ = probeVifFieldOffset
                        probeVarIdxOk = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering.typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   probeVifIdxNode) == coreir.LocalI32Tag
                if !probeVarIdxOk:
                    let _ = PrimaryBodyIrNodeEvalMissAt("call_var_arg")
                    return false
        else:
            let probeArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering.typedIr,
                                                          typedFn,
                                                          irFunction,
                                                          probeArgNodeIndex)
            if probeArgKind < 0:
                return false
    return true

@borrows
fn PrimaryBodyIrAppendI32Assign(bodyIR: var coreir.BodyIR,
                                 bindingProjection:
                                     var coreir.BodyIRLocalBindingValueDefinitionProjection,
                                 slotNames: var str[],
                                 varI32ParamNames: str[],
                                 lowering: lower.LoweringPlanStub,
                                 typedFn: texpr.TypedExprIrFunction,
                                 irFunction: var lower.PrimaryObjectIrFunction,
                                 stmt: lower.PrimaryObjectIrStatement,
                                 callOrdinal: var int32,
                                 currentBlockStart: var int32): bool =
    B2PrimaryObjectPlanGuardTick()
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_i32_enter function={typedFn.functionName} line={stmt.lineNumber} binding_len={stmt.bindingName.len} surface_len={stmt.surfaceText.len} field_len={stmt.assignFieldName.len} root_len={stmt.assignRootName.len}")
    let rhsText = strings.CloneStr(strutil.Strip(stmt.surfaceText))
    var lhsName = ""
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_A function={typedFn.functionName} line={stmt.lineNumber}")
    if stmt.assignFieldName != "" && stmt.assignRootName != "":
        lhsName = stmt.assignRootName
    else:
        lhsName = PrimaryBodyIrCanonicalAssignLhsName(stmt.bindingName)
    # Multi-dimensional fixed-array store `grid[i][j] = v`: row-major flatten the
    # LHS to a single-index text `grid[(i)*cols+(j)]` so the existing 1-D indexed
    # store path computes the correct element address. Without this the multi-
    # bracket index parsed as a single garbage index and the store missed the
    # intended cell.
    if stmt.assignFieldName == "":
        var assignMultiRoot = ""
        var assignMultiList: str[]
        assignMultiList = []
        if PrimaryBodyIrMultiIndexParts(lhsName, assignMultiRoot, assignMultiList) >= 2:
            var assignMultiType = strings.CloneStr(stmt.assignRootType)
            if texpr.TypedExprNormalizeTypeText(assignMultiType) == "" ||
               assignMultiRoot != stmt.assignRootName:
                assignMultiType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.lineNumber,
                                                                  assignMultiRoot)
            var assignFlatLhs = ""
            if assignMultiType != "" &&
               PrimaryBodyIrFlattenMultiIndexText(lowering.typedIr,
                                                  stmt.sourcePath,
                                                  texpr.TypedExprStripVarType(assignMultiType),
                                                  lhsName,
                                                  assignFlatLhs):
                lhsName = assignFlatLhs
    B2PrimaryObjectPlanGuardTick()
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_i32_lhs_done function={typedFn.functionName} line={stmt.lineNumber} lhs_len={lhsName.len} rhs_len={rhsText.len} field={stmt.assignFieldName}")
    var primaryColdCond12: bool
    if len(lhsName) <= 0:
        primaryColdCond12 = true
    if len(rhsText) <= 0:
        primaryColdCond12 = true
    if primaryColdCond12:
        return false
    # T78 v6 根修(pobj 同名镜像点, 见 primary_object_plan.cheng 同处注释): 纯量
    # 重赋值 `x = a && b`（x 已声明, 非 decl-init）若某臂含越界故障面(下标读),
    # 下面通用节点求值臂只按"含真调用"探路, 对无调用但含下标的复合形不设防,
    # 会直接调 EvalNode; EvalNode 自身门确会诚实 miss, 但落穿链最终对此形不
    # productive, 实测诚实 bail。显式在此优先走真短路 CBR 链; 门前不满足则原样
    # 落穿既有逻辑, 行为不退化; 一旦真调用发射器就不再回退, 原样透传其成败
    # (理由见下方内层注释)。剥括号后再探 &&/||(T78 current 教训同 pobj)。
    if stmt.assignFieldName == "" &&
       lhsName != "_" &&
       !stmt.assignRootGlobalFlag &&
       stmt.rhsNodeIndex >= 0:
        let assignBoolEarlyGateText = PrimaryBodyIrStripOuterParens(rhsText)
        if (PrimaryBodyIrConditionHasAnd(assignBoolEarlyGateText) ||
            PrimaryBodyIrConditionHasOr(assignBoolEarlyGateText)) &&
           PrimaryBodyIrNodeTreeHasFaultingEagerSurface(lowering.typedIr, stmt.rhsNodeIndex):
            let assignBoolEarlyLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
            if assignBoolEarlyLhsSlot >= 0 &&
               PrimaryBodyIrSlotType(bodyIR, assignBoolEarlyLhsSlot) == coreir.LocalI32Tag:
                # 一旦真开始调用 CBR 链发射器就不再回退(理由同 pobj 镜像点注释:
                # 半途失败会在同一 bodyIR 上留悬挂 block/潜在重复副作用), 原样
                # 透传结果, 与下面既有同款调用点行为一致。
                var assignBoolEarlyBlockStart = currentBlockStart
                let assignBoolEarlyAssigned = PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                                                     slotNames,
                                                                                     lowering,
                                                                                     typedFn,
                                                                                     irFunction,
                                                                                     stmt.sourcePath,
                                                                                     stmt.lineNumber,
                                                                                     stmt.rhsNodeIndex,
                                                                                     rhsText,
                                                                                     assignBoolEarlyLhsSlot,
                                                                                     callOrdinal,
                                                                                     assignBoolEarlyBlockStart)
                currentBlockStart = assignBoolEarlyBlockStart
                return assignBoolEarlyAssigned
    # 批次2c：rhs 已节点化时先走节点求值器（本地标量/str LHS）；批次3 扩展
    # var-i32/i64 形参 LHS（求值后经 var-store 回写指针目标）。求值失败或
    # LHS 形态不符落回文本路径（迁移窗口双轨）。
    if stmt.rhsNodeIndex >= 0 &&
       stmt.assignFieldName == "" &&
       lhsName != "_" &&
       (!stmt.assignRootGlobalFlag ||
        (len(lhsName) > 3 &&
         strings.SliceBytes(lhsName, len(lhsName) - 1, 1) == "]")) &&
       !PrimaryBodyIrHasSameLineLetCallBinding(irFunction.statements,
                                               stmt.lineNumber,
                                               lhsName):
        # 批次6b：same-line letcall 孪生行（绑定同名）拥有该语句的调用
        # 发射权——assign 行再走节点路径会双发调用；让位（letcall 行的
        # 节点拦截负责整树）。
        if len(lhsName) > 3 &&
           strings.SliceBytes(lhsName, len(lhsName) - 1, 1) == "]":
            var assignIdxOpen = -1
            var assignIdxLevel = 0
            var assignIdxScan = len(lhsName) - 2
            while assignIdxScan >= 0:
                if PrimaryBodyIrTextByteCodeEquals(lhsName, assignIdxScan, 93):
                    assignIdxLevel = assignIdxLevel + 1
                elif PrimaryBodyIrTextByteCodeEquals(lhsName, assignIdxScan, 91):
                    if assignIdxLevel == 0:
                        assignIdxOpen = assignIdxScan
                        break
                    assignIdxLevel = assignIdxLevel - 1
                assignIdxScan = assignIdxScan - 1
            var assignIdxBaseText = ""
            var assignIdxText = ""
            if assignIdxOpen > 0:
                assignIdxBaseText = strutil.Strip(strings.SliceBytes(lhsName, 0, assignIdxOpen))
                assignIdxText = strutil.Strip(strings.SliceBytes(lhsName,
                                                                 assignIdxOpen + 1,
                                                                 len(lhsName) - assignIdxOpen - 2))
            # 嵌套 seq-of-seq 元素存储 `grid[i][j] = v`：base 本身是下标
            # `grid[i]`（含 `[`），其值是内层 seq 头（16B 聚合，len@0/buf@8）。
            # 先按读路径（SeqIndexValueSlot）取内层头聚合槽，再从 header+8 取
            # 内层 buffer 指针，按内层元素步长定址 `innerBuf + j*esz`，把求值后的
            # RHS 存进去——内层 buffer 共享堆指针，故经头副本读出的指针即真地址。
            if assignIdxBaseText != "" &&
               assignIdxText != "" &&
               !PrimaryBodyIrTextHasCallSurface(assignIdxText) &&
               parser.ParserFindText(assignIdxBaseText, "[") >= 0 &&
               PrimaryBodyIrTextByteCodeEquals(assignIdxBaseText, len(assignIdxBaseText) - 1, 93):
                var nestRoot = ""
                var nestList: str[]
                nestList = []
                # base 必须是纯 `ident[...]...` 链（外层根为裸标识）。
                if PrimaryBodyIrMultiIndexParts(assignIdxBaseText, nestRoot, nestList) >= 1:
                    var nestOuterType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                                    typedFn,
                                                                                                    irFunction,
                                                                                                    stmt.lineNumber,
                                                                                                    nestRoot))
                    # 逐维剥下标得到 base（=grid[i]）的元素类型，再取内层元素类型。
                    var nestBaseType = nestOuterType
                    for nestDimIndex in 0..<nestList.len:
                        nestBaseType = PrimaryBodyIrIndexedElementTypeText(nestBaseType)
                    let nestElemType = PrimaryBodyIrIndexedElementTypeText(nestBaseType)
                    var nestElemKind = coreir.LocalInvalidTag
                    var nestElemSize = 0
                    var nestElemAlign = 0
                    if nestElemType != "":
                        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                       stmt.sourcePath,
                                                       nestElemType,
                                                       nestElemKind,
                                                       nestElemSize,
                                                       nestElemAlign)
                    # 仅处理内层为动态 seq（base 类型 `...[]`）且元素为标量/聚合。
                    if PrimaryBodyIrTypeTextIsDynamicSeq(nestBaseType) &&
                       nestElemSize > 0 &&
                       (nestElemKind == coreir.LocalI32Tag ||
                        nestElemKind == coreir.LocalI64Tag ||
                        nestElemKind == coreir.LocalPtrTag ||
                        nestElemKind == coreir.LocalAggregateTag):
                        PrimaryBodyIrNodeEvalMissOpReset()
                        let nestEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                        var nestReady = true
                        if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
                            let nestProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           typedFn,
                                                                           irFunction,
                                                                           stmt.rhsNodeIndex)
                            if nestProbeKind < 0:
                                nestReady = false
                        # 内层头聚合槽：与读路径同款（SeqIndexValueSlot 取元素副本）。
                        var nestHdrSlot = -1
                        if nestReady:
                            nestHdrSlot = PrimaryBodyIrSeqIndexValueSlot(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         typedFn,
                                                                         irFunction,
                                                                         stmt.sourcePath,
                                                                         stmt.lineNumber,
                                                                         assignIdxBaseText,
                                                                         callOrdinal)
                        var nestIdxSlot = -1
                        if nestHdrSlot >= 0 &&
                           (PrimaryBodyIrSlotType(bodyIR, nestHdrSlot) == coreir.LocalAggregateTag ||
                            PrimaryBodyIrSlotType(bodyIR, nestHdrSlot) == coreir.LocalPtrTag) &&
                           stmt.assignIndexNodeIndex >= 0:
                            # 阶段1 迁移：嵌套 seq 末层下标 `grid[i][j]` 的 `j` 从文本派发
                            # （ScalarValueSlotForText i32/i64 两路）改为节点求值器
                            # PrimaryBodyIrEvalNode(stmt.assignIndexNodeIndex)。前端
                            # typed_expr:20135 以 expected int32 为末层下标 idxText 建
                            # assignIndexNodeIndex（1:1 末层，与本路径 assignIdxText 同串）；
                            # EvalNode/Probe 覆盖变量(ParamRef/LocalRef)、算术、字段读
                            # (OpFieldGet)、索引读(OpIndexGet)族，与被删文本两路同覆盖面。
                            # 探针放行 i32/i64（madd 两宽皆收），求值在调用已发射后失败禁止
                            # 落回（6101 毒标，与单层索引赋值迁移 701f2a19d / for-range 起界
                            # dac2ed490 同款；外层 6102 守卫亦覆盖，此处更早更专一）。
                            let nestIdxNodeProbe = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             lowering.typedIr,
                                                                             typedFn,
                                                                             irFunction,
                                                                             stmt.assignIndexNodeIndex)
                            if nestIdxNodeProbe == coreir.LocalI32Tag ||
                               nestIdxNodeProbe == coreir.LocalI64Tag:
                                let nestIdxEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                                nestIdxSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                    slotNames,
                                                                    varI32ParamNames,
                                                                    lowering,
                                                                    typedFn,
                                                                    irFunction,
                                                                    stmt.assignIndexNodeIndex,
                                                                    callOrdinal)
                                if nestIdxSlot < 0 &&
                                   PrimaryBodyIrNodeEvalCallEmitCountNow() != nestIdxEmitMark:
                                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                                 stmt.lineNumber,
                                                                 int32(stmt.kind),
                                                                 6101,
                                                                 0)
                                    return true
                        var nestValueSlot = -1
                        if nestIdxSlot >= 0:
                            nestValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.rhsNodeIndex,
                                                                  callOrdinal)
                        var nestStored = false
                        if nestValueSlot >= 0:
                            var nestValueKind = PrimaryBodyIrSlotType(bodyIR, nestValueSlot)
                            if nestElemKind == coreir.LocalI64Tag &&
                               nestValueKind == coreir.LocalI32Tag:
                                let nestWideSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                                   slotNames,
                                                                                   nestValueSlot,
                                                                                   stmt.rhsNodeIndex,
                                                                                   4)
                                if nestWideSlot >= 0:
                                    nestValueSlot = nestWideSlot
                                    nestValueKind = coreir.LocalI64Tag
                            var nestKindOk = false
                            if nestElemKind == coreir.LocalI32Tag:
                                nestKindOk = nestValueKind == coreir.LocalI32Tag
                            elif nestElemKind == coreir.LocalI64Tag:
                                nestKindOk = nestValueKind == coreir.LocalI64Tag
                            elif nestElemKind == coreir.LocalPtrTag:
                                nestKindOk = nestValueKind == coreir.LocalPtrTag ||
                                             nestValueKind == coreir.LocalI64Tag
                            else:
                                nestKindOk = nestValueKind == coreir.LocalAggregateTag
                            if nestKindOk:
                                let nestBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                slotNames,
                                                                                Fmt"#nest_buf#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                                                coreir.LocalPtrTag)
                                let nestEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                                  slotNames,
                                                                                  Fmt"#nest_esz#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                                                  coreir.LocalI64Tag,
                                                                                  nestElemSize)
                                let nestAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                 slotNames,
                                                                                 Fmt"#nest_addr#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                                                 coreir.LocalPtrTag)
                                if nestBufSlot >= 0 && nestEszSlot >= 0 && nestAddrSlot >= 0:
                                    # 内层 buffer = *(内层头 + 8)。聚合头槽的 FieldLoad
                                    # 从槽地址+8 读出 buf 指针。
                                    var nestBufLoadOp: coreir.BodyOp
                                    nestBufLoadOp.kind = coreir.BodyOpFieldLoadTag
                                    nestBufLoadOp.target = nestBufSlot
                                    add(nestBufLoadOp.operands, nestHdrSlot)
                                    add(nestBufLoadOp.operands, nestBufSlot)
                                    add(nestBufLoadOp.operands, 8)
                                    add(nestBufLoadOp.operands, 8)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, nestBufLoadOp)
                                    var nestAddrOp: coreir.BodyOp
                                    nestAddrOp.kind = coreir.BodyOpBinOpTag
                                    nestAddrOp.target = nestAddrSlot
                                    add(nestAddrOp.operands, coreir.LocalI64Tag)
                                    add(nestAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                                    add(nestAddrOp.operands, nestIdxSlot)
                                    add(nestAddrOp.operands, nestEszSlot)
                                    add(nestAddrOp.operands, nestBufSlot)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, nestAddrOp)
                                    PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                                         nestAddrSlot,
                                                                         nestValueSlot,
                                                                         nestElemSize)
                                    nestStored = true
                        if nestStored:
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_index_nested function={typedFn.functionName} line={stmt.lineNumber}")
                            return true
                        if PrimaryBodyIrNodeEvalCallEmitCountNow() != nestEmitMark:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         6102,
                                                         0)
                            return true
                        if PrimaryBodyIrNodeEvalMissOpText() == "":
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_index_nested_shape")
            if stmt.assignLvalueNodeIndex >= 0 &&
               stmt.assignLvalueNodeIndex <
                   lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[
                   stmt.assignLvalueNodeIndex] ==
                   texpr.TypedExprIrOpIndexGet &&
               lowering.typedIr.nodes2_opKinds[
                   arenamod.ArenaArrayInt32Get(
                       lowering.typedIr.arena,
                       lowering.typedIr.nodes2_operand0NodeIndexs,
                       stmt.assignLvalueNodeIndex)] !=
                   texpr.TypedExprIrOpIndexGet:
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"DIAG aidx_enter fn={typedFn.functionName} line={stmt.lineNumber} lhs={stmt.bindingName} base={assignIdxBaseText} idxt={assignIdxText} rhs={stmt.surfaceText} rhsn={stmt.rhsNodeIndex} idxn={stmt.assignIndexNodeIndex}")
                var assignIdxRootSlot: int32
                var assignIdxHeaderOffset: int32
                var assignIdxElemKind = coreir.LocalInvalidTag
                var assignIdxElemSize = 0
                var exactIndexNode: int32
                var assignIdxIsFixedArray = false
                if stmt.rhsNodeIndex < 0 ||
                   !PrimaryBodyIrIndexedLvalueIdentityExact(
                       bodyIR,
                       bindingProjection,
                       lowering,
                       typedFn,
                       stmt.statementIndex,
                       stmt.assignLvalueNodeIndex,
                       stmt.rhsNodeIndex,
                       assignIdxRootSlot,
                       assignIdxHeaderOffset,
                       assignIdxElemKind,
                       assignIdxElemSize,
                       exactIndexNode,
                       assignIdxIsFixedArray) ||
                   exactIndexNode != stmt.assignIndexNodeIndex:
                    panic("backend2 body ir indexed assignment: immutable lvalue identity invalid")
                if assignIdxElemSize > 0 &&
                   (assignIdxElemKind == coreir.LocalI32Tag ||
                    assignIdxElemKind == coreir.LocalI64Tag ||
                    assignIdxElemKind == coreir.LocalPtrTag ||
                    assignIdxElemKind == coreir.LocalStrTag ||
                    assignIdxElemKind == coreir.LocalAggregateTag):
                    PrimaryBodyIrNodeEvalMissOpReset()
                    var assignIdxReady = true
                    if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
                        let assignIdxProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering.typedIr,
                                                                            typedFn,
                                                                            irFunction,
                                                                            stmt.rhsNodeIndex)
                        if assignIdxProbeKind < 0:
                            assignIdxReady = false
                        elif assignIdxElemKind == coreir.LocalI32Tag:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalI32Tag
                        elif assignIdxElemKind == coreir.LocalI64Tag:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalI32Tag ||
                                             assignIdxProbeKind == coreir.LocalI64Tag
                        elif assignIdxElemKind == coreir.LocalPtrTag:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalPtrTag ||
                                             assignIdxProbeKind == coreir.LocalI64Tag
                        elif assignIdxElemKind == coreir.LocalAggregateTag:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalAggregateTag
                        else:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalStrTag
                    var assignIdxSlot = -1
                    if assignIdxReady && stmt.assignIndexNodeIndex >= 0:
                        # 阶段1 迁移：索引下标从文本派发（ScalarValueSlotForText i32/i64
                        # + ContextScalarValueSlotForText 字段读 共 3 派发点）改为节点
                        # 求值器 PrimaryBodyIrEvalNode。前端 typed_expr:20019 以 expected
                        # int32 为末层下标 idxText 建 assignIndexNodeIndex；EvalNode/Probe
                        # 覆盖变量(ParamRef/LocalRef)、算术、字段读(OpFieldGet)、索引读
                        # (OpIndexGet)族下标，与被删文本三路同覆盖面。探针放行 i32/i64
                        # （下标既可 i32 也可 i64 索引，madd 两宽皆收），求值在调用已发射
                        # 后失败禁止落回（6101 毒标，与 for-range 起界迁移 dac2ed490 同款）。
                        let assignIdxNodeProbe = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering.typedIr,
                                                                            typedFn,
                                                                            irFunction,
                                                                            stmt.assignIndexNodeIndex)
                        if assignIdxNodeProbe == coreir.LocalI32Tag ||
                           assignIdxNodeProbe == coreir.LocalI64Tag:
                            let assignIdxIdxEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                            assignIdxSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.assignIndexNodeIndex,
                                                                  callOrdinal)
                            if assignIdxSlot < 0 &&
                               PrimaryBodyIrNodeEvalCallEmitCountNow() != assignIdxIdxEmitMark:
                                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                             stmt.lineNumber,
                                                             int32(stmt.kind),
                                                             6101,
                                                             0)
                                return true
                    let assignIdxEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                    var assignIdxValueSlot = -1
                    if assignIdxReady && assignIdxSlot >= 0:
                        assignIdxValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt.rhsNodeIndex,
                                                                   callOrdinal)
                    var assignIdxStored = false
                    if assignIdxValueSlot >= 0:
                        var assignIdxValueKind = PrimaryBodyIrSlotType(bodyIR, assignIdxValueSlot)
                        if assignIdxElemKind == coreir.LocalI64Tag &&
                           assignIdxValueKind == coreir.LocalI32Tag:
                            let assignIdxWideSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                                    slotNames,
                                                                                    assignIdxValueSlot,
                                                                                    stmt.rhsNodeIndex,
                                                                                    4)
                            if assignIdxWideSlot >= 0:
                                assignIdxValueSlot = assignIdxWideSlot
                                assignIdxValueKind = coreir.LocalI64Tag
                        var assignIdxKindOk = false
                        if assignIdxElemKind == coreir.LocalI32Tag:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalI32Tag
                        elif assignIdxElemKind == coreir.LocalI64Tag:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalI64Tag
                        elif assignIdxElemKind == coreir.LocalPtrTag:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalPtrTag ||
                                              assignIdxValueKind == coreir.LocalI64Tag
                        elif assignIdxElemKind == coreir.LocalAggregateTag:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalAggregateTag
                        else:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalStrTag
                        if assignIdxKindOk &&
                           assignIdxValueKind == coreir.LocalStrTag &&
                           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[assignIdxValueSlot]):
                            let assignIdxStrTmpSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                    slotNames,
                                                                                    Fmt"#aidxs{stmt.rhsNodeIndex}#{bodyIR.ops.len}",
                                                                                    coreir.LocalStrTag)
                            if assignIdxStrTmpSlot >= 0:
                                var assignIdxStrMatOp: coreir.BodyOp
                                assignIdxStrMatOp.kind = coreir.BodyOpFieldLoadTag
                                assignIdxStrMatOp.target = assignIdxStrTmpSlot
                                add(assignIdxStrMatOp.operands, assignIdxValueSlot)
                                add(assignIdxStrMatOp.operands, assignIdxStrTmpSlot)
                                add(assignIdxStrMatOp.operands, 0)
                                add(assignIdxStrMatOp.operands, 24)
                                let _ = coreir.BodyIRAppendOp(bodyIR, assignIdxStrMatOp)
                                assignIdxValueSlot = assignIdxStrTmpSlot
                            else:
                                assignIdxKindOk = false
                        if assignIdxKindOk:
                            let assignIdxBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                 slotNames,
                                                                                 Fmt"#aidx_buf#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                                                 coreir.LocalPtrTag)
                            let assignIdxEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                                   slotNames,
                                                                                   Fmt"#aidx_esz#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                                                   coreir.LocalI64Tag,
                                                                                   assignIdxElemSize)
                            let assignIdxAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                  slotNames,
                                                                                  Fmt"#aidx_addr#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                                                  coreir.LocalPtrTag)
                            if assignIdxBufSlot >= 0 && assignIdxEszSlot >= 0 && assignIdxAddrSlot >= 0:
                                var assignIdxBaseReady = true
                                if assignIdxIsFixedArray:
                                    # 定长数组：base = 聚合首地址（off=0），元素内联，
                                    # 无 buf 间接。复用 SeqAddHeaderPtrSlot 物化首地址。
                                    let assignFaBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                                                           slotNames,
                                                                                           stmt.lineNumber,
                                                                                           assignIdxRootSlot,
                                                                                           assignIdxHeaderOffset)
                                    if assignFaBaseSlot < 0:
                                        let _ = PrimaryBodyIrNodeEvalMissAt("store_index_fixed_base")
                                        assignIdxBaseReady = false
                                    else:
                                        assignIdxBufSlot = assignFaBaseSlot
                                else:
                                    var assignIdxBufLoadOp: coreir.BodyOp
                                    assignIdxBufLoadOp.kind = coreir.BodyOpFieldLoadTag
                                    assignIdxBufLoadOp.target = assignIdxBufSlot
                                    add(assignIdxBufLoadOp.operands, assignIdxRootSlot)
                                    add(assignIdxBufLoadOp.operands, assignIdxBufSlot)
                                    add(assignIdxBufLoadOp.operands, assignIdxHeaderOffset + 8)
                                    add(assignIdxBufLoadOp.operands, 8)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, assignIdxBufLoadOp)
                                if assignIdxBaseReady:
                                    var assignIdxAddrOp: coreir.BodyOp
                                    assignIdxAddrOp.kind = coreir.BodyOpBinOpTag
                                    assignIdxAddrOp.target = assignIdxAddrSlot
                                    add(assignIdxAddrOp.operands, coreir.LocalI64Tag)
                                    add(assignIdxAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                                    add(assignIdxAddrOp.operands, assignIdxSlot)
                                    add(assignIdxAddrOp.operands, assignIdxEszSlot)
                                    add(assignIdxAddrOp.operands, assignIdxBufSlot)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, assignIdxAddrOp)
                                    PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                                         assignIdxAddrSlot,
                                                                         assignIdxValueSlot,
                                                                         assignIdxElemSize)
                                    assignIdxStored = true
                    if assignIdxStored:
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_index function={typedFn.functionName} line={stmt.lineNumber}")
                        return true
                    if PrimaryBodyIrNodeEvalCallEmitCountNow() != assignIdxEmitMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        return true
                    if PrimaryBodyIrNodeEvalMissOpText() == "":
                        let _ = PrimaryBodyIrNodeEvalMissAt("store_index_shape")
        # A subscripted LHS (`arr[i]`, including a row-major-flattened multi-dim
        # `grid[(i)*cols+(j)]`) is an indexed store, never a plain scalar-slot
        # store. Resolving it as a named slot here would collide with the value
        # slot a prior indexed READ created under the same flattened text and
        # corrupt that cached value instead of the array cell. Leave it for the
        # text indexed-store path below.
        let nodeEvalLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
        if nodeEvalLhsSlot >= 0 &&
           nodeEvalLhsSlot < bodyIR.localSlots.len &&
           !PrimaryBodyIrTextHasFieldOrIndex(lhsName):
            let nodeEvalLhsPointee = PrimaryBodyIrVarParamPointeeKind(bodyIR, nodeEvalLhsSlot)
            let nodeEvalLhsVarI32 = PrimaryBodyIrNameInList(varI32ParamNames, lhsName) ||
                                    nodeEvalLhsPointee == coreir.LocalI32Tag
            var nodeEvalLhsKind = PrimaryBodyIrSlotType(bodyIR, nodeEvalLhsSlot)
            if nodeEvalLhsPointee == coreir.LocalInvalidTag &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalLhsSlot]):
                var nodeEvalLhsType = strings.CloneStr(stmt.resultType)
                if nodeEvalLhsType == "" || nodeEvalLhsType == "unknown" || nodeEvalLhsType == "call_expr":
                    nodeEvalLhsType = PrimaryBodyIrNodeResultTypeText(lowering.typedIr, stmt.rhsNodeIndex)
                if PrimaryBodyIrRetypeLocalScalarSlotForType(bodyIR,
                                                             lowering.typedIr,
                                                             stmt.sourcePath,
                                                             nodeEvalLhsSlot,
                                                             nodeEvalLhsType):
                    nodeEvalLhsKind = PrimaryBodyIrSlotType(bodyIR, nodeEvalLhsSlot)
            if stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpEmptySeqInit &&
               !nodeEvalLhsVarI32 &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag &&
               nodeEvalLhsKind == coreir.LocalAggregateTag &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalLhsSlot]):
                PrimaryBodyIrNodeEvalMissOpReset()
                if PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                    slotNames,
                                                    nodeEvalLhsSlot,
                                                    callOrdinal):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=empty_seq_init function={typedFn.functionName} line={stmt.lineNumber}")
                    return true
                let _ = PrimaryBodyIrNodeEvalMissAt("empty_seq_zero")
            # new(T):堆对象分配内征。前端给 `var a: I32 = new(I32)` 建占位
            # CallExpr 节点(literalText=="new"、surfaceText 保留完整 `new(I32)`)。
            # LHS 是 ref 对象槽(LocalPtrTag、无 pointee=非 var 形参指针写回)时,
            # 按 surfaceText 调 AppendNewObjectValue(→AppendHeapObjectAllocZero)
            # 直接分配零初始化对象写入目标槽。必须在下面 OpCallExpr 通用支之前——
            # 否则 new 被当函数调用 miss(call_ordinal)。命中即权威返回；分配失败
            # 落 MissAt("new_object")让位文本路径(无回归)。
            var ai3Lit = ""
            var ai3Surf = ""
            if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                let ai3LitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                let ai3SurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[stmt.rhsNodeIndex])
                if IsOk(ai3LitRes) && IsOk(ai3SurfRes):
                    ai3Lit = Value(ai3LitRes)
                    ai3Surf = Value(ai3SurfRes)
            if stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr &&
               ai3Lit == "new" &&
               nodeEvalLhsKind == coreir.LocalPtrTag &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag:
                PrimaryBodyIrNodeEvalMissOpReset()
                if PrimaryBodyIrAppendNewObjectValue(bodyIR,
                                                     slotNames,
                                                     lowering.typedIr,
                                                     stmt.sourcePath,
                                                     ai3Surf,
                                                     nodeEvalLhsSlot,
                                                     callOrdinal):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=new_object function={typedFn.functionName} line={stmt.lineNumber}")
                    return true
                let _ = PrimaryBodyIrNodeEvalMissAt("new_object")
            # 批次5：RHS 整为 CallExpr 节点且 LHS 是平凡本地标量/str 槽时
            #（var 形参经指针写回的协议另算，留文本路径）走 CallExpr 节点
            # 发射器。命中即权威返回；miss 落回文本路径（迁移窗口双轨）。
            if stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr &&
               PrimaryBodyIrCastCallTargetKind(ai3Lit) == coreir.LocalInvalidTag &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag &&
               (nodeEvalLhsKind == coreir.LocalI32Tag ||
                nodeEvalLhsKind == coreir.LocalI64Tag ||
                nodeEvalLhsKind == coreir.LocalStrTag ||
                nodeEvalLhsKind == coreir.LocalPtrTag ||
                nodeEvalLhsKind == coreir.LocalAggregateTag):
                PrimaryBodyIrNodeEvalMissOpReset()
                let callExprEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                var callExprNodeDone = false
                # 批次6b：嵌套调用实参一旦发射不可落回文本路径，发射前
                # 必须先过纯探针。
                if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering.typedIr,
                                              typedFn,
                                              irFunction,
                                              stmt.rhsNodeIndex) >= 0:
                    callExprNodeDone = PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering,
                                                                             typedFn,
                                                                             irFunction,
                                                                             varI32ParamNames,
                                                                             stmt.rhsNodeIndex,
                                                                             nodeEvalLhsSlot,
                                                                             stmt.lineNumber,
                                                                             callOrdinal)
                if callExprNodeDone:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
                    return true
                if PrimaryBodyIrNodeEvalCallEmitCountNow() != callExprEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    return true
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var callExprMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                    if callExprMissOpText == "":
                        callExprMissOpText = "call_expr"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={callExprMissOpText} function={typedFn.functionName} line={stmt.lineNumber}")
            if stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpEmptySeqInit &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag:
                PrimaryBodyIrNodeEvalMissOpReset()
                if nodeEvalLhsKind == coreir.LocalAggregateTag &&
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[nodeEvalLhsSlot]) == 16:
                    let emptySeqZeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                           slotNames,
                                                                           Fmt"{lhsName}#seq_zero64",
                                                                           coreir.LocalI64Tag,
                                                                           0)
                    if emptySeqZeroSlot >= 0:
                        var emptySeqZeroLo: coreir.BodyOp
                        emptySeqZeroLo.kind = coreir.BodyOpFieldStoreTag
                        emptySeqZeroLo.target = nodeEvalLhsSlot
                        add(emptySeqZeroLo.operands, nodeEvalLhsSlot)
                        add(emptySeqZeroLo.operands, emptySeqZeroSlot)
                        add(emptySeqZeroLo.operands, 0)
                        add(emptySeqZeroLo.operands, 8)
                        let _ = coreir.BodyIRAppendOp(bodyIR, emptySeqZeroLo)
                        var emptySeqZeroHi: coreir.BodyOp
                        emptySeqZeroHi.kind = coreir.BodyOpFieldStoreTag
                        emptySeqZeroHi.target = nodeEvalLhsSlot
                        add(emptySeqZeroHi.operands, nodeEvalLhsSlot)
                        add(emptySeqZeroHi.operands, emptySeqZeroSlot)
                        add(emptySeqZeroHi.operands, 8)
                        add(emptySeqZeroHi.operands, 8)
                        let _ = coreir.BodyIRAppendOp(bodyIR, emptySeqZeroHi)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=empty_seq_init function={typedFn.functionName} line={stmt.lineNumber}")
                        return true
                let _ = PrimaryBodyIrNodeEvalMissAt("empty_seq_init")
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op=empty_seq_init function={typedFn.functionName} line={stmt.lineNumber}")
            if stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpNilPtr &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag:
                PrimaryBodyIrNodeEvalMissOpReset()
                let nilLhsBindingType = texpr.TypedExprNormalizeTypeText(PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                                          typedFn,
                                                                                                          irFunction,
                                                                                                          stmt.lineNumber,
                                                                                                          lhsName))
                if nodeEvalLhsKind == coreir.LocalPtrTag &&
                   !PrimaryStartsWith(nilLhsBindingType, "var"):
                    var nilAssignOp: coreir.BodyOp
                    nilAssignOp.kind = coreir.BodyOpLoadConstTag
                    nilAssignOp.target = nodeEvalLhsSlot
                    add(nilAssignOp.operands, coreir.LocalPtrTag)
                    add(nilAssignOp.operands, 0)
                    let _ = coreir.BodyIRAppendOp(bodyIR, nilAssignOp)
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=nil_ptr function={typedFn.functionName} line={stmt.lineNumber}")
                    return true
                if nodeEvalLhsKind == coreir.LocalPtrTag &&
                   PrimaryStartsWith(nilLhsBindingType, "var") &&
                   PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalLhsSlot]):
                    let nilVarPtrZeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                            slotNames,
                                                                            Fmt"{lhsName}#var_ptr_nil_zero",
                                                                            coreir.LocalI64Tag,
                                                                            0)
                    if nilVarPtrZeroSlot >= 0:
                        PrimaryBodyIrAppendVarI64Store(bodyIR, nodeEvalLhsSlot, nilVarPtrZeroSlot)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=nil_var_ptr function={typedFn.functionName} line={stmt.lineNumber}")
                        return true
                let _ = PrimaryBodyIrNodeEvalMissAt("nil_ptr")
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op=nil_ptr function={typedFn.functionName} line={stmt.lineNumber}")
            let nodeEvalLhsVarStr = nodeEvalLhsKind == coreir.LocalAggregateTag &&
                                    bodyIR.localSlots[nodeEvalLhsSlot].auxValue == coreir.LocalStrTag &&
                                    PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalLhsSlot])
            var nodeEvalAttempt = false
            if nodeEvalLhsVarI32 ||
               nodeEvalLhsPointee == coreir.LocalI64Tag ||
               nodeEvalLhsPointee == coreir.LocalF64Tag ||
               nodeEvalLhsVarStr:
                nodeEvalAttempt = true
            elif nodeEvalLhsPointee == coreir.LocalInvalidTag &&
                 (nodeEvalLhsKind == coreir.LocalI32Tag ||
                  nodeEvalLhsKind == coreir.LocalI64Tag ||
                  nodeEvalLhsKind == coreir.LocalF64Tag ||
                  nodeEvalLhsKind == coreir.LocalStrTag ||
                  nodeEvalLhsKind == coreir.LocalPtrTag):
                nodeEvalAttempt = true
            if nodeEvalAttempt:
                PrimaryBodyIrNodeEvalMissOpReset()
                # 批次6b：子树含调用时先过纯探针并预检存储形态——调用一旦
                # 发射不可落回文本路径。
                var nodeEvalReady = true
                if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
                    let nodeEvalProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering.typedIr,
                                                                       typedFn,
                                                                       irFunction,
                                                                       stmt.rhsNodeIndex)
                    if nodeEvalProbeKind < 0:
                        nodeEvalReady = false
                    elif nodeEvalLhsVarI32:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalI32Tag
                    elif nodeEvalLhsPointee == coreir.LocalI64Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalI32Tag ||
                                        nodeEvalProbeKind == coreir.LocalI64Tag
                    elif nodeEvalLhsPointee == coreir.LocalF64Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalF64Tag
                    elif nodeEvalLhsVarStr:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalStrTag
                    elif nodeEvalLhsKind == coreir.LocalStrTag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalStrTag
                    elif nodeEvalLhsKind == coreir.LocalI32Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalI32Tag
                    elif nodeEvalLhsKind == coreir.LocalI64Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalI32Tag ||
                                        nodeEvalProbeKind == coreir.LocalI64Tag
                    elif nodeEvalLhsKind == coreir.LocalF64Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalF64Tag
                    elif nodeEvalLhsKind == coreir.LocalPtrTag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalPtrTag
                    else:
                        nodeEvalReady = false
                let nodeEvalEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                var nodeEvalValueSlot: int32 = -1
                if nodeEvalReady:
                    nodeEvalValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,
                                                              typedFn,
                                                              irFunction,
                                                              stmt.rhsNodeIndex,
                                                              callOrdinal)
                var nodeEvalStored = false
                if nodeEvalValueSlot >= 0:
                    if nodeEvalLhsVarI32:
                        if PrimaryBodyIrSlotType(bodyIR, nodeEvalValueSlot) == coreir.LocalI32Tag:
                            PrimaryBodyIrAppendVarI32Store(bodyIR, nodeEvalLhsSlot, nodeEvalValueSlot)
                            nodeEvalStored = true
                        else:
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_var_i32")
                    elif nodeEvalLhsPointee == coreir.LocalI64Tag:
                        var nodeEvalVarI64Slot = nodeEvalValueSlot
                        if PrimaryBodyIrSlotType(bodyIR, nodeEvalVarI64Slot) == coreir.LocalI32Tag:
                            nodeEvalVarI64Slot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                                 slotNames,
                                                                                 nodeEvalVarI64Slot,
                                                                                 stmt.rhsNodeIndex,
                                                                                 2)
                        if nodeEvalVarI64Slot >= 0 &&
                           PrimaryBodyIrSlotType(bodyIR, nodeEvalVarI64Slot) == coreir.LocalI64Tag:
                            PrimaryBodyIrAppendVarI64Store(bodyIR, nodeEvalLhsSlot, nodeEvalVarI64Slot)
                            nodeEvalStored = true
                        else:
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_var_i64")
                    elif nodeEvalLhsPointee == coreir.LocalF64Tag:
                        if PrimaryBodyIrSlotType(bodyIR, nodeEvalValueSlot) == coreir.LocalF64Tag:
                            PrimaryBodyIrAppendVarI64Store(bodyIR, nodeEvalLhsSlot, nodeEvalValueSlot)
                            nodeEvalStored = true
                        else:
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_var_f64")
                    elif nodeEvalLhsVarStr:
                        if PrimaryBodyIrSlotType(bodyIR, nodeEvalValueSlot) == coreir.LocalStrTag:
                            var nodeEvalVarStrSlot = nodeEvalValueSlot
                            if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalValueSlot]):
                                nodeEvalVarStrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                   slotNames,
                                                                                   Fmt"#nevs{nodeEvalLhsSlot}#{bodyIR.ops.len}",
                                                                                   coreir.LocalStrTag)
                                if nodeEvalVarStrSlot >= 0:
                                    var nodeEvalVarStrMatOp: coreir.BodyOp
                                    nodeEvalVarStrMatOp.kind = coreir.BodyOpFieldLoadTag
                                    nodeEvalVarStrMatOp.target = nodeEvalVarStrSlot
                                    add(nodeEvalVarStrMatOp.operands, nodeEvalValueSlot)
                                    add(nodeEvalVarStrMatOp.operands, nodeEvalVarStrSlot)
                                    add(nodeEvalVarStrMatOp.operands, 0)
                                    add(nodeEvalVarStrMatOp.operands, 24)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, nodeEvalVarStrMatOp)
                            if nodeEvalVarStrSlot >= 0:
                                PrimaryBodyIrAppendVarAggregateStore(bodyIR, nodeEvalLhsSlot, nodeEvalVarStrSlot, 24)
                                nodeEvalStored = true
                        if !nodeEvalStored:
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_var_str")
                    else:
                        nodeEvalStored = PrimaryBodyIrNodeEvalStore(bodyIR,
                                                                    slotNames,
                                                                    nodeEvalLhsSlot,
                                                                    nodeEvalValueSlot)
                if nodeEvalStored:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
                    return true
                if PrimaryBodyIrNodeEvalCallEmitCountNow() != nodeEvalEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    return true
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var nodeEvalMissOpText = PrimaryBodyIrNodeEvalMissOpText()
                    if nodeEvalMissOpText == "":
                        nodeEvalMissOpText = "store_shape"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={nodeEvalMissOpText} function={typedFn.functionName} line={stmt.lineNumber}")
    if stmt.assignFieldName != "":
        let fieldAssignEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
        if PrimaryBodyIrAppendSimpleFieldAssignFast(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,
                                                    typedFn,
                                                    irFunction,
                                                    stmt,
                                                    rhsText,
                                                    callOrdinal,
                                                    currentBlockStart):
            return true
        if PrimaryBodyIrNodeEvalCallEmitCountNow() != fieldAssignEmitMark:
            # 求值已发射调用后失败：禁止落回文本路径（调用会二次发射）；
            # 显式无效操作暴露（节点探针应已拦截，此处为最后防线）。
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         6101,
                                         0)
            return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_B function={typedFn.functionName} line={stmt.lineNumber}")
    if lhsName == "_":
        if stmt.callTarget != "":
            let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                              slotNames,
                                              lowering,
                                              typedFn,
                                              irFunction,
                                              stmt,
                                              -1,
                                              varI32ParamNames,
                                              callOrdinal,
                                              currentBlockStart)
            return true
        if PrimaryBodyIrTextHasCallSurface(rhsText):
            if PrimaryBodyIrHasSameLineCallForRhs(irFunction.statements,
                                                  stmt.lineNumber,
                                                  rhsText):
                return true
            return false
        return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_C function={typedFn.functionName} line={stmt.lineNumber}")
    let lhsPointerText = PrimaryBodyIrUInt8PtrDerefPointerText(lhsName)
    if lhsPointerText != "":
        var storeFailureDetail: int32
        if !PrimaryBodyIrAppendUInt8PtrDerefStore(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering.typedIr,
                                                  stmt.sourcePath,
                                                  lhsName,
                                                  rhsText,
                                                  storeFailureDetail,
                                                  callOrdinal):
            if storeFailureDetail == 713:
                # Contextual retry: values like root.field[i] need binding-type
                # context; the pointer call backscan dedups the prior ops.
                let ctxRetryValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                   slotNames,
                                                                                   varI32ParamNames,
                                                                                   lowering.typedIr,
                                                                                   typedFn,
                                                                                   irFunction,
                                                                                   stmt.sourcePath,
                                                                                   stmt.lineNumber,
                                                                                   rhsText,
                                                                                   coreir.LocalI32Tag)
                if ctxRetryValueSlot >= 0:
                    let ctxRetryPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         stmt.sourcePath,
                                                                         lhsPointerText,
                                                                         callOrdinal)
                    if ctxRetryPtrSlot >= 0:
                        var ctxRetryStoreOp: coreir.BodyOp
                        ctxRetryStoreOp.kind = coreir.BodyOpIndexedStoreTag
                        ctxRetryStoreOp.target = ctxRetryPtrSlot
                        add(ctxRetryStoreOp.operands, ctxRetryPtrSlot)
                        add(ctxRetryStoreOp.operands, ctxRetryValueSlot)
                        add(ctxRetryStoreOp.operands, coreir.BodyStoreLocalPtrDerefU8Tag)
                        let _ = coreir.BodyIRAppendOp(bodyIR, ctxRetryStoreOp)
                        return true
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         storeFailureDetail,
                                         0)
        return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_D function={typedFn.functionName} line={stmt.lineNumber}")
    if len(lhsName) > 1 && lhsName[0] == '*':
        # General pointer-deref store: *ptrExpr = value (width by value slot).
        var derefInner = strutil.Strip(strings.SliceBytes(lhsName, 1, len(lhsName) - 1))
        derefInner = PrimaryBodyIrStripOuterParens(derefInner)
        var derefPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering.typedIr,
                                                          stmt.sourcePath,
                                                          derefInner,
                                                          callOrdinal)
        var derefCtxPointeeSize: int32
        if derefPtrSlot < 0 && PrimaryBodyIrTextHasCallSurface(derefInner):
            panic(Fmt"backend2: pointer-deref lvalue call lacks parser-owned TypedExpr node function={typedFn.functionName} line={stmt.lineNumber}")
        if derefPtrSlot < 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         715,
                                         0)
            return true
        if derefCtxPointeeSize == 1:
            # 1 字节 pointee (uint8*): 值按 I32 上下文求值, U8-tag 存储 (镜像
            # 713 ctx-retry 的存储形)。宽存会踩相邻字节, 必须走 tag 臂。
            var derefCtxU8ValueSlot: int32 = -1
            # RHS 也是 `*(userCall())` 1 字节 deref-load (ArenaClone 逐字节
            # 拷贝循环): 同款 ctx 指针物化 + U8-tag load 进 I32 槽。
            if len(rhsText) > 1 && rhsText[0] == '*':
                var derefCtxRhsInner = strutil.Strip(strings.SliceBytes(rhsText, 1, len(rhsText) - 1))
                derefCtxRhsInner = PrimaryBodyIrStripOuterParens(derefCtxRhsInner)
                if PrimaryBodyIrTextHasCallSurface(derefCtxRhsInner):
                    panic(Fmt"backend2: pointer-deref RHS call lacks parser-owned TypedExpr node function={typedFn.functionName} line={stmt.lineNumber}")
            if derefCtxU8ValueSlot < 0:
                derefCtxU8ValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                 slotNames,
                                                                                 varI32ParamNames,
                                                                                 lowering.typedIr,
                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 stmt.sourcePath,
                                                                                 stmt.lineNumber,
                                                                                 rhsText,
                                                                                 coreir.LocalI32Tag)
            if derefCtxU8ValueSlot < 0:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             716,
                                             0)
                return true
            var derefCtxU8StoreOp: coreir.BodyOp
            derefCtxU8StoreOp.kind = coreir.BodyOpIndexedStoreTag
            derefCtxU8StoreOp.target = derefPtrSlot
            add(derefCtxU8StoreOp.operands, derefPtrSlot)
            add(derefCtxU8StoreOp.operands, derefCtxU8ValueSlot)
            add(derefCtxU8StoreOp.operands, coreir.BodyStoreLocalPtrDerefU8Tag)
            let _ = coreir.BodyIRAppendOp(bodyIR, derefCtxU8StoreOp)
            return true
        var derefValueTypeText = "int64"
        var derefValueTypeKind = coreir.LocalI64Tag
        if PrimaryBodyIrWholeCallInnerForHead(derefInner, "Int32Ptr") != "" ||
           PrimaryBodyIrWholeCallInnerForHead(derefInner, "UInt32Ptr") != "":
            derefValueTypeText = "int32"
            derefValueTypeKind = coreir.LocalI32Tag
        if derefCtxPointeeSize == 4:
            derefValueTypeText = "int32"
            derefValueTypeKind = coreir.LocalI32Tag
        var derefValueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        if derefValueSlot < 0:
            let derefValueType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 stmt.lineNumber,
                                                                 rhsText)
            if derefValueType != "":
                derefValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    stmt.sourcePath,
                                                                    rhsText,
                                                                    derefValueType)
        if derefValueSlot < 0:
            derefValueSlot = PrimaryBodyIrLocalInitValueSlot(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             lowering.typedIr,
                                                             stmt.sourcePath,
                                                             derefValueTypeText,
                                                             derefValueTypeKind,
                                                             rhsText, callOrdinal)
        if derefValueSlot < 0 &&
           PrimaryBodyIrTextHasCallSurface(rhsText):
            # 8-byte store of a scalar call result.
            derefValueSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering.typedIr,
                                                            stmt.sourcePath,
                                                            rhsText,
                                                            callOrdinal)
        if derefValueSlot < 0 && derefValueTypeKind == coreir.LocalI64Tag:
            derefValueSlot = PrimaryBodyIrU64ValueSlotForText(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering.typedIr,
                                                              stmt.sourcePath,
                                                              rhsText,
                                                              callOrdinal)
        if derefValueSlot < 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         716,
                                         0)
            return true
        if derefValueTypeKind == coreir.LocalI32Tag &&
           derefValueSlot >= 0 &&
           derefValueSlot < bodyIR.localSlots.len &&
           (PrimaryBodyIrSlotType(bodyIR, derefValueSlot) == coreir.LocalI64Tag ||
            PrimaryBodyIrSlotType(bodyIR, derefValueSlot) == coreir.LocalPtrTag):
            let derefNarrowSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                Fmt"#deref_store_i32#{bodyIR.ops.len}",
                                                                coreir.LocalI32Tag)
            if derefNarrowSlot >= 0:
                var derefNarrowOp: coreir.BodyOp
                derefNarrowOp.kind = coreir.BodyOpCopyLocalTag
                derefNarrowOp.target = derefNarrowSlot
                add(derefNarrowOp.operands, derefValueSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, derefNarrowOp)
                derefValueSlot = derefNarrowSlot
        var derefStoreOp: coreir.BodyOp
        derefStoreOp.kind = coreir.BodyOpIndexedStoreTag
        derefStoreOp.target = derefPtrSlot
        add(derefStoreOp.operands, derefPtrSlot)
        add(derefStoreOp.operands, derefValueSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, derefStoreOp)
        return true
    if len(rhsText) > 1 && rhsText[0] == '*' &&
       PrimaryBodyIrUInt8PtrDerefPointerText(rhsText) == "" &&
       PrimaryBodyIrI32PtrDerefPointerText(rhsText) == "" &&
       len(lhsName) > 0 && lhsName[0] != '*':
        # General pointer-width deref load: lhs = *(VoidPtrPtr(x)) etc.
        var loadInner = strutil.Strip(strings.SliceBytes(rhsText, 1, len(rhsText) - 1))
        loadInner = PrimaryBodyIrStripOuterParens(loadInner)
        let loadPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering.typedIr,
                                                         stmt.sourcePath,
                                                         loadInner,
                                                         callOrdinal)
        if loadPtrSlot >= 0:
            var loadTargetType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 stmt.lineNumber,
                                                                 lhsName)
            if loadTargetType == "":
                loadTargetType = "ptr"
            let loadTargetSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    stmt.sourcePath,
                                                                    lhsName,
                                                                    loadTargetType)
            if loadTargetSlot >= 0:
                var loadOp: coreir.BodyOp
                loadOp.kind = coreir.BodyOpIndexedLoadTag
                loadOp.target = loadTargetSlot
                add(loadOp.operands, loadPtrSlot)
                add(loadOp.operands, loadTargetSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
                return true
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     719,
                                     0)
        return true
    if stmt.callTarget == "" && len(rhsText) > 1 && rhsText[0] == '&':
        # Address-of local: lhs = &name (lea of the local's stack slot).
        let addrName = PrimaryBodyIrPtrAddressArgName(rhsText)
        if addrName != "":
            let addrSourceSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, addrName)
            var addrTargetSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
            if addrTargetSlot < 0:
                addrTargetSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    stmt.sourcePath,
                                                                    lhsName,
                                                                    "ptr")
            if addrSourceSlot >= 0 &&
               addrSourceSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[addrSourceSlot].placeKind == coreir.BodyPlaceStackValueTag &&
               addrTargetSlot >= 0 &&
               PrimaryBodyIrSlotType(bodyIR, addrTargetSlot) == coreir.LocalPtrTag:
                var addrOp: coreir.BodyOp
                addrOp.kind = coreir.BodyOpLoadLocalTag
                addrOp.target = addrTargetSlot
                add(addrOp.operands, coreir.BodyLoadLocalAddressTag)
                add(addrOp.operands, addrSourceSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
                return true
    if len(lhsName) > 2 &&
       lhsName[len(lhsName) - 1] == ']' &&
       PrimaryBodyIrWholeCallInnerForHead(rhsText, "uint8") != "":
        # Byte element store through a pointer base: arr[idx] = uint8(v)
        var idxOpenPos = -1
        for idxScan in 0..<len(lhsName):
            if lhsName[idxScan] == '[':
                idxOpenPos = idxScan
                break
        if idxOpenPos > 0:
            let idxBaseName = strutil.Strip(strings.SliceBytes(lhsName, 0, idxOpenPos))
            let idxText = strutil.Strip(strings.SliceBytes(lhsName,
                                                           idxOpenPos + 1,
                                                           len(lhsName) - idxOpenPos - 2))
            let idxBaseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, idxBaseName)
            if idxBaseSlot >= 0 &&
               idxBaseSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, idxBaseSlot) == coreir.LocalPtrTag &&
               idxText != "":
                let idxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  stmt.sourcePath,
                                                                  idxText,
                                                                  coreir.LocalI32Tag,
                                                                  callOrdinal)
                if idxSlot >= 0:
                    let idxWideSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"#idx_wide#{bodyIR.ops.len}",
                                                                    coreir.LocalI64Tag)
                    var idxWidenOp: coreir.BodyOp
                    idxWidenOp.kind = coreir.BodyOpCopyLocalTag
                    idxWidenOp.target = idxWideSlot
                    add(idxWidenOp.operands, idxSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, idxWidenOp)
                    let idxAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"#idx_addr#{bodyIR.ops.len}",
                                                                    coreir.LocalPtrTag)
                    var idxAddrOp: coreir.BodyOp
                    idxAddrOp.kind = coreir.BodyOpBinOpTag
                    idxAddrOp.target = idxAddrSlot
                    add(idxAddrOp.operands, coreir.LocalI64Tag)
                    add(idxAddrOp.operands, int32(texpr.TypedExprIrOpI32Add))
                    add(idxAddrOp.operands, idxBaseSlot)
                    add(idxAddrOp.operands, idxWideSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, idxAddrOp)
                    let idxValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
