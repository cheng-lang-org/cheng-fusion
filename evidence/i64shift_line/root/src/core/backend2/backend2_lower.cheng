        if existingLhsSlot < 0:
            var resultTypeText = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
            if resultTypeText == "" || resultTypeText == "unknown":
                resultTypeText = stmt.resultType
            if resultTypeText == "" || resultTypeText == "unknown":
                return false
            # Global lhs with a call rhs: the result must store through the
            # global; a same-named local would orphan the assignment.
            let lhsCallGlobalType = PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt.sourcePath, lhsName)
            if lhsCallGlobalType != "" &&
               PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                               typedFn,
                                               irFunction,
                                               stmt.lineNumber,
                                               lhsName) == "":
                var lhsCallGlobalKind: int32
                var lhsCallGlobalSize: int32
                var lhsCallGlobalAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               lhsCallGlobalType,
                                               lhsCallGlobalKind,
                                               lhsCallGlobalSize,
                                               lhsCallGlobalAlign)
                if lhsCallGlobalKind == coreir.LocalI32Tag ||
                   lhsCallGlobalKind == coreir.LocalI64Tag ||
                   lhsCallGlobalKind == coreir.LocalPtrTag:
                    let lhsCallGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr,
                                                                                 stmt.sourcePath,
                                                                                 lhsName)
                    if lhsCallGlobalSlotName != "":
                        let lhsCallValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                             slotNames,
                                                                             Fmt"{lhsName}#global_call_value#{stmt.lineNumber}",
                                                                             lhsCallGlobalKind)
                        if lhsCallValueSlot >= 0:
                            let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                              slotNames,
                                                              lowering,
                                                              typedFn,
                                                              irFunction,
                                                              stmt,
                                                              lhsCallValueSlot,
                                                              varI32ParamNames,
                                                              callOrdinal,
                                                              currentBlockStart)
                            let lhsCallGlobalSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                  slotNames,
                                                                                  lhsCallGlobalSlotName,
                                                                                  lhsCallGlobalKind)
                            bodyIR.localSlots[lhsCallGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                            var lhsCallStoreOp: coreir.BodyOp
                            lhsCallStoreOp.kind = coreir.BodyOpGlobalStoreTag
                            lhsCallStoreOp.target = lhsCallValueSlot
                            add(lhsCallStoreOp.operands, lhsCallGlobalSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, lhsCallStoreOp)
                            return true
                if lhsCallGlobalKind == coreir.LocalStrTag:
                    # Managed sret first lands in an owned local, then move-store
                    # transfers it while releasing the previous global value.
                    let lhsStrGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr,
                                                                                stmt.sourcePath,
                                                                                lhsName)
                    if lhsStrGlobalSlotName != "":
                        let lhsStrGlobalSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                  slotNames,
                                                                                  lowering.typedIr,
                                                                                  stmt.sourcePath,
                                                                                  lhsStrGlobalSlotName,
                                                                                  lhsCallGlobalType)
                        if lhsStrGlobalSlot >= 0 &&
                           lhsStrGlobalSlot < bodyIR.localSlots.len &&
                           PrimaryBodyIrSlotType(bodyIR, lhsStrGlobalSlot) == coreir.LocalStrTag &&
                           PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsStrGlobalSlot]) == 24:
                            let lhsStrCallValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(
                                bodyIR,
                                slotNames,
                                lowering.typedIr,
                                stmt.sourcePath,
                                Fmt"#global_call_str_value#{stmt.lineNumber}",
                                lhsCallGlobalType)
                            if lhsStrCallValueSlot < 0 ||
                               lhsStrCallValueSlot >= bodyIR.localSlots.len ||
                               PrimaryBodyIrSlotType(bodyIR, lhsStrCallValueSlot) != coreir.LocalStrTag:
                                panic(Fmt"backend2: managed global call result slot unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
                            bodyIR.localSlots[lhsStrGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                            let lhsStrCallCountBefore = bodyIR.callSequence.len
                            let lhsStrCallEmitSlot = PrimaryBodyIrAppendCallOp(bodyIR,
                                                                              slotNames,
                                                                              lowering,
                                                                              typedFn,
                                                                              irFunction,
                                                                              stmt,
                                                                              lhsStrCallValueSlot,
                                                                              varI32ParamNames,
                                                                              callOrdinal,
                                                                              currentBlockStart)
                            if lhsStrCallEmitSlot != lhsStrCallValueSlot ||
                               bodyIR.callSequence.len <= lhsStrCallCountBefore ||
                               bodyIR.callSequence[bodyIR.callSequence.len - 1].resultSlot != lhsStrCallValueSlot:
                                panic(Fmt"backend2: managed global str call emission failed source={stmt.sourcePath} line={stmt.lineNumber}")
                            if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                                     lowering,
                                                                     lhsStrGlobalSlot,
                                                                     lhsStrCallValueSlot,
                                                                     PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                                         lowering.typedIr, stmt.rhsNodeIndex),
                                                                     callOrdinal):
                                panic(Fmt"backend2: managed global call store unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
                            return true
                if lhsCallGlobalKind == coreir.LocalAggregateTag && lhsCallGlobalSize > 0:
                    # Managed dynamic-seq sret uses an owned local plus move-store;
                    # only proven plain inline aggregates may sret directly global.
                    let lhsAggGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr,
                                                                                stmt.sourcePath,
                                                                                lhsName)
                    if lhsAggGlobalSlotName != "":
                        let lhsAggGlobalSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                  slotNames,
                                                                                  lowering.typedIr,
                                                                                  stmt.sourcePath,
                                                                                  lhsAggGlobalSlotName,
                                                                                  lhsCallGlobalType)
                        if lhsAggGlobalSlot >= 0 &&
                           lhsAggGlobalSlot < bodyIR.localSlots.len &&
                           PrimaryBodyIrSlotType(bodyIR, lhsAggGlobalSlot) == coreir.LocalAggregateTag &&
                           PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsAggGlobalSlot]) >= lhsCallGlobalSize:
                            bodyIR.localSlots[lhsAggGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                            if PrimaryBodyIrTypeTextIsDynamicSeq(lhsCallGlobalType):
                                let lhsAggCallValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(
                                    bodyIR,
                                    slotNames,
                                    lowering.typedIr,
                                    stmt.sourcePath,
                                    Fmt"#global_call_seq_value#{stmt.lineNumber}",
                                    lhsCallGlobalType)
                                if lhsAggCallValueSlot < 0:
                                    panic(Fmt"backend2: managed sequence call result slot unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
                                let lhsAggCallCountBefore = bodyIR.callSequence.len
                                let lhsAggCallEmitSlot = PrimaryBodyIrAppendCallOp(bodyIR,
                                                                                  slotNames,
                                                                                  lowering,
                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt,
                                                                                  lhsAggCallValueSlot,
                                                                                  varI32ParamNames,
                                                                                  callOrdinal,
                                                                                  currentBlockStart)
                                if lhsAggCallEmitSlot != lhsAggCallValueSlot ||
                                   bodyIR.callSequence.len <= lhsAggCallCountBefore ||
                                   bodyIR.callSequence[bodyIR.callSequence.len - 1].resultSlot != lhsAggCallValueSlot:
                                    panic(Fmt"backend2: managed global sequence call emission failed source={stmt.sourcePath} line={stmt.lineNumber}")
                                if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                                         lowering,
                                                                         lhsAggGlobalSlot,
                                                                         lhsAggCallValueSlot,
                                                                         PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                                             lowering.typedIr, stmt.rhsNodeIndex),
                                                                         callOrdinal):
                                    panic(Fmt"backend2: managed sequence call global store unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
                            else:
                                let lhsAggCallValueSlot =
                                    PrimaryBodyIrFindOrCreateTypedSlot(
                                        bodyIR,
                                        slotNames,
                                        lowering.typedIr,
                                        stmt.sourcePath,
                                        Fmt"#global_call_aggregate_value#{stmt.rhsNodeIndex}",
                                        lhsCallGlobalType)
                                if lhsAggCallValueSlot < 0 ||
                                   lhsAggCallValueSlot ==
                                       lhsAggGlobalSlot:
                                    panic("backend2: aggregate call result local unavailable")
                                let lhsAggCallEmitSlot =
                                    PrimaryBodyIrAppendCallOp(
                                        bodyIR,
                                        slotNames,
                                        lowering,
                                        typedFn,
                                        irFunction,
                                        stmt,
                                        lhsAggCallValueSlot,
                                        varI32ParamNames,
                                        callOrdinal,
                                        currentBlockStart)
                                if lhsAggCallEmitSlot !=
                                       lhsAggCallValueSlot ||
                                   !PrimaryBodyIrBindCanonicalAggregateCallGlobalStoreProof(
                                       bodyIR,
                                       lowering,
                                       stmt.sourcePath,
                                       lhsName,
                                       lhsAggGlobalSlot,
                                       lhsAggCallValueSlot,
                                       stmt.rhsNodeIndex):
                                    panic(Fmt"backend2: canonical aggregate call global TypeArena proof unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
                                var lhsAggStoreOp: coreir.BodyOp
                                lhsAggStoreOp.kind =
                                    coreir.BodyOpGlobalStoreTag
                                lhsAggStoreOp.target =
                                    lhsAggCallValueSlot
                                add(lhsAggStoreOp.operands,
                                    lhsAggGlobalSlot)
                                let _ = coreir.BodyIRAppendOp(
                                    bodyIR, lhsAggStoreOp)
                            return true
            let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                slotNames,
                                                                lowering.typedIr,
                                                                PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                                lhsName,
                                                                resultTypeText)
            if resultSlot < 0:
                return false
            let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                              slotNames,
                                              lowering,
                                              typedFn,
                                              irFunction,
                                              stmt,
                                              resultSlot,
                                              varI32ParamNames,
                                              callOrdinal,
                                              currentBlockStart)
            return true
    if stmt.callTarget == "" &&
       PrimaryBodyIrTextHasCallSurface(rhsText) &&
       PrimaryBodyIrHasSameLineCallForRhs(irFunction.statements,
                                          stmt.lineNumber,
                                          rhsText):
        return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_E function={typedFn.functionName} line={stmt.lineNumber}")
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_F function={typedFn.functionName} line={stmt.lineNumber}")
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_G function={typedFn.functionName} line={stmt.lineNumber}")
    # A plain `ptr` local assigned a string literal (`var p: ptr; p = "..."`)
    # is a cstring-address store, not a str value store. Leave it for the
    # cstring-literal-assign path below; entering the str-literal block here
    # would mint a str-typed slot and reject the ptr slot as size-mismatched
    # (return false -> WCZ). Var-str params (Aggregate/aux=str) still belong
    # here, so only the non-param plain-ptr local is excluded.
    var litLhsIsPlainPtrLocal = false
    let litLhsSlotProbe = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
    if litLhsSlotProbe >= 0 &&
       litLhsSlotProbe < bodyIR.localSlots.len &&
       bodyIR.localSlots[litLhsSlotProbe].typeKind == coreir.LocalPtrTag &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[litLhsSlotProbe]) &&
       PrimaryBodyIrVarParamPointeeKind(bodyIR, litLhsSlotProbe) == coreir.LocalInvalidTag:
        litLhsIsPlainPtrLocal = true
    if PrimaryBodyIrTextIsStringLiteral(rhsText) && !litLhsIsPlainPtrLocal:
        var litSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
        var litGlobalLhs = false
        if litSlot < 0:
            # globals take the global-store path below
            if PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt.sourcePath, lhsName) != "" ||
               stmt.assignRootGlobalFlag:
                litGlobalLhs = true
            else:
                litSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        lhsName,
                                                        coreir.LocalStrTag)
        if !litGlobalLhs:
            if litSlot < 0:
                return false
            # var str params hold the destination address: build the literal
            # in a unique temp str slot, then store the 24-byte value back
            # through the parameter.
            var litVarParamSlot: int32 = -1
            if bodyIR.localSlots[litSlot].typeKind != coreir.LocalStrTag &&
               PrimaryBodyIrLocalIsParam(bodyIR.localSlots[litSlot]):
                litVarParamSlot = litSlot
                litSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"{lhsName}#str_var#{stmt.lineNumber}",
                                                        coreir.LocalStrTag)
                if litSlot < 0:
                    return false
            if litSlot >= bodyIR.localSlots.len ||
               bodyIR.localSlots[litSlot].typeKind != coreir.LocalStrTag:
                return false
            let appendedLitValue = PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                                         slotNames,
                                                                         rhsText,
                                                                         litSlot,
                                                                         callOrdinal)
            if appendedLitValue && litVarParamSlot >= 0:
                PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                     litVarParamSlot,
                                                     litSlot,
                                                     24)
            return appendedLitValue
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_H function={typedFn.functionName} line={stmt.lineNumber}")
    let varStrParamLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
    if varStrParamLhsSlot >= 0 &&
       varStrParamLhsSlot < bodyIR.localSlots.len &&
       bodyIR.localSlots[varStrParamLhsSlot].typeKind != coreir.LocalStrTag &&
       PrimaryBodyIrLocalIsParam(bodyIR.localSlots[varStrParamLhsSlot]) &&
       stmt.assignFieldName == "":
        let varStrParamRhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                          strutil.Strip(rhsText))
        if varStrParamRhsSlot >= 0 &&
           varStrParamRhsSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, varStrParamRhsSlot) == coreir.LocalStrTag:
            PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                 varStrParamLhsSlot,
                                                 varStrParamRhsSlot,
                                                 24)
            return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_I function={typedFn.functionName} line={stmt.lineNumber}")
    if stmt.callTarget == "" &&
       len(lhsName) > 2 &&
       lhsName[len(lhsName) - 1] == ']':
        if PrimaryBodyIrAppendGlobalU8ArrayStore(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering.typedIr,
                                                 stmt.sourcePath,
                                                 lhsName,
                                                 rhsText,
                                                 callOrdinal):
            return true
        # 标量元素存储失败 → 试整槽 struct 存储(gArr[idx]=本地struct 变量)
        if PrimaryBodyIrAppendGlobalFixedArrayElemStructStore(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering.typedIr,
                                                              stmt.sourcePath,
                                                              lhsName,
                                                              rhsText,
                                                              callOrdinal):
            return true
    let lhsLocalSlotBeforeGlobal = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
    var lhsLocalShadowsGlobal = false
    if lhsLocalSlotBeforeGlobal >= 0 &&
       lhsLocalSlotBeforeGlobal < bodyIR.localSlots.len &&
       bodyIR.localSlots[lhsLocalSlotBeforeGlobal].placeKind != coreir.BodyPlaceGlobalAddressTag &&
       !stmt.assignRootGlobalFlag:
        lhsLocalShadowsGlobal = true
    var lhsGlobalType = ""
    if !lhsLocalShadowsGlobal:
        lhsGlobalType = PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt.sourcePath, lhsName)
        if lhsGlobalType == "" &&
           stmt.assignRootGlobalFlag &&
           stmt.assignRootType != "":
            lhsGlobalType = stmt.assignRootType
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_J function={typedFn.functionName} line={stmt.lineNumber}")
    if lhsGlobalType != "" && stmt.assignFieldName == "":
        var lhsGlobalTypeKind: int32
        var lhsGlobalTypeSizeBytes: int32
        var lhsGlobalTypeAlignBytes: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       stmt.sourcePath,
                                       lhsGlobalType,
                                       lhsGlobalTypeKind,
                                       lhsGlobalTypeSizeBytes,
                                       lhsGlobalTypeAlignBytes)
        var lhsGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr, stmt.sourcePath, lhsName)
        if lhsGlobalSlotName == "" &&
           stmt.assignRootGlobalFlag &&
           stmt.assignRootSourcePath != "":
            lhsGlobalSlotName = Fmt"{stmt.assignRootSourcePath}::{lhsName}"
        if lhsGlobalSlotName == "":
            return false
        if lhsGlobalTypeKind == coreir.LocalAggregateTag &&
           stmt.rhsNodeIndex >= 0 &&
           stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpEmptySeqInit &&
           lhsGlobalTypeSizeBytes == 16:
            let emptySeqGlobalSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                        slotNames,
                                                                        lhsGlobalSlotName,
                                                                        lhsGlobalTypeKind,
                                                                        lhsGlobalTypeSizeBytes,
                                                                        lhsGlobalTypeAlignBytes)
            let emptySeqValueSlot = PrimaryBodyIrEvalNode(
                bodyIR,
                slotNames,
                varI32ParamNames,
                lowering,
                typedFn,
                irFunction,
                stmt.rhsNodeIndex,
                callOrdinal)
            if emptySeqGlobalSlot >= 0 && emptySeqValueSlot >= 0:
                bodyIR.localSlots[emptySeqGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                if PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                         lowering,
                                                         emptySeqGlobalSlot,
                                                         emptySeqValueSlot,
                                                         PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                             lowering.typedIr, stmt.rhsNodeIndex),
                                                         callOrdinal):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=empty_seq_init function={typedFn.functionName} line={stmt.lineNumber}")
                    return true
            let _ = PrimaryBodyIrNodeEvalMissAt("empty_seq_zero")
            return false
        # Field-to-global assignment consumes the exact field layout before
        # generic aggregate node-eval or generic str name lookup. An unsized
        # value slot here would copy uninitialized tail bytes into the global.
        let fieldGlobalAuthorityComplete =
            stmt.assignValueFieldName != "" &&
            stmt.assignValueRootName != "" &&
            stmt.assignValueRootType != "" &&
            stmt.assignValueFieldType != "" &&
            stmt.assignValueFieldOffsetBytes >= 0 &&
            stmt.assignValueFieldSizeBytes > 0 &&
            stmt.assignValueFieldAlignBytes > 0
        if stmt.rhsNodeIndex >= 0 &&
           stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpFieldGet &&
           fieldGlobalAuthorityComplete &&
           (lhsGlobalTypeKind == coreir.LocalStrTag ||
            lhsGlobalTypeKind == coreir.LocalAggregateTag):
            let rhsFieldTypeSourceRes: Result[str] = langintern.LookupIntern(
                lowering.typedIr.internPool,
                lowering.typedIr.nodes2_fieldTypeSourcePathIds[stmt.rhsNodeIndex])
            let rhsFieldNodeTypeRes: Result[str] = langintern.LookupIntern(
                lowering.typedIr.internPool,
                lowering.typedIr.nodes2_resultTypeIds[stmt.rhsNodeIndex])
            if !IsOk(rhsFieldTypeSourceRes) || Value(rhsFieldTypeSourceRes) == "" ||
               !IsOk(rhsFieldNodeTypeRes) || Value(rhsFieldNodeTypeRes) == "" ||
               texpr.TypedExprNormalizeTypeText(Value(rhsFieldNodeTypeRes)) !=
                   texpr.TypedExprNormalizeTypeText(stmt.assignValueFieldType):
                panic(Fmt"backend2: field-to-global type owner unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
            let rhsFieldTypeSourcePath = Value(rhsFieldTypeSourceRes)
            let rhsFieldNodeType = Value(rhsFieldNodeTypeRes)
            let rhsFieldSizeBytes = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldSizeBytes,
                stmt.rhsNodeIndex)
            let rhsFieldAlignBytes = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldAlignBytes,
                stmt.rhsNodeIndex)
            var rhsFieldKind: int32
            var resolvedRhsFieldSizeBytes: int32
            var resolvedRhsFieldAlignBytes: int32
            PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                           rhsFieldTypeSourcePath,
                                           rhsFieldNodeType,
                                           rhsFieldKind,
                                           resolvedRhsFieldSizeBytes,
                                           resolvedRhsFieldAlignBytes)
            if rhsFieldKind != lhsGlobalTypeKind ||
               rhsFieldSizeBytes <= 0 || rhsFieldAlignBytes <= 0 ||
               resolvedRhsFieldSizeBytes != rhsFieldSizeBytes ||
               resolvedRhsFieldAlignBytes != rhsFieldAlignBytes ||
               rhsFieldSizeBytes != stmt.assignValueFieldSizeBytes ||
               rhsFieldSizeBytes != lhsGlobalTypeSizeBytes ||
               rhsFieldAlignBytes != stmt.assignValueFieldAlignBytes ||
               rhsFieldAlignBytes != lhsGlobalTypeAlignBytes:
                panic(Fmt"backend2: field-to-global layout mismatch source={stmt.sourcePath} line={stmt.lineNumber} lhs={lhsGlobalType} rhs={rhsFieldNodeType} rhs_owner={rhsFieldTypeSourcePath} lhs_kind={lhsGlobalTypeKind} rhs_kind={rhsFieldKind} lhs_size={lhsGlobalTypeSizeBytes} rhs_size={rhsFieldSizeBytes} resolved_rhs_size={resolvedRhsFieldSizeBytes} field_size={stmt.assignValueFieldSizeBytes} lhs_align={lhsGlobalTypeAlignBytes} rhs_align={rhsFieldAlignBytes} resolved_rhs_align={resolvedRhsFieldAlignBytes} field_align={stmt.assignValueFieldAlignBytes}")
            let fieldGlobalValueSlot = PrimaryBodyIrFindOrCreateSlotSized(
                bodyIR,
                slotNames,
                Fmt"#global_field_value#{stmt.lineNumber}",
                rhsFieldKind,
                rhsFieldSizeBytes,
                rhsFieldAlignBytes)
            if fieldGlobalValueSlot < 0 ||
               fieldGlobalValueSlot >= bodyIR.localSlots.len ||
               PrimaryBodyIrSlotType(bodyIR, fieldGlobalValueSlot) != rhsFieldKind ||
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[fieldGlobalValueSlot]) != rhsFieldSizeBytes ||
               bodyIR.localSlots[fieldGlobalValueSlot].alignBytes != rhsFieldAlignBytes:
                panic(Fmt"backend2: exact field value slot unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
            if lhsGlobalTypeKind == coreir.LocalStrTag ||
               PrimaryBodyIrTypeTextIsDynamicSeq(lhsGlobalType):
                panic("backend2: managed field-to-global load requires immutable producer value-def admission")
            if !PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                                   slotNames,
                                                   lowering.typedIr,
                                                   stmt.sourcePath,
                                                   stmt.assignValueRootName,
                                                   stmt.assignValueRootType,
                                                   stmt.assignValueFieldOffsetBytes,
                                                   stmt.assignValueFieldSizeBytes,
                                                   fieldGlobalValueSlot):
                panic(Fmt"backend2: exact field load unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
            let fieldGlobalDestSlot = PrimaryBodyIrFindOrCreateSlotSized(
                bodyIR,
                slotNames,
                lhsGlobalSlotName,
                lhsGlobalTypeKind,
                lhsGlobalTypeSizeBytes,
                lhsGlobalTypeAlignBytes)
            if fieldGlobalDestSlot < 0 ||
               fieldGlobalDestSlot >= bodyIR.localSlots.len ||
               PrimaryBodyIrSlotType(bodyIR, fieldGlobalDestSlot) != lhsGlobalTypeKind ||
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[fieldGlobalDestSlot]) != lhsGlobalTypeSizeBytes ||
               bodyIR.localSlots[fieldGlobalDestSlot].alignBytes != lhsGlobalTypeAlignBytes:
                panic(Fmt"backend2: exact field global slot unavailable source={stmt.sourcePath} line={stmt.lineNumber} global={lhsName}")
            bodyIR.localSlots[fieldGlobalDestSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
            if lhsGlobalTypeKind == coreir.LocalStrTag ||
               PrimaryBodyIrTypeTextIsDynamicSeq(lhsGlobalType):
                if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                           lowering,
                                                           fieldGlobalDestSlot,
                                                           fieldGlobalValueSlot,
                                                           PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                               lowering.typedIr, stmt.rhsNodeIndex),
                                                           callOrdinal):
                    panic(Fmt"backend2: managed field-to-global store unavailable source={stmt.sourcePath} line={stmt.lineNumber} type={lhsGlobalType}")
            else:
                var fieldHasManaged: bool
                if !texpr.TypedExprIrTypeContainsManagedStorage(lowering.typedIr,
                                                                 stmt.sourcePath,
                                                                 lhsGlobalType,
                                                                 fieldHasManaged) ||
                   fieldHasManaged:
                    panic(Fmt"backend2: unsupported managed aggregate field-to-global store source={stmt.sourcePath} line={stmt.lineNumber} type={lhsGlobalType}")
                var fieldGlobalStoreOp: coreir.BodyOp
                fieldGlobalStoreOp.kind = coreir.BodyOpGlobalStoreTag
                fieldGlobalStoreOp.target = fieldGlobalValueSlot
                add(fieldGlobalStoreOp.operands, fieldGlobalDestSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, fieldGlobalStoreOp)
            return true
        # `gAgg = box.paths` / `gAgg = src` : whole-aggregate global store from a
        # node-materializable value (struct field-get, seq[i], local aggregate).
        # The scalar global-store path below only handles i32/i64/ptr/str; an
        # aggregate (seq header / nested struct) needs the value materialized by
        # the node-eval emitter and copied byte-for-byte into the global data
        # label. Mirror the EmptySeqInit branch's GlobalAddress dest slot, then
        # emit a GlobalStore that memcpy's the exact aggregate width (handled in
        # PrimaryBodyIRFillGlobalStoreOp's aggregate branch).
        if lhsGlobalTypeKind == coreir.LocalAggregateTag &&
           stmt.rhsNodeIndex >= 0 &&
           stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr:
            PrimaryBodyIrNodeEvalMissOpReset()
            let aggGlobalProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                stmt.rhsNodeIndex)
            if aggGlobalProbeKind == coreir.LocalAggregateTag:
                let aggGlobalValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering,
                                                               typedFn,
                                                               irFunction,
                                                               stmt.rhsNodeIndex,
                                                               callOrdinal)
                if aggGlobalValueSlot >= 0 &&
                   PrimaryBodyIrSlotType(bodyIR, aggGlobalValueSlot) == coreir.LocalAggregateTag &&
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[aggGlobalValueSlot]) == lhsGlobalTypeSizeBytes:
                    let aggGlobalDestSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                              slotNames,
                                                                              lhsGlobalSlotName,
                                                                              lhsGlobalTypeKind,
                                                                              lhsGlobalTypeSizeBytes,
                                                                              lhsGlobalTypeAlignBytes)
                    if aggGlobalDestSlot >= 0:
                        bodyIR.localSlots[aggGlobalDestSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                        if PrimaryBodyIrTypeTextIsDynamicSeq(lhsGlobalType):
                            if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                                       lowering,
                                                                       aggGlobalDestSlot,
                                                                       aggGlobalValueSlot,
                                                                       PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                                           lowering.typedIr, stmt.rhsNodeIndex),
                                                                       callOrdinal):
                                panic(Fmt"backend2: managed aggregate global store unavailable source={stmt.sourcePath} line={stmt.lineNumber} type={lhsGlobalType}")
                        else:
                            var aggHasManaged: bool
                            if !texpr.TypedExprIrTypeContainsManagedStorage(lowering.typedIr,
                                                                             stmt.sourcePath,
                                                                             lhsGlobalType,
                                                                             aggHasManaged) ||
                               aggHasManaged:
                                panic(Fmt"backend2: unsupported managed aggregate global store source={stmt.sourcePath} line={stmt.lineNumber} type={lhsGlobalType}")
                            var aggGlobalStoreOp: coreir.BodyOp
                            aggGlobalStoreOp.kind = coreir.BodyOpGlobalStoreTag
                            aggGlobalStoreOp.target = aggGlobalValueSlot
                            add(aggGlobalStoreOp.operands, aggGlobalDestSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, aggGlobalStoreOp)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_global_aggregate function={typedFn.functionName} line={stmt.lineNumber}")
                        return true
            let _ = PrimaryBodyIrNodeEvalMissAt("global_aggregate_store")
            return false
        if lhsGlobalTypeKind != coreir.LocalI32Tag &&
           lhsGlobalTypeKind != coreir.LocalI64Tag &&
           lhsGlobalTypeKind != coreir.LocalPtrTag &&
           lhsGlobalTypeKind != coreir.LocalStrTag:
            return false
        var valueSlot: int32
        valueSlot = -1
        if lhsGlobalTypeKind == coreir.LocalI32Tag && assignLogicalRoot:
            let boolGlobalValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"{lhsName}#global_bool_value#{stmt.lineNumber}",
                                                                    coreir.LocalI32Tag)
            if boolGlobalValueSlot < 0:
                return false
            var boolGlobalBlockStart = currentBlockStart
            if !PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                       slotNames,
                                                       lowering,
                                                       typedFn,
                                                       irFunction,
                                                       stmt.sourcePath,
                                                       stmt.lineNumber,
                                                       stmt.rhsNodeIndex,
                                                       rhsText,
                                                       boolGlobalValueSlot,
                                                       callOrdinal,
                                                       boolGlobalBlockStart):
                return false
            currentBlockStart = boolGlobalBlockStart
            valueSlot = boolGlobalValueSlot
        if valueSlot < 0 && PrimaryBodyIrTextHasCallSurface(rhsText):
            let callValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"{lhsName}#global_call_value#{stmt.lineNumber}",
                                                              lhsGlobalTypeKind)
            if callValueSlot >= 0 &&
               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                       slotNames,
                                                       lowering,
                                                       typedFn,
                                                       irFunction,
                                                       varI32ParamNames,
                                                       rhsText,
                                                       callValueSlot,
                                                       stmt.lineNumber,
                                                       -1,
                                                       callOrdinal):
                valueSlot = callValueSlot
        if valueSlot < 0 && stmt.assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary:
            valueSlot = PrimaryBodyIrTernaryValueSlotForStmt(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             lowering.typedIr,
                                                             stmt,
                                                             lhsGlobalTypeKind)
        elif valueSlot < 0 &&
           (stmt.assignValueOpKind == texpr.TypedExprIrOpI32Add ||
            stmt.assignValueOpKind == texpr.TypedExprIrOpI32Sub ||
            stmt.assignValueOpKind == texpr.TypedExprIrOpI32BitAnd ||
            stmt.assignValueOpKind == texpr.TypedExprIrOpI32BitOr):
            if stmt.assignValueLhsText == "" || stmt.assignValueRhsText == "":
                return false
            let leftSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               stmt.sourcePath,
                                                               stmt.assignValueLhsText,
                                                               lhsGlobalTypeKind, callOrdinal)
            let rightSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                stmt.sourcePath,
                                                                stmt.assignValueRhsText,
                                                                lhsGlobalTypeKind, callOrdinal)
            if leftSlot < 0 || rightSlot < 0:
                return false
            valueSlot = leftSlot
            var op: coreir.BodyOp
            op.kind = coreir.BodyOpBinOpTag
            op.target = valueSlot
            add(op.operands, lhsGlobalTypeKind)
            add(op.operands, int32(stmt.assignValueOpKind))
            add(op.operands, leftSlot)
            add(op.operands, rightSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, op)
        elif valueSlot < 0 && lhsGlobalTypeKind == coreir.LocalStrTag:
            if PrimaryBodyIrTextIsStringLiteral(rhsText):
                valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"{lhsName}#global_str_value#{stmt.lineNumber}",
                                                           coreir.LocalStrTag)
                if valueSlot < 0 ||
                   !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                          slotNames,
                                                          rhsText,
                                                          valueSlot,
                                                          callOrdinal):
                    return false
            else:
                valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
                if valueSlot < 0:
                    valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                   slotNames,
                                                                   lowering.typedIr,
                                                                   stmt.sourcePath,
                                                                   rhsText,
                                                                   lhsGlobalType)
        elif valueSlot < 0 &&
             stmt.assignValueFieldName != "" &&
             stmt.assignValueRootName != "" &&
             stmt.assignValueRootType != "" &&
             stmt.assignValueFieldSizeBytes > 0 &&
             (lhsGlobalTypeKind == coreir.LocalI32Tag ||
              lhsGlobalTypeKind == coreir.LocalI64Tag ||
              lhsGlobalTypeKind == coreir.LocalPtrTag):
            # `gInt64 = aggParam.scalarField`(如 gGlobal = csg.logicalPayloadBytes):
            # 聚合参数标量字段读入全局标量。前端已把 root/field/offset/size 解析进
            # assignValue* 元数据,但既有标量值路径(ScalarValueSlotForText 只认 str/
            # var-str-param .len)丢弃它 → return false → node_path_skip。直接复用
            # FieldLoad 原语读字段进值槽,下面既有 GlobalStore 落全局、宽度适配处理 i32/i64。
            let fieldValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"#global_field_value#{stmt.lineNumber}",
                                                              lhsGlobalTypeKind)
            if fieldValueSlot >= 0 &&
               PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                                  slotNames,
                                                  lowering.typedIr,
                                                  stmt.sourcePath,
                                                  stmt.assignValueRootName,
                                                  stmt.assignValueRootType,
                                                  stmt.assignValueFieldOffsetBytes,
                                                  stmt.assignValueFieldSizeBytes,
                                                  fieldValueSlot):
                valueSlot = fieldValueSlot
        elif valueSlot < 0:
            valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering.typedIr,
                                                            stmt.sourcePath,
                                                            rhsText,
                                                            lhsGlobalTypeKind, callOrdinal)
            # `gInt = someSeq.len`: the scalar value path only knows str /
            # var-str-param `.len`; a plain seq `.len` (any element type) has
            # no value slot there. Resolve it through the seq-len helper, which
            # FieldLoads len from the seq header (offset 0) regardless of the
            # element type — the real value the global-store below needs.
            if valueSlot < 0 && lhsGlobalTypeKind == coreir.LocalI32Tag:
                valueSlot = PrimaryBodyIrSeqLenValueSlot(bodyIR,
                                                         slotNames,
                                                         lowering.typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         stmt.lineNumber,
                                                         rhsText)
        if valueSlot < 0:
            B2PrimaryObjectPlanTrace(strutil.Join(["phase=assign_global_value_slot_missing function=",
                                                 strings.CloneStr(typedFn.functionName),
                                                 " line=",
                                                 strings.IntToStr(stmt.lineNumber),
                                                 " lhs=",
                                                 strings.CloneStr(lhsName),
                                                 " rhs=",
                                                 strings.CloneStr(rhsText),
                                                 " op=",
                                                 strings.IntToStr(int32(stmt.assignValueOpKind))], ""))
            return false
        let globalSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       lhsGlobalSlotName,
                                                       lhsGlobalTypeKind)
        bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
        if PrimaryBodyIrSlotType(bodyIR, valueSlot) != lhsGlobalTypeKind &&
           (lhsGlobalTypeKind == coreir.LocalI32Tag ||
            lhsGlobalTypeKind == coreir.LocalI64Tag ||
            lhsGlobalTypeKind == coreir.LocalPtrTag) &&
           (PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalI32Tag ||
            PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalI64Tag ||
            PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalPtrTag):
            # Width-adapt the value to the global's slot kind (shared const-text
            # slots may carry a different int width).
            let globalAdaptSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                Fmt"#global_store_adapt#{bodyIR.ops.len}",
                                                                lhsGlobalTypeKind)
            if globalAdaptSlot < 0:
                return false
            var globalAdaptOp: coreir.BodyOp
            globalAdaptOp.kind = coreir.BodyOpCopyLocalTag
            globalAdaptOp.target = globalAdaptSlot
            add(globalAdaptOp.operands, valueSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, globalAdaptOp)
            valueSlot = globalAdaptSlot
        if lhsGlobalTypeKind == coreir.LocalStrTag:
            if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                       lowering,
                                                       globalSlot,
                                                       valueSlot,
                                                       PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                           lowering.typedIr, stmt.rhsNodeIndex),
                                                       callOrdinal):
                panic(Fmt"backend2: managed string global store unavailable source={stmt.sourcePath} line={stmt.lineNumber}")
        else:
            var storeOp: coreir.BodyOp
            storeOp.kind = coreir.BodyOpGlobalStoreTag
            storeOp.target = valueSlot
            add(storeOp.operands, globalSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_global_scalar function={typedFn.functionName} line={stmt.lineNumber}")
        return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_K function={typedFn.functionName} line={stmt.lineNumber}")
    if stmt.assignFieldName == "" &&
       stmt.assignValueFieldName != "":
        if PrimaryBodyIrTextHasFieldOrIndex(lhsName):
            return false
        let lhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
        let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              stmt.sourcePath,
                                                              stmt.assignValueRootName,
                                                              stmt.assignValueRootType)
        let byteCount = stmt.assignValueFieldSizeBytes
        var primaryColdCond13: bool
        if lhsSlot < 0:
            primaryColdCond13 = true
        if baseSlot < 0:
            primaryColdCond13 = true
        if byteCount <= 0:
            primaryColdCond13 = true
        if PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsSlot]) < byteCount:
            primaryColdCond13 = true
        if primaryColdCond13:
            return false
        var loadOp: coreir.BodyOp
        loadOp.kind = coreir.BodyOpFieldLoadTag
        loadOp.target = lhsSlot
        add(loadOp.operands, baseSlot)
        add(loadOp.operands, lhsSlot)
        add(loadOp.operands, stmt.assignValueFieldOffsetBytes)
        add(loadOp.operands, byteCount)
        let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
        return true
    if B2PrimaryObjectPlanProgressEnabled():
        B2PrimaryObjectPlanProgress(Fmt"assign_mark_L function={typedFn.functionName} line={stmt.lineNumber}")
    if stmt.assignFieldName != "":
        var assignRootType = strings.CloneStr(stmt.assignRootType)
        if assignRootType == "" ||
           assignRootType == "unknown" ||
           !B2PrimaryObjectMetadataTextStable(assignRootType):
            assignRootType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                             typedFn,
                                                             irFunction,
                                                             stmt.lineNumber,
                                                             stmt.assignRootName)
        if assignRootType == "" ||
           assignRootType == "unknown" ||
           !B2PrimaryObjectMetadataTextStable(assignRootType):
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"assign_field_root_unstable function={typedFn.functionName} line={stmt.lineNumber} root={stmt.assignRootName} root_type_len={assignRootType.len}")
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         710,
                                         0)
            return true
        var assignFieldType = strings.CloneStr(stmt.assignFieldType)
        var assignFieldOffsetBytes = stmt.assignFieldOffsetBytes
        var assignFieldSizeBytes = stmt.assignFieldSizeBytes
        var assignFieldAlignBytes: int32
        var assignLookupFieldName = strings.CloneStr(stmt.assignFieldName)
        var assignLookupIndexText = ""
        var assignLookupIsIndexed = false
        if PrimaryBodyIrIndexExprParts(stmt.assignFieldName,
                                       assignLookupFieldName,
                                       assignLookupIndexText):
            assignLookupIsIndexed = true
        # Rescue: a local declared `var e: typeof(seq[0])` carries an opaque
        # typeof(...) root type whose anonymous-tuple element field metadata is
        # unreachable to the recovery lookup below (which also sees the field
        # name cleared for a non-indexed field). Resolve typeof to its concrete
        # element type + re-derive field meta via stmt.assignFieldName, so
        # `e.field = rhs` lowers instead of bailing 711. Add-only.
        if assignFieldType == "" &&
           len(assignRootType) >= 9 &&
           strings.SliceBytes(assignRootType, 0, 7) == "typeof(" &&
           strings.SliceBytes(assignRootType, len(assignRootType) - 1, 1) == ")":
            let typeofResolvedRoot = PrimaryBodyIrResolveTypeOfTypeText(lowering.typedIr,
                                                                         typedFn,
                                                                         irFunction,
                                                                         stmt.lineNumber,
                                                                         assignRootType)
            if typeofResolvedRoot != "" &&
               PrimaryBodyIrTupleFieldMeta(lowering.typedIr,
                                            stmt.sourcePath,
                                            typeofResolvedRoot,
                                            stmt.assignFieldName,
                                            assignFieldType,
                                            assignFieldOffsetBytes,
                                            assignFieldSizeBytes,
                                            assignFieldAlignBytes):
                assignRootType = typeofResolvedRoot
        var primaryColdCond14: bool
        var primaryColdCond14Clause0: bool
        if assignRootType != "":
            if stmt.assignFieldName != "":
                if assignFieldType == "":
                    primaryColdCond14Clause0 = true
                if assignFieldType == "unknown":
                    primaryColdCond14Clause0 = true
                if !B2PrimaryObjectMetadataTextStable(assignFieldType):
                    primaryColdCond14Clause0 = true
                if assignFieldSizeBytes <= 0:
                    primaryColdCond14Clause0 = true
        if primaryColdCond14Clause0:
            primaryColdCond14 = true
        if primaryColdCond14:
            let _fieldRecovered = PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                                      stmt.sourcePath,
                                                                      assignRootType,
                                                                      assignLookupFieldName,
                                                                      assignFieldType,
                                                                      assignFieldOffsetBytes,
                                                                      assignFieldSizeBytes,
                                                                      assignFieldAlignBytes)
        # bail=711 FAIS slow-path recovery:`outline.points[1].onCurve = false`
        # (indexed sub-field 多段路径)。31181 LookupSingleFieldMeta 只解 root 内
        # 首跳字段,对 `arr[idx].sub` 多段名 miss → assignFieldType 留空 → 既有 711。
        # fast-path 22660-22694 已有等价 leaf-meta 复原,但当 root 类型经 31021
        # BindingTypeForName 兜回(stmt-cached 漏)时落此 slow-path,需此处镜像。
        # 钻 FAIS shape leaf meta(arrayField → 元素类型 → 叶子 sub-field 元),
        # 全验通后 materialize RHS scalar 值,再走既有 FieldArrayIndexedSubFieldStore。
        # G1 严等:value slot 类型必须 == leaf sub-field kind 且 slot 字节宽 >= subSize。
        # Poison-on-miss:任一前置不满足 fall-through 既有 711,无静默落穿。
        # Scalar leaf 限 I32/I64/Ptr,Aggregate/Str leaf 仍走 711。
        var faisSlowArrayField = ""
        var faisSlowIndexText = ""
        var faisSlowSubField = ""
        if (assignFieldType == "" ||
            assignFieldType == "unknown" ||
            !B2PrimaryObjectMetadataTextStable(assignFieldType) ||
            assignFieldSizeBytes <= 0) &&
           PrimaryBodyIrFieldArrayIndexedSubFieldParts(stmt.assignFieldName,
                                                      faisSlowArrayField,
                                                      faisSlowIndexText,
                                                      faisSlowSubField):
            var faisSlowArrayType = ""
            var faisSlowArrayOffset: int32
            var faisSlowArraySize: int32
            var faisSlowArrayAlign: int32
            if PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                  stmt.sourcePath,
                                                  assignRootType,
                                                  faisSlowArrayField,
                                                  faisSlowArrayType,
                                                  faisSlowArrayOffset,
                                                  faisSlowArraySize,
                                                  faisSlowArrayAlign) &&
               faisSlowArraySize > 0 &&
               faisSlowArrayOffset >= 0 &&
               B2PrimaryObjectMetadataTextStable(faisSlowArrayType):
                let faisSlowElemType = PrimaryBodyIrIndexedElementTypeText(faisSlowArrayType)
                var faisSlowElemKind: int32
                var faisSlowElemSize: int32
                var faisSlowElemAlign: int32
                if faisSlowElemType != "" &&
                   B2PrimaryObjectMetadataTextStable(faisSlowElemType):
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   stmt.sourcePath,
                                                   faisSlowElemType,
                                                   faisSlowElemKind,
                                                   faisSlowElemSize,
                                                   faisSlowElemAlign)
                var faisSlowSubType = ""
                var faisSlowSubOffset: int32
                var faisSlowSubSize: int32
                var faisSlowSubAlign: int32
                if faisSlowElemKind == coreir.LocalAggregateTag &&
                   faisSlowElemSize > 0 &&
                   PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                     stmt.sourcePath,
                                                     faisSlowElemType,
                                                     faisSlowSubField,
                                                     faisSlowSubType,
                                                     faisSlowSubOffset,
                                                     faisSlowSubSize,
                                                     faisSlowSubAlign) &&
                   faisSlowSubSize > 0 &&
                   faisSlowSubOffset >= 0 &&
                   faisSlowSubOffset + faisSlowSubSize <= faisSlowElemSize &&
                   B2PrimaryObjectMetadataTextStable(faisSlowSubType):
                    let faisSlowSubKind = PrimaryBodyIrTypeKindFromText(faisSlowSubType)
                    if faisSlowSubKind == coreir.LocalI32Tag ||
                       faisSlowSubKind == coreir.LocalI64Tag ||
                       faisSlowSubKind == coreir.LocalPtrTag:
                        let faisSlowValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                    slotNames,
                                                                                    varI32ParamNames,
                                                                                    lowering.typedIr,
                                                                                    stmt.sourcePath,
                                                                                    rhsText,
                                                                                    faisSlowSubKind,
                                                                                    callOrdinal)
                        if faisSlowValueSlot >= 0 &&
                           PrimaryBodyIrSlotType(bodyIR, faisSlowValueSlot) == faisSlowSubKind &&
                           PrimaryLocalSlotSizeOf(bodyIR.localSlots[faisSlowValueSlot]) >= faisSlowSubSize:
                            if PrimaryBodyIrAppendFieldArrayIndexedSubFieldStore(bodyIR,
                                                                                 slotNames,
                                                                                 varI32ParamNames,
                                                                                 lowering.typedIr,
                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 stmt.sourcePath,
                                                                                 stmt.lineNumber,
                                                                                 stmt.assignRootName,
                                                                                 assignRootType,
                                                                                 stmt.assignFieldName,
                                                                                 faisSlowValueSlot,
                                                                                 callOrdinal):
                                if B2PrimaryObjectPlanProgressEnabled():
                                    B2PrimaryObjectPlanProgress(Fmt"assign_field_fais_slow_recovered function={typedFn.functionName} line={stmt.lineNumber} arr={faisSlowArrayField} sub={faisSlowSubField} sub_off={faisSlowSubOffset} sub_sz={faisSlowSubSize}")
                                return true
        if assignFieldType == "" ||
           assignFieldType == "unknown" ||
           !B2PrimaryObjectMetadataTextStable(assignFieldType):
            B2PrimaryObjectPlanGuardTick()
            if B2PrimaryObjectPlanProgressEnabled():
                B2PrimaryObjectPlanProgress(Fmt"assign_field_type_unstable function={typedFn.functionName} line={stmt.lineNumber} field={stmt.assignFieldName} field_type_len={assignFieldType.len}")
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         711,
                                         assignFieldSizeBytes)
            return true
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_begin function={typedFn.functionName} line={stmt.lineNumber} root={stmt.assignRootName} root_type_len={assignRootType.len} field={stmt.assignFieldName} field_type={assignFieldType} rhs={rhsText}")
        let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              stmt.sourcePath,
                                                              stmt.assignRootName,
                                                              assignRootType)
        B2PrimaryObjectPlanGuardTick()
        if B2PrimaryObjectPlanProgressEnabled():
            B2PrimaryObjectPlanProgress(Fmt"assign_field_base_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot}")
        var byteCount = assignFieldSizeBytes
        if baseSlot < 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         710,
                                         0)
            return true
        if byteCount <= 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         711,
                                         byteCount)
            return true
        var indexedFieldName = ""
        var indexedFieldIndexText = ""
        if assignLookupIsIndexed:
            indexedFieldName = assignLookupFieldName
            indexedFieldIndexText = assignLookupIndexText
            # Nested `arr[i].field[j] = v`: the structured root dropped the outer
            # `[i]`, so the field-array store below would write element 0's field
            # (silent miscompile). Recover the outer index from bindingName and
            # store at the real element's field-array address; poison — never
            # drop — when the nested shape is not a clean fixed/fixed nesting.
            var nestedOuterIdxText = ""
            if PrimaryBodyIrAssignLhsRootIndexText(stmt.bindingName, stmt.assignRootName, nestedOuterIdxText):
                if PrimaryBodyIrAppendNestedFixedArrayIndexedFieldStore(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        typedFn,
                                                                        irFunction,
                                                                        stmt.sourcePath,
                                                                        stmt.lineNumber,
                                                                        stmt.assignRootName,
                                                                        assignRootType,
                                                                        nestedOuterIdxText,
                                                                        indexedFieldName,
                                                                        indexedFieldIndexText,
                                                                        rhsText,
                                                                        baseSlot,
                                                                        varI32ParamNames,
                                                                        callOrdinal):
                    B2PrimaryObjectPlanGuardTick()
                    if B2PrimaryObjectPlanProgressEnabled():
                        B2PrimaryObjectPlanProgress(Fmt"assign_field_nested_indexed_done function={typedFn.functionName} line={stmt.lineNumber} field={indexedFieldName} outer={nestedOuterIdxText} inner={indexedFieldIndexText}")
                    return true
                B2PrimaryObjectPlanGuardTick()
                if B2PrimaryObjectPlanProgressEnabled():
                    B2PrimaryObjectPlanProgress(Fmt"assign_field_nested_indexed_poison function={typedFn.functionName} line={stmt.lineNumber} field={indexedFieldName} outer={nestedOuterIdxText} inner={indexedFieldIndexText}")
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             726,
                                             0)
                return true
            var indexedFieldType = strings.CloneStr(assignFieldType)
            var indexedFieldOffsetBytes = assignFieldOffsetBytes
            var indexedFieldSizeBytes = assignFieldSizeBytes
            var indexedFieldAlignBytes = assignFieldAlignBytes
            if indexedFieldType == "" ||
               indexedFieldType == "unknown" ||
               !B2PrimaryObjectMetadataTextStable(indexedFieldType) ||
               indexedFieldSizeBytes <= 0:
                let _indexedFieldRecovered = PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                                                 stmt.sourcePath,
                                                                                 assignRootType,
                                                                                 indexedFieldName,
                                                                                 indexedFieldType,
                                                                                 indexedFieldOffsetBytes,
                                                                                 indexedFieldSizeBytes,
                                                                                 indexedFieldAlignBytes)
            var indexedElemKind: int32
            var indexedElemSize: int32
            if PrimaryBodyIrSeqElementShapeFromText(lowering.typedIr,
                                                    stmt.sourcePath,
                                                    indexedFieldType,
                                                    indexedElemKind,
                                                    indexedElemSize):
                let indexedFieldIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(indexedFieldType)
                let indexedSeqSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        stmt.sourcePath,
                                                                        Fmt"{stmt.assignRootName}.{indexedFieldName}#field_seq#{stmt.lineNumber}",
                                                                        indexedFieldType)
                if indexedSeqSlot < 0 ||
                   indexedFieldOffsetBytes < 0 ||
                   indexedFieldSizeBytes <= 0:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 715,
                                                 indexedFieldSizeBytes)
                    return true
                # 跨模块 const 维度定长数组字段:类型文本定形可能因 const 维未解析把
                # field_seq 槽建小(slotSize < 权威 indexedFieldSizeBytes)。前端给出的
                # indexedFieldSizeBytes 是权威值——按它把该槽 grow 到位(LocalAggregateTag,
                # FindOrCreateSlotSized 按同名找到既有槽并扩容+reflow),而非 715 bail。
                # 镜像 7cfc32d7b「补一个 size 分支」;const 维字段元素存储族共享此 size
                # -mismatch trip,一处清整族。动态 seq 字段槽恒 8B 不触发本分支。
                if PrimaryLocalSlotSizeOf(bodyIR.localSlots[indexedSeqSlot]) < indexedFieldSizeBytes:
                    let _indexedSeqGrown = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                              slotNames,
                                                                              Fmt"{stmt.assignRootName}.{indexedFieldName}#field_seq#{stmt.lineNumber}",
                                                                              coreir.LocalAggregateTag,
                                                                              indexedFieldSizeBytes,
                                                                              indexedFieldAlignBytes)
                if !PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                                       slotNames,
                                                       lowering.typedIr,
                                                       stmt.sourcePath,
                                                       stmt.assignRootName,
                                                       assignRootType,
                                                       indexedFieldOffsetBytes,
                                                       indexedFieldSizeBytes,
                                                       indexedSeqSlot):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 716,
                                                 indexedFieldOffsetBytes)
                    return true
                # 阶段1 迁移：struct-field 下标 seq 元素存储 `box.field[block.termIndex]=v`
                # 的下标从文本派发（plain ScalarValueSlotForText i32 + Context 字段读 fallback
                # 两路）改为节点求值器 PrimaryBodyIrEvalNode(stmt.assignIndexNodeIndex)。前端
                # typed_expr:20153 以 expected int32 取 lhsText 最内层 `[...]`；此形 assignFieldName
                # 单层 bracket，IndexExprParts(assignFieldName) 取的 indexedFieldIndexText 与该最
                # 内层下标 1:1 同串。EvalNode/Probe 覆盖变量(ParamRef/LocalRef)、算术、字段读
                # (OpFieldGet，即 block.termIndex 形)，与被删 plain+Context 两路同覆盖面。
                # flatness 守卫：仅当 indexedFieldIndexText 无内层 `[`（单层下标）才走节点 —— 2D
                # 字段 `m[r][c]` 的 IndexExprParts 取首 `[` 得 `r][c`，与最内层节点 `c` 不同串，
                # 文本本就返 -1 走 717 bail；守卫令该形继续走 717 bail，不退化为误编译。
                # 探针放行 i32/i64，求值在调用已发射后失败禁止落穿（6101 毒标，同 eb5908cdf
                # 嵌套末层 / 701f2a19d 单层 index / dac2ed490 for-range 起界）。
                var indexedSlot = -1
                if stmt.assignIndexNodeIndex >= 0 &&
                   parser.ParserFindText(indexedFieldIndexText, "[") < 0:
                    let indexedIdxProbe = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering.typedIr,
                                                                     typedFn,
                                                                     irFunction,
                                                                     stmt.assignIndexNodeIndex)
                    if indexedIdxProbe == coreir.LocalI32Tag ||
                       indexedIdxProbe == coreir.LocalI64Tag:
                        let indexedIdxEmitMark = PrimaryBodyIrNodeEvalCallEmitCountNow()
                        indexedSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,
                                                            typedFn,
                                                            irFunction,
                                                            stmt.assignIndexNodeIndex,
                                                            callOrdinal)
                        if indexedSlot < 0 &&
                           PrimaryBodyIrNodeEvalCallEmitCountNow() != indexedIdxEmitMark:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         6101,
                                                         0)
                            return true
                var indexedValueText = strings.CloneStr(rhsText)
                if indexedElemSize == 1:
                    let indexedU8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
                    if indexedU8Inner != "":
                        indexedValueText = indexedU8Inner
                var indexedValueKind = indexedElemKind
                if indexedElemSize == 1:
                    indexedValueKind = coreir.LocalI32Tag
                let indexedElemTypeText = PrimaryBodyIrIndexedElementTypeText(indexedFieldType)
                # 构造器 RHS 探测:`arr[i] = Chunk(...)`(含嵌套调用时 callTarget 指向内层 fn
                # 非 ctor 头→ResolvedCallResultType 返内层返型,槽建小→grow/AppendCallOp 会留
                # 高字节 garbage 污染 crypto 重组)。探测 ctor 头后续路由 AppendAggregateConstructorToSlot
                # 逐字段物化(零初始化+全字段 FieldStore,全结构写满无 garbage)。
                var rhsIndexedAggCtor = false
                if indexedElemTypeText != "":
                    let ctorDetectOpen = texpr.TypedExprFindWholeCallOpenParen(indexedValueText)
                    if ctorDetectOpen > 0:
                        let ctorDetectClose = texpr.TypedExprFindMatchingParen(indexedValueText, ctorDetectOpen)
                        if ctorDetectClose > ctorDetectOpen && ctorDetectClose + 1 == len(indexedValueText):
                            let ctorDetectHead = strutil.Strip(strings.SliceBytes(indexedValueText, 0, ctorDetectOpen))
                            if texpr.TypedExprCallHeadIsPlainQualifiedIdent(ctorDetectHead) &&
                               PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, stmt.sourcePath, ctorDetectHead):
                                rhsIndexedAggCtor = true
                var indexedValueSlot: int32 = -1
                if indexedElemKind == coreir.LocalStrTag && rhsText == "nil":
                    indexedValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           stmt.sourcePath,
                                                                           "nil",
                                                                           coreir.LocalPtrTag, callOrdinal)
                elif indexedElemKind == coreir.LocalStrTag &&
                     PrimaryBodyIrTextIsStringLiteral(rhsText):
