# backend2_plugin_cid — CSG 取件纯值层: CID 四元组 + receipt 同构 codec (S4-A, 纯加法)。
# 设计: docs/cheng-csg-pickup-design.md §1 (四元组配方) / §3 (receipt 结构与线格式)
#       / §6 S4-A 切分。零行为变化: 本文件全部为新增导出, 无既有调用方。
#
# 铁律 (继承 backend2_cid 头注): 零 import 编译器状态 — 只允许 std / layout /
# hash256 / 同层 b2cid, 全部纯函数, 无模块级可变态; fork worker / census /
# 串行三路径逐字节同结果。IO (网络/磁盘) 不住这里 — 取件客户端层
# csg_plugin_pickup.cheng (S4-B) 是唯一持 IO 的取件入口。
#
# 命名说明: 设计 §2/§6 冻结新模块名 backend2_plugin_cid.cheng (S4-B 客户端
# `import ... as plugincid` 已按此名冻结), 故不采用 backend2_cid_receipt 别名。
#
# CID 四元组 (语义序 = 序列化序, D2 句序冻结): sourceClosureHash → compilerHash →
# targetTriple → contractVersion; 域标签 cheng.backend2.plugin.pickupcid; 逐字段
# 经 b2cid 转发别名复用同一 append 族 (Text=U32LE 字节长度前缀+UTF-8 字节,
# Fixed32=32B 直排, U32=4B LE; 无 padding 无分隔符), sha256 一次 → 小写 hex
# = pickupCid。pickupCid 是单向哈希 hex, 四元组字段的"解析"载体是 receipt
# codec (四字段逐一在册), 闭环由 BindCheck 重算比对完成。
#
# 身份守卫（设计 §1 与发布门统一）：sourceClosureHash / compilerHash 任一全零
# 都不是可发布身份，必须在 CID 构造点 hard-fail，禁止把“未知编译器”编码成
# 可命中的缓存键。构造期守卫：
#   sourceClosureHash/compilerHash 全零 → csg_pickup_cid_zero_closure_or_compiler_hash
#   targetTriple == ""     → csg_pickup_cid_empty_target_triple
#   contractVersion < 1    → csg_pickup_cid_bad_contract_version
#
# receipt 线格式 (§3, 与 §1 同一 append 族):
#   domainTag(Text="cheng.backend2.plugin.receipt") receiptFormatVersion(U32=1)
#   随后按 PluginPickupReceipt 声明序逐字段: origin(U32) pickupCidHex(Text)
#   sourceClosureHash(Fixed32) compilerHash(Fixed32) targetTriple(Text)
#   contractVersion(U32) artifactByteCount(U32) artifactSha256(Fixed32)
#   provenanceSignerId(Text) provenanceProofCid(Fixed32)。
# 同构性机械保证: Decode 严格模式 — 截断 / 尾部多余字节 / 坏域标签 / 坏格式
# 版本 / 坏 origin / 坏 cid hex / 空 triple / 坏契约版本 / 负字节数一律显式 Err
# (缺一拒收落在解码层, 不依赖调用方自觉)。Err 只表示"件不可用"; 一切校验失败
# 走 panic, 绝不用 Err 吞校验失败 (§4 不变量)。
#
# 校验门 (§4 门序冻结, VerifyGates 唯一入口): b BindCheck (quad 重算 ==
# pickupCidHex, 防跨 quad 拼贴) → c 字节门 (count ∧ sha256 逐字节, 不等即拒,
# 报文含首个不等字节偏移) → d provenance 结构不变量 (§3 表: chain 签发者非空 ∧
# proofCid 非零; local  signer=="local" ∧ proofCid==artifactSha256 自证)。CSG
# 链上 verify-proof 对接归 S4-C, 不住纯值层。
# 参数形态: 只读 rawbytes.Bytes 一律 @borrows 值传 (std 惯例, var 会要求调用方
# 出示 unique mutable authority, 对只读语义既过剩又不可证); var 仅保留给 receipt
# 结构体 (与 b2cid 校验原语同形), 本层不就地改写任何字节缓冲。

import std/result
import std/strings
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/backend2/backend2_cid as b2cid

const
    PluginPickupOriginChain: int32 = 1     # CSG 链签发
    PluginPickupOriginLocal: int32 = 2     # 本地构建
    pluginPickupReceiptFormatVersion: int32 = 1
    pluginPickupCidDomainTag: str = "cheng.backend2.plugin.pickupcid"
    pluginPickupReceiptDomainTag: str = "cheng.backend2.plugin.receipt"

type
    PluginPickupReceipt =
        origin: int32
        pickupCidHex: str                       # 自指字段, decode 后重算比对 (BindCheck)
        sourceClosureHash: layout.FixedBytes32
        compilerHash: layout.FixedBytes32
        targetTriple: str
        contractVersion: int32
        artifactByteCount: int32
        artifactSha256: layout.FixedBytes32     # 字节门锚点
        provenanceSignerId: str                 # chain: 签发者; local: 恒 "local"
        provenanceProofCid: layout.FixedBytes32 # chain: 证明对象; local: ==artifactSha256

# ---- §1 CID 四元组: 序列化 → sha256 → 小写 hex ----

@borrows
fn Backend2ComputePluginPickupCid(sourceClosureHash: layout.FixedBytes32,
                                  compilerHash: layout.FixedBytes32,
                                  targetTriple: str,
                                  contractVersion: int32): str =
    if targetTriple == "":
        panic("csg_pickup_cid_empty_target_triple")
    if contractVersion < 1:
        panic("csg_pickup_cid_bad_contract_version")
    if b2cid.Backend2CidFixed32IsZero(sourceClosureHash) ||
       b2cid.Backend2CidFixed32IsZero(compilerHash):
        panic("csg_pickup_cid_zero_closure_or_compiler_hash")
    var buf: layout.ByteBuf = layout.ByteBufInit(1024)
    b2cid.Backend2CidAppendText(buf, pluginPickupCidDomainTag)
    b2cid.Backend2CidAppendFixed32(buf, sourceClosureHash)
    b2cid.Backend2CidAppendFixed32(buf, compilerHash)
    b2cid.Backend2CidAppendText(buf, targetTriple)
    b2cid.Backend2CidAppendU32(buf, contractVersion)
    return layout.FixedBytes32Hex(b2cid.Backend2CidBufSha256(buf))

# 字节门原语 = hash256.Sha256Fixed(layout.ByteSpanFromBytes(data)) 的命名封装。
@borrows
fn Backend2ContentSha256OfBytes(data: rawbytes.Bytes): layout.FixedBytes32 =
    return hash256.Sha256Fixed(layout.ByteSpanFromBytes(data))

# ---- §3 receipt 构造 (字节门 + pickupCid + 全字段守卫, 缺一 panic) ----

@borrows
fn PluginPickupReceiptMake(origin: int32,
                           sourceClosureHash: layout.FixedBytes32,
                           compilerHash: layout.FixedBytes32,
                           targetTriple: str,
                           contractVersion: int32,
                           artifact: rawbytes.Bytes,
                           signerId: str,
                           proofCid: layout.FixedBytes32): PluginPickupReceipt =
    if origin != PluginPickupOriginChain && origin != PluginPickupOriginLocal:
        panic(Fmt"csg_pickup_receipt_bad_origin origin={origin}")
    var out: PluginPickupReceipt
    out.origin = origin
    out.sourceClosureHash = sourceClosureHash
    out.compilerHash = compilerHash
    out.targetTriple = strings.CloneStr(targetTriple)
    out.contractVersion = contractVersion
    out.artifactByteCount = rawbytes.BytesLen(artifact)
    out.artifactSha256 = Backend2ContentSha256OfBytes(artifact)
    if origin == PluginPickupOriginLocal:
        # §3 表 local 行: signer 恒 "local", proofCid == artifactSha256 (自证,
        # 确定性非零) — proofCid 由本函数派生, 调用方不供 (供了也无法先验相等)。
        if signerId != "local":
            panic("csg_pickup_provenance_local_signer_not_local")
        out.provenanceSignerId = strings.CloneStr(signerId)
        out.provenanceProofCid = out.artifactSha256
    else:
        if len(signerId) == 0:
            panic("csg_pickup_provenance_empty_signer")
        if b2cid.Backend2CidFixed32IsZero(proofCid):
            panic("csg_pickup_provenance_zero_proof_cid")
        out.provenanceSignerId = strings.CloneStr(signerId)
        out.provenanceProofCid = proofCid
    out.pickupCidHex = Backend2ComputePluginPickupCid(
        sourceClosureHash, compilerHash, targetTriple, contractVersion)
    return out

# ---- 门 b: 自指绑定 (quad 重算 == pickupCidHex, 防"新 receipt 配旧产物"拼贴) ----

@borrows
fn PluginPickupReceiptBindCheck(receipt: var PluginPickupReceipt) =
    let recomputed = Backend2ComputePluginPickupCid(
        receipt.sourceClosureHash, receipt.compilerHash,
        receipt.targetTriple, receipt.contractVersion)
    if recomputed != receipt.pickupCidHex:
        panic(Fmt"csg_pickup_cid_rebind_mismatch cid={receipt.pickupCidHex} recomputed={recomputed}")

# ---- 门 c: 字节门 (count ∧ sha256 逐字节; 不等即拒, 报文含首个不等字节偏移) ----

@borrows
fn PluginPickupByteGateCheck(artifact: rawbytes.Bytes,
                             expectedByteCount: int32,
                             expectedSha256: layout.FixedBytes32,
                             cidHex: str) =
    if rawbytes.BytesLen(artifact) != expectedByteCount:
        let actualCount = rawbytes.BytesLen(artifact)
        panic(Fmt"csg_pickup_byte_gate_count_mismatch cid={cidHex} expected={expectedByteCount} actual={actualCount}")
    let actual = hash256.Sha256Fixed(layout.ByteSpanFromBytes(artifact))
    for i in 0..<32:
        if actual.data[i] != expectedSha256.data[i]:
            let expectedByte = Int32(expectedSha256.data[i])
            let actualByte = Int32(actual.data[i])
            panic(Fmt"csg_pickup_byte_gate_mismatch cid={cidHex} offset={i} expectedByte={expectedByte} actualByte={actualByte}")

# ---- 门 d: provenance 结构不变量 (§3 表按 origin 分派; 链上 verify-proof 归 S4-C) ----

@borrows
fn PluginPickupProvenanceCheck(receipt: var PluginPickupReceipt) =
    if receipt.origin == PluginPickupOriginLocal:
        if receipt.provenanceSignerId != "local":
            panic(Fmt"csg_pickup_provenance_reject cid={receipt.pickupCidHex} origin=local bad_signer={receipt.provenanceSignerId}")
        if !layout.FixedBytes32Equal(receipt.provenanceProofCid, receipt.artifactSha256):
            panic(Fmt"csg_pickup_provenance_reject cid={receipt.pickupCidHex} origin=local proof_not_self")
        return
    if receipt.origin == PluginPickupOriginChain:
        if len(receipt.provenanceSignerId) == 0:
            panic(Fmt"csg_pickup_provenance_reject cid={receipt.pickupCidHex} origin=chain empty_signer")
        if b2cid.Backend2CidFixed32IsZero(receipt.provenanceProofCid):
            panic(Fmt"csg_pickup_provenance_reject cid={receipt.pickupCidHex} origin=chain zero_proof_cid")
        return
    let badOrigin = receipt.origin
    panic(Fmt"csg_pickup_provenance_reject cid={receipt.pickupCidHex} unknown_origin={badOrigin}")

# ---- §4 VerifyGates (门序冻结: bind → 字节门 → provenance; 任一失败 panic) ----

@borrows
fn PluginPickupVerifyGates(artifact: rawbytes.Bytes,
                           receipt: var PluginPickupReceipt) =
    PluginPickupReceiptBindCheck(receipt)
    PluginPickupByteGateCheck(
        artifact, receipt.artifactByteCount, receipt.artifactSha256,
        receipt.pickupCidHex)
    PluginPickupProvenanceCheck(receipt)

# ---- §3 codec: Encode (声明序逐字段走同一 append 族) ----

@borrows
fn PluginPickupReceiptEncode(receipt: var PluginPickupReceipt): rawbytes.Bytes =
    var buf: layout.ByteBuf = layout.ByteBufInit(512)
    b2cid.Backend2CidAppendText(buf, pluginPickupReceiptDomainTag)
    b2cid.Backend2CidAppendU32(buf, pluginPickupReceiptFormatVersion)
    b2cid.Backend2CidAppendU32(buf, receipt.origin)
    b2cid.Backend2CidAppendText(buf, receipt.pickupCidHex)
    b2cid.Backend2CidAppendFixed32(buf, receipt.sourceClosureHash)
    b2cid.Backend2CidAppendFixed32(buf, receipt.compilerHash)
    b2cid.Backend2CidAppendText(buf, receipt.targetTriple)
    b2cid.Backend2CidAppendU32(buf, receipt.contractVersion)
    b2cid.Backend2CidAppendU32(buf, receipt.artifactByteCount)
    b2cid.Backend2CidAppendFixed32(buf, receipt.artifactSha256)
    b2cid.Backend2CidAppendText(buf, receipt.provenanceSignerId)
    b2cid.Backend2CidAppendFixed32(buf, receipt.provenanceProofCid)
    var out = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    return out

# ---- §3 codec: Decode 严格模式 (游标穷尽校验; 缺字段/截断/尾部多余一律 Err) ----

@borrows
fn pluginPickupReadU32(data: rawbytes.Bytes, cursor: var int32): Result[int32] =
    if cursor < 0 || cursor > data.len || data.len - cursor < 4:
        return Err[int32]("csg_pickup_receipt_truncated")
    let off = cursor
    let b0 = rawbytes.BytesGet(data, off)
    let b1 = rawbytes.BytesGet(data, off + 1)
    let b2 = rawbytes.BytesGet(data, off + 2)
    let b3 = rawbytes.BytesGet(data, off + 3)
    cursor = off + 4
    return Ok[int32](b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

@borrows
fn pluginPickupReadText(data: rawbytes.Bytes, cursor: var int32): Result[str] =
    var lenRes = pluginPickupReadU32(data, cursor)
    if IsErr(lenRes):
        return Err[str]("csg_pickup_receipt_truncated")
    let n = Value(lenRes)
    if n < 0 || n > data.len - cursor:
        return Err[str]("csg_pickup_receipt_truncated")
    let text = rawbytes.BytesToString(rawbytes.BytesSliceView(data, cursor, n))
    cursor = cursor + n
    return Ok[str](text)

@borrows
fn pluginPickupReadFixed32(
        data: rawbytes.Bytes,
        cursor: var int32): Result[layout.FixedBytes32] =
    if cursor < 0 || cursor > data.len || data.len - cursor < 32:
        return Err[layout.FixedBytes32]("csg_pickup_receipt_truncated")
    var out: layout.FixedBytes32
    for i in 0..<32:
        out.data[i] = UInt8(rawbytes.BytesGet(data, cursor + i))
    cursor = cursor + 32
    return Ok[layout.FixedBytes32](out)

@borrows
fn PluginPickupReceiptDecode(data: rawbytes.Bytes): Result[PluginPickupReceipt] =
    var cursor = 0
    var tagRes = pluginPickupReadText(data, cursor)
    if IsErr(tagRes):
        return Err[PluginPickupReceipt](Error(tagRes))
    if Value(tagRes) != pluginPickupReceiptDomainTag:
        return Err[PluginPickupReceipt]("csg_pickup_receipt_bad_domain_tag")
    var verRes = pluginPickupReadU32(data, cursor)
    if IsErr(verRes):
        return Err[PluginPickupReceipt](Error(verRes))
    if Value(verRes) != pluginPickupReceiptFormatVersion:
        return Err[PluginPickupReceipt]("csg_pickup_receipt_bad_format_version")
    var out: PluginPickupReceipt
    var originRes = pluginPickupReadU32(data, cursor)
    if IsErr(originRes):
        return Err[PluginPickupReceipt](Error(originRes))
    out.origin = Value(originRes)
    if out.origin != PluginPickupOriginChain && out.origin != PluginPickupOriginLocal:
        return Err[PluginPickupReceipt]("csg_pickup_receipt_bad_origin")
    var cidRes = pluginPickupReadText(data, cursor)
    if IsErr(cidRes):
        return Err[PluginPickupReceipt](Error(cidRes))
    out.pickupCidHex = Value(cidRes)
    var cidParse = layout.FixedBytes32FromHex(out.pickupCidHex)
    if IsErr(cidParse):
        return Err[PluginPickupReceipt]("csg_pickup_receipt_bad_cid_hex")
    var closureRes = pluginPickupReadFixed32(data, cursor)
    if IsErr(closureRes):
        return Err[PluginPickupReceipt](Error(closureRes))
    out.sourceClosureHash = Value(closureRes)
    var compilerRes = pluginPickupReadFixed32(data, cursor)
    if IsErr(compilerRes):
        return Err[PluginPickupReceipt](Error(compilerRes))
    out.compilerHash = Value(compilerRes)
    if b2cid.Backend2CidFixed32IsZero(out.sourceClosureHash) ||
       b2cid.Backend2CidFixed32IsZero(out.compilerHash):
        return Err[PluginPickupReceipt](
            "csg_pickup_receipt_zero_closure_or_compiler_hash")
    var tripleRes = pluginPickupReadText(data, cursor)
    if IsErr(tripleRes):
        return Err[PluginPickupReceipt](Error(tripleRes))
    out.targetTriple = Value(tripleRes)
    if len(out.targetTriple) == 0:
        return Err[PluginPickupReceipt]("csg_pickup_receipt_empty_target_triple")
    var contractRes = pluginPickupReadU32(data, cursor)
    if IsErr(contractRes):
        return Err[PluginPickupReceipt](Error(contractRes))
    out.contractVersion = Value(contractRes)
    if out.contractVersion < 1:
        return Err[PluginPickupReceipt]("csg_pickup_receipt_bad_contract_version")
    var countRes = pluginPickupReadU32(data, cursor)
    if IsErr(countRes):
        return Err[PluginPickupReceipt](Error(countRes))
    out.artifactByteCount = Value(countRes)
    if out.artifactByteCount < 0:
        return Err[PluginPickupReceipt]("csg_pickup_receipt_bad_byte_count")
    var shaRes = pluginPickupReadFixed32(data, cursor)
    if IsErr(shaRes):
        return Err[PluginPickupReceipt](Error(shaRes))
    out.artifactSha256 = Value(shaRes)
    var signerRes = pluginPickupReadText(data, cursor)
    if IsErr(signerRes):
        return Err[PluginPickupReceipt](Error(signerRes))
    out.provenanceSignerId = Value(signerRes)
    var proofRes = pluginPickupReadFixed32(data, cursor)
    if IsErr(proofRes):
        return Err[PluginPickupReceipt](Error(proofRes))
    out.provenanceProofCid = Value(proofRes)
    if cursor != data.len:
        return Err[PluginPickupReceipt]("csg_pickup_receipt_trailing_bytes")
    return Ok[PluginPickupReceipt](out)
