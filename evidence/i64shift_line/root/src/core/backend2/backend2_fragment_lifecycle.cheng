# backend2_fragment_lifecycle
#
# FunctionFragment[] is the immutable handoff payload between the backend2
# worker join and canonical assembler.  The pipeline owns it first, then moves
# the single owner to the assembler.  The assembler copies the machine/object
# facts it needs into PrimaryObjectPlan and releases every fragment-owned
# sequence/string plus the outer sequence before publishing its terminal
# receipt.

import std/rawbytes
import std/os
import std/seqs
import cheng/core/backend2/backend2_types as b2t
import cheng/core/backend2/backend2_frag_codec as b2fc
import cheng/core/tooling/lifetime_ledger as lifetime
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const
    Backend2FragmentLifecyclePhaseEmpty = 0
    Backend2FragmentLifecyclePhasePipeline = 1
    Backend2FragmentLifecyclePhaseAssembler = 2
    Backend2FragmentLifecyclePhaseReleased = 3

    Backend2FragmentOutcomeAssembled = 1
    Backend2FragmentOutcomeNoLowerable = 2
    Backend2FragmentOutcomeWorkerFailure = 3
    Backend2FragmentOutcomeAssemblerFailure = 4

type
    Backend2FragmentRetainedReport =
        retainedBytes: int64
        physicalBufferCount: int32
        managedStringValueCount: int32
        managedStringBytes: int64

    Backend2FragmentLifecycle =
        ledger: lifetime.LifetimeLedger
        categoryId: int32
        pipelineOwnerId: int32
        assemblerOwnerId: int32
        objectId: int32
        functionRowCount: int32
        builtFunctionCount: int32
        phase: int32
        ownerToken: layout.FixedBytes32
        retained: Backend2FragmentRetainedReport
        auxiliaryRetainedBytes: int64
        auxiliaryPhysicalBufferCount: int32
        terminalOutcome: int32
        terminalOwnerTransferCount: int64
        terminalLedgerStorageReleasedBufferCount: int32
        terminalLedgerStorageReleasedBytes: int64
        terminalReceiptConsumed: bool

    Backend2FragmentReleaseReceipt =
        ownerToken: layout.FixedBytes32
        outcome: int32
        functionRowCount: int32
        builtFunctionCount: int32
        allocated: int64
        released: int64
        live: int64
        allocatedBytes: int64
        releasedBytes: int64
        liveBytes: int64
        ownerTransferCount: int64
        releasedBufferCount: int32
        releasedFragmentBufferCount: int32
        releasedAuxiliaryBufferCount: int32
        releasedAuxiliaryBytes: int64
        releasedManagedStringValueCount: int32
        releasedManagedStringBytes: int64
        payloadStorageReleased: bool
        auxiliaryStorageReleased: bool
        ledgerStorageReleased: bool
        ledgerStorageReleasedSequenceCount: int32
        ledgerStorageReleasedBufferCount: int32
        ledgerStorageReleasedBytes: int64

fn backend2FragmentLifecycleFail(message: str) =
    panic(message)

fn backend2FragmentCheckedAddBytes(total: var int64,
                                   value: int64) =
    if value < int64(0) ||
       total < int64(0) ||
       total > int64(9223372036854775807) - value:
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: retained byte overflow")
    total = total + value

fn backend2FragmentRecordSequence(
        out: var Backend2FragmentRetainedReport,
        capacity: int32,
        elementBytes: int64) =
    if capacity < 0 || elementBytes <= int64(0):
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: invalid sequence shape")
    if capacity == 0:
        return
    if int64(capacity) >
       int64(9223372036854775807) / elementBytes:
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: sequence byte overflow")
    out.physicalBufferCount = out.physicalBufferCount + 1
    backend2FragmentCheckedAddBytes(
        out.retainedBytes, int64(capacity) * elementBytes)

@borrows
fn backend2FragmentRecordString(
        out: var Backend2FragmentRetainedReport,
        value: str) =
    if len(value) <= 0:
        return
    out.managedStringValueCount =
        out.managedStringValueCount + 1
    backend2FragmentCheckedAddBytes(
        out.managedStringBytes, int64(len(value)))
    backend2FragmentCheckedAddBytes(
        out.retainedBytes, int64(len(value)))

fn backend2FragmentRecordStrings(
        out: var Backend2FragmentRetainedReport,
        values: var str[]) =
    backend2FragmentRecordSequence(
        out, values.cap, int64(sizeof(str)))
    for valueIndex in 0..<values.len:
        backend2FragmentRecordString(out, values[valueIndex])

fn Backend2FragmentRetained(
        fragment: var b2t.FunctionFragment):
        Backend2FragmentRetainedReport =
    var out: Backend2FragmentRetainedReport
    backend2FragmentRecordString(out, fragment.funcEmitCid)
    backend2FragmentRecordString(out, fragment.functionSymbol)
    backend2FragmentRecordSequence(
        out, fragment.words.cap, int64(sizeof(int32)))
    backend2FragmentRecordSequence(
        out, fragment.relocWordOffsets.cap, int64(sizeof(int32)))
    backend2FragmentRecordStrings(out, fragment.relocTargetSymbols)
    backend2FragmentRecordStrings(out, fragment.refSymbols)
    backend2FragmentRecordStrings(out, fragment.cstringLiterals)
    backend2FragmentRecordStrings(out, fragment.cstringDataLabels)
    backend2FragmentRecordSequence(
        out,
        fragment.cstringPayloadRawBytes.cap,
        int64(sizeof(int32)))
    backend2FragmentRecordSequence(
        out,
        fragment.cstringPayloadRawByteCounts.cap,
        int64(sizeof(int32)))
    backend2FragmentRecordSequence(
        out,
        fragment.dataRelocFnRelWordOffsets.cap,
        int64(sizeof(int32)))
    backend2FragmentRecordStrings(
        out, fragment.dataRelocTargetLabels)
    backend2FragmentRecordStrings(
        out, fragment.globalDataLabelsRaw)
    backend2FragmentRecordStrings(
        out, fragment.globalDataPayloadTexts)
    backend2FragmentRecordSequence(
        out,
        fragment.globalDataPayloadByteCounts.cap,
        int64(sizeof(int32)))
    backend2FragmentRecordString(out, fragment.bodyIrPayload)
    backend2FragmentRecordString(out, fragment.contentCid)
    return out

fn Backend2FragmentSequenceRetained(
        fragments: var b2t.FunctionFragment[]):
        Backend2FragmentRetainedReport =
    var out: Backend2FragmentRetainedReport
    backend2FragmentRecordSequence(
        out, fragments.cap, int64(sizeof(b2t.FunctionFragment)))
    for row in 0..<fragments.len:
        let retained = Backend2FragmentRetained(fragments[row])
        backend2FragmentCheckedAddBytes(
            out.retainedBytes, retained.retainedBytes)
        out.physicalBufferCount =
            out.physicalBufferCount + retained.physicalBufferCount
        out.managedStringValueCount =
            out.managedStringValueCount +
                retained.managedStringValueCount
        backend2FragmentCheckedAddBytes(
            out.managedStringBytes, retained.managedStringBytes)
    return out

fn Backend2FragmentHasOwnedPayload(
        fragment: var b2t.FunctionFragment): bool =
    let retained = Backend2FragmentRetained(fragment)
    return retained.retainedBytes > int64(0) ||
           retained.physicalBufferCount > 0 ||
           retained.managedStringValueCount > 0 ||
           retained.managedStringBytes > int64(0)

fn backend2FragmentOwnerTokenAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

fn backend2FragmentSequenceOwnerToken(
        fragments: var b2t.FunctionFragment[],
        fragmentBuilt: var bool[],
        functionIrIndexes: var int32[]): layout.FixedBytes32 =
    if fragments.len != fragmentBuilt.len ||
       (functionIrIndexes.len != 0 &&
        functionIrIndexes.len != fragments.len):
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: row shape mismatch")
    var bytes = layout.ByteBufInit(256)
    let domain = rawbytes.BytesFromString(
        "cheng.compiler.backend2.function_fragment.owner")
    layout.ByteBufAppendBytes(bytes, domain)
    backend2FragmentOwnerTokenAppendU32(bytes, fragments.len)
    for row in 0..<fragments.len:
        backend2FragmentOwnerTokenAppendU32(bytes, row)
        var builtValue: int32
        if fragmentBuilt[row]:
            builtValue = 1
        backend2FragmentOwnerTokenAppendU32(bytes, builtValue)
        var encoded = b2fc.Backend2FragmentEncode(fragments[row])
        backend2FragmentOwnerTokenAppendU32(bytes, encoded.len)
        layout.ByteBufAppendBytes(bytes, encoded)
        rawbytes.BytesFree(encoded)
    backend2FragmentOwnerTokenAppendU32(
        bytes, functionIrIndexes.len)
    for row in 0..<functionIrIndexes.len:
        backend2FragmentOwnerTokenAppendU32(
            bytes, functionIrIndexes[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    if layout.FixedBytes32Equal(out, layout.FixedBytes32()):
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: zero owner token")
    return out

fn Backend2FragmentSequenceStorageReleased(
        fragments: var b2t.FunctionFragment[],
        fragmentBuilt: var bool[],
        functionIrIndexes: var int32[]): bool =
    let retained = Backend2FragmentSequenceRetained(fragments)
    return fragments.len == 0 &&
           fragments.cap == 0 &&
           fragmentBuilt.len == 0 &&
           fragmentBuilt.cap == 0 &&
           functionIrIndexes.len == 0 &&
           functionIrIndexes.cap == 0 &&
           retained.retainedBytes == int64(0) &&
           retained.physicalBufferCount == 0 &&
           retained.managedStringValueCount == 0 &&
           retained.managedStringBytes == int64(0)

fn backend2FragmentReleaseOne(
        fragment: var b2t.FunctionFragment) =
    os.ReleaseStr(fragment.funcEmitCid)
    os.ReleaseStr(fragment.functionSymbol)
    seqs.chengSeqFreeTyped(fragment.words)
    seqs.chengSeqFreeTyped(fragment.relocWordOffsets)
    seqs.freeSeqStrRelease(fragment.relocTargetSymbols)
    seqs.freeSeqStrRelease(fragment.refSymbols)
    seqs.freeSeqStrRelease(fragment.cstringLiterals)
    seqs.freeSeqStrRelease(fragment.cstringDataLabels)
    seqs.chengSeqFreeTyped(fragment.cstringPayloadRawBytes)
    seqs.chengSeqFreeTyped(fragment.cstringPayloadRawByteCounts)
    seqs.chengSeqFreeTyped(fragment.dataRelocFnRelWordOffsets)
    seqs.freeSeqStrRelease(fragment.dataRelocTargetLabels)
    seqs.freeSeqStrRelease(fragment.globalDataLabelsRaw)
    seqs.freeSeqStrRelease(fragment.globalDataPayloadTexts)
    seqs.chengSeqFreeTyped(fragment.globalDataPayloadByteCounts)
    os.ReleaseStr(fragment.bodyIrPayload)
    os.ReleaseStr(fragment.contentCid)
    fragment.wordCount = 0
    fragment = b2t.FunctionFragment()

fn Backend2FragmentLifecycleBegin(
        state: var Backend2FragmentLifecycle,
        fragments: var b2t.FunctionFragment[],
        fragmentBuilt: var bool[],
        functionIrIndexes: var int32[]) =
    if state.phase != Backend2FragmentLifecyclePhaseEmpty ||
       state.terminalReceiptConsumed ||
       fragments.len != fragmentBuilt.len ||
       (functionIrIndexes.len != 0 &&
        functionIrIndexes.len != fragments.len):
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: invalid begin")
    state.retained = Backend2FragmentSequenceRetained(fragments)
    if fragmentBuilt.cap > 0:
        state.auxiliaryPhysicalBufferCount =
            state.auxiliaryPhysicalBufferCount + 1
        backend2FragmentCheckedAddBytes(
            state.auxiliaryRetainedBytes,
            int64(fragmentBuilt.cap) * int64(sizeof(bool)))
    if functionIrIndexes.cap > 0:
        state.auxiliaryPhysicalBufferCount =
            state.auxiliaryPhysicalBufferCount + 1
        backend2FragmentCheckedAddBytes(
            state.auxiliaryRetainedBytes,
            int64(functionIrIndexes.cap) * int64(sizeof(int32)))
    state.ownerToken =
        backend2FragmentSequenceOwnerToken(
            fragments, fragmentBuilt, functionIrIndexes)
    state.functionRowCount = fragments.len
    for row in 0..<fragmentBuilt.len:
        if fragmentBuilt[row]:
            state.builtFunctionCount =
                state.builtFunctionCount + 1
    lifetime.LifetimeLedgerInit(state.ledger)
    state.categoryId = lifetime.LifetimeLedgerRegisterCategory(
        state.ledger, "backend2_function_fragment_payload")
    state.pipelineOwnerId = lifetime.LifetimeLedgerRegisterOwner(
        state.ledger, "backend2_pipeline")
    state.assemblerOwnerId = lifetime.LifetimeLedgerRegisterOwner(
        state.ledger, "backend2_canonical_assembler")
    var totalRetainedBytes =
        state.retained.retainedBytes
    backend2FragmentCheckedAddBytes(
        totalRetainedBytes, state.auxiliaryRetainedBytes)
    if totalRetainedBytes > int64(0):
        state.objectId = lifetime.LifetimeLedgerReserveObject(
            state.ledger,
            state.categoryId,
            totalRetainedBytes)
        lifetime.LifetimeLedgerOwn(
            state.ledger, state.objectId, state.pipelineOwnerId)
    state.phase = Backend2FragmentLifecyclePhasePipeline

fn Backend2FragmentLifecycleMoveToAssembler(
        state: var Backend2FragmentLifecycle) =
    if state.phase != Backend2FragmentLifecyclePhasePipeline:
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: invalid assembler move")
    if state.objectId > 0:
        lifetime.LifetimeLedgerMove(
            state.ledger,
            state.objectId,
            state.pipelineOwnerId,
            state.assemblerOwnerId)
    state.phase = Backend2FragmentLifecyclePhaseAssembler

fn backend2FragmentOutcomeValid(outcome: int32,
                                phase: int32): bool =
    if phase == Backend2FragmentLifecyclePhasePipeline:
        return outcome == Backend2FragmentOutcomeNoLowerable ||
               outcome == Backend2FragmentOutcomeWorkerFailure
    if phase == Backend2FragmentLifecyclePhaseAssembler:
        return outcome == Backend2FragmentOutcomeAssembled ||
               outcome == Backend2FragmentOutcomeAssemblerFailure
    return false

fn Backend2FragmentLifecycleReleaseWithReceipt(
        state: var Backend2FragmentLifecycle,
        fragments: var b2t.FunctionFragment[],
        fragmentBuilt: var bool[],
        functionIrIndexes: var int32[],
        outcome: int32,
        receipt: var Backend2FragmentReleaseReceipt) =
    if !backend2FragmentOutcomeValid(outcome, state.phase) ||
       state.terminalReceiptConsumed ||
       fragments.len != state.functionRowCount ||
       fragmentBuilt.len != state.functionRowCount ||
       (functionIrIndexes.len != 0 &&
        functionIrIndexes.len != state.functionRowCount) ||
       !layout.FixedBytes32Equal(
           backend2FragmentSequenceOwnerToken(
               fragments, fragmentBuilt, functionIrIndexes),
           state.ownerToken):
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: release identity mismatch")
    let retainedNow = Backend2FragmentSequenceRetained(fragments)
    if retainedNow.retainedBytes != state.retained.retainedBytes ||
       retainedNow.physicalBufferCount !=
           state.retained.physicalBufferCount ||
       retainedNow.managedStringValueCount !=
           state.retained.managedStringValueCount ||
       retainedNow.managedStringBytes !=
           state.retained.managedStringBytes:
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: payload changed before release")
    var auxiliaryRetainedBytesNow: int64
    var auxiliaryPhysicalBufferCountNow: int32
    if fragmentBuilt.cap > 0:
        auxiliaryPhysicalBufferCountNow =
            auxiliaryPhysicalBufferCountNow + 1
        backend2FragmentCheckedAddBytes(
            auxiliaryRetainedBytesNow,
            int64(fragmentBuilt.cap) * int64(sizeof(bool)))
    if functionIrIndexes.cap > 0:
        auxiliaryPhysicalBufferCountNow =
            auxiliaryPhysicalBufferCountNow + 1
        backend2FragmentCheckedAddBytes(
            auxiliaryRetainedBytesNow,
            int64(functionIrIndexes.cap) * int64(sizeof(int32)))
    if auxiliaryRetainedBytesNow !=
           state.auxiliaryRetainedBytes ||
       auxiliaryPhysicalBufferCountNow !=
           state.auxiliaryPhysicalBufferCount:
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: auxiliary payload changed before release")

    for row in 0..<fragments.len:
        backend2FragmentReleaseOne(fragments[row])
    seqs.chengSeqFreeTyped(fragments)
    seqs.chengSeqFreeTyped(fragmentBuilt)
    seqs.chengSeqFreeTyped(functionIrIndexes)
    if !Backend2FragmentSequenceStorageReleased(
           fragments, fragmentBuilt, functionIrIndexes):
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: physical release incomplete")

    var releasingOwnerId = state.pipelineOwnerId
    if state.phase == Backend2FragmentLifecyclePhaseAssembler:
        releasingOwnerId = state.assemblerOwnerId
    if state.objectId > 0:
        lifetime.LifetimeLedgerRelease(
            state.ledger, state.objectId, releasingOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.pipelineOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.assemblerOwnerId)
    lifetime.LifetimeLedgerAssertClosed(state.ledger)
    var metrics: lifetime.LifetimeLedgerMetrics
    lifetime.LifetimeLedgerReadTotalMetrics(state.ledger, metrics)

    receipt.ownerToken = state.ownerToken
    receipt.outcome = outcome
    receipt.functionRowCount = state.functionRowCount
    receipt.builtFunctionCount = state.builtFunctionCount
    receipt.allocated = metrics.allocated
    receipt.released = metrics.released
    receipt.live = metrics.live
    receipt.allocatedBytes = metrics.allocatedBytes
    receipt.releasedBytes = metrics.releasedBytes
    receipt.liveBytes = metrics.liveBytes
    receipt.ownerTransferCount = metrics.ownerTransferCount
    receipt.releasedBufferCount =
        state.retained.physicalBufferCount +
            state.auxiliaryPhysicalBufferCount
    receipt.releasedFragmentBufferCount =
        state.retained.physicalBufferCount
    receipt.releasedAuxiliaryBufferCount =
        state.auxiliaryPhysicalBufferCount
    receipt.releasedAuxiliaryBytes =
        state.auxiliaryRetainedBytes
    receipt.releasedManagedStringValueCount =
        state.retained.managedStringValueCount
    receipt.releasedManagedStringBytes =
        state.retained.managedStringBytes
    receipt.payloadStorageReleased =
        Backend2FragmentSequenceStorageReleased(
            fragments, fragmentBuilt, functionIrIndexes)
    receipt.auxiliaryStorageReleased =
        fragmentBuilt.len == 0 && fragmentBuilt.cap == 0 &&
        functionIrIndexes.len == 0 &&
        functionIrIndexes.cap == 0

    let ledgerStorageRelease =
        lifetime.LifetimeLedgerReleaseStorage(state.ledger)
    receipt.ledgerStorageReleased =
        ledgerStorageRelease.storageReleased
    receipt.ledgerStorageReleasedSequenceCount =
        ledgerStorageRelease.releasedSequenceCount
    receipt.ledgerStorageReleasedBufferCount =
        ledgerStorageRelease.releasedSequenceBufferCount
    receipt.ledgerStorageReleasedBytes =
        ledgerStorageRelease.releasedSequenceCapacityBytes
    var totalRetainedBytes =
        state.retained.retainedBytes
    backend2FragmentCheckedAddBytes(
        totalRetainedBytes, state.auxiliaryRetainedBytes)
    let expectedObjectCount =
        totalRetainedBytes > int64(0) ?
            int64(1) : int64(0)
    var expectedMoveCount: int64
    if expectedObjectCount == int64(1) &&
       state.phase == Backend2FragmentLifecyclePhaseAssembler:
        expectedMoveCount = int64(1)
    if metrics.allocated != expectedObjectCount ||
       metrics.released != expectedObjectCount ||
       metrics.live != int64(0) ||
       metrics.allocatedBytes != totalRetainedBytes ||
       metrics.releasedBytes != totalRetainedBytes ||
       metrics.liveBytes != int64(0) ||
       metrics.ownerTransferCount != expectedMoveCount ||
       !receipt.payloadStorageReleased ||
       !receipt.auxiliaryStorageReleased ||
       !receipt.ledgerStorageReleased ||
       receipt.ledgerStorageReleasedSequenceCount != 6 ||
       receipt.ledgerStorageReleasedBufferCount <= 0 ||
       receipt.ledgerStorageReleasedBytes <= int64(0):
        backend2FragmentLifecycleFail(
            "backend2 fragment lifecycle: terminal ledger mismatch")
    state.terminalOutcome = outcome
    state.terminalOwnerTransferCount = expectedMoveCount
    state.terminalLedgerStorageReleasedBufferCount =
        receipt.ledgerStorageReleasedBufferCount
    state.terminalLedgerStorageReleasedBytes =
        receipt.ledgerStorageReleasedBytes
    state.phase = Backend2FragmentLifecyclePhaseReleased

fn Backend2FragmentReleaseReceiptConsumeStrictInto(
        state: var Backend2FragmentLifecycle,
        fragments: var b2t.FunctionFragment[],
        fragmentBuilt: var bool[],
        functionIrIndexes: var int32[],
        receipt: var Backend2FragmentReleaseReceipt,
        err: var str): bool =
    err = ""
    var totalRetainedBytes =
        state.retained.retainedBytes
    backend2FragmentCheckedAddBytes(
        totalRetainedBytes, state.auxiliaryRetainedBytes)
    if state.phase != Backend2FragmentLifecyclePhaseReleased ||
       state.terminalReceiptConsumed ||
       !receipt.payloadStorageReleased ||
       !receipt.auxiliaryStorageReleased ||
       !receipt.ledgerStorageReleased ||
       receipt.outcome != state.terminalOutcome ||
       receipt.functionRowCount != state.functionRowCount ||
       receipt.builtFunctionCount != state.builtFunctionCount ||
       receipt.releasedBufferCount !=
           state.retained.physicalBufferCount +
               state.auxiliaryPhysicalBufferCount ||
       receipt.releasedFragmentBufferCount !=
           state.retained.physicalBufferCount ||
       receipt.releasedAuxiliaryBufferCount !=
           state.auxiliaryPhysicalBufferCount ||
       receipt.releasedAuxiliaryBytes !=
           state.auxiliaryRetainedBytes ||
       receipt.releasedManagedStringValueCount !=
           state.retained.managedStringValueCount ||
       receipt.releasedManagedStringBytes !=
           state.retained.managedStringBytes ||
       receipt.allocated !=
           (totalRetainedBytes > int64(0) ?
                int64(1) : int64(0)) ||
       receipt.released != receipt.allocated ||
       receipt.live != int64(0) ||
       receipt.allocatedBytes != totalRetainedBytes ||
       receipt.releasedBytes != totalRetainedBytes ||
       receipt.liveBytes != int64(0) ||
       receipt.ownerTransferCount !=
           state.terminalOwnerTransferCount ||
       receipt.ledgerStorageReleasedBufferCount !=
           state.terminalLedgerStorageReleasedBufferCount ||
       receipt.ledgerStorageReleasedBytes !=
           state.terminalLedgerStorageReleasedBytes ||
       receipt.ledgerStorageReleasedSequenceCount != 6 ||
       receipt.ledgerStorageReleasedBufferCount <= 0 ||
       receipt.ledgerStorageReleasedBytes <= int64(0) ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken, state.ownerToken) ||
       !Backend2FragmentSequenceStorageReleased(
           fragments, fragmentBuilt, functionIrIndexes):
        err =
            "backend2 fragment lifecycle: terminal release receipt mismatch"
        return false
    state.terminalReceiptConsumed = true
    return true

fn Backend2FragmentLifecycleFinalizeStrictInto(
        state: var Backend2FragmentLifecycle,
        fragments: var b2t.FunctionFragment[],
        fragmentBuilt: var bool[],
        functionIrIndexes: var int32[],
        outcome: int32,
        receipt: var Backend2FragmentReleaseReceipt,
        err: var str): bool =
    Backend2FragmentLifecycleReleaseWithReceipt(
        state,
        fragments,
        fragmentBuilt,
        functionIrIndexes,
        outcome,
        receipt)
    return Backend2FragmentReleaseReceiptConsumeStrictInto(
        state,
        fragments,
        fragmentBuilt,
        functionIrIndexes,
        receipt,
        err)
