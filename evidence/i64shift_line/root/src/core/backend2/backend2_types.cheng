# backend2_types — greenfield 后端 (backend2) 的纯值契约类型。
# 纲领: docs/beat-c.md §4.B.② — lower/emit/frame/fragment
# 四层是 pobj-free 纯函数, 本文件是它们之间唯一的数据契约。
# 铁律: 本模块零 import 编译器状态 (只允许 std / coreir), 保持可单测/可并行/可缓存。

type
    # 单函数 lowering 产物 — backend2 的原子交付单元。
    # 生产权威是 bodyIrPayload；旧 words/reloc/ref 字段仅为历史线格式与
    # pipe 原子性测试保留，生产 fragment 必须全空。assemble 在最终
    # symbol byte start 已知时从 exact BodyIR 唯一构建 machine stream。
    #
    # funcEmitCid 缓存键契约 (案卷 7d80e960, 计算已落地 backend2_cid.cheng
    # Backend2ComputeFuncEmitCid + 填充点 backend2_pipeline.cheng worker, 此处冻结定义;
    # spec docs/beat-c.md §8.3 修正全吸收):
    #   funcEmitCid = sha256(7-tuple), 逐项:
    #     1. codegenEpochSalt      — 完整 backend2 codegen source closure 派生的
    #                                 Backend2SemanticEpoch()；绝非手工版本号或
    #                                 canonicalGraphCid。
    #     2. targetTriple          — 目标三元组 (spec §3.7 隔离)
    #     3. typedFnCanonicalHash  — alpha 归一后的完整 BodyIR codec + normalized
    #                                 global data rows 哈希
    #                                 (Backend2TypedFnCanonicalHash；仅非 global 局部槽名置空，
    #                                 canonical allocator 可读的其余字段全部入键；typedIr
    #                                 全局初值不在 BodyIR，按 exact fragment rows 显式入键)
    #     4. sourcePathHash        — 规范源路径哈希 (Backend2SourcePathHash; spec §3.2
    #                                 订正: 不含行号/列号 — 行号漂移不虚假 miss;
    #                                 路径变动照常翻转, 诊断/span 表需要)
    #     5. callTargets           — 全部被调符号名 (字典序排序后入哈希, spec §3.5)
    #     6. callImportcSymbols    — importc 被调符号名 (非空项字典序排序, spec §3.5)
    #     7. calleeAbiViews        — 每个被调方的 CalleeAbiView 规范化序列 (per-fn 窄
    #                                 视图, 排序后入哈希; 构造 Backend2CalleeAbiViewsForFunction)
    #   漏任一成分 = stale fragment 命中 = 静默 miscompile。
    #   cstring 由 BodyIR 完全决定；global rows 已直接并入第 3 分量。
    #
    # 缓存契约：exact BodyIR 与 data payload 与布局无关；call/data
    # reloc 只能由 canonical emitter 在 assemble 生成，fragment 不再存机器偏移权威。
    FunctionFragment =
        funcEmitCid: str
        functionSymbol: str
        wordCount: int32
        words: int32[]
        relocWordOffsets: int32[]
        relocTargetSymbols: str[]
        refSymbols: str[]
        cstringLiterals: str[]
        # slice-2B cstring 数据段契约 (纲领 §④ slice-5 前置)。全部 fn-base-rel /
        # raw label (assemble 唯一消费跨函数偏移 + mangle target symbol)。
        #   cstringDataLabels[i]        : 第 i 个 cstring 字面量的 raw __data 标签
        #   cstringPayloadRawBytes      : 扁平化 NUL 结尾字节流 (逐字面量拼接)
        #   cstringPayloadRawByteCounts : 每字面量字节数 (len+1, 含 NUL)
        #   dataRelocFnRelWordOffsets   : 每条 adrp reloc 的 fn-base-rel 字偏移
        #   dataRelocTargetLabels       : 每条 reloc 的 raw 目标 cstring 标签 (与上并行)
        cstringDataLabels: str[]
        cstringPayloadRawBytes: int32[]
        cstringPayloadRawByteCounts: int32[]
        dataRelocFnRelWordOffsets: int32[]
        dataRelocTargetLabels: str[]
        # global __data 段契约 (global-reloc slice, cstring 五字段镜像)。全局标签
        # 由 pipeline 从 typedIr 桥接 (raw label + init payload text), assemble mangle 后
        # 插在本 fragment 的 cstring 标签块之前 (byte-identity: 每函数先 global 后 cstring)。
        #   globalDataLabelsRaw       : raw `cheng_global_{sanitize(slotName)}` (本 fragment 跨函数去重后新增)
        #   globalDataPayloadTexts    : `zero:N` / `hex:<u32le>` (hex 经 typedIr 查非零 i32 init)
        #   globalDataPayloadByteCounts : 恒 0 (payload 走 text 非 rawBytes, 平行 dataPayloadRawByteCounts)
        globalDataLabelsRaw: str[]
        globalDataPayloadTexts: str[]
        globalDataPayloadByteCounts: int32[]
        # Canonical regalloc ingress.  The worker owns lowering only; it freezes
        # the post-reflow/post-call-patch BodyIR as the exact binary codec
        # payload.  backend2_assemble decodes this payload and is the sole
        # owner of final-offset-aware production regalloc/emission.  Keeping
        # BodyIR instead of a heuristic machine stream is required because the
        # production receipt binds the final symbol byte start.
        bodyIrPayload: str
        # §4.3 contentCid 二次校验锚点: worker 冻结完成态 (global 字段填充后，assemble 去重前)
        # 的产物内容哈希 — funcEmitCid/contentCid 双自指字段留空后按 codec 线格式 sha256
        # (Backend2ContentCidOfFragment)。语义哈希 (funcEmitCid) 命中 ≠ 产物对; 缓存 hit
        # 必须重算比对本字段, 不等 = 硬崩 (Backend2FragmentVerifyContent), 防篡改/伪造/
        # 语义哈希漏覆盖。字段追加于声明尾 = codec tag 18 (加字段三处同步契约见 codec 头注)。
        contentCid: str

    # 被调方 ABI 视图 — lower 需要的对方函数签名事实 (参数类型/返回类型),
    # 由 pipeline 从 lowering plan 只读提取, lower 不回查全局表。
    # 契约: paramTypes/returnType 存**规范化类型拼写** (canonical spelling,
    # Backend2TypeCanonicalSpelling: 空白归一 + 指针统一 "ptr" + pipeline 侧
    # typeDefAlias 展开), 不存类型 id/句柄 — id 跨编译不稳定, 会污染 funcEmitCid
    # 第 7 成分。
    # gap 已修 (spec §3.4): 构造点 backend2_pipeline.cheng
    # Backend2CalleeAbiViewsForFunction = per-fn 窄视图 — 只从 irFunction.callTargets/
    # callImportcSymbols 并行边表提取本函数实际被调方, 断言 views.len == callTargets.len
    # (每条调用边恰一视图); 无关函数签名变动不再翻转本 fragment 的 cid。
    CalleeAbiView =
        functionName: str
        paramTypes: str[]
        returnType: str

fn Backend2SemanticEpoch(): str =
    # 此值由 backend2_version_sentinel 从完整 codegen import 语义闭包确定性派生。
    # sentinel 计算 closure 时把本返回字面量归一为固定占位，消除自引用；任何其他
    # source、import、ABI 或 codec 变化都会生成新 epoch，禁止人工递增或兼容别名。
    return "338b4554c61cb6f4fa8ea6ed7dc49a38c0931b62a105cd370b1b1cf51825d803"
