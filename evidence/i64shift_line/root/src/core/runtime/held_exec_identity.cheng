# held_exec_identity.cheng - real OS held-executable identity evidence issuer.
#
# This module is the only in-repository producer of held executable identity
# evidence for the CSG production launcher. Every proven bit it reports is
# derived from a genuine OS primitive on this process: a no-follow held
# descriptor (Darwin open O_NOFOLLOW / Linux openat2 RESOLVE_NO_SYMLINKS),
# a named-path pre/post stat fence, held-descriptor path resolution
# (Darwin fcntl F_GETPATH / Linux /proc/self/fd readlink), raw byte hashing
# through the held descriptor, Mach-O embedded code signature parsing
# (cdhash / team / signing identifier / designated requirement blob) and
# Linux fs-verity measurement plus immutable inode flags. Environment
# variables, repository files, caller-supplied CIDs and path strings from
# callers never become evidence here. When any primitive is genuinely
# unavailable the issuer reports the precise failure and stays HARD_RED;
# it never substitutes a weaker check for a missing one.

@importc("open")
fn heldExecOsOpen(path: cstring, flags: int32, mode: int32): int32
@importc("close")
fn heldExecOsClose(fd: int32): int32
@importc("pread")
fn heldExecOsPread(fd: int32, buf: ptr, count: int64, offset: int64): int64
@importc("pread")
fn heldExecOsPreadFixed64(fd: int32, buf: var uint8[64], count: int64, offset: int64): int64
@importc("fstat")
fn heldExecOsFstat(fd: int32, outStat: var uint8[256]): int32
@importc("fstatat")
fn heldExecOsFstatat(dirFd: int32, path: cstring, outStat: var uint8[256], flags: int32): int32
@importc("getpid")
fn heldExecOsGetpid(): int32
@importc("proc_pidfdinfo")
fn heldExecOsProcPidfdinfo(
        pid: int32,
        fd: int32,
        flavor: int32,
        buf: var uint8[1216],
        bufsize: int32): int32
@importc("readlink")
fn heldExecOsReadlink(path: cstring, buf: var uint8[4096], size: int64): int64
@importc("uname")
fn heldExecOsUname(out: var uint8[1280]): int32
@importc("ioctl")
fn heldExecOsIoctl(fd: int32, request: int32, argp: ptr): int32
@importc("cheng_linux_fs_ioc_getflags_bridge")
fn heldExecLinuxGetFlagsBridge(fd: int32, outFlags: var uint8[8]): int32
@importc("cheng_linux_fsverity_measure_sha256_bridge")
fn heldExecLinuxMeasureVerityBridge(fd: int32, outDigest: var uint8[32]): int32
@importc("syscall")
fn heldExecOsSyscallOpenat2(nr: int64, dirFd: int64, path: cstring, how: var uint8[24], howSize: int64): int64

import std/system
import std/strings
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

type
    ChengHeldExecStatEvidence =
        device: uint64
        inode: uint64
        mode: int32
        linkCount: uint64
        size: int64
        ownerUid: uint64
        ownerGid: uint64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        inodeFlags: uint64

    ChengHeldExecDarwinCodesign =
        cdhashCid: str
        signingIdentifier: str
        teamIdentifier: str
        designatedRequirementCid: str
        codeDirectoryFlags: uint64
        adHocSignature: bool
        hardenedRuntime: bool
        libraryValidation: bool
        codeDirectoryProven: bool
        designatedRequirementProven: bool

    ChengHeldExecLinuxIntegrity =
        fsVerityDigestCid: str
        inodeFlags: uint64
        fsVerityProven: bool
        inodeImmutableProven: bool
        openat2ResolveProven: bool
        procFdPathProven: bool

    ChengHeldExecFileEvidence =
        fixedPath: str
        namedBefore: ChengHeldExecStatEvidence
        held: ChengHeldExecStatEvidence
        namedAfter: ChengHeldExecStatEvidence
        bytesCid: str
        heldDescriptorPathProven: bool
        namedHeldFenceClosed: bool
        nativeImageProven: bool
        nativeImageError: str
        darwin: ChengHeldExecDarwinCodesign
        linux: ChengHeldExecLinuxIntegrity

    ChengHeldExecIdentityEvidence =
        schema: str
        platform: str
        launcher: ChengHeldExecFileEvidence
        binary: ChengHeldExecFileEvidence

    ChengHeldExecIdentityIssueResult =
        ok: bool
        error: str
        evidence: ChengHeldExecIdentityEvidence

