    heldExecMachoMagic64: uint32 = 4277009103
    heldExecMachoCpuA64: uint32 = 16777228
    heldExecMachoFiletypeExecute: uint32 = 2
    heldExecMachoFatMagic: uint32 = 3203386826
    heldExecMachoFatMagic64: uint32 = 3215036106
