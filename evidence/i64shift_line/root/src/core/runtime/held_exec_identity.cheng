    heldExecCsMagicCodeDirectory: uint32 = 4208856066
    heldExecCsMagicRequirements: uint32 = 4208856065
    heldExecCsMagicRequirement: uint32 = 4208856064
    heldExecCsSlotCodeDirectory: uint32 = 0
    heldExecCsSlotRequirements: uint32 = 2
