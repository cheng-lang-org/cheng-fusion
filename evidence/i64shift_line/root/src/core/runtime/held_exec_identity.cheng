    # Darwin arm64 struct stat byte offsets (verified against the host SDK).
    heldExecDarwinStatDevOff: int32 = 0
    heldExecDarwinStatModeOff: int32 = 4
    heldExecDarwinStatNlinkOff: int32 = 6
    heldExecDarwinStatInoOff: int32 = 8
    heldExecDarwinStatUidOff: int32 = 16
    heldExecDarwinStatGidOff: int32 = 20
    heldExecDarwinStatMtimeSecOff: int32 = 48
    heldExecDarwinStatMtimeNsecOff: int32 = 56
    heldExecDarwinStatCtimeSecOff: int32 = 64
    heldExecDarwinStatCtimeNsecOff: int32 = 72
    heldExecDarwinStatSizeOff: int32 = 96
    heldExecDarwinStatFlagsOff: int32 = 116
    # Linux struct stat trailing-field byte offsets shared by x86_64 and
    # aarch64; leading fields differ and are selected per machine.
    heldExecLinuxStatDevOff: int32 = 0
    heldExecLinuxStatInoOff: int32 = 8
    heldExecLinuxStatSizeOff: int32 = 48
    heldExecLinuxStatMtimeSecOff: int32 = 88
    heldExecLinuxStatMtimeNsecOff: int32 = 96
    heldExecLinuxStatCtimeSecOff: int32 = 104
    heldExecLinuxStatCtimeNsecOff: int32 = 112
    heldExecLinuxX64StatModeOff: int32 = 24
    heldExecLinuxX64StatUidOff: int32 = 28
