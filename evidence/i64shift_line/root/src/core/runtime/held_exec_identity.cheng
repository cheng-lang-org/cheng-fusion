    heldExecLinuxX64StatNlinkOff: int32 = 16
    heldExecLinuxA64StatModeOff: int32 = 16
    heldExecLinuxA64StatNlinkOff: int32 = 20
    heldExecLinuxA64StatUidOff: int32 = 24
    heldExecLinuxA64StatGidOff: int32 = 28

    heldExecDarwinONoFollow: int32 = 256
    heldExecDarwinOCloExec: int32 = 16777216
    heldExecDarwinAtFdCwd: int32 = -2
    heldExecDarwinProcPidfdVnodePath: int32 = 2
    heldExecDarwinFdTypeVnode: int32 = 1
    heldExecDarwinVnodeFdInfoPathBytes: int32 = 1200
    heldExecDarwinVnodeFdInfoFiTypeOff: int32 = 16
    heldExecDarwinVnodeFdInfoDevOff: int32 = 24
    heldExecDarwinVnodeFdInfoInoOff: int32 = 32
    heldExecDarwinVnodeFdInfoPathOff: int32 = 176
    heldExecDarwinSfImmutable: uint32 = 131072
    heldExecLinuxOCloExec: int32 = 524288
    heldExecLinuxAtFdCwd: int32 = -100
    heldExecLinuxAtEmptyPath: int32 = 4096
    heldExecLinuxSysOpenat2: int64 = 437
    heldExecLinuxOpenat2HowBytes: int64 = 24
