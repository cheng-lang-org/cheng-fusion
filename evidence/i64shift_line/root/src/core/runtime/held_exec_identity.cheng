fn heldExecPtrPlus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(base) + uint64(off))

fn heldExecZero256(buf: var uint8[256]) =
    var index: int32
    while index < 256:
        buf[index] = 0
        index = index + 1

fn heldExecZero1280(buf: var uint8[1280]) =
    var index: int32
    while index < 1280:
        buf[index] = 0
        index = index + 1

fn heldExecZero24(buf: var uint8[24]) =
    var index: int32
    while index < 24:
        buf[index] = 0
        index = index + 1

fn heldExecZero1216(buf: var uint8[1216]) =
    var index: int32
    while index < 1216:
        buf[index] = 0
        index = index + 1

fn heldExecZero4096(buf: var uint8[4096]) =
    var index: int32
    while index < 4096:
        buf[index] = 0
        index = index + 1

fn heldExecZero8(buf: var uint8[8]) =
    var index: int32
    while index < 8:
        buf[index] = 0
        index = index + 1

fn heldExecZero32(buf: var uint8[32]) =
    var index: int32
    while index < 32:
        buf[index] = 0
        index = index + 1

fn heldExecReadU16From256(buf: var uint8[256], off: int32): uint16 =
    return uint16(uint32(buf[off]) |
                  (uint32(buf[off + 1]) << 8))

fn heldExecReadU32From256(buf: var uint8[256], off: int32): uint32 =
    return uint32(buf[off]) |
           (uint32(buf[off + 1]) << 8) |
           (uint32(buf[off + 2]) << 16) |
           (uint32(buf[off + 3]) << 24)

fn heldExecReadI32From256(buf: var uint8[256], off: int32): int32 =
    return int32(heldExecReadU32From256(buf, off))

fn heldExecReadU64From256(buf: var uint8[256], off: int32): uint64 =
    return uint64(buf[off]) |
           (uint64(buf[off + 1]) << 8) |
           (uint64(buf[off + 2]) << 16) |
           (uint64(buf[off + 3]) << 24) |
           (uint64(buf[off + 4]) << 32) |
           (uint64(buf[off + 5]) << 40) |
           (uint64(buf[off + 6]) << 48) |
           (uint64(buf[off + 7]) << 56)

fn heldExecReadI64From256(buf: var uint8[256], off: int32): int64 =
    return int64(heldExecReadU64From256(buf, off))

fn heldExecReadU32From8(buf: var uint8[8], off: int32): uint32 =
    return uint32(buf[off]) |
           (uint32(buf[off + 1]) << 8) |
           (uint32(buf[off + 2]) << 16) |
           (uint32(buf[off + 3]) << 24)

fn heldExecReadI32From1216(buf: var uint8[1216], off: int32): int32 =
    return int32(uint32(buf[off]) |
                 (uint32(buf[off + 1]) << 8) |
                 (uint32(buf[off + 2]) << 16) |
                 (uint32(buf[off + 3]) << 24))

fn heldExecReadU64From1216(buf: var uint8[1216], off: int32): uint64 =
    return uint64(buf[off]) |
           (uint64(buf[off + 1]) << 8) |
           (uint64(buf[off + 2]) << 16) |
           (uint64(buf[off + 3]) << 24) |
           (uint64(buf[off + 4]) << 32) |
           (uint64(buf[off + 5]) << 40) |
           (uint64(buf[off + 6]) << 48) |
           (uint64(buf[off + 7]) << 56)

fn heldExecWriteUInt64Into24(buf: var uint8[24], off: int32, valueRaw: uint64) =
    var value = valueRaw
    var index: int32
    while index < 8:
        buf[off + index] = uint8(value & 255)
        value = value >> 8
        index = index + 1

@borrows
fn heldExecCStringAtEqualsStr1280(buf: var uint8[1280], off: int32, expected: str): bool =
    var index: int32
    while index < expected.len:
        if int32(buf[off + index]) != expected[index]:
            return false
        index = index + 1
    return buf[off + index] == 0

@borrows
fn heldExecCStringAtEqualsStr4096(buf: var uint8[4096], off: int32, expected: str): bool =
    var index: int32
    while index < expected.len:
        if int32(buf[off + index]) != expected[index]:
            return false
        index = index + 1
    return buf[off + index] == 0

@borrows
fn heldExecCStringAtEqualsStr1216(buf: var uint8[1216], off: int32, expected: str): bool =
    var index: int32
    while index < expected.len:
        if int32(buf[off + index]) != expected[index]:
            return false
        index = index + 1
    return buf[off + index] == 0

@borrows
fn heldExecBytesU16LE(
        bytes: rawbytes.Bytes,
        off: int32): int32 =
    return (rawbytes.BytesGet(bytes, off) & 255) |
        ((rawbytes.BytesGet(bytes, off + 1) & 255) << 8)

@borrows
fn heldExecBytesU32LE(
        bytes: rawbytes.Bytes,
        off: int32): uint32 =
    let b0 = uint32(rawbytes.BytesGet(bytes, off) & 255)
    let b1 = uint32(rawbytes.BytesGet(bytes, off + 1) & 255)
    let b2 = uint32(rawbytes.BytesGet(bytes, off + 2) & 255)
    let b3 = uint32(rawbytes.BytesGet(bytes, off + 3) & 255)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

@borrows
fn heldExecBytesU32BE(
        bytes: rawbytes.Bytes,
        off: int32): uint32 =
    let b0 = uint32(rawbytes.BytesGet(bytes, off) & 255)
    let b1 = uint32(rawbytes.BytesGet(bytes, off + 1) & 255)
    let b2 = uint32(rawbytes.BytesGet(bytes, off + 2) & 255)
    let b3 = uint32(rawbytes.BytesGet(bytes, off + 3) & 255)
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

@borrows
fn heldExecBytesReadCstring(
        bytes: rawbytes.Bytes,
        off: int32,
        limit: int32,
        out: var str): bool =
    out = ""
    if off < 0 || limit <= 0 || off >= limit:
        return false
    var count: int32
    while off + count < limit:
        if rawbytes.BytesGet(bytes, off + count) == 0:
            var view = rawbytes.BytesView(
                heldExecPtrPlus(bytes.data, off), count)
            out = rawbytes.BytesToString(view)
            return true
        count = count + 1
    return false

@borrows
fn heldExecRawBytesCid(bytes: rawbytes.Bytes): str =
    let digest = hash256.Sha256Fixed(layout.ByteSpanFromBytes(bytes))
    return "sha256:" + layout.FixedBytes32Hex(digest)

@borrows
fn heldExecCidValid(text: str): bool =
    if text.len != 71:
        return false
    if !strings.HasPrefix(text, "sha256:"):
        return false
    var nonzero: bool
    var index: int32 = 7
    while index < 71:
        let c = text[index]
        let isDigit = c >= 48 && c <= 57
        let isLowerHex = c >= 97 && c <= 102
        if !isDigit && !isLowerHex:
            return false
        if c != 48:
            nonzero = true
        index = index + 1
    return nonzero

fn ChengHeldExecIdentityPlatform(): str =
    var unameBuf: uint8[1280]
    heldExecZero1280(unameBuf)
    if heldExecOsUname(unameBuf) != 0:
        return ""
    if heldExecCStringAtEqualsStr1280(unameBuf, 0, "Darwin"):
        if heldExecCStringAtEqualsStr1280(unameBuf, 1024, "arm64"):
            return ChengHeldExecPlatformDarwin
        return ""
    if heldExecCStringAtEqualsStr1280(unameBuf, 0, "Linux"):
        if heldExecCStringAtEqualsStr1280(unameBuf, 260, "x86_64"):
            return ChengHeldExecPlatformLinuxX64
        if heldExecCStringAtEqualsStr1280(unameBuf, 260, "aarch64"):
            return ChengHeldExecPlatformLinuxA64
        return ""
    return ""

@borrows
fn ChengHeldExecIdentityLauncherFixedPath(platform: str): str =
    if platform == ChengHeldExecPlatformDarwin:
        return strings.CloneStr(ChengHeldExecLauncherDarwinPath)
    if platform == ChengHeldExecPlatformLinuxX64 ||
       platform == ChengHeldExecPlatformLinuxA64:
        return strings.CloneStr(ChengHeldExecLauncherLinuxPath)
    return ""

@borrows
fn ChengHeldExecIdentityBinaryFixedPath(platform: str): str =
    if platform == ChengHeldExecPlatformDarwin:
        return strings.CloneStr(ChengHeldExecBinaryDarwinPath)
    if platform == ChengHeldExecPlatformLinuxX64 ||
       platform == ChengHeldExecPlatformLinuxA64:
        return strings.CloneStr(ChengHeldExecBinaryLinuxPath)
    return ""

fn heldExecParseDarwinStat(
        statData: var uint8[256],
        out: var ChengHeldExecStatEvidence) =
    out.device = uint64(uint32(heldExecReadI32From256(
        statData, heldExecDarwinStatDevOff)))
    out.inode = heldExecReadU64From256(statData, heldExecDarwinStatInoOff)
    out.mode = int32(heldExecReadU16From256(
        statData, heldExecDarwinStatModeOff))
    out.linkCount = uint64(heldExecReadU16From256(
        statData, heldExecDarwinStatNlinkOff))
    out.size = heldExecReadI64From256(statData, heldExecDarwinStatSizeOff)
    out.ownerUid = uint64(heldExecReadU32From256(
        statData, heldExecDarwinStatUidOff))
    out.ownerGid = uint64(heldExecReadU32From256(
        statData, heldExecDarwinStatGidOff))
    out.mtimeSec = heldExecReadI64From256(
        statData, heldExecDarwinStatMtimeSecOff)
    out.mtimeNsec = heldExecReadI64From256(
        statData, heldExecDarwinStatMtimeNsecOff)
    out.ctimeSec = heldExecReadI64From256(
        statData, heldExecDarwinStatCtimeSecOff)
    out.ctimeNsec = heldExecReadI64From256(
        statData, heldExecDarwinStatCtimeNsecOff)
    out.inodeFlags = uint64(heldExecReadU32From256(
        statData, heldExecDarwinStatFlagsOff))

@borrows
fn heldExecParseLinuxStat(
        platform: str,
        statData: var uint8[256],
        out: var ChengHeldExecStatEvidence): bool =
    out.device = heldExecReadU64From256(statData, heldExecLinuxStatDevOff)
    out.inode = heldExecReadU64From256(statData, heldExecLinuxStatInoOff)
    out.size = heldExecReadI64From256(statData, heldExecLinuxStatSizeOff)
    out.mtimeSec = heldExecReadI64From256(
        statData, heldExecLinuxStatMtimeSecOff)
    out.mtimeNsec = heldExecReadI64From256(
        statData, heldExecLinuxStatMtimeNsecOff)
    out.ctimeSec = heldExecReadI64From256(
        statData, heldExecLinuxStatCtimeSecOff)
    out.ctimeNsec = heldExecReadI64From256(
        statData, heldExecLinuxStatCtimeNsecOff)
    if platform == ChengHeldExecPlatformLinuxX64:
        out.mode = int32(heldExecReadU32From256(
            statData, heldExecLinuxX64StatModeOff))
        out.linkCount = heldExecReadU64From256(
            statData, heldExecLinuxX64StatNlinkOff)
        out.ownerUid = uint64(heldExecReadU32From256(
            statData, heldExecLinuxX64StatUidOff))
        out.ownerGid = uint64(heldExecReadU32From256(
            statData, heldExecLinuxX64StatGidOff))
    elif platform == ChengHeldExecPlatformLinuxA64:
        out.mode = int32(heldExecReadU32From256(
            statData, heldExecLinuxA64StatModeOff))
        out.linkCount = uint64(heldExecReadU32From256(
            statData, heldExecLinuxA64StatNlinkOff))
        out.ownerUid = uint64(heldExecReadU32From256(
            statData, heldExecLinuxA64StatUidOff))
        out.ownerGid = uint64(heldExecReadU32From256(
            statData, heldExecLinuxA64StatGidOff))
    else:
        return false
    out.inodeFlags = uint64(0)
    return true

@borrows
fn heldExecNamedStat(
        platform: str,
        path: str,
        out: var ChengHeldExecStatEvidence): bool =
    var statBuf: uint8[256]
    heldExecZero256(statBuf)
    let rawPath = system.StrToCStringTemp(path)
    var dirFd = heldExecDarwinAtFdCwd
    if platform != ChengHeldExecPlatformDarwin:
        dirFd = heldExecLinuxAtFdCwd
    if heldExecOsFstatat(dirFd, rawPath, statBuf, 0) != 0:
        return false
    if platform == ChengHeldExecPlatformDarwin:
        heldExecParseDarwinStat(statBuf, out)
    else:
        return heldExecParseLinuxStat(platform, statBuf, out)
    return true

@borrows
fn heldExecHeldStat(
        platform: str,
        fd: int32,
        out: var ChengHeldExecStatEvidence): bool =
    var statBuf: uint8[256]
    heldExecZero256(statBuf)
    if platform == ChengHeldExecPlatformDarwin:
        if heldExecOsFstat(fd, statBuf) != 0:
            return false
        heldExecParseDarwinStat(statBuf, out)
        return true
    let emptyPath = system.StrToCStringTemp("")
    if heldExecOsFstatat(
           fd, emptyPath, statBuf,
           heldExecLinuxAtEmptyPath) != 0:
        return false
    return heldExecParseLinuxStat(platform, statBuf, out)

@borrows
fn heldExecStatEqual(
        left: ChengHeldExecStatEvidence,
        right: ChengHeldExecStatEvidence): bool =
    return left.device == right.device &&
        left.inode == right.inode &&
        left.mode == right.mode &&
        left.linkCount == right.linkCount &&
        left.size == right.size &&
        left.ownerUid == right.ownerUid &&
        left.ownerGid == right.ownerGid &&
        left.mtimeSec == right.mtimeSec &&
        left.mtimeNsec == right.mtimeNsec &&
        left.ctimeSec == right.ctimeSec &&
        left.ctimeNsec == right.ctimeNsec &&
        left.inodeFlags == right.inodeFlags

@borrows
fn ChengHeldExecStatEvidenceEqual(
        left: ChengHeldExecStatEvidence,
        right: ChengHeldExecStatEvidence): bool =
    return heldExecStatEqual(left, right)

@borrows
fn heldExecOpenHeld(platform: str, path: str): int32 =
    let rawPath = system.StrToCStringTemp(path)
    if platform == ChengHeldExecPlatformDarwin:
        return heldExecOsOpen(
            rawPath,
            heldExecDarwinONoFollow | heldExecDarwinOCloExec,
            0)
    if platform != ChengHeldExecPlatformLinuxX64 &&
       platform != ChengHeldExecPlatformLinuxA64:
        return -1
    var how: uint8[24]
    heldExecZero24(how)
    heldExecWriteUInt64Into24(how, 0, uint64(heldExecLinuxOCloExec))
    let resolveMask = heldExecLinuxResolveNoSymlinks | heldExecLinuxResolveNoXdev
    heldExecWriteUInt64Into24(how, 16, resolveMask)
    let rc = heldExecOsSyscallOpenat2(
        heldExecLinuxSysOpenat2,
        int64(heldExecLinuxAtFdCwd),
        rawPath,
        how,
        heldExecLinuxOpenat2HowBytes)
    if rc < int64(0) || rc > int64(1073741823):
        return -1
    return int32(rc)

# The held descriptor path must equal the literal input path byte for
# byte. A symlinked prefix (including /tmp on Darwin) is reported as a
# mismatch instead of being silently resolved: the production fixed
# paths are installed through a real root-owned parent chain, so any
# resolution drift is honest evidence of a non-production location.
# Darwin binds the descriptor through the kernel vnode table
# (proc_pidfdinfo PROC_PIDFDVNODEPATHINFO), which also cross-proves the
# vnode device/inode against the held fstat identity; fcntl F_GETPATH
# is deliberately not used because fcntl is variadic and a fixed Cheng
# declaration cannot legally reach its third argument on Darwin arm64.
# Linux binds the descriptor through /proc/self/fd after the openat2
# no-symlink resolution.
@borrows
fn heldExecHeldPathMatches(
        platform: str,
        fd: int32,
        path: str,
        held: ChengHeldExecStatEvidence): bool =
    if platform == ChengHeldExecPlatformDarwin:
        var fdInfoBuf: uint8[1216]
        heldExecZero1216(fdInfoBuf)
        let got = heldExecOsProcPidfdinfo(
            heldExecOsGetpid(),
            fd,
            heldExecDarwinProcPidfdVnodePath,
            fdInfoBuf,
            heldExecDarwinVnodeFdInfoPathBytes)
        if got != heldExecDarwinVnodeFdInfoPathBytes:
            return false
        let fdType = heldExecReadI32From1216(
            fdInfoBuf, heldExecDarwinVnodeFdInfoFiTypeOff)
        if fdType != heldExecDarwinFdTypeVnode:
            return false
        let vnodeDev = uint64(uint32(heldExecReadI32From1216(
            fdInfoBuf, heldExecDarwinVnodeFdInfoDevOff)))
        let vnodeIno = heldExecReadU64From1216(
            fdInfoBuf, heldExecDarwinVnodeFdInfoInoOff)
        if vnodeDev != held.device || vnodeIno != held.inode:
            return false
        return heldExecCStringAtEqualsStr1216(
            fdInfoBuf, heldExecDarwinVnodeFdInfoPathOff, path)
    var fdPathBuf: uint8[4096]
    heldExecZero4096(fdPathBuf)
    let procPath = system.StrToCStringTemp(
        "/proc/self/fd/" + strings.IntToStr(fd))
    let readGot = heldExecOsReadlink(
        procPath, fdPathBuf, int64(4095))
    if readGot <= int64(0) || readGot >= int64(4095):
        return false
    return heldExecCStringAtEqualsStr4096(fdPathBuf, 0, path)

fn heldExecReadHeldBytes(
        fd: int32,
        size: int64,
        out: var rawbytes.Bytes): bool =
    out = rawbytes.EmptyBytes()
    if size <= int64(0) || size > heldExecMaxFileBytes:
        return false
    var bytes = rawbytes.BytesAlloc(int32(size))
    if bytes.data == nil:
        return false
    var offset: int64
    while offset < size:
        let got = heldExecOsPread(
            fd,
            heldExecPtrPlus(bytes.data, int32(offset)),
            size - offset,
            offset)
        if got <= int64(0) || got > size - offset:
            rawbytes.BytesFree(bytes)
            return false
        offset = offset + got
    out = bytes
    return true

fn heldExecStreamHeldBytesCid(
        fd: int32,
        size: int64,
        outStatus: var int32): str =
    outStatus = 0
    if fd < 0 || size <= int64(0):
        return ""
    var digest: layout.FixedBytes32
    let digestResult = system.RuntimeHeldExecFdContentSha256(fd)
    outStatus = digestResult.status
    if outStatus != 1:
        return ""
    if digestResult.byteCount != uint64(size):
        outStatus = -7
        return ""
    for byteIndex in 0..<32:
        let limbIndex = byteIndex / 8
        var limb = digestResult.digest0
        if limbIndex == 1:
            limb = digestResult.digest1
        elif limbIndex == 2:
            limb = digestResult.digest2
        elif limbIndex == 3:
            limb = digestResult.digest3
        digest.data[byteIndex] = uint8(
            (limb >> uint64((byteIndex % 8) * 8)) & uint64(255))
    let out = "sha256:" + layout.FixedBytes32Hex(digest)
    if !heldExecCidValid(out):
        outStatus = -8
        return ""
    return out

@borrows
fn heldExecDarwinParseCodesign(
        bytes: rawbytes.Bytes,
        out: var ChengHeldExecDarwinCodesign,
        err: var str): bool =
    let size = rawbytes.BytesLen(bytes)
    if size < 32:
        err = strings.CloneStr(ChengHeldExecErrDarwinMachoInvalid)
        return false
    let magic = heldExecBytesU32LE(bytes, 0)
    if magic == heldExecMachoFatMagic || magic == heldExecMachoFatMagic64:
        err = strings.CloneStr(ChengHeldExecErrDarwinNotThinNative)
        return false
    if magic != heldExecMachoMagic64 ||
       heldExecBytesU32LE(bytes, 4) != heldExecMachoCpuA64 ||
       heldExecBytesU32LE(bytes, 12) != heldExecMachoFiletypeExecute:
        err = strings.CloneStr(ChengHeldExecErrDarwinMachoInvalid)
        return false
    let ncmds = heldExecBytesU32LE(bytes, 16)
    if ncmds > uint32(4096):
        err = strings.CloneStr(ChengHeldExecErrDarwinMachoInvalid)
        return false
    var sigDataOff: uint32
    var sigDataSize: uint32
    var cursor: int32 = 32
    var index: uint32
    while index < ncmds:
        if cursor + 8 > size:
            err = strings.CloneStr(ChengHeldExecErrDarwinMachoInvalid)
            return false
        let cmd = heldExecBytesU32LE(bytes, cursor)
        let cmdSize = heldExecBytesU32LE(bytes, cursor + 4)
        if cmdSize < uint32(8) || cursor + int32(cmdSize) > size:
            err = strings.CloneStr(ChengHeldExecErrDarwinMachoInvalid)
            return false
        if cmd == heldExecMachoLcCodeSignature:
            if sigDataOff != uint32(0) || cmdSize < uint32(16):
                err = strings.CloneStr(
                    ChengHeldExecErrDarwinSignatureMissing)
                return false
            sigDataOff = heldExecBytesU32LE(bytes, cursor + 8)
            sigDataSize = heldExecBytesU32LE(bytes, cursor + 12)
        cursor = cursor + int32(cmdSize)
        index = index + 1
    if sigDataOff == uint32(0) || sigDataSize < uint32(20) ||
       int64(sigDataOff) + int64(sigDataSize) > int64(size):
        err = strings.CloneStr(ChengHeldExecErrDarwinSignatureMissing)
        return false
    let sigBase = int32(sigDataOff)
    if heldExecBytesU32BE(bytes, sigBase) !=
           heldExecCsMagicEmbeddedSignature:
        err = strings.CloneStr(ChengHeldExecErrDarwinSuperblobInvalid)
        return false
    let blobLength = heldExecBytesU32BE(bytes, sigBase + 4)
    let blobCount = heldExecBytesU32BE(bytes, sigBase + 8)
    if blobLength > sigDataSize ||
       blobCount < uint32(1) || blobCount > uint32(64) ||
       uint32(12) + blobCount * uint32(8) > blobLength:
        err = strings.CloneStr(ChengHeldExecErrDarwinSuperblobInvalid)
        return false
    var codeDirectoryOff: uint32
    var requirementsOff: uint32
    var slot: uint32
    while slot < blobCount:
        let entryBase = sigBase + 12 + int32(slot) * 8
        let slotType = heldExecBytesU32BE(bytes, entryBase)
        let slotOff = heldExecBytesU32BE(bytes, entryBase + 4)
        if slotOff >= blobLength:
            err = strings.CloneStr(ChengHeldExecErrDarwinSuperblobInvalid)
            return false
        if slotType == heldExecCsSlotCodeDirectory:
            if codeDirectoryOff != uint32(0):
                err = strings.CloneStr(ChengHeldExecErrDarwinSuperblobInvalid)
                return false
            codeDirectoryOff = slotOff
        if slotType == heldExecCsSlotRequirements:
            if requirementsOff != uint32(0):
                err = strings.CloneStr(ChengHeldExecErrDarwinSuperblobInvalid)
                return false
            requirementsOff = slotOff
        slot = slot + 1
    if codeDirectoryOff == uint32(0):
        err = strings.CloneStr(ChengHeldExecErrDarwinCodeDirectoryInvalid)
        return false
    let cdBase = sigBase + int32(codeDirectoryOff)
    if cdBase + 52 > sigBase + int32(blobLength) ||
       heldExecBytesU32BE(bytes, cdBase) !=
           heldExecCsMagicCodeDirectory:
        err = strings.CloneStr(ChengHeldExecErrDarwinCodeDirectoryInvalid)
        return false
    let cdLength = heldExecBytesU32BE(bytes, cdBase + 4)
    let cdVersion = heldExecBytesU32BE(bytes, cdBase + 8)
    let cdFlags = heldExecBytesU32BE(bytes, cdBase + 12)
    let cdIdentOff = heldExecBytesU32BE(bytes, cdBase + 20)
    if cdLength < uint32(52) ||
       int32(cdLength) > sigBase + int32(blobLength) - cdBase:
        err = strings.CloneStr(ChengHeldExecErrDarwinCodeDirectoryInvalid)
        return false
    let hashSize = rawbytes.BytesGet(bytes, cdBase + 36)
    let hashType = rawbytes.BytesGet(bytes, cdBase + 37)
    if hashType != heldExecCsHashTypeSha256 || hashSize != 32:
        err = strings.CloneStr(ChengHeldExecErrDarwinHashTypeUnsupported)
        return false
    var cdView = rawbytes.BytesView(
        heldExecPtrPlus(bytes.data, cdBase), int32(cdLength))
    out.cdhashCid = heldExecRawBytesCid(cdView)
    if !heldExecBytesReadCstring(
           bytes, cdBase + int32(cdIdentOff),
           cdBase + int32(cdLength), out.signingIdentifier):
        err = strings.CloneStr(ChengHeldExecErrDarwinCodeDirectoryInvalid)
        return false
    if cdVersion >= uint32(131584):
        let cdTeamOff = heldExecBytesU32BE(bytes, cdBase + 48)
        if cdTeamOff != uint32(0):
            if !heldExecBytesReadCstring(
                   bytes, cdBase + int32(cdTeamOff),
                   cdBase + int32(cdLength), out.teamIdentifier):
                err = strings.CloneStr(
                    ChengHeldExecErrDarwinCodeDirectoryInvalid)
                return false
    out.codeDirectoryFlags = uint64(cdFlags)
    out.adHocSignature =
        (cdFlags & heldExecCsFlagAdHoc) != uint32(0)
    out.hardenedRuntime =
        (cdFlags & heldExecCsFlagRuntime) != uint32(0)
    out.libraryValidation =
        (cdFlags & heldExecCsFlagLibraryValidation) != uint32(0)
    out.codeDirectoryProven = true
    if requirementsOff != uint32(0):
        let reqBase = sigBase + int32(requirementsOff)
        if reqBase + 12 > sigBase + int32(blobLength) ||
           heldExecBytesU32BE(bytes, reqBase) !=
               heldExecCsMagicRequirements:
            err = strings.CloneStr(ChengHeldExecErrDarwinSuperblobInvalid)
            return false
        let reqLength = heldExecBytesU32BE(bytes, reqBase + 4)
        let reqCount = heldExecBytesU32BE(bytes, reqBase + 8)
        if reqLength > blobLength - requirementsOff ||
           reqCount > uint32(64) ||
           uint32(12) + reqCount * uint32(8) > reqLength:
            err = strings.CloneStr(ChengHeldExecErrDarwinSuperblobInvalid)
            return false
        var reqIndex: uint32
        while reqIndex < reqCount:
            let reqEntryBase = reqBase + 12 + int32(reqIndex) * 8
            let reqType = heldExecBytesU32BE(bytes, reqEntryBase)
            let reqBlobOff = heldExecBytesU32BE(bytes, reqEntryBase + 4)
            if reqBlobOff >= reqLength:
                err = strings.CloneStr(
                    ChengHeldExecErrDarwinSuperblobInvalid)
                return false
            if reqType == heldExecCsRequirementDesignatedType:
                let drBase = reqBase + int32(reqBlobOff)
                if drBase + 8 > reqBase + int32(reqLength) ||
                   heldExecBytesU32BE(bytes, drBase) !=
                       heldExecCsMagicRequirement:
                    err = strings.CloneStr(
                        ChengHeldExecErrDarwinSuperblobInvalid)
                    return false
                let drLength = heldExecBytesU32BE(bytes, drBase + 4)
                if drLength < uint32(8) ||
                   int32(drLength) >
                       reqBase + int32(reqLength) - drBase:
                    err = strings.CloneStr(
                        ChengHeldExecErrDarwinSuperblobInvalid)
                    return false
                var drView = rawbytes.BytesView(
                    heldExecPtrPlus(bytes.data, drBase), int32(drLength))
                out.designatedRequirementCid =
                    heldExecRawBytesCid(drView)
                out.designatedRequirementProven = true
            reqIndex = reqIndex + 1
    return true

@borrows
fn heldExecLinuxCollectIntegrity(
        platform: str,
        fd: int32,
        bytes: rawbytes.Bytes,
        out: var ChengHeldExecLinuxIntegrity,
        err: var str): bool =
    let size = rawbytes.BytesLen(bytes)
    if size < 64 ||
       rawbytes.BytesGet(bytes, 0) != 127 ||
       rawbytes.BytesGet(bytes, 1) != 69 ||
       rawbytes.BytesGet(bytes, 2) != 76 ||
       rawbytes.BytesGet(bytes, 3) != 70 ||
       rawbytes.BytesGet(bytes, 4) != 2 ||
       rawbytes.BytesGet(bytes, 5) != 1 ||
       rawbytes.BytesGet(bytes, 6) != 1:
        err = strings.CloneStr(ChengHeldExecErrLinuxElfInvalid)
        return false
    let elfType = heldExecBytesU16LE(bytes, 16)
    let elfMachine = heldExecBytesU16LE(bytes, 18)
    if elfType != 2 && elfType != 3:
        err = strings.CloneStr(ChengHeldExecErrLinuxElfInvalid)
        return false
    if platform == ChengHeldExecPlatformLinuxX64:
        if elfMachine != heldExecElfMachineX64:
            err = strings.CloneStr(ChengHeldExecErrLinuxElfInvalid)
            return false
    elif platform == ChengHeldExecPlatformLinuxA64:
        if elfMachine != heldExecElfMachineA64:
            err = strings.CloneStr(ChengHeldExecErrLinuxElfInvalid)
            return false
    else:
        err = strings.CloneStr(ChengHeldExecErrPlatformUnsupported)
        return false
    if heldExecBytesU32LE(bytes, 20) != uint32(1):
        err = strings.CloneStr(ChengHeldExecErrLinuxElfInvalid)
        return false
    var flagsBuf: uint8[8]
    heldExecZero8(flagsBuf)
    if heldExecLinuxGetFlagsBridge(fd, flagsBuf) != 0:
        err = strings.CloneStr(ChengHeldExecErrLinuxGetflagsFailed)
        return false
    let inodeFlags = heldExecReadU32From8(flagsBuf, 0)
    out.inodeFlags = uint64(inodeFlags)
    out.inodeImmutableProven =
        (inodeFlags & heldExecLinuxFsImmutableFl) != uint32(0)
    var digest: uint8[32]
    heldExecZero32(digest)
    if heldExecLinuxMeasureVerityBridge(fd, digest) != 0:
        err = strings.CloneStr(ChengHeldExecErrLinuxFsverityMeasureFailed)
        return false
    var digestBytes = rawbytes.BytesAlloc(32)
    var digestIndex: int32
    while digestIndex < 32:
        rawbytes.BytesSet(digestBytes, digestIndex, int32(digest[digestIndex]))
        digestIndex = digestIndex + 1
    out.fsVerityDigestCid = heldExecRawBytesCid(digestBytes)
    rawbytes.BytesFree(digestBytes)
    out.fsVerityProven = true
    return true

@borrows
fn heldExecIdentityCollectNamedBeforeInto(
        platform: str,
        fixedPath: str,
        out: var ChengHeldExecFileEvidence,
        err: var str): bool =
    out = ChengHeldExecFileEvidence()
    if platform != ChengHeldExecPlatformDarwin &&
       platform != ChengHeldExecPlatformLinuxX64 &&
       platform != ChengHeldExecPlatformLinuxA64:
        err = strings.CloneStr(ChengHeldExecErrPlatformUnsupported)
        return false
    if fixedPath.len == 0 || fixedPath[0] != 47:
        err = strings.CloneStr(ChengHeldExecErrPlatformUnsupported)
        return false
    out.fixedPath = strings.CloneStr(fixedPath)
    var namedBefore: ChengHeldExecStatEvidence
    if !heldExecNamedStat(platform, fixedPath, namedBefore):
        err = strings.CloneStr(ChengHeldExecErrNamedStatFailed)
        return false
    if (namedBefore.mode & heldExecFileTypeMask) !=
           heldExecRegularFileMode:
        err = strings.CloneStr(ChengHeldExecErrNamedStatFailed)
        return false
    out.namedBefore = namedBefore
    return true

@borrows
fn heldExecIdentityCollectOpenFileInto(
        platform: str,
        fixedPath: str,
        fd: int32,
        out: var ChengHeldExecFileEvidence,
        err: var str): bool =
    var held: ChengHeldExecStatEvidence
    if !heldExecHeldStat(platform, fd, held):
        err = strings.CloneStr(ChengHeldExecErrHeldStatFailed)
        return false
    out.held = held
    if !heldExecHeldPathMatches(platform, fd, fixedPath, out.held):
        if platform == ChengHeldExecPlatformDarwin:
            err = strings.CloneStr(ChengHeldExecErrDarwinVnodeMismatch)
        else:
            err = strings.CloneStr(ChengHeldExecErrLinuxProcFdMismatch)
        return false
    out.heldDescriptorPathProven = true
    var bytes: rawbytes.Bytes
    var linuxHeader: uint8[64]
    if platform == ChengHeldExecPlatformDarwin:
        if !heldExecReadHeldBytes(fd, held.size, bytes):
            if held.size > heldExecMaxFileBytes:
                err = strings.CloneStr(ChengHeldExecErrHeldFileTooLarge)
            else:
                err = strings.CloneStr(ChengHeldExecErrHeldReadFailed)
            return false
        out.bytesCid = heldExecRawBytesCid(bytes)
    else:
        let headerBytes = heldExecOsPreadFixed64(
            fd, linuxHeader, int64(64), int64(0))
        if headerBytes != int64(64):
            err = strings.CloneStr(ChengHeldExecErrHeldReadFailed)
            return false
        var hashStatus: int32
        let streamedBytesCid = heldExecStreamHeldBytesCid(
            fd, held.size, hashStatus)
        if streamedBytesCid.len != 71:
            err = ChengHeldExecErrHeldReadFailed + ":" +
                strings.IntToStr(hashStatus)
            return false
        out.bytesCid = streamedBytesCid
    var namedAfter: ChengHeldExecStatEvidence
    if !heldExecNamedStat(platform, fixedPath, namedAfter):
        rawbytes.BytesFree(bytes)
        err = strings.CloneStr(ChengHeldExecErrNamedPathFenceDrift)
        return false
    out.namedAfter = namedAfter
    if !heldExecStatEqual(out.namedBefore, out.held):
        rawbytes.BytesFree(bytes)
        err = strings.CloneStr(ChengHeldExecErrNamedHeldDrift)
        return false
    if !heldExecStatEqual(out.held, out.namedAfter):
        rawbytes.BytesFree(bytes)
        err = strings.CloneStr(ChengHeldExecErrNamedPathFenceDrift)
        return false
    out.namedHeldFenceClosed = true
    if platform == ChengHeldExecPlatformDarwin:
        out.linux.openat2ResolveProven = false
        var codesignErr: str
        if !heldExecDarwinParseCodesign(bytes, out.darwin, codesignErr):
            out.nativeImageError = codesignErr
        else:
            out.nativeImageProven = true
    else:
        out.linux.openat2ResolveProven = true
        out.linux.procFdPathProven = true
        var integrityErr: str
        var linuxHeaderView = rawbytes.BytesAlloc(64)
        var linuxHeaderIndex: int32
        while linuxHeaderIndex < 64:
            rawbytes.BytesSet(linuxHeaderView, linuxHeaderIndex,
                              int32(linuxHeader[linuxHeaderIndex]))
            linuxHeaderIndex = linuxHeaderIndex + 1
        if !heldExecLinuxCollectIntegrity(
               platform,
               fd,
               linuxHeaderView,
               out.linux,
               integrityErr):
            out.nativeImageError = integrityErr
        else:
            out.nativeImageProven = true
        rawbytes.BytesFree(linuxHeaderView)
    rawbytes.BytesFree(bytes)
    err = ""
    return true

@borrows
fn ChengHeldExecIdentityCollectFileInto(
        platform: str,
        fixedPath: str,
        out: var ChengHeldExecFileEvidence,
        err: var str): bool =
    if !heldExecIdentityCollectNamedBeforeInto(
           platform, fixedPath, out, err):
        return false
    let fd = heldExecOpenHeld(platform, fixedPath)
    if fd < 0:
        if platform == ChengHeldExecPlatformDarwin:
            err = strings.CloneStr(ChengHeldExecErrHeldOpenFailed)
        else:
            err = strings.CloneStr(ChengHeldExecErrLinuxOpenat2Failed)
        return false
    let ok = heldExecIdentityCollectOpenFileInto(
        platform, fixedPath, fd, out, err)
    let _close = heldExecOsClose(fd)
    return ok

@borrows
fn ChengHeldExecIdentityCollectRetainedFileInto(
        platform: str,
        fixedPath: str,
        retainedFd: int32,
        out: var ChengHeldExecFileEvidence,
        err: var str): bool =
    if retainedFd < 0:
        err = strings.CloneStr(ChengHeldExecErrHeldOpenFailed)
        return false
    if !heldExecIdentityCollectNamedBeforeInto(
           platform, fixedPath, out, err):
        return false
    return heldExecIdentityCollectOpenFileInto(
        platform, fixedPath, retainedFd, out, err)

@borrows
fn ChengHeldExecIdentityOpenRetainedFileInto(
        platform: str,
        fixedPath: str,
        outFd: var int32,
        out: var ChengHeldExecFileEvidence,
        err: var str): bool =
    outFd = -1
    if !heldExecIdentityCollectNamedBeforeInto(
           platform, fixedPath, out, err):
        return false
    let fd = heldExecOpenHeld(platform, fixedPath)
    if fd < 0:
        if platform == ChengHeldExecPlatformDarwin:
            err = strings.CloneStr(ChengHeldExecErrHeldOpenFailed)
        else:
            err = strings.CloneStr(ChengHeldExecErrLinuxOpenat2Failed)
        return false
    if !heldExecIdentityCollectOpenFileInto(
           platform, fixedPath, fd, out, err):
        let _close = heldExecOsClose(fd)
        return false
    outFd = fd
    return true

fn ChengHeldExecIdentityCloseRetainedFile(fd: int32): bool =
    if fd < 0:
        return false
    return heldExecOsClose(fd) == 0

@borrows
fn heldExecDarwinIssuanceBarError(
        value: ChengHeldExecFileEvidence): str =
    if !value.nativeImageProven:
        if value.nativeImageError.len != 0:
            return strings.CloneStr(value.nativeImageError)
        return strings.CloneStr(ChengHeldExecErrDarwinMachoInvalid)
    if !value.darwin.codeDirectoryProven:
        return strings.CloneStr(ChengHeldExecErrDarwinCodeDirectoryInvalid)
    if value.darwin.adHocSignature:
        return strings.CloneStr(ChengHeldExecErrDarwinAdhocSignature)
    if !value.darwin.hardenedRuntime ||
       !value.darwin.libraryValidation:
        return strings.CloneStr(ChengHeldExecErrDarwinHardenedRuntimeMissing)
    if !value.darwin.designatedRequirementProven ||
       value.darwin.teamIdentifier.len == 0 ||
       value.darwin.signingIdentifier.len == 0:
        return strings.CloneStr(
            ChengHeldExecErrDarwinDesignatedRequirementMissing)
    if (value.held.inodeFlags &
            uint64(heldExecDarwinSfImmutable)) == uint64(0):
        return strings.CloneStr(ChengHeldExecErrDarwinSystemImmutableMissing)
    return ""

@borrows
fn heldExecLinuxIssuanceBarError(
        value: ChengHeldExecFileEvidence): str =
    if !value.nativeImageProven:
        if value.nativeImageError.len != 0:
            return strings.CloneStr(value.nativeImageError)
        return strings.CloneStr(ChengHeldExecErrLinuxElfInvalid)
    if !value.linux.openat2ResolveProven ||
       !value.linux.procFdPathProven:
        return strings.CloneStr(ChengHeldExecErrLinuxOpenat2Failed)
    if !value.linux.inodeImmutableProven:
        return strings.CloneStr(ChengHeldExecErrLinuxInodeImmutableMissing)
    if !value.linux.fsVerityProven:
        return strings.CloneStr(ChengHeldExecErrLinuxFsverityMissing)
    return ""

@borrows
fn ChengHeldExecIdentityFileIssuanceBarError(
        platform: str,
        value: ChengHeldExecFileEvidence): str =
    if platform != ChengHeldExecIdentityPlatform() ||
       value.fixedPath != ChengHeldExecIdentityBinaryFixedPath(platform):
        return strings.CloneStr(ChengHeldExecErrPlatformUnsupported)
    if platform == ChengHeldExecPlatformDarwin:
        return heldExecDarwinIssuanceBarError(value)
    if platform == ChengHeldExecPlatformLinuxX64 ||
       platform == ChengHeldExecPlatformLinuxA64:
        return heldExecLinuxIssuanceBarError(value)
    return strings.CloneStr(ChengHeldExecErrPlatformUnsupported)

fn ChengHeldExecIdentityIssueInto(
        out: var ChengHeldExecIdentityIssueResult,
        err: var str): bool =
    out = ChengHeldExecIdentityIssueResult()
    out.evidence.schema = strings.CloneStr(ChengHeldExecIdentitySchema)
    let platform = ChengHeldExecIdentityPlatform()
    if platform != ChengHeldExecPlatformDarwin &&
       platform != ChengHeldExecPlatformLinuxX64 &&
       platform != ChengHeldExecPlatformLinuxA64:
        out.error = strings.CloneStr(ChengHeldExecErrPlatformUnsupported)
        err = strings.CloneStr(out.error)
        return false
    out.evidence.platform = strings.CloneStr(platform)
    let launcherPath = ChengHeldExecIdentityLauncherFixedPath(platform)
    let binaryPath = ChengHeldExecIdentityBinaryFixedPath(platform)
    if launcherPath.len == 0 || binaryPath.len == 0:
        out.error = strings.CloneStr(ChengHeldExecErrPlatformUnsupported)
        err = strings.CloneStr(out.error)
        return false
    var collectErr: str
    if !ChengHeldExecIdentityCollectFileInto(
           platform, launcherPath, out.evidence.launcher, collectErr):
        out.error = strings.CloneStr(collectErr)
        err = strings.CloneStr(collectErr)
        return false
    if !ChengHeldExecIdentityCollectFileInto(
           platform, binaryPath, out.evidence.binary, collectErr):
        out.error = strings.CloneStr(collectErr)
        err = strings.CloneStr(collectErr)
        return false
    if (out.evidence.launcher.held.device ==
            out.evidence.binary.held.device &&
        out.evidence.launcher.held.inode ==
            out.evidence.binary.held.inode) ||
       out.evidence.launcher.held.size ==
           out.evidence.binary.held.size &&
       out.evidence.launcher.bytesCid ==
           out.evidence.binary.bytesCid:
        out.error = strings.CloneStr(ChengHeldExecErrLauncherBinaryAliased)
        err = strings.CloneStr(out.error)
        return false
    if platform == ChengHeldExecPlatformDarwin:
        let launcherBar =
            heldExecDarwinIssuanceBarError(out.evidence.launcher)
        if launcherBar.len != 0:
            out.error = launcherBar
            err = strings.CloneStr(out.error)
            return false
        let binaryBar =
            heldExecDarwinIssuanceBarError(out.evidence.binary)
        if binaryBar.len != 0:
            out.error = binaryBar
            err = strings.CloneStr(out.error)
            return false
    else:
        let launcherBar =
            heldExecLinuxIssuanceBarError(out.evidence.launcher)
        if launcherBar.len != 0:
            out.error = launcherBar
            err = strings.CloneStr(out.error)
            return false
        let binaryBar =
            heldExecLinuxIssuanceBarError(out.evidence.binary)
        if binaryBar.len != 0:
            out.error = binaryBar
            err = strings.CloneStr(out.error)
            return false
    out.ok = true
    err = ""
    return true

@borrows
fn ChengHeldExecIdentityFourLegClosureError(
        identityIssued: bool,
        headLeaseReceiptCid: str,
        headLeaseProven: bool,
        allocationLedgerReceiptCid: str,
        allocationLedgerProven: bool,
        csgAuthorityReceiptCid: str,
        csgAuthorityProven: bool): str =
    if !identityIssued:
        return strings.CloneStr(ChengHeldExecErrLegIdentityMissing)
    if !headLeaseProven || !heldExecCidValid(headLeaseReceiptCid):
        return strings.CloneStr(ChengHeldExecErrLegHeadLeaseMissing)
    if !allocationLedgerProven ||
       !heldExecCidValid(allocationLedgerReceiptCid):
        return strings.CloneStr(ChengHeldExecErrLegAllocationLedgerMissing)
    if !csgAuthorityProven || !heldExecCidValid(csgAuthorityReceiptCid):
        return strings.CloneStr(ChengHeldExecErrLegCsgAuthorityMissing)
    if headLeaseReceiptCid == allocationLedgerReceiptCid ||
       headLeaseReceiptCid == csgAuthorityReceiptCid ||
       allocationLedgerReceiptCid == csgAuthorityReceiptCid:
        return strings.CloneStr(ChengHeldExecErrLegReceiptAliased)
    return ""

fn ChengHeldExecIdentityPrimitivesAvailable(): bool =
    var result: ChengHeldExecIdentityIssueResult
    var err: str
    return ChengHeldExecIdentityIssueInto(result, err)
