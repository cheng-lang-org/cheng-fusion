# web_console_runtime.cheng
# Web Console API for Cheng Web runtime.
# Provides: WebConsole type, log/warn/error/info/debug/table/trace/group/time/count/clear

import std/strings

importc fn cheng_epoch_time_ms(): int64

type
    WebConsole =
        indentLevel: int32
        timers: WebConsoleTimer[]

    WebConsoleTimer =
        label: str
        startMs: int64

fn WebConsoleInit(console: var WebConsole) =
    console.indentLevel = 0
    console.timers = []

fn WebConsoleLog(console: var WebConsole, message: str) =
    var indent: str
    for i in 0..<console.indentLevel:
        indent = strings.concatStr(indent, "  ")
    let output = strings.concatStr(indent, message)
    echo(output)

fn WebConsoleWarn(console: var WebConsole, message: str) =
    let output = strings.concatStr("⚠ ", message)
    echo(output)

fn WebConsoleError(console: var WebConsole, message: str) =
    let output = strings.concatStr("✗ ", message)
    echo(output)

fn WebConsoleInfo(console: var WebConsole, message: str) =
    WebConsoleLog(console, message)

fn WebConsoleDebug(console: var WebConsole, message: str) =
    WebConsoleLog(console, message)

fn WebConsoleTable(console: var WebConsole, data: str) =
    WebConsoleLog(console, data)

fn WebConsoleTrace(console: var WebConsole, message: str) =
    let output = strings.concatStr(message, " (trace)")
    echo(output)

fn WebConsoleGroup(console: var WebConsole, label: str) =
    echo(label)
    console.indentLevel = console.indentLevel + 1

fn WebConsoleGroupEnd(console: var WebConsole) =
    if console.indentLevel > 0:
        console.indentLevel = console.indentLevel - 1

fn WebConsoleTime(console: var WebConsole, label: str) =
    var timer: WebConsoleTimer
    timer.label = label
    timer.startMs = cheng_epoch_time_ms()
    add(console.timers, timer)

fn WebConsoleTimeEnd(console: var WebConsole, label: str, out: var str): bool =
    let now = cheng_epoch_time_ms()
    var timerIndex: int32 = -1
    for i in 0..<console.timers.len:
        if console.timers[i].label == label:
            timerIndex = i
            break
    if timerIndex < 0:
        out = ""
        return false
    let elapsed = now - console.timers[timerIndex].startMs
    var newTimers: WebConsoleTimer[]
    for i in 0..<console.timers.len:
        if i != timerIndex:
            add(newTimers, console.timers[i])
    console.timers = newTimers
    let output = strings.concatStr(strings.concatStr(label, ": "),
                     strings.concatStr(strings.Int64ToStr(elapsed), "ms"))
    echo(output)
    out = output
    return true

fn WebConsoleClear(console: var WebConsole) =
    # no-op (cannot clear screen)
    console.indentLevel = console.indentLevel

fn WebConsoleCount(console: var WebConsole, label: str) =
    let output = strings.concatStr(label, ": 1")
    echo(output)

fn WebConsoleValueToString(value: str): str =
    return value
