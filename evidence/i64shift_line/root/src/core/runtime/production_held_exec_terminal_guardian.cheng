# Stable held-exec terminal guardian.
#
# The production launcher enters this module before it can issue a journal or
# fork a held child.  Public identity stays int32-only; durable CIDs, OS
# descriptors and process credentials remain in the journal/provider private
# SoA registries.  The session run/recovery entry is intentionally not
# published until the direct-inode terminal capsule is installed: startup is
# a real production edge, while incomplete terminal authority remains
# fail-closed.

import std/atomic
import std/os
import std/system
import cheng/core/csg_core/merkle_store

const
    productionHeldExecTerminalGuardianRowCount: int32 = 4096
    productionHeldExecTerminalGuardianStateBuilding: int32 = 1
    productionHeldExecTerminalGuardianStateReady: int32 = 2
    productionHeldExecTerminalGuardianStateActivating: int32 = 3
    productionHeldExecTerminalGuardianStateActive: int32 = 4
    productionHeldExecTerminalGuardianStateRecoveryRequired: int32 = 5
    productionHeldExecTerminalGuardianStateDetached: int32 = 6
    productionHeldExecTerminalGuardianStateFinishing: int32 = 7
    productionHeldExecTerminalGuardianStateFinished: int32 = 8
    productionHeldExecTerminalGuardianStateFinalizingProvider: int32 = 9
    productionHeldExecTerminalGuardianStateProviderFinalized: int32 = 10
    productionHeldExecTerminalGuardianStateObservingExit: int32 = 11
    productionHeldExecTerminalGuardianStateExitObserved: int32 = 12
    productionHeldExecTerminalGuardianStateReaping: int32 = 13
    productionHeldExecTerminalGuardianStateReaped: int32 = 14
    productionHeldExecTerminalGuardianStateDraining: int32 = 15
    productionHeldExecTerminalGuardianRegistryEmpty: int32 = 0
    productionHeldExecTerminalGuardianRegistryOpening: int32 = 1
    productionHeldExecTerminalGuardianRegistryReady: int32 = 2
    productionHeldExecTerminalGuardianRegistryRecoveryRequired: int32 = 3

var
    productionHeldExecTerminalGuardianRegistryState: int32
    productionHeldExecTerminalGuardianNextRow: atomic.I32
    productionHeldExecTerminalGuardianStates: atomic.I32[]
    productionHeldExecTerminalGuardianClaimOwners: int32[]
    productionHeldExecTerminalGuardianJournalOwners: int32[]
    productionHeldExecTerminalGuardianDecisionOwners: int32[]

fn CsgCoreProductionHeldExecTerminalGuardianInitializeBeforeLoop(): bool =
    var builder = false
    while !builder:
        os.CsgCurrentHeadLeaseRegistryLock()
        let state = system.RuntimeAtomicLoadI32(
            productionHeldExecTerminalGuardianRegistryState)
        if state == productionHeldExecTerminalGuardianRegistryReady:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return true
        if state ==
               productionHeldExecTerminalGuardianRegistryRecoveryRequired:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
        if state == productionHeldExecTerminalGuardianRegistryEmpty:
            builder = system.RuntimeAtomicCompareExchangeI32(
                productionHeldExecTerminalGuardianRegistryState,
                productionHeldExecTerminalGuardianRegistryEmpty,
                productionHeldExecTerminalGuardianRegistryOpening)
            os.CsgCurrentHeadLeaseRegistryUnlock()
        elif state == productionHeldExecTerminalGuardianRegistryOpening:
            let observedEpoch = os.CsgCurrentHeadLeaseRegistryEpoch()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)
        else:
            os.CsgCurrentHeadLeaseRegistryUnlock()
            panic("production terminal guardian registry state invalid")
    if !merkle_store.ProductionAdmittedClaimAuthorityInitializeBeforeFork() ||
       !merkle_store.ProductionTerminalJournalInitializeBeforeGuardianLoop():
        os.CsgCurrentHeadLeaseRegistryLock()
        system.RuntimeAtomicStoreI32(
            productionHeldExecTerminalGuardianRegistryState,
            productionHeldExecTerminalGuardianRegistryRecoveryRequired)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        return false
    setLen(
        productionHeldExecTerminalGuardianStates,
        productionHeldExecTerminalGuardianRowCount)
    setLen(
        productionHeldExecTerminalGuardianClaimOwners,
        productionHeldExecTerminalGuardianRowCount)
    setLen(
        productionHeldExecTerminalGuardianJournalOwners,
        productionHeldExecTerminalGuardianRowCount)
    setLen(
        productionHeldExecTerminalGuardianDecisionOwners,
        productionHeldExecTerminalGuardianRowCount)
    for row in 0..<productionHeldExecTerminalGuardianRowCount:
        productionHeldExecTerminalGuardianStates[row] = atomic.NewI32(0)
        productionHeldExecTerminalGuardianClaimOwners[row] = -1
        productionHeldExecTerminalGuardianJournalOwners[row] = -1
        productionHeldExecTerminalGuardianDecisionOwners[row] = -1
        if productionHeldExecTerminalGuardianStates[row] == nil:
            os.CsgCurrentHeadLeaseRegistryLock()
            system.RuntimeAtomicStoreI32(
                productionHeldExecTerminalGuardianRegistryState,
                productionHeldExecTerminalGuardianRegistryRecoveryRequired)
            os.CsgCurrentHeadLeaseRegistryNotifyAll()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            return false
    productionHeldExecTerminalGuardianNextRow = atomic.NewI32(0)
    if productionHeldExecTerminalGuardianNextRow == nil:
        os.CsgCurrentHeadLeaseRegistryLock()
        system.RuntimeAtomicStoreI32(
            productionHeldExecTerminalGuardianRegistryState,
            productionHeldExecTerminalGuardianRegistryRecoveryRequired)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        return false
    os.CsgCurrentHeadLeaseRegistryLock()
    if system.RuntimeAtomicLoadI32(
           productionHeldExecTerminalGuardianRegistryState) !=
           productionHeldExecTerminalGuardianRegistryOpening:
        system.RuntimeAtomicStoreI32(
            productionHeldExecTerminalGuardianRegistryState,
            productionHeldExecTerminalGuardianRegistryRecoveryRequired)
        os.CsgCurrentHeadLeaseRegistryNotifyAll()
        os.CsgCurrentHeadLeaseRegistryUnlock()
        panic("production terminal guardian registry publication drift")
    system.RuntimeAtomicStoreI32(
        productionHeldExecTerminalGuardianRegistryState,
        productionHeldExecTerminalGuardianRegistryReady)
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()
    return true

# Drain the policy-bound durable session index before any new admission can
# be issued.  The root owner moves into one recovered journal row at a time,
# then moves back only after provider-finalized decision bytes are installed
# in the child mirror and the recovery cursor is released.
fn CsgCoreProductionHeldExecTerminalGuardianRecoverAllInto(
        rootOwner: var int32,
        err: var str): bool =
    if productionHeldExecTerminalGuardianRegistryState != 2 ||
       rootOwner <= 0:
        err = "production_terminal_guardian_recovery_root_invalid"
        return false
    var ownedRootOwner = rootOwner
    rootOwner = -1
    while true:
        var journalOwner: int32 = -1
        if !merkle_store.ProductionTerminalJournalRecoverInto(
               ownedRootOwner, journalOwner):
            if ownedRootOwner <= 0 || journalOwner != -1:
                panic("production terminal guardian recovery exhaustion drift")
            # Recovery exhaustion deliberately retains the global recovery
            # lock.  The admitted CLAIMED transaction must first install and
            # hold its per-session live lock; only that atomic publication
            # edge may release the global lock.
            rootOwner = ownedRootOwner
            err = ""
            return true
        if ownedRootOwner != -1 || journalOwner <= 0:
            panic("production terminal guardian recovery owner move failed")
        if !merkle_store.ProductionTerminalJournalFinalizeRecoveredProviderInto(
               journalOwner, err):
            panic("production terminal guardian recovered provider finalize failed")
        if !merkle_store.ProductionTerminalJournalMirrorRecoveredDecisionInto(
               journalOwner, err):
            panic("production terminal guardian recovered decision mirror failed")
        var returnedRootOwner: int32 = -1
        if !merkle_store.ProductionTerminalJournalDetachRecoveredAndReturnRootInto(
               journalOwner, returnedRootOwner, err) ||
           returnedRootOwner <= 0:
            panic("production terminal guardian recovered root return failed")
        ownedRootOwner = returnedRootOwner

fn CsgCoreProductionHeldExecTerminalGuardianFinalizeProviderInto(
        claimOwner: int32,
        outDecisionOwner: var int32,
        err: var str): bool =
    outDecisionOwner = -1
    let row = claimOwner - 1
    if productionHeldExecTerminalGuardianRegistryState != 2 || row < 0 ||
       row >= productionHeldExecTerminalGuardianRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalGuardianNextRow) ||
       !atomic.CasI32(
           productionHeldExecTerminalGuardianStates[row],
           productionHeldExecTerminalGuardianStateFinished,
           productionHeldExecTerminalGuardianStateFinalizingProvider):
        err = "production_terminal_guardian_finalize_owner_invalid"
        return false
    var decisionOwner: int32
    if !merkle_store.ProductionTerminalJournalFinalizeProviderFromFinishedInto(
           productionHeldExecTerminalGuardianJournalOwners[row],
           decisionOwner,
           err):
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        return false
    if !merkle_store.ProductionTerminalJournalMirrorAndSendDecisionInto(
           productionHeldExecTerminalGuardianJournalOwners[row], err):
        productionHeldExecTerminalGuardianDecisionOwners[row] =
            decisionOwner
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        return false
    productionHeldExecTerminalGuardianDecisionOwners[row] = decisionOwner
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateProviderFinalized)
    outDecisionOwner = decisionOwner
    err = ""
    return true

fn CsgCoreProductionHeldExecTerminalGuardianObserveExitInto(
        claimOwner: int32,
        err: var str): bool =
    let row = claimOwner - 1
    if productionHeldExecTerminalGuardianRegistryState != 2 || row < 0 ||
       row >= productionHeldExecTerminalGuardianRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalGuardianNextRow) ||
       !atomic.CasI32(
           productionHeldExecTerminalGuardianStates[row],
           productionHeldExecTerminalGuardianStateProviderFinalized,
           productionHeldExecTerminalGuardianStateObservingExit):
        err = "production_terminal_guardian_exit_observation_owner_invalid"
        return false
    if !merkle_store.ProductionTerminalJournalObserveExitFromProviderFinalizedInto(
           productionHeldExecTerminalGuardianJournalOwners[row], err):
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        return false
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateExitObserved)
    err = ""
    return true

fn CsgCoreProductionHeldExecTerminalGuardianReapInto(
        claimOwner: int32,
        err: var str): bool =
    let row = claimOwner - 1
    if productionHeldExecTerminalGuardianRegistryState != 2 || row < 0 ||
       row >= productionHeldExecTerminalGuardianRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalGuardianNextRow) ||
       !atomic.CasI32(
           productionHeldExecTerminalGuardianStates[row],
           productionHeldExecTerminalGuardianStateExitObserved,
           productionHeldExecTerminalGuardianStateReaping):
        err = "production_terminal_guardian_reap_owner_invalid"
        return false
    if !merkle_store.ProductionTerminalJournalReapFromExitObservedInto(
           productionHeldExecTerminalGuardianJournalOwners[row], err):
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        return false
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateReaped)
    err = ""
    return true

fn CsgCoreProductionHeldExecTerminalGuardianDrainAfterReapInto(
        claimOwner: int32,
        outExitCode: var int32,
        err: var str): bool =
    outExitCode = -1
    let row = claimOwner - 1
    if productionHeldExecTerminalGuardianRegistryState != 2 || row < 0 ||
       row >= productionHeldExecTerminalGuardianRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalGuardianNextRow) ||
       !atomic.CasI32(
           productionHeldExecTerminalGuardianStates[row],
           productionHeldExecTerminalGuardianStateReaped,
           productionHeldExecTerminalGuardianStateDraining):
        err = "production_terminal_guardian_drain_owner_invalid"
        return false
    if !merkle_store.ProductionTerminalJournalDrainAfterReapInto(
           productionHeldExecTerminalGuardianJournalOwners[row],
           outExitCode,
           err):
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        return false
    productionHeldExecTerminalGuardianClaimOwners[row] = -1
    productionHeldExecTerminalGuardianJournalOwners[row] = -1
    productionHeldExecTerminalGuardianDecisionOwners[row] = -1
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateDetached)
    let guardianRows = atomic.LoadI32(
        productionHeldExecTerminalGuardianNextRow)
    for scan in 0..<guardianRows:
        let state = atomic.LoadI32(
            productionHeldExecTerminalGuardianStates[scan])
        if state != 0 &&
           state != productionHeldExecTerminalGuardianStateDetached:
            panic("production terminal guardian registry drain incomplete")
    productionHeldExecTerminalGuardianStates = []
    productionHeldExecTerminalGuardianClaimOwners = []
    productionHeldExecTerminalGuardianJournalOwners = []
    productionHeldExecTerminalGuardianDecisionOwners = []
    productionHeldExecTerminalGuardianNextRow = nil
    system.RuntimeAtomicStoreI32(
        productionHeldExecTerminalGuardianRegistryState,
        productionHeldExecTerminalGuardianRegistryEmpty)
    err = ""
    return true

# Establish one CLAIMED durable owner from the exact store-root owner already
# bound into the admitted provider row before ISSUED became visible.  The
# journal independently joins that immutable binding to the authenticated
# runtime claim.  This surface carries only append-only int32 owners.
fn CsgCoreProductionHeldExecTerminalGuardianBeginInto(
        runtimeSession: int32,
        admittedOwner: var int32,
        outClaimOwner: var int32,
        err: var str): bool =
    outClaimOwner = -1
    if admittedOwner <= 0:
        err = "production_terminal_guardian_claimed_owner_invalid"
        return false
    var ownedAdmittedOwner = admittedOwner
    admittedOwner = -1
    if productionHeldExecTerminalGuardianRegistryState != 2 ||
       runtimeSession <= 0:
        var abortInvalidErr: str
        if !merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
               ownedAdmittedOwner, abortInvalidErr):
            panic("production terminal guardian invalid begin abort failed")
        err = "production_terminal_guardian_claimed_owner_invalid"
        return false
    let row = atomic.FetchAddI32(
        productionHeldExecTerminalGuardianNextRow, 1)
    if row < 0 || row >= productionHeldExecTerminalGuardianRowCount:
        var abortArenaErr: str
        if !merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
               ownedAdmittedOwner, abortArenaErr):
            panic("production terminal guardian arena abort failed")
        err = "production_terminal_guardian_owner_arena_exhausted"
        return false
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateBuilding)
    var durableClaimOwner: int32
    if !merkle_store.ProductionAdmittedClaimAuthorityClaimDurableInto(
           ownedAdmittedOwner,
           runtimeSession,
           durableClaimOwner,
           err):
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        return false
    var journalOwner: int32
    if !merkle_store.ProductionTerminalJournalBeginFromDurableClaimOwnerInto(
           durableClaimOwner,
           journalOwner,
           err):
        productionHeldExecTerminalGuardianClaimOwners[row] =
            durableClaimOwner
        productionHeldExecTerminalGuardianJournalOwners[row] = journalOwner
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        if journalOwner > 0:
            var detachJournalErr: str
            if !merkle_store.ProductionTerminalJournalDetachForGuardianRecoveryInto(
                   journalOwner, detachJournalErr):
                panic("production terminal guardian begin journal detach failed")
        elif durableClaimOwner > 0:
            var releaseClaimErr: str
            if !merkle_store.ProductionAdmittedClaimAuthorityReleaseDurableForRecoveryInto(
                   durableClaimOwner, releaseClaimErr):
                panic("production terminal guardian begin claim release failed")
        else:
            panic("production terminal guardian begin lost recovery owner")
        productionHeldExecTerminalGuardianClaimOwners[row] = -1
        productionHeldExecTerminalGuardianJournalOwners[row] = -1
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateDetached)
        return false
    productionHeldExecTerminalGuardianClaimOwners[row] = -1
    productionHeldExecTerminalGuardianJournalOwners[row] = journalOwner
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateReady)
    outClaimOwner = row + 1
    err = ""
    return true

fn CsgCoreProductionHeldExecTerminalGuardianActivateInto(
        claimOwner: int32,
        err: var str): bool =
    let row = claimOwner - 1
    if productionHeldExecTerminalGuardianRegistryState != 2 || row < 0 ||
       row >= productionHeldExecTerminalGuardianRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalGuardianNextRow) ||
       !atomic.CasI32(
           productionHeldExecTerminalGuardianStates[row],
           productionHeldExecTerminalGuardianStateReady,
           productionHeldExecTerminalGuardianStateActivating):
        err = "production_terminal_guardian_activate_owner_invalid"
        return false
    if !merkle_store.ProductionTerminalJournalActivateAdmittedInto(
           productionHeldExecTerminalGuardianJournalOwners[row], err):
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        return false
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateActive)
    err = ""
    return true

@borrows
fn CsgCoreProductionHeldExecTerminalGuardianFinishInto(
        claimOwner: int32,
        outputPath: str,
        err: var str): bool =
    let row = claimOwner - 1
    if productionHeldExecTerminalGuardianRegistryState != 2 || row < 0 ||
       row >= productionHeldExecTerminalGuardianRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalGuardianNextRow) ||
       !atomic.CasI32(
           productionHeldExecTerminalGuardianStates[row],
           productionHeldExecTerminalGuardianStateActive,
           productionHeldExecTerminalGuardianStateFinishing):
        err = "production_terminal_guardian_finish_owner_invalid"
        return false
    if !merkle_store.ProductionTerminalJournalFinishAdmittedInto(
           productionHeldExecTerminalGuardianJournalOwners[row],
           outputPath,
           err):
        atomic.StoreI32(
            productionHeldExecTerminalGuardianStates[row],
            productionHeldExecTerminalGuardianStateRecoveryRequired)
        return false
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateFinished)
    err = ""
    return true

fn CsgCoreProductionHeldExecTerminalGuardianDetachForRecoveryInto(
        claimOwner: int32,
        err: var str): bool =
    let row = claimOwner - 1
    if productionHeldExecTerminalGuardianRegistryState != 2 || row < 0 ||
       row >= productionHeldExecTerminalGuardianRowCount ||
       row >= atomic.LoadI32(productionHeldExecTerminalGuardianNextRow):
        err = "production_terminal_guardian_detach_owner_invalid"
        return false
    let prior = atomic.LoadI32(
        productionHeldExecTerminalGuardianStates[row])
    if (prior != productionHeldExecTerminalGuardianStateReady &&
        prior != productionHeldExecTerminalGuardianStateActive &&
        prior != productionHeldExecTerminalGuardianStateFinished &&
        prior != productionHeldExecTerminalGuardianStateProviderFinalized &&
        prior != productionHeldExecTerminalGuardianStateRecoveryRequired) ||
       !atomic.CasI32(
           productionHeldExecTerminalGuardianStates[row],
           prior,
           productionHeldExecTerminalGuardianStateRecoveryRequired):
        err = "production_terminal_guardian_detach_state_invalid"
        return false
    let journalOwner =
        productionHeldExecTerminalGuardianJournalOwners[row]
    let remainingClaimOwner =
        productionHeldExecTerminalGuardianClaimOwners[row]
    if journalOwner > 0:
        if !merkle_store.ProductionTerminalJournalDetachForGuardianRecoveryInto(
               journalOwner, err):
            return false
    elif remainingClaimOwner > 0:
        if !merkle_store.ProductionAdmittedClaimAuthorityReleaseDurableForRecoveryInto(
               remainingClaimOwner, err):
            return false
    else:
        err = "production_terminal_guardian_detach_authority_missing"
        return false
    productionHeldExecTerminalGuardianClaimOwners[row] = -1
    productionHeldExecTerminalGuardianJournalOwners[row] = -1
    atomic.StoreI32(
        productionHeldExecTerminalGuardianStates[row],
        productionHeldExecTerminalGuardianStateDetached)
    err = ""
    return true
