type
    WebFontTable =
        offset: int32
        length: int32

    WebFontFace =
        data: int32[]
        loaded: bool
        cffDetected: bool
        fingerprint: int32
        unitsPerEm: int32
        numGlyphs: int32
        indexToLocFormat: int32
        ascender: int32
        descender: int32
        lineGap: int32
        numberOfHMetrics: int32
        cmap: WebFontTable
        glyf: WebFontTable
        head: WebFontTable
        hhea: WebFontTable
        hmtx: WebFontTable
        loca: WebFontTable
        maxp: WebFontTable

    WebFontGlyphPoint =
        x: int32
        y: int32
        onCurve: bool
        endContour: bool

    WebFontGlyphOutline =
        glyphIndex: int32
        simple: bool
        contourCount: int32
        pointCount: int32
        xMin: int32
        yMin: int32
        xMax: int32
        yMax: int32
        points: WebFontGlyphPoint[]

    WebFontGlyphBounds =
        glyphIndex: int32
        empty: bool
        contourCount: int32
        xMin: int32
        yMin: int32
        xMax: int32
        yMax: int32

@borrows
fn WebFontReadU16BE(buf: int32[], offset: int32): int32 =
    if offset < 0:
        return -1
    let endOffset = offset + 2
    if endOffset > buf.len:
        return -1
    let offset1 = offset + 1
    var b0: int32
    var b1: int32
    b0 = buf[offset]
    b1 = buf[offset1]
    if b0 < 0:
        return -1
    if b1 < 0:
        return -1
    return (b0 << 8) | b1

@borrows
fn WebFontReadI16BE(buf: int32[], offset: int32): int32 =
    let value = WebFontReadU16BE(buf, offset)
    if value < 0:
        return value
    if value >= 32768:
        return value - 65536
    return value

fn WebFontReadI8(buf: var int32[], offset: int32): int32 =
    if offset < 0:
        return 0
    if offset >= buf.len:
        return 0
    let value = buf[offset]
    if value >= 128:
        return value - 256
    return value

@borrows
fn WebFontReadU32BE(buf: int32[], offset: int32): int32 =
    if offset < 0:
        return -1
    let endOffset = offset + 4
    if endOffset > buf.len:
        return -1
    let offset1 = offset + 1
    let offset2 = offset + 2
    let offset3 = offset + 3
    var b0: int32
    var b1: int32
    var b2: int32
    var b3: int32
    b0 = buf[offset]
    b1 = buf[offset1]
    b2 = buf[offset2]
    b3 = buf[offset3]
    if b0 < 0:
        return -1
    if b1 < 0:
        return -1
    if b2 < 0:
        return -1
    if b3 < 0:
        return -1
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3

@borrows
fn WebFontTableContains(font: var WebFontFace, table: WebFontTable, offset: int32, count: int32): bool =
    if !font.loaded && font.data.len <= 0:
        return false
    if table.offset < 0 || table.length <= 0:
        return false
    if offset < 0 || count < 0:
        return false
    let start64 = int64(table.offset) + int64(offset)
    let end64 = start64 + int64(count)
    if start64 < int64(0):
        return false
    if end64 < start64:
        return false
    if end64 > int64(table.offset) + int64(table.length):
        return false
    if end64 > int64(font.data.len):
        return false
    return true

@borrows
fn WebFontRecordTagMatches(buf: int32[], recordOffset: int32,
                           c0: char, c1: char, c2: char, c3: char): bool =
    if recordOffset < 0 || recordOffset + 4 > buf.len:
        return false
    if buf[recordOffset] != int32(c0):
        return false
    if buf[recordOffset + 1] != int32(c1):
        return false
    if buf[recordOffset + 2] != int32(c2):
        return false
    if buf[recordOffset + 3] != int32(c3):
        return false
    return true

@borrows
fn WebFontFindTable(buf: int32[],
                    c0: char, c1: char, c2: char, c3: char,
                    outTable: var WebFontTable): bool =
    outTable.offset = 0
    outTable.length = 0
    if buf.len < 12:
        return false
    let sfntVersion = WebFontReadU32BE(buf, 0)
    if sfntVersion != 0x00010000 && sfntVersion != 0x4f54544f:
        return false
    let tableCount = WebFontReadU16BE(buf, 4)
    if tableCount <= 0 || tableCount > 4096:
        return false
    let dirEnd64 = int64(12) + int64(tableCount) * int64(16)
    if dirEnd64 > int64(buf.len):
        return false
    for i in 0..<tableCount:
        let recordOffset = 12 + i * 16
        if WebFontRecordTagMatches(buf, recordOffset, c0, c1, c2, c3):
            let tableOffset = WebFontReadU32BE(buf, recordOffset + 8)
            let tableLength = WebFontReadU32BE(buf, recordOffset + 12)
            if tableOffset < 0 || tableLength <= 0:
                return false
            if int64(tableOffset) + int64(tableLength) > int64(buf.len):
                return false
            outTable.offset = tableOffset
            outTable.length = tableLength
            return true
    return false

fn WebFontInitEmpty(font: var WebFontFace) =
    font.data = []
    font.loaded = false
    font.cffDetected = false
    font.fingerprint = 0
    font.unitsPerEm = 0
    font.numGlyphs = 0
    font.indexToLocFormat = 0
    font.ascender = 0
    font.descender = 0
    font.lineGap = 0
    font.numberOfHMetrics = 0
    font.cmap = WebFontTable()
    font.glyf = WebFontTable()
    font.head = WebFontTable()
    font.hhea = WebFontTable()
    font.hmtx = WebFontTable()
    font.loca = WebFontTable()
    font.maxp = WebFontTable()

fn WebFontGlyphOutlineInit(outline: var WebFontGlyphOutline) =
    outline.glyphIndex = 0
    outline.simple = false
    outline.contourCount = 0
    outline.pointCount = 0
    outline.xMin = 0
    outline.yMin = 0
    outline.xMax = 0
    outline.yMax = 0
    outline.points = []

fn WebFontGlyphBoundsInit(bounds: var WebFontGlyphBounds) =
    bounds.glyphIndex = 0
    bounds.empty = true
    bounds.contourCount = 0
    bounds.xMin = 0
    bounds.yMin = 0
    bounds.xMax = 0
    bounds.yMax = 0

@borrows
fn WebFontDataFingerprint(data: int32[]): int32 =
    # SFNT table checksums already cover table payloads. Hashing the bounded
    # directory keeps the fingerprint deterministic without rescanning a
    # multi-megabyte CJK subset every time a face is attached to an atlas.
    if data.len < 12:
        return 0
    let tableCount = WebFontReadU16BE(data, 4)
    if tableCount <= 0 || tableCount > 4096:
        return 0
    let directoryByteCount = 12 + tableCount * 16
    if directoryByteCount > data.len:
        return 0
    var hash: int64 = int64(146959810)
    for i in 0..<directoryByteCount:
        let value = data[i] & 255
        hash = (hash * int64(131) + int64(value)) % int64(2147483647)
    hash = (hash * int64(131) + int64(data.len)) % int64(2147483647)
    let out = int32(hash)
    if out <= 0:
        return 1
    return out

fn WebFontLoadSfnt(data: int32[], font: var WebFontFace): bool =
    WebFontInitEmpty(font)
    if data.len < 64:
        return false
    font.data = data
    # CFF detection: var declaration outside if-condition to avoid cold compiler var-in-expr bug.
    var cffDummy: WebFontTable
    if WebFontFindTable(font.data, 'C', 'F', 'F', ' ', cffDummy):
        font.cffDetected = true
        WebFontInitEmpty(font)
        return false
    if !WebFontFindTable(font.data, 'c', 'm', 'a', 'p', font.cmap):
        WebFontInitEmpty(font)
        return false
    if !WebFontFindTable(font.data, 'g', 'l', 'y', 'f', font.glyf):
        WebFontInitEmpty(font)
        return false
    if !WebFontFindTable(font.data, 'h', 'e', 'a', 'd', font.head):
        WebFontInitEmpty(font)
        return false
    if !WebFontFindTable(font.data, 'h', 'h', 'e', 'a', font.hhea):
        WebFontInitEmpty(font)
        return false
    if !WebFontFindTable(font.data, 'h', 'm', 't', 'x', font.hmtx):
        WebFontInitEmpty(font)
        return false
    if !WebFontFindTable(font.data, 'l', 'o', 'c', 'a', font.loca):
        WebFontInitEmpty(font)
        return false
    if !WebFontFindTable(font.data, 'm', 'a', 'x', 'p', font.maxp):
        WebFontInitEmpty(font)
        return false
    if !WebFontTableContains(font, font.head, 18, 2):
        WebFontInitEmpty(font)
        return false
    if !WebFontTableContains(font, font.head, 50, 2):
        WebFontInitEmpty(font)
        return false
    if !WebFontTableContains(font, font.hhea, 4, 32):
        WebFontInitEmpty(font)
        return false
    if !WebFontTableContains(font, font.maxp, 4, 2):
        WebFontInitEmpty(font)
        return false
    font.unitsPerEm = WebFontReadU16BE(font.data, font.head.offset + 18)
    font.indexToLocFormat = WebFontReadI16BE(font.data, font.head.offset + 50)
    font.ascender = WebFontReadI16BE(font.data, font.hhea.offset + 4)
    font.descender = WebFontReadI16BE(font.data, font.hhea.offset + 6)
    font.lineGap = WebFontReadI16BE(font.data, font.hhea.offset + 8)
    font.numberOfHMetrics = WebFontReadU16BE(font.data, font.hhea.offset + 34)
    font.numGlyphs = WebFontReadU16BE(font.data, font.maxp.offset + 4)
    if font.unitsPerEm <= 0 || font.numGlyphs <= 0 || font.numberOfHMetrics <= 0:
        WebFontInitEmpty(font)
        return false
    if font.indexToLocFormat != 0 && font.indexToLocFormat != 1:
        WebFontInitEmpty(font)
        return false
    if !WebFontTableContains(font, font.hmtx, 0, font.numberOfHMetrics * 4):
        WebFontInitEmpty(font)
        return false
    let locaBytes = font.indexToLocFormat == 0 ? (font.numGlyphs + 1) * 2 : (font.numGlyphs + 1) * 4
    if !WebFontTableContains(font, font.loca, 0, locaBytes):
        WebFontInitEmpty(font)
        return false
    font.fingerprint = WebFontDataFingerprint(font.data)
    font.loaded = true
    return true

fn WebFontBase64Value(ch: char): int32 =
    if ch >= 'A' && ch <= 'Z':
        return int32(ch) - int32('A')
    if ch >= 'a' && ch <= 'z':
        return int32(ch) - int32('a') + 26
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0') + 52
    if ch == '+':
        return 62
    if ch == '/':
        return 63
    return -1

fn WebFontBase64Whitespace(ch: char): bool =
    return ch == ' ' || ch == '\n' || ch == '\r' || ch == '\t'

@borrows
fn WebFontDecodeBase64(text: str, outBytes: var int32[]): bool =
    outBytes = []
    if text.len <= 0:
        return false
    var acc = 0
    var bits = 0
    var padding = false
    for i in 0..<text.len:
        let ch = text[i]
        if WebFontBase64Whitespace(ch):
            continue
        if ch == '=':
            padding = true
            continue
        if padding:
            return false
        let value = WebFontBase64Value(ch)
        if value < 0:
            outBytes = []
            return false
        acc = (acc << 6) | value
        bits = bits + 6
        while bits >= 8:
            bits = bits - 8
            add(outBytes, (acc >> bits) & 255)
    return outBytes.len > 0

@borrows
fn WebFontLoadSfntBase64(text: str, font: var WebFontFace): bool =
    WebFontInitEmpty(font)
    var data: int32[]
    if !WebFontDecodeBase64(text, data):
        return false
    return WebFontLoadSfnt(data, font)

fn WebFontFindBestCmapSubtable(font: var WebFontFace, outOffset: var int32): bool =
    outOffset = 0
    if !font.loaded:
        return false
    if !WebFontTableContains(font, font.cmap, 0, 4):
        return false
    let count = WebFontReadU16BE(font.data, font.cmap.offset + 2)
    if count <= 0 || count > 256:
        return false
    if !WebFontTableContains(font, font.cmap, 4, count * 8):
        return false
    # Score-based selection: prefer format 12 (full Unicode range, 0..0x10FFFF)
    # over format 4 (BMP only, 0..65535). Within each format, prefer
    # platform 3 (Windows) / encoding 10 (Unicode full repertoire) or
    # platform 0 (Unicode) / encoding 4 or 6 (full repertoire).
    # Format 12 (platform 3 enc 10 or platform 0 enc 4/6) = 4 points
    # Format 12 (other platform/encoding) = 3 points
    # Format 4 (platform 3 enc 1/10 or platform 0 enc 3) = 2 points
    # Format 4 (other platform/encoding) = 1 point
    # Also track pure fallback (format 0/6/whatever) at 0 points.
    var bestOffset = 0
    var bestScore = 0
    var fallbackOffset = 0
    for i in 0..<count:
        let record = font.cmap.offset + 4 + i * 8
        let platform = WebFontReadU16BE(font.data, record)
        let encoding = WebFontReadU16BE(font.data, record + 2)
        let subOffset = WebFontReadU32BE(font.data, record + 4)
        if subOffset < 0 || subOffset >= font.cmap.length:
            return false
        let absolute = font.cmap.offset + subOffset
        if absolute + 2 > font.data.len:
            return false
        let format = WebFontReadU16BE(font.data, absolute)
        var score = 0
        if format == 12:
            if (platform == 3 && encoding == 10) || (platform == 0 && (encoding == 4 || encoding == 6)):
                score = 4
            else:
                score = 3
        elif format == 4:
            if (platform == 3 && (encoding == 1 || encoding == 10)) || (platform == 0 && encoding == 3):
                score = 2
            else:
                score = 1
        else:
            if fallbackOffset == 0:
                fallbackOffset = absolute
        if score > bestScore:
            bestScore = score
            bestOffset = absolute
    if bestOffset > 0:
        outOffset = bestOffset
        return true
    if fallbackOffset > 0:
        outOffset = fallbackOffset
        return true
    return false

fn WebFontGlyphIndexFromFormat4(font: var WebFontFace, subtableOffset: int32, codepoint: int32): int32 =
    if codepoint < 0 || codepoint > 65535:
        return 0
    if subtableOffset < 0 || subtableOffset + 16 > font.data.len:
        return 0
    let length = WebFontReadU16BE(font.data, subtableOffset + 2)
    if length < 16:
        return 0
    if int64(subtableOffset) + int64(length) > int64(font.data.len):
        return 0
    let segCountX2 = WebFontReadU16BE(font.data, subtableOffset + 6)
    if segCountX2 <= 0 || (segCountX2 & 1) != 0:
        return 0
    let segCount = segCountX2 / 2
    let endCodes = subtableOffset + 14
    let startCodes = endCodes + segCount * 2 + 2
    let idDeltas = startCodes + segCount * 2
    let idRangeOffsets = idDeltas + segCount * 2
    if int64(idRangeOffsets) + int64(segCount) * int64(2) > int64(subtableOffset) + int64(length):
        return 0
    for i in 0..<segCount:
        let endCode = WebFontReadU16BE(font.data, endCodes + i * 2)
        if codepoint > endCode:
            continue
        let startCode = WebFontReadU16BE(font.data, startCodes + i * 2)
        if codepoint < startCode:
            return 0
        let delta = WebFontReadI16BE(font.data, idDeltas + i * 2)
        let rangeOffset = WebFontReadU16BE(font.data, idRangeOffsets + i * 2)
        if rangeOffset == 0:
            let glyph = (codepoint + delta) & 65535
            if glyph <= 0 || glyph >= font.numGlyphs:
                return 0
            return glyph
        let glyphOffset = idRangeOffsets + i * 2 + rangeOffset + (codepoint - startCode) * 2
        if glyphOffset < subtableOffset || glyphOffset + 2 > subtableOffset + length:
            return 0
        let glyph = WebFontReadU16BE(font.data, glyphOffset)
        if glyph == 0:
            return 0
        return (glyph + delta) & 65535
    return 0

fn WebFontGlyphIndexFromFormat12(font: var WebFontFace, subtableOffset: int32, codepoint: int32): int32 =
    if codepoint < 0:
        return 0
    if subtableOffset < 0 || subtableOffset + 16 > font.data.len:
        return 0
    let length = WebFontReadU32BE(font.data, subtableOffset + 4)
    if length < 16:
        return 0
    if int64(subtableOffset) + int64(length) > int64(font.data.len):
        return 0
    let groupCount = WebFontReadU32BE(font.data, subtableOffset + 12)
    if groupCount < 0:
        return 0
    let groupsOffset = subtableOffset + 16
    if int64(groupsOffset) + int64(groupCount) * int64(12) > int64(subtableOffset) + int64(length):
        return 0
    for i in 0..<groupCount:
        let groupOffset = groupsOffset + i * 12
        let startCode = WebFontReadU32BE(font.data, groupOffset)
        let endCode = WebFontReadU32BE(font.data, groupOffset + 4)
        let startGlyph = WebFontReadU32BE(font.data, groupOffset + 8)
        if codepoint < startCode:
            return 0
        if codepoint <= endCode:
            let glyph = startGlyph + (codepoint - startCode)
            if glyph <= 0 || glyph >= font.numGlyphs:
                return 0
            return glyph
    return 0

fn WebFontGlyphIndexForCodepoint(font: var WebFontFace, codepoint: int32): int32 =
    var subtableOffset = 0
    if !WebFontFindBestCmapSubtable(font, subtableOffset):
        return 0
    let format = WebFontReadU16BE(font.data, subtableOffset)
    if format == 4:
        return WebFontGlyphIndexFromFormat4(font, subtableOffset, codepoint)
    if format == 12:
        return WebFontGlyphIndexFromFormat12(font, subtableOffset, codepoint)
    return 0

fn WebFontAdvanceWidth(font: var WebFontFace, glyphIndex: int32): int32 =
    if !font.loaded || glyphIndex < 0:
        return 0
    var metricIndex = glyphIndex
    if metricIndex >= font.numberOfHMetrics:
        metricIndex = font.numberOfHMetrics - 1
    let metricOffset = font.hmtx.offset + metricIndex * 4
    if !WebFontTableContains(font, font.hmtx, metricIndex * 4, 2):
        return 0
    return WebFontReadU16BE(font.data, metricOffset)

fn WebFontScaledAdvance(font: var WebFontFace, glyphIndex: int32, fontSizePx: int32): int32 =
    if !font.loaded || font.unitsPerEm <= 0 || fontSizePx <= 0:
        return 0
    let advance = WebFontAdvanceWidth(font, glyphIndex)
    if advance <= 0:
        return 0
    return int32((int64(advance) * int64(fontSizePx) + int64(font.unitsPerEm / 2)) / int64(font.unitsPerEm))

fn WebFontLineHeightPx(font: var WebFontFace, fontSizePx: int32): int32 =
    if !font.loaded || font.unitsPerEm <= 0 || fontSizePx <= 0:
        return 0
    let designHeight = font.ascender - font.descender + font.lineGap
    if designHeight <= 0:
        return fontSizePx
    return int32((int64(designHeight) * int64(fontSizePx) + int64(font.unitsPerEm / 2)) / int64(font.unitsPerEm))

fn WebFontGlyphLocaValue(font: var WebFontFace, glyphIndex: int32): int32 =
    if !font.loaded || glyphIndex < 0 || glyphIndex > font.numGlyphs:
        return -1
    if font.indexToLocFormat == 0:
        let entryOffset = glyphIndex * 2
        if !WebFontTableContains(font, font.loca, entryOffset, 2):
            return -1
        let raw = WebFontReadU16BE(font.data, font.loca.offset + entryOffset)
        if raw < 0:
            return -1
        return raw * 2
    let entryOffset = glyphIndex * 4
    if !WebFontTableContains(font, font.loca, entryOffset, 4):
        return -1
    return WebFontReadU32BE(font.data, font.loca.offset + entryOffset)

fn WebFontGlyphLocation(font: var WebFontFace, glyphIndex: int32, outOffset: var int32, outLength: var int32): bool =
    outOffset = 0
    outLength = 0
    if !font.loaded || glyphIndex < 0 || glyphIndex >= font.numGlyphs:
        return false
    let start = WebFontGlyphLocaValue(font, glyphIndex)
    let next = WebFontGlyphLocaValue(font, glyphIndex + 1)
    if start < 0 || next < start:
        return false
    if next == start:
        outOffset = font.glyf.offset + start
        outLength = 0
        return true
    if !WebFontTableContains(font, font.glyf, start, next - start):
        return false
    outOffset = font.glyf.offset + start
    outLength = next - start
    return true

fn WebFontRoundF2Dot14(value: int64): int32 =
    if value >= int64(0):
        return int32((value + int64(8192)) / int64(16384))
    return int32((value - int64(8192)) / int64(16384))

fn WebFontGlyphOutlineAppendComponent(outline: var WebFontGlyphOutline,
                                      component: var WebFontGlyphOutline,
                                      dx: int32,
                                      dy: int32,
                                      scaleX: int32,
                                      scaleY: int32,
                                      scale01: int32,
                                      scale10: int32): bool =
    if component.pointCount != component.points.len:
        return false
    let basePointCount = outline.points.len
    let appendedPointCount = basePointCount + component.pointCount
    if appendedPointCount < basePointCount:
        return false
    setLen(outline.points, appendedPointCount)
    for i in 0..<component.pointCount:
        let source = component.points[i]
        var point: WebFontGlyphPoint
        let tx = int64(source.x) * int64(scaleX) + int64(source.y) * int64(scale01)
        let ty = int64(source.x) * int64(scale10) + int64(source.y) * int64(scaleY)
        point.x = dx + WebFontRoundF2Dot14(tx)
        point.y = dy + WebFontRoundF2Dot14(ty)
        point.onCurve = source.onCurve
        point.endContour = source.endContour
        outline.points[basePointCount + i] = point
    outline.pointCount = outline.points.len
    outline.contourCount = outline.contourCount + component.contourCount
    return true

fn WebFontGlyphOutlineReadDepth(font: var WebFontFace,
                                glyphIndex: int32,
                                outline: var WebFontGlyphOutline,
                                depth: int32): bool =
    WebFontGlyphOutlineInit(outline)
    outline.glyphIndex = glyphIndex
    if depth > 8:
        return false
    if !font.loaded || glyphIndex < 0 || glyphIndex >= font.numGlyphs:
        return false
    let glyphStart = WebFontGlyphLocaValue(font, glyphIndex)
    let glyphNext = WebFontGlyphLocaValue(font, glyphIndex + 1)
    if glyphStart < 0 || glyphNext < glyphStart:
        return false
    if !WebFontTableContains(font, font.glyf, glyphStart, glyphNext - glyphStart):
        return false
    let glyphOffset = font.glyf.offset + glyphStart
    let glyphEnd = font.glyf.offset + glyphNext
    let glyphLength = glyphNext - glyphStart
    if glyphLength == 0:
        outline.simple = true
        return true
    if glyphLength < 10:
        return false
    let contourCount = WebFontReadI16BE(font.data, glyphOffset)
    outline.simple = true
    outline.xMin = WebFontReadI16BE(font.data, glyphOffset + 2)
    outline.yMin = WebFontReadI16BE(font.data, glyphOffset + 4)
    outline.xMax = WebFontReadI16BE(font.data, glyphOffset + 6)
    outline.yMax = WebFontReadI16BE(font.data, glyphOffset + 8)
    if contourCount < 0:
        var componentOffset = glyphOffset + 10
        var moreComponents = 1
        var componentCount = 0
        var instructionFlag = 0
        while moreComponents == 1:
            if componentOffset + 4 > glyphEnd:
                return false
            let componentFlags = WebFontReadU16BE(font.data, componentOffset)
            let componentGlyph = WebFontReadU16BE(font.data, componentOffset + 2)
            componentOffset = componentOffset + 4
            var arg1 = 0
            var arg2 = 0
            if (componentFlags & 1) != 0:
                if componentOffset + 4 > glyphEnd:
                    return false
                arg1 = WebFontReadI16BE(font.data, componentOffset)
                arg2 = WebFontReadI16BE(font.data, componentOffset + 2)
                componentOffset = componentOffset + 4
            else:
                if componentOffset + 2 > glyphEnd:
                    return false
                arg1 = WebFontReadI8(font.data, componentOffset)
                arg2 = WebFontReadI8(font.data, componentOffset + 1)
                componentOffset = componentOffset + 2
            if (componentFlags & 2) == 0:
                return false
            var scaleX = 16384
            var scaleY = 16384
            var scale01 = 0
            var scale10 = 0
            if (componentFlags & 8) != 0:
                if componentOffset + 2 > glyphEnd:
                    return false
                let scale = WebFontReadI16BE(font.data, componentOffset)
                componentOffset = componentOffset + 2
                scaleX = scale
                scaleY = scale
            elif (componentFlags & 64) != 0:
                if componentOffset + 4 > glyphEnd:
                    return false
                scaleX = WebFontReadI16BE(font.data, componentOffset)
                scaleY = WebFontReadI16BE(font.data, componentOffset + 2)
                componentOffset = componentOffset + 4
            elif (componentFlags & 128) != 0:
                if componentOffset + 8 > glyphEnd:
                    return false
                scaleX = WebFontReadI16BE(font.data, componentOffset)
                scale01 = WebFontReadI16BE(font.data, componentOffset + 2)
                scale10 = WebFontReadI16BE(font.data, componentOffset + 4)
                scaleY = WebFontReadI16BE(font.data, componentOffset + 6)
                componentOffset = componentOffset + 8
            var componentOutline: WebFontGlyphOutline
            if !WebFontGlyphOutlineReadDepth(font, componentGlyph, componentOutline, depth + 1):
                return false
            if !WebFontGlyphOutlineAppendComponent(outline, componentOutline, arg1, arg2, scaleX, scaleY, scale01, scale10):
                return false
            componentCount = componentCount + 1
            if componentCount > 64:
                return false
            moreComponents = 0
            if (componentFlags & 32) != 0:
                moreComponents = 1
            if (componentFlags & 256) != 0:
                instructionFlag = 1
        if instructionFlag == 1:
            if componentOffset + 2 > glyphEnd:
                return false
            let instructionLength = WebFontReadU16BE(font.data, componentOffset)
            componentOffset = componentOffset + 2 + instructionLength
            if componentOffset > glyphEnd:
                return false
        return outline.pointCount == outline.points.len
    if contourCount == 0 || contourCount > 128:
        return false
    let instructionLengthOffset = glyphOffset + 10 + contourCount * 2
    let contourEnd = glyphOffset + 12 + contourCount * 2
    if contourEnd > glyphEnd:
        return false
    outline.contourCount = contourCount
    var endPts: int32[]
    setLen(endPts, contourCount)
    for i in 0..<contourCount:
        endPts[i] = WebFontReadU16BE(font.data, glyphOffset + 10 + i * 2)
    let pointCount = endPts[contourCount - 1] + 1
    if pointCount <= 0 || pointCount > 4096:
        return false
    let instructionLength = WebFontReadU16BE(font.data, instructionLengthOffset)
    var flagsOffset = glyphOffset + 12 + contourCount * 2 + instructionLength
    if flagsOffset > glyphEnd:
        return false
    var flags: int32[]
    setLen(flags, pointCount)
    var flagCount = 0
    while flagCount < pointCount:
        if flagsOffset >= glyphEnd:
            return false
        let flag = font.data[flagsOffset]
        flagsOffset = flagsOffset + 1
        flags[flagCount] = flag
        flagCount = flagCount + 1
        if (flag & 8) != 0:
            if flagsOffset >= glyphEnd:
                return false
            let repeatCount = font.data[flagsOffset]
            flagsOffset = flagsOffset + 1
            for _ in 0..<repeatCount:
                if flagCount >= pointCount:
                    return false
                flags[flagCount] = flag
                flagCount = flagCount + 1
    if flagCount != pointCount:
        return false
    var coordOffset = flagsOffset
    var x = 0
    var xs: int32[]
    setLen(xs, pointCount)
    for i in 0..<pointCount:
        let flag = flags[i]
        var dx = 0
        if (flag & 2) != 0:
            if coordOffset >= glyphEnd:
                return false
            dx = font.data[coordOffset]
            coordOffset = coordOffset + 1
            if (flag & 16) == 0:
                dx = -dx
        elif (flag & 16) != 0:
            dx = 0
        else:
            let xReadEnd = coordOffset + 2
            if xReadEnd > glyphEnd:
                return false
            dx = WebFontReadI16BE(font.data, coordOffset)
            coordOffset = coordOffset + 2
        x = x + dx
        xs[i] = x
    setLen(outline.points, pointCount)
    var y = 0
    for i in 0..<pointCount:
        let flag = flags[i]
        var dy = 0
        if (flag & 4) != 0:
            if coordOffset >= glyphEnd:
                return false
            dy = font.data[coordOffset]
            coordOffset = coordOffset + 1
            if (flag & 32) == 0:
                dy = -dy
        elif (flag & 32) != 0:
            dy = 0
        else:
            let yReadEnd = coordOffset + 2
            if yReadEnd > glyphEnd:
                return false
            dy = WebFontReadI16BE(font.data, coordOffset)
            coordOffset = coordOffset + 2
        y = y + dy
        var point: WebFontGlyphPoint
        point.x = xs[i]
        point.y = y
        point.onCurve = (flag & 1) != 0
        point.endContour = false
        for contourIndex in 0..<contourCount:
            if endPts[contourIndex] == i:
                point.endContour = true
        outline.points[i] = point
    outline.pointCount = outline.points.len
    return outline.pointCount == pointCount

fn WebFontGlyphOutlineRead(font: var WebFontFace, glyphIndex: int32, outline: var WebFontGlyphOutline): bool =
    return WebFontGlyphOutlineReadDepth(font, glyphIndex, outline, 0)

fn WebFontGlyphBoundsRead(font: var WebFontFace, glyphIndex: int32, bounds: var WebFontGlyphBounds): bool =
    WebFontGlyphBoundsInit(bounds)
    bounds.glyphIndex = glyphIndex
    var glyphOffset = 0
    var glyphLength = 0
    if !WebFontGlyphLocation(font, glyphIndex, glyphOffset, glyphLength):
        return false
    if glyphLength == 0:
        return true
    if glyphLength < 10:
        return false
    bounds.empty = false
    bounds.contourCount = WebFontReadI16BE(font.data, glyphOffset)
    bounds.xMin = WebFontReadI16BE(font.data, glyphOffset + 2)
    bounds.yMin = WebFontReadI16BE(font.data, glyphOffset + 4)
    bounds.xMax = WebFontReadI16BE(font.data, glyphOffset + 6)
    bounds.yMax = WebFontReadI16BE(font.data, glyphOffset + 8)
    return bounds.contourCount >= 0

fn WebFontFree(font: var WebFontFace) =
    WebFontInitEmpty(font)
