const
    WebLayoutDisplayNone = 0
    WebLayoutDisplayBlock = 1
    WebLayoutDisplayInline = 2
    WebLayoutDisplayFlex = 3
    WebLayoutDisplayGrid = 4
    WebLayoutDisplayTable = 5

    WebLayoutPositionStatic = 0
    WebLayoutPositionRelative = 1
    WebLayoutPositionAbsolute = 2
    WebLayoutPositionFixed = 3
    WebLayoutPositionSticky = 4

    WebLayoutOverflowVisible = 0
    WebLayoutOverflowHidden = 1
    WebLayoutOverflowScroll = 2
    WebLayoutOverflowAuto = 3

    WebLayoutFlexDirectionRow = 1
    WebLayoutFlexDirectionColumn = 2

    WebLayoutJustifyContentFlexStart = 1
    WebLayoutJustifyContentCenter = 2
    WebLayoutJustifyContentFlexEnd = 3
    WebLayoutJustifyContentSpaceBetween = 4

    WebLayoutAlignItemsFlexStart = 1
    WebLayoutAlignItemsCenter = 2
    WebLayoutAlignItemsFlexEnd = 3
    WebLayoutAlignItemsStretch = 4

    WebLayoutAlignContentFlexStart = 1
    WebLayoutAlignContentFlexEnd = 2
    WebLayoutAlignContentCenter = 3
    WebLayoutAlignContentStretch = 4
    WebLayoutAlignContentSpaceBetween = 5
    WebLayoutAlignContentSpaceAround = 6

    WebLayoutAlignSelfAuto = 1
    WebLayoutAlignSelfFlexStart = 2
    WebLayoutAlignSelfFlexEnd = 3
    WebLayoutAlignSelfCenter = 4
    WebLayoutAlignSelfBaseline = 5
    WebLayoutAlignSelfStretch = 6

    WebLayoutBoxSizingContentBox = 0
    WebLayoutBoxSizingBorderBox = 1

type
    WebLayoutSize =
        width: int32
        height: int32

    WebLayoutStyleBox =
        nodeId: int32
        display: int32
        width: int32
        height: int32
        marginLeft: int32
        marginTop: int32
        marginRight: int32
        marginBottom: int32
        paddingLeft: int32
        paddingTop: int32
        paddingRight: int32
        paddingBottom: int32
        flexDirection: int32
        justifyContent: int32
        alignItems: int32
        flex: int32
        gap: int32
        fontSize: int32
        textContent: str
        position: int32
        zIndex: int32
        offsetTop: int32
        offsetRight: int32
        offsetBottom: int32
        offsetLeft: int32
        visible: bool
        overflowX: int32
        overflowY: int32
        opacity: int32
        flexWrap: int32
        alignContent: int32
        alignSelf: int32
        order: int32
        boxSizing: int32
        minWidth: int32
        maxWidth: int32
        minHeight: int32
        maxHeight: int32

    WebLayoutChildEdge =
        parentNodeId: int32
        childNodeId: int32
        ordinal: int32

    WebLayoutBox =
        nodeId: int32
        x: int32
        y: int32
        width: int32
        height: int32
        position: int32
        zIndex: int32
        offsetTop: int32
        offsetRight: int32
        offsetBottom: int32
        offsetLeft: int32
        visible: bool
        overflowX: int32
        overflowY: int32
        clipContent: bool
        opacity: int32

    WebGridTrack =
        nodeId: int32
        size: int32
        unit: int32
        kind: int32
        ordinal: int32

    WebGridItem =
        nodeId: int32
        columnStart: int32
        rowStart: int32
        columnSpan: int32
        rowSpan: int32

    WebLayoutTree =
        nextNodeId: int32
        rootNodeId: int32
        styles: WebLayoutStyleBox[]
        children: WebLayoutChildEdge[]
        boxes: WebLayoutBox[]
        gridTracks: WebGridTrack[]
        gridItems: WebGridItem[]
        flexChildIds: int32[]
        flexChildMain: int32[]
        flexChildCross: int32[]
        flexChildOrders: int32[]

fn WebLayoutTreeInit(tree: var WebLayoutTree) =
    tree.nextNodeId = 1
    tree.rootNodeId = 0
    tree.styles = []
    tree.children = []
    tree.boxes = []
    tree.gridTracks = []
    tree.gridItems = []
    tree.flexChildIds = []
    tree.flexChildMain = []
    tree.flexChildCross = []
    tree.flexChildOrders = []

fn WebLayoutDisplaySupported(display: int32): bool =
    return display == WebLayoutDisplayBlock
        || display == WebLayoutDisplayNone
        || display == WebLayoutDisplayInline
        || display == WebLayoutDisplayFlex
        || display == WebLayoutDisplayGrid
        || display == WebLayoutDisplayTable

fn WebLayoutStyleSupported(display: int32, width: int32, height: int32,
                            marginLeft: int32, marginTop: int32): bool =
    if !WebLayoutDisplaySupported(display):
        return false
    if width < 0 || height < 0:
        return false
    if marginLeft < 0 || marginTop < 0:
        return false
    return true

fn WebLayoutCreateStyleBox(tree: var WebLayoutTree,
                           display: int32,
                           width: int32,
                           height: int32,
                           marginLeft: int32,
                           marginTop: int32,
                           outNodeId: var int32): bool =
    outNodeId = 0
    if !WebLayoutStyleSupported(display, width, height, marginLeft, marginTop):
        return false
    let nodeId = tree.nextNodeId
    tree.nextNodeId = tree.nextNodeId + 1
    var style: WebLayoutStyleBox
    style.nodeId = nodeId
    style.display = display
    style.width = width
    style.height = height
    style.marginLeft = marginLeft
    style.marginTop = marginTop
    add(tree.styles, style)
    if tree.rootNodeId == 0:
        tree.rootNodeId = nodeId
    outNodeId = nodeId
    return true

fn WebLayoutSetFlexStyle(tree: var WebLayoutTree, nodeId: int32,
                         flexDirection: int32, justifyContent: int32,
                         alignItems: int32, flex: int32, gap: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    tree.styles[styleIdx].flexDirection = flexDirection
    tree.styles[styleIdx].justifyContent = justifyContent
    tree.styles[styleIdx].alignItems = alignItems
    tree.styles[styleIdx].flex = flex
    tree.styles[styleIdx].gap = gap
    return true

fn WebLayoutSetTextContent(tree: var WebLayoutTree, nodeId: int32, text: str): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    tree.styles[styleIdx].textContent = text
    return true

fn WebLayoutTextMeasure(text: str, fontSize: int32): WebLayoutSize =
    var size: WebLayoutSize
    size.width = text.len * fontSize
    size.height = fontSize
    return size

fn WebLayoutEstimateFontSize(tagName: str): int32 =
    if tagName == "h1": return 32
    elif tagName == "h2": return 24
    elif tagName == "h3": return 19
    elif tagName == "h4": return 16
    elif tagName == "h5": return 13
    elif tagName == "h6": return 11
    elif tagName == "button": return 13
    elif tagName == "small": return 13
    else: return 16

fn WebLayoutEstimateTextWidth(text: str, fontSize: int32): int32 =
    if fontSize <= 0:
        fontSize = 16
    var width: int32 = 0
    for i in 0..<text.len:
        let ch = text[i]
        if ch == ' ':
            width = width + fontSize / 4
        else:
            width = width + fontSize * 11 / 20
    return width

fn WebLayoutEstimateTextHeight(text: str, fontSize: int32): int32 =
    if text.len == 0:
        return 0
    var lines: int32 = 1
    for i in 0..<text.len:
        if text[i] == '\n':
            lines = lines + 1
    let lineHeight: int32 = fontSize > 0 ? fontSize * 6 / 5 : 20
    return lines * lineHeight

fn WebLayoutTreeAddStyle(tree: var WebLayoutTree, style: WebLayoutStyleBox): bool =
    add(tree.styles, style)
    tree.nextNodeId = tree.nextNodeId + 1
    return true

fn WebLayoutTreeAddChildEdge(tree: var WebLayoutTree, edge: WebLayoutChildEdge): bool =
    add(tree.children, edge)
    return true

fn WebLayoutFindStyleIndex(tree: var WebLayoutTree, nodeId: int32): int32 =
    for i in 0..<tree.styles.len:
        if tree.styles[i].nodeId == nodeId:
            return i
    return -1

fn WebLayoutNodeExists(tree: var WebLayoutTree, nodeId: int32): bool =
    return WebLayoutFindStyleIndex(tree, nodeId) >= 0

fn WebLayoutChildCount(tree: var WebLayoutTree, parentNodeId: int32): int32 =
    var count = 0
    for i in 0..<tree.children.len:
        if tree.children[i].parentNodeId == parentNodeId:
            count = count + 1
    return count

fn WebLayoutParentOf(tree: var WebLayoutTree, childNodeId: int32): int32 =
    for i in 0..<tree.children.len:
        if tree.children[i].childNodeId == childNodeId:
            return tree.children[i].parentNodeId
    return 0

fn WebLayoutIsAncestorOf(tree: var WebLayoutTree, ancestorNodeId: int32, nodeId: int32): bool =
    if ancestorNodeId == 0 || nodeId == 0:
        return false
    var current = WebLayoutParentOf(tree, nodeId)
    var steps = 0
    while current != 0:
        if current == ancestorNodeId:
            return true
        steps = steps + 1
        if steps > tree.styles.len:
            return true
        current = WebLayoutParentOf(tree, current)
    return false

fn WebLayoutAppendChild(tree: var WebLayoutTree, parentNodeId: int32, childNodeId: int32): bool =
    if parentNodeId == childNodeId:
        return false
    # Prevent duplicate parent (a node can have at most one parent)
    if WebLayoutParentOf(tree, childNodeId) != 0:
        return false
    # Prevent cycles: adding childNodeId under parentNodeId creates a cycle
    # if childNodeId is already an ancestor of parentNodeId.
    if WebLayoutIsAncestorOf(tree, childNodeId, parentNodeId):
        return false
    let edge: WebLayoutChildEdge
    edge.parentNodeId = parentNodeId
    edge.childNodeId = childNodeId
    edge.ordinal = WebLayoutChildCount(tree, parentNodeId)
    add(tree.children, edge)
    return true

fn WebLayoutChildAt(tree: var WebLayoutTree, parentNodeId: int32, ordinal: int32): int32 =
    for i in 0..<tree.children.len:
        if tree.children[i].parentNodeId == parentNodeId && tree.children[i].ordinal == ordinal:
            return tree.children[i].childNodeId
    return 0

fn WebLayoutRecordBox(tree: var WebLayoutTree, nodeId: int32, x: int32, y: int32,
                      width: int32, height: int32) =
    var box: WebLayoutBox
    box.nodeId = nodeId
    box.x = x
    box.y = y
    box.width = width
    box.height = height
    box.position = WebLayoutPositionStatic
    box.zIndex = 0
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx >= 0:
        let style = tree.styles[styleIdx]
        box.position = style.position
        box.zIndex = style.zIndex
        box.offsetTop = style.offsetTop
        box.offsetRight = style.offsetRight
        box.offsetBottom = style.offsetBottom
        box.offsetLeft = style.offsetLeft
        box.visible = style.visible
        box.overflowX = style.overflowX
        box.overflowY = style.overflowY
        box.clipContent = box.overflowX != WebLayoutOverflowVisible
        box.opacity = style.opacity
    else:
        box.offsetTop = 0
        box.offsetRight = 0
        box.offsetBottom = 0
        box.offsetLeft = 0
        box.visible = true
        box.overflowX = WebLayoutOverflowVisible
        box.overflowY = WebLayoutOverflowVisible
        box.clipContent = false
        box.opacity = 255
    add(tree.boxes, box)

fn WebLayoutLayoutInlineWords(tree: var WebLayoutTree, nodeId: int32,
                               text: str, fontSize: int32, gap: int32,
                               startX: int32, startY: int32, parentRight: int32,
                               ioX: var int32, ioY: var int32,
                               ioLineHeight: var int32) =
    if fontSize <= 0:
        fontSize = 16
    var wordStart: int32 = 0
    var i: int32 = 0
    while i < text.len:
        if text[i] == ' ' || text[i] == '\n':
            if i > wordStart:
                let word = text[wordStart..<i]
                let wordW = word.len * fontSize
                let wordH = fontSize
                if ioX + wordW > parentRight && ioLineHeight > 0:
                    ioX = startX
                    ioY = ioY + ioLineHeight
                    ioLineHeight = wordH
                WebLayoutRecordBox(tree, nodeId, ioX, ioY, wordW, wordH)
                ioX = ioX + wordW + gap
                if wordH > ioLineHeight:
                    ioLineHeight = wordH
            wordStart = i + 1
        i = i + 1
    if i > wordStart:
        let word = text[wordStart..<i]
        let wordW = word.len * fontSize
        let wordH = fontSize
        if wordW > 0:
            if ioX + wordW > parentRight && ioLineHeight > 0:
                ioX = startX
                ioY = ioY + ioLineHeight
                ioLineHeight = wordH
            WebLayoutRecordBox(tree, nodeId, ioX, ioY, wordW, wordH)
            ioX = ioX + wordW + gap
            if wordH > ioLineHeight:
                ioLineHeight = wordH

fn WebLayoutBlockLayoutChildren(tree: var WebLayoutTree, parentNodeId: int32,
                                startX: int32, startY: int32, parentWidth: int32,
                                outContentHeight: var int32): bool =
    # Account for parent padding: children are positioned within the content area
    let parentStyleIdx = WebLayoutFindStyleIndex(tree, parentNodeId)
    var parentPaddingLeft: int32 = 0
    var parentPaddingTop: int32 = 0
    var parentPaddingRight: int32 = 0
    var parentPaddingBottom: int32 = 0
    if parentStyleIdx >= 0:
        parentPaddingLeft = tree.styles[parentStyleIdx].paddingLeft
        parentPaddingTop = tree.styles[parentStyleIdx].paddingTop
        parentPaddingRight = tree.styles[parentStyleIdx].paddingRight
        parentPaddingBottom = tree.styles[parentStyleIdx].paddingBottom
    var contentX = startX + parentPaddingLeft
    var contentY = startY + parentPaddingTop
    var contentWidth = parentWidth - parentPaddingLeft - parentPaddingRight
    if contentWidth < 0:
        contentWidth = 0
    echo(Fmt"---DEBUG: block children nodeId={parentNodeId}---")
    var blockY = contentY
    var inlineX = contentX
    var inlineY = contentY
    var curLineHeight: int32 = 0
    let parentRight = contentX + contentWidth
    let childCount = WebLayoutChildCount(tree, parentNodeId)

    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            return false
        let childStyleIndex = WebLayoutFindStyleIndex(tree, childNodeId)
        if childStyleIndex < 0:
            return false
        let childStyle = tree.styles[childStyleIndex]

        if childStyle.display == WebLayoutDisplayNone:
            continue

        if childStyle.position == WebLayoutPositionAbsolute || childStyle.position == WebLayoutPositionFixed:
            continue

        if childStyle.display == WebLayoutDisplayInline:
            # Ensure inline flow is at current block position
            if blockY > inlineY:
                inlineX = contentX
                inlineY = blockY
            if childStyle.width > 0 && childStyle.height > 0:
                # Atomic inline element with explicit dimensions (inline-block behavior)
                # Used for replaced elements and form controls (button, input, canvas, etc.)
                if inlineX + childStyle.width > parentRight && curLineHeight > 0:
                    inlineX = contentX
                    inlineY = inlineY + curLineHeight
                    curLineHeight = 0
                WebLayoutRecordBox(tree, childNodeId,
                    inlineX + childStyle.marginLeft, inlineY + childStyle.marginTop,
                    childStyle.width, childStyle.height)
                inlineX = inlineX + childStyle.width + childStyle.gap + childStyle.marginLeft + childStyle.marginRight
                if childStyle.height > curLineHeight:
                    curLineHeight = childStyle.height
            elif childStyle.textContent != "":
                var textX = inlineX + childStyle.marginLeft
                var textY = inlineY
                var lineH = curLineHeight
                WebLayoutLayoutInlineWords(
                    tree, childNodeId,
                    childStyle.textContent, childStyle.fontSize,
                    childStyle.gap,
                    contentX, inlineY, parentRight,
                    textX, textY, lineH)
                inlineX = textX + childStyle.marginRight
                inlineY = textY
                curLineHeight = lineH
            else:
                # Inline element with no explicit size and no direct text content
                # Layout via subtree (handles nested inlines), then position inline
                var childW: int32 = 0
                var childH: int32 = 0
                var childBoxIdx: int32 = -1
                let beforeCount = tree.boxes.len
                if !WebLayoutLayoutSubtree(tree, childNodeId, 0, 0, contentWidth):
                    return false
                for bi in beforeCount..<tree.boxes.len:
                    if tree.boxes[bi].nodeId == childNodeId:
                        childW = tree.boxes[bi].width
                        childH = tree.boxes[bi].height
                        childBoxIdx = bi
                        break
                if childBoxIdx >= 0:
                    # Determine target inline position (with possible wrap)
                    var targetX = inlineX
                    var targetY = inlineY
                    if inlineX + childW > parentRight && curLineHeight > 0:
                        targetX = contentX
                        targetY = inlineY + curLineHeight
                        curLineHeight = 0
                    # Shift all newly created boxes to target position
                    let dx = targetX + childStyle.marginLeft - tree.boxes[childBoxIdx].x
                    let dy = targetY + childStyle.marginTop - tree.boxes[childBoxIdx].y
                    if dx != 0 || dy != 0:
                        for bi in beforeCount..<tree.boxes.len:
                            tree.boxes[bi].x = tree.boxes[bi].x + dx
                            tree.boxes[bi].y = tree.boxes[bi].y + dy
                    inlineX = targetX + childW + childStyle.gap + childStyle.marginLeft + childStyle.marginRight
                    if childH > curLineHeight:
                        curLineHeight = childH
        else:
            if curLineHeight > 0:
                blockY = blockY + curLineHeight
                inlineX = contentX
                inlineY = blockY
                curLineHeight = 0
            # 仅 inline 元素从文本估算宽度；block 元素宽度继承父容器
            if childStyle.width <= 0 && childStyle.textContent != "" && childStyle.display != WebLayoutDisplayBlock:
                let estimatedW = WebLayoutEstimateTextWidth(childStyle.textContent, childStyle.fontSize)
                tree.styles[childStyleIndex].width = estimatedW > contentWidth ? contentWidth : estimatedW
            if !WebLayoutLayoutSubtree(tree, childNodeId, contentX, blockY, contentWidth):
                return false
            blockY = blockY + childStyle.marginTop + tree.styles[childStyleIndex].height + childStyle.marginBottom

    if curLineHeight > 0:
        blockY = blockY + curLineHeight
    outContentHeight = blockY - startY + parentPaddingBottom
    return true


fn WebLayoutTableLayoutChildren(tree: var WebLayoutTree, parentNodeId: int32,
                                startX: int32, startY: int32, parentWidth: int32,
                                outContentWidth: var int32, outContentHeight: var int32): bool =
    # 拷贝参数到局部变量，避免编译器参数别名问题
    var tableX = startX
    var tableY = startY
    # Get gap (border-spacing) from table style
    var tableGap: int32 = 0
    let tableStyleIdx = WebLayoutFindStyleIndex(tree, parentNodeId)
    if tableStyleIdx >= 0:
        tableGap = tree.styles[tableStyleIdx].gap
    # Chrome defaults border-spacing to 2px
    if tableGap == 0 && tableStyleIdx >= 0:
        tree.styles[tableStyleIdx].gap = 2
        tableGap = 2
    # Phase 1: collect tr rows and td cells, compute column widths and row heights
    var trNodes: int32[] = []
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            continue
        let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if csIdx < 0:
            continue
        let cs = tree.styles[csIdx]
        if cs.display == WebLayoutDisplayNone:
            continue
        if cs.position == WebLayoutPositionAbsolute || cs.position == WebLayoutPositionFixed:
            continue
        add(trNodes, childNodeId)

    # Phase 1a: count max columns across all rows
    var nCols: int32 = 0
    for ri in 0..<trNodes.len:
        let trNodeId = trNodes[ri]
        let trChildCount = WebLayoutChildCount(tree, trNodeId)
        var cellCount: int32 = 0
        for ordinal in 0..<trChildCount:
            let tdNodeId = WebLayoutChildAt(tree, trNodeId, ordinal)
            if tdNodeId == 0:
                continue
            let tdIdx = WebLayoutFindStyleIndex(tree, tdNodeId)
            if tdIdx < 0:
                continue
            let tdStyle = tree.styles[tdIdx]
            if tdStyle.display == WebLayoutDisplayNone:
                continue
            if tdStyle.position == WebLayoutPositionAbsolute || tdStyle.position == WebLayoutPositionFixed:
                continue
            cellCount = cellCount + 1
        if cellCount > nCols:
            nCols = cellCount

    if trNodes.len == 0 || nCols == 0:
        outContentWidth = 0
        outContentHeight = 0
        return true

    # Phase 1b: compute column widths (max cell width per column)
    var colWidths: int32[] = []
    for ci in 0..<nCols:
        add(colWidths, 0)
    for ri in 0..<trNodes.len:
        let trNodeId = trNodes[ri]
        let trChildCount = WebLayoutChildCount(tree, trNodeId)
        var ci: int32 = 0
        for ordinal in 0..<trChildCount:
            let tdNodeId = WebLayoutChildAt(tree, trNodeId, ordinal)
            if tdNodeId == 0:
                continue
            let tdIdx = WebLayoutFindStyleIndex(tree, tdNodeId)
            if tdIdx < 0:
                continue
            let tdStyle = tree.styles[tdIdx]
            if tdStyle.display == WebLayoutDisplayNone:
                continue
            if tdStyle.position == WebLayoutPositionAbsolute || tdStyle.position == WebLayoutPositionFixed:
                continue
            if ci < nCols:
                var tdW = tdStyle.width
                if tdW <= 0:
                    if tdStyle.textContent != "":
                        tdW = WebLayoutEstimateTextWidth(tdStyle.textContent, tdStyle.fontSize)
                    if tdW <= 0:
                        tdW = 50    # 默认单元格最小宽度
                if tdW > colWidths[ci]:
                    colWidths[ci] = tdW
                ci = ci + 1

    # Phase 1c: compute row heights (max cell height per row)
    var rowHeights: int32[] = []
    for ri in 0..<trNodes.len:
        let trNodeId = trNodes[ri]
        let trChildCount = WebLayoutChildCount(tree, trNodeId)
        var maxH: int32 = 0
        for ordinal in 0..<trChildCount:
            let tdNodeId = WebLayoutChildAt(tree, trNodeId, ordinal)
            if tdNodeId == 0:
                continue
            let tdIdx = WebLayoutFindStyleIndex(tree, tdNodeId)
            if tdIdx < 0:
                continue
            let tdStyle = tree.styles[tdIdx]
            if tdStyle.display == WebLayoutDisplayNone:
                continue
            if tdStyle.position == WebLayoutPositionAbsolute || tdStyle.position == WebLayoutPositionFixed:
                continue
            var tdH = tdStyle.height
            if tdH <= 0:
                if tdStyle.textContent != "":
                    tdH = WebLayoutEstimateTextHeight(tdStyle.textContent, tdStyle.fontSize)
                if tdH <= 0:
                    tdH = 18    # 默认单元格最小高度
            if tdH > maxH:
                maxH = tdH
        add(rowHeights, maxH)

    # Phase 2a: pre-compute row Y positions (relative to tableY)
    var rowYPos: int32[] = []
    var ry: int32 = 0
    for ri in 0..<trNodes.len:
        add(rowYPos, ry)
        if ri < trNodes.len - 1:
            ry = ry + rowHeights[ri] + tableGap
        else:
            ry = ry + rowHeights[ri]

    # Phase 2b: pre-compute column X offsets (relative to tableX)
    var colXOffsets: int32[] = []
    var cx: int32 = 0
    for ci in 0..<nCols:
        add(colXOffsets, cx)
        if ci < nCols - 1:
            cx = cx + colWidths[ci] + tableGap
        else:
            cx = cx + colWidths[ci]

    # Total table content width from column widths + gaps
    var totalTableWidth: int32 = 0
    for ci in 0..<nCols:
        totalTableWidth = totalTableWidth + colWidths[ci]
    if nCols > 1:
        totalTableWidth = totalTableWidth + tableGap * (nCols - 1)

    # tr width: use explicit table width if set and larger than content
    var trWidth = totalTableWidth
    if tableStyleIdx >= 0 && tree.styles[tableStyleIdx].width > trWidth:
        trWidth = tree.styles[tableStyleIdx].width

    # Phase 2c: place rows and cells (read from arrays, no mutable scalars beyond loop counters)
    for ri in 0..<trNodes.len:
        let trNodeId = trNodes[ri]
        let rowY = rowYPos[ri]
        let rowH = rowHeights[ri]

        # Record tr box — width = total table content width, not parentWidth
        WebLayoutRecordBox(tree, trNodeId, tableX, tableY + rowY, trWidth, rowH)

        # Place cells in this row
        let trChildCount = WebLayoutChildCount(tree, trNodeId)
        var ci: int32 = 0
        for ordinal in 0..<trChildCount:
            let tdNodeId = WebLayoutChildAt(tree, trNodeId, ordinal)
            if tdNodeId == 0:
                continue
            let tdIdx = WebLayoutFindStyleIndex(tree, tdNodeId)
            if tdIdx < 0:
                continue
            let tdStyle = tree.styles[tdIdx]
            if tdStyle.display == WebLayoutDisplayNone:
                continue
            if tdStyle.position == WebLayoutPositionAbsolute || tdStyle.position == WebLayoutPositionFixed:
                continue
            if ci < nCols:
                let cellX = tableX + colXOffsets[ci]
                let cellY = tableY + rowY
                let tdW = colWidths[ci]
                let tdH = rowH

                # Record td box
                WebLayoutRecordBox(tree, tdNodeId,
                    cellX + tdStyle.marginLeft, cellY + tdStyle.marginTop,
                    tdW, tdH)

                # Layout td content (inline/block children inside td)
                var tdContentHeight: int32 = 0
                if !WebLayoutBlockLayoutChildren(tree, tdNodeId,
                        cellX + tdStyle.marginLeft, cellY + tdStyle.marginTop, tdW,
                        tdContentHeight):
                    return false

                ci = ci + 1

    outContentWidth = totalTableWidth
    if trNodes.len > 0:
        let lastRow = trNodes.len - 1
        outContentHeight = rowYPos[lastRow] + rowHeights[lastRow]
    else:
        outContentHeight = 0
    return true

fn WebLayoutLayoutSubtree(tree: var WebLayoutTree, nodeId: int32,
                          parentX: int32, parentY: int32,
                          parentWidth: int32): bool =
    if nodeId == 0:
        return false
    let styleIndex = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIndex < 0:
        return false
    let style = tree.styles[styleIndex]
    if style.display == WebLayoutDisplayNone:
        return true
    if style.display == WebLayoutDisplayInline:
        let x = parentX + style.marginLeft
        let y = parentY + style.marginTop
        var w = style.width
        var h = style.height
        if w <= 0 && style.textContent != "":
            w = WebLayoutEstimateTextWidth(style.textContent, style.fontSize)
        if h <= 0 && style.textContent != "":
            h = WebLayoutEstimateTextHeight(style.textContent, style.fontSize)
        WebLayoutRecordBox(tree, nodeId, x, y, w, h)
        # Layout children for nested inline elements
        if WebLayoutChildCount(tree, nodeId) > 0:
            var contentHeight: int32 = 0
            if !WebLayoutBlockLayoutChildren(tree, nodeId, x, y, parentWidth, contentHeight):
                return false
            # Estimate width from children if no explicit width
            if w <= 0:
                var childW: int32 = 0
                for bi in 0..<tree.boxes.len:
                    if tree.boxes[bi].nodeId != nodeId:
                        # Check if this box is a descendant of nodeId
                        if WebLayoutIsAncestorOf(tree, nodeId, tree.boxes[bi].nodeId):
                            let right = tree.boxes[bi].x + tree.boxes[bi].width
                            let localRight = right - x
                            if localRight > childW:
                                childW = localRight
                w = childW
                tree.styles[styleIndex].width = w
            if contentHeight > h:
                h = contentHeight
                tree.styles[styleIndex].height = h
            for bi in 0..<tree.boxes.len:
                if tree.boxes[bi].nodeId == nodeId:
                    tree.boxes[bi].width = w
                    tree.boxes[bi].height = h
                    break
        return true
    if style.display != WebLayoutDisplayBlock && style.display != WebLayoutDisplayFlex && style.display != WebLayoutDisplayGrid && style.display != WebLayoutDisplayTable:
        return false
    let x = parentX + style.marginLeft
    let y = parentY + style.marginTop

    if style.display == WebLayoutDisplayBlock:
        var boxWidth = style.width
        if boxWidth <= 0 && parentWidth > 0:
            boxWidth = parentWidth
        var boxHeight = style.height
        if boxHeight <= 0:
            if style.textContent.len > 0:
                boxHeight = WebLayoutEstimateTextHeight(style.textContent, style.fontSize)
            if style.minHeight > 0 && boxHeight < style.minHeight:
                boxHeight = style.minHeight
        let parentBoxIdx: int32 = tree.boxes.len
        WebLayoutRecordBox(tree, nodeId, x, y, boxWidth, boxHeight)
        WebLayoutApplyBoxOffset(tree, nodeId)
        var contentHeight: int32 = 0
        if !WebLayoutBlockLayoutChildren(tree, nodeId, x, y, boxWidth, contentHeight):
            return false
        if contentHeight > tree.boxes[parentBoxIdx].height:
            tree.boxes[parentBoxIdx].height = contentHeight
        if contentHeight > tree.styles[styleIndex].height:
            tree.styles[styleIndex].height = contentHeight
        return WebLayoutLayoutPositionedChildren(tree, nodeId,
            x, y, boxWidth, tree.boxes[parentBoxIdx].height)

    if style.display == WebLayoutDisplayTable:
        var boxWidth = style.width
        if boxWidth <= 0 && parentWidth > 0:
            boxWidth = parentWidth
        var boxHeight = style.height
        if boxHeight <= 0:
            if style.textContent.len > 0:
                boxHeight = WebLayoutEstimateTextHeight(style.textContent, style.fontSize)
            if style.minHeight > 0 && boxHeight < style.minHeight:
                boxHeight = style.minHeight
        let parentBoxIdx: int32 = tree.boxes.len
        WebLayoutRecordBox(tree, nodeId, x, y, boxWidth, boxHeight)
        WebLayoutApplyBoxOffset(tree, nodeId)
        var contentWidth: int32 = 0
        var contentHeight: int32 = 0
        if !WebLayoutTableLayoutChildren(tree, nodeId, x, y, boxWidth, contentWidth, contentHeight):
            return false
        if contentHeight > tree.boxes[parentBoxIdx].height:
            tree.boxes[parentBoxIdx].height = contentHeight
        if contentHeight > tree.styles[styleIndex].height:
            tree.styles[styleIndex].height = contentHeight
        if style.width <= 0:
            tree.boxes[parentBoxIdx].width = contentWidth
            tree.styles[styleIndex].width = contentWidth
        return WebLayoutLayoutPositionedChildren(tree, nodeId,
            x, y, tree.boxes[parentBoxIdx].width, tree.boxes[parentBoxIdx].height)

    if style.display == WebLayoutDisplayGrid:
        WebLayoutRecordBox(tree, nodeId, x, y, style.width, style.height)
        WebLayoutApplyBoxOffset(tree, nodeId)
        if !WebLayoutGridLayoutChildren(tree, nodeId, x, y, style.width, style.height):
            return false
        return WebLayoutLayoutPositionedChildren(tree, nodeId,
            x, y, style.width, style.height)

    var flexW = style.width
    var flexH = style.height
    WebLayoutFlexAutoSize(tree, nodeId,
        style.flexDirection, style.gap,
        flexW, flexH)
    if flexW <= 0 && parentWidth > 0:
        flexW = parentWidth
    WebLayoutRecordBox(tree, nodeId, x, y, flexW, flexH)
    WebLayoutApplyBoxOffset(tree, nodeId)
    # Account for parent padding: children are within the content area
    var flexContentX = x
    var flexContentY = y
    var flexContentW = flexW
    var flexContentH = flexH
    let flexPadIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if flexPadIdx >= 0:
        flexContentX = x + tree.styles[flexPadIdx].paddingLeft
        flexContentY = y + tree.styles[flexPadIdx].paddingTop
        flexContentW = flexW - tree.styles[flexPadIdx].paddingLeft - tree.styles[flexPadIdx].paddingRight
        flexContentH = flexH - tree.styles[flexPadIdx].paddingTop - tree.styles[flexPadIdx].paddingBottom
        if flexContentW < 0: flexContentW = 0
        if flexContentH < 0: flexContentH = 0
    if !WebLayoutFlexLayoutChildren(tree, nodeId,
            flexContentX, flexContentY, flexContentW, flexContentH,
            style.flexDirection, style.justifyContent,
            style.alignItems, style.gap):
        return false
    return WebLayoutLayoutPositionedChildren(tree, nodeId,
        x, y, flexW, flexH)
fn WebLayoutFlexAutoSize(tree: var WebLayoutTree, nodeId: int32,
                         flexDirection: int32, gap: int32,
                         outWidth: var int32, outHeight: var int32) =
    if outWidth > 0 && outHeight > 0:
        return
    let isRow = flexDirection == 0 || flexDirection == WebLayoutFlexDirectionRow
    var totalMain: int32 = 0
    var maxCross: int32 = 0
    var childCount: int32 = 0
    let totalChildren = WebLayoutChildCount(tree, nodeId)
    for ordinal in 0..<totalChildren:
        let childNodeId = WebLayoutChildAt(tree, nodeId, ordinal)
        if childNodeId == 0:
            continue
        let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if csIdx < 0:
            continue
        let cs = tree.styles[csIdx]
        if cs.display == WebLayoutDisplayNone:
            continue
        if cs.position == WebLayoutPositionAbsolute || cs.position == WebLayoutPositionFixed:
            continue
        childCount = childCount + 1
        if isRow:
            totalMain = totalMain + cs.width
            if cs.height > maxCross:
                maxCross = cs.height
        else:
            totalMain = totalMain + cs.height
            if cs.width > maxCross:
                maxCross = cs.width
    if childCount > 1:
        totalMain = totalMain + gap * (childCount - 1)
    if outWidth == 0:
        outWidth = isRow ? totalMain : maxCross
    if outHeight == 0:
        outHeight = isRow ? maxCross : totalMain

fn WebLayoutFlexLayoutChildAtPos(tree: var WebLayoutTree,
                                  childNodeId: int32,
                                  isRow: bool,
                                  alignItems: int32,
                                  parentX: int32, parentY: int32,
                                  parentWidth: int32, parentHeight: int32,
                                  pos: int32,
                                  totalFlex: int32, remaining: int32,
                                  lastFlexOrdinal: int32, roundingExtra: int32,
                                  ordinal: int32,
                                  spacing: int32): int32 =
    let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
    if csIdx < 0:
        return -1
    let cs = tree.styles[csIdx]
    var mainSize: int32
    var crossSize: int32
    if isRow:
        mainSize = cs.width
        crossSize = cs.height
    else:
        mainSize = cs.height
        crossSize = cs.width
    if totalFlex > 0 && cs.flex > 0 && remaining > 0:
        var extra = remaining * cs.flex / totalFlex
        if ordinal == lastFlexOrdinal:
            extra = extra + roundingExtra
        mainSize = mainSize + extra
    if crossSize <= 0 && cs.textContent != "":
        crossSize = isRow ? WebLayoutEstimateTextHeight(cs.textContent, cs.fontSize)
                          : WebLayoutEstimateTextWidth(cs.textContent, cs.fontSize)
    if isRow:
        if cs.minWidth > 0 && mainSize < cs.minWidth:
            mainSize = cs.minWidth
        if cs.maxWidth > 0 && mainSize > cs.maxWidth:
            mainSize = cs.maxWidth
        if cs.minHeight > 0 && crossSize < cs.minHeight:
            crossSize = cs.minHeight
        if cs.maxHeight > 0 && crossSize > cs.maxHeight:
            crossSize = cs.maxHeight
    else:
        if cs.minHeight > 0 && mainSize < cs.minHeight:
            mainSize = cs.minHeight
        if cs.maxHeight > 0 && mainSize > cs.maxHeight:
            mainSize = cs.maxHeight
        if cs.minWidth > 0 && crossSize < cs.minWidth:
            crossSize = cs.minWidth
        if cs.maxWidth > 0 && crossSize > cs.maxWidth:
            crossSize = cs.maxWidth
    let marginLeft = cs.marginLeft
    let marginTop = cs.marginTop
    # Simplified positioning - just use parent coords
    let childX = parentX + pos
    let childY = parentY
    if !WebLayoutLayoutSubtree(tree, childNodeId,
            childX - marginLeft, childY - marginTop,
            mainSize > 0 ? mainSize : parentWidth):
        return -1
    # Re-read size after layout (block layout may have estimated from content)
    if mainSize == 0:
        let postIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if postIdx >= 0:
            let actualMain = isRow ? tree.styles[postIdx].width : tree.styles[postIdx].height
            if actualMain > mainSize:
                mainSize = actualMain
    return pos + mainSize + spacing

fn WebLayoutFlexCountItems(tree: var WebLayoutTree, parentNodeId: int32, isRow: bool, childCount: int32,
                            totalFlex: var int32, fixedMain: var int32, n: var int32, needsSort: var bool) =
    totalFlex = 0
    fixedMain = 0
    n = 0
    needsSort = false
    var ordinal: int32 = 0
    while ordinal < childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            ordinal = ordinal + 1
            continue
        let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if csIdx < 0:
            ordinal = ordinal + 1
            continue
        let cs = tree.styles[csIdx]
        if cs.display != WebLayoutDisplayNone && cs.position != WebLayoutPositionAbsolute && cs.position != WebLayoutPositionFixed:
            n = n + 1
            totalFlex = totalFlex + cs.flex
            if cs.order != 0:
                needsSort = true
            if isRow:
                if cs.flex == 0:
                    fixedMain = fixedMain + cs.width
            else:
                if cs.flex == 0:
                    fixedMain = fixedMain + cs.height
        ordinal = ordinal + 1

fn WebLayoutFlexComputeTotalUsed(tree: var WebLayoutTree, parentNodeId: int32, isRow: bool, childCount: int32,
                                 totalFlex: int32, remaining: int32,
                                 totalUsed: var int32, roundingExtra: var int32, lastFlexOrdinal: var int32) =
    totalUsed = 0
    var ordinal: int32 = 0
    while ordinal < childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId != 0:
            let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            if csIdx >= 0:
                let cs = tree.styles[csIdx]
                if cs.display != WebLayoutDisplayNone && cs.position != WebLayoutPositionAbsolute && cs.position != WebLayoutPositionFixed:
                    var mainSize: int32
                    if isRow:
                        mainSize = cs.width
                    else:
                        mainSize = cs.height
                    if totalFlex > 0 && cs.flex > 0 && remaining > 0:
                        mainSize = mainSize + remaining * cs.flex / totalFlex
                    if isRow:
                        if cs.minWidth > 0 && mainSize < cs.minWidth:
                            mainSize = cs.minWidth
                        if cs.maxWidth > 0 && mainSize > cs.maxWidth:
                            mainSize = cs.maxWidth
                    else:
                        if cs.minHeight > 0 && mainSize < cs.minHeight:
                            mainSize = cs.minHeight
                        if cs.maxHeight > 0 && mainSize > cs.maxHeight:
                            mainSize = cs.maxHeight
                    totalUsed = totalUsed + mainSize
        ordinal = ordinal + 1
    roundingExtra = 0
    lastFlexOrdinal = -1
    if totalFlex > 0 && remaining > 0:
        var distSum: int32 = 0
        ordinal = 0
        while ordinal < childCount:
            let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
            if childNodeId != 0:
                let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
                if csIdx >= 0:
                    let cs = tree.styles[csIdx]
                    if cs.display != WebLayoutDisplayNone && cs.position != WebLayoutPositionAbsolute && cs.position != WebLayoutPositionFixed:
                        if cs.flex > 0:
                            distSum = distSum + remaining * cs.flex / totalFlex
                            lastFlexOrdinal = ordinal
            ordinal = ordinal + 1
        if distSum < remaining:
            roundingExtra = remaining - distSum
            totalUsed = totalUsed + roundingExtra

fn WebLayoutFlexFindKthChild(tree: var WebLayoutTree, parentNodeId: int32, childCount: int32, slot: int32): int32 =
    var bestOrdinal: int32 = -1
    var bestOrder: int32 = 1000000
    var scanOrd: int32 = 0
    while scanOrd < childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, scanOrd)
        if childNodeId != 0:
            let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            if csIdx >= 0:
                let cs = tree.styles[csIdx]
                if cs.display != WebLayoutDisplayNone && cs.position != WebLayoutPositionAbsolute && cs.position != WebLayoutPositionFixed:
                    if cs.order < bestOrder || (cs.order == bestOrder && scanOrd < bestOrdinal):
                        var rank: int32 = 0
                        var innerOrd: int32 = 0
                        while innerOrd < childCount:
                            let innerId = WebLayoutChildAt(tree, parentNodeId, innerOrd)
                            if innerId != 0:
                                let innerIdx = WebLayoutFindStyleIndex(tree, innerId)
                                if innerIdx >= 0:
                                    let innerCs = tree.styles[innerIdx]
                                    if innerCs.display != WebLayoutDisplayNone && innerCs.position != WebLayoutPositionAbsolute && innerCs.position != WebLayoutPositionFixed:
                                        if innerCs.order < cs.order || (innerCs.order == cs.order && innerOrd < scanOrd):
                                            rank = rank + 1
                            innerOrd = innerOrd + 1
                        if rank == slot:
                            bestOrdinal = scanOrd
                            bestOrder = cs.order
        scanOrd = scanOrd + 1
    return bestOrdinal

fn WebLayoutFlexLayoutChildren(tree: var WebLayoutTree, parentNodeId: int32,
                               parentX: int32, parentY: int32,
                               parentWidth: int32, parentHeight: int32,
                               flexDir: int32, justifyContent: int32,
                               alignItems: int32, gap: int32): bool =
    let isRow = flexDir == 0 || flexDir == WebLayoutFlexDirectionRow
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    if childCount == 0:
        return true

    # ---- Pass 1 ----
    var totalFlex: int32 = 0
    var fixedMain: int32 = 0
    var n: int32 = 0
    var needsSort = false
    WebLayoutFlexCountItems(tree, parentNodeId, isRow, childCount, totalFlex, fixedMain, n, needsSort)
    if n == 0:
        return true

    var gapTotal: int32 = 0
    if n > 1:
        gapTotal = gap * (n - 1)
    let parentMain = isRow ? parentWidth : parentHeight
    var remaining = parentMain - fixedMain - gapTotal
    if remaining < 0:
        remaining = 0

    # ---- Pass 2 ----
    var totalUsed: int32 = 0
    var roundingExtra: int32 = 0
    var lastFlexOrdinal: int32 = -1
    WebLayoutFlexComputeTotalUsed(tree, parentNodeId, isRow, childCount, totalFlex, remaining, totalUsed, roundingExtra, lastFlexOrdinal)

    # ---- Compute alignment offsets ----
    var spacing = gap
    var startOffset: int32 = 0
    if justifyContent == WebLayoutJustifyContentCenter:
        startOffset = (parentMain - totalUsed - gapTotal) / 2
        if startOffset < 0:
            startOffset = 0
    elif justifyContent == WebLayoutJustifyContentFlexEnd:
        startOffset = parentMain - totalUsed - gapTotal
        if startOffset < 0:
            startOffset = 0
    elif justifyContent == WebLayoutJustifyContentSpaceBetween && n > 1:
        let extraSpace = parentMain - totalUsed - gapTotal
        if extraSpace > 0:
            spacing = gap + extraSpace / (n - 1)

    # ---- Pass 3 ----
    if !needsSort:
        var ordinal: int32 = 0
        var pos: int32 = startOffset
        while ordinal < childCount:
            let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
            if childNodeId == 0:
                ordinal = ordinal + 1
                continue
            let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
            if csIdx < 0:
                ordinal = ordinal + 1
                continue
            let cs = tree.styles[csIdx]
            if cs.display == WebLayoutDisplayNone || cs.position == WebLayoutPositionAbsolute || cs.position == WebLayoutPositionFixed:
                ordinal = ordinal + 1
                continue
            let newPos = WebLayoutFlexLayoutChildAtPos(tree, childNodeId, isRow, alignItems,
                parentX, parentY, parentWidth, parentHeight, pos,
                totalFlex, remaining, lastFlexOrdinal, roundingExtra, ordinal, spacing)
            if newPos < 0:
                return false
            pos = newPos
            ordinal = ordinal + 1
    else:
        var slot: int32 = 0
        var pos: int32 = startOffset
        while slot < n:
            let bestOrdinal = WebLayoutFlexFindKthChild(tree, parentNodeId, childCount, slot)
            if bestOrdinal < 0:
                return false
            let childNodeId = WebLayoutChildAt(tree, parentNodeId, bestOrdinal)
            let newPos = WebLayoutFlexLayoutChildAtPos(tree, childNodeId, isRow, alignItems,
                parentX, parentY, parentWidth, parentHeight, pos,
                totalFlex, remaining, lastFlexOrdinal, roundingExtra, bestOrdinal, spacing)
            if newPos < 0:
                return false
            pos = newPos
            slot = slot + 1
    return true

fn WebLayoutSetGridTracks(tree: var WebLayoutTree, nodeId: int32,
                          kind: int32,
                          sizes: int32[], units: int32[]): bool =
    if !WebLayoutNodeExists(tree, nodeId):
        return false
    let ns = sizes.len
    let nu = units.len
    if ns != nu:
        return false
    for i in 0..<ns:
        var track: WebGridTrack
        track.nodeId = nodeId
        track.size = sizes[i]
        track.unit = units[i]
        track.kind = kind
        track.ordinal = i
        add(tree.gridTracks, track)
    return true

fn WebLayoutParseGridLength(size: int32, unit: int32,
                            containerSize: int32,
                            totalFr: int32,
                            frTotalSize: int32,
                            outSize: var int32): bool =
    if unit == 0:
        outSize = size
        return true
    if unit == 1:
        if totalFr > 0:
            outSize = frTotalSize * size / totalFr
        else:
            outSize = 0
        return true
    if unit == 2:
        outSize = 0
        return true
    return false

fn WebLayoutParseGridTemplate(template: str,
                              kind: int32,
                              nodeId: int32,
                              tree: var WebLayoutTree): bool =
    if template.len == 0:
        return true
    var sizes: int32[] = []
    var units: int32[] = []
    var tokenStart: int32 = 0
    var i: int32 = 0
    while i < template.len:
        let ch = template[i]
        if ch == ' ' || ch == '\n' || ch == '\t' || ch == '\r':
            if i > tokenStart:
                let tokenLen = i - tokenStart
                if tokenLen >= 3:
                    let last = i - 1
                    if template[last - 1] == 'p' && template[last] == 'x':
                        var val: int32 = 0
                        for j in tokenStart..<last - 1:
                            let digit = template[j]
                            if digit >= '0' && digit <= '9':
                                val = val * 10 + int32(digit) - int32('0')
                            else:
                                return false
                        add(sizes, val)
                        add(units, 0)
                    elif template[last] == '%':
                        var val: int32 = 0
                        for j in tokenStart..<last:
                            let digit = template[j]
                            if digit >= '0' && digit <= '9':
                                val = val * 10 + int32(digit) - int32('0')
                            else:
                                return false
                        add(sizes, val)
                        add(units, 2)
            tokenStart = i + 1
        i = i + 1
    # Last token
    if i > tokenStart:
        let tokenLen = i - tokenStart
        if tokenLen >= 3:
            let last = i - 1
            if template[last - 1] == 'p' && template[last] == 'x':
                var val: int32 = 0
                for j in tokenStart..<last - 1:
                    let digit = template[j]
                    if digit >= '0' && digit <= '9':
                        val = val * 10 + int32(digit) - int32('0')
                    else:
                        return false
                add(sizes, val)
                add(units, 0)
            elif template[last] == '%':
                var val: int32 = 0
                for j in tokenStart..<last:
                    let digit = template[j]
                    if digit >= '0' && digit <= '9':
                        val = val * 10 + int32(digit) - int32('0')
                    else:
                        return false
                add(sizes, val)
                add(units, 2)
    if sizes.len == 0:
        return true
    return WebLayoutSetGridTracks(tree, nodeId, kind, sizes, units)

fn WebLayoutGridLayoutChildren(tree: var WebLayoutTree, parentNodeId: int32,
                               parentX: int32, parentY: int32,
                               parentWidth: int32, parentHeight: int32): bool =
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    if childCount == 0:
        return true

    # Count columns and rows
    var nCols: int32 = 0
    var nRows: int32 = 0
    var ti: int32 = 0
    while ti < tree.gridTracks.len:
        if tree.gridTracks[ti].nodeId == parentNodeId:
            if tree.gridTracks[ti].kind == 0:
                nCols = nCols + 1
            else:
                nRows = nRows + 1
        ti = ti + 1

    # Compute column widths
    var colWidths: int32[] = []
    var remainingCol = parentWidth
    var colFr: int32 = 0
    var ci: int32 = 0
    while ci < tree.gridTracks.len:
        if tree.gridTracks[ci].nodeId == parentNodeId && tree.gridTracks[ci].kind == 0:
            if tree.gridTracks[ci].unit == 0:
                var sz = tree.gridTracks[ci].size
                if sz > remainingCol:
                    sz = remainingCol
                add(colWidths, sz)
                remainingCol = remainingCol - sz
            elif tree.gridTracks[ci].unit == 2:
                let sz = remainingCol * tree.gridTracks[ci].size / 100
                add(colWidths, sz)
                remainingCol = remainingCol - sz
            else:
                add(colWidths, 0)
                colFr = colFr + tree.gridTracks[ci].size
        ci = ci + 1
    # Distribute remaining space to fr columns
    if colFr > 0 && remainingCol > 0:
        var dci: int32 = 0
        var colIdx: int32 = 0
        while dci < tree.gridTracks.len:
            if tree.gridTracks[dci].nodeId == parentNodeId && tree.gridTracks[dci].kind == 0:
                if tree.gridTracks[dci].unit == 1:
                    colWidths[colIdx] = remainingCol * tree.gridTracks[dci].size / colFr
                colIdx = colIdx + 1
            dci = dci + 1

    # Compute row heights
    var rowHeights: int32[] = []
    var remainingRow = parentHeight
    var rowFr: int32 = 0
    var ri: int32 = 0
    while ri < tree.gridTracks.len:
        if tree.gridTracks[ri].nodeId == parentNodeId && tree.gridTracks[ri].kind == 1:
            if tree.gridTracks[ri].unit == 0:
                var sz = tree.gridTracks[ri].size
                if sz > remainingRow:
                    sz = remainingRow
                add(rowHeights, sz)
                remainingRow = remainingRow - sz
            elif tree.gridTracks[ri].unit == 2:
                let sz = remainingRow * tree.gridTracks[ri].size / 100
                add(rowHeights, sz)
                remainingRow = remainingRow - sz
            else:
                add(rowHeights, 0)
                rowFr = rowFr + tree.gridTracks[ri].size
        ri = ri + 1
    if rowFr > 0 && remainingRow > 0:
        var dri: int32 = 0
        var rowIdx: int32 = 0
        while dri < tree.gridTracks.len:
            if tree.gridTracks[dri].nodeId == parentNodeId && tree.gridTracks[dri].kind == 1:
                if tree.gridTracks[dri].unit == 1:
                    rowHeights[rowIdx] = remainingRow * tree.gridTracks[dri].size / rowFr
                rowIdx = rowIdx + 1
            dri = dri + 1

    let nc = colWidths.len
    let nr = rowHeights.len
    if nc == 0 && nr == 0:
        return true

    # Place children into grid cells
    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            continue
        let csIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if csIdx < 0:
            continue
        let cs = tree.styles[csIdx]
        if cs.display == WebLayoutDisplayNone:
            continue
        if cs.position == WebLayoutPositionAbsolute || cs.position == WebLayoutPositionFixed:
            continue
        let gridCol = ordinal % nc
        let gridRow = ordinal / nc
        let cellX = parentX + (gridCol < nc ? colWidths[gridCol] : 0)
        let cellY = parentY + (gridRow < nr ? rowHeights[gridRow] : 0)
        let cellW = cs.width > 0 ? cs.width : (gridCol < nc ? colWidths[gridCol] : parentWidth)
        let cellH = cs.height > 0 ? cs.height : (gridRow < nr ? rowHeights[gridRow] : parentHeight)

        WebLayoutRecordBox(tree, childNodeId,
            cellX + cs.marginLeft, cellY + cs.marginTop,
            cellW, cellH)
        if !WebLayoutLayoutSubtree(tree, childNodeId,
                cellX + cs.marginLeft, cellY + cs.marginTop, cellW):
            return false

    return true

fn WebLayoutFindPositionedAncestor(tree: var WebLayoutTree, nodeId: int32): int32 =
    if nodeId == 0:
        return 0
    let parentId = WebLayoutParentOf(tree, nodeId)
    if parentId == 0:
        return 0
    let styleIdx = WebLayoutFindStyleIndex(tree, parentId)
    if styleIdx < 0:
        return 0
    if tree.styles[styleIdx].position != WebLayoutPositionStatic:
        return parentId
    return WebLayoutFindPositionedAncestor(tree, parentId)

fn WebLayoutApplyBoxOffset(tree: var WebLayoutTree, nodeId: int32): bool =
    let bn = tree.boxes.len
    if bn == 0:
        return false
    let lastIdx = bn - 1
    if tree.boxes[lastIdx].nodeId != nodeId:
        return false
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    let style = tree.styles[styleIdx]
    if style.position != WebLayoutPositionRelative:
        return false
    tree.boxes[lastIdx].x = tree.boxes[lastIdx].x + style.offsetLeft - style.offsetRight
    tree.boxes[lastIdx].y = tree.boxes[lastIdx].y + style.offsetTop - style.offsetBottom
    return true

fn WebLayoutLayoutPositionedChildren(tree: var WebLayoutTree, parentNodeId: int32,
                                     parentX: int32, parentY: int32,
                                     parentWidth: int32, parentHeight: int32): bool =
    let childCount = WebLayoutChildCount(tree, parentNodeId)
    for ordinal in 0..<childCount:
        let childNodeId = WebLayoutChildAt(tree, parentNodeId, ordinal)
        if childNodeId == 0:
            continue
        let styleIdx = WebLayoutFindStyleIndex(tree, childNodeId)
        if styleIdx < 0:
            continue
        let cs = tree.styles[styleIdx]
        if cs.display == WebLayoutDisplayNone:
            continue
        if cs.position != WebLayoutPositionAbsolute && cs.position != WebLayoutPositionFixed:
            continue

        var posX: int32
        var posY: int32
        var posW: int32
        var posH: int32

        if cs.position == WebLayoutPositionFixed:
            posX = cs.offsetLeft
            posY = cs.offsetTop
        else:
            posX = parentX + cs.marginLeft + cs.offsetLeft - cs.offsetRight
            posY = parentY + cs.marginTop + cs.offsetTop - cs.offsetBottom

        posW = cs.width > 0 ? cs.width : parentWidth
        posH = cs.height > 0 ? cs.height : parentHeight

        WebLayoutRecordBox(tree, childNodeId, posX, posY, posW, posH)
        if !WebLayoutLayoutSubtree(tree, childNodeId, posX, posY, posW):
            return false
    return true

fn WebLayoutSortBoxesByZIndex(tree: var WebLayoutTree): bool =
    let nb = tree.boxes.len
    if nb <= 1:
        return true
    var needsSort = false
    for i in 0..<nb:
        if tree.boxes[i].zIndex != 0:
            needsSort = true
            break
    if !needsSort:
        return true
    // Simple insertion sort (stable) by zIndex
    for i in 1..<nb:
        var j = i
        while j > 0 && tree.boxes[j].zIndex < tree.boxes[j - 1].zIndex:
            let tmp = tree.boxes[j]
            tree.boxes[j] = tree.boxes[j - 1]
            tree.boxes[j - 1] = tmp
            j = j - 1
    return true

fn WebLayoutSetDisplay(tree: var WebLayoutTree, nodeId: int32, display: int32): bool =
    let styleIdx = WebLayoutFindStyleIndex(tree, nodeId)
    if styleIdx < 0:
        return false
    tree.styles[styleIdx].display = display
    return true

