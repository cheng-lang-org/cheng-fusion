# Web Surface Provider: FFI boundary between Cheng runtime and native platform.
# Defines the Surface, Font, and Image APIs as opaque uint64 handle interfaces.
# PURE INTERFACE: no rendering or platform code.

import cheng/core/runtime/web_runtime as web

const
    WebSurfaceEventKeyDown = 1
    WebSurfaceEventKeyUp = 2
    WebSurfaceEventMouseDown = 3
    WebSurfaceEventMouseUp = 4
    WebSurfaceEventMouseMove = 5
    WebSurfaceEventTouchStart = 6
    WebSurfaceEventTouchMove = 7
    WebSurfaceEventTouchEnd = 8
    WebSurfaceEventScroll = 9
    WebSurfaceEventResize = 10
    WebSurfaceEventClose = 11
    WebSurfaceEventFocus = 12
    WebSurfaceEventBlur = 13

type
    WebSurfaceSize =
        width: int32
        height: int32

    WebSurfaceBuffer =
        pixels: ptr
        width: int32
        height: int32
        stride: int32

    WebSurfaceEvent =
        eventType: int32
        surfaceHandle: uint64
        timestampMs: int64
        mouseX: int32
        mouseY: int32
        keyCode: int32
        keyModifiers: int32
        scrollDeltaX: int32
        scrollDeltaY: int32
        width: int32
        height: int32

# String conversion bridge: str -> C-compatible string pointer
@importc("cheng_str_to_cstring_temp_bridge")
fn cheng_str_to_cstring_native(text: str): cstring

# ── Surface (Window) FFI declarations ──

@importc("cheng_surface_create")
fn cheng_surface_create_native(title: cstring, width: int32, height: int32): uint64

@importc("cheng_surface_destroy")
fn cheng_surface_destroy_native(handle: uint64)

@importc("cheng_surface_set_title")
fn cheng_surface_set_title_native(handle: uint64, title: cstring)

@importc("cheng_surface_set_size")
fn cheng_surface_set_size_native(handle: uint64, width: int32, height: int32): bool

@importc("cheng_surface_get_size")
fn cheng_surface_get_size_native(handle: uint64, out: var WebSurfaceSize)

@importc("cheng_surface_show")
fn cheng_surface_show_native(handle: uint64)

@importc("cheng_surface_hide")
fn cheng_surface_hide_native(handle: uint64)

@importc("cheng_surface_request_frame")
fn cheng_surface_request_frame_native(handle: uint64)

@importc("cheng_surface_get_buffer")
fn cheng_surface_get_buffer_native(handle: uint64): WebSurfaceBuffer

@importc("cheng_surface_present")
fn cheng_surface_present_native(handle: uint64)

@importc("cheng_surface_poll_event")
fn cheng_surface_poll_event_native(out: var WebSurfaceEvent): bool

# ── Public Surface API ──

fn webSurfaceCreate(title: str, width: int32, height: int32): uint64 =
    return cheng_surface_create_native(cheng_str_to_cstring_native(title), width, height)

fn webSurfaceDestroy(handle: uint64) =
    cheng_surface_destroy_native(handle)

fn webSurfaceSetTitle(handle: uint64, title: str) =
    cheng_surface_set_title_native(handle, cheng_str_to_cstring_native(title))

fn webSurfaceSetSize(handle: uint64, width: int32, height: int32): bool =
    return cheng_surface_set_size_native(handle, width, height)

fn webSurfaceGetSize(handle: uint64, out: var WebSurfaceSize) =
    cheng_surface_get_size_native(handle, out)

fn webSurfaceShow(handle: uint64) =
    cheng_surface_show_native(handle)

fn webSurfaceHide(handle: uint64) =
    cheng_surface_hide_native(handle)

fn webSurfaceRequestFrame(handle: uint64) =
    cheng_surface_request_frame_native(handle)

fn webSurfaceGetBuffer(handle: uint64): WebSurfaceBuffer =
    return cheng_surface_get_buffer_native(handle)

fn webSurfacePresent(handle: uint64) =
    cheng_surface_present_native(handle)

fn webSurfacePollEvent(out: var WebSurfaceEvent): bool =
    return cheng_surface_poll_event_native(out)

# ── Font FFI declarations ──

@importc("cheng_surface_font_load")
fn cheng_surface_font_load_native(path: cstring, size: int32): uint64

@importc("cheng_surface_font_destroy")
fn cheng_surface_font_destroy_native(handle: uint64)

@importc("cheng_surface_font_get_glyph")
fn cheng_surface_font_get_glyph_native(fontHandle: uint64, codepoint: int32): WebSurfaceBuffer

@importc("cheng_surface_font_measure_text")
fn cheng_surface_font_measure_text_native(fontHandle: uint64, text: cstring): WebSurfaceSize

# ── Public Font API ──

fn webSurfaceFontLoad(path: str, size: int32): uint64 =
    return cheng_surface_font_load_native(cheng_str_to_cstring_native(path), size)

fn webSurfaceFontDestroy(handle: uint64) =
    cheng_surface_font_destroy_native(handle)

fn webSurfaceFontGetGlyph(fontHandle: uint64, codepoint: int32): WebSurfaceBuffer =
    return cheng_surface_font_get_glyph_native(fontHandle, codepoint)

fn webSurfaceFontMeasureText(fontHandle: uint64, text: str): WebSurfaceSize =
    return cheng_surface_font_measure_text_native(fontHandle, cheng_str_to_cstring_native(text))

# ── Image FFI declarations ──

@importc("cheng_surface_image_decode")
fn cheng_surface_image_decode_native(data: ptr, byteLen: int32): uint64

@importc("cheng_surface_image_get_size")
fn cheng_surface_image_get_size_native(handle: uint64, out: var WebSurfaceSize)

@importc("cheng_surface_image_get_buffer")
fn cheng_surface_image_get_buffer_native(handle: uint64): WebSurfaceBuffer

@importc("cheng_surface_image_destroy")
fn cheng_surface_image_destroy_native(handle: uint64)

# ── Public Image API ──

fn webSurfaceImageDecode(data: ptr, byteLen: int32): uint64 =
    return cheng_surface_image_decode_native(data, byteLen)

fn webSurfaceImageGetSize(handle: uint64, out: var WebSurfaceSize) =
    cheng_surface_image_get_size_native(handle, out)

fn webSurfaceImageGetBuffer(handle: uint64): WebSurfaceBuffer =
    return cheng_surface_image_get_buffer_native(handle)

fn webSurfaceImageDestroy(handle: uint64) =
    cheng_surface_image_destroy_native(handle)

# ── Input Event Bridge ──
# Converts native surface events into the WebEvent system.

fn webSurfaceEventToWebEvent(surfaceEvent: var WebSurfaceEvent, out: var web.WebEvent) =
    web.WebEventInit(out, "")
    out.timestamp = surfaceEvent.timestampMs
    out.clientX = surfaceEvent.mouseX
    out.clientY = surfaceEvent.mouseY
    if surfaceEvent.eventType == WebSurfaceEventKeyDown:
        out.type = "keydown"
    elif surfaceEvent.eventType == WebSurfaceEventKeyUp:
        out.type = "keyup"
    elif surfaceEvent.eventType == WebSurfaceEventMouseDown:
        out.type = "mousedown"
    elif surfaceEvent.eventType == WebSurfaceEventMouseUp:
        out.type = "mouseup"
    elif surfaceEvent.eventType == WebSurfaceEventMouseMove:
        out.type = "mousemove"
    elif surfaceEvent.eventType == WebSurfaceEventTouchStart:
        out.type = "touchstart"
    elif surfaceEvent.eventType == WebSurfaceEventTouchMove:
        out.type = "touchmove"
    elif surfaceEvent.eventType == WebSurfaceEventTouchEnd:
        out.type = "touchend"
    elif surfaceEvent.eventType == WebSurfaceEventScroll:
        out.type = "scroll"
    elif surfaceEvent.eventType == WebSurfaceEventResize:
        out.type = "resize"
    elif surfaceEvent.eventType == WebSurfaceEventFocus:
        out.type = "focus"
    elif surfaceEvent.eventType == WebSurfaceEventBlur:
        out.type = "blur"
