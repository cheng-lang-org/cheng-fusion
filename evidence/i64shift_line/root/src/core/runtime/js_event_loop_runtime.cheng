const
    JsEventLoopTracePhaseTask = 1
    JsEventLoopTracePhaseMicrotask = 2

type
    JsEventLoopTask =
        handlerId: int32
        followUpMicrotaskId: int32

    JsEventLoopTraceStep =
        handlerId: int32
        phase: int32

    JsEventLoop =
        taskQueue: JsEventLoopTask[]
        microtaskQueue: int32[]
        trace: JsEventLoopTraceStep[]
        taskHead: int32
        microtaskHead: int32

fn JsEventLoopInit(loop: var JsEventLoop) =
    loop.taskQueue = []
    loop.microtaskQueue = []
    loop.trace = []
    loop.taskHead = 0
    loop.microtaskHead = 0

fn JsEventLoopReset(loop: var JsEventLoop) =
    JsEventLoopInit(loop)

fn JsEventLoopRecordTrace(loop: var JsEventLoop, handlerId: int32, phase: int32) =
    var step: JsEventLoopTraceStep
    step.handlerId = handlerId
    step.phase = phase
    add(loop.trace, step)

fn JsEventLoopEnqueueTask(loop: var JsEventLoop, handlerId: int32): bool =
    if handlerId <= 0:
        return false
    var task: JsEventLoopTask
    task.handlerId = handlerId
    task.followUpMicrotaskId = 0
    add(loop.taskQueue, task)
    return true

fn JsEventLoopEnqueueMicrotask(loop: var JsEventLoop, handlerId: int32): bool =
    if handlerId <= 0:
        return false
    add(loop.microtaskQueue, handlerId)
    return true

fn JsEventLoopEnqueuePromiseMicrotask(loop: var JsEventLoop,
                                       handlerId: int32): bool =
    # Enqueue a microtask specifically for Promise resolution callbacks.
    # This is the same underlying mechanism as a regular microtask but
    # is explicitly named to clarify Promise integration.
    return JsEventLoopEnqueueMicrotask(loop, handlerId)

fn JsEventLoopEnqueueTaskWithFollowUpMicrotask(loop: var JsEventLoop,
                                               handlerId: int32,
                                               microtaskId: int32): bool =
    if handlerId <= 0:
        return false
    if microtaskId <= 0:
        return false
    var task: JsEventLoopTask
    task.handlerId = handlerId
    task.followUpMicrotaskId = microtaskId
    add(loop.taskQueue, task)
    return true

fn JsEventLoopDrainMicrotasks(loop: var JsEventLoop,
                              maxSteps: int32,
                              stepsUsed: var int32): bool =
    while loop.microtaskHead < loop.microtaskQueue.len:
        if stepsUsed >= maxSteps:
            return false
        let handlerId = loop.microtaskQueue[loop.microtaskHead]
        loop.microtaskHead = loop.microtaskHead + 1
        JsEventLoopRecordTrace(loop, handlerId, JsEventLoopTracePhaseMicrotask)
        stepsUsed = stepsUsed + 1
    loop.microtaskQueue = []
    loop.microtaskHead = 0
    return true

fn JsEventLoopRunUntilEmpty(loop: var JsEventLoop, maxSteps: int32): bool =
    if maxSteps < 0:
        return false
    loop.trace = []
    var stepsUsed = 0
    if !JsEventLoopDrainMicrotasks(loop, maxSteps, stepsUsed):
        return false
    while loop.taskHead < loop.taskQueue.len:
        if stepsUsed >= maxSteps:
            return false
        let task = loop.taskQueue[loop.taskHead]
        loop.taskHead = loop.taskHead + 1
        JsEventLoopRecordTrace(loop, task.handlerId, JsEventLoopTracePhaseTask)
        stepsUsed = stepsUsed + 1
        if task.followUpMicrotaskId > 0:
            add(loop.microtaskQueue, task.followUpMicrotaskId)
        if !JsEventLoopDrainMicrotasks(loop, maxSteps, stepsUsed):
            return false
    loop.taskQueue = []
    loop.taskHead = 0
    return true

fn JsEventLoopTaskQueueCount(loop: var JsEventLoop): int32 =
    return loop.taskQueue.len - loop.taskHead

fn JsEventLoopMicrotaskQueueCount(loop: var JsEventLoop): int32 =
    return loop.microtaskQueue.len - loop.microtaskHead

fn JsEventLoopTraceCount(loop: var JsEventLoop): int32 =
    return loop.trace.len

fn JsEventLoopTraceHandlerAt(loop: var JsEventLoop, index: int32): int32 =
    if index < 0 || index >= loop.trace.len:
        return 0
    return loop.trace[index].handlerId

fn JsEventLoopTracePhaseAt(loop: var JsEventLoop, index: int32): int32 =
    if index < 0 || index >= loop.trace.len:
        return 0
    return loop.trace[index].phase
