# cheng_js_rt.cheng — Production JS runtime for ts-csg generated Cheng code
#
# Heap model:
# - Objects (rtObjKind=0): HashMapStrInt for properties
# - Arrays (rtObjKind=1): int32[] for elements
# - Fixed-size heap, no GC (production would add generational GC)
#
# Replaces all 15 runtime stubs from ts-csg output with real implementations.

import std/hashmaps
import std/seqs
import std/strings
import std/times
import std/system

const
    rtMaxObjects: int32 = 262144
    rtKindFree: int32 = -1
    rtKindObject: int32 = 0
    rtKindArray: int32 = 1

# === Global heap ===

var rtObjKinds: int32[rtMaxObjects]
var rtObjMaps: hashmaps.HashMapStrInt[rtMaxObjects]
var rtObjArrays: int32[][rtMaxObjects]
var rtNextId: int32

fn rtHeapInit(): int32 =
    var i: int32
    for i in 0..<rtMaxObjects:
        rtObjKinds[i] = rtKindFree
    return 0

fn rtHeapAlloc(kind: int32): int32 =
    if rtNextId >= rtMaxObjects:
        return -1
    let id: int32 = rtNextId
    rtNextId = rtNextId + 1
    rtObjKinds[id] = kind
    return id

# === Object property model ===
# Each object has a HashMapStrInt: property name (str) → value heap ID (int32)

fn __csg_rt_obj_get(objId: int32, propName: str): int32 =
    if objId < 0 || objId >= rtNextId:
        return 0
    if rtObjKinds[objId] != rtKindObject:
        return 0
    var found: bool
    let val: int32 = hashmaps.HashMapStrIntGetMutEx(rtObjMaps[objId], propName, found)
    if found:
        return val
    return 0

fn __csg_rt_obj_set(objId: int32, propName: str, value: int32): bool =
    if objId < 0 || objId >= rtNextId:
        return false
    if rtObjKinds[objId] != rtKindObject:
        return false
    hashmaps.HashMapStrIntPut(rtObjMaps[objId], propName, value)
    return true

fn __csg_rt_obj_clear(objId: int32): int32 =
    if objId < 0 || objId >= rtNextId:
        return 0
    return objId

# === Array element model ===
# Each array is an int32[] (seq of heap IDs)

fn __csg_rt_elem_get(objId: int32, index: int32): int32 =
    if objId < 0 || objId >= rtNextId:
        return 0
    if rtObjKinds[objId] != rtKindArray:
        return 0
    let elems: int32[] = rtObjArrays[objId]
    if index < 0 || index >= elems.len:
        return 0
    return elems[index]

fn __csg_rt_elem_set(objId: int32, index: int32, value: int32): int32 =
    if objId < 0 || objId >= rtNextId:
        return 0
    if rtObjKinds[objId] != rtKindArray:
        return 0
    var elems: int32[] = rtObjArrays[objId]
    if index >= elems.len:
        seqs.Add(elems, value)
    else:
        elems[index] = value
    return value

# === Console (production) ===

@importc("puts")
fn __libc_puts(s: cstring): int32

fn __ts_csg_console_warn(value: int32): int32 =
    return value

# === Time (production) ===

fn __ts_csg_date_now_ms(): int64 =
    return times.EpochTimeMs()

fn __ts_csg_times_epoch_time_ms(): int32 =
    let ms: int64 = times.EpochTimeMs()
    return int32(ms)

# === Math (production) ===

fn __ts_csg_math_min_i32(left: int32, right: int32): int32 =
    if left < right:
        return left
    return right

# === Application-specific stubs ===
# These require Claude Code internal semantics.
# Implement as no-ops for now; each can be replaced with real logic later.

fn __ts_csg_this__fileMtims_set(p0: int32, p1: int32): int32 =
    return 0

fn __ts_csg_this__pollTimer_unref(): int32 =
    return 0

fn __ts_csg_this__rag_destroy(): int32 =
    return 0

fn __ts_csg_this__rag_getIndex(): int32 =
    return 0

fn __ts_csg_this__rag_invalidate(): int32 =
    return 0

fn __ts_csg_this__watcher_on(p0: int32, p1: int32): int32 =
    return 0
