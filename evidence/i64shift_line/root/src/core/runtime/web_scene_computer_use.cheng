# Typed Computer Use admission. Apply is WebSceneApplyComputerUseTypedAction
# in web_scene_computer_use_apply.cheng so admit tests do not pull the full
# scene runtime.
#
# effectClass 词表与确认要求的唯一权威是 csg_action_authority.cheng 的注册
# 合同表; 本模块不再自持六动作/两类确认的硬编码判断。WebSceneComputerUseAdmit
# 是兼容面: effectClass 必须是注册表中该动作的注册行, 确认要求从注册行读取;
# confirmed 布尔只为既有调用方保留, 生产签发走 csg_action_authority 的
# 确认凭证 (绑定动作+参数+版本+世代, 一次性消费, 可撤销)。

import std/strings
import cheng/core/runtime/csg_action_authority as auth

const
    WebSceneComputerUseEffectExternalPublish: str = "external-publish"
    WebSceneComputerUseEffectPayment: str = "payment"
    WebSceneComputerUseErrConfirmationRequired: str =
        "computer_use_e_confirmation_required"
    WebSceneComputerUseErrActionKind: str = "computer_use_e_action_kind"
    WebSceneComputerUseErrEffectClass: str =
        "computer_use_e_effect_class_not_registered"
    WebSceneComputerUseErrApply: str = "computer_use_e_apply_rejected"

@borrows
fn WebSceneComputerUseRequiresConfirmation(effectClass: str): bool =
    return auth.CsgActionAuthorityEffectClassRequiresConfirmation(effectClass)

@borrows
fn WebSceneComputerUseAdmit(
        actionKind: str,
        effectClass: str,
        confirmed: bool,
        err: var str): bool =
    if !auth.CsgActionAuthorityActionRegistered(actionKind):
        err = strings.CloneStr(WebSceneComputerUseErrActionKind)
        return false
    let row = auth.CsgActionAuthorityRowLookup(actionKind, effectClass)
    if row < 0:
        err = strings.CloneStr(WebSceneComputerUseErrEffectClass)
        return false
    if auth.CsgActionAuthorityRowRequiresConfirm(row) && !confirmed:
        err = strings.CloneStr(WebSceneComputerUseErrConfirmationRequired)
        return false
    err = ""
    return true
