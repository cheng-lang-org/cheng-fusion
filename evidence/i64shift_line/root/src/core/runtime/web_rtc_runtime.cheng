# web_rtc_runtime.cheng
# WebRTC API for Cheng Web runtime.
# Provides: WebRTCPeerConnection, WebRTCDataChannel types and WebRTC* functions

type
    WebRTCPeerConnection =
        pcId: int32
        localDescription: str
        remoteDescription: str
        iceGatheringState: str     # "new"/"gathering"/"complete"
        iceConnectionState: str    # "new"/"checking"/"connected"/"disconnected"
        onicecandidate: int32      # callbackFnId
        ontrack: int32             # callbackFnId
        dataChannels: WebRTCDataChannel[]

    WebRTCDataChannel =
        channelId: int32
        label: str
        readyState: str   # "connecting"/"open"/"closing"/"closed"
        onmessage: int32  # callbackFnId
        onopen: int32
        onclose: int32

# ============================================================
# Global state
# ============================================================

var rtcConnections: WebRTCPeerConnection[]
var nextPcId: int32 = 1
var nextDcId: int32 = 1

# ============================================================
# Internal helpers
# ============================================================

fn WebRTCFindIndex(pcId: int32): int32 =
    for i in 0..<rtcConnections.len:
        if rtcConnections[i].pcId == pcId:
            return i
    return -1

fn WebRTCFindDataChannel(channelId: int32, outPcIdx: var int32, outDcIdx: var int32): bool =
    for i in 0..<rtcConnections.len:
        let dcLen: int32 = rtcConnections[i].dataChannels.len
        for j in 0..<dcLen:
            if rtcConnections[i].dataChannels[j].channelId == channelId:
                outPcIdx = i
                outDcIdx = j
                return true
    return false

# ============================================================
# WebRTCPeerConnectionCreate: Create a new RTCPeerConnection
# config is a JSON string (simplified / ignored)
# ============================================================

fn WebRTCPeerConnectionCreate(config: str): int32 =
    let pcId = nextPcId
    nextPcId = nextPcId + 1
    var pc: WebRTCPeerConnection
    pc.pcId = pcId
    pc.localDescription = ""
    pc.remoteDescription = ""
    pc.iceGatheringState = "new"
    pc.iceConnectionState = "new"
    pc.onicecandidate = 0
    pc.ontrack = 0
    pc.dataChannels = []
    add(rtcConnections, pc)
    return pcId

# ============================================================
# WebRTCCreateOffer: Generate placeholder SDP offer
# ============================================================

fn WebRTCCreateOffer(pcId: int32, out: var str): bool =
    let idx = WebRTCFindIndex(pcId)
    if idx < 0:
        return false
    out = "v=0\no=- 0 0 IN IP4 127.0.0.1\ns=-\nt=0 0\na=group:BUNDLE 0\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\nc=IN IP4 0.0.0.0\na=mid:0\n"
    return true

# ============================================================
# WebRTCCreateAnswer: Generate placeholder SDP answer
# ============================================================

fn WebRTCCreateAnswer(pcId: int32, out: var str): bool =
    let idx = WebRTCFindIndex(pcId)
    if idx < 0:
        return false
    out = "v=0\no=- 0 0 IN IP4 127.0.0.1\ns=-\nt=0 0\na=group:BUNDLE 0\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\nc=IN IP4 0.0.0.0\na=mid:0\n"
    return true

# ============================================================
# WebRTCSetLocalDescription: Set local SDP description
# ============================================================

fn WebRTCSetLocalDescription(pcId: int32, sdp: str): bool =
    let idx = WebRTCFindIndex(pcId)
    if idx < 0:
        return false
    rtcConnections[idx].localDescription = sdp
    return true

# ============================================================
# WebRTCSetRemoteDescription: Set remote SDP description
# ============================================================

fn WebRTCSetRemoteDescription(pcId: int32, sdp: str): bool =
    let idx = WebRTCFindIndex(pcId)
    if idx < 0:
        return false
    rtcConnections[idx].remoteDescription = sdp
    return true

# ============================================================
# WebRTCAddIceCandidate: Add ICE candidate
# ============================================================

fn WebRTCAddIceCandidate(pcId: int32, candidate: str): bool =
    let idx = WebRTCFindIndex(pcId)
    if idx < 0:
        return false
    # Simplified: accept any candidate
    return true

# ============================================================
# WebRTCCreateDataChannel: Create a data channel on the PC
# ============================================================

fn WebRTCCreateDataChannel(pcId: int32, label: str): int32 =
    let idx = WebRTCFindIndex(pcId)
    if idx < 0:
        return 0
    let channelId = nextDcId
    nextDcId = nextDcId + 1
    var dc: WebRTCDataChannel
    dc.channelId = channelId
    dc.label = label
    dc.readyState = "connecting"
    dc.onmessage = 0
    dc.onopen = 0
    dc.onclose = 0
    var pc = rtcConnections[idx]
    add(pc.dataChannels, dc)
    rtcConnections[idx] = pc
    return channelId

# ============================================================
# WebRTCDataChannelSend: Send data over a data channel
# ============================================================

fn WebRTCDataChannelSend(channelId: int32, data: str): bool =
    var pcIdx: int32
    var dcIdx: int32
    if !WebRTCFindDataChannel(channelId, pcIdx, dcIdx):
        return false
    let dc: WebRTCDataChannel = rtcConnections[pcIdx].dataChannels[dcIdx]
    if dc.readyState != "open":
        return false
    # Data sent successfully (simplified: no-op)
    return true

# ============================================================
# WebRTCClose: Close the peer connection
# ============================================================

fn WebRTCClose(pcId: int32): bool =
    let idx = WebRTCFindIndex(pcId)
    if idx < 0:
        return false
    rtcConnections[idx].iceConnectionState = "disconnected"
    return true
