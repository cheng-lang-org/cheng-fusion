# web_geolocation_runtime.cheng
# Web Geolocation API decision core for the Cheng Web runtime.
# Pure Cheng: every branch below is real spec semantics (permission gate,
# cache freshness via maximumAge, provider unavailability vs timeout,
# coordinate domain validation, watch registry lifecycle with tombstone
# cancellation) and is proven by src/tests/web_geolocation_runtime_smoke.cheng.
# The native sensor bridge stays in web_geolocation_provider.cheng (FFI);
# the host-side bridge implementation remains open host work, same contract
# as the clipboard family.
#
# House style follows web_permissions_runtime / web_service_worker_runtime:
# seq + add for registries, tombstone rows keep id stability, no seq surgery.

type
    GeoCoord =
        latitude: float64
        longitude: float64
        accuracyMeters: float64

    GeoWatch =
        id: int32
        highAccuracy: bool
        maximumAgeMs: int64
        timeoutMs: int32
        active: bool      # false = tombstone (cancelled), kept for id stability

const
    GeoOk = 0
    GeoPermissionDenied = 1
    GeoPositionUnavailable = 2
    GeoTimeout = 3
    GeoRequestRequired = -1   # prompt state: caller must run the request flow
    GeoPending = -2           # terminal codes not reachable yet at this instant

var geoWatches: GeoWatch[]
var nextWatchId: int32 = 1

fn WebGeolocationPermissionGate(permissionState: str): int32 =
    # granted -> proceed; denied -> hard fail; anything else is prompt and
    # only a completed request flow can answer it.
    if permissionState == "granted":
        return GeoOk
    if permissionState == "denied":
        return GeoPermissionDenied
    return GeoRequestRequired

fn WebGeolocationCoordValid(latitude: float64, longitude: float64, accuracyMeters: float64): bool =
    # WGS84 domain check plus the Coordinates contract: accuracy is a
    # non-negative meter value; zero/negative accuracy carries no information
    # and the fix counts as unavailable.
    if latitude < -90.0 || latitude > 90.0:
        return false
    if longitude < -180.0 || longitude > 180.0:
        return false
    if accuracyMeters <= 0.0:
        return false
    return true

fn WebGeolocationCacheUsable(cacheAgeMs: int64, maximumAgeMs: int64): bool =
    # A cached fix is usable while its age stays inside maximumAge;
    # negative ages are clock skew and never usable.
    return cacheAgeMs >= 0 && cacheAgeMs <= maximumAgeMs

fn WebGeolocationResolveCurrentPosition(permissionState: str, hasCache: bool, cacheAgeMs: int64, maximumAgeMs: int64, providerUnavailable: bool, freshFixReady: bool, elapsedMs: int32, timeoutMs: int32): int32 =
    # Full getCurrentPosition decision surface at one instant.
    let gate = WebGeolocationPermissionGate(permissionState)
    if gate != GeoOk:
        return gate
    if hasCache:
        if WebGeolocationCacheUsable(cacheAgeMs, maximumAgeMs):
            return GeoOk
    if providerUnavailable:
        # an explicit provider failure outranks the timeout race
        return GeoPositionUnavailable
    if freshFixReady:
        if elapsedMs <= timeoutMs:
            return GeoOk
        # late fix after the deadline already fired: timeout wins
        return GeoTimeout
    if elapsedMs > timeoutMs:
        return GeoTimeout
    return GeoPending

fn WebGeolocationWatchStart(highAccuracy: bool, maximumAgeMs: int64, timeoutMs: int32): int32 =
    let id = nextWatchId
    nextWatchId = nextWatchId + 1
    var w: GeoWatch
    w.id = id
    w.highAccuracy = highAccuracy
    w.maximumAgeMs = maximumAgeMs
    w.timeoutMs = timeoutMs
    w.active = true
    add(geoWatches, w)
    return id

fn WebGeolocationFindWatchIndex(id: int32): int32 =
    # cancelled rows are tombstones: invisible to lookup, ids stay unique
    for i in 0..<geoWatches.len:
        if geoWatches[i].active:
            if geoWatches[i].id == id:
                return i
    return -1

fn WebGeolocationWatchCancel(id: int32): bool =
    let index = WebGeolocationFindWatchIndex(id)
    if index < 0:
        return false
    geoWatches[index].active = false
    return true

fn WebGeolocationWatchActiveCount(): int32 =
    var count: int32
    for i in 0..<geoWatches.len:
        if geoWatches[i].active:
            count = count + 1
    return count

fn WebGeolocationWatchAccepts(id: int32, fixAgeMs: int64): bool =
    # a delivered position update reaches the watcher only while it lives
    # and only when the fix satisfies that watcher's freshness bound
    let index = WebGeolocationFindWatchIndex(id)
    if index < 0:
        return false
    return WebGeolocationCacheUsable(fixAgeMs, geoWatches[index].maximumAgeMs)

fn WebGeolocationWatchHighAccuracy(id: int32, out: var bool): bool =
    let index = WebGeolocationFindWatchIndex(id)
    if index < 0:
        return false
    out = geoWatches[index].highAccuracy
    return true
