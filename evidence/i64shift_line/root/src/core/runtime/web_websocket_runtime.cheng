# web_websocket_runtime.cheng
# WebSocket API for Cheng Web runtime.
# Provides: WebSocketState type and WebSocket* functions
# RFC 6455 WebSocket protocol implementation (pure Cheng)
# Protocol layers:
#   - WebSocketFrameEncode/Decode (Section 5: Data Framing)
#   - HTTP Upgrade handshake (Section 4)
#   - Close frame handling (Section 5.5.1)
#   - High-level WebSocketSend/OnMessage

import std/seqs
import std/strings
import std/system

# ============================================================
# Constants
# ============================================================

# WebSocket opcodes (RFC 6455 Section 5.2)
const
    WebSocketOpcodeContinuation = 0x0
    WebSocketOpcodeText = 0x1
    WebSocketOpcodeBinary = 0x2
    WebSocketOpcodeClose = 0x8
    WebSocketOpcodePing = 0x9
    WebSocketOpcodePong = 0xA

# WebSocket close status codes (RFC 6455 Section 7.4)
const
    WebSocketCloseNormal = 1000
    WebSocketCloseGoingAway = 1001
    WebSocketCloseProtocolError = 1002
    WebSocketCloseUnsupportedData = 1003
    WebSocketCloseNoStatus = 1005
    WebSocketCloseAbnormal = 1006
    WebSocketCloseInvalidPayload = 1007
    WebSocketClosePolicyViolation = 1008
    WebSocketCloseMessageTooBig = 1009
    WebSocketCloseMandatoryExt = 1010
    WebSocketCloseServerError = 1011

# WebSocket readyState constants
const
    WebSocketConnecting = 0
    WebSocketOpen = 1
    WebSocketClosing = 2
    WebSocketClosed = 3

# Fixed masking key constant (for deterministic testing)
const wsDefaultMaskKey0: int32 = 0x12
const wsDefaultMaskKey1: int32 = 0x34
const wsDefaultMaskKey2: int32 = 0x56
const wsDefaultMaskKey3: int32 = 0x78

# RFC 6455 magic GUID for Sec-WebSocket-Accept
const wsServerMagicGUID: str = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

# ============================================================
# Types
# ============================================================

type
    WebSocketState =
        socketId: int32
        url: str
        readyState: int32     # 0=CONNECTING, 1=OPEN, 2=CLOSING, 3=CLOSED
        onopen: int32         # callbackFnId, 0=none
        onmessage: int32
        onerror: int32
        onclose: int32

    # RFC 6455 Section 5.2: Frame format
    WebSocketFrame =
        fin: bool
        opcode: int32
        mask: bool
        payloadLen: int32
        maskingKey: int32[]   # 4 elements, 1 byte per element
        payload: int32[]      # 1 byte per element

# ============================================================
# Global state
# ============================================================

var webSocketTable: WebSocketState[]
var nextSocketId: int32 = 1
var wsNextMaskSeq: int32  # simple mask key sequence counter

# ============================================================
# Byte-level I/O helpers on int32[] (1 byte per element)
# ============================================================

@borrows
fn wsReadByte(data: int32[], idx: int32): int32 =
    if idx < 0 or idx >= data.len:
        return 0
    return data[idx] & 0xFF

fn wsWriteByte(data: var int32[], idx: int32, val: int32) =
    if idx < 0 or idx >= data.len:
        return
    data[idx] = val & 0xFF

@borrows
fn wsReadInt16BE(data: int32[], idx: int32): int32 =
    let hi: int32 = wsReadByte(data, idx)
    let lo: int32 = wsReadByte(data, idx + 1)
    return (hi << 8) | lo

fn wsWriteInt16BE(data: var int32[], idx: int32, val: int32) =
    wsWriteByte(data, idx, (val >> 8) & 0xFF)
    wsWriteByte(data, idx + 1, val & 0xFF)

@borrows
fn wsReadInt64BE(data: int32[], idx: int32): int64 =
    var val: int64 = Int64(0)
    for i in 0..<8:
        val = (val << 8) | Int64(wsReadByte(data, idx + i))
    return val

# ============================================================
# string <-> int32[] payload conversion
# ============================================================

fn wsStringToPayload(s: str, out: var int32[]) =
    let n: int32 = strings.Len(s)
    setLen(out, n)
    for i in 0..<n:
        out[i] = Int32(s[i]) & 0xFF

@borrows
fn wsPayloadToString(payload: int32[], length: int32): str =
    if length <= 0:
        return ""
    let actualLen: int32 = payload.len
    let copyLen: int32 = length < actualLen ? length : actualLen
    let out: str = NewStringAlloc(copyLen)
    for i in 0..<copyLen:
        out[i] = Char(payload[i] & 0xFF)
    return out

# ============================================================
# WebSocketMask: XOR mask data with 4-byte masking key
# RFC 6455 Section 5.3
# ============================================================

fn WebSocketMask(data: var int32[], maskKey: int32[]) =
    let n: int32 = data.len
    if n <= 0:
        return
    let k0: int32 = maskKey[0] & 0xFF
    let k1: int32 = maskKey[1] & 0xFF
    let k2: int32 = maskKey[2] & 0xFF
    let k3: int32 = maskKey[3] & 0xFF
    for i in 0..<n:
        let r: int32 = i % 4
        if r == 0:
            data[i] = data[i] ^ k0
        elif r == 1:
            data[i] = data[i] ^ k1
        elif r == 2:
            data[i] = data[i] ^ k2
        else:
            data[i] = data[i] ^ k3

# ============================================================
# WebSocketFrameEncode: Encode frame to RFC 6455 binary format
# RFC 6455 Section 5.2
# fn WebSocketFrameEncode(frame: var WebSocketFrame, out: var int32[]): bool
# ============================================================

fn WebSocketFrameEncode(frame: var WebSocketFrame, out: var int32[]): bool =
    let payloadLen: int32 = frame.payload.len

    # Calculate header length
    var headerLen: int32 = 2  # Byte 0 (FIN/RSV/opcode) + Byte 1 (MASK/len)

    if payloadLen >= 126:
        if payloadLen >= 65536:
            # 64-bit extended length (8 bytes)
            headerLen = headerLen + 8
        else:
            # 16-bit extended length (2 bytes)
            headerLen = headerLen + 2

    if frame.mask:
        headerLen = headerLen + 4  # 4-byte masking key

    let totalLen: int32 = headerLen + payloadLen
    setLen(out, totalLen)
    if out.len < totalLen:
        return false

    # Byte 0: FIN(1) + RSV(000) + opcode(4)
    var b0: int32  # FIN=1
    b0 = b0 | (frame.opcode & 0x0F)
    wsWriteByte(out, 0, b0)

    # Byte 1: MASK + payload length (7-bit)
    var b1: int32
    if frame.mask:
        b1 = 0x80

    var cursor: int32 = 2  # current write position after header bytes

    if payloadLen < 126:
        b1 = b1 | (payloadLen & 0x7F)
        wsWriteByte(out, 1, b1)
    elif payloadLen < 65536:
        b1 = b1 | 126
        wsWriteByte(out, 1, b1)
        # 16-bit extended payload length (big-endian)
        wsWriteInt16BE(out, 2, payloadLen & 0xFFFF)
        cursor = cursor + 2
    else:
        b1 = b1 | 127
        wsWriteByte(out, 1, b1)
        # 64-bit extended payload length (big-endian)
        # Upper 4 bytes are zero (payloadLen < 2^31)
        for i in 0..<4:
            wsWriteByte(out, cursor, 0)
            cursor = cursor + 1
        wsWriteByte(out, cursor, (payloadLen >> 24) & 0xFF)
        wsWriteByte(out, cursor + 1, (payloadLen >> 16) & 0xFF)
        wsWriteByte(out, cursor + 2, (payloadLen >> 8) & 0xFF)
        wsWriteByte(out, cursor + 3, payloadLen & 0xFF)
        cursor = cursor + 4

    # Masking key and masked payload
    if frame.mask:
        # Generate masking key using simple sequence-based scheme
        setLen(frame.maskingKey, 4)
        let seq: int32 = wsNextMaskSeq
        wsNextMaskSeq = wsNextMaskSeq + 1
        frame.maskingKey[0] = (wsDefaultMaskKey0 + seq) & 0xFF
        frame.maskingKey[1] = (wsDefaultMaskKey1 + (seq * 7)) & 0xFF
        frame.maskingKey[2] = (wsDefaultMaskKey2 + (seq * 13)) & 0xFF
        frame.maskingKey[3] = (wsDefaultMaskKey3 + (seq * 23)) & 0xFF

        # Write masking key bytes
        wsWriteByte(out, cursor, frame.maskingKey[0])
        wsWriteByte(out, cursor + 1, frame.maskingKey[1])
        wsWriteByte(out, cursor + 2, frame.maskingKey[2])
        wsWriteByte(out, cursor + 3, frame.maskingKey[3])
        cursor = cursor + 4

        # Mask and write payload bytes
        for i in 0..<payloadLen:
            let maskByte: int32 = frame.maskingKey[i % 4]
            let masked: int32 = wsReadByte(frame.payload, i) ^ (maskByte & 0xFF)
            wsWriteByte(out, cursor + i, masked)
    else:
        # Copy payload directly (no masking)
        for i in 0..<payloadLen:
            wsWriteByte(out, cursor + i, wsReadByte(frame.payload, i))

    frame.payloadLen = payloadLen
    return true

# ============================================================
# WebSocketFrameDecode: Parse RFC 6455 binary frame
# RFC 6455 Section 5.2
# fn WebSocketFrameDecode(raw: int32[], out: var WebSocketFrame): bool
# ============================================================

fn WebSocketFrameDecode(raw: int32[], out: var WebSocketFrame): bool =
    let rawLen: int32 = raw.len
    if rawLen < 2:
        return false  # frame too short for header

    # Byte 0: FIN (bit 7), RSV (bits 4-6), opcode (bits 0-3)
    let b0: int32 = wsReadByte(raw, 0)
    let fin: bool = (b0 & 0x80) != 0
    let rsv: int32 = (b0 >> 4) & 0x07
    let opcode: int32 = b0 & 0x0F

    # RSV bits MUST be 0 (RFC 6455 Section 5.2)
    if rsv != 0:
        return false

    # Validate opcode (known values only)
    # 0x3-0x7 and 0xB-0xF are reserved
    var validOpcode: bool
    if opcode == WebSocketOpcodeContinuation:
        validOpcode = true
    elif opcode == WebSocketOpcodeText:
        validOpcode = true
    elif opcode == WebSocketOpcodeBinary:
        validOpcode = true
    elif opcode == WebSocketOpcodeClose:
        validOpcode = true
    elif opcode == WebSocketOpcodePing:
        validOpcode = true
    elif opcode == WebSocketOpcodePong:
        validOpcode = true
    if !validOpcode:
        return false

    # Byte 1: MASK (bit 7) + payload length (bits 0-6)
    let b1: int32 = wsReadByte(raw, 1)
    let mask: bool = (b1 & 0x80) != 0
    var payloadLen7: int32 = b1 & 0x7F

    var cursor: int32 = 2  # current read position

    # Parse extended payload length
    var payloadLen: int32 = payloadLen7
    if payloadLen7 == 126:
        if rawLen < cursor + 2:
            return false  # frame too short for 16-bit extended length
        payloadLen = wsReadInt16BE(raw, cursor)
        cursor = cursor + 2
    elif payloadLen7 == 127:
        if rawLen < cursor + 8:
            return false  # frame too short for 64-bit extended length
        let extLen64: int64 = wsReadInt64BE(raw, cursor)
        cursor = cursor + 8
        # Clamp to int32 max for safety
        if extLen64 > Int64(2147483647):
            payloadLen = 2147483647
        else:
            payloadLen = Int32(extLen64)

    # Parse masking key
    var maskingKey: int32[]
    if mask:
        if rawLen < cursor + 4:
            return false  # frame too short for masking key
        setLen(maskingKey, 4)
        maskingKey[0] = wsReadByte(raw, cursor)
        maskingKey[1] = wsReadByte(raw, cursor + 1)
        maskingKey[2] = wsReadByte(raw, cursor + 2)
        maskingKey[3] = wsReadByte(raw, cursor + 3)
        cursor = cursor + 4

    # Verify payload length against available data
    if rawLen < cursor + payloadLen:
        # Truncate payload to available data
        payloadLen = rawLen - cursor
        if payloadLen < 0:
            payloadLen = 0

    # Read and unmask payload
    var payload: int32[]
    setLen(payload, payloadLen)
    for i in 0..<payloadLen:
        payload[i] = wsReadByte(raw, cursor + i)

    if mask:
        # Unmask payload using masking key
        for i in 0..<payloadLen:
            let keyIdx: int32 = i % 4
            payload[i] = payload[i] ^ maskingKey[keyIdx]

    # Populate output frame
    out.fin = fin
    out.opcode = opcode
    out.mask = mask
    out.payloadLen = payloadLen
    out.maskingKey = maskingKey
    out.payload = payload
    return true

# ============================================================
# WebSocketGenerateKey: Generate Sec-WebSocket-Key
# RFC 6455 Section 4.1
# Simplified: return fixed key from RFC 6455 example
# ============================================================

fn WebSocketGenerateKey(): str =
    return "dGhlIHNhbXBsZSBub25jZQ=="

# ============================================================
# WebSocketBuildHandshakeRequest: Build HTTP upgrade request
# RFC 6455 Section 4.1
# fn WebSocketBuildHandshakeRequest(url: str, host: str, out: var str): bool
# ============================================================

fn WebSocketBuildHandshakeRequest(url: str, host: str, out: var str): bool =
    if strings.Len(url) <= 0:
        return false
    if strings.Len(host) <= 0:
        return false
    let key: str = WebSocketGenerateKey()
    # Build HTTP upgrade request without Fmt escapes (cold compiler limitation)
    var req: str = Fmt"GET {url} HTTP/1.1"
    req = strings.concatStr(req, "\r\n")
    req = strings.concatStr(req, "Host: ")
    req = strings.concatStr(req, host)
    req = strings.concatStr(req, "\r\n")
    req = strings.concatStr(req, "Upgrade: websocket")
    req = strings.concatStr(req, "\r\n")
    req = strings.concatStr(req, "Connection: Upgrade")
    req = strings.concatStr(req, "\r\n")
    req = strings.concatStr(req, "Sec-WebSocket-Key: ")
    req = strings.concatStr(req, key)
    req = strings.concatStr(req, "\r\n")
    req = strings.concatStr(req, "Sec-WebSocket-Version: 13")
    req = strings.concatStr(req, "\r\n")
    req = strings.concatStr(req, "\r\n")
    out = req
    return true

# ============================================================
# WebSocketParseHandshakeResponse: Parse HTTP 101 response
# RFC 6455 Section 4.2.2
# fn WebSocketParseHandshakeResponse(response: str, outAccept: var str): bool
# ============================================================

fn WebSocketParseHandshakeResponse(response: str, outAccept: var str): bool =
    let respLen: int32 = strings.Len(response)
    if respLen <= 0:
        return false

    # Check for HTTP/1.1 101 status line
    if !strings.hasPrefix(response, "HTTP/1.1 101"):
        return false

    # Extract Sec-WebSocket-Accept header
    let headerName: str = "Sec-WebSocket-Accept:"
    let searchStart: int32 = 12  # skip "HTTP/1.1 101"
    let nameLen: int32 = strings.Len(headerName)
    var found: bool
    var acceptStart: int32 = -1
    var acceptEnd: int32 = -1

    # Scan line by line for the header
    var i: int32 = searchStart
    while i < respLen:
        # Skip \r\n
        if i + 1 < respLen and response[i] == '\r' and response[i + 1] == '\n':
            i = i + 2
            continue

        # Check for header match
        if i + nameLen <= respLen:
            var matchedHeader: bool = true
            for j in 0..<nameLen:
                if response[i + j] != headerName[j]:
                    matchedHeader = false
                    break
            if matchedHeader:
                found = true
                acceptStart = i + nameLen
                break

        # Skip to end of line
        var lineEnd: bool
        while i < respLen and !lineEnd:
            if response[i] == '\r' or response[i] == '\n':
                lineEnd = true
            else:
                i = i + 1

    if !found:
        return false

    # Skip whitespace after colon
    while acceptStart < respLen:
        if response[acceptStart] == ' ' or response[acceptStart] == '\t':
            acceptStart = acceptStart + 1
        else:
            break

    # Find end of accept value (until \r or \n)
    acceptEnd = acceptStart
    while acceptEnd < respLen:
        if response[acceptEnd] == '\r' or response[acceptEnd] == '\n':
            break
        acceptEnd = acceptEnd + 1

    if acceptEnd <= acceptStart:
        return false

    # Extract accept value
    let acceptLen: int32 = acceptEnd - acceptStart
    outAccept = strings.SliceBytes(response, acceptStart, acceptLen)
    return true

# ============================================================
# WebSocketCloseFrameBuild: Build close frame
# RFC 6455 Section 5.5.1
# fn WebSocketCloseFrameBuild(code: int32, reason: str, out: var WebSocketFrame): bool
# ============================================================

fn WebSocketCloseFrameBuild(code: int32, reason: str, out: var WebSocketFrame): bool =
    let reasonLen: int32 = strings.Len(reason)
    let payloadLen: int32 = 2 + reasonLen  # 2 bytes status code + reason

    var payload: int32[]
    setLen(payload, payloadLen)
    if payload.len < payloadLen:
        return false

    # Status code as 2-byte big-endian
    payload[0] = (code >> 8) & 0xFF
    payload[1] = code & 0xFF

    # Reason string (UTF-8 bytes)
    for i in 0..<reasonLen:
        payload[2 + i] = Int32(reason[i]) & 0xFF

    out.fin = true
    out.opcode = WebSocketOpcodeClose
    out.mask = false
    out.payloadLen = payloadLen
    out.maskingKey = []
    out.payload = payload
    return true

# ============================================================
# WebSocketCloseFrameParse: Parse close frame
# RFC 6455 Section 5.5.1
# fn WebSocketCloseFrameParse(frame: var WebSocketFrame, outCode: var int32, outReason: var str): bool
# ============================================================

fn WebSocketCloseFrameParse(frame: var WebSocketFrame, outCode: var int32, outReason: var str): bool =
    if frame.opcode != WebSocketOpcodeClose:
        return false

    let payloadLen: int32 = frame.payload.len
    if payloadLen == 0:
        # No status code present
        outCode = WebSocketCloseNoStatus
        outReason = ""
        return true

    if payloadLen < 2:
        return false  # invalid: partial status code

    # Extract status code (big-endian)
    outCode = wsReadInt16BE(frame.payload, 0)

    # Extract reason string (remaining bytes)
    if payloadLen > 2:
        outReason = wsPayloadToString(frame.payload, payloadLen - 2)
    else:
        outReason = ""
    return true

# ============================================================
# WebSocket state management (existing)
# ============================================================

fn WebSocketCreate(url: str): int32 =
    let socketId = nextSocketId
    nextSocketId = nextSocketId + 1
    var state: WebSocketState
    state.socketId = socketId
    state.url = url
    state.readyState = WebSocketConnecting
    state.onopen = 0
    state.onmessage = 0
    state.onerror = 0
    state.onclose = 0
    add(webSocketTable, state)
    return socketId

fn WebSocketFindIndex(socketId: int32): int32 =
    for i in 0..<webSocketTable.len:
        if webSocketTable[i].socketId == socketId:
            return i
    return -1

fn WebSocketGetState(socketId: int32, out: var WebSocketState): bool =
    let index = WebSocketFindIndex(socketId)
    if index < 0:
        return false
    out = webSocketTable[index]
    return true

# ============================================================
# WebSocketSend: Encode and send WebSocket frame
# RFC 6455 Section 5
# fn WebSocketSend(socketId: int32, data: str, opcode: int32): bool
# ============================================================

fn WebSocketSend(socketId: int32, data: str, opcode: int32): bool =
    let index = WebSocketFindIndex(socketId)
    if index < 0:
        return false
    if webSocketTable[index].readyState != WebSocketOpen:
        return false

    # Build WebSocket frame
    var payload: int32[]
    wsStringToPayload(data, payload)

    var frame: WebSocketFrame
    frame.fin = true
    frame.opcode = opcode
    frame.mask = true  # client frames must be masked (RFC 6455 Section 5.1)
    frame.payloadLen = payload.len
    frame.maskingKey = []
    frame.payload = payload

    # Encode frame to wire format
    var encoded: int32[]
    if !WebSocketFrameEncode(frame, encoded):
        return false

    # Output encoded frame (echo for now, FFI boundary later)
    let frameHex: str = wsFrameToHex(encoded)
    echo(Fmt"WS FRAME: {frameHex}")
    return true

# ============================================================
# WebSocketOnMessage: Process incoming WebSocket frame
# fn WebSocketOnMessage(socketId: int32, rawFrame: int32[], outData: var str): bool
# ============================================================

fn WebSocketOnMessage(socketId: int32, rawFrame: int32[], outData: var str): bool =
    let index = WebSocketFindIndex(socketId)
    if index < 0:
        return false

    # Decode frame
    var frame: WebSocketFrame
    if !WebSocketFrameDecode(rawFrame, frame):
        return false

    let opcode: int32 = frame.opcode

    if opcode == WebSocketOpcodeText:
        # Extract payload as text string
        outData = wsPayloadToString(frame.payload, frame.payloadLen)
        return true

    elif opcode == WebSocketOpcodeBinary:
        # Binary data: convert to string representation for output
        outData = wsPayloadToString(frame.payload, frame.payloadLen)
        return true

    elif opcode == WebSocketOpcodePing:
        # Auto-respond with Pong (RFC 6455 Section 5.5.2)
        var pongPayload: int32[]
        # Echo the ping payload
        let payloadLen: int32 = frame.payload.len
        setLen(pongPayload, payloadLen)
        for i in 0..<payloadLen:
            pongPayload[i] = frame.payload[i]

        var pongFrame: WebSocketFrame
        pongFrame.fin = true
        pongFrame.opcode = WebSocketOpcodePong
        pongFrame.mask = false
        pongFrame.payloadLen = payloadLen
        pongFrame.maskingKey = []
        pongFrame.payload = pongPayload

        var encoded: int32[]
        if WebSocketFrameEncode(pongFrame, encoded):
            let frameHex: str = wsFrameToHex(encoded)
            echo(Fmt"WS PONG: {frameHex}")

        outData = ""
        return true

    elif opcode == WebSocketOpcodeClose:
        # Handle close frame (RFC 6455 Section 5.5.1)
        webSocketTable[index].readyState = WebSocketClosed
        var closeCode: int32
        var closeReason: str
        let parsed: bool = WebSocketCloseFrameParse(frame, closeCode, closeReason)
        if parsed:
            var closeMsg: str = "CLOSE code="
            closeMsg = strings.concatStr(closeMsg, strings.IntToStr(closeCode))
            closeMsg = strings.concatStr(closeMsg, " reason=")
            closeMsg = strings.concatStr(closeMsg, closeReason)
            outData = closeMsg
        else:
            outData = "CLOSE"
        return true

    elif opcode == WebSocketOpcodeContinuation:
        # Continuation frames are not supported (FIN=1 always)
        outData = ""
        return false

    elif opcode == WebSocketOpcodePong:
        # Pong received (no action needed)
        outData = "PONG"
        return true

    # Reserved opcode (should have been caught by decoder)
    outData = ""
    return false

# ============================================================
# WebSocketClose: Close WebSocket connection
# ============================================================

fn WebSocketClose(socketId: int32, code: int32, reason: str): bool =
    let index = WebSocketFindIndex(socketId)
    if index < 0:
        return false
    webSocketTable[index].readyState = WebSocketClosed
    # Build and echo close frame
    # Client-to-server frames MUST be masked (RFC 6455 Section 5.1)
    var closeFrame: WebSocketFrame
    if WebSocketCloseFrameBuild(code, reason, closeFrame):
        closeFrame.mask = true
        var encoded: int32[]
        if WebSocketFrameEncode(closeFrame, encoded):
            let frameHex: str = wsFrameToHex(encoded)
            echo(Fmt"WS CLOSE: {frameHex}")
    return true

# ============================================================
# WebSocket callback registration (existing)
# ============================================================

fn WebSocketSetOnOpen(socketId: int32, callbackFnId: int32): bool =
    let index = WebSocketFindIndex(socketId)
    if index < 0:
        return false
    webSocketTable[index].onopen = callbackFnId
    return true

fn WebSocketSetOnMessage(socketId: int32, callbackFnId: int32): bool =
    let index = WebSocketFindIndex(socketId)
    if index < 0:
        return false
    webSocketTable[index].onmessage = callbackFnId
    return true

fn WebSocketSetOnError(socketId: int32, callbackFnId: int32): bool =
    let index = WebSocketFindIndex(socketId)
    if index < 0:
        return false
    webSocketTable[index].onerror = callbackFnId
    return true

fn WebSocketSetOnClose(socketId: int32, callbackFnId: int32): bool =
    let index = WebSocketFindIndex(socketId)
    if index < 0:
        return false
    webSocketTable[index].onclose = callbackFnId
    return true

# ============================================================
# Helper: Frame to hex string (for debugging/echo output)
# ============================================================

const wsHexChars: str = "0123456789ABCDEF"

fn wsFrameToHex(data: int32[]): str =
    let n: int32 = data.len
    if n <= 0:
        return ""
    var out: str
    for i in 0..<n:
        let b: int32 = wsReadByte(data, i)
        let hi: int32 = (b >> 4) & 0x0F
        let lo: int32 = b & 0x0F
        let hiChar: str = strings.CharToStr(wsHexChars[hi])
        let loChar: str = strings.CharToStr(wsHexChars[lo])
        out = strings.concatStr(out, hiChar)
        out = strings.concatStr(out, loChar)
    return out
