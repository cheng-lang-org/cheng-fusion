# Pure Cheng handle table: zero C dependency. Thread-safe via atomic spin lock.
# uint64 handle = (generation << 32) | slot_index
# Stale detection: released handles cannot be reused with old generation.

import std/atomic

# atomic.CasI32/StoreI32 的 I32 是 ref 堆对象封装, 不能对裸 int32 全局取址;
# atomic 模块的 atomicCasI32/atomicStoreI32 (var int32 参数 importc 原语) 是模块私有
# (小写名不导出, 限定名调用被 VisibleFromImport 拒绝)。与 core_runtime 的
# libc_xxx 模式一致, 本文件自声明同名 importc 原语, 对全局 int32 锁字做
# 原子 CAS/Store。
@importc("cheng_atomic_cas_i32")
fn handleAtomicCasI32(value: var int32, expect: int32, desired: int32): int32

@importc("cheng_atomic_store_i32")
fn handleAtomicStoreI32(value: var int32, val: int32)

const
    HandleTableSlotCount = 4096
    HandleTableGenerationShift: uint64 = 32
    HandleTableSlotIndexMask: uint64 = 0xFFFFFFFF
    HandleTableErrOk = 0
    HandleTableErrStale = 1
    HandleTableErrInvalid = 2
    HandleTableErrFull = 3

var
    handleTableInitialized: bool
    handleTableInitLock: int32
    handleTableLockWord: int32
    handleTableInUse: int32
    handleTableGenerations: int32[]
    handleTableValues: int32[]

fn handle_table_init() =
    if handleTableInitialized:
        return
    while true:
        if handleAtomicCasI32(handleTableInitLock, 0, 1) != 0:
            break
    if handleTableInitialized:
        handleAtomicStoreI32(handleTableInitLock, 0)
        return
    handleTableGenerations = []
    handleTableValues = []
    for i in 0..<HandleTableSlotCount:
        add(handleTableGenerations, 0)
        add(handleTableValues, 0)
    handleTableInUse = 0
    handleAtomicStoreI32(handleTableLockWord, 0)
    handleTableInitialized = true
    handleAtomicStoreI32(handleTableInitLock, 0)

fn handle_table_lock() =
    while true:
        if handleAtomicCasI32(handleTableLockWord, 0, 1) != 0:
            break

fn handle_table_unlock() =
    handleAtomicStoreI32(handleTableLockWord, 0)

fn handle_table_new_i32(value: int32): uint64 =
    if !handleTableInitialized:
        handle_table_init()
    handle_table_lock()
    if handleTableInUse >= HandleTableSlotCount:
        handle_table_unlock()
        return 0
    var freeSlot = -1
    for i in 0..<HandleTableSlotCount:
        if handleTableGenerations[i] <= 0:
            freeSlot = i
            break
    if freeSlot < 0:
        handle_table_unlock()
        return 0
    var newGen = 1
    if handleTableGenerations[freeSlot] < 0:
        newGen = 0 - handleTableGenerations[freeSlot] + 1
    handleTableGenerations[freeSlot] = newGen
    handleTableValues[freeSlot] = value
    handleTableInUse = handleTableInUse + 1
    handle_table_unlock()
    return (uint64(newGen) << HandleTableGenerationShift) | uint64(freeSlot)

fn handle_table_get_i32(handle: uint64, outValue: var int32): int32 =
    let slotIndex = int32(handle & HandleTableSlotIndexMask)
    let generation = int32((handle >> HandleTableGenerationShift) & HandleTableSlotIndexMask)
    if slotIndex < 0 || slotIndex >= HandleTableSlotCount:
        return HandleTableErrInvalid
    if !handleTableInitialized:
        return HandleTableErrInvalid
    handle_table_lock()
    let curGen = handleTableGenerations[slotIndex]
    if curGen != generation:
        handle_table_unlock()
        return HandleTableErrStale
    outValue = handleTableValues[slotIndex]
    handle_table_unlock()
    return HandleTableErrOk

fn handle_table_add_i32(handle: uint64, delta: int32, outValue: var int32): int32 =
    let slotIndex = int32(handle & HandleTableSlotIndexMask)
    let generation = int32((handle >> HandleTableGenerationShift) & HandleTableSlotIndexMask)
    if slotIndex < 0 || slotIndex >= HandleTableSlotCount:
        return HandleTableErrInvalid
    if !handleTableInitialized:
        return HandleTableErrInvalid
    handle_table_lock()
    let curGen = handleTableGenerations[slotIndex]
    if curGen != generation:
        handle_table_unlock()
        return HandleTableErrStale
    let newValue = handleTableValues[slotIndex] + delta
    handleTableValues[slotIndex] = newValue
    outValue = newValue
    handle_table_unlock()
    return HandleTableErrOk

fn handle_table_release_i32(handle: uint64): int32 =
    let slotIndex = int32(handle & HandleTableSlotIndexMask)
    let generation = int32((handle >> HandleTableGenerationShift) & HandleTableSlotIndexMask)
    if slotIndex < 0 || slotIndex >= HandleTableSlotCount:
        return HandleTableErrInvalid
    if !handleTableInitialized:
        return HandleTableErrInvalid
    handle_table_lock()
    let curGen = handleTableGenerations[slotIndex]
    if curGen != generation:
        handle_table_unlock()
        return HandleTableErrStale
    handleTableGenerations[slotIndex] = 0 - curGen
    handleTableValues[slotIndex] = 0
    handleTableInUse = handleTableInUse - 1
    handle_table_unlock()
    return HandleTableErrOk

fn HandleTableNewI32(value: int32): uint64 =
    return handle_table_new_i32(value)

fn HandleTableGetI32(handle: uint64, outValue: var int32): int32 =
    return handle_table_get_i32(handle, outValue)

fn HandleTableAddI32(handle: uint64, delta: int32, outValue: var int32): int32 =
    return handle_table_add_i32(handle, delta, outValue)

fn HandleTableReleaseI32(handle: uint64): int32 =
    return handle_table_release_i32(handle)
