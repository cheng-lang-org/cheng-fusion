# Production held-exec activation event issuer.
#
# Producer side of the provider-owned activation event stream: given the
# chain-wide session / identity / workload bindings plus per-step real runtime
# evidence injected by the launcher arming edge, issue the frozen seven-event
# sequence
#
#   provider_activated -> launcher_held_identity_verified
#   -> binary_held_identity_verified -> zero_read_admitted
#   -> held_exec_started -> child_identity_observed -> activation_consumed
#
# with strictly increasing sequence numbers, previousEventCid chaining and the
# canonical self-hash eventCid recomputed per event through the provider's own
# CsgCoreProductionHeldExecProviderEventCid (sha256 domain CID, see
# merkle_store_codec). No new hashing scheme is introduced here.
#
# The issuer is a pure constructor: no I/O, no syscalls, no global state. It
# never fabricates observations. Every observation bit carried by an event is
# copied from a CsgCoreProductionHeldExecStepEvidence instance that the arming
# edge fills from real runtime facts. The issuer refuses to issue (structured
# error, issuer state untouched) when evidence is missing or when the observed
# values contradict the only pattern the frozen consumer accepts:
#
#   step  kind                             admission held   release output
#   1     provider_activated               false     false  false   false
#   2     launcher_held_identity_verified  false     false  false   false
#   3     binary_held_identity_verified    false     false  false   false
#   4     zero_read_admitted               true      false  false   false
#   5     held_exec_started                true      true   true    false
#   6     child_identity_observed          true      true   true    false
#   7     activation_consumed              true      true   true    true
#
# plus inputReadCountBeforeAdmission == 0 and namedPathExecutionObserved ==
# false at every step.
#
# Arming-edge injection surface (real evidence the upstream must supply):
#   - CsgCoreProductionHeldExecEventIssuerParams, once per activation:
#     sessionGeneration / sessionNonceCid / sessionCapabilityCid from the
#     live RuntimeAllocationLedgerSessionCapability; providerAuthorityCid;
#     launcherHeldDescriptorIdentityCid and binaryHeldDescriptorIdentityCid
#     from the real stat + retained-fd identity computation;
#     childProcessIdentityCid from the spawned child identity;
#     executableObjectCid (must equal binaryIdentity.bytesCid), argvCid,
#     environmentCid, planReceiptCid, proofCid, admissionReceiptCid from the
#     workload binding; executionMethod for the current platform.
#   - CsgCoreProductionHeldExecStepEvidence, once per step, with collected
#     set to true only after the upstream actually performed that step's
#     observation: fd read counting before admission, admission receipt
#     closure, path-execution audit, held-descriptor exec, execution release
#     and output publication facts.
#
# The issued events are handed to the arming edge as values; the edge owns
# delivery and receipt assembly (eventStreamCid / receiptCid sealing via the
# provider's exported functions). The issuer intentionally does not assemble
# or seal receipts.

import std/strings
import cheng/core/csg_core/merkle_store_codec
import cheng/core/runtime/production_held_exec_provider as held_exec_provider

const
    CsgCoreProductionHeldExecEventIssuerEventCount: int32 = 7
    CsgCoreProductionHeldExecEventIssuerErrParams: str =
        "production_held_exec_event_issuer_e_params"
    CsgCoreProductionHeldExecEventIssuerErrEvidenceMissing: str =
        "production_held_exec_event_issuer_e_evidence_missing"
    CsgCoreProductionHeldExecEventIssuerErrEvidenceMismatch: str =
        "production_held_exec_event_issuer_e_evidence_mismatch"
    CsgCoreProductionHeldExecEventIssuerErrComplete: str =
        "production_held_exec_event_issuer_e_complete"
    CsgCoreProductionHeldExecEventIssuerErrReplay: str =
        "production_held_exec_event_issuer_e_replay"
    CsgCoreProductionHeldExecEventIssuerErrSelfCheck: str =
        "production_held_exec_event_issuer_e_selfcheck"

type
    # Chain-wide bindings, fixed for all seven events of one activation.
    CsgCoreProductionHeldExecEventIssuerParams =
        sessionGeneration: uint64
        sessionNonceCid: str
        sessionCapabilityCid: str
        providerAuthorityCid: str
        launcherHeldDescriptorIdentityCid: str
        binaryHeldDescriptorIdentityCid: str
        childProcessIdentityCid: str
        executableObjectCid: str
        argvCid: str
        environmentCid: str
        planReceiptCid: str
        proofCid: str
        admissionReceiptCid: str
        executionMethod: str

    # Real per-step runtime observations injected by the arming edge.
    # collected must be false until the upstream truly performed the step's
    # observation; a zero-valued evidence instance is never issuable.
    CsgCoreProductionHeldExecStepEvidence =
        collected: bool
        inputReadCountBeforeAdmission: int64
        admissionReceiptClosed: bool
        namedPathExecutionObserved: bool
        heldDescriptorExecutionObserved: bool
        executionReleaseObserved: bool
        outputPublicationObserved: bool

    CsgCoreProductionHeldExecEventIssuer =
        params: CsgCoreProductionHeldExecEventIssuerParams
        issuedCount: int32
        lastEventCid: str

@borrows
fn CsgCoreProductionHeldExecEventIssuerParamsStrictValid(
        params: CsgCoreProductionHeldExecEventIssuerParams): bool =
    if params.sessionGeneration == uint64(0):
        return false
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.sessionNonceCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.sessionCapabilityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.providerAuthorityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.launcherHeldDescriptorIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.binaryHeldDescriptorIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.childProcessIdentityCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.executableObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(params.argvCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.environmentCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.planReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(params.proofCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           params.admissionReceiptCid):
        return false
    if params.executionMethod !=
           held_exec_provider.CsgCoreProductionHeldExecLinuxMethod &&
       params.executionMethod !=
           held_exec_provider.CsgCoreProductionHeldExecDarwinMethod:
        return false
    # Session / identity distinctness rules mirrored from the frozen
    # consumer's receipt validation.
    if params.sessionCapabilityCid == params.sessionNonceCid ||
       params.providerAuthorityCid == params.sessionNonceCid ||
       params.providerAuthorityCid == params.sessionCapabilityCid ||
       params.providerAuthorityCid ==
           params.launcherHeldDescriptorIdentityCid ||
       params.providerAuthorityCid ==
           params.binaryHeldDescriptorIdentityCid ||
       params.childProcessIdentityCid ==
           params.launcherHeldDescriptorIdentityCid ||
       params.childProcessIdentityCid ==
           params.binaryHeldDescriptorIdentityCid ||
       params.launcherHeldDescriptorIdentityCid ==
           params.binaryHeldDescriptorIdentityCid:
        return false
    # Workload distinctness rules carried by every event binding.
    if params.executableObjectCid ==
           params.binaryHeldDescriptorIdentityCid ||
       params.executableObjectCid == params.argvCid ||
       params.argvCid == params.environmentCid ||
       params.environmentCid == params.executableObjectCid ||
       params.executableObjectCid == params.planReceiptCid ||
       params.planReceiptCid == params.proofCid ||
       params.proofCid == params.admissionReceiptCid:
        return false
    return true

fn csgHeldExecEventIssuerStepExpectation(
        step: int32,
        kind: var str,
        stateBefore: var str,
        stateAfter: var str,
        admissionClosed: var bool,
        heldExecution: var bool,
        executionRelease: var bool,
        outputPublication: var bool): bool =
    admissionClosed = false
    heldExecution = false
    executionRelease = false
    outputPublication = false
    if step == 1:
        kind = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecEventActivated)
        stateBefore = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateEmpty)
        stateAfter = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateActivated)
    elif step == 2:
        kind = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecEventLauncherHeld)
        stateBefore = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateActivated)
        stateAfter = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateLauncherHeld)
    elif step == 3:
        kind = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecEventBinaryHeld)
        stateBefore = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateLauncherHeld)
        stateAfter = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateBinaryHeld)
    elif step == 4:
        kind = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecEventZeroReadAdmitted)
        stateBefore = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateBinaryHeld)
        stateAfter = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateAdmitted)
        admissionClosed = true
    elif step == 5:
        kind = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecEventHeldExecStarted)
        stateBefore = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateAdmitted)
        stateAfter = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateExecuted)
        admissionClosed = true
        heldExecution = true
        executionRelease = true
    elif step == 6:
        kind = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecEventChildObserved)
        stateBefore = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateExecuted)
        stateAfter = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateObserved)
        admissionClosed = true
        heldExecution = true
        executionRelease = true
    elif step == 7:
        kind = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecEventConsumed)
        stateBefore = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateObserved)
        stateAfter = strings.CloneStr(
            held_exec_provider.CsgCoreProductionHeldExecStateConsumed)
        admissionClosed = true
        heldExecution = true
        executionRelease = true
        outputPublication = true
    else:
        return false
    return true

@borrows
fn csgHeldExecEventIssuerStepSubjectCid(
        params: CsgCoreProductionHeldExecEventIssuerParams,
        step: int32): str =
    if step == 2:
        return strings.CloneStr(params.launcherHeldDescriptorIdentityCid)
    if step == 3 || step == 5:
        return strings.CloneStr(params.binaryHeldDescriptorIdentityCid)
    if step == 6:
        return strings.CloneStr(params.childProcessIdentityCid)
    return strings.CloneStr(params.providerAuthorityCid)

@borrows
fn CsgCoreProductionHeldExecEventIssuerInitInto(
        params: CsgCoreProductionHeldExecEventIssuerParams,
        out: var CsgCoreProductionHeldExecEventIssuer,
        err: var str): bool =
    if !CsgCoreProductionHeldExecEventIssuerParamsStrictValid(params):
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrParams)
        return false
    out = CsgCoreProductionHeldExecEventIssuer()
    out.params.sessionGeneration = params.sessionGeneration
    out.params.sessionNonceCid = strings.CloneStr(params.sessionNonceCid)
    out.params.sessionCapabilityCid =
        strings.CloneStr(params.sessionCapabilityCid)
    out.params.providerAuthorityCid =
        strings.CloneStr(params.providerAuthorityCid)
    out.params.launcherHeldDescriptorIdentityCid =
        strings.CloneStr(params.launcherHeldDescriptorIdentityCid)
    out.params.binaryHeldDescriptorIdentityCid =
        strings.CloneStr(params.binaryHeldDescriptorIdentityCid)
    out.params.childProcessIdentityCid =
        strings.CloneStr(params.childProcessIdentityCid)
    out.params.executableObjectCid =
        strings.CloneStr(params.executableObjectCid)
    out.params.argvCid = strings.CloneStr(params.argvCid)
    out.params.environmentCid = strings.CloneStr(params.environmentCid)
    out.params.planReceiptCid = strings.CloneStr(params.planReceiptCid)
    out.params.proofCid = strings.CloneStr(params.proofCid)
    out.params.admissionReceiptCid =
        strings.CloneStr(params.admissionReceiptCid)
    out.params.executionMethod = strings.CloneStr(params.executionMethod)
    out.issuedCount = 0
    out.lastEventCid = ""
    err = ""
    return true

fn CsgCoreProductionHeldExecEventIssuerIssueNextInto(
        issuer: var CsgCoreProductionHeldExecEventIssuer,
        evidence: CsgCoreProductionHeldExecStepEvidence,
        event: var held_exec_provider.CsgCoreProductionHeldExecEvent,
        err: var str): bool =
    let step = issuer.issuedCount + 1
    var kind: str
    var stateBefore: str
    var stateAfter: str
    var admissionClosed: bool
    var heldExecution: bool
    var executionRelease: bool
    var outputPublication: bool
    if !csgHeldExecEventIssuerStepExpectation(
           step, kind, stateBefore, stateAfter,
           admissionClosed, heldExecution,
           executionRelease, outputPublication):
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrComplete)
        return false
    # Never fabricate: without upstream-collected evidence the event is not
    # issuable, and the issuer state stays untouched so the edge can retry
    # once the real observation exists.
    if !evidence.collected:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrEvidenceMissing)
        return false
    if evidence.inputReadCountBeforeAdmission != int64(0) ||
       evidence.namedPathExecutionObserved ||
       evidence.admissionReceiptClosed != admissionClosed ||
       evidence.heldDescriptorExecutionObserved != heldExecution ||
       evidence.executionReleaseObserved != executionRelease ||
       evidence.outputPublicationObserved != outputPublication:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrEvidenceMismatch)
        return false
    event = held_exec_provider.CsgCoreProductionHeldExecEvent()
    event.schema = strings.CloneStr(
        held_exec_provider.CsgCoreProductionHeldExecProviderSchema)
    event.sequence = step
    event.kind = kind
    event.stateBefore = stateBefore
    event.stateAfter = stateAfter
    event.previousEventCid = strings.CloneStr(issuer.lastEventCid)
    event.sessionGeneration = issuer.params.sessionGeneration
    event.sessionNonceCid = strings.CloneStr(issuer.params.sessionNonceCid)
    event.sessionCapabilityCid =
        strings.CloneStr(issuer.params.sessionCapabilityCid)
    event.providerAuthorityCid =
        strings.CloneStr(issuer.params.providerAuthorityCid)
    event.launcherIdentityCid =
        strings.CloneStr(issuer.params.launcherHeldDescriptorIdentityCid)
    event.binaryIdentityCid =
        strings.CloneStr(issuer.params.binaryHeldDescriptorIdentityCid)
    event.childProcessIdentityCid =
        strings.CloneStr(issuer.params.childProcessIdentityCid)
    event.subjectIdentityCid =
        csgHeldExecEventIssuerStepSubjectCid(issuer.params, step)
    event.executableObjectCid =
        strings.CloneStr(issuer.params.executableObjectCid)
    event.heldDescriptorIdentityCid =
        strings.CloneStr(issuer.params.binaryHeldDescriptorIdentityCid)
    event.argvCid = strings.CloneStr(issuer.params.argvCid)
    event.environmentCid = strings.CloneStr(issuer.params.environmentCid)
    event.planReceiptCid = strings.CloneStr(issuer.params.planReceiptCid)
    event.proofCid = strings.CloneStr(issuer.params.proofCid)
    event.admissionReceiptCid =
        strings.CloneStr(issuer.params.admissionReceiptCid)
    event.executionMethod = strings.CloneStr(issuer.params.executionMethod)
    event.inputReadCountBeforeAdmission =
        evidence.inputReadCountBeforeAdmission
    event.admissionReceiptClosed = evidence.admissionReceiptClosed
    event.namedPathExecutionObserved = evidence.namedPathExecutionObserved
    event.heldDescriptorExecutionObserved =
        evidence.heldDescriptorExecutionObserved
    event.executionReleaseObserved = evidence.executionReleaseObserved
    event.outputPublicationObserved = evidence.outputPublicationObserved
    event.eventCid =
        held_exec_provider.CsgCoreProductionHeldExecProviderEventCid(event)
    if event.eventCid == issuer.lastEventCid:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrReplay)
        return false
    issuer.issuedCount = step
    issuer.lastEventCid = strings.CloneStr(event.eventCid)
    err = ""
    return true

@borrows
fn CsgCoreProductionHeldExecEventIssuerComplete(
        issuer: CsgCoreProductionHeldExecEventIssuer): bool =
    return issuer.issuedCount ==
        CsgCoreProductionHeldExecEventIssuerEventCount

# --- minimal self-check ---------------------------------------------------
#
# Builds a full evidence-complete activation: mints fixture bindings with
# valid canonical CIDs, issues the seven events through the issuer, then
# proves the chain against the frozen consumer
# (CsgCoreProductionHeldExecProviderReceiptStrictValidateInto), which
# recomputes every eventCid, the previousEventCid links and the sequence.
# Negative arms prove refusal when evidence is missing or contradicts the
# frozen step pattern, and that a broken chain link is rejected.

const
    csgHeldExecEventIssuerSelfCheckCidNonce: str =
        "sha256:0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"
    csgHeldExecEventIssuerSelfCheckCidCapability: str =
        "sha256:0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"
    csgHeldExecEventIssuerSelfCheckCidAuthority: str =
        "sha256:0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c"
    csgHeldExecEventIssuerSelfCheckCidChild: str =
        "sha256:0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d"
    csgHeldExecEventIssuerSelfCheckCidLauncherBytes: str =
        "sha256:0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e0e"
    csgHeldExecEventIssuerSelfCheckCidLauncherAnchor: str =
        "sha256:0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f"
    csgHeldExecEventIssuerSelfCheckCidLauncherImmutable: str =
        "sha256:1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a"
    csgHeldExecEventIssuerSelfCheckCidLauncherToken: str =
        "sha256:1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b"
    csgHeldExecEventIssuerSelfCheckCidBinaryBytes: str =
        "sha256:1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c1c"
    csgHeldExecEventIssuerSelfCheckCidBinaryAnchor: str =
        "sha256:1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d1d"
    csgHeldExecEventIssuerSelfCheckCidBinaryImmutable: str =
        "sha256:1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e1e"
    csgHeldExecEventIssuerSelfCheckCidBinaryToken: str =
        "sha256:1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f1f"
    csgHeldExecEventIssuerSelfCheckCidArgv: str =
        "sha256:2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a"
    csgHeldExecEventIssuerSelfCheckCidEnvironment: str =
        "sha256:2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b"
    csgHeldExecEventIssuerSelfCheckCidPlan: str =
        "sha256:2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c"
    csgHeldExecEventIssuerSelfCheckCidProof: str =
        "sha256:2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d"
    csgHeldExecEventIssuerSelfCheckCidAdmission: str =
        "sha256:2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e2e"
    csgHeldExecEventIssuerSelfCheckCidCommand: str =
        "sha256:2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f2f"
    csgHeldExecEventIssuerSelfCheckCidInputSet: str =
        "sha256:3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a"
    csgHeldExecEventIssuerSelfCheckCidOutputContract: str =
        "sha256:3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b3b"

fn csgHeldExecEventIssuerSelfCheckIdentity(
        inode: uint64,
        bytesCid: str,
        anchorCid: str,
        immutableCid: str,
        tokenCid: str): held_exec_provider.CsgCoreProductionHeldExecIdentity =
    var out: held_exec_provider.CsgCoreProductionHeldExecIdentity
    out.device = uint64(9)
    out.inode = inode
    out.mode = 32841
    out.linkCount = uint64(1)
    out.size = int64(4096)
    out.ownerUid = uint64(0)
    out.ownerGid = uint64(0)
    out.mtimeSec = int64(1700000000)
    out.mtimeNsec = int64(31)
    out.ctimeSec = int64(1700000001)
    out.ctimeNsec = int64(37)
    out.bytesCid = bytesCid
    out.externalAnchorCid = anchorCid
    out.immutableReceiptCid = immutableCid
    out.heldDescriptorTokenCid = tokenCid
    out.heldDescriptorIdentityCid =
        held_exec_provider.CsgCoreProductionHeldExecProviderIdentityCid(out)
    return out

fn CsgCoreProductionHeldExecEventIssuerSelfCheckInto(err: var str): bool =
    var launcherIdentity = csgHeldExecEventIssuerSelfCheckIdentity(
        uint64(41),
        csgHeldExecEventIssuerSelfCheckCidLauncherBytes,
        csgHeldExecEventIssuerSelfCheckCidLauncherAnchor,
        csgHeldExecEventIssuerSelfCheckCidLauncherImmutable,
        csgHeldExecEventIssuerSelfCheckCidLauncherToken)
    var binaryIdentity = csgHeldExecEventIssuerSelfCheckIdentity(
        uint64(43),
        csgHeldExecEventIssuerSelfCheckCidBinaryBytes,
        csgHeldExecEventIssuerSelfCheckCidBinaryAnchor,
        csgHeldExecEventIssuerSelfCheckCidBinaryImmutable,
        csgHeldExecEventIssuerSelfCheckCidBinaryToken)
    var params: CsgCoreProductionHeldExecEventIssuerParams
    params.sessionGeneration = uint64(7)
    params.sessionNonceCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidNonce)
    params.sessionCapabilityCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidCapability)
    params.providerAuthorityCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidAuthority)
    params.launcherHeldDescriptorIdentityCid =
        strings.CloneStr(launcherIdentity.heldDescriptorIdentityCid)
    params.binaryHeldDescriptorIdentityCid =
        strings.CloneStr(binaryIdentity.heldDescriptorIdentityCid)
    params.childProcessIdentityCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidChild)
    params.executableObjectCid =
        strings.CloneStr(binaryIdentity.bytesCid)
    params.argvCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidArgv)
    params.environmentCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidEnvironment)
    params.planReceiptCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidPlan)
    params.proofCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidProof)
    params.admissionReceiptCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidAdmission)
    params.executionMethod = strings.CloneStr(
        held_exec_provider.CsgCoreProductionHeldExecLinuxMethod)

    # Negative: invalid params refused.
    var badParams: CsgCoreProductionHeldExecEventIssuerParams
    var issuerBad: CsgCoreProductionHeldExecEventIssuer
    if CsgCoreProductionHeldExecEventIssuerInitInto(
           badParams, issuerBad, err) ||
       err != CsgCoreProductionHeldExecEventIssuerErrParams:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false

    # Negative: missing evidence refused, issuer state untouched.
    var issuerNeg: CsgCoreProductionHeldExecEventIssuer
    if !CsgCoreProductionHeldExecEventIssuerInitInto(
           params, issuerNeg, err):
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false
    var eventNeg: held_exec_provider.CsgCoreProductionHeldExecEvent
    var missingEvidence: CsgCoreProductionHeldExecStepEvidence
    if CsgCoreProductionHeldExecEventIssuerIssueNextInto(
           issuerNeg, missingEvidence, eventNeg, err) ||
       err != CsgCoreProductionHeldExecEventIssuerErrEvidenceMissing ||
       issuerNeg.issuedCount != 0:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false
    # Negative: observation contradicting the frozen step-1 pattern refused.
    var mismatchEvidence: CsgCoreProductionHeldExecStepEvidence
    mismatchEvidence.collected = true
    mismatchEvidence.heldDescriptorExecutionObserved = true
    if CsgCoreProductionHeldExecEventIssuerIssueNextInto(
           issuerNeg, mismatchEvidence, eventNeg, err) ||
       err != CsgCoreProductionHeldExecEventIssuerErrEvidenceMismatch ||
       issuerNeg.issuedCount != 0:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false
    # Negative: any pre-admission input read refuses admission.
    var readEvidence: CsgCoreProductionHeldExecStepEvidence
    readEvidence.collected = true
    readEvidence.inputReadCountBeforeAdmission = int64(1)
    if CsgCoreProductionHeldExecEventIssuerIssueNextInto(
           issuerNeg, readEvidence, eventNeg, err) ||
       err != CsgCoreProductionHeldExecEventIssuerErrEvidenceMismatch ||
       issuerNeg.issuedCount != 0:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false

    # Positive: full evidence-complete seven-event chain.
    var issuer: CsgCoreProductionHeldExecEventIssuer
    if !CsgCoreProductionHeldExecEventIssuerInitInto(params, issuer, err):
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false
    var receipt: held_exec_provider.CsgCoreProductionHeldExecReceipt
    receipt.schema = strings.CloneStr(
        held_exec_provider.CsgCoreProductionHeldExecProviderSchema)
    receipt.platform = strings.CloneStr(
        held_exec_provider.CsgCoreProductionHeldExecLinux)
    receipt.executionMethod = strings.CloneStr(
        held_exec_provider.CsgCoreProductionHeldExecLinuxMethod)
    receipt.executionScope = strings.CloneStr(
        held_exec_provider.CsgCoreProductionHeldExecScopeMilestones)
    receipt.sessionGeneration = params.sessionGeneration
    receipt.sessionNonceCid = strings.CloneStr(params.sessionNonceCid)
    receipt.sessionCapabilityCid =
        strings.CloneStr(params.sessionCapabilityCid)
    receipt.activationOrdinal = uint64(1)
    receipt.providerAuthorityCid =
        strings.CloneStr(params.providerAuthorityCid)
    receipt.launcherIdentity = launcherIdentity
    receipt.binaryIdentity = binaryIdentity
    receipt.childProcessIdentityCid =
        strings.CloneStr(params.childProcessIdentityCid)
    receipt.workload.executionScope = receipt.executionScope
    receipt.workload.commandCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidCommand)
    receipt.workload.inputSetCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidInputSet)
    receipt.workload.outputContractCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidOutputContract)
    receipt.workload.executableObjectCid =
        strings.CloneStr(params.executableObjectCid)
    receipt.workload.argvCid = strings.CloneStr(params.argvCid)
    receipt.workload.environmentCid =
        strings.CloneStr(params.environmentCid)
    receipt.workload.planReceiptCid =
        strings.CloneStr(params.planReceiptCid)
    receipt.workload.proofCid = strings.CloneStr(params.proofCid)
    receipt.workload.admissionReceiptCid =
        strings.CloneStr(params.admissionReceiptCid)
    var lastCid: str
    lastCid = ""
    for step in 1..<8:
        var event: held_exec_provider.CsgCoreProductionHeldExecEvent
        var evidence: CsgCoreProductionHeldExecStepEvidence
        evidence.collected = true
        if step >= 4:
            evidence.admissionReceiptClosed = true
        if step >= 5:
            evidence.heldDescriptorExecutionObserved = true
            evidence.executionReleaseObserved = true
        if step == 7:
            evidence.outputPublicationObserved = true
        if !CsgCoreProductionHeldExecEventIssuerIssueNextInto(
               issuer, evidence, event, err):
            return false
        if event.sequence != step ||
           event.previousEventCid != lastCid ||
           event.eventCid !=
               held_exec_provider.CsgCoreProductionHeldExecProviderEventCid(
                   event) ||
           event.eventCid == lastCid:
            err = strings.CloneStr(
                CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
            return false
        lastCid = strings.CloneStr(event.eventCid)
        if step == 1:
            receipt.activated = event
        elif step == 2:
            receipt.launcherHeld = event
        elif step == 3:
            receipt.binaryHeld = event
        elif step == 4:
            receipt.zeroReadAdmitted = event
        elif step == 5:
            receipt.heldExecStarted = event
        elif step == 6:
            receipt.childObserved = event
        else:
            receipt.consumed = event
    if !CsgCoreProductionHeldExecEventIssuerComplete(issuer):
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false

    # Negative: an eighth event is refused once the chain is complete.
    var doneEvidence: CsgCoreProductionHeldExecStepEvidence
    doneEvidence.collected = true
    doneEvidence.admissionReceiptClosed = true
    doneEvidence.heldDescriptorExecutionObserved = true
    doneEvidence.executionReleaseObserved = true
    doneEvidence.outputPublicationObserved = true
    var eventDone: held_exec_provider.CsgCoreProductionHeldExecEvent
    if CsgCoreProductionHeldExecEventIssuerIssueNextInto(
           issuer, doneEvidence, eventDone, err) ||
       err != CsgCoreProductionHeldExecEventIssuerErrComplete:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false

    # Gold check: the issued chain passes the frozen consumer unchanged.
    receipt.eventStreamCid =
        held_exec_provider.CsgCoreProductionHeldExecProviderEventStreamCid(
            receipt)
    receipt.complete = true
    receipt.singleConsumptionProven = true
    receipt.receiptCid =
        held_exec_provider.CsgCoreProductionHeldExecProviderReceiptCid(
            receipt)
    if !held_exec_provider.CsgCoreProductionHeldExecProviderReceiptStrictValidateInto(
           receipt, err):
        return false

    # Negative: a corrupted chain link is rejected by the frozen consumer.
    receipt.binaryHeld.previousEventCid =
        strings.CloneStr(csgHeldExecEventIssuerSelfCheckCidNonce)
    if held_exec_provider.CsgCoreProductionHeldExecProviderReceiptStrictValidateInto(
           receipt, err) ||
       err != held_exec_provider.CsgCoreProductionHeldExecErrEventChain:
        err = strings.CloneStr(
            CsgCoreProductionHeldExecEventIssuerErrSelfCheck)
        return false
    err = ""
    return true
