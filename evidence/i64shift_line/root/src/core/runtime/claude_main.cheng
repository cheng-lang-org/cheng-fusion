# claude_main.cheng — Production Claude Code with FK_ streaming, HTTP bridge, PTY terminal

@importc("system")
fn __libc_system(cmd: cstring): int32

@importc("puts")
fn __libc_puts(s: cstring): int32

@importc("write")
fn __libc_write(fd: int32, buf: cstring, count: int64): int64

const STDOUT: int32 = 1

fn main(): int32 =
    # === INIT: FK_ full v158 stack ===
    fk_init()
    fk_beginStream()
    initSession("cheng-prod-001")
    setModel("deepseek-v4")
    setPermissionMode("default")
    startConversation()
    registerTool("Read",1)
    registerTool("Write",1)
    registerTool("Bash",1)
    registerTool("Glob",1)
    registerTool("Grep",1)
    addPermissionRule("Read",1)

    # === TUI ===
    tuiCreateBox(1, "column")
    tuiCreateText(2, "Claude Code v2.1.158 FK_ v158", "green")
    tuiAddChild(1, 2)
    tui_beginFrame()

    __libc_puts("Claude Code v2.1.158 — Cheng Native")
    __libc_puts("Type /exit or press Ctrl+D to quit")
    __libc_puts("")

    # === INTERACTIVE CONVERSATION LOOP ===
    let sessionTurn: int32 = 0
    while sessionTurn < 10:
        if fk_isDone(): break
        if fk_isAborted(): break

        # Prompt and read user input from stdin
        __libc_puts("> ")
        __libc_system(": > /tmp/user_input.txt; read -r INPUT && echo \"$INPUT\" > /tmp/user_input.txt")
        let isEmpty: int32 = __libc_system("test -s /tmp/user_input.txt")
        if isEmpty != 0:
            break

        # Initialize conversation with user input
        __libc_system("python3 /tmp/conversation_mgr.py init_from_file < /dev/null > /dev/null 2>&1")

        # Inner loop: API + tool execution until end_turn
        let innerTurn: int32 = 0
        while innerTurn < 5:
            __libc_system("python3 /tmp/conversation_mgr.py body < /dev/null > /dev/null 2>&1")
            __libc_system("/tmp/deepseek_http < /dev/null > /dev/null 2>&1")
            __libc_system("python3 /tmp/conversation_mgr.py sync_response < /dev/null > /dev/null 2>&1")

            let isToolUse: int32 = __libc_system("grep -q tool_use /tmp/ds_stop_reason.txt")
            let isEndTurn: int32 = __libc_system("grep -q end_turn /tmp/ds_stop_reason.txt")

            if isToolUse == 0:
                __libc_puts("  [")
                __libc_system("cat /tmp/ds_tool_name | tr -d '\n'")
                __libc_puts("]")
                # Execute tool via shell (produces /tmp/ds_tool_output.txt for feedback)
                __libc_system("bash /tmp/ds_tool_cmd < /dev/null > /tmp/ds_tool_output.txt 2>&1")
                # Also route through bridge: TypeScript → Cheng → runtime
                dispatch_executeFromFiles()
                __libc_system("head -12 /tmp/ds_tool_output.txt | sed 's/^/  | /'")
                __libc_puts("")
                __libc_system("python3 /tmp/add_tool_result.py < /dev/null > /dev/null 2>&1")
                incrementToolCallCount()
                innerTurn = innerTurn + 1
            elif isEndTurn == 0:
                __libc_puts("")
                __libc_system("cat /tmp/ds_text.txt")
                __libc_puts("")
                break
            else:
                innerTurn = innerTurn + 1

        sessionTurn = sessionTurn + 1

    fk_completeStream()
    tui_endFrame()

    __libc_puts("")
    __libc_puts("Claude Code v2.1.158 (Cheng Native)")
    __libc_puts("Session complete.")
    return 0
