# host_pool_provider — fork/pipe/waitpid host primitives at the provider boundary.
#
# Raw C bridges live here (provider tier). Kernel callers use the
# host_pool_runtime value wrappers; no ptr/& surface crosses that boundary.
# Fixed scalar outputs are materialized through managed rawbytes.Bytes buffers
# and returned as address-free result structs.
import std/rawbytes
import std/rawmem_support

@abi_internal
@importc("cheng_host_pipe_runtime")
fn hostPoolProviderPipePhysical(fds: cstring): int32
@abi_internal
@importc("cheng_host_fork_runtime")
fn hostPoolProviderForkPhysical(): int32
@abi_internal
@importc("cheng_host_waitpid_runtime")
fn hostPoolProviderWaitpidPhysical(pid: int32, status: cstring, options: int32): int32
@abi_internal
@importc("cheng_host_read_runtime")
fn hostPoolProviderReadPhysical(fd: int32, buf: cstring, count: int32): int64
@abi_internal
@importc("cheng_host_write_runtime")
fn hostPoolProviderWritePhysical(fd: int32, buf: cstring, count: int32): int64
@abi_internal
@importc("cheng_host_close")
fn hostPoolProviderClosePhysical(fd: int32): int32
@abi_internal
@importc("cheng_host_process_signal_bridge")
fn hostPoolProviderSignalPhysical(pid: int64, signalCode: int32): int32
@abi_internal
@importc("cheng_host_exit_immediate_runtime")
fn hostPoolProviderExitImmediatePhysical(code: int32)

type
    HostPoolProviderPipeResult =
        rc: int32
        fd0: int32
        fd1: int32

    HostPoolProviderWaitResult =
        rc: int32
        status: int32

fn hostPoolProviderReadI32Le(bytes: rawbytes.Bytes, offset: int32): int32 =
    var value: int32
    for k in 0..<4:
        value = value | (rawbytes.BytesGet(bytes, offset + k) << (k * 8))
    return value

fn HostPoolProviderPipe(): HostPoolProviderPipeResult =
    var out: HostPoolProviderPipeResult
    out.rc = -1
    out.fd0 = -1
    out.fd1 = -1
    var scratch = rawbytes.BytesAlloc(8)
    if rawbytes.BytesLen(scratch) != 8:
        rawbytes.BytesFree(scratch)
        return out
    out.rc = hostPoolProviderPipePhysical(rawbytes.BytesDataPtr(scratch))
    if out.rc == 0:
        out.fd0 = hostPoolProviderReadI32Le(scratch, 0)
        out.fd1 = hostPoolProviderReadI32Le(scratch, 4)
        if out.fd0 < 0 || out.fd1 < 0 || out.fd0 == out.fd1:
            panic("host pool pipe returned invalid descriptors")
    rawbytes.BytesFree(scratch)
    return out

fn HostPoolProviderFork(): int32 =
    return hostPoolProviderForkPhysical()

fn HostPoolProviderWaitpid(
        pid: int32,
        options: int32): HostPoolProviderWaitResult =
    var out: HostPoolProviderWaitResult
    out.rc = -1
    out.status = 0
    var scratch = rawbytes.BytesAlloc(4)
    if rawbytes.BytesLen(scratch) != 4:
        rawbytes.BytesFree(scratch)
        return out
    out.rc = hostPoolProviderWaitpidPhysical(
        pid, rawbytes.BytesDataPtr(scratch), options)
    out.status = hostPoolProviderReadI32Le(scratch, 0)
    rawbytes.BytesFree(scratch)
    return out

fn HostPoolProviderReadBytes(
        fd: int32,
        bytes: var rawbytes.Bytes,
        offset: int32,
        count: int32): int64 =
    let byteLen = rawbytes.BytesLen(bytes)
    if byteLen < 0 || offset < 0 || count < 0 ||
       offset > byteLen || count > byteLen - offset ||
       (byteLen == 0 || rawbytes.BytesDataPtr(bytes) == nil):
        panic("host pool read bytes range invalid")
    if count == 0:
        return hostPoolProviderReadPhysical(
            fd, rawbytes.BytesDataPtr(bytes), 0)
    let readCount = hostPoolProviderReadPhysical(
        fd,
        RawmemPtrAdd(rawbytes.BytesDataPtr(bytes), offset),
        count)
    if readCount > int64(count):
        panic("host pool read exceeded requested byte count")
    return readCount

fn HostPoolProviderWriteBytes(
        fd: int32,
        bytes: var rawbytes.Bytes,
        offset: int32,
        count: int32): int64 =
    let byteLen = rawbytes.BytesLen(bytes)
    if byteLen < 0 || offset < 0 || count < 0 ||
       offset > byteLen || count > byteLen - offset ||
       (byteLen == 0 || rawbytes.BytesDataPtr(bytes) == nil):
        panic("host pool write bytes range invalid")
    if count == 0:
        return hostPoolProviderWritePhysical(
            fd, rawbytes.BytesDataPtr(bytes), 0)
    let writeCount = hostPoolProviderWritePhysical(
        fd,
        RawmemPtrAdd(rawbytes.BytesDataPtr(bytes), offset),
        count)
    if writeCount > int64(count):
        panic("host pool write exceeded requested byte count")
    return writeCount

fn HostPoolProviderClose(fd: int32): int32 =
    return hostPoolProviderClosePhysical(fd)

fn HostPoolProviderSignal(pid: int64, signalCode: int32): int32 =
    return hostPoolProviderSignalPhysical(pid, signalCode)

fn HostPoolProviderExitImmediate(code: int32) =
    hostPoolProviderExitImmediatePhysical(code)
