# web_permissions_runtime.cheng
# Permissions API for Cheng Web runtime.
# Provides: WebPermissionStatus type and WebPermissionsQuery function

type
    WebPermissionStatus =
        name: str
        state: str     # "granted"/"denied"/"prompt"

fn WebPermissionsQuery(name: str, out: var WebPermissionStatus): bool =
    out.name = name
    if name == "notifications":
        out.state = "granted"
        return true
    if name == "clipboard-read" || name == "clipboard-write":
        out.state = "granted"
        return true
    if name == "geolocation":
        out.state = "prompt"
        return true
    if name == "camera" || name == "microphone":
        out.state = "denied"
        return true
    out.state = "prompt"
    return true
