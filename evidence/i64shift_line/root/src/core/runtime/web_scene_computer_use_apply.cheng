import std/strings
import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_scene_computer_use as cu
import cheng/core/runtime/csg_action_authority as auth

# 准入唯一权威: csg_action_authority.CsgActionAuthorityAdmit。调用方只提名
# 动作与参数; effectClass 词表、确认要求与确认凭证 (绑定动作+参数+版本+世代,
# 一次性消费) 全部由注册合同表裁决, 无调用方布尔通道。
fn WebSceneApplyComputerUseTypedAction(
        graph: var scene.WebSceneGraph,
        actionKind: str,
        effectClass: str,
        effect: str,
        stateRef: str,
        payload: str,
        err: var str): bool =
    if !auth.CsgActionAuthorityAdmit(actionKind, effectClass, payload, err):
        return false
    if actionKind == "SetText" || actionKind == "SetNumber" ||
       actionKind == "Select" || actionKind == "SelectFile":
        if !scene.WebSceneSetStateValue(graph, stateRef, payload):
            err = strings.CloneStr(cu.WebSceneComputerUseErrApply)
            return false
        err = ""
        return true
    if actionKind == "Toggle":
        let toggleEffect = strings.CloneStr(effect)
        if !scene.WebSceneApplyEventEffect(graph, toggleEffect, true):
            err = strings.CloneStr(cu.WebSceneComputerUseErrApply)
            return false
        err = ""
        return true
    let clickEffect = strings.CloneStr(effect)
    if !scene.WebSceneApplyEventEffect(graph, clickEffect, true):
        err = strings.CloneStr(cu.WebSceneComputerUseErrApply)
        return false
    err = ""
    return true
