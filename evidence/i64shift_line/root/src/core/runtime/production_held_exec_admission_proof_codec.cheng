import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/merkle_store_codec

const
    ProductionHeldExecAdmissionProofVersion: int32 = 2
    ProductionHeldExecAdmissionProofHeaderBytes: int32 = 24
    ProductionHeldExecAdmissionProofCidBytes: int32 = 71
    ProductionHeldExecAdmissionProofFixedBytes: int32 = 521
    ProductionHeldExecAdmissionProofMaxActivationBytes: int32 = 16777216
    ProductionHeldExecAdmissionProofDomain: str =
        "csg_core.production.admitted_input.recovery_proof.v2"

type
    ProductionHeldExecAdmissionProof =
        generation: uint64
        admittedInputCid: str
        heldBundleCid: str
        leaseCid: str
        rootOwnerBindingCid: str
        claimReceiptCid: str
        ownerClaimReceiptCid: str
        activationBundleBytes: str
        receiptCid: str

@borrows
fn productionHeldExecAdmissionAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn productionHeldExecAdmissionAppendU64(
        out: var layout.ByteBuf,
        value: uint64) =
    var remaining = value
    for byteIndex in 0..<8:
        layout.ByteBufAppendByte(out, int32(remaining & uint64(255)))
        remaining = remaining >> uint64(8)

@borrows
fn productionHeldExecAdmissionReadU32(
        bytes: str,
        offset: int32): int32 =
    if offset < 0 || offset > bytes.len - 4:
        return -1
    return int32(bytes[offset]) |
        (int32(bytes[offset + 1]) << 8) |
        (int32(bytes[offset + 2]) << 16) |
        (int32(bytes[offset + 3]) << 24)

@borrows
fn productionHeldExecAdmissionReadU64(
        bytes: str,
        offset: int32,
        out: var uint64): bool =
    out = uint64(0)
    if offset < 0 || offset > bytes.len - 8:
        return false
    for byteIndex in 0..<8:
        out = out |
            (uint64(bytes[offset + byteIndex]) << uint64(byteIndex * 8))
    return true

@borrows
fn productionHeldExecAdmissionAppendCanonicalCid(
        out: var layout.ByteBuf,
        value: str) =
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(out, value[byteIndex])

@borrows
fn ProductionHeldExecAdmissionProofEncode(
        value: ProductionHeldExecAdmissionProof): str =
    if value.generation == uint64(0) ||
       value.activationBundleBytes.len <= 0 ||
       value.activationBundleBytes.len >
           ProductionHeldExecAdmissionProofMaxActivationBytes ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.admittedInputCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.heldBundleCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(value.leaseCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.rootOwnerBindingCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.claimReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           value.ownerClaimReceiptCid):
        return ""
    let unsignedBytes =
        ProductionHeldExecAdmissionProofHeaderBytes +
        ProductionHeldExecAdmissionProofCidBytes * 6 +
        value.activationBundleBytes.len
    var out = layout.ByteBufInit(
        unsignedBytes + ProductionHeldExecAdmissionProofCidBytes)
    layout.ByteBufAppendByte(out, 67)
    layout.ByteBufAppendByte(out, 65)
    layout.ByteBufAppendByte(out, 80)
    layout.ByteBufAppendByte(out, 82)
    productionHeldExecAdmissionAppendU32(
        out, ProductionHeldExecAdmissionProofVersion)
    productionHeldExecAdmissionAppendU64(out, value.generation)
    productionHeldExecAdmissionAppendU32(
        out, value.activationBundleBytes.len)
    productionHeldExecAdmissionAppendU32(out, 0)
    productionHeldExecAdmissionAppendCanonicalCid(
        out, value.admittedInputCid)
    productionHeldExecAdmissionAppendCanonicalCid(
        out, value.heldBundleCid)
    productionHeldExecAdmissionAppendCanonicalCid(out, value.leaseCid)
    productionHeldExecAdmissionAppendCanonicalCid(
        out, value.rootOwnerBindingCid)
    productionHeldExecAdmissionAppendCanonicalCid(
        out, value.claimReceiptCid)
    productionHeldExecAdmissionAppendCanonicalCid(
        out, value.ownerClaimReceiptCid)
    for byteIndex in 0..<value.activationBundleBytes.len:
        layout.ByteBufAppendByte(
            out, value.activationBundleBytes[byteIndex])
    var unsigned = layout.ByteBufToBytes(out)
    let receiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            ProductionHeldExecAdmissionProofDomain,
            unsigned)
    rawbytes.BytesFree(unsigned)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(receiptCid):
        layout.ByteBufFree(out)
        return ""
    productionHeldExecAdmissionAppendCanonicalCid(out, receiptCid)
    var canonicalBytes = layout.ByteBufToBytes(out)
    layout.ByteBufFree(out)
    let canonical = rawbytes.BytesToString(canonicalBytes)
    rawbytes.BytesFree(canonicalBytes)
    return canonical

@borrows
fn ProductionHeldExecAdmissionProofDecodeStrictInto(
        canonical: str,
        out: var ProductionHeldExecAdmissionProof): bool =
    out = ProductionHeldExecAdmissionProof()
    if canonical.len <= ProductionHeldExecAdmissionProofFixedBytes ||
       canonical.len >
           ProductionHeldExecAdmissionProofFixedBytes +
           ProductionHeldExecAdmissionProofMaxActivationBytes ||
       canonical[0] != 67 || canonical[1] != 65 ||
       canonical[2] != 80 || canonical[3] != 82 ||
       productionHeldExecAdmissionReadU32(canonical, 4) !=
           ProductionHeldExecAdmissionProofVersion ||
       productionHeldExecAdmissionReadU32(canonical, 20) != 0:
        return false
    var generation: uint64
    if !productionHeldExecAdmissionReadU64(canonical, 8, generation):
        return false
    out.generation = generation
    let activationBytes =
        productionHeldExecAdmissionReadU32(canonical, 16)
    if out.generation == uint64(0) || activationBytes <= 0 ||
       activationBytes > ProductionHeldExecAdmissionProofMaxActivationBytes ||
       canonical.len !=
           ProductionHeldExecAdmissionProofFixedBytes + activationBytes:
        return false
    out.admittedInputCid = strings.CloneStr(strings.SliceBytes(
        canonical, 24, ProductionHeldExecAdmissionProofCidBytes))
    out.heldBundleCid = strings.CloneStr(strings.SliceBytes(
        canonical, 95, ProductionHeldExecAdmissionProofCidBytes))
    out.leaseCid = strings.CloneStr(strings.SliceBytes(
        canonical, 166, ProductionHeldExecAdmissionProofCidBytes))
    out.rootOwnerBindingCid = strings.CloneStr(strings.SliceBytes(
        canonical, 237, ProductionHeldExecAdmissionProofCidBytes))
    out.claimReceiptCid = strings.CloneStr(strings.SliceBytes(
        canonical, 308, ProductionHeldExecAdmissionProofCidBytes))
    out.ownerClaimReceiptCid = strings.CloneStr(strings.SliceBytes(
        canonical, 379, ProductionHeldExecAdmissionProofCidBytes))
    out.activationBundleBytes = strings.CloneStr(strings.SliceBytes(
        canonical, 450, activationBytes))
    out.receiptCid = strings.CloneStr(strings.SliceBytes(
        canonical,
        450 + activationBytes,
        ProductionHeldExecAdmissionProofCidBytes))
    let unsignedCanonical = strings.CloneStr(strings.SliceBytes(
        canonical, 0, 450 + activationBytes))
    var unsigned = rawbytes.BytesFromString(unsignedCanonical)
    let receiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            ProductionHeldExecAdmissionProofDomain,
            unsigned)
    if receiptCid != out.receiptCid ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.admittedInputCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(out.heldBundleCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(out.leaseCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.rootOwnerBindingCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.claimReceiptCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           out.ownerClaimReceiptCid) ||
       out.claimReceiptCid == out.ownerClaimReceiptCid:
        out = ProductionHeldExecAdmissionProof()
        return false
    return ProductionHeldExecAdmissionProofEncode(out) == canonical
