var
    cheng_link_saved_argc: int32
    cheng_link_saved_argv: ptr

fn cheng_link_ptr_plus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(int64(uint64(base)) + int64(off)))

fn cheng_link_param_raw(i: int32): ptr =
    if i < 0 || i >= cheng_link_saved_argc || cheng_link_saved_argv == nil:
        return nil
    let slot = VoidPtrPtr(cheng_link_ptr_plus(cheng_link_saved_argv, i * int32(sizeof(ptr))))
    return *slot

fn cheng_link_cstrlen(raw: ptr): int32 =
    if raw == nil:
        return 0
    var n: int32
    while *(UInt8Ptr(cheng_link_ptr_plus(raw, n))) != uint8(0):
        n = n + 1
    return n

fn cheng_link_flag_code_key_len(code: int32): int32 =
    if code == 1: return 6
    if code == 2: return 5
    if code == 3: return 4
    if code == 4: return 12
    if code == 5: return 8
    if code == 6: return 14
    if code == 7: return 23
    return 0

fn cheng_link_flag_code_default(code: int32): ptr =
    if code == 1:
        return "."
    if code == 5:
        return "arm64-apple-darwin"
    return ""

fn cheng_link_flag_code_key_byte(code: int32, idx: int32): uint8 =
    if idx == 0 || idx == 1:
        return uint8(45)
    if code == 1:
        if idx == 2: return uint8(114)
        if idx == 3: return uint8(111)
        if idx == 4: return uint8(111)
        if idx == 5: return uint8(116)
    if code == 2:
        if idx == 2: return uint8(111)
        if idx == 3: return uint8(117)
        if idx == 4: return uint8(116)
    if code == 3:
        if idx == 2: return uint8(105)
        if idx == 3: return uint8(110)
    if code == 4:
        if idx == 2: return uint8(114)
        if idx == 3: return uint8(101)
        if idx == 4: return uint8(112)
        if idx == 5: return uint8(111)
        if idx == 6: return uint8(114)
        if idx == 7: return uint8(116)
        if idx == 8: return uint8(45)
        if idx == 9: return uint8(111)
        if idx == 10: return uint8(117)
        if idx == 11: return uint8(116)
    if code == 5:
        if idx == 2: return uint8(116)
        if idx == 3: return uint8(97)
        if idx == 4: return uint8(114)
        if idx == 5: return uint8(103)
        if idx == 6: return uint8(101)
        if idx == 7: return uint8(116)
    if code == 6:
        if idx == 2: return uint8(101)
        if idx == 3: return uint8(120)
        if idx == 4: return uint8(112)
        if idx == 5: return uint8(111)
        if idx == 6: return uint8(114)
        if idx == 7: return uint8(116)
        if idx == 8: return uint8(45)
        if idx == 9: return uint8(114)
        if idx == 10: return uint8(111)
        if idx == 11: return uint8(111)
        if idx == 12: return uint8(116)
        if idx == 13: return uint8(115)
    if code == 7:
        if idx == 2: return uint8(98)
        if idx == 3: return uint8(114)
        if idx == 4: return uint8(111)
        if idx == 5: return uint8(119)
        if idx == 6: return uint8(115)
        if idx == 7: return uint8(101)
        if idx == 8: return uint8(114)
        if idx == 9: return uint8(45)
        if idx == 10: return uint8(98)
        if idx == 11: return uint8(114)
        if idx == 12: return uint8(105)
        if idx == 13: return uint8(100)
        if idx == 14: return uint8(103)
        if idx == 15: return uint8(101)
        if idx == 16: return uint8(45)
        if idx == 17: return uint8(111)
        if idx == 18: return uint8(98)
        if idx == 19: return uint8(106)
        if idx == 20: return uint8(101)
        if idx == 21: return uint8(99)
        if idx == 22: return uint8(116)
    return uint8(0)

fn cheng_link_flag_code_matches(argRaw: ptr, code: int32, keyLen: int32): bool =
    if argRaw == nil || keyLen <= 0:
        return false
    for i in 0..<keyLen:
        if *(UInt8Ptr(cheng_link_ptr_plus(argRaw, i))) != cheng_link_flag_code_key_byte(code, i):
            return false
    return true

@exportc("__cheng_setCmdLine")
fn __cheng_setCmdLine_export(argc: int32, argv: ptr) =
    cheng_link_saved_argc = argc
    cheng_link_saved_argv = argv

@exportc("__cheng_rt_paramCount")
fn __cheng_rt_paramCount_export(): int32 =
    return cheng_link_saved_argc

@exportc("__cheng_rt_paramStr")
fn __cheng_rt_paramStr_export(i: int32): ptr =
    let raw = cheng_link_param_raw(i)
    if raw == nil:
        return nil
    return raw

@exportc("driver_c_read_flag_code_raw_ptr_bridge")
fn driver_c_read_flag_code_raw_ptr_bridge_export(code: int32): ptr =
    let keyLen = cheng_link_flag_code_key_len(code)
    for i in 1..<cheng_link_saved_argc:
        let argRaw = cheng_link_param_raw(i)
        let argLen = cheng_link_cstrlen(argRaw)
        if argLen > keyLen && cheng_link_flag_code_matches(argRaw, code, keyLen):
            let sep = *(UInt8Ptr(cheng_link_ptr_plus(argRaw, keyLen)))
            if int32(sep) == 58 || int32(sep) == 61:
                return cheng_link_ptr_plus(argRaw, keyLen + 1)
        if argLen == keyLen && cheng_link_flag_code_matches(argRaw, code, keyLen):
            if i + 1 < cheng_link_saved_argc:
                return cheng_link_param_raw(i + 1)
    return cheng_link_flag_code_default(code)

@exportc("driver_c_read_flag_code_raw_len_bridge")
fn driver_c_read_flag_code_raw_len_bridge_export(code: int32): int32 =
    let keyLen = cheng_link_flag_code_key_len(code)
    for i in 1..<cheng_link_saved_argc:
        let argRaw = cheng_link_param_raw(i)
        let argLen = cheng_link_cstrlen(argRaw)
        if argLen > keyLen && cheng_link_flag_code_matches(argRaw, code, keyLen):
            let sep = *(UInt8Ptr(cheng_link_ptr_plus(argRaw, keyLen)))
            if int32(sep) == 58 || int32(sep) == 61:
                return argLen - keyLen - 1
        if argLen == keyLen && cheng_link_flag_code_matches(argRaw, code, keyLen):
            if i + 1 < cheng_link_saved_argc:
                return cheng_link_cstrlen(cheng_link_param_raw(i + 1))
    return cheng_link_cstrlen(cheng_link_flag_code_default(code))
