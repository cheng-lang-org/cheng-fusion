// Darwin TUN/utun provider — pure Cheng implementation
// Opens a macOS utun device via AF_SYSTEM socket + kernel control

import std/rawbytes
import std/rawmem_support

// Darwin constants
const
    AF_SYSTEM = 32
    SOCK_DGRAM = 2
    SYSPROTO_CONTROL = 2
    AF_SYS_CONTROL = 2
    UTUN_OPT_IFNAME = 2
    F_GETFL = 3
    F_SETFL = 4
    O_NONBLOCK = 4
    CTLIOCGINFO = 0xC0644E03
    UTUN_CONTROL_NAME = "com.apple.net.utun_control"

// sockaddr_ctl struct layout: 1+1+2+4+4+20 = 32 bytes
const
    sockaddrCtlSize = 32

// ctl_info struct layout: 4+96 = 100 bytes
const
    ctlInfoSize = 100

// Raw POSIX syscalls
@importc("socket")
fn raw_socket(domain: int32, typ: int32, protocol: int32): int32

@importc("ioctl")
fn raw_ioctl(fd: int32, request: uint64, arg: ptr): int32

@importc("connect")
fn raw_connect(fd: int32, addr: ptr, addrLen: int32): int32

@importc("getsockopt")
fn raw_getsockopt(fd: int32, level: int32, optname: int32,
                  val: ptr, valLen: var int32): int32

@importc("close")
fn raw_close(fd: int32): int32

@importc("fcntl")
fn raw_fcntl(fd: int32, cmd: int32, arg: int32): int32

@exportc("cheng_tun_open_utun")
fn chengTunOpenUtun(): int32 =
    let fd: int32 = raw_socket(AF_SYSTEM, SOCK_DGRAM, SYSPROTO_CONTROL)
    if fd < 0: return -1

    // Build ctl_info struct: ctl_id(4 bytes, zeroed) + ctl_name(96 bytes)
    var ci: rawbytes.Bytes = rawbytes.BytesAlloc(ctlInfoSize)
    rawbytes.BytesSet(ci, 0)  // zero ctl_id
    var ciNameOff: int32 = 4
    var i: int32
    while i < len(UTUN_CONTROL_NAME):
        rawbytes.BytesSetAt(ci, ciNameOff + i, uint8(UTUN_CONTROL_NAME[i]))
        i = i + 1

    let ciPtr: ptr = rawbytes.BytesDataPtr(ci)
    let ioctlRet: int32 = raw_ioctl(fd, uint64(CTLIOCGINFO), ciPtr)
    if ioctlRet < 0:
        let _ = raw_close(fd)
        return -1

    // Extract ctl_id from ctl_info
    let ctlId: uint32 = rawbytes.BytesLoadU32BE(ci, 0)

    // Build sockaddr_ctl struct
    var addr: rawbytes.Bytes = rawbytes.BytesAlloc(sockaddrCtlSize)
    rawbytes.BytesSetAt(addr, 0, uint8(sockaddrCtlSize))     // sc_len
    rawbytes.BytesSetAt(addr, 1, uint8(AF_SYSTEM))            // sc_family
    rawbytes.BytesStoreU16BE(addr, 2, uint16(AF_SYS_CONTROL)) // ss_sysaddr
    rawbytes.BytesStoreU32BE(addr, 4, ctlId)                  // sc_id
    rawbytes.BytesStoreU32BE(addr, 8, uint32(0))              // sc_unit = 0 (auto)

    let addrPtr: ptr = rawbytes.BytesDataPtr(addr)
    let connRet: int32 = raw_connect(fd, addrPtr, sockaddrCtlSize)
    if connRet < 0:
        let _ = raw_close(fd)
        return -1

    // Set non-blocking for event-loop I/O
    let flagsRet: int32 = raw_fcntl(fd, F_GETFL, 0)
    if flagsRet >= 0:
        let _ = raw_fcntl(fd, F_SETFL, flagsRet | O_NONBLOCK)

    return fd
