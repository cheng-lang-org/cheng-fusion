import std/result
import std/strings
import cheng/core/runtime/cdp_client as cdp

const
    BrowserProviderBitBrowser: str = "bitbrowser"
    BitBrowserDefaultLocalApiPort: int32 = 54345

type
    BrowserSession =
        provider: str
        profileId: str
        wsUrl: str
        httpDebugAddress: str
        driverPath: str
        coreVersion: str
        debugPort: int32
        status: str

    BrowserFieldRead =
        found: bool
        value: str

fn browserProviderFieldMissing(): BrowserFieldRead =
    var out: BrowserFieldRead
    return out

@borrows
fn browserProviderFieldFound(value: str): BrowserFieldRead =
    var out: BrowserFieldRead
    out.found = true
    out.value = strings.CloneStr(value)
    return out

fn browserProviderIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn browserProviderSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && browserProviderIsWs(text[i]):
        i = i + 1
    return i

@borrows
fn browserProviderSkipString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i: int32 = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            i = i + 2
        elif text[i] == '"':
            return i + 1
        else:
            i = i + 1
    return -1

@borrows
fn browserProviderStringHasEscape(text: str, quotePos: int32, afterQuote: int32): bool =
    var i: int32 = quotePos + 1
    let stop: int32 = afterQuote - 1
    while i < stop:
        if text[i] == '\\':
            return true
        i = i + 1
    return false

@borrows
fn browserProviderKeyMatches(text: str, quotePos: int32, afterQuote: int32, key: str): bool =
    if browserProviderStringHasEscape(text, quotePos, afterQuote):
        return false
    let size: int32 = afterQuote - quotePos - 2
    if size != key.len:
        return false
    var i: int32
    while i < size:
        if text[quotePos + 1 + i] != key[i]:
            return false
        i = i + 1
    return true

@borrows
fn browserProviderSkipValue(text: str, start: int32): int32 =
    var i: int32 = browserProviderSkipWs(text, start)
    if i >= text.len:
        return i
    if text[i] == '"':
        let stringEnd = browserProviderSkipString(text, i)
        if stringEnd < 0:
            return text.len
        return stringEnd
    if text[i] != '{' && text[i] != '[':
        while i < text.len && text[i] != ',' && text[i] != '}' && text[i] != ']':
            i = i + 1
        return i
    var depth: int32
    while i < text.len:
        if text[i] == '"':
            let stringEnd = browserProviderSkipString(text, i)
            if stringEnd < 0:
                return text.len
            i = stringEnd
        elif text[i] == '{' || text[i] == '[':
            depth = depth + 1
            i = i + 1
        elif text[i] == '}' || text[i] == ']':
            depth = depth - 1
            i = i + 1
            if depth <= 0:
                return i
        else:
            i = i + 1
    return i

fn browserProviderTopRawField(text: str, key: str): BrowserFieldRead =
    var i: int32 = browserProviderSkipWs(text, 0)
    if i >= text.len || text[i] != '{':
        return browserProviderFieldMissing()
    i = i + 1
    while i < text.len:
        i = browserProviderSkipWs(text, i)
        if i >= text.len || text[i] == '}':
            return browserProviderFieldMissing()
        if text[i] == ',':
            i = i + 1
            continue
        if text[i] != '"':
            return browserProviderFieldMissing()
        let keyEnd = browserProviderSkipString(text, i)
        if keyEnd < 0:
            return browserProviderFieldMissing()
        let matched = browserProviderKeyMatches(text, i, keyEnd, key)
        var valueStart: int32 = browserProviderSkipWs(text, keyEnd)
        if valueStart >= text.len || text[valueStart] != ':':
            return browserProviderFieldMissing()
        valueStart = browserProviderSkipWs(text, valueStart + 1)
        let valueEnd = browserProviderSkipValue(text, valueStart)
        if matched:
            if valueEnd <= valueStart:
                return browserProviderFieldMissing()
            return browserProviderFieldFound(strings.SliceBytes(text, valueStart, valueEnd - valueStart))
        i = valueEnd
    return browserProviderFieldMissing()

fn browserProviderTopPlainStringField(text: str, key: str): BrowserFieldRead =
    let raw = browserProviderTopRawField(text, key)
    if !raw.found:
        return browserProviderFieldMissing()
    if raw.value.len < 2:
        return browserProviderFieldMissing()
    if raw.value[0] != '"' || raw.value[raw.value.len - 1] != '"':
        return browserProviderFieldMissing()
    if browserProviderStringHasEscape(raw.value, 0, raw.value.len):
        return browserProviderFieldMissing()
    return browserProviderFieldFound(strings.SliceBytes(raw.value, 1, raw.value.len - 2))

@borrows
fn browserProviderRawIsTrue(raw: str): bool =
    let stripped = raw
    return stripped == "true"


fn browserProviderJsonQuote(text: str): str =
    var out: str
    out = strings.ConcatStr(out, "\"")
    var i: int32
    while i < text.len:
        if text[i] == '"':
            out = strings.ConcatStr(out, "\\\"")
        elif text[i] == '\\':
            out = strings.ConcatStr(out, "\\\\")
        elif text[i] == '\n':
            out = strings.ConcatStr(out, "\\n")
        elif text[i] == '\r':
            out = strings.ConcatStr(out, "\\r")
        elif text[i] == '\t':
            out = strings.ConcatStr(out, "\\t")
        else:
            out = strings.ConcatStr(out, strings.CharToStr(text[i]))
        i = i + 1
    out = strings.ConcatStr(out, "\"")
    return out


fn BitBrowserOpenRequestJson(profileId: str): Result[str] =
    if profileId.len <= 0:
        return Err[str]("bitbrowser: missing profile id")
    var body: str
    body = strings.ConcatStr("{\"id\":", browserProviderJsonQuote(profileId))
    body = strings.ConcatStr(body, "}")
    return Ok[str](body)

fn BrowserSessionReady(session: BrowserSession): bool =
    if session.provider.len <= 0:
        return false
    if session.profileId.len <= 0:
        return false
    if session.wsUrl.len <= 0:
        return false
    if session.httpDebugAddress.len <= 0:
        return false
    if session.debugPort <= 0:
        return false
    return true

fn BitBrowserSessionFromOpenResponse(profileId: str, responseJson: str): Result[BrowserSession] =
    if profileId.len <= 0:
        return Err[BrowserSession]("bitbrowser: missing profile id")
    let successRaw = browserProviderTopRawField(responseJson, "success")
    if !successRaw.found || !browserProviderRawIsTrue(successRaw.value):
        return Err[BrowserSession]("bitbrowser: open response success is not true")
    let dataRaw = browserProviderTopRawField(responseJson, "data")
    if !dataRaw.found:
        return Err[BrowserSession]("bitbrowser: open response missing data")
    let wsRead = browserProviderTopPlainStringField(dataRaw.value, "ws")
    if !wsRead.found || wsRead.value.len <= 0:
        return Err[BrowserSession]("bitbrowser: open response missing ws")
    let httpRead = browserProviderTopPlainStringField(dataRaw.value, "http")
    if !httpRead.found || httpRead.value.len <= 0:
        return Err[BrowserSession]("bitbrowser: open response missing http")

    var port: int32
    if !cdp.cdpWsUrlLocalPort(wsRead.value, port):
        return Err[BrowserSession]("bitbrowser: ws must be local CDP endpoint with port")

    var session: BrowserSession
    session.provider = BrowserProviderBitBrowser
    session.profileId = profileId
    session.wsUrl = wsRead.value
    session.httpDebugAddress = httpRead.value
    session.debugPort = port
    session.status = "open"

    let driverRead = browserProviderTopPlainStringField(dataRaw.value, "driver")
    if driverRead.found:
        session.driverPath = driverRead.value
    let coreVersionRead = browserProviderTopPlainStringField(dataRaw.value, "coreVersion")
    if coreVersionRead.found:
        session.coreVersion = coreVersionRead.value

    if !BrowserSessionReady(session):
        return Err[BrowserSession]("bitbrowser: parsed session is not ready")
    return Ok[BrowserSession](session)


fn BitBrowserOpenProfileOnPort(apiPort: int32, profileId: str): Result[BrowserSession] =
    if apiPort <= 0 || apiPort > 65535:
        return Err[BrowserSession]("bitbrowser: invalid local api port")
    let bodyRes = BitBrowserOpenRequestJson(profileId)
    if IsErr(bodyRes):
        return Err[BrowserSession](Error(bodyRes))
    let body = Value(bodyRes)
    let responseJson = cdp.cdpHttpPostJsonLocal(apiPort, "/browser/open", body)
    if responseJson.len <= 0:
        return Err[BrowserSession]("bitbrowser: empty open response")
    return BitBrowserSessionFromOpenResponse(profileId, responseJson)


fn BitBrowserOpenProfile(profileId: str): Result[BrowserSession] =
    return BitBrowserOpenProfileOnPort(BitBrowserDefaultLocalApiPort, profileId)
