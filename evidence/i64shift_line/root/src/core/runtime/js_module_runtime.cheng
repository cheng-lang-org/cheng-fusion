import cheng/core/runtime/js_runtime as jsrt

const
    JsModuleUnloaded = 0
    JsModuleLoading = 1
    JsModuleLoaded = 2

type
    JsModule =
        specifier: str
        status: int32
        exports: jsrt.JsObject
        dependencies: str[]
        chengFnId: int32

    JsGlobalBinding =
        name: str
        moduleId: int32
        exportName: str

var
    jsModuleTable: JsModule[]
    jsModuleCount: int32 = 0
    jsModuleLoadOrder: int32[]
    jsGlobalBindings: JsGlobalBinding[]

fn JsModuleRegistryInit() =
    jsModuleTable = []
    jsModuleCount = 0
    jsModuleLoadOrder = []
    jsGlobalBindings = []

fn JsModuleFindBySpecifier(specifier: str): int32 =
    for i in 0..<jsModuleCount:
        if jsModuleTable[i].specifier == specifier:
            return i
    return -1

fn JsModuleRegister(specifier: str): int32 =
    let existing = JsModuleFindBySpecifier(specifier)
    if existing >= 0:
        return existing
    var module: JsModule
    module.specifier = specifier
    module.status = JsModuleUnloaded
    jsrt.JsObjectInit(module.exports, 0, 0)
    module.dependencies = []
    add(jsModuleTable, module)
    let id = jsModuleCount
    jsModuleCount = jsModuleCount + 1
    return id

fn JsModuleAddDependency(moduleId: int32, depSpecifier: str): bool =
    if moduleId < 0 || moduleId >= jsModuleCount:
        return false
    add(jsModuleTable[moduleId].dependencies, depSpecifier)
    return true

fn JsModuleVisitDFS(moduleId: int32): bool =
    for i in 0..<jsModuleLoadOrder.len:
        if jsModuleLoadOrder[i] == moduleId:
            return true
    if jsModuleTable[moduleId].status == JsModuleLoading:
        panic("circular dependency in module graph")
        return false
    jsModuleTable[moduleId].status = JsModuleLoading
    var deps = jsModuleTable[moduleId].dependencies
    for i in 0..<deps.len:
        let depId = JsModuleFindBySpecifier(deps[i])
        if depId < 0:
            panic("unresolved module dependency")
            return false
        if !JsModuleVisitDFS(depId):
            return false
    jsModuleTable[moduleId].status = JsModuleUnloaded
    add(jsModuleLoadOrder, moduleId)
    return true

fn JsModuleResolveDependencies(entrySpecifiers: str[]): bool =
    jsModuleLoadOrder = []
    for i in 0..<entrySpecifiers.len:
        let moduleId = JsModuleFindBySpecifier(entrySpecifiers[i])
        if moduleId < 0:
            panic("entry module not found")
            return false
        if !JsModuleVisitDFS(moduleId):
            return false
    return true

fn JsModuleLoad(entrySpecifiers: str[]): bool =
    if jsModuleLoadOrder.len == 0:
        if !JsModuleResolveDependencies(entrySpecifiers):
            return false
    for i in 0..<jsModuleLoadOrder.len:
        let moduleId = jsModuleLoadOrder[i]
        jsModuleTable[moduleId].status = JsModuleLoading
        let chengFnId = jsModuleTable[moduleId].chengFnId
        if chengFnId > 0:
            var entryFn: jsrt.JsFunction
            jsrt.JsFunctionInit(entryFn, "")
            jsrt.JsFunctionSetBodyKind(entryFn, jsrt.JsBodyKindChengFn)
            jsrt.JsFunctionSetChengFn(entryFn, chengFnId)
            var args: jsrt.JsValue[]
            var argMod: jsrt.JsValue
            jsrt.JsValueInitInt32(argMod, moduleId)
            add(args, argMod)
            var argExp: jsrt.JsValue
            jsrt.JsValueInitInt32(argExp, jsModuleTable[moduleId].exports.objectId)
            add(args, argExp)
            var thisBinding: jsrt.JsValue
            jsrt.JsValueInitUndefined(thisBinding)
            var result: jsrt.JsValue
            jsrt.jsCallFunction(entryFn, thisBinding, args, result)
        jsModuleTable[moduleId].status = JsModuleLoaded
    return true

fn JsModuleGetExport(moduleId: int32, name: str, outValue: var jsrt.JsValue): bool =
    if moduleId < 0 || moduleId >= jsModuleCount:
        jsrt.JsValueInitUndefined(outValue)
        return false
    return jsrt.JsObjectGetOwnProperty(jsModuleTable[moduleId].exports, name, outValue)

fn JsModuleSetExport(moduleId: int32, name: str, value: var jsrt.JsValue): bool =
    if moduleId < 0 || moduleId >= jsModuleCount:
        return false
    var descriptor: jsrt.JsPropertyDescriptor
    jsrt.JsDescriptorInitData(descriptor, true, true, true)
    return jsrt.JsObjectDefineDataProperty(jsModuleTable[moduleId].exports, name, value, descriptor)

fn JsModuleSetEntryPoint(moduleId: int32, chengFnId: int32): bool =
    if moduleId < 0 || moduleId >= jsModuleCount:
        return false
    jsModuleTable[moduleId].chengFnId = chengFnId
    return true

// Bind a module export to a global name so it can be resolved by other modules
fn JsModuleBindGlobal(moduleId: int32, exportName: str, globalName: str): bool =
    if moduleId < 0 || moduleId >= jsModuleCount:
        return false
    // Check for duplicate binding
    for i in 0..<jsGlobalBindings.len:
        if jsGlobalBindings[i].name == globalName:
            panic("duplicate global binding")
            return false
    var binding: JsGlobalBinding
    binding.name = globalName
    binding.moduleId = moduleId
    binding.exportName = exportName
    add(jsGlobalBindings, binding)
    return true

// Resolve a global name to its module export value
fn JsModuleResolveGlobal(globalName: str, outValue: var jsrt.JsValue): bool =
    for i in 0..<jsGlobalBindings.len:
        if jsGlobalBindings[i].name == globalName:
            return JsModuleGetExport(jsGlobalBindings[i].moduleId, jsGlobalBindings[i].exportName, outValue)
    jsrt.JsValueInitUndefined(outValue)
    return false

// Bind all exports of a module to the global scope with their original names
fn JsModuleBindAllExports(moduleId: int32): bool =
    if moduleId < 0 || moduleId >= jsModuleCount:
        return false
    var modValue: jsrt.JsValue
    jsrt.JsValueInitObject(modValue, jsModuleTable[moduleId].exports.objectId)
    var keys: jsrt.JsArray
    if !jsrt.JsObjectKeys(modValue, keys):
        return false
    var keyCount: int32
    var valuesJsLen: int32
    valuesJsLen = keys.valuesJs.len
    keyCount = valuesJsLen
    for i in 0..<keyCount:
        if keys.valuesJs[i].kind == jsrt.JsKindString:
            if !JsModuleBindGlobal(moduleId, keys.valuesJs[i].stringValue, keys.valuesJs[i].stringValue):
                return false
    return true

// Check if a module is fully loaded
fn JsModuleIsLoaded(moduleId: int32): bool =
    if moduleId < 0 || moduleId >= jsModuleCount:
        return false
    return jsModuleTable[moduleId].status == JsModuleLoaded

// Get the load order (topological sort result)
fn JsModuleLoadOrderCount(): int32 =
    return jsModuleLoadOrder.len

fn JsModuleLoadOrderAt(index: int32): int32 =
    if index < 0 || index >= jsModuleLoadOrder.len:
        return -1
    return jsModuleLoadOrder[index]

fn JsModuleRuntimeInit() =
    JsModuleRegistryInit()