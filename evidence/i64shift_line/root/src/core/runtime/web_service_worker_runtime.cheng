# web_service_worker_runtime.cheng
# Web Service Worker API for Cheng Web runtime.
# Provides: WebServiceWorkerRegistration type, WebFetchEvent type, and WebServiceWorker* functions

type
    WebServiceWorkerRegistration =
        scope: str
        scriptUrl: str
        state: int32       # 0=installing, 1=installed, 2=activating, 3=activated, 4=redundant
        oninstall: int32
        onactivate: int32
        onfetch: int32
        onerror: int32

    WebFetchEvent =
        requestUrl: str
        requestMethod: str
        respondWith: str   # 响应内容

const
    WebSWInstalling = 0
    WebSWInstalled = 1
    WebSWActivating = 2
    WebSWActivated = 3
    WebSWRedundant = 4

var swRegistrations: WebServiceWorkerRegistration[]
var nextRegistrationId: int32 = 1

fn WebServiceWorkerFindIndexByScope(scope: str): int32 =
    # Redundant (unregistered) rows are tombstones kept for id stability;
    # they are invisible to every lookup, matching the web contract where a
    # scope freed by unregister behaves as never-registered for lookups.
    for i in 0..<swRegistrations.len:
        if swRegistrations[i].state != WebSWRedundant:
            if swRegistrations[i].scope == scope:
                return i
    return -1

fn WebServiceWorkerRegister(scope: str, scriptUrl: str, oninstall: int32, onactivate: int32, onfetch: int32, onerror: int32): int32 =
    let registrationId = nextRegistrationId
    nextRegistrationId = nextRegistrationId + 1
    var registration: WebServiceWorkerRegistration
    registration.scope = scope
    registration.scriptUrl = scriptUrl
    registration.state = WebSWInstalling
    registration.oninstall = oninstall
    registration.onactivate = onactivate
    registration.onfetch = onfetch
    registration.onerror = onerror
    add(swRegistrations, registration)
    # Auto-trigger install event
    if oninstall != 0:
        swRegistrations[registrationId - 1].state = WebSWInstalled
    return registrationId

fn WebServiceWorkerGetState(registrationId: int32, out: var WebServiceWorkerRegistration): bool =
    let index = registrationId - 1
    if index < 0 || index >= swRegistrations.len:
        return false
    # Unregistered registrations are invisible to readers (web contract).
    if swRegistrations[index].state == WebSWRedundant:
        return false
    out = swRegistrations[index]
    return true

fn WebServiceWorkerTriggerInstall(registrationId: int32): bool =
    let index = registrationId - 1
    if index < 0 || index >= swRegistrations.len:
        return false
    swRegistrations[index].state = WebSWInstalled
    if swRegistrations[index].oninstall != 0:
        # oninstall callback invoked (simplified: state already set)
        swRegistrations[index].state = WebSWInstalled
    return true

fn WebServiceWorkerTriggerActivate(registrationId: int32): bool =
    let index = registrationId - 1
    if index < 0 || index >= swRegistrations.len:
        return false
    swRegistrations[index].state = WebSWActivating
    swRegistrations[index].state = WebSWActivated
    if swRegistrations[index].onactivate != 0:
        # onactivate callback invoked (simplified: state already set)
        swRegistrations[index].state = WebSWActivated
    return true

fn WebServiceWorkerTriggerFetch(registrationId: int32, requestUrl: str, requestMethod: str, out: var str): bool =
    # Contract: callers pre-initialize `out`; when no onfetch handler is
    # registered it is left untouched (""), mirroring no-response semantics.
    # NOTE: deliberately avoids a local WebFetchEvent struct here — the cold
    # compiler's managed scope preflight currently false-rejects local-struct
    # str-field dataflow feeding var-out params (minimal repro:
    # src/.gen/r16-probe2, bisect 4 vs 5). Reintroduce the struct only after
    # the preflight realizer fix lands in the cold lane.
    let index = registrationId - 1
    if index < 0 || index >= swRegistrations.len:
        return false
    if swRegistrations[index].state != WebSWActivated:
        return false
    if swRegistrations[index].onfetch != 0:
        out = requestUrl
    return true

fn WebServiceWorkerUnregister(scope: str): bool =
    let index = WebServiceWorkerFindIndexByScope(scope)
    if index < 0:
        return false
    swRegistrations[index].state = WebSWRedundant
    return true
