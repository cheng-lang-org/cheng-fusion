@borrows
fn WebSceneFindPropValue(graph: var WebSceneGraph,
                         routeIndex: int32,
                         nodeId: int32,
                         propName: str,
                         outValue: var str): bool =
    for i in 0..<graph.props.len:
        if graph.props[i].routeIndex == routeIndex &&
           graph.props[i].nodeId == nodeId &&
           graph.props[i].propName == propName:
            outValue = graph.props[i].propValue
            return true
    return false

