    # CHT mechanism 12 (React useRef array-of-struct ref): the array element type for
    # `useRef<RTCIceCandidateInit[]>([])`-shaped refs (ChessPage.tsx pendingIceCandidatesRef
    # family). Fields match exactly what ChessPage.tsx:901-903 constructs
    # (`{candidate, sdpMid, sdpMLineIndex}` — no `usernameFragment`, never constructed in the
    # real source, not fabricated here). `sdpMLineIndex` is a real WebRTC m-line index (0 is a
    # legitimate value, the first m-line) — `sdpMLineIndexPresent` disambiguates "explicitly 0"
    # from "field omitted" so the KV round-trip is lossless/reversible, not just best-effort.
    WebSceneIceCandidateRecord =
        candidate: str
        sdpMid: str
        sdpMLineIndexPresent: bool
        sdpMLineIndex: int64

    # CHT mechanism 14 (React useRef<T | null> struct ref — ChessPage.tsx iceConfigRef family):
    # the singular counterpart to WebSceneIceCandidateRecord's array-of-struct shape above — a
    # `useRef<WebRtcIceConfig | null>(null)`-shaped ref, hand-audited against the real
    # `WebRtcIceConfig`/`WebRtcTurnServer` interfaces (app/libp2p/webrtcIceConfig.ts:10-22) and the
    # real, project-actual `RTCIceServer` shape this codebase's TS lib version resolves to
    # (node_modules/typescript/lib/lib.dom.d.ts: `credential?: string; urls: string | string[];
    # username?: string` — 3 fields, no `credentialType`). `iceServers` is the field TypeMapper's
    # generic emitStructs() path cannot map (RTCIceServer is an ambient lib.dom type with no
    # csg.type_decl fact) — hand-written here instead of silently dropped.
    #
    # `present`: RUNTIME-ONLY cache field, NEVER a JSON key (WebSceneEncodeWebRtcIceConfigRecord
    # never reads/writes it, WebSceneParseWebRtcIceConfigRecord never expects it as an input key).
    # The KV round-trip's OWN presence signal is the empty-string sentinel on the RAW KV VALUE
    # itself (WebSceneParseWebRtcIceConfigState/WebSceneEncodeWebRtcIceConfigState below) — `present`
    # merely caches that same fact on the in-memory struct so the CHT box-ref codegen (which only
    # ever sees the cached struct, never the raw KV string — see structBoxRefSlots in
    # csg-cheng-transpiler.ts) can translate `if (iceConfigRef.current)` without a second KV read.
    #
    # `urls: string | string[]` on RTCIceServer is regularized to `str[]` (a single string encodes
    # as a one-element array) — the exact same value, never lossy for this codec's purposes (the
    # app only ever reads `.urls` as a whole, never distinguishes the single-string source form).
    #
    # `expiresAtMs?: number`: same "0 is a legitimate real value" ambiguity mechanism 12's
    # `sdpMLineIndexPresent` already solved for `sdpMLineIndex` — reused verbatim here.
    WebSceneWebRtcTurnServerRecord =
        url: str
        username: str
        credential: str

    WebSceneWebRtcIceServerRecord =
        urls: str[]
        username: str
        credential: str

    WebSceneWebRtcIceConfigRecord =
        present: bool
        relayOnly: bool
        stunUrls: str[]
        turnServers: WebSceneWebRtcTurnServerRecord[]
        iceServers: WebSceneWebRtcIceServerRecord[]
        expiresAtMsPresent: bool
        expiresAtMs: int64

