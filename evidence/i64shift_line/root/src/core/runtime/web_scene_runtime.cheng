    if plan.nodes < 0:
        return false
    if plan.props < 0:
        return false
    if plan.eventHandlers < 0:
        return false
    if plan.hitTargets < 0:
        return false
    if plan.mediaAssets < 0:
        return false
    if plan.mediaPlaybackSlots < 0:
        return false
    if plan.mediaControlActions < 0:
        return false
    if plan.cssVariantRules < 0:
        return false
    if plan.cssVariantConditions < 0:
        return false
    if plan.cssDeclarations < 0:
        return false
    if plan.resources < 0:
        return false
    if plan.layoutConstraints < 0:
        return false
    if plan.paintOps < 0:
        return false
    if plan.paintSvgPrimitives < 0:
        return false
    if plan.routeEdges < 0:
        return false
    return true

