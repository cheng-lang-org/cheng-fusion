    return atlas.glyphs[index].sdfAtlasId

fn WebSceneGlyphAtlasGlyphSdfSpreadPxAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.glyphs.len:
        return -1
    return atlas.glyphs[index].sdfSpreadPx

fn WebSceneGlyphAtlasGlyphSdfPxRangeAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.glyphs.len:
        return -1
    return atlas.glyphs[index].sdfPxRange

fn WebSceneGlyphAtlasGlyphSdfPixelCountAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.glyphs.len:
        return -1
    return atlas.glyphs[index].sdfPixelCount

fn WebSceneGlyphAtlasGlyphSdfPixelStartAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.glyphs.len:
        return -1
    return atlas.glyphs[index].sdfPixelStart

fn WebSceneGlyphAtlasSdfPixelCount(atlas: var WebSceneGlyphAtlas): int32 =
    if atlas.sdfPixelCount > 0:
        return atlas.sdfPixelCount
    return atlas.sdfPixels.len

fn WebSceneGlyphAtlasSdfPixelVersion(atlas: var WebSceneGlyphAtlas): int32 =
    return atlas.sdfPixelVersion

fn WebSceneGlyphAtlasSdfPixelsResident(atlas: var WebSceneGlyphAtlas): bool =
    let pixelCount = WebSceneGlyphAtlasSdfPixelCount(atlas)
    if pixelCount <= 0:
        return false
    if atlas.sdfPixels.len < pixelCount:
        return false
    return true

fn WebSceneGlyphAtlasSdfPixelAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.sdfPixels.len:
        return -1
    return int32(atlas.sdfPixels[index])

# Give the atlas ownership of its SDF pixel buffer. The precompute pixel-asset
# path loads atlas metadata without the (large) pixel array in-memory (pixels
# stream straight to the host texture). Runtime glyph rasterization, however,
# grows atlas.sdfPixels, so it must first hold the baked pixels or the re-upload
# would ship a mostly-zero buffer and blank every baked glyph. Adopting the
# already-shipped pixels here keeps the source-size win while enabling on-demand
# rasterization. Inline-pixel loads already own their buffer — this is a no-op
# for them.
fn WebSceneGlyphAtlasAdoptSdfPixels(atlas: var WebSceneGlyphAtlas, pixels: uint8[]): bool =
    if atlas.sdfPixels.len > 0:
        return true
    if pixels.len <= 0:
        return false
    if atlas.sdfPixelCount > 0 && pixels.len != atlas.sdfPixelCount:
        return false
    var ownedPixels: uint8[]
    setLen(ownedPixels, pixels.len)
    for i in 0..<pixels.len:
        ownedPixels[i] = pixels[i]
    atlas.sdfPixels = ownedPixels
    atlas.sdfPixelCount = atlas.sdfPixels.len
    WebSceneGlyphAtlasBumpSdfPixelVersion(atlas)
    return true

fn WebSceneGlyphAtlasGlyphSdfPixelAt(atlas: var WebSceneGlyphAtlas,
                                     glyphIndex: int32,
                                     pixelIndex: int32): int32 =
    if glyphIndex < 0 || glyphIndex >= atlas.glyphs.len:
        return -1
    if pixelIndex < 0 || pixelIndex >= atlas.glyphs[glyphIndex].sdfPixelCount:
        return -1
    if atlas.glyphs[glyphIndex].width <= 0:
        return -1
    let px = pixelIndex % atlas.glyphs[glyphIndex].width
    let py = pixelIndex / atlas.glyphs[glyphIndex].width
    let atlasPixelIndex = (atlas.glyphs[glyphIndex].atlasY + py) * atlas.atlasWidth +
        atlas.glyphs[glyphIndex].atlasX + px
    if atlasPixelIndex < 0 || atlasPixelIndex >= atlas.sdfPixels.len:
        return -1
    return int32(atlas.sdfPixels[atlasPixelIndex])

fn WebSceneGlyphAtlasGlyphCodepointAt(atlas: var WebSceneGlyphAtlas, index: int32): int32 =
    if index < 0 || index >= atlas.glyphs.len:
        return -1
    return atlas.glyphs[index].codepoint

