        return WebSceneApplySocialAppEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_list_toggle:"):
        return WebSceneApplyStringListEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_value_toggle:"):
        return WebSceneApplyStringValueToggleEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_array_add_unique_trim:"):
        return WebSceneApplyStringArrayAddUniqueTrimEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_domain_transfer:"):
        return WebSceneApplyProfileDomainTransferEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "node_remark_cancel:"):
        return WebSceneApplyNodeRemarkCancelEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "node_remark_save:"):
        return WebSceneApplyNodeRemarkSaveEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_address_save:"):
        return WebSceneApplyProfileAddressSaveEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_address_edit:"):
        return WebSceneApplyProfileAddressEditEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_address_set_default:"):
        return WebSceneApplyProfileAddressSetDefaultEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "profile_address_delete:"):
        return WebSceneApplyProfileAddressDeleteEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "bazi_calculate:"):
        return WebSceneApplyBaziCalculateEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "ziwei_calculate:"):
        return WebSceneApplyZiweiCalculateEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "astrology_archive_save:"):
        return WebSceneApplyAstrologyArchiveSaveEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_red_packet_send:"):
        return WebSceneApplyChatRedPacketSendEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_text_send:"):
        return WebSceneApplyChatTextSendEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_voice_message_unsupported:"):
        return WebSceneApplyChatVoiceMessageUnsupportedEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_speech_input_start_unsupported:"):
        return WebSceneApplyChatSpeechInputStartUnsupportedEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_video_call_unsupported:"):
        return WebSceneApplyChatVideoCallUnsupportedEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "chat_location_send:"):
        return WebSceneApplyChatLocationSendEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_array_remove_index:"):
        return WebSceneApplyStringArrayRemoveIndexEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "doudizhu_card_drag_begin:"):
        return WebSceneApplyDoudizhuCardDragBeginEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "doudizhu_card_click:"):
        return WebSceneApplyDoudizhuCardClickEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "conversation_row_click:"):
        return WebSceneApplyConversationRowClickEffectSegment(graph, graph.activeRouteIndex, segment, markDirty)
    if WebSceneStrStartsWith(segment, "conversation_row_delete:"):
        return WebSceneApplyConversationRowDeleteEffectSegment(graph, graph.activeRouteIndex, segment, markDirty)
    if WebSceneStrStartsWith(segment, "publish_tag_toggle:"):
        return WebSceneApplyPublishTagEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "dapp_slow_playback_commit:"):
        return WebSceneApplyDappSlowPlaybackCommitEffect(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "distance_unit_toggle:"):
        return WebSceneApplyDistanceUnitToggleEffect(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "distance_range_blur:"):
        return WebSceneApplyDistanceRangeBlurEffect(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "license_plate_key:"):
        return WebSceneApplyLicensePlateKeyEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "license_plate_delete:"):
        return WebSceneApplyLicensePlateDeleteEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "string_set_toggle_all_static:"):
        return WebSceneApplyStringSetToggleAllStaticEffectSegmentForRoute(graph, graph.activeRouteIndex, segment, markDirty)
    if WebSceneStrStartsWith(segment, "toggle:"):
        return WebSceneApplyEventEffectSegment(graph, segment, markDirty)
    if WebSceneStrStartsWith(segment, "set:"):
        let eq = WebSceneFindEffectChar(segment, '=', 4)
        if eq <= 4:
            return -1
        let stateRef = strings.SliceBytes(segment, 4, eq - 4)
        let rawValue = strings.SliceBytes(segment, eq + 1, segment.len - eq - 1)
        var value = rawValue
        if WebSceneEffectValueUsesEventTarget(rawValue):
            value = inputValue
        let status = WebSceneSetStateValueInternal(graph, stateRef, value, markDirty)
        if status < 0:
            return -1
        return status
    return -1

@borrows
fn WebSceneApplyEventEffect(graph: var WebSceneGraph, effect: str, markDirty: bool): bool =
    if effect.len == 0:
        return true
    if !WebSceneEventEffectGuardsPass(graph, effect):
        return true
    var start = 0
    while start <= effect.len:
        var stop = start
        while stop < effect.len && effect[stop] != ';':
            stop = stop + 1
        let segment = strings.SliceBytes(effect, start, stop - start)
        let status = WebSceneApplyEventEffectSegment(graph, segment, markDirty)
        if status < 0:
            return false
        if stop >= effect.len:
            return true
        start = stop + 1
    return true

