fn WebSceneGlyphAtlasDefaultFontIndex(atlas: var WebSceneGlyphAtlas): int32 =
    for i in 0..<atlas.fonts.len:
        if atlas.fonts[i].fontWeight == 400 && atlas.fonts[i].fontFamily == layout.WebLayoutFontFamilySans:
            return i
    return -1

fn WebSceneGlyphAtlasFindFontIndex(atlas: var WebSceneGlyphAtlas, fontAtlasId: int32): int32 =
    for i in 0..<atlas.fonts.len:
        if atlas.fonts[i].fontAtlasId == fontAtlasId:
            return i
    return -1

fn WebSceneGlyphAtlasFindGlyphIndex(atlas: var WebSceneGlyphAtlas,
                                    fontAtlasId: int32,
                                    codepoint: int32,
                                    fontSize: int32): int32 =
    for i in 0..<atlas.glyphs.len:
        if atlas.glyphs[i].fontAtlasId == fontAtlasId &&
           atlas.glyphs[i].codepoint == codepoint &&
           atlas.glyphs[i].fontSize == fontSize:
            return i
    return -1

# Per-text-run memo for WebSceneGlyphAtlasFindGlyphIndex, scoped to one fixed
# (fontAtlasId, fontSize) pair (a run pins both after its first glyph
# resolves — see WebSceneGlyphAtlasAppendExistingGlyphTextRun). Multi-char
# runs otherwise rescan the whole atlas.glyphs (thousands of baked glyphs)
# once per character for a triple match that only varies by codepoint.
# cacheSlots is open-addressed by (codepoint & mask), holding the smallest
# atlas.glyphs index whose (fontAtlasId, fontSize) match this table's fixed
# pair — ascending insertion order reproduces the linear scan's "first
# match" semantics exactly (see probe-order proof: insert and lookup share
# the same starting slot and probe sequence, so a duplicate codepoint always
# resolves to whichever copy was inserted first, i.e. the smaller index).
# atlas.glyphs is append-only within one call (on-demand rasterization via
# WebSceneGlyphAtlasEnsureGlyphForCodepointWeighted only adds, never
# removes/reorders), so WebSceneGlyphAtlasSyncRunLookupCache just extends
# from cacheBuiltUpTo to the current atlas.glyphs.len — always current, no
# staleness window. Capacity is kept at >= 2x atlas.glyphs.len (rehash from
# scratch on growth past that) so the probe loop can never wrap into an
# infinite loop even if every character in the run rasterizes a brand new
# glyph.
fn WebSceneGlyphAtlasSyncRunLookupCache(atlas: var WebSceneGlyphAtlas,
                                        fontAtlasId: int32,
                                        fontSize: int32,
                                        cacheSlots: var int32[],
                                        cacheBuiltUpTo: var int32): bool =
    var neededCapacity = 16
    while neededCapacity < atlas.glyphs.len * 2:
        neededCapacity = neededCapacity * 2
    if cacheSlots.len < neededCapacity:
        setLen(cacheSlots, neededCapacity)
        for i in 0..<cacheSlots.len:
            cacheSlots[i] = -1
        cacheBuiltUpTo = 0
    let mask = cacheSlots.len - 1
    var i = cacheBuiltUpTo
    while i < atlas.glyphs.len:
        if atlas.glyphs[i].fontAtlasId == fontAtlasId && atlas.glyphs[i].fontSize == fontSize:
            var slot = atlas.glyphs[i].codepoint & mask
            while cacheSlots[slot] >= 0:
                slot = (slot + 1) & mask
            cacheSlots[slot] = i
        i = i + 1
    cacheBuiltUpTo = atlas.glyphs.len
    return true

fn WebSceneGlyphAtlasFindGlyphIndexCached(atlas: var WebSceneGlyphAtlas,
                                          fontAtlasId: int32,
                                          codepoint: int32,
                                          fontSize: int32,
                                          cacheSlots: var int32[],
                                          cacheBuiltUpTo: var int32): int32 =
    if !WebSceneGlyphAtlasSyncRunLookupCache(atlas, fontAtlasId, fontSize, cacheSlots, cacheBuiltUpTo):
        return -1
    let mask = cacheSlots.len - 1
    var slot = codepoint & mask
    var probes = 0
    while probes < cacheSlots.len:
        let idx = cacheSlots[slot]
        if idx < 0:
            return -1
        if atlas.glyphs[idx].fontAtlasId == fontAtlasId &&
           atlas.glyphs[idx].codepoint == codepoint &&
           atlas.glyphs[idx].fontSize == fontSize:
            return idx
        slot = (slot + 1) & mask
        probes = probes + 1
    return -1

fn WebSceneGlyphAtlasFindGlyphIndexAnyFont(atlas: var WebSceneGlyphAtlas,
                                           codepoint: int32,
                                           fontSize: int32): int32 =
    return WebSceneGlyphAtlasFindGlyphIndexAnyFontForSdfAtlas(atlas, codepoint, fontSize, 0)

fn WebSceneGlyphAtlasFindGlyphIndexForRequest(atlas: var WebSceneGlyphAtlas,
                                              codepoint: int32,
                                              fontSize: int32,
                                              fontWeight: int32,
                                              fontFamily: int32,
                                              sdfAtlasId: int32): int32 =
    var resolvedFontSize = fontSize
    if resolvedFontSize <= 0:
        resolvedFontSize = 16
    var glyphCodepoint = codepoint
    if codepoint == 9 || codepoint == 13:
        glyphCodepoint = 32
    var bestGlyphIndex = -1
    var bestFontIndex = -1
    for i in 0..<atlas.glyphs.len:
        if atlas.glyphs[i].codepoint == glyphCodepoint &&
           atlas.glyphs[i].fontSize == resolvedFontSize:
            if sdfAtlasId > 0 && atlas.glyphs[i].sdfAtlasId != sdfAtlasId:
                continue
            let fontIndex = WebSceneGlyphAtlasFindFontIndex(atlas, atlas.glyphs[i].fontAtlasId)
            if bestGlyphIndex < 0 || WebSceneGlyphAtlasFontRequestShouldReplace(atlas, bestFontIndex, fontIndex, fontWeight, fontFamily):
                bestGlyphIndex = i
                bestFontIndex = fontIndex
    return bestGlyphIndex

fn WebSceneGlyphAtlasFindGlyphIndexAnyFontForSdfAtlas(atlas: var WebSceneGlyphAtlas,
                                                      codepoint: int32,
                                                      fontSize: int32,
                                                      sdfAtlasId: int32): int32 =
    for i in 0..<atlas.glyphs.len:
        if atlas.glyphs[i].codepoint == codepoint &&
           atlas.glyphs[i].fontSize == fontSize:
            if sdfAtlasId <= 0 || atlas.glyphs[i].sdfAtlasId == sdfAtlasId:
                return i
    return -1

fn WebSceneGlyphAtlasFindGlyphSdfBitmapIndex(atlas: var WebSceneGlyphAtlas,
                                             fontAtlasId: int32,
                                             codepoint: int32,
                                             sdfFontSize: int32): int32 =
    for i in 0..<atlas.glyphs.len:
        if atlas.glyphs[i].fontAtlasId == fontAtlasId &&
           atlas.glyphs[i].codepoint == codepoint &&
           atlas.glyphs[i].sdfPixelStart >= 0 &&
           atlas.glyphs[i].sdfPixelCount > 0 &&
           WebSceneGlyphAtlasInferFontSizeFromGlyph(atlas.glyphs[i]) == sdfFontSize:
            return i
    return -1

fn WebSceneGlyphAtlasFindGlyphIdIndex(atlas: var WebSceneGlyphAtlas, glyphId: int32): int32 =
    # glyphId is a dense 1-based index into atlas.glyphs (invariant enforced at
    # load/validate: glyph.glyphId == glyphIndex + 1, see the != checks above).
    # Direct subtraction turns this O(glyphs) scan — hot in route glyph hydration
    # (called per runGlyph) — into O(1). The equality re-check is a correctness
    # guard, not a fallback: if it ever fails the dense invariant is broken and
    # the linear scan still returns the right answer (or -1 to crash loudly).
    let direct = glyphId - 1
    if direct >= 0 && direct < atlas.glyphs.len:
        if atlas.glyphs[direct].glyphId == glyphId:
            return direct
    for i in 0..<atlas.glyphs.len:
        if atlas.glyphs[i].glyphId == glyphId:
            return i
    return -1

fn WebSceneGlyphAtlasFindRunForPaintIndex(atlas: var WebSceneGlyphAtlas,
                                          routeIndex: int32,
                                          nodeId: int32,
                                          ordinal: int32): int32 =
    var found = -1
    for i in 0..<atlas.runs.len:
        if atlas.runs[i].routeIndex == routeIndex &&
           atlas.runs[i].nodeId == nodeId &&
           atlas.runs[i].ordinal == ordinal:
            if atlas.runs[i].glyphCount > 0:
                found = i
    return found

fn WebSceneGlyphHash31(fontAtlasId: int32, codepoint: int32, fontSize: int32): int32 =
    var hash: int64 = int64(216613626)
    hash = (hash * int64(16777619) + int64(fontAtlasId)) % int64(2147483647)
    hash = (hash * int64(16777619) + int64(codepoint)) % int64(2147483647)
    hash = (hash * int64(16777619) + int64(fontSize)) % int64(2147483647)
    let out = Int32(hash)
    if out <= 0:
        return 1
    return out

fn WebSceneGlyphSdfAtlasHash31(fontAtlasId: int32, spreadPx: int32, pxRange: int32): int32 =
    if fontAtlasId <= 0 || spreadPx <= 0 || pxRange <= 0:
        return 0
    var hash: int64 = int64(216613626)
    hash = (hash * int64(16777619) + int64(fontAtlasId)) % int64(2147483647)
    hash = (hash * int64(16777619) + int64(spreadPx)) % int64(2147483647)
    hash = (hash * int64(16777619) + int64(pxRange)) % int64(2147483647)
    let out = Int32(hash)
    if out <= 0:
        return 1
    return out

@borrows
fn WebSceneAppendGpuCommandFromPaintOp(routeIndex: int32,
                                       layerId: int32,
                                       op: paint.PaintOp,
                                       commands: var WebSceneGpuCommand[]): bool =
    var command: WebSceneGpuCommand
    command.routeIndex = routeIndex
    command.layerId = layerId
    command.kind = 0
    command.x = op.rect.x
    command.y = op.rect.y
    command.width = op.rect.width
    command.height = op.rect.height
    command.color = op.color
    command.imageId = op.image.imageId
    command.iconKind = op.icon.kind
    command.iconPrimitiveCount = op.icon.primitives.len
    command.svgDisplayListId = 0
    command.fontAtlasId = 0
    command.glyphRunId = 0
    command.glyphRunGlyphCount = 0
    command.glyphSdfAtlasId = 0
    command.rotationDeg = 0
    command.textContent = op.text.text
    if op.kind == paint.PaintOpKindFillRect:
        command.kind = WebSceneGpuFillRect
        command.fontAtlasId = op.borderRadius
    elif op.kind == paint.PaintOpKindStrokeRect:
        command.kind = WebSceneGpuStrokeRect
        command.fontAtlasId = op.borderRadius
    elif op.kind == paint.PaintOpKindFillText:
        command.kind = WebSceneGpuFillText
    elif op.kind == paint.PaintOpKindDrawImage:
        if op.image.imageId <= 0:
            return false
        command.kind = WebSceneGpuDrawImage
    elif op.kind == paint.PaintOpKindIcon:
        if op.icon.kind <= 0:
            return false
        command.kind = WebSceneGpuDrawIcon
    elif op.kind == paint.PaintOpKindClipRect:
        if op.clipRect.width <= 0 || op.clipRect.height <= 0:
            return false
        command.kind = WebSceneGpuSetClip
        command.x = op.clipRect.x
        command.y = op.clipRect.y
        command.width = op.clipRect.width
        command.height = op.clipRect.height
    elif op.kind == paint.PaintOpKindBoxShadow:
        command.kind = WebSceneGpuBoxShadow
        command.imageId = op.shadowOffsetX
        command.iconKind = op.shadowOffsetY
        command.iconPrimitiveCount = op.shadowBlur
        command.svgDisplayListId = op.shadowSpread
        command.fontAtlasId = op.borderRadius
        if op.shadowInset:
            command.glyphSdfAtlasId = 1
    elif op.kind == paint.PaintOpKindGradientFill:
        if op.gradientStops.len != 2:
            return false
        command.kind = WebSceneGpuGradientFill
        command.color = op.gradientStops[0].color
        command.imageId = op.gradientStops[1].color
        command.iconKind = op.gradientAngle
        command.fontAtlasId = op.borderRadius
        command.iconPrimitiveCount = op.shadowOffsetX
        command.svgDisplayListId = op.shadowOffsetY
        command.glyphRunId = op.shadowBlur
        command.glyphRunGlyphCount = op.shadowSpread
    else:
        return false
    if command.width < 0 || command.height < 0:
        return false
    add(commands, command)
    return true

@borrows
fn WebSceneAppendGpuCommandFromScenePaintOpWithAtlases(sceneOp: WebScenePaintOp,
                                                       layerId: int32,
                                                       imageAtlas: var WebSceneImageAtlas,
                                                       svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                       commands: var WebSceneGpuCommand[]): bool =
    if sceneOp.opKind == WebScenePaintTextColor:
        return true
    var command: WebSceneGpuCommand
    command.routeIndex = sceneOp.routeIndex
    command.layerId = layerId
    command.kind = 0
    command.x = sceneOp.x
    command.y = sceneOp.y
    command.width = sceneOp.width
    command.height = sceneOp.height
    command.color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.color, sceneOp.opacity))
    command.imageId = 0
    command.iconKind = 0
    command.iconPrimitiveCount = 0
    command.svgDisplayListId = 0
    command.fontAtlasId = 0
    command.glyphRunId = 0
    command.glyphRunGlyphCount = 0
    command.glyphSdfAtlasId = 0
    command.rotationDeg = sceneOp.rotationDeg
    command.textContent = ""
    if sceneOp.opKind == WebScenePaintFill:
        command.kind = WebSceneGpuFillRect
        command.fontAtlasId = sceneOp.radius
    elif sceneOp.opKind == WebScenePaintBorder:
        command.kind = WebSceneGpuStrokeRect
        command.fontAtlasId = sceneOp.radius
    elif sceneOp.opKind == WebScenePaintBoxShadow:
        command.kind = WebSceneGpuBoxShadow
        command.imageId = sceneOp.shadowOffsetX
        command.iconKind = sceneOp.shadowOffsetY
        command.iconPrimitiveCount = sceneOp.shadowBlur
        command.svgDisplayListId = sceneOp.shadowSpread
        command.fontAtlasId = sceneOp.radius
        if sceneOp.shadowInset:
            command.glyphSdfAtlasId = 1
    elif sceneOp.opKind == WebScenePaintGradientFill:
        command.kind = WebSceneGpuGradientFill
        command.color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.color, sceneOp.opacity))
        command.imageId = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.gradientEndColor, sceneOp.opacity))
        command.iconKind = sceneOp.gradientAngle
        command.fontAtlasId = sceneOp.radius
        command.iconPrimitiveCount = sceneOp.shadowOffsetX
        command.svgDisplayListId = sceneOp.shadowOffsetY
        command.glyphRunId = sceneOp.shadowBlur
        command.glyphRunGlyphCount = sceneOp.shadowSpread
    elif sceneOp.opKind == WebScenePaintSvgCirclePattern:
        command.kind = WebSceneGpuSvgCirclePattern
        command.color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.color, sceneOp.opacity))
        command.imageId = sceneOp.shadowOffsetX
        command.iconKind = sceneOp.shadowOffsetY
        command.iconPrimitiveCount = sceneOp.shadowBlur
        command.svgDisplayListId = sceneOp.shadowSpread
        command.fontAtlasId = sceneOp.radius
    elif WebScenePaintKindIsText(sceneOp.opKind):
        command.kind = WebSceneGpuFillText
        command.textContent = sceneOp.textContent
    elif sceneOp.opKind == WebScenePaintImage:
        let imageId = WebSceneImageAtlasTextureIdForResource(imageAtlas, sceneOp.resourceId)
        if imageId <= 0:
            return false
        command.kind = WebSceneGpuDrawImage
        command.imageId = imageId
    elif sceneOp.opKind == WebScenePaintSvgIcon:
        let displayListId = WebSceneSvgDisplayListIdForResource(svgAtlas, sceneOp.resourceId)
        if displayListId <= 0:
            return false
        let primitiveCount = WebSceneSvgDisplayListPrimitiveCountForResource(svgAtlas, sceneOp.resourceId)
        if primitiveCount <= 0:
            return false
        command.kind = WebSceneGpuDrawIcon
        command.iconKind = paint.PaintIconKindSvg
        command.iconPrimitiveCount = primitiveCount
        command.svgDisplayListId = displayListId
    else:
        return false
    if command.width < 0 || command.height < 0:
        return false
    add(commands, command)
    return true

@borrows
fn WebSceneAppendGpuCommandFromScenePaintOpWithFullAtlases(sceneOp: WebScenePaintOp,
                                                           layerId: int32,
                                                           imageAtlas: var WebSceneImageAtlas,
                                                           svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                           glyphAtlas: var WebSceneGlyphAtlas,
                                                           commands: var WebSceneGpuCommand[]): bool =
    if sceneOp.opKind == WebScenePaintTextColor:
        return true
    var command: WebSceneGpuCommand
    command.routeIndex = sceneOp.routeIndex
    command.layerId = layerId
    command.kind = 0
    command.x = sceneOp.x
    command.y = sceneOp.y
    command.width = sceneOp.width
    command.height = sceneOp.height
    command.color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.color, sceneOp.opacity))
    command.imageId = 0
    command.iconKind = 0
    command.iconPrimitiveCount = 0
    command.svgDisplayListId = 0
    command.fontAtlasId = 0
    command.glyphRunId = 0
    command.glyphRunGlyphCount = 0
    command.glyphSdfAtlasId = 0
    command.rotationDeg = sceneOp.rotationDeg
    command.textContent = ""
    if sceneOp.opKind == WebScenePaintFill:
        command.kind = WebSceneGpuFillRect
        command.fontAtlasId = sceneOp.radius
    elif sceneOp.opKind == WebScenePaintBorder:
        command.kind = WebSceneGpuStrokeRect
        command.fontAtlasId = sceneOp.radius
    elif sceneOp.opKind == WebScenePaintBoxShadow:
        command.kind = WebSceneGpuBoxShadow
        command.imageId = sceneOp.shadowOffsetX
        command.iconKind = sceneOp.shadowOffsetY
        command.iconPrimitiveCount = sceneOp.shadowBlur
        command.svgDisplayListId = sceneOp.shadowSpread
        command.fontAtlasId = sceneOp.radius
        if sceneOp.shadowInset:
            command.glyphSdfAtlasId = 1
    elif sceneOp.opKind == WebScenePaintGradientFill:
        command.kind = WebSceneGpuGradientFill
        command.color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.color, sceneOp.opacity))
        command.imageId = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.gradientEndColor, sceneOp.opacity))
        command.iconKind = sceneOp.gradientAngle
        command.fontAtlasId = sceneOp.radius
        command.iconPrimitiveCount = sceneOp.shadowOffsetX
        command.svgDisplayListId = sceneOp.shadowOffsetY
        command.glyphRunId = sceneOp.shadowBlur
        command.glyphRunGlyphCount = sceneOp.shadowSpread
    elif sceneOp.opKind == WebScenePaintSvgCirclePattern:
        command.kind = WebSceneGpuSvgCirclePattern
        command.color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.color, sceneOp.opacity))
        command.imageId = sceneOp.shadowOffsetX
        command.iconKind = sceneOp.shadowOffsetY
        command.iconPrimitiveCount = sceneOp.shadowBlur
        command.svgDisplayListId = sceneOp.shadowSpread
        command.fontAtlasId = sceneOp.radius
    elif WebScenePaintKindIsText(sceneOp.opKind):
        if sceneOp.textContent.len == 0:
            # empty text has no run and draws nothing (paired with the empty
            # skip in AppendExistingGlyphTextRun): append no command
            return true
        var glyphRunId = WebSceneGlyphAtlasRunIdForPaint(glyphAtlas, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
        if glyphRunId <= 0:
            # lazy hydration: state-bound text (input value/placeholder) may not
            # have a run yet when routes hydrate out of order — building it here
            # is deterministic (text + font metrics only)
            if !WebSceneGlyphAtlasAppendExistingGlyphTextRun(sceneOp, glyphAtlas):
                WebSceneGlyphAtlasDebugFail(801, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphRunId)
                return false
            glyphRunId = WebSceneGlyphAtlasRunIdForPaint(glyphAtlas, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
            if glyphRunId <= 0:
                WebSceneGlyphAtlasDebugFail(801, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphRunId)
                return false
        let fontAtlasId = WebSceneGlyphAtlasRunFontAtlasIdForPaint(glyphAtlas, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
        if fontAtlasId <= 0:
            WebSceneGlyphAtlasDebugFail(802, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, fontAtlasId)
            return false
        let glyphCount = WebSceneGlyphAtlasRunGlyphCountForPaint(glyphAtlas, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
        if glyphCount < 0:
            WebSceneGlyphAtlasDebugFail(803, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphCount)
            return false
        let glyphSdfAtlasId = WebSceneGlyphAtlasRunSdfAtlasIdForPaint(glyphAtlas, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
        if glyphSdfAtlasId <= 0:
            WebSceneGlyphAtlasDebugFail(804, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, glyphSdfAtlasId)
            return false
        command.kind = WebSceneGpuFillText
        command.fontAtlasId = fontAtlasId
        command.glyphRunId = glyphRunId
        command.glyphRunGlyphCount = glyphCount
        command.glyphSdfAtlasId = glyphSdfAtlasId
        command.textContent = sceneOp.textContent
    elif sceneOp.opKind == WebScenePaintImage:
        let imageId = WebSceneImageAtlasTextureIdForResource(imageAtlas, sceneOp.resourceId)
        if imageId <= 0:
            WebSceneGlyphAtlasDebugFail(811, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, imageId)
            return false
        command.kind = WebSceneGpuDrawImage
        command.imageId = imageId
    elif sceneOp.opKind == WebScenePaintSvgIcon:
        let displayListId = WebSceneSvgDisplayListIdForResource(svgAtlas, sceneOp.resourceId)
        if displayListId <= 0:
            WebSceneGlyphAtlasDebugFail(821, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, displayListId)
            return false
        let primitiveCount = WebSceneSvgDisplayListPrimitiveCountForResource(svgAtlas, sceneOp.resourceId)
        if primitiveCount <= 0:
            WebSceneGlyphAtlasDebugFail(822, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, primitiveCount)
            return false
        command.kind = WebSceneGpuDrawIcon
        command.iconKind = paint.PaintIconKindSvg
        command.iconPrimitiveCount = primitiveCount
        command.svgDisplayListId = displayListId
    else:
        WebSceneGlyphAtlasDebugFail(830, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, sceneOp.opKind)
        return false
    if command.width < 0 || command.height < 0:
        WebSceneGlyphAtlasDebugFail(831, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal, command.width)
        return false
    add(commands, command)
    return true

fn WebSceneBuildActiveRoutePaintCommands(graph: var WebSceneGraph, layerId: int32, buffer: var WebScenePaintCommandBuffer): bool =
    if graph.activeRouteIndex < 0:
        return false
    return WebSceneBuildRouteLayerPaintCommands(graph, graph.activeRouteIndex, layerId, buffer)

fn WebSceneBuildRouteLayerPaintCommands(graph: var WebSceneGraph,
                                        routeIndex: int32,
                                        layerId: int32,
                                        buffer: var WebScenePaintCommandBuffer): bool =
    return WebSceneBuildRoutePaintCommandsScoped(graph, routeIndex, layerId, 0, buffer, false)

fn WebSceneBuildDirtyPaintCommands(graph: var WebSceneGraph, dirtyIndex: int32, buffer: var WebScenePaintCommandBuffer): bool =
    if dirtyIndex < 0 || dirtyIndex >= graph.dirtySpans.len:
        return false
    let span = graph.dirtySpans[dirtyIndex]
    if span.reason == WebSceneDirtyLayerMove:
        if WebSceneFindLayerIndex(graph, span.routeIndex, span.layerId) < 0:
            return false
        WebScenePaintCommandBufferInit(buffer)
        buffer.routeIndex = span.routeIndex
        buffer.layerId = span.layerId
        return true
    if span.reason == WebSceneDirtyLayer:
        return WebSceneBuildRoutePaintCommandsScoped(graph, span.routeIndex, span.layerId, 0, buffer, false)
    if span.reason == WebSceneDirtySubtree:
        if !WebSceneNodeBelongsToRoute(graph, span.routeIndex, span.nodeId):
            return false
        return WebSceneBuildRoutePaintCommandsScoped(graph, span.routeIndex, 0, span.nodeId, buffer, false)
    if span.reason == WebSceneDirtyRoute:
        return WebSceneBuildRoutePaintCommandsScoped(graph, span.routeIndex, 0, 0, buffer, false)
    return false

fn WebSceneBuildRouteTransitionPlan(graph: var WebSceneGraph,
                                    fromRouteIndex: int32,
                                    toRouteIndex: int32,
                                    plan: var WebSceneLayerTransitionPlan): bool =
    WebSceneLayerTransitionPlanInit(plan)
    if fromRouteIndex < 0 || fromRouteIndex >= graph.routes.len:
        return false
    if toRouteIndex < 0 || toRouteIndex >= graph.routes.len:
        return false
    plan.fromRouteIndex = fromRouteIndex
    plan.toRouteIndex = toRouteIndex
    for i in 0..<graph.layers.len:
        if graph.layers[i].routeIndex != toRouteIndex:
            continue
        let targetLayer = graph.layers[i]
        let sourceIndex = WebSceneFindUniqueLayerByName(graph, fromRouteIndex, targetLayer.name)
        var action: WebSceneLayerTransition
        action.fromRouteIndex = fromRouteIndex
        action.toRouteIndex = toRouteIndex
        action.fromLayerId = 0
        action.toLayerId = targetLayer.layerId
        action.layerName = targetLayer.name
        action.action = WebSceneLayerTransitionReplace
        action.contentHash = WebSceneLayerContentHash(graph, toRouteIndex, targetLayer.layerId)
        if sourceIndex == -2:
            return false
        if sourceIndex >= 0:
            action.fromLayerId = graph.layers[sourceIndex].layerId
            if WebSceneLayerContentEquivalent(graph, fromRouteIndex, action.fromLayerId, toRouteIndex, targetLayer.layerId):
                action.action = WebSceneLayerTransitionReuse
                action.contentHash = WebSceneLayerContentHash(graph, fromRouteIndex, action.fromLayerId)
        add(plan.actions, action)
    for i in 0..<graph.layers.len:
        if graph.layers[i].routeIndex != fromRouteIndex:
            continue
        let sourceLayer = graph.layers[i]
        let targetIndex = WebSceneFindUniqueLayerByName(graph, toRouteIndex, sourceLayer.name)
        if targetIndex == -2:
            return false
        if targetIndex < 0:
            var action: WebSceneLayerTransition
            action.fromRouteIndex = fromRouteIndex
            action.toRouteIndex = toRouteIndex
            action.fromLayerId = sourceLayer.layerId
            action.toLayerId = 0
            action.layerName = sourceLayer.name
            action.action = WebSceneLayerTransitionDrop
            action.contentHash = WebSceneLayerContentHash(graph, fromRouteIndex, sourceLayer.layerId)
            add(plan.actions, action)
    return true

fn WebSceneTransitionActionCount(plan: var WebSceneLayerTransitionPlan): int32 =
    return plan.actions.len

fn WebSceneTransitionActionAt(plan: var WebSceneLayerTransitionPlan, index: int32): int32 =
    if index < 0 || index >= plan.actions.len:
        return -1
    return plan.actions[index].action

fn WebSceneTransitionLayerNameAt(plan: var WebSceneLayerTransitionPlan, index: int32): str =
    if index < 0 || index >= plan.actions.len:
        return ""
    return plan.actions[index].layerName

fn WebSceneTransitionFromLayerAt(plan: var WebSceneLayerTransitionPlan, index: int32): int32 =
    if index < 0 || index >= plan.actions.len:
        return -1
    return plan.actions[index].fromLayerId

fn WebSceneTransitionToLayerAt(plan: var WebSceneLayerTransitionPlan, index: int32): int32 =
    if index < 0 || index >= plan.actions.len:
        return -1
    return plan.actions[index].toLayerId

fn WebSceneTransitionContentHashAt(plan: var WebSceneLayerTransitionPlan, index: int32): int32 =
    if index < 0 || index >= plan.actions.len:
        return -1
    return plan.actions[index].contentHash

fn WebSceneTransitionReusedLayerCount(plan: var WebSceneLayerTransitionPlan): int32 =
    var count = 0
    for i in 0..<plan.actions.len:
        if plan.actions[i].action == WebSceneLayerTransitionReuse:
            count = count + 1
    return count

fn WebSceneTransitionReplacedLayerCount(plan: var WebSceneLayerTransitionPlan): int32 =
    var count = 0
    for i in 0..<plan.actions.len:
        if plan.actions[i].action == WebSceneLayerTransitionReplace:
            count = count + 1
    return count

fn WebSceneTransitionDroppedLayerCount(plan: var WebSceneLayerTransitionPlan): int32 =
    var count = 0
    for i in 0..<plan.actions.len:
        if plan.actions[i].action == WebSceneLayerTransitionDrop:
            count = count + 1
    return count

@borrows
fn WebSceneFindUniqueLayerByName(graph: var WebSceneGraph, routeIndex: int32, name: str): int32 =
    var found = -1
    for i in 0..<graph.layers.len:
        if graph.layers[i].routeIndex == routeIndex && graph.layers[i].name == name:
            if found >= 0:
                return -2
            found = i
    return found

fn WebSceneLayerContentEquivalent(graph: var WebSceneGraph,
                                  leftRouteIndex: int32,
                                  leftLayerId: int32,
                                  rightRouteIndex: int32,
                                  rightLayerId: int32): bool =
    if WebSceneLayerContentHash(graph, leftRouteIndex, leftLayerId) != WebSceneLayerContentHash(graph, rightRouteIndex, rightLayerId):
        return false
    let leftCount = WebSceneLayerPaintOpCount(graph, leftRouteIndex, leftLayerId)
    let rightCount = WebSceneLayerPaintOpCount(graph, rightRouteIndex, rightLayerId)
    if leftCount != rightCount:
        return false
    var leftOpIndex = -1
    var rightOpIndex = -1
    for sequence in 0..<leftCount:
        leftOpIndex = WebSceneLayerPaintOpIndexAtSequence(graph, leftRouteIndex, leftLayerId, sequence)
        rightOpIndex = WebSceneLayerPaintOpIndexAtSequence(graph, rightRouteIndex, rightLayerId, sequence)
        if leftOpIndex < 0 || rightOpIndex < 0:
            return false
        if !WebScenePaintOpsEquivalent(graph, leftOpIndex, rightOpIndex):
            return false
    return true

fn WebScenePaintOpsEquivalent(graph: var WebSceneGraph, leftIndex: int32, rightIndex: int32): bool =
    if leftIndex < 0 || leftIndex >= graph.paintOps.len:
        return false
    if rightIndex < 0 || rightIndex >= graph.paintOps.len:
        return false
    let left = graph.paintOps[leftIndex]
    let right = graph.paintOps[rightIndex]
    if left.opKind != right.opKind:
        return false
    if left.ordinal != right.ordinal:
        return false
    if left.x != right.x || left.y != right.y:
        return false
    if left.width != right.width || left.height != right.height:
        return false
    if left.radius != right.radius:
        return false
    if left.color != right.color:
        return false
    if !(left.resourceId == right.resourceId):
        return false
    if !(left.textContent == right.textContent):
        return false
    if left.shadowInset != right.shadowInset:
        return false
    if left.opKind == WebScenePaintSvgIcon:
        return WebScenePaintSvgPrimitivesEquivalent(graph, left, right)
    return true

@borrows
fn WebScenePaintSvgPrimitivesEquivalent(graph: var WebSceneGraph,
                                        left: WebScenePaintOp,
                                        right: WebScenePaintOp): bool =
    let leftCount = WebScenePaintSvgPrimitiveCount(graph, left.routeIndex, left.nodeId, left.ordinal)
    let rightCount = WebScenePaintSvgPrimitiveCount(graph, right.routeIndex, right.nodeId, right.ordinal)
    if leftCount != rightCount:
        return false
    for i in 0..<leftCount:
        let leftPrimitiveIndex = WebScenePaintSvgPrimitiveIndexAtSequence(graph, left.routeIndex, left.nodeId, left.ordinal, i)
        let rightPrimitiveIndex = WebScenePaintSvgPrimitiveIndexAtSequence(graph, right.routeIndex, right.nodeId, right.ordinal, i)
        if leftPrimitiveIndex < 0 || rightPrimitiveIndex < 0:
            return false
        if !WebSceneSvgPrimitiveEqual(graph.paintSvgPrimitives[leftPrimitiveIndex].primitive,
                                      graph.paintSvgPrimitives[rightPrimitiveIndex].primitive):
            return false
    return true

fn WebSceneLayerPaintOpCount(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    var count = 0
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex:
            let nodeLayerId = WebSceneFindNodeLayerId(graph, graph.paintOps[i].nodeId)
            if nodeLayerId == layerId:
                count = count + 1
    return count

fn WebSceneLayerPaintOpIndexAtSequence(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       layerId: int32,
                                       sequence: int32): int32 =
    if sequence < 0:
        return -1
    var seen = 0
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex:
            let nodeLayerId = WebSceneFindNodeLayerId(graph, graph.paintOps[i].nodeId)
            if nodeLayerId == layerId:
                if seen == sequence:
                    return i
                seen = seen + 1
    return -1

fn WebScenePaintSvgPrimitiveIndexAtSequence(graph: var WebSceneGraph,
                                            routeIndex: int32,
                                            nodeId: int32,
                                            ordinal: int32,
                                            sequence: int32): int32 =
    if sequence < 0:
        return -1
    var seen = 0
    for i in 0..<graph.paintSvgPrimitives.len:
        if graph.paintSvgPrimitives[i].routeIndex == routeIndex &&
           graph.paintSvgPrimitives[i].nodeId == nodeId &&
           graph.paintSvgPrimitives[i].ordinal == ordinal:
            if seen == sequence:
                return i
            seen = seen + 1
    return -1

fn WebSceneLayerContentHash(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    var hash: int64 = int64(216613626)
    for i in 0..<graph.paintShadows.len:
        if graph.paintShadows[i].routeIndex == routeIndex:
            let nodeLayerId = WebSceneFindNodeLayerId(graph, graph.paintShadows[i].nodeId)
            if nodeLayerId == layerId:
                hash = WebSceneHashPaintOp(graph, hash, graph.paintShadows[i])
    for i in 0..<graph.paintGradients.len:
        if graph.paintGradients[i].routeIndex == routeIndex:
            let nodeLayerId = WebSceneFindNodeLayerId(graph, graph.paintGradients[i].nodeId)
            if nodeLayerId == layerId:
                hash = WebSceneHashPaintOp(graph, hash, graph.paintGradients[i])
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex:
            let nodeLayerId = WebSceneFindNodeLayerId(graph, graph.paintOps[i].nodeId)
            if nodeLayerId == layerId:
                hash = WebSceneHashPaintOp(graph, hash, graph.paintOps[i])
    let out = Int32(hash)
    if out <= 0:
        return 1
    return out

@borrows
fn WebSceneHashPaintOp(graph: var WebSceneGraph, hash: int64, op: WebScenePaintOp): int64 =
    var out = hash
    out = WebSceneHashInt64(out, op.opKind)
    out = WebSceneHashInt64(out, op.ordinal)
    out = WebSceneHashInt64(out, op.x)
    out = WebSceneHashInt64(out, op.y)
    out = WebSceneHashInt64(out, op.width)
    out = WebSceneHashInt64(out, op.height)
    out = WebSceneHashInt64(out, op.radius)
    out = WebSceneHashInt64(out, op.shadowOffsetX)
    out = WebSceneHashInt64(out, op.shadowOffsetY)
    out = WebSceneHashInt64(out, op.shadowBlur)
    out = WebSceneHashInt64(out, op.shadowSpread)
    if op.shadowInset:
        out = WebSceneHashInt64(out, 1)
    else:
        out = WebSceneHashInt64(out, 0)
    out = WebSceneHashInt64(out, op.gradientAngle)
    out = WebSceneHashInt64(out, op.rotationDeg)
    out = WebSceneHashInt64(out, Int32(op.color % int64(2147483647)))
    out = WebSceneHashInt64(out, Int32(op.gradientEndColor % int64(2147483647)))
    out = WebSceneHashString(out, op.resourceId)
    out = WebSceneHashString(out, op.textContent)
    if op.opKind == WebScenePaintSvgIcon:
        let primitiveCount = WebScenePaintSvgPrimitiveCount(graph, op.routeIndex, op.nodeId, op.ordinal)
        out = WebSceneHashInt64(out, primitiveCount)
        for i in 0..<primitiveCount:
            let primitiveIndex = WebScenePaintSvgPrimitiveIndexAtSequence(graph, op.routeIndex, op.nodeId, op.ordinal, i)
            if primitiveIndex >= 0:
                let primitive = graph.paintSvgPrimitives[primitiveIndex].primitive
                out = WebSceneHashInt64(out, primitive.kind)
                out = WebSceneHashInt64(out, primitive.x1)
                out = WebSceneHashInt64(out, primitive.y1)
                out = WebSceneHashInt64(out, primitive.x2)
                out = WebSceneHashInt64(out, primitive.y2)
                out = WebSceneHashInt64(out, primitive.cx)
                out = WebSceneHashInt64(out, primitive.cy)
                out = WebSceneHashInt64(out, primitive.rx)
                out = WebSceneHashInt64(out, primitive.ry)
    return out

@borrows
fn WebSceneHashString(hash: int64, value: str): int64 =
    var out = WebSceneHashInt64(hash, value.len)
    for i in 0..<value.len:
        out = WebSceneHashInt64(out, Int32(value[i]))
    return out

fn WebSceneHashInt64(hash: int64, value: int32): int64 =
    var out = (hash * int64(16777619) + int64(value)) % int64(2147483647)
    if out < int64(0):
        out = 0 - out
    return out

fn WebSceneEnsureLayerCache(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if WebSceneFindLayerIndex(graph, routeIndex, layerId) < 0:
        return false
    if WebSceneFindLayerCacheIndex(graph, routeIndex, layerId) >= 0:
        return true
    var cache: WebSceneLayerCache
    cache.routeIndex = routeIndex
    cache.layerId = layerId
    cache.valid = false
    cache.version = -1
    cache.commandCount = 0
    WebSceneRectInit(cache.paintBounds)
    WebSceneRectInit(cache.dirtyRect)
    add(graph.layerCaches, cache)
    return true

fn WebSceneLayerCacheMarkValid(graph: var WebSceneGraph,
                               routeIndex: int32,
                               layerId: int32,
                               buffer: var WebScenePaintCommandBuffer): bool =
    if buffer.routeIndex != routeIndex || buffer.layerId != layerId:
        return false
    if !WebSceneEnsureLayerCache(graph, routeIndex, layerId):
        return false
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return false
    let layerIndex = WebSceneFindLayerIndex(graph, routeIndex, layerId)
    if layerIndex < 0:
        return false
    var bounds: WebSceneRect
    if !WebScenePaintCommandBounds(buffer, bounds):
        return false
    if !WebSceneRectIntersectCurrentViewportForLayer(graph,
                                                     graph.layers[layerIndex].offsetX,
                                                     graph.layers[layerIndex].offsetY,
                                                     bounds):
        return false
    if bounds.empty:
        graph.layerCaches[cacheIndex].valid = false
        graph.layerCaches[cacheIndex].version = graph.version
        graph.layerCaches[cacheIndex].commandCount = 0
        WebSceneLayerCacheSetPaintBoundsAt(graph, cacheIndex, bounds)
        WebSceneLayerCacheClearDirtyRectAt(graph, cacheIndex)
        return true
    graph.layerCaches[cacheIndex].valid = true
    graph.layerCaches[cacheIndex].version = graph.version
    graph.layerCaches[cacheIndex].commandCount = buffer.ops.len
    WebSceneLayerCacheSetPaintBoundsAt(graph, cacheIndex, bounds)
    WebSceneLayerCacheClearDirtyRectAt(graph, cacheIndex)
    return true

fn WebSceneInvalidateLayerCachesForDirtySpan(graph: var WebSceneGraph, dirtyIndex: int32, rangeIndexAlreadyBuilt: bool = false): bool =
    if dirtyIndex < 0 || dirtyIndex >= graph.dirtySpans.len:
        return false
    let span = graph.dirtySpans[dirtyIndex]
    if span.reason == WebSceneDirtyLayerMove:
        return true
    if span.reason == WebSceneDirtyLayer:
        let cacheIndex = WebSceneFindLayerCacheIndex(graph, span.routeIndex, span.layerId)
        if cacheIndex < 0:
            return true
        var buffer: WebScenePaintCommandBuffer
        if !WebSceneBuildRoutePaintCommandsScoped(graph, span.routeIndex, span.layerId, 0, buffer, rangeIndexAlreadyBuilt):
            return false
        return WebSceneInvalidateLayerCacheAt(graph, cacheIndex, buffer)
    if span.reason == WebSceneDirtyRoute:
        var ok = true
        for i in 0..<graph.layerCaches.len:
            if graph.layerCaches[i].routeIndex == span.routeIndex:
                var buffer: WebScenePaintCommandBuffer
                if !WebSceneBuildRoutePaintCommandsScoped(graph, span.routeIndex, graph.layerCaches[i].layerId, 0, buffer, rangeIndexAlreadyBuilt):
                    ok = false
                elif !WebSceneInvalidateLayerCacheAt(graph, i, buffer):
                    ok = false
        return ok
    if span.reason == WebSceneDirtySubtree:
        if !WebSceneNodeBelongsToRoute(graph, span.routeIndex, span.nodeId):
            return false
        var ok = true
        for i in 0..<graph.layerCaches.len:
            if graph.layerCaches[i].routeIndex == span.routeIndex &&
               WebSceneSubtreeHasLayerNode(graph, span.routeIndex, span.nodeId, graph.layerCaches[i].layerId):
                var buffer: WebScenePaintCommandBuffer
                if !WebSceneBuildRoutePaintCommandsScoped(graph, span.routeIndex, graph.layerCaches[i].layerId, 0, buffer, rangeIndexAlreadyBuilt):
                    ok = false
                elif !WebSceneInvalidateLayerCacheAt(graph, i, buffer):
                    ok = false
        return ok
    return false

fn WebSceneInvalidateLayerCachesForDirtySpans(graph: var WebSceneGraph): bool =
    # WebSceneBuildRoutePaintCommandsScoped rebuilds the paintOp/paintShadow/
    # paintGradient range indexes from scratch on every call. This loop can
    # fan one dirty span out to every layer cache in a route (WebSceneDirtyRoute
    # / WebSceneDirtySubtree), and this whole function runs once per dirty
    # span in the batch — none of that fan-out (WebSceneInvalidateLayerCacheAt
    # and everything it calls) mutates graph.paintOps/paintShadows/
    # paintGradients/nodeIndexById, so the index is graph-state-invariant for
    # the whole batch. Rebuild it once up front and skip the redundant
    # per-layer/per-span rebuilds instead of redoing an O(graph paint element
    # count) pass for every layer of every dirty span.
    if graph.dirtySpans.len > 0:
        if !WebSceneRebuildPaintCommandRangeIndexes(graph):
            return false
    var ok = true
    for i in 0..<graph.dirtySpans.len:
        if !WebSceneInvalidateLayerCachesForDirtySpan(graph, i, true):
            ok = false
    return ok

fn WebSceneInvalidateLayerCachesForRoute(graph: var WebSceneGraph, routeIndex: int32): bool =
    for i in 0..<graph.layerCaches.len:
        if graph.layerCaches[i].routeIndex != routeIndex:
            continue
        graph.layerCaches[i].valid = false
        graph.layerCaches[i].version = graph.version
        if graph.layerCaches[i].paintBounds.empty:
            if !WebSceneLayerCacheClearDirtyRectAt(graph, i):
                return false
        else:
            var bounds: WebSceneRect
            bounds.x = graph.layerCaches[i].paintBounds.x
            bounds.y = graph.layerCaches[i].paintBounds.y
            bounds.width = graph.layerCaches[i].paintBounds.width
            bounds.height = graph.layerCaches[i].paintBounds.height
            bounds.empty = graph.layerCaches[i].paintBounds.empty
            let layerIndex = WebSceneFindLayerIndex(graph, graph.layerCaches[i].routeIndex, graph.layerCaches[i].layerId)
            if layerIndex < 0:
                return false
            if !WebSceneRectIntersectCurrentViewportForLayer(graph,
                                                             graph.layers[layerIndex].offsetX,
                                                             graph.layers[layerIndex].offsetY,
                                                             bounds):
                return false
            if !WebSceneLayerCacheSetDirtyRectAt(graph, i, bounds):
                return false
    return true

fn WebSceneInvalidateAllLayerCaches(graph: var WebSceneGraph): bool =
    for i in 0..<graph.layerCaches.len:
        graph.layerCaches[i].valid = false
        graph.layerCaches[i].version = graph.version
        if graph.layerCaches[i].paintBounds.empty:
            if !WebSceneLayerCacheClearDirtyRectAt(graph, i):
                return false
        else:
            var bounds: WebSceneRect
            bounds.x = graph.layerCaches[i].paintBounds.x
            bounds.y = graph.layerCaches[i].paintBounds.y
            bounds.width = graph.layerCaches[i].paintBounds.width
            bounds.height = graph.layerCaches[i].paintBounds.height
            bounds.empty = graph.layerCaches[i].paintBounds.empty
            let layerIndex = WebSceneFindLayerIndex(graph, graph.layerCaches[i].routeIndex, graph.layerCaches[i].layerId)
            if layerIndex < 0:
                return false
            if !WebSceneRectIntersectCurrentViewportForLayer(graph,
                                                             graph.layers[layerIndex].offsetX,
                                                             graph.layers[layerIndex].offsetY,
                                                             bounds):
                return false
            if !WebSceneLayerCacheSetDirtyRectAt(graph, i, bounds):
                return false
    return true

fn WebSceneLayerCacheValid(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): bool =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return false
    return graph.layerCaches[cacheIndex].valid

fn WebSceneLayerCacheVersion(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return -1
    return graph.layerCaches[cacheIndex].version

fn WebSceneLayerCacheCommandCount(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return -1
    return graph.layerCaches[cacheIndex].commandCount

fn WebSceneLayerCachePaintBoundsX(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return 0
    return graph.layerCaches[cacheIndex].paintBounds.x

fn WebSceneLayerCachePaintBoundsY(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return 0
    return graph.layerCaches[cacheIndex].paintBounds.y

fn WebSceneLayerCachePaintBoundsWidth(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return 0
    return graph.layerCaches[cacheIndex].paintBounds.width

fn WebSceneLayerCachePaintBoundsHeight(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return 0
    return graph.layerCaches[cacheIndex].paintBounds.height

fn WebSceneLayerCacheDirtyX(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return 0
    return graph.layerCaches[cacheIndex].dirtyRect.x

fn WebSceneLayerCacheDirtyY(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return 0
    return graph.layerCaches[cacheIndex].dirtyRect.y

fn WebSceneLayerCacheDirtyWidth(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return 0
    return graph.layerCaches[cacheIndex].dirtyRect.width

fn WebSceneLayerCacheDirtyHeight(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): int32 =
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, routeIndex, layerId)
    if cacheIndex < 0:
        return 0
    return graph.layerCaches[cacheIndex].dirtyRect.height

fn WebSceneBuildCompositorFrameForDirtySpan(graph: var WebSceneGraph,
                                            dirtyIndex: int32,
                                            frame: var WebSceneCompositorFrame): bool =
    WebSceneCompositorFrameInit(frame)
    if dirtyIndex < 0 || dirtyIndex >= graph.dirtySpans.len:
        return false
    let span = graph.dirtySpans[dirtyIndex]
    frame.routeIndex = span.routeIndex
    if span.reason == WebSceneDirtySubtree:
        if !WebSceneNodeBelongsToRoute(graph, span.routeIndex, span.nodeId):
            return false
    if span.reason == WebSceneDirtyLayer && WebSceneFindLayerIndex(graph, span.routeIndex, span.layerId) < 0:
        return false
    if span.reason == WebSceneDirtyLayerMove && WebSceneFindLayerIndex(graph, span.routeIndex, span.layerId) < 0:
        return false
    if span.reason == WebSceneDirtyLayer ||
       span.reason == WebSceneDirtyLayerMove ||
       span.reason == WebSceneDirtyRoute ||
       span.reason == WebSceneDirtySubtree:
        return WebSceneAppendRouteLayersForCurrentComposite(graph, span.routeIndex, frame)
    return false

fn WebSceneBuildCompositorFrameForDirtySpanWithImageAtlas(graph: var WebSceneGraph,
                                                          dirtyIndex: int32,
                                                          atlas: var WebSceneImageAtlas,
                                                          frame: var WebSceneCompositorFrame): bool =
    if !WebSceneBuildCompositorFrameForDirtySpan(graph, dirtyIndex, frame):
        return false
    for i in 0..<frame.commands.len:
        if frame.commands[i].kind == WebSceneGpuDrawImage:
            if WebSceneImageAtlasFindTextureIndex(atlas, frame.commands[i].imageId) < 0:
                return false
    return true

fn WebSceneBuildCompositorFrameForDirtySpanWithAtlases(graph: var WebSceneGraph,
                                                       dirtyIndex: int32,
                                                       imageAtlas: var WebSceneImageAtlas,
                                                       svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                       frame: var WebSceneCompositorFrame): bool =
    WebSceneCompositorFrameInit(frame)
    if dirtyIndex < 0 || dirtyIndex >= graph.dirtySpans.len:
        return false
    let span = graph.dirtySpans[dirtyIndex]
    frame.routeIndex = span.routeIndex
    if span.reason == WebSceneDirtySubtree:
        if !WebSceneNodeBelongsToRoute(graph, span.routeIndex, span.nodeId):
            return false
    if span.reason == WebSceneDirtyLayer && WebSceneFindLayerIndex(graph, span.routeIndex, span.layerId) < 0:
        return false
    if span.reason == WebSceneDirtyLayerMove && WebSceneFindLayerIndex(graph, span.routeIndex, span.layerId) < 0:
        return false
    if span.reason == WebSceneDirtyLayer ||
       span.reason == WebSceneDirtyLayerMove ||
       span.reason == WebSceneDirtyRoute ||
       span.reason == WebSceneDirtySubtree:
        return WebSceneAppendRouteLayersForCurrentCompositeWithAtlases(graph, span.routeIndex, imageAtlas, svgAtlas, frame)
    return false

fn WebSceneBuildCompositorFrameForDirtySpanWithFullAtlases(graph: var WebSceneGraph,
                                                           dirtyIndex: int32,
                                                           imageAtlas: var WebSceneImageAtlas,
                                                           svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                           glyphAtlas: var WebSceneGlyphAtlas,
                                                           frame: var WebSceneCompositorFrame): bool =
    WebSceneCompositorFrameInit(frame)
    if dirtyIndex < 0 || dirtyIndex >= graph.dirtySpans.len:
        return false
    let span = graph.dirtySpans[dirtyIndex]
    frame.routeIndex = span.routeIndex
    if span.reason == WebSceneDirtySubtree:
        if !WebSceneNodeBelongsToRoute(graph, span.routeIndex, span.nodeId):
            return false
    if span.reason == WebSceneDirtyLayer && WebSceneFindLayerIndex(graph, span.routeIndex, span.layerId) < 0:
        return false
    if span.reason == WebSceneDirtyLayerMove && WebSceneFindLayerIndex(graph, span.routeIndex, span.layerId) < 0:
        return false
    if span.reason == WebSceneDirtyLayer ||
       span.reason == WebSceneDirtyLayerMove ||
       span.reason == WebSceneDirtyRoute ||
       span.reason == WebSceneDirtySubtree:
        return WebSceneAppendRouteLayersForCurrentCompositeWithFullAtlases(graph, span.routeIndex, imageAtlas, svgAtlas, glyphAtlas, frame)
    return false

fn WebSceneBuildCompositorFrameForRouteWithFullAtlases(graph: var WebSceneGraph,
                                                       routeIndex: int32,
                                                       imageAtlas: var WebSceneImageAtlas,
                                                       svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                       glyphAtlas: var WebSceneGlyphAtlas,
                                                       frame: var WebSceneCompositorFrame): bool =
    WebSceneCompositorFrameInit(frame)
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    frame.routeIndex = routeIndex
    return WebSceneAppendRouteLayersForCurrentCompositeWithFullAtlases(graph, routeIndex, imageAtlas, svgAtlas, glyphAtlas, frame)

fn WebSceneBuildCompositorFrameForRouteTransitionPlan(graph: var WebSceneGraph,
                                                      plan: var WebSceneLayerTransitionPlan,
                                                      frame: var WebSceneCompositorFrame): bool =
    WebSceneCompositorFrameInit(frame)
    if !WebSceneTransitionPlanRoutesValid(graph, plan):
        return false
    frame.routeIndex = plan.toRouteIndex
    for i in 0..<plan.actions.len:
        if !WebSceneAppendCompositorTransitionAction(graph, plan.actions[i], frame):
            return false
    return true

fn WebSceneBuildCompositorFrameForRouteTransitionPlanWithFullAtlases(graph: var WebSceneGraph,
                                                                     plan: var WebSceneLayerTransitionPlan,
                                                                     imageAtlas: var WebSceneImageAtlas,
                                                                     svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                                     glyphAtlas: var WebSceneGlyphAtlas,
                                                                     frame: var WebSceneCompositorFrame): bool =
    WebSceneCompositorFrameInit(frame)
    if !WebSceneTransitionPlanRoutesValid(graph, plan):
        return false
    frame.routeIndex = plan.toRouteIndex
    for i in 0..<plan.actions.len:
        if !WebSceneAppendCompositorTransitionActionWithFullAtlases(graph, plan.actions[i], imageAtlas, svgAtlas, glyphAtlas, frame):
            return false
    return true

fn WebSceneTransitionPlanRoutesValid(graph: var WebSceneGraph, plan: var WebSceneLayerTransitionPlan): bool =
    if plan.fromRouteIndex < 0 || plan.fromRouteIndex >= graph.routes.len:
        return false
    if plan.toRouteIndex < 0 || plan.toRouteIndex >= graph.routes.len:
        return false
    for i in 0..<plan.actions.len:
        if plan.actions[i].fromRouteIndex != plan.fromRouteIndex:
            return false
        if plan.actions[i].toRouteIndex != plan.toRouteIndex:
            return false
    return true

