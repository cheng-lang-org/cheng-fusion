    return frame.commands[index].imageId

fn WebSceneCompositorGpuCommandSvgDisplayListIdAt(frame: var WebSceneCompositorFrame, index: int32): int32 =
    if index < 0 || index >= frame.commands.len:
        return 0
    return frame.commands[index].svgDisplayListId

fn WebSceneCompositorGpuCommandFontAtlasIdAt(frame: var WebSceneCompositorFrame, index: int32): int32 =
