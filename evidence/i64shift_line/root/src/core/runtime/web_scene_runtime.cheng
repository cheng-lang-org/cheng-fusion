@borrows
fn WebSceneApplyEventEffectWithValue(graph: var WebSceneGraph, effect: str, inputValue: str, markDirty: bool): bool =
    if effect.len == 0:
        return true
    if !WebSceneEventEffectGuardsPass(graph, effect):
        return true
    var start = 0
    while start <= effect.len:
        var stop = start
        while stop < effect.len && effect[stop] != ';':
            stop = stop + 1
        let segment = strings.SliceBytes(effect, start, stop - start)
        let status = WebSceneApplyEventEffectSegmentWithValue(graph, segment, inputValue, markDirty)
        if status < 0:
            return false
        if stop >= effect.len:
            return true
        start = stop + 1
    return true

@borrows
fn WebSceneFindEventHandlerForNodeEvent(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, eventName: str): int32 =
    if eventName == "click":
        let payload = WebSceneInteractionPayload(graph, routeIndex, nodeId, 2)
        if payload == -2147483647:
            return -1
        return payload
    WebSceneEnsureEventHandlerIndex(graph)
    var i = webSceneEventHandlerIndexLowerBound(graph, routeIndex, nodeId)
    while i < graph.eventHandlerIndexRouteIds.len &&
          graph.eventHandlerIndexRouteIds[i] == routeIndex &&
          graph.eventHandlerIndexNodeIds[i] == nodeId:
        let handlerId = graph.eventHandlerIndexHandlerIds[i]
        if graph.eventHandlers[handlerId].eventName == eventName:
            return handlerId
        i = i + 1
    return -1

@borrows
fn WebSceneEventHandlerAcceptsTextInput(handler: WebSceneEventHandler): bool =
    if handler.actionKind != "state_delta":
        return false
    if !(handler.eventName == "change" || handler.eventName == "input"):
        return false
    return WebSceneStrContains(handler.effect, "=e.target.value") ||
        WebSceneStrContains(handler.effect, "=event.target.value") ||
        WebSceneStrContains(handler.effect, "=e.currentTarget.value") ||
        WebSceneStrContains(handler.effect, "=event.currentTarget.value")

fn WebSceneFindTextInputEventHandlerForNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    WebSceneEnsureEventHandlerIndex(graph)
    var i = webSceneEventHandlerIndexLowerBound(graph, routeIndex, nodeId)
    while i < graph.eventHandlerIndexRouteIds.len &&
          graph.eventHandlerIndexRouteIds[i] == routeIndex &&
          graph.eventHandlerIndexNodeIds[i] == nodeId:
        let handlerId = graph.eventHandlerIndexHandlerIds[i]
        if WebSceneEventHandlerAcceptsTextInput(graph.eventHandlers[handlerId]):
            return handlerId
        i = i + 1
    return -1

@borrows
fn WebSceneNodeAcceptsTextInput(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    if WebSceneFindTextInputEventHandlerForNode(graph, routeIndex, nodeId) >= 0:
        return true
    return false

fn WebSceneTextInputStateRefForNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): str =
    let eventIndex = WebSceneFindTextInputEventHandlerForNode(graph, routeIndex, nodeId)
    if eventIndex < 0:
        return ""
    return graph.eventHandlers[eventIndex].stateRef

@borrows
fn WebSceneApplyNodeTextInputValue(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   nodeId: int32,
                                   inputValue: str,
                                   markDirty: bool): bool =
    let eventIndex = WebSceneFindTextInputEventHandlerForNode(graph, routeIndex, nodeId)
    if eventIndex < 0:
        return false
    if !WebSceneApplyEventEffectWithValue(graph, graph.eventHandlers[eventIndex].effect, inputValue, markDirty):
        return false
    if !WebSceneSetNodePropValue(graph, routeIndex, nodeId, "value", inputValue):
        return false
    if !WebSceneApplyTextControlPaintValue(graph, routeIndex, nodeId, inputValue):
        return false
    if markDirty:
        if !WebSceneMarkDirtySubtree(graph, nodeId):
            return false
    return true

@borrows
fn WebSceneApplyNodeTextInputValueWithSelection(graph: var WebSceneGraph,
                                                routeIndex: int32,
                                                nodeId: int32,
                                                inputValue: str,
                                                selectionStart: int32,
                                                markDirty: bool): bool =
    let charCount = WebSceneUtf8CharCount(inputValue)
    if charCount < 0:
        return false
    var nextSelection = selectionStart
    if nextSelection < 0:
        return false
    if nextSelection > charCount:
        nextSelection = charCount
    if !WebSceneApplyNodeTextInputValue(graph, routeIndex, nodeId, inputValue, markDirty):
        return false
    if !WebSceneSetNodePropValue(graph, routeIndex, nodeId, "selectionStart", strings.IntToStr(nextSelection)):
        return false
    return true

@borrows
fn WebSceneApplyNodeEventEffect(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, eventName: str, markDirty: bool): bool =
    let eventIndex = WebSceneFindEventHandlerForNodeEvent(graph, routeIndex, nodeId, eventName)
    if eventIndex < 0:
        return true
    let actionKind = graph.eventHandlers[eventIndex].actionKind
    if actionKind.len == 0 || actionKind == "command":
        return true
    if actionKind != "route" && actionKind != "state_delta" && actionKind != "stop_propagation" && actionKind != "style_mutation" && actionKind != "media_lifecycle":
        return false
    if !WebSceneEventEffectGuardsPass(graph, graph.eventHandlers[eventIndex].effect):
        return true
    return WebSceneApplyEventEffectForNode(graph, routeIndex, nodeId, graph.eventHandlers[eventIndex].effect, markDirty)

@borrows
fn WebSceneApplyNodeKeyEventEffect(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, eventName: str, eventKey: str, markDirty: bool): bool =
    let eventIndex = WebSceneFindEventHandlerForNodeEvent(graph, routeIndex, nodeId, eventName)
    if eventIndex < 0:
        return true
    let actionKind = graph.eventHandlers[eventIndex].actionKind
    if actionKind.len == 0 || actionKind == "command":
        return true
    if actionKind != "route" && actionKind != "state_delta" && actionKind != "stop_propagation" && actionKind != "style_mutation" && actionKind != "media_lifecycle":
        return false
    if !WebSceneEventEffectGuardsPassWithKey(graph, graph.eventHandlers[eventIndex].effect, eventKey):
        return true
    return WebSceneApplyEventEffectForNodeWithKey(graph, routeIndex, nodeId, graph.eventHandlers[eventIndex].effect, eventKey, markDirty)

@borrows
fn WebSceneApplyNodePointerEventEffect(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       nodeId: int32,
                                       eventName: str,
                                       xMilli: int32,
                                       yMilli: int32,
                                       markDirty: bool): bool =
    let eventIndex = WebSceneFindEventHandlerForNodeEvent(graph, routeIndex, nodeId, eventName)
    if eventIndex < 0:
        return true
    let actionKind = graph.eventHandlers[eventIndex].actionKind
    if actionKind.len == 0 || actionKind == "command":
        return true
    if actionKind != "route" && actionKind != "state_delta" && actionKind != "stop_propagation" && actionKind != "style_mutation" && actionKind != "media_lifecycle":
        return false
    if !WebSceneEventEffectGuardsPass(graph, graph.eventHandlers[eventIndex].effect):
        return true
    return WebSceneApplyEventEffectForNodeWithPointer(graph, routeIndex, nodeId, graph.eventHandlers[eventIndex].effect, xMilli, yMilli, markDirty)

fn WebSceneClearDirty(graph: var WebSceneGraph) =
    graph.dirtySpans = []

@borrows
fn WebSceneSetActiveRouteById(graph: var WebSceneGraph, routeId: str): bool =
    let routeIndex = WebSceneFindRouteIndex(graph, routeId)
    if routeIndex < 0:
        return false
    return WebSceneSetActiveRouteByIndex(graph, routeIndex)

fn WebSceneSetActiveRouteByIndex(graph: var WebSceneGraph, routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if graph.activeRouteIndex == routeIndex:
        return true
    let previous = graph.activeRouteIndex
    graph.activeRouteIndex = routeIndex
    graph.version = graph.version + 1
    if previous >= 0:
        WebSceneMarkRouteDirty(graph, previous)
    WebSceneMarkRouteDirty(graph, routeIndex)
    return true

fn WebSceneApplyRouteEdge(graph: var WebSceneGraph, nodeId: int32): bool =
    if graph.activeRouteIndex < 0:
        return false
    let sourceRoute = graph.activeRouteIndex
    let target = WebSceneFindRouteTargetForNode(graph, sourceRoute, nodeId)
    if target < 0:
        return false
    let eventIndex = WebSceneFindEventHandlerForNodeEvent(graph, sourceRoute, nodeId, "click")
    if eventIndex >= 0:
        if !WebSceneEventEffectGuardsPass(graph, graph.eventHandlers[eventIndex].effect):
            return true
    # state deltas must always mark dirty: a route-entry toggle (e.g.
    # showSearch=true) changes conditional visibility on the TARGET route,
    # and stale layer caches would otherwise present the pre-toggle frame
    if !WebSceneApplyNodeEventEffect(graph, sourceRoute, nodeId, "click", true):
        return false
    return WebSceneSetActiveRouteByIndex(graph, target)

fn WebSceneMarkRouteDirty(graph: var WebSceneGraph, routeIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if graph.routes[routeIndex].rootNodeIds.len == 0:
        return WebSceneAppendDirty(graph, routeIndex, 0, WebSceneDirtyRoute)
    var ok = true
    for i in 0..<graph.routes[routeIndex].rootNodeIds.len:
        if !WebSceneAppendDirty(graph, routeIndex, graph.routes[routeIndex].rootNodeIds[i], WebSceneDirtyRoute):
            ok = false
    return ok

fn WebSceneMarkDirtySubtree(graph: var WebSceneGraph, nodeId: int32): bool =
    let routeIndex = WebSceneFindNodeRouteIndex(graph, nodeId)
    if routeIndex < 0:
        return false
    let appended = WebSceneAppendDirty(graph, routeIndex, nodeId, WebSceneDirtySubtree)
    if !appended:
        return false
    graph.version = graph.version + 1
    return true

fn WebSceneMarkDirtyLayer(graph: var WebSceneGraph, routeIndex: int32, layerId: int32): bool =
    if WebSceneFindLayerIndex(graph, routeIndex, layerId) < 0:
        return false
    let appended = WebSceneAppendDirtyWithLayer(graph, routeIndex, 0, layerId, WebSceneDirtyLayer)
    if !appended:
        return false
    graph.version = graph.version + 1
    return true

fn WebSceneDirtyRouteAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.dirtySpans.len:
        return -1
    return graph.dirtySpans[index].routeIndex

fn WebSceneDirtyNodeAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.dirtySpans.len:
        return -1
    return graph.dirtySpans[index].nodeId

fn WebSceneDirtyReasonAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.dirtySpans.len:
        return -1
    return graph.dirtySpans[index].reason

fn WebSceneDirtyLayerAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.dirtySpans.len:
        return -1
    return graph.dirtySpans[index].layerId

fn WebSceneAppendDirty(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, reason: int32): bool =
    return WebSceneAppendDirtyWithLayer(graph, routeIndex, nodeId, 0, reason)

fn WebSceneAppendDirtyWithLayer(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, layerId: int32, reason: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    for i in 0..<graph.dirtySpans.len:
        if graph.dirtySpans[i].routeIndex == routeIndex && graph.dirtySpans[i].nodeId == nodeId && graph.dirtySpans[i].layerId == layerId && graph.dirtySpans[i].reason == reason:
            return true
    var span: WebSceneDirtySpan
    span.routeIndex = routeIndex
    span.nodeId = nodeId
    span.layerId = layerId
    span.reason = reason
    span.previousOffsetX = 0
    span.previousOffsetY = 0
    add(graph.dirtySpans, span)
    return true

fn WebSceneAppendDirtyLayerMove(graph: var WebSceneGraph,
                                routeIndex: int32,
                                layerId: int32,
                                previousOffsetX: int32,
                                previousOffsetY: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if WebSceneFindLayerIndex(graph, routeIndex, layerId) < 0:
        return false
    for i in 0..<graph.dirtySpans.len:
        if graph.dirtySpans[i].routeIndex == routeIndex &&
           graph.dirtySpans[i].layerId == layerId &&
           graph.dirtySpans[i].reason == WebSceneDirtyLayerMove:
            return true
    var span: WebSceneDirtySpan
    span.routeIndex = routeIndex
    span.nodeId = 0
    span.layerId = layerId
    span.reason = WebSceneDirtyLayerMove
    span.previousOffsetX = previousOffsetX
    span.previousOffsetY = previousOffsetY
    add(graph.dirtySpans, span)
    return true

