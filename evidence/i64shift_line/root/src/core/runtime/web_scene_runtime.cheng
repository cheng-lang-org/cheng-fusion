        return -1
    return buffer.commands[index].nodeId

fn WebSceneMediaSurfaceXAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.commands.len:
        return 0
    return buffer.commands[index].x

fn WebSceneMediaSurfaceYAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.commands.len:
        return 0
    return buffer.commands[index].y

fn WebSceneMediaSurfaceWidthAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.commands.len:
        return 0
    return buffer.commands[index].width

fn WebSceneMediaSurfaceHeightAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.commands.len:
        return 0
    return buffer.commands[index].height

fn WebSceneMediaSurfacePlaybackStateAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): int32 =
    if index < 0 || index >= buffer.commands.len:
        return -1
    return buffer.commands[index].playbackState

fn WebSceneMediaSurfaceSurfaceKindAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): str =
    if index < 0 || index >= buffer.commands.len:
        return ""
    return buffer.commands[index].surfaceKind

fn WebSceneMediaSurfaceTextureProviderAt(buffer: var WebSceneMediaSurfaceCommandBuffer, index: int32): str =
    if index < 0 || index >= buffer.commands.len:
