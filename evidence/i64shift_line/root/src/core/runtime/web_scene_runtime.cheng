@borrows
fn WebSceneMediaSurfaceKindHostCode(surfaceKind: str): int32 =
    if surfaceKind == "video-first-frame-texture":
        return WebSceneMediaSurfaceKindVideoFirstFrameTexture
    if surfaceKind == "image-raster-texture":
        return WebSceneMediaSurfaceKindImageRasterTexture
    if surfaceKind == "audio-cover-texture":
        return WebSceneMediaSurfaceKindAudioCoverTexture
    return -1

@borrows
fn WebSceneMediaSurfaceTextureProviderHostCode(textureProvider: str): int32 =
    if textureProvider == "metal-surface-texture-provider":
        return WebSceneMediaTextureProviderMetalSurface
    if textureProvider == "surface-texture-provider":
        return WebSceneMediaTextureProviderSurface
    return -1

@borrows
fn WebSceneMediaSurfaceObjectFitHostCode(objectFit: str): int32 =
    if objectFit == "cover":
        return WebSceneMediaObjectFitCover
    if objectFit == "contain":
        return WebSceneMediaObjectFitContain
    if objectFit == "fill":
        return WebSceneMediaObjectFitFill
    return -1

@borrows
fn WebSceneMediaSurfaceCommandHostFieldsValid(command: WebSceneMediaSurfaceCommand): bool =
    if command.kindCode < 1 || command.kindCode > 3:
        return false
    let surfaceKindCode = WebSceneMediaSurfaceKindHostCode(command.surfaceKind)
    if surfaceKindCode <= 0 || surfaceKindCode != command.kindCode:
        return false
    if WebSceneMediaSurfaceTextureProviderHostCode(command.textureProvider) <= 0:
        return false
    if WebSceneMediaSurfaceObjectFitHostCode(command.objectFit) <= 0:
        return false
    if command.routeIndex < 0 || command.layerId <= 0 || command.nodeId <= 0:
        return false
    if command.x < 0 || command.y < 0 || command.width <= 0 || command.height <= 0:
        return false
    if command.playbackState < WebSceneMediaPlaybackClosed || command.playbackState > WebSceneMediaPlaybackPublished:
        return false
    if WebSceneResourceIdHash31(command.slotId) <= 0:
        return false
    if WebSceneResourceIdHash31(command.assetCid) <= 0:
        return false
    if WebSceneResourceIdHash31(command.manifestCid) <= 0:
        return false
    if WebSceneResourceIdHash31(command.posterCid) <= 0:
        return false
    return true

fn WebSceneEncodeMediaSurfaceCommandHostBatch(buffer: var WebSceneMediaSurfaceCommandBuffer,
                                              words: var int32[]): bool =
    words = []
    for i in 0..<buffer.commands.len:
        let command = buffer.commands[i]
        if !WebSceneMediaSurfaceCommandHostFieldsValid(command):
            return false
        add(words, command.kindCode)
        add(words, WebSceneMediaSurfaceKindHostCode(command.surfaceKind))
        add(words, WebSceneMediaSurfaceTextureProviderHostCode(command.textureProvider))
        add(words, command.routeIndex)
        add(words, command.layerId)
        add(words, command.nodeId)
        add(words, command.x)
        add(words, command.y)
        add(words, command.width)
        add(words, command.height)
        add(words, command.playbackState)
        add(words, WebSceneMediaSurfaceObjectFitHostCode(command.objectFit))
        add(words, WebSceneResourceIdHash31(command.slotId))
        add(words, WebSceneResourceIdHash31(command.assetCid))
        add(words, WebSceneResourceIdHash31(command.manifestCid))
        add(words, WebSceneResourceIdHash31(command.posterCid))
    if words.len == buffer.commands.len * WebSceneMediaSurfaceHostStrideI32:
        return true
    return false

# Packs one int32 as 4 little-endian bytes at bytes[byteOffset..byteOffset+3].
# Mirrors the generator-side __csg_scene_pack_i32 byte order exactly so the
# produced word stream is unchanged for host consumers.
fn WebSceneHostBatchPackI32(bytes: var rawbytes.Bytes, byteOffset: int32, value: int32) =
    rawbytes.BytesSet(bytes, byteOffset, value & 255)
    rawbytes.BytesSet(bytes, byteOffset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(bytes, byteOffset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(bytes, byteOffset + 3, (value >> 24) & 255)

# Validates every media surface command without materializing a host batch.
# Lets callers that only need the field-validity gate (texture preparation)
# skip encoding entirely.
fn WebSceneMediaSurfaceCommandBufferAllValid(buffer: var WebSceneMediaSurfaceCommandBuffer): bool =
    for i in 0..<buffer.commands.len:
        if !WebSceneMediaSurfaceCommandHostFieldsValid(buffer.commands[i]):
            return false
    return true

# Byte-direct sibling of WebSceneEncodeMediaSurfaceCommandHostBatch: writes
# straight into a caller-sized rawbytes.Bytes instead of growing an int32[]
# that the caller must then repack. bytes must already be sized to
# buffer.commands.len * WebSceneMediaSurfaceHostStrideI32 * 4 bytes.
fn WebSceneEncodeMediaSurfaceCommandHostBatchBytes(buffer: var WebSceneMediaSurfaceCommandBuffer,
                                                    bytes: var rawbytes.Bytes): bool =
    let expectedBytes = buffer.commands.len * WebSceneMediaSurfaceHostStrideI32 * 4
    if rawbytes.BytesLen(bytes) != expectedBytes:
        return false
    for i in 0..<buffer.commands.len:
        let command = buffer.commands[i]
        if !WebSceneMediaSurfaceCommandHostFieldsValid(command):
            return false
        let base = i * WebSceneMediaSurfaceHostStrideI32 * 4
        WebSceneHostBatchPackI32(bytes, base, command.kindCode)
        WebSceneHostBatchPackI32(bytes, base + 4, WebSceneMediaSurfaceKindHostCode(command.surfaceKind))
        WebSceneHostBatchPackI32(bytes, base + 8, WebSceneMediaSurfaceTextureProviderHostCode(command.textureProvider))
        WebSceneHostBatchPackI32(bytes, base + 12, command.routeIndex)
        WebSceneHostBatchPackI32(bytes, base + 16, command.layerId)
        WebSceneHostBatchPackI32(bytes, base + 20, command.nodeId)
        WebSceneHostBatchPackI32(bytes, base + 24, command.x)
        WebSceneHostBatchPackI32(bytes, base + 28, command.y)
        WebSceneHostBatchPackI32(bytes, base + 32, command.width)
        WebSceneHostBatchPackI32(bytes, base + 36, command.height)
        WebSceneHostBatchPackI32(bytes, base + 40, command.playbackState)
        WebSceneHostBatchPackI32(bytes, base + 44, WebSceneMediaSurfaceObjectFitHostCode(command.objectFit))
        WebSceneHostBatchPackI32(bytes, base + 48, WebSceneResourceIdHash31(command.slotId))
        WebSceneHostBatchPackI32(bytes, base + 52, WebSceneResourceIdHash31(command.assetCid))
        WebSceneHostBatchPackI32(bytes, base + 56, WebSceneResourceIdHash31(command.manifestCid))
        WebSceneHostBatchPackI32(bytes, base + 60, WebSceneResourceIdHash31(command.posterCid))
    return true

fn WebSceneFindCssVariantRuleIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, ordinal: int32): int32 =
    for i in 0..<graph.cssVariantRules.len:
        if graph.cssVariantRules[i].routeIndex == routeIndex && graph.cssVariantRules[i].nodeId == nodeId && graph.cssVariantRules[i].ordinal == ordinal:
            return i
    return -1

fn WebSceneAddCssVariantRule(graph: var WebSceneGraph,
                             routeIndex: int32,
                             nodeId: int32,
                             ordinal: int32,
                             className: str,
                             selectorText: str,
                             specificity: str,
                             ruleOrder: int32): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if ordinal < 0 || ruleOrder < 0:
        return false
    if className.len == 0 || selectorText.len == 0:
        return false
    if WebSceneFindCssVariantRuleIndex(graph, routeIndex, nodeId, ordinal) >= 0:
        return false
    var rule: WebSceneCssVariantRule
    rule.routeIndex = routeIndex
    rule.nodeId = nodeId
    rule.ordinal = ordinal
    rule.className = className
    rule.selectorText = selectorText
    rule.specificity = specificity
    rule.ruleOrder = ruleOrder
    add(graph.cssVariantRules, rule)
    return true

fn WebSceneFindCssVariantConditionIndex(graph: var WebSceneGraph,
                                        routeIndex: int32,
                                        nodeId: int32,
                                        ruleOrdinal: int32,
                                        ordinal: int32): int32 =
    for i in 0..<graph.cssVariantConditions.len:
        if graph.cssVariantConditions[i].routeIndex == routeIndex &&
           graph.cssVariantConditions[i].nodeId == nodeId &&
           graph.cssVariantConditions[i].ruleOrdinal == ruleOrdinal &&
           graph.cssVariantConditions[i].ordinal == ordinal:
            return i
    return -1

@borrows
fn WebSceneAddCssVariantCondition(graph: var WebSceneGraph,
                                  routeIndex: int32,
                                  nodeId: int32,
                                  ruleOrdinal: int32,
                                  ordinal: int32,
                                  variantKind: str,
                                  variantName: str,
                                  attributeName: str,
                                  attributeValue: str): bool =
    return WebSceneAddCssVariantConditionFull(graph,
                                              routeIndex,
                                              nodeId,
                                              ruleOrdinal,
                                              ordinal,
                                              variantKind,
                                              variantName,
                                              attributeName,
                                              attributeValue,
                                              "",
                                              "")

@borrows
fn WebSceneAddCssVariantConditionFull(graph: var WebSceneGraph,
                                      routeIndex: int32,
                                      nodeId: int32,
                                      ruleOrdinal: int32,
                                      ordinal: int32,
                                      variantKind: str,
                                      variantName: str,
                                      attributeName: str,
                                      attributeValue: str,
                                      modifier: str,
                                      selector: str): bool =
    if WebSceneFindCssVariantRuleIndex(graph, routeIndex, nodeId, ruleOrdinal) < 0:
        return false
    if ordinal < 0:
        return false
    if variantKind.len == 0:
        return false
    if WebSceneFindCssVariantConditionIndex(graph, routeIndex, nodeId, ruleOrdinal, ordinal) >= 0:
        return false
    var condition: WebSceneCssVariantCondition
    condition.routeIndex = routeIndex
    condition.nodeId = nodeId
    condition.ruleOrdinal = ruleOrdinal
    condition.ordinal = ordinal
    # Borrowed inputs are cloned into owned values at the managed store sites.
    condition.variantKind = strings.CloneStr(variantKind)
    condition.variantName = strings.CloneStr(variantName)
    condition.attributeName = strings.CloneStr(attributeName)
    condition.attributeValue = strings.CloneStr(attributeValue)
    condition.modifier = strings.CloneStr(modifier)
    condition.selector = strings.CloneStr(selector)
    add(graph.cssVariantConditions, condition)
    return true

fn WebSceneFindCssDeclarationIndex(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   nodeId: int32,
                                   ruleOrdinal: int32,
                                   ordinal: int32): int32 =
    for i in 0..<graph.cssDeclarations.len:
        if graph.cssDeclarations[i].routeIndex == routeIndex &&
           graph.cssDeclarations[i].nodeId == nodeId &&
           graph.cssDeclarations[i].ruleOrdinal == ruleOrdinal &&
           graph.cssDeclarations[i].ordinal == ordinal:
            return i
    return -1

@borrows
fn WebSceneFindLatestStaticCssDeclarationIndex(graph: var WebSceneGraph,
                                               routeIndex: int32,
                                               nodeId: int32,
                                               propertyName: str): int32 =
    var bestIndex = -1
    for i in 0..<graph.cssDeclarations.len:
        if graph.cssDeclarations[i].routeIndex == routeIndex &&
           graph.cssDeclarations[i].nodeId == nodeId &&
           graph.cssDeclarations[i].ruleOrdinal < 0 &&
           graph.cssDeclarations[i].propertyName == propertyName:
            if bestIndex < 0 || graph.cssDeclarations[i].ordinal >= graph.cssDeclarations[bestIndex].ordinal:
                bestIndex = i
    return bestIndex

@borrows
fn WebSceneSetLatestStaticCssDeclarationValue(graph: var WebSceneGraph,
                                              routeIndex: int32,
                                              nodeId: int32,
                                              propertyName: str,
                                              propertyValue: str): int32 =
    if propertyName.len == 0 || propertyValue.len == 0:
        return -1
    let declarationIndex = WebSceneFindLatestStaticCssDeclarationIndex(graph, routeIndex, nodeId, propertyName)
    if declarationIndex < 0:
        return -1
    if graph.cssDeclarations[declarationIndex].propertyValue == propertyValue:
        return 0
    graph.cssDeclarations[declarationIndex].propertyValue = WebSceneCloneStateString(propertyValue)
    return 1

fn WebSceneAddCssDeclaration(graph: var WebSceneGraph,
                             routeIndex: int32,
                             nodeId: int32,
                             ruleOrdinal: int32,
                             ordinal: int32,
                             propertyName: str,
                             propertyValue: str,
                             important: bool): bool =
    if WebSceneFindCssVariantRuleIndex(graph, routeIndex, nodeId, ruleOrdinal) < 0:
        return false
    if ordinal < 0:
        return false
    if propertyName.len == 0 || propertyValue.len == 0:
        return false
    if WebSceneFindCssDeclarationIndex(graph, routeIndex, nodeId, ruleOrdinal, ordinal) >= 0:
        return false
    var declaration: WebSceneCssDeclaration
    declaration.routeIndex = routeIndex
    declaration.nodeId = nodeId
    declaration.ruleOrdinal = ruleOrdinal
    declaration.ordinal = ordinal
    declaration.propertyName = propertyName
    declaration.propertyValue = propertyValue
    declaration.important = important
    add(graph.cssDeclarations, declaration)
    return true

fn WebSceneAddStaticCssDeclaration(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   nodeId: int32,
                                   ordinal: int32,
                                   propertyName: str,
                                   propertyValue: str,
                                   important: bool): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if ordinal < 0:
        return false
    if propertyName.len == 0 || propertyValue.len == 0:
        return false
    if WebSceneFindCssDeclarationIndex(graph, routeIndex, nodeId, -1, ordinal) >= 0:
        return false
    var declaration: WebSceneCssDeclaration
    declaration.routeIndex = routeIndex
    declaration.nodeId = nodeId
    declaration.ruleOrdinal = -1
    declaration.ordinal = ordinal
    declaration.propertyName = propertyName
    declaration.propertyValue = propertyValue
    declaration.important = important
    add(graph.cssDeclarations, declaration)
    return true

fn WebSceneAddStaticCssDeclarationKnownLoadedNode(graph: var WebSceneGraph,
                                                  routeIndex: int32,
                                                  nodeId: int32,
                                                  ordinal: int32,
                                                  propertyName: str,
                                                  propertyValue: str,
                                                  important: bool): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if nodeId <= 0 || ordinal < 0:
        return false
    if propertyName.len == 0 || propertyValue.len == 0:
        return false
    var declaration: WebSceneCssDeclaration
    declaration.routeIndex = routeIndex
    declaration.nodeId = nodeId
    declaration.ruleOrdinal = -1
    declaration.ordinal = ordinal
    declaration.propertyName = propertyName
    declaration.propertyValue = propertyValue
    declaration.important = important
    add(graph.cssDeclarations, declaration)
    return true

fn WebSceneFindNodeStateIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    for i in 0..<graph.nodeStates.len:
        if graph.nodeStates[i].routeIndex == routeIndex && graph.nodeStates[i].nodeId == nodeId:
            return i
    return -1

fn WebSceneEnsureNodeStateIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, outIndex: var int32): bool =
    outIndex = WebSceneFindNodeStateIndex(graph, routeIndex, nodeId)
    if outIndex >= 0:
        return true
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    var stateItem: WebSceneNodeState
    stateItem.routeIndex = routeIndex
    stateItem.nodeId = nodeId
    stateItem.hover = false
    stateItem.active = false
    stateItem.focus = false
    stateItem.pointerEventsSet = false
    stateItem.pointerEventsNone = false
    add(graph.nodeStates, stateItem)
    outIndex = graph.nodeStates.len - 1
    return true

fn WebSceneSetNodeInteractionState(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   nodeId: int32,
                                   hover: bool,
                                   active: bool,
                                   focus: bool): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    let index = WebSceneFindNodeStateIndex(graph, routeIndex, nodeId)
    if index >= 0:
        graph.nodeStates[index].hover = hover
        graph.nodeStates[index].active = active
        graph.nodeStates[index].focus = focus
    else:
        var ensuredIndex: int32
        if !WebSceneEnsureNodeStateIndex(graph, routeIndex, nodeId, ensuredIndex):
            return false
        graph.nodeStates[ensuredIndex].hover = hover
        graph.nodeStates[ensuredIndex].active = active
        graph.nodeStates[ensuredIndex].focus = focus
    graph.version = graph.version + 1
    return WebSceneMarkDirtySubtree(graph, nodeId)

@borrows
fn WebSceneAddLayoutConstraint(graph: var WebSceneGraph,
                               routeIndex: int32,
                               nodeId: int32,
                               ordinal: int32,
                               propName: str,
                               propValue: str): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if ordinal < 0:
        return false
    if propName.len == 0:
        return false
    if WebSceneFindLayoutConstraintIndex(graph, routeIndex, nodeId, ordinal) >= 0:
        return false
    var constraint: WebSceneLayoutConstraint
    constraint.routeIndex = routeIndex
    constraint.nodeId = nodeId
    constraint.ordinal = ordinal
    constraint.propName = WebSceneCloneStateString(propName)
    constraint.propValue = WebSceneCloneStateString(propValue)
    add(graph.layoutConstraints, constraint)
    if propName == "display" && propValue == "none":
        if !WebSceneMarkNodeDisplayNoneLookup(graph, nodeId):
            return false
    return true

@borrows
fn WebSceneFindLatestLayoutConstraintIndexForProp(graph: var WebSceneGraph,
                                                  routeIndex: int32,
                                                  nodeId: int32,
                                                  propName: str): int32 =
    var bestIndex = -1
    var bestOrdinal = -1
    for i in 0..<graph.layoutConstraints.len:
        if graph.layoutConstraints[i].routeIndex == routeIndex &&
           graph.layoutConstraints[i].nodeId == nodeId &&
           graph.layoutConstraints[i].propName == propName:
            if graph.layoutConstraints[i].ordinal >= bestOrdinal:
                bestOrdinal = graph.layoutConstraints[i].ordinal
                bestIndex = i
    return bestIndex

fn WebSceneNextLayoutConstraintOrdinalForNode(graph: var WebSceneGraph,
                                              routeIndex: int32,
                                              nodeId: int32): int32 =
    var nextOrdinal: int32
    for i in 0..<graph.layoutConstraints.len:
        if graph.layoutConstraints[i].routeIndex == routeIndex &&
           graph.layoutConstraints[i].nodeId == nodeId &&
           graph.layoutConstraints[i].ordinal >= nextOrdinal:
            nextOrdinal = graph.layoutConstraints[i].ordinal + 1
    return nextOrdinal

@borrows
fn WebSceneSetOrAddLayoutConstraintValue(graph: var WebSceneGraph,
                                         routeIndex: int32,
                                         nodeId: int32,
                                         propName: str,
                                         propValue: str): int32 =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return -1
    if propName.len == 0:
        return -1
    let existingIndex = WebSceneFindLatestLayoutConstraintIndexForProp(graph, routeIndex, nodeId, propName)
    if existingIndex >= 0:
        if graph.layoutConstraints[existingIndex].propValue == propValue:
            return 0
        graph.layoutConstraints[existingIndex].propValue = WebSceneCloneStateString(propValue)
        if propName == "display" && propValue == "none":
            if !WebSceneMarkNodeDisplayNoneLookup(graph, nodeId):
                return -1
        return 1
    let ordinal = WebSceneNextLayoutConstraintOrdinalForNode(graph, routeIndex, nodeId)
    if !WebSceneAddLayoutConstraint(graph, routeIndex, nodeId, ordinal, propName, propValue):
        return -1
    return 1

@borrows
fn WebSceneAddLayoutConstraintKnownUnique(graph: var WebSceneGraph,
                                          routeIndex: int32,
                                          nodeId: int32,
                                          ordinal: int32,
                                          propName: str,
                                          propValue: str): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if ordinal < 0:
        return false
    if propName.len == 0:
        return false
    var constraint: WebSceneLayoutConstraint
    constraint.routeIndex = routeIndex
    constraint.nodeId = nodeId
    constraint.ordinal = ordinal
    constraint.propName = WebSceneCloneStateString(propName)
    constraint.propValue = WebSceneCloneStateString(propValue)
    add(graph.layoutConstraints, constraint)
    if propName == "display" && propValue == "none":
        if !WebSceneMarkNodeDisplayNoneLookup(graph, nodeId):
            return false
    return true

# Read-only on propName/propValue (stores go through WebSceneCloneStateString):
# upgrade so @borrows wrappers bind without cloning (sibling
# WebSceneAddLayoutConstraint already carries the annotation).
@borrows
fn WebSceneAddLayoutConstraintKnownLoadedNode(graph: var WebSceneGraph,
                                              routeIndex: int32,
                                              nodeId: int32,
                                              ordinal: int32,
                                              propName: str,
                                              propValue: str): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if nodeId <= 0 || ordinal < 0:
        return false
    if propName.len == 0:
        return false
    var constraint: WebSceneLayoutConstraint
    constraint.routeIndex = routeIndex
    constraint.nodeId = nodeId
    constraint.ordinal = ordinal
    constraint.propName = WebSceneCloneStateString(propName)
    constraint.propValue = WebSceneCloneStateString(propValue)
    add(graph.layoutConstraints, constraint)
    if propName == "display" && propValue == "none":
        if !WebSceneMarkNodeDisplayNoneLookup(graph, nodeId):
            return false
    return true

@borrows
fn WebSceneAddPaintOp(graph: var WebSceneGraph,
                      routeIndex: int32,
                      nodeId: int32,
                      ordinal: int32,
                      opKind: int32,
                      color: int64,
                      radius: int32,
                      width: int32,
                      height: int32,
                      resourceId: str,
                      textContent: str): bool =
    return WebSceneAddPaintOpAt(graph, routeIndex, nodeId, ordinal, 0, 0, opKind, color, radius, width, height, resourceId, textContent)

@borrows
fn WebSceneAddPaintOpAt(graph: var WebSceneGraph,
                        routeIndex: int32,
                        nodeId: int32,
                        ordinal: int32,
                        x: int32,
                        y: int32,
                        opKind: int32,
                        color: int64,
                        radius: int32,
                        width: int32,
                        height: int32,
                        resourceId: str,
                        textContent: str): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if ordinal < 0:
        return false
    if !WebScenePaintKindSupported(opKind):
        return false
    if radius < 0 || width < 0 || height < 0:
        return false
    if opKind == WebScenePaintSvgIcon && resourceId.len == 0:
        return false
    if opKind == WebScenePaintImage && resourceId.len == 0:
        return false
    if WebSceneFindPaintOpIndex(graph, routeIndex, nodeId, ordinal) >= 0:
        return false
    var op: WebScenePaintOp
    op.routeIndex = routeIndex
    op.nodeId = nodeId
    op.ordinal = ordinal
    op.x = x
    op.y = y
    op.baseX = x
    op.baseY = y
    op.opKind = opKind
    op.color = color
    op.baseColor = color
    op.opacity = 255
    op.baseOpacity = 255
    op.radius = radius
    op.baseRadius = radius
    op.width = width
    op.height = height
    op.baseWidth = width
    op.baseHeight = height
    op.fontSize = 0
    op.fontWeight = 0
    op.fontFamily = 0
    op.shadowOffsetX = 0
    op.shadowOffsetY = 0
    op.shadowBlur = 0
    op.shadowSpread = 0
    op.shadowInset = false
    op.gradientEndColor = int64(0)
    op.gradientAngle = 0
    op.rotationDeg = 0
    # Borrowed inputs are cloned into owned values at the managed store sites.
    op.resourceId = strings.CloneStr(resourceId)
    op.textContent = strings.CloneStr(textContent)
    add(graph.paintOps, op)
    graph.paintOpRangeIndexSynced = false
    return true

