fn WebSceneResetRangeIndex(values: var int32[], count: int32): bool =
    if count < 0:
        return false
    setLen(values, count)
    for i in 0..<values.len:
        values[i] = -1
    return true

fn WebSceneIndexPaintOpRanges(source: var WebScenePaintOp[],
                              startByNodeId: var int32[],
                              endByNodeId: var int32[]): bool =
    for i in 0..<source.len:
        let nodeId = source[i].nodeId
        if nodeId <= 0 || nodeId >= startByNodeId.len || nodeId >= endByNodeId.len:
            return false
        if startByNodeId[nodeId] < 0:
            startByNodeId[nodeId] = i
            endByNodeId[nodeId] = i + 1
        elif endByNodeId[nodeId] == i:
            endByNodeId[nodeId] = i + 1
        else:
            return false
    return true

fn WebSceneIndexSvgPrimitiveRanges(source: var WebScenePaintSvgPrimitive[],
                                   startByNodeId: var int32[],
                                   endByNodeId: var int32[]): bool =
    for i in 0..<source.len:
        let nodeId = source[i].nodeId
        if nodeId <= 0 || nodeId >= startByNodeId.len || nodeId >= endByNodeId.len:
            return false
        if startByNodeId[nodeId] < 0:
            startByNodeId[nodeId] = i
            endByNodeId[nodeId] = i + 1
        elif endByNodeId[nodeId] == i:
            endByNodeId[nodeId] = i + 1
        else:
            return false
    return true

fn WebSceneRebuildPaintOpRangeIndex(graph: var WebSceneGraph): bool =
    let nodeCapacity = graph.nodeIndexById.len
    if graph.paintOpRangeIndexSynced &&
       graph.paintOpStartByNodeId.len == nodeCapacity &&
       graph.paintOpEndByNodeId.len == nodeCapacity:
        return true
    if !WebSceneResetRangeIndex(graph.paintOpStartByNodeId, nodeCapacity):
        return false
    if !WebSceneResetRangeIndex(graph.paintOpEndByNodeId, nodeCapacity):
        return false
    if !WebSceneIndexPaintOpRanges(graph.paintOps, graph.paintOpStartByNodeId, graph.paintOpEndByNodeId):
        return false
    graph.paintOpRangeIndexSynced = true
    return true

fn WebSceneRebuildPaintCommandRangeIndexes(graph: var WebSceneGraph): bool =
    let nodeCapacity = graph.nodeIndexById.len
    if !WebSceneRebuildPaintOpRangeIndex(graph):
        return false
    if !WebSceneResetRangeIndex(graph.paintShadowStartByNodeId, nodeCapacity):
        return false
    if !WebSceneResetRangeIndex(graph.paintShadowEndByNodeId, nodeCapacity):
        return false
    if !WebSceneResetRangeIndex(graph.paintGradientStartByNodeId, nodeCapacity):
        return false
    if !WebSceneResetRangeIndex(graph.paintGradientEndByNodeId, nodeCapacity):
        return false
    if !WebSceneIndexPaintOpRanges(graph.paintShadows, graph.paintShadowStartByNodeId, graph.paintShadowEndByNodeId):
        return false
    if !WebSceneIndexPaintOpRanges(graph.paintGradients, graph.paintGradientStartByNodeId, graph.paintGradientEndByNodeId):
        return false
    if !WebSceneResetRangeIndex(graph.paintSvgPrimitiveStartByNodeId, nodeCapacity):
        return false
    if !WebSceneResetRangeIndex(graph.paintSvgPrimitiveEndByNodeId, nodeCapacity):
        return false
    if !WebSceneIndexSvgPrimitiveRanges(graph.paintSvgPrimitives, graph.paintSvgPrimitiveStartByNodeId, graph.paintSvgPrimitiveEndByNodeId):
        return false
    return true

fn WebSceneAppendGradientPaintCommandsForNode(graph: var WebSceneGraph,
                                              routeIndex: int32,
                                              layerId: int32,
                                              subtreeRootNodeId: int32,
                                              nodeId: int32,
                                              ops: var paint.PaintOp[]): bool =
    if nodeId <= 0 || nodeId >= graph.paintGradientStartByNodeId.len || nodeId >= graph.paintGradientEndByNodeId.len:
        return false
    let startIndex = graph.paintGradientStartByNodeId[nodeId]
    if startIndex < 0:
        return true
    let endIndex = graph.paintGradientEndByNodeId[nodeId]
    if endIndex < startIndex || endIndex > graph.paintGradients.len:
        return false
    for i in startIndex..<endIndex:
        let sceneOp = graph.paintGradients[i]
        if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
            continue
        let nodeLayerId = WebSceneFindNodeLayerId(graph, sceneOp.nodeId)
        if nodeLayerId < 0:
            return false
        if layerId > 0 && nodeLayerId != layerId:
            continue
        if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, sceneOp.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, sceneOp.nodeId):
            continue
        if !WebSceneAppendPaintCommand(graph, sceneOp, ops):
            return false
    return true

fn WebSceneAppendShadowPaintCommandsForNode(graph: var WebSceneGraph,
                                            routeIndex: int32,
                                            layerId: int32,
                                            subtreeRootNodeId: int32,
                                            nodeId: int32,
                                            ops: var paint.PaintOp[]): bool =
    if nodeId <= 0 || nodeId >= graph.paintShadowStartByNodeId.len || nodeId >= graph.paintShadowEndByNodeId.len:
        return false
    let startIndex = graph.paintShadowStartByNodeId[nodeId]
    if startIndex < 0:
        return true
    let endIndex = graph.paintShadowEndByNodeId[nodeId]
    if endIndex < startIndex || endIndex > graph.paintShadows.len:
        return false
    for i in startIndex..<endIndex:
        let sceneOp = graph.paintShadows[i]
        if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
            continue
        let nodeLayerId = WebSceneFindNodeLayerId(graph, sceneOp.nodeId)
        if nodeLayerId < 0:
            return false
        if layerId > 0 && nodeLayerId != layerId:
            continue
        if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, sceneOp.nodeId):
            continue
        if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, sceneOp.nodeId):
            continue
        if !WebSceneAppendPaintCommand(graph, sceneOp, ops):
            return false
    return true

fn WebSceneAppendNodePaintCommands(graph: var WebSceneGraph,
                                   routeIndex: int32,
                                   layerId: int32,
                                   subtreeRootNodeId: int32,
                                   nodeId: int32,
                                   ops: var paint.PaintOp[]): bool =
    let nodeLayerId = WebSceneFindNodeLayerId(graph, nodeId)
    if nodeLayerId < 0:
        return false
    if layerId > 0 && nodeLayerId != layerId:
        return true
    if subtreeRootNodeId > 0 && !WebSceneNodeInSubtree(graph, subtreeRootNodeId, nodeId):
        return true
    if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, nodeId):
        return true
    if nodeId <= 0 || nodeId >= graph.paintOpStartByNodeId.len || nodeId >= graph.paintOpEndByNodeId.len:
        return false
    if !WebSceneAppendShadowPaintCommandsForNode(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, ops):
        return false
    var backgroundAppended = false
    let startIndex = graph.paintOpStartByNodeId[nodeId]
    let endIndex = graph.paintOpEndByNodeId[nodeId]
    if startIndex >= 0 && (endIndex < startIndex || endIndex > graph.paintOps.len):
        return false
    if startIndex >= 0:
        for i in startIndex..<endIndex:
            let sceneOp = graph.paintOps[i]
            if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
                continue
            if sceneOp.opKind != WebScenePaintFill:
                continue
            if !WebSceneAppendPaintCommand(graph, sceneOp, ops):
                return false
            if !WebSceneAppendGradientPaintCommandsForNode(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, ops):
                return false
            backgroundAppended = true
    if !backgroundAppended:
        if !WebSceneAppendGradientPaintCommandsForNode(graph, routeIndex, layerId, subtreeRootNodeId, nodeId, ops):
            return false
    if startIndex >= 0:
        for i in startIndex..<endIndex:
            let sceneOp = graph.paintOps[i]
            if sceneOp.routeIndex != routeIndex || sceneOp.nodeId != nodeId:
                continue
            if sceneOp.opKind == WebScenePaintFill:
                continue
            if !WebSceneAppendPaintCommand(graph, sceneOp, ops):
                return false
    return true


@borrows
fn WebSceneAppendPaintCommand(graph: var WebSceneGraph, sceneOp: WebScenePaintOp, ops: var paint.PaintOp[]): bool =
    if sceneOp.opKind == WebScenePaintTextColor:
        return true
    if !WebScenePaintOpRuntimeVisible(graph, sceneOp):
        return true
    let color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.color, sceneOp.opacity))
    if sceneOp.opKind == WebScenePaintFill:
        var fillOp = paint.PaintOpMakeFillRect(sceneOp.x, sceneOp.y, sceneOp.width, sceneOp.height, color)
        fillOp.borderRadius = sceneOp.radius
        fillOp.borderTopLeftRadius = sceneOp.radius
        fillOp.borderTopRightRadius = sceneOp.radius
        fillOp.borderBottomRightRadius = sceneOp.radius
        fillOp.borderBottomLeftRadius = sceneOp.radius
        paint.PaintOpAppend(ops, fillOp)
        return true
    if sceneOp.opKind == WebScenePaintBorder:
        paint.PaintOpAppend(ops, paint.PaintOpMakeStrokeRect(sceneOp.x, sceneOp.y, sceneOp.width, sceneOp.height, color, 1, sceneOp.radius))
        return true
    if sceneOp.opKind == WebScenePaintBoxShadow:
        var shadowOp = paint.PaintOpMakeBoxShadow(sceneOp.x,
                                                  sceneOp.y,
                                                  sceneOp.width,
                                                  sceneOp.height,
                                                  sceneOp.shadowOffsetX,
                                                  sceneOp.shadowOffsetY,
                                                  sceneOp.shadowBlur,
                                                  sceneOp.shadowSpread,
                                                  color,
                                                  sceneOp.shadowInset)
        shadowOp.borderRadius = sceneOp.radius
        paint.PaintOpAppend(ops, shadowOp)
        return true
    if sceneOp.opKind == WebScenePaintGradientFill:
        var stops: paint.PaintGradientStop[]
        var startStop: paint.PaintGradientStop
        startStop.color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.color, sceneOp.opacity))
        startStop.position = 0
        add(stops, startStop)
        var endStop: paint.PaintGradientStop
        endStop.color = WebSceneColorInt32(WebSceneApplyOpacityToColor(sceneOp.gradientEndColor, sceneOp.opacity))
        endStop.position = 1000
        add(stops, endStop)
        var gradientOp = paint.PaintOpMakeGradientFill(sceneOp.x,
                                                       sceneOp.y,
                                                       sceneOp.width,
                                                       sceneOp.height,
                                                       stops,
                                                       sceneOp.gradientAngle,
                                                       1)
        gradientOp.borderRadius = sceneOp.radius
        # Carry radial gradient kind + center/radius (permille) through the unused
        # shadow fields so the compositor command path can encode them.
        gradientOp.shadowOffsetX = sceneOp.shadowOffsetX
        gradientOp.shadowOffsetY = sceneOp.shadowOffsetY
        gradientOp.shadowBlur = sceneOp.shadowBlur
        gradientOp.shadowSpread = sceneOp.shadowSpread
        paint.PaintOpAppend(ops, gradientOp)
        return true
    if sceneOp.opKind == WebScenePaintSvgCirclePattern:
        let tileWidth = sceneOp.shadowOffsetX
        let tileHeight = sceneOp.shadowOffsetY
        let circleCx = sceneOp.shadowBlur
        let circleCy = sceneOp.shadowSpread
        let circleRadius = sceneOp.radius
        if tileWidth <= 0 || tileHeight <= 0 || circleCx < 0 || circleCy < 0 || circleRadius <= 0:
            return false
        let dotSize = circleRadius * 2
        var y = sceneOp.y + circleCy
        let maxY = sceneOp.y + sceneOp.height
        let maxX = sceneOp.x + sceneOp.width
        while y < maxY:
            var x = sceneOp.x + circleCx
            while x < maxX:
                var dotOp = paint.PaintOpMakeFillRect(x - circleRadius, y - circleRadius, dotSize, dotSize, color)
                dotOp.borderRadius = circleRadius
                paint.PaintOpAppend(ops, dotOp)
                x = x + tileWidth
            y = y + tileHeight
        return true
    if WebScenePaintKindIsText(sceneOp.opKind):
        var fontSize = sceneOp.fontSize
        if fontSize <= 0:
            fontSize = 16
        var textOp = paint.PaintOpMakeFillText(sceneOp.x, sceneOp.y, sceneOp.textContent, fontSize / 2, fontSize, fontSize, color)
        if sceneOp.width > 0:
            textOp.rect.width = sceneOp.width
            textOp.rect.widthPx2 = sceneOp.width * 2
            textOp.text.alignX = sceneOp.x
            textOp.text.alignWidth = sceneOp.width
        if sceneOp.height > 0:
            textOp.rect.height = sceneOp.height
            textOp.rect.heightPx2 = sceneOp.height * 2
        paint.PaintOpAppend(ops, textOp)
        return true
    if sceneOp.opKind == WebScenePaintSvgIcon:
        let iconKind = WebScenePaintIconKindForResource(sceneOp.resourceId)
        let primitiveCount = WebScenePaintSvgPrimitiveCount(graph, sceneOp.routeIndex, sceneOp.nodeId, sceneOp.ordinal)
        if iconKind <= 0 && primitiveCount <= 0:
            return false
        var size = sceneOp.width
        if sceneOp.height > size:
            size = sceneOp.height
        var iconOp = paint.PaintOpMakeIcon(sceneOp.x, sceneOp.y, sceneOp.width, sceneOp.height, iconKind, size, color)
        if primitiveCount > 0:
            iconOp.icon.kind = paint.PaintIconKindSvg
            var primitives: paint.PaintSvgPrimitive[]
            # (routeIndex,nodeId,ordinal)-scoped range index instead of a full
            # graph.paintSvgPrimitives scan — same node-range-index pattern
            # already used for paintOps/paintShadows/paintGradients above.
            if sceneOp.nodeId <= 0 || sceneOp.nodeId >= graph.paintSvgPrimitiveStartByNodeId.len || sceneOp.nodeId >= graph.paintSvgPrimitiveEndByNodeId.len:
                return false
            let svgStartIndex = graph.paintSvgPrimitiveStartByNodeId[sceneOp.nodeId]
            if svgStartIndex >= 0:
                let svgEndIndex = graph.paintSvgPrimitiveEndByNodeId[sceneOp.nodeId]
                if svgEndIndex < svgStartIndex || svgEndIndex > graph.paintSvgPrimitives.len:
                    return false
                for primitiveIndex in svgStartIndex..<svgEndIndex:
                    if graph.paintSvgPrimitives[primitiveIndex].routeIndex == sceneOp.routeIndex &&
                       graph.paintSvgPrimitives[primitiveIndex].nodeId == sceneOp.nodeId &&
                       graph.paintSvgPrimitives[primitiveIndex].ordinal == sceneOp.ordinal:
                        add(primitives, graph.paintSvgPrimitives[primitiveIndex].primitive)
            iconOp.icon.primitives = primitives
        paint.PaintOpAppend(ops, iconOp)
        return true
    if sceneOp.opKind == WebScenePaintImage:
        let imageId = WebSceneResourceIdHash31(sceneOp.resourceId)
        if imageId <= 0:
            return false
        paint.PaintOpAppend(ops, paint.PaintOpMakeDrawImage(sceneOp.x, sceneOp.y, sceneOp.width, sceneOp.height, imageId, sceneOp.width, sceneOp.height))
        return true
    return false

fn WebSceneAddRouteEdge(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, targetRouteIndex: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if targetRouteIndex < 0 || targetRouteIndex >= graph.routes.len:
        return false
    if nodeId <= 0:
        return false
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    var edge: WebSceneRouteEdge
    edge.routeIndex = routeIndex
    edge.nodeId = nodeId
    edge.targetRouteIndex = targetRouteIndex
    add(graph.routeEdges, edge)
    WebSceneInvalidateInteractionIndex(graph)
    return true

# ---------------------------------------------------------------------------
# K1 interaction index (cheng-gui-kernel): one sorted table, one binary search.
# Kinds: 1 = route edge (payload = targetRouteIndex), 2 = click handler
# (payload = eventHandlers index). Same (route,node) may carry both kinds.
# ---------------------------------------------------------------------------

fn WebSceneInvalidateInteractionIndex(graph: var WebSceneGraph) =
    graph.interactionVersion = -1
    graph.interactionRouteIds = []
    graph.interactionNodeIds = []
    graph.interactionKinds = []
    graph.interactionPayloads = []
    graph.eventHandlerIndexVersion = -1
    graph.eventHandlerIndexRouteIds = []
    graph.eventHandlerIndexNodeIds = []
    graph.eventHandlerIndexHandlerIds = []
    graph.textInputNodeVersion = -1
    graph.textInputRouteIds = []
    graph.textInputNodeIds = []

fn webSceneInteractionInsert(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, kind: int32, payload: int32) =
    # near-sorted input (facts are route-major): insertion from the tail is ~O(1)
    add(graph.interactionRouteIds, routeIndex)
    add(graph.interactionNodeIds, nodeId)
    add(graph.interactionKinds, kind)
    add(graph.interactionPayloads, payload)
    var i = graph.interactionRouteIds.len - 1
    while i > 0:
        let prevRoute = graph.interactionRouteIds[i - 1]
        let prevNode = graph.interactionNodeIds[i - 1]
        if prevRoute < routeIndex || (prevRoute == routeIndex && prevNode <= nodeId):
            return
        graph.interactionRouteIds[i] = prevRoute
        graph.interactionNodeIds[i] = prevNode
        graph.interactionKinds[i] = graph.interactionKinds[i - 1]
        graph.interactionPayloads[i] = graph.interactionPayloads[i - 1]
        graph.interactionRouteIds[i - 1] = routeIndex
        graph.interactionNodeIds[i - 1] = nodeId
        graph.interactionKinds[i - 1] = kind
        graph.interactionPayloads[i - 1] = payload
        i = i - 1

fn WebSceneEnsureInteractionIndex(graph: var WebSceneGraph) =
    if graph.interactionVersion >= 0:
        return
    graph.interactionRouteIds = []
    graph.interactionNodeIds = []
    graph.interactionKinds = []
    graph.interactionPayloads = []
    for i in 0..<graph.routeEdges.len:
        webSceneInteractionInsert(graph, graph.routeEdges[i].routeIndex, graph.routeEdges[i].nodeId, 1, graph.routeEdges[i].targetRouteIndex)
    for i in 0..<graph.eventHandlers.len:
        if graph.eventHandlers[i].eventName == "click":
            webSceneInteractionInsert(graph, graph.eventHandlers[i].routeIndex, graph.eventHandlers[i].nodeId, 2, i)
    graph.interactionVersion = 0

# First table index whose key >= (routeIndex,nodeId); len when past the end.
fn webSceneInteractionLowerBound(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    var lo = 0
    var hi = graph.interactionRouteIds.len
    while lo < hi:
        let mid = (lo + hi) / 2
        let r = graph.interactionRouteIds[mid]
        if r < routeIndex || (r == routeIndex && graph.interactionNodeIds[mid] < nodeId):
            lo = mid + 1
        else:
            hi = mid
    return lo

# kind-filtered lookup: returns payload, or -2147483647 when absent.
fn WebSceneInteractionPayload(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, kind: int32): int32 =
    WebSceneEnsureInteractionIndex(graph)
    var i = webSceneInteractionLowerBound(graph, routeIndex, nodeId)
    while i < graph.interactionRouteIds.len &&
          graph.interactionRouteIds[i] == routeIndex &&
          graph.interactionNodeIds[i] == nodeId:
        if graph.interactionKinds[i] == kind:
            return graph.interactionPayloads[i]
        i = i + 1
    return -2147483647

# ---------------------------------------------------------------------------
# K2 event-handler index: every handler keyed by (routeIndex,nodeId), stable by
# handler index, so WebSceneFindEventHandlerForNodeEvent / text-input lookups
# resolve any eventName in O(log n) instead of scanning the whole handler table.
# ---------------------------------------------------------------------------

fn webSceneEventHandlerIndexInsert(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32, handlerId: int32) =
    # near-sorted input (handlers are route-major): tail insertion is ~O(1);
    # stops at the first key <= (route,node) so equal keys keep ascending handlerId.
    add(graph.eventHandlerIndexRouteIds, routeIndex)
    add(graph.eventHandlerIndexNodeIds, nodeId)
    add(graph.eventHandlerIndexHandlerIds, handlerId)
    var i = graph.eventHandlerIndexRouteIds.len - 1
    while i > 0:
        let prevRoute = graph.eventHandlerIndexRouteIds[i - 1]
        let prevNode = graph.eventHandlerIndexNodeIds[i - 1]
        if prevRoute < routeIndex || (prevRoute == routeIndex && prevNode <= nodeId):
            return
        graph.eventHandlerIndexRouteIds[i] = prevRoute
        graph.eventHandlerIndexNodeIds[i] = prevNode
        graph.eventHandlerIndexHandlerIds[i] = graph.eventHandlerIndexHandlerIds[i - 1]
        graph.eventHandlerIndexRouteIds[i - 1] = routeIndex
        graph.eventHandlerIndexNodeIds[i - 1] = nodeId
        graph.eventHandlerIndexHandlerIds[i - 1] = handlerId
        i = i - 1

fn WebSceneEnsureEventHandlerIndex(graph: var WebSceneGraph) =
    if graph.eventHandlerIndexVersion >= 0:
        return
    graph.eventHandlerIndexRouteIds = []
    graph.eventHandlerIndexNodeIds = []
    graph.eventHandlerIndexHandlerIds = []
    for i in 0..<graph.eventHandlers.len:
        webSceneEventHandlerIndexInsert(graph, graph.eventHandlers[i].routeIndex, graph.eventHandlers[i].nodeId, i)
    graph.eventHandlerIndexVersion = 0

# First index whose key >= (routeIndex,nodeId); len when past the end.
fn webSceneEventHandlerIndexLowerBound(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    var lo = 0
    var hi = graph.eventHandlerIndexRouteIds.len
    while lo < hi:
        let mid = (lo + hi) / 2
        let r = graph.eventHandlerIndexRouteIds[mid]
        if r < routeIndex || (r == routeIndex && graph.eventHandlerIndexNodeIds[mid] < nodeId):
            lo = mid + 1
        else:
            hi = mid
    return lo

# ---------------------------------------------------------------------------
# K3 text-input node index: deduped (routeIndex,nodeId) of nodes whose handlers
# accept text input, sorted by route, so descendant search touches only the few
# text-input nodes of the active route instead of every scene node.
# ---------------------------------------------------------------------------

fn WebSceneEnsureTextInputNodeIndex(graph: var WebSceneGraph) =
    if graph.textInputNodeVersion >= 0:
        return
    WebSceneEnsureEventHandlerIndex(graph)
    graph.textInputRouteIds = []
    graph.textInputNodeIds = []
    var i = 0
    while i < graph.eventHandlerIndexRouteIds.len:
        let r = graph.eventHandlerIndexRouteIds[i]
        let n = graph.eventHandlerIndexNodeIds[i]
        var accepts = false
        var j = i
        while j < graph.eventHandlerIndexRouteIds.len &&
              graph.eventHandlerIndexRouteIds[j] == r &&
              graph.eventHandlerIndexNodeIds[j] == n:
            let handlerId = graph.eventHandlerIndexHandlerIds[j]
            if WebSceneEventHandlerAcceptsTextInput(graph.eventHandlers[handlerId]):
                accepts = true
            j = j + 1
        if accepts:
            add(graph.textInputRouteIds, r)
            add(graph.textInputNodeIds, n)
        i = j
    graph.textInputNodeVersion = 0

# First index whose route >= routeIndex; len when past the end.
fn webSceneTextInputLowerBoundRoute(graph: var WebSceneGraph, routeIndex: int32): int32 =
    var lo = 0
    var hi = graph.textInputRouteIds.len
    while lo < hi:
        let mid = (lo + hi) / 2
        if graph.textInputRouteIds[mid] < routeIndex:
            lo = mid + 1
        else:
            hi = mid
    return lo

fn WebSceneNodeIsRouteRoot(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    if routeIndex < 0 || routeIndex >= graph.routes.len:
        return false
    if nodeId <= 0:
        return false
    for i in 0..<graph.routes[routeIndex].rootNodeIds.len:
        if graph.routes[routeIndex].rootNodeIds[i] == nodeId:
            return true
    return false

# Unique text-input descendant of rootNodeId under routeIndex, or 0 when none /
# ambiguous / rootNodeId is a route root. Result is identical to a full node
# scan: candidates are exactly the nodes accepting text input, filtered by
# route membership, subtree, and pointer-events; uniqueness is order-independent.
fn WebSceneFindUniqueTextInputDescendant(graph: var WebSceneGraph, routeIndex: int32, rootNodeId: int32): int32 =
    if rootNodeId <= 0:
        return -1
    if WebSceneNodeIsRouteRoot(graph, routeIndex, rootNodeId):
        return 0
    WebSceneEnsureTextInputNodeIndex(graph)
    var i = webSceneTextInputLowerBoundRoute(graph, routeIndex)
    var found = 0
    while i < graph.textInputRouteIds.len && graph.textInputRouteIds[i] == routeIndex:
        let candidate = graph.textInputNodeIds[i]
        if candidate != rootNodeId &&
           WebSceneFindNodeIndex(graph, routeIndex, candidate) >= 0 &&
           WebSceneNodeInSubtree(graph, rootNodeId, candidate):
            if WebSceneNodePointerEventsEnabled(graph, routeIndex, candidate):
                if found != 0:
                    return 0
                found = candidate
        i = i + 1
    return found

# Active-route box range: layoutBoxes cluster per constructed route; min/max
# bounds shrink the hit scan from all routes to the active one.
fn WebSceneEnsureBoxRouteRanges(graph: var WebSceneGraph) =
    if graph.boxRangeVersion >= 0:
        return
    graph.boxRangeRouteIds = []
    graph.boxRangeStarts = []
    graph.boxRangeEnds = []
    for i in 0..<graph.layoutBoxes.len:
        let routeIndex = graph.layoutBoxes[i].routeIndex
        var found = -1
        for k in 0..<graph.boxRangeRouteIds.len:
            if graph.boxRangeRouteIds[k] == routeIndex:
                found = k
        if found < 0:
            add(graph.boxRangeRouteIds, routeIndex)
            add(graph.boxRangeStarts, i)
            add(graph.boxRangeEnds, i + 1)
        else:
            if i + 1 > graph.boxRangeEnds[found]:
                graph.boxRangeEnds[found] = i + 1
            if i < graph.boxRangeStarts[found]:
                graph.boxRangeStarts[found] = i
    graph.boxRangeVersion = 0

@borrows
fn WebSceneBoxRangeStart(graph: var WebSceneGraph, routeIndex: int32): int32 =
    WebSceneEnsureBoxRouteRanges(graph)
    for k in 0..<graph.boxRangeRouteIds.len:
        if graph.boxRangeRouteIds[k] == routeIndex:
            return graph.boxRangeStarts[k]
    return 0

@borrows
fn WebSceneBoxRangeEnd(graph: var WebSceneGraph, routeIndex: int32): int32 =
    WebSceneEnsureBoxRouteRanges(graph)
    for k in 0..<graph.boxRangeRouteIds.len:
        if graph.boxRangeRouteIds[k] == routeIndex:
            return graph.boxRangeEnds[k]
    return graph.layoutBoxes.len

@borrows
fn WebSceneFindRouteTargetForNode(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    if !WebSceneNodePointerEventsEnabled(graph, routeIndex, nodeId):
        return -1
    let payload = WebSceneInteractionPayload(graph, routeIndex, nodeId, 1)
    if payload == -2147483647:
        return -1
    return payload

@borrows
fn WebSceneNodePointerEventsEnabled(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    if !WebSceneNodeBelongsToRoute(graph, routeIndex, nodeId):
        return false
    if WebSceneNodeHiddenByDisplayNone(graph, routeIndex, nodeId):
        return false
    if WebSceneNodeIsDisabledNativeControl(graph, routeIndex, nodeId):
        return false
    if WebSceneNodeHasPointerEventsNoneState(graph, routeIndex, nodeId):
        return false
    return true

fn WebSceneNodeHasPointerEventsNoneState(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    var current = nodeId
    var steps: int32
    while current > 0:
        let stateIndex = WebSceneFindNodeStateIndex(graph, routeIndex, current)
        if stateIndex >= 0 && graph.nodeStates[stateIndex].pointerEventsSet:
            return graph.nodeStates[stateIndex].pointerEventsNone
        current = WebSceneFindNodeParentId(graph, current)
        steps = steps + 1
        if steps > graph.nodes.len:
            return false
    return false

@borrows
fn WebSceneTagIsDisabledNativeControl(tagName: str): bool =
    if tagName == "button":
        return true
    if tagName == "input":
        return true
    if tagName == "select":
        return true
    if tagName == "textarea":
        return true
    if tagName == "fieldset":
        return true
    if tagName == "optgroup":
        return true
    if tagName == "option":
        return true
    return false

fn WebSceneNodeIsDisabledNativeControl(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): bool =
    let nodeIndex = WebSceneFindNodeIndex(graph, routeIndex, nodeId)
    if nodeIndex < 0:
        return false
    if !WebSceneTagIsDisabledNativeControl(graph.nodes[nodeIndex].tagName):
        return false
    return WebSceneNodePropMatches(graph, routeIndex, nodeId, "disabled", "true")

fn WebSceneRuntimeLayoutBoxContainsPointMilli(graph: var WebSceneGraph,
                                              boxIndex: int32,
                                              routeIndex: int32,
                                              xMilli: int32,
                                              yMilli: int32): bool =
    if boxIndex < 0 || boxIndex >= graph.layoutBoxes.len:
        return false
    if graph.layoutBoxes[boxIndex].routeIndex != routeIndex:
        return false
    if !graph.layoutBoxes[boxIndex].visible:
        return false
    if graph.layoutBoxes[boxIndex].width <= 0 || graph.layoutBoxes[boxIndex].height <= 0:
        return false
    let left = graph.layoutBoxes[boxIndex].x * 1000
    let top = graph.layoutBoxes[boxIndex].y * 1000
    let right = (graph.layoutBoxes[boxIndex].x + graph.layoutBoxes[boxIndex].width) * 1000
    let bottom = (graph.layoutBoxes[boxIndex].y + graph.layoutBoxes[boxIndex].height) * 1000
    return xMilli >= left && xMilli < right && yMilli >= top && yMilli < bottom

fn WebSceneNodeLayerId(graph: var WebSceneGraph, nodeId: int32): int32 =
    if nodeId <= 0 || nodeId >= graph.nodeIndexById.len:
        return 0
    let nodeIndex = graph.nodeIndexById[nodeId]
    if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
        return 0
    return graph.nodes[nodeIndex].layerId

@borrows
fn WebSceneFindNodeAncestorWithProp(graph: var WebSceneGraph,
                                    routeIndex: int32,
                                    nodeId: int32,
                                    propName: str): int32 =
    if nodeId <= 0 || propName.len == 0:
        return -1
    var current = nodeId
    var steps: int32
    while current > 0:
        if WebSceneNodePropValue(graph, routeIndex, current, propName).len > 0:
            return current
        current = WebSceneFindNodeParentId(graph, current)
        steps = steps + 1
        if steps > graph.nodes.len:
            return -1
    return 0

@borrows
fn WebSceneFindTopNodeWithPropAtPointMilli(graph: var WebSceneGraph,
                                           routeIndex: int32,
                                           propName: str,
                                           xMilli: int32,
                                           yMilli: int32): int32 =
    if routeIndex < 0 || propName.len == 0:
        return -1
    var bestNode = 0
    var bestScore = -1
    let rangeStart = WebSceneBoxRangeStart(graph, routeIndex)
    var boxIndex = WebSceneBoxRangeEnd(graph, routeIndex) - 1
    while boxIndex >= rangeStart:
        if WebSceneRuntimeLayoutBoxContainsPointMilli(graph, boxIndex, routeIndex, xMilli, yMilli):
            let boxNodeId = graph.layoutBoxes[boxIndex].nodeId
            if WebSceneNodePointerEventsEnabled(graph, routeIndex, boxNodeId):
                let nodeWithProp = WebSceneFindNodeAncestorWithProp(graph, routeIndex, boxNodeId, propName)
                if nodeWithProp < 0:
                    return -1
                if nodeWithProp > 0:
                    let score = WebSceneNodeLayerId(graph, boxNodeId) * 1000000 + boxIndex
                    if score > bestScore:
                        bestScore = score
                        bestNode = nodeWithProp
        boxIndex = boxIndex - 1
    return bestNode

@borrows
fn WebSceneFindStateIndex(graph: var WebSceneGraph, stateRef: str): int32 =
    if stateRef.len == 0:
        return -1
    for i in 0..<graph.stateEntries.len:
        if graph.stateEntries[i].stateRef == stateRef:
            return i
    return -1

fn WebSceneStateRefAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.stateEntries.len:
        return ""
    return WebSceneCloneStateString(graph.stateEntries[index].stateRef)

fn WebSceneStateValueAt(graph: var WebSceneGraph, index: int32): str =
    if index < 0 || index >= graph.stateEntries.len:
        return ""
    return WebSceneCloneStateString(graph.stateEntries[index].value)

@borrows
fn WebSceneStateRefHasPrefixSegment(candidate: str, prefix: str): bool =
    if prefix.len == 0:
        return false
    if candidate.len <= prefix.len:
        return false
    for i in 0..<prefix.len:
        if candidate[i] != prefix[i]:
            return false
    return candidate[prefix.len] == '.'

fn WebSceneStateJsonPathDecodeScalar(rawValue: str): str =
    if rawValue.len == 0:
        return ""
    if rawValue[0] == '"':
        var pos: int32
        var decoded: str
        if WebSceneJsonStringArrayParseString(rawValue, pos, decoded):
            return decoded
        return ""
    return rawValue

# JSON-path fallback for dotted refs whose flat key is a JSON object.
# `result.dayGan` walks into the flat `result` key's JSON payload; nested
# segments (`result.shiShen.yearGan`) descend one object per segment. String
# leaves are dequoted, numbers/booleans returned as raw text. Flat keys are
# always preferred by the caller so existing dotted flat keys keep their value.
@borrows
fn WebSceneStateJsonPathValueForRef(graph: var WebSceneGraph, stateRef: str, outValue: var str): bool =
    let dotPos = WebSceneStateIndexOfByte(stateRef, '.', 0)
    if dotPos <= 0 || dotPos >= stateRef.len - 1:
        return false
    let head = strings.SliceBytes(stateRef, 0, dotPos)
    let headIndex = WebSceneFindStateIndex(graph, head)
    if headIndex < 0:
        return false
    var currentJson = graph.stateEntries[headIndex].value
    var segStart = dotPos + 1
    while segStart <= stateRef.len:
        var segEnd = WebSceneStateIndexOfByte(stateRef, '.', segStart)
        if segEnd < 0:
            segEnd = stateRef.len
        let segment = strings.SliceBytes(stateRef, segStart, segEnd - segStart)
        if segment.len == 0:
            return false
        var rawValue: str
        if !WebSceneJsonObjectFieldRawValue(currentJson, segment, rawValue):
            return false
        if segEnd >= stateRef.len:
            outValue = WebSceneStateJsonPathDecodeScalar(rawValue)
            return true
        currentJson = rawValue
        segStart = segEnd + 1
    return false

@borrows
fn WebSceneStateValueForRef(graph: var WebSceneGraph, stateRef: str): str =
    let stateIndex = WebSceneFindStateIndex(graph, stateRef)
    if stateIndex >= 0:
        return WebSceneCloneStateString(graph.stateEntries[stateIndex].value)
    var resolved: str
    if WebSceneStateJsonPathValueForRef(graph, stateRef, resolved):
        return resolved
    return ""

@borrows
fn WebSceneFindStorageIndex(graph: var WebSceneGraph, storageKey: str): int32 =
    if storageKey.len == 0:
        return -1
    for i in 0..<graph.storageEntries.len:
        if graph.storageEntries[i].storageKey == storageKey:
            return i
    return -1

@borrows
fn WebSceneStorageValueForKey(graph: var WebSceneGraph, storageKey: str): str =
    let storageIndex = WebSceneFindStorageIndex(graph, storageKey)
    if storageIndex < 0:
        return ""
    return graph.storageEntries[storageIndex].value

fn WebSceneSetStorageValueInternal(graph: var WebSceneGraph,
                                   storageKey: str,
                                   value: str,
                                   dirty: bool): int32 =
    if storageKey.len == 0:
        return -1
    let storageIndex = WebSceneFindStorageIndex(graph, storageKey)
    if storageIndex >= 0:
        var touched: bool
        if graph.storageEntries[storageIndex].value != value:
            graph.storageEntries[storageIndex].value = value
            touched = true
        if dirty && !graph.storageEntries[storageIndex].dirty:
            graph.storageEntries[storageIndex].dirty = true
            touched = true
        if touched:
            return 1
        return 0
    var entry: WebSceneStorageEntry
    entry.storageKey = storageKey
    entry.value = value
    entry.dirty = dirty
    add(graph.storageEntries, entry)
    return 1

@borrows
fn WebSceneSetStorageValue(graph: var WebSceneGraph, storageKey: str, value: str): bool =
    # Spec migration: under @borrows the key/value formals are borrow views;
    # the Internal station takes owned values. Clone at the edge
    # (storage-station precedent, ResourceEntryStatus family).
    return WebSceneSetStorageValueInternal(
        graph, strings.CloneStr(storageKey), strings.CloneStr(value), false) >= 0

@borrows
fn WebSceneWriteStorageValue(graph: var WebSceneGraph,
                             storageKey: str,
                             value: str,
                             touched: var bool): bool =
    let status = WebSceneSetStorageValueInternal(
        graph, strings.CloneStr(storageKey), strings.CloneStr(value), true)
    if status < 0:
        return false
    if status > 0:
        touched = true
    return true

fn WebSceneStorageDirtyCount(graph: var WebSceneGraph): int32 =
    var count: int32
    for i in 0..<graph.storageEntries.len:
        if graph.storageEntries[i].dirty:
            count = count + 1
    return count

fn WebSceneStorageDirtyKeyAt(graph: var WebSceneGraph, dirtyIndex: int32): str =
    if dirtyIndex < 0:
        return ""
    var seen: int32
    for i in 0..<graph.storageEntries.len:
        if graph.storageEntries[i].dirty:
            if seen == dirtyIndex:
                return graph.storageEntries[i].storageKey
            seen = seen + 1
    return ""

fn WebSceneStorageDirtyValueAt(graph: var WebSceneGraph, dirtyIndex: int32): str =
    if dirtyIndex < 0:
        return ""
    var seen: int32
    for i in 0..<graph.storageEntries.len:
        if graph.storageEntries[i].dirty:
            if seen == dirtyIndex:
                return graph.storageEntries[i].value
            seen = seen + 1
    return ""

@borrows
fn WebSceneClearStorageDirty(graph: var WebSceneGraph, storageKey: str): bool =
    let storageIndex = WebSceneFindStorageIndex(graph, storageKey)
    if storageIndex < 0:
        return false
    graph.storageEntries[storageIndex].dirty = false
    return true

@borrows
fn WebSceneStateStringTruthy(value: str): bool =
    if value.len == 0:
        return false
    if value == "false":
        return false
    if value == "null":
        return false
    if value == "0":
        return false
    return true

@borrows
fn WebSceneStateStringNumPositive(rawValue: str): bool =
    # __num_positive: the trimmed value must be a plain decimal literal (optional
    # leading '+', at most one '.', digits only otherwise) strictly greater than
    # zero. Anything unparsable — including a '-' sign — is honestly false so a
    # numeric gate never unlocks on garbage state.
    let trimmed = WebSceneTrimAsciiWhitespace(rawValue)
    if trimmed.len == 0:
        return false
    var index: int32
    if trimmed[0] == '+':
        index = 1
    var digitCount: int32
    var dotSeen = false
    var nonZeroDigitSeen = false
    while index < trimmed.len:
        let ch = trimmed[index]
        if ch == '.':
            if dotSeen:
                return false
            dotSeen = true
        elif WebSceneIsAsciiDigit(ch):
            digitCount = digitCount + 1
            if ch != '0':
                nonZeroDigitSeen = true
        else:
            return false
        index = index + 1
    if digitCount == 0:
        return false
    return nonZeroDigitSeen

@borrows
fn WebSceneStateIndexOfByte(text: str, target: char, start: int32): int32 =
    var i = start
    while i < text.len:
        if text[i] == target:
            return i
        i = i + 1
    return -1

@borrows
fn WebSceneStateAsciiFoldContains(haystack: str, needle: str): bool =
    let n: int32 = haystack.len
    let m: int32 = needle.len
    if m == 0:
        return true
    if m > n:
        return false
    var i: int32
    while i <= n - m:
        var matched = true
        var j: int32
        while j < m:
            if !WebSceneAsciiCharEqualFold(haystack[i + j], needle[j]):
                matched = false
                break
            j = j + 1
        if matched:
            return true
        i = i + 1
    return false

@borrows
fn WebSceneStateEqAnyMatches(currentValue: str, listRaw: str): bool =
    let n: int32 = listRaw.len
    var start: int32
    var i: int32
    while i <= n:
        if i == n || listRaw[i] == '|':
            let seg = strings.SliceBytes(listRaw, start, i - start)
            if currentValue == seg:
                return true
            start = i + 1
        i = i + 1
    return false

# parseFloat 前缀语义: 可选符号 + 数字/小数点(至少一个数字) + 可选 e/E 指数, 忽略尾部
# 非数字文本。与 JS parseFloat 的差异只有非有限值: 指数或位数超出 float64 范围(如 1e999)
# 返回 false 而不是 Infinity — 消费方(__num_gt/__num_finite)把非有限一律判不通过。
@borrows
fn WebSceneParseFloatPrefix(raw: str, out: var float64): bool =
    out = 0.0
    if raw.len == 0:
        return false
    var i: int32
    var negative: bool
    if raw[0] == '+':
        i = 1
    elif raw[0] == '-':
        negative = true
        i = 1
    var hadDigit: bool
    var significantDigits: int32
    var mantissa: float64
    while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
        let digit = WebSceneAsciiDigitValue(raw[i])
        mantissa = mantissa * 10.0 + float64(digit)
        if significantDigits > 0 || digit != 0:
            significantDigits = significantDigits + 1
        hadDigit = true
        i = i + 1
    if significantDigits > 308:
        return false
    if i < raw.len && raw[i] == '.':
        i = i + 1
        var fracScale: float64 = 0.1
        while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
            mantissa = mantissa + float64(WebSceneAsciiDigitValue(raw[i])) * fracScale
            fracScale = fracScale * 0.1
            hadDigit = true
            i = i + 1
    if !hadDigit:
        return false
    if i < raw.len && (raw[i] == 'e' || raw[i] == 'E'):
        var expCursor = i + 1
        var expNegative: bool
        if expCursor < raw.len && raw[expCursor] == '+':
            expCursor = expCursor + 1
        elif expCursor < raw.len && raw[expCursor] == '-':
            expNegative = true
            expCursor = expCursor + 1
        if expCursor < raw.len && WebSceneIsAsciiDigit(raw[expCursor]):
            var expValue: int32
            while expCursor < raw.len && WebSceneIsAsciiDigit(raw[expCursor]):
                if expValue < 10000:
                    expValue = expValue * 10 + WebSceneAsciiDigitValue(raw[expCursor])
                expCursor = expCursor + 1
            if !expNegative && expValue + significantDigits > 308:
                return false
            var applied: int32
            while applied < expValue:
                if expNegative:
                    mantissa = mantissa * 0.1
                else:
                    mantissa = mantissa * 10.0
                applied = applied + 1
    if negative:
        mantissa = 0.0 - mantissa
    out = mantissa
    return true

# 界文本的整数部分(向零截断): __num_gt 见证值用 int+1 恒大于原界。
@borrows
fn WebSceneParseLeadingSignedInt32(raw: str, out: var int32): bool =
    out = 0
    if raw.len == 0:
        return false
    var i: int32
    var negative: bool
    if raw[0] == '+':
        i = 1
    elif raw[0] == '-':
        negative = true
        i = 1
    var hadDigit: bool
    var value: int64
    while i < raw.len && WebSceneIsAsciiDigit(raw[i]):
        hadDigit = true
        value = value * int64(10) + int64(WebSceneAsciiDigitValue(raw[i]))
        if value > int64(2147483646):
            return false
        i = i + 1
    if !hadDigit:
        return false
    if negative:
        out = int32(int64(0) - value)
    else:
        out = int32(value)
    return true

@borrows
fn WebSceneStateValueMatchesCondition(currentValue: str, expectedValueRaw: str): bool =
    var expectedValue = WebSceneCloneStateString(expectedValueRaw)
    if expectedValue.len == 0:
        expectedValue = "true"
    if expectedValue == "__truthy":
        return WebSceneStateStringTruthy(currentValue)
    if expectedValue == "__falsy":
        return !WebSceneStateStringTruthy(currentValue)
    if expectedValue == "__array_nonempty":
        # currentValue is a JSON-array-string state (e.g. mediaFiles). It passes only when the
        # value parses as a top-level JSON array with at least one item. An empty array "[]" is a
        # non-empty *string* (truthy) but has zero items, so a plain __truthy check would falsely
        # unlock a publish button with no media — honestly require a real item here.
        var arrayItemCount: int32
        if !WebSceneJsonTopLevelArrayItemCount(currentValue, arrayItemCount):
            return false
        return arrayItemCount > 0
    if strings.HasPrefix(expectedValue, "__array_length_lt:"):
        # JSON-array-string state with fewer than N items (React `images.length < 9` add-photo
        # gate). An unset/empty state is the React initial `[]`, so parse failure counts as 0
        # items — the gate stays open until real items reach the bound.
        let ltBoundRaw = strings.SliceBytes(expectedValue, 18, expectedValue.len - 18)
        var ltBound: int32
        if !WebSceneParseEffectInt32(ltBoundRaw, ltBound):
            return false
        var ltItemCount: int32
        if !WebSceneJsonTopLevelArrayItemCount(currentValue, ltItemCount):
            ltItemCount = 0
        return ltItemCount < ltBound
    if strings.HasPrefix(expectedValue, "__array_length_gte:"):
        let gteBoundRaw = strings.SliceBytes(expectedValue, 19, expectedValue.len - 19)
        var gteBound: int32
        if !WebSceneParseEffectInt32(gteBoundRaw, gteBound):
            return false
        var gteItemCount: int32
        if !WebSceneJsonTopLevelArrayItemCount(currentValue, gteItemCount):
            gteItemCount = 0
        return gteItemCount >= gteBound
    if expectedValue == "__num_positive":
        return WebSceneStateStringNumPositive(currentValue)
    if expectedValue == "__trim_nonempty":
        return WebSceneTrimAsciiWhitespace(currentValue).len > 0
    if strings.HasPrefix(expectedValue, "__num_gt:"):
        # parseFloat 语义的数值下界: 状态文本的数值前缀须解析为有限数且 > N。
        # 解析失败(NaN)与非有限(如 1e999)一律不通过 — 生成端只对与 Number.isFinite
        # 合取的 parseFloat 比较发这个谓词, 语义与 React canPublish 一致。
        let gtBoundRaw = strings.SliceBytes(expectedValue, 9, expectedValue.len - 9)
        var gtBound: float64
        if !WebSceneParseFloatPrefix(gtBoundRaw, gtBound):
            return false
        var gtValue: float64
        if !WebSceneParseFloatPrefix(currentValue, gtValue):
            return false
        return gtValue > gtBound
    if expectedValue == "__num_finite":
        var finiteValue: float64
        return WebSceneParseFloatPrefix(currentValue, finiteValue)
    if strings.HasPrefix(expectedValue, "__not:"):
        let expectedInner = strings.SliceBytes(expectedValue, 6, expectedValue.len - 6)
        return !WebSceneStateValueMatchesCondition(currentValue, expectedInner)
    if strings.HasPrefix(expectedValue, "__eq_or:"):
        let rest = strings.SliceBytes(expectedValue, 8, expectedValue.len - 8)
        let colon = WebSceneStateIndexOfByte(rest, ':', 0)
        if colon < 0:
            return false
        let sentinel = strings.SliceBytes(rest, 0, colon)
        let expectedEq = strings.SliceBytes(rest, colon + 1, rest.len - colon - 1)
        return currentValue == expectedEq || currentValue == sentinel
    if strings.HasPrefix(expectedValue, "__eq_any:"):
        let listRaw = strings.SliceBytes(expectedValue, 9, expectedValue.len - 9)
        return WebSceneStateEqAnyMatches(currentValue, listRaw)
    if strings.HasPrefix(expectedValue, "__substr_of:"):
        let text = strings.SliceBytes(expectedValue, 12, expectedValue.len - 12)
        if currentValue.len == 0:
            return true
        return WebSceneStateAsciiFoldContains(text, currentValue)
    var currentValueNormalized = currentValue
    if currentValueNormalized.len == 0:
        currentValueNormalized = "false"
    if currentValueNormalized == expectedValue:
        return true
    return false

@borrows
@borrow_result
fn WebSceneStateImageSrcStateRef(valueKind: str): str =
    let prefix = "state-src:"
    if !strings.HasPrefix(valueKind, prefix):
        return strings.SliceBytes(valueKind, 0, 0)
    return strings.SliceBytes(valueKind, prefix.len, valueKind.len - prefix.len)

@borrows
fn WebSceneStateImageResourceId(stateRef: str): str =
    return Fmt"image.state.{stateRef}"

@borrows
fn WebSceneIsStateImageResourceId(resourceId: str): bool =
    return strings.HasPrefix(resourceId, "image.state.")

@borrows
fn WebSceneFindDynamicImagePaintOpIndex(graph: var WebSceneGraph,
                                        routeIndex: int32,
                                        nodeId: int32,
                                        resourceId: str): int32 =
    if resourceId.len == 0:
        return -1
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex &&
           graph.paintOps[i].nodeId == nodeId &&
           graph.paintOps[i].opKind == WebScenePaintImage &&
           graph.paintOps[i].resourceId == resourceId:
            return i
    return -1

@borrows
fn WebSceneRemoveDynamicImagePaintOp(graph: var WebSceneGraph,
                                     routeIndex: int32,
                                     nodeId: int32,
                                     resourceId: str): bool =
    var nextOps: WebScenePaintOp[]
    var removed: bool
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].routeIndex == routeIndex &&
           graph.paintOps[i].nodeId == nodeId &&
           graph.paintOps[i].opKind == WebScenePaintImage &&
           graph.paintOps[i].resourceId == resourceId:
            removed = true
        else:
            var keepOp: WebScenePaintOp
            if !WebScenePaintOpCloneFromSeq(graph.paintOps, i, keepOp):
                return false
            add(nextOps, keepOp)
    if removed:
        graph.paintOps = nextOps
        graph.paintOpRangeIndexSynced = false
    return removed

@borrows
fn WebSceneEnsureDynamicImagePaintOpStatus(graph: var WebSceneGraph,
                                           routeIndex: int32,
                                           nodeId: int32,
                                           propOrdinal: int32,
                                           resourceId: str): int32 =
    if resourceId.len == 0 || propOrdinal < 0:
        return -1
    if WebSceneFindDynamicImagePaintOpIndex(graph, routeIndex, nodeId, resourceId) >= 0:
        return 0
    let ordinal = 100000 + propOrdinal
    if !WebSceneAddPaintOpAt(graph, routeIndex, nodeId, ordinal, 0, 0, WebScenePaintImage, int64(0), 0, 0, 0, resourceId, ""):
        return -1
    return 1

fn WebSceneFindNodeIndex(graph: var WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    if nodeId <= 0:
        return -1
    if nodeId >= graph.nodeIndexById.len:
        return -1
    let nodeIndex = graph.nodeIndexById[nodeId]
    if nodeIndex < 0 || nodeIndex >= graph.nodes.len:
        return -1
    if graph.nodes[nodeIndex].routeIndex == routeIndex:
        return nodeIndex
    return -1

@borrows
fn WebSceneRefreshTextBindingsForState(graph: var WebSceneGraph, stateRef: str, value: str): bool =
    if stateRef.len == 0:
        return false
    var touched: bool
    for i in 0..<graph.nodes.len:
        let boundRef = graph.nodes[i].textStateRef
        if boundRef.len == 0:
            continue
        var boundValue: str
        var matches = false
        if boundRef == stateRef:
            boundValue = WebSceneCloneStateString(value)
            matches = true
        elif WebSceneStateRefHasPrefixSegment(boundRef, stateRef):
            boundValue = WebSceneStateValueForRef(graph, boundRef)
            matches = true
        if matches && graph.nodes[i].textContent != boundValue:
            graph.nodes[i].textContent = boundValue
            touched = true
    for i in 0..<graph.paintOps.len:
        if WebScenePaintKindIsText(graph.paintOps[i].opKind):
            let nodeIndex = WebSceneFindNodeIndex(graph, graph.paintOps[i].routeIndex, graph.paintOps[i].nodeId)
            if nodeIndex < 0:
                continue
            let boundRef = graph.nodes[nodeIndex].textStateRef
            if boundRef.len == 0:
                continue
            var boundValue: str
            var matches = false
            if boundRef == stateRef:
                boundValue = WebSceneCloneStateString(value)
                matches = true
            elif WebSceneStateRefHasPrefixSegment(boundRef, stateRef):
                boundValue = WebSceneStateValueForRef(graph, boundRef)
                matches = true
            if matches && graph.paintOps[i].textContent != boundValue:
                graph.paintOps[i].textContent = boundValue
                touched = true
    return touched

@borrows
fn WebSceneRefreshImageSrcBindingsForStateStatus(graph: var WebSceneGraph, stateRef: str, value: str): int32 =
    if stateRef.len == 0:
        return 0
    var touched: bool
    let stateValueTruthy = WebSceneStateStringTruthy(value)
    for i in 0..<graph.props.len:
        if graph.props[i].propName != "src":
            continue
        let propStateRef = WebSceneStateImageSrcStateRef(graph.props[i].valueKind)
        if propStateRef != stateRef:
            continue
        if graph.props[i].propValue != value:
            graph.props[i].propValue = WebSceneCloneStateString(value)
            touched = true
        let resourceId = WebSceneStateImageResourceId(stateRef)
        if stateValueTruthy:
            let ensureStatus = WebSceneEnsureDynamicImagePaintOpStatus(graph, graph.props[i].routeIndex, graph.props[i].nodeId, graph.props[i].ordinal, resourceId)
            if ensureStatus < 0:
                return -1
            if ensureStatus > 0:
                touched = true
        else:
            if WebSceneRemoveDynamicImagePaintOp(graph, graph.props[i].routeIndex, graph.props[i].nodeId, resourceId):
                touched = true
    if touched:
        return 1
    return 0

fn WebSceneAddUniqueRouteIndex(routeIndexes: var int32[], routeIndex: int32) =
    for i in 0..<routeIndexes.len:
        if routeIndexes[i] == routeIndex:
            return
    add(routeIndexes, routeIndex)

@borrows
fn WebSceneStateSetStyleBindingDeclarationValue(graph: var WebSceneGraph,
                                                routeIndex: int32,
                                                nodeId: int32,
                                                selected: bool,
                                                propertyName: str): str =
    let prefix = selected ? "data-csg-style-selected-" : "data-csg-style-unselected-"
    return WebSceneNodePropValue(graph, routeIndex, nodeId, strings.ConcatStr(prefix, propertyName))

@borrows
fn WebSceneRefreshStateSetStyleBindingProperty(graph: var WebSceneGraph,
                                               routeIndex: int32,
                                               nodeId: int32,
                                               selected: bool,
                                               propertyName: str): int32 =
    let selectedValue = WebSceneStateSetStyleBindingDeclarationValue(graph, routeIndex, nodeId, true, propertyName)
    let unselectedValue = WebSceneStateSetStyleBindingDeclarationValue(graph, routeIndex, nodeId, false, propertyName)
    if selectedValue.len == 0 && unselectedValue.len == 0:
        return 0
    if selectedValue.len == 0 || unselectedValue.len == 0:
        return -1
    var propertyValue = unselectedValue
    if selected:
        propertyValue = selectedValue
    return WebSceneSetLatestStaticCssDeclarationValue(graph, routeIndex, nodeId, propertyName, propertyValue)

fn WebSceneRefreshStateSetStyleBindingNode(graph: var WebSceneGraph,
                                           routeIndex: int32,
                                           nodeId: int32,
                                           selected: bool): int32 =
    var touched: bool
    var status = WebSceneRefreshStateSetStyleBindingProperty(graph, routeIndex, nodeId, selected, "background-image")
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneRefreshStateSetStyleBindingProperty(graph, routeIndex, nodeId, selected, "background-color")
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneRefreshStateSetStyleBindingProperty(graph, routeIndex, nodeId, selected, "border-color")
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneRefreshStateSetStyleBindingProperty(graph, routeIndex, nodeId, selected, "box-shadow")
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneRefreshStateSetStyleBindingProperty(graph, routeIndex, nodeId, selected, "transform")
    if status < 0:
        return -1
    if status > 0:
        touched = true
    status = WebSceneRefreshStateSetStyleBindingProperty(graph, routeIndex, nodeId, selected, "color")
    if status < 0:
        return -1
    if status > 0:
        touched = true
    if touched:
        return 1
    return 0

@borrows
fn WebSceneStateSetContainsItemStatus(value: str, itemText: str, itemKind: str): int32 =
    if itemKind == "string":
        var stringItems: str[]
        if !WebSceneParseJsonStringArrayState(value, stringItems):
            return -1
        if WebSceneJsonStringArrayHasDuplicates(stringItems):
            return -1
        if WebSceneJsonStringArrayContains(stringItems, itemText):
            return 1
        return 0
    if itemKind == "number":
        var numberItems: int32[]
        if !WebSceneParseJsonNumberArrayState(value, numberItems):
            return -1
        var numberItem: int32
        if !WebSceneParseEffectInt32(itemText, numberItem):
            return -1
        if WebSceneJsonNumberArrayContains(numberItems, numberItem):
            return 1
        return 0
    var parsedNumberItem: int32
    if WebSceneParseEffectInt32(itemText, parsedNumberItem):
        var autoNumberItems: int32[]
        if WebSceneParseJsonNumberArrayState(value, autoNumberItems):
            if WebSceneJsonNumberArrayContains(autoNumberItems, parsedNumberItem):
                return 1
            return 0
    var autoStringItems: str[]
    if WebSceneParseJsonStringArrayState(value, autoStringItems):
        if WebSceneJsonStringArrayHasDuplicates(autoStringItems):
            return -1
        if WebSceneJsonStringArrayContains(autoStringItems, itemText):
            return 1
        return 0
    return -1

@borrows
fn WebSceneStateSetCount(value: str, outCount: var int32): bool =
    outCount = 0
    var numberItems: int32[]
    if WebSceneParseJsonNumberArrayState(value, numberItems):
        outCount = numberItems.len
        return true
    var stringItems: str[]
    if WebSceneParseJsonStringArrayState(value, stringItems):
        if WebSceneJsonStringArrayHasDuplicates(stringItems):
            return false
        outCount = stringItems.len
        return true
    return false

@borrows
fn WebSceneRefreshStateSetStyleBindingsForState(graph: var WebSceneGraph,
                                                stateRef: str,
                                                value: str,
                                                markDirty: bool): int32 =
    if stateRef.len == 0:
        return 0
    var bindingCount: int32
    for i in 0..<graph.props.len:
        if graph.props[i].propName == "data-csg-state-set-ref" && graph.props[i].propValue == stateRef:
            bindingCount = bindingCount + 1
    if bindingCount <= 0:
        return 0
    var touchedRoutes: int32[]
    for i in 0..<graph.props.len:
        if graph.props[i].propName != "data-csg-state-set-ref" || graph.props[i].propValue != stateRef:
            continue
        let routeIndex = graph.props[i].routeIndex
        let nodeId = graph.props[i].nodeId
        let itemText = WebSceneNodePropValue(graph, routeIndex, nodeId, "data-csg-state-set-item")
        let itemKind = WebSceneNodePropValue(graph, routeIndex, nodeId, "data-csg-state-set-item-kind")
        let selectedStatus = WebSceneStateSetContainsItemStatus(value, itemText, itemKind)
        if selectedStatus < 0:
            return -1
        let selected = selectedStatus > 0
        let status = WebSceneRefreshStateSetStyleBindingNode(graph, routeIndex, nodeId, selected)
        if status < 0:
            return -1
        if status > 0:
            WebSceneAddUniqueRouteIndex(touchedRoutes, routeIndex)
    for i in 0..<touchedRoutes.len:
        if WebSceneRouteHasRuntimeLayoutBox(graph, touchedRoutes[i]):
            if !WebSceneApplyCssVariantRulesToPaintOps(graph, touchedRoutes[i]):
                return -1
        elif markDirty:
            if !WebSceneMarkRouteDirty(graph, touchedRoutes[i]):
                return -1
    if touchedRoutes.len > 0:
        return 1
    return 0

fn WebSceneSetStateSetTouchedRoute(routeIndexes: var int32[], routeIndex: int32) =
    WebSceneAddUniqueRouteIndex(routeIndexes, routeIndex)

@borrows
fn WebSceneRefreshStateSetDisabledBindingsForState(graph: var WebSceneGraph,
                                                   stateRef: str,
                                                   value: str,
                                                   touchedRoutes: var int32[]): int32 =
    if stateRef.len == 0:
        return 0
    var bindingCount: int32
    for i in 0..<graph.props.len:
        if graph.props[i].propName == "data-csg-state-set-disabled-ref" && graph.props[i].propValue == stateRef:
            bindingCount = bindingCount + 1
    if bindingCount <= 0:
        return 0
    var itemCount: int32
    if !WebSceneStateSetCount(value, itemCount):
        return -1
    var touched: bool
    var disabledValue = "false"
    if itemCount <= 0:
        disabledValue = "true"
    for i in 0..<graph.props.len:
        if graph.props[i].propName != "data-csg-state-set-disabled-ref" || graph.props[i].propValue != stateRef:
            continue
        let routeIndex = graph.props[i].routeIndex
        let nodeId = graph.props[i].nodeId
        let before = WebSceneNodePropValue(graph, routeIndex, nodeId, "disabled")
        if !WebSceneSetNodePropValue(graph, routeIndex, nodeId, "disabled", disabledValue):
            return -1
        if before != disabledValue:
            WebSceneSetStateSetTouchedRoute(touchedRoutes, routeIndex)
            touched = true
        let selected = itemCount > 0
        let styleStatus = WebSceneRefreshStateSetStyleBindingNode(graph, routeIndex, nodeId, selected)
        if styleStatus < 0:
            return -1
        if styleStatus > 0:
            WebSceneSetStateSetTouchedRoute(touchedRoutes, routeIndex)
            touched = true
    if touched:
        return 1
    return 0

@borrows
fn WebSceneRefreshDirectTextChildren(graph: var WebSceneGraph,
                                     routeIndex: int32,
                                     parentNodeId: int32,
                                     value: str): int32 =
    var touched: bool
    var found: bool
    for i in 0..<graph.nodes.len:
        if graph.nodes[i].routeIndex == routeIndex &&
           graph.nodes[i].parentNodeId == parentNodeId &&
           graph.nodes[i].nodeKind == 3:
            found = true
            if graph.nodes[i].textContent != value:
                graph.nodes[i].textContent = WebSceneCloneStateString(value)
                touched = true
            for paintIndex in 0..<graph.paintOps.len:
                if graph.paintOps[paintIndex].routeIndex == routeIndex &&
                   graph.paintOps[paintIndex].nodeId == graph.nodes[i].nodeId &&
                   WebScenePaintKindIsText(graph.paintOps[paintIndex].opKind):
                    if graph.paintOps[paintIndex].textContent != value:
                        graph.paintOps[paintIndex].textContent = WebSceneCloneStateString(value)
                        touched = true
    if !found:
        return -1
    if touched:
        if !WebSceneInvalidateLayerCachesForRoute(graph, routeIndex):
            return -1
        return 1
    return 0

@borrows
fn WebSceneRefreshStateSetCountTextBindingsForState(graph: var WebSceneGraph,
                                                    stateRef: str,
                                                    value: str,
                                                    touchedRoutes: var int32[]): int32 =
    if stateRef.len == 0:
        return 0
    var bindingCount: int32
    for i in 0..<graph.props.len:
        if graph.props[i].propName == "data-csg-state-set-count-ref" && graph.props[i].propValue == stateRef:
            bindingCount = bindingCount + 1
    if bindingCount <= 0:
        return 0
    var itemCount: int32
    if !WebSceneStateSetCount(value, itemCount):
        return -1
    var touched: bool
    for i in 0..<graph.props.len:
        if graph.props[i].propName != "data-csg-state-set-count-ref" || graph.props[i].propValue != stateRef:
            continue
        let routeIndex = graph.props[i].routeIndex
        let nodeId = graph.props[i].nodeId
        let prefix = WebSceneNodePropValue(graph, routeIndex, nodeId, "data-csg-state-set-count-prefix")
        let suffix = WebSceneNodePropValue(graph, routeIndex, nodeId, "data-csg-state-set-count-suffix")
        let nextText = strings.ConcatStr(strings.ConcatStr(prefix, strings.IntToStr(itemCount)), suffix)
        let textStatus = WebSceneRefreshDirectTextChildren(graph, routeIndex, nodeId, nextText)
        if textStatus < 0:
            return -1
        if textStatus > 0:
            WebSceneSetStateSetTouchedRoute(touchedRoutes, routeIndex)
            touched = true
    if touched:
        return 1
    return 0

@borrows
fn WebSceneRefreshStateSetBindingsForState(graph: var WebSceneGraph,
                                           stateRef: str,
                                           value: str,
                                           markDirty: bool): int32 =
    var probeCount: int32
    if !WebSceneStateSetCount(value, probeCount):
        return 0
    var touchedRoutes: int32[]
    var touched: bool
    let styleStatus = WebSceneRefreshStateSetStyleBindingsForState(graph, stateRef, value, markDirty)
    if styleStatus < 0:
        return -1
    if styleStatus > 0:
        touched = true
    var disabledRoutes: int32[]
    let disabledStatus = WebSceneRefreshStateSetDisabledBindingsForState(graph, stateRef, value, disabledRoutes)
    if disabledStatus < 0:
        return -1
    if disabledStatus > 0:
        touched = true
        for i in 0..<disabledRoutes.len:
            WebSceneAddUniqueRouteIndex(touchedRoutes, disabledRoutes[i])
    var countRoutes: int32[]
    let countStatus = WebSceneRefreshStateSetCountTextBindingsForState(graph, stateRef, value, countRoutes)
    if countStatus < 0:
        return -1
    if countStatus > 0:
        touched = true
        for i in 0..<countRoutes.len:
            WebSceneAddUniqueRouteIndex(touchedRoutes, countRoutes[i])
    if markDirty:
        for i in 0..<touchedRoutes.len:
            if !WebSceneMarkRouteDirty(graph, touchedRoutes[i]):
                return -1
    if touched:
        return 1
    return 0

fn WebSceneMarkStateDirty(graph: var WebSceneGraph): bool =
    graph.version = graph.version + 1
    graph.stateVersion = graph.stateVersion + 1
    if graph.activeRouteIndex >= 0:
        return WebSceneMarkRouteDirty(graph, graph.activeRouteIndex)
    return true

@borrows
fn WebSceneCopyStringRange(text: str, start: int32, end: int32): str =
    if start < 0 || end < start || end > text.len:
        return ""
    return strings.SliceBytes(text, start, end - start)

@borrows
fn WebSceneCloneStateString(value: str): str =
    # 自有单次拷贝: BytesToString 为 NewStringCopy(所有者为返回值)。原逐字符
    # ConcatStr 每字符一个中间堆串且实测不被回收(热换重建路径, malloc 栈日志
    # 定位 15 万块); 禁用 SliceBytes(视图, 悬垂)。
    return rawbytes.BytesToString(rawbytes.BytesFromString(value))

fn WebScenePaintOpCloneFromSeq(seq: var WebScenePaintOp[], index: int32, dst: var WebScenePaintOp): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.routeIndex = seq[index].routeIndex
    dst.nodeId = seq[index].nodeId
    dst.ordinal = seq[index].ordinal
    dst.x = seq[index].x
    dst.y = seq[index].y
    dst.baseX = seq[index].baseX
    dst.baseY = seq[index].baseY
    dst.opKind = seq[index].opKind
    dst.color = seq[index].color
    dst.baseColor = seq[index].baseColor
    dst.opacity = seq[index].opacity
    dst.baseOpacity = seq[index].baseOpacity
    dst.radius = seq[index].radius
    dst.baseRadius = seq[index].baseRadius
    dst.width = seq[index].width
    dst.height = seq[index].height
    dst.baseWidth = seq[index].baseWidth
    dst.baseHeight = seq[index].baseHeight
    dst.fontSize = seq[index].fontSize
    dst.fontWeight = seq[index].fontWeight
    dst.fontFamily = seq[index].fontFamily
    dst.shadowOffsetX = seq[index].shadowOffsetX
    dst.shadowOffsetY = seq[index].shadowOffsetY
    dst.shadowBlur = seq[index].shadowBlur
    dst.shadowSpread = seq[index].shadowSpread
    dst.shadowInset = seq[index].shadowInset
    dst.gradientEndColor = seq[index].gradientEndColor
    dst.gradientAngle = seq[index].gradientAngle
    dst.rotationDeg = seq[index].rotationDeg
    dst.resourceId = WebSceneCloneStateString(seq[index].resourceId)
    dst.textContent = WebSceneCloneStateString(seq[index].textContent)
    return true

fn WebSceneNodeCloneFromSeq(seq: var WebSceneNode[], index: int32, dst: var WebSceneNode): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.nodeId = seq[index].nodeId
    dst.parentNodeId = seq[index].parentNodeId
    dst.routeIndex = seq[index].routeIndex
    dst.nodeKind = seq[index].nodeKind
    dst.tagName = WebSceneCloneStateString(seq[index].tagName)
    dst.textContent = WebSceneCloneStateString(seq[index].textContent)
    dst.layerId = seq[index].layerId
    dst.conditionalStateRef = WebSceneCloneStateString(seq[index].conditionalStateRef)
    dst.conditionalStateValue = WebSceneCloneStateString(seq[index].conditionalStateValue)
    dst.textStateRef = WebSceneCloneStateString(seq[index].textStateRef)
    return true

fn WebScenePropCloneFromSeq(seq: var WebSceneProp[], index: int32, dst: var WebSceneProp): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.routeIndex = seq[index].routeIndex
    dst.nodeId = seq[index].nodeId
    dst.ordinal = seq[index].ordinal
    dst.propName = WebSceneCloneStateString(seq[index].propName)
    dst.propValue = WebSceneCloneStateString(seq[index].propValue)
    dst.valueKind = WebSceneCloneStateString(seq[index].valueKind)
    return true

fn WebSceneEventHandlerCloneFromSeq(seq: var WebSceneEventHandler[], index: int32, dst: var WebSceneEventHandler): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.routeIndex = seq[index].routeIndex
    dst.nodeId = seq[index].nodeId
    dst.ordinal = seq[index].ordinal
    dst.propOrdinal = seq[index].propOrdinal
    dst.propName = WebSceneCloneStateString(seq[index].propName)
    dst.eventName = WebSceneCloneStateString(seq[index].eventName)
    return true

fn WebSceneHitTargetCloneFromSeq(seq: var WebSceneHitTarget[], index: int32, dst: var WebSceneHitTarget): bool =
    if index < 0 || index >= seq.len:
        return false
    dst.routeIndex = seq[index].routeIndex
    dst.nodeId = seq[index].nodeId
    dst.ordinal = seq[index].ordinal
    dst.propOrdinal = seq[index].propOrdinal
    dst.targetKind = WebSceneCloneStateString(seq[index].targetKind)
    dst.actionName = WebSceneCloneStateString(seq[index].actionName)
    dst.eventName = WebSceneCloneStateString(seq[index].eventName)
    dst.targetRouteIndex = seq[index].targetRouteIndex
    dst.label = WebSceneCloneStateString(seq[index].label)
