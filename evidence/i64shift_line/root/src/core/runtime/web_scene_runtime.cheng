    if WebSceneStrStartsWith(segment, "guard_when:"):
        return 0
    if WebSceneStrStartsWith(segment, "guard_any:"):
        return 0
    if WebSceneStrStartsWith(segment, "guard_key:"):
        return 0
    if WebSceneStrStartsWith(segment, "route:"):
        return 0
    if WebSceneStrStartsWith(segment, "invoke:"):
        return 0
    if WebSceneStrStartsWith(segment, "compiled:"):
        return 0
    if WebSceneStrStartsWith(segment, "text_input:"):
        return 0
    if WebSceneStrStartsWith(segment, "no_op:"):
        return 0
    if segment == "stop-propagation":
        return 0
