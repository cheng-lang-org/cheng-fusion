fn WebSceneAppendRouteLayersForCurrentComposite(graph: var WebSceneGraph,
                                                routeIndex: int32,
                                                frame: var WebSceneCompositorFrame): bool =
    return WebSceneAppendRouteLayersForCompositor(graph, routeIndex, 0, frame)

fn WebSceneAppendRouteLayersForCurrentCompositeWithAtlases(graph: var WebSceneGraph,
                                                           routeIndex: int32,
                                                           imageAtlas: var WebSceneImageAtlas,
                                                           svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                           frame: var WebSceneCompositorFrame): bool =
    return WebSceneAppendRouteLayersForCompositorWithAtlases(graph, routeIndex, 0, imageAtlas, svgAtlas, frame)

fn WebSceneAppendRouteLayersForCurrentCompositeWithFullAtlases(graph: var WebSceneGraph,
                                                               routeIndex: int32,
                                                               imageAtlas: var WebSceneImageAtlas,
                                                               svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                               glyphAtlas: var WebSceneGlyphAtlas,
                                                               frame: var WebSceneCompositorFrame): bool =
    return WebSceneAppendRouteLayersForCompositorWithFullAtlases(graph, routeIndex, 0, imageAtlas, svgAtlas, glyphAtlas, frame)

fn WebSceneLayerIdInList(layerIds: var int32[], layerId: int32): bool =
    for i in 0..<layerIds.len:
        if layerIds[i] == layerId:
            return true
    return false

@borrows
fn WebSceneAppendCompositorTransitionAction(graph: var WebSceneGraph,
                                            action: WebSceneLayerTransition,
                                            frame: var WebSceneCompositorFrame): bool =
    if action.action == WebSceneLayerTransitionReuse:
        return WebSceneAppendCompositorLayerReuse(graph, action, frame)
    if action.action == WebSceneLayerTransitionDrop:
        return WebSceneAppendCompositorLayerDrop(graph, action, frame)
    if action.action == WebSceneLayerTransitionReplace:
        let layerIndex = WebSceneFindLayerIndex(graph, action.toRouteIndex, action.toLayerId)
        if layerIndex < 0:
            return false
        let frameLayerCountBefore = frame.layers.len
        if !WebSceneAppendCompositorLayerScope(graph, action.toRouteIndex, action.toLayerId, graph.layers[layerIndex].ordinal, 0, frame):
            return false
        if frame.layers.len == frameLayerCountBefore:
            return true
        let frameLayerIndex = frame.layers.len - 1
        frame.layers[frameLayerIndex].transitionAction = WebSceneLayerTransitionReplace
        return true
    return false

@borrows
fn WebSceneAppendCompositorTransitionActionWithFullAtlases(graph: var WebSceneGraph,
                                                           action: WebSceneLayerTransition,
                                                           imageAtlas: var WebSceneImageAtlas,
                                                           svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                           glyphAtlas: var WebSceneGlyphAtlas,
                                                           frame: var WebSceneCompositorFrame): bool =
    if action.action == WebSceneLayerTransitionReuse:
        return WebSceneAppendCompositorLayerReuse(graph, action, frame)
    if action.action == WebSceneLayerTransitionDrop:
        return WebSceneAppendCompositorLayerDrop(graph, action, frame)
    if action.action == WebSceneLayerTransitionReplace:
        let layerIndex = WebSceneFindLayerIndex(graph, action.toRouteIndex, action.toLayerId)
        if layerIndex < 0:
            return false
        let frameLayerCountBefore = frame.layers.len
        if !WebSceneAppendCompositorLayerScopeWithFullAtlases(graph,
                                                             action.toRouteIndex,
                                                             action.toLayerId,
                                                             graph.layers[layerIndex].ordinal,
                                                             0,
                                                             imageAtlas,
                                                             svgAtlas,
                                                             glyphAtlas,
                                                             frame):
            return false
        if frame.layers.len == frameLayerCountBefore:
            return true
        let frameLayerIndex = frame.layers.len - 1
        frame.layers[frameLayerIndex].transitionAction = WebSceneLayerTransitionReplace
        return true
    return false

@borrows
fn WebSceneAppendCompositorLayerReuse(graph: var WebSceneGraph,
                                      action: WebSceneLayerTransition,
                                      frame: var WebSceneCompositorFrame): bool =
    if action.action != WebSceneLayerTransitionReuse:
        return false
    let sourceLayerIndex = WebSceneFindLayerIndex(graph, action.fromRouteIndex, action.fromLayerId)
    if sourceLayerIndex < 0:
        return false
    let targetLayerIndex = WebSceneFindLayerIndex(graph, action.toRouteIndex, action.toLayerId)
    if targetLayerIndex < 0:
        return false
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, action.fromRouteIndex, action.fromLayerId)
    if cacheIndex < 0:
        return false
    if !graph.layerCaches[cacheIndex].valid:
        return false
    return WebSceneAppendCachedCompositorLayer(graph,
                                              action.toRouteIndex,
                                              action.toLayerId,
                                              action.fromRouteIndex,
                                              action.fromLayerId,
                                              WebSceneLayerTransitionReuse,
                                              graph.layers[targetLayerIndex].ordinal,
                                              graph.layers[targetLayerIndex].offsetX,
                                              graph.layers[targetLayerIndex].offsetY,
                                              graph.layers[sourceLayerIndex].offsetX,
                                              graph.layers[sourceLayerIndex].offsetY,
                                              graph.layerCaches[cacheIndex].paintBounds,
                                              frame)

@borrows
fn WebSceneAppendCompositorLayerDrop(graph: var WebSceneGraph,
                                     action: WebSceneLayerTransition,
                                     frame: var WebSceneCompositorFrame): bool =
    if action.action != WebSceneLayerTransitionDrop:
        return false
    let sourceLayerIndex = WebSceneFindLayerIndex(graph, action.fromRouteIndex, action.fromLayerId)
    if sourceLayerIndex < 0:
        return false
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, action.fromRouteIndex, action.fromLayerId)
    if cacheIndex < 0:
        return false
    if !graph.layerCaches[cacheIndex].valid:
        return false
    return WebSceneAppendCachedCompositorLayer(graph,
                                              action.fromRouteIndex,
                                              action.fromLayerId,
                                              action.fromRouteIndex,
                                              action.fromLayerId,
                                              WebSceneLayerTransitionDrop,
                                              graph.layers[sourceLayerIndex].ordinal,
                                              graph.layers[sourceLayerIndex].offsetX,
                                              graph.layers[sourceLayerIndex].offsetY,
                                              graph.layers[sourceLayerIndex].offsetX,
                                              graph.layers[sourceLayerIndex].offsetY,
                                              graph.layerCaches[cacheIndex].paintBounds,
                                              frame)

@borrows
fn WebSceneAppendCachedCompositorLayer(graph: var WebSceneGraph,
                                       routeIndex: int32,
                                       layerId: int32,
                                       cacheRouteIndex: int32,
                                       cacheLayerId: int32,
                                       transitionAction: int32,
                                       ordinal: int32,
                                       offsetX: int32,
                                       offsetY: int32,
                                       previousOffsetX: int32,
                                       previousOffsetY: int32,
                                       bounds: WebSceneRect,
                                       frame: var WebSceneCompositorFrame): bool =
    var clippedBounds: WebSceneRect
    clippedBounds.x = bounds.x
    clippedBounds.y = bounds.y
    clippedBounds.width = bounds.width
    clippedBounds.height = bounds.height
    clippedBounds.empty = bounds.empty
    if !WebSceneRectIntersectCurrentViewportForLayer(graph, offsetX, offsetY, clippedBounds):
        return false
    var layer: WebSceneCompositorLayer
    layer.routeIndex = routeIndex
    layer.layerId = layerId
    layer.cacheRouteIndex = cacheRouteIndex
    layer.cacheLayerId = cacheLayerId
    layer.transitionAction = transitionAction
    layer.ordinal = ordinal
    layer.offsetX = offsetX
    layer.offsetY = offsetY
    layer.previousOffsetX = previousOffsetX
    layer.previousOffsetY = previousOffsetY
    WebSceneRectInit(layer.dirtyRect)
    layer.commandStart = frame.commands.len
    layer.commandCount = 0
    add(frame.layers, layer)
    let layerFrameIndex = frame.layers.len - 1
    WebSceneCompositorLayerSetDirtyRectAt(frame, layerFrameIndex, clippedBounds)
    return true

@borrows
fn WebSceneAppendCompositorLayerMove(graph: var WebSceneGraph,
                                     span: WebSceneDirtySpan,
                                     frame: var WebSceneCompositorFrame): bool =
    if span.reason != WebSceneDirtyLayerMove:
        return false
    let layerIndex = WebSceneFindLayerIndex(graph, span.routeIndex, span.layerId)
    if layerIndex < 0:
        return false
    let cacheIndex = WebSceneFindLayerCacheIndex(graph, span.routeIndex, span.layerId)
    if cacheIndex < 0:
        return false
    if !graph.layerCaches[cacheIndex].valid:
        return false
    var bounds: WebSceneRect
    bounds.x = graph.layerCaches[cacheIndex].paintBounds.x
    bounds.y = graph.layerCaches[cacheIndex].paintBounds.y
    bounds.width = graph.layerCaches[cacheIndex].paintBounds.width
    bounds.height = graph.layerCaches[cacheIndex].paintBounds.height
    bounds.empty = graph.layerCaches[cacheIndex].paintBounds.empty
    if !WebSceneRectIntersectCurrentViewportForLayer(graph,
                                                     graph.layers[layerIndex].offsetX,
                                                     graph.layers[layerIndex].offsetY,
                                                     bounds):
        return false
    var layer: WebSceneCompositorLayer
    layer.routeIndex = span.routeIndex
    layer.layerId = span.layerId
    layer.cacheRouteIndex = span.routeIndex
    layer.cacheLayerId = span.layerId
    layer.transitionAction = 0
    layer.ordinal = graph.layers[layerIndex].ordinal
    layer.offsetX = graph.layers[layerIndex].offsetX
    layer.offsetY = graph.layers[layerIndex].offsetY
    layer.previousOffsetX = span.previousOffsetX
    layer.previousOffsetY = span.previousOffsetY
    WebSceneRectInit(layer.dirtyRect)
    layer.commandStart = frame.commands.len
    layer.commandCount = 0
    add(frame.layers, layer)
    let layerFrameIndex = frame.layers.len - 1
    WebSceneCompositorLayerSetDirtyRectAt(frame, layerFrameIndex, bounds)
    return true

fn WebSceneGpuCommandCloneAt(buffer: var WebSceneGpuCommandBuffer,
                             index: int32,
                             dst: var WebSceneGpuCommand): bool =
    if index < 0 || index >= buffer.commands.len:
        return false
    dst.routeIndex = buffer.commands[index].routeIndex
    dst.layerId = buffer.commands[index].layerId
    dst.kind = buffer.commands[index].kind
    dst.x = buffer.commands[index].x
    dst.y = buffer.commands[index].y
    dst.width = buffer.commands[index].width
    dst.height = buffer.commands[index].height
    dst.color = buffer.commands[index].color
    dst.imageId = buffer.commands[index].imageId
    dst.iconKind = buffer.commands[index].iconKind
    dst.iconPrimitiveCount = buffer.commands[index].iconPrimitiveCount
    dst.svgDisplayListId = buffer.commands[index].svgDisplayListId
    dst.fontAtlasId = buffer.commands[index].fontAtlasId
    dst.glyphRunId = buffer.commands[index].glyphRunId
    dst.glyphRunGlyphCount = buffer.commands[index].glyphRunGlyphCount
    dst.glyphSdfAtlasId = buffer.commands[index].glyphSdfAtlasId
    dst.rotationDeg = buffer.commands[index].rotationDeg
    dst.textContent = WebSceneCloneStateString(buffer.commands[index].textContent)
    return true

fn WebSceneAppendCompositorLayerScope(graph: var WebSceneGraph,
                                      routeIndex: int32,
                                      layerId: int32,
                                      ordinal: int32,
                                      subtreeRootNodeId: int32,
                                      frame: var WebSceneCompositorFrame): bool =
    let layerIndex = WebSceneFindLayerIndex(graph, routeIndex, layerId)
    if layerIndex < 0:
        return false
    var paintBuffer: WebScenePaintCommandBuffer
    if !WebSceneBuildRoutePaintCommandsScoped(graph, routeIndex, layerId, subtreeRootNodeId, paintBuffer, false):
        return false
    var bounds: WebSceneRect
    if !WebScenePaintCommandBounds(paintBuffer, bounds):
        return false
    if !WebSceneRectIntersectCurrentViewportForLayer(graph,
                                                     graph.layers[layerIndex].offsetX,
                                                     graph.layers[layerIndex].offsetY,
                                                     bounds):
        return false
    var gpuBuffer: WebSceneGpuCommandBuffer
    if !WebSceneBuildGpuCommandsFromPaintCommands(paintBuffer, gpuBuffer):
        return false
    if bounds.empty || gpuBuffer.commands.len == 0:
        return true
    var layer: WebSceneCompositorLayer
    layer.routeIndex = routeIndex
    layer.layerId = layerId
    layer.cacheRouteIndex = routeIndex
    layer.cacheLayerId = layerId
    layer.transitionAction = 0
    layer.ordinal = ordinal
    layer.offsetX = graph.layers[layerIndex].offsetX
    layer.offsetY = graph.layers[layerIndex].offsetY
    layer.previousOffsetX = graph.layers[layerIndex].offsetX
    layer.previousOffsetY = graph.layers[layerIndex].offsetY
    WebSceneRectInit(layer.dirtyRect)
    layer.commandStart = frame.commands.len
    layer.commandCount = gpuBuffer.commands.len
    add(frame.layers, layer)
    let layerFrameIndex = frame.layers.len - 1
    WebSceneCompositorLayerSetDirtyRectAt(frame, layerFrameIndex, bounds)
    for i in 0..<gpuBuffer.commands.len:
        var gpuCommand: WebSceneGpuCommand
        if !WebSceneGpuCommandCloneAt(gpuBuffer, i, gpuCommand):
            return false
        add(frame.commands, gpuCommand)
    return true

fn WebSceneAppendCompositorLayerScopeWithFullAtlases(graph: var WebSceneGraph,
                                                     routeIndex: int32,
                                                     layerId: int32,
                                                     ordinal: int32,
                                                     subtreeRootNodeId: int32,
                                                     imageAtlas: var WebSceneImageAtlas,
                                                     svgAtlas: var WebSceneSvgDisplayListAtlas,
                                                     glyphAtlas: var WebSceneGlyphAtlas,
                                                     frame: var WebSceneCompositorFrame): bool =
