@borrows
fn WebSceneGraphPrepareCapacity(graph: var WebSceneGraph, plan: WebSceneGraphCapacityPlan): bool =
    if !WebSceneGraphCapacityPlanValid(plan):
        return false
    if !WebSceneGraphIsEmpty(graph):
        return false
    setLen(graph.routes, plan.routes)
    setLen(graph.layers, plan.layers)
    setLen(graph.nodes, plan.nodes)
    setLen(graph.props, plan.props)
    setLen(graph.eventHandlers, plan.eventHandlers)
    setLen(graph.hitTargets, plan.hitTargets)
    setLen(graph.mediaAssets, plan.mediaAssets)
    setLen(graph.mediaPlaybackSlots, plan.mediaPlaybackSlots)
    setLen(graph.mediaControlActions, plan.mediaControlActions)
    setLen(graph.cssVariantRules, plan.cssVariantRules)
    setLen(graph.cssVariantConditions, plan.cssVariantConditions)
    setLen(graph.cssDeclarations, plan.cssDeclarations)
    setLen(graph.resources, plan.resources)
    setLen(graph.layoutConstraints, plan.layoutConstraints)
    setLen(graph.paintOps, plan.paintOps)
    setLen(graph.paintSvgPrimitives, plan.paintSvgPrimitives)
    setLen(graph.routeEdges, plan.routeEdges)
    setLen(graph.layoutBoxes, plan.nodes)
    setLen(graph.layerCaches, plan.layers)
    setLen(graph.paintShadows, plan.paintOps)
    setLen(graph.paintGradients, plan.paintOps)
    setLen(graph.nodeStates, plan.hitTargets)
    setLen(graph.stateEntries, plan.eventHandlers)
    setLen(graph.storageEntries, plan.eventHandlers)
    setLen(graph.routes, 0)
    setLen(graph.layers, 0)
    setLen(graph.nodes, 0)
    setLen(graph.props, 0)
    setLen(graph.eventHandlers, 0)
    setLen(graph.hitTargets, 0)
    setLen(graph.mediaAssets, 0)
    setLen(graph.mediaPlaybackSlots, 0)
    setLen(graph.mediaControlActions, 0)
    setLen(graph.mediaLifecycleEvents, 0)
    setLen(graph.cssVariantRules, 0)
    setLen(graph.cssVariantConditions, 0)
    setLen(graph.cssDeclarations, 0)
    setLen(graph.resources, 0)
    setLen(graph.layoutConstraints, 0)
    setLen(graph.paintOps, 0)
    setLen(graph.paintSvgPrimitives, 0)
    setLen(graph.routeEdges, 0)
    setLen(graph.layoutBoxes, 0)
    setLen(graph.layerCaches, 0)
    setLen(graph.paintShadows, 0)
    setLen(graph.paintGradients, 0)
    setLen(graph.paintOpStartByNodeId, 0)
    setLen(graph.paintOpEndByNodeId, 0)
    setLen(graph.paintShadowStartByNodeId, 0)
    setLen(graph.paintShadowEndByNodeId, 0)
    setLen(graph.paintGradientStartByNodeId, 0)
    setLen(graph.paintGradientEndByNodeId, 0)
    setLen(graph.paintSvgPrimitiveStartByNodeId, 0)
    setLen(graph.paintSvgPrimitiveEndByNodeId, 0)
    setLen(graph.nodeStates, 0)
    setLen(graph.stateEntries, 0)
    setLen(graph.storageEntries, 0)
    return WebSceneGraphIsEmpty(graph)

@borrows
fn WebSceneRouteCount(graph: var WebSceneGraph): int32 =
    return graph.routes.len

fn WebSceneNodeCount(graph: var WebSceneGraph): int32 =
    return graph.nodes.len

fn WebSceneNodeRouteIndexAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.nodes.len:
        return -1
    return graph.nodes[index].routeIndex

fn WebSceneNodeIdAt(graph: var WebSceneGraph, index: int32): int32 =
    if index < 0 || index >= graph.nodes.len:
        return -1
    return graph.nodes[index].nodeId

fn WebScenePropCount(graph: var WebSceneGraph): int32 =
    return graph.props.len

@borrows
fn WebSceneEventHandlerCount(graph: var WebSceneGraph): int32 =
    return graph.eventHandlers.len

